diff -ruN a/src/trace.rs b/src/trace.rs
--- a/src/trace.rs
+++ b/src/trace.rs
@@ -0,0 +1,86 @@
+//! The Lean0 tracer: why did a `def_eq` call succeed?
+//!
+//! Only the top rule is recorded for each successful pair. The premises of a rule are
+//! themselves `def_eq` questions (on subterms, reducts, or inferred types), and the
+//! elaborator asks them again; they are answered from the caches.
+
+use crate::tc::TypeChecker;
+use crate::util::ExprPtr;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DefEqWhy<'t> {
+    /// The two terms are alpha-equivalent (equal up to binder names and binder info).
+    Alpha,
+    /// Both are sorts, with equivalent levels.
+    Sort,
+    /// Both are `Pi` (or both `Lambda`) telescopes, with defeq domains and bodies.
+    Binder,
+    /// `x` head-reduces to `x'` and `y` to `y'` (beta, zeta, delta, ...), and `x' ≡ y'`.
+    Reduce(ExprPtr<'t>, ExprPtr<'t>),
+    /// Both are proofs of propositions with defeq types.
+    ProofIrrel,
+    /// Same head definition (lazy delta congruence): defeq arguments, equivalent levels.
+    ConstApp,
+    /// The same constant, with equivalent levels.
+    Const,
+    /// The same free variable.
+    Local,
+    /// Applications with the same number of arguments: defeq heads and arguments.
+    App,
+    /// `x` is a lambda and `x ≡ λ(_: A). y #0` (the given term), where `y : Π A, B`.
+    Eta(ExprPtr<'t>),
+    /// Projections with the same index of defeq structures (or of structures that reduce to
+    /// constructor applications with defeq fields at that index).
+    Proj,
+    /// `y` is a full constructor application `S.mk ps fs` of a structure, `x : S ps'`, and
+    /// `fs[i] ≡ x.i` for each field (structure eta).
+    EtaStruct,
+    /// Both have the same type, a structure with no fields.
+    Unit,
+    /// Both are `0`: the literal `0` or `Nat.zero`.
+    NatZero,
+    /// `x ≡ Nat.succ x'` and `y ≡ Nat.succ y'` (each a literal `n+1` or a `Nat.succ`
+    /// application), and `x' ≡ y'`.
+    NatSucc(ExprPtr<'t>, ExprPtr<'t>),
+    /// One side is a string literal and the other `String.ofList l`: the literal's expansion,
+    /// in weak head normal form, is defeq to the other side.
+    StrLit,
+    /// A rule outside the supported fragment.
+    Unsupported(&'static str),
+}
+
+impl<'x, 't: 'x, 'p: 't> TypeChecker<'x, 't, 'p> {
+    pub(crate) fn record_why(&mut self, x: ExprPtr<'t>, y: ExprPtr<'t>, why: DefEqWhy<'t>) {
+        if self.tc_cache.trace {
+            self.tc_cache.eq_why.entry((x, y)).or_insert(why);
+        }
+    }
+
+    pub(crate) fn record_reduce(&mut self, x: ExprPtr<'t>, y: ExprPtr<'t>, x2: ExprPtr<'t>, y2: ExprPtr<'t>) {
+        if (x, y) != (x2, y2) {
+            self.record_why(x, y, DefEqWhy::Reduce(x2, y2));
+        }
+    }
+
+    /// Decide `x ≡ y` and say why. `None` if they are not defeq, otherwise the rule and
+    /// whether it was recorded for `(y, x)` instead (so it has to be read with sides swapped).
+    /// Pointer-equal terms need no rule and are reported as `Alpha`.
+    pub fn def_eq_why(&mut self, x: ExprPtr<'t>, y: ExprPtr<'t>) -> Option<(bool, DefEqWhy<'t>)> {
+        assert!(self.tc_cache.trace, "def_eq_why needs tracing enabled");
+        if x == y {
+            return Some((false, DefEqWhy::Alpha))
+        }
+        if !self.def_eq(x, y) {
+            return None
+        }
+        if let Some(w) = self.tc_cache.eq_why.get(&(x, y)) {
+            return Some((false, *w))
+        }
+        if let Some(w) = self.tc_cache.eq_why.get(&(y, x)) {
+            return Some((true, *w))
+        }
+        panic!("def_eq succeeded without a recorded reason")
+    }
+
+    pub fn enable_trace(&mut self) { self.tc_cache.trace = true; }
+}
