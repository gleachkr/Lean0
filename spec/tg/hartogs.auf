p8: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u ⇒ j ∊ img g x $ by img_intro [p1, p7]
p9: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u ⇒ c = img g x $ by ax
p10: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u ⇒ img g x = c $ by eq_sym [p9]
p11: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u ⇒ j ∊ c $ by welc_eq [p10, p8]
p12: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u ⇒ fv (ccnv (cres g x)) j = u $ by injects_ccnv_fv_pair [p0, p1, p7]
p15: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u ⇒ isset u $ by isset_var
p13: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u ⇒ isset (suc u) $ by suc_set [p15]
q1: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ v = suc u $ by ax
p12w: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ fv (ccnv (cres g x)) j = u $ by weaken [p12]
p11w: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ j ∊ c $ by weaken [p11]
q2: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ u = fv (ccnv (cres g x)) j $ by eq_sym [p12w]
q3: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ suc u = suc (fv (ccnv (cres g x)) j) $ by suc_eq [q2]
q4: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ v = suc (fv (ccnv (cres g x)) j) $ by eq_trans [q1, q3]
q5: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ ⟨ j , v ⟩ ∈ cgr k (suc (fv (ccnv (cres g x)) k)) $ by cgr_intro (x := $ k $, B := $ suc (fv (ccnv (cres g x)) k) $, a := $ j $, b := $ v $) [q4]
q6: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ v ∊ img (cgr k (suc (fv (ccnv (cres g x)) k))) c $ by img_intro [p11w, q5]
q7: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ suc u = v $ by eq_sym [q1]
q8: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ u ∊ suc u $ by suc_self
q9: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ u ∊ v $ by welc_eq [q7, q8]
q10: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u , v = suc u ⇒ u ∊ ⋃ img (cgr k (suc (fv (ccnv (cres g x)) k))) c $ by cuni_intro [q9, q6]
p14: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x , j = fv g u ⇒ u ∊ ⋃ img (cgr k (suc (fv (ccnv (cres g x)) k))) c $ by isset_elim [p13, q10]
i4: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U , u ∊ x ⇒ u ∊ ⋃ img (cgr k (suc (fv (ccnv (cres g x)) k))) c $ by isset_elim [i3, p14]
b5: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U ⇒ ⋃ img (cgr k (suc (fv (ccnv (cres g x)) k))) c = x $ by eq_intro [e2, i4]
b6: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U ⇒ x ∈ U $ by wcel_eq_l [b5, b4]
b7: $ G , ord x , ∀ y (y ∊ x → inj_into y b → y ∊ U) , injects g x b , c = img g x , c ∊ U ⇒ x ∊ U $ by wcel_welc [b6]
