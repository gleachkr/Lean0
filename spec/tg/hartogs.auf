l8: $ ∃ f (f ∊ injs A S ∧ w = ⟨ img f A , erel f A ⟩) ⟺ ∃ f (f ∊ injs B T ∧ w = ⟨ img f B , erel f B ⟩) $ by ex_congr [l7]
l9: $ {w | ∃ f (f ∊ injs A S ∧ w = ⟨ img f A , erel f A ⟩)} ≐ {w | ∃ f (f ∊ injs B T ∧ w = ⟨ img f B , erel f B ⟩)} $ by cab_congr [l8]

