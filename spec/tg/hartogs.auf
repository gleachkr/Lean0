b8: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ B = A $ by weaken [b0]
b9: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ i ∊ A $ by welc_eq [b8, b4]
b10: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ ω = ω $ by eq_refl
b11: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ B × ω = A × ω $ by cxp_eq [b8, b10]
b12: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ u ⊆ A × ω $ by subset_eq_r [b11, b6]
b13: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ∈ shift A $ by h3_shift_intro [b9, b12]
b14: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ = w $ by eq_sym [b7]
b15: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ w ∈ shift A $ by wcel_eq_l [b14, b13]
b16: $ G , w ∊ shift B , i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ w ∊ shift A $ by wcel_welc [b15]
b17: $ G , w ∊ shift B , ∃ u (i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩) ⇒ ∃ u (i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩) $ by ax
b18: $ G , w ∊ shift B , ∃ u (i ∊ B ∧ u ⊆ B × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩) ⇒ w ∊ shift A $ by ex_elim [b17, b16]
b19: $ G , w ∊ shift B ⇒ w ∊ shift A $ by ex_elim [b2, b18]
l1: $ G ⇒ shift A = shift B $ by eq_intro [a19, b19]

sb_c_shift
----------
l1: $ (⟦ x / t ⟧ {w | ∃ j ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ w = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩)}) ≐ {w | ∃ j ∃ k (j ∊ (⟦ x / t ⟧ A) ∧ k ⊆ (⟦ x / t ⟧ A) × ω ∧ w = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩)} $ by ceqt_refl

hartogs_bound
-------------
l1: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ functional f $ by weaken [#1]
l2: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ ⟨ z , x ⟩ ∈ f $ by ax
l3: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ fv f z = x $ by fv_val [l1, l2]
l4: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ ∀ x (x ∊ a → fv f x ∈ hartogs (𝒫 (a × ω))) $ by weaken [#2]
l5: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ z ∊ a → fv f z ∈ hartogs (𝒫 (a × ω)) $ by all_elim (t := $ z $) [l4]
l6: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ z ∊ a $ by ax
l7: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ fv f z ∈ hartogs (𝒫 (a × ω)) $ by imp_elim [l5, l6]
l8: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ x ∈ hartogs (𝒫 (a × ω)) $ by wcel_eq_l [l3, l7]
l9: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ x ∊ hartogs (𝒫 (a × ω)) $ by wcel_welc [l8]
l10: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ ord x ∧ inj_into x (𝒫 (a × ω)) $ by hartogs_elim [l9]
l11: $ G , x ∊ img f a , z ∊ a , ⟨ z , x ⟩ ∈ f ⇒ ord x $ by and_elim_l [l10]
l12: $ G , x ∊ img f a ⇒ x ∊ img f a $ by ax
l13: $ G , x ∊ img f a ⇒ ord x $ by img_elim [l12, l11]
l14: $ G ⇒ x ∊ img f a → ord x $ by imp_intro [l13]
l15: $ G ⇒ ∀ x (x ∊ img f a → ord x) $ by all_intro [l14]
l16: $ G ⇒ ord (⋃ (img f a)) $ by ord_cuni [l15]
l20: $ G ⇒ isset a $ by isset_var
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ isset (a × ω) $ by cxp_set [l20, l21]
l23: $ G ⇒ isset (𝒫 (a × ω)) $ by cpw_set [l22]
l24: $ G , w = 𝒫 (a × ω) , x ∊ a ⇒ functional f $ by weaken [#1]
l25: $ G , w = 𝒫 (a × ω) , x ∊ a ⇒ isset (fv f x) $ by fv_set [l24]
l26: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ ∀ x (x ∊ a → fv f x ∈ hartogs (𝒫 (a × ω))) $ by weaken [#2]
l27: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ x ∊ a → fv f x ∈ hartogs (𝒫 (a × ω)) $ by all_elim (t := $ x $) [l26]
l28: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ x ∊ a $ by ax
l29: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ fv f x ∈ hartogs (𝒫 (a × ω)) $ by imp_elim [l27, l28]
l30: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ v = fv f x $ by ax
l31: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ fv f x = v $ by eq_sym [l30]
l32: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ v ∈ hartogs (𝒫 (a × ω)) $ by wcel_eq_l [l31, l29]
l33: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ v ∊ hartogs (𝒫 (a × ω)) $ by wcel_welc [l32]
l34: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ ord v ∧ inj_into v (𝒫 (a × ω)) $ by hartogs_elim [l33]
l35: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ inj_into v (𝒫 (a × ω)) $ by and_elim_r [l34]
l36: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ w = 𝒫 (a × ω) $ by ax
l37: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ 𝒫 (a × ω) = w $ by eq_sym [l36]
l38: $ G , w = 𝒫 (a × ω) , x ∊ a , v = fv f x ⇒ inj_into (fv f x) w $ by inj_into_eq [l30, l37, l35]
l39: $ G , w = 𝒫 (a × ω) , x ∊ a ⇒ inj_into (fv f x) w $ by isset_elim [l25, l38]
l40: $ G , w = 𝒫 (a × ω) ⇒ x ∊ a → inj_into (fv f x) w $ by imp_intro [l39]
l41: $ G , w = 𝒫 (a × ω) ⇒ ∀ x (x ∊ a → inj_into (fv f x) w) $ by all_intro [l40]
l42: $ G , w = 𝒫 (a × ω) ⇒ functional f $ by weaken [#1]
l43: $ G , w = 𝒫 (a × ω) ⇒ inj_into (⋃ (img f a)) (a × w) $ by inj_into_cuni_fam [l42, l41]
l44: $ G , w = 𝒫 (a × ω) ⇒ ⋃ (img f a) = ⋃ (img f a) $ by eq_refl
l45: $ G , w = 𝒫 (a × ω) ⇒ a = a $ by eq_refl
l46: $ G , w = 𝒫 (a × ω) ⇒ w = 𝒫 (a × ω) $ by ax
l47: $ G , w = 𝒫 (a × ω) ⇒ a × w = a × 𝒫 (a × ω) $ by cxp_eq [l45, l46]
l48: $ G , w = 𝒫 (a × ω) ⇒ inj_into (⋃ (img f a)) (a × 𝒫 (a × ω)) $ by inj_into_eq [l44, l47, l43]
l49: $ G , w = 𝒫 (a × ω) ⇒ inj_into (a × 𝒫 (a × ω)) (𝒫 (a × ω)) $ by inj_into_cxp_cpw
l50: $ G , w = 𝒫 (a × ω) ⇒ inj_into (⋃ (img f a)) (𝒫 (a × ω)) $ by inj_into_trans [l48, l49]
l51: $ G ⇒ inj_into (⋃ (img f a)) (𝒫 (a × ω)) $ by isset_elim [l23, l50]
l52: $ G ⇒ isset (img f a) $ by img_set [#1, l20]
l53: $ G ⇒ isset (⋃ (img f a)) $ by cuni_set [l52]
l54: $ G , b = ⋃ (img f a) ⇒ b = ⋃ (img f a) $ by ax
l55: $ G , b = ⋃ (img f a) ⇒ ⋃ (img f a) = b $ by eq_sym [l54]
l56: $ G , b = ⋃ (img f a) ⇒ ord (⋃ (img f a)) $ by weaken [l16]
l57: $ G , b = ⋃ (img f a) ⇒ ord b $ by ord_eq [l55, l56]
l58: $ G , b = ⋃ (img f a) ⇒ inj_into (⋃ (img f a)) (𝒫 (a × ω)) $ by weaken [l51]
l59: $ G , b = ⋃ (img f a) ⇒ 𝒫 (a × ω) = 𝒫 (a × ω) $ by eq_refl
l60: $ G , b = ⋃ (img f a) ⇒ inj_into b (𝒫 (a × ω)) $ by inj_into_eq [l55, l59, l58]
l61: $ G , b = ⋃ (img f a) ⇒ b ∊ hartogs (𝒫 (a × ω)) $ by hartogs_intro [l57, l60]
l62: $ G , b = ⋃ (img f a) ⇒ ⋃ (img f a) ∈ hartogs (𝒫 (a × ω)) $ by wcel_intro [l54, l61]
l63: $ G ⇒ ⋃ (img f a) ∈ hartogs (𝒫 (a × ω)) $ by isset_elim [l53, l62]

hartogs_bound_universe
----------------------
l1: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ universe U $ by weaken [#1]
l2: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ v ∊ U $ by ax
l3: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ 𝒫 v ∈ U $ by universe_cpw [l1, l2]
l4: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ a = a $ by eq_refl
l5: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ c = ω $ by ax
l6: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ a × c = a × ω $ by cxp_eq [l4, l5]
l7: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ v = a × c $ by ax
l8: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ v = a × ω $ by eq_trans [l7, l6]
l9: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ 𝒫 v = 𝒫 (a × ω) $ by cpw_eq [l8]
l10: $ G , c = ω , c ∊ U , v = a × c , v ∊ U ⇒ 𝒫 (a × ω) ∈ U $ by wcel_eq_l [l9, l3]
l11: $ G , c = ω , c ∊ U ⇒ universe U $ by weaken [#1]
l12: $ G , c = ω , c ∊ U ⇒ a ∊ U $ by weaken [#3]
l13: $ G , c = ω , c ∊ U ⇒ c ∊ U $ by ax
l14: $ G , c = ω , c ∊ U ⇒ a × c ∈ U $ by universe_cxp [l11, l12, l13]
l15: $ G , c = ω , c ∊ U ⇒ 𝒫 (a × ω) ∈ U $ by wcel_elim [l14, l10]
l16: $ G ⇒ 𝒫 (a × ω) ∈ U $ by wcel_elim [#2, l15]
l17: $ G , w = 𝒫 (a × ω) , w ∊ U ⇒ universe U $ by weaken [#1]
l18: $ G , w = 𝒫 (a × ω) , w ∊ U ⇒ w ∊ U $ by ax
l19: $ G , w = 𝒫 (a × ω) , w ∊ U ⇒ hartogs w ∈ U $ by hartogs_universe [l17, l18]
l20: $ G , w = 𝒫 (a × ω) , w ∊ U ⇒ w = 𝒫 (a × ω) $ by ax
l21: $ G , w = 𝒫 (a × ω) , w ∊ U ⇒ hartogs w = hartogs (𝒫 (a × ω)) $ by hartogs_eq [l20]
l22: $ G , w = 𝒫 (a × ω) , w ∊ U ⇒ hartogs (𝒫 (a × ω)) ∈ U $ by wcel_eq_l [l21, l19]
l23: $ G ⇒ hartogs (𝒫 (a × ω)) ∈ U $ by wcel_elim [l16, l22]
