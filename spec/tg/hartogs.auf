g1: $ G , u ∊ hartogs s , v = reps u s ⇒ v = reps u s $ by ax
g2: $ G , u ∊ hartogs s , v = reps u s ⇒ ⟨ u , v ⟩ ∈ cgr x (reps x s) $ by cgr_intro (x := $ x $, B := $ reps x s $, a := $ u $, b := $ v $) [g1]
g3: $ G , u ∊ hartogs s , v = reps u s ⇒ u ∊ hartogs s $ by ax
g4: $ G , u ∊ hartogs s , v = reps u s ⇒ ⟨ u , v ⟩ ∈ cres (cgr x (reps x s)) (hartogs s) $ by cres_intro [g3, g2]
g5: $ G , u ∊ hartogs s , v = reps u s ⇒ reps u s ⊆ 𝒫 s × 𝒫 (s × s) $ by reps_subset
g6: $ G , u ∊ hartogs s , v = reps u s ⇒ reps u s = v $ by eq_sym [g1]
g7: $ G , u ∊ hartogs s , v = reps u s ⇒ v ⊆ 𝒫 s × 𝒫 (s × s) $ by subset_eq_l [g6, g5]
g8: $ G , u ∊ hartogs s , v = reps u s ⇒ v ∊ 𝒫 (𝒫 s × 𝒫 (s × s)) $ by cpw_intro [g7]
g9: $ G , u ∊ hartogs s , v = reps u s ⇒ v ∊ 𝒫 (𝒫 s × 𝒫 (s × s)) ∧ ⟨ u , v ⟩ ∈ cres (cgr x (reps x s)) (hartogs s) $ by and_intro [g8, g4]
g10: $ G , u ∊ hartogs s , v = reps u s ⇒ ∃ y (y ∊ 𝒫 (𝒫 s × 𝒫 (s × s)) ∧ ⟨ u , y ⟩ ∈ cres (cgr x (reps x s)) (hartogs s)) $ by ex_intro (x := $ y $, t := $ v $, p := $ y ∊ 𝒫 (𝒫 s × 𝒫 (s × s)) ∧ ⟨ u , y ⟩ ∈ cres (cgr x (reps x s)) (hartogs s) $) [g9]
