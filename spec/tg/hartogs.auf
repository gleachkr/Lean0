l54: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ u ∊ {z | z ∊ a ∧ y ∊ fv f z} $ by ax
l55: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ u ∊ a ∧ y ∊ fv f u $ by cab_elim (x := $ z $, t := $ u $, p := $ z ∊ a ∧ y ∊ fv f z $) [l54]
l56: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ u = fv j y $ by ax
l57: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ u ∊ a $ by and_elim_l [l55]
l58: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ fv j y ∈ a $ by wcel_intro [l56, l57]
l59: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ f = f $ by eq_refl
l60: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ fv f u = fv f (fv j y) $ by fv_eq [l59, l56]
l61: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ y ∊ fv f u $ by and_elim_r [l55]
l62: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ y ∊ fv f (fv j y) $ by welc_eq [l60, l61]
l63: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) , u = fv j y , u ∊ {z | z ∊ a ∧ y ∊ fv f z} ⇒ fv j y ∈ a ∧ y ∊ fv f (fv j y) $ by and_intro [l58, l62]
l64: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) ⇒ fv j y ∈ a ∧ y ∊ fv f (fv j y) $ by wcel_elim [l53, l63]
l65: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) ⇒ y ∊ ⋃ (img f a) → fv j y ∈ a ∧ y ∊ fv f (fv j y) $ by imp_intro [l64]
l66: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) ⇒ ∀ y (y ∊ ⋃ (img f a) → fv j y ∈ a ∧ y ∊ fv f (fv j y)) $ by all_intro [l65]
l67: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) ⇒ j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) $ by ax
l68: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) ⇒ cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) = j $ by eq_sym [l67]
l69: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) ⇒ functional (cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a))) $ by weaken [l9]
l70: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) ⇒ functional j $ by functional_eq [l68, l69]
l71: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) ⇒ functional j ∧ ∀ y (y ∊ ⋃ (img f a) → fv j y ∈ a ∧ y ∊ fv f (fv j y)) $ by and_intro [l70, l66]
l72: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) ⇒ ∃ d (functional d ∧ ∀ y (y ∊ ⋃ (img f a) → fv d y ∈ a ∧ y ∊ fv f (fv d y))) $ by ex_intro (t := $ j $) [l71]
l73: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w ⇒ ∃ d (functional d ∧ ∀ y (y ∊ ⋃ (img f a) → fv d y ∈ a ∧ y ∊ fv f (fv d y))) $ by isset_elim [l11, l72]
l74: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) ⇒ ∃ d (functional d ∧ ∀ y (y ∊ ⋃ (img f a) → fv d y ∈ a ∧ y ∊ fv f (fv d y))) $ by ex_elim [l6, l73]
l75: $ G ⇒ ∃ d (functional d ∧ ∀ y (y ∊ ⋃ (img f a) → fv d y ∈ a ∧ y ∊ fv f (fv d y))) $ by isset_elim [l5, l74]

lemma h3_pick {x y: set} (G: hyps x y) (a s f g d z: set):
  $ G ⇒ functional g $ > $ G ⇒ functional d $ > $ G ⇒ ∀ x (x ∊ a → fv g x ∈ injs (fv f x) s) $ > $ G ⇒ ∀ y (y ∊ ⋃ (img f a) → fv d y ∈ a ∧ y ∊ fv f (fv d y)) $ > $ G ⇒ z ∊ ⋃ (img f a) $ >
  $ G ⇒ fv d z ∈ a ∧ z ∊ fv f (fv d z) ∧ injects (fv g (fv d z)) (fv f (fv d z)) s $
----
l1: $ G ⇒ z ∊ ⋃ (img f a) → fv d z ∈ a ∧ z ∊ fv f (fv d z) $ by all_elim (t := $ z $) [#4]
l2: $ G ⇒ fv d z ∈ a ∧ z ∊ fv f (fv d z) $ by imp_elim [l1, #5]
l3: $ G ⇒ fv d z ∈ a $ by and_elim_l [l2]
l4: $ G ⇒ z ∊ fv f (fv d z) $ by and_elim_r [l2]
l5: $ G ⇒ isset (fv d z) $ by fv_set [#2]
l6: $ G , b = fv d z ⇒ b = fv d z $ by ax
l7: $ G , b = fv d z ⇒ fv d z = b $ by eq_sym [l6]
l8: $ G , b = fv d z ⇒ fv d z ∈ a $ by weaken [l3]
l9: $ G , b = fv d z ⇒ b ∈ a $ by wcel_eq_l [l7, l8]
l10: $ G , b = fv d z ⇒ b ∊ a $ by wcel_welc [l9]
l11: $ G , b = fv d z ⇒ ∀ x (x ∊ a → fv g x ∈ injs (fv f x) s) $ by weaken [#3]
l12: $ G , b = fv d z ⇒ b ∊ a → fv g b ∈ injs (fv f b) s $ by all_elim (t := $ b $) [l11]
l13: $ G , b = fv d z ⇒ fv g b ∈ injs (fv f b) s $ by imp_elim [l12, l10]
l14: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ c ∊ injs (fv f b) s $ by ax
l15: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ injects c (fv f b) s $ by injs_elim [l14]
l16: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ c = fv g b $ by ax
l17: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ g = g $ by eq_refl
l18: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ b = fv d z $ by ax
l19: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ fv g b = fv g (fv d z) $ by fv_eq [l17, l18]
l20: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ c = fv g (fv d z) $ by eq_trans [l16, l19]
l21: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ f = f $ by eq_refl
l22: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ fv f b = fv f (fv d z) $ by fv_eq [l21, l18]
l23: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ s = s $ by eq_refl
l24: $ G , b = fv d z , c = fv g b , c ∊ injs (fv f b) s ⇒ injects (fv g (fv d z)) (fv f (fv d z)) s $ by injects_eq [l20, l22, l23, l15]
l25: $ G , b = fv d z ⇒ injects (fv g (fv d z)) (fv f (fv d z)) s $ by wcel_elim [l13, l24]
l26: $ G ⇒ injects (fv g (fv d z)) (fv f (fv d z)) s $ by isset_elim [l5, l25]
l27: $ G ⇒ z ∊ fv f (fv d z) ∧ injects (fv g (fv d z)) (fv f (fv d z)) s $ by and_intro [l4, l26]
l28: $ G ⇒ fv d z ∈ a ∧ z ∊ fv f (fv d z) ∧ injects (fv g (fv d z)) (fv f (fv d z)) s $ by and_intro [l3, l27]

inj_into_cuni_fam
