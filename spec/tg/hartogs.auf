l52: $ G , w = img (cgr k {z | z ∊ a ∧ k ∊ fv f z}) (⋃ (img f a)) , chooses c w , j = cres (cgr k (fv c {z | z ∊ a ∧ k ∊ fv f z})) (⋃ (img f a)) , y ∊ ⋃ (img f a) ⇒ fv c {z | z ∊ a ∧ y ∊ fv f z} = fv j y $ by eq_sym [l51]
