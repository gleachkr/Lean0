l2: $ G ⇒ H ⊆ F $ by eq_subset [l1]
l3: $ G ⇒ injective H $ by injective_subset [#2, l2]

sb_f_injective
--------------
l1: $ [x/t] (∀ u ∀ v ∀ w (⟨ u , w ⟩ ∈ F ∧ ⟨ v , w ⟩ ∈ F → u = v)) ⟺ ∀ u ∀ v ∀ w (⟨ u , w ⟩ ∈ (⟦ x / t ⟧ F) ∧ ⟨ v , w ⟩ ∈ (⟦ x / t ⟧ F) → u = v) $ by iff_refl

