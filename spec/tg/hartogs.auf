l1: $ G ⇒ fn_into F A B ∧ injective (cres F A) $ by weaken [#1]
l2: $ G ⇒ injective (cres F A) $ by and_elim_r [l1]
l3: $ G ⇒ functional (ccnv (cres F A)) $ by injective_ccnv [l2]

injects_ccnv_fv
---------------
l1: $ G ⇒ fn_into F A B $ by injects_fn_into [#1]
l2: $ G ⇒ functional (ccnv (cres F A)) $ by injects_ccnv_functional [#1]
l3: $ G ⇒ functional F $ by fn_into_functional [l1]
k1: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ ⟨ a , v ⟩ ∈ F $ by ax
k2: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ a ∊ A $ by weaken [#2]
k3: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ ⟨ a , v ⟩ ∈ cres F A $ by cres_intro [k2, k1]
k4: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ ⟨ v , a ⟩ ∈ ccnv (cres F A) $ by ccnv_intro [k3]
k5: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ functional (ccnv (cres F A)) $ by weaken [l2]
k6: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ fv (ccnv (cres F A)) v = a $ by fv_val [k5, k4]
k7: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ functional F $ by weaken [l3]
k8: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ fv F a = v $ by fv_val [k7, k1]
k9: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ ccnv (cres F A) = ccnv (cres F A) $ by eq_refl
k10: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ fv (ccnv (cres F A)) (fv F a) = fv (ccnv (cres F A)) v $ by fv_eq [k9, k8]
k11: $ G , v ∊ B , ⟨ a , v ⟩ ∈ F ⇒ fv (ccnv (cres F A)) (fv F a) = a $ by eq_trans [k10, k6]
l4: $ G ⇒ fv (ccnv (cres F A)) (fv F a) = a $ by fn_into_elim [l1, #2, k11]

injects_ccnv_fv_pair
--------------------
l1: $ G ⇒ functional F $ by injects_functional [#1]
l2: $ G ⇒ fv F z = k $ by fv_val [l1, #3]
l3: $ G ⇒ fv (ccnv (cres F A)) (fv F z) = z $ by injects_ccnv_fv [#1, #2]
l4: $ G ⇒ ccnv (cres F A) = ccnv (cres F A) $ by eq_refl
l5: $ G ⇒ fv (ccnv (cres F A)) (fv F z) = fv (ccnv (cres F A)) k $ by fv_eq [l4, l2]
l6: $ G ⇒ fv (ccnv (cres F A)) k = fv (ccnv (cres F A)) (fv F z) $ by eq_sym [l5]
l7: $ G ⇒ fv (ccnv (cres F A)) k = z $ by eq_trans [l6, l3]

