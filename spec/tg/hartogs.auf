l132: $ G ⇒ ∃ j (functional j ∧ ∀ y (y ∊ ⋃ (img f a) → fv j y ∈ a ∧ y ∊ fv f (fv j y))) $ by choice_index (d := $ j $) [#1]
l133: $ G , functional g ∧ ∀ x (x ∊ a → fv g x ∈ injs (fv f x) s) ⇒ inj_into (⋃ (img f a)) (a × s) $ by ex_elim [l132, l130]
l134: $ G ⇒ inj_into (⋃ (img f a)) (a × s) $ by ex_elim [l131, l133]

shiftp_intro
------------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ G ⇒ isset (suc b) $ by suc_set [l2]
l4: $ G ⇒ isset ⟨ a , suc b ⟩ $ by opair_set [l1, l3]
l5: $ G , w = ⟨ a , suc b ⟩ ⇒ ⟨ a , b ⟩ ∈ X $ by weaken [#1]
l6: $ G , w = ⟨ a , suc b ⟩ ⇒ w = ⟨ a , suc b ⟩ $ by ax
l7: $ G , w = ⟨ a , suc b ⟩ ⇒ ⟨ a , b ⟩ ∈ X ∧ w = ⟨ a , suc b ⟩ $ by and_intro [l5, l6]
l8: $ G , w = ⟨ a , suc b ⟩ ⇒ ∃ k (⟨ a , k ⟩ ∈ X ∧ w = ⟨ a , suc k ⟩) $ by ex_intro (x := $ k $, t := $ b $, p := $ ⟨ a , k ⟩ ∈ X ∧ w = ⟨ a , suc k ⟩ $) [l7]
l9: $ G , w = ⟨ a , suc b ⟩ ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ex_intro (x := $ j $, t := $ a $, p := $ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $) [l8]
l10: $ G , w = ⟨ a , suc b ⟩ ⇒ w ∊ shiftp X $ by cab_intro (x := $ z $, t := $ w $, p := $ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) $) [l9]
l11: $ G , w = ⟨ a , suc b ⟩ ⇒ ⟨ a , suc b ⟩ ∈ shiftp X $ by wcel_intro [l6, l10]
l12: $ G ⇒ ⟨ a , suc b ⟩ ∈ shiftp X $ by isset_elim [l4, l11]

shiftp_elim
-----------
l1: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X ⇒ w ∊ shiftp X $ by ax
l2: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by cab_elim (x := $ z $, t := $ w $, p := $ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) $) [l1]
l3: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ $ by ax
l4: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X $ by and_elim_l [l3]
l5: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [l3]
l6: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w = ⟨ a , c ⟩ $ by ax
l7: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ a , c ⟩ = w $ by eq_sym [l6]
l8: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ a , c ⟩ = ⟨ j , suc k ⟩ $ by eq_trans [l7, l5]
l9: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset a $ by isset_var
l10: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset c $ by isset_var
l11: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset j $ by isset_var
l12: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset k $ by isset_var
l13: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset (suc k) $ by suc_set [l12]
l14: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ a = j ∧ c = suc k $ by opair_inj_c [l8, l9, l10, l11, l13]
l15: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ a = j $ by and_elim_l [l14]
l16: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ c = suc k $ by and_elim_r [l14]
l17: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ j = a $ by eq_sym [l15]
l18: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ k = k $ by eq_refl
l19: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ = ⟨ a , k ⟩ $ by opair_eq [l17, l18]
l20: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ a , k ⟩ ∈ X $ by wcel_eq_l [l19, l4]
l21: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ a , k ⟩ ∈ X ∧ c = suc k $ by and_intro [l20, l16]
l22: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $ by ex_intro (x := $ n $, t := $ k $, p := $ ⟨ a , n ⟩ ∈ X ∧ c = suc n $) [l21]
l23: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ax
l24: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $ by ex_elim [l23, l22]
l25: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $ by ex_elim [l2, l24]
l26: $ G ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $ by wcel_elim [#1, l25]

shiftp_rel
----------
l1: $ w ∊ shiftp X ⇒ w ∊ shiftp X $ by ax
l2: $ w ∊ shiftp X ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by cab_elim (x := $ z $, t := $ w $, p := $ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) $) [l1]
l3: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset k $ by isset_var
l4: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset (suc k) $ by suc_set [l3]
l5: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ $ by ax
l6: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [l5]
l7: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ i = suc k $ by ax
l8: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ suc k = i $ by eq_sym [l7]
l9: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ j = j $ by eq_refl
l10: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ ⟨ j , suc k ⟩ = ⟨ j , i ⟩ $ by opair_eq [l9, l8]
l11: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ w = ⟨ j , i ⟩ $ by eq_trans [l6, l10]
l12: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ ∃ v (w = ⟨ j , v ⟩) $ by ex_intro (x := $ v $, t := $ i $, p := $ w = ⟨ j , v ⟩ $) [l11]
l13: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by ex_intro (x := $ u $, t := $ j $, p := $ ∃ v (w = ⟨ u , v ⟩) $) [l12]
l14: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by isset_elim [l4, l13]
l15: $ w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ax
l16: $ w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by ex_elim [l15, l14]
l17: $ w ∊ shiftp X ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by ex_elim [l2, l16]
l18: $ G , w ∊ shiftp X ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by weaken [l17]
l19: $ G ⇒ rel (shiftp X) $ by rel_intro [l18]

shiftp_subset
-------------
l1: $ G , w ∊ shiftp X ⇒ w ∊ shiftp X $ by ax
l2: $ G , w ∊ shiftp X ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by cab_elim (x := $ z $, t := $ w $, p := $ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) $) [l1]
l3: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ $ by ax
l4: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X $ by and_elim_l [l3]
l5: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [l3]
l6: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ X ⊆ a × ω $ by weaken [#1]
l7: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ a × ω $ by wcel_subset [l6, l4]
l8: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ j ∊ a ∧ k ∊ ω $ by cxp_elim_pair [l7]
l9: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ j ∊ a $ by and_elim_l [l8]
l10: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ k ∊ ω $ by and_elim_r [l8]
l11: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ suc k ∈ ω $ by omega_suc [l10]
l12: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ j ∈ a $ by welc_wcel [l9]
l13: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , suc k ⟩ ∈ a × ω $ by cxp_intro_c [l12, l11]
l14: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , suc k ⟩ = w $ by eq_sym [l5]
l15: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w ∈ a × ω $ by wcel_eq_l [l14, l13]
l16: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w ∊ a × ω $ by wcel_welc [l15]
l17: $ G , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ax
l18: $ G , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ w ∊ a × ω $ by ex_elim [l17, l16]
l19: $ G , w ∊ shiftp X ⇒ w ∊ a × ω $ by ex_elim [l2, l18]
l20: $ G ⇒ shiftp X ⊆ a × ω $ by subset_intro [l19]

lemma h3_shiftp_dir (G: hyps) (X Y: class) (a b: set):
  $ G ⇒ shiftp X = shiftp Y $ > $ G ⇒ ⟨ a , b ⟩ ∈ X $ > $ G ⇒ ⟨ a , b ⟩ ∈ Y $
----
l1: $ G , v = suc b ⇒ ⟨ a , b ⟩ ∈ X $ by weaken [#2]
l2: $ G , v = suc b ⇒ ⟨ a , suc b ⟩ ∈ shiftp X $ by shiftp_intro [l1]
l3: $ G , v = suc b ⇒ shiftp X = shiftp Y $ by weaken [#1]
l4: $ G , v = suc b ⇒ ⟨ a , suc b ⟩ ∈ shiftp Y $ by wcel_eq_r [l3, l2]
l5: $ G , v = suc b ⇒ a = a $ by eq_refl
l6: $ G , v = suc b ⇒ v = suc b $ by ax
l7: $ G , v = suc b ⇒ suc b = v $ by eq_sym [l6]
l8: $ G , v = suc b ⇒ ⟨ a , suc b ⟩ = ⟨ a , v ⟩ $ by opair_eq [l5, l7]
l9: $ G , v = suc b ⇒ ⟨ a , v ⟩ ∈ shiftp Y $ by wcel_eq_l [l8, l4]
l10: $ G , v = suc b ⇒ ∃ k (⟨ a , k ⟩ ∈ Y ∧ v = suc k) $ by shiftp_elim (n := $ k $) [l9]
l11: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ ⟨ a , k ⟩ ∈ Y ∧ v = suc k $ by ax
l12: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ ⟨ a , k ⟩ ∈ Y $ by and_elim_l [l11]
l13: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ v = suc k $ by and_elim_r [l11]
l14: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ v = suc b $ by ax
l15: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ suc b = v $ by eq_sym [l14]
l16: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ suc b = suc k $ by eq_trans [l15, l13]
l17: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ b = k $ by suc_inj [l16]
l18: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ k = b $ by eq_sym [l17]
l19: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ a = a $ by eq_refl
l20: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ ⟨ a , k ⟩ = ⟨ a , b ⟩ $ by opair_eq [l19, l18]
l21: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ ⟨ a , b ⟩ ∈ Y $ by wcel_eq_l [l20, l12]
l22: $ G , v = suc b ⇒ ⟨ a , b ⟩ ∈ Y $ by ex_elim [l10, l21]
l23: $ G ⇒ isset b $ by isset_var
l24: $ G ⇒ isset (suc b) $ by suc_set [l23]
l25: $ G ⇒ ⟨ a , b ⟩ ∈ Y $ by isset_elim [l24, l22]

shiftp_inj
----------
l1: $ G , ⟨ x , y ⟩ ∈ X ⇒ shiftp X = shiftp Y $ by weaken [#3]
l2: $ G , ⟨ x , y ⟩ ∈ X ⇒ ⟨ x , y ⟩ ∈ X $ by ax
l3: $ G , ⟨ x , y ⟩ ∈ X ⇒ ⟨ x , y ⟩ ∈ Y $ by h3_shiftp_dir [l1, l2]
l4: $ G ⇒ shiftp Y = shiftp X $ by eq_sym [#3]
l5: $ G , ⟨ x , y ⟩ ∈ Y ⇒ shiftp Y = shiftp X $ by weaken [l4]
l6: $ G , ⟨ x , y ⟩ ∈ Y ⇒ ⟨ x , y ⟩ ∈ Y $ by ax
l7: $ G , ⟨ x , y ⟩ ∈ Y ⇒ ⟨ x , y ⟩ ∈ X $ by h3_shiftp_dir [l5, l6]
l8: $ G ⇒ X = Y $ by rel_eq_intro [#1, #2, l3, l7]

shiftp_set
----------
l1: $ G ⇒ isset x $ by isset_var
l2: $ G ⇒ isset (cdm x) $ by cdm_set [l1]
l3: $ G ⇒ isset (crn x) $ by crn_set [l1]
l4: $ G ⇒ functional (cgr i (suc i)) $ by cgr_functional
l5: $ G ⇒ isset (img (cgr i (suc i)) (crn x)) $ by img_set [l4, l3]
l6: $ G ⇒ isset (cdm x × img (cgr i (suc i)) (crn x)) $ by cxp_set [l2, l5]
l7: $ G , w ∊ shiftp x ⇒ w ∊ shiftp x $ by ax
l8: $ G , w ∊ shiftp x ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩) $ by cab_elim (x := $ z $, t := $ w $, p := $ ∃ j ∃ k (⟨ j , k ⟩ ∈ x ∧ z = ⟨ j , suc k ⟩) $) [l7]
l9: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ ⇒ isset k $ by isset_var
l10: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ ⇒ isset (suc k) $ by suc_set [l9]
l11: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ $ by ax
l12: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ ⟨ j , k ⟩ ∈ x $ by and_elim_l [l11]
l13: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [l11]
l14: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ j ∊ cdm x $ by cdm_intro [l12]
l15: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ k ∊ crn x $ by crn_intro [l12]
l16: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ v = suc k $ by ax
l17: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ ⟨ k , v ⟩ ∈ cgr i (suc i) $ by cgr_intro (x := $ i $, B := $ suc i $) [l16]
l18: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ v ∊ img (cgr i (suc i)) (crn x) $ by img_intro [l15, l17]
l19: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ j = j $ by eq_refl
l20: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ suc k = v $ by eq_sym [l16]
l21: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ ⟨ j , suc k ⟩ = ⟨ j , v ⟩ $ by opair_eq [l19, l20]
l22: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ w = ⟨ j , v ⟩ $ by eq_trans [l13, l21]
l23: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ w ∊ cdm x × img (cgr i (suc i)) (crn x) $ by cxp_intro_eq [l22, l14, l18]
l24: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ ⇒ w ∊ cdm x × img (cgr i (suc i)) (crn x) $ by isset_elim [l10, l23]
l25: $ G , w ∊ shiftp x , ∃ k (⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩) $ by ax
l26: $ G , w ∊ shiftp x , ∃ k (⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩) ⇒ w ∊ cdm x × img (cgr i (suc i)) (crn x) $ by ex_elim [l25, l24]
l27: $ G , w ∊ shiftp x ⇒ w ∊ cdm x × img (cgr i (suc i)) (crn x) $ by ex_elim [l8, l26]
l28: $ G ⇒ shiftp x ⊆ cdm x × img (cgr i (suc i)) (crn x) $ by subset_intro [l27]
l29: $ G ⇒ isset (shiftp x) $ by subset_isset [l6, l28]

shiftp_congr
------------
l0: $ ⟨ j , k ⟩ ≐ ⟨ j , k ⟩ $ by ceqt_refl
l1: $ (⟨ j , k ⟩ ∈ X) ⟺ (⟨ j , k ⟩ ∈ Y) $ by wcel_congr [l0, #1]
l2: $ (z = ⟨ j , suc k ⟩) ⟺ (z = ⟨ j , suc k ⟩) $ by iff_refl
l3: $ (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) ⟺ (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩) $ by and_congr [l1, l2]
l4: $ ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) ⟺ ∃ k (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩) $ by ex_congr [l3]
l5: $ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) ⟺ ∃ j ∃ k (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩) $ by ex_congr [l4]
l6: $ {z | ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩)} ≐ {z | ∃ j ∃ k (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩)} $ by cab_congr [l5]

shiftp_eq
---------
a1: $ G , w ∊ shiftp X ⇒ w ∊ shiftp X $ by ax
a2: $ G , w ∊ shiftp X ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by cab_elim (x := $ z $, t := $ w $, p := $ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) $) [a1]
a3: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ $ by ax
a4: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X $ by and_elim_l [a3]
a5: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [a3]
a6: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ X = Y $ by weaken [#1]
a7: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ Y $ by wcel_eq_r [a6, a4]
a8: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , suc k ⟩ ∈ shiftp Y $ by shiftp_intro [a7]
a9: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , suc k ⟩ = w $ by eq_sym [a5]
a10: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w ∈ shiftp Y $ by wcel_eq_l [a9, a8]
a11: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w ∊ shiftp Y $ by wcel_welc [a10]
a12: $ G , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ax
a13: $ G , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ w ∊ shiftp Y $ by ex_elim [a12, a11]
a14: $ G , w ∊ shiftp X ⇒ w ∊ shiftp Y $ by ex_elim [a2, a13]
b0: $ G ⇒ Y = X $ by eq_sym [#1]
b1: $ G , w ∊ shiftp Y ⇒ w ∊ shiftp Y $ by ax
b2: $ G , w ∊ shiftp Y ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩) $ by cab_elim (x := $ z $, t := $ w $, p := $ ∃ j ∃ k (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩) $) [b1]
b3: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ $ by ax
b4: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ Y $ by and_elim_l [b3]
b5: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [b3]
b6: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ Y = X $ by weaken [b0]
b7: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X $ by wcel_eq_r [b6, b4]
b8: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , suc k ⟩ ∈ shiftp X $ by shiftp_intro [b7]
b9: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , suc k ⟩ = w $ by eq_sym [b5]
b10: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ w ∈ shiftp X $ by wcel_eq_l [b9, b8]
b11: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ w ∊ shiftp X $ by wcel_welc [b10]
b12: $ G , w ∊ shiftp Y , ∃ k (⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩) $ by ax
b13: $ G , w ∊ shiftp Y , ∃ k (⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩) ⇒ w ∊ shiftp X $ by ex_elim [b12, b11]
b14: $ G , w ∊ shiftp Y ⇒ w ∊ shiftp X $ by ex_elim [b2, b13]
l1: $ G ⇒ shiftp X = shiftp Y $ by eq_intro [a14, b14]

sb_c_shiftp
-----------
l1: $ (⟦ x / t ⟧ {z | ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩)}) ≐ {z | ∃ j ∃ k (⟨ j , k ⟩ ∈ (⟦ x / t ⟧ X) ∧ z = ⟨ j , suc k ⟩)} $ by ceqt_refl

lemma h3_notin_shiftp (G: hyps) (X: class) (a: set): $ G ⇒ ⟨ a , ∅ ⟩ ∈ shiftp X $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G , c = ∅ ⇒ a = a $ by eq_refl
l3: $ G , c = ∅ ⇒ c = ∅ $ by ax
l4: $ G , c = ∅ ⇒ ∅ = c $ by eq_sym [l3]
l5: $ G , c = ∅ ⇒ ⟨ a , ∅ ⟩ = ⟨ a , c ⟩ $ by opair_eq [l2, l4]
l6: $ G , c = ∅ ⇒ ⟨ a , ∅ ⟩ ∈ shiftp X $ by weaken [#1]
l7: $ G , c = ∅ ⇒ ⟨ a , c ⟩ ∈ shiftp X $ by wcel_eq_l [l5, l6]
l8: $ G , c = ∅ ⇒ ∃ k (⟨ a , k ⟩ ∈ X ∧ c = suc k) $ by shiftp_elim (n := $ k $) [l7]
l9: $ G , c = ∅ , ⟨ a , k ⟩ ∈ X ∧ c = suc k ⇒ ⟨ a , k ⟩ ∈ X ∧ c = suc k $ by ax
l10: $ G , c = ∅ , ⟨ a , k ⟩ ∈ X ∧ c = suc k ⇒ c = suc k $ by and_elim_r [l9]
l11: $ G , c = ∅ , ⟨ a , k ⟩ ∈ X ∧ c = suc k ⇒ suc k = c $ by eq_sym [l10]
l12: $ G , c = ∅ , ⟨ a , k ⟩ ∈ X ∧ c = suc k ⇒ c = ∅ $ by ax
l13: $ G , c = ∅ , ⟨ a , k ⟩ ∈ X ∧ c = suc k ⇒ suc k = ∅ $ by eq_trans [l11, l12]
l14: $ G , c = ∅ , ⟨ a , k ⟩ ∈ X ∧ c = suc k ⇒ ⊥ $ by suc_ne_empty [l13]
l15: $ G , c = ∅ ⇒ ⊥ $ by ex_elim [l8, l14]
l16: $ G ⇒ ⊥ $ by isset_elim [l1, l15]

shift_val_fst
-------------
l1: $ G , c = ⟨ a , ∅ ⟩ ⇒ c = ⟨ a , ∅ ⟩ $ by ax
l2: $ G , c = ⟨ a , ∅ ⟩ ⇒ c ∊ csn ⟨ a , ∅ ⟩ $ by csn_intro [l1]
l3: $ G , c = ⟨ a , ∅ ⟩ ⇒ c ∊ csn ⟨ a , ∅ ⟩ ∪ shiftp u $ by cun_intro_l [l2]
l4: $ G , c = ⟨ a , ∅ ⟩ ⇒ csn ⟨ a , ∅ ⟩ ∪ shiftp u = csn ⟨ b , ∅ ⟩ ∪ shiftp v $ by weaken [#1]
l5: $ G , c = ⟨ a , ∅ ⟩ ⇒ c ∊ csn ⟨ b , ∅ ⟩ ∪ shiftp v $ by welc_eq [l4, l3]
l6: $ G , c = ⟨ a , ∅ ⟩ ⇒ c ∊ csn ⟨ b , ∅ ⟩ ∨ c ∊ shiftp v $ by cun_elim [l5]
l7: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ c ∊ csn ⟨ b , ∅ ⟩ $ by ax
l8: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ c = ⟨ b , ∅ ⟩ $ by csn_elim [l7]
l9: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ c = ⟨ a , ∅ ⟩ $ by ax
l10: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ ⟨ a , ∅ ⟩ = c $ by eq_sym [l9]
l11: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ ⟨ a , ∅ ⟩ = ⟨ b , ∅ ⟩ $ by eq_trans [l10, l8]
l12: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ isset a $ by isset_var
l13: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l14: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ isset b $ by isset_var
l15: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ a = b ∧ ∅ = ∅ $ by opair_inj_c [l11, l12, l13, l14, l13]
l16: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ a = b $ by and_elim_l [l15]
l17: $ G , c = ⟨ a , ∅ ⟩ , c ∊ shiftp v ⇒ c ∊ shiftp v $ by ax
l18: $ G , c = ⟨ a , ∅ ⟩ , c ∊ shiftp v ⇒ c = ⟨ a , ∅ ⟩ $ by ax
l19: $ G , c = ⟨ a , ∅ ⟩ , c ∊ shiftp v ⇒ ⟨ a , ∅ ⟩ ∈ shiftp v $ by wcel_intro [l18, l17]
l20: $ G , c = ⟨ a , ∅ ⟩ , c ∊ shiftp v ⇒ ⊥ $ by h3_notin_shiftp [l19]
l21: $ G , c = ⟨ a , ∅ ⟩ , c ∊ shiftp v ⇒ a = b $ by bot_elim [l20]
l22: $ G , c = ⟨ a , ∅ ⟩ ⇒ a = b $ by or_elim [l6, l16, l21]
l23: $ G ⇒ isset a $ by isset_var
l24: $ G ⇒ isset ∅ $ by ax_empty
l25: $ G ⇒ isset ⟨ a , ∅ ⟩ $ by opair_set [l23, l24]
l26: $ G ⇒ a = b $ by isset_elim [l25, l22]

lemma h3_sv_dir (G: hyps) (a b u v w: set):
  $ G ⇒ csn ⟨ a , ∅ ⟩ ∪ shiftp u = csn ⟨ b , ∅ ⟩ ∪ shiftp v $ > $ G ⇒ w ∊ shiftp u $ > $ G ⇒ w ∊ shiftp v $
----
l1: $ G ⇒ w ∊ csn ⟨ a , ∅ ⟩ ∪ shiftp u $ by cun_intro_r [#2]
l2: $ G ⇒ w ∊ csn ⟨ b , ∅ ⟩ ∪ shiftp v $ by welc_eq [#1, l1]
l3: $ G ⇒ w ∊ csn ⟨ b , ∅ ⟩ ∨ w ∊ shiftp v $ by cun_elim [l2]
l4: $ G , w ∊ csn ⟨ b , ∅ ⟩ ⇒ w ∊ csn ⟨ b , ∅ ⟩ $ by ax
l5: $ G , w ∊ csn ⟨ b , ∅ ⟩ ⇒ w = ⟨ b , ∅ ⟩ $ by csn_elim [l4]
l6: $ G , w ∊ csn ⟨ b , ∅ ⟩ ⇒ w ∊ shiftp u $ by weaken [#2]
l7: $ G , w ∊ csn ⟨ b , ∅ ⟩ ⇒ ⟨ b , ∅ ⟩ ∈ shiftp u $ by wcel_intro [l5, l6]
l8: $ G , w ∊ csn ⟨ b , ∅ ⟩ ⇒ ⊥ $ by h3_notin_shiftp [l7]
l9: $ G , w ∊ csn ⟨ b , ∅ ⟩ ⇒ w ∊ shiftp v $ by bot_elim [l8]
l10: $ G , w ∊ shiftp v ⇒ w ∊ shiftp v $ by ax
l11: $ G ⇒ w ∊ shiftp v $ by or_elim [l3, l9, l10]

shift_val_snd
-------------
l1: $ G , x ∊ shiftp u ⇒ csn ⟨ a , ∅ ⟩ ∪ shiftp u = csn ⟨ b , ∅ ⟩ ∪ shiftp v $ by weaken [#1]
l2: $ G , x ∊ shiftp u ⇒ x ∊ shiftp u $ by ax
l3: $ G , x ∊ shiftp u ⇒ x ∊ shiftp v $ by h3_sv_dir [l1, l2]
l4: $ G ⇒ csn ⟨ b , ∅ ⟩ ∪ shiftp v = csn ⟨ a , ∅ ⟩ ∪ shiftp u $ by eq_sym [#1]
l5: $ G , x ∊ shiftp v ⇒ csn ⟨ b , ∅ ⟩ ∪ shiftp v = csn ⟨ a , ∅ ⟩ ∪ shiftp u $ by weaken [l4]
l6: $ G , x ∊ shiftp v ⇒ x ∊ shiftp v $ by ax
l7: $ G , x ∊ shiftp v ⇒ x ∊ shiftp u $ by h3_sv_dir [l5, l6]
l8: $ G ⇒ shiftp u = shiftp v $ by eq_intro [l3, l7]

lemma h3_val_eq (G: hyps) (i j u k: set): $ G ⇒ i = j $ > $ G ⇒ u = k $ > $ G ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u = csn ⟨ j , ∅ ⟩ ∪ shiftp k $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ ⟨ i , ∅ ⟩ = ⟨ j , ∅ ⟩ $ by opair_eq [#1, l1]
l3: $ G ⇒ csn ⟨ i , ∅ ⟩ = csn ⟨ j , ∅ ⟩ $ by csn_eq [l2]
l4: $ G ⇒ shiftp u = shiftp k $ by shiftp_eq [#2]
l5: $ G ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by cun_eq [l3, l4]

lemma h3_val_set (G: hyps) (i u: set): $ G ⇒ isset (csn ⟨ i , ∅ ⟩ ∪ shiftp u) $
----
l1: $ G ⇒ isset i $ by isset_var
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset ⟨ i , ∅ ⟩ $ by opair_set [l1, l2]
l4: $ G ⇒ isset (csn ⟨ i , ∅ ⟩) $ by csn_set [l3]
l5: $ G ⇒ isset (shiftp u) $ by shiftp_set
l6: $ G ⇒ isset (csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by cun_set [l4, l5]

lemma h3_val_in (G: hyps) (a i u: set): $ G ⇒ i ∊ a $ > $ G ⇒ u ⊆ a × ω $ > $ G ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u ∈ 𝒫 (a × ω) $
----
l1: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ z ∊ csn ⟨ i , ∅ ⟩ $ by ax
l2: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ z = ⟨ i , ∅ ⟩ $ by csn_elim [l1]
l3: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ ⟨ i , ∅ ⟩ = z $ by eq_sym [l2]
l4: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ i ∊ a $ by weaken [#1]
l5: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ i ∈ a $ by welc_wcel [l4]
l6: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ ∅ ∈ ω $ by omega_zero
l7: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ ⟨ i , ∅ ⟩ ∈ a × ω $ by cxp_intro_c [l5, l6]
l8: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ z ∈ a × ω $ by wcel_eq_l [l3, l7]
l9: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ z ∊ a × ω $ by wcel_welc [l8]
l10: $ G ⇒ csn ⟨ i , ∅ ⟩ ⊆ a × ω $ by subset_intro [l9]
l11: $ G ⇒ shiftp u ⊆ a × ω $ by shiftp_subset [#2]
l12: $ G ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u ⊆ a × ω $ by cun_least [l10, l11]
l13: $ G ⇒ isset (csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by h3_val_set
l14: $ G ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u ∈ 𝒫 (a × ω) $ by wcel_cpw [l13, l12]

lemma h3_shift_intro (G: hyps) (A: class) (i u: set): $ G ⇒ i ∊ A $ > $ G ⇒ u ⊆ A × ω $ > $ G ⇒ ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ∈ shift A $
----
l1: $ G ⇒ isset i $ by isset_var
l2: $ G ⇒ isset u $ by isset_var
l3: $ G ⇒ isset ⟨ i , u ⟩ $ by opair_set [l1, l2]
l4: $ G ⇒ isset (csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by h3_val_set
l5: $ G ⇒ isset ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ $ by opair_set [l3, l4]
l6: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ i ∊ A $ by weaken [#1]
l7: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ u ⊆ A × ω $ by weaken [#2]
l8: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ $ by ax
l9: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ u ⊆ A × ω ∧ c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ $ by and_intro [l7, l8]
l10: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ i ∊ A ∧ u ⊆ A × ω ∧ c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ $ by and_intro [l6, l9]
l11: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ ∃ k (i ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ i , k ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp k ⟩) $ by ex_intro (x := $ k $, t := $ u $, p := $ i ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ i , k ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp k ⟩ $) [l10]
l12: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ ∃ j ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $ by ex_intro (x := $ j $, t := $ i $, p := $ ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $) [l11]
l13: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ c ∊ shift A $ by cab_intro (x := $ w $, t := $ c $, p := $ ∃ j ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ w = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $) [l12]
l14: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ∈ shift A $ by wcel_intro [l8, l13]
l15: $ G ⇒ ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ∈ shift A $ by isset_elim [l5, l14]

lemma h3_shift_elim (G: hyps) {i u: set} (A: class) (p q: set): $ G ⇒ ⟨ p , q ⟩ ∈ shift A $ >
  $ G ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $
----
l1: $ G , c = ⟨ p , q ⟩ , c ∊ shift A ⇒ c ∊ shift A $ by ax
l2: $ G , c = ⟨ p , q ⟩ , c ∊ shift A ⇒ ∃ j ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $ by cab_elim (x := $ w $, t := $ c $, p := $ ∃ j ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ w = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $) [l1]
l3: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ $ by ax
l4: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ j ∊ A $ by and_elim_l [l3]
l5: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ $ by and_elim_r [l3]
l6: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ k ⊆ A × ω $ by and_elim_l [l5]
l7: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ $ by and_elim_r [l5]
l8: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ c = ⟨ p , q ⟩ $ by ax
l9: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ ⟨ p , q ⟩ = c $ by eq_sym [l8]
l10: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ ⟨ p , q ⟩ = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ $ by eq_trans [l9, l7]
l11: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset p $ by isset_var
l12: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset q $ by isset_var
l13: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset j $ by isset_var
l14: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset k $ by isset_var
l15: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset ⟨ j , k ⟩ $ by opair_set [l13, l14]
l16: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset (csn ⟨ j , ∅ ⟩ ∪ shiftp k) $ by h3_val_set
l17: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ p = ⟨ j , k ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by opair_inj_c [l10, l11, l12, l15, l16]
l18: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ k ⊆ A × ω ∧ p = ⟨ j , k ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by and_intro [l6, l17]
l19: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ j ∊ A ∧ k ⊆ A × ω ∧ p = ⟨ j , k ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by and_intro [l4, l18]
l20: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ ∃ u (j ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ j , u ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp u) $ by ex_intro (x := $ u $, t := $ k $, p := $ j ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ j , u ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp u $) [l19]
l21: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by ex_intro (x := $ i $, t := $ j $, p := $ ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $) [l20]
l22: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) ⇒ ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $ by ax
l23: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by ex_elim [l22, l21]
l24: $ G , c = ⟨ p , q ⟩ , c ∊ shift A ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by ex_elim [l2, l23]
l25: $ G ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by wcel_elim [#1, l24]

