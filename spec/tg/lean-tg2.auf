l5: $ G ⇒ kr_nst_group ⊆ kr_nst_group $ by subset_refl
l6: $ G ⇒ kr_lseqv ⊆ kr_lseqv $ by subset_refl
l7: $ G ⇒ kr_lseqv ⊆ kr_nst_group $ by suc_subset
l8: $ G ⇒ kr_teqv ⊆ kr_cseqv $ by g2_f5
l9: $ G ⇒ kr_cseqv ⊆ kr_lseqv $ by suc_subset
l10: $ G ⇒ kr_teqv ⊆ kr_lseqv $ by subset_trans [l8, l9]
l11: $ G ⇒ kr_teqv ⊆ kr_nst_group $ by subset_trans [l10, l7]
l12: $ G ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ∨ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u4 $ by g2_wcel_cun_elim [l2]
l13: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u4 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u4 $ by ax
l14: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 $ by ax
l15: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ g2_u1 ⊆ g2_lab kr_ulevel (suc kr_ceqv) $ by g2_s1
l16: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_lab kr_ulevel (suc kr_ceqv) $ by wcel_subset [l15, l14]
l17: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ lprog2 $ by weaken [#1]
l18: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ isset kr_nst_group $ by weaken [l4]
l19: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ kr_nst_group ∈ suc kr_ceqv ∧ kr_ulevel ⊆ kr_nst_group $ by g2_lprog_lab [l17, l18, l16]
l20: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ kr_nst_group ∈ kr_teqv $ by and_elim_l [l19]
l21: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ kr_teqv ⊆ kr_nst_group $ by weaken [l11]
l22: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ kr_nst_group ∈ kr_nst_group $ by wcel_subset [l21, l20]
l23: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ ⊥ $ by notin_self_c [l22]
l24: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u1 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u4 $ by bot_elim [l23]
l25: $ G ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u4 $ by or_elim [l12, l24, l13]
l26: $ G ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ∨ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u6 $ by g2_wcel_cun_elim [l25]
l27: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u6 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u6 $ by ax
l28: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 $ by ax
l29: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ g2_u5 ⊆ g2_lab kr_teqv (suc kr_cseqv) $ by g2_s5
l30: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_lab kr_teqv (suc kr_cseqv) $ by wcel_subset [l29, l28]
l31: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ lprog2 $ by weaken [#1]
l32: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ isset kr_nst_group $ by weaken [l4]
l33: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ kr_nst_group ∈ suc kr_cseqv ∧ kr_teqv ⊆ kr_nst_group $ by g2_lprog_lab [l31, l32, l30]
l34: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ kr_nst_group ∈ kr_lseqv $ by and_elim_l [l33]
l35: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ kr_lseqv ⊆ kr_nst_group $ by weaken [l7]
l36: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ kr_nst_group ∈ kr_nst_group $ by wcel_subset [l35, l34]
l37: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ ⊥ $ by notin_self_c [l36]
l38: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u5 ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u6 $ by bot_elim [l37]
l39: $ G ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_u6 $ by or_elim [l26, l38, l27]
l40: $ G ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ∨ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_nst_group $ by g2_wcel_cun_elim [l39]
l41: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_nst_group ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_nst_group $ by ax
l42: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv $ by ax
l43: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ pr_lseqv ⊆ g2_lab kr_lseqv (suc kr_lseqv) $ by g2_p_lseqv
l44: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ g2_lab kr_lseqv (suc kr_lseqv) $ by wcel_subset [l43, l42]
l45: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ lprog2 $ by weaken [#1]
l46: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ isset kr_nst_group $ by weaken [l4]
l47: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ kr_nst_group ∈ suc kr_lseqv ∧ kr_lseqv ⊆ kr_nst_group $ by g2_lprog_lab [l45, l46, l44]
l48: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ kr_nst_group ∈ kr_nst_group $ by and_elim_l [l47]
l49: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ kr_nst_group ⊆ kr_nst_group $ by weaken [l5]
l50: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ kr_nst_group ∈ kr_nst_group $ by wcel_subset [l49, l48]
l51: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ ⊥ $ by notin_self_c [l50]
l52: $ G , ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_lseqv ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_nst_group $ by bot_elim [l51]
l53: $ G ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_nst_group $ by or_elim [l40, l52, l41]

-- Lemmas of g2: equations of argument lists.

--| The class of all sets: argument lists are sequences over it.
def g2_vv (.x: set): class = $ {x | x = x} $

lemma g2_vv_in (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ g2_vv $
----
l1: $ G , x = A ⇒ x = x $ by eq_refl
l2: $ G , x = A ⇒ x ∊ g2_vv $ by cab_intro [l1]
l3: $ G , x = A ⇒ x = A $ by ax
l4: $ G , x = A ⇒ A ∈ g2_vv $ by wcel_intro [l3, l2]
l5: $ G ⇒ A ∈ g2_vv $ by isset_elim [#1, l4]

lemma g2_fs (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ S ∈ fseq g2_vv $ > $ G ⇒ scons A S ∈ fseq g2_vv $
----
l1: $ G ⇒ A ∈ g2_vv $ by g2_vv_in [#1]
l2: $ G ⇒ scons A S ∈ fseq g2_vv $ by scons_fseq_c [l1, #2]

--| Class form of `scons_inj`, for sequences.
lemma g2_scons_inj (G: hyps) (A B S T: class):
  $ G ⇒ scons A S = scons B T $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ >
  $ G ⇒ S ∈ fseq g2_vv $ > $ G ⇒ T ∈ fseq g2_vv $ > $ G ⇒ A = B ∧ S = T $
----
l1: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ c ∊ fseq g2_vv $ by ax
l2: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ d ∊ fseq g2_vv $ by ax
l3: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ rel c $ by fseq_rel [l1]
l4: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ rel d $ by fseq_rel [l2]
l5: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ a = A $ by ax
l6: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ b = B $ by ax
l7: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ c = S $ by ax
l8: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ d = T $ by ax
l9: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ scons a c = scons A S $ by scons_eq [l5, l7]
l10: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ scons b d = scons B T $ by scons_eq [l6, l8]
l11: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ scons A S = scons B T $ by weaken [#1]
l12: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ scons a c = scons B T $ by eq_trans [l9, l11]
l13: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ scons B T = scons b d $ by eq_sym [l10]
l14: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ scons a c = scons b d $ by eq_trans [l12, l13]
l15: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ a = b ∧ c = d $ by scons_inj [l3, l4, l14]
l16: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ a = b $ by and_elim_l [l15]
l17: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ c = d $ by and_elim_r [l15]
l18: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ A = a $ by eq_sym [l5]
l19: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ A = b $ by eq_trans [l18, l16]
l20: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ A = B $ by eq_trans [l19, l6]
l21: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ S = c $ by eq_sym [l7]
l22: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ S = d $ by eq_trans [l21, l17]
l23: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ S = T $ by eq_trans [l22, l8]
l24: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv , d = T , d ∊ fseq g2_vv ⇒ A = B ∧ S = T $ by and_intro [l20, l23]
l25: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv ⇒ T ∈ fseq g2_vv $ by weaken [#5]
l26: $ G , a = A , b = B , c = S , c ∊ fseq g2_vv ⇒ A = B ∧ S = T $ by wcel_elim [l25, l24]
l27: $ G , a = A , b = B ⇒ S ∈ fseq g2_vv $ by weaken [#4]
l28: $ G , a = A , b = B ⇒ A = B ∧ S = T $ by wcel_elim [l27, l26]
l29: $ G , a = A ⇒ isset B $ by weaken [#3]
l30: $ G , a = A ⇒ A = B ∧ S = T $ by isset_elim [l29, l28]
l31: $ G ⇒ A = B ∧ S = T $ by isset_elim [#2, l30]

lemma g2_e_ulevel_prop (G: hyps) {l_v u_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ = ⟨ ∅ , ra_ulevel V1 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq V1 ⟨ kc_lz , ∅ ⟩ $ >
  $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_ulevel V1 V2 ⟩ = ⟨ pp , ra_ulevel t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ulevel t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_ulevel V1 V2) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_ulevel t1 t2 = ra_ulevel V1 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ulevel t1 t2 = ra_ulevel V1 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset V2 $ by isset_var
l15: $ G ⇒ scons V2 ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_ulevel ∈ ω $ by kr_ulevel_omega
l19: $ G ⇒ isset kr_ulevel $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons V2 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_ulevel = kr_ulevel ∧ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V2 ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V2 $ by and_elim_l [l27]
l29: $ G ⇒ t2 = V2 ∧ lveq V1 ⟨ kc_lz , ∅ ⟩ $ by and_intro [l28, #3]
l30: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ lveq V1 ⟨ kc_lz , ∅ ⟩ $ by and_intro [l25, l29]
l31: $ G ⇒ ∃ u_v (t1 = V1 ∧ t2 = u_v ∧ lveq V1 ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l30]
l32: $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l31]

lemma g2_d_ulevel_prop (G: hyps) {l_v u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x ∊ cl_ulevel_prop ⇒ x ∊ cl_ulevel_prop $ by ax
l2: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x ∊ cl_ulevel_prop ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ pp , ra_ulevel t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ lveq y ⟨ kc_lz , ∅ ⟩ $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ = ⟨ ∅ , ra_ulevel y z ⟩ $ by eq_trans [l4, l6]
l9: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l10: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) $ by g2_e_ulevel_prop [l8, l9, l7]
l11: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x ∊ cl_ulevel_prop ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) $ by wcel_elim [#1, l13]

lemma g2_e_ulevel_le (G: hyps) {l_v u_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ = ⟨ ∅ , ra_ulevel V1 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq ⟨ kc_lmax , scons V1 (scons V2 ∅) ⟩ V1 $ >
  $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_ulevel V1 V2 ⟩ = ⟨ pp , ra_ulevel t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ulevel t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_ulevel V1 V2) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_ulevel t1 t2 = ra_ulevel V1 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ulevel t1 t2 = ra_ulevel V1 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset V2 $ by isset_var
l15: $ G ⇒ scons V2 ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_ulevel ∈ ω $ by kr_ulevel_omega
l19: $ G ⇒ isset kr_ulevel $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons V2 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_ulevel = kr_ulevel ∧ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V2 ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V2 $ by and_elim_l [l27]
l29: $ G ⇒ t2 = V2 ∧ lveq ⟨ kc_lmax , scons V1 (scons V2 ∅) ⟩ V1 $ by and_intro [l28, #3]
l30: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ lveq ⟨ kc_lmax , scons V1 (scons V2 ∅) ⟩ V1 $ by and_intro [l25, l29]
l31: $ G ⇒ ∃ u_v (t1 = V1 ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons V1 (scons u_v ∅) ⟩ V1) $ by ex_intro [l30]
l32: $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by ex_intro [l31]

lemma g2_d_ulevel_le (G: hyps) {l_v u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $
----
l1: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x ∊ cl_ulevel_le ⇒ x ∊ cl_ulevel_le $ by ax
l2: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x ∊ cl_ulevel_le ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ x = ⟨ pp , ra_ulevel t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y $ by ax
l6: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ = ⟨ ∅ , ra_ulevel y z ⟩ $ by eq_trans [l4, l6]
l9: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l10: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by g2_e_ulevel_le [l8, l9, l7]
l11: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) ⇒ ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) $ by ax
l12: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ulevel t1 t2 ⟩ , x ∊ cl_ulevel_le ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by wcel_elim [#1, l13]

lemma g2_o_ulevel (G: hyps) {l_v u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ pr_ulevel $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $
----
l1: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le $ by ax
l2: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by g2_d_ulevel_le [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le → ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le $ by ax
l6: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∨ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le $ by g2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop $ by ax
l8: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l9: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) $ by g2_d_ulevel_prop [l7, l8]
l10: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le $ by ax
l12: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le → ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_le ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ulevel t1 t2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le → ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by imp_intro [l15]
l17: $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by imp_elim [l16, #1]

lrel2_ulevel_cases
------------------
l1: $ G ⇒ isset (ra_ulevel t1 t2) $ by opair_isset
l2: $ G , c = ra_ulevel t1 t2 ⇒ c = ra_ulevel t1 t2 $ by ax
l3: $ G , c = ra_ulevel t1 t2 ⇒ ra_ulevel t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_ulevel t1 t2 ⇒ ra_ulevel t1 t2 ∈ lrel2 $ by weaken [#1]
l5: $ G , c = ra_ulevel t1 t2 ⇒ c ∈ lrel2 $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_ulevel t1 t2 ⇒ c ∊ lrel2 $ by wcel_welc [l5]
l7: $ G , c = ra_ulevel t1 t2 ⇒ hprog lprog2 latoms $ by lprog2_hprog
l8: $ G , c = ra_ulevel t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2) $ by horn_elim [l7, l6]
l9: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 $ by ax
l10: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 $ by and_elim_l [l9]
l11: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ crn p ⊆ lrel2 $ by and_elim_r [l9]
l12: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ p = p $ by eq_refl
l13: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ c = ra_ulevel t1 t2 $ by ax
l14: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ = ⟨ p , ra_ulevel t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_ulevel t1 t2 ⟩ ∈ lprog2 $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_ulevel t1 t2 ⟩ ∈ pr_ulevel $ by lprog2_ulevel_pr [l15]
l17: $ G , c = ra_ulevel t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by g2_o_ulevel [l16, l11]
l18: $ G , c = ra_ulevel t1 t2 ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , scons l_v (scons u_v ∅) ⟩ l_v) $ by isset_elim [l1, l18]

lemma g2_e_eeqv_refl (G: hyps) {e_v: set} (pp t1 t2 V1: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_eeqv V1 V1 ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_eeqv t1 t2 = ra_eeqv V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ scons V1 ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq g2_vv $ by g2_fs [l14, l15]
l17: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l18: $ G ⇒ isset kr_eeqv $ by wcel_isset [l17]
l19: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l20: $ G ⇒ isset (scons V1 (scons V1 ∅)) $ by wcel_isset [l16]
l21: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons V1 (scons V1 ∅) $ by opair_inj_c [l8, l18, l19, l18, l20]
l22: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l21]
l23: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V1 ∅ $ by g2_scons_inj [l22, l12, l14, l11, l15]
l24: $ G ⇒ t1 = V1 $ by and_elim_l [l23]
l25: $ G ⇒ scons t2 ∅ = scons V1 ∅ $ by and_elim_r [l23]
l26: $ G ⇒ t2 = V1 ∧ ∅ = ∅ $ by g2_scons_inj [l25, l10, l14, l9, l9]
l27: $ G ⇒ t2 = V1 $ by and_elim_l [l26]
l28: $ G ⇒ t1 = V1 ∧ t2 = V1 $ by and_intro [l24, l27]
l29: $ G ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) $ by ex_intro [l28]

lemma g2_d_eeqv_refl (G: hyps) {e_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_refl $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_refl ⇒ x ∊ cl_eeqv_refl $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_refl ⇒ ∃ y (x = ⟨ ∅ , ra_eeqv y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ x = ⟨ ∅ , ra_eeqv y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) $ by g2_e_eeqv_refl [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_refl ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) $ by wcel_elim [#1, l9]

lemma g2_e_eeqv_bvar (G: hyps) {i_v: set} (pp t1 t2 V1: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_bvar , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_bvar , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_bvar , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_bvar , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_bvar , scons V1 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ scons ⟨ kc_bvar , scons V1 ∅ ⟩ (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l14, l15]
l17: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l18: $ G ⇒ isset kr_eeqv $ by wcel_isset [l17]
l19: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l20: $ G ⇒ isset (scons ⟨ kc_bvar , scons V1 ∅ ⟩ (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅)) $ by wcel_isset [l16]
l21: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_bvar , scons V1 ∅ ⟩ (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅) $ by opair_inj_c [l8, l18, l19, l18, l20]
l22: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_bvar , scons V1 ∅ ⟩ (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅) $ by and_elim_r [l21]
l23: $ G ⇒ t1 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ $ by g2_scons_inj [l22, l12, l14, l11, l15]
l24: $ G ⇒ t1 = ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_elim_l [l23]
l25: $ G ⇒ scons t2 ∅ = scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l23]
l26: $ G ⇒ t2 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l25, l10, l14, l9, l9]
l27: $ G ⇒ t2 = ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_elim_l [l26]
l28: $ G ⇒ t1 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_intro [l24, l27]
l29: $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) $ by ex_intro [l28]

lemma g2_d_eeqv_bvar (G: hyps) {i_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_bvar $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_bvar ⇒ x ∊ cl_eeqv_bvar $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_bvar ⇒ ∃ y (x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) $ by g2_e_eeqv_bvar [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_bvar ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) $ by wcel_elim [#1, l9]

lemma g2_e_eeqv_srt (G: hyps) {l_v l2: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_srt , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq V1 V2 $ >
  $ G ⇒ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) $
----
l1: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_srt , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_srt , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_srt , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_srt , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_srt , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_srt , scons V1 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_srt , scons V1 ∅ ⟩ (scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_srt , scons V1 ∅ ⟩ (scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_srt , scons V1 ∅ ⟩ (scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_srt , scons V1 ∅ ⟩ (scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_srt , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_srt , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_srt , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_srt , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t2 = ⟨ kc_srt , scons V2 ∅ ⟩ ∧ lveq V1 V2 $ by and_intro [l28, #3]
l30: $ G ⇒ t1 = ⟨ kc_srt , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons V2 ∅ ⟩ ∧ lveq V1 V2 $ by and_intro [l25, l29]
l31: $ G ⇒ ∃ l2 (t1 = ⟨ kc_srt , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq V1 l2) $ by ex_intro [l30]
l32: $ G ⇒ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) $ by ex_intro [l31]

lemma g2_d_eeqv_srt (G: hyps) {l_v l2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_srt $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_srt ⇒ x ∊ cl_eeqv_srt $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_srt ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ lveq y z $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l6]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) $ by g2_e_eeqv_srt [l8, l9, l7]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_srt ⇒ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) $ by wcel_elim [#1, l13]

lemma g2_e_eeqv_app (G: hyps) {f_v a_v f2 a2: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) , ra_eeqv ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) , ra_eeqv ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_app , scons V3 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_eeqv V1 V3) $ by opair_isset
l32: $ G ⇒ ra_eeqv V1 V3 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_eeqv V2 V4) ∅) ⊆ lrel2 $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_eeqv V2 V4) $ by opair_isset
l35: $ G ⇒ ra_eeqv V2 V4 ∈ lrel2 $ by crn_scons_head [l34, l33]
l36: $ G ⇒ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l32, l35]
l37: $ G ⇒ t2 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l28, l36]
l38: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l25, l37]
l39: $ G ⇒ ∃ a2 (t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_app , scons V3 (scons a2 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 a2 ∈ lrel2) $ by ex_intro [l38]
l40: $ G ⇒ ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv V1 f2 ∈ lrel2 ∧ ra_eeqv V2 a2 ∈ lrel2) $ by ex_intro [l39]
l41: $ G ⇒ ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons V1 (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv V1 f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $ by ex_intro [l40]
l42: $ G ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $ by ex_intro [l41]

lemma g2_d_eeqv_app (G: hyps) {f_v a_v f2 a2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_app $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_app ⇒ x ∊ cl_eeqv_app $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_app ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩ ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $ by g2_e_eeqv_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_app , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_app ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) $ by wcel_elim [#1, l15]

lemma g2_e_eeqv_lam (G: hyps) {A b_v A2 b2: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) , ra_eeqv ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) , ra_eeqv ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_eeqv V1 V3) $ by opair_isset
l32: $ G ⇒ ra_eeqv V1 V3 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_eeqv V2 V4) ∅) ⊆ lrel2 $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_eeqv V2 V4) $ by opair_isset
l35: $ G ⇒ ra_eeqv V2 V4 ∈ lrel2 $ by crn_scons_head [l34, l33]
l36: $ G ⇒ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l32, l35]
l37: $ G ⇒ t2 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l28, l36]
l38: $ G ⇒ t1 = ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l25, l37]
l39: $ G ⇒ ∃ b2 (t1 = ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons V3 (scons b2 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 b2 ∈ lrel2) $ by ex_intro [l38]
l40: $ G ⇒ ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv V1 A2 ∈ lrel2 ∧ ra_eeqv V2 b2 ∈ lrel2) $ by ex_intro [l39]
l41: $ G ⇒ ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons V1 (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv V1 A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_intro [l40]
l42: $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_intro [l41]

lemma g2_d_eeqv_lam (G: hyps) {A b_v A2 b2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_lam $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_lam ⇒ x ∊ cl_eeqv_lam $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_lam ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩ ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by g2_e_eeqv_lam [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_lam ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by wcel_elim [#1, l15]

lemma g2_e_eeqv_pi (G: hyps) {A b_v A2 b2: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) , ra_eeqv ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) , ra_eeqv ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_eeqv V1 V3) (scons (ra_eeqv V2 V4) ∅)) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_eeqv V1 V3) $ by opair_isset
l32: $ G ⇒ ra_eeqv V1 V3 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_eeqv V2 V4) ∅) ⊆ lrel2 $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_eeqv V2 V4) $ by opair_isset
l35: $ G ⇒ ra_eeqv V2 V4 ∈ lrel2 $ by crn_scons_head [l34, l33]
l36: $ G ⇒ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l32, l35]
l37: $ G ⇒ t2 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l28, l36]
l38: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 V4 ∈ lrel2 $ by and_intro [l25, l37]
l39: $ G ⇒ ∃ b2 (t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons V3 (scons b2 ∅) ⟩ ∧ ra_eeqv V1 V3 ∈ lrel2 ∧ ra_eeqv V2 b2 ∈ lrel2) $ by ex_intro [l38]
l40: $ G ⇒ ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv V1 A2 ∈ lrel2 ∧ ra_eeqv V2 b2 ∈ lrel2) $ by ex_intro [l39]
l41: $ G ⇒ ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons V1 (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv V1 A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_intro [l40]
l42: $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_intro [l41]

lemma g2_d_eeqv_pi (G: hyps) {A b_v A2 b2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_pi $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_pi ⇒ x ∊ cl_eeqv_pi $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_pi ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩ ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by g2_e_eeqv_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y u) (scons (ra_eeqv z v) ∅) , ra_eeqv ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_pi ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) $ by wcel_elim [#1, l15]

lemma g2_e_eeqv_lit (G: hyps) {n_v: set} (pp t1 t2 V1: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons V1 ∅ ⟩ ⟨ kc_lit , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons V1 ∅ ⟩ ⟨ kc_lit , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_lit , scons V1 ∅ ⟩ ⟨ kc_lit , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_lit , scons V1 ∅ ⟩ ⟨ kc_lit , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_lit , scons V1 ∅ ⟩ ⟨ kc_lit , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_lit , scons V1 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ scons ⟨ kc_lit , scons V1 ∅ ⟩ (scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l14, l15]
l17: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l18: $ G ⇒ isset kr_eeqv $ by wcel_isset [l17]
l19: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l20: $ G ⇒ isset (scons ⟨ kc_lit , scons V1 ∅ ⟩ (scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅)) $ by wcel_isset [l16]
l21: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_lit , scons V1 ∅ ⟩ (scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅) $ by opair_inj_c [l8, l18, l19, l18, l20]
l22: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_lit , scons V1 ∅ ⟩ (scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅) $ by and_elim_r [l21]
l23: $ G ⇒ t1 = ⟨ kc_lit , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅ $ by g2_scons_inj [l22, l12, l14, l11, l15]
l24: $ G ⇒ t1 = ⟨ kc_lit , scons V1 ∅ ⟩ $ by and_elim_l [l23]
l25: $ G ⇒ scons t2 ∅ = scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l23]
l26: $ G ⇒ t2 = ⟨ kc_lit , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l25, l10, l14, l9, l9]
l27: $ G ⇒ t2 = ⟨ kc_lit , scons V1 ∅ ⟩ $ by and_elim_l [l26]
l28: $ G ⇒ t1 = ⟨ kc_lit , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons V1 ∅ ⟩ $ by and_intro [l24, l27]
l29: $ G ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by ex_intro [l28]

lemma g2_d_eeqv_lit (G: hyps) {n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_lit $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_lit ⇒ x ∊ cl_eeqv_lit $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_lit ⇒ ∃ y (x = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_lit , scons y ∅ ⟩ ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by g2_e_eeqv_lit [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_lit ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by wcel_elim [#1, l9]

lemma g2_e_eeqv_cst (G: hyps) {a_v S S2: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_lseqv V2 V3) ∅ , ra_eeqv ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_lseqv V2 V3) ∅ , ra_eeqv ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lseqv V2 V3) ∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lseqv V2 V3) ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lseqv V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_lseqv V2 V3) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_lseqv V2 V3) ∅) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_lseqv V2 V3) $ by opair_isset
l32: $ G ⇒ ra_lseqv V2 V3 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∧ ra_lseqv V2 V3 ∈ lrel2 $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons V1 (scons V3 ∅) ⟩ ∧ ra_lseqv V2 V3 ∈ lrel2 $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ S2 (t1 = ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons V1 (scons S2 ∅) ⟩ ∧ ra_lseqv V2 S2 ∈ lrel2) $ by ex_intro [l34]
l36: $ G ⇒ ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons V1 (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons V1 (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_intro [l35]
l37: $ G ⇒ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_intro [l36]

lemma g2_d_eeqv_cst (G: hyps) {a_v S S2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_cst $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_cst ⇒ x ∊ cl_eeqv_cst $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_cst ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩ ⇒ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $ by g2_e_eeqv_cst [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_lseqv z u) ∅ , ra_eeqv ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟨ kc_cst , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_cst ⇒ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) $ by wcel_elim [#1, l13]

lemma g2_e_eeqv_ind_ty (G: hyps) {D D2 i_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_ind_eqv V1 V2) ∅ , ra_eeqv ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_eqv V1 V2) ∅ , ra_eeqv ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_eqv V1 V2) ∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_eqv V1 V2) ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_eqv V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_ind_eqv V1 V2) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_ind_eqv V1 V2) ∅) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_ind_eqv V1 V2) $ by opair_isset
l32: $ G ⇒ ra_ind_eqv V1 V2 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ i_v (t1 = ⟨ kc_ind_ty , scons V1 (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons V2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2) $ by ex_intro [l34]
l36: $ G ⇒ ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons V1 (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv V1 D2 ∈ lrel2) $ by ex_intro [l35]
l37: $ G ⇒ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_intro [l36]

lemma g2_d_eeqv_ind_ty (G: hyps) {D D2 i_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_ind_ty $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_ty ⇒ x ∊ cl_eeqv_ind_ty $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_ty ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by g2_e_eeqv_ind_ty [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_ty ⇒ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by wcel_elim [#1, l13]

lemma g2_e_eeqv_ind_ctor (G: hyps) {D D2 i_v c_v: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_ind_eqv V1 V2) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_eqv V1 V2) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_eqv V1 V2) ∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_eqv V1 V2) ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_eqv V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_ind_eqv V1 V2) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_ind_eqv V1 V2) ∅) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_ind_eqv V1 V2) $ by opair_isset
l32: $ G ⇒ ra_ind_eqv V1 V2 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ c_v (t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons c_v ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2) $ by ex_intro [l34]
l36: $ G ⇒ ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons V1 (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2) $ by ex_intro [l35]
l37: $ G ⇒ ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons V1 (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv V1 D2 ∈ lrel2) $ by ex_intro [l36]
l38: $ G ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_intro [l37]

lemma g2_d_eeqv_ind_ctor (G: hyps) {D D2 i_v c_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_ind_ctor $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_ctor ⇒ x ∊ cl_eeqv_ind_ctor $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_ctor ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by g2_e_eeqv_ind_ctor [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_ctor ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) $ by wcel_elim [#1, l15]

lemma g2_e_eeqv_ind_rec (G: hyps) {D D2 i_v v_v v2: set} (pp t1 t2 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_ind_eqv V1 V2) ∅ , ra_eeqv ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq V4 V5 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_eqv V1 V2) ∅ , ra_eeqv ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_eqv V1 V2) ∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_eqv V1 V2) ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_eqv V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ (scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ (scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ (scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ (scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_ind_eqv V1 V2) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_ind_eqv V1 V2) ∅) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_ind_eqv V1 V2) $ by opair_isset
l32: $ G ⇒ ra_ind_eqv V1 V2 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ ra_ind_eqv V1 V2 ∈ lrel2 ∧ lveq V4 V5 $ by and_intro [l32, #3]
l34: $ G ⇒ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 ∧ lveq V4 V5 $ by and_intro [l28, l33]
l35: $ G ⇒ t1 = ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons V5 ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 ∧ lveq V4 V5 $ by and_intro [l25, l34]
l36: $ G ⇒ ∃ v2 (t1 = ⟨ kc_ind_rec , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons v2 ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 ∧ lveq V4 v2) $ by ex_intro [l35]
l37: $ G ⇒ ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons V1 (scons V3 (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons v2 ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_intro [l36]
l38: $ G ⇒ ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons V1 (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons V2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv V1 V2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_intro [l37]
l39: $ G ⇒ ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons V1 (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv V1 D2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_intro [l38]
l40: $ G ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_intro [l39]

lemma g2_d_eeqv_ind_rec (G: hyps) {D D2 i_v v_v v2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_ind_rec $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_rec ⇒ x ∊ cl_eeqv_ind_rec $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_rec ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w ⇒ x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w ⇒ x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w ⇒ lveq v w $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ $ by eq_trans [l4, l6]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $ by g2_e_eeqv_ind_rec [l8, l9, l7]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) ⇒ ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) $ by ax
l14: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) $ by ax
l16: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) $ by ax
l18: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ind_eqv y z) ∅ , ra_eeqv ⟨ kc_ind_rec , scons y (scons u (scons v ∅)) ⟩ ⟨ kc_ind_rec , scons z (scons u (scons w ∅)) ⟩ ⟩ ∧ lveq v w) ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_ind_rec ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) $ by wcel_elim [#1, l19]

lemma g2_e_eeqv_proj (G: hyps) {b_v i_v e_v e2: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_eeqv V3 V4) ∅ , ra_eeqv ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_eeqv V3 V4) ∅ , ra_eeqv ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_eeqv V3 V4) ∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_eeqv V3 V4) ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_eeqv V3 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_eeqv V3 V4) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_eeqv V3 V4) ∅) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_eeqv V3 V4) $ by opair_isset
l32: $ G ⇒ ra_eeqv V3 V4 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∧ ra_eeqv V3 V4 ∈ lrel2 $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons V1 (scons V2 (scons V4 ∅)) ⟩ ∧ ra_eeqv V3 V4 ∈ lrel2 $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ e2 (t1 = ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons V1 (scons V2 (scons e2 ∅)) ⟩ ∧ ra_eeqv V3 e2 ∈ lrel2) $ by ex_intro [l34]
l36: $ G ⇒ ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons V1 (scons V2 (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons V1 (scons V2 (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by ex_intro [l35]
l37: $ G ⇒ ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons V1 (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons V1 (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by ex_intro [l36]
l38: $ G ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by ex_intro [l37]

lemma g2_d_eeqv_proj (G: hyps) {b_v i_v e_v e2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_proj $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_proj ⇒ x ∊ cl_eeqv_proj $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_proj ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩ ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by g2_e_eeqv_proj [l6, l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv u v) ∅ , ra_eeqv ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_proj , scons y (scons z (scons v ∅)) ⟩ ⟩) ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_proj ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $ by wcel_elim [#1, l15]

lemma g2_e_eeqv_quot (G: hyps) {u_v u2: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons V1 ∅ ⟩ ⟨ kc_quot , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq V1 V2 $ >
  $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) $
----
l1: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons V1 ∅ ⟩ ⟨ kc_quot , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_quot , scons V1 ∅ ⟩ ⟨ kc_quot , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_quot , scons V1 ∅ ⟩ ⟨ kc_quot , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_quot , scons V1 ∅ ⟩ ⟨ kc_quot , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_quot , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_quot , scons V1 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_quot , scons V1 ∅ ⟩ (scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_quot , scons V1 ∅ ⟩ (scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_quot , scons V1 ∅ ⟩ (scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_quot , scons V1 ∅ ⟩ (scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_quot , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_quot , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_quot , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_quot , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t2 = ⟨ kc_quot , scons V2 ∅ ⟩ ∧ lveq V1 V2 $ by and_intro [l28, #3]
l30: $ G ⇒ t1 = ⟨ kc_quot , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons V2 ∅ ⟩ ∧ lveq V1 V2 $ by and_intro [l25, l29]
l31: $ G ⇒ ∃ u2 (t1 = ⟨ kc_quot , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq V1 u2) $ by ex_intro [l30]
l32: $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_intro [l31]

lemma g2_d_eeqv_quot (G: hyps) {u_v u2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot ⇒ x ∊ cl_eeqv_quot $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ lveq y z $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l6]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by g2_e_eeqv_quot [l8, l9, l7]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by wcel_elim [#1, l13]

lemma g2_e_eeqv_quot_mk (G: hyps) {u_v u2: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons V1 ∅ ⟩ ⟨ kc_quot_mk , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq V1 V2 $ >
  $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) $
----
l1: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons V1 ∅ ⟩ ⟨ kc_quot_mk , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_quot_mk , scons V1 ∅ ⟩ ⟨ kc_quot_mk , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_quot_mk , scons V1 ∅ ⟩ ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_quot_mk , scons V1 ∅ ⟩ ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_quot_mk , scons V1 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_quot_mk , scons V1 ∅ ⟩ (scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_quot_mk , scons V1 ∅ ⟩ (scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_quot_mk , scons V1 ∅ ⟩ (scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_quot_mk , scons V1 ∅ ⟩ (scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_quot_mk , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_quot_mk , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t2 = ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∧ lveq V1 V2 $ by and_intro [l28, #3]
l30: $ G ⇒ t1 = ⟨ kc_quot_mk , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∧ lveq V1 V2 $ by and_intro [l25, l29]
l31: $ G ⇒ ∃ u2 (t1 = ⟨ kc_quot_mk , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq V1 u2) $ by ex_intro [l30]
l32: $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_intro [l31]

lemma g2_d_eeqv_quot_mk (G: hyps) {u_v u2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_mk $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot_mk ⇒ x ∊ cl_eeqv_quot_mk $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot_mk ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ lveq y z $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l6]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by g2_e_eeqv_quot_mk [l8, l9, l7]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot_mk ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by wcel_elim [#1, l13]

lemma g2_e_eeqv_quot_lift (G: hyps) {u_v v_v u2 v2: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq V1 V3 $ > $ G ⇒ lveq V2 V4 $ >
  $ G ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $
----
l1: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ lveq V1 V3 ∧ lveq V2 V4 $ by and_intro [#3, #4]
l30: $ G ⇒ t2 = ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∧ lveq V1 V3 ∧ lveq V2 V4 $ by and_intro [l28, l29]
l31: $ G ⇒ t1 = ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons V3 (scons V4 ∅) ⟩ ∧ lveq V1 V3 ∧ lveq V2 V4 $ by and_intro [l25, l30]
l32: $ G ⇒ ∃ v2 (t1 = ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons V3 (scons v2 ∅) ⟩ ∧ lveq V1 V3 ∧ lveq V2 v2) $ by ex_intro [l31]
l33: $ G ⇒ ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq V1 u2 ∧ lveq V2 v2) $ by ex_intro [l32]
l34: $ G ⇒ ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons V1 (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq V1 u2 ∧ lveq v_v v2) $ by ex_intro [l33]
l35: $ G ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $ by ex_intro [l34]

