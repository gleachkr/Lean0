--| A derivable atom of the stratum is an atom.
lemma g1_lrel2_lat (G: hyps) (X: class): $ G ⇒ X ∈ lrel2 $ > $ G ⇒ X ∈ latoms $
----
l1: $ G ⇒ hprog lprog2 latoms $ by lprog2_hprog
l2: $ G ⇒ horn lprog2 ⊆ latoms $ by horn_sub [l1]
l3: $ G ⇒ X ∈ latoms $ by wcel_subset [l2, #1]

