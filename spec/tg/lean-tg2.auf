l8: $ G , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l7, l6]
l9: $ G , x ∊ cl_eeqv_quot_ind ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l2, l8]
l10: $ G ⇒ cl_eeqv_quot_ind ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by subset_intro [l9]

lemma g2_p_eeqv (G: hyps): $ G ⇒ pr_eeqv ⊆ g2_lab kr_eeqv (suc kr_eeqv) $
----
l1: $ G ⇒ cl_eeqv_quot_ind ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_quot_ind
l2: $ G ⇒ cl_eeqv_quot_lift ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_quot_lift
l3: $ G ⇒ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_eeqv_quot_mk ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_quot_mk
l5: $ G ⇒ cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l4, l3]
l6: $ G ⇒ cl_eeqv_quot ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_quot
l7: $ G ⇒ cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l6, l5]
l8: $ G ⇒ cl_eeqv_proj ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_proj
l9: $ G ⇒ cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l8, l7]
l10: $ G ⇒ cl_eeqv_ind_rec ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_ind_rec
l11: $ G ⇒ cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l10, l9]
l12: $ G ⇒ cl_eeqv_ind_ctor ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_ind_ctor
l13: $ G ⇒ cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l12, l11]
l14: $ G ⇒ cl_eeqv_ind_ty ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_ind_ty
l15: $ G ⇒ cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l14, l13]
l16: $ G ⇒ cl_eeqv_cst ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_cst
l17: $ G ⇒ cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind))))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l16, l15]
l18: $ G ⇒ cl_eeqv_lit ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_lit
l19: $ G ⇒ cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)))))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l18, l17]
l20: $ G ⇒ cl_eeqv_pi ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_pi
l21: $ G ⇒ cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind))))))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l20, l19]
l22: $ G ⇒ cl_eeqv_lam ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_lam
l23: $ G ⇒ cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)))))))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l22, l21]
l24: $ G ⇒ cl_eeqv_app ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_app
l25: $ G ⇒ cl_eeqv_app ∪ (cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind))))))))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l24, l23]
l26: $ G ⇒ cl_eeqv_srt ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_srt
l27: $ G ⇒ cl_eeqv_srt ∪ (cl_eeqv_app ∪ (cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)))))))))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l26, l25]
l28: $ G ⇒ cl_eeqv_bvar ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_bvar
l29: $ G ⇒ cl_eeqv_bvar ∪ (cl_eeqv_srt ∪ (cl_eeqv_app ∪ (cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind))))))))))))) ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l28, l27]
l30: $ G ⇒ cl_eeqv_refl ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_k_eeqv_refl
l31: $ G ⇒ pr_eeqv ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by cun_least [l30, l29]

lemma g2_k_ind_eqv_i (G: hyps): $ G ⇒ cl_ind_eqv_i ⊆ g2_lab kr_ind_eqv (suc kr_ind_eqv) $
----
l1: $ G , x ∊ cl_ind_eqv_i ⇒ x ∊ cl_ind_eqv_i $ by ax
l2: $ G , x ∊ cl_ind_eqv_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ kr_ind_eqv ∈ ω $ by kr_ind_eqv_omega
l6: $ G , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by g2_lab_self [l4, l5]
l7: $ G , ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l8: $ G , ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l7, l6]
l9: $ G , ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l10: $ G , ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l9, l8]
l11: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l12: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l11, l10]
l13: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l14: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l13, l12]
l15: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l16: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l15, l14]
l17: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l18: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l17, l16]
l19: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l20: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l19, l18]
l21: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l22: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l21, l20]
l23: $ G , x ∊ cl_ind_eqv_i ⇒ x ∊ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by ex_elim [l2, l22]
l24: $ G ⇒ cl_ind_eqv_i ⊆ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by subset_intro [l23]

lemma g2_p_ind_eqv (G: hyps): $ G ⇒ pr_ind_eqv ⊆ g2_lab kr_ind_eqv (suc kr_ind_eqv) $
----
l1: $ G ⇒ pr_ind_eqv ⊆ g2_lab kr_ind_eqv (suc kr_ind_eqv) $ by g2_k_ind_eqv_i

lemma g2_k_ceqv_nil (G: hyps): $ G ⇒ cl_ceqv_nil ⊆ g2_lab kr_ceqv (suc kr_ceqv) $
----
l1: $ G , x ∊ cl_ceqv_nil ⇒ x ∊ cl_ceqv_nil $ by ax
l2: $ G , x ∊ cl_ceqv_nil ⇒ (x = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x ∊ cl_ceqv_nil ⇒ kr_ceqv ∈ ω $ by kr_ceqv_omega
l4: $ G , x ∊ cl_ceqv_nil ⇒ x ∊ g2_lab kr_ceqv (suc kr_ceqv) $ by g2_lab_self [l2, l3]
l5: $ G ⇒ cl_ceqv_nil ⊆ g2_lab kr_ceqv (suc kr_ceqv) $ by subset_intro [l4]

lemma g2_k_ceqv_cons (G: hyps): $ G ⇒ cl_ceqv_cons ⊆ g2_lab kr_ceqv (suc kr_ceqv) $
----
l1: $ G , x ∊ cl_ceqv_cons ⇒ x ∊ cl_ceqv_cons $ by ax
l2: $ G , x ∊ cl_ceqv_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ kr_ceqv ∈ ω $ by kr_ceqv_omega
l5: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ x ∊ g2_lab kr_ceqv (suc kr_ceqv) $ by g2_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ x ∊ g2_lab kr_ceqv (suc kr_ceqv) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ x ∊ g2_lab kr_ceqv (suc kr_ceqv) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ x ∊ g2_lab kr_ceqv (suc kr_ceqv) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_ceqv_cons ⇒ x ∊ g2_lab kr_ceqv (suc kr_ceqv) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_ceqv_cons ⊆ g2_lab kr_ceqv (suc kr_ceqv) $ by subset_intro [l12]

lemma g2_p_ceqv (G: hyps): $ G ⇒ pr_ceqv ⊆ g2_lab kr_ceqv (suc kr_ceqv) $
----
l1: $ G ⇒ cl_ceqv_cons ⊆ g2_lab kr_ceqv (suc kr_ceqv) $ by g2_k_ceqv_cons
l2: $ G ⇒ cl_ceqv_nil ⊆ g2_lab kr_ceqv (suc kr_ceqv) $ by g2_k_ceqv_nil
l3: $ G ⇒ pr_ceqv ⊆ g2_lab kr_ceqv (suc kr_ceqv) $ by cun_least [l2, l1]

lemma g2_k_teqv_nil (G: hyps): $ G ⇒ cl_teqv_nil ⊆ g2_lab kr_teqv (suc kr_teqv) $
----
l1: $ G , x ∊ cl_teqv_nil ⇒ x ∊ cl_teqv_nil $ by ax
l2: $ G , x ∊ cl_teqv_nil ⇒ (x = ⟨ ∅ , ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x ∊ cl_teqv_nil ⇒ kr_teqv ∈ ω $ by kr_teqv_omega
l4: $ G , x ∊ cl_teqv_nil ⇒ x ∊ g2_lab kr_teqv (suc kr_teqv) $ by g2_lab_self [l2, l3]
l5: $ G ⇒ cl_teqv_nil ⊆ g2_lab kr_teqv (suc kr_teqv) $ by subset_intro [l4]

lemma g2_k_teqv_cons (G: hyps): $ G ⇒ cl_teqv_cons ⊆ g2_lab kr_teqv (suc kr_teqv) $
----
l1: $ G , x ∊ cl_teqv_cons ⇒ x ∊ cl_teqv_cons $ by ax
l2: $ G , x ∊ cl_teqv_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ kr_teqv ∈ ω $ by kr_teqv_omega
l5: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ x ∊ g2_lab kr_teqv (suc kr_teqv) $ by g2_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ g2_lab kr_teqv (suc kr_teqv) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ g2_lab kr_teqv (suc kr_teqv) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ g2_lab kr_teqv (suc kr_teqv) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ g2_lab kr_teqv (suc kr_teqv) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ g2_lab kr_teqv (suc kr_teqv) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_teqv_cons ⇒ x ∊ g2_lab kr_teqv (suc kr_teqv) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_teqv_cons ⊆ g2_lab kr_teqv (suc kr_teqv) $ by subset_intro [l16]

lemma g2_p_teqv (G: hyps): $ G ⇒ pr_teqv ⊆ g2_lab kr_teqv (suc kr_teqv) $
----
l1: $ G ⇒ cl_teqv_cons ⊆ g2_lab kr_teqv (suc kr_teqv) $ by g2_k_teqv_cons
l2: $ G ⇒ cl_teqv_nil ⊆ g2_lab kr_teqv (suc kr_teqv) $ by g2_k_teqv_nil
l3: $ G ⇒ pr_teqv ⊆ g2_lab kr_teqv (suc kr_teqv) $ by cun_least [l2, l1]

lemma g2_k_cseqv_nil (G: hyps): $ G ⇒ cl_cseqv_nil ⊆ g2_lab kr_cseqv (suc kr_cseqv) $
----
l1: $ G , x ∊ cl_cseqv_nil ⇒ x ∊ cl_cseqv_nil $ by ax
l2: $ G , x ∊ cl_cseqv_nil ⇒ (x = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x ∊ cl_cseqv_nil ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l4: $ G , x ∊ cl_cseqv_nil ⇒ x ∊ g2_lab kr_cseqv (suc kr_cseqv) $ by g2_lab_self [l2, l3]
l5: $ G ⇒ cl_cseqv_nil ⊆ g2_lab kr_cseqv (suc kr_cseqv) $ by subset_intro [l4]

lemma g2_k_cseqv_cons (G: hyps): $ G ⇒ cl_cseqv_cons ⊆ g2_lab kr_cseqv (suc kr_cseqv) $
----
l1: $ G , x ∊ cl_cseqv_cons ⇒ x ∊ cl_cseqv_cons $ by ax
l2: $ G , x ∊ cl_cseqv_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l5: $ G , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ x ∊ g2_lab kr_cseqv (suc kr_cseqv) $ by g2_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ x ∊ g2_lab kr_cseqv (suc kr_cseqv) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ x ∊ g2_lab kr_cseqv (suc kr_cseqv) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ x ∊ g2_lab kr_cseqv (suc kr_cseqv) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_cseqv_cons ⇒ x ∊ g2_lab kr_cseqv (suc kr_cseqv) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_cseqv_cons ⊆ g2_lab kr_cseqv (suc kr_cseqv) $ by subset_intro [l12]

lemma g2_p_cseqv (G: hyps): $ G ⇒ pr_cseqv ⊆ g2_lab kr_cseqv (suc kr_cseqv) $
----
l1: $ G ⇒ cl_cseqv_cons ⊆ g2_lab kr_cseqv (suc kr_cseqv) $ by g2_k_cseqv_cons
l2: $ G ⇒ cl_cseqv_nil ⊆ g2_lab kr_cseqv (suc kr_cseqv) $ by g2_k_cseqv_nil
l3: $ G ⇒ pr_cseqv ⊆ g2_lab kr_cseqv (suc kr_cseqv) $ by cun_least [l2, l1]

lemma g2_k_lseqv_nil (G: hyps): $ G ⇒ cl_lseqv_nil ⊆ g2_lab kr_lseqv (suc kr_lseqv) $
----
l1: $ G , x ∊ cl_lseqv_nil ⇒ x ∊ cl_lseqv_nil $ by ax
l2: $ G , x ∊ cl_lseqv_nil ⇒ (x = ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x ∊ cl_lseqv_nil ⇒ kr_lseqv ∈ ω $ by kr_lseqv_omega
l4: $ G , x ∊ cl_lseqv_nil ⇒ x ∊ g2_lab kr_lseqv (suc kr_lseqv) $ by g2_lab_self [l2, l3]
l5: $ G ⇒ cl_lseqv_nil ⊆ g2_lab kr_lseqv (suc kr_lseqv) $ by subset_intro [l4]

lemma g2_k_lseqv_cons (G: hyps): $ G ⇒ cl_lseqv_cons ⊆ g2_lab kr_lseqv (suc kr_lseqv) $
----
l1: $ G , x ∊ cl_lseqv_cons ⇒ x ∊ cl_lseqv_cons $ by ax
l2: $ G , x ∊ cl_lseqv_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z $ by ax
l4: $ G , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ kr_lseqv ∈ ω $ by kr_lseqv_omega
l6: $ G , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ x ∊ g2_lab kr_lseqv (suc kr_lseqv) $ by g2_lab_self [l4, l5]
l7: $ G , ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) $ by ax
l8: $ G , ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ x ∊ g2_lab kr_lseqv (suc kr_lseqv) $ by ex_elim [l7, l6]
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) $ by ax
l10: $ G , ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ x ∊ g2_lab kr_lseqv (suc kr_lseqv) $ by ex_elim [l9, l8]
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) $ by ax
l12: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ x ∊ g2_lab kr_lseqv (suc kr_lseqv) $ by ex_elim [l11, l10]
l13: $ G , x ∊ cl_lseqv_cons ⇒ x ∊ g2_lab kr_lseqv (suc kr_lseqv) $ by ex_elim [l2, l12]
l14: $ G ⇒ cl_lseqv_cons ⊆ g2_lab kr_lseqv (suc kr_lseqv) $ by subset_intro [l13]

lemma g2_p_lseqv (G: hyps): $ G ⇒ pr_lseqv ⊆ g2_lab kr_lseqv (suc kr_lseqv) $
----
l1: $ G ⇒ cl_lseqv_cons ⊆ g2_lab kr_lseqv (suc kr_lseqv) $ by g2_k_lseqv_cons
l2: $ G ⇒ cl_lseqv_nil ⊆ g2_lab kr_lseqv (suc kr_lseqv) $ by g2_k_lseqv_nil
l3: $ G ⇒ pr_lseqv ⊆ g2_lab kr_lseqv (suc kr_lseqv) $ by cun_least [l2, l1]

lemma g2_k_nst_group_done (G: hyps): $ G ⇒ cl_nst_group_done ⊆ g2_lab kr_nst_group (suc kr_nst_group) $
----
l1: $ G , x ∊ cl_nst_group_done ⇒ x ∊ cl_nst_group_done $ by ax
l2: $ G , x ∊ cl_nst_group_done ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ kr_nst_group ∈ ω $ by kr_nst_group_omega
l5: $ G , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ x ∊ g2_lab kr_nst_group (suc kr_nst_group) $ by g2_lab_self [l3, l4]
l6: $ G , ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l7: $ G , ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ x ∊ g2_lab kr_nst_group (suc kr_nst_group) $ by ex_elim [l6, l5]
l8: $ G , ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l9: $ G , ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ x ∊ g2_lab kr_nst_group (suc kr_nst_group) $ by ex_elim [l8, l7]
l10: $ G , ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l11: $ G , ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ x ∊ g2_lab kr_nst_group (suc kr_nst_group) $ by ex_elim [l10, l9]
l12: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l13: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ x ∊ g2_lab kr_nst_group (suc kr_nst_group) $ by ex_elim [l12, l11]
l14: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l15: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ x ∊ g2_lab kr_nst_group (suc kr_nst_group) $ by ex_elim [l14, l13]
l16: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l17: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ x ∊ g2_lab kr_nst_group (suc kr_nst_group) $ by ex_elim [l16, l15]
l18: $ G , x ∊ cl_nst_group_done ⇒ x ∊ g2_lab kr_nst_group (suc kr_nst_group) $ by ex_elim [l2, l17]
l19: $ G ⇒ cl_nst_group_done ⊆ g2_lab kr_nst_group (suc kr_nst_group) $ by subset_intro [l18]

lemma g2_k_nst_group_cons (G: hyps): $ G ⇒ cl_nst_group_cons ⊆ g2_lab kr_nst_group (suc kr_nst_group) $
----
l1: $ G , x ∊ cl_nst_group_cons ⇒ x ∊ cl_nst_group_cons $ by ax
l2: $ G , x ∊ cl_nst_group_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_nst_group y z u v ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_s , scons b ∅ ⟩ c g i) ∅ , ra_nst_group y z u v a b c ⟨ kc_cons , scons w (scons g ∅) ⟩ i ⟩ ∧ ra_le ⟨ kc_s , scons b ∅ ⟩ c ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ v f ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ ⟨ kc_ind_ty , scons u (scons b ∅) ⟩ f v w ∈ lrel ∧ ra_aux_data z u w a b ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_nst_group y z u v ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_s , scons b ∅ ⟩ c g i) ∅ , ra_nst_group y z u v a b c ⟨ kc_cons , scons w (scons g ∅) ⟩ i ⟩ ∧ ra_le ⟨ kc_s , scons b ∅ ⟩ c ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ v f ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ ⟨ kc_ind_ty , scons u (scons b ∅) ⟩ f v w ∈ lrel ∧ ra_aux_data z u w a b ∈ lrel ⇒ x = ⟨ scons (ra_nst_group y z u v ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_s , scons b ∅ ⟩ c g i) ∅ , ra_nst_group y z u v a b c ⟨ kc_cons , scons w (scons g ∅) ⟩ i ⟩ ∧ ra_le ⟨ kc_s , scons b ∅ ⟩ c ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ v f ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ ⟨ kc_ind_ty , scons u (scons b ∅) ⟩ f v w ∈ lrel ∧ ra_aux_data z u w a b ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_nst_group y z u v ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_s , scons b ∅ ⟩ c g i) ∅ , ra_nst_group y z u v a b c ⟨ kc_cons , scons w (scons g ∅) ⟩ i ⟩ ∧ ra_le ⟨ kc_s , scons b ∅ ⟩ c ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ v f ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ ⟨ kc_ind_ty , scons u (scons b ∅) ⟩ f v w ∈ lrel ∧ ra_aux_data z u w a b ∈ lrel ⇒ x = ⟨ scons (ra_nst_group y z u v ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_s , scons b ∅ ⟩ c g i) ∅ , ra_nst_group y z u v a b c ⟨ kc_cons , scons w (scons g ∅) ⟩ i ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_nst_group y z u v ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_s , scons b ∅ ⟩ c g i) ∅ , ra_nst_group y z u v a b c ⟨ kc_cons , scons w (scons g ∅) ⟩ i ⟩ ∧ ra_le ⟨ kc_s , scons b ∅ ⟩ c ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ v f ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ ⟨ kc_ind_ty , scons u (scons b ∅) ⟩ f v w ∈ lrel ∧ ra_aux_data z u w a b ∈ lrel ⇒ kr_nst_group ∈ ω $ by kr_nst_group_omega
