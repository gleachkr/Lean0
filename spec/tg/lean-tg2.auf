l3: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z $ by ax
l4: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l6: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_lab_self [l4, l5]
l7: $ G , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by ax
l8: $ G , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot , scons y ∅ ⟩ ⟨ kc_quot , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l7, l6]
l9: $ G , x ∊ cl_eeqv_quot ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l2, l8]
l10: $ G ⇒ cl_eeqv_quot ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by subset_intro [l9]

lemma g2_k_eeqv_quot_mk (G: hyps): $ G ⇒ cl_eeqv_quot_mk ⊆ g2_lab kr_eeqv (suc kr_eeqv) $
----
l1: $ G , x ∊ cl_eeqv_quot_mk ⇒ x ∊ cl_eeqv_quot_mk $ by ax
l2: $ G , x ∊ cl_eeqv_quot_mk ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z $ by ax
l4: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l6: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_lab_self [l4, l5]
l7: $ G , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by ax
l8: $ G , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_mk , scons y ∅ ⟩ ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l7, l6]
l9: $ G , x ∊ cl_eeqv_quot_mk ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l2, l8]
l10: $ G ⇒ cl_eeqv_quot_mk ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by subset_intro [l9]

lemma g2_k_eeqv_quot_lift (G: hyps): $ G ⇒ cl_eeqv_quot_lift ⊆ g2_lab kr_eeqv (suc kr_eeqv) $
----
l1: $ G , x ∊ cl_eeqv_quot_lift ⇒ x ∊ cl_eeqv_quot_lift $ by ax
l2: $ G , x ∊ cl_eeqv_quot_lift ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v $ by ax
l4: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l6: $ G , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_lab_self [l4, l5]
l7: $ G , ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) $ by ax
l8: $ G , ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l7, l6]
l9: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) $ by ax
l10: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l9, l8]
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) $ by ax
l12: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l11, l10]
l13: $ G , x ∊ cl_eeqv_quot_lift ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l2, l12]
l14: $ G ⇒ cl_eeqv_quot_lift ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by subset_intro [l13]

