l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ex_intro [l5]
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ex_intro [l6]
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ex_intro [l7]
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ex_intro [l8]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ x ∊ cl_cseqv_cons $ by cab_intro [l9]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ∈ cl_cseqv_cons $ by wcel_intro [l5, l10]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ isset ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ $ by opair_isset
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ∈ cl_cseqv_cons $ by isset_elim [l12, l11]
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ra_eeqv y z = ra_eeqv A1 A2 $ by ra_eeqv_eq [l1, l2]
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ra_cseqv u v = ra_cseqv A3 A4 $ by ra_cseqv_eq [l3, l4]
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ∅ = ∅ $ by eq_refl
l17: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ scons (ra_cseqv u v) ∅ = scons (ra_cseqv A3 A4) ∅ $ by scons_eq [l15, l16]
l18: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) = scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) ∅) $ by scons_eq [l14, l17]
l19: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ kc_ccons = kc_ccons $ by eq_refl
l20: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ scons u ∅ = scons A3 ∅ $ by scons_eq [l3, l16]
l21: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ scons y (scons u ∅) = scons A1 (scons A3 ∅) $ by scons_eq [l1, l20]
l22: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ kc_ccons , scons y (scons u ∅) ⟩ = ⟨ kc_ccons , scons A1 (scons A3 ∅) ⟩ $ by opair_eq [l19, l21]
l23: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ scons v ∅ = scons A4 ∅ $ by scons_eq [l4, l16]
l24: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ scons z (scons v ∅) = scons A2 (scons A4 ∅) $ by scons_eq [l2, l23]
l25: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ kc_ccons , scons z (scons v ∅) ⟩ = ⟨ kc_ccons , scons A2 (scons A4 ∅) ⟩ $ by opair_eq [l19, l24]
l26: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ = ra_cseqv ⟨ kc_ccons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_ccons , scons A2 (scons A4 ∅) ⟩ $ by ra_cseqv_eq [l22, l25]
l27: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ = ⟨ scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) ∅) , ra_cseqv ⟨ kc_ccons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_ccons , scons A2 (scons A4 ∅) ⟩ ⟩ $ by opair_eq [l18, l26]
l28: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) ∅) , ra_cseqv ⟨ kc_ccons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_ccons , scons A2 (scons A4 ∅) ⟩ ⟩ ∈ cl_cseqv_cons $ by wcel_eq_l [l27, l13]
l29: $ G ⇒ isset A4 $ by wcel_isset [#4]
l30: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) ∅) , ra_cseqv ⟨ kc_ccons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_ccons , scons A2 (scons A4 ∅) ⟩ ⟩ ∈ cl_cseqv_cons $ by isset_elim [l29, l28]
l31: $ G ⇒ isset A3 $ by wcel_isset [#3]
