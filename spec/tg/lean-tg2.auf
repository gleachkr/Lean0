l6: $ G ⇒ ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons $ by g1_in_l [l5]
l7: $ G ⇒ ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩ ∈ g1_top $ by g1_pr_lseqv [l6]
l8: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l9: $ G ⇒ crn ∅ ⊆ lrel2 $ by crn_empty_sub
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ kc_lnil ∈ ω $ by kc_lnil_omega
l12: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
