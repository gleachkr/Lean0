lemma g2_p_nst_group (G: hyps): $ G ⇒ pr_nst_group ⊆ g2_lab kr_nst_group (suc kr_nst_group) $
----
l1: $ G ⇒ cl_nst_group_cons ⊆ g2_lab kr_nst_group (suc kr_nst_group) $ by g2_k_nst_group_cons
l2: $ G ⇒ cl_nst_group_done ⊆ g2_lab kr_nst_group (suc kr_nst_group) $ by g2_k_nst_group_done
l3: $ G ⇒ pr_nst_group ⊆ g2_lab kr_nst_group (suc kr_nst_group) $ by cun_least [l2, l1]

