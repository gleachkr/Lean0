l73: $ G ⇒ ra_teqv ⟨ kc_tcons , scons A1 (scons A3 (scons A5 ∅)) ⟩ ⟨ kc_tcons , scons A2 (scons A4 (scons A6 ∅)) ⟩ ∈ latoms $ by g1_ra_teqv [l68, l72]
l74: $ G ⇒ ra_teqv ⟨ kc_tcons , scons A1 (scons A3 (scons A5 ∅)) ⟩ ⟨ kc_tcons , scons A2 (scons A4 (scons A6 ∅)) ⟩ ∈ lrel2 $ by g1_horn [l50, l60, l73, l61]

lemma g1_pr_cseqv (G: hyps) (X: class): $ G ⇒ X ∈ pr_cseqv $ > $ G ⇒ X ∈ g1_top $
----
l1: $ G ⇒ X ∈ pr_teqv ∪ pr_cseqv $ by g1_in_r [#1]
l2: $ G ⇒ X ∈ (pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group) $ by g1_in_l [l1]
l3: $ G ⇒ X ∈ ((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group)) $ by g1_in_r [l2]

lemma g1_ra_cseqv (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_cseqv A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l5: $ G ⇒ ra_cseqv A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lrel2_cseqv_nil
---------------
l1: $ G , x = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ $ by ax
l2: $ G , x = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x ∊ cl_cseqv_nil $ by cab_intro [l1]
l3: $ G , x = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ∈ cl_cseqv_nil $ by wcel_intro [l1, l2]
l4: $ G ⇒ isset ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ $ by opair_isset
l5: $ G ⇒ ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ∈ cl_cseqv_nil $ by isset_elim [l4, l3]
l6: $ G ⇒ ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons $ by g1_in_l [l5]
l7: $ G ⇒ ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ∈ g1_top $ by g1_pr_cseqv [l6]
l8: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l9: $ G ⇒ crn ∅ ⊆ lrel2 $ by crn_empty_sub
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ kc_cnil ∈ ω $ by kc_cnil_omega
l12: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l13: $ G ⇒ ⟨ kc_cnil , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l10, l11, l12]
l14: $ G ⇒ ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ∈ latoms $ by g1_ra_cseqv [l13, l13]
l15: $ G ⇒ ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ∈ lrel2 $ by g1_horn [l7, l8, l14, l9]

lrel2_cseqv_cons
----------------
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ v = A4 $ by ax
