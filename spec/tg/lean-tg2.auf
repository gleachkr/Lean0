l55: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))) = scons V3 (scons V4 (scons V6 (scons V7 (scons V8 (scons ⟨ kc_cons , scons V5 (scons V10 ∅) ⟩ (scons V11 ∅)))))) $ by g2_scons_inj [l54, l24, l42, l23, l41]
