l4: $ G , y = A1 , x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x ∊ cl_eeqv_bvar $ by cab_intro [l3]
l5: $ G , y = A1 , x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ∈ cl_eeqv_bvar $ by wcel_intro [l2, l4]
l6: $ G , y = A1 ⇒ isset ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ $ by opair_isset
l7: $ G , y = A1 ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ∈ cl_eeqv_bvar $ by isset_elim [l6, l5]
l8: $ G , y = A1 ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , y = A1 ⇒ kc_bvar = kc_bvar $ by eq_refl
l10: $ G , y = A1 ⇒ scons y ∅ = scons A1 ∅ $ by scons_eq [l1, l8]
l11: $ G , y = A1 ⇒ ⟨ kc_bvar , scons y ∅ ⟩ = ⟨ kc_bvar , scons A1 ∅ ⟩ $ by opair_eq [l9, l10]
l12: $ G , y = A1 ⇒ ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ = ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ $ by ra_eeqv_eq [l11, l11]
l13: $ G , y = A1 ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ ⟩ $ by opair_eq [l8, l12]
l14: $ G , y = A1 ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ ⟩ ∈ cl_eeqv_bvar $ by wcel_eq_l [l13, l7]
l15: $ G ⇒ isset A1 $ by wcel_isset [#1]
l16: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ ⟩ ∈ cl_eeqv_bvar $ by isset_elim [l15, l14]
l17: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ ⟩ ∈ cl_eeqv_bvar ∪ (cl_eeqv_srt ∪ (cl_eeqv_app ∪ (cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind))))))))))))) $ by g1_in_l [l16]
l18: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ ⟩ ∈ cl_eeqv_refl ∪ (cl_eeqv_bvar ∪ (cl_eeqv_srt ∪ (cl_eeqv_app ∪ (cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)))))))))))))) $ by g1_in_r [l17]
l19: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ ⟩ ∈ g1_top $ by g1_pr_eeqv [l18]
l20: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l21: $ G ⇒ crn ∅ ⊆ lrel2 $ by crn_empty_sub
l22: $ G ⇒ isset ω $ by omega_set
l23: $ G ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l24: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l25: $ G ⇒ scons A1 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#1, l24]
l26: $ G ⇒ ⟨ kc_bvar , scons A1 ∅ ⟩ ∈ trees ω $ by trees_intro_c [l22, l23, l25]
l27: $ G ⇒ ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ ∈ latoms $ by g1_ra_eeqv [l26, l26]
l28: $ G ⇒ ra_eeqv ⟨ kc_bvar , scons A1 ∅ ⟩ ⟨ kc_bvar , scons A1 ∅ ⟩ ∈ lrel2 $ by g1_horn [l19, l20, l27, l21]

