l184: $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_refl ∪ (cl_eeqv_bvar ∪ (cl_eeqv_srt ∪ (cl_eeqv_app ∪ (cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)))))))))))))) → ∃ e_v (t1 = e_v ∧ t2 = e_v) ∨ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) ∨ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) ∨ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) ∨ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by imp_intro [l183]
l185: $ G ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) ∨ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) ∨ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) ∨ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) ∨ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by imp_elim [l184, #1]

lrel2_eeqv_cases
----------------
l1: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l2: $ G , c = ra_eeqv t1 t2 ⇒ c = ra_eeqv t1 t2 $ by ax
l3: $ G , c = ra_eeqv t1 t2 ⇒ ra_eeqv t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_eeqv t1 t2 ⇒ ra_eeqv t1 t2 ∈ lrel2 $ by weaken [#1]
l5: $ G , c = ra_eeqv t1 t2 ⇒ c ∈ lrel2 $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_eeqv t1 t2 ⇒ c ∊ lrel2 $ by wcel_welc [l5]
l7: $ G , c = ra_eeqv t1 t2 ⇒ hprog lprog2 latoms $ by lprog2_hprog
l8: $ G , c = ra_eeqv t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2) $ by horn_elim [l7, l6]
l9: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 $ by ax
l10: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 $ by and_elim_l [l9]
l11: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ crn p ⊆ lrel2 $ by and_elim_r [l9]
l12: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ p = p $ by eq_refl
l13: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ c = ra_eeqv t1 t2 $ by ax
l14: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ = ⟨ p , ra_eeqv t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_eeqv t1 t2 ⟩ ∈ lprog2 $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_eeqv t1 t2 ⟩ ∈ pr_eeqv $ by lprog2_eeqv_pr [l15]
l17: $ G , c = ra_eeqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) ∨ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) ∨ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) ∨ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) ∨ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by g2_o_eeqv [l16, l11]
l18: $ G , c = ra_eeqv t1 t2 ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) ∨ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) ∨ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) ∨ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) ∨ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) ∨ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) ∨ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) ∨ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) ∨ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by isset_elim [l1, l18]

lemma g2_e_ind_eqv_i (G: hyps) {D D2 b_v P P2 N N2 T T2: set} (pp t1 t2 V1 V2 V3 V4 V5 V6 V7 V8 V9: set):
  $ G ⇒ ⟨ pp , ra_ind_eqv t1 t2 ⟩ = ⟨ scons (ra_ceqv V4 V5) (scons (ra_teqv V8 V9) (scons (ra_ceqv V6 V7) ∅)) , ra_ind_eqv V1 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ ra_ind_data V1 V3 V4 V8 ∈ lrel $ > $ G ⇒ ra_ind_data V2 V3 V5 V9 ∈ lrel $ > $ G ⇒ ra_ind_nested V1 V6 ∈ lrel $ > $ G ⇒ ra_ind_nested V2 V7 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_ceqv V4 V5) (scons (ra_teqv V8 V9) (scons (ra_ceqv V6 V7) ∅)) , ra_ind_eqv V1 V2 ⟩ = ⟨ pp , ra_ind_eqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ceqv V4 V5) (scons (ra_teqv V8 V9) (scons (ra_ceqv V6 V7) ∅))) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ind_eqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_ind_eqv V1 V2) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ceqv V4 V5) (scons (ra_teqv V8 V9) (scons (ra_ceqv V6 V7) ∅)) ∧ ra_ind_eqv t1 t2 = ra_ind_eqv V1 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ceqv V4 V5) (scons (ra_teqv V8 V9) (scons (ra_ceqv V6 V7) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_ind_eqv t1 t2 = ra_ind_eqv V1 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset V2 $ by isset_var
l15: $ G ⇒ scons V2 ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_ind_eqv ∈ ω $ by kr_ind_eqv_omega
l19: $ G ⇒ isset kr_ind_eqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons V2 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_ind_eqv = kr_ind_eqv ∧ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V2 ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V2 $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_ceqv V4 V5) (scons (ra_teqv V8 V9) (scons (ra_ceqv V6 V7) ∅))) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_ceqv V4 V5) (scons (ra_teqv V8 V9) (scons (ra_ceqv V6 V7) ∅))) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_ceqv V4 V5) $ by opair_isset
l32: $ G ⇒ ra_ceqv V4 V5 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_teqv V8 V9) (scons (ra_ceqv V6 V7) ∅)) ⊆ lrel2 $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_teqv V8 V9) $ by opair_isset
l35: $ G ⇒ ra_teqv V8 V9 ∈ lrel2 $ by crn_scons_head [l34, l33]
l36: $ G ⇒ crn (scons (ra_ceqv V6 V7) ∅) ⊆ lrel2 $ by crn_scons_tail [l33]
l37: $ G ⇒ isset (ra_ceqv V6 V7) $ by opair_isset
l38: $ G ⇒ ra_ceqv V6 V7 ∈ lrel2 $ by crn_scons_head [l37, l36]
l39: $ G ⇒ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2 $ by and_intro [#6, l38]
l40: $ G ⇒ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2 $ by and_intro [#5, l39]
l41: $ G ⇒ ra_teqv V8 V9 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2 $ by and_intro [l35, l40]
l42: $ G ⇒ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv V8 V9 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2 $ by and_intro [l32, l41]
l43: $ G ⇒ ra_ind_data V2 V3 V5 V9 ∈ lrel ∧ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv V8 V9 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2 $ by and_intro [#4, l42]
l44: $ G ⇒ ra_ind_data V1 V3 V4 V8 ∈ lrel ∧ ra_ind_data V2 V3 V5 V9 ∈ lrel ∧ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv V8 V9 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2 $ by and_intro [#3, l43]
l45: $ G ⇒ t2 = V2 ∧ ra_ind_data V1 V3 V4 V8 ∈ lrel ∧ ra_ind_data V2 V3 V5 V9 ∈ lrel ∧ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv V8 V9 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2 $ by and_intro [l28, l44]
l46: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V1 V3 V4 V8 ∈ lrel ∧ ra_ind_data V2 V3 V5 V9 ∈ lrel ∧ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv V8 V9 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2 $ by and_intro [l25, l45]
l47: $ G ⇒ ∃ T2 (t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V1 V3 V4 V8 ∈ lrel ∧ ra_ind_data V2 V3 V5 T2 ∈ lrel ∧ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv V8 T2 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2) $ by ex_intro [l46]
l48: $ G ⇒ ∃ T ∃ T2 (t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V1 V3 V4 T ∈ lrel ∧ ra_ind_data V2 V3 V5 T2 ∈ lrel ∧ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 V7 ∈ lrel ∧ ra_ceqv V6 V7 ∈ lrel2) $ by ex_intro [l47]
l49: $ G ⇒ ∃ N2 ∃ T ∃ T2 (t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V1 V3 V4 T ∈ lrel ∧ ra_ind_data V2 V3 V5 T2 ∈ lrel ∧ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested V1 V6 ∈ lrel ∧ ra_ind_nested V2 N2 ∈ lrel ∧ ra_ceqv V6 N2 ∈ lrel2) $ by ex_intro [l48]
l50: $ G ⇒ ∃ N ∃ N2 ∃ T ∃ T2 (t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V1 V3 V4 T ∈ lrel ∧ ra_ind_data V2 V3 V5 T2 ∈ lrel ∧ ra_ceqv V4 V5 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested V1 N ∈ lrel ∧ ra_ind_nested V2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_intro [l49]
l51: $ G ⇒ ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V1 V3 V4 T ∈ lrel ∧ ra_ind_data V2 V3 P2 T2 ∈ lrel ∧ ra_ceqv V4 P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested V1 N ∈ lrel ∧ ra_ind_nested V2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_intro [l50]
l52: $ G ⇒ ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V1 V3 P T ∈ lrel ∧ ra_ind_data V2 V3 P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested V1 N ∈ lrel ∧ ra_ind_nested V2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_intro [l51]
l53: $ G ⇒ ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_ind_data V2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested V1 N ∈ lrel ∧ ra_ind_nested V2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_intro [l52]
l54: $ G ⇒ ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = V1 ∧ t2 = D2 ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested V1 N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_intro [l53]
l55: $ G ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_intro [l54]

lemma g2_d_ind_eqv_i (G: hyps) {D D2 b_v P P2 N N2 T T2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_eqv t1 t2 ⟩ ∈ cl_ind_eqv_i $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x ∊ cl_ind_eqv_i ⇒ x ∊ cl_ind_eqv_i $ by ax
l2: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x ∊ cl_ind_eqv_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ ⟨ pp , ra_ind_eqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel $ by ax
l6: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ ra_ind_data y u v c ∈ lrel $ by and_elim_l [l7]
l9: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel ⇒ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel $ by and_elim_r [l7]
