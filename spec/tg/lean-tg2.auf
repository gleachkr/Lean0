lemma g1_pr_ind_eqv (G: hyps) (X: class): $ G ⇒ X ∈ pr_ind_eqv $ > $ G ⇒ X ∈ g1_top $
----
l1: $ G ⇒ X ∈ pr_ind_eqv ∪ pr_ceqv $ by g1_in_l [#1]
l2: $ G ⇒ X ∈ (pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv) $ by g1_in_r [l1]
l3: $ G ⇒ X ∈ ((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group)) $ by g1_in_l [l2]

lemma g1_ra_ind_eqv (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_ind_eqv A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_ind_eqv ∈ ω $ by kr_ind_eqv_omega
l5: $ G ⇒ ra_ind_eqv A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

