lemma g1_pr_nst_group (G: hyps) (X: class): $ G ⇒ X ∈ pr_nst_group $ > $ G ⇒ X ∈ g1_top $
----
l1: $ G ⇒ X ∈ pr_lseqv ∪ pr_nst_group $ by g1_in_r [#1]
l2: $ G ⇒ X ∈ (pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group) $ by g1_in_r [l1]
l3: $ G ⇒ X ∈ ((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group)) $ by g1_in_r [l2]

lemma g1_ra_nst_group (G: hyps) (A1 A2 A3 A4 A5 A6 A7 A8 A9: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ > $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ > $ G ⇒ A9 ∈ trees ω $ >
  $ G ⇒ ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ∈ latoms $
