l32: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ scons (ra_lseqv A3 A4) ∅ , ra_lseqv ⟨ kc_lcons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_lcons , scons A2 (scons A4 ∅) ⟩ ⟩ ∈ cl_lseqv_cons $ by wcel_eq_l [l31, l19]
l33: $ G ⇒ isset A4 $ by wcel_isset [#4]
l34: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_lseqv A3 A4) ∅ , ra_lseqv ⟨ kc_lcons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_lcons , scons A2 (scons A4 ∅) ⟩ ⟩ ∈ cl_lseqv_cons $ by isset_elim [l33, l32]
l35: $ G ⇒ isset A3 $ by wcel_isset [#3]
l36: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_lseqv A3 A4) ∅ , ra_lseqv ⟨ kc_lcons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_lcons , scons A2 (scons A4 ∅) ⟩ ⟩ ∈ cl_lseqv_cons $ by isset_elim [l35, l34]
l37: $ G ⇒ isset A2 $ by wcel_isset [#2]
