l46: $ G , y = A1 ⇒ ⟨ scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) (scons (ra_teqv A5 A6) ∅)) , ra_teqv ⟨ kc_tcons , scons A1 (scons A3 (scons A5 ∅)) ⟩ ⟨ kc_tcons , scons A2 (scons A4 (scons A6 ∅)) ⟩ ⟩ ∈ cl_teqv_cons $ by isset_elim [l45, l44]
