l42: $ G ⇒ scons (ra_ceqv A3 A4) ∅ ∈ fseq latoms $ by scons_fseq_c [l41, l39]
l43: $ G ⇒ crn (scons (ra_ceqv A3 A4) ∅) ⊆ lrel2 $ by crn_scons_sub [#6, l40]
