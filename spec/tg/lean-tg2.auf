l51: $ G ⇒ scons A1 (scons A3 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l50]
l52: $ G ⇒ ⟨ kc_ccons , scons A1 (scons A3 ∅) ⟩ ∈ trees ω $ by trees_intro_c [l47, l48, l51]
l53: $ G ⇒ scons A4 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#4, l49]
l54: $ G ⇒ scons A2 (scons A4 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l53]
l55: $ G ⇒ ⟨ kc_ccons , scons A2 (scons A4 ∅) ⟩ ∈ trees ω $ by trees_intro_c [l47, l48, l54]
l56: $ G ⇒ ra_cseqv ⟨ kc_ccons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_ccons , scons A2 (scons A4 ∅) ⟩ ∈ latoms $ by g1_ra_cseqv [l52, l55]
l57: $ G ⇒ ra_cseqv ⟨ kc_ccons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_ccons , scons A2 (scons A4 ∅) ⟩ ∈ lrel2 $ by g1_horn [l38, l45, l56, l46]

lemma g1_pr_lseqv (G: hyps) (X: class): $ G ⇒ X ∈ pr_lseqv $ > $ G ⇒ X ∈ g1_top $
----
l1: $ G ⇒ X ∈ pr_lseqv ∪ pr_nst_group $ by g1_in_l [#1]
l2: $ G ⇒ X ∈ (pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group) $ by g1_in_r [l1]
l3: $ G ⇒ X ∈ ((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group)) $ by g1_in_r [l2]

lemma g1_ra_lseqv (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_lseqv A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_lseqv ∈ ω $ by kr_lseqv_omega
l5: $ G ⇒ ra_lseqv A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lrel2_lseqv_nil
---------------
l1: $ G , x = ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩ $ by ax
