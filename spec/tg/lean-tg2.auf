kr_nst_group_omega
------------------
l1: $ G ⇒ kr_lseqv ∈ ω $ by kr_lseqv_omega
l2: $ G ⇒ kr_nst_group ∈ ω $ by omega_suc_c [l1]

ra_ulevel_congr
---------------
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A2 ∅ ≐ scons B2 ∅ $ by scons_congr [#2, l1]
l3: $ scons A1 (scons A2 ∅) ≐ scons B1 (scons B2 ∅) $ by scons_congr [#1, l2]
l4: $ kr_ulevel ≐ kr_ulevel $ by ceqt_refl
l5: $ ⟨ kr_ulevel , scons A1 (scons A2 ∅) ⟩ ≐ ⟨ kr_ulevel , scons B1 (scons B2 ∅) ⟩ $ by opair_congr [l4, l3]

ra_ulevel_eq
------------
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A2 ∅ = scons B2 ∅ $ by scons_eq [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) = scons B1 (scons B2 ∅) $ by scons_eq [#1, l2]
l4: $ G ⇒ kr_ulevel = kr_ulevel $ by eq_refl
l5: $ G ⇒ ⟨ kr_ulevel , scons A1 (scons A2 ∅) ⟩ = ⟨ kr_ulevel , scons B1 (scons B2 ∅) ⟩ $ by opair_eq [l4, l3]

sb_c_ra_ulevel
--------------
l1: $ (⟦ x / t ⟧ ⟨ kr_ulevel , scons A1 (scons A2 ∅) ⟩) ≐ ⟨ kr_ulevel , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) ∅) ⟩ $ by ceqt_refl

