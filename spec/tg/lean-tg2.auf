-- Proofs for lean-tg2.mm0.

kr_ulevel_omega
---------------
l1: $ G ⇒ kr_proj_eq ∈ ω $ by kr_proj_eq_omega
l2: $ G ⇒ kr_ulevel ∈ ω $ by omega_suc_c [l1]

kr_eeqv_omega
-------------
l1: $ G ⇒ kr_ulevel ∈ ω $ by kr_ulevel_omega
l2: $ G ⇒ kr_eeqv ∈ ω $ by omega_suc_c [l1]

kr_ind_eqv_omega
----------------
l1: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l2: $ G ⇒ kr_ind_eqv ∈ ω $ by omega_suc_c [l1]

kr_ceqv_omega
-------------
l1: $ G ⇒ kr_ind_eqv ∈ ω $ by kr_ind_eqv_omega
l2: $ G ⇒ kr_ceqv ∈ ω $ by omega_suc_c [l1]

kr_teqv_omega
-------------
l1: $ G ⇒ kr_ceqv ∈ ω $ by kr_ceqv_omega
l2: $ G ⇒ kr_teqv ∈ ω $ by omega_suc_c [l1]

kr_cseqv_omega
--------------
l1: $ G ⇒ kr_teqv ∈ ω $ by kr_teqv_omega
