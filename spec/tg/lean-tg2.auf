l7: $ G ⇒ pp = scons (ra_nst_group V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V8 V10 V11) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 = ra_nst_group V1 V2 V3 V4 V6 V7 V8 ⟨ kc_cons , scons V5 (scons V10 ∅) ⟩ V11 $ by and_elim_r [l6]
