lemma g2_o_nst_group (G: hyps) {G_v D I X0 j_v ni N X i_v npi N2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9: set):
  $ G ⇒ ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ pr_nst_group $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) ∨ ∃ G_v ∃ D ∃ I ∃ X0 ∃ X ∃ j_v ∃ i_v ∃ ni ∃ npi ∃ N ∃ N2 (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = i_v ∧ t7 = ni ∧ t8 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t9 = N2 ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ ni ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X0 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ npi X0 X ∈ lrel ∧ ra_aux_data D I X j_v i_v ∈ lrel ∧ ra_nst_group G_v D I X0 ⟨ kc_s , scons j_v ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ ni N N2 ∈ lrel2) $
----
l1: $ G , ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ cl_nst_group_cons ⇒ ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ cl_nst_group_cons $ by ax
