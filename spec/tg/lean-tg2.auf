l22: $ G ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by wcel_elim [#1, l21]

lemma g2_e_nst_group_cons (G: hyps) {G_v D I X0 X j_v i_v ni npi N N2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11: set):
  $ G ⇒ ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ = ⟨ scons (ra_nst_group V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V8 V10 V11) ∅ , ra_nst_group V1 V2 V3 V4 V6 V7 V8 ⟨ kc_cons , scons V5 (scons V10 ∅) ⟩ V11 ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ ra_le ⟨ kc_s , scons V7 ∅ ⟩ V8 ∈ lrel $ > $ G ⇒ ra_spine ⟨ kc_ind_ty , scons V3 (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ V4 V9 ∈ lrel $ > $ G ⇒ ra_rehead ⟨ kc_ind_ty , scons V3 (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ ⟨ kc_ind_ty , scons V3 (scons V7 ∅) ⟩ V9 V4 V5 ∈ lrel $ > $ G ⇒ ra_aux_data V2 V3 V5 V6 V7 ∈ lrel $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ X ∃ j_v ∃ i_v ∃ ni ∃ npi ∃ N ∃ N2 (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = i_v ∧ t7 = ni ∧ t8 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t9 = N2 ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ ni ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X0 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ npi X0 X ∈ lrel ∧ ra_aux_data D I X j_v i_v ∈ lrel ∧ ra_nst_group G_v D I X0 ⟨ kc_s , scons j_v ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ ni N N2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_nst_group V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V8 V10 V11) ∅ , ra_nst_group V1 V2 V3 V4 V6 V7 V8 ⟨ kc_cons , scons V5 (scons V10 ∅) ⟩ V11 ⟩ = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_nst_group V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V8 V10 V11) ∅) $ by g2_opair_set_l [l1]
