l9: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z $ by and_intro [l7, l8]
l10: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by ex_intro [l9]
l11: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by ex_intro [l10]
l12: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ x ∊ cl_eeqv_srt $ by cab_intro [l11]
l13: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∈ cl_eeqv_srt $ by wcel_intro [l7, l12]
l14: $ G , y = A1 , z = A2 ⇒ isset ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ $ by opair_isset
l15: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_srt , scons z ∅ ⟩ ⟩ ∈ cl_eeqv_srt $ by isset_elim [l14, l13]
l16: $ G , y = A1 , z = A2 ⇒ ∅ = ∅ $ by eq_refl
l17: $ G , y = A1 , z = A2 ⇒ kc_srt = kc_srt $ by eq_refl
