l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ex_intro [l7]
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ex_intro [l8]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ex_intro [l9]
