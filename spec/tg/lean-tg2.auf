-- Lemmas of g2 (the range lprog2_ulevel_pr .. lrel2_nst_group_cases): inversion
-- of the relations of the second stratum. Generated by a script (g2's gen.py,
-- adapted from historical/tg-lean-inv-proofs.py) from lean-tg2.mm0.

--| A pair whose first component is a class equals a pair of sets only if the
--| class is a set (else `∅` would be a component of the pair).
lemma g2_opair_set_l (G: hyps) (A B C: class) (a: set):
  $ G ⇒ ⟨ A , B ⟩ = ⟨ a , C ⟩ $ > $ G ⇒ isset A $
----
l1: $ G , ¬ isset A , x ∊ csn A ⇒ x ∊ csn A $ by ax
l2: $ G , ¬ isset A , x ∊ csn A ⇒ x = A $ by csn_elim [l1]
l3: $ G , ¬ isset A , x ∊ csn A ⇒ isset A $ by isset_intro [l2]
l4: $ G , ¬ isset A , x ∊ csn A ⇒ ¬ isset A $ by ax
l5: $ G , ¬ isset A , x ∊ csn A ⇒ ⊥ $ by not_elim [l4, l3]
l6: $ G , ¬ isset A ⇒ csn A = ∅ $ by empty_eq_intro [l5]
l7: $ G , ¬ isset A , y = ∅ ⇒ y = ∅ $ by ax
l8: $ G , ¬ isset A , y = ∅ ⇒ csn A = ∅ $ by weaken [l6]
l9: $ G , ¬ isset A , y = ∅ ⇒ ∅ = csn A $ by eq_sym [l8]
l10: $ G , ¬ isset A , y = ∅ ⇒ y = csn A $ by eq_trans [l7, l9]
l11: $ G , ¬ isset A , y = ∅ ⇒ y = csn A ∨ y = cpr A B $ by or_intro_l [l10]
l12: $ G , ¬ isset A , y = ∅ ⇒ y ∊ ⟨ A , B ⟩ $ by cpr_intro [l11]
l13: $ G , ¬ isset A , y = ∅ ⇒ ⟨ A , B ⟩ = ⟨ a , C ⟩ $ by weaken [#1]
l14: $ G , ¬ isset A , y = ∅ ⇒ y ∊ ⟨ a , C ⟩ $ by welc_eq [l13, l12]
l15: $ G , ¬ isset A , y = ∅ ⇒ y = csn a ∨ y = cpr a C $ by cpr_elim [l14]
l16: $ G , ¬ isset A , y = ∅ , y = csn a ⇒ y = csn a $ by ax
l17: $ G , ¬ isset A , y = ∅ , y = csn a ⇒ csn a = y $ by eq_sym [l16]
l18: $ G , ¬ isset A , y = ∅ , y = csn a ⇒ a ∊ csn a $ by csn_intro_var
l19: $ G , ¬ isset A , y = ∅ , y = csn a ⇒ a ∊ y $ by welc_eq [l17, l18]
l20: $ G , ¬ isset A , y = ∅ , y = csn a ⇒ y = ∅ $ by ax
l21: $ G , ¬ isset A , y = ∅ , y = csn a ⇒ a ∊ ∅ $ by welc_eq [l20, l19]
l22: $ G , ¬ isset A , y = ∅ , y = csn a ⇒ ⊥ $ by empty_elim [l21]
l23: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ y = cpr a C $ by ax
l24: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ cpr a C = y $ by eq_sym [l23]
l25: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ a = a $ by eq_refl
l26: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ a = a ∨ a = C $ by or_intro_l [l25]
l27: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ a ∊ cpr a C $ by cpr_intro [l26]
l28: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ a ∊ y $ by welc_eq [l24, l27]
l29: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ y = ∅ $ by ax
l30: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ a ∊ ∅ $ by welc_eq [l29, l28]
l31: $ G , ¬ isset A , y = ∅ , y = cpr a C ⇒ ⊥ $ by empty_elim [l30]
l32: $ G , ¬ isset A , y = ∅ ⇒ ⊥ $ by or_elim [l15, l22, l31]
l33: $ G , ¬ isset A ⇒ isset ∅ $ by ax_empty
l34: $ G , ¬ isset A ⇒ ⊥ $ by isset_elim [l33, l32]
l35: $ G ⇒ isset A $ by by_contra [l34]

--| The first component of a pair, when it is a set (the second need not be).
lemma g2_fst (G: hyps) (A B C: class) (a: set):
  $ G ⇒ ⟨ A , B ⟩ = ⟨ a , C ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ A = a $
----
l1: $ G ⇒ isset (csn A) $ by csn_set [#2]
l2: $ G , x = csn A ⇒ x = csn A $ by ax
l3: $ G , x = csn A ⇒ x = csn A ∨ x = cpr A B $ by or_intro_l [l2]
l4: $ G , x = csn A ⇒ x ∊ ⟨ A , B ⟩ $ by cpr_intro [l3]
l5: $ G , x = csn A ⇒ ⟨ A , B ⟩ = ⟨ a , C ⟩ $ by weaken [#1]
l6: $ G , x = csn A ⇒ x ∊ ⟨ a , C ⟩ $ by welc_eq [l5, l4]
l7: $ G , x = csn A ⇒ x = csn a ∨ x = cpr a C $ by cpr_elim [l6]
l8: $ G , x = csn A , x = csn a ⇒ x = csn a $ by ax
l9: $ G , x = csn A , x = csn a ⇒ csn a = x $ by eq_sym [l8]
l10: $ G , x = csn A , x = csn a ⇒ a ∊ csn a $ by csn_intro_var
l11: $ G , x = csn A , x = csn a ⇒ a ∊ x $ by welc_eq [l9, l10]
l12: $ G , x = csn A , x = csn a ⇒ x = csn A $ by ax
l13: $ G , x = csn A , x = csn a ⇒ a ∊ csn A $ by welc_eq [l12, l11]
l14: $ G , x = csn A , x = csn a ⇒ a = A $ by csn_elim [l13]
l15: $ G , x = csn A , x = cpr a C ⇒ x = cpr a C $ by ax
l16: $ G , x = csn A , x = cpr a C ⇒ cpr a C = x $ by eq_sym [l15]
l17: $ G , x = csn A , x = cpr a C ⇒ a = a $ by eq_refl
l18: $ G , x = csn A , x = cpr a C ⇒ a = a ∨ a = C $ by or_intro_l [l17]
l19: $ G , x = csn A , x = cpr a C ⇒ a ∊ cpr a C $ by cpr_intro [l18]
l20: $ G , x = csn A , x = cpr a C ⇒ a ∊ x $ by welc_eq [l16, l19]
l21: $ G , x = csn A , x = cpr a C ⇒ x = csn A $ by ax
l22: $ G , x = csn A , x = cpr a C ⇒ a ∊ csn A $ by welc_eq [l21, l20]
l23: $ G , x = csn A , x = cpr a C ⇒ a = A $ by csn_elim [l22]
l24: $ G , x = csn A ⇒ a = A $ by or_elim [l7, l14, l23]
l25: $ G , x = csn A ⇒ A = a $ by eq_sym [l24]
l26: $ G ⇒ A = a $ by isset_elim [l1, l25]

--| The label `K` of an atom ⟨ K , S ⟩ in the conclusion of a clause.
lemma g2_key (G: hyps) (A K S: class) (a b c: set):
  $ G ⇒ ⟨ A , ⟨ K , S ⟩ ⟩ = ⟨ a , ⟨ b , c ⟩ ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ K = b $
----
l1: $ G ⇒ isset A $ by g2_opair_set_l [#1]
l2: $ G ⇒ isset ⟨ K , S ⟩ $ by opair_isset
l3: $ G ⇒ isset a $ by isset_var
l4: $ G ⇒ isset ⟨ b , c ⟩ $ by opair_isset
l5: $ G ⇒ A = a ∧ ⟨ K , S ⟩ = ⟨ b , c ⟩ $ by opair_inj_c [#1, l1, l2, l3, l4]
l6: $ G ⇒ ⟨ K , S ⟩ = ⟨ b , c ⟩ $ by and_elim_r [l5]
l7: $ G ⇒ K = b $ by g2_fst [l6, #2]

--| The clauses whose conclusion has a label in [L, H) (as ordinals: the
--| relation labels are the natural numbers `kr_R`).
def g2_lab (L H: class) (.i .j .u .w: set): class = $ {w | ∀ i ∀ j ∀ u (w = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H ∧ L ⊆ j)} $

lemma g2_lab_intro (G: hyps) (A K S L H: class) (x: set):
  $ G ⇒ x = ⟨ A , ⟨ K , S ⟩ ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ K ∈ H $ > $ G ⇒ L ⊆ K $ >
  $ G ⇒ x ∊ g2_lab L H $
----
l1: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ x = ⟨ i , ⟨ j , u ⟩ ⟩ $ by ax
l2: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ x = ⟨ A , ⟨ K , S ⟩ ⟩ $ by weaken [#1]
l3: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ ⟨ A , ⟨ K , S ⟩ ⟩ = x $ by eq_sym [l2]
l4: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ ⟨ A , ⟨ K , S ⟩ ⟩ = ⟨ i , ⟨ j , u ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ isset K $ by weaken [#2]
l6: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ K = j $ by g2_key [l4, l5]
l7: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ K ∈ H $ by weaken [#3]
l8: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ j ∈ H $ by wcel_eq_l [l6, l7]
l9: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ j ∊ H $ by wcel_welc [l8]
l10: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ L ⊆ K $ by weaken [#4]
l11: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ L ⊆ j $ by subset_eq_r [l6, l10]
l12: $ G , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ j ∊ H ∧ L ⊆ j $ by and_intro [l9, l11]
l13: $ G ⇒ x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H ∧ L ⊆ j $ by imp_intro [l12]
l14: $ G ⇒ ∀ u (x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H ∧ L ⊆ j) $ by all_intro [l13]
l15: $ G ⇒ ∀ j ∀ u (x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H ∧ L ⊆ j) $ by all_intro [l14]
l16: $ G ⇒ ∀ i ∀ j ∀ u (x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H ∧ L ⊆ j) $ by all_intro [l15]
l17: $ G ⇒ x ∊ g2_lab L H $ by cab_intro [l16]

lemma g2_lab_elim (G: hyps) (X L H: class) (a b c: set):
  $ G ⇒ X ∈ g2_lab L H $ > $ G ⇒ X = ⟨ a , ⟨ b , c ⟩ ⟩ $ > $ G ⇒ b ∊ H ∧ L ⊆ b $
----
l1: $ G , x = X , x ∊ g2_lab L H ⇒ x ∊ g2_lab L H $ by ax
l2: $ G , x = X , x ∊ g2_lab L H ⇒ ∀ i ∀ j ∀ u (x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H ∧ L ⊆ j) $ by cab_elim [l1]
l3: $ G , x = X , x ∊ g2_lab L H ⇒ ∀ j ∀ u (x = ⟨ a , ⟨ j , u ⟩ ⟩ → j ∊ H ∧ L ⊆ j) $ by all_elim [l2]
l4: $ G , x = X , x ∊ g2_lab L H ⇒ ∀ u (x = ⟨ a , ⟨ b , u ⟩ ⟩ → b ∊ H ∧ L ⊆ b) $ by all_elim [l3]
l5: $ G , x = X , x ∊ g2_lab L H ⇒ x = ⟨ a , ⟨ b , c ⟩ ⟩ → b ∊ H ∧ L ⊆ b $ by all_elim [l4]
l6: $ G , x = X , x ∊ g2_lab L H ⇒ x = X $ by ax
l7: $ G , x = X , x ∊ g2_lab L H ⇒ X = ⟨ a , ⟨ b , c ⟩ ⟩ $ by weaken [#2]
l8: $ G , x = X , x ∊ g2_lab L H ⇒ x = ⟨ a , ⟨ b , c ⟩ ⟩ $ by eq_trans [l6, l7]
l9: $ G , x = X , x ∊ g2_lab L H ⇒ b ∊ H ∧ L ⊆ b $ by imp_elim [l5, l8]
l10: $ G ⇒ b ∊ H ∧ L ⊆ b $ by wcel_elim [#1, l9]

lemma g2_lab_mono (G: hyps) (L H L2 H2: class):
  $ G ⇒ L2 ⊆ L $ > $ G ⇒ H ⊆ H2 $ > $ G ⇒ g2_lab L H ⊆ g2_lab L2 H2 $
----
l1: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ x ∊ g2_lab L H $ by ax
l2: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ x ∈ g2_lab L H $ by welc_wcel [l1]
l3: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ x = ⟨ i , ⟨ j , u ⟩ ⟩ $ by ax
l4: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ j ∊ H ∧ L ⊆ j $ by g2_lab_elim [l2, l3]
l5: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ j ∊ H $ by and_elim_l [l4]
l6: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ L ⊆ j $ by and_elim_r [l4]
l7: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ H ⊆ H2 $ by weaken [#2]
l8: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ j ∊ H2 $ by subset_elim [l7, l5]
l9: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ L2 ⊆ L $ by weaken [#1]
l10: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ L2 ⊆ j $ by subset_trans [l9, l6]
l11: $ G , x ∊ g2_lab L H , x = ⟨ i , ⟨ j , u ⟩ ⟩ ⇒ j ∊ H2 ∧ L2 ⊆ j $ by and_intro [l8, l10]
l12: $ G , x ∊ g2_lab L H ⇒ x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H2 ∧ L2 ⊆ j $ by imp_intro [l11]
l13: $ G , x ∊ g2_lab L H ⇒ ∀ u (x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H2 ∧ L2 ⊆ j) $ by all_intro [l12]
l14: $ G , x ∊ g2_lab L H ⇒ ∀ j ∀ u (x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H2 ∧ L2 ⊆ j) $ by all_intro [l13]
l15: $ G , x ∊ g2_lab L H ⇒ ∀ i ∀ j ∀ u (x = ⟨ i , ⟨ j , u ⟩ ⟩ → j ∊ H2 ∧ L2 ⊆ j) $ by all_intro [l14]
l16: $ G , x ∊ g2_lab L H ⇒ x ∊ g2_lab L2 H2 $ by cab_intro [l15]
l17: $ G ⇒ g2_lab L H ⊆ g2_lab L2 H2 $ by subset_intro [l16]

--| A clause of the relation labelled `K` is in its label range.
lemma g2_lab_self (G: hyps) (A K S: class) (x: set):
  $ G ⇒ x = ⟨ A , ⟨ K , S ⟩ ⟩ $ > $ G ⇒ K ∈ ω $ > $ G ⇒ x ∊ g2_lab K (suc K) $
----
l1: $ G ⇒ isset K $ by wcel_isset [#2]
l2: $ G ⇒ K ∈ suc K $ by suc_mem [l1]
l3: $ G ⇒ K ⊆ K $ by subset_refl
l4: $ G ⇒ x ∊ g2_lab K (suc K) $ by g2_lab_intro [#1, l1, l2, l3]

--| The label of an element of the program, from a label range.
lemma g2_lprog_lab (G: hyps) (P K S L H: class):
  $ G ⇒ ⟨ P , ⟨ K , S ⟩ ⟩ ∈ lprog2 $ > $ G ⇒ isset K $ > $ G ⇒ ⟨ P , ⟨ K , S ⟩ ⟩ ∈ g2_lab L H $ >
  $ G ⇒ K ∈ H ∧ L ⊆ K $
----
l1: $ G ⇒ lprog2 ⊆ fseq latoms × latoms $ by cin_subset_r
l2: $ G ⇒ ⟨ P , ⟨ K , S ⟩ ⟩ ∈ fseq latoms × latoms $ by wcel_subset [l1, #1]
l3: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ z = ⟨ P , ⟨ K , S ⟩ ⟩ $ by ax
l4: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ z = ⟨ x , y ⟩ $ by ax
l5: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ y = ⟨ k , u ⟩ $ by ax
l6: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ x = x $ by eq_refl
l7: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ ⟨ x , y ⟩ = ⟨ x , ⟨ k , u ⟩ ⟩ $ by opair_eq [l6, l5]
l8: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ z = ⟨ x , ⟨ k , u ⟩ ⟩ $ by eq_trans [l4, l7]
l9: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ ⟨ P , ⟨ K , S ⟩ ⟩ = z $ by eq_sym [l3]
l10: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ ⟨ P , ⟨ K , S ⟩ ⟩ = ⟨ x , ⟨ k , u ⟩ ⟩ $ by eq_trans [l9, l8]
l11: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ ⟨ P , ⟨ K , S ⟩ ⟩ ∈ g2_lab L H $ by weaken [#3]
l12: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ k ∊ H ∧ L ⊆ k $ by g2_lab_elim [l11, l10]
l13: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ isset K $ by weaken [#2]
l14: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ K = k $ by g2_key [l10, l13]
l15: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ k = K $ by eq_sym [l14]
l16: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ k ∊ H $ by and_elim_l [l12]
l17: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ k ∈ H $ by welc_wcel [l16]
l18: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ K ∈ H $ by wcel_eq_l [l15, l17]
l19: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ L ⊆ k $ by and_elim_r [l12]
l20: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ L ⊆ K $ by subset_eq_r [l15, l19]
l21: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ K ∈ H ∧ L ⊆ K $ by and_intro [l18, l20]
l22: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms ⇒ y ∊ latoms $ by ax
l23: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms ⇒ K ∈ H ∧ L ⊆ K $ by cxp_elim [l22, l21]
l24: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms ⇒ z ∊ fseq latoms × latoms $ by ax
l25: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms ⇒ K ∈ H ∧ L ⊆ K $ by cxp_elim [l24, l23]
l26: $ G ⇒ K ∈ H ∧ L ⊆ K $ by wcel_elim [l2, l25]

--| Membership in a union, for a class.
lemma g2_wcel_cun_elim (G: hyps) (P A B: class): $ G ⇒ P ∈ A ∪ B $ > $ G ⇒ P ∈ A ∨ P ∈ B $
----
l1: $ G , z = P , z ∊ A ∪ B ⇒ z ∊ A ∪ B $ by ax
l2: $ G , z = P , z ∊ A ∪ B ⇒ z ∊ A ∨ z ∊ B $ by cun_elim [l1]
l3: $ G , z = P , z ∊ A ∪ B , z ∊ A ⇒ z = P $ by ax
l4: $ G , z = P , z ∊ A ∪ B , z ∊ A ⇒ z ∊ A $ by ax
l5: $ G , z = P , z ∊ A ∪ B , z ∊ A ⇒ P ∈ A $ by wcel_intro [l3, l4]
l6: $ G , z = P , z ∊ A ∪ B , z ∊ A ⇒ P ∈ A ∨ P ∈ B $ by or_intro_l [l5]
l7: $ G , z = P , z ∊ A ∪ B , z ∊ B ⇒ z = P $ by ax
l8: $ G , z = P , z ∊ A ∪ B , z ∊ B ⇒ z ∊ B $ by ax
l9: $ G , z = P , z ∊ A ∪ B , z ∊ B ⇒ P ∈ B $ by wcel_intro [l7, l8]
l10: $ G , z = P , z ∊ A ∪ B , z ∊ B ⇒ P ∈ A ∨ P ∈ B $ by or_intro_r [l9]
l11: $ G , z = P , z ∊ A ∪ B ⇒ P ∈ A ∨ P ∈ B $ by or_elim [l2, l6, l10]
l12: $ G ⇒ P ∈ A ∨ P ∈ B $ by wcel_elim [#1, l11]

-- The union of `lprog2` as a tree of defs (the root `g2_u0` is that union).

def g2_u2: class = $ pr_ulevel ∪ pr_eeqv $

def g2_u3: class = $ pr_ind_eqv ∪ pr_ceqv $

def g2_u1: class = $ g2_u2 ∪ g2_u3 $

def g2_u5: class = $ pr_teqv ∪ pr_cseqv $

def g2_u6: class = $ pr_lseqv ∪ pr_nst_group $

def g2_u4: class = $ g2_u5 ∪ g2_u6 $

def g2_u0: class = $ g2_u1 ∪ g2_u4 $

-- The label ranges of the subtrees: from the first to the last relation.

lemma g2_f2 (G: hyps): $ G ⇒ kr_ulevel ⊆ kr_eeqv $
----
l1: $ G ⇒ kr_ulevel ⊆ kr_ulevel $ by subset_refl
l2: $ G ⇒ kr_ulevel ⊆ kr_eeqv $ by suc_subset
l3: $ G ⇒ kr_eeqv ⊆ kr_eeqv $ by subset_refl
l4: $ G ⇒ kr_ulevel ⊆ kr_eeqv $ by subset_trans [l2, l3]

lemma g2_f3 (G: hyps): $ G ⇒ kr_ind_eqv ⊆ kr_ceqv $
----
l1: $ G ⇒ kr_ind_eqv ⊆ kr_ind_eqv $ by subset_refl
l2: $ G ⇒ kr_ind_eqv ⊆ kr_ceqv $ by suc_subset
l3: $ G ⇒ kr_ceqv ⊆ kr_ceqv $ by subset_refl
l4: $ G ⇒ kr_ind_eqv ⊆ kr_ceqv $ by subset_trans [l2, l3]

lemma g2_f1 (G: hyps): $ G ⇒ kr_ulevel ⊆ kr_ceqv $
----
l1: $ G ⇒ kr_ulevel ⊆ kr_eeqv $ by g2_f2
l2: $ G ⇒ kr_eeqv ⊆ kr_ind_eqv $ by suc_subset
l3: $ G ⇒ kr_ind_eqv ⊆ kr_ceqv $ by g2_f3
l4: $ G ⇒ kr_ulevel ⊆ kr_ind_eqv $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_ulevel ⊆ kr_ceqv $ by subset_trans [l4, l3]

lemma g2_f5 (G: hyps): $ G ⇒ kr_teqv ⊆ kr_cseqv $
----
l1: $ G ⇒ kr_teqv ⊆ kr_teqv $ by subset_refl
l2: $ G ⇒ kr_teqv ⊆ kr_cseqv $ by suc_subset
l3: $ G ⇒ kr_cseqv ⊆ kr_cseqv $ by subset_refl
l4: $ G ⇒ kr_teqv ⊆ kr_cseqv $ by subset_trans [l2, l3]

lemma g2_f6 (G: hyps): $ G ⇒ kr_lseqv ⊆ kr_nst_group $
----
l1: $ G ⇒ kr_lseqv ⊆ kr_lseqv $ by subset_refl
l2: $ G ⇒ kr_lseqv ⊆ kr_nst_group $ by suc_subset
l3: $ G ⇒ kr_nst_group ⊆ kr_nst_group $ by subset_refl
l4: $ G ⇒ kr_lseqv ⊆ kr_nst_group $ by subset_trans [l2, l3]

lemma g2_f4 (G: hyps): $ G ⇒ kr_teqv ⊆ kr_nst_group $
----
l1: $ G ⇒ kr_teqv ⊆ kr_cseqv $ by g2_f5
l2: $ G ⇒ kr_cseqv ⊆ kr_lseqv $ by suc_subset
l3: $ G ⇒ kr_lseqv ⊆ kr_nst_group $ by g2_f6
l4: $ G ⇒ kr_teqv ⊆ kr_lseqv $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_teqv ⊆ kr_nst_group $ by subset_trans [l4, l3]

lemma g2_f0 (G: hyps): $ G ⇒ kr_ulevel ⊆ kr_nst_group $
----
l1: $ G ⇒ kr_ulevel ⊆ kr_ceqv $ by g2_f1
l2: $ G ⇒ kr_ceqv ⊆ kr_teqv $ by suc_subset
l3: $ G ⇒ kr_teqv ⊆ kr_nst_group $ by g2_f4
l4: $ G ⇒ kr_ulevel ⊆ kr_teqv $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_ulevel ⊆ kr_nst_group $ by subset_trans [l4, l3]

-- Each clause is in its relation's label range, hence so is each relation.

lemma g2_k_ulevel_prop (G: hyps): $ G ⇒ cl_ulevel_prop ⊆ g2_lab kr_ulevel (suc kr_ulevel) $
----
l1: $ G , x ∊ cl_ulevel_prop ⇒ x ∊ cl_ulevel_prop $ by ax
l2: $ G , x ∊ cl_ulevel_prop ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ kr_ulevel ∈ ω $ by kr_ulevel_omega
l6: $ G , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ ⇒ x ∊ g2_lab kr_ulevel (suc kr_ulevel) $ by g2_lab_self [l4, l5]
l7: $ G , ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) $ by ax
l8: $ G , ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) ⇒ x ∊ g2_lab kr_ulevel (suc kr_ulevel) $ by ex_elim [l7, l6]
l9: $ G , x ∊ cl_ulevel_prop ⇒ x ∊ g2_lab kr_ulevel (suc kr_ulevel) $ by ex_elim [l2, l8]
l10: $ G ⇒ cl_ulevel_prop ⊆ g2_lab kr_ulevel (suc kr_ulevel) $ by subset_intro [l9]

lemma g2_k_ulevel_le (G: hyps): $ G ⇒ cl_ulevel_le ⊆ g2_lab kr_ulevel (suc kr_ulevel) $
----
l1: $ G , x ∊ cl_ulevel_le ⇒ x ∊ cl_ulevel_le $ by ax
l2: $ G , x ∊ cl_ulevel_le ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y $ by ax
l4: $ G , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ kr_ulevel ∈ ω $ by kr_ulevel_omega
l6: $ G , x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y ⇒ x ∊ g2_lab kr_ulevel (suc kr_ulevel) $ by g2_lab_self [l4, l5]
l7: $ G , ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) ⇒ ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) $ by ax
l8: $ G , ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) ⇒ x ∊ g2_lab kr_ulevel (suc kr_ulevel) $ by ex_elim [l7, l6]
l9: $ G , x ∊ cl_ulevel_le ⇒ x ∊ g2_lab kr_ulevel (suc kr_ulevel) $ by ex_elim [l2, l8]
l10: $ G ⇒ cl_ulevel_le ⊆ g2_lab kr_ulevel (suc kr_ulevel) $ by subset_intro [l9]

lemma g2_p_ulevel (G: hyps): $ G ⇒ pr_ulevel ⊆ g2_lab kr_ulevel (suc kr_ulevel) $
----
l1: $ G ⇒ cl_ulevel_le ⊆ g2_lab kr_ulevel (suc kr_ulevel) $ by g2_k_ulevel_le
l2: $ G ⇒ cl_ulevel_prop ⊆ g2_lab kr_ulevel (suc kr_ulevel) $ by g2_k_ulevel_prop
l3: $ G ⇒ pr_ulevel ⊆ g2_lab kr_ulevel (suc kr_ulevel) $ by cun_least [l2, l1]

lemma g2_k_eeqv_refl (G: hyps): $ G ⇒ cl_eeqv_refl ⊆ g2_lab kr_eeqv (suc kr_eeqv) $
----
l1: $ G , x ∊ cl_eeqv_refl ⇒ x ∊ cl_eeqv_refl $ by ax
l2: $ G , x ∊ cl_eeqv_refl ⇒ ∃ y (x = ⟨ ∅ , ra_eeqv y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ x = ⟨ ∅ , ra_eeqv y y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l5: $ G , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by g2_lab_self [l3, l4]
l6: $ G , x ∊ cl_eeqv_refl ⇒ x ∊ g2_lab kr_eeqv (suc kr_eeqv) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_eeqv_refl ⊆ g2_lab kr_eeqv (suc kr_eeqv) $ by subset_intro [l6]

lemma g2_k_eeqv_bvar (G: hyps): $ G ⇒ cl_eeqv_bvar ⊆ g2_lab kr_eeqv (suc kr_eeqv) $
----
l1: $ G , x ∊ cl_eeqv_bvar ⇒ x ∊ cl_eeqv_bvar $ by ax
l2: $ G , x ∊ cl_eeqv_bvar ⇒ ∃ y (x = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_bvar , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
