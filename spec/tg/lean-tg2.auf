l29: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l30: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_elim [l29, l28]
l31: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) $ by ax
l32: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ceqv v w) (scons (ra_teqv c f) (scons (ra_ceqv a b) ∅)) , ra_ind_eqv y z ⟩ ∧ ra_ind_data y u v c ∈ lrel ∧ ra_ind_data z u w f ∈ lrel ∧ ra_ind_nested y a ∈ lrel ∧ ra_ind_nested z b ∈ lrel) ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_elim [l31, l30]
l33: $ G , x = ⟨ pp , ra_ind_eqv t1 t2 ⟩ , x ∊ cl_ind_eqv_i ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_elim [l2, l32]
l34: $ G ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by wcel_elim [#1, l33]

lemma g2_o_ind_eqv (G: hyps) {D D2 b_v P P2 N N2 T T2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_eqv t1 t2 ⟩ ∈ pr_ind_eqv $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $
----
l1: $ G ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by g2_d_ind_eqv_i [#1, #2]

lrel2_ind_eqv_cases
-------------------
l1: $ G ⇒ isset (ra_ind_eqv t1 t2) $ by opair_isset
l2: $ G , c = ra_ind_eqv t1 t2 ⇒ c = ra_ind_eqv t1 t2 $ by ax
l3: $ G , c = ra_ind_eqv t1 t2 ⇒ ra_ind_eqv t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_ind_eqv t1 t2 ⇒ ra_ind_eqv t1 t2 ∈ lrel2 $ by weaken [#1]
l5: $ G , c = ra_ind_eqv t1 t2 ⇒ c ∈ lrel2 $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_ind_eqv t1 t2 ⇒ c ∊ lrel2 $ by wcel_welc [l5]
l7: $ G , c = ra_ind_eqv t1 t2 ⇒ hprog lprog2 latoms $ by lprog2_hprog
l8: $ G , c = ra_ind_eqv t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2) $ by horn_elim [l7, l6]
l9: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 $ by ax
l10: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 $ by and_elim_l [l9]
l11: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ crn p ⊆ lrel2 $ by and_elim_r [l9]
l12: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ p = p $ by eq_refl
l13: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ c = ra_ind_eqv t1 t2 $ by ax
l14: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ = ⟨ p , ra_ind_eqv t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_ind_eqv t1 t2 ⟩ ∈ lprog2 $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_ind_eqv t1 t2 ⟩ ∈ pr_ind_eqv $ by lprog2_ind_eqv_pr [l15]
l17: $ G , c = ra_ind_eqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by g2_o_ind_eqv [l16, l11]
l18: $ G , c = ra_ind_eqv t1 t2 ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $ by isset_elim [l1, l18]

lemma g2_e_ceqv_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_ceqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ceqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_ceqv t1 t2 = ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ceqv t1 t2 = ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l14, l15]
l17: $ G ⇒ kr_ceqv ∈ ω $ by kr_ceqv_omega
l18: $ G ⇒ isset kr_ceqv $ by wcel_isset [l17]
l19: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l20: $ G ⇒ isset (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by wcel_isset [l16]
l21: $ G ⇒ kr_ceqv = kr_ceqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by opair_inj_c [l8, l18, l19, l18, l20]
l22: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by and_elim_r [l21]
l23: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by g2_scons_inj [l22, l12, l14, l11, l15]
l24: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l23]
l25: $ G ⇒ scons t2 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by and_elim_r [l23]
l26: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l25, l10, l14, l9, l9]
l27: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l26]
l28: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l24, l27]

lemma g2_d_ceqv_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_nil ⇒ x ∊ cl_ceqv_nil $ by ax
l2: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_nil ⇒ (x = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_nil ⇒ x = ⟨ pp , ra_ceqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_nil ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_nil ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_nil ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_nil ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by g2_e_ceqv_nil [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma g2_e_ceqv_cons (G: hyps) {A A2 G_v G2: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ = ⟨ scons (ra_eeqv V1 V2) (scons (ra_ceqv V3 V4) ∅) , ra_ceqv ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_eeqv V1 V2) (scons (ra_ceqv V3 V4) ∅) , ra_ceqv ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_ceqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_eeqv V1 V2) (scons (ra_ceqv V3 V4) ∅)) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ceqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_ceqv ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_eeqv V1 V2) (scons (ra_ceqv V3 V4) ∅) ∧ ra_ceqv t1 t2 = ra_ceqv ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_eeqv V1 V2) (scons (ra_ceqv V3 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_ceqv t1 t2 = ra_ceqv ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_ceqv ∈ ω $ by kr_ceqv_omega
l19: $ G ⇒ isset kr_ceqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_ceqv = kr_ceqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_eeqv V1 V2) (scons (ra_ceqv V3 V4) ∅)) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_eeqv V1 V2) (scons (ra_ceqv V3 V4) ∅)) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_eeqv V1 V2) $ by opair_isset
l32: $ G ⇒ ra_eeqv V1 V2 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_ceqv V3 V4) ∅) ⊆ lrel2 $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_ceqv V3 V4) $ by opair_isset
l35: $ G ⇒ ra_ceqv V3 V4 ∈ lrel2 $ by crn_scons_head [l34, l33]
l36: $ G ⇒ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_ceqv V3 V4 ∈ lrel2 $ by and_intro [l32, l35]
l37: $ G ⇒ t2 = ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_ceqv V3 V4 ∈ lrel2 $ by and_intro [l28, l36]
l38: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons V2 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_ceqv V3 V4 ∈ lrel2 $ by and_intro [l25, l37]
l39: $ G ⇒ ∃ G2 (t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons V2 (scons G2 ∅) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_ceqv V3 G2 ∈ lrel2) $ by ex_intro [l38]
l40: $ G ⇒ ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons V2 (scons G2 ∅) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by ex_intro [l39]
l41: $ G ⇒ ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv V1 A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by ex_intro [l40]
l42: $ G ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by ex_intro [l41]

lemma g2_d_ceqv_cons (G: hyps) {A A2 G_v G2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_cons ⇒ x ∊ cl_ceqv_cons $ by ax
l2: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_ceqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩ ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by g2_e_ceqv_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_ceqv u v) ∅) , ra_ceqv ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_cons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ceqv t1 t2 ⟩ , x ∊ cl_ceqv_cons ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by wcel_elim [#1, l15]

lemma g2_o_ceqv (G: hyps) {A A2 G_v G2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ pr_ceqv $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $
----
l1: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons $ by ax
l2: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by g2_d_ceqv_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons → ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons $ by ax
l6: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∨ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons $ by g2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil $ by ax
l8: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l9: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by g2_d_ceqv_nil [l7, l8]
l10: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons $ by ax
l12: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons → ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_cons ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ceqv t1 t2 ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons → (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by imp_intro [l15]
l17: $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by imp_elim [l16, #1]

lrel2_ceqv_cases
----------------
l1: $ G ⇒ isset (ra_ceqv t1 t2) $ by opair_isset
l2: $ G , c = ra_ceqv t1 t2 ⇒ c = ra_ceqv t1 t2 $ by ax
l3: $ G , c = ra_ceqv t1 t2 ⇒ ra_ceqv t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_ceqv t1 t2 ⇒ ra_ceqv t1 t2 ∈ lrel2 $ by weaken [#1]
l5: $ G , c = ra_ceqv t1 t2 ⇒ c ∈ lrel2 $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_ceqv t1 t2 ⇒ c ∊ lrel2 $ by wcel_welc [l5]
l7: $ G , c = ra_ceqv t1 t2 ⇒ hprog lprog2 latoms $ by lprog2_hprog
l8: $ G , c = ra_ceqv t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2) $ by horn_elim [l7, l6]
l9: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 $ by ax
l10: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 $ by and_elim_l [l9]
l11: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ crn p ⊆ lrel2 $ by and_elim_r [l9]
l12: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ p = p $ by eq_refl
l13: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ c = ra_ceqv t1 t2 $ by ax
l14: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ = ⟨ p , ra_ceqv t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_ceqv t1 t2 ⟩ ∈ lprog2 $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_ceqv t1 t2 ⟩ ∈ pr_ceqv $ by lprog2_ceqv_pr [l15]
l17: $ G , c = ra_ceqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by g2_o_ceqv [l16, l11]
l18: $ G , c = ra_ceqv t1 t2 ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by ex_elim [l8, l17]
l19: $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $ by isset_elim [l1, l18]

lemma g2_e_teqv_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ = ⟨ ∅ , ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ ⟩ = ⟨ pp , ra_teqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_teqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_teqv t1 t2 = ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_teqv t1 t2 = ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_tnil , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_tnil , ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l14, l15]
l17: $ G ⇒ kr_teqv ∈ ω $ by kr_teqv_omega
l18: $ G ⇒ isset kr_teqv $ by wcel_isset [l17]
l19: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l20: $ G ⇒ isset (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) $ by wcel_isset [l16]
l21: $ G ⇒ kr_teqv = kr_teqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅) $ by opair_inj_c [l8, l18, l19, l18, l20]
l22: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅) $ by and_elim_r [l21]
l23: $ G ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_tnil , ∅ ⟩ ∅ $ by g2_scons_inj [l22, l12, l14, l11, l15]
l24: $ G ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l23]
l25: $ G ⇒ scons t2 ∅ = scons ⟨ kc_tnil , ∅ ⟩ ∅ $ by and_elim_r [l23]
l26: $ G ⇒ t2 = ⟨ kc_tnil , ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l25, l10, l14, l9, l9]
l27: $ G ⇒ t2 = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l26]
l28: $ G ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩ $ by and_intro [l24, l27]

lemma g2_d_teqv_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_nil ⇒ x ∊ cl_teqv_nil $ by ax
l2: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_nil ⇒ (x = ⟨ ∅ , ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_nil ⇒ x = ⟨ pp , ra_teqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_nil ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_nil ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ = ⟨ ∅ , ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_nil ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_nil ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by g2_e_teqv_nil [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma g2_e_teqv_cons (G: hyps) {F F2 C C2 T T2: set} (pp t1 t2 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ = ⟨ scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) (scons (ra_teqv V5 V6) ∅)) , ra_teqv ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) (scons (ra_teqv V5 V6) ∅)) , ra_teqv ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ⟩ = ⟨ pp , ra_teqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) (scons (ra_teqv V5 V6) ∅))) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_teqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_teqv ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) (scons (ra_teqv V5 V6) ∅)) ∧ ra_teqv t1 t2 = ra_teqv ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) (scons (ra_teqv V5 V6) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_teqv t1 t2 = ra_teqv ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_teqv ∈ ω $ by kr_teqv_omega
l19: $ G ⇒ isset kr_teqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_teqv = kr_teqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) (scons (ra_teqv V5 V6) ∅))) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) (scons (ra_teqv V5 V6) ∅))) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_eeqv V1 V2) $ by opair_isset
l32: $ G ⇒ ra_eeqv V1 V2 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_cseqv V3 V4) (scons (ra_teqv V5 V6) ∅)) ⊆ lrel2 $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_cseqv V3 V4) $ by opair_isset
l35: $ G ⇒ ra_cseqv V3 V4 ∈ lrel2 $ by crn_scons_head [l34, l33]
l36: $ G ⇒ crn (scons (ra_teqv V5 V6) ∅) ⊆ lrel2 $ by crn_scons_tail [l33]
l37: $ G ⇒ isset (ra_teqv V5 V6) $ by opair_isset
l38: $ G ⇒ ra_teqv V5 V6 ∈ lrel2 $ by crn_scons_head [l37, l36]
l39: $ G ⇒ ra_cseqv V3 V4 ∈ lrel2 ∧ ra_teqv V5 V6 ∈ lrel2 $ by and_intro [l35, l38]
l40: $ G ⇒ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 V4 ∈ lrel2 ∧ ra_teqv V5 V6 ∈ lrel2 $ by and_intro [l32, l39]
l41: $ G ⇒ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 V4 ∈ lrel2 ∧ ra_teqv V5 V6 ∈ lrel2 $ by and_intro [l28, l40]
l42: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons V6 ∅)) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 V4 ∈ lrel2 ∧ ra_teqv V5 V6 ∈ lrel2 $ by and_intro [l25, l41]
l43: $ G ⇒ ∃ T2 (t1 = ⟨ kc_tcons , scons V1 (scons V3 (scons V5 ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons T2 ∅)) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 V4 ∈ lrel2 ∧ ra_teqv V5 T2 ∈ lrel2) $ by ex_intro [l42]
l44: $ G ⇒ ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons V1 (scons V3 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons T2 ∅)) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 V4 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_intro [l43]
l45: $ G ⇒ ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons V1 (scons V3 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons V2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_intro [l44]
l46: $ G ⇒ ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons V1 (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons V2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_intro [l45]
l47: $ G ⇒ ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons V1 (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv V1 F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_intro [l46]
l48: $ G ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_intro [l47]

lemma g2_d_teqv_cons (G: hyps) {F F2 C C2 T T2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_cons ⇒ x ∊ cl_teqv_cons $ by ax
l2: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_teqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩ ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by g2_e_teqv_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) (scons (ra_teqv w a) ∅)) , ra_teqv ⟨ kc_tcons , scons y (scons u (scons w ∅)) ⟩ ⟨ kc_tcons , scons z (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_teqv t1 t2 ⟩ , x ∊ cl_teqv_cons ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by wcel_elim [#1, l19]

lemma g2_o_teqv (G: hyps) {F F2 C C2 T T2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ pr_teqv $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $
----
l1: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons $ by ax
l2: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l3: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by g2_d_teqv_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons → ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons $ by ax
l6: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∨ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons $ by g2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil $ by ax
l8: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l9: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by g2_d_teqv_nil [l7, l8]
l10: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons $ by ax
l12: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons → ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_cons ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_teqv t1 t2 ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons → (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by imp_intro [l15]
l17: $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by imp_elim [l16, #1]

lrel2_teqv_cases
----------------
l1: $ G ⇒ isset (ra_teqv t1 t2) $ by opair_isset
l2: $ G , c = ra_teqv t1 t2 ⇒ c = ra_teqv t1 t2 $ by ax
l3: $ G , c = ra_teqv t1 t2 ⇒ ra_teqv t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_teqv t1 t2 ⇒ ra_teqv t1 t2 ∈ lrel2 $ by weaken [#1]
l5: $ G , c = ra_teqv t1 t2 ⇒ c ∈ lrel2 $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_teqv t1 t2 ⇒ c ∊ lrel2 $ by wcel_welc [l5]
l7: $ G , c = ra_teqv t1 t2 ⇒ hprog lprog2 latoms $ by lprog2_hprog
l8: $ G , c = ra_teqv t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2) $ by horn_elim [l7, l6]
l9: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 $ by ax
l10: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 $ by and_elim_l [l9]
l11: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ crn p ⊆ lrel2 $ by and_elim_r [l9]
l12: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ p = p $ by eq_refl
l13: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ c = ra_teqv t1 t2 $ by ax
l14: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ = ⟨ p , ra_teqv t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_teqv t1 t2 ⟩ ∈ lprog2 $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_teqv t1 t2 ⟩ ∈ pr_teqv $ by lprog2_teqv_pr [l15]
l17: $ G , c = ra_teqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by g2_o_teqv [l16, l11]
l18: $ G , c = ra_teqv t1 t2 ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by ex_elim [l8, l17]
l19: $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_tcons , scons F2 (scons C2 (scons T2 ∅)) ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $ by isset_elim [l1, l18]

lemma g2_e_cseqv_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ = ⟨ pp , ra_cseqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cseqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_cseqv t1 t2 = ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_cseqv t1 t2 = ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_cnil , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_cnil , ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l14, l15]
l17: $ G ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l18: $ G ⇒ isset kr_cseqv $ by wcel_isset [l17]
l19: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l20: $ G ⇒ isset (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅)) $ by wcel_isset [l16]
l21: $ G ⇒ kr_cseqv = kr_cseqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) $ by opair_inj_c [l8, l18, l19, l18, l20]
l22: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) $ by and_elim_r [l21]
l23: $ G ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_cnil , ∅ ⟩ ∅ $ by g2_scons_inj [l22, l12, l14, l11, l15]
l24: $ G ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l23]
l25: $ G ⇒ scons t2 ∅ = scons ⟨ kc_cnil , ∅ ⟩ ∅ $ by and_elim_r [l23]
l26: $ G ⇒ t2 = ⟨ kc_cnil , ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l25, l10, l14, l9, l9]
l27: $ G ⇒ t2 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l26]
l28: $ G ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩ $ by and_intro [l24, l27]

lemma g2_d_cseqv_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_nil ⇒ x ∊ cl_cseqv_nil $ by ax
l2: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_nil ⇒ (x = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_nil ⇒ x = ⟨ pp , ra_cseqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_nil ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_nil ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_nil ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_nil ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) $ by g2_e_cseqv_nil [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma g2_e_cseqv_cons (G: hyps) {K K2 C C2: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ = ⟨ scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) ∅) , ra_cseqv ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) ∅) , ra_cseqv ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_cseqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) ∅)) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cseqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_cseqv ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) ∅) ∧ ra_cseqv t1 t2 = ra_cseqv ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_cseqv t1 t2 = ra_cseqv ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l19: $ G ⇒ isset kr_cseqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_cseqv = kr_cseqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) ∅)) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_eeqv V1 V2) (scons (ra_cseqv V3 V4) ∅)) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_eeqv V1 V2) $ by opair_isset
l32: $ G ⇒ ra_eeqv V1 V2 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_cseqv V3 V4) ∅) ⊆ lrel2 $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_cseqv V3 V4) $ by opair_isset
l35: $ G ⇒ ra_cseqv V3 V4 ∈ lrel2 $ by crn_scons_head [l34, l33]
l36: $ G ⇒ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 V4 ∈ lrel2 $ by and_intro [l32, l35]
l37: $ G ⇒ t2 = ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 V4 ∈ lrel2 $ by and_intro [l28, l36]
l38: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons V2 (scons V4 ∅) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 V4 ∈ lrel2 $ by and_intro [l25, l37]
l39: $ G ⇒ ∃ C2 (t1 = ⟨ kc_ccons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons V2 (scons C2 ∅) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv V3 C2 ∈ lrel2) $ by ex_intro [l38]
l40: $ G ⇒ ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons V1 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons V2 (scons C2 ∅) ⟩ ∧ ra_eeqv V1 V2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by ex_intro [l39]
l41: $ G ⇒ ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons V1 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv V1 K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by ex_intro [l40]
l42: $ G ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by ex_intro [l41]

lemma g2_d_cseqv_cons (G: hyps) {K K2 C C2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_cons ⇒ x ∊ cl_cseqv_cons $ by ax
l2: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_cseqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩ ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by g2_e_cseqv_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_eeqv y z) (scons (ra_cseqv u v) ∅) , ra_cseqv ⟨ kc_ccons , scons y (scons u ∅) ⟩ ⟨ kc_ccons , scons z (scons v ∅) ⟩ ⟩) ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_cseqv t1 t2 ⟩ , x ∊ cl_cseqv_cons ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by wcel_elim [#1, l15]

lemma g2_o_cseqv (G: hyps) {K K2 C C2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ pr_cseqv $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $
----
l1: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons $ by ax
l2: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l3: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by g2_d_cseqv_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons → ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons $ by ax
l6: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∨ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons $ by g2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil $ by ax
l8: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l9: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) $ by g2_d_cseqv_nil [l7, l8]
l10: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons $ by ax
l12: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons → ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons ⇒ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_cons ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_cseqv t1 t2 ⟩ ∈ cl_cseqv_nil ∪ cl_cseqv_cons → (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by imp_intro [l15]
l17: $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by imp_elim [l16, #1]

lrel2_cseqv_cases
-----------------
l1: $ G ⇒ isset (ra_cseqv t1 t2) $ by opair_isset
l2: $ G , c = ra_cseqv t1 t2 ⇒ c = ra_cseqv t1 t2 $ by ax
l3: $ G , c = ra_cseqv t1 t2 ⇒ ra_cseqv t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_cseqv t1 t2 ⇒ ra_cseqv t1 t2 ∈ lrel2 $ by weaken [#1]
l5: $ G , c = ra_cseqv t1 t2 ⇒ c ∈ lrel2 $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_cseqv t1 t2 ⇒ c ∊ lrel2 $ by wcel_welc [l5]
l7: $ G , c = ra_cseqv t1 t2 ⇒ hprog lprog2 latoms $ by lprog2_hprog
l8: $ G , c = ra_cseqv t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2) $ by horn_elim [l7, l6]
l9: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 $ by ax
l10: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 $ by and_elim_l [l9]
l11: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ crn p ⊆ lrel2 $ by and_elim_r [l9]
l12: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ p = p $ by eq_refl
l13: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ c = ra_cseqv t1 t2 $ by ax
l14: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ = ⟨ p , ra_cseqv t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_cseqv t1 t2 ⟩ ∈ lprog2 $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_cseqv t1 t2 ⟩ ∈ pr_cseqv $ by lprog2_cseqv_pr [l15]
l17: $ G , c = ra_cseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by g2_o_cseqv [l16, l11]
l18: $ G , c = ra_cseqv t1 t2 ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by ex_elim [l8, l17]
l19: $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_ccons , scons K2 (scons C2 ∅) ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $ by isset_elim [l1, l18]

lemma g2_e_lseqv_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ = ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩ = ⟨ pp , ra_lseqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lseqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_lseqv t1 t2 = ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lseqv t1 t2 = ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_lnil , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_lnil , ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ scons ⟨ kc_lnil , ∅ ⟩ (scons ⟨ kc_lnil , ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l14, l15]
l17: $ G ⇒ kr_lseqv ∈ ω $ by kr_lseqv_omega
l18: $ G ⇒ isset kr_lseqv $ by wcel_isset [l17]
l19: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l20: $ G ⇒ isset (scons ⟨ kc_lnil , ∅ ⟩ (scons ⟨ kc_lnil , ∅ ⟩ ∅)) $ by wcel_isset [l16]
l21: $ G ⇒ kr_lseqv = kr_lseqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_lnil , ∅ ⟩ (scons ⟨ kc_lnil , ∅ ⟩ ∅) $ by opair_inj_c [l8, l18, l19, l18, l20]
l22: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_lnil , ∅ ⟩ (scons ⟨ kc_lnil , ∅ ⟩ ∅) $ by and_elim_r [l21]
l23: $ G ⇒ t1 = ⟨ kc_lnil , ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_lnil , ∅ ⟩ ∅ $ by g2_scons_inj [l22, l12, l14, l11, l15]
l24: $ G ⇒ t1 = ⟨ kc_lnil , ∅ ⟩ $ by and_elim_l [l23]
l25: $ G ⇒ scons t2 ∅ = scons ⟨ kc_lnil , ∅ ⟩ ∅ $ by and_elim_r [l23]
l26: $ G ⇒ t2 = ⟨ kc_lnil , ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l25, l10, l14, l9, l9]
l27: $ G ⇒ t2 = ⟨ kc_lnil , ∅ ⟩ $ by and_elim_l [l26]
l28: $ G ⇒ t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩ $ by and_intro [l24, l27]

lemma g2_d_lseqv_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_nil ⇒ x ∊ cl_lseqv_nil $ by ax
l2: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_nil ⇒ (x = ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_nil ⇒ x = ⟨ pp , ra_lseqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_nil ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_nil ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ = ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_nil ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_nil ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) $ by g2_e_lseqv_nil [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma g2_e_lseqv_cons (G: hyps) {l_v l2 S S2: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ = ⟨ scons (ra_lseqv V3 V4) ∅ , ra_lseqv ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq V1 V2 $ >
  $ G ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $
----
l1: $ G ⇒ ⟨ scons (ra_lseqv V3 V4) ∅ , ra_lseqv ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_lseqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lseqv V3 V4) ∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lseqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_lseqv ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lseqv V3 V4) ∅ ∧ ra_lseqv t1 t2 = ra_lseqv ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lseqv V3 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lseqv t1 t2 = ra_lseqv ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_lseqv ∈ ω $ by kr_lseqv_omega
l19: $ G ⇒ isset kr_lseqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_lseqv = kr_lseqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_lseqv V3 V4) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_lseqv V3 V4) ∅) ⊆ lrel2 $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_lseqv V3 V4) $ by opair_isset
l32: $ G ⇒ ra_lseqv V3 V4 ∈ lrel2 $ by crn_scons_head [l31, l30]
l33: $ G ⇒ lveq V1 V2 ∧ ra_lseqv V3 V4 ∈ lrel2 $ by and_intro [#3, l32]
l34: $ G ⇒ t2 = ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∧ lveq V1 V2 ∧ ra_lseqv V3 V4 ∈ lrel2 $ by and_intro [l28, l33]
l35: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons V2 (scons V4 ∅) ⟩ ∧ lveq V1 V2 ∧ ra_lseqv V3 V4 ∈ lrel2 $ by and_intro [l25, l34]
l36: $ G ⇒ ∃ S2 (t1 = ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons V2 (scons S2 ∅) ⟩ ∧ lveq V1 V2 ∧ ra_lseqv V3 S2 ∈ lrel2) $ by ex_intro [l35]
l37: $ G ⇒ ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons V1 (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons V2 (scons S2 ∅) ⟩ ∧ lveq V1 V2 ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_intro [l36]
l38: $ G ⇒ ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons V1 (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq V1 l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_intro [l37]
l39: $ G ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_intro [l38]

lemma g2_d_lseqv_cons (G: hyps) {l_v l2 S S2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $
----
l1: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_cons ⇒ x ∊ cl_lseqv_cons $ by ax
l2: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ pp , ra_lseqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z $ by ax
l6: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ lveq y z $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l6]
l9: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l10: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by g2_e_lseqv_cons [l8, l9, l7]
l11: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) $ by ax
l12: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) $ by ax
l14: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) $ by ax
l16: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lseqv u v) ∅ , ra_lseqv ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_lcons , scons z (scons v ∅) ⟩ ⟩ ∧ lveq y z) ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_lseqv t1 t2 ⟩ , x ∊ cl_lseqv_cons ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by wcel_elim [#1, l17]

lemma g2_o_lseqv (G: hyps) {l_v l2 S S2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ pr_lseqv $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $
----
l1: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons $ by ax
l2: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l3: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by g2_d_lseqv_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons → ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons $ by ax
l6: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∨ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons $ by g2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil $ by ax
l8: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l9: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) $ by g2_d_lseqv_nil [l7, l8]
l10: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons $ by ax
l12: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons → ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons ⇒ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_cons ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_lseqv t1 t2 ⟩ ∈ cl_lseqv_nil ∪ cl_lseqv_cons → (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by imp_intro [l15]
l17: $ G ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by imp_elim [l16, #1]

lrel2_lseqv_cases
-----------------
l1: $ G ⇒ isset (ra_lseqv t1 t2) $ by opair_isset
l2: $ G , c = ra_lseqv t1 t2 ⇒ c = ra_lseqv t1 t2 $ by ax
l3: $ G , c = ra_lseqv t1 t2 ⇒ ra_lseqv t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_lseqv t1 t2 ⇒ ra_lseqv t1 t2 ∈ lrel2 $ by weaken [#1]
l5: $ G , c = ra_lseqv t1 t2 ⇒ c ∈ lrel2 $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_lseqv t1 t2 ⇒ c ∊ lrel2 $ by wcel_welc [l5]
l7: $ G , c = ra_lseqv t1 t2 ⇒ hprog lprog2 latoms $ by lprog2_hprog
l8: $ G , c = ra_lseqv t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2) $ by horn_elim [l7, l6]
l9: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 $ by ax
l10: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ ∈ lprog2 $ by and_elim_l [l9]
l11: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ crn p ⊆ lrel2 $ by and_elim_r [l9]
l12: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ p = p $ by eq_refl
l13: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ c = ra_lseqv t1 t2 $ by ax
l14: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , c ⟩ = ⟨ p , ra_lseqv t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_lseqv t1 t2 ⟩ ∈ lprog2 $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ ⟨ p , ra_lseqv t1 t2 ⟩ ∈ pr_lseqv $ by lprog2_lseqv_pr [l15]
l17: $ G , c = ra_lseqv t1 t2 , ⟨ p , c ⟩ ∈ lprog2 ∧ crn p ⊆ lrel2 ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by g2_o_lseqv [l16, l11]
l18: $ G , c = ra_lseqv t1 t2 ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by ex_elim [l8, l17]
l19: $ G ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , scons l_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_lcons , scons l2 (scons S2 ∅) ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $ by isset_elim [l1, l18]

lemma g2_e_nst_group_done (G: hyps) {G_v D I X0 j_v ni N: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ = ⟨ ∅ , ra_nst_group V1 V2 V3 V4 V5 V6 V6 V7 V7 ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $
----
l1: $ G ⇒ ⟨ ∅ , ra_nst_group V1 V2 V3 V4 V5 V6 V6 V7 V7 ⟩ = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9) $ by opair_isset
l5: $ G ⇒ isset (ra_nst_group V1 V2 V3 V4 V5 V6 V6 V7 V7) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 = ra_nst_group V1 V2 V3 V4 V5 V6 V6 V7 V7 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 = ra_nst_group V1 V2 V3 V4 V5 V6 V6 V7 V7 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t9 $ by isset_var
l11: $ G ⇒ scons t9 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t8 $ by isset_var
l13: $ G ⇒ scons t8 (scons t9 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset t7 $ by isset_var
l15: $ G ⇒ scons t7 (scons t8 (scons t9 ∅)) ∈ fseq g2_vv $ by g2_fs [l14, l13]
l16: $ G ⇒ isset t6 $ by isset_var
l17: $ G ⇒ scons t6 (scons t7 (scons t8 (scons t9 ∅))) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ isset t5 $ by isset_var
l19: $ G ⇒ scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))) ∈ fseq g2_vv $ by g2_fs [l18, l17]
l20: $ G ⇒ isset t4 $ by isset_var
l21: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))) ∈ fseq g2_vv $ by g2_fs [l20, l19]
l22: $ G ⇒ isset t3 $ by isset_var
l23: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))) ∈ fseq g2_vv $ by g2_fs [l22, l21]
l24: $ G ⇒ isset t2 $ by isset_var
l25: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))))) ∈ fseq g2_vv $ by g2_fs [l24, l23]
l26: $ G ⇒ isset t1 $ by isset_var
l27: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))))) ∈ fseq g2_vv $ by g2_fs [l26, l25]
l28: $ G ⇒ isset V7 $ by isset_var
l29: $ G ⇒ scons V7 ∅ ∈ fseq g2_vv $ by g2_fs [l28, l9]
l30: $ G ⇒ scons V7 (scons V7 ∅) ∈ fseq g2_vv $ by g2_fs [l28, l29]
l31: $ G ⇒ isset V6 $ by isset_var
l32: $ G ⇒ scons V6 (scons V7 (scons V7 ∅)) ∈ fseq g2_vv $ by g2_fs [l31, l30]
l33: $ G ⇒ scons V6 (scons V6 (scons V7 (scons V7 ∅))) ∈ fseq g2_vv $ by g2_fs [l31, l32]
l34: $ G ⇒ isset V5 $ by isset_var
l35: $ G ⇒ scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))) ∈ fseq g2_vv $ by g2_fs [l34, l33]
l36: $ G ⇒ isset V4 $ by isset_var
l37: $ G ⇒ scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅))))) ∈ fseq g2_vv $ by g2_fs [l36, l35]
l38: $ G ⇒ isset V3 $ by isset_var
l39: $ G ⇒ scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))))) ∈ fseq g2_vv $ by g2_fs [l38, l37]
l40: $ G ⇒ isset V2 $ by isset_var
l41: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅))))))) ∈ fseq g2_vv $ by g2_fs [l40, l39]
l42: $ G ⇒ isset V1 $ by isset_var
l43: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))))))) ∈ fseq g2_vv $ by g2_fs [l42, l41]
l44: $ G ⇒ kr_nst_group ∈ ω $ by kr_nst_group_omega
l45: $ G ⇒ isset kr_nst_group $ by wcel_isset [l44]
l46: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))))))) $ by wcel_isset [l27]
l47: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅))))))))) $ by wcel_isset [l43]
l48: $ G ⇒ kr_nst_group = kr_nst_group ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))))))) $ by opair_inj_c [l8, l45, l46, l45, l47]
l49: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))))))) $ by and_elim_r [l48]
l50: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅))))))) $ by g2_scons_inj [l49, l26, l42, l25, l41]
l51: $ G ⇒ t1 = V1 $ by and_elim_l [l50]
l52: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅))))))) $ by and_elim_r [l50]
l53: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))))) $ by g2_scons_inj [l52, l24, l40, l23, l39]
l54: $ G ⇒ t2 = V2 $ by and_elim_l [l53]
l55: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))))) $ by and_elim_r [l53]
l56: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))) = scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅))))) $ by g2_scons_inj [l55, l22, l38, l21, l37]
l57: $ G ⇒ t3 = V3 $ by and_elim_l [l56]
l58: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))) = scons V4 (scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅))))) $ by and_elim_r [l56]
l59: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))) = scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))) $ by g2_scons_inj [l58, l20, l36, l19, l35]
l60: $ G ⇒ t4 = V4 $ by and_elim_l [l59]
l61: $ G ⇒ scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))) = scons V5 (scons V6 (scons V6 (scons V7 (scons V7 ∅)))) $ by and_elim_r [l59]
l62: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 (scons t8 (scons t9 ∅))) = scons V6 (scons V6 (scons V7 (scons V7 ∅))) $ by g2_scons_inj [l61, l18, l34, l17, l33]
l63: $ G ⇒ t5 = V5 $ by and_elim_l [l62]
l64: $ G ⇒ scons t6 (scons t7 (scons t8 (scons t9 ∅))) = scons V6 (scons V6 (scons V7 (scons V7 ∅))) $ by and_elim_r [l62]
l65: $ G ⇒ t6 = V6 ∧ scons t7 (scons t8 (scons t9 ∅)) = scons V6 (scons V7 (scons V7 ∅)) $ by g2_scons_inj [l64, l16, l31, l15, l32]
l66: $ G ⇒ t6 = V6 $ by and_elim_l [l65]
l67: $ G ⇒ scons t7 (scons t8 (scons t9 ∅)) = scons V6 (scons V7 (scons V7 ∅)) $ by and_elim_r [l65]
l68: $ G ⇒ t7 = V6 ∧ scons t8 (scons t9 ∅) = scons V7 (scons V7 ∅) $ by g2_scons_inj [l67, l14, l31, l13, l30]
l69: $ G ⇒ t7 = V6 $ by and_elim_l [l68]
l70: $ G ⇒ scons t8 (scons t9 ∅) = scons V7 (scons V7 ∅) $ by and_elim_r [l68]
l71: $ G ⇒ t8 = V7 ∧ scons t9 ∅ = scons V7 ∅ $ by g2_scons_inj [l70, l12, l28, l11, l29]
l72: $ G ⇒ t8 = V7 $ by and_elim_l [l71]
l73: $ G ⇒ scons t9 ∅ = scons V7 ∅ $ by and_elim_r [l71]
l74: $ G ⇒ t9 = V7 ∧ ∅ = ∅ $ by g2_scons_inj [l73, l10, l28, l9, l9]
l75: $ G ⇒ t9 = V7 $ by and_elim_l [l74]
l76: $ G ⇒ t8 = V7 ∧ t9 = V7 $ by and_intro [l72, l75]
l77: $ G ⇒ t7 = V6 ∧ t8 = V7 ∧ t9 = V7 $ by and_intro [l69, l76]
l78: $ G ⇒ t6 = V6 ∧ t7 = V6 ∧ t8 = V7 ∧ t9 = V7 $ by and_intro [l66, l77]
l79: $ G ⇒ t5 = V5 ∧ t6 = V6 ∧ t7 = V6 ∧ t8 = V7 ∧ t9 = V7 $ by and_intro [l63, l78]
l80: $ G ⇒ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = V6 ∧ t8 = V7 ∧ t9 = V7 $ by and_intro [l60, l79]
l81: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = V6 ∧ t8 = V7 ∧ t9 = V7 $ by and_intro [l57, l80]
l82: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = V6 ∧ t8 = V7 ∧ t9 = V7 $ by and_intro [l54, l81]
l83: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = V6 ∧ t8 = V7 ∧ t9 = V7 $ by and_intro [l51, l82]
l84: $ G ⇒ ∃ N (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = V6 ∧ t8 = N ∧ t9 = N) $ by ex_intro [l83]
l85: $ G ⇒ ∃ ni ∃ N (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_intro [l84]
l86: $ G ⇒ ∃ j_v ∃ ni ∃ N (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_intro [l85]
l87: $ G ⇒ ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_intro [l86]
l88: $ G ⇒ ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = V1 ∧ t2 = V2 ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_intro [l87]
l89: $ G ⇒ ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = V1 ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_intro [l88]
l90: $ G ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_intro [l89]

lemma g2_d_nst_group_done (G: hyps) {G_v D I X0 j_v ni N: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9: set):
  $ G ⇒ ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ cl_nst_group_done $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $
----
l1: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x ∊ cl_nst_group_done ⇒ x ∊ cl_nst_group_done $ by ax
l2: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x ∊ cl_nst_group_done ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩ ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by g2_e_nst_group_done [l6, l7]
l9: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ ∅ , ra_nst_group y z u v w a a b b ⟩) ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) $ by ex_elim [l19, l18]
