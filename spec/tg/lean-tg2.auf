lemma g1_pr_ceqv (G: hyps) (X: class): $ G ⇒ X ∈ pr_ceqv $ > $ G ⇒ X ∈ g1_top $
----
l1: $ G ⇒ X ∈ pr_ind_eqv ∪ pr_ceqv $ by g1_in_r [#1]
l2: $ G ⇒ X ∈ (pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv) $ by g1_in_r [l1]
l3: $ G ⇒ X ∈ ((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group)) $ by g1_in_l [l2]

lemma g1_ra_ceqv (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_ceqv A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_ceqv ∈ ω $ by kr_ceqv_omega
l5: $ G ⇒ ra_ceqv A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lrel2_ceqv_nil
--------------
l1: $ G , x = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l2: $ G , x = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ cl_ceqv_nil $ by cab_intro [l1]
l3: $ G , x = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ceqv_nil $ by wcel_intro [l1, l2]
l4: $ G ⇒ isset ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by opair_isset
l5: $ G ⇒ ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ceqv_nil $ by isset_elim [l4, l3]
l6: $ G ⇒ ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ceqv_nil ∪ cl_ceqv_cons $ by g1_in_l [l5]
l7: $ G ⇒ ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ∈ g1_top $ by g1_pr_ceqv [l6]
l8: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l9: $ G ⇒ crn ∅ ⊆ lrel2 $ by crn_empty_sub
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ kc_nil ∈ ω $ by kc_nil_omega
l12: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l13: $ G ⇒ ⟨ kc_nil , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l10, l11, l12]
l14: $ G ⇒ ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ∈ latoms $ by g1_ra_ceqv [l13, l13]
l15: $ G ⇒ ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ∈ lrel2 $ by g1_horn [l7, l8, l14, l9]

lrel2_ceqv_cons
