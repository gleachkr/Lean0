l5: $ G , y = A1 , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ ⟨ ∅ , ra_eeqv y y ⟩ ∈ cl_eeqv_refl $ by wcel_intro [l2, l4]
l6: $ G , y = A1 ⇒ isset ⟨ ∅ , ra_eeqv y y ⟩ $ by opair_isset
l7: $ G , y = A1 ⇒ ⟨ ∅ , ra_eeqv y y ⟩ ∈ cl_eeqv_refl $ by isset_elim [l6, l5]
l8: $ G , y = A1 ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , y = A1 ⇒ ra_eeqv y y = ra_eeqv A1 A1 $ by ra_eeqv_eq [l1, l1]
l10: $ G , y = A1 ⇒ ⟨ ∅ , ra_eeqv y y ⟩ = ⟨ ∅ , ra_eeqv A1 A1 ⟩ $ by opair_eq [l8, l9]
l11: $ G , y = A1 ⇒ ⟨ ∅ , ra_eeqv A1 A1 ⟩ ∈ cl_eeqv_refl $ by wcel_eq_l [l10, l7]
l12: $ G ⇒ isset A1 $ by wcel_isset [#1]
l13: $ G ⇒ ⟨ ∅ , ra_eeqv A1 A1 ⟩ ∈ cl_eeqv_refl $ by isset_elim [l12, l11]
l14: $ G ⇒ ⟨ ∅ , ra_eeqv A1 A1 ⟩ ∈ cl_eeqv_refl ∪ (cl_eeqv_bvar ∪ (cl_eeqv_srt ∪ (cl_eeqv_app ∪ (cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ (cl_eeqv_proj ∪ (cl_eeqv_quot ∪ (cl_eeqv_quot_mk ∪ (cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind)))))))))))))) $ by g1_in_l [l13]
l15: $ G ⇒ ⟨ ∅ , ra_eeqv A1 A1 ⟩ ∈ g1_top $ by g1_pr_eeqv [l14]
l16: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l17: $ G ⇒ crn ∅ ⊆ lrel2 $ by crn_empty_sub
l18: $ G ⇒ ra_eeqv A1 A1 ∈ latoms $ by g1_ra_eeqv [#1, #1]
l19: $ G ⇒ ra_eeqv A1 A1 ∈ lrel2 $ by g1_horn [l15, l16, l18, l17]

