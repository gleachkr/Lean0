l3: $ G ⇒ scons A1 (scons A2 ∅) = scons B1 (scons B2 ∅) $ by scons_eq [#1, l2]
l4: $ G ⇒ kr_eeqv = kr_eeqv $ by eq_refl
l5: $ G ⇒ ⟨ kr_eeqv , scons A1 (scons A2 ∅) ⟩ = ⟨ kr_eeqv , scons B1 (scons B2 ∅) ⟩ $ by opair_eq [l4, l3]

