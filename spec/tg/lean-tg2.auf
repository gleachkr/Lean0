l3: $ scons A1 (scons A2 ∅) ≐ scons B1 (scons B2 ∅) $ by scons_congr [#1, l2]
l4: $ kr_eeqv ≐ kr_eeqv $ by ceqt_refl
l5: $ ⟨ kr_eeqv , scons A1 (scons A2 ∅) ⟩ ≐ ⟨ kr_eeqv , scons B1 (scons B2 ∅) ⟩ $ by opair_congr [l4, l3]

