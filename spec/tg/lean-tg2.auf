l48: $ G ⇒ ⟨ scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) (scons (ra_teqv A5 A6) ∅)) , ra_teqv ⟨ kc_tcons , scons A1 (scons A3 (scons A5 ∅)) ⟩ ⟨ kc_tcons , scons A2 (scons A4 (scons A6 ∅)) ⟩ ⟩ ∈ cl_teqv_cons $ by isset_elim [l47, l46]
l49: $ G ⇒ ⟨ scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) (scons (ra_teqv A5 A6) ∅)) , ra_teqv ⟨ kc_tcons , scons A1 (scons A3 (scons A5 ∅)) ⟩ ⟨ kc_tcons , scons A2 (scons A4 (scons A6 ∅)) ⟩ ⟩ ∈ cl_teqv_nil ∪ cl_teqv_cons $ by g1_in_r [l48]
l50: $ G ⇒ ⟨ scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) (scons (ra_teqv A5 A6) ∅)) , ra_teqv ⟨ kc_tcons , scons A1 (scons A3 (scons A5 ∅)) ⟩ ⟨ kc_tcons , scons A2 (scons A4 (scons A6 ∅)) ⟩ ⟩ ∈ g1_top $ by g1_pr_teqv [l49]
l51: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l52: $ G ⇒ crn ∅ ⊆ lrel2 $ by crn_empty_sub
l53: $ G ⇒ (ra_teqv A5 A6) ∈ latoms $ by g1_lrel2_lat [#9]
l54: $ G ⇒ scons (ra_teqv A5 A6) ∅ ∈ fseq latoms $ by scons_fseq_c [l53, l51]
l55: $ G ⇒ crn (scons (ra_teqv A5 A6) ∅) ⊆ lrel2 $ by crn_scons_sub [#9, l52]
l56: $ G ⇒ (ra_cseqv A3 A4) ∈ latoms $ by g1_lrel2_lat [#8]
l57: $ G ⇒ scons (ra_cseqv A3 A4) (scons (ra_teqv A5 A6) ∅) ∈ fseq latoms $ by scons_fseq_c [l56, l54]
l58: $ G ⇒ crn (scons (ra_cseqv A3 A4) (scons (ra_teqv A5 A6) ∅)) ⊆ lrel2 $ by crn_scons_sub [#8, l55]
l59: $ G ⇒ (ra_eeqv A1 A2) ∈ latoms $ by g1_lrel2_lat [#7]
l60: $ G ⇒ scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) (scons (ra_teqv A5 A6) ∅)) ∈ fseq latoms $ by scons_fseq_c [l59, l57]
l61: $ G ⇒ crn (scons (ra_eeqv A1 A2) (scons (ra_cseqv A3 A4) (scons (ra_teqv A5 A6) ∅))) ⊆ lrel2 $ by crn_scons_sub [#7, l58]
l62: $ G ⇒ isset ω $ by omega_set
l63: $ G ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
l64: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l65: $ G ⇒ scons A5 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#5, l64]
l66: $ G ⇒ scons A3 (scons A5 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#3, l65]
l67: $ G ⇒ scons A1 (scons A3 (scons A5 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l66]
l68: $ G ⇒ ⟨ kc_tcons , scons A1 (scons A3 (scons A5 ∅)) ⟩ ∈ trees ω $ by trees_intro_c [l62, l63, l67]
l69: $ G ⇒ scons A6 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#6, l64]
l70: $ G ⇒ scons A4 (scons A6 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#4, l69]
l71: $ G ⇒ scons A2 (scons A4 (scons A6 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l70]
