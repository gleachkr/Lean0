l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ lveq y u ∧ lveq z v $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ lveq y u $ by and_elim_l [l7]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ lveq z v $ by and_elim_r [l7]
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l6]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $ by g2_e_eeqv_quot_lift [l10, l11, l8, l9]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) $ by ax
l14: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) $ by ax
l16: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) $ by ax
l18: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟨ kc_quot_lift , scons u (scons v ∅) ⟩ ⟩ ∧ lveq y u ∧ lveq z v) ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot_lift ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $ by wcel_elim [#1, l19]

lemma g2_e_eeqv_quot_ind (G: hyps) {u_v u2: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons V1 ∅ ⟩ ⟨ kc_quot_ind , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel2 $ > $ G ⇒ lveq V1 V2 $ >
  $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $
----
l1: $ G ⇒ ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons V1 ∅ ⟩ ⟨ kc_quot_ind , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by g2_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eeqv t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eeqv ⟨ kc_quot_ind , scons V1 ∅ ⟩ ⟨ kc_quot_ind , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_quot_ind , scons V1 ∅ ⟩ ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_eeqv t1 t2 = ra_eeqv ⟨ kc_quot_ind , scons V1 ∅ ⟩ ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq g2_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq g2_vv $ by g2_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq g2_vv $ by g2_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅ ∈ fseq g2_vv $ by g2_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_quot_ind , scons V1 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_quot_ind , scons V1 ∅ ⟩ (scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅) ∈ fseq g2_vv $ by g2_fs [l16, l15]
l18: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l19: $ G ⇒ isset kr_eeqv $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_quot_ind , scons V1 ∅ ⟩ (scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eeqv = kr_eeqv ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_quot_ind , scons V1 ∅ ⟩ (scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_quot_ind , scons V1 ∅ ⟩ (scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_quot_ind , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅ $ by g2_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_quot_ind , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by g2_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t2 = ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∧ lveq V1 V2 $ by and_intro [l28, #3]
l30: $ G ⇒ t1 = ⟨ kc_quot_ind , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∧ lveq V1 V2 $ by and_intro [l25, l29]
l31: $ G ⇒ ∃ u2 (t1 = ⟨ kc_quot_ind , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq V1 u2) $ by ex_intro [l30]
l32: $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_intro [l31]

lemma g2_d_eeqv_quot_ind (G: hyps) {u_v u2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $
----
l1: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot_ind ⇒ x ∊ cl_eeqv_quot_ind $ by ax
l2: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot_ind ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ pp , ra_eeqv t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z $ by ax
l6: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ $ by and_elim_l [l5]
l7: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ lveq y z $ by and_elim_r [l5]
l8: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l6]
l9: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l10: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by g2_e_eeqv_quot_ind [l8, l9, l7]
l11: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z) $ by ax
l12: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_eeqv ⟨ kc_quot_ind , scons y ∅ ⟩ ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ∧ lveq y z) ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eeqv t1 t2 ⟩ , x ∊ cl_eeqv_quot_ind ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by wcel_elim [#1, l13]

lemma g2_o_eeqv (G: hyps) {e_v i_v l_v l2 f_v a_v f2 a2 A b_v A2 b2 n_v S S2 D D2 c_v v_v v2 e2 u_v u2: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ pr_eeqv $ > $ G ⇒ crn pp ⊆ lrel2 $ >
  $ G ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) ∨ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩) ∨ ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_srt , scons l2 ∅ ⟩ ∧ lveq l_v l2) ∨ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t2 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_cst , scons a_v (scons S2 ∅) ⟩ ∧ ra_lseqv S S2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ ∧ t2 = ⟨ kc_ind_ty , scons D2 (scons i_v ∅) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_ctor , scons D2 (scons i_v (scons c_v ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨ ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ ∧ t2 = ⟨ kc_ind_rec , scons D2 (scons i_v (scons v2 ∅)) ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) ∨ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_mk , scons u2 ∅ ⟩ ∧ lveq u_v u2) ∨ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $
----
l1: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind $ by ax
l2: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l3: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind ⇒ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by g2_d_eeqv_quot_ind [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind → ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind $ by ax
l6: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∨ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind $ by g2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift $ by ax
l8: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ⇒ crn pp ⊆ lrel2 $ by weaken [#2]
l9: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) $ by g2_d_eeqv_quot_lift [l7, l8]
l10: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ⇒ ∃ u_v ∃ v_v ∃ u2 ∃ v2 (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩ ∧ t2 = ⟨ kc_quot_lift , scons u2 (scons v2 ∅) ⟩ ∧ lveq u_v u2 ∧ lveq v_v v2) ∨ ∃ u_v ∃ u2 (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩ ∧ t2 = ⟨ kc_quot_ind , scons u2 ∅ ⟩ ∧ lveq u_v u2) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_lift ∪ cl_eeqv_quot_ind , ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind ⇒ ⟨ pp , ra_eeqv t1 t2 ⟩ ∈ cl_eeqv_quot_ind $ by ax
