ra_nst_group_congr
------------------
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A9 ∅ ≐ scons B9 ∅ $ by scons_congr [#9, l1]
l3: $ scons A8 (scons A9 ∅) ≐ scons B8 (scons B9 ∅) $ by scons_congr [#8, l2]
l4: $ scons A7 (scons A8 (scons A9 ∅)) ≐ scons B7 (scons B8 (scons B9 ∅)) $ by scons_congr [#7, l3]
l5: $ scons A6 (scons A7 (scons A8 (scons A9 ∅))) ≐ scons B6 (scons B7 (scons B8 (scons B9 ∅))) $ by scons_congr [#6, l4]
l6: $ scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))) ≐ scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅)))) $ by scons_congr [#5, l5]
l7: $ scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅))))) ≐ scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅))))) $ by scons_congr [#4, l6]
l8: $ scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))) ≐ scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅)))))) $ by scons_congr [#3, l7]
l9: $ scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅))))))) ≐ scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅))))))) $ by scons_congr [#2, l8]
l10: $ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))))) ≐ scons B1 (scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅)))))))) $ by scons_congr [#1, l9]
l11: $ kr_nst_group ≐ kr_nst_group $ by ceqt_refl
l12: $ ⟨ kr_nst_group , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))))) ⟩ ≐ ⟨ kr_nst_group , scons B1 (scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅)))))))) ⟩ $ by opair_congr [l11, l10]

ra_nst_group_eq
---------------
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A9 ∅ = scons B9 ∅ $ by scons_eq [#9, l1]
l3: $ G ⇒ scons A8 (scons A9 ∅) = scons B8 (scons B9 ∅) $ by scons_eq [#8, l2]
l4: $ G ⇒ scons A7 (scons A8 (scons A9 ∅)) = scons B7 (scons B8 (scons B9 ∅)) $ by scons_eq [#7, l3]
l5: $ G ⇒ scons A6 (scons A7 (scons A8 (scons A9 ∅))) = scons B6 (scons B7 (scons B8 (scons B9 ∅))) $ by scons_eq [#6, l4]
l6: $ G ⇒ scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))) = scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅)))) $ by scons_eq [#5, l5]
l7: $ G ⇒ scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅))))) = scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅))))) $ by scons_eq [#4, l6]
l8: $ G ⇒ scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))) = scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅)))))) $ by scons_eq [#3, l7]
l9: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅))))))) = scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅))))))) $ by scons_eq [#2, l8]
l10: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))))) = scons B1 (scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅)))))))) $ by scons_eq [#1, l9]
l11: $ G ⇒ kr_nst_group = kr_nst_group $ by eq_refl
l12: $ G ⇒ ⟨ kr_nst_group , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))))) ⟩ = ⟨ kr_nst_group , scons B1 (scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 ∅)))))))) ⟩ $ by opair_eq [l11, l10]

sb_c_ra_nst_group
-----------------
l1: $ (⟦ x / t ⟧ ⟨ kr_nst_group , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))))) ⟩) ≐ ⟨ kr_nst_group , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) (scons (⟦ x / t ⟧ A6) (scons (⟦ x / t ⟧ A7) (scons (⟦ x / t ⟧ A8) (scons (⟦ x / t ⟧ A9) ∅)))))))) ⟩ $ by ceqt_refl

--| The atoms are a set.
lemma g1_latoms_set (G: hyps): $ G ⇒ isset latoms $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset (trees ω) $ by trees_set_c [l1]
l3: $ G ⇒ isset (fseq (trees ω)) $ by fseq_set [l2]
l4: $ G ⇒ isset latoms $ by cxp_set [l1, l3]

lprog2_hprog
------------
l1: $ G ⇒ isset latoms $ by g1_latoms_set
l2: $ G ⇒ hprog lprog2 latoms $ by hprog_cin [l1]

lemma g1_in_l (G: hyps) (X A B: class): $ G ⇒ X ∈ A $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ A ⊆ A ∪ B $ by cun_subset_l
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

--| The union of the program's clauses, before the restriction to atoms.
def g1_top: class = $ ((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group)) $

lemma g1_pr_ulevel (G: hyps) (X: class): $ G ⇒ X ∈ pr_ulevel $ > $ G ⇒ X ∈ g1_top $
----
l1: $ G ⇒ X ∈ pr_ulevel ∪ pr_eeqv $ by g1_in_l [#1]
l2: $ G ⇒ X ∈ (pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv) $ by g1_in_l [l1]
l3: $ G ⇒ X ∈ ((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group)) $ by g1_in_l [l2]

lemma g1_ra_ulevel (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_ulevel A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_ulevel ∈ ω $ by kr_ulevel_omega
l5: $ G ⇒ ra_ulevel A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

--| A clause of the union whose premises are derivable.
lemma g1_horn (G: hyps) (P C: class):
  $ G ⇒ ⟨ P , C ⟩ ∈ g1_top $ > $ G ⇒ P ∈ fseq latoms $ > $ G ⇒ C ∈ latoms $ >
  $ G ⇒ crn P ⊆ lrel2 $ > $ G ⇒ C ∈ lrel2 $
----
l1: $ G ⇒ ⟨ P , C ⟩ ∈ fseq latoms × latoms $ by cxp_intro_c [#2, #3]
l2: $ G ⇒ ⟨ P , C ⟩ ∈ lprog2 $ by wcel_cin [#1, l1]
l3: $ G ⇒ hprog lprog2 latoms $ by lprog2_hprog
l4: $ G ⇒ isset P $ by wcel_isset [#2]
l5: $ G ⇒ isset C $ by wcel_isset [#3]
l6: $ G ⇒ C ∈ lrel2 $ by horn_intro_c [l3, l2, l4, l5, #4]

lrel2_ulevel_prop
-----------------
l1: $ G , y = A1 , z = A2 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 ⇒ lveq A1 ⟨ kc_lz , ∅ ⟩ $ by weaken [#3]
l4: $ G , y = A1 , z = A2 ⇒ A1 = y $ by eq_sym [l1]
l5: $ G , y = A1 , z = A2 ⇒ ⟨ kc_lz , ∅ ⟩ = ⟨ kc_lz , ∅ ⟩ $ by eq_refl
l6: $ G , y = A1 , z = A2 ⇒ lveq y ⟨ kc_lz , ∅ ⟩ $ by lveq_eq [l4, l5, l3]
l7: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ $ by ax
l8: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ lveq y ⟨ kc_lz , ∅ ⟩ $ by weaken [l6]
l9: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩ $ by and_intro [l7, l8]
l10: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l9]
l11: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq y ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l10]
l12: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ x ∊ cl_ulevel_prop $ by cab_intro [l11]
l13: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ ⟨ ∅ , ra_ulevel y z ⟩ ∈ cl_ulevel_prop $ by wcel_intro [l7, l12]
l14: $ G , y = A1 , z = A2 ⇒ isset ⟨ ∅ , ra_ulevel y z ⟩ $ by opair_isset
l15: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_ulevel y z ⟩ ∈ cl_ulevel_prop $ by isset_elim [l14, l13]
l16: $ G , y = A1 , z = A2 ⇒ ∅ = ∅ $ by eq_refl
l17: $ G , y = A1 , z = A2 ⇒ ra_ulevel y z = ra_ulevel A1 A2 $ by ra_ulevel_eq [l1, l2]
l18: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_ulevel y z ⟩ = ⟨ ∅ , ra_ulevel A1 A2 ⟩ $ by opair_eq [l16, l17]
l19: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ cl_ulevel_prop $ by wcel_eq_l [l18, l15]
l20: $ G ⇒ isset A2 $ by wcel_isset [#2]
l21: $ G , y = A1 ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ cl_ulevel_prop $ by isset_elim [l20, l19]
l22: $ G ⇒ isset A1 $ by wcel_isset [#1]
l23: $ G ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ cl_ulevel_prop $ by isset_elim [l22, l21]
l24: $ G ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le $ by g1_in_l [l23]
l25: $ G ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ g1_top $ by g1_pr_ulevel [l24]
l26: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l27: $ G ⇒ crn ∅ ⊆ lrel2 $ by crn_empty_sub
l28: $ G ⇒ ra_ulevel A1 A2 ∈ latoms $ by g1_ra_ulevel [#1, #2]
l29: $ G ⇒ ra_ulevel A1 A2 ∈ lrel2 $ by g1_horn [l25, l26, l28, l27]

lemma g1_in_r (G: hyps) (X A B: class): $ G ⇒ X ∈ B $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ B ⊆ A ∪ B $ by cun_subset_r
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

lrel2_ulevel_le
---------------
l1: $ G , y = A1 , z = A2 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 ⇒ lveq ⟨ kc_lmax , scons A1 (scons A2 ∅) ⟩ A1 $ by weaken [#3]
l4: $ G , y = A1 , z = A2 ⇒ kc_lmax = kc_lmax $ by eq_refl
l5: $ G , y = A1 , z = A2 ⇒ ∅ = ∅ $ by eq_refl
l6: $ G , y = A1 , z = A2 ⇒ scons z ∅ = scons A2 ∅ $ by scons_eq [l2, l5]
l7: $ G , y = A1 , z = A2 ⇒ scons y (scons z ∅) = scons A1 (scons A2 ∅) $ by scons_eq [l1, l6]
l8: $ G , y = A1 , z = A2 ⇒ ⟨ kc_lmax , scons y (scons z ∅) ⟩ = ⟨ kc_lmax , scons A1 (scons A2 ∅) ⟩ $ by opair_eq [l4, l7]
l9: $ G , y = A1 , z = A2 ⇒ ⟨ kc_lmax , scons A1 (scons A2 ∅) ⟩ = ⟨ kc_lmax , scons y (scons z ∅) ⟩ $ by eq_sym [l8]
l10: $ G , y = A1 , z = A2 ⇒ A1 = y $ by eq_sym [l1]
l11: $ G , y = A1 , z = A2 ⇒ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y $ by lveq_eq [l9, l10, l3]
l12: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ $ by ax
l13: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y $ by weaken [l11]
l14: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y $ by and_intro [l12, l13]
l15: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) $ by ex_intro [l14]
l16: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_ulevel y z ⟩ ∧ lveq ⟨ kc_lmax , scons y (scons z ∅) ⟩ y) $ by ex_intro [l15]
l17: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ x ∊ cl_ulevel_le $ by cab_intro [l16]
l18: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_ulevel y z ⟩ ⇒ ⟨ ∅ , ra_ulevel y z ⟩ ∈ cl_ulevel_le $ by wcel_intro [l12, l17]
l19: $ G , y = A1 , z = A2 ⇒ isset ⟨ ∅ , ra_ulevel y z ⟩ $ by opair_isset
l20: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_ulevel y z ⟩ ∈ cl_ulevel_le $ by isset_elim [l19, l18]
l21: $ G , y = A1 , z = A2 ⇒ ra_ulevel y z = ra_ulevel A1 A2 $ by ra_ulevel_eq [l1, l2]
l22: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_ulevel y z ⟩ = ⟨ ∅ , ra_ulevel A1 A2 ⟩ $ by opair_eq [l5, l21]
l23: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ cl_ulevel_le $ by wcel_eq_l [l22, l20]
l24: $ G ⇒ isset A2 $ by wcel_isset [#2]
l25: $ G , y = A1 ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ cl_ulevel_le $ by isset_elim [l24, l23]
l26: $ G ⇒ isset A1 $ by wcel_isset [#1]
l27: $ G ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ cl_ulevel_le $ by isset_elim [l26, l25]
l28: $ G ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ cl_ulevel_prop ∪ cl_ulevel_le $ by g1_in_r [l27]
l29: $ G ⇒ ⟨ ∅ , ra_ulevel A1 A2 ⟩ ∈ g1_top $ by g1_pr_ulevel [l28]
l30: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l31: $ G ⇒ crn ∅ ⊆ lrel2 $ by crn_empty_sub
l32: $ G ⇒ ra_ulevel A1 A2 ∈ latoms $ by g1_ra_ulevel [#1, #2]
l33: $ G ⇒ ra_ulevel A1 A2 ∈ lrel2 $ by g1_horn [l29, l30, l32, l31]

lemma g1_pr_eeqv (G: hyps) (X: class): $ G ⇒ X ∈ pr_eeqv $ > $ G ⇒ X ∈ g1_top $
----
l1: $ G ⇒ X ∈ pr_ulevel ∪ pr_eeqv $ by g1_in_r [#1]
l2: $ G ⇒ X ∈ (pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv) $ by g1_in_l [l1]
l3: $ G ⇒ X ∈ ((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group)) $ by g1_in_l [l2]

lemma g1_ra_eeqv (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l5: $ G ⇒ ra_eeqv A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lrel2_eeqv_refl
---------------
l1: $ G , y = A1 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ x = ⟨ ∅ , ra_eeqv y y ⟩ $ by ax
l3: $ G , y = A1 , x = ⟨ ∅ , ra_eeqv y y ⟩ ⇒ ∃ y (x = ⟨ ∅ , ra_eeqv y y ⟩) $ by ex_intro [l2]
