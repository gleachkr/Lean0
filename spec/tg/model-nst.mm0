-- --------------------------------------------------------------------------
-- Nested blocks (E7): the computation rule from the rule's premises, at every block
-- --------------------------------------------------------------------------

--| The rule `ind_iota` in the model from the rule's premises, at every block (nested occurrences or not), for a hook with
--| `hctor` and `hrec` that is invariant under `eeqv`: the recursor applied to its arguments and the major premise has the
--| value of the rule's right-hand side `trhs` (built from the restored `rec_rhs`), an element of the type's value. `ind_arity`
--| and `ctor_ty` inverted and identified; the rule's `spine Y maj nf` is not needed; sort hypotheses on the rule's terms.
theorem ind_iota_all (G: hyps) (H J: class) (u w r tg td td2 tv ti tc tnp tn tm tCT tni te4 tks tmj tnq tY trhs0 tnf trhs ta ta0 te3 tR0 tRT tTY tC tT tT2 tN tRh tRr: set):
  $ G ⇒ iwf u H J tg td w r $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ hrec ⊆ H $ >
  $ G ⇒ minv (mcv H) $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ te4 tks ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ctor , scons td2 (scons ti (scons tc ∅)) ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ ra_rec_rhs td tv ti tc tRh ∈ lrel $ >
  $ G ⇒ ra_add tnp tn ta0 ∈ lrel $ >
  $ G ⇒ ra_add ta0 tm ta ∈ lrel $ >
  $ G ⇒ ra_nidx td ti tni ∈ lrel $ >
  $ G ⇒ ra_add ta tni tks ∈ lrel $ >
  $ G ⇒ ra_nfields td ti tc tnf ∈ lrel $ >
  $ G ⇒ ra_add tnp tnf tnq ∈ lrel $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tRr ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_spine te3 te4 tni ∈ lrel $ >
  $ G ⇒ ra_rehead tY trhs0 tnf tmj trhs ∈ lrel $ >
  $ G ⇒ ra_rec_ty td tv ti tR0 ∈ lrel $ >
  $ G ⇒ tR0 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_sty tg ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tRT te4 ⟨ kc_pi , scons tTY (scons tC ∅) ⟩ ∈ lrel3 J $ >
  $ G ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ tC tmj tT ∈ lrel $ >
  $ G ⇒ ra_eeqv ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ ⟨ kc_ind_ctor , scons td2 (scons ti (scons tc ∅)) ⟩ ∈ lrel2 $ >
  $ G ⇒ ra_sty tg ⟨ kc_ind_ctor , scons td2 (scons ti (scons tc ∅)) ⟩ tCT tmj tT2 ∈ lrel3 J $ >
  $ G ⇒ ra_aeq tg tT2 tTY ∈ lrel3 J $ >
  $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ tc ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ tRh ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_rst td tN tR0 tRT ∈ lrel $ >
  $ G ⇒ ra_ind_nested td tN ∈ lrel $ >
  $ G ⇒ ra_ind_arity td tnp tn tm ∈ lrel $ >
  $ G ⇒ ra_ctor_ty td ti tc tCT ∈ lrel $ >
  $ G ⇒ ra_rst td tN tRh tRr ∈ lrel $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) tT w r $;

-- --------------------------------------------------------------------------
-- Nested blocks (E7): the computation rule at an auxiliary type, the major premise built with the nested block's constructor
-- --------------------------------------------------------------------------

-- --------------------------------------------------------------------------
-- Nested blocks (E7): a specialized constructor has as many binders as the nested block's
-- --------------------------------------------------------------------------

-- --------------------------------------------------------------------------
-- Nested blocks (E7): the computation rule at an auxiliary type with the nested block's constructor (the core)
-- --------------------------------------------------------------------------

--| The rule `ind_iota_nst` in the model from the rule's premises: the recursor of an auxiliary type applied to its
--| arguments and a major premise built with the nested block's constructor has the value of the rule's right-hand side,
--| an element of the type's value, for a hook with `hctor` and `hrec` that is invariant under `eeqv`. The two sides are
--| joined through the families' points (the specialization lemma); the nested block's constructor has the auxiliary
--| constructor's number of fields. The rule's `spine Y maj nf` is not needed; sort hypotheses on the rule's terms.
theorem ind_iota_nst_all (G: hyps) (H J: class) (u w r tg td tv ti tc tnp tn tm tCT tni te4 tks tmj tnq tY trhs0 tnf trhs ta ta0 te3 tR0 tRT tTY tC tT tT2 tN tRh tRr tI tI2 tii tnpi tXo: set):
  $ G ⇒ iwf u H J tg td w r $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ hrec ⊆ H $ >
  $ G ⇒ minv (mcv H) $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ te4 tks ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ctor , scons tI2 (scons tii (scons tc ∅)) ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ ra_rec_rhs td tv ti tc tRh ∈ lrel $ >
  $ G ⇒ ra_add tnp tn ta0 ∈ lrel $ >
  $ G ⇒ ra_add ta0 tm ta ∈ lrel $ >
  $ G ⇒ ra_nidx td ti tni ∈ lrel $ >
  $ G ⇒ ra_add ta tni tks ∈ lrel $ >
  $ G ⇒ ra_nfields td ti tc tnf ∈ lrel $ >
  $ G ⇒ ra_add tnpi tnf tnq ∈ lrel $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tRr ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_spine te3 te4 tni ∈ lrel $ >
  $ G ⇒ ra_rehead tY trhs0 tnf tmj trhs ∈ lrel $ >
  $ G ⇒ ra_rec_ty td tv ti tR0 ∈ lrel $ >
  $ G ⇒ tR0 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_sty tg ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tRT te4 ⟨ kc_pi , scons tTY (scons tC ∅) ⟩ ∈ lrel3 J $ >
  $ G ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ tC tmj tT ∈ lrel $ >
  $ G ⇒ ra_eeqv ⟨ kc_ind_ctor , scons tI (scons tii (scons tc ∅)) ⟩ ⟨ kc_ind_ctor , scons tI2 (scons tii (scons tc ∅)) ⟩ ∈ lrel2 $ >
  $ G ⇒ ra_sty tg ⟨ kc_ind_ctor , scons tI2 (scons tii (scons tc ∅)) ⟩ tCT tmj tT2 ∈ lrel3 J $ >
  $ G ⇒ ra_aeq tg tT2 tTY ∈ lrel3 J $ >
  $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ tc ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ tRh ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_rst td tN tR0 tRT ∈ lrel $ >
  $ G ⇒ ra_ind_nested td tN ∈ lrel $ >
  $ G ⇒ ra_ind_arity td tnp tn tm ∈ lrel $ >
  $ G ⇒ ra_ctor_ty tI tii tc tCT ∈ lrel $ >
  $ G ⇒ ra_aux_of td tN ti tXo ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons tI (scons tii ∅) ⟩ tXo tnpi ∈ lrel $ >
  $ G ⇒ tXo ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tii ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ ra_rst td tN tRh tRr ∈ lrel $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) tT w r $;
