-- --------------------------------------------------------------------------

--| An instance of a `λ` is a `λ` of the parts' instances (the body's a binder deeper).
--| @freshen G x
--| @freshen G y
theorem inst_lam_inv {x y: set} (G: hyps) (tk ta tb tc t4: set): $ G ⇒ ra_inst tk ⟨ kc_lam , scons ta (scons tb ∅) ⟩ tc t4 ∈ lrel $ > $ G ⇒ ∃ x ∃ y (t4 = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ ra_inst tk ta tc x ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ tb tc y ∈ lrel) $;

--| `pinst` at a `λ`: a `λ` of the parts' instances along the same spine (the body's a binder deeper).
--| @freshen G x
--| @freshen G z
theorem pinst_lam_inv {x z: set} (G: hyps) (ti ts ta tb tr: set): $ G ⇒ ra_pinst ti ts ⟨ kc_lam , scons ta (scons tb ∅) ⟩ tr ∈ lrel $ > $ G ⇒ ∃ x ∃ z (tr = ⟨ kc_lam , scons x (scons z ∅) ⟩ ∧ ra_pinst ti ts ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons ti ∅ ⟩ ts tb z ∈ lrel) $;

--| An instance of a projection is the projection of the structure's instance.
--| @freshen G x
theorem inst_proj_inv {x: set} (G: hyps) (tk tb ti te tc t4: set): $ G ⇒ ra_inst tk ⟨ kc_proj , scons tb (scons ti (scons te ∅)) ⟩ tc t4 ∈ lrel $ > $ G ⇒ ∃ x (t4 = ⟨ kc_proj , scons tb (scons ti (scons x ∅)) ⟩ ∧ ra_inst tk te tc x ∈ lrel) $;

--| `pinst` at a projection: the projection of the structure's instance along the same spine.
--| @freshen G x
theorem pinst_proj_inv {x: set} (G: hyps) (tj ts tb ti te tr: set): $ G ⇒ ra_pinst tj ts ⟨ kc_proj , scons tb (scons ti (scons te ∅)) ⟩ tr ∈ lrel $ > $ G ⇒ ∃ x (tr = ⟨ kc_proj , scons tb (scons ti (scons x ∅)) ⟩ ∧ ra_pinst tj ts te x ∈ lrel) $;

