-- Nested blocks (E7): a specialized occurrence with the block's types put in restores to the occurrence
-- --------------------------------------------------------------------------

--| `sinst` at a `λ`: a `λ` of the parts' `sinst`, the body's a binder deeper.
--| @freshen G x
--| @freshen G c
theorem sinst_lam_inv {x c: set} (G: hyps) (td tn tj tk ta tb tz tdd: set): $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk ⟨ kc_lam , scons ta (scons tb ∅) ⟩ tz ∈ lrel $ > $ G ⇒ ∃ x ∃ c (tz = ⟨ kc_lam , scons x (scons c ∅) ⟩ ∧ ra_sinst td tj tn tk ta x ∈ lrel ∧ ra_sinst td tj tn ⟨ kc_s , scons tk ∅ ⟩ tb c ∈ lrel) $;

--| `sinst` at a projection: the projection of the structure's `sinst`.
--| @freshen G x
theorem sinst_proj_inv {x: set} (G: hyps) (td tn tj tk tb ti ta tz tdd: set): $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk ⟨ kc_proj , scons tb (scons ti (scons ta ∅)) ⟩ tz ∈ lrel $ > $ G ⇒ ∃ x (tz = ⟨ kc_proj , scons tb (scons ti (scons x ∅)) ⟩ ∧ ra_sinst td tj tn tk ta x ∈ lrel) $;

