-- Nested blocks (E7): the step of the first inclusion at a constructor
-- --------------------------------------------------------------------------

-- --------------------------------------------------------------------------
-- Nested blocks (E7): fibers of the two families
-- --------------------------------------------------------------------------

-- --------------------------------------------------------------------------
-- Nested blocks (E7): the entries of a block's list of occurrences
-- --------------------------------------------------------------------------

-- --------------------------------------------------------------------------
-- Nested blocks (E7): the rule induction of the first inclusion
-- --------------------------------------------------------------------------

-- --------------------------------------------------------------------------
-- Nested blocks (E7): the step of the rule induction
-- --------------------------------------------------------------------------

-- --------------------------------------------------------------------------
-- Nested blocks (E7): an occurrence's arguments in the nested parameters' telescope
-- --------------------------------------------------------------------------

-- --------------------------------------------------------------------------
-- Nested blocks (E7): a lift is injective
-- --------------------------------------------------------------------------

--| A lift whose result is closed below the cutoff is the identity (by induction on the term).
theorem lift_res_closed_id (G: hyps) (tn tk te tj tz: set): $ G ⇒ ra_lift tn tk te tz ∈ lrel $ > $ G ⇒ ra_closed tj tz ∈ lrel $ > $ G ⇒ ra_le tj tk ∈ lrel $ > $ G ⇒ tz = te $;

--| A lift is injective: two terms with one lift at one cutoff are equal (by induction on the term; the clause for
--| closed terms by `lift_res_closed_id`).
theorem lift_inj (G: hyps) (tn tk te te2 tz: set): $ G ⇒ ra_lift tn tk te tz ∈ lrel $ > $ G ⇒ ra_lift tn tk te2 tz ∈ lrel $ > $ G ⇒ te2 = te $;

-- --------------------------------------------------------------------------
-- Nested blocks (E7): lifts by zero, and lifts under an instantiation
-- --------------------------------------------------------------------------

--| A lift by zero is the identity (by induction on the term).
theorem lift_zero_id (G: hyps) (tk te tz: set): $ G ⇒ ra_lift ⟨ kc_nz , ∅ ⟩ tk te tz ∈ lrel $ > $ G ⇒ tz = te $;

--| `inst` at a variable leaves a term closed below that variable as it is (`inst_closed_id` with the closedness at a
--| depth `tj ≤ tc` and the variable at `tc + tn`; by induction on the term).
theorem inst_closed_below_id (G: hyps) (tk te ta tn tc tj te2: set): $ G ⇒ ra_inst tk te ta te2 ∈ lrel $ > $ G ⇒ ra_closed tj te ∈ lrel $ > $ G ⇒ ra_le tj tc ∈ lrel $ > $ G ⇒ ra_add tc tn tk ∈ lrel $ > $ G ⇒ te2 = te $;

--| A lift by `tn + 1` at a cutoff, then `inst` at the cutoff plus `tn`, is the lift by `tn` (the instantiated variable is
--| one of those the lift skipped; by induction on the term).
theorem inst_lift (G: hyps) (tn tm ta tc tk te tl tz: set): $ G ⇒ ra_lift tm tc te tl ∈ lrel $ > $ G ⇒ ra_inst tk tl ta tz ∈ lrel $ > $ G ⇒ ra_add tc tn tk ∈ lrel $ > $ G ⇒ tm = ⟨ kc_s , scons tn ∅ ⟩ $ > $ G ⇒ ra_lift tn tc te tz ∈ lrel $;

-- --------------------------------------------------------------------------
-- Nested blocks (E7): factoring a lift through a lift
-- --------------------------------------------------------------------------

--| A bound of a summand bounds the sum (by induction on the other summand).
theorem le_add (G: hyps) (tj ta tn tb: set): $ G ⇒ ra_add ta tn tb ∈ lrel $ > $ G ⇒ ra_le tj ta ∈ lrel $ > $ G ⇒ ra_le tj tb ∈ lrel $;

--| Factoring a lift: if the lift of `te` by `tk + td` at a cutoff is also the lift of `tu` by `td` at that cutoff plus `tk`,
--| then `tu` is the lift of `te` by `tk` (by induction on `te`).
theorem lift_factor (G: hyps) (tm td tk tc tq te tu tz: set): $ G ⇒ ra_lift tm tc te tz ∈ lrel $ > $ G ⇒ ra_lift td tq tu tz ∈ lrel $ > $ G ⇒ ra_add tk td tm ∈ lrel $ > $ G ⇒ ra_add tc tk tq ∈ lrel $ > $ G ⇒ ra_lift tk tc te tu ∈ lrel $;

--| A lift leaves a term closed below its cutoff as it is (by induction on the term).
theorem lift_closed_id (G: hyps) (tn tk te tj tz: set): $ G ⇒ ra_lift tn tk te tz ∈ lrel $ > $ G ⇒ ra_closed tj te ∈ lrel $ > $ G ⇒ ra_le tj tk ∈ lrel $ > $ G ⇒ tz = te $;

--| Lifts compose: a lift by `ta` at a cutoff, then a lift by `tk` at that cutoff plus `ta`, is the lift by `ta + tk`
--| (by induction on the term).
theorem lift_lift (G: hyps) (ta tk tm tp tq te tu tz: set): $ G ⇒ ra_lift ta tp te tu ∈ lrel $ > $ G ⇒ ra_lift tk tq tu tz ∈ lrel $ > $ G ⇒ ra_add ta tk tm ∈ lrel $ > $ G ⇒ ra_add tp ta tq ∈ lrel $ > $ G ⇒ ra_lift tm tp te tz ∈ lrel $;



-- --------------------------------------------------------------------------
-- Nested blocks (E7): a lift at an application and at a `Π`, read from the source and from the result
-- --------------------------------------------------------------------------

--| A lift of an application is the application of the parts' lifts.
--| @freshen G x
--| @freshen G y
theorem lift_app_inv {x y: set} (G: hyps) (tn tk ta tb t4: set): $ G ⇒ ra_lift tn tk ⟨ kc_app , scons ta (scons tb ∅) ⟩ t4 ∈ lrel $ > $ G ⇒ ∃ x ∃ y (t4 = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ ra_lift tn tk ta x ∈ lrel ∧ ra_lift tn tk tb y ∈ lrel) $;

--| A lift of a `Π` is the `Π` of the parts' lifts (the body's at the next cutoff).
--| @freshen G x
--| @freshen G y
theorem lift_pi_inv {x y: set} (G: hyps) (tn tk ta tb t4: set): $ G ⇒ ra_lift tn tk ⟨ kc_pi , scons ta (scons tb ∅) ⟩ t4 ∈ lrel $ > $ G ⇒ ∃ x ∃ y (t4 = ⟨ kc_pi , scons x (scons y ∅) ⟩ ∧ ra_lift tn tk ta x ∈ lrel ∧ ra_lift tn ⟨ kc_s , scons tk ∅ ⟩ tb y ∈ lrel) $;

--| A term whose lift is an application is an application, and the parts are lifted.
--| @freshen G x
--| @freshen G y
theorem lift_app_res {x y: set} (G: hyps) (tn tk te ta tb: set): $ G ⇒ ra_lift tn tk te ⟨ kc_app , scons ta (scons tb ∅) ⟩ ∈ lrel $ > $ G ⇒ ∃ x ∃ y (te = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ ra_lift tn tk x ta ∈ lrel ∧ ra_lift tn tk y tb ∈ lrel) $;

--| A term whose lift is a `Π` is a `Π`, and the parts are lifted (the body at the next cutoff).
--| @freshen G x
--| @freshen G y
theorem lift_pi_res {x y: set} (G: hyps) (tn tk te ta tb: set): $ G ⇒ ra_lift tn tk te ⟨ kc_pi , scons ta (scons tb ∅) ⟩ ∈ lrel $ > $ G ⇒ ∃ x ∃ y (te = ⟨ kc_pi , scons x (scons y ∅) ⟩ ∧ ra_lift tn tk x ta ∈ lrel ∧ ra_lift tn ⟨ kc_s , scons tk ∅ ⟩ y tb ∈ lrel) $;










