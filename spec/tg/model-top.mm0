-- model-top.mm0: the model's hook and the assembly (audit §11): the
-- environment's values at the three axioms' atoms, the constants' invariance
-- under `eeqv`, the hook `hfin` of all the parts, its invariance. Imports
-- model-lit.mm0; proofs in model-top.auf.

import "model-lit.mm0";

-- --------------------------------------------------------------------------
-- The constants: the environment at the axioms' atoms, invariance
-- --------------------------------------------------------------------------
-- A certificate's opaque and axiomatic constants are `cst a S` over generated
-- atoms; the spec says nothing of them but `closed_cst` and `eeqv_cst`. Their
-- values are a parameter of the model, the class `Env` of model-quot.mm0,
-- which has no axioms; the certificate's typing axioms for its constants are
-- the constraints on it. `Envx` (model-quot.mm0) fixes the values at the
-- spec's own atoms: here those of `propext`, `Quot.sound`, `Classical.choice`.

--| The value at the atom of `propext` is `∅`.
theorem envx_propext (G: hyps) (u s: set): $ G ⇒ fv Envx ⟨ u , ⟨ ⟨ kc_propext_atom , ∅ ⟩ , s ⟩ ⟩ = ∅ $;
--| The value at the atom of `Quot.sound` is `∅`.
theorem envx_quot_sound (G: hyps) (u s: set): $ G ⇒ fv Envx ⟨ u , ⟨ ⟨ kc_quot_sound_atom , ∅ ⟩ , s ⟩ ⟩ = ∅ $;
--| The value at the atom of `Classical.choice` is the choice function at the first level value.
theorem envx_choice (G: hyps) (u s: set): $ G ⇒ fv Envx ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ = chv (fv s ∅) $;

-- --------------------------------------------------------------------------
-- Equivalent level lists have the same values; the hook at the nodes `cst`
-- --------------------------------------------------------------------------

--| Equivalent level lists (`lseqv`) have the same values at every level valuation.
theorem lrel2_lseqv_lsv (G: hyps) (t1 t2 w: set):
  $ G ⇒ ra_lseqv t1 t2 ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lsv t1 w = lsv t2 w $;

--| `minv_intro`'s step at the nodes `cst`: equivalent level lists have the same values, so the node denotes as every tree it is `eeqv` to.
theorem mcv_inv_node_cst (G: hyps) (H: class) (u w d z y t: set):
  $ G ⇒ hcst ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ z = ⟨ kc_cst , y ⟩ $ > $ G ⇒ ra_eeqv z t ∈ lrel2 $ >
  $ G ⇒ dt u (mcv H) z w d = dt u (mcv H) t w d $;

-- --------------------------------------------------------------------------
-- The hook of the model: all the parts
-- --------------------------------------------------------------------------

--| The hook of the model before the course of values: the parts for the inductive types, their
--| constructors and recursors, the literals and the constants (the quotient primitives among them).
def hfin: class = $ hty ∪ (hctor ∪ (hrec ∪ (hlit ∪ hcst))) $;
--| The hook is a function: the parts are, and their keys have different labels.
theorem hfin_functional (G: hyps): $ G ⇒ functional hfin $;
--| The hook has the part `hty`.
theorem hfin_hty (G: hyps): $ G ⇒ hty ⊆ hfin $;
--| The hook has the part `hctor`.
theorem hfin_hctor (G: hyps): $ G ⇒ hctor ⊆ hfin $;
--| The hook has the part `hrec`.
theorem hfin_hrec (G: hyps): $ G ⇒ hrec ⊆ hfin $;
--| The hook has the part `hlit`.
theorem hfin_hlit (G: hyps): $ G ⇒ hlit ⊆ hfin $;
--| The hook has the part `hcst`.
theorem hfin_hcst (G: hyps): $ G ⇒ hcst ⊆ hfin $;
--| The hook has the parts of the inductive types.
theorem hfin_hind (G: hyps): $ G ⇒ hind hfin $;
--| The hook gives the quotient constants their values: it has the constants' part.
theorem hfin_hqu (G: hyps): $ G ⇒ hqu hfin $;
-- --------------------------------------------------------------------------
-- The hook is invariant under `eeqv`
-- --------------------------------------------------------------------------
--| The hook is invariant under `eeqv`: `minv_intro` at the five labels it interprets.
theorem hfin_minv (G: hyps): $ G ⇒ minv (mcv hfin) $;

-- --------------------------------------------------------------------------
-- The assembly: the spec's judgment and its relations over `⊢`, in the model
-- --------------------------------------------------------------------------
-- `deq` is the model's judgment at the hook `hfin`; the relations of Part II
-- over `⊢` are lean-tg3's at the judgment atoms that hold in the model
-- (`jmod`). Below them, the spec's axioms about them are theorems, with the
-- spec's statements: lean-tg-rest.mm0 keeps what is not proved here.

--| The spec's judgment `G ⊢ e ≡ e2 : A`: in every admissible universe, at every level valuation and every valuation
--| of `G`, `e` and `e2` have the same value, an element of the value of `A`.
def deq (G: ctx) (e e2 A: expr): wff = $ mdeq (mcv hfin) G e e2 A $;
--| Typing: `e` is equal to itself at `A`.
def ty (G: ctx) (e A: expr): wff = $ deq G e e A $;
--| The spec's `inh`: the value of `A` is never empty.
def inh (G: ctx) (A: expr): wff = $ minh (mcv hfin) G A $;
--| The spec's `sty`, over the judgments that hold in the model.
def sty (G: ctx) (e1 e2 e3 e4: expr): wff = $ sty_j (jmod (mcv hfin)) G e1 e2 e3 e4 $;
--| The spec's `cwf`, over the judgments that hold in the model.
def cwf (D: ind) (n1_v n2_v: nat) (l: lvl) (n3_v: nat) (G: ctx) (n4_v: nat) (e1: expr): wff = $ cwf_j (jmod (mcv hfin)) D n1_v n2_v l n3_v G n4_v e1 $;
--| The spec's `ctors_wf`, over the judgments that hold in the model.
def ctors_wf (D: ind) (n1_v n2_v: nat) (l: lvl) (n3_v: nat) (G: ctx) (C: ctors): wff = $ ctors_wf_j (jmod (mcv hfin)) D n1_v n2_v l n3_v G C $;
--| The spec's `tys_wf`, over the judgments that hold in the model.
def tys_wf (D: ind) (n1_v n2_v: nat) (l: lvl) (n3_v: nat) (G: ctx) (T: tys): wff = $ tys_wf_j (jmod (mcv hfin)) D n1_v n2_v l n3_v G T $;
--| The spec's `ctx_wf`, over the judgments that hold in the model.
def ctx_wf (G G2: ctx): wff = $ ctx_wf_j (jmod (mcv hfin)) G G2 $;
--| The spec's `tys_ty`, over the judgments that hold in the model.
def tys_ty (G: ctx) (T: tys): wff = $ tys_ty_j (jmod (mcv hfin)) G T $;
--| The spec's `tys_ok`, over the judgments that hold in the model.
def tys_ok (G: ctx) (D: ind): wff = $ tys_ok_j (jmod (mcv hfin)) G D $;
--| The spec's `ind_wf`, over the judgments that hold in the model.
def ind_wf (G: ctx) (D: ind): wff = $ ind_wf_j (jmod (mcv hfin)) G D $;
--| The spec's `nst_ok`, over the judgments that hold in the model.
def nst_ok (G: ctx) (D: ind) (n1_v: nat) (G2: ctx): wff = $ nst_ok_j (jmod (mcv hfin)) G D n1_v G2 $;
--| The spec's `nst_ty`, over the judgments that hold in the model.
def nst_ty (G: ctx) (D D2: ind) (e1: expr): wff = $ nst_ty_j (jmod (mcv hfin)) G D D2 e1 $;
--| The spec's `large`, over the judgments that hold in the model.
def large (G: ctx) (D: ind): wff = $ large_j (jmod (mcv hfin)) G D $;
--| The spec's `fir`, over the judgments that hold in the model.
def fir (D: ind) (n1_v: nat) (G: ctx) (n2_v: nat) (e1: expr): wff = $ fir_j (jmod (mcv hfin)) D n1_v G n2_v e1 $;
--| The spec's `elim_ok`, over the judgments that hold in the model.
def elim_ok (G: ctx) (D: ind) (l: lvl): wff = $ elim_ok_j (jmod (mcv hfin)) G D l $;
--| The spec's `fprops`, over the judgments that hold in the model.
def fprops (D: ind) (n1_v n2_v: nat) (G: ctx) (n3_v n4_v: nat) (e1: expr): wff = $ fprops_j (jmod (mcv hfin)) D n1_v n2_v G n3_v n4_v e1 $;
--| The spec's `proj_ok`, over the judgments that hold in the model.
def proj_ok (G: ctx) (D: ind) (n1_v n2_v: nat): wff = $ proj_ok_j (jmod (mcv hfin)) G D n1_v n2_v $;
--| The spec's `add_eqs`, over the judgments that hold in the model.
def add_eqs (G: ctx) (e1: expr): wff = $ add_eqs_j (jmod (mcv hfin)) G e1 $;
--| The spec's `pred_eqs`, over the judgments that hold in the model.
def pred_eqs (G: ctx) (e1: expr): wff = $ pred_eqs_j (jmod (mcv hfin)) G e1 $;
--| The spec's `sub_eqs`, over the judgments that hold in the model.
def sub_eqs (G: ctx) (e1 e2: expr): wff = $ sub_eqs_j (jmod (mcv hfin)) G e1 e2 $;
--| The spec's `mul_eqs`, over the judgments that hold in the model.
def mul_eqs (G: ctx) (e1 e2: expr): wff = $ mul_eqs_j (jmod (mcv hfin)) G e1 e2 $;
--| The spec's `pow_eqs`, over the judgments that hold in the model.
def pow_eqs (G: ctx) (e1 e2 e3: expr): wff = $ pow_eqs_j (jmod (mcv hfin)) G e1 e2 e3 $;
--| The spec's `beq_eqs`, over the judgments that hold in the model.
def beq_eqs (G: ctx) (e1 e2 e3 e4: expr): wff = $ beq_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 $;
--| The spec's `ble_eqs`, over the judgments that hold in the model.
def ble_eqs (G: ctx) (e1 e2 e3 e4: expr): wff = $ ble_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 $;
--| The spec's `shl_eqs`, over the judgments that hold in the model.
def shl_eqs (G: ctx) (e1 e2 e3: expr): wff = $ shl_eqs_j (jmod (mcv hfin)) G e1 e2 e3 $;
--| The spec's `shr_eqs`, over the judgments that hold in the model.
def shr_eqs (G: ctx) (e1 e2: expr): wff = $ shr_eqs_j (jmod (mcv hfin)) G e1 e2 $;

-- --------------------------------------------------------------------------
-- The spec's axioms about them, as theorems
-- --------------------------------------------------------------------------

theorem sty_nil (G: ctx) (h A: expr): $ sty G h A h A $;

theorem sty_app (G: ctx) (h A f a B C C2: expr): $ sty G h A f (pi B C) $ > $ ty G a B $ > $ inst nz C a C2 $ > $ sty G h A (app f a) C2 $;

theorem cwf_pi (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2: expr) (u: lvl): $ add d np k $ > $ closed k A $ > $ sinst D nz n k A A2 $ > $ ty Ctx A2 (srt u) $ > $ ulevel l u $ > $ cwf D n np l i (cons A2 Ctx) (s d) B $ > $ cwf D n np l i Ctx d (pi A B) $;

theorem cwf_pi_rec (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2 B2: expr) (u: lvl): $ add d np k $ > $ sinst D nz n k A A2 $ > $ ty Ctx A2 (srt u) $ > $ ulevel l u $ > $ ipos D n np d A $ > $ inst nz B (srt lz) B2 $ > $ lift n1 nz B2 B $ > $ cwf D n np l i (cons A2 Ctx) (s d) B $ > $ cwf D n np l i Ctx d (pi A B) $;

theorem cwf_res (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (K K2: expr) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (R R2 S: expr): $ indapp D n np d K i $ > $ add d np k $ > $ sinst D nz n k K K2 $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ pis P F R $ > $ lift k nz R R2 $ > $ sty Ctx (ind_ty D i) R2 K2 S $ > $ cwf D n np l i Ctx d K $;

theorem ctors_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ ctors_wf D n np l i Ctx cnil $;

theorem ctors_wf_cons (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (K: expr) (C: ctors) (b: blk) (P: ctx) (T: tys) (R: expr): $ ind_data D b P T $ > $ pis P K R $ > $ closed n R $ > $ cwf D n np l i Ctx nz K $ > $ ctors_wf D n np l i Ctx C $ > $ ctors_wf D n np l i Ctx (ccons K C) $;

theorem tys_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ tys_wf D n np l i Ctx tnil $;

theorem tys_wf_cons (D: ind) (n np: nat) (l l2: lvl) (i k: nat) (Ctx: ctx) (F: expr) (C: ctors) (T: tys): $ isort F k l2 $ > $ leqv l2 l $ > $ ctors_wf D n np l i Ctx C $ > $ tys_wf D n np l (s i) Ctx T $ > $ tys_wf D n np l i Ctx (tcons F C T) $;

theorem ctx_wf_nil (G: ctx): $ ctx_wf G nil $;

theorem ctx_wf_cons (G P G2: ctx) (A: expr) (u: lvl): $ ctx_wf G P $ > $ capp P G G2 $ > $ ty G2 A (srt u) $ > $ ctx_wf G (cons A P) $;

theorem tys_ty_nil (Ctx: ctx): $ tys_ty Ctx tnil $;

theorem tys_ty_cons (Ctx: ctx) (F: expr) (C: ctors) (T: tys) (u l: lvl) (k: nat): $ isort F k l $ > $ ty Ctx F (srt u) $ > $ tys_ty Ctx T $ > $ tys_ty Ctx (tcons F C T) $;

theorem tys_ok_i (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys): $ ind_data D b P T $ > $ tys_closed P T $ > $ ctx_wf G P $ > $ capp P G G2 $ > $ tys_ty G2 T $ > $ tys_ok G D $;

theorem nst_ty_i (G G2: ctx) (D I: ind) (b bi_v: blk) (P Pi: ctx) (T Ti: tys) (np n m: nat) (X X1 Fi RI S: expr) (Ci: ctors): $ ind_data D b P T $ > $ capp P G G2 $ > $ ind_arity D np n m $ > $ sinst D nz n np X X1 $ > $ closed np X1 $ > $ ind_data I bi_v Pi Ti $ > $ nth_ty Ti nz Fi Ci $ > $ pis Pi Fi RI $ > $ sty G2 (ind_ty I nz) RI X1 S $ > $ nst_ty G D I X $;

theorem nst_ok_nil (G: ctx) (D: ind) (j: nat): $ nst_ok G D j nil $;

theorem nst_ok_cons (G: ctx) (D I: ind) (j j2 npi ni mi ni0: nat) (X: expr) (N2 N3 NI: ctx): $ spine (ind_ty I nz) X npi $ > $ ind_wf G I $ > $ ind_arity I npi ni mi $ > $ ind_nested I NI $ > $ ndecl NI ni ni0 $ > $ lt nz ni0 $ > $ nst_ty G D I X $ > $ nst_group G D I X j nz ni0 (cons X N2) N3 $ > $ add j ni0 j2 $ > $ nst_ok G D j2 N3 $ > $ nst_ok G D j (cons X N2) $;

theorem ind_wf_i (G G2: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (np n m k n0: nat) (l: lvl) (F: expr) (C: ctors): $ tys_ok G D $ > $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ capp P G G2 $ > $ nth_ty T nz F C $ > $ isort F k l $ > $ tys_wf D n np l nz G2 T $ > $ ind_nested D N $ > $ ndecl N n n0 $ > $ nst_ok G D n0 N $ > $ ind_wf G D $;

theorem elim_prop (G: ctx) (D: ind) (v: lvl): $ leqv v lz $ > $ elim_ok G D v $;

theorem elim_large (G: ctx) (D: ind) (v: lvl): $ large G D $ > $ elim_ok G D v $;

theorem large_nz (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (k: nat) (l: lvl): $ ind_data D b P T $ > $ nth_ty T nz F C $ > $ isort F k l $ > $ leqv (lmax (ls lz) l) l $ > $ large G D $;

theorem large_empty (G: ctx) (D: ind) (b: blk) (P: ctx) (F: expr): $ ind_data D b P (tcons F cnil tnil) $ > $ large G D $;

theorem large_single (G G2: ctx) (D: ind) (b: blk) (P: ctx) (F K: expr) (np: nat): $ ind_data D b P (tcons F (ccons K cnil) tnil) $ > $ clen P np $ > $ capp P G G2 $ > $ fir D np G2 nz K $ > $ large G D $;

theorem fir_res (D: ind) (np: nat) (Ctx: ctx) (d: nat) (K: expr): $ indapp D n1 np d K nz $ > $ fir D np Ctx d K $;

theorem fir_arg (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr): $ leaf_has nz B $ > $ add d np k $ > $ sinst D nz n1 k A A2 $ > $ fir D np (cons A2 Ctx) (s d) B $ > $ fir D np Ctx d (pi A B) $;

theorem fir_prop (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr): $ add d np k $ > $ sinst D nz n1 k A A2 $ > $ ty Ctx A2 Prop $ > $ fir D np (cons A2 Ctx) (s d) B $ > $ fir D np Ctx d (pi A B) $;

theorem proj_ok_sort (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i: nat) (F: expr) (C: ctors) (l: lvl): $ ind_data D b P T $ > $ nth_ty T j F C $ > $ isort F nz l $ > $ leqv (lmax (ls lz) l) l $ > $ proj_ok G D j i $;

theorem proj_ok_prop (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K: expr) (C: ctors): $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ capp P G G2 $ > $ nth_ty T j F C $ > $ nth_ctor C nz K $ > $ fprops D n np G2 nz (s i) K $ > $ proj_ok G D j i $;

theorem fprops_z (D: ind) (n np: nat) (Ctx: ctx) (d: nat) (K: expr): $ fprops D n np Ctx d nz K $;

theorem fprops_s (D: ind) (n np: nat) (Ctx: ctx) (d cnt k: nat) (A A2 B: expr): $ add d np k $ > $ sinst D nz n k A A2 $ > $ ty Ctx A2 Prop $ > $ fprops D n np (cons A2 Ctx) (s d) cnt B $ > $ fprops D n np Ctx d (s cnt) (pi A B) $;

theorem add_eqs_i (G: ctx) (f: expr): $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $ > $ deq (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app nat_succ (app (app f (bvar n1)) (bvar nz))) nat_ty $ > $ add_eqs G f $;

theorem pred_eqs_i (G: ctx) (p: expr): $ closed nz p $ > $ ty G p (pi nat_ty nat_ty) $ > $ deq G (app p nat_zero) nat_zero nat_ty $ > $ deq (cons nat_ty G) (app p (app nat_succ (bvar nz))) (bvar nz) nat_ty $ > $ pred_eqs G p $;

theorem sub_eqs_i (G: ctx) (f p: expr): $ pred_eqs G p $ > $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $ > $ deq (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app p (app (app f (bvar n1)) (bvar nz))) nat_ty $ > $ sub_eqs G f p $;

theorem mul_eqs_i (G: ctx) (f fa: expr): $ add_eqs G fa $ > $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq (cons nat_ty G) (app (app f (bvar nz)) nat_zero) nat_zero nat_ty $ > $ deq (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fa (app (app f (bvar n1)) (bvar nz))) (bvar n1)) nat_ty $ > $ mul_eqs G f fa $;

theorem pow_eqs_i (G: ctx) (f fm fa: expr): $ mul_eqs G fm fa $ > $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (app nat_succ nat_zero) nat_ty $ > $ deq (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fm (app (app f (bvar n1)) (bvar nz))) (bvar n1)) nat_ty $ > $ pow_eqs G f fm fa $;

theorem beq_eqs_i (G: ctx) (f B t u: expr): $ closed nz f $ > $ closed nz B $ > $ closed nz t $ > $ closed nz u $ > $ ty G f (pi nat_ty (pi nat_ty B)) $ > $ deq G (app (app f nat_zero) nat_zero) t B $ > $ deq (cons nat_ty G) (app (app f nat_zero) (app nat_succ (bvar nz))) u B $ > $ deq (cons nat_ty G) (app (app f (app nat_succ (bvar nz))) nat_zero) u B $ > $ deq (cons nat_ty (cons nat_ty G)) (app (app f (app nat_succ (bvar n1))) (app nat_succ (bvar nz))) (app (app f (bvar n1)) (bvar nz)) B $ > $ beq_eqs G f B t u $;

theorem ble_eqs_i (G: ctx) (f B t u: expr): $ closed nz f $ > $ closed nz B $ > $ closed nz t $ > $ closed nz u $ > $ ty G f (pi nat_ty (pi nat_ty B)) $ > $ deq (cons nat_ty G) (app (app f nat_zero) (bvar nz)) t B $ > $ deq (cons nat_ty G) (app (app f (app nat_succ (bvar nz))) nat_zero) u B $ > $ deq (cons nat_ty (cons nat_ty G)) (app (app f (app nat_succ (bvar n1))) (app nat_succ (bvar nz))) (app (app f (bvar n1)) (bvar nz)) B $ > $ ble_eqs G f B t u $;

theorem shl_eqs_i (G: ctx) (f fm fa: expr): $ mul_eqs G fm fa $ > $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $ > $ deq (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app f (app (app fm (lit (bd0 (bd1 b0)))) (bvar n1))) (bvar nz)) nat_ty $ > $ shl_eqs G f fm fa $;

theorem shr_eqs_i (G: ctx) (f fd: expr): $ closed nz f $ > $ closed nz fd $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $ > $ deq (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fd (app (app f (bvar n1)) (bvar nz))) (lit (bd0 (bd1 b0)))) nat_ty $ > $ shr_eqs G f fd $;

theorem bvar (G: ctx) (i: nat) (A: expr): $ lookup G i A $ > $ ty G (bvar i) A $;

theorem symm (G: ctx) (e e2 A: expr): $ deq G e e2 A $ > $ deq G e2 e A $;

theorem trans (G: ctx) (e1 e2 e3 A: expr): $ deq G e1 e2 A $ > $ deq G e2 e3 A $ > $ deq G e1 e3 A $;

theorem sortDF (G: ctx) (l l2: lvl): $ leqv l l2 $ > $ deq G (srt l) (srt l2) (srt (ls l)) $;

theorem appDF (G: ctx) (f f2 A B a a2 R: expr): $ deq G f f2 (pi A B) $ > $ deq G a a2 A $ > $ inst nz B a R $ > $ deq G (app f a) (app f2 a2) R $;

theorem lamDF (G: ctx) (u: lvl) (A A2 b b2 B: expr): $ deq G A A2 (srt u) $ > $ deq (cons A G) b b2 B $ > $ deq G (lam A b) (lam A2 b2) (pi A B) $;

theorem forallEDF (G: ctx) (u v: lvl) (A A2 B B2: expr): $ deq G A A2 (srt u) $ > $ deq (cons A G) B B2 (srt v) $ > $ deq G (pi A B) (pi A2 B2) (srt (limax u v)) $;

theorem defeqDF (G: ctx) (u: lvl) (A B e e2: expr): $ deq G A B (srt u) $ > $ deq G e e2 A $ > $ deq G e e2 B $;

theorem beta (G: ctx) (A e B a r R: expr): $ ty (cons A G) e B $ > $ ty G a A $ > $ inst nz e a r $ > $ inst nz B a R $ > $ deq G (app (lam A e) a) r R $;

theorem eta (G: ctx) (A B e e1: expr): $ ty G e (pi A B) $ > $ lift n1 nz e e1 $ > $ deq G (lam A (app e1 (bvar nz))) e (pi A B) $;

theorem proofIrrel (G: ctx) (p h h2: expr): $ ty G p Prop $ > $ ty G h p $ > $ ty G h2 p $ > $ deq G h h2 p $;

theorem instDF (k: nat) (G0 G1 G: ctx) (A0 a e e2 A r r2 R: expr): $ ty G0 a A0 $ > $ cinst k G0 A0 a G1 G $ > $ deq G1 e e2 A $ > $ inst k e a r $ > $ inst k e2 a r2 $ > $ inst k A a R $ > $ deq G r r2 R $;

theorem weakDF (n: nat) (G G2: ctx) (e e2 A r r2 R: expr): $ deq G e e2 A $ > $ cext n G G2 $ > $ lift n nz e r $ > $ lift n nz e2 r2 $ > $ lift n nz A R $ > $ deq G2 r r2 R $;

theorem eeqv_df (G: ctx) (e e2 A: expr): $ ty G e A $ > $ eeqv e e2 $ > $ deq G e e2 A $;

theorem quot_ty (G: ctx) (u: lvl): $ ty G (quot u) (pi (srt u) (pi (pi (bvar nz) (pi (bvar n1) Prop)) (srt u))) $;

theorem quot_mk_ty (G: ctx) (u: lvl): $ ty G (quot_mk u) (pi (srt u) (pi (pi (bvar nz) (pi (bvar n1) Prop)) (pi (bvar n1) (app (app (quot u) (bvar n2)) (bvar n1))))) $;

theorem quot_lift_ty (G: ctx) (u v: lvl): $ ty G (quot_lift u v) (pi (srt u) (pi (pi (bvar nz) (pi (bvar n1) Prop)) (pi (srt v) (pi (pi (bvar n2) (bvar n1)) (pi (pi (bvar n3) (pi (bvar n4) (pi (app (app (bvar n4) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D v) nz) (bvar n4)) (app (bvar n3) (bvar n2))) (app (bvar n3) (bvar n1)))))) (pi (app (app (quot u) (bvar n4)) (bvar n3)) (bvar n3))))))) $;

theorem quot_ind_ty (G: ctx) (u: lvl): $ ty G (quot_ind u) (pi (srt u) (pi (pi (bvar nz) (pi (bvar n1) Prop)) (pi (pi (app (app (quot u) (bvar n1)) (bvar nz)) Prop) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk u) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot u) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz))))))) $;

theorem quot_lift_mk_sty (G: ctx) (u v: lvl) (x1 x2 x3 x4 x5: expr) (v1: lvl) (y1 y2 a T: expr): $ sty G (quot_lift u v) (pi (srt u) (pi (pi (bvar nz) (pi (bvar n1) Prop)) (pi (srt v) (pi (pi (bvar n2) (bvar n1)) (pi (pi (bvar n3) (pi (bvar n4) (pi (app (app (bvar n4) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D v) nz) (bvar n4)) (app (bvar n3) (bvar n2))) (app (bvar n3) (bvar n1)))))) (pi (app (app (quot u) (bvar n4)) (bvar n3)) (bvar n3))))))) (app (app (app (app (app (app (quot_lift u v) x1) x2) x3) x4) x5) (app (app (app (quot_mk v1) y1) y2) a)) T $ > $ ty G a x1 $ > $ deq G (app (app (app (app (app (app (quot_lift u v) x1) x2) x3) x4) x5) (app (app (app (quot_mk v1) y1) y2) a)) (app x4 a) T $;

theorem quot_lift_mk (u v: lvl): $ deq (cons (bvar n4) (cons (pi (bvar n3) (pi (bvar n4) (pi (app (app (bvar n4) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D v) nz) (bvar n4)) (app (bvar n3) (bvar n2))) (app (bvar n3) (bvar n1)))))) (cons (pi (bvar n2) (bvar n1)) (cons (srt v) (cons (pi (bvar nz) (pi (bvar n1) Prop)) (cons (srt u) nil)))))) (app (app (app (app (app (app (quot_lift u v) (bvar n5)) (bvar n4)) (bvar n3)) (bvar n2)) (bvar n1)) (app (app (app (quot_mk u) (bvar n5)) (bvar n4)) (bvar nz))) (app (bvar n2) (bvar nz)) (bvar n3) $;

theorem lit_zero (G: ctx): $ deq G (lit b0) (ind_ctor nat_D nz nz) (ind_ty nat_D nz) $;

theorem lit_succ (G: ctx) (a b: bin): $ bsucc a b $ > $ deq G (lit b) (app (ind_ctor nat_D nz n1) (lit a)) (ind_ty nat_D nz) $;

theorem nat_add_lit (G: ctx) (f: expr) (a b c: bin): $ add_eqs G f $ > $ badd a b c $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

theorem nat_sub_lit (G: ctx) (f p: expr) (a b c: bin): $ sub_eqs G f p $ > $ badd c b a $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

theorem nat_sub_lit0 (G: ctx) (f p: expr) (a b c: bin): $ sub_eqs G f p $ > $ badd a c b $ > $ deq G (app (app f (lit a)) (lit b)) (lit b0) nat_ty $;

theorem nat_mul_lit (G: ctx) (f fa: expr) (a b c: bin): $ mul_eqs G f fa $ > $ bmul a b c $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

theorem nat_pow_lit (G: ctx) (f fm fa: expr) (a b c: bin): $ pow_eqs G f fm fa $ > $ bpow a b c $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

theorem nat_beq_lit (G: ctx) (f B t u: expr) (a: bin): $ beq_eqs G f B t u $ > $ deq G (app (app f (lit a)) (lit a)) t B $;

theorem nat_beq_lit_lt (G: ctx) (f B t u: expr) (a b c: bin): $ beq_eqs G f B t u $ > $ baddc a c b $ > $ deq G (app (app f (lit a)) (lit b)) u B $;

theorem nat_beq_lit_gt (G: ctx) (f B t u: expr) (a b c: bin): $ beq_eqs G f B t u $ > $ baddc b c a $ > $ deq G (app (app f (lit a)) (lit b)) u B $;

theorem nat_ble_lit (G: ctx) (f B t u: expr) (a b c: bin): $ ble_eqs G f B t u $ > $ badd a c b $ > $ deq G (app (app f (lit a)) (lit b)) t B $;

theorem nat_ble_lit_gt (G: ctx) (f B t u: expr) (a b c: bin): $ ble_eqs G f B t u $ > $ baddc b c a $ > $ deq G (app (app f (lit a)) (lit b)) u B $;

theorem nat_shl_lit (G: ctx) (f fm fa: expr) (a b p c: bin): $ shl_eqs G f fm fa $ > $ bpow (bd0 (bd1 b0)) b p $ > $ bmul a p c $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

theorem nat_shr_lit_z (G: ctx) (f fd: expr) (a: bin): $ shr_eqs G f fd $ > $ deq G (app (app f (lit a)) (lit b0)) (lit a) nat_ty $;

theorem nat_shr_lit_s (G: ctx) (f fd: expr) (a b b2 c c2: bin): $ shr_eqs G f fd $ > $ bsucc b b2 $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $ > $ deq G (app (app fd (lit c)) (lit (bd0 (bd1 b0)))) (lit c2) nat_ty $ > $ deq G (app (app f (lit a)) (lit b2)) (lit c2) nat_ty $;

theorem inh_i (G: ctx) (e A: expr): $ ty G e A $ > $ inh G A $;

-- --------------------------------------------------------------------------
-- The rules of the inductive types
-- --------------------------------------------------------------------------

theorem ind_ty_ty (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (i: nat) (F R: expr) (C: ctors): $ tys_ok G D $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ pis P F R $ > $ ty G (ind_ty D i) R $;

theorem ind_ctor_ty (G: ctx) (D: ind) (i c: nat) (R: expr): $ ind_wf G D $ > $ ctor_ty D i c R $ > $ ty G (ind_ctor D i c) R $;

theorem ind_rec_ty (G: ctx) (D: ind) (N: ctx) (i: nat) (v: lvl) (R0 R: expr): $ ind_wf G D $ > $ elim_ok G D v $ > $ rec_ty D v i R0 $ > $ ind_nested D N $ > $ rst D N R0 R $ > $ ty G (ind_rec D i v) R $;

theorem proj_ty (G: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (j i np: nat) (e e2 S A A1 A2 R: expr): $ deq G e e2 S $ > $ spine (ind_ty D j) S np $ > $ ind_wf G D $ > $ ind_data D b P T $ > $ struct_like D j $ > $ proj_ok G D j i $ > $ clen P np $ > $ field_ty D j i A $ > $ ind_nested D N $ > $ rst D N A A2 $ > $ pinst i S A2 A1 $ > $ qinst b e i nz A1 R $ > $ deq G (proj b i e) (proj b i e2) R $;



-- The relations of the division-like literal operations (S1)

--| The spec's `divmod_eqs`, over the judgments that hold in the model.
def divmod_eqs (G: ctx) (e1 e2 e3 e4: expr): wff = $ divmod_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 $;
--| The spec's `gcd_eqs`, over the judgments that hold in the model.
def gcd_eqs (G: ctx) (e1 e2 e3 e4 e5: expr): wff = $ gcd_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 e5 $;
--| The spec's `land_eqs`, over the judgments that hold in the model.
def land_eqs (G: ctx) (e1 e2 e3 e4 e5: expr): wff = $ land_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 e5 $;
--| The spec's `lor_eqs`, over the judgments that hold in the model.
def lor_eqs (G: ctx) (e1 e2 e3 e4 e5: expr): wff = $ lor_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 e5 $;
--| The spec's `xor_eqs`, over the judgments that hold in the model.
def xor_eqs (G: ctx) (e1 e2 e3 e4 e5: expr): wff = $ xor_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 e5 $;

theorem divmod_eqs_i (G: ctx) (fd fm fmul fadd h1 h2 h3: expr): $ mul_eqs G fmul fadd $ > $ closed nz fd $ > $ closed nz fm $ > $ ty G fd (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty G fm (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty G h1 (pi nat_ty (pi nat_ty (nat_eq (app (app fadd (app (app fmul (bvar nz)) (app (app fd (bvar n1)) (bvar nz)))) (app (app fm (bvar n1)) (bvar nz))) (bvar n1)))) $ > $ ty G h2 (pi nat_ty (pi nat_ty (pi (nat_lt lit0 (bvar nz)) (nat_lt (app (app fm (bvar n2)) (bvar n1)) (bvar n1))))) $ > $ ty G h3 (pi nat_ty (nat_eq (app (app fd (bvar nz)) lit0) lit0)) $ > $ divmod_eqs G fd fm fmul fadd $;

theorem gcd_eqs_i (G: ctx) (f fd fm fmul fadd h1 h2: expr): $ divmod_eqs G fd fm fmul fadd $ > $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty G h1 (pi nat_ty (nat_eq (app (app f lit0) (bvar nz)) (bvar nz))) $ > $ ty G h2 (pi nat_ty (pi nat_ty (nat_eq (app (app f (app nat_succ (bvar n1))) (bvar nz)) (app (app f (app (app fm (bvar nz)) (app nat_succ (bvar n1)))) (app nat_succ (bvar n1)))))) $ > $ gcd_eqs G f fd fm fmul fadd $;

theorem land_eqs_i (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs G fd fm fmul fadd $ > $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty G h (pi nat_ty (pi nat_ty (nat_eq (app (app f (bvar n1)) (bvar nz)) (app (app fadd (app (app fadd (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2))) (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2)))) (app (app fd (app (app fadd (app (app fm (bvar n1)) lit2)) (app (app fm (bvar nz)) lit2))) lit2))))) $ > $ land_eqs G f fd fm fmul fadd $;

theorem lor_eqs_i (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs G fd fm fmul fadd $ > $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty G h (pi nat_ty (pi nat_ty (nat_eq (app (app f (bvar n1)) (bvar nz)) (app (app fadd (app (app fadd (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2))) (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2)))) (app (app fd (app (app fadd (app (app fadd (app (app fm (bvar n1)) lit2)) (app (app fm (bvar nz)) lit2))) lit1)) lit2))))) $ > $ lor_eqs G f fd fm fmul fadd $;

theorem xor_eqs_i (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs G fd fm fmul fadd $ > $ closed nz f $ > $ ty G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty G h (pi nat_ty (pi nat_ty (nat_eq (app (app f (bvar n1)) (bvar nz)) (app (app fadd (app (app fadd (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2))) (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2)))) (app (app fm (app (app fadd (app (app fm (bvar n1)) lit2)) (app (app fm (bvar nz)) lit2))) lit2))))) $ > $ xor_eqs G f fd fm fmul fadd $;


-- The relations of the division-like literal operations (S1)



theorem nat_div_lit (G: ctx) (fd fm fmul fadd: expr) (a b q m r x: bin): $ divmod_eqs G fd fm fmul fadd $ > $ bmul b q m $ > $ badd m r a $ > $ baddc r x b $ > $ deq G (app (app fd (lit a)) (lit b)) (lit q) nat_ty $;

theorem nat_div_lit0 (G: ctx) (fd fm fmul fadd: expr) (a: bin): $ divmod_eqs G fd fm fmul fadd $ > $ deq G (app (app fd (lit a)) lit0) lit0 nat_ty $;

theorem nat_mod_lit (G: ctx) (fd fm fmul fadd: expr) (a b q m r x: bin): $ divmod_eqs G fd fm fmul fadd $ > $ bmul b q m $ > $ badd m r a $ > $ baddc r x b $ > $ deq G (app (app fm (lit a)) (lit b)) (lit r) nat_ty $;

theorem nat_mod_lit0 (G: ctx) (fd fm fmul fadd: expr) (a: bin): $ divmod_eqs G fd fm fmul fadd $ > $ deq G (app (app fm (lit a)) lit0) (lit a) nat_ty $;

theorem nat_gcd_lit (G: ctx) (f fd fm fmul fadd: expr) (a b g p2 q x y m n: bin): $ gcd_eqs G f fd fm fmul fadd $ > $ bmul g p2 a $ > $ bmul g q b $ > $ bmul x a m $ > $ bmul y b n $ > $ badd n g m $ > $ deq G (app (app f (lit a)) (lit b)) (lit g) nat_ty $;

theorem nat_gcd_lit2 (G: ctx) (f fd fm fmul fadd: expr) (a b g p2 q x y m n: bin): $ gcd_eqs G f fd fm fmul fadd $ > $ bmul g p2 a $ > $ bmul g q b $ > $ bmul x a m $ > $ bmul y b n $ > $ badd m g n $ > $ deq G (app (app f (lit a)) (lit b)) (lit g) nat_ty $;

theorem nat_land_lit (G: ctx) (f fd fm fmul fadd: expr) (a b c: bin): $ land_eqs G f fd fm fmul fadd $ > $ band a b c $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

theorem nat_lor_lit (G: ctx) (f fd fm fmul fadd: expr) (a b c: bin): $ lor_eqs G f fd fm fmul fadd $ > $ bor a b c $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

theorem nat_xor_lit (G: ctx) (f fd fm fmul fadd: expr) (a b c: bin): $ xor_eqs G f fd fm fmul fadd $ > $ bxor a b c $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;
