theorem nat_ble_lit (G: ctx) (f B t u: expr) (a b c: bin): $ ble_eqs G f B t u $ > $ badd a c b $ > $ deq G (app (app f (lit a)) (lit b)) t B $;

theorem nat_ble_lit_gt (G: ctx) (f B t u: expr) (a b c: bin): $ ble_eqs G f B t u $ > $ baddc b c a $ > $ deq G (app (app f (lit a)) (lit b)) u B $;

theorem nat_shl_lit (G: ctx) (f fm fa: expr) (a b p c: bin): $ shl_eqs G f fm fa $ > $ bpow (bd0 (bd1 b0)) b p $ > $ bmul a p c $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

theorem nat_shr_lit_z (G: ctx) (f fd: expr) (a: bin): $ shr_eqs G f fd $ > $ deq G (app (app f (lit a)) (lit b0)) (lit a) nat_ty $;

theorem nat_shr_lit_s (G: ctx) (f fd: expr) (a b b2 c c2: bin): $ shr_eqs G f fd $ > $ bsucc b b2 $ > $ deq G (app (app f (lit a)) (lit b)) (lit c) nat_ty $ > $ deq G (app (app fd (lit c)) (lit (bd0 (bd1 b0)))) (lit c2) nat_ty $ > $ deq G (app (app f (lit a)) (lit b2)) (lit c2) nat_ty $;

theorem nat_div_lit (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem: expr) (a b q m r x: bin): $ div_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem $ > $ bmul q b m $ > $ badd m r a $ > $ baddc r x b $ > $ deq G (app (app f (lit a)) (lit b)) (lit q) nat_ty $;

theorem nat_div_lit0 (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem: expr) (a: bin): $ div_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem $ > $ deq G (app (app f (lit a)) lit0) lit0 nat_ty $;

theorem nat_mod_lit (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem: expr) (a b q m r x: bin): $ mod_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem $ > $ bmul q b m $ > $ badd m r a $ > $ baddc r x b $ > $ deq G (app (app f (lit a)) (lit b)) (lit r) nat_ty $;

theorem nat_mod_lit0 (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem: expr) (a: bin): $ mod_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem $ > $ deq G (app (app f (lit a)) lit0) (lit a) nat_ty $;

