-- Proofs for pairs.mm0.

-- Proofs for pairs.mm0.
cpr_intro_r
-----------
l1: $ b ≐ b $ by ceqt_refl
l2: $ _ ⇒ b = a ∨ b = b $ by or_intro_r [l1]
l3: $ _ ⇒ b ∊ {y | y = a ∨ y = b} $ by cab_intro (x := $ y $, t := $ b $, p := $ y = a ∨ y = b $) [l2]
l4: $ G ⇒ b ∊ cpr a b $ by weaken [l3]

cpr_intro
---------
l1: $ G ⇒ c ∊ {y | y = A ∨ y = B} $ by cab_intro (x := $ y $, t := $ c $, p := $ y = A ∨ y = B $) [#1]

cpr_elim
--------
l1: $ G ⇒ c ∊ {y | y = A ∨ y = B} $ by weaken [#1]
l2: $ G ⇒ c = A ∨ c = B $ by cab_elim (x := $ y $, t := $ c $, p := $ y = A ∨ y = B $) [l1]

cpr_comm
--------
l1: $ G , u ∊ cpr A B ⇒ u ∊ cpr A B $ by ax
l2: $ G , u ∊ cpr A B ⇒ u = A ∨ u = B $ by cpr_elim [l1]
l3: $ G , u ∊ cpr A B ⇒ u = B ∨ u = A $ by or_comm [l2]
l4: $ G , u ∊ cpr A B ⇒ u ∊ cpr B A $ by cpr_intro [l3]
l5: $ G , u ∊ cpr B A ⇒ u ∊ cpr B A $ by ax
l6: $ G , u ∊ cpr B A ⇒ u = B ∨ u = A $ by cpr_elim [l5]
l7: $ G , u ∊ cpr B A ⇒ u = A ∨ u = B $ by or_comm [l6]
l8: $ G , u ∊ cpr B A ⇒ u ∊ cpr A B $ by cpr_intro [l7]
l9: $ G ⇒ cpr A B = cpr B A $ by eq_intro [l4, l8]

cpr_subset
----------
l1: $ G , u ∊ cpr a b ⇒ u ∊ cpr a b $ by ax
l2: $ G , u ∊ cpr a b ⇒ u = a ∨ u = b $ by cpr_elim [l1]
l3: $ G , u ∊ cpr a b , u = a ⇒ u = a $ by ax
l4: $ G , u ∊ cpr a b , u = a ⇒ a = u $ by eq_sym [l3]
l5: $ G , u ∊ cpr a b , u = a ⇒ a ∊ A $ by weaken [#1]
l6: $ G , u ∊ cpr a b , u = a ⇒ u ∊ A $ by welc_eq_set [l4, l5]
l7: $ G , u ∊ cpr a b , u = b ⇒ u = b $ by ax
l8: $ G , u ∊ cpr a b , u = b ⇒ b = u $ by eq_sym [l7]
l9: $ G , u ∊ cpr a b , u = b ⇒ b ∊ A $ by weaken [#2]
l10: $ G , u ∊ cpr a b , u = b ⇒ u ∊ A $ by welc_eq_set [l8, l9]
l11: $ G , u ∊ cpr a b ⇒ u ∊ A $ by or_elim [l2, l6, l10]
l12: $ G ⇒ cpr a b ⊆ A $ by subset_intro [l11]

cpr_set
-------
l1: $ G , u = A , v = B ⇒ u = A $ by ax
l2: $ G , u = A , v = B ⇒ v = B $ by ax
l3: $ G , u = A , v = B ⇒ cpr u v = cpr A B $ by cpr_eq [l1, l2]
l4: $ G , u = A , v = B ⇒ isset (cpr u v) $ by ax_pair
l5: $ G , u = A , v = B ⇒ isset (cpr A B) $ by isset_eq [l3, l4]
l6: $ G , u = A ⇒ isset (cpr A B) $ by isset_elim [#2, l5]
l7: $ G ⇒ isset (cpr A B) $ by isset_elim [#1, l6]

cpr_set_l
---------
c1: $ G ⇒ isset B ∨ ¬ isset B $ by excluded_middle
c2: $ G , isset B ⇒ isset A $ by weaken [#1]
c3: $ G , isset B ⇒ isset B $ by ax
c4: $ G , isset B ⇒ isset (cpr A B) $ by cpr_set [c2, c3]
c5: $ G , ¬ isset B , w ∊ cpr A B ⇒ w ∊ cpr A B $ by ax
c6: $ G , ¬ isset B , w ∊ cpr A B ⇒ w = A ∨ w = B $ by cpr_elim [c5]
c7: $ G , ¬ isset B , w ∊ cpr A B , w = A ⇒ w = A $ by ax
c8: $ G , ¬ isset B , w ∊ cpr A B , w = A ⇒ w = A ∨ w = A $ by or_intro_l [c7]
c9: $ G , ¬ isset B , w ∊ cpr A B , w = B ⇒ w = B $ by ax
c10: $ G , ¬ isset B , w ∊ cpr A B , w = B ⇒ isset B $ by isset_intro [c9]
c11: $ G , ¬ isset B , w ∊ cpr A B , w = B ⇒ ¬ isset B $ by ax
c12: $ G , ¬ isset B , w ∊ cpr A B , w = B ⇒ ⊥ $ by not_elim [c11, c10]
c13: $ G , ¬ isset B , w ∊ cpr A B , w = B ⇒ w = A ∨ w = A $ by bot_elim [c12]
c14: $ G , ¬ isset B , w ∊ cpr A B ⇒ w = A ∨ w = A $ by or_elim [c6, c8, c13]
c15: $ G , ¬ isset B , w ∊ cpr A B ⇒ w ∊ cpr A A $ by cpr_intro [c14]
d1: $ G , ¬ isset B , w ∊ cpr A A ⇒ w ∊ cpr A A $ by ax
d2: $ G , ¬ isset B , w ∊ cpr A A ⇒ w = A ∨ w = A $ by cpr_elim [d1]
d3: $ G , ¬ isset B , w ∊ cpr A A , w = A ⇒ w = A $ by ax
d4: $ G , ¬ isset B , w ∊ cpr A A , w = A ⇒ w = A ∨ w = B $ by or_intro_l [d3]
d5: $ G , ¬ isset B , w ∊ cpr A A ⇒ w = A ∨ w = B $ by or_elim [d2, d4, d4]
d6: $ G , ¬ isset B , w ∊ cpr A A ⇒ w ∊ cpr A B $ by cpr_intro [d5]
d7: $ G , ¬ isset B ⇒ cpr A A = cpr A B $ by eq_intro [d6, c15]
d8: $ G , ¬ isset B ⇒ isset A $ by weaken [#1]
d9: $ G , ¬ isset B ⇒ isset (cpr A A) $ by cpr_set [d8, d8]
d10: $ G , ¬ isset B ⇒ isset (cpr A B) $ by isset_eq [d7, d9]
d11: $ G ⇒ isset (cpr A B) $ by or_elim [c1, c4, d10]

csn_intro
---------
l1: $ G ⇒ a = A ∨ a = A $ by or_intro_l [#1]
l2: $ G ⇒ a ∊ cpr A A $ by cpr_intro [l1]

csn_intro_var
-------------
l1: $ G ⇒ a = a $ by eq_refl
l2: $ G ⇒ a ∊ csn a $ by csn_intro [l1]

csn_elim
--------
l1: $ G ⇒ a ∊ cpr A A $ by weaken [#1]
l2: $ G ⇒ a = A ∨ a = A $ by cpr_elim [l1]
l3: $ G , a = A ⇒ a = A $ by ax
l4: $ G ⇒ a = A $ by or_elim [l2, l3, l3]

csn_subset
----------
l1: $ G ⇒ cpr a a ⊆ A $ by cpr_subset [#1, #1]

csn_set
-------
l1: $ G ⇒ isset (cpr A A) $ by cpr_set [#1, #1]

csn_inj
-------
l1: $ G ⇒ a ∊ csn a $ by csn_intro_var
l2: $ G ⇒ a ∊ csn b $ by welc_eq [#1, l1]
l3: $ G ⇒ a = b $ by csn_elim [l2]

csn_eq_cpr
----------
l1: $ G ⇒ cpr b c = csn a $ by eq_sym [#1]
l2: $ G ⇒ b ∊ cpr b c $ by cpr_intro_l
l3: $ G ⇒ b ∊ csn a $ by welc_eq [l1, l2]
l4: $ G ⇒ b = a $ by csn_elim [l3]
l5: $ G ⇒ a = b $ by eq_sym [l4]
l6: $ G ⇒ c ∊ cpr b c $ by cpr_intro_r
l7: $ G ⇒ c ∊ csn a $ by welc_eq [l1, l6]
l8: $ G ⇒ c = a $ by csn_elim [l7]
l9: $ G ⇒ a = c $ by eq_sym [l8]
l10: $ G ⇒ a = b ∧ a = c $ by and_intro [l5, l9]

cpr_inj_r
---------
l1: $ G ⇒ b ∊ cpr a b $ by cpr_intro_r
l2: $ G ⇒ b ∊ cpr a c $ by welc_eq [#1, l1]
l3: $ G ⇒ b = a ∨ b = c $ by cpr_elim [l2]
l4: $ G , b = c ⇒ b = c $ by ax
l5: $ G ⇒ cpr a c = cpr a b $ by eq_sym [#1]
l6: $ G ⇒ c ∊ cpr a c $ by cpr_intro_r
l7: $ G ⇒ c ∊ cpr a b $ by welc_eq [l5, l6]
l8: $ G ⇒ c = a ∨ c = b $ by cpr_elim [l7]
l9: $ G , b = a ⇒ c = a ∨ c = b $ by weaken [l8]
l10: $ G , b = a , c = a ⇒ b = a $ by ax
l11: $ G , b = a , c = a ⇒ c = a $ by ax
l12: $ G , b = a , c = a ⇒ a = c $ by eq_sym [l11]
l13: $ G , b = a , c = a ⇒ b = c $ by eq_trans [l10, l12]
l14: $ G , b = a , c = b ⇒ c = b $ by ax
l15: $ G , b = a , c = b ⇒ b = c $ by eq_sym [l14]
l16: $ G , b = a ⇒ b = c $ by or_elim [l9, l13, l15]
l17: $ G ⇒ b = c $ by or_elim [l3, l16, l4]

opair_set
---------
l1: $ G ⇒ isset (csn A) $ by csn_set [#1]
l2: $ G ⇒ isset (cpr A B) $ by cpr_set [#1, #2]
l3: $ G ⇒ isset (cpr (csn A) (cpr A B)) $ by cpr_set [l1, l2]

opair_set_l
-----------
o1: $ G ⇒ isset (csn A) $ by csn_set [#1]
o2: $ G ⇒ isset (cpr (csn A) (cpr A B)) $ by cpr_set_l [o1]

cpr_eq_elim_l
-------------
l1: $ G , u = A ⇒ u = A $ by ax
l2: $ G , u = A ⇒ u = A ∨ u = B $ by or_intro_l [l1]
l3: $ G , u = A ⇒ u ∊ cpr A B $ by cpr_intro [l2]
l4: $ G , u = A ⇒ cpr A B = cpr C D $ by weaken [#1]
l5: $ G , u = A ⇒ u ∊ cpr C D $ by welc_eq [l4, l3]
l6: $ G , u = A ⇒ u = C ∨ u = D $ by cpr_elim [l5]
l7: $ G , u = A ⇒ A = u $ by eq_sym [l1]
l8: $ G , u = A , u = C ⇒ A = u $ by weaken [l7]
l9: $ G , u = A , u = C ⇒ u = C $ by ax
l10: $ G , u = A , u = C ⇒ A = C $ by eq_trans [l8, l9]
l11: $ G , u = A , u = C ⇒ A = C ∨ A = D $ by or_intro_l [l10]
l12: $ G , u = A , u = D ⇒ A = u $ by weaken [l7]
l13: $ G , u = A , u = D ⇒ u = D $ by ax
l14: $ G , u = A , u = D ⇒ A = D $ by eq_trans [l12, l13]
l15: $ G , u = A , u = D ⇒ A = C ∨ A = D $ by or_intro_r [l14]
l16: $ G , u = A ⇒ A = C ∨ A = D $ by or_elim [l6, l11, l15]
l17: $ G ⇒ A = C ∨ A = D $ by isset_elim [#2, l16]

cpr_eq_elim_r
-------------
l1: $ G ⇒ cpr B A = cpr A B $ by cpr_comm
l2: $ G ⇒ cpr B A = cpr C D $ by eq_trans [l1, #1]
l3: $ G ⇒ B = C ∨ B = D $ by cpr_eq_elim_l [l2, #2]

opair_inj_l
-----------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset (csn a) $ by csn_set [l1]
l3: $ G ⇒ cpr (csn a) (cpr a b) = cpr (csn c) (cpr c d) $ by weaken [#1]
l4: $ G ⇒ csn a = csn c ∨ csn a = cpr c d $ by cpr_eq_elim_l [l3, l2]
l5: $ G , csn a = csn c ⇒ csn a = csn c $ by ax
l6: $ G , csn a = csn c ⇒ a = c $ by csn_inj [l5]
l7: $ G , csn a = cpr c d ⇒ csn a = cpr c d $ by ax
l8: $ G , csn a = cpr c d ⇒ a = c ∧ a = d $ by csn_eq_cpr [l7]
l9: $ G , csn a = cpr c d ⇒ a = c $ by and_elim_l [l8]
l10: $ G ⇒ a = c $ by or_elim [l4, l6, l9]

opair_inj_r
-----------
l1: $ G ⇒ a = c $ by opair_inj_l [#1]
l2: $ G ⇒ cpr (csn a) (cpr a b) = cpr (csn c) (cpr c d) $ by weaken [#1]
l3: $ G ⇒ cpr (csn c) (cpr c d) = cpr (csn a) (cpr a b) $ by eq_sym [l2]
l4: $ G ⇒ isset (cpr a b) $ by ax_pair
l5: $ G ⇒ isset (cpr c d) $ by ax_pair
l6: $ G ⇒ cpr a b = csn c ∨ cpr a b = cpr c d $ by cpr_eq_elim_r [l2, l4]
l7: $ G ⇒ cpr c d = csn a ∨ cpr c d = cpr a b $ by cpr_eq_elim_r [l3, l5]
l8: $ G ⇒ d = d $ by eq_refl
l9: $ G ⇒ cpr a d = cpr c d $ by cpr_eq [l1, l8]
l10: $ G , cpr c d = cpr a b ⇒ cpr c d = cpr a b $ by ax
l11: $ G , cpr c d = cpr a b ⇒ cpr a d = cpr c d $ by weaken [l9]
l12: $ G , cpr c d = cpr a b ⇒ cpr a d = cpr a b $ by eq_trans [l11, l10]
l13: $ G , cpr c d = cpr a b ⇒ d = b $ by cpr_inj_r [l12]
l14: $ G , cpr c d = cpr a b ⇒ b = d $ by eq_sym [l13]
l15: $ G , cpr c d = csn a ⇒ cpr c d = csn a $ by ax
l16: $ G , cpr c d = csn a ⇒ csn a = cpr c d $ by eq_sym [l15]
l17: $ G , cpr c d = csn a ⇒ a = c ∧ a = d $ by csn_eq_cpr [l16]
l18: $ G , cpr c d = csn a ⇒ a = d $ by and_elim_r [l17]
l19: $ G , cpr c d = csn a ⇒ cpr a b = csn c ∨ cpr a b = cpr c d $ by weaken [l6]
l20: $ G , cpr c d = csn a , cpr a b = cpr c d ⇒ cpr a b = cpr c d $ by ax
l21: $ G , cpr c d = csn a , cpr a b = cpr c d ⇒ cpr c d = cpr a b $ by eq_sym [l20]
l22: $ G , cpr c d = csn a , cpr a b = cpr c d ⇒ cpr a d = cpr c d $ by weaken [l9]
l23: $ G , cpr c d = csn a , cpr a b = cpr c d ⇒ cpr a d = cpr a b $ by eq_trans [l22, l21]
l24: $ G , cpr c d = csn a , cpr a b = cpr c d ⇒ d = b $ by cpr_inj_r [l23]
l25: $ G , cpr c d = csn a , cpr a b = cpr c d ⇒ b = d $ by eq_sym [l24]
l26: $ G , cpr c d = csn a , cpr a b = csn c ⇒ cpr a b = csn c $ by ax
l27: $ G , cpr c d = csn a , cpr a b = csn c ⇒ csn c = cpr a b $ by eq_sym [l26]
l28: $ G , cpr c d = csn a , cpr a b = csn c ⇒ c = a ∧ c = b $ by csn_eq_cpr [l27]
l29: $ G , cpr c d = csn a , cpr a b = csn c ⇒ c = b $ by and_elim_r [l28]
l30: $ G , cpr c d = csn a , cpr a b = csn c ⇒ b = c $ by eq_sym [l29]
l31: $ G , cpr c d = csn a , cpr a b = csn c ⇒ c = a $ by and_elim_l [l28]
l32: $ G , cpr c d = csn a , cpr a b = csn c ⇒ b = a $ by eq_trans [l30, l31]
l33: $ G , cpr c d = csn a , cpr a b = csn c ⇒ a = d $ by weaken [l18]
l34: $ G , cpr c d = csn a , cpr a b = csn c ⇒ b = d $ by eq_trans [l32, l33]
l35: $ G , cpr c d = csn a ⇒ b = d $ by or_elim [l19, l34, l25]
l36: $ G ⇒ b = d $ by or_elim [l7, l35, l14]

--| The diagonal of a class: the pairs `⟨ y , y ⟩` with `y ∊ A` (for separation).
def sep_diag (A: class) (.w .y: set): class = $ {w | ∃ y (y ∊ A ∧ w = ⟨ y , y ⟩)} $

lemma sep_diag_elim (G: hyps) (A: class) (a b: set):
  $ G ⇒ ⟨ a , b ⟩ ∈ sep_diag A $ > $ G ⇒ a = b ∧ a ∊ A $
----
l1: $ G , k = ⟨ a , b ⟩ , k ∊ sep_diag A ⇒ k ∊ sep_diag A $ by ax
l2: $ G , k = ⟨ a , b ⟩ , k ∊ sep_diag A ⇒ k ∊ {w | ∃ y (y ∊ A ∧ w = ⟨ y , y ⟩)} $ by weaken [l1]
l3: $ G , k = ⟨ a , b ⟩ , k ∊ sep_diag A ⇒ ∃ y (y ∊ A ∧ k = ⟨ y , y ⟩) $ by cab_elim (x := $ w $, t := $ k $, p := $ ∃ y (y ∊ A ∧ w = ⟨ y , y ⟩) $) [l2]
l4: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ y ∊ A ∧ k = ⟨ y , y ⟩ $ by ax
l5: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ k = ⟨ y , y ⟩ $ by and_elim_r [l4]
l6: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ y ∊ A $ by and_elim_l [l4]
l7: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ k = ⟨ a , b ⟩ $ by ax
l8: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ ⟨ a , b ⟩ = k $ by eq_sym [l7]
l9: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ ⟨ a , b ⟩ = ⟨ y , y ⟩ $ by eq_trans [l8, l5]
l10: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ a = y $ by opair_inj_l [l9]
l11: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ b = y $ by opair_inj_r [l9]
l12: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ y = b $ by eq_sym [l11]
l13: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ a = b $ by eq_trans [l10, l12]
l14: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ y = a $ by eq_sym [l10]
l15: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ a ∊ A $ by welc_eq_set [l14, l6]
l16: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ a = b ∧ a ∊ A $ by and_intro [l13, l15]
l17: $ G , k = ⟨ a , b ⟩ , k ∊ sep_diag A ⇒ a = b ∧ a ∊ A $ by ex_elim [l3, l16]
l18: $ G ⇒ a = b ∧ a ∊ A $ by wcel_elim [#1, l17]

lemma sep_diag_intro (G: hyps) (A: class) (a: set):
  $ G ⇒ a ∊ A $ > $ G ⇒ ⟨ a , a ⟩ ∈ sep_diag A $
----
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset ⟨ a , a ⟩ $ by opair_set [l1, l1]
l3: $ G , k = ⟨ a , a ⟩ ⇒ k = ⟨ a , a ⟩ $ by ax
l4: $ G , k = ⟨ a , a ⟩ ⇒ a ∊ A $ by weaken [#1]
l5: $ G , k = ⟨ a , a ⟩ ⇒ a ∊ A ∧ k = ⟨ a , a ⟩ $ by and_intro [l4, l3]
l6: $ G , k = ⟨ a , a ⟩ ⇒ ∃ y (y ∊ A ∧ k = ⟨ y , y ⟩) $ by ex_intro (t := $ a $) [l5]
l7: $ G , k = ⟨ a , a ⟩ ⇒ k ∊ {w | ∃ y (y ∊ A ∧ w = ⟨ y , y ⟩)} $ by cab_intro (x := $ w $, t := $ k $, p := $ ∃ y (y ∊ A ∧ w = ⟨ y , y ⟩) $) [l6]
l8: $ G , k = ⟨ a , a ⟩ ⇒ k ∊ sep_diag A $ by weaken [l7]
l9: $ G , k = ⟨ a , a ⟩ ⇒ ⟨ a , a ⟩ ∈ sep_diag A $ by wcel_intro [l3, l8]
l10: $ G ⇒ ⟨ a , a ⟩ ∈ sep_diag A $ by isset_elim [l2, l9]

lemma sep_diag_fun (G: hyps) (A: class): $ G ⇒ functional (sep_diag A) $
----
l1: $ G , ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A ⇒ ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A $ by ax
l2: $ G , ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A ⇒ ⟨ u , v ⟩ ∈ sep_diag A $ by and_elim_l [l1]
l3: $ G , ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A ⇒ ⟨ u , z ⟩ ∈ sep_diag A $ by and_elim_r [l1]
l4: $ G , ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A ⇒ u = v ∧ u ∊ A $ by sep_diag_elim [l2]
l5: $ G , ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A ⇒ u = z ∧ u ∊ A $ by sep_diag_elim [l3]
l6: $ G , ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A ⇒ u = v $ by and_elim_l [l4]
l7: $ G , ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A ⇒ u = z $ by and_elim_l [l5]
