l2: $ G ⇒ ⟨ x , y ⟩ ∈ F → ⟨ x , z ⟩ ∈ F → y = z $ by imp_intro [l1]
l3: $ G , ⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F $ by ax
l4: $ G , ⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , y ⟩ ∈ F $ by and_elim_l [l3]
l5: $ G , ⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , z ⟩ ∈ F $ by and_elim_r [l3]
l6: $ G , ⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , y ⟩ ∈ F → ⟨ x , z ⟩ ∈ F → y = z $ by weaken [l2]
l7: $ G , ⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , z ⟩ ∈ F → y = z $ by imp_elim [l6, l4]
l8: $ G , ⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F ⇒ y = z $ by imp_elim [l7, l5]
l9: $ G ⇒ ⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F → y = z $ by imp_intro [l8]
l10: $ G ⇒ ∀ z (⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F → y = z) $ by all_intro [l9]
l11: $ G ⇒ ∀ y ∀ z (⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F → y = z) $ by all_intro [l10]
l12: $ G ⇒ ∀ x ∀ y ∀ z (⟨ x , y ⟩ ∈ F ∧ ⟨ x , z ⟩ ∈ F → y = z) $ by all_intro [l11]

functional_elim
---------------
l1: $ G ⇒ ∀ y ∀ z (⟨ a , y ⟩ ∈ F ∧ ⟨ a , z ⟩ ∈ F → y = z) $ by all_elim [#1]
l2: $ G ⇒ ∀ z (⟨ a , b ⟩ ∈ F ∧ ⟨ a , z ⟩ ∈ F → b = z) $ by all_elim [l1]
l3: $ G ⇒ ⟨ a , b ⟩ ∈ F ∧ ⟨ a , c ⟩ ∈ F → b = c $ by all_elim [l2]
l4: $ G ⇒ ⟨ a , b ⟩ ∈ F ∧ ⟨ a , c ⟩ ∈ F $ by and_intro [#2, #3]
l5: $ G ⇒ b = c $ by imp_elim [l3, l4]

cin_intro
---------
l1: $ G ⇒ a ∊ A ∧ a ∊ B $ by and_intro [#1, #2]
l2: $ G ⇒ a ∊ {z | z ∊ A ∧ z ∊ B} $ by cab_intro (x := $ z $, t := $ a $, p := $ z ∊ A ∧ z ∊ B $) [l1]

cin_elim_l
----------
l1: $ G ⇒ a ∊ A ∧ a ∊ B $ by cab_elim (x := $ z $, t := $ a $, p := $ z ∊ A ∧ z ∊ B $) [#1]
l2: $ G ⇒ a ∊ A $ by and_elim_l [l1]

cin_elim_r
----------
l1: $ G ⇒ a ∊ A ∧ a ∊ B $ by cab_elim (x := $ z $, t := $ a $, p := $ z ∊ A ∧ z ∊ B $) [#1]
l2: $ G ⇒ a ∊ B $ by and_elim_r [l1]

cin_congr
---------
l0: $ seqt z z $ by seqt_refl
l1: $ (z ∊ A) ⟺ (z ∊ B) $ by welc_congr [l0, #1]
l2: $ (z ∊ C) ⟺ (z ∊ D) $ by welc_congr [l0, #2]
l3: $ (z ∊ A ∧ z ∊ C) ⟺ (z ∊ B ∧ z ∊ D) $ by and_congr [l1, l2]
l4: $ {z | z ∊ A ∧ z ∊ C} ≐ {z | z ∊ B ∧ z ∊ D} $ by cab_congr [l3]

cin_eq
------
l1: $ G , z ∊ A ∩ C ⇒ z ∊ A ∩ C $ by ax
l2: $ G , z ∊ A ∩ C ⇒ z ∊ A $ by cin_elim_l [l1]
l3: $ G , z ∊ A ∩ C ⇒ z ∊ C $ by cin_elim_r [l1]
l4: $ G , z ∊ A ∩ C ⇒ A = B $ by weaken [#1]
l5: $ G , z ∊ A ∩ C ⇒ C = D $ by weaken [#2]
l6: $ G , z ∊ A ∩ C ⇒ z ∊ B $ by welc_eq [l4, l2]
l7: $ G , z ∊ A ∩ C ⇒ z ∊ D $ by welc_eq [l5, l3]
l8: $ G , z ∊ A ∩ C ⇒ z ∊ B ∩ D $ by cin_intro [l6, l7]
l9: $ G ⇒ B = A $ by eq_sym [#1]
l10: $ G ⇒ D = C $ by eq_sym [#2]
l11: $ G , z ∊ B ∩ D ⇒ z ∊ B ∩ D $ by ax
l12: $ G , z ∊ B ∩ D ⇒ z ∊ B $ by cin_elim_l [l11]
l13: $ G , z ∊ B ∩ D ⇒ z ∊ D $ by cin_elim_r [l11]
l14: $ G , z ∊ B ∩ D ⇒ B = A $ by weaken [l9]
l15: $ G , z ∊ B ∩ D ⇒ D = C $ by weaken [l10]
l16: $ G , z ∊ B ∩ D ⇒ z ∊ A $ by welc_eq [l14, l12]
l17: $ G , z ∊ B ∩ D ⇒ z ∊ C $ by welc_eq [l15, l13]
l18: $ G , z ∊ B ∩ D ⇒ z ∊ A ∩ C $ by cin_intro [l16, l17]
l19: $ G ⇒ A ∩ C = B ∩ D $ by eq_intro [l8, l18]

sb_c_cin
--------
l1: $ (⟦ x / t ⟧ {y | y ∊ A ∧ y ∊ B}) ≐ {y | y ∊ (⟦ x / t ⟧ A) ∧ y ∊ (⟦ x / t ⟧ B)} $ by ceqt_refl

cin_comm
--------
l1: $ G , z ∊ A ∩ B ⇒ z ∊ A ∩ B $ by ax
l2: $ G , z ∊ A ∩ B ⇒ z ∊ A $ by cin_elim_l [l1]
l3: $ G , z ∊ A ∩ B ⇒ z ∊ B $ by cin_elim_r [l1]
l4: $ G , z ∊ A ∩ B ⇒ z ∊ B ∩ A $ by cin_intro [l3, l2]
l5: $ G , z ∊ B ∩ A ⇒ z ∊ B ∩ A $ by ax
l6: $ G , z ∊ B ∩ A ⇒ z ∊ B $ by cin_elim_l [l5]
l7: $ G , z ∊ B ∩ A ⇒ z ∊ A $ by cin_elim_r [l5]
l8: $ G , z ∊ B ∩ A ⇒ z ∊ A ∩ B $ by cin_intro [l7, l6]
l9: $ G ⇒ A ∩ B = B ∩ A $ by eq_intro [l4, l8]

cin_subset_l
------------
l1: $ G , z ∊ A ∩ B ⇒ z ∊ A ∩ B $ by ax
l2: $ G , z ∊ A ∩ B ⇒ z ∊ A $ by cin_elim_l [l1]
l3: $ G ⇒ A ∩ B ⊆ A $ by subset_intro [l2]

cin_subset_r
------------
l1: $ G , z ∊ A ∩ B ⇒ z ∊ A ∩ B $ by ax
l2: $ G , z ∊ A ∩ B ⇒ z ∊ B $ by cin_elim_r [l1]
l3: $ G ⇒ A ∩ B ⊆ B $ by subset_intro [l2]

cin_set_l
---------
l1: $ x = A ⇒ x = A $ by ax
l2: $ x = A ⇒ A = x $ by eq_sym [l1]
l3: $ x = A ⇒ A ∩ B ⊆ A $ by cin_subset_l
l4: $ x = A ⇒ A ∩ B ⊆ x $ by subset_eq_r [l2, l3]
l5: $ x = A ⇒ isset (A ∩ B) $ by subset_set [l4]
l6: $ G ⇒ isset (A ∩ B) $ by isset_elim [#1, l5]
