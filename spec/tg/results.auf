consistency
-----------
l1: $ _ ⇒ ⊥ $ by lean_consistent [#1]

standardness
------------
l1: $ G ⇒ (∃ z (z ∊ dt u (mcv hfin) (lsent b E M c) w ∅) ↔ U₁ ⊨ c) $ by pset_truth [#1, #2, #3, #4]

readback
--------
l1: $ _ ⇒ U₁ ⊨ c $ by pset_readback [#1, #2, #3, #4]

ch_meaning
----------
l1: $ G ⇒ (U ⊨ ch_code ↔ r_ch U) $ by ch_sat [#1]

ch_proved
---------
l1: $ _ ⇒ r_ch U₁ $ by ch_readback [#1, #2, #3]

ch_refuted
----------
l1: $ _ ⇒ ¬ r_ch U₁ $ by nch_readback [#1, #2, #3]
