-- model-quot.mm0: the quotient primitives (layer F of the reduction, audit §11):
-- the classes of the equivalence a relation generates, the environment of the
-- constants (`Env`, `Envx`) and their part of the hook (`hcst`), the values of
-- `Quot`, `Quot.mk`, `Quot.lift` and `Quot.ind` as the environment's at their
-- atoms, and their rules in the model. Imports model-nst.mm0; proofs in
-- model-quot.auf.

import "model-nst.mm0";


-- --------------------------------------------------------------------------
-- The classes of the equivalence a relation generates
-- --------------------------------------------------------------------------

--| `C` is closed under the relation `R` on `A`, in both directions: with `p` it has every `q` of `A` that `R`
--| relates to `p` or `p` to (`R` a curried trace: `R p q` holds when its value at `p`, `q` has an element).
def qclo (A R C: class) (.p .q .z: set): fml =
  $ ∀ p (∀ q ((p ∊ C) → ((q ∊ A) → (((∃ z (z ∊ (ap (ap R p) q))) ∨ (∃ z (z ∊ (ap (ap R q) p)))) → (q ∊ C))))) $;
--| @congr
theorem qclo_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ qclo A C E ⟺ qclo B D F $;
--| @rewrite
theorem sb_f_qclo {x: set} (t: set x) (A B C: class x):
  $ [ x / t ] (qclo A B C) ⟺ qclo ([[ x / t ]] A) ([[ x / t ]] B) ([[ x / t ]] C) $;

--| The class of `X` in the equivalence `R` generates on `A`: the least closed set with `X`.
def qcl (A R X: class) (.y .c: set): class =
  $ {y | ∀ c ((X ∈ c) → ((qclo A R c) → (y ∊ c)))} $;
--| @congr
theorem qcl_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ qcl A C E ≐ qcl B D F $;
--| @rewrite
theorem sb_c_qcl {x: set} (t: set x) (A B C: class x):
  $ ([[ x / t ]] (qcl A B C)) ≐ qcl ([[ x / t ]] A) ([[ x / t ]] B) ([[ x / t ]] C) $;

--| An element is in its class.
theorem qcl_self (G: hyps) (A R: class) (a: set): $ G ⇒ a ∊ qcl A R a $;

--| The class is inside every closed set with the element.
theorem qcl_min (G: hyps) (A R C: class) (a b: set):
  $ G ⇒ isset C $ > $ G ⇒ b ∊ qcl A R a $ > $ G ⇒ a ∊ C $ > $ G ⇒ qclo A R C $ > $ G ⇒ b ∊ C $;

--| A class is inside the carrier.
theorem qcl_sub (G: hyps) (A R: class) (a: set): $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ qcl A R a ⊆ A $;

theorem qcl_set (G: hyps) (A R: class) (a: set): $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ isset (qcl A R a) $;

--| A class is closed.
theorem qcl_clo (G: hyps) (A R: class) (a: set): $ G ⇒ qclo A R (qcl A R a) $;

--| An element of a class has the same class.
theorem qcl_eq (G: hyps) (A R: class) (a b: set):
  $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ b ∊ qcl A R a $ > $ G ⇒ qcl A R b = qcl A R a $;

--| Related elements are in one class.
theorem qcl_rel (G: hyps) (A R: class) (a b c: set): $ G ⇒ b ∊ A $ > $ G ⇒ c ∊ ap (ap R a) b $ > $ G ⇒ b ∊ qcl A R a $;


-- --------------------------------------------------------------------------
-- The quotient of a set by a relation
-- --------------------------------------------------------------------------

--| The quotient of `A` by `R`: the classes; `A` itself when `A` is a proposition (an element of `two`), since the
--| types of the model in `Prop` have at most the element `∅`.
def qty (A R: class) (.c .a: set): class =
  $ {c | ((A ∈ two) ∧ (c ∊ A)) ∨ ((¬ (A ∈ two)) ∧ (∃ a ((a ∊ A) ∧ (c = (qcl A R a)))))} $;
--| @congr
theorem qty_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ qty A C ≐ qty B D $;
--| @rewrite
theorem sb_c_qty {x: set} (t: set x) (A B: class x):
  $ ([[ x / t ]] (qty A B)) ≐ qty ([[ x / t ]] A) ([[ x / t ]] B) $;

--| The class of `X` as an element of the quotient (`∅` at a proposition).
def qmk (A R X: class) (.y: set): class =
  $ {y | (¬ (A ∈ two)) ∧ (y ∊ (qcl A R X))} $;
--| @congr
theorem qmk_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ qmk A C E ≐ qmk B D F $;
--| @rewrite
theorem sb_c_qmk {x: set} (t: set x) (A B C: class x):
  $ ([[ x / t ]] (qmk A B C)) ≐ qmk ([[ x / t ]] A) ([[ x / t ]] B) ([[ x / t ]] C) $;

--| The lift of the trace `F` at the element `Q` of the quotient of `A`: the values of `F` at the elements of `Q`
--| (at `∅` when `A` is a proposition).
def qlift (A F Q: class) (.y .a: set): class =
  $ {y | ((A ∈ two) ∧ (y ∊ (ap F ∅))) ∨ ((¬ (A ∈ two)) ∧ (∃ a ((a ∊ Q) ∧ (y ∊ (ap F a)))))} $;
--| @congr
theorem qlift_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ qlift A C E ≐ qlift B D F $;
--| @rewrite
theorem sb_c_qlift {x: set} (t: set x) (A B C: class x):
  $ ([[ x / t ]] (qlift A B C)) ≐ qlift ([[ x / t ]] A) ([[ x / t ]] B) ([[ x / t ]] C) $;

--| The trace `F` has one value at related elements of `A`.
def qresp (A R F: class) (.a .b .z: set): fml =
  $ ∀ a (∀ b ((a ∊ A) → ((b ∊ A) → ((∃ z (z ∊ (ap (ap R a) b))) → ((ap F a) = (ap F b)))))) $;
--| @congr
theorem qresp_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ qresp A C E ⟺ qresp B D F $;
--| @rewrite
theorem sb_f_qresp {x: set} (t: set x) (A B C: class x):
  $ [ x / t ] (qresp A B C) ⟺ qresp ([[ x / t ]] A) ([[ x / t ]] B) ([[ x / t ]] C) $;

--| The truth value of `X = Y`: `csn ∅` or `∅`.
def teq (X Y: class) (.y: set): class =
  $ {y | (y = ∅) ∧ (X = Y)} $;
--| @congr
theorem teq_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ teq A C ≐ teq B D $;
--| @rewrite
theorem sb_c_teq {x: set} (t: set x) (A B: class x):
  $ ([[ x / t ]] (teq A B)) ≐ teq ([[ x / t ]] A) ([[ x / t ]] B) $;

--| The space of the proofs that `F` respects `R` (the value of `Π p q. R p q → F p = F q`, with `teq` for the equation).
def qhd (A R F: class) (.p .q .z: set): class =
  $ Πₛ p ∈ A, (Πₛ q ∈ A, (Πₛ z ∈ ap (ap R p) q, teq (ap F p) (ap F q))) $;
--| @congr
theorem qhd_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ qhd A C E ≐ qhd B D F $;
--| @rewrite
theorem sb_c_qhd {x: set} (t: set x) (A B C: class x):
  $ ([[ x / t ]] (qhd A B C)) ≐ qhd ([[ x / t ]] A) ([[ x / t ]] B) ([[ x / t ]] C) $;

--| At a proposition the quotient is the proposition.
theorem qty_prop (G: hyps) (A R: class): $ G ⇒ A ∈ two $ > $ G ⇒ qty A R = A $;

theorem qmk_prop (G: hyps) (A R X: class): $ G ⇒ A ∈ two $ > $ G ⇒ qmk A R X = ∅ $;

theorem qmk_cls (G: hyps) (A R X: class): $ G ⇒ ¬ A ∈ two $ > $ G ⇒ qmk A R X = qcl A R X $;

--| A class is an element of the quotient.
theorem qty_cls (G: hyps) (A R: class) (a: set): $ G ⇒ ¬ A ∈ two $ > $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ qcl A R a ∈ qty A R $;

--| The class of an element of `A` is an element of the quotient.
theorem qmk_in (G: hyps) (A R: class) (a: set): $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ qmk A R a ∈ qty A R $;

--| Every element of the quotient is the class of an element of `A`.
--| @freshen G a
theorem qty_elim {a: set} (G: hyps) (A R: class) (c: set): $ G ⇒ c ∊ qty A R $ > $ G ⇒ ∃ a (a ∊ A ∧ c = qmk A R a) $;

--| The quotient of an element of `U_n` is an element of `U_n`.
theorem qty_uni (G: hyps) (R: class) (a n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ a ∊ uni' n $ > $ G ⇒ qty a R ∈ uni' n $;

theorem qlift_prop (G: hyps) (A F Q: class): $ G ⇒ A ∈ two $ > $ G ⇒ qlift A F Q = ap F ∅ $;

--| @freshen G z
theorem qresp_elim {z: set} (G: hyps) (A R F: class) (a b: set):
  $ G ⇒ qresp A R F $ > $ G ⇒ a ∊ A $ > $ G ⇒ b ∊ A $ > $ G ⇒ ∃ z (z ∊ ap (ap R a) b) $ > $ G ⇒ ap F a = ap F b $;

theorem teq_elim (G: hyps) (X Y: class) (a: set): $ G ⇒ a ∊ teq X Y $ > $ G ⇒ X = Y $;

theorem teq_set (G: hyps) (X Y: class): $ G ⇒ isset (teq X Y) $;

theorem qhd_set (G: hyps) (A R F: class): $ G ⇒ isset A $ > $ G ⇒ isset R $ > $ G ⇒ isset (qhd A R F) $;

--| A proof that `F` respects `R` gives that it does.
theorem qhd_resp (G: hyps) (A R F: class) (h: set): $ G ⇒ h ∊ qhd A R F $ > $ G ⇒ qresp A R F $;

theorem qlift_eq (G: hyps) (A F Q Q2: class): $ G ⇒ Q = Q2 $ > $ G ⇒ qlift A F Q = qlift A F Q2 $;

--| The lift at a class is the value at its element, for a trace that respects the relation.
theorem qlift_mk (G: hyps) (A R F: class) (a: set):
  $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ qresp A R F $ > $ G ⇒ qlift A F (qmk A R a) = ap F a $;


-- --------------------------------------------------------------------------
-- The environment of the constants
-- --------------------------------------------------------------------------
-- A constant `cst a S` has the value the environment gives its atom at the
-- values of the levels `S`. For a certificate's opaque and axiomatic constants
-- that is a parameter of the model, a class `Env` with no axioms; at the seven
-- atoms of the spec (the quotient primitives, `propext`, `Quot.sound`,
-- `Classical.choice`) the environment `Envx` has the values the rules need.

--| The truth value of "`A` has an element".
def tne (A: class) (.h .y: set): class =
  $ {h | (h = ∅) ∧ (∃ y (y ∊ A))} $;
--| @congr
theorem tne_congr (A B: class): $ A ≐ B $ > $ tne A ≐ tne B $;
--| @rewrite
theorem sb_c_tne {x: set} (t: set x) (A: class x):
  $ ([[ x / t ]] (tne A)) ≐ tne ([[ x / t ]] A) $;

--| The value of `Classical.choice` at the level value `N`: at a type `a` of that universe and a proof that `a` has an
--| element, the choice operator's element of `a`.
def chv (N: class) (.a .h: set): class = $ λₛ a ∈ uni' N, (λₛ h ∈ tne a, ch a) $;
--| @congr
theorem chv_congr (A B: class): $ A ≐ B $ > $ chv A ≐ chv B $;
--| @rewrite
theorem sb_c_chv {x: set} (t: set x) (A: class x): $ ([[ x / t ]] (chv A)) ≐ chv ([[ x / t ]] A) $;

theorem chv_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ chv A = chv B $;

--| The environment of the opaque constants. No axiom mentions it.
term Env: class;

--| The graph of the choice function at the atom of `Classical.choice`: the value at a universe and a list of level values is
--| `chv` at the list's first.
def Envc (.e .x .y: set): class = $ {e | ∃ x ∃ y (e = ⟨ ⟨ x , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , y ⟩ ⟩ , chv (y' ∅) ⟩)} $;

--| The graph of the quotients at the atom of `Quot`: at a list of level values, the trace over the types `a` of the
--| universe of the list's first and the relations `r` on `a`, of the quotient `qty a r`.
def Envq (.e .x .y .a .r .i .j: set): class = $ {e | ∃ x ∃ y (e = ⟨ ⟨ x , ⟨ ⟨ kc_quot_atom , ∅ ⟩ , y ⟩ ⟩ , sclip (λₛ a ∈ uni' y' ∅, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), qty a r)) ⟩)} $;

--| The graph at the atom of `Quot.mk`: the trace of the classes `qmk a r c`.
def Envqm (.e .x .y .a .r .i .j .c: set): class = $ {e | ∃ x ∃ y (e = ⟨ ⟨ x , ⟨ ⟨ kc_quot_mk_atom , ∅ ⟩ , y ⟩ ⟩ , sclip (λₛ a ∈ uni' y' ∅, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), (λₛ c ∈ a, qmk a r c))) ⟩)} $;

--| The graph at the atom of `Quot.lift`: the trace of the lifts `qlift a f q` (the type `b` in the universe of the list's second).
def Envql (.e .x .y .a .r .i .j .b .f .h .q: set): class = $ {e | ∃ x ∃ y (e = ⟨ ⟨ x , ⟨ ⟨ kc_quot_lift_atom , ∅ ⟩ , y ⟩ ⟩ , sclip (λₛ a ∈ uni' y' ∅, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), (λₛ b ∈ uni' y' (suc ∅), (λₛ f ∈ (Πₛ i ∈ a, b), (λₛ h ∈ qhd a r f, (λₛ q ∈ qty a r, qlift a f q)))))) ⟩)} $;

--| The environment without its entries at the seven atoms of the spec (the quotient primitives, `propext`, `Quot.sound`,
--| `Classical.choice`), and with the graphs above: the values at `propext`, `Quot.sound` and `Quot.ind` are `∅`, the
--| proof of a true proposition, and the others are the quotients, their classes, the lifts and the choice function.
def Envx (.e .x .y .v: set): class =
  $ {e | (e ∊ Env ∧ ¬ ∃ x ∃ y ∃ v (e = ⟨ ⟨ x , ⟨ ⟨ kc_propext_atom , ∅ ⟩ , y ⟩ ⟩ , v ⟩ ∨ (e = ⟨ ⟨ x , ⟨ ⟨ kc_quot_sound_atom , ∅ ⟩ , y ⟩ ⟩ , v ⟩ ∨ (e = ⟨ ⟨ x , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , y ⟩ ⟩ , v ⟩ ∨ (e = ⟨ ⟨ x , ⟨ ⟨ kc_quot_atom , ∅ ⟩ , y ⟩ ⟩ , v ⟩ ∨ (e = ⟨ ⟨ x , ⟨ ⟨ kc_quot_mk_atom , ∅ ⟩ , y ⟩ ⟩ , v ⟩ ∨ (e = ⟨ ⟨ x , ⟨ ⟨ kc_quot_lift_atom , ∅ ⟩ , y ⟩ ⟩ , v ⟩ ∨ (e = ⟨ ⟨ x , ⟨ ⟨ kc_quot_ind_atom , ∅ ⟩ , y ⟩ ⟩ , v ⟩)))))))) ∨ (e ∊ Envc ∨ (e ∊ Envq ∨ (e ∊ Envqm ∨ (e ∊ Envql))))} $;

--| At `cst a S`: the environment's value at the universe, the atom and the values of the levels.
def hcst (.u .a .l .e .z .w: set): class =
  $ {z | ∃ u ∃ a ∃ l ∃ e (z = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩)} $;

--| The denotation of `cst a S`, for a hook `mcv H` with `H` extending `hcst`: the environment's value at the
--| universe, the atom and the values of the levels, if it is an element of the universe.
theorem dt_cst (G: hyps) (H A S W R: class) (u: set):
  $ G ⇒ hcst ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ S ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_cst , A +: S +: ∅ ⟩ W R = mclip u (sclip (Envx' ⟨ u , ⟨ A , lsv S W ⟩ ⟩)) $;

--| The value at the atom of `Quot`: the quotients, over the universe of the first level value.
theorem envx_quot {a r i j: set} (G: hyps) (u s: set): $ G ⇒ Envx' ⟨ u , ⟨ ⟨ kc_quot_atom , ∅ ⟩ , s ⟩ ⟩ = sclip (λₛ a ∈ uni' s' ∅, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), qty a r)) $;
--| The value at the atom of `Quot.mk`: the classes.
theorem envx_quot_mk {a r i j c: set} (G: hyps) (u s: set): $ G ⇒ Envx' ⟨ u , ⟨ ⟨ kc_quot_mk_atom , ∅ ⟩ , s ⟩ ⟩ = sclip (λₛ a ∈ uni' s' ∅, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), (λₛ c ∈ a, qmk a r c))) $;
--| The value at the atom of `Quot.lift`: the lifts, into the universe of the second level value.
theorem envx_quot_lift {a r i j b f h q: set} (G: hyps) (u s: set): $ G ⇒ Envx' ⟨ u , ⟨ ⟨ kc_quot_lift_atom , ∅ ⟩ , s ⟩ ⟩ = sclip (λₛ a ∈ uni' s' ∅, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), (λₛ b ∈ uni' s' (suc ∅), (λₛ f ∈ (Πₛ i ∈ a, b), (λₛ h ∈ qhd a r f, (λₛ q ∈ qty a r, qlift a f q)))))) $;
--| The value at the atom of `Quot.ind` is `∅`.
theorem envx_quot_ind (G: hyps) (u s: set): $ G ⇒ Envx' ⟨ u , ⟨ ⟨ kc_quot_ind_atom , ∅ ⟩ , s ⟩ ⟩ = ∅ $;

-- --------------------------------------------------------------------------
-- The quotient constants' values
-- --------------------------------------------------------------------------
-- `quot u`, `quot_mk u`, `quot_lift u v` and `quot_ind u` are constants at the
-- spec's atoms, so their values are the environment's: traces over the types
-- of their arguments, a type `a` of `U_n` (`n` the value of `u`), a relation
-- `r` on it, and then the quotient `qty a r`, the class `qmk a r c` of `c`,
-- and the lift `qlift a f q` of `f` (a trace into a type `b` of `U_k`; the
-- proof `h` that `f` respects `r` ranges over `qhd a r f`). `quot_ind` is a
-- proof: `∅`.

--| The denotation of `quot l`, for a hook `mcv H` with `H` extending `hcst`, at the level value `n`.
theorem dt_quot {a r i j: set} (G: hyps) (H L W R: class) (u n: set):
  $ G ⇒ hcst ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ L ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ lv L W = n $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_cst , ⟨ kc_quot_atom , ∅ ⟩ +: ⟨ kc_lcons , L +: ⟨ kc_lnil , ∅ ⟩ +: ∅ ⟩ +: ∅ ⟩ W R = mclip u (sclip (λₛ a ∈ uni' n, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), qty a r))) $;

--| The denotation of `quot_mk l`, at the level value `n`.
theorem dt_quot_mk {a r i j c: set} (G: hyps) (H L W R: class) (u n: set):
  $ G ⇒ hcst ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ L ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ lv L W = n $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_cst , ⟨ kc_quot_mk_atom , ∅ ⟩ +: ⟨ kc_lcons , L +: ⟨ kc_lnil , ∅ ⟩ +: ∅ ⟩ +: ∅ ⟩ W R = mclip u (sclip (λₛ a ∈ uni' n, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), (λₛ c ∈ a, qmk a r c)))) $;

--| The denotation of `quot_lift l m`, at the level values `n`, `k`.
theorem dt_quot_lift {a r i j b f h q: set} (G: hyps) (H L M W R: class) (u n k: set):
  $ G ⇒ hcst ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ L ∈ trees ω $ > $ G ⇒ M ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ lv L W = n $ > $ G ⇒ lv M W = k $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_cst , ⟨ kc_quot_lift_atom , ∅ ⟩ +: ⟨ kc_lcons , L +: ⟨ kc_lcons , M +: ⟨ kc_lnil , ∅ ⟩ +: ∅ ⟩ +: ∅ ⟩ +: ∅ ⟩ W R = mclip u (sclip (λₛ a ∈ uni' n, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), (λₛ b ∈ uni' k, (λₛ f ∈ (Πₛ i ∈ a, b), (λₛ h ∈ qhd a r f, (λₛ q ∈ qty a r, qlift a f q))))))) $;

--| The denotation of `quot_ind l`.
theorem dt_quot_ind (G: hyps) (H L W R: class) (u: set):
  $ G ⇒ hcst ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ L ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_cst , ⟨ kc_quot_ind_atom , ∅ ⟩ +: ⟨ kc_lcons , L +: ⟨ kc_lnil , ∅ ⟩ +: ∅ ⟩ +: ∅ ⟩ W R = ∅ $;

--| A hook that gives the quotient constants their values: it has the constants' part and is a function.
def hqu (H: class): fml = $ hcst ⊆ H ∧ functional H $;


-- --------------------------------------------------------------------------
-- The quotient constants' rules: `quot_ty`
-- --------------------------------------------------------------------------

--| The value of `quot` for a hook with the constants' part, in an admissible universe: the trace of the quotients over the types of `U_n` and their relations.
--| @freshen G a
--| @freshen G r
--| @freshen G i
--| @freshen G j
theorem dt_quot_u {a r i j: set} (G: hyps) (H R: class) (l: lvl) (u w n: set):
  $ G ⇒ uadm u $ > $ G ⇒ hqu H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ lv (enc_lvl l) w = n $ >
  $ G ⇒ dt u (mcv H) (enc_expr (quot l)) w R = (λₛ a ∈ uni' n, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), qty a r)) $;

--| The rule `quot_ty` in the model.
theorem mquot_ty (H: class) (G: ctx) (l: lvl):
  $ _ ⇒ hqu H $ > $ mdeq (mcv H) G (quot l) (quot l) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (srt l))) $;


-- --------------------------------------------------------------------------
-- The quotient constants' rules: `quot_mk_ty`
-- --------------------------------------------------------------------------

--| The value of `quot_mk` for a hook with the constants' part, in an admissible universe: the trace of the classes.
--| @freshen G a
--| @freshen G r
--| @freshen G i
--| @freshen G j
--| @freshen G c
theorem dt_quot_mk_u {a r i j c: set} (G: hyps) (H R: class) (l: lvl) (u w n: set):
  $ G ⇒ uadm u $ > $ G ⇒ hqu H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ lv (enc_lvl l) w = n $ >
  $ G ⇒ dt u (mcv H) (enc_expr (quot_mk l)) w R = (λₛ a ∈ uni' n, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), (λₛ c ∈ a, qmk a r c))) $;

--| The rule `quot_mk_ty` in the model.
theorem mquot_mk_ty (H: class) (G: ctx) (l: lvl):
  $ _ ⇒ hqu H $ > $ mdeq (mcv H) G (quot_mk l) (quot_mk l) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1))))) $;


-- --------------------------------------------------------------------------
-- The quotient constants' rules: `quot_ind_ty`
-- --------------------------------------------------------------------------

--| The rule `quot_ind_ty` in the model (the value is a proof, `∅`; its type is inhabited since every element of
--| the quotient is a class).
theorem mquot_ind_ty (H: class) (G: ctx) (l: lvl):
  $ _ ⇒ hqu H $ > $ mdeq (mcv H) G (quot_ind l) (quot_ind l) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (pi (app (app (quot l) (bvar n1)) (bvar nz)) (Prop)) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk l) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot l) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz))))))) $;


-- --------------------------------------------------------------------------
-- The quotient constants' rules: `quot_lift_ty`
-- --------------------------------------------------------------------------

--| The model's `Eq` at the level `v` is equality: at a type `b` of `U_v` and two of its elements, the value of
--| `ind_ty (eq_D v) 0` is the truth value of their equation.
def meqs (M: class) (v: lvl) (.u .w .b .x .y: set): fml =
  $ ∀ u ∀ w (uadm u → w ∊ lvals → ∀ b ∀ x ∀ y (b ∊ uni' (lv (enc_lvl v) w) → x ∊ b → y ∊ b →
      ap (ap (ap (dt u M (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y)) $;

theorem teq_eq (G: hyps) (A B C D: class): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ teq A C = teq B D $;

--| The value of `quot_lift` for a hook with the constants' part, in an admissible universe: the trace of the lifts.
--| @freshen G a
--| @freshen G r
--| @freshen G i
--| @freshen G j
--| @freshen G b
--| @freshen G f
--| @freshen G h
--| @freshen G q
theorem dt_quot_lift_u {a r i j b f h q: set} (G: hyps) (H R: class) (l l2: lvl) (u w n k: set):
  $ G ⇒ uadm u $ > $ G ⇒ hqu H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ lv (enc_lvl l) w = n $ > $ G ⇒ lv (enc_lvl l2) w = k $ > $ G ⇒ meqs (mcv H) l2 $ >
  $ G ⇒ dt u (mcv H) (enc_expr (quot_lift l l2)) w R = (λₛ a ∈ uni' n, (λₛ r ∈ (Πₛ i ∈ a, (Πₛ j ∈ a, uni' ∅)), (λₛ b ∈ uni' k, (λₛ f ∈ (Πₛ i ∈ a, b), (λₛ h ∈ qhd a r f, (λₛ q ∈ qty a r, qlift a f q)))))) $;

--| The rule `quot_lift_ty` in the model.
theorem mquot_lift_ty (H: class) (G: ctx) (l l2: lvl):
  $ _ ⇒ hqu H $ > $ _ ⇒ meqs (mcv H) l2 $ > $ mdeq (mcv H) G (quot_lift l l2) (quot_lift l l2) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (srt l2) (pi (pi (bvar n2) (bvar n1)) (pi (pi (bvar n3) (pi (bvar n4) (pi (app (app (bvar n4) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D l2) nz) (bvar n4)) (app (bvar n3) (bvar n2))) (app (bvar n3) (bvar n1)))))) (pi (app (app (quot l) (bvar n4)) (bvar n3)) (bvar n3))))))) $;


-- --------------------------------------------------------------------------
-- The quotient constants' rules: `quot_lift_mk`
-- --------------------------------------------------------------------------

--| The rule `quot_lift_mk` in the model, with the premise that `a` has the type `f`'s domain (audit §4): at a
--| proposition both sides are `f` at `∅`; otherwise the major premise is a class of the quotient with `a` in it,
--| and `f` is constant on it.
--| @freshen G u
theorem mquot_lift_mk {u: set} (H J: class) (G: ctx) (l l2: lvl) (e1 e2 e3 e4 e5: expr) (l1: lvl) (f1 f2 ea T: expr):
  $ _ ⇒ hqu H $ > $ _ ⇒ meqs (mcv H) l2 $ > $ _ ⇒ ∀ u (uadm u → jval u (mcv H) J) $ >
  $ sty_j J G (quot_lift l l2) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (srt l2) (pi (pi (bvar n2) (bvar n1)) (pi (pi (bvar n3) (pi (bvar n4) (pi (app (app (bvar n4) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D l2) nz) (bvar n4)) (app (bvar n3) (bvar n2))) (app (bvar n3) (bvar n1)))))) (pi (app (app (quot l) (bvar n4)) (bvar n3)) (bvar n3))))))) (app (app (app (app (app (app (quot_lift l l2) (e1)) (e2)) (e3)) (e4)) (e5)) (app (app (app (quot_mk l1) f1) f2) ea)) T $ > $ ty_j J G ea e1 $ >
  $ mdeq (mcv H) G (app (app (app (app (app (app (quot_lift l l2) (e1)) (e2)) (e3)) (e4)) (e5)) (app (app (app (quot_mk l1) f1) f2) ea)) (app e4 ea) T $;


-- --------------------------------------------------------------------------
-- The judgment atoms that hold in the model
-- --------------------------------------------------------------------------

--| The judgment atoms that hold in the model with the hook `M`: `ra_deq g e a b` with `e` and `a` of equal value in
--| the value of `b`, at every admissible universe, level valuation and valuation of `g`. The class `J` of the
--| spec's relations over `⊢` in the model (`mdeq M` is `deq_j (jmod M)`).
def jmod (M: class) (.q .g .e .a .b .u .w .r: set): class =
  $ {q | ∀ g (∀ e (∀ a (∀ b ((q = (ra_deq g e a b)) → (∀ u ((uadm u) → (∀ w ((w ∊ lvals) → (∀ r ((r ∊ (sat u M g w)) → (((dt u M e w r) = (dt u M a w r)) ∧ ((dt u M e w r) ∈ (dt u M b w r)))))))))))))} $;
--| @congr
theorem jmod_congr (A B: class): $ A ≐ B $ > $ jmod A ≐ jmod B $;
--| @rewrite
theorem sb_c_jmod {x: set} (t: set x) (A: class x):
  $ ([[ x / t ]] (jmod A)) ≐ jmod ([[ x / t ]] A) $;

--| A judgment that holds in the model is an atom of `jmod`.
theorem jmod_i (M: class) (G: ctx) (e e2 A: expr): $ mdeq M G e e2 A $ > $ deq_j (jmod M) G e e2 A $;

--| The atoms of `jmod` hold in the model, at every admissible universe.
theorem jmod_jval (G: hyps) (M: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ jval u M (jmod M) $;


-- --------------------------------------------------------------------------
-- The block of `Eq` is well formed in the model
-- --------------------------------------------------------------------------

--| The block of `Eq` is well formed, over the judgment atoms that hold in the model.
theorem eq_D_wf (M: class) (v: lvl): $ ind_wf_j (jmod M) nil (eq_D v) $;



-- --------------------------------------------------------------------------
-- The model's `Eq` is equality
-- --------------------------------------------------------------------------

--| The model's `Eq` is equality, for a hook with the inductive types' parts: the value of `ind_ty (eq_D v) 0` at a type and
--| two of its elements is the truth value of their equation (from the rules of `Eq`, its constructor and its
--| recursor in the model: the recursor at the motive `x = z` turns an element of `Eq b x y` into `x = y`).
theorem meqs_i (H: class) (v: lvl): $ _ ⇒ hty ⊆ H $ > $ _ ⇒ hctor ⊆ H $ > $ _ ⇒ hrec ⊆ H $ > $ _ ⇒ functional H $ > $ _ ⇒ meqs (mcv H) v $;

--| A closed term has the same value at every valuation.
theorem closed0_den (G: hyps) (M W R R2: class) (e: expr) (u: set):
  $ closed nz e $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ R2 ∈ fseq u $ > $ G ⇒ dt u M (enc_expr e) W R = dt u M (enc_expr e) W R2 $;


-- --------------------------------------------------------------------------
-- Lean's axioms `Quot.sound` and `propext`: their types are true
-- --------------------------------------------------------------------------

--| The type of equalities is true at equal sides.
theorem teq_true (G: hyps) (X Y: class): $ G ⇒ X = Y $ > $ G ⇒ teq X Y = csn ∅ $;

--| Related elements have the same class in the quotient (`Quot.sound` in the model).
theorem qmk_rel_eq (G: hyps) (A R: class) (a b c: set): $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ b ∊ A $ > $ G ⇒ c ∊ ap (ap R a) b $ > $ G ⇒ qmk A R a = qmk A R b $;

--| Truth values with functions both ways are equal (`propext` in the model).
theorem two_iff_eq {i: set} (G: hyps) (F K: class) (a b: set): $ G ⇒ a ∊ two $ > $ G ⇒ b ∊ two $ > $ G ⇒ F ∈ (Πₛ i ∈ a, b) $ > $ G ⇒ K ∈ (Πₛ i ∈ b, a) $ > $ G ⇒ a = b $;

--| The type of `Quot.sound` is a true proposition in the model: the constant function to `∅` is its element (the classes of
--| related elements are equal, `qmk_rel_eq`, and the model's `Eq` is equality).
theorem quot_sound_inh (H: class) (G: ctx) (l: lvl) (u w t: set):
  $ _ ⇒ hqu H $ > $ _ ⇒ meqs (mcv H) l $ >
  $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ ∅ ∈ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (pi (bvar n2) (pi (app (app (bvar n2) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D l) nz) (app (app (quot l) (bvar n4)) (bvar n3))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n2))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n1))))))))) w t $;

--| The type of `propext` is a true proposition in the model, given the two fields of an `Iff` as judgments (`proj_ty` at
--| the block `iff_D`): truth values with functions both ways are equal (`two_iff_eq`), and the model's `Eq` is equality.
theorem propext_inh (H: class) (G: ctx) (u w t: set):
  $ _ ⇒ meqs (mcv H) (ls lz) $ >
  $ mdeq (mcv H) (cons (app (app (ind_ty iff_D nz) (bvar n1)) (bvar nz)) (cons (Prop) (cons (Prop) G))) (proj iff_blk nz (bvar nz)) (proj iff_blk nz (bvar nz)) (pi (bvar n2) (bvar n2)) $ >
  $ mdeq (mcv H) (cons (app (app (ind_ty iff_D nz) (bvar n1)) (bvar nz)) (cons (Prop) (cons (Prop) G))) (proj iff_blk n1 (bvar nz)) (proj iff_blk n1 (bvar nz)) (pi (bvar n1) (bvar n3)) $ >
  $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ ∅ ∈ dt u (mcv H) (enc_expr (pi (Prop) (pi (Prop) (pi (app (app (ind_ty iff_D nz) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D (ls lz)) nz) (Prop)) (bvar n2)) (bvar n1)))))) w t $;


-- --------------------------------------------------------------------------
-- Lean's axiom `Classical.choice`: the block of `Nonempty` and the choice function
-- --------------------------------------------------------------------------

--| The block of `Nonempty` is well formed, over the judgment atoms that hold in the model.
theorem nonempty_D_wf (M: class) (v: lvl): $ ind_wf_j (jmod M) nil (nonempty_D v) $;

--| The choice function is an element of the dependent product over the types `a` of the universe and the proofs that
--| `a` has an element.
--| @freshen G x1
--| @freshen G x2
theorem chv_cpi {x1 x2: set} (G: hyps) (n: set): $ G ⇒ chv n ∈ (Πₛ x1 ∈ uni' n, (Πₛ x2 ∈ tne x1, x1)) $;

--| `Classical.choice` in the model, for a hook with the inductive types' parts: the choice function at the level's value is an
--| element of the value of the axiom's type (the value of `Nonempty` at a type is the truth value of "the type has an
--| element", from the rules of `Nonempty`, its constructor and its recursor in the model).
theorem choice_mem (G: hyps) (H R: class) (v: lvl) (u w: set): $ G ⇒ uadm u $ > $ G ⇒ hty ⊆ H $ > $ G ⇒ hctor ⊆ H $ > $ G ⇒ hrec ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ >
  $ G ⇒ chv (lv (enc_lvl v) w) ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) (bvar n1)))) w R $;
