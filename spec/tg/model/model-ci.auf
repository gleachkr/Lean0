l104: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel , xx0 = ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , z = ⟨ kc_nz , ∅ ⟩ , xx1 = ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ , xx2 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⇒ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r = dt u (mcv H) tM w r ∧ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r ∈ dt u (mcv H) tS w r $ by and_intro [l103, l84]
l105: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel , xx0 = ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , z = ⟨ kc_nz , ∅ ⟩ , xx1 = ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⇒ isset ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ $ by opair_isset
l106: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel , xx0 = ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , z = ⟨ kc_nz , ∅ ⟩ , xx1 = ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⇒ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r = dt u (mcv H) tM w r ∧ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r ∈ dt u (mcv H) tS w r $ by isset_elim [l105, l104]
l107: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel , xx0 = ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , z = ⟨ kc_nz , ∅ ⟩ ⇒ isset ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ $ by opair_isset
l108: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel , xx0 = ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , z = ⟨ kc_nz , ∅ ⟩ ⇒ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r = dt u (mcv H) tM w r ∧ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r ∈ dt u (mcv H) tS w r $ by isset_elim [l107, l106]
l109: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel , xx0 = ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l110: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel , xx0 = ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⇒ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r = dt u (mcv H) tM w r ∧ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r ∈ dt u (mcv H) tS w r $ by isset_elim [l109, l108]
l111: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel ⇒ isset ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ $ by opair_isset
l112: $ G , tg = ⟨ kc_cons , x4 +: x1 +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x2 x4 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ x4 tS ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ x2 tS y ∈ lrel ∧ ra_nfields td ti ⟨ kc_nz , ∅ ⟩ f ∈ lrel ∧ ra_projs b ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f y tM ∈ lrel ⇒ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r = dt u (mcv H) tM w r ∧ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r ∈ dt u (mcv H) tS w r $ by isset_elim [l111, l110]
l113: $ G ⇒ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r = dt u (mcv H) tM w r ∧ dt u (mcv H) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r ∈ dt u (mcv H) tS w r $ by fci_inv_eta_eq [l1, l112]

ind_eta
-------
l1: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ uadm u $ by ax
l2: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ w ∊ lvals $ by ax
l3: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ r ∊ sat u (mcv hfin) (enc_ctx Dl) w $ by ax
l4: $ … ⇒ w ∈ lvals $ by welc_wcel [l2]
l5: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ functional hfin $ by hfin_functional
l6: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ hty ⊆ hfin $ by hfin_hty
l7: $ … ⇒ jval u (mcv hfin) (jmod (mcv hfin)) $ by jmod_jval [l1]
l8: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ ra_ind_wf (enc_ctx Dl) (enc_ind D) ∈ lrel3 (jmod (mcv hfin)) $ by weaken [#1]
l9: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ x0 = enc_ctx Dl $ by ax
l10: $ … ⇒ (enc_ctx Dl) = x0 $ by eq_sym [l9]
l11: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ x1 = enc_ind D $ by ax
l12: $ … ⇒ (enc_ind D) = x1 $ by eq_sym [l11]
l13: $ … ⇒ ra_ind_wf x0 x1 ∈ lrel3 (jmod (mcv hfin)) $ by wcel_eq_l [ra_ind_wf_eq [l10, l12], l8]
l14: $ _ ⇒ enc_ind D ∈ ofsort lsig lopen ks_ind $ by enc_ind_sorted
l15: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ x1 ∈ ofsort lsig lopen ks_ind $ by wcel_eq_l [l12, weaken [l14]]
l16: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ w = w $ by eq_refl
l17: $ … ⇒ sat u (mcv hfin) (enc_ctx Dl) w = sat u (mcv hfin) x0 w $ by sat_eq [l10, l16]
l18: $ … ⇒ r ∈ sat u (mcv hfin) x0 w $ by wcel_eq_r [l17, welc_wcel [l3]]
l19: $ … ⇒ w ∈ lvals ∧ r ∈ sat u (mcv hfin) x0 w $ by and_intro [l4, l18]
l20: $ … ⇒ x1 ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ r ∈ sat u (mcv hfin) x0 w $ by and_intro [l15, l19]
l21: $ … ⇒ ra_ind_wf x0 x1 ∈ lrel3 (jmod (mcv hfin)) ∧ x1 ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ r ∈ sat u (mcv hfin) x0 w $ by and_intro [l13, l20]
l22: $ … ⇒ jval u (mcv hfin) (jmod (mcv hfin)) ∧ ra_ind_wf x0 x1 ∈ lrel3 (jmod (mcv hfin)) ∧ x1 ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ r ∈ sat u (mcv hfin) x0 w $ by and_intro [l7, l21]
l23: $ … ⇒ functional hfin ∧ jval u (mcv hfin) (jmod (mcv hfin)) ∧ ra_ind_wf x0 x1 ∈ lrel3 (jmod (mcv hfin)) ∧ x1 ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ r ∈ sat u (mcv hfin) x0 w $ by and_intro [l5, l22]
l24: $ … ⇒ hty ⊆ hfin ∧ functional hfin ∧ jval u (mcv hfin) (jmod (mcv hfin)) ∧ ra_ind_wf x0 x1 ∈ lrel3 (jmod (mcv hfin)) ∧ x1 ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ r ∈ sat u (mcv hfin) x0 w $ by and_intro [l6, l23]
l25: $ … ⇒ iwf u hfin (jmod (mcv hfin)) x0 x1 w r $ by and_intro [l1, l24]
l26: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ hctor ⊆ hfin $ by hfin_hctor
l27: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ ra_eta_ok (enc_ind D) (enc_nat j) ∈ lrel $ by weaken [#2]
l28: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ x2 = enc_nat j $ by ax
l29: $ … ⇒ (enc_nat j) = x2 $ by eq_sym [l28]
l30: $ … ⇒ ra_eta_ok x1 x2 ∈ lrel $ by wcel_eq_l [ra_eta_ok_eq [l12, l29], l27]
l31: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ ra_eta_eq (enc_ind D) (enc_nat j) (enc_ctx Dl) (enc_expr M) (enc_expr S) ∈ lrel $ by weaken [#3]
l32: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ x3 = enc_expr M $ by ax
l33: $ … ⇒ (enc_expr M) = x3 $ by eq_sym [l32]
l34: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ x4 = enc_expr S $ by ax
l35: $ … ⇒ (enc_expr S) = x4 $ by eq_sym [l34]
l36: $ … ⇒ ra_eta_eq x1 x2 x0 x3 x4 ∈ lrel $ by wcel_eq_l [ra_eta_eq_eq [l12, l29, l10, l33, l35], l31]
l37: $ _ ⇒ enc_expr S ∈ ofsort lsig lopen ks_expr $ by enc_expr_sorted
l38: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl , x1 = enc_ind D , x2 = enc_nat j , x3 = enc_expr M , x4 = enc_expr S ⇒ x4 ∈ ofsort lsig lopen ks_expr $ by wcel_eq_l [l35, weaken [l37]]
l39: $ … ⇒ x4 ∊ ofsort lsig lopen ks_expr $ by wcel_welc [l38]
l40: $ … ⇒ dt u (mcv hfin) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r = dt u (mcv hfin) x3 w r ∧ dt u (mcv hfin) ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ w r ∈ dt u (mcv hfin) x4 w r $ by ind_eta_eq_rule [l25, l26, l30, l36, l39]
