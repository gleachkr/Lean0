l417: $ G , xx3 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx4 = ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ , x7 = ∅ , xx2 = ⟨ kc_nz , ∅ ⟩ , v ∊ esat u (dnf u (mcv H)) tp w ∧ q ∊ fseq u ∧ cdm q = nvf' td1 ∧ r = q ++ v ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by and_intro [l414, l416]
l418: $ G , xx3 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx4 = ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ , x7 = ∅ , xx2 = ⟨ kc_nz , ∅ ⟩ , ∃ q (v ∊ esat u (dnf u (mcv H)) tp w ∧ q ∊ fseq u ∧ cdm q = nvf' td1 ∧ r = q ++ v) ⇒ ∃ q (v ∊ esat u (dnf u (mcv H)) tp w ∧ q ∊ fseq u ∧ cdm q = nvf' td1 ∧ r = q ++ v) $ by ax
l419: $ … ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by ex_elim [l418, l417]
