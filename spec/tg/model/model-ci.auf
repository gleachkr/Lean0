--| @freshen H qb_v
--| @freshen H qP
--| @freshen H qT
--| @freshen H qnp
--| @freshen H qnf
--| @freshen H qS0
--| @freshen H qY
lemma fci_inv_eta_eq {qb_v qP qT qnp qnf qS0 qY: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5: set): $ G ⇒ ra_eta_eq t1 t2 t3 t4 t5 ∈ lrel $ > $ H , t3 = ⟨ kc_cons , qS0 +: qP +: ∅ ⟩ ∧ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , t1 +: t2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnp qS0 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qS0 t5 ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , t1 +: t2 +: ∅ ⟩ ⟨ kc_ind_ctor , t1 +: t2 +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnp t5 qY ∈ lrel ∧ ra_nfields t1 t2 ⟨ kc_nz , ∅ ⟩ qnf ∈ lrel ∧ ra_projs qb_v ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qY t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_eta_eq t1 t2 t3 t4 t5 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ qnp ∃ qnf ∃ qS0 ∃ z ∃ qY ∃ u (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_cons , qS0 +: qP +: ∅ ⟩ ∧ t4 = u ∧ t5 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnp qS0 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qS0 z ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_ind_ctor , x +: y +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnp z qY ∈ lrel ∧ ra_nfields x y ⟨ kc_nz , ∅ ⟩ qnf ∈ lrel ∧ ra_projs qb_v ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qY u ∈ lrel) $ by lrel_eta_eq_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_cons , qS0 +: qP +: ∅ ⟩ ∧ t4 = u ∧ t5 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnp qS0 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qS0 z ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_ind_ctor , x +: y +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnp z qY ∈ lrel ∧ ra_nfields x y ⟨ kc_nz , ∅ ⟩ qnf ∈ lrel ∧ ra_projs qb_v ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qY u ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_cons , qS0 +: qP +: ∅ ⟩ ∧ t4 = u ∧ t5 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnp qS0 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qS0 z ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_ind_ctor , x +: y +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnp z qY ∈ lrel ∧ ra_nfields x y ⟨ kc_nz , ∅ ⟩ qnf ∈ lrel ∧ ra_projs qb_v ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qY u ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_cons , qS0 +: qP +: ∅ ⟩ ∧ t4 = u ∧ t5 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnp qS0 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qS0 z ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_ind_ctor , x +: y +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnp z qY ∈ lrel ∧ ra_nfields x y ⟨ kc_nz , ∅ ⟩ qnf ∈ lrel ∧ ra_projs qb_v ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qY u ∈ lrel ⇒ qb_v = qb_v $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_cons , qS0 +: qP +: ∅ ⟩ ∧ t4 = u ∧ t5 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnp qS0 ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qS0 z ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , x +: y +: ∅ ⟩ ⟨ kc_ind_ctor , x +: y +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnp z qY ∈ lrel ∧ ra_nfields x y ⟨ kc_nz , ∅ ⟩ qnf ∈ lrel ∧ ra_projs qb_v ⟨ kc_bvar , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qY u ∈ lrel ⇒ qP = qP $ by eq_refl
