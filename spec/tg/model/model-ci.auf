l39: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel ⇒ tnp = tnp $ by eq_refl
l40: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel ⇒ ra_clen p tnp ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [and_elim_l [and_elim_r [l38]]], l39], l21]
l41: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel ⇒ x1 = tnp $ by lrel_clen_det [l24, l40]
l42: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel ⇒ tn = tn $ by eq_refl
