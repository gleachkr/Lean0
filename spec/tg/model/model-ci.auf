l152: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , ra_add tn tnp a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_capp tX p q ∈ lrel ⇒ ra_rst td tN trhs z3 ∈ lrel $ by weaken [#22]
l153: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , ra_add tn tnp a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_capp tX p q ∈ lrel ⇒ ra_iota_lhs td tv ti tc tnf tB te3 tc1 tmj te4 tT ∈ lrel $ by weaken [#23]
l154: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , ra_add tn tnp a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_capp tX p q ∈ lrel ⇒ ra_ind_arity td tnp tn tm ∈ lrel $ by weaken [#24]
l155: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , ra_add tn tnp a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_capp tX p q ∈ lrel ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by ci_wf2 [l131, l132, l133, l110, l111, l112, l115, l116, l134, l135, l136, l137, l117, l138, l139, l113, l114, l125, l126, l122, l123, l124, l121, l130, l128, l129, l127, l120, l118, l140, l141, l142, l143, l144, l145, l146, l147, l148, l149, l150, l151, l152, l153, l154]
l156: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , ra_add tn tnp a ∈ lrel ∧ ra_closed a k ∈ lrel ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by ex_elim [l109, l155]
l157: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by ex_elim [l75, l156]
l158: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l159: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel , ra_ind_data td xx0 xx1 xx2 ∈ lrel ∧ ra_clen xx1 tnp ∈ lrel ∧ ra_ntys xx2 tn tm ∈ lrel ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by isset_elim [l158, l157]
l160: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti f c ∈ lrel ∧ ra_nth_ctor c tc k ∈ lrel ∧ ra_npis k tnf ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x1 k x8 ∈ lrel ∧ ra_psplit tnf x8 ⟨ kc_nil , ∅ ⟩ tX tB ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_clift x2 tX x5 ∈ lrel ∧ ra_capp x3 p x6 ∈ lrel ∧ ra_capp x4 x6 x7 ∈ lrel ∧ ra_capp x5 x7 tg ∈ lrel ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by fci_inv_ind_arity [l18, l159]
l161: $ G ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by fci_inv_iota_tel [l1, l160]

