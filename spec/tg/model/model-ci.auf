l12: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_psplit ∈ ω ∧ tn +: tK +: ⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l4, wcel_isset [l11], l10]
l13: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ crn (tn +: tK +: ⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l12]]
l14: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ crn (tK +: ⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅) ⊆ trees ω $ by crn_scons_tail [l13]
l15: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l16: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tK ∈ trees ω $ by crn_scons_head_trees [l15, l14]
l17: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kr_psplit , tn +: tK +: ⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅ ⟩ ∈ latoms $ by lrel_latoms [l3]
l18: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l19: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (tr +: ∅) $ by scons_set [l18]
l20: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (tx +: tr +: ∅) $ by scons_set [l19]
l21: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅) $ by scons_set [l20]
l22: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (tK +: ⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅) $ by scons_set [l21]
l23: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (tn +: tK +: ⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅) $ by scons_set [l22]
l24: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_psplit ∈ ω $ by kr_psplit_omega
l25: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_psplit ∈ ω ∧ tn +: tK +: ⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l17, wcel_isset [l24], l23]
l26: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ crn (tn +: tK +: ⟨ kc_nil , ∅ ⟩ +: tx +: tr +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l25]]
l27: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l28: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tn ∈ trees ω $ by crn_scons_head_trees [l27, l26]
l29: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ trees ω ⊆ fci20_ps_q tp $ by fci20_ps_all
l30: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tK ∊ fci20_ps_q tp $ by subset_elim [l29, wcel_welc [l16]]
l31: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tn = tn $ by eq_refl
l32: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tK = tK $ by eq_refl
l33: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tx = tx $ by eq_refl
l34: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tr = tr $ by eq_refl
l35: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_psplit tn tK x5 tx tr ∈ lrel $ by wcel_eq_l [ra_psplit_eq [l31, l32, eq_sym [l1], l33, l34], l3]
l36: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_pis ⟨ kc_nil , ∅ ⟩ tK tK ∈ lrel $ by lrel_pis_nil [l16]
l37: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_pis x5 tK tK ∈ lrel $ by wcel_eq_l [ra_pis_eq [eq_sym [l1], l32, l32], l36]
l38: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_clen_nil
l39: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen x5 x7 ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [l1], eq_sym [l2]], l38]
l40: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add tn ⟨ kc_nz , ∅ ⟩ tn ∈ lrel $ by lrel_add_z [l28]
l41: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add tn x7 tn ∈ lrel $ by wcel_eq_l [ra_add_eq [l31, eq_sym [l2], l31], l40]
l42: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tp ∊ trees ω $ by weaken [#2]
l43: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_capp ⟨ kc_nil , ∅ ⟩ tp tp ∈ lrel $ by lrel_capp_nil [welc_wcel [l42]]
l44: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ tp = tp $ by eq_refl
l45: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_capp x5 tp tp ∈ lrel $ by wcel_eq_l [ra_capp_eq [eq_sym [l1], l44, l44], l43]
l46: $ G , x5 = ⟨ kc_nil , ∅ ⟩ , x7 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_pis tx tr tK ∈ lrel ∧ ra_clen tx tn ∈ lrel ∧ ∃ e (ra_capp tx tp e ∈ lrel) $ by fci20_ps_e [l30, l35, l37, l39, l41, l45]
l47: $ G , x5 = ⟨ kc_nil , ∅ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l48: $ G , x5 = ⟨ kc_nil , ∅ ⟩ ⇒ ra_pis tx tr tK ∈ lrel ∧ ra_clen tx tn ∈ lrel ∧ ∃ e (ra_capp tx tp e ∈ lrel) $ by isset_elim [l47, l46]
l49: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l50: $ G ⇒ ra_pis tx tr tK ∈ lrel ∧ ra_clen tx tn ∈ lrel ∧ ∃ e (ra_capp tx tp e ∈ lrel) $ by isset_elim [l49, l48]

def fci20_rh_q (tY tX: set) (.y .k .e: set): class = $ {y | ∀ k ∀ e (ra_rehead tY tX k e y ∈ lrel → y ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr)} $

lemma fci20_rh_e (G: hyps) (tY tX: set) (ty vk ve: set): $ G ⇒ ty ∊ fci20_rh_q tY tX $ > $ G ⇒ ra_rehead tY tX vk ve ty ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ∀ k ∀ e (ra_rehead tY tX k e ty ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr) $ by cab_elim [#1]
l2: $ G ⇒ ∀ e (ra_rehead tY tX vk e ty ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr) $ by all_elim [l1]
l3: $ G ⇒ ra_rehead tY tX vk ve ty ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr $ by all_elim [l2]
l4: $ G ⇒ ty ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr $ by imp_elim [l3, #2]
l5: $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $ by imp_elim [l4, #3]

--| @freshen H qe_v
--| @freshen H qe2
--| @freshen H qa_v
--| @freshen H qk_v
lemma fci_inv_rehead {qe_v qe2 qa_v qk_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5: set): $ G ⇒ ra_rehead t1 t2 t3 t4 t5 ∈ lrel $ > $ H , t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 ∧ t5 = t2 ⇒ Cf $ > $ H , t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead t1 t2 qk_v qe_v qe2 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_rehead t1 t2 t3 t4 t5 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y) ∨ ∃ x ∃ y ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) $ by lrel_rehead_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y ⇒ t4 = t1 $ by eq_trans [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]], eq_sym [and_elim_l [l3]]]
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y ⇒ t5 = t2 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]], eq_sym [and_elim_l [and_elim_r [l3]]]]
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 ∧ t5 = t2 $ by and_intro [and_elim_l [and_elim_r [and_elim_r [l3]]], and_intro [l4, l5]]
l7: $ H ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 ∧ t5 = t2 → Cf $ by imp_intro [#2]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 ∧ t5 = t2 → Cf $ by weaken [l7]
l9: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y ⇒ Cf $ by imp_elim [l8, l6]
l10: $ G , H , ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y) ⇒ ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y) $ by ax
l11: $ … ⇒ Cf $ by ex_elim [l10, l9]
l12: $ G , H , ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y) ⇒ ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H ⇒ (∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y)) → Cf $ by imp_intro [l13]
l15: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel $ by ax
l16: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel ⇒ qk_v = qk_v $ by eq_refl
l17: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel ⇒ qe_v = qe_v $ by eq_refl
l18: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel ⇒ qe2 = qe2 $ by eq_refl
l19: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel ⇒ ra_rehead t1 t2 qk_v qe_v qe2 ∈ lrel $ by wcel_eq_l [ra_rehead_eq [eq_sym [and_elim_l [l15]], eq_sym [and_elim_l [and_elim_r [l15]]], l16, l17, l18], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l15]]]]]]
l20: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel ⇒ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead t1 t2 qk_v qe_v qe2 ∈ lrel $ by and_intro [and_elim_l [and_elim_r [and_elim_r [l15]]], and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l15]]]], and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l15]]]]], l19]]]
l21: $ H ⇒ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead t1 t2 qk_v qe_v qe2 ∈ lrel → Cf $ by imp_intro [#3]
l22: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel ⇒ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead t1 t2 qk_v qe_v qe2 ∈ lrel → Cf $ by weaken [l21]
l23: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel ⇒ Cf $ by imp_elim [l22, l20]
l24: $ G , H , ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) ⇒ ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) ⇒ ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H , ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) ⇒ ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) $ by ax
l29: $ … ⇒ Cf $ by ex_elim [l28, l27]
l30: $ G , H , ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) ⇒ ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) $ by ax
l31: $ … ⇒ Cf $ by ex_elim [l30, l29]
l32: $ G , H , ∃ y ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) ⇒ ∃ y ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) $ by ax
l33: $ … ⇒ Cf $ by ex_elim [l32, l31]
l34: $ G , H , ∃ x ∃ y ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) ⇒ ∃ x ∃ y ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel) $ by ax
l35: $ … ⇒ Cf $ by ex_elim [l34, l33]
l36: $ G , H ⇒ (∃ x ∃ y ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel)) → Cf $ by imp_intro [l35]
l37: $ G , H ⇒ (∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ∧ t5 = y) ∨ ∃ x ∃ y ∃ qe_v ∃ qe2 ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t5 = ⟨ kc_app , qe2 +: qa_v +: ∅ ⟩ ∧ ra_rehead x y qk_v qe_v qe2 ∈ lrel)) → Cf $ by or_elim_imp [l14, l36]
l38: $ G , H ⇒ Cf $ by imp_elim [l37, l2]

lemma fci20_rh_n (G: hyps) (tY tX: set) (ty k1 j1 vk ve: set): $ G ⇒ crn j1 ⊆ fci20_rh_q tY tX $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_rehead tY tX vk ve ty ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $
----
l1: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ∧ ty = tX ⇒ vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ∧ ty = tX $ by ax
l2: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ∧ ty = tX ⇒ vk = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l1]
l3: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ∧ ty = tX ⇒ ve = tY $ by and_elim_l [and_elim_r [l1]]
l4: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ∧ ty = tX ⇒ ty = tX $ by and_elim_r [and_elim_r [l1]]
l5: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ∧ ty = tX ⇒ ty ∊ ofsort lsig lopen ks_expr $ by weaken [#6]
l6: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ∧ ty = tX ⇒ tX ∊ ofsort lsig lopen ks_expr $ by welc_eq_set [l4, l5]
l7: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel $ by ax
l8: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ vk = ⟨ kc_s , d +: ∅ ⟩ $ by and_elim_l [l7]
l9: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ ve = ⟨ kc_app , a +: c +: ∅ ⟩ $ by and_elim_l [and_elim_r [l7]]
l10: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ ty = ⟨ kc_app , b +: c +: ∅ ⟩ $ by and_elim_l [and_elim_r [and_elim_r [l7]]]
l11: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ ra_rehead tY tX d a b ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [l7]]]
l12: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_expr $ by weaken [#6]
l13: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ b ∊ ofsort lsig lopen ks_expr ∧ c ∊ ofsort lsig lopen ks_expr $ by ofsort_app_kids [wcel_eq_l [l10, welc_wcel [l12]]]
l14: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ isset ∅ $ by ax_empty
l15: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ isset (c +: ∅) $ by scons_set [l14]
l16: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ isset (b +: c +: ∅) $ by scons_set [l15]
l17: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ crn j1 ⊆ fci20_rh_q tY tX $ by weaken [#1]
l18: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l19: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l20: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ crn (b +: c +: ∅) ⊆ fci20_rh_q tY tX $ by node_crn_sub [l17, l18, l10, wcel_isset [l19], l16]
l21: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ isset b $ by isset_var
l22: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ b ∈ fci20_rh_q tY tX $ by crn_scons_head [l21, l20]
l23: $ G , vk = ⟨ kc_s , d +: ∅ ⟩ ∧ ve = ⟨ kc_app , a +: c +: ∅ ⟩ ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ ra_rehead tY tX d a b ∈ lrel ⇒ tX ∊ ofsort lsig lopen ks_expr $ by fci20_rh_e [wcel_welc [l22], l11, and_elim_l [l13]]
l24: $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $ by fci_inv_rehead [#5, l6, l23]

lemma fci20_rh_all (G: hyps) (tY tX: set): $ G ⇒ trees ω ⊆ fci20_rh_q tY tX $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k e y ∈ lrel , y ∊ ofsort lsig lopen ks_expr ⇒ crn x9 ⊆ fci20_rh_q tY tX $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k e y ∈ lrel , y ∊ ofsort lsig lopen ks_expr ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k e y ∈ lrel , y ∊ ofsort lsig lopen ks_expr ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k e y ∈ lrel , y ∊ ofsort lsig lopen ks_expr ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k e y ∈ lrel , y ∊ ofsort lsig lopen ks_expr ⇒ ra_rehead tY tX k e y ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k e y ∈ lrel , y ∊ ofsort lsig lopen ks_expr ⇒ y ∊ ofsort lsig lopen ks_expr $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k e y ∈ lrel , y ∊ ofsort lsig lopen ks_expr ⇒ tX ∊ ofsort lsig lopen ks_expr $ by fci20_rh_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k e y ∈ lrel ⇒ y ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ ⇒ ra_rehead tY tX k e y ∈ lrel → y ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ ⇒ ∀ e (ra_rehead tY tX k e y ∈ lrel → y ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ ⇒ ∀ k ∀ e (ra_rehead tY tX k e y ∈ lrel → y ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ fci20_rh_q tY tX $ by cab_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci20_rh_q tY tX $ by wcel_intro [l13, l12]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci20_rh_q tY tX ⇒ ⟨ x8 , x9 ⟩ ∈ fci20_rh_q tY tX $ by isset_elim [l15, l14]
l17: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci20_rh_q tY tX → ⟨ x8 , x9 ⟩ ∈ fci20_rh_q tY tX $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci20_rh_q tY tX → ⟨ x8 , x9 ⟩ ∈ fci20_rh_q tY tX) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ fci20_rh_q tY tX $ by trees_ind_c [l19, l18]

rehead_head_sort
----------------
l1: $ G ⇒ trees ω ⊆ fci20_rh_q tY tX $ by fci20_rh_all
l2: $ G ⇒ ⟨ kr_rehead , tY +: tX +: tk +: te +: te2 +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (te2 +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (te +: te2 +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (tk +: te +: te2 +: ∅) $ by scons_set [l5]
l7: $ G ⇒ isset (tX +: tk +: te +: te2 +: ∅) $ by scons_set [l6]
l8: $ G ⇒ isset (tY +: tX +: tk +: te +: te2 +: ∅) $ by scons_set [l7]
l9: $ G ⇒ kr_rehead ∈ ω $ by kr_rehead_omega
l10: $ G ⇒ kr_rehead ∈ ω ∧ tY +: tX +: tk +: te +: te2 +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l9], l8]
l11: $ G ⇒ crn (tY +: tX +: tk +: te +: te2 +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l10]]
l12: $ G ⇒ crn (tX +: tk +: te +: te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l11]
l13: $ G ⇒ crn (tk +: te +: te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l12]
l14: $ G ⇒ crn (te +: te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l13]
l15: $ G ⇒ crn (te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l14]
l16: $ G ⇒ isset ω $ by omega_set
l17: $ G ⇒ te2 ∈ trees ω $ by crn_scons_head_trees [l16, l15]
l18: $ G ⇒ te2 ∊ fci20_rh_q tY tX $ by subset_elim [l1, wcel_welc [l17]]
l19: $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $ by fci20_rh_e [l18, #1, #2]

