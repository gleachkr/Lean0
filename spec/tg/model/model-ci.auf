l9: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel ⇒ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel $ by and_elim_r [and_elim_r [l7]]
l10: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ x5 = ⟨ kc_s , vd +: ∅ ⟩ $ by ax
l11: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ x6 = ⟨ kc_bvar , vd +: ∅ ⟩ $ by ax
