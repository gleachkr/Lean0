l58: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x ∃ y ∃ z ∃ u ∃ qF ∃ qF2 ∃ qMj ∃ qC ∃ qT ∃ qMr ∃ v (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel)) → Cf $ by or_elim_imp [l16, l57]
l59: $ G , H ⇒ Cf $ by imp_elim [l58, l2]

--| @freshen H qA
--| @freshen H qP
--| @freshen H qG2
lemma fci_inv_capp {qA qP qG2: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_capp t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 ⇒ Cf $ > $ H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_capp t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by lrel_capp_cases [l1]
l3: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x $ by ax
l4: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t3 = t2 $ by eq_trans [and_elim_r [and_elim_r [l3]], eq_sym [and_elim_l [and_elim_r [l3]]]]
l5: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 $ by and_intro [and_elim_l [l3], l4]
l6: $ H ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by weaken [l6]
l8: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel $ by ax
l13: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ qP = qP $ by eq_refl
l14: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ qG2 = qG2 $ by eq_refl
l15: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ ra_capp qP t2 qG2 ∈ lrel $ by wcel_eq_l [ra_capp_eq [l13, eq_sym [and_elim_l [and_elim_r [l12]]], l14], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l16: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel $ by and_intro [and_elim_l [l12], and_intro [and_elim_l [and_elim_r [and_elim_r [l12]]], l15]]
l17: $ H ⇒ t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel → Cf $ by imp_intro [#3]
l18: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel → Cf $ by weaken [l17]
l19: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ Cf $ by imp_elim [l18, l16]
l20: $ G , H , ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l21: $ … ⇒ Cf $ by ex_elim [l20, l19]
l22: $ G , H , ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
l24: $ G , H , ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H ⇒ (∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel)) → Cf $ by imp_intro [l27]
l29: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , qA +: qG2 +: ∅ ⟩ ∧ ra_capp qP x qG2 ∈ lrel)) → Cf $ by or_elim_imp [l11, l28]
l30: $ G , H ⇒ Cf $ by imp_elim [l29, l2]

