l297: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel ⇒ ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ by isset_elim [l296, l295]
l298: $ G ⇒ ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ by fci_inv_pargs [l1, l40, l297]

lemma fci25_pv_all (G: hyps) (M: class) (u w r tD tN tX: set): $ G ⇒ trees ω ⊆ fci25_pv_q M u w r tD tN tX $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci25_pv_q M u w r tD tN tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , w ∊ lvals , r ∊ fseq u , ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) , ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) ⇒ crn x9 ⊆ fci25_pv_q M u w r tD tN tX $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci25_pv_q M u w r tD tN tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , w ∊ lvals , r ∊ fseq u , ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) , ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci25_pv_q M u w r tD tN tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , w ∊ lvals , r ∊ fseq u , ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) , ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci25_pv_q M u w r tD tN tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , w ∊ lvals , r ∊ fseq u , ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) , ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci25_pv_q M u w r tD tN tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , w ∊ lvals , r ∊ fseq u , ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) , ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) ⇒ ra_pargs tX d k v ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci25_pv_q M u w r tD tN tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , w ∊ lvals , r ∊ fseq u , ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) , ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) ⇒ w ∊ lvals $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci25_pv_q M u w r tD tN tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , w ∊ lvals , r ∊ fseq u , ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) , ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) ⇒ r ∊ fseq u $ by ax
