l169: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ vk = ⟨ kc_s , n +: ∅ ⟩ $ by weaken [l168]
l170: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ f = x2 ∧ ⟨ kc_bvar , vd +: ∅ ⟩ = x3 $ by weaken [l81]
l171: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ kc_app = kc_app $ by eq_refl
l172: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ ∅ = ∅ $ by eq_refl
l173: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ $ by weaken [l70]
l174: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ vd = vd $ by eq_refl
l175: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ ra_pargs tX vd vk ve ∈ lrel $ by wcel_eq_l [ra_pargs_eq [l102, l174, eq_sym [l169], eq_trans [opair_eq [l171, scons_eq [l103, scons_eq [and_elim_r [l170], l172]]], eq_sym [l173]]], l167]
l176: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel ⇒ isset ⟨ kc_s , vd +: ∅ ⟩ $ by opair_isset
l177: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel ⇒ ra_pargs tX vd vk ve ∈ lrel $ by isset_elim [l176, l175]
l178: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tH ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel ⇒ ra_pargs tX vd vk ve ∈ lrel $ by fci_inv_rehead [l57, l66, l177]
l179: $ G ⇒ ra_pargs tX vd vk ve ∈ lrel $ by fci_inv_pargs [l1, l53, l178]

lemma fci24_pr_all (G: hyps) (tH tX: set): $ G ⇒ trees ω ⊆ fci24_pr_q tH tX $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tH d k v ∈ lrel , ra_rehead tH tX k v e ∈ lrel ⇒ crn x9 ⊆ fci24_pr_q tH tX $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tH d k v ∈ lrel , ra_rehead tH tX k v e ∈ lrel ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tH d k v ∈ lrel , ra_rehead tH tX k v e ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tH d k v ∈ lrel , ra_rehead tH tX k v e ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tH d k v ∈ lrel , ra_rehead tH tX k v e ∈ lrel ⇒ ra_pargs tH d k v ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tH d k v ∈ lrel , ra_rehead tH tX k v e ∈ lrel ⇒ ra_rehead tH tX k v e ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tH d k v ∈ lrel , ra_rehead tH tX k v e ∈ lrel ⇒ ra_pargs tX d k e ∈ lrel $ by fci24_pr_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tH d k v ∈ lrel ⇒ ra_rehead tH tX k v e ∈ lrel → ra_pargs tX d k e ∈ lrel $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ ⇒ ra_pargs tH d k v ∈ lrel → ra_rehead tH tX k v e ∈ lrel → ra_pargs tX d k e ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ ⇒ ∀ e (ra_pargs tH d k v ∈ lrel → ra_rehead tH tX k v e ∈ lrel → ra_pargs tX d k e ∈ lrel) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ ⇒ ∀ k ∀ e (ra_pargs tH d k v ∈ lrel → ra_rehead tH tX k v e ∈ lrel → ra_pargs tX d k e ∈ lrel) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ ⇒ ∀ d ∀ k ∀ e (ra_pargs tH d k v ∈ lrel → ra_rehead tH tX k v e ∈ lrel → ra_pargs tX d k e ∈ lrel) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ ⇒ v ∊ fci24_pr_q tH tX $ by cab_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX , v = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci24_pr_q tH tX $ by wcel_intro [l14, l13]
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pr_q tH tX ⇒ ⟨ x8 , x9 ⟩ ∈ fci24_pr_q tH tX $ by isset_elim [l16, l15]
l18: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci24_pr_q tH tX → ⟨ x8 , x9 ⟩ ∈ fci24_pr_q tH tX $ by imp_intro [imp_intro [imp_intro [l17]]]
l19: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci24_pr_q tH tX → ⟨ x8 , x9 ⟩ ∈ fci24_pr_q tH tX) $ by all_intro [all_intro [l18]]
l20: $ G ⇒ isset ω $ by omega_set
l21: $ G ⇒ trees ω ⊆ fci24_pr_q tH tX $ by trees_ind_c [l20, l19]

pargs_rehead
------------
l1: $ G ⇒ trees ω ⊆ fci24_pr_q tH tX $ by fci24_pr_all
l2: $ G ⇒ ⟨ kr_pargs , tH +: td +: tk +: te +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (te +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (tk +: te +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (td +: tk +: te +: ∅) $ by scons_set [l5]
l7: $ G ⇒ isset (tH +: td +: tk +: te +: ∅) $ by scons_set [l6]
l8: $ G ⇒ kr_pargs ∈ ω $ by kr_pargs_omega
l9: $ G ⇒ kr_pargs ∈ ω ∧ tH +: td +: tk +: te +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l8], l7]
l10: $ G ⇒ crn (tH +: td +: tk +: te +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l9]]
l11: $ G ⇒ crn (td +: tk +: te +: ∅) ⊆ trees ω $ by crn_scons_tail [l10]
l12: $ G ⇒ crn (tk +: te +: ∅) ⊆ trees ω $ by crn_scons_tail [l11]
l13: $ G ⇒ crn (te +: ∅) ⊆ trees ω $ by crn_scons_tail [l12]
l14: $ G ⇒ isset ω $ by omega_set
l15: $ G ⇒ te ∈ trees ω $ by crn_scons_head_trees [l14, l13]
l16: $ G ⇒ te ∊ fci24_pr_q tH tX $ by subset_elim [l1, wcel_welc [l15]]
l17: $ G ⇒ ra_pargs tX td tk te2 ∈ lrel $ by fci24_pr_e [l16, #1, #2]

