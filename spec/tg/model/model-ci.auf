--| @freshen H qF
--| @freshen H qF2
--| @freshen H qMj
--| @freshen H qC
--| @freshen H qT
--| @freshen H qMr
lemma fci_inv_motives {qF qF2 qMj qC qT qMr: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6: set): $ G ⇒ ra_motives t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ H , t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ ⇒ Cf $ > $ H , t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ ra_lift t4 ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty t1 t2 t4 ⟨ kc_nz , ∅ ⟩ t3 qF2 qMj ∈ lrel ∧ ra_motives t1 t2 t3 ⟨ kc_s , t4 +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ t6 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_motives t1 t2 t3 t4 t5 t6 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x ∃ y ∃ z ∃ u ∃ qF ∃ qF2 ∃ qMj ∃ qC ∃ qT ∃ qMr ∃ v (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel) $ by lrel_motives_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ ⇒ t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ ⇒ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]
l5: $ H ⇒ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ → Cf $ by imp_intro [#2]
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ ⇒ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ → Cf $ by weaken [l5]
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ ⇒ Cf $ by imp_elim [l6, l4]
l8: $ G , H , ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ax
l9: $ … ⇒ Cf $ by ex_elim [l8, l7]
l10: $ G , H , ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ax
l11: $ … ⇒ Cf $ by ex_elim [l10, l9]
l12: $ G , H , ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ x ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ x ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
