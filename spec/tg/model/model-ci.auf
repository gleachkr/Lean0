l28: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ f ∈ fci22_ph_q tX $ by crn_scons_head [l27, l26]
l29: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel $ by weaken [l9]
l30: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ tX = tX $ by eq_refl
l31: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ n = n $ by eq_refl
l32: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ ra_pargs tX x5 n f ∈ lrel $ by wcel_eq_l [ra_pargs_eq [l30, eq_sym [l10], l31, l14], l29]
l33: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ tX ∊ ofsort lsig lopen ks_expr $ by fci22_ph_e [wcel_welc [l28], l32, and_elim_l [l18]]
l34: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ isset ⟨ kc_bvar , vd +: ∅ ⟩ $ by opair_isset
l35: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ ⇒ tX ∊ ofsort lsig lopen ks_expr $ by isset_elim [l34, l33]
l36: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel ⇒ isset ⟨ kc_s , vd +: ∅ ⟩ $ by opair_isset
l37: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel ⇒ tX ∊ ofsort lsig lopen ks_expr $ by isset_elim [l36, l35]
l38: $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $ by fci_inv_pargs [l1, l6, l37]

lemma fci22_ph_all (G: hyps) (tX: set): $ G ⇒ trees ω ⊆ fci22_ph_q tX $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ crn x9 ⊆ fci22_ph_q tX $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ ra_pargs tX d k v ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ v ∊ ofsort lsig lopen ks_expr $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ tX ∊ ofsort lsig lopen ks_expr $ by fci22_ph_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ , ra_pargs tX d k v ∈ lrel ⇒ v ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ ⇒ ra_pargs tX d k v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ ⇒ ∀ k (ra_pargs tX d k v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ ⇒ ∀ d ∀ k (ra_pargs tX d k v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ ⇒ v ∊ fci22_ph_q tX $ by cab_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX , v = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci22_ph_q tX $ by wcel_intro [l13, l12]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_ph_q tX ⇒ ⟨ x8 , x9 ⟩ ∈ fci22_ph_q tX $ by isset_elim [l15, l14]
l17: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci22_ph_q tX → ⟨ x8 , x9 ⟩ ∈ fci22_ph_q tX $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci22_ph_q tX → ⟨ x8 , x9 ⟩ ∈ fci22_ph_q tX) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ fci22_ph_q tX $ by trees_ind_c [l19, l18]

pargs_head_sort
---------------
l1: $ G ⇒ trees ω ⊆ fci22_ph_q tX $ by fci22_ph_all
l2: $ G ⇒ ⟨ kr_pargs , tX +: td +: tk +: te +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (te +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (tk +: te +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (td +: tk +: te +: ∅) $ by scons_set [l5]
l7: $ G ⇒ isset (tX +: td +: tk +: te +: ∅) $ by scons_set [l6]
l8: $ G ⇒ kr_pargs ∈ ω $ by kr_pargs_omega
l9: $ G ⇒ kr_pargs ∈ ω ∧ tX +: td +: tk +: te +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l8], l7]
l10: $ G ⇒ crn (tX +: td +: tk +: te +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l9]]
l11: $ G ⇒ crn (td +: tk +: te +: ∅) ⊆ trees ω $ by crn_scons_tail [l10]
l12: $ G ⇒ crn (tk +: te +: ∅) ⊆ trees ω $ by crn_scons_tail [l11]
l13: $ G ⇒ crn (te +: ∅) ⊆ trees ω $ by crn_scons_tail [l12]
l14: $ G ⇒ isset ω $ by omega_set
l15: $ G ⇒ te ∈ trees ω $ by crn_scons_head_trees [l14, l13]
l16: $ G ⇒ te ∊ fci22_ph_q tX $ by subset_elim [l1, wcel_welc [l15]]
l17: $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $ by fci22_ph_e [l16, #1, #2]

def fci22_pe_q (tX tY: set) (.v .d .k .e: set): class = $ {v | ∀ d ∀ k ∀ e (ra_pargs tX d k v ∈ lrel → ra_pargs tY d k e ∈ lrel → v ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → e ∊ ofsort lsig lopen ks_expr)} $

lemma fci22_pe_e (G: hyps) (tX tY: set) (ty vd vk ve: set): $ G ⇒ ty ∊ fci22_pe_q tX tY $ > $ G ⇒ ra_pargs tX vd vk ty ∈ lrel $ > $ G ⇒ ra_pargs tY vd vk ve ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tY ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ve ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ∀ d ∀ k ∀ e (ra_pargs tX d k ty ∈ lrel → ra_pargs tY d k e ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → e ∊ ofsort lsig lopen ks_expr) $ by cab_elim [#1]
l2: $ G ⇒ ∀ k ∀ e (ra_pargs tX vd k ty ∈ lrel → ra_pargs tY vd k e ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → e ∊ ofsort lsig lopen ks_expr) $ by all_elim [l1]
l3: $ G ⇒ ∀ e (ra_pargs tX vd vk ty ∈ lrel → ra_pargs tY vd vk e ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → e ∊ ofsort lsig lopen ks_expr) $ by all_elim [l2]
l4: $ G ⇒ ra_pargs tX vd vk ty ∈ lrel → ra_pargs tY vd vk ve ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → ve ∊ ofsort lsig lopen ks_expr $ by all_elim [l3]
l5: $ G ⇒ ra_pargs tY vd vk ve ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → ve ∊ ofsort lsig lopen ks_expr $ by imp_elim [l4, #2]
l6: $ G ⇒ ty ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → ve ∊ ofsort lsig lopen ks_expr $ by imp_elim [l5, #3]
l7: $ G ⇒ tY ∊ ofsort lsig lopen ks_expr → ve ∊ ofsort lsig lopen ks_expr $ by imp_elim [l6, #4]
l8: $ G ⇒ ve ∊ ofsort lsig lopen ks_expr $ by imp_elim [l7, #5]

lemma fci22_pe_n (G: hyps) (tX tY: set) (ty k1 j1 vd vk ve: set): $ G ⇒ crn j1 ⊆ fci22_pe_q tX tY $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pargs tX vd vk ty ∈ lrel $ > $ G ⇒ ra_pargs tY vd vk ve ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tY ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ve ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ra_pargs tX vd vk ty ∈ lrel $ by weaken [#5]
l2: $ G ⇒ ra_pargs tY vd vk ve ∈ lrel $ by weaken [#6]
l3: $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ by weaken [#7]
l4: $ G ⇒ tY ∊ ofsort lsig lopen ks_expr $ by weaken [#8]
l5: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX $ by ax
l6: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ vk = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l5]
l7: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ ty = tX $ by and_elim_r [l5]
l8: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ ra_pargs tY vd vk ve ∈ lrel $ by weaken [l2]
l9: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ⇒ vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY $ by ax
l10: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ⇒ vk = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l9]
l11: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ⇒ ve = tY $ by and_elim_r [l9]
l12: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ tY ∊ ofsort lsig lopen ks_expr $ by weaken [l4]
l13: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ⇒ tY ∊ ofsort lsig lopen ks_expr $ by weaken [l12]
l14: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_nz , ∅ ⟩ ∧ ve = tY ⇒ ve ∊ ofsort lsig lopen ks_expr $ by welc_eq_set [eq_sym [l11], l13]
l15: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel $ by ax
l16: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ vk = ⟨ kc_s , x1 +: ∅ ⟩ $ by and_elim_l [l15]
l17: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ $ by and_elim_l [and_elim_r [l15]]
l18: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ vk = ⟨ kc_nz , ∅ ⟩ $ by weaken [l6]
l19: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_s , x1 +: ∅ ⟩ $ by eq_trans [eq_sym [l18], l16]
l20: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ kc_nz ∈ ω $ by kc_nz_omega
l21: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l22: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ kc_nz = kc_s $ by opair_inj_l_c [l19, wcel_isset [l20], wcel_isset [l21]]
l23: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ ¬ kc_nz = kc_s $ by kc_nz_ne_s
l24: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tY ⟨ kc_s , vd +: ∅ ⟩ x1 x2 ∈ lrel ⇒ ve ∊ ofsort lsig lopen ks_expr $ by bot_elim [not_elim [l23, l22]]
l25: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ ve ∊ ofsort lsig lopen ks_expr $ by fci_inv_pargs [l8, l14, l24]
l26: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel ⇒ vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel $ by ax
l27: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel ⇒ vk = ⟨ kc_s , n +: ∅ ⟩ $ by and_elim_l [l26]
