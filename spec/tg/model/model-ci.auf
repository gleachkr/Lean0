lemma fci22_ph_n (G: hyps) (tX: set) (ty k1 j1 vd vk: set): $ G ⇒ crn j1 ⊆ fci22_ph_q tX $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pargs tX vd vk ty ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ra_pargs tX vd vk ty ∈ lrel $ by weaken [#5]
l2: $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ by weaken [#6]
l3: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX $ by ax
l4: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ ty = tX $ by and_elim_r [l3]
