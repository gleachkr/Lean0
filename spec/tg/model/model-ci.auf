l9: $ G , x1 ∊ sat u M tg0 w ∧ x2 ∊ esat u (dsh u M x1) tg w ∧ r = x2 ++ x1 ⇒ x1 ∊ sat u M tg0 w ∧ x2 ∊ esat u (dsh u M x1) tg w ∧ r = x2 ++ x1 $ by ax
l10: $ G , x1 ∊ sat u M tg0 w ∧ x2 ∊ esat u (dsh u M x1) tg w ∧ r = x2 ++ x1 ⇒ x1 ∊ sat u M tg0 w $ by and_elim_l [l9]
l11: $ G , x1 ∊ sat u M tg0 w ∧ x2 ∊ esat u (dsh u M x1) tg w ∧ r = x2 ++ x1 ⇒ x2 ∊ esat u (dsh u M x1) tg w $ by and_elim_l [and_elim_r [l9]]
l12: $ G , x1 ∊ sat u M tg0 w ∧ x2 ∊ esat u (dsh u M x1) tg w ∧ r = x2 ++ x1 ⇒ r = x2 ++ x1 $ by and_elim_r [and_elim_r [l9]]
l13: $ G , x1 ∊ sat u M tg0 w ∧ x2 ∊ esat u (dsh u M x1) tg w ∧ r = x2 ++ x1 , x7 = ∅ ⇒ x1 ∊ sat u M tg0 w $ by weaken [l10]
l14: $ G , x1 ∊ sat u M tg0 w ∧ x2 ∊ esat u (dsh u M x1) tg w ∧ r = x2 ++ x1 , x7 = ∅ ⇒ x2 ∊ esat u (dsh u M x1) tg w $ by weaken [l11]
