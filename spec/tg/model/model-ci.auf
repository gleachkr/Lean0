pargs_rst_val
-------------
l1: $ G ⇒ trees ω ⊆ fci25_pv_q M u w r tD tN tX $ by fci25_pv_all
l2: $ G ⇒ ⟨ kr_pargs , tX +: td +: tk +: te +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (te +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (tk +: te +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (td +: tk +: te +: ∅) $ by scons_set [l5]
l7: $ G ⇒ isset (tX +: td +: tk +: te +: ∅) $ by scons_set [l6]
l8: $ G ⇒ kr_pargs ∈ ω $ by kr_pargs_omega
l9: $ G ⇒ kr_pargs ∈ ω ∧ tX +: td +: tk +: te +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l8], l7]
l10: $ G ⇒ crn (tX +: td +: tk +: te +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l9]]
l11: $ G ⇒ crn (td +: tk +: te +: ∅) ⊆ trees ω $ by crn_scons_tail [l10]
l12: $ G ⇒ crn (tk +: te +: ∅) ⊆ trees ω $ by crn_scons_tail [l11]
l13: $ G ⇒ crn (te +: ∅) ⊆ trees ω $ by crn_scons_tail [l12]
l14: $ G ⇒ isset ω $ by omega_set
l15: $ G ⇒ te ∈ trees ω $ by crn_scons_head_trees [l14, l13]
l16: $ G ⇒ te ∊ fci25_pv_q M u w r tD tN tX $ by subset_elim [l1, wcel_welc [l15]]
l17: $ G ⇒ ∀ z (ra_rst tD tN te z ∈ lrel → dt u M z w r = dt u M te w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 te x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ by fci25_pv_e [l16, #1, #2, #3, #4, #5]

ci_wf1n
-------
l1: $ G ⇒ iwf u H J tg1 td w r $ by weaken [#1]
l2: $ G ⇒ w ∊ lvals $ by wcel_welc [iwf_lvals [l1]]
l3: $ G ⇒ r ∊ sat u (mcv H) tg1 w $ by wcel_welc [iwf_sat [l1]]
l4: $ G ⇒ sat u (mcv H) tg1 w ⊆ fseq u $ by sat_fseq
l5: $ G ⇒ r ∊ fseq u $ by subset_elim [l4, l3]
l6: $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ by weaken [#10]
l7: $ G ⇒ ra_rehead tY te3 tni tT2 te4 ∈ lrel $ by weaken [#29]
l8: $ G ⇒ te3 ∊ ofsort lsig lopen ks_expr $ by rehead_head_sort [l7, l6]
l9: $ G ⇒ ra_pargs te2 tnf tm te3 ∈ lrel $ by weaken [#27]
l10: $ G ⇒ te2 ∊ ofsort lsig lopen ks_expr $ by pargs_head_sort [l9, l8]
