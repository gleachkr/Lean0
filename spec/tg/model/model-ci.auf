l8: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tY ∧ ve = tX ⇒ ty ∊ ofsort lsig lopen ks_expr $ by welc_eq_set [eq_sym [l5], l7]
l9: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel $ by ax
l10: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ ty = ⟨ kc_app , f +: a +: ∅ ⟩ $ by and_elim_l [and_elim_r [l9]]
l11: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ $ by and_elim_l [and_elim_r [and_elim_r [l9]]]
l12: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ ra_rehead tY tX n f x2 ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [l9]]]
l13: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ ve ∊ ofsort lsig lopen ks_expr $ by weaken [l2]
l14: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ x2 ∊ ofsort lsig lopen ks_expr ∧ a ∊ ofsort lsig lopen ks_expr $ by ofsort_app_kids [wcel_eq_l [l11, welc_wcel [l13]]]
l15: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ isset ∅ $ by ax_empty
l16: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ isset (a +: ∅) $ by scons_set [l15]
l17: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ isset (f +: a +: ∅) $ by scons_set [l16]
l18: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ crn j1 ⊆ fci22_rs_q tX tY $ by weaken [#1]
l19: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l20: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l21: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ crn (f +: a +: ∅) ⊆ fci22_rs_q tX tY $ by node_crn_sub [l18, l19, l10, wcel_isset [l20], l17]
l22: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ isset f $ by isset_var
l23: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ f ∈ fci22_rs_q tX tY $ by crn_scons_head [l22, l21]
l24: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ tY ∊ ofsort lsig lopen ks_expr $ by weaken [l3]
l25: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ f ∊ ofsort lsig lopen ks_expr $ by fci22_rs_e [wcel_welc [l23], l12, and_elim_l [l14], l24]
l26: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ ⟨ kc_app , f +: a +: ∅ ⟩ ∈ ofsort lsig lopen ks_expr $ by ofsort_app_intro [welc_wcel [l25], welc_wcel [and_elim_r [l14]]]
l27: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ve = ⟨ kc_app , x2 +: a +: ∅ ⟩ ∧ ra_rehead tY tX n f x2 ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_expr $ by wcel_welc [wcel_eq_l [eq_sym [l10], l26]]
l28: $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ by fci_inv_rehead [l1, l8, l27]

lemma fci22_rs_all (G: hyps) (tX tY: set): $ G ⇒ trees ω ⊆ fci22_rs_q tX tY $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k v e ∈ lrel , e ∊ ofsort lsig lopen ks_expr , tY ∊ ofsort lsig lopen ks_expr ⇒ crn x9 ⊆ fci22_rs_q tX tY $ by ax
