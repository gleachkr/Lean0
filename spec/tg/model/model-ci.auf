l521: $ G , x1 = nvf' ti , x2 = nvf' tc , x3 = nvf' tk , x4 = (ixs td w (ifam u (dnf u (mcv H)) td w)) , x5 = nvf' tio ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by isset_elim [l520, l519]
l522: $ G , x1 = nvf' ti , x2 = nvf' tc , x3 = nvf' tk , x4 = (ixs td w (ifam u (dnf u (mcv H)) td w)) ⇒ isset tio $ by isset_var
l523: $ G , x1 = nvf' ti , x2 = nvf' tc , x3 = nvf' tk , x4 = (ixs td w (ifam u (dnf u (mcv H)) td w)) ⇒ isset (nvf' tio) $ by wcel_isset [nvf_omega [l522]]
l524: $ G , x1 = nvf' ti , x2 = nvf' tc , x3 = nvf' tk , x4 = (ixs td w (ifam u (dnf u (mcv H)) td w)) ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by isset_elim [l523, l521]
l525: $ G , x1 = nvf' ti , x2 = nvf' tc , x3 = nvf' tk ⇒ isset (ixs td w (ifam u (dnf u (mcv H)) td w)) $ by ixs_set
l526: $ G , x1 = nvf' ti , x2 = nvf' tc , x3 = nvf' tk ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by isset_elim [l525, l524]
l527: $ G , x1 = nvf' ti , x2 = nvf' tc ⇒ isset tk $ by isset_var
l528: $ G , x1 = nvf' ti , x2 = nvf' tc ⇒ isset (nvf' tk) $ by wcel_isset [nvf_omega [l527]]
l529: $ G , x1 = nvf' ti , x2 = nvf' tc ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by isset_elim [l528, l526]
l530: $ G , x1 = nvf' ti ⇒ isset tc $ by isset_var
l531: $ G , x1 = nvf' ti ⇒ isset (nvf' tc) $ by wcel_isset [nvf_omega [l530]]
