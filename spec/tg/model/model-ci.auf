l227: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel , xx5 = ⟨ kc_nz , ∅ ⟩ , t = ⟨ kc_tcons , xx6 +: xx0 +: xx3 +: ∅ ⟩ ∧ ra_lift xx5 ⟨ kc_nz , ∅ ⟩ xx6 xx7 ∈ lrel ∧ ra_mty td x1 xx5 ⟨ kc_nz , ∅ ⟩ tv xx7 xx8 ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_s , xx5 +: ∅ ⟩ xx3 yy1 ∈ lrel ∧ ra_capp yy1 ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ c ∈ lrel ⇒ isset ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ $ by opair_isset
l228: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel , xx5 = ⟨ kc_nz , ∅ ⟩ , t = ⟨ kc_tcons , xx6 +: xx0 +: xx3 +: ∅ ⟩ ∧ ra_lift xx5 ⟨ kc_nz , ∅ ⟩ xx6 xx7 ∈ lrel ∧ ra_mty td x1 xx5 ⟨ kc_nz , ∅ ⟩ tv xx7 xx8 ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_s , xx5 +: ∅ ⟩ xx3 yy1 ∈ lrel ∧ ra_capp yy1 ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ c ∈ lrel ⇒ ∃ g ∃ h (tR = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by isset_elim [l227, l226]
l229: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel , xx5 = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ g ∃ h (tR = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by fci_inv_motives [l129, l139, l228]
l230: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l231: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel ⇒ ∃ g ∃ h (tR = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by isset_elim [l230, l229]
l232: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel ⇒ ∃ g ∃ h (tR = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by fci_inv_nth_ty [l2, l118, l231]
l233: $ G ⇒ ∃ g ∃ h (tR = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by fci_inv_rec_rhs [#1, l232]

def fci24_pt_q (tH tk1 te1: set) (.v .d .k .e .j: set): class = $ {v | ∀ d ∀ k ∀ e ∀ j (ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 d k v ∈ lrel → ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel)} $

lemma fci24_pt_e (G: hyps) (tH tk1 te1: set) (ty vd vk ve vj: set): $ G ⇒ ty ∊ fci24_pt_q tH tk1 te1 $ > $ G ⇒ ra_pargs tH ve tk1 te1 ∈ lrel $ > $ G ⇒ ra_pargs te1 vd vk ty ∈ lrel $ > $ G ⇒ ra_add vd vk ve ∈ lrel $ > $ G ⇒ ra_add tk1 vk vj ∈ lrel $ > $ G ⇒ ra_pargs tH vd vj ty ∈ lrel $
----
l1: $ G ⇒ ∀ d ∀ k ∀ e ∀ j (ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 d k ty ∈ lrel → ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j ty ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ k ∀ e ∀ j (ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 vd k ty ∈ lrel → ra_add vd k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH vd j ty ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ∀ e ∀ j (ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 vd vk ty ∈ lrel → ra_add vd vk e ∈ lrel → ra_add tk1 vk j ∈ lrel → ra_pargs tH vd j ty ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ∀ j (ra_pargs tH ve tk1 te1 ∈ lrel → ra_pargs te1 vd vk ty ∈ lrel → ra_add vd vk ve ∈ lrel → ra_add tk1 vk j ∈ lrel → ra_pargs tH vd j ty ∈ lrel) $ by all_elim [l3]
l5: $ G ⇒ ra_pargs tH ve tk1 te1 ∈ lrel → ra_pargs te1 vd vk ty ∈ lrel → ra_add vd vk ve ∈ lrel → ra_add tk1 vk vj ∈ lrel → ra_pargs tH vd vj ty ∈ lrel $ by all_elim [l4]
l6: $ G ⇒ ra_pargs te1 vd vk ty ∈ lrel → ra_add vd vk ve ∈ lrel → ra_add tk1 vk vj ∈ lrel → ra_pargs tH vd vj ty ∈ lrel $ by imp_elim [l5, #2]
l7: $ G ⇒ ra_add vd vk ve ∈ lrel → ra_add tk1 vk vj ∈ lrel → ra_pargs tH vd vj ty ∈ lrel $ by imp_elim [l6, #3]
l8: $ G ⇒ ra_add tk1 vk vj ∈ lrel → ra_pargs tH vd vj ty ∈ lrel $ by imp_elim [l7, #4]
l9: $ G ⇒ ra_pargs tH vd vj ty ∈ lrel $ by imp_elim [l8, #5]

--| @freshen H qn_v
--| @freshen H qj_v
lemma fci_inv_add {qn_v qj_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_add t1 t2 t3 ∈ lrel $ > $ H , t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = t1 ⇒ Cf $ > $ H , t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add t1 qn_v qj_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_add t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ∨ ∃ x ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) $ by lrel_add_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x $ by ax
l4: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t3 = t1 $ by eq_trans [and_elim_r [and_elim_r [l3]], eq_sym [and_elim_l [l3]]]
l5: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = t1 $ by and_intro [and_elim_l [and_elim_r [l3]], l4]
l6: $ H ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = t1 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = t1 → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ⇒ ∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel $ by ax
l13: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ qn_v = qn_v $ by eq_refl
l14: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ qj_v = qj_v $ by eq_refl
l15: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ ra_add t1 qn_v qj_v ∈ lrel $ by wcel_eq_l [ra_add_eq [eq_sym [and_elim_l [l12]], l13, l14], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l16: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add t1 qn_v qj_v ∈ lrel $ by and_intro [and_elim_l [and_elim_r [l12]], and_intro [and_elim_l [and_elim_r [and_elim_r [l12]]], l15]]
l17: $ H ⇒ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add t1 qn_v qj_v ∈ lrel → Cf $ by imp_intro [#3]
l18: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add t1 qn_v qj_v ∈ lrel → Cf $ by weaken [l17]
l19: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ Cf $ by imp_elim [l18, l16]
l20: $ G , H , ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) ⇒ ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) $ by ax
l21: $ … ⇒ Cf $ by ex_elim [l20, l19]
l22: $ G , H , ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) ⇒ ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qj_v +: ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
