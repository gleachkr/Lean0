def fci10_cc_q  (.y .x .r: set): class = $ {y | ∀ x ∀ r (ra_capp y x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx)} $

lemma fci10_cc_e (G: hyps)  (ty vx vr: set): $ G ⇒ ty ∊ fci10_cc_q  $ > $ G ⇒ ra_capp ty vx vr ∈ lrel $ > $ G ⇒ vr ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G ⇒ ∀ x ∀ r (ra_capp ty x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r (ra_capp ty vx r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx) $ by all_elim [l1]
l3: $ G ⇒ ra_capp ty vx vr ∈ lrel → vr ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by all_elim [l2]
l4: $ G ⇒ vr ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l3, #2]
l5: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l4, #3]

lemma fci10_cc_n (G: hyps)  (ty k1 j1 vx vr: set): $ G ⇒ crn j1 ⊆ fci10_cc_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_capp ty vx vr ∈ lrel $ > $ G ⇒ vr ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx $ by ax
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l1]
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ vr = vx $ by and_elim_r [l1]
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ vr ∊ ofsort lsig lopen ks_ctx $ by weaken [#6]
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ⟨ kc_nil , ∅ ⟩ ∈ ofsort lsig lopen ks_ctx $ by ofsort_ctx_nil
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [l2], l5]]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by and_intro [l6, welc_eq_set [l3, l4]]
l8: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel $ by ax
l9: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ $ by and_elim_l [l8]
l10: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ $ by and_elim_l [and_elim_r [l8]]
l11: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ra_capp p vx x5 ∈ lrel $ by and_elim_r [and_elim_r [l8]]
l12: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ vr ∊ ofsort lsig lopen ks_ctx $ by weaken [#6]
l13: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ isset ∅ $ by ax_empty
l14: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ isset (p +: ∅) $ by scons_set [l13]
l15: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ isset (a +: p +: ∅) $ by scons_set [l14]
l16: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ crn j1 ⊆ fci10_cc_q  $ by weaken [#1]
l17: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l18: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l19: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ crn (a +: p +: ∅) ⊆ fci10_cc_q  $ by node_crn_sub [l16, l17, l9, wcel_isset [l18], l15]
l20: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ crn (p +: ∅) ⊆ fci10_cc_q  $ by crn_scons_tail [l19]
l21: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ isset p $ by isset_var
l22: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ p ∈ fci10_cc_q  $ by crn_scons_head [l21, l20]
l23: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ a ∊ ofsort lsig lopen ks_expr ∧ x5 ∊ ofsort lsig lopen ks_ctx $ by ofsort_cons_kids [wcel_eq_l [l10, welc_wcel [l12]]]
l24: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ p ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by fci10_cc_e [wcel_welc [l22], l11, and_elim_r [l23]]
l25: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [l9], ofsort_ctx_cons [welc_wcel [and_elim_l [l23]], welc_wcel [and_elim_l [l24]]]]]
l26: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vr = ⟨ kc_cons , a +: x5 +: ∅ ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by and_intro [l25, and_elim_r [l24]]
l27: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by fci_inv_capp [#5, l7, l26]

lemma fci10_cc_all (G: hyps) : $ G ⇒ trees ω ⊆ fci10_cc_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ crn x9 ⊆ fci10_cc_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ ra_capp y x r ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ r ∊ ofsort lsig lopen ks_ctx $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx $ by fci10_cc_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel ⇒ r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_capp y x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ r (ra_capp y x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ x ∀ r (ra_capp y x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ fci10_cc_q  $ by cab_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci10_cc_q  $ by wcel_intro [l13, l12]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  ⇒ ⟨ x8 , x9 ⟩ ∈ fci10_cc_q  $ by isset_elim [l15, l14]
l17: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci10_cc_q  → ⟨ x8 , x9 ⟩ ∈ fci10_cc_q  $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci10_cc_q  → ⟨ x8 , x9 ⟩ ∈ fci10_cc_q ) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ fci10_cc_q  $ by trees_ind_c [l19, l18]

capp_ctx_inv
------------
l1: $ G ⇒ trees ω ⊆ fci10_cc_q  $ by fci10_cc_all
l2: $ G ⇒ ⟨ kr_capp , t1 +: t2 +: t3 +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (t3 +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (t2 +: t3 +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (t1 +: t2 +: t3 +: ∅) $ by scons_set [l5]
l7: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l8: $ G ⇒ kr_capp ∈ ω ∧ t1 +: t2 +: t3 +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (t1 +: t2 +: t3 +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ t1 ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ t1 ∊ fci10_cc_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ t1 ∊ ofsort lsig lopen ks_ctx ∧ t2 ∊ ofsort lsig lopen ks_ctx $ by fci10_cc_e [l12, #1, #2]

--| @freshen H qnp
--| @freshen H qn_v
--| @freshen H qm_v
--| @freshen H qmn
--| @freshen H qni
--| @freshen H qa_v
--| @freshen H qd1
--| @freshen H qio
--| @freshen H qmo
--| @freshen H qe1
--| @freshen H qe2
--| @freshen H qY
--| @freshen H qT2
--| @freshen H qT0
lemma fci_inv_iota_lhs {qnp qn_v qm_v qmn qni qa_v qd1 qio qmo qe1 qe2 qY qT2 qT0: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set): $ G ⇒ ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ∈ lrel $ > $ H , t11 = ⟨ kc_app , qT0 +: t9 +: ∅ ⟩ ∧ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_nidx t1 t3 qni ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_add t5 qm_v qa_v ∈ lrel ∧ ra_add qa_v qn_v qd1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , t1 +: t3 +: t2 +: ∅ ⟩ qd1 qnp qe1 ∈ lrel ∧ ra_pargs qe1 qa_v qn_v qe2 ∈ lrel ∧ ra_pargs qe2 t5 qm_v t7 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , t1 +: t3 +: ∅ ⟩ qd1 qnp qY ∈ lrel ∧ ra_lift qmn t5 t6 qT2 ∈ lrel ∧ ra_rehead qY t7 qni qT2 t10 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , t1 +: t3 +: t4 +: ∅ ⟩ qd1 qnp t8 ∈ lrel ∧ ra_pargs t8 ⟨ kc_nz , ∅ ⟩ t5 t9 ∈ lrel ∧ ra_add qio ⟨ kc_s , t3 +: ∅ ⟩ qn_v ∈ lrel ∧ ra_add qa_v qio qmo ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , qmo +: ∅ ⟩ qni qT2 qT0 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ qnp ∃ qn_v ∃ qm_v ∃ qmn ∃ v ∃ qni ∃ qa_v ∃ qd1 ∃ qio ∃ qmo ∃ w ∃ qe1 ∃ qe2 ∃ a ∃ b ∃ qY ∃ qT2 ∃ qT0 ∃ c ∃ f (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = c ∧ t9 = f ∧ t10 = b ∧ t11 = ⟨ kc_app , qT0 +: f +: ∅ ⟩ ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_nidx x z qni ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_add v qm_v qa_v ∈ lrel ∧ ra_add qa_v qn_v qd1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , x +: z +: y +: ∅ ⟩ qd1 qnp qe1 ∈ lrel ∧ ra_pargs qe1 qa_v qn_v qe2 ∈ lrel ∧ ra_pargs qe2 v qm_v a ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: z +: ∅ ⟩ qd1 qnp qY ∈ lrel ∧ ra_lift qmn v w qT2 ∈ lrel ∧ ra_rehead qY a qni qT2 b ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: u +: ∅ ⟩ qd1 qnp c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ v f ∈ lrel ∧ ra_add qio ⟨ kc_s , z +: ∅ ⟩ qn_v ∈ lrel ∧ ra_add qa_v qio qmo ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , qmo +: ∅ ⟩ qni qT2 qT0 ∈ lrel) $ by lrel_iota_lhs_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = c ∧ t9 = f ∧ t10 = b ∧ t11 = ⟨ kc_app , qT0 +: f +: ∅ ⟩ ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_nidx x z qni ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_add v qm_v qa_v ∈ lrel ∧ ra_add qa_v qn_v qd1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , x +: z +: y +: ∅ ⟩ qd1 qnp qe1 ∈ lrel ∧ ra_pargs qe1 qa_v qn_v qe2 ∈ lrel ∧ ra_pargs qe2 v qm_v a ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: z +: ∅ ⟩ qd1 qnp qY ∈ lrel ∧ ra_lift qmn v w qT2 ∈ lrel ∧ ra_rehead qY a qni qT2 b ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: u +: ∅ ⟩ qd1 qnp c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ v f ∈ lrel ∧ ra_add qio ⟨ kc_s , z +: ∅ ⟩ qn_v ∈ lrel ∧ ra_add qa_v qio qmo ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , qmo +: ∅ ⟩ qni qT2 qT0 ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = c ∧ t9 = f ∧ t10 = b ∧ t11 = ⟨ kc_app , qT0 +: f +: ∅ ⟩ ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_nidx x z qni ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_add v qm_v qa_v ∈ lrel ∧ ra_add qa_v qn_v qd1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , x +: z +: y +: ∅ ⟩ qd1 qnp qe1 ∈ lrel ∧ ra_pargs qe1 qa_v qn_v qe2 ∈ lrel ∧ ra_pargs qe2 v qm_v a ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: z +: ∅ ⟩ qd1 qnp qY ∈ lrel ∧ ra_lift qmn v w qT2 ∈ lrel ∧ ra_rehead qY a qni qT2 b ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: u +: ∅ ⟩ qd1 qnp c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ v f ∈ lrel ∧ ra_add qio ⟨ kc_s , z +: ∅ ⟩ qn_v ∈ lrel ∧ ra_add qa_v qio qmo ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , qmo +: ∅ ⟩ qni qT2 qT0 ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = c ∧ t9 = f ∧ t10 = b ∧ t11 = ⟨ kc_app , qT0 +: f +: ∅ ⟩ ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_nidx x z qni ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_add v qm_v qa_v ∈ lrel ∧ ra_add qa_v qn_v qd1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , x +: z +: y +: ∅ ⟩ qd1 qnp qe1 ∈ lrel ∧ ra_pargs qe1 qa_v qn_v qe2 ∈ lrel ∧ ra_pargs qe2 v qm_v a ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , x +: z +: ∅ ⟩ qd1 qnp qY ∈ lrel ∧ ra_lift qmn v w qT2 ∈ lrel ∧ ra_rehead qY a qni qT2 b ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: u +: ∅ ⟩ qd1 qnp c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ v f ∈ lrel ∧ ra_add qio ⟨ kc_s , z +: ∅ ⟩ qn_v ∈ lrel ∧ ra_add qa_v qio qmo ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , qmo +: ∅ ⟩ qni qT2 qT0 ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
