l160: $ G , ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel , ∃ n (ty = ⟨ kc_cons , b +: f +: ∅ ⟩ ∧ vq = ⟨ kc_s , n +: ∅ ⟩ ∧ ra_clen f n ∈ lrel) ⇒ ∃ n (ty = ⟨ kc_cons , b +: f +: ∅ ⟩ ∧ vq = ⟨ kc_s , n +: ∅ ⟩ ∧ ra_clen f n ∈ lrel) $ by ax
