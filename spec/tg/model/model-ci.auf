l175: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel , ra_add tnp tnf xx3 ∈ lrel ∧ ra_spine xx5 tmj xx3 ∈ lrel , ra_isort tF tni l ∈ lrel , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti h c ∈ lrel ∧ ra_nth_ctor c tc x5 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x5 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x6 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x6 x5 v ∈ lrel ∧ ra_lams x4 v x7 ∈ lrel ∧ ra_lams x3 x7 x8 ∈ lrel ∧ ra_lams p x8 tR ∈ lrel ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tnp tK0 tK2 ∈ lrel $ by weaken [#45]
l176: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel , ra_add tnp tnf xx3 ∈ lrel ∧ ra_spine xx5 tmj xx3 ∈ lrel , ra_isort tF tni l ∈ lrel , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti h c ∈ lrel ∧ ra_nth_ctor c tc x5 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x5 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x6 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x6 x5 v ∈ lrel ∧ ra_lams x4 v x7 ∈ lrel ∧ ra_lams x3 x7 x8 ∈ lrel ∧ ra_lams p x8 tR ∈ lrel ⇒ r ∊ sat u (mcv H) tg w $ by weaken [#46]
l177: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel , ra_add tnp tnf xx3 ∈ lrel ∧ ra_spine xx5 tmj xx3 ∈ lrel , ra_isort tF tni l ∈ lrel , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t x3 ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t x4 ∈ lrel ∧ ra_nth_ty t ti h c ∈ lrel ∧ ra_nth_ctor c tc x5 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x5 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x6 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x6 x5 v ∈ lrel ∧ ra_lams x4 v x7 ∈ lrel ∧ ra_lams x3 x7 x8 ∈ lrel ∧ ra_lams p x8 tR ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by ci_core [l131, l132, l133, l134, l135, l136, l137, l138, l128, l139, l129, l130, l140, l141, l142, l107, l109, l126, l127, l122, l71, l70, l111, l143, l144, l114, l117, l119, l145, l146, l147, l148, l149, l150, l151, l152, l153, l154, l155, l156, l157, l158, l159, l160, l161, l162, l163, l164, l165, l166, l167, l168, l169, l170, l171, l172, l173, l174, l175, l176]
l178: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel , ra_add tnp tnf xx3 ∈ lrel ∧ ra_spine xx5 tmj xx3 ∈ lrel , ra_isort tF tni l ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by fci_inv_rec_rhs [l55, l177]
l179: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel , ra_add tnp tnf xx3 ∈ lrel ∧ ra_spine xx5 tmj xx3 ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by ex_elim [l53, l178]
l180: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by ex_elim [l43, l179]
l181: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by ex_elim [l34, l180]
l182: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by ex_elim [l30, l181]
l183: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by ex_elim [l26, l182]
l184: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l185: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ , xx5 = ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by isset_elim [l184, l183]
l186: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ ⇒ isset ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ $ by opair_isset
l187: $ G , xx4 = ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by isset_elim [l186, l185]
l188: $ G ⇒ isset ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ $ by opair_isset
l189: $ G ⇒ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , te4 +: tmj +: ∅ ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , tT0 +: tmj +: ∅ ⟩ w r $ by isset_elim [l188, l187]

def fci22_ph_q (tX: set) (.v .d .k: set): class = $ {v | ∀ d ∀ k (ra_pargs tX d k v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr)} $

lemma fci22_ph_e (G: hyps) (tX: set) (ty vd vk: set): $ G ⇒ ty ∊ fci22_ph_q tX $ > $ G ⇒ ra_pargs tX vd vk ty ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ∀ d ∀ k (ra_pargs tX d k ty ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr) $ by cab_elim [#1]
l2: $ G ⇒ ∀ k (ra_pargs tX vd k ty ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr) $ by all_elim [l1]
l3: $ G ⇒ ra_pargs tX vd vk ty ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr $ by all_elim [l2]
l4: $ G ⇒ ty ∊ ofsort lsig lopen ks_expr → tX ∊ ofsort lsig lopen ks_expr $ by imp_elim [l3, #2]
l5: $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $ by imp_elim [l4, #3]

--| @freshen H qe_v
--| @freshen H qn_v
lemma fci_inv_pargs {qe_v qn_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_pargs t1 t2 t3 t4 ∈ lrel $ > $ H , t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 ⇒ Cf $ > $ H , t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , t2 +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs t1 ⟨ kc_s , t2 +: ∅ ⟩ qn_v qe_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_pargs t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) ∨ ∃ x ∃ qe_v ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel) $ by lrel_pargs_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ t4 = t1 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [l3]]], eq_sym [and_elim_l [l3]]]
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 $ by and_intro [and_elim_l [and_elim_r [and_elim_r [l3]]], l4]
l6: $ H ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) ⇒ ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H , ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) ⇒ ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) $ by ax
l12: $ … ⇒ Cf $ by ex_elim [l11, l10]
l13: $ G , H ⇒ (∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x)) → Cf $ by imp_intro [l12]
l14: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel $ by ax
l15: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l16: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel ⇒ kc_bvar = kc_bvar $ by eq_refl
l17: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel ⇒ qe_v = qe_v $ by eq_refl
l18: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel ⇒ kc_app = kc_app $ by eq_refl
