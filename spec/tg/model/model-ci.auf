l193: $ G , tT = ⟨ kc_app , z +: tmj +: ∅ ⟩ ∧ ra_ind_arity td x1 n m ∈ lrel ∧ ra_nidx td ti k ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_add tnf m a ∈ lrel ∧ ra_add a n d ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ d x1 e ∈ lrel ∧ ra_pargs e a n f ∈ lrel ∧ ra_pargs f tnf m te3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ d x1 y ∈ lrel ∧ ra_lift x2 tnf tB t ∈ lrel ∧ ra_rehead y te3 k t te4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ d x1 tc1 ∈ lrel ∧ ra_pargs tc1 ⟨ kc_nz , ∅ ⟩ tnf tmj ∈ lrel ∧ ra_add x3 ⟨ kc_s , ti +: ∅ ⟩ n ∈ lrel ∧ ra_add a x3 x4 ∈ lrel ∧ ra_rehead y ⟨ kc_bvar , x4 +: ∅ ⟩ k t z ∈ lrel , xx4 = ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ , ra_add tnp k l ∈ lrel ∧ ra_spine xx4 t l ∈ lrel ⇒ ra_rst td tN trhs z3 ∈ lrel $ by weaken [#42]
l194: $ G , tT = ⟨ kc_app , z +: tmj +: ∅ ⟩ ∧ ra_ind_arity td x1 n m ∈ lrel ∧ ra_nidx td ti k ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_add tnf m a ∈ lrel ∧ ra_add a n d ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ d x1 e ∈ lrel ∧ ra_pargs e a n f ∈ lrel ∧ ra_pargs f tnf m te3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ d x1 y ∈ lrel ∧ ra_lift x2 tnf tB t ∈ lrel ∧ ra_rehead y te3 k t te4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ d x1 tc1 ∈ lrel ∧ ra_pargs tc1 ⟨ kc_nz , ∅ ⟩ tnf tmj ∈ lrel ∧ ra_add x3 ⟨ kc_s , ti +: ∅ ⟩ n ∈ lrel ∧ ra_add a x3 x4 ∈ lrel ∧ ra_rehead y ⟨ kc_bvar , x4 +: ∅ ⟩ k t z ∈ lrel , xx4 = ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ , ra_add tnp k l ∈ lrel ∧ ra_spine xx4 t l ∈ lrel ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by ci_wf1n [l152, l153, l154, l155, l156, l157, l158, l159, l160, l161, l162, l163, l164, l138, l165, l166, l167, l168, l169, l170, l171, l172, l173, l139, l140, l141, l142, l143, l145, l149, l148, l150, l151, l174, l175, l176, l177, l178, l179, l146, l147, l144, l135, l65, l180, l181, l137, l182, l136, l183, l184, l185, l186, l187, l188, l189, l190, l191, l192, l193]
l195: $ G , tT = ⟨ kc_app , z +: tmj +: ∅ ⟩ ∧ ra_ind_arity td x1 n m ∈ lrel ∧ ra_nidx td ti k ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_add tnf m a ∈ lrel ∧ ra_add a n d ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ d x1 e ∈ lrel ∧ ra_pargs e a n f ∈ lrel ∧ ra_pargs f tnf m te3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ d x1 y ∈ lrel ∧ ra_lift x2 tnf tB t ∈ lrel ∧ ra_rehead y te3 k t te4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ d x1 tc1 ∈ lrel ∧ ra_pargs tc1 ⟨ kc_nz , ∅ ⟩ tnf tmj ∈ lrel ∧ ra_add x3 ⟨ kc_s , ti +: ∅ ⟩ n ∈ lrel ∧ ra_add a x3 x4 ∈ lrel ∧ ra_rehead y ⟨ kc_bvar , x4 +: ∅ ⟩ k t z ∈ lrel , xx4 = ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by ex_elim [l63, l194]
l196: $ G , tT = ⟨ kc_app , z +: tmj +: ∅ ⟩ ∧ ra_ind_arity td x1 n m ∈ lrel ∧ ra_nidx td ti k ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_add tnf m a ∈ lrel ∧ ra_add a n d ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ d x1 e ∈ lrel ∧ ra_pargs e a n f ∈ lrel ∧ ra_pargs f tnf m te3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ d x1 y ∈ lrel ∧ ra_lift x2 tnf tB t ∈ lrel ∧ ra_rehead y te3 k t te4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ d x1 tc1 ∈ lrel ∧ ra_pargs tc1 ⟨ kc_nz , ∅ ⟩ tnf tmj ∈ lrel ∧ ra_add x3 ⟨ kc_s , ti +: ∅ ⟩ n ∈ lrel ∧ ra_add a x3 x4 ∈ lrel ∧ ra_rehead y ⟨ kc_bvar , x4 +: ∅ ⟩ k t z ∈ lrel ⇒ isset ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ $ by opair_isset
l197: $ G , tT = ⟨ kc_app , z +: tmj +: ∅ ⟩ ∧ ra_ind_arity td x1 n m ∈ lrel ∧ ra_nidx td ti k ∈ lrel ∧ ra_add m n x2 ∈ lrel ∧ ra_add tnf m a ∈ lrel ∧ ra_add a n d ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , td +: ti +: tv +: ∅ ⟩ d x1 e ∈ lrel ∧ ra_pargs e a n f ∈ lrel ∧ ra_pargs f tnf m te3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ d x1 y ∈ lrel ∧ ra_lift x2 tnf tB t ∈ lrel ∧ ra_rehead y te3 k t te4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: tc +: ∅ ⟩ d x1 tc1 ∈ lrel ∧ ra_pargs tc1 ⟨ kc_nz , ∅ ⟩ tnf tmj ∈ lrel ∧ ra_add x3 ⟨ kc_s , ti +: ∅ ⟩ n ∈ lrel ∧ ra_add a x3 x4 ∈ lrel ∧ ra_rehead y ⟨ kc_bvar , x4 +: ∅ ⟩ k t z ∈ lrel ⇒ dt u (mcv H) z1 w r = dt u (mcv H) z3 w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) z2 w r $ by isset_elim [l196, l195]
