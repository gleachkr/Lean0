lemma fci2_all (G: hyps) (M: class) (u w p s s2 tk: set): $ G ⇒ trees ω ⊆ fci2_q M u w p s s2 tk $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ crn j ⊆ fci2_q M u w p s s2 tk $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ w ∊ lvals $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ p ∊ fseq u $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ s ∊ fseq u $ by ax
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ s2 ∊ fseq u $ by ax
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ cdm p = nvf' tk $ by ax
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ ra_closed tk t ∈ lrel $ by ax
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ ra_pis y b t ∈ lrel $ by ax
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ ra_clen y q ∈ lrel $ by ax
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel , ra_clen y q ∈ lrel ⇒ esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by fci2_n [l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel , ra_pis y b t ∈ lrel ⇒ ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by imp_intro [l13]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk , ra_closed tk t ∈ lrel ⇒ ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by imp_intro [l14]
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u , cdm p = nvf' tk ⇒ ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by imp_intro [l15]
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u , s2 ∊ fseq u ⇒ cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by imp_intro [l16]
l18: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u , s ∊ fseq u ⇒ s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by imp_intro [l17]
l19: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals , p ∊ fseq u ⇒ s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by imp_intro [l18]
l20: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ , w ∊ lvals ⇒ p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by imp_intro [l19]
l21: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ ⇒ w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w $ by imp_intro [l20]
l22: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ ⇒ ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w) $ by all_intro [l21]
l23: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ ⇒ ∀ t ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w) $ by all_intro [l22]
l24: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ ⇒ ∀ b ∀ t ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w) $ by all_intro [l23]
l25: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ ⇒ y ∊ fci2_q M u w p s s2 tk $ by cab_intro [l24]
l26: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l27: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ fci2_q M u w p s s2 tk $ by wcel_intro [l26, l25]
l28: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l29: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci2_q M u w p s s2 tk ⇒ ⟨ i , j ⟩ ∈ fci2_q M u w p s s2 tk $ by isset_elim [l28, l27]
l30: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ fci2_q M u w p s s2 tk → ⟨ i , j ⟩ ∈ fci2_q M u w p s s2 tk $ by imp_intro [imp_intro [imp_intro [l29]]]
l31: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ fci2_q M u w p s s2 tk → ⟨ i , j ⟩ ∈ fci2_q M u w p s s2 tk) $ by all_intro [all_intro [l30]]
l32: $ G ⇒ isset ω $ by omega_set
l33: $ G ⇒ trees ω ⊆ fci2_q M u w p s s2 tk $ by trees_ind_c [l32, l31]

pis_esat_closed
---------------
l1: $ G ⇒ kr_pis ∈ ω $ by kr_pis_omega
l2: $ G ⇒ tX ∊ trees ω ∧ tB ∊ trees ω ∧ tZ ∊ trees ω $ by lrel_args3 [#7, wcel_isset [l1]]
l3: $ G ⇒ trees ω ⊆ fci2_q M u w p s s2 tk $ by fci2_all
l4: $ G ⇒ tX ∊ fci2_q M u w p s s2 tk $ by subset_elim [l3, and_elim_l [l2]]
l5: $ G ⇒ esat u (dsh u M (p ++ s)) tX w = esat u (dsh u M (p ++ s2)) tX w $ by fci2_e [l4, #1, #2, #3, #4, #5, #6, #7, #8]

def fci3_q (M: class) (u w r tY tX sa sb: set) (.g .f .n .i .z .q: set): class = $ {g | ∀ f ∀ n (uadm u → w ∊ lvals → r ∊ fseq u → etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ → etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → g ∊ trees ω → f ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX n g f ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' n ∧ etel u (dnf u M) g w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) f w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb))} $

--| @freshen G i
--| @freshen G z
--| @freshen G q
lemma fci3_e {i z q: set} (G: hyps) (M: class) (u w r tY tX sa sb: set) (ty vf vn: set): $ G ⇒ ty ∊ fci3_q M u w r tY tX sa sb $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ $ > $ G ⇒ etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ $ > $ G ⇒ sa ∊ fseq u $ > $ G ⇒ sb ∊ fseq u $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ vf ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ra_rehead tY tX vn ty vf ∈ lrel $ > $ G ⇒ ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $
----
l1: $ G ⇒ ∀ f ∀ n (uadm u → w ∊ lvals → r ∊ fseq u → etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ → etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → ty ∊ trees ω → f ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX n ty f ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' n ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) f w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ n (uadm u → w ∊ lvals → r ∊ fseq u → etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ → etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX n ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' n ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb)) $ by all_elim [l1]
l3: $ G ⇒ uadm u → w ∊ lvals → r ∊ fseq u → etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ → etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by all_elim [l2]
l4: $ G ⇒ w ∊ lvals → r ∊ fseq u → etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ → etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l3, #2]
l5: $ G ⇒ r ∊ fseq u → etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ → etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l4, #3]
l6: $ G ⇒ etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ → etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l5, #4]
l7: $ G ⇒ etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l6, #5]
l8: $ G ⇒ sa ∊ fseq u → sb ∊ fseq u → ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l7, #6]
l9: $ G ⇒ sb ∊ fseq u → ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l8, #7]
l10: $ G ⇒ ty ∊ trees ω → vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l9, #8]
l11: $ G ⇒ vf ∊ ofsort lsig lopen ks_expr → ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l10, #9]
l12: $ G ⇒ ra_rehead tY tX vn ty vf ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l11, #10]
l13: $ G ⇒ ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by imp_elim [l12, #11]

--| @freshen G i
--| @freshen G z
--| @freshen G q
lemma fci3_n {i z q: set} (G: hyps) (M: class) (u w r tY tX sa sb: set) (ty k1 j1 vf vn: set): $ G ⇒ crn j1 ⊆ fci3_q M u w r tY tX sa sb $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ $ > $ G ⇒ etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ $ > $ G ⇒ sa ∊ fseq u $ > $ G ⇒ sb ∊ fseq u $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ vf ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ra_rehead tY tX vn ty vf ∈ lrel $ > $ G ⇒ ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $
----
l1: $ G ⇒ ∃ c ∃ d (tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d) ∨ ∃ c ∃ d ∃ e ∃ f ∃ a ∃ n (tY = c ∧ tX = d ∧ vn = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , e +: a +: ∅ ⟩ ∧ vf = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ ra_rehead c d n e f ∈ lrel) $ by lrel_rehead_cases [#14]
l2: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d $ by ax
l3: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ o = ∅ $ by ax
l4: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
l5: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ o ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l3], l4]]
l6: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ cdm ∅ = ∅ $ by cdm_empty
l7: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ nvf = nvf $ by eq_refl
l8: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l9: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ cdm o = nvf' vn $ by eq_trans [cdm_eq [l3], eq_trans [l6, eq_sym [eq_trans [fv_eq [l7, and_elim_l [and_elim_r [and_elim_r [l2]]]], l8]]]]
l10: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ w = w $ by eq_refl
l11: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ r = r $ by eq_refl
l12: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ $ by weaken [#8]
l13: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ $ by eq_trans [etel_eq [eq_trans [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l2]]]], eq_sym [and_elim_l [l2]]], l10, l11], l12]
l14: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ sa = sa $ by eq_refl
l15: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ sa ∊ fseq u $ by weaken [#10]
l16: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ sa = o ++ sa $ by eq_sym [eq_trans [scat_eq [l3, l14], scat_empty_l [l15]]]
l17: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ $ by weaken [#9]
l18: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ $ by eq_trans [etel_eq [eq_trans [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l2]]]], eq_sym [and_elim_l [and_elim_r [l2]]]], l10, l11], l17]
l19: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ sb = sb $ by eq_refl
l20: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ sb ∊ fseq u $ by weaken [#11]
l21: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ sb = o ++ sb $ by eq_sym [eq_trans [scat_eq [l3, l19], scat_empty_l [l20]]]
l22: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ ∧ sb = o ++ sb $ by and_intro [l18, l21]
l23: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ sa = o ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ ∧ sb = o ++ sb $ by and_intro [l16, l22]
l24: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ ∧ sa = o ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ ∧ sb = o ++ sb $ by and_intro [l13, l23]
l25: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ cdm o = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ ∧ sa = o ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ ∧ sb = o ++ sb $ by and_intro [l9, l24]
l26: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ o ∊ fseq u ∧ cdm o = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ ∧ sa = o ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ ∧ sb = o ++ sb $ by and_intro [l5, l25]
l27: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ ∃ q (o ∊ fseq u ∧ cdm o = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ ∧ sa = o ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = o ++ sb) $ by ex_intro [l26]
l28: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ ∃ z ∃ q (o ∊ fseq u ∧ cdm o = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = o ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = o ++ sb) $ by ex_intro [l27]
l29: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d , o = ∅ ⇒ ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by ex_intro [l28]
l30: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d ⇒ isset ∅ $ by ax_empty
l31: $ G , tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d ⇒ ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = nvf' vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = i ++ sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = i ++ sb) $ by isset_elim [l30, l29]
l32: $ G , ∃ d (tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d) ⇒ ∃ d (tY = c ∧ tX = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = c ∧ vf = d) $ by ax
