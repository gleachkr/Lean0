l20: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l21: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ isset (⟨ kc_bvar , vd +: ∅ ⟩ +: ∅) $ by scons_set [l20]
l22: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ isset (f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅) $ by scons_set [l21]
l23: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ crn j1 ⊆ fci22_ph_q tX $ by weaken [#1]
l24: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l25: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ ⇒ kc_app ∈ ω $ by kc_app_omega
