l75: $ G , ra_spine ⟨ kc_ind_ctor , tD +: b +: q +: ∅ ⟩ tx h ∈ lrel ∧ ra_aux_of tD tN b k ∈ lrel ∧ ra_ind_arity tD c e g ∈ lrel ∧ ra_sinst tD ⟨ kc_nz , ∅ ⟩ e c k l ∈ lrel ∧ ra_add c i h ∈ lrel ∧ ra_spine j tx i ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ j l m ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , p +: t +: ∅ ⟩ m x0 ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , p +: t +: ∅ ⟩ ⟨ kc_ind_ctor , p +: t +: q +: ∅ ⟩ x0 m y ∈ lrel ∧ ra_rehead j y i tx tz ∈ lrel ⇒ tz = tx $ by isset_elim [l74, l73]
l76: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel $ by ax
l77: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ $ by and_elim_l [l76]
l78: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ tx = ⟨ kc_bvar , ti +: ∅ ⟩ $ by weaken [l1]
l79: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ ⟨ kc_bvar , ti +: ∅ ⟩ = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ $ by eq_trans [eq_sym [l78], l77]
l80: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l81: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l82: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ kc_bvar = kc_app $ by opair_inj_l_c [l79, wcel_isset [l80], wcel_isset [l81]]
l83: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ ¬ kc_bvar = kc_app $ by kc_bvar_ne_app
l84: $ G , tx = ⟨ kc_app , xx0 +: xx1 +: ∅ ⟩ ∧ tz = ⟨ kc_app , xx2 +: xx3 +: ∅ ⟩ ∧ ra_rst tD tN xx0 xx2 ∈ lrel ∧ ra_rst tD tN xx1 xx3 ∈ lrel ⇒ tz = tx $ by bot_elim [not_elim [l83, l82]]
l85: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel $ by ax
l86: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ $ by and_elim_l [l85]
l87: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ tx = ⟨ kc_bvar , ti +: ∅ ⟩ $ by weaken [l1]
l88: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ ⟨ kc_bvar , ti +: ∅ ⟩ = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ $ by eq_trans [eq_sym [l87], l86]
l89: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l90: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ kc_lam ∈ ω $ by kc_lam_omega
l91: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ kc_bvar = kc_lam $ by opair_inj_l_c [l88, wcel_isset [l89], wcel_isset [l90]]
l92: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ ¬ kc_bvar = kc_lam $ by kc_bvar_ne_lam
l93: $ G , tx = ⟨ kc_lam , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_lam , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ tz = tx $ by bot_elim [not_elim [l92, l91]]
l94: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel $ by ax
l95: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ $ by and_elim_l [l94]
l96: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ tx = ⟨ kc_bvar , ti +: ∅ ⟩ $ by weaken [l1]
l97: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ ⟨ kc_bvar , ti +: ∅ ⟩ = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ $ by eq_trans [eq_sym [l96], l95]
l98: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l99: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l100: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ kc_bvar = kc_pi $ by opair_inj_l_c [l97, wcel_isset [l98], wcel_isset [l99]]
l101: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ ¬ kc_bvar = kc_pi $ by kc_bvar_ne_pi
l102: $ G , tx = ⟨ kc_pi , xx4 +: xx5 +: ∅ ⟩ ∧ tz = ⟨ kc_pi , xx6 +: xx7 +: ∅ ⟩ ∧ ra_rst tD tN xx4 xx6 ∈ lrel ∧ ra_rst tD tN xx5 xx7 ∈ lrel ⇒ tz = tx $ by bot_elim [not_elim [l101, l100]]
l103: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel $ by ax
l104: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ $ by and_elim_l [l103]
l105: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ tx = ⟨ kc_bvar , ti +: ∅ ⟩ $ by weaken [l1]
l106: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ ⟨ kc_bvar , ti +: ∅ ⟩ = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ $ by eq_trans [eq_sym [l105], l104]
l107: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l108: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ kc_proj ∈ ω $ by kc_proj_omega
l109: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ kc_bvar = kc_proj $ by opair_inj_l_c [l106, wcel_isset [l107], wcel_isset [l108]]
l110: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ ¬ kc_bvar = kc_proj $ by kc_bvar_ne_proj
l111: $ G , tx = ⟨ kc_proj , xx5 +: t +: a +: ∅ ⟩ ∧ tz = ⟨ kc_proj , xx5 +: t +: o +: ∅ ⟩ ∧ ra_rst tD tN a o ∈ lrel ⇒ tz = tx $ by bot_elim [not_elim [l110, l109]]
l112: $ G , tz = tx ⇒ tz = tx $ by ax
l113: $ G ⇒ tz = tx $ by fci_inv_rst [#1, l3, l39, l75, l84, l93, l102, l111, l112]

def fci25_pv_q (M: class) (u w r tD tN tX: set) (.v .d .k .z .x1 .x2 .x3 .x4: set): class = $ {v | ∀ d ∀ k (ra_pargs tX d k v ∈ lrel → w ∊ lvals → r ∊ fseq u → ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) → ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) → ∀ z (ra_rst tD tN v z ∈ lrel → dt u M z w r = dt u M v w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 v x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)))} $

--| @freshen G z
--| @freshen G x1
--| @freshen G x2
--| @freshen G x3
--| @freshen G x4
lemma fci25_pv_e {z x1 x2 x3 x4: set} (G: hyps) (M: class) (u w r tD tN tX: set) (ty vd vk: set): $ G ⇒ ty ∊ fci25_pv_q M u w r tD tN tX $ > $ G ⇒ ra_pargs tX vd vk ty ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) $ > $ G ⇒ ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ > $ G ⇒ ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $
----
l1: $ G ⇒ ∀ d ∀ k (ra_pargs tX d k ty ∈ lrel → w ∊ lvals → r ∊ fseq u → ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) → ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) → ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩))) $ by cab_elim [#1]
l2: $ G ⇒ ∀ k (ra_pargs tX vd k ty ∈ lrel → w ∊ lvals → r ∊ fseq u → ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) → ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) → ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩))) $ by all_elim [l1]
l3: $ G ⇒ ra_pargs tX vd vk ty ∈ lrel → w ∊ lvals → r ∊ fseq u → ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) → ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) → ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ by all_elim [l2]
l4: $ G ⇒ w ∊ lvals → r ∊ fseq u → ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) → ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) → ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ by imp_elim [l3, #2]
l5: $ G ⇒ r ∊ fseq u → ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) → ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) → ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ by imp_elim [l4, #3]
l6: $ G ⇒ ∀ z (ra_rst tD tN tX z ∈ lrel → dt u M z w r = dt u M tX w r) → ∀ x1 ∀ x2 (ra_spine x1 tX x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) → ∀ z (ra_rst tD tN ty z ∈ lrel → dt u M z w r = dt u M ty w r) ∧ ∀ x1 ∀ x2 (ra_spine x1 ty x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ by imp_elim [l5, #4]
