l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k v e ∈ lrel , e ∊ ofsort lsig lopen ks_expr , tY ∊ ofsort lsig lopen ks_expr ⇒ e ∊ ofsort lsig lopen ks_expr $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k v e ∈ lrel , e ∊ ofsort lsig lopen ks_expr , tY ∊ ofsort lsig lopen ks_expr ⇒ tY ∊ ofsort lsig lopen ks_expr $ by ax
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k v e ∈ lrel , e ∊ ofsort lsig lopen ks_expr , tY ∊ ofsort lsig lopen ks_expr ⇒ v ∊ ofsort lsig lopen ks_expr $ by fci22_rs_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k v e ∈ lrel , e ∊ ofsort lsig lopen ks_expr ⇒ tY ∊ ofsort lsig lopen ks_expr → v ∊ ofsort lsig lopen ks_expr $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ , ra_rehead tY tX k v e ∈ lrel ⇒ e ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → v ∊ ofsort lsig lopen ks_expr $ by imp_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ ⇒ ra_rehead tY tX k v e ∈ lrel → e ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → v ∊ ofsort lsig lopen ks_expr $ by imp_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ ⇒ ∀ e (ra_rehead tY tX k v e ∈ lrel → e ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → v ∊ ofsort lsig lopen ks_expr) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ ⇒ ∀ k ∀ e (ra_rehead tY tX k v e ∈ lrel → e ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → v ∊ ofsort lsig lopen ks_expr) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ ⇒ v ∊ fci22_rs_q tX tY $ by cab_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY , v = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci22_rs_q tX tY $ by wcel_intro [l15, l14]
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci22_rs_q tX tY ⇒ ⟨ x8 , x9 ⟩ ∈ fci22_rs_q tX tY $ by isset_elim [l17, l16]
l19: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci22_rs_q tX tY → ⟨ x8 , x9 ⟩ ∈ fci22_rs_q tX tY $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci22_rs_q tX tY → ⟨ x8 , x9 ⟩ ∈ fci22_rs_q tX tY) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ fci22_rs_q tX tY $ by trees_ind_c [l21, l20]

rehead_src_sort
---------------
l1: $ G ⇒ trees ω ⊆ fci22_rs_q tX tY $ by fci22_rs_all
l2: $ G ⇒ ⟨ kr_rehead , tY +: tX +: tk +: te +: te2 +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (te2 +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (te +: te2 +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (tk +: te +: te2 +: ∅) $ by scons_set [l5]
l7: $ G ⇒ isset (tX +: tk +: te +: te2 +: ∅) $ by scons_set [l6]
l8: $ G ⇒ isset (tY +: tX +: tk +: te +: te2 +: ∅) $ by scons_set [l7]
l9: $ G ⇒ kr_rehead ∈ ω $ by kr_rehead_omega
l10: $ G ⇒ kr_rehead ∈ ω ∧ tY +: tX +: tk +: te +: te2 +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l9], l8]
l11: $ G ⇒ crn (tY +: tX +: tk +: te +: te2 +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l10]]
l12: $ G ⇒ crn (tX +: tk +: te +: te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l11]
l13: $ G ⇒ crn (tk +: te +: te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l12]
l14: $ G ⇒ crn (te +: te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l13]
l15: $ G ⇒ isset ω $ by omega_set
l16: $ G ⇒ te ∈ trees ω $ by crn_scons_head_trees [l15, l14]
l17: $ G ⇒ te ∊ fci22_rs_q tX tY $ by subset_elim [l1, wcel_welc [l16]]
l18: $ G ⇒ te ∊ ofsort lsig lopen ks_expr $ by fci22_rs_e [l17, #1, #2, #3]

def fci23_ll_q  (.v .b .r .g .h .x1 .x2: set): class = $ {v | ∀ b ∀ r (ra_lams v b r ∈ lrel → ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (r = ⟨ kc_lam , g +: h +: ∅ ⟩))} $

--| @freshen G g
--| @freshen G h
--| @freshen G x1
--| @freshen G x2
lemma fci23_ll_e {g h x1 x2: set} (G: hyps)  (ty vb vr: set): $ G ⇒ ty ∊ fci23_ll_q  $ > $ G ⇒ ra_lams ty vb vr ∈ lrel $ > $ G ⇒ ∃ x1 ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) $ > $ G ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $
----
l1: $ G ⇒ ∀ b ∀ r (ra_lams ty b r ∈ lrel → ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (r = ⟨ kc_lam , g +: h +: ∅ ⟩)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r (ra_lams ty vb r ∈ lrel → ∃ x1 ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (r = ⟨ kc_lam , g +: h +: ∅ ⟩)) $ by all_elim [l1]
l3: $ G ⇒ ra_lams ty vb vr ∈ lrel → ∃ x1 ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by all_elim [l2]
l4: $ G ⇒ ∃ x1 ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by imp_elim [l3, #2]
l5: $ G ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by imp_elim [l4, #3]

--| @freshen H qA
--| @freshen H qP
lemma fci_inv_lams {qA qP: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_lams t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 ⇒ Cf $ > $ H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ ra_lams qP ⟨ kc_lam , qA +: t2 +: ∅ ⟩ t3 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_lams t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) $ by lrel_lams_cases [l1]
l3: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x $ by ax
l4: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t3 = t2 $ by eq_trans [and_elim_r [and_elim_r [l3]], eq_sym [and_elim_l [and_elim_r [l3]]]]
l5: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 $ by and_intro [and_elim_l [l3], l4]
l6: $ H ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by weaken [l6]
l8: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel $ by ax
l13: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l14: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ qA = qA $ by eq_refl
l15: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ kc_lam = kc_lam $ by eq_refl
l16: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ qP = qP $ by eq_refl
l17: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ ra_lams qP ⟨ kc_lam , qA +: t2 +: ∅ ⟩ t3 ∈ lrel $ by wcel_eq_l [ra_lams_eq [l16, opair_eq [l15, scons_eq [l14, scons_eq [eq_sym [and_elim_l [and_elim_r [l12]]], l13]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l12]]]]], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l18: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ ra_lams qP ⟨ kc_lam , qA +: t2 +: ∅ ⟩ t3 ∈ lrel $ by and_intro [and_elim_l [l12], l17]
l19: $ H ⇒ t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ ra_lams qP ⟨ kc_lam , qA +: t2 +: ∅ ⟩ t3 ∈ lrel → Cf $ by imp_intro [#3]
l20: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ ra_lams qP ⟨ kc_lam , qA +: t2 +: ∅ ⟩ t3 ∈ lrel → Cf $ by weaken [l19]
l21: $ G , H , t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel ⇒ Cf $ by imp_elim [l20, l18]
l22: $ G , H , ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) ⇒ ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
l24: $ G , H , ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) ⇒ ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) ⇒ ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H , ∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) ⇒ ∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel) $ by ax
l29: $ … ⇒ Cf $ by ex_elim [l28, l27]
l30: $ G , H ⇒ (∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel)) → Cf $ by imp_intro [l29]
l31: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , qA +: qP +: ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_lams qP ⟨ kc_lam , qA +: x +: ∅ ⟩ y ∈ lrel)) → Cf $ by or_elim_imp [l11, l30]
l32: $ G , H ⇒ Cf $ by imp_elim [l31, l2]

--| @freshen G g
--| @freshen G h
--| @freshen G x1
--| @freshen G x2
lemma fci23_ll_n {g h x1 x2: set} (G: hyps)  (ty k1 j1 vb vr: set): $ G ⇒ crn j1 ⊆ fci23_ll_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_lams ty vb vr ∈ lrel $ > $ G ⇒ ∃ x1 ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) $ > $ G ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $
----
l1: $ G ⇒ ra_lams ty vb vr ∈ lrel $ by weaken [#5]
l2: $ G ⇒ ∃ x1 ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) $ by weaken [#6]
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb $ by ax
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb ⇒ ty = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l3]
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb ⇒ vr = vb $ by and_elim_r [l3]
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb ⇒ ∃ x1 ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) $ by weaken [l2]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb , vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩ ⇒ vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩ $ by ax
l8: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb , vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩ ⇒ vr = vb $ by weaken [l5]
l9: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb , vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩ ⇒ vr = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩ $ by eq_trans [l8, l7]
l10: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb , vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩ ⇒ ∃ h (vr = ⟨ kc_lam , x1 +: h +: ∅ ⟩) $ by ex_intro [l9]
l11: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb , vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩ ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by ex_intro [l10]
l12: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb , ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) ⇒ ∃ x2 (vb = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) $ by ax
l13: $ … ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by ex_elim [l12, l11]
l14: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vb ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by ex_elim [l6, l13]
l15: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel ⇒ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel $ by ax
l16: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel ⇒ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ $ by and_elim_l [l15]
l17: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel ⇒ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel $ by and_elim_r [l15]
l18: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ $ by ax
l19: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ ∃ x2 (x5 = ⟨ kc_lam , a +: x2 +: ∅ ⟩) $ by ex_intro [l18]
l20: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ ∃ x1 ∃ x2 (x5 = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) $ by ex_intro [l19]
l21: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ $ by weaken [l16]
l22: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l23: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ isset (p +: ∅) $ by scons_set [l22]
l24: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ isset (a +: p +: ∅) $ by scons_set [l23]
l25: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ crn j1 ⊆ fci23_ll_q  $ by weaken [#1]
l26: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l27: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ kc_cons ∈ ω $ by kc_cons_omega
l28: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ crn (a +: p +: ∅) ⊆ fci23_ll_q  $ by node_crn_sub [l25, l26, l21, wcel_isset [l27], l24]
l29: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ crn (p +: ∅) ⊆ fci23_ll_q  $ by crn_scons_tail [l28]
l30: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ isset p $ by isset_var
l31: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ p ∈ fci23_ll_q  $ by crn_scons_head [l30, l29]
l32: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel $ by weaken [l17]
l33: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ p = p $ by eq_refl
l34: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ vr = vr $ by eq_refl
l35: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ ra_lams p x5 vr ∈ lrel $ by wcel_eq_l [ra_lams_eq [l33, eq_sym [l18], l34], l32]
l36: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , a +: vb +: ∅ ⟩ ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by fci23_ll_e [wcel_welc [l31], l35, l20]
l37: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel ⇒ isset ⟨ kc_lam , a +: vb +: ∅ ⟩ $ by opair_isset
l38: $ G , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ ra_lams p ⟨ kc_lam , a +: vb +: ∅ ⟩ vr ∈ lrel ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by isset_elim [l37, l36]
l39: $ G ⇒ ∃ g ∃ h (vr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by fci_inv_lams [l1, l14, l38]

lemma fci23_ll_all (G: hyps) : $ G ⇒ trees ω ⊆ fci23_ll_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ , ra_lams v b r ∈ lrel , ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) ⇒ crn x9 ⊆ fci23_ll_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ , ra_lams v b r ∈ lrel , ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ , ra_lams v b r ∈ lrel , ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ , ra_lams v b r ∈ lrel , ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ , ra_lams v b r ∈ lrel , ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) ⇒ ra_lams v b r ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ , ra_lams v b r ∈ lrel , ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) ⇒ ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ , ra_lams v b r ∈ lrel , ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) ⇒ ∃ g ∃ h (r = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by fci23_ll_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ , ra_lams v b r ∈ lrel ⇒ ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (r = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ ⇒ ra_lams v b r ∈ lrel → ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (r = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ ⇒ ∀ r (ra_lams v b r ∈ lrel → ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (r = ⟨ kc_lam , g +: h +: ∅ ⟩)) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ ⇒ ∀ b ∀ r (ra_lams v b r ∈ lrel → ∃ x1 ∃ x2 (b = ⟨ kc_lam , x1 +: x2 +: ∅ ⟩) → ∃ g ∃ h (r = ⟨ kc_lam , g +: h +: ∅ ⟩)) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ ⇒ v ∊ fci23_ll_q  $ by cab_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  , v = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci23_ll_q  $ by wcel_intro [l13, l12]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci23_ll_q  ⇒ ⟨ x8 , x9 ⟩ ∈ fci23_ll_q  $ by isset_elim [l15, l14]
l17: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci23_ll_q  → ⟨ x8 , x9 ⟩ ∈ fci23_ll_q  $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci23_ll_q  → ⟨ x8 , x9 ⟩ ∈ fci23_ll_q ) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ fci23_ll_q  $ by trees_ind_c [l19, l18]

lams_lam
--------
l1: $ G ⇒ trees ω ⊆ fci23_ll_q  $ by fci23_ll_all
l2: $ G ⇒ ⟨ kr_lams , ty +: tb +: tr +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (tr +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (tb +: tr +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (ty +: tb +: tr +: ∅) $ by scons_set [l5]
l7: $ G ⇒ kr_lams ∈ ω $ by kr_lams_omega
l8: $ G ⇒ kr_lams ∈ ω ∧ ty +: tb +: tr +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (ty +: tb +: tr +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ ty ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ ty ∊ fci23_ll_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ ∃ g ∃ h (tr = ⟨ kc_lam , g +: h +: ∅ ⟩) $ by fci23_ll_e [l12, #1, #2]

--| @freshen H qT
--| @freshen H qF2
--| @freshen H qC2
--| @freshen H qi_v
lemma fci_inv_nth_ty {qT qF2 qC2 qi_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_nth_ty t1 t2 t3 t4 ∈ lrel $ > $ H , t1 = ⟨ kc_tcons , t3 +: t4 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ ra_nth_ty qT qi_v t3 t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_nth_ty t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ∨ ∃ x ∃ qF2 ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) $ by lrel_nth_ty_cases [l1]
l3: $ G , H , t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y $ by ax
l4: $ G , H , t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , H , t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ qT = qT $ by eq_refl
l6: $ G , H , t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ kc_tcons = kc_tcons $ by eq_refl
l7: $ G , H , t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ t1 = ⟨ kc_tcons , t3 +: t4 +: qT +: ∅ ⟩ $ by eq_trans [and_elim_l [l3], opair_eq [l6, scons_eq [eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]], scons_eq [eq_sym [and_elim_r [and_elim_r [and_elim_r [l3]]]], scons_eq [l5, l4]]]]]
l8: $ G , H , t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ t1 = ⟨ kc_tcons , t3 +: t4 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l7, and_elim_l [and_elim_r [l3]]]
l9: $ H ⇒ t1 = ⟨ kc_tcons , t3 +: t4 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l10: $ G , H , t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ t1 = ⟨ kc_tcons , t3 +: t4 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l9]
l11: $ G , H , t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ Cf $ by imp_elim [l10, l8]
l12: $ G , H , ∃ qT (t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ⇒ ∃ qT (t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ y ∃ qT (t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ⇒ ∃ y ∃ qT (t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H , ∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ⇒ ∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) $ by ax
l17: $ … ⇒ Cf $ by ex_elim [l16, l15]
l18: $ G , H ⇒ (∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , x +: y +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y)) → Cf $ by imp_intro [l17]
l19: $ G , H , t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel $ by ax
l20: $ G , H , t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ qT = qT $ by eq_refl
l21: $ G , H , t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ qi_v = qi_v $ by eq_refl
l22: $ G , H , t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ ra_nth_ty qT qi_v t3 t4 ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [l20, l21, eq_sym [and_elim_l [and_elim_r [and_elim_r [l19]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l19]]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [l19]]]]]
l23: $ G , H , t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ ra_nth_ty qT qi_v t3 t4 ∈ lrel $ by and_intro [and_elim_l [l19], and_intro [and_elim_l [and_elim_r [l19]], l22]]
l24: $ H ⇒ t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ ra_nth_ty qT qi_v t3 t4 ∈ lrel → Cf $ by imp_intro [#3]
l25: $ G , H , t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ ra_nth_ty qT qi_v t3 t4 ∈ lrel → Cf $ by weaken [l24]
l26: $ G , H , t1 = ⟨ kc_tcons , qF2 +: qC2 +: qT +: ∅ ⟩ ∧ t2 = ⟨ kc_s , qi_v +: ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ Cf $ by imp_elim [l25, l23]
