l95: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) , x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ ⇒ x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ $ by ax
l96: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) , x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ ⇒ ⟨ kc_app , f +: x6 +: ∅ ⟩ = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ $ by eq_trans [eq_sym [l94], l95]
l97: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) , x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ ⇒ kc_app ∈ ω $ by kc_app_omega
l98: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) , x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ ⇒ kc_ind_ctor ∈ ω $ by kc_ind_ctor_omega
l99: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) , x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ ⇒ kc_app = kc_ind_ctor $ by opair_inj_l_c [l96, wcel_isset [l97], wcel_isset [l98]]
l100: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) , x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ ⇒ ¬ kc_app = kc_ind_ctor $ by kc_app_ne_ind_ctor
l101: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) , x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩ ⇒ ⊥ $ by bot_elim [not_elim [l100, l99]]
l102: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) , ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) ⇒ ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) $ by ax
l103: $ … ⇒ ⊥ $ by ex_elim [l102, l101]
l104: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = x1 ∧ x2 = ⟨ kc_nz , ∅ ⟩ , ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩) ⇒ ⊥ $ by ex_elim [l93, l103]
