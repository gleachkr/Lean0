def fci15_ls_q (tn tk th: set) (.y .e .l: set): class = $ {y | ∀ e ∀ l (ra_lift tn tk th th ∈ lrel → ra_lift tn tk e y ∈ lrel → ra_spine th y l ∈ lrel → ra_spine th e l ∈ lrel)} $

lemma fci15_ls_e (G: hyps) (tn tk th: set) (ty ve vl: set): $ G ⇒ ty ∊ fci15_ls_q tn tk th $ > $ G ⇒ ra_lift tn tk th th ∈ lrel $ > $ G ⇒ ra_lift tn tk ve ty ∈ lrel $ > $ G ⇒ ra_spine th ty vl ∈ lrel $ > $ G ⇒ ra_spine th ve vl ∈ lrel $
----
l1: $ G ⇒ ∀ e ∀ l (ra_lift tn tk th th ∈ lrel → ra_lift tn tk e ty ∈ lrel → ra_spine th ty l ∈ lrel → ra_spine th e l ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ l (ra_lift tn tk th th ∈ lrel → ra_lift tn tk ve ty ∈ lrel → ra_spine th ty l ∈ lrel → ra_spine th ve l ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ra_lift tn tk th th ∈ lrel → ra_lift tn tk ve ty ∈ lrel → ra_spine th ty vl ∈ lrel → ra_spine th ve vl ∈ lrel $ by all_elim [l2]
l4: $ G ⇒ ra_lift tn tk ve ty ∈ lrel → ra_spine th ty vl ∈ lrel → ra_spine th ve vl ∈ lrel $ by imp_elim [l3, #2]
l5: $ G ⇒ ra_spine th ty vl ∈ lrel → ra_spine th ve vl ∈ lrel $ by imp_elim [l4, #3]
l6: $ G ⇒ ra_spine th ve vl ∈ lrel $ by imp_elim [l5, #4]

