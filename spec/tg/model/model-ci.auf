l95: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ da ((dsh u M (m ++ s))' b) w c = dt u M b w (c ++ m ++ s) $ by dsh_da [l85, l82, l91]
l96: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ da ((dsh u M s)' a) w c = dt u M a w (c ++ s) $ by dsh_da [welc_wcel [l83], l82, l91]
l97: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ ra_lift k d a b ∈ lrel $ by weaken [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l10]]]]]]
l98: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ cdm m = nvf' k $ by weaken [l37]
l99: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ dt u M b w (c ++ m ++ s) = dt u M a w (c ++ s) $ by lrel_lift_sem [l97, l82, l91, l94, l84, l98, l83]
l100: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ h ∊ da ((dsh u M s)' a) w c $ by ax
l101: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ h ∊ da ((dsh u M (m ++ s))' b) w c $ by welc_eq [eq_sym [eq_trans [l95, eq_trans [l99, eq_sym [l96]]]], l100]
l102: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ l ∊ esat u (dsh u M s) ty w $ by ax
l103: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ esat u (dsh u M s) ty w ⊆ fseq u $ by esat_fseq
l104: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ l ∊ fseq u $ by subset_elim [l103, l102]
l105: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ l = h +: c $ by ax
l106: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ h ∊ u $ by scons_fseq_hd [wcel_eq_l [l105, welc_wcel [l104]]]
l107: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ b ∈ trees ω $ by weaken [l25]
l108: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ z ∈ trees ω $ by weaken [l26]
l109: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ h +: c ∈ esat u (dsh u M (m ++ s)) ⟨ kc_cons , b +: z +: ∅ ⟩ w $ by esat_cons_intro [l107, l108, l82, l88, l101, l106]
l110: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ l = h +: c $ by ax
l111: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ $ by weaken [and_elim_l [and_elim_r [and_elim_r [l10]]]]
l112: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ w = w $ by eq_refl
l113: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da ((dsh u M s)' a) w c , l = h +: c ⇒ l ∊ esat u (dsh u M (m ++ s)) vt w $ by wcel_welc [wcel_eq_l [eq_sym [l110], wcel_eq_r [esat_eq [eq_sym [l111], l112], l109]]]
l114: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w ⇒ a ∈ trees ω $ by weaken [l23]
l115: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w ⇒ p ∈ trees ω $ by weaken [l24]
l116: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w ⇒ w ∊ lvals $ by weaken [l27]
l117: $ … ⇒ l ∊ esat u (dsh u M (m ++ s)) vt w $ by esat_cons_elim [l114, l115, l116, l81, l113]
l118: $ G , tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ esat u (dsh u M (m ++ s)) vt w = esat u (dsh u M s) ty w $ by eq_intro [l77, l117]
l119: $ G , ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) ⇒ ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by ax
l120: $ … ⇒ esat u (dsh u M (m ++ s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l119, l118]
l121: $ G , ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) ⇒ ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by ax
l122: $ … ⇒ esat u (dsh u M (m ++ s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l121, l120]
l123: $ G , ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) ⇒ ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by ax
l124: $ … ⇒ esat u (dsh u M (m ++ s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l123, l122]
l125: $ G , ∃ a ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) ⇒ ∃ a ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by ax
l126: $ … ⇒ esat u (dsh u M (m ++ s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l125, l124]
l127: $ G , ∃ d ∃ a ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) ⇒ ∃ d ∃ a ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by ax
l128: $ … ⇒ esat u (dsh u M (m ++ s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l127, l126]
l129: $ G , ∃ k ∃ d ∃ a ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) ⇒ ∃ k ∃ d ∃ a ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ vt = ⟨ kc_cons , b +: z +: ∅ ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by ax
l130: $ … ⇒ esat u (dsh u M (m ++ s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l129, l128]
l131: $ G ⇒ esat u (dsh u M (m ++ s)) vt w = esat u (dsh u M s) ty w $ by or_elim [l1, l9, l130]

lemma fci1_all (G: hyps) (M: class) (u w s m tk: set): $ G ⇒ trees ω ⊆ fci1_q M u w s m tk $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ crn j ⊆ fci1_q M u w s m tk $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ w ∊ lvals $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ s ∊ fseq u $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ m ∊ fseq u $ by ax
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ cdm m = nvf' tk $ by ax
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ ra_clift tk y t ∈ lrel $ by ax
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk , ra_clift tk y t ∈ lrel ⇒ esat u (dsh u M (m ++ s)) t w = esat u (dsh u M s) y w $ by fci1_n [l1, l2, l3, l4, l5, l6, l7, l8, l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = nvf' tk ⇒ ra_clift tk y t ∈ lrel → esat u (dsh u M (m ++ s)) t w = esat u (dsh u M s) y w $ by imp_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u ⇒ cdm m = nvf' tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (m ++ s)) t w = esat u (dsh u M s) y w $ by imp_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u ⇒ m ∊ fseq u → cdm m = nvf' tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (m ++ s)) t w = esat u (dsh u M s) y w $ by imp_intro [l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals ⇒ s ∊ fseq u → m ∊ fseq u → cdm m = nvf' tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (m ++ s)) t w = esat u (dsh u M s) y w $ by imp_intro [l13]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ w ∊ lvals → s ∊ fseq u → m ∊ fseq u → cdm m = nvf' tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (m ++ s)) t w = esat u (dsh u M s) y w $ by imp_intro [l14]
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ ∀ t (w ∊ lvals → s ∊ fseq u → m ∊ fseq u → cdm m = nvf' tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (m ++ s)) t w = esat u (dsh u M s) y w) $ by all_intro [l15]
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ y ∊ fci1_q M u w s m tk $ by cab_intro [l16]
l18: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l19: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ fci1_q M u w s m tk $ by wcel_intro [l18, l17]
l20: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l21: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk ⇒ ⟨ i , j ⟩ ∈ fci1_q M u w s m tk $ by isset_elim [l20, l19]
l22: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ fci1_q M u w s m tk → ⟨ i , j ⟩ ∈ fci1_q M u w s m tk $ by imp_intro [imp_intro [imp_intro [l21]]]
l23: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ fci1_q M u w s m tk → ⟨ i , j ⟩ ∈ fci1_q M u w s m tk) $ by all_intro [all_intro [l22]]
l24: $ G ⇒ isset ω $ by omega_set
l25: $ G ⇒ trees ω ⊆ fci1_q M u w s m tk $ by trees_ind_c [l24, l23]

clift_sem
---------
l1: $ G ⇒ kr_clift ∈ ω $ by kr_clift_omega
l2: $ G ⇒ tk ∊ trees ω ∧ tX ∊ trees ω ∧ tY ∊ trees ω $ by lrel_args3 [#5, wcel_isset [l1]]
l3: $ G ⇒ trees ω ⊆ fci1_q M u w s m tk $ by fci1_all
l4: $ G ⇒ tX ∊ fci1_q M u w s m tk $ by subset_elim [l3, and_elim_l [and_elim_r [l2]]]
l5: $ G ⇒ esat u (dsh u M (m ++ s)) tY w = esat u (dsh u M s) tX w $ by fci1_e [l4, #1, #2, #3, #4, #5]

def fci2_q (M: class) (u w p s s2 tk: set) (.y .b .t .q: set): class = $ {y | ∀ b ∀ t ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (p ++ s)) y w = esat u (dsh u M (p ++ s2)) y w)} $

lemma fci2_e (G: hyps) (M: class) (u w p s s2 tk: set) (ty vb vt vq: set): $ G ⇒ ty ∊ fci2_q M u w p s s2 tk $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ s2 ∊ fseq u $ > $ G ⇒ cdm p = nvf' tk $ > $ G ⇒ ra_closed tk vt ∈ lrel $ > $ G ⇒ ra_pis ty vb vt ∈ lrel $ > $ G ⇒ ra_clen ty vq ∈ lrel $ > $ G ⇒ esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $
----
l1: $ G ⇒ ∀ b ∀ t ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis ty b t ∈ lrel → ra_clen ty q ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w) $ by cab_elim [#1]
l2: $ G ⇒ ∀ t ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk t ∈ lrel → ra_pis ty vb t ∈ lrel → ra_clen ty q ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w) $ by all_elim [l1]
l3: $ G ⇒ ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty q ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w) $ by all_elim [l2]
l4: $ G ⇒ w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by all_elim [l3]
l5: $ G ⇒ p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by imp_elim [l4, #2]
l6: $ G ⇒ s ∊ fseq u → s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by imp_elim [l5, #3]
l7: $ G ⇒ s2 ∊ fseq u → cdm p = nvf' tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by imp_elim [l6, #4]
l8: $ G ⇒ cdm p = nvf' tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by imp_elim [l7, #5]
l9: $ G ⇒ ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by imp_elim [l8, #6]
l10: $ G ⇒ ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by imp_elim [l9, #7]
l11: $ G ⇒ ra_clen ty vq ∈ lrel → esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by imp_elim [l10, #8]
l12: $ G ⇒ esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by imp_elim [l11, #9]

lemma fci2_n (G: hyps) (M: class) (u w p s s2 tk: set) (ty k1 j1 vb vt vq: set): $ G ⇒ crn j1 ⊆ fci2_q M u w p s s2 tk $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ s2 ∊ fseq u $ > $ G ⇒ cdm p = nvf' tk $ > $ G ⇒ ra_closed tk vt ∈ lrel $ > $ G ⇒ ra_pis ty vb vt ∈ lrel $ > $ G ⇒ ra_clen ty vq ∈ lrel $ > $ G ⇒ esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $
----
l1: $ G ⇒ ∃ v (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v) ∨ ∃ a ∃ v ∃ z ∃ e (ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel) $ by lrel_pis_cases [#11]
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v $ by ax
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v ⇒ w ∊ lvals $ by weaken [#5]
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v ⇒ w = w $ by eq_refl
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v ⇒ esat u (dsh u M (p ++ s)) ty w = csn ∅ $ by eq_trans [esat_eq [and_elim_l [l2], l4], esat_nil [l3]]
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v ⇒ esat u (dsh u M (p ++ s2)) ty w = csn ∅ $ by eq_trans [esat_eq [and_elim_l [l2], l4], esat_nil [l3]]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v ⇒ esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by eq_trans [l5, eq_sym [l6]]
l8: $ G , ∃ v (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v) ⇒ ∃ v (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v) $ by ax
l9: $ … ⇒ esat u (dsh u M (p ++ s)) ty w = esat u (dsh u M (p ++ s2)) ty w $ by ex_elim [l8, l7]
l10: $ G , ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel ⇒ (ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩) ∨ ∃ b ∃ f ∃ n (ty = ⟨ kc_cons , b +: f +: ∅ ⟩ ∧ vq = ⟨ kc_s , n +: ∅ ⟩ ∧ ra_clen f n ∈ lrel) $ by lrel_clen_cases [weaken [#12]]
l11: $ G , ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ $ by ax
l12: $ G , ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel $ by ax
l13: $ G , ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_cons , a +: e +: ∅ ⟩ $ by eq_trans [eq_sym [and_elim_l [l11]], and_elim_l [l12]]
l14: $ G , ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ kc_nil ∈ ω $ by kc_nil_omega
l15: $ G , ty = ⟨ kc_cons , a +: e +: ∅ ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , a +: v +: ∅ ⟩ z ∈ lrel , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cons ∈ ω $ by kc_cons_omega
