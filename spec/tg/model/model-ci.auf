l116: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel , ve = ⟨ kc_app , e +: f +: ∅ ⟩ ∧ ra_lift tn tk e b ∈ lrel ∧ ra_lift tn tk f c ∈ lrel ⇒ ra_spine th ⟨ kc_app , e +: f +: ∅ ⟩ ⟨ kc_s , d +: ∅ ⟩ ∈ lrel $ by lrel_spine_s [l77, l90, l103, l115, l64]
l117: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel , ve = ⟨ kc_app , e +: f +: ∅ ⟩ ∧ ra_lift tn tk e b ∈ lrel ∧ ra_lift tn tk f c ∈ lrel ⇒ th = th $ by eq_refl
l118: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel , ve = ⟨ kc_app , e +: f +: ∅ ⟩ ∧ ra_lift tn tk e b ∈ lrel ∧ ra_lift tn tk f c ∈ lrel ⇒ vl = ⟨ kc_s , d +: ∅ ⟩ $ by weaken [l36]
l119: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel , ve = ⟨ kc_app , e +: f +: ∅ ⟩ ∧ ra_lift tn tk e b ∈ lrel ∧ ra_lift tn tk f c ∈ lrel ⇒ ra_spine th ve vl ∈ lrel $ by wcel_eq_l [ra_spine_eq [l117, eq_sym [l45], eq_sym [l118]], l116]
l120: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel , ∃ f (ve = ⟨ kc_app , e +: f +: ∅ ⟩ ∧ ra_lift tn tk e b ∈ lrel ∧ ra_lift tn tk f c ∈ lrel) ⇒ ∃ f (ve = ⟨ kc_app , e +: f +: ∅ ⟩ ∧ ra_lift tn tk e b ∈ lrel ∧ ra_lift tn tk f c ∈ lrel) $ by ax
l121: $ … ⇒ ra_spine th ve vl ∈ lrel $ by ex_elim [l120, l119]
l122: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel ⇒ ra_spine th ve vl ∈ lrel $ by ex_elim [l43, l121]
l123: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) ⇒ ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) $ by ax
l124: $ … ⇒ ra_spine th ve vl ∈ lrel $ by ex_elim [l123, l122]
l125: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) ⇒ ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) $ by ax
l126: $ … ⇒ ra_spine th ve vl ∈ lrel $ by ex_elim [l125, l124]
l127: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) , ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) ⇒ ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) $ by ax
l128: $ … ⇒ ra_spine th ve vl ∈ lrel $ by ex_elim [l127, l126]
l129: $ G , ∃ a ∃ b ∃ c ∃ d (th = a ∧ ty = ⟨ kc_app , b +: c +: ∅ ⟩ ∧ vl = ⟨ kc_s , d +: ∅ ⟩ ∧ ra_spine a b d ∈ lrel) ⇒ ra_spine th ve vl ∈ lrel $ by ex_elim [l32, l128]
l130: $ G ⇒ ra_spine th ve vl ∈ lrel $ by or_elim [l1, l31, l129]

lemma fci15_ls_all (G: hyps) (tn tk th: set): $ G ⇒ trees ω ⊆ fci15_ls_q tn tk th $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel , ra_spine th y l ∈ lrel ⇒ crn x9 ⊆ fci15_ls_q tn tk th $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel , ra_spine th y l ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel , ra_spine th y l ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel , ra_spine th y l ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel , ra_spine th y l ∈ lrel ⇒ ra_lift tn tk th th ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel , ra_spine th y l ∈ lrel ⇒ ra_lift tn tk e y ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel , ra_spine th y l ∈ lrel ⇒ ra_spine th y l ∈ lrel $ by ax
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel , ra_spine th y l ∈ lrel ⇒ ra_spine th e l ∈ lrel $ by fci15_ls_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel , ra_lift tn tk e y ∈ lrel ⇒ ra_spine th y l ∈ lrel → ra_spine th e l ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ , ra_lift tn tk th th ∈ lrel ⇒ ra_lift tn tk e y ∈ lrel → ra_spine th y l ∈ lrel → ra_spine th e l ∈ lrel $ by imp_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ ⇒ ra_lift tn tk th th ∈ lrel → ra_lift tn tk e y ∈ lrel → ra_spine th y l ∈ lrel → ra_spine th e l ∈ lrel $ by imp_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ ⇒ ∀ l (ra_lift tn tk th th ∈ lrel → ra_lift tn tk e y ∈ lrel → ra_spine th y l ∈ lrel → ra_spine th e l ∈ lrel) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ ⇒ ∀ e ∀ l (ra_lift tn tk th th ∈ lrel → ra_lift tn tk e y ∈ lrel → ra_spine th y l ∈ lrel → ra_spine th e l ∈ lrel) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ fci15_ls_q tn tk th $ by cab_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci15_ls_q tn tk th $ by wcel_intro [l15, l14]
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci15_ls_q tn tk th ⇒ ⟨ x8 , x9 ⟩ ∈ fci15_ls_q tn tk th $ by isset_elim [l17, l16]
l19: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci15_ls_q tn tk th → ⟨ x8 , x9 ⟩ ∈ fci15_ls_q tn tk th $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci15_ls_q tn tk th → ⟨ x8 , x9 ⟩ ∈ fci15_ls_q tn tk th) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ fci15_ls_q tn tk th $ by trees_ind_c [l21, l20]

lift_spine_inv
--------------
l1: $ G ⇒ trees ω ⊆ fci15_ls_q tn tk th $ by fci15_ls_all
l2: $ G ⇒ ⟨ kr_lift , tn +: tk +: te +: te2 +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#2]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (te2 +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (te +: te2 +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (tk +: te +: te2 +: ∅) $ by scons_set [l5]
l7: $ G ⇒ isset (tn +: tk +: te +: te2 +: ∅) $ by scons_set [l6]
l8: $ G ⇒ kr_lift ∈ ω $ by kr_lift_omega
l9: $ G ⇒ kr_lift ∈ ω ∧ tn +: tk +: te +: te2 +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l8], l7]
l10: $ G ⇒ crn (tn +: tk +: te +: te2 +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l9]]
l11: $ G ⇒ crn (tk +: te +: te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l10]
l12: $ G ⇒ crn (te +: te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l11]
l13: $ G ⇒ crn (te2 +: ∅) ⊆ trees ω $ by crn_scons_tail [l12]
l14: $ G ⇒ isset ω $ by omega_set
l15: $ G ⇒ te2 ∈ trees ω $ by crn_scons_head_trees [l14, l13]
l16: $ G ⇒ te2 ∊ fci15_ls_q tn tk th $ by subset_elim [l1, wcel_welc [l15]]
l17: $ G ⇒ ra_spine th te tl ∈ lrel $ by fci15_ls_e [l16, #1, #2, #3]

def fci20_ps_q (tp: set) (.y .n .a .x .r .t .d .k .q .e: set): class = $ {y | ∀ n ∀ a ∀ x ∀ r ∀ t ∀ d ∀ k ∀ q (ra_psplit n y a x r ∈ lrel → ra_pis a y t ∈ lrel → ra_clen a d ∈ lrel → ra_add n d k ∈ lrel → ra_capp a tp q ∈ lrel → ra_pis x r t ∈ lrel ∧ ra_clen x k ∈ lrel ∧ ∃ e (ra_capp x tp e ∈ lrel))} $

--| @freshen G e
lemma fci20_ps_e {e: set} (G: hyps) (tp: set) (ty vn va vx vr vt vd vk vq: set): $ G ⇒ ty ∊ fci20_ps_q tp $ > $ G ⇒ ra_psplit vn ty va vx vr ∈ lrel $ > $ G ⇒ ra_pis va ty vt ∈ lrel $ > $ G ⇒ ra_clen va vd ∈ lrel $ > $ G ⇒ ra_add vn vd vk ∈ lrel $ > $ G ⇒ ra_capp va tp vq ∈ lrel $ > $ G ⇒ ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $
----
l1: $ G ⇒ ∀ n ∀ a ∀ x ∀ r ∀ t ∀ d ∀ k ∀ q (ra_psplit n ty a x r ∈ lrel → ra_pis a ty t ∈ lrel → ra_clen a d ∈ lrel → ra_add n d k ∈ lrel → ra_capp a tp q ∈ lrel → ra_pis x r t ∈ lrel ∧ ra_clen x k ∈ lrel ∧ ∃ e (ra_capp x tp e ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ a ∀ x ∀ r ∀ t ∀ d ∀ k ∀ q (ra_psplit vn ty a x r ∈ lrel → ra_pis a ty t ∈ lrel → ra_clen a d ∈ lrel → ra_add vn d k ∈ lrel → ra_capp a tp q ∈ lrel → ra_pis x r t ∈ lrel ∧ ra_clen x k ∈ lrel ∧ ∃ e (ra_capp x tp e ∈ lrel)) $ by all_elim [l1]
l3: $ G ⇒ ∀ x ∀ r ∀ t ∀ d ∀ k ∀ q (ra_psplit vn ty va x r ∈ lrel → ra_pis va ty t ∈ lrel → ra_clen va d ∈ lrel → ra_add vn d k ∈ lrel → ra_capp va tp q ∈ lrel → ra_pis x r t ∈ lrel ∧ ra_clen x k ∈ lrel ∧ ∃ e (ra_capp x tp e ∈ lrel)) $ by all_elim [l2]
l4: $ G ⇒ ∀ r ∀ t ∀ d ∀ k ∀ q (ra_psplit vn ty va vx r ∈ lrel → ra_pis va ty t ∈ lrel → ra_clen va d ∈ lrel → ra_add vn d k ∈ lrel → ra_capp va tp q ∈ lrel → ra_pis vx r t ∈ lrel ∧ ra_clen vx k ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel)) $ by all_elim [l3]
l5: $ G ⇒ ∀ t ∀ d ∀ k ∀ q (ra_psplit vn ty va vx vr ∈ lrel → ra_pis va ty t ∈ lrel → ra_clen va d ∈ lrel → ra_add vn d k ∈ lrel → ra_capp va tp q ∈ lrel → ra_pis vx vr t ∈ lrel ∧ ra_clen vx k ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel)) $ by all_elim [l4]
l6: $ G ⇒ ∀ d ∀ k ∀ q (ra_psplit vn ty va vx vr ∈ lrel → ra_pis va ty vt ∈ lrel → ra_clen va d ∈ lrel → ra_add vn d k ∈ lrel → ra_capp va tp q ∈ lrel → ra_pis vx vr vt ∈ lrel ∧ ra_clen vx k ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel)) $ by all_elim [l5]
l7: $ G ⇒ ∀ k ∀ q (ra_psplit vn ty va vx vr ∈ lrel → ra_pis va ty vt ∈ lrel → ra_clen va vd ∈ lrel → ra_add vn vd k ∈ lrel → ra_capp va tp q ∈ lrel → ra_pis vx vr vt ∈ lrel ∧ ra_clen vx k ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel)) $ by all_elim [l6]
l8: $ G ⇒ ∀ q (ra_psplit vn ty va vx vr ∈ lrel → ra_pis va ty vt ∈ lrel → ra_clen va vd ∈ lrel → ra_add vn vd vk ∈ lrel → ra_capp va tp q ∈ lrel → ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel)) $ by all_elim [l7]
l9: $ G ⇒ ra_psplit vn ty va vx vr ∈ lrel → ra_pis va ty vt ∈ lrel → ra_clen va vd ∈ lrel → ra_add vn vd vk ∈ lrel → ra_capp va tp vq ∈ lrel → ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $ by all_elim [l8]
l10: $ G ⇒ ra_pis va ty vt ∈ lrel → ra_clen va vd ∈ lrel → ra_add vn vd vk ∈ lrel → ra_capp va tp vq ∈ lrel → ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $ by imp_elim [l9, #2]
l11: $ G ⇒ ra_clen va vd ∈ lrel → ra_add vn vd vk ∈ lrel → ra_capp va tp vq ∈ lrel → ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $ by imp_elim [l10, #3]
l12: $ G ⇒ ra_add vn vd vk ∈ lrel → ra_capp va tp vq ∈ lrel → ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $ by imp_elim [l11, #4]
l13: $ G ⇒ ra_capp va tp vq ∈ lrel → ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $ by imp_elim [l12, #5]
l14: $ G ⇒ ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $ by imp_elim [l13, #6]

--| @freshen H qn_v
--| @freshen H qB
--| @freshen H qC
lemma fci_inv_psplit {qn_v qB qC: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5: set): $ G ⇒ ra_psplit t1 t2 t3 t4 t5 ∈ lrel $ > $ H , t1 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t3 ∧ t5 = t2 ⇒ Cf $ > $ H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: t3 +: ∅ ⟩ t4 t5 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_psplit t1 t2 t3 t4 t5 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x) ∨ ∃ qn_v ∃ qB ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) $ by lrel_psplit_cases [l1]
l3: $ G , H , t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x $ by ax
l4: $ G , H , t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x ⇒ t4 = t3 $ by eq_trans [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]]]
l5: $ G , H , t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x ⇒ t5 = t2 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]], eq_sym [and_elim_l [and_elim_r [l3]]]]
l6: $ G , H , t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t3 ∧ t5 = t2 $ by and_intro [and_elim_l [l3], and_intro [l4, l5]]
l7: $ H ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t3 ∧ t5 = t2 → Cf $ by imp_intro [#2]
l8: $ G , H , t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t3 ∧ t5 = t2 → Cf $ by weaken [l7]
l9: $ G , H , t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x ⇒ Cf $ by imp_elim [l8, l6]
l10: $ G , H , ∃ y (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x) ⇒ ∃ y (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x) $ by ax
l11: $ … ⇒ Cf $ by ex_elim [l10, l9]
l12: $ G , H , ∃ x ∃ y (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x) ⇒ ∃ x ∃ y (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H ⇒ (∃ x ∃ y (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x)) → Cf $ by imp_intro [l13]
l15: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel $ by ax
l16: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l17: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ qB = qB $ by eq_refl
l18: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ kc_cons = kc_cons $ by eq_refl
l19: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ qn_v = qn_v $ by eq_refl
l20: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ qC = qC $ by eq_refl
l21: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ ra_psplit qn_v qC ⟨ kc_cons , qB +: t3 +: ∅ ⟩ t4 t5 ∈ lrel $ by wcel_eq_l [ra_psplit_eq [l19, l20, opair_eq [l18, scons_eq [l17, scons_eq [eq_sym [and_elim_l [and_elim_r [and_elim_r [l15]]]], l16]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l15]]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l15]]]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l15]]]]]]
l22: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: t3 +: ∅ ⟩ t4 t5 ∈ lrel $ by and_intro [and_elim_l [l15], and_intro [and_elim_l [and_elim_r [l15]], l21]]
l23: $ H ⇒ t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: t3 +: ∅ ⟩ t4 t5 ∈ lrel → Cf $ by imp_intro [#3]
l24: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: t3 +: ∅ ⟩ t4 t5 ∈ lrel → Cf $ by weaken [l23]
l25: $ G , H , t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel ⇒ Cf $ by imp_elim [l24, l22]
l26: $ G , H , ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) ⇒ ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H , ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) ⇒ ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) $ by ax
l29: $ … ⇒ Cf $ by ex_elim [l28, l27]
l30: $ G , H , ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) ⇒ ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) $ by ax
l31: $ … ⇒ Cf $ by ex_elim [l30, l29]
l32: $ G , H , ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) ⇒ ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) $ by ax
l33: $ … ⇒ Cf $ by ex_elim [l32, l31]
l34: $ G , H , ∃ qB ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) ⇒ ∃ qB ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) $ by ax
l35: $ … ⇒ Cf $ by ex_elim [l34, l33]
l36: $ G , H , ∃ qn_v ∃ qB ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) ⇒ ∃ qn_v ∃ qB ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel) $ by ax
l37: $ … ⇒ Cf $ by ex_elim [l36, l35]
l38: $ G , H ⇒ (∃ qn_v ∃ qB ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel)) → Cf $ by imp_intro [l37]
l39: $ G , H ⇒ (∃ x ∃ y (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = x ∧ t3 = y ∧ t4 = y ∧ t5 = x) ∨ ∃ qn_v ∃ qB ∃ qC ∃ z ∃ y ∃ u (t1 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , qB +: qC +: ∅ ⟩ ∧ t3 = y ∧ t4 = u ∧ t5 = z ∧ ra_psplit qn_v qC ⟨ kc_cons , qB +: y +: ∅ ⟩ u z ∈ lrel)) → Cf $ by or_elim_imp [l14, l38]
l40: $ G , H ⇒ Cf $ by imp_elim [l39, l2]

--| @freshen G e
lemma fci20_ps_n {e: set} (G: hyps) (tp: set) (ty k1 j1 vn va vx vr vt vd vk vq: set): $ G ⇒ crn j1 ⊆ fci20_ps_q tp $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_psplit vn ty va vx vr ∈ lrel $ > $ G ⇒ ra_pis va ty vt ∈ lrel $ > $ G ⇒ ra_clen va vd ∈ lrel $ > $ G ⇒ ra_add vn vd vk ∈ lrel $ > $ G ⇒ ra_capp va tp vq ∈ lrel $ > $ G ⇒ ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $
----
l1: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty $ by ax
l2: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vn = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l1]
l3: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vx = va $ by and_elim_l [and_elim_r [l1]]
l4: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vr = ty $ by and_elim_r [and_elim_r [l1]]
l5: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_psplit vn ty va vx vr ∈ lrel $ by weaken [#5]
l6: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_pis va ty vt ∈ lrel $ by weaken [#6]
l7: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_clen va vd ∈ lrel $ by weaken [#7]
l8: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_add vn vd vk ∈ lrel $ by weaken [#8]
l9: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_capp va tp vq ∈ lrel $ by weaken [#9]
l10: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vt = vt $ by eq_refl
l11: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_pis vx vr vt ∈ lrel $ by wcel_eq_l [ra_pis_eq [eq_sym [l3], eq_sym [l4], l10], l6]
l12: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vd = vd $ by eq_refl
l13: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vk = vk $ by eq_refl
l14: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vd vk ∈ lrel $ by wcel_eq_l [ra_add_eq [l2, l12, l13], l8]
l15: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vk = vd $ by add_zero_l [l14]
l16: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_clen vx vk ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [l3], eq_sym [l15]], l7]
l17: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ tp = tp $ by eq_refl
l18: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ vq = vq $ by eq_refl
l19: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_capp vx tp vq ∈ lrel $ by wcel_eq_l [ra_capp_eq [eq_sym [l3], l17, l18], l9]
l20: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ∃ e (ra_capp vx tp e ∈ lrel) $ by ex_intro [l19]
l21: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $ by and_intro [l16, l20]
l22: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ vx = va ∧ vr = ty ⇒ ra_pis vx vr vt ∈ lrel ∧ ra_clen vx vk ∈ lrel ∧ ∃ e (ra_capp vx tp e ∈ lrel) $ by and_intro [l11, l21]
l23: $ G , vn = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_pi , b +: c +: ∅ ⟩ ∧ ra_psplit n c ⟨ kc_cons , b +: va +: ∅ ⟩ vx vr ∈ lrel ⇒ vn = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_pi , b +: c +: ∅ ⟩ ∧ ra_psplit n c ⟨ kc_cons , b +: va +: ∅ ⟩ vx vr ∈ lrel $ by ax
l24: $ G , vn = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_pi , b +: c +: ∅ ⟩ ∧ ra_psplit n c ⟨ kc_cons , b +: va +: ∅ ⟩ vx vr ∈ lrel ⇒ vn = ⟨ kc_s , n +: ∅ ⟩ $ by and_elim_l [l23]
l25: $ G , vn = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_pi , b +: c +: ∅ ⟩ ∧ ra_psplit n c ⟨ kc_cons , b +: va +: ∅ ⟩ vx vr ∈ lrel ⇒ ty = ⟨ kc_pi , b +: c +: ∅ ⟩ $ by and_elim_l [and_elim_r [l23]]
l26: $ G , vn = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_pi , b +: c +: ∅ ⟩ ∧ ra_psplit n c ⟨ kc_cons , b +: va +: ∅ ⟩ vx vr ∈ lrel ⇒ ra_psplit n c ⟨ kc_cons , b +: va +: ∅ ⟩ vx vr ∈ lrel $ by and_elim_r [and_elim_r [l23]]
l27: $ G , vn = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_pi , b +: c +: ∅ ⟩ ∧ ra_psplit n c ⟨ kc_cons , b +: va +: ∅ ⟩ vx vr ∈ lrel ⇒ ra_psplit vn ty va vx vr ∈ lrel $ by weaken [#5]
l28: $ G , vn = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_pi , b +: c +: ∅ ⟩ ∧ ra_psplit n c ⟨ kc_cons , b +: va +: ∅ ⟩ vx vr ∈ lrel ⇒ ra_pis va ty vt ∈ lrel $ by weaken [#6]
