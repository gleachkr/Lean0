l23: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel ⇒ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , t2 +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs t1 ⟨ kc_s , t2 +: ∅ ⟩ qn_v qe_v ∈ lrel $ by and_intro [and_elim_l [and_elim_r [and_elim_r [l14]]], and_intro [l19, l22]]
l24: $ H ⇒ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , t2 +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs t1 ⟨ kc_s , t2 +: ∅ ⟩ qn_v qe_v ∈ lrel → Cf $ by imp_intro [#3]
l25: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , y +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs x ⟨ kc_s , y +: ∅ ⟩ qn_v qe_v ∈ lrel ⇒ t3 = ⟨ kc_s , qn_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qe_v +: ⟨ kc_bvar , t2 +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs t1 ⟨ kc_s , t2 +: ∅ ⟩ qn_v qe_v ∈ lrel → Cf $ by weaken [l24]
