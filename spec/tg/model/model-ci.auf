l238: $ G , H ⇒ (∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_lam , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_pi , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , qb_v +: qi_v +: qe_v +: ∅ ⟩ ∧ t4 = ⟨ kc_proj , qb_v +: qi_v +: qe2 +: ∅ ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l178, l237]
l239: $ G , H ⇒ (∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , qf_v +: qa_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qf2 +: qa2 +: ∅ ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_lam , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_pi , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , qb_v +: qi_v +: qe_v +: ∅ ⟩ ∧ t4 = ⟨ kc_proj , qb_v +: qi_v +: qe2 +: ∅ ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l154, l238]
l240: $ G , H ⇒ (∃ x ∃ qI ∃ y ∃ qj_v ∃ qc_v ∃ qi_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qnpi ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qY ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ctor , x +: qj_v +: qc_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ ⟨ kc_ind_ctor , qI +: qi_v +: qc_v +: ∅ ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , qf_v +: qa_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qf2 +: qa2 +: ∅ ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_lam , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_pi , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , qb_v +: qi_v +: qe_v +: ∅ ⟩ ∧ t4 = ⟨ kc_proj , qb_v +: qi_v +: qe2 +: ∅ ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l130, l239]
l241: $ G , H ⇒ (∃ x ∃ y ∃ qj_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ qI ∃ y ∃ qj_v ∃ qc_v ∃ qi_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qnpi ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qY ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ctor , x +: qj_v +: qc_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ ⟨ kc_ind_ctor , qI +: qi_v +: qc_v +: ∅ ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , qf_v +: qa_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qf2 +: qa2 +: ∅ ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_lam , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_pi , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , qb_v +: qi_v +: qe_v +: ∅ ⟩ ∧ t4 = ⟨ kc_proj , qb_v +: qi_v +: qe2 +: ∅ ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l66, l240]
l242: $ G , H ⇒ (∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) ∨ ∃ x ∃ y ∃ qj_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ qI ∃ y ∃ qj_v ∃ qc_v ∃ qi_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qnpi ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qY ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ctor , x +: qj_v +: qc_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ ⟨ kc_ind_ctor , qI +: qi_v +: qc_v +: ∅ ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , qf_v +: qa_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qf2 +: qa2 +: ∅ ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_lam , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_pi , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , qb_v +: qi_v +: qe_v +: ∅ ⟩ ∧ t4 = ⟨ kc_proj , qb_v +: qi_v +: qe2 +: ∅ ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l13, l241]
l243: $ G , H ⇒ Cf $ by imp_elim [l242, l2]

--| @freshen H qe_v
--| @freshen H qa_v
--| @freshen H qk_v
lemma fci_inv_spine {qe_v qa_v qk_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_spine t1 t2 t3 ∈ lrel $ > $ H , t2 = t1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine t1 qe_v qk_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_spine t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x ∃ qe_v ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) $ by lrel_spine_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l4: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t2 = t1 $ by eq_trans [and_elim_l [and_elim_r [l3]], eq_sym [and_elim_l [l3]]]
l5: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t2 = t1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l4, and_elim_r [and_elim_r [l3]]]
l6: $ H ⇒ t2 = t1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t2 = t1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel $ by ax
l13: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ qe_v = qe_v $ by eq_refl
l14: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ qk_v = qk_v $ by eq_refl
l15: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ ra_spine t1 qe_v qk_v ∈ lrel $ by wcel_eq_l [ra_spine_eq [eq_sym [and_elim_l [l12]], l13, l14], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l16: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine t1 qe_v qk_v ∈ lrel $ by and_intro [and_elim_l [and_elim_r [l12]], and_intro [and_elim_l [and_elim_r [and_elim_r [l12]]], l15]]
l17: $ H ⇒ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine t1 qe_v qk_v ∈ lrel → Cf $ by imp_intro [#3]
l18: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine t1 qe_v qk_v ∈ lrel → Cf $ by weaken [l17]
l19: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ Cf $ by imp_elim [l18, l16]
l20: $ G , H , ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) ⇒ ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) $ by ax
l21: $ … ⇒ Cf $ by ex_elim [l20, l19]
l22: $ G , H , ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) ⇒ ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , qe_v +: qa_v +: ∅ ⟩ ∧ t3 = ⟨ kc_s , qk_v +: ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
