l1: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx Dl) w , x0 = enc_ctx Dl0 , x1 = enc_ctx Dl , x2 = enc_ind D , x3 = enc_ctx N , x4 = enc_nat j , x5 = enc_nat i , x6 = enc_nat k , x7 = enc_expr lhs0 , x8 = enc_expr lhs , x9 = enc_expr T ⇒ uadm u $ by ax
