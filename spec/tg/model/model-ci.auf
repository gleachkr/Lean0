--| @freshen H qb2
lemma fci_inv_rst {qe_v qj_v qnp qn_v qm_v qna qk_v qS qX qX1 qX2 qe2 qI qc_v qi_v qnpi qY qf_v qa_v qf2 qa2 qA qb_v qA2 qb2: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_rst t1 t2 t3 t4 ∈ lrel $ > $ H , t2 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = t3 ⇒ Cf $ > $ H , ra_spine ⟨ kc_ind_ty , t1 +: qj_v +: ∅ ⟩ t3 qna ∈ lrel ∧ ra_aux_of t1 t2 qj_v qX ∈ lrel ∧ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS t3 qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v t3 t4 ∈ lrel ⇒ Cf $ > $ H , ra_spine ⟨ kc_ind_ctor , t1 +: qj_v +: qc_v +: ∅ ⟩ t3 qna ∈ lrel ∧ ra_aux_of t1 t2 qj_v qX ∈ lrel ∧ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS t3 qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ ⟨ kc_ind_ctor , qI +: qi_v +: qc_v +: ∅ ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v t3 t4 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_app , qf_v +: qa_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qf2 +: qa2 +: ∅ ⟩ ∧ ra_rst t1 t2 qf_v qf2 ∈ lrel ∧ ra_rst t1 t2 qa_v qa2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_lam , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_lam , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst t1 t2 qA qA2 ∈ lrel ∧ ra_rst t1 t2 qb_v qb2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_pi , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_pi , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst t1 t2 qA qA2 ∈ lrel ∧ ra_rst t1 t2 qb_v qb2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_proj , qb_v +: qi_v +: qe_v +: ∅ ⟩ ∧ t4 = ⟨ kc_proj , qb_v +: qi_v +: qe2 +: ∅ ⟩ ∧ ra_rst t1 t2 qe_v qe2 ∈ lrel ⇒ Cf $ > $ H , t4 = t3 ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_rst t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) ∨ ∃ x ∃ y ∃ qj_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ qI ∃ y ∃ qj_v ∃ qc_v ∃ qi_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qnpi ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qY ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ctor , x +: qj_v +: qc_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , qI +: qi_v +: ∅ ⟩ ⟨ kc_ind_ctor , qI +: qi_v +: qc_v +: ∅ ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , qf_v +: qa_v +: ∅ ⟩ ∧ t4 = ⟨ kc_app , qf2 +: qa2 +: ∅ ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_lam , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , qA +: qb_v +: ∅ ⟩ ∧ t4 = ⟨ kc_pi , qA2 +: qb2 +: ∅ ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , qb_v +: qi_v +: qe_v +: ∅ ⟩ ∧ t4 = ⟨ kc_proj , qb_v +: qi_v +: qe2 +: ∅ ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v) $ by lrel_rst_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v $ by ax
l4: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ t4 = t3 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [l3]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]]]
l5: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = t3 $ by and_intro [and_elim_l [and_elim_r [l3]], l4]
l6: $ H ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = t3 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = t3 → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) ⇒ ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H , ∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) ⇒ ∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) $ by ax
l12: $ … ⇒ Cf $ by ex_elim [l11, l10]
l13: $ G , H ⇒ (∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by imp_intro [l12]
l14: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel $ by ax
l15: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l16: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ qj_v = qj_v $ by eq_refl
l17: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ kc_ind_ty = kc_ind_ty $ by eq_refl
l18: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , x +: qj_v +: ∅ ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ qna = qna $ by eq_refl
