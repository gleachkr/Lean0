def fci14_ct_q  (.y .x .q: set): class = $ {y | ∀ x (y ∊ ofsort lsig lopen ks_ctx → x ∊ trees ω → ∃ q (ra_capp y x q ∈ lrel))} $

--| @freshen G q
lemma fci14_ct_e {q: set} (G: hyps)  (ty vx: set): $ G ⇒ ty ∊ fci14_ct_q  $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vx ∊ trees ω $ > $ G ⇒ ∃ q (ra_capp ty vx q ∈ lrel) $
----
l1: $ G ⇒ ∀ x (ty ∊ ofsort lsig lopen ks_ctx → x ∊ trees ω → ∃ q (ra_capp ty x q ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx → vx ∊ trees ω → ∃ q (ra_capp ty vx q ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ vx ∊ trees ω → ∃ q (ra_capp ty vx q ∈ lrel) $ by imp_elim [l2, #2]
l4: $ G ⇒ ∃ q (ra_capp ty vx q ∈ lrel) $ by imp_elim [l3, #3]

--| @freshen G q
lemma fci14_ct_n {q: set} (G: hyps)  (ty k1 j1 vx: set): $ G ⇒ crn j1 ⊆ fci14_ct_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vx ∊ trees ω $ > $ G ⇒ ∃ q (ra_capp ty vx q ∈ lrel) $
----
l1: $ G ⇒ (ty = ⟨ kc_nil , ∅ ⟩) ∨ ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) $ by ofsort_ctx_cases [#5]
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ⇒ vx ∈ trees ω $ by welc_wcel [weaken [#6]]
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ⇒ ra_capp ⟨ kc_nil , ∅ ⟩ vx vx ∈ lrel $ by lrel_capp_nil [l2]
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ⇒ ty = ⟨ kc_nil , ∅ ⟩ $ by ax
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ⇒ vx = vx $ by eq_refl
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ⇒ ra_capp ty vx vx ∈ lrel $ by wcel_eq_l [ra_capp_eq [eq_sym [l4], l5, l5], l3]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ⇒ ∃ q (ra_capp ty vx q ∈ lrel) $ by ex_intro [l6]
l8: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) ⇒ ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) $ by ax
l9: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by ax
l10: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ ty = ⟨ kc_cons , a +: p +: ∅ ⟩ $ by and_elim_l [l9]
l11: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ a ∊ ofsort lsig lopen ks_expr $ by and_elim_l [and_elim_r [l9]]
l12: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ p ∊ ofsort lsig lopen ks_ctx $ by and_elim_r [and_elim_r [l9]]
l13: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ isset ∅ $ by ax_empty
l14: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ isset (p +: ∅) $ by scons_set [l13]
l15: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ isset (a +: p +: ∅) $ by scons_set [l14]
l16: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ crn j1 ⊆ fci14_ct_q  $ by weaken [#1]
l17: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l18: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ kc_cons ∈ ω $ by kc_cons_omega
l19: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ crn (a +: p +: ∅) ⊆ fci14_ct_q  $ by node_crn_sub [l16, l17, l10, wcel_isset [l18], l15]
l20: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ crn (p +: ∅) ⊆ fci14_ct_q  $ by crn_scons_tail [l19]
l21: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ isset p $ by isset_var
l22: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ p ∈ fci14_ct_q  $ by crn_scons_head [l21, l20]
l23: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ vx ∊ trees ω $ by weaken [#6]
l24: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx ⇒ ∃ x5 (ra_capp p vx x5 ∈ lrel) $ by fci14_ct_e [wcel_welc [l22], l12, l23]
l25: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx , ra_capp p vx x5 ∈ lrel ⇒ ra_capp p vx x5 ∈ lrel $ by ax
l26: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx , ra_capp p vx x5 ∈ lrel ⇒ sig lsig lopen $ by lsig_sig
l27: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx , ra_capp p vx x5 ∈ lrel ⇒ ofsort lsig lopen ks_expr ⊆ trees ω $ by ofsort_trees [l26]
l28: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx , ra_capp p vx x5 ∈ lrel ⇒ a ∊ ofsort lsig lopen ks_expr $ by weaken [l11]
l29: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx , ra_capp p vx x5 ∈ lrel ⇒ a ∈ trees ω $ by welc_wcel [subset_elim [l27, l28]]
l30: $ G , ∃ a ∃ p (ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx) , ty = ⟨ kc_cons , a +: p +: ∅ ⟩ ∧ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx , ra_capp p vx x5 ∈ lrel ⇒ ⟨ kr_capp , p +: vx +: x5 +: ∅ ⟩ ∈ latoms $ by lrel_latoms [l25]
