l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ , ra_pargs tH e tk1 te1 ∈ lrel , ra_pargs te1 d k v ∈ lrel , ra_add d k e ∈ lrel , ra_add tk1 k j ∈ lrel ⇒ ra_pargs tH d j v ∈ lrel $ by fci24_pt_n [l1, l2, l3, l4, l5, l6, l7, l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ , ra_pargs tH e tk1 te1 ∈ lrel , ra_pargs te1 d k v ∈ lrel , ra_add d k e ∈ lrel ⇒ ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel $ by imp_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ , ra_pargs tH e tk1 te1 ∈ lrel , ra_pargs te1 d k v ∈ lrel ⇒ ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel $ by imp_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ , ra_pargs tH e tk1 te1 ∈ lrel ⇒ ra_pargs te1 d k v ∈ lrel → ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel $ by imp_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ ⇒ ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 d k v ∈ lrel → ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel $ by imp_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ ⇒ ∀ j (ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 d k v ∈ lrel → ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel) $ by all_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ ⇒ ∀ e ∀ j (ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 d k v ∈ lrel → ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel) $ by all_intro [l14]
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ ⇒ ∀ k ∀ e ∀ j (ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 d k v ∈ lrel → ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel) $ by all_intro [l15]
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ ⇒ ∀ d ∀ k ∀ e ∀ j (ra_pargs tH e tk1 te1 ∈ lrel → ra_pargs te1 d k v ∈ lrel → ra_add d k e ∈ lrel → ra_add tk1 k j ∈ lrel → ra_pargs tH d j v ∈ lrel) $ by all_intro [l16]
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ ⇒ v ∊ fci24_pt_q tH tk1 te1 $ by cab_intro [l17]
l19: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ ⇒ v = ⟨ x8 , x9 ⟩ $ by ax
l20: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 , v = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci24_pt_q tH tk1 te1 $ by wcel_intro [l19, l18]
l21: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l22: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci24_pt_q tH tk1 te1 ⇒ ⟨ x8 , x9 ⟩ ∈ fci24_pt_q tH tk1 te1 $ by isset_elim [l21, l20]
l23: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci24_pt_q tH tk1 te1 → ⟨ x8 , x9 ⟩ ∈ fci24_pt_q tH tk1 te1 $ by imp_intro [imp_intro [imp_intro [l22]]]
l24: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci24_pt_q tH tk1 te1 → ⟨ x8 , x9 ⟩ ∈ fci24_pt_q tH tk1 te1) $ by all_intro [all_intro [l23]]
l25: $ G ⇒ isset ω $ by omega_set
l26: $ G ⇒ trees ω ⊆ fci24_pt_q tH tk1 te1 $ by trees_ind_c [l25, l24]

pargs_trans
-----------
l1: $ G ⇒ trees ω ⊆ fci24_pt_q tH tk1 te1 $ by fci24_pt_all
l2: $ G ⇒ ⟨ kr_pargs , te1 +: td +: tk2 +: te +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#2]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (te +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (tk2 +: te +: ∅) $ by scons_set [l4]
l6: $ G ⇒ isset (td +: tk2 +: te +: ∅) $ by scons_set [l5]
l7: $ G ⇒ isset (te1 +: td +: tk2 +: te +: ∅) $ by scons_set [l6]
l8: $ G ⇒ kr_pargs ∈ ω $ by kr_pargs_omega
l9: $ G ⇒ kr_pargs ∈ ω ∧ te1 +: td +: tk2 +: te +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l8], l7]
l10: $ G ⇒ crn (te1 +: td +: tk2 +: te +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l9]]
l11: $ G ⇒ crn (td +: tk2 +: te +: ∅) ⊆ trees ω $ by crn_scons_tail [l10]
l12: $ G ⇒ crn (tk2 +: te +: ∅) ⊆ trees ω $ by crn_scons_tail [l11]
l13: $ G ⇒ crn (te +: ∅) ⊆ trees ω $ by crn_scons_tail [l12]
l14: $ G ⇒ isset ω $ by omega_set
l15: $ G ⇒ te ∈ trees ω $ by crn_scons_head_trees [l14, l13]
l16: $ G ⇒ te ∊ fci24_pt_q tH tk1 te1 $ by subset_elim [l1, wcel_welc [l15]]
l17: $ G ⇒ ra_pargs tH td tk te ∈ lrel $ by fci24_pt_e [l16, #1, #2, #3, #4]

def fci24_pr_q (tH tX: set) (.v .d .k .e: set): class = $ {v | ∀ d ∀ k ∀ e (ra_pargs tH d k v ∈ lrel → ra_rehead tH tX k v e ∈ lrel → ra_pargs tX d k e ∈ lrel)} $

lemma fci24_pr_e (G: hyps) (tH tX: set) (ty vd vk ve: set): $ G ⇒ ty ∊ fci24_pr_q tH tX $ > $ G ⇒ ra_pargs tH vd vk ty ∈ lrel $ > $ G ⇒ ra_rehead tH tX vk ty ve ∈ lrel $ > $ G ⇒ ra_pargs tX vd vk ve ∈ lrel $
----
l1: $ G ⇒ ∀ d ∀ k ∀ e (ra_pargs tH d k ty ∈ lrel → ra_rehead tH tX k ty e ∈ lrel → ra_pargs tX d k e ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ k ∀ e (ra_pargs tH vd k ty ∈ lrel → ra_rehead tH tX k ty e ∈ lrel → ra_pargs tX vd k e ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ∀ e (ra_pargs tH vd vk ty ∈ lrel → ra_rehead tH tX vk ty e ∈ lrel → ra_pargs tX vd vk e ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ra_pargs tH vd vk ty ∈ lrel → ra_rehead tH tX vk ty ve ∈ lrel → ra_pargs tX vd vk ve ∈ lrel $ by all_elim [l3]
l5: $ G ⇒ ra_rehead tH tX vk ty ve ∈ lrel → ra_pargs tX vd vk ve ∈ lrel $ by imp_elim [l4, #2]
l6: $ G ⇒ ra_pargs tX vd vk ve ∈ lrel $ by imp_elim [l5, #3]

lemma fci24_pr_n (G: hyps) (tH tX: set) (ty k1 j1 vd vk ve: set): $ G ⇒ crn j1 ⊆ fci24_pr_q tH tX $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pargs tH vd vk ty ∈ lrel $ > $ G ⇒ ra_rehead tH tX vk ty ve ∈ lrel $ > $ G ⇒ ra_pargs tX vd vk ve ∈ lrel $
----
l1: $ G ⇒ ra_pargs tH vd vk ty ∈ lrel $ by weaken [#5]
l2: $ G ⇒ ra_rehead tH tX vk ty ve ∈ lrel $ by weaken [#6]
l3: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ⇒ vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH $ by ax
l4: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ⇒ vk = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l3]
