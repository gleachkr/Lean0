l116: $ G , vk = ⟨ kc_s , n +: ∅ ⟩ ∧ ty = ⟨ kc_app , f +: ⟨ kc_bvar , vd +: ∅ ⟩ +: ∅ ⟩ ∧ ra_pargs tX ⟨ kc_s , vd +: ∅ ⟩ n f ∈ lrel , x5 = ⟨ kc_s , vd +: ∅ ⟩ , x6 = ⟨ kc_bvar , vd +: ∅ ⟩ , ra_spine x1 ty x2 ∈ lrel , ty = ⟨ kc_app , yy1 +: yy2 +: ∅ ⟩ ∧ x2 = ⟨ kc_s , yy3 +: ∅ ⟩ ∧ ra_spine x1 yy1 yy3 ∈ lrel ⇒ ∀ x1 ∀ x2 (ra_spine x1 f x2 ∈ lrel → ¬ ∃ x3 (x1 = ⟨ kc_ind_ty , tD +: x3 +: ∅ ⟩) ∧ ¬ ∃ x3 ∃ x4 (x1 = ⟨ kc_ind_ctor , tD +: x3 +: x4 +: ∅ ⟩)) $ by weaken [l76]
