l161: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel , xx5 = ⟨ kc_nz , ∅ ⟩ , t = ⟨ kc_tcons , xx6 +: xx0 +: xx3 +: ∅ ⟩ ∧ ra_lift xx5 ⟨ kc_nz , ∅ ⟩ xx6 xx7 ∈ lrel ∧ ra_mty td x1 xx5 ⟨ kc_nz , ∅ ⟩ tv xx7 xx8 ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_s , xx5 +: ∅ ⟩ xx3 yy1 ∈ lrel ∧ ra_capp yy1 ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ c ∈ lrel , yy2 = ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ , yy1 = ⟨ kc_nil , ∅ ⟩ ∧ c = yy2 , c = ⟨ kc_nil , ∅ ⟩ ∧ x7 = x6 ⇒ kc_nil ∈ ω $ by kc_nil_omega
l162: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel , xx5 = ⟨ kc_nz , ∅ ⟩ , t = ⟨ kc_tcons , xx6 +: xx0 +: xx3 +: ∅ ⟩ ∧ ra_lift xx5 ⟨ kc_nz , ∅ ⟩ xx6 xx7 ∈ lrel ∧ ra_mty td x1 xx5 ⟨ kc_nz , ∅ ⟩ tv xx7 xx8 ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_s , xx5 +: ∅ ⟩ xx3 yy1 ∈ lrel ∧ ra_capp yy1 ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ c ∈ lrel , yy2 = ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ , yy1 = ⟨ kc_nil , ∅ ⟩ ∧ c = yy2 , c = ⟨ kc_nil , ∅ ⟩ ∧ x7 = x6 ⇒ kc_cons ∈ ω $ by kc_cons_omega
l163: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel , xx5 = ⟨ kc_nz , ∅ ⟩ , t = ⟨ kc_tcons , xx6 +: xx0 +: xx3 +: ∅ ⟩ ∧ ra_lift xx5 ⟨ kc_nz , ∅ ⟩ xx6 xx7 ∈ lrel ∧ ra_mty td x1 xx5 ⟨ kc_nz , ∅ ⟩ tv xx7 xx8 ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_s , xx5 +: ∅ ⟩ xx3 yy1 ∈ lrel ∧ ra_capp yy1 ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ c ∈ lrel , yy2 = ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ , yy1 = ⟨ kc_nil , ∅ ⟩ ∧ c = yy2 , c = ⟨ kc_nil , ∅ ⟩ ∧ x7 = x6 ⇒ kc_nil = kc_cons $ by opair_inj_l_c [l160, wcel_isset [l161], wcel_isset [l162]]
l164: $ G , ra_ind_data td b p t ∈ lrel ∧ ra_clen p x1 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_nz , ∅ ⟩ t c ∈ lrel ∧ ra_minors td x1 n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t d ∈ lrel ∧ ra_nth_ty t ti e o ∈ lrel ∧ ra_nth_ctor o tc x3 ∈ lrel ∧ ra_minor_idx t ti tc k ∈ lrel ∧ ra_npis x3 f ∈ lrel ∧ ra_add f m a ∈ lrel ∧ ra_add x2 ⟨ kc_s , k +: ∅ ⟩ a ∈ lrel ∧ ra_pargs ⟨ kc_bvar , x2 +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ f x4 ∈ lrel ∧ ra_rwalk td x1 n m tv f ⟨ kc_nz , ∅ ⟩ x4 x3 x5 ∈ lrel ∧ ra_lams d x5 x6 ∈ lrel ∧ ra_lams c x6 x7 ∈ lrel ∧ ra_lams p x7 tR ∈ lrel , t = ⟨ kc_tcons , xx2 +: xx4 +: xx1 +: ∅ ⟩ ∧ ti = ⟨ kc_s , x0 +: ∅ ⟩ ∧ ra_nth_ty xx1 x0 e o ∈ lrel , xx5 = ⟨ kc_nz , ∅ ⟩ , t = ⟨ kc_tcons , xx6 +: xx0 +: xx3 +: ∅ ⟩ ∧ ra_lift xx5 ⟨ kc_nz , ∅ ⟩ xx6 xx7 ∈ lrel ∧ ra_mty td x1 xx5 ⟨ kc_nz , ∅ ⟩ tv xx7 xx8 ∈ lrel ∧ ra_motives td x1 tv ⟨ kc_s , xx5 +: ∅ ⟩ xx3 yy1 ∈ lrel ∧ ra_capp yy1 ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ c ∈ lrel , yy2 = ⟨ kc_cons , xx8 +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ , yy1 = ⟨ kc_nil , ∅ ⟩ ∧ c = yy2 , c = ⟨ kc_nil , ∅ ⟩ ∧ x7 = x6 ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
