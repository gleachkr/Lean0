l6: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ⇒ ra_rehead tH tX vk ty ve ∈ lrel $ by weaken [l2]
l7: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX $ by ax
l8: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ vk = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l7]
l9: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ ve = tX $ by and_elim_r [and_elim_r [l7]]
l10: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ⇒ ra_rehead tH tX vk ty ve ∈ lrel $ by weaken [l2]
l11: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ ra_rehead tH tX vk ty ve ∈ lrel $ by weaken [l10]
l12: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ ⟨ kr_rehead , tH +: tX +: vk +: ty +: ve +: ∅ ⟩ ∈ latoms $ by lrel_latoms [l11]
l13: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset ∅ $ by ax_empty
l14: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (ve +: ∅) $ by scons_set [l13]
l15: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (ty +: ve +: ∅) $ by scons_set [l14]
l16: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (vk +: ty +: ve +: ∅) $ by scons_set [l15]
l17: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (tX +: vk +: ty +: ve +: ∅) $ by scons_set [l16]
l18: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (tH +: tX +: vk +: ty +: ve +: ∅) $ by scons_set [l17]
l19: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ kr_rehead ∈ ω $ by kr_rehead_omega
l20: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ kr_rehead ∈ ω ∧ tH +: tX +: vk +: ty +: ve +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l12, wcel_isset [l19], l18]
l21: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ crn (tH +: tX +: vk +: ty +: ve +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l20]]
l22: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ crn (tX +: vk +: ty +: ve +: ∅) ⊆ trees ω $ by crn_scons_tail [l21]
l23: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset ω $ by omega_set
l24: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ tX ∈ trees ω $ by crn_scons_head_trees [l23, l22]
l25: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ⇒ ra_pargs tH vd vk ty ∈ lrel $ by weaken [l1]
l26: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ ra_pargs tH vd vk ty ∈ lrel $ by weaken [l25]
l27: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ ⟨ kr_pargs , tH +: vd +: vk +: ty +: ∅ ⟩ ∈ latoms $ by lrel_latoms [l26]
l28: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset ∅ $ by ax_empty
l29: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (ty +: ∅) $ by scons_set [l28]
l30: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (vk +: ty +: ∅) $ by scons_set [l29]
l31: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (vd +: vk +: ty +: ∅) $ by scons_set [l30]
l32: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset (tH +: vd +: vk +: ty +: ∅) $ by scons_set [l31]
l33: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ kr_pargs ∈ ω $ by kr_pargs_omega
l34: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ kr_pargs ∈ ω ∧ tH +: vd +: vk +: ty +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l27, wcel_isset [l33], l32]
l35: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ crn (tH +: vd +: vk +: ty +: ∅) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l34]]
l36: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ crn (vd +: vk +: ty +: ∅) ⊆ trees ω $ by crn_scons_tail [l35]
l37: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ isset ω $ by omega_set
l38: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ vd ∈ trees ω $ by crn_scons_head_trees [l37, l36]
l39: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ ra_pargs tX vd ⟨ kc_nz , ∅ ⟩ tX ∈ lrel $ by lrel_pargs_z [l24, l38]
l40: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ vk = ⟨ kc_nz , ∅ ⟩ $ by weaken [l4]
l41: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ tX = tX $ by eq_refl
l42: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ vd = vd $ by eq_refl
l43: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH ∧ ve = tX ⇒ ra_pargs tX vd vk ve ∈ lrel $ by wcel_eq_l [ra_pargs_eq [l41, l42, eq_sym [l40], eq_sym [l9]], l39]
l44: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel ⇒ vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel $ by ax
l45: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel ⇒ vk = ⟨ kc_s , x1 +: ∅ ⟩ $ by and_elim_l [l44]
l46: $ G , vk = ⟨ kc_nz , ∅ ⟩ ∧ ty = tH , vk = ⟨ kc_s , x1 +: ∅ ⟩ ∧ ty = ⟨ kc_app , x2 +: x3 +: ∅ ⟩ ∧ ve = ⟨ kc_app , x4 +: x3 +: ∅ ⟩ ∧ ra_rehead tH tX x1 x2 x4 ∈ lrel ⇒ vk = ⟨ kc_nz , ∅ ⟩ $ by weaken [l4]
