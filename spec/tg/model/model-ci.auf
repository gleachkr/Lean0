l17: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel $ by ax
l18: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l19: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ qF = qF $ by eq_refl
l20: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ qF2 = qF2 $ by eq_refl
l21: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ ra_lift t4 ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel $ by wcel_eq_l [ra_lift_eq [eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l17]]]]], l18, l19, l20], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l17]]]]]]]]
l22: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ qMj = qMj $ by eq_refl
l23: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ ra_mty t1 t2 t4 ⟨ kc_nz , ∅ ⟩ t3 qF2 qMj ∈ lrel $ by wcel_eq_l [ra_mty_eq [eq_sym [and_elim_l [l17]], eq_sym [and_elim_l [and_elim_r [l17]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l17]]]]], l18, eq_sym [and_elim_l [and_elim_r [and_elim_r [l17]]]], l20, l22], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l17]]]]]]]]]
l24: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l25: $ G , H , t1 = x ∧ t2 = y ∧ t3 = u ∧ t4 = z ∧ t5 = ⟨ kc_tcons , qF +: qC +: qT +: ∅ ⟩ ∧ t6 = v ∧ ra_lift z ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_mty x y z ⟨ kc_nz , ∅ ⟩ u qF2 qMj ∈ lrel ∧ ra_motives x y u ⟨ kc_s , z +: ∅ ⟩ qT qMr ∈ lrel ∧ ra_capp qMr ⟨ kc_cons , qMj +: ⟨ kc_nil , ∅ ⟩ +: ∅ ⟩ v ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
