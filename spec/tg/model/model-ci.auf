l339: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ dt u (mcv H) ⟨ kc_bvar , tk +: ∅ ⟩ w r = r' nvf' tk $ by dt_bvar [l336, l337, l338]
l340: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ dt u (mcv H) z1 w r = r' nvf' tk $ by eq_trans [l321, eq_trans [l324, l237]]
l341: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ dt u (mcv H) z1 w r = dt u (mcv H) ⟨ kc_bvar , tk +: ∅ ⟩ w r $ by eq_trans [l340, eq_sym [l339]]
l342: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ ra_lookup tg1 tk tT ∈ lrel $ by weaken [#9]
l343: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ w ∊ lvals $ by weaken [l33]
l344: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ r ∊ sat u (mcv H) tg1 w $ by weaken [l34]
l345: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ r' nvf' tk ∈ dt u (mcv H) tT w r $ by lrel_lookup_sem [l342, l343, l344]
l346: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ dt u (mcv H) z1 w r ∈ dt u (mcv H) tT w r $ by wcel_eq_l [eq_sym [l340], l345]
l347: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 , ra_spine xx4 j v ∈ lrel ⇒ dt u (mcv H) z1 w r = dt u (mcv H) ⟨ kc_bvar , tk +: ∅ ⟩ w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) tT w r $ by and_intro [l341, l346]
l348: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8 ⇒ dt u (mcv H) z1 w r = dt u (mcv H) ⟨ kc_bvar , tk +: ∅ ⟩ w r ∧ dt u (mcv H) z1 w r ∈ dt u (mcv H) tT w r $ by ex_elim [l208, l347]
l349: $ G , tl = ⟨ kc_proj , b +: tfi +: j +: ∅ ⟩ ∧ ra_ind_data td b x1 t ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_nth_ty t ti x4 e ∈ lrel ∧ ra_nth_ctor e ⟨ kc_nz , ∅ ⟩ k ∈ lrel ∧ ra_npis k f ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ n x2 k x5 ∈ lrel ∧ ra_psplit f x5 ⟨ kc_nil , ∅ ⟩ x3 x6 ∈ lrel ∧ ra_capp x3 x1 tg ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ f x2 c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ f j ∈ lrel ∧ ra_add tk ⟨ kc_s , tfi +: ∅ ⟩ f ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , x7 = ∅ , xx4 = ⟨ kc_ind_ctor , td +: ti +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ , ra_add n x2 a ∈ lrel ∧ ra_closed a k ∈ lrel , ra_spine ⟨ kc_ind_ty , td +: ti +: ∅ ⟩ x6 y ∈ lrel , ∃ x9 (x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8) ⇒ ∃ x9 (x8 ∊ esat u (dnf u (mcv H)) x1 w ∧ x9 ∊ esat u (dsh u (mcv H) x8) x3 w ∧ r = x9 ++ x8) $ by ax
