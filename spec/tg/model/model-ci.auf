def fci22_rs_q (tX tY: set) (.v .k .e: set): class = $ {v | ∀ k ∀ e (ra_rehead tY tX k v e ∈ lrel → e ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → v ∊ ofsort lsig lopen ks_expr)} $

lemma fci22_rs_e (G: hyps) (tX tY: set) (ty vk ve: set): $ G ⇒ ty ∊ fci22_rs_q tX tY $ > $ G ⇒ ra_rehead tY tX vk ty ve ∈ lrel $ > $ G ⇒ ve ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tY ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ∀ k ∀ e (ra_rehead tY tX k ty e ∈ lrel → e ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_expr) $ by cab_elim [#1]
l2: $ G ⇒ ∀ e (ra_rehead tY tX vk ty e ∈ lrel → e ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_expr) $ by all_elim [l1]
l3: $ G ⇒ ra_rehead tY tX vk ty ve ∈ lrel → ve ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_expr $ by all_elim [l2]
l4: $ G ⇒ ve ∊ ofsort lsig lopen ks_expr → tY ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_expr $ by imp_elim [l3, #2]
l5: $ G ⇒ tY ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_expr $ by imp_elim [l4, #3]
l6: $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ by imp_elim [l5, #4]

lemma fci22_rs_n (G: hyps) (tX tY: set) (ty k1 j1 vk ve: set): $ G ⇒ crn j1 ⊆ fci22_rs_q tX tY $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_rehead tY tX vk ty ve ∈ lrel $ > $ G ⇒ ve ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tY ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ra_rehead tY tX vk ty ve ∈ lrel $ by weaken [#5]
l2: $ G ⇒ ve ∊ ofsort lsig lopen ks_expr $ by weaken [#6]
