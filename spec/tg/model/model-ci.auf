ci_ctor
-------
l1: $ G ⇒ esat u (dnf u M) tp w ⊆ fseq u $ by esat_fseq
l2: $ G ⇒ p ∊ fseq u $ by subset_elim [l1, #4]
l3: $ G ⇒ esat u (dsh u M (m ++ p)) tXl w ⊆ fseq u $ by esat_fseq
l4: $ G ⇒ f ∊ fseq u $ by subset_elim [l3, #5]
l5: $ G ⇒ m ++ p ∈ fseq u $ by scat_fseq [#3, l2]
l6: $ G ⇒ f ++ m ∈ fseq u $ by scat_fseq [l4, #3]
l7: $ G ⇒ f ++ p ∈ fseq u $ by scat_fseq [l4, l2]
l8: $ G ⇒ f ++ m ++ p ∈ fseq u $ by scat_fseq_c [welc_wcel [l4], l5]
l9: $ G ⇒ r ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [#6], l8]]
