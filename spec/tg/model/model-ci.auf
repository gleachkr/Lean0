lemma fci_inv_proj_eq {qb_v qP qX qT qnp qn_v qm_v qnf qF qK qK2 qres qc1 qmaj qC: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6: set): $ G ⇒ ra_proj_eq t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ H , t5 = ⟨ kc_proj , qb_v +: t3 +: qmaj +: ∅ ⟩ ∧ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT t2 qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP t4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , t1 +: t2 +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add t6 ⟨ kc_s , t3 +: ∅ ⟩ qnf ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_proj_eq t1 t2 t3 t4 t5 t6 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qX ∃ y ∃ qT ∃ z ∃ u ∃ qnp ∃ qn_v ∃ qm_v ∃ qnf ∃ v ∃ qF ∃ qK ∃ qK2 ∃ qres ∃ qc1 ∃ qmaj ∃ qC (t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel) $ by lrel_proj_eq_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel ⇒ t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel ⇒ qmaj = qmaj $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel ⇒ qb_v = qb_v $ by eq_refl
l7: $ G , H , t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel ⇒ kc_proj = kc_proj $ by eq_refl
l8: $ G , H , t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel ⇒ t5 = ⟨ kc_proj , qb_v +: t3 +: qmaj +: ∅ ⟩ $ by eq_trans [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]], opair_eq [l7, scons_eq [l6, scons_eq [eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]], scons_eq [l5, l4]]]]]
l9: $ G , H , t1 = x ∧ t2 = z ∧ t3 = u ∧ t4 = y ∧ t5 = ⟨ kc_proj , qb_v +: u +: qmaj +: ∅ ⟩ ∧ t6 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_psplit qnf qK2 ⟨ kc_nil , ∅ ⟩ qX qres ∈ lrel ∧ ra_capp qX qP y ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , x +: z +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ qnf qnp qc1 ∈ lrel ∧ ra_pargs qc1 ⟨ kc_nz , ∅ ⟩ qnf qmaj ∈ lrel ∧ ra_add v ⟨ kc_s , u +: ∅ ⟩ qnf ∈ lrel ⇒ qP = qP $ by eq_refl
