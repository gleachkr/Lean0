lemma fci_quot_sound_ty (G: ctx) (l: lvl): $ ty G (quot_sound l) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) Prop)) (pi (bvar n1) (pi (bvar n2) (pi (app (app (bvar n2) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D l) nz) (app (app (quot l) (bvar n4)) (bvar n3))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n2))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n1)))))))) $
