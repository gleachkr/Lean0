lemma fci_inv_iota_eq {qnp qn_v qm_v qa0 qar qnf qX qres qe3 qe4 qc1 qmaj qRh qrhs0: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7 t8: set): $ G ⇒ ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel $ > $ H , t6 = ⟨ kc_app , qe4 +: qmaj +: ∅ ⟩ ∧ ra_iota_tel t1 t4 t2 t3 qX qres qnf t5 ∈ lrel ∧ ra_iota_lhs t1 t4 t2 t3 qnf qres qe3 qc1 qmaj qe4 t8 ∈ lrel ∧ ra_rec_rhs t1 t4 t2 t3 qRh ∈ lrel ∧ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_add qnp qn_v qa0 ∈ lrel ∧ ra_add qa0 qm_v qar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , t1 +: t2 +: t4 +: ∅ ⟩ qRh qar qe3 qrhs0 ∈ lrel ∧ ra_rehead qc1 qrhs0 qnf qmaj t7 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ qnp ∃ qn_v ∃ qm_v ∃ qa0 ∃ qar ∃ qnf ∃ qX ∃ v ∃ qres ∃ qe3 ∃ qe4 ∃ qc1 ∃ qmaj ∃ qRh ∃ qrhs0 ∃ w ∃ a (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_app , qe4 +: qmaj +: ∅ ⟩ ∧ t7 = w ∧ t8 = a ∧ ra_iota_tel x u y z qX qres qnf v ∈ lrel ∧ ra_iota_lhs x u y z qnf qres qe3 qc1 qmaj qe4 a ∈ lrel ∧ ra_rec_rhs x u y z qRh ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_add qnp qn_v qa0 ∈ lrel ∧ ra_add qa0 qm_v qar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , x +: y +: u +: ∅ ⟩ qRh qar qe3 qrhs0 ∈ lrel ∧ ra_rehead qc1 qrhs0 qnf qmaj w ∈ lrel) $ by lrel_iota_eq_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_app , qe4 +: qmaj +: ∅ ⟩ ∧ t7 = w ∧ t8 = a ∧ ra_iota_tel x u y z qX qres qnf v ∈ lrel ∧ ra_iota_lhs x u y z qnf qres qe3 qc1 qmaj qe4 a ∈ lrel ∧ ra_rec_rhs x u y z qRh ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_add qnp qn_v qa0 ∈ lrel ∧ ra_add qa0 qm_v qar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , x +: y +: u +: ∅ ⟩ qRh qar qe3 qrhs0 ∈ lrel ∧ ra_rehead qc1 qrhs0 qnf qmaj w ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_app , qe4 +: qmaj +: ∅ ⟩ ∧ t7 = w ∧ t8 = a ∧ ra_iota_tel x u y z qX qres qnf v ∈ lrel ∧ ra_iota_lhs x u y z qnf qres qe3 qc1 qmaj qe4 a ∈ lrel ∧ ra_rec_rhs x u y z qRh ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_add qnp qn_v qa0 ∈ lrel ∧ ra_add qa0 qm_v qar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , x +: y +: u +: ∅ ⟩ qRh qar qe3 qrhs0 ∈ lrel ∧ ra_rehead qc1 qrhs0 qnf qmaj w ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_app , qe4 +: qmaj +: ∅ ⟩ ∧ t7 = w ∧ t8 = a ∧ ra_iota_tel x u y z qX qres qnf v ∈ lrel ∧ ra_iota_lhs x u y z qnf qres qe3 qc1 qmaj qe4 a ∈ lrel ∧ ra_rec_rhs x u y z qRh ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_add qnp qn_v qa0 ∈ lrel ∧ ra_add qa0 qm_v qar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , x +: y +: u +: ∅ ⟩ qRh qar qe3 qrhs0 ∈ lrel ∧ ra_rehead qc1 qrhs0 qnf qmaj w ∈ lrel ⇒ qX = qX $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_app , qe4 +: qmaj +: ∅ ⟩ ∧ t7 = w ∧ t8 = a ∧ ra_iota_tel x u y z qX qres qnf v ∈ lrel ∧ ra_iota_lhs x u y z qnf qres qe3 qc1 qmaj qe4 a ∈ lrel ∧ ra_rec_rhs x u y z qRh ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_add qnp qn_v qa0 ∈ lrel ∧ ra_add qa0 qm_v qar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , x +: y +: u +: ∅ ⟩ qRh qar qe3 qrhs0 ∈ lrel ∧ ra_rehead qc1 qrhs0 qnf qmaj w ∈ lrel ⇒ qres = qres $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_app , qe4 +: qmaj +: ∅ ⟩ ∧ t7 = w ∧ t8 = a ∧ ra_iota_tel x u y z qX qres qnf v ∈ lrel ∧ ra_iota_lhs x u y z qnf qres qe3 qc1 qmaj qe4 a ∈ lrel ∧ ra_rec_rhs x u y z qRh ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_add qnp qn_v qa0 ∈ lrel ∧ ra_add qa0 qm_v qar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , x +: y +: u +: ∅ ⟩ qRh qar qe3 qrhs0 ∈ lrel ∧ ra_rehead qc1 qrhs0 qnf qmaj w ∈ lrel ⇒ qnf = qnf $ by eq_refl
