l147: $ G , ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ , e ∊ Envx , e ∊ Envc ∨ (e ∊ Envq ∨ (e ∊ Envqm ∨ (e ∊ Envql))) , e ∊ Envq ∨ (e ∊ Envqm ∨ (e ∊ Envql)) , e ∊ Envqm ∨ (e ∊ Envql) ⇒ o = chv (s' ∅) $ by or_elim [l84, l115, l146]
l148: $ G , ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ , e ∊ Envx , e ∊ Envc ∨ (e ∊ Envq ∨ (e ∊ Envqm ∨ (e ∊ Envql))) , e ∊ Envq ∨ (e ∊ Envqm ∨ (e ∊ Envql)) ⇒ o = chv (s' ∅) $ by or_elim [l52, l83, l147]
l149: $ G , ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ , e ∊ Envx , e ∊ Envc ∨ (e ∊ Envq ∨ (e ∊ Envqm ∨ (e ∊ Envql))) ⇒ o = chv (s' ∅) $ by or_elim [l12, l51, l148]
l150: $ G , ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ , e ∊ Envx ⇒ o = chv (s' ∅) $ by or_elim [l3, l11, l149]
l151: $ G , ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx ⇒ ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx $ by ax
l152: $ G , ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx ⇒ o = chv (s' ∅) $ by wcel_elim [l151, l150]
l153: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ $ by ax
l154: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ = ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ $ by eq_refl
l155: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ o = chv (s' ∅) $ by ax
l156: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , chv (s' ∅) ⟩ $ by eq_trans [l153, opair_eq [l154, l155]]
l157: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ ∃ y (e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , y ⟩ ⟩ , chv (y' ∅) ⟩) $ by ex_intro [l156]
l158: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ ∃ x ∃ y (e = ⟨ ⟨ x , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , y ⟩ ⟩ , chv (y' ∅) ⟩) $ by ex_intro [l157]
l159: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ e ∊ Envc $ by cab_intro [l158]
l160: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ e ∊ Envx $ by cab_intro [or_intro_r [or_intro_l [l159]]]
l161: $ G , o = chv (s' ∅) , e = ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ⇒ ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx $ by wcel_intro [l153, l160]
l162: $ G , o = chv (s' ∅) ⇒ isset ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ $ by opair_isset
l163: $ G , o = chv (s' ∅) ⇒ ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx $ by isset_elim [l162, l161]
l164: $ G ⇒ ⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx ↔ o = chv (s' ∅) $ by bi_intro [l152, l163]
l165: $ G ⇒ ∀ o (⟨ ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ , o ⟩ ∈ Envx ↔ o = chv (s' ∅)) $ by all_intro [l164]
l166: $ G , n = s' ∅ ⇒ n = s' ∅ $ by ax
l167: $ G , n = s' ∅ ⇒ chv n ∈ (Πₛ x1 ∈ uni' n, (Πₛ x2 ∈ tne x1, x1)) $ by chv_cpi
l168: $ G , n = s' ∅ ⇒ isset (chv (s' ∅)) $ by isset_eq [chv_eq [l166], wcel_isset [l167]]
l169: $ G ⇒ isset s $ by isset_var
l170: $ G ⇒ isset (s' ∅) $ by fv_set_l [l169]
l171: $ G ⇒ isset (chv (s' ∅)) $ by isset_elim [l170, l168]
l172: $ G ⇒ Envx' ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ = chv (s' ∅) $ by fv_iff [l165, l171]

lemma f213_at (G: hyps) (K: class) (a b: set): $ G ⇒ ⟨ K , a +: b +: ∅ ⟩ ∈ lrel2 $ > $ G ⇒ K ∈ ω $ > $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $
----
l1: $ G ⇒ hprog lprog2 latoms $ by lprog2_hprog
l2: $ … ⇒ lrel2 ⊆ latoms $ by horn_sub [l1]
l3: $ … ⇒ ⟨ K , a +: b +: ∅ ⟩ ∈ latoms $ by wcel_subset [l2, #1]
l4: $ G ⇒ isset ω $ by omega_set
l5: $ … ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [l4]
l6: $ … ⇒ ⟨ K , a +: b +: ∅ ⟩ ∈ trees ω $ by wcel_eq_r [l5, l3]
l7: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by trees_kids2 [l4, l6, wcel_isset [#2]]

def f213_ls_q (w: set) (.y .t: set): class = $ {y | ∀ t (ra_lseqv y t ∈ lrel2 → w ∊ lvals → lsv y w = lsv t w)} $

lemma f213_ls_e (G: hyps) (w: set) (ty vt: set): $ G ⇒ ty ∊ f213_ls_q w $ > $ G ⇒ ra_lseqv ty vt ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lsv ty w = lsv vt w $
----
l1: $ G ⇒ ∀ t (ra_lseqv ty t ∈ lrel2 → w ∊ lvals → lsv ty w = lsv t w) $ by cab_elim [#1]
l2: $ … ⇒ ra_lseqv ty vt ∈ lrel2 → w ∊ lvals → lsv ty w = lsv vt w $ by all_elim [l1]
l3: $ … ⇒ w ∊ lvals → lsv ty w = lsv vt w $ by imp_elim [l2, #2]
l4: $ G ⇒ lsv ty w = lsv vt w $ by imp_elim [l3, #3]

lemma f213_ls_n (G: hyps) (w: set) (ty k1 j1 vt: set): $ G ⇒ crn j1 ⊆ f213_ls_q w $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_lseqv ty vt ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lsv ty w = lsv vt w $
----
l1: $ G ⇒ ra_lseqv ty vt ∈ lrel2 $ by weaken [#5]
l2: $ … ⇒ (ty = ⟨ kc_lnil , ∅ ⟩ ∧ vt = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by lrel2_lseqv_cases [l1]
l3: $ G , ty = ⟨ kc_lnil , ∅ ⟩ ∧ vt = ⟨ kc_lnil , ∅ ⟩ ⇒ ty = ⟨ kc_lnil , ∅ ⟩ ∧ vt = ⟨ kc_lnil , ∅ ⟩ $ by ax
l4: $ … ⇒ ty = ⟨ kc_lnil , ∅ ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ vt = ⟨ kc_lnil , ∅ ⟩ $ by and_elim_r [l3]
l6: $ G , ty = ⟨ kc_lnil , ∅ ⟩ ∧ vt = ⟨ kc_lnil , ∅ ⟩ ⇒ w = w $ by eq_refl
l7: $ … ⇒ lsv ty w = lsv vt w $ by lsv_eq [eq_trans [l4, eq_sym [l5]], l6]
l8: $ G ⇒ (ty = ⟨ kc_lnil , ∅ ⟩ ∧ vt = ⟨ kc_lnil , ∅ ⟩) → lsv ty w = lsv vt w $ by imp_intro [l7]
l9: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 $ by ax
l10: $ … ⇒ ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ $ by and_elim_l [l9]
l11: $ … ⇒ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ $ by and_elim_l [and_elim_r [l9]]
l12: $ … ⇒ lveq x1 x2 $ by and_elim_l [and_elim_r [and_elim_r [l9]]]
l13: $ … ⇒ ra_lseqv x3 x4 ∈ lrel2 $ by and_elim_r [and_elim_r [and_elim_r [l9]]]
l14: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ w ∊ lvals $ by weaken [#6]
l15: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ ra_lseqv ty vt ∈ lrel2 $ by weaken [l1]
l16: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ kr_lseqv ∈ ω $ by kr_lseqv_omega
l17: $ … ⇒ ty ∊ trees ω ∧ vt ∊ trees ω $ by f213_at [l15, l16]
l18: $ … ⇒ ty ∈ trees ω $ by welc_wcel [and_elim_l [l17]]
l19: $ … ⇒ vt ∈ trees ω $ by welc_wcel [and_elim_r [l17]]
l20: $ … ⇒ ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∈ trees ω $ by wcel_eq_l [l10, l18]
l21: $ … ⇒ ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∈ trees ω $ by wcel_eq_l [l11, l19]
l22: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ kc_lcons ∈ ω $ by kc_lcons_omega
l23: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ isset ω $ by omega_set
l24: $ … ⇒ x1 ∊ trees ω ∧ x3 ∊ trees ω $ by trees_kids2 [l23, l20, wcel_isset [l22]]
l25: $ … ⇒ x1 ∈ trees ω $ by welc_wcel [and_elim_l [l24]]
l26: $ … ⇒ x3 ∈ trees ω $ by welc_wcel [and_elim_r [l24]]
l27: $ … ⇒ x2 ∊ trees ω ∧ x4 ∊ trees ω $ by trees_kids2 [l23, l21, wcel_isset [l22]]
l28: $ … ⇒ x2 ∈ trees ω $ by welc_wcel [and_elim_l [l27]]
l29: $ … ⇒ x4 ∈ trees ω $ by welc_wcel [and_elim_r [l27]]
l30: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ isset ∅ $ by ax_empty
l31: $ … ⇒ isset (x3 +: ∅) $ by scons_set [l30]
l32: $ … ⇒ isset (x1 +: x3 +: ∅) $ by scons_set [l31]
l33: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ crn j1 ⊆ f213_ls_q w $ by weaken [#1]
l34: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l35: $ … ⇒ crn (x1 +: x3 +: ∅) ⊆ f213_ls_q w $ by node_crn_sub [l33, l34, l10, wcel_isset [l22], l32]
l36: $ … ⇒ crn (x3 +: ∅) ⊆ f213_ls_q w $ by crn_scons_tail [l35]
l37: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ isset x3 $ by isset_var
l38: $ … ⇒ x3 ∈ f213_ls_q w $ by crn_scons_head [l37, l36]
l39: $ … ⇒ lsv x3 w = lsv x4 w $ by f213_ls_e [wcel_welc [l38], l13, l14]
l40: $ … ⇒ w ∊ lvals → lv x1 w = lv x2 w $ by all_elim [l12]
l41: $ … ⇒ lv x1 w = lv x2 w $ by imp_elim [l40, l14]
l42: $ … ⇒ lsv ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ w = lv x1 w +: lsv x3 w $ by lsv_lcons [l25, l26, l14]
l43: $ … ⇒ lsv ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ w = lv x2 w +: lsv x4 w $ by lsv_lcons [l28, l29, l14]
l44: $ G , ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ w = w $ by eq_refl
l45: $ … ⇒ lsv ty w = lsv ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ w $ by lsv_eq [l10, l44]
l46: $ … ⇒ lsv vt w = lsv ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ w $ by lsv_eq [l11, l44]
l47: $ … ⇒ lv x1 w +: lsv x3 w = lv x2 w +: lsv x4 w $ by scons_eq [l41, l39]
l48: $ … ⇒ lsv ty w = lsv vt w $ by eq_trans [l45, eq_trans [l42, eq_trans [l47, eq_trans [eq_sym [l43], eq_sym [l46]]]]]
l49: $ G , ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) ⇒ ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by ax
l50: $ … ⇒ lsv ty w = lsv vt w $ by ex_elim [l49, l48]
l51: $ G , ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) ⇒ ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by ax
l52: $ … ⇒ lsv ty w = lsv vt w $ by ex_elim [l51, l50]
l53: $ G , ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) ⇒ ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by ax
l54: $ … ⇒ lsv ty w = lsv vt w $ by ex_elim [l53, l52]
l55: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by ax
l56: $ … ⇒ lsv ty w = lsv vt w $ by ex_elim [l55, l54]
l57: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2)) → lsv ty w = lsv vt w $ by imp_intro [l56]
l58: $ … ⇒ ((ty = ⟨ kc_lnil , ∅ ⟩ ∧ vt = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , x1 +: x3 +: ∅ ⟩ ∧ vt = ⟨ kc_lcons , x2 +: x4 +: ∅ ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2)) → lsv ty w = lsv vt w $ by or_elim_imp [l8, l57]
l59: $ G ⇒ lsv ty w = lsv vt w $ by imp_elim [l58, l2]

lemma f213_ls_all (G: hyps) (w: set): $ G ⇒ trees ω ⊆ f213_ls_q w $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ , ra_lseqv y t ∈ lrel2 , w ∊ lvals ⇒ crn x9 ⊆ f213_ls_q w $ by ax
