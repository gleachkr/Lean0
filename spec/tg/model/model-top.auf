lemma f214_e_hcst {u a l e w: set} (G: hyps) (o t: set): $ G ⇒ ⟨ o , t ⟩ ∈ hcst $ > $ G ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $
----
l1: $ G , x = ⟨ o , t ⟩ , x ∊ hcst , x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ $ by ax
l2: $ G , x = ⟨ o , t ⟩ , x ∊ hcst , x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ x = ⟨ o , t ⟩ $ by ax
l3: $ … ⇒ ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ $ by eq_trans [eq_sym [l2], l1]
l4: $ … ⇒ ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_intro [l3]
l5: $ … ⇒ ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_intro [l4]
l6: $ … ⇒ ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_intro [l5]
l7: $ … ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_intro [l6]
l8: $ G , x = ⟨ o , t ⟩ , x ∊ hcst ⇒ x ∊ {z | ∃ u ∃ a ∃ l ∃ e (z = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩)} $ by ax
l9: $ … ⇒ ∃ u ∃ a ∃ l ∃ e (x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by cab_elim [l8]
l10: $ G , x = ⟨ o , t ⟩ , x ∊ hcst , ∃ e (x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) ⇒ ∃ e (x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ax
l11: $ … ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_elim [l10, l7]
l12: $ G , x = ⟨ o , t ⟩ , x ∊ hcst , ∃ l ∃ e (x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) ⇒ ∃ l ∃ e (x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ax
l13: $ … ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_elim [l12, l11]
l14: $ G , x = ⟨ o , t ⟩ , x ∊ hcst , ∃ a ∃ l ∃ e (x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) ⇒ ∃ a ∃ l ∃ e (x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ax
l15: $ … ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_elim [l14, l13]
l16: $ G , x = ⟨ o , t ⟩ , x ∊ hcst ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_elim [l9, l15]
l17: $ G ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by wcel_elim [#1, l16]

lemma f214_l_hcst {x8 x9: set} (G: hyps) (o t: set): $ G ⇒ ⟨ o , t ⟩ ∈ hcst $ > $ G ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ kc_cst , x9 ⟩ ⟩) $
----
l1: $ G ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by f214_e_hcst [#1]
l2: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ $ by ax
l3: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ isset o $ by isset_var
l4: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ isset ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ $ by opair_isset
l5: $ … ⇒ o = ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ $ by opair_inj_l_c [l2, l3, l4]
l6: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ , x = ⟨ a +: l +: ∅ , e ⟩ ⇒ x = ⟨ a +: l +: ∅ , e ⟩ $ by ax
l7: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ , x = ⟨ a +: l +: ∅ , e ⟩ ⇒ kc_cst = kc_cst $ by eq_refl
l8: $ … ⇒ ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ = ⟨ kc_cst , x ⟩ $ by opair_eq [l7, eq_sym [l6]]
l9: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ , x = ⟨ a +: l +: ∅ , e ⟩ ⇒ u = u $ by eq_refl
l10: $ … ⇒ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ = ⟨ u , ⟨ kc_cst , x ⟩ ⟩ $ by opair_eq [l9, l8]
l11: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ , x = ⟨ a +: l +: ∅ , e ⟩ ⇒ o = ⟨ u , ⟨ kc_cst , x ⟩ ⟩ $ by eq_trans [weaken [l5], l10]
l12: $ … ⇒ ∃ x9 (o = ⟨ u , ⟨ kc_cst , x9 ⟩ ⟩) $ by ex_intro [l11]
l13: $ … ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ kc_cst , x9 ⟩ ⟩) $ by ex_intro [l12]
l14: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ isset ⟨ a +: l +: ∅ , e ⟩ $ by opair_isset
l15: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ kc_cst , x9 ⟩ ⟩) $ by isset_elim [l14, l13]
l16: $ G , ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) ⇒ ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ax
l17: $ … ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ kc_cst , x9 ⟩ ⟩) $ by ex_elim [l16, l15]
l18: $ G , ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) ⇒ ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ax
l19: $ … ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ kc_cst , x9 ⟩ ⟩) $ by ex_elim [l18, l17]
l20: $ G , ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) ⇒ ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ax
l21: $ … ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ kc_cst , x9 ⟩ ⟩) $ by ex_elim [l20, l19]
l22: $ G ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ kc_cst , x9 ⟩ ⟩) $ by ex_elim [l1, l21]

lemma f214_f_hcst (G: hyps) (o t p: set): $ G ⇒ ⟨ o , t ⟩ ∈ hcst $ > $ G ⇒ ⟨ o , p ⟩ ∈ hcst $ > $ G ⇒ t = p $
----
l1: $ G ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by f214_e_hcst [#1]
l2: $ G ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (⟨ o , p ⟩ = ⟨ ⟨ x0 , ⟨ kc_cst , ⟨ x1 +: x2 +: ∅ , x3 ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ x0 , ⟨ x1 , lsv x2 w ⟩ ⟩)) ⟩) $ by f214_e_hcst [#2]
l3: $ G , ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ a +: l +: ∅ , e ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (⟨ o , p ⟩ = ⟨ ⟨ x0 , ⟨ kc_cst , ⟨ x1 +: x2 +: ∅ , x3 ⟩ ⟩ ⟩ , (λₛ w ∈ lvals, sclip (Envx' ⟨ x0 , ⟨ x1 , lsv x2 w ⟩ ⟩)) ⟩) $ by weaken [l2]
