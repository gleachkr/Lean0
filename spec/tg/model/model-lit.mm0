-- model-lit.mm0: the literals (layer G of the reduction, audit §11): the value of
-- `lit b` as a part of the hook, and the literal rules in the model. Imports
-- model-quot.mm0; proofs in model-lit.auf.

import "model-quot.mm0";

-- --------------------------------------------------------------------------
-- Literals (layer G): the hook's part and the rules `lit_zero`, `lit_succ`
-- --------------------------------------------------------------------------
-- The value of `lit b` is the numeral of `Nat`'s family for the number of `b`
-- (`nvf` reads binary numerals too): `nnf' nvf' b`.

--| At `lit b`: the numeral of `b`'s number.
def hlit (.u .l .e .z .w: set): class =
  $ {z | ∃ u ∃ l ∃ e (z = ⟨ ⟨ u , ⟨ kc_lit , ⟨ scons l ∅ , e ⟩ ⟩ ⟩ , clam w lvals (sclip (nnf' nvf' l)) ⟩)} $;

--| The denotation of `lit b`, for a hook `mcv H` with `H` extending `hlit`, in an admissible universe: the numeral of
--| `b`'s number.
theorem dt_lit (G: hyps) (H B W R: class) (u: set):
  $ G ⇒ hlit ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ uadm u $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_lit , scons B ∅ ⟩ W R = nnf' nvf' B $;

--| The rule `lit_zero` in the model, for a hook with the inductive types' and the literals' parts.
theorem mlit_zero (H: class) (G: ctx): $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ mdeq (mcv H) G (lit b0) (ind_ctor nat_D nz nz) (ind_ty nat_D nz) $;

-- --------------------------------------------------------------------------
-- The successor of binary numerals; the rule `lit_succ`
-- --------------------------------------------------------------------------

--| The semantics of `bsucc`, by induction on the tree and inversion.
theorem lrel_bsucc_sem (G: hyps) (t1 t2: set):
  $ G ⇒ ra_bsucc t1 t2 ∈ lrel $ > $ G ⇒ nvf' t2 = suc (nvf' t1) $;

--| `bsucc a b`: the number of `b` is the successor of `a`'s.
theorem bsucc_sem (G: hyps) (a b: bin): $ bsucc a b $ > $ G ⇒ nvf' (enc_bin b) = suc (nvf' (enc_bin a)) $;

--| The rule `lit_succ` in the model.
theorem mlit_succ (H: class) (G: ctx) (a b: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ bsucc a b $ > $ mdeq (mcv H) G (lit b) (app (ind_ctor nat_D nz n1) (lit a)) (ind_ty nat_D nz) $;

-- --------------------------------------------------------------------------
-- The arithmetic of binary numerals in the model
-- --------------------------------------------------------------------------

--| The semantics of `bdbl`, by inversion.
theorem lrel_bdbl_sem (G: hyps) (t1 t2: set):
  $ G ⇒ ra_bdbl t1 t2 ∈ lrel $ > $ G ⇒ nvf' t2 = ndbl (nvf' t1) $;

--| `bdbl a b`: the number of `b` is twice `a`'s.
theorem bdbl_sem (G: hyps) (a b: bin): $ bdbl a b $ > $ G ⇒ nvf' (enc_bin b) = ndbl (nvf' (enc_bin a)) $;

--| The semantics of `badd`, by induction on the first tree and inversion.
theorem lrel_badd_sem (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_badd t1 t2 t3 ∈ lrel $ > $ G ⇒ nvf' t3 = nadd (nvf' t1) (nvf' t2) $;

--| `badd a b c`: the number of `c` is the sum of `a`'s and `b`'s.
theorem badd_sem (G: hyps) (a b c: bin): $ badd a b c $ > $ G ⇒ nvf' (enc_bin c) = nadd (nvf' (enc_bin a)) (nvf' (enc_bin b)) $;

--| The semantics of `baddc` (addition with a carry), by induction on the first tree and inversion.
theorem lrel_baddc_sem (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_baddc t1 t2 t3 ∈ lrel $ > $ G ⇒ nvf' t3 = suc (nadd (nvf' t1) (nvf' t2)) $;

--| `baddc a b c`: the number of `c` is the sum of `a`'s and `b`'s, plus one.
theorem baddc_sem (G: hyps) (a b c: bin): $ baddc a b c $ > $ G ⇒ nvf' (enc_bin c) = suc (nadd (nvf' (enc_bin a)) (nvf' (enc_bin b))) $;

--| The semantics of `bmul`, by induction on the second tree and inversion.
theorem lrel_bmul_sem (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bmul t1 t2 t3 ∈ lrel $ > $ G ⇒ nvf' t3 = nmul (nvf' t1) (nvf' t2) $;

--| `bmul a b c`: the number of `c` is the product of `a`'s and `b`'s.
theorem bmul_sem (G: hyps) (a b c: bin): $ bmul a b c $ > $ G ⇒ nvf' (enc_bin c) = nmul (nvf' (enc_bin a)) (nvf' (enc_bin b)) $;

--| The semantics of `bpow`, by induction on the second tree and inversion.
theorem lrel_bpow_sem (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bpow t1 t2 t3 ∈ lrel $ > $ G ⇒ nvf' t3 = npow (nvf' t1) (nvf' t2) $;

--| `bpow a b c`: the number of `c` is `a`'s to the power of `b`'s.
theorem bpow_sem (G: hyps) (a b c: bin): $ bpow a b c $ > $ G ⇒ nvf' (enc_bin c) = npow (nvf' (enc_bin a)) (nvf' (enc_bin b)) $;

-- --------------------------------------------------------------------------
-- The literal rules
-- --------------------------------------------------------------------------

--| An atom of `jmod` is a judgment of the model (the converse of `jmod_i`).
theorem jmod_e (M: class) (G: ctx) (e e2 A: expr): $ deq_j (jmod M) G e e2 A $ > $ mdeq M G e e2 A $;

--| The premises of the relations that state Lean's defining equations, back from the relations (their clauses
--| inverted): `X_eqs_pk` is premise `k` of the clause `X_eqs_i`.

--| Premise 1 of the clause `add_eqs_i`, read back from the relation `add_eqs_j J`.
theorem add_eqs_p1 (J: class) (G: ctx) (f: expr): $ add_eqs_j J G f $ > $ closed nz f $;

--| Premise 2 of the clause `add_eqs_i`, read back from the relation `add_eqs_j J`.
theorem add_eqs_p2 (J: class) (G: ctx) (f: expr): $ add_eqs_j J G f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 3 of the clause `add_eqs_i`, read back from the relation `add_eqs_j J`.
theorem add_eqs_p3 (J: class) (G: ctx) (f: expr): $ add_eqs_j J G f $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $;

--| Premise 4 of the clause `add_eqs_i`, read back from the relation `add_eqs_j J`.
theorem add_eqs_p4 (J: class) (G: ctx) (f: expr): $ add_eqs_j J G f $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app nat_succ (app (app f (bvar n1)) (bvar nz))) nat_ty $;

--| Premise 1 of the clause `pred_eqs_i`, read back from the relation `pred_eqs_j J`.
theorem pred_eqs_p1 (J: class) (G: ctx) (p: expr): $ pred_eqs_j J G p $ > $ closed nz p $;

--| Premise 2 of the clause `pred_eqs_i`, read back from the relation `pred_eqs_j J`.
theorem pred_eqs_p2 (J: class) (G: ctx) (p: expr): $ pred_eqs_j J G p $ > $ ty_j J G p (pi nat_ty nat_ty) $;

--| Premise 3 of the clause `pred_eqs_i`, read back from the relation `pred_eqs_j J`.
theorem pred_eqs_p3 (J: class) (G: ctx) (p: expr): $ pred_eqs_j J G p $ > $ deq_j J G (app p nat_zero) nat_zero nat_ty $;

--| Premise 4 of the clause `pred_eqs_i`, read back from the relation `pred_eqs_j J`.
theorem pred_eqs_p4 (J: class) (G: ctx) (p: expr): $ pred_eqs_j J G p $ > $ deq_j J (cons nat_ty G) (app p (app nat_succ (bvar nz))) (bvar nz) nat_ty $;

--| Premise 1 of the clause `sub_eqs_i`, read back from the relation `sub_eqs_j J`.
theorem sub_eqs_p1 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ pred_eqs_j J G p $;

--| Premise 2 of the clause `sub_eqs_i`, read back from the relation `sub_eqs_j J`.
theorem sub_eqs_p2 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ closed nz f $;

--| Premise 3 of the clause `sub_eqs_i`, read back from the relation `sub_eqs_j J`.
theorem sub_eqs_p3 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 4 of the clause `sub_eqs_i`, read back from the relation `sub_eqs_j J`.
theorem sub_eqs_p4 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $;

--| Premise 5 of the clause `sub_eqs_i`, read back from the relation `sub_eqs_j J`.
theorem sub_eqs_p5 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app p (app (app f (bvar n1)) (bvar nz))) nat_ty $;

--| Premise 1 of the clause `mul_eqs_i`, read back from the relation `mul_eqs_j J`.
theorem mul_eqs_p1 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ add_eqs_j J G fa $;

--| Premise 2 of the clause `mul_eqs_i`, read back from the relation `mul_eqs_j J`.
theorem mul_eqs_p2 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ closed nz f $;

--| Premise 3 of the clause `mul_eqs_i`, read back from the relation `mul_eqs_j J`.
theorem mul_eqs_p3 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 4 of the clause `mul_eqs_i`, read back from the relation `mul_eqs_j J`.
theorem mul_eqs_p4 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) nat_zero nat_ty $;

--| Premise 5 of the clause `mul_eqs_i`, read back from the relation `mul_eqs_j J`.
theorem mul_eqs_p5 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fa (app (app f (bvar n1)) (bvar nz))) (bvar n1)) nat_ty $;

--| Premise 1 of the clause `pow_eqs_i`, read back from the relation `pow_eqs_j J`.
theorem pow_eqs_p1 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ mul_eqs_j J G fm fa $;

--| Premise 2 of the clause `pow_eqs_i`, read back from the relation `pow_eqs_j J`.
theorem pow_eqs_p2 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ closed nz f $;

--| Premise 3 of the clause `pow_eqs_i`, read back from the relation `pow_eqs_j J`.
theorem pow_eqs_p3 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 4 of the clause `pow_eqs_i`, read back from the relation `pow_eqs_j J`.
theorem pow_eqs_p4 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (app nat_succ nat_zero) nat_ty $;

--| Premise 5 of the clause `pow_eqs_i`, read back from the relation `pow_eqs_j J`.
theorem pow_eqs_p5 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fm (app (app f (bvar n1)) (bvar nz))) (bvar n1)) nat_ty $;

--| Premise 1 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p1 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ closed nz f $;

--| Premise 2 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p2 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ closed nz B $;

--| Premise 3 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p3 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ closed nz t $;

--| Premise 4 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p4 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ closed nz u $;

--| Premise 5 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p5 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ ty_j J G f (pi nat_ty (pi nat_ty B)) $;

--| Premise 6 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p6 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ deq_j J G (app (app f nat_zero) nat_zero) t B $;

--| Premise 7 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p7 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty G) (app (app f nat_zero) (app nat_succ (bvar nz))) u B $;

--| Premise 8 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p8 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty G) (app (app f (app nat_succ (bvar nz))) nat_zero) u B $;

--| Premise 9 of the clause `beq_eqs_i`, read back from the relation `beq_eqs_j J`.
theorem beq_eqs_p9 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (app nat_succ (bvar n1))) (app nat_succ (bvar nz))) (app (app f (bvar n1)) (bvar nz)) B $;

--| Premise 1 of the clause `ble_eqs_i`, read back from the relation `ble_eqs_j J`.
theorem ble_eqs_p1 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ closed nz f $;

--| Premise 2 of the clause `ble_eqs_i`, read back from the relation `ble_eqs_j J`.
theorem ble_eqs_p2 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ closed nz B $;

--| Premise 3 of the clause `ble_eqs_i`, read back from the relation `ble_eqs_j J`.
theorem ble_eqs_p3 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ closed nz t $;

--| Premise 4 of the clause `ble_eqs_i`, read back from the relation `ble_eqs_j J`.
theorem ble_eqs_p4 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ closed nz u $;

--| Premise 5 of the clause `ble_eqs_i`, read back from the relation `ble_eqs_j J`.
theorem ble_eqs_p5 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ ty_j J G f (pi nat_ty (pi nat_ty B)) $;

--| Premise 6 of the clause `ble_eqs_i`, read back from the relation `ble_eqs_j J`.
theorem ble_eqs_p6 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty G) (app (app f nat_zero) (bvar nz)) t B $;

--| Premise 7 of the clause `ble_eqs_i`, read back from the relation `ble_eqs_j J`.
theorem ble_eqs_p7 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty G) (app (app f (app nat_succ (bvar nz))) nat_zero) u B $;

--| Premise 8 of the clause `ble_eqs_i`, read back from the relation `ble_eqs_j J`.
theorem ble_eqs_p8 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (app nat_succ (bvar n1))) (app nat_succ (bvar nz))) (app (app f (bvar n1)) (bvar nz)) B $;

--| Premise 1 of the clause `shl_eqs_i`, read back from the relation `shl_eqs_j J`.
theorem shl_eqs_p1 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ mul_eqs_j J G fm fa $;

--| Premise 2 of the clause `shl_eqs_i`, read back from the relation `shl_eqs_j J`.
theorem shl_eqs_p2 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ closed nz f $;

--| Premise 3 of the clause `shl_eqs_i`, read back from the relation `shl_eqs_j J`.
theorem shl_eqs_p3 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 4 of the clause `shl_eqs_i`, read back from the relation `shl_eqs_j J`.
theorem shl_eqs_p4 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $;

--| Premise 5 of the clause `shl_eqs_i`, read back from the relation `shl_eqs_j J`.
theorem shl_eqs_p5 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app f (app (app fm (lit (bd0 (bd1 b0)))) (bvar n1))) (bvar nz)) nat_ty $;

--| Premise 1 of the clause `shr_eqs_i`, read back from the relation `shr_eqs_j J`.
theorem shr_eqs_p1 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ closed nz f $;

--| Premise 2 of the clause `shr_eqs_i`, read back from the relation `shr_eqs_j J`.
theorem shr_eqs_p2 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ closed nz fd $;

--| Premise 3 of the clause `shr_eqs_i`, read back from the relation `shr_eqs_j J`.
theorem shr_eqs_p3 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 4 of the clause `shr_eqs_i`, read back from the relation `shr_eqs_j J`.
theorem shr_eqs_p4 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $;

--| Premise 5 of the clause `shr_eqs_i`, read back from the relation `shr_eqs_j J`.
theorem shr_eqs_p5 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fd (app (app f (bvar n1)) (bvar nz))) (lit (bd0 (bd1 b0)))) nat_ty $;

--| The rule `nat_add_lit` in the model: a function with `Nat.add`'s defining equations adds literals.
theorem madd_lit (H: class) (G: ctx) (f: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ add_eqs_j (jmod (mcv H)) G f $ > $ badd a b c $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

--| The rule `nat_mul_lit` in the model.
theorem mmul_lit (H: class) (G: ctx) (f fa: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ mul_eqs_j (jmod (mcv H)) G f fa $ > $ bmul a b c $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

--| The rule `nat_pow_lit` in the model.
theorem mpow_lit (H: class) (G: ctx) (f fm fa: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ pow_eqs_j (jmod (mcv H)) G f fm fa $ > $ bpow a b c $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

--| The rule `nat_sub_lit` in the model.
theorem msub_lit (H: class) (G: ctx) (f fp: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ sub_eqs_j (jmod (mcv H)) G f fp $ > $ badd c b a $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

--| The rule `nat_sub_lit0` in the model.
theorem msub_lit0 (H: class) (G: ctx) (f fp: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ sub_eqs_j (jmod (mcv H)) G f fp $ > $ badd a c b $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit b0) nat_ty $;

--| The rule `nat_shr_lit_z` in the model.
theorem mshr_lit_z (H: class) (G: ctx) (f fd: expr) (a: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ shr_eqs_j (jmod (mcv H)) G f fd $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b0)) (lit a) nat_ty $;

--| The rule `nat_shr_lit_s` in the model.
theorem mshr_lit_s (H: class) (G: ctx) (f fd: expr) (a b b2 c c2: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ shr_eqs_j (jmod (mcv H)) G f fd $ > $ bsucc b b2 $ > $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $ > $ mdeq (mcv H) G (app (app fd (lit c)) (lit (bd0 (bd1 b0)))) (lit c2) nat_ty $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b2)) (lit c2) nat_ty $;

--| The rule `nat_shl_lit` in the model.
theorem mshl_lit (H: class) (G: ctx) (f fm fa: expr) (a b pwr c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ shl_eqs_j (jmod (mcv H)) G f fm fa $ > $ bpow (bd0 (bd1 b0)) b pwr $ > $ bmul a pwr c $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

--| The rule `nat_beq_lit` in the model.
theorem mbeq_lit (H: class) (G: ctx) (f B vt vf: expr) (a: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ beq_eqs_j (jmod (mcv H)) G f B vt vf $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit a)) (vt) (B) $;

--| The rule `nat_beq_lit_lt` in the model.
theorem mbeq_lit_lt (H: class) (G: ctx) (f B vt vf: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ beq_eqs_j (jmod (mcv H)) G f B vt vf $ > $ baddc a c b $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (vf) (B) $;

--| The rule `nat_beq_lit_gt` in the model.
theorem mbeq_lit_gt (H: class) (G: ctx) (f B vt vf: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ beq_eqs_j (jmod (mcv H)) G f B vt vf $ > $ baddc b c a $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (vf) (B) $;

--| The rule `nat_ble_lit` in the model.
theorem mble_lit (H: class) (G: ctx) (f B vt vf: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ ble_eqs_j (jmod (mcv H)) G f B vt vf $ > $ badd a c b $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (vt) (B) $;

--| The rule `nat_ble_lit_gt` in the model.
theorem mble_lit_gt (H: class) (G: ctx) (f B vt vf: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ ble_eqs_j (jmod (mcv H)) G f B vt vf $ > $ baddc b c a $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (vf) (B) $;

-- --------------------------------------------------------------------------
-- Invariance of the literals' values (D4): a `lit` node is `eeqv` only to itself
-- --------------------------------------------------------------------------

--| `minv_intro`'s step at the nodes `lit`, for every hook: the node is `eeqv` to itself only.
theorem mcv_inv_node_lit (G: hyps) (M: class) (u w d z y t: set):
  $ G ⇒ z = ⟨ kc_lit , y ⟩ $ > $ G ⇒ ra_eeqv z t ∈ lrel2 $ >
  $ G ⇒ dt u M z w d = dt u M t w d $;

-- --------------------------------------------------------------------------
-- The bitwise relations on binary numerals: zeros, and the digits of an instance
-- --------------------------------------------------------------------------

--| `band` at a zero: the result is zero (by induction on the first tree and inversion).
theorem lrel_band_zero (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_band t1 t2 t3 ∈ lrel $ > $ G ⇒ (nvf' t1 = ∅ → nvf' t3 = ∅) ∧ (nvf' t2 = ∅ → nvf' t3 = ∅) $;

--| An instance of `band` has a zero argument, or it is a smaller instance with a digit on each argument (by inversion).
--| @freshen G x
--| @freshen G y
--| @freshen G z
theorem lrel_band_digits {x y z: set} (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_band t1 t2 t3 ∈ lrel $ >
  $ G ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $;

--| `bor` at a zero: the result is the other argument (by induction on the first tree and inversion).
theorem lrel_bor_zero (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bor t1 t2 t3 ∈ lrel $ > $ G ⇒ (nvf' t1 = ∅ → nvf' t3 = nvf' t2) ∧ (nvf' t2 = ∅ → nvf' t3 = nvf' t1) $;

--| An instance of `bor` has a zero argument, or it is a smaller instance with a digit on each argument (by inversion).
--| @freshen G x
--| @freshen G y
--| @freshen G z
theorem lrel_bor_digits {x y z: set} (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bor t1 t2 t3 ∈ lrel $ >
  $ G ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $;

--| `bxor` at a zero: the result is the other argument (by induction on the first tree and inversion).
theorem lrel_bxor_zero (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bxor t1 t2 t3 ∈ lrel $ > $ G ⇒ (nvf' t1 = ∅ → nvf' t3 = nvf' t2) ∧ (nvf' t2 = ∅ → nvf' t3 = nvf' t1) $;

--| An instance of `bxor` has a zero argument, or it is a smaller instance with a digit on each argument (by inversion).
--| @freshen G x
--| @freshen G y
--| @freshen G z
theorem lrel_bxor_digits {x y z: set} (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bxor t1 t2 t3 ∈ lrel $ >
  $ G ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bxor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)))) $;


-- --------------------------------------------------------------------------
-- The block of `Nat.le` in the model
-- --------------------------------------------------------------------------

--| The block of `Nat.le` is well formed, over the judgment atoms that hold in the model of a hook with the
--| inductive types' parts.
theorem le_D_wf (H: class): $ _ ⇒ hind H $ > $ ind_wf_j (jmod (mcv H)) nil le_D $;


-- --------------------------------------------------------------------------
-- The order of the numerals
-- --------------------------------------------------------------------------

--| The numerals are distinct: `nnf` is injective on `ω`.
theorem nnf_inj (G: hyps) (a b: set): $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ nnf' a = nnf' b $ > $ G ⇒ a = b $;

--| The truth value of `A ≤ B` for numerals `A` and `B` of the model: `csn ∅` when they are the numerals of numbers
--| `c ⊆ d`, else `∅`.
def nlev (A B: class) (.e .c .d: set): class =
  $ {e | (e = ∅) ∧ (∃ c (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((A = (nnf' c)) ∧ ((B = (nnf' d)) ∧ (c ⊆ d)))))))} $;
--| @congr
theorem nlev_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ nlev A C ≐ nlev B D $;
--| @rewrite
theorem sb_c_nlev {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (nlev A B)) ≐ nlev (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;

theorem nlev_eq (G: hyps) (A B C D: class): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ nlev A C = nlev B D $;

--| The truth value of `≤` is a truth value.
theorem nlev_two (G: hyps) (A B: class): $ G ⇒ nlev A B ∈ two $;

--| It holds at the numerals of `a ⊆ b`.
theorem nlev_intro (G: hyps) (a b: set): $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ⊆ b $ > $ G ⇒ ∅ ∈ nlev (nnf' a) (nnf' b) $;

--| An element of it at two numerals gives `⊆` of their numbers.
theorem nlev_elim (G: hyps) (X: class) (a b: set): $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ X ∈ nlev (nnf' a) (nnf' b) $ > $ G ⇒ a ⊆ b $;


-- --------------------------------------------------------------------------
-- The model's `Nat.le` is the order of the numerals
-- --------------------------------------------------------------------------

--| The model's `Nat.le` is the order of the numerals: at the numerals of two numbers the value of `ind_ty le_D 0` is the
--| truth value of `⊆`.
def mles (M: class) (.u .w .a .b: set): fml =
  $ ∀ u (∀ w ((uadm u) → ((w ∊ lvals) → (∀ a (∀ b ((a ∊ ω) → ((b ∊ ω) → ((ap (ap (dt u M (enc_expr (ind_ty le_D nz)) w ∅) (nnf' a)) (nnf' b)) = (nlev (nnf' a) (nnf' b)))))))))) $;
--| @congr
theorem mles_congr (A B: class): $ A ≐ B $ > $ mles A ⟺ mles B $;
--| @rewrite
theorem sb_f_mles {x: set} (t: set x) (A: class x):
  $ [x/t] (mles A) ⟺ mles (⟦ x / t ⟧ A) $;

--| The model's `Nat.le` is the order of the numerals, for a hook with the inductive types' parts: by induction, the
--| constructors give an element at the numerals of `x ⊆ y`; the recursor at the motive `nlev` turns an element into `x ⊆ y`.
theorem mles_i (H: class): $ _ ⇒ hind H $ > $ _ ⇒ mles (mcv H) $;


-- --------------------------------------------------------------------------
-- The division-like relations: their premises
-- --------------------------------------------------------------------------

--| Premise 1 of the clause `divmod_eqs_i`, read back from the relation `divmod_eqs_j J`.
theorem divmod_eqs_p1 (J: class) (G: ctx) (fd fm fmul fadd: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ mul_eqs_j J G fmul fadd $;

--| Premise 2 of the clause `divmod_eqs_i`, read back from the relation `divmod_eqs_j J`.
theorem divmod_eqs_p2 (J: class) (G: ctx) (fd fm fmul fadd: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ closed nz fd $;

--| Premise 3 of the clause `divmod_eqs_i`, read back from the relation `divmod_eqs_j J`.
theorem divmod_eqs_p3 (J: class) (G: ctx) (fd fm fmul fadd: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ closed nz fm $;

--| Premise 4 of the clause `divmod_eqs_i`, read back from the relation `divmod_eqs_j J`.
theorem divmod_eqs_p4 (J: class) (G: ctx) (fd fm fmul fadd: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ ty_j J G fd (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 5 of the clause `divmod_eqs_i`, read back from the relation `divmod_eqs_j J`.
theorem divmod_eqs_p5 (J: class) (G: ctx) (fd fm fmul fadd: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ ty_j J G fm (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 1 of the clause `gcd_eqs_i`, read back from the relation `gcd_eqs_j J`.
theorem gcd_eqs_p1 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ gcd_eqs_j J G f fd fm fmul fadd $ > $ divmod_eqs_j J G fd fm fmul fadd $;

--| Premise 2 of the clause `gcd_eqs_i`, read back from the relation `gcd_eqs_j J`.
theorem gcd_eqs_p2 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ gcd_eqs_j J G f fd fm fmul fadd $ > $ closed nz f $;

--| Premise 3 of the clause `gcd_eqs_i`, read back from the relation `gcd_eqs_j J`.
theorem gcd_eqs_p3 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ gcd_eqs_j J G f fd fm fmul fadd $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 1 of the clause `land_eqs_i`, read back from the relation `land_eqs_j J`.
theorem land_eqs_p1 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ land_eqs_j J G f fd fm fmul fadd $ > $ divmod_eqs_j J G fd fm fmul fadd $;

--| Premise 2 of the clause `land_eqs_i`, read back from the relation `land_eqs_j J`.
theorem land_eqs_p2 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ land_eqs_j J G f fd fm fmul fadd $ > $ closed nz f $;

--| Premise 3 of the clause `land_eqs_i`, read back from the relation `land_eqs_j J`.
theorem land_eqs_p3 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ land_eqs_j J G f fd fm fmul fadd $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 1 of the clause `lor_eqs_i`, read back from the relation `lor_eqs_j J`.
theorem lor_eqs_p1 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ lor_eqs_j J G f fd fm fmul fadd $ > $ divmod_eqs_j J G fd fm fmul fadd $;

--| Premise 2 of the clause `lor_eqs_i`, read back from the relation `lor_eqs_j J`.
theorem lor_eqs_p2 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ lor_eqs_j J G f fd fm fmul fadd $ > $ closed nz f $;

--| Premise 3 of the clause `lor_eqs_i`, read back from the relation `lor_eqs_j J`.
theorem lor_eqs_p3 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ lor_eqs_j J G f fd fm fmul fadd $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

--| Premise 1 of the clause `xor_eqs_i`, read back from the relation `xor_eqs_j J`.
theorem xor_eqs_p1 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ xor_eqs_j J G f fd fm fmul fadd $ > $ divmod_eqs_j J G fd fm fmul fadd $;

--| Premise 2 of the clause `xor_eqs_i`, read back from the relation `xor_eqs_j J`.
theorem xor_eqs_p2 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ xor_eqs_j J G f fd fm fmul fadd $ > $ closed nz f $;

--| Premise 3 of the clause `xor_eqs_i`, read back from the relation `xor_eqs_j J`.
theorem xor_eqs_p3 (J: class) (G: ctx) (f fd fm fmul fadd: expr): $ xor_eqs_j J G f fd fm fmul fadd $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;




-- --------------------------------------------------------------------------
-- The division-like rules
-- --------------------------------------------------------------------------



--| The rule `nat_div_lit` in the model.
theorem mdiv_lit (H: class) (G: ctx) (fd fm fmul fadd: expr) (ba bb bq bm br bx: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ divmod_eqs_j (jmod (mcv H)) G fd fm fmul fadd $ > $ bmul bb bq bm $ > $ badd bm br ba $ > $ baddc br bx bb $ >
  $ mdeq (mcv H) G (app (app fd (lit ba)) (lit bb)) (lit bq) nat_ty $;

--| The rule `nat_div_lit0` in the model.
theorem mdiv_lit0 (H: class) (G: ctx) (fd fm fmul fadd: expr) (ba: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ divmod_eqs_j (jmod (mcv H)) G fd fm fmul fadd $ >
  $ mdeq (mcv H) G (app (app fd (lit ba)) (lit b0)) (lit b0) nat_ty $;

--| The rule `nat_mod_lit` in the model.
theorem mmod_lit (H: class) (G: ctx) (fd fm fmul fadd: expr) (ba bb bq bm br bx: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ divmod_eqs_j (jmod (mcv H)) G fd fm fmul fadd $ > $ bmul bb bq bm $ > $ badd bm br ba $ > $ baddc br bx bb $ >
  $ mdeq (mcv H) G (app (app fm (lit ba)) (lit bb)) (lit br) nat_ty $;

--| The rule `nat_mod_lit0` in the model.
theorem mmod_lit0 (H: class) (G: ctx) (fd fm fmul fadd: expr) (ba: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ divmod_eqs_j (jmod (mcv H)) G fd fm fmul fadd $ >
  $ mdeq (mcv H) G (app (app fm (lit ba)) (lit b0)) (lit ba) nat_ty $;



--| The rule `nat_gcd_lit` in the model.
theorem mgcd_lit (H: class) (G: ctx) (f fd fm fmul fadd: expr) (ba bb bg bc bq bx bz bm bn: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ gcd_eqs_j (jmod (mcv H)) G f fd fm fmul fadd $ > $ bmul bg bc ba $ > $ bmul bg bq bb $ > $ bmul bx ba bm $ > $ bmul bz bb bn $ > $ badd bn bg bm $ >
  $ mdeq (mcv H) G (app (app f (lit ba)) (lit bb)) (lit bg) nat_ty $;

--| The rule `nat_gcd_lit2` in the model.
theorem mgcd_lit2 (H: class) (G: ctx) (f fd fm fmul fadd: expr) (ba bb bg bc bq bx bz bm bn: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ gcd_eqs_j (jmod (mcv H)) G f fd fm fmul fadd $ > $ bmul bg bc ba $ > $ bmul bg bq bb $ > $ bmul bx ba bm $ > $ bmul bz bb bn $ > $ badd bm bg bn $ >
  $ mdeq (mcv H) G (app (app f (lit ba)) (lit bb)) (lit bg) nat_ty $;





--| The rule `nat_land_lit` in the model.
theorem mland_lit (H: class) (G: ctx) (f fd fm fmul fadd: expr) (ba bb bc: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ land_eqs_j (jmod (mcv H)) G f fd fm fmul fadd $ > $ band ba bb bc $ >
  $ mdeq (mcv H) G (app (app f (lit ba)) (lit bb)) (lit bc) nat_ty $;

--| The rule `nat_lor_lit` in the model.
theorem mlor_lit (H: class) (G: ctx) (f fd fm fmul fadd: expr) (ba bb bc: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ lor_eqs_j (jmod (mcv H)) G f fd fm fmul fadd $ > $ bor ba bb bc $ >
  $ mdeq (mcv H) G (app (app f (lit ba)) (lit bb)) (lit bc) nat_ty $;

--| The rule `nat_xor_lit` in the model.
theorem mxor_lit (H: class) (G: ctx) (f fd fm fmul fadd: expr) (ba bb bc: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ xor_eqs_j (jmod (mcv H)) G f fd fm fmul fadd $ > $ bxor ba bb bc $ >
  $ mdeq (mcv H) G (app (app f (lit ba)) (lit bb)) (lit bc) nat_ty $;
