-- model-top.mm0: the model's hook and the assembly (audit §11): the
-- environment's values at the three axioms' atoms, the constants' invariance
-- under `eeqv`, the hook `hfin` of all the parts, its invariance. Imports
-- model-lit.mm0; proofs in model-top.auf.

import "model-lit.mm0";

-- --------------------------------------------------------------------------
-- The constants: the environment at the axioms' atoms, invariance
-- --------------------------------------------------------------------------
-- A certificate's opaque and axiomatic constants are `cst a S` over generated
-- atoms; the spec says nothing of them but `closed_cst` and `eeqv_cst`. Their
-- values are a parameter of the model, the class `Env` of model-quot.mm0,
-- which has no axioms; the certificate's typing axioms for its constants are
-- the constraints on it. `Envx` (model-quot.mm0) fixes the values at the
-- spec's own atoms: here those of `propext`, `Quot.sound`, `Classical.choice`.

--| The value at the atom of `propext` is `∅`.
theorem envx_propext (G: hyps) (u s: set): $ G ⇒ Envx' ⟨ u , ⟨ ⟨ kc_propext_atom , ∅ ⟩ , s ⟩ ⟩ = ∅ $;
--| The value at the atom of `Quot.sound` is `∅`.
theorem envx_quot_sound (G: hyps) (u s: set): $ G ⇒ Envx' ⟨ u , ⟨ ⟨ kc_quot_sound_atom , ∅ ⟩ , s ⟩ ⟩ = ∅ $;
--| The value at the atom of `Classical.choice` is the choice function at the first level value.
theorem envx_choice (G: hyps) (u s: set): $ G ⇒ Envx' ⟨ u , ⟨ ⟨ kc_choice_atom , ∅ ⟩ , s ⟩ ⟩ = chv (s' ∅) $;

-- --------------------------------------------------------------------------
-- Equivalent level lists have the same values; the hook at the nodes `cst`
-- --------------------------------------------------------------------------

--| Equivalent level lists (`lseqv`) have the same values at every level valuation.
theorem lrel2_lseqv_lsv (G: hyps) (t1 t2 w: set):
  $ G ⇒ ra_lseqv t1 t2 ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lsv t1 w = lsv t2 w $;

--| `minv_intro`'s step at the nodes `cst`: equivalent level lists have the same values, so the node denotes as every tree it is `eeqv` to.
theorem mcv_inv_node_cst (G: hyps) (H: class) (u w d z y t: set):
  $ G ⇒ hcst ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ z = ⟨ kc_cst , y ⟩ $ > $ G ⇒ ra_eeqv z t ∈ lrel2 $ >
  $ G ⇒ dt u (mcv H) z w d = dt u (mcv H) t w d $;

-- --------------------------------------------------------------------------
-- The hook of the model: all the parts
-- --------------------------------------------------------------------------

--| The hook of the model before the course of values: the parts for the inductive types, their
--| constructors and recursors, the literals and the constants (the quotient primitives among them).
def hfin: class = $ hty ∪ (hctor ∪ (hrec ∪ (hlit ∪ hcst))) $;
--| The hook is a function: the parts are, and their keys have different labels.
theorem hfin_functional (G: hyps): $ G ⇒ functional hfin $;
--| The hook has the part `hty`.
theorem hfin_hty (G: hyps): $ G ⇒ hty ⊆ hfin $;
--| The hook has the part `hctor`.
theorem hfin_hctor (G: hyps): $ G ⇒ hctor ⊆ hfin $;
--| The hook has the part `hrec`.
theorem hfin_hrec (G: hyps): $ G ⇒ hrec ⊆ hfin $;
--| The hook has the part `hlit`.
theorem hfin_hlit (G: hyps): $ G ⇒ hlit ⊆ hfin $;
--| The hook has the part `hcst`.
theorem hfin_hcst (G: hyps): $ G ⇒ hcst ⊆ hfin $;
--| The hook has the parts of the inductive types.
theorem hfin_hind (G: hyps): $ G ⇒ hind hfin $;
--| The hook gives the quotient constants their values: it has the constants' part.
theorem hfin_hqu (G: hyps): $ G ⇒ hqu hfin $;
-- --------------------------------------------------------------------------
-- The hook is invariant under `eeqv`
-- --------------------------------------------------------------------------
--| The hook is invariant under `eeqv`: `minv_intro` at the five labels it interprets.
theorem hfin_minv (G: hyps): $ G ⇒ minv (mcv hfin) $;

-- --------------------------------------------------------------------------
-- The assembly: the spec's judgment and its relations over `⊢`, in the model
-- --------------------------------------------------------------------------
-- `deq` is the model's judgment at the hook `hfin`; the relations of Part II
-- over `⊢` are lean-tg3's at the judgment atoms that hold in the model
-- (`jmod`). Below them, the spec's axioms about them are theorems, with the
-- spec's statements: lean-tg-rest.mm0 keeps what is not proved here.

--| The spec's judgment `G ⊢ e ≡ e2 : A`: in every admissible universe, at every level valuation and every valuation
--| of `G`, `e` and `e2` have the same value, an element of the value of `A`.
def deq (G: ctx) (e e2 A: expr): wff = $ mdeq (mcv hfin) G e e2 A $;
--| Typing: `e` is equal to itself at `A`.
def ty (G: ctx) (e A: expr): wff = $ deq G e e A $;
notation deq (G: ctx) (e e2 A: expr): wff = ($<:$:0) G ($|-$:0) e ($==$:0) e2 ($:$:0) A ($:>$:0);
notation deq (G: ctx) (e e2 A: expr): wff = ($⟦$:0) G ($⊢$:0) e ($≡$:0) e2 ($:$:0) A ($⟧$:0);
notation ty (G: ctx) (e A: expr): wff = ($<:t$:0) G ($|-$:0) e ($:$:0) A ($:>$:0);
notation ty (G: ctx) (e A: expr): wff = ($⟦ₜ$:0) G ($⊢$:0) e ($:$:0) A ($⟧$:0);
--| The spec's `inh`: the value of `A` is never empty.
def inh (G: ctx) (A: expr): wff = $ minh (mcv hfin) G A $;
--| The spec's `sty`, over the judgments that hold in the model.
def sty (G: ctx) (e1 e2 e3 e4: expr): wff = $ sty_j (jmod (mcv hfin)) G e1 e2 e3 e4 $;
--| The spec's `cwf`, over the judgments that hold in the model.
def cwf (D: ind) (n1_v n2_v: nat) (l: lvl) (n3_v: nat) (G: ctx) (n4_v: nat) (e1: expr): wff = $ cwf_j (jmod (mcv hfin)) D n1_v n2_v l n3_v G n4_v e1 $;
--| The spec's `ctors_wf`, over the judgments that hold in the model.
def ctors_wf (D: ind) (n1_v n2_v: nat) (l: lvl) (n3_v: nat) (G: ctx) (C: ctors): wff = $ ctors_wf_j (jmod (mcv hfin)) D n1_v n2_v l n3_v G C $;
--| The spec's `tys_wf`, over the judgments that hold in the model.
def tys_wf (D: ind) (n1_v n2_v: nat) (l: lvl) (n3_v: nat) (G: ctx) (T: tys): wff = $ tys_wf_j (jmod (mcv hfin)) D n1_v n2_v l n3_v G T $;
--| The spec's `ctx_wf`, over the judgments that hold in the model.
def ctx_wf (G G2: ctx): wff = $ ctx_wf_j (jmod (mcv hfin)) G G2 $;
--| The spec's `tys_ty`, over the judgments that hold in the model.
def tys_ty (G: ctx) (T: tys): wff = $ tys_ty_j (jmod (mcv hfin)) G T $;
--| The spec's `tys_ok`, over the judgments that hold in the model.
def tys_ok (G: ctx) (D: ind): wff = $ tys_ok_j (jmod (mcv hfin)) G D $;
--| The spec's `ind_wf`, over the judgments that hold in the model.
def ind_wf (G: ctx) (D: ind): wff = $ ind_wf_j (jmod (mcv hfin)) G D $;
--| The spec's `nst_ok`, over the judgments that hold in the model.
def nst_ok (G: ctx) (D: ind) (n1_v: nat) (G2: ctx): wff = $ nst_ok_j (jmod (mcv hfin)) G D n1_v G2 $;
--| The spec's `nst_ty`, over the judgments that hold in the model.
def nst_ty (G: ctx) (D D2: ind) (e1: expr): wff = $ nst_ty_j (jmod (mcv hfin)) G D D2 e1 $;
--| The spec's `large`, over the judgments that hold in the model.
def large (G: ctx) (D: ind): wff = $ large_j (jmod (mcv hfin)) G D $;
--| The spec's `fir`, over the judgments that hold in the model.
def fir (D: ind) (n1_v: nat) (G: ctx) (n2_v: nat) (e1: expr): wff = $ fir_j (jmod (mcv hfin)) D n1_v G n2_v e1 $;
--| The spec's `elim_ok`, over the judgments that hold in the model.
def elim_ok (G: ctx) (D: ind) (l: lvl): wff = $ elim_ok_j (jmod (mcv hfin)) G D l $;
--| The spec's `fprops`, over the judgments that hold in the model.
def fprops (D: ind) (n1_v n2_v: nat) (G: ctx) (n3_v n4_v: nat) (e1: expr): wff = $ fprops_j (jmod (mcv hfin)) D n1_v n2_v G n3_v n4_v e1 $;
--| The spec's `proj_ok`, over the judgments that hold in the model.
def proj_ok (G: ctx) (D: ind) (n1_v n2_v: nat): wff = $ proj_ok_j (jmod (mcv hfin)) G D n1_v n2_v $;
--| The spec's `add_eqs`, over the judgments that hold in the model.
def add_eqs (G: ctx) (e1: expr): wff = $ add_eqs_j (jmod (mcv hfin)) G e1 $;
--| The spec's `pred_eqs`, over the judgments that hold in the model.
def pred_eqs (G: ctx) (e1: expr): wff = $ pred_eqs_j (jmod (mcv hfin)) G e1 $;
--| The spec's `sub_eqs`, over the judgments that hold in the model.
def sub_eqs (G: ctx) (e1 e2: expr): wff = $ sub_eqs_j (jmod (mcv hfin)) G e1 e2 $;
--| The spec's `mul_eqs`, over the judgments that hold in the model.
def mul_eqs (G: ctx) (e1 e2: expr): wff = $ mul_eqs_j (jmod (mcv hfin)) G e1 e2 $;
--| The spec's `pow_eqs`, over the judgments that hold in the model.
def pow_eqs (G: ctx) (e1 e2 e3: expr): wff = $ pow_eqs_j (jmod (mcv hfin)) G e1 e2 e3 $;
--| The spec's `beq_eqs`, over the judgments that hold in the model.
def beq_eqs (G: ctx) (e1 e2 e3 e4: expr): wff = $ beq_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 $;
--| The spec's `ble_eqs`, over the judgments that hold in the model.
def ble_eqs (G: ctx) (e1 e2 e3 e4: expr): wff = $ ble_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 $;
--| The spec's `shl_eqs`, over the judgments that hold in the model.
def shl_eqs (G: ctx) (e1 e2 e3: expr): wff = $ shl_eqs_j (jmod (mcv hfin)) G e1 e2 e3 $;
--| The spec's `shr_eqs`, over the judgments that hold in the model.
def shr_eqs (G: ctx) (e1 e2: expr): wff = $ shr_eqs_j (jmod (mcv hfin)) G e1 e2 $;

-- --------------------------------------------------------------------------
-- The spec's axioms about them, as theorems
-- --------------------------------------------------------------------------

--| The spec's axiom `sty_nil` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem sty_nil (G: ctx) (h A: expr): $ sty G h A h A $;

--| The spec's axiom `sty_app` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem sty_app (G: ctx) (h A f a B C C2: expr): $ sty G h A f (Π B, C) $ > $ ⟦ₜ G ⊢ a : B ⟧ $ > $ ⟮ [ #0 ↦ a ] C = C2 ⟯ $ > $ sty G h A (f @ a) C2 $;

--| The spec's axiom `cwf_pi` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem cwf_pi (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2: expr) (u: lvl): $ ⦃ d + np = k ⦄ $ > $ closed k A $ > $ sinst D 0 n k A A2 $ > $ ⟦ₜ Ctx ⊢ A2 : Sort u ⟧ $ > $ ulevel l u $ > $ cwf D n np l i (Ctx ▷ A2) (s d) B $ > $ cwf D n np l i Ctx d (Π A, B) $;

--| The spec's axiom `cwf_pi_rec` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem cwf_pi_rec (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2 B2: expr) (u: lvl): $ ⦃ d + np = k ⦄ $ > $ sinst D 0 n k A A2 $ > $ ⟦ₜ Ctx ⊢ A2 : Sort u ⟧ $ > $ ulevel l u $ > $ ipos D n np d A $ > $ ⟮ [ #0 ↦ Sort lz ] B = B2 ⟯ $ > $ ⟮₀ B2 ↑ 1 = B ⟯ $ > $ cwf D n np l i (Ctx ▷ A2) (s d) B $ > $ cwf D n np l i Ctx d (Π A, B) $;

--| The spec's axiom `cwf_res` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem cwf_res (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (K K2: expr) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (R R2 S: expr): $ indapp D n np d K i $ > $ ⦃ d + np = k ⦄ $ > $ sinst D 0 n k K K2 $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ ⌊Π P, F = R ⌋ $ > $ ⟮₀ R ↑ k = R2 ⟯ $ > $ sty Ctx (ind_ty D i) R2 K2 S $ > $ cwf D n np l i Ctx d K $;

--| The spec's axiom `ctors_wf_nil` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem ctors_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ ctors_wf D n np l i Ctx cnil $;

--| The spec's axiom `ctors_wf_cons` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem ctors_wf_cons (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (K: expr) (C: ctors) (b: blk) (P: ctx) (T: tys) (R: expr): $ ind_data D b P T $ > $ ⌊Π P, K = R ⌋ $ > $ closed n R $ > $ cwf D n np l i Ctx 0 K $ > $ ctors_wf D n np l i Ctx C $ > $ ctors_wf D n np l i Ctx (ccons K C) $;

--| The spec's axiom `tys_wf_nil` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem tys_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ tys_wf D n np l i Ctx tnil $;

--| The spec's axiom `tys_wf_cons` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem tys_wf_cons (D: ind) (n np: nat) (l l2: lvl) (i k: nat) (Ctx: ctx) (F: expr) (C: ctors) (T: tys): $ isort F k l2 $ > $ l2 ≈ l $ > $ ctors_wf D n np l i Ctx C $ > $ tys_wf D n np l (s i) Ctx T $ > $ tys_wf D n np l i Ctx (tcons F C T) $;

--| The spec's axiom `ctx_wf_nil` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem ctx_wf_nil (G: ctx): $ ctx_wf G [] $;

--| The spec's axiom `ctx_wf_cons` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem ctx_wf_cons (G P G2: ctx) (A: expr) (u: lvl): $ ctx_wf G P $ > $ ⌊ G ++ P = G2 ⌋ $ > $ ⟦ₜ G2 ⊢ A : Sort u ⟧ $ > $ ctx_wf G (P ▷ A) $;

--| The spec's axiom `tys_ty_nil` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem tys_ty_nil (Ctx: ctx): $ tys_ty Ctx tnil $;

--| The spec's axiom `tys_ty_cons` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem tys_ty_cons (Ctx: ctx) (F: expr) (C: ctors) (T: tys) (u l: lvl) (k: nat): $ isort F k l $ > $ ⟦ₜ Ctx ⊢ F : Sort u ⟧ $ > $ tys_ty Ctx T $ > $ tys_ty Ctx (tcons F C T) $;

--| The spec's axiom `tys_ok_i` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem tys_ok_i (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys): $ ind_data D b P T $ > $ tys_closed P T $ > $ ctx_wf G P $ > $ ⌊ G ++ P = G2 ⌋ $ > $ tys_ty G2 T $ > $ tys_ok G D $;

--| The spec's axiom `nst_ty_i` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem nst_ty_i (G G2: ctx) (D I: ind) (b bi_v: blk) (P Pi: ctx) (T Ti: tys) (np n m: nat) (X X1 Fi RI S: expr) (Ci: ctors): $ ind_data D b P T $ > $ ⌊ G ++ P = G2 ⌋ $ > $ ind_arity D np n m $ > $ sinst D 0 n np X X1 $ > $ closed np X1 $ > $ ind_data I bi_v Pi Ti $ > $ nth_ty Ti 0 Fi Ci $ > $ ⌊Π Pi, Fi = RI ⌋ $ > $ sty G2 (ind_ty I 0) RI X1 S $ > $ nst_ty G D I X $;

--| The spec's axiom `nst_ok_nil` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nst_ok_nil (G: ctx) (D: ind) (j: nat): $ nst_ok G D j [] $;

--| The spec's axiom `nst_ok_cons` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nst_ok_cons (G: ctx) (D I: ind) (j j2 npi ni mi ni0: nat) (X: expr) (N2 N3 NI: ctx): $ spine (ind_ty I 0) X npi $ > $ ind_wf G I $ > $ ind_arity I npi ni mi $ > $ ind_nested I NI $ > $ ndecl NI ni ni0 $ > $ 0 < ni0 $ > $ nst_ty G D I X $ > $ nst_group G D I X j 0 ni0 (X :: N2) N3 $ > $ ⦃ j + ni0 = j2 ⦄ $ > $ nst_ok G D j2 N3 $ > $ nst_ok G D j (X :: N2) $;

--| The spec's axiom `ind_wf_i` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem ind_wf_i (G G2: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (np n m k n0: nat) (l: lvl) (F: expr) (C: ctors): $ tys_ok G D $ > $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ ⌊ G ++ P = G2 ⌋ $ > $ nth_ty T 0 F C $ > $ isort F k l $ > $ tys_wf D n np l 0 G2 T $ > $ ind_nested D N $ > $ ndecl N n n0 $ > $ nst_ok G D n0 N $ > $ ind_wf G D $;

--| The spec's axiom `elim_prop` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem elim_prop (G: ctx) (D: ind) (v: lvl): $ v ≈ lz $ > $ elim_ok G D v $;

--| The spec's axiom `elim_large` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem elim_large (G: ctx) (D: ind) (v: lvl): $ large G D $ > $ elim_ok G D v $;

--| The spec's axiom `large_nz` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem large_nz (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (k: nat) (l: lvl): $ ind_data D b P T $ > $ nth_ty T 0 F C $ > $ isort F k l $ > $ ls lz ⊔ l ≈ l $ > $ large G D $;

--| The spec's axiom `large_empty` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem large_empty (G: ctx) (D: ind) (b: blk) (P: ctx) (F: expr): $ ind_data D b P (tcons F cnil tnil) $ > $ large G D $;

--| The spec's axiom `large_single` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem large_single (G G2: ctx) (D: ind) (b: blk) (P: ctx) (F K: expr) (np: nat): $ ind_data D b P (tcons F (ccons K cnil) tnil) $ > $ ⌊| P | = np ⌋ $ > $ ⌊ G ++ P = G2 ⌋ $ > $ fir D np G2 0 K $ > $ large G D $;

--| The spec's axiom `fir_res` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem fir_res (D: ind) (np: nat) (Ctx: ctx) (d: nat) (K: expr): $ indapp D 1 np d K 0 $ > $ fir D np Ctx d K $;

--| The spec's axiom `fir_arg` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem fir_arg (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr): $ leaf_has 0 B $ > $ ⦃ d + np = k ⦄ $ > $ sinst D 0 1 k A A2 $ > $ fir D np (Ctx ▷ A2) (s d) B $ > $ fir D np Ctx d (Π A, B) $;

--| The spec's axiom `fir_prop` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem fir_prop (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr): $ ⦃ d + np = k ⦄ $ > $ sinst D 0 1 k A A2 $ > $ ⟦ₜ Ctx ⊢ A2 : Prop ⟧ $ > $ fir D np (Ctx ▷ A2) (s d) B $ > $ fir D np Ctx d (Π A, B) $;

--| The spec's axiom `proj_ok_sort` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem proj_ok_sort (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i: nat) (F: expr) (C: ctors) (l: lvl): $ ind_data D b P T $ > $ nth_ty T j F C $ > $ isort F 0 l $ > $ ls lz ⊔ l ≈ l $ > $ proj_ok G D j i $;

--| The spec's axiom `proj_ok_prop` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem proj_ok_prop (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K: expr) (C: ctors): $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ ⌊ G ++ P = G2 ⌋ $ > $ nth_ty T j F C $ > $ nth_ctor C 0 K $ > $ fprops D n np G2 0 (s i) K $ > $ proj_ok G D j i $;

--| The spec's axiom `fprops_z` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem fprops_z (D: ind) (n np: nat) (Ctx: ctx) (d: nat) (K: expr): $ fprops D n np Ctx d 0 K $;

--| The spec's axiom `fprops_s` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem fprops_s (D: ind) (n np: nat) (Ctx: ctx) (d cnt k: nat) (A A2 B: expr): $ ⦃ d + np = k ⦄ $ > $ sinst D 0 n k A A2 $ > $ ⟦ₜ Ctx ⊢ A2 : Prop ⟧ $ > $ fprops D n np (Ctx ▷ A2) (s d) cnt B $ > $ fprops D n np Ctx d (s cnt) (Π A, B) $;

--| The spec's axiom `add_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem add_eqs_i (G: ctx) (f: expr): $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ #0 @ nat_zero ≡ #0 : ℕ ⟧ $ > $ ⟦ G ▷ ℕ ▷ ℕ ⊢ f @ #1 @ (nat_succ @ #0) ≡ nat_succ @ (f @ #1 @ #0) : ℕ ⟧ $ > $ add_eqs G f $;

--| The spec's axiom `pred_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem pred_eqs_i (G: ctx) (p: expr): $ closed 0 p $ > $ ⟦ₜ G ⊢ p : Π ℕ, ℕ ⟧ $ > $ ⟦ G ⊢ p @ nat_zero ≡ nat_zero : ℕ ⟧ $ > $ ⟦ G ▷ ℕ ⊢ p @ (nat_succ @ #0) ≡ #0 : ℕ ⟧ $ > $ pred_eqs G p $;

--| The spec's axiom `sub_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem sub_eqs_i (G: ctx) (f p: expr): $ pred_eqs G p $ > $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ #0 @ nat_zero ≡ #0 : ℕ ⟧ $ > $ ⟦ G ▷ ℕ ▷ ℕ ⊢ f @ #1 @ (nat_succ @ #0) ≡ p @ (f @ #1 @ #0) : ℕ ⟧ $ > $ sub_eqs G f p $;

--| The spec's axiom `mul_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem mul_eqs_i (G: ctx) (f fa: expr): $ add_eqs G fa $ > $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ #0 @ nat_zero ≡ nat_zero : ℕ ⟧ $ > $ ⟦ G ▷ ℕ ▷ ℕ ⊢ f @ #1 @ (nat_succ @ #0) ≡ fa @ (f @ #1 @ #0) @ #1 : ℕ ⟧ $ > $ mul_eqs G f fa $;

--| The spec's axiom `pow_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem pow_eqs_i (G: ctx) (f fm fa: expr): $ mul_eqs G fm fa $ > $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ #0 @ nat_zero ≡ nat_succ @ nat_zero : ℕ ⟧ $ > $ ⟦ G ▷ ℕ ▷ ℕ ⊢ f @ #1 @ (nat_succ @ #0) ≡ fm @ (f @ #1 @ #0) @ #1 : ℕ ⟧ $ > $ pow_eqs G f fm fa $;

--| The spec's axiom `beq_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem beq_eqs_i (G: ctx) (f B t u: expr): $ closed 0 f $ > $ closed 0 B $ > $ closed 0 t $ > $ closed 0 u $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, B ⟧ $ > $ ⟦ G ⊢ f @ nat_zero @ nat_zero ≡ t : B ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ nat_zero @ (nat_succ @ #0) ≡ u : B ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ (nat_succ @ #0) @ nat_zero ≡ u : B ⟧ $ > $ ⟦ G ▷ ℕ ▷ ℕ ⊢ f @ (nat_succ @ #1) @ (nat_succ @ #0) ≡ f @ #1 @ #0 : B ⟧ $ > $ beq_eqs G f B t u $;

--| The spec's axiom `ble_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem ble_eqs_i (G: ctx) (f B t u: expr): $ closed 0 f $ > $ closed 0 B $ > $ closed 0 t $ > $ closed 0 u $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, B ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ nat_zero @ #0 ≡ t : B ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ (nat_succ @ #0) @ nat_zero ≡ u : B ⟧ $ > $ ⟦ G ▷ ℕ ▷ ℕ ⊢ f @ (nat_succ @ #1) @ (nat_succ @ #0) ≡ f @ #1 @ #0 : B ⟧ $ > $ ble_eqs G f B t u $;

--| The spec's axiom `shl_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem shl_eqs_i (G: ctx) (f fm fa: expr): $ mul_eqs G fm fa $ > $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ #0 @ nat_zero ≡ #0 : ℕ ⟧ $ > $ ⟦ G ▷ ℕ ▷ ℕ ⊢ f @ #1 @ (nat_succ @ #0) ≡ f @ (fm @ lit (bd0 (bd1 b0)) @ #1) @ #0 : ℕ ⟧ $ > $ shl_eqs G f fm fa $;

--| The spec's axiom `shr_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem shr_eqs_i (G: ctx) (f fd: expr): $ closed 0 f $ > $ closed 0 fd $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ G ▷ ℕ ⊢ f @ #0 @ nat_zero ≡ #0 : ℕ ⟧ $ > $ ⟦ G ▷ ℕ ▷ ℕ ⊢ f @ #1 @ (nat_succ @ #0) ≡ fd @ (f @ #1 @ #0) @ lit (bd0 (bd1 b0)) : ℕ ⟧ $ > $ shr_eqs G f fd $;

--| The spec's axiom `bvar` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem bvar (G: ctx) (i: nat) (A: expr): $ ⟮ₖ G ∋ #i : A ⟯ $ > $ ⟦ₜ G ⊢ #i : A ⟧ $;

--| The spec's axiom `symm` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem symm (G: ctx) (e e2 A: expr): $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e2 ≡ e : A ⟧ $;

--| The spec's axiom `trans` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem trans (G: ctx) (e1 e2 e3 A: expr): $ ⟦ G ⊢ e1 ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e2 ≡ e3 : A ⟧ $ > $ ⟦ G ⊢ e1 ≡ e3 : A ⟧ $;

--| The spec's axiom `sortDF` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem sortDF (G: ctx) (l l2: lvl): $ l ≈ l2 $ > $ ⟦ G ⊢ Sort l ≡ Sort l2 : Sort (ls l) ⟧ $;

--| The spec's axiom `appDF` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem appDF (G: ctx) (f f2 A B a a2 R: expr): $ ⟦ G ⊢ f ≡ f2 : Π A, B ⟧ $ > $ ⟦ G ⊢ a ≡ a2 : A ⟧ $ > $ ⟮ [ #0 ↦ a ] B = R ⟯ $ > $ ⟦ G ⊢ f @ a ≡ f2 @ a2 : R ⟧ $;

--| The spec's axiom `lamDF` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem lamDF (G: ctx) (u: lvl) (A A2 b b2 B: expr): $ ⟦ G ⊢ A ≡ A2 : Sort u ⟧ $ > $ ⟦ G ▷ A ⊢ b ≡ b2 : B ⟧ $ > $ ⟦ G ⊢ λ A, b ≡ λ A2, b2 : Π A, B ⟧ $;

--| The spec's axiom `forallEDF` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem forallEDF (G: ctx) (u v: lvl) (A A2 B B2: expr): $ ⟦ G ⊢ A ≡ A2 : Sort u ⟧ $ > $ ⟦ G ▷ A ⊢ B ≡ B2 : Sort v ⟧ $ > $ ⟦ G ⊢ Π A, B ≡ Π A2, B2 : Sort (limax u v) ⟧ $;

--| The spec's axiom `defeqDF` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem defeqDF (G: ctx) (u: lvl) (A B e e2: expr): $ ⟦ G ⊢ A ≡ B : Sort u ⟧ $ > $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e ≡ e2 : B ⟧ $;

--| The spec's axiom `beta` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem beta (G: ctx) (A e B a r R: expr): $ ⟦ₜ G ▷ A ⊢ e : B ⟧ $ > $ ⟦ₜ G ⊢ a : A ⟧ $ > $ ⟮ [ #0 ↦ a ] e = r ⟯ $ > $ ⟮ [ #0 ↦ a ] B = R ⟯ $ > $ ⟦ G ⊢ (λ A, e) @ a ≡ r : R ⟧ $;

--| The spec's axiom `eta` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments read
--| as the model's definitions.
theorem eta (G: ctx) (A B e e1: expr): $ ⟦ₜ G ⊢ e : Π A, B ⟧ $ > $ ⟮₀ e ↑ 1 = e1 ⟯ $ > $ ⟦ G ⊢ λ A, e1 @ #0 ≡ e : Π A, B ⟧ $;

--| The spec's axiom `proofIrrel` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem proofIrrel (G: ctx) (p h h2: expr): $ ⟦ₜ G ⊢ p : Prop ⟧ $ > $ ⟦ₜ G ⊢ h : p ⟧ $ > $ ⟦ₜ G ⊢ h2 : p ⟧ $ > $ ⟦ G ⊢ h ≡ h2 : p ⟧ $;

--| The spec's axiom `instDF` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem instDF (k: nat) (G0 G1 G: ctx) (A0 a e e2 A r r2 R: expr): $ ⟦ₜ G0 ⊢ a : A0 ⟧ $ > $ cinst k G0 A0 a G1 G $ > $ ⟦ G1 ⊢ e ≡ e2 : A ⟧ $ > $ ⟮ [ #k ↦ a ] e = r ⟯ $ > $ ⟮ [ #k ↦ a ] e2 = r2 ⟯ $ > $ ⟮ [ #k ↦ a ] A = R ⟯ $ > $ ⟦ G ⊢ r ≡ r2 : R ⟧ $;

--| The spec's axiom `weakDF` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem weakDF (n: nat) (G G2: ctx) (e e2 A r r2 R: expr): $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ cext n G G2 $ > $ ⟮₀ e ↑ n = r ⟯ $ > $ ⟮₀ e2 ↑ n = r2 ⟯ $ > $ ⟮₀ A ↑ n = R ⟯ $ > $ ⟦ G2 ⊢ r ≡ r2 : R ⟧ $;

--| The spec's axiom `eeqv_df` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem eeqv_df (G: ctx) (e e2 A: expr): $ ⟦ₜ G ⊢ e : A ⟧ $ > $ eeqv e e2 $ > $ ⟦ G ⊢ e ≡ e2 : A ⟧ $;

--| The spec's axiom `quot_ty` (`spec/lean-quot.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem quot_ty (G: ctx) (u: lvl): $ ⟦ₜ G ⊢ quot u : Π Sort u, Π (Π #0, Π #1, Prop), Sort u ⟧ $;

--| The spec's axiom `quot_mk_ty` (`spec/lean-quot.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem quot_mk_ty (G: ctx) (u: lvl): $ ⟦ₜ G ⊢ quot_mk u : Π Sort u, Π (Π #0, Π #1, Prop), Π #1, quot u @ #2 @ #1 ⟧ $;

--| The spec's axiom `quot_lift_ty` (`spec/lean-quot.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem quot_lift_ty (G: ctx) (u v: lvl): $ ⟦ₜ G ⊢ quot_lift u v : Π Sort u, Π (Π #0, Π #1, Prop), Π Sort v, Π (Π #2, #1), Π (Π #3, Π #4, Π (#4 @ #1 @ #0), ind_ty (eq_D v) 0 @ #4 @ (#3 @ #2) @ (#3 @ #1)), Π (quot u @ #4 @ #3), #3 ⟧ $;

--| The spec's axiom `quot_ind_ty` (`spec/lean-quot.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem quot_ind_ty (G: ctx) (u: lvl): $ ⟦ₜ G ⊢ quot_ind u : Π Sort u, Π (Π #0, Π #1, Prop), Π (Π (quot u @ #1 @ #0), Prop), Π (Π #2, #1 @ (quot_mk u @ #3 @ #2 @ #0)), Π (quot u @ #3 @ #2), #2 @ #0 ⟧ $;

theorem quot_lift_mk_sty (G: ctx) (u v: lvl) (x1 x2 x3 x4 x5: expr) (v1: lvl) (y1 y2 a T: expr): $ sty G (quot_lift u v) (pi (srt u) (pi (pi (bvar nz) (pi (bvar n1) Prop)) (pi (srt v) (pi (pi (bvar n2) (bvar n1)) (pi (pi (bvar n3) (pi (bvar n4) (pi (app (app (bvar n4) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D v) nz) (bvar n4)) (app (bvar n3) (bvar n2))) (app (bvar n3) (bvar n1)))))) (pi (app (app (quot u) (bvar n4)) (bvar n3)) (bvar n3))))))) (app (app (app (app (app (app (quot_lift u v) x1) x2) x3) x4) x5) (app (app (app (quot_mk v1) y1) y2) a)) T $ > $ ty G a x1 $ > $ deq G (app (app (app (app (app (app (quot_lift u v) x1) x2) x3) x4) x5) (app (app (app (quot_mk v1) y1) y2) a)) (app x4 a) T $;

--| The spec's axiom `quot_lift_mk` (`spec/lean-quot.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem quot_lift_mk (u v: lvl): $ ⟦ [] ▷ Sort u ▷ (Π #0, Π #1, Prop) ▷ Sort v ▷ (Π #2, #1) ▷ (Π #3, Π #4, Π (#4 @ #1 @ #0), ind_ty (eq_D v) 0 @ #4 @ (#3 @ #2) @ (#3 @ #1)) ▷ #4 ⊢ quot_lift u v @ #5 @ #4 @ #3 @ #2 @ #1 @ (quot_mk u @ #5 @ #4 @ #0) ≡ #2 @ #0 : #3 ⟧ $;

--| The spec's axiom `lit_zero` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem lit_zero (G: ctx): $ ⟦ G ⊢ lit b0 ≡ ind_ctor nat_D 0 0 : ind_ty nat_D 0 ⟧ $;

--| The spec's axiom `lit_succ` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem lit_succ (G: ctx) (a b: bin): $ ⟪ₛ a + 1 = b ⟫ $ > $ ⟦ G ⊢ lit b ≡ ind_ctor nat_D 0 1 @ lit a : ind_ty nat_D 0 ⟧ $;

--| The spec's axiom `nat_add_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_add_lit (G: ctx) (f: expr) (a b c: bin): $ add_eqs G f $ > $ ⟪ a + b = c ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;

--| The spec's axiom `nat_sub_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_sub_lit (G: ctx) (f p: expr) (a b c: bin): $ sub_eqs G f p $ > $ ⟪ c + b = a ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;

--| The spec's axiom `nat_sub_lit0` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_sub_lit0 (G: ctx) (f p: expr) (a b c: bin): $ sub_eqs G f p $ > $ ⟪ a + c = b ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit b0 : ℕ ⟧ $;

--| The spec's axiom `nat_mul_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_mul_lit (G: ctx) (f fa: expr) (a b c: bin): $ mul_eqs G f fa $ > $ ⟪ₘ a * b = c ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;

--| The spec's axiom `nat_pow_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_pow_lit (G: ctx) (f fm fa: expr) (a b c: bin): $ pow_eqs G f fm fa $ > $ ⟪ₚ a ^ b = c ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;

--| The spec's axiom `nat_beq_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_beq_lit (G: ctx) (f B t u: expr) (a: bin): $ beq_eqs G f B t u $ > $ ⟦ G ⊢ f @ lit a @ lit a ≡ t : B ⟧ $;

--| The spec's axiom `nat_beq_lit_lt` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_beq_lit_lt (G: ctx) (f B t u: expr) (a b c: bin): $ beq_eqs G f B t u $ > $ ⟪₁ a + c + 1 = b ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ u : B ⟧ $;

--| The spec's axiom `nat_beq_lit_gt` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_beq_lit_gt (G: ctx) (f B t u: expr) (a b c: bin): $ beq_eqs G f B t u $ > $ ⟪₁ b + c + 1 = a ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ u : B ⟧ $;

--| The spec's axiom `nat_ble_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_ble_lit (G: ctx) (f B t u: expr) (a b c: bin): $ ble_eqs G f B t u $ > $ ⟪ a + c = b ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ t : B ⟧ $;

--| The spec's axiom `nat_ble_lit_gt` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_ble_lit_gt (G: ctx) (f B t u: expr) (a b c: bin): $ ble_eqs G f B t u $ > $ ⟪₁ b + c + 1 = a ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ u : B ⟧ $;

--| The spec's axiom `nat_shl_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_shl_lit (G: ctx) (f fm fa: expr) (a b p c: bin): $ shl_eqs G f fm fa $ > $ ⟪ₚ bd0 (bd1 b0) ^ b = p ⟫ $ > $ ⟪ₘ a * p = c ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;

--| The spec's axiom `nat_shr_lit_z` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_shr_lit_z (G: ctx) (f fd: expr) (a: bin): $ shr_eqs G f fd $ > $ ⟦ G ⊢ f @ lit a @ lit b0 ≡ lit a : ℕ ⟧ $;

--| The spec's axiom `nat_shr_lit_s` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_shr_lit_s (G: ctx) (f fd: expr) (a b b2 c c2: bin): $ shr_eqs G f fd $ > $ ⟪ₛ b + 1 = b2 ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $ > $ ⟦ G ⊢ fd @ lit c @ lit (bd0 (bd1 b0)) ≡ lit c2 : ℕ ⟧ $ > $ ⟦ G ⊢ f @ lit a @ lit b2 ≡ lit c2 : ℕ ⟧ $;

--| The spec's axiom `inh_i` (`spec/lean-core.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem inh_i (G: ctx) (e A: expr): $ ⟦ₜ G ⊢ e : A ⟧ $ > $ inh G A $;

-- --------------------------------------------------------------------------
-- The rules of the inductive types
-- --------------------------------------------------------------------------

--| The spec's axiom `ind_ty_ty` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem ind_ty_ty (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (i: nat) (F R: expr) (C: ctors): $ tys_ok G D $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ ⌊Π P, F = R ⌋ $ > $ ⟦ₜ G ⊢ ind_ty D i : R ⟧ $;

--| The spec's axiom `ind_ctor_ty` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem ind_ctor_ty (G: ctx) (D: ind) (i c: nat) (R: expr): $ ind_wf G D $ > $ ctor_ty D i c R $ > $ ⟦ₜ G ⊢ ind_ctor D i c : R ⟧ $;

--| The spec's axiom `ind_rec_ty` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem ind_rec_ty (G: ctx) (D: ind) (N: ctx) (i: nat) (v: lvl) (R0 R: expr): $ ind_wf G D $ > $ elim_ok G D v $ > $ rec_ty D v i R0 $ > $ ind_nested D N $ > $ rst D N R0 R $ > $ ⟦ₜ G ⊢ ind_rec D i v : R ⟧ $;

--| The spec's axiom `proj_ty` (`spec/lean-ind.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem proj_ty (G: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (j i np: nat) (e e2 S A A1 A2 R: expr): $ ⟦ G ⊢ e ≡ e2 : S ⟧ $ > $ spine (ind_ty D j) S np $ > $ ind_wf G D $ > $ ind_data D b P T $ > $ struct_like D j $ > $ proj_ok G D j i $ > $ ⌊| P | = np ⌋ $ > $ field_ty D j i A $ > $ ind_nested D N $ > $ rst D N A A2 $ > $ pinst i S A2 A1 $ > $ qinst b e i 0 A1 R $ > $ ⟦ G ⊢ proj b i e ≡ proj b i e2 : R ⟧ $;



-- The relations of the division-like literal operations (S1)

--| The spec's `divmod_eqs`, over the judgments that hold in the model.
def divmod_eqs (G: ctx) (e1 e2 e3 e4: expr): wff = $ divmod_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 $;
--| The spec's `gcd_eqs`, over the judgments that hold in the model.
def gcd_eqs (G: ctx) (e1 e2 e3 e4 e5: expr): wff = $ gcd_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 e5 $;
--| The spec's `land_eqs`, over the judgments that hold in the model.
def land_eqs (G: ctx) (e1 e2 e3 e4 e5: expr): wff = $ land_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 e5 $;
--| The spec's `lor_eqs`, over the judgments that hold in the model.
def lor_eqs (G: ctx) (e1 e2 e3 e4 e5: expr): wff = $ lor_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 e5 $;
--| The spec's `xor_eqs`, over the judgments that hold in the model.
def xor_eqs (G: ctx) (e1 e2 e3 e4 e5: expr): wff = $ xor_eqs_j (jmod (mcv hfin)) G e1 e2 e3 e4 e5 $;

--| The spec's axiom `divmod_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem divmod_eqs_i (G: ctx) (fd fm fmul fadd h1 h2 h3: expr): $ mul_eqs G fmul fadd $ > $ closed 0 fd $ > $ closed 0 fm $ > $ ⟦ₜ G ⊢ fd : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ₜ G ⊢ fm : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ₜ G ⊢ h1 : Π ℕ, Π ℕ, nat_eq (fadd @ (fmul @ #0 @ (fd @ #1 @ #0)) @ (fm @ #1 @ #0)) #1 ⟧ $ > $ ⟦ₜ G ⊢ h2 : Π ℕ, Π ℕ, Π (nat_lt lit0 #0), nat_lt (fm @ #2 @ #1) #1 ⟧ $ > $ ⟦ₜ G ⊢ h3 : Π ℕ, nat_eq (fd @ #0 @ lit0) lit0 ⟧ $ > $ divmod_eqs G fd fm fmul fadd $;

--| The spec's axiom `gcd_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem gcd_eqs_i (G: ctx) (f fd fm fmul fadd h1 h2: expr): $ divmod_eqs G fd fm fmul fadd $ > $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ₜ G ⊢ h1 : Π ℕ, nat_eq (f @ lit0 @ #0) #0 ⟧ $ > $ ⟦ₜ G ⊢ h2 : Π ℕ, Π ℕ, nat_eq (f @ (nat_succ @ #1) @ #0) (f @ (fm @ #0 @ (nat_succ @ #1)) @ (nat_succ @ #1)) ⟧ $ > $ gcd_eqs G f fd fm fmul fadd $;

--| The spec's axiom `land_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem land_eqs_i (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs G fd fm fmul fadd $ > $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ₜ G ⊢ h : Π ℕ, Π ℕ, nat_eq (f @ #1 @ #0) (fadd @ (fadd @ (f @ (fd @ #1 @ lit2) @ (fd @ #0 @ lit2)) @ (f @ (fd @ #1 @ lit2) @ (fd @ #0 @ lit2))) @ (fd @ (fadd @ (fm @ #1 @ lit2) @ (fm @ #0 @ lit2)) @ lit2)) ⟧ $ > $ land_eqs G f fd fm fmul fadd $;

--| The spec's axiom `lor_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem lor_eqs_i (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs G fd fm fmul fadd $ > $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ₜ G ⊢ h : Π ℕ, Π ℕ, nat_eq (f @ #1 @ #0) (fadd @ (fadd @ (f @ (fd @ #1 @ lit2) @ (fd @ #0 @ lit2)) @ (f @ (fd @ #1 @ lit2) @ (fd @ #0 @ lit2))) @ (fd @ (fadd @ (fadd @ (fm @ #1 @ lit2) @ (fm @ #0 @ lit2)) @ lit1) @ lit2)) ⟧ $ > $ lor_eqs G f fd fm fmul fadd $;

--| The spec's axiom `xor_eqs_i` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the judgments
--| read as the model's definitions.
theorem xor_eqs_i (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs G fd fm fmul fadd $ > $ closed 0 f $ > $ ⟦ₜ G ⊢ f : Π ℕ, Π ℕ, ℕ ⟧ $ > $ ⟦ₜ G ⊢ h : Π ℕ, Π ℕ, nat_eq (f @ #1 @ #0) (fadd @ (fadd @ (f @ (fd @ #1 @ lit2) @ (fd @ #0 @ lit2)) @ (f @ (fd @ #1 @ lit2) @ (fd @ #0 @ lit2))) @ (fm @ (fadd @ (fm @ #1 @ lit2) @ (fm @ #0 @ lit2)) @ lit2)) ⟧ $ > $ xor_eqs G f fd fm fmul fadd $;


-- The relations of the division-like literal operations (S1)



--| The spec's axiom `nat_div_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_div_lit (G: ctx) (fd fm fmul fadd: expr) (a b q m r x: bin): $ divmod_eqs G fd fm fmul fadd $ > $ ⟪ₘ b * q = m ⟫ $ > $ ⟪ m + r = a ⟫ $ > $ ⟪₁ r + x + 1 = b ⟫ $ > $ ⟦ G ⊢ fd @ lit a @ lit b ≡ lit q : ℕ ⟧ $;

--| The spec's axiom `nat_div_lit0` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_div_lit0 (G: ctx) (fd fm fmul fadd: expr) (a: bin): $ divmod_eqs G fd fm fmul fadd $ > $ ⟦ G ⊢ fd @ lit a @ lit0 ≡ lit0 : ℕ ⟧ $;

--| The spec's axiom `nat_mod_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_mod_lit (G: ctx) (fd fm fmul fadd: expr) (a b q m r x: bin): $ divmod_eqs G fd fm fmul fadd $ > $ ⟪ₘ b * q = m ⟫ $ > $ ⟪ m + r = a ⟫ $ > $ ⟪₁ r + x + 1 = b ⟫ $ > $ ⟦ G ⊢ fm @ lit a @ lit b ≡ lit r : ℕ ⟧ $;

--| The spec's axiom `nat_mod_lit0` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_mod_lit0 (G: ctx) (fd fm fmul fadd: expr) (a: bin): $ divmod_eqs G fd fm fmul fadd $ > $ ⟦ G ⊢ fm @ lit a @ lit0 ≡ lit a : ℕ ⟧ $;

--| The spec's axiom `nat_gcd_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_gcd_lit (G: ctx) (f fd fm fmul fadd: expr) (a b g p2 q x y m n: bin): $ gcd_eqs G f fd fm fmul fadd $ > $ ⟪ₘ g * p2 = a ⟫ $ > $ ⟪ₘ g * q = b ⟫ $ > $ ⟪ₘ x * a = m ⟫ $ > $ ⟪ₘ y * b = n ⟫ $ > $ ⟪ n + g = m ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit g : ℕ ⟧ $;

--| The spec's axiom `nat_gcd_lit2` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_gcd_lit2 (G: ctx) (f fd fm fmul fadd: expr) (a b g p2 q x y m n: bin): $ gcd_eqs G f fd fm fmul fadd $ > $ ⟪ₘ g * p2 = a ⟫ $ > $ ⟪ₘ g * q = b ⟫ $ > $ ⟪ₘ x * a = m ⟫ $ > $ ⟪ₘ y * b = n ⟫ $ > $ ⟪ m + g = n ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit g : ℕ ⟧ $;

--| The spec's axiom `nat_land_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_land_lit (G: ctx) (f fd fm fmul fadd: expr) (a b c: bin): $ land_eqs G f fd fm fmul fadd $ > $ ⟪ₐ a &&& b = c ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;

--| The spec's axiom `nat_lor_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_lor_lit (G: ctx) (f fd fm fmul fadd: expr) (a b c: bin): $ lor_eqs G f fd fm fmul fadd $ > $ ⟪ₒ a ||| b = c ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;

--| The spec's axiom `nat_xor_lit` (`spec/lean-lit.mm0`) as a theorem of the model: the same statement, with the
--| judgments read as the model's definitions.
theorem nat_xor_lit (G: ctx) (f fd fm fmul fadd: expr) (a b c: bin): $ xor_eqs G f fd fm fmul fadd $ > $ ⟪ₓ a ^^^ b = c ⟫ $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;
