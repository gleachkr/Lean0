-- model-meta.mm0: the metatheory of the denotation (layer D of the reduction,
-- audit §11): what closedness, lifting and substitution do to the value of an
-- expression, for every derivable atom of `closed`, `lift` and `inst` (every
-- clause, the admissible `lift_closed` and `inst_closed` included) and every
-- hook `M`. A valuation `r ∈ fseq u` lists the values of `#0`, `#1`, ...; the
-- statements cut it with `scat`:
--   closed (D3)  the value depends on `r` only below `k`;
--   lift (D1)    `lift n k e e2`: `e2` at `p ++ q ++ s` is `e` at `p ++ s`, for
--                `p` of length `k` and `q` of length `n`;
--   inst (D2)    `inst k e a e2`: `e2` at `p ++ s` is `e` at
--                `p ++ (x :: s)`, for `p` of length `k` and `x` the value of
--                `a` at `s`;
-- first for the atoms over trees (`lrel_*_sem`, which the inductions need),
-- then for the spec's relations (`*_den`); and for contexts (D5), what
-- `lookup` says of a valuation satisfying a context and what valuations satisfy
-- the contexts `cext` and `cinst` make. Off the valuations (`r ∉ fseq u`)
-- an expression node's value is `∅`, which settles the binders' bodies at
-- arguments outside `u` (`dt_out`, and the trees of derivable atoms are such
-- nodes: `lrel_*_out`). Imports model-den.mm0; proofs in model-meta.auf.

import "model-den.mm0";

-- --------------------------------------------------------------------------
-- Expression nodes off the valuations
-- --------------------------------------------------------------------------

--| An expression node's value at a class that is not a valuation is `∅`.
theorem dt_out (G: hyps) (M K S W R: class) (u: set):
  $ G ⇒ K ∈ kstr $ > $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ ¬ R ∈ fseq u $ >
  $ G ⇒ dt u M ⟨ K , S ⟩ W R = ∅ $;
--| `dt_out` for a tree named as a node.
theorem dt_out_tree (G: hyps) (M W R K S: class) (u t: set):
  $ G ⇒ t ∊ trees ω $ > $ G ⇒ t = ⟨ K , S ⟩ $ > $ G ⇒ K ∈ kstr $ > $ G ⇒ isset S $ > $ G ⇒ ¬ R ∈ fseq u $ >
  $ G ⇒ dt u M t W R = ∅ $;
--| The expressions of derivable `closed`, `lift` and `inst` atoms are
--| expression nodes, so the same holds of them.
theorem lrel_closed_out (G: hyps) (M W R: class) (u t1 t2: set):
  $ G ⇒ ra_closed t1 t2 ∈ lrel $ > $ G ⇒ ¬ R ∈ fseq u $ > $ G ⇒ dt u M t2 W R = ∅ $;
theorem lrel_lift_out_l (G: hyps) (M W R: class) (u t1 t2 t3 t4: set):
  $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ ¬ R ∈ fseq u $ > $ G ⇒ dt u M t3 W R = ∅ $;
theorem lrel_lift_out_r (G: hyps) (M W R: class) (u t1 t2 t3 t4: set):
  $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ ¬ R ∈ fseq u $ > $ G ⇒ dt u M t4 W R = ∅ $;
theorem lrel_inst_out_l (G: hyps) (M W R: class) (u t1 t2 t3 t4: set):
  $ G ⇒ ra_inst t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ ¬ R ∈ fseq u $ > $ G ⇒ dt u M t2 W R = ∅ $;
theorem lrel_inst_out_r (G: hyps) (M W R: class) (u t1 t2 t3 t4: set):
  $ G ⇒ ra_inst t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ ¬ R ∈ fseq u $ > $ G ⇒ dt u M t4 W R = ∅ $;

-- --------------------------------------------------------------------------
-- Closedness (D3)
-- --------------------------------------------------------------------------

--| An expression closed below `k` has the same value at valuations that agree
--| below `k`.
--| @freshen G i
theorem lrel_closed_sem (G: hyps) {i: set} (M: class) (u w t1 t2 r r2: set):
  $ G ⇒ ra_closed t1 t2 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ >
  $ G ⇒ ∀ i (i ∊ nvf' t1 → r' i = r2' i) $ >
  $ G ⇒ dt u M t2 w r = dt u M t2 w r2 $;
--| @freshen G i
theorem closed_den (G: hyps) {i: set} (M: class) (k: nat) (e: expr) (u w r r2: set):
  $ closed k e $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ >
  $ G ⇒ ∀ i (i ∊ nvf' (enc_nat k) → r' i = r2' i) $ >
  $ G ⇒ dt u M (enc_expr e) w r = dt u M (enc_expr e) w r2 $;
--| Class forms: the level valuation and the valuations as classes.
--| @freshen G i
theorem lrel_closed_sem_c (G: hyps) {i: set} (M W R R2: class) (u t1 t2: set):
  $ G ⇒ ra_closed t1 t2 ∈ lrel $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ R2 ∈ fseq u $ >
  $ G ⇒ ∀ i (i ∊ nvf' t1 → R' i = R2' i) $ >
  $ G ⇒ dt u M t2 W R = dt u M t2 W R2 $;
--| @freshen G i
theorem closed_den_c (G: hyps) {i: set} (M W R R2: class) (k: nat) (e: expr) (u: set):
  $ closed k e $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ R2 ∈ fseq u $ >
  $ G ⇒ ∀ i (i ∊ nvf' (enc_nat k) → R' i = R2' i) $ >
  $ G ⇒ dt u M (enc_expr e) W R = dt u M (enc_expr e) W R2 $;

-- --------------------------------------------------------------------------
-- Lifting (D1)
-- --------------------------------------------------------------------------

--| `lift n k e e2`: `e2` at `p ++ q ++ s` is `e` at `p ++ s` when `p` has
--| length `k` and `q` length `n`.
theorem lrel_lift_sem (G: hyps) (M: class) (u w t1 t2 t3 t4 p q s: set):
  $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' t2 $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ cdm q = nvf' t1 $ >
  $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ dt u M t4 w (p ++ q ++ s) = dt u M t3 w (p ++ s) $;
theorem lift_den (G: hyps) (M: class) (n k: nat) (e e2: expr) (u w p q s: set):
  $ lift n k e e2 $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' (enc_nat k) $ >
  $ G ⇒ q ∊ fseq u $ > $ G ⇒ cdm q = nvf' (enc_nat n) $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ dt u M (enc_expr e2) w (p ++ q ++ s) = dt u M (enc_expr e) w (p ++ s) $;
--| At `k = 0`: weakening by `n` values in front.
theorem lift0_den (G: hyps) (M: class) (n: nat) (e e2: expr) (u w q s: set):
  $ lift n nz e e2 $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ q ∊ fseq u $ > $ G ⇒ cdm q = nvf' (enc_nat n) $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ dt u M (enc_expr e2) w (q ++ s) = dt u M (enc_expr e) w s $;
--| Class forms.
theorem lrel_lift_sem_c (G: hyps) (M W P Q S: class) (u t1 t2 t3 t4: set):
  $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ W ∈ lvals $ >
  $ G ⇒ P ∈ fseq u $ > $ G ⇒ cdm P = nvf' t2 $ > $ G ⇒ Q ∈ fseq u $ > $ G ⇒ cdm Q = nvf' t1 $ >
  $ G ⇒ S ∈ fseq u $ >
  $ G ⇒ dt u M t4 W (P ++ Q ++ S) = dt u M t3 W (P ++ S) $;
theorem lift_den_c (G: hyps) (M W P Q S: class) (n k: nat) (e e2: expr) (u: set):
  $ lift n k e e2 $ > $ G ⇒ W ∈ lvals $ >
  $ G ⇒ P ∈ fseq u $ > $ G ⇒ cdm P = nvf' (enc_nat k) $ >
  $ G ⇒ Q ∈ fseq u $ > $ G ⇒ cdm Q = nvf' (enc_nat n) $ > $ G ⇒ S ∈ fseq u $ >
  $ G ⇒ dt u M (enc_expr e2) W (P ++ Q ++ S) = dt u M (enc_expr e) W (P ++ S) $;
theorem lift0_den_c (G: hyps) (M W Q S: class) (n: nat) (e e2: expr) (u: set):
  $ lift n nz e e2 $ > $ G ⇒ W ∈ lvals $ >
  $ G ⇒ Q ∈ fseq u $ > $ G ⇒ cdm Q = nvf' (enc_nat n) $ > $ G ⇒ S ∈ fseq u $ >
  $ G ⇒ dt u M (enc_expr e2) W (Q ++ S) = dt u M (enc_expr e) W S $;

-- --------------------------------------------------------------------------
-- Substitution (D2)
-- --------------------------------------------------------------------------

--| `inst k e a e2`: `e2` at `p ++ s` is `e` at `p ++ (x :: s)`, with `x` the
--| value of `a` at `s` (an element of `u`), when `p` has length `k`.
theorem lrel_inst_sem (G: hyps) (M: class) (u w t1 t2 t3 t4 p s: set):
  $ G ⇒ ra_inst t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' t1 $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ dt u M t3 w s ∈ u $ >
  $ G ⇒ dt u M t4 w (p ++ s) = dt u M t2 w (p ++ scons (dt u M t3 w s) s) $;
theorem inst_den (G: hyps) (M: class) (k: nat) (e a e2: expr) (u w p s: set):
  $ inst k e a e2 $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' (enc_nat k) $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ dt u M (enc_expr e2) w (p ++ s) =
      dt u M (enc_expr e) w (p ++ scons (dt u M (enc_expr a) w s) s) $;
--| At `k = 0`: the value of `e[a]` is that of `e` at the value of `a` in front
--| (the heart of `beta`).
theorem inst0_den (G: hyps) (M: class) (e a e2: expr) (u w s: set):
  $ inst nz e a e2 $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ dt u M (enc_expr e2) w s = dt u M (enc_expr e) w (scons (dt u M (enc_expr a) w s) s) $;
--| Class forms.
theorem lrel_inst_sem_c (G: hyps) (M W P S: class) (u t1 t2 t3 t4: set):
  $ G ⇒ ra_inst t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ W ∈ lvals $ >
  $ G ⇒ P ∈ fseq u $ > $ G ⇒ cdm P = nvf' t1 $ > $ G ⇒ S ∈ fseq u $ >
  $ G ⇒ dt u M t3 W S ∈ u $ >
  $ G ⇒ dt u M t4 W (P ++ S) = dt u M t2 W (P ++ scons (dt u M t3 W S) S) $;
theorem inst_den_c (G: hyps) (M W P S: class) (k: nat) (e a e2: expr) (u: set):
  $ inst k e a e2 $ > $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ >
  $ G ⇒ P ∈ fseq u $ > $ G ⇒ cdm P = nvf' (enc_nat k) $ > $ G ⇒ S ∈ fseq u $ >
  $ G ⇒ dt u M (enc_expr e2) W (P ++ S) =
      dt u M (enc_expr e) W (P ++ scons (dt u M (enc_expr a) W S) S) $;
theorem inst0_den_c (G: hyps) (M W S: class) (e a e2: expr) (u: set):
  $ inst nz e a e2 $ > $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ S ∈ fseq u $ >
  $ G ⇒ dt u M (enc_expr e2) W S = dt u M (enc_expr e) W (scons (dt u M (enc_expr a) W S) S) $;

-- --------------------------------------------------------------------------
-- Contexts (D5)
-- --------------------------------------------------------------------------

--| A variable's type: for a derivable `lookup G i A`, the `i`-th entry of a
--| valuation satisfying `G` is in the value of `A` there.
theorem lrel_lookup_sem (G: hyps) (M: class) (u w t1 t2 t3 r: set):
  $ G ⇒ ra_lookup t1 t2 t3 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ sat u M t1 w $ >
  $ G ⇒ r' nvf' t2 ∈ dt u M t3 w r $;
theorem lookup_den (H: hyps) (M: class) (G: ctx) (i: nat) (A: expr) (u w r: set):
  $ lookup G i A $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ r ∊ sat u M (enc_ctx G) w $ >
  $ H ⇒ r' nvf' (enc_nat i) ∈ dt u M (enc_expr A) w r $;
--| Extension: for a derivable `cext n G G2`, a valuation satisfying `G2` is
--| `q ++ t` with `q` of length `n` and `t` satisfying `G`.
theorem lrel_cext_sem {q t: set} (G: hyps q t) (M: class) (u w t1 t2 t3 r: set):
  $ G ⇒ ra_cext t1 t2 t3 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ sat u M t3 w $ >
  $ G ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' t1 ∧ t ∊ sat u M t2 w ∧ r = q ++ t) $;
--| @freshen H q
--| @freshen H t
theorem cext_den (H: hyps) {q t: set} (M: class) (n: nat) (G G2: ctx) (u w r: set):
  $ cext n G G2 $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ r ∊ sat u M (enc_ctx G2) w $ >
  $ H ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' (enc_nat n) ∧ t ∊ sat u M (enc_ctx G) w ∧
      r = q ++ t) $;
--| Substitution in a context: for a derivable `cinst k G0 A0 a G1 G`, with `a`
--| of type `A0` in `G0`, a valuation satisfying `G` is `p ++ t` with `p` of
--| length `k` and `t` satisfying `G0`, and `p ++ (x :: t)` satisfies `G1` for
--| `x` the value of `a` at `t`.
--| @freshen G p
--| @freshen G t
--| @freshen G v
theorem lrel_cinst_sem (G: hyps) {p t v: set} (M: class) (u w t1 t2 t3 t4 t5 t6 r: set):
  $ G ⇒ ra_cinst t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ ∀ v (v ∊ sat u M t2 w → dt u M t4 w v ∈ dt u M t3 w v ∧ dt u M t4 w v ∈ u) $ >
  $ G ⇒ r ∊ sat u M t6 w $ >
  $ G ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' t1 ∧ t ∊ sat u M t2 w ∧ r = p ++ t ∧
      p ++ scons (dt u M t4 w t) t ∈ sat u M t5 w) $;
--| @freshen H p
--| @freshen H t
theorem cinst_den (H: hyps) {p t: set} (M: class) (k: nat) (G0 G1 G: ctx) (A0 a: expr) (u w r: set):
  $ mdeq M G0 a a A0 $ > $ cinst k G0 A0 a G1 G $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ >
  $ H ⇒ r ∊ sat u M (enc_ctx G) w $ >
  $ H ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' (enc_nat k) ∧ t ∊ sat u M (enc_ctx G0) w ∧
      r = p ++ t ∧ p ++ scons (dt u M (enc_expr a) w t) t ∈ sat u M (enc_ctx G1) w) $;
