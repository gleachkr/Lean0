lemma d4_ntr_all (G: hyps): $ G ⇒ trees ω ⊆ d4_ntr $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntr , y = ⟨ k , j ⟩ , ra_teqv y c ∈ lrel2 , ra_ntys c n m ∈ lrel ⇒ crn j ⊆ d4_ntr $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntr , y = ⟨ k , j ⟩ , ra_teqv y c ∈ lrel2 , ra_ntys c n m ∈ lrel ⇒ y = ⟨ k , j ⟩ $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntr , y = ⟨ k , j ⟩ , ra_teqv y c ∈ lrel2 , ra_ntys c n m ∈ lrel ⇒ ra_teqv y c ∈ lrel2 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntr , y = ⟨ k , j ⟩ , ra_teqv y c ∈ lrel2 , ra_ntys c n m ∈ lrel ⇒ ra_ntys c n m ∈ lrel $ by ax
n1: $ … ⇒ ra_ntys y n m ∈ lrel $ by d4_ntr_node [a1, a2, a3, a4]
n2: $ … ⇒ ra_teqv y c ∈ lrel2 → ra_ntys c n m ∈ lrel → ra_ntys y n m ∈ lrel $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ c ∀ n ∀ m (ra_teqv y c ∈ lrel2 → ra_ntys c n m ∈ lrel → ra_ntys y n m ∈ lrel) $ by all_intro [all_intro [all_intro [n2]]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntr , y = ⟨ k , j ⟩ ⇒ y ∊ d4_ntr $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntr , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ntr $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntr ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ntr $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ntr → ⟨ k , j ⟩ ∈ d4_ntr $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ntr → ⟨ k , j ⟩ ∈ d4_ntr) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_ntr $ by trees_ind_c [n11, n10]

teqv_ntys_r
----
l1: $ G ⇒ trees ω ⊆ d4_ntr $ by d4_ntr_all
l2a: $ G ⇒ kr_teqv ∈ ω $ by kr_teqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by d4_atoms2 [#1, l2a]
l3: $ … ⇒ t1 ∊ d4_ntr $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ra_ntys t1 n m ∈ lrel $ by d4_ntr_e [l3, #1, #2]

lemma d4_ityf_l {x: set} (G: hyps) (J: class) (d e p q t v f: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ ityf d J f $ > $ G ⇒ ∃ x (ityf e J x ∧ ra_eeqv f x ∈ lrel2) $
----
k1: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ iprt d x1 x2 $ by ax
k2: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ nvf' x3 = J $ by ax
k3: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ ra_nth_ty x2 x3 f x4 ∈ lrel $ by ax
w1: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ iprt d p t $ by weaken [#1]
w4: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#3]
k4: $ … ⇒ p = x1 ∧ t = x2 $ by iprt_det [w1, k1]
r_x3: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ x3 = x3 $ by eq_refl
r_f: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ f = f $ by eq_refl
r_x4: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ x4 = x4 $ by eq_refl
k5: $ … ⇒ ra_nth_ty t x3 f x4 ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [eq_sym [and_elim_r [k4]], r_x3, r_f, r_x4], k3]
k6: $ … ⇒ ∃ x5 ∃ x6 (ra_nth_ty v x3 x5 x6 ∈ lrel ∧ ra_eeqv f x5 ∈ lrel2 ∧ ra_cseqv x4 x6 ∈ lrel2) $ by teqv_nth_ty_l [w4, k5]
i0: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel , ra_nth_ty v x3 x5 x6 ∈ lrel ∧ ra_eeqv f x5 ∈ lrel2 ∧ ra_cseqv x4 x6 ∈ lrel2 ⇒ ra_nth_ty v x3 x5 x6 ∈ lrel ∧ ra_eeqv f x5 ∈ lrel2 ∧ ra_cseqv x4 x6 ∈ lrel2 $ by ax
i1: $ … ⇒ ra_nth_ty v x3 x5 x6 ∈ lrel $ by and_elim_l [i0]
i2: $ … ⇒ ra_eeqv f x5 ∈ lrel2 $ by and_elim_l [and_elim_r [i0]]
iw: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel , ra_nth_ty v x3 x5 x6 ∈ lrel ∧ ra_eeqv f x5 ∈ lrel2 ∧ ra_cseqv x4 x6 ∈ lrel2 ⇒ iprt e q v $ by weaken [#2]
ik: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel , ra_nth_ty v x3 x5 x6 ∈ lrel ∧ ra_eeqv f x5 ∈ lrel2 ∧ ra_cseqv x4 x6 ∈ lrel2 ⇒ nvf' x3 = J $ by weaken [k2]
i4: $ … ⇒ ityf e J x5 $ by ityf_intro [iw, ik, i1]
i5: $ … ⇒ ∃ x (ityf e J x ∧ ra_eeqv f x ∈ lrel2) $ by ex_intro [and_intro [i4, i2]]
k7_x1: $ G , iprt d x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel , ∃ x6 (ra_nth_ty v x3 x5 x6 ∈ lrel ∧ ra_eeqv f x5 ∈ lrel2 ∧ ra_cseqv x4 x6 ∈ lrel2) ⇒ ∃ x6 (ra_nth_ty v x3 x5 x6 ∈ lrel ∧ ra_eeqv f x5 ∈ lrel2 ∧ ra_cseqv x4 x6 ∈ lrel2) $ by ax
k7_y1: $ … ⇒ ∃ x (ityf e J x ∧ ra_eeqv f x ∈ lrel2) $ by ex_elim [k7_x1, i5]
k7: $ … ⇒ ∃ x (ityf e J x ∧ ra_eeqv f x ∈ lrel2) $ by ex_elim [k6, k7_y1]
fin: $ … ⇒ ∃ x (ityf e J x ∧ ra_eeqv f x ∈ lrel2) $ by ityf_elim [#4, k7]

lemma d4_ictk_l {x: set} (G: hyps) (J C: class) (d e p q t v k: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ ictk d J C k $ > $ G ⇒ ∃ x (ictk e J C x ∧ ra_eeqv k x ∈ lrel2) $
----
k0: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel $ by ax
k1: $ … ⇒ iprt d x1 x2 $ by and_elim_l [k0]
k2: $ … ⇒ nvf' x3 = J $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ ra_nth_ty x2 x3 x4 x5 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [k0]]]
k4: $ … ⇒ nvf' x6 = C $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [k0]]]]
k5: $ … ⇒ ra_nth_ctor x5 x6 k ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [k0]]]]
w1: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ iprt d p t $ by weaken [#1]
w4: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#3]
m1: $ … ⇒ p = x1 ∧ t = x2 $ by iprt_det [w1, k1]
r_x3: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ x3 = x3 $ by eq_refl
r_x4: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ x4 = x4 $ by eq_refl
r_x5: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ x5 = x5 $ by eq_refl
m2: $ … ⇒ ra_nth_ty t x3 x4 x5 ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [eq_sym [and_elim_r [m1]], r_x3, r_x4, r_x5], k3]
m3: $ … ⇒ ∃ a ∃ b (ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2) $ by teqv_nth_ty_l [w4, m2]
i0: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2 ⇒ ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2 $ by ax
i1: $ … ⇒ ra_nth_ty v x3 a b ∈ lrel $ by and_elim_l [i0]
i3: $ … ⇒ ra_cseqv x5 b ∈ lrel2 $ by and_elim_r [and_elim_r [i0]]
ic: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2 ⇒ ra_nth_ctor x5 x6 k ∈ lrel $ by weaken [k5]
i4: $ … ⇒ ∃ y (ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv k y ∈ lrel2) $ by cseqv_nth_ctor_l [i3, ic]
j0: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv k y ∈ lrel2 ⇒ ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv k y ∈ lrel2 $ by ax
j1: $ … ⇒ ra_nth_ctor b x6 y ∈ lrel $ by and_elim_l [j0]
j2: $ … ⇒ ra_eeqv k y ∈ lrel2 $ by and_elim_r [j0]
jw: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv k y ∈ lrel2 ⇒ iprt e q v $ by weaken [#2]
j3: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv k y ∈ lrel2 ⇒ nvf' x3 = J $ by weaken [k2]
j4: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv k y ∈ lrel2 ⇒ ra_nth_ty v x3 a b ∈ lrel $ by weaken [i1]
j5: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv k y ∈ lrel2 ⇒ nvf' x6 = C $ by weaken [k4]
j6: $ … ⇒ ictk e J C y $ by ictk_intro [jw, j3, j4, j5, j1]
j7: $ … ⇒ ∃ x (ictk e J C x ∧ ra_eeqv k x ∈ lrel2) $ by ex_intro [and_intro [j6, j2]]
i5: $ … ⇒ ∃ x (ictk e J C x ∧ ra_eeqv k x ∈ lrel2) $ by ex_elim [i4, j7]
m4_x1: $ G , iprt d x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ∃ b (ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2) ⇒ ∃ b (ra_nth_ty v x3 a b ∈ lrel ∧ ra_eeqv x4 a ∈ lrel2 ∧ ra_cseqv x5 b ∈ lrel2) $ by ax
m4_y1: $ … ⇒ ∃ x (ictk e J C x ∧ ra_eeqv k x ∈ lrel2) $ by ex_elim [m4_x1, i5]
m4: $ … ⇒ ∃ x (ictk e J C x ∧ ra_eeqv k x ∈ lrel2) $ by ex_elim [m3, m4_y1]
fin: $ … ⇒ ∃ x (ictk e J C x ∧ ra_eeqv k x ∈ lrel2) $ by ictk_elim [#4, m4]

lemma d4_iprop_l (G: hyps) (J: class) (d e p q t v w: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ iprop d J w $ > $ G ⇒ iprop e J w $
----
k1: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ ityf d J x1 $ by ax
k2: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ ra_isort x1 x2 x3 ∈ lrel $ by ax
k3: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ lv x3 w = ∅ $ by ax
w1: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ iprt d p t $ by weaken [#1]
w2: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ iprt e q v $ by weaken [#2]
w4: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#3]
w5: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ w ∊ lvals $ by weaken [#4]
k4: $ … ⇒ ∃ x4 (ityf e J x4 ∧ ra_eeqv x1 x4 ∈ lrel2) $ by d4_ityf_l [w1, w2, w4, k1]
i0: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf e J x4 ∧ ra_eeqv x1 x4 ∈ lrel2 ⇒ ityf e J x4 ∧ ra_eeqv x1 x4 ∈ lrel2 $ by ax
i1: $ … ⇒ ityf e J x4 $ by and_elim_l [i0]
i2: $ … ⇒ ra_eeqv x1 x4 ∈ lrel2 $ by and_elim_r [i0]
i3: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf e J x4 ∧ ra_eeqv x1 x4 ∈ lrel2 ⇒ ra_isort x1 x2 x3 ∈ lrel $ by weaken [k2]
i4: $ … ⇒ ∃ x5 (ra_isort x4 x2 x5 ∈ lrel ∧ lveq x3 x5) $ by eeqv_isort_l [i2, i3]
j0: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf e J x4 ∧ ra_eeqv x1 x4 ∈ lrel2 , ra_isort x4 x2 x5 ∈ lrel ∧ lveq x3 x5 ⇒ ra_isort x4 x2 x5 ∈ lrel ∧ lveq x3 x5 $ by ax
j1: $ … ⇒ ra_isort x4 x2 x5 ∈ lrel $ by and_elim_l [j0]
j2: $ … ⇒ lveq x3 x5 $ by and_elim_r [j0]
j3: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf e J x4 ∧ ra_eeqv x1 x4 ∈ lrel2 , ra_isort x4 x2 x5 ∈ lrel ∧ lveq x3 x5 ⇒ w ∊ lvals $ by weaken [w5]
j4: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf e J x4 ∧ ra_eeqv x1 x4 ∈ lrel2 , ra_isort x4 x2 x5 ∈ lrel ∧ lveq x3 x5 ⇒ lv x3 w = ∅ $ by weaken [k3]
j5: $ G , ityf d J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf e J x4 ∧ ra_eeqv x1 x4 ∈ lrel2 , ra_isort x4 x2 x5 ∈ lrel ∧ lveq x3 x5 ⇒ ityf e J x4 $ by weaken [i1]
j6: $ … ⇒ w ∊ lvals → lv x3 w = lv x5 w $ by all_elim [j2]
j7: $ … ⇒ lv x3 w = lv x5 w $ by imp_elim [j6, j3]
j8: $ … ⇒ lv x5 w = ∅ $ by eq_trans [eq_sym [j7], j4]
j9: $ … ⇒ iprop e J w $ by iprop_intro [j5, j1, j8]
i5: $ … ⇒ iprop e J w $ by ex_elim [i4, j9]
k5: $ … ⇒ iprop e J w $ by ex_elim [k4, i5]
fin: $ … ⇒ iprop e J w $ by iprop_elim [#5, k5]

lemma d4_intys_l (G: hyps) (d e a b c f: set): $ G ⇒ iprt d a c $ > $ G ⇒ iprt e b f $ > $ G ⇒ ra_teqv c f ∈ lrel2 $ > $ G ⇒ intys d ⊆ intys e $
----
s0: $ G , z ∊ intys d ⇒ z ∊ intys d $ by ax
s1: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) $ by cab_elim [s0]
k0: $ G , z ∊ intys d , iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 $ by ax
k1: $ … ⇒ iprt d x1 x2 $ by and_elim_l [k0]
k2: $ … ⇒ ra_ntys x2 x3 x4 ∈ lrel $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ z ∊ nvf' x3 $ by and_elim_r [and_elim_r [k0]]
w1: $ G , z ∊ intys d , iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ iprt d a c $ by weaken [#1]
w2: $ G , z ∊ intys d , iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ iprt e b f $ by weaken [#2]
w4: $ G , z ∊ intys d , iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ ra_teqv c f ∈ lrel2 $ by weaken [#3]
m1: $ … ⇒ a = x1 ∧ c = x2 $ by iprt_det [w1, k1]
r_x3: $ G , z ∊ intys d , iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ x3 = x3 $ by eq_refl
r_x4: $ G , z ∊ intys d , iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ x4 = x4 $ by eq_refl
m2: $ … ⇒ ra_ntys c x3 x4 ∈ lrel $ by wcel_eq_l [ra_ntys_eq [eq_sym [and_elim_r [m1]], r_x3, r_x4], k2]
m3: $ … ⇒ ra_ntys f x3 x4 ∈ lrel $ by teqv_ntys_l [w4, m2]
m4: $ … ⇒ iprt e b f ∧ ra_ntys f x3 x4 ∈ lrel ∧ z ∊ nvf' x3 $ by and_intro [w2, and_intro [m3, k3]]
m5: $ … ⇒ ∃ m (iprt e b f ∧ ra_ntys f x3 m ∈ lrel ∧ z ∊ nvf' x3) $ by ex_intro [m4]
m6: $ … ⇒ ∃ n ∃ m (iprt e b f ∧ ra_ntys f n m ∈ lrel ∧ z ∊ nvf' n) $ by ex_intro [m5]
m7: $ … ⇒ ∃ t ∃ n ∃ m (iprt e b t ∧ ra_ntys t n m ∈ lrel ∧ z ∊ nvf' n) $ by ex_intro [m6]
m8: $ … ⇒ ∃ p ∃ t ∃ n ∃ m (iprt e p t ∧ ra_ntys t n m ∈ lrel ∧ z ∊ nvf' n) $ by ex_intro [m7]
m9a: $ … ⇒ z ∊ {y | ∃ p ∃ t ∃ n ∃ m (iprt e p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ nvf' n)} $ by cab_intro [m8]
m9b: $ G , z ∊ intys d , iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ intys e = {y | ∃ p ∃ t ∃ n ∃ m (iprt e p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ nvf' n)} $ by eq_refl
m9: $ … ⇒ z ∊ intys e $ by welc_eq [eq_sym [m9b], m9a]
s2_x3: $ G , z ∊ intys d , ∃ x4 (iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) ⇒ ∃ x4 (iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) $ by ax
s2_y3: $ … ⇒ z ∊ intys e $ by ex_elim [s2_x3, m9]
s2_x2: $ G , z ∊ intys d , ∃ x3 ∃ x4 (iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) ⇒ ∃ x3 ∃ x4 (iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) $ by ax
s2_y2: $ … ⇒ z ∊ intys e $ by ex_elim [s2_x2, s2_y3]
s2_x1: $ G , z ∊ intys d , ∃ x2 ∃ x3 ∃ x4 (iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) ⇒ ∃ x2 ∃ x3 ∃ x4 (iprt d x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) $ by ax
s2_y1: $ … ⇒ z ∊ intys e $ by ex_elim [s2_x1, s2_y2]
s2: $ … ⇒ z ∊ intys e $ by ex_elim [s1, s2_y1]
fin: $ … ⇒ intys d ⊆ intys e $ by subset_intro [s2]

lemma d4_ityf_r {x: set} (G: hyps) (J: class) (d e p q t v f: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ ityf e J f $ > $ G ⇒ ∃ x (ityf d J x ∧ ra_eeqv x f ∈ lrel2) $
----
k1: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ iprt e x1 x2 $ by ax
k2: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ nvf' x3 = J $ by ax
k3: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ ra_nth_ty x2 x3 f x4 ∈ lrel $ by ax
w2: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ iprt e q v $ by weaken [#2]
w4: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#3]
k4: $ … ⇒ q = x1 ∧ v = x2 $ by iprt_det [w2, k1]
r_x3: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ x3 = x3 $ by eq_refl
r_f: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ f = f $ by eq_refl
r_x4: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel ⇒ x4 = x4 $ by eq_refl
k5: $ … ⇒ ra_nth_ty v x3 f x4 ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [eq_sym [and_elim_r [k4]], r_x3, r_f, r_x4], k3]
k6: $ … ⇒ ∃ x5 ∃ x6 (ra_nth_ty t x3 x5 x6 ∈ lrel ∧ ra_eeqv x5 f ∈ lrel2 ∧ ra_cseqv x6 x4 ∈ lrel2) $ by teqv_nth_ty_r [w4, k5]
i0: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel , ra_nth_ty t x3 x5 x6 ∈ lrel ∧ ra_eeqv x5 f ∈ lrel2 ∧ ra_cseqv x6 x4 ∈ lrel2 ⇒ ra_nth_ty t x3 x5 x6 ∈ lrel ∧ ra_eeqv x5 f ∈ lrel2 ∧ ra_cseqv x6 x4 ∈ lrel2 $ by ax
i1: $ … ⇒ ra_nth_ty t x3 x5 x6 ∈ lrel $ by and_elim_l [i0]
i2: $ … ⇒ ra_eeqv x5 f ∈ lrel2 $ by and_elim_l [and_elim_r [i0]]
iw: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel , ra_nth_ty t x3 x5 x6 ∈ lrel ∧ ra_eeqv x5 f ∈ lrel2 ∧ ra_cseqv x6 x4 ∈ lrel2 ⇒ iprt d p t $ by weaken [#1]
ik: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel , ra_nth_ty t x3 x5 x6 ∈ lrel ∧ ra_eeqv x5 f ∈ lrel2 ∧ ra_cseqv x6 x4 ∈ lrel2 ⇒ nvf' x3 = J $ by weaken [k2]
i4: $ … ⇒ ityf d J x5 $ by ityf_intro [iw, ik, i1]
i5: $ … ⇒ ∃ x (ityf d J x ∧ ra_eeqv x f ∈ lrel2) $ by ex_intro [and_intro [i4, i2]]
k7_x1: $ G , iprt e x1 x2 , nvf' x3 = J , ra_nth_ty x2 x3 f x4 ∈ lrel , ∃ x6 (ra_nth_ty t x3 x5 x6 ∈ lrel ∧ ra_eeqv x5 f ∈ lrel2 ∧ ra_cseqv x6 x4 ∈ lrel2) ⇒ ∃ x6 (ra_nth_ty t x3 x5 x6 ∈ lrel ∧ ra_eeqv x5 f ∈ lrel2 ∧ ra_cseqv x6 x4 ∈ lrel2) $ by ax
k7_y1: $ … ⇒ ∃ x (ityf d J x ∧ ra_eeqv x f ∈ lrel2) $ by ex_elim [k7_x1, i5]
k7: $ … ⇒ ∃ x (ityf d J x ∧ ra_eeqv x f ∈ lrel2) $ by ex_elim [k6, k7_y1]
fin: $ … ⇒ ∃ x (ityf d J x ∧ ra_eeqv x f ∈ lrel2) $ by ityf_elim [#4, k7]

lemma d4_ictk_r {x: set} (G: hyps) (J C: class) (d e p q t v k: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ ictk e J C k $ > $ G ⇒ ∃ x (ictk d J C x ∧ ra_eeqv x k ∈ lrel2) $
----
k0: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel $ by ax
k1: $ … ⇒ iprt e x1 x2 $ by and_elim_l [k0]
k2: $ … ⇒ nvf' x3 = J $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ ra_nth_ty x2 x3 x4 x5 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [k0]]]
k4: $ … ⇒ nvf' x6 = C $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [k0]]]]
k5: $ … ⇒ ra_nth_ctor x5 x6 k ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [k0]]]]
w2: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ iprt e q v $ by weaken [#2]
w4: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#3]
m1: $ … ⇒ q = x1 ∧ v = x2 $ by iprt_det [w2, k1]
r_x3: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ x3 = x3 $ by eq_refl
r_x4: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ x4 = x4 $ by eq_refl
r_x5: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel ⇒ x5 = x5 $ by eq_refl
m2: $ … ⇒ ra_nth_ty v x3 x4 x5 ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [eq_sym [and_elim_r [m1]], r_x3, r_x4, r_x5], k3]
m3: $ … ⇒ ∃ a ∃ b (ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2) $ by teqv_nth_ty_r [w4, m2]
i0: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2 ⇒ ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2 $ by ax
i1: $ … ⇒ ra_nth_ty t x3 a b ∈ lrel $ by and_elim_l [i0]
i3: $ … ⇒ ra_cseqv b x5 ∈ lrel2 $ by and_elim_r [and_elim_r [i0]]
ic: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2 ⇒ ra_nth_ctor x5 x6 k ∈ lrel $ by weaken [k5]
i4: $ … ⇒ ∃ y (ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv y k ∈ lrel2) $ by cseqv_nth_ctor_r [i3, ic]
j0: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv y k ∈ lrel2 ⇒ ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv y k ∈ lrel2 $ by ax
j1: $ … ⇒ ra_nth_ctor b x6 y ∈ lrel $ by and_elim_l [j0]
j2: $ … ⇒ ra_eeqv y k ∈ lrel2 $ by and_elim_r [j0]
jw: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv y k ∈ lrel2 ⇒ iprt d p t $ by weaken [#1]
j3: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv y k ∈ lrel2 ⇒ nvf' x3 = J $ by weaken [k2]
j4: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv y k ∈ lrel2 ⇒ ra_nth_ty t x3 a b ∈ lrel $ by weaken [i1]
j5: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2 , ra_nth_ctor b x6 y ∈ lrel ∧ ra_eeqv y k ∈ lrel2 ⇒ nvf' x6 = C $ by weaken [k4]
j6: $ … ⇒ ictk d J C y $ by ictk_intro [jw, j3, j4, j5, j1]
j7: $ … ⇒ ∃ x (ictk d J C x ∧ ra_eeqv x k ∈ lrel2) $ by ex_intro [and_intro [j6, j2]]
i5: $ … ⇒ ∃ x (ictk d J C x ∧ ra_eeqv x k ∈ lrel2) $ by ex_elim [i4, j7]
m4_x1: $ G , iprt e x1 x2 ∧ nvf' x3 = J ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = C ∧ ra_nth_ctor x5 x6 k ∈ lrel , ∃ b (ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2) ⇒ ∃ b (ra_nth_ty t x3 a b ∈ lrel ∧ ra_eeqv a x4 ∈ lrel2 ∧ ra_cseqv b x5 ∈ lrel2) $ by ax
m4_y1: $ … ⇒ ∃ x (ictk d J C x ∧ ra_eeqv x k ∈ lrel2) $ by ex_elim [m4_x1, i5]
m4: $ … ⇒ ∃ x (ictk d J C x ∧ ra_eeqv x k ∈ lrel2) $ by ex_elim [m3, m4_y1]
fin: $ … ⇒ ∃ x (ictk d J C x ∧ ra_eeqv x k ∈ lrel2) $ by ictk_elim [#4, m4]

lemma d4_iprop_r (G: hyps) (J: class) (d e p q t v w: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ iprop e J w $ > $ G ⇒ iprop d J w $
----
k1: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ ityf e J x1 $ by ax
k2: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ ra_isort x1 x2 x3 ∈ lrel $ by ax
k3: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ lv x3 w = ∅ $ by ax
w1: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ iprt d p t $ by weaken [#1]
w2: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ iprt e q v $ by weaken [#2]
w4: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#3]
w5: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ ⇒ w ∊ lvals $ by weaken [#4]
k4: $ … ⇒ ∃ x4 (ityf d J x4 ∧ ra_eeqv x4 x1 ∈ lrel2) $ by d4_ityf_r [w1, w2, w4, k1]
i0: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf d J x4 ∧ ra_eeqv x4 x1 ∈ lrel2 ⇒ ityf d J x4 ∧ ra_eeqv x4 x1 ∈ lrel2 $ by ax
i1: $ … ⇒ ityf d J x4 $ by and_elim_l [i0]
i2: $ … ⇒ ra_eeqv x4 x1 ∈ lrel2 $ by and_elim_r [i0]
i3: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf d J x4 ∧ ra_eeqv x4 x1 ∈ lrel2 ⇒ ra_isort x1 x2 x3 ∈ lrel $ by weaken [k2]
i4: $ … ⇒ ∃ x5 (ra_isort x4 x2 x5 ∈ lrel ∧ lveq x5 x3) $ by eeqv_isort_r [i2, i3]
j0: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf d J x4 ∧ ra_eeqv x4 x1 ∈ lrel2 , ra_isort x4 x2 x5 ∈ lrel ∧ lveq x5 x3 ⇒ ra_isort x4 x2 x5 ∈ lrel ∧ lveq x5 x3 $ by ax
j1: $ … ⇒ ra_isort x4 x2 x5 ∈ lrel $ by and_elim_l [j0]
j2: $ … ⇒ lveq x5 x3 $ by and_elim_r [j0]
j3: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf d J x4 ∧ ra_eeqv x4 x1 ∈ lrel2 , ra_isort x4 x2 x5 ∈ lrel ∧ lveq x5 x3 ⇒ w ∊ lvals $ by weaken [w5]
j4: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf d J x4 ∧ ra_eeqv x4 x1 ∈ lrel2 , ra_isort x4 x2 x5 ∈ lrel ∧ lveq x5 x3 ⇒ lv x3 w = ∅ $ by weaken [k3]
j5: $ G , ityf e J x1 , ra_isort x1 x2 x3 ∈ lrel , lv x3 w = ∅ , ityf d J x4 ∧ ra_eeqv x4 x1 ∈ lrel2 , ra_isort x4 x2 x5 ∈ lrel ∧ lveq x5 x3 ⇒ ityf d J x4 $ by weaken [i1]
j6: $ … ⇒ w ∊ lvals → lv x5 w = lv x3 w $ by all_elim [j2]
j7: $ … ⇒ lv x5 w = lv x3 w $ by imp_elim [j6, j3]
j8: $ … ⇒ lv x5 w = ∅ $ by eq_trans [j7, j4]
j9: $ … ⇒ iprop d J w $ by iprop_intro [j5, j1, j8]
i5: $ … ⇒ iprop d J w $ by ex_elim [i4, j9]
k5: $ … ⇒ iprop d J w $ by ex_elim [k4, i5]
fin: $ … ⇒ iprop d J w $ by iprop_elim [#5, k5]

lemma d4_intys_r (G: hyps) (d e a b c f: set): $ G ⇒ iprt d a c $ > $ G ⇒ iprt e b f $ > $ G ⇒ ra_teqv c f ∈ lrel2 $ > $ G ⇒ intys e ⊆ intys d $
----
s0: $ G , z ∊ intys e ⇒ z ∊ intys e $ by ax
s1: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) $ by cab_elim [s0]
k0: $ G , z ∊ intys e , iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 $ by ax
k1: $ … ⇒ iprt e x1 x2 $ by and_elim_l [k0]
k2: $ … ⇒ ra_ntys x2 x3 x4 ∈ lrel $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ z ∊ nvf' x3 $ by and_elim_r [and_elim_r [k0]]
w1: $ G , z ∊ intys e , iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ iprt d a c $ by weaken [#1]
w2: $ G , z ∊ intys e , iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ iprt e b f $ by weaken [#2]
w4: $ G , z ∊ intys e , iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ ra_teqv c f ∈ lrel2 $ by weaken [#3]
m1: $ … ⇒ b = x1 ∧ f = x2 $ by iprt_det [w2, k1]
r_x3: $ G , z ∊ intys e , iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ x3 = x3 $ by eq_refl
r_x4: $ G , z ∊ intys e , iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ x4 = x4 $ by eq_refl
m2: $ … ⇒ ra_ntys f x3 x4 ∈ lrel $ by wcel_eq_l [ra_ntys_eq [eq_sym [and_elim_r [m1]], r_x3, r_x4], k2]
m3: $ … ⇒ ra_ntys c x3 x4 ∈ lrel $ by teqv_ntys_r [w4, m2]
m4: $ … ⇒ iprt d a c ∧ ra_ntys c x3 x4 ∈ lrel ∧ z ∊ nvf' x3 $ by and_intro [w1, and_intro [m3, k3]]
m5: $ … ⇒ ∃ m (iprt d a c ∧ ra_ntys c x3 m ∈ lrel ∧ z ∊ nvf' x3) $ by ex_intro [m4]
m6: $ … ⇒ ∃ n ∃ m (iprt d a c ∧ ra_ntys c n m ∈ lrel ∧ z ∊ nvf' n) $ by ex_intro [m5]
m7: $ … ⇒ ∃ t ∃ n ∃ m (iprt d a t ∧ ra_ntys t n m ∈ lrel ∧ z ∊ nvf' n) $ by ex_intro [m6]
m8: $ … ⇒ ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ z ∊ nvf' n) $ by ex_intro [m7]
m9a: $ … ⇒ z ∊ {y | ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ nvf' n)} $ by cab_intro [m8]
m9b: $ G , z ∊ intys e , iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3 ⇒ intys d = {y | ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ nvf' n)} $ by eq_refl
m9: $ … ⇒ z ∊ intys d $ by welc_eq [eq_sym [m9b], m9a]
s2_x3: $ G , z ∊ intys e , ∃ x4 (iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) ⇒ ∃ x4 (iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) $ by ax
s2_y3: $ … ⇒ z ∊ intys d $ by ex_elim [s2_x3, m9]
s2_x2: $ G , z ∊ intys e , ∃ x3 ∃ x4 (iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) ⇒ ∃ x3 ∃ x4 (iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) $ by ax
s2_y2: $ … ⇒ z ∊ intys d $ by ex_elim [s2_x2, s2_y3]
s2_x1: $ G , z ∊ intys e , ∃ x2 ∃ x3 ∃ x4 (iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) ⇒ ∃ x2 ∃ x3 ∃ x4 (iprt e x1 x2 ∧ ra_ntys x2 x3 x4 ∈ lrel ∧ z ∊ nvf' x3) $ by ax
s2_y1: $ … ⇒ z ∊ intys d $ by ex_elim [s2_x1, s2_y2]
s2: $ … ⇒ z ∊ intys d $ by ex_elim [s1, s2_y1]
fin: $ … ⇒ intys e ⊆ intys d $ by subset_intro [s2]

intys_eqv
----
l1: $ … ⇒ intys d = intys e $ by subset_antisym [d4_intys_l [#1, #2, #3], d4_intys_r [#1, #2, #3]]

lemma d4_ient_l (G: hyps) (J Z: class) (d e p q t v w: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ient d w Z J ⊆ ient e w Z J $
----
s0: $ G , z ∊ ient d w Z J ⇒ z ∊ ient d w Z J $ by ax
s1: $ … ⇒ ∃ x1 ∃ x2 (⟨ J , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop d J w ∧ z = nest x1 ∅) ∨ (¬ iprop d J w ∧ z = nest x1 x2))) $ by cab_elim [s0]
k0: $ G , z ∊ ient d w Z J , ⟨ J , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop d J w ∧ z = nest x1 ∅) ∨ (¬ iprop d J w ∧ z = nest x1 x2)) ⇒ ⟨ J , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop d J w ∧ z = nest x1 ∅) ∨ (¬ iprop d J w ∧ z = nest x1 x2)) $ by ax
k1: $ … ⇒ ⟨ J , ⟨ x1 , x2 ⟩ ⟩ ∈ Z $ by and_elim_l [k0]
k2: $ … ⇒ (iprop d J w ∧ z = nest x1 ∅) ∨ (¬ iprop d J w ∧ z = nest x1 x2) $ by and_elim_r [k0]
