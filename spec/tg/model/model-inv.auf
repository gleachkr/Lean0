s2_x6: $ G , z ∊ itc u (dnf u M) e w , ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) ⇒ ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) $ by ax
s2_y6: $ … ⇒ z ∊ itc u (dnf u M) d w $ by ex_elim [s2_x6, s2_y7]
s2_x5: $ G , z ∊ itc u (dnf u M) e w , ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) ⇒ ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) $ by ax
s2_y5: $ … ⇒ z ∊ itc u (dnf u M) d w $ by ex_elim [s2_x5, s2_y6]
s2_x4: $ G , z ∊ itc u (dnf u M) e w , ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) ⇒ ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) $ by ax
s2_y4: $ … ⇒ z ∊ itc u (dnf u M) d w $ by ex_elim [s2_x4, s2_y5]
s2_x3: $ G , z ∊ itc u (dnf u M) e w , ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) ⇒ ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) $ by ax
s2_y3: $ … ⇒ z ∊ itc u (dnf u M) d w $ by ex_elim [s2_x3, s2_y4]
s2_x2: $ G , z ∊ itc u (dnf u M) e w , ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) ⇒ ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) $ by ax
s2_y2: $ … ⇒ z ∊ itc u (dnf u M) d w $ by ex_elim [s2_x2, s2_y3]
s2_x1: $ G , z ∊ itc u (dnf u M) e w , ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) ⇒ ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (iprt e x2 x3 ∧ ityf e x1 x4 ∧ x5 ∊ esat u (dnf u M) x2 w ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x4 w x5 ∧ z = ⟨ x1 , ⟨ x6 ++ x5 , scons ∅ ∅ ⟩ ⟩) $ by ax
s2_y1: $ … ⇒ z ∊ itc u (dnf u M) d w $ by ex_elim [s2_x1, s2_y2]
s2: $ … ⇒ z ∊ itc u (dnf u M) d w $ by ex_elim [s1, s2_y1]
fin: $ … ⇒ itc u (dnf u M) e w ⊆ itc u (dnf u M) d w $ by subset_intro [s2]

itc_eqv
----
l1: $ … ⇒ itc u (dnf u M) d w = itc u (dnf u M) e w $ by subset_antisym [d4_itc_l [#1, #2, #3, #4, #5, #6, #7], d4_itc_r [#1, #2, #3, #4, #5, #6, #7]]

itriv_eqv
----
l1: $ … ⇒ ient d w (itc u (dnf u M) d w) J = ient e w (itc u (dnf u M) d w) J $ by ient_eqv [#1, #2, #4, #5]
l2: $ … ⇒ itc u (dnf u M) d w = itc u (dnf u M) e w $ by itc_eqv [#1, #2, #3, #4, #5, #6, #7]
re: $ G ⇒ e = e $ by eq_refl
rw: $ G ⇒ w = w $ by eq_refl
rJ: $ G ⇒ J = J $ by eq_refl
l3: $ … ⇒ ient e w (itc u (dnf u M) d w) J = ient e w (itc u (dnf u M) e w) J $ by ient_eq [re, rw, l2, rJ]
l4: $ … ⇒ itriv u (dnf u M) d J w = itriv u (dnf u M) e J w $ by eq_trans [l1, l3]

ity_eqv
----
l1: $ … ⇒ ient d w (ifam u (dnf u M) d w) J = ient e w (ifam u (dnf u M) d w) J $ by ient_eqv [#1, #2, #4, #5]
l2: $ … ⇒ ifam u (dnf u M) d w = ifam u (dnf u M) e w $ by ifam_eqv [#1, #2, #3, #4, #5, #6, #7]
re: $ G ⇒ e = e $ by eq_refl
rw: $ G ⇒ w = w $ by eq_refl
rJ: $ G ⇒ J = J $ by eq_refl
l3: $ … ⇒ ient e w (ifam u (dnf u M) d w) J = ient e w (ifam u (dnf u M) e w) J $ by ient_eq [re, rw, l2, rJ]
l4: $ … ⇒ ity u (dnf u M) d J w = ity u (dnf u M) e J w $ by eq_trans [l1, l3]

lemma d4_ipi_sub {i: set} (G: hyps) (E: class) (u w a b c f: set): $ G ⇒ esat u E a w = esat u E b w $ > $ G ⇒ ∀ i (da (E' c) w i = da (E' f) w i) $ > $ G ⇒ ipi u E a c w ⊆ ipi u E b f w $
----
s0: $ G , x ∊ ipi u E a c w ⇒ x ∊ ipi u E a c w $ by ax
sx: $ G , x ∊ ipi u E a c w ⇒ isset x $ by isset_var
s1: $ … ⇒ x ∈ ipi u E a c w ↔ (x ⊆ {y | ∃ x1 ∃ x2 (x1 ∊ esat u E a w ∧ y = nest x1 x2)} ∧ ∀ d (d ∊ esat u E a w → apn x d ∈ da (E' c) w d)) $ by ipi_wcel [sx]
s2: $ … ⇒ x ⊆ {y | ∃ x1 ∃ x2 (x1 ∊ esat u E a w ∧ y = nest x1 x2)} ∧ ∀ d (d ∊ esat u E a w → apn x d ∈ da (E' c) w d) $ by bi_elim_l [s1, welc_wcel [s0]]
y0: $ G , x ∊ ipi u E a c w , e ∊ x ⇒ e ∊ x $ by ax
y1a: $ … ⇒ x ⊆ {y | ∃ x1 ∃ x2 (x1 ∊ esat u E a w ∧ y = nest x1 x2)} $ by and_elim_l [s2]
y1: $ G , x ∊ ipi u E a c w , e ∊ x ⇒ x ⊆ {y | ∃ x1 ∃ x2 (x1 ∊ esat u E a w ∧ y = nest x1 x2)} $ by weaken [y1a]
y2: $ … ⇒ ∃ x1 ∃ x2 (x1 ∊ esat u E a w ∧ e = nest x1 x2) $ by cab_elim [subset_elim [y1, y0]]
b0: $ G , x ∊ ipi u E a c w , e ∊ x , x1 ∊ esat u E a w ∧ e = nest x1 x2 ⇒ x1 ∊ esat u E a w ∧ e = nest x1 x2 $ by ax
b1: $ G , x ∊ ipi u E a c w , e ∊ x , x1 ∊ esat u E a w ∧ e = nest x1 x2 ⇒ esat u E a w = esat u E b w $ by weaken [#1]
b2: $ … ⇒ x1 ∊ esat u E b w ∧ e = nest x1 x2 $ by and_intro [welc_eq [b1, and_elim_l [b0]], and_elim_r [b0]]
b3: $ … ⇒ ∃ z (x1 ∊ esat u E b w ∧ e = nest x1 z) $ by ex_intro [b2]
b4: $ … ⇒ ∃ o ∃ z (o ∊ esat u E b w ∧ e = nest o z) $ by ex_intro [b3]
b5: $ … ⇒ e ∊ {y | ∃ o ∃ z (o ∊ esat u E b w ∧ y = nest o z)} $ by cab_intro [b4]
y3_x1: $ G , x ∊ ipi u E a c w , e ∊ x , ∃ x2 (x1 ∊ esat u E a w ∧ e = nest x1 x2) ⇒ ∃ x2 (x1 ∊ esat u E a w ∧ e = nest x1 x2) $ by ax
y3_y1: $ … ⇒ e ∊ {y | ∃ o ∃ z (o ∊ esat u E b w ∧ y = nest o z)} $ by ex_elim [y3_x1, b5]
y3: $ … ⇒ e ∊ {y | ∃ o ∃ z (o ∊ esat u E b w ∧ y = nest o z)} $ by ex_elim [y2, y3_y1]
s3: $ … ⇒ x ⊆ {y | ∃ o ∃ z (o ∊ esat u E b w ∧ y = nest o z)} $ by subset_intro [y3]
q0: $ G , x ∊ ipi u E a c w , d ∊ esat u E b w ⇒ d ∊ esat u E b w $ by ax
q1: $ G , x ∊ ipi u E a c w , d ∊ esat u E b w ⇒ esat u E a w = esat u E b w $ by weaken [#1]
q2: $ G , x ∊ ipi u E a c w , d ∊ esat u E b w ⇒ ∀ i (da (E' c) w i = da (E' f) w i) $ by weaken [#2]
q3a: $ … ⇒ ∀ d (d ∊ esat u E a w → apn x d ∈ da (E' c) w d) $ by and_elim_r [s2]
q3: $ G , x ∊ ipi u E a c w , d ∊ esat u E b w ⇒ ∀ d (d ∊ esat u E a w → apn x d ∈ da (E' c) w d) $ by weaken [q3a]
q4: $ … ⇒ d ∊ esat u E a w → apn x d ∈ da (E' c) w d $ by all_elim [q3]
q5: $ … ⇒ apn x d ∈ da (E' c) w d $ by imp_elim [q4, welc_eq [eq_sym [q1], q0]]
q6: $ … ⇒ da (E' c) w d = da (E' f) w d $ by all_elim [q2]
q7: $ … ⇒ apn x d ∈ da (E' f) w d $ by wcel_eq_r [q6, q5]
s4: $ … ⇒ ∀ d (d ∊ esat u E b w → apn x d ∈ da (E' f) w d) $ by all_intro [imp_intro [q7]]
s5: $ … ⇒ x ∈ ipi u E b f w ↔ (x ⊆ {y | ∃ o ∃ z (o ∊ esat u E b w ∧ y = nest o z)} ∧ ∀ d (d ∊ esat u E b w → apn x d ∈ da (E' f) w d)) $ by ipi_wcel [sx]
s6: $ … ⇒ x ∊ ipi u E b f w $ by wcel_welc [bi_elim_r [s5, and_intro [s3, s4]]]
fin: $ … ⇒ ipi u E a c w ⊆ ipi u E b f w $ by subset_intro [s6]

ipi_eq_da
----
l1: $ … ⇒ da (E' c) w i = da (E' f) w i $ by all_elim [#2]
l2: $ … ⇒ ∀ i (da (E' f) w i = da (E' c) w i) $ by all_intro [eq_sym [l1]]
l3: $ … ⇒ ipi u E a c w = ipi u E b f w $ by subset_antisym [d4_ipi_sub [#1, #2], d4_ipi_sub [eq_sym [#1], l2]]

lemma d4_igate_l (G: hyps) (M J: class) (u d e p q t v w: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_ceqv p q ∈ lrel2 $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ tsub' d ⊆ einv u M w $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ igate u (dnf u M) d J w $ > $ G ⇒ igate u (dnf u M) e J w $
----
u0: $ G , igate u (dnf u M) d J w ⇒ ∃ x1 ∃ x2 ∃ x3 (iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w) $ by ax
u1: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 (iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w) $ by imp_elim [imp_intro [u0], #8]
k0: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w ⇒ iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w $ by ax
k1: $ … ⇒ iprt d x1 x2 $ by and_elim_l [k0]
k2: $ … ⇒ ityf d J x3 $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w $ by and_elim_r [and_elim_r [k0]]
w1: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w ⇒ iprt d p t $ by weaken [#1]
m1: $ … ⇒ p = x1 ∧ t = x2 $ by iprt_det [w1, k1]
w7: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w ⇒ d ∊ trees ω $ by weaken [#7]
m5a: $ … ⇒ p ∈ tsub' d ∧ t ∈ tsub' d $ by iprt_tsub [welc_wcel [w7], w1]
w6: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w ⇒ tsub' d ⊆ einv u M w $ by weaken [#6]
m5b: $ … ⇒ tsub' p ⊆ einv u M w $ by subset_trans [tsub_trans [and_elim_l [m5a]], w6]
w3: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w ⇒ ra_ceqv p q ∈ lrel2 $ by weaken [#3]
w5: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w ⇒ w ∊ lvals $ by weaken [#5]
m5e: $ … ⇒ esat u (dnf u M) p w = esat u (dnf u M) q w $ by ceqv_esat [w3, w5, m5b]
w2: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w ⇒ iprt e q v $ by weaken [#2]
w4: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#4]
m7: $ … ⇒ ∃ y (ityf e J y ∧ ra_eeqv x3 y ∈ lrel2) $ by d4_ityf_l [w1, w2, w4, k2]
i0: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 $ by ax
i1: $ … ⇒ ityf e J y $ by and_elim_l [i0]
i2: $ … ⇒ ra_eeqv x3 y ∈ lrel2 $ by and_elim_r [i0]
jk2: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ ityf d J x3 $ by weaken [k2]
jk3: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w $ by weaken [k3]
jm1: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ p = x1 ∧ t = x2 $ by weaken [m1]
jm5e: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ esat u (dnf u M) p w = esat u (dnf u M) q w $ by weaken [m5e]
iw7: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ d ∊ trees ω $ by weaken [#7]
n1: $ … ⇒ x3 ∈ tsub' d $ by ityf_tsub [welc_wcel [iw7], jk2]
iw6: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ tsub' d ⊆ einv u M w $ by weaken [#6]
n2: $ … ⇒ x3 ∊ einv u M w $ by subset_elim [iw6, wcel_welc [n1]]
n3a: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ isset i $ by isset_var
n3: $ … ⇒ dt u M x3 w i = dt u M y w i $ by einv_elim [n2, i2, n3a]
n4: $ … ⇒ ∀ i (da ((dnf u M)' x3) w i = da ((dnf u M)' y) w i) $ by all_intro [n3]
rw: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ w = w $ by eq_refl
n5: $ … ⇒ esat u (dnf u M) x1 w = esat u (dnf u M) q w $ by eq_trans [esat_eq [eq_sym [and_elim_l [jm1]], rw], jm5e]
n6: $ … ⇒ ipi u (dnf u M) x1 x3 w = ipi u (dnf u M) q y w $ by ipi_eq_da [n5, n4]
iw1: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ iprt d p t $ by weaken [#1]
iw2: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ iprt e q v $ by weaken [#2]
iw3: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ ra_ceqv p q ∈ lrel2 $ by weaken [#3]
iw4: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#4]
iw5: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ w ∊ lvals $ by weaken [#5]
n7: $ … ⇒ ity u (dnf u M) d J w = ity u (dnf u M) e J w $ by ity_eqv [iw1, iw2, iw3, iw4, iw5, iw6, iw7]
n8: $ … ⇒ ity u (dnf u M) e J w ∈ ipi u (dnf u M) q y w $ by wcel_eq_l [n7, wcel_eq_r [n6, jk3]]
n9: $ … ⇒ iprt e q v ∧ ityf e J y ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) q y w $ by and_intro [iw2, and_intro [i1, n8]]
n10: $ … ⇒ ∃ c (iprt e q v ∧ ityf e J c ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) q c w) $ by ex_intro [n9]
n11: $ … ⇒ ∃ b ∃ c (iprt e q b ∧ ityf e J c ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) q c w) $ by ex_intro [n10]
n12: $ … ⇒ ∃ a ∃ b ∃ c (iprt e a b ∧ ityf e J c ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) a c w) $ by ex_intro [n11]
n13: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 , ∃ a ∃ b ∃ c (iprt e a b ∧ ityf e J c ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) a c w) ⇒ igate u (dnf u M) e J w $ by ax
n14: $ G , iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w , ityf e J y ∧ ra_eeqv x3 y ∈ lrel2 ⇒ igate u (dnf u M) e J w $ by imp_elim [imp_intro [n13], n12]
m8: $ … ⇒ igate u (dnf u M) e J w $ by ex_elim [m7, n14]
fin_x2: $ G , ∃ x3 (iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w) ⇒ ∃ x3 (iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w) $ by ax
fin_y2: $ … ⇒ igate u (dnf u M) e J w $ by ex_elim [fin_x2, m8]
fin_x1: $ G , ∃ x2 ∃ x3 (iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w) ⇒ ∃ x2 ∃ x3 (iprt d x1 x2 ∧ ityf d J x3 ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) x1 x3 w) $ by ax
fin_y1: $ … ⇒ igate u (dnf u M) e J w $ by ex_elim [fin_x1, fin_y2]
fin: $ … ⇒ igate u (dnf u M) e J w $ by ex_elim [u1, fin_y1]

lemma d4_igate_r (G: hyps) (M J: class) (u d e p q t v w: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_ceqv p q ∈ lrel2 $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ tsub' d ⊆ einv u M w $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ igate u (dnf u M) e J w $ > $ G ⇒ igate u (dnf u M) d J w $
----
u0: $ G , igate u (dnf u M) e J w ⇒ ∃ x1 ∃ x2 ∃ x3 (iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w) $ by ax
u1: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 (iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w) $ by imp_elim [imp_intro [u0], #8]
k0: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w ⇒ iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w $ by ax
k1: $ … ⇒ iprt e x1 x2 $ by and_elim_l [k0]
k2: $ … ⇒ ityf e J x3 $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w $ by and_elim_r [and_elim_r [k0]]
w2: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w ⇒ iprt e q v $ by weaken [#2]
m1: $ … ⇒ q = x1 ∧ v = x2 $ by iprt_det [w2, k1]
w7: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w ⇒ d ∊ trees ω $ by weaken [#7]
w1: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w ⇒ iprt d p t $ by weaken [#1]
m5a: $ … ⇒ p ∈ tsub' d ∧ t ∈ tsub' d $ by iprt_tsub [welc_wcel [w7], w1]
w6: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w ⇒ tsub' d ⊆ einv u M w $ by weaken [#6]
m5b: $ … ⇒ tsub' p ⊆ einv u M w $ by subset_trans [tsub_trans [and_elim_l [m5a]], w6]
w3: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w ⇒ ra_ceqv p q ∈ lrel2 $ by weaken [#3]
w5: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w ⇒ w ∊ lvals $ by weaken [#5]
m5e: $ … ⇒ esat u (dnf u M) p w = esat u (dnf u M) q w $ by ceqv_esat [w3, w5, m5b]
w4: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#4]
m7: $ … ⇒ ∃ y (ityf d J y ∧ ra_eeqv y x3 ∈ lrel2) $ by d4_ityf_r [w1, w2, w4, k2]
i0: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 $ by ax
i1: $ … ⇒ ityf d J y $ by and_elim_l [i0]
i2: $ … ⇒ ra_eeqv y x3 ∈ lrel2 $ by and_elim_r [i0]
jk3: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w $ by weaken [k3]
jm1: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ q = x1 ∧ v = x2 $ by weaken [m1]
jm5e: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ esat u (dnf u M) p w = esat u (dnf u M) q w $ by weaken [m5e]
iw7: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ d ∊ trees ω $ by weaken [#7]
n1: $ … ⇒ y ∈ tsub' d $ by ityf_tsub [welc_wcel [iw7], i1]
iw6: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ tsub' d ⊆ einv u M w $ by weaken [#6]
n2: $ … ⇒ y ∊ einv u M w $ by subset_elim [iw6, wcel_welc [n1]]
n3a: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ isset i $ by isset_var
n3: $ … ⇒ dt u M y w i = dt u M x3 w i $ by einv_elim [n2, i2, n3a]
n4: $ … ⇒ ∀ i (da ((dnf u M)' x3) w i = da ((dnf u M)' y) w i) $ by all_intro [eq_sym [n3]]
rw: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ w = w $ by eq_refl
n5: $ … ⇒ esat u (dnf u M) x1 w = esat u (dnf u M) p w $ by eq_trans [esat_eq [eq_sym [and_elim_l [jm1]], rw], eq_sym [jm5e]]
n6: $ … ⇒ ipi u (dnf u M) x1 x3 w = ipi u (dnf u M) p y w $ by ipi_eq_da [n5, n4]
iw1: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ iprt d p t $ by weaken [#1]
iw2: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ iprt e q v $ by weaken [#2]
iw3: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ ra_ceqv p q ∈ lrel2 $ by weaken [#3]
iw4: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#4]
iw5: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ w ∊ lvals $ by weaken [#5]
n7: $ … ⇒ ity u (dnf u M) d J w = ity u (dnf u M) e J w $ by ity_eqv [iw1, iw2, iw3, iw4, iw5, iw6, iw7]
n8: $ … ⇒ ity u (dnf u M) d J w ∈ ipi u (dnf u M) p y w $ by wcel_eq_l [eq_sym [n7], wcel_eq_r [n6, jk3]]
n9: $ … ⇒ iprt d p t ∧ ityf d J y ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) p y w $ by and_intro [iw1, and_intro [i1, n8]]
n10: $ … ⇒ ∃ c (iprt d p t ∧ ityf d J c ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) p c w) $ by ex_intro [n9]
n11: $ … ⇒ ∃ b ∃ c (iprt d p b ∧ ityf d J c ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) p c w) $ by ex_intro [n10]
n12: $ … ⇒ ∃ a ∃ b ∃ c (iprt d a b ∧ ityf d J c ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) a c w) $ by ex_intro [n11]
n13: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 , ∃ a ∃ b ∃ c (iprt d a b ∧ ityf d J c ∧ ity u (dnf u M) d J w ∈ ipi u (dnf u M) a c w) ⇒ igate u (dnf u M) d J w $ by ax
n14: $ G , iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w , ityf d J y ∧ ra_eeqv y x3 ∈ lrel2 ⇒ igate u (dnf u M) d J w $ by imp_elim [imp_intro [n13], n12]
m8: $ … ⇒ igate u (dnf u M) d J w $ by ex_elim [m7, n14]
fin_x2: $ G , ∃ x3 (iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w) ⇒ ∃ x3 (iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w) $ by ax
fin_y2: $ … ⇒ igate u (dnf u M) d J w $ by ex_elim [fin_x2, m8]
fin_x1: $ G , ∃ x2 ∃ x3 (iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w) ⇒ ∃ x2 ∃ x3 (iprt e x1 x2 ∧ ityf e J x3 ∧ ity u (dnf u M) e J w ∈ ipi u (dnf u M) x1 x3 w) $ by ax
fin_y1: $ … ⇒ igate u (dnf u M) d J w $ by ex_elim [fin_x1, fin_y2]
fin: $ … ⇒ igate u (dnf u M) d J w $ by ex_elim [u1, fin_y1]

ityv_eqv
----
p0: $ G , igate u (dnf u M) d J w ⇒ igate u (dnf u M) d J w $ by ax
wp1: $ G , igate u (dnf u M) d J w ⇒ iprt d p t $ by weaken [#1]
wp2: $ G , igate u (dnf u M) d J w ⇒ iprt e q v $ by weaken [#2]
wp3: $ G , igate u (dnf u M) d J w ⇒ ra_ceqv p q ∈ lrel2 $ by weaken [#3]
wp4: $ G , igate u (dnf u M) d J w ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#4]
wp5: $ G , igate u (dnf u M) d J w ⇒ w ∊ lvals $ by weaken [#5]
wp6: $ G , igate u (dnf u M) d J w ⇒ tsub' d ⊆ einv u M w $ by weaken [#6]
wp7: $ G , igate u (dnf u M) d J w ⇒ d ∊ trees ω $ by weaken [#7]
p1: $ … ⇒ igate u (dnf u M) e J w $ by d4_igate_l [wp1, wp2, wp3, wp4, wp5, wp6, wp7, p0]
p2: $ … ⇒ ity u (dnf u M) d J w = ity u (dnf u M) e J w $ by ity_eqv [wp1, wp2, wp3, wp4, wp5, wp6, wp7]
p3: $ … ⇒ ityv u (dnf u M) d J w = ityv u (dnf u M) e J w $ by eq_trans [ityv_gate [p0], eq_trans [p2, eq_sym [ityv_gate [p1]]]]
n0: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ igate u (dnf u M) e J w $ by ax
n00: $ G , ¬ igate u (dnf u M) d J w ⇒ ¬ igate u (dnf u M) d J w $ by ax
n01: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ ¬ igate u (dnf u M) d J w $ by weaken [n00]
wn1: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ iprt d p t $ by weaken [#1]
wn2: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ iprt e q v $ by weaken [#2]
wn3: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ ra_ceqv p q ∈ lrel2 $ by weaken [#3]
wn4: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#4]
wn5: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ w ∊ lvals $ by weaken [#5]
wn6: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ tsub' d ⊆ einv u M w $ by weaken [#6]
wn7: $ G , ¬ igate u (dnf u M) d J w , igate u (dnf u M) e J w ⇒ d ∊ trees ω $ by weaken [#7]
n1: $ … ⇒ igate u (dnf u M) d J w $ by d4_igate_r [wn1, wn2, wn3, wn4, wn5, wn6, wn7, n0]
n2: $ … ⇒ ⊥ $ by not_elim [n01, n1]
n3: $ … ⇒ ¬ igate u (dnf u M) e J w $ by not_intro [n2]
wm1: $ G , ¬ igate u (dnf u M) d J w ⇒ iprt d p t $ by weaken [#1]
wm2: $ G , ¬ igate u (dnf u M) d J w ⇒ iprt e q v $ by weaken [#2]
wm3: $ G , ¬ igate u (dnf u M) d J w ⇒ ra_ceqv p q ∈ lrel2 $ by weaken [#3]
wm4: $ G , ¬ igate u (dnf u M) d J w ⇒ ra_teqv t v ∈ lrel2 $ by weaken [#4]
wm5: $ G , ¬ igate u (dnf u M) d J w ⇒ w ∊ lvals $ by weaken [#5]
wm6: $ G , ¬ igate u (dnf u M) d J w ⇒ tsub' d ⊆ einv u M w $ by weaken [#6]
wm7: $ G , ¬ igate u (dnf u M) d J w ⇒ d ∊ trees ω $ by weaken [#7]
n4: $ … ⇒ itriv u (dnf u M) d J w = itriv u (dnf u M) e J w $ by itriv_eqv [wm1, wm2, wm3, wm4, wm5, wm6, wm7]
n5: $ … ⇒ ityv u (dnf u M) d J w = ityv u (dnf u M) e J w $ by eq_trans [ityv_ngate [n00], eq_trans [n4, eq_sym [ityv_ngate [n3]]]]
o1: $ G ⇒ igate u (dnf u M) d J w ∨ ¬ igate u (dnf u M) d J w $ by excluded_middle
fin: $ … ⇒ ityv u (dnf u M) d J w = ityv u (dnf u M) e J w $ by or_elim [o1, p3, n5]

ind_eqv_iprt
----
s0: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (d = x1 ∧ e = x2 ∧ ra_ind_data x1 x3 x4 x8 ∈ lrel ∧ ra_ind_data x2 x3 x5 x9 ∈ lrel ∧ ra_ceqv x4 x5 ∈ lrel2 ∧ ra_teqv x8 x9 ∈ lrel2 ∧ ra_ind_nested x1 x6 ∈ lrel ∧ ra_ind_nested x2 x7 ∈ lrel ∧ ra_ceqv x6 x7 ∈ lrel2) $ by lrel2_ind_eqv_cases [#1]
k0: $ G , d = x1 ∧ e = x2 ∧ ra_ind_data x1 x3 x4 x8 ∈ lrel ∧ ra_ind_data x2 x3 x5 x9 ∈ lrel ∧ ra_ceqv x4 x5 ∈ lrel2 ∧ ra_teqv x8 x9 ∈ lrel2 ∧ ra_ind_nested x1 x6 ∈ lrel ∧ ra_ind_nested x2 x7 ∈ lrel ∧ ra_ceqv x6 x7 ∈ lrel2 ⇒ d = x1 ∧ e = x2 ∧ ra_ind_data x1 x3 x4 x8 ∈ lrel ∧ ra_ind_data x2 x3 x5 x9 ∈ lrel ∧ ra_ceqv x4 x5 ∈ lrel2 ∧ ra_teqv x8 x9 ∈ lrel2 ∧ ra_ind_nested x1 x6 ∈ lrel ∧ ra_ind_nested x2 x7 ∈ lrel ∧ ra_ceqv x6 x7 ∈ lrel2 $ by ax
k1: $ … ⇒ d = x1 $ by and_elim_l [k0]
k2: $ … ⇒ e = x2 $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ ra_ind_data x1 x3 x4 x8 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [k0]]]
k4: $ … ⇒ ra_ind_data x2 x3 x5 x9 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [k0]]]]
k5: $ … ⇒ ra_ceqv x4 x5 ∈ lrel2 $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [k0]]]]]
k6: $ … ⇒ ra_teqv x8 x9 ∈ lrel2 $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [k0]]]]]]
r_x3: $ G , d = x1 ∧ e = x2 ∧ ra_ind_data x1 x3 x4 x8 ∈ lrel ∧ ra_ind_data x2 x3 x5 x9 ∈ lrel ∧ ra_ceqv x4 x5 ∈ lrel2 ∧ ra_teqv x8 x9 ∈ lrel2 ∧ ra_ind_nested x1 x6 ∈ lrel ∧ ra_ind_nested x2 x7 ∈ lrel ∧ ra_ceqv x6 x7 ∈ lrel2 ⇒ x3 = x3 $ by eq_refl
