lemma d4_ntl_all (G: hyps): $ G ⇒ trees ω ⊆ d4_ntl $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntl , y = ⟨ k , j ⟩ , ra_teqv y c ∈ lrel2 , ra_ntys y n m ∈ lrel ⇒ crn j ⊆ d4_ntl $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntl , y = ⟨ k , j ⟩ , ra_teqv y c ∈ lrel2 , ra_ntys y n m ∈ lrel ⇒ y = ⟨ k , j ⟩ $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntl , y = ⟨ k , j ⟩ , ra_teqv y c ∈ lrel2 , ra_ntys y n m ∈ lrel ⇒ ra_teqv y c ∈ lrel2 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntl , y = ⟨ k , j ⟩ , ra_teqv y c ∈ lrel2 , ra_ntys y n m ∈ lrel ⇒ ra_ntys y n m ∈ lrel $ by ax
n1: $ … ⇒ ra_ntys c n m ∈ lrel $ by d4_ntl_node [a1, a2, a3, a4]
n2: $ … ⇒ ra_teqv y c ∈ lrel2 → ra_ntys y n m ∈ lrel → ra_ntys c n m ∈ lrel $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ c ∀ n ∀ m (ra_teqv y c ∈ lrel2 → ra_ntys y n m ∈ lrel → ra_ntys c n m ∈ lrel) $ by all_intro [all_intro [all_intro [n2]]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntl , y = ⟨ k , j ⟩ ⇒ y ∊ d4_ntl $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntl , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ntl $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ntl ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ntl $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ntl → ⟨ k , j ⟩ ∈ d4_ntl $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ntl → ⟨ k , j ⟩ ∈ d4_ntl) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_ntl $ by trees_ind_c [n11, n10]

teqv_ntys_l
----
l1: $ G ⇒ trees ω ⊆ d4_ntl $ by d4_ntl_all
l2a: $ G ⇒ kr_teqv ∈ ω $ by kr_teqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by d4_atoms2 [#1, l2a]
l3: $ … ⇒ t1 ∊ d4_ntl $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ra_ntys t2 n m ∈ lrel $ by d4_ntl_e [l3, #1, #2]

def d4_ntr (.y .c .n .m: set): class = $ {y | ∀ c ∀ n ∀ m (ra_teqv y c ∈ lrel2 → ra_ntys c n m ∈ lrel → ra_ntys y n m ∈ lrel)} $

lemma d4_ntr_e (G: hyps) (ty tc tn tm: set): $ G ⇒ ty ∊ d4_ntr $ > $ G ⇒ ra_teqv ty tc ∈ lrel2 $ > $ G ⇒ ra_ntys tc tn tm ∈ lrel $ > $ G ⇒ ra_ntys ty tn tm ∈ lrel $
----
l0: $ … ⇒ ∀ c ∀ n ∀ m (ra_teqv ty c ∈ lrel2 → ra_ntys c n m ∈ lrel → ra_ntys ty n m ∈ lrel) $ by cab_elim [#1]
l1: $ … ⇒ ∀ n ∀ m (ra_teqv ty tc ∈ lrel2 → ra_ntys tc n m ∈ lrel → ra_ntys ty n m ∈ lrel) $ by all_elim [l0]
l2: $ … ⇒ ∀ m (ra_teqv ty tc ∈ lrel2 → ra_ntys tc tn m ∈ lrel → ra_ntys ty tn m ∈ lrel) $ by all_elim [l1]
l3: $ … ⇒ ra_teqv ty tc ∈ lrel2 → ra_ntys tc tn tm ∈ lrel → ra_ntys ty tn tm ∈ lrel $ by all_elim [l2]
fin: $ … ⇒ ra_ntys ty tn tm ∈ lrel $ by imp_elim [imp_elim [l3, #2], #3]

lemma d4_ntr_node (G: hyps) (y c n m k1 j1: set): $ G ⇒ crn j1 ⊆ d4_ntr $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_teqv y c ∈ lrel2 $ > $ G ⇒ ra_ntys c n m ∈ lrel $ > $ G ⇒ ra_ntys y n m ∈ lrel $
----
s0: $ … ⇒ (y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (y = ⟨ kc_tcons , scons x1 (scons x3 (scons x5 ∅)) ⟩ ∧ c = ⟨ kc_tcons , scons x2 (scons x4 (scons x6 ∅)) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x3 x4 ∈ lrel2 ∧ ra_teqv x5 x6 ∈ lrel2) $ by lrel2_teqv_cases [#3]
a0: $ G , y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩ ⇒ y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩ $ by ax
a4: $ G , y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩ ⇒ ra_ntys c n m ∈ lrel $ by weaken [#4]
ar_n: $ G , y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩ ⇒ n = n $ by eq_refl
ar_m: $ G , y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩ ⇒ m = m $ by eq_refl
a5: $ … ⇒ ra_ntys y n m ∈ lrel $ by wcel_eq_l [ra_ntys_eq [eq_trans [and_elim_r [a0], eq_sym [and_elim_l [a0]]], ar_n, ar_m], a4]
b0: $ G , y = ⟨ kc_tcons , scons x1 (scons x3 (scons x5 ∅)) ⟩ ∧ c = ⟨ kc_tcons , scons x2 (scons x4 (scons x6 ∅)) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x3 x4 ∈ lrel2 ∧ ra_teqv x5 x6 ∈ lrel2 ⇒ y = ⟨ kc_tcons , scons x1 (scons x3 (scons x5 ∅)) ⟩ ∧ c = ⟨ kc_tcons , scons x2 (scons x4 (scons x6 ∅)) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x3 x4 ∈ lrel2 ∧ ra_teqv x5 x6 ∈ lrel2 $ by ax
