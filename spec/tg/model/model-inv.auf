b10_y1: $ … ⇒ ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2) $ by ex_elim [b10_x1, b10_y2]
b10_x0: $ G , ∃ x1 ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) ⇒ ∃ x1 ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) $ by ax
b10: $ … ⇒ ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2) $ by ex_elim [b10_x0, b10_y1]
fin: $ … ⇒ ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2) $ by or_elim [s0, a6, b10]

lemma d4_cnr_all (G: hyps): $ G ⇒ trees ω ⊆ d4_cnr $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnr , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_nth_ctor c i f ∈ lrel ⇒ crn j ⊆ d4_cnr $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnr , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_nth_ctor c i f ∈ lrel ⇒ y = ⟨ k , j ⟩ $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnr , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_nth_ctor c i f ∈ lrel ⇒ ra_cseqv y c ∈ lrel2 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnr , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_nth_ctor c i f ∈ lrel ⇒ ra_nth_ctor c i f ∈ lrel $ by ax
n1: $ … ⇒ ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2) $ by d4_cnr_node [a1, a2, a3, a4]
n2: $ … ⇒ ra_cseqv y c ∈ lrel2 → ra_nth_ctor c i f ∈ lrel → ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2) $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ c ∀ i ∀ f (ra_cseqv y c ∈ lrel2 → ra_nth_ctor c i f ∈ lrel → ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2)) $ by all_intro [all_intro [all_intro [n2]]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnr , y = ⟨ k , j ⟩ ⇒ y ∊ d4_cnr $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnr , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_cnr $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnr ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_cnr $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_cnr → ⟨ k , j ⟩ ∈ d4_cnr $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_cnr → ⟨ k , j ⟩ ∈ d4_cnr) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_cnr $ by trees_ind_c [n11, n10]

cseqv_nth_ctor_r
----
l1: $ G ⇒ trees ω ⊆ d4_cnr $ by d4_cnr_all
l2a: $ G ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by d4_atoms2 [#1, l2a]
l3: $ … ⇒ t1 ∊ d4_cnr $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ∃ p (ra_nth_ctor t1 i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2) $ by d4_cnr_e [l3, #1, #2]

lveq_refl
----
l1: $ G , x ∊ lvals ⇒ lv A x = lv A x $ by eq_refl
l2: $ … ⇒ ∀ x (x ∊ lvals → lv A x = lv A x) $ by all_intro [imp_intro [l1]]
l3: $ G , ∀ x (x ∊ lvals → lv A x = lv A x) ⇒ lveq A A $ by ax
l4: $ … ⇒ lveq A A $ by imp_elim [imp_intro [l3], l2]

def d4_isl (.y .c .b .d .x: set): class = $ {y | ∀ c ∀ b ∀ d (ra_eeqv y c ∈ lrel2 → ra_isort y b d ∈ lrel → ∃ x (ra_isort c b x ∈ lrel ∧ lveq d x))} $

lemma d4_isl_e {x: set} (G: hyps) (ty tc tb td: set): $ G ⇒ ty ∊ d4_isl $ > $ G ⇒ ra_eeqv ty tc ∈ lrel2 $ > $ G ⇒ ra_isort ty tb td ∈ lrel $ > $ G ⇒ ∃ x (ra_isort tc tb x ∈ lrel ∧ lveq td x) $
----
l0: $ … ⇒ ∀ c ∀ b ∀ d (ra_eeqv ty c ∈ lrel2 → ra_isort ty b d ∈ lrel → ∃ x (ra_isort c b x ∈ lrel ∧ lveq d x)) $ by cab_elim [#1]
l1: $ … ⇒ ∀ b ∀ d (ra_eeqv ty tc ∈ lrel2 → ra_isort ty b d ∈ lrel → ∃ x (ra_isort tc b x ∈ lrel ∧ lveq d x)) $ by all_elim [l0]
l2: $ … ⇒ ∀ d (ra_eeqv ty tc ∈ lrel2 → ra_isort ty tb d ∈ lrel → ∃ x (ra_isort tc tb x ∈ lrel ∧ lveq d x)) $ by all_elim [l1]
l3: $ … ⇒ ra_eeqv ty tc ∈ lrel2 → ra_isort ty tb td ∈ lrel → ∃ x (ra_isort tc tb x ∈ lrel ∧ lveq td x) $ by all_elim [l2]
fin: $ … ⇒ ∃ x (ra_isort tc tb x ∈ lrel ∧ lveq td x) $ by imp_elim [imp_elim [l3, #2], #3]

lemma d4_isl_node {x: set} (G: hyps) (z k j t b d: set): $ G ⇒ crn j ⊆ d4_isl $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ ra_eeqv z t ∈ lrel2 $ > $ G ⇒ ra_isort z b d ∈ lrel $ > $ G ⇒ ∃ x (ra_isort t b x ∈ lrel ∧ lveq d x) $
----
d0: $ … ⇒ ∃ e (z = e ∧ t = e) ∨ ∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2) $ by lrel2_eeqv_cases [#3]
t0: $ … ⇒ z ∊ trees ω ∧ t ∊ trees ω $ by lrel2_eeqv_trees [#3]
k0c: $ G , z = e ∧ t = e ⇒ z = e ∧ t = e $ by ax
k0p1: $ … ⇒ z = e $ by and_elim_l [k0c]
k0p2: $ … ⇒ t = e $ by and_elim_r [k0c]
k0w4: $ G , z = e ∧ t = e ⇒ ra_isort z b d ∈ lrel $ by weaken [#4]
k0rb: $ G , z = e ∧ t = e ⇒ b = b $ by eq_refl
k0rd: $ G , z = e ∧ t = e ⇒ d = d $ by eq_refl
k0i: $ … ⇒ ra_isort t b d ∈ lrel $ by wcel_eq_l [ra_isort_eq [eq_trans [k0p1, eq_sym [k0p2]], k0rb, k0rd], k0w4]
k0l: $ G , z = e ∧ t = e ⇒ lveq d d $ by lveq_refl
k0g: $ … ⇒ ∃ x (ra_isort t b x ∈ lrel ∧ lveq d x) $ by ex_intro [and_intro [k0i, k0l]]
k0: $ … ⇒ (z = e ∧ t = e) → ∃ x (ra_isort t b x ∈ lrel ∧ lveq d x) $ by imp_intro [k0g]
k0a0: $ … ⇒ ∀ e (((z = e ∧ t = e)) → ∃ x (ra_isort t b x ∈ lrel ∧ lveq d x)) $ by all_intro [k0]
k0b0: $ … ⇒ (∃ e (z = e ∧ t = e)) → ∃ x (ra_isort t b x ∈ lrel ∧ lveq d x) $ by ex_elim_imp [k0a0]
k1c: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ $ by ax
k1p1: $ … ⇒ z = ⟨ kc_bvar , scons i ∅ ⟩ $ by and_elim_l [k1c]
k1w4: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ ra_isort z b d ∈ lrel $ by weaken [#4]
k1s: $ … ⇒ ∃ y (z = ⟨ kc_srt , scons y ∅ ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ d = y) ∨ ∃ u ∃ w ∃ r ∃ y (z = ⟨ kc_pi , scons u (scons w ∅) ⟩ ∧ b = ⟨ kc_s , scons r ∅ ⟩ ∧ d = y ∧ ra_isort w r y ∈ lrel) $ by lrel_isort_cases [k1w4]
k1S0: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_srt , scons y ∅ ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ d = y ⇒ z = ⟨ kc_srt , scons y ∅ ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ d = y $ by ax
k1S1: $ … ⇒ z = ⟨ kc_srt , scons y ∅ ⟩ $ by and_elim_l [k1S0]
k1Se: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_srt , scons y ∅ ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ d = y ⇒ z = ⟨ kc_bvar , scons i ∅ ⟩ $ by weaken [k1p1]
k1P0: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_pi , scons u (scons w ∅) ⟩ ∧ b = ⟨ kc_s , scons r ∅ ⟩ ∧ d = y ∧ ra_isort w r y ∈ lrel ⇒ z = ⟨ kc_pi , scons u (scons w ∅) ⟩ ∧ b = ⟨ kc_s , scons r ∅ ⟩ ∧ d = y ∧ ra_isort w r y ∈ lrel $ by ax
k1P1: $ … ⇒ z = ⟨ kc_pi , scons u (scons w ∅) ⟩ $ by and_elim_l [k1P0]
k1Pe: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_pi , scons u (scons w ∅) ⟩ ∧ b = ⟨ kc_s , scons r ∅ ⟩ ∧ d = y ∧ ra_isort w r y ∈ lrel ⇒ z = ⟨ kc_bvar , scons i ∅ ⟩ $ by weaken [k1p1]
k1Sc1: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_srt , scons y ∅ ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ d = y ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
k1Sc2: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_srt , scons y ∅ ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ d = y ⇒ kc_srt ∈ ω $ by kc_srt_omega
k1Sc3: $ … ⇒ ⟨ kc_bvar , scons i ∅ ⟩ = ⟨ kc_srt , scons y ∅ ⟩ $ by eq_trans [eq_sym [k1Se], k1S1]
k1Sc4: $ … ⇒ kc_bvar = kc_srt $ by opair_inj_l_c [k1Sc3, wcel_isset [k1Sc1], wcel_isset [k1Sc2]]
k1Sc5: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_srt , scons y ∅ ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ d = y ⇒ ¬ kc_bvar = kc_srt $ by kc_bvar_ne_srt
k1Sc6: $ … ⇒ ∃ x (ra_isort t b x ∈ lrel ∧ lveq d x) $ by bot_elim [not_elim [k1Sc5, k1Sc4]]
k1Pc1: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_pi , scons u (scons w ∅) ⟩ ∧ b = ⟨ kc_s , scons r ∅ ⟩ ∧ d = y ∧ ra_isort w r y ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
k1Pc2: $ G , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ , z = ⟨ kc_pi , scons u (scons w ∅) ⟩ ∧ b = ⟨ kc_s , scons r ∅ ⟩ ∧ d = y ∧ ra_isort w r y ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
k1Pc3: $ … ⇒ ⟨ kc_bvar , scons i ∅ ⟩ = ⟨ kc_pi , scons u (scons w ∅) ⟩ $ by eq_trans [eq_sym [k1Pe], k1P1]
