k5: $ … ⇒ ∃ x (⟨ J , ⟨ x1 , x ⟩ ⟩ ∈ Z ∧ ((iprop d J w ∧ z = nest x1 ∅) ∨ (¬ iprop d J w ∧ z = nest x1 x))) $ by ex_intro [k4]
k6: $ … ⇒ ∃ a ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop d J w ∧ z = nest a ∅) ∨ (¬ iprop d J w ∧ z = nest a x))) $ by ex_intro [k5]
