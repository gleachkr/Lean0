def d4_tnl (.y .c .i .f .e .p .q: set): class = $ {y | ∀ c ∀ i ∀ f ∀ e (ra_teqv y c ∈ lrel2 → ra_nth_ty y i f e ∈ lrel → ∃ p ∃ q (ra_nth_ty c i p q ∈ lrel ∧ ra_eeqv f p ∈ lrel2 ∧ ra_cseqv e q ∈ lrel2))} $

lemma d4_tnl_e {p q: set} (G: hyps) (ty tc ti tf te: set): $ G ⇒ ty ∊ d4_tnl $ > $ G ⇒ ra_teqv ty tc ∈ lrel2 $ > $ G ⇒ ra_nth_ty ty ti tf te ∈ lrel $ > $ G ⇒ ∃ p ∃ q (ra_nth_ty tc ti p q ∈ lrel ∧ ra_eeqv tf p ∈ lrel2 ∧ ra_cseqv te q ∈ lrel2) $
----
l0: $ … ⇒ ∀ c ∀ i ∀ f ∀ e (ra_teqv ty c ∈ lrel2 → ra_nth_ty ty i f e ∈ lrel → ∃ p ∃ q (ra_nth_ty c i p q ∈ lrel ∧ ra_eeqv f p ∈ lrel2 ∧ ra_cseqv e q ∈ lrel2)) $ by cab_elim [#1]
l1: $ … ⇒ ∀ i ∀ f ∀ e (ra_teqv ty tc ∈ lrel2 → ra_nth_ty ty i f e ∈ lrel → ∃ p ∃ q (ra_nth_ty tc i p q ∈ lrel ∧ ra_eeqv f p ∈ lrel2 ∧ ra_cseqv e q ∈ lrel2)) $ by all_elim [l0]
l2: $ … ⇒ ∀ f ∀ e (ra_teqv ty tc ∈ lrel2 → ra_nth_ty ty ti f e ∈ lrel → ∃ p ∃ q (ra_nth_ty tc ti p q ∈ lrel ∧ ra_eeqv f p ∈ lrel2 ∧ ra_cseqv e q ∈ lrel2)) $ by all_elim [l1]
l3: $ … ⇒ ∀ e (ra_teqv ty tc ∈ lrel2 → ra_nth_ty ty ti tf e ∈ lrel → ∃ p ∃ q (ra_nth_ty tc ti p q ∈ lrel ∧ ra_eeqv tf p ∈ lrel2 ∧ ra_cseqv e q ∈ lrel2)) $ by all_elim [l2]
l4: $ … ⇒ ra_teqv ty tc ∈ lrel2 → ra_nth_ty ty ti tf te ∈ lrel → ∃ p ∃ q (ra_nth_ty tc ti p q ∈ lrel ∧ ra_eeqv tf p ∈ lrel2 ∧ ra_cseqv te q ∈ lrel2) $ by all_elim [l3]
fin: $ … ⇒ ∃ p ∃ q (ra_nth_ty tc ti p q ∈ lrel ∧ ra_eeqv tf p ∈ lrel2 ∧ ra_cseqv te q ∈ lrel2) $ by imp_elim [imp_elim [l4, #2], #3]

lemma d4_tnl_node {p q: set} (G: hyps) (y c i f e k1 j1: set): $ G ⇒ crn j1 ⊆ d4_tnl $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_teqv y c ∈ lrel2 $ > $ G ⇒ ra_nth_ty y i f e ∈ lrel $ > $ G ⇒ ∃ p ∃ q (ra_nth_ty c i p q ∈ lrel ∧ ra_eeqv f p ∈ lrel2 ∧ ra_cseqv e q ∈ lrel2) $
