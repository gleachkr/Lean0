o2: $ … ⇒ (∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2)) → etel u (dnf u M) z w r = etel u (dnf u M) t w r $ by or_elim_imp [k2b0, o3]
o1: $ … ⇒ (∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2)) → etel u (dnf u M) z w r = etel u (dnf u M) t w r $ by or_elim_imp [k1b0, o2]
o0: $ … ⇒ (∃ e (z = e ∧ t = e) ∨ ∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2)) → etel u (dnf u M) z w r = etel u (dnf u M) t w r $ by or_elim_imp [k0b0, o1]
fin: $ … ⇒ etel u (dnf u M) z w r = etel u (dnf u M) t w r $ by imp_elim [o0, d0]

lemma d4_et_all (G: hyps) (M: class) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ trees ω ⊆ d4_et u M w $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ , ra_eeqv y c ∈ lrel2 , tsub' y ⊆ einv u M w , r ∊ fseq u ⇒ crn j ⊆ d4_et u M w $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ , ra_eeqv y c ∈ lrel2 , tsub' y ⊆ einv u M w , r ∊ fseq u ⇒ tsub' y ⊆ einv u M w $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ , ra_eeqv y c ∈ lrel2 , tsub' y ⊆ einv u M w , r ∊ fseq u ⇒ w ∊ lvals $ by weaken [#1]
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ , ra_eeqv y c ∈ lrel2 , tsub' y ⊆ einv u M w , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
a5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ , ra_eeqv y c ∈ lrel2 , tsub' y ⊆ einv u M w , r ∊ fseq u ⇒ y = ⟨ k , j ⟩ $ by ax
a6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ , ra_eeqv y c ∈ lrel2 , tsub' y ⊆ einv u M w , r ∊ fseq u ⇒ k ∊ ω $ by ax
a7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ , ra_eeqv y c ∈ lrel2 , tsub' y ⊆ einv u M w , r ∊ fseq u ⇒ j ∊ fseq (trees ω) $ by ax
a8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ , ra_eeqv y c ∈ lrel2 , tsub' y ⊆ einv u M w , r ∊ fseq u ⇒ ra_eeqv y c ∈ lrel2 $ by ax
n1: $ … ⇒ etel u (dnf u M) y w r = etel u (dnf u M) c w r $ by d4_et_node [a1, a2, a3, a4, a5, a6, a7, a8]
n2: $ … ⇒ ra_eeqv y c ∈ lrel2 → tsub' y ⊆ einv u M w → r ∊ fseq u → etel u (dnf u M) y w r = etel u (dnf u M) c w r $ by imp_intro [imp_intro [imp_intro [n1]]]
n3: $ … ⇒ ∀ c ∀ r (ra_eeqv y c ∈ lrel2 → tsub' y ⊆ einv u M w → r ∊ fseq u → etel u (dnf u M) y w r = etel u (dnf u M) c w r) $ by all_intro [all_intro [n2]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ ⇒ y ∊ d4_et u M w $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_et u M w $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_et u M w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_et u M w $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_et u M w → ⟨ k , j ⟩ ∈ d4_et u M w $ by imp_intro [imp_intro [imp_intro [n8]]]
