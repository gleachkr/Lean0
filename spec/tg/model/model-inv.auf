def d4_tnr (.y .c .i .f .e .p .q: set): class = $ {y | ∀ c ∀ i ∀ f ∀ e (ra_teqv y c ∈ lrel2 → ra_nth_ty c i f e ∈ lrel → ∃ p ∃ q (ra_nth_ty y i p q ∈ lrel ∧ ra_eeqv p f ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2))} $

lemma d4_tnr_e {p q: set} (G: hyps) (ty tc ti tf te: set): $ G ⇒ ty ∊ d4_tnr $ > $ G ⇒ ra_teqv ty tc ∈ lrel2 $ > $ G ⇒ ra_nth_ty tc ti tf te ∈ lrel $ > $ G ⇒ ∃ p ∃ q (ra_nth_ty ty ti p q ∈ lrel ∧ ra_eeqv p tf ∈ lrel2 ∧ ra_cseqv q te ∈ lrel2) $
----
l0: $ … ⇒ ∀ c ∀ i ∀ f ∀ e (ra_teqv ty c ∈ lrel2 → ra_nth_ty c i f e ∈ lrel → ∃ p ∃ q (ra_nth_ty ty i p q ∈ lrel ∧ ra_eeqv p f ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2)) $ by cab_elim [#1]
l1: $ … ⇒ ∀ i ∀ f ∀ e (ra_teqv ty tc ∈ lrel2 → ra_nth_ty tc i f e ∈ lrel → ∃ p ∃ q (ra_nth_ty ty i p q ∈ lrel ∧ ra_eeqv p f ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2)) $ by all_elim [l0]
l2: $ … ⇒ ∀ f ∀ e (ra_teqv ty tc ∈ lrel2 → ra_nth_ty tc ti f e ∈ lrel → ∃ p ∃ q (ra_nth_ty ty ti p q ∈ lrel ∧ ra_eeqv p f ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2)) $ by all_elim [l1]
l3: $ … ⇒ ∀ e (ra_teqv ty tc ∈ lrel2 → ra_nth_ty tc ti tf e ∈ lrel → ∃ p ∃ q (ra_nth_ty ty ti p q ∈ lrel ∧ ra_eeqv p tf ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2)) $ by all_elim [l2]
l4: $ … ⇒ ra_teqv ty tc ∈ lrel2 → ra_nth_ty tc ti tf te ∈ lrel → ∃ p ∃ q (ra_nth_ty ty ti p q ∈ lrel ∧ ra_eeqv p tf ∈ lrel2 ∧ ra_cseqv q te ∈ lrel2) $ by all_elim [l3]
fin: $ … ⇒ ∃ p ∃ q (ra_nth_ty ty ti p q ∈ lrel ∧ ra_eeqv p tf ∈ lrel2 ∧ ra_cseqv q te ∈ lrel2) $ by imp_elim [imp_elim [l4, #2], #3]

lemma d4_tnr_node {p q: set} (G: hyps) (y c i f e k1 j1: set): $ G ⇒ crn j1 ⊆ d4_tnr $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_teqv y c ∈ lrel2 $ > $ G ⇒ ra_nth_ty c i f e ∈ lrel $ > $ G ⇒ ∃ p ∃ q (ra_nth_ty y i p q ∈ lrel ∧ ra_eeqv p f ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2) $
