ient_eqv
----
l1: $ … ⇒ ient d w Z J = ient e w Z J $ by subset_antisym [d4_ient_l [#1, #2, #3, #4], d4_ient_r [#1, #2, #3, #4]]

lemma d4_ixs_sub {i: set} (G: hyps) (Z: class) (d e w: set): $ G ⇒ intys d = intys e $ > $ G ⇒ ∀ i (ient d w Z i = ient e w Z i) $ > $ G ⇒ ixs d w Z ⊆ ixs e w Z $
----
s0: $ G , c ∊ ixs d w Z ⇒ c ∊ ixs d w Z $ by ax
s1: $ … ⇒ ∃ x1 (x1 ∊ intys d ∧ c = ⟨ x1 , ient d w Z x1 ⟩) $ by cab_elim [s0]
k0: $ G , c ∊ ixs d w Z , x1 ∊ intys d ∧ c = ⟨ x1 , ient d w Z x1 ⟩ ⇒ x1 ∊ intys d ∧ c = ⟨ x1 , ient d w Z x1 ⟩ $ by ax
w1: $ G , c ∊ ixs d w Z , x1 ∊ intys d ∧ c = ⟨ x1 , ient d w Z x1 ⟩ ⇒ intys d = intys e $ by weaken [#1]
w2: $ G , c ∊ ixs d w Z , x1 ∊ intys d ∧ c = ⟨ x1 , ient d w Z x1 ⟩ ⇒ ∀ i (ient d w Z i = ient e w Z i) $ by weaken [#2]
k1: $ … ⇒ x1 ∊ intys e $ by welc_eq [w1, and_elim_l [k0]]
k2: $ … ⇒ ient d w Z x1 = ient e w Z x1 $ by all_elim [w2]
r1: $ G , c ∊ ixs d w Z , x1 ∊ intys d ∧ c = ⟨ x1 , ient d w Z x1 ⟩ ⇒ x1 = x1 $ by eq_refl
k3: $ … ⇒ c = ⟨ x1 , ient e w Z x1 ⟩ $ by eq_trans [and_elim_r [k0], opair_eq [r1, k2]]
k4: $ … ⇒ ∃ j (j ∊ intys e ∧ c = ⟨ j , ient e w Z j ⟩) $ by ex_intro [and_intro [k1, k3]]
k5: $ … ⇒ c ∊ {z | ∃ j (j ∊ intys e ∧ z = ⟨ j , ient e w Z j ⟩)} $ by cab_intro [k4]
k6: $ G , c ∊ ixs d w Z , x1 ∊ intys d ∧ c = ⟨ x1 , ient d w Z x1 ⟩ ⇒ ixs e w Z = {z | ∃ j (j ∊ intys e ∧ z = ⟨ j , ient e w Z j ⟩)} $ by eq_refl
k7: $ … ⇒ c ∊ ixs e w Z $ by welc_eq [eq_sym [k6], k5]
s2: $ … ⇒ c ∊ ixs e w Z $ by ex_elim [s1, k7]
fin: $ … ⇒ ixs d w Z ⊆ ixs e w Z $ by subset_intro [s2]

ixs_eqv
----
i1: $ … ⇒ intys d = intys e $ by intys_eqv [#1, #2, #3]
i2: $ … ⇒ ient d w Z i = ient e w Z i $ by ient_eqv [#1, #2, #3, #4]
i3: $ … ⇒ ∀ i (ient d w Z i = ient e w Z i) $ by all_intro [i2]
i4: $ … ⇒ ∀ i (ient e w Z i = ient d w Z i) $ by all_intro [eq_sym [i2]]
i5: $ … ⇒ ixs d w Z = ixs e w Z $ by subset_antisym [d4_ixs_sub [i1, i3], d4_ixs_sub [eq_sym [i1], i4]]

etel_outer_fseq
----
a1: $ G , y = Q , y ∊ etel u E c w R ⇒ y ∊ etel u E c w R $ by ax
a2: $ G , y = Q , y ∊ etel u E c w R ⇒ c ∊ trees ω $ by weaken [#1]
a3: $ … ⇒ isset w ∧ isset R $ by etel_isset [a2, a1]
b1: $ G , y = Q , y ∊ etel u E c w R , x = R ⇒ x = R $ by ax
b2: $ G , y = Q , y ∊ etel u E c w R , x = R ⇒ c ∊ trees ω $ by weaken [#1]
b3: $ G , y = Q , y ∊ etel u E c w R , x = R ⇒ Q ∈ etel u E c w R $ by weaken [#2]
rc: $ G , y = Q , y ∊ etel u E c w R , x = R ⇒ c = c $ by eq_refl
rw: $ G , y = Q , y ∊ etel u E c w R , x = R ⇒ w = w $ by eq_refl
b4: $ … ⇒ Q ∈ etel u E c w x $ by wcel_eq_r [etel_eq [rc, rw, eq_sym [b1]], b3]
b5: $ … ⇒ w ∊ lvals ∧ x ∊ fseq u $ by etel_dom [b2, b4]
b6: $ … ⇒ R ∈ fseq u $ by wcel_eq_l [b1, welc_wcel [and_elim_r [b5]]]
a4: $ … ⇒ R ∈ fseq u $ by isset_elim [and_elim_r [a3], b6]
a5: $ … ⇒ R ∈ fseq u $ by wcel_elim [#2, a4]

lemma d4_iop0_l (G: hyps) (M Z: class) (u d e p q t v w: set): $ G ⇒ iprt d p t $ > $ G ⇒ iprt e q v $ > $ G ⇒ ra_ceqv p q ∈ lrel2 $ > $ G ⇒ ra_teqv t v ∈ lrel2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ tsub' d ⊆ einv u M w $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ ixs d w Z = ixs e w Z $ > $ G ⇒ iop0 u (dnf u M) d w Z ⊆ iop0 u (dnf u M) e w Z $
----
s0: $ G , z ∊ iop0 u (dnf u M) d w Z ⇒ z ∊ iop0 u (dnf u M) d w Z $ by ax
s1: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 (iprt d x2 x3 ∧ x1 ∊ esat u (dnf u M) x2 w ∧ ictk d x4 x5 x6 ∧ ⟨ x7 , ⟨ x8 , ⟨ x9 , x0 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x6 w (x1 ++ ixs d w Z) ∧ x0 ∊ fseq u ∧ z = ⟨ x4 , ⟨ x0 , scons x5 x8 ⟩ ⟩) $ by cab_elim [s0]
k0: $ G , z ∊ iop0 u (dnf u M) d w Z , iprt d x2 x3 ∧ x1 ∊ esat u (dnf u M) x2 w ∧ ictk d x4 x5 x6 ∧ ⟨ x7 , ⟨ x8 , ⟨ x9 , x0 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x6 w (x1 ++ ixs d w Z) ∧ x0 ∊ fseq u ∧ z = ⟨ x4 , ⟨ x0 , scons x5 x8 ⟩ ⟩ ⇒ iprt d x2 x3 ∧ x1 ∊ esat u (dnf u M) x2 w ∧ ictk d x4 x5 x6 ∧ ⟨ x7 , ⟨ x8 , ⟨ x9 , x0 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x6 w (x1 ++ ixs d w Z) ∧ x0 ∊ fseq u ∧ z = ⟨ x4 , ⟨ x0 , scons x5 x8 ⟩ ⟩ $ by ax
k1: $ … ⇒ iprt d x2 x3 $ by and_elim_l [k0]
k2: $ … ⇒ x1 ∊ esat u (dnf u M) x2 w $ by and_elim_l [and_elim_r [k0]]
