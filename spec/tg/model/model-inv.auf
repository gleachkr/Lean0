bv2: $ G , y = ⟨ kc_tcons , scons x1 (scons x3 (scons x5 ∅)) ⟩ ∧ c = ⟨ kc_tcons , scons x2 (scons x4 (scons x6 ∅)) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x3 x4 ∈ lrel2 ∧ ra_teqv x5 x6 ∈ lrel2 ⇒ y = ⟨ k1 , j1 ⟩ $ by weaken [#2]
bv4: $ G , y = ⟨ kc_tcons , scons x1 (scons x3 (scons x5 ∅)) ⟩ ∧ c = ⟨ kc_tcons , scons x2 (scons x4 (scons x6 ∅)) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x3 x4 ∈ lrel2 ∧ ra_teqv x5 x6 ∈ lrel2 ⇒ ra_ntys c n m ∈ lrel $ by weaken [#4]
