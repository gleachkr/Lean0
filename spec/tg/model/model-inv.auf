o2: $ … ⇒ (∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2)) → ∃ x (ra_isort z b x ∈ lrel ∧ lveq x d) $ by or_elim_imp [k2b0, o3]
o1: $ … ⇒ (∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2)) → ∃ x (ra_isort z b x ∈ lrel ∧ lveq x d) $ by or_elim_imp [k1b0, o2]
o0: $ … ⇒ (∃ e (z = e ∧ t = e) ∨ ∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2)) → ∃ x (ra_isort z b x ∈ lrel ∧ lveq x d) $ by or_elim_imp [k0b0, o1]
fin: $ … ⇒ ∃ x (ra_isort z b x ∈ lrel ∧ lveq x d) $ by imp_elim [o0, d0]

lemma d4_isr_all (G: hyps): $ G ⇒ trees ω ⊆ d4_isr $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_isr , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 , ra_isort t b d ∈ lrel ⇒ crn j ⊆ d4_isr $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_isr , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 , ra_isort t b d ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_isr , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 , ra_isort t b d ∈ lrel ⇒ ra_eeqv z t ∈ lrel2 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_isr , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 , ra_isort t b d ∈ lrel ⇒ ra_isort t b d ∈ lrel $ by ax
n1: $ … ⇒ ∃ x (ra_isort z b x ∈ lrel ∧ lveq x d) $ by d4_isr_node [a1, a2, a3, a4]
n2: $ … ⇒ ra_eeqv z t ∈ lrel2 → ra_isort t b d ∈ lrel → ∃ x (ra_isort z b x ∈ lrel ∧ lveq x d) $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ t ∀ b ∀ d (ra_eeqv z t ∈ lrel2 → ra_isort t b d ∈ lrel → ∃ x (ra_isort z b x ∈ lrel ∧ lveq x d)) $ by all_intro [all_intro [all_intro [n2]]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_isr , z = ⟨ k , j ⟩ ⇒ z ∊ d4_isr $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_isr , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_isr $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_isr ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_isr $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_isr → ⟨ k , j ⟩ ∈ d4_isr $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_isr → ⟨ k , j ⟩ ∈ d4_isr) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_isr $ by trees_ind_c [n11, n10]

eeqv_isort_r
----
l1: $ G ⇒ trees ω ⊆ d4_isr $ by d4_isr_all
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by lrel2_eeqv_trees [#1]
l3: $ … ⇒ t1 ∊ d4_isr $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ∃ x (ra_isort t1 k x ∈ lrel ∧ lveq x l) $ by d4_isr_e [l3, #1, #2]

def d4_ccl (.y .c .n: set): class = $ {y | ∀ c ∀ n (ra_cseqv y c ∈ lrel2 → ra_clen_c y n ∈ lrel → ra_clen_c c n ∈ lrel)} $

lemma d4_ccl_e (G: hyps) (ty tc tn: set): $ G ⇒ ty ∊ d4_ccl $ > $ G ⇒ ra_cseqv ty tc ∈ lrel2 $ > $ G ⇒ ra_clen_c ty tn ∈ lrel $ > $ G ⇒ ra_clen_c tc tn ∈ lrel $
----
l0: $ … ⇒ ∀ c ∀ n (ra_cseqv ty c ∈ lrel2 → ra_clen_c ty n ∈ lrel → ra_clen_c c n ∈ lrel) $ by cab_elim [#1]
l1: $ … ⇒ ∀ n (ra_cseqv ty tc ∈ lrel2 → ra_clen_c ty n ∈ lrel → ra_clen_c tc n ∈ lrel) $ by all_elim [l0]
l2: $ … ⇒ ra_cseqv ty tc ∈ lrel2 → ra_clen_c ty tn ∈ lrel → ra_clen_c tc tn ∈ lrel $ by all_elim [l1]
fin: $ … ⇒ ra_clen_c tc tn ∈ lrel $ by imp_elim [imp_elim [l2, #2], #3]

lemma d4_ccl_node (G: hyps) (y c n k1 j1: set): $ G ⇒ crn j1 ⊆ d4_ccl $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_cseqv y c ∈ lrel2 $ > $ G ⇒ ra_clen_c y n ∈ lrel $ > $ G ⇒ ra_clen_c c n ∈ lrel $
----
s0: $ … ⇒ (y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) $ by lrel2_cseqv_cases [#3]
a0: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ ⇒ y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ $ by ax
a4: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ ⇒ ra_clen_c y n ∈ lrel $ by weaken [#4]
ar_n: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ ⇒ n = n $ by eq_refl
a5: $ … ⇒ ra_clen_c c n ∈ lrel $ by wcel_eq_l [ra_clen_c_eq [eq_trans [and_elim_l [a0], eq_sym [and_elim_r [a0]]], ar_n], a4]
b0: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 $ by ax
bp1: $ … ⇒ y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ $ by and_elim_l [b0]
bp3: $ … ⇒ ra_eeqv x1 x2 ∈ lrel2 $ by and_elim_l [and_elim_r [and_elim_r [b0]]]
bp4: $ … ⇒ ra_cseqv x5 x6 ∈ lrel2 $ by and_elim_r [and_elim_r [and_elim_r [b0]]]
bv1: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ crn j1 ⊆ d4_ccl $ by weaken [#1]
bv2: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ y = ⟨ k1 , j1 ⟩ $ by weaken [#2]
bv4: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ ra_clen_c y n ∈ lrel $ by weaken [#4]
bS: $ … ⇒ y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ $ by and_elim_l [b0]
bD: $ … ⇒ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ $ by and_elim_l [and_elim_r [b0]]
bt0: $ … ⇒ x1 ∊ trees ω ∧ x2 ∊ trees ω $ by lrel2_eeqv_trees [bp3]
bt1a: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
bt1: $ … ⇒ x5 ∊ trees ω ∧ x6 ∊ trees ω $ by d4_atoms2 [bp4, bt1a]
bs: $ … ⇒ (y = ⟨ kc_cnil , ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ d ∃ r (y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel) $ by lrel_clen_c_cases [bv4]
bk: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
c0: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_cnil , ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ y = ⟨ kc_cnil , ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ $ by ax
cS: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_cnil , ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ $ by weaken [bS]
c1: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_cnil , ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cnil ∈ ω $ by kc_cnil_omega
c2: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_cnil , ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
c3: $ … ⇒ ⟨ kc_cnil , ∅ ⟩ = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ $ by eq_trans [eq_sym [and_elim_l [c0]], cS]
c4: $ … ⇒ kc_cnil = kc_ccons $ by opair_inj_l_c [c3, wcel_isset [c1], wcel_isset [c2]]
c5: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_cnil , ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_cnil = kc_ccons $ by kc_cnil_ne_ccons
c6: $ … ⇒ ra_clen_c c n ∈ lrel $ by bot_elim [not_elim [c5, c4]]
bj1: $ … ⇒ ⟨ k1 , j1 ⟩ = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ $ by eq_trans [eq_sym [bv2], bp1]
bis_k1: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ isset k1 $ by isset_var
bis_j1: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ isset j1 $ by isset_var
bis_x5: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ isset x5 $ by isset_var
bie: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 ⇒ isset ∅ $ by ax_empty
bj2: $ … ⇒ k1 = kc_ccons ∧ j1 = scons x1 (scons x5 ∅) $ by opair_inj_c [bj1, bis_k1, bis_j1, wcel_isset [bk], scons_set [scons_set [bie]]]
bj3: $ … ⇒ crn (scons x1 (scons x5 ∅)) ⊆ d4_ccl $ by subset_eq_l [crn_eq [and_elim_r [bj2]], bv1]
bq: $ … ⇒ x5 ∈ d4_ccl $ by crn_scons_head [bis_x5, crn_scons_tail [bj3]]
t0: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel $ by ax
tp1: $ … ⇒ y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ $ by and_elim_l [t0]
tp2: $ … ⇒ n = ⟨ kc_s , scons r ∅ ⟩ $ by and_elim_l [and_elim_r [t0]]
tp3: $ … ⇒ ra_clen_c d r ∈ lrel $ by and_elim_r [and_elim_r [t0]]
tS: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ $ by weaken [bS]
tD: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ $ by weaken [bD]
tk: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ kc_ccons ∈ ω $ by weaken [bk]
tq: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ x5 ∈ d4_ccl $ by weaken [bq]
tt0: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ x1 ∊ trees ω ∧ x2 ∊ trees ω $ by weaken [bt0]
tt1: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ x5 ∊ trees ω ∧ x6 ∊ trees ω $ by weaken [bt1]
tr1: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ ra_cseqv x5 x6 ∈ lrel2 $ by weaken [bp4]
t1: $ … ⇒ ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ = ⟨ kc_ccons , scons a (scons d ∅) ⟩ $ by eq_trans [eq_sym [tS], tp1]
t2: $ … ⇒ x1 = a ∧ x5 = d $ by node2_inj [wcel_isset [tk], t1]
rr: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ r = r $ by eq_refl
t3: $ … ⇒ ra_clen_c x5 r ∈ lrel $ by wcel_eq_l [ra_clen_c_eq [eq_sym [and_elim_r [t2]], rr], tp3]
t4: $ … ⇒ ra_clen_c x6 r ∈ lrel $ by d4_ccl_e [wcel_welc [tq], tr1, t3]
t5a: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel ⇒ kr_clen_c ∈ ω $ by kr_clen_c_omega
t5: $ … ⇒ x6 ∊ trees ω ∧ r ∊ trees ω $ by lrel_args2 [t4, wcel_isset [t5a]]
t6: $ … ⇒ ra_clen_c ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ⟨ kc_s , scons r ∅ ⟩ ∈ lrel $ by lrel_clen_c_cons [welc_wcel [and_elim_r [tt0]], welc_wcel [and_elim_r [tt1]], welc_wcel [and_elim_r [t5]], t4]
t7: $ … ⇒ ra_clen_c c n ∈ lrel $ by wcel_eq_l [ra_clen_c_eq [eq_sym [tD], eq_sym [tp2]], t6]
t8_x2: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , ∃ r (y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel) ⇒ ∃ r (y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel) $ by ax
t8_y2: $ … ⇒ ra_clen_c c n ∈ lrel $ by ex_elim [t8_x2, t7]
t8_x1: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , ∃ d ∃ r (y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel) ⇒ ∃ d ∃ r (y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel) $ by ax
t8_y1: $ … ⇒ ra_clen_c c n ∈ lrel $ by ex_elim [t8_x1, t8_y2]
t8_x0: $ G , y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2 , ∃ a ∃ d ∃ r (y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel) ⇒ ∃ a ∃ d ∃ r (y = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ n = ⟨ kc_s , scons r ∅ ⟩ ∧ ra_clen_c d r ∈ lrel) $ by ax
t8: $ … ⇒ ra_clen_c c n ∈ lrel $ by ex_elim [t8_x0, t8_y1]
b9: $ … ⇒ ra_clen_c c n ∈ lrel $ by or_elim [bs, c6, t8]
b10_x3: $ G , ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) ⇒ ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) $ by ax
b10_y3: $ … ⇒ ra_clen_c c n ∈ lrel $ by ex_elim [b10_x3, b9]
b10_x2: $ G , ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) ⇒ ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) $ by ax
b10_y2: $ … ⇒ ra_clen_c c n ∈ lrel $ by ex_elim [b10_x2, b10_y3]
b10_x1: $ G , ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) ⇒ ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) $ by ax
b10_y1: $ … ⇒ ra_clen_c c n ∈ lrel $ by ex_elim [b10_x1, b10_y2]
b10_x0: $ G , ∃ x1 ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) ⇒ ∃ x1 ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) $ by ax
b10: $ … ⇒ ra_clen_c c n ∈ lrel $ by ex_elim [b10_x0, b10_y1]
fin: $ … ⇒ ra_clen_c c n ∈ lrel $ by or_elim [s0, a5, b10]

lemma d4_ccl_all (G: hyps): $ G ⇒ trees ω ⊆ d4_ccl $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccl , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_clen_c y n ∈ lrel ⇒ crn j ⊆ d4_ccl $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccl , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_clen_c y n ∈ lrel ⇒ y = ⟨ k , j ⟩ $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccl , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_clen_c y n ∈ lrel ⇒ ra_cseqv y c ∈ lrel2 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccl , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_clen_c y n ∈ lrel ⇒ ra_clen_c y n ∈ lrel $ by ax
n1: $ … ⇒ ra_clen_c c n ∈ lrel $ by d4_ccl_node [a1, a2, a3, a4]
n2: $ … ⇒ ra_cseqv y c ∈ lrel2 → ra_clen_c y n ∈ lrel → ra_clen_c c n ∈ lrel $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ c ∀ n (ra_cseqv y c ∈ lrel2 → ra_clen_c y n ∈ lrel → ra_clen_c c n ∈ lrel) $ by all_intro [all_intro [n2]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccl , y = ⟨ k , j ⟩ ⇒ y ∊ d4_ccl $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccl , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ccl $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccl ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ccl $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ccl → ⟨ k , j ⟩ ∈ d4_ccl $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ccl → ⟨ k , j ⟩ ∈ d4_ccl) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_ccl $ by trees_ind_c [n11, n10]

cseqv_clen_c_l
----
l1: $ G ⇒ trees ω ⊆ d4_ccl $ by d4_ccl_all
l2a: $ G ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by d4_atoms2 [#1, l2a]
l3: $ … ⇒ t1 ∊ d4_ccl $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ra_clen_c t2 n ∈ lrel $ by d4_ccl_e [l3, #1, #2]

def d4_ccr (.y .c .n: set): class = $ {y | ∀ c ∀ n (ra_cseqv y c ∈ lrel2 → ra_clen_c c n ∈ lrel → ra_clen_c y n ∈ lrel)} $

lemma d4_ccr_e (G: hyps) (ty tc tn: set): $ G ⇒ ty ∊ d4_ccr $ > $ G ⇒ ra_cseqv ty tc ∈ lrel2 $ > $ G ⇒ ra_clen_c tc tn ∈ lrel $ > $ G ⇒ ra_clen_c ty tn ∈ lrel $
----
l0: $ … ⇒ ∀ c ∀ n (ra_cseqv ty c ∈ lrel2 → ra_clen_c c n ∈ lrel → ra_clen_c ty n ∈ lrel) $ by cab_elim [#1]
l1: $ … ⇒ ∀ n (ra_cseqv ty tc ∈ lrel2 → ra_clen_c tc n ∈ lrel → ra_clen_c ty n ∈ lrel) $ by all_elim [l0]
l2: $ … ⇒ ra_cseqv ty tc ∈ lrel2 → ra_clen_c tc tn ∈ lrel → ra_clen_c ty tn ∈ lrel $ by all_elim [l1]
fin: $ … ⇒ ra_clen_c ty tn ∈ lrel $ by imp_elim [imp_elim [l2, #2], #3]

lemma d4_ccr_node (G: hyps) (y c n k1 j1: set): $ G ⇒ crn j1 ⊆ d4_ccr $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_cseqv y c ∈ lrel2 $ > $ G ⇒ ra_clen_c c n ∈ lrel $ > $ G ⇒ ra_clen_c y n ∈ lrel $
----
s0: $ … ⇒ (y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) $ by lrel2_cseqv_cases [#3]
a0: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ ⇒ y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ $ by ax
a4: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ ⇒ ra_clen_c c n ∈ lrel $ by weaken [#4]
ar_n: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ ⇒ n = n $ by eq_refl
