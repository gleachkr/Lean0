n2: $ … ⇒ ra_teqv y c ∈ lrel2 → ra_nth_ty c i f e ∈ lrel → ∃ p ∃ q (ra_nth_ty y i p q ∈ lrel ∧ ra_eeqv p f ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2) $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ c ∀ i ∀ f ∀ e (ra_teqv y c ∈ lrel2 → ra_nth_ty c i f e ∈ lrel → ∃ p ∃ q (ra_nth_ty y i p q ∈ lrel ∧ ra_eeqv p f ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2)) $ by all_intro [all_intro [all_intro [all_intro [n2]]]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_tnr , y = ⟨ k , j ⟩ ⇒ y ∊ d4_tnr $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_tnr , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_tnr $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_tnr ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_tnr $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_tnr → ⟨ k , j ⟩ ∈ d4_tnr $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_tnr → ⟨ k , j ⟩ ∈ d4_tnr) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_tnr $ by trees_ind_c [n11, n10]

teqv_nth_ty_r
----
l1: $ G ⇒ trees ω ⊆ d4_tnr $ by d4_tnr_all
l2a: $ G ⇒ kr_teqv ∈ ω $ by kr_teqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by d4_atoms2 [#1, l2a]
l3: $ … ⇒ t1 ∊ d4_tnr $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ∃ p ∃ q (ra_nth_ty t1 i p q ∈ lrel ∧ ra_eeqv p f ∈ lrel2 ∧ ra_cseqv q e ∈ lrel2) $ by d4_tnr_e [l3, #1, #2]

def d4_cnl (.y .c .i .f .p: set): class = $ {y | ∀ c ∀ i ∀ f (ra_cseqv y c ∈ lrel2 → ra_nth_ctor y i f ∈ lrel → ∃ p (ra_nth_ctor c i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2))} $

lemma d4_cnl_e {p: set} (G: hyps) (ty tc ti tf: set): $ G ⇒ ty ∊ d4_cnl $ > $ G ⇒ ra_cseqv ty tc ∈ lrel2 $ > $ G ⇒ ra_nth_ctor ty ti tf ∈ lrel $ > $ G ⇒ ∃ p (ra_nth_ctor tc ti p ∈ lrel ∧ ra_eeqv tf p ∈ lrel2) $
----
l0: $ … ⇒ ∀ c ∀ i ∀ f (ra_cseqv ty c ∈ lrel2 → ra_nth_ctor ty i f ∈ lrel → ∃ p (ra_nth_ctor c i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2)) $ by cab_elim [#1]
l1: $ … ⇒ ∀ i ∀ f (ra_cseqv ty tc ∈ lrel2 → ra_nth_ctor ty i f ∈ lrel → ∃ p (ra_nth_ctor tc i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2)) $ by all_elim [l0]
l2: $ … ⇒ ∀ f (ra_cseqv ty tc ∈ lrel2 → ra_nth_ctor ty ti f ∈ lrel → ∃ p (ra_nth_ctor tc ti p ∈ lrel ∧ ra_eeqv f p ∈ lrel2)) $ by all_elim [l1]
l3: $ … ⇒ ra_cseqv ty tc ∈ lrel2 → ra_nth_ctor ty ti tf ∈ lrel → ∃ p (ra_nth_ctor tc ti p ∈ lrel ∧ ra_eeqv tf p ∈ lrel2) $ by all_elim [l2]
fin: $ … ⇒ ∃ p (ra_nth_ctor tc ti p ∈ lrel ∧ ra_eeqv tf p ∈ lrel2) $ by imp_elim [imp_elim [l3, #2], #3]

lemma d4_cnl_node {p: set} (G: hyps) (y c i f k1 j1: set): $ G ⇒ crn j1 ⊆ d4_cnl $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_cseqv y c ∈ lrel2 $ > $ G ⇒ ra_nth_ctor y i f ∈ lrel $ > $ G ⇒ ∃ p (ra_nth_ctor c i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2) $
