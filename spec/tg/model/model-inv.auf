--| The trees whose subtrees are all invariant.
def d4_Q (U M W: class) (.y: set): class = $ {y | tsub' y ⊆ einv U M W} $

lemma d4_q_e (G: hyps) (M: class) (u w c x: set): $ G ⇒ c ∊ d4_Q u M w $ > $ G ⇒ x ∊ tsub' c $ > $ G ⇒ x ∊ einv u M w $
----
l1: $ … ⇒ tsub' c ⊆ einv u M w $ by cab_elim [#1]
l2: $ … ⇒ x ∊ einv u M w $ by subset_elim [l1, #2]

lemma d4_psub (G: hyps) (M: class) (u w j: set): $ G ⇒ crn j ⊆ d4_Q u M w $ > $ G ⇒ psub j ⊆ einv u M w $
----
p0: $ G , x ∊ psub j ⇒ x ∊ psub j $ by ax
p1: $ G , x ∊ psub j , c ∊ crn j , x ∊ tsub' c ⇒ c ∊ crn j $ by ax
p2: $ G , x ∊ psub j , c ∊ crn j , x ∊ tsub' c ⇒ x ∊ tsub' c $ by ax
p3: $ G , x ∊ psub j , c ∊ crn j , x ∊ tsub' c ⇒ crn j ⊆ d4_Q u M w $ by weaken [#1]
p4: $ … ⇒ x ∊ einv u M w $ by d4_q_e [subset_elim [p3, p1], p2]
p5: $ … ⇒ x ∊ einv u M w $ by psub_elim [p0, p4]
p6: $ … ⇒ psub j ⊆ einv u M w $ by subset_intro [p5]

lemma d4_kids (G: hyps) (M: class) (u w j: set): $ G ⇒ crn j ⊆ d4_Q u M w $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ einv u M w $
----
c1: $ G , c ∊ crn j ⇒ c ∊ crn j $ by ax
c2: $ G , c ∊ crn j ⇒ crn j ⊆ d4_Q u M w $ by weaken [#1]
c3: $ G , c ∊ crn j ⇒ j ∊ fseq (trees ω) $ by weaken [#2]
c4: $ … ⇒ c ∊ trees ω $ by subset_elim [fseq_crn [c3], c1]
c5: $ … ⇒ c ∈ tsub' c $ by tsub_self [welc_wcel [c4]]
c6: $ … ⇒ c ∊ einv u M w $ by d4_q_e [subset_elim [c2, c1], wcel_welc [c5]]
c7: $ … ⇒ crn j ⊆ einv u M w $ by subset_intro [c6]

lemma d4_mh {x1 x2 x3 x4 x7 x8: set} (G: hyps) (M: class) (u w z k j: set): $ G ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (uadm x1 → x4 ∊ lvals → x2 ∈ kexa → ⟨ x2 , x3 ⟩ ∈ trees ω → psub x3 ⊆ einv x1 M x4 → ∀ x7 ∀ x8 (ra_eeqv ⟨ x2 , x3 ⟩ x7 ∈ lrel2 → x8 ∊ fseq x1 → dt x1 M ⟨ x2 , x3 ⟩ x4 x8 = dt x1 M x7 x4 x8)) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ psub j ⊆ einv u M w $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ minvh M u w z $
----
h1: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (uadm x1 → x4 ∊ lvals → x2 ∈ kexa → ⟨ x2 , x3 ⟩ ∈ trees ω → psub x3 ⊆ einv x1 M x4 → ∀ x7 ∀ x8 (ra_eeqv ⟨ x2 , x3 ⟩ x7 ∈ lrel2 → x8 ∊ fseq x1 → dt x1 M ⟨ x2 , x3 ⟩ x4 x8 = dt x1 M x7 x4 x8)) $ by weaken [#1]
h2: $ … ⇒ ∀ x2 ∀ x3 ∀ x4 (uadm u → x4 ∊ lvals → x2 ∈ kexa → ⟨ x2 , x3 ⟩ ∈ trees ω → psub x3 ⊆ einv u M x4 → ∀ x7 ∀ x8 (ra_eeqv ⟨ x2 , x3 ⟩ x7 ∈ lrel2 → x8 ∊ fseq u → dt u M ⟨ x2 , x3 ⟩ x4 x8 = dt u M x7 x4 x8)) $ by all_elim (t := $ u $) [h1]
h3: $ … ⇒ ∀ x3 ∀ x4 (uadm u → x4 ∊ lvals → k ∈ kexa → ⟨ k , x3 ⟩ ∈ trees ω → psub x3 ⊆ einv u M x4 → ∀ x7 ∀ x8 (ra_eeqv ⟨ k , x3 ⟩ x7 ∈ lrel2 → x8 ∊ fseq u → dt u M ⟨ k , x3 ⟩ x4 x8 = dt u M x7 x4 x8)) $ by all_elim (t := $ k $) [h2]
h4: $ … ⇒ ∀ x4 (uadm u → x4 ∊ lvals → k ∈ kexa → ⟨ k , j ⟩ ∈ trees ω → psub j ⊆ einv u M x4 → ∀ x7 ∀ x8 (ra_eeqv ⟨ k , j ⟩ x7 ∈ lrel2 → x8 ∊ fseq u → dt u M ⟨ k , j ⟩ x4 x8 = dt u M x7 x4 x8)) $ by all_elim (t := $ j $) [h3]
h5: $ … ⇒ uadm u → w ∊ lvals → k ∈ kexa → ⟨ k , j ⟩ ∈ trees ω → psub j ⊆ einv u M w → ∀ x7 ∀ x8 (ra_eeqv ⟨ k , j ⟩ x7 ∈ lrel2 → x8 ∊ fseq u → dt u M ⟨ k , j ⟩ w x8 = dt u M x7 w x8) $ by all_elim (t := $ w $) [h4]
w2: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ uadm u $ by weaken [#2]
w3: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ w ∊ lvals $ by weaken [#3]
w4: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ k ∊ ω $ by weaken [#4]
w5: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ j ∊ fseq (trees ω) $ by weaken [#5]
w6: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ psub j ⊆ einv u M w $ by weaken [#6]
w7: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ z = ⟨ k , j ⟩ $ by weaken [#7]
z1: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ z = ⟨ x5 , x6 ⟩ $ by ax
z2: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ x5 ∈ kexa $ by ax
z3: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ ra_eeqv z t ∈ lrel2 $ by ax
z4: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
z5: $ … ⇒ ⟨ k , j ⟩ = ⟨ x5 , x6 ⟩ $ by eq_trans [eq_sym [w7], z1]
z6: $ … ⇒ k = x5 $ by opair_inj_l [z5]
z7: $ … ⇒ k ∈ kexa $ by wcel_eq_l [eq_sym [z6], z2]
os: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ isset ω $ by omega_set
z8: $ … ⇒ ⟨ k , j ⟩ ∈ trees ω $ by trees_intro_c [os, welc_wcel [w4], welc_wcel [w5]]
z9: $ … ⇒ ∀ x7 ∀ x8 (ra_eeqv ⟨ k , j ⟩ x7 ∈ lrel2 → x8 ∊ fseq u → dt u M ⟨ k , j ⟩ w x8 = dt u M x7 w x8) $ by imp_elim [imp_elim [imp_elim [imp_elim [imp_elim [h5, w2], w3], z7], z8], w6]
z10: $ … ⇒ ∀ x8 (ra_eeqv ⟨ k , j ⟩ t ∈ lrel2 → x8 ∊ fseq u → dt u M ⟨ k , j ⟩ w x8 = dt u M t w x8) $ by all_elim [z9]
z11: $ … ⇒ ra_eeqv ⟨ k , j ⟩ t ∈ lrel2 → r ∊ fseq u → dt u M ⟨ k , j ⟩ w r = dt u M t w r $ by all_elim [z10]
rt: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ t = t $ by eq_refl
z12: $ … ⇒ ra_eeqv ⟨ k , j ⟩ t ∈ lrel2 $ by wcel_eq_l [ra_eeqv_eq [w7, rt], z3]
z13: $ … ⇒ dt u M ⟨ k , j ⟩ w r = dt u M t w r $ by imp_elim [imp_elim [z11, z12], z4]
ru: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ u = u $ by eq_refl
rM: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ M = M $ by eq_refl
rw: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ w = w $ by eq_refl
rr: $ G , z = ⟨ x5 , x6 ⟩ , x5 ∈ kexa , ra_eeqv z t ∈ lrel2 , r ∊ fseq u ⇒ r = r $ by eq_refl
z14: $ … ⇒ dt u M z w r = dt u M t w r $ by eq_trans [dt_eq [ru, rM, w7, rw, rr], z13]
z15: $ … ⇒ ∀ x5 ∀ x6 ∀ t ∀ r (z = ⟨ x5 , x6 ⟩ → x5 ∈ kexa → ra_eeqv z t ∈ lrel2 → r ∊ fseq u → dt u M z w r = dt u M t w r) $ by all_intro [all_intro [all_intro [all_intro [imp_intro [imp_intro [imp_intro [imp_intro [z14]]]]]]]]
z16: $ G , ∀ x5 ∀ x6 ∀ t ∀ r (z = ⟨ x5 , x6 ⟩ → x5 ∈ kexa → ra_eeqv z t ∈ lrel2 → r ∊ fseq u → dt u M z w r = dt u M t w r) ⇒ minvh M u w z $ by ax
z17: $ … ⇒ minvh M u w z $ by imp_elim [imp_intro [z16], z15]

lemma d4_node {x1 x2 x3 x4 x7 x8: set} (G: hyps) (M: class) (u w z k j: set): $ G ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (uadm x1 → x4 ∊ lvals → x2 ∈ kexa → ⟨ x2 , x3 ⟩ ∈ trees ω → psub x3 ⊆ einv x1 M x4 → ∀ x7 ∀ x8 (ra_eeqv ⟨ x2 , x3 ⟩ x7 ∈ lrel2 → x8 ∊ fseq x1 → dt x1 M ⟨ x2 , x3 ⟩ x4 x8 = dt x1 M x7 x4 x8)) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ d4_Q u M w $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ z ∊ d4_Q u M w $
----
a1: $ … ⇒ psub j ⊆ einv u M w $ by d4_psub [#6]
a2: $ … ⇒ crn j ⊆ einv u M w $ by d4_kids [#6, #5]
a3: $ … ⇒ minvh M u w z $ by d4_mh [#1, #2, #3, #4, #5, a1, #7]
os: $ G ⇒ isset ω $ by omega_set
a4: $ … ⇒ ⟨ k , j ⟩ ∈ trees ω $ by trees_intro_c [os, welc_wcel [#4], welc_wcel [#5]]
a5: $ … ⇒ z ∊ trees ω $ by wcel_welc [wcel_eq_l [eq_sym [#7], a4]]
e1: $ G , ra_eeqv z t ∈ lrel2 ⇒ minvh M u w z $ by weaken [a3]
e2: $ G , ra_eeqv z t ∈ lrel2 ⇒ uadm u $ by weaken [#2]
e3: $ G , ra_eeqv z t ∈ lrel2 ⇒ w ∊ lvals $ by weaken [#3]
e4: $ G , ra_eeqv z t ∈ lrel2 ⇒ crn j ⊆ einv u M w $ by weaken [a2]
e5: $ G , ra_eeqv z t ∈ lrel2 ⇒ z = ⟨ k , j ⟩ $ by weaken [#7]
e6: $ G , ra_eeqv z t ∈ lrel2 ⇒ z ∊ trees ω $ by weaken [a5]
e7: $ G , ra_eeqv z t ∈ lrel2 ⇒ ra_eeqv z t ∈ lrel2 $ by ax
e8: $ … ⇒ dt u M z w r = dt u M t w r $ by lrel2_eeqv_node [e1, e2, e3, e4, e5, e6, e7]
a6: $ … ⇒ z ∊ einv u M w $ by einv_intro [e8]
x0: $ G , x ∊ tsub' z ⇒ x ∊ tsub' z $ by ax
x1: $ G , x ∊ tsub' z ⇒ k ∊ ω $ by weaken [#4]
x2: $ G , x ∊ tsub' z ⇒ j ∊ fseq (trees ω) $ by weaken [#5]
x3: $ … ⇒ tsub' ⟨ k , j ⟩ = csn ⟨ k , j ⟩ ∪ psub j $ by tsub_node [x1, x2]
x4: $ G , x ∊ tsub' z ⇒ z = ⟨ k , j ⟩ $ by weaken [#7]
rt: $ G , x ∊ tsub' z ⇒ tsub = tsub $ by eq_refl
x5: $ … ⇒ x ∊ csn ⟨ k , j ⟩ ∪ psub j $ by welc_eq [eq_trans [fv_eq [rt, x4], x3], x0]
x6: $ … ⇒ x ∊ csn ⟨ k , j ⟩ ∨ x ∊ psub j $ by cun_elim [x5]
y1: $ G , x ∊ tsub' z , x ∊ csn ⟨ k , j ⟩ ⇒ x ∊ csn ⟨ k , j ⟩ $ by ax
y2: $ … ⇒ x = ⟨ k , j ⟩ $ by csn_elim [y1]
y3: $ G , x ∊ tsub' z , x ∊ csn ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by weaken [#7]
y4: $ G , x ∊ tsub' z , x ∊ csn ⟨ k , j ⟩ ⇒ z ∊ einv u M w $ by weaken [a6]
y5: $ … ⇒ x ∊ einv u M w $ by welc_eq_set [eq_trans [y3, eq_sym [y2]], y4]
y6: $ G , x ∊ tsub' z , x ∊ psub j ⇒ x ∊ psub j $ by ax
y7: $ G , x ∊ tsub' z , x ∊ psub j ⇒ psub j ⊆ einv u M w $ by weaken [a1]
y8: $ … ⇒ x ∊ einv u M w $ by subset_elim [y7, y6]
x7: $ … ⇒ x ∊ einv u M w $ by or_elim [x6, y5, y8]
x8: $ … ⇒ tsub' z ⊆ einv u M w $ by subset_intro [x7]
x9: $ G ⇒ z ∊ d4_Q u M w $ by cab_intro [x8]

lemma d4_all {x1 x2 x3 x4 x7 x8: set} (G: hyps) (M: class) (u w: set): $ G ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (uadm x1 → x4 ∊ lvals → x2 ∈ kexa → ⟨ x2 , x3 ⟩ ∈ trees ω → psub x3 ⊆ einv x1 M x4 → ∀ x7 ∀ x8 (ra_eeqv ⟨ x2 , x3 ⟩ x7 ∈ lrel2 → x8 ∊ fseq x1 → dt x1 M ⟨ x2 , x3 ⟩ x4 x8 = dt x1 M x7 x4 x8)) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ trees ω ⊆ d4_Q u M w $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_Q u M w , z = ⟨ k , j ⟩ ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (uadm x1 → x4 ∊ lvals → x2 ∈ kexa → ⟨ x2 , x3 ⟩ ∈ trees ω → psub x3 ⊆ einv x1 M x4 → ∀ x7 ∀ x8 (ra_eeqv ⟨ x2 , x3 ⟩ x7 ∈ lrel2 → x8 ∊ fseq x1 → dt x1 M ⟨ x2 , x3 ⟩ x4 x8 = dt x1 M x7 x4 x8)) $ by weaken [#1]
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_Q u M w , z = ⟨ k , j ⟩ ⇒ uadm u $ by weaken [#2]
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_Q u M w , z = ⟨ k , j ⟩ ⇒ w ∊ lvals $ by weaken [#3]
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_Q u M w , z = ⟨ k , j ⟩ ⇒ k ∊ ω $ by ax
a5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_Q u M w , z = ⟨ k , j ⟩ ⇒ j ∊ fseq (trees ω) $ by ax
a6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_Q u M w , z = ⟨ k , j ⟩ ⇒ crn j ⊆ d4_Q u M w $ by ax
a7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_Q u M w , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
n1: $ … ⇒ z ∊ d4_Q u M w $ by d4_node [a1, a2, a3, a4, a5, a6, a7]
n2: $ … ⇒ ⟨ k , j ⟩ ∈ d4_Q u M w $ by wcel_intro [a7, n1]
n3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_Q u M w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n4: $ … ⇒ ⟨ k , j ⟩ ∈ d4_Q u M w $ by isset_elim [n3, n2]
n5: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_Q u M w → ⟨ k , j ⟩ ∈ d4_Q u M w $ by imp_intro [imp_intro [imp_intro [n4]]]
n6: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_Q u M w → ⟨ k , j ⟩ ∈ d4_Q u M w) $ by all_intro [all_intro [n5]]
n7: $ G ⇒ isset ω $ by omega_set
n8: $ … ⇒ trees ω ⊆ d4_Q u M w $ by trees_ind_c [n7, n6]

minv_intro
----
m1: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ ∀ u ∀ k ∀ s ∀ w (uadm u → w ∊ lvals → k ∈ kexa → ⟨ k , s ⟩ ∈ trees ω → psub s ⊆ einv u M w → ∀ t ∀ r (ra_eeqv ⟨ k , s ⟩ t ∈ lrel2 → r ∊ fseq u → dt u M ⟨ k , s ⟩ w r = dt u M t w r)) $ by weaken [#1]
m2: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ uadm a $ by ax
m3: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ d ∊ lvals $ by ax
m4: $ … ⇒ trees ω ⊆ d4_Q a M d $ by d4_all [m1, m2, m3]
m5: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 $ by ax
m6: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ z = ⟨ b , x0 ⟩ $ by ax
rt: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ c = c $ by eq_refl
m7: $ … ⇒ ra_eeqv z c ∈ lrel2 $ by wcel_eq_l [ra_eeqv_eq [eq_sym [m6], rt], m5]
m8: $ … ⇒ z ∊ trees ω ∧ c ∊ trees ω $ by lrel2_eeqv_trees [m7]
m9: $ … ⇒ z ∊ d4_Q a M d $ by subset_elim [m4, and_elim_l [m8]]
m10: $ … ⇒ z ∈ tsub' z $ by tsub_self [welc_wcel [and_elim_l [m8]]]
m11: $ … ⇒ z ∊ einv a M d $ by d4_q_e [m9, wcel_welc [m10]]
ir: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ isset e $ by isset_var
m12: $ … ⇒ dt a M z d e = dt a M c d e $ by einv_elim [m11, m7, ir]
ru: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ a = a $ by eq_refl
rM: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ M = M $ by eq_refl
rw: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ d = d $ by eq_refl
rr: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a , z = ⟨ b , x0 ⟩ ⇒ e = e $ by eq_refl
m13: $ … ⇒ dt a M ⟨ b , x0 ⟩ d e = dt a M c d e $ by eq_trans [dt_eq [ru, rM, eq_sym [m6], rw, rr], m12]
m14: $ G , uadm a , b ∈ kexa , ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 , d ∊ lvals , e ∊ fseq a ⇒ isset ⟨ b , x0 ⟩ $ by opair_isset
m15: $ … ⇒ dt a M ⟨ b , x0 ⟩ d e = dt a M c d e $ by isset_elim [m14, m13]
m16: $ … ⇒ ∀ a ∀ b ∀ x0 ∀ c ∀ d ∀ e (uadm a → b ∈ kexa → ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 → d ∊ lvals → e ∊ fseq a → dt a M ⟨ b , x0 ⟩ d e = dt a M c d e) $ by all_intro [all_intro [all_intro [all_intro [all_intro [all_intro [imp_intro [imp_intro [imp_intro [imp_intro [imp_intro [m15]]]]]]]]]]]
m17: $ G , ∀ a ∀ b ∀ x0 ∀ c ∀ d ∀ e (uadm a → b ∈ kexa → ra_eeqv ⟨ b , x0 ⟩ c ∈ lrel2 → d ∊ lvals → e ∊ fseq a → dt a M ⟨ b , x0 ⟩ d e = dt a M c d e) ⇒ minv M $ by ax
m18: $ … ⇒ minv M $ by imp_elim [imp_intro [m17], m16]
lemma d4_atoms2 (G: hyps) (K: class) (a b: set): $ G ⇒ ⟨ K , scons a (scons b ∅) ⟩ ∈ lrel2 $ > $ G ⇒ K ∈ ω $ > $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $
----
l1: $ G ⇒ hprog lprog2 latoms $ by lprog2_hprog
l2: $ … ⇒ lrel2 ⊆ latoms $ by horn_sub [l1]
l3: $ … ⇒ ⟨ K , scons a (scons b ∅) ⟩ ∈ latoms $ by wcel_subset [l2, #1]
l4: $ G ⇒ isset ω $ by omega_set
l5: $ … ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [l4]
l6: $ … ⇒ ⟨ K , scons a (scons b ∅) ⟩ ∈ trees ω $ by wcel_eq_r [l5, l3]
l7: $ … ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by trees_kids2 [l4, l6, wcel_isset [#2]]

lemma d4_ce_half {i: set} (G: hyps) (E: class) (u w a b p q: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ a ∊ trees ω $ > $ G ⇒ b ∊ trees ω $ > $ G ⇒ p ∊ trees ω $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ esat u E p w ⊆ esat u E q w $ > $ G ⇒ ∀ i (da (E' a) w i ⊆ da (E' b) w i) $ > $ G ⇒ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w ⊆ esat u E ⟨ kc_cons , scons b (scons q ∅) ⟩ w $
----
w1: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ w ∊ lvals $ by weaken [#1]
w3: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ b ∊ trees ω $ by weaken [#3]
w5: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ q ∊ trees ω $ by weaken [#5]
w6: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ esat u E p w ⊆ esat u E q w $ by weaken [#6]
w7: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ ∀ i (da (E' a) w i ⊆ da (E' b) w i) $ by weaken [#7]
k1: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ x1 ∊ esat u E p w $ by ax
k2: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ x2 ∊ da (E' a) w x1 $ by ax
k3: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ e = scons x2 x1 $ by ax
k0: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w $ by ax
c1: $ … ⇒ x1 ∊ esat u E q w $ by subset_elim [w6, k1]
c2: $ … ⇒ da (E' a) w x1 ⊆ da (E' b) w x1 $ by all_elim [w7]
c3: $ … ⇒ x2 ∊ da (E' b) w x1 $ by subset_elim [c2, k2]
c4a: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w , x1 ∊ esat u E p w , x2 ∊ da (E' a) w x1 , e = scons x2 x1 ⇒ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w ⊆ fseq u $ by esat_fseq
c4: $ … ⇒ e ∊ fseq u $ by subset_elim [c4a, k0]
c5: $ … ⇒ x1 ∊ esat u E q w ∧ x2 ∊ da (E' b) w x1 ∧ e = scons x2 x1 $ by and_intro [c1, and_intro [c3, k3]]
c6: $ … ⇒ ∃ c (c ∊ esat u E q w ∧ x2 ∊ da (E' b) w c ∧ e = scons x2 c) $ by ex_intro [c5]
c7: $ … ⇒ ∃ d ∃ c (c ∊ esat u E q w ∧ d ∊ da (E' b) w c ∧ e = scons d c) $ by ex_intro [c6]
c8: $ … ⇒ e ∊ {r | r ∊ fseq u ∧ ∃ d ∃ c (c ∊ esat u E q w ∧ d ∊ da (E' b) w c ∧ r = scons d c)} $ by cab_intro [and_intro [c4, c7]]
c9: $ … ⇒ esat u E ⟨ kc_cons , scons b (scons q ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ d ∃ c (c ∊ esat u E q w ∧ d ∊ da (E' b) w c ∧ r = scons d c)} $ by esat_cons [welc_wcel [w3], welc_wcel [w5], w1]
c10: $ … ⇒ e ∊ esat u E ⟨ kc_cons , scons b (scons q ∅) ⟩ w $ by welc_eq [eq_sym [c9], c8]
g0: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w ⇒ e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w $ by ax
g1: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w ⇒ a ∊ trees ω $ by weaken [#2]
g2: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w ⇒ p ∊ trees ω $ by weaken [#4]
g3: $ G , e ∊ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w ⇒ w ∊ lvals $ by weaken [#1]
c11: $ … ⇒ e ∊ esat u E ⟨ kc_cons , scons b (scons q ∅) ⟩ w $ by esat_cons_elim [welc_wcel [g1], welc_wcel [g2], g3, g0, c10]
c12: $ … ⇒ esat u E ⟨ kc_cons , scons a (scons p ∅) ⟩ w ⊆ esat u E ⟨ kc_cons , scons b (scons q ∅) ⟩ w $ by subset_intro [c11]

lemma d4_ce_cons (G: hyps) (M: class) (u w a b p q: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ a ∊ trees ω $ > $ G ⇒ b ∊ trees ω $ > $ G ⇒ p ∊ trees ω $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ a ∊ einv u M w $ > $ G ⇒ ra_eeqv a b ∈ lrel2 $ > $ G ⇒ esat u (dnf u M) p w = esat u (dnf u M) q w $ > $ G ⇒ esat u (dnf u M) ⟨ kc_cons , scons a (scons p ∅) ⟩ w = esat u (dnf u M) ⟨ kc_cons , scons b (scons q ∅) ⟩ w $
----
i0: $ G ⇒ isset i $ by isset_var
i1: $ … ⇒ dt u M a w i = dt u M b w i $ by einv_elim [#6, #7, i0]
i2: $ … ⇒ da ((dnf u M)' a) w i ⊆ da ((dnf u M)' b) w i $ by eq_subset [i1]
i3: $ … ⇒ da ((dnf u M)' b) w i ⊆ da ((dnf u M)' a) w i $ by eq_subset [eq_sym [i1]]
i4: $ … ⇒ ∀ i (da ((dnf u M)' a) w i ⊆ da ((dnf u M)' b) w i) $ by all_intro [i2]
i5: $ … ⇒ ∀ i (da ((dnf u M)' b) w i ⊆ da ((dnf u M)' a) w i) $ by all_intro [i3]
i6: $ … ⇒ esat u (dnf u M) ⟨ kc_cons , scons a (scons p ∅) ⟩ w ⊆ esat u (dnf u M) ⟨ kc_cons , scons b (scons q ∅) ⟩ w $ by d4_ce_half [#1, #2, #3, #4, #5, eq_subset [#8], i4]
i7: $ … ⇒ esat u (dnf u M) ⟨ kc_cons , scons b (scons q ∅) ⟩ w ⊆ esat u (dnf u M) ⟨ kc_cons , scons a (scons p ∅) ⟩ w $ by d4_ce_half [#1, #3, #2, #5, #4, eq_subset [eq_sym [#8]], i5]
i8: $ … ⇒ esat u (dnf u M) ⟨ kc_cons , scons a (scons p ∅) ⟩ w = esat u (dnf u M) ⟨ kc_cons , scons b (scons q ∅) ⟩ w $ by subset_antisym [i6, i7]

def d4_ce (U M W: class) (.y .c: set): class = $ {y | ∀ c (ra_ceqv y c ∈ lrel2 → tsub' y ⊆ einv U M W → esat U (dnf U M) y W = esat U (dnf U M) c W)} $

lemma d4_ce_e (G: hyps) (M: class) (u w ty tc: set): $ G ⇒ ty ∊ d4_ce u M w $ > $ G ⇒ ra_ceqv ty tc ∈ lrel2 $ > $ G ⇒ tsub' ty ⊆ einv u M w $ > $ G ⇒ esat u (dnf u M) ty w = esat u (dnf u M) tc w $
----
l1: $ … ⇒ ∀ c (ra_ceqv ty c ∈ lrel2 → tsub' ty ⊆ einv u M w → esat u (dnf u M) ty w = esat u (dnf u M) c w) $ by cab_elim [#1]
l2: $ … ⇒ ra_ceqv ty tc ∈ lrel2 → tsub' ty ⊆ einv u M w → esat u (dnf u M) ty w = esat u (dnf u M) tc w $ by all_elim [l1]
l3: $ … ⇒ esat u (dnf u M) ty w = esat u (dnf u M) tc w $ by imp_elim [imp_elim [l2, #2], #3]

lemma d4_ce_node (G: hyps) (M: class) (u w y c k1 j1: set): $ G ⇒ crn j1 ⊆ d4_ce u M w $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_ceqv y c ∈ lrel2 $ > $ G ⇒ tsub' y ⊆ einv u M w $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $
----
s0: $ … ⇒ (y = ⟨ kc_nil , ∅ ⟩ ∧ c = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) $ by lrel2_ceqv_cases [#3]
a0: $ G , y = ⟨ kc_nil , ∅ ⟩ ∧ c = ⟨ kc_nil , ∅ ⟩ ⇒ y = ⟨ kc_nil , ∅ ⟩ ∧ c = ⟨ kc_nil , ∅ ⟩ $ by ax
arw: $ G , y = ⟨ kc_nil , ∅ ⟩ ∧ c = ⟨ kc_nil , ∅ ⟩ ⇒ w = w $ by eq_refl
a1: $ … ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $ by esat_eq [eq_trans [and_elim_l [a0], eq_sym [and_elim_r [a0]]], arw]
b0: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 $ by ax
b1: $ … ⇒ y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ $ by and_elim_l [b0]
b2: $ … ⇒ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ $ by and_elim_l [and_elim_r [b0]]
b3: $ … ⇒ ra_eeqv x1 x2 ∈ lrel2 $ by and_elim_l [and_elim_r [and_elim_r [b0]]]
b4: $ … ⇒ ra_ceqv x3 x4 ∈ lrel2 $ by and_elim_r [and_elim_r [and_elim_r [b0]]]
v1: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ crn j1 ⊆ d4_ce u M w $ by weaken [#1]
v2: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ y = ⟨ k1 , j1 ⟩ $ by weaken [#2]
v4: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ tsub' y ⊆ einv u M w $ by weaken [#4]
v5: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ w ∊ lvals $ by weaken [#5]
v6: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ k1 ∊ ω $ by weaken [#6]
v7: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ j1 ∊ fseq (trees ω) $ by weaken [#7]
t1: $ … ⇒ x1 ∊ trees ω ∧ x2 ∊ trees ω $ by lrel2_eeqv_trees [b3]
t2a: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ kr_ceqv ∈ ω $ by kr_ceqv_omega
t2: $ … ⇒ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by d4_atoms2 [b4, t2a]
j1: $ … ⇒ ⟨ k1 , j1 ⟩ = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ $ by eq_trans [eq_sym [v2], b1]
is_k1: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ isset k1 $ by isset_var
is_j1: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ isset j1 $ by isset_var
is_x1: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ isset x1 $ by isset_var
is_x3: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ isset x3 $ by isset_var
j2a: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ kc_cons ∈ ω $ by kc_cons_omega
j2b: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ isset ∅ $ by ax_empty
j2: $ … ⇒ k1 = kc_cons ∧ j1 = scons x1 (scons x3 ∅) $ by opair_inj_c [j1, is_k1, is_j1, wcel_isset [j2a], scons_set [scons_set [j2b]]]
j3: $ … ⇒ crn (scons x1 (scons x3 ∅)) ⊆ d4_ce u M w $ by subset_eq_l [crn_eq [and_elim_r [j2]], v1]
j4: $ … ⇒ x3 ∈ d4_ce u M w $ by crn_scons_head [is_x3, crn_scons_tail [j3]]
j5: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ crn j1 ⊆ crn j1 $ by subset_refl
j6: $ … ⇒ crn (scons x1 (scons x3 ∅)) ⊆ crn j1 $ by subset_eq_l [crn_eq [and_elim_r [j2]], j5]
j7: $ … ⇒ x1 ∈ crn j1 $ by crn_scons_head [is_x1, j6]
j8: $ … ⇒ x3 ∈ crn j1 $ by crn_scons_head [is_x3, crn_scons_tail [j6]]
rts: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ tsub = tsub $ by eq_refl
j9: $ … ⇒ tsub' ⟨ k1 , j1 ⟩ = tsub' y $ by fv_eq [rts, eq_sym [v2]]
j10: $ … ⇒ x1 ∈ tsub' y $ by wcel_eq_r [j9, tsub_crn [v6, v7, wcel_welc [j7]]]
j11: $ … ⇒ x3 ∈ tsub' y $ by wcel_eq_r [j9, tsub_crn [v6, v7, wcel_welc [j8]]]
j12: $ … ⇒ x1 ∊ einv u M w $ by subset_elim [v4, wcel_welc [j10]]
j13: $ … ⇒ tsub' x3 ⊆ einv u M w $ by subset_trans [tsub_trans [j11], v4]
j14: $ … ⇒ esat u (dnf u M) x3 w = esat u (dnf u M) x4 w $ by d4_ce_e [wcel_welc [j4], b4, j13]
j15: $ … ⇒ esat u (dnf u M) ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ w = esat u (dnf u M) ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ w $ by d4_ce_cons [v5, and_elim_l [t1], and_elim_r [t1], and_elim_l [t2], and_elim_r [t2], j12, b3, j14]
rw: $ G , y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2 ⇒ w = w $ by eq_refl
j16: $ … ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $ by eq_trans [esat_eq [b1, rw], eq_trans [j15, esat_eq [eq_sym [b2], rw]]]
j17_x3: $ G , ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) ⇒ ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) $ by ax
j17_y3: $ … ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $ by ex_elim [j17_x3, j16]
j17_x2: $ G , ∃ x3 ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) ⇒ ∃ x3 ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) $ by ax
j17_y2: $ … ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $ by ex_elim [j17_x2, j17_y3]
j17_x1: $ G , ∃ x2 ∃ x3 ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) ⇒ ∃ x2 ∃ x3 ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) $ by ax
j17_y1: $ … ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $ by ex_elim [j17_x1, j17_y2]
j17_x0: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (y = ⟨ kc_cons , scons x1 (scons x3 ∅) ⟩ ∧ c = ⟨ kc_cons , scons x2 (scons x4 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_ceqv x3 x4 ∈ lrel2) $ by ax
j17: $ … ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $ by ex_elim [j17_x0, j17_y1]
fin: $ … ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $ by or_elim [s0, a1, j17]

lemma d4_ce_all (G: hyps) (M: class) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ trees ω ⊆ d4_ce u M w $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ , ra_ceqv y c ∈ lrel2 , tsub' y ⊆ einv u M w ⇒ crn j ⊆ d4_ce u M w $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ , ra_ceqv y c ∈ lrel2 , tsub' y ⊆ einv u M w ⇒ y = ⟨ k , j ⟩ $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ , ra_ceqv y c ∈ lrel2 , tsub' y ⊆ einv u M w ⇒ ra_ceqv y c ∈ lrel2 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ , ra_ceqv y c ∈ lrel2 , tsub' y ⊆ einv u M w ⇒ tsub' y ⊆ einv u M w $ by ax
a5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ , ra_ceqv y c ∈ lrel2 , tsub' y ⊆ einv u M w ⇒ w ∊ lvals $ by weaken [#1]
a6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ , ra_ceqv y c ∈ lrel2 , tsub' y ⊆ einv u M w ⇒ k ∊ ω $ by ax
a7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ , ra_ceqv y c ∈ lrel2 , tsub' y ⊆ einv u M w ⇒ j ∊ fseq (trees ω) $ by ax
n1: $ … ⇒ esat u (dnf u M) y w = esat u (dnf u M) c w $ by d4_ce_node [a1, a2, a3, a4, a5, a6, a7]
n2: $ … ⇒ ra_ceqv y c ∈ lrel2 → tsub' y ⊆ einv u M w → esat u (dnf u M) y w = esat u (dnf u M) c w $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ c (ra_ceqv y c ∈ lrel2 → tsub' y ⊆ einv u M w → esat u (dnf u M) y w = esat u (dnf u M) c w) $ by all_intro [n2]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ ⇒ y ∊ d4_ce u M w $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ce u M w $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ce u M w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ce u M w $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ce u M w → ⟨ k , j ⟩ ∈ d4_ce u M w $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ce u M w → ⟨ k , j ⟩ ∈ d4_ce u M w) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_ce u M w $ by trees_ind_c [n11, n10]

ceqv_esat
----
l1: $ … ⇒ trees ω ⊆ d4_ce u M w $ by d4_ce_all [#2]
l2a: $ G ⇒ kr_ceqv ∈ ω $ by kr_ceqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by d4_atoms2 [#1, l2a]
l3: $ … ⇒ t1 ∊ d4_ce u M w $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ esat u (dnf u M) t1 w = esat u (dnf u M) t2 w $ by d4_ce_e [l3, #1, #3]

lemma d4_et_other (G: hyps) (E K S T: class) (u w r z t: set): $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ t = ⟨ K , T ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ t ∊ trees ω $ > $ G ⇒ K ∈ ω $ > $ G ⇒ isset S $ > $ G ⇒ isset T $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u E z w r = etel u E t w r $
----
os: $ G ⇒ isset ω $ by omega_set
a1: $ … ⇒ ⟨ K , S ⟩ ∈ trees ω $ by wcel_eq_l [#1, welc_wcel [#3]]
a2: $ … ⇒ K ∈ ω ∧ S ∈ fseq (trees ω) $ by trees_node_c [os, a1, wcel_isset [#5], #6]
a3: $ … ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_c [#5, and_elim_r [a2], #8, #9, welc_wcel [#10], welc_wcel [#11]]
b1: $ … ⇒ ⟨ K , T ⟩ ∈ trees ω $ by wcel_eq_l [#2, welc_wcel [#4]]
b2: $ … ⇒ K ∈ ω ∧ T ∈ fseq (trees ω) $ by trees_node_c [os, b1, wcel_isset [#5], #7]
b3: $ … ⇒ etel u E ⟨ K , T ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_c [#5, and_elim_r [b2], #8, #9, welc_wcel [#10], welc_wcel [#11]]
rw: $ G ⇒ w = w $ by eq_refl
rr: $ G ⇒ r = r $ by eq_refl
fin: $ … ⇒ etel u E z w r = etel u E t w r $ by eq_trans [etel_eq [#1, rw, rr], eq_trans [a3, eq_trans [eq_sym [b3], etel_eq [eq_sym [#2], rw, rr]]]]

lemma d4_app_half (G: hyps) (E: class) (u w r f a g h: set): $ G ⇒ f ∊ trees ω $ > $ G ⇒ a ∊ trees ω $ > $ G ⇒ g ∊ trees ω $ > $ G ⇒ h ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u E f w r ⊆ etel u E g w r $ > $ G ⇒ da (E' a) w r = da (E' h) w r $ > $ G ⇒ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r ⊆ etel u E ⟨ kc_app , scons g (scons h ∅) ⟩ w r $
----
u1: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r ⇒ f ∊ trees ω $ by weaken [#1]
u2: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r ⇒ a ∊ trees ω $ by weaken [#2]
u5: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r ⇒ w ∊ lvals $ by weaken [#5]
u6: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r ⇒ r ∊ fseq u $ by weaken [#6]
s0: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r ⇒ e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r $ by ax
s1: $ … ⇒ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r = {y | ∃ x1 (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩)} $ by etel_app [welc_wcel [u1], welc_wcel [u2], u5, u6]
s2: $ … ⇒ e ∊ {y | ∃ x1 (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩)} $ by welc_eq [s1, s0]
s3: $ … ⇒ ∃ x1 (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩) $ by cab_elim [s2]
w3: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ g ∊ trees ω $ by weaken [#3]
w4: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ h ∊ trees ω $ by weaken [#4]
w5: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ w ∊ lvals $ by weaken [#5]
w6: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ r ∊ fseq u $ by weaken [#6]
w7: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ etel u E f w r ⊆ etel u E g w r $ by weaken [#7]
w8: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ da (E' a) w r = da (E' h) w r $ by weaken [#8]
b0: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ $ by ax
b1: $ … ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r $ by and_elim_l [b0]
b2: $ … ⇒ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ $ by and_elim_r [b0]
b3: $ … ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E g w r $ by wcel_subset [w7, b1]
r0: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ ∅ = ∅ $ by eq_refl
rx: $ G , e ∊ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ ⟩ ∈ etel u E f w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ ⇒ x1 = x1 $ by eq_refl
b4: $ … ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' a) w r) x1 ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' h) w r) x1 ⟩ ⟩ ⟩ $ by opair_eq [r0, opair_eq [r0, opair_eq [r0, scons_eq [w8, rx]]]]
b5: $ … ⇒ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' h) w r) x1 ⟩ ⟩ ⟩ $ by eq_trans [b2, b4]
b6: $ … ⇒ ∃ c (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , c ⟩ ⟩ ⟩ ∈ etel u E g w r ∧ e = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' h) w r) c ⟩ ⟩ ⟩) $ by ex_intro [and_intro [b3, b5]]
b7: $ … ⇒ e ∊ {y | ∃ c (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , c ⟩ ⟩ ⟩ ∈ etel u E g w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' h) w r) c ⟩ ⟩ ⟩)} $ by cab_intro [b6]
b8: $ … ⇒ etel u E ⟨ kc_app , scons g (scons h ∅) ⟩ w r = {y | ∃ c (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , c ⟩ ⟩ ⟩ ∈ etel u E g w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' h) w r) c ⟩ ⟩ ⟩)} $ by etel_app [welc_wcel [w3], welc_wcel [w4], w5, w6]
b9: $ … ⇒ e ∊ etel u E ⟨ kc_app , scons g (scons h ∅) ⟩ w r $ by welc_eq [eq_sym [b8], b7]
s4: $ … ⇒ e ∊ etel u E ⟨ kc_app , scons g (scons h ∅) ⟩ w r $ by ex_elim [s3, b9]
s5: $ … ⇒ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r ⊆ etel u E ⟨ kc_app , scons g (scons h ∅) ⟩ w r $ by subset_intro [s4]

lemma d4_et_app (G: hyps) (E: class) (u w r z t f a g h: set): $ G ⇒ z = ⟨ kc_app , scons f (scons a ∅) ⟩ $ > $ G ⇒ t = ⟨ kc_app , scons g (scons h ∅) ⟩ $ > $ G ⇒ f ∊ trees ω $ > $ G ⇒ a ∊ trees ω $ > $ G ⇒ g ∊ trees ω $ > $ G ⇒ h ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u E f w r = etel u E g w r $ > $ G ⇒ da (E' a) w r = da (E' h) w r $ > $ G ⇒ etel u E z w r = etel u E t w r $
----
h1: $ … ⇒ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r ⊆ etel u E ⟨ kc_app , scons g (scons h ∅) ⟩ w r $ by d4_app_half [#3, #4, #5, #6, #7, #8, eq_subset [#9], #10]
h2: $ … ⇒ etel u E ⟨ kc_app , scons g (scons h ∅) ⟩ w r ⊆ etel u E ⟨ kc_app , scons f (scons a ∅) ⟩ w r $ by d4_app_half [#5, #6, #3, #4, #7, #8, eq_subset [eq_sym [#9]], eq_sym [#10]]
rw: $ G ⇒ w = w $ by eq_refl
rr: $ G ⇒ r = r $ by eq_refl
fin: $ … ⇒ etel u E z w r = etel u E t w r $ by eq_trans [etel_eq [#1, rw, rr], eq_trans [subset_antisym [h1, h2], etel_eq [eq_sym [#2], rw, rr]]]

lemma d4_pi_half {i: set} (G: hyps) (E: class) (u w r a b c d: set): $ G ⇒ a ∊ trees ω $ > $ G ⇒ b ∊ trees ω $ > $ G ⇒ c ∊ trees ω $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ da (E' a) w r = da (E' c) w r $ > $ G ⇒ etel u E a w r = etel u E c w r $ > $ G ⇒ ∀ i (i ∊ u → etel u E b w (scons i r) ⊆ etel u E d w (scons i r)) $ > $ G ⇒ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r ⊆ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $
----
u1: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r ⇒ a ∊ trees ω $ by weaken [#1]
u2: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r ⇒ b ∊ trees ω $ by weaken [#2]
u5: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r ⇒ w ∊ lvals $ by weaken [#5]
u6: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r ⇒ r ∊ fseq u $ by weaken [#6]
s0: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r ⇒ e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r $ by ax
s1: $ … ⇒ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r = {y | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ y = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩)} $ by etel_pi [welc_wcel [u1], welc_wcel [u2], u5, u6]
s2: $ … ⇒ e ∊ {y | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ y = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩)} $ by welc_eq [s1, s0]
s3: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) $ by cab_elim [s2]
w3: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ c ∊ trees ω $ by weaken [#3]
w4: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ d ∊ trees ω $ by weaken [#4]
w5: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ w ∊ lvals $ by weaken [#5]
w6: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ r ∊ fseq u $ by weaken [#6]
w7: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ da (E' a) w r = da (E' c) w r $ by weaken [#7]
w8: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ etel u E a w r = etel u E c w r $ by weaken [#8]
w9: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ ∀ i (i ∊ u → etel u E b w (scons i r) ⊆ etel u E d w (scons i r)) $ by weaken [#9]
b0: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ $ by ax
b1: $ … ⇒ x1 ∊ da (E' a) w r $ by and_elim_l [b0]
b2: $ … ⇒ x1 ∊ u $ by and_elim_l [and_elim_r [b0]]
b3: $ … ⇒ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) $ by and_elim_l [and_elim_r [and_elim_r [b0]]]
b4: $ … ⇒ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ $ by and_elim_r [and_elim_r [and_elim_r [b0]]]
c1: $ … ⇒ x1 ∊ da (E' c) w r $ by welc_eq [w7, b1]
c2: $ … ⇒ x1 ∊ u → etel u E b w (scons x1 r) ⊆ etel u E d w (scons x1 r) $ by all_elim [w9]
c4: $ … ⇒ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E d w (scons x1 r) $ by wcel_subset [imp_elim [c2, b2], b3]
r1: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ ssnoc x2 x1 = ssnoc x2 x1 $ by eq_refl
r2: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ scons x1 x3 = scons x1 x3 $ by eq_refl
r4: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ x4 = x4 $ by eq_refl
r5: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ ⇒ x5 = x5 $ by eq_refl
c5: $ … ⇒ ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩ = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E c w r) x4 , x5 ⟩ ⟩ ⟩ $ by opair_eq [r1, opair_eq [r2, opair_eq [scons_eq [w8, r4], r5]]]
c6: $ … ⇒ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E c w r) x4 , x5 ⟩ ⟩ ⟩ $ by eq_trans [b4, c5]
c7: $ … ⇒ x1 ∊ da (E' c) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E d w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E c w r) x4 , x5 ⟩ ⟩ ⟩ $ by and_intro [c1, and_intro [b2, and_intro [c4, c6]]]
c8_4: $ … ⇒ ∃ h (x1 ∊ da (E' c) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , h ⟩ ⟩ ⟩ ∈ etel u E d w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E c w r) x4 , h ⟩ ⟩ ⟩) $ by ex_intro [c7]
c8_3: $ … ⇒ ∃ t ∃ h (x1 ∊ da (E' c) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ t , h ⟩ ⟩ ⟩ ∈ etel u E d w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E c w r) t , h ⟩ ⟩ ⟩) $ by ex_intro [c8_4]
c8_2: $ … ⇒ ∃ g ∃ t ∃ h (x1 ∊ da (E' c) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ g , ⟨ t , h ⟩ ⟩ ⟩ ∈ etel u E d w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 g , ⟨ scons (etel u E c w r) t , h ⟩ ⟩ ⟩) $ by ex_intro [c8_3]
c8_1: $ … ⇒ ∃ f ∃ g ∃ t ∃ h (x1 ∊ da (E' c) w r ∧ x1 ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , h ⟩ ⟩ ⟩ ∈ etel u E d w (scons x1 r) ∧ e = ⟨ ssnoc f x1 , ⟨ scons x1 g , ⟨ scons (etel u E c w r) t , h ⟩ ⟩ ⟩) $ by ex_intro [c8_2]
c8_0: $ … ⇒ ∃ x ∃ f ∃ g ∃ t ∃ h (x ∊ da (E' c) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , h ⟩ ⟩ ⟩ ∈ etel u E d w (scons x r) ∧ e = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u E c w r) t , h ⟩ ⟩ ⟩) $ by ex_intro [c8_1]
c9: $ … ⇒ e ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ h (x ∊ da (E' c) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , h ⟩ ⟩ ⟩ ∈ etel u E d w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u E c w r) t , h ⟩ ⟩ ⟩)} $ by cab_intro [c8_0]
c10: $ … ⇒ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r = {y | ∃ x ∃ f ∃ g ∃ t ∃ h (x ∊ da (E' c) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , h ⟩ ⟩ ⟩ ∈ etel u E d w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u E c w r) t , h ⟩ ⟩ ⟩)} $ by etel_pi [welc_wcel [w3], welc_wcel [w4], w5, w6]
c11: $ … ⇒ e ∊ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by welc_eq [eq_sym [c10], c9]
s4_x4: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) ⇒ ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) $ by ax
s4_y4: $ … ⇒ e ∊ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by ex_elim [s4_x4, c11]
s4_x3: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) ⇒ ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) $ by ax
s4_y3: $ … ⇒ e ∊ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by ex_elim [s4_x3, s4_y4]
s4_x2: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , ∃ x3 ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) ⇒ ∃ x3 ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) $ by ax
s4_y2: $ … ⇒ e ∊ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by ex_elim [s4_x2, s4_y3]
s4_x1: $ G , e ∊ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r , ∃ x2 ∃ x3 ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) ⇒ ∃ x2 ∃ x3 ∃ x4 ∃ x5 (x1 ∊ da (E' a) w r ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E b w (scons x1 r) ∧ e = ⟨ ssnoc x2 x1 , ⟨ scons x1 x3 , ⟨ scons (etel u E a w r) x4 , x5 ⟩ ⟩ ⟩) $ by ax
s4_y1: $ … ⇒ e ∊ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by ex_elim [s4_x1, s4_y2]
s4: $ … ⇒ e ∊ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by ex_elim [s3, s4_y1]
s5: $ … ⇒ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r ⊆ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by subset_intro [s4]

lemma d4_et_pi {i: set} (G: hyps) (E: class) (u w r z t a b c d: set): $ G ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ > $ G ⇒ t = ⟨ kc_pi , scons c (scons d ∅) ⟩ $ > $ G ⇒ a ∊ trees ω $ > $ G ⇒ b ∊ trees ω $ > $ G ⇒ c ∊ trees ω $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ da (E' a) w r = da (E' c) w r $ > $ G ⇒ etel u E a w r = etel u E c w r $ > $ G ⇒ ∀ i (i ∊ u → etel u E b w (scons i r) = etel u E d w (scons i r)) $ > $ G ⇒ etel u E z w r = etel u E t w r $
----
e0: $ G , i ∊ u ⇒ ∀ i (i ∊ u → etel u E b w (scons i r) = etel u E d w (scons i r)) $ by weaken [#11]
ei: $ G , i ∊ u ⇒ i ∊ u $ by ax
e1: $ … ⇒ etel u E b w (scons i r) = etel u E d w (scons i r) $ by imp_elim [all_elim [e0], ei]
e2: $ … ⇒ etel u E b w (scons i r) ⊆ etel u E d w (scons i r) $ by eq_subset [e1]
e3: $ … ⇒ etel u E d w (scons i r) ⊆ etel u E b w (scons i r) $ by eq_subset [eq_sym [e1]]
f1: $ … ⇒ ∀ i (i ∊ u → etel u E b w (scons i r) ⊆ etel u E d w (scons i r)) $ by all_intro [imp_intro [e2]]
f2: $ … ⇒ ∀ i (i ∊ u → etel u E d w (scons i r) ⊆ etel u E b w (scons i r)) $ by all_intro [imp_intro [e3]]
h1: $ … ⇒ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r ⊆ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by d4_pi_half [#3, #4, #5, #6, #7, #8, #9, #10, f1]
h2: $ … ⇒ etel u E ⟨ kc_pi , scons c (scons d ∅) ⟩ w r ⊆ etel u E ⟨ kc_pi , scons a (scons b ∅) ⟩ w r $ by d4_pi_half [#5, #6, #3, #4, #7, #8, eq_sym [#9], eq_sym [#10], f2]
rw: $ G ⇒ w = w $ by eq_refl
rr: $ G ⇒ r = r $ by eq_refl
fin: $ … ⇒ etel u E z w r = etel u E t w r $ by eq_trans [etel_eq [#1, rw, rr], eq_trans [subset_antisym [h1, h2], etel_eq [eq_sym [#2], rw, rr]]]

def d4_et (U M W: class) (.y .c .r: set): class = $ {y | ∀ c ∀ r (ra_eeqv y c ∈ lrel2 → tsub' y ⊆ einv U M W → r ∊ fseq U → etel U (dnf U M) y W r = etel U (dnf U M) c W r)} $

lemma d4_et_e (G: hyps) (M R: class) (u w ty tc: set): $ G ⇒ ty ∊ d4_et u M w $ > $ G ⇒ ra_eeqv ty tc ∈ lrel2 $ > $ G ⇒ tsub' ty ⊆ einv u M w $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ etel u (dnf u M) ty w R = etel u (dnf u M) tc w R $
----
w1: $ G , x = R ⇒ ty ∊ d4_et u M w $ by weaken [#1]
w2: $ G , x = R ⇒ ra_eeqv ty tc ∈ lrel2 $ by weaken [#2]
w3: $ G , x = R ⇒ tsub' ty ⊆ einv u M w $ by weaken [#3]
w4: $ G , x = R ⇒ R ∈ fseq u $ by weaken [#4]
kx: $ G , x = R ⇒ x = R $ by ax
l1: $ … ⇒ ∀ c ∀ r (ra_eeqv ty c ∈ lrel2 → tsub' ty ⊆ einv u M w → r ∊ fseq u → etel u (dnf u M) ty w r = etel u (dnf u M) c w r) $ by cab_elim [w1]
l2: $ … ⇒ ∀ r (ra_eeqv ty tc ∈ lrel2 → tsub' ty ⊆ einv u M w → r ∊ fseq u → etel u (dnf u M) ty w r = etel u (dnf u M) tc w r) $ by all_elim [l1]
l3: $ … ⇒ ra_eeqv ty tc ∈ lrel2 → tsub' ty ⊆ einv u M w → x ∊ fseq u → etel u (dnf u M) ty w x = etel u (dnf u M) tc w x $ by all_elim [l2]
l4: $ … ⇒ x ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [kx], w4]]
l5: $ … ⇒ etel u (dnf u M) ty w x = etel u (dnf u M) tc w x $ by imp_elim [imp_elim [imp_elim [l3, w2], w3], l4]
r1: $ G , x = R ⇒ ty = ty $ by eq_refl
r2: $ G , x = R ⇒ tc = tc $ by eq_refl
rw: $ G , x = R ⇒ w = w $ by eq_refl
l6: $ … ⇒ etel u (dnf u M) ty w R = etel u (dnf u M) tc w R $ by eq_trans [etel_eq [r1, rw, eq_sym [kx]], eq_trans [l5, etel_eq [r2, rw, kx]]]
l7: $ … ⇒ etel u (dnf u M) ty w R = etel u (dnf u M) tc w R $ by isset_elim [wcel_isset [#4], l6]

lemma d4_et_node (G: hyps) (M: class) (u w r z k j t: set): $ G ⇒ crn j ⊆ d4_et u M w $ > $ G ⇒ tsub' z ⊆ einv u M w $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ ra_eeqv z t ∈ lrel2 $ > $ G ⇒ etel u (dnf u M) z w r = etel u (dnf u M) t w r $
----
d0: $ … ⇒ ∃ e (z = e ∧ t = e) ∨ ∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2) $ by lrel2_eeqv_cases [#8]
