fin: $ … ⇒ ∃ p (ra_nth_ctor c i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2) $ by or_elim [s0, a6, b10]

lemma d4_cnl_all (G: hyps): $ G ⇒ trees ω ⊆ d4_cnl $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnl , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_nth_ctor y i f ∈ lrel ⇒ crn j ⊆ d4_cnl $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnl , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_nth_ctor y i f ∈ lrel ⇒ y = ⟨ k , j ⟩ $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnl , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_nth_ctor y i f ∈ lrel ⇒ ra_cseqv y c ∈ lrel2 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnl , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_nth_ctor y i f ∈ lrel ⇒ ra_nth_ctor y i f ∈ lrel $ by ax
n1: $ … ⇒ ∃ p (ra_nth_ctor c i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2) $ by d4_cnl_node [a1, a2, a3, a4]
n2: $ … ⇒ ra_cseqv y c ∈ lrel2 → ra_nth_ctor y i f ∈ lrel → ∃ p (ra_nth_ctor c i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2) $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ c ∀ i ∀ f (ra_cseqv y c ∈ lrel2 → ra_nth_ctor y i f ∈ lrel → ∃ p (ra_nth_ctor c i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2)) $ by all_intro [all_intro [all_intro [n2]]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnl , y = ⟨ k , j ⟩ ⇒ y ∊ d4_cnl $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnl , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_cnl $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_cnl ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_cnl $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_cnl → ⟨ k , j ⟩ ∈ d4_cnl $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_cnl → ⟨ k , j ⟩ ∈ d4_cnl) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_cnl $ by trees_ind_c [n11, n10]

cseqv_nth_ctor_l
----
l1: $ G ⇒ trees ω ⊆ d4_cnl $ by d4_cnl_all
l2a: $ G ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by d4_atoms2 [#1, l2a]
l3: $ … ⇒ t1 ∊ d4_cnl $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ∃ p (ra_nth_ctor t2 i p ∈ lrel ∧ ra_eeqv f p ∈ lrel2) $ by d4_cnl_e [l3, #1, #2]

def d4_cnr (.y .c .i .f .p: set): class = $ {y | ∀ c ∀ i ∀ f (ra_cseqv y c ∈ lrel2 → ra_nth_ctor c i f ∈ lrel → ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2))} $

lemma d4_cnr_e {p: set} (G: hyps) (ty tc ti tf: set): $ G ⇒ ty ∊ d4_cnr $ > $ G ⇒ ra_cseqv ty tc ∈ lrel2 $ > $ G ⇒ ra_nth_ctor tc ti tf ∈ lrel $ > $ G ⇒ ∃ p (ra_nth_ctor ty ti p ∈ lrel ∧ ra_eeqv p tf ∈ lrel2) $
----
l0: $ … ⇒ ∀ c ∀ i ∀ f (ra_cseqv ty c ∈ lrel2 → ra_nth_ctor c i f ∈ lrel → ∃ p (ra_nth_ctor ty i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2)) $ by cab_elim [#1]
l1: $ … ⇒ ∀ i ∀ f (ra_cseqv ty tc ∈ lrel2 → ra_nth_ctor tc i f ∈ lrel → ∃ p (ra_nth_ctor ty i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2)) $ by all_elim [l0]
l2: $ … ⇒ ∀ f (ra_cseqv ty tc ∈ lrel2 → ra_nth_ctor tc ti f ∈ lrel → ∃ p (ra_nth_ctor ty ti p ∈ lrel ∧ ra_eeqv p f ∈ lrel2)) $ by all_elim [l1]
l3: $ … ⇒ ra_cseqv ty tc ∈ lrel2 → ra_nth_ctor tc ti tf ∈ lrel → ∃ p (ra_nth_ctor ty ti p ∈ lrel ∧ ra_eeqv p tf ∈ lrel2) $ by all_elim [l2]
fin: $ … ⇒ ∃ p (ra_nth_ctor ty ti p ∈ lrel ∧ ra_eeqv p tf ∈ lrel2) $ by imp_elim [imp_elim [l3, #2], #3]

lemma d4_cnr_node {p: set} (G: hyps) (y c i f k1 j1: set): $ G ⇒ crn j1 ⊆ d4_cnr $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_cseqv y c ∈ lrel2 $ > $ G ⇒ ra_nth_ctor c i f ∈ lrel $ > $ G ⇒ ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2) $
----
s0: $ … ⇒ (y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x5 ∃ x6 (y = ⟨ kc_ccons , scons x1 (scons x5 ∅) ⟩ ∧ c = ⟨ kc_ccons , scons x2 (scons x6 ∅) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x5 x6 ∈ lrel2) $ by lrel2_cseqv_cases [#3]
a0: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ ⇒ y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ $ by ax
a4: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ ⇒ ra_nth_ctor c i f ∈ lrel $ by weaken [#4]
aS: $ … ⇒ c = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_r [a0]
a5: $ … ⇒ ∃ a ∃ d (c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a) ∨ ∃ a ∃ g ∃ d ∃ n (c = ⟨ kc_ccons , scons g (scons d ∅) ⟩ ∧ i = ⟨ kc_s , scons n ∅ ⟩ ∧ f = a ∧ ra_nth_ctor d n a ∈ lrel) $ by lrel_nth_ctor_cases [a4]
ah0: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ , c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a ⇒ c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a $ by ax
ahS: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ , c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a ⇒ c = ⟨ kc_cnil , ∅ ⟩ $ by weaken [aS]
ah1: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ , c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a ⇒ kc_cnil ∈ ω $ by kc_cnil_omega
ah2: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ , c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
ah3: $ … ⇒ ⟨ kc_cnil , ∅ ⟩ = ⟨ kc_ccons , scons a (scons d ∅) ⟩ $ by eq_trans [eq_sym [ahS], and_elim_l [ah0]]
ah4: $ … ⇒ kc_cnil = kc_ccons $ by opair_inj_l_c [ah3, wcel_isset [ah1], wcel_isset [ah2]]
ah5: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ , c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a ⇒ ¬ kc_cnil = kc_ccons $ by kc_cnil_ne_ccons
ah6: $ … ⇒ ∃ p (ra_nth_ctor y i p ∈ lrel ∧ ra_eeqv p f ∈ lrel2) $ by bot_elim [not_elim [ah5, ah4]]
ah7_x1: $ G , y = ⟨ kc_cnil , ∅ ⟩ ∧ c = ⟨ kc_cnil , ∅ ⟩ , ∃ d (c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a) ⇒ ∃ d (c = ⟨ kc_ccons , scons a (scons d ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = a) $ by ax
