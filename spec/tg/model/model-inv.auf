lemma d4_ccr_all (G: hyps): $ G ⇒ trees ω ⊆ d4_ccr $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccr , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_clen_c c n ∈ lrel ⇒ crn j ⊆ d4_ccr $ by ax
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccr , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_clen_c c n ∈ lrel ⇒ y = ⟨ k , j ⟩ $ by ax
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccr , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_clen_c c n ∈ lrel ⇒ ra_cseqv y c ∈ lrel2 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccr , y = ⟨ k , j ⟩ , ra_cseqv y c ∈ lrel2 , ra_clen_c c n ∈ lrel ⇒ ra_clen_c c n ∈ lrel $ by ax
n1: $ … ⇒ ra_clen_c y n ∈ lrel $ by d4_ccr_node [a1, a2, a3, a4]
n2: $ … ⇒ ra_cseqv y c ∈ lrel2 → ra_clen_c c n ∈ lrel → ra_clen_c y n ∈ lrel $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ c ∀ n (ra_cseqv y c ∈ lrel2 → ra_clen_c c n ∈ lrel → ra_clen_c y n ∈ lrel) $ by all_intro [all_intro [n2]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccr , y = ⟨ k , j ⟩ ⇒ y ∊ d4_ccr $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccr , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ccr $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ d4_ccr ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ d4_ccr $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ccr → ⟨ k , j ⟩ ∈ d4_ccr $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ d4_ccr → ⟨ k , j ⟩ ∈ d4_ccr) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ d4_ccr $ by trees_ind_c [n11, n10]

cseqv_clen_c_r
----
l1: $ G ⇒ trees ω ⊆ d4_ccr $ by d4_ccr_all
l2a: $ G ⇒ kr_cseqv ∈ ω $ by kr_cseqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by d4_atoms2 [#1, l2a]
l3: $ … ⇒ t1 ∊ d4_ccr $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ra_clen_c t1 n ∈ lrel $ by d4_ccr_e [l3, #1, #2]

def d4_ntl (.y .c .n .m: set): class = $ {y | ∀ c ∀ n ∀ m (ra_teqv y c ∈ lrel2 → ra_ntys y n m ∈ lrel → ra_ntys c n m ∈ lrel)} $

lemma d4_ntl_e (G: hyps) (ty tc tn tm: set): $ G ⇒ ty ∊ d4_ntl $ > $ G ⇒ ra_teqv ty tc ∈ lrel2 $ > $ G ⇒ ra_ntys ty tn tm ∈ lrel $ > $ G ⇒ ra_ntys tc tn tm ∈ lrel $
----
l0: $ … ⇒ ∀ c ∀ n ∀ m (ra_teqv ty c ∈ lrel2 → ra_ntys ty n m ∈ lrel → ra_ntys c n m ∈ lrel) $ by cab_elim [#1]
l1: $ … ⇒ ∀ n ∀ m (ra_teqv ty tc ∈ lrel2 → ra_ntys ty n m ∈ lrel → ra_ntys tc n m ∈ lrel) $ by all_elim [l0]
l2: $ … ⇒ ∀ m (ra_teqv ty tc ∈ lrel2 → ra_ntys ty tn m ∈ lrel → ra_ntys tc tn m ∈ lrel) $ by all_elim [l1]
l3: $ … ⇒ ra_teqv ty tc ∈ lrel2 → ra_ntys ty tn tm ∈ lrel → ra_ntys tc tn tm ∈ lrel $ by all_elim [l2]
fin: $ … ⇒ ra_ntys tc tn tm ∈ lrel $ by imp_elim [imp_elim [l3, #2], #3]

lemma d4_ntl_node (G: hyps) (y c n m k1 j1: set): $ G ⇒ crn j1 ⊆ d4_ntl $ > $ G ⇒ y = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_teqv y c ∈ lrel2 $ > $ G ⇒ ra_ntys y n m ∈ lrel $ > $ G ⇒ ra_ntys c n m ∈ lrel $
----
s0: $ … ⇒ (y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (y = ⟨ kc_tcons , scons x1 (scons x3 (scons x5 ∅)) ⟩ ∧ c = ⟨ kc_tcons , scons x2 (scons x4 (scons x6 ∅)) ⟩ ∧ ra_eeqv x1 x2 ∈ lrel2 ∧ ra_cseqv x3 x4 ∈ lrel2 ∧ ra_teqv x5 x6 ∈ lrel2) $ by lrel2_teqv_cases [#3]
a0: $ G , y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩ ⇒ y = ⟨ kc_tnil , ∅ ⟩ ∧ c = ⟨ kc_tnil , ∅ ⟩ $ by ax
