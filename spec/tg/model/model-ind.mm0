-- model-ind.mm0: the model's inductive types (layer C5 of the reduction, audit
-- §11), first part: the families and the constructors.
--
-- The hook. model-den.mm0's hook `M` sees a node's label, its children and
-- their values; the inductive constants need the values of every subterm of
-- the block's data (the parameters' types, the fields' types, the arguments of
-- a constructor's result), which are deeper. So the hook here is `mcv H`, built
-- from `H` by a course-of-values recursion (`cvf`: at every tree the table of
-- its subtrees' values): `H` sees, at a node, the table of the node's proper
-- subtrees, and `dt` at a node `H` interprets is `H`'s value there with that
-- table (`dt_mcv`), which agrees with `dt` itself on those subtrees.
--
-- The block. Everything below is relative to a universe `U`, a table `E` (the
-- values of the trees, `da (E' T) w r` as for `dt`), the block's tree `D`
-- and a level valuation `W`; the data is read with Part I's relations (`lrel`).
-- A curried trace is a set of points `nest a y` (`a` a valuation, `#0` first,
-- so `a(0)` is the last argument; `apn` reads the value back). The parameters'
-- valuations are `esat` (as `sat`), a constructor type's paths `etel`: for each
-- path the fields as a valuation `f`, the fields in order `g`, each field's
-- own telescope `t`, and the arguments `a` of the result (a valuation). A
-- candidate is a set of `⟨ j , ⟨ a , x ⟩ ⟩`: `x` an element of type `j` at the
-- arguments `a` (parameters and indices). The block's types valued by a
-- candidate (`ixs`) follow the parameters, so a constructor's type is read at
-- `scat p (ixs ..)`; a type that is a proposition at `W` is valued by its
-- collapse (`∅` for every element). One step (`iop0`) gives, for every
-- constructor `c` of type `j` and every path, the tuple `c :: g` at `a`; the
-- operator `iop` takes the union of `iop0` over the candidates below that are
-- elements of `U`, so it is monotone whatever the data, and its least fixed
-- point `ifam` is a fixed point (`ifam_fix`). For legal data, `iop0` is
-- monotone at candidates of `U` (positivity, layer E1) and `ifam` is in `U`
-- (layer E2), and then `ifam` is closed under `iop0` itself (`ifam_closed`).
-- `ity` is type `j`'s entry; the value of `ind_ty D j` is `ityv`, which is
-- `ity` when that lies in the curried `Π` (`ipi`) of the parameters and type
-- `j`'s type (`igate`) and the trivial family `itriv` otherwise (`{scons ∅ ∅}`
-- at every argument valuation): `ind_ty_ty` has only `tys_ok` as a premise, so
-- the value must have its type whatever the constructors (for legal data the
-- gate holds, layer E2). The trivial family is inhabited at every argument
-- valuation, so that a typing in a context with a field of an ungated type is
-- not vacuous: E2 reads the field types' universes off such typings.
-- `ictor` (of `ind_ctor D j c`) is the trace of `c :: g` over the parameters
-- and the fields, `∅` for a proposition. The hook's parts `hty`, `hctor` give
-- them at the trees `ind_ty D J`, `ind_ctor D J C` (`dt_ind_ty`,
-- `dt_ind_ctor`); the
-- recursors follow in a second part. Imports model-core.mm0; proofs in
-- model-ind.auf.

import "model-core.mm0";

-- --------------------------------------------------------------------------
-- Subtrees, and the course-of-values hook
-- --------------------------------------------------------------------------

--| One step of `tsub`: the node itself and its children's subtrees.
def tsb (K S V: class): class = $ csn ⟨ K , S ⟩ ∪ ⋃ (crn V) $;
--| The subtrees of a tree, itself included.
def tsub (.k .s .v: set): class = $ trc ω (cgr3 k s v (tsb k s v)) $;
--| The proper subtrees of a node with the children `S`.
def psub (S: class): class = $ ⋃ (crn (ccom tsub S)) $;
--| The children's values, read off their tables `V`.
def cvv (S V: class) (.i .y .z: set): class =
  $ {z | ∃ i ∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm S ∧ y = (V' i)' S' i)} $;
--| One step of the course-of-values recursion: the table of the node's
--| subtrees, the node's own value as `dnb` gives it with `H` as the hook, `H`
--| seeing the union of the children's tables.
def cvb (U H K S V: class): class =
  $ ⋃ (crn V) ∪ csn ⟨ ⟨ K , S ⟩ ,
      dnb U (csn ⟨ ⟨ U , ⟨ K , ⟨ S , cvv S V ⟩ ⟩ ⟩ , H' ⟨ U , ⟨ K , ⟨ S , ⋃ (crn V) ⟩ ⟩ ⟩ ⟩)
        K S (cvv S V) ⟩ $;
def cvf (U H: class) (.k .s .v: set): class = $ trc ω (cgr3 k s v (cvb U H k s v)) $;
--| The hook of `H`: at a node, `H` given the table of the node's proper subtrees.
def mcv (H: class) (.u .k .s .v .z: set): class =
  $ {z | ∃ u ∃ k ∃ s ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ s , v ⟩ ⟩ ⟩ ,
      H' ⟨ u , ⟨ k , ⟨ s , ⋃ (crn (ccom (cvf u H) s)) ⟩ ⟩ ⟩ ⟩)} $;
--| `E` and `E2` agree on the subtrees of `T`, and at `∅` (what a node reads
--| at a child it does not have).
def eagr (E E2 T: class) (.t: set): fml =
  $ E' ∅ = E2' ∅ ∧ ∀ t (t ∊ tsub' T → E' t = E2' t) $;

--| @congr
theorem tsb_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ tsb A C E ≐ tsb B D F $;
--| @rewrite
theorem sb_c_tsb {x: set} (t: set x) (A B C: class x):
  $ (⟦ x / t ⟧ (tsb A B C)) ≐ tsb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $;
--| @congr
theorem psub_congr (A B: class): $ A ≐ B $ > $ psub A ≐ psub B $;
--| @rewrite
theorem sb_c_psub {x: set} (t: set x) (A: class x): $ (⟦ x / t ⟧ (psub A)) ≐ psub (⟦ x / t ⟧ A) $;
--| @congr
theorem cvv_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ cvv A C ≐ cvv B D $;
--| @rewrite
theorem sb_c_cvv {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (cvv A B)) ≐ cvv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
--| @congr
theorem cvb_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ cvb A C E H J ≐ cvb B D F I K $;
--| @rewrite
theorem sb_c_cvb {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (cvb A B C D E)) ≐ cvb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem cvf_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ cvf A C ≐ cvf B D $;
--| @rewrite
theorem sb_c_cvf {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (cvf A B)) ≐ cvf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
--| @congr
theorem mcv_congr (A B: class): $ A ≐ B $ > $ mcv A ≐ mcv B $;
--| @rewrite
theorem sb_c_mcv {x: set} (t: set x) (A: class x): $ (⟦ x / t ⟧ (mcv A)) ≐ mcv (⟦ x / t ⟧ A) $;
--| @congr
theorem eagr_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ eagr A C E ⟺ eagr B D F $;
--| @rewrite
theorem sb_f_eagr {x: set} (t: set x) (A B C: class x):
  $ [x/t] (eagr A B C) ⟺ eagr (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $;

theorem tsub_functional (G: hyps): $ G ⇒ functional tsub $;
theorem tsub_cdm (G: hyps): $ G ⇒ cdm tsub = trees ω $;
theorem tsub_node (G: hyps) (k s: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ >
  $ G ⇒ tsub' ⟨ k , s ⟩ = csn ⟨ k , s ⟩ ∪ psub s $;
--| Class form of `tsub_node`.
theorem tsub_node_c (G: hyps) (K S: class):
  $ G ⇒ K ∈ ω $ > $ G ⇒ S ∈ fseq (trees ω) $ >
  $ G ⇒ tsub' ⟨ K , S ⟩ = csn ⟨ K , S ⟩ ∪ psub S $;
theorem tsub_self (G: hyps) (T: class): $ G ⇒ T ∈ trees ω $ > $ G ⇒ T ∈ tsub' T $;
--| Elimination and introduction for `psub`.
--| @freshen G c
--| @freshen H c
--| @freshen d c
theorem psub_elim {c: set} (G H: hyps) (S: class) (x: set) (d: fml):
  $ G ⇒ x ∊ psub S $ > $ H , c ∊ crn S , x ∊ tsub' c ⇒ d $ > $ G , H ⇒ d $;
theorem psub_intro (G: hyps) (S: class) (c x: set):
  $ G ⇒ c ∊ crn S $ > $ G ⇒ x ∊ tsub' c $ > $ G ⇒ x ∊ psub S $;
theorem tsub_trees (G: hyps) (T: class): $ G ⇒ tsub' T ⊆ trees ω $;
--| A subtree's subtrees are subtrees.
theorem tsub_trans (G: hyps) (T T2: class): $ G ⇒ T2 ∈ tsub' T $ > $ G ⇒ tsub' T2 ⊆ tsub' T $;
--| A child's subtrees are proper subtrees of the node.
theorem psub_child (G: hyps) (S: class) (i: set):
  $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ i ∊ cdm S $ > $ G ⇒ tsub' S' i ⊆ psub S $;
--| The children of nodes with one, two, three or four children.
theorem tsub_kid0 (G: hyps) (K A S: class):
  $ G ⇒ K ∈ ω $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ A ∈ tsub' ⟨ K , scons A S ⟩ $;
theorem tsub_kid1 (G: hyps) (K A B S: class):
  $ G ⇒ K ∈ ω $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ S ∈ fseq (trees ω) $ >
  $ G ⇒ B ∈ tsub' ⟨ K , scons A (scons B S) ⟩ $;
theorem tsub_kid2 (G: hyps) (K A B C S: class):
  $ G ⇒ K ∈ ω $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ C ∈ trees ω $ > $ G ⇒ S ∈ fseq (trees ω) $ >
  $ G ⇒ C ∈ tsub' ⟨ K , scons A (scons B (scons C S)) ⟩ $;
--| The children are subtrees of the node.
theorem tsub_crn (G: hyps) (k s y: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ y ∊ crn s $ > $ G ⇒ y ∈ tsub' ⟨ k , s ⟩ $;

theorem cvf_functional (G: hyps) (H: class) (u: set): $ G ⇒ functional (cvf u H) $;
theorem cvf_node (G: hyps) (H: class) (u k s: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ >
  $ G ⇒ (cvf u H)' ⟨ k , s ⟩ = cvb u H k s (ccom (cvf u H) s) $;
--| The tables are defined at every tree.
theorem cvf_cdm (G: hyps) (H: class) (u: set): $ G ⇒ cdm (cvf u H) = trees ω $;
--| The table at a tree is the denotation with the hook `mcv H` on its subtrees
--| (by induction on the trees).
theorem cvf_tab (G: hyps) (H: class) (u t: set):
  $ G ⇒ t ∊ trees ω $ > $ G ⇒ (cvf u H)' t = dnf u (mcv H) ↾ tsub' t $;
--| What `mcv H` gives at a node: `H` with the table of the proper subtrees.
theorem mcv_fv (G: hyps) (H K S V: class) (u: set):
  $ G ⇒ functional H $ > $ G ⇒ K ∈ ω $ > $ G ⇒ S ∈ fseq (trees ω) $ >
  $ G ⇒ (mcv H)' ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = H' ⟨ u , ⟨ K , ⟨ S , dnf u (mcv H) ↾ psub S ⟩ ⟩ ⟩ $;
--| The denotation at a node the hook interprets.
theorem dt_mcv (G: hyps) (H K S: class) (u w r: set):
  $ G ⇒ functional H $ > $ G ⇒ K ∈ kexa $ > $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ dt u (mcv H) ⟨ K , S ⟩ w r =
      mclip u (ap (H' ⟨ u , ⟨ K , ⟨ S , dnf u (mcv H) ↾ psub S ⟩ ⟩ ⟩) w) $;
--| The table agrees with the denotation on the subtrees of a child.
theorem eagr_psub (G: hyps) (M S: class) (u i: set):
  $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ i ∊ cdm S $ >
  $ G ⇒ eagr (dnf u M ↾ psub S) (dnf u M) (S' i) $;
theorem eagr_sub (G: hyps) (E E2 T T2: class):
  $ G ⇒ eagr E E2 T $ > $ G ⇒ T2 ∈ tsub' T $ > $ G ⇒ eagr E E2 T2 $;
--| `eagr` is symmetric, and gives equal values at the subtrees.
theorem eagr_sym (G: hyps) (E E2 T: class): $ G ⇒ eagr E E2 T $ > $ G ⇒ eagr E2 E T $;
theorem eagr_at (G: hyps) (E E2 T: class) (b: set):
  $ G ⇒ eagr E E2 T $ > $ G ⇒ b ∊ tsub' T $ > $ G ⇒ E' b = E2' b $;

-- --------------------------------------------------------------------------
-- Curried traces as sets of points
-- --------------------------------------------------------------------------

--| One step of `nest`: `⟨ i , a ⟩ ↦ ⟨ suc i , ⟨ S(i) , a ⟩ ⟩`.
def nstep (S: class) (.i .a .z: set): class =
  $ {z | ∃ i ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ S' i , a ⟩ ⟩ ⟩)} $;
--| `⟨ S(n-1) , ⟨ .. , ⟨ S(0) , Y ⟩ ⟩ ⟩` for a sequence `S` of length `n`: the
--| point of a curried trace with the value `Y` at the valuation `S` (`S(0)`,
--| the innermost variable, is the last argument).
def nest (S Y: class): class = $ ⋃ (crn (csn ((omrec ⟨ ∅ , Y ⟩ (nstep S))' (cdm S)))) $;
--| A curried trace's value at the valuation `S`.
def apn (F S: class) (.y: set): class = $ {y | nest S y ∈ F} $;

--| @congr
theorem nstep_congr (A B: class): $ A ≐ B $ > $ nstep A ≐ nstep B $;
--| @rewrite
theorem sb_c_nstep {x: set} (t: set x) (A: class x): $ (⟦ x / t ⟧ (nstep A)) ≐ nstep (⟦ x / t ⟧ A) $;
--| @congr
theorem nest_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ nest A C ≐ nest B D $;
--| @rewrite
theorem sb_c_nest {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (nest A B)) ≐ nest (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
theorem nest_eq (G: hyps) (A B C D: class): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ nest A C = nest B D $;
--| @congr
theorem apn_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ apn A C ≐ apn B D $;
--| @rewrite
theorem sb_c_apn {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (apn A B)) ≐ apn (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
theorem apn_eq (G: hyps) (A B C D: class): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ apn A C = apn B D $;

theorem nest_set (G: hyps) (S Y: class): $ G ⇒ isset (nest S Y) $;
theorem nest_empty (G: hyps) (Y: class): $ G ⇒ isset Y $ > $ G ⇒ nest ∅ Y = Y $;
theorem nest_ssnoc (G: hyps) (A Y: class) (s a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ isset Y $ > $ G ⇒ nest (ssnoc s a) Y = ⟨ a , nest s Y ⟩ $;
theorem nest_scons (G: hyps) (A Y: class) (s a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ isset Y $ > $ G ⇒ nest (scons a s) Y = nest s ⟨ a , Y ⟩ $;
--| Class form of `nest_scons`.
theorem nest_scons_c (G: hyps) (A Y S: class) (a: set): $ G ⇒ S ∈ fseq A $ > $ G ⇒ isset Y $ > $ G ⇒ nest (scons a S) Y = nest S ⟨ a , Y ⟩ $;
theorem nest_scat (G: hyps) (A Y: class) (s t: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ isset Y $ >
  $ G ⇒ nest (s ++ t) Y = nest t (nest s Y) $;
--| Points of the same length are equal only at equal valuations and values.
theorem nest_inj (G: hyps) (A: class) (s t y z: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ cdm s = cdm t $ > $ G ⇒ nest s y = nest t z $ >
  $ G ⇒ s = t ∧ y = z $;
--| Class form of `nest_inj`.
theorem nest_inj_c (G: hyps) (A S T Y Z: class):
  $ G ⇒ S ∈ fseq A $ > $ G ⇒ T ∈ fseq A $ > $ G ⇒ cdm S = cdm T $ > $ G ⇒ nest S Y = nest T Z $ >
  $ G ⇒ isset Y $ > $ G ⇒ isset Z $ > $ G ⇒ S = T ∧ Y = Z $;
theorem nest_universe (G: hyps) (U: class) (s y: set):
  $ G ⇒ universe U $ > $ G ⇒ s ∊ fseq U $ > $ G ⇒ y ∊ U $ > $ G ⇒ nest s y ∈ U $;
--| A curried trace's value at a valuation, read off its points.
theorem apn_wcel (G: hyps) (F S B: class): $ G ⇒ isset B $ > $ G ⇒ B ∈ apn F S ↔ nest S B ∈ F $;
theorem apn_empty (G: hyps) (F: class): $ G ⇒ apn F ∅ = F $;
theorem apn_ssnoc (G: hyps) (A F: class) (s a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ apn F (ssnoc s a) = apn (ap F a) s $;
theorem apn_scons (G: hyps) (A F: class) (s a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ apn F (scons a s) = ap (apn F s) a $;
--| Class form of `apn_scons`.
theorem apn_scons_c (G: hyps) (V F X S: class):
  $ G ⇒ isset X $ > $ G ⇒ S ∈ fseq V $ > $ G ⇒ apn F (scons X S) = ap (apn F S) X $;
--| `apn` is monotone in the trace.
theorem apn_mono (G: hyps) (F F2 S: class): $ G ⇒ F ⊆ F2 $ > $ G ⇒ apn F S ⊆ apn F2 S $;
theorem apn_scat (G: hyps) (A F: class) (s t: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ apn F (s ++ t) = apn (apn F t) s $;
--| A curried trace's value at any set is a set when the trace is a set without
--| `∅` among its points (at a valuation whose length is not a number the point
--| collapses to `∅`).
theorem apn_set (G: hyps) (F S: class):
  $ G ⇒ isset F $ > $ G ⇒ isset S $ > $ G ⇒ ¬ ∅ ∈ F $ > $ G ⇒ isset (apn F S) $;
--| A point and a value at a valuation with one or two entries.
theorem nest_one (G: hyps) (A Y: class): $ G ⇒ isset A $ > $ G ⇒ isset Y $ > $ G ⇒ nest (scons A ∅) Y = ⟨ A , Y ⟩ $;
theorem nest_two (G: hyps) (A B Y: class): $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ isset Y $ > $ G ⇒ nest (scons A (scons B ∅)) Y = ⟨ B , ⟨ A , Y ⟩ ⟩ $;
theorem apn_one (G: hyps) (F A: class): $ G ⇒ isset A $ > $ G ⇒ apn F (scons A ∅) = ap F A $;
theorem apn_two (G: hyps) (F A B: class): $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ apn F (scons A (scons B ∅)) = ap (ap F B) A $;

-- --------------------------------------------------------------------------
-- Telescopes, relative to a table `E`
-- --------------------------------------------------------------------------

--| One step of `esat`: `stb` with the values read off `E`.
def esb (U E K S V: class) (.w .r .x .q .z: set): class =
  $ {z | (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨
         (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧
            ∃ x ∃ q (q ∊ ap (V' (suc ∅)) w ∧ x ∊ da (E' S' ∅) w q ∧ r = scons x q)})} $;
def esf (U E: class) (.k .s .v: set): class = $ trc ω (cgr3 k s v (esb U E k s v)) $;
--| The valuations satisfying the context tree `T` at `W`, the values read off `E`.
def esat (U E T W: class): class = $ ap ((esf U E)' T) W $;
--| One step of `etel`. At `pi A B` the paths of `B` at `x :: r` for each `x`
--| in the value of `A`, with `x` added: to the fields as a valuation (last), to
--| the fields in order (first), and `A`'s own paths at `r` to the telescopes;
--| at `app F A` the paths of `F` with no fields, the value of `A` added to
--| the arguments (first: the last argument is `#0`); elsewhere one path with
--| nothing.
def etb (U E K S V: class) (.w .r .x .f .g .t .a .y .z: set): class =
  $ {z | (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq U) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (
            x ∊ da (E' S' ∅) w r ∧ x ∊ U ∧
            ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (V' (suc ∅)) w (scons x r) ∧
            y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (V' ∅) w r) t , a ⟩ ⟩ ⟩)})) ∨
         (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq U) {y | ∃ a (
            ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (V' ∅) w r ∧
            y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' S' (suc ∅)) w r) a ⟩ ⟩ ⟩)})) ∨
         (¬ K = kc_pi ∧ ¬ K = kc_app ∧
            z ∊ clam w lvals (clam r (fseq U) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))} $;
def etf (U E: class) (.k .s .v: set): class = $ trc ω (cgr3 k s v (etb U E k s v)) $;
--| The paths of the telescope `T` at `W` and the valuation `R`.
def etel (U E T W R: class): class = $ da ((etf U E)' T) W R $;

--| @congr
theorem esb_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ esb A C E H J ≐ esb B D F I K $;
--| @rewrite
theorem sb_c_esb {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (esb A B C D E)) ≐ esb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem esf_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ esf A C ≐ esf B D $;
--| @rewrite
theorem sb_c_esf {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (esf A B)) ≐ esf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
--| @congr
theorem esat_congr (A B C D E F H I: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ esat A C E H ≐ esat B D F I $;
--| @rewrite
theorem sb_c_esat {x: set} (t: set x) (A B C D: class x):
  $ (⟦ x / t ⟧ (esat A B C D)) ≐ esat (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) $;
--| @congr
theorem etb_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ etb A C E H J ≐ etb B D F I K $;
--| @rewrite
theorem sb_c_etb {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (etb A B C D E)) ≐ etb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem etf_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ etf A C ≐ etf B D $;
--| @rewrite
theorem sb_c_etf {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (etf A B)) ≐ etf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
--| @congr
theorem etel_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ etel A C E H J ≐ etel B D F I K $;
--| @rewrite
theorem sb_c_etel {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (etel A B C D E)) ≐ etel (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;

--| With the denotation for the table, `esat` is `sat`.
theorem esat_dnf (M T W: class) (u: set): $ esat u (dnf u M) T W ≐ sat u M T W $;
--| `esb` under equal arguments; `esf` and `etf` are functions on the trees.
theorem esb_eq (G: hyps) (A B C D E F H I J K: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ E = F $ > $ G ⇒ H = I $ > $ G ⇒ J = K $ >
  $ G ⇒ esb A C E H J = esb B D F I K $;
theorem esf_functional (G: hyps) (M: class) (u: set): $ G ⇒ functional (esf u M) $;
theorem esf_node (G: hyps) (M: class) (u k s: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ >
  $ G ⇒ (esf u M)' ⟨ k , s ⟩ = esb u M k s (ccom (esf u M) s) $;
theorem esat_fseq (G: hyps) (E T W: class) (u: set): $ G ⇒ esat u E T W ⊆ fseq u $;
theorem esat_nil (G: hyps) (E: class) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ esat u E ⟨ kc_nil , ∅ ⟩ w = csn ∅ $;
--| @freshen G r
--| @freshen G x
--| @freshen G q
theorem esat_cons {r x q: set} (G: hyps) (E A T: class) (u w: set):
  $ G ⇒ A ∈ trees ω $ > $ G ⇒ T ∈ trees ω $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ esat u E ⟨ kc_cons , scons A (scons T ∅) ⟩ w =
      {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (E' A) w q ∧ r = scons x q)} $;
--| A valuation of `A :: P`: an element of `A`'s value at a valuation of `P`
--| in front of it (in the `cuni_elim` style).
theorem esat_cons_intro (G: hyps) (E A P: class) (u w a c: set):
  $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ c ∊ esat u E P w $ >
  $ G ⇒ a ∊ da (E' A) w c $ > $ G ⇒ a ∊ u $ > $ G ⇒ scons a c ∈ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $;
--| @freshen G x
--| @freshen G q
--| @freshen H x
--| @freshen H q
--| @freshen d x
--| @freshen d q
theorem esat_cons_elim {x q: set} (G H: hyps) (E A P: class) (u w e: set) (d: fml):
  $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ e ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ >
  $ H , q ∊ esat u E P w , x ∊ da (E' A) w q , e = scons x q ⇒ d $ > $ G , H ⇒ d $;
theorem esf_cdm (G: hyps) (E: class) (u: set): $ G ⇒ cdm (esf u E) = trees ω $;
--| Two valuations satisfying the same context tree have the same length.
theorem esat_len (G: hyps) (E T: class) (u w p q: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ p ∊ esat u E T w $ > $ G ⇒ q ∊ esat u E T w $ > $ G ⇒ cdm p = cdm q $;
theorem esat_local (G: hyps) (E E2 T W: class) (u: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ eagr E E2 T $ > $ G ⇒ esat u E T W = esat u E2 T W $;

theorem etf_functional (G: hyps) (E: class) (u: set): $ G ⇒ functional (etf u E) $;
--| The node equation, the children's values named by `c`.
theorem etf_node (G: hyps) (E: class) (u k s c: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ c = ccom (etf u E) s $ >
  $ G ⇒ (etf u E)' ⟨ k , s ⟩ = etb u E k s c $;
theorem etf_cdm (G: hyps) (E: class) (u: set): $ G ⇒ cdm (etf u E) = trees ω $;
--| @freshen G y
--| @freshen G x
--| @freshen G f
--| @freshen G g
--| @freshen G t
--| @freshen G a
theorem etel_pi {y x f g t a: set} (G: hyps) (E A B: class) (u w r: set):
  $ G ⇒ A ∈ trees ω $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ etel u E ⟨ kc_pi , scons A (scons B ∅) ⟩ w r =
      {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (E' A) w r ∧ x ∊ u ∧
         ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x r) ∧
         y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u E A w r) t , a ⟩ ⟩ ⟩)} $;
--| @freshen G y
--| @freshen G a
theorem etel_app {y a: set} (G: hyps) (E F A: class) (u w r: set):
  $ G ⇒ F ∈ trees ω $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ etel u E ⟨ kc_app , scons F (scons A ∅) ⟩ w r =
      {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u E F w r ∧
         y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' A) w r) a ⟩ ⟩ ⟩)} $;
theorem etel_other (G: hyps) (E K S: class) (u w r: set):
  $ G ⇒ K ∈ ω $ > $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $;
--| Class form of `etel_other`.
theorem etel_other_c (G: hyps) (E K S W R: class) (u: set): $ G ⇒ K ∈ ω $ > $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ etel u E ⟨ K , S ⟩ W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $;
--| A path's fields are sequences over `u` (the arguments are values of `E`).
theorem etel_fseq (G: hyps) (E T: class) (u w r f g t a: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w r $ >
  $ G ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $;
--| A path's telescopes are a sequence.
--| @freshen G y
theorem etel_tab_fseq {y: set} (G: hyps) (E T: class) (u w r f g t a: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w r $ >
  $ G ⇒ t ∊ fseq {y | y = y} $;
--| The paths of a telescope at any two valuations have the same number of fields.
theorem etel_len (G: hyps) (E T: class) (u w r r2 f g t a f2 g2 t2 a2: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w r $ >
  $ G ⇒ ⟨ f2 , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E T w r2 $ > $ G ⇒ cdm f = cdm f2 $;
--| A path is determined by its fields as a valuation.
theorem etel_det (G: hyps) (E T: class) (u w r f g t a g2 t2 a2: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w r $ >
  $ G ⇒ ⟨ f , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E T w r $ > $ G ⇒ g = g2 ∧ t = t2 ∧ a = a2 $;
theorem etel_local (G: hyps) (E E2 T W R: class) (u: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ eagr E E2 T $ > $ G ⇒ etel u E T W R = etel u E2 T W R $;
--| `etel` under equal arguments (the universe and the table fixed).
theorem etel_eq (G: hyps) (U E T T2 W W2 R R2: class):
  $ G ⇒ T = T2 $ > $ G ⇒ W = W2 $ > $ G ⇒ R = R2 $ > $ G ⇒ etel U E T W R = etel U E T2 W2 R2 $;
--| `esat` under equal trees and level valuations.
theorem esat_eq (G: hyps) (U E T T2 W W2: class):
  $ G ⇒ T = T2 $ > $ G ⇒ W = W2 $ > $ G ⇒ esat U E T W = esat U E T2 W2 $;
--| A path with no fields, `⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩`, determines its
--| arguments `A`, and equal arguments give equal paths.
theorem path0_inj (G: hyps) (A B: class):
  $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ A = B $;
theorem path0_eq (G: hyps) (A B: class):
  $ G ⇒ A = B $ > $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $;
--| `etel_other` for a node given as a tree.
theorem etel_other_trees (G: hyps) (E K S: class) (u w r: set):
  $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $;
--| An application of a tree with one path and no fields has one path and no
--| fields, with the argument's value in front.
theorem etel_app_csn (G: hyps) (E F A2 A: class) (u w r: set):
  $ G ⇒ F ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ etel u E F w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ > $ G ⇒ isset A $ >
  $ G ⇒ etel u E ⟨ kc_app , scons F (scons A2 ∅) ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (E' A2) w r) A ⟩ ⟩ ⟩ $;
--| An application's and a `Π`'s paths at two valuations are equal when their
--| parts' are (the head's paths and the argument's value; the domain's value
--| and paths, and the body's paths at every extension).
theorem etel_app_vals (G: hyps) (E F A: class) (u w r r2: set):
  $ G ⇒ F ∈ trees ω $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ >
  $ G ⇒ etel u E F w r = etel u E F w r2 $ > $ G ⇒ da (E' A) w r = da (E' A) w r2 $ >
  $ G ⇒ etel u E ⟨ kc_app , scons F (scons A ∅) ⟩ w r = etel u E ⟨ kc_app , scons F (scons A ∅) ⟩ w r2 $;
--| @freshen G x
theorem etel_pi_vals {x: set} (G: hyps) (E A B: class) (u w r r2: set):
  $ G ⇒ A ∈ trees ω $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ >
  $ G ⇒ da (E' A) w r = da (E' A) w r2 $ > $ G ⇒ etel u E A w r = etel u E A w r2 $ >
  $ G ⇒ ∀ x (x ∊ u → etel u E B w (scons x r) = etel u E B w (scons x r2)) $ >
  $ G ⇒ etel u E ⟨ kc_pi , scons A (scons B ∅) ⟩ w r = etel u E ⟨ kc_pi , scons A (scons B ∅) ⟩ w r2 $;
--| `etel_pi_vals` for inclusion: the paths grow when the domain's value grows,
--| its paths are equal and the body's paths grow at every extension.
--| @freshen G x
theorem etel_pi_mono {x: set} (G: hyps) (E A B: class) (u w r s: set):
  $ G ⇒ A ∈ trees ω $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ da (E' A) w r ⊆ da (E' A) w s $ > $ G ⇒ etel u E A w r = etel u E A w s $ >
  $ G ⇒ ∀ x (x ∊ u → etel u E B w (scons x r) ⊆ etel u E B w (scons x s)) $ >
  $ G ⇒ etel u E ⟨ kc_pi , scons A (scons B ∅) ⟩ w r ⊆ etel u E ⟨ kc_pi , scons A (scons B ∅) ⟩ w s $;

-- --------------------------------------------------------------------------
-- Reading the block
-- --------------------------------------------------------------------------

--| Block `D` has the parameters `P` and the types `T`.
def iprt (D P T: class) (.b: set): fml = $ ∃ b (ra_ind_data D b P T ∈ lrel) $;
--| Type `j` (a number) of block `D` has the type `F`.
def ityf (D j F: class) (.p .t .n .c: set): fml =
  $ ∃ p ∃ t ∃ n ∃ c (iprt D p t ∧ nvf' n = j ∧ ra_nth_ty t n F c ∈ lrel) $;
--| Constructor `c` of type `j` of block `D` has the type `K`.
def ictk (D j c K: class) (.p .t .n .f .e .m: set): fml =
  $ ∃ p ∃ t ∃ n ∃ f ∃ e ∃ m (iprt D p t ∧ nvf' n = j ∧ ra_nth_ty t n f e ∈ lrel ∧
      nvf' m = c ∧ ra_nth_ctor e m K ∈ lrel) $;
--| Type `j` of `D` is a proposition at `W`: its sort's level is zero there.
def iprop (D j W: class) (.f .k .l: set): fml =
  $ ∃ f ∃ k ∃ l (ityf D j f ∧ ra_isort f k l ∈ lrel ∧ lv l W = ∅) $;
--| The number of types of `D` (as the set of the types' numbers).
def intys (D: class) (.p .t .n .m .y: set): class =
  $ {y | ∃ p ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ nvf' n)} $;

--| @congr
theorem iprt_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ iprt A C E ⟺ iprt B D F $;
--| @rewrite
theorem sb_f_iprt {x: set} (t: set x) (A B C: class x):
  $ [x/t] (iprt A B C) ⟺ iprt (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $;
--| @congr
theorem ityf_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ ityf A C E ⟺ ityf B D F $;
--| @rewrite
theorem sb_f_ityf {x: set} (t: set x) (A B C: class x):
  $ [x/t] (ityf A B C) ⟺ ityf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $;
--| @congr
theorem ictk_congr (A B C D E F H I: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ ictk A C E H ⟺ ictk B D F I $;
--| @rewrite
theorem sb_f_ictk {x: set} (t: set x) (A B C D: class x):
  $ [x/t] (ictk A B C D) ⟺ ictk (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) $;
--| @congr
theorem iprop_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ iprop A C E ⟺ iprop B D F $;
--| @rewrite
theorem sb_f_iprop {x: set} (t: set x) (A B C: class x):
  $ [x/t] (iprop A B C) ⟺ iprop (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $;
--| @congr
theorem intys_congr (A B: class): $ A ≐ B $ > $ intys A ≐ intys B $;
--| @rewrite
theorem sb_c_intys {x: set} (t: set x) (A: class x): $ (⟦ x / t ⟧ (intys A)) ≐ intys (⟦ x / t ⟧ A) $;

--| The parts are subtrees of the block, the types' types and constructor lists
--| of the list of types, a constructor's type of the list of constructors.
theorem iprt_tsub (G: hyps) (D P T: class):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ iprt D P T $ > $ G ⇒ P ∈ tsub' D ∧ T ∈ tsub' D $;
theorem nth_ty_tsub (G: hyps) (T J F C: class):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ ra_nth_ty T J F C ∈ lrel $ > $ G ⇒ F ∈ tsub' T ∧ C ∈ tsub' T $;
theorem nth_ctor_tsub (G: hyps) (C J K: class):
  $ G ⇒ C ∈ trees ω $ > $ G ⇒ ra_nth_ctor C J K ∈ lrel $ > $ G ⇒ K ∈ tsub' C $;
theorem ityf_tsub (G: hyps) (D j F: class): $ G ⇒ D ∈ trees ω $ > $ G ⇒ ityf D j F $ > $ G ⇒ F ∈ tsub' D $;
theorem ictk_tsub (G: hyps) (D j c K: class):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ ictk D j c K $ > $ G ⇒ K ∈ tsub' D $;
--| The parts are determined by the numbers (`nth_ty`, `nth_ctor` at numerals
--| with the same value).
theorem nth_ty_nvf (G: hyps) (T J J2 F F2 C C2: class):
  $ G ⇒ ra_nth_ty T J F C ∈ lrel $ > $ G ⇒ ra_nth_ty T J2 F2 C2 ∈ lrel $ > $ G ⇒ nvf' J = nvf' J2 $ >
  $ G ⇒ F = F2 ∧ C = C2 $;
theorem nth_ctor_nvf (G: hyps) (C J J2 K K2: class):
  $ G ⇒ ra_nth_ctor C J K ∈ lrel $ > $ G ⇒ ra_nth_ctor C J2 K2 ∈ lrel $ > $ G ⇒ nvf' J = nvf' J2 $ >
  $ G ⇒ K = K2 $;
--| The block's parts are determined.
theorem iprt_det (G: hyps) (D: class) (p t q r: set):
  $ G ⇒ iprt D p t $ > $ G ⇒ iprt D q r $ > $ G ⇒ p = q ∧ t = r $;
theorem ityf_det (G: hyps) (D j F F2: class): $ G ⇒ ityf D j F $ > $ G ⇒ ityf D j F2 $ > $ G ⇒ F = F2 $;
theorem ictk_det (G: hyps) (D j c K K2: class):
  $ G ⇒ ictk D j c K $ > $ G ⇒ ictk D j c K2 $ > $ G ⇒ K = K2 $;
theorem ictk_omega (G: hyps) (D j c K: class): $ G ⇒ ictk D j c K $ > $ G ⇒ j ∈ ω ∧ c ∈ ω $;
--| Introduction and elimination for `ityf`, `ictk` and `iprop`.
theorem ityf_intro (G: hyps) (D j F: class) (p2 t2 n2 c2: set):
  $ G ⇒ iprt D p2 t2 $ > $ G ⇒ nvf' n2 = j $ > $ G ⇒ ra_nth_ty t2 n2 F c2 ∈ lrel $ > $ G ⇒ ityf D j F $;
--| @freshen G p
--| @freshen G t
--| @freshen G n
--| @freshen G c
--| @freshen H p
--| @freshen H t
--| @freshen H n
--| @freshen H c
--| @freshen c0 p
--| @freshen c0 t
--| @freshen c0 n
--| @freshen c0 c
theorem ityf_elim {p t n c: set} (G H: hyps) (D j F: class) (c0: fml):
  $ G ⇒ ityf D j F $ > $ H , iprt D p t , nvf' n = j , ra_nth_ty t n F c ∈ lrel ⇒ c0 $ > $ G , H ⇒ c0 $;
theorem ictk_intro (G: hyps) (D j c K: class) (p2 t2 n2 f2 e2 m2: set):
  $ G ⇒ iprt D p2 t2 $ > $ G ⇒ nvf' n2 = j $ > $ G ⇒ ra_nth_ty t2 n2 f2 e2 ∈ lrel $ >
  $ G ⇒ nvf' m2 = c $ > $ G ⇒ ra_nth_ctor e2 m2 K ∈ lrel $ > $ G ⇒ ictk D j c K $;
--| `ictk` by cases. The parts stay one hypothesis: two `lrel` atoms that
--| differ only in their labels make `ax` slow.
--| @freshen G p
--| @freshen G t
--| @freshen G n
--| @freshen G f
--| @freshen G e
--| @freshen G m
--| @freshen H p
--| @freshen H t
--| @freshen H n
--| @freshen H f
--| @freshen H e
--| @freshen H m
--| @freshen c0 p
--| @freshen c0 t
--| @freshen c0 n
--| @freshen c0 f
--| @freshen c0 e
--| @freshen c0 m
theorem ictk_elim {p t n f e m: set} (G H: hyps) (D j c K: class) (c0: fml):
  $ G ⇒ ictk D j c K $ >
  $ H , iprt D p t ∧ nvf' n = j ∧ ra_nth_ty t n f e ∈ lrel ∧ nvf' m = c ∧ ra_nth_ctor e m K ∈ lrel ⇒ c0 $ >
  $ G , H ⇒ c0 $;
theorem iprop_intro (G: hyps) (D j W: class) (f2 k2 l2: set):
  $ G ⇒ ityf D j f2 $ > $ G ⇒ ra_isort f2 k2 l2 ∈ lrel $ > $ G ⇒ lv l2 W = ∅ $ > $ G ⇒ iprop D j W $;
--| @freshen G f
--| @freshen G k
--| @freshen G l
--| @freshen H f
--| @freshen H k
--| @freshen H l
--| @freshen c0 f
--| @freshen c0 k
--| @freshen c0 l
theorem iprop_elim {f k l: set} (G H: hyps) (D j W: class) (c0: fml):
  $ G ⇒ iprop D j W $ > $ H , ityf D j f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ c0 $ > $ G , H ⇒ c0 $;
--| The reading predicates under equal arguments.
theorem iprt_eq (G: hyps) (D D2 P P2 T T2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ P = P2 $ > $ G ⇒ T = T2 $ > $ G ⇒ iprt D P T $ > $ G ⇒ iprt D2 P2 T2 $;
theorem ityf_eq (G: hyps) (D D2 J J2 F F2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ F = F2 $ > $ G ⇒ ityf D J F $ > $ G ⇒ ityf D2 J2 F2 $;
theorem ictk_eq (G: hyps) (D D2 J J2 C C2 K K2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ C = C2 $ > $ G ⇒ K = K2 $ > $ G ⇒ ictk D J C K $ >
  $ G ⇒ ictk D2 J2 C2 K2 $;
theorem iprop_eq (G: hyps) (D D2 J J2 W W2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ W = W2 $ > $ G ⇒ iprop D J W $ > $ G ⇒ iprop D2 J2 W2 $;
theorem intys_eq (G: hyps) (D D2: class): $ G ⇒ D = D2 $ > $ G ⇒ intys D = intys D2 $;

-- --------------------------------------------------------------------------
-- The block's types (C5)
-- --------------------------------------------------------------------------

--| The entry of type `j` for a candidate `Z` (a set of `⟨ j , ⟨ a , x ⟩ ⟩`):
--| the curried trace with the value `x` at `a`, or `∅` if the type is a
--| proposition at `W`.
def ient (D W Z j: class) (.a .x .y: set): class =
  $ {y | ∃ a ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧
      ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)))} $;
--| The block's types valued by the candidate `Z`: type `j` at `j`.
def ixs (D W Z: class) (.j .z: set): class = $ {z | ∃ j (j ∊ intys D ∧ z = ⟨ j , ient D W Z j ⟩)} $;
--| One step of the block's types: for every valuation `p` of the parameters
--| and every constructor `c` of type `j` with the type `K`, the tuple `c :: g`
--| at the arguments `a` of `K`'s result, for every path of `K` at `p`, the
--| types valued by `Z`.
def iop0 (U E D W Z: class) (.p .q .e .j .c .k .f .g .t .a .z: set): class =
  $ {z | ∃ p ∃ q ∃ e ∃ j ∃ c ∃ k ∃ f ∃ g ∃ t ∃ a (iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧
       ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (p ++ ixs D W Z) ∧ a ∊ fseq U ∧
       z = ⟨ j , ⟨ a , scons c g ⟩ ⟩)} $;
--| The operator: `iop0` at every candidate below `Y` that is an element of `U`.
def iop (U E D W Y: class) (.x .z: set): class = $ {z | ∃ x (x ⊆ Y ∧ x ∊ U ∧ z ∊ iop0 U E D W x)} $;
--| The block's types: the least fixed point of the operator.
def ifam (U E D W: class) (.y: set): class = $ lfp y (iop U E D W y) $;
--| The value of `ind_ty D j` at `W` (`IndTy`).
def ity (U E D j W: class): class = $ ient D W (ifam U E D W) j $;
--| The value of `ind_ctor D j c` at `W` (`IndCtor`): the trace of `c :: g` over
--| the parameters and the fields, `∅` if the type is a proposition.
def ictor (U E D j c W: class) (.p .q .e .k .f .g .t .a .y .z: set): class =
  $ {z | ¬ iprop D j W ∧ ∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt D q e ∧ p ∊ esat U E q W ∧
       ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (p ++ ixs D W (ifam U E D W)) ∧
       y ∊ scons c g ∧ z = nest (f ++ p) y)} $;

--| @congr
theorem ient_congr (A B C D E F H I: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ ient A C E H ≐ ient B D F I $;
--| @rewrite
theorem sb_c_ient {x: set} (t: set x) (A B C D: class x):
  $ (⟦ x / t ⟧ (ient A B C D)) ≐ ient (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) $;
--| @congr
theorem ixs_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ ixs A C E ≐ ixs B D F $;
--| @rewrite
theorem sb_c_ixs {x: set} (t: set x) (A B C: class x):
  $ (⟦ x / t ⟧ (ixs A B C)) ≐ ixs (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $;
--| @congr
theorem iop0_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ iop0 A C E H J ≐ iop0 B D F I K $;
--| @rewrite
theorem sb_c_iop0 {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (iop0 A B C D E)) ≐ iop0 (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem iop_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ iop A C E H J ≐ iop B D F I K $;
--| @rewrite
theorem sb_c_iop {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (iop A B C D E)) ≐ iop (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem ifam_congr (A B C D E F H I: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ ifam A C E H ≐ ifam B D F I $;
--| @rewrite
theorem sb_c_ifam {x: set} (t: set x) (A B C D: class x):
  $ (⟦ x / t ⟧ (ifam A B C D)) ≐ ifam (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) $;
--| @congr
theorem ity_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ ity A C E H J ≐ ity B D F I K $;
--| @rewrite
theorem sb_c_ity {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (ity A B C D E)) ≐ ity (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem ictor_congr (A B C D E F H I J K L N: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ L ≐ N $ >
  $ ictor A C E H J L ≐ ictor B D F I K N $;
--| @rewrite
theorem sb_c_ictor {x: set} (t: set x) (A B C D E F: class x):
  $ (⟦ x / t ⟧ (ictor A B C D E F)) ≐
      ictor (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) (⟦ x / t ⟧ F) $;

theorem ient_intro (G: hyps) (D W Z j: class) (a x: set):
  $ G ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z $ > $ G ⇒ ¬ iprop D j W $ > $ G ⇒ nest a x ∈ ient D W Z j $;
theorem ient_intro_prop (G: hyps) (D W Z j: class) (a x: set):
  $ G ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z $ > $ G ⇒ iprop D j W $ > $ G ⇒ nest a ∅ ∈ ient D W Z j $;
theorem ient_mono (G: hyps) (D W Z Z2 j: class): $ G ⇒ Z ⊆ Z2 $ > $ G ⇒ ient D W Z j ⊆ ient D W Z2 j $;
--| @freshen G j
theorem ixs_fseq {j: set} (G: hyps) (D W Z: class) (u: set):
  $ G ⇒ ∀ j (j ∊ intys D → ient D W Z j ∈ u) $ > $ G ⇒ intys D ∈ ω $ > $ G ⇒ ixs D W Z ∈ fseq u $;
--| A candidate of a universe gives entries of it.
theorem ient_universe (G: hyps) (D W Z j: class) (u: set):
  $ G ⇒ universe u $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ ient D W Z j ∈ u $;
--| The types' entries and values under equal arguments.
theorem ient_eq (G: hyps) (D D2 W W2 Z Z2 J J2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ Z = Z2 $ > $ G ⇒ J = J2 $ >
  $ G ⇒ ient D W Z J = ient D2 W2 Z2 J2 $;
theorem ixs_eq (G: hyps) (D D2 W W2 Z Z2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ Z = Z2 $ >
  $ G ⇒ ixs D W Z = ixs D2 W2 Z2 $;

--| A path of a telescope comes with set arguments.
theorem etel_isset (G: hyps) (E W R: class) (u o y: set):
  $ G ⇒ o ∊ trees ω $ > $ G ⇒ y ∊ etel u E o W R $ > $ G ⇒ isset W ∧ isset R $;
theorem iop0_sub (G: hyps) (E D W Z: class) (u: set):
  $ G ⇒ iop0 u E D W Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $;
theorem iop_mono {y: set} (G: hyps y) (E D W: class) (u: set): $ G ⇒ mono y (iop u E D W y) $;
theorem iop_setop {y: set} (G: hyps y) (E D W: class) (u: set): $ G ⇒ setop y (iop u E D W y) $;
theorem iop_bounded {y: set} (G: hyps y) (E D W: class) (u: set):
  $ G ⇒ bounded y (iop u E D W y) (ω × (fseq u × fseq (ω ∪ u))) $;
--| The family is a fixed point, whatever the data.
theorem ifam_fix {y: set} (G: hyps y) (E D W: class) (u: set):
  $ G ⇒ cap y (iop u E D W y) (ifam u E D W) = ifam u E D W $;
theorem ifam_sub (G: hyps) (E D W: class) (u: set): $ G ⇒ ifam u E D W ⊆ ω × (fseq u × fseq (ω ∪ u)) $;
theorem ifam_set (G: hyps) (E D W: class) (u: set): $ G ⇒ isset (ifam u E D W) $;
theorem ifam_intro (G: hyps) (E D W: class) (u x z: set):
  $ G ⇒ x ⊆ ifam u E D W $ > $ G ⇒ x ∊ u $ > $ G ⇒ z ∊ iop0 u E D W x $ > $ G ⇒ z ∊ ifam u E D W $;
theorem ifam_elim {x: set} (G: hyps x) (E D W: class) (u z: set):
  $ G ⇒ z ∊ ifam u E D W $ > $ G ⇒ ∃ x (x ⊆ ifam u E D W ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $;
--| Induction over the family.
--| @freshen G x
--| @freshen G y
--| @freshen p x
theorem ifam_ind {x y: set} (G: hyps) (E D W: class) (p: fml y) (u: set):
  $ G ⇒ ∀ x (x ⊆ ifam u E D W → x ∊ u → x ⊆ {y | p} → iop0 u E D W x ⊆ {y | p}) $ >
  $ G ⇒ ifam u E D W ⊆ {y | p} $;
--| A family that is an element of `u` is closed under one step.
theorem ifam_closed (G: hyps) (E D W: class) (u: set):
  $ G ⇒ ifam u E D W ∈ u $ > $ G ⇒ iop0 u E D W (ifam u E D W) ⊆ ifam u E D W $;
theorem ifam_local (G: hyps) (E E2 D W: class) (u: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ ifam u E D W = ifam u E2 D W $;
theorem ity_local (G: hyps) (E E2 D j W: class) (u: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ ity u E D j W = ity u E2 D j W $;
theorem ictor_local (G: hyps) (E E2 D j c W: class) (u: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ ictor u E D j c W = ictor u E2 D j c W $;
--| The types' numbers are numbers; the types valued by a candidate form a set.
theorem intys_sub (G: hyps) (D: class): $ G ⇒ intys D ⊆ ω $;
theorem ixs_set (G: hyps) (D W Z: class): $ G ⇒ isset (ixs D W Z) $;
--| Class forms of `esat_len`, `etel_fseq`, `etel_len` and `etel_det`, at a class valuation.
theorem esat_len_c (G: hyps) (E T W: class) (u p q: set):
  $ G ⇒ isset W $ > $ G ⇒ T ∈ trees ω $ > $ G ⇒ p ∊ esat u E T W $ > $ G ⇒ q ∊ esat u E T W $ >
  $ G ⇒ cdm p = cdm q $;
theorem etel_fseq_c (G: hyps) (E T W: class) (u r f g t a: set):
  $ G ⇒ isset W $ > $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T W r $ >
  $ G ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $;
theorem etel_len_c (G: hyps) (E T W: class) (u r f g t a f2 g2 t2 a2: set):
  $ G ⇒ isset W $ > $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T W r $ >
  $ G ⇒ ⟨ f2 , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E T W r $ > $ G ⇒ cdm f = cdm f2 $;
theorem etel_det_c (G: hyps) (E T W: class) (u r f g t a g2 t2 a2: set):
  $ G ⇒ isset W $ > $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T W r $ >
  $ G ⇒ ⟨ f , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E T W r $ > $ G ⇒ g = g2 ∧ t = t2 ∧ a = a2 $;
--| A satisfying valuation comes with a set level valuation.
theorem esat_isset (G: hyps) (E T W: class) (u p: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ p ∊ esat u E T W $ > $ G ⇒ isset W $;
--| The level valuation of a telescope's valuation, and the valuations of a
--| tree's paths, are level valuations and valuations over `u`.
theorem esat_lvals (G: hyps) (E P W: class) (u q: set):
  $ G ⇒ P ∈ trees ω $ > $ G ⇒ q ∊ esat u E P W $ > $ G ⇒ W ∈ lvals $;
theorem etel_dom (G: hyps) (E Q: class) (u o x0 x1: set):
  $ G ⇒ o ∊ trees ω $ > $ G ⇒ Q ∈ etel u E o x0 x1 $ > $ G ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $;
--| The constructor's value at a path of its type: the tuple of the fields.
theorem ictor_apn (G: hyps) (E D P T K: class) (u w j c p f g t a: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ ¬ iprop D j w $ > $ G ⇒ iprt D P T $ > $ G ⇒ p ∊ esat u E P w $ >
  $ G ⇒ ictk D j c K $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E K w (p ++ ixs D w (ifam u E D w)) $ >
  $ G ⇒ apn (ictor u E D j c w) (f ++ p) = scons c g $;
theorem ictor_prop (G: hyps) (E D j c W: class) (u: set):
  $ G ⇒ iprop D j W $ > $ G ⇒ ictor u E D j c W = ∅ $;
--| Introduction and elimination for the points of one step of the family.
theorem iop0_intro (G: hyps) (E D W Z: class) (u z p2 q2 e2 j2 c2 k2 f2 g2 t2 a2: set):
  $ G ⇒ iprt D q2 e2 $ > $ G ⇒ p2 ∊ esat u E q2 W $ > $ G ⇒ ictk D j2 c2 k2 $ > $ G ⇒ ⟨ f2 , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E k2 W (p2 ++ ixs D W Z) $ > $ G ⇒ a2 ∊ fseq u $ > $ G ⇒ z = ⟨ j2 , ⟨ a2 , scons c2 g2 ⟩ ⟩ $ > $ G ⇒ z ∊ iop0 u E D W Z $;
--| @freshen G p
--| @freshen G q
--| @freshen G e
--| @freshen G j
--| @freshen G c
--| @freshen G k
--| @freshen G f
--| @freshen G g
--| @freshen G t
--| @freshen G a
--| @freshen H p
--| @freshen H q
--| @freshen H e
--| @freshen H j
--| @freshen H c
--| @freshen H k
--| @freshen H f
--| @freshen H g
--| @freshen H t
--| @freshen H a
--| @freshen c0 p
--| @freshen c0 q
--| @freshen c0 e
--| @freshen c0 j
--| @freshen c0 c
--| @freshen c0 k
--| @freshen c0 f
--| @freshen c0 g
--| @freshen c0 t
--| @freshen c0 a
theorem iop0_elim {p q e j c k f g t a: set} (G H: hyps) (E D W Z: class) (u z: set) (c0: fml):
  $ G ⇒ z ∊ iop0 u E D W Z $ >
  $ H , iprt D q e , p ∊ esat u E q W , ictk D j c k , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (p ++ ixs D W Z) , a ∊ fseq u , z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ c0 $ >
  $ G , H ⇒ c0 $;
--| The family's step, operator and value, the types and the constructors under
--| equal arguments (the universe and the table fixed).
theorem iop0_eq (G: hyps) (E D D2 W W2 Z Z2: class) (u: set):
  $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ Z = Z2 $ > $ G ⇒ iop0 u E D W Z = iop0 u E D2 W2 Z2 $;
theorem iop_eq (G: hyps) (E D D2 W W2 Y Y2: class) (u: set):
  $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ Y = Y2 $ > $ G ⇒ iop u E D W Y = iop u E D2 W2 Y2 $;
theorem ifam_eq (G: hyps) (E D D2 W W2: class) (u: set):
  $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ifam u E D W = ifam u E D2 W2 $;
theorem ity_eq (G: hyps) (E D D2 J J2 W W2: class) (u: set):
  $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ity u E D J W = ity u E D2 J2 W2 $;
theorem ictor_eq (G: hyps) (E D D2 J J2 C C2 W W2: class) (u: set):
  $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ C = C2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ictor u E D J C W = ictor u E D2 J2 C2 W2 $;
--| Class form of `ictor_apn` (the type, the constructor and the parameters' valuation as classes).
theorem ictor_apn_c (G: hyps) (E D P T K J C Q: class) (u w f g t a: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ ¬ iprop D J w $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u E P w $ > $ G ⇒ ictk D J C K $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E K w (Q ++ ixs D w (ifam u E D w)) $ > $ G ⇒ apn (ictor u E D J C w) (f ++ Q) = scons C g $;

-- --------------------------------------------------------------------------
-- The value of `ind_ty`: the gate
-- --------------------------------------------------------------------------

--| The curried `Π` of the telescope `P` and the type `F` (a tree in `P`'s
--| context) at `W`: the traces whose points lie over `P`'s valuations, with
--| the fiber at each in `F`'s value there.
def ipi (U E P F W: class) (.x .y .p .q .z: set): class =
  $ {x | x ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧
      ∀ q (q ∊ esat U E P W → apn x q ∈ da (E' F) W q)} $;
--| The gate of `ind_ty D j` at `W`: type `j`'s entry lies in the curried `Π`
--| of the parameters and its type.
def igate (U E D j W: class) (.p .t .f: set): fml =
  $ ∃ p ∃ t ∃ f (iprt D p t ∧ ityf D j f ∧ ity U E D j W ∈ ipi U E p f W) $;
--| The trivial candidate: the element `scons ∅ ∅` of every type `j` at every
--| argument valuation, a valuation `q` of the parameters with a path `x` of
--| type `j`'s type at `q` (its indices) in front.
def itc (U E D W: class) (.j .p .t .f .q .x .g .s .a .z: set): class =
  $ {z | ∃ j ∃ p ∃ t ∃ f ∃ q ∃ x ∃ g ∃ s ∃ a (iprt D p t ∧ ityf D j f ∧ q ∊ esat U E p W ∧
      ⟨ x , ⟨ g , ⟨ s , a ⟩ ⟩ ⟩ ∈ etel U E f W q ∧ z = ⟨ j , ⟨ x ++ q , scons ∅ ∅ ⟩ ⟩)} $;
--| The trivial family of type `j` at `W`: the trivial candidate's entry, the
--| value `{scons ∅ ∅}` at every argument valuation (`{∅}` for a proposition). Its
--| element is not empty, so a function into it has its whole domain as its
--| trace's domain, and a typing at the trivial family bounds the domains.
def itriv (U E D j W: class): class = $ ient D W (itc U E D W) j $;
--| The value of `ind_ty D j` at `W` (`IndTy`): type `j`'s entry if gated, else
--| the trivial family.
def ityv (U E D j W: class) (.z: set): class =
  $ {z | (igate U E D j W ∧ z ∈ ity U E D j W) ∨ (¬ igate U E D j W ∧ z ∈ itriv U E D j W)} $;

--| @congr
theorem ipi_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ ipi A C E H J ≐ ipi B D F I K $;
--| @rewrite
theorem sb_c_ipi {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (ipi A B C D E)) ≐ ipi (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem igate_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ igate A C E H J ⟺ igate B D F I K $;
--| @rewrite
theorem sb_f_igate {x: set} (t: set x) (A B C D E: class x):
  $ [x/t] (igate A B C D E) ⟺ igate (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem itc_congr (A B C D E F H I: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ itc A C E H ≐ itc B D F I $;
--| @rewrite
theorem sb_c_itc {x: set} (t: set x) (A B C D: class x):
  $ (⟦ x / t ⟧ (itc A B C D)) ≐ itc (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) $;
--| @congr
theorem itriv_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ itriv A C E H J ≐ itriv B D F I K $;
--| @rewrite
theorem sb_c_itriv {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (itriv A B C D E)) ≐ itriv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;
--| @congr
theorem ityv_congr (A B C D E F H I J K: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ ityv A C E H J ≐ ityv B D F I K $;
--| @rewrite
theorem sb_c_ityv {x: set} (t: set x) (A B C D E: class x):
  $ (⟦ x / t ⟧ (ityv A B C D E)) ≐ ityv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $;

--| Membership of `ipi`, and its value at the empty telescope.
--| @freshen G y
--| @freshen G p
--| @freshen G z
--| @freshen G q
theorem ipi_wcel {y p z q: set} (G: hyps) (U E P F W X: class):
  $ G ⇒ isset X $ >
  $ G ⇒ X ∈ ipi U E P F W ↔ (X ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧
      ∀ q (q ∊ esat U E P W → apn X q ∈ da (E' F) W q)) $;
theorem ipi_nil (G: hyps) (E F: class) (u w: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ ipi u E ⟨ kc_nil , ∅ ⟩ F w = da (E' F) w ∅ $;
--| `ipi` reads its table only at the subtrees of the telescope and the type.
theorem ipi_local (G: hyps) (E E2 P F W: class) (u: set):
  $ G ⇒ P ∈ trees ω $ > $ G ⇒ F ∈ trees ω $ > $ G ⇒ eagr E E2 P $ > $ G ⇒ eagr E E2 F $ >
  $ G ⇒ ipi u E P F W = ipi u E2 P F W $;
--| `ipi` under equal telescopes, bodies and level valuations.
theorem ipi_eq (G: hyps) (U E P P2 F F2 W W2: class):
  $ G ⇒ P = P2 $ > $ G ⇒ F = F2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ipi U E P F W = ipi U E P2 F2 W2 $;
--| Introduction of the gate, and the gate at the block's parts.
theorem igate_intro (G: hyps) (U E D J W P T F: class):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ iprt D P T $ > $ G ⇒ ityf D J F $ > $ G ⇒ ity U E D J W ∈ ipi U E P F W $ >
  $ G ⇒ igate U E D J W $;
theorem igate_ipi (G: hyps) (U E D J W P T F: class):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ igate U E D J W $ > $ G ⇒ iprt D P T $ > $ G ⇒ ityf D J F $ >
  $ G ⇒ ity U E D J W ∈ ipi U E P F W $;
theorem igate_local (G: hyps) (E E2 D J W: class) (u: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ igate u E D J W ↔ igate u E2 D J W $;
--| Introduction and elimination for the trivial candidate's points.
theorem itc_intro (G: hyps) (U E D W J P T F Q X: class) (g s a: set):
  $ G ⇒ iprt D P T $ > $ G ⇒ ityf D J F $ > $ G ⇒ Q ∈ esat U E P W $ >
  $ G ⇒ ⟨ X , ⟨ g , ⟨ s , a ⟩ ⟩ ⟩ ∈ etel U E F W Q $ > $ G ⇒ ⟨ J , ⟨ X ++ Q , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $;
--| @freshen G j
--| @freshen G p
--| @freshen G t
--| @freshen G f
--| @freshen G q
--| @freshen G x
--| @freshen G g
--| @freshen G s
--| @freshen G a
--| @freshen H j
--| @freshen H p
--| @freshen H t
--| @freshen H f
--| @freshen H q
--| @freshen H x
--| @freshen H g
--| @freshen H s
--| @freshen H a
--| @freshen c0 j
--| @freshen c0 p
--| @freshen c0 t
--| @freshen c0 f
--| @freshen c0 q
--| @freshen c0 x
--| @freshen c0 g
--| @freshen c0 s
--| @freshen c0 a
theorem itc_elim {j p t f q x g s a: set} (G H: hyps) (U E D W: class) (z: set) (c0: fml):
  $ G ⇒ z ∊ itc U E D W $ >
  $ H , iprt D p t , ityf D j f , q ∊ esat U E p W , ⟨ x , ⟨ g , ⟨ s , a ⟩ ⟩ ⟩ ∈ etel U E f W q ,
      z = ⟨ j , ⟨ x ++ q , scons ∅ ∅ ⟩ ⟩ ⇒ c0 $ >
  $ G , H ⇒ c0 $;
--| The trivial candidate is a set and a candidate, reads its table only at
--| the block's subtrees, and is the same under equal arguments.
theorem itc_set (G: hyps) (E D W: class) (u: set): $ G ⇒ isset (itc u E D W) $;
theorem itc_sub (G: hyps) (E D W: class) (u: set): $ G ⇒ itc u E D W ⊆ ω × (fseq u × fseq (ω ∪ u)) $;
theorem itc_local (G: hyps) (E E2 D W: class) (u: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ itc u E D W = itc u E2 D W $;
theorem itc_eq (G: hyps) (U E D D2 W W2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ itc U E D W = itc U E D2 W2 $;
--| Likewise the trivial family.
theorem itriv_set (G: hyps) (E D J W: class) (u: set): $ G ⇒ isset (itriv u E D J W) $;
theorem itriv_local (G: hyps) (E E2 D J W: class) (u: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ itriv u E D J W = itriv u E2 D J W $;
theorem itriv_eq (G: hyps) (U E D D2 J J2 W W2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ W = W2 $ > $ G ⇒ itriv U E D J W = itriv U E D2 J2 W2 $;
--| The value of `ind_ty`: `ity` under the gate, the trivial family without it.
theorem ityv_gate (G: hyps) (U E D J W: class): $ G ⇒ igate U E D J W $ > $ G ⇒ ityv U E D J W = ity U E D J W $;
theorem ityv_ngate (G: hyps) (U E D J W: class):
  $ G ⇒ ¬ igate U E D J W $ > $ G ⇒ ityv U E D J W = itriv U E D J W $;
--| The family's entry and the value of `ind_ty` are sets.
theorem ity_set (G: hyps) (E D J W: class) (u: set): $ G ⇒ isset (ity u E D J W) $;
theorem ityv_set (G: hyps) (E D J W: class) (u: set): $ G ⇒ isset (ityv u E D J W) $;
theorem ityv_local (G: hyps) (E E2 D J W: class) (u: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ ityv u E D J W = ityv u E2 D J W $;
theorem ityv_eq (G: hyps) (E D D2 J J2 W W2: class) (u: set):
  $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ityv u E D J W = ityv u E D2 J2 W2 $;

-- --------------------------------------------------------------------------
-- The hook's parts for the types and the constructors
-- --------------------------------------------------------------------------

--| At `ind_ty D J`, with the table `e`: `ityv` over the level valuations.
def hty (.u .d .j .e .w .z: set): class =
  $ {z | ∃ u ∃ d ∃ j ∃ e (z = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ ,
      clam w lvals (ityv u e d (nvf' j) w) ⟩)} $;
--| At `ind_ctor D J C`: `ictor` over the level valuations.
def hctor (.u .d .j .c .e .w .z: set): class =
  $ {z | ∃ u ∃ d ∃ j ∃ c ∃ e (z = ⟨ ⟨ u , ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons c ∅)) , e ⟩ ⟩ ⟩ ,
      clam w lvals (ictor u e d (nvf' j) (nvf' c) w) ⟩)} $;

theorem hty_functional (G: hyps): $ G ⇒ functional hty $;
theorem hctor_functional (G: hyps): $ G ⇒ functional hctor $;
--| The denotations of `ind_ty D J` and `ind_ctor D J C`, for a hook `mcv H`
--| with `H` extending `hty` and `hctor`.
theorem dt_ind_ty (G: hyps) (H: class) (u d j w r: set):
  $ G ⇒ hty ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ j ∊ trees ω $ >
  $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons d (scons j ∅) ⟩ w r =
      mclip u (ityv u (dnf u (mcv H)) d (nvf' j) w) $;
--| The value of `ind_ctor` is a set.
theorem ictor_set (G: hyps) (E D J C W: class) (u: set):
  $ G ⇒ D ∈ trees ω $ > $ G ⇒ isset C $ > $ G ⇒ isset (ictor u E D J C W) $;
theorem dt_ind_ctor (G: hyps) (H: class) (u d j c w r: set):
  $ G ⇒ hctor ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ j ∊ trees ω $ >
  $ G ⇒ c ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_ind_ctor , scons d (scons j (scons c ∅)) ⟩ w r =
      mclip u (ictor u (dnf u (mcv H)) d (nvf' j) (nvf' c) w) $;
--| Class forms of `dt_ind_ty` and `dt_ind_ctor` (the trees, the level
--| valuation and the valuation as classes).
theorem dt_ind_ty_c (G: hyps) (H D J W R: class) (u: set):
  $ G ⇒ hty ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ D ∈ trees ω $ > $ G ⇒ J ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons D (scons J ∅) ⟩ W R = mclip u (ityv u (dnf u (mcv H)) D (nvf' J) W) $;
theorem dt_ind_ctor_c (G: hyps) (H D J C W R: class) (u: set):
  $ G ⇒ hctor ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ D ∈ trees ω $ > $ G ⇒ J ∈ trees ω $ > $ G ⇒ C ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u (mcv H) ⟨ kc_ind_ctor , scons D (scons J (scons C ∅)) ⟩ W R = mclip u (ictor u (dnf u (mcv H)) D (nvf' J) (nvf' C) W) $;
