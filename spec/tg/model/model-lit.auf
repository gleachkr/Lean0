l6: $ G , x3 ∊ ω , ∀ x8 (x8 ∊ x3 → ap (ap F (nnf' ∅)) (nnf' x8) = nnf' x8) , e = ∅ ⇒ e ∊ ω → ∀ x4 (x4 ∊ ω → ∃ q (q ∊ ω ∧ ap (ap F (nnf' (ndiv e two))) (nnf' (ndiv x4 two)) = nnf' q ∧ ap (ap F (nnf' e)) (nnf' x4) = nnf' (nadd (nadd q q) (nmod (nadd (nmod e two) (nmod x4 two)) two)))) $ by all_elim [l5]
