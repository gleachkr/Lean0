l472: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ enc_nat n1 ∈ trees ω $ by enc_nat_trees
l473: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ dt u (mcv H) (enc_expr (bvar n1)) w (scons y (scons x t)) = (scons y (scons x t))' nvf' (enc_nat n1) $ by dt_bvar_c [l472, l470, l471]
l474: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ nvf' (enc_nat nz) = ∅ $ by nvf_nz
l475: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l476: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ nvf' (enc_nat n1) = suc (nvf' (enc_nat nz)) $ by nvf_s [l475]
l477: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ suc (nvf' (enc_nat nz)) = suc ∅ $ by suc_eq [l474]
l478: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ nvf' (enc_nat n1) = suc ∅ $ by eq_trans [l476, l477]
l479: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ (scons y (scons x t))' nvf' (enc_nat n1) = (scons y (scons x t))' (suc ∅) $ by fv_eq [l375, l478]
l480: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ t ∈ fseq u $ by weaken [l6]
l481: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ isset t $ by wcel_isset [l480]
l482: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ isset (scons x t) $ by scons_set [l481]
l483: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ isset (scons y (scons x t)) $ by scons_set [l482]
l484: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ isset ∅ $ by ax_empty
l485: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ isset (suc ∅) $ by suc_set [l484]
l486: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ isset y $ by isset_var
l487: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ (scons y (scons x t))' (suc ∅) = (scons x t)' ∅ $ by scons_fv_suc_c [l486, l482, l484]
l488: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ (scons y (scons x t))' nvf' (enc_nat n1) = (scons x t)' ∅ $ by eq_trans [l479, l487]
l489: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ isset x $ by isset_var
l490: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ (scons x t)' ∅ = x $ by scons_fv_zero_c [l489, l481]
l491: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ (scons y (scons x t))' nvf' (enc_nat n1) = x $ by eq_trans [l488, l490]
l492: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ dt u (mcv H) (enc_expr (bvar n1)) w (scons y (scons x t)) = x $ by eq_trans [l473, l491]
l493: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ x ∊ nnat $ by weaken [l353]
l494: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ x ∈ nnat $ by welc_wcel [l493]
