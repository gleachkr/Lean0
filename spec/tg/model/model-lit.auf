lemma fs1_t1 (H: class) (G: ctx): $ _ ⇒ hind H $ > $ mdeq (mcv H) G (ind_ctor le_D nz n1) (ind_ctor le_D nz n1) (pi nat_ty (pi nat_ty (pi (app (app (ind_ty le_D nz) (bvar n1)) (bvar nz)) (app (app (ind_ty le_D nz) (bvar n2)) (app nat_succ (bvar n1)))))) $
