 ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr fd) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr fd) (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr fm) (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr fadd) (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr fm) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr fm) (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∈ J)) $ by fs1_iv_xor_eqs [#1]
l2: $ _ ⇒ ra_deq (enc_ctx G) (enc_expr f) (enc_expr f) ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J $ by and_elim_l [and_elim_r [and_elim_r [l1]]]

lemma fs1_jx {x h: set} (G: hyps) (M C A W R: class) (u: set): $ G ⇒ ∃ h (ra_deq C h h A ∈ jmod M) $ > $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ sat u M C W $ > $ G ⇒ ∃ x (x ∊ dt u M A W R) $
----
l1: $ G , ra_deq C h h A ∈ jmod M ⇒ uadm u $ by weaken [#2]
l2: $ G , ra_deq C h h A ∈ jmod M ⇒ jval u M (jmod M) $ by jmod_jval [l1]
l3: $ G , ra_deq C h h A ∈ jmod M ⇒ ra_deq C h h A ∈ jmod M $ by ax
l4: $ G , ra_deq C h h A ∈ jmod M ⇒ W ∈ lvals $ by weaken [#3]
l5: $ G , ra_deq C h h A ∈ jmod M ⇒ R ∈ sat u M C W $ by weaken [#4]
l6: $ G , ra_deq C h h A ∈ jmod M ⇒ dt u M h W R = dt u M h W R ∧ dt u M h W R ∈ dt u M A W R $ by jval_elim [l2, l3, l4, l5]
l7: $ G , ra_deq C h h A ∈ jmod M ⇒ dt u M h W R ∈ dt u M A W R $ by and_elim_r [l6]
l8: $ G , ra_deq C h h A ∈ jmod M , y = dt u M h W R ⇒ y = dt u M h W R $ by ax
l9: $ G , ra_deq C h h A ∈ jmod M , y = dt u M h W R ⇒ dt u M h W R ∈ dt u M A W R $ by weaken [l7]
l10: $ G , ra_deq C h h A ∈ jmod M , y = dt u M h W R ⇒ y ∊ dt u M A W R $ by wcel_welc [wcel_eq_l [eq_sym [l8], l9]]
l11: $ G , ra_deq C h h A ∈ jmod M , y = dt u M h W R ⇒ ∃ x (x ∊ dt u M A W R) $ by ex_intro [l10]
l12: $ G , ra_deq C h h A ∈ jmod M ⇒ dt u M h W R ∈ dt u M A W R $ by weaken [l7]
l13: $ G , ra_deq C h h A ∈ jmod M ⇒ isset (dt u M h W R) $ by wcel_isset [l12]
l14: $ G , ra_deq C h h A ∈ jmod M ⇒ ∃ x (x ∊ dt u M A W R) $ by isset_elim [l13, l11]
l15: $ G ⇒ ∃ x (x ∊ dt u M A W R) $ by ex_elim [#1, l14]

lemma fs1_nu {k: set} (G: hyps) (X: class): $ G ⇒ X ∈ nnat $ > $ G ⇒ ∃ k (k ∊ ω ∧ X = nnf' k) $
----
l1: $ G , y = X ⇒ y = X $ by ax
l2: $ G , y = X ⇒ X ∈ nnat $ by weaken [#1]
l3: $ G , y = X ⇒ y ∊ nnat $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , y = X , ⟨ j , y ⟩ ∈ nnf ⇒ ⟨ j , y ⟩ ∈ nnf $ by ax
l5: $ G , y = X , ⟨ j , y ⟩ ∈ nnf ⇒ cdm nnf = ω $ by nnf_cdm
l6: $ G , y = X , ⟨ j , y ⟩ ∈ nnf ⇒ j ∊ ω $ by welc_eq [l5, cdm_intro [l4]]
l7: $ G , y = X , ⟨ j , y ⟩ ∈ nnf ⇒ functional nnf $ by nnf_functional
l8: $ G , y = X , ⟨ j , y ⟩ ∈ nnf ⇒ nnf' j = y $ by fv_val [l7, l4]
l9: $ G , y = X , ⟨ j , y ⟩ ∈ nnf ⇒ y = X $ by ax
l10: $ G , y = X , ⟨ j , y ⟩ ∈ nnf ⇒ j ∊ ω ∧ X = nnf' j $ by and_intro [l6, eq_trans [eq_sym [l9], eq_sym [l8]]]
l11: $ G , y = X , ⟨ j , y ⟩ ∈ nnf ⇒ ∃ k (k ∊ ω ∧ X = nnf' k) $ by ex_intro [l10]
l12: $ G , y = X ⇒ ∃ k (k ∊ ω ∧ X = nnf' k) $ by crn_elim [l3, l11]
l13: $ G ⇒ isset X $ by wcel_isset [#1]
l14: $ G ⇒ ∃ k (k ∊ ω ∧ X = nnf' k) $ by isset_elim [l13, l12]

lemma fs1_lu (G: hyps) (H R: class) (u w a b: set): $ G ⇒ mles (mcv H) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w R) (nnf' a)) (nnf' b) = nlev (nnf' a) (nnf' b) $
----
l1: $ G , mles (mcv H) ⇒ ∀ x1 ∀ x2 (uadm x1 → x2 ∊ lvals → ∀ x3 ∀ x4 (x3 ∊ ω → x4 ∊ ω → ap (ap (dt x1 (mcv H) (enc_expr (ind_ty le_D nz)) x2 ∅) (nnf' x3)) (nnf' x4) = nlev (nnf' x3) (nnf' x4))) $ by ax
l2: $ G ⇒ ∀ x1 ∀ x2 (uadm x1 → x2 ∊ lvals → ∀ x3 ∀ x4 (x3 ∊ ω → x4 ∊ ω → ap (ap (dt x1 (mcv H) (enc_expr (ind_ty le_D nz)) x2 ∅) (nnf' x3)) (nnf' x4) = nlev (nnf' x3) (nnf' x4))) $ by imp_elim [imp_intro [l1], #1]
l3: $ G ⇒ ∀ x2 (uadm u → x2 ∊ lvals → ∀ x3 ∀ x4 (x3 ∊ ω → x4 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) x2 ∅) (nnf' x3)) (nnf' x4) = nlev (nnf' x3) (nnf' x4))) $ by all_elim [l2]
l4: $ G ⇒ uadm u → w ∊ lvals → ∀ x3 ∀ x4 (x3 ∊ ω → x4 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w ∅) (nnf' x3)) (nnf' x4) = nlev (nnf' x3) (nnf' x4)) $ by all_elim [l3]
l5: $ G ⇒ w ∊ lvals → ∀ x3 ∀ x4 (x3 ∊ ω → x4 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w ∅) (nnf' x3)) (nnf' x4) = nlev (nnf' x3) (nnf' x4)) $ by imp_elim [l4, #2]
l6: $ G ⇒ ∀ x3 ∀ x4 (x3 ∊ ω → x4 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w ∅) (nnf' x3)) (nnf' x4) = nlev (nnf' x3) (nnf' x4)) $ by imp_elim [l5, #3]
l7: $ G ⇒ ∀ x4 (a ∊ ω → x4 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w ∅) (nnf' a)) (nnf' x4) = nlev (nnf' a) (nnf' x4)) $ by all_elim [l6]
l8: $ G ⇒ a ∊ ω → b ∊ ω → ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w ∅) (nnf' a)) (nnf' b) = nlev (nnf' a) (nnf' b) $ by all_elim [l7]
l9: $ G ⇒ b ∊ ω → ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w ∅) (nnf' a)) (nnf' b) = nlev (nnf' a) (nnf' b) $ by imp_elim [l8, #5]
l10: $ G ⇒ ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w ∅) (nnf' a)) (nnf' b) = nlev (nnf' a) (nnf' b) $ by imp_elim [l9, #6]
s1: $ closed nz (ind_ty le_D nz) $ by fs1_kt
l11: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l12: $ G ⇒ dt u (mcv H) (enc_expr (ind_ty le_D nz)) w R = dt u (mcv H) (enc_expr (ind_ty le_D nz)) w ∅ $ by closed0_den [s1, welc_wcel [#3], #4, l11]
l13: $ G ⇒ nnf' a = nnf' a $ by eq_refl
l14: $ G ⇒ nnf' b = nnf' b $ by eq_refl
l15: $ G ⇒ ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w R) (nnf' a)) (nnf' b) = nlev (nnf' a) (nnf' b) $ by eq_trans [ap_eq [ap_eq [l12, l13], l14], l10]

lemma fs1_sl (G: hyps) (a b: set): $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ b $ > $ G ⇒ suc a ⊆ b $
----
l1: $ G , x = suc a ⇒ x = suc a $ by ax
l2: $ G , x = suc a ⇒ b ∊ ω $ by weaken [#1]
l3: $ G , x = suc a ⇒ a ∊ b $ by weaken [#2]
l4: $ G , x = suc a ⇒ x ∊ suc b $ by wcel_welc [wcel_eq_l [eq_sym [l1], omega_suc_mono [l2, l3]]]
l5: $ G , x = suc a ⇒ b ∊ ω $ by weaken [#1]
l6: $ G , x = suc a ⇒ suc a ⊆ b $ by subset_eq_l [l1, nlt_suc_le [l5, l4]]
l7: $ G ⇒ isset a $ by isset_var
l8: $ G ⇒ isset (suc a) $ by suc_set [l7]
l9: $ G ⇒ suc a ⊆ b $ by isset_elim [l8, l6]

lemma fs1_dq (G: hyps) (a b q r: set): $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ q ∊ ω $ > $ G ⇒ r ∊ ω $ > $ G ⇒ nadd (nmul b q) r = a $ > $ G ⇒ ∅ ∈ b → r ∊ b $ > $ G ⇒ b = ∅ → q = ∅ $ > $ G ⇒ ndiv a b = q ∧ nmod a b = r $
----
l1: $ G ⇒ ∅ ∈ b ∨ ∅ = b $ by omega_zero_le [#2]
l2: $ G , ∅ ∈ b ⇒ ∅ ∈ b → r ∊ b $ by weaken [#6]
l3: $ G , ∅ ∈ b ⇒ ∅ ∈ b $ by ax
l4: $ G , ∅ ∈ b ⇒ r ∊ b $ by imp_elim [l2, l3]
l5: $ G , ∅ ∈ b ⇒ q ∊ ω $ by weaken [#3]
l6: $ G , ∅ ∈ b ⇒ b ∊ ω $ by weaken [#2]
l7: $ G , ∅ ∈ b ⇒ r = r $ by eq_refl
l8: $ G , ∅ ∈ b ⇒ nadd (nmul b q) r = a $ by weaken [#5]
l9: $ G , ∅ ∈ b ⇒ nadd (nmul q b) r = a $ by eq_trans [nadd_eq [nmul_comm [l5, l6], l7], l8]
l10: $ G , ∅ ∈ b ⇒ b ∊ ω $ by weaken [#2]
l11: $ G , ∅ ∈ b ⇒ q ∊ ω $ by weaken [#3]
l12: $ G , ∅ ∈ b ⇒ b ∊ ω $ by weaken [#2]
l13: $ G , ∅ ∈ b ⇒ q ∊ ω $ by weaken [#3]
l14: $ G , ∅ ∈ b ⇒ ndiv a b = q ∧ nmod a b = r $ by and_intro [ndiv_char [l10, l11, l4, l9], nmod_char [l12, l13, l4, l9]]
l15: $ G , ∅ = b ⇒ ∅ = b $ by ax
l16: $ G , ∅ = b ⇒ b = ∅ $ by eq_sym [l15]
l17: $ G , ∅ = b ⇒ b = ∅ → q = ∅ $ by weaken [#7]
l18: $ G , ∅ = b ⇒ q = ∅ $ by imp_elim [l17, l16]
l19: $ G , ∅ = b ⇒ a = a $ by eq_refl
l20: $ G , ∅ = b ⇒ ndiv a ∅ = ∅ $ by ndiv_zero_r
l21: $ G , ∅ = b ⇒ ndiv a b = q $ by eq_trans [ndiv_eq [l19, l16], eq_trans [l20, eq_sym [l18]]]
l22: $ G , ∅ = b ⇒ b = b $ by eq_refl
l23: $ G , ∅ = b ⇒ nmul b ∅ = ∅ $ by nmul_zero
l24: $ G , ∅ = b ⇒ nmul b q = ∅ $ by eq_trans [nmul_eq [l22, l18], l23]
l25: $ G , ∅ = b ⇒ ∅ ∈ ω $ by omega_zero
l26: $ G , ∅ = b ⇒ r ∊ ω $ by weaken [#4]
l27: $ G , ∅ = b ⇒ nadd r ∅ = r $ by nadd_zero
l28: $ G , ∅ = b ⇒ nadd ∅ r = r $ by eq_trans [nadd_comm_c [l25, welc_wcel [l26]], l27]
l29: $ G , ∅ = b ⇒ nadd (nmul b q) r = a $ by weaken [#5]
l30: $ G , ∅ = b ⇒ r = r $ by eq_refl
l31: $ G , ∅ = b ⇒ a = r $ by eq_trans [eq_sym [l29], eq_trans [nadd_eq [l24, l30], l28]]
l32: $ G , ∅ = b ⇒ nmod a ∅ = a $ by nmod_zero_r
l33: $ G , ∅ = b ⇒ nmod a b = r $ by eq_trans [nmod_eq [l19, l16], eq_trans [l32, l31]]
l34: $ G , ∅ = b ⇒ ndiv a b = q ∧ nmod a b = r $ by and_intro [l21, l33]
l35: $ G ⇒ ndiv a b = q ∧ nmod a b = r $ by or_elim [l1, l14, l34]

lemma fs1_ke: $ closed nz (ind_ty (eq_D (ls lz)) nz) $
----
h1: $ closed nz (ind_ty (ind_mk eq_blk (cons (bvar nz) (cons (srt (ls lz)) nil)) (tcons (pi (bvar (s nz)) (srt lz)) (ccons (app (app (app (bvar (s (s nz))) (bvar (s nz))) (bvar nz)) (bvar nz)) cnil) tnil) nil) nz) $ by closed_ind_ty

lemma fs1_eq (G: hyps) (H R X Y: class) (u w: set): $ G ⇒ meqs (mcv H) (ls lz) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ X ∈ nnat $ > $ G ⇒ Y ∈ nnat $ > $ G ⇒ ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D (ls lz)) nz)) w R) nnat) X) Y = teq X Y $
----
l1: $ G , b = nnat , k = suc ∅ ⇒ b = nnat $ by ax
l2: $ G , b = nnat , k = suc ∅ ⇒ k = suc ∅ $ by ax
l3: $ G , b = nnat , k = suc ∅ ⇒ w ∊ lvals $ by weaken [#3]
l4: $ G , b = nnat , k = suc ∅ ⇒ enc_lvl lz ∈ trees ω $ by enc_lvl_trees
l5: $ … ⇒ lv (enc_lvl (ls lz)) w = suc (lv (enc_lvl lz) w) $ by lv_ls [l4, l3]
l6: $ G , b = nnat , k = suc ∅ ⇒ lv (enc_lvl lz) w = ∅ $ by lv_lz
l7: $ … ⇒ lv (enc_lvl (ls lz)) w = k $ by eq_trans [l5, eq_trans [suc_eq [l6], eq_sym [l2]]]
l8: $ G , b = nnat , k = suc ∅ ⇒ uni = uni $ by eq_refl
l9: $ G , b = nnat , k = suc ∅ ⇒ nnat ∈ U₁ $ by nnat_uni
l10: $ … ⇒ b ∊ uni' k $ by wcel_welc [wcel_eq_l [eq_sym [l1], wcel_eq_r [fv_eq [l8, eq_sym [l2]], l9]]]
l11: $ G , b = nnat , k = suc ∅ ⇒ X ∈ nnat $ by weaken [#5]
l12: $ … ⇒ X ∈ b $ by wcel_eq_r [eq_sym [l1], l11]
l13: $ G , b = nnat , k = suc ∅ ⇒ Y ∈ nnat $ by weaken [#6]
l14: $ … ⇒ Y ∈ b $ by wcel_eq_r [eq_sym [l1], l13]
l15: $ G , b = nnat , k = suc ∅ ⇒ meqs (mcv H) (ls lz) $ by weaken [#1]
l16: $ G , b = nnat , k = suc ∅ ⇒ uadm u $ by weaken [#2]
l17: $ G , b = nnat , k = suc ∅ ⇒ R ∈ fseq u $ by weaken [#4]
l18: $ … ⇒ ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D (ls lz)) nz)) w R) b) X) Y = teq X Y $ by f182_eq [l15, l16, l3, l17, l7, l10, l12, l14]
l19: $ G , b = nnat , k = suc ∅ ⇒ dt u (mcv H) (enc_expr (ind_ty (eq_D (ls lz)) nz)) w R = dt u (mcv H) (enc_expr (ind_ty (eq_D (ls lz)) nz)) w R $ by eq_refl
l20: $ G , b = nnat , k = suc ∅ ⇒ X = X $ by eq_refl
