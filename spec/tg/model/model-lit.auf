l433: $ G ⇒ x3 ∊ ω → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x3 → ap (ap F (nnf' x3)) (nnf' nvf' b) = nnf' nvf' c) $ by all_elim [l432]
