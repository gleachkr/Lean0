z1: $ mdeq (mcv H) G (lit b0) (ind_ctor nat_D nz nz) (ind_ty nat_D nz) $ by mdeq_i [l20, l22]

def f192_bs_q  (.y .t: set): class = $ {y | ∀ t (ra_bsucc y t ∈ lrel → nvf' t = suc (nvf' y))} $

lemma f192_bs_e (G: hyps)  (ty vt: set): $ G ⇒ ty ∊ f192_bs_q  $ > $ G ⇒ ra_bsucc ty vt ∈ lrel $ > $ G ⇒ nvf' vt = suc (nvf' ty) $
----
l1: $ G ⇒ ∀ t (ra_bsucc ty t ∈ lrel → nvf' t = suc (nvf' ty)) $ by cab_elim [#1]
l2: $ G ⇒ ra_bsucc ty vt ∈ lrel → nvf' vt = suc (nvf' ty) $ by all_elim [l1]
l3: $ G ⇒ nvf' vt = suc (nvf' ty) $ by imp_elim [l2, #2]

lemma f192_bs_n (G: hyps)  (ty k1 j1 vt: set): $ G ⇒ crn j1 ⊆ f192_bs_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_bsucc ty vt ∈ lrel $ > $ G ⇒ nvf' vt = suc (nvf' ty) $
----
l1: $ G ⇒ ra_bsucc ty vt ∈ lrel $ by weaken [#5]
l2: $ G ⇒ (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ x1 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩) ∨ ∃ x1 ∃ x2 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel) $ by lrel_bsucc_cases [l1]
l3: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by ax
l4: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ty = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l3]
l5: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by and_elim_r [l3]
l6: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ isset ω $ by omega_set
l7: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ kc_b0 ∈ ω $ by kc_b0_omega
l8: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l9: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ⟨ kc_b0 , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l6, l7, l8]
l10: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l11: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l12: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' ty = ∅ $ by eq_trans [fv_eq [l11, l4], l10]
l13: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ = suc (ndbl (nvf' ⟨ kc_b0 , ∅ ⟩)) $ by nvf_bd1 [l9]
l14: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ndbl ∅ = ∅ $ by ndbl_zero
l15: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ndbl (nvf' ⟨ kc_b0 , ∅ ⟩) = ∅ $ by eq_trans [ndbl_eq [l10], l14]
l16: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' vt = suc ∅ $ by eq_trans [fv_eq [l11, l5], eq_trans [l13, suc_eq [l15]]]
l17: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' vt = suc (nvf' ty) $ by eq_trans [l16, suc_eq [eq_sym [l12]]]
l18: $ G ⇒ (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) → nvf' vt = suc (nvf' ty) $ by imp_intro [l17]
l19: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ $ by ax
l20: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ $ by and_elim_l [l19]
l21: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ $ by and_elim_r [l19]
l22: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ ra_bsucc ty vt ∈ lrel $ by weaken [l1]
l23: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ ⟨ kr_bsucc , scons ty (scons vt ∅) ⟩ ∈ latoms $ by lrel_latoms [l22]
l24: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l25: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ isset (scons vt ∅) $ by scons_set [l24]
l26: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ isset (scons ty (scons vt ∅)) $ by scons_set [l25]
l27: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ kr_bsucc ∈ ω $ by kr_bsucc_omega
l28: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ kr_bsucc ∈ ω ∧ scons ty (scons vt ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l23, wcel_isset [l27], l26]
l29: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ crn (scons ty (scons vt ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l28]]
l30: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ isset ω $ by omega_set
l31: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ ty ∈ trees ω $ by crn_scons_head_trees [l30, l29]
l32: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ ⟨ kc_bd0 , scons x1 ∅ ⟩ ∈ trees ω $ by wcel_eq_l [l20, l31]
l33: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ kc_bd0 ∈ ω $ by kc_bd0_omega
l34: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ isset ω $ by omega_set
l35: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ x1 ∈ trees ω $ by welc_wcel [trees_kids1 [l34, l32, wcel_isset [l33]]]
l36: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l37: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ nvf' ty = ndbl (nvf' x1) $ by eq_trans [fv_eq [l36, l20], nvf_bd0 [l35]]
l38: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ nvf' vt = suc (ndbl (nvf' x1)) $ by eq_trans [fv_eq [l36, l21], nvf_bd1 [l35]]
l39: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩ ⇒ nvf' vt = suc (nvf' ty) $ by eq_trans [l38, suc_eq [eq_sym [l37]]]
l40: $ G , ∃ x1 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩) ⇒ ∃ x1 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩) $ by ax
l41: $ … ⇒ nvf' vt = suc (nvf' ty) $ by ex_elim [l40, l39]
l42: $ G ⇒ (∃ x1 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩)) → nvf' vt = suc (nvf' ty) $ by imp_intro [l41]
l43: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel $ by ax
l44: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ $ by and_elim_l [l43]
l45: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ $ by and_elim_l [and_elim_r [l43]]
l46: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ ra_bsucc x1 x2 ∈ lrel $ by and_elim_r [and_elim_r [l43]]
l47: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ ⟨ kr_bsucc , scons x1 (scons x2 ∅) ⟩ ∈ latoms $ by lrel_latoms [l46]
l48: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset ∅ $ by ax_empty
l49: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset (scons x2 ∅) $ by scons_set [l48]
l50: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset (scons x1 (scons x2 ∅)) $ by scons_set [l49]
l51: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ kr_bsucc ∈ ω $ by kr_bsucc_omega
l52: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ kr_bsucc ∈ ω ∧ scons x1 (scons x2 ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l47, wcel_isset [l51], l50]
l53: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ crn (scons x1 (scons x2 ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l52]]
l54: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset ω $ by omega_set
l55: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ x1 ∈ trees ω $ by crn_scons_head_trees [l54, l53]
l56: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ ⟨ kr_bsucc , scons x1 (scons x2 ∅) ⟩ ∈ latoms $ by lrel_latoms [l46]
l57: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset ∅ $ by ax_empty
l58: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset (scons x2 ∅) $ by scons_set [l57]
l59: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset (scons x1 (scons x2 ∅)) $ by scons_set [l58]
l60: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ kr_bsucc ∈ ω $ by kr_bsucc_omega
l61: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ kr_bsucc ∈ ω ∧ scons x1 (scons x2 ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l56, wcel_isset [l60], l59]
l62: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ crn (scons x1 (scons x2 ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l61]]
l63: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ crn (scons x2 ∅) ⊆ trees ω $ by crn_scons_tail [l62]
l64: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset ω $ by omega_set
l65: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ x2 ∈ trees ω $ by crn_scons_head_trees [l64, l63]
l66: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset ∅ $ by ax_empty
l67: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset (scons x1 ∅) $ by scons_set [l66]
l68: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ crn j1 ⊆ f192_bs_q  $ by weaken [#1]
l69: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l70: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ kc_bd1 ∈ ω $ by kc_bd1_omega
l71: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ crn (scons x1 ∅) ⊆ f192_bs_q  $ by node_crn_sub [l68, l69, l44, wcel_isset [l70], l67]
l72: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset x1 $ by isset_var
l73: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ x1 ∈ f192_bs_q  $ by crn_scons_head [l72, l71]
l74: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ nvf' x2 = suc (nvf' x1) $ by f192_bs_e [wcel_welc [l73], l46]
l75: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l76: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ nvf' ty = suc (ndbl (nvf' x1)) $ by eq_trans [fv_eq [l75, l44], nvf_bd1 [l55]]
l77: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ nvf' vt = ndbl (nvf' x2) $ by eq_trans [fv_eq [l75, l45], nvf_bd0 [l65]]
l78: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ isset x1 $ by isset_var
l79: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ ndbl (nvf' x2) = suc (suc (ndbl (nvf' x1))) $ by eq_trans [ndbl_eq [l74], ndbl_suc_c [nvf_omega [l78]]]
l80: $ G , ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel ⇒ nvf' vt = suc (nvf' ty) $ by eq_trans [l77, eq_trans [l79, suc_eq [eq_sym [l76]]]]
l81: $ G , ∃ x2 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel) ⇒ ∃ x2 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel) $ by ax
l82: $ … ⇒ nvf' vt = suc (nvf' ty) $ by ex_elim [l81, l80]
l83: $ G , ∃ x1 ∃ x2 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel) ⇒ ∃ x1 ∃ x2 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel) $ by ax
l84: $ … ⇒ nvf' vt = suc (nvf' ty) $ by ex_elim [l83, l82]
l85: $ G ⇒ (∃ x1 ∃ x2 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel)) → nvf' vt = suc (nvf' ty) $ by imp_intro [l84]
l86: $ G ⇒ (∃ x1 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩) ∨ ∃ x1 ∃ x2 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel)) → nvf' vt = suc (nvf' ty) $ by or_elim_imp [l42, l85]
l87: $ G ⇒ ((ty = ⟨ kc_b0 , ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ x1 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd1 , scons x1 ∅ ⟩) ∨ ∃ x1 ∃ x2 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vt = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ ra_bsucc x1 x2 ∈ lrel)) → nvf' vt = suc (nvf' ty) $ by or_elim_imp [l18, l86]
l88: $ G ⇒ nvf' vt = suc (nvf' ty) $ by imp_elim [l87, l2]

lemma f192_bs_all (G: hyps) : $ G ⇒ trees ω ⊆ f192_bs_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f192_bs_q  , y = ⟨ x8 , x9 ⟩ , ra_bsucc y t ∈ lrel ⇒ crn x9 ⊆ f192_bs_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f192_bs_q  , y = ⟨ x8 , x9 ⟩ , ra_bsucc y t ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f192_bs_q  , y = ⟨ x8 , x9 ⟩ , ra_bsucc y t ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f192_bs_q  , y = ⟨ x8 , x9 ⟩ , ra_bsucc y t ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f192_bs_q  , y = ⟨ x8 , x9 ⟩ , ra_bsucc y t ∈ lrel ⇒ ra_bsucc y t ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f192_bs_q  , y = ⟨ x8 , x9 ⟩ , ra_bsucc y t ∈ lrel ⇒ nvf' t = suc (nvf' y) $ by f192_bs_n [l1, l2, l3, l4, l5]
