l82: $ G , k ∊ ω , ∀ c (c ∊ ω → nnf' k = nnf' c → k = c) , z = suc k , c ∊ ω , nnf' z = nnf' c , ∃ d (d ∊ ω ∧ c = suc d) ⇒ ∃ d (d ∊ ω ∧ c = suc d) $ by ax
l83: $ … ⇒ z = c $ by ex_elim [l82, l81]
l84: $ G , k ∊ ω , ∀ c (c ∊ ω → nnf' k = nnf' c → k = c) , z = suc k , c ∊ ω , nnf' z = nnf' c ⇒ z = c $ by or_elim [l35, l50, l83]
l85: $ G , k ∊ ω , ∀ c (c ∊ ω → nnf' k = nnf' c → k = c) , z = suc k , c ∊ ω ⇒ nnf' z = nnf' c → z = c $ by imp_intro [l84]
l86: $ G , k ∊ ω , ∀ c (c ∊ ω → nnf' k = nnf' c → k = c) , z = suc k ⇒ c ∊ ω → nnf' z = nnf' c → z = c $ by imp_intro [l85]
l87: $ G , k ∊ ω , ∀ c (c ∊ ω → nnf' k = nnf' c → k = c) , z = suc k ⇒ ∀ c (c ∊ ω → nnf' z = nnf' c → z = c) $ by all_intro [l86]
l88: $ G ⇒ ∀ c (c ∊ ω → nnf' a = nnf' c → a = c) $ by omega_ind_named [l32, l87, #1]
l89: $ G ⇒ b ∊ ω → nnf' a = nnf' b → a = b $ by all_elim [l88]
l90: $ G ⇒ nnf' a = nnf' b → a = b $ by imp_elim [l89, #2]
l91: $ G ⇒ a = b $ by imp_elim [l90, #3]

nlev_congr
----------
g1: $ (e = ∅) ⟺ (e = ∅) $ by iff_refl
g2: $ (c ∊ ω) ⟺ (c ∊ ω) $ by iff_refl
g3: $ (d ∊ ω) ⟺ (d ∊ ω) $ by iff_refl
g4: $ (nnf' c) ≐ (nnf' c) $ by ceqt_refl
g5: $ (A = (nnf' c)) ⟺ (B = (nnf' c)) $ by ceq_congr [#1, g4]
g6: $ (nnf' d) ≐ (nnf' d) $ by ceqt_refl
g7: $ (C = (nnf' d)) ⟺ (D = (nnf' d)) $ by ceq_congr [#2, g6]
g8: $ (c ⊆ d) ⟺ (c ⊆ d) $ by iff_refl
g9: $ ((C = (nnf' d)) ∧ (c ⊆ d)) ⟺ ((D = (nnf' d)) ∧ (c ⊆ d)) $ by and_congr [g7, g8]
g10: $ ((A = (nnf' c)) ∧ ((C = (nnf' d)) ∧ (c ⊆ d))) ⟺ ((B = (nnf' c)) ∧ ((D = (nnf' d)) ∧ (c ⊆ d))) $ by and_congr [g5, g9]
g11: $ ((d ∊ ω) ∧ ((A = (nnf' c)) ∧ ((C = (nnf' d)) ∧ (c ⊆ d)))) ⟺ ((d ∊ ω) ∧ ((B = (nnf' c)) ∧ ((D = (nnf' d)) ∧ (c ⊆ d)))) $ by and_congr [g3, g10]
g12: $ ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((A = (nnf' c)) ∧ ((C = (nnf' d)) ∧ (c ⊆ d))))) ⟺ ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((B = (nnf' c)) ∧ ((D = (nnf' d)) ∧ (c ⊆ d))))) $ by and_congr [g2, g11]
g13: $ (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((A = (nnf' c)) ∧ ((C = (nnf' d)) ∧ (c ⊆ d)))))) ⟺ (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((B = (nnf' c)) ∧ ((D = (nnf' d)) ∧ (c ⊆ d)))))) $ by ex_congr [g12]
g14: $ (∃ c (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((A = (nnf' c)) ∧ ((C = (nnf' d)) ∧ (c ⊆ d))))))) ⟺ (∃ c (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((B = (nnf' c)) ∧ ((D = (nnf' d)) ∧ (c ⊆ d))))))) $ by ex_congr [g13]
g15: $ ((e = ∅) ∧ (∃ c (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((A = (nnf' c)) ∧ ((C = (nnf' d)) ∧ (c ⊆ d)))))))) ⟺ ((e = ∅) ∧ (∃ c (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((B = (nnf' c)) ∧ ((D = (nnf' d)) ∧ (c ⊆ d)))))))) $ by and_congr [g1, g14]
g16: $ nlev A C ≐ nlev B D $ by cab_congr [g15]

sb_c_nlev
---------
l1: $ (⟦ x / t ⟧ {e | (e = ∅) ∧ (∃ c (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ ((A = (nnf' c)) ∧ ((B = (nnf' d)) ∧ (c ⊆ d)))))))}) ≐ {e | (e = ∅) ∧ (∃ c (∃ d ((c ∊ ω) ∧ ((d ∊ ω) ∧ (((⟦ x / t ⟧ A) = (nnf' c)) ∧ (((⟦ x / t ⟧ B) = (nnf' d)) ∧ (c ⊆ d)))))))} $ by ceqt_refl

lemma fs1_ne (G: hyps) (A B C D: class) (x: set): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ x ∊ nlev A C $ > $ G ⇒ x ∊ nlev B D $
----
l1: $ G ⇒ x = ∅ ∧ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d) $ by cab_elim [#3]
l2: $ G ⇒ x = ∅ $ by and_elim_l [l1]
l3: $ G ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d) $ by and_elim_r [l1]
l4: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d $ by ax
l5: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ c ∊ ω $ by and_elim_l [l4]
l6: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ d ∊ ω $ by and_elim_l [and_elim_r [l4]]
l7: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ A = nnf' c $ by and_elim_l [and_elim_r [and_elim_r [l4]]]
l8: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ C = nnf' d $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l4]]]]
l9: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ c ⊆ d $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [l4]]]]
l10: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ A = B $ by weaken [#1]
l11: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ B = nnf' c $ by eq_trans [eq_sym [l10], l7]
l12: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ C = D $ by weaken [#2]
l13: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ D = nnf' d $ by eq_trans [eq_sym [l12], l8]
l14: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ D = nnf' d ∧ c ⊆ d $ by and_intro [l13, l9]
l15: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ B = nnf' c ∧ D = nnf' d ∧ c ⊆ d $ by and_intro [l11, l14]
l16: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ d ∊ ω ∧ B = nnf' c ∧ D = nnf' d ∧ c ⊆ d $ by and_intro [l6, l15]
l17: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ c ∊ ω ∧ d ∊ ω ∧ B = nnf' c ∧ D = nnf' d ∧ c ⊆ d $ by and_intro [l5, l16]
l18: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ ∃ d (c ∊ ω ∧ d ∊ ω ∧ B = nnf' c ∧ D = nnf' d ∧ c ⊆ d) $ by ex_intro [l17]
l19: $ G , c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ B = nnf' c ∧ D = nnf' d ∧ c ⊆ d) $ by ex_intro [l18]
l20: $ G , ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d) ⇒ ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ C = nnf' d ∧ c ⊆ d) $ by ax
l21: $ … ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ B = nnf' c ∧ D = nnf' d ∧ c ⊆ d) $ by ex_elim [l20, l19]
l22: $ G ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ B = nnf' c ∧ D = nnf' d ∧ c ⊆ d) $ by ex_elim [l3, l21]
l23: $ G ⇒ x ∊ nlev B D $ by cab_intro [and_intro [l2, l22]]

nlev_eq
-------
l1: $ G , x ∊ nlev A C ⇒ A = B $ by weaken [#1]
l2: $ G , x ∊ nlev A C ⇒ C = D $ by weaken [#2]
l3: $ G , x ∊ nlev A C ⇒ x ∊ nlev A C $ by ax
l4: $ G , x ∊ nlev A C ⇒ x ∊ nlev B D $ by fs1_ne [l1, l2, l3]
l5: $ G , x ∊ nlev B D ⇒ A = B $ by weaken [#1]
l6: $ G , x ∊ nlev B D ⇒ C = D $ by weaken [#2]
l7: $ G , x ∊ nlev B D ⇒ x ∊ nlev B D $ by ax
l8: $ G , x ∊ nlev B D ⇒ x ∊ nlev A C $ by fs1_ne [eq_sym [l5], eq_sym [l6], l7]
l9: $ G ⇒ nlev A C = nlev B D $ by eq_intro [l4, l8]

nlev_two
--------
l1: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ nlev A B ⇒ x ∊ nlev A B $ by ax
l2: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ nlev A B ⇒ x = ∅ ∧ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) $ by cab_elim [l1]
l3: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ nlev A B ⇒ x ∊ csn ∅ $ by csn_intro [and_elim_l [l2]]
l4: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ csn ∅ ⇒ x ∊ csn ∅ $ by ax
l5: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ csn ∅ ⇒ x = ∅ $ by csn_elim [l4]
l6: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ csn ∅ ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) $ by ax
l7: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ csn ∅ ⇒ x ∊ nlev A B $ by cab_intro [and_intro [l5, l6]]
l8: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) ⇒ nlev A B = csn ∅ $ by eq_intro [l3, l7]
l9: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) ⇒ csn ∅ ∈ two $ by two_intro_r
l10: $ G , ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) ⇒ nlev A B ∈ two $ by wcel_eq_l [eq_sym [l8], l9]
l11: $ G , ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ nlev A B ⇒ x ∊ nlev A B $ by ax
l12: $ G , ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ nlev A B ⇒ x = ∅ ∧ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) $ by cab_elim [l11]
l13: $ G , ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ nlev A B ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) $ by and_elim_r [l12]
l14: $ G , ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ nlev A B ⇒ ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) $ by ax
l15: $ G , ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) , x ∊ nlev A B ⇒ ⊥ $ by not_elim [l14, l13]
l16: $ G , ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) ⇒ nlev A B = ∅ $ by empty_eq_intro [l15]
l17: $ G , ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) ⇒ ∅ ∈ two $ by two_intro_l
l18: $ G , ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) ⇒ nlev A B ∈ two $ by wcel_eq_l [eq_sym [l16], l17]
l19: $ G ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) ∨ ¬ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ A = nnf' c ∧ B = nnf' d ∧ c ⊆ d) $ by excluded_middle
l20: $ G ⇒ nlev A B ∈ two $ by or_elim [l19, l10, l18]

nlev_intro
----------
l1: $ G ⇒ nnf' a = nnf' a $ by eq_refl
l2: $ G ⇒ nnf' b = nnf' b $ by eq_refl
l3: $ G ⇒ nnf' b = nnf' b ∧ a ⊆ b $ by and_intro [l2, #3]
l4: $ G ⇒ nnf' a = nnf' a ∧ nnf' b = nnf' b ∧ a ⊆ b $ by and_intro [l1, l3]
l5: $ G ⇒ b ∊ ω ∧ nnf' a = nnf' a ∧ nnf' b = nnf' b ∧ a ⊆ b $ by and_intro [#2, l4]
l6: $ G ⇒ a ∊ ω ∧ b ∊ ω ∧ nnf' a = nnf' a ∧ nnf' b = nnf' b ∧ a ⊆ b $ by and_intro [#1, l5]
l7: $ G ⇒ ∃ d (a ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' a ∧ nnf' b = nnf' d ∧ a ⊆ d) $ by ex_intro [l6]
l8: $ G ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d) $ by ex_intro [l7]
l9: $ G , x9 = ∅ ⇒ x9 = ∅ $ by ax
l10: $ G , x9 = ∅ ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d) $ by weaken [l8]
l11: $ G , x9 = ∅ ⇒ x9 ∊ nlev (nnf' a) (nnf' b) $ by cab_intro [and_intro [l9, l10]]
l12: $ G , x9 = ∅ ⇒ ∅ ∈ nlev (nnf' a) (nnf' b) $ by wcel_eq_l [l9, welc_wcel [l11]]
l13: $ G ⇒ isset ∅ $ by ax_empty
l14: $ G ⇒ ∅ ∈ nlev (nnf' a) (nnf' b) $ by isset_elim [l13, l12]

nlev_elim
---------
l1: $ G , x = X ⇒ x = X $ by ax
l2: $ G , x = X ⇒ X ∈ nlev (nnf' a) (nnf' b) $ by weaken [#3]
l3: $ G , x = X ⇒ x ∊ nlev (nnf' a) (nnf' b) $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , x = X ⇒ x = ∅ ∧ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d) $ by cab_elim [l3]
l5: $ G , x = X ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d) $ by and_elim_r [l4]
l6: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d $ by ax
l7: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ c ∊ ω $ by and_elim_l [l6]
l8: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ d ∊ ω $ by and_elim_l [and_elim_r [l6]]
l9: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ nnf' a = nnf' c $ by and_elim_l [and_elim_r [and_elim_r [l6]]]
l10: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ nnf' b = nnf' d $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l6]]]]
l11: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ c ⊆ d $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [l6]]]]
l12: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ a ∊ ω $ by weaken [#1]
l13: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ a = c $ by nnf_inj [l12, l7, l9]
l14: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ b ∊ ω $ by weaken [#2]
l15: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ b = d $ by nnf_inj [l14, l8, l10]
l16: $ G , x = X , c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d ⇒ a ⊆ b $ by subset_eq_l [eq_sym [l13], subset_eq_r [eq_sym [l15], l11]]
l17: $ G , x = X , ∃ d (c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d) ⇒ ∃ d (c ∊ ω ∧ d ∊ ω ∧ nnf' a = nnf' c ∧ nnf' b = nnf' d ∧ c ⊆ d) $ by ax
l18: $ … ⇒ a ⊆ b $ by ex_elim [l17, l16]
l19: $ G , x = X ⇒ a ⊆ b $ by ex_elim [l5, l18]
l20: $ G ⇒ isset X $ by wcel_isset [#3]
l21: $ G ⇒ a ⊆ b $ by isset_elim [l20, l19]

lemma fs1_in (G: hyps) (A B: class): $ G ⇒ A ∈ two $ > $ G ⇒ B ∈ A $ > $ G ⇒ ∅ ∈ A $
----
l1: $ G ⇒ A = csn ∅ $ by f181_t [#1, #2]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ ∅ ∈ A $ by wcel_eq_r [eq_sym [l1], csn_intro_var_c [l2]]

lemma fs1_ls (G: hyps) (p m x: set): $ G ⇒ x ∊ nlev p m $ > $ G ⇒ ∅ ∈ nlev p (nsc m) $
----
l1: $ G ⇒ x = ∅ ∧ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d) $ by cab_elim [#1]
l2: $ G ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d) $ by and_elim_r [l1]
l3: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d $ by ax
l4: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ c ∊ ω $ by and_elim_l [l3]
l5: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ d ∊ ω $ by and_elim_l [and_elim_r [l3]]
l6: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ p = nnf' c $ by and_elim_l [and_elim_r [and_elim_r [l3]]]
l7: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ m = nnf' d $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]]
l8: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ c ⊆ d $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]
l9: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ q = suc d $ by ax
