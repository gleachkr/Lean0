l110: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ crn j1 ⊆ f195_bpow_q  $ by weaken [#1]
l111: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l112: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ kc_bd1 ∈ ω $ by kc_bd1_omega
l113: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ crn (scons x2 ∅) ⊆ f195_bpow_q  $ by node_crn_sub [l110, l111, l93, wcel_isset [l112], l109]
l114: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ isset x2 $ by isset_var
l115: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ x2 ∈ f195_bpow_q  $ by crn_scons_head [l114, l113]
l116: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ nvf' x3 = npow (nvf' x1) (nvf' x2) $ by f195_bpow_e [wcel_welc [l115], l96]
l117: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ ra_bmul x3 x3 x4 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l91]]]]]
l118: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ ra_bmul x4 x1 x5 ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l91]]]]]
l119: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ p = nvf' x1 $ by ax
l120: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ q = nvf' x2 $ by ax
l121: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ isset x1 $ by isset_var
l122: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ p ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l119], nvf_omega [l121]]]
l123: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ isset x2 $ by isset_var
l124: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ q ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l120], nvf_omega [l123]]]
l125: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ nvf = nvf $ by eq_refl
l126: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ $ by weaken [l93]
l127: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ x2 ∈ trees ω $ by weaken [l107]
l128: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ nvf' ty = suc (ndbl q) $ by eq_trans [fv_eq [l125, l126], eq_trans [nvf_bd1 [l127], suc_eq [ndbl_eq [eq_sym [l120]]]]]
l129: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ nvf' x3 = npow (nvf' x1) (nvf' x2) $ by weaken [l116]
l130: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ nvf' x3 = npow p q $ by eq_trans [l129, npow_eq [eq_sym [l119], eq_sym [l120]]]
l131: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ va = x1 $ by weaken [l92]
l132: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ p = nvf' va $ by eq_trans [l119, fv_eq [l125, eq_sym [l131]]]
l133: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ ra_bmul x3 x3 x4 ∈ lrel $ by weaken [l117]
l134: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ ra_bmul x4 x1 x5 ∈ lrel $ by weaken [l118]
l135: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ vc = x5 $ by weaken [l94]
l136: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ nvf' x5 = nmul (nvf' x4) (nvf' x1) $ by lrel_bmul_sem [l134]
l137: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ nvf' x4 = nmul (npow p q) (npow p q) $ by eq_trans [lrel_bmul_sem [l133], nmul_eq [l130, l130]]
l138: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ nvf' vc = nmul (nmul (npow p q) (npow p q)) p $ by eq_trans [fv_eq [l125, l135], eq_trans [l136, nmul_eq [l137, eq_sym [l119]]]]
l139: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ npow p (suc (ndbl q)) = nmul (nmul (npow p q) (npow p q)) p $ by npow_dbl1 [l122, l124]
l140: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 , q = nvf' x2 ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by eq_trans [l138, eq_trans [eq_sym [l139], npow_eq [l132, eq_sym [l128]]]]
l141: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 ⇒ isset x2 $ by isset_var
l142: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 ⇒ isset (nvf' x2) $ by wcel_isset [nvf_omega [l141]]
l143: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel , p = nvf' x1 ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by isset_elim [l142, l140]
l144: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ isset x1 $ by isset_var
l145: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ isset (nvf' x1) $ by wcel_isset [nvf_omega [l144]]
l146: $ G , va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by isset_elim [l145, l143]
l147: $ G , ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) ⇒ ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) $ by ax
l148: $ … ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by ex_elim [l147, l146]
l149: $ G , ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) ⇒ ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) $ by ax
l150: $ … ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by ex_elim [l149, l148]
l151: $ G , ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) ⇒ ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) $ by ax
l152: $ … ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by ex_elim [l151, l150]
l153: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) ⇒ ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) $ by ax
l154: $ … ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by ex_elim [l153, l152]
l155: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) $ by ax
l156: $ … ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by ex_elim [l155, l154]
l157: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel)) → nvf' vc = npow (nvf' va) (nvf' ty) $ by imp_intro [l156]
l158: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel)) → nvf' vc = npow (nvf' va) (nvf' ty) $ by or_elim_imp [l90, l157]
l159: $ G ⇒ (∃ x1 (va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel)) → nvf' vc = npow (nvf' va) (nvf' ty) $ by or_elim_imp [l28, l158]
l160: $ G ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by imp_elim [l159, l2]

lemma f195_bpow_all (G: hyps) : $ G ⇒ trees ω ⊆ f195_bpow_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ , ra_bpow a y c ∈ lrel ⇒ crn x9 ⊆ f195_bpow_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ , ra_bpow a y c ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ , ra_bpow a y c ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ , ra_bpow a y c ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ , ra_bpow a y c ∈ lrel ⇒ ra_bpow a y c ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ , ra_bpow a y c ∈ lrel ⇒ nvf' c = npow (nvf' a) (nvf' y) $ by f195_bpow_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_bpow a y c ∈ lrel → nvf' c = npow (nvf' a) (nvf' y) $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c (ra_bpow a y c ∈ lrel → nvf' c = npow (nvf' a) (nvf' y)) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ a ∀ c (ra_bpow a y c ∈ lrel → nvf' c = npow (nvf' a) (nvf' y)) $ by all_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f195_bpow_q  $ by cab_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f195_bpow_q  $ by wcel_intro [l11, l10]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bpow_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f195_bpow_q  $ by isset_elim [l13, l12]
l15: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f195_bpow_q  → ⟨ x8 , x9 ⟩ ∈ f195_bpow_q  $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f195_bpow_q  → ⟨ x8 , x9 ⟩ ∈ f195_bpow_q ) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f195_bpow_q  $ by trees_ind_c [l17, l16]

lrel_bpow_sem
-------------
l1: $ G ⇒ trees ω ⊆ f195_bpow_q  $ by f195_bpow_all
l2: $ G ⇒ ⟨ kr_bpow , scons t1 (scons t2 (scons t3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons t3 ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons t2 (scons t3 ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_bpow ∈ ω $ by kr_bpow_omega
l8: $ G ⇒ kr_bpow ∈ ω ∧ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons t1 (scons t2 (scons t3 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ crn (scons t2 (scons t3 ∅)) ⊆ trees ω $ by crn_scons_tail [l9]
l11: $ G ⇒ isset ω $ by omega_set
l12: $ G ⇒ t2 ∈ trees ω $ by crn_scons_head_trees [l11, l10]
l13: $ G ⇒ t2 ∊ f195_bpow_q  $ by subset_elim [l1, wcel_welc [l12]]
l14: $ G ⇒ nvf' t3 = npow (nvf' t1) (nvf' t2) $ by f195_bpow_e [l13, #1]

bpow_sem
--------
l1: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ x = enc_bin a $ by ax
l2: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ y = enc_bin b $ by ax
l3: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ z = enc_bin c $ by ax
l4: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ ra_bpow (enc_bin a) (enc_bin b) (enc_bin c) ∈ lrel $ by weaken [#1]
l5: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ ra_bpow x y z ∈ lrel $ by wcel_eq_l [ra_bpow_eq [eq_sym [l1], eq_sym [l2], eq_sym [l3]], l4]
l6: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf' z = npow (nvf' x) (nvf' y) $ by lrel_bpow_sem [l5]
l7: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf = nvf $ by eq_refl
l8: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf' (enc_bin c) = npow (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by eq_trans [eq_sym [fv_eq [l7, l3]], eq_trans [l6, npow_eq [fv_eq [l7, l1], fv_eq [l7, l2]]]]
l9: $ G , x = enc_bin a , y = enc_bin b ⇒ enc_bin c ∈ trees ω $ by enc_bin_trees
l10: $ G , x = enc_bin a , y = enc_bin b ⇒ isset (enc_bin c) $ by wcel_isset [l9]
l11: $ G , x = enc_bin a , y = enc_bin b ⇒ nvf' (enc_bin c) = npow (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l10, l8]
l12: $ G , x = enc_bin a ⇒ enc_bin b ∈ trees ω $ by enc_bin_trees
l13: $ G , x = enc_bin a ⇒ isset (enc_bin b) $ by wcel_isset [l12]
l14: $ G , x = enc_bin a ⇒ nvf' (enc_bin c) = npow (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l13, l11]
l15: $ G ⇒ enc_bin a ∈ trees ω $ by enc_bin_trees
l16: $ G ⇒ isset (enc_bin a) $ by wcel_isset [l15]
l17: $ G ⇒ nvf' (enc_bin c) = npow (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l16, l14]

jmod_e
------
l1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ uadm u $ by ax
l2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ jval u M (jmod M) $ by jmod_jval [l1]
l3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ ra_deq (enc_ctx G) (enc_expr e) (enc_expr e2) (enc_expr A) ∈ jmod M $ by weaken [#1]
l4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
l5: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ sat u M (enc_ctx G) w $ by ax
l6: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r $ by jval_elim [l2, l3, welc_wcel [l4], welc_wcel [l5]]
l7: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r $ by and_elim_l [l6]
l8: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r $ by and_elim_r [l6]
z1: $ mdeq M G e e2 A $ by mdeq_i [l7, l8]

