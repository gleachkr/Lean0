l120: $ G , t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bxor x1 x2 x3 ∈ lrel ⇒ kr_bxor ∈ ω $ by kr_bxor_omega
l121: $ … ⇒ kr_bxor ∈ ω ∧ scons x1 (scons x2 (scons x3 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l115, wcel_isset [l120], l119]
l122: $ … ⇒ crn (scons x1 (scons x2 (scons x3 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l121]]
