l150: $ G , ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ⇒ ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) $ by ax
l151: $ … ⇒ dt u M z w d = dt u M t w d $ by ex_elim [l150, l149]
l152: $ G , ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ⇒ ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) $ by ax
l153: $ … ⇒ dt u M z w d = dt u M t w d $ by ex_elim [l152, l151]
l154: $ G , ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ⇒ ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) $ by ax
l155: $ … ⇒ dt u M z w d = dt u M t w d $ by ex_elim [l154, l153]
l156: $ G , ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ⇒ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) $ by ax
l157: $ … ⇒ dt u M z w d = dt u M t w d $ by ex_elim [l156, l155]
l158: $ G ⇒ (∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0)) → dt u M z w d = dt u M t w d $ by imp_intro [l157]
l159: $ G , z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2 ⇒ z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2 $ by ax
l160: $ G , z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2 ⇒ ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ = ⟨ kc_lit , y ⟩ $ by eq_trans [eq_sym [and_elim_l [l159]], weaken [#1]]
l161: $ G , z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2 ⇒ kc_proj ∈ ω $ by kc_proj_omega
l162: $ G , z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2 ⇒ kc_lit ∈ ω $ by kc_lit_omega
l163: $ … ⇒ kc_proj = kc_lit $ by opair_inj_l_c [l160, wcel_isset [l161], wcel_isset [l162]]
l164: $ G , z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2 ⇒ ¬ kc_lit = kc_proj $ by kc_lit_ne_proj
l165: $ … ⇒ ¬ kc_proj = kc_lit $ by ne_sym [l164]
l166: $ … ⇒ dt u M z w d = dt u M t w d $ by bot_elim [not_elim [l165, l163]]
l167: $ G , ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2) ⇒ ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2) $ by ax
