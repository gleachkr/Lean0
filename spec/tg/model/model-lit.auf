l13: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b , nvf' a = ∅ ⇒ ∀ x3 (x3 ∊ ω → ∀ x4 (x4 ∊ ω → ∃ q (q ∊ ω ∧ ap (ap F (nnf' (ndiv x3 two))) (nnf' (ndiv x4 two)) = nnf' q ∧ ap (ap F (nnf' x3)) (nnf' x4) = nnf' (nadd (nadd q q) (ndiv (nadd (nmod x3 two) (nmod x4 two)) two))))) $ by weaken [l9]
l14: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b , nvf' a = ∅ ⇒ ∀ x3 (x3 ∊ ω → ap (ap F (nnf' ∅)) (nnf' x3) = nnf' ∅) $ by fs1_and_z1 [l13]
