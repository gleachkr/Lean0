l748: $ G , ra_baddc ty vb vc ∈ lrel ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = suc (nadd (nvf' ty) (nvf' vb)) $ by or_elim_imp [l664, l747]
l749: $ G , ra_baddc ty vb vc ∈ lrel ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = suc (nadd (nvf' ty) (nvf' vb)) $ by or_elim_imp [l581, l748]
l750: $ G , ra_baddc ty vb vc ∈ lrel ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = suc (nadd (nvf' ty) (nvf' vb)) $ by or_elim_imp [l498, l749]
l751: $ G , ra_baddc ty vb vc ∈ lrel ⇒ (∃ x1 ∃ x3 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x3 ∧ ra_bsucc x1 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = suc (nadd (nvf' ty) (nvf' vb)) $ by or_elim_imp [l415, l750]
l752: $ G , ra_baddc ty vb vc ∈ lrel ⇒ (∃ x2 ∃ x3 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x3 ∧ ra_bsucc x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x3 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x3 ∧ ra_bsucc x1 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = suc (nadd (nvf' ty) (nvf' vb)) $ by or_elim_imp [l396, l751]
l753: $ G , ra_baddc ty vb vc ∈ lrel ⇒ nvf' vc = suc (nadd (nvf' ty) (nvf' vb)) $ by imp_elim [l752, l375]
l754: $ G ⇒ ra_baddc ty vb vc ∈ lrel → nvf' vc = suc (nadd (nvf' ty) (nvf' vb)) $ by imp_intro [l753]
l755: $ G ⇒ (ra_badd ty vb vc ∈ lrel → nvf' vc = nadd (nvf' ty) (nvf' vb)) ∧ (ra_baddc ty vb vc ∈ lrel → nvf' vc = suc (nadd (nvf' ty) (nvf' vb))) $ by and_intro [l373, l754]

lemma f194_ba_all (G: hyps) : $ G ⇒ trees ω ⊆ f194_ba_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ , y = y ⇒ crn x9 ⊆ f194_ba_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ , y = y ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ , y = y ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ , y = y ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ , y = y ⇒ y = y $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ , y = y ⇒ (ra_badd y b c ∈ lrel → nvf' c = nadd (nvf' y) (nvf' b)) ∧ (ra_baddc y b c ∈ lrel → nvf' c = suc (nadd (nvf' y) (nvf' b))) $ by f194_ba_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = y → (ra_badd y b c ∈ lrel → nvf' c = nadd (nvf' y) (nvf' b)) ∧ (ra_baddc y b c ∈ lrel → nvf' c = suc (nadd (nvf' y) (nvf' b))) $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c (y = y → (ra_badd y b c ∈ lrel → nvf' c = nadd (nvf' y) (nvf' b)) ∧ (ra_baddc y b c ∈ lrel → nvf' c = suc (nadd (nvf' y) (nvf' b)))) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ b ∀ c (y = y → (ra_badd y b c ∈ lrel → nvf' c = nadd (nvf' y) (nvf' b)) ∧ (ra_baddc y b c ∈ lrel → nvf' c = suc (nadd (nvf' y) (nvf' b)))) $ by all_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f194_ba_q  $ by cab_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f194_ba_q  $ by wcel_intro [l11, l10]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f194_ba_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f194_ba_q  $ by isset_elim [l13, l12]
l15: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f194_ba_q  → ⟨ x8 , x9 ⟩ ∈ f194_ba_q  $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f194_ba_q  → ⟨ x8 , x9 ⟩ ∈ f194_ba_q ) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f194_ba_q  $ by trees_ind_c [l17, l16]

lrel_badd_sem
-------------
l1: $ G ⇒ trees ω ⊆ f194_ba_q  $ by f194_ba_all
l2: $ G ⇒ ⟨ kr_badd , scons t1 (scons t2 (scons t3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons t3 ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons t2 (scons t3 ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_badd ∈ ω $ by kr_badd_omega
l8: $ G ⇒ kr_badd ∈ ω ∧ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons t1 (scons t2 (scons t3 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ t1 ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ t1 ∊ f194_ba_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ t1 = t1 $ by eq_refl
l14: $ G ⇒ (ra_badd t1 t2 t3 ∈ lrel → nvf' t3 = nadd (nvf' t1) (nvf' t2)) ∧ (ra_baddc t1 t2 t3 ∈ lrel → nvf' t3 = suc (nadd (nvf' t1) (nvf' t2))) $ by f194_ba_e [l12, l13]
l15: $ G ⇒ nvf' t3 = nadd (nvf' t1) (nvf' t2) $ by imp_elim [and_elim_l [l14], #1]

badd_sem
--------
l1: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ x = enc_bin a $ by ax
l2: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ y = enc_bin b $ by ax
l3: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ z = enc_bin c $ by ax
l4: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ ra_badd (enc_bin a) (enc_bin b) (enc_bin c) ∈ lrel $ by weaken [#1]
l5: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ ra_badd x y z ∈ lrel $ by wcel_eq_l [ra_badd_eq [eq_sym [l1], eq_sym [l2], eq_sym [l3]], l4]
l6: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf' z = nadd (nvf' x) (nvf' y) $ by lrel_badd_sem [l5]
l7: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf = nvf $ by eq_refl
l8: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf' (enc_bin c) = nadd (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by eq_trans [eq_sym [fv_eq [l7, l3]], eq_trans [l6, nadd_eq [fv_eq [l7, l1], fv_eq [l7, l2]]]]
l9: $ G , x = enc_bin a , y = enc_bin b ⇒ enc_bin c ∈ trees ω $ by enc_bin_trees
l10: $ G , x = enc_bin a , y = enc_bin b ⇒ isset (enc_bin c) $ by wcel_isset [l9]
l11: $ G , x = enc_bin a , y = enc_bin b ⇒ nvf' (enc_bin c) = nadd (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l10, l8]
l12: $ G , x = enc_bin a ⇒ enc_bin b ∈ trees ω $ by enc_bin_trees
l13: $ G , x = enc_bin a ⇒ isset (enc_bin b) $ by wcel_isset [l12]
l14: $ G , x = enc_bin a ⇒ nvf' (enc_bin c) = nadd (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l13, l11]
l15: $ G ⇒ enc_bin a ∈ trees ω $ by enc_bin_trees
l16: $ G ⇒ isset (enc_bin a) $ by wcel_isset [l15]
l17: $ G ⇒ nvf' (enc_bin c) = nadd (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l16, l14]

lrel_baddc_sem
--------------
l1: $ G ⇒ trees ω ⊆ f194_ba_q  $ by f194_ba_all
l2: $ G ⇒ ⟨ kr_baddc , scons t1 (scons t2 (scons t3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons t3 ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons t2 (scons t3 ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_baddc ∈ ω $ by kr_baddc_omega
l8: $ G ⇒ kr_baddc ∈ ω ∧ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons t1 (scons t2 (scons t3 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ t1 ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ t1 ∊ f194_ba_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ t1 = t1 $ by eq_refl
l14: $ G ⇒ (ra_badd t1 t2 t3 ∈ lrel → nvf' t3 = nadd (nvf' t1) (nvf' t2)) ∧ (ra_baddc t1 t2 t3 ∈ lrel → nvf' t3 = suc (nadd (nvf' t1) (nvf' t2))) $ by f194_ba_e [l12, l13]
l15: $ G ⇒ nvf' t3 = suc (nadd (nvf' t1) (nvf' t2)) $ by imp_elim [and_elim_r [l14], #1]

baddc_sem
---------
l1: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ x = enc_bin a $ by ax
l2: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ y = enc_bin b $ by ax
l3: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ z = enc_bin c $ by ax
l4: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ ra_baddc (enc_bin a) (enc_bin b) (enc_bin c) ∈ lrel $ by weaken [#1]
l5: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ ra_baddc x y z ∈ lrel $ by wcel_eq_l [ra_baddc_eq [eq_sym [l1], eq_sym [l2], eq_sym [l3]], l4]
l6: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf' z = suc (nadd (nvf' x) (nvf' y)) $ by lrel_baddc_sem [l5]
l7: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf = nvf $ by eq_refl
l8: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf' (enc_bin c) = suc (nadd (nvf' (enc_bin a)) (nvf' (enc_bin b))) $ by eq_trans [eq_sym [fv_eq [l7, l3]], eq_trans [l6, suc_eq [nadd_eq [fv_eq [l7, l1], fv_eq [l7, l2]]]]]
l9: $ G , x = enc_bin a , y = enc_bin b ⇒ enc_bin c ∈ trees ω $ by enc_bin_trees
l10: $ G , x = enc_bin a , y = enc_bin b ⇒ isset (enc_bin c) $ by wcel_isset [l9]
l11: $ G , x = enc_bin a , y = enc_bin b ⇒ nvf' (enc_bin c) = suc (nadd (nvf' (enc_bin a)) (nvf' (enc_bin b))) $ by isset_elim [l10, l8]
l12: $ G , x = enc_bin a ⇒ enc_bin b ∈ trees ω $ by enc_bin_trees
l13: $ G , x = enc_bin a ⇒ isset (enc_bin b) $ by wcel_isset [l12]
l14: $ G , x = enc_bin a ⇒ nvf' (enc_bin c) = suc (nadd (nvf' (enc_bin a)) (nvf' (enc_bin b))) $ by isset_elim [l13, l11]
l15: $ G ⇒ enc_bin a ∈ trees ω $ by enc_bin_trees
l16: $ G ⇒ isset (enc_bin a) $ by wcel_isset [l15]
l17: $ G ⇒ nvf' (enc_bin c) = suc (nadd (nvf' (enc_bin a)) (nvf' (enc_bin b))) $ by isset_elim [l16, l14]

def f195_bmul_q  (.y .a .c: set): class = $ {y | ∀ a ∀ c (ra_bmul a y c ∈ lrel → nvf' c = nmul (nvf' a) (nvf' y))} $

lemma f195_bmul_e (G: hyps)  (ty va vc: set): $ G ⇒ ty ∊ f195_bmul_q  $ > $ G ⇒ ra_bmul va ty vc ∈ lrel $ > $ G ⇒ nvf' vc = nmul (nvf' va) (nvf' ty) $
----
l1: $ G ⇒ ∀ a ∀ c (ra_bmul a ty c ∈ lrel → nvf' c = nmul (nvf' a) (nvf' ty)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ c (ra_bmul va ty c ∈ lrel → nvf' c = nmul (nvf' va) (nvf' ty)) $ by all_elim [l1]
l3: $ G ⇒ ra_bmul va ty vc ∈ lrel → nvf' vc = nmul (nvf' va) (nvf' ty) $ by all_elim [l2]
l4: $ G ⇒ nvf' vc = nmul (nvf' va) (nvf' ty) $ by imp_elim [l3, #2]

lemma f195_bmul_n (G: hyps)  (ty k1 j1 va vc: set): $ G ⇒ crn j1 ⊆ f195_bmul_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_bmul va ty vc ∈ lrel $ > $ G ⇒ nvf' vc = nmul (nvf' va) (nvf' ty) $
----
l1: $ G ⇒ ra_bmul va ty vc ∈ lrel $ by weaken [#5]
l2: $ G ⇒ ∃ x1 (va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bmul x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bmul x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ∧ ra_badd x4 x1 x5 ∈ lrel) $ by lrel_bmul_cases [l1]
l3: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ $ by ax
l4: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ va = x1 $ by and_elim_l [l3]
l5: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ ty = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [and_elim_r [l3]]
l6: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ vc = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_r [and_elim_r [l3]]
