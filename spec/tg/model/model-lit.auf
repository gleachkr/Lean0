l159: $ G , t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l160: $ G , t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l161: $ … ⇒ ra_band x1 x2 x3 ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [l155]]]
