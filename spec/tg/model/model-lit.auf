l238: $ … ⇒ (∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l122, l237]
l239: $ … ⇒ (∃ f ∃ m ∃ n (z = ⟨ kc_cst , scons f (scons m ∅) ⟩ ∧ t = ⟨ kc_cst , scons f (scons n ∅) ⟩ ∧ ra_lseqv m n ∈ lrel2) ∨ ∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l107, l238]
l240: $ … ⇒ (∃ l (z = ⟨ kc_lit , scons l ∅ ⟩ ∧ t = ⟨ kc_lit , scons l ∅ ⟩) ∨ ∃ f ∃ m ∃ n (z = ⟨ kc_cst , scons f (scons m ∅) ⟩ ∧ t = ⟨ kc_cst , scons f (scons n ∅) ⟩ ∧ ra_lseqv m n ∈ lrel2) ∨ ∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l93, l239]
l241: $ … ⇒ (∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_pi , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_pi , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ l (z = ⟨ kc_lit , scons l ∅ ⟩ ∧ t = ⟨ kc_lit , scons l ∅ ⟩) ∨ ∃ f ∃ m ∃ n (z = ⟨ kc_cst , scons f (scons m ∅) ⟩ ∧ t = ⟨ kc_cst , scons f (scons n ∅) ⟩ ∧ ra_lseqv m n ∈ lrel2) ∨ ∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l82, l240]
l242: $ … ⇒ (∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_lam , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_lam , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_pi , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_pi , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ l (z = ⟨ kc_lit , scons l ∅ ⟩ ∧ t = ⟨ kc_lit , scons l ∅ ⟩) ∨ ∃ f ∃ m ∃ n (z = ⟨ kc_cst , scons f (scons m ∅) ⟩ ∧ t = ⟨ kc_cst , scons f (scons n ∅) ⟩ ∧ ra_lseqv m n ∈ lrel2) ∨ ∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l66, l241]
l243: $ … ⇒ (∃ c ∃ f ∃ g ∃ i (z = ⟨ kc_app , scons c (scons f ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons i ∅) ⟩ ∧ ra_eeqv c g ∈ lrel2 ∧ ra_eeqv f i ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_lam , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_lam , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_pi , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_pi , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ l (z = ⟨ kc_lit , scons l ∅ ⟩ ∧ t = ⟨ kc_lit , scons l ∅ ⟩) ∨ ∃ f ∃ m ∃ n (z = ⟨ kc_cst , scons f (scons m ∅) ⟩ ∧ t = ⟨ kc_cst , scons f (scons n ∅) ⟩ ∧ ra_lseqv m n ∈ lrel2) ∨ ∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l50, l242]
l244: $ … ⇒ (∃ a ∃ b (z = ⟨ kc_srt , scons a ∅ ⟩ ∧ t = ⟨ kc_srt , scons b ∅ ⟩ ∧ lveq a b) ∨ ∃ c ∃ f ∃ g ∃ i (z = ⟨ kc_app , scons c (scons f ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons i ∅) ⟩ ∧ ra_eeqv c g ∈ lrel2 ∧ ra_eeqv f i ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_lam , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_lam , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_pi , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_pi , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ l (z = ⟨ kc_lit , scons l ∅ ⟩ ∧ t = ⟨ kc_lit , scons l ∅ ⟩) ∨ ∃ f ∃ m ∃ n (z = ⟨ kc_cst , scons f (scons m ∅) ⟩ ∧ t = ⟨ kc_cst , scons f (scons n ∅) ⟩ ∧ ra_lseqv m n ∈ lrel2) ∨ ∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l34, l243]
l245: $ … ⇒ (∃ v (z = ⟨ kc_bvar , scons v ∅ ⟩ ∧ t = ⟨ kc_bvar , scons v ∅ ⟩) ∨ ∃ a ∃ b (z = ⟨ kc_srt , scons a ∅ ⟩ ∧ t = ⟨ kc_srt , scons b ∅ ⟩ ∧ lveq a b) ∨ ∃ c ∃ f ∃ g ∃ i (z = ⟨ kc_app , scons c (scons f ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons i ∅) ⟩ ∧ ra_eeqv c g ∈ lrel2 ∧ ra_eeqv f i ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_lam , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_lam , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_pi , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_pi , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ l (z = ⟨ kc_lit , scons l ∅ ⟩ ∧ t = ⟨ kc_lit , scons l ∅ ⟩) ∨ ∃ f ∃ m ∃ n (z = ⟨ kc_cst , scons f (scons m ∅) ⟩ ∧ t = ⟨ kc_cst , scons f (scons n ∅) ⟩ ∧ ra_lseqv m n ∈ lrel2) ∨ ∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l22, l244]
l246: $ … ⇒ (∃ x (z = x ∧ t = x) ∨ ∃ v (z = ⟨ kc_bvar , scons v ∅ ⟩ ∧ t = ⟨ kc_bvar , scons v ∅ ⟩) ∨ ∃ a ∃ b (z = ⟨ kc_srt , scons a ∅ ⟩ ∧ t = ⟨ kc_srt , scons b ∅ ⟩ ∧ lveq a b) ∨ ∃ c ∃ f ∃ g ∃ i (z = ⟨ kc_app , scons c (scons f ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons i ∅) ⟩ ∧ ra_eeqv c g ∈ lrel2 ∧ ra_eeqv f i ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_lam , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_lam , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ j ∃ k ∃ e ∃ h (z = ⟨ kc_pi , scons j (scons k ∅) ⟩ ∧ t = ⟨ kc_pi , scons e (scons h ∅) ⟩ ∧ ra_eeqv j e ∈ lrel2 ∧ ra_eeqv k h ∈ lrel2) ∨ ∃ l (z = ⟨ kc_lit , scons l ∅ ⟩ ∧ t = ⟨ kc_lit , scons l ∅ ⟩) ∨ ∃ f ∃ m ∃ n (z = ⟨ kc_cst , scons f (scons m ∅) ⟩ ∧ t = ⟨ kc_cst , scons f (scons n ∅) ⟩ ∧ ra_lseqv m n ∈ lrel2) ∨ ∃ o ∃ p ∃ v (z = ⟨ kc_ind_ty , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons p (scons v ∅) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ q (z = ⟨ kc_ind_ctor , scons o (scons v (scons q ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons p (scons v (scons q ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2) ∨ ∃ o ∃ p ∃ v ∃ r ∃ x0 (z = ⟨ kc_ind_rec , scons o (scons v (scons r ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons p (scons v (scons x0 ∅)) ⟩ ∧ ra_ind_eqv o p ∈ lrel2 ∧ lveq r x0) ∨ ∃ k ∃ v ∃ x ∃ x1 (z = ⟨ kc_proj , scons k (scons v (scons x ∅)) ⟩ ∧ t = ⟨ kc_proj , scons k (scons v (scons x1 ∅)) ⟩ ∧ ra_eeqv x x1 ∈ lrel2)) → dt u M z w d = dt u M t w d $ by or_elim_imp [l12, l245]
l247: $ G ⇒ dt u M z w d = dt u M t w d $ by imp_elim [l246, l1]

def f210_band_q  (.y .b .c: set): class = $ {y | ∀ b ∀ c (ra_band y b c ∈ lrel → (nvf' y = ∅ → nvf' c = ∅) ∧ (nvf' b = ∅ → nvf' c = ∅))} $

lemma f210_band_e (G: hyps)  (ty vb vc: set): $ G ⇒ ty ∊ f210_band_q  $ > $ G ⇒ ra_band ty vb vc ∈ lrel $ > $ G ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $
----
l1: $ G ⇒ ∀ b ∀ c (ra_band ty b c ∈ lrel → (nvf' ty = ∅ → nvf' c = ∅) ∧ (nvf' b = ∅ → nvf' c = ∅)) $ by cab_elim [#1]
l2: $ … ⇒ ∀ c (ra_band ty vb c ∈ lrel → (nvf' ty = ∅ → nvf' c = ∅) ∧ (nvf' vb = ∅ → nvf' c = ∅)) $ by all_elim [l1]
l3: $ … ⇒ ra_band ty vb vc ∈ lrel → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by all_elim [l2]
l4: $ G ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by imp_elim [l3, #2]

lemma f210_band_n (G: hyps)  (ty k1 j1 vb vc: set): $ G ⇒ crn j1 ⊆ f210_band_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_band ty vb vc ∈ lrel $ > $ G ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $
----
l1: $ G ⇒ ra_band ty vb vc ∈ lrel $ by weaken [#5]
l2: $ … ⇒ ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel) $ by lrel_band_cases [l1]
l3: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ $ by ax
l4: $ … ⇒ ty = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ vb = x2 $ by and_elim_l [and_elim_r [l3]]
l6: $ … ⇒ vc = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_r [and_elim_r [l3]]
l7: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l8: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l9: $ … ⇒ nvf' ty = ∅ $ by eq_trans [fv_eq [l7, l4], l8]
l10: $ … ⇒ nvf' vc = ∅ $ by eq_trans [fv_eq [l7, l6], l8]
l11: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ , nvf' ty = ∅ ⇒ nvf' ty = ∅ $ by ax
l12: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ , nvf' ty = ∅ ⇒ nvf' vc = ∅ $ by weaken [l10]
l13: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf' ty = ∅ → nvf' vc = ∅ $ by imp_intro [l12]
l14: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ , nvf' vb = ∅ ⇒ nvf' vb = ∅ $ by ax
l15: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ , nvf' vb = ∅ ⇒ nvf' vc = ∅ $ by weaken [l10]
l16: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf' vb = ∅ → nvf' vc = ∅ $ by imp_intro [l15]
l17: $ … ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by and_intro [l13, l16]
l18: $ G , ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩) ⇒ ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩) $ by ax
l19: $ … ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by ex_elim [l18, l17]
l20: $ G ⇒ (∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩)) → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by imp_intro [l19]
l21: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ $ by ax
l22: $ … ⇒ ty = x1 $ by and_elim_l [l21]
l23: $ … ⇒ vb = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [and_elim_r [l21]]
l24: $ … ⇒ vc = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_r [and_elim_r [l21]]
l25: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l26: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l27: $ … ⇒ nvf' vb = ∅ $ by eq_trans [fv_eq [l25, l23], l26]
l28: $ … ⇒ nvf' vc = ∅ $ by eq_trans [fv_eq [l25, l24], l26]
l29: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ , nvf' ty = ∅ ⇒ nvf' ty = ∅ $ by ax
l30: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ , nvf' ty = ∅ ⇒ nvf' vc = ∅ $ by weaken [l28]
l31: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf' ty = ∅ → nvf' vc = ∅ $ by imp_intro [l30]
l32: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ , nvf' vb = ∅ ⇒ nvf' vb = ∅ $ by ax
l33: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ , nvf' vb = ∅ ⇒ nvf' vc = ∅ $ by weaken [l28]
l34: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf' vb = ∅ → nvf' vc = ∅ $ by imp_intro [l33]
l35: $ … ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by and_intro [l31, l34]
l36: $ G , ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩) ⇒ ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩) $ by ax
l37: $ … ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by ex_elim [l36, l35]
l38: $ G ⇒ (∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩)) → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by imp_intro [l37]
l39: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel $ by ax
l40: $ … ⇒ ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ $ by and_elim_l [l39]
l41: $ … ⇒ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ $ by and_elim_l [and_elim_r [l39]]
l42: $ … ⇒ vc = x4 $ by and_elim_l [and_elim_r [and_elim_r [l39]]]
l43: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l44: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l45: $ … ⇒ ra_band x1 x2 x3 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l39]]]]
l46: $ … ⇒ ⟨ kr_band , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [l45]
l47: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ isset ∅ $ by ax_empty
l48: $ … ⇒ isset (scons x3 ∅) $ by scons_set [l47]
l49: $ … ⇒ isset (scons x2 (scons x3 ∅)) $ by scons_set [l48]
l50: $ … ⇒ isset (scons x1 (scons x2 (scons x3 ∅))) $ by scons_set [l49]
