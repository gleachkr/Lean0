lemma f200_u0 (G: hyps): $ G ⇒ ⋃ ∅ = ∅ $
----
l1: $ G , x ∊ ⋃ ∅ , y ∊ ∅ , x ∊ y ⇒ y ∊ ∅ $ by ax
l2: $ G , x ∊ ⋃ ∅ , y ∊ ∅ , x ∊ y ⇒ ⊥ $ by empty_elim [l1]
l3: $ G , x ∊ ⋃ ∅ ⇒ x ∊ ⋃ ∅ $ by ax
l4: $ G , x ∊ ⋃ ∅ ⇒ ⊥ $ by cuni_elim [l3, l2]
l5: $ G ⇒ ⋃ ∅ = ∅ $ by empty_eq_intro [l4]

