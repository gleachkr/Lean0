l9: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ hlit ⊆ H $ by weaken [#2]
l10: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ functional H $ by hind_functional [l8]
l11: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ dt u (mcv H) (enc_expr (ind_ty nat_D nz)) w t = nnat $ by dt_nat_ty [l8, l1, l7, l6]
l12: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ enc_bin b0 ∈ trees ω $ by enc_bin_trees
l13: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ dt u (mcv H) (enc_expr (lit b0)) w t = nnf' nvf' (enc_bin b0) $ by dt_lit [l9, l10, l12, l7, l6, l1]
l14: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ nvf' (enc_bin b0) = ∅ $ by nvf_b0
