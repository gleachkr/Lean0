l163: $ G , t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel ⇒ isset ∅ $ by ax_empty
