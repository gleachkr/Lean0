l144: $ … ⇒ nvf' vc = nmul (nvf' va) (nvf' ty) $ by ex_elim [l143, l142]
l145: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bmul x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ∧ ra_badd x4 x1 x5 ∈ lrel)) → nvf' vc = nmul (nvf' va) (nvf' ty) $ by imp_intro [l144]
l146: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bmul x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bmul x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ∧ ra_badd x4 x1 x5 ∈ lrel)) → nvf' vc = nmul (nvf' va) (nvf' ty) $ by or_elim_imp [l78, l145]
l147: $ G ⇒ (∃ x1 (va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bmul x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bmul x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ∧ ra_badd x4 x1 x5 ∈ lrel)) → nvf' vc = nmul (nvf' va) (nvf' ty) $ by or_elim_imp [l16, l146]
l148: $ G ⇒ nvf' vc = nmul (nvf' va) (nvf' ty) $ by imp_elim [l147, l2]

lemma f195_bmul_all (G: hyps) : $ G ⇒ trees ω ⊆ f195_bmul_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ , ra_bmul a y c ∈ lrel ⇒ crn x9 ⊆ f195_bmul_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ , ra_bmul a y c ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ , ra_bmul a y c ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ , ra_bmul a y c ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ , ra_bmul a y c ∈ lrel ⇒ ra_bmul a y c ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ , ra_bmul a y c ∈ lrel ⇒ nvf' c = nmul (nvf' a) (nvf' y) $ by f195_bmul_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_bmul a y c ∈ lrel → nvf' c = nmul (nvf' a) (nvf' y) $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c (ra_bmul a y c ∈ lrel → nvf' c = nmul (nvf' a) (nvf' y)) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ a ∀ c (ra_bmul a y c ∈ lrel → nvf' c = nmul (nvf' a) (nvf' y)) $ by all_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f195_bmul_q  $ by cab_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f195_bmul_q  $ by wcel_intro [l11, l10]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f195_bmul_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f195_bmul_q  $ by isset_elim [l13, l12]
l15: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f195_bmul_q  → ⟨ x8 , x9 ⟩ ∈ f195_bmul_q  $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f195_bmul_q  → ⟨ x8 , x9 ⟩ ∈ f195_bmul_q ) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f195_bmul_q  $ by trees_ind_c [l17, l16]

lrel_bmul_sem
-------------
l1: $ G ⇒ trees ω ⊆ f195_bmul_q  $ by f195_bmul_all
l2: $ G ⇒ ⟨ kr_bmul , scons t1 (scons t2 (scons t3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons t3 ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons t2 (scons t3 ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_bmul ∈ ω $ by kr_bmul_omega
l8: $ G ⇒ kr_bmul ∈ ω ∧ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons t1 (scons t2 (scons t3 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ crn (scons t2 (scons t3 ∅)) ⊆ trees ω $ by crn_scons_tail [l9]
l11: $ G ⇒ isset ω $ by omega_set
l12: $ G ⇒ t2 ∈ trees ω $ by crn_scons_head_trees [l11, l10]
l13: $ G ⇒ t2 ∊ f195_bmul_q  $ by subset_elim [l1, wcel_welc [l12]]
l14: $ G ⇒ nvf' t3 = nmul (nvf' t1) (nvf' t2) $ by f195_bmul_e [l13, #1]

bmul_sem
--------
l1: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ x = enc_bin a $ by ax
l2: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ y = enc_bin b $ by ax
l3: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ z = enc_bin c $ by ax
l4: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ ra_bmul (enc_bin a) (enc_bin b) (enc_bin c) ∈ lrel $ by weaken [#1]
l5: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ ra_bmul x y z ∈ lrel $ by wcel_eq_l [ra_bmul_eq [eq_sym [l1], eq_sym [l2], eq_sym [l3]], l4]
l6: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf' z = nmul (nvf' x) (nvf' y) $ by lrel_bmul_sem [l5]
l7: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf = nvf $ by eq_refl
l8: $ G , x = enc_bin a , y = enc_bin b , z = enc_bin c ⇒ nvf' (enc_bin c) = nmul (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by eq_trans [eq_sym [fv_eq [l7, l3]], eq_trans [l6, nmul_eq [fv_eq [l7, l1], fv_eq [l7, l2]]]]
l9: $ G , x = enc_bin a , y = enc_bin b ⇒ enc_bin c ∈ trees ω $ by enc_bin_trees
l10: $ G , x = enc_bin a , y = enc_bin b ⇒ isset (enc_bin c) $ by wcel_isset [l9]
l11: $ G , x = enc_bin a , y = enc_bin b ⇒ nvf' (enc_bin c) = nmul (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l10, l8]
l12: $ G , x = enc_bin a ⇒ enc_bin b ∈ trees ω $ by enc_bin_trees
l13: $ G , x = enc_bin a ⇒ isset (enc_bin b) $ by wcel_isset [l12]
l14: $ G , x = enc_bin a ⇒ nvf' (enc_bin c) = nmul (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l13, l11]
l15: $ G ⇒ enc_bin a ∈ trees ω $ by enc_bin_trees
l16: $ G ⇒ isset (enc_bin a) $ by wcel_isset [l15]
l17: $ G ⇒ nvf' (enc_bin c) = nmul (nvf' (enc_bin a)) (nvf' (enc_bin b)) $ by isset_elim [l16, l14]

def f195_bpow_q  (.y .a .c: set): class = $ {y | ∀ a ∀ c (ra_bpow a y c ∈ lrel → nvf' c = npow (nvf' a) (nvf' y))} $

lemma f195_bpow_e (G: hyps)  (ty va vc: set): $ G ⇒ ty ∊ f195_bpow_q  $ > $ G ⇒ ra_bpow va ty vc ∈ lrel $ > $ G ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $
----
l1: $ G ⇒ ∀ a ∀ c (ra_bpow a ty c ∈ lrel → nvf' c = npow (nvf' a) (nvf' ty)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ c (ra_bpow va ty c ∈ lrel → nvf' c = npow (nvf' va) (nvf' ty)) $ by all_elim [l1]
l3: $ G ⇒ ra_bpow va ty vc ∈ lrel → nvf' vc = npow (nvf' va) (nvf' ty) $ by all_elim [l2]
l4: $ G ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by imp_elim [l3, #2]

lemma f195_bpow_n (G: hyps)  (ty k1 j1 va vc: set): $ G ⇒ crn j1 ⊆ f195_bpow_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_bpow va ty vc ∈ lrel $ > $ G ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $
----
l1: $ G ⇒ ra_bpow va ty vc ∈ lrel $ by weaken [#5]
l2: $ G ⇒ ∃ x1 (va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (va = x1 ∧ ty = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x5 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ∧ ra_bmul x4 x1 x5 ∈ lrel) $ by lrel_bpow_cases [l1]
l3: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by ax
l4: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ va = x1 $ by and_elim_l [l3]
l5: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ty = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [and_elim_r [l3]]
l6: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by and_elim_r [and_elim_r [l3]]
l7: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l8: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l9: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' ty = ∅ $ by eq_trans [fv_eq [l7, l5], l8]
l10: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ isset ω $ by omega_set
l11: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ kc_b0 ∈ ω $ by kc_b0_omega
l12: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l13: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ⟨ kc_b0 , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l10, l11, l12]
l14: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ = suc (ndbl (nvf' ⟨ kc_b0 , ∅ ⟩)) $ by nvf_bd1 [l13]
l15: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ndbl ∅ = ∅ $ by ndbl_zero
l16: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ ndbl (nvf' ⟨ kc_b0 , ∅ ⟩) = ∅ $ by eq_trans [ndbl_eq [l8], l15]
l17: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' vc = suc ∅ $ by eq_trans [fv_eq [l7, l6], eq_trans [l14, suc_eq [l16]]]
l18: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ , p = nvf' va ⇒ p = nvf' va $ by ax
l19: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ , p = nvf' va ⇒ npow p ∅ = suc ∅ $ by npow_zero
l20: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ , p = nvf' va ⇒ nvf' vc = suc ∅ $ by weaken [l17]
l21: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ , p = nvf' va ⇒ nvf' ty = ∅ $ by weaken [l9]
l22: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ , p = nvf' va ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by eq_trans [l20, eq_sym [eq_trans [npow_eq [eq_sym [l18], l21], l19]]]
l23: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ isset va $ by isset_var
l24: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ isset (nvf' va) $ by wcel_isset [nvf_omega [l23]]
l25: $ G , va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by isset_elim [l24, l22]
l26: $ G , ∃ x1 (va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ⇒ ∃ x1 (va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $ by ax
l27: $ … ⇒ nvf' vc = npow (nvf' va) (nvf' ty) $ by ex_elim [l26, l25]
l28: $ G ⇒ (∃ x1 (va = x1 ∧ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩)) → nvf' vc = npow (nvf' va) (nvf' ty) $ by imp_intro [l27]
l29: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel $ by ax
l30: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ va = x1 $ by and_elim_l [l29]
l31: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ $ by and_elim_l [and_elim_r [l29]]
l32: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ vc = x4 $ by and_elim_l [and_elim_r [and_elim_r [l29]]]
l33: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l34: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ ra_bpow x1 x2 x3 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l29]]]]
l35: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ ⟨ kr_bpow , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [l34]
l36: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ isset ∅ $ by ax_empty
l37: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ isset (scons x3 ∅) $ by scons_set [l36]
l38: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ isset (scons x2 (scons x3 ∅)) $ by scons_set [l37]
l39: $ G , va = x1 ∧ ty = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bpow x1 x2 x3 ∈ lrel ∧ ra_bmul x3 x3 x4 ∈ lrel ⇒ isset (scons x1 (scons x2 (scons x3 ∅))) $ by scons_set [l38]
