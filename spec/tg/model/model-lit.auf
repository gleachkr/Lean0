l428: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) ⇒ ra_band a b c ∈ lrel → nvf' a = x7 → ap (ap F (nnf' x7)) (nnf' nvf' b) = nnf' nvf' c $ by imp_intro [l427]
l429: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) ⇒ ∀ c (ra_band a b c ∈ lrel → nvf' a = x7 → ap (ap F (nnf' x7)) (nnf' nvf' b) = nnf' nvf' c) $ by all_intro [l428]
