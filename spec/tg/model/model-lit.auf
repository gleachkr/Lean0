l303: $ … ⇒ cpi yy2 (dt u (mcv H) (enc_expr (nat_ty)) w (scons yy0 t)) (dt u (mcv H) (enc_expr (pi (app (app (ind_ty le_D nz) (bvar n1)) (bvar nz)) (Prop))) w (scons yy2 (scons yy0 t))) = cpi yy2 nnat (dt u (mcv H) (enc_expr (pi (app (app (ind_ty le_D nz) (bvar n1)) (bvar nz)) (Prop))) w (scons yy2 (scons yy0 t))) $ by cpi_eq_dom [l32]
