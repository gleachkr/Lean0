l187: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_elim_imp [l145, l186]
l188: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_elim_imp [l104, l187]
l189: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_elim_imp [l64, l188]
l190: $ … ⇒ (∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_elim_imp [l25, l189]
l191: $ … ⇒ (∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2) ∨ ∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_elim_imp [l13, l190]
l192: $ G ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by imp_elim [l191, l2]

def f210_bxor_q  (.y .b .c: set): class = $ {y | ∀ b ∀ c (ra_bxor y b c ∈ lrel → (nvf' y = ∅ → nvf' c = nvf' b) ∧ (nvf' b = ∅ → nvf' c = nvf' y))} $

lemma f210_bxor_e (G: hyps)  (ty vb vc: set): $ G ⇒ ty ∊ f210_bxor_q  $ > $ G ⇒ ra_bxor ty vb vc ∈ lrel $ > $ G ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $
----
l1: $ G ⇒ ∀ b ∀ c (ra_bxor ty b c ∈ lrel → (nvf' ty = ∅ → nvf' c = nvf' b) ∧ (nvf' b = ∅ → nvf' c = nvf' ty)) $ by cab_elim [#1]
l2: $ … ⇒ ∀ c (ra_bxor ty vb c ∈ lrel → (nvf' ty = ∅ → nvf' c = nvf' vb) ∧ (nvf' vb = ∅ → nvf' c = nvf' ty)) $ by all_elim [l1]
l3: $ … ⇒ ra_bxor ty vb vc ∈ lrel → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by all_elim [l2]
l4: $ G ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by imp_elim [l3, #2]

lemma f210_bxor_n (G: hyps)  (ty k1 j1 vb vc: set): $ G ⇒ crn j1 ⊆ f210_bxor_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_bxor ty vb vc ∈ lrel $ > $ G ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $
----
l1: $ G ⇒ ra_bxor ty vb vc ∈ lrel $ by weaken [#5]
l2: $ … ⇒ ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2) ∨ ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bxor x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bxor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bxor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bxor x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) $ by lrel_bxor_cases [l1]
l3: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 $ by ax
l4: $ … ⇒ ty = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ vb = x2 $ by and_elim_l [and_elim_r [l3]]
l6: $ … ⇒ vc = x2 $ by and_elim_r [and_elim_r [l3]]
l7: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf = nvf $ by eq_refl
l8: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l9: $ … ⇒ nvf' ty = ∅ $ by eq_trans [fv_eq [l7, l4], l8]
l10: $ … ⇒ nvf' vc = nvf' vb $ by fv_eq [l7, eq_trans [l6, eq_sym [l5]]]
l11: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 , nvf' ty = ∅ ⇒ nvf' ty = ∅ $ by ax
l12: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 , nvf' ty = ∅ ⇒ nvf' vc = nvf' vb $ by weaken [l10]
l13: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf' ty = ∅ → nvf' vc = nvf' vb $ by imp_intro [l12]
l14: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 , nvf' vb = ∅ ⇒ nvf' vb = ∅ $ by ax
l15: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 , nvf' vb = ∅ ⇒ nvf' vc = nvf' vb $ by weaken [l10]
l16: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 , nvf' vb = ∅ ⇒ nvf' ty = ∅ $ by weaken [l9]
l17: $ … ⇒ nvf' vc = nvf' ty $ by eq_trans [l15, eq_trans [l14, eq_sym [l16]]]
l18: $ G , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf' vb = ∅ → nvf' vc = nvf' ty $ by imp_intro [l17]
l19: $ … ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by and_intro [l13, l18]
l20: $ G , ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2) ⇒ ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2) $ by ax
l21: $ … ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by ex_elim [l20, l19]
l22: $ G ⇒ (∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2)) → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by imp_intro [l21]
l23: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 $ by ax
l24: $ … ⇒ ty = x1 $ by and_elim_l [l23]
l25: $ … ⇒ vb = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [and_elim_r [l23]]
l26: $ … ⇒ vc = x1 $ by and_elim_r [and_elim_r [l23]]
l27: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ nvf = nvf $ by eq_refl
l28: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l29: $ … ⇒ nvf' vb = ∅ $ by eq_trans [fv_eq [l27, l25], l28]
l30: $ … ⇒ nvf' vc = nvf' ty $ by fv_eq [l27, eq_trans [l26, eq_sym [l24]]]
l31: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 , nvf' ty = ∅ ⇒ nvf' ty = ∅ $ by ax
l32: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 , nvf' ty = ∅ ⇒ nvf' vc = nvf' ty $ by weaken [l30]
l33: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 , nvf' ty = ∅ ⇒ nvf' vb = ∅ $ by weaken [l29]
l34: $ … ⇒ nvf' vc = nvf' vb $ by eq_trans [l32, eq_trans [l31, eq_sym [l33]]]
l35: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ nvf' ty = ∅ → nvf' vc = nvf' vb $ by imp_intro [l34]
l36: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 , nvf' vb = ∅ ⇒ nvf' vb = ∅ $ by ax
l37: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 , nvf' vb = ∅ ⇒ nvf' vc = nvf' ty $ by weaken [l30]
l38: $ G , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ nvf' vb = ∅ → nvf' vc = nvf' ty $ by imp_intro [l37]
l39: $ … ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by and_intro [l35, l38]
l40: $ G , ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1) ⇒ ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1) $ by ax
l41: $ … ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by ex_elim [l40, l39]
l42: $ G ⇒ (∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1)) → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by imp_intro [l41]
l43: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bxor x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bxor x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel $ by ax
l44: $ … ⇒ ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ $ by and_elim_l [l43]
l45: $ … ⇒ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ $ by and_elim_l [and_elim_r [l43]]
l46: $ … ⇒ vc = x4 $ by and_elim_l [and_elim_r [and_elim_r [l43]]]
l47: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bxor x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l48: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bxor x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l49: $ … ⇒ ra_bxor x1 x2 x3 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l43]]]]
l50: $ … ⇒ ⟨ kr_bxor , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [l49]
l51: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bxor x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ isset ∅ $ by ax_empty
l52: $ … ⇒ isset (scons x3 ∅) $ by scons_set [l51]
l53: $ … ⇒ isset (scons x2 (scons x3 ∅)) $ by scons_set [l52]
l54: $ … ⇒ isset (scons x1 (scons x2 (scons x3 ∅))) $ by scons_set [l53]
l55: $ G , ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_bxor x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ kr_bxor ∈ ω $ by kr_bxor_omega
