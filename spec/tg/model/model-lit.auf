l17: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ nnf' nvf' (enc_bin b0) = nzr $ by eq_trans [fv_eq [l15, l14], l16]
l18: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ dt u (mcv H) (enc_expr (ind_ctor nat_D nz nz)) w t = nzr $ by dt_nat_zero [l8, l1, l7, l6]
l19: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ dt u (mcv H) (enc_expr (lit b0)) w t = nzr $ by eq_trans [l13, l17]
l20: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ dt u (mcv H) (enc_expr (lit b0)) w t = dt u (mcv H) (enc_expr (ind_ctor nat_D nz nz)) w t $ by eq_trans [l19, eq_sym [l18]]
l21: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ nzr ∈ nnat $ by nnat_zero
