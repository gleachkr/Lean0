l325: $ G , ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel) $ by ax
l326: $ … ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by ex_elim [l325, l324]
l327: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by imp_intro [l326]
l328: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by or_elim_imp [l264, l327]
l329: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by or_elim_imp [l191, l328]
l330: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by or_elim_imp [l118, l329]
l331: $ … ⇒ (∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by or_elim_imp [l38, l330]
l332: $ … ⇒ (∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by or_elim_imp [l20, l331]
l333: $ G ⇒ (nvf' ty = ∅ → nvf' vc = ∅) ∧ (nvf' vb = ∅ → nvf' vc = ∅) $ by imp_elim [l332, l2]

lemma f210_band_all (G: hyps) : $ G ⇒ trees ω ⊆ f210_band_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ , ra_band y b c ∈ lrel ⇒ crn x9 ⊆ f210_band_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ , ra_band y b c ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ , ra_band y b c ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ , ra_band y b c ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ , ra_band y b c ∈ lrel ⇒ ra_band y b c ∈ lrel $ by ax
l6: $ … ⇒ (nvf' y = ∅ → nvf' c = ∅) ∧ (nvf' b = ∅ → nvf' c = ∅) $ by f210_band_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_band y b c ∈ lrel → (nvf' y = ∅ → nvf' c = ∅) ∧ (nvf' b = ∅ → nvf' c = ∅) $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c (ra_band y b c ∈ lrel → (nvf' y = ∅ → nvf' c = ∅) ∧ (nvf' b = ∅ → nvf' c = ∅)) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ b ∀ c (ra_band y b c ∈ lrel → (nvf' y = ∅ → nvf' c = ∅) ∧ (nvf' b = ∅ → nvf' c = ∅)) $ by all_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f210_band_q  $ by cab_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l12: $ … ⇒ ⟨ x8 , x9 ⟩ ∈ f210_band_q  $ by wcel_intro [l11, l10]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_band_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f210_band_q  $ by isset_elim [l13, l12]
l15: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f210_band_q  → ⟨ x8 , x9 ⟩ ∈ f210_band_q  $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f210_band_q  → ⟨ x8 , x9 ⟩ ∈ f210_band_q ) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f210_band_q  $ by trees_ind_c [l17, l16]

lrel_band_zero
--------------
l1: $ G ⇒ trees ω ⊆ f210_band_q  $ by f210_band_all
l2: $ G ⇒ ⟨ kr_band , scons t1 (scons t2 (scons t3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ … ⇒ isset (scons t3 ∅) $ by scons_set [l3]
l5: $ … ⇒ isset (scons t2 (scons t3 ∅)) $ by scons_set [l4]
l6: $ … ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_band ∈ ω $ by kr_band_omega
l8: $ … ⇒ kr_band ∈ ω ∧ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ … ⇒ crn (scons t1 (scons t2 (scons t3 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ … ⇒ t1 ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ … ⇒ t1 ∊ f210_band_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ (nvf' t1 = ∅ → nvf' t3 = ∅) ∧ (nvf' t2 = ∅ → nvf' t3 = ∅) $ by f210_band_e [l12, #1]

lrel_band_digits
----------------
l1: $ G ⇒ ra_band t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ … ⇒ ∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_band x1 x2 x3 ∈ lrel) $ by lrel_band_cases [l1]
l3: $ G , t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = ⟨ kc_b0 , ∅ ⟩ ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = ⟨ kc_b0 , ∅ ⟩ $ by ax
l4: $ … ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ t2 = x2 $ by and_elim_l [and_elim_r [l3]]
l6: $ … ⇒ t3 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_r [and_elim_r [l3]]
l7: $ G , t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l8: $ G , t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l9: $ … ⇒ nvf' t1 = ∅ $ by eq_trans [fv_eq [l7, l4], l8]
l10: $ … ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_intro_l [l9]
l11: $ G , ∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = ⟨ kc_b0 , ∅ ⟩) ⇒ ∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by ax
l12: $ … ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by ex_elim [l11, l10]
l13: $ G ⇒ (∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = ⟨ kc_b0 , ∅ ⟩)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by imp_intro [l12]
l14: $ G , t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩ ⇒ t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩ $ by ax
l15: $ … ⇒ t1 = x1 $ by and_elim_l [l14]
l16: $ … ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [and_elim_r [l14]]
l17: $ … ⇒ t3 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_r [and_elim_r [l14]]
l18: $ G , t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l19: $ G , t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩ ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l20: $ … ⇒ nvf' t2 = ∅ $ by eq_trans [fv_eq [l18, l16], l19]
l21: $ … ⇒ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_intro_l [l20]
l22: $ … ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_intro_r [l21]
l23: $ G , ∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) ⇒ ∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by ax
l24: $ … ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by ex_elim [l23, l22]
l25: $ G ⇒ (∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by imp_intro [l24]
l26: $ G , t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel ⇒ t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = x4 ∧ ra_band x1 x2 x3 ∈ lrel ∧ ra_bdbl x3 x4 ∈ lrel $ by ax
