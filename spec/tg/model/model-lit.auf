lemma fs1_d0 (G: hyps): $ G ⇒ ndiv ∅ two = ∅ $
----
l1: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ e = ∅ $ by ax
l2: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ o = suc e $ by ax
l3: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ ∅ ∈ ω $ by omega_zero
l4: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ e ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l1], l3]]
l5: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ o ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l2], omega_suc [l4]]]
l6: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ ndbl ∅ = ∅ $ by ndbl_zero
l7: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ ndbl e = ∅ $ by eq_trans [ndbl_eq [l1], l6]
l8: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ o = suc ∅ $ by eq_trans [l2, suc_eq [l1]]
l9: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ two = suc (suc ∅) $ by two_eq_suc
l10: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ ndbl o = two $ by eq_trans [ndbl_eq [l2], eq_trans [ndbl_suc [l4], eq_trans [suc_eq [suc_eq [l7]], eq_sym [l9]]]]
l11: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ two = two $ by eq_refl
l12: $ G , j = two , e = ∅ , o = suc e , j ∊ ω , e ∊ j , o ∊ j ⇒ ndiv ∅ two = ∅ $ by eq_trans [ndiv_eq [eq_sym [l7], l11], eq_trans [ndiv_dbl_two [l4], l1]]
l13: $ G ⇒ ndiv ∅ two = ∅ $ by two_names [l12]

lemma fs1_d1 (G: hyps): $ G ⇒ ndiv (suc ∅) two = ∅ $
