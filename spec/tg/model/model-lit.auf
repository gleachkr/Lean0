l509: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ dt u (mcv H) (enc_expr (app (fp) (app (app (f) (bvar n1)) (bvar nz)))) w (scons y (scons x t)) = ap (dt u (mcv H) (enc_expr (fp)) w t) (ap (ap (dt u (mcv H) (enc_expr (f)) w t) x) y) $ by eq_trans [l438, ap_eq [l507, l502]]
