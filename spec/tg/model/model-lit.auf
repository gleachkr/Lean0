lemma fs1_or_z2 {x3 x4 q: set} (G: hyps) (F: class): $ G ⇒ ∀ x3 (x3 ∊ ω → ∀ x4 (x4 ∊ ω → ∃ q (q ∊ ω ∧ ap (ap F (nnf' (ndiv x3 two))) (nnf' (ndiv x4 two)) = nnf' q ∧ ap (ap F (nnf' x3)) (nnf' x4) = nnf' (nadd (nadd q q) (ndiv (nadd (nadd (nmod x3 two) (nmod x4 two)) (suc ∅)) two))))) $ > $ G ⇒ ∀ x3 (x3 ∊ ω → ap (ap F (nnf' x3)) (nnf' ∅) = nnf' x3) $
