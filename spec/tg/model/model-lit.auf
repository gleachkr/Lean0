l29: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d , x9 = ∅ ⇒ x9 ∊ nlev p (nsc m) $ by cab_intro [and_intro [l27, l28]]
l30: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d , x9 = ∅ ⇒ ∅ ∈ nlev p (nsc m) $ by wcel_eq_l [l27, welc_wcel [l29]]
l31: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ isset ∅ $ by ax_empty
l32: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ ∅ ∈ nlev p (nsc m) $ by isset_elim [l31, l30]
l33: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ isset d $ by isset_var
l34: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ isset (suc d) $ by suc_set [l33]
l35: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d ⇒ ∅ ∈ nlev p (nsc m) $ by isset_elim [l34, l32]
l36: $ G , ∃ d (c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d) ⇒ ∃ d (c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d) $ by ax
l37: $ … ⇒ ∅ ∈ nlev p (nsc m) $ by ex_elim [l36, l35]
l38: $ G ⇒ ∅ ∈ nlev p (nsc m) $ by ex_elim [l2, l37]

lemma fs1_lr (G: hyps) (p a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ p = nnf' a $ > $ G ⇒ ∅ ∈ nlev p p $
----
l1: $ G ⇒ a ⊆ a $ by subset_refl
l2: $ G ⇒ p = nnf' a ∧ a ⊆ a $ by and_intro [#2, l1]
l3: $ G ⇒ p = nnf' a ∧ p = nnf' a ∧ a ⊆ a $ by and_intro [#2, l2]
l4: $ G ⇒ a ∊ ω ∧ p = nnf' a ∧ p = nnf' a ∧ a ⊆ a $ by and_intro [#1, l3]
l5: $ G ⇒ a ∊ ω ∧ a ∊ ω ∧ p = nnf' a ∧ p = nnf' a ∧ a ⊆ a $ by and_intro [#1, l4]
l6: $ G ⇒ ∃ d (a ∊ ω ∧ d ∊ ω ∧ p = nnf' a ∧ p = nnf' d ∧ a ⊆ d) $ by ex_intro [l5]
l7: $ G ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ p = nnf' d ∧ c ⊆ d) $ by ex_intro [l6]
l8: $ G , x9 = ∅ ⇒ x9 = ∅ $ by ax
l9: $ G , x9 = ∅ ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ p = nnf' d ∧ c ⊆ d) $ by weaken [l7]
l10: $ G , x9 = ∅ ⇒ x9 ∊ nlev p p $ by cab_intro [and_intro [l8, l9]]
l11: $ G , x9 = ∅ ⇒ ∅ ∈ nlev p p $ by wcel_eq_l [l8, welc_wcel [l10]]
l12: $ G ⇒ isset ∅ $ by ax_empty
l13: $ G ⇒ ∅ ∈ nlev p p $ by isset_elim [l12, l11]

