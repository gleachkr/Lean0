l23: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b , nvf' a = ∅ ⇒ nnf = nnf $ by eq_refl
