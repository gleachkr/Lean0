l307: $ … ⇒ dt u (mcv H) (enc_expr (pi (nat_ty) (pi (app (app (ind_ty le_D nz) (bvar n1)) (bvar nz)) (Prop)))) w (scons yy0 t) = cpi yy2 nnat (cpi yy3 (ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w t) yy0) yy2) (uni' ∅)) $ by eq_trans [l230, eq_trans [l303, l306]]
