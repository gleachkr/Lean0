lemma fs1_dm {x5 x6: set} (H: class) (G: ctx) (fd fm fmul fadd: expr) (u w t: set): $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ divmod_eqs_j (jmod (mcv H)) G fd fm fmul fadd $ > $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ (∀ x5 (x5 ∊ ω → ∀ x6 (x6 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (fd)) w t) (nnf' x5)) (nnf' x6) = nnf' (ndiv x5 x6)))) ∧ (∀ x5 (x5 ∊ ω → ∀ x6 (x6 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (fm)) w t) (nnf' x5)) (nnf' x6) = nnf' (nmod x5 x6)))) $
