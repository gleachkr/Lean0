bdbl_sem
--------
l1: $ G , x = enc_bin a , y = enc_bin b ⇒ x = enc_bin a $ by ax
l2: $ G , x = enc_bin a , y = enc_bin b ⇒ y = enc_bin b $ by ax
l3: $ G , x = enc_bin a , y = enc_bin b ⇒ ra_bdbl (enc_bin a) (enc_bin b) ∈ lrel $ by weaken [#1]
l4: $ G , x = enc_bin a , y = enc_bin b ⇒ ra_bdbl x y ∈ lrel $ by wcel_eq_l [ra_bdbl_eq [eq_sym [l1], eq_sym [l2]], l3]
l5: $ G , x = enc_bin a , y = enc_bin b ⇒ nvf' y = ndbl (nvf' x) $ by lrel_bdbl_sem [l4]
l6: $ G , x = enc_bin a , y = enc_bin b ⇒ nvf = nvf $ by eq_refl
l7: $ G , x = enc_bin a , y = enc_bin b ⇒ nvf' (enc_bin b) = ndbl (nvf' (enc_bin a)) $ by eq_trans [eq_sym [fv_eq [l6, l2]], eq_trans [l5, ndbl_eq [fv_eq [l6, l1]]]]
l8: $ G , x = enc_bin a ⇒ enc_bin b ∈ trees ω $ by enc_bin_trees
l9: $ G , x = enc_bin a ⇒ isset (enc_bin b) $ by wcel_isset [l8]
l10: $ G , x = enc_bin a ⇒ nvf' (enc_bin b) = ndbl (nvf' (enc_bin a)) $ by isset_elim [l9, l7]
l11: $ G ⇒ enc_bin a ∈ trees ω $ by enc_bin_trees
l12: $ G ⇒ isset (enc_bin a) $ by wcel_isset [l11]
l13: $ G ⇒ nvf' (enc_bin b) = ndbl (nvf' (enc_bin a)) $ by isset_elim [l12, l10]

def f194_ba_q  (.y .b .c: set): class = $ {y | ∀ b ∀ c (y = y → (ra_badd y b c ∈ lrel → nvf' c = nadd (nvf' y) (nvf' b)) ∧ (ra_baddc y b c ∈ lrel → nvf' c = suc (nadd (nvf' y) (nvf' b))))} $

lemma f194_ba_e (G: hyps)  (ty vb vc: set): $ G ⇒ ty ∊ f194_ba_q  $ > $ G ⇒ ty = ty $ > $ G ⇒ (ra_badd ty vb vc ∈ lrel → nvf' vc = nadd (nvf' ty) (nvf' vb)) ∧ (ra_baddc ty vb vc ∈ lrel → nvf' vc = suc (nadd (nvf' ty) (nvf' vb))) $
----
l1: $ G ⇒ ∀ b ∀ c (ty = ty → (ra_badd ty b c ∈ lrel → nvf' c = nadd (nvf' ty) (nvf' b)) ∧ (ra_baddc ty b c ∈ lrel → nvf' c = suc (nadd (nvf' ty) (nvf' b)))) $ by cab_elim [#1]
l2: $ G ⇒ ∀ c (ty = ty → (ra_badd ty vb c ∈ lrel → nvf' c = nadd (nvf' ty) (nvf' vb)) ∧ (ra_baddc ty vb c ∈ lrel → nvf' c = suc (nadd (nvf' ty) (nvf' vb)))) $ by all_elim [l1]
l3: $ G ⇒ ty = ty → (ra_badd ty vb vc ∈ lrel → nvf' vc = nadd (nvf' ty) (nvf' vb)) ∧ (ra_baddc ty vb vc ∈ lrel → nvf' vc = suc (nadd (nvf' ty) (nvf' vb))) $ by all_elim [l2]
l4: $ G ⇒ (ra_badd ty vb vc ∈ lrel → nvf' vc = nadd (nvf' ty) (nvf' vb)) ∧ (ra_baddc ty vb vc ∈ lrel → nvf' vc = suc (nadd (nvf' ty) (nvf' vb))) $ by imp_elim [l3, #2]

lemma f194_ba_n (G: hyps)  (ty k1 j1 vb vc: set): $ G ⇒ crn j1 ⊆ f194_ba_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ty = ty $ > $ G ⇒ (ra_badd ty vb vc ∈ lrel → nvf' vc = nadd (nvf' ty) (nvf' vb)) ∧ (ra_baddc ty vb vc ∈ lrel → nvf' vc = suc (nadd (nvf' ty) (nvf' vb))) $
----
l1: $ G , ra_badd ty vb vc ∈ lrel ⇒ ra_badd ty vb vc ∈ lrel $ by ax
l2: $ G , ra_badd ty vb vc ∈ lrel ⇒ ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2) ∨ ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel) $ by lrel_badd_cases [l1]
l3: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 $ by ax
l4: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ ty = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l3]
l5: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ vb = x2 $ by and_elim_l [and_elim_r [l3]]
l6: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ vc = x2 $ by and_elim_r [and_elim_r [l3]]
l7: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf = nvf $ by eq_refl
l8: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l9: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf' ty = ∅ $ by eq_trans [fv_eq [l7, l4], l8]
l10: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf' vb = nvf' vb $ by eq_refl
l11: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ ∅ ∈ ω $ by omega_zero
l12: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ isset vb $ by isset_var
l13: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ isset vb $ by isset_var
l14: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nadd (nvf' ty) (nvf' vb) = nvf' vb $ by eq_trans [nadd_eq [l9, l10], eq_trans [nadd_comm_c [l11, nvf_omega [l12]], nadd_zero_c [wcel_isset [nvf_omega [l13]]]]]
l15: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ vc = vb $ by eq_trans [l6, eq_sym [l5]]
l16: $ G , ra_badd ty vb vc ∈ lrel , ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2 ⇒ nvf' vc = nadd (nvf' ty) (nvf' vb) $ by eq_trans [fv_eq [l7, l15], eq_sym [l14]]
l17: $ G , ra_badd ty vb vc ∈ lrel , ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2) ⇒ ∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2) $ by ax
l18: $ … ⇒ nvf' vc = nadd (nvf' ty) (nvf' vb) $ by ex_elim [l17, l16]
l19: $ G , ra_badd ty vb vc ∈ lrel ⇒ (∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2)) → nvf' vc = nadd (nvf' ty) (nvf' vb) $ by imp_intro [l18]
l20: $ G , ra_badd ty vb vc ∈ lrel , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 $ by ax
l21: $ G , ra_badd ty vb vc ∈ lrel , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ ty = x1 $ by and_elim_l [l20]
l22: $ G , ra_badd ty vb vc ∈ lrel , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ vb = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [and_elim_r [l20]]
l23: $ G , ra_badd ty vb vc ∈ lrel , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ vc = x1 $ by and_elim_r [and_elim_r [l20]]
l24: $ G , ra_badd ty vb vc ∈ lrel , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ nvf = nvf $ by eq_refl
l25: $ G , ra_badd ty vb vc ∈ lrel , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l26: $ G , ra_badd ty vb vc ∈ lrel , ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1 ⇒ nvf' vb = ∅ $ by eq_trans [fv_eq [l24, l22], l25]
