l528: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x5 ∊ ω , x6 ∊ ω , p = nnf' x5 , z = ∅ ⇒ ap (ap (dt u (mcv H) (enc_expr (f)) w t) p) nzr = p $ by imp_elim [l527, l525]
l529: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x5 ∊ ω , x6 ∊ ω , p = nnf' x5 , z = ∅ ⇒ p = nnf' x5 $ by weaken [l518]
l530: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x5 ∊ ω , x6 ∊ ω , p = nnf' x5 , z = ∅ ⇒ nsub x5 ∅ = x5 $ by nsub_zero
l531: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x5 ∊ ω , x6 ∊ ω , p = nnf' x5 , z = ∅ ⇒ ap (ap (dt u (mcv H) (enc_expr (f)) w t) p) nzr = nnf' (nsub x5 ∅) $ by eq_trans [l528, eq_trans [l529, fv_eq [l522, eq_sym [l530]]]]
