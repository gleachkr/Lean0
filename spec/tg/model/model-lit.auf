l320: $ G , ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) $ by ax
l321: $ … ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by ex_elim [l320, l319]
l322: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by imp_intro [l321]
l323: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by or_elim_imp [l259, l322]
l324: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by or_elim_imp [l189, l323]
l325: $ … ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by or_elim_imp [l119, l324]
l326: $ … ⇒ (∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by or_elim_imp [l42, l325]
l327: $ … ⇒ (∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2) ∨ ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel)) → (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by or_elim_imp [l22, l326]
l328: $ G ⇒ (nvf' ty = ∅ → nvf' vc = nvf' vb) ∧ (nvf' vb = ∅ → nvf' vc = nvf' ty) $ by imp_elim [l327, l2]

lemma f210_bor_all (G: hyps) : $ G ⇒ trees ω ⊆ f210_bor_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ , ra_bor y b c ∈ lrel ⇒ crn x9 ⊆ f210_bor_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ , ra_bor y b c ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ , ra_bor y b c ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ , ra_bor y b c ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ , ra_bor y b c ∈ lrel ⇒ ra_bor y b c ∈ lrel $ by ax
l6: $ … ⇒ (nvf' y = ∅ → nvf' c = nvf' b) ∧ (nvf' b = ∅ → nvf' c = nvf' y) $ by f210_bor_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_bor y b c ∈ lrel → (nvf' y = ∅ → nvf' c = nvf' b) ∧ (nvf' b = ∅ → nvf' c = nvf' y) $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c (ra_bor y b c ∈ lrel → (nvf' y = ∅ → nvf' c = nvf' b) ∧ (nvf' b = ∅ → nvf' c = nvf' y)) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ b ∀ c (ra_bor y b c ∈ lrel → (nvf' y = ∅ → nvf' c = nvf' b) ∧ (nvf' b = ∅ → nvf' c = nvf' y)) $ by all_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f210_bor_q  $ by cab_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l12: $ … ⇒ ⟨ x8 , x9 ⟩ ∈ f210_bor_q  $ by wcel_intro [l11, l10]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f210_bor_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f210_bor_q  $ by isset_elim [l13, l12]
l15: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f210_bor_q  → ⟨ x8 , x9 ⟩ ∈ f210_bor_q  $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f210_bor_q  → ⟨ x8 , x9 ⟩ ∈ f210_bor_q ) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f210_bor_q  $ by trees_ind_c [l17, l16]

lrel_bor_zero
-------------
l1: $ G ⇒ trees ω ⊆ f210_bor_q  $ by f210_bor_all
l2: $ G ⇒ ⟨ kr_bor , scons t1 (scons t2 (scons t3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ … ⇒ isset (scons t3 ∅) $ by scons_set [l3]
l5: $ … ⇒ isset (scons t2 (scons t3 ∅)) $ by scons_set [l4]
l6: $ … ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_bor ∈ ω $ by kr_bor_omega
l8: $ … ⇒ kr_bor ∈ ω ∧ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ … ⇒ crn (scons t1 (scons t2 (scons t3 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ … ⇒ t1 ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ … ⇒ t1 ∊ f210_bor_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ (nvf' t1 = ∅ → nvf' t3 = nvf' t2) ∧ (nvf' t2 = ∅ → nvf' t3 = nvf' t1) $ by f210_bor_e [l12, #1]

lrel_bor_digits
---------------
l1: $ G ⇒ ra_bor t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ … ⇒ ∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2) ∨ ∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bor x1 x2 x3 ∈ lrel) $ by lrel_bor_cases [l1]
l3: $ G , t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2 ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2 $ by ax
l4: $ … ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ t2 = x2 $ by and_elim_l [and_elim_r [l3]]
l6: $ … ⇒ t3 = x2 $ by and_elim_r [and_elim_r [l3]]
l7: $ G , t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2 ⇒ nvf = nvf $ by eq_refl
l8: $ G , t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2 ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l9: $ … ⇒ nvf' t1 = ∅ $ by eq_trans [fv_eq [l7, l4], l8]
l10: $ … ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_intro_l [l9]
l11: $ G , ∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2) ⇒ ∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2) $ by ax
l12: $ … ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by ex_elim [l11, l10]
l13: $ G ⇒ (∃ x2 (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = x2 ∧ t3 = x2)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by imp_intro [l12]
l14: $ G , t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1 ⇒ t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1 $ by ax
l15: $ … ⇒ t1 = x1 $ by and_elim_l [l14]
l16: $ … ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [and_elim_r [l14]]
l17: $ … ⇒ t3 = x1 $ by and_elim_r [and_elim_r [l14]]
l18: $ G , t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1 ⇒ nvf = nvf $ by eq_refl
l19: $ G , t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1 ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by nvf_b0
l20: $ … ⇒ nvf' t2 = ∅ $ by eq_trans [fv_eq [l18, l16], l19]
l21: $ … ⇒ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_intro_l [l20]
l22: $ … ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by or_intro_r [l21]
l23: $ G , ∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1) ⇒ ∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1) $ by ax
l24: $ … ⇒ nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by ex_elim [l23, l22]
l25: $ G ⇒ (∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = x1)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by imp_intro [l24]
