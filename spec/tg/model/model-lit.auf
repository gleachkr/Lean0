lemma f202_two (G: hyps): $ G ⇒ nvf' (enc_bin (bd0 (bd1 b0))) = two $
----
l1: $ G ⇒ enc_bin (bd1 b0) ∈ trees ω $ by enc_bin_trees
l2: $ G ⇒ nvf' (enc_bin (bd0 (bd1 b0))) = ndbl (nvf' (enc_bin (bd1 b0))) $ by nvf_bd0 [l1]
l3: $ G ⇒ enc_bin b0 ∈ trees ω $ by enc_bin_trees
l4: $ G ⇒ nvf' (enc_bin (bd1 b0)) = suc (ndbl (nvf' (enc_bin b0))) $ by nvf_bd1 [l3]
l5: $ G ⇒ nvf' (enc_bin b0) = ∅ $ by nvf_b0
l6: $ G ⇒ ndbl ∅ = ∅ $ by ndbl_zero
l7: $ G ⇒ nvf' (enc_bin (bd1 b0)) = suc ∅ $ by eq_trans [l4, suc_eq [eq_trans [ndbl_eq [l5], l6]]]
l8: $ G ⇒ ∅ ∈ ω $ by omega_zero
l9: $ G ⇒ ndbl ∅ = ∅ $ by ndbl_zero
l10: $ G ⇒ ndbl (suc ∅) = suc (suc ∅) $ by eq_trans [ndbl_suc_c [l8], suc_eq [suc_eq [l9]]]
l11: $ G ⇒ two = suc (suc ∅) $ by two_eq_suc
l12: $ G ⇒ nvf' (enc_bin (bd0 (bd1 b0))) = two $ by eq_trans [l2, eq_trans [ndbl_eq [l7], eq_trans [l10, eq_sym [l11]]]]

