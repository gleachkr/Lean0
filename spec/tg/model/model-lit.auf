l367: $ G , ra_badd ty vb vc ∈ lrel ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = nadd (nvf' ty) (nvf' vb) $ by or_elim_imp [l283, l366]
l368: $ G , ra_badd ty vb vc ∈ lrel ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = nadd (nvf' ty) (nvf' vb) $ by or_elim_imp [l200, l367]
l369: $ G , ra_badd ty vb vc ∈ lrel ⇒ (∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = nadd (nvf' ty) (nvf' vb) $ by or_elim_imp [l117, l368]
l370: $ G , ra_badd ty vb vc ∈ lrel ⇒ (∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = nadd (nvf' ty) (nvf' vb) $ by or_elim_imp [l34, l369]
l371: $ G , ra_badd ty vb vc ∈ lrel ⇒ (∃ x2 (ty = ⟨ kc_b0 , ∅ ⟩ ∧ vb = x2 ∧ vc = x2) ∨ ∃ x1 (ty = x1 ∧ vb = ⟨ kc_b0 , ∅ ⟩ ∧ vc = x1) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_badd x1 x2 x3 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ vb = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ vc = ⟨ kc_bd0 , scons x3 ∅ ⟩ ∧ ra_baddc x1 x2 x3 ∈ lrel)) → nvf' vc = nadd (nvf' ty) (nvf' vb) $ by or_elim_imp [l19, l370]
