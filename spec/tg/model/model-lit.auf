l496: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ w ∈ lvals $ by weaken [l7]
l497: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ t ∈ fseq u $ by weaken [l6]
l498: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ dt u (mcv H) (enc_expr (f)) w (scons y (scons x t)) = dt u (mcv H) (enc_expr (f)) w t $ by closed0_den [s9, l496, l495, l497]
l499: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ dt u (mcv H) (enc_expr (f)) w t ∈ cpi x1 nnat (cpi x2 nnat nnat) $ by weaken [l232]
l500: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ dt u (mcv H) (enc_expr (app (f) (bvar n1))) w (scons y (scons x t)) = ap (dt u (mcv H) (enc_expr (f)) w t) x $ by eq_trans [l467, ap_eq [l498, l492]]
l501: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ ap (dt u (mcv H) (enc_expr (f)) w t) x ∈ cpi x2 nnat nnat $ by f198_ap [l499, l494]
l502: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x ∊ nnat , y ∊ nnat ⇒ dt u (mcv H) (enc_expr (app (app (f) (bvar n1)) (bvar nz))) w (scons y (scons x t)) = ap (ap (dt u (mcv H) (enc_expr (f)) w t) x) y $ by eq_trans [l443, ap_eq [l500, l460]]
