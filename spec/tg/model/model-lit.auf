l93: $ … ⇒ (nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = suc (ndbl (nvf' x2)) ∧ nvf' t3 = suc (ndbl (nvf' x3))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = ndbl (nvf' x2) ∧ nvf' t3 = suc (ndbl (nvf' x3))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = suc (ndbl (nvf' x2)) ∧ nvf' t3 = ndbl (nvf' x3)) $ by or_intro_l [l92]
l94: $ … ⇒ (nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = ndbl (nvf' x2) ∧ nvf' t3 = ndbl (nvf' x3)) ∨ (nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = suc (ndbl (nvf' x2)) ∧ nvf' t3 = suc (ndbl (nvf' x3))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = ndbl (nvf' x2) ∧ nvf' t3 = suc (ndbl (nvf' x3))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = suc (ndbl (nvf' x2)) ∧ nvf' t3 = ndbl (nvf' x3)) $ by or_intro_r [l93]
l95: $ … ⇒ ra_bxor x1 x2 x3 ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = ndbl (nvf' x2) ∧ nvf' t3 = ndbl (nvf' x3)) ∨ (nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = suc (ndbl (nvf' x2)) ∧ nvf' t3 = suc (ndbl (nvf' x3))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = ndbl (nvf' x2) ∧ nvf' t3 = suc (ndbl (nvf' x3))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = suc (ndbl (nvf' x2)) ∧ nvf' t3 = ndbl (nvf' x3))) $ by and_intro [l74, l94]
l96: $ … ⇒ ∃ z (ra_bxor x1 x2 z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = ndbl (nvf' x2) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = suc (ndbl (nvf' x2)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = ndbl (nvf' x2) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = suc (ndbl (nvf' x2)) ∧ nvf' t3 = ndbl (nvf' z)))) $ by ex_intro [l95]
l97: $ … ⇒ ∃ y ∃ z (ra_bxor x1 y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)))) $ by ex_intro [l96]
l98: $ … ⇒ ∃ x ∃ y ∃ z (ra_bxor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)))) $ by ex_intro [l97]
