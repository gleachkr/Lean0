l107: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 (t1 = ⟨ kc_bd0 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bxor x1 x2 x3 ∈ lrel)) → nvf' t1 = ∅ ∨ nvf' t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bxor x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = suc (ndbl (nvf' z))) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)))) $ by imp_intro [l106]
l108: $ G , t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bxor x1 x2 x3 ∈ lrel ⇒ t1 = ⟨ kc_bd1 , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons x2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons x3 ∅ ⟩ ∧ ra_bxor x1 x2 x3 ∈ lrel $ by ax
