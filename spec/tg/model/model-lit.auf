lemma fs1_one (G: hyps): $ G ⇒ nvf' (enc_bin (bd1 b0)) = suc ∅ $
----
l1: $ G ⇒ enc_bin b0 ∈ trees ω $ by enc_bin_trees
l2: $ … ⇒ nvf' (enc_bin (bd1 b0)) = suc (ndbl (nvf' (enc_bin b0))) $ by nvf_bd1 [l1]
l3: $ G ⇒ nvf' (enc_bin b0) = ∅ $ by nvf_b0
l4: $ G ⇒ ndbl ∅ = ∅ $ by ndbl_zero
l5: $ G ⇒ nvf' (enc_bin (bd1 b0)) = suc ∅ $ by eq_trans [l2, suc_eq [eq_trans [ndbl_eq [l3], l4]]]

lemma fs1_tw (G: hyps): $ G ⇒ nvf' (enc_bin (bd0 (bd1 b0))) = two $
----
l1: $ G ⇒ enc_bin (bd1 b0) ∈ trees ω $ by enc_bin_trees
l2: $ … ⇒ nvf' (enc_bin (bd0 (bd1 b0))) = ndbl (nvf' (enc_bin (bd1 b0))) $ by nvf_bd0 [l1]
l3: $ G ⇒ ∅ ∈ ω $ by omega_zero
l4: $ G ⇒ ndbl ∅ = ∅ $ by ndbl_zero
