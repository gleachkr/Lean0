----
h1: $ closed nz (ind_ty (ind_mk le_blk (cons (ind_ty (ind_mk nat_blk nil (tcons (srt (ls lz)) (ccons (bvar nz) (ccons (pi (bvar nz) (bvar (s nz))) cnil)) tnil) nil) nz) nil) (tcons (pi (ind_ty (ind_mk nat_blk nil (tcons (srt (ls lz)) (ccons (bvar nz) (ccons (pi (bvar nz) (bvar (s nz))) cnil)) tnil) nil) nz) (srt lz)) (ccons (app (app (bvar (s nz)) (bvar nz)) (bvar nz)) (ccons (pi (ind_ty (ind_mk nat_blk nil (tcons (srt (ls lz)) (ccons (bvar nz) (ccons (pi (bvar nz) (bvar (s nz))) cnil)) tnil) nil) nz) (pi (app (app (bvar (s (s nz))) (bvar (s nz))) (bvar nz)) (app (app (bvar (s (s (s nz)))) (bvar (s (s nz)))) (app (ind_ctor (ind_mk nat_blk nil (tcons (srt (ls lz)) (ccons (bvar nz) (ccons (pi (bvar nz) (bvar (s nz))) cnil)) tnil) nil) nz (s nz)) (bvar (s nz)))))) cnil)) tnil) nil) nz) $ by closed_ind_ty

lemma fs1_le {x5 x6: set} (H: class) (G: ctx) (u w t: set): $ _ ⇒ hind H $ > $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ ∀ x5 (x5 ∊ ω → ∀ x6 (x6 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (ind_ty le_D nz)) w t) (nnf' x5)) (nnf' x6) = nlev (nnf' x5) (nnf' x6))) $
