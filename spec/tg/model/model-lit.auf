lemma fs1_gc {x5 x6: set} (H: class) (G: ctx) (f fd fm fmul fadd: expr) (u w t: set): $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ _ ⇒ meqs (mcv H) (ls lz) $ > $ _ ⇒ mles (mcv H) $ > $ gcd_eqs_j (jmod (mcv H)) G f fd fm fmul fadd $ > $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ ∀ x5 (x5 ∊ ω → ∀ x6 (x6 ∊ ω → ap (ap (dt u (mcv H) (enc_expr (f)) w t) (nnf' x5)) (nnf' x6) = nnf' (ngcd x5 x6))) $
