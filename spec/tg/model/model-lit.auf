lemma fs1_xor_m {x3 x4 q a b c: set} (G: hyps) (F: class): $ G ⇒ ∀ x3 (x3 ∊ ω → ∀ x4 (x4 ∊ ω → ∃ q (q ∊ ω ∧ ap (ap F (nnf' (ndiv x3 two))) (nnf' (ndiv x4 two)) = nnf' q ∧ ap (ap F (nnf' x3)) (nnf' x4) = nnf' (nadd (nadd q q) (nmod (nadd (nmod x3 two) (nmod x4 two)) two))))) $ > $ G ⇒ ∀ x3 (x3 ∊ ω → ∀ a ∀ b ∀ c (ra_bxor a b c ∈ lrel → nvf' a = x3 → ap (ap F (nnf' x3)) (nnf' nvf' b) = nnf' nvf' c)) $
----
l1: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_bxor a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_bxor a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ m = nvf' b $ by ax
