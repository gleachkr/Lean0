lemma f198_ap {x: set} (G: hyps) (A B F V: class): $ G ⇒ F ∈ cpi x A B $ > $ G ⇒ V ∈ A $ > $ G ⇒ ap F V ∈ B $
----
l1: $ G , v = V ⇒ v = V $ by ax
l2: $ G , v = V ⇒ V ∈ A $ by weaken [#2]
l3: $ G , v = V ⇒ v ∊ A $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , v = V ⇒ F ∈ cpi x A B $ by weaken [#1]
l5: $ G , v = V ⇒ ap F v ∈ B $ by f190_ap [l4, l3]
l6: $ G , v = V ⇒ F = F $ by eq_refl
l7: $ G , v = V ⇒ ap F V ∈ B $ by wcel_eq_l [ap_eq [l6, l1], l5]
l8: $ G ⇒ isset V $ by wcel_isset [#2]
l9: $ G ⇒ ap F V ∈ B $ by isset_elim [l8, l7]

lemma f198_sc {i: set} (G: hyps) (V: class): $ G ⇒ V ∈ nnat $ > $ G ⇒ ap (clam i nnat (nsc i)) V = nsc V $
----
l1: $ G , v = V ⇒ v = V $ by ax
l2: $ G , v = V ⇒ V ∈ nnat $ by weaken [#1]
l3: $ G , v = V ⇒ v ∊ nnat $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , v = V ⇒ ap (clam i nnat (nsc i)) v = nsc v $ by clam_ap [l3]
l5: $ G , v = V ⇒ clam i nnat (nsc i) = clam i nnat (nsc i) $ by eq_refl
l6: $ G , v = V ⇒ ap (clam i nnat (nsc i)) V = nsc V $ by eq_trans [ap_eq [l5, eq_sym [l1]], eq_trans [l4, nsc_eq [l1]]]
l7: $ G ⇒ isset V $ by wcel_isset [#1]
l8: $ G ⇒ ap (clam i nnat (nsc i)) V = nsc V $ by isset_elim [l7, l6]

lemma f198_sn (G: hyps) (V: class): $ G ⇒ V ∈ nnat $ > $ G ⇒ nsc V ∈ nnat $
----
l1: $ G , v = V ⇒ v = V $ by ax
l2: $ G , v = V ⇒ V ∈ nnat $ by weaken [#1]
l3: $ G , v = V ⇒ v ∊ nnat $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , v = V ⇒ nsc V ∈ nnat $ by wcel_eq_l [nsc_eq [l1], nnat_suc [l3]]
l5: $ G ⇒ isset V $ by wcel_isset [#1]
l6: $ G ⇒ nsc V ∈ nnat $ by isset_elim [l5, l4]

lemma f198_ns (G: hyps) (X: class): $ G ⇒ X ∈ ω $ > $ G ⇒ nnf' (suc X) = nsc (nnf' X) $
----
l1: $ G , v = X ⇒ v = X $ by ax
l2: $ G , v = X ⇒ X ∈ ω $ by weaken [#1]
l3: $ G , v = X ⇒ v ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , v = X ⇒ nnf' (suc v) = nsc (nnf' v) $ by nnf_suc [l3]
l5: $ G , v = X ⇒ nnf = nnf $ by eq_refl
l6: $ G , v = X ⇒ nnf' (suc X) = nsc (nnf' X) $ by eq_trans [fv_eq [l5, suc_eq [eq_sym [l1]]], eq_trans [l4, nsc_eq [fv_eq [l5, l1]]]]
l7: $ G ⇒ isset X $ by wcel_isset [#1]
l8: $ G ⇒ nnf' (suc X) = nsc (nnf' X) $ by isset_elim [l7, l6]

