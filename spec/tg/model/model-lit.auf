l11: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ q ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l9], omega_suc [l10]]]
l12: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ m = nnf' d $ by weaken [l7]
l13: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ d ∊ ω $ by weaken [l5]
l14: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ nnf = nnf $ by eq_refl
l15: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ nsc m = nnf' q $ by eq_trans [nsc_eq [l12], eq_trans [eq_sym [nnf_suc [l13]], fv_eq [l14, eq_sym [l9]]]]
l16: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ c ⊆ d $ by weaken [l8]
l17: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ d ⊆ suc d $ by suc_subset
l18: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ c ⊆ q $ by subset_eq_r [eq_sym [l9], subset_trans [l16, l17]]
l19: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ c ∊ ω $ by weaken [l4]
l20: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ p = nnf' c $ by weaken [l6]
l21: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ nsc m = nnf' q ∧ c ⊆ q $ by and_intro [l15, l18]
l22: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ p = nnf' c ∧ nsc m = nnf' q ∧ c ⊆ q $ by and_intro [l20, l21]
l23: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ q ∊ ω ∧ p = nnf' c ∧ nsc m = nnf' q ∧ c ⊆ q $ by and_intro [l11, l22]
l24: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ c ∊ ω ∧ q ∊ ω ∧ p = nnf' c ∧ nsc m = nnf' q ∧ c ⊆ q $ by and_intro [l19, l23]
l25: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ ∃ d (c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ nsc m = nnf' d ∧ c ⊆ d) $ by ex_intro [l24]
l26: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d ⇒ ∃ c ∃ d (c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ nsc m = nnf' d ∧ c ⊆ d) $ by ex_intro [l25]
l27: $ G , c ∊ ω ∧ d ∊ ω ∧ p = nnf' c ∧ m = nnf' d ∧ c ⊆ d , q = suc d , x9 = ∅ ⇒ x9 = ∅ $ by ax
