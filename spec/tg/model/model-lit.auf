lemma fs1_and_m {x3 x4 q a b c: set} (G: hyps) (F: class): $ G ⇒ ∀ x3 (x3 ∊ ω → ∀ x4 (x4 ∊ ω → ∃ q (q ∊ ω ∧ ap (ap F (nnf' (ndiv x3 two))) (nnf' (ndiv x4 two)) = nnf' q ∧ ap (ap F (nnf' x3)) (nnf' x4) = nnf' (nadd (nadd q q) (ndiv (nadd (nmod x3 two) (nmod x4 two)) two))))) $ > $ G ⇒ ∀ x3 (x3 ∊ ω → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x3 → ap (ap F (nnf' x3)) (nnf' nvf' b) = nnf' nvf' c)) $
----
l1: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ m = nvf' b $ by ax
l2: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ isset b $ by isset_var
l3: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ m ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l1], nvf_omega [l2]]]
l4: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ ra_band a b c ∈ lrel $ by ax
l5: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ nvf' a = x7 $ by ax
l6: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ x7 ∊ ω $ by ax
l7: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ (nvf' a = ∅ → nvf' c = ∅) ∧ (nvf' b = ∅ → nvf' c = ∅) $ by lrel_band_zero [l4]
l8: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ nvf' a = ∅ ∨ nvf' b = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' a = ndbl (nvf' x) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = ndbl (nvf' z)) ∨ (nvf' a = ndbl (nvf' x) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = ndbl (nvf' z)) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = ndbl (nvf' z)) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = suc (ndbl (nvf' z))))) $ by lrel_band_digits [l4]
l9: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ ∀ x3 (x3 ∊ ω → ∀ x4 (x4 ∊ ω → ∃ q (q ∊ ω ∧ ap (ap F (nnf' (ndiv x3 two))) (nnf' (ndiv x4 two)) = nnf' q ∧ ap (ap F (nnf' x3)) (nnf' x4) = nnf' (nadd (nadd q q) (ndiv (nadd (nmod x3 two) (nmod x4 two)) two))))) $ by weaken [#1]
l10: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b , nvf' a = ∅ ⇒ nvf' a = x7 $ by ax
l11: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_band a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_band a b c ∈ lrel , nvf' a = x7 , m = nvf' b , nvf' a = ∅ ⇒ nvf' a = ∅ $ by ax
