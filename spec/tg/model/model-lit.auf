l318: $ … ⇒ dt u (mcv H) (enc_expr (pi (app (app (bvar nz) (bvar n1)) (app (ind_ctor le_D nz nz) (bvar n1))) (pi (pi (nat_ty) (pi (app (app (ind_ty le_D nz) (bvar n3)) (bvar nz)) (pi (app (app (bvar n3) (bvar n1)) (bvar nz)) (app (app (bvar n4) (app (nat_succ) (bvar n2))) (app (app (app (ind_ctor le_D nz n1) (bvar n5)) (bvar n2)) (bvar n1)))))) (pi (nat_ty) (pi (app (app (ind_ty le_D nz) (bvar n4)) (bvar nz)) (app (app (bvar n4) (bvar n1)) (bvar nz))))))) w (scons yy1 (scons yy0 t)) = cpi yy4 (dt u (mcv H) (enc_expr (app (app (bvar nz) (bvar n1)) (app (ind_ctor le_D nz nz) (bvar n1)))) w (scons yy1 (scons yy0 t))) (dt u (mcv H) (enc_expr (pi (pi (nat_ty) (pi (app (app (ind_ty le_D nz) (bvar n3)) (bvar nz)) (pi (app (app (bvar n3) (bvar n1)) (bvar nz)) (app (app (bvar n4) (app (nat_succ) (bvar n2))) (app (app (app (ind_ctor le_D nz n1) (bvar n5)) (bvar n2)) (bvar n1)))))) (pi (nat_ty) (pi (app (app (ind_ty le_D nz) (bvar n4)) (bvar nz)) (app (app (bvar n4) (bvar n1)) (bvar nz)))))) w (scons yy4 (scons yy1 (scons yy0 t)))) $ by dt_pi_c [l316, l317, l312, l315]
