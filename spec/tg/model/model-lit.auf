l98: $ … ⇒ ∃ y ∃ z (ra_band x1 y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x1) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x1)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by ex_intro [l97]
l99: $ … ⇒ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = ndbl (nvf' x) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = ndbl (nvf' y) ∧ nvf' t3 = ndbl (nvf' z)) ∨ (nvf' t1 = suc (ndbl (nvf' x)) ∧ nvf' t2 = suc (ndbl (nvf' y)) ∧ nvf' t3 = suc (ndbl (nvf' z))))) $ by ex_intro [l98]
