l26: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_bxor a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_bxor a b c ∈ lrel , nvf' a = x7 , m = nvf' b , nvf' b = ∅ ∨ ∃ x ∃ y ∃ z (ra_bxor x y z ∈ lrel ∧ ((nvf' a = ndbl (nvf' x) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = ndbl (nvf' z)) ∨ (nvf' a = ndbl (nvf' x) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = suc (ndbl (nvf' z))) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = suc (ndbl (nvf' z))) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = ndbl (nvf' z)))) , nvf' b = ∅ ⇒ nvf' b = ∅ $ by ax
