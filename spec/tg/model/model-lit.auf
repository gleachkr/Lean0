l436: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_bor a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_bor a b c ∈ lrel , nvf' a = x7 , m = nvf' b , nvf' b = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' a = ndbl (nvf' x) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = ndbl (nvf' z)) ∨ (nvf' a = ndbl (nvf' x) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = suc (ndbl (nvf' z))) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = suc (ndbl (nvf' z))) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = suc (ndbl (nvf' z))))) ⇒ nvf' b = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' a = ndbl (nvf' x) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = ndbl (nvf' z)) ∨ (nvf' a = ndbl (nvf' x) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = suc (ndbl (nvf' z))) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = suc (ndbl (nvf' z))) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = suc (ndbl (nvf' z))))) $ by ax
l437: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_bor a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_bor a b c ∈ lrel , nvf' a = x7 , m = nvf' b , nvf' b = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((nvf' a = ndbl (nvf' x) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = ndbl (nvf' z)) ∨ (nvf' a = ndbl (nvf' x) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = suc (ndbl (nvf' z))) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = ndbl (nvf' y) ∧ nvf' c = suc (ndbl (nvf' z))) ∨ (nvf' a = suc (ndbl (nvf' x)) ∧ nvf' b = suc (ndbl (nvf' y)) ∧ nvf' c = suc (ndbl (nvf' z))))) ⇒ ap (ap F (nnf' x7)) (nnf' nvf' b) = nnf' nvf' c $ by or_elim [l436, l38, l435]
l438: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_bor a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_bor a b c ∈ lrel , nvf' a = x7 , m = nvf' b ⇒ ap (ap F (nnf' x7)) (nnf' nvf' b) = nnf' nvf' c $ by or_elim [l8, l25, l437]
l439: $ G , x7 ∊ ω , ∀ x8 (x8 ∊ x7 → ∀ a ∀ b ∀ c (ra_bor a b c ∈ lrel → nvf' a = x8 → ap (ap F (nnf' x8)) (nnf' nvf' b) = nnf' nvf' c)) , ra_bor a b c ∈ lrel , nvf' a = x7 ⇒ isset b $ by isset_var
