lemma f185_co {a r i j c: set} (G: hyps) (p q g y z v m x: set): $ G ⇒ v ∊ p $ > $ G ⇒ qresp p q g $ > $ G ⇒ x ∊ qty p q $ > $ G ⇒ x = ap (ap (ap (clam a (fv uni m) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c)))) y) z) v $ > $ G ⇒ qlift p g x = ap g v $
----
l1: $ G , p ∈ two ⇒ p ∈ two $ by ax
l2: $ G , p ∈ two ⇒ v ∊ p $ by weaken [#1]
l3: $ G , p ∈ two ⇒ v = ∅ $ by two_mem_empty [l1, l2]
l4: $ G , p ∈ two ⇒ qlift p g x = ap g ∅ $ by qlift_prop [l1]
l5: $ G , p ∈ two ⇒ g = g $ by eq_refl
l6: $ G , p ∈ two ⇒ qlift p g x = ap g v $ by eq_trans [l4, ap_eq [l5, eq_sym [l3]]]
l7: $ G , ¬ p ∈ two ⇒ ¬ p ∈ two $ by ax
l8: $ G , ¬ p ∈ two ⇒ x ∊ qty p q $ by weaken [#3]
l9: $ G , ¬ p ∈ two ⇒ (p ∈ two ∧ x ∊ p) ∨ (¬ p ∈ two ∧ ∃ b (b ∊ p ∧ x = qcl p q b)) $ by cab_elim [l8]
l10: $ G , ¬ p ∈ two , p ∈ two ∧ x ∊ p ⇒ ¬ p ∈ two $ by weaken [l7]
l11: $ G , ¬ p ∈ two , p ∈ two ∧ x ∊ p ⇒ p ∈ two ∧ x ∊ p $ by ax
l12: $ G , ¬ p ∈ two , p ∈ two ∧ x ∊ p ⇒ p ∈ two $ by and_elim_l [l11]
l13: $ G , ¬ p ∈ two , p ∈ two ∧ x ∊ p ⇒ ⊥ $ by not_elim [l10, l12]
l14: $ G , ¬ p ∈ two , p ∈ two ∧ x ∊ p ⇒ qlift p g x = ap g v $ by bot_elim [l13]
l15: $ G , ¬ p ∈ two , ¬ p ∈ two ∧ ∃ b (b ∊ p ∧ x = qcl p q b) ⇒ ¬ p ∈ two ∧ ∃ b (b ∊ p ∧ x = qcl p q b) $ by ax
l16: $ G , ¬ p ∈ two , ¬ p ∈ two ∧ ∃ b (b ∊ p ∧ x = qcl p q b) ⇒ ∃ b (b ∊ p ∧ x = qcl p q b) $ by and_elim_r [l15]
l17: $ G , ¬ p ∈ two , ¬ p ∈ two ∧ ∃ b (b ∊ p ∧ x = qcl p q b) , b ∊ p ∧ x = qcl p q b ⇒ b ∊ p ∧ x = qcl p q b $ by ax
l18: $ G , ¬ p ∈ two , ¬ p ∈ two ∧ ∃ b (b ∊ p ∧ x = qcl p q b) , b ∊ p ∧ x = qcl p q b ⇒ b ∊ p $ by and_elim_l [l17]
