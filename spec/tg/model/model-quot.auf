l81: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 t) ⇒ fv nvf (enc_nat n1) = suc (fv nvf (enc_nat nz)) $ by nvf_s [l80]
l82: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 t) ⇒ suc (fv nvf (enc_nat nz)) = suc ∅ $ by suc_eq [l79]
l83: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 t) ⇒ fv nvf (enc_nat n1) = suc ∅ $ by eq_trans [l81, l82]
l84: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 t) ⇒ scons i (scons x1 t) = scons i (scons x1 t) $ by eq_refl
l85: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 t) ⇒ fv (scons i (scons x1 t)) (fv nvf (enc_nat n1)) = fv (scons i (scons x1 t)) (suc ∅) $ by fv_eq [l84, l83]
l86: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 t) ⇒ t ∈ fseq u $ by weaken [l6]
l87: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 t) ⇒ isset t $ by wcel_isset [l86]
