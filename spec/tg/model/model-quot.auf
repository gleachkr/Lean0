l1: $ (⟦ x / t ⟧ {q | ∀ g (∀ e (∀ a (∀ b ((q = (ra_deq g e a b)) → (∀ u ((uadm u) → (∀ w ((w ∊ lvals) → (∀ r ((r ∊ (sat u A g w)) → (((dt u A e w r) = (dt u A a w r)) ∧ ((dt u A e w r) ∈ (dt u A b w r)))))))))))))}) ≐ {q | ∀ g (∀ e (∀ a (∀ b ((q = (ra_deq g e a b)) → (∀ u ((uadm u) → (∀ w ((w ∊ lvals) → (∀ r ((r ∊ (sat u (⟦ x / t ⟧ A) g w)) → (((dt u (⟦ x / t ⟧ A) e w r) = (dt u (⟦ x / t ⟧ A) a w r)) ∧ ((dt u (⟦ x / t ⟧ A) e w r) ∈ (dt u (⟦ x / t ⟧ A) b w r)))))))))))))} $ by ceqt_refl

lemma f187_inj (G: hyps) (A B C D: class) (g e a b: set): $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ isset C $ > $ G ⇒ isset D $ > $ G ⇒ ra_deq A B C D = ra_deq g e a b $ > $ G ⇒ A = g ∧ B = e ∧ C = a ∧ D = b $
----
l1: $ G ⇒ isset g $ by isset_var
l2: $ G ⇒ isset e $ by isset_var
l3: $ G ⇒ isset a $ by isset_var
l4: $ G ⇒ isset b $ by isset_var
l5: $ G ⇒ ⟨ kr_deq , scons A (scons B (scons C (scons D ∅))) ⟩ = ⟨ kr_deq , scons g (scons e (scons a (scons b ∅))) ⟩ $ by weaken [#5]
l6: $ G ⇒ kr_deq ∈ ω $ by kr_deq_omega
l7: $ G ⇒ isset kr_deq $ by wcel_isset [l6]
l8: $ G ⇒ isset ∅ $ by ax_empty
l9: $ G ⇒ isset (scons D ∅) $ by scons_set [l8]
l10: $ G ⇒ isset (scons C (scons D ∅)) $ by scons_set [l9]
l11: $ G ⇒ isset (scons B (scons C (scons D ∅))) $ by scons_set [l10]
l12: $ G ⇒ isset (scons A (scons B (scons C (scons D ∅)))) $ by scons_set [l11]
l13: $ G ⇒ isset ∅ $ by ax_empty
l14: $ G ⇒ isset (scons b ∅) $ by scons_set [l13]
l15: $ G ⇒ isset (scons a (scons b ∅)) $ by scons_set [l14]
l16: $ G ⇒ isset (scons e (scons a (scons b ∅))) $ by scons_set [l15]
l17: $ G ⇒ isset (scons g (scons e (scons a (scons b ∅)))) $ by scons_set [l16]
l18: $ G ⇒ kr_deq = kr_deq ∧ scons A (scons B (scons C (scons D ∅))) = scons g (scons e (scons a (scons b ∅))) $ by opair_inj_c [l5, l7, l12, l7, l17]
l19: $ G ⇒ scons A (scons B (scons C (scons D ∅))) = scons g (scons e (scons a (scons b ∅))) $ by and_elim_r [l18]
l20: $ G ⇒ isset ∅ $ by ax_empty
