lemma f190_ap {x: set} (G: hyps x) (A F: class) (B: class x) (a: set): $ G ⇒ F ∈ cpi x A B $ > $ G ⇒ a ∊ A $ > $ G ⇒ ap F a ∈ (⟦ x / a ⟧ B) $
----
l1: $ G , f = F ⇒ f = F $ by ax
l2: $ G , f = F ⇒ F ∈ cpi x A B $ by weaken [#1]
l3: $ G , f = F ⇒ f ∊ cpi x A B $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , f = F ⇒ a ∊ A $ by weaken [#2]
l5: $ G , f = F ⇒ ap f a ∈ (⟦ x / a ⟧ B) $ by cpi_elim_ap [l3, l4]
l6: $ G , f = F ⇒ a = a $ by eq_refl
l7: $ G , f = F ⇒ ap F a ∈ (⟦ x / a ⟧ B) $ by wcel_eq_l [ap_eq [l1, l6], l5]
l8: $ G ⇒ isset F $ by wcel_isset [#1]
l9: $ G ⇒ ap F a ∈ (⟦ x / a ⟧ B) $ by isset_elim [l8, l7]

lemma f190_te (G: hyps) (X Y A: class): $ G ⇒ A ∈ teq X Y $ > $ G ⇒ X = Y $
----
l1: $ G , a = A ⇒ a = A $ by ax
l2: $ G , a = A ⇒ A ∈ teq X Y $ by weaken [#1]
l3: $ G , a = A ⇒ a ∊ teq X Y $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , a = A ⇒ X = Y $ by teq_elim [l3]
l5: $ G ⇒ isset A $ by wcel_isset [#1]
l6: $ G ⇒ X = Y $ by isset_elim [l5, l4]

lemma f190_tt (G: hyps) (X Y: class): $ G ⇒ teq X Y ∈ two $
----
l1: $ G , X = Y , h ∊ teq X Y ⇒ h ∊ teq X Y $ by ax
l2: $ G , X = Y , h ∊ teq X Y ⇒ h = ∅ ∧ X = Y $ by cab_elim [l1]
l3: $ G , X = Y , h ∊ teq X Y ⇒ h ∊ csn ∅ $ by csn_intro [and_elim_l [l2]]
l4: $ G , X = Y , h ∊ csn ∅ ⇒ h ∊ csn ∅ $ by ax
l5: $ G , X = Y , h ∊ csn ∅ ⇒ h = ∅ $ by csn_elim [l4]
l6: $ G , X = Y , h ∊ csn ∅ ⇒ X = Y $ by ax
l7: $ G , X = Y , h ∊ csn ∅ ⇒ h ∊ teq X Y $ by cab_intro [and_intro [l5, l6]]
l8: $ G , X = Y ⇒ teq X Y = csn ∅ $ by eq_intro [l3, l7]
l9: $ G , X = Y ⇒ csn ∅ ∈ two $ by two_intro_r
l10: $ G , X = Y ⇒ teq X Y ∈ two $ by wcel_eq_l [eq_sym [l8], l9]
l11: $ G , ¬ X = Y , h ∊ teq X Y ⇒ h ∊ teq X Y $ by ax
l12: $ G , ¬ X = Y , h ∊ teq X Y ⇒ X = Y $ by teq_elim [l11]
l13: $ G , ¬ X = Y , h ∊ teq X Y ⇒ ¬ X = Y $ by ax
l14: $ G , ¬ X = Y , h ∊ teq X Y ⇒ ⊥ $ by not_elim [l13, l12]
l15: $ G , ¬ X = Y ⇒ teq X Y = ∅ $ by empty_eq_intro [l14]
l16: $ G , ¬ X = Y ⇒ ∅ ∈ two $ by two_intro_l
l17: $ G , ¬ X = Y ⇒ teq X Y ∈ two $ by wcel_eq_l [eq_sym [l15], l16]
l18: $ G ⇒ X = Y ∨ ¬ X = Y $ by excluded_middle
l19: $ G ⇒ teq X Y ∈ two $ by or_elim [l18, l10, l17]

lemma f190_at (G: hyps) (H R: class) (v: lvl) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u (mcv H) (enc_expr (ind_ctor (eq_D v) nz nz)) w R = dt u (mcv H) (enc_expr (ind_ctor (eq_D v) nz nz)) w ∅ $
----
l1: $ G ⇒ kc_ind_ctor ∈ kexa $ by kexa_ind_ctor
l2: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l3: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l4: $ G ⇒ enc_ind (eq_D v) ∈ trees ω $ by enc_ind_trees
l5: $ G ⇒ scons (enc_ind (eq_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [l4, scons_fseq_c [l2, scons_fseq_c [l2, l3]]]
l6: $ G ⇒ w ∈ lvals $ by welc_wcel [#1]
l7: $ G ⇒ dt u (mcv H) ⟨ kc_ind_ctor , scons (enc_ind (eq_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) ⟩ w R = mclip u (ap (fv (mcv H) ⟨ u , ⟨ kc_ind_ctor , ⟨ scons (enc_ind (eq_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) , ccom (dnf u (mcv H)) (scons (enc_ind (eq_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅))) ⟩ ⟩ ⟩) w) $ by dt_atom_c [l1, l5, l6, #2]
l8: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l9: $ G ⇒ dt u (mcv H) ⟨ kc_ind_ctor , scons (enc_ind (eq_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) ⟩ w ∅ = mclip u (ap (fv (mcv H) ⟨ u , ⟨ kc_ind_ctor , ⟨ scons (enc_ind (eq_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) , ccom (dnf u (mcv H)) (scons (enc_ind (eq_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅))) ⟩ ⟩ ⟩) w) $ by dt_atom_c [l1, l5, l6, l8]
l10: $ G ⇒ dt u (mcv H) (enc_expr (ind_ctor (eq_D v) nz nz)) w R = dt u (mcv H) (enc_expr (ind_ctor (eq_D v) nz nz)) w ∅ $ by eq_trans [l7, eq_sym [l9]]

lemma f190_e (G: hyps) (H: class) (v: lvl) (u w b x y: set): $ G ⇒ uadm u $ > $ G ⇒ hty ⊆ H $ > $ G ⇒ hctor ⊆ H $ > $ G ⇒ hrec ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ b ∊ fv uni (lv (enc_lvl v) w) $ > $ G ⇒ x ∊ b $ > $ G ⇒ y ∊ b $ > $ G ⇒ ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y $
----
l1: $ G ⇒ (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (pi (bvar n1) Prop)))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (eq_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (app (app (ind_ty (eq_D v) nz) (bvar n1)) (bvar nz)) (bvar nz))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (eq_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (pi (pi (bvar n1) (pi (app (app (app (ind_ty (eq_D v) nz) (bvar n2)) (bvar n1)) (bvar nz)) Prop)) (pi (app (app (bvar nz) (bvar n1)) (app (app (ind_ctor (eq_D v) nz nz) (bvar n2)) (bvar n1))) (pi (bvar n3) (pi (app (app (app (ind_ty (eq_D v) nz) (bvar n4)) (bvar n3)) (bvar nz)) (app (app (bvar n3) (bvar n1)) (bvar nz))))))))) w ∅) $ by f189_m [#1, #2, #3, #4, #5, #6]
l2: $ G , n = lv (enc_lvl v) w ⇒ n = lv (enc_lvl v) w $ by ax
l3: $ G , n = lv (enc_lvl v) w ⇒ lv (enc_lvl v) w = n $ by eq_sym [l2]
l4: $ G , n = lv (enc_lvl v) w ⇒ uadm u $ by weaken [#1]
l5: $ G , n = lv (enc_lvl v) w ⇒ w ∊ lvals $ by weaken [#6]
l6: $ G , n = lv (enc_lvl v) w ⇒ w ∈ lvals $ by welc_wcel [l5]
l7: $ G , n = lv (enc_lvl v) w ⇒ ∅ ∈ fseq u $ by fseq_empty
l8: $ G , n = lv (enc_lvl v) w ⇒ (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (pi (bvar n1) Prop)))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (eq_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (app (app (ind_ty (eq_D v) nz) (bvar n1)) (bvar nz)) (bvar nz))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (eq_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (pi (pi (bvar n1) (pi (app (app (app (ind_ty (eq_D v) nz) (bvar n2)) (bvar n1)) (bvar nz)) Prop)) (pi (app (app (bvar nz) (bvar n1)) (app (app (ind_ctor (eq_D v) nz nz) (bvar n2)) (bvar n1))) (pi (bvar n3) (pi (app (app (app (ind_ty (eq_D v) nz) (bvar n4)) (bvar n3)) (bvar nz)) (app (app (bvar n3) (bvar n1)) (bvar nz))))))))) w ∅) $ by weaken [l1]
l9: $ G , n = lv (enc_lvl v) w ⇒ w ∈ lvals $ by weaken [l6]
l10: $ G , n = lv (enc_lvl v) w ⇒ ∅ ∈ fseq u $ by weaken [l7]
l11: $ G , n = lv (enc_lvl v) w ⇒ enc_expr (srt v) ∈ trees ω $ by enc_expr_trees
l12: $ G , n = lv (enc_lvl v) w ⇒ enc_expr (pi (bvar nz) (pi (bvar n1) (Prop))) ∈ trees ω $ by enc_expr_trees
l13: $ G , n = lv (enc_lvl v) w ⇒ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (pi (bvar n1) (Prop))))) w ∅ = cpi x1 (dt u (mcv H) (enc_expr (srt v)) w ∅) (dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 ∅)) $ by dt_pi_c [l11, l12, l9, l10]
l14: $ G , n = lv (enc_lvl v) w ⇒ w ∈ lvals $ by weaken [l6]
l15: $ G , n = lv (enc_lvl v) w ⇒ ∅ ∈ fseq u $ by weaken [l7]
l16: $ G , n = lv (enc_lvl v) w ⇒ enc_lvl v ∈ trees ω $ by enc_lvl_trees
l17: $ G , n = lv (enc_lvl v) w ⇒ dt u (mcv H) (enc_expr (srt v)) w ∅ = fv uni (lv (enc_lvl v) w) $ by dt_srt_c [l16, l14, l15]
l18: $ G , n = lv (enc_lvl v) w ⇒ lv (enc_lvl v) w = n $ by weaken [l3]
l19: $ G , n = lv (enc_lvl v) w ⇒ uni = uni $ by eq_refl
l20: $ G , n = lv (enc_lvl v) w ⇒ fv uni (lv (enc_lvl v) w) = fv uni n $ by fv_eq [l19, l18]
l21: $ G , n = lv (enc_lvl v) w ⇒ dt u (mcv H) (enc_expr (srt v)) w ∅ = fv uni n $ by eq_trans [l17, l20]
l22: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ $ by ax
l23: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ uadm u $ by weaken [l4]
l24: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ w ∈ lvals $ by weaken [l6]
l25: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ ∅ ∈ fseq u $ by weaken [l7]
l26: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ scons x1 ∅ ∈ fseq u $ by dt_scons_fseq [l23, l24, l25, l22]
l27: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ dt u (mcv H) (enc_expr (srt v)) w ∅ = fv uni n $ by weaken [l21]
l28: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ x1 ∊ fv uni n $ by welc_eq [l27, l22]
l29: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ w ∈ lvals $ by weaken [l6]
l30: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ scons x1 ∅ ∈ fseq u $ by weaken [l26]
l31: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ enc_expr (bvar nz) ∈ trees ω $ by enc_expr_trees
l32: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ enc_expr (pi (bvar n1) (Prop)) ∈ trees ω $ by enc_expr_trees
l33: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 ∅) = cpi x2 (dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅)) (dt u (mcv H) (enc_expr (pi (bvar n1) (Prop))) w (scons x2 (scons x1 ∅))) $ by dt_pi_c [l31, l32, l29, l30]
l34: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ w ∈ lvals $ by weaken [l6]
l35: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ scons x1 ∅ ∈ fseq u $ by weaken [l26]
l36: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l37: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) = fv (scons x1 ∅) (fv nvf (enc_nat nz)) $ by dt_bvar_c [l36, l34, l35]
l38: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ fv nvf (enc_nat nz) = ∅ $ by nvf_nz
l39: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ scons x1 ∅ = scons x1 ∅ $ by eq_refl
l40: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ fv (scons x1 ∅) (fv nvf (enc_nat nz)) = fv (scons x1 ∅) ∅ $ by fv_eq [l39, l38]
l41: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ ∅ ∈ fseq u $ by weaken [l7]
l42: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ isset ∅ $ by wcel_isset [l41]
l43: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ isset (scons x1 ∅) $ by scons_set [l42]
l44: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ isset ∅ $ by ax_empty
l45: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ isset x1 $ by isset_var
l46: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ fv (scons x1 ∅) ∅ = x1 $ by scons_fv_zero_c [l45, l42]
l47: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ fv (scons x1 ∅) (fv nvf (enc_nat nz)) = x1 $ by eq_trans [l40, l46]
l48: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) = x1 $ by eq_trans [l37, l47]
l49: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) $ by ax
l50: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ uadm u $ by weaken [l4]
l51: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ w ∈ lvals $ by weaken [l6]
l52: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ scons x1 ∅ ∈ fseq u $ by weaken [l26]
l53: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ scons x2 (scons x1 ∅) ∈ fseq u $ by dt_scons_fseq [l50, l51, l52, l49]
l54: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) = x1 $ by weaken [l48]
l55: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ x2 ∊ x1 $ by welc_eq [l54, l49]
l56: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ w ∈ lvals $ by weaken [l6]
l57: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ scons x2 (scons x1 ∅) ∈ fseq u $ by weaken [l53]
l58: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ enc_expr (bvar n1) ∈ trees ω $ by enc_expr_trees
l59: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ enc_expr (Prop) ∈ trees ω $ by enc_expr_trees
l60: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ dt u (mcv H) (enc_expr (pi (bvar n1) (Prop))) w (scons x2 (scons x1 ∅)) = cpi x3 (dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 ∅))) (dt u (mcv H) (enc_expr (Prop)) w (scons x3 (scons x2 (scons x1 ∅)))) $ by dt_pi_c [l58, l59, l56, l57]
l61: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ w ∈ lvals $ by weaken [l6]
l62: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ scons x2 (scons x1 ∅) ∈ fseq u $ by weaken [l53]
l63: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ enc_nat n1 ∈ trees ω $ by enc_nat_trees
l64: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 ∅)) = fv (scons x2 (scons x1 ∅)) (fv nvf (enc_nat n1)) $ by dt_bvar_c [l63, l61, l62]
l65: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ fv nvf (enc_nat nz) = ∅ $ by nvf_nz
l66: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l67: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ fv nvf (enc_nat n1) = suc (fv nvf (enc_nat nz)) $ by nvf_s [l66]
l68: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ suc (fv nvf (enc_nat nz)) = suc ∅ $ by suc_eq [l65]
l69: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ fv nvf (enc_nat n1) = suc ∅ $ by eq_trans [l67, l68]
l70: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ scons x2 (scons x1 ∅) = scons x2 (scons x1 ∅) $ by eq_refl
l71: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ fv (scons x2 (scons x1 ∅)) (fv nvf (enc_nat n1)) = fv (scons x2 (scons x1 ∅)) (suc ∅) $ by fv_eq [l70, l69]
l72: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ ∅ ∈ fseq u $ by weaken [l7]
