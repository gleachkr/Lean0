--| @freshen G x
--| @freshen G y
lemma f179_ci {x y: set} (G: hyps) (A: class) (C: class y) (B: class x): $ G ⇒ isset (clam y A C) $ > $ G ⇒ ∀ x (x ∊ A → ap (clam y A C) x ∈ B) $ > $ G ⇒ clam y A C ∈ cpi x A B $
----
l1: $ G , f = clam y A C ⇒ f = clam y A C $ by ax
l2: $ G , f = clam y A C , c ∊ f ⇒ f = clam y A C $ by weaken [l1]
l3: $ G , f = clam y A C , c ∊ f ⇒ c ∊ f $ by ax
l4: $ G , f = clam y A C , c ∊ f ⇒ c ∊ clam y A C $ by welc_eq [l2, l3]
l5: $ G , f = clam y A C , c ∊ f , c = ⟨ p , q ⟩ , p ∊ A , q ∊ (⟦ y / p ⟧ C) ⇒ p ∊ A $ by ax
l6: $ G , f = clam y A C , c ∊ f , c = ⟨ p , q ⟩ , p ∊ A , q ∊ (⟦ y / p ⟧ C) ⇒ c = ⟨ p , q ⟩ $ by ax
l7: $ G , f = clam y A C , c ∊ f , c = ⟨ p , q ⟩ , p ∊ A , q ∊ (⟦ y / p ⟧ C) ⇒ p ∊ A ∧ c = ⟨ p , q ⟩ $ by and_intro [l5, l6]
l8: $ G , f = clam y A C , c ∊ f , c = ⟨ p , q ⟩ , p ∊ A , q ∊ (⟦ y / p ⟧ C) ⇒ ∃ b (p ∊ A ∧ c = ⟨ p , b ⟩) $ by ex_intro [l7]
l9: $ G , f = clam y A C , c ∊ f , c = ⟨ p , q ⟩ , p ∊ A , q ∊ (⟦ y / p ⟧ C) ⇒ ∃ a ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩) $ by ex_intro [l8]
l10: $ G , f = clam y A C , c ∊ f ⇒ ∃ a ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩) $ by clam_elim_mem [l4, l9]
l11: $ G , f = clam y A C ⇒ c ∊ f → ∃ a ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩) $ by imp_intro [l10]
l12: $ G , f = clam y A C ⇒ ∀ c (c ∊ f → ∃ a ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩)) $ by all_intro [l11]
l13: $ G , f = clam y A C , x ∊ A ⇒ ∀ x (x ∊ A → ap (clam y A C) x ∈ B) $ by weaken [#2]
l14: $ G , f = clam y A C , x ∊ A ⇒ x ∊ A → ap (clam y A C) x ∈ B $ by all_elim [l13]
l15: $ G , f = clam y A C , x ∊ A ⇒ x ∊ A $ by ax
l16: $ G , f = clam y A C , x ∊ A ⇒ ap (clam y A C) x ∈ B $ by imp_elim [l14, l15]
l17: $ G , f = clam y A C , x ∊ A ⇒ f = clam y A C $ by weaken [l1]
l18: $ G , f = clam y A C , x ∊ A ⇒ x = x $ by eq_refl
l19: $ G , f = clam y A C , x ∊ A ⇒ ap (clam y A C) x = ap f x $ by ap_eq [eq_sym [l17], l18]
l20: $ G , f = clam y A C , x ∊ A ⇒ ap f x ∈ B $ by wcel_eq_l [l19, l16]
l21: $ G , f = clam y A C ⇒ x ∊ A → ap f x ∈ B $ by imp_intro [l20]
l22: $ G , f = clam y A C ⇒ ∀ x (x ∊ A → ap f x ∈ B) $ by all_intro [l21]
l23: $ G , f = clam y A C ⇒ f ∊ cpi x A B $ by cpi_intro_pts [l12, l22]
l24: $ G , f = clam y A C ⇒ clam y A C ∈ cpi x A B $ by wcel_intro [l1, l23]
l25: $ G ⇒ clam y A C ∈ cpi x A B $ by isset_elim [#1, l24]

--| @freshen G i
--| @freshen G j
lemma f179_qd {i j: set} (G: hyps) (a: set): $ G ⇒ isset (cpi i a (cpi j a (fv uni ∅))) $
----
l1: $ G ⇒ fv uni ∅ = two $ by uni_zero
l2: $ G ⇒ isset two $ by two_set
l3: $ G ⇒ isset (fv uni ∅) $ by isset_eq [eq_sym [l1], l2]
l4: $ G ⇒ isset (⋃ (fv uni ∅)) $ by cuni_set [l3]
l5: $ G ⇒ isset a $ by isset_var
l6: $ G , j ∊ a ⇒ isset (⋃ (fv uni ∅)) $ by weaken [l4]
l7: $ G ⇒ j ∊ a → isset (⋃ (fv uni ∅)) $ by imp_intro [l6]
l8: $ G ⇒ ∀ j (j ∊ a → isset (⋃ (fv uni ∅))) $ by all_intro [l7]
l9: $ G ⇒ isset (clam j a (⋃ (fv uni ∅))) $ by clam_set [l5, l8]
l10: $ G ⇒ isset (cpi j a (fv uni ∅)) $ by cpi_set [l9]
l11: $ G ⇒ isset (⋃ (cpi j a (fv uni ∅))) $ by cuni_set [l10]
l12: $ G , i ∊ a ⇒ isset (⋃ (cpi j a (fv uni ∅))) $ by weaken [l11]
l13: $ G ⇒ i ∊ a → isset (⋃ (cpi j a (fv uni ∅))) $ by imp_intro [l12]
l14: $ G ⇒ ∀ i (i ∊ a → isset (⋃ (cpi j a (fv uni ∅)))) $ by all_intro [l13]
l15: $ G ⇒ isset (clam i a (⋃ (cpi j a (fv uni ∅)))) $ by clam_set [l5, l14]
l16: $ G ⇒ isset (cpi i a (cpi j a (fv uni ∅))) $ by cpi_set [l15]

--| @freshen G a
--| @freshen G r
--| @freshen G i
--| @freshen G j
--| @freshen G x1
--| @freshen G x2
lemma f179_ty {a r i j x1 x2: set} (G: hyps) (n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r)) ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n)) $
----
l1: $ G , x1 ∊ fv uni n ⇒ x1 ∊ fv uni n $ by ax
l2: $ G , x1 ∊ fv uni n ⇒ ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1 = clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r) $ by clam_ap [l1]
l3: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) $ by ax
l4: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) x2 = qty x1 x2 $ by clam_ap [l3]
l5: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ n ∊ ω $ by weaken [#1]
l6: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ x1 ∊ fv uni n $ by weaken [l1]
l7: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ qty x1 x2 ∈ fv uni n $ by qty_uni [l5, l6]
l8: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) x2 ∈ fv uni n $ by wcel_eq_l [eq_sym [l4], l7]
l9: $ G , x1 ∊ fv uni n ⇒ x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) x2 ∈ fv uni n $ by imp_intro [l8]
l10: $ G , x1 ∊ fv uni n ⇒ ∀ x2 (x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) x2 ∈ fv uni n) $ by all_intro [l9]
l11: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ isset (qty x1 x2) $ by wcel_isset [l7]
l12: $ G , x1 ∊ fv uni n ⇒ x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → isset (qty x1 x2) $ by imp_intro [l11]
l13: $ G , x1 ∊ fv uni n ⇒ ∀ x2 (x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → isset (qty x1 x2)) $ by all_intro [l12]
l14: $ G , x1 ∊ fv uni n ⇒ r ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → isset (qty x1 r) $ by all_elim [l13]
l15: $ G , x1 ∊ fv uni n ⇒ ∀ r (r ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → isset (qty x1 r)) $ by all_intro [l14]
l16: $ G , x1 ∊ fv uni n ⇒ isset (cpi i x1 (cpi j x1 (fv uni ∅))) $ by f179_qd
l17: $ G , x1 ∊ fv uni n ⇒ isset (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) $ by clam_set [l16, l15]
l18: $ G , x1 ∊ fv uni n ⇒ clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r) ∈ cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n) $ by f179_ci [l17, l10]
l19: $ G , x1 ∊ fv uni n ⇒ ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1 ∈ cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n) $ by wcel_eq_l [eq_sym [l2], l18]
l20: $ G ⇒ x1 ∊ fv uni n → ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1 ∈ cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n) $ by imp_intro [l19]
l21: $ G ⇒ ∀ x1 (x1 ∊ fv uni n → ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1 ∈ cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n)) $ by all_intro [l20]
l22: $ G , x1 ∊ fv uni n ⇒ isset (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) $ by wcel_isset [l18]
l23: $ G ⇒ x1 ∊ fv uni n → isset (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) $ by imp_intro [l22]
l24: $ G ⇒ ∀ x1 (x1 ∊ fv uni n → isset (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r))) $ by all_intro [l23]
l25: $ G ⇒ a ∊ fv uni n → isset (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r)) $ by all_elim [l24]
l26: $ G ⇒ ∀ a (a ∊ fv uni n → isset (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) $ by all_intro [l25]
l27: $ G ⇒ isset (fv uni n) $ by uni_set
l28: $ G ⇒ isset (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) $ by clam_set [l27, l26]
l29: $ G ⇒ clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r)) ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n)) $ by f179_ci [l28, l21]

