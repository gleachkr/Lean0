l79: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R , x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) ⇒ isset (suc ∅) $ by suc_set [l78]
l80: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R , x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) ⇒ isset x2 $ by isset_var
l81: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R , x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) ⇒ fv (scons x2 (scons x1 R)) (suc ∅) = fv (scons x1 R) ∅ $ by scons_fv_suc_c [l80, l76, l78]
l82: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R , x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) ⇒ fv (scons x2 (scons x1 R)) (fv nvf (enc_nat n1)) = fv (scons x1 R) ∅ $ by eq_trans [l73, l81]
l83: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R , x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) ⇒ isset x1 $ by isset_var
l84: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R , x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) ⇒ fv (scons x1 R) ∅ = x1 $ by scons_fv_zero_c [l83, l75]
l85: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R , x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) ⇒ fv (scons x2 (scons x1 R)) (fv nvf (enc_nat n1)) = x1 $ by eq_trans [l82, l84]
l86: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R , x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) ⇒ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 R)) = x1 $ by eq_trans [l66, l85]
l87: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R ⇒ x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) → dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 R)) = x1 $ by imp_intro [l86]
l88: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R ⇒ ∀ x2 (x2 ∊ dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R) → dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 R)) = x1) $ by all_intro [l87]
l89: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R ⇒ cpi x2 (dt u (mcv H) (enc_expr (app (ind_ty (nonempty_D v) nz) (bvar nz))) w (scons x1 R)) (dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 R))) = cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1 $ by cpi_eq_pt [l55, l88]
l90: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R ⇒ dt u (mcv H) (enc_expr (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) (bvar n1))) w (scons x1 R) = cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1 $ by eq_trans [l30, l89]
l91: $ G , n = lv (enc_lvl v) w ⇒ x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R → dt u (mcv H) (enc_expr (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) (bvar n1))) w (scons x1 R) = cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1 $ by imp_intro [l90]
l92: $ G , n = lv (enc_lvl v) w ⇒ ∀ x1 (x1 ∊ dt u (mcv H) (enc_expr (srt v)) w R → dt u (mcv H) (enc_expr (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) (bvar n1))) w (scons x1 R) = cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1) $ by all_intro [l91]
l93: $ G , n = lv (enc_lvl v) w ⇒ cpi x1 (dt u (mcv H) (enc_expr (srt v)) w R) (dt u (mcv H) (enc_expr (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) (bvar n1))) w (scons x1 R)) = cpi x1 (fv uni n) (cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1) $ by cpi_eq_pt [l18, l92]
l94: $ G , n = lv (enc_lvl v) w ⇒ dt u (mcv H) (enc_expr (pi (srt v) (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) (bvar n1)))) w R = cpi x1 (fv uni n) (cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1) $ by eq_trans [l10, l93]
l95: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ uadm u $ by weaken [#1]
l96: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ hty ⊆ H $ by weaken [#2]
l97: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ hctor ⊆ H $ by weaken [#3]
l98: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ hrec ⊆ H $ by weaken [#4]
l99: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ functional H $ by weaken [#5]
l100: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ w ∊ lvals $ by weaken [#6]
l101: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ lv (enc_lvl v) w = n $ by weaken [l2]
l102: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ x1 ∊ fv uni n $ by ax
l103: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1 = tne x1 $ by fq2_e [l95, l96, l97, l98, l99, l100, l101, l102]
l104: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n , x2 ∊ ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1 ⇒ x1 = x1 $ by eq_refl
l105: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ x2 ∊ ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1 → x1 = x1 $ by imp_intro [l104]
l106: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ ∀ x2 (x2 ∊ ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1 → x1 = x1) $ by all_intro [l105]
l107: $ G , n = lv (enc_lvl v) w , x1 ∊ fv uni n ⇒ cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1 = cpi x2 (tne x1) x1 $ by cpi_eq_pt [l103, l106]
l108: $ G , n = lv (enc_lvl v) w ⇒ x1 ∊ fv uni n → cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1 = cpi x2 (tne x1) x1 $ by imp_intro [l107]
l109: $ G , n = lv (enc_lvl v) w ⇒ ∀ x1 (x1 ∊ fv uni n → cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1 = cpi x2 (tne x1) x1) $ by all_intro [l108]
l110: $ G , n = lv (enc_lvl v) w ⇒ fv uni n = fv uni n $ by eq_refl
l111: $ G , n = lv (enc_lvl v) w ⇒ cpi x1 (fv uni n) (cpi x2 (ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) x1) x1) = cpi x1 (fv uni n) (cpi x2 (tne x1) x1) $ by cpi_eq_pt [l110, l109]
l112: $ G , n = lv (enc_lvl v) w ⇒ chv n ∈ cpi x1 (fv uni n) (cpi x2 (tne x1) x1) $ by chv_cpi
l113: $ G , n = lv (enc_lvl v) w ⇒ chv n = chv (lv (enc_lvl v) w) $ by chv_eq [l1]
l114: $ G , n = lv (enc_lvl v) w ⇒ chv (lv (enc_lvl v) w) ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) (bvar n1)))) w R $ by wcel_eq_l [l113, wcel_eq_r [eq_sym [eq_trans [l94, l111]], l112]]
