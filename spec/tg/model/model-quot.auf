l1: $ G , x1 ∊ fv uni n ⇒ x1 ∊ fv uni n $ by ax
l2: $ G , x1 ∊ fv uni n ⇒ ap (clam a (fv uni n) (clam h (tne a) (ch a))) x1 = clam h (tne x1) (ch x1) $ by clam_ap [l1]
l3: $ G , x1 ∊ fv uni n , x2 ∊ tne x1 ⇒ x2 ∊ tne x1 $ by ax
l4: $ G , x1 ∊ fv uni n , x2 ∊ tne x1 ⇒ ap (clam h (tne x1) (ch x1)) x2 = ch x1 $ by clam_ap [l3]
l5: $ G , x1 ∊ fv uni n , x2 ∊ tne x1 ⇒ ∃ y (y ∊ x1) $ by tne_e [welc_wcel [l3]]
l6: $ G , x1 ∊ fv uni n , x2 ∊ tne x1 ⇒ ∃ y (y ∊ x1) → ch x1 ∈ x1 $ by ax_choice
l7: $ G , x1 ∊ fv uni n , x2 ∊ tne x1 ⇒ ch x1 ∈ x1 $ by imp_elim [l6, l5]
l8: $ G , x1 ∊ fv uni n , x2 ∊ tne x1 ⇒ ap (clam h (tne x1) (ch x1)) x2 ∈ x1 $ by wcel_eq_l [eq_sym [l4], l7]
l9: $ G , x1 ∊ fv uni n ⇒ x2 ∊ tne x1 → ap (clam h (tne x1) (ch x1)) x2 ∈ x1 $ by imp_intro [l8]
l10: $ G , x1 ∊ fv uni n ⇒ ∀ x2 (x2 ∊ tne x1 → ap (clam h (tne x1) (ch x1)) x2 ∈ x1) $ by all_intro [l9]
l11: $ G , x1 ∊ fv uni n , x2 ∊ tne x1 ⇒ isset (ch x1) $ by wcel_isset [l7]
l12: $ G , x1 ∊ fv uni n ⇒ x2 ∊ tne x1 → isset (ch x1) $ by imp_intro [l11]
l13: $ G , x1 ∊ fv uni n ⇒ ∀ x2 (x2 ∊ tne x1 → isset (ch x1)) $ by all_intro [l12]
l14: $ G , x1 ∊ fv uni n ⇒ h ∊ tne x1 → isset (ch x1) $ by all_elim [l13]
l15: $ G , x1 ∊ fv uni n ⇒ ∀ h (h ∊ tne x1 → isset (ch x1)) $ by all_intro [l14]
l16: $ G , x1 ∊ fv uni n ⇒ isset (tne x1) $ by tne_set
l17: $ G , x1 ∊ fv uni n ⇒ isset (clam h (tne x1) (ch x1)) $ by clam_set [l16, l15]
l18: $ G , x1 ∊ fv uni n ⇒ clam h (tne x1) (ch x1) ∈ cpi x2 (tne x1) x1 $ by f179_ci [l17, l10]
l19: $ G , x1 ∊ fv uni n ⇒ ap (clam a (fv uni n) (clam h (tne a) (ch a))) x1 ∈ cpi x2 (tne x1) x1 $ by wcel_eq_l [eq_sym [l2], l18]
l20: $ G ⇒ x1 ∊ fv uni n → ap (clam a (fv uni n) (clam h (tne a) (ch a))) x1 ∈ cpi x2 (tne x1) x1 $ by imp_intro [l19]
l21: $ G ⇒ ∀ x1 (x1 ∊ fv uni n → ap (clam a (fv uni n) (clam h (tne a) (ch a))) x1 ∈ cpi x2 (tne x1) x1) $ by all_intro [l20]
l22: $ G , x1 ∊ fv uni n ⇒ isset (clam h (tne x1) (ch x1)) $ by wcel_isset [l18]
l23: $ G ⇒ x1 ∊ fv uni n → isset (clam h (tne x1) (ch x1)) $ by imp_intro [l22]
l24: $ G ⇒ ∀ x1 (x1 ∊ fv uni n → isset (clam h (tne x1) (ch x1))) $ by all_intro [l23]
l25: $ G ⇒ a ∊ fv uni n → isset (clam h (tne a) (ch a)) $ by all_elim [l24]
l26: $ G ⇒ ∀ a (a ∊ fv uni n → isset (clam h (tne a) (ch a))) $ by all_intro [l25]
l27: $ G ⇒ isset (fv uni n) $ by uni_set
l28: $ G ⇒ isset (clam a (fv uni n) (clam h (tne a) (ch a))) $ by clam_set [l27, l26]
l29: $ G ⇒ clam a (fv uni n) (clam h (tne a) (ch a)) ∈ cpi x1 (fv uni n) (cpi x2 (tne x1) x1) $ by f179_ci [l28, l21]
l30: $ G ⇒ chv n ∈ cpi x1 (fv uni n) (cpi x2 (tne x1) x1) $ by weaken [l29]

