l58: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w ∅ , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) = x1 $ by weaken [l52]
