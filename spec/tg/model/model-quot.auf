l5: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) ⇒ ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) $ by ax
l6: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) ⇒ ¬ A ∈ two $ by and_elim_l [l5]
l7: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) ⇒ ∃ b (b ∊ Q ∧ x ∊ ap F b) $ by and_elim_r [l5]
l8: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) , b ∊ Q ∧ x ∊ ap F b ⇒ b ∊ Q ∧ x ∊ ap F b $ by ax
l9: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) , b ∊ Q ∧ x ∊ ap F b ⇒ Q = Q2 $ by weaken [#1]
l10: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) , b ∊ Q ∧ x ∊ ap F b ⇒ b ∊ Q2 $ by welc_eq [l9, and_elim_l [l8]]
l11: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) , b ∊ Q ∧ x ∊ ap F b ⇒ b ∊ Q2 ∧ x ∊ ap F b $ by and_intro [l10, and_elim_r [l8]]
l12: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) , b ∊ Q ∧ x ∊ ap F b ⇒ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) $ by ex_intro [l11]
l13: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) ⇒ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) $ by ex_elim [l7, l12]
l14: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) ⇒ ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) $ by and_intro [l6, l13]
l15: $ G , x ∊ qlift A F Q , ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) ⇒ (A ∈ two ∧ x ∊ ap F ∅) ∨ (¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b)) $ by or_intro_r [l14]
l16: $ G , x ∊ qlift A F Q ⇒ (A ∈ two ∧ x ∊ ap F ∅) ∨ (¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b)) $ by or_elim [l2, l4, l15]
l17: $ G , x ∊ qlift A F Q ⇒ x ∊ qlift A F Q2 $ by cab_intro [l16]
l18: $ G , x ∊ qlift A F Q2 ⇒ x ∊ qlift A F Q2 $ by ax
l19: $ G , x ∊ qlift A F Q2 ⇒ (A ∈ two ∧ x ∊ ap F ∅) ∨ (¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b)) $ by cab_elim [l18]
l20: $ G , x ∊ qlift A F Q2 , A ∈ two ∧ x ∊ ap F ∅ ⇒ A ∈ two ∧ x ∊ ap F ∅ $ by ax
l21: $ G , x ∊ qlift A F Q2 , A ∈ two ∧ x ∊ ap F ∅ ⇒ (A ∈ two ∧ x ∊ ap F ∅) ∨ (¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b)) $ by or_intro_l [l20]
l22: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) ⇒ ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) $ by ax
l23: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) ⇒ ¬ A ∈ two $ by and_elim_l [l22]
l24: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) ⇒ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) $ by and_elim_r [l22]
l25: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) , b ∊ Q2 ∧ x ∊ ap F b ⇒ b ∊ Q2 ∧ x ∊ ap F b $ by ax
l26: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) , b ∊ Q2 ∧ x ∊ ap F b ⇒ Q2 = Q $ by eq_sym [weaken [#1]]
l27: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) , b ∊ Q2 ∧ x ∊ ap F b ⇒ b ∊ Q $ by welc_eq [l26, and_elim_l [l25]]
l28: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) , b ∊ Q2 ∧ x ∊ ap F b ⇒ b ∊ Q ∧ x ∊ ap F b $ by and_intro [l27, and_elim_r [l25]]
l29: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) , b ∊ Q2 ∧ x ∊ ap F b ⇒ ∃ b (b ∊ Q ∧ x ∊ ap F b) $ by ex_intro [l28]
l30: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) ⇒ ∃ b (b ∊ Q ∧ x ∊ ap F b) $ by ex_elim [l24, l29]
l31: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) ⇒ ¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b) $ by and_intro [l23, l30]
l32: $ G , x ∊ qlift A F Q2 , ¬ A ∈ two ∧ ∃ b (b ∊ Q2 ∧ x ∊ ap F b) ⇒ (A ∈ two ∧ x ∊ ap F ∅) ∨ (¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b)) $ by or_intro_r [l31]
l33: $ G , x ∊ qlift A F Q2 ⇒ (A ∈ two ∧ x ∊ ap F ∅) ∨ (¬ A ∈ two ∧ ∃ b (b ∊ Q ∧ x ∊ ap F b)) $ by or_elim [l19, l21, l32]
