l148: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ w ∊ lvals $ by weaken [l2]
l149: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ t ∈ fseq u $ by weaken [l6]
l150: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot l)) w t = clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r)) $ by dt_quot_u [l146, l147, l148, l149, l11]
l151: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot l)) w t ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n)) $ by wcel_eq_l [eq_sym [l150], l145]
l152: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot l)) w t ∈ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (srt l)))) w t $ by wcel_eq_r [eq_sym [l144], l151]
l153: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l154: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ isset (enc_lvl l) $ by wcel_isset [l153]
l155: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ w ∊ lvals $ by weaken [l2]
l156: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ lv (enc_lvl l) w ∈ ω $ by lv_omega [l154, l155]
