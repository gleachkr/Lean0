lemma f183_sa (G: hyps) (M K S TE TA TK: class) (u w r: set): $ G ⇒ ra_spine ⟨ K , S ⟩ TE TK ∈ lrel $ > $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ TE ∈ trees ω $ > $ G ⇒ TA ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ isset TK $ > $ G ⇒ sarg u (dnf u M) ⟨ kc_app , scons TE (scons TA ∅) ⟩ w r = scons (dt u M TA w r) (sarg u (dnf u M) TE w r) $
----
l1: $ G , e = TE , a = TA , k = TK ⇒ e = TE $ by ax
l2: $ G , e = TE , a = TA , k = TK ⇒ a = TA $ by ax
l3: $ G , e = TE , a = TA , k = TK ⇒ k = TK $ by ax
l4: $ G , e = TE , a = TA , k = TK ⇒ ⟨ K , S ⟩ = ⟨ K , S ⟩ $ by eq_refl
l5: $ G , e = TE , a = TA , k = TK ⇒ ra_spine ⟨ K , S ⟩ TE TK = ra_spine ⟨ K , S ⟩ e k $ by ra_spine_eq [l4, eq_sym [l1], eq_sym [l3]]
l6: $ G , e = TE , a = TA , k = TK ⇒ ra_spine ⟨ K , S ⟩ TE TK ∈ lrel $ by weaken [#1]
l7: $ G , e = TE , a = TA , k = TK ⇒ ra_spine ⟨ K , S ⟩ e k ∈ lrel $ by wcel_eq_l [l5, l6]
l8: $ G , e = TE , a = TA , k = TK ⇒ TE ∈ trees ω $ by weaken [#5]
l9: $ G , e = TE , a = TA , k = TK ⇒ e ∈ trees ω $ by wcel_eq_l [eq_sym [l1], l8]
l10: $ G , e = TE , a = TA , k = TK ⇒ e ∊ trees ω $ by wcel_welc [l9]
l11: $ G , e = TE , a = TA , k = TK ⇒ TA ∈ trees ω $ by weaken [#6]
l12: $ G , e = TE , a = TA , k = TK ⇒ a ∈ trees ω $ by wcel_eq_l [eq_sym [l2], l11]
l13: $ G , e = TE , a = TA , k = TK ⇒ a ∊ trees ω $ by wcel_welc [l12]
l14: $ G , e = TE , a = TA , k = TK ⇒ ⟨ K , S ⟩ ∈ trees ω $ by weaken [#2]
l15: $ G , e = TE , a = TA , k = TK ⇒ ¬ K = kc_pi $ by weaken [#3]
l16: $ G , e = TE , a = TA , k = TK ⇒ ¬ K = kc_app $ by weaken [#4]
l17: $ G , e = TE , a = TA , k = TK ⇒ w ∊ lvals $ by weaken [#7]
l18: $ G , e = TE , a = TA , k = TK ⇒ r ∊ fseq u $ by weaken [#8]
l19: $ G , e = TE , a = TA , k = TK ⇒ sarg u (dnf u M) ⟨ kc_app , scons e (scons a ∅) ⟩ w r = scons (dt u M a w r) (sarg u (dnf u M) e w r) $ by sarg_app [l7, l14, l15, l16, l10, l13, l17, l18]
l20: $ G , e = TE , a = TA , k = TK ⇒ kc_app = kc_app $ by eq_refl
l21: $ G , e = TE , a = TA , k = TK ⇒ ∅ = ∅ $ by eq_refl
l22: $ G , e = TE , a = TA , k = TK ⇒ w = w $ by eq_refl
l23: $ G , e = TE , a = TA , k = TK ⇒ r = r $ by eq_refl
l24: $ G , e = TE , a = TA , k = TK ⇒ sarg u (dnf u M) ⟨ kc_app , scons TE (scons TA ∅) ⟩ w r = sarg u (dnf u M) ⟨ kc_app , scons e (scons a ∅) ⟩ w r $ by sarg_eq [opair_eq [l20, scons_eq [eq_sym [l1], scons_eq [eq_sym [l2], l21]]], l22, l23]
l25: $ G , e = TE , a = TA , k = TK ⇒ u = u $ by eq_refl
l26: $ G , e = TE , a = TA , k = TK ⇒ M = M $ by eq_refl
l27: $ G , e = TE , a = TA , k = TK ⇒ scons (dt u M a w r) (sarg u (dnf u M) e w r) = scons (dt u M TA w r) (sarg u (dnf u M) TE w r) $ by scons_eq [dt_eq [l25, l26, l2, l22, l23], sarg_eq [l1, l22, l23]]
l28: $ G , e = TE , a = TA , k = TK ⇒ sarg u (dnf u M) ⟨ kc_app , scons TE (scons TA ∅) ⟩ w r = scons (dt u M TA w r) (sarg u (dnf u M) TE w r) $ by eq_trans [l24, eq_trans [l19, l27]]
l29: $ G , e = TE , a = TA ⇒ isset TK $ by weaken [#9]
l30: $ G , e = TE , a = TA ⇒ sarg u (dnf u M) ⟨ kc_app , scons TE (scons TA ∅) ⟩ w r = scons (dt u M TA w r) (sarg u (dnf u M) TE w r) $ by isset_elim [l29, l28]
l31: $ G , e = TE ⇒ TA ∈ trees ω $ by weaken [#6]
l32: $ G , e = TE ⇒ isset TA $ by wcel_isset [l31]
l33: $ G , e = TE ⇒ sarg u (dnf u M) ⟨ kc_app , scons TE (scons TA ∅) ⟩ w r = scons (dt u M TA w r) (sarg u (dnf u M) TE w r) $ by isset_elim [l32, l30]
