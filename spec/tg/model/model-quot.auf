l102: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ cpi x3 (dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 ∅))) (dt u (mcv H) (enc_expr (Prop)) w (scons x3 (scons x2 (scons x1 ∅)))) = cpi x3 x1 (fv uni ∅) $ by cpi_eq_pt [l84, l101]
