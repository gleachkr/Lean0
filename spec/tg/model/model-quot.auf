l49: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP , t = TT , d = tr_nat_D , i = ⟨ kc_nz , ∅ ⟩ , ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d (scons i ∅) ⟩ n f g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g p t ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) f w r ∧ sarg u (dnf u M) f w r ∈ esat u (dsh u M r) q w ⇒ q = TQ $ by weaken [l6]
l50: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP , t = TT , d = tr_nat_D , i = ⟨ kc_nz , ∅ ⟩ , ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d (scons i ∅) ⟩ n f g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g p t ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) f w r ∧ sarg u (dnf u M) f w r ∈ esat u (dsh u M r) q w ⇒ sarg u (dnf u M) TF w r ∈ esat u (dsh u M r) TQ w $ by wcel_eq_r [esat_eq [l49, l46], l48]
l51: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP , t = TT , d = tr_nat_D , i = ⟨ kc_nz , ∅ ⟩ ⇒ sarg u (dnf u M) TF w r ∈ esat u (dsh u M r) TQ w $ by ex_elim [l42, l50]
l52: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP , t = TT , d = tr_nat_D ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l53: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP , t = TT , d = tr_nat_D ⇒ sarg u (dnf u M) TF w r ∈ esat u (dsh u M r) TQ w $ by isset_elim [l52, l51]
l54: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP , t = TT ⇒ isset tr_nat_D $ by opair_isset
l55: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP , t = TT ⇒ sarg u (dnf u M) TF w r ∈ esat u (dsh u M r) TQ w $ by isset_elim [l54, l53]
l56: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP ⇒ isset TT $ by weaken [#19]
l57: $ G , c = C , a = TA , f = TF , n = TN , q = TQ , p = TP ⇒ sarg u (dnf u M) TF w r ∈ esat u (dsh u M r) TQ w $ by isset_elim [l56, l55]
