l10: $ uadm u , w ∊ lvals , b ∊ fv uni (lv (enc_lvl v) w) , x ∊ b , y ∊ b ⇒ ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y $ by f190_e [l5, l1, l2, l3, l4, l6, l7, l8, l9]
l11: $ uadm u , w ∊ lvals , b ∊ fv uni (lv (enc_lvl v) w) , x ∊ b ⇒ y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y $ by imp_intro [l10]
l12: $ uadm u , w ∊ lvals , b ∊ fv uni (lv (enc_lvl v) w) ⇒ x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y $ by imp_intro [l11]
l13: $ uadm u , w ∊ lvals ⇒ b ∊ fv uni (lv (enc_lvl v) w) → x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y $ by imp_intro [l12]
l14: $ uadm u , w ∊ lvals ⇒ ∀ y (b ∊ fv uni (lv (enc_lvl v) w) → x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y) $ by all_intro [l13]
l15: $ uadm u , w ∊ lvals ⇒ ∀ x ∀ y (b ∊ fv uni (lv (enc_lvl v) w) → x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y) $ by all_intro [l14]
l16: $ uadm u , w ∊ lvals ⇒ ∀ b ∀ x ∀ y (b ∊ fv uni (lv (enc_lvl v) w) → x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y) $ by all_intro [l15]
l17: $ uadm u ⇒ w ∊ lvals → ∀ b ∀ x ∀ y (b ∊ fv uni (lv (enc_lvl v) w) → x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y) $ by imp_intro [l16]
l18: $ _ ⇒ uadm u → w ∊ lvals → ∀ b ∀ x ∀ y (b ∊ fv uni (lv (enc_lvl v) w) → x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D v) nz)) w ∅) b) x) y = teq x y) $ by imp_intro [l17]
