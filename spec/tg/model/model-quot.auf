lemma fq2_m (G: hyps) (H: class) (v: lvl) (u w: set): $ G ⇒ uadm u $ > $ G ⇒ hty ⊆ H $ > $ G ⇒ hctor ⊆ H $ > $ G ⇒ hrec ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $
