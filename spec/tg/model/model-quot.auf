l81: $ G , n = lv (enc_lvl v) w , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ , x2 ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 ∅) ⇒ isset x1 $ by isset_var
