z1: $ mdeq (mcv H) G (quot l) (quot l) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (srt l))) $ by mdeq_i [l9, l158]

--| @freshen G a
--| @freshen G r
--| @freshen G i
--| @freshen G j
--| @freshen G c
--| @freshen G x1
--| @freshen G x2
--| @freshen G x3
lemma f180_ty {a r i j c x1 x2 x3: set} (G: hyps) (n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c))) ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2))) $
----
l1: $ G , x1 ∊ fv uni n ⇒ x1 ∊ fv uni n $ by ax
l2: $ G , x1 ∊ fv uni n ⇒ ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c)))) x1 = clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c)) $ by clam_ap [l1]
l3: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) $ by ax
l4: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c))) x2 = clam c x1 (qmk x1 x2 c) $ by clam_ap [l3]
l5: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ x1 ⇒ x3 ∊ x1 $ by ax
l6: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ x1 ⇒ ap (clam c x1 (qmk x1 x2 c)) x3 = qmk x1 x2 x3 $ by clam_ap [l5]
l7: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ x1 ⇒ isset x1 $ by isset_var
l8: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ x1 ⇒ x3 ∊ x1 $ by weaken [l5]
l9: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ x1 ⇒ qmk x1 x2 x3 ∈ qty x1 x2 $ by qmk_in [l7, l8]
l10: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ x1 ⇒ ap (clam c x1 (qmk x1 x2 c)) x3 ∈ qty x1 x2 $ by wcel_eq_l [eq_sym [l6], l9]
l11: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ x3 ∊ x1 → ap (clam c x1 (qmk x1 x2 c)) x3 ∈ qty x1 x2 $ by imp_intro [l10]
l12: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ ∀ x3 (x3 ∊ x1 → ap (clam c x1 (qmk x1 x2 c)) x3 ∈ qty x1 x2) $ by all_intro [l11]
l13: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ x1 ⇒ isset (qmk x1 x2 x3) $ by wcel_isset [l9]
l14: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ x3 ∊ x1 → isset (qmk x1 x2 x3) $ by imp_intro [l13]
l15: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ ∀ x3 (x3 ∊ x1 → isset (qmk x1 x2 x3)) $ by all_intro [l14]
l16: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ c ∊ x1 → isset (qmk x1 x2 c) $ by all_elim [l15]
l17: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ ∀ c (c ∊ x1 → isset (qmk x1 x2 c)) $ by all_intro [l16]
l18: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ isset x1 $ by isset_var
l19: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ isset (clam c x1 (qmk x1 x2 c)) $ by clam_set [l18, l17]
l20: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ clam c x1 (qmk x1 x2 c) ∈ cpi x3 x1 (qty x1 x2) $ by f179_ci [l19, l12]
l21: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c))) x2 ∈ cpi x3 x1 (qty x1 x2) $ by wcel_eq_l [eq_sym [l4], l20]
l22: $ G , x1 ∊ fv uni n ⇒ x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c))) x2 ∈ cpi x3 x1 (qty x1 x2) $ by imp_intro [l21]
l23: $ G , x1 ∊ fv uni n ⇒ ∀ x2 (x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c))) x2 ∈ cpi x3 x1 (qty x1 x2)) $ by all_intro [l22]
l24: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) ⇒ isset (clam c x1 (qmk x1 x2 c)) $ by wcel_isset [l20]
l25: $ G , x1 ∊ fv uni n ⇒ x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → isset (clam c x1 (qmk x1 x2 c)) $ by imp_intro [l24]
l26: $ G , x1 ∊ fv uni n ⇒ ∀ x2 (x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → isset (clam c x1 (qmk x1 x2 c))) $ by all_intro [l25]
l27: $ G , x1 ∊ fv uni n ⇒ r ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → isset (clam c x1 (qmk x1 r c)) $ by all_elim [l26]
l28: $ G , x1 ∊ fv uni n ⇒ ∀ r (r ∊ cpi i x1 (cpi j x1 (fv uni ∅)) → isset (clam c x1 (qmk x1 r c))) $ by all_intro [l27]
l29: $ G , x1 ∊ fv uni n ⇒ isset (cpi i x1 (cpi j x1 (fv uni ∅))) $ by f179_qd
l30: $ G , x1 ∊ fv uni n ⇒ isset (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c))) $ by clam_set [l29, l28]
l31: $ G , x1 ∊ fv uni n ⇒ clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c)) ∈ cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2)) $ by f179_ci [l30, l23]
l32: $ G , x1 ∊ fv uni n ⇒ ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c)))) x1 ∈ cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2)) $ by wcel_eq_l [eq_sym [l2], l31]
l33: $ G ⇒ x1 ∊ fv uni n → ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c)))) x1 ∈ cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2)) $ by imp_intro [l32]
l34: $ G ⇒ ∀ x1 (x1 ∊ fv uni n → ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c)))) x1 ∈ cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2))) $ by all_intro [l33]
l35: $ G , x1 ∊ fv uni n ⇒ isset (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c))) $ by wcel_isset [l31]
l36: $ G ⇒ x1 ∊ fv uni n → isset (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c))) $ by imp_intro [l35]
l37: $ G ⇒ ∀ x1 (x1 ∊ fv uni n → isset (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (clam c x1 (qmk x1 r c)))) $ by all_intro [l36]
l38: $ G ⇒ a ∊ fv uni n → isset (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c))) $ by all_elim [l37]
l39: $ G ⇒ ∀ a (a ∊ fv uni n → isset (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c)))) $ by all_intro [l38]
l40: $ G ⇒ isset (fv uni n) $ by uni_set
l41: $ G ⇒ isset (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c)))) $ by clam_set [l40, l39]
l42: $ G ⇒ clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c))) ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2))) $ by f179_ci [l41, l34]

