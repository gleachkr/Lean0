l8: $ G ⇒ isset (teq X Y) $ by subset_isset [l7, l5]

--| @freshen G x
lemma f177_cs {x: set} (G: hyps) (A: class) (B: class x): $ G ⇒ isset A $ > $ G ⇒ ∀ x (x ∊ A → isset B) $ > $ G ⇒ isset (cpi x A B) $
----
l1: $ G , x ∊ A ⇒ ∀ x (x ∊ A → isset B) $ by weaken [#2]
l2: $ G , x ∊ A ⇒ x ∊ A → isset B $ by all_elim [l1]
l3: $ G , x ∊ A ⇒ x ∊ A $ by ax
l4: $ G , x ∊ A ⇒ isset B $ by imp_elim [l2, l3]
l5: $ G , x ∊ A ⇒ isset (⋃ B) $ by cuni_set [l4]
l6: $ G ⇒ x ∊ A → isset (⋃ B) $ by imp_intro [l5]
l7: $ G ⇒ ∀ x (x ∊ A → isset (⋃ B)) $ by all_intro [l6]
l8: $ G ⇒ isset (clam x A (⋃ B)) $ by clam_set [#1, l7]
l9: $ G ⇒ isset (cpi x A B) $ by cpi_set [l8]

