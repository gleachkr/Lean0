l119: $ G ⇒ isset (lv (enc_lvl v) w) $ by wcel_isset [l118]
l120: $ G ⇒ chv (lv (enc_lvl v) w) ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) (bvar n1)))) w R $ by isset_elim [l119, l114]
