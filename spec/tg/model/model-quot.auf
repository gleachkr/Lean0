closed0_den
-----------
l1: $ G , i ∊ fv nvf (enc_nat nz) ⇒ fv nvf (enc_nat nz) = ∅ $ by nvf_nz
l2: $ G , i ∊ fv nvf (enc_nat nz) ⇒ i ∊ fv nvf (enc_nat nz) $ by ax
l3: $ G , i ∊ fv nvf (enc_nat nz) ⇒ i ∊ ∅ $ by welc_eq [l1, l2]
l4: $ G , i ∊ fv nvf (enc_nat nz) ⇒ fv R i = fv R2 i $ by bot_elim [empty_elim [l3]]
l5: $ G ⇒ i ∊ fv nvf (enc_nat nz) → fv R i = fv R2 i $ by imp_intro [l4]
l6: $ G ⇒ ∀ i (i ∊ fv nvf (enc_nat nz) → fv R i = fv R2 i) $ by all_intro [l5]
l7: $ G ⇒ dt u M (enc_expr e) W R = dt u M (enc_expr e) W R2 $ by closed_den_c [#1, #2, #3, #4, l6]

teq_true
--------
l1: $ G , y ∊ teq X Y ⇒ y ∊ {y | (y = ∅) ∧ (X = Y)} $ by ax
l2: $ G , y ∊ teq X Y ⇒ (y = ∅) ∧ (X = Y) $ by cab_elim [l1]
l3: $ G , y ∊ teq X Y ⇒ y ∊ csn ∅ $ by csn_intro [and_elim_l [l2]]
l4: $ G , y ∊ csn ∅ ⇒ y ∊ csn ∅ $ by ax
l5: $ G , y ∊ csn ∅ ⇒ y = ∅ $ by csn_elim [l4]
l6: $ G , y ∊ csn ∅ ⇒ X = Y $ by weaken [#1]
l7: $ G , y ∊ csn ∅ ⇒ (y = ∅) ∧ (X = Y) $ by and_intro [l5, l6]
l8: $ G , y ∊ csn ∅ ⇒ y ∊ {y | (y = ∅) ∧ (X = Y)} $ by cab_intro [l7]
l9: $ G , y ∊ csn ∅ ⇒ y ∊ teq X Y $ by weaken [l8]
l10: $ G ⇒ teq X Y = csn ∅ $ by eq_intro [l3, l9]

qmk_rel_eq
----------
l1: $ G , A ∈ two ⇒ A ∈ two $ by ax
l2: $ G , A ∈ two ⇒ qmk A R a = ∅ $ by qmk_prop [l1]
l3: $ G , A ∈ two ⇒ qmk A R b = ∅ $ by qmk_prop [l1]
l4: $ G , A ∈ two ⇒ qmk A R a = qmk A R b $ by eq_trans [l2, eq_sym [l3]]
l5: $ G , ¬ A ∈ two ⇒ ¬ A ∈ two $ by ax
l6: $ G , ¬ A ∈ two ⇒ qmk A R a = qcl A R a $ by qmk_cls [l5]
l7: $ G , ¬ A ∈ two ⇒ qmk A R b = qcl A R b $ by qmk_cls [l5]
l8: $ G , ¬ A ∈ two ⇒ b ∊ qcl A R a $ by qcl_rel [weaken [#3], weaken [#4]]
l9: $ G , ¬ A ∈ two ⇒ qcl A R b = qcl A R a $ by qcl_eq [weaken [#1], weaken [#2], l8]
l10: $ G , ¬ A ∈ two ⇒ qmk A R a = qmk A R b $ by eq_trans [l6, eq_trans [eq_sym [l9], eq_sym [l7]]]
l11: $ G ⇒ A ∈ two ∨ ¬ A ∈ two $ by excluded_middle
l12: $ G ⇒ (A ∈ two ∨ ¬ A ∈ two) → qmk A R a = qmk A R b $ by or_elim_imp [imp_intro [l4], imp_intro [l10]]
l13: $ G ⇒ qmk A R a = qmk A R b $ by imp_elim [l12, l11]

lemma fq1_ph {i: set} (G: hyps) (F: class) (a b z: set): $ G ⇒ a ∊ two $ > $ G ⇒ b ∊ two $ > $ G ⇒ F ∈ cpi i a b $ > $ G ⇒ z ∊ a $ > $ G ⇒ z ∊ b $
----
l1: $ G , f = F , f ∊ cpi i a b ⇒ f ∊ cpi i a b $ by ax
l2: $ G , f = F , f ∊ cpi i a b ⇒ z ∊ a $ by weaken [#4]
l3: $ G , f = F , f ∊ cpi i a b ⇒ ap f z ∈ b $ by cpi_elim_ap [l1, l2]
l4: $ G , f = F , f ∊ cpi i a b , e = ap f z , e ∊ b ⇒ e ∊ b $ by ax
l5: $ G , f = F , f ∊ cpi i a b , e = ap f z , e ∊ b ⇒ e = ∅ $ by two_mem_empty [welc_wcel [weaken [#2]], l4]
l6: $ G , f = F , f ∊ cpi i a b , e = ap f z , e ∊ b ⇒ z = ∅ $ by two_mem_empty [welc_wcel [weaken [#1]], weaken [#4]]
l7: $ G , f = F , f ∊ cpi i a b , e = ap f z , e ∊ b ⇒ e = z $ by eq_trans [l5, eq_sym [l6]]
l8: $ G , f = F , f ∊ cpi i a b , e = ap f z , e ∊ b ⇒ z ∊ b $ by welc_eq_set [l7, l4]
l9: $ G , f = F , f ∊ cpi i a b ⇒ z ∊ b $ by wcel_elim [l3, l8]
l10: $ G ⇒ z ∊ b $ by wcel_elim [#3, l9]

two_iff_eq
----------
h1: $ G , z ∊ a ⇒ z ∊ a $ by ax
l1: $ G , z ∊ a ⇒ z ∊ b $ by fq1_ph [weaken [#1], weaken [#2], weaken [#3], h1]
h2: $ G , z ∊ b ⇒ z ∊ b $ by ax
l2: $ G , z ∊ b ⇒ z ∊ a $ by fq1_ph [weaken [#2], weaken [#1], weaken [#4], h2]
l3: $ G ⇒ a = b $ by eq_intro [l1, l2]

quot_sound_inh
--------------
l1: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ uadm u $ by ax
l2: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ w ∊ lvals $ by ax
l3: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ t ∊ sat u (mcv H) (enc_ctx G) w $ by ax
l4: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ sat u (mcv H) (enc_ctx G) w ⊆ fseq u $ by sat_fseq
l5: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ t ∊ fseq u $ by subset_elim [l4, l3]
l6: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ t ∈ fseq u $ by welc_wcel [l5]
l7: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ w ∈ lvals $ by welc_wcel [l2]
l8: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ hqu H $ by weaken [#1]
l9: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ meqs (mcv H) l $ by weaken [#2]
l10: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ n = lv (enc_lvl l) w $ by ax
l11: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ lv (enc_lvl l) w = n $ by eq_sym [l10]
l12: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ w ∊ lvals $ by weaken [l2]
l13: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l14: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ isset (enc_lvl l) $ by wcel_isset [l13]
l15: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ lv (enc_lvl l) w ∈ ω $ by lv_omega [l14, l12]
l16: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ n ∈ ω $ by wcel_eq_l [l11, l15]
l17: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ n ∊ ω $ by wcel_welc [l16]
l18: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ w ∈ lvals $ by weaken [l7]
l19: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ t ∈ fseq u $ by weaken [l6]
l20: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ enc_expr (srt l) ∈ trees ω $ by enc_expr_trees
l21: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (pi (bvar n2) (pi (app (app (bvar n2) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D l) nz) (app (app (quot l) (bvar n4)) (bvar n3))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n2))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n1))))))) ∈ trees ω $ by enc_expr_trees
l22: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (pi (bvar n2) (pi (app (app (bvar n2) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D l) nz) (app (app (quot l) (bvar n4)) (bvar n3))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n2))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n1))))))))) w t = cpi x1 (dt u (mcv H) (enc_expr (srt l)) w t) (dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (pi (bvar n2) (pi (app (app (bvar n2) (bvar n1)) (bvar nz)) (app (app (app (ind_ty (eq_D l) nz) (app (app (quot l) (bvar n4)) (bvar n3))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n2))) (app (app (app (quot_mk l) (bvar n4)) (bvar n3)) (bvar n1)))))))) w (scons x1 t)) $ by dt_pi_c [l20, l21, l18, l19]
l23: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ w ∈ lvals $ by weaken [l7]
