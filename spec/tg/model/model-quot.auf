l25: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l26: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (srt l)) w t = fv uni (lv (enc_lvl l) w) $ by dt_srt_c [l25, l23, l24]
l27: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ lv (enc_lvl l) w = n $ by weaken [l11]
