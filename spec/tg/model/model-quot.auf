l135: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) ⇒ fv uni (lv (enc_lvl l) w) = fv uni n $ by fv_eq [l134, l133]
l136: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) ⇒ dt u (mcv H) (enc_expr (srt l)) w (scons x2 (scons x1 t)) = fv uni n $ by eq_trans [l132, l135]
l137: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t ⇒ x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) → dt u (mcv H) (enc_expr (srt l)) w (scons x2 (scons x1 t)) = fv uni n $ by imp_intro [l136]
l138: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t ⇒ ∀ x2 (x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) → dt u (mcv H) (enc_expr (srt l)) w (scons x2 (scons x1 t)) = fv uni n) $ by all_intro [l137]
l139: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t ⇒ cpi x2 (dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t)) (dt u (mcv H) (enc_expr (srt l)) w (scons x2 (scons x1 t))) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n) $ by cpi_eq_pt [l121, l138]
l140: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t ⇒ dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (srt l))) w (scons x1 t) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n) $ by eq_trans [l42, l139]
l141: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t → dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (srt l))) w (scons x1 t) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n) $ by imp_intro [l140]
l142: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ ∀ x1 (x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t → dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (srt l))) w (scons x1 t) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n)) $ by all_intro [l141]
l143: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ cpi x1 (dt u (mcv H) (enc_expr (srt l)) w t) (dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (srt l))) w (scons x1 t)) = cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n)) $ by cpi_eq_pt [l30, l142]
l144: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (srt l)))) w t = cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n)) $ by eq_trans [l22, l143]
l145: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r)) ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (fv uni n)) $ by f179_ty [l17]
l146: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ uadm u $ by weaken [l1]
