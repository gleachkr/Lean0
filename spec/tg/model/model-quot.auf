l24: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w ∅ ⇒ ∅ ∈ fseq u $ by weaken [l2]
l25: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w ∅ ⇒ scons x1 ∅ ∈ fseq u $ by dt_scons_fseq [l22, l23, l24, l21]
l26: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w ∅ ⇒ dt u (mcv H) (enc_expr (srt l)) w ∅ = fv uni n $ by weaken [l20]
l27: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w ∅ ⇒ x1 ∊ fv uni n $ by welc_eq [l26, l21]
l28: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w ∅ ⇒ w ∈ lvals $ by weaken [l1]
l29: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w ∅ ⇒ scons x1 ∅ ∈ fseq u $ by weaken [l25]
