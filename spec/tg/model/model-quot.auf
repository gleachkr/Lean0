tne_congr
---------
g1: $ (h = ∅) ⟺ (h = ∅) $ by iff_refl
g2: $ seqt y y $ by seqt_refl
g3: $ (y ∊ A) ⟺ (y ∊ B) $ by welc_congr [g2, #1]
g4: $ (∃ y (y ∊ A)) ⟺ (∃ y (y ∊ B)) $ by ex_congr [g3]
g5: $ ((h = ∅) ∧ (∃ y (y ∊ A))) ⟺ ((h = ∅) ∧ (∃ y (y ∊ B))) $ by and_congr [g1, g4]
g6: $ tne A ≐ tne B $ by cab_congr [g5]

sb_c_tne
