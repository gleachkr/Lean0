l90: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , i ∊ dt u (mcv H) (enc_expr (bvar nz)) w (scons x1 t) ⇒ isset ∅ $ by ax_empty
