lemma f183_ec (G: hyps) (E A P X Q: class) (u w: set): $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ isset X $ > $ G ⇒ Q ∈ fseq u $ > $ G ⇒ scons X Q ∈ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ > $ G ⇒ Q ∈ esat u E P w ∧ X ∈ da (fv E A) w Q $
----
l1: $ G , e = scons X Q , a = X , b = Q ⇒ e = scons X Q $ by ax
l2: $ G , e = scons X Q , a = X , b = Q ⇒ a = X $ by ax
l3: $ G , e = scons X Q , a = X , b = Q ⇒ b = Q $ by ax
l4: $ G , e = scons X Q , a = X , b = Q ⇒ scons X Q ∈ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by weaken [#6]
l5: $ G , e = scons X Q , a = X , b = Q ⇒ e ∈ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by wcel_eq_l [eq_sym [l1], l4]
l6: $ G , e = scons X Q , a = X , b = Q ⇒ e ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by wcel_welc [l5]
l7: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ q ∊ esat u E P w $ by ax
l8: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ x ∊ da (fv E A) w q $ by ax
l9: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ e = scons x q $ by ax
l10: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ a = X $ by weaken [l2]
l11: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ b = Q $ by weaken [l3]
l12: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ e = scons X Q $ by weaken [l1]
l13: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ scons a b = scons x q $ by eq_trans [scons_eq [l10, l11], eq_trans [eq_sym [l12], l9]]
l14: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ b = Q $ by weaken [l3]
l15: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ Q ∈ fseq u $ by weaken [#5]
l16: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ b ∈ fseq u $ by wcel_eq_l [eq_sym [l14], l15]
l17: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ b ∊ fseq u $ by wcel_welc [l16]
l18: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ esat u E P w ⊆ fseq u $ by esat_fseq
l19: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ q ∊ fseq u $ by subset_elim [l18, l7]
l20: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ a = x ∧ b = q $ by scons_inj [fseq_rel [l17], fseq_rel [l19], l13]
l21: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ a = x $ by and_elim_l [l20]
l22: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ b = q $ by and_elim_r [l20]
l23: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ b = Q $ by weaken [l3]
l24: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ q = Q $ by eq_trans [eq_sym [l22], l23]
l25: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ a = X $ by weaken [l2]
l26: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ x = X $ by eq_trans [eq_sym [l21], l25]
l27: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ q ∈ esat u E P w $ by welc_wcel [l7]
l28: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ Q ∈ esat u E P w $ by wcel_eq_l [l24, l27]
l29: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ x ∈ da (fv E A) w q $ by welc_wcel [l8]
l30: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ X ∈ da (fv E A) w q $ by wcel_eq_l [l26, l29]
l31: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ fv E A = fv E A $ by eq_refl
l32: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ w = w $ by eq_refl
l33: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ X ∈ da (fv E A) w Q $ by wcel_eq_r [da_eq [l31, l32, l24], l30]
l34: $ G , e = scons X Q , a = X , b = Q , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ Q ∈ esat u E P w ∧ X ∈ da (fv E A) w Q $ by and_intro [l28, l33]
l35: $ G , e = scons X Q , a = X , b = Q ⇒ A ∈ trees ω $ by weaken [#1]
l36: $ G , e = scons X Q , a = X , b = Q ⇒ P ∈ trees ω $ by weaken [#2]
l37: $ G , e = scons X Q , a = X , b = Q ⇒ w ∊ lvals $ by weaken [#3]
l38: $ G , e = scons X Q , a = X , b = Q ⇒ Q ∈ esat u E P w ∧ X ∈ da (fv E A) w Q $ by esat_cons_elim [l35, l36, l37, l6, l34]
l39: $ G , e = scons X Q , a = X ⇒ Q ∈ fseq u $ by weaken [#5]
l40: $ G , e = scons X Q , a = X ⇒ isset Q $ by wcel_isset [l39]
l41: $ G , e = scons X Q , a = X ⇒ Q ∈ esat u E P w ∧ X ∈ da (fv E A) w Q $ by isset_elim [l40, l38]
l42: $ G , e = scons X Q ⇒ isset X $ by weaken [#4]
l43: $ G , e = scons X Q ⇒ Q ∈ esat u E P w ∧ X ∈ da (fv E A) w Q $ by isset_elim [l42, l41]
l44: $ G ⇒ Q ∈ fseq u $ by weaken [#5]
l45: $ G ⇒ isset Q $ by wcel_isset [l44]
l46: $ G ⇒ isset (scons X Q) $ by scons_set [l45]
l47: $ G ⇒ Q ∈ esat u E P w ∧ X ∈ da (fv E A) w Q $ by isset_elim [l46, l43]

