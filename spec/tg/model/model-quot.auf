l33: $ G ⇒ ap F b = ap F a $ by and_elim_r [l32]

qlift_mk
--------
l1: $ G , A ∈ two ⇒ A ∈ two $ by ax
l2: $ G , A ∈ two ⇒ a ∊ A $ by weaken [#2]
l3: $ G , A ∈ two ⇒ a = ∅ $ by two_mem_empty [l1, l2]
l4: $ G , A ∈ two ⇒ qlift A F (qmk A R a) = ap F ∅ $ by qlift_prop [l1]
l5: $ G , A ∈ two ⇒ F = F $ by eq_refl
l6: $ G , A ∈ two ⇒ qlift A F (qmk A R a) = ap F a $ by eq_trans [l4, ap_eq [l5, eq_sym [l3]]]
l7: $ G , ¬ A ∈ two ⇒ ¬ A ∈ two $ by ax
l8: $ G , ¬ A ∈ two ⇒ qmk A R a = qcl A R a $ by qmk_cls [l7]
l9: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) ⇒ x ∊ qlift A F (qmk A R a) $ by ax
l10: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) ⇒ (A ∈ two ∧ x ∊ ap F ∅) ∨ (¬ A ∈ two ∧ ∃ b (b ∊ (qmk A R a) ∧ x ∊ ap F b)) $ by cab_elim [l9]
l11: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , A ∈ two ∧ x ∊ ap F ∅ ⇒ A ∈ two ∧ x ∊ ap F ∅ $ by ax
l12: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , A ∈ two ∧ x ∊ ap F ∅ ⇒ ¬ A ∈ two $ by weaken [l7]
l13: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , A ∈ two ∧ x ∊ ap F ∅ ⇒ A ∈ two $ by and_elim_l [l11]
l14: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , A ∈ two ∧ x ∊ ap F ∅ ⇒ ⊥ $ by not_elim [l12, l13]
l15: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , A ∈ two ∧ x ∊ ap F ∅ ⇒ x ∊ ap F a $ by bot_elim [l14]
l16: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) ⇒ ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) $ by ax
l17: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) ⇒ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) $ by and_elim_r [l16]
l18: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ b ∊ qmk A R a ∧ x ∊ ap F b $ by ax
l19: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ b ∊ qmk A R a $ by and_elim_l [l18]
l20: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ x ∊ ap F b $ by and_elim_r [l18]
l21: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ qmk A R a = qcl A R a $ by weaken [l8]
l22: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ b ∊ qcl A R a $ by welc_eq [l21, l19]
l23: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ isset A $ by weaken [#1]
l24: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ a ∊ A $ by weaken [#2]
l25: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ qresp A R F $ by weaken [#3]
l26: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ ap F b = ap F a $ by f177_c [l23, l24, l25, l22]
l27: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) , b ∊ qmk A R a ∧ x ∊ ap F b ⇒ x ∊ ap F a $ by welc_eq [l26, l20]
l28: $ G , ¬ A ∈ two , x ∊ qlift A F (qmk A R a) , ¬ A ∈ two ∧ ∃ b (b ∊ qmk A R a ∧ x ∊ ap F b) ⇒ x ∊ ap F a $ by ex_elim [l17, l27]
