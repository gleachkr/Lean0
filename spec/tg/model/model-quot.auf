l12: $ G ⇒ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1)))))) w ∅ = cpi x1 (dt u (mcv H) (enc_expr (srt l)) w ∅) (dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1))))) w (scons x1 ∅)) $ by dt_pi_c [l10, l11, l8, l9]
l13: $ G ⇒ w ∈ lvals $ by weaken [l1]
l14: $ G ⇒ ∅ ∈ fseq u $ by weaken [l2]
