l582: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x1 ∊ fv uni ∅ , x2 ∊ fv uni ∅ , x3 ∊ ap (ap (dt u (mcv H) (enc_expr (ind_ty iff_D nz)) w t) x1) x2 ⇒ ∀ x6 (x6 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x3 (scons x2 (scons x1 t))) → dt u (mcv H) (enc_expr (bvar n3)) w (scons x6 (scons x3 (scons x2 (scons x1 t)))) = x1) $ by all_intro [l581]
l583: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , x1 ∊ fv uni ∅ , x2 ∊ fv uni ∅ , x3 ∊ ap (ap (dt u (mcv H) (enc_expr (ind_ty iff_D nz)) w t) x1) x2 ⇒ cpi x6 (dt u (mcv H) (enc_expr (bvar n1)) w (scons x3 (scons x2 (scons x1 t)))) (dt u (mcv H) (enc_expr (bvar n3)) w (scons x6 (scons x3 (scons x2 (scons x1 t))))) = cpi x6 x2 x1 $ by cpi_eq_pt [l531, l582]
