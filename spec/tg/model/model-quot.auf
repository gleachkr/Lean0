l137: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk , p = enc_ctx (cons (srt v) nil) , t = enc_tys (tcons Prop (ccons (pi (bvar nz) (app (bvar n2) (bvar n1))) cnil) tnil) , i = enc_nat nz ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $ by isset_elim [l136, l134]
l138: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk , p = enc_ctx (cons (srt v) nil) , t = enc_tys (tcons Prop (ccons (pi (bvar nz) (app (bvar n2) (bvar n1))) cnil) tnil) ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l139: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk , p = enc_ctx (cons (srt v) nil) , t = enc_tys (tcons Prop (ccons (pi (bvar nz) (app (bvar n2) (bvar n1))) cnil) tnil) ⇒ isset (enc_nat nz) $ by wcel_isset [l138]
l140: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk , p = enc_ctx (cons (srt v) nil) , t = enc_tys (tcons Prop (ccons (pi (bvar nz) (app (bvar n2) (bvar n1))) cnil) tnil) ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $ by isset_elim [l139, l137]
l141: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk , p = enc_ctx (cons (srt v) nil) ⇒ enc_tys (tcons Prop (ccons (pi (bvar nz) (app (bvar n2) (bvar n1))) cnil) tnil) ∈ trees ω $ by enc_tys_trees
l142: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk , p = enc_ctx (cons (srt v) nil) ⇒ isset (enc_tys (tcons Prop (ccons (pi (bvar nz) (app (bvar n2) (bvar n1))) cnil) tnil)) $ by wcel_isset [l141]
l143: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk , p = enc_ctx (cons (srt v) nil) ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $ by isset_elim [l142, l140]
l144: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk ⇒ enc_ctx (cons (srt v) nil) ∈ trees ω $ by enc_ctx_trees
l145: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk ⇒ isset (enc_ctx (cons (srt v) nil)) $ by wcel_isset [l144]
l146: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) , b = enc_blk nonempty_blk ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $ by isset_elim [l145, l143]
l147: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) ⇒ enc_blk nonempty_blk ∈ trees ω $ by enc_blk_trees
l148: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) ⇒ isset (enc_blk nonempty_blk) $ by wcel_isset [l147]
l149: $ G , g = enc_ctx nil , d = enc_ind (nonempty_D v) ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $ by isset_elim [l148, l146]
l150: $ G , g = enc_ctx nil ⇒ enc_ind (nonempty_D v) ∈ trees ω $ by enc_ind_trees
l151: $ G , g = enc_ctx nil ⇒ isset (enc_ind (nonempty_D v)) $ by wcel_isset [l150]
l152: $ G , g = enc_ctx nil ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $ by isset_elim [l151, l149]
l153: $ G ⇒ enc_ctx nil ∈ trees ω $ by enc_ctx_trees
l154: $ G ⇒ isset (enc_ctx nil) $ by wcel_isset [l153]
l155: $ G ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $ by isset_elim [l154, l152]

lemma tne_two (G: hyps) (A: class): $ G ⇒ tne A ∈ two $
----
l1: $ G , ∃ y (y ∊ A) , h ∊ tne A ⇒ h ∊ tne A $ by ax
l2: $ G , ∃ y (y ∊ A) , h ∊ tne A ⇒ (h = ∅) ∧ (∃ y (y ∊ A)) $ by cab_elim [l1]
l3: $ G , ∃ y (y ∊ A) , h ∊ tne A ⇒ h ∊ csn ∅ $ by csn_intro [and_elim_l [l2]]
l4: $ G , ∃ y (y ∊ A) , h ∊ csn ∅ ⇒ h ∊ csn ∅ $ by ax
l5: $ G , ∃ y (y ∊ A) , h ∊ csn ∅ ⇒ h = ∅ $ by csn_elim [l4]
l6: $ G , ∃ y (y ∊ A) , h ∊ csn ∅ ⇒ ∃ y (y ∊ A) $ by ax
l7: $ G , ∃ y (y ∊ A) , h ∊ csn ∅ ⇒ h ∊ tne A $ by cab_intro [and_intro [l5, l6]]
l8: $ G , ∃ y (y ∊ A) ⇒ tne A = csn ∅ $ by eq_intro [l3, l7]
l9: $ G , ∃ y (y ∊ A) ⇒ csn ∅ ∈ two $ by two_intro_r
l10: $ G , ∃ y (y ∊ A) ⇒ tne A ∈ two $ by wcel_eq_l [eq_sym [l8], l9]
l11: $ G , ¬ ∃ y (y ∊ A) , h ∊ tne A ⇒ h ∊ tne A $ by ax
l12: $ G , ¬ ∃ y (y ∊ A) , h ∊ tne A ⇒ (h = ∅) ∧ (∃ y (y ∊ A)) $ by cab_elim [l11]
l13: $ G , ¬ ∃ y (y ∊ A) , h ∊ tne A ⇒ ∃ y (y ∊ A) $ by and_elim_r [l12]
l14: $ G , ¬ ∃ y (y ∊ A) , h ∊ tne A ⇒ ¬ ∃ y (y ∊ A) $ by ax
l15: $ G , ¬ ∃ y (y ∊ A) , h ∊ tne A ⇒ ⊥ $ by not_elim [l14, l13]
l16: $ G , ¬ ∃ y (y ∊ A) ⇒ tne A = ∅ $ by empty_eq_intro [l15]
l17: $ G , ¬ ∃ y (y ∊ A) ⇒ ∅ ∈ two $ by two_intro_l
l18: $ G , ¬ ∃ y (y ∊ A) ⇒ tne A ∈ two $ by wcel_eq_l [eq_sym [l16], l17]
l19: $ G ⇒ ∃ y (y ∊ A) ∨ ¬ ∃ y (y ∊ A) $ by excluded_middle
l20: $ G ⇒ tne A ∈ two $ by or_elim [l19, l10, l18]

lemma tne_set (G: hyps) (A: class): $ G ⇒ isset (tne A) $
----
l1: $ G ⇒ tne A ∈ two $ by tne_two
l2: $ G ⇒ isset (tne A) $ by wcel_isset [l1]

lemma tne_e {y: set} (G: hyps) (A X: class): $ G ⇒ X ∈ tne A $ > $ G ⇒ ∃ y (y ∊ A) $
----
l1: $ G , a = X ⇒ a = X $ by ax
l2: $ G , a = X ⇒ X ∈ tne A $ by weaken [#1]
l3: $ G , a = X ⇒ a ∊ tne A $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , a = X ⇒ (a = ∅) ∧ (∃ y (y ∊ A)) $ by cab_elim [l3]
l5: $ G , a = X ⇒ ∃ y (y ∊ A) $ by and_elim_r [l4]
l6: $ G ⇒ isset X $ by wcel_isset [#1]
l7: $ G ⇒ ∃ y (y ∊ A) $ by isset_elim [l6, l5]

lemma tne_i (G: hyps) (A: class) (a: set): $ G ⇒ a ∊ A $ > $ G ⇒ ∅ ∈ tne A $
----
l1: $ G , z = ∅ ⇒ z = ∅ $ by ax
l2: $ G , z = ∅ ⇒ a ∊ A $ by weaken [#1]
l3: $ G , z = ∅ ⇒ ∃ y (y ∊ A) $ by ex_intro [l2]
l4: $ G , z = ∅ ⇒ z ∊ tne A $ by cab_intro [and_intro [l1, l3]]
l5: $ G , z = ∅ ⇒ ∅ ∈ tne A $ by wcel_intro [l1, l4]
l6: $ G ⇒ isset ∅ $ by ax_empty
l7: $ G ⇒ ∅ ∈ tne A $ by isset_elim [l6, l5]

lemma fq2_at (G: hyps) (H R: class) (v: lvl) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w R = dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ $
----
l1: $ G ⇒ kc_ind_ty ∈ kexa $ by kexa_ind_ty
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l4: $ G ⇒ enc_ind (nonempty_D v) ∈ trees ω $ by enc_ind_trees
l5: $ G ⇒ scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) ∅) ∈ fseq (trees ω) $ by scons_fseq_c [l4, scons_fseq_c [l3, l2]]
l6: $ G ⇒ w ∈ lvals $ by welc_wcel [#1]
l7: $ G ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) ∅) ⟩ w R = mclip u (ap (fv (mcv H) ⟨ u , ⟨ kc_ind_ty , ⟨ scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) ∅) , ccom (dnf u (mcv H)) (scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) ∅)) ⟩ ⟩ ⟩) w) $ by dt_atom_c [l1, l5, l6, #2]
l8: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l9: $ G ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) ∅) ⟩ w ∅ = mclip u (ap (fv (mcv H) ⟨ u , ⟨ kc_ind_ty , ⟨ scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) ∅) , ccom (dnf u (mcv H)) (scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) ∅)) ⟩ ⟩ ⟩) w) $ by dt_atom_c [l1, l5, l6, l8]
l10: $ G ⇒ dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w R = dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ $ by eq_trans [l7, eq_sym [l9]]

lemma fq2_ac (G: hyps) (H R: class) (v: lvl) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w R = dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ $
----
l1: $ G ⇒ kc_ind_ctor ∈ kexa $ by kexa_ind_ctor
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l4: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l5: $ G ⇒ enc_ind (nonempty_D v) ∈ trees ω $ by enc_ind_trees
l6: $ G ⇒ scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [l5, scons_fseq_c [l4, scons_fseq_c [l3, l2]]]
l7: $ G ⇒ w ∈ lvals $ by welc_wcel [#1]
l8: $ G ⇒ dt u (mcv H) ⟨ kc_ind_ctor , scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) ⟩ w R = mclip u (ap (fv (mcv H) ⟨ u , ⟨ kc_ind_ctor , ⟨ scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) , ccom (dnf u (mcv H)) (scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅))) ⟩ ⟩ ⟩) w) $ by dt_atom_c [l1, l6, l7, #2]
l9: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l10: $ G ⇒ dt u (mcv H) ⟨ kc_ind_ctor , scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) ⟩ w ∅ = mclip u (ap (fv (mcv H) ⟨ u , ⟨ kc_ind_ctor , ⟨ scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅)) , ccom (dnf u (mcv H)) (scons (enc_ind (nonempty_D v)) (scons (enc_nat nz) (scons (enc_nat nz) ∅))) ⟩ ⟩ ⟩) w) $ by dt_atom_c [l1, l6, l7, l9]
l11: $ G ⇒ dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w R = dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ $ by eq_trans [l8, eq_sym [l10]]

lemma fq2_e (G: hyps) (H: class) (v: lvl) (u w n b: set): $ G ⇒ uadm u $ > $ G ⇒ hty ⊆ H $ > $ G ⇒ hctor ⊆ H $ > $ G ⇒ hrec ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lv (enc_lvl v) w = n $ > $ G ⇒ b ∊ fv uni n $ > $ G ⇒ ap (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅) b = tne b $
----
l1: $ G ⇒ (dt u (mcv H) (enc_expr (ind_ty (nonempty_D v) nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) Prop)) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_ctor (nonempty_D v) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (bvar nz) (app (ind_ty (nonempty_D v) nz) (bvar n1))))) w ∅) ∧ (dt u (mcv H) (enc_expr (ind_rec (nonempty_D v) nz lz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt v) (pi (pi (app (ind_ty (nonempty_D v) nz) (bvar nz)) Prop) (pi (pi (bvar n1) (app (bvar n1) (app (app (ind_ctor (nonempty_D v) nz nz) (bvar n2)) (bvar nz)))) (pi (app (ind_ty (nonempty_D v) nz) (bvar n2)) (app (bvar n2) (bvar nz))))))) w ∅) $ by fq2_m [#1, #2, #3, #4, #5, #6]
l2: $ G ⇒ w ∈ lvals $ by welc_wcel [#6]
l3: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l4: $ G ⇒ w ∈ lvals $ by weaken [l2]
l5: $ G ⇒ ∅ ∈ fseq u $ by weaken [l3]
l6: $ G ⇒ enc_expr (srt v) ∈ trees ω $ by enc_expr_trees
l7: $ G ⇒ enc_expr (Prop) ∈ trees ω $ by enc_expr_trees
l8: $ G ⇒ dt u (mcv H) (enc_expr (pi (srt v) (Prop))) w ∅ = cpi x1 (dt u (mcv H) (enc_expr (srt v)) w ∅) (dt u (mcv H) (enc_expr (Prop)) w (scons x1 ∅)) $ by dt_pi_c [l6, l7, l4, l5]
l9: $ G ⇒ w ∈ lvals $ by weaken [l2]
l10: $ G ⇒ ∅ ∈ fseq u $ by weaken [l3]
l11: $ G ⇒ enc_lvl v ∈ trees ω $ by enc_lvl_trees
l12: $ G ⇒ dt u (mcv H) (enc_expr (srt v)) w ∅ = fv uni (lv (enc_lvl v) w) $ by dt_srt_c [l11, l9, l10]
l13: $ G ⇒ lv (enc_lvl v) w = n $ by weaken [#7]
l14: $ G ⇒ uni = uni $ by eq_refl
l15: $ G ⇒ fv uni (lv (enc_lvl v) w) = fv uni n $ by fv_eq [l14, l13]
l16: $ G ⇒ dt u (mcv H) (enc_expr (srt v)) w ∅ = fv uni n $ by eq_trans [l12, l15]
l17: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ $ by ax
l18: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ uadm u $ by weaken [#1]
l19: $ G , x1 ∊ dt u (mcv H) (enc_expr (srt v)) w ∅ ⇒ w ∈ lvals $ by weaken [l2]
