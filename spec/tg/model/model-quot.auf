
qclo_congr
----------
g1: $ seqt p p $ by seqt_refl
g2: $ (p ∊ E) ⟺ (p ∊ F) $ by welc_congr [g1, #3]
g3: $ seqt q q $ by seqt_refl
g4: $ (q ∊ A) ⟺ (q ∊ B) $ by welc_congr [g3, #1]
g5: $ seqt z z $ by seqt_refl
g6: $ p ≐ p $ by ceqt_refl
g7: $ (ap C p) ≐ (ap D p) $ by ap_congr [#2, g6]
g8: $ q ≐ q $ by ceqt_refl
g9: $ (ap (ap C p) q) ≐ (ap (ap D p) q) $ by ap_congr [g7, g8]
g10: $ (z ∊ (ap (ap C p) q)) ⟺ (z ∊ (ap (ap D p) q)) $ by welc_congr [g5, g9]
g11: $ (∃ z (z ∊ (ap (ap C p) q))) ⟺ (∃ z (z ∊ (ap (ap D p) q))) $ by ex_congr [g10]
g12: $ seqt z z $ by seqt_refl
g13: $ q ≐ q $ by ceqt_refl
g14: $ (ap C q) ≐ (ap D q) $ by ap_congr [#2, g13]
g15: $ p ≐ p $ by ceqt_refl
g16: $ (ap (ap C q) p) ≐ (ap (ap D q) p) $ by ap_congr [g14, g15]
g17: $ (z ∊ (ap (ap C q) p)) ⟺ (z ∊ (ap (ap D q) p)) $ by welc_congr [g12, g16]
g18: $ (∃ z (z ∊ (ap (ap C q) p))) ⟺ (∃ z (z ∊ (ap (ap D q) p))) $ by ex_congr [g17]
g19: $ ((∃ z (z ∊ (ap (ap C p) q))) ∨ (∃ z (z ∊ (ap (ap C q) p)))) ⟺ ((∃ z (z ∊ (ap (ap D p) q))) ∨ (∃ z (z ∊ (ap (ap D q) p)))) $ by or_congr [g11, g18]
g20: $ seqt q q $ by seqt_refl
g21: $ (q ∊ E) ⟺ (q ∊ F) $ by welc_congr [g20, #3]
g22: $ (((∃ z (z ∊ (ap (ap C p) q))) ∨ (∃ z (z ∊ (ap (ap C q) p)))) → (q ∊ E)) ⟺ (((∃ z (z ∊ (ap (ap D p) q))) ∨ (∃ z (z ∊ (ap (ap D q) p)))) → (q ∊ F)) $ by im_congr [g19, g21]
g23: $ ((q ∊ A) → (((∃ z (z ∊ (ap (ap C p) q))) ∨ (∃ z (z ∊ (ap (ap C q) p)))) → (q ∊ E))) ⟺ ((q ∊ B) → (((∃ z (z ∊ (ap (ap D p) q))) ∨ (∃ z (z ∊ (ap (ap D q) p)))) → (q ∊ F))) $ by im_congr [g4, g22]
g24: $ ((p ∊ E) → ((q ∊ A) → (((∃ z (z ∊ (ap (ap C p) q))) ∨ (∃ z (z ∊ (ap (ap C q) p)))) → (q ∊ E)))) ⟺ ((p ∊ F) → ((q ∊ B) → (((∃ z (z ∊ (ap (ap D p) q))) ∨ (∃ z (z ∊ (ap (ap D q) p)))) → (q ∊ F)))) $ by im_congr [g2, g23]
g25: $ (∀ q ((p ∊ E) → ((q ∊ A) → (((∃ z (z ∊ (ap (ap C p) q))) ∨ (∃ z (z ∊ (ap (ap C q) p)))) → (q ∊ E))))) ⟺ (∀ q ((p ∊ F) → ((q ∊ B) → (((∃ z (z ∊ (ap (ap D p) q))) ∨ (∃ z (z ∊ (ap (ap D q) p)))) → (q ∊ F))))) $ by all_congr [g24]
g26: $ qclo A C E ⟺ qclo B D F $ by all_congr [g25]

sb_f_qclo
---------
l1: $ [x/t] (∀ p (∀ q ((p ∊ C) → ((q ∊ A) → (((∃ z (z ∊ (ap (ap B p) q))) ∨ (∃ z (z ∊ (ap (ap B q) p)))) → (q ∊ C)))))) ⟺ (∀ p (∀ q ((p ∊ (⟦ x / t ⟧ C)) → ((q ∊ (⟦ x / t ⟧ A)) → (((∃ z (z ∊ (ap (ap (⟦ x / t ⟧ B) p) q))) ∨ (∃ z (z ∊ (ap (ap (⟦ x / t ⟧ B) q) p)))) → (q ∊ (⟦ x / t ⟧ C))))))) $ by iff_refl

qcl_congr
---------
g1: $ c ≐ c $ by ceqt_refl
g2: $ (E ∈ c) ⟺ (F ∈ c) $ by wcel_congr [#3, g1]
g3: $ c ≐ c $ by ceqt_refl
g4: $ (qclo A C c) ⟺ (qclo B D c) $ by qclo_congr [#1, #2, g3]
g5: $ (y ∊ c) ⟺ (y ∊ c) $ by iff_refl
g6: $ ((qclo A C c) → (y ∊ c)) ⟺ ((qclo B D c) → (y ∊ c)) $ by im_congr [g4, g5]
g7: $ ((E ∈ c) → ((qclo A C c) → (y ∊ c))) ⟺ ((F ∈ c) → ((qclo B D c) → (y ∊ c))) $ by im_congr [g2, g6]
g8: $ (∀ c ((E ∈ c) → ((qclo A C c) → (y ∊ c)))) ⟺ (∀ c ((F ∈ c) → ((qclo B D c) → (y ∊ c)))) $ by all_congr [g7]
g9: $ qcl A C E ≐ qcl B D F $ by cab_congr [g8]

sb_c_qcl
--------
l1: $ (⟦ x / t ⟧ {y | ∀ c ((C ∈ c) → ((qclo A B c) → (y ∊ c)))}) ≐ {y | ∀ c (((⟦ x / t ⟧ C) ∈ c) → ((qclo (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) c) → (y ∊ c)))} $ by ceqt_refl

--| @freshen G z
lemma f176_e {z: set} (G: hyps) (A R C: class) (a b: set): $ G ⇒ qclo A R C $ > $ G ⇒ a ∊ C $ > $ G ⇒ b ∊ A $ > $ G ⇒ (∃ z (z ∊ ap (ap R a) b) ∨ ∃ z (z ∊ ap (ap R b) a)) $ > $ G ⇒ b ∊ C $
----
l1: $ G , qclo A R C ⇒ ∀ p ∀ q (p ∊ C → q ∊ A → (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) → q ∊ C) $ by ax
l2: $ G ⇒ ∀ p ∀ q (p ∊ C → q ∊ A → (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) → q ∊ C) $ by imp_elim [imp_intro [l1], #1]
l3: $ G ⇒ ∀ q (a ∊ C → q ∊ A → (∃ z (z ∊ ap (ap R a) q) ∨ ∃ z (z ∊ ap (ap R q) a)) → q ∊ C) $ by all_elim [l2]
l4: $ G ⇒ a ∊ C → b ∊ A → (∃ z (z ∊ ap (ap R a) b) ∨ ∃ z (z ∊ ap (ap R b) a)) → b ∊ C $ by all_elim [l3]
l5: $ G ⇒ b ∊ A → (∃ z (z ∊ ap (ap R a) b) ∨ ∃ z (z ∊ ap (ap R b) a)) → b ∊ C $ by imp_elim [l4, #2]
l6: $ G ⇒ (∃ z (z ∊ ap (ap R a) b) ∨ ∃ z (z ∊ ap (ap R b) a)) → b ∊ C $ by imp_elim [l5, #3]
l7: $ G ⇒ b ∊ C $ by imp_elim [l6, #4]

--| @freshen G p
--| @freshen G q
--| @freshen G z
lemma f176_i {p q z: set} (G: hyps) (A R C: class): $ G , p ∊ C , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ C $ > $ G ⇒ qclo A R C $
----
l1: $ G , p ∊ C , q ∊ A ⇒ (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) → q ∊ C $ by imp_intro [#1]
l2: $ G , p ∊ C ⇒ q ∊ A → (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) → q ∊ C $ by imp_intro [l1]
l3: $ G ⇒ p ∊ C → q ∊ A → (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) → q ∊ C $ by imp_intro [l2]
l4: $ G ⇒ ∀ q (p ∊ C → q ∊ A → (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) → q ∊ C) $ by all_intro [l3]
l5: $ G ⇒ ∀ p ∀ q (p ∊ C → q ∊ A → (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) → q ∊ C) $ by all_intro [l4]
l6: $ G , ∀ p ∀ q (p ∊ C → q ∊ A → (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) → q ∊ C) ⇒ qclo A R C $ by ax
l7: $ G ⇒ qclo A R C $ by imp_elim [imp_intro [l6], l5]

qcl_self
--------
l1: $ G , a ∈ c , qclo A R c ⇒ a ∈ c $ by ax
l2: $ G , a ∈ c , qclo A R c ⇒ a ∊ c $ by wcel_welc [l1]
l3: $ G , a ∈ c ⇒ qclo A R c → a ∊ c $ by imp_intro [l2]
l4: $ G ⇒ a ∈ c → qclo A R c → a ∊ c $ by imp_intro [l3]
l5: $ G ⇒ ∀ c (a ∈ c → qclo A R c → a ∊ c) $ by all_intro [l4]
l6: $ G ⇒ a ∊ qcl A R a $ by cab_intro [l5]

lemma f176_m (G: hyps) (A R: class) (a b c: set): $ G ⇒ b ∊ qcl A R a $ > $ G ⇒ a ∊ c $ > $ G ⇒ qclo A R c $ > $ G ⇒ b ∊ c $
----
l1: $ G ⇒ ∀ d (a ∈ d → qclo A R d → b ∊ d) $ by cab_elim [#1]
l2: $ G ⇒ a ∈ c → qclo A R c → b ∊ c $ by all_elim [l1]
l3: $ G ⇒ a ∈ c $ by welc_wcel [#2]
l4: $ G ⇒ qclo A R c → b ∊ c $ by imp_elim [l2, l3]
l5: $ G ⇒ b ∊ c $ by imp_elim [l4, #3]

qcl_min
-------
l1: $ G , c = C ⇒ c = C $ by ax
l2: $ G , c = C ⇒ a ∊ C $ by weaken [#3]
l3: $ G , c = C ⇒ a ∊ c $ by welc_eq [eq_sym [l1], l2]
l4: $ G , c = C ⇒ qclo A R C $ by weaken [#4]
l5: $ G , c = C , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ c = C $ by weaken [l1]
l6: $ G , c = C , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ c $ by ax
l7: $ G , c = C , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ C $ by welc_eq [l5, l6]
l8: $ G , c = C , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ qclo A R C $ by weaken [l4]
l9: $ G , c = C , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ A $ by ax
l10: $ G , c = C , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) $ by ax
l11: $ G , c = C , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ C $ by f176_e [l8, l7, l9, l10]
l12: $ G , c = C , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ c $ by welc_eq [eq_sym [l5], l11]
l13: $ G , c = C ⇒ qclo A R c $ by f176_i [l12]
l14: $ G , c = C ⇒ b ∊ qcl A R a $ by weaken [#2]
l15: $ G , c = C ⇒ b ∊ c $ by f176_m [l14, l3, l13]
l16: $ G , c = C ⇒ b ∊ C $ by welc_eq [l1, l15]
l17: $ G ⇒ b ∊ C $ by isset_elim [#1, l16]

qcl_sub
-------
l1: $ G , x ∊ qcl A R a , c = A ⇒ c = A $ by ax
l2: $ G , x ∊ qcl A R a , c = A ⇒ a ∊ A $ by weaken [#2]
l3: $ G , x ∊ qcl A R a , c = A ⇒ a ∊ c $ by welc_eq [eq_sym [l1], l2]
l4: $ G , x ∊ qcl A R a , c = A , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ c = A $ by weaken [l1]
l5: $ G , x ∊ qcl A R a , c = A , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ A $ by ax
l6: $ G , x ∊ qcl A R a , c = A , p ∊ c , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ c $ by welc_eq [eq_sym [l4], l5]
l7: $ G , x ∊ qcl A R a , c = A ⇒ qclo A R c $ by f176_i [l6]
l8: $ G , x ∊ qcl A R a , c = A ⇒ x ∊ qcl A R a $ by ax
l9: $ G , x ∊ qcl A R a , c = A ⇒ x ∊ c $ by f176_m [l8, l3, l7]
l10: $ G , x ∊ qcl A R a , c = A ⇒ x ∊ A $ by welc_eq [l1, l9]
l11: $ G , x ∊ qcl A R a ⇒ isset A $ by weaken [#1]
l12: $ G , x ∊ qcl A R a ⇒ x ∊ A $ by isset_elim [l11, l10]
l13: $ G ⇒ qcl A R a ⊆ A $ by subset_intro [l12]

qcl_set
-------
l1: $ G ⇒ qcl A R a ⊆ A $ by qcl_sub [#1, #2]
l2: $ G ⇒ isset (qcl A R a) $ by subset_isset [#1, l1]

qcl_clo
-------
l1: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c , qclo A R c ⇒ p ∊ qcl A R a $ by ax
l2: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c , qclo A R c ⇒ a ∈ c $ by ax
l3: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c , qclo A R c ⇒ a ∊ c $ by wcel_welc [l2]
l4: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c , qclo A R c ⇒ qclo A R c $ by ax
l5: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c , qclo A R c ⇒ p ∊ c $ by f176_m [l1, l3, l4]
l6: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c , qclo A R c ⇒ q ∊ A $ by ax
l7: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c , qclo A R c ⇒ (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) $ by ax
l8: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c , qclo A R c ⇒ q ∊ c $ by f176_e [l4, l5, l6, l7]
l9: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , a ∈ c ⇒ qclo A R c → q ∊ c $ by imp_intro [l8]
l10: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ a ∈ c → qclo A R c → q ∊ c $ by imp_intro [l9]
l11: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ ∀ c (a ∈ c → qclo A R c → q ∊ c) $ by all_intro [l10]
l12: $ G , p ∊ qcl A R a , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ qcl A R a $ by cab_intro [l11]
l13: $ G ⇒ qclo A R (qcl A R a) $ by f176_i [l12]

lemma f176_le (G: hyps) (A R: class) (a b: set): $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ b ∊ qcl A R a $ > $ G ⇒ qcl A R b ⊆ qcl A R a $
----
l1: $ G , x ∊ qcl A R b ⇒ isset A $ by weaken [#1]
l2: $ G , x ∊ qcl A R b ⇒ a ∊ A $ by weaken [#2]
l3: $ G , x ∊ qcl A R b ⇒ isset (qcl A R a) $ by qcl_set [l1, l2]
l4: $ G , x ∊ qcl A R b ⇒ x ∊ qcl A R b $ by ax
l5: $ G , x ∊ qcl A R b ⇒ b ∊ qcl A R a $ by weaken [#3]
l6: $ G , x ∊ qcl A R b ⇒ qclo A R (qcl A R a) $ by qcl_clo
l7: $ G , x ∊ qcl A R b ⇒ x ∊ qcl A R a $ by qcl_min [l3, l4, l5, l6]
l8: $ G ⇒ qcl A R b ⊆ qcl A R a $ by subset_intro [l7]

lemma f176_sy (G: hyps) (A R: class) (a b: set): $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ b ∊ qcl A R a $ > $ G ⇒ a ∊ qcl A R b $
----
l1: $ G , x ∊ {y | y ∊ A ∧ a ∊ qcl A R y} ⇒ x ∊ {y | y ∊ A ∧ a ∊ qcl A R y} $ by ax
l2: $ G , x ∊ {y | y ∊ A ∧ a ∊ qcl A R y} ⇒ x ∊ A ∧ a ∊ qcl A R x $ by cab_elim [l1]
l3: $ G , x ∊ {y | y ∊ A ∧ a ∊ qcl A R y} ⇒ x ∊ A $ by and_elim_l [l2]
l4: $ G ⇒ {y | y ∊ A ∧ a ∊ qcl A R y} ⊆ A $ by subset_intro [l3]
l5: $ G ⇒ isset {y | y ∊ A ∧ a ∊ qcl A R y} $ by subset_isset [#1, l4]
l6: $ G ⇒ a ∊ qcl A R a $ by qcl_self
l7: $ G ⇒ a ∊ {y | y ∊ A ∧ a ∊ qcl A R y} $ by cab_intro [and_intro [#2, l6]]
l8: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} $ by ax
l9: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ A ∧ a ∊ qcl A R p $ by cab_elim [l8]
l10: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ A $ by and_elim_l [l9]
l11: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ a ∊ qcl A R p $ by and_elim_r [l9]
l12: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ qcl A R q $ by qcl_self
l13: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) $ by ax
l14: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ (∃ z (z ∊ ap (ap R q) p) ∨ ∃ z (z ∊ ap (ap R p) q)) $ by or_comm [l13]
l15: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ qclo A R (qcl A R q) $ by qcl_clo
l16: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ qcl A R q $ by f176_e [l15, l12, l10, l14]
l17: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ isset A $ by weaken [#1]
l18: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ A $ by ax
l19: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ qcl A R p ⊆ qcl A R q $ by f176_le [l17, l18, l16]
l20: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ a ∊ qcl A R q $ by subset_elim [l19, l11]
l21: $ G , p ∊ {y | y ∊ A ∧ a ∊ qcl A R y} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ {y | y ∊ A ∧ a ∊ qcl A R y} $ by cab_intro [and_intro [l18, l20]]
