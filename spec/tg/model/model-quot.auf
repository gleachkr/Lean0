l1: $ (⟦ x / t ⟧ {h | (h = ∅) ∧ (∃ y (y ∊ A))}) ≐ {h | (h = ∅) ∧ (∃ y (y ∊ (⟦ x / t ⟧ A)))} $ by ceqt_refl

chv_congr
---------
