l10: $ G , p ∊ A ⇒ isset A $ by weaken [#1]
l11: $ G , p ∊ A ⇒ isset (cpi q A (cpi x8 (ap (ap R p) q) (teq (ap F p) (ap F q)))) $ by f177_cs [l10, l9]
l12: $ G ⇒ p ∊ A → isset (cpi q A (cpi x8 (ap (ap R p) q) (teq (ap F p) (ap F q)))) $ by imp_intro [l11]
l13: $ G ⇒ ∀ p (p ∊ A → isset (cpi q A (cpi x8 (ap (ap R p) q) (teq (ap F p) (ap F q))))) $ by all_intro [l12]
l14: $ G ⇒ isset (cpi p A (cpi q A (cpi x8 (ap (ap R p) q) (teq (ap F p) (ap F q))))) $ by f177_cs [#1, l13]
