lemma f177_c (G: hyps) (A R F: class) (a b: set): $ G ⇒ isset A $ > $ G ⇒ a ∊ A $ > $ G ⇒ qresp A R F $ > $ G ⇒ b ∊ qcl A R a $ > $ G ⇒ ap F b = ap F a $
----
l1: $ G , x ∊ {y | y ∊ A ∧ ap F y = ap F a} ⇒ x ∊ {y | y ∊ A ∧ ap F y = ap F a} $ by ax
l2: $ G , x ∊ {y | y ∊ A ∧ ap F y = ap F a} ⇒ x ∊ A ∧ ap F x = ap F a $ by cab_elim [l1]
l3: $ G , x ∊ {y | y ∊ A ∧ ap F y = ap F a} ⇒ x ∊ A $ by and_elim_l [l2]
l4: $ G ⇒ {y | y ∊ A ∧ ap F y = ap F a} ⊆ A $ by subset_intro [l3]
l5: $ G ⇒ isset {y | y ∊ A ∧ ap F y = ap F a} $ by subset_isset [#1, l4]
l6: $ G ⇒ ap F a = ap F a $ by eq_refl
l7: $ G ⇒ a ∊ {y | y ∊ A ∧ ap F y = ap F a} $ by cab_intro [and_intro [#2, l6]]
l8: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ {y | y ∊ A ∧ ap F y = ap F a} $ by ax
l9: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ A ∧ ap F p = ap F a $ by cab_elim [l8]
l10: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ p ∊ A $ by and_elim_l [l9]
l11: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ ap F p = ap F a $ by and_elim_r [l9]
l12: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ A $ by ax
l13: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) $ by ax
l14: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R p) q) ⇒ qresp A R F $ by weaken [#3]
l15: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R p) q) ⇒ p ∊ A $ by weaken [l10]
l16: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R p) q) ⇒ q ∊ A $ by weaken [l12]
l17: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R p) q) ⇒ ∃ z (z ∊ ap (ap R p) q) $ by ax
l18: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R p) q) ⇒ ap F p = ap F q $ by qresp_elim [l14, l15, l16, l17]
l19: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R p) q) ⇒ ap F p = ap F a $ by weaken [l11]
l20: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R p) q) ⇒ ap F q = ap F a $ by eq_trans [eq_sym [l18], l19]
l21: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R q) p) ⇒ qresp A R F $ by weaken [#3]
l22: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R q) p) ⇒ q ∊ A $ by weaken [l12]
l23: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R q) p) ⇒ p ∊ A $ by weaken [l10]
l24: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R q) p) ⇒ ∃ z (z ∊ ap (ap R q) p) $ by ax
l25: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R q) p) ⇒ ap F q = ap F p $ by qresp_elim [l21, l22, l23, l24]
l26: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R q) p) ⇒ ap F p = ap F a $ by weaken [l11]
l27: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) , ∃ z (z ∊ ap (ap R q) p) ⇒ ap F q = ap F a $ by eq_trans [l25, l26]
l28: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ ap F q = ap F a $ by or_elim [l13, l20, l27]
l29: $ G , p ∊ {y | y ∊ A ∧ ap F y = ap F a} , q ∊ A , (∃ z (z ∊ ap (ap R p) q) ∨ ∃ z (z ∊ ap (ap R q) p)) ⇒ q ∊ {y | y ∊ A ∧ ap F y = ap F a} $ by cab_intro [and_intro [l12, l28]]
l30: $ G ⇒ qclo A R {y | y ∊ A ∧ ap F y = ap F a} $ by f176_i [l29]
l31: $ G ⇒ b ∊ {y | y ∊ A ∧ ap F y = ap F a} $ by qcl_min [l5, #4, l7, l30]
