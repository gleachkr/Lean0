l239: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ fv (scons x3 (scons x2 (scons x1 t))) (fv nvf (enc_nat n1)) = x2 $ by eq_trans [l236, l238]
l240: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ dt u (mcv H) (enc_expr (bvar n1)) w (scons x3 (scons x2 (scons x1 t))) = x2 $ by eq_trans [l220, l239]
l241: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ ap (dt u (mcv H) (enc_expr (app (quot l) (bvar n2))) w (scons x3 (scons x2 (scons x1 t)))) (dt u (mcv H) (enc_expr (bvar n1)) w (scons x3 (scons x2 (scons x1 t)))) = ap (ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1) x2 $ by ap_eq [l216, l240]
l242: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ dt u (mcv H) (enc_expr (app (app (quot l) (bvar n2)) (bvar n1))) w (scons x3 (scons x2 (scons x1 t))) = ap (ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1) x2 $ by eq_trans [l169, l241]
l243: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ x1 ∊ fv uni n $ by weaken [l37]
l244: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) $ by weaken [l128]
l245: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1 = clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r) $ by clam_ap [l243]
l246: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) x2 = qty x1 x2 $ by clam_ap [l244]
l247: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ x2 = x2 $ by eq_refl
l248: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ ap (ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1) x2 = ap (clam r (cpi i x1 (cpi j x1 (fv uni ∅))) (qty x1 r)) x2 $ by ap_eq [l245, l247]
l249: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ ap (ap (clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r))) x1) x2 = qty x1 x2 $ by eq_trans [l248, l246]
l250: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) , x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) ⇒ dt u (mcv H) (enc_expr (app (app (quot l) (bvar n2)) (bvar n1))) w (scons x3 (scons x2 (scons x1 t))) = qty x1 x2 $ by eq_trans [l242, l249]
l251: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) ⇒ x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) → dt u (mcv H) (enc_expr (app (app (quot l) (bvar n2)) (bvar n1))) w (scons x3 (scons x2 (scons x1 t))) = qty x1 x2 $ by imp_intro [l250]
l252: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) ⇒ ∀ x3 (x3 ∊ dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t)) → dt u (mcv H) (enc_expr (app (app (quot l) (bvar n2)) (bvar n1))) w (scons x3 (scons x2 (scons x1 t))) = qty x1 x2) $ by all_intro [l251]
l253: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) ⇒ cpi x3 (dt u (mcv H) (enc_expr (bvar n1)) w (scons x2 (scons x1 t))) (dt u (mcv H) (enc_expr (app (app (quot l) (bvar n2)) (bvar n1))) w (scons x3 (scons x2 (scons x1 t)))) = cpi x3 x1 (qty x1 x2) $ by cpi_eq_pt [l157, l252]
l254: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t , x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) ⇒ dt u (mcv H) (enc_expr (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1)))) w (scons x2 (scons x1 t)) = cpi x3 x1 (qty x1 x2) $ by eq_trans [l133, l253]
l255: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t ⇒ x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) → dt u (mcv H) (enc_expr (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1)))) w (scons x2 (scons x1 t)) = cpi x3 x1 (qty x1 x2) $ by imp_intro [l254]
l256: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t ⇒ ∀ x2 (x2 ∊ dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t) → dt u (mcv H) (enc_expr (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1)))) w (scons x2 (scons x1 t)) = cpi x3 x1 (qty x1 x2)) $ by all_intro [l255]
l257: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t ⇒ cpi x2 (dt u (mcv H) (enc_expr (pi (bvar nz) (pi (bvar n1) (Prop)))) w (scons x1 t)) (dt u (mcv H) (enc_expr (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1)))) w (scons x2 (scons x1 t))) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2)) $ by cpi_eq_pt [l121, l256]
l258: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w , x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t ⇒ dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1))))) w (scons x1 t) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2)) $ by eq_trans [l42, l257]
l259: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t → dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1))))) w (scons x1 t) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2)) $ by imp_intro [l258]
l260: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ ∀ x1 (x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t → dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1))))) w (scons x1 t) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2))) $ by all_intro [l259]
l261: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ cpi x1 (dt u (mcv H) (enc_expr (srt l)) w t) (dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1))))) w (scons x1 t)) = cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2))) $ by cpi_eq_pt [l30, l260]
l262: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1)))))) w t = cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2))) $ by eq_trans [l22, l261]
l263: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c))) ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2))) $ by f180_ty [l17]
l264: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ uadm u $ by weaken [l1]
l265: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ hqu H $ by weaken [l7]
l266: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ w ∊ lvals $ by weaken [l2]
l267: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ t ∈ fseq u $ by weaken [l6]
l268: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot_mk l)) w t = clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (clam c a (qmk a r c))) $ by dt_quot_mk_u [l264, l265, l266, l267, l11]
l269: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot_mk l)) w t ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 x1 (qty x1 x2))) $ by wcel_eq_l [eq_sym [l268], l263]
l270: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot_mk l)) w t ∈ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1)))))) w t $ by wcel_eq_r [eq_sym [l262], l269]
l271: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l272: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ isset (enc_lvl l) $ by wcel_isset [l271]
l273: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ w ∊ lvals $ by weaken [l2]
l274: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ lv (enc_lvl l) w ∈ ω $ by lv_omega [l272, l273]
l275: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ isset (lv (enc_lvl l) w) $ by wcel_isset [l274]
l276: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ dt u (mcv H) (enc_expr (quot_mk l)) w t ∈ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1)))))) w t $ by isset_elim [l275, l270]
z1: $ mdeq (mcv H) G (quot_mk l) (quot_mk l) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (bvar n1) (app (app (quot l) (bvar n2)) (bvar n1))))) $ by mdeq_i [l9, l276]

lemma f181_t (G: hyps) (A B: class): $ G ⇒ A ∈ two $ > $ G ⇒ B ∈ A $ > $ G ⇒ A = csn ∅ $
----
l1: $ G , x = A ⇒ x = A $ by ax
l2: $ G , x = A ⇒ A ∈ two $ by weaken [#1]
l3: $ G , x = A ⇒ x ∈ two $ by wcel_eq_l [eq_sym [l1], l2]
l4: $ G , x = A ⇒ x ∊ two $ by wcel_welc [l3]
l5: $ G , x = A ⇒ x = ∅ ∨ x = csn ∅ $ by two_elim [l4]
l6: $ G , x = A , x = ∅ , y = B ⇒ y = B $ by ax
l7: $ G , x = A , x = ∅ , y = B ⇒ B ∈ A $ by weaken [#2]
l8: $ G , x = A , x = ∅ , y = B ⇒ y ∈ A $ by wcel_eq_l [eq_sym [l6], l7]
l9: $ G , x = A , x = ∅ , y = B ⇒ x = A $ by weaken [l1]
l10: $ G , x = A , x = ∅ , y = B ⇒ x = ∅ $ by ax
l11: $ G , x = A , x = ∅ , y = B ⇒ A = ∅ $ by eq_trans [eq_sym [l9], l10]
l12: $ G , x = A , x = ∅ , y = B ⇒ y ∈ ∅ $ by wcel_eq_r [l11, l8]
l13: $ G , x = A , x = ∅ , y = B ⇒ y ∊ ∅ $ by wcel_welc [l12]
l14: $ G , x = A , x = ∅ , y = B ⇒ ⊥ $ by empty_elim [l13]
l15: $ G , x = A , x = ∅ , y = B ⇒ A = csn ∅ $ by bot_elim [l14]
l16: $ G , x = A , x = ∅ ⇒ B ∈ A $ by weaken [#2]
l17: $ G , x = A , x = ∅ ⇒ isset B $ by wcel_isset [l16]
l18: $ G , x = A , x = ∅ ⇒ A = csn ∅ $ by isset_elim [l17, l15]
l19: $ G , x = A , x = csn ∅ ⇒ x = A $ by weaken [l1]
l20: $ G , x = A , x = csn ∅ ⇒ x = csn ∅ $ by ax
l21: $ G , x = A , x = csn ∅ ⇒ A = csn ∅ $ by eq_trans [eq_sym [l19], l20]
l22: $ G , x = A ⇒ A = csn ∅ $ by or_elim [l5, l18, l21]
l23: $ G ⇒ isset A $ by wcel_isset [#1]
l24: $ G ⇒ A = csn ∅ $ by isset_elim [l23, l22]

--| @freshen G i
--| @freshen G j
--| @freshen G x1
--| @freshen G x2
--| @freshen G x3
--| @freshen G x4
--| @freshen G x5
--| @freshen G x6
--| @freshen G x7
lemma f181_ty {i j x1 x2 x3 x4 x5 x6 x7: set} (G: hyps) (n: set): $ G ⇒ ∅ ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 (cpi x7 (qty x1 x2) (fv uni ∅)) (cpi x4 (cpi x6 x1 (ap x3 (qmk x1 x2 x6))) (cpi x5 (qty x1 x2) (ap x3 x5))))) $
----
l1: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ cpi x7 (qty x1 x2) (fv uni ∅) , x4 ∊ cpi x6 x1 (ap x3 (qmk x1 x2 x6)) , x5 ∊ qty x1 x2 ⇒ x5 ∊ qty x1 x2 $ by ax
l2: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ cpi x7 (qty x1 x2) (fv uni ∅) , x4 ∊ cpi x6 x1 (ap x3 (qmk x1 x2 x6)) , x5 ∊ qty x1 x2 ⇒ ∃ p (p ∊ x1 ∧ x5 = qmk x1 x2 p) $ by qty_elim [l1]
l3: $ G , x1 ∊ fv uni n , x2 ∊ cpi i x1 (cpi j x1 (fv uni ∅)) , x3 ∊ cpi x7 (qty x1 x2) (fv uni ∅) , x4 ∊ cpi x6 x1 (ap x3 (qmk x1 x2 x6)) , x5 ∊ qty x1 x2 , p ∊ x1 ∧ x5 = qmk x1 x2 p ⇒ p ∊ x1 ∧ x5 = qmk x1 x2 p $ by ax
