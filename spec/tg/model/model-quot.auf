l654: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t → dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (pi (app (app (quot l) (bvar n1)) (bvar nz)) (Prop)) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk l) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot l) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz))))))) w (scons x1 t) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 (cpi x7 (qty x1 x2) (fv uni ∅)) (cpi x4 (cpi x6 x1 (ap x3 (qmk x1 x2 x6))) (cpi x5 (qty x1 x2) (ap x3 x5)))) $ by imp_intro [l653]
l655: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ ∀ x1 (x1 ∊ dt u (mcv H) (enc_expr (srt l)) w t → dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (pi (app (app (quot l) (bvar n1)) (bvar nz)) (Prop)) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk l) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot l) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz))))))) w (scons x1 t) = cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 (cpi x7 (qty x1 x2) (fv uni ∅)) (cpi x4 (cpi x6 x1 (ap x3 (qmk x1 x2 x6))) (cpi x5 (qty x1 x2) (ap x3 x5))))) $ by all_intro [l654]
l656: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ cpi x1 (dt u (mcv H) (enc_expr (srt l)) w t) (dt u (mcv H) (enc_expr (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (pi (app (app (quot l) (bvar n1)) (bvar nz)) (Prop)) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk l) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot l) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz))))))) w (scons x1 t)) = cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 (cpi x7 (qty x1 x2) (fv uni ∅)) (cpi x4 (cpi x6 x1 (ap x3 (qmk x1 x2 x6))) (cpi x5 (qty x1 x2) (ap x3 x5))))) $ by cpi_eq_pt [l33, l655]
l657: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (pi (app (app (quot l) (bvar n1)) (bvar nz)) (Prop)) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk l) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot l) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz)))))))) w t = cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 (cpi x7 (qty x1 x2) (fv uni ∅)) (cpi x4 (cpi x6 x1 (ap x3 (qmk x1 x2 x6))) (cpi x5 (qty x1 x2) (ap x3 x5))))) $ by eq_trans [l25, l656]
l658: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ ∅ ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 (cpi x7 (qty x1 x2) (fv uni ∅)) (cpi x4 (cpi x6 x1 (ap x3 (qmk x1 x2 x6))) (cpi x5 (qty x1 x2) (ap x3 x5))))) $ by f181_ty
l659: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot_ind l)) w t = ∅ $ by weaken [l18]
l660: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot_ind l)) w t ∈ cpi x1 (fv uni n) (cpi x2 (cpi i x1 (cpi j x1 (fv uni ∅))) (cpi x3 (cpi x7 (qty x1 x2) (fv uni ∅)) (cpi x4 (cpi x6 x1 (ap x3 (qmk x1 x2 x6))) (cpi x5 (qty x1 x2) (ap x3 x5))))) $ by wcel_eq_l [eq_sym [l659], l658]
l661: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w , n = lv (enc_lvl l) w ⇒ dt u (mcv H) (enc_expr (quot_ind l)) w t ∈ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (pi (app (app (quot l) (bvar n1)) (bvar nz)) (Prop)) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk l) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot l) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz)))))))) w t $ by wcel_eq_r [eq_sym [l657], l660]
l662: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l663: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ isset (enc_lvl l) $ by wcel_isset [l662]
l664: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ w ∊ lvals $ by weaken [l2]
l665: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ lv (enc_lvl l) w ∈ ω $ by lv_omega [l663, l664]
l666: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ isset (lv (enc_lvl l) w) $ by wcel_isset [l665]
l667: $ uadm u , w ∊ lvals , t ∊ sat u (mcv H) (enc_ctx G) w ⇒ dt u (mcv H) (enc_expr (quot_ind l)) w t ∈ dt u (mcv H) (enc_expr (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (pi (app (app (quot l) (bvar n1)) (bvar nz)) (Prop)) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk l) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot l) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz)))))))) w t $ by isset_elim [l666, l661]
z1: $ mdeq (mcv H) G (quot_ind l) (quot_ind l) (pi (srt l) (pi (pi (bvar nz) (pi (bvar n1) (Prop))) (pi (pi (app (app (quot l) (bvar n1)) (bvar nz)) (Prop)) (pi (pi (bvar n2) (app (bvar n1) (app (app (app (quot_mk l) (bvar n3)) (bvar n2)) (bvar nz)))) (pi (app (app (quot l) (bvar n3)) (bvar n2)) (app (bvar n2) (bvar nz))))))) $ by mdeq_i [l9, l667]

teq_eq
------
l1: $ G , x ∊ teq A C ⇒ x ∊ teq A C $ by ax
l2: $ G , x ∊ teq A C ⇒ x = ∅ ∧ A = C $ by cab_elim [l1]
l3: $ G , x ∊ teq A C ⇒ x = ∅ $ by and_elim_l [l2]
l4: $ G , x ∊ teq A C ⇒ A = C $ by and_elim_r [l2]
l5: $ G , x ∊ teq A C ⇒ A = B $ by weaken [#1]
l6: $ G , x ∊ teq A C ⇒ C = D $ by weaken [#2]
l7: $ G , x ∊ teq A C ⇒ B = D $ by eq_trans [eq_sym [l5], eq_trans [l4, l6]]
l8: $ G , x ∊ teq A C ⇒ x ∊ teq B D $ by cab_intro [and_intro [l3, l7]]
l9: $ G , x ∊ teq B D ⇒ x ∊ teq B D $ by ax
l10: $ G , x ∊ teq B D ⇒ x = ∅ ∧ B = D $ by cab_elim [l9]
l11: $ G , x ∊ teq B D ⇒ x = ∅ $ by and_elim_l [l10]
l12: $ G , x ∊ teq B D ⇒ B = D $ by and_elim_r [l10]
l13: $ G , x ∊ teq B D ⇒ B = A $ by eq_sym [weaken [#1]]
l14: $ G , x ∊ teq B D ⇒ D = C $ by eq_sym [weaken [#2]]
l15: $ G , x ∊ teq B D ⇒ A = C $ by eq_trans [eq_sym [l13], eq_trans [l12, l14]]
l16: $ G , x ∊ teq B D ⇒ x ∊ teq A C $ by cab_intro [and_intro [l11, l15]]
l17: $ G ⇒ teq A C = teq B D $ by eq_intro [l8, l16]

lemma f182_at (G: hyps) (H R: class) (l2: lvl) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w R = dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅ $
----
l1: $ G ⇒ kc_ind_ty ∈ kexa $ by kexa_ind_ty
l2: $ G ⇒ enc_ind (eq_D l2) ∈ trees ω $ by enc_ind_trees
l3: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l4: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l5: $ G ⇒ scons (enc_nat nz) ∅ ∈ fseq (trees ω) $ by scons_fseq_c [l3, l4]
l6: $ G ⇒ scons (enc_ind (eq_D l2)) (scons (enc_nat nz) ∅) ∈ fseq (trees ω) $ by scons_fseq_c [l2, l5]
l7: $ G ⇒ w ∈ lvals $ by welc_wcel [#1]
l8: $ G ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons (enc_ind (eq_D l2)) (scons (enc_nat nz) ∅) ⟩ w R = mclip u (ap (fv (mcv H) ⟨ u , ⟨ kc_ind_ty , ⟨ scons (enc_ind (eq_D l2)) (scons (enc_nat nz) ∅) , ccom (dnf u (mcv H)) (scons (enc_ind (eq_D l2)) (scons (enc_nat nz) ∅)) ⟩ ⟩ ⟩) w) $ by dt_atom_c [l1, l6, l7, #2]
l9: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l10: $ G ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons (enc_ind (eq_D l2)) (scons (enc_nat nz) ∅) ⟩ w ∅ = mclip u (ap (fv (mcv H) ⟨ u , ⟨ kc_ind_ty , ⟨ scons (enc_ind (eq_D l2)) (scons (enc_nat nz) ∅) , ccom (dnf u (mcv H)) (scons (enc_ind (eq_D l2)) (scons (enc_nat nz) ∅)) ⟩ ⟩ ⟩) w) $ by dt_atom_c [l1, l6, l7, l9]
l11: $ G ⇒ dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w R = dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅ $ by eq_trans [l8, eq_sym [l10]]

lemma f182_eq (G: hyps) (H R X Y: class) (l2: lvl) (u w b k: set): $ G ⇒ meqs (mcv H) l2 $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ lv (enc_lvl l2) w = k $ > $ G ⇒ b ∊ fv uni k $ > $ G ⇒ X ∈ b $ > $ G ⇒ Y ∈ b $ > $ G ⇒ ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w R) b) X) Y = teq X Y $
----
l1: $ G , meqs (mcv H) l2 ⇒ ∀ x1 ∀ x2 (uadm x1 → x2 ∊ lvals → ∀ x3 ∀ x4 ∀ x5 (x3 ∊ fv uni (lv (enc_lvl l2) x2) → x4 ∊ x3 → x5 ∊ x3 → ap (ap (ap (dt x1 (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) x2 ∅) x3) x4) x5 = teq x4 x5)) $ by ax
l2: $ G ⇒ ∀ x1 ∀ x2 (uadm x1 → x2 ∊ lvals → ∀ x3 ∀ x4 ∀ x5 (x3 ∊ fv uni (lv (enc_lvl l2) x2) → x4 ∊ x3 → x5 ∊ x3 → ap (ap (ap (dt x1 (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) x2 ∅) x3) x4) x5 = teq x4 x5)) $ by imp_elim [imp_intro [l1], #1]
l3: $ G ⇒ ∀ x2 (uadm u → x2 ∊ lvals → ∀ x3 ∀ x4 ∀ x5 (x3 ∊ fv uni (lv (enc_lvl l2) x2) → x4 ∊ x3 → x5 ∊ x3 → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) x2 ∅) x3) x4) x5 = teq x4 x5)) $ by all_elim [l2]
l4: $ G ⇒ uadm u → w ∊ lvals → ∀ x3 ∀ x4 ∀ x5 (x3 ∊ fv uni (lv (enc_lvl l2) w) → x4 ∊ x3 → x5 ∊ x3 → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅) x3) x4) x5 = teq x4 x5) $ by all_elim [l3]
l5: $ G ⇒ w ∊ lvals → ∀ x3 ∀ x4 ∀ x5 (x3 ∊ fv uni (lv (enc_lvl l2) w) → x4 ∊ x3 → x5 ∊ x3 → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅) x3) x4) x5 = teq x4 x5) $ by imp_elim [l4, #2]
l6: $ G ⇒ ∀ x3 ∀ x4 ∀ x5 (x3 ∊ fv uni (lv (enc_lvl l2) w) → x4 ∊ x3 → x5 ∊ x3 → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅) x3) x4) x5 = teq x4 x5) $ by imp_elim [l5, #3]
l7: $ G , x = X , y = Y ⇒ x = X $ by ax
l8: $ G , x = X , y = Y ⇒ y = Y $ by ax
l9: $ G , x = X , y = Y ⇒ ∀ x3 ∀ x4 ∀ x5 (x3 ∊ fv uni (lv (enc_lvl l2) w) → x4 ∊ x3 → x5 ∊ x3 → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅) x3) x4) x5 = teq x4 x5) $ by weaken [l6]
l10: $ G , x = X , y = Y ⇒ ∀ x4 ∀ x5 (b ∊ fv uni (lv (enc_lvl l2) w) → x4 ∊ b → x5 ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅) b) x4) x5 = teq x4 x5) $ by all_elim [l9]
l11: $ G , x = X , y = Y ⇒ ∀ x5 (b ∊ fv uni (lv (enc_lvl l2) w) → x ∊ b → x5 ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅) b) x) x5 = teq x x5) $ by all_elim [l10]
l12: $ G , x = X , y = Y ⇒ b ∊ fv uni (lv (enc_lvl l2) w) → x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅) b) x) y = teq x y $ by all_elim [l11]
l13: $ G , x = X , y = Y ⇒ uni = uni $ by eq_refl
l14: $ G , x = X , y = Y ⇒ lv (enc_lvl l2) w = k $ by weaken [#5]
l15: $ G , x = X , y = Y ⇒ b ∊ fv uni k $ by weaken [#6]
l16: $ G , x = X , y = Y ⇒ b ∊ fv uni (lv (enc_lvl l2) w) $ by welc_eq [fv_eq [l13, eq_sym [l14]], l15]
l17: $ G , x = X , y = Y ⇒ X ∈ b $ by weaken [#7]
l18: $ G , x = X , y = Y ⇒ x ∈ b $ by wcel_eq_l [eq_sym [l7], l17]
l19: $ G , x = X , y = Y ⇒ x ∊ b $ by wcel_welc [l18]
l20: $ G , x = X , y = Y ⇒ Y ∈ b $ by weaken [#8]
l21: $ G , x = X , y = Y ⇒ y ∈ b $ by wcel_eq_l [eq_sym [l8], l20]
l22: $ G , x = X , y = Y ⇒ y ∊ b $ by wcel_welc [l21]
l23: $ G , x = X , y = Y ⇒ x ∊ b → y ∊ b → ap (ap (ap (dt u (mcv H) (enc_expr (ind_ty (eq_D l2) nz)) w ∅) b) x) y = teq x y $ by imp_elim [l12, l16]
