q1: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ u = u $ by eq_refl
q2: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ M = M $ by eq_refl
q3: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ enc_expr e = enc_expr e $ by eq_refl
q4: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ w = w $ by eq_refl
q5: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ v = v $ by eq_refl
q6: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ (λₛ x ∈ dt u M (enc_expr A) w v, dt u M (enc_expr e) w (x +: v)) = (λₛ x ∈ dt u M (enc_expr A) w v, dt u M (enc_expr e) w (x +: v)) $ by eq_refl
q7: $ … ⇒ y +: v = dt u M (enc_expr a) w v +: v $ by scons_eq [n2, q5]
q8: $ … ⇒ dt u M (enc_expr e) w (y +: v) = dt u M (enc_expr e) w (dt u M (enc_expr a) w v +: v) $ by dt_eq [q1, q2, q3, q4, q7]
q9: $ … ⇒ ap (λₛ x ∈ dt u M (enc_expr A) w v, dt u M (enc_expr e) w (x +: v)) y = ap (λₛ x ∈ dt u M (enc_expr A) w v, dt u M (enc_expr e) w (x +: v)) (dt u M (enc_expr a) w v) $ by ap_eq [q6, n2]
q10: $ … ⇒ ap (λₛ x ∈ dt u M (enc_expr A) w v, dt u M (enc_expr e) w (x +: v)) (dt u M (enc_expr a) w v) = ap (λₛ x ∈ dt u M (enc_expr A) w v, dt u M (enc_expr e) w (x +: v)) y $ by eq_sym [q9]
