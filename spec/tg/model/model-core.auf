-- Proofs for model-core.mm0.

mbvar
-----
a1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
a2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ sat u M (enc_ctx G) w $ by ax
s1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ sat u M (enc_ctx G) w ⊆ fseq u $ by sat_fseq
s2: $ … ⇒ r ∊ fseq u $ by subset_elim [s1, a2]
t1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_nat i ∈ trees ω $ by enc_nat_trees
d1: $ … ⇒ dt u M ⟨ kc_bvar , enc_nat i +: ∅ ⟩ w r = r' nvf' (enc_nat i) $ by dt_bvar [t1, a1, s2]
d2: $ … ⇒ r' nvf' (enc_nat i) = dt u M (enc_expr (bvar i)) w r $ by eq_sym [d1]
l1: $ … ⇒ r' nvf' (enc_nat i) ∈ dt u M (enc_expr A) w r $ by lookup_den [#1, a1, a2]
m1: $ … ⇒ dt u M (enc_expr (bvar i)) w r ∈ dt u M (enc_expr A) w r $ by wcel_eq_l [d2, l1]
e1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr (bvar i)) w r = dt u M (enc_expr (bvar i)) w r $ by eq_refl
r1: $ mdeq M G (bvar i) (bvar i) A $ by mdeq_i [e1, m1]

