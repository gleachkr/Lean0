o0: $ … ⇒ (∃ e (z = e ∧ t = e) ∨ ∃ i (z = ⟨ kc_bvar , i +: ∅ ⟩ ∧ t = ⟨ kc_bvar , i +: ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , l +: ∅ ⟩ ∧ t = ⟨ kc_srt , m +: ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , f +: a +: ∅ ⟩ ∧ t = ⟨ kc_app , g +: h +: ∅ ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , x0 +: x1 +: ∅ ⟩ ∧ t = ⟨ kc_lam , x2 +: x3 +: ∅ ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , x0 +: x1 +: ∅ ⟩ ∧ t = ⟨ kc_pi , x2 +: x3 +: ∅ ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , a +: x4 +: ∅ ⟩ ∧ t = ⟨ kc_cst , a +: x5 +: ∅ ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , x6 +: i +: ∅ ⟩ ∧ t = ⟨ kc_ind_ty , x7 +: i +: ∅ ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , x6 +: i +: c +: ∅ ⟩ ∧ t = ⟨ kc_ind_ctor , x7 +: i +: c +: ∅ ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , x6 +: i +: v +: ∅ ⟩ ∧ t = ⟨ kc_ind_rec , x7 +: i +: x8 +: ∅ ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , x1 +: i +: e +: ∅ ⟩ ∧ t = ⟨ kc_proj , x1 +: i +: x9 +: ∅ ⟩ ∧ ra_eeqv e x9 ∈ lrel2)) → dt u M z w r = dt u M t w r $ by or_elim_imp [k0b0, o1]
fin: $ … ⇒ dt u M z w r = dt u M t w r $ by imp_elim [o0, d0]

--| By induction on the trees.
lemma g3_all (G: hyps) (M: class) (u w: set): $ G ⇒ minv M $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ trees ω ⊆ einv u M w $
----
a1m: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ minv M $ by weaken [#1]
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ uadm u $ by weaken [#2]
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ w ∊ lvals $ by weaken [#3]
a1: $ … ⇒ minvh M u w z $ by g3_mh [a1m, a2, a3]
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ crn j ⊆ einv u M w $ by ax
a5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ z = ⟨ k , j ⟩ $ by ax
a6k: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ k ∊ ω $ by ax
a6j: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ j ∊ fseq (trees ω) $ by ax
a6: $ … ⇒ z ∊ trees ω $ by g3_ztree [a6k, a6j, a5]
a7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ ra_eeqv z t ∈ lrel2 $ by ax
n1: $ … ⇒ dt u M z w r = dt u M t w r $ by g3_node [a1, a2, a3, a4, a5, a6, a7]
n2: $ … ⇒ z ∊ einv u M w $ by g3_P_i [n1]
n3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
n4: $ … ⇒ ⟨ k , j ⟩ ∈ einv u M w $ by wcel_intro [n3, n2]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ einv u M w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n6: $ … ⇒ ⟨ k , j ⟩ ∈ einv u M w $ by isset_elim [n5, n4]
n7: $ … ⇒ crn j ⊆ einv u M w → ⟨ k , j ⟩ ∈ einv u M w $ by imp_intro [n6]
n8: $ … ⇒ j ∊ fseq (trees ω) → crn j ⊆ einv u M w → ⟨ k , j ⟩ ∈ einv u M w $ by imp_intro [n7]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ einv u M w → ⟨ k , j ⟩ ∈ einv u M w $ by imp_intro [n8]
n10: $ … ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ einv u M w → ⟨ k , j ⟩ ∈ einv u M w) $ by all_intro [n9]
n11: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ einv u M w → ⟨ k , j ⟩ ∈ einv u M w) $ by all_intro [n10]
n12: $ G ⇒ isset ω $ by omega_set
n13: $ … ⇒ trees ω ⊆ einv u M w $ by trees_ind_c [n12, n11]

lrel2_eeqv_node
---------------
l1: $ … ⇒ dt u M z w r = dt u M t w r $ by g3_node [#1, #2, #3, #4, #5, #6, #7]

einv_intro
----------
l1: $ … ⇒ x ∊ einv u M w $ by g3_P_i [#1]

einv_elim
---------
l1: $ … ⇒ dt u M x w R = dt u M c w R $ by g3_P_e [#1, #2, #3]

lrel2_eeqv_trees
----------------
l1: $ … ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by g3_atoms [#1]

lrel2_eeqv_dt
-------------
l1: $ … ⇒ trees ω ⊆ einv u M w $ by g3_all [#1, #2, #5]
l2: $ G ⇒ sig lsig lopen $ by lsig_sig
l3: $ … ⇒ ofsort lsig lopen ks_expr ⊆ trees ω $ by ofsort_trees [l2]
l4: $ … ⇒ t ∊ trees ω $ by subset_elim [l3, #3]
l5: $ … ⇒ t ∊ einv u M w $ by subset_elim [l1, l4]
l6: $ G ⇒ isset r $ by isset_var
l7: $ … ⇒ dt u M t w r = dt u M t2 w r $ by g3_P_e [l5, #4, l6]

eeqv_dt
-------
l1: $ _ ⇒ enc_expr e ∈ ofsort lsig lopen ks_expr $ by enc_expr_sorted
l2: $ G ⇒ enc_expr e ∈ ofsort lsig lopen ks_expr $ by weaken [l1]
l3: $ G ⇒ enc_expr e2 ∈ trees ω $ by enc_expr_trees
l4: $ … ⇒ isset (enc_expr e2) $ by wcel_isset [l3]
h1: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ minv M $ by weaken [#1]
h2: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ uadm u $ by weaken [#3]
h3: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ x ∊ ofsort lsig lopen ks_expr $ by ax
h4: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ ra_eeqv (enc_expr e) (enc_expr e2) ∈ lrel2 $ by weaken [#2]
h5: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ x = enc_expr e $ by ax
h6: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ y = enc_expr e2 $ by ax
h7: $ … ⇒ enc_expr e = x $ by eq_sym [h5]
h8: $ … ⇒ enc_expr e2 = y $ by eq_sym [h6]
h9: $ … ⇒ ra_eeqv (enc_expr e) (enc_expr e2) = ra_eeqv x y $ by ra_eeqv_eq [h7, h8]
h10: $ … ⇒ ra_eeqv x y ∈ lrel2 $ by wcel_eq_l [h9, h4]
h11: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ w ∊ lvals $ by weaken [#4]
h12: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ r ∊ fseq u $ by weaken [#5]
h13: $ … ⇒ dt u M x w r = dt u M y w r $ by lrel2_eeqv_dt [h1, h2, h3, h10, h11, h12]
q1: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ u = u $ by eq_refl
q2: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ M = M $ by eq_refl
q3: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ w = w $ by eq_refl
q4: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ r = r $ by eq_refl
q5: $ … ⇒ dt u M (enc_expr e) w r = dt u M x w r $ by dt_eq [q1, q2, h7, q3, q4]
q6: $ … ⇒ dt u M y w r = dt u M (enc_expr e2) w r $ by dt_eq [q1, q2, h6, q3, q4]
q7: $ … ⇒ dt u M (enc_expr e) w r = dt u M y w r $ by eq_trans [q5, h13]
h14: $ … ⇒ dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r $ by eq_trans [q7, q6]
h15: $ … ⇒ dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r $ by isset_elim [l4, h14]
h16: $ … ⇒ dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r $ by wcel_elim [l2, h15]

meeqv_df
--------
a1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ uadm u $ by ax
a2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
a3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ sat u M (enc_ctx G) w $ by ax
s1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ sat u M (enc_ctx G) w ⊆ fseq u $ by sat_fseq
s2: $ … ⇒ r ∊ fseq u $ by subset_elim [s1, a3]
m0: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ minv M $ by weaken [#1]
e1: $ … ⇒ dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r $ by eeqv_dt [m0, #3, a1, a2, s2]
m1: $ … ⇒ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r $ by mdeq_mem [#2, a1, a2, a3]
r1: $ mdeq M G e e2 A $ by mdeq_i [e1, m1]
