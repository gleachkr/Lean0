q12: $ … ⇒ ap (λₛ x ∈ dt u M (enc_expr A) w v, dt u M (enc_expr e) w (x +: v)) (dt u M (enc_expr a) w v) = dt u M (enc_expr e) w (dt u M (enc_expr a) w v +: v) $ by eq_trans [q11, q8]
