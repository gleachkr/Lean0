a1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ uadm u $ by ax
a2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
a3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ sat u M (enc_ctx G) w $ by ax
s1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ sat u M (enc_ctx G) w ⊆ fseq u $ by sat_fseq
s2: $ … ⇒ r ∊ fseq u $ by subset_elim [s1, a3]
tf: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr f ∈ trees ω $ by enc_expr_trees
ta: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr a ∈ trees ω $ by enc_expr_trees
tf2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr f2 ∈ trees ω $ by enc_expr_trees
ta2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr a2 ∈ trees ω $ by enc_expr_trees
tA: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr A ∈ trees ω $ by enc_expr_trees
tB: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr B ∈ trees ω $ by enc_expr_trees
d1: $ … ⇒ dt u M ⟨ kc_app , enc_expr f +: enc_expr a +: ∅ ⟩ w r = ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) $ by dt_app [tf, ta, a2, s2]
d2: $ … ⇒ dt u M ⟨ kc_app , enc_expr f2 +: enc_expr a2 +: ∅ ⟩ w r = ap (dt u M (enc_expr f2) w r) (dt u M (enc_expr a2) w r) $ by dt_app [tf2, ta2, a2, s2]
d3: $ … ⇒ dt u M ⟨ kc_pi , enc_expr A +: enc_expr B +: ∅ ⟩ w r = (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) $ by dt_pi [tA, tB, a2, s2]
e1: $ … ⇒ dt u M (enc_expr f) w r = dt u M (enc_expr f2) w r $ by mdeq_e [#1, a1, a2, a3]
e2: $ … ⇒ dt u M (enc_expr a) w r = dt u M (enc_expr a2) w r $ by mdeq_e [#2, a1, a2, a3]
e3: $ … ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) = ap (dt u M (enc_expr f2) w r) (dt u M (enc_expr a2) w r) $ by ap_eq [e1, e2]
e4: $ … ⇒ ap (dt u M (enc_expr f2) w r) (dt u M (enc_expr a2) w r) = dt u M ⟨ kc_app , enc_expr f2 +: enc_expr a2 +: ∅ ⟩ w r $ by eq_sym [d2]
e5: $ … ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) = dt u M ⟨ kc_app , enc_expr f2 +: enc_expr a2 +: ∅ ⟩ w r $ by eq_trans [e3, e4]
e6: $ … ⇒ dt u M ⟨ kc_app , enc_expr f +: enc_expr a +: ∅ ⟩ w r = dt u M ⟨ kc_app , enc_expr f2 +: enc_expr a2 +: ∅ ⟩ w r $ by eq_trans [d1, e5]
m1: $ … ⇒ dt u M (enc_expr f) w r ∈ dt u M ⟨ kc_pi , enc_expr A +: enc_expr B +: ∅ ⟩ w r $ by mdeq_mem [#1, a1, a2, a3]
m2: $ … ⇒ dt u M (enc_expr f) w r ∈ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) $ by wcel_eq_r [d3, m1]
m3: $ … ⇒ dt u M (enc_expr a) w r ∈ dt u M (enc_expr A) w r $ by mdeq_mem [#2, a1, a2, a3]
n1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) $ by ax
n2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ z ∊ dt u M (enc_expr A) w r $ by ax
n3: $ … ⇒ ap y z ∈ dt u M (enc_expr B) w (z +: r) $ by cpi_elim_ap [n1, n2]
n4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ y = dt u M (enc_expr f) w r $ by ax
n5: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ z = dt u M (enc_expr a) w r $ by ax
n6: $ … ⇒ ap y z = ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) $ by ap_eq [n4, n5]
n7: $ … ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr B) w (z +: r) $ by wcel_eq_l [n6, n3]
q1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ u = u $ by eq_refl
q2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ M = M $ by eq_refl
q3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ enc_expr B = enc_expr B $ by eq_refl
q4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ w = w $ by eq_refl
q5: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ (Πₛ x ∈ dt u M (enc_expr A) w r, dt u M (enc_expr B) w (x +: r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ r = r $ by eq_refl
q6: $ … ⇒ z +: r = dt u M (enc_expr a) w r +: r $ by scons_eq [n5, q5]
q7: $ … ⇒ dt u M (enc_expr B) w (z +: r) = dt u M (enc_expr B) w (dt u M (enc_expr a) w r +: r) $ by dt_eq [q1, q2, q3, q4, q6]
n8: $ … ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr B) w (dt u M (enc_expr a) w r +: r) $ by wcel_eq_r [q7, n7]
n9: $ … ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr B) w (dt u M (enc_expr a) w r +: r) $ by wcel_elim [m3, n8]
n10: $ … ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr B) w (dt u M (enc_expr a) w r +: r) $ by wcel_elim [m2, n9]
