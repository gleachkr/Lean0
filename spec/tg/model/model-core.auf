i4: $ … ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) = dt u M ⟨ kc_app , enc_expr f +: enc_expr a +: ∅ ⟩ w r $ by eq_sym [d1]
