lemma g3_k_lit (H: hyps) (M: class) (u w r z k j t n: set): $ H ⇒ minvh M u w z $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ crn j ⊆ einv u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ ra_eeqv z t ∈ lrel2 $ > $ H ⇒ z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩ → dt u M z w r = dt u M t w r $
----
c0: $ H , z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩ ⇒ z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩ $ by ax
e0: $ … ⇒ z = ⟨ kc_lit , n +: ∅ ⟩ $ by and_elim_l [c0]
r0: $ … ⇒ t = ⟨ kc_lit , n +: ∅ ⟩ $ by and_elim_r [c0]
s1: $ … ⇒ ⟨ kc_lit , n +: ∅ ⟩ = t $ by eq_sym [r0]
s2: $ … ⇒ z = t $ by eq_trans [e0, s1]
q1: $ H , z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩ ⇒ u = u $ by eq_refl
q2: $ H , z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩ ⇒ M = M $ by eq_refl
q3: $ H , z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩ ⇒ w = w $ by eq_refl
q4: $ H , z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩ ⇒ r = r $ by eq_refl
s3: $ … ⇒ dt u M z w r = dt u M t w r $ by dt_eq [q1, q2, s2, q3, q4]
fin: $ … ⇒ z = ⟨ kc_lit , n +: ∅ ⟩ ∧ t = ⟨ kc_lit , n +: ∅ ⟩ → dt u M z w r = dt u M t w r $ by imp_intro [s3]

lemma g3_k_cst (H: hyps) (M: class) (u w r z k j t a x4 x5: set): $ H ⇒ minvh M u w z $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ crn j ⊆ einv u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ ra_eeqv z t ∈ lrel2 $ > $ H ⇒ z = ⟨ kc_cst , a +: x4 +: ∅ ⟩ ∧ t = ⟨ kc_cst , a +: x5 +: ∅ ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 → dt u M z w r = dt u M t w r $
----
c0: $ H , z = ⟨ kc_cst , a +: x4 +: ∅ ⟩ ∧ t = ⟨ kc_cst , a +: x5 +: ∅ ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 ⇒ z = ⟨ kc_cst , a +: x4 +: ∅ ⟩ ∧ t = ⟨ kc_cst , a +: x5 +: ∅ ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 $ by ax
