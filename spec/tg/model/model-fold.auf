--| @freshen G x
--| @freshen G t
--| @freshen G f
lemma f13_mw_n {x t f: set} (G: hyps) (M Z: class) (u w td tj tnp tv p c0 rr n0: set) (ty k1 j1 vd vm ve vr: set): $ G ⇒ crn j1 ⊆ f13_mw_q M Z u w td tj tnp tv p c0 rr n0 $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' tnp $ > $ G ⇒ c0 ∊ fseq u $ > $ G ⇒ cdm c0 = nvf' tj $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ > $ G ⇒ n0 ∊ trees ω $ > $ G ⇒ ∀ x (x ∊ fseq u → dt u M n0 w x = Z) $ > $ G ⇒ tv ∊ trees ω $ > $ G ⇒ ra_mty td tnp tj vd tv ty vm ∈ lrel $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ve ∊ fseq u $ > $ G ⇒ cdm ve = nvf' vd $ > $ G ⇒ vr = ve ++ c0 ++ p ++ rr $ > $ G ⇒ dt u M vm w vr = fpi t (mpth u (dnf u M) ty w vr (clam f (fseq u) (apn (Z) (f ++ ve ++ p)))) (ap (clam f (fseq u) (uni' (lv tv w))) t) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ g ∃ b ∃ n (td = x1 ∧ tnp = x2 ∧ tj = x3 ∧ vd = x4 ∧ tv = x5 ∧ ty = ⟨ kc_pi , scons g (scons b ∅) ⟩ ∧ vm = ⟨ kc_pi , scons g (scons n ∅) ⟩ ∧ ra_mty x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x5 b n ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ k ∃ x5 ∃ l ∃ x ∃ i (td = x1 ∧ tnp = x2 ∧ tj = x3 ∧ vd = x4 ∧ tv = x5 ∧ ty = ⟨ kc_srt , scons l ∅ ⟩ ∧ vm = ⟨ kc_pi , scons i (scons ⟨ kc_srt , scons x5 ∅ ⟩ ∅) ⟩ ∧ ra_add x4 x3 k ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons x1 (scons x3 ∅) ⟩ k x2 x ∈ lrel ∧ ra_pargs x ⟨ kc_nz , ∅ ⟩ x4 i ∈ lrel) $ by lrel_mty_cases [#16]
l2: $ G , td = x1 ∧ tnp = x2 ∧ tj = x3 ∧ vd = x4 ∧ tv = x5 ∧ ty = ⟨ kc_pi , scons g (scons b ∅) ⟩ ∧ vm = ⟨ kc_pi , scons g (scons n ∅) ⟩ ∧ ra_mty x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x5 b n ∈ lrel ⇒ td = x1 ∧ tnp = x2 ∧ tj = x3 ∧ vd = x4 ∧ tv = x5 ∧ ty = ⟨ kc_pi , scons g (scons b ∅) ⟩ ∧ vm = ⟨ kc_pi , scons g (scons n ∅) ⟩ ∧ ra_mty x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x5 b n ∈ lrel $ by ax
l3: $ G , td = x1 ∧ tnp = x2 ∧ tj = x3 ∧ vd = x4 ∧ tv = x5 ∧ ty = ⟨ kc_pi , scons g (scons b ∅) ⟩ ∧ vm = ⟨ kc_pi , scons g (scons n ∅) ⟩ ∧ ra_mty x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x5 b n ∈ lrel ⇒ ve ∊ fseq u $ by weaken [#20]
