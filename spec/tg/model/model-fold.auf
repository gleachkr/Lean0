l28: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ td = td $ by eq_refl
l29: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ tz = tz $ by eq_refl
l30: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ tn = tn $ by eq_refl
l31: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ th = th $ by eq_refl
l32: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ f = f $ by eq_refl
l33: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ ra_sinst td tz tn th ⟨ kc_bvar , scons t ∅ ⟩ f ∈ lrel $ by wcel_eq_l [ra_sinst_eq [l28, l29, l30, l31, weaken [l12], l32], and_elim_r [l25]]
l34: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ ra_add th ti t ∈ lrel $ by weaken [l7]
l35: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ ra_add tz ti ti ∈ lrel $ by weaken [l11]
l36: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel $ by weaken [l8]
l37: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ f = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ by sinst_bvar [l27, l33, l34, l35, l36]
l38: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ tb = tb $ by eq_refl
l39: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ n = n $ by eq_refl
l40: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tb n ∈ lrel $ by wcel_eq_l [ra_spine_eq [l37, l38, l39], and_elim_l [l25]]
l41: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ , ra_spine f tb n ∈ lrel ∧ ra_sinst td tz tn th x5 f ∈ lrel ⇒ ∃ m (ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tb m ∈ lrel) $ by ex_intro [l40]
l42: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel , x5 = ⟨ kc_bvar , scons t ∅ ⟩ ⇒ ∃ m (ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tb m ∈ lrel) $ by ex_elim [l24, l41]
l43: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel ⇒ isset ⟨ kc_bvar , scons t ∅ ⟩ $ by opair_isset
l44: $ G , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ te n ∈ lrel ∧ ra_add tg tnp k ∈ lrel ∧ ra_add k ti t ∈ lrel ∧ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ tg tnp p ∈ lrel ∧ ra_nidx td ti o ∈ lrel ∧ ra_iargs k o p te ∈ lrel ⇒ ∃ m (ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tb m ∈ lrel) $ by isset_elim [l43, l42]
l45: $ G ⇒ ∃ m (ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tb m ∈ lrel) $ by f21_inv_indapp [#1, l44]

def f31_pe_q (M: class) (u w s tt a: set) (.y .b .p .x .g .t .h .l: set): class = $ {y | ∀ b ∀ p ∀ x ∀ g ∀ t (w ∊ lvals → s ∊ fseq u → ra_pis y b tt ∈ lrel → p ∊ esat u (dsh u M s) y w → ⟨ x , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) b w (p ++ s) → ∃ h ∃ l (⟨ x ++ p , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s))} $

--| @freshen G h
--| @freshen G l
lemma f31_pe_e {h l: set} (G: hyps) (M: class) (u w s tt a: set) (ty vb vp vx vg vt: set): $ G ⇒ ty ∊ f31_pe_q M u w s tt a $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ ra_pis ty vb tt ∈ lrel $ > $ G ⇒ vp ∊ esat u (dsh u M s) ty w $ > $ G ⇒ ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) $ > $ G ⇒ ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $
----
l1: $ G ⇒ ∀ b ∀ p ∀ x ∀ g ∀ t (w ∊ lvals → s ∊ fseq u → ra_pis ty b tt ∈ lrel → p ∊ esat u (dsh u M s) ty w → ⟨ x , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) b w (p ++ s) → ∃ h ∃ l (⟨ x ++ p , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ p ∀ x ∀ g ∀ t (w ∊ lvals → s ∊ fseq u → ra_pis ty vb tt ∈ lrel → p ∊ esat u (dsh u M s) ty w → ⟨ x , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (p ++ s) → ∃ h ∃ l (⟨ x ++ p , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s)) $ by all_elim [l1]
l3: $ G ⇒ ∀ x ∀ g ∀ t (w ∊ lvals → s ∊ fseq u → ra_pis ty vb tt ∈ lrel → vp ∊ esat u (dsh u M s) ty w → ⟨ x , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) → ∃ h ∃ l (⟨ x ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s)) $ by all_elim [l2]
l4: $ G ⇒ ∀ g ∀ t (w ∊ lvals → s ∊ fseq u → ra_pis ty vb tt ∈ lrel → vp ∊ esat u (dsh u M s) ty w → ⟨ vx , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) → ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s)) $ by all_elim [l3]
l5: $ G ⇒ ∀ t (w ∊ lvals → s ∊ fseq u → ra_pis ty vb tt ∈ lrel → vp ∊ esat u (dsh u M s) ty w → ⟨ vx , ⟨ vg , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) → ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s)) $ by all_elim [l4]
l6: $ G ⇒ w ∊ lvals → s ∊ fseq u → ra_pis ty vb tt ∈ lrel → vp ∊ esat u (dsh u M s) ty w → ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) → ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by all_elim [l5]
l7: $ G ⇒ s ∊ fseq u → ra_pis ty vb tt ∈ lrel → vp ∊ esat u (dsh u M s) ty w → ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) → ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by imp_elim [l6, #2]
l8: $ G ⇒ ra_pis ty vb tt ∈ lrel → vp ∊ esat u (dsh u M s) ty w → ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) → ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by imp_elim [l7, #3]
l9: $ G ⇒ vp ∊ esat u (dsh u M s) ty w → ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) → ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by imp_elim [l8, #4]
l10: $ G ⇒ ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) → ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by imp_elim [l9, #5]
l11: $ G ⇒ ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by imp_elim [l10, #6]

--| @freshen G h
--| @freshen G l
lemma f31_pe_n {h l: set} (G: hyps) (M: class) (u w s tt a: set) (ty k1 j1 vb vp vx vg vt: set): $ G ⇒ crn j1 ⊆ f31_pe_q M u w s tt a $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ ra_pis ty vb tt ∈ lrel $ > $ G ⇒ vp ∊ esat u (dsh u M s) ty w $ > $ G ⇒ ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) $ > $ G ⇒ ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $
----
l1: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb $ by ax
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ w = w $ by eq_refl
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ w ∊ lvals $ by weaken [#5]
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ esat u (dsh u M s) ty w = csn ∅ $ by eq_trans [esat_eq [and_elim_l [l1], l2], esat_nil [l3]]
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ vp ∊ esat u (dsh u M s) ty w $ by weaken [#8]
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ vp ∊ csn ∅ $ by wcel_welc [wcel_eq_r [l4, welc_wcel [l5]]]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ vp = ∅ $ by csn_elim [l6]
l8: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ s = s $ by eq_refl
l9: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ s ∊ fseq u $ by weaken [#6]
l10: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ vp ++ s = s $ by eq_trans [scat_eq [l7, l8], scat_empty_l [l9]]
l11: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ vx = vx $ by eq_refl
l12: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ vx ++ ∅ = vx $ by scat_empty_r
l13: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ vx ++ vp = vx $ by eq_trans [scat_eq [l11, l7], l12]
l14: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w (vp ++ s) $ by weaken [#9]
l15: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s $ by wcel_eq_r [etel_eq [eq_sym [and_elim_r [l1]], l2, l10], l14]
l16: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ ⟨ vg , ⟨ vt , a ⟩ ⟩ = ⟨ vg , ⟨ vt , a ⟩ ⟩ $ by eq_refl
l17: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ ⟨ vx ++ vp , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s $ by wcel_eq_l [opair_eq [eq_sym [l13], l16], l15]
l18: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ ∃ l (⟨ vx ++ vp , ⟨ vg , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by ex_intro [l17]
l19: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ tt = vb ⇒ ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by ex_intro [l18]
