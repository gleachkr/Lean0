l210: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel , v ∊ fseq {y | y = y} ∧ cdm v = nvf' d ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' d → v' m = (dt u M te w r)' (suc i)) ∧ dt u M c w r = apn (dt u M tY w r) v , x = dt u M ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ w r , o = scons x v , n = nvf' d ⇒ dt u M tY w r = dt u M tY w r $ by eq_refl
l211: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel , v ∊ fseq {y | y = y} ∧ cdm v = nvf' d ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' d → v' m = (dt u M te w r)' (suc i)) ∧ dt u M c w r = apn (dt u M tY w r) v , x = dt u M ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ w r , o = scons x v , n = nvf' d ⇒ dt u M vq w r = apn (dt u M tY w r) o $ by eq_trans [dt_eq [l204, l205, l206, l207, l208], eq_trans [l209, eq_trans [ap_eq [l148, eq_sym [l142]], eq_sym [eq_trans [apn_eq [l210, l143], apn_scons [l145]]]]]]
