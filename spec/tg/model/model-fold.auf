--| @freshen G a
--| @freshen G c
--| @freshen G m
--| @freshen G b
--| @freshen G e
lemma f25_dec {a c m b e: set} (G: hyps) (E J V: class) (u w td tb tp tt tF z: set): $ G ⇒ uadm u $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ityf td J tF $ > $ G ⇒ tF ∊ trees ω $ > $ G ⇒ ity u E td J w ∈ u $ > $ G ⇒ z ∊ irc u E td J V w $ > $ G ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ z = nest a (nest c (nest m (nest b e)))) $
----
l1: $ G ⇒ ∃ b (ra_ind_data td b tp tt ∈ lrel) $ by ex_intro [#2]
