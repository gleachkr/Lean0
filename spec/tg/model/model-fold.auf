l11: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ z = ∅ $ by ax
l12: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ cdm x1 = z $ by eq_trans [cdm_eq [l6], eq_trans [l10, eq_sym [l11]]]
l13: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ c = c $ by eq_refl
l14: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ c = x1 ++ c $ by eq_sym [eq_trans [scat_eq [l6, l13], scat_empty_l [l7]]]
l15: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ cdm c = b $ by weaken [l5]
l16: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ x1 ∊ fseq A ∧ c ∊ fseq A ∧ cdm x1 = z ∧ cdm c = b ∧ c = x1 ++ c $ by and_intro [l9, and_intro [l7, and_intro [l12, and_intro [l15, l14]]]]
l17: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ ∃ g (x1 ∊ fseq A ∧ g ∊ fseq A ∧ cdm x1 = z ∧ cdm g = b ∧ c = x1 ++ g) $ by ex_intro [l16]
l18: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by ex_intro [l17]
l19: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b ⇒ isset ∅ $ by ax_empty
l20: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by isset_elim [l19, l18]
l21: $ G , z = ∅ , c ∊ fseq A ⇒ cdm c = nadd z b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by imp_intro [l20]
