l6: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_nil , ∅ ⟩ ∧ x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_s , scons tk ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [eq_sym [l5], and_elim_r [l4]]
l7: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_nil , ∅ ⟩ ∧ x1 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_s ∈ ω $ by kc_s_omega
l8: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_nil , ∅ ⟩ ∧ x1 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_nz ∈ ω $ by kc_nz_omega
l9: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_nil , ∅ ⟩ ∧ x1 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_s = kc_nz $ by opair_inj_l_c [l6, wcel_isset [l7], wcel_isset [l8]]
l10: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_nil , ∅ ⟩ ∧ x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_nz = kc_s $ by kc_nz_ne_s
l11: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_nil , ∅ ⟩ ∧ x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_s = kc_nz $ by ne_sym [l10]
l12: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_nil , ∅ ⟩ ∧ x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ a ∃ p (tq = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_clen p tk ∈ lrel) $ by bot_elim [not_elim [l11, l9]]
l13: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel $ by ax
l14: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ x1 = ⟨ kc_s , scons tk ∅ ⟩ $ by weaken [l1]
l15: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l16: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ tk = f $ by node1_inj [wcel_isset [l15], eq_trans [eq_sym [l14], and_elim_l [and_elim_r [l13]]]]
l17: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ e = e $ by eq_refl
l18: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_clen e tk ∈ lrel $ by and_intro [and_elim_l [l13], wcel_eq_l [ra_clen_eq [l17, eq_sym [l16]], and_elim_r [and_elim_r [l13]]]]
l19: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ ∃ p (tq = ⟨ kc_cons , scons d (scons p ∅) ⟩ ∧ ra_clen p tk ∈ lrel) $ by ex_intro [l18]
l20: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ ∃ a ∃ p (tq = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_clen p tk ∈ lrel) $ by ex_intro [l19]
l21: $ G , x1 = ⟨ kc_s , scons tk ∅ ⟩ ⇒ ∃ a ∃ p (tq = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_clen p tk ∈ lrel) $ by f21_inv_clen [l3, l12, l20]
l22: $ G ⇒ isset ⟨ kc_s , scons tk ∅ ⟩ $ by opair_isset
l23: $ G ⇒ ∃ a ∃ p (tq = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_clen p tk ∈ lrel) $ by isset_elim [l22, l21]

pis_nil_inv
-----------
l1: $ G , x1 = ⟨ kc_nil , ∅ ⟩ ⇒ x1 = ⟨ kc_nil , ∅ ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_nil , ∅ ⟩ ⇒ tb = tb $ by eq_refl
l3: $ G , x1 = ⟨ kc_nil , ∅ ⟩ ⇒ tt = tt $ by eq_refl
l4: $ G , x1 = ⟨ kc_nil , ∅ ⟩ ⇒ ra_pis x1 tb tt ∈ lrel $ by wcel_eq_l [ra_pis_eq [eq_sym [l1], l2, l3], weaken [#1]]
l5: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb $ by ax
l6: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ x1 = ⟨ kc_nil , ∅ ⟩ $ by weaken [l1]
l7: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel $ by ax
l8: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ x1 = ⟨ kc_nil , ∅ ⟩ $ by weaken [l1]
l9: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_cons , scons d (scons e ∅) ⟩ $ by eq_trans [eq_sym [l8], and_elim_l [l7]]
l10: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ kc_nil ∈ ω $ by kc_nil_omega
l11: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l12: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ kc_nil = kc_cons $ by opair_inj_l_c [l9, wcel_isset [l10], wcel_isset [l11]]
l13: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
l14: $ G , x1 = ⟨ kc_nil , ∅ ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ tt = tb $ by bot_elim [not_elim [l13, l12]]
l15: $ G , x1 = ⟨ kc_nil , ∅ ⟩ ⇒ tt = tb $ by f21_inv_pis [l4, and_elim_r [l5], l14]
l16: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ tt = tb $ by isset_elim [l16, l15]

pis_cons_inv
------------
l1: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ ⇒ x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ ⇒ tb = tb $ by eq_refl
l3: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ ⇒ tt = tt $ by eq_refl
l4: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ ⇒ ra_pis x1 tb tt ∈ lrel $ by wcel_eq_l [ra_pis_eq [eq_sym [l1], l2, l3], weaken [#1]]
l5: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb $ by ax
l6: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ $ by weaken [l1]
l7: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ ⟨ kc_cons , scons ta (scons tp ∅) ⟩ = ⟨ kc_nil , ∅ ⟩ $ by eq_trans [eq_sym [l6], and_elim_l [l5]]
l8: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ kc_cons ∈ ω $ by kc_cons_omega
l9: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ kc_nil ∈ ω $ by kc_nil_omega
l10: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ kc_cons = kc_nil $ by opair_inj_l_c [l7, wcel_isset [l8], wcel_isset [l9]]
l11: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
l12: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ ¬ kc_cons = kc_nil $ by ne_sym [l11]
l13: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_nil , ∅ ⟩ ∧ tt = tb ⇒ ra_pis tp ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tt ∈ lrel $ by bot_elim [not_elim [l12, l10]]
l14: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel $ by ax
l15: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ $ by weaken [l1]
l16: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l17: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ ta = d ∧ tp = e $ by node2_inj [wcel_isset [l16], eq_trans [eq_sym [l15], and_elim_l [l14]]]
l18: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ kc_pi = kc_pi $ by eq_refl
l19: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ scons tb ∅ = scons tb ∅ $ by eq_refl
l20: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ tt = tt $ by eq_refl
l21: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ , x1 = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons tb ∅) ⟩ tt ∈ lrel ⇒ ra_pis tp ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tt ∈ lrel $ by wcel_eq_l [ra_pis_eq [eq_sym [and_elim_r [l17]], opair_eq [l18, scons_eq [eq_sym [and_elim_l [l17]], l19]], l20], and_elim_r [l14]]
l22: $ G , x1 = ⟨ kc_cons , scons ta (scons tp ∅) ⟩ ⇒ ra_pis tp ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tt ∈ lrel $ by f21_inv_pis [l4, l13, l21]
l23: $ G ⇒ isset ⟨ kc_cons , scons ta (scons tp ∅) ⟩ $ by opair_isset
l24: $ G ⇒ ra_pis tp ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tt ∈ lrel $ by isset_elim [l23, l22]

sarg_app
--------
l1: $ G ⇒ etel u (dnf u M) te w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) te w r ⟩ ⟩ ⟩ ∧ cdm (sarg u (dnf u M) te w r) = nvf' tk ∧ dt u M te w r = apn (dt u M ⟨ K , S ⟩ w r) (sarg u (dnf u M) te w r) $ by lrel_spine_sem [#1, #2, #3, #4, #5, #7, #8]
l2: $ G ⇒ isset te $ by isset_var
l3: $ G ⇒ isset (sarg u (dnf u M) te w r) $ by sarg_set [l2]
l4: $ G ⇒ etel u (dnf u M) ⟨ kc_app , scons te (scons ta ∅) ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M ta w r) (sarg u (dnf u M) te w r) ⟩ ⟩ ⟩ $ by etel_app_csn [welc_wcel [#5], welc_wcel [#6], #7, #8, and_elim_l [l1], l3]
l5: $ G ⇒ sarg u (dnf u M) ⟨ kc_app , scons te (scons ta ∅) ⟩ w r = scons (dt u M ta w r) (sarg u (dnf u M) te w r) $ by sarg_csn [l4, scons_set [l3]]

def f28_sw_q (J M K S: class) (u w c r tA d0 i0: set) (.y .n .q .p .t .g: set): class = $ {y | ∀ n ∀ q ∀ p ∀ t (jval u M J → uadm u → w ∊ lvals → r ∊ sat u M c w → ⟨ K , S ⟩ ∈ trees ω → ¬ K = kc_pi → ¬ K = kc_app → isset K → ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ ofsort lsig lopen ks_expr → ra_sty c ⟨ K , S ⟩ tA y t ∈ lrel3 J → ra_spine ⟨ K , S ⟩ y n ∈ lrel → ra_pis q p tA ∈ lrel → ra_clen q n ∈ lrel → y ∊ ofsort lsig lopen ks_expr → ∃ g (ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ n y g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g p t ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) y w r ∧ sarg u (dnf u M) y w r ∈ esat u (dsh u M r) q w))} $

--| @freshen G g
lemma f28_sw_e {g: set} (G: hyps) (J M K S: class) (u w c r tA d0 i0: set) (ty vn vq vp vt: set): $ G ⇒ ty ∊ f28_sw_q J M K S u w c r tA d0 i0 $ > $ G ⇒ jval u M J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ sat u M c w $ > $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ isset K $ > $ G ⇒ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J $ > $ G ⇒ ra_spine ⟨ K , S ⟩ ty vn ∈ lrel $ > $ G ⇒ ra_pis vq vp tA ∈ lrel $ > $ G ⇒ ra_clen vq vn ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ∃ g (ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ vn ty g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g vp vt ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) ty w r ∧ sarg u (dnf u M) ty w r ∈ esat u (dsh u M r) vq w) $
----
l1: $ G ⇒ ∀ n ∀ q ∀ p ∀ t (jval u M J → uadm u → w ∊ lvals → r ∊ sat u M c w → ⟨ K , S ⟩ ∈ trees ω → ¬ K = kc_pi → ¬ K = kc_app → isset K → ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ ofsort lsig lopen ks_expr → ra_sty c ⟨ K , S ⟩ tA ty t ∈ lrel3 J → ra_spine ⟨ K , S ⟩ ty n ∈ lrel → ra_pis q p tA ∈ lrel → ra_clen q n ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → ∃ g (ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ n ty g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g p t ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) ty w r ∧ sarg u (dnf u M) ty w r ∈ esat u (dsh u M r) q w)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ q ∀ p ∀ t (jval u M J → uadm u → w ∊ lvals → r ∊ sat u M c w → ⟨ K , S ⟩ ∈ trees ω → ¬ K = kc_pi → ¬ K = kc_app → isset K → ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ ofsort lsig lopen ks_expr → ra_sty c ⟨ K , S ⟩ tA ty t ∈ lrel3 J → ra_spine ⟨ K , S ⟩ ty vn ∈ lrel → ra_pis q p tA ∈ lrel → ra_clen q vn ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → ∃ g (ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ vn ty g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g p t ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) ty w r ∧ sarg u (dnf u M) ty w r ∈ esat u (dsh u M r) q w)) $ by all_elim [l1]
l3: $ G ⇒ ∀ p ∀ t (jval u M J → uadm u → w ∊ lvals → r ∊ sat u M c w → ⟨ K , S ⟩ ∈ trees ω → ¬ K = kc_pi → ¬ K = kc_app → isset K → ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ ofsort lsig lopen ks_expr → ra_sty c ⟨ K , S ⟩ tA ty t ∈ lrel3 J → ra_spine ⟨ K , S ⟩ ty vn ∈ lrel → ra_pis vq p tA ∈ lrel → ra_clen vq vn ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → ∃ g (ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ vn ty g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g p t ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) ty w r ∧ sarg u (dnf u M) ty w r ∈ esat u (dsh u M r) vq w)) $ by all_elim [l2]
