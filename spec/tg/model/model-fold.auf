l177: $ G , H ⇒ (∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ qj_v ∃ x ∃ qe_v ∃ y (t1 = x ∧ t2 = qe_v ∧ t3 = y ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v x ∈ lrel) ∨ ∃ x ∃ qb_v ∃ qi_v ∃ qe_v ∃ y ∃ qe2 (t1 = x ∧ t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_inst x qe_v y qe2 ∈ lrel)) → Cf $ by or_elim_imp [l109, l176]
l178: $ G , H ⇒ (∃ x ∃ qf_v ∃ qx_v ∃ y ∃ qf2 ∃ qx2_v (t1 = x ∧ t2 = ⟨ kc_app , scons qf_v (scons qx_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_app , scons qf2 (scons qx2_v ∅) ⟩ ∧ ra_inst x qf_v y qf2 ∈ lrel ∧ ra_inst x qx_v y qx2_v ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ qj_v ∃ x ∃ qe_v ∃ y (t1 = x ∧ t2 = qe_v ∧ t3 = y ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v x ∈ lrel) ∨ ∃ x ∃ qb_v ∃ qi_v ∃ qe_v ∃ y ∃ qe2 (t1 = x ∧ t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_inst x qe_v y qe2 ∈ lrel)) → Cf $ by or_elim_imp [l83, l177]
l179: $ G , H ⇒ (∃ x ∃ ql_v ∃ y (t1 = x ∧ t2 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ qf_v ∃ qx_v ∃ y ∃ qf2 ∃ qx2_v (t1 = x ∧ t2 = ⟨ kc_app , scons qf_v (scons qx_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_app , scons qf2 (scons qx2_v ∅) ⟩ ∧ ra_inst x qf_v y qf2 ∈ lrel ∧ ra_inst x qx_v y qx2_v ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ qj_v ∃ x ∃ qe_v ∃ y (t1 = x ∧ t2 = qe_v ∧ t3 = y ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v x ∈ lrel) ∨ ∃ x ∃ qb_v ∃ qi_v ∃ qe_v ∃ y ∃ qe2 (t1 = x ∧ t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_inst x qe_v y qe2 ∈ lrel)) → Cf $ by or_elim_imp [l59, l178]
l180: $ G , H ⇒ (∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons ⟨ kc_s , scons qi_v ∅ ⟩ ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le x qi_v ∈ lrel) ∨ ∃ x ∃ ql_v ∃ y (t1 = x ∧ t2 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ qf_v ∃ qx_v ∃ y ∃ qf2 ∃ qx2_v (t1 = x ∧ t2 = ⟨ kc_app , scons qf_v (scons qx_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_app , scons qf2 (scons qx2_v ∅) ⟩ ∧ ra_inst x qf_v y qf2 ∈ lrel ∧ ra_inst x qx_v y qx2_v ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ qj_v ∃ x ∃ qe_v ∃ y (t1 = x ∧ t2 = qe_v ∧ t3 = y ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v x ∈ lrel) ∨ ∃ x ∃ qb_v ∃ qi_v ∃ qe_v ∃ y ∃ qe2 (t1 = x ∧ t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_inst x qe_v y qe2 ∈ lrel)) → Cf $ by or_elim_imp [l47, l179]
l181: $ G , H ⇒ (∃ x ∃ y ∃ z (t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel) ∨ ∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons ⟨ kc_s , scons qi_v ∅ ⟩ ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le x qi_v ∈ lrel) ∨ ∃ x ∃ ql_v ∃ y (t1 = x ∧ t2 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ qf_v ∃ qx_v ∃ y ∃ qf2 ∃ qx2_v (t1 = x ∧ t2 = ⟨ kc_app , scons qf_v (scons qx_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_app , scons qf2 (scons qx2_v ∅) ⟩ ∧ ra_inst x qf_v y qf2 ∈ lrel ∧ ra_inst x qx_v y qx2_v ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ qj_v ∃ x ∃ qe_v ∃ y (t1 = x ∧ t2 = qe_v ∧ t3 = y ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v x ∈ lrel) ∨ ∃ x ∃ qb_v ∃ qi_v ∃ qe_v ∃ y ∃ qe2 (t1 = x ∧ t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_inst x qe_v y qe2 ∈ lrel)) → Cf $ by or_elim_imp [l33, l180]
l182: $ G , H ⇒ (∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) ∨ ∃ x ∃ y ∃ z (t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel) ∨ ∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons ⟨ kc_s , scons qi_v ∅ ⟩ ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le x qi_v ∈ lrel) ∨ ∃ x ∃ ql_v ∃ y (t1 = x ∧ t2 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ qf_v ∃ qx_v ∃ y ∃ qf2 ∃ qx2_v (t1 = x ∧ t2 = ⟨ kc_app , scons qf_v (scons qx_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_app , scons qf2 (scons qx2_v ∅) ⟩ ∧ ra_inst x qf_v y qf2 ∈ lrel ∧ ra_inst x qx_v y qx2_v ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ qj_v ∃ x ∃ qe_v ∃ y (t1 = x ∧ t2 = qe_v ∧ t3 = y ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v x ∈ lrel) ∨ ∃ x ∃ qb_v ∃ qi_v ∃ qe_v ∃ y ∃ qe2 (t1 = x ∧ t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_inst x qe_v y qe2 ∈ lrel)) → Cf $ by or_elim_imp [l16, l181]
l183: $ G , H ⇒ Cf $ by imp_elim [l182, l2]

