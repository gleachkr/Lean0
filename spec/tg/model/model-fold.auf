--| @freshen H qA
--| @freshen H qB
--| @freshen H qIH
--| @freshen H qni
--| @freshen H qk_v
--| @freshen H qa_v
--| @freshen H qmn
--| @freshen H qb_v
--| @freshen H qf_v
--| @freshen H qY
--| @freshen H qX1
--| @freshen H qX2
--| @freshen H qX3
--| @freshen H qU
lemma f21_inv_ihval {qA qB qIH qni qk_v qa_v qmn qb_v qf_v qY qX1 qX2 qX3 qU: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set): $ G ⇒ ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ∈ lrel $ > $ H , t10 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons qA (scons qIH ∅) ⟩ ∧ ra_ihval t1 t2 t3 t4 t5 t6 t7 ⟨ kc_s , scons t8 ∅ ⟩ t9 qB qIH ∈ lrel ⇒ Cf $ > $ H , t11 = ⟨ kc_app , scons qX3 (scons qU ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons t1 (scons t9 ∅) ⟩ t10 qk_v ∈ lrel ∧ ra_nidx t1 t9 qni ∈ lrel ∧ ra_add t2 qni qk_v ∈ lrel ∧ ra_rehead qY qX2 qni t10 qX3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons t1 (scons t9 ∅) ⟩ qY t2 ∈ lrel ∧ ra_add t8 t6 qa_v ∈ lrel ∧ ra_add t4 t3 qmn ∈ lrel ∧ ra_add qa_v qmn qb_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons t1 (scons t9 (scons t5 ∅)) ⟩ qb_v t2 qX1 ∈ lrel ∧ ra_pargs qX1 qa_v qmn qX2 ∈ lrel ∧ ra_add t8 t7 qf_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qf_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t8 qU ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ qA ∃ qB ∃ qIH (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons qA (scons qIH ∅) ⟩ ∧ ra_ihval x y z u v w a ⟨ kc_s , scons b ∅ ⟩ c qB qIH ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ qni ∃ qk_v ∃ qa_v ∃ qmn ∃ qb_v ∃ qf_v ∃ qY ∃ qX1 ∃ qX2 ∃ qX3 ∃ qU ∃ qA (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = qA ∧ t11 = ⟨ kc_app , scons qX3 (scons qU ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons x (scons c ∅) ⟩ qA qk_v ∈ lrel ∧ ra_nidx x c qni ∈ lrel ∧ ra_add y qni qk_v ∈ lrel ∧ ra_rehead qY qX2 qni qA qX3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons x (scons c ∅) ⟩ qY y ∈ lrel ∧ ra_add b w qa_v ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_add qa_v qmn qb_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons x (scons c (scons v ∅)) ⟩ qb_v y qX1 ∈ lrel ∧ ra_pargs qX1 qa_v qmn qX2 ∈ lrel ∧ ra_add b a qf_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qf_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b qU ∈ lrel) $ by lrel_ihval_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons qA (scons qIH ∅) ⟩ ∧ ra_ihval x y z u v w a ⟨ kc_s , scons b ∅ ⟩ c qB qIH ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons qA (scons qIH ∅) ⟩ ∧ ra_ihval x y z u v w a ⟨ kc_s , scons b ∅ ⟩ c qB qIH ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons qA (scons qIH ∅) ⟩ ∧ ra_ihval x y z u v w a ⟨ kc_s , scons b ∅ ⟩ c qB qIH ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons qA (scons qIH ∅) ⟩ ∧ ra_ihval x y z u v w a ⟨ kc_s , scons b ∅ ⟩ c qB qIH ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
