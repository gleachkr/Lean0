ifold_motive
------------
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ b ∃ x3 ∃ x4 (nvf' x1 = sj ∧ ra_nidx td x1 x2 ∈ lrel ∧ b ∊ fseq {y | y = y} ∧ cdm b = nvf' x2 ∧ sa = b ++ p ∧ ⟨ sj , ⟨ sa , scons x3 x4 ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ sx = itup td sj x3 x4 w) $ by ifold_pt_shape [#1, #2, #4, #5, #8]
l2: $ G ⇒ ∃ b (ra_ind_data td b tp tt ∈ lrel) $ by ex_intro [#2]
l3: $ G ⇒ iprt td tp tt $ by weaken [l2]
l4: $ G , nvf' x1 = sj ∧ ra_nidx td x1 x2 ∈ lrel ∧ b ∊ fseq {y | y = y} ∧ cdm b = nvf' x2 ∧ sa = b ++ p ∧ ⟨ sj , ⟨ sa , scons x3 x4 ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ sx = itup td sj x3 x4 w ⇒ nvf' x1 = sj ∧ ra_nidx td x1 x2 ∈ lrel ∧ b ∊ fseq {y | y = y} ∧ cdm b = nvf' x2 ∧ sa = b ++ p ∧ ⟨ sj , ⟨ sa , scons x3 x4 ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ sx = itup td sj x3 x4 w $ by ax
