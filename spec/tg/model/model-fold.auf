lemma f44_s0 (G: hyps) (H J: class) (u w r0 tg td tb tp tt tnp tn tm tv tM tN tQa tQb pp cv mv: set): $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ hctor ⊆ H $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ > $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ > $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ra_capp tM tp tQa ∈ lrel $ > $ G ⇒ ra_capp tN tQa tQb ∈ lrel $ > $ G ⇒ pp ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w pp (lv tv w) $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w pp cv $ > $ G ⇒ mv ++ cv ++ pp ∈ esat u (dnf u (mcv H)) tQb w $
----
l1: $ G ⇒ iwf u H J tg td w r0 $ by weaken [#1]
l2: $ G ⇒ w ∊ lvals $ by wcel_welc [iwf_lvals [l1]]
l3: $ G ⇒ esat u (dnf u (mcv H)) tp w ⊆ fseq u $ by esat_fseq
l4: $ G ⇒ pp ∊ esat u (dnf u (mcv H)) tp w $ by weaken [#12]
l5: $ G ⇒ pp ∊ fseq u $ by subset_elim [l3, l4]
