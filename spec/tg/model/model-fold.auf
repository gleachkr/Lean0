l153: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d ⇒ ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d $ by ax
l154: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d ⇒ tA ∊ trees ω $ by weaken [#9]
l155: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d ⇒ tB ∊ trees ω $ by weaken [#10]
l156: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d ⇒ w ∊ lvals $ by weaken [#2]
l157: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d ⇒ rk ∊ fseq u $ by weaken [#4]
l158: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d ⇒ ∃ e ∃ f ∃ g ∃ t (e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t) $ by etel_pi_all [l154, l155, l156, l157, and_elim_l [l153]]
l159: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d , e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t ⇒ e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t $ by ax
l160: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d , e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t ⇒ a ∊ dt u M tA3 w rm $ by weaken [l66]
l161: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d , e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t ⇒ dt u M tA3 w rm ⊆ u $ by weaken [l2]
l162: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d , e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t ⇒ a ∊ u $ by subset_elim [l161, l160]
l163: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d , e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t ⇒ dt u M tA3 w rm = dt u M tA w rk $ by weaken [#12]
l164: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d , e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t ⇒ a ∊ dt u M tA w rk $ by welc_eq [l163, l160]
l165: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d , e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t , p = scons e rk ⇒ tB = tB $ by eq_refl
l166: $ G , a ∊ dt u M tA3 w rm , l ∊ {x | x ∊ fseq u ∧ ssnoc x a ∈ mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N} , j = ssnoc l a , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) ∧ h ∊ ihv D K L (gd ++ m) (hd ++ n) N ∧ j = h ++ d , e ∊ da ((dnf u M)' tA) w rk ∧ e ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons e rk) ∧ d = ssnoc f e ∧ m = scons e g ∧ n = scons (etel u (dnf u M) tA w rk) t , p = scons e rk ⇒ w = w $ by eq_refl
