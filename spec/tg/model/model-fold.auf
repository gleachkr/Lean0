l268: $ G , e ∊ {l | l ∊ fseq u ∧ cdm l = L2 ∧ ∀ i (i ∊ N → J ⊆ i → vat (l ++ c0) N i ∈ imot u (dnf u M) td i w p V)} , q ∊ fseq u ∧ h ∊ u ∧ e = ssnoc q h , g = scons h ∅ , k = ∅ , c = scons h c0 ⇒ e ∊ esat u (dsh u M r) tm w $ by isset_elim [l267, l265]
