ofsort_ctx_nil
--------------
l1: $ G ⇒ sig lsig lopen $ by lsig_sig
l2: $ G ⇒ ⟨ kc_nil , ⟨ ks_ctx , ∅ ⟩ ⟩ ∈ lsig $ by f14_sig_nil
l3: $ G ⇒ ⟨ kc_nil , ∅ ⟩ ∈ ofsort lsig lopen ks_ctx $ by ofsort_node0 [l1, l2]

ofsort_ctx_cons
---------------
l1: $ G ⇒ sig lsig lopen $ by lsig_sig
l2: $ G ⇒ ⟨ kc_cons , ⟨ ks_ctx , scons ks_expr (scons ks_ctx ∅) ⟩ ⟩ ∈ lsig $ by f14_sig_cons
l3: $ G ⇒ ⟨ kc_cons , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_ctx $ by ofsort_node2 [l1, l2, #1, #2]

def f14_ps_q  (.y .b .t: set): class = $ {y | ∀ b ∀ t (ra_pis y b t ∈ lrel → t ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_expr)} $

lemma f14_ps_e (G: hyps)  (ty vb vt: set): $ G ⇒ ty ∊ f14_ps_q  $ > $ G ⇒ ra_pis ty vb vt ∈ lrel $ > $ G ⇒ vt ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ∀ b ∀ t (ra_pis ty b t ∈ lrel → t ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_expr) $ by cab_elim [#1]
l2: $ G ⇒ ∀ t (ra_pis ty vb t ∈ lrel → t ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr) $ by all_elim [l1]
l3: $ G ⇒ ra_pis ty vb vt ∈ lrel → vt ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by all_elim [l2]
l4: $ G ⇒ vt ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by imp_elim [l3, #2]
l5: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by imp_elim [l4, #3]

lemma f14_ps_n (G: hyps)  (ty k1 j1 vb vt: set): $ G ⇒ crn j1 ⊆ f14_ps_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pis ty vb vt ∈ lrel $ > $ G ⇒ vt ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) ∨ ∃ a ∃ x ∃ z ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) $ by lrel_pis_cases [#5]
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x $ by ax
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ⟨ kc_nil , ∅ ⟩ ∈ ofsort lsig lopen ks_ctx $ by ofsort_ctx_nil
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [and_elim_l [l2]], l3]]
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ vt ∊ ofsort lsig lopen ks_expr $ by weaken [#6]
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ vb ∊ ofsort lsig lopen ks_expr $ by wcel_welc [wcel_eq_l [eq_trans [and_elim_r [and_elim_r [l2]], eq_sym [and_elim_l [and_elim_r [l2]]]], welc_wcel [l5]]]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by and_intro [l4, l6]
l8: $ G , ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) ⇒ ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) $ by ax
l9: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by ex_elim [l8, l7]
l10: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel $ by ax
l11: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l12: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel ⇒ isset ∅ $ by ax_empty
l13: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel ⇒ crn (scons a (scons p ∅)) ⊆ f14_ps_q  $ by node_crn_sub [weaken [#1], weaken [#2], and_elim_l [l10], wcel_isset [l11], scons_set [scons_set [l12]]]
l14: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel ⇒ isset p $ by isset_var
l15: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel ⇒ p ∈ f14_ps_q  $ by crn_scons_head [l14, crn_scons_tail [l13]]
l16: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel $ by ax
l17: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ n = ⟨ kc_pi , scons a (scons x ∅) ⟩ $ by ax
l18: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ p = p $ by eq_refl
l19: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ ra_pis p n vt ∈ lrel $ by wcel_eq_l [ra_pis_eq [l18, eq_sym [l17], eq_sym [and_elim_l [and_elim_r [and_elim_r [l16]]]]], and_elim_r [and_elim_r [and_elim_r [l16]]]]
l20: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ p ∈ f14_ps_q  $ by weaken [l15]
l21: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ vt ∊ ofsort lsig lopen ks_expr $ by weaken [#6]
l22: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ p ∊ ofsort lsig lopen ks_ctx ∧ n ∊ ofsort lsig lopen ks_expr $ by f14_ps_e [wcel_welc [l20], l19, l21]
l23: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ a ∊ ofsort lsig lopen ks_expr ∧ x ∊ ofsort lsig lopen ks_expr $ by ofsort_pi_kids [wcel_eq_l [l17, welc_wcel [and_elim_r [l22]]]]
l24: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [and_elim_l [l16]], ofsort_ctx_cons [welc_wcel [and_elim_l [l23]], welc_wcel [and_elim_l [l22]]]]]
l25: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ vb ∊ ofsort lsig lopen ks_expr $ by wcel_welc [wcel_eq_l [eq_sym [and_elim_l [and_elim_r [l16]]], welc_wcel [and_elim_r [l23]]]]
l26: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel , n = ⟨ kc_pi , scons a (scons x ∅) ⟩ ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by and_intro [l24, l25]
l27: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel ⇒ isset ⟨ kc_pi , scons a (scons x ∅) ⟩ $ by opair_isset
l28: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by isset_elim [l27, l26]
l29: $ G , ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) ⇒ ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) $ by ax
l30: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by ex_elim [l29, l28]
l31: $ G , ∃ z ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) ⇒ ∃ z ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) $ by ax
l32: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by ex_elim [l31, l30]
l33: $ G , ∃ x ∃ z ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) ⇒ ∃ x ∃ z ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) $ by ax
l34: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by ex_elim [l33, l32]
l35: $ G , ∃ a ∃ x ∃ z ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) ⇒ ∃ a ∃ x ∃ z ∃ p (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = z ∧ ra_pis p ⟨ kc_pi , scons a (scons x ∅) ⟩ z ∈ lrel) $ by ax
l36: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by ex_elim [l35, l34]
l37: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_expr $ by or_elim [l1, l9, l36]

lemma f14_ps_all (G: hyps) : $ G ⇒ trees ω ⊆ f14_ps_q  $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ , ra_pis y b t ∈ lrel , t ∊ ofsort lsig lopen ks_expr ⇒ crn j ⊆ f14_ps_q  $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ , ra_pis y b t ∈ lrel , t ∊ ofsort lsig lopen ks_expr ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ , ra_pis y b t ∈ lrel , t ∊ ofsort lsig lopen ks_expr ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ , ra_pis y b t ∈ lrel , t ∊ ofsort lsig lopen ks_expr ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ , ra_pis y b t ∈ lrel , t ∊ ofsort lsig lopen ks_expr ⇒ ra_pis y b t ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ , ra_pis y b t ∈ lrel , t ∊ ofsort lsig lopen ks_expr ⇒ t ∊ ofsort lsig lopen ks_expr $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ , ra_pis y b t ∈ lrel , t ∊ ofsort lsig lopen ks_expr ⇒ y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_expr $ by f14_ps_n [l1, l2, l3, l4, l5, l6]
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ , ra_pis y b t ∈ lrel ⇒ t ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_expr $ by imp_intro [l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ ⇒ ra_pis y b t ∈ lrel → t ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_expr $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ ⇒ ∀ t (ra_pis y b t ∈ lrel → t ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_expr) $ by all_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ ⇒ ∀ b ∀ t (ra_pis y b t ∈ lrel → t ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_expr) $ by all_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ ⇒ y ∊ f14_ps_q  $ by cab_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f14_ps_q  $ by wcel_intro [l13, l12]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ps_q  ⇒ ⟨ i , j ⟩ ∈ f14_ps_q  $ by isset_elim [l15, l14]
l17: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f14_ps_q  → ⟨ i , j ⟩ ∈ f14_ps_q  $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f14_ps_q  → ⟨ i , j ⟩ ∈ f14_ps_q ) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ f14_ps_q  $ by trees_ind_c [l19, l18]

pis_sort
--------
l1: $ G ⇒ kr_pis ∈ ω $ by kr_pis_omega
l2: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, wcel_isset [l1]]
l3: $ G ⇒ trees ω ⊆ f14_ps_q  $ by f14_ps_all
l4: $ G ⇒ t1 ∊ f14_ps_q  $ by subset_elim [l3, and_elim_l [l2]]
l5: $ G ⇒ t1 ∊ ofsort lsig lopen ks_ctx ∧ t2 ∊ ofsort lsig lopen ks_expr $ by f14_ps_e [l4, #1, #2]

def f14_cs_q  (.y .b .t: set): class = $ {y | ∀ b ∀ t (ra_capp y b t ∈ lrel → t ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_ctx)} $

lemma f14_cs_e (G: hyps)  (ty vb vt: set): $ G ⇒ ty ∊ f14_cs_q  $ > $ G ⇒ ra_capp ty vb vt ∈ lrel $ > $ G ⇒ vt ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G ⇒ ∀ b ∀ t (ra_capp ty b t ∈ lrel → t ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_ctx) $ by cab_elim [#1]
l2: $ G ⇒ ∀ t (ra_capp ty vb t ∈ lrel → t ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx) $ by all_elim [l1]
l3: $ G ⇒ ra_capp ty vb vt ∈ lrel → vt ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by all_elim [l2]
l4: $ G ⇒ vt ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l3, #2]
l5: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l4, #3]

lemma f14_cs_n (G: hyps)  (ty k1 j1 vb vt: set): $ G ⇒ crn j1 ⊆ f14_cs_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_capp ty vb vt ∈ lrel $ > $ G ⇒ vt ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G ⇒ ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) ∨ ∃ a ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by lrel_capp_cases [#5]
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x $ by ax
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ⟨ kc_nil , ∅ ⟩ ∈ ofsort lsig lopen ks_ctx $ by ofsort_ctx_nil
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [and_elim_l [l2]], l3]]
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by weaken [#6]
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ vb ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_trans [and_elim_r [and_elim_r [l2]], eq_sym [and_elim_l [and_elim_r [l2]]]], welc_wcel [l5]]]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by and_intro [l4, l6]
l8: $ G , ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) ⇒ ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) $ by ax
l9: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l8, l7]
l10: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel $ by ax
l11: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l12: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ isset ∅ $ by ax_empty
l13: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ crn (scons a (scons p ∅)) ⊆ f14_cs_q  $ by node_crn_sub [weaken [#1], weaken [#2], and_elim_l [l10], wcel_isset [l11], scons_set [scons_set [l12]]]
l14: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ isset p $ by isset_var
l15: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ p ∈ f14_cs_q  $ by crn_scons_head [l14, crn_scons_tail [l13]]
l16: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by weaken [#6]
l17: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ a ∊ ofsort lsig lopen ks_expr ∧ z ∊ ofsort lsig lopen ks_ctx $ by ofsort_cons_kids [wcel_eq_l [and_elim_l [and_elim_r [and_elim_r [l10]]], welc_wcel [l16]]]
l18: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ p = p $ by eq_refl
l19: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ z = z $ by eq_refl
l20: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ ra_capp p vb z ∈ lrel $ by wcel_eq_l [ra_capp_eq [l18, eq_sym [and_elim_l [and_elim_r [l10]]], l19], and_elim_r [and_elim_r [and_elim_r [l10]]]]
l21: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ p ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by f14_cs_e [wcel_welc [l15], l20, and_elim_r [l17]]
l22: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [and_elim_l [l10]], ofsort_ctx_cons [welc_wcel [and_elim_l [l17]], welc_wcel [and_elim_l [l21]]]]]
l23: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by and_intro [l22, and_elim_r [l21]]
l24: $ G , ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) ⇒ ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by ax
l25: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l24, l23]
l26: $ G , ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) ⇒ ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by ax
l27: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l26, l25]
l28: $ G , ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) ⇒ ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by ax
l29: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l28, l27]
l30: $ G , ∃ a ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) ⇒ ∃ a ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by ax
l31: $ … ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l30, l29]
l32: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vb ∊ ofsort lsig lopen ks_ctx $ by or_elim [l1, l9, l31]

lemma f14_cs_all (G: hyps) : $ G ⇒ trees ω ⊆ f14_cs_q  $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , t ∊ ofsort lsig lopen ks_ctx ⇒ crn j ⊆ f14_cs_q  $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , t ∊ ofsort lsig lopen ks_ctx ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , t ∊ ofsort lsig lopen ks_ctx ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , t ∊ ofsort lsig lopen ks_ctx ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , t ∊ ofsort lsig lopen ks_ctx ⇒ ra_capp y b t ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , t ∊ ofsort lsig lopen ks_ctx ⇒ t ∊ ofsort lsig lopen ks_ctx $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , t ∊ ofsort lsig lopen ks_ctx ⇒ y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_ctx $ by f14_cs_n [l1, l2, l3, l4, l5, l6]
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel ⇒ t ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ ⇒ ra_capp y b t ∈ lrel → t ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ ⇒ ∀ t (ra_capp y b t ∈ lrel → t ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ ⇒ ∀ b ∀ t (ra_capp y b t ∈ lrel → t ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ b ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ ⇒ y ∊ f14_cs_q  $ by cab_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f14_cs_q  $ by wcel_intro [l13, l12]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_cs_q  ⇒ ⟨ i , j ⟩ ∈ f14_cs_q  $ by isset_elim [l15, l14]
l17: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f14_cs_q  → ⟨ i , j ⟩ ∈ f14_cs_q  $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f14_cs_q  → ⟨ i , j ⟩ ∈ f14_cs_q ) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ f14_cs_q  $ by trees_ind_c [l19, l18]

capp_sort
---------
l1: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l2: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, wcel_isset [l1]]
l3: $ G ⇒ trees ω ⊆ f14_cs_q  $ by f14_cs_all
l4: $ G ⇒ t1 ∊ f14_cs_q  $ by subset_elim [l3, and_elim_l [l2]]
l5: $ G ⇒ t1 ∊ ofsort lsig lopen ks_ctx ∧ t2 ∊ ofsort lsig lopen ks_ctx $ by f14_cs_e [l4, #1, #2]

def f14_ec_q (M: class) (u w s: set) (.y .b .t .x .g .q: set): class = $ {y | ∀ b ∀ t (w ∊ lvals → s ∊ fseq u → ra_capp y b t ∈ lrel → esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) b w ∧ q ∊ esat u (dsh u M (g ++ s)) y w ∧ x = q ++ g)})} $

--| @freshen G x
--| @freshen G g
--| @freshen G q
lemma f14_ec_e {x g q: set} (G: hyps) (M: class) (u w s: set) (ty vb vt: set): $ G ⇒ ty ∊ f14_ec_q M u w s $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ ra_capp ty vb vt ∈ lrel $ > $ G ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $
----
l1: $ G ⇒ ∀ b ∀ t (w ∊ lvals → s ∊ fseq u → ra_capp ty b t ∈ lrel → esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) b w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)}) $ by cab_elim [#1]
l2: $ G ⇒ ∀ t (w ∊ lvals → s ∊ fseq u → ra_capp ty vb t ∈ lrel → esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)}) $ by all_elim [l1]
l3: $ G ⇒ w ∊ lvals → s ∊ fseq u → ra_capp ty vb vt ∈ lrel → esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by all_elim [l2]
l4: $ G ⇒ s ∊ fseq u → ra_capp ty vb vt ∈ lrel → esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by imp_elim [l3, #2]
l5: $ G ⇒ ra_capp ty vb vt ∈ lrel → esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by imp_elim [l4, #3]
l6: $ G ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by imp_elim [l5, #4]

--| @freshen G x
--| @freshen G g
--| @freshen G q
lemma f14_ec_n {x g q: set} (G: hyps) (M: class) (u w s: set) (ty k1 j1 vb vt: set): $ G ⇒ crn j1 ⊆ f14_ec_q M u w s $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ ra_capp ty vb vt ∈ lrel $ > $ G ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $
----
l1: $ G ⇒ ∃ k (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k) ∨ ∃ a ∃ p ∃ k ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) $ by lrel_capp_cases [#7]
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k $ by ax
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k ⇒ vt = vb $ by eq_trans [and_elim_r [and_elim_r [l2]], eq_sym [and_elim_l [and_elim_r [l2]]]]
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w ⇒ vt = vb $ by weaken [l3]
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w ⇒ w = w $ by eq_refl
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w ⇒ l ∊ esat u (dsh u M s) vt w $ by ax
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w ⇒ l ∊ esat u (dsh u M s) vb w $ by welc_eq [esat_eq [l4, l5], l6]
l8: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w ⇒ esat u (dsh u M s) vb w ⊆ fseq u $ by esat_fseq
l9: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w ⇒ l ∊ fseq u $ by subset_elim [l8, l7]
l10: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ o = ∅ $ by ax
l11: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k $ by ax
l12: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ w = w $ by eq_refl
l13: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ w ∊ lvals $ by weaken [#5]
l14: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ esat u (dsh u M (l ++ s)) ty w = csn ∅ $ by eq_trans [esat_eq [and_elim_l [l11], l12], esat_nil [l13]]
l15: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ o ∊ esat u (dsh u M (l ++ s)) ty w $ by welc_eq [eq_sym [l14], csn_intro [l10]]
l16: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ l = l $ by eq_refl
l17: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ l ∊ fseq u $ by weaken [l9]
l18: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ l = o ++ l $ by eq_sym [eq_trans [scat_eq [l10, l16], scat_empty_l [l17]]]
l19: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ l ∊ esat u (dsh u M s) vb w $ by weaken [l7]
l20: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ l ∊ esat u (dsh u M s) vb w ∧ o ∊ esat u (dsh u M (l ++ s)) ty w ∧ l = o ++ l $ by and_intro [l19, and_intro [l15, l18]]
l21: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ ∃ q (l ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (l ++ s)) ty w ∧ l = q ++ l) $ by ex_intro [l20]
l22: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g) $ by ex_intro [l21]
l23: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w , o = ∅ ⇒ l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by cab_intro [l22]
l24: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w ⇒ isset ∅ $ by ax_empty
l25: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ esat u (dsh u M s) vt w ⇒ l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by isset_elim [l24, l23]
l26: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} ⇒ l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by ax
