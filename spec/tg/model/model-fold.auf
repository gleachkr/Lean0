l3: $ G , x ∊ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ s = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} , ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ s = h ++ f ∧ x ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)) ⇒ ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ s = h ++ f ∧ x ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)) $ by ax
