lemma f21_mw_n {z y f g c o x: set} (G: hyps) (M CT Km NI J: class) (u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl: set) (ty k1 j1 vd vr vh vm vk vl vt vp vq vx5 vn ve: set): $ G ⇒ crn j1 ⊆ f21_mw_q M CT Km NI J u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ pp ∊ fseq u $ > $ G ⇒ cdm pp = nvf' tnp $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ mk ∊ fseq u $ > $ G ⇒ cdm mk = nvf' tk $ > $ G ⇒ cv ∊ fseq u $ > $ G ⇒ cdm cv = nvf' tn $ > $ G ⇒ c0 = mk ++ cv $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ $ > $ G ⇒ nc ∊ trees ω $ > $ G ⇒ ∀ x (x ∊ fseq u → dt u M nc w x = CT) $ > $ G ⇒ ∀ x (isset (apn (CT) x)) $ > $ G ⇒ Km ∈ ω $ > $ G ⇒ nadd (suc Km) (nvf' ti) = nvf' tn $ > $ G ⇒ ∀ c (ra_nidx td ti c ∈ lrel → nvf' c = NI) $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) $ > $ G ⇒ intys td = nvf' tn $ > $ G ⇒ iprt td tp tt $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ∀ x (isset (ap (imrel td cv) x)) $ > $ G ⇒ ra_mwalk td tnp tn tk ti tc tnf vd vr vh ty vm ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ trees ω $ > $ G ⇒ ra_closed vx5 ty ∈ lrel $ > $ G ⇒ nvf' vx5 = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vd) = nvf' tnf $ > $ G ⇒ ra_cwf td tn tnp tl ti ve vd ty ∈ lrel3 J $ > $ G ⇒ ∀ f ∀ g ∀ c (ra_nth_pi ty f g ∈ lrel → ra_add vd f c ∈ lrel → ra_nth_pi tK0 c g ∈ lrel) $ > $ G ⇒ ra_clen vh vr ∈ lrel $ > $ G ⇒ vk ∊ fseq u $ > $ G ⇒ cdm vk = nvf' vd $ > $ G ⇒ vl ∊ fseq u $ > $ G ⇒ cdm vl = nvf' vd $ > $ G ⇒ vt ∊ fseq {y | y = y} $ > $ G ⇒ cdm vt = nvf' vd $ > $ G ⇒ vp = vk ++ c0 ++ pp ++ rr $ > $ G ⇒ vq = vk ++ pp ++ xs $ > $ G ⇒ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vq → vh ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (f ++ vp)) vh w = ihv td tK0 (imrel td cv) (vl ++ g) (vt ++ c) (nvf' vd)) $ > $ G ⇒ dt u M vm w vp = fpi z (mqp (etel u (dnf u M) ty w vq) td tK0 (imrel td cv) vl vt (nvf' tnf)) (ap (mtb u (etel u (dnf u M) ty w vq) td tK0 (imrel td cv) vl vt (nvf' tnf) (cv' Km) (CT) vk pp (NI)) z) ∧ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vq → ihv td tK0 (imrel td cv) (vl ++ g) (vt ++ c) (nvf' tnf) ⊆ fseq u) $
----
l1: $ G , ty = ⟨ kc_pi , scons b (scons j ∅) ⟩ ∧ vm = ⟨ kc_pi , scons i (scons k ∅) ⟩ ∧ ra_add vd tnp v ∈ lrel ∧ ra_closed v b ∈ lrel ∧ ra_add tk tn a ∈ lrel ∧ ra_lift a vd b i ∈ lrel ∧ ra_mwalk td tnp tn tk ti tc tnf ⟨ kc_s , scons vd ∅ ⟩ vr vh j k ∈ lrel ⇒ ty = ⟨ kc_pi , scons b (scons j ∅) ⟩ ∧ vm = ⟨ kc_pi , scons i (scons k ∅) ⟩ ∧ ra_add vd tnp v ∈ lrel ∧ ra_closed v b ∈ lrel ∧ ra_add tk tn a ∈ lrel ∧ ra_lift a vd b i ∈ lrel ∧ ra_mwalk td tnp tn tk ti tc tnf ⟨ kc_s , scons vd ∅ ⟩ vr vh j k ∈ lrel $ by ax
l2: $ G , ty = ⟨ kc_pi , scons b (scons j ∅) ⟩ ∧ vm = ⟨ kc_pi , scons i (scons k ∅) ⟩ ∧ ra_add vd tnp v ∈ lrel ∧ ra_closed v b ∈ lrel ∧ ra_add tk tn a ∈ lrel ∧ ra_lift a vd b i ∈ lrel ∧ ra_mwalk td tnp tn tk ti tc tnf ⟨ kc_s , scons vd ∅ ⟩ vr vh j k ∈ lrel ⇒ isset ∅ $ by ax_empty
