l67: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ w = w $ by eq_refl
l68: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ b ∊ imq u E td J w s1 $ by welc_eq [imq_eq [l65, l66, l67, eq_sym [l41]], and_elim_l [and_elim_r [and_elim_r [and_elim_r [l27]]]]]
l69: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ Q = imq u E td J w s1 $ by weaken [#10]
l70: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ b ∊ Q $ by welc_eq [eq_sym [l69], l68]
l71: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ b ∊ Q ∧ d = nest b e $ by and_intro [l70, l64]
l72: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ ∃ z (b ∊ Q ∧ d = nest b z) $ by ex_intro [l71]
l73: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_intro [l72]
l74: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l75: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l74, l73]
l76: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l77: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l76, l75]
l78: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l79: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l78, l77]
l80: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l81: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l80, l79]
l82: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l26, l81]
