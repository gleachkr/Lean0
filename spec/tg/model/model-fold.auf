def f39s_q (td tnp tn tm tv tnf: set) (.y .d .a .v: set): class = $ {y | ∀ d ∀ a ∀ v (ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr)} $

lemma f39s_e (G: hyps) (td tnp tn tm tv tnf: set) (ty vd va vv: set): $ G ⇒ ty ∊ f39s_q td tnp tn tm tv tnf $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ > $ G ⇒ vv ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ va ∊ ofsort lsig lopen ks_expr $
----
l1: $ G ⇒ ∀ d ∀ a ∀ v (ra_rwalk td tnp tn tm tv tnf d a ty v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr) $ by cab_elim [#1]
l2: $ G ⇒ ∀ a ∀ v (ra_rwalk td tnp tn tm tv tnf vd a ty v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr) $ by all_elim [l1]
l3: $ G ⇒ ∀ v (ra_rwalk td tnp tn tm tv tnf vd va ty v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → va ∊ ofsort lsig lopen ks_expr) $ by all_elim [l2]
l4: $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel → vv ∊ ofsort lsig lopen ks_expr → va ∊ ofsort lsig lopen ks_expr $ by all_elim [l3]
l5: $ G ⇒ vv ∊ ofsort lsig lopen ks_expr → va ∊ ofsort lsig lopen ks_expr $ by imp_elim [l4, #2]
