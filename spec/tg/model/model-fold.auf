fld_nr
------
l1: $ G ⇒ nvf' tdp = nadd (cdm fd) (cdm pp) $ by eq_trans [lrel_add_sem [#10], nadd_eq [eq_sym [#3], eq_sym [#5]]]
l2: $ G , v = pp ++ rr ⇒ v = pp ++ rr $ by ax
l3: $ G , v = pp ++ rr ⇒ pp ∊ fseq u $ by weaken [#4]
l4: $ G , v = pp ++ rr ⇒ rr ∊ fseq u $ by weaken [#9]
l5: $ G , v = pp ++ rr ⇒ v ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l2], scat_fseq [l3, l4]]]
l6: $ G , v = pp ++ rr ⇒ ra_lift tkn d tA tA3 ∈ lrel $ by weaken [#12]
l7: $ G , v = pp ++ rr ⇒ w ∊ lvals $ by weaken [#1]
l8: $ G , v = pp ++ rr ⇒ fd ∊ fseq u $ by weaken [#2]
l9: $ G , v = pp ++ rr ⇒ cdm fd = nvf' d $ by weaken [#3]
l10: $ G , v = pp ++ rr ⇒ c0 ∊ fseq u $ by weaken [#7]
l11: $ G , v = pp ++ rr ⇒ cdm c0 = nvf' tkn $ by weaken [#8]
l12: $ G , v = pp ++ rr ⇒ dt u M tA3 w (fd ++ c0 ++ v) = dt u M tA w (fd ++ v) $ by lrel_lift_sem [l6, l7, l8, l9, l10, l11, l5]
l13: $ G , v = pp ++ rr ⇒ fd = fd $ by eq_refl
l14: $ G , v = pp ++ rr ⇒ c0 = c0 $ by eq_refl
l15: $ G , v = pp ++ rr ⇒ fd ++ c0 ++ pp ++ rr = fd ++ c0 ++ v $ by scat_eq [l13, scat_eq [l14, eq_sym [l2]]]
l16: $ G , v = pp ++ rr ⇒ ra_closed tdp tA ∈ lrel $ by weaken [#11]
l17: $ G , v = pp ++ rr ⇒ nvf' tdp = nadd (cdm fd) (cdm pp) $ by weaken [l1]
l18: $ G , v = pp ++ rr ⇒ w ∊ lvals $ by weaken [#1]
l19: $ G , v = pp ++ rr ⇒ fd ∊ fseq u $ by weaken [#2]
l20: $ G , v = pp ++ rr ⇒ pp ∊ fseq u $ by weaken [#4]
l21: $ G , v = pp ++ rr ⇒ rr ∊ fseq u $ by weaken [#9]
l22: $ G , v = pp ++ rr ⇒ dt u M tA w (fd ++ pp ++ rr) = dt u M tA w (fd ++ pp) $ by closed_dt_scat [l16, l18, l19, l20, l21, l17]
l23: $ G , v = pp ++ rr ⇒ w ∊ lvals $ by weaken [#1]
l24: $ G , v = pp ++ rr ⇒ fd ∊ fseq u $ by weaken [#2]
l25: $ G , v = pp ++ rr ⇒ pp ∊ fseq u $ by weaken [#4]
l26: $ G , v = pp ++ rr ⇒ xs ∊ fseq u $ by weaken [#6]
l27: $ G , v = pp ++ rr ⇒ dt u M tA w (fd ++ pp ++ xs) = dt u M tA w (fd ++ pp) $ by closed_dt_scat [l16, l23, l24, l25, l26, l17]
l28: $ G , v = pp ++ rr ⇒ u = u $ by eq_refl
l29: $ G , v = pp ++ rr ⇒ M = M $ by eq_refl
l30: $ G , v = pp ++ rr ⇒ tA3 = tA3 $ by eq_refl
l31: $ G , v = pp ++ rr ⇒ w = w $ by eq_refl
l32: $ G , v = pp ++ rr ⇒ tA = tA $ by eq_refl
l33: $ G , v = pp ++ rr ⇒ dt u M tA3 w (fd ++ c0 ++ pp ++ rr) = dt u M tA w (fd ++ pp ++ xs) $ by eq_trans [dt_eq [l28, l29, l30, l31, l15], eq_trans [l12, eq_trans [dt_eq [l28, l29, l32, l31, scat_eq [l13, l2]], eq_trans [l22, eq_sym [l27]]]]]
l34: $ G ⇒ isset (pp ++ rr) $ by wcel_isset [scat_fseq [weaken [#4], weaken [#9]]]
l35: $ G ⇒ dt u M tA3 w (fd ++ c0 ++ pp ++ rr) = dt u M tA w (fd ++ pp ++ xs) $ by isset_elim [l34, l33]

