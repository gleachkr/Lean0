l10: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ nvf = nvf $ by eq_refl
l11: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ ty = ⟨ kc_nz , ∅ ⟩ $ by weaken [l2]
l12: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l13: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ nvf' ty = ∅ $ by eq_trans [fv_eq [l10, l11], l12]
l14: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ cdm ∅ = ∅ $ by cdm_empty
l15: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ cdm z = nvf' ty $ by eq_trans [cdm_eq [l7], eq_trans [l14, eq_sym [l13]]]
l16: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ , i ∊ ω , m ∊ ω , nadd i (suc m) = nvf' ty ⇒ m ∊ ω $ by ax
l17: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ , i ∊ ω , m ∊ ω , nadd i (suc m) = nvf' ty ⇒ nadd i (suc m) = suc (nadd i m) $ by nadd_suc [l16]
l18: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ , i ∊ ω , m ∊ ω , nadd i (suc m) = nvf' ty ⇒ nadd i (suc m) = nvf' ty $ by ax
l19: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ , i ∊ ω , m ∊ ω , nadd i (suc m) = nvf' ty ⇒ nvf' ty = ∅ $ by weaken [l13]
l20: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ , i ∊ ω , m ∊ ω , nadd i (suc m) = nvf' ty ⇒ ⊥ $ by suc_ne_empty [eq_trans [eq_sym [l17], eq_trans [l18, l19]]]
l21: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ , i ∊ ω , m ∊ ω , nadd i (suc m) = nvf' ty ⇒ z' m = (dt u M te w r)' (suc i) $ by bot_elim [l20]
l22: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ , i ∊ ω , m ∊ ω ⇒ nadd i (suc m) = nvf' ty → z' m = (dt u M te w r)' (suc i) $ by imp_intro [l21]
l23: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ , i ∊ ω ⇒ m ∊ ω → nadd i (suc m) = nvf' ty → z' m = (dt u M te w r)' (suc i) $ by imp_intro [l22]
l24: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → z' m = (dt u M te w r)' (suc i) $ by imp_intro [l23]
l25: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → z' m = (dt u M te w r)' (suc i)) $ by all_intro [l24]
l26: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → z' m = (dt u M te w r)' (suc i)) $ by all_intro [l25]
l27: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ u = u $ by eq_refl
l28: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ M = M $ by eq_refl
