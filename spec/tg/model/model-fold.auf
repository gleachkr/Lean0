l22: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ ra_capp ⟨ kc_nil , ∅ ⟩ tg tg ∈ lrel $ by lrel_capp_nil [l11]
