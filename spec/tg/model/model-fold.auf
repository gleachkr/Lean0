l13: $ G ⇒ ∃ h ∃ l (⟨ x ++ p , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by f31_pe_e [l12, #1, #2, #3, #4, #5]

def f31_ts_q (J M K S: class) (u w c r tA: set) (.y .t: set): class = $ {y | ∀ t (jval u M J → uadm u → w ∊ lvals → r ∊ sat u M c w → isset K → ¬ K = kc_app → dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA y t ∈ lrel3 J → y ∊ ofsort lsig lopen ks_expr → dt u M y w r ∈ dt u M t w r)} $

lemma f31_ts_e (G: hyps) (J M K S: class) (u w c r tA: set) (ty vt: set): $ G ⇒ ty ∊ f31_ts_q J M K S u w c r tA $ > $ G ⇒ jval u M J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ sat u M c w $ > $ G ⇒ isset K $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r $ > $ G ⇒ ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ dt u M ty w r ∈ dt u M vt w r $
----
l1: $ G ⇒ ∀ t (jval u M J → uadm u → w ∊ lvals → r ∊ sat u M c w → isset K → ¬ K = kc_app → dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA ty t ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M t w r) $ by cab_elim [#1]
l2: $ G ⇒ jval u M J → uadm u → w ∊ lvals → r ∊ sat u M c w → isset K → ¬ K = kc_app → dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by all_elim [l1]
l3: $ G ⇒ uadm u → w ∊ lvals → r ∊ sat u M c w → isset K → ¬ K = kc_app → dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l2, #2]
l4: $ G ⇒ w ∊ lvals → r ∊ sat u M c w → isset K → ¬ K = kc_app → dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l3, #3]
l5: $ G ⇒ r ∊ sat u M c w → isset K → ¬ K = kc_app → dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l4, #4]
l6: $ G ⇒ isset K → ¬ K = kc_app → dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l5, #5]
l7: $ G ⇒ ¬ K = kc_app → dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l6, #6]
l8: $ G ⇒ dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r → ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l7, #7]
l9: $ G ⇒ ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l8, #8]
l10: $ G ⇒ ty ∊ ofsort lsig lopen ks_expr → dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l9, #9]
l11: $ G ⇒ dt u M ty w r ∈ dt u M vt w r $ by imp_elim [l10, #10]

lemma f31_ts_n (G: hyps) (J M K S: class) (u w c r tA: set) (ty k1 j1 vt: set): $ G ⇒ crn j1 ⊆ f31_ts_q J M K S u w c r tA $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ jval u M J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ sat u M c w $ > $ G ⇒ isset K $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r $ > $ G ⇒ ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ dt u M ty w r ∈ dt u M vt w r $
