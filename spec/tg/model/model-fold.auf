l25: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) $ by ax
l26: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ x6 = nest s1 (nest s2 (d)) $ by ax
l27: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ nest s1 (nest s2 (d)) = nest a (nest c (nest m (nest b e))) $ by eq_trans [eq_sym [l26], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l25]]]]]]
