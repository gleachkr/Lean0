l13: $ G , ⟨ nvf' ti , ⟨ q4 , x ⟩ ⟩ ∈ zc ∧ apn (pg' nvf' th) q1 = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ x} ∧ ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ p ⇒ ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ q4 , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ L ↔ o = v)) $ by imp_elim [l12, and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l2]]]]]]
