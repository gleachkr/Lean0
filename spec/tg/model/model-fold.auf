lemma f39_c0 {z j b e m y: set} (G: hyps) (H J MV: class) (u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs: set) (ty vd va vv vk vr vl vf vg vc vt vh vx vn tA tB tA3 tVal tdp tmn: set): $ G ⇒ tB ∊ f39_q H J MV u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs $ > $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ > $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ > $ G ⇒ tK0 ∊ trees ω $ > $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) $ > $ G ⇒ ∀ j ∀ b ∀ e ∀ z (ra_nth_ty tt j b e ∈ lrel → nvf' j ∈ nvf' tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (nvf' j) (lv tv w) w) $ > $ G ⇒ ss ∊ fseq u $ > $ G ⇒ cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ c0 = mv ++ cv $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → nvf' b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = xs' j) $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ > $ G ⇒ vv ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ trees ω $ > $ G ⇒ ra_closed vx ty ∈ lrel $ > $ G ⇒ nvf' vx = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vd) = nvf' tnf $ > $ G ⇒ ∀ b ∀ e ∀ m (ra_nth_pi ty b e ∈ lrel → ra_add vd b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) $ > $ G ⇒ vk ∊ fseq u $ > $ G ⇒ cdm vk = nvf' vd $ > $ G ⇒ vt ∊ fseq u $ > $ G ⇒ cdm vt = nvf' vd $ > $ G ⇒ vh ∊ fseq {y | y = y} $ > $ G ⇒ cdm vh = nvf' vd $ > $ G ⇒ vr = vk ++ c0 ++ p ++ ss $ > $ G ⇒ vl = vk ++ p ++ xs $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vc , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vl $ > $ G ⇒ pg = vt ++ vg $ > $ G ⇒ pt = vh ++ vc $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) → dt u (mcv H) va w (vf ++ vr) = apn MV (z ++ vf ++ vk)) $ > $ G ⇒ ty = ⟨ kc_pi , scons tA (scons tB ∅) ⟩ $ > $ G ⇒ vv = ⟨ kc_lam , scons tA3 (scons tVal ∅) ⟩ $ > $ G ⇒ ra_add vd tnp tdp ∈ lrel $ > $ G ⇒ ra_closed tdp tA ∈ lrel $ > $ G ⇒ ra_add tm tn tmn ∈ lrel $ > $ G ⇒ ra_lift tmn vd tA tA3 ∈ lrel $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va tB tVal ∈ lrel $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $
