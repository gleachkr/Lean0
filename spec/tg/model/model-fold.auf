l60: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset d $ by isset_var
l61: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset (nest b e) $ by nest_set
