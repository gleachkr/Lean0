lemma f28_pa_all (G: hyps) (ta tb: set): $ G ⇒ trees ω ⊆ f28_pa_q ta tb $
----
l1: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ crn n ⊆ f28_pa_q ta tb $ by ax
l2: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ y = ⟨ m , n ⟩ $ by ax
l3: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ m ∊ ω $ by ax
l4: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ n ∊ fseq (trees ω) $ by ax
l5: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel $ by ax
l6: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ ∃ x ∃ z (r = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst i y tb z ∈ lrel) $ by f28_pa_n [l1, l2, l3, l4, l5]
l7: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ ⇒ ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst i y tb z ∈ lrel) $ by imp_intro [l6]
l8: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ ⇒ ∀ r (ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst i y tb z ∈ lrel)) $ by all_intro [l7]
l9: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ ⇒ ∀ i ∀ r (ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst i y tb z ∈ lrel)) $ by all_intro [l8]
l10: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ ⇒ y ∊ f28_pa_q ta tb $ by cab_intro [l9]
l11: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ ⇒ y = ⟨ m , n ⟩ $ by ax
l12: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb , y = ⟨ m , n ⟩ ⇒ ⟨ m , n ⟩ ∈ f28_pa_q ta tb $ by wcel_intro [l11, l10]
l13: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb ⇒ isset ⟨ m , n ⟩ $ by opair_isset
l14: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pa_q ta tb ⇒ ⟨ m , n ⟩ ∈ f28_pa_q ta tb $ by isset_elim [l13, l12]
l15: $ G ⇒ m ∊ ω → n ∊ fseq (trees ω) → crn n ⊆ f28_pa_q ta tb → ⟨ m , n ⟩ ∈ f28_pa_q ta tb $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ m ∀ n (m ∊ ω → n ∊ fseq (trees ω) → crn n ⊆ f28_pa_q ta tb → ⟨ m , n ⟩ ∈ f28_pa_q ta tb) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f28_pa_q ta tb $ by trees_ind_c [l17, l16]

pinst_app_inv
-------------
l1: $ G ⇒ ⟨ kr_pinst , scons ti (scons ts (scons ⟨ kc_app , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tr ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons ⟨ kc_app , scons ta (scons tb ∅) ⟩ (scons tr ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ts (scons ⟨ kc_app , scons ta (scons tb ∅) ⟩ (scons tr ∅))) $ by scons_set [l4]
l6: $ G ⇒ isset (scons ti (scons ts (scons ⟨ kc_app , scons ta (scons tb ∅) ⟩ (scons tr ∅)))) $ by scons_set [l5]
l7: $ G ⇒ kr_pinst ∈ ω $ by kr_pinst_omega
l8: $ G ⇒ kr_pinst ∈ ω ∧ scons ti (scons ts (scons ⟨ kc_app , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons ti (scons ts (scons ⟨ kc_app , scons ta (scons tb ∅) ⟩ (scons tr ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ crn (scons ts (scons ⟨ kc_app , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ⊆ trees ω $ by crn_scons_tail [l9]
l11: $ G ⇒ isset ω $ by omega_set
l12: $ G ⇒ ts ∈ trees ω $ by crn_scons_head_trees [l11, l10]
l13: $ G ⇒ trees ω ⊆ f28_pa_q ta tb $ by f28_pa_all
l14: $ G ⇒ ts ∊ f28_pa_q ta tb $ by subset_elim [l13, wcel_welc [l12]]
l15: $ G ⇒ ∃ x ∃ z (tr = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst ti ts ta x ∈ lrel ∧ ra_pinst ti ts tb z ∈ lrel) $ by f28_pa_e [l14, #1]

lemma f28_sig_app (G: hyps): $ G ⇒ ⟨ kc_app , ⟨ ks_expr , scons ks_expr (scons ks_expr ∅) ⟩ ⟩ ∈ lsig $
----
