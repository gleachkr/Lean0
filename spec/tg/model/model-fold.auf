lemma f29_ce_all (G: hyps) (tg tb: set): $ G ⇒ trees ω ⊆ f29_ce_q tg tb $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ , ra_clen tg tb ∈ lrel , ra_clen y a ∈ lrel ⇒ crn x9 ⊆ f29_ce_q tg tb $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ , ra_clen tg tb ∈ lrel , ra_clen y a ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ , ra_clen tg tb ∈ lrel , ra_clen y a ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ , ra_clen tg tb ∈ lrel , ra_clen y a ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ , ra_clen tg tb ∈ lrel , ra_clen y a ∈ lrel ⇒ ra_clen tg tb ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ , ra_clen tg tb ∈ lrel , ra_clen y a ∈ lrel ⇒ ra_clen y a ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ , ra_clen tg tb ∈ lrel , ra_clen y a ∈ lrel ⇒ ∃ r ∃ c (ra_capp y tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb a c ∈ lrel) $ by f29_ce_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ , ra_clen tg tb ∈ lrel ⇒ ra_clen y a ∈ lrel → ∃ r ∃ c (ra_capp y tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb a c ∈ lrel) $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ ⇒ ra_clen tg tb ∈ lrel → ra_clen y a ∈ lrel → ∃ r ∃ c (ra_capp y tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb a c ∈ lrel) $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ ⇒ ∀ a (ra_clen tg tb ∈ lrel → ra_clen y a ∈ lrel → ∃ r ∃ c (ra_capp y tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb a c ∈ lrel)) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_ce_q tg tb $ by cab_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_ce_q tg tb $ by wcel_intro [l12, l11]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ce_q tg tb ⇒ ⟨ x8 , x9 ⟩ ∈ f29_ce_q tg tb $ by isset_elim [l14, l13]
l16: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_ce_q tg tb → ⟨ x8 , x9 ⟩ ∈ f29_ce_q tg tb $ by imp_intro [imp_intro [imp_intro [l15]]]
l17: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_ce_q tg tb → ⟨ x8 , x9 ⟩ ∈ f29_ce_q tg tb) $ by all_intro [all_intro [l16]]
l18: $ G ⇒ isset ω $ by omega_set
l19: $ G ⇒ trees ω ⊆ f29_ce_q tg tb $ by trees_ind_c [l18, l17]

capp_clen_ex
------------
l1: $ G ⇒ ⟨ kr_clen , scons tp (scons ta ∅) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons ta ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tp (scons ta ∅)) $ by scons_set [l3]
l5: $ G ⇒ kr_clen ∈ ω $ by kr_clen_omega
l6: $ G ⇒ kr_clen ∈ ω ∧ scons tp (scons ta ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l5], l4]
l7: $ G ⇒ crn (scons tp (scons ta ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l6]]
l8: $ G ⇒ isset ω $ by omega_set
l9: $ G ⇒ tp ∈ trees ω $ by crn_scons_head_trees [l8, l7]
l10: $ G ⇒ trees ω ⊆ f29_ce_q tg tb $ by f29_ce_all
l11: $ G ⇒ tp ∊ f29_ce_q tg tb $ by subset_elim [l10, wcel_welc [l9]]
l12: $ G ⇒ ∃ r ∃ c (ra_capp tp tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb ta c ∈ lrel) $ by f29_ce_e [l11, #2, #1]

def f29_pc_q (tg tt: set) (.y .r .b .m: set): class = $ {y | ∀ r ∀ b ∀ m (ra_capp y tg r ∈ lrel → ra_pis y b m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis r b tt ∈ lrel)} $

lemma f29_pc_e (G: hyps) (tg tt: set) (ty vr vb vm: set): $ G ⇒ ty ∊ f29_pc_q tg tt $ > $ G ⇒ ra_capp ty tg vr ∈ lrel $ > $ G ⇒ ra_pis ty vb vm ∈ lrel $ > $ G ⇒ ra_pis tg vm tt ∈ lrel $ > $ G ⇒ ra_pis vr vb tt ∈ lrel $
----
l1: $ G ⇒ ∀ r ∀ b ∀ m (ra_capp ty tg r ∈ lrel → ra_pis ty b m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis r b tt ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ b ∀ m (ra_capp ty tg vr ∈ lrel → ra_pis ty b m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis vr b tt ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ∀ m (ra_capp ty tg vr ∈ lrel → ra_pis ty vb m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis vr vb tt ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ra_capp ty tg vr ∈ lrel → ra_pis ty vb vm ∈ lrel → ra_pis tg vm tt ∈ lrel → ra_pis vr vb tt ∈ lrel $ by all_elim [l3]
l5: $ G ⇒ ra_pis ty vb vm ∈ lrel → ra_pis tg vm tt ∈ lrel → ra_pis vr vb tt ∈ lrel $ by imp_elim [l4, #2]
l6: $ G ⇒ ra_pis tg vm tt ∈ lrel → ra_pis vr vb tt ∈ lrel $ by imp_elim [l5, #3]
l7: $ G ⇒ ra_pis vr vb tt ∈ lrel $ by imp_elim [l6, #4]

lemma f29_pc_n (G: hyps) (tg tt: set) (ty k1 j1 vr vb vm: set): $ G ⇒ crn j1 ⊆ f29_pc_q tg tt $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_capp ty tg vr ∈ lrel $ > $ G ⇒ ra_pis ty vb vm ∈ lrel $ > $ G ⇒ ra_pis tg vm tt ∈ lrel $ > $ G ⇒ ra_pis vr vb tt ∈ lrel $
----
l1: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = tg ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = tg $ by ax
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = tg ⇒ ra_pis ty vb vm ∈ lrel $ by weaken [#6]
