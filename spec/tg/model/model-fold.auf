l5: $ G ⇒ uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → c0 ∊ fseq u → cdm c0 = nadd (nvf' tm) (nvf' tn) → rr ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ → n0 ∊ trees ω → ∀ x (x ∊ fseq u → dt u M n0 w x = Z) → K ∈ cdm c0 → nadd (suc K) (nvf' ti) = cdm c0 → ra_rtail td tnp tn tm ti vd ty vm ∈ lrel → ty ∊ trees ω → vm ∊ ofsort lsig lopen ks_expr → vd ∊ ofsort lsig lopen ks_nat → ve ∊ fseq u → cdm ve = nvf' vd → vr = ve ++ c0 ++ p ++ rr → dt u M vm w vr = fpi t (mpth u (dnf u M) ty w vr (clam f (fseq u) (apn (Z) (f ++ ve ++ p)))) (ap (clam f (fseq u) (apn (c0' K) (f ++ ve))) t) $ by all_elim [l4]
