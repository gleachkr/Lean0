l1: $ G ⇒ esat u (dsh u M rv) ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u (dsh u M rv) tIhs w ∧ x ∊ da ((dsh u M rv)' tIH) w q ∧ r = scons x q)} $ by esat_cons [lsig_ofsort_trees [#4], welc_wcel [#5], #2]
