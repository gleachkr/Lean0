l25: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons ty (scons x1 (scons vr ∅))) $ by scons_set [l24]
