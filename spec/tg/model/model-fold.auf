l35: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → z' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) z $ by and_intro [l26, l34]
l36: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ cdm z = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → z' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) z $ by and_intro [l15, l35]
l37: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ z ∊ fseq {y | y = y} ∧ cdm z = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → z' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) z $ by and_intro [l9, l36]
l38: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by ex_intro [l37]
l39: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY ⇒ isset ∅ $ by ax_empty
l40: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by isset_elim [l39, l38]
