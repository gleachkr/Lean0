l57: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ kc_ind_ty ∈ ω $ by kc_ind_ty_omega
l58: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ kc_app = kc_ind_ty $ by opair_inj_l_c [l55, wcel_isset [l56], wcel_isset [l57]]
l59: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ ¬ kc_app = kc_ind_ty $ by kc_app_ne_ind_ty
l60: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed tx tb ∈ lrel $ by bot_elim [not_elim [l59, l58]]
l61: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ $ by ax
l62: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ⟨ kc_app , scons ta (scons tb ∅) ⟩ = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l61]
l63: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_app ∈ ω $ by kc_app_omega
l64: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_ind_ctor ∈ ω $ by kc_ind_ctor_omega
l65: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_app = kc_ind_ctor $ by opair_inj_l_c [l62, wcel_isset [l63], wcel_isset [l64]]
l66: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ¬ kc_app = kc_ind_ctor $ by kc_app_ne_ind_ctor
l67: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed tx tb ∈ lrel $ by bot_elim [not_elim [l66, l65]]
l68: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ $ by ax
l69: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ⟨ kc_app , scons ta (scons tb ∅) ⟩ = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l68]
l70: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_app ∈ ω $ by kc_app_omega
l71: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_ind_rec ∈ ω $ by kc_ind_rec_omega
l72: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_app = kc_ind_rec $ by opair_inj_l_c [l69, wcel_isset [l70], wcel_isset [l71]]
l73: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ¬ kc_app = kc_ind_rec $ by kc_app_ne_ind_rec
l74: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed tx tb ∈ lrel $ by bot_elim [not_elim [l73, l72]]
l75: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel $ by ax
l76: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ⟨ kc_app , scons ta (scons tb ∅) ⟩ = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], and_elim_l [l75]]
l77: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l78: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_proj ∈ ω $ by kc_proj_omega
l79: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_app = kc_proj $ by opair_inj_l_c [l76, wcel_isset [l77], wcel_isset [l78]]
l80: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ¬ kc_app = kc_proj $ by kc_app_ne_proj
l81: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed tx tb ∈ lrel $ by bot_elim [not_elim [l80, l79]]
l110: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed tx tb ∈ lrel $ by f21_inv_closed [l3, l11, l19, l25, l32, l39, l46, l53, l60, l67, l74, l81]
l111: $ G ⇒ isset ⟨ kc_app , scons ta (scons tb ∅) ⟩ $ by opair_isset
l112: $ G ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed tx tb ∈ lrel $ by isset_elim [l111, l110]

--| @freshen H qi_v
--| @freshen H ql_v
--| @freshen H qf_v
--| @freshen H qx_v
--| @freshen H qf2
--| @freshen H qx2_v
--| @freshen H qA
--| @freshen H qb_v
--| @freshen H qA2
--| @freshen H qb2
--| @freshen H qj_v
--| @freshen H qe_v
--| @freshen H qe2
lemma f21_inv_inst {qi_v ql_v qf_v qx_v qf2 qx2_v qA qb_v qA2 qb2 qj_v qe_v qe2: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_inst t1 t2 t3 t4 ∈ lrel $ > $ H , t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t1 ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_bvar , scons t1 ∅ ⟩ ∧ ra_lift t1 ⟨ kc_nz , ∅ ⟩ t3 t4 ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_bvar , scons ⟨ kc_s , scons qi_v ∅ ⟩ ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le t1 qi_v ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_app , scons qf_v (scons qx_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qx2_v ∅) ⟩ ∧ ra_inst t1 qf_v t3 qf2 ∈ lrel ∧ ra_inst t1 qx_v t3 qx2_v ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst t1 qA t3 qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons t1 ∅ ⟩ qb_v t3 qb2 ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst t1 qA t3 qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons t1 ∅ ⟩ qb_v t3 qb2 ∈ lrel ⇒ Cf $ > $ H , t4 = t2 ∧ ra_closed qj_v t2 ∈ lrel ∧ ra_le qj_v t1 ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_inst t1 qe_v t3 qe2 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_inst t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) ∨ ∃ x ∃ y ∃ z (t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel) ∨ ∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons ⟨ kc_s , scons qi_v ∅ ⟩ ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le x qi_v ∈ lrel) ∨ ∃ x ∃ ql_v ∃ y (t1 = x ∧ t2 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ qf_v ∃ qx_v ∃ y ∃ qf2 ∃ qx2_v (t1 = x ∧ t2 = ⟨ kc_app , scons qf_v (scons qx_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_app , scons qf2 (scons qx2_v ∅) ⟩ ∧ ra_inst x qf_v y qf2 ∈ lrel ∧ ra_inst x qx_v y qx2_v ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v ∃ y ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_inst x qA y qA2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons x ∅ ⟩ qb_v y qb2 ∈ lrel) ∨ ∃ qj_v ∃ x ∃ qe_v ∃ y (t1 = x ∧ t2 = qe_v ∧ t3 = y ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v x ∈ lrel) ∨ ∃ x ∃ qb_v ∃ qi_v ∃ qe_v ∃ y ∃ qe2 (t1 = x ∧ t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_inst x qe_v y qe2 ∈ lrel) $ by lrel_inst_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel ⇒ t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel ⇒ ⟨ kc_s , scons qi_v ∅ ⟩ = ⟨ kc_s , scons qi_v ∅ ⟩ $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel ⇒ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t1 ∈ lrel $ by wcel_eq_l [ra_le_eq [l4, eq_sym [and_elim_l [l3]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]
l6: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel ⇒ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t1 ∈ lrel $ by and_intro [and_elim_l [and_elim_r [l3]], and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]], l5]]
l7: $ H ⇒ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t1 ∈ lrel → Cf $ by imp_intro [#2]
l8: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel ⇒ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t1 ∈ lrel → Cf $ by weaken [l7]
l9: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel ⇒ Cf $ by imp_elim [l8, l6]
l10: $ G , H , ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) ⇒ ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) $ by ax
l11: $ … ⇒ Cf $ by ex_elim [l10, l9]
l12: $ G , H , ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) ⇒ ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) ⇒ ∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H ⇒ (∃ x ∃ qi_v ∃ y (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t3 = y ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel)) → Cf $ by imp_intro [l15]
l17: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel ⇒ t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel $ by ax
l18: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l19: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel ⇒ kc_bvar = kc_bvar $ by eq_refl
l20: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel ⇒ t2 = ⟨ kc_bvar , scons t1 ∅ ⟩ $ by eq_trans [and_elim_l [and_elim_r [l17]], opair_eq [l19, scons_eq [eq_sym [and_elim_l [l17]], l18]]]
l21: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l22: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel ⇒ ra_lift t1 ⟨ kc_nz , ∅ ⟩ t3 t4 ∈ lrel $ by wcel_eq_l [ra_lift_eq [eq_sym [and_elim_l [l17]], l21, eq_sym [and_elim_l [and_elim_r [and_elim_r [l17]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l17]]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [l17]]]]]
l23: $ G , H , t1 = x ∧ t2 = ⟨ kc_bvar , scons x ∅ ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_lift x ⟨ kc_nz , ∅ ⟩ y z ∈ lrel ⇒ t2 = ⟨ kc_bvar , scons t1 ∅ ⟩ ∧ ra_lift t1 ⟨ kc_nz , ∅ ⟩ t3 t4 ∈ lrel $ by and_intro [l20, l22]
