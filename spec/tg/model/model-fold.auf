--| @freshen H qb2
lemma f21_inv_rst {qe_v qj_v qnp qn_v qm_v qna qk_v qS qX qX1 qX2 qe2 qI qc_v qi_v qnpi qY qf_v qa_v qf2 qa2 qA qb_v qA2 qb2: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_rst t1 t2 t3 t4 ∈ lrel $ > $ H , t2 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = t3 ⇒ Cf $ > $ H , ra_spine ⟨ kc_ind_ty , scons t1 (scons qj_v ∅) ⟩ t3 qna ∈ lrel ∧ ra_aux_of t1 t2 qj_v qX ∈ lrel ∧ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS t3 qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v t3 t4 ∈ lrel ⇒ Cf $ > $ H , ra_spine ⟨ kc_ind_ctor , scons t1 (scons qj_v (scons qc_v ∅)) ⟩ t3 qna ∈ lrel ∧ ra_aux_of t1 t2 qj_v qX ∈ lrel ∧ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS t3 qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ ⟨ kc_ind_ctor , scons qI (scons qi_v (scons qc_v ∅)) ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v t3 t4 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_rst t1 t2 qf_v qf2 ∈ lrel ∧ ra_rst t1 t2 qa_v qa2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst t1 t2 qA qA2 ∈ lrel ∧ ra_rst t1 t2 qb_v qb2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst t1 t2 qA qA2 ∈ lrel ∧ ra_rst t1 t2 qb_v qb2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_rst t1 t2 qe_v qe2 ∈ lrel ⇒ Cf $ > $ H , t4 = t3 ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_rst t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) ∨ ∃ x ∃ y ∃ qj_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ qI ∃ y ∃ qj_v ∃ qc_v ∃ qi_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qnpi ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qY ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ctor , scons x (scons qj_v (scons qc_v ∅)) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ ⟨ kc_ind_ctor , scons qI (scons qi_v (scons qc_v ∅)) ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v) $ by lrel_rst_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v $ by ax
l4: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ t4 = t3 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [l3]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]]]
l5: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = t3 $ by and_intro [and_elim_l [and_elim_r [l3]], l4]
l6: $ H ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = t3 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = t3 → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) ⇒ ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H , ∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) ⇒ ∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) $ by ax
l12: $ … ⇒ Cf $ by ex_elim [l11, l10]
l13: $ G , H ⇒ (∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by imp_intro [l12]
l14: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel $ by ax
l15: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l16: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ qj_v = qj_v $ by eq_refl
l17: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ kc_ind_ty = kc_ind_ty $ by eq_refl
l18: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ qna = qna $ by eq_refl
l19: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ ra_spine ⟨ kc_ind_ty , scons t1 (scons qj_v ∅) ⟩ t3 qna ∈ lrel $ by wcel_eq_l [ra_spine_eq [opair_eq [l17, scons_eq [eq_sym [and_elim_l [l14]], scons_eq [l16, l15]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l14]]]], l18], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l14]]]]]]
l20: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ qX = qX $ by eq_refl
l21: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ ra_aux_of t1 t2 qj_v qX ∈ lrel $ by wcel_eq_l [ra_aux_of_eq [eq_sym [and_elim_l [l14]], eq_sym [and_elim_l [and_elim_r [l14]]], l16, l20], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l14]]]]]]]
l22: $ G , H , t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel ⇒ qnp = qnp $ by eq_refl
