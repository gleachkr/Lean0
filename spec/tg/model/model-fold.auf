l8: $ G ⇒ scons a ∅ ∈ fseq A $ by scons_fseq_c [welc_wcel [#3], l7]
l9: $ G ⇒ scons b ∅ ∈ fseq A $ by scons_fseq_c [welc_wcel [#4], l7]
