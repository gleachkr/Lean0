l21: $ G ⇒ crn (scons tv (scons tnf (scons tfld (scons ty (scons tj (scons tA (scons tIH ∅))))))) ⊆ trees ω $ by crn_scons_tail [l20]
l22: $ G ⇒ crn (scons tnf (scons tfld (scons ty (scons tj (scons tA (scons tIH ∅)))))) ⊆ trees ω $ by crn_scons_tail [l21]
l23: $ G ⇒ crn (scons tfld (scons ty (scons tj (scons tA (scons tIH ∅))))) ⊆ trees ω $ by crn_scons_tail [l22]
