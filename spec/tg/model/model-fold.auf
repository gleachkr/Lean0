l444: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ , x6 = scons x1 vk ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by isset_elim [l443, l441]
l445: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ isset vk $ by isset_var
l446: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ isset (scons x1 vk) $ by scons_set [l445]
l447: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by isset_elim [l446, l444]
l448: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 ⇒ isset ⟨ kc_s , scons vd ∅ ⟩ $ by opair_isset
l449: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by isset_elim [l448, l447]
l450: $ G , ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) ⇒ ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) $ by ax
l451: $ … ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by ex_elim [l450, l449]
l452: $ G , ∃ x3 ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) ⇒ ∃ x3 ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) $ by ax
l453: $ … ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by ex_elim [l452, l451]
l454: $ G , ∃ x2 ∃ x3 ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) ⇒ ∃ x2 ∃ x3 ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) $ by ax
l455: $ … ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by ex_elim [l454, l453]
l456: $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by ex_elim [l140, l455]

--| @freshen G z
--| @freshen G j
--| @freshen G b
--| @freshen G e
--| @freshen G m
--| @freshen G y
lemma f39_c1 {z j b e m y: set} (G: hyps) (H J MV: class) (u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs: set) (ty vd va vv vk vr vl vf vg vc vt vh vx vn tA tB tA3 tVal tdp tj tA2 tmn tsh tfld tA4 tIH: set): $ G ⇒ tB ∊ f39_q H J MV u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs $ > $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ > $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ > $ G ⇒ tK0 ∊ trees ω $ > $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) $ > $ G ⇒ ∀ j ∀ b ∀ e ∀ z (ra_nth_ty tt j b e ∈ lrel → nvf' j ∈ nvf' tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (nvf' j) (lv tv w) w) $ > $ G ⇒ ss ∊ fseq u $ > $ G ⇒ cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ c0 = mv ++ cv $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → nvf' b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = xs' j) $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ > $ G ⇒ vv ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ trees ω $ > $ G ⇒ ra_closed vx ty ∈ lrel $ > $ G ⇒ nvf' vx = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vd) = nvf' tnf $ > $ G ⇒ ∀ b ∀ e ∀ m (ra_nth_pi ty b e ∈ lrel → ra_add vd b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) $ > $ G ⇒ vk ∊ fseq u $ > $ G ⇒ cdm vk = nvf' vd $ > $ G ⇒ vt ∊ fseq u $ > $ G ⇒ cdm vt = nvf' vd $ > $ G ⇒ vh ∊ fseq {y | y = y} $ > $ G ⇒ cdm vh = nvf' vd $ > $ G ⇒ vr = vk ++ c0 ++ p ++ ss $ > $ G ⇒ vl = vk ++ p ++ xs $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vc , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vl $ > $ G ⇒ pg = vt ++ vg $ > $ G ⇒ pt = vh ++ vc $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) → dt u (mcv H) va w (vf ++ vr) = apn MV (z ++ vf ++ vk)) $ > $ G ⇒ ty = ⟨ kc_pi , scons tA (scons tB ∅) ⟩ $ > $ G ⇒ vv = ⟨ kc_lam , scons tA3 (scons tVal ∅) ⟩ $ > $ G ⇒ ra_add vd tnp tdp ∈ lrel $ > $ G ⇒ ra_recfield td tn tnp vd tA tj ∈ lrel $ > $ G ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tdp tA tA2 ∈ lrel $ > $ G ⇒ ra_add tm tn tmn ∈ lrel $ > $ G ⇒ ra_lift tmn vd tA2 tA3 ∈ lrel $ > $ G ⇒ ra_add tsh vd tnf ∈ lrel $ > $ G ⇒ ra_add tfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tsh ∈ lrel $ > $ G ⇒ ra_lift tsh ⟨ kc_nz , ∅ ⟩ tA3 tA4 ∈ lrel $ > $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_nz , ∅ ⟩ tj tA4 tIH ∈ lrel $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons tIH ∅) ⟩ tB tVal ∈ lrel $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $
----
l1: $ G ⇒ iwf u H J tg td w r0 $ by weaken [#2]
l2: $ G ⇒ w ∊ lvals $ by wcel_welc [iwf_lvals [l1]]
l3: $ G ⇒ uadm u $ by iwf_uadm [l1]
l4: $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ by weaken [#8]
l5: $ G ⇒ mv ∊ ivals k u (inmin td) {y | ∃ i ∃ c (iminx td i c k ∧ y ∊ imin u (dnf u (mcv H)) td i c w p cv ∧ ihasc td i c)} $ by weaken [l4]
l6: $ G ⇒ mv ∊ fseq u $ by and_elim_l [ivals_fseq [l5]]
l7: $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ by weaken [#7]
l8: $ G ⇒ cv ∊ ivals j u (intys td) (imot u (dnf u (mcv H)) td j w p (lv tv w)) $ by weaken [l7]
l9: $ G ⇒ cv ∊ fseq u $ by and_elim_l [ivals_fseq [l8]]
l10: $ G ⇒ esat u (dnf u (mcv H)) tp w ⊆ fseq u $ by esat_fseq
l11: $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ by weaken [#6]
l12: $ G ⇒ p ∊ fseq u $ by subset_elim [l10, l11]
l13: $ G ⇒ c0 = mv ++ cv $ by weaken [#15]
l14: $ G ⇒ c0 ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l13], scat_fseq [l6, l9]]]
l15: $ G ⇒ vk ∊ fseq u $ by weaken [#27]
l16: $ G ⇒ ss ∊ fseq u $ by weaken [#13]
l17: $ G ⇒ c0 ++ p ++ ss ∈ fseq u $ by scat_fseq_c [welc_wcel [l14], scat_fseq [l12, l16]]
l18: $ G ⇒ xs ∊ fseq u $ by weaken [#16]
l19: $ G ⇒ p ++ xs ∈ fseq u $ by scat_fseq [l12, l18]
l20: $ G ⇒ vr = vk ++ c0 ++ p ++ ss $ by weaken [#33]
l21: $ G ⇒ vr ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l20], scat_fseq_c [welc_wcel [l15], l17]]]
l22: $ G ⇒ vl = vk ++ p ++ xs $ by weaken [#34]
l23: $ G ⇒ vl ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l22], scat_fseq_c [welc_wcel [l15], l19]]]
l24: $ G ⇒ isset vd $ by isset_var
l25: $ G ⇒ nvf' vd ∈ ω $ by nvf_omega [l24]
l26: $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ by weaken [#19]
l27: $ G ⇒ ⟨ kr_rwalk , scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))))) ⟩ ∈ latoms $ by lrel_latoms [l26]
l28: $ G ⇒ isset ∅ $ by ax_empty
l29: $ G ⇒ isset (scons vv ∅) $ by scons_set [l28]
l30: $ G ⇒ isset (scons ty (scons vv ∅)) $ by scons_set [l29]
l31: $ G ⇒ isset (scons va (scons ty (scons vv ∅))) $ by scons_set [l30]
l32: $ G ⇒ isset (scons vd (scons va (scons ty (scons vv ∅)))) $ by scons_set [l31]
l33: $ G ⇒ isset (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))) $ by scons_set [l32]
l34: $ G ⇒ isset (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))) $ by scons_set [l33]
l35: $ G ⇒ isset (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))) $ by scons_set [l34]
l36: $ G ⇒ isset (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))))) $ by scons_set [l35]
l37: $ G ⇒ isset (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))))) $ by scons_set [l36]
l38: $ G ⇒ isset (scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))))))) $ by scons_set [l37]
l39: $ G ⇒ kr_rwalk ∈ ω $ by kr_rwalk_omega
l40: $ G ⇒ kr_rwalk ∈ ω ∧ scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l27, wcel_isset [l39], l38]
l41: $ G ⇒ crn (scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))))))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l40]]
l42: $ G ⇒ crn (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))))) ⊆ trees ω $ by crn_scons_tail [l41]
l43: $ G ⇒ crn (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))))) ⊆ trees ω $ by crn_scons_tail [l42]
l44: $ G ⇒ crn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))) ⊆ trees ω $ by crn_scons_tail [l43]
l45: $ G ⇒ crn (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))) ⊆ trees ω $ by crn_scons_tail [l44]
l46: $ G ⇒ crn (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))) ⊆ trees ω $ by crn_scons_tail [l45]
l47: $ G ⇒ crn (scons vd (scons va (scons ty (scons vv ∅)))) ⊆ trees ω $ by crn_scons_tail [l46]
l48: $ G ⇒ crn (scons va (scons ty (scons vv ∅))) ⊆ trees ω $ by crn_scons_tail [l47]
l49: $ G ⇒ crn (scons ty (scons vv ∅)) ⊆ trees ω $ by crn_scons_tail [l48]
l50: $ G ⇒ isset ω $ by omega_set
l51: $ G ⇒ ty ∈ trees ω $ by crn_scons_head_trees [l50, l49]
l52: $ G ⇒ ty ∊ trees ω $ by wcel_welc [l51]
l53: $ G ⇒ ty = ⟨ kc_pi , scons tA (scons tB ∅) ⟩ $ by weaken [#39]
l54: $ G ⇒ vv = ⟨ kc_lam , scons tA3 (scons tVal ∅) ⟩ $ by weaken [#40]
l55: $ G ⇒ vv ∊ ofsort lsig lopen ks_expr $ by weaken [#20]
l56: $ G ⇒ tA3 ∊ ofsort lsig lopen ks_expr ∧ tVal ∊ ofsort lsig lopen ks_expr $ by ofsort_lam_kids [wcel_eq_l [l54, welc_wcel [l55]]]
l57: $ G ⇒ tA3 ∊ ofsort lsig lopen ks_expr $ by and_elim_l [l56]
l58: $ G ⇒ tVal ∊ ofsort lsig lopen ks_expr $ by and_elim_r [l56]
l59: $ G ⇒ tA3 ∊ trees ω $ by wcel_welc [lsig_ofsort_trees [l57]]
l60: $ G ⇒ tVal ∊ trees ω $ by wcel_welc [lsig_ofsort_trees [l58]]
l61: $ G ⇒ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons tIH ∅) ⟩ tB tVal ∈ lrel $ by weaken [#50]
l62: $ G ⇒ ⟨ kr_rwalk , scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons ⟨ kc_s , scons vd ∅ ⟩ (scons ⟨ kc_app , scons va (scons tIH ∅) ⟩ (scons tB (scons tVal ∅))))))))) ⟩ ∈ latoms $ by lrel_latoms [l61]
l63: $ G ⇒ isset ∅ $ by ax_empty
l64: $ G ⇒ isset (scons tVal ∅) $ by scons_set [l63]
l65: $ G ⇒ isset (scons tB (scons tVal ∅)) $ by scons_set [l64]
l66: $ G ⇒ isset (scons ⟨ kc_app , scons va (scons tIH ∅) ⟩ (scons tB (scons tVal ∅))) $ by scons_set [l65]
l67: $ G ⇒ isset (scons ⟨ kc_s , scons vd ∅ ⟩ (scons ⟨ kc_app , scons va (scons tIH ∅) ⟩ (scons tB (scons tVal ∅)))) $ by scons_set [l66]
l68: $ G ⇒ isset (scons tnf (scons ⟨ kc_s , scons vd ∅ ⟩ (scons ⟨ kc_app , scons va (scons tIH ∅) ⟩ (scons tB (scons tVal ∅))))) $ by scons_set [l67]
l69: $ G ⇒ isset (scons tv (scons tnf (scons ⟨ kc_s , scons vd ∅ ⟩ (scons ⟨ kc_app , scons va (scons tIH ∅) ⟩ (scons tB (scons tVal ∅)))))) $ by scons_set [l68]
