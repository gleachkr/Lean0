l153: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel ⇒ ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by ex_elim [l67, l152]
l154: $ G ⇒ ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by f21_inv_spine [#6, l31, l153]

lemma f30_ss_all (G: hyps) (td tj tn tk th tdd: set): $ G ⇒ trees ω ⊆ f30_ss_q td tj tn tk th tdd $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel , ra_sinst td tj tn tk y z ∈ lrel ⇒ crn x9 ⊆ f30_ss_q td tj tn tk th tdd $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel , ra_sinst td tj tn tk y z ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel , ra_sinst td tj tn tk y z ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel , ra_sinst td tj tn tk y z ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel , ra_sinst td tj tn tk y z ∈ lrel ⇒ ra_add tj tdd tn ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel , ra_sinst td tj tn tk y z ∈ lrel ⇒ ra_spine th y m ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel , ra_sinst td tj tn tk y z ∈ lrel ⇒ ra_sinst td tj tn tk y z ∈ lrel $ by ax
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel , ra_sinst td tj tn tk y z ∈ lrel ⇒ ∃ x (ra_spine x z m ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by f30_ss_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel , ra_spine th y m ∈ lrel ⇒ ra_sinst td tj tn tk y z ∈ lrel → ∃ x (ra_spine x z m ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ , ra_add tj tdd tn ∈ lrel ⇒ ra_spine th y m ∈ lrel → ra_sinst td tj tn tk y z ∈ lrel → ∃ x (ra_spine x z m ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by imp_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ ⇒ ra_add tj tdd tn ∈ lrel → ra_spine th y m ∈ lrel → ra_sinst td tj tn tk y z ∈ lrel → ∃ x (ra_spine x z m ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by imp_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ ⇒ ∀ z (ra_add tj tdd tn ∈ lrel → ra_spine th y m ∈ lrel → ra_sinst td tj tn tk y z ∈ lrel → ∃ x (ra_spine x z m ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel)) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ ⇒ ∀ m ∀ z (ra_add tj tdd tn ∈ lrel → ra_spine th y m ∈ lrel → ra_sinst td tj tn tk y z ∈ lrel → ∃ x (ra_spine x z m ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel)) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f30_ss_q td tj tn tk th tdd $ by cab_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f30_ss_q td tj tn tk th tdd $ by wcel_intro [l15, l14]
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_ss_q td tj tn tk th tdd ⇒ ⟨ x8 , x9 ⟩ ∈ f30_ss_q td tj tn tk th tdd $ by isset_elim [l17, l16]
l19: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f30_ss_q td tj tn tk th tdd → ⟨ x8 , x9 ⟩ ∈ f30_ss_q td tj tn tk th tdd $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f30_ss_q td tj tn tk th tdd → ⟨ x8 , x9 ⟩ ∈ f30_ss_q td tj tn tk th tdd) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ f30_ss_q td tj tn tk th tdd $ by trees_ind_c [l21, l20]

sinst_spine
-----------
l1: $ G ⇒ ⟨ kr_spine , scons th (scons te (scons tm ∅)) ⟩ ∈ latoms $ by lrel_latoms [#2]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tm ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons te (scons tm ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons th (scons te (scons tm ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_spine ∈ ω $ by kr_spine_omega
l7: $ G ⇒ kr_spine ∈ ω ∧ scons th (scons te (scons tm ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons th (scons te (scons tm ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ crn (scons te (scons tm ∅)) ⊆ trees ω $ by crn_scons_tail [l8]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ te ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ trees ω ⊆ f30_ss_q td tj tn tk th tdd $ by f30_ss_all
l13: $ G ⇒ te ∊ f30_ss_q td tj tn tk th tdd $ by subset_elim [l12, wcel_welc [l11]]
l14: $ G ⇒ ∃ x (ra_spine x tz tm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by f30_ss_e [l13, #1, #2, #3]

def f30_an_q (ta: set) (.y .c: set): class = $ {y | ∀ c (ra_add ta y c ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ y y ∈ lrel)} $

lemma f30_an_e (G: hyps) (ta: set) (ty vc: set): $ G ⇒ ty ∊ f30_an_q ta $ > $ G ⇒ ra_add ta ty vc ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ty ∈ lrel $
----
l1: $ G ⇒ ∀ c (ra_add ta ty c ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ ty ty ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ra_add ta ty vc ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ ty ty ∈ lrel $ by all_elim [l1]
l3: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ty ∈ lrel $ by imp_elim [l2, #2]

lemma f30_an_n (G: hyps) (ta: set) (ty k1 j1 vc: set): $ G ⇒ crn j1 ⊆ f30_an_q ta $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add ta ty vc ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ty ∈ lrel $
----
l1: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta $ by ax
l2: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ isset ω $ by omega_set
l3: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ kc_nz ∈ ω $ by kc_nz_omega
l4: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l5: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l2, l3, l4]
l6: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_add_z [l5]
l7: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l8: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ty ∈ lrel $ by wcel_eq_l [ra_add_eq [l7, eq_sym [and_elim_l [l1]], eq_sym [and_elim_l [l1]]], l6]
l9: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel $ by ax
l10: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset ω $ by omega_set
l11: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ kc_nz ∈ ω $ by kc_nz_omega
l12: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l13: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l10, l11, l12]
l14: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset ∅ $ by ax_empty
l15: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset (scons n ∅) $ by scons_set [l14]
l16: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ crn j1 ⊆ f30_an_q ta $ by weaken [#1]
l17: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l18: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l19: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ crn (scons n ∅) ⊆ f30_an_q ta $ by node_crn_sub [l16, l17, and_elim_l [l9], wcel_isset [l18], l15]
l20: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset n $ by isset_var
l21: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ n ∈ f30_an_q ta $ by crn_scons_head [l20, l19]
l22: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel $ by f30_an_e [wcel_welc [l21], and_elim_r [and_elim_r [l9]]]
l23: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ⟨ kr_add , scons ta (scons n (scons i ∅)) ⟩ ∈ latoms $ by lrel_latoms [and_elim_r [and_elim_r [l9]]]
l24: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset ∅ $ by ax_empty
l25: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset (scons i ∅) $ by scons_set [l24]
l26: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset (scons n (scons i ∅)) $ by scons_set [l25]
l27: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset (scons ta (scons n (scons i ∅))) $ by scons_set [l26]
l28: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ kr_add ∈ ω $ by kr_add_omega
l29: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ kr_add ∈ ω ∧ scons ta (scons n (scons i ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l23, wcel_isset [l28], l27]
l30: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ crn (scons ta (scons n (scons i ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l29]]
l31: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ crn (scons n (scons i ∅)) ⊆ trees ω $ by crn_scons_tail [l30]
l32: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ isset ω $ by omega_set
l33: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ n ∈ trees ω $ by crn_scons_head_trees [l32, l31]
l34: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_s , scons n ∅ ⟩ ∈ lrel $ by lrel_add_s [l13, l33, l33, l22]
l35: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l36: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add ta n i ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ty ∈ lrel $ by wcel_eq_l [ra_add_eq [l35, eq_sym [and_elim_l [l9]], eq_sym [and_elim_l [l9]]], l34]
l37: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ty ∈ lrel $ by f21_inv_add [#5, l8, l36]

lemma f30_an_all (G: hyps) (ta: set): $ G ⇒ trees ω ⊆ f30_an_q ta $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ crn x9 ⊆ f30_an_q ta $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ ra_add ta y c ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ y y ∈ lrel $ by f30_an_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ra_add ta y c ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ y y ∈ lrel $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c (ra_add ta y c ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ y y ∈ lrel) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f30_an_q ta $ by cab_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f30_an_q ta $ by wcel_intro [l10, l9]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_an_q ta ⇒ ⟨ x8 , x9 ⟩ ∈ f30_an_q ta $ by isset_elim [l12, l11]
l14: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f30_an_q ta → ⟨ x8 , x9 ⟩ ∈ f30_an_q ta $ by imp_intro [imp_intro [imp_intro [l13]]]
l15: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f30_an_q ta → ⟨ x8 , x9 ⟩ ∈ f30_an_q ta) $ by all_intro [all_intro [l14]]
l16: $ G ⇒ isset ω $ by omega_set
l17: $ G ⇒ trees ω ⊆ f30_an_q ta $ by trees_ind_c [l16, l15]

add_num_r
---------
l1: $ G ⇒ ⟨ kr_add , scons ta (scons tb (scons tc ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tc ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tb (scons tc ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ta (scons tb (scons tc ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
l7: $ G ⇒ kr_add ∈ ω ∧ scons ta (scons tb (scons tc ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons ta (scons tb (scons tc ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ crn (scons tb (scons tc ∅)) ⊆ trees ω $ by crn_scons_tail [l8]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ tb ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ trees ω ⊆ f30_an_q ta $ by f30_an_all
l13: $ G ⇒ tb ∊ f30_an_q ta $ by subset_elim [l12, wcel_welc [l11]]
l14: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ tb tb ∈ lrel $ by f30_an_e [l13, #1]

def f30_cp_q (J: class) (td tn tnp tl ti tz: set) (.y .f .k .z .q .t .d .c .x .b .e .g .h: set): class = $ {y | ∀ f ∀ k ∀ z ∀ q ∀ t ∀ d ∀ c (ra_add tz tn tn ∈ lrel → ra_npis y f ∈ lrel → ra_sinst td tz tn k y z ∈ lrel → ra_pis q z t ∈ lrel → ra_clen q d ∈ lrel → ra_cwf td tn tnp tl ti c d y ∈ lrel3 J → ra_add d tnp k ∈ lrel → ∃ x ∃ b ∃ e ∃ g ∃ h (ra_pis x b t ∈ lrel ∧ ra_clen x g ∈ lrel ∧ ra_add d f g ∈ lrel ∧ ra_sinst td tz tn h e b ∈ lrel ∧ ra_indapp td tn tnp g e ti ∈ lrel ∧ ra_add g tnp h ∈ lrel))} $

--| @freshen G x
--| @freshen G b
--| @freshen G e
--| @freshen G g
--| @freshen G h
lemma f30_cp_e {x b e g h: set} (G: hyps) (J: class) (td tn tnp tl ti tz: set) (ty vf vk vz vq vt vd vc: set): $ G ⇒ ty ∊ f30_cp_q J td tn tnp tl ti tz $ > $ G ⇒ ra_add tz tn tn ∈ lrel $ > $ G ⇒ ra_npis ty vf ∈ lrel $ > $ G ⇒ ra_sinst td tz tn vk ty vz ∈ lrel $ > $ G ⇒ ra_pis vq vz vt ∈ lrel $ > $ G ⇒ ra_clen vq vd ∈ lrel $ > $ G ⇒ ra_cwf td tn tnp tl ti vc vd ty ∈ lrel3 J $ > $ G ⇒ ra_add vd tnp vk ∈ lrel $ > $ G ⇒ ∃ x ∃ b ∃ e ∃ g ∃ h (ra_pis x b vt ∈ lrel ∧ ra_clen x g ∈ lrel ∧ ra_add vd vf g ∈ lrel ∧ ra_sinst td tz tn h e b ∈ lrel ∧ ra_indapp td tn tnp g e ti ∈ lrel ∧ ra_add g tnp h ∈ lrel) $
----
l1: $ G ⇒ ∀ f ∀ k ∀ z ∀ q ∀ t ∀ d ∀ c (ra_add tz tn tn ∈ lrel → ra_npis ty f ∈ lrel → ra_sinst td tz tn k ty z ∈ lrel → ra_pis q z t ∈ lrel → ra_clen q d ∈ lrel → ra_cwf td tn tnp tl ti c d ty ∈ lrel3 J → ra_add d tnp k ∈ lrel → ∃ x ∃ b ∃ e ∃ g ∃ h (ra_pis x b t ∈ lrel ∧ ra_clen x g ∈ lrel ∧ ra_add d f g ∈ lrel ∧ ra_sinst td tz tn h e b ∈ lrel ∧ ra_indapp td tn tnp g e ti ∈ lrel ∧ ra_add g tnp h ∈ lrel)) $ by cab_elim [#1]
