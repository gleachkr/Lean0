lemma f39s_n (G: hyps) (td tnp tn tm tv tnf: set) (ty k1 j1 vd va vv: set): $ G ⇒ crn j1 ⊆ f39s_q td tnp tn tm tv tnf $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ > $ G ⇒ vv ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ va ∊ ofsort lsig lopen ks_expr $
