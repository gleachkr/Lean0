--| @freshen H qb_v
--| @freshen H qP
--| @freshen H qT
--| @freshen H qF
--| @freshen H qK
--| @freshen H ql_v
lemma f21_inv_struct_like {qb_v qP qT qF qK ql_v: set} (G H: hyps) (Cf: fml) (t1 t2: set): $ G ⇒ ra_struct_like t1 t2 ∈ lrel $ > $ H , ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_struct_like t1 t2 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ qF ∃ qK ∃ ql_v (t1 = x ∧ t2 = y ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel) $ by lrel_struct_like_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel ⇒ qb_v = qb_v $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel ⇒ qP = qP $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = y ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel ⇒ qT = qT $ by eq_refl
l7: $ G , H , t1 = x ∧ t2 = y ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel $ by wcel_eq_l [ra_ind_data_eq [eq_sym [and_elim_l [l3]], l4, l5, l6], and_elim_l [and_elim_r [and_elim_r [l3]]]]
l8: $ G , H , t1 = x ∧ t2 = y ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort qF ⟨ kc_nz , ∅ ⟩ ql_v ∈ lrel ⇒ qF = qF $ by eq_refl
