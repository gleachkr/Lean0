def f32_as_q (ta tb tc: set) (.y .e .f: set): class = $ {y | ∀ e ∀ f (ra_add ta tb tc ∈ lrel → ra_add tb y e ∈ lrel → ra_add tc y f ∈ lrel → ra_add ta e f ∈ lrel)} $

lemma f32_as_e (G: hyps) (ta tb tc: set) (ty ve vf: set): $ G ⇒ ty ∊ f32_as_q ta tb tc $ > $ G ⇒ ra_add ta tb tc ∈ lrel $ > $ G ⇒ ra_add tb ty ve ∈ lrel $ > $ G ⇒ ra_add tc ty vf ∈ lrel $ > $ G ⇒ ra_add ta ve vf ∈ lrel $
----
l1: $ G ⇒ ∀ e ∀ f (ra_add ta tb tc ∈ lrel → ra_add tb ty e ∈ lrel → ra_add tc ty f ∈ lrel → ra_add ta e f ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ f (ra_add ta tb tc ∈ lrel → ra_add tb ty ve ∈ lrel → ra_add tc ty f ∈ lrel → ra_add ta ve f ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ra_add ta tb tc ∈ lrel → ra_add tb ty ve ∈ lrel → ra_add tc ty vf ∈ lrel → ra_add ta ve vf ∈ lrel $ by all_elim [l2]
l4: $ G ⇒ ra_add tb ty ve ∈ lrel → ra_add tc ty vf ∈ lrel → ra_add ta ve vf ∈ lrel $ by imp_elim [l3, #2]
l5: $ G ⇒ ra_add tc ty vf ∈ lrel → ra_add ta ve vf ∈ lrel $ by imp_elim [l4, #3]
l6: $ G ⇒ ra_add ta ve vf ∈ lrel $ by imp_elim [l5, #4]

lemma f32_as_n (G: hyps) (ta tb tc: set) (ty k1 j1 ve vf: set): $ G ⇒ crn j1 ⊆ f32_as_q ta tb tc $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add ta tb tc ∈ lrel $ > $ G ⇒ ra_add tb ty ve ∈ lrel $ > $ G ⇒ ra_add tc ty vf ∈ lrel $ > $ G ⇒ ra_add ta ve vf ∈ lrel $
----
l1: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb ⇒ ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb $ by ax
l2: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb ⇒ ty = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l1]
l3: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb ⇒ ve = tb $ by and_elim_r [l1]
l4: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb ⇒ ra_add tc ty vf ∈ lrel $ by weaken [#7]
l5: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb , ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc ⇒ ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc $ by ax
l6: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb , ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc ⇒ ty = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l5]
l7: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb , ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc ⇒ vf = tc $ by and_elim_r [l5]
l8: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb , ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc ⇒ ty = ⟨ kc_nz , ∅ ⟩ $ by weaken [l2]
l9: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb , ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc ⇒ ve = tb $ by weaken [l3]
l10: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb , ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc ⇒ ra_add ta tb tc ∈ lrel $ by weaken [#5]
l11: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb , ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc ⇒ ta = ta $ by eq_refl
l12: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = tb , ty = ⟨ kc_nz , ∅ ⟩ ∧ vf = tc ⇒ ra_add ta ve vf ∈ lrel $ by wcel_eq_l [ra_add_eq [l11, eq_sym [l9], eq_sym [l7]], l10]
