l153: $ G , g = ∅ , v = p ++ rr , t = ity u (dnf u M) td (nvf' tj) w , q ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td (nvf' tj) w) (f ++ g ++ p))) ⇒ isset r $ by isset_var
l154: $ G , g = ∅ , v = p ++ rr , t = ity u (dnf u M) td (nvf' tj) w , q ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td (nvf' tj) w) (f ++ g ++ p))) ⇒ q ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td (nvf' tj) w) (f ++ g ++ p))) $ by ax
l155: $ G , g = ∅ , v = p ++ rr , t = ity u (dnf u M) td (nvf' tj) w , q ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td (nvf' tj) w) (f ++ g ++ p))) ⇒ q ∊ fseq u $ by subset_elim [mpth_fseq [welc_wcel [l152], l153], l154]
l156: $ G , g = ∅ , v = p ++ rr , t = ity u (dnf u M) td (nvf' tj) w , q ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td (nvf' tj) w) (f ++ g ++ p))) ⇒ ap (clam f (fseq u) (uni' (lv tv w))) q = uni' (lv tv w) $ by clam_ap [l155]
l157: $ G , g = ∅ , v = p ++ rr , t = ity u (dnf u M) td (nvf' tj) w ⇒ ∀ q (q ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td (nvf' tj) w) (f ++ g ++ p))) → ap (clam f (fseq u) (uni' (lv tv w))) q = uni' (lv tv w)) $ by all_intro [imp_intro [l156]]
l158: $ G , g = ∅ , v = p ++ rr , t = ity u (dnf u M) td (nvf' tj) w ⇒ fpi q (mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td (nvf' tj) w) (f ++ g ++ p)))) (ap (clam f (fseq u) (uni' (lv tv w))) q) = fpi q (imq u (dnf u M) td (nvf' tj) w p) (uni' (lv tv w)) $ by fpi_eq_pt [l151, l157]
l159: $ G , g = ∅ , v = p ++ rr , t = ity u (dnf u M) td (nvf' tj) w ⇒ dt u M tm w r = imot u (dnf u M) td (nvf' tj) w p (lv tv w) $ by eq_trans [l42, l158]
l160: $ G , g = ∅ , v = p ++ rr ⇒ isset (ity u (dnf u M) td (nvf' tj) w) $ by wcel_isset [weaken [#18]]
l161: $ G , g = ∅ , v = p ++ rr ⇒ dt u M tm w r = imot u (dnf u M) td (nvf' tj) w p (lv tv w) $ by isset_elim [l160, l159]
l162: $ G , g = ∅ ⇒ isset (p ++ rr) $ by wcel_isset [scat_fseq [weaken [#3], weaken [#7]]]
l163: $ G , g = ∅ ⇒ dt u M tm w r = imot u (dnf u M) td (nvf' tj) w p (lv tv w) $ by isset_elim [l162, l161]
l164: $ G ⇒ isset ∅ $ by ax_empty
l165: $ G ⇒ dt u M tm w r = imot u (dnf u M) td (nvf' tj) w p (lv tv w) $ by isset_elim [l164, l163]

esat_dsh_eq
-----------
l1: $ G , w ∊ lvals , r ∊ fseq u ⇒ S2 ∈ fseq u $ by wcel_eq_l [weaken [#3], weaken [#2]]
l2: $ G , w ∊ lvals , r ∊ fseq u ⇒ S ∈ fseq u $ by weaken [#2]
l3: $ G , w ∊ lvals , r ∊ fseq u ⇒ w ∊ lvals $ by ax
l4: $ G , w ∊ lvals , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
l5: $ G , w ∊ lvals , r ∊ fseq u ⇒ da ((dsh u M S)' t) w r = dt u M t w (r ++ S) $ by dsh_da [l2, l3, l4]
l6: $ G , w ∊ lvals , r ∊ fseq u ⇒ w ∊ lvals $ by ax
l7: $ G , w ∊ lvals , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
l8: $ G , w ∊ lvals , r ∊ fseq u ⇒ da ((dsh u M S2)' t) w r = dt u M t w (r ++ S2) $ by dsh_da [l1, l6, l7]
l9: $ G , w ∊ lvals , r ∊ fseq u ⇒ u = u $ by eq_refl
l10: $ G , w ∊ lvals , r ∊ fseq u ⇒ M = M $ by eq_refl
l11: $ G , w ∊ lvals , r ∊ fseq u ⇒ t = t $ by eq_refl
l12: $ G , w ∊ lvals , r ∊ fseq u ⇒ w = w $ by eq_refl
l13: $ G , w ∊ lvals , r ∊ fseq u ⇒ r = r $ by eq_refl
l14: $ G , w ∊ lvals , r ∊ fseq u ⇒ S = S2 $ by weaken [#3]
l15: $ G , w ∊ lvals , r ∊ fseq u ⇒ da ((dsh u M S)' t) w r = da ((dsh u M S2)' t) w r $ by eq_trans [l5, eq_trans [dt_eq [l9, l10, l11, l12, scat_eq [l13, l14]], eq_sym [l8]]]
l16: $ G ⇒ ∀ t ∀ w ∀ r (w ∊ lvals → r ∊ fseq u → da ((dsh u M S)' t) w r = da ((dsh u M S2)' t) w r) $ by all_intro [all_intro [all_intro [imp_intro [imp_intro [l15]]]]]
l17: $ G ⇒ eagv u (dsh u M S) (dsh u M S2) $ by weaken [l16]
l18: $ G ⇒ esat u (dsh u M S) T W = esat u (dsh u M S2) T W $ by esat_agv [#1, l17]

--| @freshen G l
--| @freshen G i
--| @freshen G x
--| @freshen G c
--| @freshen G y
lemma f15_mots_step {l i x c y: set} (G: hyps) (M J J2 L L2 N V: class) (u w td p r c0 tmr tg tm tmj tnl: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ c0 ∊ fseq u $ > $ G ⇒ J ∈ ω $ > $ G ⇒ L ∈ ω $ > $ G ⇒ J2 = suc J $ > $ G ⇒ L2 = suc L $ > $ G ⇒ nadd J2 L = N $ > $ G ⇒ N ∈ ω $ > $ G ⇒ J ∈ N $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ra_capp tmr tg tm ∈ lrel $ > $ G ⇒ tg = ⟨ kc_cons , scons tmj (scons tnl ∅) ⟩ $ > $ G ⇒ tnl = ⟨ kc_nil , ∅ ⟩ $ > $ G ⇒ tmj ∊ trees ω $ > $ G ⇒ dt u M tmj w r = imot u (dnf u M) td J w p V $ > $ G ⇒ ∀ x ∀ c ∀ y (x ∊ u → c = scons x c0 → y = scons x r → esat u (dsh u M y) tmr w = {l | l ∊ fseq u ∧ cdm l = L ∧ ∀ i (i ∊ N → J2 ⊆ i → vat (l ++ c) N i ∈ imot u (dnf u M) td i w p V)}) $ > $ G ⇒ esat u (dsh u M r) tm w = {l | l ∊ fseq u ∧ cdm l = L2 ∧ ∀ i (i ∊ N → J ⊆ i → vat (l ++ c0) N i ∈ imot u (dnf u M) td i w p V)} $
----
l1: $ G ⇒ esat u (dsh u M r) tm w = {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ b = q ++ g)} $ by esat_capp_dsh [#1, #10, #11]
l2: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l3: $ G ⇒ tmr ∊ trees ω ∧ tg ∊ trees ω ∧ tm ∊ trees ω $ by lrel_args3 [#11, wcel_isset [l2]]
l4: $ G ⇒ isset ω $ by omega_set
l5: $ G ⇒ kc_cons ∈ ω $ by kc_cons_omega
l6: $ G ⇒ tmj ∊ trees ω ∧ tnl ∊ trees ω $ by trees_kids2 [l4, wcel_eq_l [#12, welc_wcel [and_elim_l [and_elim_r [l3]]]], wcel_isset [l5]]
l7: $ G , e ∊ esat u (dsh u M r) tm w ⇒ esat u (dsh u M r) tm w = {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ b = q ++ g)} $ by weaken [l1]
l8: $ G , e ∊ esat u (dsh u M r) tm w ⇒ e ∊ esat u (dsh u M r) tm w $ by ax
l9: $ G , e ∊ esat u (dsh u M r) tm w ⇒ e ∊ {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ b = q ++ g)} $ by welc_eq [l7, l8]
l10: $ G , e ∊ esat u (dsh u M r) tm w ⇒ ∃ g ∃ q (g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g) $ by cab_elim [l9]
l11: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g ⇒ g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g $ by ax
l12: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g ⇒ tg = ⟨ kc_cons , scons tmj (scons tnl ∅) ⟩ $ by weaken [#12]
l13: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g ⇒ w = w $ by eq_refl
l14: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g ⇒ g ∊ esat u (dsh u M r) ⟨ kc_cons , scons tmj (scons tnl ∅) ⟩ w $ by welc_eq [esat_eq [l12, l13], and_elim_l [l11]]
l15: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k ∊ esat u (dsh u M r) tnl w $ by ax
l16: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ tnl = ⟨ kc_nil , ∅ ⟩ $ by weaken [#13]
l17: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ w = w $ by eq_refl
l18: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ w ∊ lvals $ by weaken [#1]
l19: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k = ∅ $ by csn_elim [welc_eq [eq_trans [esat_eq [l16, l17], esat_nil [l18]], l15]]
l20: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g $ by ax
l21: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ esat u (dsh u M r) tg w ⊆ fseq u $ by esat_fseq
l22: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g ∊ fseq u $ by subset_elim [l21, and_elim_l [l20]]
l23: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k ∊ esat u (dsh u M r) tnl w $ by ax
l24: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ esat u (dsh u M r) tnl w ⊆ fseq u $ by esat_fseq
l25: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k ∊ fseq u $ by subset_elim [l24, l23]
l26: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g = scons h k $ by ax
l27: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ h ∊ u $ by scons_fseq_hd [wcel_eq_l [l26, welc_wcel [l22]]]
l28: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ r ∊ fseq u $ by weaken [#10]
l29: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ w ∊ lvals $ by weaken [#1]
l30: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ da ((dsh u M r)' tmj) w k = dt u M tmj w (k ++ r) $ by dsh_da [welc_wcel [l28], l29, l25]
l31: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ r = r $ by eq_refl
l32: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ r ∊ fseq u $ by weaken [#10]
l33: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k ++ r = r $ by eq_trans [scat_eq [l19, l31], scat_empty_l [l32]]
l34: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ u = u $ by eq_refl
l35: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ M = M $ by eq_refl
l36: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ tmj = tmj $ by eq_refl
l37: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ dt u M tmj w r = imot u (dnf u M) td J w p V $ by weaken [#15]
l38: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ da ((dsh u M r)' tmj) w k = imot u (dnf u M) td J w p V $ by eq_trans [l30, eq_trans [dt_eq [l34, l35, l36, l17, l33], l37]]
l39: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ h ∊ da ((dsh u M r)' tmj) w k $ by ax
l40: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ h ∊ imot u (dnf u M) td J w p V $ by welc_eq [l38, l39]
l41: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g = scons h k $ by ax
l42: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ h = h $ by eq_refl
l43: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g = scons h ∅ $ by eq_trans [l41, scons_eq [l42, l19]]
