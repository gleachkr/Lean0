--| @freshen G y
lemma f48_tup {y: set} (G: hyps) (D I C T W: class) (n: set): $ G ⇒ n = scons C T $ > $ G ⇒ {y | ¬ iprop D I W ∧ y ∊ n} = itup D I C T W $
----
l1: $ G , ¬ iprop D I W ∧ y ∊ n ⇒ ¬ iprop D I W ∧ y ∊ n $ by ax
l2: $ G , ¬ iprop D I W ∧ y ∊ n ⇒ n = scons C T $ by weaken [#1]
l3: $ G , ¬ iprop D I W ∧ y ∊ n ⇒ ¬ iprop D I W ∧ y ∊ scons C T $ by and_intro [and_elim_l [l1], welc_eq [l2, and_elim_r [l1]]]
l4: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ ¬ iprop D I W ∧ y ∊ scons C T $ by ax
l5: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ n = scons C T $ by weaken [#1]
l6: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ ¬ iprop D I W ∧ y ∊ n $ by and_intro [and_elim_l [l4], welc_eq [eq_sym [l5], and_elim_r [l4]]]
l7: $ G ⇒ ¬ iprop D I W ∧ y ∊ n ↔ ¬ iprop D I W ∧ y ∊ scons C T $ by bi_intro [l3, l6]
l8: $ G ⇒ ∀ y (¬ iprop D I W ∧ y ∊ n ↔ ¬ iprop D I W ∧ y ∊ scons C T) $ by all_intro [l7]
l9: $ G ⇒ {y | ¬ iprop D I W ∧ y ∊ n} = {y | ¬ iprop D I W ∧ y ∊ scons C T} $ by cab_eq [l8]
l10: $ G ⇒ {y | ¬ iprop D I W ∧ y ∊ n} = itup D I C T W $ by weaken [l9]

ity_elem
--------
l1: $ G ⇒ iwf u H J tg td w r0 $ by weaken [#1]
l2: $ G ⇒ uadm u $ by iwf_uadm [l1]
l3: $ G ⇒ w ∊ lvals $ by wcel_welc [iwf_lvals [l1]]
l4: $ G ⇒ td ∈ ofsort lsig lopen ks_ind $ by iwf_sort [l1]
