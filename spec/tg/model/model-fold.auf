l22: $ G ⇒ cdm vc = nvf' vn → vr = vc ++ p ++ rr → esat u (dsh u M vr) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vk ∧ ∀ i (i ∊ nvf' tn → nvf' vn ⊆ i → vat (l ++ vc) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))} $ by imp_elim [l21, #16]
l23: $ G ⇒ vr = vc ++ p ++ rr → esat u (dsh u M vr) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vk ∧ ∀ i (i ∊ nvf' tn → nvf' vn ⊆ i → vat (l ++ vc) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))} $ by imp_elim [l22, #17]
l24: $ G ⇒ esat u (dsh u M vr) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vk ∧ ∀ i (i ∊ nvf' tn → nvf' vn ⊆ i → vat (l ++ vc) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))} $ by imp_elim [l23, #18]

--| @freshen G a
--| @freshen G b
--| @freshen G x
--| @freshen G f
--| @freshen G l
--| @freshen G i
lemma f15_mi_n {a b x f l i: set} (G: hyps) (M: class) (u w td tnp tv tn p rr: set) (ty k1 j1 vn vm vc vr vk vo: set): $ G ⇒ crn j1 ⊆ f15_mi_q M u w td tnp tv tn p rr $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' tnp $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ tv ∊ trees ω $ > $ G ⇒ ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) $ > $ G ⇒ ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) $ > $ G ⇒ ra_motives td tnp tv vn ty vm ∈ lrel $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vn ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ra_ntys ty vk vo ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vk) = nvf' tn $ > $ G ⇒ ∀ a ∀ f ∀ b (ra_nth_ty ty a f b ∈ lrel → ityf td (nadd (nvf' vn) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) $ > $ G ⇒ vc ∊ fseq u $ > $ G ⇒ cdm vc = nvf' vn $ > $ G ⇒ vr = vc ++ p ++ rr $ > $ G ⇒ esat u (dsh u M vr) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vk ∧ ∀ i (i ∊ nvf' tn → nvf' vn ⊆ i → vat (l ++ vc) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))} $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ g ∃ x5 ∃ z ∃ h ∃ t ∃ q ∃ x6 (td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tcons , scons g (scons h (scons t ∅)) ⟩ ∧ vm = x6 ∧ ra_lift x3 ⟨ kc_nz , ∅ ⟩ g x5 ∈ lrel ∧ ra_mty x1 x2 x3 ⟨ kc_nz , ∅ ⟩ x4 x5 z ∈ lrel ∧ ra_motives x1 x2 x4 ⟨ kc_s , scons x3 ∅ ⟩ t q ∈ lrel ∧ ra_capp q ⟨ kc_cons , scons z (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ x6 ∈ lrel) $ by lrel_motives_cases [#13]
l2: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ ⇒ td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ $ by ax
l3: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ ⇒ ra_ntys ty vk vo ∈ lrel $ by weaken [#16]
l4: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ ⇒ (ty = ⟨ kc_tnil , ∅ ⟩ ∧ vk = ⟨ kc_nz , ∅ ⟩ ∧ vo = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ j ∃ m ∃ n ∃ o ∃ k ∃ v (ty = ⟨ kc_tcons , scons e (scons j (scons m ∅)) ⟩ ∧ vk = ⟨ kc_s , scons n ∅ ⟩ ∧ vo = v ∧ ra_ntys m n o ∈ lrel ∧ ra_clen_c j k ∈ lrel ∧ ra_add o k v ∈ lrel) $ by lrel_ntys_cases [l3]
l5: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vk = ⟨ kc_nz , ∅ ⟩ ∧ vo = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vk = ⟨ kc_nz , ∅ ⟩ ∧ vo = ⟨ kc_nz , ∅ ⟩ $ by ax
l6: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vk = ⟨ kc_nz , ∅ ⟩ ∧ vo = ⟨ kc_nz , ∅ ⟩ ⇒ td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ $ by ax
l7: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vk = ⟨ kc_nz , ∅ ⟩ ∧ vo = ⟨ kc_nz , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l8: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vk = ⟨ kc_nz , ∅ ⟩ ∧ vo = ⟨ kc_nz , ∅ ⟩ ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l9: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vk = ⟨ kc_nz , ∅ ⟩ ∧ vo = ⟨ kc_nz , ∅ ⟩ ⇒ nvf' vk = ∅ $ by eq_trans [fv_eq [l7, and_elim_l [and_elim_r [l5]]], l8]
l10: $ G , td = x1 ∧ tnp = x2 ∧ tv = x4 ∧ vn = x3 ∧ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vk = ⟨ kc_nz , ∅ ⟩ ∧ vo = ⟨ kc_nz , ∅ ⟩ ⇒ w = w $ by eq_refl
