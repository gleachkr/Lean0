lemma f21_inv_lift {qi_v qj_v ql_v qf_v qa_v qf2 qa2 qA qb_v qA2 qb2 qe_v qe2: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ > $ H , t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qj_v ∅ ⟩ ∧ ra_le t2 qi_v ∈ lrel ∧ ra_add qi_v t1 qj_v ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩ ⇒ Cf $ > $ H , t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_lift t1 t2 qf_v qf2 ∈ lrel ∧ ra_lift t1 t2 qa_v qa2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift t1 t2 qA qA2 ∈ lrel ∧ ra_lift t1 ⟨ kc_s , scons t2 ∅ ⟩ qb_v qb2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift t1 t2 qA qA2 ∈ lrel ∧ ra_lift t1 ⟨ kc_s , scons t2 ∅ ⟩ qb_v qb2 ∈ lrel ⇒ Cf $ > $ H , t4 = t3 ∧ ra_closed qj_v t3 ∈ lrel ∧ ra_le qj_v t2 ∈ lrel ⇒ Cf $ > $ H , t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_lift t1 t2 qe_v qe2 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel) ∨ ∃ x ∃ y ∃ qi_v ∃ qj_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qj_v ∅ ⟩ ∧ ra_le y qi_v ∈ lrel ∧ ra_add qi_v x qj_v ∈ lrel) ∨ ∃ x ∃ y ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_lift x y qf_v qf2 ∈ lrel ∧ ra_lift x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ qj_v ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v y ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_lift x y qe_v qe2 ∈ lrel) $ by lrel_lift_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel ⇒ ⟨ kc_s , scons qi_v ∅ ⟩ = ⟨ kc_s , scons qi_v ∅ ⟩ $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel ⇒ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t2 ∈ lrel $ by wcel_eq_l [ra_le_eq [l4, eq_sym [and_elim_l [and_elim_r [l3]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel ⇒ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t2 ∈ lrel $ by and_intro [and_elim_l [and_elim_r [and_elim_r [l3]]], and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]], l5]]
l7: $ H ⇒ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t2 ∈ lrel → Cf $ by imp_intro [#2]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel ⇒ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t2 ∈ lrel → Cf $ by weaken [l7]
l9: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel ⇒ Cf $ by imp_elim [l8, l6]
l10: $ G , H , ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel) ⇒ ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel) $ by ax
