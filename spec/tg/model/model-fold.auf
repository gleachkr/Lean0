l36: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel ⇒ x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel $ by ax
l37: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel ⇒ ⟨ kc_pi , scons ta (scons tb ∅) ⟩ = ⟨ kc_pi , scons v (scons w ∅) ⟩ $ by eq_trans [eq_sym [weaken [l1]], and_elim_l [l36]]
l38: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l39: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel ⇒ ta = v ∧ tb = w $ by node2_inj [wcel_isset [l38], l37]
l40: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel ⇒ tx = tx $ by eq_refl
l41: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel ⇒ ⟨ kc_s , scons tx ∅ ⟩ = ⟨ kc_s , scons tx ∅ ⟩ $ by eq_refl
l42: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by and_intro [wcel_eq_l [ra_closed_eq [l40, eq_sym [and_elim_l [l39]]], and_elim_l [and_elim_r [l36]]], wcel_eq_l [ra_closed_eq [l41, eq_sym [and_elim_r [l39]]], and_elim_r [and_elim_r [l36]]]]
l43: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ $ by ax
l44: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ ⟨ kc_pi , scons ta (scons tb ∅) ⟩ = ⟨ kc_cst , scons u (scons a ∅) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l43]
l45: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ kc_pi ∈ ω $ by kc_pi_omega
l46: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ kc_cst ∈ ω $ by kc_cst_omega
l47: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ kc_pi = kc_cst $ by opair_inj_l_c [l44, wcel_isset [l45], wcel_isset [l46]]
l48: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ ¬ kc_pi = kc_cst $ by kc_pi_ne_cst
l49: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by bot_elim [not_elim [l48, l47]]
l50: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ x1 = ⟨ kc_lit , scons b ∅ ⟩ $ by ax
l51: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ ⟨ kc_pi , scons ta (scons tb ∅) ⟩ = ⟨ kc_lit , scons b ∅ ⟩ $ by eq_trans [eq_sym [weaken [l1]], l50]
l52: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ kc_pi ∈ ω $ by kc_pi_omega
l53: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ kc_lit ∈ ω $ by kc_lit_omega
l54: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ kc_pi = kc_lit $ by opair_inj_l_c [l51, wcel_isset [l52], wcel_isset [l53]]
l55: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ ¬ kc_pi = kc_lit $ by kc_pi_ne_lit
l56: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by bot_elim [not_elim [l55, l54]]
l57: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ $ by ax
l58: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ ⟨ kc_pi , scons ta (scons tb ∅) ⟩ = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l57]
l59: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ kc_pi ∈ ω $ by kc_pi_omega
l60: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ kc_ind_ty ∈ ω $ by kc_ind_ty_omega
l61: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ kc_pi = kc_ind_ty $ by opair_inj_l_c [l58, wcel_isset [l59], wcel_isset [l60]]
l62: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ ¬ kc_pi = kc_ind_ty $ by kc_pi_ne_ind_ty
l63: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by bot_elim [not_elim [l62, l61]]
l64: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ $ by ax
l65: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ⟨ kc_pi , scons ta (scons tb ∅) ⟩ = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l64]
l66: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_pi ∈ ω $ by kc_pi_omega
l67: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_ind_ctor ∈ ω $ by kc_ind_ctor_omega
l68: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_pi = kc_ind_ctor $ by opair_inj_l_c [l65, wcel_isset [l66], wcel_isset [l67]]
l69: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ¬ kc_pi = kc_ind_ctor $ by kc_pi_ne_ind_ctor
l70: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by bot_elim [not_elim [l69, l68]]
l71: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ $ by ax
l72: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ⟨ kc_pi , scons ta (scons tb ∅) ⟩ = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l71]
l73: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_pi ∈ ω $ by kc_pi_omega
l74: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_ind_rec ∈ ω $ by kc_ind_rec_omega
l75: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_pi = kc_ind_rec $ by opair_inj_l_c [l72, wcel_isset [l73], wcel_isset [l74]]
l76: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ¬ kc_pi = kc_ind_rec $ by kc_pi_ne_ind_rec
l77: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by bot_elim [not_elim [l76, l75]]
l78: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel $ by ax
l79: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ⟨ kc_pi , scons ta (scons tb ∅) ⟩ = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], and_elim_l [l78]]
l80: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l81: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_proj ∈ ω $ by kc_proj_omega
l82: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_pi = kc_proj $ by opair_inj_l_c [l79, wcel_isset [l80], wcel_isset [l81]]
l83: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ¬ kc_pi = kc_proj $ by kc_pi_ne_proj
l84: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by bot_elim [not_elim [l83, l82]]
l113: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by f21_inv_closed [l3, l11, l19, l27, l35, l42, l49, l56, l63, l70, l77, l84]
l114: $ G ⇒ isset ⟨ kc_pi , scons ta (scons tb ∅) ⟩ $ by opair_isset
l115: $ G ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $ by isset_elim [l114, l113]

--| @freshen H qi_v
--| @freshen H qf_v
--| @freshen H qa_v
--| @freshen H qA
--| @freshen H qB
--| @freshen H qn_v
lemma f21_inv_npis {qi_v qf_v qa_v qA qB qn_v: set} (G H: hyps) (Cf: fml) (t1 t2: set): $ G ⇒ ra_npis t1 t2 ∈ lrel $ > $ H , t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_npis qB qn_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_npis t1 t2 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ qi_v (t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ qf_v ∃ qa_v (t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ qA ∃ qB ∃ qn_v (t1 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_npis qB qn_v ∈ lrel) $ by lrel_npis_cases [l1]
l3: $ G , H , t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l4: $ G , H , t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [and_elim_l [l3], and_elim_r [l3]]
l5: $ H ⇒ t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l6: $ G , H , t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l5]
l7: $ G , H , t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ by imp_elim [l6, l4]
l8: $ G , H , ∃ qi_v (t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ qi_v (t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l9: $ … ⇒ Cf $ by ex_elim [l8, l7]
l10: $ G , H ⇒ (∃ qi_v (t1 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩)) → Cf $ by imp_intro [l9]
l11: $ G , H , t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l12: $ G , H , t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [and_elim_l [l11], and_elim_r [l11]]
l13: $ H ⇒ t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#3]
l14: $ G , H , t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l13]
l15: $ G , H , t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ by imp_elim [l14, l12]
l16: $ G , H , ∃ qa_v (t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ qa_v (t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l17: $ … ⇒ Cf $ by ex_elim [l16, l15]
l18: $ G , H , ∃ qf_v ∃ qa_v (t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ qf_v ∃ qa_v (t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l19: $ … ⇒ Cf $ by ex_elim [l18, l17]
l20: $ G , H ⇒ (∃ qf_v ∃ qa_v (t1 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩)) → Cf $ by imp_intro [l19]
l21: $ G , H , t1 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_npis qB qn_v ∈ lrel ⇒ t1 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_npis qB qn_v ∈ lrel $ by ax
