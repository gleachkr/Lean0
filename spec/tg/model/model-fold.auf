def f46_lc_q  (.y .x .r: set): class = $ {y | ∀ x ∀ r (ra_lams y x r ∈ lrel → r ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx)} $

lemma f46_lc_e (G: hyps)  (ty vx vr: set): $ G ⇒ ty ∊ f46_lc_q  $ > $ G ⇒ ra_lams ty vx vr ∈ lrel $ > $ G ⇒ vr ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G ⇒ ∀ x ∀ r (ra_lams ty x r ∈ lrel → r ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_ctx) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r (ra_lams ty vx r ∈ lrel → r ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_ctx) $ by all_elim [l1]
l3: $ G ⇒ ra_lams ty vx vr ∈ lrel → vr ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_ctx $ by all_elim [l2]
l4: $ G ⇒ vr ∊ ofsort lsig lopen ks_expr → ty ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l3, #2]
l5: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l4, #3]

lemma f46_lc_n (G: hyps)  (ty k1 j1 vx vr: set): $ G ⇒ crn j1 ⊆ f46_lc_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_lams ty vx vr ∈ lrel $ > $ G ⇒ vr ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx $ by ax
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l1]
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ vr = vx $ by and_elim_r [l1]
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ⟨ kc_nil , ∅ ⟩ ∈ ofsort lsig lopen ks_ctx $ by ofsort_ctx_nil
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [l2], l4]]
l6: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel $ by ax
l7: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ by and_elim_l [l6]
l8: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel $ by and_elim_r [l6]
l9: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ isset ∅ $ by ax_empty
l10: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ isset (scons p ∅) $ by scons_set [l9]
l11: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ isset (scons a (scons p ∅)) $ by scons_set [l10]
l12: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ crn j1 ⊆ f46_lc_q  $ by weaken [#1]
l13: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l14: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l15: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ crn (scons a (scons p ∅)) ⊆ f46_lc_q  $ by node_crn_sub [l12, l13, l7, wcel_isset [l14], l11]
l16: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ crn (scons p ∅) ⊆ f46_lc_q  $ by crn_scons_tail [l15]
l17: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ isset p $ by isset_var
l18: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ p ∈ f46_lc_q  $ by crn_scons_head [l17, l16]
l19: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ vr ∊ ofsort lsig lopen ks_expr $ by weaken [#6]
l20: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ $ by ax
l21: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel $ by weaken [l8]
l22: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ p = p $ by eq_refl
l23: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ vr = vr $ by eq_refl
l24: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ ra_lams p x5 vr ∈ lrel $ by wcel_eq_l [ra_lams_eq [l22, eq_sym [l20], l23], l21]
l25: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ p ∈ f46_lc_q  $ by weaken [l18]
l26: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ vr ∊ ofsort lsig lopen ks_expr $ by weaken [l19]
l27: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ p ∊ ofsort lsig lopen ks_ctx $ by f46_lc_e [wcel_welc [l25], l24, l26]
l28: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ vr ∊ ofsort lsig lopen ks_expr $ by weaken [l19]
l29: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ x5 ∊ ofsort lsig lopen ks_expr $ by lams_sort [l24, l28]
l30: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ a ∊ ofsort lsig lopen ks_expr ∧ vx ∊ ofsort lsig lopen ks_expr $ by ofsort_lam_kids [wcel_eq_l [l20, welc_wcel [l29]]]
l31: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ by weaken [l7]
l32: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel , x5 = ⟨ kc_lam , scons a (scons vx ∅) ⟩ ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [l31], ofsort_ctx_cons [welc_wcel [and_elim_l [l30]], welc_wcel [l27]]]]
l33: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ isset ⟨ kc_lam , scons a (scons vx ∅) ⟩ $ by opair_isset
l34: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_lams p ⟨ kc_lam , scons a (scons vx ∅) ⟩ vr ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by isset_elim [l33, l32]
l35: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by f21_inv_lams [#5, l5, l34]

lemma f46_lc_all (G: hyps) : $ G ⇒ trees ω ⊆ f46_lc_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ , ra_lams y x r ∈ lrel , r ∊ ofsort lsig lopen ks_expr ⇒ crn x9 ⊆ f46_lc_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ , ra_lams y x r ∈ lrel , r ∊ ofsort lsig lopen ks_expr ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ , ra_lams y x r ∈ lrel , r ∊ ofsort lsig lopen ks_expr ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ , ra_lams y x r ∈ lrel , r ∊ ofsort lsig lopen ks_expr ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ , ra_lams y x r ∈ lrel , r ∊ ofsort lsig lopen ks_expr ⇒ ra_lams y x r ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ , ra_lams y x r ∈ lrel , r ∊ ofsort lsig lopen ks_expr ⇒ r ∊ ofsort lsig lopen ks_expr $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ , ra_lams y x r ∈ lrel , r ∊ ofsort lsig lopen ks_expr ⇒ y ∊ ofsort lsig lopen ks_ctx $ by f46_lc_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ , ra_lams y x r ∈ lrel ⇒ r ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_lams y x r ∈ lrel → r ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ r (ra_lams y x r ∈ lrel → r ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ x ∀ r (ra_lams y x r ∈ lrel → r ∊ ofsort lsig lopen ks_expr → y ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f46_lc_q  $ by cab_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f46_lc_q  $ by wcel_intro [l13, l12]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f46_lc_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f46_lc_q  $ by isset_elim [l15, l14]
l17: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f46_lc_q  → ⟨ x8 , x9 ⟩ ∈ f46_lc_q  $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f46_lc_q  → ⟨ x8 , x9 ⟩ ∈ f46_lc_q ) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ f46_lc_q  $ by trees_ind_c [l19, l18]

lams_ctx
--------
l1: $ G ⇒ trees ω ⊆ f46_lc_q  $ by f46_lc_all
l2: $ G ⇒ ⟨ kr_lams , scons tP (scons tX (scons tR ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons tR ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tX (scons tR ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons tP (scons tX (scons tR ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_lams ∈ ω $ by kr_lams_omega
l8: $ G ⇒ kr_lams ∈ ω ∧ scons tP (scons tX (scons tR ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons tP (scons tX (scons tR ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ tP ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ tP ∊ f46_lc_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ tP ∊ ofsort lsig lopen ks_ctx $ by f46_lc_e [l12, #1, #2]

nidx_isort
----------
l1: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel $ by ax
l2: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ra_ind_data td x1 x2 x3 ∈ lrel $ by and_elim_l [l1]
l3: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ra_nth_ty x3 ti x4 x5 ∈ lrel $ by and_elim_l [and_elim_r [l1]]
l4: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ra_isort x4 tni x6 ∈ lrel $ by and_elim_r [and_elim_r [l1]]
l5: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ra_ind_data td tb tp tt ∈ lrel $ by weaken [#1]
l6: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ x1 = tb ∧ x2 = tp ∧ x3 = tt $ by lrel_ind_data_det [l2, l5]
l7: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ti = ti $ by eq_refl
l8: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ x4 = x4 $ by eq_refl
l9: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ x5 = x5 $ by eq_refl
l10: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ra_nth_ty tt ti x4 x5 ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [and_elim_r [and_elim_r [l6]], l7, l8, l9], l3]
l11: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ by weaken [#2]
l12: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ x4 = tF ∧ x5 = tE $ by lrel_nth_ty_det [l10, l11]
l13: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ tni = tni $ by eq_refl
l14: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ x6 = x6 $ by eq_refl
l15: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ra_isort tF tni x6 ∈ lrel $ by wcel_eq_l [ra_isort_eq [and_elim_l [l12], l13, l14], l4]
l16: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 ti x4 x5 ∈ lrel ∧ ra_isort x4 tni x6 ∈ lrel ⇒ ∃ l (ra_isort tF tni l ∈ lrel) $ by ex_intro [l15]
l17: $ G ⇒ ∃ l (ra_isort tF tni l ∈ lrel) $ by f21_inv_nidx [#3, l16]

--| @freshen H qb_v
--| @freshen H qP
--| @freshen H qT
--| @freshen H qF
--| @freshen H qK
--| @freshen H qC
lemma f21_inv_nfields {qb_v qP qT qF qK qC: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_nfields t1 t2 t3 t4 ∈ lrel $ > $ H , ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF qC ∈ lrel ∧ ra_nth_ctor qC t3 qK ∈ lrel ∧ ra_npis qK t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_nfields t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ u ∃ qF ∃ qK ∃ qC (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_npis qK u ∈ lrel) $ by lrel_nfields_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_npis qK u ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_npis qK u ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_npis qK u ∈ lrel ⇒ qb_v = qb_v $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_npis qK u ∈ lrel ⇒ qP = qP $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_npis qK u ∈ lrel ⇒ qT = qT $ by eq_refl
