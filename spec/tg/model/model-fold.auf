def f9_ha_q (M: class) (u w r1 r2 t2: set) (.y .o .n .a .b .c .d .e .f .x0: set): class = $ {y | ∀ o ∀ n ∀ a ∀ b ∀ c ∀ d ∀ e ∀ f (w ∊ lvals → r1 ∊ fseq u → r2 ∊ fseq u → ra_has_arg y t2 ∈ lrel → ⟨ a , ⟨ b , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w r1 → ⟨ d , ⟨ e , ⟨ f , n ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w r2 → ∀ x0 (o' x0 = n' x0) → dt u M t2 w r1 = dt u M t2 w r2)} $

--| @freshen G x0
lemma f9_ha_e {x0: set} (G: hyps) (M: class) (u w r1 r2 t2: set) (ty vo vn va vb vc vd ve vf: set): $ G ⇒ ty ∊ f9_ha_q M u w r1 r2 t2 $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r1 ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ > $ G ⇒ ra_has_arg ty t2 ∈ lrel $ > $ G ⇒ ⟨ va , ⟨ vb , ⟨ vc , vo ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r1 $ > $ G ⇒ ⟨ vd , ⟨ ve , ⟨ vf , vn ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r2 $ > $ G ⇒ ∀ x0 (vo' x0 = vn' x0) $ > $ G ⇒ dt u M t2 w r1 = dt u M t2 w r2 $
----
