l37: $ G , a ∊ dt u M ta w r ⇒ fpi s {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} (ap (T) (ssnoc s a)) ⊆ fpi s (mpth u (dnf u M) tb w (scons a r) (Y2)) (ap (T2) s) $ by fpi_sub [eq_sym [l17], l36]
al0: $ fpi s {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} (ap (T) (ssnoc s a)) ≐ fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} (ap (T) (ssnoc q a)) $ by fpi_alpha
l38: $ G , a ∊ dt u M ta w r ⇒ fpi s {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} (ap (T) (ssnoc s a)) = fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} (ap (T) (ssnoc q a)) $ by weaken [al0]
l39: $ G , a ∊ dt u M ta w r ⇒ dt u M tm w (scons a r) = fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} (ap (T) (ssnoc q a)) $ by eq_trans [l8, eq_trans [subset_antisym [l28, l37], l38]]
l40: $ G ⇒ ∀ a (a ∊ dt u M ta w r → dt u M tm w (scons a r) = fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} (ap (T) (ssnoc q a))) $ by all_intro [imp_intro [l39]]
l41: $ G ⇒ dt u M ⟨ kc_pi , scons ta (scons tm ∅) ⟩ w r = cpi a (dt u M ta w r) (dt u M tm w (scons a r)) $ by dt_pi [lsig_ofsort_trees [#1], welc_wcel [#3], #4, #5]
l42: $ G ⇒ dt u M ta w r = dt u M ta w r $ by eq_refl
l43: $ G ⇒ cpi a (dt u M ta w r) (dt u M tm w (scons a r)) = cpi a (dt u M ta w r) (fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} (ap (T) (ssnoc q a))) $ by cpi_eq_pt [l42, l40]
