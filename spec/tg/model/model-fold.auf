--| @freshen G c
--| @freshen G z
lemma f17_iw_n {c z: set} (G: hyps) (M K N: class) (u w v0 td tnp tn tmo tfld tj n0: set) (ty k1 j1 vd vm ve vr: set): $ G ⇒ crn j1 ⊆ f17_iw_q M K N u w v0 td tnp tn tmo tfld tj n0 $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ v0 ∊ fseq u $ > $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ > $ G ⇒ n0 ∊ trees ω $ > $ G ⇒ v0' nvf' tfld ∈ u $ > $ G ⇒ K ∈ ω $ > $ G ⇒ nadd (suc K) (nvf' tj) = nvf' tn $ > $ G ⇒ ∀ c (ra_nidx td tj c ∈ lrel → nvf' c = N) $ > $ G ⇒ ra_ihty td tnp tn tmo tfld vd tj ty vm ∈ lrel $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ve ∊ fseq u $ > $ G ⇒ cdm ve = nvf' vd $ > $ G ⇒ vr = ve ++ v0 $ > $ G ⇒ dt u M vm w vr = fpi z (tpth (etel u (dnf u M) ty w vr)) (ap (ihtb u (etel u (dnf u M) ty w vr) (v0' (nadd (nvf' tmo) K)) (v0' nvf' tfld) ve (N)) z) $
