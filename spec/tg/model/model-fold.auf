l200: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} ⇒ l ∊ esat u (dsh u M s) vt w $ by ex_elim [l135, l199]
l201: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by eq_intro [l133, l200]
l202: $ G , ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) ⇒ ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) $ by ax
l203: $ … ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by ex_elim [l202, l201]
l204: $ G , ∃ k ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) ⇒ ∃ k ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) $ by ax
l205: $ … ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by ex_elim [l204, l203]
l206: $ G , ∃ p ∃ k ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) ⇒ ∃ p ∃ k ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) $ by ax
l207: $ … ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by ex_elim [l206, l205]
l208: $ G , ∃ a ∃ p ∃ k ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) ⇒ ∃ a ∃ p ∃ k ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel) $ by ax
l209: $ … ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by ex_elim [l208, l207]
l210: $ G ⇒ esat u (dsh u M s) vt w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} $ by or_elim [l1, l45, l209]

lemma f14_ec_all (G: hyps) (M: class) (u w s: set): $ G ⇒ trees ω ⊆ f14_ec_q M u w s $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , ra_capp y b t ∈ lrel ⇒ crn j ⊆ f14_ec_q M u w s $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , ra_capp y b t ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , ra_capp y b t ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , ra_capp y b t ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , ra_capp y b t ∈ lrel ⇒ w ∊ lvals $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , ra_capp y b t ∈ lrel ⇒ s ∊ fseq u $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , ra_capp y b t ∈ lrel ⇒ ra_capp y b t ∈ lrel $ by ax
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , ra_capp y b t ∈ lrel ⇒ esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) b w ∧ q ∊ esat u (dsh u M (g ++ s)) y w ∧ x = q ++ g)} $ by f14_ec_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u ⇒ ra_capp y b t ∈ lrel → esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) b w ∧ q ∊ esat u (dsh u M (g ++ s)) y w ∧ x = q ++ g)} $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ , w ∊ lvals ⇒ s ∊ fseq u → ra_capp y b t ∈ lrel → esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) b w ∧ q ∊ esat u (dsh u M (g ++ s)) y w ∧ x = q ++ g)} $ by imp_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ ⇒ w ∊ lvals → s ∊ fseq u → ra_capp y b t ∈ lrel → esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) b w ∧ q ∊ esat u (dsh u M (g ++ s)) y w ∧ x = q ++ g)} $ by imp_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ ⇒ ∀ t (w ∊ lvals → s ∊ fseq u → ra_capp y b t ∈ lrel → esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) b w ∧ q ∊ esat u (dsh u M (g ++ s)) y w ∧ x = q ++ g)}) $ by all_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ ⇒ ∀ b ∀ t (w ∊ lvals → s ∊ fseq u → ra_capp y b t ∈ lrel → esat u (dsh u M s) t w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) b w ∧ q ∊ esat u (dsh u M (g ++ s)) y w ∧ x = q ++ g)}) $ by all_intro [l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ ⇒ y ∊ f14_ec_q M u w s $ by cab_intro [l13]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f14_ec_q M u w s $ by wcel_intro [l15, l14]
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l18: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f14_ec_q M u w s ⇒ ⟨ i , j ⟩ ∈ f14_ec_q M u w s $ by isset_elim [l17, l16]
l19: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f14_ec_q M u w s → ⟨ i , j ⟩ ∈ f14_ec_q M u w s $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f14_ec_q M u w s → ⟨ i , j ⟩ ∈ f14_ec_q M u w s) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ f14_ec_q M u w s $ by trees_ind_c [l21, l20]

esat_capp_dsh
-------------
l1: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l2: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#3, wcel_isset [l1]]
l3: $ G ⇒ trees ω ⊆ f14_ec_q M u w s $ by f14_ec_all
l4: $ G ⇒ t1 ∊ f14_ec_q M u w s $ by subset_elim [l3, and_elim_l [l2]]
l5: $ G ⇒ esat u (dsh u M s) t3 w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) t2 w ∧ q ∊ esat u (dsh u M (g ++ s)) t1 w ∧ x = q ++ g)} $ by f14_ec_e [l4, #1, #2, #3]

mpth_fseq
---------
l1: $ G , l ∊ mpth u E K w R (Y) ⇒ l ∊ mpth u E K w R (Y) $ by ax
l2: $ G , l ∊ mpth u E K w R (Y) ⇒ ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) $ by cab_elim [l1]
l3: $ G , l ∊ mpth u E K w R (Y) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c ⇒ ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c $ by ax
l4: $ G , l ∊ mpth u E K w R (Y) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ n (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l3]
l5: $ G , l ∊ mpth u E K w R (Y) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ k ∃ n (⟨ c , ⟨ d , ⟨ h , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l4]
l6: $ G , l ∊ mpth u E K w R (Y) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ j ∃ k ∃ n (⟨ c , ⟨ d , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l5]
l7: $ G , l ∊ mpth u E K w R (Y) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ i ∃ j ∃ k ∃ n (⟨ c , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l6]
l8: $ G , l ∊ mpth u E K w R (Y) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ex_intro [l7]
l9: $ G , l ∊ mpth u E K w R (Y) , ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) ⇒ ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) $ by ax
l10: $ … ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l9, l8]
l11: $ G , l ∊ mpth u E K w R (Y) , ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) ⇒ ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) $ by ax
l12: $ … ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l11, l10]
l13: $ G , l ∊ mpth u E K w R (Y) , ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) ⇒ ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) $ by ax
l14: $ … ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l13, l12]
l15: $ G , l ∊ mpth u E K w R (Y) , ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) ⇒ ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ m ∊ ap (Y) c ∧ m ∊ u ∧ l = scons m c) $ by ax
l16: $ … ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l15, l14]
l17: $ G , l ∊ mpth u E K w R (Y) ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l2, l16]
l18: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e ⇒ ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e $ by ax
l19: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e , p = R ⇒ K = K $ by eq_refl
l20: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e , p = R ⇒ w = w $ by eq_refl
l21: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e , p = R ⇒ p = R $ by ax
l22: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e , p = R ⇒ ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w p $ by wcel_eq_r [etel_eq [l19, l20, eq_sym [l21]], weaken [and_elim_l [l18]]]
l23: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e , p = R ⇒ K ∈ trees ω $ by weaken [#1]
l24: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e , p = R ⇒ e ∊ fseq u $ by and_elim_l [etel_fseq [l23, l22]]
l25: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e ⇒ isset R $ by weaken [#2]
l26: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e ⇒ e ∊ fseq u $ by isset_elim [l25, l24]
l27: $ G , l ∊ mpth u E K w R (Y) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e ⇒ l ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [and_elim_r [and_elim_r [and_elim_r [l18]]]], scons_fseq [and_elim_l [and_elim_r [and_elim_r [l18]]], l26]]]
l28: $ G , l ∊ mpth u E K w R (Y) , ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) ⇒ ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ax
l29: $ … ⇒ l ∊ fseq u $ by ex_elim [l28, l27]
l30: $ G , l ∊ mpth u E K w R (Y) , ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) ⇒ ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ax
l31: $ … ⇒ l ∊ fseq u $ by ex_elim [l30, l29]
l32: $ G , l ∊ mpth u E K w R (Y) , ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) ⇒ ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u E K w R ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ax
l33: $ … ⇒ l ∊ fseq u $ by ex_elim [l32, l31]
