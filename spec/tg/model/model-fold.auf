l28: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ ra_capp ty tg tg ∈ lrel ∧ ra_clen tg tb ∈ lrel ∧ ra_add tb va tb ∈ lrel $ by and_intro [l24, and_intro [l2, l27]]
l29: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ c (ra_capp ty tg tg ∈ lrel ∧ ra_clen tg c ∈ lrel ∧ ra_add tb va c ∈ lrel) $ by ex_intro [l28]
l30: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ r ∃ c (ra_capp ty tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb va c ∈ lrel) $ by ex_intro [l29]
l31: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ va = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ va = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel $ by ax
l32: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ va = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ra_clen tg tb ∈ lrel $ by weaken [#5]
l33: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ va = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ⟨ kr_clen , scons tg (scons tb ∅) ⟩ ∈ latoms $ by lrel_latoms [l32]
