--| @freshen H qF
--| @freshen H qC
--| @freshen H qT
--| @freshen H qn_v
--| @freshen H qm_v
--| @freshen H qc_v
lemma f21_inv_ntys {qF qC qT qn_v qm_v qc_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_ntys t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v t3 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_ntys t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ qF ∃ qC ∃ qT ∃ qn_v ∃ qm_v ∃ qc_v ∃ x (t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel) $ by lrel_ntys_cases [l1]
l3: $ G , H , t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l4: $ G , H , t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [and_elim_l [l3], and_intro [and_elim_l [and_elim_r [l3]], and_elim_r [and_elim_r [l3]]]]
l5: $ H ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l6: $ G , H , t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l5]
l7: $ G , H , t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ by imp_elim [l6, l4]
l8: $ G , H ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) → Cf $ by imp_intro [l7]
l9: $ G , H , t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel ⇒ t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel $ by ax
l10: $ G , H , t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel ⇒ qm_v = qm_v $ by eq_refl
l11: $ G , H , t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel ⇒ qc_v = qc_v $ by eq_refl
l12: $ G , H , t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel ⇒ ra_add qm_v qc_v t3 ∈ lrel $ by wcel_eq_l [ra_add_eq [l10, l11, eq_sym [and_elim_l [and_elim_r [and_elim_r [l9]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l9]]]]]]
l13: $ G , H , t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel ⇒ t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v t3 ∈ lrel $ by and_intro [and_elim_l [l9], and_intro [and_elim_l [and_elim_r [l9]], and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l9]]]], and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l9]]]]], l12]]]]
l14: $ H ⇒ t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v t3 ∈ lrel → Cf $ by imp_intro [#3]
l15: $ G , H , t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel ⇒ t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v t3 ∈ lrel → Cf $ by weaken [l14]
