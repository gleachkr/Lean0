l231: $ G ⇒ (∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $ by or_elim_imp [l73, l230]
l232: $ G ⇒ (∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $ by or_elim_imp [l58, l231]
l233: $ G ⇒ (∃ y ∃ v ∃ w (k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $ by or_elim_imp [l43, l232]
l234: $ G ⇒ (∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) ∨ ∃ y ∃ v ∃ w (k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $ by or_elim_imp [l28, l233]
l235: $ G ⇒ (∃ x ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) ∨ ∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) ∨ ∃ y ∃ v ∃ w (k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $ by or_elim_imp [l15, l234]
l236: $ G ⇒ ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $ by imp_elim [l235, l1]

def f18_cs_q (k h: set) (.y .n: set): class = $ {y | ∀ n (ra_closed k y ∈ lrel → ra_spine h y n ∈ lrel → ra_closed k h ∈ lrel)} $

lemma f18_cs_e (G: hyps) (k h: set) (ty vn: set): $ G ⇒ ty ∊ f18_cs_q k h $ > $ G ⇒ ra_closed k ty ∈ lrel $ > $ G ⇒ ra_spine h ty vn ∈ lrel $ > $ G ⇒ ra_closed k h ∈ lrel $
----
l1: $ G ⇒ ∀ n (ra_closed k ty ∈ lrel → ra_spine h ty n ∈ lrel → ra_closed k h ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ra_closed k ty ∈ lrel → ra_spine h ty vn ∈ lrel → ra_closed k h ∈ lrel $ by all_elim [l1]
l3: $ G ⇒ ra_spine h ty vn ∈ lrel → ra_closed k h ∈ lrel $ by imp_elim [l2, #2]
l4: $ G ⇒ ra_closed k h ∈ lrel $ by imp_elim [l3, #3]

lemma f18_cs_n (G: hyps) (k h: set) (ty k1 j1 vn: set): $ G ⇒ crn j1 ⊆ f18_cs_q k h $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_closed k ty ∈ lrel $ > $ G ⇒ ra_spine h ty vn ∈ lrel $ > $ G ⇒ ra_closed k h ∈ lrel $
----
l1: $ G ⇒ ∃ x (h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x ∃ z ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) $ by lrel_spine_cases [#6]
l2: $ G , h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ G , h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ k = k $ by eq_refl
l4: $ G , h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed k h ∈ lrel $ by wcel_eq_l [ra_closed_eq [l3, eq_trans [and_elim_l [and_elim_r [l2]], eq_sym [and_elim_l [l2]]]], weaken [#5]]
l5: $ G , ∃ x (h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ x (h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩) $ by ax
l6: $ … ⇒ ra_closed k h ∈ lrel $ by ex_elim [l5, l4]
l7: $ G ⇒ (∃ x (h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩)) → ra_closed k h ∈ lrel $ by imp_intro [l6]
l8: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel $ by ax
l9: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l10: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ isset ∅ $ by ax_empty
l11: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ crn (scons z (scons u ∅)) ⊆ f18_cs_q k h $ by node_crn_sub [weaken [#1], weaken [#2], and_elim_l [and_elim_r [l8]], wcel_isset [l9], scons_set [scons_set [l10]]]
l12: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ isset z $ by isset_var
l13: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ z ∈ f18_cs_q k h $ by crn_scons_head [l12, l11]
l14: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ ra_closed k z ∈ lrel $ by f18_closed_app [weaken [#5], and_elim_l [and_elim_r [l8]]]
l15: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ z = z $ by eq_refl
l16: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ v = v $ by eq_refl
l17: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ ra_spine h z v ∈ lrel $ by wcel_eq_l [ra_spine_eq [eq_sym [and_elim_l [l8]], l15, l16], and_elim_r [and_elim_r [and_elim_r [l8]]]]
l18: $ G , h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel ⇒ ra_closed k h ∈ lrel $ by f18_cs_e [wcel_welc [l13], l14, l17]
l19: $ G , ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) ⇒ ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) $ by ax
l20: $ … ⇒ ra_closed k h ∈ lrel $ by ex_elim [l19, l18]
l21: $ G , ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) ⇒ ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) $ by ax
l22: $ … ⇒ ra_closed k h ∈ lrel $ by ex_elim [l21, l20]
l23: $ G , ∃ z ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) ⇒ ∃ z ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) $ by ax
l24: $ … ⇒ ra_closed k h ∈ lrel $ by ex_elim [l23, l22]
l25: $ G , ∃ x ∃ z ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) ⇒ ∃ x ∃ z ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel) $ by ax
l26: $ … ⇒ ra_closed k h ∈ lrel $ by ex_elim [l25, l24]
l27: $ G ⇒ (∃ x ∃ z ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel)) → ra_closed k h ∈ lrel $ by imp_intro [l26]
l28: $ G ⇒ (∃ x (h = x ∧ ty = x ∧ vn = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x ∃ z ∃ u ∃ v (h = x ∧ ty = ⟨ kc_app , scons z (scons u ∅) ⟩ ∧ vn = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_spine x z v ∈ lrel)) → ra_closed k h ∈ lrel $ by or_elim_imp [l7, l27]
l29: $ G ⇒ ra_closed k h ∈ lrel $ by imp_elim [l28, l1]

lemma f18_cs_all (G: hyps) (k h: set): $ G ⇒ trees ω ⊆ f18_cs_q k h $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_spine h y n ∈ lrel ⇒ crn j ⊆ f18_cs_q k h $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_spine h y n ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_spine h y n ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_spine h y n ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_spine h y n ∈ lrel ⇒ ra_closed k y ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_spine h y n ∈ lrel ⇒ ra_spine h y n ∈ lrel $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_spine h y n ∈ lrel ⇒ ra_closed k h ∈ lrel $ by f18_cs_n [l1, l2, l3, l4, l5, l6]
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel ⇒ ra_spine h y n ∈ lrel → ra_closed k h ∈ lrel $ by imp_intro [l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ ⇒ ra_closed k y ∈ lrel → ra_spine h y n ∈ lrel → ra_closed k h ∈ lrel $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ ⇒ ∀ n (ra_closed k y ∈ lrel → ra_spine h y n ∈ lrel → ra_closed k h ∈ lrel) $ by all_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ ⇒ y ∊ f18_cs_q k h $ by cab_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f18_cs_q k h $ by wcel_intro [l12, l11]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cs_q k h ⇒ ⟨ i , j ⟩ ∈ f18_cs_q k h $ by isset_elim [l14, l13]
l16: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f18_cs_q k h → ⟨ i , j ⟩ ∈ f18_cs_q k h $ by imp_intro [imp_intro [imp_intro [l15]]]
l17: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f18_cs_q k h → ⟨ i , j ⟩ ∈ f18_cs_q k h) $ by all_intro [all_intro [l16]]
l18: $ G ⇒ isset ω $ by omega_set
l19: $ G ⇒ trees ω ⊆ f18_cs_q k h $ by trees_ind_c [l18, l17]

lemma f18_closed_spine (G: hyps) (k h e n: set): $ G ⇒ ra_closed k e ∈ lrel $ > $ G ⇒ ra_spine h e n ∈ lrel $ > $ G ⇒ ra_closed k h ∈ lrel $
----
l1: $ G ⇒ trees ω ⊆ f18_cs_q k h $ by f18_cs_all
l2: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
l3: $ G ⇒ k ∊ trees ω ∧ e ∊ trees ω $ by lrel_args2 [#1, wcel_isset [l2]]
l4: $ G ⇒ e ∊ f18_cs_q k h $ by subset_elim [l1, and_elim_r [l3]]
l5: $ G ⇒ ra_closed k h ∈ lrel $ by f18_cs_e [l4, #1, #2]

def f18_cr_q (td tn tnp tj: set) (.y .k .d: set): class = $ {y | ∀ k ∀ d (ra_closed k y ∈ lrel → ra_recfield td tn tnp d y tj ∈ lrel → nvf' k = nadd (nvf' d) (nvf' tnp) → ⊥)} $

lemma f18_cr_e (G: hyps) (td tn tnp tj: set) (ty vk vd: set): $ G ⇒ ty ∊ f18_cr_q td tn tnp tj $ > $ G ⇒ ra_closed vk ty ∈ lrel $ > $ G ⇒ ra_recfield td tn tnp vd ty tj ∈ lrel $ > $ G ⇒ nvf' vk = nadd (nvf' vd) (nvf' tnp) $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ ∀ k ∀ d (ra_closed k ty ∈ lrel → ra_recfield td tn tnp d ty tj ∈ lrel → nvf' k = nadd (nvf' d) (nvf' tnp) → ⊥) $ by cab_elim [#1]
l2: $ G ⇒ ∀ d (ra_closed vk ty ∈ lrel → ra_recfield td tn tnp d ty tj ∈ lrel → nvf' vk = nadd (nvf' d) (nvf' tnp) → ⊥) $ by all_elim [l1]
l3: $ G ⇒ ra_closed vk ty ∈ lrel → ra_recfield td tn tnp vd ty tj ∈ lrel → nvf' vk = nadd (nvf' vd) (nvf' tnp) → ⊥ $ by all_elim [l2]
l4: $ G ⇒ ra_recfield td tn tnp vd ty tj ∈ lrel → nvf' vk = nadd (nvf' vd) (nvf' tnp) → ⊥ $ by imp_elim [l3, #2]
l5: $ G ⇒ nvf' vk = nadd (nvf' vd) (nvf' tnp) → ⊥ $ by imp_elim [l4, #3]
l6: $ G ⇒ ⊥ $ by imp_elim [l5, #4]

lemma f18_cr_n (G: hyps) (td tn tnp tj: set) (ty k1 j1 vk vd: set): $ G ⇒ crn j1 ⊆ f18_cr_q td tn tnp tj $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_closed vk ty ∈ lrel $ > $ G ⇒ ra_recfield td tn tnp vd ty tj ∈ lrel $ > $ G ⇒ nvf' vk = nadd (nvf' vd) (nvf' tnp) $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
l2: $ G ⇒ vk ∊ trees ω ∧ ty ∊ trees ω $ by lrel_args2 [#5, wcel_isset [l1]]
