lemma f17_iw_all (G: hyps) (M K N: class) (u w v0 td tnp tn tmo tfld tj n0: set): $ G ⇒ trees ω ⊆ f17_iw_q M K N u w v0 td tnp tn tmo tfld tj n0 $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f17_iw_q M K N u w v0 td tnp tn tmo tfld tj n0 , y = ⟨ i , j ⟩ , uadm u , w ∊ lvals , v0 ∊ fseq u , n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ , n0 ∊ trees ω , v0' nvf' tfld ∈ u , K ∈ ω , nadd (suc K) (nvf' tj) = nvf' tn , ∀ c (ra_nidx td tj c ∈ lrel → nvf' c = N) , ra_ihty td tnp tn tmo tfld d tj y m ∈ lrel , y ∊ trees ω , m ∊ ofsort lsig lopen ks_expr , d ∊ ofsort lsig lopen ks_nat , e ∊ fseq u , cdm e = nvf' d , r = e ++ v0 ⇒ crn j ⊆ f17_iw_q M K N u w v0 td tnp tn tmo tfld tj n0 $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f17_iw_q M K N u w v0 td tnp tn tmo tfld tj n0 , y = ⟨ i , j ⟩ , uadm u , w ∊ lvals , v0 ∊ fseq u , n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ , n0 ∊ trees ω , v0' nvf' tfld ∈ u , K ∈ ω , nadd (suc K) (nvf' tj) = nvf' tn , ∀ c (ra_nidx td tj c ∈ lrel → nvf' c = N) , ra_ihty td tnp tn tmo tfld d tj y m ∈ lrel , y ∊ trees ω , m ∊ ofsort lsig lopen ks_expr , d ∊ ofsort lsig lopen ks_nat , e ∊ fseq u , cdm e = nvf' d , r = e ++ v0 ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f17_iw_q M K N u w v0 td tnp tn tmo tfld tj n0 , y = ⟨ i , j ⟩ , uadm u , w ∊ lvals , v0 ∊ fseq u , n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ , n0 ∊ trees ω , v0' nvf' tfld ∈ u , K ∈ ω , nadd (suc K) (nvf' tj) = nvf' tn , ∀ c (ra_nidx td tj c ∈ lrel → nvf' c = N) , ra_ihty td tnp tn tmo tfld d tj y m ∈ lrel , y ∊ trees ω , m ∊ ofsort lsig lopen ks_expr , d ∊ ofsort lsig lopen ks_nat , e ∊ fseq u , cdm e = nvf' d , r = e ++ v0 ⇒ i ∊ ω $ by ax
