l89: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , h = ⟨ kc_bvar , scons o ∅ ⟩ ⇒ nvf' vk = nadd (nvf' vd) (nvf' tnp) $ by weaken [#7]
l90: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , h = ⟨ kc_bvar , scons o ∅ ⟩ ⇒ nvf' vk ⊆ nadd (nvf' vd) (nvf' tnp) $ by eq_subset [l89]
l91: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , h = ⟨ kc_bvar , scons o ∅ ⟩ ⇒ suc (nvf' o) ⊆ nadd (nvf' vd) (nvf' tnp) $ by subset_trans [l88, subset_trans [l87, l90]]
l92: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ isset ⟨ kc_bvar , scons o ∅ ⟩ $ by opair_isset
l93: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ suc (nvf' o) ⊆ nadd (nvf' vd) (nvf' tnp) $ by isset_elim [l92, l91]
l94: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ isset vd $ by isset_var
l95: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ nvf' vd ∈ ω $ by nvf_omega [l94]
l96: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ isset tnp $ by isset_var
l97: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ nvf' tnp ∈ ω $ by nvf_omega [l96]
l98: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ nadd (nvf' vd) (nvf' tnp) ∈ ω $ by nadd_omega_c [l95, l97]
l99: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ isset m $ by isset_var
l100: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ nvf' m ∈ ω $ by nvf_omega [l99]
l101: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ nadd (nvf' vd) (nvf' tnp) ⊆ nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' m) $ by nadd_le_l_c [l98, l100]
l102: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ x = nvf' o $ by ax
l103: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ x ∊ suc (nvf' o) $ by suc_intro_r [l102]
l104: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ suc (nvf' o) ⊆ nadd (nvf' vd) (nvf' tnp) $ by weaken [l93]
l105: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ x ∊ nadd (nvf' vd) (nvf' tnp) $ by subset_elim [l104, l103]
l106: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ nadd (nvf' vd) (nvf' tnp) ⊆ nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' m) $ by weaken [l101]
l107: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ x ∊ nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' m) $ by subset_elim [l106, l105]
l108: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ nvf' o = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' m) $ by weaken [l73]
l109: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ x ∈ x $ by wcel_eq_r [eq_sym [eq_trans [l102, l108]], welc_wcel [l107]]
l110: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ x = x $ by eq_refl
l111: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel , x = nvf' o ⇒ ⊥ $ by mem_ne [l109, l110]
l112: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ isset o $ by isset_var
l113: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ isset (nvf' o) $ by wcel_isset [nvf_omega [l112]]
l114: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel ⇒ ⊥ $ by isset_elim [l113, l111]
l115: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , ∃ t (td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel) ⇒ ∃ t (td = f ∧ tn = g ∧ tnp = e ∧ vd = l ∧ ty = t ∧ tj = m ∧ ra_spine ⟨ kc_bvar , scons o ∅ ⟩ t q ∈ lrel ∧ ra_add l e n ∈ lrel ∧ ra_add n m o ∈ lrel ∧ ra_le ⟨ kc_s , scons m ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons o ∅ ⟩ l e r ∈ lrel ∧ ra_nidx f m p ∈ lrel ∧ ra_iargs n p r t ∈ lrel) $ by ax
