lemma f25_ircapn (G: hyps) (E D P T F I V: class) (u w p cv mv f g t a x: set): $ G ⇒ isset I $ > $ G ⇒ isset V $ > $ G ⇒ D ∈ trees ω $ > $ G ⇒ iprt D P T $ > $ G ⇒ p ∊ esat u E P w $ > $ G ⇒ cv ∊ imots u E D w p V $ > $ G ⇒ mv ∊ imins u E D w p cv $ > $ G ⇒ ityf D I F $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E F w p $ > $ G ⇒ x ∊ apn (ity u E D I w) (f ++ p) $ > $ G ⇒ apn (irc u E D I V w) (scons x f ++ mv ++ cv ++ p) = (ifold u E D w p mv)' ⟨ I , ⟨ f ++ p , x ⟩ ⟩ $
----
l1: $ G , i = I , v = V ⇒ i = I $ by ax
l2: $ G , i = I , v = V ⇒ v = V $ by ax
l3: $ G , i = I , v = V ⇒ D = D $ by eq_refl
l4: $ G , i = I , v = V ⇒ w = w $ by eq_refl
l5: $ G , i = I , v = V ⇒ p = p $ by eq_refl
l6: $ G , i = I , v = V ⇒ cv ∊ imots u E D w p V $ by weaken [#6]
l7: $ G , i = I , v = V ⇒ cv ∊ imots u E D w p v $ by welc_eq [imots_eq [l3, l4, l5, eq_sym [l2]], l6]
l8: $ G , i = I , v = V ⇒ F = F $ by eq_refl
l9: $ G , i = I , v = V ⇒ ityf D I F $ by weaken [#8]
l10: $ G , i = I , v = V ⇒ ityf D i F $ by ityf_eq [l3, eq_sym [l1], l8, l9]
l11: $ G , i = I , v = V ⇒ f ++ p = f ++ p $ by eq_refl
l12: $ G , i = I , v = V ⇒ x ∊ apn (ity u E D I w) (f ++ p) $ by weaken [#10]
l13: $ G , i = I , v = V ⇒ x ∊ apn (ity u E D i w) (f ++ p) $ by welc_eq [apn_eq [ity_eq [l3, eq_sym [l1], l4], l11], l12]
l14: $ G , i = I , v = V ⇒ D ∈ trees ω $ by weaken [#3]
l15: $ G , i = I , v = V ⇒ iprt D P T $ by weaken [#4]
l16: $ G , i = I , v = V ⇒ p ∊ esat u E P w $ by weaken [#5]
l17: $ G , i = I , v = V ⇒ mv ∊ imins u E D w p cv $ by weaken [#7]
l18: $ G , i = I , v = V ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E F w p $ by weaken [#9]
l19: $ G , i = I , v = V ⇒ apn (irc u E D i v w) (scons x f ++ mv ++ cv ++ p) = (ifold u E D w p mv)' ⟨ i , ⟨ f ++ p , x ⟩ ⟩ $ by irc_apn [l14, l15, l16, l7, l17, l10, l18, l13]
l20: $ G , i = I , v = V ⇒ scons x f ++ mv ++ cv ++ p = scons x f ++ mv ++ cv ++ p $ by eq_refl
