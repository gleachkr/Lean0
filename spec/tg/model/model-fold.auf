l161: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ crn (scons h (scons e ∅)) ⊆ f51_rn_q td $ by crn_scons_tail [l160]
l162: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ crn (scons e ∅) ⊆ f51_rn_q td $ by crn_scons_tail [l161]
l163: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ isset e $ by isset_var
l164: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ e ∈ f51_rn_q td $ by crn_scons_head [l163, l162]
l165: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ td = td $ by eq_refl
l166: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ e = e $ by eq_refl
l167: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ x6 = x6 $ by eq_refl
l168: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ e x6 ∈ lrel $ by wcel_eq_l [ra_rst_eq [l165, l150, l166, l167], l149]
l169: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ x6 = e $ by f51_rn_e [wcel_welc [l164], l168]
l170: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l171: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ kc_proj = kc_proj $ by eq_refl
l172: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ vz = ty $ by eq_trans [l148, eq_trans [opair_eq [l171, scons_eq [l151, scons_eq [l152, scons_eq [l169, l170]]]], eq_sym [l147]]]
l173: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , vz = ty ⇒ vz = ty $ by ax
l174: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , vz = ty ⇒ vz = ty $ by ax
l175: $ G , x0 = ⟨ kc_nil , ∅ ⟩ ⇒ vz = ty $ by f21_inv_rst [l6, l9, l21, l34, l71, l108, l145, l172, l174]
l176: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l177: $ G ⇒ vz = ty $ by isset_elim [l176, l175]

lemma f51_rn_all (G: hyps) (td: set): $ G ⇒ trees ω ⊆ f51_rn_q td $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ , ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel ⇒ crn x9 ⊆ f51_rn_q td $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ , ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ , ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ , ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ , ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ , ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel ⇒ z = y $ by f51_rn_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel → z = y $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ ⇒ ∀ z (ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel → z = y) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f51_rn_q td $ by cab_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f51_rn_q td $ by wcel_intro [l10, l9]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f51_rn_q td ⇒ ⟨ x8 , x9 ⟩ ∈ f51_rn_q td $ by isset_elim [l12, l11]
l14: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f51_rn_q td → ⟨ x8 , x9 ⟩ ∈ f51_rn_q td $ by imp_intro [imp_intro [imp_intro [l13]]]
l15: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f51_rn_q td → ⟨ x8 , x9 ⟩ ∈ f51_rn_q td) $ by all_intro [all_intro [l14]]
l16: $ G ⇒ isset ω $ by omega_set
l17: $ G ⇒ trees ω ⊆ f51_rn_q td $ by trees_ind_c [l16, l15]

rst_nil_id
----------
l1: $ G ⇒ trees ω ⊆ f51_rn_q td $ by f51_rn_all
l2: $ G ⇒ ⟨ kr_rst , scons td (scons ⟨ kc_nil , ∅ ⟩ (scons te (scons te2 ∅))) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons te2 ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons te (scons te2 ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons ⟨ kc_nil , ∅ ⟩ (scons te (scons te2 ∅))) $ by scons_set [l5]
l7: $ G ⇒ isset (scons td (scons ⟨ kc_nil , ∅ ⟩ (scons te (scons te2 ∅)))) $ by scons_set [l6]
