lemma f21_inv_mwalk {qdp qkn qA qA3 qB qMin qj_v qa_v qsh qfld qmo qA2 qA4 qIH qh0 qh1 qh_v qni qmi qb_v qK2 qK3 qY qX qY1 qY2: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12: set): $ G ⇒ ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ∈ lrel $ > $ H , t11 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons qA3 (scons qMin ∅) ⟩ ∧ ra_add t8 t2 qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add t4 t3 qkn ∈ lrel ∧ ra_lift qkn t8 qA qA3 ∈ lrel ∧ ra_mwalk t1 t2 t3 t4 t5 t6 t7 ⟨ kc_s , scons t8 ∅ ⟩ t9 t10 qB qMin ∈ lrel ⇒ Cf $ > $ H , t11 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons qA3 (scons qMin ∅) ⟩ ∧ ra_add t8 t2 qdp ∈ lrel ∧ ra_recfield t1 t3 t2 t8 qA qj_v ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ t3 qdp qA qA2 ∈ lrel ∧ ra_add t4 t3 qkn ∈ lrel ∧ ra_lift qkn t8 qA2 qA3 ∈ lrel ∧ ra_add t9 t7 qa_v ∈ lrel ∧ ra_add qsh t8 qa_v ∈ lrel ∧ ra_add qfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ qsh ∈ lrel ∧ ra_add qa_v t4 qmo ∈ lrel ∧ ra_lift qsh ⟨ kc_nz , ∅ ⟩ qA3 qA4 ∈ lrel ∧ ra_ihty t1 t2 t3 qmo qfld ⟨ kc_nz , ∅ ⟩ qj_v qA4 qIH ∈ lrel ∧ ra_mwalk t1 t2 t3 t4 t5 t6 t7 ⟨ kc_s , scons t8 ∅ ⟩ ⟨ kc_s , scons t9 ∅ ⟩ ⟨ kc_cons , scons qIH (scons t10 ∅) ⟩ qB qMin ∈ lrel ⇒ Cf $ > $ H , t8 = t7 ∧ ra_add t7 t2 qdp ∈ lrel ∧ ra_add t4 t3 qkn ∈ lrel ∧ ra_add qdp t5 qh0 ∈ lrel ∧ ra_add qh0 qkn qh1 ∈ lrel ∧ ra_add qh1 t9 qh_v ∈ lrel ∧ ra_lift qkn t7 t11 qK2 ∈ lrel ∧ ra_lift t9 ⟨ kc_nz , ∅ ⟩ qK2 qK3 ∈ lrel ∧ ra_nidx t1 t5 qni ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , scons qmi ∅ ⟩ qni qK3 qX ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons qh_v ∅ ⟩ qY t2 ∈ lrel ∧ ra_add t9 t7 qa_v ∈ lrel ∧ ra_add qa_v qkn qb_v ∈ lrel ∧ ra_add qmi ⟨ kc_s , scons t5 ∅ ⟩ qb_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons t1 (scons t5 (scons t6 ∅)) ⟩ qb_v t2 qY1 ∈ lrel ∧ ra_pargs qY1 t9 t7 qY2 ∈ lrel ∧ ra_pis t10 ⟨ kc_app , scons qX (scons qY2 ∅) ⟩ t12 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
