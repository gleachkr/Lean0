l10: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ nvf' vq = ∅ $ by eq_trans [fv_eq [l8, and_elim_r [l3]], l9]
