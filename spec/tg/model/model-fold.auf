def f17_iw_q (M K N: class) (u w v0 td tnp tn tmo tfld tj n0: set) (.y .d .m .e .r .c .z: set): class = $ {y | ∀ d ∀ m ∀ e ∀ r (uadm u → w ∊ lvals → v0 ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ → n0 ∊ trees ω → v0' nvf' tfld ∈ u → K ∈ ω → nadd (suc K) (nvf' tj) = nvf' tn → ∀ c (ra_nidx td tj c ∈ lrel → nvf' c = N) → ra_ihty td tnp tn tmo tfld d tj y m ∈ lrel → y ∊ trees ω → m ∊ ofsort lsig lopen ks_expr → d ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' d → r = e ++ v0 → dt u M m w r = fpi z (tpth (etel u (dnf u M) y w r)) (ap (ihtb u (etel u (dnf u M) y w r) (v0' (nadd (nvf' tmo) K)) (v0' nvf' tfld) e (N)) z))} $

--| @freshen G c
--| @freshen G z
lemma f17_iw_e {c z: set} (G: hyps) (M K N: class) (u w v0 td tnp tn tmo tfld tj n0: set) (ty vd vm ve vr: set): $ G ⇒ ty ∊ f17_iw_q M K N u w v0 td tnp tn tmo tfld tj n0 $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ v0 ∊ fseq u $ > $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ > $ G ⇒ n0 ∊ trees ω $ > $ G ⇒ v0' nvf' tfld ∈ u $ > $ G ⇒ K ∈ ω $ > $ G ⇒ nadd (suc K) (nvf' tj) = nvf' tn $ > $ G ⇒ ∀ c (ra_nidx td tj c ∈ lrel → nvf' c = N) $ > $ G ⇒ ra_ihty td tnp tn tmo tfld vd tj ty vm ∈ lrel $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ve ∊ fseq u $ > $ G ⇒ cdm ve = nvf' vd $ > $ G ⇒ vr = ve ++ v0 $ > $ G ⇒ dt u M vm w vr = fpi z (tpth (etel u (dnf u M) ty w vr)) (ap (ihtb u (etel u (dnf u M) ty w vr) (v0' (nadd (nvf' tmo) K)) (v0' nvf' tfld) ve (N)) z) $
----
l1: $ G ⇒ ∀ d ∀ m ∀ e ∀ r (uadm u → w ∊ lvals → v0 ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ → n0 ∊ trees ω → v0' nvf' tfld ∈ u → K ∈ ω → nadd (suc K) (nvf' tj) = nvf' tn → ∀ c (ra_nidx td tj c ∈ lrel → nvf' c = N) → ra_ihty td tnp tn tmo tfld d tj ty m ∈ lrel → ty ∊ trees ω → m ∊ ofsort lsig lopen ks_expr → d ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' d → r = e ++ v0 → dt u M m w r = fpi z (tpth (etel u (dnf u M) ty w r)) (ap (ihtb u (etel u (dnf u M) ty w r) (v0' (nadd (nvf' tmo) K)) (v0' nvf' tfld) e (N)) z)) $ by cab_elim [#1]
