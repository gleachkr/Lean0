l30: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s1 ∊ fseq u $ by subset_elim [l28, l29]
l31: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ a ∊ fseq u $ by subset_elim [l28, and_elim_l [l25]]
l32: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ ra_clen tp tnp ∈ lrel $ by weaken [#6]
l33: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ tp ∊ trees ω $ by weaken [l15]
l34: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s1 ∊ esat u E tp w $ by weaken [#7]
l35: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ cdm s1 = cdm a $ by eq_trans [esat_clen [l32, l33, l34], eq_sym [esat_clen [l32, l33, and_elim_l [l25]]]]
l36: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset (nest s2 (d)) $ by nest_set
l37: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset (nest c (nest m (nest b e))) $ by nest_set
l38: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s1 = a ∧ nest s2 (d) = nest c (nest m (nest b e)) $ by nest_inj_c [welc_wcel [l30], welc_wcel [l31], l35, l27, l36, l37]
l39: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s1 = a $ by and_elim_l [l38]
l40: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ nest s2 (d) = nest c (nest m (nest b e)) $ by and_elim_r [l38]
l41: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s2 ∊ imots u E td w s1 V $ by weaken [#8]
l42: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s2 ∊ fseq u ∧ cdm s2 = intys td $ by ivals_fseq [l41]
l43: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ c ∊ fseq u ∧ cdm c = intys td $ by ivals_fseq [and_elim_l [and_elim_r [l25]]]
l44: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s2 ∊ fseq u $ by and_elim_l [l42]
l45: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ c ∊ fseq u $ by and_elim_l [l43]
l46: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ cdm s2 = cdm c $ by eq_trans [and_elim_r [l42], eq_sym [and_elim_r [l43]]]
l47: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset d $ by isset_var
l48: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset (nest m (nest b e)) $ by nest_set
l49: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s2 = c ∧ d = nest m (nest b e) $ by nest_inj_c [welc_wcel [l44], welc_wcel [l45], l46, l40, l47, l48]
l50: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s2 = c $ by and_elim_l [l49]
l51: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ d = nest m (nest b e) $ by and_elim_r [l49]
l52: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ td = td $ by eq_refl
l53: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ w = w $ by eq_refl
l54: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ m ∊ imins u E td w s1 s2 $ by welc_eq [imins_eq [l52, l53, eq_sym [l39], eq_sym [l50]], and_elim_l [and_elim_r [and_elim_r [l25]]]]
l55: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ Q = imins u E td w s1 s2 $ by weaken [#9]
l56: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ m ∊ Q $ by welc_eq [eq_sym [l55], l54]
l57: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest b e ⇒ x7 = nest b e $ by ax
l58: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest b e ⇒ d = nest m (nest b e) $ by weaken [l51]
l59: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest b e ⇒ m = m $ by eq_refl
l60: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest b e ⇒ d = nest m x7 $ by eq_trans [l58, nest_eq [l59, eq_sym [l57]]]
l61: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest b e ⇒ m ∊ Q $ by weaken [l56]
l62: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest b e ⇒ m ∊ Q ∧ d = nest m x7 $ by and_intro [l61, l60]
l63: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest b e ⇒ ∃ z (m ∊ Q ∧ d = nest m z) $ by ex_intro [l62]
l64: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest b e ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_intro [l63]
l65: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset (nest b e) $ by nest_set
l66: $ G , x6 = nest s1 (nest s2 (d)) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by isset_elim [l65, l64]
l67: $ G , x6 = nest s1 (nest s2 (d)) , ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l68: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l67, l66]
l69: $ G , x6 = nest s1 (nest s2 (d)) , ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l70: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l69, l68]
l71: $ G , x6 = nest s1 (nest s2 (d)) , ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l72: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l71, l70]
l73: $ G , x6 = nest s1 (nest s2 (d)) , ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l74: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l73, l72]
l75: $ G , x6 = nest s1 (nest s2 (d)) ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l24, l74]
l76: $ G ⇒ isset (nest s1 (nest s2 (d))) $ by nest_set
l77: $ G ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by isset_elim [l76, l75]

--| @freshen G p
--| @freshen G z
lemma f25_s4 {p z: set} (G: hyps) (E J V Q: class) (u w td tb tp tt tnp tF d s1 s2 s3: set): $ G ⇒ uadm u $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ityf td J tF $ > $ G ⇒ tF ∊ trees ω $ > $ G ⇒ ity u E td J w ∈ u $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ s1 ∊ esat u E tp w $ > $ G ⇒ s2 ∊ imots u E td w s1 V $ > $ G ⇒ s3 ∊ imins u E td w s1 s2 $ > $ G ⇒ Q = imq u E td J w s1 $ > $ G ⇒ d ∊ apn (apn (apn (irc u E td J V w) s1) s2) s3 $ > $ G ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $
----
l1: $ G ⇒ d ∈ apn (apn (apn (irc u E td J V w) s1) s2) s3 $ by welc_wcel [#11]
l2: $ G ⇒ isset d $ by isset_var
l3: $ G ⇒ nest s3 (d) ∈ apn (apn (irc u E td J V w) s1) s2 $ by bi_elim_l [apn_wcel [l2], l1]
l4: $ G ⇒ isset (nest s3 (d)) $ by nest_set
l5: $ G ⇒ nest s2 (nest s3 (d)) ∈ apn (irc u E td J V w) s1 $ by bi_elim_l [apn_wcel [l4], l3]
l6: $ G ⇒ isset (nest s2 (nest s3 (d))) $ by nest_set
l7: $ G ⇒ nest s1 (nest s2 (nest s3 (d))) ∈ irc u E td J V w $ by bi_elim_l [apn_wcel [l6], l5]
l8: $ G ⇒ ⟨ kr_clen , scons tp (scons tnp ∅) ⟩ ∈ latoms $ by lrel_latoms [#6]
l9: $ G ⇒ isset ∅ $ by ax_empty
l10: $ G ⇒ isset (scons tnp ∅) $ by scons_set [l9]
l11: $ G ⇒ isset (scons tp (scons tnp ∅)) $ by scons_set [l10]
l12: $ G ⇒ kr_clen ∈ ω $ by kr_clen_omega
l13: $ G ⇒ kr_clen ∈ ω ∧ scons tp (scons tnp ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l8, wcel_isset [l12], l11]
l14: $ G ⇒ crn (scons tp (scons tnp ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l13]]
l15: $ G ⇒ isset ω $ by omega_set
l16: $ G ⇒ tp ∈ trees ω $ by crn_scons_head_trees [l15, l14]
l17: $ G ⇒ tp ∊ trees ω $ by wcel_welc [l16]
l18: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ x6 = nest s1 (nest s2 (nest s3 (d))) $ by ax
l19: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ nest s1 (nest s2 (nest s3 (d))) ∈ irc u E td J V w $ by weaken [l7]
l20: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ x6 ∊ irc u E td J V w $ by wcel_welc [wcel_eq_l [eq_sym [l18], l19]]
l21: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ uadm u $ by weaken [#1]
l22: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ ra_ind_data td tb tp tt ∈ lrel $ by weaken [#2]
l23: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ ityf td J tF $ by weaken [#3]
l24: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ tF ∊ trees ω $ by weaken [#4]
l25: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ ity u E td J w ∈ u $ by weaken [#5]
l26: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by f25_dec [l21, l22, l23, l24, l25, l20]
l27: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) $ by ax
l28: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ x6 = nest s1 (nest s2 (nest s3 (d))) $ by ax
l29: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ nest s1 (nest s2 (nest s3 (d))) = nest a (nest c (nest m (nest b e))) $ by eq_trans [eq_sym [l28], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l27]]]]]]
l30: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ esat u E tp w ⊆ fseq u $ by esat_fseq
l31: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s1 ∊ esat u E tp w $ by weaken [#7]
l32: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s1 ∊ fseq u $ by subset_elim [l30, l31]
l33: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ a ∊ fseq u $ by subset_elim [l30, and_elim_l [l27]]
