q5: $ G , x ∊ u , y ∊ fseq u , y ∊ f17_sip u M t1 t3 t4 w p s ⇒ w ∊ lvals $ by weaken [#5]
q6: $ G , x ∊ u , y ∊ fseq u , y ∊ f17_sip u M t1 t3 t4 w p s ⇒ p ∊ fseq u $ by weaken [#6]
q7: $ G , x ∊ u , y ∊ fseq u , y ∊ f17_sip u M t1 t3 t4 w p s ⇒ cdm p = nvf' t4 $ by weaken [#7]
q8: $ G , x ∊ u , y ∊ fseq u , y ∊ f17_sip u M t1 t3 t4 w p s ⇒ s ∊ fseq u $ by weaken [#8]
q9: $ G , x ∊ u , y ∊ fseq u , y ∊ f17_sip u M t1 t3 t4 w p s ⇒ x ∊ u $ by ax
q10: $ G , x ∊ u , y ∊ fseq u , y ∊ f17_sip u M t1 t3 t4 w p s ⇒ y ∊ fseq u $ by ax
q11a: $ G , x ∊ u , y ∊ fseq u , y ∊ f17_sip u M t1 t3 t4 w p s ⇒ y ∊ f17_sip u M t1 t3 t4 w p s $ by ax
q11: $ … ⇒ y ∈ f17_sip u M t1 t3 t4 w p s $ by welc_wcel [q11a]
q12: $ … ⇒ scons x y ∈ f17_sip u M t1 t3 t4 w p s $ by f17_si_step [q3, q5, q6, q7, q8, q9, q10, q11]
q13: $ … ⇒ y ∊ f17_sip u M t1 t3 t4 w p s → scons x y ∈ f17_sip u M t1 t3 t4 w p s $ by imp_intro [q12]
q14: $ … ⇒ y ∊ fseq u → y ∊ f17_sip u M t1 t3 t4 w p s → scons x y ∈ f17_sip u M t1 t3 t4 w p s $ by imp_intro [q13]
q15: $ … ⇒ x ∊ u → y ∊ fseq u → y ∊ f17_sip u M t1 t3 t4 w p s → scons x y ∈ f17_sip u M t1 t3 t4 w p s $ by imp_intro [q14]
q16: $ … ⇒ ∀ y (x ∊ u → y ∊ fseq u → y ∊ f17_sip u M t1 t3 t4 w p s → scons x y ∈ f17_sip u M t1 t3 t4 w p s) $ by all_intro [q15]
q17: $ … ⇒ ∀ x ∀ y (x ∊ u → y ∊ fseq u → y ∊ f17_sip u M t1 t3 t4 w p s → scons x y ∈ f17_sip u M t1 t3 t4 w p s) $ by all_intro [q16]
m3: $ … ⇒ fseq u ⊆ f17_sip u M t1 t3 t4 w p s $ by fseq_ind [m1, q17]
m4: $ … ⇒ v ∊ f17_sip u M t1 t3 t4 w p s $ by subset_elim [m3, #9]
m5: $ … ⇒ ∀ x7 ∀ x8 ∀ x9 (ra_sinst t1 x7 t3 t4 x8 x9 ∈ lrel → x7 ∊ trees ω → nadd (nvf' x7) (cdm v) = nvf' t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nvf' b = nadd (nvf' x7) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = v' i) → etel u (dnf u M) x9 w (p ++ s) = etel u (dnf u M) x8 w (p ++ v ++ s)) $ by cab_elim [m4]
m6: $ … ⇒ ∀ x8 ∀ x9 (ra_sinst t1 t2 t3 t4 x8 x9 ∈ lrel → t2 ∊ trees ω → nadd (nvf' t2) (cdm v) = nvf' t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nvf' b = nadd (nvf' t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = v' i) → etel u (dnf u M) x9 w (p ++ s) = etel u (dnf u M) x8 w (p ++ v ++ s)) $ by all_elim [m5]
m7: $ … ⇒ ∀ x9 (ra_sinst t1 t2 t3 t4 t5 x9 ∈ lrel → t2 ∊ trees ω → nadd (nvf' t2) (cdm v) = nvf' t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nvf' b = nadd (nvf' t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = v' i) → etel u (dnf u M) x9 w (p ++ s) = etel u (dnf u M) t5 w (p ++ v ++ s)) $ by all_elim [m6]
m8: $ … ⇒ ra_sinst t1 t2 t3 t4 t5 t6 ∈ lrel → t2 ∊ trees ω → nadd (nvf' t2) (cdm v) = nvf' t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nvf' b = nadd (nvf' t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = v' i) → etel u (dnf u M) t6 w (p ++ s) = etel u (dnf u M) t5 w (p ++ v ++ s) $ by all_elim [m7]
m9: $ … ⇒ t2 ∊ trees ω → nadd (nvf' t2) (cdm v) = nvf' t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nvf' b = nadd (nvf' t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = v' i) → etel u (dnf u M) t6 w (p ++ s) = etel u (dnf u M) t5 w (p ++ v ++ s) $ by imp_elim [m8, #1]
m10: $ … ⇒ nadd (nvf' t2) (cdm v) = nvf' t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nvf' b = nadd (nvf' t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = v' i) → etel u (dnf u M) t6 w (p ++ s) = etel u (dnf u M) t5 w (p ++ v ++ s) $ by imp_elim [m9, #4]
m11: $ … ⇒ ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nvf' b = nadd (nvf' t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = v' i) → etel u (dnf u M) t6 w (p ++ s) = etel u (dnf u M) t5 w (p ++ v ++ s) $ by imp_elim [m10, #10]
m12: $ … ⇒ etel u (dnf u M) t6 w (p ++ s) = etel u (dnf u M) t5 w (p ++ v ++ s) $ by imp_elim [m11, #11]

gpi_step
--------
l1: $ G , a ∊ dt u M ta w r ⇒ a ∊ dt u M ta w r $ by ax
l2: $ G , a ∊ dt u M ta w r ⇒ ∀ a (a ∊ dt u M ta w r → dt u M tm w (scons a r) = fpi s (S2) (ap (T2) s)) $ by weaken [#6]
l3: $ G , a ∊ dt u M ta w r ⇒ dt u M tm w (scons a r) = fpi s (S2) (ap (T2) s) $ by imp_elim [all_elim [l2], l1]
l4: $ G , a ∊ dt u M ta w r ⇒ ∀ a (a ∊ dt u M ta w r → S2 = {x | x ∊ fseq u ∧ ssnoc x a ∈ S}) $ by weaken [#7]
l5: $ G , a ∊ dt u M ta w r ⇒ S2 = {x | x ∊ fseq u ∧ ssnoc x a ∈ S} $ by imp_elim [all_elim [l4], l1]
l6: $ G , a ∊ dt u M ta w r ⇒ ∀ a (a ∊ dt u M ta w r → ∀ q (q ∊ S2 → ap (T2) q = ap (T) (ssnoc q a))) $ by weaken [#9]
l7: $ G , a ∊ dt u M ta w r ⇒ ∀ q (q ∊ S2 → ap (T2) q = ap (T) (ssnoc q a)) $ by imp_elim [all_elim [l6], l1]
l8: $ G , a ∊ dt u M ta w r , s ∊ S2 ⇒ ∀ q (q ∊ S2 → ap (T2) q = ap (T) (ssnoc q a)) $ by weaken [l7]
l9: $ G , a ∊ dt u M ta w r , s ∊ S2 ⇒ s ∊ S2 $ by ax
l10: $ G , a ∊ dt u M ta w r , s ∊ S2 ⇒ ap (T2) s = ap (T) (ssnoc s a) $ by imp_elim [all_elim [l8], l9]
l11: $ G , a ∊ dt u M ta w r ⇒ ∀ s (s ∊ S2 → ap (T2) s = ap (T) (ssnoc s a)) $ by all_intro [imp_intro [l10]]
l12: $ G , a ∊ dt u M ta w r ⇒ fpi s (S2) (ap (T2) s) = fpi s {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc s a)) $ by fpi_eq_pt [l5, l11]
al0: $ fpi s {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc s a)) ≐ fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a)) $ by fpi_alpha
l13: $ G , a ∊ dt u M ta w r ⇒ fpi s {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc s a)) = fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a)) $ by weaken [al0]
l14: $ G , a ∊ dt u M ta w r ⇒ dt u M tm w (scons a r) = fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a)) $ by eq_trans [l3, eq_trans [l12, l13]]
l15: $ G ⇒ ∀ a (a ∊ dt u M ta w r → dt u M tm w (scons a r) = fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a))) $ by all_intro [imp_intro [l14]]
l16: $ G ⇒ dt u M ⟨ kc_pi , scons ta (scons tm ∅) ⟩ w r = cpi a (dt u M ta w r) (dt u M tm w (scons a r)) $ by dt_pi [lsig_ofsort_trees [#1], welc_wcel [#2], #3, #4]
l17: $ G ⇒ dt u M ta w r = dt u M ta w r $ by eq_refl
l18: $ G ⇒ cpi a (dt u M ta w r) (dt u M tm w (scons a r)) = cpi a (dt u M ta w r) (fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a))) $ by cpi_eq_pt [l17, l15]
l19: $ G , l ∊ cpi a (dt u M ta w r) (fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a))) ⇒ l ∊ cpi a (dt u M ta w r) (fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a))) $ by ax
l20: $ G , l ∊ cpi a (dt u M ta w r) (fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a))) ⇒ ∀ s (s ∊ S → ∃ c ∃ b (b ∊ dt u M ta w r ∧ c ∊ fseq u ∧ s = ssnoc c b)) $ by weaken [#8]
l21: $ G , l ∊ cpi a (dt u M ta w r) (fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a))) ⇒ l ∊ fpi s (S) (ap (T) s) $ by cpi_fpi [l19, l20]
l22: $ G , l ∊ fpi s (S) (ap (T) s) ⇒ l ∊ fpi s (S) (ap (T) s) $ by ax
l23: $ G , l ∊ fpi s (S) (ap (T) s) ⇒ ∀ s (s ∊ S → ∃ c ∃ b (b ∊ dt u M ta w r ∧ c ∊ fseq u ∧ s = ssnoc c b)) $ by weaken [#8]
l24: $ G , l ∊ fpi s (S) (ap (T) s) ⇒ l ∊ cpi a (dt u M ta w r) (fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a))) $ by fpi_cpi [l22, l23]
l25: $ G ⇒ cpi a (dt u M ta w r) (fpi q {x | x ∊ fseq u ∧ ssnoc x a ∈ S} (ap (T) (ssnoc q a))) = fpi s (S) (ap (T) s) $ by subset_antisym [subset_intro [l21], subset_intro [l24]]
l26: $ G ⇒ dt u M ⟨ kc_pi , scons ta (scons tm ∅) ⟩ w r = fpi s (S) (ap (T) s) $ by eq_trans [l16, eq_trans [l18, l25]]

def f17_spine_args_q (M: class) (u w r tY: set) (.d .k .a .i .b .y: set): class = $ {d | ∀ k ∀ a (w ∊ lvals → r ∊ fseq u → ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) → ra_spine tY d k ∈ lrel → d ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w r → ∃ i ∃ b (a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' k ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r))} $

--| @freshen G i
--| @freshen G b
--| @freshen G y
lemma f17_spine_args_e {i b y: set} (G: hyps) (M: class) (u w r tY: set) (ty vk va: set): $ G ⇒ ty ∊ f17_spine_args_q M u w r tY $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) $ > $ G ⇒ ra_spine tY ty vk ∈ lrel $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r $ > $ G ⇒ ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $
----
l1: $ G ⇒ ∀ k ∀ a (w ∊ lvals → r ∊ fseq u → ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) → ra_spine tY ty k ∈ lrel → ty ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ i ∃ b (a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' k ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ a (w ∊ lvals → r ∊ fseq u → ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) → ra_spine tY ty vk ∈ lrel → ty ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ i ∃ b (a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r)) $ by all_elim [l1]
l3: $ G ⇒ w ∊ lvals → r ∊ fseq u → ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) → ra_spine tY ty vk ∈ lrel → ty ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $ by all_elim [l2]
l4: $ G ⇒ r ∊ fseq u → ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) → ra_spine tY ty vk ∈ lrel → ty ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $ by imp_elim [l3, #2]
l5: $ G ⇒ ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) → ra_spine tY ty vk ∈ lrel → ty ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $ by imp_elim [l4, #3]
l6: $ G ⇒ ra_spine tY ty vk ∈ lrel → ty ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $ by imp_elim [l5, #4]
l7: $ G ⇒ ty ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $ by imp_elim [l6, #5]
l8: $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $ by imp_elim [l7, #6]
l9: $ G ⇒ ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $ by imp_elim [l8, #7]

--| @freshen G i
--| @freshen G b
--| @freshen G y
lemma f17_spine_args_n {i b y: set} (G: hyps) (M: class) (u w r tY: set) (ty k1 j1 vk va: set): $ G ⇒ crn j1 ⊆ f17_spine_args_q M u w r tY $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) $ > $ G ⇒ ra_spine tY ty vk ∈ lrel $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r $ > $ G ⇒ ∃ i ∃ b (va = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' vk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $
----
l1: $ G ⇒ ∃ x1 (tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x1 ∃ x3 ∃ x5 ∃ x6 (tY = x1 ∧ ty = ⟨ kc_app , scons x3 (scons x5 ∅) ⟩ ∧ vk = ⟨ kc_s , scons x6 ∅ ⟩ ∧ ra_spine x1 x3 x6 ∈ lrel) $ by lrel_spine_cases [#8]
l2: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ ⇒ tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ ⇒ w = w $ by eq_refl
l4: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ ⇒ r = r $ by eq_refl
l5: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r $ by weaken [#10]
l6: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r $ by wcel_eq_r [etel_eq [eq_trans [and_elim_l [and_elim_r [l2]], eq_sym [and_elim_l [l2]]], l3, l4], l5]
l7: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ ⇒ ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) $ by weaken [#7]
l8: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → va ∊ fseq {y | y = y} $ by all_elim [l7]
l9: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ ⇒ va ∊ fseq {y | y = y} $ by imp_elim [l8, l6]
l10: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ , o = ∅ ⇒ o = ∅ $ by ax
l11: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ , o = ∅ ⇒ va ∊ fseq {y | y = y} $ by weaken [l9]
l12: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ , o = ∅ ⇒ va = va $ by eq_refl
l13: $ G , tY = x1 ∧ ty = x1 ∧ vk = ⟨ kc_nz , ∅ ⟩ , o = ∅ ⇒ va = o ++ va $ by eq_sym [eq_trans [scat_eq [l10, l12], scat_empty_l [l11]]]
