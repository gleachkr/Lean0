l139: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ q = q $ by eq_refl
