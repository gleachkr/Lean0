l84: $ G ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by isset_elim [l83, l82]

lemma f25_apn4 (G: hyps) (A F: class) (s a b c: set): $ G ⇒ s ∊ fseq A $ > $ G ⇒ a ∊ fseq A $ > $ G ⇒ b ∊ fseq A $ > $ G ⇒ c ∊ fseq A $ > $ G ⇒ apn F (s ++ a ++ b ++ c) = apn (apn (apn (apn F c) b) a) s $
----
l1: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ x1 = b ++ c $ by ax
l2: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ x2 = a ++ x1 $ by ax
l3: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ b ∊ fseq A $ by weaken [#3]
l4: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ c ∊ fseq A $ by weaken [#4]
l5: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ x1 ∊ fseq A $ by wcel_welc [wcel_eq_l [eq_sym [l1], scat_fseq [l3, l4]]]
l6: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ a ∊ fseq A $ by weaken [#2]
l7: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ x2 ∊ fseq A $ by wcel_welc [wcel_eq_l [eq_sym [l2], scat_fseq [l6, l5]]]
l8: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ s ∊ fseq A $ by weaken [#1]
l9: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ apn F (s ++ x2) = apn (apn F x2) s $ by apn_scat [l8, l7]
l10: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ a ∊ fseq A $ by weaken [#2]
l11: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ apn F (a ++ x1) = apn (apn F x1) a $ by apn_scat [l10, l5]
l12: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ b ∊ fseq A $ by weaken [#3]
l13: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ c ∊ fseq A $ by weaken [#4]
l14: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ apn F (b ++ c) = apn (apn F c) b $ by apn_scat [l12, l13]
l15: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ a = a $ by eq_refl
l16: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ x2 = a ++ b ++ c $ by eq_trans [l2, scat_eq [l15, l1]]
l17: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ F = F $ by eq_refl
l18: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ apn F x2 = apn (apn (apn F c) b) a $ by eq_trans [apn_eq [l17, l2], eq_trans [l11, apn_eq [eq_trans [apn_eq [l17, l1], l14], l15]]]
l19: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ s = s $ by eq_refl
l20: $ G , x1 = b ++ c , x2 = a ++ x1 ⇒ apn F (s ++ a ++ b ++ c) = apn (apn (apn (apn F c) b) a) s $ by eq_trans [apn_eq [l17, scat_eq [l19, eq_sym [l16]]], eq_trans [l9, apn_eq [l18, l19]]]
l21: $ G , x1 = b ++ c ⇒ a ∊ fseq A $ by weaken [#2]
l22: $ G , x1 = b ++ c ⇒ x1 = b ++ c $ by ax
l23: $ G , x1 = b ++ c ⇒ b ∊ fseq A $ by weaken [#3]
l24: $ G , x1 = b ++ c ⇒ c ∊ fseq A $ by weaken [#4]
l25: $ G , x1 = b ++ c ⇒ x1 ∊ fseq A $ by wcel_welc [wcel_eq_l [eq_sym [l22], scat_fseq [l23, l24]]]
l26: $ G , x1 = b ++ c ⇒ isset (a ++ x1) $ by wcel_isset [scat_fseq [l21, l25]]
l27: $ G , x1 = b ++ c ⇒ apn F (s ++ a ++ b ++ c) = apn (apn (apn (apn F c) b) a) s $ by isset_elim [l26, l20]
l28: $ G ⇒ isset (b ++ c) $ by wcel_isset [scat_fseq [#3, #4]]
l29: $ G ⇒ apn F (s ++ a ++ b ++ c) = apn (apn (apn (apn F c) b) a) s $ by isset_elim [l28, l27]

--| @freshen G c
lemma f25_K {c: set} (G: hyps) (A N I: class) (s t: set): $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ cdm t = N $ > $ G ⇒ I ∈ N $ > $ G ⇒ ∃ c (c ∊ cdm (s ++ t) ∧ nadd (suc c) I = cdm (s ++ t) ∧ (s ++ t)' c = vat t N I) $
----
l1: $ G ⇒ N ∈ ω $ by wcel_eq_l [#3, fseq_len [#2]]
l2: $ G ⇒ cdm s ∈ ω $ by fseq_len [#1]
l3: $ G , i = I , n = N ⇒ i = I $ by ax
l4: $ G , i = I , n = N ⇒ n = N $ by ax
l5: $ G , i = I , n = N ⇒ N ∈ ω $ by weaken [l1]
l6: $ G , i = I , n = N ⇒ n ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l4], l5]]
l7: $ G , i = I , n = N ⇒ I ∈ N $ by weaken [#4]
l8: $ G , i = I , n = N ⇒ i ∊ n $ by wcel_welc [wcel_eq_l [eq_sym [l3], wcel_eq_r [eq_sym [l4], l7]]]
l9: $ G , i = I , n = N ⇒ i ∊ ω $ by omega_elem_omega [l6, l8]
l10: $ G , i = I , n = N ⇒ ∃ c (c ∊ ω ∧ nadd i (suc c) = n) $ by nlt_ex [l9, l6, l8]
l11: $ G , i = I , n = N , c ∊ ω ∧ nadd i (suc c) = n ⇒ c ∊ ω ∧ nadd i (suc c) = n $ by ax
l12: $ G , i = I , n = N , c ∊ ω ∧ nadd i (suc c) = n ⇒ ∃ d (d ∊ ω ∧ nadd i (suc d) = n) $ by ex_intro [l11]
l13: $ G , i = I , n = N ⇒ ∃ d (d ∊ ω ∧ nadd i (suc d) = n) $ by ex_elim [l10, l12]
l14: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ k = nadd (cdm s) d $ by ax
l15: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ d ∊ ω ∧ nadd i (suc d) = n $ by ax
l16: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ d ∈ ω $ by welc_wcel [and_elim_l [l15]]
l17: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ i = I $ by ax
l18: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ n = N $ by ax
l19: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ i ∊ ω $ by weaken [l9]
l20: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ I ∈ ω $ by wcel_eq_l [l17, welc_wcel [l19]]
l21: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ cdm s ∈ ω $ by weaken [l2]
l22: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ N ∈ ω $ by weaken [l1]
l23: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ s ∊ fseq A $ by weaken [#1]
l24: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ t ∊ fseq A $ by weaken [#2]
l25: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ suc d = suc d $ by eq_refl
l26: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ nadd (suc I) d = N $ by eq_trans [f15_sl [l20, l16], eq_trans [nadd_eq [eq_sym [l17], l25], eq_trans [and_elim_r [l15], l18]]]
l27: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ I ∈ N $ by weaken [#4]
l28: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ vat t N I = t' d $ by vat_eq [l27, l22, l16, l26]
l29: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ s ++ t = s ++ t $ by eq_refl
l30: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ (s ++ t)' k = t' d $ by eq_trans [fv_eq [l29, l14], scat_fv_r_c [l23, l24, l16]]
l31: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ cdm s = cdm s $ by eq_refl
l32: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ cdm t = N $ by weaken [#3]
l33: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ cdm (s ++ t) = nadd (cdm s) N $ by eq_trans [scat_len [l23, l24], nadd_eq [l31, l32]]
l34: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ suc I ∈ ω $ by omega_suc_c [l20]
l35: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ k ∈ ω $ by wcel_eq_l [eq_sym [l14], nadd_omega_c [l21, l16]]
l36: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ suc I = suc I $ by eq_refl
l37: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ nadd k (suc I) = cdm (s ++ t) $ by eq_trans [nadd_eq [l14, l36], eq_trans [nadd_assoc_c [l21, l16, l34], eq_trans [nadd_eq [l31, eq_trans [nadd_comm_c [l16, l34], l26]], eq_sym [l33]]]]
l38: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ k ∊ cdm (s ++ t) $ by wcel_welc [f15_lt [l35, l20, l37]]
l39: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ nadd (suc k) I = cdm (s ++ t) $ by eq_trans [f15_sl [l35, l20], l37]
l40: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ k ∊ cdm (s ++ t) ∧ nadd (suc k) I = cdm (s ++ t) ∧ (s ++ t)' k = vat t N I $ by and_intro [l38, and_intro [l39, eq_trans [l30, eq_sym [l28]]]]
l41: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n , k = nadd (cdm s) d ⇒ ∃ c (c ∊ cdm (s ++ t) ∧ nadd (suc c) I = cdm (s ++ t) ∧ (s ++ t)' c = vat t N I) $ by ex_intro [l40]
l42: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n ⇒ cdm s ∈ ω $ by weaken [l2]
l43: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n ⇒ d ∊ ω ∧ nadd i (suc d) = n $ by ax
l44: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n ⇒ isset (nadd (cdm s) d) $ by wcel_isset [nadd_omega_c [l42, welc_wcel [and_elim_l [l43]]]]
l45: $ G , i = I , n = N , d ∊ ω ∧ nadd i (suc d) = n ⇒ ∃ c (c ∊ cdm (s ++ t) ∧ nadd (suc c) I = cdm (s ++ t) ∧ (s ++ t)' c = vat t N I) $ by isset_elim [l44, l41]
l46: $ G , i = I , n = N ⇒ ∃ c (c ∊ cdm (s ++ t) ∧ nadd (suc c) I = cdm (s ++ t) ∧ (s ++ t)' c = vat t N I) $ by ex_elim [l13, l45]
l47: $ G , i = I ⇒ N ∈ ω $ by weaken [l1]
l48: $ G , i = I ⇒ isset N $ by wcel_isset [l47]
l49: $ G , i = I ⇒ ∃ c (c ∊ cdm (s ++ t) ∧ nadd (suc c) I = cdm (s ++ t) ∧ (s ++ t)' c = vat t N I) $ by isset_elim [l48, l46]
l50: $ G ⇒ isset I $ by wcel_isset [#4]
l51: $ G ⇒ ∃ c (c ∊ cdm (s ++ t) ∧ nadd (suc c) I = cdm (s ++ t) ∧ (s ++ t)' c = vat t N I) $ by isset_elim [l50, l49]

--| @freshen G f
lemma f25_dom {f: set} (G: hyps) (M Jc: class) (u w td tj tnp tz tf tf2 p c0 rr g r: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' tnp $ > $ G ⇒ c0 ∊ fseq u $ > $ G ⇒ cdm c0 = nvf' tj $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ ra_lift tj tz tf tf2 ∈ lrel $ > $ G ⇒ ityf td Jc tf $ > $ G ⇒ ra_closed tnp tf ∈ lrel $ > $ G ⇒ ity u (dnf u M) td Jc w ∈ u $ > $ G ⇒ g = ∅ $ > $ G ⇒ r = g ++ c0 ++ p ++ rr $ > $ G ⇒ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) = imq u (dnf u M) td Jc w p $
----
l1: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ g = ∅ $ by weaken [#13]
l2: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ v = p ++ rr $ by ax
l3: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ t = ity u (dnf u M) td Jc w $ by ax
l4: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ p ∊ fseq u $ by weaken [#3]
l5: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ c0 ∊ fseq u $ by weaken [#5]
l6: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ rr ∊ fseq u $ by weaken [#7]
l7: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ w ∊ lvals $ by weaken [#2]
l8: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ ra_lift tj tz tf tf2 ∈ lrel $ by weaken [#9]
l9: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ kr_lift ∈ ω $ by kr_lift_omega
l10: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ tj ∊ trees ω ∧ tz ∊ trees ω ∧ tf ∊ trees ω ∧ tf2 ∊ trees ω $ by lrel_args4 [l8, wcel_isset [l9]]
l11: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ ∅ ∈ fseq u $ by fseq_empty
l12: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ g ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l1], l11]]
l13: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ v ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l2], scat_fseq [l4, l6]]]
l14: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ cdm ∅ = ∅ $ by cdm_empty
l15: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ cdm g = ∅ $ by eq_trans [cdm_eq [l1], l14]
l16: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ nvf = nvf $ by eq_refl
l17: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ by weaken [#8]
l18: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l19: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ nvf' tz = ∅ $ by eq_trans [fv_eq [l16, l17], l18]
l20: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ cdm g = nvf' tz $ by eq_trans [l15, eq_sym [l19]]
l21: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ r = g ++ c0 ++ p ++ rr $ by weaken [#14]
l22: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ ra_lift tj tz tf tf2 ∈ lrel $ by weaken [#9]
l23: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ cdm c0 = nvf' tj $ by weaken [#6]
l24: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ etel u (dnf u M) tf2 w (g ++ c0 ++ v) = etel u (dnf u M) tf w (g ++ v) $ by lrel_lift_etel [l22, l7, l12, l20, l5, l23, l13]
l25: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ cdm p = nvf' tnp $ by weaken [#4]
l26: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ cdm p = cdm p $ by eq_refl
l27: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ nvf' tnp = nadd (cdm p) (cdm g) $ by eq_trans [eq_sym [l25], eq_sym [eq_trans [nadd_eq [l26, l15], nadd_zero_c [wcel_isset [fseq_len [l4]]]]]]
l28: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ ra_closed tnp tf ∈ lrel $ by weaken [#11]
l29: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ etel u (dnf u M) tf w (p ++ g ++ rr) = etel u (dnf u M) tf w (p ++ g) $ by closed_etel_scat [l28, and_elim_l [and_elim_r [and_elim_r [l10]]], l7, l4, l12, l6, l27]
l30: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ g = g $ by eq_refl
l31: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ c0 = c0 $ by eq_refl
l32: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ r = g ++ c0 ++ v $ by eq_trans [l21, scat_eq [l30, scat_eq [l31, eq_sym [l2]]]]
l33: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ v = v $ by eq_refl
l34: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ p = p $ by eq_refl
l35: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ rr = rr $ by eq_refl
l36: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ g ++ v = p ++ g ++ rr $ by eq_trans [scat_eq [l1, l33], eq_trans [scat_empty_l [l13], eq_trans [l2, scat_eq [l34, eq_sym [eq_trans [scat_eq [l1, l35], scat_empty_l [l6]]]]]]]
l37: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ p ++ ∅ = p $ by scat_empty_r
l38: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ p ++ g = p $ by eq_trans [scat_eq [l34, l1], l37]
l39: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ tf = tf $ by eq_refl
l40: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ w = w $ by eq_refl
l41: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ tf2 = tf2 $ by eq_refl
l42: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ etel u (dnf u M) tf2 w r = etel u (dnf u M) tf w p $ by eq_trans [etel_eq [l41, l40, l32], eq_trans [l24, eq_trans [etel_eq [l39, l40, l36], eq_trans [l29, etel_eq [l39, l40, l38]]]]]
l43: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w ⇒ g ++ p = p $ by eq_trans [scat_eq [l1, l34], scat_empty_l [l4]]
l44: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w , l ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) ⇒ l ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) $ by ax
l45: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w , l ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) ⇒ ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ m ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ m ∊ u ∧ l = scons m c) $ by cab_elim [l44]
l46: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w , l ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ m ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ m ∊ u ∧ l = scons m c ⇒ ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ m ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ m ∊ u ∧ l = scons m c $ by ax
l47: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w , l ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ m ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ n (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ n ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l46]
l48: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w , l ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ m ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ k ∃ n (⟨ c , ⟨ d , ⟨ h , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ n ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l47]
l49: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w , l ∊ mpth u (dnf u M) tf2 w r (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ m ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ j ∃ k ∃ n (⟨ c , ⟨ d , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ n ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l48]
