l198: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x , i ∊ ω , m ∊ ω ⇒ nadd i (suc m) = cdm l → vg' i = l' m $ by imp_intro [l197]
l199: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x , i ∊ ω ⇒ m ∊ ω → nadd i (suc m) = cdm l → vg' i = l' m $ by imp_intro [l198]
l200: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x ⇒ i ∊ ω → m ∊ ω → nadd i (suc m) = cdm l → vg' i = l' m $ by imp_intro [l199]
l201: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x ⇒ ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm l → vg' i = l' m) $ by all_intro [l200]
l202: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm l → vg' i = l' m) $ by all_intro [l201]
l203: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x ⇒ vg' nvf' vn ∈ dt u M tA w (l ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm l → vg' i = l' m) $ by and_intro [l182, l202]
l204: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x ⇒ cdm l = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (l ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm l → vg' i = l' m) $ by and_intro [l158, l203]
l205: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x ⇒ l ∊ fseq u ∧ cdm l = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (l ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm l → vg' i = l' m) $ by and_intro [l147, l204]
l206: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) , l = ssnoc o x ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by ex_intro [l205]
l207: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) ⇒ ssnoc o x ∈ fseq u $ by weaken [l140]
l208: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) ⇒ isset (ssnoc o x) $ by wcel_isset [l207]
l209: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr , o ∊ fseq u ∧ cdm o = nvf' k ∧ g' nvf' k ∈ dt u M tA w (o ++ q) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m) ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by isset_elim [l208, l206]
l210: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g , q = scons x vr ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by ex_elim [l132, l209]
l211: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g ⇒ isset vr $ by isset_var
l212: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g ⇒ isset (scons x vr) $ by scons_set [l211]
l213: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by isset_elim [l212, l210]
l214: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , ∃ t (x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g) ⇒ ∃ t (x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g) $ by ax
l215: $ … ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by ex_elim [l214, l213]
l216: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , ∃ g ∃ t (x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g) ⇒ ∃ g ∃ t (x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g) $ by ax
l217: $ … ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by ex_elim [l216, l215]
l218: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel , ∃ f ∃ g ∃ t (x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g) ⇒ ∃ f ∃ g ∃ t (x ∊ dt u M b w vr ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g) $ by ax
l219: $ … ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by ex_elim [l218, l217]
l220: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_pi c k tA ∈ lrel ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by ex_elim [l88, l219]
l221: $ G ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by f21_inv_nth_pi [#5, l70, l220]

lemma f50_fo_all (G: hyps) (M: class) (u w tA: set): $ G ⇒ trees ω ⊆ f50_fo_q M u w tA $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f50_fo_q M u w tA , x7 = ⟨ x8 , x9 ⟩ , ra_nth_pi x7 n tA ∈ lrel , w ∊ lvals , r ∊ fseq u , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ⇒ crn x9 ⊆ f50_fo_q M u w tA $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f50_fo_q M u w tA , x7 = ⟨ x8 , x9 ⟩ , ra_nth_pi x7 n tA ∈ lrel , w ∊ lvals , r ∊ fseq u , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ⇒ x7 = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f50_fo_q M u w tA , x7 = ⟨ x8 , x9 ⟩ , ra_nth_pi x7 n tA ∈ lrel , w ∊ lvals , r ∊ fseq u , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f50_fo_q M u w tA , x7 = ⟨ x8 , x9 ⟩ , ra_nth_pi x7 n tA ∈ lrel , w ∊ lvals , r ∊ fseq u , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f50_fo_q M u w tA , x7 = ⟨ x8 , x9 ⟩ , ra_nth_pi x7 n tA ∈ lrel , w ∊ lvals , r ∊ fseq u , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ⇒ ra_nth_pi x7 n tA ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f50_fo_q M u w tA , x7 = ⟨ x8 , x9 ⟩ , ra_nth_pi x7 n tA ∈ lrel , w ∊ lvals , r ∊ fseq u , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ⇒ w ∊ lvals $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f50_fo_q M u w tA , x7 = ⟨ x8 , x9 ⟩ , ra_nth_pi x7 n tA ∈ lrel , w ∊ lvals , r ∊ fseq u , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ⇒ r ∊ fseq u $ by ax
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f50_fo_q M u w tA , x7 = ⟨ x8 , x9 ⟩ , ra_nth_pi x7 n tA ∈ lrel , w ∊ lvals , r ∊ fseq u , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r $ by ax
