l8: $ G , td = x1 ∧ tnp = x2 ∧ tj = x3 ∧ vd = x4 ∧ tv = x5 ∧ ty = ⟨ kc_pi , scons g (scons b ∅) ⟩ ∧ vm = ⟨ kc_pi , scons g (scons n ∅) ⟩ ∧ ra_mty x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x5 b n ∈ lrel ⇒ c0 ++ p ++ rr ∈ fseq u $ by scat_fseq_c [welc_wcel [l5], scat_fseq [l6, l7]]
