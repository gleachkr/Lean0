l94: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ , ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel ⇒ vm = vm $ by eq_refl
l95: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ , ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel ⇒ ra_add l a vm ∈ lrel $ by wcel_eq_l [ra_add_eq [l93, eq_sym [l91], l94], l92]
l96: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ , ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel ⇒ ra_clen h l ∈ lrel $ by weaken [l72]
l97: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ , ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ l l ∈ lrel $ by clen_num [l96]
l98: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ , ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel ⇒ ra_add a l vm ∈ lrel $ by add_comm [l97, l95]
l99: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ , ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel ⇒ v = vm $ by lrel_add_det [l83, l98]
l100: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ , ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel ⇒ ra_clen vq vm ∈ lrel $ by wcel_eq_l [ra_clen_eq [l85, l99], l82]
l101: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ , ∃ v (ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel) ⇒ ∃ v (ra_capp h g u ∈ lrel ∧ ra_clen u v ∈ lrel ∧ ra_add a l v ∈ lrel) $ by ax
l102: $ … ⇒ ra_clen vq vm ∈ lrel $ by ex_elim [l101, l100]
l103: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ , x4 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen vq vm ∈ lrel $ by ex_elim [l79, l102]
l104: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l105: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ ra_clen vq vm ∈ lrel $ by isset_elim [l104, l103]
l106: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel ⇒ isset ⟨ kc_s , scons vi ∅ ⟩ $ by opair_isset
l107: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel , ty = ⟨ kc_tcons , scons o (scons p (scons q ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys q n l ∈ lrel ∧ ra_clen_c p j ∈ lrel ∧ ra_add l j vm ∈ lrel ⇒ ra_clen vq vm ∈ lrel $ by isset_elim [l106, l105]
l108: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel ⇒ ra_clen vq vm ∈ lrel $ by f21_inv_ntys [l14, l28, l107]
l109: $ G ⇒ ra_clen vq vm ∈ lrel $ by f21_inv_minors [#5, l12, l108]

lemma f29_mn_all (G: hyps) (t1 t2 t3: set): $ G ⇒ trees ω ⊆ f29_mn_q t1 t2 t3 $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_minors t1 t2 t3 k i y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ crn x9 ⊆ f29_mn_q t1 t2 t3 $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_minors t1 t2 t3 k i y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_minors t1 t2 t3 k i y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_minors t1 t2 t3 k i y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_minors t1 t2 t3 k i y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ ra_minors t1 t2 t3 k i y q ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_minors t1 t2 t3 k i y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ ra_ntys y n m ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_minors t1 t2 t3 k i y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ ra_clen q m ∈ lrel $ by f29_mn_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_minors t1 t2 t3 k i y q ∈ lrel ⇒ ra_ntys y n m ∈ lrel → ra_clen q m ∈ lrel $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ra_minors t1 t2 t3 k i y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q m ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ m (ra_minors t1 t2 t3 k i y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q m ∈ lrel) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n ∀ m (ra_minors t1 t2 t3 k i y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q m ∈ lrel) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ q ∀ n ∀ m (ra_minors t1 t2 t3 k i y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q m ∈ lrel) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ i ∀ q ∀ n ∀ m (ra_minors t1 t2 t3 k i y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q m ∈ lrel) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ k ∀ i ∀ q ∀ n ∀ m (ra_minors t1 t2 t3 k i y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q m ∈ lrel) $ by all_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_mn_q t1 t2 t3 $ by cab_intro [l14]
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_mn_q t1 t2 t3 $ by wcel_intro [l16, l15]
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l19: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mn_q t1 t2 t3 ⇒ ⟨ x8 , x9 ⟩ ∈ f29_mn_q t1 t2 t3 $ by isset_elim [l18, l17]
l20: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_mn_q t1 t2 t3 → ⟨ x8 , x9 ⟩ ∈ f29_mn_q t1 t2 t3 $ by imp_intro [imp_intro [imp_intro [l19]]]
l21: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_mn_q t1 t2 t3 → ⟨ x8 , x9 ⟩ ∈ f29_mn_q t1 t2 t3) $ by all_intro [all_intro [l20]]
l22: $ G ⇒ isset ω $ by omega_set
l23: $ G ⇒ trees ω ⊆ f29_mn_q t1 t2 t3 $ by trees_ind_c [l22, l21]

minors_clen
-----------
l1: $ G ⇒ ⟨ kr_ntys , scons tT (scons tn (scons tm ∅)) ⟩ ∈ latoms $ by lrel_latoms [#2]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tm ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tn (scons tm ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tT (scons tn (scons tm ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_ntys ∈ ω $ by kr_ntys_omega
l7: $ G ⇒ kr_ntys ∈ ω ∧ scons tT (scons tn (scons tm ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons tT (scons tn (scons tm ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ isset ω $ by omega_set
l10: $ G ⇒ tT ∈ trees ω $ by crn_scons_head_trees [l9, l8]
l11: $ G ⇒ trees ω ⊆ f29_mn_q t1 t2 t3 $ by f29_mn_all
l12: $ G ⇒ tT ∊ f29_mn_q t1 t2 t3 $ by subset_elim [l11, wcel_welc [l10]]
l13: $ G ⇒ ra_clen tq tm ∈ lrel $ by f29_mn_e [l12, #1, #2]

--| @freshen H qA
--| @freshen H qB
--| @freshen H qk_v
lemma f21_inv_isort {qA qB qk_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_isort t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_srt , scons t3 ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_isort qB qk_v t3 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_isort t1 t2 t3 ∈ lrel $ by weaken [#1]
