l193: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J ⇒ n ∈ trees ω $ by crn_scons_head_trees [l192, l191]
l194: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J ⇒ nvf = nvf $ by eq_refl
l195: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J ⇒ nvf' vn = suc (nvf' n) $ by eq_trans [fv_eq [l194, l37], nvf_s [l193]]
l196: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g ⇒ x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g $ by ax
