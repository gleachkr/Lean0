l34: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ra_nth_ty x3 tj x4 x5 ∈ lrel $ by and_elim_l [and_elim_r [l32]]
l35: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ra_isort x4 z x6 ∈ lrel $ by and_elim_r [and_elim_r [l32]]
l36: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ra_ind_data td tb tp tt ∈ lrel $ by weaken [#2]
l37: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ x1 = tb ∧ x2 = tp ∧ x3 = tt $ by lrel_ind_data_det [l33, l36]
l38: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ tj = tj $ by eq_refl
l39: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ x4 = x4 $ by eq_refl
l40: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ x5 = x5 $ by eq_refl
l41: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ra_nth_ty tt tj x4 x5 ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [and_elim_r [and_elim_r [l37]], l38, l39, l40], l34]
l42: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ra_nidx td tj z ∈ lrel $ by ax
l43: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ra_nth_ty tt tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ∧ ra_nidx td tj z ∈ lrel $ by and_intro [l41, and_intro [l35, l42]]
l44: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ∃ q (ra_nth_ty tt tj x4 x5 ∈ lrel ∧ ra_isort x4 z q ∈ lrel ∧ ra_nidx td tj z ∈ lrel) $ by ex_intro [l43]
l45: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ∃ m ∃ q (ra_nth_ty tt tj x4 x5 ∈ lrel ∧ ra_isort x4 m q ∈ lrel ∧ ra_nidx td tj m ∈ lrel) $ by ex_intro [l44]
l46: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ∃ e ∃ m ∃ q (ra_nth_ty tt tj x4 e ∈ lrel ∧ ra_isort x4 m q ∈ lrel ∧ ra_nidx td tj m ∈ lrel) $ by ex_intro [l45]
l47: $ G , ra_nidx td tj z ∈ lrel , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 tj x4 x5 ∈ lrel ∧ ra_isort x4 z x6 ∈ lrel ⇒ ∃ b ∃ e ∃ m ∃ q (ra_nth_ty tt tj b e ∈ lrel ∧ ra_isort b m q ∈ lrel ∧ ra_nidx td tj m ∈ lrel) $ by ex_intro [l46]
l48: $ G , ra_nidx td tj z ∈ lrel ⇒ ∃ b ∃ e ∃ m ∃ q (ra_nth_ty tt tj b e ∈ lrel ∧ ra_isort b m q ∈ lrel ∧ ra_nidx td tj m ∈ lrel) $ by f21_inv_nidx [l31, l47]
l49: $ G ⇒ ∃ b ∃ e ∃ m ∃ q (ra_nth_ty tt tj b e ∈ lrel ∧ ra_isort b m q ∈ lrel ∧ ra_nidx td tj m ∈ lrel) $ by ex_elim [l30, l48]

rw_rec_ih
