l74: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w , x2 = f ++ a , x3 = scons x f , x4 = c ++ a ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ z = nest a (nest c (nest m (nest b e)))) $ by isset_elim [l73, l67]
l75: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w , x2 = f ++ a , x3 = scons x f ⇒ c ∊ fseq u ∧ cdm c = intys td $ by weaken [l19]
l76: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w , x2 = f ++ a , x3 = scons x f ⇒ a ∊ fseq u $ by weaken [l9]
l77: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w , x2 = f ++ a , x3 = scons x f ⇒ isset (c ++ a) $ by wcel_isset [scat_fseq [and_elim_l [l75], l76]]
l78: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w , x2 = f ++ a , x3 = scons x f ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ z = nest a (nest c (nest m (nest b e)))) $ by isset_elim [l77, l74]
l79: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w , x2 = f ++ a ⇒ isset f $ by isset_var
l80: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w , x2 = f ++ a ⇒ isset (scons x f) $ by scons_set [l79]
l81: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w , x2 = f ++ a ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ z = nest a (nest c (nest m (nest b e)))) $ by isset_elim [l80, l78]
l82: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w ⇒ f ∊ fseq u $ by weaken [l17]
l83: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w ⇒ a ∊ fseq u $ by weaken [l9]
l84: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w ⇒ isset (f ++ a) $ by wcel_isset [scat_fseq [l82, l83]]
l85: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e , x1 = ity u E td J w ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ z = nest a (nest c (nest m (nest b e)))) $ by isset_elim [l84, l81]
l86: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e ⇒ ity u E td J w ∈ u $ by weaken [#5]
l87: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e ⇒ isset (ity u E td J w) $ by wcel_isset [l86]
l88: $ G , iprt td h d , a ∊ esat u E h w , c ∊ imots u E td w a V , m ∊ imins u E td w a c , ityf td J o , ⟨ f , ⟨ g , ⟨ k , i ⟩ ⟩ ⟩ ∈ etel u E o w a , x ∊ apn (ity u E td J w) (f ++ a) , e ∊ (ifold u E td w a m)' ⟨ J , ⟨ f ++ a , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ a) e ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ z = nest a (nest c (nest m (nest b e)))) $ by isset_elim [l87, l85]
l89: $ G ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ z = nest a (nest c (nest m (nest b e)))) $ by irc_elim [#6, l88]

--| @freshen G p
--| @freshen G z
lemma f25_s1 {p z: set} (G: hyps) (E J V Q: class) (u w td tb tp tt tnp tF d: set): $ G ⇒ uadm u $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ityf td J tF $ > $ G ⇒ tF ∊ trees ω $ > $ G ⇒ ity u E td J w ∈ u $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ Q = esat u E tp w $ > $ G ⇒ d ∊ irc u E td J V w $ > $ G ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $
----
l1: $ G ⇒ d ∈ irc u E td J V w $ by welc_wcel [#8]
l2: $ G ⇒ ⟨ kr_clen , scons tp (scons tnp ∅) ⟩ ∈ latoms $ by lrel_latoms [#6]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons tnp ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tp (scons tnp ∅)) $ by scons_set [l4]
l6: $ G ⇒ kr_clen ∈ ω $ by kr_clen_omega
l7: $ G ⇒ kr_clen ∈ ω ∧ scons tp (scons tnp ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons tp (scons tnp ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ isset ω $ by omega_set
l10: $ G ⇒ tp ∈ trees ω $ by crn_scons_head_trees [l9, l8]
l11: $ G ⇒ tp ∊ trees ω $ by wcel_welc [l10]
l12: $ G , x6 = d ⇒ x6 = d $ by ax
l13: $ G , x6 = d ⇒ d ∈ irc u E td J V w $ by weaken [l1]
l14: $ G , x6 = d ⇒ x6 ∊ irc u E td J V w $ by wcel_welc [wcel_eq_l [eq_sym [l12], l13]]
l15: $ G , x6 = d ⇒ uadm u $ by weaken [#1]
l16: $ G , x6 = d ⇒ ra_ind_data td tb tp tt ∈ lrel $ by weaken [#2]
l17: $ G , x6 = d ⇒ ityf td J tF $ by weaken [#3]
l18: $ G , x6 = d ⇒ tF ∊ trees ω $ by weaken [#4]
l19: $ G , x6 = d ⇒ ity u E td J w ∈ u $ by weaken [#5]
l20: $ G , x6 = d ⇒ ∃ a ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by f25_dec [l15, l16, l17, l18, l19, l14]
l21: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) $ by ax
l22: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ x6 = d $ by ax
l23: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ d = nest a (nest c (nest m (nest b e))) $ by eq_trans [eq_sym [l22], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l21]]]]]]
l24: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ Q = esat u E tp w $ by weaken [#7]
l25: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ a ∊ Q $ by welc_eq [eq_sym [l24], and_elim_l [l21]]
l26: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest c (nest m (nest b e)) ⇒ x7 = nest c (nest m (nest b e)) $ by ax
l27: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest c (nest m (nest b e)) ⇒ d = nest a (nest c (nest m (nest b e))) $ by weaken [l23]
l28: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest c (nest m (nest b e)) ⇒ a = a $ by eq_refl
l29: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest c (nest m (nest b e)) ⇒ d = nest a x7 $ by eq_trans [l27, nest_eq [l28, eq_sym [l26]]]
l30: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest c (nest m (nest b e)) ⇒ a ∊ Q $ by weaken [l25]
l31: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest c (nest m (nest b e)) ⇒ a ∊ Q ∧ d = nest a x7 $ by and_intro [l30, l29]
l32: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest c (nest m (nest b e)) ⇒ ∃ z (a ∊ Q ∧ d = nest a z) $ by ex_intro [l31]
l33: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) , x7 = nest c (nest m (nest b e)) ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_intro [l32]
l34: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset (nest c (nest m (nest b e))) $ by nest_set
l35: $ G , x6 = d , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by isset_elim [l34, l33]
l36: $ G , x6 = d , ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l37: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l36, l35]
l38: $ G , x6 = d , ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l39: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l38, l37]
l40: $ G , x6 = d , ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l41: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l40, l39]
l42: $ G , x6 = d , ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) ⇒ ∃ c ∃ m ∃ b ∃ e (a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e)))) $ by ax
l43: $ … ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l42, l41]
l44: $ G , x6 = d ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by ex_elim [l20, l43]
l45: $ G ⇒ isset d $ by isset_var
l46: $ G ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $ by isset_elim [l45, l44]

--| @freshen G p
--| @freshen G z
lemma f25_s2 {p z: set} (G: hyps) (E J V Q: class) (u w td tb tp tt tnp tF d s1: set): $ G ⇒ uadm u $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ityf td J tF $ > $ G ⇒ tF ∊ trees ω $ > $ G ⇒ ity u E td J w ∈ u $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ s1 ∊ esat u E tp w $ > $ G ⇒ Q = imots u E td w s1 V $ > $ G ⇒ d ∊ apn (irc u E td J V w) s1 $ > $ G ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $
----
l1: $ G ⇒ d ∈ apn (irc u E td J V w) s1 $ by welc_wcel [#9]
l2: $ G ⇒ isset d $ by isset_var
l3: $ G ⇒ nest s1 (d) ∈ irc u E td J V w $ by bi_elim_l [apn_wcel [l2], l1]
