l32: $ G , H ⇒ ((t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ qF ∃ qC ∃ qT ∃ qn_v ∃ qm_v ∃ qc_v ∃ x (t1 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_clen_c qC qc_v ∈ lrel ∧ ra_add qm_v qc_v x ∈ lrel)) → Cf $ by or_elim_imp [l8, l31]
l33: $ G , H ⇒ Cf $ by imp_elim [l32, l2]

def f23_mn_q (M J V N: class) (u w pp xs cv rr td tp tt tn tm tnp: set) (.y .k .d .m .h .q .r .n .l .i .v .a .o .f .g .b .e: set): class = $ {y | ∀ k ∀ d ∀ m ∀ h ∀ q ∀ r ∀ n (uadm u → w ∊ lvals → pp ∊ esat u (dnf u M) tp w → xs = ixs td w (ifam u (dnf u M) td w) → xs ∊ fseq u → cdm xs = nvf' tn → cv ∊ imots u (dnf u M) td w pp V → rr ∊ fseq u → td ∊ trees ω → ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) → intys td = nvf' tn → iprt td tp tt → ra_clen tp tnp ∈ lrel → ra_ntys tt tn tm ∈ lrel → ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) → ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) → ra_minors td tnp tn k d y m ∈ lrel → m ∊ ofsort lsig lopen ks_ctx → ra_ntys y q r ∈ lrel → nadd (nvf' d) (nvf' q) = nvf' tn → nadd (nvf' k) (nvf' r) = N → ∀ a ∀ f ∀ e (ra_nth_ty y a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) → ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx y a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' k))) → h ∊ fseq u → cdm h = nvf' k → n = h ++ cv ++ pp ++ rr → esat u (dsh u M n) m w = {l | l ∊ fseq u ∧ cdm l = nvf' r ∧ ∀ i (i ∊ N → nvf' k ⊆ i → vat (l ++ h) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})})} $

--| @freshen G l
--| @freshen G i
--| @freshen G v
--| @freshen G a
--| @freshen G o
--| @freshen G f
--| @freshen G g
--| @freshen G b
--| @freshen G e
lemma f23_mn_e {l i v a o f g b e: set} (G: hyps) (M J V N: class) (u w pp xs cv rr td tp tt tn tm tnp: set) (ty vk vd vm vh vq vr vn: set): $ G ⇒ ty ∊ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ pp ∊ esat u (dnf u M) tp w $ > $ G ⇒ xs = ixs td w (ifam u (dnf u M) td w) $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ cv ∊ imots u (dnf u M) td w pp V $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) $ > $ G ⇒ intys td = nvf' tn $ > $ G ⇒ iprt td tp tt $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) $ > $ G ⇒ ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) $ > $ G ⇒ ra_minors td tnp tn vk vd ty vm ∈ lrel $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ra_ntys ty vq vr ∈ lrel $ > $ G ⇒ nadd (nvf' vd) (nvf' vq) = nvf' tn $ > $ G ⇒ nadd (nvf' vk) (nvf' vr) = N $ > $ G ⇒ ∀ a ∀ f ∀ e (ra_nth_ty ty a f e ∈ lrel → ∃ b (ra_add a vd b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) $ > $ G ⇒ ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx ty a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' vd) ∧ nvf' o = nadd (nvf' e) (nvf' vk))) $ > $ G ⇒ vh ∊ fseq u $ > $ G ⇒ cdm vh = nvf' vk $ > $ G ⇒ vn = vh ++ cv ++ pp ++ rr $ > $ G ⇒ esat u (dsh u M vn) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vr ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $
----
l1: $ G ⇒ ∀ k ∀ d ∀ m ∀ h ∀ q ∀ r ∀ n (uadm u → w ∊ lvals → pp ∊ esat u (dnf u M) tp w → xs = ixs td w (ifam u (dnf u M) td w) → xs ∊ fseq u → cdm xs = nvf' tn → cv ∊ imots u (dnf u M) td w pp V → rr ∊ fseq u → td ∊ trees ω → ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) → intys td = nvf' tn → iprt td tp tt → ra_clen tp tnp ∈ lrel → ra_ntys tt tn tm ∈ lrel → ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) → ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) → ra_minors td tnp tn k d ty m ∈ lrel → m ∊ ofsort lsig lopen ks_ctx → ra_ntys ty q r ∈ lrel → nadd (nvf' d) (nvf' q) = nvf' tn → nadd (nvf' k) (nvf' r) = N → ∀ a ∀ f ∀ e (ra_nth_ty ty a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) → ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx ty a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' k))) → h ∊ fseq u → cdm h = nvf' k → n = h ++ cv ++ pp ++ rr → esat u (dsh u M n) m w = {l | l ∊ fseq u ∧ cdm l = nvf' r ∧ ∀ i (i ∊ N → nvf' k ⊆ i → vat (l ++ h) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})}) $ by cab_elim [#1]
l2: $ G ⇒ ∀ d ∀ m ∀ h ∀ q ∀ r ∀ n (uadm u → w ∊ lvals → pp ∊ esat u (dnf u M) tp w → xs = ixs td w (ifam u (dnf u M) td w) → xs ∊ fseq u → cdm xs = nvf' tn → cv ∊ imots u (dnf u M) td w pp V → rr ∊ fseq u → td ∊ trees ω → ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) → intys td = nvf' tn → iprt td tp tt → ra_clen tp tnp ∈ lrel → ra_ntys tt tn tm ∈ lrel → ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) → ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) → ra_minors td tnp tn vk d ty m ∈ lrel → m ∊ ofsort lsig lopen ks_ctx → ra_ntys ty q r ∈ lrel → nadd (nvf' d) (nvf' q) = nvf' tn → nadd (nvf' vk) (nvf' r) = N → ∀ a ∀ f ∀ e (ra_nth_ty ty a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) → ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx ty a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' vk))) → h ∊ fseq u → cdm h = nvf' vk → n = h ++ cv ++ pp ++ rr → esat u (dsh u M n) m w = {l | l ∊ fseq u ∧ cdm l = nvf' r ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ h) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})}) $ by all_elim [l1]
