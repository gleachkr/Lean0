l91: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel ⇒ crn (scons t ∅) ⊆ f45_nl_q  $ by crn_scons_tail [l90]
l92: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel ⇒ isset t $ by isset_var
l93: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel ⇒ t ∈ f45_nl_q  $ by crn_scons_head [l92, l91]
l94: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ t ∈ f45_nl_q  $ by weaken [l93]
l95: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ra_nth_ty t k vf ve ∈ lrel $ by weaken [l44]
l96: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf' k ∈ nvf' x4 $ by f45_nl_e [wcel_welc [l94], l95, l81]
l97: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ra_nth_ty t k vf ve ∈ lrel $ by weaken [l44]
l98: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ⟨ kr_nth_ty , scons t (scons k (scons vf (scons ve ∅))) ⟩ ∈ latoms $ by lrel_latoms [l97]
l99: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset ∅ $ by ax_empty
l100: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset (scons ve ∅) $ by scons_set [l99]
l101: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset (scons vf (scons ve ∅)) $ by scons_set [l100]
l102: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset (scons k (scons vf (scons ve ∅))) $ by scons_set [l101]
l103: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset (scons t (scons k (scons vf (scons ve ∅)))) $ by scons_set [l102]
l104: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ kr_nth_ty ∈ ω $ by kr_nth_ty_omega
l105: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ kr_nth_ty ∈ ω ∧ scons t (scons k (scons vf (scons ve ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l98, wcel_isset [l104], l103]
l106: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ crn (scons t (scons k (scons vf (scons ve ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l105]]
l107: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ crn (scons k (scons vf (scons ve ∅))) ⊆ trees ω $ by crn_scons_tail [l106]
l108: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset ω $ by omega_set
l109: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ k ∈ trees ω $ by crn_scons_head_trees [l108, l107]
l110: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ vi = ⟨ kc_s , scons k ∅ ⟩ $ by weaken [l43]
l111: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf' vi = suc (nvf' k) $ by eq_trans [fv_eq [l74, l110], nvf_s [l109]]
l112: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ suc (nvf' k) ∈ suc (nvf' x4) $ by omega_suc_mono_c [l73, l96]
l113: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf' vi ∈ nvf' vn $ by wcel_eq_l [eq_sym [l111], wcel_eq_r [eq_sym [l75], l112]]
l114: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel ⇒ nvf' vi ∈ nvf' vn $ by f21_inv_ntys [l45, l54, l113]
l115: $ G ⇒ nvf' vi ∈ nvf' vn $ by f21_inv_nth_ty [#5, l40, l114]

lemma f45_nl_all (G: hyps) : $ G ⇒ trees ω ⊆ f45_nl_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ , ra_nth_ty y i f e ∈ lrel , ra_ntys y n m ∈ lrel ⇒ crn x9 ⊆ f45_nl_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ , ra_nth_ty y i f e ∈ lrel , ra_ntys y n m ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ , ra_nth_ty y i f e ∈ lrel , ra_ntys y n m ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ , ra_nth_ty y i f e ∈ lrel , ra_ntys y n m ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ , ra_nth_ty y i f e ∈ lrel , ra_ntys y n m ∈ lrel ⇒ ra_nth_ty y i f e ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ , ra_nth_ty y i f e ∈ lrel , ra_ntys y n m ∈ lrel ⇒ ra_ntys y n m ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ , ra_nth_ty y i f e ∈ lrel , ra_ntys y n m ∈ lrel ⇒ nvf' i ∈ nvf' n $ by f45_nl_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ , ra_nth_ty y i f e ∈ lrel ⇒ ra_ntys y n m ∈ lrel → nvf' i ∈ nvf' n $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_nth_ty y i f e ∈ lrel → ra_ntys y n m ∈ lrel → nvf' i ∈ nvf' n $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ e (ra_nth_ty y i f e ∈ lrel → ra_ntys y n m ∈ lrel → nvf' i ∈ nvf' n) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ f ∀ e (ra_nth_ty y i f e ∈ lrel → ra_ntys y n m ∈ lrel → nvf' i ∈ nvf' n) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ m ∀ f ∀ e (ra_nth_ty y i f e ∈ lrel → ra_ntys y n m ∈ lrel → nvf' i ∈ nvf' n) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n ∀ m ∀ f ∀ e (ra_nth_ty y i f e ∈ lrel → ra_ntys y n m ∈ lrel → nvf' i ∈ nvf' n) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ i ∀ n ∀ m ∀ f ∀ e (ra_nth_ty y i f e ∈ lrel → ra_ntys y n m ∈ lrel → nvf' i ∈ nvf' n) $ by all_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f45_nl_q  $ by cab_intro [l14]
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f45_nl_q  $ by wcel_intro [l16, l15]
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l19: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f45_nl_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f45_nl_q  $ by isset_elim [l18, l17]
l20: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f45_nl_q  → ⟨ x8 , x9 ⟩ ∈ f45_nl_q  $ by imp_intro [imp_intro [imp_intro [l19]]]
l21: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f45_nl_q  → ⟨ x8 , x9 ⟩ ∈ f45_nl_q ) $ by all_intro [all_intro [l20]]
l22: $ G ⇒ isset ω $ by omega_set
l23: $ G ⇒ trees ω ⊆ f45_nl_q  $ by trees_ind_c [l22, l21]

nth_ty_lt
---------
l1: $ G ⇒ trees ω ⊆ f45_nl_q  $ by f45_nl_all
l2: $ G ⇒ ⟨ kr_nth_ty , scons tt (scons ti (scons tf (scons te ∅))) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons te ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tf (scons te ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons ti (scons tf (scons te ∅))) $ by scons_set [l5]
l7: $ G ⇒ isset (scons tt (scons ti (scons tf (scons te ∅)))) $ by scons_set [l6]
l8: $ G ⇒ kr_nth_ty ∈ ω $ by kr_nth_ty_omega
l9: $ G ⇒ kr_nth_ty ∈ ω ∧ scons tt (scons ti (scons tf (scons te ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l8], l7]
l10: $ G ⇒ crn (scons tt (scons ti (scons tf (scons te ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l9]]
l11: $ G ⇒ isset ω $ by omega_set
l12: $ G ⇒ tt ∈ trees ω $ by crn_scons_head_trees [l11, l10]
l13: $ G ⇒ tt ∊ f45_nl_q  $ by subset_elim [l1, wcel_welc [l12]]
l14: $ G ⇒ nvf' ti ∈ nvf' tn $ by f45_nl_e [l13, #1, #2]

iota_hook
---------
l1: $ G ⇒ iwf u H J tg td w r0 $ by weaken [#1]
l2: $ G ⇒ uadm u $ by iwf_uadm [l1]
l3: $ G ⇒ universe u $ by uadm_universe [l2]
l4: $ G ⇒ w ∊ lvals $ by wcel_welc [iwf_lvals [l1]]
l5: $ G ⇒ td ∊ trees ω $ by wcel_welc [lsig_ofsort_trees [wcel_welc [iwf_sort [l1]]]]
l6: $ G ⇒ functional H $ by iwf_fn [l1]
l7: $ G ⇒ ra_ind_wf tg td ∈ lrel3 J $ by iwf_wf [l1]
l8: $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ by weaken [#4]
l9: $ G ⇒ ra_clen tp tnp ∈ lrel $ by weaken [#5]
l10: $ G ⇒ ra_ntys tt tn tm ∈ lrel $ by weaken [#6]
l11: $ G ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ x8 ∃ x7 (ra_tys_wf td tn tnp x8 ⟨ kc_nz , ∅ ⟩ x7 tt ∈ lrel3 J) $ by f26_data [l7, l8, l9, l10]
l12: $ G ⇒ ra_tys_closed tp tt ∈ lrel $ by and_elim_l [l11]
l13: $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ by weaken [#7]
l14: $ G ⇒ ⟨ kr_motives , scons td (scons tnp (scons tv (scons ⟨ kc_nz , ∅ ⟩ (scons tt (scons tM ∅))))) ⟩ ∈ latoms $ by lrel_latoms [l13]
l15: $ G ⇒ isset ∅ $ by ax_empty
l16: $ G ⇒ isset (scons tM ∅) $ by scons_set [l15]
l17: $ G ⇒ isset (scons tt (scons tM ∅)) $ by scons_set [l16]
