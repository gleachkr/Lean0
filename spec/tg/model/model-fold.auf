l117: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ isset ∅ $ by ax_empty
l118: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ isset (scons tb ∅) $ by scons_set [l117]
l119: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ isset (scons j (scons tb ∅)) $ by scons_set [l118]
l120: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ kr_closed ∈ ω $ by kr_closed_omega
l121: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ kr_closed ∈ ω ∧ scons j (scons tb ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l116, wcel_isset [l120], l119]
l122: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ crn (scons j (scons tb ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l121]]
l123: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ crn (scons tb ∅) ⊆ trees ω $ by crn_scons_tail [l122]
l124: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ isset ω $ by omega_set
l125: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ tb ∈ trees ω $ by crn_scons_head_trees [l124, l123]
l126: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ ra_inst tk ta tc ta ∈ lrel $ by lrel_inst_closed [l79, l89, l115, l102, l104, and_elim_r [and_elim_r [l65]]]
l127: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ ra_inst tk tb tc tb ∈ lrel $ by lrel_inst_closed [l79, l89, l125, l102, l105, and_elim_r [and_elim_r [l65]]]
l128: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ t4 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ ∧ ra_inst tk ta tc ta ∈ lrel ∧ ra_inst tk tb tc tb ∈ lrel $ by and_intro [l68, and_intro [l126, l127]]
l129: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ ∃ y (t4 = ⟨ kc_app , scons ta (scons y ∅) ⟩ ∧ ra_inst tk ta tc ta ∈ lrel ∧ ra_inst tk tb tc y ∈ lrel) $ by ex_intro [l128]
l130: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed j x1 ∈ lrel ∧ ra_le j tk ∈ lrel ⇒ ∃ x ∃ y (t4 = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ ra_inst tk ta tc x ∈ lrel ∧ ra_inst tk tb tc y ∈ lrel) $ by ex_intro [l129]
l131: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons f (scons z (scons d ∅)) ⟩ ∧ ra_inst tk k tc d ∈ lrel ⇒ x1 = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons f (scons z (scons d ∅)) ⟩ ∧ ra_inst tk k tc d ∈ lrel $ by ax
l132: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons f (scons z (scons d ∅)) ⟩ ∧ ra_inst tk k tc d ∈ lrel ⇒ ⟨ kc_app , scons ta (scons tb ∅) ⟩ = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], and_elim_l [l131]]
l133: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons f (scons z (scons d ∅)) ⟩ ∧ ra_inst tk k tc d ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l134: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons f (scons z (scons d ∅)) ⟩ ∧ ra_inst tk k tc d ∈ lrel ⇒ kc_proj ∈ ω $ by kc_proj_omega
l135: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons f (scons z (scons d ∅)) ⟩ ∧ ra_inst tk k tc d ∈ lrel ⇒ kc_app = kc_proj $ by opair_inj_l_c [l132, wcel_isset [l133], wcel_isset [l134]]
l136: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons f (scons z (scons d ∅)) ⟩ ∧ ra_inst tk k tc d ∈ lrel ⇒ ¬ kc_app = kc_proj $ by kc_app_ne_proj
l137: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons f (scons z (scons k ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons f (scons z (scons d ∅)) ⟩ ∧ ra_inst tk k tc d ∈ lrel ⇒ ∃ x ∃ y (t4 = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ ra_inst tk ta tc x ∈ lrel ∧ ra_inst tk tb tc y ∈ lrel) $ by bot_elim [not_elim [l136, l135]]
l138: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ ⇒ ∃ x ∃ y (t4 = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ ra_inst tk ta tc x ∈ lrel ∧ ra_inst tk tb tc y ∈ lrel) $ by f21_inv_inst [l5, l13, l21, l29, l37, l50, l57, l64, l130, l137]
l139: $ G ⇒ isset ⟨ kc_app , scons ta (scons tb ∅) ⟩ $ by opair_isset
l140: $ G ⇒ ∃ x ∃ y (t4 = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ ra_inst tk ta tc x ∈ lrel ∧ ra_inst tk tb tc y ∈ lrel) $ by isset_elim [l139, l138]

def f28_pp_q (ta tb: set) (.y .i .r .x .z: set): class = $ {y | ∀ i ∀ r (ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons i ∅ ⟩ y tb z ∈ lrel))} $

--| @freshen G x
--| @freshen G z
lemma f28_pp_e {x z: set} (G: hyps) (ta tb: set) (ty vi vr: set): $ G ⇒ ty ∊ f28_pp_q ta tb $ > $ G ⇒ ra_pinst vi ty ⟨ kc_pi , scons ta (scons tb ∅) ⟩ vr ∈ lrel $ > $ G ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $
----
l1: $ G ⇒ ∀ i ∀ r (ra_pinst i ty ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst i ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons i ∅ ⟩ ty tb z ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r (ra_pinst vi ty ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel)) $ by all_elim [l1]
l3: $ G ⇒ ra_pinst vi ty ⟨ kc_pi , scons ta (scons tb ∅) ⟩ vr ∈ lrel → ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by imp_elim [l3, #2]

--| @freshen H qD
--| @freshen H qj_v
--| @freshen H qc_v
--| @freshen H qS
--| @freshen H qa_v
--| @freshen H qA1
lemma f21_inv_pinst {qD qj_v qc_v qS qa_v qA1: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_pinst t1 t2 t3 t4 ∈ lrel $ > $ H , t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t4 = t3 ⇒ Cf $ > $ H , t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t4 = t3 ⇒ Cf $ > $ H , t2 = ⟨ kc_app , scons qS (scons qa_v ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons t1 ∅ ⟩ qS t3 qA1 ∈ lrel ∧ ra_inst t1 qA1 qa_v t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_pinst t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qD ∃ qj_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) ∨ ∃ x ∃ qD ∃ qj_v ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) ∨ ∃ x ∃ qS ∃ qa_v ∃ y ∃ qA1 ∃ z (t1 = x ∧ t2 = ⟨ kc_app , scons qS (scons qa_v ∅) ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_pinst ⟨ kc_s , scons x ∅ ⟩ qS y qA1 ∈ lrel ∧ ra_inst x qA1 qa_v z ∈ lrel) $ by lrel_pinst_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y ⇒ t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y $ by ax
l4: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y ⇒ t4 = t3 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [l3]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]]]
l5: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y ⇒ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t4 = t3 $ by and_intro [and_elim_l [and_elim_r [l3]], l4]
l6: $ H ⇒ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t4 = t3 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y ⇒ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t4 = t3 → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H , ∃ qj_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ qj_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l12: $ … ⇒ Cf $ by ex_elim [l11, l10]
l13: $ G , H , ∃ qD ∃ qj_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ qD ∃ qj_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l14: $ … ⇒ Cf $ by ex_elim [l13, l12]
l15: $ G , H , ∃ x ∃ qD ∃ qj_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ x ∃ qD ∃ qj_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l16: $ … ⇒ Cf $ by ex_elim [l15, l14]
l17: $ G , H ⇒ (∃ x ∃ qD ∃ qj_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qj_v ∅) ⟩ ∧ t3 = y ∧ t4 = y)) → Cf $ by imp_intro [l16]
l18: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y ⇒ t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y $ by ax
l19: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y ⇒ t4 = t3 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [l18]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l18]]]]]
l20: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y ⇒ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t4 = t3 $ by and_intro [and_elim_l [and_elim_r [l18]], l19]
l21: $ H ⇒ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t4 = t3 → Cf $ by imp_intro [#3]
l22: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y ⇒ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t4 = t3 → Cf $ by weaken [l21]
l23: $ G , H , t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y ⇒ Cf $ by imp_elim [l22, l20]
l24: $ G , H , ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H , ∃ qj_v ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ qj_v ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l29: $ … ⇒ Cf $ by ex_elim [l28, l27]
l30: $ G , H , ∃ qD ∃ qj_v ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ qD ∃ qj_v ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l31: $ … ⇒ Cf $ by ex_elim [l30, l29]
l32: $ G , H , ∃ x ∃ qD ∃ qj_v ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) ⇒ ∃ x ∃ qD ∃ qj_v ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y) $ by ax
l33: $ … ⇒ Cf $ by ex_elim [l32, l31]
l34: $ G , H ⇒ (∃ x ∃ qD ∃ qj_v ∃ qc_v ∃ y (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qj_v (scons qc_v ∅)) ⟩ ∧ t3 = y ∧ t4 = y)) → Cf $ by imp_intro [l33]
l35: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qS (scons qa_v ∅) ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_pinst ⟨ kc_s , scons x ∅ ⟩ qS y qA1 ∈ lrel ∧ ra_inst x qA1 qa_v z ∈ lrel ⇒ t1 = x ∧ t2 = ⟨ kc_app , scons qS (scons qa_v ∅) ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_pinst ⟨ kc_s , scons x ∅ ⟩ qS y qA1 ∈ lrel ∧ ra_inst x qA1 qa_v z ∈ lrel $ by ax
l36: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qS (scons qa_v ∅) ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_pinst ⟨ kc_s , scons x ∅ ⟩ qS y qA1 ∈ lrel ∧ ra_inst x qA1 qa_v z ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l37: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qS (scons qa_v ∅) ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_pinst ⟨ kc_s , scons x ∅ ⟩ qS y qA1 ∈ lrel ∧ ra_inst x qA1 qa_v z ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l38: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qS (scons qa_v ∅) ⟩ ∧ t3 = y ∧ t4 = z ∧ ra_pinst ⟨ kc_s , scons x ∅ ⟩ qS y qA1 ∈ lrel ∧ ra_inst x qA1 qa_v z ∈ lrel ⇒ qS = qS $ by eq_refl
