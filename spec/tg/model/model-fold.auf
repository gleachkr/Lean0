l35: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ va = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset (scons tb ∅) $ by scons_set [l34]
l36: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ va = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset (scons tg (scons tb ∅)) $ by scons_set [l35]
l37: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ va = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ kr_clen ∈ ω $ by kr_clen_omega
