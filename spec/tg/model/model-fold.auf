l92: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ dt u M x1 w r = r' nvf' tf $ by eq_trans [dt_eq [l62, l63, l88, l65, l66], dt_bvar [welc_wcel [l89], l90, l91]]
l93: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ nvf' z0 = ∅ $ by weaken [#10]
l94: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ nvf' ty = nvf' ty $ by eq_refl
l95: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ dt u M tU w r = apn (r' nvf' tf) (swin r ∅ (nvf' ty)) $ by eq_trans [and_elim_r [l87], apn_eq [l92, swin_eq [l66, l93, l94]]]
l96: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ tX ∊ trees ω $ by weaken [#15]
l97: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ tU ∊ trees ω $ by weaken [#16]
l98: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ w ∊ lvals $ by weaken [#2]
l99: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ r ∊ fseq u $ by weaken [#3]
l100: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ dt u M ⟨ kc_app , scons tX (scons tU ∅) ⟩ w r = ap (dt u M tX w r) (dt u M tU w r) $ by dt_app [welc_wcel [l96], welc_wcel [l97], l98, l99]
l101: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ isset (apn (r' nvf' tf) (swin r ∅ (nvf' ty))) $ by weaken [l56]
l102: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ apn (r' nvf' tmj) (scons (apn (r' nvf' tf) (swin r ∅ (nvf' ty))) i) = ap (apn (r' nvf' tmj) i) (apn (r' nvf' tf) (swin r ∅ (nvf' ty))) $ by apn_scons_c [l101, welc_wcel [and_elim_l [and_elim_r [l57]]]]
l103: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ r' nvf' tmj = r' nvf' tmj $ by eq_refl
l104: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ apn (r' nvf' tf) (swin r ∅ (nvf' ty)) = apn (r' nvf' tf) (swin r ∅ (nvf' ty)) $ by eq_refl
l105: $ G , a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i ⇒ dt u M ⟨ kc_app , scons tX (scons tU ∅) ⟩ w r = apn (r' nvf' tmj) (scons (apn (r' nvf' tf) (swin r ∅ (nvf' ty))) (a ↾ nvf' tni)) $ by eq_trans [l100, eq_trans [ap_eq [l72, l95], eq_trans [eq_sym [l102], apn_eq [l103, scons_eq [l104, eq_sym [l61]]]]]]
l106: $ G , ∃ b (a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i) ⇒ ∃ b (a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M tX w r = apn (dt u M x0 w r) i) $ by ax
l107: $ … ⇒ dt u M ⟨ kc_app , scons tX (scons tU ∅) ⟩ w r = apn (r' nvf' tmj) (scons (apn (r' nvf' tf) (swin r ∅ (nvf' ty))) (a ↾ nvf' tni)) $ by ex_elim [l106, l105]
l108: $ G ⇒ dt u M ⟨ kc_app , scons tX (scons tU ∅) ⟩ w r = apn (r' nvf' tmj) (scons (apn (r' nvf' tf) (swin r ∅ (nvf' ty))) (a ↾ nvf' tni)) $ by ex_elim [l40, l107]

tpth_congr
----------
g1: $ ⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ≐ ⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ $ by ceqt_refl
g2: $ (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ A) ⟺ (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ B) $ by wcel_congr [g1, #1]
g3: $ (∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ A)) ⟺ (∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ B)) $ by ex_congr [g2]
g4: $ (∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ A)) ⟺ (∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ B)) $ by ex_congr [g3]
g5: $ (∃ g ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ A)) ⟺ (∃ g ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ B)) $ by ex_congr [g4]
g6: $ tpth A ≐ tpth B $ by cab_congr [g5]

sb_c_tpth
---------
l1: $ (⟦ x / t ⟧ {z | ∃ g ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ A)}) ≐ {z | ∃ g ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ (⟦ x / t ⟧ A))} $ by ceqt_refl

ihtb_congr
----------
g1: $ ⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ≐ ⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ $ by ceqt_refl
g2: $ (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ C) ⟺ (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ D) $ by wcel_congr [g1, #2]
g3: $ seqt l l $ by seqt_refl
g4: $ (f) ≐ (f) $ by ceqt_refl
g5: $ f ++ J ≐ f ++ K $ by scat_congr [g4, #5]
g6: $ apn H (f ++ J) ≐ apn I (f ++ K) $ by apn_congr [#4, g5]
g7: $ (o) ≐ (o) $ by ceqt_refl
g8: $ o ↾ L ≐ o ↾ N $ by cres_congr [g7, #6]
g9: $ scons (apn H (f ++ J)) (o ↾ L) ≐ scons (apn I (f ++ K)) (o ↾ N) $ by scons_congr [g6, g8]
g10: $ apn E (scons (apn H (f ++ J)) (o ↾ L)) ≐ apn F (scons (apn I (f ++ K)) (o ↾ N)) $ by apn_congr [#3, g9]
g11: $ (l ∊ apn E (scons (apn H (f ++ J)) (o ↾ L))) ⟺ (l ∊ apn F (scons (apn I (f ++ K)) (o ↾ N))) $ by welc_congr [g3, g10]
g12: $ (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ C ∧ l ∊ apn E (scons (apn H (f ++ J)) (o ↾ L))) ⟺ (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ D ∧ l ∊ apn F (scons (apn I (f ++ K)) (o ↾ N))) $ by and_congr [g2, g11]
g13: $ (∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ C ∧ l ∊ apn E (scons (apn H (f ++ J)) (o ↾ L)))) ⟺ (∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ D ∧ l ∊ apn F (scons (apn I (f ++ K)) (o ↾ N)))) $ by ex_congr [g12]
g14: $ (∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ C ∧ l ∊ apn E (scons (apn H (f ++ J)) (o ↾ L)))) ⟺ (∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ D ∧ l ∊ apn F (scons (apn I (f ++ K)) (o ↾ N)))) $ by ex_congr [g13]
g15: $ (∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ C ∧ l ∊ apn E (scons (apn H (f ++ J)) (o ↾ L)))) ⟺ (∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ D ∧ l ∊ apn F (scons (apn I (f ++ K)) (o ↾ N)))) $ by ex_congr [g14]
g16: $ {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ C ∧ l ∊ apn E (scons (apn H (f ++ J)) (o ↾ L)))} ≐ {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ D ∧ l ∊ apn F (scons (apn I (f ++ K)) (o ↾ N)))} $ by cab_congr [g15]
g17: $ fseq A ≐ fseq B $ by fseq_congr [#1]
g18: $ ihtb A C E H J L ≐ ihtb B D F I K N $ by clam_congr [g17, g16]

sb_c_ihtb
---------
l1: $ (⟦ x / t ⟧ (clam f (fseq A) {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ B ∧ l ∊ apn C (scons (apn D (f ++ E)) (o ↾ F)))})) ≐ clam f (fseq (⟦ x / t ⟧ A)) {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ (⟦ x / t ⟧ B) ∧ l ∊ apn (⟦ x / t ⟧ C) (scons (apn (⟦ x / t ⟧ D) (f ++ (⟦ x / t ⟧ E))) (o ↾ (⟦ x / t ⟧ F))))} $ by ceqt_refl

tpth_elim
---------
l1: $ G ⇒ ∃ g ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) $ by cab_elim [#1]

tpth_intro
----------
l1: $ G , g = A , h = B , o = C ⇒ g = A $ by ax
l2: $ G , g = A , h = B , o = C ⇒ h = B $ by ax
l3: $ G , g = A , h = B , o = C ⇒ o = C $ by ax
l4: $ G , g = A , h = B , o = C ⇒ z = z $ by eq_refl
l5: $ G , g = A , h = B , o = C ⇒ ⟨ z , ⟨ A , ⟨ B , C ⟩ ⟩ ⟩ ∈ Q $ by weaken [#1]
l6: $ G , g = A , h = B , o = C ⇒ ⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q $ by wcel_eq_l [opair_eq [l4, opair_eq [eq_sym [l1], opair_eq [eq_sym [l2], eq_sym [l3]]]], l5]
l7: $ G , g = A , h = B , o = C ⇒ ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) $ by ex_intro [l6]
l8: $ G , g = A , h = B , o = C ⇒ ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) $ by ex_intro [l7]
l9: $ G , g = A , h = B , o = C ⇒ ∃ g ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) $ by ex_intro [l8]
l10: $ G , g = A , h = B , o = C ⇒ z ∊ tpth Q $ by cab_intro [l9]
l11: $ G , g = A , h = B ⇒ isset C $ by weaken [#4]
l12: $ G , g = A , h = B ⇒ z ∊ tpth Q $ by isset_elim [l11, l10]
l13: $ G , g = A ⇒ isset B $ by weaken [#3]
l14: $ G , g = A ⇒ z ∊ tpth Q $ by isset_elim [l13, l12]
l15: $ G ⇒ isset A $ by weaken [#2]
l16: $ G ⇒ z ∊ tpth Q $ by isset_elim [l15, l14]

lemma f17_tps (G: hyps) (Q Q2: class): $ G ⇒ Q = Q2 $ > $ G ⇒ tpth Q ⊆ tpth Q2 $
----
l1: $ G , l ∊ tpth Q ⇒ l ∊ tpth Q $ by ax
l2: $ G , l ∊ tpth Q ⇒ ∃ g ∃ h ∃ o (⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) $ by cab_elim [l1]
l3: $ G , l ∊ tpth Q , ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ⇒ Q = Q2 $ by weaken [#1]
l4: $ G , l ∊ tpth Q , ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ⇒ ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q $ by ax
l5: $ G , l ∊ tpth Q , ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ⇒ ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 $ by wcel_eq_r [l3, l4]
l6: $ G , l ∊ tpth Q , ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ⇒ ∃ o (⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2) $ by ex_intro [l5]
l7: $ G , l ∊ tpth Q , ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ⇒ ∃ h ∃ o (⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2) $ by ex_intro [l6]
l8: $ G , l ∊ tpth Q , ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ⇒ ∃ g ∃ h ∃ o (⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2) $ by ex_intro [l7]
l9: $ G , l ∊ tpth Q , ⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ⇒ l ∊ tpth Q2 $ by cab_intro [l8]
l10: $ G , l ∊ tpth Q , ∃ o (⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) ⇒ ∃ o (⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) $ by ax
l11: $ … ⇒ l ∊ tpth Q2 $ by ex_elim [l10, l9]
l12: $ G , l ∊ tpth Q , ∃ h ∃ o (⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) ⇒ ∃ h ∃ o (⟨ l , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) $ by ax
l13: $ … ⇒ l ∊ tpth Q2 $ by ex_elim [l12, l11]
l14: $ G , l ∊ tpth Q ⇒ l ∊ tpth Q2 $ by ex_elim [l2, l13]
l15: $ G ⇒ tpth Q ⊆ tpth Q2 $ by subset_intro [l14]

tpth_eq
-------
l1: $ G ⇒ tpth Q = tpth Q2 $ by subset_antisym [f17_tps [#1], f17_tps [eq_sym [#1]]]

ihtb_elim
---------
l1: $ G ⇒ ap (clam f (fseq u) {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (f ++ E)) (o ↾ N)))}) s = {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} $ by clam_ap [#1]
l2: $ G ⇒ ap (ihtb u Q C V E N) s = {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} $ by weaken [l1]
l3: $ G ⇒ y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} $ by welc_eq [l2, #2]
l4: $ G ⇒ ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) $ by cab_elim [l3]

ihtb_intro
----------
l1: $ G , g = A , h = B , o = D ⇒ g = A $ by ax
l2: $ G , g = A , h = B , o = D ⇒ h = B $ by ax
l3: $ G , g = A , h = B , o = D ⇒ o = D $ by ax
l4: $ G , g = A , h = B , o = D ⇒ s = s $ by eq_refl
l5: $ G , g = A , h = B , o = D ⇒ ⟨ s , ⟨ A , ⟨ B , D ⟩ ⟩ ⟩ ∈ Q $ by weaken [#2]
l6: $ G , g = A , h = B , o = D ⇒ ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q $ by wcel_eq_l [opair_eq [l4, opair_eq [eq_sym [l1], opair_eq [eq_sym [l2], eq_sym [l3]]]], l5]
l7: $ G , g = A , h = B , o = D ⇒ C = C $ by eq_refl
l8: $ G , g = A , h = B , o = D ⇒ apn V (s ++ E) = apn V (s ++ E) $ by eq_refl
l9: $ G , g = A , h = B , o = D ⇒ N = N $ by eq_refl
l10: $ G , g = A , h = B , o = D ⇒ y ∊ apn C (scons (apn V (s ++ E)) (D ↾ N)) $ by weaken [#3]
l11: $ G , g = A , h = B , o = D ⇒ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) $ by welc_eq [apn_eq [l7, scons_eq [l8, cres_eq [eq_sym [l3], l9]]], l10]
l12: $ G , g = A , h = B , o = D ⇒ ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) $ by and_intro [l6, l11]
l13: $ G , g = A , h = B , o = D ⇒ ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) $ by ex_intro [l12]
l14: $ G , g = A , h = B , o = D ⇒ ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) $ by ex_intro [l13]
l15: $ G , g = A , h = B , o = D ⇒ ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) $ by ex_intro [l14]
l16: $ G , g = A , h = B , o = D ⇒ y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} $ by cab_intro [l15]
l17: $ G , g = A , h = B , o = D ⇒ s ∊ fseq u $ by weaken [#1]
l18: $ G , g = A , h = B , o = D ⇒ ap (clam f (fseq u) {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (f ++ E)) (o ↾ N)))}) s = {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} $ by clam_ap [l17]
l19: $ G , g = A , h = B , o = D ⇒ ap (ihtb u Q C V E N) s = {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} $ by weaken [l18]
l20: $ G , g = A , h = B , o = D ⇒ y ∊ ap (ihtb u Q C V E N) s $ by welc_eq [eq_sym [l19], l16]
l21: $ G , g = A , h = B ⇒ isset D $ by weaken [#6]
l22: $ G , g = A , h = B ⇒ y ∊ ap (ihtb u Q C V E N) s $ by isset_elim [l21, l20]
l23: $ G , g = A ⇒ isset B $ by weaken [#5]
l24: $ G , g = A ⇒ y ∊ ap (ihtb u Q C V E N) s $ by isset_elim [l23, l22]
l25: $ G ⇒ isset A $ by weaken [#4]
l26: $ G ⇒ y ∊ ap (ihtb u Q C V E N) s $ by isset_elim [l25, l24]

lemma f17_ibs {l g h o: set} (G: hyps) (Q Q2 C C2 V V2 E E2 N N2: class) (s: set): $ G ⇒ Q = Q2 $ > $ G ⇒ C = C2 $ > $ G ⇒ V = V2 $ > $ G ⇒ E = E2 $ > $ G ⇒ N = N2 $ > $ G ⇒ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} ⊆ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2)))} $
----
l1: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} ⇒ y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} $ by ax
l2: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} ⇒ ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) $ by cab_elim [l1]
l3: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) $ by ax
l4: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ Q = Q2 $ by weaken [#1]
l5: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 $ by wcel_eq_r [l4, and_elim_l [l3]]
l6: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ C = C2 $ by weaken [#2]
l7: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ V = V2 $ by weaken [#3]
l8: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ s = s $ by eq_refl
l9: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ E = E2 $ by weaken [#4]
l10: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ o = o $ by eq_refl
l11: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ N = N2 $ by weaken [#5]
l12: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ y ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2)) $ by welc_eq [apn_eq [l6, scons_eq [apn_eq [l7, scat_eq [l8, l9]], cres_eq [l10, l11]]], and_elim_r [l3]]
l13: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ y ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2)) $ by and_intro [l5, l12]
l14: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ y ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2))) $ by ex_intro [l13]
l15: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ y ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2))) $ by ex_intro [l14]
l16: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ y ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2))) $ by ex_intro [l15]
l17: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)) ⇒ y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2)))} $ by cab_intro [l16]
l18: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) ⇒ ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) $ by ax
l19: $ … ⇒ y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2)))} $ by ex_elim [l18, l17]
l20: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} , ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) ⇒ ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (s ++ E)) (o ↾ N))) $ by ax
l21: $ … ⇒ y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2)))} $ by ex_elim [l20, l19]
l22: $ G , y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} ⇒ y ∊ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2)))} $ by ex_elim [l2, l21]
l23: $ G ⇒ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (s ++ E)) (o ↾ N)))} ⊆ {l | ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (s ++ E2)) (o ↾ N2)))} $ by subset_intro [l22]

ihtb_eq
-------
l1: $ G , f ∊ fseq U ⇒ Q = Q2 $ by weaken [#1]
l2: $ G , f ∊ fseq U ⇒ C = C2 $ by weaken [#2]
l3: $ G , f ∊ fseq U ⇒ V = V2 $ by weaken [#3]
l4: $ G , f ∊ fseq U ⇒ E = E2 $ by weaken [#4]
l5: $ G , f ∊ fseq U ⇒ N = N2 $ by weaken [#5]
l6: $ G , f ∊ fseq U ⇒ {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (f ++ E)) (o ↾ N)))} ⊆ {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (f ++ E2)) (o ↾ N2)))} $ by f17_ibs [l1, l2, l3, l4, l5]
l7: $ G , f ∊ fseq U ⇒ Q2 = Q $ by eq_sym [weaken [#1]]
l8: $ G , f ∊ fseq U ⇒ C2 = C $ by eq_sym [weaken [#2]]
l9: $ G , f ∊ fseq U ⇒ V2 = V $ by eq_sym [weaken [#3]]
l10: $ G , f ∊ fseq U ⇒ E2 = E $ by eq_sym [weaken [#4]]
l11: $ G , f ∊ fseq U ⇒ N2 = N $ by eq_sym [weaken [#5]]
l12: $ G , f ∊ fseq U ⇒ {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (f ++ E2)) (o ↾ N2)))} ⊆ {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (f ++ E)) (o ↾ N)))} $ by f17_ibs [l7, l8, l9, l10, l11]
l13: $ G , f ∊ fseq U ⇒ {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (f ++ E)) (o ↾ N)))} = {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (f ++ E2)) (o ↾ N2)))} $ by subset_antisym [l6, l12]
l14: $ G ⇒ ∀ f (f ∊ fseq U → {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (f ++ E)) (o ↾ N)))} = {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (f ++ E2)) (o ↾ N2)))}) $ by all_intro [imp_intro [l13]]
l15: $ G ⇒ clam f (fseq U) {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (f ++ E)) (o ↾ N)))} = clam f (fseq U) {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q2 ∧ l ∊ apn C2 (scons (apn V2 (f ++ E2)) (o ↾ N2)))} $ by clam_eq_body [l14]
l16: $ G ⇒ ihtb U Q C V E N = ihtb U Q2 C2 V2 E2 N2 $ by weaken [l15]

fpi_one
-------
l1: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ o = ∅ $ by ax
l2: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ ∅ ∈ Q $ by weaken [#1]
l3: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ o ∊ Q $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ l ∊ fpi q Q (ap T q) $ by ax
l5: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ apn l o ∈ ap T o $ by fpi_ap [l4, l3]
l6: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ T = T $ by eq_refl
l7: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ l = l $ by eq_refl
l8: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ apn l ∅ = l $ by apn_empty
l9: $ G , l ∊ fpi q Q (ap T q) , o = ∅ ⇒ l ∊ ap T ∅ $ by wcel_welc [wcel_eq_r [ap_eq [l6, l1], wcel_eq_l [eq_trans [apn_eq [l7, l1], l8], l5]]]
l10: $ G , l ∊ fpi q Q (ap T q) ⇒ isset ∅ $ by ax_empty
l11: $ G , l ∊ fpi q Q (ap T q) ⇒ l ∊ ap T ∅ $ by isset_elim [l10, l9]
l12: $ G , l ∊ ap T ∅ , z ∊ l , o = ∅ ⇒ o = ∅ $ by ax
l13: $ G , l ∊ ap T ∅ , z ∊ l , o = ∅ ⇒ ∅ ∈ Q $ by weaken [#1]
l14: $ G , l ∊ ap T ∅ , z ∊ l , o = ∅ ⇒ o ∊ Q $ by wcel_welc [wcel_eq_l [eq_sym [l12], l13]]
l15: $ G , l ∊ ap T ∅ , z ∊ l , o = ∅ ⇒ z = z $ by eq_refl
l16: $ G , l ∊ ap T ∅ , z ∊ l , o = ∅ ⇒ isset z $ by isset_var
l17: $ G , l ∊ ap T ∅ , z ∊ l , o = ∅ ⇒ z = nest o z $ by eq_sym [eq_trans [nest_eq [l12, l15], nest_empty [l16]]]
l18: $ G , l ∊ ap T ∅ , z ∊ l , o = ∅ ⇒ ∃ y (o ∊ Q ∧ z = nest o y) $ by ex_intro [and_intro [l14, l17]]
l19: $ G , l ∊ ap T ∅ , z ∊ l , o = ∅ ⇒ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by ex_intro [l18]
l20: $ G , l ∊ ap T ∅ , z ∊ l ⇒ isset ∅ $ by ax_empty
l21: $ G , l ∊ ap T ∅ , z ∊ l ⇒ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by isset_elim [l20, l19]
l22: $ G , l ∊ ap T ∅ ⇒ ∀ z (z ∊ l → ∃ q ∃ y (q ∊ Q ∧ z = nest q y)) $ by all_intro [imp_intro [l21]]
l23: $ G , l ∊ ap T ∅ , q ∊ Q ⇒ ∀ q (q ∊ Q → q = ∅) $ by weaken [#2]
l24: $ G , l ∊ ap T ∅ , q ∊ Q ⇒ q ∊ Q $ by ax
l25: $ G , l ∊ ap T ∅ , q ∊ Q ⇒ q = ∅ $ by imp_elim [all_elim [l23], l24]
l26: $ G , l ∊ ap T ∅ , q ∊ Q ⇒ T = T $ by eq_refl
l27: $ G , l ∊ ap T ∅ , q ∊ Q ⇒ l = l $ by eq_refl
l28: $ G , l ∊ ap T ∅ , q ∊ Q ⇒ apn l ∅ = l $ by apn_empty
l29: $ G , l ∊ ap T ∅ , q ∊ Q ⇒ l ∊ ap T ∅ $ by ax
l30: $ G , l ∊ ap T ∅ , q ∊ Q ⇒ apn l q ∈ ap T q $ by wcel_eq_r [ap_eq [l26, eq_sym [l25]], wcel_eq_l [eq_sym [eq_trans [apn_eq [l27, l25], l28]], welc_wcel [l29]]]
l31: $ G , l ∊ ap T ∅ ⇒ ∀ q (q ∊ Q → apn l q ∈ ap T q) $ by all_intro [imp_intro [l30]]
l32: $ G , l ∊ ap T ∅ ⇒ l ∊ fpi q Q (ap T q) $ by fpi_intro [l22, l31]
l33: $ G ⇒ fpi q Q (ap T q) = ap T ∅ $ by subset_antisym [subset_intro [l11], subset_intro [l32]]

etel_set
--------
l1: $ G ⇒ functional (etf u E) $ by etf_functional
l2: $ G ⇒ isset (da ((etf u E)' T) W R) $ by da_set [fv_set_c [l1, #1]]
l3: $ G ⇒ isset (etel u E T W R) $ by weaken [l2]

sarg_set
--------
l1: $ G , x ∊ sarg u E T W R ⇒ x ∊ sarg u E T W R $ by ax
l2: $ G , x ∊ sarg u E T W R ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u E T W R ∧ x ∈ a) $ by cab_elim [l1]
l3: $ G , x ∊ sarg u E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u E T W R ∧ x ∈ a ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u E T W R ∧ x ∈ a $ by ax
