l40: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_pi , scons v (scons w ∅) ⟩ ∧ ra_closed tx v ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ w ∈ lrel ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by bot_elim [not_elim [l39, l38]]
l41: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ $ by ax
l42: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ ⟨ kc_bvar , scons ti ∅ ⟩ = ⟨ kc_cst , scons u (scons a ∅) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l41]
l43: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l44: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ kc_cst ∈ ω $ by kc_cst_omega
l45: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ kc_bvar = kc_cst $ by opair_inj_l_c [l42, wcel_isset [l43], wcel_isset [l44]]
l46: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ ¬ kc_bvar = kc_cst $ by kc_bvar_ne_cst
l47: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_cst , scons u (scons a ∅) ⟩ ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by bot_elim [not_elim [l46, l45]]
l48: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ x1 = ⟨ kc_lit , scons b ∅ ⟩ $ by ax
l49: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ ⟨ kc_bvar , scons ti ∅ ⟩ = ⟨ kc_lit , scons b ∅ ⟩ $ by eq_trans [eq_sym [weaken [l1]], l48]
l50: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l51: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ kc_lit ∈ ω $ by kc_lit_omega
l52: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ kc_bvar = kc_lit $ by opair_inj_l_c [l49, wcel_isset [l50], wcel_isset [l51]]
l53: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ ¬ kc_bvar = kc_lit $ by kc_bvar_ne_lit
l54: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_lit , scons b ∅ ⟩ ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by bot_elim [not_elim [l53, l52]]
l55: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ $ by ax
l56: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ ⟨ kc_bvar , scons ti ∅ ⟩ = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l55]
l57: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l58: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ kc_ind_ty ∈ ω $ by kc_ind_ty_omega
l59: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ kc_bvar = kc_ind_ty $ by opair_inj_l_c [l56, wcel_isset [l57], wcel_isset [l58]]
l60: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ ¬ kc_bvar = kc_ind_ty $ by kc_bvar_ne_ind_ty
l61: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ty , scons c (scons x ∅) ⟩ ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by bot_elim [not_elim [l60, l59]]
l62: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ $ by ax
l63: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ⟨ kc_bvar , scons ti ∅ ⟩ = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l62]
l64: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l65: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_ind_ctor ∈ ω $ by kc_ind_ctor_omega
l66: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ kc_bvar = kc_ind_ctor $ by opair_inj_l_c [l63, wcel_isset [l64], wcel_isset [l65]]
l67: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ¬ kc_bvar = kc_ind_ctor $ by kc_bvar_ne_ind_ctor
l68: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_ctor , scons c (scons x (scons f ∅)) ⟩ ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by bot_elim [not_elim [l67, l66]]
l69: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ $ by ax
l70: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ⟨ kc_bvar , scons ti ∅ ⟩ = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], l69]
l71: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l72: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_ind_rec ∈ ω $ by kc_ind_rec_omega
l73: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ kc_bvar = kc_ind_rec $ by opair_inj_l_c [l70, wcel_isset [l71], wcel_isset [l72]]
l74: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ¬ kc_bvar = kc_ind_rec $ by kc_bvar_ne_ind_rec
l75: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_ind_rec , scons c (scons x (scons g ∅)) ⟩ ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by bot_elim [not_elim [l74, l73]]
l76: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel $ by ax
l77: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ⟨ kc_bvar , scons ti ∅ ⟩ = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ $ by eq_trans [eq_sym [weaken [l1]], and_elim_l [l76]]
l78: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l79: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_proj ∈ ω $ by kc_proj_omega
l80: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ kc_bvar = kc_proj $ by opair_inj_l_c [l77, wcel_isset [l78], wcel_isset [l79]]
l81: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ¬ kc_bvar = kc_proj $ by kc_bvar_ne_proj
l82: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ , x1 = ⟨ kc_proj , scons w (scons x (scons i ∅)) ⟩ ∧ ra_closed tx i ∈ lrel ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by bot_elim [not_elim [l81, l80]]
l111: $ G , x1 = ⟨ kc_bvar , scons ti ∅ ⟩ ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by f21_inv_closed [l3, l12, l19, l26, l33, l40, l47, l54, l61, l68, l75, l82]
l112: $ G ⇒ isset ⟨ kc_bvar , scons ti ∅ ⟩ $ by opair_isset
l113: $ G ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $ by isset_elim [l112, l111]

def f30_sp_q (td tn: set) (.y .j .k .a .b .z .x .c: set): class = $ {y | ∀ j ∀ k ∀ a ∀ b ∀ z (ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_pi , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn ⟨ kc_s , scons k ∅ ⟩ b c ∈ lrel))} $

--| @freshen G x
--| @freshen G c
lemma f30_sp_e {x c: set} (G: hyps) (td tn: set) (ty vj vk va vb vz: set): $ G ⇒ ty ∊ f30_sp_q td tn $ > $ G ⇒ ra_add vj ty tn ∈ lrel $ > $ G ⇒ ra_sinst td vj tn vk ⟨ kc_pi , scons va (scons vb ∅) ⟩ vz ∈ lrel $ > $ G ⇒ ∃ x ∃ c (vz = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons vk ∅ ⟩ vb c ∈ lrel) $
----
l1: $ G ⇒ ∀ j ∀ k ∀ a ∀ b ∀ z (ra_add j ty tn ∈ lrel → ra_sinst td j tn k ⟨ kc_pi , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn ⟨ kc_s , scons k ∅ ⟩ b c ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ k ∀ a ∀ b ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn k ⟨ kc_pi , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn k a x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons k ∅ ⟩ b c ∈ lrel)) $ by all_elim [l1]
l3: $ G ⇒ ∀ a ∀ b ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_pi , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk a x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons vk ∅ ⟩ b c ∈ lrel)) $ by all_elim [l2]
l4: $ G ⇒ ∀ b ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_pi , scons va (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons vk ∅ ⟩ b c ∈ lrel)) $ by all_elim [l3]
l5: $ G ⇒ ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_pi , scons va (scons vb ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons vk ∅ ⟩ vb c ∈ lrel)) $ by all_elim [l4]
l6: $ G ⇒ ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_pi , scons va (scons vb ∅) ⟩ vz ∈ lrel → ∃ x ∃ c (vz = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons vk ∅ ⟩ vb c ∈ lrel) $ by all_elim [l5]
l7: $ G ⇒ ra_sinst td vj tn vk ⟨ kc_pi , scons va (scons vb ∅) ⟩ vz ∈ lrel → ∃ x ∃ c (vz = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons vk ∅ ⟩ vb c ∈ lrel) $ by imp_elim [l6, #2]
l8: $ G ⇒ ∃ x ∃ c (vz = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons vk ∅ ⟩ vb c ∈ lrel) $ by imp_elim [l7, #3]

--| @freshen H qe1
lemma f21_inv_sinst {qe1: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6: set): $ G ⇒ ra_sinst t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ H , t3 = t2 ∧ t6 = t5 ⇒ Cf $ > $ H , ra_le ⟨ kc_s , scons t2 ∅ ⟩ t3 ∈ lrel ∧ ra_inst t4 t5 ⟨ kc_ind_ty , scons t1 (scons t2 ∅) ⟩ qe1 ∈ lrel ∧ ra_sinst t1 ⟨ kc_s , scons t2 ∅ ⟩ t3 t4 qe1 t6 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_sinst t1 t2 t3 t4 t5 t6 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) ∨ ∃ x ∃ v ∃ y ∃ z ∃ u ∃ qe1 ∃ w (t1 = x ∧ t2 = v ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = w ∧ ra_le ⟨ kc_s , scons v ∅ ⟩ y ∈ lrel ∧ ra_inst z u ⟨ kc_ind_ty , scons x (scons v ∅) ⟩ qe1 ∈ lrel ∧ ra_sinst x ⟨ kc_s , scons v ∅ ⟩ y z qe1 w ∈ lrel) $ by lrel_sinst_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u ⇒ t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u ⇒ t3 = t2 $ by eq_trans [and_elim_l [and_elim_r [and_elim_r [l3]]], eq_sym [and_elim_l [and_elim_r [l3]]]]
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u ⇒ t6 = t5 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u ⇒ t3 = t2 ∧ t6 = t5 $ by and_intro [l4, l5]
l7: $ H ⇒ t3 = t2 ∧ t6 = t5 → Cf $ by imp_intro [#2]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u ⇒ t3 = t2 ∧ t6 = t5 → Cf $ by weaken [l7]
l9: $ G , H , t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u ⇒ Cf $ by imp_elim [l8, l6]
l10: $ G , H , ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) ⇒ ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) $ by ax
l11: $ … ⇒ Cf $ by ex_elim [l10, l9]
l12: $ G , H , ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) ⇒ ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) ⇒ ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H , ∃ x ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) ⇒ ∃ x ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u) $ by ax
l17: $ … ⇒ Cf $ by ex_elim [l16, l15]
l18: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = u)) → Cf $ by imp_intro [l17]
l19: $ G , H , t1 = x ∧ t2 = v ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = w ∧ ra_le ⟨ kc_s , scons v ∅ ⟩ y ∈ lrel ∧ ra_inst z u ⟨ kc_ind_ty , scons x (scons v ∅) ⟩ qe1 ∈ lrel ∧ ra_sinst x ⟨ kc_s , scons v ∅ ⟩ y z qe1 w ∈ lrel ⇒ t1 = x ∧ t2 = v ∧ t3 = y ∧ t4 = z ∧ t5 = u ∧ t6 = w ∧ ra_le ⟨ kc_s , scons v ∅ ⟩ y ∈ lrel ∧ ra_inst z u ⟨ kc_ind_ty , scons x (scons v ∅) ⟩ qe1 ∈ lrel ∧ ra_sinst x ⟨ kc_s , scons v ∅ ⟩ y z qe1 w ∈ lrel $ by ax
