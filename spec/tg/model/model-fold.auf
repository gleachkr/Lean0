l52: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , i ∊ nvf' te ⇒ i ∊ ω → o' (nadd (nvf' th) i) = r' i $ by all_elim [l51]
l53: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , i ∊ nvf' te ⇒ o' (nadd (nvf' th) i) = r' i $ by imp_elim [l52, wcel_welc [l50]]
l54: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , i ∊ nvf' te ⇒ nadd ∅ i = i $ by zero_nadd [wcel_welc [l50]]
l55: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , i ∊ nvf' te ⇒ r = r $ by eq_refl
l56: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , i ∊ nvf' te ⇒ o' (nadd (nvf' th) i) = r' (nadd ∅ i) $ by eq_trans [l53, fv_eq [l55, eq_sym [l54]]]
l57: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ i ∊ nvf' te → o' (nadd (nvf' th) i) = r' (nadd ∅ i) $ by imp_intro [l56]
l58: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ ∀ i (i ∊ nvf' te → o' (nadd (nvf' th) i) = r' (nadd ∅ i)) $ by all_intro [l57]
l59: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ swin o (nvf' th) (nvf' te) = swin r ∅ (nvf' te) $ by swin_sh [l58]
l60: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ by weaken [#5]
l61: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ esat u (dnf u (mcv H)) tp w ⊆ fseq u $ by esat_fseq
l62: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ p ∊ fseq u $ by subset_elim [l61, l60]
l63: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ ra_clen tp te ∈ lrel $ by weaken [#4]
l64: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ tp ∊ trees ω $ by weaken [l6]
l65: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ cdm p = nvf' te $ by esat_clen_c [l63, l64, l60]
l66: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ p ++ ixs td w zc ∈ fseq u $ by weaken [l3]
l67: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ p = p $ by eq_refl
l68: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ p ++ l ∈ fseq u $ by wcel_eq_l [scat_eq [l67, eq_sym [l38]], l66]
l69: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ swin (p ++ l) ∅ (cdm p) = p $ by swin_scat_head [l68, l62]
