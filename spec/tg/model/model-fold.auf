l122: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w , l ∊ imq u (dnf u M) td Jc w p , ityf td Jc b , ⟨ c , ⟨ d , ⟨ h , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) b w p , m ∊ apn (ity u (dnf u M) td Jc w) (c ++ p) , l = scons m c ⇒ ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ m ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ m ∊ u ∧ l = scons m c) $ by ex_intro [l121]
l123: $ G , v = p ++ rr , t = ity u (dnf u M) td Jc w , l ∊ imq u (dnf u M) td Jc w p , ityf td Jc b , ⟨ c , ⟨ d , ⟨ h , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) b w p , m ∊ apn (ity u (dnf u M) td Jc w) (c ++ p) , l = scons m c ⇒ ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tf2 w r ∧ m ∊ ap (clam f (fseq u) (apn (ity u (dnf u M) td Jc w) (f ++ g ++ p))) c ∧ m ∊ u ∧ l = scons m c) $ by ex_intro [l122]
