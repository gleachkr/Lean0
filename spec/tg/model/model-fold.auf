l63: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s3 = m $ by and_elim_l [l62]
l64: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ d = nest b e $ by and_elim_r [l62]
l65: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ td = td $ by eq_refl
