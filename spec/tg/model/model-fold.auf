l57: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_inst tk a tc c ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ b tc f ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l58: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_inst tk a tc c ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ b tc f ∈ lrel ⇒ kc_ind_ty = kc_pi $ by opair_inj_l_c [l55, wcel_isset [l56], wcel_isset [l57]]
l59: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_inst tk a tc c ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ b tc f ∈ lrel ⇒ ¬ kc_pi = kc_ind_ty $ by kc_pi_ne_ind_ty
l60: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_inst tk a tc c ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ b tc f ∈ lrel ⇒ ¬ kc_ind_ty = kc_pi $ by ne_sym [l59]
l61: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_inst tk a tc c ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ b tc f ∈ lrel ⇒ t4 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by bot_elim [not_elim [l60, l58]]
l62: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed g x1 ∈ lrel ∧ ra_le g tk ∈ lrel ⇒ t4 = x1 ∧ ra_closed g x1 ∈ lrel ∧ ra_le g tk ∈ lrel $ by ax
l63: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed g x1 ∈ lrel ∧ ra_le g tk ∈ lrel ⇒ x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by weaken [l1]
l64: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , t4 = x1 ∧ ra_closed g x1 ∈ lrel ∧ ra_le g tk ∈ lrel ⇒ ra_inst tk x1 tc t4 ∈ lrel $ by weaken [l5]
