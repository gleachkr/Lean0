lemma f23_mn_n {l i v a o f g b e: set} (G: hyps) (M J V N: class) (u w pp xs cv rr td tp tt tn tm tnp: set) (ty k1 j1 vk vd vm vh vq vr vn: set): $ G ⇒ crn j1 ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ pp ∊ esat u (dnf u M) tp w $ > $ G ⇒ xs = ixs td w (ifam u (dnf u M) td w) $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ cv ∊ imots u (dnf u M) td w pp V $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) $ > $ G ⇒ intys td = nvf' tn $ > $ G ⇒ iprt td tp tt $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) $ > $ G ⇒ ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) $ > $ G ⇒ ra_minors td tnp tn vk vd ty vm ∈ lrel $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ra_ntys ty vq vr ∈ lrel $ > $ G ⇒ nadd (nvf' vd) (nvf' vq) = nvf' tn $ > $ G ⇒ nadd (nvf' vk) (nvf' vr) = N $ > $ G ⇒ ∀ a ∀ f ∀ e (ra_nth_ty ty a f e ∈ lrel → ∃ b (ra_add a vd b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) $ > $ G ⇒ ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx ty a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' vd) ∧ nvf' o = nadd (nvf' e) (nvf' vk))) $ > $ G ⇒ vh ∊ fseq u $ > $ G ⇒ cdm vh = nvf' vk $ > $ G ⇒ vn = vh ++ cv ++ pp ++ rr $ > $ G ⇒ esat u (dsh u M vn) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vr ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $
----
l1: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ ⇒ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ $ by ax
