lemma f18_mqs (G: hyps) (Q Q2 D K L X X2 Y Y2 N: class): $ G ⇒ Q = Q2 $ > $ G ⇒ X = X2 $ > $ G ⇒ Y = Y2 $ > $ G ⇒ mqp Q D K L X Y N ⊆ mqp Q2 D K L X2 Y2 N $
----
l1: $ G , l ∊ mqp Q D K L X Y N ⇒ l ∊ mqp Q D K L X Y N $ by ax
l2: $ G , l ∊ mqp Q D K L X Y N ⇒ ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ l = h ++ f) $ by cab_elim [l1]
l3: $ G , l ∊ mqp Q D K L X Y N , ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ l = h ++ f ⇒ ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ l = h ++ f $ by ax
l4: $ G , l ∊ mqp Q D K L X Y N , ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ l = h ++ f ⇒ Q = Q2 $ by weaken [#1]
l5: $ G , l ∊ mqp Q D K L X Y N , ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ l = h ++ f ⇒ ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q2 $ by wcel_eq_r [l4, and_elim_l [l3]]
l6: $ G , l ∊ mqp Q D K L X Y N , ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ l = h ++ f ⇒ D = D $ by eq_refl
l7: $ G , l ∊ mqp Q D K L X Y N , ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ l = h ++ f ⇒ K = K $ by eq_refl
l8: $ G , l ∊ mqp Q D K L X Y N , ⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ l = h ++ f ⇒ L = L $ by eq_refl
