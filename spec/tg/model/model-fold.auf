l239: $ G , H ⇒ (∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l154, l238]
l240: $ G , H ⇒ (∃ x ∃ qI ∃ y ∃ qj_v ∃ qc_v ∃ qi_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qnpi ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qY ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ctor , scons x (scons qj_v (scons qc_v ∅)) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ ⟨ kc_ind_ctor , scons qI (scons qi_v (scons qc_v ∅)) ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l130, l239]
l241: $ G , H ⇒ (∃ x ∃ y ∃ qj_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ qI ∃ y ∃ qj_v ∃ qc_v ∃ qi_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qnpi ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qY ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ctor , scons x (scons qj_v (scons qc_v ∅)) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ ⟨ kc_ind_ctor , scons qI (scons qi_v (scons qc_v ∅)) ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l66, l240]
l242: $ G , H ⇒ (∃ x ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = qe_v ∧ t4 = qe_v) ∨ ∃ x ∃ y ∃ qj_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ty , scons x (scons qj_v ∅) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_rehead qS qX2 qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ qI ∃ y ∃ qj_v ∃ qc_v ∃ qi_v ∃ qnp ∃ qn_v ∃ qm_v ∃ qna ∃ qk_v ∃ qnpi ∃ qe_v ∃ qS ∃ qX ∃ qX1 ∃ qX2 ∃ qY ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe2 ∧ ra_spine ⟨ kc_ind_ctor , scons x (scons qj_v (scons qc_v ∅)) ⟩ qe_v qna ∈ lrel ∧ ra_aux_of x y qj_v qX ∈ lrel ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qX qX1 ∈ lrel ∧ ra_add qnp qk_v qna ∈ lrel ∧ ra_spine qS qe_v qk_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ qS qX1 qX2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ qX2 qnpi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons qI (scons qi_v ∅) ⟩ ⟨ kc_ind_ctor , scons qI (scons qi_v (scons qc_v ∅)) ⟩ qnpi qX2 qY ∈ lrel ∧ ra_rehead qS qY qk_v qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_rst x y qf_v qf2 ∈ lrel ∧ ra_rst x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_rst x y qA qA2 ∈ lrel ∧ ra_rst x y qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_rst x y qe_v qe2 ∈ lrel) ∨ ∃ x ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v)) → Cf $ by or_elim_imp [l13, l241]
l243: $ G , H ⇒ Cf $ by imp_elim [l242, l2]

--| @freshen H qnp
--| @freshen H qn_v
--| @freshen H qm_v
--| @freshen H qn0
--| @freshen H qk_v
lemma f21_inv_aux_of {qnp qn_v qm_v qn0 qk_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_aux_of t1 t2 t3 t4 ∈ lrel $ > $ H , ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_ndecl t2 qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v t3 ∈ lrel ∧ ra_cnth t2 qk_v t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_aux_of t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by lrel_aux_of_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ qnp = qnp $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ qn_v = qn_v $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ qm_v = qm_v $ by eq_refl
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel $ by wcel_eq_l [ra_ind_arity_eq [eq_sym [and_elim_l [l3]], l4, l5, l6], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ qn0 = qn0 $ by eq_refl
l9: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ ra_ndecl t2 qn_v qn0 ∈ lrel $ by wcel_eq_l [ra_ndecl_eq [eq_sym [and_elim_l [and_elim_r [l3]]], l5, l8], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]
l10: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ qk_v = qk_v $ by eq_refl
l11: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ ra_add qn0 qk_v t3 ∈ lrel $ by wcel_eq_l [ra_add_eq [l8, l10, eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]]], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]]
l12: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ ra_cnth t2 qk_v t4 ∈ lrel $ by wcel_eq_l [ra_cnth_eq [eq_sym [and_elim_l [and_elim_r [l3]]], l10, eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]]
l13: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_ndecl t2 qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v t3 ∈ lrel ∧ ra_cnth t2 qk_v t4 ∈ lrel $ by and_intro [l7, and_intro [l9, and_intro [l11, l12]]]
l14: $ H ⇒ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_ndecl t2 qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v t3 ∈ lrel ∧ ra_cnth t2 qk_v t4 ∈ lrel → Cf $ by imp_intro [#2]
l15: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_ndecl t2 qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v t3 ∈ lrel ∧ ra_cnth t2 qk_v t4 ∈ lrel → Cf $ by weaken [l14]
l16: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel ⇒ Cf $ by imp_elim [l15, l13]
l17: $ G , H , ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l18: $ … ⇒ Cf $ by ex_elim [l17, l16]
l19: $ G , H , ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l20: $ … ⇒ Cf $ by ex_elim [l19, l18]
l21: $ G , H , ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l22: $ … ⇒ Cf $ by ex_elim [l21, l20]
l23: $ G , H , ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l24: $ … ⇒ Cf $ by ex_elim [l23, l22]
l25: $ G , H , ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l26: $ … ⇒ Cf $ by ex_elim [l25, l24]
l27: $ G , H , ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l28: $ … ⇒ Cf $ by ex_elim [l27, l26]
l29: $ G , H , ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l30: $ … ⇒ Cf $ by ex_elim [l29, l28]
l31: $ G , H , ∃ y ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ y ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l32: $ … ⇒ Cf $ by ex_elim [l31, l30]
l33: $ G , H , ∃ x ∃ y ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) ⇒ ∃ x ∃ y ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel) $ by ax
l34: $ … ⇒ Cf $ by ex_elim [l33, l32]
l35: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qn0 ∃ qk_v ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_ndecl y qn_v qn0 ∈ lrel ∧ ra_add qn0 qk_v z ∈ lrel ∧ ra_cnth y qk_v u ∈ lrel)) → Cf $ by imp_intro [l34]
l36: $ G , H ⇒ Cf $ by imp_elim [l35, l2]

--| @freshen H qA
--| @freshen H qG_v
--| @freshen H qn_v
lemma f21_inv_cnth {qA qG_v qn_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_cnth t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_cons , scons t3 (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_cnth qG_v qn_v t3 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_cnth t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ qA ∃ qG_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA) ∨ ∃ qA ∃ x ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) $ by lrel_cnth_cases [l1]
l3: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA $ by ax
l4: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA ⇒ qG_v = qG_v $ by eq_refl
l6: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA ⇒ kc_cons = kc_cons $ by eq_refl
l7: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA ⇒ t1 = ⟨ kc_cons , scons t3 (scons qG_v ∅) ⟩ $ by eq_trans [and_elim_l [l3], opair_eq [l6, scons_eq [eq_sym [and_elim_r [and_elim_r [l3]]], scons_eq [l5, l4]]]]
l8: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA ⇒ t1 = ⟨ kc_cons , scons t3 (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l7, and_elim_l [and_elim_r [l3]]]
l9: $ H ⇒ t1 = ⟨ kc_cons , scons t3 (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l10: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA ⇒ t1 = ⟨ kc_cons , scons t3 (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l9]
l11: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA ⇒ Cf $ by imp_elim [l10, l8]
l12: $ G , H , ∃ qG_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA) ⇒ ∃ qG_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ qA ∃ qG_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA) ⇒ ∃ qA ∃ qG_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H ⇒ (∃ qA ∃ qG_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA)) → Cf $ by imp_intro [l15]
l17: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel $ by ax
l18: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel ⇒ qG_v = qG_v $ by eq_refl
l19: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel ⇒ qn_v = qn_v $ by eq_refl
l20: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel ⇒ ra_cnth qG_v qn_v t3 ∈ lrel $ by wcel_eq_l [ra_cnth_eq [l18, l19, eq_sym [and_elim_l [and_elim_r [and_elim_r [l17]]]]], and_elim_r [and_elim_r [and_elim_r [l17]]]]
l21: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_cnth qG_v qn_v t3 ∈ lrel $ by and_intro [and_elim_l [l17], and_intro [and_elim_l [and_elim_r [l17]], l20]]
l22: $ H ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_cnth qG_v qn_v t3 ∈ lrel → Cf $ by imp_intro [#3]
l23: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_cnth qG_v qn_v t3 ∈ lrel → Cf $ by weaken [l22]
l24: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel ⇒ Cf $ by imp_elim [l23, l21]
l25: $ G , H , ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) ⇒ ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) $ by ax
l26: $ … ⇒ Cf $ by ex_elim [l25, l24]
l27: $ G , H , ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) ⇒ ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) $ by ax
l28: $ … ⇒ Cf $ by ex_elim [l27, l26]
l29: $ G , H , ∃ x ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) ⇒ ∃ x ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) $ by ax
l30: $ … ⇒ Cf $ by ex_elim [l29, l28]
l31: $ G , H , ∃ qA ∃ x ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) ⇒ ∃ qA ∃ x ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel) $ by ax
l32: $ … ⇒ Cf $ by ex_elim [l31, l30]
l33: $ G , H ⇒ (∃ qA ∃ x ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel)) → Cf $ by imp_intro [l32]
l34: $ G , H ⇒ (∃ qA ∃ qG_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = qA) ∨ ∃ qA ∃ x ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = x ∧ ra_cnth qG_v qn_v x ∈ lrel)) → Cf $ by or_elim_imp [l16, l33]
l35: $ G , H ⇒ Cf $ by imp_elim [l34, l2]

lemma f51_aux (G: hyps) (td x0 tj tx: set): $ G ⇒ ra_aux_of td x0 tj tx ∈ lrel $ > $ G ⇒ x0 = ⟨ kc_nil , ∅ ⟩ $ > $ G ⇒ ⊥ $
----
l1: $ G , ra_ind_arity td n x1 m ∈ lrel ∧ ra_ndecl x0 x1 x2 ∈ lrel ∧ ra_add x2 k tj ∈ lrel ∧ ra_cnth x0 k tx ∈ lrel ⇒ ra_ind_arity td n x1 m ∈ lrel ∧ ra_ndecl x0 x1 x2 ∈ lrel ∧ ra_add x2 k tj ∈ lrel ∧ ra_cnth x0 k tx ∈ lrel $ by ax
l2: $ G , ra_ind_arity td n x1 m ∈ lrel ∧ ra_ndecl x0 x1 x2 ∈ lrel ∧ ra_add x2 k tj ∈ lrel ∧ ra_cnth x0 k tx ∈ lrel ⇒ ra_ind_arity td n x1 m ∈ lrel $ by and_elim_l [l1]
l3: $ G , ra_ind_arity td n x1 m ∈ lrel ∧ ra_ndecl x0 x1 x2 ∈ lrel ∧ ra_add x2 k tj ∈ lrel ∧ ra_cnth x0 k tx ∈ lrel ⇒ ra_ndecl x0 x1 x2 ∈ lrel $ by and_elim_l [and_elim_r [l1]]
l4: $ G , ra_ind_arity td n x1 m ∈ lrel ∧ ra_ndecl x0 x1 x2 ∈ lrel ∧ ra_add x2 k tj ∈ lrel ∧ ra_cnth x0 k tx ∈ lrel ⇒ ra_add x2 k tj ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [l1]]]
l5: $ G , ra_ind_arity td n x1 m ∈ lrel ∧ ra_ndecl x0 x1 x2 ∈ lrel ∧ ra_add x2 k tj ∈ lrel ∧ ra_cnth x0 k tx ∈ lrel ⇒ ra_cnth x0 k tx ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [l1]]]
