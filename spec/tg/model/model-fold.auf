--| @freshen G x3
--| @freshen G x4
--| @freshen G x5
lemma f9_fw_n {x3 x4 x5: set} (G: hyps) (J M: class) (u w v s t1 t3 tz ts: set) (ty k1 j1 vc vd vn vq vr ve vg va vb vh vk vl vm vo: set): $ G ⇒ crn j1 ⊆ f9_fw_q J M u w v s t1 t3 tz ts $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ jval u M J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ t1 ∊ trees ω $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ > $ G ⇒ nadd (nvf' tz) (cdm v) = nvf' ts $ > $ G ⇒ ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) $ > $ G ⇒ ra_fir t1 t3 vc vd ty ∈ lrel3 J $ > $ G ⇒ vc ∊ trees ω $ > $ G ⇒ ra_closed vn ty ∈ lrel $ > $ G ⇒ vq ∊ fseq u $ > $ G ⇒ vr ∊ fseq u $ > $ G ⇒ cdm vq = nadd (nvf' vd) (nvf' t3) $ > $ G ⇒ cdm vr = cdm vq $ > $ G ⇒ nvf' vn = nadd (cdm vq) (cdm v) $ > $ G ⇒ vq ++ s ∈ sat u M vc w $ > $ G ⇒ vr ++ s ∈ sat u M vc w $ > $ G ⇒ ve = vq ++ v $ > $ G ⇒ vg = vr ++ v $ > $ G ⇒ ⟨ va , ⟨ vb , ⟨ vh , vo ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w ve $ > $ G ⇒ ⟨ vk , ⟨ vl , ⟨ vm , vo ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vg $ > $ G ⇒ vb = vl ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → ve' nvf' x3 = vg' nvf' x3) $
----
l1: $ G ⇒ ∃ c ∃ d ∃ n ∃ q ∃ r (t1 = c ∧ t3 = d ∧ vc = n ∧ vd = q ∧ ty = r ∧ ra_indapp c ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d q r ⟨ kc_nz , ∅ ⟩ ∈ lrel) ∨ ∃ c ∃ d ∃ n ∃ q ∃ h ∃ k ∃ l ∃ m (t1 = c ∧ t3 = d ∧ vc = n ∧ vd = q ∧ ty = ⟨ kc_pi , scons k (scons m ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ m ∈ lrel ∧ ra_add q d h ∈ lrel ∧ ra_sinst c ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ h k l ∈ lrel ∧ ra_fir c d ⟨ kc_cons , scons l (scons n ∅) ⟩ ⟨ kc_s , scons q ∅ ⟩ m ∈ lrel3 J) ∨ ∃ c ∃ d ∃ n ∃ q ∃ h ∃ k ∃ l ∃ m (t1 = c ∧ t3 = d ∧ vc = n ∧ vd = q ∧ ty = ⟨ kc_pi , scons k (scons m ∅) ⟩ ∧ ra_add q d h ∈ lrel ∧ ra_sinst c ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ h k l ∈ lrel ∧ ra_deq n l l ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir c d ⟨ kc_cons , scons l (scons n ∅) ⟩ ⟨ kc_s , scons q ∅ ⟩ m ∈ lrel3 J) $ by lrel3_fir_cases [#15]
