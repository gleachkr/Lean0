l44: $ G , vm = ⟨ kc_app , scons x3 (scons x4 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty k ∈ lrel ∧ ra_nidx td tj n ∈ lrel ∧ ra_add tnp n k ∈ lrel ∧ ra_rehead i x2 n ty x3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ i tnp ∈ lrel ∧ ra_add vd tnf e ∈ lrel ∧ ra_add tm tn f ∈ lrel ∧ ra_add e f g ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ g tnp x1 ∈ lrel ∧ ra_pargs x1 e f x2 ∈ lrel ∧ ra_add vd tfld h ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd x4 ∈ lrel ⇒ ra_add vd tfld h ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l32]]]]]]]]]]]]
l45: $ G , vm = ⟨ kc_app , scons x3 (scons x4 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty k ∈ lrel ∧ ra_nidx td tj n ∈ lrel ∧ ra_add tnp n k ∈ lrel ∧ ra_rehead i x2 n ty x3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ i tnp ∈ lrel ∧ ra_add vd tnf e ∈ lrel ∧ ra_add tm tn f ∈ lrel ∧ ra_add e f g ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ g tnp x1 ∈ lrel ∧ ra_pargs x1 e f x2 ∈ lrel ∧ ra_add vd tfld h ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd x4 ∈ lrel ⇒ ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd x4 ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l32]]]]]]]]]]]]
l46: $ G , vm = ⟨ kc_app , scons x3 (scons x4 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty k ∈ lrel ∧ ra_nidx td tj n ∈ lrel ∧ ra_add tnp n k ∈ lrel ∧ ra_rehead i x2 n ty x3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ i tnp ∈ lrel ∧ ra_add vd tnf e ∈ lrel ∧ ra_add tm tn f ∈ lrel ∧ ra_add e f g ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ g tnp x1 ∈ lrel ∧ ra_pargs x1 e f x2 ∈ lrel ∧ ra_add vd tfld h ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd x4 ∈ lrel ⇒ ∃ z (ra_nidx td tj z ∈ lrel) $ by ex_intro [l35]
l47: $ G ⇒ ∃ z (ra_nidx td tj z ∈ lrel) $ by f21_inv_ihval [#5, l31, l46]

lemma f39_in_all (G: hyps) (td tnp tn tm tv tnf tfld tj: set): $ G ⇒ trees ω ⊆ f39_in_q td tnp tn tm tv tnf tfld tj $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ , ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel ⇒ crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ , ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ , ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ , ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ , ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel ⇒ ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ , ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel ⇒ ∃ z (ra_nidx td tj z ∈ lrel) $ by f39_in_n [l1, l2, l3, l4, l5]
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ ⇒ ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel → ∃ z (ra_nidx td tj z ∈ lrel) $ by imp_intro [l6]
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ ⇒ ∀ m (ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel → ∃ z (ra_nidx td tj z ∈ lrel)) $ by all_intro [l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ ⇒ ∀ d ∀ m (ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel → ∃ z (ra_nidx td tj z ∈ lrel)) $ by all_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ ⇒ y ∊ f39_in_q td tnp tn tm tv tnf tfld tj $ by cab_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f39_in_q td tnp tn tm tv tnf tfld tj $ by wcel_intro [l11, l10]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj ⇒ ⟨ i , j ⟩ ∈ f39_in_q td tnp tn tm tv tnf tfld tj $ by isset_elim [l13, l12]
l15: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj → ⟨ i , j ⟩ ∈ f39_in_q td tnp tn tm tv tnf tfld tj $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f39_in_q td tnp tn tm tv tnf tfld tj → ⟨ i , j ⟩ ∈ f39_in_q td tnp tn tm tv tnf tfld tj) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f39_in_q td tnp tn tm tv tnf tfld tj $ by trees_ind_c [l17, l16]

