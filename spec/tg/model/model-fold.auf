l18: $ G ⇒ sx ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l16], scat_fseq_c [welc_wcel [l17], l15]]]
l19: $ G ⇒ vr = ve ++ sx $ by weaken [#26]
l20: $ G ⇒ ve ∊ fseq u $ by weaken [#24]
l21: $ G ⇒ vr ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l19], scat_fseq [l20, l18]]]
