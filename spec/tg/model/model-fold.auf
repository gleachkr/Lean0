l83: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , k = nadd (nvf' te) (nvf' ti) , d = nvf' ti ⇒ nadd (nadd (nvf' th) (nvf' te)) (nvf' ti) = nadd (nvf' th) (nadd (nvf' te) (nvf' ti)) $ by nadd_assoc_c [l78, l76, l77]
