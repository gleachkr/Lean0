lemma f15_mi_all (G: hyps) (M: class) (u w td tnp tv tn p rr: set): $ G ⇒ trees ω ⊆ f15_mi_q M u w td tnp tv tn p rr $
----
l1: $ G , e ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f15_mi_q M u w td tnp tv tn p rr , y = ⟨ e , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , rr ∊ fseq u , tv ∊ trees ω , ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) , ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) , ra_motives td tnp tv n y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , n ∊ ofsort lsig lopen ks_nat , ra_ntys y k o ∈ lrel , nadd (nvf' n) (nvf' k) = nvf' tn , ∀ a ∀ f ∀ b (ra_nth_ty y a f b ∈ lrel → ityf td (nadd (nvf' n) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) , c ∊ fseq u , cdm c = nvf' n , r = c ++ p ++ rr ⇒ crn j ⊆ f15_mi_q M u w td tnp tv tn p rr $ by ax
l2: $ G , e ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f15_mi_q M u w td tnp tv tn p rr , y = ⟨ e , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , rr ∊ fseq u , tv ∊ trees ω , ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) , ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) , ra_motives td tnp tv n y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , n ∊ ofsort lsig lopen ks_nat , ra_ntys y k o ∈ lrel , nadd (nvf' n) (nvf' k) = nvf' tn , ∀ a ∀ f ∀ b (ra_nth_ty y a f b ∈ lrel → ityf td (nadd (nvf' n) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) , c ∊ fseq u , cdm c = nvf' n , r = c ++ p ++ rr ⇒ y = ⟨ e , j ⟩ $ by ax
l3: $ G , e ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f15_mi_q M u w td tnp tv tn p rr , y = ⟨ e , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , rr ∊ fseq u , tv ∊ trees ω , ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) , ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) , ra_motives td tnp tv n y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , n ∊ ofsort lsig lopen ks_nat , ra_ntys y k o ∈ lrel , nadd (nvf' n) (nvf' k) = nvf' tn , ∀ a ∀ f ∀ b (ra_nth_ty y a f b ∈ lrel → ityf td (nadd (nvf' n) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) , c ∊ fseq u , cdm c = nvf' n , r = c ++ p ++ rr ⇒ e ∊ ω $ by ax
l4: $ G , e ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f15_mi_q M u w td tnp tv tn p rr , y = ⟨ e , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , rr ∊ fseq u , tv ∊ trees ω , ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) , ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) , ra_motives td tnp tv n y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , n ∊ ofsort lsig lopen ks_nat , ra_ntys y k o ∈ lrel , nadd (nvf' n) (nvf' k) = nvf' tn , ∀ a ∀ f ∀ b (ra_nth_ty y a f b ∈ lrel → ityf td (nadd (nvf' n) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) , c ∊ fseq u , cdm c = nvf' n , r = c ++ p ++ rr ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , e ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f15_mi_q M u w td tnp tv tn p rr , y = ⟨ e , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , rr ∊ fseq u , tv ∊ trees ω , ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) , ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) , ra_motives td tnp tv n y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , n ∊ ofsort lsig lopen ks_nat , ra_ntys y k o ∈ lrel , nadd (nvf' n) (nvf' k) = nvf' tn , ∀ a ∀ f ∀ b (ra_nth_ty y a f b ∈ lrel → ityf td (nadd (nvf' n) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) , c ∊ fseq u , cdm c = nvf' n , r = c ++ p ++ rr ⇒ uadm u $ by ax
