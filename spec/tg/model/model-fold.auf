l1: $ G ⇒ ta ∊ trees ω $ by wcel_welc [lsig_ofsort_trees [#1]]
l2: $ G ⇒ dt u M ta w r ∈ u $ by dt_in_u [#6, #1, #4, #5]
l3: $ G ⇒ dt u M ta w r ⊆ u $ by universe_elem_subset_c [uadm_universe [#6], l2]
l4: $ G , a ∊ dt u M ta w r ⇒ a ∊ dt u M ta w r $ by ax
l5: $ G , a ∊ dt u M ta w r ⇒ dt u M ta w r ⊆ u $ by weaken [l3]
l6: $ G , a ∊ dt u M ta w r ⇒ a ∊ u $ by subset_elim [l5, l4]
l7: $ G , a ∊ dt u M ta w r ⇒ ∀ a (a ∊ dt u M ta w r → dt u M tm w (scons a r) = fpi s (mpth u (dnf u M) tb w (scons a r) (Y2)) (ap (T2) s)) $ by weaken [#7]
l8: $ G , a ∊ dt u M ta w r ⇒ dt u M tm w (scons a r) = fpi s (mpth u (dnf u M) tb w (scons a r) (Y2)) (ap (T2) s) $ by imp_elim [all_elim [l7], l4]
l9: $ G , a ∊ dt u M ta w r ⇒ ∀ a (a ∊ dt u M ta w r → ∀ q (q ∊ fseq u → ap (Y2) q = ap (Y) (ssnoc q a))) $ by weaken [#8]
l10: $ G , a ∊ dt u M ta w r ⇒ ∀ q (q ∊ fseq u → ap (Y2) q = ap (Y) (ssnoc q a)) $ by imp_elim [all_elim [l9], l4]
l11: $ G , a ∊ dt u M ta w r ⇒ ∀ a (a ∊ dt u M ta w r → ∀ q (q ∊ fseq u → ap (T2) q = ap (T) (ssnoc q a))) $ by weaken [#9]
l12: $ G , a ∊ dt u M ta w r ⇒ ∀ q (q ∊ fseq u → ap (T2) q = ap (T) (ssnoc q a)) $ by imp_elim [all_elim [l11], l4]
l13: $ G , a ∊ dt u M ta w r ⇒ ta ∊ trees ω $ by weaken [l1]
l14: $ G , a ∊ dt u M ta w r ⇒ tb ∊ trees ω $ by weaken [#2]
l15: $ G , a ∊ dt u M ta w r ⇒ w ∊ lvals $ by weaken [#4]
l16: $ G , a ∊ dt u M ta w r ⇒ r ∊ fseq u $ by weaken [#5]
l17: $ G , a ∊ dt u M ta w r ⇒ mpth u (dnf u M) tb w (scons a r) (Y2) = {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} $ by mpth_pi_dom [l13, l14, l15, l16, l4, l6, l10]
l18: $ G , a ∊ dt u M ta w r , s ∊ mpth u (dnf u M) tb w (scons a r) (Y2) ⇒ mpth u (dnf u M) tb w (scons a r) (Y2) = {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} $ by weaken [l17]
l19: $ G , a ∊ dt u M ta w r , s ∊ mpth u (dnf u M) tb w (scons a r) (Y2) ⇒ s ∊ mpth u (dnf u M) tb w (scons a r) (Y2) $ by ax
