lemma f21_mw_all (G: hyps) (M CT Km NI J: class) (u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl: set): $ G ⇒ trees ω ⊆ f21_mw_q M CT Km NI J u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_mw_q M CT Km NI J u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl , x0 = ⟨ i , j ⟩ , uadm u , w ∊ lvals , pp ∊ fseq u , cdm pp = nvf' tnp , xs ∊ fseq u , cdm xs = nvf' tn , mk ∊ fseq u , cdm mk = nvf' tk , cv ∊ fseq u , cdm cv = nvf' tn , c0 = mk ++ cv , rr ∊ fseq u , nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ , nc ∊ trees ω , ∀ x (x ∊ fseq u → dt u M nc w x = CT) , ∀ x (isset (apn (CT) x)) , Km ∈ ω , nadd (suc Km) (nvf' ti) = nvf' tn , ∀ c (ra_nidx td ti c ∈ lrel → nvf' c = NI) , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ∀ x (isset (ap (imrel td cv) x)) , ra_mwalk td tnp tn tk ti tc tnf d r h x0 m ∈ lrel , x0 ∊ ofsort lsig lopen ks_expr , m ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , ra_closed x5 x0 ∈ lrel , nvf' x5 = nadd (nadd (nvf' d) (nvf' tnp)) (nvf' tn) , ra_npis x0 n ∈ lrel , nadd (nvf' n) (nvf' d) = nvf' tnf , ra_cwf td tn tnp tl ti e d x0 ∈ lrel3 J , ∀ f ∀ g ∀ c (ra_nth_pi x0 f g ∈ lrel → ra_add d f c ∈ lrel → ra_nth_pi tK0 c g ∈ lrel) , ra_clen h r ∈ lrel , k ∊ fseq u , cdm k = nvf' d , l ∊ fseq u , cdm l = nvf' d , t ∊ fseq {y | y = y} , cdm t = nvf' d , p = k ++ c0 ++ pp ++ rr , q = k ++ pp ++ xs , ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x0 w q → h ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (f ++ p)) h w = ihv td tK0 (imrel td cv) (l ++ g) (t ++ c) (nvf' d)) ⇒ crn j ⊆ f21_mw_q M CT Km NI J u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl $ by ax
