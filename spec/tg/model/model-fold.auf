l449: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr , x2 ∊ esat u (dsh u (mcv H) x5) tM w , x6 = x2 ++ x5 ⇒ w = w $ by eq_refl
l450: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr , x2 ∊ esat u (dsh u (mcv H) x5) tM w , x6 = x2 ++ x5 ⇒ apn (apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1) x2 ∈ da ((dsh u (mcv H) x5)' tR1) w x2 $ by wcel_eq_r [eq_sym [eq_trans [l445, eq_trans [dt_eq [l446, l447, l448, l449, eq_sym [l179]], l188]]], l444]
l451: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr , x2 ∊ esat u (dsh u (mcv H) x5) tM w ⇒ x2 ∊ fseq u $ by weaken [l175]
l452: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr , x2 ∊ esat u (dsh u (mcv H) x5) tM w ⇒ x5 ∊ fseq u $ by weaken [l135]
l453: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr , x2 ∊ esat u (dsh u (mcv H) x5) tM w ⇒ isset (x2 ++ x5) $ by wcel_isset [scat_fseq [l451, l452]]
l454: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr , x2 ∊ esat u (dsh u (mcv H) x5) tM w ⇒ apn (apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1) x2 ∈ da ((dsh u (mcv H) x5)' tR1) w x2 $ by isset_elim [l453, l450]
l455: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ ∀ x2 (x2 ∊ esat u (dsh u (mcv H) x5) tM w → apn (apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1) x2 ∈ da ((dsh u (mcv H) x5)' tR1) w x2) $ by all_intro [imp_intro [l454]]
l456: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1 ∈ ipi u (dsh u (mcv H) x5) tM tR1 w ↔ (apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1 ⊆ {y | ∃ p ∃ z (p ∊ esat u (dsh u (mcv H) x5) tM w ∧ y = nest p z)} ∧ ∀ x2 (x2 ∊ esat u (dsh u (mcv H) x5) tM w → apn (apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1) x2 ∈ da ((dsh u (mcv H) x5)' tR1) w x2)) $ by ipi_wcel [l158]
l457: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1 ∈ ipi u (dsh u (mcv H) x5) tM tR1 w $ by bi_elim_r [l456, and_intro [l170, l455]]
l458: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ da ((dsh u (mcv H) rr)' tR2) w x1 = dt u (mcv H) tR2 w (x1 ++ rr) $ by weaken [l131]
l459: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ u = u $ by eq_refl
l460: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ mcv H = mcv H $ by eq_refl
l461: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ tR2 = tR2 $ by eq_refl
l462: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ w = w $ by eq_refl
l463: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w , x5 = x1 ++ rr ⇒ apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1 ∈ da ((dsh u (mcv H) rr)' tR2) w x1 $ by wcel_eq_r [eq_sym [eq_trans [l458, eq_trans [dt_eq [l459, l460, l461, l462, eq_sym [l132]], l141]]], l457]
l464: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w ⇒ x1 ∊ fseq u $ by weaken [l125]
l465: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w ⇒ rr ∊ fseq u $ by weaken [#19]
l466: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w ⇒ isset (x1 ++ rr) $ by wcel_isset [scat_fseq [l464, l465]]
l467: $ G , x1 ∊ esat u (dsh u (mcv H) rr) tp w ⇒ apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1 ∈ da ((dsh u (mcv H) rr)' tR2) w x1 $ by isset_elim [l466, l463]
l468: $ G ⇒ ∀ x1 (x1 ∊ esat u (dsh u (mcv H) rr) tp w → apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1 ∈ da ((dsh u (mcv H) rr)' tR2) w x1) $ by all_intro [imp_intro [l467]]
l469: $ G ⇒ irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w ∈ ipi u (dsh u (mcv H) rr) tp tR2 w ↔ (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w ⊆ {y | ∃ p ∃ z (p ∊ esat u (dsh u (mcv H) rr) tp w ∧ y = nest p z)} ∧ ∀ x1 (x1 ∊ esat u (dsh u (mcv H) rr) tp w → apn (irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w) x1 ∈ da ((dsh u (mcv H) rr)' tR2) w x1)) $ by ipi_wcel [l107]
l470: $ G ⇒ irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w ∈ ipi u (dsh u (mcv H) rr) tp tR2 w $ by bi_elim_r [l469, and_intro [l120, l468]]
l471: $ G ⇒ irc u (dnf u (mcv H)) td (nvf' ti) (lv tv w) w ∈ dt u (mcv H) tR w rr $ by wcel_eq_r [eq_sym [l108], l470]

lemma f26_tw_hd (G: hyps) (J: class) (dd nv np lv iv cx bb y1 y2 y3: set): $ G ⇒ ra_tys_wf dd nv np lv iv cx bb ∈ lrel3 J $ > $ G ⇒ bb = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ > $ G ⇒ ra_ctors_wf dd nv np lv iv cx y2 ∈ lrel3 J $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ f ∃ c ∃ t (dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tcons , scons f (scons c (scons t ∅)) ⟩ ∧ ra_isort f x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 c ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 t ∈ lrel3 J) $ by lrel3_tys_wf_cases [#1]
l2: $ G , dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩ $ by ax
l3: $ G , dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ by eq_trans [eq_sym [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l2]]]]]]], weaken [#2]]
l4: $ G , dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
l5: $ G , dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
l6: $ G , dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tnil = kc_tcons $ by opair_inj_l_c [l3, wcel_isset [l4], wcel_isset [l5]]
l7: $ G , dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ ¬ kc_tnil = kc_tcons $ by kc_tnil_ne_tcons
l8: $ G , dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ ra_ctors_wf dd nv np lv iv cx y2 ∈ lrel3 J $ by bot_elim [not_elim [l7, l6]]
l9: $ G , ∃ x6 (dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩) ⇒ ∃ x6 (dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩) $ by ax
