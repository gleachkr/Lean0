lemma f18_cr_all (G: hyps) (td tn tnp tj: set): $ G ⇒ trees ω ⊆ f18_cr_q td tn tnp tj $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel , nvf' k = nadd (nvf' d) (nvf' tnp) ⇒ crn j ⊆ f18_cr_q td tn tnp tj $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel , nvf' k = nadd (nvf' d) (nvf' tnp) ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel , nvf' k = nadd (nvf' d) (nvf' tnp) ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel , nvf' k = nadd (nvf' d) (nvf' tnp) ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel , nvf' k = nadd (nvf' d) (nvf' tnp) ⇒ ra_closed k y ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel , nvf' k = nadd (nvf' d) (nvf' tnp) ⇒ ra_recfield td tn tnp d y tj ∈ lrel $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel , nvf' k = nadd (nvf' d) (nvf' tnp) ⇒ nvf' k = nadd (nvf' d) (nvf' tnp) $ by ax
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel , nvf' k = nadd (nvf' d) (nvf' tnp) ⇒ ⊥ $ by f18_cr_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel , ra_recfield td tn tnp d y tj ∈ lrel ⇒ nvf' k = nadd (nvf' d) (nvf' tnp) → ⊥ $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ , ra_closed k y ∈ lrel ⇒ ra_recfield td tn tnp d y tj ∈ lrel → nvf' k = nadd (nvf' d) (nvf' tnp) → ⊥ $ by imp_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ ⇒ ra_closed k y ∈ lrel → ra_recfield td tn tnp d y tj ∈ lrel → nvf' k = nadd (nvf' d) (nvf' tnp) → ⊥ $ by imp_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ ⇒ ∀ d (ra_closed k y ∈ lrel → ra_recfield td tn tnp d y tj ∈ lrel → nvf' k = nadd (nvf' d) (nvf' tnp) → ⊥) $ by all_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ ⇒ ∀ k ∀ d (ra_closed k y ∈ lrel → ra_recfield td tn tnp d y tj ∈ lrel → nvf' k = nadd (nvf' d) (nvf' tnp) → ⊥) $ by all_intro [l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ ⇒ y ∊ f18_cr_q td tn tnp tj $ by cab_intro [l13]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f18_cr_q td tn tnp tj $ by wcel_intro [l15, l14]
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l18: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f18_cr_q td tn tnp tj ⇒ ⟨ i , j ⟩ ∈ f18_cr_q td tn tnp tj $ by isset_elim [l17, l16]
l19: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f18_cr_q td tn tnp tj → ⟨ i , j ⟩ ∈ f18_cr_q td tn tnp tj $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f18_cr_q td tn tnp tj → ⟨ i , j ⟩ ∈ f18_cr_q td tn tnp tj) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ f18_cr_q td tn tnp tj $ by trees_ind_c [l21, l20]

closed_recfield_ex
------------------
l1: $ G ⇒ trees ω ⊆ f18_cr_q td tn tnp tj $ by f18_cr_all
l2: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
l3: $ G ⇒ tk ∊ trees ω ∧ ta ∊ trees ω $ by lrel_args2 [#1, wcel_isset [l2]]
l4: $ G ⇒ ta ∊ f18_cr_q td tn tnp tj $ by subset_elim [l1, and_elim_r [l3]]
l5: $ G ⇒ ⊥ $ by f18_cr_e [l4, #1, #2, #3]

def f18_rl_q (td tn tnp tj: set) (.y .d: set): class = $ {y | ∀ d (ra_recfield td tn tnp d y tj ∈ lrel → nvf' tj ∈ nvf' tn)} $

lemma f18_rl_e (G: hyps) (td tn tnp tj: set) (ty vd: set): $ G ⇒ ty ∊ f18_rl_q td tn tnp tj $ > $ G ⇒ ra_recfield td tn tnp vd ty tj ∈ lrel $ > $ G ⇒ nvf' tj ∈ nvf' tn $
----
l1: $ G ⇒ ∀ d (ra_recfield td tn tnp d ty tj ∈ lrel → nvf' tj ∈ nvf' tn) $ by cab_elim [#1]
l2: $ G ⇒ ra_recfield td tn tnp vd ty tj ∈ lrel → nvf' tj ∈ nvf' tn $ by all_elim [l1]
l3: $ G ⇒ nvf' tj ∈ nvf' tn $ by imp_elim [l2, #2]

lemma f18_rl_n (G: hyps) (td tn tnp tj: set) (ty k1 j1 vd: set): $ G ⇒ crn j1 ⊆ f18_rl_q td tn tnp tj $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_recfield td tn tnp vd ty tj ∈ lrel $ > $ G ⇒ nvf' tj ∈ nvf' tn $
----
l1: $ G ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel) ∨ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel) $ by lrel_recfield_cases [#5]
l2: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel ⇒ td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel $ by ax
l3: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l4: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel ⇒ isset ∅ $ by ax_empty
l5: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel ⇒ crn (scons b (scons c ∅)) ⊆ f18_rl_q td tn tnp tj $ by node_crn_sub [weaken [#1], weaken [#2], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l2]]]]], wcel_isset [l3], scons_set [scons_set [l4]]]
l6: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel ⇒ isset c $ by isset_var
l7: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel ⇒ c ∈ f18_rl_q td tn tnp tj $ by crn_scons_head [l6, crn_scons_tail [l5]]
l8: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel , d = ⟨ kc_s , scons w ∅ ⟩ ⇒ d = ⟨ kc_s , scons w ∅ ⟩ $ by ax
l9: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel , d = ⟨ kc_s , scons w ∅ ⟩ ⇒ td = z $ by weaken [and_elim_l [l2]]
l10: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel , d = ⟨ kc_s , scons w ∅ ⟩ ⇒ tn = u $ by weaken [and_elim_l [and_elim_r [l2]]]
