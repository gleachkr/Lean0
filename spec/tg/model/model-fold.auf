l119: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ w ∊ lvals $ by weaken [#1]
l120: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ tIhs ∈ trees ω $ by weaken [l47]
l121: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ isset (ssnoc hd (etel u (dnf u M) tA w rk) ++ c) $ by weaken [l37]
l122: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ ∀ x (isset (ap L x)) $ by weaken [#13]
l123: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ Dn ∈ ω $ by weaken [#14]
l124: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ irf D K Dn J $ by weaken [#15]
l125: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ esat u (dsh u M v) ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ w = ihv D K L (ssnoc gd a ++ g) (ssnoc hd (etel u (dnf u M) tA w rk) ++ c) (suc Dn) $ by hih_rec [l118, l119, l94, and_elim_l [weaken [l45]], wcel_welc [l120], l97, l117, l121, l122, l123, l124]
l126: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ isset ω $ by omega_set
l127: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ kc_cons ∈ ω $ by kc_cons_omega
l128: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ tIhs ∈ trees ω $ by weaken [l47]
l129: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l130: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ trees ω $ by trees_intro_c [l126, l127, scons_fseq_c [lsig_ofsort_trees [and_elim_l [weaken [l45]]], scons_fseq_c [l128, l129]]]
l131: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ Dn2 = suc Dn $ by weaken [#16]
l132: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx , v = f ++ scons a rm ⇒ esat u (dsh u M (f ++ scons a rm)) ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ w = ihv D K L (ssnoc gd a ++ g) (ssnoc hd (etel u (dnf u M) tA w rk) ++ c) Dn2 $ by eq_trans [eq_sym [esat_dsh_eq [l130, welc_wcel [l94], l90]], eq_trans [l125, ihv_eq_arg [eq_sym [l131]]]]
l133: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx ⇒ a ∊ u $ by weaken [#9]
l134: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx ⇒ rm ∊ fseq u $ by weaken [#2]
l135: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx ⇒ isset (f ++ scons a rm) $ by wcel_isset [scat_fseq_c [welc_wcel [weaken [l17]], scons_fseq [l133, l134]]]
l136: $ G , ⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) , ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx ⇒ esat u (dsh u M (f ++ scons a rm)) ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ w = ihv D K L (ssnoc gd a ++ g) (ssnoc hd (etel u (dnf u M) tA w rk) ++ c) Dn2 $ by isset_elim [l135, l132]
l137: $ G ⇒ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) → ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx → esat u (dsh u M (f ++ scons a rm)) ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ w = ihv D K L (ssnoc gd a ++ g) (ssnoc hd (etel u (dnf u M) tA w rk) ++ c) Dn2) $ by all_intro [all_intro [all_intro [all_intro [imp_intro [imp_intro [l136]]]]]]

def f21_az_q  (.y .e: set): class = $ {y | ∀ e (ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel → e = y)} $

lemma f21_az_e (G: hyps)  (ty ve: set): $ G ⇒ ty ∊ f21_az_q  $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ve ∈ lrel $ > $ G ⇒ ve = ty $
----
l1: $ G ⇒ ∀ e (ra_add ⟨ kc_nz , ∅ ⟩ ty e ∈ lrel → e = ty) $ by cab_elim [#1]
l2: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ve ∈ lrel → ve = ty $ by all_elim [l1]
l3: $ G ⇒ ve = ty $ by imp_elim [l2, #2]

--| @freshen H qn_v
--| @freshen H qj_v
lemma f21_inv_add {qn_v qj_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_add t1 t2 t3 ∈ lrel $ > $ H , t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = t1 ⇒ Cf $ > $ H , t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add t1 qn_v qj_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_add t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ∨ ∃ x ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) $ by lrel_add_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x $ by ax
l4: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t3 = t1 $ by eq_trans [and_elim_r [and_elim_r [l3]], eq_sym [and_elim_l [l3]]]
l5: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = t1 $ by and_intro [and_elim_l [and_elim_r [l3]], l4]
l6: $ H ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = t1 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = t1 → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ⇒ ∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel $ by ax
l13: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ qn_v = qn_v $ by eq_refl
l14: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ qj_v = qj_v $ by eq_refl
l15: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ ra_add t1 qn_v qj_v ∈ lrel $ by wcel_eq_l [ra_add_eq [eq_sym [and_elim_l [l12]], l13, l14], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l16: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add t1 qn_v qj_v ∈ lrel $ by and_intro [and_elim_l [and_elim_r [l12]], and_intro [and_elim_l [and_elim_r [and_elim_r [l12]]], l15]]
l17: $ H ⇒ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add t1 qn_v qj_v ∈ lrel → Cf $ by imp_intro [#3]
l18: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add t1 qn_v qj_v ∈ lrel → Cf $ by weaken [l17]
l19: $ G , H , t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel ⇒ Cf $ by imp_elim [l18, l16]
l20: $ G , H , ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) ⇒ ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) $ by ax
l21: $ … ⇒ Cf $ by ex_elim [l20, l19]
l22: $ G , H , ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) ⇒ ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
l24: $ G , H , ∃ x ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) ⇒ ∃ x ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H ⇒ (∃ x ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel)) → Cf $ by imp_intro [l25]
l27: $ G , H ⇒ (∃ x (t1 = x ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ∨ ∃ x ∃ qn_v ∃ qj_v (t1 = x ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons qj_v ∅ ⟩ ∧ ra_add x qn_v qj_v ∈ lrel)) → Cf $ by or_elim_imp [l11, l26]
l28: $ G , H ⇒ Cf $ by imp_elim [l27, l2]

lemma f21_az_n (G: hyps)  (ty k1 j1 ve: set): $ G ⇒ crn j1 ⊆ f21_az_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ty ve ∈ lrel $ > $ G ⇒ ve = ty $
----
l1: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ x1 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ty $ by eq_refl
l3: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ve = ve $ by eq_refl
l4: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add x1 ty ve ∈ lrel $ by wcel_eq_l [ra_add_eq [eq_sym [l1], l2, l3], weaken [#5]]
l5: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 $ by ax
l6: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ve = ty $ by eq_trans [and_elim_r [l5], eq_trans [weaken [l1], eq_sym [and_elim_l [l5]]]]
l7: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel $ by ax
l8: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset ∅ $ by ax_empty
l9: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset (scons n ∅) $ by scons_set [l8]
l10: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ crn j1 ⊆ f21_az_q  $ by weaken [#1]
l11: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l12: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l13: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ crn (scons n ∅) ⊆ f21_az_q  $ by node_crn_sub [l10, l11, and_elim_l [l7], wcel_isset [l12], l9]
l14: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset n $ by isset_var
l15: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ n ∈ f21_az_q  $ by crn_scons_head [l14, l13]
l16: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ n = n $ by eq_refl
l17: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ j = j $ by eq_refl
l18: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ n j ∈ lrel $ by wcel_eq_l [ra_add_eq [weaken [l1], l16, l17], and_elim_r [and_elim_r [l7]]]
l19: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ j = n $ by f21_az_e [wcel_welc [l15], l18]
l20: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l21: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l22: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ⟨ kc_s , scons j ∅ ⟩ = ⟨ kc_s , scons n ∅ ⟩ $ by opair_eq [l20, scons_eq [l19, l21]]
l23: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ve = ty $ by eq_trans [and_elim_l [and_elim_r [l7]], eq_trans [l22, eq_sym [and_elim_l [l7]]]]
l24: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ve = ty $ by f21_inv_add [l4, l6, l23]
l25: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l26: $ G ⇒ ve = ty $ by isset_elim [l25, l24]

lemma f21_az_all (G: hyps) : $ G ⇒ trees ω ⊆ f21_az_q  $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel ⇒ crn j ⊆ f21_az_q  $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel ⇒ e = y $ by f21_az_n [l1, l2, l3, l4, l5]
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ ⇒ ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel → e = y $ by imp_intro [l6]
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ ⇒ ∀ e (ra_add ⟨ kc_nz , ∅ ⟩ y e ∈ lrel → e = y) $ by all_intro [l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ ⇒ y ∊ f21_az_q  $ by cab_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f21_az_q  $ by wcel_intro [l10, l9]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_az_q  ⇒ ⟨ i , j ⟩ ∈ f21_az_q  $ by isset_elim [l12, l11]
l14: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f21_az_q  → ⟨ i , j ⟩ ∈ f21_az_q  $ by imp_intro [imp_intro [imp_intro [l13]]]
l15: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f21_az_q  → ⟨ i , j ⟩ ∈ f21_az_q ) $ by all_intro [all_intro [l14]]
l16: $ G ⇒ isset ω $ by omega_set
l17: $ G ⇒ trees ω ⊆ f21_az_q  $ by trees_ind_c [l16, l15]

add_zero_l
----------
l1: $ G ⇒ ⟨ kr_add , scons ⟨ kc_nz , ∅ ⟩ (scons a (scons e ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons e ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons a (scons e ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ⟨ kc_nz , ∅ ⟩ (scons a (scons e ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
l7: $ G ⇒ kr_add ∈ ω ∧ scons ⟨ kc_nz , ∅ ⟩ (scons a (scons e ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons ⟨ kc_nz , ∅ ⟩ (scons a (scons e ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ crn (scons a (scons e ∅)) ⊆ trees ω $ by crn_scons_tail [l8]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ a ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ trees ω ⊆ f21_az_q  $ by f21_az_all
l13: $ G ⇒ a ∊ f21_az_q  $ by subset_elim [l12, wcel_welc [l11]]
l14: $ G ⇒ e = a $ by f21_az_e [l13, #1]

def f21_as_q  (.y .d .e: set): class = $ {y | ∀ d ∀ e (ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel → ra_add d ⟨ kc_s , scons y ∅ ⟩ e ∈ lrel)} $

lemma f21_as_e (G: hyps)  (ty vd ve: set): $ G ⇒ ty ∊ f21_as_q  $ > $ G ⇒ ra_add ⟨ kc_s , scons vd ∅ ⟩ ty ve ∈ lrel $ > $ G ⇒ ra_add vd ⟨ kc_s , scons ty ∅ ⟩ ve ∈ lrel $
----
l1: $ G ⇒ ∀ d ∀ e (ra_add ⟨ kc_s , scons d ∅ ⟩ ty e ∈ lrel → ra_add d ⟨ kc_s , scons ty ∅ ⟩ e ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ e (ra_add ⟨ kc_s , scons vd ∅ ⟩ ty e ∈ lrel → ra_add vd ⟨ kc_s , scons ty ∅ ⟩ e ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ra_add ⟨ kc_s , scons vd ∅ ⟩ ty ve ∈ lrel → ra_add vd ⟨ kc_s , scons ty ∅ ⟩ ve ∈ lrel $ by all_elim [l2]
l4: $ G ⇒ ra_add vd ⟨ kc_s , scons ty ∅ ⟩ ve ∈ lrel $ by imp_elim [l3, #2]

lemma f21_as_n (G: hyps)  (ty k1 j1 vd ve: set): $ G ⇒ crn j1 ⊆ f21_as_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add ⟨ kc_s , scons vd ∅ ⟩ ty ve ∈ lrel $ > $ G ⇒ ra_add vd ⟨ kc_s , scons ty ∅ ⟩ ve ∈ lrel $
----
l1: $ G ⇒ ⟨ kr_add , scons ⟨ kc_s , scons vd ∅ ⟩ (scons ty (scons ve ∅)) ⟩ ∈ latoms $ by lrel_latoms [#5]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons ve ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons ty (scons ve ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ⟨ kc_s , scons vd ∅ ⟩ (scons ty (scons ve ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
l7: $ G ⇒ kr_add ∈ ω ∧ scons ⟨ kc_s , scons vd ∅ ⟩ (scons ty (scons ve ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons ⟨ kc_s , scons vd ∅ ⟩ (scons ty (scons ve ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ isset ω $ by omega_set
l10: $ G ⇒ ⟨ kc_s , scons vd ∅ ⟩ ∈ trees ω $ by crn_scons_head_trees [l9, l8]
l11: $ G ⇒ isset ω $ by omega_set
l12: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
l13: $ G ⇒ vd ∊ trees ω $ by trees_kids1 [l11, l10, wcel_isset [l12]]
l14: $ G ⇒ isset ω $ by omega_set
l15: $ G ⇒ ty ∈ trees ω $ by wcel_eq_l [eq_sym [#2], trees_intro_c [l14, welc_wcel [#3], welc_wcel [#4]]]
l16: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ x1 = ⟨ kc_s , scons vd ∅ ⟩ $ by ax
l17: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ ty = ty $ by eq_refl
l18: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ ve = ve $ by eq_refl
l19: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ ra_add x1 ty ve ∈ lrel $ by wcel_eq_l [ra_add_eq [eq_sym [l16], l17, l18], weaken [#5]]
l20: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 $ by ax
l21: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ vd ∈ trees ω $ by welc_wcel [weaken [l13]]
l22: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ isset ω $ by omega_set
l23: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ kc_nz ∈ ω $ by kc_nz_omega
l24: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l25: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l22, l23, l24]
l26: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ra_add vd ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_s , scons vd ∅ ⟩ ∈ lrel $ by lrel_add_s [l21, l25, l21, lrel_add_z [l21]]
l27: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ vd = vd $ by eq_refl
l28: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ kc_s = kc_s $ by eq_refl
l29: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ∅ = ∅ $ by eq_refl
l30: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ = ⟨ kc_s , scons ty ∅ ⟩ $ by opair_eq [l28, scons_eq [eq_sym [and_elim_l [l20]], l29]]
l31: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_nz , ∅ ⟩ ∧ ve = x1 ⇒ ra_add vd ⟨ kc_s , scons ty ∅ ⟩ ve ∈ lrel $ by wcel_eq_l [ra_add_eq [l27, l30, eq_trans [eq_sym [weaken [l16]], eq_sym [and_elim_r [l20]]]], l26]
l32: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel $ by ax
l33: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ vd ∈ trees ω $ by welc_wcel [weaken [l13]]
l34: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset ∅ $ by ax_empty
l35: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset (scons n ∅) $ by scons_set [l34]
l36: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ crn j1 ⊆ f21_as_q  $ by weaken [#1]
l37: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l38: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l39: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ crn (scons n ∅) ⊆ f21_as_q  $ by node_crn_sub [l36, l37, and_elim_l [l32], wcel_isset [l38], l35]
l40: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset n $ by isset_var
l41: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ n ∈ f21_as_q  $ by crn_scons_head [l40, l39]
l42: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ n = n $ by eq_refl
l43: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ j = j $ by eq_refl
l44: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ra_add ⟨ kc_s , scons vd ∅ ⟩ n j ∈ lrel $ by wcel_eq_l [ra_add_eq [weaken [l16], l42, l43], and_elim_r [and_elim_r [l32]]]
l45: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ra_add vd ⟨ kc_s , scons n ∅ ⟩ j ∈ lrel $ by f21_as_e [wcel_welc [l41], l44]
l46: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ⟨ kc_s , scons n ∅ ⟩ ∈ trees ω $ by wcel_eq_l [and_elim_l [l32], weaken [l15]]
l47: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ⟨ kr_add , scons x1 (scons n (scons j ∅)) ⟩ ∈ latoms $ by lrel_latoms [and_elim_r [and_elim_r [l32]]]
l48: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset ∅ $ by ax_empty
l49: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset (scons j ∅) $ by scons_set [l48]
l50: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset (scons n (scons j ∅)) $ by scons_set [l49]
l51: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset (scons x1 (scons n (scons j ∅))) $ by scons_set [l50]
l52: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ kr_add ∈ ω $ by kr_add_omega
l53: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ kr_add ∈ ω ∧ scons x1 (scons n (scons j ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l47, wcel_isset [l52], l51]
l54: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ crn (scons x1 (scons n (scons j ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l53]]
l55: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ crn (scons n (scons j ∅)) ⊆ trees ω $ by crn_scons_tail [l54]
l56: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ crn (scons j ∅) ⊆ trees ω $ by crn_scons_tail [l55]
l57: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ isset ω $ by omega_set
l58: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ j ∈ trees ω $ by crn_scons_head_trees [l57, l56]
l59: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ra_add vd ⟨ kc_s , scons ⟨ kc_s , scons n ∅ ⟩ ∅ ⟩ ⟨ kc_s , scons j ∅ ⟩ ∈ lrel $ by lrel_add_s [l33, l46, l58, l45]
l60: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ vd = vd $ by eq_refl
l61: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l62: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l63: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ⟨ kc_s , scons ⟨ kc_s , scons n ∅ ⟩ ∅ ⟩ = ⟨ kc_s , scons ty ∅ ⟩ $ by opair_eq [l61, scons_eq [eq_sym [and_elim_l [l32]], l62]]
l64: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add x1 n j ∈ lrel ⇒ ra_add vd ⟨ kc_s , scons ty ∅ ⟩ ve ∈ lrel $ by wcel_eq_l [ra_add_eq [l60, l63, eq_sym [and_elim_l [and_elim_r [l32]]]], l59]
l65: $ G , x1 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ ra_add vd ⟨ kc_s , scons ty ∅ ⟩ ve ∈ lrel $ by f21_inv_add [l19, l31, l64]
l66: $ G ⇒ isset ⟨ kc_s , scons vd ∅ ⟩ $ by opair_isset
l67: $ G ⇒ ra_add vd ⟨ kc_s , scons ty ∅ ⟩ ve ∈ lrel $ by isset_elim [l66, l65]

lemma f21_as_all (G: hyps) : $ G ⇒ trees ω ⊆ f21_as_q  $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel ⇒ crn j ⊆ f21_as_q  $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel ⇒ ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ , ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel ⇒ ra_add d ⟨ kc_s , scons y ∅ ⟩ e ∈ lrel $ by f21_as_n [l1, l2, l3, l4, l5]
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ ⇒ ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel → ra_add d ⟨ kc_s , scons y ∅ ⟩ e ∈ lrel $ by imp_intro [l6]
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ ⇒ ∀ e (ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel → ra_add d ⟨ kc_s , scons y ∅ ⟩ e ∈ lrel) $ by all_intro [l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ ⇒ ∀ d ∀ e (ra_add ⟨ kc_s , scons d ∅ ⟩ y e ∈ lrel → ra_add d ⟨ kc_s , scons y ∅ ⟩ e ∈ lrel) $ by all_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ ⇒ y ∊ f21_as_q  $ by cab_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f21_as_q  $ by wcel_intro [l11, l10]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f21_as_q  ⇒ ⟨ i , j ⟩ ∈ f21_as_q  $ by isset_elim [l13, l12]
l15: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f21_as_q  → ⟨ i , j ⟩ ∈ f21_as_q  $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f21_as_q  → ⟨ i , j ⟩ ∈ f21_as_q ) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f21_as_q  $ by trees_ind_c [l17, l16]

add_shift
---------
l1: $ G ⇒ ⟨ kr_add , scons ⟨ kc_s , scons d ∅ ⟩ (scons a (scons e ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons e ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons a (scons e ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ⟨ kc_s , scons d ∅ ⟩ (scons a (scons e ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
l7: $ G ⇒ kr_add ∈ ω ∧ scons ⟨ kc_s , scons d ∅ ⟩ (scons a (scons e ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons ⟨ kc_s , scons d ∅ ⟩ (scons a (scons e ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ crn (scons a (scons e ∅)) ⊆ trees ω $ by crn_scons_tail [l8]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ a ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ trees ω ⊆ f21_as_q  $ by f21_as_all
l13: $ G ⇒ a ∊ f21_as_q  $ by subset_elim [l12, wcel_welc [l11]]
l14: $ G ⇒ ra_add d ⟨ kc_s , scons a ∅ ⟩ e ∈ lrel $ by f21_as_e [l13, #1]

--| @freshen H qk_v
--| @freshen H qt_v
--| @freshen H qm_v
--| @freshen H qna
--| @freshen H qX
lemma f21_inv_indapp {qk_v qt_v qm_v qna qX: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6: set): $ G ⇒ ra_indapp t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ H , ra_spine ⟨ kc_bvar , scons qt_v ∅ ⟩ t5 qna ∈ lrel ∧ ra_add t4 t3 qk_v ∈ lrel ∧ ra_add qk_v t6 qt_v ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qt_v ∅ ⟩ t4 t3 qX ∈ lrel ∧ ra_nidx t1 t6 qm_v ∈ lrel ∧ ra_iargs qk_v qm_v qX t5 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_indapp t1 t2 t3 t4 t5 t6 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ qk_v ∃ qt_v ∃ qm_v ∃ qna ∃ qX ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = w ∧ t6 = v ∧ ra_spine ⟨ kc_bvar , scons qt_v ∅ ⟩ w qna ∈ lrel ∧ ra_add u z qk_v ∈ lrel ∧ ra_add qk_v v qt_v ∈ lrel ∧ ra_le ⟨ kc_s , scons v ∅ ⟩ y ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qt_v ∅ ⟩ u z qX ∈ lrel ∧ ra_nidx x v qm_v ∈ lrel ∧ ra_iargs qk_v qm_v qX w ∈ lrel) $ by lrel_indapp_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = w ∧ t6 = v ∧ ra_spine ⟨ kc_bvar , scons qt_v ∅ ⟩ w qna ∈ lrel ∧ ra_add u z qk_v ∈ lrel ∧ ra_add qk_v v qt_v ∈ lrel ∧ ra_le ⟨ kc_s , scons v ∅ ⟩ y ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qt_v ∅ ⟩ u z qX ∈ lrel ∧ ra_nidx x v qm_v ∈ lrel ∧ ra_iargs qk_v qm_v qX w ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = w ∧ t6 = v ∧ ra_spine ⟨ kc_bvar , scons qt_v ∅ ⟩ w qna ∈ lrel ∧ ra_add u z qk_v ∈ lrel ∧ ra_add qk_v v qt_v ∈ lrel ∧ ra_le ⟨ kc_s , scons v ∅ ⟩ y ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qt_v ∅ ⟩ u z qX ∈ lrel ∧ ra_nidx x v qm_v ∈ lrel ∧ ra_iargs qk_v qm_v qX w ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = w ∧ t6 = v ∧ ra_spine ⟨ kc_bvar , scons qt_v ∅ ⟩ w qna ∈ lrel ∧ ra_add u z qk_v ∈ lrel ∧ ra_add qk_v v qt_v ∈ lrel ∧ ra_le ⟨ kc_s , scons v ∅ ⟩ y ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qt_v ∅ ⟩ u z qX ∈ lrel ∧ ra_nidx x v qm_v ∈ lrel ∧ ra_iargs qk_v qm_v qX w ∈ lrel ⇒ ⟨ kc_bvar , scons qt_v ∅ ⟩ = ⟨ kc_bvar , scons qt_v ∅ ⟩ $ by eq_refl
