l209: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g , x7 = ⟨ kc_cons , scons b (scons vc ∅) ⟩ , x0 = ⟨ kc_s , scons vd ∅ ⟩ , o = scons x vq , l = scons x ve ⇒ l = scons x ve $ by ax
l210: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g , x7 = ⟨ kc_cons , scons b (scons vc ∅) ⟩ , x0 = ⟨ kc_s , scons vd ∅ ⟩ , o = scons x vq , l = scons x ve ⇒ vq ∊ fseq u $ by weaken [l66]
l211: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g , x7 = ⟨ kc_cons , scons b (scons vc ∅) ⟩ , x0 = ⟨ kc_s , scons vd ∅ ⟩ , o = scons x vq , l = scons x ve ⇒ s ∊ fseq u $ by weaken [l67]
l212: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g , x7 = ⟨ kc_cons , scons b (scons vc ∅) ⟩ , x0 = ⟨ kc_s , scons vd ∅ ⟩ , o = scons x vq , l = scons x ve ⇒ ra_fprops td tn tnp ⟨ kc_cons , scons b (scons vc ∅) ⟩ ⟨ kc_s , scons vd ∅ ⟩ n m ∈ lrel3 J $ by weaken [l57]
