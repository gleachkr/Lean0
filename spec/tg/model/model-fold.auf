lemma f16_rw_all (G: hyps) (M Z K: class) (u w td tn tm ti tnp p c0 rr n0: set): $ G ⇒ trees ω ⊆ f16_rw_q M Z K u w td tn tm ti tnp p c0 rr n0 $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f16_rw_q M Z K u w td tn tm ti tnp p c0 rr n0 , y = ⟨ i , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , c0 ∊ fseq u , cdm c0 = nadd (nvf' tm) (nvf' tn) , rr ∊ fseq u , n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ , n0 ∊ trees ω , ∀ x (x ∊ fseq u → dt u M n0 w x = Z) , K ∈ cdm c0 , nadd (suc K) (nvf' ti) = cdm c0 , ra_rtail td tnp tn tm ti d y m ∈ lrel , y ∊ trees ω , m ∊ ofsort lsig lopen ks_expr , d ∊ ofsort lsig lopen ks_nat , e ∊ fseq u , cdm e = nvf' d , r = e ++ c0 ++ p ++ rr ⇒ crn j ⊆ f16_rw_q M Z K u w td tn tm ti tnp p c0 rr n0 $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f16_rw_q M Z K u w td tn tm ti tnp p c0 rr n0 , y = ⟨ i , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , c0 ∊ fseq u , cdm c0 = nadd (nvf' tm) (nvf' tn) , rr ∊ fseq u , n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ , n0 ∊ trees ω , ∀ x (x ∊ fseq u → dt u M n0 w x = Z) , K ∈ cdm c0 , nadd (suc K) (nvf' ti) = cdm c0 , ra_rtail td tnp tn tm ti d y m ∈ lrel , y ∊ trees ω , m ∊ ofsort lsig lopen ks_expr , d ∊ ofsort lsig lopen ks_nat , e ∊ fseq u , cdm e = nvf' d , r = e ++ c0 ++ p ++ rr ⇒ y = ⟨ i , j ⟩ $ by ax
