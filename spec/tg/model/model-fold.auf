l226: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ b ∃ c ∃ qdp ∃ qkn ∃ qh0 ∃ qh1 ∃ qh_v ∃ qni ∃ qmi ∃ qa_v ∃ qb_v ∃ f ∃ g ∃ qK2 ∃ qK3 ∃ qY ∃ qX ∃ qY1 ∃ qY2 ∃ qMin (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = b ∧ t8 = b ∧ t9 = c ∧ t10 = f ∧ t11 = g ∧ t12 = qMin ∧ ra_add b y qdp ∈ lrel ∧ ra_add u z qkn ∈ lrel ∧ ra_add qdp v qh0 ∈ lrel ∧ ra_add qh0 qkn qh1 ∈ lrel ∧ ra_add qh1 c qh_v ∈ lrel ∧ ra_lift qkn b g qK2 ∈ lrel ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ qK2 qK3 ∈ lrel ∧ ra_nidx x v qni ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , scons qmi ∅ ⟩ qni qK3 qX ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons qh_v ∅ ⟩ qY y ∈ lrel ∧ ra_add c b qa_v ∈ lrel ∧ ra_add qa_v qkn qb_v ∈ lrel ∧ ra_add qmi ⟨ kc_s , scons v ∅ ⟩ qb_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons x (scons v (scons w ∅)) ⟩ qb_v y qY1 ∈ lrel ∧ ra_pargs qY1 c b qY2 ∈ lrel ∧ ra_pis f ⟨ kc_app , scons qX (scons qY2 ∅) ⟩ qMin ∈ lrel)) → Cf $ by imp_intro [l225]
l227: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ qdp ∃ qkn ∃ qj_v ∃ qa_v ∃ qsh ∃ qfld ∃ qmo ∃ f ∃ qA ∃ qA2 ∃ qA3 ∃ qA4 ∃ qB ∃ qIH ∃ qMin (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = f ∧ t11 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons qA3 (scons qMin ∅) ⟩ ∧ ra_add b y qdp ∈ lrel ∧ ra_recfield x z y b qA qj_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ z qdp qA qA2 ∈ lrel ∧ ra_add u z qkn ∈ lrel ∧ ra_lift qkn b qA2 qA3 ∈ lrel ∧ ra_add c a qa_v ∈ lrel ∧ ra_add qsh b qa_v ∈ lrel ∧ ra_add qfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ qsh ∈ lrel ∧ ra_add qa_v u qmo ∈ lrel ∧ ra_lift qsh ⟨ kc_nz , ∅ ⟩ qA3 qA4 ∈ lrel ∧ ra_ihty x y z qmo qfld ⟨ kc_nz , ∅ ⟩ qj_v qA4 qIH ∈ lrel ∧ ra_mwalk x y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_cons , scons qIH (scons f ∅) ⟩ qB qMin ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ b ∃ c ∃ qdp ∃ qkn ∃ qh0 ∃ qh1 ∃ qh_v ∃ qni ∃ qmi ∃ qa_v ∃ qb_v ∃ f ∃ g ∃ qK2 ∃ qK3 ∃ qY ∃ qX ∃ qY1 ∃ qY2 ∃ qMin (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = b ∧ t8 = b ∧ t9 = c ∧ t10 = f ∧ t11 = g ∧ t12 = qMin ∧ ra_add b y qdp ∈ lrel ∧ ra_add u z qkn ∈ lrel ∧ ra_add qdp v qh0 ∈ lrel ∧ ra_add qh0 qkn qh1 ∈ lrel ∧ ra_add qh1 c qh_v ∈ lrel ∧ ra_lift qkn b g qK2 ∈ lrel ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ qK2 qK3 ∈ lrel ∧ ra_nidx x v qni ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , scons qmi ∅ ⟩ qni qK3 qX ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons qh_v ∅ ⟩ qY y ∈ lrel ∧ ra_add c b qa_v ∈ lrel ∧ ra_add qa_v qkn qb_v ∈ lrel ∧ ra_add qmi ⟨ kc_s , scons v ∅ ⟩ qb_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons x (scons v (scons w ∅)) ⟩ qb_v y qY1 ∈ lrel ∧ ra_pargs qY1 c b qY2 ∈ lrel ∧ ra_pis f ⟨ kc_app , scons qX (scons qY2 ∅) ⟩ qMin ∈ lrel)) → Cf $ by or_elim_imp [l134, l226]
l228: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ qdp ∃ qkn ∃ f ∃ qA ∃ qA3 ∃ qB ∃ qMin (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = f ∧ t11 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons qA3 (scons qMin ∅) ⟩ ∧ ra_add b y qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add u z qkn ∈ lrel ∧ ra_lift qkn b qA qA3 ∈ lrel ∧ ra_mwalk x y z u v w a ⟨ kc_s , scons b ∅ ⟩ c f qB qMin ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ qdp ∃ qkn ∃ qj_v ∃ qa_v ∃ qsh ∃ qfld ∃ qmo ∃ f ∃ qA ∃ qA2 ∃ qA3 ∃ qA4 ∃ qB ∃ qIH ∃ qMin (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = f ∧ t11 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons qA3 (scons qMin ∅) ⟩ ∧ ra_add b y qdp ∈ lrel ∧ ra_recfield x z y b qA qj_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ z qdp qA qA2 ∈ lrel ∧ ra_add u z qkn ∈ lrel ∧ ra_lift qkn b qA2 qA3 ∈ lrel ∧ ra_add c a qa_v ∈ lrel ∧ ra_add qsh b qa_v ∈ lrel ∧ ra_add qfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ qsh ∈ lrel ∧ ra_add qa_v u qmo ∈ lrel ∧ ra_lift qsh ⟨ kc_nz , ∅ ⟩ qA3 qA4 ∈ lrel ∧ ra_ihty x y z qmo qfld ⟨ kc_nz , ∅ ⟩ qj_v qA4 qIH ∈ lrel ∧ ra_mwalk x y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_cons , scons qIH (scons f ∅) ⟩ qB qMin ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ b ∃ c ∃ qdp ∃ qkn ∃ qh0 ∃ qh1 ∃ qh_v ∃ qni ∃ qmi ∃ qa_v ∃ qb_v ∃ f ∃ g ∃ qK2 ∃ qK3 ∃ qY ∃ qX ∃ qY1 ∃ qY2 ∃ qMin (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = b ∧ t8 = b ∧ t9 = c ∧ t10 = f ∧ t11 = g ∧ t12 = qMin ∧ ra_add b y qdp ∈ lrel ∧ ra_add u z qkn ∈ lrel ∧ ra_add qdp v qh0 ∈ lrel ∧ ra_add qh0 qkn qh1 ∈ lrel ∧ ra_add qh1 c qh_v ∈ lrel ∧ ra_lift qkn b g qK2 ∈ lrel ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ qK2 qK3 ∈ lrel ∧ ra_nidx x v qni ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , scons qmi ∅ ⟩ qni qK3 qX ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons qh_v ∅ ⟩ qY y ∈ lrel ∧ ra_add c b qa_v ∈ lrel ∧ ra_add qa_v qkn qb_v ∈ lrel ∧ ra_add qmi ⟨ kc_s , scons v ∅ ⟩ qb_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons x (scons v (scons w ∅)) ⟩ qb_v y qY1 ∈ lrel ∧ ra_pargs qY1 c b qY2 ∈ lrel ∧ ra_pis f ⟨ kc_app , scons qX (scons qY2 ∅) ⟩ qMin ∈ lrel)) → Cf $ by or_elim_imp [l52, l227]
l229: $ G , H ⇒ Cf $ by imp_elim [l228, l2]

def f21_mw_q (M CT Km NI J: class) (u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl: set) (.x0 .d .r .h .m .k .l .t .p .q .x5 .n .e .z .y .f .g .c .o .x: set): class = $ {x0 | ∀ d ∀ r ∀ h ∀ m ∀ k ∀ l ∀ t ∀ p ∀ q ∀ x5 ∀ n ∀ e (uadm u → w ∊ lvals → pp ∊ fseq u → cdm pp = nvf' tnp → xs ∊ fseq u → cdm xs = nvf' tn → mk ∊ fseq u → cdm mk = nvf' tk → cv ∊ fseq u → cdm cv = nvf' tn → c0 = mk ++ cv → rr ∊ fseq u → nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ → nc ∊ trees ω → ∀ x (x ∊ fseq u → dt u M nc w x = CT) → ∀ x (isset (apn (CT) x)) → Km ∈ ω → nadd (suc Km) (nvf' ti) = nvf' tn → ∀ c (ra_nidx td ti c ∈ lrel → nvf' c = NI) → td ∊ trees ω → ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) → intys td = nvf' tn → iprt td tp tt → ra_clen tp tnp ∈ lrel → ra_ntys tt tn tm ∈ lrel → ∀ x (isset (ap (imrel td cv) x)) → ra_mwalk td tnp tn tk ti tc tnf d r h x0 m ∈ lrel → x0 ∊ ofsort lsig lopen ks_expr → m ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → ra_closed x5 x0 ∈ lrel → nvf' x5 = nadd (nadd (nvf' d) (nvf' tnp)) (nvf' tn) → ra_npis x0 n ∈ lrel → nadd (nvf' n) (nvf' d) = nvf' tnf → ra_cwf td tn tnp tl ti e d x0 ∈ lrel3 J → ∀ f ∀ g ∀ c (ra_nth_pi x0 f g ∈ lrel → ra_add d f c ∈ lrel → ra_nth_pi tK0 c g ∈ lrel) → ra_clen h r ∈ lrel → k ∊ fseq u → cdm k = nvf' d → l ∊ fseq u → cdm l = nvf' d → t ∊ fseq {y | y = y} → cdm t = nvf' d → p = k ++ c0 ++ pp ++ rr → q = k ++ pp ++ xs → ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x0 w q → h ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (f ++ p)) h w = ihv td tK0 (imrel td cv) (l ++ g) (t ++ c) (nvf' d)) → dt u M m w p = fpi z (mqp (etel u (dnf u M) x0 w q) td tK0 (imrel td cv) l t (nvf' tnf)) (ap (mtb u (etel u (dnf u M) x0 w q) td tK0 (imrel td cv) l t (nvf' tnf) (cv' Km) (CT) k pp (NI)) z) ∧ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x0 w q → ihv td tK0 (imrel td cv) (l ++ g) (t ++ c) (nvf' tnf) ⊆ fseq u))} $

--| @freshen G z
--| @freshen G y
--| @freshen G f
--| @freshen G g
--| @freshen G c
--| @freshen G o
--| @freshen G x
lemma f21_mw_e {z y f g c o x: set} (G: hyps) (M CT Km NI J: class) (u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl: set) (ty vd vr vh vm vk vl vt vp vq vx5 vn ve: set): $ G ⇒ ty ∊ f21_mw_q M CT Km NI J u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ pp ∊ fseq u $ > $ G ⇒ cdm pp = nvf' tnp $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ mk ∊ fseq u $ > $ G ⇒ cdm mk = nvf' tk $ > $ G ⇒ cv ∊ fseq u $ > $ G ⇒ cdm cv = nvf' tn $ > $ G ⇒ c0 = mk ++ cv $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ $ > $ G ⇒ nc ∊ trees ω $ > $ G ⇒ ∀ x (x ∊ fseq u → dt u M nc w x = CT) $ > $ G ⇒ ∀ x (isset (apn (CT) x)) $ > $ G ⇒ Km ∈ ω $ > $ G ⇒ nadd (suc Km) (nvf' ti) = nvf' tn $ > $ G ⇒ ∀ c (ra_nidx td ti c ∈ lrel → nvf' c = NI) $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) $ > $ G ⇒ intys td = nvf' tn $ > $ G ⇒ iprt td tp tt $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ∀ x (isset (ap (imrel td cv) x)) $ > $ G ⇒ ra_mwalk td tnp tn tk ti tc tnf vd vr vh ty vm ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ trees ω $ > $ G ⇒ ra_closed vx5 ty ∈ lrel $ > $ G ⇒ nvf' vx5 = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vd) = nvf' tnf $ > $ G ⇒ ra_cwf td tn tnp tl ti ve vd ty ∈ lrel3 J $ > $ G ⇒ ∀ f ∀ g ∀ c (ra_nth_pi ty f g ∈ lrel → ra_add vd f c ∈ lrel → ra_nth_pi tK0 c g ∈ lrel) $ > $ G ⇒ ra_clen vh vr ∈ lrel $ > $ G ⇒ vk ∊ fseq u $ > $ G ⇒ cdm vk = nvf' vd $ > $ G ⇒ vl ∊ fseq u $ > $ G ⇒ cdm vl = nvf' vd $ > $ G ⇒ vt ∊ fseq {y | y = y} $ > $ G ⇒ cdm vt = nvf' vd $ > $ G ⇒ vp = vk ++ c0 ++ pp ++ rr $ > $ G ⇒ vq = vk ++ pp ++ xs $ > $ G ⇒ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vq → vh ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (f ++ vp)) vh w = ihv td tK0 (imrel td cv) (vl ++ g) (vt ++ c) (nvf' vd)) $ > $ G ⇒ dt u M vm w vp = fpi z (mqp (etel u (dnf u M) ty w vq) td tK0 (imrel td cv) vl vt (nvf' tnf)) (ap (mtb u (etel u (dnf u M) ty w vq) td tK0 (imrel td cv) vl vt (nvf' tnf) (cv' Km) (CT) vk pp (NI)) z) ∧ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vq → ihv td tK0 (imrel td cv) (vl ++ g) (vt ++ c) (nvf' tnf) ⊆ fseq u) $
----
l1: $ G ⇒ ∀ d ∀ r ∀ h ∀ m ∀ k ∀ l ∀ t ∀ p ∀ q ∀ x5 ∀ n ∀ e (uadm u → w ∊ lvals → pp ∊ fseq u → cdm pp = nvf' tnp → xs ∊ fseq u → cdm xs = nvf' tn → mk ∊ fseq u → cdm mk = nvf' tk → cv ∊ fseq u → cdm cv = nvf' tn → c0 = mk ++ cv → rr ∊ fseq u → nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ → nc ∊ trees ω → ∀ x (x ∊ fseq u → dt u M nc w x = CT) → ∀ x (isset (apn (CT) x)) → Km ∈ ω → nadd (suc Km) (nvf' ti) = nvf' tn → ∀ c (ra_nidx td ti c ∈ lrel → nvf' c = NI) → td ∊ trees ω → ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) → intys td = nvf' tn → iprt td tp tt → ra_clen tp tnp ∈ lrel → ra_ntys tt tn tm ∈ lrel → ∀ x (isset (ap (imrel td cv) x)) → ra_mwalk td tnp tn tk ti tc tnf d r h ty m ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → m ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → ra_closed x5 ty ∈ lrel → nvf' x5 = nadd (nadd (nvf' d) (nvf' tnp)) (nvf' tn) → ra_npis ty n ∈ lrel → nadd (nvf' n) (nvf' d) = nvf' tnf → ra_cwf td tn tnp tl ti e d ty ∈ lrel3 J → ∀ f ∀ g ∀ c (ra_nth_pi ty f g ∈ lrel → ra_add d f c ∈ lrel → ra_nth_pi tK0 c g ∈ lrel) → ra_clen h r ∈ lrel → k ∊ fseq u → cdm k = nvf' d → l ∊ fseq u → cdm l = nvf' d → t ∊ fseq {y | y = y} → cdm t = nvf' d → p = k ++ c0 ++ pp ++ rr → q = k ++ pp ++ xs → ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w q → h ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (f ++ p)) h w = ihv td tK0 (imrel td cv) (l ++ g) (t ++ c) (nvf' d)) → dt u M m w p = fpi z (mqp (etel u (dnf u M) ty w q) td tK0 (imrel td cv) l t (nvf' tnf)) (ap (mtb u (etel u (dnf u M) ty w q) td tK0 (imrel td cv) l t (nvf' tnf) (cv' Km) (CT) k pp (NI)) z) ∧ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w q → ihv td tK0 (imrel td cv) (l ++ g) (t ++ c) (nvf' tnf) ⊆ fseq u)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r ∀ h ∀ m ∀ k ∀ l ∀ t ∀ p ∀ q ∀ x5 ∀ n ∀ e (uadm u → w ∊ lvals → pp ∊ fseq u → cdm pp = nvf' tnp → xs ∊ fseq u → cdm xs = nvf' tn → mk ∊ fseq u → cdm mk = nvf' tk → cv ∊ fseq u → cdm cv = nvf' tn → c0 = mk ++ cv → rr ∊ fseq u → nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ → nc ∊ trees ω → ∀ x (x ∊ fseq u → dt u M nc w x = CT) → ∀ x (isset (apn (CT) x)) → Km ∈ ω → nadd (suc Km) (nvf' ti) = nvf' tn → ∀ c (ra_nidx td ti c ∈ lrel → nvf' c = NI) → td ∊ trees ω → ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) → intys td = nvf' tn → iprt td tp tt → ra_clen tp tnp ∈ lrel → ra_ntys tt tn tm ∈ lrel → ∀ x (isset (ap (imrel td cv) x)) → ra_mwalk td tnp tn tk ti tc tnf vd r h ty m ∈ lrel → ty ∊ ofsort lsig lopen ks_expr → m ∊ ofsort lsig lopen ks_expr → vd ∊ trees ω → ra_closed x5 ty ∈ lrel → nvf' x5 = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) → ra_npis ty n ∈ lrel → nadd (nvf' n) (nvf' vd) = nvf' tnf → ra_cwf td tn tnp tl ti e vd ty ∈ lrel3 J → ∀ f ∀ g ∀ c (ra_nth_pi ty f g ∈ lrel → ra_add vd f c ∈ lrel → ra_nth_pi tK0 c g ∈ lrel) → ra_clen h r ∈ lrel → k ∊ fseq u → cdm k = nvf' vd → l ∊ fseq u → cdm l = nvf' vd → t ∊ fseq {y | y = y} → cdm t = nvf' vd → p = k ++ c0 ++ pp ++ rr → q = k ++ pp ++ xs → ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w q → h ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (f ++ p)) h w = ihv td tK0 (imrel td cv) (l ++ g) (t ++ c) (nvf' vd)) → dt u M m w p = fpi z (mqp (etel u (dnf u M) ty w q) td tK0 (imrel td cv) l t (nvf' tnf)) (ap (mtb u (etel u (dnf u M) ty w q) td tK0 (imrel td cv) l t (nvf' tnf) (cv' Km) (CT) k pp (NI)) z) ∧ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w q → ihv td tK0 (imrel td cv) (l ++ g) (t ++ c) (nvf' tnf) ⊆ fseq u)) $ by all_elim [l1]
