def f9_fw_q (J M: class) (u w v s t1 t3 tz ts: set) (.y .c .d .n .q .r .e .g .a .b .h .k .l .m .o .x3 .x4 .x5: set): class = $ {y | ∀ c ∀ d ∀ n ∀ q ∀ r ∀ e ∀ g ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 c d y ∈ lrel3 J → c ∊ trees ω → ra_closed n y ∈ lrel → q ∊ fseq u → r ∊ fseq u → cdm q = nadd (nvf' d) (nvf' t3) → cdm r = cdm q → nvf' n = nadd (cdm q) (cdm v) → q ++ s ∈ sat u M c w → r ++ s ∈ sat u M c w → e = q ++ v → g = r ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w e → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w g → b = l ∧ ∀ x3 (ra_leaf_has x3 y ∈ lrel → e' nvf' x3 = g' nvf' x3))} $

--| @freshen G x3
--| @freshen G x4
--| @freshen G x5
lemma f9_fw_e {x3 x4 x5: set} (G: hyps) (J M: class) (u w v s t1 t3 tz ts: set) (ty vc vd vn vq vr ve vg va vb vh vk vl vm vo: set): $ G ⇒ ty ∊ f9_fw_q J M u w v s t1 t3 tz ts $ > $ G ⇒ jval u M J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ t1 ∊ trees ω $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ > $ G ⇒ nadd (nvf' tz) (cdm v) = nvf' ts $ > $ G ⇒ ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) $ > $ G ⇒ ra_fir t1 t3 vc vd ty ∈ lrel3 J $ > $ G ⇒ vc ∊ trees ω $ > $ G ⇒ ra_closed vn ty ∈ lrel $ > $ G ⇒ vq ∊ fseq u $ > $ G ⇒ vr ∊ fseq u $ > $ G ⇒ cdm vq = nadd (nvf' vd) (nvf' t3) $ > $ G ⇒ cdm vr = cdm vq $ > $ G ⇒ nvf' vn = nadd (cdm vq) (cdm v) $ > $ G ⇒ vq ++ s ∈ sat u M vc w $ > $ G ⇒ vr ++ s ∈ sat u M vc w $ > $ G ⇒ ve = vq ++ v $ > $ G ⇒ vg = vr ++ v $ > $ G ⇒ ⟨ va , ⟨ vb , ⟨ vh , vo ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w ve $ > $ G ⇒ ⟨ vk , ⟨ vl , ⟨ vm , vo ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vg $ > $ G ⇒ vb = vl ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → ve' nvf' x3 = vg' nvf' x3) $
----
l1: $ G ⇒ ∀ c ∀ d ∀ n ∀ q ∀ r ∀ e ∀ g ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 c d ty ∈ lrel3 J → c ∊ trees ω → ra_closed n ty ∈ lrel → q ∊ fseq u → r ∊ fseq u → cdm q = nadd (nvf' d) (nvf' t3) → cdm r = cdm q → nvf' n = nadd (cdm q) (cdm v) → q ++ s ∈ sat u M c w → r ++ s ∈ sat u M c w → e = q ++ v → g = r ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w g → b = l ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → e' nvf' x3 = g' nvf' x3)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ d ∀ n ∀ q ∀ r ∀ e ∀ g ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 vc d ty ∈ lrel3 J → vc ∊ trees ω → ra_closed n ty ∈ lrel → q ∊ fseq u → r ∊ fseq u → cdm q = nadd (nvf' d) (nvf' t3) → cdm r = cdm q → nvf' n = nadd (cdm q) (cdm v) → q ++ s ∈ sat u M vc w → r ++ s ∈ sat u M vc w → e = q ++ v → g = r ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w g → b = l ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → e' nvf' x3 = g' nvf' x3)) $ by all_elim [l1]
l3: $ G ⇒ ∀ n ∀ q ∀ r ∀ e ∀ g ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 vc vd ty ∈ lrel3 J → vc ∊ trees ω → ra_closed n ty ∈ lrel → q ∊ fseq u → r ∊ fseq u → cdm q = nadd (nvf' vd) (nvf' t3) → cdm r = cdm q → nvf' n = nadd (cdm q) (cdm v) → q ++ s ∈ sat u M vc w → r ++ s ∈ sat u M vc w → e = q ++ v → g = r ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w g → b = l ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → e' nvf' x3 = g' nvf' x3)) $ by all_elim [l2]
l4: $ G ⇒ ∀ q ∀ r ∀ e ∀ g ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 vc vd ty ∈ lrel3 J → vc ∊ trees ω → ra_closed vn ty ∈ lrel → q ∊ fseq u → r ∊ fseq u → cdm q = nadd (nvf' vd) (nvf' t3) → cdm r = cdm q → nvf' vn = nadd (cdm q) (cdm v) → q ++ s ∈ sat u M vc w → r ++ s ∈ sat u M vc w → e = q ++ v → g = r ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w g → b = l ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → e' nvf' x3 = g' nvf' x3)) $ by all_elim [l3]
l5: $ G ⇒ ∀ r ∀ e ∀ g ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 vc vd ty ∈ lrel3 J → vc ∊ trees ω → ra_closed vn ty ∈ lrel → vq ∊ fseq u → r ∊ fseq u → cdm vq = nadd (nvf' vd) (nvf' t3) → cdm r = cdm vq → nvf' vn = nadd (cdm vq) (cdm v) → vq ++ s ∈ sat u M vc w → r ++ s ∈ sat u M vc w → e = vq ++ v → g = r ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w g → b = l ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → e' nvf' x3 = g' nvf' x3)) $ by all_elim [l4]
l6: $ G ⇒ ∀ e ∀ g ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 vc vd ty ∈ lrel3 J → vc ∊ trees ω → ra_closed vn ty ∈ lrel → vq ∊ fseq u → vr ∊ fseq u → cdm vq = nadd (nvf' vd) (nvf' t3) → cdm vr = cdm vq → nvf' vn = nadd (cdm vq) (cdm v) → vq ++ s ∈ sat u M vc w → vr ++ s ∈ sat u M vc w → e = vq ++ v → g = vr ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w g → b = l ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → e' nvf' x3 = g' nvf' x3)) $ by all_elim [l5]
l7: $ G ⇒ ∀ g ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 vc vd ty ∈ lrel3 J → vc ∊ trees ω → ra_closed vn ty ∈ lrel → vq ∊ fseq u → vr ∊ fseq u → cdm vq = nadd (nvf' vd) (nvf' t3) → cdm vr = cdm vq → nvf' vn = nadd (cdm vq) (cdm v) → vq ++ s ∈ sat u M vc w → vr ++ s ∈ sat u M vc w → ve = vq ++ v → g = vr ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w ve → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w g → b = l ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → ve' nvf' x3 = g' nvf' x3)) $ by all_elim [l6]
l8: $ G ⇒ ∀ a ∀ b ∀ h ∀ k ∀ l ∀ m ∀ o (jval u M J → uadm u → w ∊ lvals → v ∊ fseq u → s ∊ fseq u → t1 ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ → nadd (nvf' tz) (cdm v) = nvf' ts → ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = v' x4) → ra_fir t1 t3 vc vd ty ∈ lrel3 J → vc ∊ trees ω → ra_closed vn ty ∈ lrel → vq ∊ fseq u → vr ∊ fseq u → cdm vq = nadd (nvf' vd) (nvf' t3) → cdm vr = cdm vq → nvf' vn = nadd (cdm vq) (cdm v) → vq ++ s ∈ sat u M vc w → vr ++ s ∈ sat u M vc w → ve = vq ++ v → vg = vr ++ v → ⟨ a , ⟨ b , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w ve → ⟨ k , ⟨ l , ⟨ m , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vg → b = l ∧ ∀ x3 (ra_leaf_has x3 ty ∈ lrel → ve' nvf' x3 = vg' nvf' x3)) $ by all_elim [l7]
