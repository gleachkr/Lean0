--| @freshen G e
lemma f23_cm_e {l i v a o f g b e: set} (G: hyps) (M Km J V N: class) (u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0: set) (ty vk vd vm vh vq vr: set): $ G ⇒ ty ∊ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ pp ∊ esat u (dnf u M) tp w $ > $ G ⇒ xs = ixs td w (ifam u (dnf u M) td w) $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ cv ∊ imots u (dnf u M) td w pp V $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) $ > $ G ⇒ intys td = nvf' tn $ > $ G ⇒ iprt td tp tt $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_nth_ty tt ti tF tC0 ∈ lrel $ > $ G ⇒ Km ∈ ω $ > $ G ⇒ nadd (suc Km) (nvf' ti) = nvf' tn $ > $ G ⇒ nvf' ti ∈ nvf' tn $ > $ G ⇒ ti ∊ trees ω $ > $ G ⇒ ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) $ > $ G ⇒ ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) $ > $ G ⇒ ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) $ > $ G ⇒ ra_cminors td tnp tn vk ti vd ty vm ∈ lrel $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vd ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ nvf' vk = nadd (nvf' vd) (nvf' tk0) $ > $ G ⇒ ∀ a ∀ e (ra_nth_ctor ty a e ∈ lrel → ∃ b (ra_add a vd b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) $ > $ G ⇒ ra_clen_c ty vq ∈ lrel $ > $ G ⇒ nadd (nvf' vk) (nvf' vq) = N $ > $ G ⇒ vh ∊ fseq u $ > $ G ⇒ cdm vh = nvf' vk $ > $ G ⇒ vr = vh ++ cv ++ pp ++ rr $ > $ G ⇒ esat u (dsh u M vr) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vq ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $
