l6: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ w ∊ lvals $ by weaken [#6]
l7: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ esat u (dsh u M vr) vm w = csn ∅ $ by eq_trans [esat_eq [l4, l5], esat_nil [l6]]
l8: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vm = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
