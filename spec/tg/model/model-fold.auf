l28: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ kr_pinst ∈ ω ∧ scons vi (scons ty (scons x1 (scons vr ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l21, wcel_isset [l27], l26]
l29: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ crn (scons vi (scons ty (scons x1 (scons vr ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l28]]
l30: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ crn (scons ty (scons x1 (scons vr ∅))) ⊆ trees ω $ by crn_scons_tail [l29]
