def f13_mw_q (M Z: class) (u w td tj tnp tv p c0 rr n0: set) (.y .d .m .e .r .x .t .f: set): class = $ {y | ∀ d ∀ m ∀ e ∀ r (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → c0 ∊ fseq u → cdm c0 = nvf' tj → rr ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ → n0 ∊ trees ω → ∀ x (x ∊ fseq u → dt u M n0 w x = Z) → tv ∊ trees ω → ra_mty td tnp tj d tv y m ∈ lrel → y ∊ trees ω → m ∊ ofsort lsig lopen ks_expr → d ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' d → r = e ++ c0 ++ p ++ rr → dt u M m w r = fpi t (mpth u (dnf u M) y w r (clam f (fseq u) (apn (Z) (f ++ e ++ p)))) (ap (clam f (fseq u) (uni' (lv tv w))) t))} $

--| @freshen G x
--| @freshen G t
--| @freshen G f
lemma f13_mw_e {x t f: set} (G: hyps) (M Z: class) (u w td tj tnp tv p c0 rr n0: set) (ty vd vm ve vr: set): $ G ⇒ ty ∊ f13_mw_q M Z u w td tj tnp tv p c0 rr n0 $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' tnp $ > $ G ⇒ c0 ∊ fseq u $ > $ G ⇒ cdm c0 = nvf' tj $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ > $ G ⇒ n0 ∊ trees ω $ > $ G ⇒ ∀ x (x ∊ fseq u → dt u M n0 w x = Z) $ > $ G ⇒ tv ∊ trees ω $ > $ G ⇒ ra_mty td tnp tj vd tv ty vm ∈ lrel $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ve ∊ fseq u $ > $ G ⇒ cdm ve = nvf' vd $ > $ G ⇒ vr = ve ++ c0 ++ p ++ rr $ > $ G ⇒ dt u M vm w vr = fpi t (mpth u (dnf u M) ty w vr (clam f (fseq u) (apn (Z) (f ++ ve ++ p)))) (ap (clam f (fseq u) (uni' (lv tv w))) t) $
----
l1: $ G ⇒ ∀ d ∀ m ∀ e ∀ r (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → c0 ∊ fseq u → cdm c0 = nvf' tj → rr ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ → n0 ∊ trees ω → ∀ x (x ∊ fseq u → dt u M n0 w x = Z) → tv ∊ trees ω → ra_mty td tnp tj d tv ty m ∈ lrel → ty ∊ trees ω → m ∊ ofsort lsig lopen ks_expr → d ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' d → r = e ++ c0 ++ p ++ rr → dt u M m w r = fpi t (mpth u (dnf u M) ty w r (clam f (fseq u) (apn (Z) (f ++ e ++ p)))) (ap (clam f (fseq u) (uni' (lv tv w))) t)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ m ∀ e ∀ r (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → c0 ∊ fseq u → cdm c0 = nvf' tj → rr ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ → n0 ∊ trees ω → ∀ x (x ∊ fseq u → dt u M n0 w x = Z) → tv ∊ trees ω → ra_mty td tnp tj vd tv ty m ∈ lrel → ty ∊ trees ω → m ∊ ofsort lsig lopen ks_expr → vd ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' vd → r = e ++ c0 ++ p ++ rr → dt u M m w r = fpi t (mpth u (dnf u M) ty w r (clam f (fseq u) (apn (Z) (f ++ e ++ p)))) (ap (clam f (fseq u) (uni' (lv tv w))) t)) $ by all_elim [l1]
