l10: $ G , d = scons x f ⇒ ssnoc d a = d ++ (scons a ∅) $ by ssnoc_scat [l9]
l11: $ G , d = scons x f ⇒ a = a $ by eq_refl
l12: $ G , d = scons x f ⇒ scons a ∅ = scons a ∅ $ by eq_refl
l13: $ G , d = scons x f ⇒ scons x f ++ (scons a ∅) = scons x (f ++ (scons a ∅)) $ by weaken [l4]
l14: $ G , d = scons x f ⇒ x = x $ by eq_refl
l15: $ G , d = scons x f ⇒ ssnoc f a = f ++ (scons a ∅) $ by weaken [l5]
l16: $ G , d = scons x f ⇒ ssnoc (scons x f) a = scons x (ssnoc f a) $ by eq_trans [ssnoc_eq [eq_sym [l6], l11], eq_trans [l10, eq_trans [scat_eq [l6, l12], eq_trans [l13, scons_eq [l14, eq_sym [l15]]]]]]
l17: $ G ⇒ isset f $ by isset_var
l18: $ G ⇒ isset (scons x f) $ by scons_set [l17]
l19: $ G ⇒ ssnoc (scons x f) a = scons x (ssnoc f a) $ by isset_elim [l18, l16]

ssnoc_inj
---------
l1: $ G ⇒ cdm (ssnoc s a) = suc (cdm s) $ by ssnoc_len [#1]
l2: $ G ⇒ cdm (ssnoc t b) = suc (cdm t) $ by ssnoc_len [#2]
