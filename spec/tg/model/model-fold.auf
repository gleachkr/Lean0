def f39_in_q (td tnp tn tm tv tnf tfld tj: set) (.y .d .m .z: set): class = $ {y | ∀ d ∀ m (ra_ihval td tnp tn tm tv tnf tfld d tj y m ∈ lrel → ∃ z (ra_nidx td tj z ∈ lrel))} $

--| @freshen G z
lemma f39_in_e {z: set} (G: hyps) (td tnp tn tm tv tnf tfld tj: set) (ty vd vm: set): $ G ⇒ ty ∊ f39_in_q td tnp tn tm tv tnf tfld tj $ > $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld vd tj ty vm ∈ lrel $ > $ G ⇒ ∃ z (ra_nidx td tj z ∈ lrel) $
----
l1: $ G ⇒ ∀ d ∀ m (ra_ihval td tnp tn tm tv tnf tfld d tj ty m ∈ lrel → ∃ z (ra_nidx td tj z ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ m (ra_ihval td tnp tn tm tv tnf tfld vd tj ty m ∈ lrel → ∃ z (ra_nidx td tj z ∈ lrel)) $ by all_elim [l1]
l3: $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld vd tj ty vm ∈ lrel → ∃ z (ra_nidx td tj z ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ∃ z (ra_nidx td tj z ∈ lrel) $ by imp_elim [l3, #2]

--| @freshen G z
lemma f39_in_n {z: set} (G: hyps) (td tnp tn tm tv tnf tfld tj: set) (ty k1 j1 vd vm: set): $ G ⇒ crn j1 ⊆ f39_in_q td tnp tn tm tv tnf tfld tj $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld vd tj ty vm ∈ lrel $ > $ G ⇒ ∃ z (ra_nidx td tj z ∈ lrel) $
----
l1: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel $ by ax
l2: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by and_elim_l [l1]
l3: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ $ by and_elim_l [and_elim_r [l1]]
l4: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel $ by and_elim_r [and_elim_r [l1]]
l5: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ isset ∅ $ by ax_empty
l6: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ isset (scons b ∅) $ by scons_set [l5]
l7: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ isset (scons a (scons b ∅)) $ by scons_set [l6]
l8: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ crn j1 ⊆ f39_in_q td tnp tn tm tv tnf tfld tj $ by weaken [#1]
l9: $ G , ty = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ vm = ⟨ kc_lam , scons a (scons c ∅) ⟩ ∧ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_s , scons vd ∅ ⟩ tj b c ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
