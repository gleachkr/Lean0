l1: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b ⇒ b ∊ ω $ by weaken [#3]
l2: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b ⇒ cdm c = nadd z b $ by ax
l3: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b ⇒ z = ∅ $ by ax
l4: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b ⇒ b = b $ by eq_refl
l5: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b ⇒ cdm c = b $ by eq_trans [l2, eq_trans [nadd_eq [l3, l4], zero_nadd [l1]]]
l6: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ x1 = ∅ $ by ax
l7: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ c ∊ fseq A $ by ax
l8: $ G , z = ∅ , c ∊ fseq A , cdm c = nadd z b , x1 = ∅ ⇒ ∅ ∈ fseq A $ by fseq_empty
