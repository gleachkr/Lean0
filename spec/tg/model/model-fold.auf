l10: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ x4 = ⟨ kc_s , scons tk ∅ ⟩ $ by ax
l11: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ x5 = nvf' tm $ by ax
l12: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ w ∊ lvals $ by weaken [#1]
l13: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ pf ∊ fseq u $ by weaken [#2]
l14: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ rm ∊ fseq u $ by weaken [l4]
l15: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ pf ++ rm ∈ fseq u $ by weaken [l6]
l16: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ x2 ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l8], l15]]
l17: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ ra_add tmk ⟨ kc_s , scons tk ∅ ⟩ ta ∈ lrel $ by weaken [#9]
l18: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ ⟨ kr_add , scons tmk (scons ⟨ kc_s , scons tk ∅ ⟩ (scons ta ∅)) ⟩ ∈ latoms $ by lrel_latoms [l17]
l19: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ isset ∅ $ by ax_empty
l20: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ isset (scons ta ∅) $ by scons_set [l19]
l21: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ isset (scons ⟨ kc_s , scons tk ∅ ⟩ (scons ta ∅)) $ by scons_set [l20]
l22: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ isset (scons tmk (scons ⟨ kc_s , scons tk ∅ ⟩ (scons ta ∅))) $ by scons_set [l21]
l23: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ kr_add ∈ ω $ by kr_add_omega
l24: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ kr_add ∈ ω ∧ scons tmk (scons ⟨ kc_s , scons tk ∅ ⟩ (scons ta ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l18, wcel_isset [l23], l22]
l25: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ crn (scons tmk (scons ⟨ kc_s , scons tk ∅ ⟩ (scons ta ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l24]]
l26: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ isset ω $ by omega_set
l27: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ tmk ∈ trees ω $ by crn_scons_head_trees [l26, l25]
l28: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ isset ω $ by omega_set
l29: $ G , x1 = ⟨ kc_bvar , scons tmk ∅ ⟩ , x2 = pf ++ rm , x3 = ⟨ kc_nz , ∅ ⟩ , x4 = ⟨ kc_s , scons tk ∅ ⟩ , x5 = nvf' tm ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
