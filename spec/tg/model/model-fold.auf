--| @freshen H qe_v
--| @freshen H qa_v
--| @freshen H qk_v
lemma f21_inv_spine {qe_v qa_v qk_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_spine t1 t2 t3 ∈ lrel $ > $ H , t2 = t1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine t1 qe_v qk_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_spine t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x ∃ qe_v ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) $ by lrel_spine_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l4: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t2 = t1 $ by eq_trans [and_elim_l [and_elim_r [l3]], eq_sym [and_elim_l [l3]]]
l5: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t2 = t1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l4, and_elim_r [and_elim_r [l3]]]
l6: $ H ⇒ t2 = t1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ t2 = t1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel $ by ax
l13: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ qe_v = qe_v $ by eq_refl
l14: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ qk_v = qk_v $ by eq_refl
l15: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ ra_spine t1 qe_v qk_v ∈ lrel $ by wcel_eq_l [ra_spine_eq [eq_sym [and_elim_l [l12]], l13, l14], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l16: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine t1 qe_v qk_v ∈ lrel $ by and_intro [and_elim_l [and_elim_r [l12]], and_intro [and_elim_l [and_elim_r [and_elim_r [l12]]], l15]]
l17: $ H ⇒ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine t1 qe_v qk_v ∈ lrel → Cf $ by imp_intro [#3]
l18: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine t1 qe_v qk_v ∈ lrel → Cf $ by weaken [l17]
l19: $ G , H , t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel ⇒ Cf $ by imp_elim [l18, l16]
l20: $ G , H , ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) ⇒ ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) $ by ax
l21: $ … ⇒ Cf $ by ex_elim [l20, l19]
l22: $ G , H , ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) ⇒ ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
l24: $ G , H , ∃ qe_v ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) ⇒ ∃ qe_v ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ x ∃ qe_v ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) ⇒ ∃ x ∃ qe_v ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H ⇒ (∃ x ∃ qe_v ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel)) → Cf $ by imp_intro [l27]
l29: $ G , H ⇒ (∃ x (t1 = x ∧ t2 = x ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x ∃ qe_v ∃ qa_v ∃ qk_v (t1 = x ∧ t2 = ⟨ kc_app , scons qe_v (scons qa_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ ra_spine x qe_v qk_v ∈ lrel)) → Cf $ by or_elim_imp [l11, l28]
l30: $ G , H ⇒ Cf $ by imp_elim [l29, l2]

indapp_not_pi
-------------
l1: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ⇒ x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ⇒ t1 = t1 $ by eq_refl
l3: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ⇒ t2 = t2 $ by eq_refl
l4: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ⇒ t3 = t3 $ by eq_refl
l5: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ⇒ t4 = t4 $ by eq_refl
l6: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ⇒ t6 = t6 $ by eq_refl
l7: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ⇒ ra_indapp t1 t2 t3 t4 x1 t6 ∈ lrel $ by wcel_eq_l [ra_indapp_eq [l2, l3, l4, l5, eq_sym [l1], l6], weaken [#1]]
l8: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel ⇒ ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel $ by ax
l9: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ ⇒ x2 = ⟨ kc_bvar , scons t ∅ ⟩ $ by ax
l10: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ ⇒ x1 = x1 $ by eq_refl
l11: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ ⇒ n = n $ by eq_refl
l12: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ ⇒ ra_spine x2 x1 n ∈ lrel $ by wcel_eq_l [ra_spine_eq [eq_sym [l9], l10, l11], weaken [and_elim_l [l8]]]
l13: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ $ by ax
l14: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_pi , scons a (scons b ∅) ⟩ = ⟨ kc_bvar , scons t ∅ ⟩ $ by eq_trans [eq_sym [weaken [l1]], eq_trans [and_elim_l [l13], weaken [l9]]]
l15: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ kc_pi ∈ ω $ by kc_pi_omega
l16: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l17: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ kc_pi = kc_bvar $ by opair_inj_l_c [l14, wcel_isset [l15], wcel_isset [l16]]
l18: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_bvar = kc_pi $ by kc_bvar_ne_pi
l19: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_pi = kc_bvar $ by ne_sym [l18]
l20: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = x2 ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ⊥ $ by bot_elim [not_elim [l19, l17]]
l21: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel ⇒ x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel $ by ax
l22: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel ⇒ ⟨ kc_pi , scons a (scons b ∅) ⟩ = ⟨ kc_app , scons e (scons f ∅) ⟩ $ by eq_trans [eq_sym [weaken [l1]], and_elim_l [l21]]
l23: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l24: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l25: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel ⇒ kc_pi = kc_app $ by opair_inj_l_c [l22, wcel_isset [l23], wcel_isset [l24]]
l26: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel ⇒ ¬ kc_app = kc_pi $ by kc_app_ne_pi
l27: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel ⇒ ¬ kc_pi = kc_app $ by ne_sym [l26]
l28: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ , x1 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ n = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine x2 e k ∈ lrel ⇒ ⊥ $ by bot_elim [not_elim [l27, l25]]
l29: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel , x2 = ⟨ kc_bvar , scons t ∅ ⟩ ⇒ ⊥ $ by f21_inv_spine [l12, l20, l28]
l30: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel ⇒ isset ⟨ kc_bvar , scons t ∅ ⟩ $ by opair_isset
l31: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ , ra_spine ⟨ kc_bvar , scons t ∅ ⟩ x1 n ∈ lrel ∧ ra_add t4 t3 i ∈ lrel ∧ ra_add i t6 t ∈ lrel ∧ ra_le ⟨ kc_s , scons t6 ∅ ⟩ t2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t ∅ ⟩ t4 t3 x ∈ lrel ∧ ra_nidx t1 t6 m ∈ lrel ∧ ra_iargs i m x x1 ∈ lrel ⇒ ⊥ $ by isset_elim [l30, l29]
l32: $ G , x1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ⇒ ⊥ $ by f21_inv_indapp [l7, l31]
l33: $ G ⇒ isset ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by opair_isset
l34: $ G ⇒ ⊥ $ by isset_elim [l33, l32]

--| @freshen H qi_v
--| @freshen H ql_v
--| @freshen H qf_v
--| @freshen H qa_v
--| @freshen H qA
--| @freshen H qb_v
--| @freshen H qS
--| @freshen H qn_v
--| @freshen H qD
--| @freshen H qc_v
--| @freshen H qv_v
--| @freshen H qe_v
lemma f21_inv_closed {qi_v ql_v qf_v qa_v qA qb_v qS qn_v qD qc_v qv_v qe_v: set} (G H: hyps) (Cf: fml) (t1 t2: set): $ G ⇒ ra_closed t1 t2 ∈ lrel $ > $ H , t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ t1 ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_srt , scons ql_v ∅ ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ ra_closed t1 qf_v ∈ lrel ∧ ra_closed t1 qa_v ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ ra_closed t1 qA ∈ lrel ∧ ra_closed ⟨ kc_s , scons t1 ∅ ⟩ qb_v ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ ra_closed t1 qA ∈ lrel ∧ ra_closed ⟨ kc_s , scons t1 ∅ ⟩ qb_v ∈ lrel ⇒ Cf $ > $ H , t2 = ⟨ kc_cst , scons qa_v (scons qS ∅) ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_lit , scons qn_v ∅ ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_ind_ty , scons qD (scons qi_v ∅) ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_ind_ctor , scons qD (scons qi_v (scons qc_v ∅)) ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_ind_rec , scons qD (scons qi_v (scons qv_v ∅)) ⟩ ⇒ Cf $ > $ H , t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ ra_closed t1 qe_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_closed t1 t2 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ qi_v ∃ x (t1 = x ∧ t2 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ x ∈ lrel) ∨ ∃ x ∃ ql_v (t1 = x ∧ t2 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ qf_v ∃ qa_v (t1 = x ∧ t2 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ ra_closed x qf_v ∈ lrel ∧ ra_closed x qa_v ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v (t1 = x ∧ t2 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ ra_closed x qA ∈ lrel ∧ ra_closed ⟨ kc_s , scons x ∅ ⟩ qb_v ∈ lrel) ∨ ∃ x ∃ qA ∃ qb_v (t1 = x ∧ t2 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ ra_closed x qA ∈ lrel ∧ ra_closed ⟨ kc_s , scons x ∅ ⟩ qb_v ∈ lrel) ∨ ∃ x ∃ qa_v ∃ qS (t1 = x ∧ t2 = ⟨ kc_cst , scons qa_v (scons qS ∅) ⟩) ∨ ∃ x ∃ qn_v (t1 = x ∧ t2 = ⟨ kc_lit , scons qn_v ∅ ⟩) ∨ ∃ x ∃ qD ∃ qi_v (t1 = x ∧ t2 = ⟨ kc_ind_ty , scons qD (scons qi_v ∅) ⟩) ∨ ∃ x ∃ qD ∃ qi_v ∃ qc_v (t1 = x ∧ t2 = ⟨ kc_ind_ctor , scons qD (scons qi_v (scons qc_v ∅)) ⟩) ∨ ∃ x ∃ qD ∃ qi_v ∃ qv_v (t1 = x ∧ t2 = ⟨ kc_ind_rec , scons qD (scons qi_v (scons qv_v ∅)) ⟩) ∨ ∃ x ∃ qb_v ∃ qi_v ∃ qe_v (t1 = x ∧ t2 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ ra_closed x qe_v ∈ lrel) $ by lrel_closed_cases [l1]
