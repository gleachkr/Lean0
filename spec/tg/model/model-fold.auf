l19: $ G ⇒ ∀ z (z ∊ h → ∃ b ∃ v (b ∊ A ∧ z = ⟨ b , v ⟩)) $ by all_intro [imp_intro [l18]]
l20: $ G , a ∊ A , d = scons a ∅ ⇒ d = scons a ∅ $ by ax
l21: $ G , a ∊ A , d = scons a ∅ ⇒ a ∊ A $ by ax
l22: $ G , a ∊ A , d = scons a ∅ ⇒ ∃ b (b ∊ A ∧ d = scons b ∅) $ by ex_intro [and_intro [l21, l20]]
l23: $ G , a ∊ A , d = scons a ∅ ⇒ d ∊ {x | ∃ b (b ∊ A ∧ x = scons b ∅)} $ by cab_intro [l22]
l24: $ G , a ∊ A , d = scons a ∅ ⇒ h ∊ fpi s {x | ∃ b (b ∊ A ∧ x = scons b ∅)} (ap T s) $ by weaken [#1]
l25: $ G , a ∊ A , d = scons a ∅ ⇒ apn h d ∈ ap T d $ by fpi_ap [l24, l23]
l26: $ G , a ∊ A , d = scons a ∅ ⇒ isset a $ by isset_var
l27: $ G , a ∊ A , d = scons a ∅ ⇒ apn h (scons a ∅) = ap h a $ by apn_one [l26]
l28: $ G , a ∊ A , d = scons a ∅ ⇒ h = h $ by eq_refl
l29: $ G , a ∊ A , d = scons a ∅ ⇒ apn h d = ap h a $ by eq_trans [apn_eq [l28, l20], l27]
l30: $ G , a ∊ A , d = scons a ∅ ⇒ T = T $ by eq_refl
l31: $ G , a ∊ A , d = scons a ∅ ⇒ ap h a ∈ ap T (scons a ∅) $ by wcel_eq_l [l29, wcel_eq_r [ap_eq [l30, l20], l25]]
l32: $ G , a ∊ A ⇒ isset ∅ $ by ax_empty
l33: $ G , a ∊ A ⇒ isset (scons a ∅) $ by scons_set [l32]
l34: $ G , a ∊ A ⇒ ap h a ∈ ap T (scons a ∅) $ by isset_elim [l33, l31]
l35: $ G ⇒ ∀ a (a ∊ A → ap h a ∈ ap T (scons a ∅)) $ by all_intro [imp_intro [l34]]
l36: $ G ⇒ h ∊ cpi a A (ap T (scons a ∅)) $ by cpi_intro_pts [l19, l35]

ssnoc_scons
-----------
l1: $ G ⇒ ∅ ∈ fseq A $ by fseq_empty
l2: $ G ⇒ scons a ∅ ∈ fseq A $ by scons_fseq_c [welc_wcel [#3], l1]
l3: $ G ⇒ isset x $ by isset_var
l4: $ G ⇒ scons x f ++ (scons a ∅) = scons x (f ++ (scons a ∅)) $ by scat_scons_c [l3, welc_wcel [#1], l2]
l5: $ G ⇒ ssnoc f a = f ++ (scons a ∅) $ by ssnoc_scat [#1]
l6: $ G , d = scons x f ⇒ d = scons x f $ by ax
l7: $ G , d = scons x f ⇒ x ∊ A $ by weaken [#2]
l8: $ G , d = scons x f ⇒ f ∊ fseq A $ by weaken [#1]
