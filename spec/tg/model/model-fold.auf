lemma f15_mi_cons {a b x l i d c y: set} (G: hyps) (M: class) (u w td tnp tv tn p rr tj tj2 tk tk2 tm tmr tg tnl tmj tf tf2 tz c0 r: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' tnp $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ tv ∊ trees ω $ > $ G ⇒ ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) $ > $ G ⇒ ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) $ > $ G ⇒ ra_lift tj tz tf tf2 ∈ lrel $ > $ G ⇒ ra_mty td tnp tj tz tv tf2 tmj ∈ lrel $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ ra_capp tmr tg tm ∈ lrel $ > $ G ⇒ tg = ⟨ kc_cons , scons tmj (scons tnl ∅) ⟩ $ > $ G ⇒ tnl = ⟨ kc_nil , ∅ ⟩ $ > $ G ⇒ tm ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ tj ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ tk = ⟨ kc_s , scons tk2 ∅ ⟩ $ > $ G ⇒ tk2 ∊ trees ω $ > $ G ⇒ nadd (nvf' tj) (nvf' tk) = nvf' tn $ > $ G ⇒ ityf td (nvf' tj) tf $ > $ G ⇒ ra_closed tnp tf ∈ lrel $ > $ G ⇒ c0 ∊ fseq u $ > $ G ⇒ cdm c0 = nvf' tj $ > $ G ⇒ r = c0 ++ p ++ rr $ > $ G ⇒ tj2 = ⟨ kc_s , scons tj ∅ ⟩ $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ ∀ d ∀ c ∀ y (d ∊ u → c = scons d c0 → y = scons d r → esat u (dsh u M y) tmr w = {l | l ∊ fseq u ∧ cdm l = nvf' tk2 ∧ ∀ i (i ∊ nvf' tn → nvf' tj2 ⊆ i → vat (l ++ c) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))}) $ > $ G ⇒ esat u (dsh u M r) tm w = {l | l ∊ fseq u ∧ cdm l = nvf' tk ∧ ∀ i (i ∊ nvf' tn → nvf' tj ⊆ i → vat (l ++ c0) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))} $
----
