def f39_q (H J MV: class) (u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs: set) (.x0 .d .a .v .k .r .l .f .g .c .t .h .x .n .z .j .b .e .m .y: set): class = $ {x0 | ∀ d ∀ a ∀ v ∀ k ∀ r ∀ l ∀ f ∀ g ∀ c ∀ t ∀ h ∀ x ∀ n (iwf u H J tg td w r0 → ra_ind_data td tb tp tt ∈ lrel → ra_ntys tt tn tm ∈ lrel → ra_clen tp tnp ∈ lrel → p ∊ esat u (dnf u (mcv H)) tp w → cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) → mv ∊ imins u (dnf u (mcv H)) td w p cv → ra_elim_ok tg td tv ∈ lrel3 J → tK0 ∊ trees ω → ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) → ∀ j ∀ b ∀ e ∀ z (ra_nth_ty tt j b e ∈ lrel → nvf' j ∈ nvf' tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (nvf' j) (lv tv w) w) → ss ∊ fseq u → cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) → c0 = mv ++ cv → xs ∊ fseq u → cdm xs = nvf' tn → ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → nvf' b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = xs' j) → ra_rwalk td tnp tn tm tv tnf d a x0 v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → ra_closed x x0 ∈ lrel → nvf' x = nadd (nadd (nvf' d) (nvf' tnp)) (nvf' tn) → ra_npis x0 n ∈ lrel → nadd (nvf' n) (nvf' d) = nvf' tnf → ∀ b ∀ e ∀ m (ra_nth_pi x0 b e ∈ lrel → ra_add d b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) → k ∊ fseq u → cdm k = nvf' d → t ∊ fseq u → cdm t = nvf' d → h ∊ fseq {y | y = y} → cdm h = nvf' d → r = k ++ c0 ++ p ++ ss → l = k ++ p ++ xs → ⟨ f , ⟨ g , ⟨ c , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) x0 w l → pg = t ++ g → pt = h ++ c → ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' d) → dt u (mcv H) a w (f ++ r) = apn MV (z ++ f ++ k)) → ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) v w r) f = apn MV (z ++ f ++ k)))} $

--| @freshen G z
--| @freshen G j
--| @freshen G b
--| @freshen G e
--| @freshen G m
--| @freshen G y
lemma f39_e {z j b e m y: set} (G: hyps) (H J MV: class) (u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs: set) (ty vd va vv vk vr vl vf vg vc vt vh vx vn: set): $ G ⇒ ty ∊ f39_q H J MV u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs $ > $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ > $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ > $ G ⇒ tK0 ∊ trees ω $ > $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) $ > $ G ⇒ ∀ j ∀ b ∀ e ∀ z (ra_nth_ty tt j b e ∈ lrel → nvf' j ∈ nvf' tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (nvf' j) (lv tv w) w) $ > $ G ⇒ ss ∊ fseq u $ > $ G ⇒ cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ c0 = mv ++ cv $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → nvf' b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = xs' j) $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ > $ G ⇒ vv ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ trees ω $ > $ G ⇒ ra_closed vx ty ∈ lrel $ > $ G ⇒ nvf' vx = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vd) = nvf' tnf $ > $ G ⇒ ∀ b ∀ e ∀ m (ra_nth_pi ty b e ∈ lrel → ra_add vd b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) $ > $ G ⇒ vk ∊ fseq u $ > $ G ⇒ cdm vk = nvf' vd $ > $ G ⇒ vt ∊ fseq u $ > $ G ⇒ cdm vt = nvf' vd $ > $ G ⇒ vh ∊ fseq {y | y = y} $ > $ G ⇒ cdm vh = nvf' vd $ > $ G ⇒ vr = vk ++ c0 ++ p ++ ss $ > $ G ⇒ vl = vk ++ p ++ xs $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vc , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vl $ > $ G ⇒ pg = vt ++ vg $ > $ G ⇒ pt = vh ++ vc $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) → dt u (mcv H) va w (vf ++ vr) = apn MV (z ++ vf ++ vk)) $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $
----
l1: $ G ⇒ ∀ d ∀ a ∀ v ∀ k ∀ r ∀ l ∀ f ∀ g ∀ c ∀ t ∀ h ∀ x ∀ n (iwf u H J tg td w r0 → ra_ind_data td tb tp tt ∈ lrel → ra_ntys tt tn tm ∈ lrel → ra_clen tp tnp ∈ lrel → p ∊ esat u (dnf u (mcv H)) tp w → cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) → mv ∊ imins u (dnf u (mcv H)) td w p cv → ra_elim_ok tg td tv ∈ lrel3 J → tK0 ∊ trees ω → ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) → ∀ j ∀ b ∀ e ∀ z (ra_nth_ty tt j b e ∈ lrel → nvf' j ∈ nvf' tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (nvf' j) (lv tv w) w) → ss ∊ fseq u → cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) → c0 = mv ++ cv → xs ∊ fseq u → cdm xs = nvf' tn → ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → nvf' b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = xs' j) → ra_rwalk td tnp tn tm tv tnf d a ty v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → ra_closed x ty ∈ lrel → nvf' x = nadd (nadd (nvf' d) (nvf' tnp)) (nvf' tn) → ra_npis ty n ∈ lrel → nadd (nvf' n) (nvf' d) = nvf' tnf → ∀ b ∀ e ∀ m (ra_nth_pi ty b e ∈ lrel → ra_add d b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) → k ∊ fseq u → cdm k = nvf' d → t ∊ fseq u → cdm t = nvf' d → h ∊ fseq {y | y = y} → cdm h = nvf' d → r = k ++ c0 ++ p ++ ss → l = k ++ p ++ xs → ⟨ f , ⟨ g , ⟨ c , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w l → pg = t ++ g → pt = h ++ c → ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' d) → dt u (mcv H) a w (f ++ r) = apn MV (z ++ f ++ k)) → ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) v w r) f = apn MV (z ++ f ++ k))) $ by cab_elim [#1]
l2: $ G ⇒ ∀ a ∀ v ∀ k ∀ r ∀ l ∀ f ∀ g ∀ c ∀ t ∀ h ∀ x ∀ n (iwf u H J tg td w r0 → ra_ind_data td tb tp tt ∈ lrel → ra_ntys tt tn tm ∈ lrel → ra_clen tp tnp ∈ lrel → p ∊ esat u (dnf u (mcv H)) tp w → cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) → mv ∊ imins u (dnf u (mcv H)) td w p cv → ra_elim_ok tg td tv ∈ lrel3 J → tK0 ∊ trees ω → ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) → ∀ j ∀ b ∀ e ∀ z (ra_nth_ty tt j b e ∈ lrel → nvf' j ∈ nvf' tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (nvf' j) (lv tv w) w) → ss ∊ fseq u → cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) → c0 = mv ++ cv → xs ∊ fseq u → cdm xs = nvf' tn → ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → nvf' b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = xs' j) → ra_rwalk td tnp tn tm tv tnf vd a ty v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → vd ∊ trees ω → ra_closed x ty ∈ lrel → nvf' x = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) → ra_npis ty n ∈ lrel → nadd (nvf' n) (nvf' vd) = nvf' tnf → ∀ b ∀ e ∀ m (ra_nth_pi ty b e ∈ lrel → ra_add vd b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) → k ∊ fseq u → cdm k = nvf' vd → t ∊ fseq u → cdm t = nvf' vd → h ∊ fseq {y | y = y} → cdm h = nvf' vd → r = k ++ c0 ++ p ++ ss → l = k ++ p ++ xs → ⟨ f , ⟨ g , ⟨ c , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w l → pg = t ++ g → pt = h ++ c → ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) → dt u (mcv H) a w (f ++ r) = apn MV (z ++ f ++ k)) → ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) v w r) f = apn MV (z ++ f ++ k))) $ by all_elim [l1]
