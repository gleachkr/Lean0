l66: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_proj , scons b (scons x (scons i ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b (scons x (scons j ∅)) ⟩ ∧ ra_inst tk i tc j ∈ lrel ⇒ x1 = ⟨ kc_proj , scons b (scons x (scons i ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b (scons x (scons j ∅)) ⟩ ∧ ra_inst tk i tc j ∈ lrel $ by ax
