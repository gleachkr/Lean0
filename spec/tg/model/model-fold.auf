l103: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add tb n j ∈ lrel , ty = ⟨ kc_s , scons m ∅ ⟩ ∧ vf = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_add tc m k ∈ lrel ⇒ ra_add ta ve vf ∈ lrel $ by wcel_eq_l [ra_add_eq [l102, eq_sym [l51], eq_sym [l48]], l101]
l104: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ ve = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add tb n j ∈ lrel ⇒ ra_add ta ve vf ∈ lrel $ by f21_inv_add [l31, l45, l103]
l105: $ G ⇒ ra_add ta ve vf ∈ lrel $ by f21_inv_add [#6, l26, l104]

lemma f32_as_all (G: hyps) (ta tb tc: set): $ G ⇒ trees ω ⊆ f32_as_q ta tb tc $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel , ra_add tc y f ∈ lrel ⇒ crn x9 ⊆ f32_as_q ta tb tc $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel , ra_add tc y f ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel , ra_add tc y f ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel , ra_add tc y f ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel , ra_add tc y f ∈ lrel ⇒ ra_add ta tb tc ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel , ra_add tc y f ∈ lrel ⇒ ra_add tb y e ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel , ra_add tc y f ∈ lrel ⇒ ra_add tc y f ∈ lrel $ by ax
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel , ra_add tc y f ∈ lrel ⇒ ra_add ta e f ∈ lrel $ by f32_as_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel , ra_add tb y e ∈ lrel ⇒ ra_add tc y f ∈ lrel → ra_add ta e f ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ , ra_add ta tb tc ∈ lrel ⇒ ra_add tb y e ∈ lrel → ra_add tc y f ∈ lrel → ra_add ta e f ∈ lrel $ by imp_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ ⇒ ra_add ta tb tc ∈ lrel → ra_add tb y e ∈ lrel → ra_add tc y f ∈ lrel → ra_add ta e f ∈ lrel $ by imp_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ ⇒ ∀ f (ra_add ta tb tc ∈ lrel → ra_add tb y e ∈ lrel → ra_add tc y f ∈ lrel → ra_add ta e f ∈ lrel) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ ⇒ ∀ e ∀ f (ra_add ta tb tc ∈ lrel → ra_add tb y e ∈ lrel → ra_add tc y f ∈ lrel → ra_add ta e f ∈ lrel) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f32_as_q ta tb tc $ by cab_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f32_as_q ta tb tc $ by wcel_intro [l15, l14]
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f32_as_q ta tb tc ⇒ ⟨ x8 , x9 ⟩ ∈ f32_as_q ta tb tc $ by isset_elim [l17, l16]
l19: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f32_as_q ta tb tc → ⟨ x8 , x9 ⟩ ∈ f32_as_q ta tb tc $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f32_as_q ta tb tc → ⟨ x8 , x9 ⟩ ∈ f32_as_q ta tb tc) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ f32_as_q ta tb tc $ by trees_ind_c [l21, l20]

add_assoc
---------
l1: $ G ⇒ ⟨ kr_add , scons tb (scons td (scons te ∅)) ⟩ ∈ latoms $ by lrel_latoms [#2]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons te ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons td (scons te ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tb (scons td (scons te ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
l7: $ G ⇒ kr_add ∈ ω ∧ scons tb (scons td (scons te ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons tb (scons td (scons te ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ crn (scons td (scons te ∅)) ⊆ trees ω $ by crn_scons_tail [l8]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ td ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ trees ω ⊆ f32_as_q ta tb tc $ by f32_as_all
l13: $ G ⇒ td ∊ f32_as_q ta tb tc $ by subset_elim [l12, wcel_welc [l11]]
l14: $ G ⇒ ra_add ta te tf ∈ lrel $ by f32_as_e [l13, #1, #2, #3]

--| @freshen H qb_v
--| @freshen H qP
--| @freshen H qT
--| @freshen H qF
--| @freshen H qC
--| @freshen H ql_v
lemma f21_inv_nidx {qb_v qP qT qF qC ql_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_nidx t1 t2 t3 ∈ lrel $ > $ H , ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF qC ∈ lrel ∧ ra_isort qF t3 ql_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_nidx t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by lrel_nidx_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ qb_v = qb_v $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ qP = qP $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ qT = qT $ by eq_refl
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel $ by wcel_eq_l [ra_ind_data_eq [eq_sym [and_elim_l [l3]], l4, l5, l6], and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]]]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ qF = qF $ by eq_refl
l9: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ qC = qC $ by eq_refl
l10: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ ra_nth_ty qT t2 qF qC ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [l6, eq_sym [and_elim_l [and_elim_r [l3]]], l8, l9], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]
l11: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ ql_v = ql_v $ by eq_refl
l12: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ ra_isort qF t3 ql_v ∈ lrel $ by wcel_eq_l [ra_isort_eq [l8, eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]], l11], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]
l13: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF qC ∈ lrel ∧ ra_isort qF t3 ql_v ∈ lrel $ by and_intro [l7, and_intro [l10, l12]]
l14: $ H ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF qC ∈ lrel ∧ ra_isort qF t3 ql_v ∈ lrel → Cf $ by imp_intro [#2]
l15: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF qC ∈ lrel ∧ ra_isort qF t3 ql_v ∈ lrel → Cf $ by weaken [l14]
l16: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel ⇒ Cf $ by imp_elim [l15, l13]
l17: $ G , H , ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l18: $ … ⇒ Cf $ by ex_elim [l17, l16]
l19: $ G , H , ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l20: $ … ⇒ Cf $ by ex_elim [l19, l18]
l21: $ G , H , ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l22: $ … ⇒ Cf $ by ex_elim [l21, l20]
l23: $ G , H , ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l24: $ … ⇒ Cf $ by ex_elim [l23, l22]
l25: $ G , H , ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l26: $ … ⇒ Cf $ by ex_elim [l25, l24]
l27: $ G , H , ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l28: $ … ⇒ Cf $ by ex_elim [l27, l26]
l29: $ G , H , ∃ qP ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ qP ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l30: $ … ⇒ Cf $ by ex_elim [l29, l28]
l31: $ G , H , ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l32: $ … ⇒ Cf $ by ex_elim [l31, l30]
l33: $ G , H , ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel) $ by ax
l34: $ … ⇒ Cf $ by ex_elim [l33, l32]
l35: $ G , H ⇒ (∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ qF ∃ qC ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = z ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_isort qF z ql_v ∈ lrel)) → Cf $ by imp_intro [l34]
l36: $ G , H ⇒ Cf $ by imp_elim [l35, l2]

lemma f32_sig_ind_ty (G: hyps): $ G ⇒ ⟨ kc_ind_ty , ⟨ ks_expr , scons ks_ind (scons ks_nat ∅) ⟩ ⟩ ∈ lsig $
----
