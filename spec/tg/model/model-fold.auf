cres_scat_l
-----------
l1: $ G ⇒ s ++ t ∈ fseq A $ by scat_fseq_c [welc_wcel [#1], welc_wcel [#2]]
l2: $ G , q = s ++ t ⇒ q = s ++ t $ by ax
l3: $ G , q = s ++ t ⇒ s ++ t ∈ fseq A $ by weaken [l1]
l4: $ G , q = s ++ t ⇒ q ∊ fseq A $ by wcel_welc [wcel_eq_l [eq_sym [l2], l3]]
l5: $ G , q = s ++ t ⇒ functional q $ by fseq_functional [l4]
l6: $ G , q = s ++ t , x ∊ s ⇒ s ⊆ s ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm s) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ t)} $ by cun_subset_l
l7: $ G , q = s ++ t , x ∊ s ⇒ s ⊆ s ++ t $ by weaken [l6]
l8: $ G , q = s ++ t , x ∊ s ⇒ q = s ++ t $ by ax
l9: $ G , q = s ++ t , x ∊ s ⇒ x ∊ s $ by ax
l10: $ G , q = s ++ t , x ∊ s ⇒ x ∊ q $ by welc_eq [eq_sym [l8], subset_elim [l7, l9]]
l11: $ G , q = s ++ t ⇒ s ⊆ q $ by subset_intro [l10]
l12: $ G , q = s ++ t ⇒ cdm s ⊆ cdm s $ by subset_refl
l13: $ G , q = s ++ t ⇒ q ↾ cdm s = s ↾ cdm s $ by cres_subfun [l5, l11, l12]
l14: $ G , q = s ++ t ⇒ s ∊ fseq A $ by weaken [#1]
l15: $ G , q = s ++ t ⇒ s ↾ cdm s = s $ by cres_subset_cdm [fseq_rel [l14], l12]
l16: $ G , q = s ++ t ⇒ cdm s = cdm s $ by eq_refl
l17: $ G , q = s ++ t ⇒ (s ++ t) ↾ cdm s = s $ by eq_trans [cres_eq [eq_sym [l2], l16], eq_trans [l13, l15]]
l18: $ G ⇒ (s ++ t) ↾ cdm s = s $ by isset_elim [wcel_isset [l1], l17]

inidx_val
---------
l1: $ G , x ∊ inidx td (nvf' ti) ⇒ x ∊ inidx td (nvf' ti) $ by ax
l2: $ G , x ∊ inidx td (nvf' ti) ⇒ x ∊ {y | ∃ i ∃ k (nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ y ∊ nvf' k)} $ by weaken [l1]
l3: $ G , x ∊ inidx td (nvf' ti) ⇒ ∃ i ∃ k (nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k) $ by cab_elim [l2]
l4: $ G , x ∊ inidx td (nvf' ti) , nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k ⇒ nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k $ by ax
l5: $ G , x ∊ inidx td (nvf' ti) , nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k ⇒ ra_nidx td ti tm ∈ lrel $ by weaken [#1]
l6: $ G , x ∊ inidx td (nvf' ti) , nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k ⇒ k = tm $ by nidx_nvf [and_elim_l [and_elim_r [l4]], l5, and_elim_l [l4]]
l7: $ G , x ∊ inidx td (nvf' ti) , nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k ⇒ nvf = nvf $ by eq_refl
l8: $ G , x ∊ inidx td (nvf' ti) , nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k ⇒ x ∊ nvf' tm $ by welc_eq [fv_eq [l7, l6], and_elim_r [and_elim_r [l4]]]
l9: $ G , x ∊ inidx td (nvf' ti) , ∃ k (nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k) ⇒ ∃ k (nvf' i = nvf' ti ∧ ra_nidx td i k ∈ lrel ∧ x ∊ nvf' k) $ by ax
l10: $ … ⇒ x ∊ nvf' tm $ by ex_elim [l9, l8]
l11: $ G , x ∊ inidx td (nvf' ti) ⇒ x ∊ nvf' tm $ by ex_elim [l3, l10]
l12: $ G , x ∊ nvf' tm ⇒ nvf' ti = nvf' ti $ by eq_refl
l13: $ G , x ∊ nvf' tm ⇒ ra_nidx td ti tm ∈ lrel $ by weaken [#1]
l14: $ G , x ∊ nvf' tm ⇒ x ∊ nvf' tm $ by ax
l15: $ G , x ∊ nvf' tm ⇒ nvf' ti = nvf' ti ∧ ra_nidx td ti tm ∈ lrel ∧ x ∊ nvf' tm $ by and_intro [l12, and_intro [l13, l14]]
l16: $ G , x ∊ nvf' tm ⇒ ∃ k (nvf' ti = nvf' ti ∧ ra_nidx td ti k ∈ lrel ∧ x ∊ nvf' k) $ by ex_intro [l15]
