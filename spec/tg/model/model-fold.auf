l9: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_tys_wf td tn tnp tl x1 tc tt ∈ lrel3 J $ by wcel_eq_l [ra_tys_wf_eq [l3, l4, l5, l6, eq_sym [l1], l7, l8], weaken [#1]]
