--| @freshen G p
--| @freshen G z
lemma f25_s3 {p z: set} (G: hyps) (E J V Q: class) (u w td tb tp tt tnp tF d s1 s2: set): $ G ⇒ uadm u $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ityf td J tF $ > $ G ⇒ tF ∊ trees ω $ > $ G ⇒ ity u E td J w ∈ u $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ s1 ∊ esat u E tp w $ > $ G ⇒ s2 ∊ imots u E td w s1 V $ > $ G ⇒ Q = imins u E td w s1 s2 $ > $ G ⇒ d ∊ apn (apn (irc u E td J V w) s1) s2 $ > $ G ⇒ ∃ p ∃ z (p ∊ Q ∧ d = nest p z) $
----
