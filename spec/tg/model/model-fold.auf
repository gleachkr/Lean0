l31: $ G , ∃ a ∃ b ∃ c (t1 = a ∧ t2 = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons a ∅ ⟩ c ∈ lrel) ⇒ ∃ a ∃ b ∃ c (t1 = a ∧ t2 = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons a ∅ ⟩ c ∈ lrel) $ by ax
l32: $ … ⇒ ∃ z (z = ⟨ kc_bvar , scons t1 ∅ ⟩ ∧ ra_has_arg t2 z ∈ lrel) $ by ex_elim [l31, l30]
l33: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel , z = ⟨ kc_bvar , scons t1 ∅ ⟩ ⇒ t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel $ by ax
l34: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel , z = ⟨ kc_bvar , scons t1 ∅ ⟩ ⇒ z = ⟨ kc_bvar , scons t1 ∅ ⟩ $ by ax
l35: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel , z = ⟨ kc_bvar , scons t1 ∅ ⟩ ⇒ kc_bvar = kc_bvar $ by eq_refl
l36: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel , z = ⟨ kc_bvar , scons t1 ∅ ⟩ ⇒ ∅ = ∅ $ by eq_refl
l37: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel , z = ⟨ kc_bvar , scons t1 ∅ ⟩ ⇒ ⟨ kc_bvar , scons t1 ∅ ⟩ = ⟨ kc_bvar , scons a ∅ ⟩ $ by opair_eq [l35, scons_eq [and_elim_l [l33], l36]]
l38: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel , z = ⟨ kc_bvar , scons t1 ∅ ⟩ ⇒ ra_has_arg t2 z ∈ lrel $ by wcel_eq_l [ra_has_arg_eq [eq_sym [and_elim_l [and_elim_r [l33]]], eq_trans [eq_sym [l37], eq_sym [l34]]], and_elim_r [and_elim_r [l33]]]
l39: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel , z = ⟨ kc_bvar , scons t1 ∅ ⟩ ⇒ ∃ z (z = ⟨ kc_bvar , scons t1 ∅ ⟩ ∧ ra_has_arg t2 z ∈ lrel) $ by ex_intro [and_intro [l34, l38]]
l40: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel ⇒ isset ⟨ kc_bvar , scons t1 ∅ ⟩ $ by opair_isset
l41: $ G , t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel ⇒ ∃ z (z = ⟨ kc_bvar , scons t1 ∅ ⟩ ∧ ra_has_arg t2 z ∈ lrel) $ by isset_elim [l40, l39]
l42: $ G , ∃ d (t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel) ⇒ ∃ d (t1 = a ∧ t2 = d ∧ ra_has_arg d ⟨ kc_bvar , scons a ∅ ⟩ ∈ lrel) $ by ax
l43: $ … ⇒ ∃ z (z = ⟨ kc_bvar , scons t1 ∅ ⟩ ∧ ra_has_arg t2 z ∈ lrel) $ by ex_elim [l42, l41]
