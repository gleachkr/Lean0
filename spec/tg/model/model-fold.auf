l178: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , k = nadd (nvf' te) (nvf' ti) , d = nvf' ti , td = x0 ∧ ti = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , n = apn v q1 , ⟨ nvf' ti , ⟨ q4 , x ⟩ ⟩ ∈ zc ∧ n = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ x} ⇒ apn (g' nvf' th) q1 = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ x} $ by eq_trans [apn_eq [eq_sym [l176], l177], eq_trans [eq_sym [l175], and_elim_r [l173]]]
