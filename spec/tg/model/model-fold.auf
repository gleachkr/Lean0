l46: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_ntys t k x1 ∈ lrel ∧ ra_clen_c c x2 ∈ lrel ∧ ra_add x1 x2 vm ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_s , scons k ∅ ⟩ ∈ lrel $ by lrel_add_s [l45, l41, l41, l30]
l47: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_ntys t k x1 ∈ lrel ∧ ra_clen_c c x2 ∈ lrel ∧ ra_add x1 x2 vm ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l48: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_ntys t k x1 ∈ lrel ∧ ra_clen_c c x2 ∈ lrel ∧ ra_add x1 x2 vm ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by wcel_eq_l [ra_add_eq [l47, eq_sym [l14], eq_sym [l14]], l46]
l49: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by f21_inv_ntys [#5, l11, l48]

lemma f49_nn_all (G: hyps) : $ G ⇒ trees ω ⊆ f49_nn_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ , ra_ntys y n m ∈ lrel ⇒ crn x9 ⊆ f49_nn_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ , ra_ntys y n m ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ , ra_ntys y n m ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ , ra_ntys y n m ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ , ra_ntys y n m ∈ lrel ⇒ ra_ntys y n m ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ , ra_ntys y n m ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel $ by f49_nn_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_ntys y n m ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ m (ra_ntys y n m ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n ∀ m (ra_ntys y n m ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel) $ by all_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f49_nn_q  $ by cab_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f49_nn_q  $ by wcel_intro [l11, l10]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f49_nn_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f49_nn_q  $ by isset_elim [l13, l12]
l15: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f49_nn_q  → ⟨ x8 , x9 ⟩ ∈ f49_nn_q  $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f49_nn_q  → ⟨ x8 , x9 ⟩ ∈ f49_nn_q ) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f49_nn_q  $ by trees_ind_c [l17, l16]

ntys_num
--------
l1: $ G ⇒ trees ω ⊆ f49_nn_q  $ by f49_nn_all
l2: $ G ⇒ ⟨ kr_ntys , scons tt (scons tn (scons tm ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons tm ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tn (scons tm ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons tt (scons tn (scons tm ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_ntys ∈ ω $ by kr_ntys_omega
l8: $ G ⇒ kr_ntys ∈ ω ∧ scons tt (scons tn (scons tm ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons tt (scons tn (scons tm ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ tt ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ tt ∊ f49_nn_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ tn tn ∈ lrel $ by f49_nn_e [l12, #1]

--| @freshen H qB
--| @freshen H qA2
--| @freshen H qi_v
lemma f21_inv_nth_pi {qB qA2 qi_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_nth_pi t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_pi , scons t3 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ ra_nth_pi qB qi_v t3 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_nth_pi t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qB (t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ∨ ∃ x ∃ qA2 ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) $ by lrel_nth_pi_cases [l1]
l3: $ G , H , t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x $ by ax
l4: $ G , H , t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , H , t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ qB = qB $ by eq_refl
l6: $ G , H , t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ kc_pi = kc_pi $ by eq_refl
l7: $ G , H , t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = ⟨ kc_pi , scons t3 (scons qB ∅) ⟩ $ by eq_trans [and_elim_l [l3], opair_eq [l6, scons_eq [eq_sym [and_elim_r [and_elim_r [l3]]], scons_eq [l5, l4]]]]
l8: $ G , H , t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = ⟨ kc_pi , scons t3 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l7, and_elim_l [and_elim_r [l3]]]
l9: $ H ⇒ t1 = ⟨ kc_pi , scons t3 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l10: $ G , H , t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = ⟨ kc_pi , scons t3 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l9]
l11: $ G , H , t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ Cf $ by imp_elim [l10, l8]
l12: $ G , H , ∃ qB (t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ⇒ ∃ qB (t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ x ∃ qB (t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ⇒ ∃ x ∃ qB (t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H ⇒ (∃ x ∃ qB (t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x)) → Cf $ by imp_intro [l15]
l17: $ G , H , t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel ⇒ t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel $ by ax
l18: $ G , H , t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel ⇒ qB = qB $ by eq_refl
l19: $ G , H , t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel ⇒ qi_v = qi_v $ by eq_refl
l20: $ G , H , t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel ⇒ ra_nth_pi qB qi_v t3 ∈ lrel $ by wcel_eq_l [ra_nth_pi_eq [l18, l19, eq_sym [and_elim_l [and_elim_r [and_elim_r [l17]]]]], and_elim_r [and_elim_r [and_elim_r [l17]]]]
l21: $ G , H , t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel ⇒ t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ ra_nth_pi qB qi_v t3 ∈ lrel $ by and_intro [and_elim_l [l17], and_intro [and_elim_l [and_elim_r [l17]], l20]]
l22: $ H ⇒ t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ ra_nth_pi qB qi_v t3 ∈ lrel → Cf $ by imp_intro [#3]
l23: $ G , H , t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel ⇒ t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ ra_nth_pi qB qi_v t3 ∈ lrel → Cf $ by weaken [l22]
l24: $ G , H , t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel ⇒ Cf $ by imp_elim [l23, l21]
l25: $ G , H , ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) ⇒ ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) $ by ax
l26: $ … ⇒ Cf $ by ex_elim [l25, l24]
l27: $ G , H , ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) ⇒ ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) $ by ax
l28: $ … ⇒ Cf $ by ex_elim [l27, l26]
l29: $ G , H , ∃ qA2 ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) ⇒ ∃ qA2 ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) $ by ax
l30: $ … ⇒ Cf $ by ex_elim [l29, l28]
l31: $ G , H , ∃ x ∃ qA2 ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) ⇒ ∃ x ∃ qA2 ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel) $ by ax
l32: $ … ⇒ Cf $ by ex_elim [l31, l30]
l33: $ G , H ⇒ (∃ x ∃ qA2 ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel)) → Cf $ by imp_intro [l32]
l34: $ G , H ⇒ (∃ x ∃ qB (t1 = ⟨ kc_pi , scons x (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ∨ ∃ x ∃ qA2 ∃ qB ∃ qi_v (t1 = ⟨ kc_pi , scons qA2 (scons qB ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ ra_nth_pi qB qi_v x ∈ lrel)) → Cf $ by or_elim_imp [l16, l33]
l35: $ G , H ⇒ Cf $ by imp_elim [l34, l2]

def f50_fo_q (M: class) (u w tA: set) (.x7 .n .r .f .g .t .a .o .i .m: set): class = $ {x7 | ∀ n ∀ r ∀ f ∀ g ∀ t ∀ a (ra_nth_pi x7 n tA ∈ lrel → w ∊ lvals → r ∊ fseq u → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r → ∃ o (o ∊ fseq u ∧ cdm o = nvf' n ∧ g' nvf' n ∈ dt u M tA w (o ++ r) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m)))} $

--| @freshen G o
--| @freshen G i
--| @freshen G m
lemma f50_fo_e {o i m: set} (G: hyps) (M: class) (u w tA: set) (ty vn vr vf vg vt va: set): $ G ⇒ ty ∊ f50_fo_q M u w tA $ > $ G ⇒ ra_nth_pi ty vn tA ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ vr ∊ fseq u $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr $ > $ G ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $
----
l1: $ G ⇒ ∀ n ∀ r ∀ f ∀ g ∀ t ∀ a (ra_nth_pi ty n tA ∈ lrel → w ∊ lvals → r ∊ fseq u → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ o (o ∊ fseq u ∧ cdm o = nvf' n ∧ g' nvf' n ∈ dt u M tA w (o ++ r) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m))) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r ∀ f ∀ g ∀ t ∀ a (ra_nth_pi ty vn tA ∈ lrel → w ∊ lvals → r ∊ fseq u → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ g' nvf' vn ∈ dt u M tA w (o ++ r) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m))) $ by all_elim [l1]
l3: $ G ⇒ ∀ f ∀ g ∀ t ∀ a (ra_nth_pi ty vn tA ∈ lrel → w ∊ lvals → vr ∊ fseq u → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ g' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m))) $ by all_elim [l2]
l4: $ G ⇒ ∀ g ∀ t ∀ a (ra_nth_pi ty vn tA ∈ lrel → w ∊ lvals → vr ∊ fseq u → ⟨ vf , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ g' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → g' i = o' m))) $ by all_elim [l3]
l5: $ G ⇒ ∀ t ∀ a (ra_nth_pi ty vn tA ∈ lrel → w ∊ lvals → vr ∊ fseq u → ⟨ vf , ⟨ vg , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m))) $ by all_elim [l4]
l6: $ G ⇒ ∀ a (ra_nth_pi ty vn tA ∈ lrel → w ∊ lvals → vr ∊ fseq u → ⟨ vf , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m))) $ by all_elim [l5]
l7: $ G ⇒ ra_nth_pi ty vn tA ∈ lrel → w ∊ lvals → vr ∊ fseq u → ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by all_elim [l6]
l8: $ G ⇒ w ∊ lvals → vr ∊ fseq u → ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by imp_elim [l7, #2]
l9: $ G ⇒ vr ∊ fseq u → ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by imp_elim [l8, #3]
l10: $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr → ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by imp_elim [l9, #4]
l11: $ G ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $ by imp_elim [l10, #5]

--| @freshen G o
--| @freshen G i
--| @freshen G m
lemma f50_fo_n {o i m: set} (G: hyps) (M: class) (u w tA: set) (ty k1 j1 vn vr vf vg vt va: set): $ G ⇒ crn j1 ⊆ f50_fo_q M u w tA $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_nth_pi ty vn tA ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ vr ∊ fseq u $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w vr $ > $ G ⇒ ∃ o (o ∊ fseq u ∧ cdm o = nvf' vn ∧ vg' nvf' vn ∈ dt u M tA w (o ++ vr) ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm o → vg' i = o' m)) $
----
l1: $ G , ty = ⟨ kc_pi , scons tA (scons c ∅) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_pi , scons tA (scons c ∅) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ $ by ax
