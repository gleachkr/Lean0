l37: $ G , x ∊ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ s = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} ⇒ x ∊ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q2 ∧ h ∊ ihv D K L (X2 ++ g) (Y2 ++ c) N ∧ s = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F2) ++ P)) (a ↾ I)))} $ by ex_elim [l2, l36]
