--| @freshen G g
lemma f28_sw_n {g: set} (G: hyps) (J M K S: class) (u w c r tA d0 i0: set) (ty k1 j1 vn vq vp vt: set): $ G ⇒ crn j1 ⊆ f28_sw_q J M K S u w c r tA d0 i0 $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ jval u M J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ sat u M c w $ > $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ isset K $ > $ G ⇒ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ ra_sty c ⟨ K , S ⟩ tA ty vt ∈ lrel3 J $ > $ G ⇒ ra_spine ⟨ K , S ⟩ ty vn ∈ lrel $ > $ G ⇒ ra_pis vq vp tA ∈ lrel $ > $ G ⇒ ra_clen vq vn ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ∃ g (ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ vn ty g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g vp vt ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) ty w r ∧ sarg u (dnf u M) ty w r ∈ esat u (dsh u M r) vq w) $
----
l1: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ⇒ x3 = ⟨ K , S ⟩ $ by ax
l2: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ⇒ x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ $ by ax
l3: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ⇒ ty = ty $ by eq_refl
l4: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ⇒ vn = vn $ by eq_refl
l5: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ⇒ ra_spine x3 ty vn ∈ lrel $ by wcel_eq_l [ra_spine_eq [eq_sym [l1], l3, l4], weaken [#15]]
l6: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ $ by ax
l7: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ x3 = ⟨ K , S ⟩ $ by weaken [l1]
l8: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ $ by weaken [l2]
l9: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ sat u M c w ⊆ fseq u $ by sat_fseq
l10: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ r ∊ sat u M c w $ by weaken [#8]
l11: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ r ∊ fseq u $ by subset_elim [l9, l10]
l12: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ sig lsig lopen $ by lsig_sig
l13: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ by weaken [#13]
l14: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ trees ω $ by wcel_subset [ofsort_trees [l12], l13]
l15: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_pi = kc_ind_ty $ by kc_pi_ne_ind_ty
l16: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_ind_ty = kc_pi $ by ne_sym [l15]
l17: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_app = kc_ind_ty $ by kc_app_ne_ind_ty
l18: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_ind_ty = kc_app $ by ne_sym [l17]
l19: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ra_pis vq vp tA ∈ lrel $ by weaken [#16]
l20: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kr_pis , scons vq (scons vp (scons tA ∅)) ⟩ ∈ latoms $ by lrel_latoms [l19]
l21: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l22: $ G , x3 = ⟨ K , S ⟩ , x4 = ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ , ty = x3 ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons tA ∅) $ by scons_set [l21]
