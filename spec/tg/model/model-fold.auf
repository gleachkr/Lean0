l172: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g , c ∊ esat u (dsh u M (g ++ s)) p w , h ∊ da ((dsh u M (g ++ s))' a) w c , q = scons h c , n = c ++ g ⇒ da ((dsh u M s)' a) w n = dt u M a w (n ++ s) $ by dsh_da [welc_wcel [l163], l164, l165]
