l96: $ G , vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ty = ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons vd ∅ ⟩ ∅) ⟩ ∧ ra_pargs tX ⟨ kc_s , scons vd ∅ ⟩ k e ∈ lrel ⇒ vn = ⟨ kc_s , scons k ∅ ⟩ $ by and_elim_l [l17]
l97: $ G , vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ty = ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons vd ∅ ⟩ ∅) ⟩ ∧ ra_pargs tX ⟨ kc_s , scons vd ∅ ⟩ k e ∈ lrel , x2 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ ra_spine tX ty vn ∈ lrel $ by wcel_eq_l [ra_spine_eq [l44, eq_sym [l95], eq_sym [weaken [l96]]], l94]
l98: $ G , vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ty = ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons vd ∅ ⟩ ∅) ⟩ ∧ ra_pargs tX ⟨ kc_s , scons vd ∅ ⟩ k e ∈ lrel ⇒ isset ⟨ kc_s , scons vd ∅ ⟩ $ by opair_isset
l99: $ G , vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ty = ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons vd ∅ ⟩ ∅) ⟩ ∧ ra_pargs tX ⟨ kc_s , scons vd ∅ ⟩ k e ∈ lrel ⇒ ra_spine tX ty vn ∈ lrel $ by isset_elim [l98, l97]
l100: $ G ⇒ ra_spine tX ty vn ∈ lrel $ by f21_inv_pargs [#5, l16, l99]

lemma f29_ps_all (G: hyps) (tX: set): $ G ⇒ trees ω ⊆ f29_ps_q tX $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ , ra_pargs tX d n y ∈ lrel ⇒ crn x9 ⊆ f29_ps_q tX $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ , ra_pargs tX d n y ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ , ra_pargs tX d n y ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ , ra_pargs tX d n y ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ , ra_pargs tX d n y ∈ lrel ⇒ ra_pargs tX d n y ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ , ra_pargs tX d n y ∈ lrel ⇒ ra_spine tX y n ∈ lrel $ by f29_ps_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ ⇒ ra_pargs tX d n y ∈ lrel → ra_spine tX y n ∈ lrel $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n (ra_pargs tX d n y ∈ lrel → ra_spine tX y n ∈ lrel) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ ⇒ ∀ d ∀ n (ra_pargs tX d n y ∈ lrel → ra_spine tX y n ∈ lrel) $ by all_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_ps_q tX $ by cab_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_ps_q tX $ by wcel_intro [l11, l10]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ps_q tX ⇒ ⟨ x8 , x9 ⟩ ∈ f29_ps_q tX $ by isset_elim [l13, l12]
l15: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_ps_q tX → ⟨ x8 , x9 ⟩ ∈ f29_ps_q tX $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_ps_q tX → ⟨ x8 , x9 ⟩ ∈ f29_ps_q tX) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f29_ps_q tX $ by trees_ind_c [l17, l16]

pargs_spine
-----------
l1: $ G ⇒ ⟨ kr_pargs , scons tX (scons td (scons tn (scons te ∅))) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons te ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tn (scons te ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons td (scons tn (scons te ∅))) $ by scons_set [l4]
l6: $ G ⇒ isset (scons tX (scons td (scons tn (scons te ∅)))) $ by scons_set [l5]
l7: $ G ⇒ kr_pargs ∈ ω $ by kr_pargs_omega
l8: $ G ⇒ kr_pargs ∈ ω ∧ scons tX (scons td (scons tn (scons te ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons tX (scons td (scons tn (scons te ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ crn (scons td (scons tn (scons te ∅))) ⊆ trees ω $ by crn_scons_tail [l9]
l11: $ G ⇒ crn (scons tn (scons te ∅)) ⊆ trees ω $ by crn_scons_tail [l10]
l12: $ G ⇒ crn (scons te ∅) ⊆ trees ω $ by crn_scons_tail [l11]
l13: $ G ⇒ isset ω $ by omega_set
l14: $ G ⇒ te ∈ trees ω $ by crn_scons_head_trees [l13, l12]
l15: $ G ⇒ trees ω ⊆ f29_ps_q tX $ by f29_ps_all
l16: $ G ⇒ te ∊ f29_ps_q tX $ by subset_elim [l15, wcel_welc [l14]]
l17: $ G ⇒ ra_spine tX te tn ∈ lrel $ by f29_ps_e [l16, #1]

def f29_st_q (th tx ta: set) (.y .b .c: set): class = $ {y | ∀ b (ra_spine th tx ta ∈ lrel → ra_spine tx y b ∈ lrel → ∃ c (ra_spine th y c ∈ lrel))} $

--| @freshen G c
lemma f29_st_e {c: set} (G: hyps) (th tx ta: set) (ty vb: set): $ G ⇒ ty ∊ f29_st_q th tx ta $ > $ G ⇒ ra_spine th tx ta ∈ lrel $ > $ G ⇒ ra_spine tx ty vb ∈ lrel $ > $ G ⇒ ∃ c (ra_spine th ty c ∈ lrel) $
----
l1: $ G ⇒ ∀ b (ra_spine th tx ta ∈ lrel → ra_spine tx ty b ∈ lrel → ∃ c (ra_spine th ty c ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ra_spine th tx ta ∈ lrel → ra_spine tx ty vb ∈ lrel → ∃ c (ra_spine th ty c ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ra_spine tx ty vb ∈ lrel → ∃ c (ra_spine th ty c ∈ lrel) $ by imp_elim [l2, #2]
l4: $ G ⇒ ∃ c (ra_spine th ty c ∈ lrel) $ by imp_elim [l3, #3]

--| @freshen G c
lemma f29_st_n {c: set} (G: hyps) (th tx ta: set) (ty k1 j1 vb: set): $ G ⇒ crn j1 ⊆ f29_st_q th tx ta $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_spine th tx ta ∈ lrel $ > $ G ⇒ ra_spine tx ty vb ∈ lrel $ > $ G ⇒ ∃ c (ra_spine th ty c ∈ lrel) $
----
l1: $ G , ty = tx ∧ vb = ⟨ kc_nz , ∅ ⟩ ⇒ ty = tx ∧ vb = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ G , ty = tx ∧ vb = ⟨ kc_nz , ∅ ⟩ ⇒ ra_spine th tx ta ∈ lrel $ by weaken [#5]
