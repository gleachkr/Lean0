l359: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , ra_le ⟨ kc_s , scons vj ∅ ⟩ tn ∈ lrel ∧ ra_inst vk x1 ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ e ∈ lrel ∧ ra_sinst td ⟨ kc_s , scons vj ∅ ⟩ tn vk e vz ∈ lrel , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ tn = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add vj n i ∈ lrel , e = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_inst vk va x3 f ∈ lrel ∧ ra_inst vk vb x3 g ∈ lrel , vz = ⟨ kc_app , scons h (scons l ∅) ⟩ ∧ ra_sinst td x2 tn vk f h ∈ lrel ∧ ra_sinst td x2 tn vk g l ∈ lrel ⇒ ∃ c (vz = ⟨ kc_app , scons h (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va h ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by ex_intro [l358]
l360: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , ra_le ⟨ kc_s , scons vj ∅ ⟩ tn ∈ lrel ∧ ra_inst vk x1 ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ e ∈ lrel ∧ ra_sinst td ⟨ kc_s , scons vj ∅ ⟩ tn vk e vz ∈ lrel , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ tn = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add vj n i ∈ lrel , e = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_inst vk va x3 f ∈ lrel ∧ ra_inst vk vb x3 g ∈ lrel , vz = ⟨ kc_app , scons h (scons l ∅) ⟩ ∧ ra_sinst td x2 tn vk f h ∈ lrel ∧ ra_sinst td x2 tn vk g l ∈ lrel ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by ex_intro [l359]
l361: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , ra_le ⟨ kc_s , scons vj ∅ ⟩ tn ∈ lrel ∧ ra_inst vk x1 ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ e ∈ lrel ∧ ra_sinst td ⟨ kc_s , scons vj ∅ ⟩ tn vk e vz ∈ lrel , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ tn = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add vj n i ∈ lrel , e = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_inst vk va x3 f ∈ lrel ∧ ra_inst vk vb x3 g ∈ lrel , ∃ l (vz = ⟨ kc_app , scons h (scons l ∅) ⟩ ∧ ra_sinst td x2 tn vk f h ∈ lrel ∧ ra_sinst td x2 tn vk g l ∈ lrel) ⇒ ∃ l (vz = ⟨ kc_app , scons h (scons l ∅) ⟩ ∧ ra_sinst td x2 tn vk f h ∈ lrel ∧ ra_sinst td x2 tn vk g l ∈ lrel) $ by ax
