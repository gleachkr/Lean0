l28: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g $ by ax
l29: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k $ by ax
l30: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ w = w $ by eq_refl
l31: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ w ∊ lvals $ by weaken [#5]
l32: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ esat u (dsh u M (g ++ s)) ty w = csn ∅ $ by eq_trans [esat_eq [and_elim_l [l29], l30], esat_nil [l31]]
l33: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ q = ∅ $ by csn_elim [welc_eq [l32, and_elim_l [and_elim_r [l28]]]]
l34: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ esat u (dsh u M s) vb w ⊆ fseq u $ by esat_fseq
l35: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ g ∊ fseq u $ by subset_elim [l34, and_elim_l [l28]]
l36: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ g = g $ by eq_refl
l37: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ l = g $ by eq_trans [and_elim_r [and_elim_r [l28]], eq_trans [scat_eq [l33, l36], scat_empty_l [l35]]]
l38: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ vt = vb $ by weaken [l3]
l39: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g ⇒ l ∊ esat u (dsh u M s) vt w $ by wcel_welc [wcel_eq_l [eq_sym [l37], welc_wcel [welc_eq [esat_eq [eq_sym [l38], l30], and_elim_l [l28]]]]]
l40: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = k ∧ vt = k , l ∊ {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ x = q ++ g)} , ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g) ⇒ ∃ q (g ∊ esat u (dsh u M s) vb w ∧ q ∊ esat u (dsh u M (g ++ s)) ty w ∧ l = q ++ g) $ by ax
