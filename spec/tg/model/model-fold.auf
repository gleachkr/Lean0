lemma f26_pc_all (G: hyps) (tk: set): $ G ⇒ trees ω ⊆ f26_pc_q tk $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel , ra_clen y q ∈ lrel ⇒ crn j ⊆ f26_pc_q tk $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel , ra_clen y q ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel , ra_clen y q ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel , ra_clen y q ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel , ra_clen y q ∈ lrel ⇒ ra_pis y f r ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel , ra_clen y q ∈ lrel ⇒ ra_closed tk r ∈ lrel $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel , ra_clen y q ∈ lrel ⇒ ra_clen y q ∈ lrel $ by ax
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel , ra_clen y q ∈ lrel ⇒ ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel) $ by f26_pc_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel , ra_closed tk r ∈ lrel ⇒ ra_clen y q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel) $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ , ra_pis y f r ∈ lrel ⇒ ra_closed tk r ∈ lrel → ra_clen y q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel) $ by imp_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ ⇒ ra_pis y f r ∈ lrel → ra_closed tk r ∈ lrel → ra_clen y q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel) $ by imp_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ ⇒ ∀ q (ra_pis y f r ∈ lrel → ra_closed tk r ∈ lrel → ra_clen y q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel)) $ by all_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ ⇒ ∀ r ∀ q (ra_pis y f r ∈ lrel → ra_closed tk r ∈ lrel → ra_clen y q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel)) $ by all_intro [l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ ⇒ ∀ f ∀ r ∀ q (ra_pis y f r ∈ lrel → ra_closed tk r ∈ lrel → ra_clen y q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel)) $ by all_intro [l13]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ ⇒ y ∊ f26_pc_q tk $ by cab_intro [l14]
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f26_pc_q tk $ by wcel_intro [l16, l15]
l18: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l19: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_pc_q tk ⇒ ⟨ i , j ⟩ ∈ f26_pc_q tk $ by isset_elim [l18, l17]
l20: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f26_pc_q tk → ⟨ i , j ⟩ ∈ f26_pc_q tk $ by imp_intro [imp_intro [imp_intro [l19]]]
l21: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f26_pc_q tk → ⟨ i , j ⟩ ∈ f26_pc_q tk) $ by all_intro [all_intro [l20]]
l22: $ G ⇒ isset ω $ by omega_set
l23: $ G ⇒ trees ω ⊆ f26_pc_q tk $ by trees_ind_c [l22, l21]

pis_closed_clen
---------------
l1: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ x1 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_pis tp tf tr ∈ lrel $ by weaken [#1]
l3: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tr = tr $ by eq_refl
l4: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed x1 tr ∈ lrel $ by wcel_eq_l [ra_closed_eq [eq_sym [l1], l3], weaken [#2]]
l5: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ trees ω ⊆ f26_pc_q x1 $ by f26_pc_all
l6: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kr_pis , scons tp (scons tf (scons tr ∅)) ⟩ ∈ latoms $ by lrel_latoms [l2]
l7: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l8: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons tr ∅) $ by scons_set [l7]
l9: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons tf (scons tr ∅)) $ by scons_set [l8]
l10: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons tp (scons tf (scons tr ∅))) $ by scons_set [l9]
l11: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_pis ∈ ω $ by kr_pis_omega
l12: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_pis ∈ ω ∧ scons tp (scons tf (scons tr ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l6, wcel_isset [l11], l10]
l13: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ crn (scons tp (scons tf (scons tr ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l12]]
l14: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l15: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tp ∈ trees ω $ by crn_scons_head_trees [l14, l13]
l16: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tp ∊ f26_pc_q x1 $ by subset_elim [l5, wcel_welc [l15]]
l17: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ z (ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel) $ by f26_pc_e [l16, l2, l4, weaken [#3]]
l18: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel ⇒ ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel $ by ax
l19: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel ⇒ x1 = ⟨ kc_nz , ∅ ⟩ $ by ax
l20: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel ⇒ tq = tq $ by eq_refl
l21: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel ⇒ z = z $ by eq_refl
l22: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ tq z ∈ lrel $ by wcel_eq_l [ra_add_eq [l19, l20, l21], and_elim_l [l18]]
l23: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel ⇒ z = tq $ by add_zero_l [l22]
l24: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel ⇒ tf = tf $ by eq_refl
l25: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 tq z ∈ lrel ∧ ra_closed z tf ∈ lrel ⇒ ra_closed tq tf ∈ lrel $ by wcel_eq_l [ra_closed_eq [l23, l24], and_elim_r [l18]]
l26: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed tq tf ∈ lrel $ by ex_elim [l17, l25]
l27: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l28: $ G ⇒ ra_closed tq tf ∈ lrel $ by isset_elim [l27, l26]

--| @freshen G l
--| @freshen G c
lemma f26_data {l c: set} (G: hyps) (J: class) (tg td tb tp tt tnp tn tm: set): $ G ⇒ ra_ind_wf tg td ∈ lrel3 J $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ind_wf_data [#1]
l2: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J $ by ax
l3: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ iprt td tp tt $ by ex_intro [weaken [#2]]
l4: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ iprt td x2 x3 $ by ex_intro [and_elim_l [l2]]
l5: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ tp = x2 ∧ tt = x3 $ by iprt_det [l3, l4]
l6: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_tys_closed tp tt ∈ lrel $ by wcel_eq_l [ra_tys_closed_eq [eq_sym [and_elim_l [l5]], eq_sym [and_elim_r [l5]]], and_elim_l [and_elim_r [l2]]]
l7: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ x4 = x4 $ by eq_refl
l8: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_clen tp x4 ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [and_elim_l [l5]], l7], and_elim_l [and_elim_r [and_elim_r [l2]]]]
l9: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ tnp = x4 $ by lrel_clen_det [weaken [#3], l8]
l10: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ x5 = x5 $ by eq_refl
l11: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ x6 = x6 $ by eq_refl
l12: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_ntys tt x5 x6 ∈ lrel $ by wcel_eq_l [ra_ntys_eq [eq_sym [and_elim_r [l5]], l10, l11], and_elim_l [and_elim_r [and_elim_r [and_elim_r [l2]]]]]
l13: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ tn = x5 ∧ tm = x6 $ by lrel_ntys_det [weaken [#4], l12]
l14: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ td = td $ by eq_refl
l15: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ x8 = x8 $ by eq_refl
l16: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l17: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ x7 = x7 $ by eq_refl
l18: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_tys_wf td tn tnp x8 ⟨ kc_nz , ∅ ⟩ x7 tt ∈ lrel3 J $ by wcel_eq_l [ra_tys_wf_eq [l14, eq_sym [and_elim_l [l13]], eq_sym [l9], l15, l16, l17, eq_sym [and_elim_r [l5]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l2]]]]]]]]
l19: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ∃ c (ra_tys_wf td tn tnp x8 ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_intro [l18]
l20: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_intro [l19]
l21: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by and_intro [l6, l20]
l22: $ G , ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l23: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l22, l21]
l24: $ G , ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l25: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l24, l23]
l26: $ G , ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l27: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l26, l25]
l28: $ G , ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l29: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l28, l27]
l30: $ G , ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l31: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l30, l29]
l32: $ G , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l33: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l32, l31]
l34: $ G , ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l35: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l34, l33]
l36: $ G , ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l37: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l36, l35]
l38: $ G , ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l39: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l38, l37]
l40: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) ⇒ ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ax
l41: $ … ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l40, l39]
l42: $ G ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by ex_elim [l1, l41]

--| @freshen G a
lemma f26_cclosed {a: set} (G: hyps) (J: class) (td tb tp tt tnp tn tl tc ti te tj tk: set): $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_ctors_wf td tn tnp tl ti tc te ∈ lrel3 J $ > $ G ⇒ ra_nth_ctor te tj tk ∈ lrel $ > $ G ⇒ ∃ a (ra_closed a tk ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel) $ by lrel3_ctors_wf_nth_closed [#3, #4]
l2: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel ⇒ ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel $ by ax
l3: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel ⇒ iprt td tp tt $ by ex_intro [weaken [#1]]
l4: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel ⇒ iprt td x2 x3 $ by ex_intro [and_elim_l [l2]]
l5: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel ⇒ tp = x2 ∧ tt = x3 $ by iprt_det [l3, l4]
l6: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel ⇒ tk = tk $ by eq_refl
l7: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel ⇒ x4 = x4 $ by eq_refl
l8: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel ⇒ ra_pis tp tk x4 ∈ lrel $ by wcel_eq_l [ra_pis_eq [eq_sym [and_elim_l [l5]], l6, l7], and_elim_l [and_elim_r [l2]]]
l9: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel ⇒ ∃ a (ra_closed a tk ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) $ by lrel_pis_closed [l8, and_elim_r [and_elim_r [l2]], weaken [#2]]
l10: $ G , ∃ x4 (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel) ⇒ ∃ x4 (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel) $ by ax
l11: $ … ⇒ ∃ a (ra_closed a tk ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) $ by ex_elim [l10, l9]
l12: $ G , ∃ x3 ∃ x4 (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel) ⇒ ∃ x3 ∃ x4 (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel) $ by ax
l13: $ … ⇒ ∃ a (ra_closed a tk ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) $ by ex_elim [l12, l11]
l14: $ G , ∃ x2 ∃ x3 ∃ x4 (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel) ⇒ ∃ x2 ∃ x3 ∃ x4 (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_pis x2 tk x4 ∈ lrel ∧ ra_closed tn x4 ∈ lrel) $ by ax
l15: $ … ⇒ ∃ a (ra_closed a tk ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) $ by ex_elim [l14, l13]
l16: $ G ⇒ ∃ a (ra_closed a tk ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) $ by ex_elim [l1, l15]

lemma f26_ictor_ne (G: hyps) (E Jc Cc: class) (u w td: set): $ G ⇒ (ixs td w (ifam u E td w)) ∈ fseq u $ > $ G ⇒ ¬ ∅ ∈ ictor u E td Jc Cc w $
----
l1: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ ⇒ x1 = ∅ $ by ax
l2: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ ⇒ ∅ ∈ ictor u E td Jc Cc w $ by ax
l3: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ ⇒ x1 ∊ ictor u E td Jc Cc w $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ ⇒ ¬ iprop td Jc w ∧ ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 (iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0) $ by cab_elim [l3]
l5: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 ⇒ iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 $ by ax
l6: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 ⇒ x5 ∈ trees ω $ by ictk_tree [and_elim_l [and_elim_r [and_elim_r [l5]]]]
l7: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 ⇒ esat u E x3 w ⊆ fseq u $ by esat_fseq
l8: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 ⇒ x2 ∊ fseq u $ by subset_elim [l7, and_elim_l [and_elim_r [l5]]]
l9: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 ⇒ (ixs td w (ifam u E td w)) ∈ fseq u $ by weaken [#1]
l10: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 ⇒ x2 ++ ixs td w (ifam u E td w) ∈ fseq u $ by scat_fseq_c [welc_wcel [l8], l9]
l11: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 , o = x2 ++ ixs td w (ifam u E td w) ⇒ x5 = x5 $ by eq_refl
l12: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 , o = x2 ++ ixs td w (ifam u E td w) ⇒ w = w $ by eq_refl
l13: $ G , ∅ ∈ ictor u E td Jc Cc w , x1 = ∅ , iprt td x3 x4 ∧ x2 ∊ esat u E x3 w ∧ ictk td Jc Cc x5 ∧ ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E x5 w (x2 ++ ixs td w (ifam u E td w)) ∧ x0 ∊ scons Cc x7 ∧ x1 = nest (x6 ++ x2) x0 , o = x2 ++ ixs td w (ifam u E td w) ⇒ o = x2 ++ ixs td w (ifam u E td w) $ by ax
