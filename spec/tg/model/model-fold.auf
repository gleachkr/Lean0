l349: $ G ⇒ ∀ i (i ∊ suc (nvf' tfi) → (itup td (nvf' ti) ∅ pg w)' (suc i) = pg' i) $ by or_elim [l2, l348, l12]

def f49_nn_q  (.y .n .m: set): class = $ {y | ∀ n ∀ m (ra_ntys y n m ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel)} $

lemma f49_nn_e (G: hyps)  (ty vn vm: set): $ G ⇒ ty ∊ f49_nn_q  $ > $ G ⇒ ra_ntys ty vn vm ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $
----
l1: $ G ⇒ ∀ n ∀ m (ra_ntys ty n m ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ m (ra_ntys ty vn m ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ra_ntys ty vn vm ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by all_elim [l2]
l4: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by imp_elim [l3, #2]

lemma f49_nn_n (G: hyps)  (ty k1 j1 vn vm: set): $ G ⇒ crn j1 ⊆ f49_nn_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_ntys ty vn vm ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $
----
l1: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l1]
l3: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ vn = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [and_elim_r [l1]]
l4: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ vm = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [and_elim_r [l1]]
l5: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l6: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ kc_nz ∈ ω $ by kc_nz_omega
l7: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l8: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l5, l6, l7]
l9: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_add_z [l8]
l10: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l11: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by wcel_eq_l [ra_add_eq [l10, eq_sym [l3], eq_sym [l3]], l9]
