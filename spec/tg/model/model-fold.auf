l9: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ crn (scons tg (scons tb ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l11: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ tg ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kr_clen , scons tg (scons tb ∅) ⟩ ∈ latoms $ by lrel_latoms [l2]
l13: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l14: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons tb ∅) $ by scons_set [l13]
l15: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons tg (scons tb ∅)) $ by scons_set [l14]
l16: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ kr_clen ∈ ω $ by kr_clen_omega
