lemma f48_rv_all (G: hyps) (E: class) (u w: set): $ G ⇒ trees ω ⊆ f48_rv_q E u w $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r , w ∊ lvals ⇒ crn x9 ⊆ f48_rv_q E u w $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r , w ∊ lvals ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r , w ∊ lvals ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r , w ∊ lvals ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r , w ∊ lvals ⇒ ra_npis y n ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r , w ∊ lvals ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r , w ∊ lvals ⇒ w ∊ lvals $ by ax
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r , w ∊ lvals ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m) $ by f48_rv_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r ⇒ w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m) $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ , ra_npis y n ∈ lrel ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m) $ by imp_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ ra_npis y n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m) $ by imp_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ ∀ a (ra_npis y n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ ∀ t ∀ a (ra_npis y n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ ∀ g ∀ t ∀ a (ra_npis y n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by all_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ ∀ f ∀ g ∀ t ∀ a (ra_npis y n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by all_intro [l14]
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ ∀ r ∀ f ∀ g ∀ t ∀ a (ra_npis y n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by all_intro [l15]
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n ∀ r ∀ f ∀ g ∀ t ∀ a (ra_npis y n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by all_intro [l16]
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f48_rv_q E u w $ by cab_intro [l17]
l19: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l20: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f48_rv_q E u w $ by wcel_intro [l19, l18]
l21: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l22: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_rv_q E u w ⇒ ⟨ x8 , x9 ⟩ ∈ f48_rv_q E u w $ by isset_elim [l21, l20]
l23: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f48_rv_q E u w → ⟨ x8 , x9 ⟩ ∈ f48_rv_q E u w $ by imp_intro [imp_intro [imp_intro [l22]]]
l24: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f48_rv_q E u w → ⟨ x8 , x9 ⟩ ∈ f48_rv_q E u w) $ by all_intro [all_intro [l23]]
l25: $ G ⇒ isset ω $ by omega_set
l26: $ G ⇒ trees ω ⊆ f48_rv_q E u w $ by trees_ind_c [l25, l24]

etel_rev
--------
l1: $ G ⇒ trees ω ⊆ f48_rv_q E u w $ by f48_rv_all
l2: $ G ⇒ ⟨ kr_npis , scons t1 (scons t2 ∅) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons t2 ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by scons_set [l4]
l6: $ G ⇒ kr_npis ∈ ω $ by kr_npis_omega
l7: $ G ⇒ kr_npis ∈ ω ∧ scons t1 (scons t2 ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons t1 (scons t2 ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ isset ω $ by omega_set
l10: $ G ⇒ t1 ∈ trees ω $ by crn_scons_head_trees [l9, l8]
l11: $ G ⇒ t1 ∊ f48_rv_q E u w $ by subset_elim [l1, wcel_welc [l10]]
l12: $ G ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm p1 → p2' i = p1' m) $ by f48_rv_e [l11, #1, #3, #2]

--| @freshen H qM
--| @freshen H qk_v
lemma f21_inv_projs {qM qk_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5: set): $ G ⇒ ra_projs t1 t2 t3 t4 t5 ∈ lrel $ > $ H , t3 = ⟨ kc_nz , ∅ ⟩ ∧ t5 = t4 ⇒ Cf $ > $ H , t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons t1 (scons qk_v (scons t2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs t1 t2 qk_v t4 qM ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_projs t1 t2 t3 t4 t5 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z) ∨ ∃ x ∃ y ∃ z ∃ qM ∃ qk_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel) $ by lrel_projs_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z ⇒ t5 = t4 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t5 = t4 $ by and_intro [and_elim_l [and_elim_r [and_elim_r [l3]]], l4]
l6: $ H ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t5 = t4 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t5 = t4 → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ z (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z) ⇒ ∃ z (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H , ∃ y ∃ z (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z) ⇒ ∃ y ∃ z (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z) $ by ax
l12: $ … ⇒ Cf $ by ex_elim [l11, l10]
l13: $ G , H , ∃ x ∃ y ∃ z (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z) ⇒ ∃ x ∃ y ∃ z (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z) $ by ax
l14: $ … ⇒ Cf $ by ex_elim [l13, l12]
l15: $ G , H ⇒ (∃ x ∃ y ∃ z (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = z ∧ t5 = z)) → Cf $ by imp_intro [l14]
l16: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel $ by ax
l17: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l18: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel ⇒ qk_v = qk_v $ by eq_refl
l19: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel ⇒ kc_proj = kc_proj $ by eq_refl
l20: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel ⇒ qM = qM $ by eq_refl
l21: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel ⇒ kc_app = kc_app $ by eq_refl
l22: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qk_v ∅ ⟩ ∧ t4 = z ∧ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons x (scons qk_v (scons y ∅)) ⟩ ∅) ⟩ ∧ ra_projs x y qk_v z qM ∈ lrel ⇒ t5 = ⟨ kc_app , scons qM (scons ⟨ kc_proj , scons t1 (scons qk_v (scons t2 ∅)) ⟩ ∅) ⟩ $ by eq_trans [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l16]]]]], opair_eq [l21, scons_eq [l20, scons_eq [opair_eq [l19, scons_eq [eq_sym [and_elim_l [l16]], scons_eq [l18, scons_eq [eq_sym [and_elim_l [and_elim_r [l16]]], l17]]]], l17]]]]
