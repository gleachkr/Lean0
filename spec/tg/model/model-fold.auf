def f15_mi_q (M: class) (u w td tnp tv tn p rr: set) (.y .n .m .c .r .k .o .a .b .x .f .l .i: set): class = $ {y | ∀ n ∀ m ∀ c ∀ r ∀ k ∀ o (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → rr ∊ fseq u → tv ∊ trees ω → ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) → ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) → ra_motives td tnp tv n y m ∈ lrel → m ∊ ofsort lsig lopen ks_ctx → n ∊ ofsort lsig lopen ks_nat → ra_ntys y k o ∈ lrel → nadd (nvf' n) (nvf' k) = nvf' tn → ∀ a ∀ f ∀ b (ra_nth_ty y a f b ∈ lrel → ityf td (nadd (nvf' n) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) → c ∊ fseq u → cdm c = nvf' n → r = c ++ p ++ rr → esat u (dsh u M r) m w = {l | l ∊ fseq u ∧ cdm l = nvf' k ∧ ∀ i (i ∊ nvf' tn → nvf' n ⊆ i → vat (l ++ c) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))})} $

--| @freshen G a
--| @freshen G b
--| @freshen G x
--| @freshen G f
--| @freshen G l
--| @freshen G i
lemma f15_mi_e {a b x f l i: set} (G: hyps) (M: class) (u w td tnp tv tn p rr: set) (ty vn vm vc vr vk vo: set): $ G ⇒ ty ∊ f15_mi_q M u w td tnp tv tn p rr $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' tnp $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ tv ∊ trees ω $ > $ G ⇒ ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) $ > $ G ⇒ ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) $ > $ G ⇒ ra_motives td tnp tv vn ty vm ∈ lrel $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vn ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ra_ntys ty vk vo ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vk) = nvf' tn $ > $ G ⇒ ∀ a ∀ f ∀ b (ra_nth_ty ty a f b ∈ lrel → ityf td (nadd (nvf' vn) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) $ > $ G ⇒ vc ∊ fseq u $ > $ G ⇒ cdm vc = nvf' vn $ > $ G ⇒ vr = vc ++ p ++ rr $ > $ G ⇒ esat u (dsh u M vr) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vk ∧ ∀ i (i ∊ nvf' tn → nvf' vn ⊆ i → vat (l ++ vc) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))} $
----
l1: $ G ⇒ ∀ n ∀ m ∀ c ∀ r ∀ k ∀ o (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → rr ∊ fseq u → tv ∊ trees ω → ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) → ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) → ra_motives td tnp tv n ty m ∈ lrel → m ∊ ofsort lsig lopen ks_ctx → n ∊ ofsort lsig lopen ks_nat → ra_ntys ty k o ∈ lrel → nadd (nvf' n) (nvf' k) = nvf' tn → ∀ a ∀ f ∀ b (ra_nth_ty ty a f b ∈ lrel → ityf td (nadd (nvf' n) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) → c ∊ fseq u → cdm c = nvf' n → r = c ++ p ++ rr → esat u (dsh u M r) m w = {l | l ∊ fseq u ∧ cdm l = nvf' k ∧ ∀ i (i ∊ nvf' tn → nvf' n ⊆ i → vat (l ++ c) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))}) $ by cab_elim [#1]
l2: $ G ⇒ ∀ m ∀ c ∀ r ∀ k ∀ o (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → rr ∊ fseq u → tv ∊ trees ω → ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (nvf' a) w) → ∀ a (a ∊ ofsort lsig lopen ks_nat → nvf' a ∈ nvf' tn → ity u (dnf u M) td (nvf' a) w ∈ u) → ra_motives td tnp tv vn ty m ∈ lrel → m ∊ ofsort lsig lopen ks_ctx → vn ∊ ofsort lsig lopen ks_nat → ra_ntys ty k o ∈ lrel → nadd (nvf' vn) (nvf' k) = nvf' tn → ∀ a ∀ f ∀ b (ra_nth_ty ty a f b ∈ lrel → ityf td (nadd (nvf' vn) (nvf' a)) f ∧ ra_closed tnp f ∈ lrel) → c ∊ fseq u → cdm c = nvf' vn → r = c ++ p ++ rr → esat u (dsh u M r) m w = {l | l ∊ fseq u ∧ cdm l = nvf' k ∧ ∀ i (i ∊ nvf' tn → nvf' vn ⊆ i → vat (l ++ c) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))}) $ by all_elim [l1]
