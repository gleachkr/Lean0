--| @freshen G h
lemma f30_cp_n {x b e g h: set} (G: hyps) (J: class) (td tn tnp tl ti tz: set) (ty k1 j1 vf vk vz vq vt vd vc: set): $ G ⇒ crn j1 ⊆ f30_cp_q J td tn tnp tl ti tz $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add tz tn tn ∈ lrel $ > $ G ⇒ ra_npis ty vf ∈ lrel $ > $ G ⇒ ra_sinst td tz tn vk ty vz ∈ lrel $ > $ G ⇒ ra_pis vq vz vt ∈ lrel $ > $ G ⇒ ra_clen vq vd ∈ lrel $ > $ G ⇒ ra_cwf td tn tnp tl ti vc vd ty ∈ lrel3 J $ > $ G ⇒ ra_add vd tnp vk ∈ lrel $ > $ G ⇒ ∃ x ∃ b ∃ e ∃ g ∃ h (ra_pis x b vt ∈ lrel ∧ ra_clen x g ∈ lrel ∧ ra_add vd vf g ∈ lrel ∧ ra_sinst td tz tn h e b ∈ lrel ∧ ra_indapp td tn tnp g e ti ∈ lrel ∧ ra_add g tnp h ∈ lrel) $
