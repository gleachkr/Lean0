l160: $ G , x1 = ifam u (dnf u (mcv H)) td w , x2 = sarg u (dnf u (mcv H)) tS w r ⇒ nvf' ti ∈ ω $ by nvf_omega [l159]
l161: $ G , x1 = ifam u (dnf u (mcv H)) td w , x2 = sarg u (dnf u (mcv H)) tS w r ⇒ isset (nvf' ti) $ by wcel_isset [l160]
l162: $ G , x1 = ifam u (dnf u (mcv H)) td w , x2 = sarg u (dnf u (mcv H)) tS w r ⇒ ∃ p ∃ c ∃ k ∃ f ∃ g ∃ t ∃ e (p ∊ esat u (dnf u (mcv H)) tp w ∧ ictk td (nvf' ti) c k ∧ ⟨ f , ⟨ g , ⟨ t , sarg u (dnf u (mcv H)) tS w r ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) ∧ x = itup td (nvf' ti) c g w ∧ sarg u (dnf u (mcv H)) tS w r = e ++ p ∧ e ∊ fseq u ∧ cdm e = nvf' tq) $ by isset_elim [l161, l158]
l163: $ G , x1 = ifam u (dnf u (mcv H)) td w ⇒ sarg u (dnf u (mcv H)) tS w r ∈ fseq u $ by weaken [l54]
l164: $ G , x1 = ifam u (dnf u (mcv H)) td w ⇒ isset (sarg u (dnf u (mcv H)) tS w r) $ by wcel_isset [l163]
l165: $ G , x1 = ifam u (dnf u (mcv H)) td w ⇒ ∃ p ∃ c ∃ k ∃ f ∃ g ∃ t ∃ e (p ∊ esat u (dnf u (mcv H)) tp w ∧ ictk td (nvf' ti) c k ∧ ⟨ f , ⟨ g , ⟨ t , sarg u (dnf u (mcv H)) tS w r ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) ∧ x = itup td (nvf' ti) c g w ∧ sarg u (dnf u (mcv H)) tS w r = e ++ p ∧ e ∊ fseq u ∧ cdm e = nvf' tq) $ by isset_elim [l164, l162]
l166: $ G ⇒ isset (ifam u (dnf u (mcv H)) td w) $ by ifam_set
l167: $ G ⇒ ∃ p ∃ c ∃ k ∃ f ∃ g ∃ t ∃ e (p ∊ esat u (dnf u (mcv H)) tp w ∧ ictk td (nvf' ti) c k ∧ ⟨ f , ⟨ g , ⟨ t , sarg u (dnf u (mcv H)) tS w r ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) ∧ x = itup td (nvf' ti) c g w ∧ sarg u (dnf u (mcv H)) tS w r = e ++ p ∧ e ∊ fseq u ∧ cdm e = nvf' tq) $ by isset_elim [l166, l165]

--| @freshen G i
--| @freshen G m
lemma f48_rev {i m: set} (G: hyps) (A: class) (f g x: set): $ G ⇒ f ∊ fseq A $ > $ G ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m) $ > $ G ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = suc (cdm f) → (scons x g)' i = (ssnoc f x)' m) $
----
l1: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) ⇒ i ∊ ω $ by ax
l2: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) ⇒ m ∊ ω $ by ax
l3: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) ⇒ nadd i (suc m) = suc (cdm f) $ by ax
l4: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) ⇒ suc m ∈ ω $ by omega_suc [l2]
l5: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) ⇒ f ∊ fseq A $ by weaken [#1]
l6: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) ⇒ cdm f ∈ ω $ by fseq_len [l5]
l7: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) ⇒ i = ∅ ∨ ∃ y (y ∊ ω ∧ i = suc y) $ by omega_cases [l1]
l8: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ i = ∅ $ by ax
l9: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ suc m ∈ ω $ by weaken [l4]
l10: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ , x1 = suc m ⇒ x1 = suc m $ by ax
l11: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ , x1 = suc m ⇒ suc m ∈ ω $ by weaken [l9]
l12: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ , x1 = suc m ⇒ x1 ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l10], l11]]
l13: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ , x1 = suc m ⇒ ∅ = ∅ $ by eq_refl
l14: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ , x1 = suc m ⇒ nadd ∅ (suc m) = suc m $ by eq_trans [nadd_eq [l13, eq_sym [l10]], eq_trans [zero_nadd [l12], l10]]
l15: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ nadd ∅ (suc m) = suc m $ by isset_elim [wcel_isset [l9], l14]
l16: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ suc m = suc m $ by eq_refl
l17: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ nadd i (suc m) = suc (cdm f) $ by weaken [l3]
l18: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ suc m = suc (cdm f) $ by eq_trans [eq_sym [l15], eq_trans [nadd_eq [eq_sym [l8], l16], l17]]
l19: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ isset m $ by isset_var
l20: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ cdm f ∈ ω $ by weaken [l6]
l21: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ m = cdm f $ by suc_inj_c [l19, wcel_isset [l20], l18]
l22: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ (scons x g)' ∅ = x $ by scons_fv_zero
l23: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ f ∊ fseq A $ by weaken [l5]
l24: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ (ssnoc f x)' (cdm f) = x $ by ssnoc_fv_last [l23]
l25: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ scons x g = scons x g $ by eq_refl
l26: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ ssnoc f x = ssnoc f x $ by eq_refl
l27: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , i = ∅ ⇒ (scons x g)' i = (ssnoc f x)' m $ by eq_trans [fv_eq [l25, l8], eq_trans [l22, eq_trans [eq_sym [l24], fv_eq [l26, eq_sym [l21]]]]]
l28: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ y ∊ ω ∧ i = suc y $ by ax
l29: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ y ∊ ω $ by and_elim_l [l28]
l30: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ i = suc y $ by and_elim_r [l28]
l31: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ m ∊ ω $ by weaken [l2]
l32: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ suc m ∈ ω $ by weaken [l4]
l33: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ isset y $ by isset_var
l34: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ nadd (suc y) (suc m) = suc (nadd y (suc m)) $ by suc_nadd_c [l33, l32]
l35: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ suc m = suc m $ by eq_refl
l36: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ nadd i (suc m) = suc (cdm f) $ by weaken [l3]
l37: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ suc (nadd y (suc m)) = suc (cdm f) $ by eq_trans [eq_sym [l34], eq_trans [nadd_eq [eq_sym [l30], l35], l36]]
l38: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ isset y $ by isset_var
l39: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ cdm f ∈ ω $ by weaken [l6]
l40: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ nadd y (suc m) = cdm f $ by suc_inj_c [nadd_set_c [l38, wcel_isset [l32]], wcel_isset [l39], l37]
l41: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m) $ by weaken [#2]
l42: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ ∀ m (y ∊ ω → m ∊ ω → nadd y (suc m) = cdm f → g' y = f' m) $ by all_elim [l41]
l43: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ y ∊ ω → m ∊ ω → nadd y (suc m) = cdm f → g' y = f' m $ by all_elim [l42]
l44: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ g' y = f' m $ by imp_elim [imp_elim [imp_elim [l43, l29], l31], l40]
l45: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ nadd y (suc m) = suc (nadd y m) $ by nadd_suc [l31]
l46: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ nadd m (suc y) = suc (nadd m y) $ by nadd_suc [l29]
l47: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ nadd y m = nadd m y $ by nadd_comm [l29, l31]
l48: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y , n = cdm f ⇒ n = cdm f $ by ax
l49: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y , n = cdm f ⇒ nadd m (suc y) = suc (nadd m y) $ by weaken [l46]
l50: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y , n = cdm f ⇒ nadd y m = nadd m y $ by weaken [l47]
l51: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y , n = cdm f ⇒ nadd y (suc m) = suc (nadd y m) $ by weaken [l45]
l52: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y , n = cdm f ⇒ nadd y (suc m) = cdm f $ by weaken [l40]
l53: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y , n = cdm f ⇒ nadd m (suc y) = n $ by eq_trans [l49, eq_trans [suc_eq [eq_sym [l50]], eq_trans [eq_sym [l51], eq_trans [l52, eq_sym [l48]]]]]
l54: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y , n = cdm f ⇒ y ∊ ω $ by weaken [l29]
l55: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y , n = cdm f ⇒ m ∊ cdm f $ by welc_eq [l48, nlt_of_nadd_suc [l54, l53]]
l56: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ cdm f ∈ ω $ by weaken [l6]
l57: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ isset (cdm f) $ by wcel_isset [l56]
l58: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ m ∊ cdm f $ by isset_elim [l57, l55]
l59: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ (scons x g)' (suc y) = g' y $ by scons_fv_suc
l60: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ f ∊ fseq A $ by weaken [l5]
l61: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ (ssnoc f x)' m = f' m $ by ssnoc_fv_lt [l60, l58]
l62: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ scons x g = scons x g $ by eq_refl
l63: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , y ∊ ω ∧ i = suc y ⇒ (scons x g)' i = (ssnoc f x)' m $ by eq_trans [fv_eq [l62, l30], eq_trans [l59, eq_trans [l44, eq_sym [l61]]]]
l64: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) , ∃ y (y ∊ ω ∧ i = suc y) ⇒ ∃ y (y ∊ ω ∧ i = suc y) $ by ax
l65: $ … ⇒ (scons x g)' i = (ssnoc f x)' m $ by ex_elim [l64, l63]
l66: $ G , i ∊ ω , m ∊ ω , nadd i (suc m) = suc (cdm f) ⇒ (scons x g)' i = (ssnoc f x)' m $ by or_elim [l7, l27, l65]
l67: $ G , i ∊ ω , m ∊ ω ⇒ nadd i (suc m) = suc (cdm f) → (scons x g)' i = (ssnoc f x)' m $ by imp_intro [l66]
l68: $ G , i ∊ ω ⇒ m ∊ ω → nadd i (suc m) = suc (cdm f) → (scons x g)' i = (ssnoc f x)' m $ by imp_intro [l67]
l69: $ G ⇒ i ∊ ω → m ∊ ω → nadd i (suc m) = suc (cdm f) → (scons x g)' i = (ssnoc f x)' m $ by imp_intro [l68]
l70: $ G ⇒ ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = suc (cdm f) → (scons x g)' i = (ssnoc f x)' m) $ by all_intro [l69]
l71: $ G ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = suc (cdm f) → (scons x g)' i = (ssnoc f x)' m) $ by all_intro [l70]

def f48_rv_q (E: class) (u w: set) (.y .n .r .f .g .t .a .i .m: set): class = $ {y | ∀ n ∀ r ∀ f ∀ g ∀ t ∀ a (ra_npis y n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m))} $

--| @freshen G i
--| @freshen G m
lemma f48_rv_e {i m: set} (G: hyps) (E: class) (u w: set) (ty vn vr vf vg vt va: set): $ G ⇒ ty ∊ f48_rv_q E u w $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u E ty w vr $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m) $
----
l1: $ G ⇒ ∀ n ∀ r ∀ f ∀ g ∀ t ∀ a (ra_npis ty n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ty w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r ∀ f ∀ g ∀ t ∀ a (ra_npis ty vn ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ty w r → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by all_elim [l1]
l3: $ G ⇒ ∀ f ∀ g ∀ t ∀ a (ra_npis ty vn ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ty w vr → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm f → g' i = f' m)) $ by all_elim [l2]
l4: $ G ⇒ ∀ g ∀ t ∀ a (ra_npis ty vn ∈ lrel → ⟨ vf , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ty w vr → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → g' i = vf' m)) $ by all_elim [l3]
l5: $ G ⇒ ∀ t ∀ a (ra_npis ty vn ∈ lrel → ⟨ vf , ⟨ vg , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ty w vr → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m)) $ by all_elim [l4]
l6: $ G ⇒ ∀ a (ra_npis ty vn ∈ lrel → ⟨ vf , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u E ty w vr → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m)) $ by all_elim [l5]
l7: $ G ⇒ ra_npis ty vn ∈ lrel → ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u E ty w vr → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m) $ by all_elim [l6]
l8: $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u E ty w vr → w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m) $ by imp_elim [l7, #2]
l9: $ G ⇒ w ∊ lvals → ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m) $ by imp_elim [l8, #3]
l10: $ G ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m) $ by imp_elim [l9, #4]

--| @freshen G i
--| @freshen G m
lemma f48_rv_n {i m: set} (G: hyps) (E: class) (u w: set) (ty k1 j1 vn vr vf vg vt va: set): $ G ⇒ crn j1 ⊆ f48_rv_q E u w $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u E ty w vr $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m) $
----
l1: $ G , ty = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ $ by ax
