spine_args
----------
l1: $ G ⇒ trees ω ⊆ f17_spine_args_q M u w r tY $ by f17_spine_args_all
l2: $ G ⇒ te ∊ f17_spine_args_q M u w r tY $ by subset_elim [l1, #5]
l3: $ G ⇒ ∃ i ∃ b (a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $ by f17_spine_args_e [l2, #1, #2, #3, #4, #5, #6]

def f17_rehead_args_q (M: class) (u w r tY tX: set) (.d .k .m .a .i .b .y: set): class = $ {d | ∀ k ∀ m ∀ a (w ∊ lvals → r ∊ fseq u → ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) → ra_rehead tY tX k d m ∈ lrel → d ∊ trees ω → m ∊ trees ω → ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w r → ∃ i ∃ b (a = i ++ b ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' k ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M m w r = apn (dt u M tX w r) i))} $

