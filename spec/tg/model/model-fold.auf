l18: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ crn (scons vi (scons ty (scons x1 (scons vr ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l17]]
l19: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset ω $ by omega_set
l20: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ vi ∈ trees ω $ by crn_scons_head_trees [l19, l18]
l21: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ ⟨ kr_pinst , scons vi (scons ty (scons x1 (scons vr ∅))) ⟩ ∈ latoms $ by lrel_latoms [l9]
