l91: $ G , vd = tnf ∧ vv = va ∧ ra_npis ty ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ vv ∊ ofsort lsig lopen ks_expr $ by weaken [#6]
l92: $ G , vd = tnf ∧ vv = va ∧ ra_npis ty ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ va ∊ ofsort lsig lopen ks_expr $ by wcel_welc [wcel_eq_l [l89, welc_wcel [l91]]]
l93: $ G ⇒ va ∊ ofsort lsig lopen ks_expr $ by f21_inv_rwalk [#5, l38, l86, l92]

lemma f39s_all (G: hyps) (td tnp tn tm tv tnf: set): $ G ⇒ trees ω ⊆ f39s_q td tnp tn tm tv tnf $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ , ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ crn j ⊆ f39s_q td tnp tn tm tv tnf $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ , ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ , ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ , ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ , ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ , ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ v ∊ ofsort lsig lopen ks_expr $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ , ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel , v ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_expr $ by f39s_n [l1, l2, l3, l4, l5, l6]
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ , ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel ⇒ v ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr $ by imp_intro [l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ ⇒ ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ ⇒ ∀ v (ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr) $ by all_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ ⇒ ∀ a ∀ v (ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr) $ by all_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ ⇒ ∀ d ∀ a ∀ v (ra_rwalk td tnp tn tm tv tnf d a y v ∈ lrel → v ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr) $ by all_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ ⇒ y ∊ f39s_q td tnp tn tm tv tnf $ by cab_intro [l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f39s_q td tnp tn tm tv tnf $ by wcel_intro [l14, l13]
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f39s_q td tnp tn tm tv tnf ⇒ ⟨ i , j ⟩ ∈ f39s_q td tnp tn tm tv tnf $ by isset_elim [l16, l15]
l18: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f39s_q td tnp tn tm tv tnf → ⟨ i , j ⟩ ∈ f39s_q td tnp tn tm tv tnf $ by imp_intro [imp_intro [imp_intro [l17]]]
l19: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f39s_q td tnp tn tm tv tnf → ⟨ i , j ⟩ ∈ f39s_q td tnp tn tm tv tnf) $ by all_intro [all_intro [l18]]
l20: $ G ⇒ isset ω $ by omega_set
l21: $ G ⇒ trees ω ⊆ f39s_q td tnp tn tm tv tnf $ by trees_ind_c [l20, l19]

rwalk_sort
----------
l1: $ G ⇒ ⟨ kr_rwalk , scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons d (scons tAcc (scons tK (scons tVal ∅))))))))) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tVal ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tK (scons tVal ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tAcc (scons tK (scons tVal ∅))) $ by scons_set [l4]
l6: $ G ⇒ isset (scons d (scons tAcc (scons tK (scons tVal ∅)))) $ by scons_set [l5]
l7: $ G ⇒ isset (scons tnf (scons d (scons tAcc (scons tK (scons tVal ∅))))) $ by scons_set [l6]
l8: $ G ⇒ isset (scons tv (scons tnf (scons d (scons tAcc (scons tK (scons tVal ∅)))))) $ by scons_set [l7]
l9: $ G ⇒ isset (scons tm (scons tv (scons tnf (scons d (scons tAcc (scons tK (scons tVal ∅))))))) $ by scons_set [l8]
l10: $ G ⇒ isset (scons tn (scons tm (scons tv (scons tnf (scons d (scons tAcc (scons tK (scons tVal ∅)))))))) $ by scons_set [l9]
l11: $ G ⇒ isset (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons d (scons tAcc (scons tK (scons tVal ∅))))))))) $ by scons_set [l10]
l12: $ G ⇒ isset (scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons d (scons tAcc (scons tK (scons tVal ∅)))))))))) $ by scons_set [l11]
