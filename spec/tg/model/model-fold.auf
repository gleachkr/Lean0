l77: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel , x1 = ⟨ kc_s , scons vd ∅ ⟩ , x2 = ⟨ kc_app , scons va (scons k ∅) ⟩ ⇒ a ∈ f39s_q td tnp tn tm tv tnf $ by weaken [l64]
l78: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel , x1 = ⟨ kc_s , scons vd ∅ ⟩ , x2 = ⟨ kc_app , scons va (scons k ∅) ⟩ ⇒ b ∊ ofsort lsig lopen ks_expr $ by weaken [l54]
l79: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel , x1 = ⟨ kc_s , scons vd ∅ ⟩ , x2 = ⟨ kc_app , scons va (scons k ∅) ⟩ ⇒ x2 ∊ ofsort lsig lopen ks_expr $ by f39s_e [wcel_welc [l77], l76, l78]
l80: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel , x1 = ⟨ kc_s , scons vd ∅ ⟩ , x2 = ⟨ kc_app , scons va (scons k ∅) ⟩ ⇒ x2 = ⟨ kc_app , scons va (scons k ∅) ⟩ $ by ax
l81: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel , x1 = ⟨ kc_s , scons vd ∅ ⟩ , x2 = ⟨ kc_app , scons va (scons k ∅) ⟩ ⇒ ⟨ kc_app , scons va (scons k ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ by wcel_eq_l [l80, welc_wcel [l79]]
l82: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel , x1 = ⟨ kc_s , scons vd ∅ ⟩ , x2 = ⟨ kc_app , scons va (scons k ∅) ⟩ ⇒ va ∊ ofsort lsig lopen ks_expr $ by and_elim_l [ofsort_app_kids [l81]]
l83: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel , x1 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ isset ⟨ kc_app , scons va (scons k ∅) ⟩ $ by opair_isset
l84: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel , x1 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ va ∊ ofsort lsig lopen ks_expr $ by isset_elim [l83, l82]
l85: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel ⇒ isset ⟨ kc_s , scons vd ∅ ⟩ $ by opair_isset
l86: $ G , ty = ⟨ kc_pi , scons z (scons a ∅) ⟩ ∧ vv = ⟨ kc_lam , scons v (scons b ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_recfield td tn tnp vd z c ∈ lrel ∧ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn x z i ∈ lrel ∧ ra_add tm tn y ∈ lrel ∧ ra_lift y vd i v ∈ lrel ∧ ra_add f vd tnf ∈ lrel ∧ ra_add g ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_lift f ⟨ kc_nz , ∅ ⟩ v j ∈ lrel ∧ ra_ihval td tnp tn tm tv tnf g ⟨ kc_nz , ∅ ⟩ c j k ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ ⟨ kc_app , scons va (scons k ∅) ⟩ a b ∈ lrel ⇒ va ∊ ofsort lsig lopen ks_expr $ by isset_elim [l85, l84]
l87: $ G , vd = tnf ∧ vv = va ∧ ra_npis ty ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ vd = tnf ∧ vv = va ∧ ra_npis ty ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by ax
l88: $ G , vd = tnf ∧ vv = va ∧ ra_npis ty ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ vd = tnf $ by and_elim_l [l87]
l89: $ G , vd = tnf ∧ vv = va ∧ ra_npis ty ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ vv = va $ by and_elim_l [and_elim_r [l87]]
