l13: $ G ⇒ crn (scons tp (scons tnp ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l12]]
l14: $ G ⇒ isset ω $ by omega_set
l15: $ G ⇒ tp ∈ trees ω $ by crn_scons_head_trees [l14, l13]
l16: $ G ⇒ tp ∊ trees ω $ by wcel_welc [l15]
l17: $ G ⇒ ra_clen tp tnp ∈ lrel $ by weaken [#4]
l18: $ G ⇒ pp ∊ esat u (dnf u (mcv H)) tp w $ by weaken [#12]
l19: $ G ⇒ cdm pp = nvf' tnp $ by esat_clen [l17, l16, l18]
l20: $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w pp (lv tv w) $ by weaken [#13]
l21: $ G ⇒ cv ∊ ivals j u (intys td) (imot u (dnf u (mcv H)) td j w pp (lv tv w)) $ by weaken [l20]
l22: $ G ⇒ cv ∊ fseq u $ by and_elim_l [ivals_fseq [l21]]
l23: $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w pp cv $ by weaken [#14]
l24: $ G ⇒ mv ∊ ivals k u (inmin td) {y | ∃ i ∃ c (iminx td i c k ∧ y ∊ imin u (dnf u (mcv H)) td i c w pp cv ∧ ihasc td i c)} $ by weaken [l23]
l25: $ G ⇒ mv ∊ fseq u $ by and_elim_l [ivals_fseq [l24]]
l26: $ G ⇒ cv ++ pp ∈ fseq u $ by scat_fseq [l22, l5]
