lemma f21_inv_rtail {qA qB qB2 qmn qdmn qmi ql_v qX qI qX2: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7 t8: set): $ G ⇒ ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel $ > $ H , t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail t1 t2 t3 t4 t5 ⟨ kc_s , scons t6 ∅ ⟩ qB qB2 ∈ lrel ⇒ Cf $ > $ H , t7 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons qI (scons ⟨ kc_app , scons qX2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add t4 t3 qmn ∈ lrel ∧ ra_add t6 qmn qdmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons t1 (scons t5 ∅) ⟩ qdmn t2 qX ∈ lrel ∧ ra_pargs qX ⟨ kc_nz , ∅ ⟩ t6 qI ∈ lrel ∧ ra_add qmi t5 qdmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qmi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ t6 qX2 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ qA ∃ qB ∃ qB2 (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ qmn ∃ qdmn ∃ qmi ∃ ql_v ∃ qX ∃ qI ∃ qX2 (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons qI (scons ⟨ kc_app , scons qX2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add u z qmn ∈ lrel ∧ ra_add w qmn qdmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons x (scons v ∅) ⟩ qdmn y qX ∈ lrel ∧ ra_pargs qX ⟨ kc_nz , ∅ ⟩ w qI ∈ lrel ∧ ra_add qmi v qdmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qmi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w qX2 ∈ lrel) $ by lrel_rtail_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ qB = qB $ by eq_refl
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ qB2 = qB2 $ by eq_refl
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ ra_rtail t1 t2 t3 t4 t5 ⟨ kc_s , scons t6 ∅ ⟩ qB qB2 ∈ lrel $ by wcel_eq_l [ra_rtail_eq [eq_sym [and_elim_l [l3]], eq_sym [and_elim_l [and_elim_r [l3]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]], opair_eq [l5, scons_eq [eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]], l4]], l6, l7], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]]]
l9: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail t1 t2 t3 t4 t5 ⟨ kc_s , scons t6 ∅ ⟩ qB qB2 ∈ lrel $ by and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]], and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]], l8]]
l10: $ H ⇒ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail t1 t2 t3 t4 t5 ⟨ kc_s , scons t6 ∅ ⟩ qB qB2 ∈ lrel → Cf $ by imp_intro [#2]
l11: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail t1 t2 t3 t4 t5 ⟨ kc_s , scons t6 ∅ ⟩ qB qB2 ∈ lrel → Cf $ by weaken [l10]
l12: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel ⇒ Cf $ by imp_elim [l11, l9]
