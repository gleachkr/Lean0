l80: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ qmn ∃ qdmn ∃ qmi ∃ ql_v ∃ qX ∃ qI ∃ qX2 (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons qI (scons ⟨ kc_app , scons qX2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add u z qmn ∈ lrel ∧ ra_add w qmn qdmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons x (scons v ∅) ⟩ qdmn y qX ∈ lrel ∧ ra_pargs qX ⟨ kc_nz , ∅ ⟩ w qI ∈ lrel ∧ ra_add qmi v qdmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qmi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w qX2 ∈ lrel)) → Cf $ by imp_intro [l79]
l81: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ qA ∃ qB ∃ qB2 (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons qA (scons qB2 ∅) ⟩ ∧ ra_rtail x y z u v ⟨ kc_s , scons w ∅ ⟩ qB qB2 ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ qmn ∃ qdmn ∃ qmi ∃ ql_v ∃ qX ∃ qI ∃ qX2 (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons qI (scons ⟨ kc_app , scons qX2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add u z qmn ∈ lrel ∧ ra_add w qmn qdmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons x (scons v ∅) ⟩ qdmn y qX ∈ lrel ∧ ra_pargs qX ⟨ kc_nz , ∅ ⟩ w qI ∈ lrel ∧ ra_add qmi v qdmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qmi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w qX2 ∈ lrel)) → Cf $ by or_elim_imp [l31, l80]
l82: $ G , H ⇒ Cf $ by imp_elim [l81, l2]

def f29_ps_q (tX: set) (.y .d .n: set): class = $ {y | ∀ d ∀ n (ra_pargs tX d n y ∈ lrel → ra_spine tX y n ∈ lrel)} $

lemma f29_ps_e (G: hyps) (tX: set) (ty vd vn: set): $ G ⇒ ty ∊ f29_ps_q tX $ > $ G ⇒ ra_pargs tX vd vn ty ∈ lrel $ > $ G ⇒ ra_spine tX ty vn ∈ lrel $
----
l1: $ G ⇒ ∀ d ∀ n (ra_pargs tX d n ty ∈ lrel → ra_spine tX ty n ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ n (ra_pargs tX vd n ty ∈ lrel → ra_spine tX ty n ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ra_pargs tX vd vn ty ∈ lrel → ra_spine tX ty vn ∈ lrel $ by all_elim [l2]
l4: $ G ⇒ ra_spine tX ty vn ∈ lrel $ by imp_elim [l3, #2]

--| @freshen H qe_v
--| @freshen H qn_v
lemma f21_inv_pargs {qe_v qn_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_pargs t1 t2 t3 t4 ∈ lrel $ > $ H , t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 ⇒ Cf $ > $ H , t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons t2 ∅ ⟩ ∅) ⟩ ∧ ra_pargs t1 ⟨ kc_s , scons t2 ∅ ⟩ qn_v qe_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_pargs t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) ∨ ∃ x ∃ qe_v ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) $ by lrel_pargs_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ t4 = t1 $ by eq_trans [and_elim_r [and_elim_r [and_elim_r [l3]]], eq_sym [and_elim_l [l3]]]
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 $ by and_intro [and_elim_l [and_elim_r [and_elim_r [l3]]], l4]
l6: $ H ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = t1 → Cf $ by weaken [l6]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) ⇒ ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H , ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) ⇒ ∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) $ by ax
l12: $ … ⇒ Cf $ by ex_elim [l11, l10]
l13: $ G , H ⇒ (∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x)) → Cf $ by imp_intro [l12]
l14: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel $ by ax
l15: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l16: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ kc_bvar = kc_bvar $ by eq_refl
l17: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ qe_v = qe_v $ by eq_refl
l18: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ kc_app = kc_app $ by eq_refl
l19: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons t2 ∅ ⟩ ∅) ⟩ $ by eq_trans [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l14]]]], opair_eq [l18, scons_eq [l17, scons_eq [opair_eq [l16, scons_eq [eq_sym [and_elim_l [and_elim_r [l14]]], l15]], l15]]]]
l20: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l21: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ qn_v = qn_v $ by eq_refl
l22: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ ra_pargs t1 ⟨ kc_s , scons t2 ∅ ⟩ qn_v qe_v ∈ lrel $ by wcel_eq_l [ra_pargs_eq [eq_sym [and_elim_l [l14]], opair_eq [l20, scons_eq [eq_sym [and_elim_l [and_elim_r [l14]]], l15]], l21, l17], and_elim_r [and_elim_r [and_elim_r [and_elim_r [l14]]]]]
l23: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons t2 ∅ ⟩ ∅) ⟩ ∧ ra_pargs t1 ⟨ kc_s , scons t2 ∅ ⟩ qn_v qe_v ∈ lrel $ by and_intro [and_elim_l [and_elim_r [and_elim_r [l14]]], and_intro [l19, l22]]
l24: $ H ⇒ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons t2 ∅ ⟩ ∅) ⟩ ∧ ra_pargs t1 ⟨ kc_s , scons t2 ∅ ⟩ qn_v qe_v ∈ lrel → Cf $ by imp_intro [#3]
l25: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons t2 ∅ ⟩ ∅) ⟩ ∧ ra_pargs t1 ⟨ kc_s , scons t2 ∅ ⟩ qn_v qe_v ∈ lrel → Cf $ by weaken [l24]
l26: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel ⇒ Cf $ by imp_elim [l25, l23]
l27: $ G , H , ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) ⇒ ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) $ by ax
l28: $ … ⇒ Cf $ by ex_elim [l27, l26]
l29: $ G , H , ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) ⇒ ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) $ by ax
l30: $ … ⇒ Cf $ by ex_elim [l29, l28]
l31: $ G , H , ∃ qe_v ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) ⇒ ∃ qe_v ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) $ by ax
l32: $ … ⇒ Cf $ by ex_elim [l31, l30]
l33: $ G , H , ∃ x ∃ qe_v ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) ⇒ ∃ x ∃ qe_v ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel) $ by ax
l34: $ … ⇒ Cf $ by ex_elim [l33, l32]
l35: $ G , H ⇒ (∃ x ∃ qe_v ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel)) → Cf $ by imp_intro [l34]
l36: $ G , H ⇒ (∃ x ∃ y (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = x) ∨ ∃ x ∃ qe_v ∃ y ∃ qn_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons qe_v (scons ⟨ kc_bvar , scons y ∅ ⟩ ∅) ⟩ ∧ ra_pargs x ⟨ kc_s , scons y ∅ ⟩ qn_v qe_v ∈ lrel)) → Cf $ by or_elim_imp [l13, l35]
l37: $ G , H ⇒ Cf $ by imp_elim [l36, l2]

lemma f29_ps_n (G: hyps) (tX: set) (ty k1 j1 vd vn: set): $ G ⇒ crn j1 ⊆ f29_ps_q tX $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pargs tX vd vn ty ∈ lrel $ > $ G ⇒ ra_spine tX ty vn ∈ lrel $
----
l1: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX $ by ax
l2: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ ra_pargs tX vd vn ty ∈ lrel $ by weaken [#5]
l3: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ ⟨ kr_pargs , scons tX (scons vd (scons vn (scons ty ∅))) ⟩ ∈ latoms $ by lrel_latoms [l2]
l4: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ isset ∅ $ by ax_empty
l5: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ isset (scons ty ∅) $ by scons_set [l4]
l6: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ isset (scons vn (scons ty ∅)) $ by scons_set [l5]
l7: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ isset (scons vd (scons vn (scons ty ∅))) $ by scons_set [l6]
l8: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ isset (scons tX (scons vd (scons vn (scons ty ∅)))) $ by scons_set [l7]
l9: $ G , vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = tX ⇒ kr_pargs ∈ ω $ by kr_pargs_omega
