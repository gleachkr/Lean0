--| @freshen H qb_v
--| @freshen H qP
--| @freshen H qT
--| @freshen H qnp
--| @freshen H qF
--| @freshen H qK
lemma f21_inv_eta_ok {qb_v qP qT qnp qF qK: set} (G H: hyps) (Cf: fml) (t1 t2: set): $ G ⇒ ra_eta_ok t1 t2 ∈ lrel $ > $ H , ra_struct_like t1 t2 ∈ lrel ∧ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF ⟨ kc_ccons , scons qK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_nonrec qnp ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_eta_ok t1 t2 ∈ lrel $ by weaken [#1]
