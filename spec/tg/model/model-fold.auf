ind_rec_ty_rule
---------------
l1: $ G ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ tR0 tRT ∈ lrel $ by weaken [#6]
l2: $ G ⇒ tRT = tR0 $ by rst_nil_id [l1]
l3: $ G ⇒ iwf u H J tg td w r $ by weaken [#1]
l4: $ G ⇒ hctor ⊆ H $ by weaken [#2]
l5: $ G ⇒ hrec ⊆ H $ by weaken [#3]
l6: $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ by weaken [#4]
l7: $ G ⇒ ra_rec_ty td tv ti tR0 ∈ lrel $ by weaken [#5]
l8: $ G ⇒ tR0 ∊ ofsort lsig lopen ks_expr $ by weaken [#7]
l9: $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ by weaken [#8]
l10: $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ w r ∈ dt u (mcv H) tR0 w r $ by ind_rec_ty_wf [l3, l4, l5, l6, l7, l8, l9]
l11: $ G ⇒ u = u $ by eq_refl
l12: $ G ⇒ (mcv H) = (mcv H) $ by eq_refl
l13: $ G ⇒ w = w $ by eq_refl
l14: $ G ⇒ r = r $ by eq_refl
l15: $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ w r ∈ dt u (mcv H) tRT w r $ by wcel_eq_r [dt_eq [l11, l12, eq_sym [l2], l13, l14], l10]

ind_wf_tys
----------
z1: $ G ⇒ ra_tys_closed tp tt ∈ lrel ∧ ∃ l ∃ c (ra_tys_wf td tn tnp l ⟨ kc_nz , ∅ ⟩ c tt ∈ lrel3 J) $ by f26_data [#1, #2, #3, #4]
