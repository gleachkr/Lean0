l161: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s , x5 = v ++ s ⇒ ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by isset_elim [l160, l159]
l162: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s ⇒ v ∊ fseq u $ by weaken [l63]
