l282: $ G ⇒ esat u (dsh u M r) tm w = {l | l ∊ fseq u ∧ cdm l = L2 ∧ ∀ i (i ∊ N → J ⊆ i → vat (l ++ c0) N i ∈ imot u (dnf u M) td i w p V)} $ by eq_intro [l151, l281]

lemma f15_sl (G: hyps) (A B: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ nadd (suc A) B = nadd A (suc B) $
----
l1: $ G ⇒ nadd (suc A) B = nadd B (suc A) $ by nadd_comm_c [omega_suc_c [#1], #2]
l2: $ G ⇒ nadd B (suc A) = suc (nadd B A) $ by nadd_suc_c [wcel_isset [#2], #1]
l3: $ G ⇒ nadd A (suc B) = suc (nadd A B) $ by nadd_suc_c [wcel_isset [#1], #2]
l4: $ G ⇒ nadd (suc A) B = nadd A (suc B) $ by eq_trans [l1, eq_trans [l2, eq_trans [suc_eq [nadd_comm_c [#2, #1]], eq_sym [l3]]]]

lemma f15_lt (G: hyps) (J L N: class): $ G ⇒ J ∈ ω $ > $ G ⇒ L ∈ ω $ > $ G ⇒ nadd J (suc L) = N $ > $ G ⇒ J ∈ N $
----
l1: $ G , a = J , b = L ⇒ a = J $ by ax
l2: $ G , a = J , b = L ⇒ b = L $ by ax
l3: $ G , a = J , b = L ⇒ b ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l2], weaken [#2]]]
l4: $ G , a = J , b = L ⇒ a ∊ nadd a (suc b) $ by nadd_lt_suc [l3]
l5: $ G , a = J , b = L ⇒ J ∈ N $ by wcel_eq_l [l1, wcel_eq_r [eq_trans [nadd_eq [l1, suc_eq [l2]], weaken [#3]], welc_wcel [l4]]]
l6: $ G , a = J ⇒ isset L $ by wcel_isset [weaken [#2]]
l7: $ G , a = J ⇒ J ∈ N $ by isset_elim [l6, l5]
l8: $ G ⇒ isset J $ by wcel_isset [weaken [#1]]
l9: $ G ⇒ J ∈ N $ by isset_elim [l8, l7]

