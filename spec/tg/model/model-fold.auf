l207: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel , v ∊ fseq {y | y = y} ∧ cdm v = nvf' d ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' d → v' m = (dt u M te w r)' (suc i)) ∧ dt u M c w r = apn (dt u M tY w r) v , x = dt u M ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ w r , o = scons x v , n = nvf' d ⇒ w = w $ by eq_refl
l208: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel , v ∊ fseq {y | y = y} ∧ cdm v = nvf' d ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' d → v' m = (dt u M te w r)' (suc i)) ∧ dt u M c w r = apn (dt u M tY w r) v , x = dt u M ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ w r , o = scons x v , n = nvf' d ⇒ r = r $ by eq_refl
