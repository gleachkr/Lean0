l10: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add a y qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_lift qmn a qA qA3 ∈ lrel ∧ ra_rwalk x y z u v w ⟨ kc_s , scons a ∅ ⟩ b qB qVal ∈ lrel ⇒ ra_lift qmn t7 qA qA3 ∈ lrel $ by wcel_eq_l [ra_lift_eq [l6, eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]], l8, l9], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]]]]]]]]]
