l124: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons g ∅) ⟩ ∧ ra_capp p x1 g ∈ lrel , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l125: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons g ∅) ⟩ ∧ ra_capp p x1 g ∈ lrel , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l126: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons g ∅) ⟩ ∧ ra_capp p x1 g ∈ lrel , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ⟨ kc_s , scons ⟨ kc_s , scons k ∅ ⟩ ∅ ⟩ = ⟨ kc_s , scons vn ∅ ⟩ $ by opair_eq [l124, scons_eq [eq_sym [and_elim_l [and_elim_r [l64]]], l125]]
l127: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons g ∅) ⟩ ∧ ra_capp p x1 g ∈ lrel , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [l123], l126], l122]
l128: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons g ∅) ⟩ ∧ ra_capp p x1 g ∈ lrel ⇒ ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $ by f21_inv_clen [l50, l63, l127]
l129: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ⇒ ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $ by f21_inv_capp [l4, l46, l128]
l130: $ G ⇒ isset ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ $ by opair_isset
l131: $ G ⇒ ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $ by isset_elim [l130, l129]

lemma f29_c1_all (G: hyps) (ta: set): $ G ⇒ trees ω ⊆ f29_c1_q ta $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ , ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel , ra_clen y n ∈ lrel ⇒ crn x9 ⊆ f29_c1_q ta $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ , ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel , ra_clen y n ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ , ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel , ra_clen y n ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ , ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel , ra_clen y n ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ , ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel , ra_clen y n ∈ lrel ⇒ ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ , ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel , ra_clen y n ∈ lrel ⇒ ra_clen y n ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ , ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel , ra_clen y n ∈ lrel ⇒ ra_clen r ⟨ kc_s , scons n ∅ ⟩ ∈ lrel $ by f29_c1_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ , ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel ⇒ ra_clen y n ∈ lrel → ra_clen r ⟨ kc_s , scons n ∅ ⟩ ∈ lrel $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel → ra_clen y n ∈ lrel → ra_clen r ⟨ kc_s , scons n ∅ ⟩ ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n (ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel → ra_clen y n ∈ lrel → ra_clen r ⟨ kc_s , scons n ∅ ⟩ ∈ lrel) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ∀ r ∀ n (ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel → ra_clen y n ∈ lrel → ra_clen r ⟨ kc_s , scons n ∅ ⟩ ∈ lrel) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_c1_q ta $ by cab_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_c1_q ta $ by wcel_intro [l13, l12]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_c1_q ta ⇒ ⟨ x8 , x9 ⟩ ∈ f29_c1_q ta $ by isset_elim [l15, l14]
l17: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_c1_q ta → ⟨ x8 , x9 ⟩ ∈ f29_c1_q ta $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_c1_q ta → ⟨ x8 , x9 ⟩ ∈ f29_c1_q ta) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ f29_c1_q ta $ by trees_ind_c [l19, l18]

clen_capp1
----------
l1: $ G ⇒ ⟨ kr_clen , scons tp (scons tn ∅) ⟩ ∈ latoms $ by lrel_latoms [#2]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tn ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tp (scons tn ∅)) $ by scons_set [l3]
l5: $ G ⇒ kr_clen ∈ ω $ by kr_clen_omega
l6: $ G ⇒ kr_clen ∈ ω ∧ scons tp (scons tn ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l5], l4]
l7: $ G ⇒ crn (scons tp (scons tn ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l6]]
l8: $ G ⇒ isset ω $ by omega_set
l9: $ G ⇒ tp ∈ trees ω $ by crn_scons_head_trees [l8, l7]
l10: $ G ⇒ trees ω ⊆ f29_c1_q ta $ by f29_c1_all
l11: $ G ⇒ tp ∊ f29_c1_q ta $ by subset_elim [l10, wcel_welc [l9]]
l12: $ G ⇒ ra_clen tr ⟨ kc_s , scons tn ∅ ⟩ ∈ lrel $ by f29_c1_e [l11, #1, #2]

def f29_ce_q (tg tb: set) (.y .a .r .c: set): class = $ {y | ∀ a (ra_clen tg tb ∈ lrel → ra_clen y a ∈ lrel → ∃ r ∃ c (ra_capp y tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb a c ∈ lrel))} $

--| @freshen G r
--| @freshen G c
lemma f29_ce_e {r c: set} (G: hyps) (tg tb: set) (ty va: set): $ G ⇒ ty ∊ f29_ce_q tg tb $ > $ G ⇒ ra_clen tg tb ∈ lrel $ > $ G ⇒ ra_clen ty va ∈ lrel $ > $ G ⇒ ∃ r ∃ c (ra_capp ty tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb va c ∈ lrel) $
----
l1: $ G ⇒ ∀ a (ra_clen tg tb ∈ lrel → ra_clen ty a ∈ lrel → ∃ r ∃ c (ra_capp ty tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb a c ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ra_clen tg tb ∈ lrel → ra_clen ty va ∈ lrel → ∃ r ∃ c (ra_capp ty tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb va c ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ra_clen ty va ∈ lrel → ∃ r ∃ c (ra_capp ty tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb va c ∈ lrel) $ by imp_elim [l2, #2]
l4: $ G ⇒ ∃ r ∃ c (ra_capp ty tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb va c ∈ lrel) $ by imp_elim [l3, #3]

--| @freshen G r
--| @freshen G c
lemma f29_ce_n {r c: set} (G: hyps) (tg tb: set) (ty k1 j1 va: set): $ G ⇒ crn j1 ⊆ f29_ce_q tg tb $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_clen tg tb ∈ lrel $ > $ G ⇒ ra_clen ty va ∈ lrel $ > $ G ⇒ ∃ r ∃ c (ra_capp ty tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb va c ∈ lrel) $
----
l1: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ $ by ax
