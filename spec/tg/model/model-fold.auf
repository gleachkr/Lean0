universe_cdm_c
--------------
l1: $ G , x = A , x ∊ U ⇒ x = A $ by ax
l2: $ G , x = A , x ∊ U ⇒ universe U $ by weaken [#1]
l3: $ G , x = A , x ∊ U ⇒ x ∊ U $ by ax
l4: $ G , x = A , x ∊ U ⇒ cdm A ∈ U $ by wcel_eq_l [cdm_eq [l1], universe_cdm [l2, l3]]
l5: $ G ⇒ cdm A ∈ U $ by wcel_elim [#2, l4]

cdm_intro_c
-----------
l1: $ G , x = B ⇒ x = B $ by ax
l2: $ G , x = B ⇒ a = a $ by eq_refl
l3: $ G , x = B ⇒ ⟨ a , B ⟩ ∈ R $ by weaken [#1]
l4: $ G , x = B ⇒ ⟨ a , x ⟩ ∈ R $ by wcel_eq_l [opair_eq [l2, eq_sym [l1]], l3]
l5: $ G , x = B ⇒ a ∊ cdm R $ by cdm_intro [l4]
l6: $ G ⇒ a ∊ cdm R $ by isset_elim [#2, l5]

nest_scat_c
-----------
l1: $ G , x = S , x ∊ fseq A ⇒ T ∈ fseq A $ by weaken [#2]
l2: $ G , x = S , x ∊ fseq A , z = T , z ∊ fseq A ⇒ x = S $ by ax
l3: $ G , x = S , x ∊ fseq A , z = T , z ∊ fseq A ⇒ z = T $ by ax
l4: $ G , x = S , x ∊ fseq A , z = T , z ∊ fseq A ⇒ x ∊ fseq A $ by ax
l5: $ G , x = S , x ∊ fseq A , z = T , z ∊ fseq A ⇒ z ∊ fseq A $ by ax
l6: $ G , x = S , x ∊ fseq A , z = T , z ∊ fseq A ⇒ nest (x ++ z) Y = nest z (nest x Y) $ by nest_scat [l4, l5, weaken [#3]]
l7: $ G , x = S , x ∊ fseq A , z = T , z ∊ fseq A ⇒ Y = Y $ by eq_refl
l8: $ G , x = S , x ∊ fseq A , z = T , z ∊ fseq A ⇒ nest (S ++ T) Y = nest T (nest S Y) $ by eq_trans [nest_eq [scat_eq [eq_sym [l2], eq_sym [l3]], l7], eq_trans [l6, nest_eq [l3, nest_eq [l2, l7]]]]
l9: $ G , x = S , x ∊ fseq A ⇒ nest (S ++ T) Y = nest T (nest S Y) $ by wcel_elim [l1, l8]
l10: $ G ⇒ nest (S ++ T) Y = nest T (nest S Y) $ by wcel_elim [#1, l9]

apn_universe_c
--------------
l1: $ G , v = V , v ∊ U ⇒ S ∈ fseq A $ by weaken [#3]
l2: $ G , v = V , v ∊ U , x = S , x ∊ fseq A ⇒ universe U $ by weaken [#1]
l3: $ G , v = V , v ∊ U , x = S , x ∊ fseq A ⇒ v ∊ U $ by ax
l4: $ G , v = V , v ∊ U , x = S , x ∊ fseq A ⇒ x ∊ fseq A $ by ax
l5: $ G , v = V , v ∊ U , x = S , x ∊ fseq A ⇒ apn v x ∈ U $ by apn_universe [l2, l3, l4]
l6: $ G , v = V , v ∊ U , x = S , x ∊ fseq A ⇒ v = V $ by ax
l7: $ G , v = V , v ∊ U , x = S , x ∊ fseq A ⇒ x = S $ by ax
l8: $ G , v = V , v ∊ U , x = S , x ∊ fseq A ⇒ apn V S ∈ U $ by wcel_eq_l [apn_eq [l6, l7], l5]
l9: $ G , v = V , v ∊ U ⇒ apn V S ∈ U $ by wcel_elim [l1, l8]
l10: $ G ⇒ apn V S ∈ U $ by wcel_elim [#2, l9]

def f44_cc_q  (.y .b .t: set): class = $ {y | ∀ b ∀ t (ra_capp y b t ∈ lrel → y ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_ctx → t ∊ ofsort lsig lopen ks_ctx)} $

lemma f44_cc_e (G: hyps)  (ty vb vt: set): $ G ⇒ ty ∊ f44_cc_q  $ > $ G ⇒ ra_capp ty vb vt ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vb ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vt ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G ⇒ ∀ b ∀ t (ra_capp ty b t ∈ lrel → ty ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_ctx → t ∊ ofsort lsig lopen ks_ctx) $ by cab_elim [#1]
l2: $ G ⇒ ∀ t (ra_capp ty vb t ∈ lrel → ty ∊ ofsort lsig lopen ks_ctx → vb ∊ ofsort lsig lopen ks_ctx → t ∊ ofsort lsig lopen ks_ctx) $ by all_elim [l1]
l3: $ G ⇒ ra_capp ty vb vt ∈ lrel → ty ∊ ofsort lsig lopen ks_ctx → vb ∊ ofsort lsig lopen ks_ctx → vt ∊ ofsort lsig lopen ks_ctx $ by all_elim [l2]
l4: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx → vb ∊ ofsort lsig lopen ks_ctx → vt ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l3, #2]
l5: $ G ⇒ vb ∊ ofsort lsig lopen ks_ctx → vt ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l4, #3]
l6: $ G ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l5, #4]

lemma f44_cc_n (G: hyps)  (ty k1 j1 vb vt: set): $ G ⇒ crn j1 ⊆ f44_cc_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_capp ty vb vt ∈ lrel $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vb ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ vt ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G ⇒ ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) ∨ ∃ a ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by lrel_capp_cases [#5]
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x $ by ax
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ vb ∊ ofsort lsig lopen ks_ctx $ by weaken [#7]
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_trans [and_elim_l [and_elim_r [l2]], eq_sym [and_elim_r [and_elim_r [l2]]]], welc_wcel [l3]]]
l5: $ G , ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) ⇒ ∃ x (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = x ∧ vt = x) $ by ax
l6: $ … ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l5, l4]
l7: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel $ by ax
l8: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l9: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ isset ∅ $ by ax_empty
l10: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ crn (scons a (scons p ∅)) ⊆ f44_cc_q  $ by node_crn_sub [weaken [#1], weaken [#2], and_elim_l [l7], wcel_isset [l8], scons_set [scons_set [l9]]]
l11: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ isset p $ by isset_var
l12: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ p ∈ f44_cc_q  $ by crn_scons_head [l11, crn_scons_tail [l10]]
l13: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by weaken [#6]
l14: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by ofsort_cons_kids [wcel_eq_l [and_elim_l [l7], welc_wcel [l13]]]
l15: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ p = p $ by eq_refl
l16: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ z = z $ by eq_refl
l17: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ ra_capp p vb z ∈ lrel $ by wcel_eq_l [ra_capp_eq [l15, eq_sym [and_elim_l [and_elim_r [l7]]], l16], and_elim_r [and_elim_r [and_elim_r [l7]]]]
l18: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ vb ∊ ofsort lsig lopen ks_ctx $ by weaken [#7]
l19: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ z ∊ ofsort lsig lopen ks_ctx $ by f44_cc_e [wcel_welc [l12], l17, and_elim_r [l14], l18]
l20: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [and_elim_l [and_elim_r [and_elim_r [l7]]]], ofsort_ctx_cons [welc_wcel [and_elim_l [l14]], welc_wcel [l19]]]]
l21: $ G , ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) ⇒ ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by ax
l22: $ … ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l21, l20]
l23: $ G , ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) ⇒ ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by ax
l24: $ … ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l23, l22]
l25: $ G , ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) ⇒ ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by ax
l26: $ … ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l25, l24]
l27: $ G , ∃ a ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) ⇒ ∃ a ∃ p ∃ x ∃ z (ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = x ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p x z ∈ lrel) $ by ax
l28: $ … ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by ex_elim [l27, l26]
l29: $ G ⇒ vt ∊ ofsort lsig lopen ks_ctx $ by or_elim [l1, l6, l28]

lemma f44_cc_all (G: hyps) : $ G ⇒ trees ω ⊆ f44_cc_q  $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx , b ∊ ofsort lsig lopen ks_ctx ⇒ crn j ⊆ f44_cc_q  $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx , b ∊ ofsort lsig lopen ks_ctx ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx , b ∊ ofsort lsig lopen ks_ctx ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx , b ∊ ofsort lsig lopen ks_ctx ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx , b ∊ ofsort lsig lopen ks_ctx ⇒ ra_capp y b t ∈ lrel $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx , b ∊ ofsort lsig lopen ks_ctx ⇒ y ∊ ofsort lsig lopen ks_ctx $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx , b ∊ ofsort lsig lopen ks_ctx ⇒ b ∊ ofsort lsig lopen ks_ctx $ by ax
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx , b ∊ ofsort lsig lopen ks_ctx ⇒ t ∊ ofsort lsig lopen ks_ctx $ by f44_cc_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel , y ∊ ofsort lsig lopen ks_ctx ⇒ b ∊ ofsort lsig lopen ks_ctx → t ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ , ra_capp y b t ∈ lrel ⇒ y ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_ctx → t ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ ⇒ ra_capp y b t ∈ lrel → y ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_ctx → t ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ ⇒ ∀ t (ra_capp y b t ∈ lrel → y ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_ctx → t ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ ⇒ ∀ b ∀ t (ra_capp y b t ∈ lrel → y ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_ctx → t ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ ⇒ y ∊ f44_cc_q  $ by cab_intro [l13]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f44_cc_q  $ by wcel_intro [l15, l14]
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l18: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f44_cc_q  ⇒ ⟨ i , j ⟩ ∈ f44_cc_q  $ by isset_elim [l17, l16]
l19: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f44_cc_q  → ⟨ i , j ⟩ ∈ f44_cc_q  $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f44_cc_q  → ⟨ i , j ⟩ ∈ f44_cc_q ) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ f44_cc_q  $ by trees_ind_c [l21, l20]

capp_ctx
--------
l1: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l2: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, wcel_isset [l1]]
l3: $ G ⇒ trees ω ⊆ f44_cc_q  $ by f44_cc_all
l4: $ G ⇒ t1 ∊ f44_cc_q  $ by subset_elim [l3, and_elim_l [l2]]
l5: $ G ⇒ t3 ∊ ofsort lsig lopen ks_ctx $ by f44_cc_e [l4, #1, #2, #3]

def f44_fs (R U: class) (.g: set): class = $ {g | g ∊ cdm R ∧ g ∊ fseq U} $

def f44_dd (Y C F P: class) (.e .x .y: set): class = $ {e | ∃ x ∃ y (x ∊ apn Y (F ++ P) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} $

def f44_mp (R U Y C P: class) (.n .f .d: set): class = $ {n | ∃ f ∃ d (f ∊ f44_fs R U ∧ d ∊ f44_dd Y C f P ∧ n = nest f d)} $

def f44_ma (U E F W Y C A: class) (.m .p .v: set): class = $ {m | ∃ p ∃ v (p ∊ A ∧ v ∊ f44_mp (etel U E F W p) U Y C p ∧ m = v)} $

def f44_tt (S M: class) (.z .q .k: set): class = $ {z | ∃ q ∃ k (q ∊ S ∧ k ∊ M ∧ z = nest q k)} $

lemma f44_fs_u (G: hyps) (R U: class): $ G ⇒ universe U $ > $ G ⇒ R ∈ U $ > $ G ⇒ f44_fs R U ∈ U $
----
l1: $ G , x ∊ f44_fs R U ⇒ x ∊ f44_fs R U $ by ax
l2: $ G , x ∊ f44_fs R U ⇒ x ∊ cdm R ∧ x ∊ fseq U $ by cab_elim [l1]
l3: $ G , x ∊ f44_fs R U ⇒ x ∊ cdm R $ by and_elim_l [l2]
l4: $ G ⇒ f44_fs R U ⊆ cdm R $ by subset_intro [l3]
l5: $ G ⇒ f44_fs R U ∈ U $ by universe_subset_c [#1, universe_cdm_c [#1, #2], l4]

lemma f44_fs_i (G: hyps) (R U: class) (a: set): $ G ⇒ a ∊ cdm R $ > $ G ⇒ a ∊ fseq U $ > $ G ⇒ a ∊ f44_fs R U $
----
l1: $ G ⇒ a ∊ f44_fs R U $ by cab_intro [and_intro [#1, #2]]

lemma f44_fs_e (G: hyps) (R U: class) (a: set): $ G ⇒ a ∊ f44_fs R U $ > $ G ⇒ a ∊ fseq U $
----
l1: $ G ⇒ a ∊ cdm R ∧ a ∊ fseq U $ by cab_elim [#1]
l2: $ G ⇒ a ∊ fseq U $ by and_elim_r [l1]

lemma f44_dd_u (G: hyps) (U Y C F P: class): $ G ⇒ universe U $ > $ G ⇒ apn Y (F ++ P) ∈ U $ > $ G ⇒ C ∈ U $ > $ G ⇒ f44_dd Y C F P ∈ U $
----
l1: $ G , x ∊ apn Y (F ++ P) ⇒ C ∈ U $ by weaken [#3]
l2: $ G ⇒ x ∊ apn Y (F ++ P) → C ∈ U $ by imp_intro [l1]
l3: $ G ⇒ ∀ x (x ∊ apn Y (F ++ P) → C ∈ U) $ by all_intro [l2]
l4: $ G , x ∊ apn Y (F ++ P) , y ∊ C ⇒ universe U $ by weaken [#1]
l5: $ G , x ∊ apn Y (F ++ P) , y ∊ C ⇒ apn Y (F ++ P) ∈ U $ by weaken [#2]
l6: $ G , x ∊ apn Y (F ++ P) , y ∊ C ⇒ x ∊ apn Y (F ++ P) $ by ax
l7: $ G , x ∊ apn Y (F ++ P) , y ∊ C ⇒ x ∊ U $ by wcel_welc [universe_elem_elem_c [l4, l5, welc_wcel [l6]]]
l8: $ G , x ∊ apn Y (F ++ P) , y ∊ C ⇒ C ∈ U $ by weaken [#3]
l9: $ G , x ∊ apn Y (F ++ P) , y ∊ C ⇒ y ∊ C $ by ax
l10: $ G , x ∊ apn Y (F ++ P) , y ∊ C ⇒ y ∊ U $ by wcel_welc [universe_elem_elem_c [l4, l8, welc_wcel [l9]]]
l11: $ G , x ∊ apn Y (F ++ P) , y ∊ C ⇒ ⟨ x , y ⟩ ∈ U $ by universe_opair [l4, l7, l10]
l12: $ G , x ∊ apn Y (F ++ P) ⇒ y ∊ C → ⟨ x , y ⟩ ∈ U $ by imp_intro [l11]
l13: $ G ⇒ x ∊ apn Y (F ++ P) → y ∊ C → ⟨ x , y ⟩ ∈ U $ by imp_intro [l12]
l14: $ G ⇒ ∀ y (x ∊ apn Y (F ++ P) → y ∊ C → ⟨ x , y ⟩ ∈ U) $ by all_intro [l13]
l15: $ G ⇒ ∀ x ∀ y (x ∊ apn Y (F ++ P) → y ∊ C → ⟨ x , y ⟩ ∈ U) $ by all_intro [l14]
l16: $ G ⇒ f44_dd Y C F P ∈ U $ by universe_repl2 [#1, #2, l3, l15]

lemma f44_dd_i (G: hyps) (Y C F P: class) (a b: set): $ G ⇒ a ∊ apn Y (F ++ P) $ > $ G ⇒ b ∊ C $ > $ G ⇒ ⟨ a , b ⟩ ∈ f44_dd Y C F P $
----
l1: $ G , h = ⟨ a , b ⟩ ⇒ h = ⟨ a , b ⟩ $ by ax
l2: $ G , h = ⟨ a , b ⟩ ⇒ a ∊ apn Y (F ++ P) ∧ b ∊ C ∧ h = ⟨ a , b ⟩ $ by and_intro [weaken [#1], and_intro [weaken [#2], l1]]
l3: $ G , h = ⟨ a , b ⟩ ⇒ ∃ y (a ∊ apn Y (F ++ P) ∧ y ∊ C ∧ h = ⟨ a , y ⟩) $ by ex_intro [l2]
l4: $ G , h = ⟨ a , b ⟩ ⇒ ∃ x ∃ y (x ∊ apn Y (F ++ P) ∧ y ∊ C ∧ h = ⟨ x , y ⟩) $ by ex_intro [l3]
l5: $ G , h = ⟨ a , b ⟩ ⇒ h ∊ f44_dd Y C F P $ by cab_intro [l4]
l6: $ G , h = ⟨ a , b ⟩ ⇒ ⟨ a , b ⟩ ∈ f44_dd Y C F P $ by wcel_intro [l1, l5]
l7: $ G ⇒ isset ⟨ a , b ⟩ $ by opair_isset
l8: $ G ⇒ ⟨ a , b ⟩ ∈ f44_dd Y C F P $ by isset_elim [l7, l6]

lemma f44_mp_u (G: hyps) (R U Y C P: class): $ G ⇒ universe U $ > $ G ⇒ R ∈ U $ > $ G ⇒ Y ∈ U $ > $ G ⇒ C ∈ U $ > $ G ⇒ P ∈ fseq U $ > $ G ⇒ f44_mp R U Y C P ∈ U $
----
l1: $ G , f ∊ f44_fs R U ⇒ universe U $ by weaken [#1]
l2: $ G , f ∊ f44_fs R U ⇒ f ∊ f44_fs R U $ by ax
l3: $ G , f ∊ f44_fs R U ⇒ f ∊ fseq U $ by f44_fs_e [l2]
l4: $ G , f ∊ f44_fs R U ⇒ f ++ P ∈ fseq U $ by scat_fseq_c [welc_wcel [l3], weaken [#5]]
l5: $ G , f ∊ f44_fs R U ⇒ apn Y (f ++ P) ∈ U $ by apn_universe_c [l1, weaken [#3], l4]
l6: $ G , f ∊ f44_fs R U ⇒ f44_dd Y C f P ∈ U $ by f44_dd_u [l1, l5, weaken [#4]]
l7: $ G ⇒ f ∊ f44_fs R U → f44_dd Y C f P ∈ U $ by imp_intro [l6]
l8: $ G ⇒ ∀ f (f ∊ f44_fs R U → f44_dd Y C f P ∈ U) $ by all_intro [l7]
l9: $ G , f ∊ f44_fs R U , d ∊ f44_dd Y C f P ⇒ universe U $ by weaken [#1]
l10: $ G , f ∊ f44_fs R U , d ∊ f44_dd Y C f P ⇒ f ∊ fseq U $ by weaken [l3]
l11: $ G , f ∊ f44_fs R U , d ∊ f44_dd Y C f P ⇒ f44_dd Y C f P ∈ U $ by weaken [l6]
l12: $ G , f ∊ f44_fs R U , d ∊ f44_dd Y C f P ⇒ d ∊ f44_dd Y C f P $ by ax
l13: $ G , f ∊ f44_fs R U , d ∊ f44_dd Y C f P ⇒ d ∊ U $ by wcel_welc [universe_elem_elem_c [l9, l11, welc_wcel [l12]]]
l14: $ G , f ∊ f44_fs R U , d ∊ f44_dd Y C f P ⇒ nest f d ∈ U $ by nest_universe [l9, l10, l13]
l15: $ G , f ∊ f44_fs R U ⇒ d ∊ f44_dd Y C f P → nest f d ∈ U $ by imp_intro [l14]
l16: $ G ⇒ f ∊ f44_fs R U → d ∊ f44_dd Y C f P → nest f d ∈ U $ by imp_intro [l15]
l17: $ G ⇒ ∀ d (f ∊ f44_fs R U → d ∊ f44_dd Y C f P → nest f d ∈ U) $ by all_intro [l16]
l18: $ G ⇒ ∀ f ∀ d (f ∊ f44_fs R U → d ∊ f44_dd Y C f P → nest f d ∈ U) $ by all_intro [l17]
l19: $ G ⇒ f44_mp R U Y C P ∈ U $ by universe_repl2 [#1, f44_fs_u [#1, #2], l8, l18]

lemma f44_mp_i (G: hyps) (R U Y C P D: class) (a: set): $ G ⇒ a ∊ f44_fs R U $ > $ G ⇒ D ∈ f44_dd Y C a P $ > $ G ⇒ nest a D ∈ f44_mp R U Y C P $
----
l1: $ G , b = D , b ∊ f44_dd Y C a P , h = nest a b ⇒ h = nest a b $ by ax
l2: $ G , b = D , b ∊ f44_dd Y C a P , h = nest a b ⇒ b ∊ f44_dd Y C a P $ by ax
l3: $ G , b = D , b ∊ f44_dd Y C a P , h = nest a b ⇒ b ∊ {e | ∃ x ∃ y (x ∊ apn Y (a ++ P) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} $ by weaken [l2]
l4: $ G , b = D , b ∊ f44_dd Y C a P , h = nest a b ⇒ a ∊ f44_fs R U ∧ b ∊ {e | ∃ x ∃ y (x ∊ apn Y (a ++ P) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} ∧ h = nest a b $ by and_intro [weaken [#1], and_intro [l3, l1]]
l5: $ G , b = D , b ∊ f44_dd Y C a P , h = nest a b ⇒ ∃ d (a ∊ f44_fs R U ∧ d ∊ {e | ∃ x ∃ y (x ∊ apn Y (a ++ P) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} ∧ h = nest a d) $ by ex_intro [l4]
l6: $ G , b = D , b ∊ f44_dd Y C a P , h = nest a b ⇒ ∃ f ∃ d (f ∊ f44_fs R U ∧ d ∊ {e | ∃ x ∃ y (x ∊ apn Y (f ++ P) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} ∧ h = nest f d) $ by ex_intro [l5]
l7: $ G , b = D , b ∊ f44_dd Y C a P , h = nest a b ⇒ h ∊ f44_mp R U Y C P $ by cab_intro [l6]
l8: $ G , b = D , b ∊ f44_dd Y C a P , h = nest a b ⇒ nest a b ∈ f44_mp R U Y C P $ by wcel_intro [l1, l7]
l9: $ G , b = D , b ∊ f44_dd Y C a P ⇒ isset (nest a b) $ by nest_set
l10: $ G , b = D , b ∊ f44_dd Y C a P ⇒ nest a b ∈ f44_mp R U Y C P $ by isset_elim [l9, l8]
l11: $ G , b = D , b ∊ f44_dd Y C a P ⇒ a = a $ by eq_refl
l12: $ G , b = D , b ∊ f44_dd Y C a P ⇒ b = D $ by ax
l13: $ G , b = D , b ∊ f44_dd Y C a P ⇒ nest a D ∈ f44_mp R U Y C P $ by wcel_eq_l [nest_eq [l11, l12], l10]
l14: $ G ⇒ nest a D ∈ f44_mp R U Y C P $ by wcel_elim [#2, l13]

--| @freshen G p
lemma f44_ma_u {p: set} (G: hyps) (U E F W Y C A: class): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ A ⊆ fseq U $ > $ G ⇒ Y ∈ U $ > $ G ⇒ C ∈ U $ > $ G ⇒ ∀ p (p ∊ A → etel U E F W p ∈ U) $ > $ G ⇒ f44_ma U E F W Y C A ∈ U $
----
l1: $ G , p ∊ A ⇒ universe U $ by weaken [#1]
l2: $ G , p ∊ A ⇒ ∀ p (p ∊ A → etel U E F W p ∈ U) $ by weaken [#6]
l3: $ G , p ∊ A ⇒ p ∊ A → etel U E F W p ∈ U $ by all_elim [l2]
l4: $ G , p ∊ A ⇒ p ∊ A $ by ax
l5: $ G , p ∊ A ⇒ etel U E F W p ∈ U $ by imp_elim [l3, l4]
l6: $ G , p ∊ A ⇒ A ⊆ fseq U $ by weaken [#3]
l7: $ G , p ∊ A ⇒ p ∊ A $ by ax
l8: $ G , p ∊ A ⇒ p ∈ fseq U $ by welc_wcel [subset_elim [l6, l7]]
l9: $ G , p ∊ A ⇒ f44_mp (etel U E F W p) U Y C p ∈ U $ by f44_mp_u [l1, l5, weaken [#4], weaken [#5], l8]
l10: $ G ⇒ p ∊ A → f44_mp (etel U E F W p) U Y C p ∈ U $ by imp_intro [l9]
l11: $ G ⇒ ∀ p (p ∊ A → f44_mp (etel U E F W p) U Y C p ∈ U) $ by all_intro [l10]
l12: $ G , p ∊ A , v ∊ f44_mp (etel U E F W p) U Y C p ⇒ universe U $ by weaken [#1]
l13: $ G , p ∊ A , v ∊ f44_mp (etel U E F W p) U Y C p ⇒ f44_mp (etel U E F W p) U Y C p ∈ U $ by weaken [l9]
l14: $ G , p ∊ A , v ∊ f44_mp (etel U E F W p) U Y C p ⇒ v ∊ f44_mp (etel U E F W p) U Y C p $ by ax
l15: $ G , p ∊ A , v ∊ f44_mp (etel U E F W p) U Y C p ⇒ v ∈ U $ by universe_elem_elem_c [l12, l13, welc_wcel [l14]]
l16: $ G , p ∊ A ⇒ v ∊ f44_mp (etel U E F W p) U Y C p → v ∈ U $ by imp_intro [l15]
l17: $ G ⇒ p ∊ A → v ∊ f44_mp (etel U E F W p) U Y C p → v ∈ U $ by imp_intro [l16]
l18: $ G ⇒ ∀ v (p ∊ A → v ∊ f44_mp (etel U E F W p) U Y C p → v ∈ U) $ by all_intro [l17]
l19: $ G ⇒ ∀ p ∀ v (p ∊ A → v ∊ f44_mp (etel U E F W p) U Y C p → v ∈ U) $ by all_intro [l18]
l20: $ G ⇒ f44_ma U E F W Y C A ∈ U $ by universe_repl2 [#1, #2, l11, l19]

lemma f44_ma_i (G: hyps) (U E F W Y C A V: class) (a: set): $ G ⇒ a ∊ A $ > $ G ⇒ V ∈ f44_mp (etel U E F W a) U Y C a $ > $ G ⇒ V ∈ f44_ma U E F W Y C A $
----
l1: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ b ∊ f44_mp (etel U E F W a) U Y C a $ by ax
l2: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ b ∊ {n | ∃ f ∃ d (f ∊ {g | g ∊ cdm (etel U E F W a) ∧ g ∊ fseq U} ∧ d ∊ {e | ∃ x ∃ y (x ∊ apn Y (f ++ a) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} ∧ n = nest f d)} $ by weaken [l1]
l3: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ b = b $ by eq_refl
l4: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ a ∊ A ∧ b ∊ {n | ∃ f ∃ d (f ∊ {g | g ∊ cdm (etel U E F W a) ∧ g ∊ fseq U} ∧ d ∊ {e | ∃ x ∃ y (x ∊ apn Y (f ++ a) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} ∧ n = nest f d)} ∧ b = b $ by and_intro [weaken [#1], and_intro [l2, l3]]
l5: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ ∃ v (a ∊ A ∧ v ∊ {n | ∃ f ∃ d (f ∊ {g | g ∊ cdm (etel U E F W a) ∧ g ∊ fseq U} ∧ d ∊ {e | ∃ x ∃ y (x ∊ apn Y (f ++ a) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} ∧ n = nest f d)} ∧ b = v) $ by ex_intro [l4]
l6: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ ∃ p ∃ v (p ∊ A ∧ v ∊ {n | ∃ f ∃ d (f ∊ {g | g ∊ cdm (etel U E F W p) ∧ g ∊ fseq U} ∧ d ∊ {e | ∃ x ∃ y (x ∊ apn Y (f ++ p) ∧ y ∊ C ∧ e = ⟨ x , y ⟩)} ∧ n = nest f d)} ∧ b = v) $ by ex_intro [l5]
l7: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ b ∊ f44_ma U E F W Y C A $ by cab_intro [l6]
l8: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ b = V $ by ax
l9: $ G , b = V , b ∊ f44_mp (etel U E F W a) U Y C a ⇒ V ∈ f44_ma U E F W Y C A $ by wcel_intro [l8, l7]
l10: $ G ⇒ V ∈ f44_ma U E F W Y C A $ by wcel_elim [#2, l9]

lemma f44_tt_u (G: hyps) (U S M: class): $ G ⇒ universe U $ > $ G ⇒ S ∈ U $ > $ G ⇒ S ⊆ fseq U $ > $ G ⇒ M ∈ U $ > $ G ⇒ f44_tt S M ∈ U $
----
l1: $ G , q ∊ S ⇒ M ∈ U $ by weaken [#4]
l2: $ G ⇒ q ∊ S → M ∈ U $ by imp_intro [l1]
l3: $ G ⇒ ∀ q (q ∊ S → M ∈ U) $ by all_intro [l2]
l4: $ G , q ∊ S , k ∊ M ⇒ universe U $ by weaken [#1]
l5: $ G , q ∊ S , k ∊ M ⇒ S ⊆ fseq U $ by weaken [#3]
l6: $ G , q ∊ S , k ∊ M ⇒ q ∊ S $ by ax
l7: $ G , q ∊ S , k ∊ M ⇒ q ∊ fseq U $ by subset_elim [l5, l6]
l8: $ G , q ∊ S , k ∊ M ⇒ M ∈ U $ by weaken [#4]
l9: $ G , q ∊ S , k ∊ M ⇒ k ∊ M $ by ax
l10: $ G , q ∊ S , k ∊ M ⇒ k ∊ U $ by wcel_welc [universe_elem_elem_c [l4, l8, welc_wcel [l9]]]
l11: $ G , q ∊ S , k ∊ M ⇒ nest q k ∈ U $ by nest_universe [l4, l7, l10]
l12: $ G , q ∊ S ⇒ k ∊ M → nest q k ∈ U $ by imp_intro [l11]
l13: $ G ⇒ q ∊ S → k ∊ M → nest q k ∈ U $ by imp_intro [l12]
l14: $ G ⇒ ∀ k (q ∊ S → k ∊ M → nest q k ∈ U) $ by all_intro [l13]
l15: $ G ⇒ ∀ q ∀ k (q ∊ S → k ∊ M → nest q k ∈ U) $ by all_intro [l14]
l16: $ G ⇒ f44_tt S M ∈ U $ by universe_repl2 [#1, #2, l3, l15]

lemma f44_tt_i (G: hyps) (S M Q K: class): $ G ⇒ Q ∈ S $ > $ G ⇒ K ∈ M $ > $ G ⇒ nest Q K ∈ f44_tt S M $
----
l1: $ G , a = Q , a ∊ S ⇒ K ∈ M $ by weaken [#2]
l2: $ G , a = Q , a ∊ S , b = K , b ∊ M , h = nest a b ⇒ h = nest a b $ by ax
l3: $ G , a = Q , a ∊ S , b = K , b ∊ M , h = nest a b ⇒ a ∊ S $ by ax
l4: $ G , a = Q , a ∊ S , b = K , b ∊ M , h = nest a b ⇒ b ∊ M $ by ax
l5: $ G , a = Q , a ∊ S , b = K , b ∊ M , h = nest a b ⇒ a ∊ S ∧ b ∊ M ∧ h = nest a b $ by and_intro [l3, and_intro [l4, l2]]
l6: $ G , a = Q , a ∊ S , b = K , b ∊ M , h = nest a b ⇒ ∃ k (a ∊ S ∧ k ∊ M ∧ h = nest a k) $ by ex_intro [l5]
l7: $ G , a = Q , a ∊ S , b = K , b ∊ M , h = nest a b ⇒ ∃ q ∃ k (q ∊ S ∧ k ∊ M ∧ h = nest q k) $ by ex_intro [l6]
l8: $ G , a = Q , a ∊ S , b = K , b ∊ M , h = nest a b ⇒ h ∊ f44_tt S M $ by cab_intro [l7]
l9: $ G , a = Q , a ∊ S , b = K , b ∊ M , h = nest a b ⇒ nest a b ∈ f44_tt S M $ by wcel_intro [l2, l8]
l10: $ G , a = Q , a ∊ S , b = K , b ∊ M ⇒ isset (nest a b) $ by nest_set
l11: $ G , a = Q , a ∊ S , b = K , b ∊ M ⇒ nest a b ∈ f44_tt S M $ by isset_elim [l10, l9]
l12: $ G , a = Q , a ∊ S , b = K , b ∊ M ⇒ a = Q $ by ax
l13: $ G , a = Q , a ∊ S , b = K , b ∊ M ⇒ b = K $ by ax
l14: $ G , a = Q , a ∊ S , b = K , b ∊ M ⇒ nest Q K ∈ f44_tt S M $ by wcel_eq_l [nest_eq [l12, l13], l11]
l15: $ G , a = Q , a ∊ S ⇒ nest Q K ∈ f44_tt S M $ by wcel_elim [l1, l14]
l16: $ G ⇒ nest Q K ∈ f44_tt S M $ by wcel_elim [#1, l15]

lemma f44_y (G: hyps) (H J I A V: class) (u w r0 tg td tb tp tt tnp tn tm pp cv mv sx sy: set): $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ pp ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w pp V $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w pp cv $ > $ G ⇒ isset I $ > $ G ⇒ isset A $ > $ G ⇒ sy ∊ (ifold u (dnf u (mcv H)) td w pp mv)' ⟨ I , ⟨ A , sx ⟩ ⟩ $ > $ G ⇒ sy ∊ ⋃ (⋃ (uni' V)) $
----
l1: $ G , i = I , a = A ⇒ i = I $ by ax
l2: $ G , i = I , a = A ⇒ a = A $ by ax
l3: $ G , i = I , a = A ⇒ sy ∊ ⋃ (ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩) $ by weaken [#10]
l4: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ $ by ax
l5: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ ⟨ ⟨ I , ⟨ A , sx ⟩ ⟩ , v ⟩ ∈ ifold u (dnf u (mcv H)) td w pp mv $ by ap_elim [l4]
l6: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ i = I $ by weaken [l1]
l7: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ a = A $ by weaken [l2]
l8: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ sx = sx $ by eq_refl
l9: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ v = v $ by eq_refl
l10: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ ⟨ ⟨ i , ⟨ a , sx ⟩ ⟩ , v ⟩ ∈ ifold u (dnf u (mcv H)) td w pp mv $ by wcel_eq_l [opair_eq [opair_eq [eq_sym [l6], opair_eq [eq_sym [l7], l8]], l9], l5]
l11: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ iwf u H J tg td w r0 $ by weaken [#1]
l12: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ ra_ind_data td tb tp tt ∈ lrel $ by weaken [#2]
l13: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ ra_ntys tt tn tm ∈ lrel $ by weaken [#3]
l14: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ ra_clen tp tnp ∈ lrel $ by weaken [#4]
l15: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ pp ∊ esat u (dnf u (mcv H)) tp w $ by weaken [#5]
l16: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ cv ∊ imots u (dnf u (mcv H)) td w pp V $ by weaken [#6]
l17: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ mv ∊ imins u (dnf u (mcv H)) td w pp cv $ by weaken [#7]
l18: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v ⇒ ∃ e (a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V) $ by ifold_motive [l11, l12, l13, l14, l15, l16, l17, l10]
l19: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V ⇒ a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V $ by ax
l20: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V ⇒ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V $ by and_elim_r [and_elim_r [l19]]
l21: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V , h = apn (vat cv (intys td) i) (scons sx e) , h ∊ uni' V ⇒ h = apn (vat cv (intys td) i) (scons sx e) $ by ax
l22: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V ⇒ v ∊ apn (vat cv (intys td) i) (scons sx e) $ by and_elim_l [and_elim_r [l19]]
l23: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V , h = apn (vat cv (intys td) i) (scons sx e) , h ∊ uni' V ⇒ v ∊ apn (vat cv (intys td) i) (scons sx e) $ by weaken [l22]
l24: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V , h = apn (vat cv (intys td) i) (scons sx e) , h ∊ uni' V ⇒ v ∊ h $ by welc_eq [eq_sym [l21], l23]
l25: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V , h = apn (vat cv (intys td) i) (scons sx e) , h ∊ uni' V ⇒ h ∊ uni' V $ by ax
l26: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V , h = apn (vat cv (intys td) i) (scons sx e) , h ∊ uni' V ⇒ v ∊ ⋃ (uni' V) $ by cuni_intro [l24, l25]
l27: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V , h = apn (vat cv (intys td) i) (scons sx e) , h ∊ uni' V ⇒ sy ∊ v $ by ax
l28: $ G , i = I , a = A , v ∊ ap (ifold u (dnf u (mcv H)) td w pp mv) ⟨ I , ⟨ A , sx ⟩ ⟩ , sy ∊ v , a = e ++ pp ∧ v ∊ apn (vat cv (intys td) i) (scons sx e) ∧ apn (vat cv (intys td) i) (scons sx e) ∈ uni' V , h = apn (vat cv (intys td) i) (scons sx e) , h ∊ uni' V ⇒ sy ∊ ⋃ (⋃ (uni' V)) $ by cuni_intro [l27, l26]
