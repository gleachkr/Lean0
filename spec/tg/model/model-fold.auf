lemma f18_mts {y f g c a h: set} (G: hyps) (Q Q2 D K L X X2 Y Y2 N C V F F2 P I: class) (s: set): $ G ⇒ Q = Q2 $ > $ G ⇒ X = X2 $ > $ G ⇒ Y = Y2 $ > $ G ⇒ F = F2 $ > $ G ⇒ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ s = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} ⊆ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q2 ∧ h ∊ ihv D K L (X2 ++ g) (Y2 ++ c) N ∧ s = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F2) ++ P)) (a ↾ I)))} $
----
l1: $ G , x ∊ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ s = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} ⇒ x ∊ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ s = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} $ by ax
