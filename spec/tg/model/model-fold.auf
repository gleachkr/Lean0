l45: $ … ⇒ ⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → ⟨ ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩ , o ⟩ ∈ L → ⟨ ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩ , v ⟩ ∈ L → o = v $ by all_elim [l44]
l46: $ … ⇒ o = v $ by imp_elim [imp_elim [imp_elim [l45, and_elim_l [l25]], l32], l38]
l47: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a , ⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩ , ⟨ a , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ ap L ⟨ j , ⟨ m , apn (g' d) a ⟩ ⟩ ⇒ o = apn h a $ by weaken [l8]
l48: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a , ⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩ , ⟨ a , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ ap L ⟨ j , ⟨ m , apn (g' d) a ⟩ ⟩ ⇒ v = apn h2 a $ by weaken [l12]
l49: $ … ⇒ apn h a = apn h2 a $ by eq_trans [eq_sym [l47], eq_trans [l46, l48]]
l50: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a , ⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩ ⇒ ∃ k ∃ l ∃ m (⟨ a , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ ap L ⟨ j , ⟨ m , apn (g' d) a ⟩ ⟩) $ by weaken [l24]
l51: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a , ⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩ , ∃ m (⟨ a , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ ap L ⟨ j , ⟨ m , apn (g' d) a ⟩ ⟩) ⇒ ∃ m (⟨ a , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ ap L ⟨ j , ⟨ m , apn (g' d) a ⟩ ⟩) $ by ax
l52: $ … ⇒ apn h a = apn h2 a $ by ex_elim [l51, l49]
l53: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a , ⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩ , ∃ l ∃ m (⟨ a , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ ap L ⟨ j , ⟨ m , apn (g' d) a ⟩ ⟩) ⇒ ∃ l ∃ m (⟨ a , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ ap L ⟨ j , ⟨ m , apn (g' d) a ⟩ ⟩) $ by ax
l54: $ … ⇒ apn h a = apn h2 a $ by ex_elim [l53, l52]
l55: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a , ⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩ ⇒ apn h a = apn h2 a $ by ex_elim [l50, l54]
l56: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a , ∃ e (⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩) ⇒ ∃ e (⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩) $ by ax
l57: $ … ⇒ apn h a = apn h2 a $ by ex_elim [l56, l55]
l58: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a , ∃ c ∃ e (⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩) ⇒ ∃ c ∃ e (⟨ a , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (g' d) a ⟩ ⟩) $ by ax
l59: $ … ⇒ apn h a = apn h2 a $ by ex_elim [l58, l57]
l60: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a , v = apn h2 a ⇒ apn h a = apn h2 a $ by ex_elim [l11, l59]
l61: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a ⇒ isset (apn h2 a) $ by wcel_isset [weaken [l7]]
l62: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , o = apn h a ⇒ apn h a = apn h2 a $ by isset_elim [l61, l60]
l63: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} ⇒ isset (apn h a) $ by wcel_isset [l5]
l64: $ G , a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} ⇒ apn h a = apn h2 a $ by isset_elim [l63, l62]
l65: $ G ⇒ a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} → apn h a = apn h2 a $ by imp_intro [l64]
l66: $ … ⇒ ∀ a (a ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} → apn h a = apn h2 a) $ by all_intro [l65]
l67: $ … ⇒ x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} → apn h x = apn h2 x $ by all_elim [l66]
l68: $ … ⇒ ∀ x (x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} → apn h x = apn h2 x) $ by all_intro [l67]
l69: $ G ⇒ h = h2 $ by fpi_ext [l1, l2, l68]

lemma f4_val {y o: set} (G: hyps) (L F: class) (u: set): $ G ⇒ ∃ y (y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y)) $ > $ G ⇒ ∃ y (y ∊ u ∧ L' F = y ∧ ⟨ F , y ⟩ ∈ L) $
----
l1: $ G , y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) ⇒ y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) $ by ax
l2: $ … ⇒ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) $ by and_elim_r [l1]
l3: $ G , y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) ⇒ isset y $ by isset_var
l4: $ … ⇒ L' F = y $ by fv_iff [l2, l3]
l5: $ … ⇒ ⟨ F , y ⟩ ∈ L ↔ y = y $ by all_elim [l2]
l6: $ G , y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) ⇒ y = y $ by eq_refl
l7: $ … ⇒ ⟨ F , y ⟩ ∈ L $ by bi_elim_r [l5, l6]
l8: $ … ⇒ y ∊ u ∧ L' F = y ∧ ⟨ F , y ⟩ ∈ L $ by and_intro [and_elim_l [l1], and_intro [l4, l7]]
l9: $ … ⇒ ∃ y (y ∊ u ∧ L' F = y ∧ ⟨ F , y ⟩ ∈ L) $ by ex_intro [l8]
l10: $ G ⇒ ∃ y (y ∊ u ∧ L' F = y ∧ ⟨ F , y ⟩ ∈ L) $ by ex_elim [#1, l9]

lemma f4_sp {q b c e y o h: set} (G: hyps) (E L g t d j A: class) (u w r n: set):
  $ G ⇒ universe u $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ t' d = etel u E A w r $ >
  $ G ⇒ ∀ q ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → ∃ y (y ∊ u ∧ ∀ o (⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , o ⟩ ∈ L ↔ o = y))) $ >
  $ G ⇒ ∀ q ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → cdm q = n) $ >
  $ G ⇒ ∃ h (h ∊ ihsp L g t d j) $
----
l1: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} ⇒ x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} $ by ax
l2: $ … ⇒ ∃ b ∃ c ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) $ by cab_elim [l1]
l3: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ⇒ ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d $ by ax
l4: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ⇒ t' d = etel u E A w r $ by weaken [#3]
l5: $ … ⇒ ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ etel u E A w r $ by wcel_eq_r [l4, l3]
l6: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ⇒ A ∈ trees ω $ by weaken [#2]
l7: $ … ⇒ x ∊ fseq u $ by and_elim_l [etel_fseq [l6, l5]]
l8: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) ⇒ ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) $ by ax
l9: $ … ⇒ x ∊ fseq u $ by ex_elim [l8, l7]
l10: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ∃ c ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) ⇒ ∃ c ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) $ by ax
l11: $ … ⇒ x ∊ fseq u $ by ex_elim [l10, l9]
l12: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} ⇒ x ∊ fseq u $ by ex_elim [l2, l11]
l13: $ G ⇒ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} ⊆ fseq u $ by subset_intro [l12]
l14: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} ⇒ q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} $ by ax
l15: $ … ⇒ ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) $ by cab_elim [l14]
l16: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d $ by ax
l17: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ⇒ ∀ q ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → cdm q = n) $ by weaken [#5]
l18: $ … ⇒ ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → cdm q = n) $ by all_elim [l17]
l19: $ … ⇒ ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → cdm q = n) $ by all_elim [l18]
l20: $ … ⇒ ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → cdm q = n) $ by all_elim [l19]
l21: $ … ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → cdm q = n $ by all_elim [l20]
l22: $ … ⇒ cdm q = n $ by imp_elim [l21, l16]
l23: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) ⇒ ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) $ by ax
l24: $ … ⇒ cdm q = n $ by ex_elim [l23, l22]
l25: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) ⇒ ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d) $ by ax
l26: $ … ⇒ cdm q = n $ by ex_elim [l25, l24]
l27: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} ⇒ cdm q = n $ by ex_elim [l15, l26]
l28: $ G ⇒ q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} → cdm q = n $ by imp_intro [l27]
l29: $ … ⇒ ∀ q (q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} → cdm q = n) $ by all_intro [l28]
l30: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d ⇒ ∀ q ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → ∃ y (y ∊ u ∧ ∀ o (⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , o ⟩ ∈ L ↔ o = y))) $ by weaken [#4]
l31: $ … ⇒ ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → ∃ y (y ∊ u ∧ ∀ o (⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , o ⟩ ∈ L ↔ o = y))) $ by all_elim [l30]
l32: $ … ⇒ ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → ∃ y (y ∊ u ∧ ∀ o (⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , o ⟩ ∈ L ↔ o = y))) $ by all_elim [l31]
l33: $ … ⇒ ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → ∃ y (y ∊ u ∧ ∀ o (⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , o ⟩ ∈ L ↔ o = y))) $ by all_elim [l32]
l34: $ … ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d → ∃ y (y ∊ u ∧ ∀ o (⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , o ⟩ ∈ L ↔ o = y)) $ by all_elim [l33]
l35: $ … ⇒ ∃ y (y ∊ u ∧ L' ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ = y ∧ ⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , y ⟩ ∈ L) $ by f4_val [imp_elim [l34, l16]]
l36: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d , y ∊ u ∧ L' ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ = y ∧ ⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , y ⟩ ∈ L ⇒ y ∊ u ∧ L' ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ = y ∧ ⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , y ⟩ ∈ L $ by ax
l37: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d , y ∊ u ∧ L' ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ = y ∧ ⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , y ⟩ ∈ L ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d $ by ax
l38: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ t' d , y ∊ u ∧ L' ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ = y ∧ ⟨ ⟨ j , ⟨ e , apn (g' d) q ⟩ ⟩ , y ⟩ ∈ L , x ∊ {v | ∃ k ∃ l ∃ m (⟨ q , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ L' ⟨ j , ⟨ m , apn (g' d) q ⟩ ⟩)} ⇒ x ∊ {v | ∃ k ∃ l ∃ m (⟨ q , ⟨ k , ⟨ l , m ⟩ ⟩ ⟩ ∈ t' d ∧ v ∊ L' ⟨ j , ⟨ m , apn (g' d) q ⟩ ⟩)} $ by ax
