l143: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l144: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ kc_pi = kc_pi $ by eq_refl
l145: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ vz = ty $ by eq_trans [l111, eq_trans [opair_eq [l144, scons_eq [l128, scons_eq [l142, l143]]], eq_sym [l110]]]
l146: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel $ by ax
