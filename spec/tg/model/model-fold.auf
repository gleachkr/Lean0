single_ictk
-----------
l1: $ G ⇒ ∃ b (ra_ind_data td b tp tt ∈ lrel) $ by ex_intro [#1]
l2: $ G ⇒ iprt td tp tt $ by weaken [l1]
l3: $ G ⇒ ∃ x ∃ y ∃ z ∃ a ∃ b ∃ d (iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel) $ by weaken [#3]
l4: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel $ by ax
l5: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ iprt td tp tt $ by weaken [l2]
l6: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ x = tp ∧ y = tt $ by iprt_det [and_elim_l [l4], l5]
l7: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ z = z $ by eq_refl
l8: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ a = a $ by eq_refl
l9: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ b = b $ by eq_refl
l10: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ ra_nth_ty tt z a b ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [and_elim_r [l6], l7, l8, l9], and_elim_l [and_elim_r [and_elim_r [l4]]]]
l11: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ tt = ⟨ kc_tcons , scons tf (scons ⟨ kc_ccons , scons tk (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ by weaken [#2]
l12: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ isset tf $ by isset_var
l13: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ isset ⟨ kc_ccons , scons tk (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ $ by opair_isset
l14: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ z = ⟨ kc_nz , ∅ ⟩ ∧ a = tf ∧ b = ⟨ kc_ccons , scons tk (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ $ by nth_ty_single [l10, l11, l12, l13]
l15: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ isset tk $ by isset_var
l16: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ d = ⟨ kc_nz , ∅ ⟩ ∧ k = tk $ by nth_ctor_single [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l4]]]], and_elim_r [and_elim_r [l14]], l15]
l17: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ nvf = nvf $ by eq_refl
l18: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l19: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ c = ∅ $ by eq_trans [eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l4]]]]], eq_trans [fv_eq [l17, and_elim_l [l16]], l18]]
l20: $ G , iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel ⇒ c = ∅ ∧ k = tk $ by and_intro [l19, and_elim_r [l16]]
l21: $ G , ∃ d (iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel) ⇒ ∃ d (iprt td x y ∧ nvf' z = j ∧ ra_nth_ty y z a b ∈ lrel ∧ nvf' d = c ∧ ra_nth_ctor b d k ∈ lrel) $ by ax
