l1: $ G ⇒ iprop D J w ∨ ¬ iprop D J w $ by excluded_middle
l2: $ G , iprop D J w ⇒ iprop D J w $ by ax
l3: $ G , iprop D J w ⇒ f ++ Q = f ++ Q $ by eq_refl
l4: $ G , iprop D J w ⇒ apn ∅ (f ++ Q) = ∅ $ by apn_empty_fn
l5: $ G , iprop D J w ⇒ apn (ictor u E D J C w) (f ++ Q) = itup D J C g w $ by eq_trans [apn_eq [ictor_prop [l2], l3], eq_trans [l4, eq_sym [itup_prop [l2]]]]
l6: $ G , ¬ iprop D J w ⇒ ¬ iprop D J w $ by ax
l7: $ G , ¬ iprop D J w ⇒ D ∈ trees ω $ by weaken [#1]
l8: $ G , ¬ iprop D J w ⇒ iprt D P T $ by weaken [#2]
l9: $ G , ¬ iprop D J w ⇒ Q ∈ esat u E P w $ by weaken [#3]
l10: $ G , ¬ iprop D J w ⇒ ictk D J C K $ by weaken [#4]
l11: $ G , ¬ iprop D J w ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E K w (Q ++ ixs D w (ifam u E D w)) $ by weaken [#5]
l12: $ G , ¬ iprop D J w ⇒ isset g $ by isset_var
l13: $ G , ¬ iprop D J w ⇒ isset (scons C g) $ by scons_set [l12]
l14: $ G , ¬ iprop D J w ⇒ apn (ictor u E D J C w) (f ++ Q) = itup D J C g w $ by eq_trans [ictor_apn_c [l7, l6, l8, l9, l10, l11], eq_sym [itup_nprop [l6, l13]]]
l15: $ G ⇒ apn (ictor u E D J C w) (f ++ Q) = itup D J C g w $ by or_elim [l1, l5, l14]

