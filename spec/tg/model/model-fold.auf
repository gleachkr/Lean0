def f35_iw_q (H J V: class) (u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv: set) (.t .d .m .e .r .z .q .y .f .g .h .o .c .i .v .k .x: set): class = $ {t | ∀ d ∀ m ∀ e ∀ r (iwf u H J tg td w r0 → ra_ind_data td tb tp tt ∈ lrel → ra_clen tp tnp ∈ lrel → p ∊ esat u (dnf u (mcv H)) tp w → cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) → mv ∊ imins u (dnf u (mcv H)) td w p cv → ra_nth_ty tt tj tFj tCj ∈ lrel → ra_isort tFj tni tlj ∈ lrel → ra_nidx td tj tni ∈ lrel → fd ∊ fseq u → cdm fd = nvf' tnf → ss ∊ fseq u → sx = fd ++ (mv ++ cv) ++ p ++ ss → cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) → ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w) → sx' nvf' tfld = V → V ∈ u → ra_ihval td tnp tn tm tv tnf tfld d tj t m ∈ lrel → m ∊ ofsort lsig lopen ks_expr → e ∊ fseq u → cdm e = nvf' d → r = e ++ sx → ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) t w r → k = f ++ e → (∃ c ∃ i (⟨ nvf' tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ o = i ++ p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ nvf' tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) → (∀ z (z ∊ dt u (mcv H) m w r → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) t w r) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) t w r → ⟨ ⟨ nvf' tj , ⟨ o , apn V (f ++ e) ⟩ ⟩ , apn (dt u (mcv H) m w r) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv))} $

