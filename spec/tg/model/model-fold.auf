l157: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ crn j1 ⊆ f51_rn_q td $ by weaken [#1]
l158: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
