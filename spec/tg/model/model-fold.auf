l1: $ G ⇒ ∀ k ∀ d ∀ m ∀ h ∀ q ∀ r (uadm u → w ∊ lvals → pp ∊ esat u (dnf u M) tp w → xs = ixs td w (ifam u (dnf u M) td w) → xs ∊ fseq u → cdm xs = nvf' tn → cv ∊ imots u (dnf u M) td w pp V → rr ∊ fseq u → td ∊ trees ω → ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) → intys td = nvf' tn → iprt td tp tt → ra_clen tp tnp ∈ lrel → ra_ntys tt tn tm ∈ lrel → ra_nth_ty tt ti tF tC0 ∈ lrel → Km ∈ ω → nadd (suc Km) (nvf' ti) = nvf' tn → nvf' ti ∈ nvf' tn → ti ∊ trees ω → ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) → ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) → ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) → ra_cminors td tnp tn k ti d ty m ∈ lrel → m ∊ ofsort lsig lopen ks_ctx → d ∊ ofsort lsig lopen ks_nat → nvf' k = nadd (nvf' d) (nvf' tk0) → ∀ a ∀ e (ra_nth_ctor ty a e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) → ra_clen_c ty q ∈ lrel → nadd (nvf' k) (nvf' q) = N → h ∊ fseq u → cdm h = nvf' k → r = h ++ cv ++ pp ++ rr → esat u (dsh u M r) m w = {l | l ∊ fseq u ∧ cdm l = nvf' q ∧ ∀ i (i ∊ N → nvf' k ⊆ i → vat (l ++ h) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})}) $ by cab_elim [#1]
l2: $ G ⇒ ∀ d ∀ m ∀ h ∀ q ∀ r (uadm u → w ∊ lvals → pp ∊ esat u (dnf u M) tp w → xs = ixs td w (ifam u (dnf u M) td w) → xs ∊ fseq u → cdm xs = nvf' tn → cv ∊ imots u (dnf u M) td w pp V → rr ∊ fseq u → td ∊ trees ω → ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) → intys td = nvf' tn → iprt td tp tt → ra_clen tp tnp ∈ lrel → ra_ntys tt tn tm ∈ lrel → ra_nth_ty tt ti tF tC0 ∈ lrel → Km ∈ ω → nadd (suc Km) (nvf' ti) = nvf' tn → nvf' ti ∈ nvf' tn → ti ∊ trees ω → ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) → ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) → ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) → ra_cminors td tnp tn vk ti d ty m ∈ lrel → m ∊ ofsort lsig lopen ks_ctx → d ∊ ofsort lsig lopen ks_nat → nvf' vk = nadd (nvf' d) (nvf' tk0) → ∀ a ∀ e (ra_nth_ctor ty a e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) → ra_clen_c ty q ∈ lrel → nadd (nvf' vk) (nvf' q) = N → h ∊ fseq u → cdm h = nvf' vk → r = h ++ cv ++ pp ++ rr → esat u (dsh u M r) m w = {l | l ∊ fseq u ∧ cdm l = nvf' q ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ h) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})}) $ by all_elim [l1]
