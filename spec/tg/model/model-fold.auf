--| @freshen H qnf
--| @freshen H qK
--| @freshen H qMin
--| @freshen H qC
--| @freshen H qM1
lemma f21_inv_cminors {qnf qK qMin qC qM1: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7 t8: set): $ G ⇒ ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel $ > $ H , t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ ⇒ Cf $ > $ H , t7 = ⟨ kc_ccons , scons qK (scons qC ∅) ⟩ ∧ ra_npis qK qnf ∈ lrel ∧ ra_mwalk t1 t2 t3 t4 t5 t6 qnf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ qK qMin ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons t4 ∅ ⟩ t5 ⟨ kc_s , scons t6 ∅ ⟩ qC qM1 ∈ lrel ∧ ra_capp qM1 ⟨ kc_cons , scons qMin (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ t8 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ qnf ∃ qK ∃ qMin ∃ qC ∃ qM1 ∃ a (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_ccons , scons qK (scons qC ∅) ⟩ ∧ t8 = a ∧ ra_npis qK qnf ∈ lrel ∧ ra_mwalk x y z u v w qnf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ qK qMin ∈ lrel ∧ ra_cminors x y z ⟨ kc_s , scons u ∅ ⟩ v ⟨ kc_s , scons w ∅ ⟩ qC qM1 ∈ lrel ∧ ra_capp qM1 ⟨ kc_cons , scons qMin (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ a ∈ lrel) $ by lrel_cminors_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ ⇒ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]]
l5: $ H ⇒ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ → Cf $ by imp_intro [#2]
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ ⇒ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ → Cf $ by weaken [l5]
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩ ⇒ Cf $ by imp_elim [l6, l4]
l8: $ G , H , ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ax
l9: $ … ⇒ Cf $ by ex_elim [l8, l7]
l10: $ G , H , ∃ v ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ v ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ax
l11: $ … ⇒ Cf $ by ex_elim [l10, l9]
l12: $ G , H , ∃ u ∃ v ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ u ∃ v ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
