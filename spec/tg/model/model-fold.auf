def f16_rw_q (M Z K: class) (u w td tn tm ti tnp p c0 rr n0: set) (.y .d .m .e .r .x .t .f: set): class = $ {y | ∀ d ∀ m ∀ e ∀ r (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → c0 ∊ fseq u → cdm c0 = nadd (nvf' tm) (nvf' tn) → rr ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ → n0 ∊ trees ω → ∀ x (x ∊ fseq u → dt u M n0 w x = Z) → K ∈ cdm c0 → nadd (suc K) (nvf' ti) = cdm c0 → ra_rtail td tnp tn tm ti d y m ∈ lrel → y ∊ trees ω → m ∊ ofsort lsig lopen ks_expr → d ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' d → r = e ++ c0 ++ p ++ rr → dt u M m w r = fpi t (mpth u (dnf u M) y w r (clam f (fseq u) (apn (Z) (f ++ e ++ p)))) (ap (clam f (fseq u) (apn (c0' K) (f ++ e))) t))} $

--| @freshen G x
--| @freshen G t
--| @freshen G f
lemma f16_rw_e {x t f: set} (G: hyps) (M Z K: class) (u w td tn tm ti tnp p c0 rr n0: set) (ty vd vm ve vr: set): $ G ⇒ ty ∊ f16_rw_q M Z K u w td tn tm ti tnp p c0 rr n0 $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' tnp $ > $ G ⇒ c0 ∊ fseq u $ > $ G ⇒ cdm c0 = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ > $ G ⇒ n0 ∊ trees ω $ > $ G ⇒ ∀ x (x ∊ fseq u → dt u M n0 w x = Z) $ > $ G ⇒ K ∈ cdm c0 $ > $ G ⇒ nadd (suc K) (nvf' ti) = cdm c0 $ > $ G ⇒ ra_rtail td tnp tn tm ti vd ty vm ∈ lrel $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ve ∊ fseq u $ > $ G ⇒ cdm ve = nvf' vd $ > $ G ⇒ vr = ve ++ c0 ++ p ++ rr $ > $ G ⇒ dt u M vm w vr = fpi t (mpth u (dnf u M) ty w vr (clam f (fseq u) (apn (Z) (f ++ ve ++ p)))) (ap (clam f (fseq u) (apn (c0' K) (f ++ ve))) t) $
----
l1: $ G ⇒ ∀ d ∀ m ∀ e ∀ r (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → c0 ∊ fseq u → cdm c0 = nadd (nvf' tm) (nvf' tn) → rr ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ → n0 ∊ trees ω → ∀ x (x ∊ fseq u → dt u M n0 w x = Z) → K ∈ cdm c0 → nadd (suc K) (nvf' ti) = cdm c0 → ra_rtail td tnp tn tm ti d ty m ∈ lrel → ty ∊ trees ω → m ∊ ofsort lsig lopen ks_expr → d ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' d → r = e ++ c0 ++ p ++ rr → dt u M m w r = fpi t (mpth u (dnf u M) ty w r (clam f (fseq u) (apn (Z) (f ++ e ++ p)))) (ap (clam f (fseq u) (apn (c0' K) (f ++ e))) t)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ m ∀ e ∀ r (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → c0 ∊ fseq u → cdm c0 = nadd (nvf' tm) (nvf' tn) → rr ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ → n0 ∊ trees ω → ∀ x (x ∊ fseq u → dt u M n0 w x = Z) → K ∈ cdm c0 → nadd (suc K) (nvf' ti) = cdm c0 → ra_rtail td tnp tn tm ti vd ty m ∈ lrel → ty ∊ trees ω → m ∊ ofsort lsig lopen ks_expr → vd ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' vd → r = e ++ c0 ++ p ++ rr → dt u M m w r = fpi t (mpth u (dnf u M) ty w r (clam f (fseq u) (apn (Z) (f ++ e ++ p)))) (ap (clam f (fseq u) (apn (c0' K) (f ++ e))) t)) $ by all_elim [l1]
l3: $ G ⇒ ∀ e ∀ r (uadm u → w ∊ lvals → p ∊ fseq u → cdm p = nvf' tnp → c0 ∊ fseq u → cdm c0 = nadd (nvf' tm) (nvf' tn) → rr ∊ fseq u → n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ → n0 ∊ trees ω → ∀ x (x ∊ fseq u → dt u M n0 w x = Z) → K ∈ cdm c0 → nadd (suc K) (nvf' ti) = cdm c0 → ra_rtail td tnp tn tm ti vd ty vm ∈ lrel → ty ∊ trees ω → vm ∊ ofsort lsig lopen ks_expr → vd ∊ ofsort lsig lopen ks_nat → e ∊ fseq u → cdm e = nvf' vd → r = e ++ c0 ++ p ++ rr → dt u M vm w r = fpi t (mpth u (dnf u M) ty w r (clam f (fseq u) (apn (Z) (f ++ e ++ p)))) (ap (clam f (fseq u) (apn (c0' K) (f ++ e))) t)) $ by all_elim [l2]
