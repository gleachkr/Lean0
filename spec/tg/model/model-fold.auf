l98: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ sx = sx $ by eq_refl
l99: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ⟨ nvf' ti , ⟨ d , sx ⟩ ⟩ = ⟨ nvf' ti , ⟨ sf ++ p , sx ⟩ ⟩ $ by opair_eq [l95, opair_eq [l92, l98]]
l100: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) $ by and_elim_r [l90]
l101: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , v ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ v = v $ by all_elim [l100]
l102: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ v = v $ by eq_refl
l103: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , v ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv $ by bi_elim_r [l101, l102]
l104: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ iwf u H J tc td w R $ by weaken [#1]
l105: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ uadm u $ by iwf_uadm [l104]
l106: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ixs td w (ifam u (dnf u (mcv H)) td w) ∈ fseq u ∧ cdm (ixs td w (ifam u (dnf u (mcv H)) td w)) = intys td $ by ixs_ifam_fseq [uadm_universe [l105], ifam_universe [l104]]
l107: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ra_ind_data td tb tp tt ∈ lrel $ by weaken [#2]
l108: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ra_ntys tt tn tm ∈ lrel $ by weaken [#3]
l109: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ p ∊ fseq u $ by weaken [l19]
l110: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ by weaken [#6]
l111: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ by weaken [#7]
l112: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ifold u (dnf u (mcv H)) td w p mv ⊆ imrel td cv $ by ifold_imrel [l107, l108, l109, and_elim_l [l106], l110, l111]
l113: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ⟨ ⟨ nvf' ti , ⟨ d , sx ⟩ ⟩ , v ⟩ ∈ imrel td cv $ by wcel_eq_l [opair_eq [l97, l102], wcel_subset [l112, l103]]
l114: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ v ∊ ap (imrel td cv) ⟨ nvf' ti , ⟨ d , sx ⟩ ⟩ $ by ap_intro [l113]
l115: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ isset ti $ by isset_var
l116: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ nvf' ti ∈ ω $ by nvf_omega [l115]
l117: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ isset d $ by isset_var
l118: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ isset sx $ by isset_var
l119: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ap (imrel td cv) ⟨ nvf' ti , ⟨ d , sx ⟩ ⟩ = apn (vat cv (intys td) (nvf' ti)) (scons sx (d ↾ inidx td (nvf' ti))) $ by imrel_ap [wcel_isset [l116], l117, l118]
l120: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ sf ∊ fseq u ∧ sg ∊ fseq u ∧ cdm sg = cdm sf ∧ cdm st = cdm sf $ by weaken [l21]
l121: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ sf ∊ fseq u $ by and_elim_l [l120]
l122: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ra_nidx td ti tk ∈ lrel $ by weaken [l16]
l123: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ cdm sf = nvf' tk $ by weaken [l24]
l124: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ p ∊ fseq u $ by weaken [l19]
l125: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ d ↾ inidx td (nvf' ti) = sf $ by eq_trans [cres_eq [l92, eq_trans [inidx_val [l122], eq_sym [l123]]], cres_scat_l [l121, l124]]
l126: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ vat cv (intys td) (nvf' ti) = vat cv (intys td) (nvf' ti) $ by eq_refl
l127: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ v ∊ apn (vat cv (intys td) (nvf' ti)) (scons sx sf) $ by welc_eq [eq_trans [l119, apn_eq [l126, scons_eq [l98, l125]]], l114]
l128: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ ifold u (dnf u (mcv H)) td w p mv = ifold u (dnf u (mcv H)) td w p mv $ by eq_refl
l129: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} , v ∊ u ∧ ∀ o (⟨ ⟨ nvf' ti , ⟨ d , {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v) ⇒ (ifold u (dnf u (mcv H)) td w p mv)' ⟨ nvf' ti , ⟨ sf ++ p , sx ⟩ ⟩ ∈ apn (vat cv (intys td) (nvf' ti)) (scons sx sf) $ by wcel_eq_l [eq_sym [eq_trans [fv_eq [l128, eq_sym [eq_trans [l97, l99]]], l94]], welc_wcel [l127]]
l130: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p , ⟨ nvf' ti , ⟨ d , n ⟩ ⟩ ∈ r ∧ sx = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⇒ (ifold u (dnf u (mcv H)) td w p mv)' ⟨ nvf' ti , ⟨ sf ++ p , sx ⟩ ⟩ ∈ apn (vat cv (intys td) (nvf' ti)) (scons sx sf) $ by ex_elim [l89, l129]
l131: $ G , r = ifam u (dnf u (mcv H)) td w , d = sf ++ p ⇒ (ifold u (dnf u (mcv H)) td w p mv)' ⟨ nvf' ti , ⟨ sf ++ p , sx ⟩ ⟩ ∈ apn (vat cv (intys td) (nvf' ti)) (scons sx sf) $ by ex_elim [l51, l130]
l132: $ G , r = ifam u (dnf u (mcv H)) td w ⇒ kr_isort ∈ ω $ by kr_isort_omega
l133: $ G , r = ifam u (dnf u (mcv H)) td w ⇒ tf ∊ trees ω ∧ tk ∊ trees ω ∧ tl ∊ trees ω $ by lrel_args3 [weaken [#10], wcel_isset [l132]]
l134: $ G , r = ifam u (dnf u (mcv H)) td w ⇒ sf ∊ fseq u ∧ sg ∊ fseq u ∧ cdm sg = cdm sf ∧ cdm st = cdm sf $ by etel_fseq [welc_wcel [and_elim_l [l133]], weaken [#11]]
l135: $ G , r = ifam u (dnf u (mcv H)) td w ⇒ esat u (dnf u (mcv H)) tp w ⊆ fseq u $ by esat_fseq
l136: $ G , r = ifam u (dnf u (mcv H)) td w ⇒ p ∊ fseq u $ by subset_elim [l135, weaken [#5]]
l137: $ G , r = ifam u (dnf u (mcv H)) td w ⇒ isset (sf ++ p) $ by wcel_isset [scat_fseq_c [welc_wcel [and_elim_l [l134]], welc_wcel [l136]]]
l138: $ G , r = ifam u (dnf u (mcv H)) td w ⇒ (ifold u (dnf u (mcv H)) td w p mv)' ⟨ nvf' ti , ⟨ sf ++ p , sx ⟩ ⟩ ∈ apn (vat cv (intys td) (nvf' ti)) (scons sx sf) $ by isset_elim [l137, l131]
l139: $ G ⇒ iwf u H J tc td w R $ by weaken [#1]
l140: $ G ⇒ isset (ifam u (dnf u (mcv H)) td w) $ by wcel_isset [ifam_universe [l139]]
l141: $ G ⇒ (ifold u (dnf u (mcv H)) td w p mv)' ⟨ nvf' ti , ⟨ sf ++ p , sx ⟩ ⟩ ∈ apn (vat cv (intys td) (nvf' ti)) (scons sx sf) $ by isset_elim [l140, l138]

cpi_fpi
-------
l1: $ G ⇒ h ⊆ clam a A (⋃ (fpi q {x | x ∊ fseq V ∧ ssnoc x a ∈ S} (ap T (ssnoc q a)))) $ by cpi_elim_sub [#1]
l2: $ G ⇒ rel (clam a A (⋃ (fpi q {x | x ∊ fseq V ∧ ssnoc x a ∈ S} (ap T (ssnoc q a))))) $ by clam_rel
l3: $ G ⇒ rel h $ by rel_subset [l2, l1]
l4: $ G , z ∊ h ⇒ ∀ z (z ∊ h → ∃ b ∃ v (z = ⟨ b , v ⟩)) $ by weaken [l3]
l5: $ G , z ∊ h ⇒ z ∊ h → ∃ b ∃ v (z = ⟨ b , v ⟩) $ by all_elim [l4]
l6: $ G , z ∊ h ⇒ z ∊ h $ by ax
l7: $ G , z ∊ h ⇒ ∃ b ∃ v (z = ⟨ b , v ⟩) $ by imp_elim [l5, l6]
l8: $ G , z ∊ h , z = ⟨ b , v ⟩ ⇒ z = ⟨ b , v ⟩ $ by ax
l9: $ G , z ∊ h , z = ⟨ b , v ⟩ ⇒ z ∊ h $ by ax
