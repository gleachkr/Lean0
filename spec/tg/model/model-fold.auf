def f30_ss_q (td tj tn tk th tdd: set) (.y .m .z .x: set): class = $ {y | ∀ m ∀ z (ra_add tj tdd tn ∈ lrel → ra_spine th y m ∈ lrel → ra_sinst td tj tn tk y z ∈ lrel → ∃ x (ra_spine x z m ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel))} $

--| @freshen G x
lemma f30_ss_e {x: set} (G: hyps) (td tj tn tk th tdd: set) (ty vm vz: set): $ G ⇒ ty ∊ f30_ss_q td tj tn tk th tdd $ > $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_spine th ty vm ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk ty vz ∈ lrel $ > $ G ⇒ ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $
----
l1: $ G ⇒ ∀ m ∀ z (ra_add tj tdd tn ∈ lrel → ra_spine th ty m ∈ lrel → ra_sinst td tj tn tk ty z ∈ lrel → ∃ x (ra_spine x z m ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ z (ra_add tj tdd tn ∈ lrel → ra_spine th ty vm ∈ lrel → ra_sinst td tj tn tk ty z ∈ lrel → ∃ x (ra_spine x z vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel)) $ by all_elim [l1]
l3: $ G ⇒ ra_add tj tdd tn ∈ lrel → ra_spine th ty vm ∈ lrel → ra_sinst td tj tn tk ty vz ∈ lrel → ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ra_spine th ty vm ∈ lrel → ra_sinst td tj tn tk ty vz ∈ lrel → ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by imp_elim [l3, #2]
l5: $ G ⇒ ra_sinst td tj tn tk ty vz ∈ lrel → ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by imp_elim [l4, #3]
l6: $ G ⇒ ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by imp_elim [l5, #4]

--| @freshen G x
lemma f30_ss_n {x: set} (G: hyps) (td tj tn tk th tdd: set) (ty k1 j1 vm vz: set): $ G ⇒ crn j1 ⊆ f30_ss_q td tj tn tk th tdd $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_spine th ty vm ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk ty vz ∈ lrel $ > $ G ⇒ ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $
----
