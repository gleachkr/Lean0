l8: $ G , n = nest q4 y0 ⇒ nest q4 y0 ∈ ient td w zc (nvf' ti) $ by weaken [#9]
l9: $ G , n = nest q4 y0 ⇒ n ∊ ient td w zc (nvf' ti) $ by wcel_welc [wcel_eq_l [eq_sym [l7], l8]]
l10: $ G , n = nest q4 y0 ⇒ n ∊ {y | ∃ a ∃ x (⟨ nvf' ti , ⟨ a , x ⟩ ⟩ ∈ zc ∧ ((iprop td (nvf' ti) w ∧ y = nest a ∅) ∨ (¬ iprop td (nvf' ti) w ∧ y = nest a x)))} $ by weaken [l9]
l11: $ G , n = nest q4 y0 ⇒ ∃ a ∃ x (⟨ nvf' ti , ⟨ a , x ⟩ ⟩ ∈ zc ∧ ((iprop td (nvf' ti) w ∧ n = nest a ∅) ∨ (¬ iprop td (nvf' ti) w ∧ n = nest a x))) $ by cab_elim [l10]
l12: $ G , n = nest q4 y0 , ⟨ nvf' ti , ⟨ a , x ⟩ ⟩ ∈ zc ∧ ((iprop td (nvf' ti) w ∧ n = nest a ∅) ∨ (¬ iprop td (nvf' ti) w ∧ n = nest a x)) ⇒ ⟨ nvf' ti , ⟨ a , x ⟩ ⟩ ∈ zc ∧ ((iprop td (nvf' ti) w ∧ n = nest a ∅) ∨ (¬ iprop td (nvf' ti) w ∧ n = nest a x)) $ by ax
