mpth_congr
----------
g1: $ ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ≐ ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ $ by ceqt_refl
g2: $ etel A C E H J ≐ etel B D F I K $ by etel_congr [#1, #2, #3, #4, #5]
g3: $ (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel A C E H J) ⟺ (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel B D F I K) $ by wcel_congr [g1, g2]
g4: $ seqt m m $ by seqt_refl
g5: $ (c) ≐ (c) $ by ceqt_refl
g6: $ ap L c ≐ ap N c $ by ap_congr [#6, g5]
g7: $ (m ∊ ap L c) ⟺ (m ∊ ap N c) $ by welc_congr [g4, g6]
g8: $ (m ∊ A) ⟺ (m ∊ B) $ by welc_congr [g4, #1]
g9: $ (z = scons m c) ⟺ (z = scons m c) $ by iff_refl
g10: $ (m ∊ A ∧ z = scons m c) ⟺ (m ∊ B ∧ z = scons m c) $ by and_congr [g8, g9]
g11: $ (m ∊ ap L c ∧ m ∊ A ∧ z = scons m c) ⟺ (m ∊ ap N c ∧ m ∊ B ∧ z = scons m c) $ by and_congr [g7, g10]
g12: $ (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ m ∊ ap L c ∧ m ∊ A ∧ z = scons m c) ⟺ (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ m ∊ ap N c ∧ m ∊ B ∧ z = scons m c) $ by and_congr [g3, g11]
g13: $ (∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ m ∊ ap L c ∧ m ∊ A ∧ z = scons m c)) ⟺ (∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ m ∊ ap N c ∧ m ∊ B ∧ z = scons m c)) $ by ex_congr [g12]
g14: $ (∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ m ∊ ap L c ∧ m ∊ A ∧ z = scons m c)) ⟺ (∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ m ∊ ap N c ∧ m ∊ B ∧ z = scons m c)) $ by ex_congr [g13]
g15: $ (∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ m ∊ ap L c ∧ m ∊ A ∧ z = scons m c)) ⟺ (∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ m ∊ ap N c ∧ m ∊ B ∧ z = scons m c)) $ by ex_congr [g14]
g16: $ (∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ m ∊ ap L c ∧ m ∊ A ∧ z = scons m c)) ⟺ (∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ m ∊ ap N c ∧ m ∊ B ∧ z = scons m c)) $ by ex_congr [g15]
g17: $ (∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ m ∊ ap L c ∧ m ∊ A ∧ z = scons m c)) ⟺ (∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ m ∊ ap N c ∧ m ∊ B ∧ z = scons m c)) $ by ex_congr [g16]
g18: $ mpth A C E H J L ≐ mpth B D F I K N $ by cab_congr [g17]

sb_c_mpth
---------
l1: $ (⟦ x / t ⟧ {z | ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel A B C D E ∧ m ∊ ap F c ∧ m ∊ A ∧ z = scons m c)}) ≐ {z | ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) ∧ m ∊ ap (⟦ x / t ⟧ F) c ∧ m ∊ (⟦ x / t ⟧ A) ∧ z = scons m c)} $ by ceqt_refl

mpth_pi_dom
-----------
l1: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) ⇒ l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) $ by ax
l2: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) ⇒ ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) $ by cab_elim [l1]
l3: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c ⇒ ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c $ by ax
l4: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ n (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l3]
l5: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ k ∃ n (⟨ c , ⟨ d , ⟨ h , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l4]
l6: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ j ∃ k ∃ n (⟨ c , ⟨ d , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l5]
l7: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ i ∃ j ∃ k ∃ n (⟨ c , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) c ∧ n ∊ u ∧ l = scons n c) $ by ex_intro [l6]
l8: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e) $ by ex_intro [l7]
l9: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) ⇒ ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) $ by ax
l10: $ … ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l9, l8]
l11: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) ⇒ ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) $ by ax
l12: $ … ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l11, l10]
l13: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) ⇒ ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) $ by ax
l14: $ … ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l13, l12]
l15: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) ⇒ ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap (Y2) c ∧ m ∊ u ∧ l = scons m c) $ by ax
l16: $ … ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l15, l14]
l17: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) ⇒ ∃ e ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e) $ by ex_elim [l2, l16]
l18: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e ⇒ ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e $ by ax
l19: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e , p = scons a r ⇒ tb = tb $ by eq_refl
l20: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e , p = scons a r ⇒ w = w $ by eq_refl
l21: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e , p = scons a r ⇒ p = scons a r $ by ax
l22: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e , p = scons a r ⇒ ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w p $ by wcel_eq_r [etel_eq [l19, l20, eq_sym [l21]], weaken [and_elim_l [l18]]]
l23: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e , p = scons a r ⇒ tb ∊ trees ω $ by weaken [#2]
l24: $ G , l ∊ mpth u (dnf u M) tb w (scons a r) (Y2) , ⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ n ∊ ap (Y2) e ∧ n ∊ u ∧ l = scons n e , p = scons a r ⇒ e ∊ fseq u $ by and_elim_l [etel_fseq [welc_wcel [l23], l22]]
