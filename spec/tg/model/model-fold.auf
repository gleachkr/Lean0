l352: $ G , vm = ⟨ kc_app , scons m (scons n ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty x5 ∈ lrel ∧ ra_nidx td tj x4 ∈ lrel ∧ ra_add tnp x4 x5 ∈ lrel ∧ ra_rehead x0 l x4 ty m ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ x0 tnp ∈ lrel ∧ ra_add vd tnf x6 ∈ lrel ∧ ra_add tm tn x7 ∈ lrel ∧ ra_add x6 x7 x8 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ x8 tnp j ∈ lrel ∧ ra_pargs j x6 x7 l ∈ lrel ∧ ra_add vd tfld x9 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x9 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd n ∈ lrel , e = ve ++ fd ⇒ ss ∊ fseq u $ by weaken [#16]
l353: $ G , vm = ⟨ kc_app , scons m (scons n ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty x5 ∈ lrel ∧ ra_nidx td tj x4 ∈ lrel ∧ ra_add tnp x4 x5 ∈ lrel ∧ ra_rehead x0 l x4 ty m ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ x0 tnp ∈ lrel ∧ ra_add vd tnf x6 ∈ lrel ∧ ra_add tm tn x7 ∈ lrel ∧ ra_add x6 x7 x8 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ x8 tnp j ∈ lrel ∧ ra_pargs j x6 x7 l ∈ lrel ∧ ra_add vd tfld x9 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x9 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd n ∈ lrel , e = ve ++ fd ⇒ V ∈ u $ by weaken [#21]
l354: $ G , vm = ⟨ kc_app , scons m (scons n ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty x5 ∈ lrel ∧ ra_nidx td tj x4 ∈ lrel ∧ ra_add tnp x4 x5 ∈ lrel ∧ ra_rehead x0 l x4 ty m ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ x0 tnp ∈ lrel ∧ ra_add vd tnf x6 ∈ lrel ∧ ra_add tm tn x7 ∈ lrel ∧ ra_add x6 x7 x8 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ x8 tnp j ∈ lrel ∧ ra_pargs j x6 x7 l ∈ lrel ∧ ra_add vd tfld x9 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x9 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd n ∈ lrel , e = ve ++ fd ⇒ ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vr → k = f ++ ve → (∃ c ∃ i (⟨ nvf' tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ o = i ++ p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ nvf' tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) $ by weaken [#27]
l355: $ G , vm = ⟨ kc_app , scons m (scons n ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty x5 ∈ lrel ∧ ra_nidx td tj x4 ∈ lrel ∧ ra_add tnp x4 x5 ∈ lrel ∧ ra_rehead x0 l x4 ty m ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ x0 tnp ∈ lrel ∧ ra_add vd tnf x6 ∈ lrel ∧ ra_add tm tn x7 ∈ lrel ∧ ra_add x6 x7 x8 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ x8 tnp j ∈ lrel ∧ ra_pargs j x6 x7 l ∈ lrel ∧ ra_add vd tfld x9 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x9 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd n ∈ lrel , e = ve ++ fd ⇒ vm = ⟨ kc_app , scons m (scons n ∅) ⟩ $ by weaken [l258]
l356: $ G , vm = ⟨ kc_app , scons m (scons n ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty x5 ∈ lrel ∧ ra_nidx td tj x4 ∈ lrel ∧ ra_add tnp x4 x5 ∈ lrel ∧ ra_rehead x0 l x4 ty m ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ x0 tnp ∈ lrel ∧ ra_add vd tnf x6 ∈ lrel ∧ ra_add tm tn x7 ∈ lrel ∧ ra_add x6 x7 x8 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ x8 tnp j ∈ lrel ∧ ra_pargs j x6 x7 l ∈ lrel ∧ ra_add vd tfld x9 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x9 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd n ∈ lrel , e = ve ++ fd ⇒ (∀ z (z ∊ dt u (mcv H) vm w vr → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) ty w vr) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vr → ⟨ ⟨ nvf' tj , ⟨ o , apn V (f ++ ve) ⟩ ⟩ , apn (dt u (mcv H) vm w vr) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv) $ by ihval_leaf [l336, l291, l337, l338, l339, l340, l341, l342, l343, l344, l345, l346, l347, l348, l349, l288, l350, l293, l297, l351, l290, l303, l352, l306, l308, l311, l321, l353, l354, l335, l355]
l357: $ G , vm = ⟨ kc_app , scons m (scons n ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ty x5 ∈ lrel ∧ ra_nidx td tj x4 ∈ lrel ∧ ra_add tnp x4 x5 ∈ lrel ∧ ra_rehead x0 l x4 ty m ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ x0 tnp ∈ lrel ∧ ra_add vd tnf x6 ∈ lrel ∧ ra_add tm tn x7 ∈ lrel ∧ ra_add x6 x7 x8 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ x8 tnp j ∈ lrel ∧ ra_pargs j x6 x7 l ∈ lrel ∧ ra_add vd tfld x9 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x9 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ vd n ∈ lrel ⇒ (∀ z (z ∊ dt u (mcv H) vm w vr → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) ty w vr) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vr → ⟨ ⟨ nvf' tj , ⟨ o , apn V (f ++ ve) ⟩ ⟩ , apn (dt u (mcv H) vm w vr) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv) $ by isset_elim [l286, l356]
l358: $ G ⇒ (∀ z (z ∊ dt u (mcv H) vm w vr → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) ty w vr) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vr → ⟨ ⟨ nvf' tj , ⟨ o , apn V (f ++ ve) ⟩ ⟩ , apn (dt u (mcv H) vm w vr) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv) $ by f21_inv_ihval [#22, l256, l357]

lemma f35_iw_all (G: hyps) (H J V: class) (u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv: set): $ G ⇒ trees ω ⊆ f35_iw_q H J V u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f35_iw_q H J V u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv , t = ⟨ x8 , x9 ⟩ , iwf u H J tg td w r0 , ra_ind_data td tb tp tt ∈ lrel , ra_clen tp tnp ∈ lrel , p ∊ esat u (dnf u (mcv H)) tp w , cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) , mv ∊ imins u (dnf u (mcv H)) td w p cv , ra_nth_ty tt tj tFj tCj ∈ lrel , ra_isort tFj tni tlj ∈ lrel , ra_nidx td tj tni ∈ lrel , fd ∊ fseq u , cdm fd = nvf' tnf , ss ∊ fseq u , sx = fd ++ (mv ++ cv) ++ p ++ ss , cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) , ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w) , sx' nvf' tfld = V , V ∈ u , ra_ihval td tnp tn tm tv tnf tfld d tj t m ∈ lrel , m ∊ ofsort lsig lopen ks_expr , e ∊ fseq u , cdm e = nvf' d , r = e ++ sx , ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) t w r → k = f ++ e → (∃ c ∃ i (⟨ nvf' tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ o = i ++ p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ nvf' tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) ⇒ crn x9 ⊆ f35_iw_q H J V u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f35_iw_q H J V u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv , t = ⟨ x8 , x9 ⟩ , iwf u H J tg td w r0 , ra_ind_data td tb tp tt ∈ lrel , ra_clen tp tnp ∈ lrel , p ∊ esat u (dnf u (mcv H)) tp w , cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) , mv ∊ imins u (dnf u (mcv H)) td w p cv , ra_nth_ty tt tj tFj tCj ∈ lrel , ra_isort tFj tni tlj ∈ lrel , ra_nidx td tj tni ∈ lrel , fd ∊ fseq u , cdm fd = nvf' tnf , ss ∊ fseq u , sx = fd ++ (mv ++ cv) ++ p ++ ss , cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) , ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w) , sx' nvf' tfld = V , V ∈ u , ra_ihval td tnp tn tm tv tnf tfld d tj t m ∈ lrel , m ∊ ofsort lsig lopen ks_expr , e ∊ fseq u , cdm e = nvf' d , r = e ++ sx , ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) t w r → k = f ++ e → (∃ c ∃ i (⟨ nvf' tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ o = i ++ p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ nvf' tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) ⇒ t = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f35_iw_q H J V u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv , t = ⟨ x8 , x9 ⟩ , iwf u H J tg td w r0 , ra_ind_data td tb tp tt ∈ lrel , ra_clen tp tnp ∈ lrel , p ∊ esat u (dnf u (mcv H)) tp w , cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) , mv ∊ imins u (dnf u (mcv H)) td w p cv , ra_nth_ty tt tj tFj tCj ∈ lrel , ra_isort tFj tni tlj ∈ lrel , ra_nidx td tj tni ∈ lrel , fd ∊ fseq u , cdm fd = nvf' tnf , ss ∊ fseq u , sx = fd ++ (mv ++ cv) ++ p ++ ss , cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) , ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w) , sx' nvf' tfld = V , V ∈ u , ra_ihval td tnp tn tm tv tnf tfld d tj t m ∈ lrel , m ∊ ofsort lsig lopen ks_expr , e ∊ fseq u , cdm e = nvf' d , r = e ++ sx , ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) t w r → k = f ++ e → (∃ c ∃ i (⟨ nvf' tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ o = i ++ p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ nvf' tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) ⇒ x8 ∊ ω $ by ax
