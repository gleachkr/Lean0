l49: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ f ∃ c ∃ t (dd = x1 ∧ nv = x2 ∧ np = x3 ∧ lv = x4 ∧ iv = x5 ∧ cx = x6 ∧ bb = ⟨ kc_tcons , scons f (scons c (scons t ∅)) ⟩ ∧ ra_isort f x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 c ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 t ∈ lrel3 J)) → ra_ctors_wf dd nv np lv iv cx y2 ∈ lrel3 J $ by or_elim_imp [l21, l48]
l50: $ G ⇒ ra_ctors_wf dd nv np lv iv cx y2 ∈ lrel3 J $ by imp_elim [l49, l1]

def f26_tw_q (J: class) (td tn tnp tl tc: set) (.y .o .n .f .e .x: set): class = $ {y | ∀ o ∀ n ∀ f ∀ e (o ∊ trees ω → ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J → ra_nth_ty y n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J))} $

--| @freshen G x
lemma f26_tw_e {x: set} (G: hyps) (J: class) (td tn tnp tl tc: set) (ty vo vn vf ve: set): $ G ⇒ ty ∊ f26_tw_q J td tn tnp tl tc $ > $ G ⇒ vo ∊ trees ω $ > $ G ⇒ ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J $ > $ G ⇒ ra_nth_ty ty vn vf ve ∈ lrel $ > $ G ⇒ ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $
----
l1: $ G ⇒ ∀ o ∀ n ∀ f ∀ e (o ∊ trees ω → ra_tys_wf td tn tnp tl o tc ty ∈ lrel3 J → ra_nth_ty ty n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ n ∀ f ∀ e (vo ∊ trees ω → ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J → ra_nth_ty ty n f e ∈ lrel → ∃ x (ra_add vo n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J)) $ by all_elim [l1]
l3: $ G ⇒ ∀ f ∀ e (vo ∊ trees ω → ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J → ra_nth_ty ty vn f e ∈ lrel → ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J)) $ by all_elim [l2]
l4: $ G ⇒ ∀ e (vo ∊ trees ω → ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J → ra_nth_ty ty vn vf e ∈ lrel → ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J)) $ by all_elim [l3]
l5: $ G ⇒ vo ∊ trees ω → ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J → ra_nth_ty ty vn vf ve ∈ lrel → ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by all_elim [l4]
l6: $ G ⇒ ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J → ra_nth_ty ty vn vf ve ∈ lrel → ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by imp_elim [l5, #2]
l7: $ G ⇒ ra_nth_ty ty vn vf ve ∈ lrel → ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by imp_elim [l6, #3]
l8: $ G ⇒ ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by imp_elim [l7, #4]

--| @freshen H qT
--| @freshen H qF2
--| @freshen H qC2
--| @freshen H qi_v
lemma f21_inv_nth_ty {qT qF2 qC2 qi_v: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_nth_ty t1 t2 t3 t4 ∈ lrel $ > $ H , t1 = ⟨ kc_tcons , scons t3 (scons t4 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ ra_nth_ty qT qi_v t3 t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_nth_ty t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ∨ ∃ x ∃ qF2 ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) $ by lrel_nth_ty_cases [l1]
l3: $ G , H , t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y $ by ax
l4: $ G , H , t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , H , t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ qT = qT $ by eq_refl
l6: $ G , H , t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ kc_tcons = kc_tcons $ by eq_refl
l7: $ G , H , t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ t1 = ⟨ kc_tcons , scons t3 (scons t4 (scons qT ∅)) ⟩ $ by eq_trans [and_elim_l [l3], opair_eq [l6, scons_eq [eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]], scons_eq [eq_sym [and_elim_r [and_elim_r [and_elim_r [l3]]]], scons_eq [l5, l4]]]]]
l8: $ G , H , t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ t1 = ⟨ kc_tcons , scons t3 (scons t4 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l7, and_elim_l [and_elim_r [l3]]]
l9: $ H ⇒ t1 = ⟨ kc_tcons , scons t3 (scons t4 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l10: $ G , H , t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ t1 = ⟨ kc_tcons , scons t3 (scons t4 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l9]
l11: $ G , H , t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y ⇒ Cf $ by imp_elim [l10, l8]
l12: $ G , H , ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ⇒ ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ y ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ⇒ ∃ y ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H , ∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ⇒ ∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) $ by ax
l17: $ … ⇒ Cf $ by ex_elim [l16, l15]
l18: $ G , H ⇒ (∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y)) → Cf $ by imp_intro [l17]
l19: $ G , H , t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel $ by ax
l20: $ G , H , t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ qT = qT $ by eq_refl
l21: $ G , H , t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ qi_v = qi_v $ by eq_refl
l22: $ G , H , t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ ra_nth_ty qT qi_v t3 t4 ∈ lrel $ by wcel_eq_l [ra_nth_ty_eq [l20, l21, eq_sym [and_elim_l [and_elim_r [and_elim_r [l19]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l19]]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [l19]]]]]
l23: $ G , H , t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ ra_nth_ty qT qi_v t3 t4 ∈ lrel $ by and_intro [and_elim_l [l19], and_intro [and_elim_l [and_elim_r [l19]], l22]]
l24: $ H ⇒ t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ ra_nth_ty qT qi_v t3 t4 ∈ lrel → Cf $ by imp_intro [#3]
l25: $ G , H , t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ ra_nth_ty qT qi_v t3 t4 ∈ lrel → Cf $ by weaken [l24]
l26: $ G , H , t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel ⇒ Cf $ by imp_elim [l25, l23]
l27: $ G , H , ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) ⇒ ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) $ by ax
l28: $ … ⇒ Cf $ by ex_elim [l27, l26]
l29: $ G , H , ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) ⇒ ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) $ by ax
l30: $ … ⇒ Cf $ by ex_elim [l29, l28]
l31: $ G , H , ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) ⇒ ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) $ by ax
l32: $ … ⇒ Cf $ by ex_elim [l31, l30]
l33: $ G , H , ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) ⇒ ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) $ by ax
l34: $ … ⇒ Cf $ by ex_elim [l33, l32]
l35: $ G , H , ∃ qF2 ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) ⇒ ∃ qF2 ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) $ by ax
l36: $ … ⇒ Cf $ by ex_elim [l35, l34]
l37: $ G , H , ∃ x ∃ qF2 ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) ⇒ ∃ x ∃ qF2 ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel) $ by ax
l38: $ … ⇒ Cf $ by ex_elim [l37, l36]
l39: $ G , H ⇒ (∃ x ∃ qF2 ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel)) → Cf $ by imp_intro [l38]
l40: $ G , H ⇒ (∃ x ∃ y ∃ qT (t1 = ⟨ kc_tcons , scons x (scons y (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ∧ t4 = y) ∨ ∃ x ∃ qF2 ∃ y ∃ qC2 ∃ qT ∃ qi_v (t1 = ⟨ kc_tcons , scons qF2 (scons qC2 (scons qT ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons qi_v ∅ ⟩ ∧ t3 = x ∧ t4 = y ∧ ra_nth_ty qT qi_v x y ∈ lrel)) → Cf $ by or_elim_imp [l18, l39]
l41: $ G , H ⇒ Cf $ by imp_elim [l40, l2]

--| @freshen G x
lemma f26_tw_n {x: set} (G: hyps) (J: class) (td tn tnp tl tc: set) (ty k1 j1 vo vn vf ve: set): $ G ⇒ crn j1 ⊆ f26_tw_q J td tn tnp tl tc $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ vo ∊ trees ω $ > $ G ⇒ ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J $ > $ G ⇒ ra_nth_ty ty vn vf ve ∈ lrel $ > $ G ⇒ ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $
----
l1: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J $ by weaken [#6]
l3: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ vo ∈ trees ω $ by welc_wcel [weaken [#5]]
l4: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ctors_wf td tn tnp tl vo tc ve ∈ lrel3 J $ by f26_tw_hd [l2, and_elim_l [l1]]
l5: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ vo = vo $ by eq_refl
l6: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add vo vn vo ∈ lrel $ by wcel_eq_l [ra_add_eq [l5, eq_sym [and_elim_r [l1]], l5], lrel_add_z [l3]]
l7: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by ex_intro [and_intro [l6, l4]]
l8: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel $ by ax
l9: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ ra_tys_wf td tn tnp tl vo tc ty ∈ lrel3 J $ by weaken [#6]
l10: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ vo ∈ trees ω $ by welc_wcel [weaken [#5]]
l11: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ ra_tys_wf td tn tnp tl ⟨ kc_s , scons vo ∅ ⟩ tc t ∈ lrel3 J $ by tys_wf_tail [l9, and_elim_l [l8]]
l12: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ isset ∅ $ by ax_empty
l13: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ isset (scons t ∅) $ by scons_set [l12]
l14: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ isset (scons c (scons t ∅)) $ by scons_set [l13]
l15: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ isset (scons a (scons c (scons t ∅))) $ by scons_set [l14]
l16: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ crn j1 ⊆ f26_tw_q J td tn tnp tl tc $ by weaken [#1]
l17: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l18: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
l19: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ crn (scons a (scons c (scons t ∅))) ⊆ f26_tw_q J td tn tnp tl tc $ by node_crn_sub [l16, l17, and_elim_l [l8], wcel_isset [l18], l15]
l20: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ crn (scons c (scons t ∅)) ⊆ f26_tw_q J td tn tnp tl tc $ by crn_scons_tail [l19]
l21: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ crn (scons t ∅) ⊆ f26_tw_q J td tn tnp tl tc $ by crn_scons_tail [l20]
l22: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ isset t $ by isset_var
l23: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ t ∈ f26_tw_q J td tn tnp tl tc $ by crn_scons_head [l22, l21]
l24: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ isset ω $ by omega_set
l25: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l26: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l27: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ ⟨ kc_s , scons vo ∅ ⟩ ∈ trees ω $ by trees_intro_c [l24, l25, scons_fseq_c [l10, l26]]
l28: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ x1 = ⟨ kc_s , scons vo ∅ ⟩ $ by ax
l29: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ td = td $ by eq_refl
l30: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ tn = tn $ by eq_refl
l31: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ tnp = tnp $ by eq_refl
l32: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ tl = tl $ by eq_refl
l33: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ tc = tc $ by eq_refl
l34: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ t = t $ by eq_refl
l35: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ ra_tys_wf td tn tnp tl x1 tc t ∈ lrel3 J $ by wcel_eq_l [ra_tys_wf_eq [l29, l30, l31, l32, eq_sym [l28], l33, l34], weaken [l11]]
l36: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ x1 ∊ trees ω $ by wcel_welc [wcel_eq_l [eq_sym [l28], weaken [l27]]]
l37: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ ∃ z (ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J) $ by f26_tw_e [wcel_welc [weaken [l23]], l36, l35, weaken [and_elim_r [and_elim_r [l8]]]]
l38: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J $ by ax
l39: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ x1 = ⟨ kc_s , scons vo ∅ ⟩ $ by ax
l40: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ m = m $ by eq_refl
l41: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ z = z $ by eq_refl
l42: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ ra_add ⟨ kc_s , scons vo ∅ ⟩ m z ∈ lrel $ by wcel_eq_l [ra_add_eq [l39, l40, l41], and_elim_l [l38]]
l43: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ ra_add vo ⟨ kc_s , scons m ∅ ⟩ z ∈ lrel $ by add_shift [l42]
l44: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ vo = vo $ by eq_refl
l45: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ ra_add vo vn z ∈ lrel $ by wcel_eq_l [ra_add_eq [l44, eq_sym [weaken [and_elim_l [and_elim_r [l8]]]], l41], l43]
l46: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ , ra_add x1 m z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc ve ∈ lrel3 J ⇒ ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by ex_intro [and_intro [l45, and_elim_r [l38]]]
l47: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel , x1 = ⟨ kc_s , scons vo ∅ ⟩ ⇒ ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by ex_elim [l37, l46]
l48: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ isset ⟨ kc_s , scons vo ∅ ⟩ $ by opair_isset
l49: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vn = ⟨ kc_s , scons m ∅ ⟩ ∧ ra_nth_ty t m vf ve ∈ lrel ⇒ ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by isset_elim [l48, l47]
l50: $ G ⇒ ∃ x (ra_add vo vn x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc ve ∈ lrel3 J) $ by f21_inv_nth_ty [#7, l7, l49]

lemma f26_tw_all (G: hyps) (J: class) (td tn tnp tl tc: set): $ G ⇒ trees ω ⊆ f26_tw_q J td tn tnp tl tc $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J , ra_nth_ty y n f e ∈ lrel ⇒ crn j ⊆ f26_tw_q J td tn tnp tl tc $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J , ra_nth_ty y n f e ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J , ra_nth_ty y n f e ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J , ra_nth_ty y n f e ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J , ra_nth_ty y n f e ∈ lrel ⇒ o ∊ trees ω $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J , ra_nth_ty y n f e ∈ lrel ⇒ ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J , ra_nth_ty y n f e ∈ lrel ⇒ ra_nth_ty y n f e ∈ lrel $ by ax
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J , ra_nth_ty y n f e ∈ lrel ⇒ ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J) $ by f26_tw_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω , ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J ⇒ ra_nth_ty y n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J) $ by imp_intro [l8]
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ , o ∊ trees ω ⇒ ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J → ra_nth_ty y n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J) $ by imp_intro [l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ ⇒ o ∊ trees ω → ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J → ra_nth_ty y n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J) $ by imp_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ ⇒ ∀ e (o ∊ trees ω → ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J → ra_nth_ty y n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J)) $ by all_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ ⇒ ∀ f ∀ e (o ∊ trees ω → ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J → ra_nth_ty y n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J)) $ by all_intro [l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ ⇒ ∀ n ∀ f ∀ e (o ∊ trees ω → ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J → ra_nth_ty y n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J)) $ by all_intro [l13]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ ⇒ ∀ o ∀ n ∀ f ∀ e (o ∊ trees ω → ra_tys_wf td tn tnp tl o tc y ∈ lrel3 J → ra_nth_ty y n f e ∈ lrel → ∃ x (ra_add o n x ∈ lrel ∧ ra_ctors_wf td tn tnp tl x tc e ∈ lrel3 J)) $ by all_intro [l14]
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ ⇒ y ∊ f26_tw_q J td tn tnp tl tc $ by cab_intro [l15]
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l18: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ f26_tw_q J td tn tnp tl tc $ by wcel_intro [l17, l16]
l19: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l20: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f26_tw_q J td tn tnp tl tc ⇒ ⟨ i , j ⟩ ∈ f26_tw_q J td tn tnp tl tc $ by isset_elim [l19, l18]
l21: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f26_tw_q J td tn tnp tl tc → ⟨ i , j ⟩ ∈ f26_tw_q J td tn tnp tl tc $ by imp_intro [imp_intro [imp_intro [l20]]]
l22: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f26_tw_q J td tn tnp tl tc → ⟨ i , j ⟩ ∈ f26_tw_q J td tn tnp tl tc) $ by all_intro [all_intro [l21]]
l23: $ G ⇒ isset ω $ by omega_set
l24: $ G ⇒ trees ω ⊆ f26_tw_q J td tn tnp tl tc $ by trees_ind_c [l23, l22]

tys_wf_nth_ctors
----------------
l1: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ x1 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_nth_ty tt ti tf te ∈ lrel $ by weaken [#2]
l3: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ td = td $ by eq_refl
l4: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tn = tn $ by eq_refl
l5: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tnp = tnp $ by eq_refl
l6: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tl = tl $ by eq_refl
l7: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tc = tc $ by eq_refl
