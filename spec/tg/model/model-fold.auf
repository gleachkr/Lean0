l49: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel ⇒ crn (scons a (scons p ∅)) ⊆ f14_ec_q M u w s $ by node_crn_sub [weaken [#1], weaken [#2], and_elim_l [l46], wcel_isset [l47], scons_set [scons_set [l48]]]
l50: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vb = k ∧ vt = ⟨ kc_cons , scons a (scons z ∅) ⟩ ∧ ra_capp p k z ∈ lrel ⇒ isset p $ by isset_var
