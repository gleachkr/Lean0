l140: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis c d ∈ lrel , ∃ t (⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u E c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g ∧ vt = scons (etel u E b w vr) t) ⇒ ∃ t (⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u E c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g ∧ vt = scons (etel u E b w vr) t) $ by ax
l141: $ … ⇒ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = cdm vf → vg' i = vf' m) $ by ex_elim [l140, l139]
l142: $ G , ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ vn = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis c d ∈ lrel , ∃ g ∃ t (⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u E c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g ∧ vt = scons (etel u E b w vr) t) ⇒ ∃ g ∃ t (⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u E c w (scons x vr) ∧ vf = ssnoc f x ∧ vg = scons x g ∧ vt = scons (etel u E b w vr) t) $ by ax
