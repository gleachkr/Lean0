l71: $ G , x0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ ⇒ ∀ d ∀ c ∀ y (d ∊ u → c = scons d c0 → y = scons d r → esat u (dsh u M y) tmr w = {l | l ∊ fseq u ∧ cdm l = nvf' tk2 ∧ ∀ i (i ∊ nvf' tn → nvf' tj2 ⊆ i → vat (l ++ c) (nvf' tn) i ∈ imot u (dnf u M) td i w p (lv tv w))}) $ by weaken [#27]
