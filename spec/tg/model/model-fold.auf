lemma f5_idx (G: hyps) (N J: class) (a r d: set): $ G ⇒ d ∊ trees ω $ > $ G ⇒ N ∈ ω $ > $ G ⇒ J ∈ ω $ > $ G ⇒ (scons a r)' (nadd (nadd (nvf' ⟨ kc_s , scons d ∅ ⟩) N) J) = r' (nadd (nadd (nvf' d) N) J) $
----
l1: $ G ⇒ nvf' ⟨ kc_s , scons d ∅ ⟩ = suc (nvf' d) $ by nvf_s [welc_wcel [#1]]
l2: $ G ⇒ isset d $ by isset_var
l3: $ G ⇒ nvf' d ∈ ω $ by nvf_omega [l2]
l4: $ G ⇒ nadd (suc (nvf' d)) N = suc (nadd (nvf' d) N) $ by suc_nadd_c [wcel_isset [l3], #2]
l5: $ G ⇒ N = N $ by eq_refl
l6: $ G ⇒ nadd (nvf' ⟨ kc_s , scons d ∅ ⟩) N = suc (nadd (nvf' d) N) $ by eq_trans [nadd_eq [l1, l5], l4]
l7: $ G ⇒ nadd (nvf' d) N ∈ ω $ by nadd_omega_c [l3, #2]
l8: $ G ⇒ nadd (suc (nadd (nvf' d) N)) J = suc (nadd (nadd (nvf' d) N) J) $ by suc_nadd_c [wcel_isset [l7], #3]
l9: $ G ⇒ J = J $ by eq_refl
l10: $ G ⇒ nadd (nadd (nvf' ⟨ kc_s , scons d ∅ ⟩) N) J = suc (nadd (nadd (nvf' d) N) J) $ by eq_trans [nadd_eq [l6, l9], l8]
l11: $ G ⇒ nadd (nadd (nvf' d) N) J ∈ ω $ by nadd_omega_c [l7, #3]
l12: $ G ⇒ isset a $ by isset_var
l13: $ G ⇒ isset r $ by isset_var
l14: $ G ⇒ (scons a r)' (suc (nadd (nadd (nvf' d) N) J)) = r' (nadd (nadd (nvf' d) N) J) $ by scons_fv_suc_c [l12, l13, wcel_isset [l11]]
l15: $ G ⇒ scons a r = scons a r $ by eq_refl
l16: $ G ⇒ (scons a r)' (nadd (nadd (nvf' ⟨ kc_s , scons d ∅ ⟩) N) J) = r' (nadd (nadd (nvf' d) N) J) $ by eq_trans [fv_eq [l15, l10], l14]

lemma f5_win (G: hyps) (N: class) (a r d: set): $ G ⇒ d ∊ trees ω $ > $ G ⇒ N ∈ ω $ > $ G ⇒ swin (scons a r) (nvf' ⟨ kc_s , scons d ∅ ⟩) N = swin r (nvf' d) N $
----
l1: $ G , i ∊ N ⇒ d ∊ trees ω $ by weaken [#1]
l2: $ G , i ∊ N ⇒ N ∈ ω $ by weaken [#2]
l3: $ G , i ∊ N ⇒ i ∊ N $ by ax
l4: $ G , i ∊ N ⇒ i ∈ ω $ by omega_elem_omega_c [welc_wcel [l3], l2]
l5: $ G , i ∊ N ⇒ nvf' ⟨ kc_s , scons d ∅ ⟩ = suc (nvf' d) $ by nvf_s [welc_wcel [l1]]
l6: $ G , i ∊ N ⇒ isset d $ by isset_var
l7: $ G , i ∊ N ⇒ nvf' d ∈ ω $ by nvf_omega [l6]
l8: $ G , i ∊ N ⇒ nadd (suc (nvf' d)) i = suc (nadd (nvf' d) i) $ by suc_nadd_c [wcel_isset [l7], l4]
l9: $ G , i ∊ N ⇒ i = i $ by eq_refl
l10: $ G , i ∊ N ⇒ nadd (nvf' ⟨ kc_s , scons d ∅ ⟩) i = suc (nadd (nvf' d) i) $ by eq_trans [nadd_eq [l5, l9], l8]
l11: $ G , i ∊ N ⇒ nadd (nvf' d) i ∈ ω $ by nadd_omega_c [l7, l4]
l12: $ G , i ∊ N ⇒ isset a $ by isset_var
l13: $ G , i ∊ N ⇒ isset r $ by isset_var
l14: $ G , i ∊ N ⇒ (scons a r)' (suc (nadd (nvf' d) i)) = r' (nadd (nvf' d) i) $ by scons_fv_suc_c [l12, l13, wcel_isset [l11]]
l15: $ G , i ∊ N ⇒ scons a r = scons a r $ by eq_refl
l16: $ G , i ∊ N ⇒ (scons a r)' (nadd (nvf' ⟨ kc_s , scons d ∅ ⟩) i) = r' (nadd (nvf' d) i) $ by eq_trans [fv_eq [l15, l10], l14]
l17: $ G ⇒ i ∊ N → (scons a r)' (nadd (nvf' ⟨ kc_s , scons d ∅ ⟩) i) = r' (nadd (nvf' d) i) $ by imp_intro [l16]
l18: $ G ⇒ ∀ i (i ∊ N → (scons a r)' (nadd (nvf' ⟨ kc_s , scons d ∅ ⟩) i) = r' (nadd (nvf' d) i)) $ by all_intro [l17]
l19: $ G ⇒ swin (scons a r) (nvf' ⟨ kc_s , scons d ∅ ⟩) N = swin r (nvf' d) N $ by swin_sh [l18]

