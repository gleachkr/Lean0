l171: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel ⇒ h ∊ trees ω ∧ l ∊ trees ω $ by trees_kids2 [l169, l168, wcel_isset [l170]]
l172: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel ⇒ w = w $ by eq_refl
l173: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel ⇒ x3 = x3 $ by eq_refl
l174: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel ⇒ ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons h (scons l ∅) ⟩ w x3 $ by wcel_eq_r [etel_eq [l167, l172, l173], l164]
l175: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel ⇒ ∃ x ∃ f ∃ g ∃ t (x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t) $ by etel_pi_all [and_elim_l [l171], and_elim_r [l171], l161, l163, l174]
l176: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel , x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t , q = scons x x3 ⇒ x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t $ by ax
l177: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel , x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t , q = scons x x3 ⇒ q = scons x x3 $ by ax
l178: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel , x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t , q = scons x x3 ⇒ h ∊ trees ω ∧ l ∊ trees ω $ by weaken [l171]
l179: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel , x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t , q = scons x x3 ⇒ l ∈ trees ω $ by welc_wcel [and_elim_r [l178]]
l180: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel , x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t , q = scons x x3 ⇒ l = l $ by eq_refl
l181: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel , x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t , q = scons x x3 ⇒ w = w $ by eq_refl
l182: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel , x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t , q = scons x x3 ⇒ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w q $ by wcel_eq_r [etel_eq [l180, l181, eq_sym [l177]], and_elim_l [and_elim_r [and_elim_r [l176]]]]
l183: $ G , n = cdm q1 , k ∊ ω , ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel → cdm x5 = k → x3 ∊ fseq u → x4 ∊ dt u M x1 w x3 → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 → nest x8 (apn x4 x5) ∈ x3' (nadd (nadd (nvf' x2) (nvf' t3)) (nvf' t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ x8 = e ++ swin x3 (nvf' x2) (nvf' t3) ∧ cdm x8 = nadd (nvf' m) (nvf' t3))) , z = suc k , ra_recfield t1 t2 t3 x2 x1 t6 ∈ lrel , cdm x5 = z , x3 ∊ fseq u , x4 ∊ dt u M x1 w x3 , ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x1 w x3 , t1 = a ∧ t2 = b ∧ t3 = c ∧ x2 = d ∧ x1 = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t6 = j ∧ ra_recfield a b c ⟨ kc_s , scons d ∅ ⟩ l j ∈ lrel , x ∊ da ((dnf u M)' h) w x3 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) l w (scons x x3) ∧ x5 = ssnoc f x ∧ x6 = scons x g ∧ x7 = scons (etel u (dnf u M) h w x3) t , q = scons x x3 ⇒ f ∊ fseq u $ by and_elim_l [etel_fseq [l179, l182]]
