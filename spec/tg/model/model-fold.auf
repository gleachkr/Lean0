l109: $ G , x1 = ifam u (dnf u (mcv H)) td w , x2 = sarg u (dnf u (mcv H)) tS w r , x3 = nvf' ti , ⟨ nvf' ti , ⟨ x2 , n ⟩ ⟩ ∈ x1 ∧ x = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⇒ ra_isort tF tq tl ∈ lrel $ by weaken [#7]
l110: $ G , x1 = ifam u (dnf u (mcv H)) td w , x2 = sarg u (dnf u (mcv H)) tS w r , x3 = nvf' ti , ⟨ nvf' ti , ⟨ x2 , n ⟩ ⟩ ∈ x1 ∧ x = {y | ¬ iprop td (nvf' ti) w ∧ y ∊ n} ⇒ ∃ p ∃ c ∃ k ∃ f ∃ g ∃ t ∃ e (p ∊ esat u (dnf u (mcv H)) tp w ∧ ictk td x3 c k ∧ ⟨ f , ⟨ g , ⟨ t , x2 ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) ∧ n = scons c g ∧ x2 = e ++ p ∧ e ∊ fseq u ∧ cdm e = nvf' tq) $ by ifam_pt_full [l104, l105, l106, l103, l107, eq_sym [l108], l109]
