l36: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ s1 ∊ esat u E tp w $ by weaken [#7]
l37: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ cdm s1 = cdm a $ by eq_trans [esat_clen [l34, l35, l36], eq_sym [esat_clen [l34, l35, and_elim_l [l27]]]]
l38: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset (nest s2 (nest s3 (d))) $ by nest_set
l39: $ G , x6 = nest s1 (nest s2 (nest s3 (d))) , a ∊ esat u E tp w ∧ c ∊ imots u E td w a V ∧ m ∊ imins u E td w a c ∧ b ∊ imq u E td J w a ∧ b ∊ fseq u ∧ x6 = nest a (nest c (nest m (nest b e))) ⇒ isset (nest c (nest m (nest b e))) $ by nest_set
