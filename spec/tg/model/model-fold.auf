l18: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f30_si_q td tn ta tb → ⟨ x8 , x9 ⟩ ∈ f30_si_q td tn ta tb $ by imp_intro [imp_intro [imp_intro [l17]]]
l19: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f30_si_q td tn ta tb → ⟨ x8 , x9 ⟩ ∈ f30_si_q td tn ta tb) $ by all_intro [all_intro [l18]]
l20: $ G ⇒ isset ω $ by omega_set
l21: $ G ⇒ trees ω ⊆ f30_si_q td tn ta tb $ by trees_ind_c [l20, l19]

sinst_ind_ty_inv
