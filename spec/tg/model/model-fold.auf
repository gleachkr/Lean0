lemma f29_pc_all (G: hyps) (tg tt: set): $ G ⇒ trees ω ⊆ f29_pc_q tg tt $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel , ra_pis tg m tt ∈ lrel ⇒ crn x9 ⊆ f29_pc_q tg tt $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel , ra_pis tg m tt ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel , ra_pis tg m tt ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel , ra_pis tg m tt ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel , ra_pis tg m tt ∈ lrel ⇒ ra_capp y tg r ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel , ra_pis tg m tt ∈ lrel ⇒ ra_pis y b m ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel , ra_pis tg m tt ∈ lrel ⇒ ra_pis tg m tt ∈ lrel $ by ax
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel , ra_pis tg m tt ∈ lrel ⇒ ra_pis r b tt ∈ lrel $ by f29_pc_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel , ra_pis y b m ∈ lrel ⇒ ra_pis tg m tt ∈ lrel → ra_pis r b tt ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ , ra_capp y tg r ∈ lrel ⇒ ra_pis y b m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis r b tt ∈ lrel $ by imp_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ ⇒ ra_capp y tg r ∈ lrel → ra_pis y b m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis r b tt ∈ lrel $ by imp_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ ⇒ ∀ m (ra_capp y tg r ∈ lrel → ra_pis y b m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis r b tt ∈ lrel) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ ⇒ ∀ b ∀ m (ra_capp y tg r ∈ lrel → ra_pis y b m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis r b tt ∈ lrel) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ ⇒ ∀ r ∀ b ∀ m (ra_capp y tg r ∈ lrel → ra_pis y b m ∈ lrel → ra_pis tg m tt ∈ lrel → ra_pis r b tt ∈ lrel) $ by all_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_pc_q tg tt $ by cab_intro [l14]
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_pc_q tg tt $ by wcel_intro [l16, l15]
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l19: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_pc_q tg tt ⇒ ⟨ x8 , x9 ⟩ ∈ f29_pc_q tg tt $ by isset_elim [l18, l17]
l20: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_pc_q tg tt → ⟨ x8 , x9 ⟩ ∈ f29_pc_q tg tt $ by imp_intro [imp_intro [imp_intro [l19]]]
l21: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_pc_q tg tt → ⟨ x8 , x9 ⟩ ∈ f29_pc_q tg tt) $ by all_intro [all_intro [l20]]
l22: $ G ⇒ isset ω $ by omega_set
l23: $ G ⇒ trees ω ⊆ f29_pc_q tg tt $ by trees_ind_c [l22, l21]

pis_capp
--------
l1: $ G ⇒ ⟨ kr_capp , scons tp (scons tg (scons tr ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tr ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tg (scons tr ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tp (scons tg (scons tr ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l7: $ G ⇒ kr_capp ∈ ω ∧ scons tp (scons tg (scons tr ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons tp (scons tg (scons tr ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ isset ω $ by omega_set
l10: $ G ⇒ tp ∈ trees ω $ by crn_scons_head_trees [l9, l8]
l11: $ G ⇒ trees ω ⊆ f29_pc_q tg tt $ by f29_pc_all
l12: $ G ⇒ tp ∊ f29_pc_q tg tt $ by subset_elim [l11, wcel_welc [l10]]
l13: $ G ⇒ ra_pis tr tb tt ∈ lrel $ by f29_pc_e [l12, #1, #2, #3]

def f29_mc_q (t1 t2 t3: set) (.y .j .q .n .m: set): class = $ {y | ∀ j ∀ q ∀ n ∀ m (ra_motives t1 t2 t3 j y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q n ∈ lrel)} $

lemma f29_mc_e (G: hyps) (t1 t2 t3: set) (ty vj vq vn vm: set): $ G ⇒ ty ∊ f29_mc_q t1 t2 t3 $ > $ G ⇒ ra_motives t1 t2 t3 vj ty vq ∈ lrel $ > $ G ⇒ ra_ntys ty vn vm ∈ lrel $ > $ G ⇒ ra_clen vq vn ∈ lrel $
----
l1: $ G ⇒ ∀ j ∀ q ∀ n ∀ m (ra_motives t1 t2 t3 j ty q ∈ lrel → ra_ntys ty n m ∈ lrel → ra_clen q n ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ q ∀ n ∀ m (ra_motives t1 t2 t3 vj ty q ∈ lrel → ra_ntys ty n m ∈ lrel → ra_clen q n ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ∀ n ∀ m (ra_motives t1 t2 t3 vj ty vq ∈ lrel → ra_ntys ty n m ∈ lrel → ra_clen vq n ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ∀ m (ra_motives t1 t2 t3 vj ty vq ∈ lrel → ra_ntys ty vn m ∈ lrel → ra_clen vq vn ∈ lrel) $ by all_elim [l3]
l5: $ G ⇒ ra_motives t1 t2 t3 vj ty vq ∈ lrel → ra_ntys ty vn vm ∈ lrel → ra_clen vq vn ∈ lrel $ by all_elim [l4]
