l14: $ G ⇒ ⟨ vd , ⟨ ve , ⟨ vf , vn ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r2 → ∀ x0 (vo' x0 = vn' x0) → dt u M t2 w r1 = dt u M t2 w r2 $ by imp_elim [l13, #6]
l15: $ G ⇒ ∀ x0 (vo' x0 = vn' x0) → dt u M t2 w r1 = dt u M t2 w r2 $ by imp_elim [l14, #7]
l16: $ G ⇒ dt u M t2 w r1 = dt u M t2 w r2 $ by imp_elim [l15, #8]

--| @freshen G x0
lemma f9_ha_n {x0: set} (G: hyps) (M: class) (u w r1 r2 t2: set) (ty k1 j1 vo vn va vb vc vd ve vf: set): $ G ⇒ crn j1 ⊆ f9_ha_q M u w r1 r2 t2 $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r1 ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ > $ G ⇒ ra_has_arg ty t2 ∈ lrel $ > $ G ⇒ ⟨ va , ⟨ vb , ⟨ vc , vo ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r1 $ > $ G ⇒ ⟨ vd , ⟨ ve , ⟨ vf , vn ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r2 $ > $ G ⇒ ∀ x0 (vo' x0 = vn' x0) $ > $ G ⇒ dt u M t2 w r1 = dt u M t2 w r2 $
----
l1: $ G ⇒ ∃ x ∃ z (ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z) ∨ ∃ x ∃ z ∃ q (ty = ⟨ kc_app , scons x (scons q ∅) ⟩ ∧ t2 = z ∧ ra_has_arg x z ∈ lrel) $ by lrel_has_arg_cases [#8]
l2: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z $ by ax
l3: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ ty ∊ trees ω $ by trees_omega_intro [weaken [#3], weaken [#4], weaken [#2]]
l4: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ ⟨ kc_app , scons x (scons z ∅) ⟩ ∈ trees ω $ by wcel_eq_l [and_elim_l [l2], welc_wcel [l3]]
l5: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ isset ω $ by omega_set
l6: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ kc_app ∈ ω $ by kc_app_omega
l7: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ x ∊ trees ω ∧ z ∊ trees ω $ by trees_kids2 [l5, l4, wcel_isset [l6]]
l8: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ w ∊ lvals $ by weaken [#5]
l9: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ r1 ∊ fseq u $ by weaken [#6]
l10: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ w = w $ by eq_refl
l11: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ r1 = r1 $ by eq_refl
l12: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ ⟨ va , ⟨ vb , ⟨ vc , vo ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r1 $ by weaken [#9]
l13: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ ⟨ va , ⟨ vb , ⟨ vc , vo ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_app , scons x (scons z ∅) ⟩ w r1 $ by wcel_eq_r [etel_eq [and_elim_l [l2], l10, l11], l12]
