l39: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = b ∧ tj = a ∧ ra_indapp z u v w b a ∈ lrel , z = f ∧ u = g ∧ v = k ∧ w = e ∧ b = q ∧ a = h ∧ ra_spine ⟨ kc_bvar , scons m ∅ ⟩ q o ∈ lrel ∧ ra_add e k l ∈ lrel ∧ ra_add l h m ∈ lrel ∧ ra_le ⟨ kc_s , scons h ∅ ⟩ g ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons m ∅ ⟩ e k p ∈ lrel ∧ ra_nidx f h n ∈ lrel ∧ ra_iargs l n p q ∈ lrel ⇒ nvf' ⟨ kc_s , scons h ∅ ⟩ ⊆ nvf' g $ by lrel_le_sem_c [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l37]]]]]]]]]], l38]
