l7: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_bvar , scons z ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons z ∅ ⟩ ∧ ra_le ⟨ kc_s , scons z ∅ ⟩ tk ∈ lrel ⇒ ⟨ kc_pi , scons ta (scons tb ∅) ⟩ = ⟨ kc_bvar , scons z ∅ ⟩ $ by eq_trans [eq_sym [weaken [l1]], and_elim_l [l6]]
l8: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_bvar , scons z ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons z ∅ ⟩ ∧ ra_le ⟨ kc_s , scons z ∅ ⟩ tk ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l9: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_bvar , scons z ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons z ∅ ⟩ ∧ ra_le ⟨ kc_s , scons z ∅ ⟩ tk ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
