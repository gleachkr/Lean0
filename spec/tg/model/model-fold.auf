l33: $ G , iprt td x1 x2 ∧ nvf' x3 = j ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = c ∧ ra_nth_ctor x5 x6 K ∈ lrel , i = nvf' x6 , b ∊ ofsort lsig lopen ks_nat ∧ nvf' b = i , ra_minor_idx x2 x3 b k ∈ lrel ∧ k ∊ ofsort lsig lopen ks_nat , l = nvf' k ⇒ iminx td j c l $ by iminx_eq [l28, l29, l30, eq_sym [l31], l32]
l34: $ G , iprt td x1 x2 ∧ nvf' x3 = j ∧ ra_nth_ty x2 x3 x4 x5 ∈ lrel ∧ nvf' x6 = c ∧ ra_nth_ctor x5 x6 K ∈ lrel , i = nvf' x6 , b ∊ ofsort lsig lopen ks_nat ∧ nvf' b = i , ra_minor_idx x2 x3 b k ∈ lrel ∧ k ∊ ofsort lsig lopen ks_nat , l = nvf' k ⇒ ∃ k (iminx td j c k) $ by ex_intro [l33]
