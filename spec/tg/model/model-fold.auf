l12: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l13: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l10, l11, l12]
l14: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ x1 ∊ trees ω $ by wcel_welc [wcel_eq_l [eq_sym [l1], l13]]
l15: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ trees ω ⊆ f26_tw_q J td tn tnp tl tc $ by f26_tw_all
l16: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kr_nth_ty , scons tt (scons ti (scons tf (scons te ∅))) ⟩ ∈ latoms $ by lrel_latoms [l2]
l17: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l18: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons te ∅) $ by scons_set [l17]
l19: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons tf (scons te ∅)) $ by scons_set [l18]
l20: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons ti (scons tf (scons te ∅))) $ by scons_set [l19]
l21: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons tt (scons ti (scons tf (scons te ∅)))) $ by scons_set [l20]
l22: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_nth_ty ∈ ω $ by kr_nth_ty_omega
l23: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_nth_ty ∈ ω ∧ scons tt (scons ti (scons tf (scons te ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l16, wcel_isset [l22], l21]
l24: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ crn (scons tt (scons ti (scons tf (scons te ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l23]]
l25: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l26: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tt ∈ trees ω $ by crn_scons_head_trees [l25, l24]
l27: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ tt ∊ f26_tw_q J td tn tnp tl tc $ by subset_elim [l15, wcel_welc [l26]]
l28: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ z (ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J) $ by f26_tw_e [l27, l14, l9, l2]
l29: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J $ by ax
l30: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ x1 = ⟨ kc_nz , ∅ ⟩ $ by ax
l31: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ ti = ti $ by eq_refl
l32: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ z = z $ by eq_refl
l33: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ti z ∈ lrel $ by wcel_eq_l [ra_add_eq [l30, l31, l32], and_elim_l [l29]]
l34: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ z = ti $ by add_zero_l [l33]
l35: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ td = td $ by eq_refl
l36: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ tn = tn $ by eq_refl
l37: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ tnp = tnp $ by eq_refl
l38: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ tl = tl $ by eq_refl
l39: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ tc = tc $ by eq_refl
l40: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ te = te $ by eq_refl
l41: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , ra_add x1 ti z ∈ lrel ∧ ra_ctors_wf td tn tnp tl z tc te ∈ lrel3 J ⇒ ra_ctors_wf td tn tnp tl ti tc te ∈ lrel3 J $ by wcel_eq_l [ra_ctors_wf_eq [l35, l36, l37, l38, l34, l39, l40], and_elim_r [l29]]
l42: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ctors_wf td tn tnp tl ti tc te ∈ lrel3 J $ by ex_elim [l28, l41]
l43: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l44: $ G ⇒ ra_ctors_wf td tn tnp tl ti tc te ∈ lrel3 J $ by isset_elim [l43, l42]

def f26_pc_q (tk: set) (.y .f .r .q .x: set): class = $ {y | ∀ f ∀ r ∀ q (ra_pis y f r ∈ lrel → ra_closed tk r ∈ lrel → ra_clen y q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel))} $

--| @freshen G x
lemma f26_pc_e {x: set} (G: hyps) (tk: set) (ty vf vr vq: set): $ G ⇒ ty ∊ f26_pc_q tk $ > $ G ⇒ ra_pis ty vf vr ∈ lrel $ > $ G ⇒ ra_closed tk vr ∈ lrel $ > $ G ⇒ ra_clen ty vq ∈ lrel $ > $ G ⇒ ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $
----
l1: $ G ⇒ ∀ f ∀ r ∀ q (ra_pis ty f r ∈ lrel → ra_closed tk r ∈ lrel → ra_clen ty q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x f ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r ∀ q (ra_pis ty vf r ∈ lrel → ra_closed tk r ∈ lrel → ra_clen ty q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x vf ∈ lrel)) $ by all_elim [l1]
l3: $ G ⇒ ∀ q (ra_pis ty vf vr ∈ lrel → ra_closed tk vr ∈ lrel → ra_clen ty q ∈ lrel → ∃ x (ra_add tk q x ∈ lrel ∧ ra_closed x vf ∈ lrel)) $ by all_elim [l2]
l4: $ G ⇒ ra_pis ty vf vr ∈ lrel → ra_closed tk vr ∈ lrel → ra_clen ty vq ∈ lrel → ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $ by all_elim [l3]
l5: $ G ⇒ ra_closed tk vr ∈ lrel → ra_clen ty vq ∈ lrel → ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $ by imp_elim [l4, #2]
l6: $ G ⇒ ra_clen ty vq ∈ lrel → ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $ by imp_elim [l5, #3]
l7: $ G ⇒ ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $ by imp_elim [l6, #4]

--| @freshen H qA
--| @freshen H qP
lemma f21_inv_pis {qA qP: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_pis t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 ⇒ Cf $ > $ H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ ra_pis qP ⟨ kc_pi , scons qA (scons t2 ∅) ⟩ t3 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_pis t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) $ by lrel_pis_cases [l1]
l3: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x $ by ax
l4: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t3 = t2 $ by eq_trans [and_elim_r [and_elim_r [l3]], eq_sym [and_elim_l [and_elim_r [l3]]]]
l5: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 $ by and_intro [and_elim_l [l3], l4]
l6: $ H ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by weaken [l6]
l8: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel $ by ax
l13: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l14: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ qA = qA $ by eq_refl
l15: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ kc_pi = kc_pi $ by eq_refl
l16: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ qP = qP $ by eq_refl
l17: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ ra_pis qP ⟨ kc_pi , scons qA (scons t2 ∅) ⟩ t3 ∈ lrel $ by wcel_eq_l [ra_pis_eq [l16, opair_eq [l15, scons_eq [l14, scons_eq [eq_sym [and_elim_l [and_elim_r [l12]]], l13]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [l12]]]]], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l18: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ ra_pis qP ⟨ kc_pi , scons qA (scons t2 ∅) ⟩ t3 ∈ lrel $ by and_intro [and_elim_l [l12], l17]
l19: $ H ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ ra_pis qP ⟨ kc_pi , scons qA (scons t2 ∅) ⟩ t3 ∈ lrel → Cf $ by imp_intro [#3]
l20: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ ra_pis qP ⟨ kc_pi , scons qA (scons t2 ∅) ⟩ t3 ∈ lrel → Cf $ by weaken [l19]
l21: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel ⇒ Cf $ by imp_elim [l20, l18]
l22: $ G , H , ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) ⇒ ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
l24: $ G , H , ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) ⇒ ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) ⇒ ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H , ∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) ⇒ ∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel) $ by ax
l29: $ … ⇒ Cf $ by ex_elim [l28, l27]
l30: $ G , H ⇒ (∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel)) → Cf $ by imp_intro [l29]
l31: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ x ∃ y ∃ qP (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = y ∧ ra_pis qP ⟨ kc_pi , scons qA (scons x ∅) ⟩ y ∈ lrel)) → Cf $ by or_elim_imp [l11, l30]
l32: $ G , H ⇒ Cf $ by imp_elim [l31, l2]

--| @freshen H qA
--| @freshen H qG_v
--| @freshen H qn_v
lemma f21_inv_clen {qA qG_v qn_v: set} (G H: hyps) (Cf: fml) (t1 t2: set): $ G ⇒ ra_clen t1 t2 ∈ lrel $ > $ H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_clen t1 t2 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ qA ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel) $ by lrel_clen_cases [l1]
l3: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l4: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [and_elim_l [l3], and_elim_r [l3]]
l5: $ H ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l6: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l5]
l7: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ by imp_elim [l6, l4]
l8: $ G , H ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) → Cf $ by imp_intro [l7]
l9: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel $ by ax
l10: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel $ by and_intro [and_elim_l [l9], and_intro [and_elim_l [and_elim_r [l9]], and_elim_r [and_elim_r [l9]]]]
l11: $ H ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel → Cf $ by imp_intro [#3]
l12: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel → Cf $ by weaken [l11]
l13: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel ⇒ Cf $ by imp_elim [l12, l10]
l14: $ G , H , ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel) ⇒ ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H , ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel) ⇒ ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel) $ by ax
l17: $ … ⇒ Cf $ by ex_elim [l16, l15]
l18: $ G , H , ∃ qA ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel) ⇒ ∃ qA ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel) $ by ax
l19: $ … ⇒ Cf $ by ex_elim [l18, l17]
l20: $ G , H ⇒ (∃ qA ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel)) → Cf $ by imp_intro [l19]
l21: $ G , H ⇒ ((t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ qA ∃ qG_v ∃ qn_v (t1 = ⟨ kc_cons , scons qA (scons qG_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen qG_v qn_v ∈ lrel)) → Cf $ by or_elim_imp [l8, l20]
l22: $ G , H ⇒ Cf $ by imp_elim [l21, l2]

--| @freshen G x
lemma f26_pc_n {x: set} (G: hyps) (tk: set) (ty k1 j1 vf vr vq: set): $ G ⇒ crn j1 ⊆ f26_pc_q tk $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pis ty vf vr ∈ lrel $ > $ G ⇒ ra_closed tk vr ∈ lrel $ > $ G ⇒ ra_clen ty vq ∈ lrel $ > $ G ⇒ ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $
----
l1: $ G ⇒ ⟨ kr_closed , scons tk (scons vr ∅) ⟩ ∈ latoms $ by lrel_latoms [#6]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons vr ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tk (scons vr ∅)) $ by scons_set [l3]
l5: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
l6: $ G ⇒ kr_closed ∈ ω ∧ scons tk (scons vr ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l5], l4]
l7: $ G ⇒ crn (scons tk (scons vr ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l6]]
l8: $ G ⇒ isset ω $ by omega_set
l9: $ G ⇒ tk ∈ trees ω $ by crn_scons_head_trees [l8, l7]
l10: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf $ by ax
l11: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf ⇒ tk ∈ trees ω $ by weaken [l9]
l12: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf ⇒ ra_clen ty vq ∈ lrel $ by weaken [#7]
l13: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ $ by ax
l14: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ tk = tk $ by eq_refl
l15: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add tk vq tk ∈ lrel $ by wcel_eq_l [ra_add_eq [l14, eq_sym [and_elim_r [l13]], l14], lrel_add_z [weaken [l11]]]
l16: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed tk vf ∈ lrel $ by wcel_eq_l [ra_closed_eq [l14, weaken [and_elim_r [l10]]], weaken [#6]]
l17: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $ by ex_intro [and_intro [l15, l16]]
l18: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ vq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen d n ∈ lrel ⇒ ty = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ vq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen d n ∈ lrel $ by ax
l19: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ vq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen d n ∈ lrel ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_cons , scons b (scons d ∅) ⟩ $ by eq_trans [eq_sym [weaken [and_elim_l [l10]]], and_elim_l [l18]]
l20: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ vq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen d n ∈ lrel ⇒ kc_nil ∈ ω $ by kc_nil_omega
l21: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ vq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen d n ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l22: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ vq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen d n ∈ lrel ⇒ kc_nil = kc_cons $ by opair_inj_l_c [l19, wcel_isset [l20], wcel_isset [l21]]
l23: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ vq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen d n ∈ lrel ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
l24: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf , ty = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ vq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen d n ∈ lrel ⇒ ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $ by bot_elim [not_elim [l23, l22]]
l25: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vf ⇒ ∃ x (ra_add tk vq x ∈ lrel ∧ ra_closed x vf ∈ lrel) $ by f21_inv_clen [l12, l17, l24]
l26: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_pis p ⟨ kc_pi , scons a (scons vf ∅) ⟩ vr ∈ lrel ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_pis p ⟨ kc_pi , scons a (scons vf ∅) ⟩ vr ∈ lrel $ by ax
l27: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_pis p ⟨ kc_pi , scons a (scons vf ∅) ⟩ vr ∈ lrel ⇒ tk ∈ trees ω $ by weaken [l9]
l28: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_pis p ⟨ kc_pi , scons a (scons vf ∅) ⟩ vr ∈ lrel ⇒ ra_clen ty vq ∈ lrel $ by weaken [#7]
