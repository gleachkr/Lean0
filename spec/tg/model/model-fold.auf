--| @freshen H qnc
--| @freshen H qk2
--| @freshen H qF
--| @freshen H qC
--| @freshen H qT
--| @freshen H qM1
--| @freshen H qM2
lemma f21_inv_minors {qnc qk2 qF qC qT qM1 qM2: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7: set): $ G ⇒ ra_minors t1 t2 t3 t4 t5 t6 t7 ∈ lrel $ > $ H , t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ ⇒ Cf $ > $ H , t6 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ ra_cminors t1 t2 t3 t4 t5 ⟨ kc_nz , ∅ ⟩ qC qM1 ∈ lrel ∧ ra_clen_c qC qnc ∈ lrel ∧ ra_add t4 qnc qk2 ∈ lrel ∧ ra_minors t1 t2 t3 qk2 ⟨ kc_s , scons t5 ∅ ⟩ qT qM2 ∈ lrel ∧ ra_capp qM2 qM1 t7 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_minors t1 t2 t3 t4 t5 t6 t7 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ qnc ∃ qk2 ∃ qF ∃ qC ∃ qT ∃ qM1 ∃ qM2 ∃ w (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tcons , scons qF (scons qC (scons qT ∅)) ⟩ ∧ t7 = w ∧ ra_cminors x y z u v ⟨ kc_nz , ∅ ⟩ qC qM1 ∈ lrel ∧ ra_clen_c qC qnc ∈ lrel ∧ ra_add u qnc qk2 ∈ lrel ∧ ra_minors x y z qk2 ⟨ kc_s , scons v ∅ ⟩ qT qM2 ∈ lrel ∧ ra_capp qM2 qM1 w ∈ lrel) $ by lrel_minors_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ ⇒ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]
l5: $ H ⇒ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ → Cf $ by imp_intro [#2]
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ ⇒ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ → Cf $ by weaken [l5]
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ ⇒ Cf $ by imp_elim [l6, l4]
l8: $ G , H , ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ax
l9: $ … ⇒ Cf $ by ex_elim [l8, l7]
l10: $ G , H , ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ax
l11: $ … ⇒ Cf $ by ex_elim [l10, l9]
l12: $ G , H , ∃ z ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ z ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ y ∃ z ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ y ∃ z ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H , ∃ x ∃ y ∃ z ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ x ∃ y ∃ z ∃ u ∃ v (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ax
