l12: $ G , H , ∃ y ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel) ⇒ ∃ y ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel) $ by ax
l13: $ … ⇒ Cf $ by ex_elim [l12, l11]
l14: $ G , H , ∃ x ∃ y ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel) ⇒ ∃ x ∃ y ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H ⇒ (∃ x ∃ y ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel)) → Cf $ by imp_intro [l15]
l17: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qj_v ∅ ⟩ ∧ ra_le y qi_v ∈ lrel ∧ ra_add qi_v x qj_v ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qj_v ∅ ⟩ ∧ ra_le y qi_v ∈ lrel ∧ ra_add qi_v x qj_v ∈ lrel $ by ax
l18: $ G , H , t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qj_v ∅ ⟩ ∧ ra_le y qi_v ∈ lrel ∧ ra_add qi_v x qj_v ∈ lrel ⇒ qi_v = qi_v $ by eq_refl
