ifold_elim_ok
-------------
l1: $ G ⇒ ∃ c ∃ d ∃ f (tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩) ∨ ∃ c ∃ d ∃ f (tc = c ∧ td = d ∧ tv = f ∧ ra_large c d ∈ lrel3 J) $ by lrel3_elim_ok_cases [#8]
l2: $ G , tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ ⇒ tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ $ by ax
l3: $ G , tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ ⇒ ∀ x (x ∊ lvals → lv f x = lv ⟨ kc_lz , ∅ ⟩ x) $ by weaken [and_elim_r [and_elim_r [and_elim_r [l2]]]]
l4: $ G , tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ ⇒ iwf u H J tc td w R $ by weaken [#1]
l5: $ G , tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ ⇒ w ∊ lvals → lv f w = lv ⟨ kc_lz , ∅ ⟩ w $ by all_elim [l3]
l6: $ G , tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ ⇒ lv f w = lv ⟨ kc_lz , ∅ ⟩ w $ by imp_elim [l5, wcel_welc [iwf_lvals [l4]]]
l7: $ G , tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ ⇒ w = w $ by eq_refl
l8: $ G , tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ ⇒ lv ⟨ kc_lz , ∅ ⟩ w = ∅ $ by lv_lz
l9: $ G , tc = c ∧ td = d ∧ tv = f ∧ lveq f ⟨ kc_lz , ∅ ⟩ ⇒ lv tv w = ∅ $ by eq_trans [lv_eq [and_elim_l [and_elim_r [and_elim_r [l2]]], l7], eq_trans [l6, l8]]
