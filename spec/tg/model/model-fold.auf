--| @freshen H qK
--| @freshen H qC
--| @freshen H qn_v
lemma f21_inv_clen_c {qK qC qn_v: set} (G H: hyps) (Cf: fml) (t1 t2: set): $ G ⇒ ra_clen_c t1 t2 ∈ lrel $ > $ H , t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ > $ H , t1 = ⟨ kc_ccons , scons qK (scons qC ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen_c qC qn_v ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_clen_c t1 t2 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ qK ∃ qC ∃ qn_v (t1 = ⟨ kc_ccons , scons qK (scons qC ∅) ⟩ ∧ t2 = ⟨ kc_s , scons qn_v ∅ ⟩ ∧ ra_clen_c qC qn_v ∈ lrel) $ by lrel_clen_c_cases [l1]
l3: $ G , H , t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l4: $ G , H , t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [and_elim_l [l3], and_elim_r [l3]]
l5: $ H ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by imp_intro [#2]
l6: $ G , H , t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ → Cf $ by weaken [l5]
l7: $ G , H , t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ⇒ Cf $ by imp_elim [l6, l4]
l8: $ G , H ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) → Cf $ by imp_intro [l7]
