l165: $ G , H ⇒ (∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_lift x y qf_v qf2 ∈ lrel ∧ ra_lift x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ qj_v ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v y ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_lift x y qe_v qe2 ∈ lrel)) → Cf $ by or_elim_imp [l70, l164]
l166: $ G , H ⇒ (∃ x ∃ y ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_lift x y qf_v qf2 ∈ lrel ∧ ra_lift x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ qj_v ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v y ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_lift x y qe_v qe2 ∈ lrel)) → Cf $ by or_elim_imp [l46, l165]
l167: $ G , H ⇒ (∃ x ∃ y ∃ qi_v ∃ qj_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qj_v ∅ ⟩ ∧ ra_le y qi_v ∈ lrel ∧ ra_add qi_v x qj_v ∈ lrel) ∨ ∃ x ∃ y ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_lift x y qf_v qf2 ∈ lrel ∧ ra_lift x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ qj_v ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v y ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_lift x y qe_v qe2 ∈ lrel)) → Cf $ by or_elim_imp [l34, l166]
l168: $ G , H ⇒ (∃ x ∃ y ∃ qi_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons qi_v ∅ ⟩ y ∈ lrel) ∨ ∃ x ∃ y ∃ qi_v ∃ qj_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_bvar , scons qi_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons qj_v ∅ ⟩ ∧ ra_le y qi_v ∈ lrel ∧ ra_add qi_v x qj_v ∈ lrel) ∨ ∃ x ∃ y ∃ ql_v (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_srt , scons ql_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons ql_v ∅ ⟩) ∨ ∃ x ∃ y ∃ qf_v ∃ qa_v ∃ qf2 ∃ qa2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_app , scons qf_v (scons qa_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons qf2 (scons qa2 ∅) ⟩ ∧ ra_lift x y qf_v qf2 ∈ lrel ∧ ra_lift x y qa_v qa2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_lam , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ y ∃ qA ∃ qb_v ∃ qA2 ∃ qb2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_pi , scons qA (scons qb_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons qA2 (scons qb2 ∅) ⟩ ∧ ra_lift x y qA qA2 ∈ lrel ∧ ra_lift x ⟨ kc_s , scons y ∅ ⟩ qb_v qb2 ∈ lrel) ∨ ∃ x ∃ qj_v ∃ y ∃ qe_v (t1 = x ∧ t2 = y ∧ t3 = qe_v ∧ t4 = qe_v ∧ ra_closed qj_v qe_v ∈ lrel ∧ ra_le qj_v y ∈ lrel) ∨ ∃ x ∃ y ∃ qb_v ∃ qi_v ∃ qe_v ∃ qe2 (t1 = x ∧ t2 = y ∧ t3 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons qb_v (scons qi_v (scons qe2 ∅)) ⟩ ∧ ra_lift x y qe_v qe2 ∈ lrel)) → Cf $ by or_elim_imp [l16, l167]
l169: $ G , H ⇒ Cf $ by imp_elim [l168, l2]

