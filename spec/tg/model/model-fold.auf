l23: $ G , z = ∅ ⇒ ∀ c (c ∊ fseq A → cdm c = nadd z b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g)) $ by all_intro [l22]
