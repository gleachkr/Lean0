--| @freshen G x
--| @freshen G z
lemma f28_pp_n {x z: set} (G: hyps) (ta tb: set) (ty k1 j1 vi vr: set): $ G ⇒ crn j1 ⊆ f28_pp_q ta tb $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pinst vi ty ⟨ kc_pi , scons ta (scons tb ∅) ⟩ vr ∈ lrel $ > $ G ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $
----
l1: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ x2 = ⟨ kc_s , scons vi ∅ ⟩ $ by ax
l3: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ vi = vi $ by eq_refl
l4: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ ty = ty $ by eq_refl
l5: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ vr = vr $ by eq_refl
l6: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ ra_pinst vi ty x1 vr ∈ lrel $ by wcel_eq_l [ra_pinst_eq [l3, l4, eq_sym [l1], l5], weaken [#5]]
l7: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 $ by ax
l8: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ $ by weaken [l1]
l9: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ ra_pinst vi ty x1 vr ∈ lrel $ by weaken [l6]
l10: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ ⟨ kr_pinst , scons vi (scons ty (scons x1 (scons vr ∅))) ⟩ ∈ latoms $ by lrel_latoms [l9]
l11: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset ∅ $ by ax_empty
l12: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons vr ∅) $ by scons_set [l11]
l13: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons x1 (scons vr ∅)) $ by scons_set [l12]
l14: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons ty (scons x1 (scons vr ∅))) $ by scons_set [l13]
l15: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons vi (scons ty (scons x1 (scons vr ∅)))) $ by scons_set [l14]
l16: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ kr_pinst ∈ ω $ by kr_pinst_omega
