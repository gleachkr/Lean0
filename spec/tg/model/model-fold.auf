--| @freshen G x
--| @freshen G c
lemma f30_sp_n {x c: set} (G: hyps) (td tn: set) (ty k1 j1 vj vk va vb vz: set): $ G ⇒ crn j1 ⊆ f30_sp_q td tn $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add vj ty tn ∈ lrel $ > $ G ⇒ ra_sinst td vj tn vk ⟨ kc_pi , scons va (scons vb ∅) ⟩ vz ∈ lrel $ > $ G ⇒ ∃ x ∃ c (vz = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn ⟨ kc_s , scons vk ∅ ⟩ vb c ∈ lrel) $
----
l1: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ $ by ax
l3: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ x2 = ⟨ kc_s , scons vj ∅ ⟩ $ by ax
l4: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ td = td $ by eq_refl
l5: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ vj = vj $ by eq_refl
l6: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ tn = tn $ by eq_refl
l7: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ vk = vk $ by eq_refl
l8: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ vz = vz $ by eq_refl
l9: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ ra_sinst td vj tn vk x1 vz ∈ lrel $ by wcel_eq_l [ra_sinst_eq [l4, l5, l6, l7, eq_sym [l1], l8], weaken [#6]]
l10: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , tn = vj ∧ vz = x1 ⇒ tn = vj ∧ vz = x1 $ by ax
l11: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , tn = vj ∧ vz = x1 ⇒ ra_sinst td vj tn vk x1 vz ∈ lrel $ by weaken [l9]
l12: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , tn = vj ∧ vz = x1 ⇒ x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ $ by weaken [l1]
l13: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , tn = vj ∧ vz = x1 ⇒ ⟨ kr_sinst , scons td (scons vj (scons tn (scons vk (scons x1 (scons vz ∅))))) ⟩ ∈ latoms $ by lrel_latoms [l11]
l14: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , tn = vj ∧ vz = x1 ⇒ isset ∅ $ by ax_empty
l15: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , tn = vj ∧ vz = x1 ⇒ isset (scons vz ∅) $ by scons_set [l14]
l16: $ G , x1 = ⟨ kc_pi , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , tn = vj ∧ vz = x1 ⇒ isset (scons x1 (scons vz ∅)) $ by scons_set [l15]
