l64: $ … ⇒ l ∊ {x | ∃ b (b ∊ dt u M ti w r ∧ x = scons b ∅)} $ by ex_elim [l63, l62]
l65: $ G , l ∊ mpth u (dnf u M) tb w r (Y) , ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w r ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) ⇒ ∃ i ∃ j ∃ k ∃ n (⟨ e , ⟨ i , ⟨ j , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w r ∧ n ∊ ap (Y) e ∧ n ∊ u ∧ l = scons n e) $ by ax
l66: $ … ⇒ l ∊ {x | ∃ b (b ∊ dt u M ti w r ∧ x = scons b ∅)} $ by ex_elim [l65, l64]
l67: $ G , l ∊ mpth u (dnf u M) tb w r (Y) ⇒ l ∊ {x | ∃ b (b ∊ dt u M ti w r ∧ x = scons b ∅)} $ by ex_elim [l45, l66]
l68: $ G ⇒ {x | ∃ b (b ∊ dt u M ti w r ∧ x = scons b ∅)} = mpth u (dnf u M) tb w r (Y) $ by subset_antisym [subset_intro [l28], subset_intro [l67]]
l69: $ G ⇒ dt u M ⟨ kc_pi , scons ti (scons tx ∅) ⟩ w r = cpi a (dt u M ti w r) (dt u M tx w (scons a r)) $ by dt_pi [lsig_ofsort_trees [#1], welc_wcel [#2], #3, #4]
l70: $ G ⇒ dt u M ti w r = dt u M ti w r $ by eq_refl
l71: $ G ⇒ cpi a (dt u M ti w r) (dt u M tx w (scons a r)) = cpi a (dt u M ti w r) (ap (T) (scons a ∅)) $ by cpi_eq_pt [l70, #8]
l72: $ G , l ∊ cpi a (dt u M ti w r) (ap (T) (scons a ∅)) ⇒ l ∊ cpi a (dt u M ti w r) (ap (T) (scons a ∅)) $ by ax
