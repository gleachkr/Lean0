lemma f35_iw_n {z q y f g h o c i v k x: set} (G: hyps) (H J V: class) (u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv: set) (ty k1 j1 vd vm ve vr: set): $ G ⇒ crn j1 ⊆ f35_iw_q H J V u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ > $ G ⇒ ra_nth_ty tt tj tFj tCj ∈ lrel $ > $ G ⇒ ra_isort tFj tni tlj ∈ lrel $ > $ G ⇒ ra_nidx td tj tni ∈ lrel $ > $ G ⇒ fd ∊ fseq u $ > $ G ⇒ cdm fd = nvf' tnf $ > $ G ⇒ ss ∊ fseq u $ > $ G ⇒ sx = fd ++ (mv ++ cv) ++ p ++ ss $ > $ G ⇒ cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w) $ > $ G ⇒ sx' nvf' tfld = V $ > $ G ⇒ V ∈ u $ > $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld vd tj ty vm ∈ lrel $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ve ∊ fseq u $ > $ G ⇒ cdm ve = nvf' vd $ > $ G ⇒ vr = ve ++ sx $ > $ G ⇒ ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vr → k = f ++ ve → (∃ c ∃ i (⟨ nvf' tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ o = i ++ p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ nvf' tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) $ > $ G ⇒ (∀ z (z ∊ dt u (mcv H) vm w vr → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) ty w vr) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vr → ⟨ ⟨ nvf' tj , ⟨ o , apn V (f ++ ve) ⟩ ⟩ , apn (dt u (mcv H) vm w vr) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv) $
