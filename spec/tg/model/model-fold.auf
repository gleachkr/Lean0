lemma f18_closed_app (G: hyps) (k a b z: set): $ G ⇒ ra_closed k z ∈ lrel $ > $ G ⇒ z = ⟨ kc_app , scons a (scons b ∅) ⟩ $ > $ G ⇒ ra_closed k a ∈ lrel $
----
l1: $ G ⇒ ∃ x ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) ∨ ∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) ∨ ∃ y ∃ v ∃ w (k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) $ by lrel_closed_cases [#1]
l2: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel $ by ax
l3: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ ⟨ kc_bvar , scons x ∅ ⟩ = ⟨ kc_app , scons a (scons b ∅) ⟩ $ by eq_trans [eq_sym [and_elim_l [and_elim_r [l2]]], weaken [#2]]
l4: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l5: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l6: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ kc_bvar = kc_app $ by opair_inj_l_c [l3, wcel_isset [l4], wcel_isset [l5]]
l7: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ ¬ kc_bvar = kc_app $ by kc_bvar_ne_app
l8: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ ra_closed k a ∈ lrel $ by bot_elim [not_elim [l7, l6]]
l9: $ G , ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) ⇒ ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) $ by ax
l10: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l9, l8]
l11: $ G , ∃ x ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) ⇒ ∃ x ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) $ by ax
l12: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l11, l10]
l13: $ G ⇒ (∃ x ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel)) → ra_closed k a ∈ lrel $ by imp_intro [l12]
l14: $ G , k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩ ⇒ k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩ $ by ax
l15: $ G , k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩ ⇒ ⟨ kc_srt , scons u ∅ ⟩ = ⟨ kc_app , scons a (scons b ∅) ⟩ $ by eq_trans [eq_sym [and_elim_r [l14]], weaken [#2]]
l16: $ G , k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩ ⇒ kc_srt ∈ ω $ by kc_srt_omega
l17: $ G , k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩ ⇒ kc_app ∈ ω $ by kc_app_omega
l18: $ G , k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩ ⇒ kc_srt = kc_app $ by opair_inj_l_c [l15, wcel_isset [l16], wcel_isset [l17]]
l19: $ G , k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩ ⇒ ¬ kc_srt = kc_app $ by kc_srt_ne_app
l20: $ G , k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩ ⇒ ra_closed k a ∈ lrel $ by bot_elim [not_elim [l19, l18]]
l21: $ G , ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) ⇒ ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) $ by ax
l22: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l21, l20]
l23: $ G , ∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) ⇒ ∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) $ by ax
l24: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l23, l22]
l25: $ G ⇒ (∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩)) → ra_closed k a ∈ lrel $ by imp_intro [l24]
l26: $ G , k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel ⇒ k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel $ by ax
l27: $ G , k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel ⇒ ⟨ kc_app , scons v (scons w ∅) ⟩ = ⟨ kc_app , scons a (scons b ∅) ⟩ $ by eq_trans [eq_sym [and_elim_l [and_elim_r [l26]]], weaken [#2]]
l28: $ G , k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel ⇒ y = k $ by eq_sym [and_elim_l [l26]]
l29: $ G , k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l30: $ G , k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel ⇒ v = a ∧ w = b $ by node2_inj [wcel_isset [l29], l27]
