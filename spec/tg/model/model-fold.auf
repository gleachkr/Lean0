l138: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel , ra_spine h f k ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel ⇒ crn (scons g ∅) ⊆ trees ω $ by crn_scons_tail [l137]
l139: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel , ra_spine h f k ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel ⇒ isset ω $ by omega_set
l140: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel , ra_spine h f k ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel ⇒ g ∈ trees ω $ by crn_scons_head_trees [l139, l138]
l141: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel , ra_spine h f k ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel ⇒ k ∈ trees ω $ by weaken [l88]
