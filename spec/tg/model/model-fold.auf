def f30_sb_q (td tn ti: set) (.y .j .k .m .x .z: set): class = $ {y | ∀ j ∀ k ∀ m ∀ x ∀ z (ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_bvar , scons m ∅ ⟩ z ∈ lrel → ra_add k x m ∈ lrel → ra_add j x ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → z = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩)} $

lemma f30_sb_e (G: hyps) (td tn ti: set) (ty vj vk vm vx vz: set): $ G ⇒ ty ∊ f30_sb_q td tn ti $ > $ G ⇒ ra_add vj ty tn ∈ lrel $ > $ G ⇒ ra_sinst td vj tn vk ⟨ kc_bvar , scons vm ∅ ⟩ vz ∈ lrel $ > $ G ⇒ ra_add vk vx vm ∈ lrel $ > $ G ⇒ ra_add vj vx ti ∈ lrel $ > $ G ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel $ > $ G ⇒ vz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $
----
l1: $ G ⇒ ∀ j ∀ k ∀ m ∀ x ∀ z (ra_add j ty tn ∈ lrel → ra_sinst td j tn k ⟨ kc_bvar , scons m ∅ ⟩ z ∈ lrel → ra_add k x m ∈ lrel → ra_add j x ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → z = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩) $ by cab_elim [#1]
l2: $ G ⇒ ∀ k ∀ m ∀ x ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn k ⟨ kc_bvar , scons m ∅ ⟩ z ∈ lrel → ra_add k x m ∈ lrel → ra_add vj x ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → z = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩) $ by all_elim [l1]
l3: $ G ⇒ ∀ m ∀ x ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_bvar , scons m ∅ ⟩ z ∈ lrel → ra_add vk x m ∈ lrel → ra_add vj x ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → z = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩) $ by all_elim [l2]
l4: $ G ⇒ ∀ x ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_bvar , scons vm ∅ ⟩ z ∈ lrel → ra_add vk x vm ∈ lrel → ra_add vj x ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → z = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩) $ by all_elim [l3]
l5: $ G ⇒ ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_bvar , scons vm ∅ ⟩ z ∈ lrel → ra_add vk vx vm ∈ lrel → ra_add vj vx ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → z = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩) $ by all_elim [l4]
l6: $ G ⇒ ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_bvar , scons vm ∅ ⟩ vz ∈ lrel → ra_add vk vx vm ∈ lrel → ra_add vj vx ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → vz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ by all_elim [l5]
l7: $ G ⇒ ra_sinst td vj tn vk ⟨ kc_bvar , scons vm ∅ ⟩ vz ∈ lrel → ra_add vk vx vm ∈ lrel → ra_add vj vx ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → vz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ by imp_elim [l6, #2]
l8: $ G ⇒ ra_add vk vx vm ∈ lrel → ra_add vj vx ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → vz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ by imp_elim [l7, #3]
l9: $ G ⇒ ra_add vj vx ti ∈ lrel → ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → vz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ by imp_elim [l8, #4]
l10: $ G ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel → vz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ by imp_elim [l9, #5]
l11: $ G ⇒ vz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ by imp_elim [l10, #6]

lemma f30_sb_n (G: hyps) (td tn ti: set) (ty k1 j1 vj vk vm vx vz: set): $ G ⇒ crn j1 ⊆ f30_sb_q td tn ti $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add vj ty tn ∈ lrel $ > $ G ⇒ ra_sinst td vj tn vk ⟨ kc_bvar , scons vm ∅ ⟩ vz ∈ lrel $ > $ G ⇒ ra_add vk vx vm ∈ lrel $ > $ G ⇒ ra_add vj vx ti ∈ lrel $ > $ G ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel $ > $ G ⇒ vz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $
