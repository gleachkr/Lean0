l265: $ G , e ∊ {l | l ∊ fseq u ∧ cdm l = L2 ∧ ∀ i (i ∊ N → J ⊆ i → vat (l ++ c0) N i ∈ imot u (dnf u M) td i w p V)} , q ∊ fseq u ∧ h ∊ u ∧ e = ssnoc q h , g = scons h ∅ , k = ∅ , c = scons h c0 , y = scons h r ⇒ e ∊ esat u (dsh u M r) tm w $ by isset_elim [l264, l263]
l266: $ G , e ∊ {l | l ∊ fseq u ∧ cdm l = L2 ∧ ∀ i (i ∊ N → J ⊆ i → vat (l ++ c0) N i ∈ imot u (dnf u M) td i w p V)} , q ∊ fseq u ∧ h ∊ u ∧ e = ssnoc q h , g = scons h ∅ , k = ∅ , c = scons h c0 ⇒ isset r $ by isset_var
