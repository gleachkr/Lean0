l316: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel , c = ⟨ kc_pi , scons d (scons e ∅) ⟩ ∧ ra_pinst x2 a ta d ∈ lrel ∧ ra_pinst ⟨ kc_s , scons x2 ∅ ⟩ a tb e ∈ lrel , vr = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ ra_inst vi d b f ∈ lrel ∧ ra_inst ⟨ kc_s , scons vi ∅ ⟩ e b g ∈ lrel ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by ex_intro [l315]
l317: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel , c = ⟨ kc_pi , scons d (scons e ∅) ⟩ ∧ ra_pinst x2 a ta d ∈ lrel ∧ ra_pinst ⟨ kc_s , scons x2 ∅ ⟩ a tb e ∈ lrel , ∃ g (vr = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ ra_inst vi d b f ∈ lrel ∧ ra_inst ⟨ kc_s , scons vi ∅ ⟩ e b g ∈ lrel) ⇒ ∃ g (vr = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ ra_inst vi d b f ∈ lrel ∧ ra_inst ⟨ kc_s , scons vi ∅ ⟩ e b g ∈ lrel) $ by ax
l318: $ … ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by ex_elim [l317, l316]
l319: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel , c = ⟨ kc_pi , scons d (scons e ∅) ⟩ ∧ ra_pinst x2 a ta d ∈ lrel ∧ ra_pinst ⟨ kc_s , scons x2 ∅ ⟩ a tb e ∈ lrel ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by ex_elim [l228, l318]
l320: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel , ∃ e (c = ⟨ kc_pi , scons d (scons e ∅) ⟩ ∧ ra_pinst x2 a ta d ∈ lrel ∧ ra_pinst ⟨ kc_s , scons x2 ∅ ⟩ a tb e ∈ lrel) ⇒ ∃ e (c = ⟨ kc_pi , scons d (scons e ∅) ⟩ ∧ ra_pinst x2 a ta d ∈ lrel ∧ ra_pinst ⟨ kc_s , scons x2 ∅ ⟩ a tb e ∈ lrel) $ by ax
l321: $ … ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by ex_elim [l320, l319]
l322: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by ex_elim [l216, l321]
l323: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by f21_inv_pinst [l6, l73, l141, l322]
l324: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ ⇒ isset ⟨ kc_s , scons vi ∅ ⟩ $ by opair_isset
l325: $ G , x1 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by isset_elim [l324, l323]
l326: $ G ⇒ isset ⟨ kc_pi , scons ta (scons tb ∅) ⟩ $ by opair_isset
l327: $ G ⇒ ∃ x ∃ z (vr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ ty tb z ∈ lrel) $ by isset_elim [l326, l325]

lemma f28_pp_all (G: hyps) (ta tb: set): $ G ⇒ trees ω ⊆ f28_pp_q ta tb $
----
l1: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ crn n ⊆ f28_pp_q ta tb $ by ax
l2: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ y = ⟨ m , n ⟩ $ by ax
l3: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ m ∊ ω $ by ax
l4: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ n ∊ fseq (trees ω) $ by ax
l5: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel $ by ax
l6: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ ∃ x ∃ z (r = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons i ∅ ⟩ y tb z ∈ lrel) $ by f28_pp_n [l1, l2, l3, l4, l5]
l7: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ ⇒ ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons i ∅ ⟩ y tb z ∈ lrel) $ by imp_intro [l6]
l8: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ ⇒ ∀ r (ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons i ∅ ⟩ y tb z ∈ lrel)) $ by all_intro [l7]
l9: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ ⇒ ∀ i ∀ r (ra_pinst i y ⟨ kc_pi , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons i ∅ ⟩ y tb z ∈ lrel)) $ by all_intro [l8]
l10: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ ⇒ y ∊ f28_pp_q ta tb $ by cab_intro [l9]
l11: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ ⇒ y = ⟨ m , n ⟩ $ by ax
l12: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb , y = ⟨ m , n ⟩ ⇒ ⟨ m , n ⟩ ∈ f28_pp_q ta tb $ by wcel_intro [l11, l10]
l13: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb ⇒ isset ⟨ m , n ⟩ $ by opair_isset
l14: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pp_q ta tb ⇒ ⟨ m , n ⟩ ∈ f28_pp_q ta tb $ by isset_elim [l13, l12]
l15: $ G ⇒ m ∊ ω → n ∊ fseq (trees ω) → crn n ⊆ f28_pp_q ta tb → ⟨ m , n ⟩ ∈ f28_pp_q ta tb $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ m ∀ n (m ∊ ω → n ∊ fseq (trees ω) → crn n ⊆ f28_pp_q ta tb → ⟨ m , n ⟩ ∈ f28_pp_q ta tb) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f28_pp_q ta tb $ by trees_ind_c [l17, l16]

pinst_pi_inv
------------
l1: $ G ⇒ ⟨ kr_pinst , scons ti (scons ts (scons ⟨ kc_pi , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tr ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons ⟨ kc_pi , scons ta (scons tb ∅) ⟩ (scons tr ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ts (scons ⟨ kc_pi , scons ta (scons tb ∅) ⟩ (scons tr ∅))) $ by scons_set [l4]
l6: $ G ⇒ isset (scons ti (scons ts (scons ⟨ kc_pi , scons ta (scons tb ∅) ⟩ (scons tr ∅)))) $ by scons_set [l5]
l7: $ G ⇒ kr_pinst ∈ ω $ by kr_pinst_omega
l8: $ G ⇒ kr_pinst ∈ ω ∧ scons ti (scons ts (scons ⟨ kc_pi , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons ti (scons ts (scons ⟨ kc_pi , scons ta (scons tb ∅) ⟩ (scons tr ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ crn (scons ts (scons ⟨ kc_pi , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ⊆ trees ω $ by crn_scons_tail [l9]
l11: $ G ⇒ isset ω $ by omega_set
l12: $ G ⇒ ts ∈ trees ω $ by crn_scons_head_trees [l11, l10]
l13: $ G ⇒ trees ω ⊆ f28_pp_q ta tb $ by f28_pp_all
l14: $ G ⇒ ts ∊ f28_pp_q ta tb $ by subset_elim [l13, wcel_welc [l12]]
l15: $ G ⇒ ∃ x ∃ z (tr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst ti ts ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons ti ∅ ⟩ ts tb z ∈ lrel) $ by f28_pp_e [l14, #1]

def f28_pa_q (ta tb: set) (.y .i .r .x .z: set): class = $ {y | ∀ i ∀ r (ra_pinst i y ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst i y ta x ∈ lrel ∧ ra_pinst i y tb z ∈ lrel))} $

--| @freshen G x
--| @freshen G z
lemma f28_pa_e {x z: set} (G: hyps) (ta tb: set) (ty vi vr: set): $ G ⇒ ty ∊ f28_pa_q ta tb $ > $ G ⇒ ra_pinst vi ty ⟨ kc_app , scons ta (scons tb ∅) ⟩ vr ∈ lrel $ > $ G ⇒ ∃ x ∃ z (vr = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst vi ty tb z ∈ lrel) $
----
l1: $ G ⇒ ∀ i ∀ r (ra_pinst i ty ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst i ty ta x ∈ lrel ∧ ra_pinst i ty tb z ∈ lrel)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r (ra_pinst vi ty ⟨ kc_app , scons ta (scons tb ∅) ⟩ r ∈ lrel → ∃ x ∃ z (r = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst vi ty tb z ∈ lrel)) $ by all_elim [l1]
l3: $ G ⇒ ra_pinst vi ty ⟨ kc_app , scons ta (scons tb ∅) ⟩ vr ∈ lrel → ∃ x ∃ z (vr = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst vi ty tb z ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ∃ x ∃ z (vr = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst vi ty tb z ∈ lrel) $ by imp_elim [l3, #2]

--| @freshen G x
--| @freshen G z
lemma f28_pa_n {x z: set} (G: hyps) (ta tb: set) (ty k1 j1 vi vr: set): $ G ⇒ crn j1 ⊆ f28_pa_q ta tb $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pinst vi ty ⟨ kc_app , scons ta (scons tb ∅) ⟩ vr ∈ lrel $ > $ G ⇒ ∃ x ∃ z (vr = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst vi ty ta x ∈ lrel ∧ ra_pinst vi ty tb z ∈ lrel) $
----
l1: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ x2 = ⟨ kc_s , scons vi ∅ ⟩ $ by ax
l3: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ vi = vi $ by eq_refl
l4: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ ty = ty $ by eq_refl
l5: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ vr = vr $ by eq_refl
l6: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ ra_pinst vi ty x1 vr ∈ lrel $ by wcel_eq_l [ra_pinst_eq [l3, l4, eq_sym [l1], l5], weaken [#5]]
l7: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 $ by ax
l8: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ $ by weaken [l1]
l9: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ ra_pinst vi ty x1 vr ∈ lrel $ by weaken [l6]
l10: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ ⟨ kr_pinst , scons vi (scons ty (scons x1 (scons vr ∅))) ⟩ ∈ latoms $ by lrel_latoms [l9]
l11: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset ∅ $ by ax_empty
l12: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons vr ∅) $ by scons_set [l11]
l13: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons x1 (scons vr ∅)) $ by scons_set [l12]
l14: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons ty (scons x1 (scons vr ∅))) $ by scons_set [l13]
l15: $ G , x1 = ⟨ kc_app , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ isset (scons vi (scons ty (scons x1 (scons vr ∅)))) $ by scons_set [l14]
