l12: $ G , td = z ∧ tn = u ∧ tnp = v ∧ vd = w ∧ ty = ⟨ kc_pi , scons b (scons c ∅) ⟩ ∧ tj = a ∧ ra_recfield z u v ⟨ kc_s , scons w ∅ ⟩ c a ∈ lrel , d = ⟨ kc_s , scons w ∅ ⟩ ⇒ c = c $ by eq_refl
