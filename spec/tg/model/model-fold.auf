--| @freshen G x
--| @freshen G t
--| @freshen G f
lemma f16_rw_n {x t f: set} (G: hyps) (M Z K: class) (u w td tn tm ti tnp p c0 rr n0: set) (ty k1 j1 vd vm ve vr: set): $ G ⇒ crn j1 ⊆ f16_rw_q M Z K u w td tn tm ti tnp p c0 rr n0 $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' tnp $ > $ G ⇒ c0 ∊ fseq u $ > $ G ⇒ cdm c0 = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ rr ∊ fseq u $ > $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ > $ G ⇒ n0 ∊ trees ω $ > $ G ⇒ ∀ x (x ∊ fseq u → dt u M n0 w x = Z) $ > $ G ⇒ K ∈ cdm c0 $ > $ G ⇒ nadd (suc K) (nvf' ti) = cdm c0 $ > $ G ⇒ ra_rtail td tnp tn tm ti vd ty vm ∈ lrel $ > $ G ⇒ ty ∊ trees ω $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ve ∊ fseq u $ > $ G ⇒ cdm ve = nvf' vd $ > $ G ⇒ vr = ve ++ c0 ++ p ++ rr $ > $ G ⇒ dt u M vm w vr = fpi t (mpth u (dnf u M) ty w vr (clam f (fseq u) (apn (Z) (f ++ ve ++ p)))) (ap (clam f (fseq u) (apn (c0' K) (f ++ ve))) t) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ g ∃ b ∃ n (td = x1 ∧ tnp = x2 ∧ tn = x3 ∧ tm = x4 ∧ ti = x5 ∧ vd = x6 ∧ ty = ⟨ kc_pi , scons g (scons b ∅) ⟩ ∧ vm = ⟨ kc_pi , scons g (scons n ∅) ⟩ ∧ ra_rtail x1 x2 x3 x4 x5 ⟨ kc_s , scons x6 ∅ ⟩ b n ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ k ∃ j ∃ h ∃ l ∃ z ∃ i ∃ o (td = x1 ∧ tnp = x2 ∧ tn = x3 ∧ tm = x4 ∧ ti = x5 ∧ vd = x6 ∧ ty = ⟨ kc_srt , scons l ∅ ⟩ ∧ vm = ⟨ kc_pi , scons i (scons ⟨ kc_app , scons o (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add x4 x3 k ∈ lrel ∧ ra_add x6 k j ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ j x2 z ∈ lrel ∧ ra_pargs z ⟨ kc_nz , ∅ ⟩ x6 i ∈ lrel ∧ ra_add h x5 j ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ x6 o ∈ lrel) $ by lrel_rtail_cases [#17]
