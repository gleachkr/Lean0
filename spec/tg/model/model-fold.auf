l75: $ G ⇒ t4 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by isset_elim [l74, l73]

def f28_pi_q (ta tb: set) (.y .i .r: set): class = $ {y | ∀ i ∀ r (ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel → r = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩)} $

lemma f28_pi_e (G: hyps) (ta tb: set) (ty vi vr: set): $ G ⇒ ty ∊ f28_pi_q ta tb $ > $ G ⇒ ra_pinst vi ty ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ vr ∈ lrel $ > $ G ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $
----
l1: $ G ⇒ ∀ i ∀ r (ra_pinst i ty ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel → r = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r (ra_pinst vi ty ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel → r = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩) $ by all_elim [l1]
l3: $ G ⇒ ra_pinst vi ty ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ vr ∈ lrel → vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by all_elim [l2]
l4: $ G ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by imp_elim [l3, #2]

lemma f28_pi_n (G: hyps) (ta tb: set) (ty k1 j1 vi vr: set): $ G ⇒ crn j1 ⊆ f28_pi_q ta tb $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_pinst vi ty ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ vr ∈ lrel $ > $ G ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $
----
l1: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ x2 = ⟨ kc_s , scons vi ∅ ⟩ $ by ax
l3: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ vi = vi $ by eq_refl
l4: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ ty = ty $ by eq_refl
l5: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ vr = vr $ by eq_refl
l6: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ ra_pinst vi ty x1 vr ∈ lrel $ by wcel_eq_l [ra_pinst_eq [l3, l4, eq_sym [l1], l5], weaken [#5]]
l7: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 $ by ax
l8: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by weaken [l1]
l9: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ty , scons u (scons v ∅) ⟩ ∧ vr = x1 ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by eq_trans [and_elim_r [l7], l8]
l10: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ctor , scons u (scons v (scons w ∅)) ⟩ ∧ vr = x1 ⇒ ty = ⟨ kc_ind_ctor , scons u (scons v (scons w ∅)) ⟩ ∧ vr = x1 $ by ax
l11: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ctor , scons u (scons v (scons w ∅)) ⟩ ∧ vr = x1 ⇒ x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by weaken [l1]
l12: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_ind_ctor , scons u (scons v (scons w ∅)) ⟩ ∧ vr = x1 ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by eq_trans [and_elim_r [l10], l11]
l13: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel $ by ax
l14: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by weaken [l1]
l15: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ x2 = ⟨ kc_s , scons vi ∅ ⟩ $ by weaken [l2]
l16: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ isset ∅ $ by ax_empty
l17: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ isset (scons b ∅) $ by scons_set [l16]
l18: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ isset (scons a (scons b ∅)) $ by scons_set [l17]
l19: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ crn j1 ⊆ f28_pi_q ta tb $ by weaken [#1]
l20: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l21: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l22: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ crn (scons a (scons b ∅)) ⊆ f28_pi_q ta tb $ by node_crn_sub [l19, l20, and_elim_l [l13], wcel_isset [l21], l18]
l23: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ isset a $ by isset_var
l24: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ a ∈ f28_pi_q ta tb $ by crn_scons_head [l23, l22]
l25: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ a = a $ by eq_refl
l26: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ c = c $ by eq_refl
l27: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ ra_pinst x2 a ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ c ∈ lrel $ by wcel_eq_l [ra_pinst_eq [eq_sym [l15], l25, l14, l26], and_elim_l [and_elim_r [l13]]]
l28: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ c = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by f28_pi_e [wcel_welc [l24], l27]
l29: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ vi = vi $ by eq_refl
l30: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ b = b $ by eq_refl
l31: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ vr = vr $ by eq_refl
l32: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ ra_inst vi ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ b vr ∈ lrel $ by wcel_eq_l [ra_inst_eq [l29, l28, l30, l31], and_elim_r [and_elim_r [l13]]]
l33: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ , ty = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ ra_pinst ⟨ kc_s , scons vi ∅ ⟩ a x1 c ∈ lrel ∧ ra_inst vi c b vr ∈ lrel ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by inst_ind_ty_inv [l32]
l34: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x2 = ⟨ kc_s , scons vi ∅ ⟩ ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by f21_inv_pinst [l6, l9, l12, l33]
l35: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ ⇒ isset ⟨ kc_s , scons vi ∅ ⟩ $ by opair_isset
l36: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by isset_elim [l35, l34]
l37: $ G ⇒ isset ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by opair_isset
l38: $ G ⇒ vr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by isset_elim [l37, l36]

lemma f28_pi_all (G: hyps) (ta tb: set): $ G ⇒ trees ω ⊆ f28_pi_q ta tb $
----
l1: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ crn n ⊆ f28_pi_q ta tb $ by ax
l2: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ y = ⟨ m , n ⟩ $ by ax
l3: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ m ∊ ω $ by ax
l4: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ n ∊ fseq (trees ω) $ by ax
l5: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel $ by ax
l6: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ , ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel ⇒ r = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by f28_pi_n [l1, l2, l3, l4, l5]
l7: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ ⇒ ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel → r = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by imp_intro [l6]
l8: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ ⇒ ∀ r (ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel → r = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩) $ by all_intro [l7]
l9: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ ⇒ ∀ i ∀ r (ra_pinst i y ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ r ∈ lrel → r = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩) $ by all_intro [l8]
l10: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ ⇒ y ∊ f28_pi_q ta tb $ by cab_intro [l9]
l11: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ ⇒ y = ⟨ m , n ⟩ $ by ax
l12: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb , y = ⟨ m , n ⟩ ⇒ ⟨ m , n ⟩ ∈ f28_pi_q ta tb $ by wcel_intro [l11, l10]
l13: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb ⇒ isset ⟨ m , n ⟩ $ by opair_isset
l14: $ G , m ∊ ω , n ∊ fseq (trees ω) , crn n ⊆ f28_pi_q ta tb ⇒ ⟨ m , n ⟩ ∈ f28_pi_q ta tb $ by isset_elim [l13, l12]
l15: $ G ⇒ m ∊ ω → n ∊ fseq (trees ω) → crn n ⊆ f28_pi_q ta tb → ⟨ m , n ⟩ ∈ f28_pi_q ta tb $ by imp_intro [imp_intro [imp_intro [l14]]]
l16: $ G ⇒ ∀ m ∀ n (m ∊ ω → n ∊ fseq (trees ω) → crn n ⊆ f28_pi_q ta tb → ⟨ m , n ⟩ ∈ f28_pi_q ta tb) $ by all_intro [all_intro [l15]]
l17: $ G ⇒ isset ω $ by omega_set
l18: $ G ⇒ trees ω ⊆ f28_pi_q ta tb $ by trees_ind_c [l17, l16]

pinst_ind_ty_inv
----------------
l1: $ G ⇒ ⟨ kr_pinst , scons ti (scons ts (scons ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tr ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ (scons tr ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ts (scons ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ (scons tr ∅))) $ by scons_set [l4]
l6: $ G ⇒ isset (scons ti (scons ts (scons ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ (scons tr ∅)))) $ by scons_set [l5]
l7: $ G ⇒ kr_pinst ∈ ω $ by kr_pinst_omega
l8: $ G ⇒ kr_pinst ∈ ω ∧ scons ti (scons ts (scons ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons ti (scons ts (scons ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ (scons tr ∅)))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ crn (scons ts (scons ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ (scons tr ∅))) ⊆ trees ω $ by crn_scons_tail [l9]
l11: $ G ⇒ isset ω $ by omega_set
l12: $ G ⇒ ts ∈ trees ω $ by crn_scons_head_trees [l11, l10]
l13: $ G ⇒ trees ω ⊆ f28_pi_q ta tb $ by f28_pi_all
l14: $ G ⇒ ts ∊ f28_pi_q ta tb $ by subset_elim [l13, wcel_welc [l12]]
l15: $ G ⇒ tr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by f28_pi_e [l14, #1]

def f29_sl_q (ta: set) (.y .c: set): class = $ {y | ∀ c (ra_add ta y c ∈ lrel → ra_add ⟨ kc_s , scons ta ∅ ⟩ y ⟨ kc_s , scons c ∅ ⟩ ∈ lrel)} $

lemma f29_sl_e (G: hyps) (ta: set) (ty vc: set): $ G ⇒ ty ∊ f29_sl_q ta $ > $ G ⇒ ra_add ta ty vc ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ ty ⟨ kc_s , scons vc ∅ ⟩ ∈ lrel $
----
l1: $ G ⇒ ∀ c (ra_add ta ty c ∈ lrel → ra_add ⟨ kc_s , scons ta ∅ ⟩ ty ⟨ kc_s , scons c ∅ ⟩ ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ra_add ta ty vc ∈ lrel → ra_add ⟨ kc_s , scons ta ∅ ⟩ ty ⟨ kc_s , scons vc ∅ ⟩ ∈ lrel $ by all_elim [l1]
l3: $ G ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ ty ⟨ kc_s , scons vc ∅ ⟩ ∈ lrel $ by imp_elim [l2, #2]

lemma f29_sl_n (G: hyps) (ta: set) (ty k1 j1 vc: set): $ G ⇒ crn j1 ⊆ f29_sl_q ta $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add ta ty vc ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ ty ⟨ kc_s , scons vc ∅ ⟩ ∈ lrel $
----
l1: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta $ by ax
l2: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ra_add ta ty vc ∈ lrel $ by weaken [#5]
l3: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ⟨ kr_add , scons ta (scons ty (scons vc ∅)) ⟩ ∈ latoms $ by lrel_latoms [l2]
l4: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ isset ∅ $ by ax_empty
l5: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ isset (scons vc ∅) $ by scons_set [l4]
l6: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ isset (scons ty (scons vc ∅)) $ by scons_set [l5]
l7: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ isset (scons ta (scons ty (scons vc ∅))) $ by scons_set [l6]
l8: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ kr_add ∈ ω $ by kr_add_omega
l9: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ kr_add ∈ ω ∧ scons ta (scons ty (scons vc ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l3, wcel_isset [l8], l7]
l10: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ crn (scons ta (scons ty (scons vc ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l9]]
l11: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ isset ω $ by omega_set
l12: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ta ∈ trees ω $ by crn_scons_head_trees [l11, l10]
l13: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ isset ω $ by omega_set
l14: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ kc_s ∈ ω $ by kc_s_omega
l15: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l16: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ⟨ kc_s , scons ta ∅ ⟩ ∈ trees ω $ by trees_intro_c [l13, l14, scons_fseq_c [l12, l15]]
l17: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ta ∅ ⟩ ∈ lrel $ by lrel_add_z [l16]
l18: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ kc_s = kc_s $ by eq_refl
l19: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ∅ = ∅ $ by eq_refl
l20: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ⟨ kc_s , scons ta ∅ ⟩ = ⟨ kc_s , scons vc ∅ ⟩ $ by opair_eq [l18, scons_eq [eq_sym [and_elim_r [l1]], l19]]
l21: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ⟨ kc_s , scons ta ∅ ⟩ = ⟨ kc_s , scons ta ∅ ⟩ $ by eq_refl
l22: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ ty ⟨ kc_s , scons vc ∅ ⟩ ∈ lrel $ by wcel_eq_l [ra_add_eq [l21, eq_sym [and_elim_l [l1]], l20], l17]
l23: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel $ by ax
l24: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ra_add ta ty vc ∈ lrel $ by weaken [#5]
l25: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ⟨ kr_add , scons ta (scons ty (scons vc ∅)) ⟩ ∈ latoms $ by lrel_latoms [l24]
l26: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ∅ $ by ax_empty
l27: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons vc ∅) $ by scons_set [l26]
l28: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons ty (scons vc ∅)) $ by scons_set [l27]
l29: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons ta (scons ty (scons vc ∅))) $ by scons_set [l28]
l30: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kr_add ∈ ω $ by kr_add_omega
l31: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kr_add ∈ ω ∧ scons ta (scons ty (scons vc ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l25, wcel_isset [l30], l29]
l32: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn (scons ta (scons ty (scons vc ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l31]]
l33: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ω $ by omega_set
l34: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ta ∈ trees ω $ by crn_scons_head_trees [l33, l32]
l35: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ω $ by omega_set
l36: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l37: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l38: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ⟨ kc_s , scons ta ∅ ⟩ ∈ trees ω $ by trees_intro_c [l35, l36, scons_fseq_c [l34, l37]]
l39: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ∅ $ by ax_empty
l40: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons n ∅) $ by scons_set [l39]
l41: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn j1 ⊆ f29_sl_q ta $ by weaken [#1]
l42: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l43: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l44: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn (scons n ∅) ⊆ f29_sl_q ta $ by node_crn_sub [l41, l42, and_elim_l [l23], wcel_isset [l43], l40]
l45: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset n $ by isset_var
l46: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ n ∈ f29_sl_q ta $ by crn_scons_head [l45, l44]
l47: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ n ⟨ kc_s , scons j ∅ ⟩ ∈ lrel $ by f29_sl_e [wcel_welc [l46], and_elim_r [and_elim_r [l23]]]
l48: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ⟨ kr_add , scons ta (scons n (scons j ∅)) ⟩ ∈ latoms $ by lrel_latoms [and_elim_r [and_elim_r [l23]]]
l49: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ∅ $ by ax_empty
l50: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons j ∅) $ by scons_set [l49]
l51: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons n (scons j ∅)) $ by scons_set [l50]
l52: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons ta (scons n (scons j ∅))) $ by scons_set [l51]
l53: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kr_add ∈ ω $ by kr_add_omega
l54: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kr_add ∈ ω ∧ scons ta (scons n (scons j ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l48, wcel_isset [l53], l52]
l55: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn (scons ta (scons n (scons j ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l54]]
l56: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn (scons n (scons j ∅)) ⊆ trees ω $ by crn_scons_tail [l55]
l57: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ω $ by omega_set
l58: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ n ∈ trees ω $ by crn_scons_head_trees [l57, l56]
l59: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ⟨ kr_add , scons ⟨ kc_s , scons ta ∅ ⟩ (scons n (scons ⟨ kc_s , scons j ∅ ⟩ ∅)) ⟩ ∈ latoms $ by lrel_latoms [l47]
l60: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ∅ $ by ax_empty
l61: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons ⟨ kc_s , scons j ∅ ⟩ ∅) $ by scons_set [l60]
l62: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons n (scons ⟨ kc_s , scons j ∅ ⟩ ∅)) $ by scons_set [l61]
l63: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons ⟨ kc_s , scons ta ∅ ⟩ (scons n (scons ⟨ kc_s , scons j ∅ ⟩ ∅))) $ by scons_set [l62]
l64: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kr_add ∈ ω $ by kr_add_omega
l65: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kr_add ∈ ω ∧ scons ⟨ kc_s , scons ta ∅ ⟩ (scons n (scons ⟨ kc_s , scons j ∅ ⟩ ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l59, wcel_isset [l64], l63]
l66: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn (scons ⟨ kc_s , scons ta ∅ ⟩ (scons n (scons ⟨ kc_s , scons j ∅ ⟩ ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l65]]
l67: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn (scons n (scons ⟨ kc_s , scons j ∅ ⟩ ∅)) ⊆ trees ω $ by crn_scons_tail [l66]
l68: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn (scons ⟨ kc_s , scons j ∅ ⟩ ∅) ⊆ trees ω $ by crn_scons_tail [l67]
l69: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ω $ by omega_set
l70: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ⟨ kc_s , scons j ∅ ⟩ ∈ trees ω $ by crn_scons_head_trees [l69, l68]
l71: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_s , scons ⟨ kc_s , scons j ∅ ⟩ ∅ ⟩ ∈ lrel $ by lrel_add_s [l38, l58, l70, l47]
l72: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l73: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l74: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ⟨ kc_s , scons ⟨ kc_s , scons j ∅ ⟩ ∅ ⟩ = ⟨ kc_s , scons vc ∅ ⟩ $ by opair_eq [l72, scons_eq [eq_sym [and_elim_l [and_elim_r [l23]]], l73]]
l75: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ⟨ kc_s , scons ta ∅ ⟩ = ⟨ kc_s , scons ta ∅ ⟩ $ by eq_refl
l76: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ ty ⟨ kc_s , scons vc ∅ ⟩ ∈ lrel $ by wcel_eq_l [ra_add_eq [l75, eq_sym [and_elim_l [l23]], l74], l71]
l77: $ G ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ ty ⟨ kc_s , scons vc ∅ ⟩ ∈ lrel $ by f21_inv_add [#5, l22, l76]

lemma f29_sl_all (G: hyps) (ta: set): $ G ⇒ trees ω ⊆ f29_sl_q ta $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ crn x9 ⊆ f29_sl_q ta $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ ra_add ta y c ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ta y c ∈ lrel ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ y ⟨ kc_s , scons c ∅ ⟩ ∈ lrel $ by f29_sl_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ra_add ta y c ∈ lrel → ra_add ⟨ kc_s , scons ta ∅ ⟩ y ⟨ kc_s , scons c ∅ ⟩ ∈ lrel $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c (ra_add ta y c ∈ lrel → ra_add ⟨ kc_s , scons ta ∅ ⟩ y ⟨ kc_s , scons c ∅ ⟩ ∈ lrel) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_sl_q ta $ by cab_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_sl_q ta $ by wcel_intro [l10, l9]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_sl_q ta ⇒ ⟨ x8 , x9 ⟩ ∈ f29_sl_q ta $ by isset_elim [l12, l11]
l14: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_sl_q ta → ⟨ x8 , x9 ⟩ ∈ f29_sl_q ta $ by imp_intro [imp_intro [imp_intro [l13]]]
l15: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_sl_q ta → ⟨ x8 , x9 ⟩ ∈ f29_sl_q ta) $ by all_intro [all_intro [l14]]
l16: $ G ⇒ isset ω $ by omega_set
l17: $ G ⇒ trees ω ⊆ f29_sl_q ta $ by trees_ind_c [l16, l15]

add_suc_l
---------
l1: $ G ⇒ ⟨ kr_add , scons ta (scons tb (scons tc ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tc ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tb (scons tc ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ta (scons tb (scons tc ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
l7: $ G ⇒ kr_add ∈ ω ∧ scons ta (scons tb (scons tc ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons ta (scons tb (scons tc ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ crn (scons tb (scons tc ∅)) ⊆ trees ω $ by crn_scons_tail [l8]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ tb ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ trees ω ⊆ f29_sl_q ta $ by f29_sl_all
l13: $ G ⇒ tb ∊ f29_sl_q ta $ by subset_elim [l12, wcel_welc [l11]]
l14: $ G ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ tb ⟨ kc_s , scons tc ∅ ⟩ ∈ lrel $ by f29_sl_e [l13, #1]

def f29_ac_q (ta: set) (.y .c: set): class = $ {y | ∀ c (ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel → ra_add ta y c ∈ lrel → ra_add y ta c ∈ lrel)} $

lemma f29_ac_e (G: hyps) (ta: set) (ty vc: set): $ G ⇒ ty ∊ f29_ac_q ta $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel $ > $ G ⇒ ra_add ta ty vc ∈ lrel $ > $ G ⇒ ra_add ty ta vc ∈ lrel $
----
l1: $ G ⇒ ∀ c (ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel → ra_add ta ty c ∈ lrel → ra_add ty ta c ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel → ra_add ta ty vc ∈ lrel → ra_add ty ta vc ∈ lrel $ by all_elim [l1]
l3: $ G ⇒ ra_add ta ty vc ∈ lrel → ra_add ty ta vc ∈ lrel $ by imp_elim [l2, #2]
l4: $ G ⇒ ra_add ty ta vc ∈ lrel $ by imp_elim [l3, #3]

lemma f29_ac_n (G: hyps) (ta: set) (ty k1 j1 vc: set): $ G ⇒ crn j1 ⊆ f29_ac_q ta $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel $ > $ G ⇒ ra_add ta ty vc ∈ lrel $ > $ G ⇒ ra_add ty ta vc ∈ lrel $
----
l1: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta $ by ax
l2: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel $ by weaken [#5]
l3: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ta = ta $ by eq_refl
l4: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vc = ta ⇒ ra_add ty ta vc ∈ lrel $ by wcel_eq_l [ra_add_eq [eq_sym [and_elim_l [l1]], l3, eq_sym [and_elim_r [l1]]], l2]
l5: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel $ by ax
l6: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel $ by weaken [#5]
l7: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset ∅ $ by ax_empty
l8: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset (scons n ∅) $ by scons_set [l7]
l9: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn j1 ⊆ f29_ac_q ta $ by weaken [#1]
l10: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l11: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
l12: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ crn (scons n ∅) ⊆ f29_ac_q ta $ by node_crn_sub [l9, l10, and_elim_l [l5], wcel_isset [l11], l8]
l13: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ isset n $ by isset_var
l14: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ n ∈ f29_ac_q ta $ by crn_scons_head [l13, l12]
l15: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ra_add n ta j ∈ lrel $ by f29_ac_e [wcel_welc [l14], l6, and_elim_r [and_elim_r [l5]]]
l16: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ra_add ⟨ kc_s , scons n ∅ ⟩ ta ⟨ kc_s , scons j ∅ ⟩ ∈ lrel $ by add_suc_l [l15]
l17: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ta = ta $ by eq_refl
l18: $ G , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ vc = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_add ta n j ∈ lrel ⇒ ra_add ty ta vc ∈ lrel $ by wcel_eq_l [ra_add_eq [eq_sym [and_elim_l [l5]], l17, eq_sym [and_elim_l [and_elim_r [l5]]]], l16]
l19: $ G ⇒ ra_add ty ta vc ∈ lrel $ by f21_inv_add [#6, l4, l18]

lemma f29_ac_all (G: hyps) (ta: set): $ G ⇒ trees ω ⊆ f29_ac_q ta $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel , ra_add ta y c ∈ lrel ⇒ crn x9 ⊆ f29_ac_q ta $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel , ra_add ta y c ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel , ra_add ta y c ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel , ra_add ta y c ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel , ra_add ta y c ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel , ra_add ta y c ∈ lrel ⇒ ra_add ta y c ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel , ra_add ta y c ∈ lrel ⇒ ra_add y ta c ∈ lrel $ by f29_ac_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ , ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel ⇒ ra_add ta y c ∈ lrel → ra_add y ta c ∈ lrel $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel → ra_add ta y c ∈ lrel → ra_add y ta c ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c (ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel → ra_add ta y c ∈ lrel → ra_add y ta c ∈ lrel) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_ac_q ta $ by cab_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_ac_q ta $ by wcel_intro [l12, l11]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_ac_q ta ⇒ ⟨ x8 , x9 ⟩ ∈ f29_ac_q ta $ by isset_elim [l14, l13]
l16: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_ac_q ta → ⟨ x8 , x9 ⟩ ∈ f29_ac_q ta $ by imp_intro [imp_intro [imp_intro [l15]]]
l17: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_ac_q ta → ⟨ x8 , x9 ⟩ ∈ f29_ac_q ta) $ by all_intro [all_intro [l16]]
l18: $ G ⇒ isset ω $ by omega_set
l19: $ G ⇒ trees ω ⊆ f29_ac_q ta $ by trees_ind_c [l18, l17]

add_comm
--------
l1: $ G ⇒ ⟨ kr_add , scons ta (scons tb (scons tc ∅)) ⟩ ∈ latoms $ by lrel_latoms [#2]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tc ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tb (scons tc ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons ta (scons tb (scons tc ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
l7: $ G ⇒ kr_add ∈ ω ∧ scons ta (scons tb (scons tc ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons ta (scons tb (scons tc ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ crn (scons tb (scons tc ∅)) ⊆ trees ω $ by crn_scons_tail [l8]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ tb ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ trees ω ⊆ f29_ac_q ta $ by f29_ac_all
l13: $ G ⇒ tb ∊ f29_ac_q ta $ by subset_elim [l12, wcel_welc [l11]]
l14: $ G ⇒ ra_add tb ta tc ∈ lrel $ by f29_ac_e [l13, #1, #2]

def f29_cn_q  (.y .n: set): class = $ {y | ∀ n (ra_clen y n ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel)} $

lemma f29_cn_e (G: hyps)  (ty vn: set): $ G ⇒ ty ∊ f29_cn_q  $ > $ G ⇒ ra_clen ty vn ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $
----
l1: $ G ⇒ ∀ n (ra_clen ty n ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ra_clen ty vn ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by all_elim [l1]
l3: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by imp_elim [l2, #2]

lemma f29_cn_n (G: hyps)  (ty k1 j1 vn: set): $ G ⇒ crn j1 ⊆ f29_cn_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_clen ty vn ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $
----
l1: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ kc_nz ∈ ω $ by kc_nz_omega
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l2, l3, l4]
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_add_z [l5]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l8: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by wcel_eq_l [ra_add_eq [l7, eq_sym [and_elim_r [l1]], eq_sym [and_elim_r [l1]]], l6]
l9: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel $ by ax
l10: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset ω $ by omega_set
l11: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ kc_nz ∈ ω $ by kc_nz_omega
l12: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l13: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l10, l11, l12]
l14: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset ∅ $ by ax_empty
l15: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset (scons e ∅) $ by scons_set [l14]
l16: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset (scons d (scons e ∅)) $ by scons_set [l15]
l17: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ crn j1 ⊆ f29_cn_q  $ by weaken [#1]
l18: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l19: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l20: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ crn (scons d (scons e ∅)) ⊆ f29_cn_q  $ by node_crn_sub [l17, l18, and_elim_l [l9], wcel_isset [l19], l16]
l21: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ crn (scons e ∅) ⊆ f29_cn_q  $ by crn_scons_tail [l20]
l22: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset e $ by isset_var
l23: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ e ∈ f29_cn_q  $ by crn_scons_head [l22, l21]
l24: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ k k ∈ lrel $ by f29_cn_e [wcel_welc [l23], and_elim_r [and_elim_r [l9]]]
l25: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ⟨ kr_clen , scons e (scons k ∅) ⟩ ∈ latoms $ by lrel_latoms [and_elim_r [and_elim_r [l9]]]
l26: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset ∅ $ by ax_empty
l27: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset (scons k ∅) $ by scons_set [l26]
l28: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset (scons e (scons k ∅)) $ by scons_set [l27]
l29: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ kr_clen ∈ ω $ by kr_clen_omega
l30: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ kr_clen ∈ ω ∧ scons e (scons k ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l25, wcel_isset [l29], l28]
l31: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ crn (scons e (scons k ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l30]]
l32: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ crn (scons k ∅) ⊆ trees ω $ by crn_scons_tail [l31]
l33: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ isset ω $ by omega_set
l34: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ k ∈ trees ω $ by crn_scons_head_trees [l33, l32]
l35: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_s , scons k ∅ ⟩ ∈ lrel $ by lrel_add_s [l13, l34, l34, l24]
l36: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l37: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ vn = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_clen e k ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by wcel_eq_l [ra_add_eq [l36, eq_sym [and_elim_l [and_elim_r [l9]]], eq_sym [and_elim_l [and_elim_r [l9]]]], l35]
l38: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ vn vn ∈ lrel $ by f21_inv_clen [#5, l8, l37]

lemma f29_cn_all (G: hyps) : $ G ⇒ trees ω ⊆ f29_cn_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ , ra_clen y n ∈ lrel ⇒ crn x9 ⊆ f29_cn_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ , ra_clen y n ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ , ra_clen y n ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ , ra_clen y n ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ , ra_clen y n ∈ lrel ⇒ ra_clen y n ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ , ra_clen y n ∈ lrel ⇒ ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel $ by f29_cn_n [l1, l2, l3, l4, l5]
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_clen y n ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel $ by imp_intro [l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n (ra_clen y n ∈ lrel → ra_add ⟨ kc_nz , ∅ ⟩ n n ∈ lrel) $ by all_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_cn_q  $ by cab_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_cn_q  $ by wcel_intro [l10, l9]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cn_q  ⇒ ⟨ x8 , x9 ⟩ ∈ f29_cn_q  $ by isset_elim [l12, l11]
l14: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_cn_q  → ⟨ x8 , x9 ⟩ ∈ f29_cn_q  $ by imp_intro [imp_intro [imp_intro [l13]]]
l15: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_cn_q  → ⟨ x8 , x9 ⟩ ∈ f29_cn_q ) $ by all_intro [all_intro [l14]]
l16: $ G ⇒ isset ω $ by omega_set
l17: $ G ⇒ trees ω ⊆ f29_cn_q  $ by trees_ind_c [l16, l15]

clen_num
--------
l1: $ G ⇒ ⟨ kr_clen , scons tq (scons tn ∅) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tn ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tq (scons tn ∅)) $ by scons_set [l3]
l5: $ G ⇒ kr_clen ∈ ω $ by kr_clen_omega
l6: $ G ⇒ kr_clen ∈ ω ∧ scons tq (scons tn ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l5], l4]
l7: $ G ⇒ crn (scons tq (scons tn ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l6]]
l8: $ G ⇒ isset ω $ by omega_set
l9: $ G ⇒ tq ∈ trees ω $ by crn_scons_head_trees [l8, l7]
l10: $ G ⇒ trees ω ⊆ f29_cn_q  $ by f29_cn_all
l11: $ G ⇒ tq ∊ f29_cn_q  $ by subset_elim [l10, wcel_welc [l9]]
l12: $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ tn tn ∈ lrel $ by f29_cn_e [l11, #1]

def f29_c1_q (ta: set) (.y .r .n: set): class = $ {y | ∀ r ∀ n (ra_capp y ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel → ra_clen y n ∈ lrel → ra_clen r ⟨ kc_s , scons n ∅ ⟩ ∈ lrel)} $

lemma f29_c1_e (G: hyps) (ta: set) (ty vr vn: set): $ G ⇒ ty ∊ f29_c1_q ta $ > $ G ⇒ ra_capp ty ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vr ∈ lrel $ > $ G ⇒ ra_clen ty vn ∈ lrel $ > $ G ⇒ ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $
----
l1: $ G ⇒ ∀ r ∀ n (ra_capp ty ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ r ∈ lrel → ra_clen ty n ∈ lrel → ra_clen r ⟨ kc_s , scons n ∅ ⟩ ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ n (ra_capp ty ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vr ∈ lrel → ra_clen ty n ∈ lrel → ra_clen vr ⟨ kc_s , scons n ∅ ⟩ ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ra_capp ty ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vr ∈ lrel → ra_clen ty vn ∈ lrel → ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $ by all_elim [l2]
l4: $ G ⇒ ra_clen ty vn ∈ lrel → ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $ by imp_elim [l3, #2]
l5: $ G ⇒ ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $ by imp_elim [l4, #3]

--| @freshen H qA
--| @freshen H qP
--| @freshen H qG2
lemma f21_inv_capp {qA qP qG2: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_capp t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 ⇒ Cf $ > $ H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_capp t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by lrel_capp_cases [l1]
l3: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x $ by ax
l4: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t3 = t2 $ by eq_trans [and_elim_r [and_elim_r [l3]], eq_sym [and_elim_l [and_elim_r [l3]]]]
l5: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 $ by and_intro [and_elim_l [l3], l4]
l6: $ H ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by weaken [l6]
l8: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel $ by ax
l13: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ qP = qP $ by eq_refl
l14: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ qG2 = qG2 $ by eq_refl
l15: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ ra_capp qP t2 qG2 ∈ lrel $ by wcel_eq_l [ra_capp_eq [l13, eq_sym [and_elim_l [and_elim_r [l12]]], l14], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l16: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel $ by and_intro [and_elim_l [l12], and_intro [and_elim_l [and_elim_r [and_elim_r [l12]]], l15]]
l17: $ H ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel → Cf $ by imp_intro [#3]
l18: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel → Cf $ by weaken [l17]
l19: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ Cf $ by imp_elim [l18, l16]
l20: $ G , H , ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l21: $ … ⇒ Cf $ by ex_elim [l20, l19]
l22: $ G , H , ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
l24: $ G , H , ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H ⇒ (∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel)) → Cf $ by imp_intro [l27]
l29: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel)) → Cf $ by or_elim_imp [l11, l28]
l30: $ G , H ⇒ Cf $ by imp_elim [l29, l2]

lemma f29_c1_n (G: hyps) (ta: set) (ty k1 j1 vr vn: set): $ G ⇒ crn j1 ⊆ f29_c1_q ta $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_capp ty ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vr ∈ lrel $ > $ G ⇒ ra_clen ty vn ∈ lrel $ > $ G ⇒ ra_clen vr ⟨ kc_s , scons vn ∅ ⟩ ∈ lrel $
----
l1: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ⇒ x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ $ by ax
l2: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ⇒ ty = ty $ by eq_refl
l3: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ⇒ vr = vr $ by eq_refl
l4: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ⇒ ra_capp ty x1 vr ∈ lrel $ by wcel_eq_l [ra_capp_eq [l2, eq_sym [l1], l3], weaken [#5]]
l5: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 $ by ax
l6: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 ⇒ x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ $ by weaken [l1]
l7: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 ⇒ ra_capp ty x1 vr ∈ lrel $ by weaken [l4]
l8: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 ⇒ ra_clen ty vn ∈ lrel $ by weaken [#6]
l9: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 ⇒ ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_clen_nil
l10: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ x2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l11: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen ty x2 ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [weaken [and_elim_l [l5]]], eq_sym [l10]], weaken [l9]]
l12: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ vn = x2 $ by lrel_clen_det [weaken [l8], l11]
l13: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_capp ty x1 vr ∈ lrel $ by weaken [l7]
l14: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kr_capp , scons ty (scons x1 (scons vr ∅)) ⟩ ∈ latoms $ by lrel_latoms [l13]
l15: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l16: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons vr ∅) $ by scons_set [l15]
l17: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons x1 (scons vr ∅)) $ by scons_set [l16]
l18: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons ty (scons x1 (scons vr ∅))) $ by scons_set [l17]
l19: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_capp ∈ ω $ by kr_capp_omega
l20: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ kr_capp ∈ ω ∧ scons ty (scons x1 (scons vr ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l14, wcel_isset [l19], l18]
l21: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ crn (scons ty (scons x1 (scons vr ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l20]]
l22: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ crn (scons x1 (scons vr ∅)) ⊆ trees ω $ by crn_scons_tail [l21]
l23: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l24: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ x1 ∈ trees ω $ by crn_scons_head_trees [l23, l22]
l25: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ∈ trees ω $ by wcel_eq_l [weaken [l6], l24]
l26: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l27: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cons ∈ ω $ by kc_cons_omega
l28: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l29: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cons ∈ ω ∧ scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq (trees ω) $ by trees_node_c [l26, l25, wcel_isset [l27], scons_set [scons_set [l28]]]
l30: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ta ∈ trees ω $ by welc_wcel [scons_fseq_hd [and_elim_r [l29]]]
l31: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l32: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_nil ∈ ω $ by kc_nil_omega
l33: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l34: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nil , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l31, l32, l33]
l35: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
l36: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_nz ∈ ω $ by kc_nz_omega
l37: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l38: $ G , x1 = ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = x1 , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l35, l36, l37]
