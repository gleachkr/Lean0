l1: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel $ by ax
l2: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ isset ∅ $ by ax_empty
l3: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ isset (scons f ∅) $ by scons_set [l2]
l4: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ isset (scons a (scons f ∅)) $ by scons_set [l3]
l5: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ crn j1 ⊆ f39_q H J MV u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs $ by weaken [#1]
l6: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l7: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l8: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ crn (scons a (scons f ∅)) ⊆ f39_q H J MV u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs $ by node_crn_sub [l5, l6, and_elim_l [l1], wcel_isset [l7], l4]
l9: $ G , ty = ⟨ kc_pi , scons a (scons f ∅) ⟩ ∧ vv = ⟨ kc_lam , scons c (scons g ∅) ⟩ ∧ ra_add vd tnp x ∈ lrel ∧ ra_closed x a ∈ lrel ∧ ra_add tm tn v ∈ lrel ∧ ra_lift v vd a c ∈ lrel ∧ ra_rwalk td tnp tn tm tv tnf ⟨ kc_s , scons vd ∅ ⟩ va f g ∈ lrel ⇒ crn (scons f ∅) ⊆ f39_q H J MV u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs $ by crn_scons_tail [l8]
