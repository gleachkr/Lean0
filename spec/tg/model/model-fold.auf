l18: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ crn (scons tg (scons tb ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l17]]
l19: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ crn (scons tb ∅) ⊆ trees ω $ by crn_scons_tail [l18]
l20: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ va = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
