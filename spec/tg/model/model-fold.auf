l532: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ , x6 = scons x1 vk ⇒ isset (scons x1 vr) $ by scons_set [l531]
l533: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ , x6 = scons x1 vk ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by isset_elim [l532, l530]
l534: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ isset vk $ by isset_var
l535: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ isset (scons x1 vk) $ by scons_set [l534]
l536: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 , x5 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by isset_elim [l535, l533]
l537: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 ⇒ isset ⟨ kc_s , scons vd ∅ ⟩ $ by opair_isset
l538: $ G , x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4 ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by isset_elim [l537, l536]
l539: $ G , ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) ⇒ ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) $ by ax
l540: $ … ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by ex_elim [l539, l538]
l541: $ G , ∃ x3 ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) ⇒ ∃ x3 ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) $ by ax
l542: $ … ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by ex_elim [l541, l540]
l543: $ G , ∃ x2 ∃ x3 ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) ⇒ ∃ x2 ∃ x3 ∃ x4 (x1 ∊ dt u (mcv H) tA w vl ∧ x1 ∊ u ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tB w (scons x1 vl) ∧ vf = ssnoc x2 x1 ∧ vg = scons x1 x3 ∧ vc = scons (etel u (dnf u (mcv H)) tA w vl) x4) $ by ax
l544: $ … ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by ex_elim [l543, l542]
l545: $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by ex_elim [l158, l544]

--| @freshen G z
--| @freshen G j
--| @freshen G b
--| @freshen G e
--| @freshen G m
--| @freshen G y
lemma f39_c2 {z j b e m y: set} (G: hyps) (H J MV: class) (u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs: set) (ty vd va vv vk vr vl vf vg vc vt vh vx vn : set): $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ > $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ > $ G ⇒ tK0 ∊ trees ω $ > $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) $ > $ G ⇒ ∀ j ∀ b ∀ e ∀ z (ra_nth_ty tt j b e ∈ lrel → nvf' j ∈ nvf' tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (nvf' j) (lv tv w) w) $ > $ G ⇒ ss ∊ fseq u $ > $ G ⇒ cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ c0 = mv ++ cv $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → nvf' b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = xs' j) $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ > $ G ⇒ vv ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ trees ω $ > $ G ⇒ ra_closed vx ty ∈ lrel $ > $ G ⇒ nvf' vx = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vd) = nvf' tnf $ > $ G ⇒ ∀ b ∀ e ∀ m (ra_nth_pi ty b e ∈ lrel → ra_add vd b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) $ > $ G ⇒ vk ∊ fseq u $ > $ G ⇒ cdm vk = nvf' vd $ > $ G ⇒ vt ∊ fseq u $ > $ G ⇒ cdm vt = nvf' vd $ > $ G ⇒ vh ∊ fseq {y | y = y} $ > $ G ⇒ cdm vh = nvf' vd $ > $ G ⇒ vr = vk ++ c0 ++ p ++ ss $ > $ G ⇒ vl = vk ++ p ++ xs $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vc , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vl $ > $ G ⇒ pg = vt ++ vg $ > $ G ⇒ pt = vh ++ vc $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) → dt u (mcv H) va w (vf ++ vr) = apn MV (z ++ vf ++ vk)) $ > $ G ⇒ vd = tnf $ > $ G ⇒ vv = va $ > $ G ⇒ ra_npis ty ⟨ kc_nz , ∅ ⟩ ∈ lrel $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $
----
l1: $ G ⇒ iwf u H J tg td w r0 $ by weaken [#1]
l2: $ G ⇒ w ∊ lvals $ by wcel_welc [iwf_lvals [l1]]
l3: $ G ⇒ uadm u $ by iwf_uadm [l1]
l4: $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ by weaken [#7]
l5: $ G ⇒ mv ∊ ivals k u (inmin td) {y | ∃ i ∃ c (iminx td i c k ∧ y ∊ imin u (dnf u (mcv H)) td i c w p cv ∧ ihasc td i c)} $ by weaken [l4]
l6: $ G ⇒ mv ∊ fseq u $ by and_elim_l [ivals_fseq [l5]]
l7: $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ by weaken [#6]
l8: $ G ⇒ cv ∊ ivals j u (intys td) (imot u (dnf u (mcv H)) td j w p (lv tv w)) $ by weaken [l7]
l9: $ G ⇒ cv ∊ fseq u $ by and_elim_l [ivals_fseq [l8]]
l10: $ G ⇒ esat u (dnf u (mcv H)) tp w ⊆ fseq u $ by esat_fseq
l11: $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ by weaken [#5]
l12: $ G ⇒ p ∊ fseq u $ by subset_elim [l10, l11]
l13: $ G ⇒ c0 = mv ++ cv $ by weaken [#14]
l14: $ G ⇒ c0 ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l13], scat_fseq [l6, l9]]]
l15: $ G ⇒ vk ∊ fseq u $ by weaken [#26]
l16: $ G ⇒ ss ∊ fseq u $ by weaken [#12]
l17: $ G ⇒ c0 ++ p ++ ss ∈ fseq u $ by scat_fseq_c [welc_wcel [l14], scat_fseq [l12, l16]]
l18: $ G ⇒ xs ∊ fseq u $ by weaken [#15]
l19: $ G ⇒ p ++ xs ∈ fseq u $ by scat_fseq [l12, l18]
l20: $ G ⇒ vr = vk ++ c0 ++ p ++ ss $ by weaken [#32]
l21: $ G ⇒ vr ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l20], scat_fseq_c [welc_wcel [l15], l17]]]
l22: $ G ⇒ vl = vk ++ p ++ xs $ by weaken [#33]
l23: $ G ⇒ vl ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [l22], scat_fseq_c [welc_wcel [l15], l19]]]
l24: $ G ⇒ isset vd $ by isset_var
l25: $ G ⇒ nvf' vd ∈ ω $ by nvf_omega [l24]
l26: $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ by weaken [#18]
l27: $ G ⇒ ⟨ kr_rwalk , scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))))) ⟩ ∈ latoms $ by lrel_latoms [l26]
l28: $ G ⇒ isset ∅ $ by ax_empty
l29: $ G ⇒ isset (scons vv ∅) $ by scons_set [l28]
l30: $ G ⇒ isset (scons ty (scons vv ∅)) $ by scons_set [l29]
l31: $ G ⇒ isset (scons va (scons ty (scons vv ∅))) $ by scons_set [l30]
l32: $ G ⇒ isset (scons vd (scons va (scons ty (scons vv ∅)))) $ by scons_set [l31]
l33: $ G ⇒ isset (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))) $ by scons_set [l32]
l34: $ G ⇒ isset (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))) $ by scons_set [l33]
l35: $ G ⇒ isset (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))) $ by scons_set [l34]
l36: $ G ⇒ isset (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))))) $ by scons_set [l35]
l37: $ G ⇒ isset (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))))) $ by scons_set [l36]
l38: $ G ⇒ isset (scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))))))) $ by scons_set [l37]
l39: $ G ⇒ kr_rwalk ∈ ω $ by kr_rwalk_omega
l40: $ G ⇒ kr_rwalk ∈ ω ∧ scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l27, wcel_isset [l39], l38]
l41: $ G ⇒ crn (scons td (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))))))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l40]]
l42: $ G ⇒ crn (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))))) ⊆ trees ω $ by crn_scons_tail [l41]
l43: $ G ⇒ crn (scons tn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))))) ⊆ trees ω $ by crn_scons_tail [l42]
l44: $ G ⇒ crn (scons tm (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))))) ⊆ trees ω $ by crn_scons_tail [l43]
l45: $ G ⇒ crn (scons tv (scons tnf (scons vd (scons va (scons ty (scons vv ∅)))))) ⊆ trees ω $ by crn_scons_tail [l44]
l46: $ G ⇒ crn (scons tnf (scons vd (scons va (scons ty (scons vv ∅))))) ⊆ trees ω $ by crn_scons_tail [l45]
l47: $ G ⇒ crn (scons vd (scons va (scons ty (scons vv ∅)))) ⊆ trees ω $ by crn_scons_tail [l46]
l48: $ G ⇒ crn (scons va (scons ty (scons vv ∅))) ⊆ trees ω $ by crn_scons_tail [l47]
l49: $ G ⇒ crn (scons ty (scons vv ∅)) ⊆ trees ω $ by crn_scons_tail [l48]
l50: $ G ⇒ isset ω $ by omega_set
l51: $ G ⇒ ty ∈ trees ω $ by crn_scons_head_trees [l50, l49]
l52: $ G ⇒ ty ∊ trees ω $ by wcel_welc [l51]
l53: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ x1 = ⟨ kc_nz , ∅ ⟩ $ by ax
l54: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis ty ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by weaken [#40]
l55: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ty $ by eq_refl
l56: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis ty x1 ∈ lrel $ by wcel_eq_l [ra_npis_eq [l55, eq_sym [l53]], l54]
l57: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ty ∊ trees ω $ by weaken [l52]
l58: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ vf , ⟨ vg , ⟨ vc , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vl $ by weaken [#34]
l59: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ cdm vf = nvf' x1 $ by lrel_npis_sem [l56, l57, l58]
l60: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l61: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l62: $ G , x1 = ⟨ kc_nz , ∅ ⟩ ⇒ cdm vf = ∅ $ by eq_trans [l59, eq_trans [fv_eq [l60, l53], l61]]
l63: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l64: $ G ⇒ cdm vf = ∅ $ by isset_elim [l63, l62]
l65: $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vc , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vl $ by weaken [#34]
l66: $ G ⇒ vf ∊ fseq u ∧ vg ∊ fseq u ∧ cdm vg = cdm vf ∧ cdm vc = cdm vf $ by etel_fseq [welc_wcel [l52], l65]
l67: $ G ⇒ vf ∊ fseq u $ by and_elim_l [l66]
l68: $ G ⇒ vf = ∅ $ by fseq_len_zero [l67, l64]
l69: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ nvf = nvf $ by eq_refl
l70: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ vd = tnf $ by weaken [#38]
l71: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) $ by ax
l72: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) $ by welc_eq [ihv_eq_arg [fv_eq [l69, eq_sym [l70]]], l71]
l73: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) → dt u (mcv H) va w (vf ++ vr) = apn MV (z ++ vf ++ vk)) $ by weaken [#37]
l74: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) → dt u (mcv H) va w (vf ++ vr) = apn MV (z ++ vf ++ vk) $ by all_elim [l73]
l75: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ dt u (mcv H) va w (vf ++ vr) = apn MV (z ++ vf ++ vk) $ by imp_elim [l74, l72]
l76: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ vf = ∅ $ by weaken [l68]
l77: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ vr = vr $ by eq_refl
l78: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ vr ∊ fseq u $ by weaken [l21]
l79: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ vf ++ vr = vr $ by eq_trans [scat_eq [l76, l77], scat_empty_l [l78]]
l80: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ u = u $ by eq_refl
l81: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ (mcv H) = (mcv H) $ by eq_refl
l82: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ vv = va $ by weaken [#39]
l83: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ w = w $ by eq_refl
l84: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ vf = ∅ $ by weaken [l68]
l85: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ va = va $ by eq_refl
l86: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ apn (dt u (mcv H) vv w vr) vf = dt u (mcv H) va w (vf ++ vr) $ by eq_trans [apn_eq [dt_eq [l80, l81, l82, l83, l77], l84], eq_trans [apn_empty [], dt_eq [l80, l81, l85, l83, eq_sym [l79]]]]
l87: $ G , z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) ⇒ apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk) $ by eq_trans [l86, l75]
l88: $ G ⇒ z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk) $ by imp_intro [l87]
l89: $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $ by all_intro [l88]

--| @freshen G z
--| @freshen G j
--| @freshen G b
--| @freshen G e
--| @freshen G m
--| @freshen G y
lemma f39_n {z j b e m y: set} (G: hyps) (H J MV: class) (u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs: set) (ty k1 j1 vd va vv vk vr vl vf vg vc vt vh vx vn: set): $ G ⇒ crn j1 ⊆ f39_q H J MV u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ > $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ > $ G ⇒ tK0 ∊ trees ω $ > $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (p ++ ixs td w (ifam u (dnf u (mcv H)) td w)) $ > $ G ⇒ ∀ j ∀ b ∀ e ∀ z (ra_nth_ty tt j b e ∈ lrel → nvf' j ∈ nvf' tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (nvf' j) (lv tv w) w) $ > $ G ⇒ ss ∊ fseq u $ > $ G ⇒ cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ c0 = mv ++ cv $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ cdm xs = nvf' tn $ > $ G ⇒ ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → nvf' b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = xs' j) $ > $ G ⇒ ra_rwalk td tnp tn tm tv tnf vd va ty vv ∈ lrel $ > $ G ⇒ vv ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vd ∊ trees ω $ > $ G ⇒ ra_closed vx ty ∈ lrel $ > $ G ⇒ nvf' vx = nadd (nadd (nvf' vd) (nvf' tnp)) (nvf' tn) $ > $ G ⇒ ra_npis ty vn ∈ lrel $ > $ G ⇒ nadd (nvf' vn) (nvf' vd) = nvf' tnf $ > $ G ⇒ ∀ b ∀ e ∀ m (ra_nth_pi ty b e ∈ lrel → ra_add vd b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) $ > $ G ⇒ vk ∊ fseq u $ > $ G ⇒ cdm vk = nvf' vd $ > $ G ⇒ vt ∊ fseq u $ > $ G ⇒ cdm vt = nvf' vd $ > $ G ⇒ vh ∊ fseq {y | y = y} $ > $ G ⇒ cdm vh = nvf' vd $ > $ G ⇒ vr = vk ++ c0 ++ p ++ ss $ > $ G ⇒ vl = vk ++ p ++ xs $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vc , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vl $ > $ G ⇒ pg = vt ++ vg $ > $ G ⇒ pt = vh ++ vc $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' vd) → dt u (mcv H) va w (vf ++ vr) = apn MV (z ++ vf ++ vk)) $ > $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (nvf' tnf) → apn (dt u (mcv H) vv w vr) vf = apn MV (z ++ vf ++ vk)) $
