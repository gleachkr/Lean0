l111: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ qni ∃ qk_v ∃ qa_v ∃ qmn ∃ qb_v ∃ qf_v ∃ qY ∃ qX1 ∃ qX2 ∃ qX3 ∃ qU ∃ qA (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = qA ∧ t11 = ⟨ kc_app , scons qX3 (scons qU ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons x (scons c ∅) ⟩ qA qk_v ∈ lrel ∧ ra_nidx x c qni ∈ lrel ∧ ra_add y qni qk_v ∈ lrel ∧ ra_rehead qY qX2 qni qA qX3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons x (scons c ∅) ⟩ qY y ∈ lrel ∧ ra_add b w qa_v ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_add qa_v qmn qb_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons x (scons c (scons v ∅)) ⟩ qb_v y qX1 ∈ lrel ∧ ra_pargs qX1 qa_v qmn qX2 ∈ lrel ∧ ra_add b a qf_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qf_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b qU ∈ lrel)) → Cf $ by imp_intro [l110]
l112: $ G , H ⇒ (∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ qA ∃ qB ∃ qIH (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons qA (scons qIH ∅) ⟩ ∧ ra_ihval x y z u v w a ⟨ kc_s , scons b ∅ ⟩ c qB qIH ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ qni ∃ qk_v ∃ qa_v ∃ qmn ∃ qb_v ∃ qf_v ∃ qY ∃ qX1 ∃ qX2 ∃ qX3 ∃ qU ∃ qA (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = qA ∧ t11 = ⟨ kc_app , scons qX3 (scons qU ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons x (scons c ∅) ⟩ qA qk_v ∈ lrel ∧ ra_nidx x c qni ∈ lrel ∧ ra_add y qni qk_v ∈ lrel ∧ ra_rehead qY qX2 qni qA qX3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons x (scons c ∅) ⟩ qY y ∈ lrel ∧ ra_add b w qa_v ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_add qa_v qmn qb_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons x (scons c (scons v ∅)) ⟩ qb_v y qX1 ∈ lrel ∧ ra_pargs qX1 qa_v qmn qX2 ∈ lrel ∧ ra_add b a qf_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qf_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b qU ∈ lrel)) → Cf $ by or_elim_imp [l37, l111]
