l4: $ G ⇒ ssnoc s a = s ++ (scons a ∅) $ by ssnoc_scat [#1]
l5: $ G ⇒ ssnoc t b = t ++ (scons b ∅) $ by ssnoc_scat [#2]
l6: $ G ⇒ s ++ (scons a ∅) = t ++ (scons b ∅) $ by eq_trans [eq_sym [l4], eq_trans [#5, l5]]
