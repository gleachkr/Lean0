l7: $ G ⇒ ⟨ kr_clen , scons tp (scons tnp ∅) ⟩ ∈ latoms $ by lrel_latoms [l6]
l8: $ G ⇒ isset ∅ $ by ax_empty
l9: $ G ⇒ isset (scons tnp ∅) $ by scons_set [l8]
l10: $ G ⇒ isset (scons tp (scons tnp ∅)) $ by scons_set [l9]
l11: $ G ⇒ kr_clen ∈ ω $ by kr_clen_omega
