l64: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b , x2 = nadd k b , f ∊ fseq A ∧ cdm f = x2 ∧ c = scons e f , m ∊ fseq A ∧ n ∊ fseq A ∧ cdm m = k ∧ cdm n = b ∧ f = m ++ n ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by isset_elim [l63, l61]
l65: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b , x2 = nadd k b , f ∊ fseq A ∧ cdm f = x2 ∧ c = scons e f , ∃ n (m ∊ fseq A ∧ n ∊ fseq A ∧ cdm m = k ∧ cdm n = b ∧ f = m ++ n) ⇒ ∃ n (m ∊ fseq A ∧ n ∊ fseq A ∧ cdm m = k ∧ cdm n = b ∧ f = m ++ n) $ by ax
l66: $ … ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by ex_elim [l65, l64]
l67: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b , x2 = nadd k b , f ∊ fseq A ∧ cdm f = x2 ∧ c = scons e f ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by ex_elim [l44, l66]
l68: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b , x2 = nadd k b , ∃ f (f ∊ fseq A ∧ cdm f = x2 ∧ c = scons e f) ⇒ ∃ f (f ∊ fseq A ∧ cdm f = x2 ∧ c = scons e f) $ by ax
l69: $ … ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by ex_elim [l68, l67]
l70: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b , x2 = nadd k b ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by ex_elim [l33, l69]
l71: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b ⇒ k ∊ ω $ by weaken [l25]
l72: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b ⇒ b ∊ ω $ by weaken [l24]
l73: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b ⇒ isset (nadd k b) $ by wcel_isset [nadd_omega [l71, l72]]
l74: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A , cdm c = nadd z b ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by isset_elim [l73, l70]
l75: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k , c ∊ fseq A ⇒ cdm c = nadd z b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by imp_intro [l74]
l76: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k ⇒ c ∊ fseq A → cdm c = nadd z b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g) $ by imp_intro [l75]
l77: $ G , k ∊ ω , ∀ c (c ∊ fseq A → cdm c = nadd k b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = k ∧ cdm g = b ∧ c = q ++ g)) , z = suc k ⇒ ∀ c (c ∊ fseq A → cdm c = nadd z b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = z ∧ cdm g = b ∧ c = q ++ g)) $ by all_intro [l76]
l78: $ G ⇒ ∀ c (c ∊ fseq A → cdm c = nadd a b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = a ∧ cdm g = b ∧ c = q ++ g)) $ by omega_ind_named [l23, l77, #2]
l79: $ G ⇒ ∀ c (c ∊ fseq A → cdm c = nadd a b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = a ∧ cdm g = b ∧ c = q ++ g)) $ by weaken [l78]
l80: $ G ⇒ s ∊ fseq A → cdm s = nadd a b → ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = a ∧ cdm g = b ∧ s = q ++ g) $ by all_elim [l79]
l81: $ G ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = a ∧ cdm g = b ∧ s = q ++ g) $ by imp_elim [imp_elim [l80, #1], #4]

lemma f23_vr (G: hyps) (A N: class) (p s i n: set): $ G ⇒ p ∊ fseq A $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ i ∊ n $ > $ G ⇒ n ∊ ω $ > $ G ⇒ nadd n (cdm p) = N $ > $ G ⇒ vat (p ++ s) N i = vat s n i $
----
l1: $ G ⇒ i ∊ ω $ by omega_elem_omega [#4, #3]
l2: $ G ⇒ ∃ c (c ∊ ω ∧ nadd i (suc c) = n) $ by nlt_ex [l1, #4, #3]
l3: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ c ∊ ω ∧ nadd i (suc c) = n $ by ax
l4: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ i ∊ ω $ by weaken [l1]
l5: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ c ∈ ω $ by welc_wcel [and_elim_l [l3]]
l6: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ cdm p ∈ ω $ by fseq_len [weaken [#1]]
l7: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ suc i ∈ ω $ by omega_suc_c [welc_wcel [l4]]
l8: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ nadd (suc i) c = n $ by eq_trans [suc_nadd [and_elim_l [l3]], eq_trans [eq_sym [nadd_suc [and_elim_l [l3]]], and_elim_r [l3]]]
l9: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ vat s n i = s' c $ by vat_eq [welc_wcel [weaken [#3]], welc_wcel [weaken [#4]], l5, l8]
l10: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ nadd (cdm p) c ∈ ω $ by nadd_omega_c [l6, l5]
l11: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ suc i = suc i $ by eq_refl
l12: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ cdm p = cdm p $ by eq_refl
l13: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ nadd (suc i) (nadd (cdm p) c) = N $ by eq_trans [nadd_eq [l11, nadd_comm_c [l6, l5]], eq_trans [eq_sym [nadd_assoc_c [l7, l5, l6]], eq_trans [nadd_eq [l8, l12], weaken [#5]]]]
l14: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ N ∈ ω $ by wcel_eq_l [weaken [#5], nadd_omega_c [welc_wcel [weaken [#4]], l6]]
l15: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ i ∈ N $ by f15_lt [welc_wcel [l4], l10, eq_trans [eq_sym [f15_sl [welc_wcel [l4], l10]], l13]]
l16: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ vat (p ++ s) N i = (p ++ s)' (nadd (cdm p) c) $ by vat_eq [l15, l14, l10, l13]
l17: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ (p ++ s)' (nadd (cdm p) c) = s' c $ by scat_fv_r_c [weaken [#1], weaken [#2], l5]
l18: $ G , c ∊ ω ∧ nadd i (suc c) = n ⇒ vat (p ++ s) N i = vat s n i $ by eq_trans [l16, eq_trans [l17, eq_sym [l9]]]
l19: $ G ⇒ vat (p ++ s) N i = vat s n i $ by ex_elim [l2, l18]

--| @freshen G l
--| @freshen G i
--| @freshen G v
--| @freshen G a
--| @freshen G o
--| @freshen G x
--| @freshen G c
--| @freshen G y
lemma f23_app {l i v a o x c y: set} (G: hyps) (M J Lc Lr N J1 L: class) (u w td pp cv r mk tM1 tM2 tM n1: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ mk ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ J ∈ ω $ > $ G ⇒ Lc ∈ ω $ > $ G ⇒ Lr ∈ ω $ > $ G ⇒ nadd J Lc = n1 $ > $ G ⇒ n1 ∊ ω $ > $ G ⇒ nadd n1 Lr = N $ > $ G ⇒ ra_capp tM2 tM1 tM ∈ lrel $ > $ G ⇒ esat u (dsh u M r) tM1 w = {l | l ∊ fseq u ∧ cdm l = Lc ∧ ∀ i (i ∊ n1 → J ⊆ i → vat (l ++ mk) n1 i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ > $ G ⇒ ∀ x ∀ c ∀ y (x ∊ esat u (dsh u M r) tM1 w → c = x ++ mk → y = x ++ r → esat u (dsh u M y) tM2 w = {l | l ∊ fseq u ∧ cdm l = Lr ∧ ∀ i (i ∊ N → J1 ⊆ i → vat (l ++ c) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})}) $ > $ G ⇒ J1 = n1 $ > $ G ⇒ nadd Lr Lc = L $ > $ G ⇒ esat u (dsh u M r) tM w = {l | l ∊ fseq u ∧ cdm l = L ∧ ∀ i (i ∊ N → J ⊆ i → vat (l ++ mk) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $
----
l1: $ G ⇒ esat u (dsh u M r) tM w = {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ b = q ++ g)} $ by esat_capp_dsh [#1, #3, #10]
l2: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l3: $ G ⇒ tM2 ∊ trees ω ∧ tM1 ∊ trees ω ∧ tM ∊ trees ω $ by lrel_args3 [#10, wcel_isset [l2]]
l4: $ G ⇒ n1 ∈ ω $ by welc_wcel [#8]
l5: $ G ⇒ N ∈ ω $ by wcel_eq_l [#9, nadd_omega_c [l4, #6]]
l6: $ G ⇒ J ⊆ n1 $ by subset_eq_r [#7, nadd_le_l_c [#4, #5]]
l7: $ G ⇒ n1 ⊆ N $ by subset_eq_r [#9, nadd_le_l_c [l4, #6]]
l8: $ G , z ∊ esat u (dsh u M r) tM w ⇒ esat u (dsh u M r) tM w = {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ b = q ++ g)} $ by weaken [l1]
l9: $ G , z ∊ esat u (dsh u M r) tM w ⇒ z ∊ esat u (dsh u M r) tM w $ by ax
l10: $ G , z ∊ esat u (dsh u M r) tM w ⇒ z ∊ {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ b = q ++ g)} $ by welc_eq [l8, l9]
l11: $ G , z ∊ esat u (dsh u M r) tM w ⇒ ∃ g ∃ q (g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g) $ by cab_elim [l10]
l12: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g ⇒ g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g $ by ax
l13: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g ⇒ esat u (dsh u M r) tM1 w ⊆ fseq u $ by esat_fseq
l14: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g ⇒ g ∊ fseq u $ by subset_elim [l13, and_elim_l [l12]]
l15: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g $ by ax
l16: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ g ∊ fseq u $ by weaken [l14]
l17: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ esat u (dsh u M r) tM1 w = {l | l ∊ fseq u ∧ cdm l = Lc ∧ ∀ i (i ∊ n1 → J ⊆ i → vat (l ++ mk) n1 i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by weaken [#11]
l18: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ g ∊ fseq u ∧ cdm g = Lc ∧ ∀ i (i ∊ n1 → J ⊆ i → vat (g ++ mk) n1 i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)}) $ by cab_elim [welc_eq [l17, and_elim_l [l15]]]
l19: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ c = g ++ mk $ by ax
l20: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ y = g ++ r $ by ax
l21: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ ∀ x ∀ c ∀ y (x ∊ esat u (dsh u M r) tM1 w → c = x ++ mk → y = x ++ r → esat u (dsh u M y) tM2 w = {l | l ∊ fseq u ∧ cdm l = Lr ∧ ∀ i (i ∊ N → J1 ⊆ i → vat (l ++ c) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})}) $ by weaken [#12]
l22: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ ∀ c ∀ y (g ∊ esat u (dsh u M r) tM1 w → c = g ++ mk → y = g ++ r → esat u (dsh u M y) tM2 w = {l | l ∊ fseq u ∧ cdm l = Lr ∧ ∀ i (i ∊ N → J1 ⊆ i → vat (l ++ c) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})}) $ by all_elim [l21]
l23: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ ∀ y (g ∊ esat u (dsh u M r) tM1 w → c = g ++ mk → y = g ++ r → esat u (dsh u M y) tM2 w = {l | l ∊ fseq u ∧ cdm l = Lr ∧ ∀ i (i ∊ N → J1 ⊆ i → vat (l ++ c) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})}) $ by all_elim [l22]
l24: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ g ∊ esat u (dsh u M r) tM1 w → c = g ++ mk → y = g ++ r → esat u (dsh u M y) tM2 w = {l | l ∊ fseq u ∧ cdm l = Lr ∧ ∀ i (i ∊ N → J1 ⊆ i → vat (l ++ c) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by all_elim [l23]
l25: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ esat u (dsh u M y) tM2 w = {l | l ∊ fseq u ∧ cdm l = Lr ∧ ∀ i (i ∊ N → J1 ⊆ i → vat (l ++ c) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by imp_elim [imp_elim [imp_elim [l24, and_elim_l [l15]], l19], l20]
l26: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ r ∊ fseq u $ by weaken [#3]
l27: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ g ++ r ∈ fseq u $ by scat_fseq [l16, l26]
l28: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ tM2 ∊ trees ω $ by weaken [and_elim_l [l3]]
l29: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ esat u (dsh u M (g ++ r)) tM2 w = esat u (dsh u M y) tM2 w $ by esat_dsh_eq [welc_wcel [l28], l27, eq_sym [l20]]
l30: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ q ∊ fseq u ∧ cdm q = Lr ∧ ∀ i (i ∊ N → J1 ⊆ i → vat (q ++ c) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)}) $ by cab_elim [welc_eq [l25, welc_eq [l29, and_elim_l [and_elim_r [l15]]]]]
l31: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ c = g ++ mk $ by ax
l32: $ G , z ∊ esat u (dsh u M r) tM w , g ∊ esat u (dsh u M r) tM1 w ∧ q ∊ esat u (dsh u M (g ++ r)) tM2 w ∧ z = q ++ g , c = g ++ mk , y = g ++ r ⇒ y = g ++ r $ by ax
