--| @freshen H qb_v
--| @freshen H qP
--| @freshen H qT
--| @freshen H qnp
--| @freshen H qn_v
--| @freshen H qm_v
--| @freshen H qF
--| @freshen H qK
--| @freshen H qK2
--| @freshen H qC
lemma f21_inv_field_ty {qb_v qP qT qnp qn_v qm_v qF qK qK2 qC: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_field_ty t1 t2 t3 t4 ∈ lrel $ > $ H , ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF qC ∈ lrel ∧ ra_nth_ctor qC ⟨ kc_nz , ∅ ⟩ qK ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_nth_pi qK2 t3 t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_field_ty t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
