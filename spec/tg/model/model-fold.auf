--| @freshen G i
--| @freshen G x4
--| @freshen G x5
lemma f49_fp_n {i x4 x5: set} (G: hyps) (J M: class) (u w td tn tnp xs s tz: set) (ty k1 j1 vc vd vn vq ve vf vg vt va: set): $ G ⇒ crn j1 ⊆ f49_fp_q J M u w td tn tnp xs s tz $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ jval u M J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ nadd (nvf' tz) (cdm xs) = nvf' tn $ > $ G ⇒ ∀ x4 ∀ x5 (x4 ∊ cdm xs → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = xs' x4) $ > $ G ⇒ ra_fprops td tn tnp vc vd vn ty ∈ lrel3 J $ > $ G ⇒ vq ∊ fseq u $ > $ G ⇒ cdm vq = nadd (nvf' vd) (nvf' tnp) $ > $ G ⇒ vq ++ s ∈ sat u M vc w $ > $ G ⇒ ve = vq ++ xs ++ s $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w ve $ > $ G ⇒ ∀ i (i ∊ nvf' vn → vg' i = ∅) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ c ∃ d ∃ x6 (td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = x6) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ c ∃ d ∃ n ∃ k ∃ a ∃ b ∃ m (td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J) $ by lrel3_fprops_cases [#14]
l2: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = x6 ⇒ td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = x6 $ by ax
l3: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = x6 ⇒ td = x1 $ by and_elim_l [l2]
l4: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = x6 ⇒ tn = x2 $ by and_elim_l [and_elim_r [l2]]
l5: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ ty = x6 ⇒ tnp = x3 $ by and_elim_l [and_elim_r [and_elim_r [l2]]]
