lemma f21_inv_rec_rhs {qb_v qP qT qnp qn_v qm_v qk_v qnf qa_v qmk qM qN qF qK qAcc qVal qR1 qR2 qC: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5: set): $ G ⇒ ra_rec_rhs t1 t2 t3 t4 t5 ∈ lrel $ > $ H , ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives t1 qnp t2 ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors t1 qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT t3 qF qC ∈ lrel ∧ ra_nth_ctor qC t4 qK ∈ lrel ∧ ra_minor_idx qT t3 t4 qk_v ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_add qnf qm_v qa_v ∈ lrel ∧ ra_add qmk ⟨ kc_s , scons qk_v ∅ ⟩ qa_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qmk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnf qAcc ∈ lrel ∧ ra_rwalk t1 qnp qn_v qm_v t2 qnf ⟨ kc_nz , ∅ ⟩ qAcc qK qVal ∈ lrel ∧ ra_lams qN qVal qR1 ∈ lrel ∧ ra_lams qM qR1 qR2 ∈ lrel ∧ ra_lams qP qR2 t5 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_rec_rhs t1 t2 t3 t4 t5 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ u ∃ qnp ∃ qn_v ∃ qm_v ∃ qk_v ∃ qnf ∃ qa_v ∃ qmk ∃ qM ∃ qN ∃ qF ∃ qK ∃ qAcc ∃ qVal ∃ qR1 ∃ qR2 ∃ v ∃ qC (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC u qK ∈ lrel ∧ ra_minor_idx qT z u qk_v ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_add qnf qm_v qa_v ∈ lrel ∧ ra_add qmk ⟨ kc_s , scons qk_v ∅ ⟩ qa_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qmk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnf qAcc ∈ lrel ∧ ra_rwalk x qnp qn_v qm_v y qnf ⟨ kc_nz , ∅ ⟩ qAcc qK qVal ∈ lrel ∧ ra_lams qN qVal qR1 ∈ lrel ∧ ra_lams qM qR1 qR2 ∈ lrel ∧ ra_lams qP qR2 v ∈ lrel) $ by lrel_rec_rhs_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC u qK ∈ lrel ∧ ra_minor_idx qT z u qk_v ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_add qnf qm_v qa_v ∈ lrel ∧ ra_add qmk ⟨ kc_s , scons qk_v ∅ ⟩ qa_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qmk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnf qAcc ∈ lrel ∧ ra_rwalk x qnp qn_v qm_v y qnf ⟨ kc_nz , ∅ ⟩ qAcc qK qVal ∈ lrel ∧ ra_lams qN qVal qR1 ∈ lrel ∧ ra_lams qM qR1 qR2 ∈ lrel ∧ ra_lams qP qR2 v ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_nth_ctor qC u qK ∈ lrel ∧ ra_minor_idx qT z u qk_v ∈ lrel ∧ ra_npis qK qnf ∈ lrel ∧ ra_add qnf qm_v qa_v ∈ lrel ∧ ra_add qmk ⟨ kc_s , scons qk_v ∅ ⟩ qa_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons qmk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qnf qAcc ∈ lrel ∧ ra_rwalk x qnp qn_v qm_v y qnf ⟨ kc_nz , ∅ ⟩ qAcc qK qVal ∈ lrel ∧ ra_lams qN qVal qR1 ∈ lrel ∧ ra_lams qM qR1 qR2 ∈ lrel ∧ ra_lams qP qR2 v ∈ lrel $ by ax
