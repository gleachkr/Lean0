lemma f13_mw_all (G: hyps) (M Z: class) (u w td tj tnp tv p c0 rr n0: set): $ G ⇒ trees ω ⊆ f13_mw_q M Z u w td tj tnp tv p c0 rr n0 $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f13_mw_q M Z u w td tj tnp tv p c0 rr n0 , y = ⟨ i , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , c0 ∊ fseq u , cdm c0 = nvf' tj , rr ∊ fseq u , n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ , n0 ∊ trees ω , ∀ x (x ∊ fseq u → dt u M n0 w x = Z) , tv ∊ trees ω , ra_mty td tnp tj d tv y m ∈ lrel , y ∊ trees ω , m ∊ ofsort lsig lopen ks_expr , d ∊ ofsort lsig lopen ks_nat , e ∊ fseq u , cdm e = nvf' d , r = e ++ c0 ++ p ++ rr ⇒ crn j ⊆ f13_mw_q M Z u w td tj tnp tv p c0 rr n0 $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f13_mw_q M Z u w td tj tnp tv p c0 rr n0 , y = ⟨ i , j ⟩ , uadm u , w ∊ lvals , p ∊ fseq u , cdm p = nvf' tnp , c0 ∊ fseq u , cdm c0 = nvf' tj , rr ∊ fseq u , n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ , n0 ∊ trees ω , ∀ x (x ∊ fseq u → dt u M n0 w x = Z) , tv ∊ trees ω , ra_mty td tnp tj d tv y m ∈ lrel , y ∊ trees ω , m ∊ ofsort lsig lopen ks_expr , d ∊ ofsort lsig lopen ks_nat , e ∊ fseq u , cdm e = nvf' d , r = e ++ c0 ++ p ++ rr ⇒ y = ⟨ i , j ⟩ $ by ax
