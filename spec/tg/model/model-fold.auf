l153: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s , x5 = v ++ s , x6 = ⟨ kc_pi , scons d (scons vb ∅) ⟩ ⇒ ⟨ vx , ⟨ vg , ⟨ vt , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) vb w x4 $ by wcel_eq_r [etel_eq [l151, l152, eq_sym [l150]], weaken [l70]]
l154: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s , x5 = v ++ s , x6 = ⟨ kc_pi , scons d (scons vb ∅) ⟩ ⇒ vb ∈ trees ω $ by weaken [l51]
l155: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s , x5 = v ++ s , x6 = ⟨ kc_pi , scons d (scons vb ∅) ⟩ ⇒ vx ∊ fseq u ∧ vg ∊ fseq u ∧ cdm vg = cdm vx ∧ cdm vt = cdm vx $ by etel_fseq [l154, l153]
l156: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s , x5 = v ++ s , x6 = ⟨ kc_pi , scons d (scons vb ∅) ⟩ ⇒ vx ∊ fseq u $ by and_elim_l [l155]
l157: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s , x5 = v ++ s , x6 = ⟨ kc_pi , scons d (scons vb ∅) ⟩ ⇒ o ∊ u $ by weaken [l68]
l158: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s , x5 = v ++ s , x6 = ⟨ kc_pi , scons d (scons vb ∅) ⟩ ⇒ isset (ssnoc vx o) $ by wcel_isset [ssnoc_fseq [l156, l157]]
l159: $ G , ty = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ ra_pis e ⟨ kc_pi , scons d (scons vb ∅) ⟩ tt ∈ lrel , v ∊ esat u (dsh u M s) e w , o ∊ da ((dsh u M s)' d) w v , vp = scons o v , x4 = vp ++ s , x5 = v ++ s , x6 = ⟨ kc_pi , scons d (scons vb ∅) ⟩ ⇒ ∃ h ∃ l (⟨ vx ++ vp , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $ by isset_elim [l158, l149]
