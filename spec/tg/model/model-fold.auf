lemma f45_zs (G: hyps) (A: class): $ G ⇒ A ∈ ω $ > $ G ⇒ ∅ ∈ suc A $
----
l1: $ G , y = A , y ∊ ω , z = ∅ ⇒ z = ∅ $ by ax
l2: $ G , y = A , y ∊ ω , z = ∅ ⇒ y = A $ by ax
l3: $ G , y = A , y ∊ ω , z = ∅ ⇒ y ∊ ω $ by ax
l4: $ G , y = A , y ∊ ω , z = ∅ ⇒ ∅ ∈ y ∨ ∅ = y $ by omega_zero_le [l3]
l5: $ G , y = A , y ∊ ω , z = ∅ , ∅ ∈ y ⇒ z = ∅ $ by weaken [l1]
l6: $ G , y = A , y ∊ ω , z = ∅ , ∅ ∈ y ⇒ ∅ ∈ y $ by ax
l7: $ G , y = A , y ∊ ω , z = ∅ , ∅ ∈ y ⇒ z ∊ suc y $ by suc_intro_l [wcel_welc [wcel_eq_l [eq_sym [l5], l6]]]
l8: $ G , y = A , y ∊ ω , z = ∅ , ∅ = y ⇒ z = ∅ $ by weaken [l1]
l9: $ G , y = A , y ∊ ω , z = ∅ , ∅ = y ⇒ ∅ = y $ by ax
l10: $ G , y = A , y ∊ ω , z = ∅ , ∅ = y ⇒ z ∊ suc y $ by suc_intro_r [eq_trans [l8, l9]]
l11: $ G , y = A , y ∊ ω , z = ∅ ⇒ z ∊ suc y $ by or_elim [l4, l7, l10]
l12: $ G , y = A , y ∊ ω , z = ∅ ⇒ ∅ ∈ suc A $ by wcel_eq_l [l1, wcel_eq_r [suc_eq [l2], welc_wcel [l11]]]
l13: $ G , y = A , y ∊ ω ⇒ isset ∅ $ by ax_empty
l14: $ G , y = A , y ∊ ω ⇒ ∅ ∈ suc A $ by isset_elim [l13, l12]
l15: $ G ⇒ ∅ ∈ suc A $ by wcel_elim [#1, l14]

def f45_nl_q  (.y .i .n .m .f .e: set): class = $ {y | ∀ i ∀ n ∀ m ∀ f ∀ e (ra_nth_ty y i f e ∈ lrel → ra_ntys y n m ∈ lrel → nvf' i ∈ nvf' n)} $

lemma f45_nl_e (G: hyps)  (ty vi vn vm vf ve: set): $ G ⇒ ty ∊ f45_nl_q  $ > $ G ⇒ ra_nth_ty ty vi vf ve ∈ lrel $ > $ G ⇒ ra_ntys ty vn vm ∈ lrel $ > $ G ⇒ nvf' vi ∈ nvf' vn $
----
l1: $ G ⇒ ∀ i ∀ n ∀ m ∀ f ∀ e (ra_nth_ty ty i f e ∈ lrel → ra_ntys ty n m ∈ lrel → nvf' i ∈ nvf' n) $ by cab_elim [#1]
l2: $ G ⇒ ∀ n ∀ m ∀ f ∀ e (ra_nth_ty ty vi f e ∈ lrel → ra_ntys ty n m ∈ lrel → nvf' vi ∈ nvf' n) $ by all_elim [l1]
l3: $ G ⇒ ∀ m ∀ f ∀ e (ra_nth_ty ty vi f e ∈ lrel → ra_ntys ty vn m ∈ lrel → nvf' vi ∈ nvf' vn) $ by all_elim [l2]
l4: $ G ⇒ ∀ f ∀ e (ra_nth_ty ty vi f e ∈ lrel → ra_ntys ty vn vm ∈ lrel → nvf' vi ∈ nvf' vn) $ by all_elim [l3]
l5: $ G ⇒ ∀ e (ra_nth_ty ty vi vf e ∈ lrel → ra_ntys ty vn vm ∈ lrel → nvf' vi ∈ nvf' vn) $ by all_elim [l4]
l6: $ G ⇒ ra_nth_ty ty vi vf ve ∈ lrel → ra_ntys ty vn vm ∈ lrel → nvf' vi ∈ nvf' vn $ by all_elim [l5]
l7: $ G ⇒ ra_ntys ty vn vm ∈ lrel → nvf' vi ∈ nvf' vn $ by imp_elim [l6, #2]
l8: $ G ⇒ nvf' vi ∈ nvf' vn $ by imp_elim [l7, #3]

lemma f45_nl_n (G: hyps)  (ty k1 j1 vi vn vm vf ve: set): $ G ⇒ crn j1 ⊆ f45_nl_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_nth_ty ty vi vf ve ∈ lrel $ > $ G ⇒ ra_ntys ty vn vm ∈ lrel $ > $ G ⇒ nvf' vi ∈ nvf' vn $
----
l1: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ $ by and_elim_l [l1]
l3: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ ⇒ vi = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l1]
l4: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ntys ty vn vm ∈ lrel $ by weaken [#6]
l5: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ $ by ax
l6: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ $ by weaken [l2]
l7: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ = ⟨ kc_tnil , ∅ ⟩ $ by eq_trans [eq_sym [l6], and_elim_l [l5]]
l8: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
l9: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
l10: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ kc_tcons = kc_tnil $ by opair_inj_l_c [l7, wcel_isset [l8], wcel_isset [l9]]
l11: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_tnil = kc_tcons $ by kc_tnil_ne_tcons
l12: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_tcons = kc_tnil $ by ne_sym [l11]
l13: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vn = ⟨ kc_nz , ∅ ⟩ ∧ vm = ⟨ kc_nz , ∅ ⟩ ⇒ nvf' vi ∈ nvf' vn $ by bot_elim [not_elim [l12, l10]]
l14: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel $ by ax
l15: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ $ by and_elim_l [l14]
l16: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ vn = ⟨ kc_s , scons x4 ∅ ⟩ $ by and_elim_l [and_elim_r [l14]]
l17: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ra_ntys x3 x4 x5 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [l14]]]
l18: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ra_clen_c x2 x6 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l14]]]]
l19: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ra_add x5 x6 vm ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [l14]]]]
l20: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ⟨ kr_ntys , scons x3 (scons x4 (scons x5 ∅)) ⟩ ∈ latoms $ by lrel_latoms [l17]
l21: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset ∅ $ by ax_empty
l22: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset (scons x5 ∅) $ by scons_set [l21]
l23: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset (scons x4 (scons x5 ∅)) $ by scons_set [l22]
l24: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset (scons x3 (scons x4 (scons x5 ∅))) $ by scons_set [l23]
l25: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ kr_ntys ∈ ω $ by kr_ntys_omega
l26: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ kr_ntys ∈ ω ∧ scons x3 (scons x4 (scons x5 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l20, wcel_isset [l25], l24]
l27: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ crn (scons x3 (scons x4 (scons x5 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l26]]
l28: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ crn (scons x4 (scons x5 ∅)) ⊆ trees ω $ by crn_scons_tail [l27]
l29: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset ω $ by omega_set
l30: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ x4 ∈ trees ω $ by crn_scons_head_trees [l29, l28]
l31: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ isset x4 $ by isset_var
l32: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf' x4 ∈ ω $ by nvf_omega [l31]
l33: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf = nvf $ by eq_refl
l34: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf' vn = suc (nvf' x4) $ by eq_trans [fv_eq [l33, l16], nvf_s [l30]]
l35: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ vi = ⟨ kc_nz , ∅ ⟩ $ by weaken [l3]
l36: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l37: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf' vi = ∅ $ by eq_trans [fv_eq [l33, l35], l36]
l38: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ ∅ ∈ suc (nvf' x4) $ by f45_zs [l32]
l39: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 vm ∈ lrel ⇒ nvf' vi ∈ nvf' vn $ by wcel_eq_l [eq_sym [l37], wcel_eq_r [eq_sym [l34], l38]]
l40: $ G , ty = ⟨ kc_tcons , scons vf (scons ve (scons t ∅)) ⟩ ∧ vi = ⟨ kc_nz , ∅ ⟩ ⇒ nvf' vi ∈ nvf' vn $ by f21_inv_ntys [l4, l13, l39]
l41: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel ⇒ ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel $ by ax
l42: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel ⇒ ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ $ by and_elim_l [l41]
l43: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel ⇒ vi = ⟨ kc_s , scons k ∅ ⟩ $ by and_elim_l [and_elim_r [l41]]
l44: $ G , ty = ⟨ kc_tcons , scons a (scons c (scons t ∅)) ⟩ ∧ vi = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_nth_ty t k vf ve ∈ lrel ⇒ ra_nth_ty t k vf ve ∈ lrel $ by and_elim_r [and_elim_r [l41]]
