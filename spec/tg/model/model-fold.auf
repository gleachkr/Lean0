l363: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , ra_le ⟨ kc_s , scons vj ∅ ⟩ tn ∈ lrel ∧ ra_inst vk x1 ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ e ∈ lrel ∧ ra_sinst td ⟨ kc_s , scons vj ∅ ⟩ tn vk e vz ∈ lrel , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ tn = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add vj n i ∈ lrel , e = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_inst vk va x3 f ∈ lrel ∧ ra_inst vk vb x3 g ∈ lrel ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by ex_elim [l260, l362]
l364: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , ra_le ⟨ kc_s , scons vj ∅ ⟩ tn ∈ lrel ∧ ra_inst vk x1 ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ e ∈ lrel ∧ ra_sinst td ⟨ kc_s , scons vj ∅ ⟩ tn vk e vz ∈ lrel , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ tn = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add vj n i ∈ lrel , ∃ g (e = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_inst vk va x3 f ∈ lrel ∧ ra_inst vk vb x3 g ∈ lrel) ⇒ ∃ g (e = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_inst vk va x3 f ∈ lrel ∧ ra_inst vk vb x3 g ∈ lrel) $ by ax
l365: $ … ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by ex_elim [l364, l363]
l366: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , ra_le ⟨ kc_s , scons vj ∅ ⟩ tn ∈ lrel ∧ ra_inst vk x1 ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ e ∈ lrel ∧ ra_sinst td ⟨ kc_s , scons vj ∅ ⟩ tn vk e vz ∈ lrel , ty = ⟨ kc_s , scons n ∅ ⟩ ∧ tn = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_add vj n i ∈ lrel ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by ex_elim [l150, l365]
l367: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ , ra_le ⟨ kc_s , scons vj ∅ ⟩ tn ∈ lrel ∧ ra_inst vk x1 ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ e ∈ lrel ∧ ra_sinst td ⟨ kc_s , scons vj ∅ ⟩ tn vk e vz ∈ lrel ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by f21_inv_add [l126, l131, l366]
l368: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by f21_inv_sinst [l9, l119, l367]
l369: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ ⇒ isset ⟨ kc_s , scons vj ∅ ⟩ $ by opair_isset
l370: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ , x3 = ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by isset_elim [l369, l368]
l371: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ ⇒ isset ⟨ kc_ind_ty , scons td (scons vj ∅) ⟩ $ by opair_isset
l372: $ G , x1 = ⟨ kc_app , scons va (scons vb ∅) ⟩ ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by isset_elim [l371, l370]
l373: $ G ⇒ isset ⟨ kc_app , scons va (scons vb ∅) ⟩ $ by opair_isset
l374: $ G ⇒ ∃ x ∃ c (vz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td vj tn vk va x ∈ lrel ∧ ra_sinst td vj tn vk vb c ∈ lrel) $ by isset_elim [l373, l372]

lemma f30_sa_all (G: hyps) (td tn: set): $ G ⇒ trees ω ⊆ f30_sa_q td tn $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ , ra_add j y tn ∈ lrel , ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel ⇒ crn x9 ⊆ f30_sa_q td tn $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ , ra_add j y tn ∈ lrel , ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ , ra_add j y tn ∈ lrel , ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ , ra_add j y tn ∈ lrel , ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ , ra_add j y tn ∈ lrel , ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel ⇒ ra_add j y tn ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ , ra_add j y tn ∈ lrel , ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel ⇒ ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ , ra_add j y tn ∈ lrel , ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel ⇒ ∃ x ∃ c (z = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn k b c ∈ lrel) $ by f30_sa_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ , ra_add j y tn ∈ lrel ⇒ ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn k b c ∈ lrel) $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn k b c ∈ lrel) $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ ∀ z (ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn k b c ∈ lrel)) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ ∀ b ∀ z (ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn k b c ∈ lrel)) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ ∀ a ∀ b ∀ z (ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn k b c ∈ lrel)) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ ∀ k ∀ a ∀ b ∀ z (ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn k b c ∈ lrel)) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ ∀ j ∀ k ∀ a ∀ b ∀ z (ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_app , scons a (scons b ∅) ⟩ z ∈ lrel → ∃ x ∃ c (z = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td j tn k a x ∈ lrel ∧ ra_sinst td j tn k b c ∈ lrel)) $ by all_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f30_sa_q td tn $ by cab_intro [l14]
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f30_sa_q td tn $ by wcel_intro [l16, l15]
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l19: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f30_sa_q td tn ⇒ ⟨ x8 , x9 ⟩ ∈ f30_sa_q td tn $ by isset_elim [l18, l17]
l20: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f30_sa_q td tn → ⟨ x8 , x9 ⟩ ∈ f30_sa_q td tn $ by imp_intro [imp_intro [imp_intro [l19]]]
l21: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f30_sa_q td tn → ⟨ x8 , x9 ⟩ ∈ f30_sa_q td tn) $ by all_intro [all_intro [l20]]
l22: $ G ⇒ isset ω $ by omega_set
l23: $ G ⇒ trees ω ⊆ f30_sa_q td tn $ by trees_ind_c [l22, l21]

sinst_app_inv
-------------
l1: $ G ⇒ ⟨ kr_add , scons tj (scons tdd (scons tn ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tn ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tdd (scons tn ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tj (scons tdd (scons tn ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
l7: $ G ⇒ kr_add ∈ ω ∧ scons tj (scons tdd (scons tn ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons tj (scons tdd (scons tn ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ crn (scons tdd (scons tn ∅)) ⊆ trees ω $ by crn_scons_tail [l8]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ tdd ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ trees ω ⊆ f30_sa_q td tn $ by f30_sa_all
l13: $ G ⇒ tdd ∊ f30_sa_q td tn $ by subset_elim [l12, wcel_welc [l11]]
l14: $ G ⇒ ∃ x ∃ c (tz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td tj tn tk ta x ∈ lrel ∧ ra_sinst td tj tn tk tb c ∈ lrel) $ by f30_sa_e [l13, #1, #2]

def f30_si_q (td tn ta tb: set) (.y .j .k .z: set): class = $ {y | ∀ j ∀ k ∀ z (ra_add j y tn ∈ lrel → ra_sinst td j tn k ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ z ∈ lrel → z = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩)} $

lemma f30_si_e (G: hyps) (td tn ta tb: set) (ty vj vk vz: set): $ G ⇒ ty ∊ f30_si_q td tn ta tb $ > $ G ⇒ ra_add vj ty tn ∈ lrel $ > $ G ⇒ ra_sinst td vj tn vk ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ vz ∈ lrel $ > $ G ⇒ vz = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $
----
l1: $ G ⇒ ∀ j ∀ k ∀ z (ra_add j ty tn ∈ lrel → ra_sinst td j tn k ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ z ∈ lrel → z = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩) $ by cab_elim [#1]
l2: $ G ⇒ ∀ k ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn k ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ z ∈ lrel → z = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩) $ by all_elim [l1]
l3: $ G ⇒ ∀ z (ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ z ∈ lrel → z = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩) $ by all_elim [l2]
l4: $ G ⇒ ra_add vj ty tn ∈ lrel → ra_sinst td vj tn vk ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ vz ∈ lrel → vz = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by all_elim [l3]
l5: $ G ⇒ ra_sinst td vj tn vk ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ vz ∈ lrel → vz = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by imp_elim [l4, #2]
l6: $ G ⇒ vz = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by imp_elim [l5, #3]

lemma f30_si_n (G: hyps) (td tn ta tb: set) (ty k1 j1 vj vk vz: set): $ G ⇒ crn j1 ⊆ f30_si_q td tn ta tb $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_add vj ty tn ∈ lrel $ > $ G ⇒ ra_sinst td vj tn vk ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ vz ∈ lrel $ > $ G ⇒ vz = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $
