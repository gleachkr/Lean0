l418: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs , x4 = ⟨ kc_nil , ∅ ⟩ , x5 = ⟨ kc_nz , ∅ ⟩ ⇒ ∀ z (z ∊ mqp (etel u (dnf u M) tK0 w x3) td tK0 (imrel td cv) x1 x1 (nvf' tnf) → ap (mtb u (etel u (dnf u M) tK0 w x3) td tK0 (imrel td cv) x1 x1 (nvf' tnf) (cv' Km) ((ictor u (dnf u M) td (nvf' ti) (nvf' tc) w)) x1 pp ((inidx td (nvf' ti)))) z = {y | ∃ k ∃ f ∃ g ∃ t ∃ a ∃ h (ictk td (nvf' ti) (nvf' tc) k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) k w (pp ++ ixs td w (ifam u (dnf u M) td w)) ∧ h ∊ ihv td k (imrel td cv) g t (cdm f) ∧ z = h ++ f ∧ y ∊ apn (vat cv (intys td) (nvf' ti)) (scons (itup td (nvf' ti) (nvf' tc) g w) (a ↾ inidx td (nvf' ti))))}) $ by all_intro [imp_intro [l417]]
l419: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs , x4 = ⟨ kc_nil , ∅ ⟩ , x5 = ⟨ kc_nz , ∅ ⟩ ⇒ dt u M tMin w x2 = fpi z (iminq u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv) {y | ∃ k ∃ f ∃ g ∃ t ∃ a ∃ h (ictk td (nvf' ti) (nvf' tc) k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) k w (pp ++ ixs td w (ifam u (dnf u M) td w)) ∧ h ∊ ihv td k (imrel td cv) g t (cdm f) ∧ z = h ++ f ∧ y ∊ apn (vat cv (intys td) (nvf' ti)) (scons (itup td (nvf' ti) (nvf' tc) g w) (a ↾ inidx td (nvf' ti))))} $ by eq_trans [l147, fpi_eq_pt [l226, l418]]
l420: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs , x4 = ⟨ kc_nil , ∅ ⟩ , x5 = ⟨ kc_nz , ∅ ⟩ ⇒ fpi z (iminq u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv) {y | ∃ k ∃ f ∃ g ∃ t ∃ a ∃ h (ictk td (nvf' ti) (nvf' tc) k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) k w (pp ++ ixs td w (ifam u (dnf u M) td w)) ∧ h ∊ ihv td k (imrel td cv) g t (cdm f) ∧ z = h ++ f ∧ y ∊ apn (vat cv (intys td) (nvf' ti)) (scons (itup td (nvf' ti) (nvf' tc) g w) (a ↾ inidx td (nvf' ti))))} = imin u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv $ by eq_refl
l421: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs , x4 = ⟨ kc_nil , ∅ ⟩ , x5 = ⟨ kc_nz , ∅ ⟩ ⇒ u = u $ by eq_refl
l422: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs , x4 = ⟨ kc_nil , ∅ ⟩ , x5 = ⟨ kc_nz , ∅ ⟩ ⇒ M = M $ by eq_refl
l423: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs , x4 = ⟨ kc_nil , ∅ ⟩ , x5 = ⟨ kc_nz , ∅ ⟩ ⇒ dt u M tMin w (c0 ++ pp ++ rr) = imin u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv $ by eq_trans [dt_eq [l421, l422, l86, l152, eq_sym [l43]], eq_trans [l419, l420]]
l424: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs , x4 = ⟨ kc_nil , ∅ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l425: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs , x4 = ⟨ kc_nil , ∅ ⟩ ⇒ dt u M tMin w (c0 ++ pp ++ rr) = imin u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv $ by isset_elim [l424, l423]
l426: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l427: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr , x3 = pp ++ xs ⇒ dt u M tMin w (c0 ++ pp ++ rr) = imin u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv $ by isset_elim [l426, l425]
l428: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr ⇒ pp ++ xs ∈ fseq u $ by weaken [l26]
l429: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr ⇒ isset (pp ++ xs) $ by wcel_isset [l428]
l430: $ G , x1 = ∅ , x2 = c0 ++ pp ++ rr ⇒ dt u M tMin w (c0 ++ pp ++ rr) = imin u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv $ by isset_elim [l429, l427]
l431: $ G , x1 = ∅ ⇒ c0 ++ pp ++ rr ∈ fseq u $ by weaken [l25]
l432: $ G , x1 = ∅ ⇒ isset (c0 ++ pp ++ rr) $ by wcel_isset [l431]
l433: $ G , x1 = ∅ ⇒ dt u M tMin w (c0 ++ pp ++ rr) = imin u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv $ by isset_elim [l432, l430]
l434: $ G ⇒ isset ∅ $ by ax_empty
l435: $ G ⇒ dt u M tMin w (c0 ++ pp ++ rr) = imin u (dnf u M) td (nvf' ti) (nvf' tc) w pp cv $ by isset_elim [l434, l433]

--| @freshen G l
--| @freshen G i
--| @freshen G x
--| @freshen G c
--| @freshen G y
--| @freshen G v
--| @freshen G a
--| @freshen G o
lemma f23_mins_step {l i x c y v a o: set} (G: hyps) (M J J2 L L2 N: class) (u w td p cv r c0 tmr tg tm tmj tnl: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ c0 ∊ fseq u $ > $ G ⇒ J ∈ ω $ > $ G ⇒ L ∈ ω $ > $ G ⇒ J2 = suc J $ > $ G ⇒ L2 = suc L $ > $ G ⇒ nadd J2 L = N $ > $ G ⇒ N ∈ ω $ > $ G ⇒ J ∈ N $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ra_capp tmr tg tm ∈ lrel $ > $ G ⇒ tg = ⟨ kc_cons , scons tmj (scons tnl ∅) ⟩ $ > $ G ⇒ tnl = ⟨ kc_nil , ∅ ⟩ $ > $ G ⇒ tmj ∊ trees ω $ > $ G ⇒ ∀ i (i = J → dt u M tmj w r = {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w p cv ∧ ihasc td a o)}) $ > $ G ⇒ ∀ x ∀ c ∀ y (x ∊ u → c = scons x c0 → y = scons x r → esat u (dsh u M y) tmr w = {l | l ∊ fseq u ∧ cdm l = L ∧ ∀ i (i ∊ N → J2 ⊆ i → vat (l ++ c) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w p cv ∧ ihasc td a o)})}) $ > $ G ⇒ esat u (dsh u M r) tm w = {l | l ∊ fseq u ∧ cdm l = L2 ∧ ∀ i (i ∊ N → J ⊆ i → vat (l ++ c0) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w p cv ∧ ihasc td a o)})} $
----
l1: $ G ⇒ esat u (dsh u M r) tm w = {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ b = q ++ g)} $ by esat_capp_dsh [#1, #10, #11]
l2: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l3: $ G ⇒ tmr ∊ trees ω ∧ tg ∊ trees ω ∧ tm ∊ trees ω $ by lrel_args3 [#11, wcel_isset [l2]]
l4: $ G ⇒ isset ω $ by omega_set
l5: $ G ⇒ kc_cons ∈ ω $ by kc_cons_omega
l6: $ G ⇒ tmj ∊ trees ω ∧ tnl ∊ trees ω $ by trees_kids2 [l4, wcel_eq_l [#12, welc_wcel [and_elim_l [and_elim_r [l3]]]], wcel_isset [l5]]
l7: $ G , e ∊ esat u (dsh u M r) tm w ⇒ esat u (dsh u M r) tm w = {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ b = q ++ g)} $ by weaken [l1]
l8: $ G , e ∊ esat u (dsh u M r) tm w ⇒ e ∊ esat u (dsh u M r) tm w $ by ax
l9: $ G , e ∊ esat u (dsh u M r) tm w ⇒ e ∊ {b | ∃ g ∃ q (g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ b = q ++ g)} $ by welc_eq [l7, l8]
l10: $ G , e ∊ esat u (dsh u M r) tm w ⇒ ∃ g ∃ q (g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g) $ by cab_elim [l9]
l11: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g ⇒ g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g $ by ax
l12: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g ⇒ tg = ⟨ kc_cons , scons tmj (scons tnl ∅) ⟩ $ by weaken [#12]
l13: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g ⇒ w = w $ by eq_refl
l14: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g ⇒ g ∊ esat u (dsh u M r) ⟨ kc_cons , scons tmj (scons tnl ∅) ⟩ w $ by welc_eq [esat_eq [l12, l13], and_elim_l [l11]]
l15: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k ∊ esat u (dsh u M r) tnl w $ by ax
l16: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ tnl = ⟨ kc_nil , ∅ ⟩ $ by weaken [#13]
l17: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ w = w $ by eq_refl
l18: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ w ∊ lvals $ by weaken [#1]
l19: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k = ∅ $ by csn_elim [welc_eq [eq_trans [esat_eq [l16, l17], esat_nil [l18]], l15]]
l20: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g $ by ax
l21: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ esat u (dsh u M r) tg w ⊆ fseq u $ by esat_fseq
l22: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g ∊ fseq u $ by subset_elim [l21, and_elim_l [l20]]
l23: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k ∊ esat u (dsh u M r) tnl w $ by ax
l24: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ esat u (dsh u M r) tnl w ⊆ fseq u $ by esat_fseq
l25: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ k ∊ fseq u $ by subset_elim [l24, l23]
l26: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g = scons h k $ by ax
l27: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ h ∊ u $ by scons_fseq_hd [wcel_eq_l [l26, welc_wcel [l22]]]
l28: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g = scons h k $ by ax
l29: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ h = h $ by eq_refl
l30: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k ⇒ g = scons h ∅ $ by eq_trans [l28, scons_eq [l29, l19]]
l31: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k , c = scons h c0 , y = scons h r , j = J ⇒ c = scons h c0 $ by ax
l32: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k , c = scons h c0 , y = scons h r , j = J ⇒ y = scons h r $ by ax
l33: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k , c = scons h c0 , y = scons h r , j = J ⇒ j = J $ by ax
l34: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k , c = scons h c0 , y = scons h r , j = J ⇒ g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g $ by ax
l35: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k , c = scons h c0 , y = scons h r , j = J ⇒ g ∊ fseq u $ by weaken [l22]
l36: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k , c = scons h c0 , y = scons h r , j = J ⇒ g = scons h ∅ $ by weaken [l30]
l37: $ G , e ∊ esat u (dsh u M r) tm w , g ∊ esat u (dsh u M r) tg w ∧ q ∊ esat u (dsh u M (g ++ r)) tmr w ∧ e = q ++ g , k ∊ esat u (dsh u M r) tnl w , h ∊ da ((dsh u M r)' tmj) w k , g = scons h k , c = scons h c0 , y = scons h r , j = J ⇒ h ∊ u $ by weaken [l27]
