l11: $ G , z = ∅ ⇒ ∅ ∈ fseq A $ by weaken [l7]
l12: $ G , z = ∅ ⇒ z ∊ fseq A $ by wcel_welc [wcel_eq_l [eq_sym [l10], l11]]
l13: $ G , z = ∅ ⇒ cdm (scons a z) = suc (cdm z) $ by scons_len [l12]
l14: $ G , z = ∅ ⇒ cdm (scons b z) = suc (cdm z) $ by scons_len [l12]
l15: $ G , z = ∅ ⇒ a = a $ by eq_refl
l16: $ G , z = ∅ ⇒ b = b $ by eq_refl
l17: $ G , z = ∅ ⇒ cdm (scons a ∅) = cdm (scons b ∅) $ by eq_trans [cdm_eq [scons_eq [l15, eq_sym [l10]]], eq_trans [l13, eq_trans [eq_sym [l14], cdm_eq [scons_eq [l16, l10]]]]]
l18: $ G ⇒ isset ∅ $ by ax_empty
l19: $ G ⇒ cdm (scons a ∅) = cdm (scons b ∅) $ by isset_elim [l18, l17]
l20: $ G ⇒ s = t ∧ scons a ∅ = scons b ∅ $ by scat_inj_c [welc_wcel [#1], welc_wcel [#2], l8, l9, l3, l19, l6]
l21: $ G ⇒ isset ∅ $ by ax_empty
l22: $ G ⇒ isset a $ by isset_var
l23: $ G ⇒ (scons a ∅)' ∅ = a $ by scons_fv_zero_c [l22, l21]
l24: $ G ⇒ isset b $ by isset_var
l25: $ G ⇒ (scons b ∅)' ∅ = b $ by scons_fv_zero_c [l24, l21]
l26: $ G ⇒ ∅ = ∅ $ by eq_refl
l27: $ G ⇒ a = b $ by eq_trans [eq_sym [l23], eq_trans [fv_eq [and_elim_r [l20], l26], l25]]
l28: $ G ⇒ s = t ∧ a = b $ by and_intro [and_elim_l [l20], l27]

