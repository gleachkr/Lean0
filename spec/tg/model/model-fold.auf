l146: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel , ra_spine h f k ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel ⇒ h = h $ by eq_refl
l147: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel , ra_spine h f k ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel ⇒ ra_spine h vz vm ∈ lrel $ by wcel_eq_l [ra_spine_eq [l146, eq_sym [l144], eq_sym [l145]], l142]
l148: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel , ra_spine h f k ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel ⇒ ra_spine h vz vm ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel $ by and_intro [l147, and_elim_r [l99]]
l149: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel , ra_spine h f k ∈ lrel ∧ ra_sinst td tj tn tk th h ∈ lrel ⇒ ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by ex_intro [l148]
l150: $ G , ty = ⟨ kc_app , scons e (scons d ∅) ⟩ ∧ vm = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine th e k ∈ lrel , vz = ⟨ kc_app , scons f (scons g ∅) ⟩ ∧ ra_sinst td tj tn tk e f ∈ lrel ∧ ra_sinst td tj tn tk d g ∈ lrel ⇒ ∃ x (ra_spine x vz vm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $ by ex_elim [l98, l149]
