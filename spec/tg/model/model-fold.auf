l149: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_proj , scons q (scons h (scons e ∅)) ⟩ ∧ vz = ⟨ kc_proj , scons q (scons h (scons x6 ∅)) ⟩ ∧ ra_rst td x0 e x6 ∈ lrel ⇒ ra_rst td x0 e x6 ∈ lrel $ by and_elim_r [and_elim_r [l146]]
