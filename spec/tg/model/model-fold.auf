def f48_pj_q (M: class) (u w r tb te tY: set) (.x7 .q .v .i .m .y: set): class = $ {x7 | ∀ q (ra_projs tb te x7 tY q ∈ lrel → w ∊ lvals → r ∊ fseq u → ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' x7 ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' x7 → v' m = (dt u M te w r)' (suc i)) ∧ dt u M q w r = apn (dt u M tY w r) v))} $

--| @freshen G v
--| @freshen G i
--| @freshen G m
--| @freshen G y
lemma f48_pj_e {v i m y: set} (G: hyps) (M: class) (u w r tb te tY: set) (ty vq: set): $ G ⇒ ty ∊ f48_pj_q M u w r tb te tY $ > $ G ⇒ ra_projs tb te ty tY vq ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $
----
l1: $ G ⇒ ∀ q (ra_projs tb te ty tY q ∈ lrel → w ∊ lvals → r ∊ fseq u → ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M q w r = apn (dt u M tY w r) v)) $ by cab_elim [#1]
l2: $ G ⇒ ra_projs tb te ty tY vq ∈ lrel → w ∊ lvals → r ∊ fseq u → ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by all_elim [l1]
l3: $ G ⇒ w ∊ lvals → r ∊ fseq u → ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by imp_elim [l2, #2]
l4: $ G ⇒ r ∊ fseq u → ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by imp_elim [l3, #3]
l5: $ G ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by imp_elim [l4, #4]

--| @freshen G v
--| @freshen G i
--| @freshen G m
--| @freshen G y
lemma f48_pj_n {v i m y: set} (G: hyps) (M: class) (u w r tb te tY: set) (ty k1 j1 vq: set): $ G ⇒ crn j1 ⊆ f48_pj_q M u w r tb te tY $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_projs tb te ty tY vq ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $
----
l1: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY ⇒ ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY $ by ax
l2: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY ⇒ ty = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l1]
l3: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY ⇒ vq = tY $ by and_elim_r [l1]
l4: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY ⇒ ra_projs tb te ty tY vq ∈ lrel $ by weaken [#5]
l5: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY ⇒ w ∊ lvals $ by weaken [#6]
l6: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY ⇒ r ∊ fseq u $ by weaken [#7]
l7: $ G , ty = ⟨ kc_nz , ∅ ⟩ ∧ vq = tY , z = ∅ ⇒ z = ∅ $ by ax
