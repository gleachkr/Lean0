lemma f21_inv_rec_ty {qb_v qP qT qnp qn_v qm_v qmn qM qN qF qF2 qB qR1 qR2 qC: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_rec_ty t1 t2 t3 t4 ∈ lrel $ > $ H , ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives t1 qnp t2 ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors t1 qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT t3 qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail t1 qnp qn_v qm_v t3 ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_rec_ty t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qmn ∃ qM ∃ qN ∃ qF ∃ qF2 ∃ qB ∃ qR1 ∃ qR2 ∃ u ∃ qC (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel) $ by lrel_rec_ty_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ qb_v = qb_v $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ qP = qP $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ qT = qT $ by eq_refl
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel $ by wcel_eq_l [ra_ind_data_eq [eq_sym [and_elim_l [l3]], l4, l5, l6], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ qnp = qnp $ by eq_refl
l9: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l10: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ qM = qM $ by eq_refl
l11: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_motives x qnp y ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel ∧ ra_minors x qnp qn_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ qT qN ∈ lrel ∧ ra_nth_ty qT z qF qC ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_lift qmn ⟨ kc_nz , ∅ ⟩ qF qF2 ∈ lrel ∧ ra_rtail x qnp qn_v qm_v z ⟨ kc_nz , ∅ ⟩ qF2 qB ∈ lrel ∧ ra_pis qN qB qR1 ∈ lrel ∧ ra_pis qM qR1 qR2 ∈ lrel ∧ ra_pis qP qR2 u ∈ lrel ⇒ ra_motives t1 qnp t2 ⟨ kc_nz , ∅ ⟩ qT qM ∈ lrel $ by wcel_eq_l [ra_motives_eq [eq_sym [and_elim_l [l3]], l8, eq_sym [and_elim_l [and_elim_r [l3]]], l9, l6, l10], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]]]
