l578: $ G , ty = ⟨ kc_tcons , scons h (scons d (scons p ∅)) ⟩ ∧ ra_cminors td tnp tn vk vd ⟨ kc_nz , ∅ ⟩ d m ∈ lrel ∧ ra_clen_c d n ∈ lrel ∧ ra_add vk n k ∈ lrel ∧ ra_minors td tnp tn k ⟨ kc_s , scons vd ∅ ⟩ p q ∈ lrel ∧ ra_capp q m vm ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vq = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys x3 j x4 ∈ lrel ∧ ra_clen_c x2 x5 ∈ lrel ∧ ra_add x4 x5 vr ∈ lrel , x7 = ⟨ kc_s , scons vd ∅ ⟩ ⇒ esat u (dsh u M vn) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vr ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by isset_elim [l577, l576]
l579: $ G , ty = ⟨ kc_tcons , scons h (scons d (scons p ∅)) ⟩ ∧ ra_cminors td tnp tn vk vd ⟨ kc_nz , ∅ ⟩ d m ∈ lrel ∧ ra_clen_c d n ∈ lrel ∧ ra_add vk n k ∈ lrel ∧ ra_minors td tnp tn k ⟨ kc_s , scons vd ∅ ⟩ p q ∈ lrel ∧ ra_capp q m vm ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vq = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys x3 j x4 ∈ lrel ∧ ra_clen_c x2 x5 ∈ lrel ∧ ra_add x4 x5 vr ∈ lrel ⇒ isset ⟨ kc_s , scons vd ∅ ⟩ $ by opair_isset
l580: $ G , ty = ⟨ kc_tcons , scons h (scons d (scons p ∅)) ⟩ ∧ ra_cminors td tnp tn vk vd ⟨ kc_nz , ∅ ⟩ d m ∈ lrel ∧ ra_clen_c d n ∈ lrel ∧ ra_add vk n k ∈ lrel ∧ ra_minors td tnp tn k ⟨ kc_s , scons vd ∅ ⟩ p q ∈ lrel ∧ ra_capp q m vm ∈ lrel , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ vq = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys x3 j x4 ∈ lrel ∧ ra_clen_c x2 x5 ∈ lrel ∧ ra_add x4 x5 vr ∈ lrel ⇒ esat u (dsh u M vn) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vr ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by isset_elim [l579, l578]
l581: $ G , ty = ⟨ kc_tcons , scons h (scons d (scons p ∅)) ⟩ ∧ ra_cminors td tnp tn vk vd ⟨ kc_nz , ∅ ⟩ d m ∈ lrel ∧ ra_clen_c d n ∈ lrel ∧ ra_add vk n k ∈ lrel ∧ ra_minors td tnp tn k ⟨ kc_s , scons vd ∅ ⟩ p q ∈ lrel ∧ ra_capp q m vm ∈ lrel ⇒ esat u (dsh u M vn) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vr ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by f21_inv_ntys [l47, l56, l580]
l582: $ G ⇒ esat u (dsh u M vn) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vr ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by f21_inv_minors [#21, l45, l581]

lemma f23_mn_all (G: hyps) (M J V N: class) (u w pp xs cv rr td tp tt tn tm tnp: set): $ G ⇒ trees ω ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp $
----
l1: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) , ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ra_minors td tnp tn k d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , ra_ntys y q r ∈ lrel , nadd (nvf' d) (nvf' q) = nvf' tn , nadd (nvf' k) (nvf' r) = N , ∀ a ∀ f ∀ e (ra_nth_ty y a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) , ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx y a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' k))) , h ∊ fseq u , cdm h = nvf' k , n = h ++ cv ++ pp ++ rr ⇒ crn c ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp $ by ax
l2: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) , ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ra_minors td tnp tn k d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , ra_ntys y q r ∈ lrel , nadd (nvf' d) (nvf' q) = nvf' tn , nadd (nvf' k) (nvf' r) = N , ∀ a ∀ f ∀ e (ra_nth_ty y a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) , ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx y a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' k))) , h ∊ fseq u , cdm h = nvf' k , n = h ++ cv ++ pp ++ rr ⇒ y = ⟨ x , c ⟩ $ by ax
l3: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) , ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ra_minors td tnp tn k d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , ra_ntys y q r ∈ lrel , nadd (nvf' d) (nvf' q) = nvf' tn , nadd (nvf' k) (nvf' r) = N , ∀ a ∀ f ∀ e (ra_nth_ty y a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) , ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx y a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' k))) , h ∊ fseq u , cdm h = nvf' k , n = h ++ cv ++ pp ++ rr ⇒ x ∊ ω $ by ax
l4: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) , ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ra_minors td tnp tn k d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , ra_ntys y q r ∈ lrel , nadd (nvf' d) (nvf' q) = nvf' tn , nadd (nvf' k) (nvf' r) = N , ∀ a ∀ f ∀ e (ra_nth_ty y a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) , ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx y a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' k))) , h ∊ fseq u , cdm h = nvf' k , n = h ++ cv ++ pp ++ rr ⇒ c ∊ fseq (trees ω) $ by ax
l5: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) , ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ra_minors td tnp tn k d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , ra_ntys y q r ∈ lrel , nadd (nvf' d) (nvf' q) = nvf' tn , nadd (nvf' k) (nvf' r) = N , ∀ a ∀ f ∀ e (ra_nth_ty y a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) , ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx y a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' k))) , h ∊ fseq u , cdm h = nvf' k , n = h ++ cv ++ pp ++ rr ⇒ uadm u $ by ax
l6: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_mn_q M J V N u w pp xs cv rr td tp tt tn tm tnp , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' a) (nvf' b) w) , ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' i) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ra_minors td tnp tn k d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , ra_ntys y q r ∈ lrel , nadd (nvf' d) (nvf' q) = nvf' tn , nadd (nvf' k) (nvf' r) = N , ∀ a ∀ f ∀ e (ra_nth_ty y a f e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) , ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx y a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ nvf' g = nadd (nvf' a) (nvf' d) ∧ nvf' o = nadd (nvf' e) (nvf' k))) , h ∊ fseq u , cdm h = nvf' k , n = h ++ cv ++ pp ++ rr ⇒ w ∊ lvals $ by ax
