l131: $ G , k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩ ⇒ kc_ind_rec ∈ ω $ by kc_ind_rec_omega
l132: $ G , k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩ ⇒ kc_app ∈ ω $ by kc_app_omega
l133: $ G , k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩ ⇒ kc_ind_rec = kc_app $ by opair_inj_l_c [l130, wcel_isset [l131], wcel_isset [l132]]
l134: $ G , k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩ ⇒ ¬ kc_app = kc_ind_rec $ by kc_app_ne_ind_rec
l135: $ G , k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩ ⇒ ¬ kc_ind_rec = kc_app $ by ne_sym [l134]
l136: $ G , k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩ ⇒ ra_closed k a ∈ lrel $ by bot_elim [not_elim [l135, l133]]
l137: $ G , ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ⇒ ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) $ by ax
l138: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l137, l136]
l139: $ G , ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ⇒ ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) $ by ax
l140: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l139, l138]
l141: $ G , ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ⇒ ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) $ by ax
l142: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l141, l140]
l143: $ G , ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ⇒ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) $ by ax
l144: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l143, l142]
l145: $ G ⇒ (∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩)) → ra_closed k a ∈ lrel $ by imp_intro [l144]
l146: $ G , k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel ⇒ k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel $ by ax
l147: $ G , k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel ⇒ ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ = ⟨ kc_app , scons a (scons b ∅) ⟩ $ by eq_trans [eq_sym [and_elim_l [and_elim_r [l146]]], weaken [#2]]
l148: $ G , k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel ⇒ kc_proj ∈ ω $ by kc_proj_omega
l149: $ G , k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l150: $ G , k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel ⇒ kc_proj = kc_app $ by opair_inj_l_c [l147, wcel_isset [l148], wcel_isset [l149]]
l151: $ G , k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel ⇒ ¬ kc_app = kc_proj $ by kc_app_ne_proj
l152: $ G , k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel ⇒ ¬ kc_proj = kc_app $ by ne_sym [l151]
l153: $ G , k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel ⇒ ra_closed k a ∈ lrel $ by bot_elim [not_elim [l152, l150]]
l154: $ G , ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) ⇒ ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) $ by ax
l155: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l154, l153]
l156: $ G , ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) ⇒ ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) $ by ax
l157: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l156, l155]
l158: $ G , ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) ⇒ ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) $ by ax
l159: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l158, l157]
l160: $ G , ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) ⇒ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) $ by ax
l161: $ … ⇒ ra_closed k a ∈ lrel $ by ex_elim [l160, l159]
l162: $ G ⇒ (∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by imp_intro [l161]
l221: $ G ⇒ (∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l145, l162]
l222: $ G ⇒ (∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l128, l221]
l223: $ G ⇒ (∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l111, l222]
l224: $ G ⇒ (∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l96, l223]
l225: $ G ⇒ (∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l83, l224]
l226: $ G ⇒ (∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l68, l225]
l227: $ G ⇒ (∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l53, l226]
l228: $ G ⇒ (∃ y ∃ v ∃ w (k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l38, l227]
l229: $ G ⇒ (∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) ∨ ∃ y ∃ v ∃ w (k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l25, l228]
l230: $ G ⇒ (∃ x ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) ∨ ∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) ∨ ∃ y ∃ v ∃ w (k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel)) → ra_closed k a ∈ lrel $ by or_elim_imp [l13, l229]
l231: $ G ⇒ ra_closed k a ∈ lrel $ by imp_elim [l230, l1]

lemma f18_closed_bvar (G: hyps) (k a z: set): $ G ⇒ ra_closed k z ∈ lrel $ > $ G ⇒ z = ⟨ kc_bvar , scons a ∅ ⟩ $ > $ G ⇒ ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $
----
l1: $ G ⇒ ∃ x ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) ∨ ∃ y ∃ u (k = y ∧ z = ⟨ kc_srt , scons u ∅ ⟩) ∨ ∃ y ∃ v ∃ w (k = y ∧ z = ⟨ kc_app , scons v (scons w ∅) ⟩ ∧ ra_closed y v ∈ lrel ∧ ra_closed y w ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ c ∃ f (k = y ∧ z = ⟨ kc_pi , scons c (scons f ∅) ⟩ ∧ ra_closed y c ∈ lrel ∧ ra_closed ⟨ kc_s , scons y ∅ ⟩ f ∈ lrel) ∨ ∃ y ∃ w ∃ g (k = y ∧ z = ⟨ kc_cst , scons w (scons g ∅) ⟩) ∨ ∃ y ∃ i (k = y ∧ z = ⟨ kc_lit , scons i ∅ ⟩) ∨ ∃ y ∃ j ∃ x (k = y ∧ z = ⟨ kc_ind_ty , scons j (scons x ∅) ⟩) ∨ ∃ y ∃ j ∃ x ∃ d (k = y ∧ z = ⟨ kc_ind_ctor , scons j (scons x (scons d ∅)) ⟩) ∨ ∃ y ∃ j ∃ x ∃ e (k = y ∧ z = ⟨ kc_ind_rec , scons j (scons x (scons e ∅)) ⟩) ∨ ∃ y ∃ f ∃ x ∃ h (k = y ∧ z = ⟨ kc_proj , scons f (scons x (scons h ∅)) ⟩ ∧ ra_closed y h ∈ lrel) $ by lrel_closed_cases [#1]
l2: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel $ by ax
l3: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ ⟨ kc_bvar , scons x ∅ ⟩ = ⟨ kc_bvar , scons a ∅ ⟩ $ by eq_trans [eq_sym [and_elim_l [and_elim_r [l2]]], weaken [#2]]
l4: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ y = k $ by eq_sym [and_elim_l [l2]]
l5: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l6: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ x = a $ by node1_inj [wcel_isset [l5], l3]
l7: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l8: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ ⟨ kc_s , scons x ∅ ⟩ = ⟨ kc_s , scons a ∅ ⟩ $ by opair_eq [l7, scons_eq [l6, l8]]
l10: $ G , k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel ⇒ ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $ by wcel_eq_l [ra_le_eq [l9, l4], and_elim_r [and_elim_r [l2]]]
l11: $ G , ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) ⇒ ∃ y (k = y ∧ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x ∅ ⟩ y ∈ lrel) $ by ax
l12: $ … ⇒ ra_le ⟨ kc_s , scons a ∅ ⟩ k ∈ lrel $ by ex_elim [l11, l10]
