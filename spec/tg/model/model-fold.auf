l51: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lam , scons a (scons b ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_inst tk a tc c ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ b tc f ∈ lrel ⇒ ¬ kc_lam = kc_ind_ty $ by kc_lam_ne_ind_ty
l52: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lam , scons a (scons b ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_inst tk a tc c ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ b tc f ∈ lrel ⇒ ¬ kc_ind_ty = kc_lam $ by ne_sym [l51]
l53: $ G , x1 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ , x1 = ⟨ kc_lam , scons a (scons b ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons c (scons f ∅) ⟩ ∧ ra_inst tk a tc c ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ b tc f ∈ lrel ⇒ t4 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $ by bot_elim [not_elim [l52, l50]]
