l136: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , k = nadd (nvf' te) (nvf' ti) , d = nvf' ti , td = x0 ∧ ti = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ (ixs td w zc)' d = ient td w zc d $ by ixs_fv [l133, l134, l135, l132]
l137: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , k = nadd (nvf' te) (nvf' ti) , d = nvf' ti , td = x0 ∧ ti = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ td = td $ by eq_refl
l138: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , k = nadd (nvf' te) (nvf' ti) , d = nvf' ti , td = x0 ∧ ti = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ w = w $ by eq_refl
l139: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) , k = nadd (nvf' te) (nvf' ti) , d = nvf' ti , td = x0 ∧ ti = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ zc = zc $ by eq_refl
