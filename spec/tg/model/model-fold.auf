mtb_eq
------
l1: $ G , z ∊ fseq U ⇒ Q = Q2 $ by weaken [#1]
l2: $ G , z ∊ fseq U ⇒ X = X2 $ by weaken [#2]
l3: $ G , z ∊ fseq U ⇒ Y = Y2 $ by weaken [#3]
l4: $ G , z ∊ fseq U ⇒ F = F2 $ by weaken [#4]
l5: $ G , z ∊ fseq U ⇒ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} ⊆ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q2 ∧ h ∊ ihv D K L (X2 ++ g) (Y2 ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F2) ++ P)) (a ↾ I)))} $ by f18_mts [l1, l2, l3, l4]
l6: $ G , z ∊ fseq U ⇒ Q2 = Q $ by eq_sym [weaken [#1]]
l7: $ G , z ∊ fseq U ⇒ X2 = X $ by eq_sym [weaken [#2]]
l8: $ G , z ∊ fseq U ⇒ Y2 = Y $ by eq_sym [weaken [#3]]
l9: $ G , z ∊ fseq U ⇒ F2 = F $ by eq_sym [weaken [#4]]
l10: $ G , z ∊ fseq U ⇒ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q2 ∧ h ∊ ihv D K L (X2 ++ g) (Y2 ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F2) ++ P)) (a ↾ I)))} ⊆ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} $ by f18_mts [l6, l7, l8, l9]
l11: $ G , z ∊ fseq U ⇒ {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} = {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q2 ∧ h ∊ ihv D K L (X2 ++ g) (Y2 ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F2) ++ P)) (a ↾ I)))} $ by subset_antisym [l5, l10]
l12: $ G ⇒ ∀ z (z ∊ fseq U → {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} = {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q2 ∧ h ∊ ihv D K L (X2 ++ g) (Y2 ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F2) ++ P)) (a ↾ I)))}) $ by all_intro [imp_intro [l11]]
l13: $ G ⇒ clam z (fseq U) {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (X ++ g) (Y ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F) ++ P)) (a ↾ I)))} = clam z (fseq U) {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q2 ∧ h ∊ ihv D K L (X2 ++ g) (Y2 ++ c) N ∧ z = h ++ f ∧ y ∊ apn C (scons (apn V ((f ++ F2) ++ P)) (a ↾ I)))} $ by clam_eq_body [l12]
