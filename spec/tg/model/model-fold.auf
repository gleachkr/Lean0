l64: $ G , ty = ⟨ kc_tcons , scons a (scons e (scons f ∅)) ⟩ ∧ ra_lift vj ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_mty t1 t2 vj ⟨ kc_nz , ∅ ⟩ t3 b d ∈ lrel ∧ ra_motives t1 t2 t3 ⟨ kc_s , scons vj ∅ ⟩ f g ∈ lrel ∧ ra_capp g ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel , ty = ⟨ kc_tcons , scons h (scons i (scons k ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys k n o ∈ lrel ∧ ra_clen_c i p ∈ lrel ∧ ra_add o p vm ∈ lrel , x2 = ⟨ kc_s , scons vj ∅ ⟩ ⇒ ra_clen vq vn ∈ lrel $ by wcel_eq_l [ra_clen_eq [l63, eq_sym [l62]], l61]
l65: $ G , ty = ⟨ kc_tcons , scons a (scons e (scons f ∅)) ⟩ ∧ ra_lift vj ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_mty t1 t2 vj ⟨ kc_nz , ∅ ⟩ t3 b d ∈ lrel ∧ ra_motives t1 t2 t3 ⟨ kc_s , scons vj ∅ ⟩ f g ∈ lrel ∧ ra_capp g ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel , ty = ⟨ kc_tcons , scons h (scons i (scons k ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys k n o ∈ lrel ∧ ra_clen_c i p ∈ lrel ∧ ra_add o p vm ∈ lrel ⇒ isset ⟨ kc_s , scons vj ∅ ⟩ $ by opair_isset
l66: $ G , ty = ⟨ kc_tcons , scons a (scons e (scons f ∅)) ⟩ ∧ ra_lift vj ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_mty t1 t2 vj ⟨ kc_nz , ∅ ⟩ t3 b d ∈ lrel ∧ ra_motives t1 t2 t3 ⟨ kc_s , scons vj ∅ ⟩ f g ∈ lrel ∧ ra_capp g ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel , ty = ⟨ kc_tcons , scons h (scons i (scons k ∅)) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_ntys k n o ∈ lrel ∧ ra_clen_c i p ∈ lrel ∧ ra_add o p vm ∈ lrel ⇒ ra_clen vq vn ∈ lrel $ by isset_elim [l65, l64]
l67: $ G , ty = ⟨ kc_tcons , scons a (scons e (scons f ∅)) ⟩ ∧ ra_lift vj ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_mty t1 t2 vj ⟨ kc_nz , ∅ ⟩ t3 b d ∈ lrel ∧ ra_motives t1 t2 t3 ⟨ kc_s , scons vj ∅ ⟩ f g ∈ lrel ∧ ra_capp g ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel ⇒ ra_clen vq vn ∈ lrel $ by f21_inv_ntys [l14, l26, l66]
l68: $ G ⇒ ra_clen vq vn ∈ lrel $ by f21_inv_motives [#5, l12, l67]

lemma f29_mc_all (G: hyps) (t1 t2 t3: set): $ G ⇒ trees ω ⊆ f29_mc_q t1 t2 t3 $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_motives t1 t2 t3 j y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ crn x9 ⊆ f29_mc_q t1 t2 t3 $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_motives t1 t2 t3 j y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_motives t1 t2 t3 j y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_motives t1 t2 t3 j y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_motives t1 t2 t3 j y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ ra_motives t1 t2 t3 j y q ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_motives t1 t2 t3 j y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ ra_ntys y n m ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_motives t1 t2 t3 j y q ∈ lrel , ra_ntys y n m ∈ lrel ⇒ ra_clen q n ∈ lrel $ by f29_mc_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ , ra_motives t1 t2 t3 j y q ∈ lrel ⇒ ra_ntys y n m ∈ lrel → ra_clen q n ∈ lrel $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ra_motives t1 t2 t3 j y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q n ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ m (ra_motives t1 t2 t3 j y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q n ∈ lrel) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n ∀ m (ra_motives t1 t2 t3 j y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q n ∈ lrel) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ q ∀ n ∀ m (ra_motives t1 t2 t3 j y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q n ∈ lrel) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ j ∀ q ∀ n ∀ m (ra_motives t1 t2 t3 j y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q n ∈ lrel) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_mc_q t1 t2 t3 $ by cab_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_mc_q t1 t2 t3 $ by wcel_intro [l15, l14]
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_mc_q t1 t2 t3 ⇒ ⟨ x8 , x9 ⟩ ∈ f29_mc_q t1 t2 t3 $ by isset_elim [l17, l16]
l19: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_mc_q t1 t2 t3 → ⟨ x8 , x9 ⟩ ∈ f29_mc_q t1 t2 t3 $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_mc_q t1 t2 t3 → ⟨ x8 , x9 ⟩ ∈ f29_mc_q t1 t2 t3) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ f29_mc_q t1 t2 t3 $ by trees_ind_c [l21, l20]

motives_clen
------------
l1: $ G ⇒ ⟨ kr_ntys , scons tT (scons tn (scons tm ∅)) ⟩ ∈ latoms $ by lrel_latoms [#2]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tm ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tn (scons tm ∅)) $ by scons_set [l3]
l5: $ G ⇒ isset (scons tT (scons tn (scons tm ∅))) $ by scons_set [l4]
l6: $ G ⇒ kr_ntys ∈ ω $ by kr_ntys_omega
l7: $ G ⇒ kr_ntys ∈ ω ∧ scons tT (scons tn (scons tm ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l6], l5]
l8: $ G ⇒ crn (scons tT (scons tn (scons tm ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l7]]
l9: $ G ⇒ isset ω $ by omega_set
l10: $ G ⇒ tT ∈ trees ω $ by crn_scons_head_trees [l9, l8]
l11: $ G ⇒ trees ω ⊆ f29_mc_q t1 t2 t3 $ by f29_mc_all
l12: $ G ⇒ tT ∊ f29_mc_q t1 t2 t3 $ by subset_elim [l11, wcel_welc [l10]]
l13: $ G ⇒ ra_clen tq tn ∈ lrel $ by f29_mc_e [l12, #1, #2]

def f29_cm_q (t1 t2 t3 t5: set) (.y .k .c .q .n: set): class = $ {y | ∀ k ∀ c ∀ q ∀ n (ra_cminors t1 t2 t3 k t5 c y q ∈ lrel → ra_clen_c y n ∈ lrel → ra_clen q n ∈ lrel)} $

lemma f29_cm_e (G: hyps) (t1 t2 t3 t5: set) (ty vk vc vq vn: set): $ G ⇒ ty ∊ f29_cm_q t1 t2 t3 t5 $ > $ G ⇒ ra_cminors t1 t2 t3 vk t5 vc ty vq ∈ lrel $ > $ G ⇒ ra_clen_c ty vn ∈ lrel $ > $ G ⇒ ra_clen vq vn ∈ lrel $
----
l1: $ G ⇒ ∀ k ∀ c ∀ q ∀ n (ra_cminors t1 t2 t3 k t5 c ty q ∈ lrel → ra_clen_c ty n ∈ lrel → ra_clen q n ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ c ∀ q ∀ n (ra_cminors t1 t2 t3 vk t5 c ty q ∈ lrel → ra_clen_c ty n ∈ lrel → ra_clen q n ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ∀ q ∀ n (ra_cminors t1 t2 t3 vk t5 vc ty q ∈ lrel → ra_clen_c ty n ∈ lrel → ra_clen q n ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ∀ n (ra_cminors t1 t2 t3 vk t5 vc ty vq ∈ lrel → ra_clen_c ty n ∈ lrel → ra_clen vq n ∈ lrel) $ by all_elim [l3]
l5: $ G ⇒ ra_cminors t1 t2 t3 vk t5 vc ty vq ∈ lrel → ra_clen_c ty vn ∈ lrel → ra_clen vq vn ∈ lrel $ by all_elim [l4]
l6: $ G ⇒ ra_clen_c ty vn ∈ lrel → ra_clen vq vn ∈ lrel $ by imp_elim [l5, #2]
l7: $ G ⇒ ra_clen vq vn ∈ lrel $ by imp_elim [l6, #3]

lemma f29_cm_n (G: hyps) (t1 t2 t3 t5: set) (ty k1 j1 vk vc vq vn: set): $ G ⇒ crn j1 ⊆ f29_cm_q t1 t2 t3 t5 $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_cminors t1 t2 t3 vk t5 vc ty vq ∈ lrel $ > $ G ⇒ ra_clen_c ty vn ∈ lrel $ > $ G ⇒ ra_clen vq vn ∈ lrel $
----
l1: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ $ by ax
l2: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ ra_clen_c ty vn ∈ lrel $ by weaken [#6]
l3: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ x2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l4: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ ty = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l1]
l5: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_clen_c_nil
l6: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen_c ty x2 ∈ lrel $ by wcel_eq_l [ra_clen_c_eq [eq_sym [weaken [l4]], eq_sym [l3]], l5]
l7: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ vn = x2 $ by lrel_clen_c_det [weaken [l2], l6]
l8: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ vq = ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l1]
l9: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_clen_nil
l10: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen vq vn ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [weaken [l8]], eq_sym [eq_trans [l7, l3]]], l9]
l11: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l12: $ G , ty = ⟨ kc_cnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ ra_clen vq vn ∈ lrel $ by isset_elim [l11, l10]
l13: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel ⇒ ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel $ by ax
l14: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel ⇒ ra_clen_c ty vn ∈ lrel $ by weaken [#6]
l15: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel ⇒ ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ $ by and_elim_l [l13]
l16: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel ⇒ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l13]]]]
