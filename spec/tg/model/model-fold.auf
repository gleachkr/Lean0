l131: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ isset (scons p (scons q ∅)) $ by scons_set [l130]
l132: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ crn j1 ⊆ f51_rn_q td $ by weaken [#1]
l133: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
