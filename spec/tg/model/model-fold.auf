l18: $ G ⇒ crn (scons tnp (scons tn (scons tm (scons tv (scons tnf (scons tfld (scons ty (scons tj (scons tA (scons tIH ∅)))))))))) ⊆ trees ω $ by crn_scons_tail [l17]
l19: $ G ⇒ crn (scons tn (scons tm (scons tv (scons tnf (scons tfld (scons ty (scons tj (scons tA (scons tIH ∅))))))))) ⊆ trees ω $ by crn_scons_tail [l18]
