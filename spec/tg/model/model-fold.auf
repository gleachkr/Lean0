--| @freshen G x
lemma f35_iw_e {z q y f g h o c i v k x: set} (G: hyps) (H J V: class) (u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv: set) (ty vd vm ve vr: set): $ G ⇒ ty ∊ f35_iw_q H J V u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv $ > $ G ⇒ iwf u H J tg td w r0 $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ > $ G ⇒ ra_nth_ty tt tj tFj tCj ∈ lrel $ > $ G ⇒ ra_isort tFj tni tlj ∈ lrel $ > $ G ⇒ ra_nidx td tj tni ∈ lrel $ > $ G ⇒ fd ∊ fseq u $ > $ G ⇒ cdm fd = nvf' tnf $ > $ G ⇒ ss ∊ fseq u $ > $ G ⇒ sx = fd ++ (mv ++ cv) ++ p ++ ss $ > $ G ⇒ cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) $ > $ G ⇒ ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w) $ > $ G ⇒ sx' nvf' tfld = V $ > $ G ⇒ V ∈ u $ > $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld vd tj ty vm ∈ lrel $ > $ G ⇒ vm ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ve ∊ fseq u $ > $ G ⇒ cdm ve = nvf' vd $ > $ G ⇒ vr = ve ++ sx $ > $ G ⇒ ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vr → k = f ++ ve → (∃ c ∃ i (⟨ nvf' tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ o = i ++ p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ nvf' tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) $ > $ G ⇒ (∀ z (z ∊ dt u (mcv H) vm w vr → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) ty w vr) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w vr → ⟨ ⟨ nvf' tj , ⟨ o , apn V (f ++ ve) ⟩ ⟩ , apn (dt u (mcv H) vm w vr) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv) $
----
l1: $ G ⇒ ∀ d ∀ m ∀ e ∀ r (iwf u H J tg td w r0 → ra_ind_data td tb tp tt ∈ lrel → ra_clen tp tnp ∈ lrel → p ∊ esat u (dnf u (mcv H)) tp w → cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) → mv ∊ imins u (dnf u (mcv H)) td w p cv → ra_nth_ty tt tj tFj tCj ∈ lrel → ra_isort tFj tni tlj ∈ lrel → ra_nidx td tj tni ∈ lrel → fd ∊ fseq u → cdm fd = nvf' tnf → ss ∊ fseq u → sx = fd ++ (mv ++ cv) ++ p ++ ss → cdm (mv ++ cv) = nadd (nvf' tm) (nvf' tn) → ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w) → sx' nvf' tfld = V → V ∈ u → ra_ihval td tnp tn tm tv tnf tfld d tj ty m ∈ lrel → m ∊ ofsort lsig lopen ks_expr → e ∊ fseq u → cdm e = nvf' d → r = e ++ sx → ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w r → k = f ++ e → (∃ c ∃ i (⟨ nvf' tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = nvf' tni ∧ o = i ++ p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ nvf' tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) → (∀ z (z ∊ dt u (mcv H) m w r → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) ty w r) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) ty w r → ⟨ ⟨ nvf' tj , ⟨ o , apn V (f ++ e) ⟩ ⟩ , apn (dt u (mcv H) m w r) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv)) $ by cab_elim [#1]
