lemma f21_inv_rwalk {qdp qmn qA qA3 qB qVal qj_v qsh qfld qA2 qA4 qIH: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10: set): $ G ⇒ ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ∈ lrel $ > $ H , t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add t7 t2 qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add t4 t3 qmn ∈ lrel ∧ ra_lift qmn t7 qA qA3 ∈ lrel ∧ ra_rwalk t1 t2 t3 t4 t5 t6 ⟨ kc_s , scons t7 ∅ ⟩ t8 qB qVal ∈ lrel ⇒ Cf $ > $ H , t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add t7 t2 qdp ∈ lrel ∧ ra_recfield t1 t3 t2 t7 qA qj_v ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ t3 qdp qA qA2 ∈ lrel ∧ ra_add t4 t3 qmn ∈ lrel ∧ ra_lift qmn t7 qA2 qA3 ∈ lrel ∧ ra_add qsh t7 t6 ∈ lrel ∧ ra_add qfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ qsh ∈ lrel ∧ ra_lift qsh ⟨ kc_nz , ∅ ⟩ qA3 qA4 ∈ lrel ∧ ra_ihval t1 t2 t3 t4 t5 t6 qfld ⟨ kc_nz , ∅ ⟩ qj_v qA4 qIH ∈ lrel ∧ ra_rwalk t1 t2 t3 t4 t5 t6 ⟨ kc_s , scons t7 ∅ ⟩ ⟨ kc_app , scons t8 (scons qIH ∅) ⟩ qB qVal ∈ lrel ⇒ Cf $ > $ H , t7 = t6 ∧ t10 = t8 ∧ ra_npis t9 ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ qdp ∃ qmn ∃ b ∃ qA ∃ qA3 ∃ qB ∃ qVal (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add a y qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_lift qmn a qA qA3 ∈ lrel ∧ ra_rwalk x y z u v w ⟨ kc_s , scons a ∅ ⟩ b qB qVal ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ qdp ∃ qmn ∃ qj_v ∃ qsh ∃ qfld ∃ b ∃ qA ∃ qA2 ∃ qA3 ∃ qA4 ∃ qB ∃ qIH ∃ qVal (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add a y qdp ∈ lrel ∧ ra_recfield x z y a qA qj_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ z qdp qA qA2 ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_lift qmn a qA2 qA3 ∈ lrel ∧ ra_add qsh a w ∈ lrel ∧ ra_add qfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ qsh ∈ lrel ∧ ra_lift qsh ⟨ kc_nz , ∅ ⟩ qA3 qA4 ∈ lrel ∧ ra_ihval x y z u v w qfld ⟨ kc_nz , ∅ ⟩ qj_v qA4 qIH ∈ lrel ∧ ra_rwalk x y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons b (scons qIH ∅) ⟩ qB qVal ∈ lrel) ∨ ∃ x ∃ y ∃ z ∃ u ∃ v ∃ a ∃ b ∃ c (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = a ∧ t7 = a ∧ t8 = b ∧ t9 = c ∧ t10 = b ∧ ra_npis c ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by lrel_rwalk_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add a y qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_lift qmn a qA qA3 ∈ lrel ∧ ra_rwalk x y z u v w ⟨ kc_s , scons a ∅ ⟩ b qB qVal ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add a y qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_lift qmn a qA qA3 ∈ lrel ∧ ra_rwalk x y z u v w ⟨ kc_s , scons a ∅ ⟩ b qB qVal ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add a y qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_lift qmn a qA qA3 ∈ lrel ∧ ra_rwalk x y z u v w ⟨ kc_s , scons a ∅ ⟩ b qB qVal ∈ lrel ⇒ qdp = qdp $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = b ∧ t9 = ⟨ kc_pi , scons qA (scons qB ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons qA3 (scons qVal ∅) ⟩ ∧ ra_add a y qdp ∈ lrel ∧ ra_closed qdp qA ∈ lrel ∧ ra_add u z qmn ∈ lrel ∧ ra_lift qmn a qA qA3 ∈ lrel ∧ ra_rwalk x y z u v w ⟨ kc_s , scons a ∅ ⟩ b qB qVal ∈ lrel ⇒ ra_add t7 t2 qdp ∈ lrel $ by wcel_eq_l [ra_add_eq [eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]], eq_sym [and_elim_l [and_elim_r [l3]]], l4], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]]]]]]
