l73: $ G , l = ixs td w zc , r = p ++ l , o ∊ fseq u ∧ t' nvf' th = etel u (dnf u (mcv H)) ta w o ∧ g' nvf' th ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → o' (nadd (nvf' th) i) = r' i) , v = g' nvf' th , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = nvf' m ∧ q4 = e ++ swin o (nvf' th) (nvf' te) ∧ cdm q4 = nadd (nvf' m) (nvf' te) ⇒ q4 = e ++ p $ by eq_trans [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l36]]]], scat_eq [l72, eq_trans [l59, l71]]]
