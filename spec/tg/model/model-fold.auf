l126: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ r = r $ by eq_refl
l127: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ p r ∈ lrel $ by wcel_eq_l [ra_rst_eq [l124, l114, l125, l126], l112]
l128: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ r = p $ by f51_rn_e [wcel_welc [l123], l127]
l129: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , ty = ⟨ kc_pi , scons p (scons q ∅) ⟩ ∧ vz = ⟨ kc_pi , scons r (scons t ∅) ⟩ ∧ ra_rst td x0 p r ∈ lrel ∧ ra_rst td x0 q t ∈ lrel ⇒ isset ∅ $ by ax_empty
