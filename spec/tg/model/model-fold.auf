l15: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ r2 ∊ fseq u $ by weaken [#7]
l16: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ r2 = r2 $ by eq_refl
l17: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ ⟨ vd , ⟨ ve , ⟨ vf , vn ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r2 $ by weaken [#10]
l18: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ ⟨ vd , ⟨ ve , ⟨ vf , vn ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_app , scons x (scons z ∅) ⟩ w r2 $ by wcel_eq_r [etel_eq [and_elim_l [l2], l10, l16], l17]
l19: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z ⇒ ∃ l ∃ m (m = ∅ ∧ ⟨ m , ⟨ m , ⟨ m , l ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x w r2 ∧ ve = m ∧ vn = scons (da ((dnf u M)' z) w r2) l) $ by etel_app_elim [and_elim_l [l7], and_elim_r [l7], l8, l15, l18]
l20: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z , b = ∅ ∧ ⟨ b , ⟨ b , ⟨ b , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x w r1 ∧ vb = b ∧ vo = scons (da ((dnf u M)' z) w r1) a ⇒ ∃ l ∃ m (m = ∅ ∧ ⟨ m , ⟨ m , ⟨ m , l ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x w r2 ∧ ve = m ∧ vn = scons (da ((dnf u M)' z) w r2) l) $ by weaken [l19]
l21: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z , b = ∅ ∧ ⟨ b , ⟨ b , ⟨ b , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x w r1 ∧ vb = b ∧ vo = scons (da ((dnf u M)' z) w r1) a , m = ∅ ∧ ⟨ m , ⟨ m , ⟨ m , l ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x w r2 ∧ ve = m ∧ vn = scons (da ((dnf u M)' z) w r2) l ⇒ functional (dnf u M) $ by dnf_functional
l22: $ G , ty = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ t2 = z , b = ∅ ∧ ⟨ b , ⟨ b , ⟨ b , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x w r1 ∧ vb = b ∧ vo = scons (da ((dnf u M)' z) w r1) a , m = ∅ ∧ ⟨ m , ⟨ m , ⟨ m , l ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x w r2 ∧ ve = m ∧ vn = scons (da ((dnf u M)' z) w r2) l ⇒ isset ((dnf u M)' z) $ by fv_set [l21]
