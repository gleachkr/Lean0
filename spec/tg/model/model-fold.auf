l414: $ G , x = dt u (mcv H) te w r , x6 = ⟨ kc_ccons , scons tK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ⇒ dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te ∅)) ⟩ w r = dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te2 ∅)) ⟩ w r ∧ dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te ∅)) ⟩ w r ∈ dt u (mcv H) tR w r $ by isset_elim [l413, l412]
l415: $ G , x = dt u (mcv H) te w r ⇒ isset ⟨ kc_ccons , scons tK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ $ by opair_isset
l416: $ G , x = dt u (mcv H) te w r ⇒ dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te ∅)) ⟩ w r = dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te2 ∅)) ⟩ w r ∧ dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te ∅)) ⟩ w r ∈ dt u (mcv H) tR w r $ by isset_elim [l415, l414]
l417: $ G ⇒ isset (dt u (mcv H) te w r) $ by dt_set
l418: $ G ⇒ dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te ∅)) ⟩ w r = dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te2 ∅)) ⟩ w r ∧ dt u (mcv H) ⟨ kc_proj , scons tb (scons tfi (scons te ∅)) ⟩ w r ∈ dt u (mcv H) tR w r $ by isset_elim [l417, l416]

