l149: $ G , ra_capp tM tp x1 ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_add tnp tn x2 ∈ lrel , ra_capp tN x1 x3 ∈ lrel ∧ ra_clen x3 x4 ∈ lrel ∧ ra_add x2 tm x4 ∈ lrel , z ∊ irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w , iprt td q e , p ∊ esat u (dnf u (mcv H)) q w , c ∊ imots u (dnf u (mcv H)) td w p (lv tv w) , m ∊ imins u (dnf u (mcv H)) td w p c , ityf td (nvf' tj) l , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) l w p , x ∊ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) (f ++ p) , y ∊ (ifold u (dnf u (mcv H)) td w p m)' ⟨ nvf' tj , ⟨ f ++ p , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ p) y ⇒ z = nest (m ++ c ++ p) (nest f ⟨ x , y ⟩) $ by eq_trans [l147, eq_trans [l145, nest_eq [l148, l146]]]
l150: $ G , ra_capp tM tp x1 ∈ lrel ∧ ra_clen x1 x2 ∈ lrel ∧ ra_add tnp tn x2 ∈ lrel , ra_capp tN x1 x3 ∈ lrel ∧ ra_clen x3 x4 ∈ lrel ∧ ra_add x2 tm x4 ∈ lrel , z ∊ irc u (dnf u (mcv H)) td (nvf' tj) (lv tv w) w , iprt td q e , p ∊ esat u (dnf u (mcv H)) q w , c ∊ imots u (dnf u (mcv H)) td w p (lv tv w) , m ∊ imins u (dnf u (mcv H)) td w p c , ityf td (nvf' tj) l , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) l w p , x ∊ apn (ity u (dnf u (mcv H)) td (nvf' tj) w) (f ++ p) , y ∊ (ifold u (dnf u (mcv H)) td w p m)' ⟨ nvf' tj , ⟨ f ++ p , x ⟩ ⟩ , z = nest (scons x f ++ m ++ c ++ p) y ⇒ z ∊ f44_tt (esat u (dnf u (mcv H)) x3 w) (f44_ma u (dnf u (mcv H)) tF w (ity u (dnf u (mcv H)) td (nvf' tj) w) (⋃ (⋃ (uni' (lv tv w)))) (esat u (dnf u (mcv H)) tp w)) $ by wcel_welc [wcel_eq_l [eq_sym [l149], l137]]
