l74: $ G , x9 = ⟨ kc_nz , ∅ ⟩ , ra_struct_like td ti ∈ lrel ∧ ra_ind_data td b p x3 ∈ lrel ∧ ra_nth_ty x3 ti x5 ⟨ kc_ccons , scons k (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen p n ∈ lrel ∧ ra_nonrec n ⟨ kc_nz , ∅ ⟩ k ∈ lrel , ra_ind_data td c q x4 ∈ lrel ∧ ra_nth_ty x4 ti x6 ⟨ kc_ccons , scons h (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort x6 ⟨ kc_nz , ∅ ⟩ l ∈ lrel , ra_ind_data td d e x7 ∈ lrel ∧ ra_nth_ty x7 ti x8 o ∈ lrel ∧ ra_nth_ctor o x9 m ∈ lrel ∧ ra_npis m tnf ∈ lrel , ra_ntys tt y z ∈ lrel ⇒ dt u (mcv H) te w r ∈ dt u (mcv H) tS w r $ by weaken [#4]
l75: $ G , x9 = ⟨ kc_nz , ∅ ⟩ , ra_struct_like td ti ∈ lrel ∧ ra_ind_data td b p x3 ∈ lrel ∧ ra_nth_ty x3 ti x5 ⟨ kc_ccons , scons k (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen p n ∈ lrel ∧ ra_nonrec n ⟨ kc_nz , ∅ ⟩ k ∈ lrel , ra_ind_data td c q x4 ∈ lrel ∧ ra_nth_ty x4 ti x6 ⟨ kc_ccons , scons h (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort x6 ⟨ kc_nz , ∅ ⟩ l ∈ lrel , ra_ind_data td d e x7 ∈ lrel ∧ ra_nth_ty x7 ti x8 o ∈ lrel ∧ ra_nth_ctor o x9 m ∈ lrel ∧ ra_npis m tnf ∈ lrel , ra_ntys tt y z ∈ lrel ⇒ dt u (mcv H) te w r = dt u (mcv H) tM w r $ by ind_eta_wf [l61, l62, l63, l64, l65, l66, l67, l68, l69, l70, l71, l72, l73, l74]
l76: $ G , x9 = ⟨ kc_nz , ∅ ⟩ , ra_struct_like td ti ∈ lrel ∧ ra_ind_data td b p x3 ∈ lrel ∧ ra_nth_ty x3 ti x5 ⟨ kc_ccons , scons k (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen p n ∈ lrel ∧ ra_nonrec n ⟨ kc_nz , ∅ ⟩ k ∈ lrel , ra_ind_data td c q x4 ∈ lrel ∧ ra_nth_ty x4 ti x6 ⟨ kc_ccons , scons h (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort x6 ⟨ kc_nz , ∅ ⟩ l ∈ lrel , ra_ind_data td d e x7 ∈ lrel ∧ ra_nth_ty x7 ti x8 o ∈ lrel ∧ ra_nth_ctor o x9 m ∈ lrel ∧ ra_npis m tnf ∈ lrel , ∃ z (ra_ntys tt y z ∈ lrel) ⇒ ∃ z (ra_ntys tt y z ∈ lrel) $ by ax
l77: $ … ⇒ dt u (mcv H) te w r = dt u (mcv H) tM w r $ by ex_elim [l76, l75]
l78: $ G , x9 = ⟨ kc_nz , ∅ ⟩ , ra_struct_like td ti ∈ lrel ∧ ra_ind_data td b p x3 ∈ lrel ∧ ra_nth_ty x3 ti x5 ⟨ kc_ccons , scons k (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen p n ∈ lrel ∧ ra_nonrec n ⟨ kc_nz , ∅ ⟩ k ∈ lrel , ra_ind_data td c q x4 ∈ lrel ∧ ra_nth_ty x4 ti x6 ⟨ kc_ccons , scons h (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort x6 ⟨ kc_nz , ∅ ⟩ l ∈ lrel , ra_ind_data td d e x7 ∈ lrel ∧ ra_nth_ty x7 ti x8 o ∈ lrel ∧ ra_nth_ctor o x9 m ∈ lrel ∧ ra_npis m tnf ∈ lrel ⇒ dt u (mcv H) te w r = dt u (mcv H) tM w r $ by ex_elim [l60, l77]
l79: $ G , x9 = ⟨ kc_nz , ∅ ⟩ , ra_struct_like td ti ∈ lrel ∧ ra_ind_data td b p x3 ∈ lrel ∧ ra_nth_ty x3 ti x5 ⟨ kc_ccons , scons k (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen p n ∈ lrel ∧ ra_nonrec n ⟨ kc_nz , ∅ ⟩ k ∈ lrel , ra_ind_data td c q x4 ∈ lrel ∧ ra_nth_ty x4 ti x6 ⟨ kc_ccons , scons h (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort x6 ⟨ kc_nz , ∅ ⟩ l ∈ lrel ⇒ dt u (mcv H) te w r = dt u (mcv H) tM w r $ by f21_inv_nfields [l39, l78]
l80: $ G , x9 = ⟨ kc_nz , ∅ ⟩ , ra_struct_like td ti ∈ lrel ∧ ra_ind_data td b p x3 ∈ lrel ∧ ra_nth_ty x3 ti x5 ⟨ kc_ccons , scons k (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen p n ∈ lrel ∧ ra_nonrec n ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ dt u (mcv H) te w r = dt u (mcv H) tM w r $ by f21_inv_struct_like [l12, l79]
l81: $ G , x9 = ⟨ kc_nz , ∅ ⟩ ⇒ dt u (mcv H) te w r = dt u (mcv H) tM w r $ by f21_inv_eta_ok [l10, l80]
l82: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l83: $ G ⇒ dt u (mcv H) te w r = dt u (mcv H) tM w r $ by isset_elim [l82, l81]

--| @freshen H qb_v
--| @freshen H qP
--| @freshen H qT
lemma f21_inv_ind_arity {qb_v qP qT: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_ind_arity t1 t2 t3 t4 ∈ lrel $ > $ H , ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_clen qP t2 ∈ lrel ∧ ra_ntys qT t3 t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_ind_arity t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) $ by lrel_ind_arity_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ qb_v = qb_v $ by eq_refl
l5: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ qP = qP $ by eq_refl
l6: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ qT = qT $ by eq_refl
l7: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel $ by wcel_eq_l [ra_ind_data_eq [eq_sym [and_elim_l [l3]], l4, l5, l6], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]
l8: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ ra_clen qP t2 ∈ lrel $ by wcel_eq_l [ra_clen_eq [l5, eq_sym [and_elim_l [and_elim_r [l3]]]], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]
l9: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ ra_ntys qT t3 t4 ∈ lrel $ by wcel_eq_l [ra_ntys_eq [l6, eq_sym [and_elim_l [and_elim_r [and_elim_r [l3]]]], eq_sym [and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]]]
l10: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_clen qP t2 ∈ lrel ∧ ra_ntys qT t3 t4 ∈ lrel $ by and_intro [l7, and_intro [l8, l9]]
l11: $ H ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_clen qP t2 ∈ lrel ∧ ra_ntys qT t3 t4 ∈ lrel → Cf $ by imp_intro [#2]
l12: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_clen qP t2 ∈ lrel ∧ ra_ntys qT t3 t4 ∈ lrel → Cf $ by weaken [l11]
l13: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel ⇒ Cf $ by imp_elim [l12, l10]
l14: $ G , H , ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) ⇒ ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) $ by ax
l15: $ … ⇒ Cf $ by ex_elim [l14, l13]
l16: $ G , H , ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) ⇒ ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) $ by ax
l17: $ … ⇒ Cf $ by ex_elim [l16, l15]
l18: $ G , H , ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) ⇒ ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) $ by ax
l19: $ … ⇒ Cf $ by ex_elim [l18, l17]
l20: $ G , H , ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) ⇒ ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) $ by ax
l21: $ … ⇒ Cf $ by ex_elim [l20, l19]
l22: $ G , H , ∃ qP ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) ⇒ ∃ qP ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
l24: $ G , H , ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) ⇒ ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) ⇒ ∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H ⇒ (∃ x ∃ qb_v ∃ qP ∃ qT ∃ y ∃ z ∃ u (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_clen qP y ∈ lrel ∧ ra_ntys qT z u ∈ lrel)) → Cf $ by imp_intro [l27]
l29: $ G , H ⇒ Cf $ by imp_elim [l28, l2]

--| @freshen H qb_v
--| @freshen H qP
--| @freshen H qN
--| @freshen H qT
--| @freshen H qnp
--| @freshen H qn_v
--| @freshen H qm_v
--| @freshen H qF
--| @freshen H qK
--| @freshen H qK2
--| @freshen H qK3
--| @freshen H qC
lemma f21_inv_ctor_ty {qb_v qP qN qT qnp qn_v qm_v qF qK qK2 qK3 qC: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4: set): $ G ⇒ ra_ctor_ty t1 t2 t3 t4 ∈ lrel $ > $ H , ra_ind_data t1 qb_v qP qT ∈ lrel ∧ ra_nth_ty qT t2 qF qC ∈ lrel ∧ ra_nth_ctor qC t3 qK ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_ind_nested t1 qN ∈ lrel ∧ ra_rst t1 qN qK2 qK3 ∈ lrel ∧ ra_pis qP qK3 t4 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_ctor_ty t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ qb_v ∃ qP ∃ qN ∃ qT ∃ y ∃ z ∃ qnp ∃ qn_v ∃ qm_v ∃ qF ∃ qK ∃ qK2 ∃ qK3 ∃ u ∃ qC (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_ind_nested x qN ∈ lrel ∧ ra_rst x qN qK2 qK3 ∈ lrel ∧ ra_pis qP qK3 u ∈ lrel) $ by lrel_ctor_ty_cases [l1]
l3: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_ind_nested x qN ∈ lrel ∧ ra_rst x qN qK2 qK3 ∈ lrel ∧ ra_pis qP qK3 u ∈ lrel ⇒ t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_ind_nested x qN ∈ lrel ∧ ra_rst x qN qK2 qK3 ∈ lrel ∧ ra_pis qP qK3 u ∈ lrel $ by ax
l4: $ G , H , t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ ra_ind_data x qb_v qP qT ∈ lrel ∧ ra_nth_ty qT y qF qC ∈ lrel ∧ ra_nth_ctor qC z qK ∈ lrel ∧ ra_clen qP qnp ∈ lrel ∧ ra_ntys qT qn_v qm_v ∈ lrel ∧ ra_sinst x ⟨ kc_nz , ∅ ⟩ qn_v qnp qK qK2 ∈ lrel ∧ ra_ind_nested x qN ∈ lrel ∧ ra_rst x qN qK2 qK3 ∈ lrel ∧ ra_pis qP qK3 u ∈ lrel ⇒ qb_v = qb_v $ by eq_refl
