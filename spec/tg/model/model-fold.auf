l203: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g ⇒ x ∊ dt u M b w (vq ++ s) $ by welc_eq [eq_sym [l202], l197]
l204: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g ⇒ dt u M b w (vq ++ s) ∈ two $ by weaken [l112]
l205: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g ⇒ x = ∅ $ by two_mem_empty [l204, l203]
l206: $ G , td = x1 ∧ tn = x2 ∧ tnp = x3 ∧ vc = c ∧ vd = d ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ty = ⟨ kc_pi , scons a (scons m ∅) ⟩ ∧ ra_add d x3 k ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 k a b ∈ lrel ∧ ra_deq c b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops x1 x2 x3 ⟨ kc_cons , scons b (scons c ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ n m ∈ lrel3 J , x ∊ dt u M a w ve ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) m w (scons x ve) ∧ vf = ssnoc f x ∧ vg = scons x g , x7 = ⟨ kc_cons , scons b (scons vc ∅) ⟩ , x0 = ⟨ kc_s , scons vd ∅ ⟩ , o = scons x vq , l = scons x ve ⇒ x7 = ⟨ kc_cons , scons b (scons vc ∅) ⟩ $ by ax
