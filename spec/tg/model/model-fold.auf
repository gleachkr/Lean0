l8: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_s , scons f ∅ ⟩ $ by eq_trans [eq_sym [l7], and_elim_l [and_elim_r [l6]]]
l9: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ kc_nz ∈ ω $ by kc_nz_omega
l10: $ G , x1 = ⟨ kc_nz , ∅ ⟩ , tq = ⟨ kc_cons , scons d (scons e ∅) ⟩ ∧ x1 = ⟨ kc_s , scons f ∅ ⟩ ∧ ra_clen e f ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
