l486: $ G , ty = ⟨ kc_ccons , scons k (scons h ∅) ⟩ ∧ ra_npis k n ∈ lrel ∧ ra_mwalk td tnp tn vk ti vd n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ k m ∈ lrel ∧ ra_cminors td tnp tn ⟨ kc_s , scons vk ∅ ⟩ ti ⟨ kc_s , scons vd ∅ ⟩ h q ∈ lrel ∧ ra_capp q ⟨ kc_cons , scons m (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vm ∈ lrel ⇒ esat u (dsh u M vr) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vq ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by f21_inv_clen_c [l47, l56, l485]
l487: $ G ⇒ esat u (dsh u M vr) vm w = {l | l ∊ fseq u ∧ cdm l = nvf' vq ∧ ∀ i (i ∊ N → nvf' vk ⊆ i → vat (l ++ vh) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $ by f21_inv_cminors [#27, l45, l486]

lemma f23_cm_all (G: hyps) (M Km J V N: class) (u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0: set): $ G ⇒ trees ω ⊆ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 $
----
l1: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ra_nth_ty tt ti tF tC0 ∈ lrel , Km ∈ ω , nadd (suc Km) (nvf' ti) = nvf' tn , nvf' ti ∈ nvf' tn , ti ∊ trees ω , ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) , ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) , ra_cminors td tnp tn k ti d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , d ∊ ofsort lsig lopen ks_nat , nvf' k = nadd (nvf' d) (nvf' tk0) , ∀ a ∀ e (ra_nth_ctor y a e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) , ra_clen_c y q ∈ lrel , nadd (nvf' k) (nvf' q) = N , h ∊ fseq u , cdm h = nvf' k , r = h ++ cv ++ pp ++ rr ⇒ crn c ⊆ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 $ by ax
l2: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ra_nth_ty tt ti tF tC0 ∈ lrel , Km ∈ ω , nadd (suc Km) (nvf' ti) = nvf' tn , nvf' ti ∈ nvf' tn , ti ∊ trees ω , ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) , ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) , ra_cminors td tnp tn k ti d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , d ∊ ofsort lsig lopen ks_nat , nvf' k = nadd (nvf' d) (nvf' tk0) , ∀ a ∀ e (ra_nth_ctor y a e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) , ra_clen_c y q ∈ lrel , nadd (nvf' k) (nvf' q) = N , h ∊ fseq u , cdm h = nvf' k , r = h ++ cv ++ pp ++ rr ⇒ y = ⟨ x , c ⟩ $ by ax
l3: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ra_nth_ty tt ti tF tC0 ∈ lrel , Km ∈ ω , nadd (suc Km) (nvf' ti) = nvf' tn , nvf' ti ∈ nvf' tn , ti ∊ trees ω , ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) , ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) , ra_cminors td tnp tn k ti d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , d ∊ ofsort lsig lopen ks_nat , nvf' k = nadd (nvf' d) (nvf' tk0) , ∀ a ∀ e (ra_nth_ctor y a e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) , ra_clen_c y q ∈ lrel , nadd (nvf' k) (nvf' q) = N , h ∊ fseq u , cdm h = nvf' k , r = h ++ cv ++ pp ++ rr ⇒ x ∊ ω $ by ax
l4: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ra_nth_ty tt ti tF tC0 ∈ lrel , Km ∈ ω , nadd (suc Km) (nvf' ti) = nvf' tn , nvf' ti ∈ nvf' tn , ti ∊ trees ω , ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) , ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) , ra_cminors td tnp tn k ti d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , d ∊ ofsort lsig lopen ks_nat , nvf' k = nadd (nvf' d) (nvf' tk0) , ∀ a ∀ e (ra_nth_ctor y a e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) , ra_clen_c y q ∈ lrel , nadd (nvf' k) (nvf' q) = N , h ∊ fseq u , cdm h = nvf' k , r = h ++ cv ++ pp ++ rr ⇒ c ∊ fseq (trees ω) $ by ax
l5: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ra_nth_ty tt ti tF tC0 ∈ lrel , Km ∈ ω , nadd (suc Km) (nvf' ti) = nvf' tn , nvf' ti ∈ nvf' tn , ti ∊ trees ω , ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) , ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) , ra_cminors td tnp tn k ti d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , d ∊ ofsort lsig lopen ks_nat , nvf' k = nadd (nvf' d) (nvf' tk0) , ∀ a ∀ e (ra_nth_ctor y a e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) , ra_clen_c y q ∈ lrel , nadd (nvf' k) (nvf' q) = N , h ∊ fseq u , cdm h = nvf' k , r = h ++ cv ++ pp ++ rr ⇒ uadm u $ by ax
l6: $ G , x ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ f23_cm_q M Km J V N u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0 , y = ⟨ x , c ⟩ , uadm u , w ∊ lvals , pp ∊ esat u (dnf u M) tp w , xs = ixs td w (ifam u (dnf u M) td w) , xs ∊ fseq u , cdm xs = nvf' tn , cv ∊ imots u (dnf u M) td w pp V , rr ∊ fseq u , td ∊ trees ω , ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → nvf' g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = xs' f) , intys td = nvf' tn , iprt td tp tt , ra_clen tp tnp ∈ lrel , ra_ntys tt tn tm ∈ lrel , ra_nth_ty tt ti tF tC0 ∈ lrel , Km ∈ ω , nadd (suc Km) (nvf' ti) = nvf' tn , nvf' ti ∈ nvf' tn , ti ∊ trees ω , ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (nvf' ti) (nvf' b) w) , ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (nvf' ti) (nvf' b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ nvf' a = nadd (nvf' tnp) (nvf' tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) , ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (nvf' ti) (nvf' b) (nadd (nvf' b) (nvf' tk0))) , ra_cminors td tnp tn k ti d y m ∈ lrel , m ∊ ofsort lsig lopen ks_ctx , d ∊ ofsort lsig lopen ks_nat , nvf' k = nadd (nvf' d) (nvf' tk0) , ∀ a ∀ e (ra_nth_ctor y a e ∈ lrel → ∃ b (ra_add a d b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) , ra_clen_c y q ∈ lrel , nadd (nvf' k) (nvf' q) = N , h ∊ fseq u , cdm h = nvf' k , r = h ++ cv ++ pp ++ rr ⇒ w ∊ lvals $ by ax
