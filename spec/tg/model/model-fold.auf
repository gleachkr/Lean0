def f51_rn_q (td: set) (.y .z: set): class = $ {y | ∀ z (ra_rst td ⟨ kc_nil , ∅ ⟩ y z ∈ lrel → z = y)} $

lemma f51_rn_e (G: hyps) (td: set) (ty vz: set): $ G ⇒ ty ∊ f51_rn_q td $ > $ G ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ ty vz ∈ lrel $ > $ G ⇒ vz = ty $
----
l1: $ G ⇒ ∀ z (ra_rst td ⟨ kc_nil , ∅ ⟩ ty z ∈ lrel → z = ty) $ by cab_elim [#1]
l2: $ G ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ ty vz ∈ lrel → vz = ty $ by all_elim [l1]
l3: $ G ⇒ vz = ty $ by imp_elim [l2, #2]

lemma f51_rn_n (G: hyps) (td: set) (ty k1 j1 vz: set): $ G ⇒ crn j1 ⊆ f51_rn_q td $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ ty vz ∈ lrel $ > $ G ⇒ vz = ty $
----
l1: $ G , x0 = ⟨ kc_nil , ∅ ⟩ ⇒ x0 = ⟨ kc_nil , ∅ ⟩ $ by ax
l2: $ G , x0 = ⟨ kc_nil , ∅ ⟩ ⇒ ra_rst td ⟨ kc_nil , ∅ ⟩ ty vz ∈ lrel $ by weaken [#5]
l3: $ G , x0 = ⟨ kc_nil , ∅ ⟩ ⇒ td = td $ by eq_refl
l4: $ G , x0 = ⟨ kc_nil , ∅ ⟩ ⇒ ty = ty $ by eq_refl
l5: $ G , x0 = ⟨ kc_nil , ∅ ⟩ ⇒ vz = vz $ by eq_refl
l6: $ G , x0 = ⟨ kc_nil , ∅ ⟩ ⇒ ra_rst td x0 ty vz ∈ lrel $ by wcel_eq_l [ra_rst_eq [l3, eq_sym [l1], l4, l5], l2]
l7: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , x0 = ⟨ kc_nil , ∅ ⟩ ∧ vz = ty ⇒ x0 = ⟨ kc_nil , ∅ ⟩ ∧ vz = ty $ by ax
l8: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , x0 = ⟨ kc_nil , ∅ ⟩ ∧ vz = ty ⇒ x0 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l7]
l9: $ G , x0 = ⟨ kc_nil , ∅ ⟩ , x0 = ⟨ kc_nil , ∅ ⟩ ∧ vz = ty ⇒ vz = ty $ by and_elim_r [l7]
