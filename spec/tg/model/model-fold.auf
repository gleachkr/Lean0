def f49_fp_q (J M: class) (u w td tn tnp xs s tz: set) (.y .c .d .n .q .e .f .g .t .a .i .x4 .x5: set): class = $ {y | ∀ c ∀ d ∀ n ∀ q ∀ e ∀ f ∀ g ∀ t ∀ a (jval u M J → uadm u → w ∊ lvals → xs ∊ fseq u → s ∊ fseq u → td ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → nadd (nvf' tz) (cdm xs) = nvf' tn → ∀ x4 ∀ x5 (x4 ∊ cdm xs → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = xs' x4) → ra_fprops td tn tnp c d n y ∈ lrel3 J → q ∊ fseq u → cdm q = nadd (nvf' d) (nvf' tnp) → q ++ s ∈ sat u M c w → e = q ++ xs ++ s → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w e → ∀ i (i ∊ nvf' n → g' i = ∅))} $

--| @freshen G i
--| @freshen G x4
--| @freshen G x5
lemma f49_fp_e {i x4 x5: set} (G: hyps) (J M: class) (u w td tn tnp xs s tz: set) (ty vc vd vn vq ve vf vg vt va: set): $ G ⇒ ty ∊ f49_fp_q J M u w td tn tnp xs s tz $ > $ G ⇒ jval u M J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ xs ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ nadd (nvf' tz) (cdm xs) = nvf' tn $ > $ G ⇒ ∀ x4 ∀ x5 (x4 ∊ cdm xs → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = xs' x4) $ > $ G ⇒ ra_fprops td tn tnp vc vd vn ty ∈ lrel3 J $ > $ G ⇒ vq ∊ fseq u $ > $ G ⇒ cdm vq = nadd (nvf' vd) (nvf' tnp) $ > $ G ⇒ vq ++ s ∈ sat u M vc w $ > $ G ⇒ ve = vq ++ xs ++ s $ > $ G ⇒ ⟨ vf , ⟨ vg , ⟨ vt , va ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w ve $ > $ G ⇒ ∀ i (i ∊ nvf' vn → vg' i = ∅) $
----
l1: $ G ⇒ ∀ c ∀ d ∀ n ∀ q ∀ e ∀ f ∀ g ∀ t ∀ a (jval u M J → uadm u → w ∊ lvals → xs ∊ fseq u → s ∊ fseq u → td ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → nadd (nvf' tz) (cdm xs) = nvf' tn → ∀ x4 ∀ x5 (x4 ∊ cdm xs → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = xs' x4) → ra_fprops td tn tnp c d n ty ∈ lrel3 J → q ∊ fseq u → cdm q = nadd (nvf' d) (nvf' tnp) → q ++ s ∈ sat u M c w → e = q ++ xs ++ s → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ∀ i (i ∊ nvf' n → g' i = ∅)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ d ∀ n ∀ q ∀ e ∀ f ∀ g ∀ t ∀ a (jval u M J → uadm u → w ∊ lvals → xs ∊ fseq u → s ∊ fseq u → td ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → nadd (nvf' tz) (cdm xs) = nvf' tn → ∀ x4 ∀ x5 (x4 ∊ cdm xs → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = xs' x4) → ra_fprops td tn tnp vc d n ty ∈ lrel3 J → q ∊ fseq u → cdm q = nadd (nvf' d) (nvf' tnp) → q ++ s ∈ sat u M vc w → e = q ++ xs ++ s → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ∀ i (i ∊ nvf' n → g' i = ∅)) $ by all_elim [l1]
l3: $ G ⇒ ∀ n ∀ q ∀ e ∀ f ∀ g ∀ t ∀ a (jval u M J → uadm u → w ∊ lvals → xs ∊ fseq u → s ∊ fseq u → td ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → nadd (nvf' tz) (cdm xs) = nvf' tn → ∀ x4 ∀ x5 (x4 ∊ cdm xs → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = xs' x4) → ra_fprops td tn tnp vc vd n ty ∈ lrel3 J → q ∊ fseq u → cdm q = nadd (nvf' vd) (nvf' tnp) → q ++ s ∈ sat u M vc w → e = q ++ xs ++ s → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ∀ i (i ∊ nvf' n → g' i = ∅)) $ by all_elim [l2]
l4: $ G ⇒ ∀ q ∀ e ∀ f ∀ g ∀ t ∀ a (jval u M J → uadm u → w ∊ lvals → xs ∊ fseq u → s ∊ fseq u → td ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → nadd (nvf' tz) (cdm xs) = nvf' tn → ∀ x4 ∀ x5 (x4 ∊ cdm xs → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = xs' x4) → ra_fprops td tn tnp vc vd vn ty ∈ lrel3 J → q ∊ fseq u → cdm q = nadd (nvf' vd) (nvf' tnp) → q ++ s ∈ sat u M vc w → e = q ++ xs ++ s → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ∀ i (i ∊ nvf' vn → g' i = ∅)) $ by all_elim [l3]
l5: $ G ⇒ ∀ e ∀ f ∀ g ∀ t ∀ a (jval u M J → uadm u → w ∊ lvals → xs ∊ fseq u → s ∊ fseq u → td ∊ trees ω → tz = ⟨ kc_nz , ∅ ⟩ → nadd (nvf' tz) (cdm xs) = nvf' tn → ∀ x4 ∀ x5 (x4 ∊ cdm xs → x5 ∊ trees ω → nvf' x5 = nadd (nvf' tz) x4 → dt u M ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = xs' x4) → ra_fprops td tn tnp vc vd vn ty ∈ lrel3 J → vq ∊ fseq u → cdm vq = nadd (nvf' vd) (nvf' tnp) → vq ++ s ∈ sat u M vc w → e = vq ++ xs ++ s → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w e → ∀ i (i ∊ nvf' vn → g' i = ∅)) $ by all_elim [l4]
