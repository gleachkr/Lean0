l64: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel , ty = ⟨ kc_ccons , scons h (scons i ∅) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen_c i n ∈ lrel , x2 = ⟨ kc_s , scons vk ∅ ⟩ ⇒ isset ⟨ kc_s , scons vc ∅ ⟩ $ by opair_isset
l65: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel , ty = ⟨ kc_ccons , scons h (scons i ∅) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen_c i n ∈ lrel , x2 = ⟨ kc_s , scons vk ∅ ⟩ ⇒ ra_clen vq vn ∈ lrel $ by isset_elim [l64, l63]
l66: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel , ty = ⟨ kc_ccons , scons h (scons i ∅) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen_c i n ∈ lrel ⇒ isset ⟨ kc_s , scons vk ∅ ⟩ $ by opair_isset
l67: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel , ty = ⟨ kc_ccons , scons h (scons i ∅) ⟩ ∧ vn = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen_c i n ∈ lrel ⇒ ra_clen vq vn ∈ lrel $ by isset_elim [l66, l65]
l68: $ G , ty = ⟨ kc_ccons , scons b (scons e ∅) ⟩ ∧ ra_npis b a ∈ lrel ∧ ra_mwalk t1 t2 t3 vk t5 vc a ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ b d ∈ lrel ∧ ra_cminors t1 t2 t3 ⟨ kc_s , scons vk ∅ ⟩ t5 ⟨ kc_s , scons vc ∅ ⟩ e f ∈ lrel ∧ ra_capp f ⟨ kc_cons , scons d (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ vq ∈ lrel ⇒ ra_clen vq vn ∈ lrel $ by f21_inv_clen_c [l14, l26, l67]
l69: $ G ⇒ ra_clen vq vn ∈ lrel $ by f21_inv_cminors [#5, l12, l68]

lemma f29_cm_all (G: hyps) (t1 t2 t3 t5: set): $ G ⇒ trees ω ⊆ f29_cm_q t1 t2 t3 t5 $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ , ra_cminors t1 t2 t3 k t5 c y q ∈ lrel , ra_clen_c y n ∈ lrel ⇒ crn x9 ⊆ f29_cm_q t1 t2 t3 t5 $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ , ra_cminors t1 t2 t3 k t5 c y q ∈ lrel , ra_clen_c y n ∈ lrel ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ , ra_cminors t1 t2 t3 k t5 c y q ∈ lrel , ra_clen_c y n ∈ lrel ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ , ra_cminors t1 t2 t3 k t5 c y q ∈ lrel , ra_clen_c y n ∈ lrel ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ , ra_cminors t1 t2 t3 k t5 c y q ∈ lrel , ra_clen_c y n ∈ lrel ⇒ ra_cminors t1 t2 t3 k t5 c y q ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ , ra_cminors t1 t2 t3 k t5 c y q ∈ lrel , ra_clen_c y n ∈ lrel ⇒ ra_clen_c y n ∈ lrel $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ , ra_cminors t1 t2 t3 k t5 c y q ∈ lrel , ra_clen_c y n ∈ lrel ⇒ ra_clen q n ∈ lrel $ by f29_cm_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ , ra_cminors t1 t2 t3 k t5 c y q ∈ lrel ⇒ ra_clen_c y n ∈ lrel → ra_clen q n ∈ lrel $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ ⇒ ra_cminors t1 t2 t3 k t5 c y q ∈ lrel → ra_clen_c y n ∈ lrel → ra_clen q n ∈ lrel $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ n (ra_cminors t1 t2 t3 k t5 c y q ∈ lrel → ra_clen_c y n ∈ lrel → ra_clen q n ∈ lrel) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ q ∀ n (ra_cminors t1 t2 t3 k t5 c y q ∈ lrel → ra_clen_c y n ∈ lrel → ra_clen q n ∈ lrel) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ c ∀ q ∀ n (ra_cminors t1 t2 t3 k t5 c y q ∈ lrel → ra_clen_c y n ∈ lrel → ra_clen q n ∈ lrel) $ by all_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ ⇒ ∀ k ∀ c ∀ q ∀ n (ra_cminors t1 t2 t3 k t5 c y q ∈ lrel → ra_clen_c y n ∈ lrel → ra_clen q n ∈ lrel) $ by all_intro [l12]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f29_cm_q t1 t2 t3 t5 $ by cab_intro [l13]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ f29_cm_q t1 t2 t3 t5 $ by wcel_intro [l15, l14]
l17: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l18: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f29_cm_q t1 t2 t3 t5 ⇒ ⟨ x8 , x9 ⟩ ∈ f29_cm_q t1 t2 t3 t5 $ by isset_elim [l17, l16]
l19: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_cm_q t1 t2 t3 t5 → ⟨ x8 , x9 ⟩ ∈ f29_cm_q t1 t2 t3 t5 $ by imp_intro [imp_intro [imp_intro [l18]]]
l20: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f29_cm_q t1 t2 t3 t5 → ⟨ x8 , x9 ⟩ ∈ f29_cm_q t1 t2 t3 t5) $ by all_intro [all_intro [l19]]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ trees ω ⊆ f29_cm_q t1 t2 t3 t5 $ by trees_ind_c [l21, l20]

cminors_clen
------------
l1: $ G ⇒ ⟨ kr_clen_c , scons tC (scons tn ∅) ⟩ ∈ latoms $ by lrel_latoms [#2]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G ⇒ isset (scons tn ∅) $ by scons_set [l2]
l4: $ G ⇒ isset (scons tC (scons tn ∅)) $ by scons_set [l3]
l5: $ G ⇒ kr_clen_c ∈ ω $ by kr_clen_c_omega
l6: $ G ⇒ kr_clen_c ∈ ω ∧ scons tC (scons tn ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, wcel_isset [l5], l4]
l7: $ G ⇒ crn (scons tC (scons tn ∅)) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l6]]
l8: $ G ⇒ isset ω $ by omega_set
l9: $ G ⇒ tC ∈ trees ω $ by crn_scons_head_trees [l8, l7]
l10: $ G ⇒ trees ω ⊆ f29_cm_q t1 t2 t3 t5 $ by f29_cm_all
l11: $ G ⇒ tC ∊ f29_cm_q t1 t2 t3 t5 $ by subset_elim [l10, wcel_welc [l9]]
l12: $ G ⇒ ra_clen tq tn ∈ lrel $ by f29_cm_e [l11, #1, #2]

def f29_mn_q (t1 t2 t3: set) (.y .k .i .q .n .m: set): class = $ {y | ∀ k ∀ i ∀ q ∀ n ∀ m (ra_minors t1 t2 t3 k i y q ∈ lrel → ra_ntys y n m ∈ lrel → ra_clen q m ∈ lrel)} $

lemma f29_mn_e (G: hyps) (t1 t2 t3: set) (ty vk vi vq vn vm: set): $ G ⇒ ty ∊ f29_mn_q t1 t2 t3 $ > $ G ⇒ ra_minors t1 t2 t3 vk vi ty vq ∈ lrel $ > $ G ⇒ ra_ntys ty vn vm ∈ lrel $ > $ G ⇒ ra_clen vq vm ∈ lrel $
----
l1: $ G ⇒ ∀ k ∀ i ∀ q ∀ n ∀ m (ra_minors t1 t2 t3 k i ty q ∈ lrel → ra_ntys ty n m ∈ lrel → ra_clen q m ∈ lrel) $ by cab_elim [#1]
l2: $ G ⇒ ∀ i ∀ q ∀ n ∀ m (ra_minors t1 t2 t3 vk i ty q ∈ lrel → ra_ntys ty n m ∈ lrel → ra_clen q m ∈ lrel) $ by all_elim [l1]
l3: $ G ⇒ ∀ q ∀ n ∀ m (ra_minors t1 t2 t3 vk vi ty q ∈ lrel → ra_ntys ty n m ∈ lrel → ra_clen q m ∈ lrel) $ by all_elim [l2]
l4: $ G ⇒ ∀ n ∀ m (ra_minors t1 t2 t3 vk vi ty vq ∈ lrel → ra_ntys ty n m ∈ lrel → ra_clen vq m ∈ lrel) $ by all_elim [l3]
l5: $ G ⇒ ∀ m (ra_minors t1 t2 t3 vk vi ty vq ∈ lrel → ra_ntys ty vn m ∈ lrel → ra_clen vq m ∈ lrel) $ by all_elim [l4]
l6: $ G ⇒ ra_minors t1 t2 t3 vk vi ty vq ∈ lrel → ra_ntys ty vn vm ∈ lrel → ra_clen vq vm ∈ lrel $ by all_elim [l5]
l7: $ G ⇒ ra_ntys ty vn vm ∈ lrel → ra_clen vq vm ∈ lrel $ by imp_elim [l6, #2]
l8: $ G ⇒ ra_clen vq vm ∈ lrel $ by imp_elim [l7, #3]

lemma f29_mn_n (G: hyps) (t1 t2 t3: set) (ty k1 j1 vk vi vq vn vm: set): $ G ⇒ crn j1 ⊆ f29_mn_q t1 t2 t3 $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_minors t1 t2 t3 vk vi ty vq ∈ lrel $ > $ G ⇒ ra_ntys ty vn vm ∈ lrel $ > $ G ⇒ ra_clen vq vm ∈ lrel $
----
l1: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ $ by ax
l2: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ ra_ntys ty vn vm ∈ lrel $ by weaken [#6]
l3: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ x2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l4: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ ty = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l1]
l5: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_ntys_nil
l6: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ntys ty x2 x2 ∈ lrel $ by wcel_eq_l [ra_ntys_eq [eq_sym [weaken [l4]], eq_sym [l3], eq_sym [l3]], l5]
l7: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ vn = x2 ∧ vm = x2 $ by lrel_ntys_det [weaken [l2], l6]
l8: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ vq = ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l1]
l9: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by lrel_clen_nil
l10: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ , x2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen vq vm ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [weaken [l8]], eq_sym [eq_trans [and_elim_r [l7], l3]]], l9]
l11: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l12: $ G , ty = ⟨ kc_tnil , ∅ ⟩ ∧ vq = ⟨ kc_nil , ∅ ⟩ ⇒ ra_clen vq vm ∈ lrel $ by isset_elim [l11, l10]
l13: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel ⇒ ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel $ by ax
l14: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel ⇒ ra_ntys ty vn vm ∈ lrel $ by weaken [#6]
l15: $ G , ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ ra_cminors t1 t2 t3 vk vi ⟨ kc_nz , ∅ ⟩ e g ∈ lrel ∧ ra_clen_c e a ∈ lrel ∧ ra_add vk a b ∈ lrel ∧ ra_minors t1 t2 t3 b ⟨ kc_s , scons vi ∅ ⟩ f h ∈ lrel ∧ ra_capp h g vq ∈ lrel ⇒ ty = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ $ by and_elim_l [l13]
