l221: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel , v ∊ fseq {y | y = y} ∧ cdm v = nvf' d ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' d → v' m = (dt u M te w r)' (suc i)) ∧ dt u M c w r = apn (dt u M tY w r) v , x = dt u M ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ w r ⇒ isset (scons x v) $ by scons_set [l220]
l222: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel , v ∊ fseq {y | y = y} ∧ cdm v = nvf' d ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' d → v' m = (dt u M te w r)' (suc i)) ∧ dt u M c w r = apn (dt u M tY w r) v , x = dt u M ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ w r ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by isset_elim [l221, l219]
l223: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel , v ∊ fseq {y | y = y} ∧ cdm v = nvf' d ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' d → v' m = (dt u M te w r)' (suc i)) ∧ dt u M c w r = apn (dt u M tY w r) v ⇒ isset (dt u M ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ w r) $ by dt_set
l224: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel , v ∊ fseq {y | y = y} ∧ cdm v = nvf' d ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' d → v' m = (dt u M te w r)' (suc i)) ∧ dt u M c w r = apn (dt u M tY w r) v ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by isset_elim [l223, l222]
l225: $ G , ty = ⟨ kc_s , scons d ∅ ⟩ ∧ vq = ⟨ kc_app , scons c (scons ⟨ kc_proj , scons tb (scons d (scons te ∅)) ⟩ ∅) ⟩ ∧ ra_projs tb te d tY c ∈ lrel ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by ex_elim [l134, l224]
l226: $ G ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' ty ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' ty → v' m = (dt u M te w r)' (suc i)) ∧ dt u M vq w r = apn (dt u M tY w r) v) $ by f21_inv_projs [#5, l40, l225]

lemma f48_pj_all (G: hyps) (M: class) (u w r tb te tY: set): $ G ⇒ trees ω ⊆ f48_pj_q M u w r tb te tY $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals , r ∊ fseq u ⇒ crn x9 ⊆ f48_pj_q M u w r tb te tY $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals , r ∊ fseq u ⇒ x7 = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals , r ∊ fseq u ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals , r ∊ fseq u ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals , r ∊ fseq u ⇒ ra_projs tb te x7 tY q ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals , r ∊ fseq u ⇒ w ∊ lvals $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals , r ∊ fseq u ⇒ ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' x7 ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' x7 → v' m = (dt u M te w r)' (suc i)) ∧ dt u M q w r = apn (dt u M tY w r) v) $ by f48_pj_n [l1, l2, l3, l4, l5, l6, l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f48_pj_q M u w r tb te tY , x7 = ⟨ x8 , x9 ⟩ , ra_projs tb te x7 tY q ∈ lrel , w ∊ lvals ⇒ r ∊ fseq u → ∃ v (v ∊ fseq {y | y = y} ∧ cdm v = nvf' x7 ∧ ∀ i ∀ m (i ∊ ω → m ∊ ω → nadd i (suc m) = nvf' x7 → v' m = (dt u M te w r)' (suc i)) ∧ dt u M q w r = apn (dt u M tY w r) v) $ by imp_intro [l8]
