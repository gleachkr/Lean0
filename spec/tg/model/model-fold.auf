l1: $ G ⇒ (∃ y (y ∊ vat s N j)) ∨ ¬ ∃ y (y ∊ vat s N j) $ by excluded_middle
l2: $ G , y ∊ vat s N j ⇒ y ∊ vat s N j $ by ax
l3: $ G , y ∊ vat s N j ⇒ y ∊ {y | ∃ k (k ∊ ω ∧ nadd (suc j) k = N ∧ y ∊ s' k)} $ by weaken [l2]
