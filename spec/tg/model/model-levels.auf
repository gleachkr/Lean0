lemma a0_ctx_kids (H: hyps) (z a p: set): $ H ⇒ z ∊ ofsort lsig lopen ks_ctx $ > $ H ⇒ z = ⟨ kc_cons , a +: p +: ∅ ⟩ $ > $ H ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $
----
k1: $ … ⇒ (z = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x ∃ y (z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $ by ofsort_ctx_cases [#1]
n1: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by ax
n2: $ … ⇒ ⟨ kc_nil , ∅ ⟩ = z $ by eq_sym [n1]
n3a: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ z = ⟨ kc_cons , a +: p +: ∅ ⟩ $ by weaken [#2]
n3: $ … ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_cons , a +: p +: ∅ ⟩ $ by eq_trans [n2, n3a]
n4a: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ kc_nil ∈ ω $ by kc_nil_omega
n4b: $ … ⇒ isset kc_nil $ by wcel_isset [n4a]
n4c: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
n4d: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ kc_cons ∈ ω $ by kc_cons_omega
n4e: $ … ⇒ isset kc_cons $ by wcel_isset [n4d]
n4f: $ … ⇒ isset (p +: ∅) $ by scons_set [n4c]
n4g: $ … ⇒ isset (a +: p +: ∅) $ by scons_set [n4f]
n5: $ … ⇒ kc_nil = kc_cons ∧ ∅ = a +: p +: ∅ $ by opair_inj_c [n3, n4b, n4c, n4e, n4g]
n6: $ … ⇒ kc_nil = kc_cons $ by and_elim_l [n5]
n7: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
n8: $ … ⇒ ⊥ $ by not_elim [n7, n6]
n9: $ … ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by bot_elim [n8]
c1: $ H , z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx $ by ax
c2: $ … ⇒ z = ⟨ kc_cons , x +: y +: ∅ ⟩ $ by and_elim_l [c1]
c3: $ … ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx $ by and_elim_r [c1]
c4: $ … ⇒ x ∊ ofsort lsig lopen ks_expr $ by and_elim_l [c3]
c5: $ … ⇒ y ∊ ofsort lsig lopen ks_ctx $ by and_elim_r [c3]
c6a: $ … ⇒ ⟨ kc_cons , x +: y +: ∅ ⟩ = z $ by eq_sym [c2]
c6b: $ H , z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ z = ⟨ kc_cons , a +: p +: ∅ ⟩ $ by weaken [#2]
c6: $ … ⇒ ⟨ kc_cons , x +: y +: ∅ ⟩ = ⟨ kc_cons , a +: p +: ∅ ⟩ $ by eq_trans [c6a, c6b]
c7a: $ H , z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ kc_cons ∈ ω $ by kc_cons_omega
c7b: $ … ⇒ isset kc_cons $ by wcel_isset [c7a]
c7c: $ H , z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset ∅ $ by ax_empty
c7d: $ … ⇒ isset (y +: ∅) $ by scons_set [c7c]
c7e: $ … ⇒ isset (x +: y +: ∅) $ by scons_set [c7d]
c7f: $ … ⇒ isset (p +: ∅) $ by scons_set [c7c]
c7g: $ … ⇒ isset (a +: p +: ∅) $ by scons_set [c7f]
c8: $ … ⇒ kc_cons = kc_cons ∧ x +: y +: ∅ = a +: p +: ∅ $ by opair_inj_c [c6, c7b, c7e, c7b, c7g]
c9: $ … ⇒ x +: y +: ∅ = a +: p +: ∅ $ by and_elim_r [c8]
c10a: $ H , z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset x $ by isset_var
c10b: $ H , z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset y $ by isset_var
c10c: $ H , z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset a $ by isset_var
