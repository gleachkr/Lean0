l8: $ G , r = ⟨ kc_s , n +: ∅ ⟩ ⇒ n ∈ trees ω $ by weaken [#2]
l9: $ … ⇒ nvf' ⟨ kc_s , n +: ∅ ⟩ = suc (nvf' n) $ by nvf_s [l8]
l10: $ … ⇒ nvf' r = suc (nvf' n) $ by eq_trans [l7, l9]
l11: $ … ⇒ suc (nvf' n) ⊆ nvf' m $ by subset_eq_l [l10, l5]
l12: $ G , r = ⟨ kc_s , n +: ∅ ⟩ ⇒ nvf' n = i $ by weaken [#3]
l13: $ … ⇒ suc (nvf' n) = suc i $ by suc_eq [l12]
l14: $ … ⇒ suc i ⊆ nvf' m $ by subset_eq_l [l13, l11]
l15: $ G , r = ⟨ kc_s , n +: ∅ ⟩ ⇒ isset i $ by isset_var
l16: $ … ⇒ ¬ nvf' m = i $ by k5_sne2 [l14, l15]
l17: $ G ⇒ isset ⟨ kc_s , n +: ∅ ⟩ $ by opair_isset
l18: $ … ⇒ ¬ nvf' m = i $ by isset_elim [l17, l16]

lrel_linst_sem
--------------
l1: $ G ⇒ isset t1 $ by isset_var
l2: $ … ⇒ lsv t1 w ∈ fseq ω $ by lsv_fseq [l1, #2]
l3: $ … ⇒ isset (lsv t1 w) $ by wcel_isset [l2]
