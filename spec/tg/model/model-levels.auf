l10: $ … ⇒ lv (enc_lvl (lmax (ls a) (ls b))) x = nmax (suc (lv (enc_lvl a) x)) (suc (lv (enc_lvl b) x)) $ by eq_trans [l4, l9]
l11: $ x ∊ lvals ⇒ enc_lvl (lmax a b) ∈ trees ω $ by enc_lvl_trees
l12: $ … ⇒ lv (enc_lvl (ls (lmax a b))) x = suc (lv (enc_lvl (lmax a b)) x) $ by lv_ls [l11, l1]
l13: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l14: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l15: $ … ⇒ lv (enc_lvl (lmax a b)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x) $ by lv_lmax [l13, l14, l1]
l16: $ … ⇒ suc (lv (enc_lvl (lmax a b)) x) = suc (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) $ by suc_eq [l15]
l17: $ … ⇒ lv (enc_lvl (ls (lmax a b))) x = suc (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) $ by eq_trans [l12, l16]
l18: $ … ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l19: $ … ⇒ lv (enc_lvl b) x ∈ ω $ by k6_lvo [l1]
l20: $ … ⇒ nmax (suc (lv (enc_lvl a) x)) (suc (lv (enc_lvl b) x)) = suc (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) $ by nmax_suc_c [l18, l19]
l21: $ … ⇒ lv (enc_lvl (lmax (ls a) (ls b))) x = lv (enc_lvl (ls (lmax a b))) x $ by k6_eq3 [l10, l17, l20]
l22: $ leqv (lmax (ls a) (ls b)) (ls (lmax a b)) $ by leqv_i [l21]

