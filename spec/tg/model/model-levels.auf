l359: $ … ⇒ ∀ v (k ∊ ω → v ∊ fseq (trees ω) → crn v ⊆ {x | ∀ z (⟨ kr_lsubst , t1 +: x +: t3 +: z +: ∅ ⟩ ∈ lrel → lv z w = lv x f)} → ⟨ k , v ⟩ ∈ {x | ∀ z (⟨ kr_lsubst , t1 +: x +: t3 +: z +: ∅ ⟩ ∈ lrel → lv z w = lv x f)}) $ by all_intro [l358]
l360: $ … ⇒ ∀ k ∀ v (k ∊ ω → v ∊ fseq (trees ω) → crn v ⊆ {x | ∀ z (⟨ kr_lsubst , t1 +: x +: t3 +: z +: ∅ ⟩ ∈ lrel → lv z w = lv x f)} → ⟨ k , v ⟩ ∈ {x | ∀ z (⟨ kr_lsubst , t1 +: x +: t3 +: z +: ∅ ⟩ ∈ lrel → lv z w = lv x f)}) $ by all_intro [l359]
l361o: $ G , i = nvf' t1 , j = lv t3 w , f = lupd w i j ⇒ isset ω $ by omega_set
l361: $ … ⇒ trees ω ⊆ {x | ∀ z (⟨ kr_lsubst , t1 +: x +: t3 +: z +: ∅ ⟩ ∈ lrel → lv z w = lv x f)} $ by trees_ind_c [l361o, l360]
l362: $ G , i = nvf' t1 , j = lv t3 w , f = lupd w i j ⇒ kr_lsubst ∈ ω $ by kr_lsubst_omega
l363: $ … ⇒ isset kr_lsubst $ by wcel_isset [l362]
l364: $ G , i = nvf' t1 , j = lv t3 w , f = lupd w i j ⇒ ra_lsubst t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l365: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by lrel_args4 [l364, l363]
l366: $ … ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [l365]
l367: $ … ⇒ t2 ∊ trees ω $ by and_elim_l [l366]
l368: $ … ⇒ t2 ∊ {x | ∀ z (⟨ kr_lsubst , t1 +: x +: t3 +: z +: ∅ ⟩ ∈ lrel → lv z w = lv x f)} $ by subset_elim [l361, l367]
l369: $ … ⇒ ∀ z (⟨ kr_lsubst , t1 +: t2 +: t3 +: z +: ∅ ⟩ ∈ lrel → lv z w = lv t2 f) $ by cab_elim [l368]
l370: $ … ⇒ ⟨ kr_lsubst , t1 +: t2 +: t3 +: t4 +: ∅ ⟩ ∈ lrel → lv t4 w = lv t2 f $ by all_elim [l369]
l371: $ … ⇒ lv t4 w = lv t2 f $ by imp_elim [l370, l364]
l372: $ G , i = nvf' t1 , j = lv t3 w , f = lupd w i j ⇒ w = w $ by eq_refl
l373: $ G , i = nvf' t1 , j = lv t3 w , f = lupd w i j ⇒ i = nvf' t1 $ by ax
l374: $ G , i = nvf' t1 , j = lv t3 w , f = lupd w i j ⇒ j = lv t3 w $ by ax
l375: $ … ⇒ lupd w i j = lupd w (nvf' t1) (lv t3 w) $ by lupd_eq [l372, l373, l374]
l376: $ … ⇒ f = lupd w (nvf' t1) (lv t3 w) $ by eq_trans [l20, l375]
l377: $ G , i = nvf' t1 , j = lv t3 w , f = lupd w i j ⇒ t2 = t2 $ by eq_refl
l378: $ … ⇒ lv t2 f = lv t2 (lupd w (nvf' t1) (lv t3 w)) $ by lv_eq [l377, l376]
l379: $ … ⇒ lv t4 w = lv t2 (lupd w (nvf' t1) (lv t3 w)) $ by eq_trans [l371, l378]
l380: $ … ⇒ lv t4 w = lv t2 (lupd w (nvf' t1) (lv t3 w)) $ by isset_elim [l19, l379]
l381: $ … ⇒ lv t4 w = lv t2 (lupd w (nvf' t1) (lv t3 w)) $ by isset_elim [l6, l380]
l382: $ … ⇒ lv t4 w = lv t2 (lupd w (nvf' t1) (lv t3 w)) $ by isset_elim [l3, l381]

lemma k5_mva3 (G: hyps) (K A B C A2 B2 C2: class):
  $ G ⇒ ⟨ K , A +: B +: C +: ∅ ⟩ ∈ lrel $ > $ G ⇒ A = A2 $ > $ G ⇒ B = B2 $ > $ G ⇒ C = C2 $ > $ G ⇒ ⟨ K , A2 +: B2 +: C2 +: ∅ ⟩ ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ … ⇒ C +: ∅ = C2 +: ∅ $ by scons_eq [#4, l1]
l3: $ … ⇒ B +: C +: ∅ = B2 +: C2 +: ∅ $ by scons_eq [#3, l2]
l4: $ … ⇒ A +: B +: C +: ∅ = A2 +: B2 +: C2 +: ∅ $ by scons_eq [#2, l3]
l5: $ G ⇒ K = K $ by eq_refl
l6: $ … ⇒ ⟨ K , A +: B +: C +: ∅ ⟩ = ⟨ K , A2 +: B2 +: C2 +: ∅ ⟩ $ by opair_eq [l5, l4]
l7: $ … ⇒ ⟨ K , A2 +: B2 +: C2 +: ∅ ⟩ ∈ lrel $ by wcel_eq_l [l6, #1]

lemma k5_mva4 (G: hyps) (K A B C D A2 B2 C2 D2: class):
  $ G ⇒ ⟨ K , A +: B +: C +: D +: ∅ ⟩ ∈ lrel $ > $ G ⇒ A = A2 $ > $ G ⇒ B = B2 $ > $ G ⇒ C = C2 $ > $ G ⇒ D = D2 $ > $ G ⇒ ⟨ K , A2 +: B2 +: C2 +: D2 +: ∅ ⟩ ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ … ⇒ D +: ∅ = D2 +: ∅ $ by scons_eq [#5, l1]
l3: $ … ⇒ C +: D +: ∅ = C2 +: D2 +: ∅ $ by scons_eq [#4, l2]
l4: $ … ⇒ B +: C +: D +: ∅ = B2 +: C2 +: D2 +: ∅ $ by scons_eq [#3, l3]
l5: $ … ⇒ A +: B +: C +: D +: ∅ = A2 +: B2 +: C2 +: D2 +: ∅ $ by scons_eq [#2, l4]
l6: $ G ⇒ K = K $ by eq_refl
l7: $ … ⇒ ⟨ K , A +: B +: C +: D +: ∅ ⟩ = ⟨ K , A2 +: B2 +: C2 +: D2 +: ∅ ⟩ $ by opair_eq [l6, l5]
l8: $ … ⇒ ⟨ K , A2 +: B2 +: C2 +: D2 +: ∅ ⟩ ∈ lrel $ by wcel_eq_l [l7, #1]

linst_sem
---------
l1: $ G ⇒ ra_linst (enc_lvls S) (enc_lvl l) (enc_lvl l2) ∈ lrel $ by weaken [#1]
l2: $ G ⇒ enc_lvls S ∈ trees ω $ by enc_lvls_trees
l3: $ … ⇒ isset (enc_lvls S) $ by wcel_isset [l2]
l4: $ G ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l5: $ … ⇒ isset (enc_lvl l) $ by wcel_isset [l4]
l6: $ G ⇒ enc_lvl l2 ∈ trees ω $ by enc_lvl_trees
l7: $ … ⇒ isset (enc_lvl l2) $ by wcel_isset [l6]
l8: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ x = enc_lvls S $ by ax
l9: $ … ⇒ enc_lvls S = x $ by eq_sym [l8]
l10: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ y = enc_lvl l $ by ax
l11: $ … ⇒ enc_lvl l = y $ by eq_sym [l10]
l12: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ z = enc_lvl l2 $ by ax
l13: $ … ⇒ enc_lvl l2 = z $ by eq_sym [l12]
l14: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ ra_linst (enc_lvls S) (enc_lvl l) (enc_lvl l2) ∈ lrel $ by weaken [l1]
l15: $ … ⇒ ⟨ kr_linst , x +: y +: z +: ∅ ⟩ ∈ lrel $ by k5_mva3 [l14, l9, l11, l13]
l16: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ w ∊ lvals $ by weaken [#2]
l17: $ … ⇒ lv z w = lv y (lsub (lsv x w)) $ by lrel_linst_sem [l15, l16]
l18: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ w = w $ by eq_refl
l19: $ … ⇒ lv (enc_lvl l2) w = lv z w $ by lv_eq [l13, l18]
l20: $ … ⇒ lsv x w = lsv (enc_lvls S) w $ by lsv_eq [l8, l18]
l21: $ … ⇒ lsub (lsv x w) = lsub (lsv (enc_lvls S) w) $ by lsub_eq [l20]
l22: $ … ⇒ lv y (lsub (lsv x w)) = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by lv_eq [l10, l21]
l23: $ … ⇒ lv (enc_lvl l2) w = lv y (lsub (lsv x w)) $ by eq_trans [l19, l17]
l24: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by eq_trans [l23, l22]
l25: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by isset_elim [l7, l24]
l26: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by isset_elim [l5, l25]
l27: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by isset_elim [l3, l26]

lsubst_sem
----------
l1: $ G ⇒ ra_lsubst (enc_nat n) (enc_lvl l) (enc_lvl a) (enc_lvl l2) ∈ lrel $ by weaken [#1]
l2: $ G ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l3: $ … ⇒ isset (enc_nat n) $ by wcel_isset [l2]
l4: $ G ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l5: $ … ⇒ isset (enc_lvl l) $ by wcel_isset [l4]
l6: $ G ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l7: $ … ⇒ isset (enc_lvl a) $ by wcel_isset [l6]
l8: $ G ⇒ enc_lvl l2 ∈ trees ω $ by enc_lvl_trees
l9: $ … ⇒ isset (enc_lvl l2) $ by wcel_isset [l8]
l10: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ x = enc_nat n $ by ax
l11: $ … ⇒ enc_nat n = x $ by eq_sym [l10]
l12: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ y = enc_lvl l $ by ax
l13: $ … ⇒ enc_lvl l = y $ by eq_sym [l12]
l14: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ z = enc_lvl a $ by ax
l15: $ … ⇒ enc_lvl a = z $ by eq_sym [l14]
l16: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ u = enc_lvl l2 $ by ax
l17: $ … ⇒ enc_lvl l2 = u $ by eq_sym [l16]
l18: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ ra_lsubst (enc_nat n) (enc_lvl l) (enc_lvl a) (enc_lvl l2) ∈ lrel $ by weaken [l1]
l19: $ … ⇒ ⟨ kr_lsubst , x +: y +: z +: u +: ∅ ⟩ ∈ lrel $ by k5_mva4 [l18, l11, l13, l15, l17]
l20: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ w ∊ lvals $ by weaken [#2]
l21: $ … ⇒ lv u w = lv y (lupd w (nvf' x) (lv z w)) $ by lrel_lsubst_sem [l19, l20]
l22: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ w = w $ by eq_refl
l23: $ … ⇒ lv (enc_lvl l2) w = lv u w $ by lv_eq [l17, l22]
l24: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ nvf = nvf $ by eq_refl
l25: $ … ⇒ nvf' x = nvf' (enc_nat n) $ by fv_eq [l24, l10]
l26: $ … ⇒ lv z w = lv (enc_lvl a) w $ by lv_eq [l14, l22]
l27: $ … ⇒ lupd w (nvf' x) (lv z w) = lupd w (nvf' (enc_nat n)) (lv (enc_lvl a) w) $ by lupd_eq [l22, l25, l26]
l28: $ … ⇒ lv y (lupd w (nvf' x) (lv z w)) = lv (enc_lvl l) (lupd w (nvf' (enc_nat n)) (lv (enc_lvl a) w)) $ by lv_eq [l12, l27]
l29: $ … ⇒ lv (enc_lvl l2) w = lv y (lupd w (nvf' x) (lv z w)) $ by eq_trans [l23, l21]
l30: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (nvf' (enc_nat n)) (lv (enc_lvl a) w)) $ by eq_trans [l29, l28]
l31: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (nvf' (enc_nat n)) (lv (enc_lvl a) w)) $ by isset_elim [l9, l30]
l32: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (nvf' (enc_nat n)) (lv (enc_lvl a) w)) $ by isset_elim [l7, l31]
l33: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (nvf' (enc_nat n)) (lv (enc_lvl a) w)) $ by isset_elim [l5, l32]
l34: $ … ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (nvf' (enc_nat n)) (lv (enc_lvl a) w)) $ by isset_elim [l3, l33]

leqv_i
------
l1: $ … ⇒ x ∊ lvals → lv (enc_lvl a) x = lv (enc_lvl b) x $ by imp_intro [#1]
l2: $ leqv a b $ by all_intro [l1]

leqv_e
------
l1: $ … ⇒ w ∊ lvals → lv (enc_lvl a) w = lv (enc_lvl b) w $ by all_elim [#1]
l2: $ G ⇒ w ∊ lvals → lv (enc_lvl a) w = lv (enc_lvl b) w $ by weaken [l1]
l3: $ … ⇒ lv (enc_lvl a) w = lv (enc_lvl b) w $ by imp_elim [l2, #2]

leqv_lveq
---------
l1: $ G ⇒ lveq (enc_lvl a) (enc_lvl b) $ by weaken [#1]

lveq_leqv
---------
l1: $ … ⇒ x ∊ lvals → lv (enc_lvl a) x = lv (enc_lvl b) x $ by all_elim [#1]
l2: $ leqv a b $ by all_intro [l1]

lveq_congr
----------
l1: $ (y ∊ lvals) ⟺ (y ∊ lvals) $ by iff_refl
l2: $ y ≐ y $ by ceqt_refl
l3: $ lv A y ≐ lv B y $ by lv_congr [#1, l2]
l4: $ lv C y ≐ lv D y $ by lv_congr [#2, l2]
l5: $ (lv A y = lv C y) ⟺ (lv B y = lv D y) $ by ceq_congr [l3, l4]
l6: $ (y ∊ lvals → lv A y = lv C y) ⟺ (y ∊ lvals → lv B y = lv D y) $ by im_congr [l1, l5]
l7: $ ∀ y (y ∊ lvals → lv A y = lv C y) ⟺ ∀ y (y ∊ lvals → lv B y = lv D y) $ by all_congr [l6]

lveq_eq
-------
l1: $ … ⇒ x ∊ lvals → lv A x = lv C x $ by all_elim [#3]
l2: $ G , x ∊ lvals ⇒ x ∊ lvals → lv A x = lv C x $ by weaken [l1]
l3: $ G , x ∊ lvals ⇒ x ∊ lvals $ by ax
l4: $ … ⇒ lv A x = lv C x $ by imp_elim [l2, l3]
l5: $ G , x ∊ lvals ⇒ A = B $ by weaken [#1]
l6: $ G , x ∊ lvals ⇒ C = D $ by weaken [#2]
l7: $ G , x ∊ lvals ⇒ x = x $ by eq_refl
l8: $ … ⇒ lv A x = lv B x $ by lv_eq [l5, l7]
l9: $ … ⇒ lv C x = lv D x $ by lv_eq [l6, l7]
l10: $ … ⇒ lv B x = lv A x $ by eq_sym [l8]
l11: $ … ⇒ lv B x = lv C x $ by eq_trans [l10, l4]
l12: $ … ⇒ lv B x = lv D x $ by eq_trans [l11, l9]
l13: $ … ⇒ x ∊ lvals → lv B x = lv D x $ by imp_intro [l12]
l14: $ … ⇒ lveq B D $ by all_intro [l13]

sb_f_lveq
---------
l1: $ [ x / t ] (∀ y (y ∊ lvals → lv A y = lv B y)) ⟺ ∀ y (y ∊ lvals → lv ([[ x / t ]] A) y = lv ([[ x / t ]] B) y) $ by iff_refl

leqv_refl
---------
l1: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l2: $ leqv a a $ by leqv_i [l1]

leqv_symm
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ … ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ … ⇒ lv (enc_lvl b) x = lv (enc_lvl a) x $ by eq_sym [l2]
l4: $ leqv b a $ by leqv_i [l3]

leqv_trans
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ … ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ … ⇒ lv (enc_lvl b) x = lv (enc_lvl c) x $ by leqv_e [#2, l1]
l4: $ … ⇒ lv (enc_lvl a) x = lv (enc_lvl c) x $ by eq_trans [l2, l3]
l5: $ leqv a c $ by leqv_i [l4]

lemma k6_eq3 (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ B = D $ > $ G ⇒ A = C $
----
l1: $ … ⇒ A = D $ by eq_trans [#1, #3]
l2: $ … ⇒ D = C $ by eq_sym [#2]
l3: $ … ⇒ A = C $ by eq_trans [l1, l2]

lemma k6_lvo (G: hyps) (a: lvl) (w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ lv (enc_lvl a) w ∈ ω $
----
l1: $ G ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l2: $ … ⇒ isset (enc_lvl a) $ by wcel_isset [l1]
l3: $ … ⇒ lv (enc_lvl a) w ∈ ω $ by lv_omega [l2, #1]

leqv_succ
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ … ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l4: $ … ⇒ lv (enc_lvl (ls a)) x = suc (lv (enc_lvl a) x) $ by lv_ls [l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l6: $ … ⇒ lv (enc_lvl (ls b)) x = suc (lv (enc_lvl b) x) $ by lv_ls [l5, l1]
l7: $ … ⇒ suc (lv (enc_lvl a) x) = suc (lv (enc_lvl b) x) $ by suc_eq [l2]
l8: $ … ⇒ lv (enc_lvl (ls a)) x = lv (enc_lvl (ls b)) x $ by k6_eq3 [l4, l6, l7]
l9: $ leqv (ls a) (ls b) $ by leqv_i [l8]

leqv_max
--------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ … ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ … ⇒ lv (enc_lvl c) x = lv (enc_lvl d) x $ by leqv_e [#2, l1]
l4: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l5: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l6: $ … ⇒ lv (enc_lvl (lmax a c)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl c) x) $ by lv_lmax [l4, l5, l1]
l7: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l8: $ x ∊ lvals ⇒ enc_lvl d ∈ trees ω $ by enc_lvl_trees
l9: $ … ⇒ lv (enc_lvl (lmax b d)) x = nmax (lv (enc_lvl b) x) (lv (enc_lvl d) x) $ by lv_lmax [l7, l8, l1]
l10: $ … ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl c) x) = nmax (lv (enc_lvl b) x) (lv (enc_lvl d) x) $ by nmax_eq [l2, l3]
l11: $ … ⇒ lv (enc_lvl (lmax a c)) x = lv (enc_lvl (lmax b d)) x $ by k6_eq3 [l6, l9, l10]
l12: $ leqv (lmax a c) (lmax b d) $ by leqv_i [l11]

leqv_imax
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ … ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ … ⇒ lv (enc_lvl c) x = lv (enc_lvl d) x $ by leqv_e [#2, l1]
l4: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l5: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l6: $ … ⇒ lv (enc_lvl (limax a c)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x) $ by lv_limax [l4, l5, l1]
l7: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l8: $ x ∊ lvals ⇒ enc_lvl d ∈ trees ω $ by enc_lvl_trees
l9: $ … ⇒ lv (enc_lvl (limax b d)) x = nimax (lv (enc_lvl b) x) (lv (enc_lvl d) x) $ by lv_limax [l7, l8, l1]
l10: $ … ⇒ nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x) = nimax (lv (enc_lvl b) x) (lv (enc_lvl d) x) $ by nimax_eq [l2, l3]
l11: $ … ⇒ lv (enc_lvl (limax a c)) x = lv (enc_lvl (limax b d)) x $ by k6_eq3 [l6, l9, l10]
l12: $ leqv (limax a c) (limax b d) $ by leqv_i [l11]

lmax_comm
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l4: $ … ⇒ lv (enc_lvl (lmax a b)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x) $ by lv_lmax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l7: $ … ⇒ lv (enc_lvl (lmax b a)) x = nmax (lv (enc_lvl b) x) (lv (enc_lvl a) x) $ by lv_lmax [l5, l6, l1]
l10: $ x ∊ lvals ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x) = nmax (lv (enc_lvl b) x) (lv (enc_lvl a) x) $ by nmax_comm_c
l11: $ … ⇒ lv (enc_lvl (lmax a b)) x = lv (enc_lvl (lmax b a)) x $ by k6_eq3 [l4, l7, l10]
l12: $ leqv (lmax a b) (lmax b a) $ by leqv_i [l11]

lmax_assoc
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl (lmax a b) ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l4: $ … ⇒ lv (enc_lvl (lmax (lmax a b) c)) x = nmax (lv (enc_lvl (lmax a b)) x) (lv (enc_lvl c) x) $ by lv_lmax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l7: $ … ⇒ lv (enc_lvl (lmax a b)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x) $ by lv_lmax [l5, l6, l1]
l8: $ x ∊ lvals ⇒ lv (enc_lvl c) x = lv (enc_lvl c) x $ by eq_refl
l9: $ … ⇒ nmax (lv (enc_lvl (lmax a b)) x) (lv (enc_lvl c) x) = nmax (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (lv (enc_lvl c) x) $ by nmax_eq [l7, l8]
l10: $ … ⇒ lv (enc_lvl (lmax (lmax a b) c)) x = nmax (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (lv (enc_lvl c) x) $ by eq_trans [l4, l9]
l11: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l12: $ x ∊ lvals ⇒ enc_lvl (lmax b c) ∈ trees ω $ by enc_lvl_trees
l13: $ … ⇒ lv (enc_lvl (lmax a (lmax b c))) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl (lmax b c)) x) $ by lv_lmax [l11, l12, l1]
l14: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l15: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l16: $ … ⇒ lv (enc_lvl (lmax b c)) x = nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x) $ by lv_lmax [l14, l15, l1]
l17: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l18: $ … ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl (lmax b c)) x) = nmax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nmax_eq [l17, l16]
l19: $ … ⇒ lv (enc_lvl (lmax a (lmax b c))) x = nmax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by eq_trans [l13, l18]
l23: $ x ∊ lvals ⇒ nmax (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (lv (enc_lvl c) x) = nmax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nmax_assoc_c
l24: $ … ⇒ lv (enc_lvl (lmax (lmax a b) c)) x = lv (enc_lvl (lmax a (lmax b c))) x $ by k6_eq3 [l10, l19, l23]
l25: $ leqv (lmax (lmax a b) c) (lmax a (lmax b c)) $ by leqv_i [l24]

