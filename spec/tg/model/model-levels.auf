l15: $ … ⇒ lv q f = ap (lsub e) (nvf' n) $ by eq_trans [l14, l10]
l16: $ … ⇒ lv q f = e' nvf' n $ by eq_trans [l15, l13]
l17: $ … ⇒ e' nvf' n = lv q f $ by eq_sym [l16]
l18: $ … ⇒ lv z w = lv q f $ by eq_trans [#5, l17]

lemma k5_cs_ne (G: hyps) (q z m w f i j: set):
  $ G ⇒ q = ⟨ kc_lparam , m +: ∅ ⟩ $ > $ G ⇒ z = ⟨ kc_lparam , m +: ∅ ⟩ $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ f = lupd w i j $ > $ G ⇒ f ∊ lvals $ > $ G ⇒ ¬ nvf' m = i $ > $ G ⇒ lv z w = lv q f $
----
l1: $ … ⇒ ⟨ kc_lparam , m +: ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #3]
l2: $ G ⇒ kc_lparam ∈ ω $ by kc_lparam_omega
l3: $ … ⇒ isset kc_lparam $ by wcel_isset [l2]
l4: $ … ⇒ m ∊ trees ω $ by k5_ch1 [l1, l3]
l5: $ … ⇒ m ∈ trees ω $ by welc_wcel [l4]
l6: $ G ⇒ w = w $ by eq_refl
l7: $ G ⇒ f = f $ by eq_refl
l8: $ … ⇒ lv ⟨ kc_lparam , m +: ∅ ⟩ w = ap w (nvf' m) $ by lv_lparam [l5, #4]
l9: $ … ⇒ lv z w = lv ⟨ kc_lparam , m +: ∅ ⟩ w $ by lv_eq [#2, l6]
l10: $ … ⇒ lv ⟨ kc_lparam , m +: ∅ ⟩ f = ap f (nvf' m) $ by lv_lparam [l5, #6]
l11: $ … ⇒ lv q f = lv ⟨ kc_lparam , m +: ∅ ⟩ f $ by lv_eq [#1, l7]
l12: $ G ⇒ nvf' m = nvf' m $ by eq_refl
l13: $ … ⇒ ap f (nvf' m) = ap (lupd w i j) (nvf' m) $ by ap_eq [#5, l12]
l14: $ G ⇒ isset m $ by isset_var
l15: $ … ⇒ nvf' m ∈ ω $ by nvf_omega [l14]
l16: $ … ⇒ ap (lupd w i j) (nvf' m) = ap w (nvf' m) $ by lupd_ap_ne_c [l15, #7]
l17: $ … ⇒ lv z w = ap w (nvf' m) $ by eq_trans [l9, l8]
l18: $ … ⇒ lv q f = ap f (nvf' m) $ by eq_trans [l11, l10]
l19: $ … ⇒ lv q f = ap (lupd w i j) (nvf' m) $ by eq_trans [l18, l13]
l20: $ … ⇒ lv q f = ap w (nvf' m) $ by eq_trans [l19, l16]
l21: $ … ⇒ ap w (nvf' m) = lv q f $ by eq_sym [l20]
l22: $ … ⇒ lv z w = lv q f $ by eq_trans [l17, l21]

lemma k5_cs_eq (G: hyps) (q z n u w f i j: set):
  $ G ⇒ q = ⟨ kc_lparam , n +: ∅ ⟩ $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ f = lupd w i j $ > $ G ⇒ f ∊ lvals $ > $ G ⇒ i ∊ ω $ > $ G ⇒ nvf' n = i $ > $ G ⇒ z = u $ > $ G ⇒ j = lv u w $ > $ G ⇒ lv z w = lv q f $
----
l1: $ … ⇒ ⟨ kc_lparam , n +: ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #2]
l2: $ G ⇒ kc_lparam ∈ ω $ by kc_lparam_omega
l3: $ … ⇒ isset kc_lparam $ by wcel_isset [l2]
l4: $ … ⇒ n ∊ trees ω $ by k5_ch1 [l1, l3]
l5: $ … ⇒ n ∈ trees ω $ by welc_wcel [l4]
l6: $ G ⇒ w = w $ by eq_refl
l7: $ G ⇒ f = f $ by eq_refl
l8: $ … ⇒ lv ⟨ kc_lparam , n +: ∅ ⟩ f = ap f (nvf' n) $ by lv_lparam [l5, #4]
l9: $ … ⇒ lv q f = lv ⟨ kc_lparam , n +: ∅ ⟩ f $ by lv_eq [#1, l7]
l10: $ G ⇒ nvf' n = nvf' n $ by eq_refl
l11: $ … ⇒ ap f (nvf' n) = ap (lupd w i j) (nvf' n) $ by ap_eq [#3, l10]
l12: $ G ⇒ lupd w i j = lupd w i j $ by eq_refl
l13: $ … ⇒ ap (lupd w i j) (nvf' n) = ap (lupd w i j) i $ by ap_eq [l12, #6]
l14: $ … ⇒ ap (lupd w i j) i = j $ by lupd_ap_eq [#5]
l15: $ … ⇒ lv q f = ap f (nvf' n) $ by eq_trans [l9, l8]
l16: $ … ⇒ lv q f = ap (lupd w i j) (nvf' n) $ by eq_trans [l15, l11]
l17: $ … ⇒ lv q f = ap (lupd w i j) i $ by eq_trans [l16, l13]
l18: $ … ⇒ lv q f = j $ by eq_trans [l17, l14]
l19: $ … ⇒ lv z w = lv u w $ by lv_eq [#7, l6]
l20: $ … ⇒ lv u w = j $ by eq_sym [#8]
l21: $ … ⇒ lv z w = j $ by eq_trans [l19, l20]
l22: $ … ⇒ j = lv q f $ by eq_sym [l18]
l23: $ … ⇒ lv z w = lv q f $ by eq_trans [l21, l22]

lemma k5_mv2 (G: hyps) (K A B D: class):
  $ G ⇒ ⟨ K , A +: B +: ∅ ⟩ ∈ lrel $ > $ G ⇒ A = D $ > $ G ⇒ ⟨ K , D +: B +: ∅ ⟩ ∈ lrel $
----
