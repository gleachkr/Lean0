lemma k5_cs_lz (G: hyps) (q z w f: set):
  $ G ⇒ q = ⟨ kc_lz , ∅ ⟩ $ > $ G ⇒ z = ⟨ kc_lz , ∅ ⟩ $ > $ G ⇒ lv z w = lv q f $
----
l1: $ G ⇒ w = w $ by eq_refl
l2: $ … ⇒ lv z w = lv ⟨ kc_lz , ∅ ⟩ w $ by lv_eq [#2, l1]
l3: $ G ⇒ lv ⟨ kc_lz , ∅ ⟩ w = ∅ $ by lv_lz
l4: $ G ⇒ f = f $ by eq_refl
l5: $ … ⇒ lv q f = lv ⟨ kc_lz , ∅ ⟩ f $ by lv_eq [#1, l4]
l6: $ G ⇒ lv ⟨ kc_lz , ∅ ⟩ f = ∅ $ by lv_lz
l7: $ … ⇒ lv z w = ∅ $ by eq_trans [l2, l3]
l8: $ … ⇒ lv q f = ∅ $ by eq_trans [l5, l6]
l9: $ … ⇒ ∅ = lv q f $ by eq_sym [l8]
l10: $ … ⇒ lv z w = lv q f $ by eq_trans [l7, l9]

lemma k5_cs_ls (G: hyps) (q z a b w f: set):
  $ G ⇒ q = ⟨ kc_ls , a +: ∅ ⟩ $ > $ G ⇒ z = ⟨ kc_ls , b +: ∅ ⟩ $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ f ∊ lvals $ > $ G ⇒ lv b w = lv a f $ > $ G ⇒ lv z w = lv q f $
----
l1: $ … ⇒ ⟨ kc_ls , a +: ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #3]
l2: $ G ⇒ kc_ls ∈ ω $ by kc_ls_omega
l3: $ … ⇒ isset kc_ls $ by wcel_isset [l2]
l4: $ … ⇒ a ∊ trees ω $ by k5_ch1 [l1, l3]
l5: $ … ⇒ a ∈ trees ω $ by welc_wcel [l4]
l6: $ … ⇒ ⟨ kc_ls , b +: ∅ ⟩ ∈ trees ω $ by wcel_intro [#2, #4]
l7: $ G ⇒ kc_ls ∈ ω $ by kc_ls_omega
l8: $ … ⇒ isset kc_ls $ by wcel_isset [l7]
l9: $ … ⇒ b ∊ trees ω $ by k5_ch1 [l6, l8]
l10: $ … ⇒ b ∈ trees ω $ by welc_wcel [l9]
l11: $ G ⇒ w = w $ by eq_refl
l12: $ G ⇒ f = f $ by eq_refl
l13: $ … ⇒ lv ⟨ kc_ls , b +: ∅ ⟩ w = suc (lv b w) $ by lv_ls [l10, #5]
l14: $ … ⇒ lv z w = lv ⟨ kc_ls , b +: ∅ ⟩ w $ by lv_eq [#2, l11]
l15: $ … ⇒ lv ⟨ kc_ls , a +: ∅ ⟩ f = suc (lv a f) $ by lv_ls [l5, #6]
l16: $ … ⇒ lv q f = lv ⟨ kc_ls , a +: ∅ ⟩ f $ by lv_eq [#1, l12]
l17: $ … ⇒ suc (lv b w) = suc (lv a f) $ by suc_eq [#7]
l18: $ … ⇒ lv z w = suc (lv b w) $ by eq_trans [l14, l13]
l19: $ … ⇒ lv z w = suc (lv a f) $ by eq_trans [l18, l17]
