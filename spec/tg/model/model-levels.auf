l26: $ (A = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ⟺ (B = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) $ by and_congr [l25, l23]
