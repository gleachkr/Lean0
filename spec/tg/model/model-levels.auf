l35: $ (A = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' C' ∅))) ⟺ (B = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' D' ∅))) $ by and_congr [l34, l32]
l36: $ ((A = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ∨ (A = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' C' ∅)))) ⟺ ((B = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) ∨ (B = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' D' ∅)))) $ by or_congr [l26, l35]
l37: $ ((A = kc_lmax ∧ z ∊ (λₛ x ∈ lvals, nmax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ∨ (A = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ∨ (A = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' C' ∅)))) ⟺ ((B = kc_lmax ∧ z ∊ (λₛ x ∈ lvals, nmax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) ∨ (B = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) ∨ (B = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' D' ∅)))) $ by or_congr [l20, l36]
l38: $ ((A = kc_ls ∧ z ∊ (λₛ x ∈ lvals, suc (ap (E' ∅) x))) ∨ (A = kc_lmax ∧ z ∊ (λₛ x ∈ lvals, nmax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ∨ (A = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ∨ (A = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' C' ∅)))) ⟺ ((B = kc_ls ∧ z ∊ (λₛ x ∈ lvals, suc (ap (F' ∅) x))) ∨ (B = kc_lmax ∧ z ∊ (λₛ x ∈ lvals, nmax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) ∨ (B = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) ∨ (B = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' D' ∅)))) $ by or_congr [l11, l37]
l39: $ {z | (A = kc_ls ∧ z ∊ (λₛ x ∈ lvals, suc (ap (E' ∅) x))) ∨ (A = kc_lmax ∧ z ∊ (λₛ x ∈ lvals, nmax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ∨ (A = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ∨ (A = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' C' ∅)))} ≐ {z | (B = kc_ls ∧ z ∊ (λₛ x ∈ lvals, suc (ap (F' ∅) x))) ∨ (B = kc_lmax ∧ z ∊ (λₛ x ∈ lvals, nmax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) ∨ (B = kc_limax ∧ z ∊ (λₛ x ∈ lvals, nimax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) ∨ (B = kc_lparam ∧ z ∊ (λₛ x ∈ lvals, ap x (nvf' D' ∅)))} $ by cab_congr [l38]

sb_c_lvb
--------
l1: $ ([[ x / t ]] {z | (A = kc_ls ∧ z ∊ (λₛ y ∈ lvals, suc (ap (C' ∅) y))) ∨ (A = kc_lmax ∧ z ∊ (λₛ y ∈ lvals, nmax (ap (C' ∅) y) (ap (C' (suc ∅)) y))) ∨ (A = kc_limax ∧ z ∊ (λₛ y ∈ lvals, nimax (ap (C' ∅) y) (ap (C' (suc ∅)) y))) ∨ (A = kc_lparam ∧ z ∊ (λₛ y ∈ lvals, ap y (nvf' B' ∅)))}) ≐ {z | (([[ x / t ]] A) = kc_ls ∧ z ∊ (λₛ y ∈ lvals, suc (ap (([[ x / t ]] C)' ∅) y))) ∨ (([[ x / t ]] A) = kc_lmax ∧ z ∊ (λₛ y ∈ lvals, nmax (ap (([[ x / t ]] C)' ∅) y) (ap (([[ x / t ]] C)' (suc ∅)) y))) ∨ (([[ x / t ]] A) = kc_limax ∧ z ∊ (λₛ y ∈ lvals, nimax (ap (([[ x / t ]] C)' ∅) y) (ap (([[ x / t ]] C)' (suc ∅)) y))) ∨ (([[ x / t ]] A) = kc_lparam ∧ z ∊ (λₛ y ∈ lvals, ap y (nvf' ([[ x / t ]] B)' ∅)))} $ by ceqt_refl

lv_congr
--------
l0: $ lvf ≐ lvf $ by ceqt_refl
l1: $ lvf' A ≐ lvf' B $ by fv_congr [l0, #1]
l2: $ ap (lvf' A) C ≐ ap (lvf' B) D $ by ap_congr [l1, #2]

lv_eq
-----
l0: $ G ⇒ lvf = lvf $ by eq_refl
l1: $ … ⇒ lvf' A = lvf' B $ by fv_eq [l0, #1]
l2: $ … ⇒ ap (lvf' A) C = ap (lvf' B) D $ by ap_eq [l1, #2]

sb_c_lv
-------
l1: $ ([[ x / t ]] (ap (lvf' A) B)) ≐ ap (lvf' ([[ x / t ]] A)) ([[ x / t ]] B) $ by ceqt_refl

lemma k4_nimax_sub (G: hyps) (A B: class): $ G ⇒ nimax A B ⊆ nmax A B $
----
l1: $ G , y ∊ nimax A B ⇒ y ∊ nimax A B $ by ax
l2: $ … ⇒ y ∊ nmax A B ∧ ∃ x (x ∊ B) $ by cab_elim [l1]
l3: $ … ⇒ y ∊ nmax A B $ by and_elim_l [l2]
l4: $ … ⇒ nimax A B ⊆ nmax A B $ by subset_intro [l3]

lvb_set
-------
a1v: $ G ⇒ isset v $ by isset_var
a1: $ … ⇒ isset (ap v ∅) $ by ap_set_c [a1v]
a2: $ … ⇒ isset (v' ∅) $ by cuni_set [a1]
a3v: $ G ⇒ isset v $ by isset_var
a3: $ … ⇒ isset (ap v (suc ∅)) $ by ap_set_c [a3v]
a4: $ … ⇒ isset (v' (suc ∅)) $ by cuni_set [a3]
b1: $ G , x ∊ lvals ⇒ isset (v' ∅) $ by weaken [a2]
b2: $ … ⇒ isset (ap (v' ∅) x) $ by ap_set [b1]
b3: $ … ⇒ isset (suc (ap (v' ∅) x)) $ by suc_set [b2]
b4: $ G , x ∊ lvals ⇒ isset (v' (suc ∅)) $ by weaken [a4]
b5: $ … ⇒ isset (ap (v' (suc ∅)) x) $ by ap_set [b4]
b6: $ … ⇒ isset (nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by cun_set [b2, b5]
b7: $ G , x ∊ lvals ⇒ nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x) ⊆ nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x) $ by k4_nimax_sub
b8: $ … ⇒ isset (nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by subset_isset [b6, b7]
b9v: $ G , x ∊ lvals ⇒ isset x $ by isset_var
b9: $ … ⇒ isset (ap x (nvf' S' ∅)) $ by ap_set_c [b9v]
c1: $ … ⇒ x ∊ lvals → isset (suc (ap (v' ∅) x)) $ by imp_intro [b3]
c2: $ … ⇒ ∀ x (x ∊ lvals → isset (suc (ap (v' ∅) x))) $ by all_intro [c1]
c3: $ … ⇒ x ∊ lvals → isset (nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by imp_intro [b6]
c4: $ … ⇒ ∀ x (x ∊ lvals → isset (nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) $ by all_intro [c3]
c5: $ … ⇒ x ∊ lvals → isset (nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by imp_intro [b8]
c6: $ … ⇒ ∀ x (x ∊ lvals → isset (nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) $ by all_intro [c5]
c7: $ … ⇒ x ∊ lvals → isset (ap x (nvf' S' ∅)) $ by imp_intro [b9]
c8: $ … ⇒ ∀ x (x ∊ lvals → isset (ap x (nvf' S' ∅))) $ by all_intro [c7]
d0: $ G ⇒ isset lvals $ by lvals_set
d1: $ … ⇒ isset (λₛ x ∈ lvals, suc (ap (v' ∅) x)) $ by clam_set [d0, c2]
d2: $ … ⇒ isset (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by clam_set [d0, c4]
d3: $ … ⇒ isset (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by clam_set [d0, c6]
d4: $ … ⇒ isset (λₛ x ∈ lvals, ap x (nvf' S' ∅)) $ by clam_set [d0, c8]
d5: $ … ⇒ isset ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) $ by cun_set [d3, d4]
d6: $ … ⇒ isset ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by cun_set [d2, d5]
d7: $ … ⇒ isset ((λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅))))) $ by cun_set [d1, d6]
e1: $ G , y ∊ lvb K S v ⇒ y ∊ lvb K S v $ by ax
e2: $ … ⇒ (K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x))) ∨ (K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) $ by cab_elim [e1]
f1: $ G , y ∊ lvb K S v , K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ⇒ K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) $ by ax
f2: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) $ by and_elim_r [f1]
f3: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by cun_intro_l [f2]
g1: $ G , y ∊ lvb K S v , K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ⇒ K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by ax
g2: $ … ⇒ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by and_elim_r [g1]
g3: $ … ⇒ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) $ by cun_intro_l [g2]
g4: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by cun_intro_r [g3]
h1: $ G , y ∊ lvb K S v , K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ⇒ K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by ax
h2: $ … ⇒ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) $ by and_elim_r [h1]
h3: $ … ⇒ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) $ by cun_intro_l [h2]
h4: $ … ⇒ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) $ by cun_intro_r [h3]
h5: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by cun_intro_r [h4]
i1: $ G , y ∊ lvb K S v , K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) ⇒ K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) $ by ax
i2: $ … ⇒ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) $ by and_elim_r [i1]
i3: $ … ⇒ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) $ by cun_intro_r [i2]
i4: $ … ⇒ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) $ by cun_intro_r [i3]
i5: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by cun_intro_r [i4]
j1: $ G , y ∊ lvb K S v , (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) ⇒ (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) $ by ax
h6: $ G , y ∊ lvb K S v , (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) , K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by weaken [h5]
i6: $ G , y ∊ lvb K S v , (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) , K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by weaken [i5]
j2: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by or_elim [j1, h6, i6]
j3: $ G , y ∊ lvb K S v , (K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) ⇒ (K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) $ by ax
g5: $ G , y ∊ lvb K S v , (K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) , K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by weaken [g4]
j2b: $ G , y ∊ lvb K S v , (K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) , (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by weaken [j2]
j4: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by or_elim [j3, g5, j2b]
j5: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by or_elim [e2, f3, j4]
j6: $ … ⇒ lvb K S v ⊆ (λₛ x ∈ lvals, suc (ap (v' ∅) x)) ∪ ((λₛ x ∈ lvals, nmax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ ((λₛ x ∈ lvals, nimax (ap (v' ∅) x) (ap (v' (suc ∅)) x)) ∪ (λₛ x ∈ lvals, ap x (nvf' S' ∅)))) $ by subset_intro [j5]
j7: $ … ⇒ isset (lvb K S v) $ by subset_isset [d7, j6]

--| A four-way case split.
lemma k4_or4 (G: hyps) (p1 p2 p3 p4 c: fml): $ G ⇒ p1 ∨ p2 ∨ p3 ∨ p4 $ > $ G , p1 ⇒ c $ > $ G , p2 ⇒ c $ > $ G , p3 ⇒ c $ > $ G , p4 ⇒ c $ > $ G ⇒ c $
----
l1: $ G , p3 ∨ p4 , p3 ⇒ c $ by weaken [#4]
l2: $ G , p3 ∨ p4 , p4 ⇒ c $ by weaken [#5]
l3: $ G , p3 ∨ p4 ⇒ p3 ∨ p4 $ by ax
l4: $ … ⇒ c $ by or_elim [l3, l1, l2]
l5: $ G , p2 ∨ p3 ∨ p4 , p2 ⇒ c $ by weaken [#3]
l6: $ G , p2 ∨ p3 ∨ p4 , p3 ∨ p4 ⇒ c $ by weaken [l4]
l7: $ G , p2 ∨ p3 ∨ p4 ⇒ p2 ∨ p3 ∨ p4 $ by ax
l8: $ … ⇒ c $ by or_elim [l7, l5, l6]
l9: $ … ⇒ c $ by or_elim [#1, #2, l8]

lemma k4_lvb_sub (G: hyps) (K K2 S S2 A B: class): $ G ⇒ K = K2 $ > $ G ⇒ S = S2 $ > $ G ⇒ A = B $ > $ G ⇒ lvb K S A ⊆ lvb K2 S2 B $
----
e0: $ G ⇒ ∅ = ∅ $ by eq_refl
e1: $ … ⇒ A' ∅ = B' ∅ $ by fv_eq [#3, e0]
e2: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
e3: $ … ⇒ A' (suc ∅) = B' (suc ∅) $ by fv_eq [#3, e2]
e4: $ … ⇒ S' ∅ = S2' ∅ $ by fv_eq [#2, e0]
e5: $ G ⇒ nvf = nvf $ by eq_refl
e6: $ … ⇒ nvf' S' ∅ = nvf' S2' ∅ $ by fv_eq [e5, e4]
f0: $ G , x ∊ lvals ⇒ x = x $ by eq_refl
f1: $ G , x ∊ lvals ⇒ A' ∅ = B' ∅ $ by weaken [e1]
f2: $ … ⇒ ap (A' ∅) x = ap (B' ∅) x $ by ap_eq [f1, f0]
f3: $ G , x ∊ lvals ⇒ A' (suc ∅) = B' (suc ∅) $ by weaken [e3]
f4: $ … ⇒ ap (A' (suc ∅)) x = ap (B' (suc ∅)) x $ by ap_eq [f3, f0]
f5: $ … ⇒ suc (ap (A' ∅) x) = suc (ap (B' ∅) x) $ by suc_eq [f2]
f6: $ … ⇒ nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x) = nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x) $ by nmax_eq [f2, f4]
f7: $ … ⇒ nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x) = nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x) $ by nimax_eq [f2, f4]
f8: $ G , x ∊ lvals ⇒ nvf' S' ∅ = nvf' S2' ∅ $ by weaken [e6]
f9: $ … ⇒ ap x (nvf' S' ∅) = ap x (nvf' S2' ∅) $ by ap_eq [f0, f8]
g1: $ … ⇒ x ∊ lvals → suc (ap (A' ∅) x) = suc (ap (B' ∅) x) $ by imp_intro [f5]
g2: $ … ⇒ ∀ x (x ∊ lvals → suc (ap (A' ∅) x) = suc (ap (B' ∅) x)) $ by all_intro [g1]
g3: $ … ⇒ x ∊ lvals → nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x) = nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x) $ by imp_intro [f6]
g4: $ … ⇒ ∀ x (x ∊ lvals → nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x) = nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by all_intro [g3]
g5: $ … ⇒ x ∊ lvals → nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x) = nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x) $ by imp_intro [f7]
g6: $ … ⇒ ∀ x (x ∊ lvals → nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x) = nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by all_intro [g5]
g7: $ … ⇒ x ∊ lvals → ap x (nvf' S' ∅) = ap x (nvf' S2' ∅) $ by imp_intro [f9]
g8: $ … ⇒ ∀ x (x ∊ lvals → ap x (nvf' S' ∅) = ap x (nvf' S2' ∅)) $ by all_intro [g7]
h1: $ … ⇒ (λₛ x ∈ lvals, suc (ap (A' ∅) x)) = (λₛ x ∈ lvals, suc (ap (B' ∅) x)) $ by clam_eq_body [g2]
h2: $ … ⇒ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) = (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by clam_eq_body [g4]
h3: $ … ⇒ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) = (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by clam_eq_body [g6]
h4: $ … ⇒ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) = (λₛ x ∈ lvals, ap x (nvf' S2' ∅)) $ by clam_eq_body [g8]
h5: $ … ⇒ K2 = K $ by eq_sym [#1]
i1: $ G , y ∊ lvb K S A ⇒ y ∊ lvb K S A $ by ax
i2: $ … ⇒ (K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (A' ∅) x))) ∨ (K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅))) $ by cab_elim [i1]
j0a: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (A' ∅) x)) ⇒ K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (A' ∅) x)) $ by ax
j0b: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (A' ∅) x)) $ by and_elim_r [j0a]
j0c: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (A' ∅) x)) ⇒ (λₛ x ∈ lvals, suc (ap (A' ∅) x)) = (λₛ x ∈ lvals, suc (ap (B' ∅) x)) $ by weaken [h1]
j0d: $ … ⇒ y ∊ (λₛ x ∈ lvals, suc (ap (B' ∅) x)) $ by welc_eq [j0c, j0b]
j0e: $ … ⇒ K = kc_ls $ by and_elim_l [j0a]
j0e1: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (A' ∅) x)) ⇒ K2 = K $ by weaken [h5]
j0e2: $ … ⇒ K2 = kc_ls $ by eq_trans [j0e1, j0e]
j0f: $ … ⇒ K2 = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (B' ∅) x)) $ by and_intro [j0e2, j0d]
j0g: $ … ⇒ (K2 = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (B' ∅) x))) ∨ (K2 = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_l [j0f]
j0h: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (A' ∅) x)) ⇒ y ∊ lvb K2 S2 B $ by cab_intro [j0g]
j1a: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) ⇒ K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) $ by ax
j1b: $ … ⇒ y ∊ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) $ by and_elim_r [j1a]
j1c: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) ⇒ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) = (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by weaken [h2]
j1d: $ … ⇒ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by welc_eq [j1c, j1b]
j1e: $ … ⇒ K = kc_lmax $ by and_elim_l [j1a]
j1e1: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) ⇒ K2 = K $ by weaken [h5]
j1e2: $ … ⇒ K2 = kc_lmax $ by eq_trans [j1e1, j1e]
j1f: $ … ⇒ K2 = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by and_intro [j1e2, j1d]
j1g0: $ … ⇒ (K2 = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_l [j1f]
j1g: $ … ⇒ (K2 = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (B' ∅) x))) ∨ (K2 = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_r [j1g0]
j1h: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) ⇒ y ∊ lvb K2 S2 B $ by cab_intro [j1g]
j2a: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) ⇒ K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) $ by ax
j2b: $ … ⇒ y ∊ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) $ by and_elim_r [j2a]
j2c: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) ⇒ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) = (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by weaken [h3]
j2d: $ … ⇒ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by welc_eq [j2c, j2b]
j2e: $ … ⇒ K = kc_limax $ by and_elim_l [j2a]
j2e1: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) ⇒ K2 = K $ by weaken [h5]
j2e2: $ … ⇒ K2 = kc_limax $ by eq_trans [j2e1, j2e]
j2f: $ … ⇒ K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x)) $ by and_intro [j2e2, j2d]
j2g00: $ … ⇒ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_l [j2f]
j2g0: $ … ⇒ (K2 = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_r [j2g00]
j2g: $ … ⇒ (K2 = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (B' ∅) x))) ∨ (K2 = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_r [j2g0]
j2h: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (A' ∅) x) (ap (A' (suc ∅)) x)) ⇒ y ∊ lvb K2 S2 B $ by cab_intro [j2g]
j3a: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) ⇒ K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) $ by ax
j3b: $ … ⇒ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) $ by and_elim_r [j3a]
j3c: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) ⇒ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) = (λₛ x ∈ lvals, ap x (nvf' S2' ∅)) $ by weaken [h4]
j3d: $ … ⇒ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅)) $ by welc_eq [j3c, j3b]
j3e: $ … ⇒ K = kc_lparam $ by and_elim_l [j3a]
j3e1: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) ⇒ K2 = K $ by weaken [h5]
j3e2: $ … ⇒ K2 = kc_lparam $ by eq_trans [j3e1, j3e]
j3f: $ … ⇒ K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅)) $ by and_intro [j3e2, j3d]
j3g00: $ … ⇒ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_r [j3f]
j3g0: $ … ⇒ (K2 = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_r [j3g00]
j3g: $ … ⇒ (K2 = kc_ls ∧ y ∊ (λₛ x ∈ lvals, suc (ap (B' ∅) x))) ∨ (K2 = kc_lmax ∧ y ∊ (λₛ x ∈ lvals, nmax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ (λₛ x ∈ lvals, nimax (ap (B' ∅) x) (ap (B' (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S2' ∅))) $ by or_intro_r [j3g0]
j3h: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ (λₛ x ∈ lvals, ap x (nvf' S' ∅)) ⇒ y ∊ lvb K2 S2 B $ by cab_intro [j3g]
k1: $ … ⇒ y ∊ lvb K2 S2 B $ by k4_or4 [i2, j0h, j1h, j2h, j3h]
k2: $ … ⇒ lvb K S A ⊆ lvb K2 S2 B $ by subset_intro [k1]

lvb_eq
------
l1: $ … ⇒ lvb K S A ⊆ lvb K2 S2 B $ by k4_lvb_sub [#1, #2, #3]
l2: $ … ⇒ K2 = K $ by eq_sym [#1]
l3: $ … ⇒ S2 = S $ by eq_sym [#2]
l4: $ … ⇒ B = A $ by eq_sym [#3]
l5: $ … ⇒ lvb K2 S2 B ⊆ lvb K S A $ by k4_lvb_sub [l2, l3, l4]
l6: $ … ⇒ lvb K S A = lvb K2 S2 B $ by subset_antisym [l1, l5]

lvf_functional
--------------
l1: $ G ⇒ functional (cgr3 k j v (lvb k j v)) $ by cgr3_functional
l2o: $ G ⇒ isset ω $ by omega_set
l2: $ … ⇒ functional lvf $ by trc_functional_c [l2o, l1]

lvf_node
--------
m0: $ G ⇒ functional lvf $ by lvf_functional
m1: $ G ⇒ isset s $ by isset_var
m2: $ … ⇒ isset (ccom lvf s) $ by ccom_set [m0, m1]
m3: $ G ⇒ functional (cgr3 i j v (lvb i j v)) $ by cgr3_functional
m4o: $ G ⇒ isset ω $ by omega_set
m4: $ … ⇒ lvf' ⟨ k , s ⟩ = (cgr3 i j v (lvb i j v))' ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ $ by trc_node_c [m4o, m3, #1, #2]
n1: $ G , u = ccom lvf s ⇒ isset (lvb k s u) $ by lvb_set
n2: $ G , u = ccom lvf s ⇒ (cgr3 i j v (lvb i j v))' ⟨ k , ⟨ s , u ⟩ ⟩ = lvb k s u $ by fv_cgr3 [n1]
n3: $ G , u = ccom lvf s ⇒ u = ccom lvf s $ by ax
n4: $ G , u = ccom lvf s ⇒ s = s $ by eq_refl
n5: $ … ⇒ ⟨ s , u ⟩ = ⟨ s , ccom lvf s ⟩ $ by opair_eq [n4, n3]
n6: $ G , u = ccom lvf s ⇒ k = k $ by eq_refl
n7: $ … ⇒ ⟨ k , ⟨ s , u ⟩ ⟩ = ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ $ by opair_eq [n6, n5]
n8: $ G , u = ccom lvf s ⇒ cgr3 i j v (lvb i j v) = cgr3 i j v (lvb i j v) $ by eq_refl
n9: $ … ⇒ (cgr3 i j v (lvb i j v))' ⟨ k , ⟨ s , u ⟩ ⟩ = (cgr3 i j v (lvb i j v))' ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ $ by fv_eq [n8, n7]
n10: $ … ⇒ (cgr3 i j v (lvb i j v))' ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ = (cgr3 i j v (lvb i j v))' ⟨ k , ⟨ s , u ⟩ ⟩ $ by eq_sym [n9]
n11: $ … ⇒ (cgr3 i j v (lvb i j v))' ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ = lvb k s u $ by eq_trans [n10, n2]
n12: $ … ⇒ lvb k s u = lvb k s (ccom lvf s) $ by lvb_eq [n6, n4, n3]
n13: $ G , u = ccom lvf s ⇒ lvf' ⟨ k , s ⟩ = (cgr3 i j v (lvb i j v))' ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ $ by weaken [m4]
n14: $ … ⇒ lvf' ⟨ k , s ⟩ = lvb k s u $ by eq_trans [n13, n11]
n15: $ … ⇒ lvf' ⟨ k , s ⟩ = lvb k s (ccom lvf s) $ by eq_trans [n14, n12]
n16: $ … ⇒ lvf' ⟨ k , s ⟩ = lvb k s (ccom lvf s) $ by isset_elim [m2, n15]

--| The values of a function at the first two components of a sequence.
lemma k4_ch0 (G: hyps) (F T S: class): $ G ⇒ functional F $ > $ G ⇒ T ∈ cdm F $ > $ G ⇒ isset S $ > $ G ⇒ (ccom F (T +: S))' ∅ = F' T $
----
l1: $ … ⇒ ccom F (T +: S) = F' T +: ccom F S $ by ccom_scons_c [#1, #2, #3]
l2: $ G ⇒ ∅ = ∅ $ by eq_refl
l3: $ … ⇒ (ccom F (T +: S))' ∅ = (F' T +: ccom F S)' ∅ $ by fv_eq [l1, l2]
l4: $ … ⇒ isset T $ by wcel_isset [#2]
l5: $ … ⇒ isset (F' T) $ by fv_set_c [#1, l4]
l6: $ … ⇒ isset (ccom F S) $ by ccom_set [#1, #3]
l7: $ … ⇒ (F' T +: ccom F S)' ∅ = F' T $ by scons_fv_zero_c [l5, l6]
l8: $ … ⇒ (ccom F (T +: S))' ∅ = F' T $ by eq_trans [l3, l7]

lemma k4_ch1 (G: hyps) (F T T2 S: class): $ G ⇒ functional F $ > $ G ⇒ T ∈ cdm F $ > $ G ⇒ T2 ∈ cdm F $ > $ G ⇒ isset S $ > $ G ⇒ isset (T2 +: S) $ > $ G ⇒ (ccom F (T +: T2 +: S))' (suc ∅) = F' T2 $
----
l1: $ … ⇒ ccom F (T +: T2 +: S) = F' T +: ccom F (T2 +: S) $ by ccom_scons_c [#1, #2, #5]
l2: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l3: $ … ⇒ (ccom F (T +: T2 +: S))' (suc ∅) = (F' T +: ccom F (T2 +: S))' (suc ∅) $ by fv_eq [l1, l2]
l4: $ … ⇒ isset T $ by wcel_isset [#2]
l5: $ … ⇒ isset (F' T) $ by fv_set_c [#1, l4]
l6: $ … ⇒ isset (ccom F (T2 +: S)) $ by ccom_set [#1, #5]
l7e: $ G ⇒ isset ∅ $ by ax_empty
l7: $ … ⇒ (F' T +: ccom F (T2 +: S))' (suc ∅) = (ccom F (T2 +: S))' ∅ $ by scons_fv_suc_c [l5, l6, l7e]
