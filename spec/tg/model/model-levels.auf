h18: $ … ⇒ nvf' (enc_nat j) = nvf' (enc_nat i) + nvf' (enc_nat n) $ by isset_elim [l7, h17]
h19: $ … ⇒ nvf' (enc_nat j) = nvf' (enc_nat i) + nvf' (enc_nat n) $ by isset_elim [l5, h18]
