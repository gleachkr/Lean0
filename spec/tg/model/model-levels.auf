-- Proofs for model-levels.mm0.

lsig_ofsort_trees
-----------------
l1: $ G ⇒ sig lsig lopen $ by lsig_sig
l2: $ … ⇒ ofsort lsig lopen K ⊆ trees ω $ by ofsort_trees [l1]
l3: $ … ⇒ t ∊ trees ω $ by subset_elim [l2, #1]
l4: $ … ⇒ t ∈ trees ω $ by welc_wcel [l3]

lemma a0_app_sorted (G: hyps) (z e a: set): $ G ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ z = ⟨ kc_app , e +: a +: ∅ ⟩ $ > $ G ⇒ e ∊ ofsort lsig lopen ks_expr ∧ a ∊ ofsort lsig lopen ks_expr $
----
