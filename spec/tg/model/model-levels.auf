lemma k5_cs_pi (G: hyps) (q z n e f w: set):
  $ G ⇒ q = ⟨ kc_lparam , n +: ∅ ⟩ $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ f = lsub e $ > $ G ⇒ f ∊ lvals $ > $ G ⇒ lv z w = e' nvf' n $ > $ G ⇒ lv z w = lv q f $
----
l1: $ … ⇒ ⟨ kc_lparam , n +: ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #2]
l2: $ G ⇒ kc_lparam ∈ ω $ by kc_lparam_omega
