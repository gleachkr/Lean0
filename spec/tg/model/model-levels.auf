h2: $ G , a = enc_nat i , b = enc_nat n ⇒ b = enc_nat n $ by ax
h3: $ G , a = enc_nat i , b = enc_nat n ⇒ ∅ = ∅ $ by eq_refl
h4: $ … ⇒ b +: ∅ = enc_nat n +: ∅ $ by scons_eq [h2, h3]
