l6: $ ∃ y (y ∊ C) ⟺ ∃ y (y ∊ D) $ by ex_congr [l5]
l7: $ (x ∊ nmax A C ∧ ∃ y (y ∊ C)) ⟺ (x ∊ nmax B D ∧ ∃ y (y ∊ D)) $ by and_congr [l3, l6]
l8: $ {x | x ∊ nmax A C ∧ ∃ y (y ∊ C)} ≐ {x | x ∊ nmax B D ∧ ∃ y (y ∊ D)} $ by cab_congr [l7]

lemma k1_welc_nimax_eq (G: hyps) (A B C D: class) (a: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ a ∊ nimax A C $ > $ G ⇒ a ∊ nimax B D $
----
l1: $ … ⇒ a ∊ nmax A C ∧ ∃ y (y ∊ C) $ by cab_elim [#3]
l2: $ … ⇒ a ∊ nmax A C $ by and_elim_l [l1]
l3: $ … ⇒ nmax A C = nmax B D $ by nmax_eq [#1, #2]
l4: $ … ⇒ a ∊ nmax B D $ by welc_eq [l3, l2]
l5: $ … ⇒ ∃ y (y ∊ C) $ by and_elim_r [l1]
l6: $ G , y ∊ C ⇒ y ∊ C $ by ax
l7: $ G , y ∊ C ⇒ C = D $ by weaken [#2]
l8: $ … ⇒ y ∊ D $ by welc_eq [l7, l6]
l9: $ … ⇒ y ∊ C → y ∊ D $ by imp_intro [l8]
l10: $ … ⇒ ∀ y (y ∊ C → y ∊ D) $ by all_intro [l9]
l11: $ … ⇒ ∃ y (y ∊ D) $ by ex_mp [l10, l5]
l12: $ … ⇒ a ∊ nmax B D ∧ ∃ y (y ∊ D) $ by and_intro [l4, l11]
l13: $ G ⇒ a ∊ nimax B D $ by cab_intro [l12]

nimax_eq
--------
l1: $ G , u ∊ nimax A C ⇒ u ∊ nimax A C $ by ax
l2: $ G , u ∊ nimax A C ⇒ A = B $ by weaken [#1]
l3: $ G , u ∊ nimax A C ⇒ C = D $ by weaken [#2]
l4: $ … ⇒ u ∊ nimax B D $ by k1_welc_nimax_eq [l2, l3, l1]
l5: $ … ⇒ B = A $ by eq_sym [#1]
l6: $ … ⇒ D = C $ by eq_sym [#2]
l7: $ G , u ∊ nimax B D ⇒ u ∊ nimax B D $ by ax
l8: $ G , u ∊ nimax B D ⇒ B = A $ by weaken [l5]
l9: $ G , u ∊ nimax B D ⇒ D = C $ by weaken [l6]
l10: $ … ⇒ u ∊ nimax A C $ by k1_welc_nimax_eq [l8, l9, l7]
l11: $ … ⇒ nimax A C = nimax B D $ by eq_intro [l4, l10]

