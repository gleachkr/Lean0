c10: $ … ⇒ x = a ∧ y = p $ by scons2_inj [c10a, c10c, c10b, c10d, c9]
c11: $ … ⇒ x = a $ by and_elim_l [c10]
c12: $ … ⇒ y = p $ by and_elim_r [c10]
