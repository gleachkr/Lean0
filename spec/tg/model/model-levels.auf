l12: $ … ⇒ lv (enc_lvl (limax (ls lz) a)) x = nimax (suc ∅) (lv (enc_lvl a) x) $ by eq_trans [l4, l11]
l13: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l14: $ … ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l15: $ … ⇒ nimax (suc ∅) (lv (enc_lvl a) x) = lv (enc_lvl a) x $ by nimax_one_c [l14]
