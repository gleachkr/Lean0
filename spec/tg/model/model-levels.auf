c14: $ … ⇒ p ∊ ofsort lsig lopen ks_ctx $ by welc_eq_set [c12, c5]
c15: $ … ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by and_intro [c13, c14]
d1a: $ H , ∃ y (z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) ⇒ ∃ y (z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $ by ax
d1: $ … ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by ex_elim [d1a, c15]
d2a: $ H , ∃ x ∃ y (z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) ⇒ ∃ x ∃ y (z = ⟨ kc_cons , x +: y +: ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $ by ax
