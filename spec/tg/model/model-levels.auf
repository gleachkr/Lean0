l6: $ … ⇒ lv (enc_lvl (ls a)) x = suc (lv (enc_lvl a) x) $ by lv_ls [l5, l1]
l7: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l8: $ … ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl (ls a)) x) = nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl a) x)) $ by nmax_eq [l7, l6]
l9: $ … ⇒ lv (enc_lvl (lmax a (ls a))) x = nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl a) x)) $ by eq_trans [l4, l8]
l10: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
