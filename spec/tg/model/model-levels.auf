l11: $ G , e = lsv t1 w , f = lsub e ⇒ f = lsub e $ by ax
l12: $ … ⇒ lsub e = f $ by eq_sym [l11]
l13: $ G , e = lsv t1 w , f = lsub e ⇒ lsub e ∈ lvals $ by weaken [l9]
l14: $ … ⇒ f ∈ lvals $ by wcel_eq_l [l12, l13]
l15: $ … ⇒ f ∊ lvals $ by wcel_welc [l14]
l16: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , t1 +: x +: z +: ∅ ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , t1 +: q +: z +: ∅ ⟩ ∈ lrel ⇒ ⟨ kr_linst , t1 +: q +: z +: ∅ ⟩ ∈ lrel $ by ax
l17: $ … ⇒ ∃ u (t1 = u ∧ q = ⟨ kc_lz , ∅ ⟩ ∧ z = ⟨ kc_lz , ∅ ⟩) ∨ ∃ u ∃ a ∃ c (t1 = u ∧ q = ⟨ kc_ls , a +: ∅ ⟩ ∧ z = ⟨ kc_ls , c +: ∅ ⟩ ∧ ra_linst u a c ∈ lrel) ∨ ∃ u ∃ a ∃ b ∃ c ∃ d (t1 = u ∧ q = ⟨ kc_lmax , a +: b +: ∅ ⟩ ∧ z = ⟨ kc_lmax , c +: d +: ∅ ⟩ ∧ ra_linst u a c ∈ lrel ∧ ra_linst u b d ∈ lrel) ∨ ∃ u ∃ a ∃ b ∃ c ∃ d (t1 = u ∧ q = ⟨ kc_limax , a +: b +: ∅ ⟩ ∧ z = ⟨ kc_limax , c +: d +: ∅ ⟩ ∧ ra_linst u a c ∈ lrel ∧ ra_linst u b d ∈ lrel) ∨ ∃ u ∃ n ∃ a (t1 = u ∧ q = ⟨ kc_lparam , n +: ∅ ⟩ ∧ z = a ∧ ra_lnth u n a ∈ lrel) $ by lrel_linst_cases [l16]
l18: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , t1 +: x +: z +: ∅ ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , t1 +: q +: z +: ∅ ⟩ ∈ lrel ⇒ kr_linst ∈ ω $ by kr_linst_omega
