d6: $ … ⇒ nmax a b = a $ by nmax_eq_l [d1]
d7: $ … ⇒ suc (nmax a b) = suc a $ by suc_eq [d6]
d8: $ … ⇒ suc a = suc (nmax a b) $ by eq_sym [d7]
