h12: $ … ⇒ nvf' z = nvf' ⟨ kc_s , n +: ∅ ⟩ $ by fv_eq [h3a, f4]
h13: $ … ⇒ nvf' z = suc (nvf' n) $ by eq_trans [h12, h2]
h14: $ … ⇒ nvf' y = nvf' i $ by fv_eq [h3a, f2]
h15: $ … ⇒ nvf' y + nvf' z = nvf' i + suc (nvf' n) $ by nadd_eq [h14, h13]
