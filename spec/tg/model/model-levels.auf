l5: $ … ⇒ nvf' r ⊆ nvf' n $ by lrel_le_sem [l4]
l6: $ G , r = ⟨ kc_s , m +: ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l7: $ … ⇒ nvf' r = nvf' ⟨ kc_s , m +: ∅ ⟩ $ by fv_eq [l6, l1]
l8: $ G , r = ⟨ kc_s , m +: ∅ ⟩ ⇒ m ∈ trees ω $ by weaken [#2]
l9: $ … ⇒ nvf' ⟨ kc_s , m +: ∅ ⟩ = suc (nvf' m) $ by nvf_s [l8]
l10: $ … ⇒ nvf' r = suc (nvf' m) $ by eq_trans [l7, l9]
l11: $ … ⇒ suc (nvf' m) ⊆ nvf' n $ by subset_eq_l [l10, l5]
l12: $ G , r = ⟨ kc_s , m +: ∅ ⟩ ⇒ nvf' n = i $ by weaken [#3]
l13: $ … ⇒ suc (nvf' m) ⊆ i $ by subset_eq_r [l12, l11]
l14: $ G , r = ⟨ kc_s , m +: ∅ ⟩ ⇒ isset m $ by isset_var
l15: $ … ⇒ nvf' m ∈ ω $ by nvf_omega [l14]
l16: $ … ⇒ isset (nvf' m) $ by wcel_isset [l15]
l17: $ … ⇒ ¬ nvf' m = i $ by k5_sne1 [l13, l16]
l18: $ G ⇒ isset ⟨ kc_s , m +: ∅ ⟩ $ by opair_isset
l19: $ … ⇒ ¬ nvf' m = i $ by isset_elim [l18, l17]

lemma k5_gt_ne (G: hyps) (m n i: set):
  $ G ⇒ ra_le ⟨ kc_s , n +: ∅ ⟩ m ∈ lrel $ > $ G ⇒ n ∈ trees ω $ > $ G ⇒ nvf' n = i $ > $ G ⇒ ¬ nvf' m = i $
