l19: $ G ⇒ isset ω $ by omega_set
l20: $ … ⇒ isset (λₛ i ∈ ω, s' i) $ by clam_set [l19, l18]
l21: $ … ⇒ (λₛ i ∈ ω, s' i) ∈ (Πₛ i ∈ ω, ω) $ by clam_cpi_intro [l20, l15]

lsub_ap
-------
l1: $ … ⇒ ap (λₛ j ∈ ω, s' j) i = s' i $ by clam_ap [#1]

lsub_ap_c
---------
l1: $ G , i = I , i ∊ ω ⇒ i ∊ ω $ by ax
l2: $ … ⇒ ap (lsub e) i = e' i $ by lsub_ap [l1]
l3: $ G , i = I , i ∊ ω ⇒ i = I $ by ax
l4: $ … ⇒ I = i $ by eq_sym [l3]
l5: $ G , i = I , i ∊ ω ⇒ lsub e = lsub e $ by eq_refl
l6: $ … ⇒ ap (lsub e) I = ap (lsub e) i $ by ap_eq [l5, l4]
l7: $ G , i = I , i ∊ ω ⇒ e = e $ by eq_refl
l8: $ … ⇒ e' i = e' I $ by fv_eq [l7, l3]
l9: $ … ⇒ ap (lsub e) I = e' i $ by eq_trans [l6, l2]
l10: $ … ⇒ ap (lsub e) I = e' I $ by eq_trans [l9, l8]
l11: $ … ⇒ ap (lsub e) I = e' I $ by wcel_elim [#1, l10]

nvb_congr
---------
l1: $ kc_s ≐ kc_s $ by ceqt_refl
l2: $ (A = kc_s) ⟺ (B = kc_s) $ by ceq_congr [#1, l1]
l3: $ kc_bd0 ≐ kc_bd0 $ by ceqt_refl
l4: $ (A = kc_bd0) ⟺ (B = kc_bd0) $ by ceq_congr [#1, l3]
l5: $ kc_bd1 ≐ kc_bd1 $ by ceqt_refl
l6: $ (A = kc_bd1) ⟺ (B = kc_bd1) $ by ceq_congr [#1, l5]
l7: $ ∅ ≐ ∅ $ by ceqt_refl
l8: $ C' ∅ ≐ D' ∅ $ by fv_congr [#2, l7]
l9: $ suc (C' ∅) ≐ suc (D' ∅) $ by suc_congr [l8]
l10: $ ndbl (C' ∅) ≐ ndbl (D' ∅) $ by ndbl_congr [l8]
l11: $ suc (ndbl (C' ∅)) ≐ suc (ndbl (D' ∅)) $ by suc_congr [l10]
l12: $ seqt z z $ by seqt_refl
l13: $ (z ∊ suc (C' ∅)) ⟺ (z ∊ suc (D' ∅)) $ by welc_congr [l12, l9]
l14: $ (z ∊ ndbl (C' ∅)) ⟺ (z ∊ ndbl (D' ∅)) $ by welc_congr [l12, l10]
l15: $ (z ∊ suc (ndbl (C' ∅))) ⟺ (z ∊ suc (ndbl (D' ∅))) $ by welc_congr [l12, l11]
l16: $ (A = kc_s ∧ z ∊ suc (C' ∅)) ⟺ (B = kc_s ∧ z ∊ suc (D' ∅)) $ by and_congr [l2, l13]
l17: $ (A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ⟺ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) $ by and_congr [l4, l14]
l18: $ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅))) ⟺ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by and_congr [l6, l15]
l19: $ ((A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅)))) ⟺ ((B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅)))) $ by or_congr [l17, l18]
l20: $ ((A = kc_s ∧ z ∊ suc (C' ∅)) ∨ (A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅)))) ⟺ ((B = kc_s ∧ z ∊ suc (D' ∅)) ∨ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅)))) $ by or_congr [l16, l19]
l21: $ {z | (A = kc_s ∧ z ∊ suc (C' ∅)) ∨ (A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅)))} ≐ {z | (B = kc_s ∧ z ∊ suc (D' ∅)) ∨ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅)))} $ by cab_congr [l20]

sb_c_nvb
--------
l1: $ ([[ x / t ]] {z | (A = kc_s ∧ z ∊ suc (B' ∅)) ∨ (A = kc_bd0 ∧ z ∊ ndbl (B' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (B' ∅)))}) ≐ {z | (([[ x / t ]] A) = kc_s ∧ z ∊ suc (([[ x / t ]] B)' ∅)) ∨ (([[ x / t ]] A) = kc_bd0 ∧ z ∊ ndbl (([[ x / t ]] B)' ∅)) ∨ (([[ x / t ]] A) = kc_bd1 ∧ z ∊ suc (ndbl (([[ x / t ]] B)' ∅)))} $ by ceqt_refl

lemma k3_nvb_sub (G: hyps) (A B C D: class): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ nvb A C ⊆ nvb B D $
----
m1: $ G , z ∊ nvb A C ⇒ z ∊ nvb A C $ by ax
m2: $ … ⇒ (A = kc_s ∧ z ∊ suc (C' ∅)) ∨ (A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅))) $ by cab_elim [m1]
m3: $ G ⇒ ∅ = ∅ $ by eq_refl
m4: $ … ⇒ C' ∅ = D' ∅ $ by fv_eq [#2, m3]
m5: $ … ⇒ suc (C' ∅) = suc (D' ∅) $ by suc_eq [m4]
m6: $ … ⇒ ndbl (C' ∅) = ndbl (D' ∅) $ by ndbl_eq [m4]
m7: $ … ⇒ suc (ndbl (C' ∅)) = suc (ndbl (D' ∅)) $ by suc_eq [m6]
m8: $ … ⇒ B = A $ by eq_sym [#1]
a1: $ G , z ∊ nvb A C , A = kc_s ∧ z ∊ suc (C' ∅) ⇒ A = kc_s ∧ z ∊ suc (C' ∅) $ by ax
a2: $ … ⇒ A = kc_s $ by and_elim_l [a1]
a3: $ G , z ∊ nvb A C , A = kc_s ∧ z ∊ suc (C' ∅) ⇒ B = A $ by weaken [m8]
a4: $ … ⇒ B = kc_s $ by eq_trans [a3, a2]
a5: $ … ⇒ z ∊ suc (C' ∅) $ by and_elim_r [a1]
a6: $ G , z ∊ nvb A C , A = kc_s ∧ z ∊ suc (C' ∅) ⇒ suc (C' ∅) = suc (D' ∅) $ by weaken [m5]
a7: $ … ⇒ z ∊ suc (D' ∅) $ by welc_eq [a6, a5]
a8: $ … ⇒ B = kc_s ∧ z ∊ suc (D' ∅) $ by and_intro [a4, a7]
a9: $ … ⇒ (B = kc_s ∧ z ∊ suc (D' ∅)) ∨ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by or_intro_l [a8]
b0: $ G , z ∊ nvb A C , (A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅))) ⇒ (A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅))) $ by ax
b1: $ G , z ∊ nvb A C , A = kc_bd0 ∧ z ∊ ndbl (C' ∅) ⇒ A = kc_bd0 ∧ z ∊ ndbl (C' ∅) $ by ax
b2: $ … ⇒ A = kc_bd0 $ by and_elim_l [b1]
b3: $ G , z ∊ nvb A C , A = kc_bd0 ∧ z ∊ ndbl (C' ∅) ⇒ B = A $ by weaken [m8]
b4: $ … ⇒ B = kc_bd0 $ by eq_trans [b3, b2]
b5: $ … ⇒ z ∊ ndbl (C' ∅) $ by and_elim_r [b1]
b6: $ G , z ∊ nvb A C , A = kc_bd0 ∧ z ∊ ndbl (C' ∅) ⇒ ndbl (C' ∅) = ndbl (D' ∅) $ by weaken [m6]
b7: $ … ⇒ z ∊ ndbl (D' ∅) $ by welc_eq [b6, b5]
b8: $ … ⇒ B = kc_bd0 ∧ z ∊ ndbl (D' ∅) $ by and_intro [b4, b7]
b9: $ … ⇒ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by or_intro_l [b8]
c1: $ G , z ∊ nvb A C , A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅)) ⇒ A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅)) $ by ax
c2: $ … ⇒ A = kc_bd1 $ by and_elim_l [c1]
c3: $ G , z ∊ nvb A C , A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅)) ⇒ B = A $ by weaken [m8]
c4: $ … ⇒ B = kc_bd1 $ by eq_trans [c3, c2]
c5: $ … ⇒ z ∊ suc (ndbl (C' ∅)) $ by and_elim_r [c1]
c6: $ G , z ∊ nvb A C , A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅)) ⇒ suc (ndbl (C' ∅)) = suc (ndbl (D' ∅)) $ by weaken [m7]
c7: $ … ⇒ z ∊ suc (ndbl (D' ∅)) $ by welc_eq [c6, c5]
c8: $ … ⇒ B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅)) $ by and_intro [c4, c7]
c9: $ … ⇒ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by or_intro_r [c8]
b10: $ G , z ∊ nvb A C , (A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅))) , A = kc_bd0 ∧ z ∊ ndbl (C' ∅) ⇒ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by weaken [b9]
c10: $ G , z ∊ nvb A C , (A = kc_bd0 ∧ z ∊ ndbl (C' ∅)) ∨ (A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅))) , A = kc_bd1 ∧ z ∊ suc (ndbl (C' ∅)) ⇒ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by weaken [c9]
d1: $ … ⇒ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by or_elim [b0, b10, c10]
d2: $ … ⇒ (B = kc_s ∧ z ∊ suc (D' ∅)) ∨ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by or_intro_r [d1]
d3: $ … ⇒ (B = kc_s ∧ z ∊ suc (D' ∅)) ∨ (B = kc_bd0 ∧ z ∊ ndbl (D' ∅)) ∨ (B = kc_bd1 ∧ z ∊ suc (ndbl (D' ∅))) $ by or_elim [m2, a9, d2]
d4: $ G , z ∊ nvb A C ⇒ z ∊ nvb B D $ by cab_intro [d3]
d5: $ … ⇒ nvb A C ⊆ nvb B D $ by subset_intro [d4]

nvb_eq
------
l1: $ … ⇒ nvb A C ⊆ nvb B D $ by k3_nvb_sub [#1, #2]
l2: $ … ⇒ B = A $ by eq_sym [#1]
l3: $ … ⇒ D = C $ by eq_sym [#2]
l4: $ … ⇒ nvb B D ⊆ nvb A C $ by k3_nvb_sub [l2, l3]
l5: $ … ⇒ nvb A C = nvb B D $ by subset_antisym [l1, l4]

nvb_set
-------
l1v: $ G ⇒ isset v $ by isset_var
l1: $ … ⇒ isset (v' ∅) $ by fv_set_l [l1v]
l2: $ … ⇒ isset (suc (v' ∅)) $ by suc_set [l1]
l3: $ … ⇒ isset (ndbl (v' ∅)) $ by nadd_set_c [l1, l1]
l4: $ … ⇒ isset (suc (ndbl (v' ∅))) $ by suc_set [l3]
l5: $ … ⇒ isset (ndbl (v' ∅) ∪ suc (ndbl (v' ∅))) $ by cun_set [l3, l4]
l6: $ … ⇒ isset (suc (v' ∅) ∪ (ndbl (v' ∅) ∪ suc (ndbl (v' ∅)))) $ by cun_set [l2, l5]
l7: $ G , z ∊ nvb K v ⇒ z ∊ nvb K v $ by ax
l8: $ … ⇒ (K = kc_s ∧ z ∊ suc (v' ∅)) ∨ (K = kc_bd0 ∧ z ∊ ndbl (v' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (v' ∅))) $ by cab_elim [l7]
l9: $ G , z ∊ nvb K v , K = kc_s ∧ z ∊ suc (v' ∅) ⇒ K = kc_s ∧ z ∊ suc (v' ∅) $ by ax
l10: $ … ⇒ z ∊ suc (v' ∅) $ by and_elim_r [l9]
l11: $ … ⇒ z ∊ suc (v' ∅) ∪ (ndbl (v' ∅) ∪ suc (ndbl (v' ∅))) $ by cun_intro_l [l10]
l12: $ G , z ∊ nvb K v , (K = kc_bd0 ∧ z ∊ ndbl (v' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (v' ∅))) ⇒ (K = kc_bd0 ∧ z ∊ ndbl (v' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (v' ∅))) $ by ax
l13: $ G , z ∊ nvb K v , (K = kc_bd0 ∧ z ∊ ndbl (v' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (v' ∅))) , K = kc_bd0 ∧ z ∊ ndbl (v' ∅) ⇒ K = kc_bd0 ∧ z ∊ ndbl (v' ∅) $ by ax
l14: $ … ⇒ z ∊ ndbl (v' ∅) $ by and_elim_r [l13]
l15: $ … ⇒ z ∊ ndbl (v' ∅) ∪ suc (ndbl (v' ∅)) $ by cun_intro_l [l14]
l16: $ G , z ∊ nvb K v , (K = kc_bd0 ∧ z ∊ ndbl (v' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (v' ∅))) , K = kc_bd1 ∧ z ∊ suc (ndbl (v' ∅)) ⇒ K = kc_bd1 ∧ z ∊ suc (ndbl (v' ∅)) $ by ax
l17: $ … ⇒ z ∊ suc (ndbl (v' ∅)) $ by and_elim_r [l16]
l18: $ … ⇒ z ∊ ndbl (v' ∅) ∪ suc (ndbl (v' ∅)) $ by cun_intro_r [l17]
l19: $ … ⇒ z ∊ ndbl (v' ∅) ∪ suc (ndbl (v' ∅)) $ by or_elim [l12, l15, l18]
l20: $ … ⇒ z ∊ suc (v' ∅) ∪ (ndbl (v' ∅) ∪ suc (ndbl (v' ∅))) $ by cun_intro_r [l19]
l21: $ … ⇒ z ∊ suc (v' ∅) ∪ (ndbl (v' ∅) ∪ suc (ndbl (v' ∅))) $ by or_elim [l8, l11, l20]
l22: $ … ⇒ nvb K v ⊆ suc (v' ∅) ∪ (ndbl (v' ∅) ∪ suc (ndbl (v' ∅))) $ by subset_intro [l21]
l23: $ … ⇒ isset (nvb K v) $ by subset_isset [l6, l22]

nvf_functional
--------------
l1: $ G ⇒ functional (cgr3 k j v (nvb k v)) $ by cgr3_functional
l2o: $ G ⇒ isset ω $ by omega_set
l2: $ … ⇒ functional (trc ω (cgr3 k j v (nvb k v))) $ by trc_functional_c [l2o, l1]

--| The domain of `F` after `s` is in that of `s`.
lemma k3_ccom_cdm (G: hyps) (F: class) (j: set): $ G ⇒ cdm (ccom F j) ⊆ cdm j $
----
l1: $ G , x ∊ cdm (ccom F j) ⇒ x ∊ cdm (ccom F j) $ by ax
l2: $ G , x ∊ cdm (ccom F j) , ⟨ x , y ⟩ ∈ ccom F j ⇒ ⟨ x , y ⟩ ∈ ccom F j $ by ax
l3: $ G , x ∊ cdm (ccom F j) , ⟨ x , y ⟩ ∈ ccom F j , ⟨ x , z ⟩ ∈ j , ⟨ z , y ⟩ ∈ F ⇒ ⟨ x , z ⟩ ∈ j $ by ax
l4: $ … ⇒ x ∊ cdm j $ by cdm_intro [l3]
l5: $ … ⇒ x ∊ cdm j $ by ccom_elim [l2, l4]
l6: $ … ⇒ x ∊ cdm j $ by cdm_elim [l1, l5]
l7: $ … ⇒ cdm (ccom F j) ⊆ cdm j $ by subset_intro [l6]

nvf_node
--------
l1: $ G ⇒ functional nvf $ by nvf_functional
l3v: $ G ⇒ isset s $ by isset_var
l3: $ … ⇒ isset (ccom nvf s) $ by ccom_set [l1, l3v]
l4: $ G ⇒ functional (cgr3 i j u (nvb i u)) $ by cgr3_functional
l5o: $ G ⇒ isset ω $ by omega_set
l5: $ … ⇒ nvf' ⟨ k , s ⟩ = (cgr3 i j u (nvb i u))' ⟨ k , ⟨ s , ccom nvf s ⟩ ⟩ $ by trc_node_c [l5o, l4, #1, #2]
l6: $ G , c = ccom nvf s ⇒ isset (nvb k c) $ by nvb_set
l7: $ G , c = ccom nvf s ⇒ (cgr3 i j u (nvb i u))' ⟨ k , ⟨ s , c ⟩ ⟩ = nvb k c $ by fv_cgr3 [l6]
l8: $ G , c = ccom nvf s ⇒ c = ccom nvf s $ by ax
l9: $ G , c = ccom nvf s ⇒ k = k $ by eq_refl
l10: $ … ⇒ nvb k c = nvb k (ccom nvf s) $ by nvb_eq [l9, l8]
l11: $ G , c = ccom nvf s ⇒ s = s $ by eq_refl
l12: $ … ⇒ ccom nvf s = c $ by eq_sym [l8]
l13: $ … ⇒ ⟨ s , ccom nvf s ⟩ = ⟨ s , c ⟩ $ by opair_eq [l11, l12]
l14: $ … ⇒ ⟨ k , ⟨ s , ccom nvf s ⟩ ⟩ = ⟨ k , ⟨ s , c ⟩ ⟩ $ by opair_eq [l9, l13]
l15: $ G , c = ccom nvf s ⇒ cgr3 i j u (nvb i u) = cgr3 i j u (nvb i u) $ by eq_refl
l16: $ … ⇒ (cgr3 i j u (nvb i u))' ⟨ k , ⟨ s , ccom nvf s ⟩ ⟩ = (cgr3 i j u (nvb i u))' ⟨ k , ⟨ s , c ⟩ ⟩ $ by fv_eq [l15, l14]
l17: $ G , c = ccom nvf s ⇒ nvf' ⟨ k , s ⟩ = (cgr3 i j u (nvb i u))' ⟨ k , ⟨ s , ccom nvf s ⟩ ⟩ $ by weaken [l5]
l18: $ … ⇒ nvf' ⟨ k , s ⟩ = (cgr3 i j u (nvb i u))' ⟨ k , ⟨ s , c ⟩ ⟩ $ by eq_trans [l17, l16]
l19: $ … ⇒ nvf' ⟨ k , s ⟩ = nvb k c $ by eq_trans [l18, l7]
l20: $ … ⇒ nvf' ⟨ k , s ⟩ = nvb k (ccom nvf s) $ by eq_trans [l19, l10]
l21: $ … ⇒ nvf' ⟨ k , s ⟩ = nvb k (ccom nvf s) $ by isset_elim [l3, l20]

--| Cases on a member of a step of `nvb`.
lemma k3_nvb_cases (G: hyps) (K V: class) (z: set) (c: fml):
  $ G ⇒ z ∊ nvb K V $ > $ G , K = kc_s ∧ z ∊ suc (V' ∅) ⇒ c $ > $ G , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ c $ > $ G , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ c $ > $ G ⇒ c $
----
l1: $ … ⇒ (K = kc_s ∧ z ∊ suc (V' ∅)) ∨ (K = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) $ by cab_elim [#1]
l2: $ G , (K = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) ⇒ (K = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) $ by ax
l3: $ G , (K = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ c $ by weaken [#3]
l4: $ G , (K = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ c $ by weaken [#4]
l5: $ … ⇒ c $ by or_elim [l2, l3, l4]
l6: $ … ⇒ c $ by or_elim [l1, #2, l5]

lemma k3_nvb_v1 (G: hyps) (K V: class) (z: set):
  $ G ⇒ z ∊ nvb K V $ > $ G ⇒ ¬ K = kc_bd0 $ > $ G ⇒ ¬ K = kc_bd1 $ > $ G ⇒ z ∊ suc (V' ∅) $
----
a1: $ G , K = kc_s ∧ z ∊ suc (V' ∅) ⇒ K = kc_s ∧ z ∊ suc (V' ∅) $ by ax
b1: $ … ⇒ z ∊ suc (V' ∅) $ by and_elim_r [a1]
a2: $ G , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ K = kc_bd0 ∧ z ∊ ndbl (V' ∅) $ by ax
d2: $ … ⇒ K = kc_bd0 $ by and_elim_l [a2]
e2: $ G , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ ¬ K = kc_bd0 $ by weaken [#2]
f2: $ … ⇒ ⊥ $ by not_elim [e2, d2]
b2: $ … ⇒ z ∊ suc (V' ∅) $ by bot_elim [f2]
a3: $ G , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) $ by ax
d3: $ … ⇒ K = kc_bd1 $ by and_elim_l [a3]
e3: $ G , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ ¬ K = kc_bd1 $ by weaken [#3]
f3: $ … ⇒ ⊥ $ by not_elim [e3, d3]
b3: $ … ⇒ z ∊ suc (V' ∅) $ by bot_elim [f3]
g1: $ … ⇒ z ∊ suc (V' ∅) $ by k3_nvb_cases [#1, b1, b2, b3]

lemma k3_nvb_v2 (G: hyps) (K V: class) (z: set):
  $ G ⇒ z ∊ nvb K V $ > $ G ⇒ ¬ K = kc_s $ > $ G ⇒ ¬ K = kc_bd1 $ > $ G ⇒ z ∊ ndbl (V' ∅) $
----
a1: $ G , K = kc_s ∧ z ∊ suc (V' ∅) ⇒ K = kc_s ∧ z ∊ suc (V' ∅) $ by ax
d1: $ … ⇒ K = kc_s $ by and_elim_l [a1]
e1: $ G , K = kc_s ∧ z ∊ suc (V' ∅) ⇒ ¬ K = kc_s $ by weaken [#2]
f1: $ … ⇒ ⊥ $ by not_elim [e1, d1]
b1: $ … ⇒ z ∊ ndbl (V' ∅) $ by bot_elim [f1]
a2: $ G , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ K = kc_bd0 ∧ z ∊ ndbl (V' ∅) $ by ax
b2: $ … ⇒ z ∊ ndbl (V' ∅) $ by and_elim_r [a2]
a3: $ G , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) $ by ax
d3: $ … ⇒ K = kc_bd1 $ by and_elim_l [a3]
e3: $ G , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ ¬ K = kc_bd1 $ by weaken [#3]
f3: $ … ⇒ ⊥ $ by not_elim [e3, d3]
b3: $ … ⇒ z ∊ ndbl (V' ∅) $ by bot_elim [f3]
g1: $ … ⇒ z ∊ ndbl (V' ∅) $ by k3_nvb_cases [#1, b1, b2, b3]

lemma k3_nvb_v3 (G: hyps) (K V: class) (z: set):
  $ G ⇒ z ∊ nvb K V $ > $ G ⇒ ¬ K = kc_s $ > $ G ⇒ ¬ K = kc_bd0 $ > $ G ⇒ z ∊ suc (ndbl (V' ∅)) $
----
a1: $ G , K = kc_s ∧ z ∊ suc (V' ∅) ⇒ K = kc_s ∧ z ∊ suc (V' ∅) $ by ax
d1: $ … ⇒ K = kc_s $ by and_elim_l [a1]
e1: $ G , K = kc_s ∧ z ∊ suc (V' ∅) ⇒ ¬ K = kc_s $ by weaken [#2]
f1: $ … ⇒ ⊥ $ by not_elim [e1, d1]
b1: $ … ⇒ z ∊ suc (ndbl (V' ∅)) $ by bot_elim [f1]
a2: $ G , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ K = kc_bd0 ∧ z ∊ ndbl (V' ∅) $ by ax
d2: $ … ⇒ K = kc_bd0 $ by and_elim_l [a2]
e2: $ G , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ ¬ K = kc_bd0 $ by weaken [#3]
f2: $ … ⇒ ⊥ $ by not_elim [e2, d2]
b2: $ … ⇒ z ∊ suc (ndbl (V' ∅)) $ by bot_elim [f2]
a3: $ G , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) $ by ax
b3: $ … ⇒ z ∊ suc (ndbl (V' ∅)) $ by and_elim_r [a3]
g1: $ … ⇒ z ∊ suc (ndbl (V' ∅)) $ by k3_nvb_cases [#1, b1, b2, b3]

lemma k3_nvb_v0 (G: hyps) (K V: class) (z: set):
  $ G ⇒ z ∊ nvb K V $ > $ G ⇒ ¬ K = kc_s $ > $ G ⇒ ¬ K = kc_bd0 $ > $ G ⇒ ¬ K = kc_bd1 $ > $ G ⇒ ⊥ $
----
a1: $ G , K = kc_s ∧ z ∊ suc (V' ∅) ⇒ K = kc_s ∧ z ∊ suc (V' ∅) $ by ax
d1: $ … ⇒ K = kc_s $ by and_elim_l [a1]
e1: $ G , K = kc_s ∧ z ∊ suc (V' ∅) ⇒ ¬ K = kc_s $ by weaken [#2]
b1: $ … ⇒ ⊥ $ by not_elim [e1, d1]
a2: $ G , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ K = kc_bd0 ∧ z ∊ ndbl (V' ∅) $ by ax
d2: $ … ⇒ K = kc_bd0 $ by and_elim_l [a2]
e2: $ G , K = kc_bd0 ∧ z ∊ ndbl (V' ∅) ⇒ ¬ K = kc_bd0 $ by weaken [#3]
b2: $ … ⇒ ⊥ $ by not_elim [e2, d2]
a3: $ G , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) $ by ax
d3: $ … ⇒ K = kc_bd1 $ by and_elim_l [a3]
e3: $ G , K = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) ⇒ ¬ K = kc_bd1 $ by weaken [#4]
b3: $ … ⇒ ⊥ $ by not_elim [e3, d3]
g1: $ … ⇒ ⊥ $ by k3_nvb_cases [#1, b1, b2, b3]

lemma k3_nvb_at_s (G: hyps) (V: class): $ G ⇒ nvb kc_s V = suc (V' ∅) $
----
l1: $ G , z ∊ nvb kc_s V ⇒ z ∊ nvb kc_s V $ by ax
l2: $ G , z ∊ nvb kc_s V ⇒ ¬ kc_s = kc_bd0 $ by kc_s_ne_bd0
l3: $ G , z ∊ nvb kc_s V ⇒ ¬ kc_s = kc_bd1 $ by kc_s_ne_bd1
l4: $ … ⇒ z ∊ suc (V' ∅) $ by k3_nvb_v1 [l1, l2, l3]
l5: $ G , z ∊ suc (V' ∅) ⇒ z ∊ suc (V' ∅) $ by ax
l6: $ G , z ∊ suc (V' ∅) ⇒ kc_s = kc_s $ by eq_refl
l7: $ … ⇒ kc_s = kc_s ∧ z ∊ suc (V' ∅) $ by and_intro [l6, l5]
l8: $ … ⇒ (kc_s = kc_s ∧ z ∊ suc (V' ∅)) ∨ (kc_s = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (kc_s = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) $ by or_intro_l [l7]
l9: $ G , z ∊ suc (V' ∅) ⇒ z ∊ nvb kc_s V $ by cab_intro [l8]
l10: $ … ⇒ nvb kc_s V = suc (V' ∅) $ by eq_intro [l4, l9]

lemma k3_nvb_at_bd0 (G: hyps) (V: class): $ G ⇒ nvb kc_bd0 V = ndbl (V' ∅) $
----
l1: $ G , z ∊ nvb kc_bd0 V ⇒ z ∊ nvb kc_bd0 V $ by ax
l2n: $ G , z ∊ nvb kc_bd0 V ⇒ ¬ kc_s = kc_bd0 $ by kc_s_ne_bd0
l2: $ … ⇒ ¬ kc_bd0 = kc_s $ by ne_sym [l2n]
l3: $ G , z ∊ nvb kc_bd0 V ⇒ ¬ kc_bd0 = kc_bd1 $ by kc_bd0_ne_bd1
l4: $ … ⇒ z ∊ ndbl (V' ∅) $ by k3_nvb_v2 [l1, l2, l3]
l5: $ G , z ∊ ndbl (V' ∅) ⇒ z ∊ ndbl (V' ∅) $ by ax
l6: $ G , z ∊ ndbl (V' ∅) ⇒ kc_bd0 = kc_bd0 $ by eq_refl
l7: $ … ⇒ kc_bd0 = kc_bd0 ∧ z ∊ ndbl (V' ∅) $ by and_intro [l6, l5]
l7a: $ … ⇒ (kc_bd0 = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (kc_bd0 = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) $ by or_intro_l [l7]
l8: $ … ⇒ (kc_bd0 = kc_s ∧ z ∊ suc (V' ∅)) ∨ (kc_bd0 = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (kc_bd0 = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) $ by or_intro_r [l7a]
l9: $ G , z ∊ ndbl (V' ∅) ⇒ z ∊ nvb kc_bd0 V $ by cab_intro [l8]
l10: $ … ⇒ nvb kc_bd0 V = ndbl (V' ∅) $ by eq_intro [l4, l9]

lemma k3_nvb_at_bd1 (G: hyps) (V: class): $ G ⇒ nvb kc_bd1 V = suc (ndbl (V' ∅)) $
----
l1: $ G , z ∊ nvb kc_bd1 V ⇒ z ∊ nvb kc_bd1 V $ by ax
l2n: $ G , z ∊ nvb kc_bd1 V ⇒ ¬ kc_s = kc_bd1 $ by kc_s_ne_bd1
l2: $ … ⇒ ¬ kc_bd1 = kc_s $ by ne_sym [l2n]
l3n: $ G , z ∊ nvb kc_bd1 V ⇒ ¬ kc_bd0 = kc_bd1 $ by kc_bd0_ne_bd1
l3: $ … ⇒ ¬ kc_bd1 = kc_bd0 $ by ne_sym [l3n]
l4: $ … ⇒ z ∊ suc (ndbl (V' ∅)) $ by k3_nvb_v3 [l1, l2, l3]
l5: $ G , z ∊ suc (ndbl (V' ∅)) ⇒ z ∊ suc (ndbl (V' ∅)) $ by ax
l6: $ G , z ∊ suc (ndbl (V' ∅)) ⇒ kc_bd1 = kc_bd1 $ by eq_refl
l7: $ … ⇒ kc_bd1 = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅)) $ by and_intro [l6, l5]
l7a: $ … ⇒ (kc_bd1 = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (kc_bd1 = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) $ by or_intro_r [l7]
l8: $ … ⇒ (kc_bd1 = kc_s ∧ z ∊ suc (V' ∅)) ∨ (kc_bd1 = kc_bd0 ∧ z ∊ ndbl (V' ∅)) ∨ (kc_bd1 = kc_bd1 ∧ z ∊ suc (ndbl (V' ∅))) $ by or_intro_r [l7a]
l9: $ G , z ∊ suc (ndbl (V' ∅)) ⇒ z ∊ nvb kc_bd1 V $ by cab_intro [l8]
l10: $ … ⇒ nvb kc_bd1 V = suc (ndbl (V' ∅)) $ by eq_intro [l4, l9]

lemma k3_nvb_zero (G: hyps) (K V: class):
  $ G ⇒ ¬ K = kc_s $ > $ G ⇒ ¬ K = kc_bd0 $ > $ G ⇒ ¬ K = kc_bd1 $ > $ G ⇒ nvb K V = ∅ $
----
l1: $ G , z ∊ nvb K V ⇒ z ∊ nvb K V $ by ax
l2: $ G , z ∊ nvb K V ⇒ ¬ K = kc_s $ by weaken [#1]
l3: $ G , z ∊ nvb K V ⇒ ¬ K = kc_bd0 $ by weaken [#2]
l4: $ G , z ∊ nvb K V ⇒ ¬ K = kc_bd1 $ by weaken [#3]
l5: $ … ⇒ ⊥ $ by k3_nvb_v0 [l1, l2, l3, l4]
l6: $ … ⇒ nvb K V = ∅ $ by empty_eq_intro [l5]

nvf_cdm
-------
l1: $ G ⇒ functional (cgr3 k j v (nvb k v)) $ by cgr3_functional
l2o: $ G ⇒ isset ω $ by omega_set
l2: $ … ⇒ cdm (trc ω (cgr3 k j v (nvb k v))) = trees ω $ by trc_cdm_c [l2o, l1]

--| Class form of `nvf_node`.
nvf_node_c
----------
l1: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ k ∊ ω $ by ax
l2: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ j ∊ fseq (trees ω) $ by ax
l3: $ … ⇒ nvf' ⟨ k , j ⟩ = nvb k (ccom nvf j) $ by nvf_node [l1, l2]
l4: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ k = K $ by ax
l5: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ j = S $ by ax
l6: $ … ⇒ ⟨ k , j ⟩ = ⟨ K , S ⟩ $ by opair_eq [l4, l5]
l7: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ nvf = nvf $ by eq_refl
l8: $ … ⇒ nvf' ⟨ k , j ⟩ = nvf' ⟨ K , S ⟩ $ by fv_eq [l7, l6]
l9: $ … ⇒ ccom nvf j = ccom nvf S $ by ccom_eq [l7, l5]
l10: $ … ⇒ nvb k (ccom nvf j) = nvb K (ccom nvf S) $ by nvb_eq [l4, l9]
l11: $ … ⇒ nvf' ⟨ K , S ⟩ = nvf' ⟨ k , j ⟩ $ by eq_sym [l8]
l12: $ … ⇒ nvf' ⟨ K , S ⟩ = nvb k (ccom nvf j) $ by eq_trans [l11, l3]
l13: $ … ⇒ nvf' ⟨ K , S ⟩ = nvb K (ccom nvf S) $ by eq_trans [l12, l10]
l14: $ … ⇒ nvf' ⟨ K , S ⟩ = nvb K (ccom nvf S) $ by wcel_elim [#2, l13]
l15: $ … ⇒ nvf' ⟨ K , S ⟩ = nvb K (ccom nvf S) $ by wcel_elim [#1, l14]

--| The first child's value.
lemma k3_nvf_ccom0 (G: hyps) (T: class): $ G ⇒ T ∈ trees ω $ > $ G ⇒ (ccom nvf (T +: ∅))' ∅ = nvf' T $
----
a1: $ G ⇒ functional nvf $ by nvf_functional
a2: $ G ⇒ cdm nvf = trees ω $ by nvf_cdm
a3: $ … ⇒ trees ω = cdm nvf $ by eq_sym [a2]
h1: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ t ∊ trees ω $ by ax
h2a: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ trees ω = cdm nvf $ by weaken [a3]
h2: $ … ⇒ t ∊ cdm nvf $ by welc_eq [h2a, h1]
h3a: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ functional nvf $ by weaken [a1]
h3: $ … ⇒ ccom nvf (t +: e) = nvf' t +: ccom nvf e $ by ccom_scons [h3a, h2]
h4: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ e = ∅ $ by ax
h4a: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ nvf = nvf $ by eq_refl
h4b: $ … ⇒ ccom nvf e = ccom nvf ∅ $ by ccom_eq [h4a, h4]
h4c: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ ccom nvf ∅ = ∅ $ by ccom_empty
h4d: $ … ⇒ ∅ = e $ by eq_sym [h4]
h4e: $ … ⇒ ccom nvf e = ∅ $ by eq_trans [h4b, h4c]
h4f: $ … ⇒ ccom nvf e = e $ by eq_trans [h4e, h4d]
h5: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ b = nvf' t $ by ax
h5a: $ … ⇒ nvf' t = b $ by eq_sym [h5]
h6: $ … ⇒ nvf' t +: ccom nvf e = b +: e $ by scons_eq [h5a, h4f]
h7: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ (b +: e)' ∅ = b $ by scons_fv_zero
h8a: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ t = T $ by ax
h8b: $ … ⇒ T = t $ by eq_sym [h8a]
h8: $ … ⇒ T +: ∅ = t +: e $ by scons_eq [h8b, h4d]
h9: $ … ⇒ ccom nvf (T +: ∅) = ccom nvf (t +: e) $ by ccom_eq [h4a, h8]
h10a: $ … ⇒ ccom nvf (T +: ∅) = nvf' t +: ccom nvf e $ by eq_trans [h9, h3]
h10: $ … ⇒ ccom nvf (T +: ∅) = b +: e $ by eq_trans [h10a, h6]
h11a: $ G , t = T , t ∊ trees ω , e = ∅ , b = nvf' t ⇒ ∅ = ∅ $ by eq_refl
h11: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = (b +: e)' ∅ $ by fv_eq [h10, h11a]
h12: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = b $ by eq_trans [h11, h7]
h13a: $ … ⇒ nvf' t = nvf' T $ by fv_eq [h4a, h8a]
h13: $ … ⇒ b = nvf' T $ by eq_trans [h5, h13a]
h14: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = nvf' T $ by eq_trans [h12, h13]
i1: $ G , t = T , t ∊ trees ω , e = ∅ ⇒ functional nvf $ by weaken [a1]
i2: $ … ⇒ isset (nvf' t) $ by fv_set [i1]
i3: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = nvf' T $ by isset_elim [i2, h14]
i4: $ G , t = T , t ∊ trees ω ⇒ isset ∅ $ by ax_empty
i5: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = nvf' T $ by isset_elim [i4, i3]
i6: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = nvf' T $ by wcel_elim [#1, i5]

nvf_nz
------
l1: $ G ⇒ kc_nz ∈ ω $ by kc_nz_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ … ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = nvb kc_nz (ccom nvf ∅) $ by nvf_node_c [l1, l2]
l4: $ G ⇒ ¬ kc_nz = kc_s $ by kc_nz_ne_s
l5: $ G ⇒ ¬ kc_nz = kc_bd0 $ by kc_nz_ne_bd0
l6: $ G ⇒ ¬ kc_nz = kc_bd1 $ by kc_nz_ne_bd1
l7: $ … ⇒ nvb kc_nz (ccom nvf ∅) = ∅ $ by k3_nvb_zero [l4, l5, l6]
l8: $ … ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by eq_trans [l3, l7]

nvf_s
-----
l1: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ … ⇒ T +: ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ … ⇒ nvf' ⟨ kc_s , T +: ∅ ⟩ = nvb kc_s (ccom nvf (T +: ∅)) $ by nvf_node_c [l1, l3]
l5: $ G ⇒ nvb kc_s (ccom nvf (T +: ∅)) = suc ((ccom nvf (T +: ∅))' ∅) $ by k3_nvb_at_s
l6: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = nvf' T $ by k3_nvf_ccom0 [#1]
l7: $ … ⇒ suc ((ccom nvf (T +: ∅))' ∅) = suc (nvf' T) $ by suc_eq [l6]
l8: $ … ⇒ nvf' ⟨ kc_s , T +: ∅ ⟩ = suc ((ccom nvf (T +: ∅))' ∅) $ by eq_trans [l4, l5]
l9: $ … ⇒ nvf' ⟨ kc_s , T +: ∅ ⟩ = suc (nvf' T) $ by eq_trans [l8, l7]

nvf_n1
------
l1: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l2: $ … ⇒ nvf' ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ = suc (nvf' ⟨ kc_nz , ∅ ⟩) $ by nvf_s [l1]
l3: $ G ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l4: $ … ⇒ suc (nvf' ⟨ kc_nz , ∅ ⟩) = suc ∅ $ by suc_eq [l3]
l5: $ … ⇒ nvf' ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ = suc ∅ $ by eq_trans [l2, l4]

nvf_b0
------
l1: $ G ⇒ kc_b0 ∈ ω $ by kc_b0_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ … ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = nvb kc_b0 (ccom nvf ∅) $ by nvf_node_c [l1, l2]
l4n: $ G ⇒ ¬ kc_s = kc_b0 $ by kc_s_ne_b0
l4: $ … ⇒ ¬ kc_b0 = kc_s $ by ne_sym [l4n]
l5: $ G ⇒ ¬ kc_b0 = kc_bd0 $ by kc_b0_ne_bd0
l6: $ G ⇒ ¬ kc_b0 = kc_bd1 $ by kc_b0_ne_bd1
l7: $ … ⇒ nvb kc_b0 (ccom nvf ∅) = ∅ $ by k3_nvb_zero [l4, l5, l6]
l8: $ … ⇒ nvf' ⟨ kc_b0 , ∅ ⟩ = ∅ $ by eq_trans [l3, l7]

nvf_bd0
-------
l1: $ G ⇒ kc_bd0 ∈ ω $ by kc_bd0_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ … ⇒ T +: ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ … ⇒ nvf' ⟨ kc_bd0 , T +: ∅ ⟩ = nvb kc_bd0 (ccom nvf (T +: ∅)) $ by nvf_node_c [l1, l3]
l5: $ G ⇒ nvb kc_bd0 (ccom nvf (T +: ∅)) = ndbl ((ccom nvf (T +: ∅))' ∅) $ by k3_nvb_at_bd0
l6: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = nvf' T $ by k3_nvf_ccom0 [#1]
l7: $ … ⇒ ndbl ((ccom nvf (T +: ∅))' ∅) = ndbl (nvf' T) $ by ndbl_eq [l6]
l8: $ … ⇒ nvf' ⟨ kc_bd0 , T +: ∅ ⟩ = ndbl ((ccom nvf (T +: ∅))' ∅) $ by eq_trans [l4, l5]
l9: $ … ⇒ nvf' ⟨ kc_bd0 , T +: ∅ ⟩ = ndbl (nvf' T) $ by eq_trans [l8, l7]

nvf_bd1
-------
l1: $ G ⇒ kc_bd1 ∈ ω $ by kc_bd1_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ … ⇒ T +: ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ … ⇒ nvf' ⟨ kc_bd1 , T +: ∅ ⟩ = nvb kc_bd1 (ccom nvf (T +: ∅)) $ by nvf_node_c [l1, l3]
l5: $ G ⇒ nvb kc_bd1 (ccom nvf (T +: ∅)) = suc (ndbl ((ccom nvf (T +: ∅))' ∅)) $ by k3_nvb_at_bd1
l6: $ … ⇒ (ccom nvf (T +: ∅))' ∅ = nvf' T $ by k3_nvf_ccom0 [#1]
l7a: $ … ⇒ ndbl ((ccom nvf (T +: ∅))' ∅) = ndbl (nvf' T) $ by ndbl_eq [l6]
l7: $ … ⇒ suc (ndbl ((ccom nvf (T +: ∅))' ∅)) = suc (ndbl (nvf' T)) $ by suc_eq [l7a]
l8: $ … ⇒ nvf' ⟨ kc_bd1 , T +: ∅ ⟩ = suc (ndbl ((ccom nvf (T +: ∅))' ∅)) $ by eq_trans [l4, l5]
l9: $ … ⇒ nvf' ⟨ kc_bd1 , T +: ∅ ⟩ = suc (ndbl (nvf' T)) $ by eq_trans [l8, l7]

--| The trees whose numbers are numbers.
def k3_nvo (.x: set): class = $ {x | nvf' x ∈ ω} $

--| The first child's value is a number, when the children's are.
lemma k3_cv0 (G: hyps) (j: set):
  $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ k3_nvo $ > $ G ⇒ (ccom nvf j)' ∅ ∈ ω $
----
a0: $ G ⇒ functional nvf $ by nvf_functional
a00: $ … ⇒ functional j $ by fseq_functional [#1]
a01: $ G ⇒ cdm nvf = trees ω $ by nvf_cdm
a02: $ … ⇒ trees ω = cdm nvf $ by eq_sym [a01]
a1: $ G , e = ∅ , e ∊ cdm j ⇒ functional nvf $ by weaken [a0]
a2: $ G , e = ∅ , e ∊ cdm j ⇒ functional j $ by weaken [a00]
a3a: $ G , e = ∅ , e ∊ cdm j ⇒ j ∊ fseq (trees ω) $ by weaken [#1]
a3b: $ G , e = ∅ , e ∊ cdm j ⇒ e ∊ cdm j $ by ax
a3: $ … ⇒ j' e ∈ trees ω $ by fseq_fv [a3a, a3b]
a4a: $ G , e = ∅ , e ∊ cdm j ⇒ trees ω = cdm nvf $ by weaken [a02]
a4: $ … ⇒ j' e ∈ cdm nvf $ by wcel_eq_r [a4a, a3]
a5: $ … ⇒ (ccom nvf j)' e = nvf' j' e $ by fv_ccom [a1, a2, a3b, a4]
b0a: $ G , e = ∅ , e ∊ cdm j , w = j' e ⇒ functional j $ by weaken [a00]
b0b: $ G , e = ∅ , e ∊ cdm j , w = j' e ⇒ e ∊ cdm j $ by ax
b1: $ … ⇒ ⟨ e , j' e ⟩ ∈ j $ by fv_in [b0a, b0b]
b2a: $ G , e = ∅ , e ∊ cdm j , w = j' e ⇒ w = j' e $ by ax
b2b: $ … ⇒ j' e = w $ by eq_sym [b2a]
b2c: $ G , e = ∅ , e ∊ cdm j , w = j' e ⇒ e = e $ by eq_refl
b2d: $ … ⇒ ⟨ e , j' e ⟩ = ⟨ e , w ⟩ $ by opair_eq [b2c, b2b]
b2: $ … ⇒ ⟨ e , w ⟩ ∈ j $ by wcel_eq_l [b2d, b1]
b3: $ … ⇒ w ∊ crn j $ by crn_intro [b2]
b4a: $ G , e = ∅ , e ∊ cdm j , w = j' e ⇒ crn j ⊆ k3_nvo $ by weaken [#2]
b4: $ … ⇒ w ∊ k3_nvo $ by subset_elim [b4a, b3]
b5: $ … ⇒ nvf' w ∈ ω $ by cab_elim [b4]
b6a: $ G , e = ∅ , e ∊ cdm j , w = j' e ⇒ nvf = nvf $ by eq_refl
b6: $ … ⇒ nvf' w = nvf' j' e $ by fv_eq [b6a, b2a]
b7: $ … ⇒ nvf' j' e ∈ ω $ by wcel_eq_l [b6, b5]
b8a: $ G , e = ∅ , e ∊ cdm j , w = j' e ⇒ (ccom nvf j)' e = nvf' j' e $ by weaken [a5]
b8b: $ … ⇒ nvf' j' e = (ccom nvf j)' e $ by eq_sym [b8a]
b8: $ … ⇒ (ccom nvf j)' e ∈ ω $ by wcel_eq_l [b8b, b7]
b9: $ … ⇒ isset (j' e) $ by fv_set [a2]
b10: $ … ⇒ (ccom nvf j)' e ∈ ω $ by isset_elim [b9, b8]
c1a: $ G , e = ∅ , ¬ e ∊ cdm j , e ∊ cdm (ccom nvf j) ⇒ cdm (ccom nvf j) ⊆ cdm j $ by k3_ccom_cdm
c1b: $ G , e = ∅ , ¬ e ∊ cdm j , e ∊ cdm (ccom nvf j) ⇒ e ∊ cdm (ccom nvf j) $ by ax
c1c: $ … ⇒ e ∊ cdm j $ by subset_elim [c1a, c1b]
c1d: $ G , e = ∅ , ¬ e ∊ cdm j , e ∊ cdm (ccom nvf j) ⇒ ¬ e ∊ cdm j $ by ax
c1e: $ … ⇒ ⊥ $ by not_elim [c1d, c1c]
c1: $ … ⇒ e ∊ cdm (ccom nvf j) → ⊥ $ by imp_intro [c1e]
c2: $ … ⇒ (ccom nvf j)' e = ∅ $ by fv_empty [c1]
c3: $ G , e = ∅ , ¬ e ∊ cdm j ⇒ ∅ ∈ ω $ by omega_zero
c4a: $ … ⇒ ∅ = (ccom nvf j)' e $ by eq_sym [c2]
c4: $ … ⇒ (ccom nvf j)' e ∈ ω $ by wcel_eq_l [c4a, c3]
d1: $ G , e = ∅ ⇒ e ∊ cdm j ∨ ¬ e ∊ cdm j $ by excluded_middle
d2: $ … ⇒ (ccom nvf j)' e ∈ ω $ by or_elim [d1, b10, c4]
d3a: $ G , e = ∅ ⇒ e = ∅ $ by ax
d3b: $ G , e = ∅ ⇒ ccom nvf j = ccom nvf j $ by eq_refl
d3: $ … ⇒ (ccom nvf j)' e = (ccom nvf j)' ∅ $ by fv_eq [d3b, d3a]
d4: $ … ⇒ (ccom nvf j)' ∅ ∈ ω $ by wcel_eq_l [d3, d2]
d5: $ G ⇒ isset ∅ $ by ax_empty
d6: $ … ⇒ (ccom nvf j)' ∅ ∈ ω $ by isset_elim [d5, d4]

--| A step of `nvb` on a number is a number (three lemmas, one label case each).
lemma k3_nvb_om3 (G: hyps) (K V: class):
  $ G ⇒ V' ∅ ∈ ω $ > $ G ⇒ ¬ K = kc_s $ > $ G ⇒ ¬ K = kc_bd0 $ > $ G ⇒ nvb K V ∈ ω $
----
m1: $ G , K = kc_bd1 ⇒ V' ∅ ∈ ω $ by weaken [#1]
m2: $ … ⇒ ndbl (V' ∅) ∈ ω $ by nadd_omega_c [m1, m1]
ca: $ G , K = kc_bd1 ⇒ K = kc_bd1 $ by ax
cb: $ G , K = kc_bd1 ⇒ V = V $ by eq_refl
cc: $ … ⇒ nvb K V = nvb kc_bd1 V $ by nvb_eq [ca, cb]
cd: $ G , K = kc_bd1 ⇒ nvb kc_bd1 V = suc (ndbl (V' ∅)) $ by k3_nvb_at_bd1
ce: $ … ⇒ nvb K V = suc (ndbl (V' ∅)) $ by eq_trans [cc, cd]
cf: $ … ⇒ suc (ndbl (V' ∅)) = nvb K V $ by eq_sym [ce]
cg: $ … ⇒ suc (ndbl (V' ∅)) ∈ ω $ by omega_suc_c [m2]
ch: $ … ⇒ nvb K V ∈ ω $ by wcel_eq_l [cf, cg]
z1: $ G , ¬ K = kc_bd1 ⇒ ¬ K = kc_s $ by weaken [#2]
z2: $ G , ¬ K = kc_bd1 ⇒ ¬ K = kc_bd0 $ by weaken [#3]
z3: $ G , ¬ K = kc_bd1 ⇒ ¬ K = kc_bd1 $ by ax
z4: $ … ⇒ nvb K V = ∅ $ by k3_nvb_zero [z1, z2, z3]
z5: $ … ⇒ ∅ = nvb K V $ by eq_sym [z4]
z6: $ G , ¬ K = kc_bd1 ⇒ ∅ ∈ ω $ by omega_zero
z7: $ … ⇒ nvb K V ∈ ω $ by wcel_eq_l [z5, z6]
e1: $ G ⇒ K = kc_bd1 ∨ ¬ K = kc_bd1 $ by excluded_middle
e2: $ … ⇒ nvb K V ∈ ω $ by or_elim [e1, ch, z7]

lemma k3_nvb_om2 (G: hyps) (K V: class):
  $ G ⇒ V' ∅ ∈ ω $ > $ G ⇒ ¬ K = kc_s $ > $ G ⇒ nvb K V ∈ ω $
----
m1: $ G , K = kc_bd0 ⇒ V' ∅ ∈ ω $ by weaken [#1]
ca: $ G , K = kc_bd0 ⇒ K = kc_bd0 $ by ax
cb: $ G , K = kc_bd0 ⇒ V = V $ by eq_refl
cc: $ … ⇒ nvb K V = nvb kc_bd0 V $ by nvb_eq [ca, cb]
cd: $ G , K = kc_bd0 ⇒ nvb kc_bd0 V = ndbl (V' ∅) $ by k3_nvb_at_bd0
ce: $ … ⇒ nvb K V = ndbl (V' ∅) $ by eq_trans [cc, cd]
cf: $ … ⇒ ndbl (V' ∅) = nvb K V $ by eq_sym [ce]
cg: $ … ⇒ ndbl (V' ∅) ∈ ω $ by nadd_omega_c [m1, m1]
ch: $ … ⇒ nvb K V ∈ ω $ by wcel_eq_l [cf, cg]
z1: $ G , ¬ K = kc_bd0 ⇒ V' ∅ ∈ ω $ by weaken [#1]
z2: $ G , ¬ K = kc_bd0 ⇒ ¬ K = kc_s $ by weaken [#2]
z3: $ G , ¬ K = kc_bd0 ⇒ ¬ K = kc_bd0 $ by ax
z4: $ … ⇒ nvb K V ∈ ω $ by k3_nvb_om3 [z1, z2, z3]
e1: $ G ⇒ K = kc_bd0 ∨ ¬ K = kc_bd0 $ by excluded_middle
e2: $ … ⇒ nvb K V ∈ ω $ by or_elim [e1, ch, z4]

lemma k3_nvb_omega (G: hyps) (K V: class): $ G ⇒ V' ∅ ∈ ω $ > $ G ⇒ nvb K V ∈ ω $
----
m1: $ G , K = kc_s ⇒ V' ∅ ∈ ω $ by weaken [#1]
ca: $ G , K = kc_s ⇒ K = kc_s $ by ax
cb: $ G , K = kc_s ⇒ V = V $ by eq_refl
cc: $ … ⇒ nvb K V = nvb kc_s V $ by nvb_eq [ca, cb]
cd: $ G , K = kc_s ⇒ nvb kc_s V = suc (V' ∅) $ by k3_nvb_at_s
ce: $ … ⇒ nvb K V = suc (V' ∅) $ by eq_trans [cc, cd]
cf: $ … ⇒ suc (V' ∅) = nvb K V $ by eq_sym [ce]
cg: $ … ⇒ suc (V' ∅) ∈ ω $ by omega_suc_c [m1]
ch: $ … ⇒ nvb K V ∈ ω $ by wcel_eq_l [cf, cg]
z1: $ G , ¬ K = kc_s ⇒ V' ∅ ∈ ω $ by weaken [#1]
z2: $ G , ¬ K = kc_s ⇒ ¬ K = kc_s $ by ax
z4: $ … ⇒ nvb K V ∈ ω $ by k3_nvb_om2 [z1, z2]
e1: $ G ⇒ K = kc_s ∨ ¬ K = kc_s $ by excluded_middle
e2: $ … ⇒ nvb K V ∈ ω $ by or_elim [e1, ch, z4]

nvf_omega
---------
s1a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_nvo ⇒ j ∊ fseq (trees ω) $ by ax
s1b: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_nvo ⇒ crn j ⊆ k3_nvo $ by ax
s1: $ … ⇒ (ccom nvf j)' ∅ ∈ ω $ by k3_cv0 [s1a, s1b]
s2: $ … ⇒ nvb k (ccom nvf j) ∈ ω $ by k3_nvb_omega [s1]
s3a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_nvo ⇒ k ∊ ω $ by ax
s3: $ … ⇒ nvf' ⟨ k , j ⟩ = nvb k (ccom nvf j) $ by nvf_node [s3a, s1a]
s4a: $ … ⇒ nvb k (ccom nvf j) = nvf' ⟨ k , j ⟩ $ by eq_sym [s3]
s4: $ … ⇒ nvf' ⟨ k , j ⟩ ∈ ω $ by wcel_eq_l [s4a, s2]
s5a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_nvo ⇒ isset ⟨ k , j ⟩ $ by opair_isset
s5b: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_nvo , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
s5c: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_nvo , z = ⟨ k , j ⟩ ⇒ nvf = nvf $ by eq_refl
s5d: $ … ⇒ nvf' z = nvf' ⟨ k , j ⟩ $ by fv_eq [s5c, s5b]
s5e: $ … ⇒ nvf' ⟨ k , j ⟩ = nvf' z $ by eq_sym [s5d]
s5f: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_nvo , z = ⟨ k , j ⟩ ⇒ nvf' ⟨ k , j ⟩ ∈ ω $ by weaken [s4]
s5g: $ … ⇒ nvf' z ∈ ω $ by wcel_eq_l [s5e, s5f]
s5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_nvo ⇒ ⟨ k , j ⟩ ∈ k3_nvo $ by wcel_cab_intro [s5a, s5g]
s6: $ … ⇒ crn j ⊆ k3_nvo → ⟨ k , j ⟩ ∈ k3_nvo $ by imp_intro [s5]
s7: $ … ⇒ j ∊ fseq (trees ω) → crn j ⊆ k3_nvo → ⟨ k , j ⟩ ∈ k3_nvo $ by imp_intro [s6]
s8: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ k3_nvo → ⟨ k , j ⟩ ∈ k3_nvo $ by imp_intro [s7]
s9: $ … ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ k3_nvo → ⟨ k , j ⟩ ∈ k3_nvo) $ by all_intro [s8]
s10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ k3_nvo → ⟨ k , j ⟩ ∈ k3_nvo) $ by all_intro [s9]
s11o: $ G ⇒ isset ω $ by omega_set
s11: $ … ⇒ trees ω ⊆ k3_nvo $ by trees_ind_c [s11o, s10]
t1: $ G , t = T , t ∊ trees ω ⇒ t ∊ trees ω $ by ax
t2: $ G , t = T , t ∊ trees ω ⇒ trees ω ⊆ k3_nvo $ by weaken [s11]
t3: $ … ⇒ t ∊ k3_nvo $ by subset_elim [t2, t1]
t4: $ … ⇒ nvf' t ∈ ω $ by cab_elim [t3]
u1: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm nvf ⇒ cdm nvf = trees ω $ by nvf_cdm
u2: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm nvf ⇒ t ∊ cdm nvf $ by ax
u3: $ … ⇒ t ∊ trees ω $ by welc_eq [u1, u2]
u4: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm nvf ⇒ ¬ t ∊ trees ω $ by ax
u5: $ … ⇒ ⊥ $ by not_elim [u4, u3]
u6: $ … ⇒ t ∊ cdm nvf → ⊥ $ by imp_intro [u5]
u7: $ … ⇒ nvf' t = ∅ $ by fv_empty [u6]
u8: $ … ⇒ ∅ = nvf' t $ by eq_sym [u7]
u9: $ G , t = T , ¬ t ∊ trees ω ⇒ ∅ ∈ ω $ by omega_zero
u10: $ … ⇒ nvf' t ∈ ω $ by wcel_eq_l [u8, u9]
v1: $ G , t = T ⇒ t ∊ trees ω ∨ ¬ t ∊ trees ω $ by excluded_middle
v2: $ … ⇒ nvf' t ∈ ω $ by or_elim [v1, t4, u10]
v3: $ G , t = T ⇒ t = T $ by ax
v4: $ G , t = T ⇒ nvf = nvf $ by eq_refl
v5: $ … ⇒ nvf' t = nvf' T $ by fv_eq [v4, v3]
v6: $ … ⇒ nvf' T ∈ ω $ by wcel_eq_l [v5, v2]
v7: $ … ⇒ nvf' T ∈ ω $ by isset_elim [#1, v6]

--| `A ≤ B` gives `A < suc B` on numbers.
lemma k3_le_suc_c (G: hyps) (A B: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A ⊆ B $ > $ G ⇒ A ∈ suc B $
----
l1: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ a ∊ ω $ by ax
l2: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ b ∊ ω $ by ax
l3: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ a = A $ by ax
l4: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ b = B $ by ax
l5: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ A ⊆ B $ by weaken [#3]
l6: $ … ⇒ A = a $ by eq_sym [l3]
l7: $ … ⇒ a ⊆ B $ by subset_eq_l [l6, l5]
l8: $ … ⇒ B = b $ by eq_sym [l4]
l9: $ … ⇒ a ⊆ b $ by subset_eq_r [l8, l7]
l10: $ … ⇒ a ∊ suc b $ by nle_lt_suc [l1, l2, l9]
l11: $ … ⇒ suc b = suc B $ by suc_eq [l4]
l12: $ … ⇒ a ∊ suc B $ by welc_eq [l11, l10]
l13: $ … ⇒ A ∈ suc B $ by wcel_intro [l3, l12]
l14: $ … ⇒ A ∈ suc B $ by wcel_elim [#2, l13]
l15: $ … ⇒ A ∈ suc B $ by wcel_elim [#1, l14]

--| The successor is monotone on numbers.
lemma k3_suc_mono_c (G: hyps) (A B: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A ⊆ B $ > $ G ⇒ suc A ⊆ suc B $
----
l1: $ G , x ∊ suc A ⇒ x ∊ suc A $ by ax
l2: $ … ⇒ x ∊ A ∨ x = A $ by suc_elim [l1]
l3: $ G , x ∊ suc A , x ∊ A ⇒ x ∊ A $ by ax
l4: $ G , x ∊ suc A , x ∊ A ⇒ A ⊆ B $ by weaken [#3]
l5: $ … ⇒ x ∊ B $ by subset_elim [l4, l3]
l6: $ … ⇒ x ∊ suc B $ by suc_intro_l [l5]
l7: $ … ⇒ A ∈ suc B $ by k3_le_suc_c [#1, #2, #3]
l8: $ G , x ∊ suc A , x = A ⇒ A ∈ suc B $ by weaken [l7]
l9: $ G , x ∊ suc A , x = A ⇒ x = A $ by ax
l10: $ … ⇒ A = x $ by eq_sym [l9]
l11: $ … ⇒ x ∈ suc B $ by wcel_eq_l [l10, l8]
l12: $ … ⇒ x ∊ suc B $ by wcel_welc [l11]
l13: $ … ⇒ x ∊ suc B $ by or_elim [l2, l6, l12]
l14: $ … ⇒ suc A ⊆ suc B $ by subset_intro [l13]

--| The trees whose numbers are below those of every `le` partner.
def k3_lep (.x .y: set): class = $ {x | ∀ y (⟨ kr_le , x +: y +: ∅ ⟩ ∈ lrel → nvf' x ⊆ nvf' y)} $

lrel_le_sem
-----------
e1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_lep , z = ⟨ k , j ⟩ , ra_le z y ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ∧ y = n ⇒ z = ⟨ kc_nz , ∅ ⟩ ∧ y = n $ by ax
e2: $ … ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [e1]
e3a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_lep , z = ⟨ k , j ⟩ , ra_le z y ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ∧ y = n ⇒ nvf = nvf $ by eq_refl
e3: $ … ⇒ nvf' z = nvf' ⟨ kc_nz , ∅ ⟩ $ by fv_eq [e3a, e2]
e4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_lep , z = ⟨ k , j ⟩ , ra_le z y ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ∧ y = n ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
e5: $ … ⇒ nvf' z = ∅ $ by eq_trans [e3, e4]
e6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_lep , z = ⟨ k , j ⟩ , ra_le z y ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ∧ y = n ⇒ ∅ ⊆ nvf' y $ by empty_subset
e7: $ … ⇒ ∅ = nvf' z $ by eq_sym [e5]
e8: $ … ⇒ nvf' z ⊆ nvf' y $ by subset_eq_l [e7, e6]
c0: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_lep , z = ⟨ k , j ⟩ , ra_le z y ∈ lrel , ∃ n (z = ⟨ kc_nz , ∅ ⟩ ∧ y = n) ⇒ ∃ n (z = ⟨ kc_nz , ∅ ⟩ ∧ y = n) $ by ax
c1: $ … ⇒ nvf' z ⊆ nvf' y $ by ex_elim [c0, e8]
f1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_lep , z = ⟨ k , j ⟩ , ra_le z y ∈ lrel , z = ⟨ kc_s , i +: ∅ ⟩ ∧ y = ⟨ kc_s , n +: ∅ ⟩ ∧ ra_le i n ∈ lrel ⇒ z = ⟨ kc_s , i +: ∅ ⟩ ∧ y = ⟨ kc_s , n +: ∅ ⟩ ∧ ra_le i n ∈ lrel $ by ax
f2: $ … ⇒ z = ⟨ kc_s , i +: ∅ ⟩ $ by and_elim_l [f1]
f3: $ … ⇒ y = ⟨ kc_s , n +: ∅ ⟩ ∧ ra_le i n ∈ lrel $ by and_elim_r [f1]
f4: $ … ⇒ y = ⟨ kc_s , n +: ∅ ⟩ $ by and_elim_l [f3]
f5: $ … ⇒ ra_le i n ∈ lrel $ by and_elim_r [f3]
f6k: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ k3_lep , z = ⟨ k , j ⟩ , ra_le z y ∈ lrel , z = ⟨ kc_s , i +: ∅ ⟩ ∧ y = ⟨ kc_s , n +: ∅ ⟩ ∧ ra_le i n ∈ lrel ⇒ kr_le ∈ ω $ by kr_le_omega
f6i: $ … ⇒ isset kr_le $ by wcel_isset [f6k]
