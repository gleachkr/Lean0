l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl (ls a) ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl (ls b) ∈ trees ω $ by enc_lvl_trees
l4: $ … ⇒ lv (enc_lvl (lmax (ls a) (ls b))) x = nmax (lv (enc_lvl (ls a)) x) (lv (enc_lvl (ls b)) x) $ by lv_lmax [l2, l3, l1]
