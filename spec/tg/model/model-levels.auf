l7: $ x ∊ lvals ⇒ lv (enc_lvl lz) x = ∅ $ by lv_lz
l8: $ … ⇒ suc (lv (enc_lvl lz) x) = suc ∅ $ by suc_eq [l7]
l9: $ … ⇒ lv (enc_lvl (ls lz)) x = suc ∅ $ by eq_trans [l6, l8]
l10: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
