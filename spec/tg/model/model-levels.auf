limax_max
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl (lmax b c) ∈ trees ω $ by enc_lvl_trees
l4: $ … ⇒ lv (enc_lvl (limax a (lmax b c))) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl (lmax b c)) x) $ by lv_limax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l7: $ … ⇒ lv (enc_lvl (lmax b c)) x = nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x) $ by lv_lmax [l5, l6, l1]
l8: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l9: $ … ⇒ nimax (lv (enc_lvl a) x) (lv (enc_lvl (lmax b c)) x) = nimax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nimax_eq [l8, l7]
l10: $ … ⇒ lv (enc_lvl (limax a (lmax b c))) x = nimax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by eq_trans [l4, l9]
l11: $ x ∊ lvals ⇒ enc_lvl (limax a b) ∈ trees ω $ by enc_lvl_trees
l12: $ x ∊ lvals ⇒ enc_lvl (limax a c) ∈ trees ω $ by enc_lvl_trees
l13: $ … ⇒ lv (enc_lvl (lmax (limax a b) (limax a c))) x = nmax (lv (enc_lvl (limax a b)) x) (lv (enc_lvl (limax a c)) x) $ by lv_lmax [l11, l12, l1]
l14: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l15: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l16: $ … ⇒ lv (enc_lvl (limax a b)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl b) x) $ by lv_limax [l14, l15, l1]
l17: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l18: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l19: $ … ⇒ lv (enc_lvl (limax a c)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x) $ by lv_limax [l17, l18, l1]
l20: $ … ⇒ nmax (lv (enc_lvl (limax a b)) x) (lv (enc_lvl (limax a c)) x) = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) $ by nmax_eq [l16, l19]
l21: $ … ⇒ lv (enc_lvl (lmax (limax a b) (limax a c))) x = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) $ by eq_trans [l13, l20]
l22: $ … ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l23: $ … ⇒ lv (enc_lvl b) x ∈ ω $ by k6_lvo [l1]
l24: $ … ⇒ lv (enc_lvl c) x ∈ ω $ by k6_lvo [l1]
l25: $ … ⇒ nimax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) $ by nimax_nmax_c [l22, l23, l24]
l26: $ … ⇒ lv (enc_lvl (limax a (lmax b c))) x = lv (enc_lvl (lmax (limax a b) (limax a c))) x $ by k6_eq3 [l10, l21, l25]
l27: $ leqv (limax a (lmax b c)) (lmax (limax a b) (limax a c)) $ by leqv_i [l26]

limax_imax
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl (limax b c) ∈ trees ω $ by enc_lvl_trees
l4: $ … ⇒ lv (enc_lvl (limax a (limax b c))) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl (limax b c)) x) $ by lv_limax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l7: $ … ⇒ lv (enc_lvl (limax b c)) x = nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x) $ by lv_limax [l5, l6, l1]
l8: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l9: $ … ⇒ nimax (lv (enc_lvl a) x) (lv (enc_lvl (limax b c)) x) = nimax (lv (enc_lvl a) x) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nimax_eq [l8, l7]
l10: $ … ⇒ lv (enc_lvl (limax a (limax b c))) x = nimax (lv (enc_lvl a) x) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by eq_trans [l4, l9]
l11: $ x ∊ lvals ⇒ enc_lvl (limax a c) ∈ trees ω $ by enc_lvl_trees
l12: $ x ∊ lvals ⇒ enc_lvl (limax b c) ∈ trees ω $ by enc_lvl_trees
l13: $ … ⇒ lv (enc_lvl (lmax (limax a c) (limax b c))) x = nmax (lv (enc_lvl (limax a c)) x) (lv (enc_lvl (limax b c)) x) $ by lv_lmax [l11, l12, l1]
l14: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l15: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l16: $ … ⇒ lv (enc_lvl (limax a c)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x) $ by lv_limax [l14, l15, l1]
l17: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l18: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l19: $ … ⇒ lv (enc_lvl (limax b c)) x = nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x) $ by lv_limax [l17, l18, l1]
l20: $ … ⇒ nmax (lv (enc_lvl (limax a c)) x) (lv (enc_lvl (limax b c)) x) = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nmax_eq [l16, l19]
l21: $ … ⇒ lv (enc_lvl (lmax (limax a c) (limax b c))) x = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by eq_trans [l13, l20]
l22: $ … ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l23: $ … ⇒ lv (enc_lvl b) x ∈ ω $ by k6_lvo [l1]
l24: $ … ⇒ lv (enc_lvl c) x ∈ ω $ by k6_lvo [l1]
l25: $ … ⇒ nimax (lv (enc_lvl a) x) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nimax_nimax_c [l22, l23, l24]
l26: $ … ⇒ lv (enc_lvl (limax a (limax b c))) x = lv (enc_lvl (lmax (limax a c) (limax b c))) x $ by k6_eq3 [l10, l21, l25]
l27: $ leqv (limax a (limax b c)) (lmax (limax a c) (limax b c)) $ by leqv_i [l26]

lemma k6_lc0 (G: hyps) (n: nat) (l l0: lvl) (x k: set):
  $ lsubst n l lz l0 $ > $ G ⇒ x ∊ lvals $ > $ G ⇒ k = nvf' (enc_nat n) $ >
  $ G ⇒ ap x k = ∅ $ > $ G ⇒ k ∊ ω $ >
  $ G ⇒ lv (enc_lvl l0) x = lv (enc_lvl l) x $
----
l1: $ … ⇒ lv (enc_lvl l0) x = lv (enc_lvl l) (lupd x (nvf' (enc_nat n)) (lv (enc_lvl lz) x)) $ by lsubst_sem [#1, #2]
l2: $ G ⇒ x = x $ by eq_refl
l3: $ … ⇒ nvf' (enc_nat n) = k $ by eq_sym [#3]
l4: $ G ⇒ lv (enc_lvl lz) x = ∅ $ by lv_lz
l5: $ … ⇒ ∅ = ap x k $ by eq_sym [#4]
l6: $ … ⇒ lv (enc_lvl lz) x = ap x k $ by eq_trans [l4, l5]
l7: $ … ⇒ lupd x (nvf' (enc_nat n)) (lv (enc_lvl lz) x) = lupd x k (ap x k) $ by lupd_eq [l2, l3, l6]
l8: $ … ⇒ lupd x k (ap x k) = x $ by lupd_self [#2, #5]
l9: $ … ⇒ lupd x (nvf' (enc_nat n)) (lv (enc_lvl lz) x) = x $ by eq_trans [l7, l8]
l10: $ G ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l11: $ … ⇒ lv (enc_lvl l) (lupd x (nvf' (enc_nat n)) (lv (enc_lvl lz) x)) = lv (enc_lvl l) x $ by lv_eq [l10, l9]
l12: $ … ⇒ lv (enc_lvl l0) x = lv (enc_lvl l) x $ by eq_trans [l1, l11]

lemma k6_lcs1 (G: hyps) (n: nat) (l l1: lvl) (x k j m t: set):
  $ lsubst n l (ls (lparam n)) l1 $ > $ G ⇒ x ∊ lvals $ > $ G ⇒ k = nvf' (enc_nat n) $ >
  $ G ⇒ ap x k = j $ > $ G ⇒ j = suc m $ > $ G ⇒ k ∊ ω $ > $ G ⇒ t = lupd x k m $ >
  $ G ⇒ t ∊ lvals $ >
  $ G ⇒ lv (enc_lvl l1) t = lv (enc_lvl l) x $
----
l1: $ … ⇒ lv (enc_lvl l1) t = lv (enc_lvl l) (lupd t (nvf' (enc_nat n)) (lv (enc_lvl (ls (lparam n))) t)) $ by lsubst_sem [#1, #8]
l2: $ G ⇒ enc_lvl (lparam n) ∈ trees ω $ by enc_lvl_trees
l3: $ … ⇒ lv (enc_lvl (ls (lparam n))) t = suc (lv (enc_lvl (lparam n)) t) $ by lv_ls [l2, #8]
l4: $ G ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l5: $ … ⇒ lv (enc_lvl (lparam n)) t = ap t (nvf' (enc_nat n)) $ by lv_lparam [l4, #8]
l6: $ … ⇒ nvf' (enc_nat n) = k $ by eq_sym [#3]
l7: $ … ⇒ ap t (nvf' (enc_nat n)) = ap (lupd x k m) k $ by ap_eq [#7, l6]
l8: $ … ⇒ ap (lupd x k m) k = m $ by lupd_ap_eq [#6]
l9: $ … ⇒ ap t (nvf' (enc_nat n)) = m $ by eq_trans [l7, l8]
l10: $ … ⇒ lv (enc_lvl (lparam n)) t = m $ by eq_trans [l5, l9]
l11: $ … ⇒ suc (lv (enc_lvl (lparam n)) t) = suc m $ by suc_eq [l10]
l12: $ … ⇒ suc m = j $ by eq_sym [#5]
l13: $ … ⇒ suc (lv (enc_lvl (lparam n)) t) = j $ by eq_trans [l11, l12]
l14: $ … ⇒ lv (enc_lvl (ls (lparam n))) t = j $ by eq_trans [l3, l13]
l15: $ … ⇒ lupd t (nvf' (enc_nat n)) (lv (enc_lvl (ls (lparam n))) t) = lupd (lupd x k m) k j $ by lupd_eq [#7, l6, l14]
l16: $ G ⇒ lupd (lupd x k m) k j = lupd x k j $ by lupd_twice
l17: $ G ⇒ x = x $ by eq_refl
l18: $ G ⇒ k = k $ by eq_refl
l19: $ … ⇒ j = ap x k $ by eq_sym [#4]
l20: $ … ⇒ lupd x k j = lupd x k (ap x k) $ by lupd_eq [l17, l18, l19]
l21: $ … ⇒ lupd x k (ap x k) = x $ by lupd_self [#2, #6]
l22: $ … ⇒ lupd x k j = x $ by eq_trans [l20, l21]
l23: $ … ⇒ lupd (lupd x k m) k j = x $ by eq_trans [l16, l22]
l24: $ … ⇒ lupd t (nvf' (enc_nat n)) (lv (enc_lvl (ls (lparam n))) t) = x $ by eq_trans [l15, l23]
l25: $ G ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l26: $ … ⇒ lv (enc_lvl l) (lupd t (nvf' (enc_nat n)) (lv (enc_lvl (ls (lparam n))) t)) = lv (enc_lvl l) x $ by lv_eq [l25, l24]
l27: $ … ⇒ lv (enc_lvl l1) t = lv (enc_lvl l) x $ by eq_trans [l1, l26]

lemma k6_lcs (G: hyps) (n: nat) (l r l1 r1: lvl) (x k j m: set):
  $ lsubst n l (ls (lparam n)) l1 $ > $ lsubst n r (ls (lparam n)) r1 $ > $ leqv l1 r1 $ >
  $ G ⇒ x ∊ lvals $ > $ G ⇒ k = nvf' (enc_nat n) $ > $ G ⇒ ap x k = j $ > $ G ⇒ j = suc m $ >
  $ G ⇒ k ∊ ω $ > $ G ⇒ m ∊ ω $ >
  $ G ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $
----
l1: $ … ⇒ lupd x k m ∈ lvals $ by lupd_lvals [#4, #9]
l2: $ G , t = lupd x k m , t ∊ lvals ⇒ x ∊ lvals $ by weaken [#4]
l3: $ G , t = lupd x k m , t ∊ lvals ⇒ k = nvf' (enc_nat n) $ by weaken [#5]
l4: $ G , t = lupd x k m , t ∊ lvals ⇒ ap x k = j $ by weaken [#6]
l5: $ G , t = lupd x k m , t ∊ lvals ⇒ j = suc m $ by weaken [#7]
l6: $ G , t = lupd x k m , t ∊ lvals ⇒ k ∊ ω $ by weaken [#8]
l7: $ G , t = lupd x k m , t ∊ lvals ⇒ t = lupd x k m $ by ax
l8: $ G , t = lupd x k m , t ∊ lvals ⇒ t ∊ lvals $ by ax
l9: $ … ⇒ lv (enc_lvl l1) t = lv (enc_lvl l) x $ by k6_lcs1 [#1, l2, l3, l4, l5, l6, l7, l8]
l10: $ … ⇒ lv (enc_lvl r1) t = lv (enc_lvl r) x $ by k6_lcs1 [#2, l2, l3, l4, l5, l6, l7, l8]
l11: $ … ⇒ lv (enc_lvl l1) t = lv (enc_lvl r1) t $ by leqv_e [#3, l8]
l12: $ … ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by k6_eq3s [l9, l10, l11]
l13: $ … ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by wcel_elim [l1, l12]

leqv_cases
----------
l2: $ x ∊ lvals ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l3: $ … ⇒ isset (enc_nat n) $ by wcel_isset [l2]
l4: $ … ⇒ nvf' (enc_nat n) ∈ ω $ by nvf_omega [l3]
l5: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω ⇒ x ∊ lvals $ by ax
l6: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω ⇒ k ∊ ω $ by ax
l7: $ … ⇒ ap x k ∈ ω $ by lvals_ap [l5, l6]
l8: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω ⇒ j ∊ ω $ by ax
l9: $ … ⇒ j = ∅ ∨ ∃ y (y ∊ ω ∧ j = suc y) $ by omega_cases [l8]
l10: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ x ∊ lvals $ by ax
l11: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ k = nvf' (enc_nat n) $ by ax
l12: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ k ∊ ω $ by ax
l13: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ j = ap x k $ by ax
l14: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ j = ∅ $ by ax
l15: $ … ⇒ ap x k = j $ by eq_sym [l13]
l16: $ … ⇒ ap x k = ∅ $ by eq_trans [l15, l14]
l17: $ … ⇒ lv (enc_lvl l0) x = lv (enc_lvl l) x $ by k6_lc0 [#1, l10, l11, l16, l12]
l18: $ … ⇒ lv (enc_lvl r0) x = lv (enc_lvl r) x $ by k6_lc0 [#2, l10, l11, l16, l12]
l19: $ … ⇒ lv (enc_lvl l0) x = lv (enc_lvl r0) x $ by leqv_e [#3, l10]
l20: $ … ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by k6_eq3s [l17, l18, l19]
l21: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ y ∊ ω ∧ j = suc y $ by ax
l22: $ … ⇒ y ∊ ω $ by and_elim_l [l21]
l23: $ … ⇒ j = suc y $ by and_elim_r [l21]
l24: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ x ∊ lvals $ by ax
l25: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ k = nvf' (enc_nat n) $ by ax
l26: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ k ∊ ω $ by ax
l27: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ j = ap x k $ by ax
l28: $ … ⇒ ap x k = j $ by eq_sym [l27]
l29: $ … ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by k6_lcs [#4, #5, #6, l24, l25, l28, l23, l26, l22]
l30: $ x ∊ lvals , k = nvf' (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , ∃ y (y ∊ ω ∧ j = suc y) ⇒ ∃ y (y ∊ ω ∧ j = suc y) $ by ax
l31: $ … ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by ex_elim [l30, l29]
l32: $ … ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by or_elim [l9, l20, l31]
l33: $ … ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by wcel_elim [l7, l32]
l34: $ … ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by wcel_elim [l4, l33]
l35: $ leqv l r $ by leqv_i [l34]

leqv_inst
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ … ⇒ lv (enc_lvl l2) x = lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) $ by linst_sem [#2, l1]
l3: $ … ⇒ lv (enc_lvl r2) x = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by linst_sem [#3, l1]
l4: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ y = lsv (enc_lvls S) x $ by ax
l5: $ … ⇒ lsub y = lsub (lsv (enc_lvls S) x) $ by lsub_eq [l4]
l6: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ z = lsub y $ by ax
l7: $ … ⇒ z = lsub (lsv (enc_lvls S) x) $ by eq_trans [l6, l5]
l8: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ z ∊ lvals $ by ax
l9: $ … ⇒ lv (enc_lvl l) z = lv (enc_lvl r) z $ by leqv_e [#1, l8]
l10: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l11: $ … ⇒ lv (enc_lvl l) z = lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) $ by lv_eq [l10, l7]
l12: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ enc_lvl r = enc_lvl r $ by eq_refl
l13: $ … ⇒ lv (enc_lvl r) z = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by lv_eq [l12, l7]
l14: $ … ⇒ lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by k6_eq3s [l11, l13, l9]
l15: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω ⇒ y ∊ fseq ω $ by ax
l16: $ … ⇒ lsub y ∈ lvals $ by lsub_lvals [l15]
l17: $ … ⇒ lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by wcel_elim [l16, l14]
l18: $ x ∊ lvals ⇒ enc_lvls S ∈ trees ω $ by enc_lvls_trees
l19: $ … ⇒ isset (enc_lvls S) $ by wcel_isset [l18]
l20: $ … ⇒ lsv (enc_lvls S) x ∈ fseq ω $ by lsv_fseq [l19, l1]
l21: $ … ⇒ lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by wcel_elim [l20, l17]
l22: $ … ⇒ lv (enc_lvl l2) x = lv (enc_lvl r2) x $ by k6_eq3 [l2, l3, l21]
l23: $ leqv l2 r2 $ by leqv_i [l22]
