l4: $ … ⇒ ⟨ K , A +: B +: ∅ ⟩ = ⟨ K , D +: B +: ∅ ⟩ $ by opair_eq [l3, l2]
l5: $ … ⇒ ⟨ K , D +: B +: ∅ ⟩ ∈ lrel $ by wcel_eq_l [l4, #1]

lemma k5_lt_ne (G: hyps) (m n i: set):
  $ G ⇒ ra_le ⟨ kc_s , m +: ∅ ⟩ n ∈ lrel $ > $ G ⇒ m ∈ trees ω $ > $ G ⇒ nvf' n = i $ > $ G ⇒ ¬ nvf' m = i $
----
l1: $ G , r = ⟨ kc_s , m +: ∅ ⟩ ⇒ r = ⟨ kc_s , m +: ∅ ⟩ $ by ax
l2: $ … ⇒ ⟨ kc_s , m +: ∅ ⟩ = r $ by eq_sym [l1]
l3: $ G , r = ⟨ kc_s , m +: ∅ ⟩ ⇒ ra_le ⟨ kc_s , m +: ∅ ⟩ n ∈ lrel $ by weaken [#1]
