h2: $ … ⇒ C ∈ trees ω $ by crn_scons_head_trees [om, c2]
k1: $ … ⇒ B ∈ trees ω ∧ C ∈ trees ω $ by and_intro [h1, h2]
k0: $ … ⇒ A ∈ trees ω ∧ B ∈ trees ω ∧ C ∈ trees ω $ by and_intro [h0, k1]

lrel_args4_c
------------
l1: $ … ⇒ ⟨ K , A +: B +: C +: D +: ∅ ⟩ ∈ latoms $ by lrel_latoms [#1]
om: $ G ⇒ isset ω $ by omega_set
e0: $ G ⇒ isset ∅ $ by ax_empty
e1: $ … ⇒ isset (D +: ∅) $ by scons_set [e0]
e2: $ … ⇒ isset (C +: D +: ∅) $ by scons_set [e1]
e3: $ … ⇒ isset (B +: C +: D +: ∅) $ by scons_set [e2]
e4: $ … ⇒ isset (A +: B +: C +: D +: ∅) $ by scons_set [e3]
m1: $ … ⇒ K ∈ ω ∧ A +: B +: C +: D +: ∅ ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, #2, e4]
m2: $ … ⇒ A +: B +: C +: D +: ∅ ∈ fseq (trees ω) $ by and_elim_r [m1]
c0: $ … ⇒ crn (A +: B +: C +: D +: ∅) ⊆ trees ω $ by fseq_crn_c [m2]
h0: $ … ⇒ A ∈ trees ω $ by crn_scons_head_trees [om, c0]
c1: $ … ⇒ crn (B +: C +: D +: ∅) ⊆ trees ω $ by crn_scons_tail [c0]
