l13: $ … ⇒ nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl a) x)) = suc (lv (enc_lvl a) x) $ by nmax_suc_self_c [l12]
l14: $ … ⇒ lv (enc_lvl (lmax a (ls a))) x = lv (enc_lvl (ls a)) x $ by k6_eq3 [l9, l11, l13]
