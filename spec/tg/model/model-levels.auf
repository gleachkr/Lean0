l3: $ … ⇒ ∃ y (y ∊ B) $ by and_elim_r [l2]
l4: $ G , y ∊ B ⇒ y ∊ B $ by ax
l5: $ G , y ∊ B ⇒ B = ∅ $ by weaken [#1]
