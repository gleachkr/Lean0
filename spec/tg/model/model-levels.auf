l22: $ (λₛ x ∈ lvals, nimax (ap (E' ∅) x) (ap (E' (suc ∅)) x)) ≐ (λₛ x ∈ lvals, nimax (ap (F' ∅) x) (ap (F' (suc ∅)) x)) $ by clam_congr [l5, l21]
l23: $ (z ∊ (λₛ x ∈ lvals, nimax (ap (E' ∅) x) (ap (E' (suc ∅)) x))) ⟺ (z ∊ (λₛ x ∈ lvals, nimax (ap (F' ∅) x) (ap (F' (suc ∅)) x))) $ by welc_congr [l7, l22]
l24: $ kc_limax ≐ kc_limax $ by ceqt_refl
