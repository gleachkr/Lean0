-----------
l1: $ G , y = A , z = B , z ∊ ω ⇒ y = A $ by ax
l2: $ G , y = A , z = B , z ∊ ω ⇒ z = B $ by ax
l3: $ G , y = A , z = B , z ∊ ω ⇒ z ∊ ω $ by ax
l4: $ … ⇒ nimax y (suc z) = nmax y (suc z) $ by nimax_suc [l3]
l5: $ … ⇒ suc z = suc B $ by suc_eq [l2]
l6: $ … ⇒ nimax y (suc z) = nimax A (suc B) $ by nimax_eq [l1, l5]
l7: $ … ⇒ suc z = suc B $ by suc_eq [l2]
l8: $ … ⇒ nmax y (suc z) = nmax A (suc B) $ by nmax_eq [l1, l7]
l9: $ … ⇒ nimax A (suc B) = nmax A (suc B) $ by k6_eq3s [l6, l8, l4]
l10: $ … ⇒ nimax A (suc B) = nmax A (suc B) $ by wcel_elim [#2, l9]
l11: $ … ⇒ nimax A (suc B) = nmax A (suc B) $ by isset_elim [#1, l10]

nimax_self
----------
l1: $ … ⇒ ∅ ∈ a ∨ ∅ = a $ by omega_zero_le [#1]
c1: $ G , ∅ ∈ a ⇒ ∅ ∈ a $ by ax
c2: $ … ⇒ nimax a a = nmax a a $ by k1_nimax_wpos_c [c1]
c3: $ G , ∅ ∈ a ⇒ nmax a a = a $ by nmax_idem
c4: $ … ⇒ nimax a a = a $ by eq_trans [c2, c3]
d1: $ G , ∅ = a ⇒ ∅ = a $ by ax
d2s: $ … ⇒ a = ∅ $ by eq_sym [d1]
d2: $ … ⇒ nimax a a = ∅ $ by nimax_zero_c [d2s]
d3: $ … ⇒ nimax a a = a $ by eq_trans [d2, d1]
l2: $ … ⇒ nimax a a = a $ by or_elim [l1, c4, d3]

nimax_self_c
------------
l1: $ G , y = A , y ∊ ω ⇒ y = A $ by ax
l2: $ G , y = A , y ∊ ω ⇒ y ∊ ω $ by ax
l3: $ … ⇒ nimax y y = y $ by nimax_self [l2]
l4: $ … ⇒ nimax y y = nimax A A $ by nimax_eq [l1, l1]
l5: $ … ⇒ nimax A A = A $ by k6_eq3s [l4, l1, l3]
l6: $ … ⇒ nimax A A = A $ by wcel_elim [#1, l5]

lemma k1_cun_distr (G: hyps) (A B C: class): $ G ⇒ A ∪ (B ∪ C) = (A ∪ B) ∪ (A ∪ C) $
----
l1: $ G ⇒ A ⊆ A ∪ B $ by cun_subset_l
l2: $ G ⇒ A ∪ B ⊆ (A ∪ B) ∪ (A ∪ C) $ by cun_subset_l
l3: $ G ⇒ A ∪ C ⊆ (A ∪ B) ∪ (A ∪ C) $ by cun_subset_r
l4: $ … ⇒ A ⊆ (A ∪ B) ∪ (A ∪ C) $ by subset_trans [l1, l2]
l5: $ G ⇒ B ⊆ A ∪ B $ by cun_subset_r
l6: $ … ⇒ B ⊆ (A ∪ B) ∪ (A ∪ C) $ by subset_trans [l5, l2]
l7: $ G ⇒ C ⊆ A ∪ C $ by cun_subset_r
l8: $ … ⇒ C ⊆ (A ∪ B) ∪ (A ∪ C) $ by subset_trans [l7, l3]
l9: $ … ⇒ B ∪ C ⊆ (A ∪ B) ∪ (A ∪ C) $ by cun_least [l6, l8]
l10: $ … ⇒ A ∪ (B ∪ C) ⊆ (A ∪ B) ∪ (A ∪ C) $ by cun_least [l4, l9]
m1: $ G ⇒ A ⊆ A ∪ (B ∪ C) $ by cun_subset_l
m2: $ G ⇒ B ∪ C ⊆ A ∪ (B ∪ C) $ by cun_subset_r
m3: $ G ⇒ B ⊆ B ∪ C $ by cun_subset_l
m4: $ G ⇒ C ⊆ B ∪ C $ by cun_subset_r
m5: $ … ⇒ B ⊆ A ∪ (B ∪ C) $ by subset_trans [m3, m2]
m6: $ … ⇒ C ⊆ A ∪ (B ∪ C) $ by subset_trans [m4, m2]
m7: $ … ⇒ A ∪ B ⊆ A ∪ (B ∪ C) $ by cun_least [m1, m5]
m8: $ … ⇒ A ∪ C ⊆ A ∪ (B ∪ C) $ by cun_least [m1, m6]
m9: $ … ⇒ (A ∪ B) ∪ (A ∪ C) ⊆ A ∪ (B ∪ C) $ by cun_least [m7, m8]
l11: $ … ⇒ A ∪ (B ∪ C) = (A ∪ B) ∪ (A ∪ C) $ by subset_antisym [l10, m9]

nimax_nmax
----------
l1: $ … ⇒ ∅ ∈ b ∨ ∅ = b $ by omega_zero_le [#2]
l2: $ … ⇒ ∅ ∈ c ∨ ∅ = c $ by omega_zero_le [#3]
b1: $ G , ∅ = b ⇒ ∅ = b $ by ax
b2s: $ … ⇒ b = ∅ $ by eq_sym [b1]
b2: $ … ⇒ nimax a b = ∅ $ by nimax_zero_c [b2s]
b3: $ G , ∅ = b ⇒ ∅ ⊆ c $ by empty_subset
b4: $ … ⇒ b ⊆ c $ by subset_eq_l [b1, b3]
b5: $ … ⇒ nmax b c = c $ by nmax_eq_r_c [b4]
b6: $ G , ∅ = b ⇒ a = a $ by eq_refl
b7: $ … ⇒ nimax a (nmax b c) = nimax a c $ by nimax_eq [b6, b5]
b8: $ G , ∅ = b ⇒ nimax a c = nimax a c $ by eq_refl
b9: $ … ⇒ nmax (nimax a b) (nimax a c) = nmax ∅ (nimax a c) $ by nmax_eq [b2, b8]
b10: $ G , ∅ = b ⇒ ∅ ⊆ nimax a c $ by empty_subset
b11: $ … ⇒ nmax ∅ (nimax a c) = nimax a c $ by nmax_eq_r_c [b10]
b12: $ … ⇒ nmax (nimax a b) (nimax a c) = nimax a c $ by eq_trans [b9, b11]
b13: $ … ⇒ nimax a c = nmax (nimax a b) (nimax a c) $ by eq_sym [b12]
b14: $ … ⇒ nimax a (nmax b c) = nmax (nimax a b) (nimax a c) $ by eq_trans [b7, b13]
d1: $ G , ∅ ∈ b , ∅ = c ⇒ ∅ = c $ by ax
d2s: $ … ⇒ c = ∅ $ by eq_sym [d1]
d2: $ … ⇒ nimax a c = ∅ $ by nimax_zero_c [d2s]
d3: $ G , ∅ ∈ b , ∅ = c ⇒ ∅ ⊆ b $ by empty_subset
d4: $ … ⇒ c ⊆ b $ by subset_eq_l [d1, d3]
d5: $ … ⇒ nmax b c = b $ by nmax_eq_l_c [d4]
d6: $ G , ∅ ∈ b , ∅ = c ⇒ a = a $ by eq_refl
d7: $ … ⇒ nimax a (nmax b c) = nimax a b $ by nimax_eq [d6, d5]
d8: $ G , ∅ ∈ b , ∅ = c ⇒ nimax a b = nimax a b $ by eq_refl
d9: $ … ⇒ nmax (nimax a b) (nimax a c) = nmax (nimax a b) ∅ $ by nmax_eq [d8, d2]
d10: $ G , ∅ ∈ b , ∅ = c ⇒ ∅ ⊆ nimax a b $ by empty_subset
d11: $ … ⇒ nmax (nimax a b) ∅ = nimax a b $ by nmax_eq_l_c [d10]
d12: $ … ⇒ nmax (nimax a b) (nimax a c) = nimax a b $ by eq_trans [d9, d11]
d13: $ … ⇒ nimax a b = nmax (nimax a b) (nimax a c) $ by eq_sym [d12]
d14: $ … ⇒ nimax a (nmax b c) = nmax (nimax a b) (nimax a c) $ by eq_trans [d7, d13]
f1: $ G , ∅ ∈ b , ∅ ∈ c ⇒ ∅ ∈ b $ by ax
f2: $ G , ∅ ∈ b , ∅ ∈ c ⇒ ∅ ∈ c $ by ax
f3: $ G , ∅ ∈ b , ∅ ∈ c ⇒ b ⊆ nmax b c $ by cun_subset_l
f4: $ … ⇒ ∅ ∈ nmax b c $ by wcel_subset [f3, f1]
f5: $ … ⇒ nimax a (nmax b c) = nmax a (nmax b c) $ by k1_nimax_wpos_c [f4]
f6: $ … ⇒ nimax a b = nmax a b $ by k1_nimax_wpos_c [f1]
f7: $ … ⇒ nimax a c = nmax a c $ by k1_nimax_wpos_c [f2]
f8: $ … ⇒ nmax (nimax a b) (nimax a c) = nmax (nmax a b) (nmax a c) $ by nmax_eq [f6, f7]
f9: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nmax a (nmax b c) = nmax (nmax a b) (nmax a c) $ by k1_cun_distr
f10: $ … ⇒ nmax (nmax a b) (nmax a c) = nmax (nimax a b) (nimax a c) $ by eq_sym [f8]
f11: $ … ⇒ nimax a (nmax b c) = nmax (nmax a b) (nmax a c) $ by eq_trans [f5, f9]
f12: $ … ⇒ nimax a (nmax b c) = nmax (nimax a b) (nimax a c) $ by eq_trans [f11, f10]
g1: $ G , ∅ ∈ b ⇒ ∅ ∈ c ∨ ∅ = c $ by weaken [l2]
g2: $ … ⇒ nimax a (nmax b c) = nmax (nimax a b) (nimax a c) $ by or_elim [g1, f12, d14]
l3: $ … ⇒ nimax a (nmax b c) = nmax (nimax a b) (nimax a c) $ by or_elim [l1, g2, b14]

nimax_nmax_c
------------
l1: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ y = A $ by ax
l2: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ z = B $ by ax
l3: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ u = C $ by ax
l4: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ y ∊ ω $ by ax
l5: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ z ∊ ω $ by ax
l6: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ u ∊ ω $ by ax
l7: $ … ⇒ nimax y (nmax z u) = nmax (nimax y z) (nimax y u) $ by nimax_nmax [l4, l5, l6]
l8: $ … ⇒ nmax z u = nmax B C $ by nmax_eq [l2, l3]
l9: $ … ⇒ nimax y (nmax z u) = nimax A (nmax B C) $ by nimax_eq [l1, l8]
l10: $ … ⇒ nimax y z = nimax A B $ by nimax_eq [l1, l2]
l11: $ … ⇒ nimax y u = nimax A C $ by nimax_eq [l1, l3]
l12: $ … ⇒ nmax (nimax y z) (nimax y u) = nmax (nimax A B) (nimax A C) $ by nmax_eq [l10, l11]
l13: $ … ⇒ nimax A (nmax B C) = nmax (nimax A B) (nimax A C) $ by k6_eq3s [l9, l12, l7]
l14: $ … ⇒ nimax A (nmax B C) = nmax (nimax A B) (nimax A C) $ by wcel_elim [#3, l13]
l15: $ … ⇒ nimax A (nmax B C) = nmax (nimax A B) (nimax A C) $ by wcel_elim [#2, l14]
l16: $ … ⇒ nimax A (nmax B C) = nmax (nimax A B) (nimax A C) $ by wcel_elim [#1, l15]

lemma k1_cun_distr2 (G: hyps) (A B C: class): $ G ⇒ A ∪ (B ∪ C) = (A ∪ C) ∪ (B ∪ C) $
----
l1: $ G ⇒ A ⊆ A ∪ C $ by cun_subset_l
l2: $ G ⇒ A ∪ C ⊆ (A ∪ C) ∪ (B ∪ C) $ by cun_subset_l
l3: $ G ⇒ B ∪ C ⊆ (A ∪ C) ∪ (B ∪ C) $ by cun_subset_r
l4: $ … ⇒ A ⊆ (A ∪ C) ∪ (B ∪ C) $ by subset_trans [l1, l2]
l5: $ … ⇒ A ∪ (B ∪ C) ⊆ (A ∪ C) ∪ (B ∪ C) $ by cun_least [l4, l3]
m1: $ G ⇒ A ⊆ A ∪ (B ∪ C) $ by cun_subset_l
m2: $ G ⇒ B ∪ C ⊆ A ∪ (B ∪ C) $ by cun_subset_r
m3: $ G ⇒ C ⊆ B ∪ C $ by cun_subset_r
m4: $ … ⇒ C ⊆ A ∪ (B ∪ C) $ by subset_trans [m3, m2]
m5: $ … ⇒ A ∪ C ⊆ A ∪ (B ∪ C) $ by cun_least [m1, m4]
m6: $ … ⇒ (A ∪ C) ∪ (B ∪ C) ⊆ A ∪ (B ∪ C) $ by cun_least [m5, m2]
l6: $ … ⇒ A ∪ (B ∪ C) = (A ∪ C) ∪ (B ∪ C) $ by subset_antisym [l5, m6]

nimax_nimax
-----------
l1: $ … ⇒ ∅ ∈ c ∨ ∅ = c $ by omega_zero_le [#3]
b1: $ G , ∅ = c ⇒ ∅ = c $ by ax
b2s: $ … ⇒ c = ∅ $ by eq_sym [b1]
b2: $ … ⇒ nimax b c = ∅ $ by nimax_zero_c [b2s]
b3s: $ … ⇒ c = ∅ $ by eq_sym [b1]
b3: $ … ⇒ nimax a c = ∅ $ by nimax_zero_c [b3s]
b4: $ … ⇒ nimax a (nimax b c) = ∅ $ by nimax_zero_c [b2]
b5: $ … ⇒ nmax (nimax a c) (nimax b c) = nmax ∅ ∅ $ by nmax_eq [b3, b2]
b6: $ G , ∅ = c ⇒ ∅ ⊆ ∅ $ by empty_subset
b7: $ … ⇒ nmax ∅ ∅ = ∅ $ by nmax_eq_r_c [b6]
b8: $ … ⇒ nmax (nimax a c) (nimax b c) = ∅ $ by eq_trans [b5, b7]
b9: $ … ⇒ ∅ = nmax (nimax a c) (nimax b c) $ by eq_sym [b8]
b10: $ … ⇒ nimax a (nimax b c) = nmax (nimax a c) (nimax b c) $ by eq_trans [b4, b9]
f1: $ G , ∅ ∈ c ⇒ ∅ ∈ c $ by ax
f2: $ G , ∅ ∈ c ⇒ c ⊆ nmax b c $ by cun_subset_r
f3: $ … ⇒ ∅ ∈ nmax b c $ by wcel_subset [f2, f1]
f4: $ … ⇒ nimax b c = nmax b c $ by k1_nimax_wpos_c [f1]
f5: $ … ⇒ nimax a c = nmax a c $ by k1_nimax_wpos_c [f1]
f6: $ G , ∅ ∈ c ⇒ a = a $ by eq_refl
f7: $ … ⇒ nimax a (nimax b c) = nimax a (nmax b c) $ by nimax_eq [f6, f4]
f8: $ … ⇒ nimax a (nmax b c) = nmax a (nmax b c) $ by k1_nimax_wpos_c [f3]
f9: $ G , ∅ ∈ c ⇒ nmax a (nmax b c) = nmax (nmax a c) (nmax b c) $ by k1_cun_distr2
f10: $ … ⇒ nmax (nimax a c) (nimax b c) = nmax (nmax a c) (nmax b c) $ by nmax_eq [f5, f4]
f11: $ … ⇒ nmax (nmax a c) (nmax b c) = nmax (nimax a c) (nimax b c) $ by eq_sym [f10]
f12: $ … ⇒ nimax a (nimax b c) = nmax a (nmax b c) $ by eq_trans [f7, f8]
f13: $ … ⇒ nimax a (nimax b c) = nmax (nmax a c) (nmax b c) $ by eq_trans [f12, f9]
f14: $ … ⇒ nimax a (nimax b c) = nmax (nimax a c) (nimax b c) $ by eq_trans [f13, f11]
l2: $ … ⇒ nimax a (nimax b c) = nmax (nimax a c) (nimax b c) $ by or_elim [l1, f14, b10]

nimax_nimax_c
-------------
l1: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ y = A $ by ax
l2: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ z = B $ by ax
l3: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ u = C $ by ax
l4: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ y ∊ ω $ by ax
l5: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ z ∊ ω $ by ax
l6: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ u ∊ ω $ by ax
l7: $ … ⇒ nimax y (nimax z u) = nmax (nimax y u) (nimax z u) $ by nimax_nimax [l4, l5, l6]
l8: $ … ⇒ nimax z u = nimax B C $ by nimax_eq [l2, l3]
l9: $ … ⇒ nimax y (nimax z u) = nimax A (nimax B C) $ by nimax_eq [l1, l8]
l10: $ … ⇒ nimax y u = nimax A C $ by nimax_eq [l1, l3]
l11: $ … ⇒ nimax z u = nimax B C $ by nimax_eq [l2, l3]
l12: $ … ⇒ nmax (nimax y u) (nimax z u) = nmax (nimax A C) (nimax B C) $ by nmax_eq [l10, l11]
l13: $ … ⇒ nimax A (nimax B C) = nmax (nimax A C) (nimax B C) $ by k6_eq3s [l9, l12, l7]
l14: $ … ⇒ nimax A (nimax B C) = nmax (nimax A C) (nimax B C) $ by wcel_elim [#3, l13]
l15: $ … ⇒ nimax A (nimax B C) = nmax (nimax A C) (nimax B C) $ by wcel_elim [#2, l14]
l16: $ … ⇒ nimax A (nimax B C) = nmax (nimax A C) (nimax B C) $ by wcel_elim [#1, l15]

lvals_set
---------
l1: $ G ⇒ isset ω $ by omega_set
l2: $ … ⇒ isset (⋃ ω) $ by cuni_set [l1]
l3: $ G , x ∊ ω ⇒ isset (⋃ ω) $ by weaken [l2]
l4: $ … ⇒ x ∊ ω → isset (⋃ ω) $ by imp_intro [l3]
l5: $ … ⇒ ∀ x (x ∊ ω → isset (⋃ ω)) $ by all_intro [l4]
l6: $ … ⇒ isset (λₛ x ∈ ω, ⋃ ω) $ by clam_set [l1, l5]
l7: $ … ⇒ isset (Πₛ x ∈ ω, ω) $ by cpi_set [l6]

lvals_ap
--------
l1: $ … ⇒ ap w n ∈ ω $ by cpi_elim_ap [#1, #2]

lvals_ap_c
----------
l1: $ G , n = N , n ∊ ω ⇒ w ∊ lvals $ by weaken [#1]
l2: $ G , n = N , n ∊ ω ⇒ n ∊ ω $ by ax
l3: $ … ⇒ ap w n ∈ ω $ by lvals_ap [l1, l2]
l4: $ G , n = N , n ∊ ω ⇒ w = w $ by eq_refl
l5: $ G , n = N , n ∊ ω ⇒ n = N $ by ax
l6: $ … ⇒ ap w n = ap w N $ by ap_eq [l4, l5]
l7: $ … ⇒ ap w N ∈ ω $ by wcel_eq_l [l6, l3]
l8: $ … ⇒ ap w N ∈ ω $ by wcel_elim [#2, l7]

lvals_ext
---------
l1: $ … ⇒ w = x $ by cpi_ext [#1, #2, #3]

lupd_congr
----------
l1: $ cv i ≐ cv i $ by ceqt_refl
l2: $ cv y ≐ cv y $ by ceqt_refl
l3: $ (i = C) ⟺ (i = D) $ by ceq_congr [l1, #2]
l4: $ (y ∊ E) ⟺ (y ∊ F) $ by welc_congr [l2, #3]
l5: $ (i = C ∧ y ∊ E) ⟺ (i = D ∧ y ∊ F) $ by and_congr [l3, l4]
l6: $ (¬ i = C) ⟺ (¬ i = D) $ by not_congr [l3]
l7: $ ap A i ≐ ap B i $ by ap_congr [#1, l1]
l8: $ (y ∊ ap A i) ⟺ (y ∊ ap B i) $ by welc_congr [l2, l7]
l9: $ (¬ i = C ∧ y ∊ ap A i) ⟺ (¬ i = D ∧ y ∊ ap B i) $ by and_congr [l6, l8]
l10: $ ((i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)) ⟺ ((i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)) $ by or_congr [l5, l9]
l11: $ {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} ≐ {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by cab_congr [l10]
l12: $ ω ≐ ω $ by ceqt_refl
l13: $ (λₛ i ∈ ω, {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)}) ≐ (λₛ i ∈ ω, {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)}) $ by clam_congr [l12, l11]

--| One direction of the equality of `lupd`'s bodies.
lemma k2_lupd_body (G: hyps) (A B C D E F: class) (i y: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ E = F $ >
  $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $
----
l1: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ⇒ (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) $ by ax
a1: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ i = C ∧ y ∊ E $ by ax
a2: $ … ⇒ i = C $ by and_elim_l [a1]
a3: $ … ⇒ y ∊ E $ by and_elim_r [a1]
a4: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ C = D $ by weaken [#2]
a5: $ … ⇒ i = D $ by eq_trans [a2, a4]
a6: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ E = F $ by weaken [#3]
a7: $ … ⇒ y ∊ F $ by welc_eq [a6, a3]
a8: $ … ⇒ i = D ∧ y ∊ F $ by and_intro [a5, a7]
a9: $ … ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by or_intro_l [a8]
b1: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ ¬ i = C ∧ y ∊ ap A i $ by ax
b2: $ … ⇒ ¬ i = C $ by and_elim_l [b1]
b3: $ … ⇒ y ∊ ap A i $ by and_elim_r [b1]
b4: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ i = D $ by ax
b5: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ C = D $ by weaken [#2]
b6: $ … ⇒ D = C $ by eq_sym [b5]
b7: $ … ⇒ i = C $ by eq_trans [b4, b6]
b8: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ ¬ i = C $ by weaken [b2]
b9: $ … ⇒ ⊥ $ by not_elim [b8, b7]
b10: $ … ⇒ ¬ i = D $ by not_intro [b9]
b11: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ A = B $ by weaken [#1]
b12: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ i = i $ by eq_refl
b13: $ … ⇒ y ∊ ap B i $ by welc_ap_eq [b11, b12, b3]
b14: $ … ⇒ ¬ i = D ∧ y ∊ ap B i $ by and_intro [b10, b13]
b15: $ … ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by or_intro_r [b14]
l2: $ … ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by or_elim [l1, a9, b15]

lupd_eq
-------
l1: $ … ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by k2_lupd_body [#1, #2, #3]
l2: $ … ⇒ B = A $ by eq_sym [#1]
l3: $ … ⇒ D = C $ by eq_sym [#2]
l4: $ … ⇒ F = E $ by eq_sym [#3]
l5: $ … ⇒ (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) $ by k2_lupd_body [l2, l3, l4]
l6: $ … ⇒ (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ↔ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by bi_intro [l1, l5]
l7: $ … ⇒ ∀ y ((i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ↔ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)) $ by all_intro [l6]
l8: $ … ⇒ {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by cab_eq [l7]
l9: $ G , i ∊ ω ⇒ {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by weaken [l8]
l10: $ … ⇒ i ∊ ω → {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by imp_intro [l9]
l11: $ … ⇒ ∀ i (i ∊ ω → {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)}) $ by all_intro [l10]
l12: $ … ⇒ (λₛ i ∈ ω, {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)}) = (λₛ i ∈ ω, {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)}) $ by clam_eq_body [l11]

sb_c_lupd
---------
l1: $ ([[ x / t ]] (λₛ i ∈ ω, {y | (i = B ∧ y ∊ C) ∨ (¬ i = B ∧ y ∊ ap A i)})) ≐ (λₛ i ∈ ω, {y | (i = ([[ x / t ]] B) ∧ y ∊ ([[ x / t ]] C)) ∨ (¬ i = ([[ x / t ]] B) ∧ y ∊ ap ([[ x / t ]] A) i)}) $ by ceqt_refl

--| `lupd`'s body at the updated index.
lemma k2_upd_eq {y: set} (G: hyps) (N B C: class) (i: set):
  $ G ⇒ i = N $ > $ G ⇒ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} = B $
----
l1: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} ⇒ z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} $ by ax
l2: $ … ⇒ (i = N ∧ z ∊ B) ∨ (¬ i = N ∧ z ∊ C) $ by cab_elim [l1]
l3: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ i = N ∧ z ∊ B $ by ax
l4: $ … ⇒ z ∊ B $ by and_elim_r [l3]
l5: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ ¬ i = N ∧ z ∊ C $ by ax
l6: $ … ⇒ ¬ i = N $ by and_elim_l [l5]
l7: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ i = N $ by weaken [#1]
l8: $ … ⇒ ⊥ $ by not_elim [l6, l7]
l9: $ … ⇒ z ∊ B $ by bot_elim [l8]
l10: $ … ⇒ z ∊ B $ by or_elim [l2, l4, l9]
l11: $ G , z ∊ B ⇒ i = N $ by weaken [#1]
l12: $ G , z ∊ B ⇒ z ∊ B $ by ax
l13: $ … ⇒ i = N ∧ z ∊ B $ by and_intro [l11, l12]
l14: $ … ⇒ (i = N ∧ z ∊ B) ∨ (¬ i = N ∧ z ∊ C) $ by or_intro_l [l13]
l15: $ … ⇒ z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} $ by cab_intro [l14]
l16: $ … ⇒ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} = B $ by eq_intro [l10, l15]

--| `lupd`'s body at another index.
lemma k2_upd_ne {y: set} (G: hyps) (N B C: class) (i: set):
  $ G ⇒ ¬ i = N $ > $ G ⇒ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} = C $
----
l1: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} ⇒ z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} $ by ax
l2: $ … ⇒ (i = N ∧ z ∊ B) ∨ (¬ i = N ∧ z ∊ C) $ by cab_elim [l1]
l3: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ i = N ∧ z ∊ B $ by ax
l4: $ … ⇒ i = N $ by and_elim_l [l3]
l5: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ ¬ i = N $ by weaken [#1]
l6: $ … ⇒ ⊥ $ by not_elim [l5, l4]
l7: $ … ⇒ z ∊ C $ by bot_elim [l6]
l8: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ ¬ i = N ∧ z ∊ C $ by ax
l9: $ … ⇒ z ∊ C $ by and_elim_r [l8]
l10: $ … ⇒ z ∊ C $ by or_elim [l2, l7, l9]
l11: $ G , z ∊ C ⇒ ¬ i = N $ by weaken [#1]
l12: $ G , z ∊ C ⇒ z ∊ C $ by ax
l13: $ … ⇒ ¬ i = N ∧ z ∊ C $ by and_intro [l11, l12]
l14: $ … ⇒ (i = N ∧ z ∊ B) ∨ (¬ i = N ∧ z ∊ C) $ by or_intro_r [l13]
l15: $ … ⇒ z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} $ by cab_intro [l14]
l16: $ … ⇒ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} = C $ by eq_intro [l10, l15]

