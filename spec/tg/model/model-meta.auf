t6: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f1_lkp u M w → ⟨ k , j ⟩ ∈ f1_lkp u M w $ by imp_intro [t5]
t7: $ … ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f1_lkp u M w → ⟨ k , j ⟩ ∈ f1_lkp u M w) $ by all_intro [t6]
t8: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f1_lkp u M w → ⟨ k , j ⟩ ∈ f1_lkp u M w) $ by all_intro [t7]
t9a: $ G ⇒ isset ω $ by omega_set
t9: $ … ⇒ trees ω ⊆ f1_lkp u M w $ by trees_ind_c [t9a, t8]
f0: $ G ⇒ kr_lookup ∈ ω $ by kr_lookup_omega
f1: $ … ⇒ isset kr_lookup $ by wcel_isset [f0]
f2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, f1]
f3: $ … ⇒ t1 ∊ trees ω $ by and_elim_l [f2]
f4: $ … ⇒ t1 ∊ f1_lkp u M w $ by subset_elim [t9, f3]
f5: $ … ⇒ r' nvf' t2 ∈ dt u M t3 w r $ by f1_lkp_e [f4, #1, #3]

lookup_den
----------
l1: $ H ⇒ ra_lookup (enc_ctx G) (enc_nat i) (enc_expr A) ∈ lrel $ by weaken [#1]
l2: $ H ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
l3: $ … ⇒ isset (enc_ctx G) $ by wcel_isset [l2]
l4: $ H ⇒ enc_nat i ∈ trees ω $ by enc_nat_trees
l5: $ … ⇒ isset (enc_nat i) $ by wcel_isset [l4]
l6: $ H ⇒ enc_expr A ∈ trees ω $ by enc_expr_trees
l7: $ … ⇒ isset (enc_expr A) $ by wcel_isset [l6]
h1: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ a = enc_ctx G $ by ax
h2: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ b = enc_nat i $ by ax
h3: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ c = enc_expr A $ by ax
h1s: $ … ⇒ enc_ctx G = a $ by eq_sym [h1]
h2s: $ … ⇒ enc_nat i = b $ by eq_sym [h2]
h3s: $ … ⇒ enc_expr A = c $ by eq_sym [h3]
h4: $ … ⇒ ra_lookup (enc_ctx G) (enc_nat i) (enc_expr A) = ra_lookup a b c $ by ra_lookup_eq [h1s, h2s, h3s]
h5a: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ ra_lookup (enc_ctx G) (enc_nat i) (enc_expr A) ∈ lrel $ by weaken [l1]
h5: $ … ⇒ ra_lookup a b c ∈ lrel $ by wcel_eq_l [h4, h5a]
h6a: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ r ∊ sat u M (enc_ctx G) w $ by weaken [#3]
h6: $ … ⇒ r ∊ sat u M a w $ by f1_sat_eq [h1s, h6a]
h7a: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ w ∊ lvals $ by weaken [#2]
h7: $ … ⇒ r' nvf' b ∈ dt u M c w r $ by lrel_lookup_sem [h5, h7a, h6]
q1: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ nvf = nvf $ by eq_refl
q2: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ r = r $ by eq_refl
q3: $ … ⇒ nvf' b = nvf' (enc_nat i) $ by fv_eq [q1, h2]
q4: $ … ⇒ r' nvf' b = r' nvf' (enc_nat i) $ by fv_eq [q2, q3]
q5: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ u = u $ by eq_refl
q6: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ M = M $ by eq_refl
q7: $ H , a = enc_ctx G , b = enc_nat i , c = enc_expr A ⇒ w = w $ by eq_refl
q8: $ … ⇒ dt u M c w r = dt u M (enc_expr A) w r $ by dt_eq [q5, q6, h3, q7, q2]
h8: $ … ⇒ r' nvf' (enc_nat i) ∈ dt u M c w r $ by wcel_eq_l [q4, h7]
h9: $ … ⇒ r' nvf' (enc_nat i) ∈ dt u M (enc_expr A) w r $ by wcel_eq_r [q8, h8]
h10: $ … ⇒ r' nvf' (enc_nat i) ∈ dt u M (enc_expr A) w r $ by isset_elim [l7, h9]
h11: $ … ⇒ r' nvf' (enc_nat i) ∈ dt u M (enc_expr A) w r $ by isset_elim [l5, h10]
h12: $ … ⇒ r' nvf' (enc_nat i) ∈ dt u M (enc_expr A) w r $ by isset_elim [l3, h11]

--| The trees `y` such that, for every derivable `cext n g y`, every valuation
--| satisfying `y` is `q ++ t` with `q` of length `n` and `t` satisfying `g`.
def f2_cxp (U M W: class) (.y .k .a .b .q .t: set): class = $ {y | ∀ k ∀ a ∀ b (⟨ kr_cext , k +: a +: y +: ∅ ⟩ ∈ lrel → b ∊ sat U M y W → ∃ q ∃ t (q ∊ fseq U ∧ cdm q = nvf' k ∧ t ∊ sat U M a W ∧ b = q ++ t))} $

lemma f2_cxp_e {q t: set} (G: hyps q t) (M: class) (u w x c d e: set): $ G ⇒ x ∊ f2_cxp u M w $ > $ G ⇒ ra_cext c d x ∈ lrel $ > $ G ⇒ e ∊ sat u M x w $ > $ G ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $
----
l1: $ … ⇒ ∀ k ∀ a ∀ b (⟨ kr_cext , k +: a +: x +: ∅ ⟩ ∈ lrel → b ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' k ∧ t ∊ sat u M a w ∧ b = q ++ t)) $ by cab_elim [#1]
l2: $ … ⇒ ∀ a ∀ b (⟨ kr_cext , c +: a +: x +: ∅ ⟩ ∈ lrel → b ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M a w ∧ b = q ++ t)) $ by all_elim [l1]
l3: $ … ⇒ ∀ b (⟨ kr_cext , c +: d +: x +: ∅ ⟩ ∈ lrel → b ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ b = q ++ t)) $ by all_elim [l2]
l4: $ … ⇒ ⟨ kr_cext , c +: d +: x +: ∅ ⟩ ∈ lrel → e ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by all_elim [l3]
l5: $ … ⇒ e ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by imp_elim [l4, #2]
l6: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by imp_elim [l5, #3]

lemma f2_cxp_i {k a b q t: set} (G: hyps) (M: class) (u w x: set): $ G , ra_cext k a x ∈ lrel , b ∊ sat u M x w ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' k ∧ t ∊ sat u M a w ∧ b = q ++ t) $ > $ G ⇒ x ∊ f2_cxp u M w $
----
l1: $ … ⇒ b ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' k ∧ t ∊ sat u M a w ∧ b = q ++ t) $ by imp_intro [#1]
l2: $ … ⇒ ⟨ kr_cext , k +: a +: x +: ∅ ⟩ ∈ lrel → b ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' k ∧ t ∊ sat u M a w ∧ b = q ++ t) $ by imp_intro [l1]
l3: $ … ⇒ ∀ b (⟨ kr_cext , k +: a +: x +: ∅ ⟩ ∈ lrel → b ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' k ∧ t ∊ sat u M a w ∧ b = q ++ t)) $ by all_intro [l2]
l4: $ … ⇒ ∀ a ∀ b (⟨ kr_cext , k +: a +: x +: ∅ ⟩ ∈ lrel → b ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' k ∧ t ∊ sat u M a w ∧ b = q ++ t)) $ by all_intro [l3]
l5: $ … ⇒ ∀ k ∀ a ∀ b (⟨ kr_cext , k +: a +: x +: ∅ ⟩ ∈ lrel → b ∊ sat u M x w → ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' k ∧ t ∊ sat u M a w ∧ b = q ++ t)) $ by all_intro [l4]
l6: $ G ⇒ x ∊ f2_cxp u M w $ by cab_intro [l5]

--| `sat` respects equality of the context tree.
lemma f2_sat_eq (G: hyps) (M A B: class) (u w: set): $ G ⇒ A = B $ > $ G ⇒ sat u M A w = sat u M B w $
----
l1: $ G ⇒ stf u M = stf u M $ by eq_refl
l2: $ … ⇒ (stf u M)' A = (stf u M)' B $ by fv_eq [l1, #1]
l3: $ G ⇒ w = w $ by eq_refl
l4: $ … ⇒ sat u M A w = sat u M B w $ by ap_eq [l2, l3]

--| The witnesses of the splitting, the prefix a class.
lemma f2_wit_c {q t: set} (H: hyps) (u e b: set) (A N S: class): $ H ⇒ isset A $ > $ H ⇒ A ∈ fseq u $ > $ H ⇒ cdm A = N $ > $ H ⇒ b ∊ S $ > $ H ⇒ e = A ++ b $ > $ H ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = N ∧ t ∊ S ∧ e = q ++ t) $
----
m1: $ H , v = A ⇒ v = A $ by ax
m2: $ … ⇒ A = v $ by eq_sym [m1]
m3: $ H , v = A ⇒ A ∈ fseq u $ by weaken [#2]
m4: $ … ⇒ v ∈ fseq u $ by wcel_eq_l [m2, m3]
m5: $ … ⇒ v ∊ fseq u $ by wcel_welc [m4]
m6: $ … ⇒ cdm v = cdm A $ by cdm_eq [m1]
m7: $ H , v = A ⇒ cdm A = N $ by weaken [#3]
m8: $ … ⇒ cdm v = N $ by eq_trans [m6, m7]
m9: $ H , v = A ⇒ b ∊ S $ by weaken [#4]
m10: $ H , v = A ⇒ b = b $ by eq_refl
m11: $ … ⇒ A ++ b = v ++ b $ by scat_eq [m2, m10]
m12: $ H , v = A ⇒ e = A ++ b $ by weaken [#5]
m13: $ … ⇒ e = v ++ b $ by eq_trans [m12, m11]
m14: $ … ⇒ b ∊ S ∧ e = v ++ b $ by and_intro [m9, m13]
m15: $ … ⇒ cdm v = N ∧ b ∊ S ∧ e = v ++ b $ by and_intro [m8, m14]
m16: $ … ⇒ v ∊ fseq u ∧ cdm v = N ∧ b ∊ S ∧ e = v ++ b $ by and_intro [m5, m15]
m17: $ … ⇒ ∃ t (v ∊ fseq u ∧ cdm v = N ∧ t ∊ S ∧ e = v ++ t) $ by ex_intro [m16]
m18: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = N ∧ t ∊ S ∧ e = q ++ t) $ by ex_intro [m17]
m19: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = N ∧ t ∊ S ∧ e = q ++ t) $ by isset_elim [#1, m18]

--| Elimination of two existentials at once.
lemma f2_ex2 {x y: set} (G: hyps x y) (H: hyps) (p: fml x y) (c: fml): $ G ⇒ ∃ x ∃ y p $ > $ H , p ⇒ c $ > $ G , H ⇒ c $
----
l1: $ H , ∃ y p ⇒ ∃ y p $ by ax
l2: $ … ⇒ c $ by ex_elim [l1, #2]
l3: $ … ⇒ c $ by ex_elim [#1, l2]

--| The case `cext_z`: `q = ∅` and `t = r`.
lemma f2_cz {q t: set} (H: hyps) (M: class) (u w c d z e a: set): $ H ⇒ c = ⟨ kc_nz , ∅ ⟩ $ > $ H ⇒ d = a $ > $ H ⇒ z = a $ > $ H ⇒ e ∊ sat u M z w $ > $ H ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $
----
l0: $ … ⇒ a = d $ by eq_sym [#2]
l1: $ … ⇒ z = d $ by eq_trans [#3, l0]
l2a: $ … ⇒ sat u M z w = sat u M d w $ by f2_sat_eq [l1]
l2: $ … ⇒ e ∊ sat u M d w $ by welc_eq [l2a, #4]
l3: $ H ⇒ sat u M d w ⊆ fseq u $ by sat_fseq
l4: $ … ⇒ e ∊ fseq u $ by subset_elim [l3, l2]
l5: $ … ⇒ ∅ ++ e = e $ by scat_empty_l [l4]
l6: $ … ⇒ e = ∅ ++ e $ by eq_sym [l5]
l7: $ H ⇒ ∅ ∈ fseq u $ by fseq_empty
l8: $ H ⇒ cdm ∅ = ∅ $ by cdm_empty
l9a: $ H ⇒ nvf = nvf $ by eq_refl
l9: $ … ⇒ nvf' c = nvf' ⟨ kc_nz , ∅ ⟩ $ by fv_eq [l9a, #1]
l10: $ H ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l11: $ … ⇒ nvf' c = ∅ $ by eq_trans [l9, l10]
l12: $ … ⇒ ∅ = nvf' c $ by eq_sym [l11]
l13: $ … ⇒ cdm ∅ = nvf' c $ by eq_trans [l8, l12]
l14: $ H ⇒ isset ∅ $ by ax_empty
l15: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_wit_c [l14, l7, l13, l2, l6]

--| The case `cext_s`, inside the eliminations: `r = x :: r2` and `r2 = q ++ t`,
--| so `r = (x :: q) ++ t`.
lemma f2_cs_in {q t: set} (H: hyps) (M: class) (u w c d e f g x5 x6 x7 x8: set): $ H ⇒ e ∊ fseq u $ > $ H ⇒ c = ⟨ kc_s , f +: ∅ ⟩ $ > $ H ⇒ f ∈ trees ω $ > $ H ⇒ d = g $ > $ H ⇒ e = x5 +: x6 $ > $ H ⇒ x7 ∊ fseq u $ > $ H ⇒ cdm x7 = nvf' f $ > $ H ⇒ x8 ∊ sat u M g w $ > $ H ⇒ x6 = x7 ++ x8 $ > $ H ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $
----
a1: $ … ⇒ e ∈ fseq u $ by welc_wcel [#1]
a2: $ … ⇒ x5 +: x6 ∈ fseq u $ by wcel_eq_l [#5, a1]
a3: $ … ⇒ x5 ∊ u $ by scons_fseq_hd [a2]
a4: $ … ⇒ x5 +: x7 ∈ fseq u $ by scons_fseq [a3, #6]
a5: $ H ⇒ sat u M g w ⊆ fseq u $ by sat_fseq
a6: $ … ⇒ x8 ∊ fseq u $ by subset_elim [a5, #8]
b1: $ … ⇒ cdm (x5 +: x7) = suc (cdm x7) $ by scons_len [#6]
b2: $ … ⇒ suc (cdm x7) = suc (nvf' f) $ by suc_eq [#7]
b3: $ … ⇒ cdm (x5 +: x7) = suc (nvf' f) $ by eq_trans [b1, b2]
b4a: $ H ⇒ nvf = nvf $ by eq_refl
b4: $ … ⇒ nvf' c = nvf' ⟨ kc_s , f +: ∅ ⟩ $ by fv_eq [b4a, #2]
b5: $ … ⇒ nvf' ⟨ kc_s , f +: ∅ ⟩ = suc (nvf' f) $ by nvf_s [#3]
b6: $ … ⇒ nvf' c = suc (nvf' f) $ by eq_trans [b4, b5]
b7: $ … ⇒ suc (nvf' f) = nvf' c $ by eq_sym [b6]
b8: $ … ⇒ cdm (x5 +: x7) = nvf' c $ by eq_trans [b3, b7]
c1: $ … ⇒ g = d $ by eq_sym [#4]
c2: $ … ⇒ sat u M g w = sat u M d w $ by f2_sat_eq [c1]
c3: $ … ⇒ x8 ∊ sat u M d w $ by welc_eq [c2, #8]
d1: $ H ⇒ x5 = x5 $ by eq_refl
d2: $ … ⇒ x5 +: x6 = x5 +: x7 ++ x8 $ by scons_eq [d1, #9]
d3: $ … ⇒ (x5 +: x7) ++ x8 = x5 +: x7 ++ x8 $ by scat_scons [#6, a6]
d4: $ … ⇒ x5 +: x7 ++ x8 = (x5 +: x7) ++ x8 $ by eq_sym [d3]
d5: $ … ⇒ e = x5 +: x7 ++ x8 $ by eq_trans [#5, d2]
d6: $ … ⇒ e = (x5 +: x7) ++ x8 $ by eq_trans [d5, d4]
d7: $ H ⇒ isset x7 $ by isset_var
d8: $ … ⇒ isset (x5 +: x7) $ by scons_set [d7]
d9: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_wit_c [d8, a4, b8, c3, d6]

--| The case `cext_s`: the valuation is `x :: r2` with `r2` satisfying the
--| smaller context, split by the induction hypothesis.
lemma f2_cs {q t: set} (H: hyps) (M: class) (u w k j z c d e f g h i: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ crn j ⊆ f2_cxp u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ c = ⟨ kc_s , f +: ∅ ⟩ $ > $ H ⇒ d = g $ > $ H ⇒ z = ⟨ kc_cons , i +: h +: ∅ ⟩ $ > $ H ⇒ ra_cext f g h ∈ lrel $ > $ H ⇒ e ∊ sat u M z w $ > $ H ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $
----
s1a: $ … ⇒ sat u M z w = sat u M ⟨ kc_cons , i +: h +: ∅ ⟩ w $ by f2_sat_eq [#7]
s1: $ … ⇒ e ∊ sat u M ⟨ kc_cons , i +: h +: ∅ ⟩ w $ by welc_eq [s1a, #9]
s1b: $ H ⇒ sat u M z w ⊆ fseq u $ by sat_fseq
s1c: $ … ⇒ e ∊ fseq u $ by subset_elim [s1b, #9]
s2a: $ … ⇒ z ∈ trees ω $ by welc_wcel [#4]
s2: $ … ⇒ ⟨ kc_cons , i +: h +: ∅ ⟩ ∈ trees ω $ by wcel_eq_l [#7, s2a]
s3: $ H ⇒ isset ω $ by omega_set
s4a: $ H ⇒ kc_cons ∈ ω $ by kc_cons_omega
s4: $ … ⇒ isset kc_cons $ by wcel_isset [s4a]
s5: $ … ⇒ i ∊ trees ω ∧ h ∊ trees ω $ by trees_kids2 [s3, s2, s4]
s6a: $ … ⇒ i ∊ trees ω $ by and_elim_l [s5]
s6: $ … ⇒ i ∈ trees ω $ by welc_wcel [s6a]
s7a: $ … ⇒ h ∊ trees ω $ by and_elim_r [s5]
s7: $ … ⇒ h ∈ trees ω $ by welc_wcel [s7a]
s8: $ … ⇒ ∃ x5 ∃ x6 (x6 ∊ sat u M h w ∧ x5 ∊ dt u M i w x6 ∧ e = x5 +: x6) $ by sat_cons_elim [s6, s7, #1, s1]
i1z: $ H ⇒ isset ∅ $ by ax_empty
i1a: $ … ⇒ isset (h +: ∅) $ by scons_set [i1z]
i1b: $ … ⇒ isset (i +: h +: ∅) $ by scons_set [i1a]
i1: $ … ⇒ crn (i +: h +: ∅) ⊆ f2_cxp u M w $ by p1_ch [#2, #3, #7, s4, i1b]
i2: $ … ⇒ crn (h +: ∅) ⊆ f2_cxp u M w $ by crn_scons_tail [i1]
i3a: $ H ⇒ isset h $ by isset_var
i3: $ … ⇒ h ∈ f2_cxp u M w $ by crn_scons_head [i3a, i2]
i4: $ … ⇒ h ∊ f2_cxp u M w $ by wcel_welc [i3]
f0: $ H ⇒ kr_cext ∈ ω $ by kr_cext_omega
f1: $ … ⇒ isset kr_cext $ by wcel_isset [f0]
f2: $ … ⇒ f ∊ trees ω ∧ g ∊ trees ω ∧ h ∊ trees ω $ by lrel_args3 [#8, f1]
f3: $ … ⇒ f ∊ trees ω $ by and_elim_l [f2]
f4: $ … ⇒ f ∈ trees ω $ by welc_wcel [f3]
b0: $ H , x6 ∊ sat u M h w ∧ x5 ∊ dt u M i w x6 ∧ e = x5 +: x6 ⇒ x6 ∊ sat u M h w ∧ x5 ∊ dt u M i w x6 ∧ e = x5 +: x6 $ by ax
b1: $ … ⇒ x6 ∊ sat u M h w $ by and_elim_l [b0]
b2a: $ … ⇒ x5 ∊ dt u M i w x6 ∧ e = x5 +: x6 $ by and_elim_r [b0]
b2: $ … ⇒ e = x5 +: x6 $ by and_elim_r [b2a]
b3a: $ H , x6 ∊ sat u M h w ∧ x5 ∊ dt u M i w x6 ∧ e = x5 +: x6 ⇒ h ∊ f2_cxp u M w $ by weaken [i4]
b3b: $ H , x6 ∊ sat u M h w ∧ x5 ∊ dt u M i w x6 ∧ e = x5 +: x6 ⇒ ra_cext f g h ∈ lrel $ by weaken [#8]
b3: $ … ⇒ ∃ x7 ∃ x8 (x7 ∊ fseq u ∧ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8) $ by f2_cxp_e [b3a, b3b, b1]
k0: $ H , e = x5 +: x6 , x7 ∊ fseq u ∧ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 ⇒ x7 ∊ fseq u ∧ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 $ by ax
k1: $ … ⇒ x7 ∊ fseq u $ by and_elim_l [k0]
k2a: $ … ⇒ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 $ by and_elim_r [k0]
k2: $ … ⇒ cdm x7 = nvf' f $ by and_elim_l [k2a]
k3a: $ … ⇒ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 $ by and_elim_r [k2a]
k3: $ … ⇒ x8 ∊ sat u M g w $ by and_elim_l [k3a]
k4: $ … ⇒ x6 = x7 ++ x8 $ by and_elim_r [k3a]
k5: $ H , e = x5 +: x6 , x7 ∊ fseq u ∧ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 ⇒ e ∊ fseq u $ by weaken [s1c]
k6: $ H , e = x5 +: x6 , x7 ∊ fseq u ∧ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 ⇒ c = ⟨ kc_s , f +: ∅ ⟩ $ by weaken [#5]
k7: $ H , e = x5 +: x6 , x7 ∊ fseq u ∧ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 ⇒ f ∈ trees ω $ by weaken [f4]
k8: $ H , e = x5 +: x6 , x7 ∊ fseq u ∧ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 ⇒ d = g $ by weaken [#6]
k9: $ H , e = x5 +: x6 , x7 ∊ fseq u ∧ cdm x7 = nvf' f ∧ x8 ∊ sat u M g w ∧ x6 = x7 ++ x8 ⇒ e = x5 +: x6 $ by ax
k10: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_cs_in [k5, k6, k7, k8, k9, k1, k2, k3, k4]
b4a: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_ex2 [b3, k10]
b4b: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by cut [b2, b4a]
b5: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_ex2 [s8, b4b]

--| One node of the induction: the two clauses of `cext`.
lemma f2_node {q t: set} (H: hyps) (M: class) (u w k j z c d e: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ k ∊ ω $ > $ H ⇒ j ∊ fseq (trees ω) $ > $ H ⇒ crn j ⊆ f2_cxp u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ ra_cext c d z ∈ lrel $ > $ H ⇒ e ∊ sat u M z w $ > $ H ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $
----
n0: $ … ⇒ ∃ x1 (c = ⟨ kc_nz , ∅ ⟩ ∧ d = x1 ∧ z = x1) ∨ ∃ x2 ∃ x1 ∃ x3 ∃ x4 (c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel) $ by lrel_cext_cases [#6]
n1: $ … ⇒ z ∊ trees ω $ by p1_ztree [#2, #3, #5]
z0: $ H , c = ⟨ kc_nz , ∅ ⟩ ∧ d = x1 ∧ z = x1 ⇒ c = ⟨ kc_nz , ∅ ⟩ ∧ d = x1 ∧ z = x1 $ by ax
z1: $ … ⇒ c = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [z0]
z2a: $ … ⇒ d = x1 ∧ z = x1 $ by and_elim_r [z0]
z2: $ … ⇒ d = x1 $ by and_elim_l [z2a]
z3: $ … ⇒ z = x1 $ by and_elim_r [z2a]
z4: $ H , c = ⟨ kc_nz , ∅ ⟩ ∧ d = x1 ∧ z = x1 ⇒ e ∊ sat u M z w $ by weaken [#7]
z5: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_cz [z1, z2, z3, z4]
z6: $ H , ∃ x1 (c = ⟨ kc_nz , ∅ ⟩ ∧ d = x1 ∧ z = x1) ⇒ ∃ x1 (c = ⟨ kc_nz , ∅ ⟩ ∧ d = x1 ∧ z = x1) $ by ax
z7: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by ex_elim [z6, z5]
p0: $ H , c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel ⇒ c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel $ by ax
p1: $ … ⇒ c = ⟨ kc_s , x2 +: ∅ ⟩ $ by and_elim_l [p0]
p2a: $ … ⇒ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel $ by and_elim_r [p0]
p2: $ … ⇒ d = x1 $ by and_elim_l [p2a]
p3a: $ … ⇒ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel $ by and_elim_r [p2a]
p3: $ … ⇒ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ $ by and_elim_l [p3a]
p4: $ … ⇒ ra_cext x2 x1 x3 ∈ lrel $ by and_elim_r [p3a]
p5a: $ H , c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel ⇒ w ∊ lvals $ by weaken [#1]
p5b: $ H , c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel ⇒ crn j ⊆ f2_cxp u M w $ by weaken [#4]
p5c: $ H , c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by weaken [#5]
p5d: $ H , c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel ⇒ z ∊ trees ω $ by weaken [n1]
p5e: $ H , c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel ⇒ e ∊ sat u M z w $ by weaken [#7]
p6: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_cs [p5a, p5b, p5c, p5d, p1, p2, p3, p4, p5e]
p7: $ H , ∃ x3 ∃ x4 (c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel) ⇒ ∃ x3 ∃ x4 (c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel) $ by ax
p8: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_ex2 [p7, p6]
p9: $ H , ∃ x2 ∃ x1 ∃ x3 ∃ x4 (c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel) ⇒ ∃ x2 ∃ x1 ∃ x3 ∃ x4 (c = ⟨ kc_s , x2 +: ∅ ⟩ ∧ d = x1 ∧ z = ⟨ kc_cons , x4 +: x3 +: ∅ ⟩ ∧ ra_cext x2 x1 x3 ∈ lrel) $ by ax
p10: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_ex2 [p9, p8]
n2: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by or_elim [n0, z7, p10]

--| Every tree has the property: induction on the trees.
lemma f2_all (G: hyps) (M: class) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ trees ω ⊆ f2_cxp u M w $
----
s1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w , z = ⟨ k , j ⟩ , ra_cext c d z ∈ lrel , e ∊ sat u M z w ⇒ w ∊ lvals $ by weaken [#1]
s2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w , z = ⟨ k , j ⟩ , ra_cext c d z ∈ lrel , e ∊ sat u M z w ⇒ k ∊ ω $ by ax
s3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w , z = ⟨ k , j ⟩ , ra_cext c d z ∈ lrel , e ∊ sat u M z w ⇒ j ∊ fseq (trees ω) $ by ax
s4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w , z = ⟨ k , j ⟩ , ra_cext c d z ∈ lrel , e ∊ sat u M z w ⇒ crn j ⊆ f2_cxp u M w $ by ax
s5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w , z = ⟨ k , j ⟩ , ra_cext c d z ∈ lrel , e ∊ sat u M z w ⇒ z = ⟨ k , j ⟩ $ by ax
s6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w , z = ⟨ k , j ⟩ , ra_cext c d z ∈ lrel , e ∊ sat u M z w ⇒ ra_cext c d z ∈ lrel $ by ax
s7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w , z = ⟨ k , j ⟩ , ra_cext c d z ∈ lrel , e ∊ sat u M z w ⇒ e ∊ sat u M z w $ by ax
s8: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' c ∧ t ∊ sat u M d w ∧ e = q ++ t) $ by f2_node [s1, s2, s3, s4, s5, s6, s7]
t1: $ … ⇒ z ∊ f2_cxp u M w $ by f2_cxp_i [s8]
t2a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
t2: $ … ⇒ ⟨ k , j ⟩ ∈ f2_cxp u M w $ by wcel_intro [t2a, t1]
t3a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cxp u M w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
t3: $ … ⇒ ⟨ k , j ⟩ ∈ f2_cxp u M w $ by isset_elim [t3a, t2]
t4: $ … ⇒ crn j ⊆ f2_cxp u M w → ⟨ k , j ⟩ ∈ f2_cxp u M w $ by imp_intro [t3]
t5: $ … ⇒ j ∊ fseq (trees ω) → crn j ⊆ f2_cxp u M w → ⟨ k , j ⟩ ∈ f2_cxp u M w $ by imp_intro [t4]
t6: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f2_cxp u M w → ⟨ k , j ⟩ ∈ f2_cxp u M w $ by imp_intro [t5]
t7: $ … ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f2_cxp u M w → ⟨ k , j ⟩ ∈ f2_cxp u M w) $ by all_intro [t6]
t8: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f2_cxp u M w → ⟨ k , j ⟩ ∈ f2_cxp u M w) $ by all_intro [t7]
t9a: $ G ⇒ isset ω $ by omega_set
t9: $ … ⇒ trees ω ⊆ f2_cxp u M w $ by trees_ind_c [t9a, t8]

lrel_cext_sem
-------------
f0: $ G ⇒ kr_cext ∈ ω $ by kr_cext_omega
f1: $ … ⇒ isset kr_cext $ by wcel_isset [f0]
f2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, f1]
f3a: $ … ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by and_elim_r [f2]
f3: $ … ⇒ t3 ∊ trees ω $ by and_elim_r [f3a]
f4a: $ … ⇒ trees ω ⊆ f2_cxp u M w $ by f2_all [#2]
f4: $ … ⇒ t3 ∊ f2_cxp u M w $ by subset_elim [f4a, f3]
f5: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' t1 ∧ t ∊ sat u M t2 w ∧ r = q ++ t) $ by f2_cxp_e [f4, #1, #3]

cext_den
--------
l1: $ H ⇒ ra_cext (enc_nat n) (enc_ctx G) (enc_ctx G2) ∈ lrel $ by weaken [#1]
l2: $ H ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l3: $ … ⇒ isset (enc_nat n) $ by wcel_isset [l2]
l4: $ H ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
l5: $ … ⇒ isset (enc_ctx G) $ by wcel_isset [l4]
l6: $ H ⇒ enc_ctx G2 ∈ trees ω $ by enc_ctx_trees
l7: $ … ⇒ isset (enc_ctx G2) $ by wcel_isset [l6]
h1: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 ⇒ a = enc_nat n $ by ax
h2: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 ⇒ b = enc_ctx G $ by ax
h3: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 ⇒ c = enc_ctx G2 $ by ax
h1s: $ … ⇒ enc_nat n = a $ by eq_sym [h1]
h2s: $ … ⇒ enc_ctx G = b $ by eq_sym [h2]
h3s: $ … ⇒ enc_ctx G2 = c $ by eq_sym [h3]
h4a: $ … ⇒ ra_cext (enc_nat n) (enc_ctx G) (enc_ctx G2) = ra_cext a b c $ by ra_cext_eq [h1s, h2s, h3s]
h4b: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 ⇒ ra_cext (enc_nat n) (enc_ctx G) (enc_ctx G2) ∈ lrel $ by weaken [l1]
h4: $ … ⇒ ra_cext a b c ∈ lrel $ by wcel_eq_l [h4a, h4b]
h5: $ … ⇒ sat u M (enc_ctx G2) w = sat u M c w $ by f2_sat_eq [h3s]
h6a: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 ⇒ r ∊ sat u M (enc_ctx G2) w $ by weaken [#3]
h6: $ … ⇒ r ∊ sat u M c w $ by welc_eq [h5, h6a]
h7a: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 ⇒ w ∊ lvals $ by weaken [#2]
h7: $ … ⇒ ∃ x1 ∃ x2 (x1 ∊ fseq u ∧ cdm x1 = nvf' a ∧ x2 ∊ sat u M b w ∧ r = x1 ++ x2) $ by lrel_cext_sem [h4, h7a, h6]
k0: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 , x1 ∊ fseq u ∧ cdm x1 = nvf' a ∧ x2 ∊ sat u M b w ∧ r = x1 ++ x2 ⇒ x1 ∊ fseq u ∧ cdm x1 = nvf' a ∧ x2 ∊ sat u M b w ∧ r = x1 ++ x2 $ by ax
k1: $ … ⇒ x1 ∊ fseq u $ by and_elim_l [k0]
k2a: $ … ⇒ cdm x1 = nvf' a ∧ x2 ∊ sat u M b w ∧ r = x1 ++ x2 $ by and_elim_r [k0]
k2: $ … ⇒ cdm x1 = nvf' a $ by and_elim_l [k2a]
k3a: $ … ⇒ x2 ∊ sat u M b w ∧ r = x1 ++ x2 $ by and_elim_r [k2a]
k3: $ … ⇒ x2 ∊ sat u M b w $ by and_elim_l [k3a]
k4: $ … ⇒ r = x1 ++ x2 $ by and_elim_r [k3a]
k5a: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 , x1 ∊ fseq u ∧ cdm x1 = nvf' a ∧ x2 ∊ sat u M b w ∧ r = x1 ++ x2 ⇒ nvf = nvf $ by eq_refl
k5b: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 , x1 ∊ fseq u ∧ cdm x1 = nvf' a ∧ x2 ∊ sat u M b w ∧ r = x1 ++ x2 ⇒ a = enc_nat n $ by ax
k5c: $ … ⇒ nvf' a = nvf' (enc_nat n) $ by fv_eq [k5a, k5b]
k5: $ … ⇒ cdm x1 = nvf' (enc_nat n) $ by eq_trans [k2, k5c]
k6a: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 , x1 ∊ fseq u ∧ cdm x1 = nvf' a ∧ x2 ∊ sat u M b w ∧ r = x1 ++ x2 ⇒ b = enc_ctx G $ by ax
k6b: $ … ⇒ sat u M b w = sat u M (enc_ctx G) w $ by f2_sat_eq [k6a]
k6: $ … ⇒ x2 ∊ sat u M (enc_ctx G) w $ by welc_eq [k6b, k3]
k7: $ … ⇒ x1 ∈ fseq u $ by welc_wcel [k1]
k8: $ H , a = enc_nat n , b = enc_ctx G , c = enc_ctx G2 , x1 ∊ fseq u ∧ cdm x1 = nvf' a ∧ x2 ∊ sat u M b w ∧ r = x1 ++ x2 ⇒ isset x1 $ by isset_var
k9: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' (enc_nat n) ∧ t ∊ sat u M (enc_ctx G) w ∧ r = q ++ t) $ by f2_wit_c [k8, k7, k5, k6, k4]
e1: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' (enc_nat n) ∧ t ∊ sat u M (enc_ctx G) w ∧ r = q ++ t) $ by f2_ex2 [h7, k9]
e2: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' (enc_nat n) ∧ t ∊ sat u M (enc_ctx G) w ∧ r = q ++ t) $ by isset_elim [l7, e1]
e3: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' (enc_nat n) ∧ t ∊ sat u M (enc_ctx G) w ∧ r = q ++ t) $ by isset_elim [l5, e2]
e4: $ … ⇒ ∃ q ∃ t (q ∊ fseq u ∧ cdm q = nvf' (enc_nat n) ∧ t ∊ sat u M (enc_ctx G) w ∧ r = q ++ t) $ by isset_elim [l3, e3]

--| `sat` respects equality of the context tree.
--| The arguments of a derivable six-place atom are trees.
--| The trees `y` such that every derivable `cinst y A B C x5 x6` (the context
--| `A`, the type `B` and the term `C` fixed) splits every valuation `x7`
--| satisfying `x6` as in `lrel_cinst_sem`.
def f3_cp (U M W A B C: class) (.y .x5 .x6 .x7 .x8 .x9: set): class =
  $ {y | ∀ x5 ∀ x6 ∀ x7 (⟨ kr_cinst , y +: A +: B +: C +: x5 +: x6 +: ∅ ⟩ ∈ lrel →
      x7 ∊ sat U M x6 W → ∃ x8 ∃ x9 (x8 ∊ fseq U ∧ cdm x8 = nvf' y ∧ x9 ∊ sat U M A W ∧ x7 = x8 ++ x9 ∧
      x8 ++ (dt U M C W x9 +: x9) ∈ sat U M x5 W))} $

--| Using the property.
lemma f3_cp_e (G: hyps) {p t: set} (M: class) (u w g h e k x y r: set):
  $ G ⇒ k ∊ f3_cp u M w g h e $ > $ G ⇒ ra_cinst k g h e x y ∈ lrel $ > $ G ⇒ r ∊ sat u M y w $ > $ G ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' k ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $
----
l1: $ … ⇒ ∀ x5 ∀ x6 ∀ x7 (⟨ kr_cinst , k +: g +: h +: e +: x5 +: x6 +: ∅ ⟩ ∈ lrel → x7 ∊ sat u M x6 w → ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' k ∧ t ∊ sat u M g w ∧ x7 = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x5 w)) $ by cab_elim [#1]
l2: $ … ⇒ ∀ x6 ∀ x7 (⟨ kr_cinst , k +: g +: h +: e +: x +: x6 +: ∅ ⟩ ∈ lrel → x7 ∊ sat u M x6 w → ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' k ∧ t ∊ sat u M g w ∧ x7 = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w)) $ by all_elim [l1]
l3: $ … ⇒ ∀ x7 (⟨ kr_cinst , k +: g +: h +: e +: x +: y +: ∅ ⟩ ∈ lrel → x7 ∊ sat u M y w → ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' k ∧ t ∊ sat u M g w ∧ x7 = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w)) $ by all_elim [l2]
l4: $ … ⇒ ⟨ kr_cinst , k +: g +: h +: e +: x +: y +: ∅ ⟩ ∈ lrel → r ∊ sat u M y w → ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' k ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by all_elim [l3]
l5: $ … ⇒ r ∊ sat u M y w → ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' k ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by imp_elim [l4, #2]
l6: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' k ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by imp_elim [l5, #3]

--| The clause `cinst_z`: the empty prefix.
lemma f3_cz (G: hyps) {v p t: set} (M: class) (u w g h e x y r z a b d: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ v (v ∊ sat u M g w → dt u M e w v ∈ dt u M h w v ∧ dt u M e w v ∈ u) $ > $ G ⇒ g ∊ trees ω $ > $ G ⇒ h ∊ trees ω $ > $ G ⇒ z = ⟨ kc_nz , ∅ ⟩ ∧ g = a ∧ h = b ∧ e = d ∧ x = ⟨ kc_cons , b +: a +: ∅ ⟩ ∧ y = a $ >
  $ G ⇒ r ∊ sat u M y w $ > $ G ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $
----
q1: $ … ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [#5]
r1: $ … ⇒ g = a ∧ h = b ∧ e = d ∧ x = ⟨ kc_cons , b +: a +: ∅ ⟩ ∧ y = a $ by and_elim_r [#5]
q2: $ … ⇒ g = a $ by and_elim_l [r1]
r2: $ … ⇒ h = b ∧ e = d ∧ x = ⟨ kc_cons , b +: a +: ∅ ⟩ ∧ y = a $ by and_elim_r [r1]
q3: $ … ⇒ h = b $ by and_elim_l [r2]
r3: $ … ⇒ e = d ∧ x = ⟨ kc_cons , b +: a +: ∅ ⟩ ∧ y = a $ by and_elim_r [r2]
r4: $ … ⇒ x = ⟨ kc_cons , b +: a +: ∅ ⟩ ∧ y = a $ by and_elim_r [r3]
q5: $ … ⇒ x = ⟨ kc_cons , b +: a +: ∅ ⟩ $ by and_elim_l [r4]
q6: $ … ⇒ y = a $ by and_elim_r [r4]
s1: $ … ⇒ a = g $ by eq_sym [q2]
s2: $ … ⇒ b = h $ by eq_sym [q3]
e0: $ G ⇒ ∅ = ∅ $ by eq_refl
e1: $ … ⇒ a +: ∅ = g +: ∅ $ by scons_eq [s1, e0]
e2: $ … ⇒ b +: a +: ∅ = h +: g +: ∅ $ by scons_eq [s2, e1]
e3: $ G ⇒ kc_cons = kc_cons $ by eq_refl
e4: $ … ⇒ ⟨ kc_cons , b +: a +: ∅ ⟩ = ⟨ kc_cons , h +: g +: ∅ ⟩ $ by opair_eq [e3, e2]
e5: $ … ⇒ x = ⟨ kc_cons , h +: g +: ∅ ⟩ $ by eq_trans [q5, e4]
e5b: $ … ⇒ ⟨ kc_cons , h +: g +: ∅ ⟩ = x $ by eq_sym [e5]
e6: $ … ⇒ y = g $ by eq_trans [q6, s1]
e7: $ … ⇒ sat u M y w = sat u M g w $ by f2_sat_eq [e6]
e8: $ … ⇒ r ∊ sat u M g w $ by welc_eq [e7, #6]
h1: $ … ⇒ r ∊ sat u M g w → dt u M e w r ∈ dt u M h w r ∧ dt u M e w r ∈ u $ by all_elim [#2]
h2: $ … ⇒ dt u M e w r ∈ dt u M h w r ∧ dt u M e w r ∈ u $ by imp_elim [h1, e8]
h3: $ … ⇒ dt u M e w r ∈ dt u M h w r $ by and_elim_l [h2]
h4: $ … ⇒ dt u M e w r ∈ u $ by and_elim_r [h2]
f1: $ G ⇒ sat u M g w ⊆ fseq u $ by sat_fseq
f2: $ … ⇒ r ∊ fseq u $ by subset_elim [f1, e8]
f3: $ … ⇒ h ∈ trees ω $ by welc_wcel [#4]
f4: $ … ⇒ g ∈ trees ω $ by welc_wcel [#3]
f5: $ … ⇒ sat u M ⟨ kc_cons , h +: g +: ∅ ⟩ w = sat u M x w $ by f2_sat_eq [e5b]
k1: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ x0 = dt u M e w r $ by ax
k2: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ x0 ∊ u $ by ax
k3: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ x1 = ∅ $ by ax
k4: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ dt u M e w r ∈ dt u M h w r $ by weaken [h3]
k5a: $ … ⇒ dt u M e w r = x0 $ by eq_sym [k1]
k5: $ … ⇒ x0 ∈ dt u M h w r $ by wcel_eq_l [k5a, k4]
k6: $ … ⇒ x0 ∊ dt u M h w r $ by wcel_welc [k5]
k7: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ r ∊ sat u M g w $ by weaken [e8]
k8a: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ h ∈ trees ω $ by weaken [f3]
k8b: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ g ∈ trees ω $ by weaken [f4]
k8c: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ w ∊ lvals $ by weaken [#1]
k9: $ … ⇒ x0 +: r ∈ sat u M ⟨ kc_cons , h +: g +: ∅ ⟩ w $ by sat_cons_intro [k8a, k8b, k8c, k7, k6, k2]
k10: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ sat u M ⟨ kc_cons , h +: g +: ∅ ⟩ w = sat u M x w $ by weaken [f5]
k11: $ … ⇒ x0 +: r ∈ sat u M x w $ by wcel_eq_r [k10, k9]
k12: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ r ∊ fseq u $ by weaken [f2]
k13: $ … ⇒ x0 +: r ∈ fseq u $ by scons_fseq [k2, k12]
k14: $ … ⇒ ∅ ++ (x0 +: r) = x0 +: r $ by scat_empty_l_c [k13]
k15a: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ x0 +: r = x0 +: r $ by eq_refl
k15: $ … ⇒ x1 ++ (x0 +: r) = ∅ ++ (x0 +: r) $ by scat_eq [k3, k15a]
k16: $ … ⇒ x1 ++ (x0 +: r) = x0 +: r $ by eq_trans [k15, k14]
k17a: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ x1 = x1 $ by eq_refl
k17b: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ r = r $ by eq_refl
k17c: $ … ⇒ x0 +: r = dt u M e w r +: r $ by scons_eq [k1, k17b]
k17: $ … ⇒ x1 ++ (x0 +: r) = x1 ++ (dt u M e w r +: r) $ by scat_eq [k17a, k17c]
k18a: $ … ⇒ x0 +: r = x1 ++ (x0 +: r) $ by eq_sym [k16]
k18: $ … ⇒ x0 +: r = x1 ++ (dt u M e w r +: r) $ by eq_trans [k18a, k17]
k19: $ … ⇒ x1 ++ (dt u M e w r +: r) ∈ sat u M x w $ by wcel_eq_l [k18, k11]
k20a: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
k20b: $ … ⇒ ∅ = x1 $ by eq_sym [k3]
k20c: $ … ⇒ x1 ∈ fseq u $ by wcel_eq_l [k20b, k20a]
k20: $ … ⇒ x1 ∊ fseq u $ by wcel_welc [k20c]
k21a: $ … ⇒ cdm x1 = cdm ∅ $ by cdm_eq [k3]
k21b: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ cdm ∅ = ∅ $ by cdm_empty
k21c: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ nvf = nvf $ by eq_refl
k21d: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by weaken [q1]
k21e: $ … ⇒ nvf' z = nvf' ⟨ kc_nz , ∅ ⟩ $ by fv_eq [k21c, k21d]
k21f: $ G , x0 = dt u M e w r , x0 ∊ u , x1 = ∅ ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
k21g: $ … ⇒ nvf' z = ∅ $ by eq_trans [k21e, k21f]
k21h: $ … ⇒ ∅ = nvf' z $ by eq_sym [k21g]
k21i: $ … ⇒ cdm x1 = ∅ $ by eq_trans [k21a, k21b]
k21: $ … ⇒ cdm x1 = nvf' z $ by eq_trans [k21i, k21h]
k22a: $ … ⇒ x1 ++ r = ∅ ++ r $ by scat_eq [k3, k17b]
k22b: $ … ⇒ ∅ ++ r = r $ by scat_empty_l [k12]
k22c: $ … ⇒ x1 ++ r = r $ by eq_trans [k22a, k22b]
k22: $ … ⇒ r = x1 ++ r $ by eq_sym [k22c]
c1: $ … ⇒ r = x1 ++ r ∧ x1 ++ (dt u M e w r +: r) ∈ sat u M x w $ by and_intro [k22, k19]
c2: $ … ⇒ r ∊ sat u M g w ∧ r = x1 ++ r ∧ x1 ++ (dt u M e w r +: r) ∈ sat u M x w $ by and_intro [k7, c1]
c3: $ … ⇒ cdm x1 = nvf' z ∧ r ∊ sat u M g w ∧ r = x1 ++ r ∧ x1 ++ (dt u M e w r +: r) ∈ sat u M x w $ by and_intro [k21, c2]
c4: $ … ⇒ x1 ∊ fseq u ∧ cdm x1 = nvf' z ∧ r ∊ sat u M g w ∧ r = x1 ++ r ∧ x1 ++ (dt u M e w r +: r) ∈ sat u M x w $ by and_intro [k20, c3]
c5: $ … ⇒ ∃ t (x1 ∊ fseq u ∧ cdm x1 = nvf' z ∧ t ∊ sat u M g w ∧ r = x1 ++ t ∧ x1 ++ (dt u M e w t +: t) ∈ sat u M x w) $ by ex_intro [c4]
c6: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by ex_intro [c5]
d0: $ G , x0 = dt u M e w r , x0 ∊ u ⇒ isset ∅ $ by ax_empty
d1: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by isset_elim [d0, c6]
d2: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by wcel_elim [h4, d1]

--| The clause `cinst_s`, with the induction hypothesis's split `q = a ++ b`
--| of the tail named.
lemma f3_cs2 (G: hyps) {v p t: set} (M: class) (u w g h e x r z k i m n o q a b: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ v (v ∊ sat u M g w → dt u M e w v ∈ dt u M h w v ∧ dt u M e w v ∈ u) $ > $ G ⇒ z = ⟨ kc_s , k +: ∅ ⟩ $ > $ G ⇒ k ∈ trees ω $ >
  $ G ⇒ x = ⟨ kc_cons , m +: i +: ∅ ⟩ $ > $ G ⇒ m ∈ trees ω $ > $ G ⇒ i ∈ trees ω $ >
  $ G ⇒ ra_inst k m e n ∈ lrel $ > $ G ⇒ r = o +: q $ > $ G ⇒ o ∊ dt u M n w q $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ a ∊ fseq u ∧ cdm a = nvf' k ∧ b ∊ sat u M g w ∧ q = a ++ b ∧ a ++ (dt u M e w b +: b) ∈ sat u M i w $ > $ G ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $
----
c1: $ … ⇒ a ∊ fseq u $ by and_elim_l [#12]
d1: $ … ⇒ cdm a = nvf' k ∧ b ∊ sat u M g w ∧ q = a ++ b ∧ a ++ (dt u M e w b +: b) ∈ sat u M i w $ by and_elim_r [#12]
c2: $ … ⇒ cdm a = nvf' k $ by and_elim_l [d1]
d2: $ … ⇒ b ∊ sat u M g w ∧ q = a ++ b ∧ a ++ (dt u M e w b +: b) ∈ sat u M i w $ by and_elim_r [d1]
c3: $ … ⇒ b ∊ sat u M g w $ by and_elim_l [d2]
d3: $ … ⇒ q = a ++ b ∧ a ++ (dt u M e w b +: b) ∈ sat u M i w $ by and_elim_r [d2]
c4: $ … ⇒ q = a ++ b $ by and_elim_l [d3]
c5: $ … ⇒ a ++ (dt u M e w b +: b) ∈ sat u M i w $ by and_elim_r [d3]
hb1: $ … ⇒ b ∊ sat u M g w → dt u M e w b ∈ dt u M h w b ∧ dt u M e w b ∈ u $ by all_elim [#2]
hb2: $ … ⇒ dt u M e w b ∈ dt u M h w b ∧ dt u M e w b ∈ u $ by imp_elim [hb1, c3]
hb4: $ … ⇒ dt u M e w b ∈ u $ by and_elim_r [hb2]
f1: $ G ⇒ sat u M g w ⊆ fseq u $ by sat_fseq
f2: $ … ⇒ b ∊ fseq u $ by subset_elim [f1, c3]
f3: $ … ⇒ b ∈ fseq u $ by welc_wcel [f2]
i1: $ … ⇒ dt u M n w (a ++ b) = dt u M m w (a ++ (dt u M e w b +: b)) $ by lrel_inst_sem [#8, #1, c1, c2, f2, hb4]
e1: $ G ⇒ u = u $ by eq_refl
e2: $ G ⇒ M = M $ by eq_refl
e3: $ G ⇒ n = n $ by eq_refl
e4: $ G ⇒ w = w $ by eq_refl
o1: $ … ⇒ dt u M n w q = dt u M n w (a ++ b) $ by dt_eq [e1, e2, e3, e4, c4]
o2: $ … ⇒ o ∊ dt u M n w (a ++ b) $ by welc_eq [o1, #10]
o3: $ … ⇒ o ∊ dt u M m w (a ++ (dt u M e w b +: b)) $ by welc_eq [i1, o2]
o4: $ … ⇒ r ∈ fseq u $ by welc_wcel [#11]
o5: $ … ⇒ o +: q ∈ fseq u $ by wcel_eq_l [#9, o4]
o6: $ … ⇒ o ∊ u $ by scons_fseq_hd [o5]
x2s: $ … ⇒ dt u M e w b +: b ∈ fseq u $ by scons_fseq_c [hb4, f3]
x3s: $ … ⇒ o +: a ∈ fseq u $ by scons_fseq [o6, c1]
j1: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u ⇒ x2 = dt u M e w b +: b $ by ax
j2: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u ⇒ a = a $ by eq_refl
j3: $ … ⇒ dt u M e w b +: b = x2 $ by eq_sym [j1]
j4: $ … ⇒ a ++ (dt u M e w b +: b) = a ++ x2 $ by scat_eq [j2, j3]
j5: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u ⇒ a ++ (dt u M e w b +: b) ∈ sat u M i w $ by weaken [c5]
j6: $ … ⇒ a ++ x2 ∈ sat u M i w $ by wcel_eq_l [j4, j5]
k0: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w ⇒ o +: a ∈ fseq u $ by weaken [x3s]
g1: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x2 = dt u M e w b +: b $ by ax
g2: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x2 ∊ fseq u $ by ax
g3: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x0 = a ++ x2 $ by ax
g4: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x0 ∊ sat u M i w $ by ax
g5: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x3 = o +: a $ by ax
g6: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x3 ∊ fseq u $ by ax
g1b: $ … ⇒ dt u M e w b +: b = x2 $ by eq_sym [g1]
g3b: $ … ⇒ a ++ x2 = x0 $ by eq_sym [g3]
ra: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ a = a $ by eq_refl
rb: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ b = b $ by eq_refl
ro: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ o = o $ by eq_refl
ru: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ u = u $ by eq_refl
rM: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ M = M $ by eq_refl
rm: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ m = m $ by eq_refl
rw: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ w = w $ by eq_refl
rx2: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x2 = x2 $ by eq_refl
rx3: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x3 = x3 $ by eq_refl
rnvf: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ nvf = nvf $ by eq_refl
h1: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ o ∊ dt u M m w (a ++ (dt u M e w b +: b)) $ by weaken [o3]
h2: $ … ⇒ a ++ (dt u M e w b +: b) = a ++ x2 $ by scat_eq [ra, g1b]
h3: $ … ⇒ a ++ (dt u M e w b +: b) = x0 $ by eq_trans [h2, g3b]
h4: $ … ⇒ dt u M m w (a ++ (dt u M e w b +: b)) = dt u M m w x0 $ by dt_eq [ru, rM, rm, rw, h3]
h5: $ … ⇒ o ∊ dt u M m w x0 $ by welc_eq [h4, h1]
h6a: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ m ∈ trees ω $ by weaken [#6]
h6b: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ i ∈ trees ω $ by weaken [#7]
h6c: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ w ∊ lvals $ by weaken [#1]
h6d: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ o ∊ u $ by weaken [o6]
h6: $ … ⇒ o +: x0 ∈ sat u M ⟨ kc_cons , m +: i +: ∅ ⟩ w $ by sat_cons_intro [h6a, h6b, h6c, g4, h5, h6d]
h7a: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ x = ⟨ kc_cons , m +: i +: ∅ ⟩ $ by weaken [#5]
h7b: $ … ⇒ ⟨ kc_cons , m +: i +: ∅ ⟩ = x $ by eq_sym [h7a]
h7: $ … ⇒ sat u M ⟨ kc_cons , m +: i +: ∅ ⟩ w = sat u M x w $ by f2_sat_eq [h7b]
h8: $ … ⇒ o +: x0 ∈ sat u M x w $ by wcel_eq_r [h7, h6]
c1w: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ a ∊ fseq u $ by weaken [c1]
m1: $ … ⇒ x3 ++ (dt u M e w b +: b) = x3 ++ x2 $ by scat_eq [rx3, g1b]
m2: $ … ⇒ x3 ++ x2 = (o +: a) ++ x2 $ by scat_eq [g5, rx2]
m3: $ … ⇒ (o +: a) ++ x2 = o +: a ++ x2 $ by scat_scons [c1w, g2]
m4: $ … ⇒ o +: a ++ x2 = o +: x0 $ by scons_eq [ro, g3b]
m5: $ … ⇒ x3 ++ (dt u M e w b +: b) = (o +: a) ++ x2 $ by eq_trans [m1, m2]
m6: $ … ⇒ x3 ++ (dt u M e w b +: b) = o +: a ++ x2 $ by eq_trans [m5, m3]
m7: $ … ⇒ x3 ++ (dt u M e w b +: b) = o +: x0 $ by eq_trans [m6, m4]
m8: $ … ⇒ o +: x0 = x3 ++ (dt u M e w b +: b) $ by eq_sym [m7]
m9: $ … ⇒ x3 ++ (dt u M e w b +: b) ∈ sat u M x w $ by wcel_eq_l [m8, h8]
n1: $ … ⇒ cdm x3 = cdm (o +: a) $ by cdm_eq [g5]
n2: $ … ⇒ cdm (o +: a) = suc (cdm a) $ by scons_len [c1w]
n3a: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ cdm a = nvf' k $ by weaken [c2]
n3: $ … ⇒ suc (cdm a) = suc (nvf' k) $ by suc_eq [n3a]
n4a: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ z = ⟨ kc_s , k +: ∅ ⟩ $ by weaken [#3]
n4: $ … ⇒ nvf' z = nvf' ⟨ kc_s , k +: ∅ ⟩ $ by fv_eq [rnvf, n4a]
n5a: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ k ∈ trees ω $ by weaken [#4]
n5: $ … ⇒ nvf' ⟨ kc_s , k +: ∅ ⟩ = suc (nvf' k) $ by nvf_s [n5a]
n6: $ … ⇒ nvf' z = suc (nvf' k) $ by eq_trans [n4, n5]
n7: $ … ⇒ suc (nvf' k) = nvf' z $ by eq_sym [n6]
n8: $ … ⇒ cdm x3 = suc (cdm a) $ by eq_trans [n1, n2]
n9: $ … ⇒ cdm x3 = suc (nvf' k) $ by eq_trans [n8, n3]
n10: $ … ⇒ cdm x3 = nvf' z $ by eq_trans [n9, n7]
p1: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ r = o +: q $ by weaken [#9]
p2a: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ q = a ++ b $ by weaken [c4]
p2: $ … ⇒ o +: q = o +: a ++ b $ by scons_eq [ro, p2a]
p3: $ … ⇒ x3 ++ b = (o +: a) ++ b $ by scat_eq [g5, rb]
p4a: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ b ∊ fseq u $ by weaken [f2]
p4: $ … ⇒ (o +: a) ++ b = o +: a ++ b $ by scat_scons [c1w, p4a]
p5: $ … ⇒ r = o +: a ++ b $ by eq_trans [p1, p2]
p6: $ … ⇒ x3 ++ b = o +: a ++ b $ by eq_trans [p3, p4]
p7: $ … ⇒ o +: a ++ b = x3 ++ b $ by eq_sym [p6]
p8: $ … ⇒ r = x3 ++ b $ by eq_trans [p5, p7]
p9: $ G , x2 = dt u M e w b +: b , x2 ∊ fseq u , x0 = a ++ x2 , x0 ∊ sat u M i w , x3 = o +: a , x3 ∊ fseq u ⇒ b ∊ sat u M g w $ by weaken [c3]
s1: $ … ⇒ r = x3 ++ b ∧ x3 ++ (dt u M e w b +: b) ∈ sat u M x w $ by and_intro [p8, m9]
s2: $ … ⇒ b ∊ sat u M g w ∧ r = x3 ++ b ∧ x3 ++ (dt u M e w b +: b) ∈ sat u M x w $ by and_intro [p9, s1]
s3: $ … ⇒ cdm x3 = nvf' z ∧ b ∊ sat u M g w ∧ r = x3 ++ b ∧ x3 ++ (dt u M e w b +: b) ∈ sat u M x w $ by and_intro [n10, s2]
s4: $ … ⇒ x3 ∊ fseq u ∧ cdm x3 = nvf' z ∧ b ∊ sat u M g w ∧ r = x3 ++ b ∧ x3 ++ (dt u M e w b +: b) ∈ sat u M x w $ by and_intro [g6, s3]
s5: $ … ⇒ ∃ t (x3 ∊ fseq u ∧ cdm x3 = nvf' z ∧ t ∊ sat u M g w ∧ r = x3 ++ t ∧ x3 ++ (dt u M e w t +: t) ∈ sat u M x w) $ by ex_intro [s4]
s6: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by ex_intro [s5]
s7: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by wcel_elim [k0, s6]
s8: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by wcel_elim [j6, s7]
s9: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by wcel_elim [x2s, s8]

--| The clause `cinst_s`: the induction hypothesis at the shorter prefix.
lemma f3_cs (G: hyps) {v p t: set} (M: class) (u w g h e c j z x y r k a i l b d m n: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ v (v ∊ sat u M g w → dt u M e w v ∈ dt u M h w v ∧ dt u M e w v ∈ u) $ > $ G ⇒ crn j ⊆ f3_cp u M w g h e $ > $ G ⇒ z = ⟨ c , j ⟩ $ >
  $ G ⇒ z ∊ trees ω $ > $ G ⇒ x ∊ trees ω $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ z = ⟨ kc_s , k +: ∅ ⟩ ∧ g = a ∧ h = b ∧ e = d ∧ x = ⟨ kc_cons , m +: i +: ∅ ⟩ ∧ y = ⟨ kc_cons , n +: l +: ∅ ⟩ ∧ ra_cinst k a b d i l ∈ lrel ∧ ra_inst k m d n ∈ lrel $ > $ G ⇒ r ∊ sat u M y w $ >
  $ G ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $
----
q1: $ … ⇒ z = ⟨ kc_s , k +: ∅ ⟩ $ by and_elim_l [#8]
r1: $ … ⇒ g = a ∧ h = b ∧ e = d ∧ x = ⟨ kc_cons , m +: i +: ∅ ⟩ ∧ y = ⟨ kc_cons , n +: l +: ∅ ⟩ ∧ ra_cinst k a b d i l ∈ lrel ∧ ra_inst k m d n ∈ lrel $ by and_elim_r [#8]
q2: $ … ⇒ g = a $ by and_elim_l [r1]
r2: $ … ⇒ h = b ∧ e = d ∧ x = ⟨ kc_cons , m +: i +: ∅ ⟩ ∧ y = ⟨ kc_cons , n +: l +: ∅ ⟩ ∧ ra_cinst k a b d i l ∈ lrel ∧ ra_inst k m d n ∈ lrel $ by and_elim_r [r1]
q3: $ … ⇒ h = b $ by and_elim_l [r2]
r3: $ … ⇒ e = d ∧ x = ⟨ kc_cons , m +: i +: ∅ ⟩ ∧ y = ⟨ kc_cons , n +: l +: ∅ ⟩ ∧ ra_cinst k a b d i l ∈ lrel ∧ ra_inst k m d n ∈ lrel $ by and_elim_r [r2]
q4: $ … ⇒ e = d $ by and_elim_l [r3]
r4: $ … ⇒ x = ⟨ kc_cons , m +: i +: ∅ ⟩ ∧ y = ⟨ kc_cons , n +: l +: ∅ ⟩ ∧ ra_cinst k a b d i l ∈ lrel ∧ ra_inst k m d n ∈ lrel $ by and_elim_r [r3]
q5: $ … ⇒ x = ⟨ kc_cons , m +: i +: ∅ ⟩ $ by and_elim_l [r4]
r5: $ … ⇒ y = ⟨ kc_cons , n +: l +: ∅ ⟩ ∧ ra_cinst k a b d i l ∈ lrel ∧ ra_inst k m d n ∈ lrel $ by and_elim_r [r4]
q6: $ … ⇒ y = ⟨ kc_cons , n +: l +: ∅ ⟩ $ by and_elim_l [r5]
r6: $ … ⇒ ra_cinst k a b d i l ∈ lrel ∧ ra_inst k m d n ∈ lrel $ by and_elim_r [r5]
q7: $ … ⇒ ra_cinst k a b d i l ∈ lrel $ by and_elim_l [r6]
q8: $ … ⇒ ra_inst k m d n ∈ lrel $ by and_elim_r [r6]
rk: $ G ⇒ k = k $ by eq_refl
ri: $ G ⇒ i = i $ by eq_refl
rl: $ G ⇒ l = l $ by eq_refl
rm: $ G ⇒ m = m $ by eq_refl
rn: $ G ⇒ n = n $ by eq_refl
q2b: $ … ⇒ a = g $ by eq_sym [q2]
q3b: $ … ⇒ b = h $ by eq_sym [q3]
q4b: $ … ⇒ d = e $ by eq_sym [q4]
t1a: $ … ⇒ ra_cinst k a b d i l = ra_cinst k g h e i l $ by ra_cinst_eq [rk, q2b, q3b, q4b, ri, rl]
t1: $ … ⇒ ra_cinst k g h e i l ∈ lrel $ by wcel_eq_l [t1a, q7]
t2a: $ … ⇒ ra_inst k m d n = ra_inst k m e n $ by ra_inst_eq [rk, rm, q4b, rn]
t2: $ … ⇒ ra_inst k m e n ∈ lrel $ by wcel_eq_l [t2a, q8]
v1a: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
v1: $ … ⇒ isset kc_s $ by wcel_isset [v1a]
v2a: $ G ⇒ isset ∅ $ by ax_empty
v2: $ … ⇒ isset (k +: ∅) $ by scons_set [v2a]
v3: $ … ⇒ crn (k +: ∅) ⊆ f3_cp u M w g h e $ by p1_ch [#3, #4, q1, v1, v2]
v4a: $ G ⇒ isset k $ by isset_var
v4: $ … ⇒ k ∈ f3_cp u M w g h e $ by crn_scons_head [v4a, v3]
v5: $ … ⇒ k ∊ f3_cp u M w g h e $ by wcel_welc [v4]
o0: $ G ⇒ isset ω $ by omega_set
z1: $ … ⇒ z ∈ trees ω $ by welc_wcel [#5]
z2: $ … ⇒ ⟨ kc_s , k +: ∅ ⟩ ∈ trees ω $ by wcel_eq_l [q1, z1]
z3: $ … ⇒ k ∊ trees ω $ by trees_kids1 [o0, z2, v1]
z4: $ … ⇒ k ∈ trees ω $ by welc_wcel [z3]
w0a: $ G ⇒ kc_cons ∈ ω $ by kc_cons_omega
w0: $ … ⇒ isset kc_cons $ by wcel_isset [w0a]
x1: $ … ⇒ x ∈ trees ω $ by welc_wcel [#6]
x2: $ … ⇒ ⟨ kc_cons , m +: i +: ∅ ⟩ ∈ trees ω $ by wcel_eq_l [q5, x1]
x3: $ … ⇒ m ∊ trees ω ∧ i ∊ trees ω $ by trees_kids2 [o0, x2, w0]
x4a: $ … ⇒ m ∊ trees ω $ by and_elim_l [x3]
x4b: $ … ⇒ i ∊ trees ω $ by and_elim_r [x3]
x5: $ … ⇒ m ∈ trees ω $ by welc_wcel [x4a]
x6: $ … ⇒ i ∈ trees ω $ by welc_wcel [x4b]
y1: $ … ⇒ y ∈ trees ω $ by welc_wcel [#7]
y2: $ … ⇒ ⟨ kc_cons , n +: l +: ∅ ⟩ ∈ trees ω $ by wcel_eq_l [q6, y1]
y3: $ … ⇒ n ∊ trees ω ∧ l ∊ trees ω $ by trees_kids2 [o0, y2, w0]
y4a: $ … ⇒ n ∊ trees ω $ by and_elim_l [y3]
y4b: $ … ⇒ l ∊ trees ω $ by and_elim_r [y3]
y5: $ … ⇒ n ∈ trees ω $ by welc_wcel [y4a]
y6: $ … ⇒ l ∈ trees ω $ by welc_wcel [y4b]
s0: $ … ⇒ sat u M y w = sat u M ⟨ kc_cons , n +: l +: ∅ ⟩ w $ by f2_sat_eq [q6]
s1: $ … ⇒ r ∊ sat u M ⟨ kc_cons , n +: l +: ∅ ⟩ w $ by welc_eq [s0, #9]
s2: $ … ⇒ ∃ o ∃ q (q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q) $ by sat_cons_elim [y5, y6, #1, s1]
s3: $ G ⇒ sat u M y w ⊆ fseq u $ by sat_fseq
s4: $ … ⇒ r ∊ fseq u $ by subset_elim [s3, #9]
a1: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q ⇒ q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q $ by ax
a2: $ … ⇒ q ∊ sat u M l w $ by and_elim_l [a1]
a3: $ … ⇒ o ∊ dt u M n w q ∧ r = o +: q $ by and_elim_r [a1]
a4: $ … ⇒ o ∊ dt u M n w q $ by and_elim_l [a3]
a5: $ … ⇒ r = o +: q $ by and_elim_r [a3]
a6: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q ⇒ k ∊ f3_cp u M w g h e $ by weaken [v5]
a7: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q ⇒ ra_cinst k g h e i l ∈ lrel $ by weaken [t1]
a8: $ … ⇒ ∃ x8 ∃ x9 (x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w) $ by f3_cp_e [a6, a7, a2]
b1: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ w ∊ lvals $ by weaken [#1]
b2: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ ∀ v (v ∊ sat u M g w → dt u M e w v ∈ dt u M h w v ∧ dt u M e w v ∈ u) $ by weaken [#2]
b3: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ z = ⟨ kc_s , k +: ∅ ⟩ $ by weaken [q1]
b4: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ k ∈ trees ω $ by weaken [z4]
b5: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ x = ⟨ kc_cons , m +: i +: ∅ ⟩ $ by weaken [q5]
b6: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ m ∈ trees ω $ by weaken [x5]
b7: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ i ∈ trees ω $ by weaken [x6]
b8: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ ra_inst k m e n ∈ lrel $ by weaken [t2]
b9: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ r = o +: q $ by weaken [a5]
b10: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ o ∊ dt u M n w q $ by weaken [a4]
b11: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ r ∊ fseq u $ by weaken [s4]
b12: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w ⇒ x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w $ by ax
b13: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by f3_cs2 [b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12]
e1a: $ G , q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q , ∃ x9 (x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w) ⇒ ∃ x9 (x8 ∊ fseq u ∧ cdm x8 = nvf' k ∧ x9 ∊ sat u M g w ∧ q = x8 ++ x9 ∧ x8 ++ (dt u M e w x9 +: x9) ∈ sat u M i w) $ by ax
e1: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by ex_elim [e1a, b13]
e2: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by ex_elim [a8, e1]
e3a: $ G , ∃ q (q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q) ⇒ ∃ q (q ∊ sat u M l w ∧ o ∊ dt u M n w q ∧ r = o +: q) $ by ax
e3: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by ex_elim [e3a, e2]
e4: $ … ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $ by ex_elim [s2, e3]

--| One node of the induction.
lemma f3_node (G: hyps) {v p t: set} (M: class) (u w g h e c j z x y r: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ v (v ∊ sat u M g w → dt u M e w v ∈ dt u M h w v ∧ dt u M e w v ∈ u) $ > $ G ⇒ crn j ⊆ f3_cp u M w g h e $ > $ G ⇒ z = ⟨ c , j ⟩ $ >
  $ G ⇒ ra_cinst z g h e x y ∈ lrel $ > $ G ⇒ r ∊ sat u M y w $ > $ G ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' z ∧ t ∊ sat u M g w ∧ r = p ++ t ∧ p ++ (dt u M e w t +: t) ∈ sat u M x w) $
----
a0: $ G ⇒ kr_cinst ∈ ω $ by kr_cinst_omega
a1: $ … ⇒ isset kr_cinst $ by wcel_isset [a0]
a2: $ … ⇒ z ∊ trees ω ∧ g ∊ trees ω ∧ h ∊ trees ω ∧ e ∊ trees ω ∧ x ∊ trees ω ∧ y ∊ trees ω $ by lrel_args6 [#5, a1]
zt: $ … ⇒ z ∊ trees ω $ by and_elim_l [a2]
