--| The trees `y` closed below any `k` in every derivable `closed k y`, with the same value at
--| valuations that agree below `k`.
def p1_clp (U M W: class) (.y .k .a .b .i: set): class = $ {y | ∀ k ∀ a ∀ b (⟨ kr_closed , k +: y +: ∅ ⟩ ∈ lrel → a ∊ fseq U → b ∊ fseq U → ∀ i (i ∊ nvf' k → a' i = b' i) → dt U M y W a = dt U M y W b)} $

lemma p1_clp_e {i: set} (G: hyps i) (M: class) (u w x c d e: set): $ G ⇒ x ∊ p1_clp u M w $ > $ G ⇒ ra_closed c x ∈ lrel $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) $ > $ G ⇒ dt u M x w d = dt u M x w e $
----
l1: $ … ⇒ ∀ k ∀ a ∀ b (⟨ kr_closed , k +: x +: ∅ ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nvf' k → a' i = b' i) → dt u M x w a = dt u M x w b) $ by cab_elim [#1]
l2: $ … ⇒ ∀ a ∀ b (⟨ kr_closed , c +: x +: ∅ ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nvf' c → a' i = b' i) → dt u M x w a = dt u M x w b) $ by all_elim [l1]
l3: $ … ⇒ ∀ b (⟨ kr_closed , c +: x +: ∅ ⟩ ∈ lrel → d ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nvf' c → d' i = b' i) → dt u M x w d = dt u M x w b) $ by all_elim [l2]
l4: $ … ⇒ ⟨ kr_closed , c +: x +: ∅ ⟩ ∈ lrel → d ∊ fseq u → e ∊ fseq u → ∀ i (i ∊ nvf' c → d' i = e' i) → dt u M x w d = dt u M x w e $ by all_elim [l3]
l5: $ … ⇒ d ∊ fseq u → e ∊ fseq u → ∀ i (i ∊ nvf' c → d' i = e' i) → dt u M x w d = dt u M x w e $ by imp_elim [l4, #2]
l6: $ … ⇒ e ∊ fseq u → ∀ i (i ∊ nvf' c → d' i = e' i) → dt u M x w d = dt u M x w e $ by imp_elim [l5, #3]
l7: $ … ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) → dt u M x w d = dt u M x w e $ by imp_elim [l6, #4]
l8: $ … ⇒ dt u M x w d = dt u M x w e $ by imp_elim [l7, #5]

lemma p1_clp_i {k a b i: set} (G: hyps) (M: class) (u w x: set): $ G , ra_closed k x ∈ lrel , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nvf' k → a' i = b' i) ⇒ dt u M x w a = dt u M x w b $ > $ G ⇒ x ∊ p1_clp u M w $
----
l1: $ … ⇒ ∀ i (i ∊ nvf' k → a' i = b' i) → dt u M x w a = dt u M x w b $ by imp_intro [#1]
l2: $ … ⇒ b ∊ fseq u → ∀ i (i ∊ nvf' k → a' i = b' i) → dt u M x w a = dt u M x w b $ by imp_intro [l1]
l3: $ … ⇒ a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nvf' k → a' i = b' i) → dt u M x w a = dt u M x w b $ by imp_intro [l2]
l4: $ … ⇒ ⟨ kr_closed , k +: x +: ∅ ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nvf' k → a' i = b' i) → dt u M x w a = dt u M x w b $ by imp_intro [l3]
l5: $ … ⇒ ∀ b (⟨ kr_closed , k +: x +: ∅ ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nvf' k → a' i = b' i) → dt u M x w a = dt u M x w b) $ by all_intro [l4]
l6: $ … ⇒ ∀ a ∀ b (⟨ kr_closed , k +: x +: ∅ ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nvf' k → a' i = b' i) → dt u M x w a = dt u M x w b) $ by all_intro [l5]
l7: $ … ⇒ ∀ k ∀ a ∀ b (⟨ kr_closed , k +: x +: ∅ ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nvf' k → a' i = b' i) → dt u M x w a = dt u M x w b) $ by all_intro [l6]
l8: $ G ⇒ x ∊ p1_clp u M w $ by cab_intro [l7]

lemma p1_agr {i: set} (G: hyps i) (K L A B C D: class): $ G ⇒ K = L $ > $ G ⇒ A = C $ > $ G ⇒ B = D $ > $ G ⇒ ∀ i (i ∊ K → A' i = B' i) $ > $ G ⇒ ∀ i (i ∊ L → C' i = D' i) $
----
l1: $ G , j ∊ L ⇒ j ∊ L $ by ax
l2a: $ G , j ∊ L ⇒ K = L $ by weaken [#1]
l2: $ … ⇒ L = K $ by eq_sym [l2a]
l3: $ … ⇒ j ∊ K $ by welc_eq [l2, l1]
l4a: $ G , j ∊ L ⇒ ∀ i (i ∊ K → A' i = B' i) $ by weaken [#4]
l4: $ … ⇒ j ∊ K → A' j = B' j $ by all_elim [l4a]
l5: $ … ⇒ A' j = B' j $ by imp_elim [l4, l3]
l6: $ G , j ∊ L ⇒ j = j $ by eq_refl
l7a: $ G , j ∊ L ⇒ A = C $ by weaken [#2]
l7: $ … ⇒ C = A $ by eq_sym [l7a]
l8: $ … ⇒ C' j = A' j $ by fv_eq [l7, l6]
l9a: $ G , j ∊ L ⇒ B = D $ by weaken [#3]
l9: $ … ⇒ B' j = D' j $ by fv_eq [l9a, l6]
l10: $ … ⇒ C' j = B' j $ by eq_trans [l8, l5]
l11: $ … ⇒ C' j = D' j $ by eq_trans [l10, l9]
l12: $ … ⇒ j ∊ L → C' j = D' j $ by imp_intro [l11]
l13: $ … ⇒ ∀ j (j ∊ L → C' j = D' j) $ by all_intro [l12]
l14: $ _ ⇒ ∀ j (j ∊ L → C' j = D' j) ↔ ∀ i (i ∊ L → C' i = D' i) $ by all_alpha
l15: $ G ⇒ ∀ j (j ∊ L → C' j = D' j) ↔ ∀ i (i ∊ L → C' i = D' i) $ by weaken [l14]
l16: $ … ⇒ ∀ i (i ∊ L → C' i = D' i) $ by bi_elim_l [l15, l13]

lemma p1_clp_ec {i: set} (G: hyps i) (M: class) (u w x k: set) (A B: class): $ G ⇒ x ∊ p1_clp u M w $ > $ G ⇒ ra_closed k x ∈ lrel $ > $ G ⇒ A ∈ fseq u $ > $ G ⇒ B ∈ fseq u $ > $ G ⇒ ∀ i (i ∊ nvf' k → A' i = B' i) $ > $ G ⇒ dt u M x w A = dt u M x w B $
----
h1: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ a = A $ by ax
h1s: $ … ⇒ A = a $ by eq_sym [h1]
h2: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ b = B $ by ax
h2s: $ … ⇒ B = b $ by eq_sym [h2]
h3: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ nvf' k = nvf' k $ by eq_refl
h4a: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ ∀ i (i ∊ nvf' k → A' i = B' i) $ by weaken [#5]
h4: $ … ⇒ ∀ i (i ∊ nvf' k → a' i = b' i) $ by p1_agr [h3, h1s, h2s, h4a]
h5a: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ x ∊ p1_clp u M w $ by weaken [#1]
h5b: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ ra_closed k x ∈ lrel $ by weaken [#2]
h5c: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ a ∊ fseq u $ by ax
h5d: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ b ∊ fseq u $ by ax
h5: $ … ⇒ dt u M x w a = dt u M x w b $ by p1_clp_e [h5a, h5b, h5c, h5d, h4]
r1: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ u = u $ by eq_refl
r2: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ M = M $ by eq_refl
r3: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ x = x $ by eq_refl
r4: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ w = w $ by eq_refl
h6: $ … ⇒ dt u M x w A = dt u M x w a $ by dt_eq [r1, r2, r3, r4, h1s]
h7: $ … ⇒ dt u M x w b = dt u M x w B $ by dt_eq [r1, r2, r3, r4, h2]
h8: $ … ⇒ dt u M x w A = dt u M x w b $ by eq_trans [h6, h5]
h9: $ … ⇒ dt u M x w A = dt u M x w B $ by eq_trans [h8, h7]
h10: $ … ⇒ dt u M x w A = dt u M x w B $ by wcel_elim [#4, h9]
h11: $ … ⇒ dt u M x w A = dt u M x w B $ by wcel_elim [#3, h10]

lemma p1_body {i: set} (G: hyps i) (M: class) (u w b y c x d e: set): $ G ⇒ b ∊ p1_clp u M w $ > $ G ⇒ ra_closed y b ∈ lrel $ > $ G ⇒ nvf' y = suc (nvf' c) $ > $ G ⇒ nvf' c ∈ ω $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) $ > $ G ⇒ dt u M b w (x +: d) = dt u M b w (x +: e) $
----
l1: $ G ⇒ x ∊ u ∨ ¬ x ∊ u $ by excluded_middle
p0: $ G , x ∊ u ⇒ x ∊ u $ by ax
p1a: $ G , x ∊ u ⇒ d ∊ fseq u $ by weaken [#5]
p1: $ … ⇒ x +: d ∈ fseq u $ by scons_fseq [p0, p1a]
p2a: $ G , x ∊ u ⇒ e ∊ fseq u $ by weaken [#6]
p2: $ … ⇒ x +: e ∈ fseq u $ by scons_fseq [p0, p2a]
p3a: $ G , x ∊ u ⇒ nvf' y = suc (nvf' c) $ by weaken [#3]
p3b: $ G , x ∊ u ⇒ nvf' c ∈ ω $ by weaken [#4]
p3c: $ G , x ∊ u ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) $ by weaken [#7]
p3y1: $ _ ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) ↔ ∀ j (j ∊ nvf' c → d' j = e' j) $ by all_alpha
p3y2: $ G , x ∊ u ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) ↔ ∀ j (j ∊ nvf' c → d' j = e' j) $ by weaken [p3y1]
p3y3: $ … ⇒ ∀ j (j ∊ nvf' c → d' j = e' j) $ by bi_elim_l [p3y2, p3c]
p3y4: $ … ⇒ ∀ j (j ∊ suc (nvf' c) → (x +: d)' j = (x +: e)' j) $ by scons_agree [p3b, p3y3]
p3y5: $ … ⇒ suc (nvf' c) = nvf' y $ by eq_sym [p3a]
p3y6: $ G , x ∊ u ⇒ x +: d = x +: d $ by eq_refl
p3y7: $ G , x ∊ u ⇒ x +: e = x +: e $ by eq_refl
p3y8: $ … ⇒ ∀ j (j ∊ nvf' y → (x +: d)' j = (x +: e)' j) $ by p1_agr [p3y5, p3y6, p3y7, p3y4]
p3y9: $ _ ⇒ ∀ j (j ∊ nvf' y → (x +: d)' j = (x +: e)' j) ↔ ∀ i (i ∊ nvf' y → (x +: d)' i = (x +: e)' i) $ by all_alpha
p3y10: $ G , x ∊ u ⇒ ∀ j (j ∊ nvf' y → (x +: d)' j = (x +: e)' j) ↔ ∀ i (i ∊ nvf' y → (x +: d)' i = (x +: e)' i) $ by weaken [p3y9]
p3: $ … ⇒ ∀ i (i ∊ nvf' y → (x +: d)' i = (x +: e)' i) $ by bi_elim_l [p3y10, p3y8]
p4a: $ G , x ∊ u ⇒ b ∊ p1_clp u M w $ by weaken [#1]
p4b: $ G , x ∊ u ⇒ ra_closed y b ∈ lrel $ by weaken [#2]
p4: $ … ⇒ dt u M b w (x +: d) = dt u M b w (x +: e) $ by p1_clp_ec [p4a, p4b, p1, p2, p3]
n0a: $ G , ¬ x ∊ u , x +: d ∈ fseq u ⇒ x +: d ∈ fseq u $ by ax
n0: $ … ⇒ x ∊ u $ by scons_fseq_hd [n0a]
n0b: $ G , ¬ x ∊ u , x +: d ∈ fseq u ⇒ ¬ x ∊ u $ by ax
n0c: $ … ⇒ ⊥ $ by not_elim [n0b, n0]
n1: $ … ⇒ ¬ x +: d ∈ fseq u $ by not_intro [n0c]
n2a: $ G , ¬ x ∊ u , x +: e ∈ fseq u ⇒ x +: e ∈ fseq u $ by ax
n2: $ … ⇒ x ∊ u $ by scons_fseq_hd [n2a]
n2b: $ G , ¬ x ∊ u , x +: e ∈ fseq u ⇒ ¬ x ∊ u $ by ax
n2c: $ … ⇒ ⊥ $ by not_elim [n2b, n2]
n3: $ … ⇒ ¬ x +: e ∈ fseq u $ by not_intro [n2c]
n4a: $ G , ¬ x ∊ u ⇒ ra_closed y b ∈ lrel $ by weaken [#2]
n4: $ … ⇒ dt u M b w (x +: d) = ∅ $ by lrel_closed_out [n4a, n1]
n5: $ … ⇒ dt u M b w (x +: e) = ∅ $ by lrel_closed_out [n4a, n3]
n6: $ … ⇒ ∅ = dt u M b w (x +: e) $ by eq_sym [n5]
n7: $ … ⇒ dt u M b w (x +: d) = dt u M b w (x +: e) $ by eq_trans [n4, n6]
l2: $ … ⇒ dt u M b w (x +: d) = dt u M b w (x +: e) $ by or_elim [l1, p4, n7]

--| The children of a node `z = ⟨ c , j ⟩` with `crn j ⊆ X`, at another
--| presentation of the node.
lemma p1_ch (G: hyps) (X K S: class) (z c j: set): $ G ⇒ crn j ⊆ X $ > $ G ⇒ z = ⟨ c , j ⟩ $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset S $ > $ G ⇒ crn S ⊆ X $
----
l1: $ … ⇒ ⟨ c , j ⟩ = z $ by eq_sym [#2]
l2: $ … ⇒ ⟨ c , j ⟩ = ⟨ K , S ⟩ $ by eq_trans [l1, #3]
l3: $ G ⇒ isset c $ by isset_var
l4: $ G ⇒ isset j $ by isset_var
l5: $ … ⇒ c = K ∧ j = S $ by opair_inj_c [l2, l3, l4, #4, #5]
l6: $ … ⇒ j = S $ by and_elim_r [l5]
l7: $ … ⇒ crn j = crn S $ by crn_eq [l6]
l8: $ … ⇒ crn S ⊆ X $ by subset_eq_l [l7, #1]

lemma p1_ztree (G: hyps) (k j z: set): $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ z ∊ trees ω $
----
l1: $ … ⇒ ⟨ k , j ⟩ ∈ ω × fseq (trees ω) $ by cxp_intro [#1, #2]
l2: $ G ⇒ isset ω $ by omega_set
l3: $ … ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [l2]
l4: $ … ⇒ ⟨ k , j ⟩ ∈ trees ω $ by wcel_eq_r [l3, l1]
l5: $ … ⇒ ⟨ k , j ⟩ = z $ by eq_sym [#3]
l6: $ … ⇒ z ∈ trees ω $ by wcel_eq_l [l5, l4]
l7: $ … ⇒ z ∊ trees ω $ by wcel_welc [l6]

lemma p1_cs_bvar {i: set} (G: hyps i) (M: class) (u w z c y d e: set): $ G ⇒ z = ⟨ kc_bvar , y +: ∅ ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_le ⟨ kc_s , y +: ∅ ⟩ c ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) $ > $ G ⇒ dt u M z w d = dt u M z w e $
----
rr0: $ G ⇒ u = u $ by eq_refl
rr1: $ G ⇒ M = M $ by eq_refl
rr2: $ G ⇒ w = w $ by eq_refl
k0: $ G ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
k1: $ … ⇒ isset kc_bvar $ by wcel_isset [k0]
k2a: $ G ⇒ isset ∅ $ by ax_empty
k2: $ … ⇒ isset (y +: ∅) $ by scons_set [k2a]
k3ay1: $ … ⇒ ⟨ kc_bvar , y +: ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #2]
k3ay2: $ G ⇒ isset ω $ by omega_set
k3ay3: $ … ⇒ kc_bvar ∈ ω ∧ y +: ∅ ∈ fseq (trees ω) $ by trees_node_c [k3ay2, k3ay1, k1, k2]
k3a: $ … ⇒ y +: ∅ ∈ fseq (trees ω) $ by and_elim_r [k3ay3]
k3: $ … ⇒ crn (y +: ∅) ⊆ trees ω $ by fseq_crn_c [k3a]
k4a: $ G ⇒ isset y $ by isset_var
k4: $ … ⇒ y ∈ trees ω $ by crn_scons_head [k4a, k3]
k4b: $ … ⇒ y ∊ trees ω $ by wcel_welc [k4]
d1: $ … ⇒ dt u M ⟨ kc_bvar , y +: ∅ ⟩ w d = d' nvf' y $ by dt_bvar [k4, #4, #5]
d2: $ … ⇒ dt u M ⟨ kc_bvar , y +: ∅ ⟩ w e = e' nvf' y $ by dt_bvar [k4, #4, #6]
d3q: $ G ⇒ d = d $ by eq_refl
d3: $ … ⇒ dt u M z w d = dt u M ⟨ kc_bvar , y +: ∅ ⟩ w d $ by dt_eq [rr0, rr1, #1, rr2, d3q]
d4q: $ G ⇒ e = e $ by eq_refl
d4: $ … ⇒ dt u M z w e = dt u M ⟨ kc_bvar , y +: ∅ ⟩ w e $ by dt_eq [rr0, rr1, #1, rr2, d4q]
v1: $ … ⇒ nvf' y ∈ nvf' c $ by lrel_le_suc_sem [#3, k4b]
m0: $ G , n = nvf' y , n ∊ nvf' c ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) $ by weaken [#7]
m1: $ … ⇒ n ∊ nvf' c → d' n = e' n $ by all_elim [m0]
m1a: $ G , n = nvf' y , n ∊ nvf' c ⇒ n ∊ nvf' c $ by ax
m2: $ … ⇒ d' n = e' n $ by imp_elim [m1, m1a]
m3a: $ G , n = nvf' y , n ∊ nvf' c ⇒ n = nvf' y $ by ax
m3b: $ G , n = nvf' y , n ∊ nvf' c ⇒ d = d $ by eq_refl
m3c: $ G , n = nvf' y , n ∊ nvf' c ⇒ e = e $ by eq_refl
m3: $ … ⇒ d' n = d' nvf' y $ by fv_eq [m3b, m3a]
m4: $ … ⇒ e' n = e' nvf' y $ by fv_eq [m3c, m3a]
m5s0: $ … ⇒ d' nvf' y = d' n $ by eq_sym [m3]
m5t1: $ … ⇒ d' nvf' y = e' n $ by eq_trans [m5s0, m2]
m5t2: $ … ⇒ d' nvf' y = e' nvf' y $ by eq_trans [m5t1, m4]
m6: $ … ⇒ d' nvf' y = e' nvf' y $ by wcel_elim [v1, m5t2]
ft1: $ … ⇒ dt u M z w d = d' nvf' y $ by eq_trans [d3, d1]
ft2: $ … ⇒ dt u M z w d = e' nvf' y $ by eq_trans [ft1, m6]
fs3: $ … ⇒ e' nvf' y = dt u M ⟨ kc_bvar , y +: ∅ ⟩ w e $ by eq_sym [d2]
ft3: $ … ⇒ dt u M z w d = dt u M ⟨ kc_bvar , y +: ∅ ⟩ w e $ by eq_trans [ft2, fs3]
fs4: $ … ⇒ dt u M ⟨ kc_bvar , y +: ∅ ⟩ w e = dt u M z w e $ by eq_sym [d4]
ft4: $ … ⇒ dt u M z w d = dt u M z w e $ by eq_trans [ft3, fs4]

lemma p1_cs_srt (G: hyps) (M: class) (u w z l d e: set): $ G ⇒ z = ⟨ kc_srt , l +: ∅ ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ dt u M z w d = dt u M z w e $
----
rr0: $ G ⇒ u = u $ by eq_refl
rr1: $ G ⇒ M = M $ by eq_refl
rr2: $ G ⇒ w = w $ by eq_refl
k0: $ G ⇒ kc_srt ∈ ω $ by kc_srt_omega
k1: $ … ⇒ isset kc_srt $ by wcel_isset [k0]
k2a: $ G ⇒ isset ∅ $ by ax_empty
k2: $ … ⇒ isset (l +: ∅) $ by scons_set [k2a]
k3ay1: $ … ⇒ ⟨ kc_srt , l +: ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #2]
k3ay2: $ G ⇒ isset ω $ by omega_set
k3ay3: $ … ⇒ kc_srt ∈ ω ∧ l +: ∅ ∈ fseq (trees ω) $ by trees_node_c [k3ay2, k3ay1, k1, k2]
k3a: $ … ⇒ l +: ∅ ∈ fseq (trees ω) $ by and_elim_r [k3ay3]
k3: $ … ⇒ crn (l +: ∅) ⊆ trees ω $ by fseq_crn_c [k3a]
k4a: $ G ⇒ isset l $ by isset_var
k4: $ … ⇒ l ∈ trees ω $ by crn_scons_head [k4a, k3]
d1: $ … ⇒ dt u M ⟨ kc_srt , l +: ∅ ⟩ w d = uni' (lv l w) $ by dt_srt [k4, #3, #4]
d2: $ … ⇒ dt u M ⟨ kc_srt , l +: ∅ ⟩ w e = uni' (lv l w) $ by dt_srt [k4, #3, #5]
d3q: $ G ⇒ d = d $ by eq_refl
d3: $ … ⇒ dt u M z w d = dt u M ⟨ kc_srt , l +: ∅ ⟩ w d $ by dt_eq [rr0, rr1, #1, rr2, d3q]
d4q: $ G ⇒ e = e $ by eq_refl
d4: $ … ⇒ dt u M z w e = dt u M ⟨ kc_srt , l +: ∅ ⟩ w e $ by dt_eq [rr0, rr1, #1, rr2, d4q]
ft1: $ … ⇒ dt u M z w d = uni' (lv l w) $ by eq_trans [d3, d1]
fs2: $ … ⇒ uni' (lv l w) = dt u M ⟨ kc_srt , l +: ∅ ⟩ w e $ by eq_sym [d2]
ft2: $ … ⇒ dt u M z w d = dt u M ⟨ kc_srt , l +: ∅ ⟩ w e $ by eq_trans [ft1, fs2]
fs3: $ … ⇒ dt u M ⟨ kc_srt , l +: ∅ ⟩ w e = dt u M z w e $ by eq_sym [d4]
ft3: $ … ⇒ dt u M z w d = dt u M z w e $ by eq_trans [ft2, fs3]

lemma p1_cs_atom (G: hyps) (M K S: class) (u w z d e: set): $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ K ∈ kexa $ > $ G ⇒ isset S $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ dt u M z w d = dt u M z w e $
----
rr0: $ G ⇒ u = u $ by eq_refl
rr1: $ G ⇒ M = M $ by eq_refl
rr2: $ G ⇒ w = w $ by eq_refl
k1: $ … ⇒ isset K $ by wcel_isset [#3]
k2y1: $ … ⇒ ⟨ K , S ⟩ ∈ trees ω $ by wcel_intro [#1, #2]
k2y2: $ G ⇒ isset ω $ by omega_set
k2y3: $ … ⇒ K ∈ ω ∧ S ∈ fseq (trees ω) $ by trees_node_c [k2y2, k2y1, k1, #4]
k2: $ … ⇒ S ∈ fseq (trees ω) $ by and_elim_r [k2y3]
d1: $ … ⇒ dt u M ⟨ K , S ⟩ w d = mclip u (ap (M' ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) $ by dt_atom [#3, k2, #5, #6]
d2: $ … ⇒ dt u M ⟨ K , S ⟩ w e = mclip u (ap (M' ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) $ by dt_atom [#3, k2, #5, #7]
d3q: $ G ⇒ d = d $ by eq_refl
d3: $ … ⇒ dt u M z w d = dt u M ⟨ K , S ⟩ w d $ by dt_eq [rr0, rr1, #1, rr2, d3q]
d4q: $ G ⇒ e = e $ by eq_refl
d4: $ … ⇒ dt u M z w e = dt u M ⟨ K , S ⟩ w e $ by dt_eq [rr0, rr1, #1, rr2, d4q]
ft1: $ … ⇒ dt u M z w d = mclip u (ap (M' ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) $ by eq_trans [d3, d1]
fs2: $ … ⇒ mclip u (ap (M' ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) = dt u M ⟨ K , S ⟩ w e $ by eq_sym [d2]
ft2: $ … ⇒ dt u M z w d = dt u M ⟨ K , S ⟩ w e $ by eq_trans [ft1, fs2]
fs3: $ … ⇒ dt u M ⟨ K , S ⟩ w e = dt u M z w e $ by eq_sym [d4]
ft3: $ … ⇒ dt u M z w d = dt u M z w e $ by eq_trans [ft2, fs3]

lemma p1_cs_app {i: set} (G: hyps i) (M: class) (u w z c f g d e: set): $ G ⇒ z = ⟨ kc_app , f +: g +: ∅ ⟩ $ > $ G ⇒ f ∊ p1_clp u M w $ > $ G ⇒ g ∊ p1_clp u M w $ > $ G ⇒ ra_closed c f ∈ lrel $ > $ G ⇒ ra_closed c g ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ nvf' c → d' i = e' i) $ > $ G ⇒ dt u M z w d = dt u M z w e $
----
rr0: $ G ⇒ u = u $ by eq_refl
rr1: $ G ⇒ M = M $ by eq_refl
rr2: $ G ⇒ w = w $ by eq_refl
k0a: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
k0: $ … ⇒ isset kr_closed $ by wcel_isset [k0a]
k1: $ … ⇒ c ∊ trees ω ∧ f ∊ trees ω $ by lrel_args2 [#4, k0]
k2a: $ … ⇒ f ∊ trees ω $ by and_elim_r [k1]
k2: $ … ⇒ f ∈ trees ω $ by welc_wcel [k2a]
k3: $ … ⇒ c ∊ trees ω ∧ g ∊ trees ω $ by lrel_args2 [#5, k0]
k4a: $ … ⇒ g ∊ trees ω $ by and_elim_r [k3]
k4: $ … ⇒ g ∈ trees ω $ by welc_wcel [k4a]
