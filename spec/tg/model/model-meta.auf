--| `cinst_den` with the encoded arguments named.
lemma f3_cd (H: hyps) {p t: set} (M: class) (k: nat) (G0 G1 G: ctx) (A0 a: expr) (u w r x1 x2 x3 x4 x5 x6: set):
  $ mdeq M G0 a a A0 $ > $ H ⇒ ra_cinst x1 x2 x3 x4 x5 x6 ∈ lrel $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ >
  $ H ⇒ r ∊ sat u M (enc_ctx G) w $ > $ H ⇒ x1 = enc_nat k $ > $ H ⇒ x2 = enc_ctx G0 $ > $ H ⇒ x3 = enc_expr A0 $ >
  $ H ⇒ x4 = enc_expr a $ > $ H ⇒ x5 = enc_ctx G1 $ > $ H ⇒ x6 = enc_ctx G $ > $ H ⇒ ∃ p ∃ t (p ∊ fseq u ∧ cdm p = nvf' (enc_nat k) ∧ t ∊ sat u M (enc_ctx G0) w ∧ r = p ++ t ∧ p ++ (dt u M (enc_expr a) w t +: t) ∈ sat u M (enc_ctx G1) w) $
