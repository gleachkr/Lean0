c8nr: $ G , t1 = x0 ∧ t2 = ⟨ kc_proj , a +: x1 +: e +: ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_proj , a +: x1 +: f +: ∅ ⟩ ∧ ra_inst x0 e x2 f ∈ lrel ⇒ ¬ R ∈ fseq u $ by weaken [#2]
c8tr: $ G , t1 = x0 ∧ t2 = ⟨ kc_proj , a +: x1 +: e +: ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_proj , a +: x1 +: f +: ∅ ⟩ ∧ ra_inst x0 e x2 f ∈ lrel ⇒ t4 ∊ trees ω $ by weaken [a3r2]
c8ks: $ G , t1 = x0 ∧ t2 = ⟨ kc_proj , a +: x1 +: e +: ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_proj , a +: x1 +: f +: ∅ ⟩ ∧ ra_inst x0 e x2 f ∈ lrel ⇒ kc_proj ∈ kstr $ by kstr_proj
