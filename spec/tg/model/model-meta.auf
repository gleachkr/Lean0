l17: $ G ⇒ functional nvf $ by nvf_functional
l18: $ … ⇒ isset (nvf' i) $ by fv_set [l17]
l19: $ … ⇒ nvf' i ∈ suc (nvf' i) $ by suc_mem [l18]
l20: $ … ⇒ nvf' i ∈ cdm p $ by wcel_subset [l16, l19]
l21y1: $ … ⇒ (p ++ s)' nvf' i = p' nvf' i $ by scat_fv_l_c [#2, #4, l20]
l21y2: $ … ⇒ (p ++ s2)' nvf' i = p' nvf' i $ by scat_fv_l_c [#2, #5, l20]
