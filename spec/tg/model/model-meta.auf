end: $ … ⇒ (n = x0 ∧ k = x1 ∧ z = ⟨ kc_pi , x9 +: b +: ∅ ⟩ ∧ e = ⟨ kc_pi , f +: g +: ∅ ⟩ ∧ ra_lift x0 x1 x9 f ∈ lrel ∧ ra_lift x0 ⟨ kc_s , x1 +: ∅ ⟩ b g ∈ lrel) → dt u M e w r = dt u M z w o $ by imp_intro [fin]

lemma p2_k_cl (H: hyps) (M: class) (u w n m s k z e a r o c j x0 x3 x1 h: set) {d: set}: $ H ⇒ w ∊ lvals $ > $ H ⇒ m ∊ fseq u $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ ∀ d (d ∊ ω → m' (nvf' n + d) = s' d) $ > $ H ⇒ crn j ⊆ p2_lp u M w n m s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel $ > $ H ⇒ a ∊ fseq u $ > $ H ⇒ cdm a = nvf' k $ > $ H ⇒ r = a ++ m $ > $ H ⇒ o = a ++ s $ > $ H ⇒ (n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel) → dt u M e w r = dt u M z w o $
----
f1: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ w ∊ lvals $ by weaken [#1]
f2: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ m ∊ fseq u $ by weaken [#2]
f3: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ s ∊ fseq u $ by weaken [#3]
f8: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ a ∊ fseq u $ by weaken [#8]
f9: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ cdm a = nvf' k $ by weaken [#9]
f10: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ r = a ++ m $ by weaken [#10]
f11: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ o = a ++ s $ by weaken [#11]
p0: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel $ by ax
