--| The case `inst_proj`.
lemma p3_c_proj (G: hyps) (M: class) (u w k a p s x0 s2 r1 r2 z e k0 j b i v y: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ x0 = dt u M a w s $ > $ G ⇒ x0 ∊ u $ > $ G ⇒ s2 = x0 +: s $ > $ G ⇒ s2 ∊ fseq u $ >
  $ G ⇒ r1 = p ++ s $ > $ G ⇒ r1 ∊ fseq u $ > $ G ⇒ r2 = p ++ s2 $ > $ G ⇒ r2 ∊ fseq u $ >
  $ G ⇒ crn j ⊆ p3_ip u M w $ > $ G ⇒ z = ⟨ k0 , j ⟩ $ >
  $ G ⇒ z ∊ trees ω $ > $ G ⇒ z = ⟨ kc_proj , b +: i +: v +: ∅ ⟩ $ >
  $ G ⇒ e = ⟨ kc_proj , b +: i +: y +: ∅ ⟩ $ >
  $ G ⇒ ra_inst k v a y ∈ lrel $ > $ G ⇒ dt u M e w r1 = dt u M z w r2 $
----
l1: $ G ⇒ kc_proj ∈ ω $ by kc_proj_omega
l2: $ … ⇒ isset kc_proj $ by wcel_isset [l1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ … ⇒ isset (v +: ∅) $ by scons_set [l3]
l5: $ … ⇒ isset (i +: v +: ∅) $ by scons_set [l4]
l6: $ … ⇒ isset (b +: i +: v +: ∅) $ by scons_set [l5]
