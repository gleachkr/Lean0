--| Every tree has the property: induction on the trees.
lemma f3_all (G: hyps) {v: set} (M: class) (u w g h e: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ v (v ∊ sat u M g w → dt u M e w v ∈ dt u M h w v ∧ dt u M e w v ∈ u) $ > $ G ⇒ trees ω ⊆ f3_cp u M w g h e $
----
