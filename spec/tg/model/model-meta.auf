a = d ∧ e = ⟨ kc_proj , o +: i +: x1 +: ∅ ⟩ ∧ ra_inst c y d x1 ∈ lrel) $ by ax
o1b: $ G , ∃ c ∃ d ∃ g (k = c ∧ z = ⟨ kc_bvar , c +: ∅ ⟩ ∧ a = d ∧ e = g ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ d g ∈ lrel) ∨ ∃ c ∃ i ∃ d (k = c ∧ z = ⟨ kc_bvar , ⟨ kc_s , i +: ∅ ⟩ +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_bvar , i +: ∅ ⟩ ∧ ra_le c i ∈ lrel) ∨ ∃ c ∃ l ∃ d (k = c ∧ z = ⟨ kc_srt , l +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_srt , l +: ∅ ⟩) ∨ ∃ c ∃ f ∃ x ∃ d ∃ h ∃ m (k = c ∧ z = ⟨ kc_app , f +: x +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_app , h +: m +: ∅ ⟩ ∧ ra_inst c f d h ∈ lrel ∧ ra_inst c x d m ∈ lrel) ∨ ∃ c ∃ n ∃ o ∃ d ∃ q ∃ t (k = c ∧ z = ⟨ kc_lam , n +: o +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_lam , q +: t +: ∅ ⟩ ∧ ra_inst c n d q ∈ lrel ∧ ra_inst ⟨ kc_s , c +: ∅ ⟩ o d t ∈ lrel) ∨ ∃ c ∃ n ∃ o ∃ d ∃ q ∃ t (k = c ∧ z = ⟨ kc_pi , n +: o +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_pi , q +: t +: ∅ ⟩ ∧ ra_inst c n d q ∈ lrel ∧ ra_inst ⟨ kc_s , c +: ∅ ⟩ o d t ∈ lrel) ∨ ∃ v ∃ c ∃ y ∃ d (k = c ∧ z = y ∧ a = d ∧ e = y ∧ ra_closed v y ∈ lrel ∧ ra_le v c ∈ lrel) ∨ ∃ c ∃ o ∃ i ∃ y ∃ d ∃ x1 (k = c ∧ z = ⟨ kc_proj , o +: i +: y +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_proj , o +: i +: x1 +: ∅ ⟩ ∧ ra_inst c y d x1 ∈ lrel) , ∃ c ∃ d ∃ g (k = c ∧ z = ⟨ kc_bvar , c +: ∅ ⟩ ∧ a = d ∧ e = g ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ d g ∈ lrel) ⇒ dt u M e w r1 = dt u M z w r2 $ by weaken [k2e0]
o1c: $ G , ∃ c ∃ d ∃ g (k = c ∧ z = ⟨ kc_bvar , c +: ∅ ⟩ ∧ a = d ∧ e = g ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ d g ∈ lrel) ∨ ∃ c ∃ i ∃ d (k = c ∧ z = ⟨ kc_bvar , ⟨ kc_s , i +: ∅ ⟩ +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_bvar , i +: ∅ ⟩ ∧ ra_le c i ∈ lrel) ∨ ∃ c ∃ l ∃ d (k = c ∧ z = ⟨ kc_srt , l +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_srt , l +: ∅ ⟩) ∨ ∃ c ∃ f ∃ x ∃ d ∃ h ∃ m (k = c ∧ z = ⟨ kc_app , f +: x +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_app , h +: m +: ∅ ⟩ ∧ ra_inst c f d h ∈ lrel ∧ ra_inst c x d m ∈ lrel) ∨ ∃ c ∃ n ∃ o ∃ d ∃ q ∃ t (k = c ∧ z = ⟨ kc_lam , n +: o +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_lam , q +: t +: ∅ ⟩ ∧ ra_inst c n d q ∈ lrel ∧ ra_inst ⟨ kc_s , c +: ∅ ⟩ o d t ∈ lrel) ∨ ∃ c ∃ n ∃ o ∃ d ∃ q ∃ t (k = c ∧ z = ⟨ kc_pi , n +: o +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_pi , q +: t +: ∅ ⟩ ∧ ra_inst c n d q ∈ lrel ∧ ra_inst ⟨ kc_s , c +: ∅ ⟩ o d t ∈ lrel) ∨ ∃ v ∃ c ∃ y ∃ d (k = c ∧ z = y ∧ a = d ∧ e = y ∧ ra_closed v y ∈ lrel ∧ ra_le v c ∈ lrel) ∨ ∃ c ∃ o ∃ i ∃ y ∃ d ∃ x1 (k = c ∧ z = ⟨ kc_proj , o +: i +: y +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_proj , o +: i +: x1 +: ∅ ⟩ ∧ ra_inst c y d x1 ∈ lrel) , ∃ c ∃ i ∃ d (k = c ∧ z = ⟨ kc_bvar , ⟨ kc_s , i +: ∅ ⟩ +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_bvar , i +: ∅ ⟩ ∧ ra_le c i ∈ lrel) ∨ ∃ c ∃ l ∃ d (k = c ∧ z = ⟨ kc_srt , l +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_srt , l +: ∅ ⟩) ∨ ∃ c ∃ f ∃ x ∃ d ∃ h ∃ m (k = c ∧ z = ⟨ kc_app , f +: x +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_app , h +: m +: ∅ ⟩ ∧ ra_inst c f d h ∈ lrel ∧ ra_inst c x d m ∈ lrel) ∨ ∃ c ∃ n ∃ o ∃ d ∃ q ∃ t (k = c ∧ z = ⟨ kc_lam , n +: o +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_lam , q +: t +: ∅ ⟩ ∧ ra_inst c n d q ∈ lrel ∧ ra_inst ⟨ kc_s , c +: ∅ ⟩ o d t ∈ lrel) ∨ ∃ c ∃ n ∃ o ∃ d ∃ q ∃ t (k = c ∧ z = ⟨ kc_pi , n +: o +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_pi , q +: t +: ∅ ⟩ ∧ ra_inst c n d q ∈ lrel ∧ ra_inst ⟨ kc_s , c +: ∅ ⟩ o d t ∈ lrel) ∨ ∃ v ∃ c ∃ y ∃ d (k = c ∧ z = y ∧ a = d ∧ e = y ∧ ra_closed v y ∈ lrel ∧ ra_le v c ∈ lrel) ∨ ∃ c ∃ o ∃ i ∃ y ∃ d ∃ x1 (k = c ∧ z = ⟨ kc_proj , o +: i +: y +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_proj , o +: i +: x1 +: ∅ ⟩ ∧ ra_inst c y d x1 ∈ lrel) ⇒ dt u M e w r1 = dt u M z w r2 $ by weaken [o2]
o1: $ … ⇒ dt u M e w r1 = dt u M z w r2 $ by or_elim [o1a, o1b, o1c]
c0: $ … ⇒ ∃ c ∃ i ∃ d (k = c ∧ z = ⟨ kc_bvar , i +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_bvar , i +: ∅ ⟩ ∧ ra_le ⟨ kc_s , i +: ∅ ⟩ c ∈ lrel) ∨ ∃ c ∃ d ∃ g (k = c ∧ z = ⟨ kc_bvar , c +: ∅ ⟩ ∧ a = d ∧ e = g ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ d g ∈ lrel) ∨ ∃ c ∃ i ∃ d (k = c ∧ z = ⟨ kc_bvar , ⟨ kc_s , i +: ∅ ⟩ +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_bvar , i +: ∅ ⟩ ∧ ra_le c i ∈ lrel) ∨ ∃ c ∃ l ∃ d (k = c ∧ z = ⟨ kc_srt , l +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_srt , l +: ∅ ⟩) ∨ ∃ c ∃ f ∃ x ∃ d ∃ h ∃ m (k = c ∧ z = ⟨ kc_app , f +: x +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_app , h +: m +: ∅ ⟩ ∧ ra_inst c f d h ∈ lrel ∧ ra_inst c x d m ∈ lrel) ∨ ∃ c ∃ n ∃ o ∃ d ∃ q ∃ t (k = c ∧ z = ⟨ kc_lam , n +: o +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_lam , q +: t +: ∅ ⟩ ∧ ra_inst c n d q ∈ lrel ∧ ra_inst ⟨ kc_s , c +: ∅ ⟩ o d t ∈ lrel) ∨ ∃ c ∃ n ∃ o ∃ d ∃ q ∃ t (k = c ∧ z = ⟨ kc_pi , n +: o +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_pi , q +: t +: ∅ ⟩ ∧ ra_inst c n d q ∈ lrel ∧ ra_inst ⟨ kc_s , c +: ∅ ⟩ o d t ∈ lrel) ∨ ∃ v ∃ c ∃ y ∃ d (k = c ∧ z = y ∧ a = d ∧ e = y ∧ ra_closed v y ∈ lrel ∧ ra_le v c ∈ lrel) ∨ ∃ c ∃ o ∃ i ∃ y ∃ d ∃ x1 (k = c ∧ z = ⟨ kc_proj , o +: i +: y +: ∅ ⟩ ∧ a = d ∧ e = ⟨ kc_proj , o +: i +: x1 +: ∅ ⟩ ∧ ra_inst c y d x1 ∈ lrel) $ by lrel_inst_cases [#4]
c1: $ … ⇒ dt u M e w r1 = dt u M z w r2 $ by or_elim [c0, k1e0, o1]

--| One node of the induction, with the valuations named.
lemma p3_node (G: hyps) (M: class) (u w k0 j z k a e p s: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ crn j ⊆ p3_ip u M w $ > $ G ⇒ z = ⟨ k0 , j ⟩ $ > $ G ⇒ ra_inst k z a e ∈ lrel $ >
  $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ dt u M a w s ∈ u $ >
  $ G ⇒ dt u M e w (p ++ s) = dt u M z w (p ++ (dt u M a w s +: s)) $
----
w1: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ w ∊ lvals $ by weaken [#1]
w2: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ crn j ⊆ p3_ip u M w $ by weaken [#2]
w3: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ z = ⟨ k0 , j ⟩ $ by weaken [#3]
w4: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ ra_inst k z a e ∈ lrel $ by weaken [#4]
w5: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ p ∊ fseq u $ by weaken [#5]
w6: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ cdm p = nvf' k $ by weaken [#6]
w7: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ s ∊ fseq u $ by weaken [#7]
h1: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ x0 = dt u M a w s $ by ax
h2: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ x0 ∊ u $ by ax
h3: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ x1 = x0 +: s $ by ax
h4: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ x1 ∊ fseq u $ by ax
h5: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ x2 = p ++ s $ by ax
h6: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ x2 ∊ fseq u $ by ax
h7: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ x3 = p ++ x1 $ by ax
h8: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ x3 ∊ fseq u $ by ax
h9: $ … ⇒ dt u M e w x2 = dt u M z w x3 $ by p3_step [w1, w2, w3, w4, w5, w6, w7, h1, h2, h3, h4, h5, h6, h7, h8]
i1: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ u = u $ by eq_refl
i2: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ M = M $ by eq_refl
i3: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ e = e $ by eq_refl
i3b: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ z = z $ by eq_refl
i4: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ w = w $ by eq_refl
i5: $ … ⇒ p ++ s = x2 $ by eq_sym [h5]
i6: $ … ⇒ dt u M e w (p ++ s) = dt u M e w x2 $ by dt_eq [i1, i2, i3, i4, i5]
i7: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ s = s $ by eq_refl
i8: $ … ⇒ x0 +: s = dt u M a w s +: s $ by scons_eq [h1, i7]
i9: $ … ⇒ x1 = dt u M a w s +: s $ by eq_trans [h3, i8]
i10: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u , x3 = p ++ x1 , x3 ∊ fseq u ⇒ p = p $ by eq_refl
i11: $ … ⇒ p ++ x1 = p ++ (dt u M a w s +: s) $ by scat_eq [i10, i9]
i12: $ … ⇒ x3 = p ++ (dt u M a w s +: s) $ by eq_trans [h7, i11]
i13: $ … ⇒ dt u M z w x3 = dt u M z w (p ++ (dt u M a w s +: s)) $ by dt_eq [i1, i2, i3b, i4, i12]
i14: $ … ⇒ dt u M e w (p ++ s) = dt u M z w x3 $ by eq_trans [i6, h9]
i15: $ … ⇒ dt u M e w (p ++ s) = dt u M z w (p ++ (dt u M a w s +: s)) $ by eq_trans [i14, i13]
j1a: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u ⇒ p ∊ fseq u $ by weaken [#5]
j1b: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u , x2 = p ++ s , x2 ∊ fseq u ⇒ x1 ∊ fseq u $ by ax
j1: $ … ⇒ p ++ x1 ∈ fseq u $ by scat_fseq [j1a, j1b]
j2: $ … ⇒ dt u M e w (p ++ s) = dt u M z w (p ++ (dt u M a w s +: s)) $ by wcel_elim [j1, i15]
j3a: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u ⇒ p ∊ fseq u $ by weaken [#5]
j3b: $ G , x0 = dt u M a w s , x0 ∊ u , x1 = x0 +: s , x1 ∊ fseq u ⇒ s ∊ fseq u $ by weaken [#7]
j3: $ … ⇒ p ++ s ∈ fseq u $ by scat_fseq [j3a, j3b]
j4: $ … ⇒ dt u M e w (p ++ s) = dt u M z w (p ++ (dt u M a w s +: s)) $ by wcel_elim [j3, j2]
j5a: $ G , x0 = dt u M a w s , x0 ∊ u ⇒ x0 ∊ u $ by ax
j5b: $ G , x0 = dt u M a w s , x0 ∊ u ⇒ s ∊ fseq u $ by weaken [#7]
j5: $ … ⇒ x0 +: s ∈ fseq u $ by scons_fseq [j5a, j5b]
j6: $ … ⇒ dt u M e w (p ++ s) = dt u M z w (p ++ (dt u M a w s +: s)) $ by wcel_elim [j5, j4]
j7: $ … ⇒ dt u M e w (p ++ s) = dt u M z w (p ++ (dt u M a w s +: s)) $ by wcel_elim [#8, j6]

--| Every tree has the property: induction on the trees.
lemma p3_all (G: hyps) (M: class) (u w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ trees ω ⊆ p3_ip u M w $
----
