b7b: $ G , p7 ∨ p8 , p8 ⇒ c $ by weaken [a8]
c7: $ … ⇒ c $ by or_elim [b7, b7a, b7b]
b6: $ G , p6 ∨ p7 ∨ p8 ⇒ p6 ∨ p7 ∨ p8 $ by ax
b6a: $ G , p6 ∨ p7 ∨ p8 , p6 ⇒ c $ by weaken [a6]
b6b: $ G , p6 ∨ p7 ∨ p8 , p7 ∨ p8 ⇒ c $ by weaken [c7]
c6: $ … ⇒ c $ by or_elim [b6, b6a, b6b]
b5: $ G , p5 ∨ p6 ∨ p7 ∨ p8 ⇒ p5 ∨ p6 ∨ p7 ∨ p8 $ by ax
b5a: $ G , p5 ∨ p6 ∨ p7 ∨ p8 , p5 ⇒ c $ by weaken [a5]
b5b: $ G , p5 ∨ p6 ∨ p7 ∨ p8 , p6 ∨ p7 ∨ p8 ⇒ c $ by weaken [c6]
c5: $ … ⇒ c $ by or_elim [b5, b5a, b5b]
b4: $ G , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 $ by ax
b4a: $ G , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p4 ⇒ c $ by weaken [a4]
b4b: $ G , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by weaken [c5]
c4: $ … ⇒ c $ by or_elim [b4, b4a, b4b]
b3: $ G , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 $ by ax
b3a: $ G , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p3 ⇒ c $ by weaken [a3]
b3b: $ G , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by weaken [c4]
c3: $ … ⇒ c $ by or_elim [b3, b3a, b3b]
b2: $ G , p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 $ by ax
b2a: $ G , p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p2 ⇒ c $ by weaken [a2]
b2b: $ G , p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by weaken [c3]
c2: $ … ⇒ c $ by or_elim [b2, b2a, b2b]
b1a: $ G , p1 ⇒ c $ by weaken [a1]
c1: $ … ⇒ c $ by or_elim [#1, b1a, c2]

--| A valuation named by a concatenation is one.
lemma p2_val (G: hyps) (u a t r: set): $ G ⇒ a ∊ fseq u $ > $ G ⇒ t ∊ fseq u $ > $ G ⇒ r = a ++ t $ > $ G ⇒ r ∊ fseq u $
----
l1: $ … ⇒ a ++ t ∈ fseq u $ by scat_fseq [#1, #2]
l2: $ … ⇒ a ++ t = r $ by eq_sym [#3]
l3: $ … ⇒ r ∈ fseq u $ by wcel_eq_l [l2, l1]
l4: $ … ⇒ r ∊ fseq u $ by wcel_welc [l3]

--| A variable below the prefix reads the prefix.
lemma p2_rd_l (G: hyps) (M: class) (u w a t r i: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ t ∊ fseq u $ > $ G ⇒ r = a ++ t $ > $ G ⇒ i ∈ trees ω $ > $ G ⇒ nvf' i ∈ cdm a $ > $ G ⇒ dt u M ⟨ kc_bvar , i +: ∅ ⟩ w r = a' nvf' i $
----
l1: $ … ⇒ r ∊ fseq u $ by p2_val [#2, #3, #4]
l2: $ … ⇒ dt u M ⟨ kc_bvar , i +: ∅ ⟩ w r = r' nvf' i $ by dt_bvar [#5, #1, l1]
l3: $ G ⇒ nvf' i = nvf' i $ by eq_refl
l4: $ … ⇒ r' nvf' i = (a ++ t)' nvf' i $ by fv_eq [#4, l3]
l5: $ … ⇒ (a ++ t)' nvf' i = a' nvf' i $ by scat_fv_l_c [#2, #3, #6]
l6: $ … ⇒ dt u M ⟨ kc_bvar , i +: ∅ ⟩ w r = (a ++ t)' nvf' i $ by eq_trans [l2, l4]
l7: $ … ⇒ dt u M ⟨ kc_bvar , i +: ∅ ⟩ w r = a' nvf' i $ by eq_trans [l6, l5]

--| The trees `x` whose derivable `lift n k x e` (for the fixed `n`) give `e`
--| at `a ++ Q` the value of `x` at `a ++ S`, for `a` of length `k`.
def p2_lp (U M W N Q S: class) (.x .k .e .a .r .o: set): class = $ {x | ∀ k ∀ e ∀ a ∀ r ∀ o (⟨ kr_lift , N +: k +: x +: e +: ∅ ⟩ ∈ lrel → a ∊ fseq U → cdm a = nvf' k → r = a ++ Q → o = a ++ S → dt U M e W r = dt U M x W o)} $

--| Using the induction hypothesis at class arguments.
lemma p2_ih_use (G: hyps) (M: class) (u w n m s t h f: set) (A R O: class): $ G ⇒ t ∈ p2_lp u M w n m s $ > $ G ⇒ ⟨ kr_lift , n +: h +: t +: f +: ∅ ⟩ ∈ lrel $ > $ G ⇒ A ∈ fseq u $ > $ G ⇒ cdm A = nvf' h $ > $ G ⇒ isset R $ > $ G ⇒ R = A ++ m $ > $ G ⇒ isset O $ > $ G ⇒ O = A ++ s $ > $ G ⇒ dt u M f w R = dt u M t w O $
----
i1: $ … ⇒ t ∊ p2_lp u M w n m s $ by wcel_welc [#1]
i2: $ … ⇒ ∀ k ∀ e ∀ a ∀ r ∀ o (⟨ kr_lift , n +: k +: t +: e +: ∅ ⟩ ∈ lrel → a ∊ fseq u → cdm a = nvf' k → r = a ++ m → o = a ++ s → dt u M e w r = dt u M t w o) $ by cab_elim [i1]
i3: $ … ⇒ ∀ e ∀ a ∀ r ∀ o (⟨ kr_lift , n +: h +: t +: e +: ∅ ⟩ ∈ lrel → a ∊ fseq u → cdm a = nvf' h → r = a ++ m → o = a ++ s → dt u M e w r = dt u M t w o) $ by all_elim [i2]
i4: $ … ⇒ ∀ a ∀ r ∀ o (⟨ kr_lift , n +: h +: t +: f +: ∅ ⟩ ∈ lrel → a ∊ fseq u → cdm a = nvf' h → r = a ++ m → o = a ++ s → dt u M f w r = dt u M t w o) $ by all_elim [i3]
j1: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ ∀ a ∀ r ∀ o (⟨ kr_lift , n +: h +: t +: f +: ∅ ⟩ ∈ lrel → a ∊ fseq u → cdm a = nvf' h → r = a ++ m → o = a ++ s → dt u M f w r = dt u M t w o) $ by weaken [i4]
j2: $ … ⇒ ∀ r ∀ o (⟨ kr_lift , n +: h +: t +: f +: ∅ ⟩ ∈ lrel → v ∊ fseq u → cdm v = nvf' h → r = v ++ m → o = v ++ s → dt u M f w r = dt u M t w o) $ by all_elim [j1]
j3: $ … ⇒ ∀ o (⟨ kr_lift , n +: h +: t +: f +: ∅ ⟩ ∈ lrel → v ∊ fseq u → cdm v = nvf' h → x0 = v ++ m → o = v ++ s → dt u M f w x0 = dt u M t w o) $ by all_elim [j2]
j4: $ … ⇒ ⟨ kr_lift , n +: h +: t +: f +: ∅ ⟩ ∈ lrel → v ∊ fseq u → cdm v = nvf' h → x0 = v ++ m → x1 = v ++ s → dt u M f w x0 = dt u M t w x1 $ by all_elim [j3]
j5: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ ⟨ kr_lift , n +: h +: t +: f +: ∅ ⟩ ∈ lrel $ by weaken [#2]
j6: $ … ⇒ v ∊ fseq u → cdm v = nvf' h → x0 = v ++ m → x1 = v ++ s → dt u M f w x0 = dt u M t w x1 $ by imp_elim [j4, j5]
j7: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ v ∊ fseq u $ by ax
j8: $ … ⇒ cdm v = nvf' h → x0 = v ++ m → x1 = v ++ s → dt u M f w x0 = dt u M t w x1 $ by imp_elim [j6, j7]
k1: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ v = A $ by ax
k2: $ … ⇒ cdm v = cdm A $ by cdm_eq [k1]
k3: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm A = nvf' h $ by weaken [#4]
k4: $ … ⇒ cdm v = nvf' h $ by eq_trans [k2, k3]
j9: $ … ⇒ x0 = v ++ m → x1 = v ++ s → dt u M f w x0 = dt u M t w x1 $ by imp_elim [j8, k4]
k5: $ … ⇒ A = v $ by eq_sym [k1]
k6: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ m = m $ by eq_refl
k7: $ … ⇒ A ++ m = v ++ m $ by scat_eq [k5, k6]
k8: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = R $ by ax
k9: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ R = A ++ m $ by weaken [#6]
k10: $ … ⇒ x0 = A ++ m $ by eq_trans [k8, k9]
k11: $ … ⇒ x0 = v ++ m $ by eq_trans [k10, k7]
j10: $ … ⇒ x1 = v ++ s → dt u M f w x0 = dt u M t w x1 $ by imp_elim [j9, k11]
k12: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ s = s $ by eq_refl
k13: $ … ⇒ A ++ s = v ++ s $ by scat_eq [k5, k12]
k14: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = O $ by ax
k15: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ O = A ++ s $ by weaken [#8]
k16: $ … ⇒ x1 = A ++ s $ by eq_trans [k14, k15]
k17: $ … ⇒ x1 = v ++ s $ by eq_trans [k16, k13]
j11: $ … ⇒ dt u M f w x0 = dt u M t w x1 $ by imp_elim [j10, k17]
m1: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ u = u $ by eq_refl
m2: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ M = M $ by eq_refl
m3: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ f = f $ by eq_refl
m4: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ w = w $ by eq_refl
m5: $ G , v = A , v ∊ fseq u , x0 = R , x1 = O ⇒ t = t $ by eq_refl
m6: $ … ⇒ R = x0 $ by eq_sym [k8]
m7: $ … ⇒ dt u M f w R = dt u M f w x0 $ by dt_eq [m1, m2, m3, m4, m6]
m8: $ … ⇒ dt u M t w x1 = dt u M t w O $ by dt_eq [m1, m2, m5, m4, k14]
m9: $ … ⇒ dt u M f w R = dt u M t w x1 $ by eq_trans [m7, j11]
m10: $ … ⇒ dt u M f w R = dt u M t w O $ by eq_trans [m9, m8]
n1: $ … ⇒ dt u M f w R = dt u M t w O $ by isset_elim [#7, m10]
n2: $ … ⇒ dt u M f w R = dt u M t w O $ by isset_elim [#5, n1]
n3: $ … ⇒ dt u M f w R = dt u M t w O $ by wcel_elim [#3, n2]

--| Closing a chain of four equations.
lemma p2_chain (G: hyps) (A B C D V: class): $ G ⇒ A = B $ > $ G ⇒ B = V $ > $ G ⇒ C = V $ > $ G ⇒ D = C $ > $ G ⇒ A = D $
----
l1: $ … ⇒ A = V $ by eq_trans [#1, #2]
l2: $ … ⇒ V = C $ by eq_sym [#3]
l3: $ … ⇒ A = C $ by eq_trans [l1, l2]
l4: $ … ⇒ C = D $ by eq_sym [#4]
l5: $ … ⇒ A = D $ by eq_trans [l3, l4]

--| A variable at or past the prefix: `p ++ m` at `k + (n + d)` and `p ++ s`
--| at `k + d` both read `s` at `d`.
lemma p2_bvge_core (G: hyps) (M: class) (u w n m s a r o i j: set) {d: set}: $ G ⇒ w ∊ lvals $ > $ G ⇒ m ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ ∀ d (d ∊ ω → m' (nvf' n + d) = s' d) $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ r = a ++ m $ > $ G ⇒ o = a ++ s $ > $ G ⇒ i ∈ trees ω $ > $ G ⇒ j ∈ trees ω $ > $ G ⇒ cdm a ⊆ nvf' i $ > $ G ⇒ nvf' j = nvf' i + nvf' n $ > $ G ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o $
----
a1: $ … ⇒ cdm a ∈ ω $ by fseq_len [#5]
a2: $ G ⇒ isset i $ by isset_var
a3: $ … ⇒ nvf' i ∈ ω $ by nvf_omega [a2]
b1: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω ⇒ x ∊ ω $ by ax
b2: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω ⇒ v ∊ ω $ by ax
b3: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω ⇒ x = cdm a $ by ax
b4: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω ⇒ v = nvf' i $ by ax
b5: $ … ⇒ cdm a = x $ by eq_sym [b3]
b6: $ … ⇒ nvf' i = v $ by eq_sym [b4]
b7: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω ⇒ cdm a ⊆ nvf' i $ by weaken [#10]
b8: $ … ⇒ x ⊆ nvf' i $ by subset_eq_l [b5, b7]
b9: $ … ⇒ x ⊆ v $ by subset_eq_r [b6, b8]
b10: $ … ⇒ ∃ y (y ∊ ω ∧ x + y = v) $ by nle_ex [b1, b2, b9]
c1: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ y ∊ ω ∧ x + y = v $ by ax
c2: $ … ⇒ y ∊ ω $ by and_elim_l [c1]
c3: $ … ⇒ x + y = v $ by and_elim_r [c1]
c4: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ y = y $ by eq_refl
c5: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ x = cdm a $ by ax
c6: $ … ⇒ x + y = cdm a + y $ by nadd_eq [c5, c4]
c7: $ … ⇒ cdm a + y = x + y $ by eq_sym [c6]
c8: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ v = nvf' i $ by ax
c9: $ … ⇒ x + y = nvf' i $ by eq_trans [c3, c8]
c10: $ … ⇒ cdm a + y = nvf' i $ by eq_trans [c7, c9]
c11: $ … ⇒ nvf' i = cdm a + y $ by eq_sym [c10]
d1: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ j ∈ trees ω $ by weaken [#9]
d2: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ i ∈ trees ω $ by weaken [#8]
d3: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ w ∊ lvals $ by weaken [#1]
d4: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ a ∊ fseq u $ by weaken [#5]
d5: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ m ∊ fseq u $ by weaken [#2]
d6: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ s ∊ fseq u $ by weaken [#3]
d7: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ r = a ++ m $ by weaken [#6]
d8: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ o = a ++ s $ by weaken [#7]
d9: $ … ⇒ r ∊ fseq u $ by p2_val [d4, d5, d7]
d10: $ … ⇒ o ∊ fseq u $ by p2_val [d4, d6, d8]
d11: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ cdm a ∈ ω $ by weaken [a1]
d12: $ … ⇒ y ∈ ω $ by welc_wcel [c2]
d13: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ isset n $ by isset_var
d14: $ … ⇒ nvf' n ∈ ω $ by nvf_omega [d13]
e1: $ … ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = r' nvf' j $ by dt_bvar [d1, d3, d9]
e2: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ nvf' j = nvf' i + nvf' n $ by weaken [#11]
e3: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ nvf' n = nvf' n $ by eq_refl
e4: $ … ⇒ nvf' i + nvf' n = cdm a + y + nvf' n $ by nadd_eq [c11, e3]
e5: $ … ⇒ cdm a + y + nvf' n = cdm a + (y + nvf' n) $ by nadd_assoc_c [d11, d12, d14]
e6: $ … ⇒ y + nvf' n = nvf' n + y $ by nadd_comm_c [d12, d14]
e7: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ cdm a = cdm a $ by eq_refl
e8: $ … ⇒ cdm a + (y + nvf' n) = cdm a + (nvf' n + y) $ by nadd_eq [e7, e6]
e9: $ … ⇒ nvf' j = cdm a + y + nvf' n $ by eq_trans [e2, e4]
e10: $ … ⇒ nvf' j = cdm a + (y + nvf' n) $ by eq_trans [e9, e5]
e11: $ … ⇒ nvf' j = cdm a + (nvf' n + y) $ by eq_trans [e10, e8]
e12: $ … ⇒ r' nvf' j = (a ++ m)' (cdm a + (nvf' n + y)) $ by fv_eq [d7, e11]
e13: $ … ⇒ nvf' n + y ∈ ω $ by nadd_omega_c [d14, d12]
e14: $ … ⇒ (a ++ m)' (cdm a + (nvf' n + y)) = m' (nvf' n + y) $ by scat_fv_r_c [d4, d5, e13]
e15: $ G , x = cdm a , x ∊ ω , v = nvf' i , v ∊ ω , y ∊ ω ∧ x + y = v ⇒ ∀ d (d ∊ ω → m' (nvf' n + d) = s' d) $ by weaken [#4]
e16: $ … ⇒ y ∊ ω → m' (nvf' n + y) = s' y $ by all_elim [e15]
e17: $ … ⇒ m' (nvf' n + y) = s' y $ by imp_elim [e16, c2]
e18: $ … ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = (a ++ m)' (cdm a + (nvf' n + y)) $ by eq_trans [e1, e12]
e19: $ … ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = m' (nvf' n + y) $ by eq_trans [e18, e14]
e20: $ … ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = s' y $ by eq_trans [e19, e17]
g1: $ … ⇒ dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o = o' nvf' i $ by dt_bvar [d2, d3, d10]
g2: $ … ⇒ o' nvf' i = (a ++ s)' (cdm a + y) $ by fv_eq [d8, c11]
g3: $ … ⇒ (a ++ s)' (cdm a + y) = s' y $ by scat_fv_r_c [d4, d6, d12]
g4: $ … ⇒ dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o = (a ++ s)' (cdm a + y) $ by eq_trans [g1, g2]
g5: $ … ⇒ dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o = s' y $ by eq_trans [g4, g3]
g6: $ … ⇒ s' y = dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o $ by eq_sym [g5]
g7: $ … ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o $ by eq_trans [e20, g6]
h1: $ … ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o $ by ex_elim [b10, g7]
h2: $ … ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o $ by wcel_elim [a3, h1]
h3: $ … ⇒ dt u M ⟨ kc_bvar , j +: ∅ ⟩ w r = dt u M ⟨ kc_bvar , i +: ∅ ⟩ w o $ by wcel_elim [a1, h2]

--| A binder's body: for `y ∊ u` the induction hypothesis at the prefix
--| `y :: a`; otherwise both sides are `∅`.
lemma p2_body (G: hyps) (M: class) (u w n m s k h a r o b g y: set): $ G ⇒ m ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ cdm a = nvf' k $ > $ G ⇒ r = a ++ m $ > $ G ⇒ o = a ++ s $ > $ G ⇒ b ∈ p2_lp u M w n m s $ > $ G ⇒ ⟨ kr_lift , n +: h +: b +: g +: ∅ ⟩ ∈ lrel $ > $ G ⇒ nvf' h = suc (nvf' k) $ > $ G ⇒ dt u M g w (y +: r) = dt u M b w (y +: o) $
----
e0: $ G ⇒ y ∊ u ∨ ¬ y ∊ u $ by excluded_middle
a1: $ G , y ∊ u ⇒ y ∊ u $ by ax
a2: $ G , y ∊ u ⇒ a ∊ fseq u $ by weaken [#3]
a2m: $ G , y ∊ u ⇒ m ∊ fseq u $ by weaken [#1]
a2s: $ G , y ∊ u ⇒ s ∊ fseq u $ by weaken [#2]
a3: $ … ⇒ y +: a ∈ fseq u $ by scons_fseq [a1, a2]
a4: $ … ⇒ cdm (y +: a) = suc (cdm a) $ by scons_len [a2]
a5a: $ G , y ∊ u ⇒ cdm a = nvf' k $ by weaken [#4]
a5: $ … ⇒ suc (cdm a) = suc (nvf' k) $ by suc_eq [a5a]
a6a: $ G , y ∊ u ⇒ nvf' h = suc (nvf' k) $ by weaken [#9]
a6: $ … ⇒ suc (nvf' k) = nvf' h $ by eq_sym [a6a]
a7a: $ … ⇒ cdm (y +: a) = suc (nvf' k) $ by eq_trans [a4, a5]
a7: $ … ⇒ cdm (y +: a) = nvf' h $ by eq_trans [a7a, a6]
a8a: $ G , y ∊ u ⇒ isset r $ by isset_var
a8: $ … ⇒ isset (y +: r) $ by scons_set [a8a]
a9: $ … ⇒ (y +: a) ++ m = y +: a ++ m $ by scat_scons [a2, a2m]
a10a: $ G , y ∊ u ⇒ y = y $ by eq_refl
a10b: $ G , y ∊ u ⇒ r = a ++ m $ by weaken [#5]
a10: $ … ⇒ y +: r = y +: a ++ m $ by scons_eq [a10a, a10b]
a11a: $ … ⇒ y +: a ++ m = (y +: a) ++ m $ by eq_sym [a9]
a11: $ … ⇒ y +: r = (y +: a) ++ m $ by eq_trans [a10, a11a]
a12a: $ G , y ∊ u ⇒ isset o $ by isset_var
a12: $ … ⇒ isset (y +: o) $ by scons_set [a12a]
a13: $ … ⇒ (y +: a) ++ s = y +: a ++ s $ by scat_scons [a2, a2s]
a14b: $ G , y ∊ u ⇒ o = a ++ s $ by weaken [#6]
a14: $ … ⇒ y +: o = y +: a ++ s $ by scons_eq [a10a, a14b]
a15a: $ … ⇒ y +: a ++ s = (y +: a) ++ s $ by eq_sym [a13]
a15: $ … ⇒ y +: o = (y +: a) ++ s $ by eq_trans [a14, a15a]
a16a: $ G , y ∊ u ⇒ b ∈ p2_lp u M w n m s $ by weaken [#7]
a16b: $ G , y ∊ u ⇒ ⟨ kr_lift , n +: h +: b +: g +: ∅ ⟩ ∈ lrel $ by weaken [#8]
a16: $ … ⇒ dt u M g w (y +: r) = dt u M b w (y +: o) $ by p2_ih_use [a16a, a16b, a3, a7, a8, a11, a12, a15]
b1: $ G , ¬ y ∊ u ⇒ ¬ y ∊ u $ by ax
b2y1: $ G , ¬ y ∊ u , y +: r ∈ fseq u ⇒ y +: r ∈ fseq u $ by ax
b2y2: $ … ⇒ y ∊ u $ by scons_fseq_hd [b2y1]
b2y3: $ G , ¬ y ∊ u , y +: r ∈ fseq u ⇒ ¬ y ∊ u $ by weaken [b1]
b2y4: $ … ⇒ ⊥ $ by not_elim [b2y3, b2y2]
b2: $ … ⇒ ¬ y +: r ∈ fseq u $ by not_intro [b2y4]
b3y1: $ G , ¬ y ∊ u , y +: o ∈ fseq u ⇒ y +: o ∈ fseq u $ by ax
b3y2: $ … ⇒ y ∊ u $ by scons_fseq_hd [b3y1]
b3y3: $ G , ¬ y ∊ u , y +: o ∈ fseq u ⇒ ¬ y ∊ u $ by weaken [b1]
b3y4: $ … ⇒ ⊥ $ by not_elim [b3y3, b3y2]
b3: $ … ⇒ ¬ y +: o ∈ fseq u $ by not_intro [b3y4]
b4a: $ G , ¬ y ∊ u ⇒ ⟨ kr_lift , n +: h +: b +: g +: ∅ ⟩ ∈ lrel $ by weaken [#8]
b4: $ … ⇒ dt u M g w (y +: r) = ∅ $ by lrel_lift_out_r [b4a, b2]
b5: $ … ⇒ dt u M b w (y +: o) = ∅ $ by lrel_lift_out_l [b4a, b3]
b6: $ … ⇒ ∅ = dt u M b w (y +: o) $ by eq_sym [b5]
b7: $ … ⇒ dt u M g w (y +: r) = dt u M b w (y +: o) $ by eq_trans [b4, b6]
c1: $ … ⇒ dt u M g w (y +: r) = dt u M b w (y +: o) $ by or_elim [e0, a16, b7]

lemma p2_k_bvlt (H: hyps) (M: class) (u w n m s k z e a r o c j x0 x1 x2: set) {d: set}: $ H ⇒ w ∊ lvals $ > $ H ⇒ m ∊ fseq u $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ ∀ d (d ∊ ω → m' (nvf' n + d) = s' d) $ > $ H ⇒ crn j ⊆ p2_lp u M w n m s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel $ > $ H ⇒ a ∊ fseq u $ > $ H ⇒ cdm a = nvf' k $ > $ H ⇒ r = a ++ m $ > $ H ⇒ o = a ++ s $ > $ H ⇒ (n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel) → dt u M e w r = dt u M z w o $
----
f1: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ w ∊ lvals $ by weaken [#1]
f2: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ m ∊ fseq u $ by weaken [#2]
f3: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ s ∊ fseq u $ by weaken [#3]
f7: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel $ by weaken [#7]
f8: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ a ∊ fseq u $ by weaken [#8]
f9: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ cdm a = nvf' k $ by weaken [#9]
f10: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ r = a ++ m $ by weaken [#10]
f11: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ o = a ++ s $ by weaken [#11]
p0: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel ⇒ n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel $ by ax
p1: $ … ⇒ k = x1 ∧ z = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ e = ⟨ kc_bvar , x2 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x2 +: ∅ ⟩ x1 ∈ lrel $ by and_elim_r [p0]
