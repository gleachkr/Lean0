t0y2: $ … ⇒ isset kr_inst $ by wcel_isset [t0y1]
t0y3: $ … ⇒ k ∊ trees ω ∧ m ∊ trees ω ∧ a ∊ trees ω ∧ o ∊ trees ω $ by lrel_args4 [#17, t0y2]
t0y4: $ … ⇒ k ∊ trees ω $ by and_elim_l [t0y3]
t0y5: $ … ⇒ m ∊ trees ω ∧ a ∊ trees ω ∧ o ∊ trees ω $ by and_elim_r [t0y3]
t0y6: $ … ⇒ m ∊ trees ω $ by and_elim_l [t0y5]
t0y7: $ … ⇒ a ∊ trees ω ∧ o ∊ trees ω $ by and_elim_r [t0y5]
t0y8: $ … ⇒ a ∊ trees ω $ by and_elim_l [t0y7]
t0y9: $ … ⇒ o ∊ trees ω $ by and_elim_r [t0y7]
t0y10: $ … ⇒ k ∈ trees ω $ by welc_wcel [t0y4]
t0y11: $ … ⇒ m ∈ trees ω $ by welc_wcel [t0y6]
t0y12: $ … ⇒ a ∈ trees ω $ by welc_wcel [t0y8]
t0y13: $ … ⇒ o ∈ trees ω $ by welc_wcel [t0y9]
t0y14: $ … ⇒ a ∈ trees ω ∧ o ∈ trees ω $ by and_intro [t0y12, t0y13]
t0y15: $ … ⇒ m ∈ trees ω ∧ a ∈ trees ω ∧ o ∈ trees ω $ by and_intro [t0y11, t0y14]
t0: $ … ⇒ k ∈ trees ω ∧ m ∈ trees ω ∧ a ∈ trees ω ∧ o ∈ trees ω $ by and_intro [t0y10, t0y15]
t1: $ … ⇒ k ∈ trees ω $ by and_elim_l [t0]
t2: $ … ⇒ m ∈ trees ω ∧ a ∈ trees ω ∧ o ∈ trees ω $ by and_elim_r [t0]
t3: $ … ⇒ m ∈ trees ω $ by and_elim_l [t2]
t4: $ … ⇒ a ∈ trees ω ∧ o ∈ trees ω $ by and_elim_r [t2]
t5: $ … ⇒ o ∈ trees ω $ by and_elim_r [t4]
i1: $ … ⇒ dt u M o w r1 = dt u M m w r2 $ by p3_ih_n [l8, #17, #2, #3, #4, #5, #6, #7, #9, #11]
v1: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ v = ⟨ kc_s , k +: ∅ ⟩ $ by ax
v2a: $ … ⇒ ⟨ kc_s , k +: ∅ ⟩ = v $ by eq_sym [v1]
v2b: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ n = n $ by eq_refl
v2c: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ a = a $ by eq_refl
v2d: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ q = q $ by eq_refl
v2: $ … ⇒ ra_inst ⟨ kc_s , k +: ∅ ⟩ n a q = ra_inst v n a q $ by ra_inst_eq [v2a, v2b, v2c, v2d]
v3a: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ ra_inst ⟨ kc_s , k +: ∅ ⟩ n a q ∈ lrel $ by weaken [#18]
v3: $ … ⇒ ra_inst v n a q ∈ lrel $ by wcel_eq_l [v2, v3a]
u0y1: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ kr_inst ∈ ω $ by kr_inst_omega
u0y2: $ … ⇒ isset kr_inst $ by wcel_isset [u0y1]
u0y3: $ … ⇒ v ∊ trees ω ∧ n ∊ trees ω ∧ a ∊ trees ω ∧ q ∊ trees ω $ by lrel_args4 [v3, u0y2]
u0y4: $ … ⇒ v ∊ trees ω $ by and_elim_l [u0y3]
u0y5: $ … ⇒ n ∊ trees ω ∧ a ∊ trees ω ∧ q ∊ trees ω $ by and_elim_r [u0y3]
