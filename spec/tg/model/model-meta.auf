yx7: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ s2 ∊ fseq u $ by weaken [#8]
yx8: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ r1 = p ++ s $ by weaken [#9]
yx9: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ r2 = p ++ s2 $ by weaken [#11]
yx10: $ G , v = ⟨ kc_s , k +: ∅ ⟩ ⇒ n ∈ p3_ip u M w $ by weaken [l11]
