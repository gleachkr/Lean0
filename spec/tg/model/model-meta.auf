f10: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_lam , x9 +: b +: ∅ ⟩ ∧ e = ⟨ kc_lam , f +: g +: ∅ ⟩ ∧ ra_lift x0 x1 x9 f ∈ lrel ∧ ra_lift x0 ⟨ kc_s , x1 +: ∅ ⟩ b g ∈ lrel ⇒ r = a ++ m $ by weaken [#10]
f11: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_lam , x9 +: b +: ∅ ⟩ ∧ e = ⟨ kc_lam , f +: g +: ∅ ⟩ ∧ ra_lift x0 x1 x9 f ∈ lrel ∧ ra_lift x0 ⟨ kc_s , x1 +: ∅ ⟩ b g ∈ lrel ⇒ o = a ++ s $ by weaken [#11]
