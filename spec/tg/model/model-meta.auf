--| The trees `x` such that every derivable `inst k x a e` has the
--| substitution property of `lrel_inst_sem` at `U`, `M`, `W`, for every prefix
--| `p` of length `k` and every valuation `s`.
def p3_ip (U M W: class) (.x .x5 .x6 .x7 .x8 .x9: set): class =
  $ {x | ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ kr_inst , x5 +: x +: x6 +: x7 +: ∅ ⟩ ∈ lrel →
      x8 ∊ fseq U → cdm x8 = nvf' x5 → x9 ∊ fseq U → dt U M x6 W x9 ∈ U →
      dt U M x7 W (x8 ++ x9) = dt U M x W (x8 ++ (dt U M x6 W x9 +: x9)))} $

--| A variable above the prefix: `p ++ s` at `|p| + d` and `p ++ (x0 :: s)` at
--| `|p| + d + 1` both read `s` at `d`.
lemma p3_gt_fv (G: hyps) (U: class) (p s x0 s2 r1 r2 d: set):
  $ G ⇒ p ∊ fseq U $ > $ G ⇒ s ∊ fseq U $ > $ G ⇒ s2 = x0 +: s $ > $ G ⇒ s2 ∊ fseq U $ >
  $ G ⇒ r1 = p ++ s $ > $ G ⇒ r2 = p ++ s2 $ > $ G ⇒ d ∊ ω $ >
  $ G ⇒ r1' (cdm p + d) = r2' (suc (cdm p + d)) $
----
q1y1: $ … ⇒ d ∈ ω $ by welc_wcel [#7]
q1: $ … ⇒ (p ++ s)' (cdm p + d) = s' d $ by scat_fv_r_c [#1, #2, q1y1]
q2a: $ G ⇒ cdm p + d = cdm p + d $ by eq_refl
q2: $ … ⇒ r1' (cdm p + d) = (p ++ s)' (cdm p + d) $ by fv_eq [#5, q2a]
q3: $ … ⇒ cdm p ∈ ω $ by fseq_len [#1]
q3b: $ … ⇒ isset (cdm p) $ by wcel_isset [q3]
q4a: $ … ⇒ d ∈ ω $ by welc_wcel [#7]
q4: $ … ⇒ cdm p + suc d = suc (cdm p + d) $ by nadd_suc_c [q3b, q4a]
q5: $ … ⇒ suc d ∈ ω $ by omega_suc [#7]
q6: $ … ⇒ (p ++ s2)' (cdm p + suc d) = s2' (suc d) $ by scat_fv_r_c [#1, #4, q5]
q7a: $ … ⇒ suc (cdm p + d) = cdm p + suc d $ by eq_sym [q4]
q7: $ … ⇒ r2' (suc (cdm p + d)) = (p ++ s2)' (cdm p + suc d) $ by fv_eq [#6, q7a]
q8a: $ G ⇒ suc d = suc d $ by eq_refl
q8: $ … ⇒ s2' (suc d) = (x0 +: s)' (suc d) $ by fv_eq [#3, q8a]
q9: $ G ⇒ (x0 +: s)' (suc d) = s' d $ by scons_fv_suc
t1: $ … ⇒ r1' (cdm p + d) = s' d $ by eq_trans [q2, q1]
t2: $ … ⇒ r2' (suc (cdm p + d)) = s2' (suc d) $ by eq_trans [q7, q6]
t3: $ … ⇒ r2' (suc (cdm p + d)) = (x0 +: s)' (suc d) $ by eq_trans [t2, q8]
t4: $ … ⇒ r2' (suc (cdm p + d)) = s' d $ by eq_trans [t3, q9]
t5: $ … ⇒ s' d = r2' (suc (cdm p + d)) $ by eq_sym [t4]
t6: $ … ⇒ r1' (cdm p + d) = r2' (suc (cdm p + d)) $ by eq_trans [t1, t5]

--| The induction hypothesis at a child `y`.
lemma p3_ih (G: hyps) (M: class) (u w y k a e p s: set):
  $ G ⇒ y ∈ p3_ip u M w $ > $ G ⇒ ra_inst k y a e ∈ lrel $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ >
  $ G ⇒ s ∊ fseq u $ > $ G ⇒ dt u M a w s ∈ u $ >
  $ G ⇒ dt u M e w (p ++ s) = dt u M y w (p ++ (dt u M a w s +: s)) $
----
l1: $ … ⇒ y ∊ p3_ip u M w $ by wcel_welc [#1]
l2: $ … ⇒ ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ kr_inst , x5 +: y +: x6 +: x7 +: ∅ ⟩ ∈ lrel → x8 ∊ fseq u → cdm x8 = nvf' x5 → x9 ∊ fseq u → dt u M x6 w x9 ∈ u → dt u M x7 w (x8 ++ x9) = dt u M y w (x8 ++ (dt u M x6 w x9 +: x9))) $ by cab_elim [l1]
l3: $ … ⇒ ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ kr_inst , k +: y +: x6 +: x7 +: ∅ ⟩ ∈ lrel → x8 ∊ fseq u → cdm x8 = nvf' k → x9 ∊ fseq u → dt u M x6 w x9 ∈ u → dt u M x7 w (x8 ++ x9) = dt u M y w (x8 ++ (dt u M x6 w x9 +: x9))) $ by all_elim [l2]
l4: $ … ⇒ ∀ x7 ∀ x8 ∀ x9 (⟨ kr_inst , k +: y +: a +: x7 +: ∅ ⟩ ∈ lrel → x8 ∊ fseq u → cdm x8 = nvf' k → x9 ∊ fseq u → dt u M a w x9 ∈ u → dt u M x7 w (x8 ++ x9) = dt u M y w (x8 ++ (dt u M a w x9 +: x9))) $ by all_elim [l3]
l5: $ … ⇒ ∀ x8 ∀ x9 (⟨ kr_inst , k +: y +: a +: e +: ∅ ⟩ ∈ lrel → x8 ∊ fseq u → cdm x8 = nvf' k → x9 ∊ fseq u → dt u M a w x9 ∈ u → dt u M e w (x8 ++ x9) = dt u M y w (x8 ++ (dt u M a w x9 +: x9))) $ by all_elim [l4]
l6: $ … ⇒ ∀ x9 (⟨ kr_inst , k +: y +: a +: e +: ∅ ⟩ ∈ lrel → p ∊ fseq u → cdm p = nvf' k → x9 ∊ fseq u → dt u M a w x9 ∈ u → dt u M e w (p ++ x9) = dt u M y w (p ++ (dt u M a w x9 +: x9))) $ by all_elim [l5]
l7: $ … ⇒ ⟨ kr_inst , k +: y +: a +: e +: ∅ ⟩ ∈ lrel → p ∊ fseq u → cdm p = nvf' k → s ∊ fseq u → dt u M a w s ∈ u → dt u M e w (p ++ s) = dt u M y w (p ++ (dt u M a w s +: s)) $ by all_elim [l6]
l8: $ … ⇒ p ∊ fseq u → cdm p = nvf' k → s ∊ fseq u → dt u M a w s ∈ u → dt u M e w (p ++ s) = dt u M y w (p ++ (dt u M a w s +: s)) $ by imp_elim [l7, #2]
l9: $ … ⇒ cdm p = nvf' k → s ∊ fseq u → dt u M a w s ∈ u → dt u M e w (p ++ s) = dt u M y w (p ++ (dt u M a w s +: s)) $ by imp_elim [l8, #3]
l10: $ … ⇒ s ∊ fseq u → dt u M a w s ∈ u → dt u M e w (p ++ s) = dt u M y w (p ++ (dt u M a w s +: s)) $ by imp_elim [l9, #4]
l11: $ … ⇒ dt u M a w s ∈ u → dt u M e w (p ++ s) = dt u M y w (p ++ (dt u M a w s +: s)) $ by imp_elim [l10, #5]
l12: $ … ⇒ dt u M e w (p ++ s) = dt u M y w (p ++ (dt u M a w s +: s)) $ by imp_elim [l11, #6]

--| The induction hypothesis with the valuations named.
lemma p3_ih_n (G: hyps) (M R1 R2: class) (u w y k a e p s x0 s2: set):
  $ G ⇒ y ∈ p3_ip u M w $ > $ G ⇒ ra_inst k y a e ∈ lrel $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ >
  $ G ⇒ s ∊ fseq u $ > $ G ⇒ x0 = dt u M a w s $ > $ G ⇒ x0 ∊ u $ > $ G ⇒ s2 = x0 +: s $ >
  $ G ⇒ R1 = p ++ s $ > $ G ⇒ R2 = p ++ s2 $ > $ G ⇒ dt u M e w R1 = dt u M y w R2 $
----
l1: $ … ⇒ dt u M a w s ∈ u $ by wcel_intro [#6, #7]
l2: $ … ⇒ dt u M e w (p ++ s) = dt u M y w (p ++ (dt u M a w s +: s)) $ by p3_ih [#1, #2, #3, #4, #5, l1]
