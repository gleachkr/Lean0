--| A binder's body: at `x :: r1` and `x :: r2`, by the induction hypothesis at
--| the prefix `x :: p` when `x ∊ u`, and both `∅` otherwise.
lemma p3_body (G: hyps) (M: class) (u w k k1 a p s x0 s2 r1 r2 n q x: set):
  $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ x0 = dt u M a w s $ >
  $ G ⇒ x0 ∊ u $ > $ G ⇒ s2 = x0 +: s $ > $ G ⇒ s2 ∊ fseq u $ > $ G ⇒ r1 = p ++ s $ > $ G ⇒ r2 = p ++ s2 $ >
  $ G ⇒ n ∈ p3_ip u M w $ > $ G ⇒ k1 = ⟨ kc_s , k +: ∅ ⟩ $ > $ G ⇒ k ∈ trees ω $ >
  $ G ⇒ ra_inst k1 n a q ∈ lrel $ > $ G ⇒ dt u M q w (x +: r1) = dt u M n w (x +: r2) $
----
w1: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ p ∊ fseq u $ by weaken [#1]
w2: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ cdm p = nvf' k $ by weaken [#2]
w3: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ s ∊ fseq u $ by weaken [#3]
w4: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ x0 = dt u M a w s $ by weaken [#4]
w5: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ x0 ∊ u $ by weaken [#5]
w6: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ s2 = x0 +: s $ by weaken [#6]
w7: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ s2 ∊ fseq u $ by weaken [#7]
w8: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ r1 = p ++ s $ by weaken [#8]
w9: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ r2 = p ++ s2 $ by weaken [#9]
w10: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ n ∈ p3_ip u M w $ by weaken [#10]
w11: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ k1 = ⟨ kc_s , k +: ∅ ⟩ $ by weaken [#11]
w12: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ k ∈ trees ω $ by weaken [#12]
w13: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ ra_inst k1 n a q ∈ lrel $ by weaken [#13]
b0: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ y ∊ fseq u $ by ax
b0a: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ y = x +: p $ by ax
b1: $ … ⇒ cdm y = cdm (x +: p) $ by cdm_eq [b0a]
b2: $ … ⇒ cdm (x +: p) = suc (cdm p) $ by scons_len [w1]
b3: $ … ⇒ suc (cdm p) = suc (nvf' k) $ by suc_eq [w2]
b4: $ … ⇒ nvf' ⟨ kc_s , k +: ∅ ⟩ = suc (nvf' k) $ by nvf_s [w12]
b5a: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ nvf = nvf $ by eq_refl
b5: $ … ⇒ nvf' k1 = nvf' ⟨ kc_s , k +: ∅ ⟩ $ by fv_eq [b5a, w11]
b6: $ … ⇒ cdm y = suc (cdm p) $ by eq_trans [b1, b2]
b7: $ … ⇒ cdm y = suc (nvf' k) $ by eq_trans [b6, b3]
b8: $ … ⇒ suc (nvf' k) = nvf' ⟨ kc_s , k +: ∅ ⟩ $ by eq_sym [b4]
b9: $ … ⇒ cdm y = nvf' ⟨ kc_s , k +: ∅ ⟩ $ by eq_trans [b7, b8]
b10: $ … ⇒ nvf' ⟨ kc_s , k +: ∅ ⟩ = nvf' k1 $ by eq_sym [b5]
b11: $ … ⇒ cdm y = nvf' k1 $ by eq_trans [b9, b10]
c0: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ s = s $ by eq_refl
c1: $ … ⇒ y ++ s = (x +: p) ++ s $ by scat_eq [b0a, c0]
c2: $ … ⇒ (x +: p) ++ s = x +: p ++ s $ by scat_scons [w1, w3]
c3a: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ x = x $ by eq_refl
c3: $ … ⇒ x +: r1 = x +: p ++ s $ by scons_eq [c3a, w8]
c4a: $ … ⇒ y ++ s = x +: p ++ s $ by eq_trans [c1, c2]
c4: $ … ⇒ x +: p ++ s = y ++ s $ by eq_sym [c4a]
c5: $ … ⇒ x +: r1 = y ++ s $ by eq_trans [c3, c4]
c6a: $ G , x ∊ u , y = x +: p , y ∊ fseq u ⇒ s2 = s2 $ by eq_refl
c6: $ … ⇒ y ++ s2 = (x +: p) ++ s2 $ by scat_eq [b0a, c6a]
c7: $ … ⇒ (x +: p) ++ s2 = x +: p ++ s2 $ by scat_scons [w1, w7]
c8: $ … ⇒ x +: r2 = x +: p ++ s2 $ by scons_eq [c3a, w9]
c9a: $ … ⇒ y ++ s2 = x +: p ++ s2 $ by eq_trans [c6, c7]
c9: $ … ⇒ x +: p ++ s2 = y ++ s2 $ by eq_sym [c9a]
c10: $ … ⇒ x +: r2 = y ++ s2 $ by eq_trans [c8, c9]
c11: $ … ⇒ dt u M q w (x +: r1) = dt u M n w (x +: r2) $ by p3_ih_n [w10, w13, b0, b11, w3, w4, w5, w6, c5, c10]
a1: $ G , x ∊ u ⇒ x ∊ u $ by ax
a2: $ G , x ∊ u ⇒ p ∊ fseq u $ by weaken [#1]
a3: $ … ⇒ x +: p ∈ fseq u $ by scons_fseq [a1, a2]
a4: $ … ⇒ dt u M q w (x +: r1) = dt u M n w (x +: r2) $ by wcel_elim [a3, c11]
e1: $ G , ¬ x ∊ u ⇒ ¬ x ∊ u $ by ax
e2y1: $ G , ¬ x ∊ u , x +: r1 ∈ fseq u ⇒ x +: r1 ∈ fseq u $ by ax
e2y2: $ … ⇒ x ∊ u $ by scons_fseq_hd [e2y1]
e2y3: $ G , ¬ x ∊ u , x +: r1 ∈ fseq u ⇒ ¬ x ∊ u $ by weaken [e1]
e2y4: $ … ⇒ ⊥ $ by not_elim [e2y3, e2y2]
e2: $ … ⇒ ¬ x +: r1 ∈ fseq u $ by not_intro [e2y4]
e3y1: $ G , ¬ x ∊ u , x +: r2 ∈ fseq u ⇒ x +: r2 ∈ fseq u $ by ax
e3y2: $ … ⇒ x ∊ u $ by scons_fseq_hd [e3y1]
e3y3: $ G , ¬ x ∊ u , x +: r2 ∈ fseq u ⇒ ¬ x ∊ u $ by weaken [e1]
e3y4: $ … ⇒ ⊥ $ by not_elim [e3y3, e3y2]
e3: $ … ⇒ ¬ x +: r2 ∈ fseq u $ by not_intro [e3y4]
e4: $ G , ¬ x ∊ u ⇒ ra_inst k1 n a q ∈ lrel $ by weaken [#13]
e5: $ … ⇒ dt u M q w (x +: r1) = ∅ $ by lrel_inst_out_r [e4, e2]
e6: $ … ⇒ dt u M n w (x +: r2) = ∅ $ by lrel_inst_out_l [e4, e3]
e7: $ … ⇒ ∅ = dt u M n w (x +: r2) $ by eq_sym [e6]
e8: $ … ⇒ dt u M q w (x +: r1) = dt u M n w (x +: r2) $ by eq_trans [e5, e7]
f1: $ G ⇒ x ∊ u ∨ ¬ x ∊ u $ by excluded_middle
f2: $ … ⇒ dt u M q w (x +: r1) = dt u M n w (x +: r2) $ by or_elim [f1, a4, e8]

--| The case `inst_lam`: the domain by the induction hypothesis, the body at
--| the prefix extended by the bound variable (`p3_body`).
lemma p3_c_lam (G: hyps) (M: class) (u w k a p s x0 s2 r1 r2 z e k0 j m n o q: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ x0 = dt u M a w s $ > $ G ⇒ x0 ∊ u $ > $ G ⇒ s2 = x0 +: s $ > $ G ⇒ s2 ∊ fseq u $ >
  $ G ⇒ r1 = p ++ s $ > $ G ⇒ r1 ∊ fseq u $ > $ G ⇒ r2 = p ++ s2 $ > $ G ⇒ r2 ∊ fseq u $ >
  $ G ⇒ crn j ⊆ p3_ip u M w $ > $ G ⇒ z = ⟨ k0 , j ⟩ $ >
  $ G ⇒ z = ⟨ kc_lam , m +: n +: ∅ ⟩ $ > $ G ⇒ e = ⟨ kc_lam , o +: q +: ∅ ⟩ $ >
  $ G ⇒ ra_inst k m a o ∈ lrel $ > $ G ⇒ ra_inst ⟨ kc_s , k +: ∅ ⟩ n a q ∈ lrel $ >
  $ G ⇒ dt u M e w r1 = dt u M z w r2 $
----
l1: $ G ⇒ kc_lam ∈ ω $ by kc_lam_omega
l2: $ … ⇒ isset kc_lam $ by wcel_isset [l1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ … ⇒ isset (n +: ∅) $ by scons_set [l3]
l5: $ … ⇒ isset (m +: n +: ∅) $ by scons_set [l4]
l6: $ … ⇒ crn (m +: n +: ∅) ⊆ p3_ip u M w $ by p1_ch [#13, #14, #15, l2, l5]
l7: $ G ⇒ isset m $ by isset_var
l8: $ … ⇒ m ∈ p3_ip u M w $ by crn_scons_head [l7, l6]
l9: $ … ⇒ crn (n +: ∅) ⊆ p3_ip u M w $ by crn_scons_tail [l6]
l10: $ G ⇒ isset n $ by isset_var
l11: $ … ⇒ n ∈ p3_ip u M w $ by crn_scons_head [l10, l9]
