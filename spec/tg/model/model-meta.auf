--| The induction: every tree is in `p2_lp`.
lemma p2_lift_ind (G: hyps) (M: class) (u w n m s: set) {d: set}: $ G ⇒ w ∊ lvals $ > $ G ⇒ m ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ ∀ d (d ∊ ω → m' (nvf' n + d) = s' d) $ > $ G ⇒ trees ω ⊆ p2_lp u M w n m s $
----
g1: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ w ∊ lvals $ by weaken [#1]
g2: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ m ∊ fseq u $ by weaken [#2]
g3: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ s ∊ fseq u $ by weaken [#3]
g4: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ ∀ d (d ∊ ω → m' (nvf' n + d) = s' d) $ by weaken [#4]
g5: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ crn j ⊆ p2_lp u M w n m s $ by ax
g6: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ z = ⟨ c , j ⟩ $ by ax
g7: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel $ by ax
g8: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ a ∊ fseq u $ by ax
g9: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ cdm a = nvf' k $ by ax
g10: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ r = a ++ m $ by ax
g11: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ p2_lp u M w n m s , z = ⟨ c , j ⟩ , ⟨ kr_lift , n +: k +: z +: e +: ∅ ⟩ ∈ lrel , a ∊ fseq u , cdm a = nvf' k , r = a ++ m , o = a ++ s ⇒ o = a ++ s $ by ax
