--| The case `inst_bvar_eq`: the right side reads the value `x0` of `a`, the left
--| is `a` lifted by `k`, which is `a` at `s` by `lrel_lift_sem`.
lemma p3_c_beq (G: hyps) (M: class) (u w k a p s x0 s2 r1 r2 z e d: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ x0 = dt u M a w s $ > $ G ⇒ s2 = x0 +: s $ > $ G ⇒ s2 ∊ fseq u $ >
  $ G ⇒ r1 = p ++ s $ > $ G ⇒ r1 ∊ fseq u $ > $ G ⇒ r2 = p ++ s2 $ > $ G ⇒ r2 ∊ fseq u $ > $ G ⇒ z ∊ trees ω $ >
  $ G ⇒ z = ⟨ kc_bvar , k +: ∅ ⟩ $ > $ G ⇒ e = d $ > $ G ⇒ ra_lift k ⟨ kc_nz , ∅ ⟩ a d ∈ lrel $ >
  $ G ⇒ dt u M e w r1 = dt u M z w r2 $
----
l1: $ … ⇒ z ∈ trees ω $ by welc_wcel [#12]
l2: $ … ⇒ ⟨ kc_bvar , k +: ∅ ⟩ ∈ trees ω $ by wcel_eq_l [#13, l1]
ca: $ G ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
cb: $ … ⇒ isset kc_bvar $ by wcel_isset [ca]
cc: $ G ⇒ isset ∅ $ by ax_empty
cd: $ … ⇒ isset (k +: ∅) $ by scons_set [cc]
cey1: $ G ⇒ isset ω $ by omega_set
cey2: $ … ⇒ kc_bvar ∈ ω ∧ k +: ∅ ∈ fseq (trees ω) $ by trees_node_c [cey1, l2, cb, cd]
cey3: $ … ⇒ k +: ∅ ∈ fseq (trees ω) $ by and_elim_r [cey2]
ce: $ … ⇒ crn (k +: ∅) ⊆ trees ω $ by fseq_crn_c [cey3]
cf: $ G ⇒ isset k $ by isset_var
cg: $ … ⇒ k ∈ trees ω $ by crn_scons_head [cf, ce]
l10: $ … ⇒ dt u M ⟨ kc_bvar , k +: ∅ ⟩ w r2 = r2' nvf' k $ by dt_bvar [cg, #1, #11]
l11: $ … ⇒ cdm p ∈ ω $ by fseq_len [#2]
l12: $ … ⇒ isset (cdm p) $ by wcel_isset [l11]
l13: $ … ⇒ cdm p + ∅ = cdm p $ by nadd_zero_c [l12]
l14a: $ … ⇒ nvf' k = cdm p $ by eq_sym [#3]
l14b: $ … ⇒ cdm p = cdm p + ∅ $ by eq_sym [l13]
l14: $ … ⇒ nvf' k = cdm p + ∅ $ by eq_trans [l14a, l14b]
l15: $ … ⇒ r2' nvf' k = (p ++ s2)' (cdm p + ∅) $ by fv_eq [#10, l14]
l16: $ G ⇒ ∅ ∈ ω $ by omega_zero
l17: $ … ⇒ (p ++ s2)' (cdm p + ∅) = s2' ∅ $ by scat_fv_r_c [#2, #7, l16]
l18a: $ G ⇒ ∅ = ∅ $ by eq_refl
l18: $ … ⇒ s2' ∅ = (x0 +: s)' ∅ $ by fv_eq [#6, l18a]
l19: $ G ⇒ (x0 +: s)' ∅ = x0 $ by scons_fv_zero
l20a: $ … ⇒ r2' nvf' k = s2' ∅ $ by eq_trans [l15, l17]
l20b: $ … ⇒ r2' nvf' k = (x0 +: s)' ∅ $ by eq_trans [l20a, l18]
