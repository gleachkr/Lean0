o16: $ G , c = cdm p , c ∊ ω , n = nvf' i , n ∊ ω , d ∊ ω ∧ c + d = n ⇒ r2 = r2 $ by eq_refl
o17: $ … ⇒ r2' (suc (nvf' i)) = r2' (suc (cdm p + d)) $ by fv_eq [o16, o15]
