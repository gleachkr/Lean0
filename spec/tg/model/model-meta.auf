--| The case `inst_closed`: the two valuations agree below `j ≤ k`.
lemma p3_c_cl (G: hyps) (M: class) (u w k p s s2 r1 r2 z e v t: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ s2 ∊ fseq u $ >
  $ G ⇒ r1 = p ++ s $ > $ G ⇒ r1 ∊ fseq u $ > $ G ⇒ r2 = p ++ s2 $ > $ G ⇒ r2 ∊ fseq u $ >
  $ G ⇒ z = v $ > $ G ⇒ e = v $ > $ G ⇒ ra_closed t v ∈ lrel $ > $ G ⇒ ra_le t k ∈ lrel $ >
  $ G ⇒ dt u M e w r1 = dt u M z w r2 $
----
a1: $ … ⇒ nvf' t ⊆ nvf' k $ by lrel_le_sem [#13]
a2: $ … ⇒ nvf' k = cdm p $ by eq_sym [#3]
a3: $ … ⇒ nvf' t ⊆ cdm p $ by subset_eq_r [a2, a1]
a4a: $ G , i ∊ nvf' t ⇒ nvf' t ⊆ cdm p $ by weaken [a3]
a4b: $ G , i ∊ nvf' t ⇒ i ∊ nvf' t $ by ax
a4: $ … ⇒ i ∊ cdm p $ by subset_elim [a4a, a4b]
a5: $ … ⇒ i ∈ cdm p $ by welc_wcel [a4]
a6a: $ G , i ∊ nvf' t ⇒ p ∊ fseq u $ by weaken [#2]
a6b: $ G , i ∊ nvf' t ⇒ s ∊ fseq u $ by weaken [#4]
a6c: $ G , i ∊ nvf' t ⇒ s2 ∊ fseq u $ by weaken [#5]
a6d: $ G , i ∊ nvf' t ⇒ r1 = p ++ s $ by weaken [#6]
a6e: $ G , i ∊ nvf' t ⇒ r2 = p ++ s2 $ by weaken [#8]
a6y1: $ … ⇒ (p ++ s)' i = p' i $ by scat_fv_l_c [a6a, a6b, a5]
a6y2: $ … ⇒ (p ++ s2)' i = p' i $ by scat_fv_l_c [a6a, a6c, a5]
a6y3: $ G , i ∊ nvf' t ⇒ i = i $ by eq_refl
a6y4: $ … ⇒ r1' i = (p ++ s)' i $ by fv_eq [a6d, a6y3]
a6y5: $ … ⇒ r2' i = (p ++ s2)' i $ by fv_eq [a6e, a6y3]
a6y6: $ … ⇒ r1' i = p' i $ by eq_trans [a6y4, a6y1]
a6y7: $ … ⇒ r2' i = p' i $ by eq_trans [a6y5, a6y2]
a6y8: $ … ⇒ p' i = r2' i $ by eq_sym [a6y7]
a6: $ … ⇒ r1' i = r2' i $ by eq_trans [a6y6, a6y8]
a7: $ … ⇒ i ∊ nvf' t → r1' i = r2' i $ by imp_intro [a6]
a8: $ … ⇒ ∀ i (i ∊ nvf' t → r1' i = r2' i) $ by all_intro [a7]
a9: $ … ⇒ dt u M v w r1 = dt u M v w r2 $ by lrel_closed_sem [#12, #1, #7, #9, a8]
a10y1: $ G ⇒ u = u $ by eq_refl
a10y2: $ G ⇒ M = M $ by eq_refl
a10y3: $ G ⇒ w = w $ by eq_refl
a10y4: $ G ⇒ r1 = r1 $ by eq_refl
a10y5: $ G ⇒ r2 = r2 $ by eq_refl
a10y6: $ … ⇒ dt u M e w r1 = dt u M v w r1 $ by dt_eq [a10y1, a10y2, #11, a10y3, a10y4]
a10y7: $ … ⇒ v = z $ by eq_sym [#10]
a10y8: $ … ⇒ dt u M v w r2 = dt u M z w r2 $ by dt_eq [a10y1, a10y2, a10y7, a10y3, a10y5]
a10y9: $ … ⇒ dt u M e w r1 = dt u M v w r2 $ by eq_trans [a10y6, a9]
a10: $ … ⇒ dt u M e w r1 = dt u M z w r2 $ by eq_trans [a10y9, a10y8]

--| The case `inst_app`.
lemma p3_c_app (G: hyps) (M: class) (u w k a p s x0 s2 r1 r2 z e k0 j f x g h: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = nvf' k $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ x0 = dt u M a w s $ > $ G ⇒ x0 ∊ u $ > $ G ⇒ s2 = x0 +: s $ > $ G ⇒ s2 ∊ fseq u $ >
  $ G ⇒ r1 = p ++ s $ > $ G ⇒ r1 ∊ fseq u $ > $ G ⇒ r2 = p ++ s2 $ > $ G ⇒ r2 ∊ fseq u $ >
  $ G ⇒ crn j ⊆ p3_ip u M w $ > $ G ⇒ z = ⟨ k0 , j ⟩ $ >
  $ G ⇒ z = ⟨ kc_app , f +: x +: ∅ ⟩ $ > $ G ⇒ e = ⟨ kc_app , g +: h +: ∅ ⟩ $ >
  $ G ⇒ ra_inst k f a g ∈ lrel $ > $ G ⇒ ra_inst k x a h ∈ lrel $ > $ G ⇒ dt u M e w r1 = dt u M z w r2 $
----
l1: $ G ⇒ kc_app ∈ ω $ by kc_app_omega
l2: $ … ⇒ isset kc_app $ by wcel_isset [l1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ … ⇒ isset (x +: ∅) $ by scons_set [l3]
l5: $ … ⇒ isset (f +: x +: ∅) $ by scons_set [l4]
l6: $ … ⇒ crn (f +: x +: ∅) ⊆ p3_ip u M w $ by p1_ch [#13, #14, #15, l2, l5]
l7: $ G ⇒ isset f $ by isset_var
l8: $ … ⇒ f ∈ p3_ip u M w $ by crn_scons_head [l7, l6]
l9: $ … ⇒ crn (x +: ∅) ⊆ p3_ip u M w $ by crn_scons_tail [l6]
l10: $ G ⇒ isset x $ by isset_var
l11: $ … ⇒ x ∈ p3_ip u M w $ by crn_scons_head [l10, l9]
