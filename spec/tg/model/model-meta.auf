-- Proofs for model-meta.mm0.

lemma p1_or_case (G: hyps) (p q c: fml): $ G , p ⇒ c $ > $ G , q ⇒ c $ > $ G , p ∨ q ⇒ c $
----
l1: $ G , p ∨ q ⇒ p ∨ q $ by ax
l2: $ G , p ∨ q , p ⇒ c $ by weaken [#1]
l3: $ G , p ∨ q , q ⇒ c $ by weaken [#2]
l4: $ … ⇒ c $ by or_elim [l1, l2, l3]

lemma p1_cc_case {w r: set} (G: hyps w r) (U W R: class) (B: class w r) (q: fml) (d c t: set): $ G ⇒ d = ⟨ W , c ⟩ $ > $ G ⇒ c = ⟨ R , t ⟩ $ > $ G ⇒ ¬ R ∈ fseq U $ > $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) ⇒ ⊥ $
----
a0: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) ⇒ q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B)) $ by ax
a1: $ … ⇒ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B)) $ by and_elim_r [a0]
b1: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) ⇒ d = ⟨ W , c ⟩ $ by weaken [#1]
b2: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) ⇒ d = ⟨ a , b ⟩ $ by ax
b3: $ … ⇒ ⟨ W , c ⟩ = d $ by eq_sym [b1]
b4: $ … ⇒ ⟨ W , c ⟩ = ⟨ a , b ⟩ $ by eq_trans [b3, b2]
b5: $ … ⇒ isset W $ by opair_eq_isset [b4]
b6: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) ⇒ isset c $ by isset_var
b7: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) ⇒ isset a $ by isset_var
b8: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) ⇒ isset b $ by isset_var
b9: $ … ⇒ W = a ∧ c = b $ by opair_inj_c [b4, b5, b6, b7, b8]
b10: $ … ⇒ c = b $ by and_elim_r [b9]
b11: $ … ⇒ b = c $ by eq_sym [b10]
b12: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) ⇒ b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) $ by ax
b13: $ … ⇒ c ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) $ by welc_eq_set [b11, b12]
c1: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) , c = ⟨ e , f ⟩ , e ∊ fseq U , f ∊ ([[ r / e ]] ([[ w / a ]] B)) ⇒ c = ⟨ R , t ⟩ $ by weaken [#2]
c2: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) , c = ⟨ e , f ⟩ , e ∊ fseq U , f ∊ ([[ r / e ]] ([[ w / a ]] B)) ⇒ c = ⟨ e , f ⟩ $ by ax
c3: $ … ⇒ ⟨ R , t ⟩ = c $ by eq_sym [c1]
c4: $ … ⇒ ⟨ R , t ⟩ = ⟨ e , f ⟩ $ by eq_trans [c3, c2]
c5: $ … ⇒ isset R $ by opair_eq_isset [c4]
c6: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) , c = ⟨ e , f ⟩ , e ∊ fseq U , f ∊ ([[ r / e ]] ([[ w / a ]] B)) ⇒ isset t $ by isset_var
c7: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) , c = ⟨ e , f ⟩ , e ∊ fseq U , f ∊ ([[ r / e ]] ([[ w / a ]] B)) ⇒ isset e $ by isset_var
c8: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) , c = ⟨ e , f ⟩ , e ∊ fseq U , f ∊ ([[ r / e ]] ([[ w / a ]] B)) ⇒ isset f $ by isset_var
c9: $ … ⇒ R = e ∧ t = f $ by opair_inj_c [c4, c5, c6, c7, c8]
c10: $ … ⇒ R = e $ by and_elim_l [c9]
c11: $ … ⇒ e = R $ by eq_sym [c10]
c12: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) , c = ⟨ e , f ⟩ , e ∊ fseq U , f ∊ ([[ r / e ]] ([[ w / a ]] B)) ⇒ e ∊ fseq U $ by ax
c13: $ … ⇒ R ∈ fseq U $ by wcel_intro [c11, c12]
c14: $ G , (q ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq U, B))) , d = ⟨ a , b ⟩ , a ∊ lvals , b ∊ (λₛ r ∈ fseq U, [[ w / a ]] B) , c = ⟨ e , f ⟩ , e ∊ fseq U , f ∊ ([[ r / e ]] ([[ w / a ]] B)) ⇒ ¬ R ∈ fseq U $ by weaken [#3]
c15: $ … ⇒ ⊥ $ by not_elim [c14, c13]
b14: $ … ⇒ ⊥ $ by clam_elim_mem [b13, c15]
a2: $ … ⇒ ⊥ $ by clam_elim_mem [a1, b14]

lemma p1_dnb_out (G: hyps) (M K S V W R: class) (u: set): $ G ⇒ K ∈ kstr $ > $ G ⇒ ¬ R ∈ fseq u $ > $ G ⇒ ap (ap (dnb u M K S V) W) R = ∅ $
----
a1: $ G , t ∊ ap (ap (dnb u M K S V) W) R ⇒ t ∊ ap (ap (dnb u M K S V) W) R $ by ax
a2: $ … ⇒ ⟨ R , t ⟩ ∈ ap (dnb u M K S V) W $ by ap_elim [a1]
a3: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W ⇒ c ∊ ap (dnb u M K S V) W $ by ax
a4: $ … ⇒ ⟨ W , c ⟩ ∈ dnb u M K S V $ by ap_elim [a3]
a5: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V ⇒ d ∊ dnb u M K S V $ by ax
a6: $ … ⇒ (K = kc_bvar ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, r' nvf' S' ∅))) ∨ (K = kc_srt ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, uni' (lv (S' ∅) w)))) ∨ (K = kc_app ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, ap (da (V' ∅) w r) (da (V' (suc ∅)) w r)))) ∨ (K = kc_lam ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, (λₛ x ∈ da (V' ∅) w r, da (V' (suc ∅)) w (x +: r))))) ∨ (K = kc_pi ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, (Πₛ x ∈ da (V' ∅) w r, da (V' (suc ∅)) w (x +: r))))) ∨ (K = kc_proj ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, (da (V' (suc (suc ∅))) w r)' (suc (nvf' S' (suc ∅)))))) ∨ (K ∈ kexa ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, mclip u (ap (M' ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ d ∊ sclip (M' ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by cab_elim [a5]
h1: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V ⇒ d = ⟨ W , c ⟩ $ by ax
h2: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V ⇒ c = ⟨ R , t ⟩ $ by ax
h3: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V ⇒ ¬ R ∈ fseq u $ by weaken [#2]
k0: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (K = kc_bvar ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, r' nvf' S' ∅))) ⇒ ⊥ $ by p1_cc_case [h1, h2, h3]
k1: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (K = kc_srt ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, uni' (lv (S' ∅) w)))) ⇒ ⊥ $ by p1_cc_case [h1, h2, h3]
k2: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (K = kc_app ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, ap (da (V' ∅) w r) (da (V' (suc ∅)) w r)))) ⇒ ⊥ $ by p1_cc_case [h1, h2, h3]
k3: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (K = kc_lam ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, (λₛ x ∈ da (V' ∅) w r, da (V' (suc ∅)) w (x +: r))))) ⇒ ⊥ $ by p1_cc_case [h1, h2, h3]
k4: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (K = kc_pi ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, (Πₛ x ∈ da (V' ∅) w r, da (V' (suc ∅)) w (x +: r))))) ⇒ ⊥ $ by p1_cc_case [h1, h2, h3]
k5: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (K = kc_proj ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, (da (V' (suc (suc ∅))) w r)' (suc (nvf' S' (suc ∅)))))) ⇒ ⊥ $ by p1_cc_case [h1, h2, h3]
k6: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (K ∈ kexa ∧ d ∊ (λₛ w ∈ lvals, (λₛ r ∈ fseq u, mclip u (ap (M' ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ⇒ ⊥ $ by p1_cc_case [h1, h2, h3]
k7a: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (¬ K ∈ kstr ∧ d ∊ sclip (M' ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) ⇒ ¬ K ∈ kstr ∧ d ∊ sclip (M' ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) $ by ax
k7b: $ … ⇒ ¬ K ∈ kstr $ by and_elim_l [k7a]
k7c: $ G , t ∊ ap (ap (dnb u M K S V) W) R , c = ⟨ R , t ⟩ , c ∊ ap (dnb u M K S V) W , d = ⟨ W , c ⟩ , d ∊ dnb u M K S V , (¬ K ∈ kstr ∧ d ∊ sclip (M' ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) ⇒ K ∈ kstr $ by weaken [#1]
k7: $ … ⇒ ⊥ $ by not_elim [k7b, k7c]
o6: $ … ⇒ ⊥ $ by p1_or_case [k6, k7]
o5: $ … ⇒ ⊥ $ by p1_or_case [k5, o6]
o4: $ … ⇒ ⊥ $ by p1_or_case [k4, o5]
o3: $ … ⇒ ⊥ $ by p1_or_case [k3, o4]
o2: $ … ⇒ ⊥ $ by p1_or_case [k2, o3]
o1: $ … ⇒ ⊥ $ by p1_or_case [k1, o2]
o0: $ … ⇒ ⊥ $ by p1_or_case [k0, o1]
a7: $ … ⇒ ⊥ $ by cut [a6, o0]
a8: $ … ⇒ ⊥ $ by wcel_elim [a4, a7]
a9: $ … ⇒ ⊥ $ by wcel_elim [a2, a8]
a10: $ … ⇒ ap (ap (dnb u M K S V) W) R = ∅ $ by empty_eq_intro [a9]

dt_out
------
l1: $ G ⇒ kstr ⊆ ω $ by kstr_omega
l2: $ … ⇒ K ∈ ω $ by wcel_subset [l1, #1]
n1: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ k ∊ ω $ by ax
n2: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ j ∊ fseq (trees ω) $ by ax
n3: $ … ⇒ (dnf u M)' ⟨ k , j ⟩ = dnb u M k j (ccom (dnf u M) j) $ by dnf_node [n1, n2]
n4: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ k = K $ by ax
n5: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ j = S $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ = ⟨ K , S ⟩ $ by opair_eq [n4, n5]
n7: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ dnf u M = dnf u M $ by eq_refl
n8: $ … ⇒ (dnf u M)' ⟨ k , j ⟩ = (dnf u M)' ⟨ K , S ⟩ $ by fv_eq [n7, n6]
n9: $ … ⇒ (dnf u M)' ⟨ K , S ⟩ = (dnf u M)' ⟨ k , j ⟩ $ by eq_sym [n8]
n10: $ … ⇒ (dnf u M)' ⟨ K , S ⟩ = dnb u M k j (ccom (dnf u M) j) $ by eq_trans [n9, n3]
n11: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ W = W $ by eq_refl
n12: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ R = R $ by eq_refl
n13: $ … ⇒ ap ((dnf u M)' ⟨ K , S ⟩) W = ap (dnb u M k j (ccom (dnf u M) j)) W $ by ap_eq [n10, n11]
n14: $ … ⇒ ap (ap ((dnf u M)' ⟨ K , S ⟩) W) R = ap (ap (dnb u M k j (ccom (dnf u M) j)) W) R $ by ap_eq [n13, n12]
n15: $ … ⇒ K = k $ by eq_sym [n4]
n16: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ K ∈ kstr $ by weaken [#1]
n17: $ … ⇒ k ∈ kstr $ by wcel_eq_l [n15, n16]
n18: $ G , k = K , k ∊ ω , j = S , j ∊ fseq (trees ω) ⇒ ¬ R ∈ fseq u $ by weaken [#3]
n19: $ … ⇒ ap (ap (dnb u M k j (ccom (dnf u M) j)) W) R = ∅ $ by p1_dnb_out [n17, n18]
n20: $ … ⇒ ap (ap ((dnf u M)' ⟨ K , S ⟩) W) R = ∅ $ by eq_trans [n14, n19]
n21: $ … ⇒ ap (ap ((dnf u M)' ⟨ K , S ⟩) W) R = ∅ $ by wcel_elim [#2, n20]
n22: $ … ⇒ dt u M ⟨ K , S ⟩ W R = ∅ $ by wcel_elim [l2, n21]

dt_out_tree
-----------
l1: $ … ⇒ isset K $ by wcel_isset [#3]
l2y1: $ … ⇒ ⟨ K , S ⟩ ∈ trees ω $ by wcel_intro [#2, #1]
l2y2: $ G ⇒ isset ω $ by omega_set
l2y3: $ … ⇒ K ∈ ω ∧ S ∈ fseq (trees ω) $ by trees_node_c [l2y2, l2y1, l1, #4]
l2: $ … ⇒ S ∈ fseq (trees ω) $ by and_elim_r [l2y3]
l3: $ … ⇒ dt u M ⟨ K , S ⟩ W R = ∅ $ by dt_out [#3, l2, #5]
l4: $ G ⇒ u = u $ by eq_refl
l5: $ G ⇒ M = M $ by eq_refl
l6: $ G ⇒ W = W $ by eq_refl
l7: $ G ⇒ R = R $ by eq_refl
l8: $ … ⇒ dt u M t W R = dt u M ⟨ K , S ⟩ W R $ by dt_eq [l4, l5, #2, l6, l7]
l9: $ … ⇒ dt u M t W R = ∅ $ by eq_trans [l8, l3]

lrel_closed_out
---------------
a0: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
a1: $ … ⇒ isset kr_closed $ by wcel_isset [a0]
a2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by lrel_args2 [#1, a1]
a3r0: $ … ⇒ t2 ∊ trees ω $ by and_elim_r [a2]
a4: $ … ⇒ ∃ x0 ∃ x1 (t1 = x1 ∧ t2 = ⟨ kc_bvar , x0 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x0 +: ∅ ⟩ x1 ∈ lrel) ∨ ∃ x1 ∃ x2 (t1 = x1 ∧ t2 = ⟨ kc_srt , x2 +: ∅ ⟩) ∨ ∃ x1 ∃ x3 ∃ x4 (t1 = x1 ∧ t2 = ⟨ kc_app , x3 +: x4 +: ∅ ⟩ ∧ ra_closed x1 x3 ∈ lrel ∧ ra_closed x1 x4 ∈ lrel) ∨ ∃ x1 ∃ x5 ∃ x6 (t1 = x1 ∧ t2 = ⟨ kc_lam , x5 +: x6 +: ∅ ⟩ ∧ ra_closed x1 x5 ∈ lrel ∧ ra_closed ⟨ kc_s , x1 +: ∅ ⟩ x6 ∈ lrel) ∨ ∃ x1 ∃ x5 ∃ x6 (t1 = x1 ∧ t2 = ⟨ kc_pi , x5 +: x6 +: ∅ ⟩ ∧ ra_closed x1 x5 ∈ lrel ∧ ra_closed ⟨ kc_s , x1 +: ∅ ⟩ x6 ∈ lrel) ∨ ∃ x1 ∃ x4 ∃ x7 (t1 = x1 ∧ t2 = ⟨ kc_cst , x4 +: x7 +: ∅ ⟩) ∨ ∃ x1 ∃ x8 (t1 = x1 ∧ t2 = ⟨ kc_lit , x8 +: ∅ ⟩) ∨ ∃ x1 ∃ x9 ∃ x0 (t1 = x1 ∧ t2 = ⟨ kc_ind_ty , x9 +: x0 +: ∅ ⟩) ∨ ∃ x1 ∃ x9 ∃ x0 ∃ a (t1 = x1 ∧ t2 = ⟨ kc_ind_ctor , x9 +: x0 +: a +: ∅ ⟩) ∨ ∃ x1 ∃ x9 ∃ x0 ∃ b (t1 = x1 ∧ t2 = ⟨ kc_ind_rec , x9 +: x0 +: b +: ∅ ⟩) ∨ ∃ x1 ∃ x6 ∃ x0 ∃ c (t1 = x1 ∧ t2 = ⟨ kc_proj , x6 +: x0 +: c +: ∅ ⟩ ∧ ra_closed x1 c ∈ lrel) $ by lrel_closed_cases [#1]
c0b: $ G , t1 = x1 ∧ t2 = ⟨ kc_bvar , x0 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x0 +: ∅ ⟩ x1 ∈ lrel ⇒ t1 = x1 ∧ t2 = ⟨ kc_bvar , x0 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x0 +: ∅ ⟩ x1 ∈ lrel $ by ax
c0r0: $ … ⇒ t2 = ⟨ kc_bvar , x0 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x0 +: ∅ ⟩ x1 ∈ lrel $ by and_elim_r [c0b]
c0l1: $ … ⇒ t2 = ⟨ kc_bvar , x0 +: ∅ ⟩ $ by and_elim_l [c0r0]
c0nr: $ G , t1 = x1 ∧ t2 = ⟨ kc_bvar , x0 +: ∅ ⟩ ∧ ra_le ⟨ kc_s , x0 +: ∅ ⟩ x1 ∈ lrel ⇒ ¬ R ∈ fseq u $ by weaken [#2]
