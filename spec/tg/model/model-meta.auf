l23: $ … ⇒ dt u M b w (x +: q) = dt u M b w (∅ ++ (x +: ∅) ++ q) $ by dt_eq [r1, r2, r3, r4, l21]
l24: $ … ⇒ dt u M a w (∅ ++ q) = dt u M a w q $ by dt_eq [r1, r2, r5, r4, l22]
l25: $ … ⇒ dt u M b w (x +: q) = dt u M a w (∅ ++ q) $ by eq_trans [l23, l14c]
l26: $ … ⇒ dt u M b w (x +: q) = dt u M a w q $ by eq_trans [l25, l24]

--| Membership in `sat` along an equality of the context tree.
lemma f1_sat_eq (G: hyps) (M A B: class) (u w e: set): $ G ⇒ A = B $ > $ G ⇒ e ∊ sat u M A w $ > $ G ⇒ e ∊ sat u M B w $
----
l1: $ G ⇒ stf u M = stf u M $ by eq_refl
l2: $ … ⇒ (stf u M)' A = (stf u M)' B $ by fv_eq [l1, #1]
l3: $ G ⇒ w = w $ by eq_refl
l4: $ … ⇒ e ∊ sat u M B w $ by welc_ap_eq [l2, l3, #2]

--| The context trees `y` such that for every derivable `lookup y n a` and every
--| valuation `r` satisfying `y`, the `n`-th entry of `r` is in the value of `a`.
def f1_lkp (U M W: class) (.y .n .a .r: set): class = $ {y | ∀ n ∀ a ∀ r (⟨ kr_lookup , y +: n +: a +: ∅ ⟩ ∈ lrel → r ∊ sat U M y W → r' nvf' n ∈ dt U M a W r)} $

lemma f1_lkp_e (G: hyps) (M: class) (u w t c d e: set): $ G ⇒ t ∊ f1_lkp u M w $ > $ G ⇒ ra_lookup t c d ∈ lrel $ > $ G ⇒ e ∊ sat u M t w $ > $ G ⇒ e' nvf' c ∈ dt u M d w e $
----
l1: $ … ⇒ ∀ n ∀ a ∀ r (⟨ kr_lookup , t +: n +: a +: ∅ ⟩ ∈ lrel → r ∊ sat u M t w → r' nvf' n ∈ dt u M a w r) $ by cab_elim [#1]
l2: $ … ⇒ ∀ a ∀ r (⟨ kr_lookup , t +: c +: a +: ∅ ⟩ ∈ lrel → r ∊ sat u M t w → r' nvf' c ∈ dt u M a w r) $ by all_elim [l1]
l3: $ … ⇒ ∀ r (⟨ kr_lookup , t +: c +: d +: ∅ ⟩ ∈ lrel → r ∊ sat u M t w → r' nvf' c ∈ dt u M d w r) $ by all_elim [l2]
l4: $ … ⇒ ⟨ kr_lookup , t +: c +: d +: ∅ ⟩ ∈ lrel → e ∊ sat u M t w → e' nvf' c ∈ dt u M d w e $ by all_elim [l3]
l5: $ … ⇒ e ∊ sat u M t w → e' nvf' c ∈ dt u M d w e $ by imp_elim [l4, #2]
l6: $ … ⇒ e' nvf' c ∈ dt u M d w e $ by imp_elim [l5, #3]

lemma f1_lkp_i {n a r: set} (G: hyps) (M: class) (u w t: set): $ G , ra_lookup t n a ∈ lrel , r ∊ sat u M t w ⇒ r' nvf' n ∈ dt u M a w r $ > $ G ⇒ t ∊ f1_lkp u M w $
----
l1: $ … ⇒ r ∊ sat u M t w → r' nvf' n ∈ dt u M a w r $ by imp_intro [#1]
l2: $ … ⇒ ⟨ kr_lookup , t +: n +: a +: ∅ ⟩ ∈ lrel → r ∊ sat u M t w → r' nvf' n ∈ dt u M a w r $ by imp_intro [l1]
l3: $ … ⇒ ∀ r (⟨ kr_lookup , t +: n +: a +: ∅ ⟩ ∈ lrel → r ∊ sat u M t w → r' nvf' n ∈ dt u M a w r) $ by all_intro [l2]
l4: $ … ⇒ ∀ a ∀ r (⟨ kr_lookup , t +: n +: a +: ∅ ⟩ ∈ lrel → r ∊ sat u M t w → r' nvf' n ∈ dt u M a w r) $ by all_intro [l3]
l5: $ … ⇒ ∀ n ∀ a ∀ r (⟨ kr_lookup , t +: n +: a +: ∅ ⟩ ∈ lrel → r ∊ sat u M t w → r' nvf' n ∈ dt u M a w r) $ by all_intro [l4]
l6: $ G ⇒ t ∊ f1_lkp u M w $ by cab_intro [l5]

--| The case `lookup_z`, inside the elimination: `r = x :: q` reads `x`, in the
--| value of `A` at `q`, which is that of its lift at `x :: q`.
lemma f1_cz_core (H: hyps) (M: class) (u w c d e a b g x q: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ c = ⟨ kc_nz , ∅ ⟩ $ > $ H ⇒ d = b $ > $ H ⇒ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel $ > $ H ⇒ q ∊ sat u M g w $ > $ H ⇒ x ∊ dt u M a w q $ > $ H ⇒ e = x +: q $ > $ H ⇒ e ∊ fseq u $ > $ H ⇒ e' nvf' c ∈ dt u M d w e $
----
q1: $ H ⇒ sat u M g w ⊆ fseq u $ by sat_fseq
q2: $ … ⇒ q ∊ fseq u $ by subset_elim [q1, #5]
q3: $ … ⇒ e ∈ fseq u $ by welc_wcel [#8]
q4: $ … ⇒ x +: q ∈ fseq u $ by wcel_eq_l [#7, q3]
q5: $ … ⇒ x ∊ u $ by scons_fseq_hd [q4]
k1: $ … ⇒ dt u M b w (x +: q) = dt u M a w q $ by f1_lift1 [#4, #1, q5, q2]
k2a: $ H ⇒ nvf = nvf $ by eq_refl
k2b: $ … ⇒ nvf' c = nvf' ⟨ kc_nz , ∅ ⟩ $ by fv_eq [k2a, #2]
k2c: $ H ⇒ nvf' ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
k2: $ … ⇒ nvf' c = ∅ $ by eq_trans [k2b, k2c]
k3: $ … ⇒ e' nvf' c = (x +: q)' ∅ $ by fv_eq [#7, k2]
k4: $ H ⇒ (x +: q)' ∅ = x $ by scons_fv_zero
k5: $ … ⇒ e' nvf' c = x $ by eq_trans [k3, k4]
k6: $ … ⇒ x ∈ dt u M a w q $ by welc_wcel [#6]
k7: $ … ⇒ dt u M a w q = dt u M b w (x +: q) $ by eq_sym [k1]
k8: $ … ⇒ x ∈ dt u M b w (x +: q) $ by wcel_eq_r [k7, k6]
r1: $ H ⇒ u = u $ by eq_refl
r2: $ H ⇒ M = M $ by eq_refl
r4: $ H ⇒ w = w $ by eq_refl
k9a: $ … ⇒ b = d $ by eq_sym [#3]
k9b: $ … ⇒ x +: q = e $ by eq_sym [#7]
k9: $ … ⇒ dt u M b w (x +: q) = dt u M d w e $ by dt_eq [r1, r2, k9a, r4, k9b]
k10: $ … ⇒ x ∈ dt u M d w e $ by wcel_eq_r [k9, k8]
k11: $ … ⇒ x = e' nvf' c $ by eq_sym [k5]
k12: $ … ⇒ e' nvf' c ∈ dt u M d w e $ by wcel_eq_l [k11, k10]

--| The case `lookup_s`, inside the elimination: `r = x :: q` at `n + 1` reads `q`
--| at `n`, in the value of `B` at `q` by the induction hypothesis, then lifted.
lemma f1_cs_core (H: hyps) (M: class) (u w c d e b f g n x q: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ c = ⟨ kc_s , n +: ∅ ⟩ $ > $ H ⇒ d = f $ > $ H ⇒ ra_lookup g n b ∈ lrel $ > $ H ⇒ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b f ∈ lrel $ > $ H ⇒ g ∊ f1_lkp u M w $ > $ H ⇒ q ∊ sat u M g w $ > $ H ⇒ e = x +: q $ > $ H ⇒ e ∊ fseq u $ > $ H ⇒ e' nvf' c ∈ dt u M d w e $
----
q1: $ H ⇒ sat u M g w ⊆ fseq u $ by sat_fseq
q2: $ … ⇒ q ∊ fseq u $ by subset_elim [q1, #7]
q3: $ … ⇒ e ∈ fseq u $ by welc_wcel [#9]
q4: $ … ⇒ x +: q ∈ fseq u $ by wcel_eq_l [#8, q3]
q5: $ … ⇒ x ∊ u $ by scons_fseq_hd [q4]
i1: $ … ⇒ q' nvf' n ∈ dt u M b w q $ by f1_lkp_e [#6, #4, #7]
t0: $ H ⇒ kr_lookup ∈ ω $ by kr_lookup_omega
t1: $ … ⇒ isset kr_lookup $ by wcel_isset [t0]
t2: $ … ⇒ g ∊ trees ω ∧ n ∊ trees ω ∧ b ∊ trees ω $ by lrel_args3 [#4, t1]
t3: $ … ⇒ n ∊ trees ω ∧ b ∊ trees ω $ by and_elim_r [t2]
t4: $ … ⇒ n ∊ trees ω $ by and_elim_l [t3]
t5: $ … ⇒ n ∈ trees ω $ by welc_wcel [t4]
n1: $ H ⇒ nvf = nvf $ by eq_refl
n2: $ … ⇒ nvf' c = nvf' ⟨ kc_s , n +: ∅ ⟩ $ by fv_eq [n1, #2]
n3: $ … ⇒ nvf' ⟨ kc_s , n +: ∅ ⟩ = suc (nvf' n) $ by nvf_s [t5]
n4: $ … ⇒ nvf' c = suc (nvf' n) $ by eq_trans [n2, n3]
n5: $ … ⇒ e' nvf' c = (x +: q)' (suc (nvf' n)) $ by fv_eq [#8, n4]
s1: $ H ⇒ isset x $ by isset_var
s2: $ H ⇒ isset q $ by isset_var
s3a: $ H ⇒ isset n $ by isset_var
s3b: $ … ⇒ nvf' n ∈ ω $ by nvf_omega [s3a]
s3: $ … ⇒ isset (nvf' n) $ by wcel_isset [s3b]
n6: $ … ⇒ (x +: q)' (suc (nvf' n)) = q' nvf' n $ by scons_fv_suc_c [s1, s2, s3]
n7: $ … ⇒ e' nvf' c = q' nvf' n $ by eq_trans [n5, n6]
k1: $ … ⇒ dt u M f w (x +: q) = dt u M b w q $ by f1_lift1 [#5, #1, q5, q2]
k7: $ … ⇒ dt u M b w q = dt u M f w (x +: q) $ by eq_sym [k1]
k8: $ … ⇒ q' nvf' n ∈ dt u M f w (x +: q) $ by wcel_eq_r [k7, i1]
r1: $ H ⇒ u = u $ by eq_refl
r2: $ H ⇒ M = M $ by eq_refl
r4: $ H ⇒ w = w $ by eq_refl
k9a: $ … ⇒ f = d $ by eq_sym [#3]
k9b: $ … ⇒ x +: q = e $ by eq_sym [#8]
k9: $ … ⇒ dt u M f w (x +: q) = dt u M d w e $ by dt_eq [r1, r2, k9a, r4, k9b]
k10: $ … ⇒ q' nvf' n ∈ dt u M d w e $ by wcel_eq_r [k9, k8]
k11: $ … ⇒ q' nvf' n = e' nvf' c $ by eq_sym [n7]
k12: $ … ⇒ e' nvf' c ∈ dt u M d w e $ by wcel_eq_l [k11, k10]

--| A valuation satisfying a `cons` node is `x :: q`, with `q` satisfying the tail.
lemma f1_split {x q: set} (H: hyps) (M: class) (u w z e a g: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ z = ⟨ kc_cons , a +: g +: ∅ ⟩ $ > $ H ⇒ e ∊ sat u M z w $ > $ H ⇒ ∃ x ∃ q (q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q) $
----
l1: $ … ⇒ e ∊ sat u M ⟨ kc_cons , a +: g +: ∅ ⟩ w $ by f1_sat_eq [#3, #4]
l2: $ … ⇒ z ∈ trees ω $ by welc_wcel [#2]
l3: $ … ⇒ ⟨ kc_cons , a +: g +: ∅ ⟩ ∈ trees ω $ by wcel_eq_l [#3, l2]
l4: $ H ⇒ isset ω $ by omega_set
l5: $ H ⇒ kc_cons ∈ ω $ by kc_cons_omega
l6: $ … ⇒ isset kc_cons $ by wcel_isset [l5]
l7: $ … ⇒ a ∊ trees ω ∧ g ∊ trees ω $ by trees_kids2 [l4, l3, l6]
l8: $ … ⇒ a ∊ trees ω $ by and_elim_l [l7]
l9: $ … ⇒ g ∊ trees ω $ by and_elim_r [l7]
l10: $ … ⇒ a ∈ trees ω $ by welc_wcel [l8]
l11: $ … ⇒ g ∈ trees ω $ by welc_wcel [l9]
l12: $ … ⇒ ∃ x ∃ q (q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q) $ by sat_cons_elim [l10, l11, #1, l1]

--| The case `lookup_z`.
lemma f1_cz (H: hyps) (M: class) (u w z c d e a b g: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ e ∊ sat u M z w $ > $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ⇒ e' nvf' c ∈ dt u M d w e $
----
a0: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ⇒ z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel $ by ax
a1: $ … ⇒ z = ⟨ kc_cons , a +: g +: ∅ ⟩ $ by and_elim_l [a0]
a2: $ … ⇒ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel $ by and_elim_r [a0]
a3: $ … ⇒ c = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [a2]
a4: $ … ⇒ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel $ by and_elim_r [a2]
a5: $ … ⇒ d = b $ by and_elim_l [a4]
a6: $ … ⇒ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel $ by and_elim_r [a4]
a7: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ⇒ w ∊ lvals $ by weaken [#1]
a8: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ⇒ z ∊ trees ω $ by weaken [#2]
a9: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ⇒ e ∊ sat u M z w $ by weaken [#3]
a10: $ … ⇒ ∃ x ∃ q (q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q) $ by f1_split [a7, a8, a1, a9]
b0: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel , q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q ⇒ q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q $ by ax
b1: $ … ⇒ q ∊ sat u M g w $ by and_elim_l [b0]
b2: $ … ⇒ x ∊ dt u M a w q ∧ e = x +: q $ by and_elim_r [b0]
b3: $ … ⇒ x ∊ dt u M a w q $ by and_elim_l [b2]
b4: $ … ⇒ e = x +: q $ by and_elim_r [b2]
b5: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel , q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q ⇒ sat u M z w ⊆ fseq u $ by sat_fseq
b6a: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel , q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q ⇒ e ∊ sat u M z w $ by weaken [#3]
b6: $ … ⇒ e ∊ fseq u $ by subset_elim [b5, b6a]
b7a: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel , q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q ⇒ w ∊ lvals $ by weaken [#1]
b7b: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel , q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q ⇒ c = ⟨ kc_nz , ∅ ⟩ $ by weaken [a3]
b7c: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel , q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q ⇒ d = b $ by weaken [a5]
b7d: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel , q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q ⇒ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel $ by weaken [a6]
b7: $ … ⇒ e' nvf' c ∈ dt u M d w e $ by f1_cz_core [b7a, b7b, b7c, b7d, b1, b3, b4, b6]
c0: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_nz , ∅ ⟩ ∧ d = b ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a b ∈ lrel , ∃ q (q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q) ⇒ ∃ q (q ∊ sat u M g w ∧ x ∊ dt u M a w q ∧ e = x +: q) $ by ax
c1: $ … ⇒ e' nvf' c ∈ dt u M d w e $ by ex_elim [c0, b7]
c2: $ … ⇒ e' nvf' c ∈ dt u M d w e $ by ex_elim [a10, c1]

--| The case `lookup_s`, with the induction hypothesis at the tail.
lemma f1_cs (H: hyps) (M: class) (u w z c d e k j a b f g n: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ e ∊ sat u M z w $ > $ H ⇒ crn j ⊆ f1_lkp u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_s , n +: ∅ ⟩ ∧ d = f ∧ ra_lookup g n b ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b f ∈ lrel ⇒ e' nvf' c ∈ dt u M d w e $
----
a0: $ H , z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_s , n +: ∅ ⟩ ∧ d = f ∧ ra_lookup g n b ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b f ∈ lrel ⇒ z = ⟨ kc_cons , a +: g +: ∅ ⟩ ∧ c = ⟨ kc_s , n +: ∅ ⟩ ∧ d = f ∧ ra_lookup g n b ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b f ∈ lrel $ by ax
a1: $ … ⇒ z = ⟨ kc_cons , a +: g +: ∅ ⟩ $ by and_elim_l [a0]
a2: $ … ⇒ c = ⟨ kc_s , n +: ∅ ⟩ ∧ d = f ∧ ra_lookup g n b ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b f ∈ lrel $ by and_elim_r [a0]
a3: $ … ⇒ c = ⟨ kc_s , n +: ∅ ⟩ $ by and_elim_l [a2]
a4: $ … ⇒ d = f ∧ ra_lookup g n b ∈ lrel ∧ ra_lift ⟨ kc_s , ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_nz , ∅ ⟩ b f ∈ lrel $ by and_elim_r [a2]
