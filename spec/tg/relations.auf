l8: $ (∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ⟺ (∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ C ∧ y ∊ D)) $ by ex_congr [l7]
