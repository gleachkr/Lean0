cdm_intro
---------
l1: $ G ⇒ ∃ v (⟨ a , v ⟩ ∈ R) $ by ex_intro (x := $ v $, t := $ b $, p := $ ⟨ a , v ⟩ ∈ R $) [#1]
l2: $ G ⇒ a ∊ {u | ∃ v (⟨ u , v ⟩ ∈ R)} $ by cab_intro (x := $ u $, t := $ a $, p := $ ∃ v (⟨ u , v ⟩ ∈ R) $) [l1]

cdm_elim
--------
l1: $ G ⇒ ∃ y (⟨ a , y ⟩ ∈ R) $ by cab_elim (x := $ u $, t := $ a $, p := $ ∃ y (⟨ u , y ⟩ ∈ R) $) [#1]
l2: $ G , H ⇒ c $ by ex_elim [l1, #2]

crn_intro
---------
l1: $ G ⇒ ∃ u (⟨ u , b ⟩ ∈ R) $ by ex_intro (x := $ u $, t := $ a $, p := $ ⟨ u , b ⟩ ∈ R $) [#1]
l2: $ G ⇒ b ∊ {v | ∃ u (⟨ u , v ⟩ ∈ R)} $ by cab_intro (x := $ v $, t := $ b $, p := $ ∃ u (⟨ u , v ⟩ ∈ R) $) [l1]

crn_elim
--------
l1: $ G ⇒ ∃ x (⟨ x , b ⟩ ∈ R) $ by cab_elim (x := $ v $, t := $ b $, p := $ ∃ x (⟨ x , v ⟩ ∈ R) $) [#1]
l2: $ G , H ⇒ c $ by ex_elim [l1, #2]

cdm_mono
--------
l1: $ G , z ∊ cdm R ⇒ z ∊ cdm R $ by ax
l2: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R ⇒ ⟨ z , v ⟩ ∈ R $ by ax
l3: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R ⇒ R ⊆ S $ by weaken [#1]
l4: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R ⇒ ⟨ z , v ⟩ ∈ S $ by wcel_subset [l3, l2]
l5: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R ⇒ z ∊ cdm S $ by cdm_intro [l4]
l6: $ G , z ∊ cdm R ⇒ z ∊ cdm S $ by cdm_elim [l1, l5]
l7: $ G ⇒ cdm R ⊆ cdm S $ by subset_intro [l6]

crn_mono
--------
l1: $ G , z ∊ crn R ⇒ z ∊ crn R $ by ax
l2: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R ⇒ ⟨ u , z ⟩ ∈ R $ by ax
l3: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R ⇒ R ⊆ S $ by weaken [#1]
l4: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R ⇒ ⟨ u , z ⟩ ∈ S $ by wcel_subset [l3, l2]
l5: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R ⇒ z ∊ crn S $ by crn_intro [l4]
l6: $ G , z ∊ crn R ⇒ z ∊ crn S $ by crn_elim [l1, l5]
l7: $ G ⇒ crn R ⊆ crn S $ by subset_intro [l6]

cdm_cxp
-------
l1: $ G , z ∊ cdm (A × B) ⇒ z ∊ cdm (A × B) $ by ax
l2: $ G , z ∊ cdm (A × B) , ⟨ z , v ⟩ ∈ A × B ⇒ ⟨ z , v ⟩ ∈ A × B $ by ax
l3: $ G , z ∊ cdm (A × B) , ⟨ z , v ⟩ ∈ A × B ⇒ z ∊ A ∧ v ∊ B $ by cxp_elim_pair [l2]
l4: $ G , z ∊ cdm (A × B) , ⟨ z , v ⟩ ∈ A × B ⇒ z ∊ A $ by and_elim_l [l3]
l5: $ G , z ∊ cdm (A × B) ⇒ z ∊ A $ by cdm_elim [l1, l4]
l6: $ G , z ∊ A ⇒ z ∊ A $ by ax
l7: $ G , z ∊ A ⇒ b ∊ B $ by weaken [#1]
l8: $ G , z ∊ A ⇒ ⟨ z , b ⟩ ∈ A × B $ by cxp_intro [l6, l7]
l9: $ G , z ∊ A ⇒ z ∊ cdm (A × B) $ by cdm_intro [l8]
l10: $ G ⇒ cdm (A × B) = A $ by eq_intro [l5, l9]

crn_cxp
-------
l1: $ G , z ∊ crn (A × B) ⇒ z ∊ crn (A × B) $ by ax
l2: $ G , z ∊ crn (A × B) , ⟨ u , z ⟩ ∈ A × B ⇒ ⟨ u , z ⟩ ∈ A × B $ by ax
l3: $ G , z ∊ crn (A × B) , ⟨ u , z ⟩ ∈ A × B ⇒ u ∊ A ∧ z ∊ B $ by cxp_elim_pair [l2]
l4: $ G , z ∊ crn (A × B) , ⟨ u , z ⟩ ∈ A × B ⇒ z ∊ B $ by and_elim_r [l3]
l5: $ G , z ∊ crn (A × B) ⇒ z ∊ B $ by crn_elim [l1, l4]
l6: $ G , z ∊ B ⇒ z ∊ B $ by ax
l7: $ G , z ∊ B ⇒ a ∊ A $ by weaken [#1]
l8: $ G , z ∊ B ⇒ ⟨ a , z ⟩ ∈ A × B $ by cxp_intro [l7, l6]
l9: $ G , z ∊ B ⇒ z ∊ crn (A × B) $ by crn_intro [l8]
l10: $ G ⇒ crn (A × B) = B $ by eq_intro [l5, l9]

rel_subset_cxp
--------------
l1: $ G , z ∊ R ⇒ z ∊ R $ by ax
l2: $ G , z ∊ R ⇒ rel R $ by weaken [#1]
l3: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ z = ⟨ u , v ⟩ $ by ax
l4: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ z ∊ R $ by ax
l5: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ z ∈ R $ by welc_wcel [l4]
l6: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ ⟨ u , v ⟩ ∈ R $ by wcel_eq_l [l3, l5]
l7: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ u ∊ cdm R $ by cdm_intro [l6]
l8: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ v ∊ crn R $ by crn_intro [l6]
l9: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ z ∊ cdm R × crn R $ by cxp_intro_eq [l3, l7, l8]
l10: $ G , z ∊ R ⇒ z ∊ cdm R × crn R $ by rel_elim [l2, l1, l9]
l11: $ G ⇒ R ⊆ cdm R × crn R $ by subset_intro [l10]

cdm_set
-------
l1: $ G , z ∊ cdm R ⇒ z ∊ cdm R $ by ax
l2: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R ⇒ ⟨ z , v ⟩ ∈ R $ by ax
l3: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R ⇒ isset z $ by isset_var
l4: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R ⇒ isset (csn z) $ by csn_set [l3]
l5: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ w = csn z $ by ax
l6: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ w = csn z ∨ w = cpr z v $ by or_intro_l [l5]
l7: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ w ∊ cpr (csn z) (cpr z v) $ by cpr_intro [l6]
l8: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ k = ⟨ z , v ⟩ $ by ax
l9: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ ⟨ z , v ⟩ = k $ by eq_sym [l8]
l10: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ w ∊ k $ by welc_eq [l9, l7]
l11: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ k ∊ R $ by ax
l12: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ w ∊ ⋃ R $ by cuni_intro [l10, l11]
l13: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ csn z = w $ by eq_sym [l5]
l14: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ z ∊ csn z $ by csn_intro_var
l15: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ z ∊ w $ by welc_eq [l13, l14]
l16: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ z ∊ ⋃ ⋃ R $ by cuni_intro [l15, l12]
l17: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R ⇒ z ∊ ⋃ ⋃ R $ by isset_elim [l4, l16]
l18: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R ⇒ z ∊ ⋃ ⋃ R $ by wcel_elim [l2, l17]
l19: $ G , z ∊ cdm R ⇒ z ∊ ⋃ ⋃ R $ by cdm_elim [l1, l18]
l20: $ G ⇒ cdm R ⊆ ⋃ ⋃ R $ by subset_intro [l19]
l21: $ G ⇒ isset (⋃ R) $ by cuni_set [#1]
l22: $ G ⇒ isset (⋃ ⋃ R) $ by cuni_set [l21]
l23: $ G ⇒ isset (cdm R) $ by subset_isset [l22, l20]

crn_set
-------
l1: $ G , z ∊ crn R ⇒ z ∊ crn R $ by ax
l2: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R ⇒ ⟨ u , z ⟩ ∈ R $ by ax
l3: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R ⇒ isset (cpr u z) $ by ax_pair
l5: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ w = cpr u z $ by ax
l6: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ w = csn u ∨ w = cpr u z $ by or_intro_r [l5]
l7: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ w ∊ cpr (csn u) (cpr u z) $ by cpr_intro [l6]
l8: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ k = ⟨ u , z ⟩ $ by ax
l9: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ ⟨ u , z ⟩ = k $ by eq_sym [l8]
l10: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ w ∊ k $ by welc_eq [l9, l7]
l11: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ k ∊ R $ by ax
l12: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ w ∊ ⋃ R $ by cuni_intro [l10, l11]
l13: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ cpr u z = w $ by eq_sym [l5]
l14: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ z ∊ cpr u z $ by cpr_intro_r
l15: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ z ∊ w $ by welc_eq [l13, l14]
l16: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ z ∊ ⋃ ⋃ R $ by cuni_intro [l15, l12]
l17: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R ⇒ z ∊ ⋃ ⋃ R $ by isset_elim [l3, l16]
l18: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R ⇒ z ∊ ⋃ ⋃ R $ by wcel_elim [l2, l17]
l19: $ G , z ∊ crn R ⇒ z ∊ ⋃ ⋃ R $ by crn_elim [l1, l18]
l20: $ G ⇒ crn R ⊆ ⋃ ⋃ R $ by subset_intro [l19]
l21: $ G ⇒ isset (⋃ R) $ by cuni_set [#1]
l22: $ G ⇒ isset (⋃ ⋃ R) $ by cuni_set [l21]
l23: $ G ⇒ isset (crn R) $ by subset_isset [l22, l20]

cdm_congr
---------
l0: $ ⟨ u , v ⟩ ≐ ⟨ u , v ⟩ $ by ceqt_refl
l1: $ (⟨ u , v ⟩ ∈ R) ⟺ (⟨ u , v ⟩ ∈ S) $ by wcel_congr [l0, #1]
l2: $ ∃ v (⟨ u , v ⟩ ∈ R) ⟺ ∃ v (⟨ u , v ⟩ ∈ S) $ by ex_congr [l1]
l3: $ {u | ∃ v (⟨ u , v ⟩ ∈ R)} ≐ {u | ∃ v (⟨ u , v ⟩ ∈ S)} $ by cab_congr [l2]

crn_congr
---------
l0: $ ⟨ u , v ⟩ ≐ ⟨ u , v ⟩ $ by ceqt_refl
l1: $ (⟨ u , v ⟩ ∈ R) ⟺ (⟨ u , v ⟩ ∈ S) $ by wcel_congr [l0, #1]
l2: $ ∃ u (⟨ u , v ⟩ ∈ R) ⟺ ∃ u (⟨ u , v ⟩ ∈ S) $ by ex_congr [l1]
l3: $ {v | ∃ u (⟨ u , v ⟩ ∈ R)} ≐ {v | ∃ u (⟨ u , v ⟩ ∈ S)} $ by cab_congr [l2]

cdm_eq
------
l1: $ G ⇒ R ⊆ S $ by eq_subset [#1]
l2: $ G ⇒ S = R $ by eq_sym [#1]
l3: $ G ⇒ S ⊆ R $ by eq_subset [l2]
l4: $ G ⇒ cdm R ⊆ cdm S $ by cdm_mono [l1]
l5: $ G ⇒ cdm S ⊆ cdm R $ by cdm_mono [l3]
l6: $ G ⇒ cdm R = cdm S $ by subset_antisym [l4, l5]

crn_eq
------
l1: $ G ⇒ R ⊆ S $ by eq_subset [#1]
l2: $ G ⇒ S = R $ by eq_sym [#1]
l3: $ G ⇒ S ⊆ R $ by eq_subset [l2]
l4: $ G ⇒ crn R ⊆ crn S $ by crn_mono [l1]
l5: $ G ⇒ crn S ⊆ crn R $ by crn_mono [l3]
l6: $ G ⇒ crn R = crn S $ by subset_antisym [l4, l5]

sb_c_cdm
--------
l1: $ (⟦ x / t ⟧ {u | ∃ v (⟨ u , v ⟩ ∈ R)}) ≐ {u | ∃ v (⟨ u , v ⟩ ∈ (⟦ x / t ⟧ R))} $ by ceqt_refl

sb_c_crn
--------
l1: $ (⟦ x / t ⟧ {v | ∃ u (⟨ u , v ⟩ ∈ R)}) ≐ {v | ∃ u (⟨ u , v ⟩ ∈ (⟦ x / t ⟧ R))} $ by ceqt_refl

ccnv_intro
----------
l1: $ G ⇒ isset b $ by isset_var
l2: $ G ⇒ isset a $ by isset_var
l3: $ G ⇒ isset ⟨ b , a ⟩ $ by opair_set [l1, l2]
l4: $ G , u = ⟨ b , a ⟩ ⇒ u = ⟨ b , a ⟩ $ by ax
l5: $ G , u = ⟨ b , a ⟩ ⇒ ⟨ a , b ⟩ ∈ R $ by weaken [#1]
l6: $ G , u = ⟨ b , a ⟩ ⇒ u = ⟨ b , a ⟩ ∧ ⟨ a , b ⟩ ∈ R $ by and_intro [l4, l5]
l7: $ G , u = ⟨ b , a ⟩ ⇒ ∃ y (u = ⟨ y , a ⟩ ∧ ⟨ a , y ⟩ ∈ R) $ by ex_intro (x := $ y $, t := $ b $, p := $ u = ⟨ y , a ⟩ ∧ ⟨ a , y ⟩ ∈ R $) [l6]
l8: $ G , u = ⟨ b , a ⟩ ⇒ ∃ x ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by ex_intro (x := $ x $, t := $ a $, p := $ ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $) [l7]
l9: $ G , u = ⟨ b , a ⟩ ⇒ u ∊ {z | ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R)} $ by cab_intro (x := $ z $, t := $ u $, p := $ ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $) [l8]
l10: $ G , u = ⟨ b , a ⟩ ⇒ ⟨ b , a ⟩ ∈ ccnv R $ by wcel_intro [l4, l9]
l11: $ G ⇒ ⟨ b , a ⟩ ∈ ccnv R $ by isset_elim [l3, l10]

ccnv_elim
---------
l1: $ u = ⟨ b , a ⟩ , u ∊ ccnv R ⇒ u ∊ ccnv R $ by ax
l2: $ u = ⟨ b , a ⟩ , u ∊ ccnv R ⇒ ∃ x ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [l1]
l3: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R $ by ax
l4: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ y , x ⟩ $ by and_elim_l [l3]
l5: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l3]
l6: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ b , a ⟩ $ by ax
l7: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ y , x ⟩ = u $ by eq_sym [l4]
l8: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ y , x ⟩ = ⟨ b , a ⟩ $ by eq_trans [l7, l6]
l9: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ y = b $ by opair_inj_l [l8]
l10: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ x = a $ by opair_inj_r [l8]
l11: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ = ⟨ a , b ⟩ $ by opair_eq [l10, l9]
l12: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ a , b ⟩ ∈ R $ by wcel_eq_l [l11, l5]
l13: $ u = ⟨ b , a ⟩ , ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l14: $ u = ⟨ b , a ⟩ , ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⇒ ⟨ a , b ⟩ ∈ R $ by ex_elim [l13, l12]
l15: $ u = ⟨ b , a ⟩ , u ∊ ccnv R ⇒ ⟨ a , b ⟩ ∈ R $ by ex_elim [l2, l14]
l16: $ G ⇒ ⟨ a , b ⟩ ∈ R $ by wcel_elim [#1, l15]

ccnv_rel
--------
l1: $ z ∊ ccnv R ⇒ z ∊ ccnv R $ by ax
l2: $ z ∊ ccnv R ⇒ ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [l1]
l3: $ z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R $ by ax
l4: $ z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ z = ⟨ y , x ⟩ $ by and_elim_l [l3]
l5: $ z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ ∃ v (z = ⟨ y , v ⟩) $ by ex_intro (x := $ v $, t := $ x $, p := $ z = ⟨ y , v ⟩ $) [l4]
l6: $ z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_intro (x := $ u $, t := $ y $, p := $ ∃ v (z = ⟨ u , v ⟩) $) [l5]
l7: $ ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l8: $ ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_elim [l7, l6]
l9: $ z ∊ ccnv R ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_elim [l2, l8]
l10: $ G , z ∊ ccnv R ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by weaken [l9]
