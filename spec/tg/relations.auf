l7: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ ⟨ x , y ⟩ ∈ U $ by wcel_eq_r [l5, l3]
l8: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ ⟨ y , z ⟩ ∈ S $ by wcel_eq_r [l6, l4]
l9: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ ⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S $ by and_intro [l7, l8]
l10: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ ∃ y (⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S) $ by ex_intro (x := $ y $, t := $ y $, p := $ ⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S $) [l9]
l11: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ a = ⟨ x , z ⟩ $ by ax
l12: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S) $ by and_intro [l11, l10]
l13: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ ∃ z (a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S)) $ by ex_intro (x := $ z $, t := $ z $, p := $ a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S) $) [l12]
l14: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ ∃ x ∃ z (a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S)) $ by ex_intro (x := $ x $, t := $ x $, p := $ ∃ z (a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S)) $) [l13]
l15: $ G , a = ⟨ x , z ⟩ , ⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R ⇒ a ∊ {w | ∃ x ∃ z (w = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S))} $ by cab_intro (x := $ w $, t := $ a $, p := $ ∃ x ∃ z (w = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ U ∧ ⟨ y , z ⟩ ∈ S)) $) [l14]
l16: $ G , a = ⟨ x , z ⟩ , ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) ⇒ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) $ by ax
l17: $ G , a = ⟨ x , z ⟩ , ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) ⇒ a ∊ ccom S U $ by ex_elim [l16, l15]
l18: $ G , a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) ⇒ a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) $ by ax
l19: $ G , a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) ⇒ a = ⟨ x , z ⟩ $ by and_elim_l [l18]
l20: $ G , a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) ⇒ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) $ by and_elim_r [l18]
l21: $ G , a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) , ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) ⇒ a ∊ ccom S U $ by cut [l19, l17]
l22: $ G , a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R) ⇒ a ∊ ccom S U $ by cut [l20, l21]
l23: $ G , ∃ z (a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R)) ⇒ ∃ z (a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R)) $ by ax
l24: $ G , ∃ z (a = ⟨ x , z ⟩ ∧ ∃ y (⟨ x , y ⟩ ∈ T ∧ ⟨ y , z ⟩ ∈ R)) ⇒ a ∊ ccom S U $ by ex_elim [l23, l22]
l25: $ G ⇒ a ∊ ccom S U $ by ex_elim [l1, l24]

ccom_eq
-------
l1: $ G , z ∊ ccom R T ⇒ z ∊ ccom R T $ by ax
l2: $ G , z ∊ ccom R T ⇒ R = S $ by weaken [#1]
l3: $ G , z ∊ ccom R T ⇒ T = U $ by weaken [#2]
l4: $ G , z ∊ ccom R T ⇒ z ∊ ccom S U $ by welc_ccom_eq [l2, l3, l1]
l5: $ G ⇒ S = R $ by eq_sym [#1]
l6: $ G ⇒ U = T $ by eq_sym [#2]
l7: $ G , z ∊ ccom S U ⇒ z ∊ ccom S U $ by ax
l8: $ G , z ∊ ccom S U ⇒ S = R $ by weaken [l5]
l9: $ G , z ∊ ccom S U ⇒ U = T $ by weaken [l6]
l10: $ G , z ∊ ccom S U ⇒ z ∊ ccom R T $ by welc_ccom_eq [l8, l9, l7]
l11: $ G ⇒ ccom R T = ccom S U $ by eq_intro [l4, l10]

sb_c_ccom
---------
l1: $ (⟦ x / t ⟧ {w | ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ ∃ y (⟨ u , y ⟩ ∈ S ∧ ⟨ y , v ⟩ ∈ R))}) ≐ {w | ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ ∃ y (⟨ u , y ⟩ ∈ (⟦ x / t ⟧ S) ∧ ⟨ y , v ⟩ ∈ (⟦ x / t ⟧ R)))} $ by ceqt_refl

cres_intro
----------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ G ⇒ isset ⟨ a , b ⟩ $ by opair_set [l1, l2]
l4: $ G , u = ⟨ a , b ⟩ ⇒ u = ⟨ a , b ⟩ $ by ax
l5: $ G , u = ⟨ a , b ⟩ ⇒ a ∊ A $ by weaken [#1]
l6: $ G , u = ⟨ a , b ⟩ ⇒ ⟨ a , b ⟩ ∈ R $ by weaken [#2]
l7: $ G , u = ⟨ a , b ⟩ ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by and_intro [l5, l6]
l8: $ G , u = ⟨ a , b ⟩ ⇒ u = ⟨ a , b ⟩ ∧ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by and_intro [l4, l7]
l9: $ G , u = ⟨ a , b ⟩ ⇒ ∃ y (u = ⟨ a , y ⟩ ∧ a ∊ A ∧ ⟨ a , y ⟩ ∈ R) $ by ex_intro (x := $ y $, t := $ b $, p := $ u = ⟨ a , y ⟩ ∧ a ∊ A ∧ ⟨ a , y ⟩ ∈ R $) [l8]
l10: $ G , u = ⟨ a , b ⟩ ⇒ ∃ x ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by ex_intro (x := $ x $, t := $ a $, p := $ ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $) [l9]
l11: $ G , u = ⟨ a , b ⟩ ⇒ u ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R)} $ by cab_intro (x := $ z $, t := $ u $, p := $ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $) [l10]
l12: $ G , u = ⟨ a , b ⟩ ⇒ ⟨ a , b ⟩ ∈ cres R A $ by wcel_intro [l4, l11]
l13: $ G ⇒ ⟨ a , b ⟩ ∈ cres R A $ by isset_elim [l3, l12]

cres_elim
---------
l1: $ u = ⟨ a , b ⟩ , u ∊ cres R A ⇒ u ∊ cres R A $ by ax
l2: $ u = ⟨ a , b ⟩ , u ∊ cres R A ⇒ ∃ x ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [l1]
l3: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by ax
l4: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ x , y ⟩ $ by and_elim_l [l3]
l5: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l3]
l6: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ x ∊ A $ by and_elim_l [l5]
l7: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l5]
l8: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ a , b ⟩ $ by ax
l9: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ = u $ by eq_sym [l4]
l10: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [l9, l8]
l11: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ x = a $ by opair_inj_l [l10]
l12: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ a ∊ A $ by welc_eq_set [l11, l6]
l13: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ a , b ⟩ ∈ R $ by wcel_eq_l [l10, l7]
l14: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by and_intro [l12, l13]
l15: $ u = ⟨ a , b ⟩ , ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l16: $ u = ⟨ a , b ⟩ , ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by ex_elim [l15, l14]
l17: $ u = ⟨ a , b ⟩ , u ∊ cres R A ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by ex_elim [l2, l16]
l18: $ G ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by wcel_elim [#1, l17]

cres_rel
--------
l1: $ z ∊ cres R A ⇒ z ∊ cres R A $ by ax
l2: $ z ∊ cres R A ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [l1]
l3: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by ax
l4: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ z = ⟨ x , y ⟩ $ by and_elim_l [l3]
l5: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ∃ v (z = ⟨ x , v ⟩) $ by ex_intro (x := $ v $, t := $ y $, p := $ z = ⟨ x , v ⟩ $) [l4]
l6: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_intro (x := $ u $, t := $ x $, p := $ ∃ v (z = ⟨ u , v ⟩) $) [l5]
l7: $ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l8: $ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_elim [l7, l6]
l9: $ z ∊ cres R A ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_elim [l2, l8]
l10: $ G , z ∊ cres R A ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by weaken [l9]
l11: $ G ⇒ rel (cres R A) $ by rel_intro [l10]

cres_subset
-----------
l1: $ z ∊ cres R A ⇒ z ∊ cres R A $ by ax
l2: $ z ∊ cres R A ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [l1]
l3: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by ax
l4: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ z = ⟨ x , y ⟩ $ by and_elim_l [l3]
l5: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l3]
l6: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l5]
l7: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ = z $ by eq_sym [l4]
l8: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ z ∈ R $ by wcel_eq_l [l7, l6]
l9: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ z ∊ R $ by wcel_welc [l8]
l10: $ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l11: $ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ z ∊ R $ by ex_elim [l10, l9]
l12: $ z ∊ cres R A ⇒ z ∊ R $ by ex_elim [l2, l11]
l13: $ G , z ∊ cres R A ⇒ z ∊ R $ by weaken [l12]
l14: $ G ⇒ cres R A ⊆ R $ by subset_intro [l13]

cres_cdm
--------
l1: $ G , z ∊ cdm (cres R A) ⇒ z ∊ cdm (cres R A) $ by ax
l2: $ G , ⟨ z , y ⟩ ∈ cres R A ⇒ ⟨ z , y ⟩ ∈ cres R A $ by ax
l3: $ G , ⟨ z , y ⟩ ∈ cres R A ⇒ z ∊ A ∧ ⟨ z , y ⟩ ∈ R $ by cres_elim [l2]
l4: $ G , ⟨ z , y ⟩ ∈ cres R A ⇒ z ∊ A $ by and_elim_l [l3]
l5: $ G , z ∊ cdm (cres R A) ⇒ z ∊ A $ by cdm_elim [l1, l4]
l6: $ G ⇒ cdm (cres R A) ⊆ A $ by subset_intro [l5]

lemma x1_cres_sub_img (G: hyps) (F A: class): $ G ⇒ cres F A ⊆ A × img F A $
----
l1: $ z ∊ cres F A ⇒ z ∊ cres F A $ by ax
l2: $ z ∊ cres F A ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F) $ by cab_elim [l1]
l3: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F ⇒ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F $ by ax
l4: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F ⇒ z = ⟨ x , y ⟩ $ by and_elim_l [l3]
l5: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F ⇒ x ∊ A ∧ ⟨ x , y ⟩ ∈ F $ by and_elim_r [l3]
l6: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F ⇒ x ∊ A $ by and_elim_l [l5]
l7: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F ⇒ ⟨ x , y ⟩ ∈ F $ by and_elim_r [l5]
l8: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F ⇒ y ∊ img F A $ by img_intro [l6, l7]
l9: $ z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F ⇒ z ∊ A × img F A $ by cxp_intro_eq [l4, l6, l8]
l10: $ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F) ⇒ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F) $ by ax
l11: $ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ F) ⇒ z ∊ A × img F A $ by ex_elim [l10, l9]
l12: $ z ∊ cres F A ⇒ z ∊ A × img F A $ by ex_elim [l2, l11]
l13: $ G , z ∊ cres F A ⇒ z ∊ A × img F A $ by weaken [l12]
l14: $ G ⇒ cres F A ⊆ A × img F A $ by subset_intro [l13]

cres_set
--------
l1: $ G ⇒ isset (img F A) $ by img_set [#1, #2]
l2: $ G ⇒ isset (A × img F A) $ by cxp_set [#2, l1]
l3: $ G ⇒ cres F A ⊆ A × img F A $ by x1_cres_sub_img
l4: $ G ⇒ isset (cres F A) $ by subset_isset [l2, l3]

cres_congr
----------
l0: $ ⟨ x , y ⟩ ≐ ⟨ x , y ⟩ $ by ceqt_refl
l1: $ (⟨ x , y ⟩ ∈ R) ⟺ (⟨ x , y ⟩ ∈ S) $ by wcel_congr [l0, #1]
l2: $ seqt x x $ by seqt_refl
l3: $ (x ∊ A) ⟺ (x ∊ B) $ by welc_congr [l2, #2]
l4: $ (x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⟺ (x ∊ B ∧ ⟨ x , y ⟩ ∈ S) $ by and_congr [l3, l1]
l5: $ (z = ⟨ x , y ⟩) ⟺ (z = ⟨ x , y ⟩) $ by iff_refl
l6: $ (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⟺ (z = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S) $ by and_congr [l5, l4]
l7: $ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⟺ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S) $ by ex_congr [l6]
l8: $ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⟺ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S) $ by ex_congr [l7]
l9: $ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R)} ≐ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S)} $ by cab_congr [l8]

welc_cres_eq
------------
l1: $ G ⇒ ∃ x ∃ y (a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [#3]
l2: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by ax
l3: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ a = ⟨ x , y ⟩ $ by and_elim_l [l2]
l4: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l2]
l5: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ x ∊ A $ by and_elim_l [l4]
l6: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l4]
l7: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ A = B $ by weaken [#2]
l8: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ R = S $ by weaken [#1]
l9: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ x ∊ B $ by welc_eq [l7, l5]
l10: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ ∈ S $ by wcel_eq_r [l8, l6]
l11: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ x ∊ B ∧ ⟨ x , y ⟩ ∈ S $ by and_intro [l9, l10]
l12: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ a = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S $ by and_intro [l3, l11]
l13: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ∃ y (a = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S) $ by ex_intro (x := $ y $, t := $ y $, p := $ a = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S $) [l12]
l14: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ ∃ x ∃ y (a = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S) $ by ex_intro (x := $ x $, t := $ x $, p := $ ∃ y (a = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S) $) [l13]
l15: $ G , a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ a ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S)} $ by cab_intro (x := $ z $, t := $ a $, p := $ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ B ∧ ⟨ x , y ⟩ ∈ S) $) [l14]
l16: $ G , ∃ y (a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l17: $ G , ∃ y (a = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ a ∊ cres S B $ by ex_elim [l16, l15]
l18: $ G ⇒ a ∊ cres S B $ by ex_elim [l1, l17]

cres_eq
-------
l1: $ G , z ∊ cres R A ⇒ z ∊ cres R A $ by ax
l2: $ G , z ∊ cres R A ⇒ R = S $ by weaken [#1]
l3: $ G , z ∊ cres R A ⇒ A = B $ by weaken [#2]
l4: $ G , z ∊ cres R A ⇒ z ∊ cres S B $ by welc_cres_eq [l2, l3, l1]
l5: $ G ⇒ S = R $ by eq_sym [#1]
l6: $ G ⇒ B = A $ by eq_sym [#2]
l7: $ G , z ∊ cres S B ⇒ z ∊ cres S B $ by ax
l8: $ G , z ∊ cres S B ⇒ S = R $ by weaken [l5]
l9: $ G , z ∊ cres S B ⇒ B = A $ by weaken [l6]
l10: $ G , z ∊ cres S B ⇒ z ∊ cres R A $ by welc_cres_eq [l8, l9, l7]
l11: $ G ⇒ cres R A = cres S B $ by eq_intro [l4, l10]

sb_c_cres
---------
l1: $ (⟦ x / t ⟧ {z | ∃ u ∃ v (z = ⟨ u , v ⟩ ∧ u ∊ A ∧ ⟨ u , v ⟩ ∈ R)}) ≐ {z | ∃ u ∃ v (z = ⟨ u , v ⟩ ∧ u ∊ (⟦ x / t ⟧ A) ∧ ⟨ u , v ⟩ ∈ (⟦ x / t ⟧ R))} $ by ceqt_refl

functional_subset
-----------------
l1: $ G , ⟨ x , y ⟩ ∈ F , ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , y ⟩ ∈ F $ by ax
l2: $ G , ⟨ x , y ⟩ ∈ F , ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , z ⟩ ∈ F $ by ax
l3: $ G , ⟨ x , y ⟩ ∈ F , ⟨ x , z ⟩ ∈ F ⇒ F ⊆ H $ by weaken [#2]
l4: $ G , ⟨ x , y ⟩ ∈ F , ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , y ⟩ ∈ H $ by wcel_subset [l3, l1]
l5: $ G , ⟨ x , y ⟩ ∈ F , ⟨ x , z ⟩ ∈ F ⇒ ⟨ x , z ⟩ ∈ H $ by wcel_subset [l3, l2]
l6: $ G , ⟨ x , y ⟩ ∈ F , ⟨ x , z ⟩ ∈ F ⇒ functional H $ by weaken [#1]
l7: $ G , ⟨ x , y ⟩ ∈ F , ⟨ x , z ⟩ ∈ F ⇒ y = z $ by functional_elim [l6, l4, l5]
l8: $ G ⇒ functional F $ by functional_intro [l7]

functional_cres
---------------
l1: $ G ⇒ cres F A ⊆ F $ by cres_subset
l2: $ G ⇒ functional (cres F A) $ by functional_subset [#1, l1]

fn_into_intro
-------------
l1: $ G ⇒ x ∊ A → ∃ y (y ∊ B ∧ ⟨ x , y ⟩ ∈ F) $ by imp_intro [#2]
l2: $ G ⇒ ∀ x (x ∊ A → ∃ y (y ∊ B ∧ ⟨ x , y ⟩ ∈ F)) $ by all_intro [l1]
l3: $ G ⇒ functional F ∧ ∀ x (x ∊ A → ∃ y (y ∊ B ∧ ⟨ x , y ⟩ ∈ F)) $ by and_intro [#1, l2]

fn_into_functional
------------------
l1: $ G ⇒ functional F ∧ ∀ x (x ∊ A → ∃ y (y ∊ B ∧ ⟨ x , y ⟩ ∈ F)) $ by weaken [#1]
l2: $ G ⇒ functional F $ by and_elim_l [l1]

fn_into_elim
------------
l0: $ G ⇒ functional F ∧ ∀ x (x ∊ A → ∃ y (y ∊ B ∧ ⟨ x , y ⟩ ∈ F)) $ by weaken [#1]
l1: $ G ⇒ ∀ x (x ∊ A → ∃ y (y ∊ B ∧ ⟨ x , y ⟩ ∈ F)) $ by and_elim_r [l0]
l2: $ G ⇒ a ∊ A → ∃ y (y ∊ B ∧ ⟨ a , y ⟩ ∈ F) $ by all_elim [l1]
l3: $ G ⇒ ∃ y (y ∊ B ∧ ⟨ a , y ⟩ ∈ F) $ by imp_elim [l2, #2]
l4: $ H , y ∊ B ⇒ ⟨ a , y ⟩ ∈ F → c $ by imp_intro [#3]
l5: $ H ⇒ y ∊ B → ⟨ a , y ⟩ ∈ F → c $ by imp_intro [l4]
l6: $ H , y ∊ B ∧ ⟨ a , y ⟩ ∈ F ⇒ y ∊ B ∧ ⟨ a , y ⟩ ∈ F $ by ax
l7: $ H , y ∊ B ∧ ⟨ a , y ⟩ ∈ F ⇒ y ∊ B $ by and_elim_l [l6]
l8: $ H , y ∊ B ∧ ⟨ a , y ⟩ ∈ F ⇒ ⟨ a , y ⟩ ∈ F $ by and_elim_r [l6]
l9: $ H , y ∊ B ∧ ⟨ a , y ⟩ ∈ F ⇒ y ∊ B → ⟨ a , y ⟩ ∈ F → c $ by weaken [l5]
l10: $ H , y ∊ B ∧ ⟨ a , y ⟩ ∈ F ⇒ ⟨ a , y ⟩ ∈ F → c $ by imp_elim [l9, l7]
l11: $ H , y ∊ B ∧ ⟨ a , y ⟩ ∈ F ⇒ c $ by imp_elim [l10, l8]
l12: $ G , H ⇒ c $ by ex_elim [l3, l11]

fn_into_cdm
-----------
l1: $ G , z ∊ A ⇒ fn_into F A B $ by weaken [#1]
l2: $ G , z ∊ A ⇒ z ∊ A $ by ax
l3: $ G , y ∊ B , ⟨ z , y ⟩ ∈ F ⇒ ⟨ z , y ⟩ ∈ F $ by ax
l4: $ G , y ∊ B , ⟨ z , y ⟩ ∈ F ⇒ z ∊ cdm F $ by cdm_intro [l3]
l5: $ G , z ∊ A ⇒ z ∊ cdm F $ by fn_into_elim [l1, l2, l4]
l6: $ G ⇒ A ⊆ cdm F $ by subset_intro [l5]

ap_intro
--------
l1: $ G ⇒ b ∊ {y | ⟨ A , y ⟩ ∈ F} $ by cab_intro (x := $ y $, t := $ b $, p := $ ⟨ A , y ⟩ ∈ F $) [#1]

ap_elim
-------
l1: $ G ⇒ b ∊ {y | ⟨ A , y ⟩ ∈ F} $ by weaken [#1]
l2: $ G ⇒ ⟨ A , b ⟩ ∈ F $ by cab_elim (x := $ y $, t := $ b $, p := $ ⟨ A , y ⟩ ∈ F $) [l1]

ap_subset_crn
-------------
l1: $ G , z ∊ ap F a ⇒ z ∊ ap F a $ by ax
l2: $ G , z ∊ ap F a ⇒ ⟨ a , z ⟩ ∈ F $ by ap_elim [l1]
l3: $ G , z ∊ ap F a ⇒ z ∊ crn F $ by crn_intro [l2]
l4: $ G ⇒ ap F a ⊆ crn F $ by subset_intro [l3]

ap_set
------
l1: $ G ⇒ isset (crn F) $ by crn_set [#1]
l2: $ G ⇒ ap F a ⊆ crn F $ by ap_subset_crn
l3: $ G ⇒ isset (ap F a) $ by subset_isset [l1, l2]

ap_functional_set
-----------------
l1: $ G ⇒ (∃ y (⟨ a , y ⟩ ∈ F)) ∨ ¬ (∃ y (⟨ a , y ⟩ ∈ F)) $ by excluded_middle
l2: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ z ∊ ap F a $ by ax
l3: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ ⟨ a , z ⟩ ∈ F $ by ap_elim [l2]
l4: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ ⟨ a , y ⟩ ∈ F $ by ax
l5: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ functional F $ by weaken [#1]
l6: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ y = z $ by functional_elim [l5, l4, l3]
l7: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ z = y $ by eq_sym [l6]
l8: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ z ∊ csn y $ by csn_intro [l7]
l9: $ G , ⟨ a , y ⟩ ∈ F ⇒ ap F a ⊆ csn y $ by subset_intro [l8]
l10: $ G , ⟨ a , y ⟩ ∈ F ⇒ isset y $ by isset_var
l11: $ G , ⟨ a , y ⟩ ∈ F ⇒ isset (csn y) $ by csn_set [l10]
l12: $ G , ⟨ a , y ⟩ ∈ F ⇒ isset (ap F a) $ by subset_isset [l11, l9]
l13: $ G , ∃ y (⟨ a , y ⟩ ∈ F) ⇒ ∃ y (⟨ a , y ⟩ ∈ F) $ by ax
l14: $ G , ∃ y (⟨ a , y ⟩ ∈ F) ⇒ isset (ap F a) $ by ex_elim [l13, l12]
l15: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) , z ∊ ap F a ⇒ z ∊ ap F a $ by ax
l16: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) , z ∊ ap F a ⇒ ⟨ a , z ⟩ ∈ F $ by ap_elim [l15]
l17: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) , z ∊ ap F a ⇒ ∃ y (⟨ a , y ⟩ ∈ F) $ by ex_intro (x := $ y $, t := $ z $, p := $ ⟨ a , y ⟩ ∈ F $) [l16]
l18: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) , z ∊ ap F a ⇒ ¬ (∃ y (⟨ a , y ⟩ ∈ F)) $ by ax
l19: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) , z ∊ ap F a ⇒ ⊥ $ by not_elim [l18, l17]
l20: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) ⇒ ap F a = ∅ $ by empty_eq_intro [l19]
l21: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) ⇒ ∅ = ap F a $ by eq_sym [l20]
l22: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) ⇒ isset ∅ $ by ax_empty
l23: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) ⇒ isset (ap F a) $ by isset_eq [l21, l22]
l24: $ G ⇒ isset (ap F a) $ by or_elim [l1, l14, l23]

ap_mono
-------
l1: $ G , z ∊ ap F A ⇒ z ∊ ap F A $ by ax
l2: $ G , z ∊ ap F A ⇒ ⟨ A , z ⟩ ∈ F $ by ap_elim [l1]
l3: $ G , z ∊ ap F A ⇒ F ⊆ H $ by weaken [#1]
l4: $ G , z ∊ ap F A ⇒ ⟨ A , z ⟩ ∈ H $ by wcel_subset [l3, l2]
l5: $ G , z ∊ ap F A ⇒ z ∊ ap H A $ by ap_intro [l4]
l6: $ G ⇒ ap F A ⊆ ap H A $ by subset_intro [l5]

ap_congr
--------
l0: $ cv y ≐ cv y $ by ceqt_refl
l1: $ ⟨ A , y ⟩ ≐ ⟨ B , y ⟩ $ by opair_congr [#2, l0]
l2: $ (⟨ A , y ⟩ ∈ F) ⟺ (⟨ B , y ⟩ ∈ H) $ by wcel_congr [l1, #1]
l3: $ {y | ⟨ A , y ⟩ ∈ F} ≐ {y | ⟨ B , y ⟩ ∈ H} $ by cab_congr [l2]

welc_ap_eq
----------
l1: $ G ⇒ ⟨ A , b ⟩ ∈ F $ by ap_elim [#3]
l2: $ G ⇒ b = b $ by eq_refl
l3: $ G ⇒ ⟨ A , b ⟩ = ⟨ B , b ⟩ $ by opair_eq [#2, l2]
l4: $ G ⇒ ⟨ B , b ⟩ ∈ F $ by wcel_eq_l [l3, l1]
l5: $ G ⇒ ⟨ B , b ⟩ ∈ H $ by wcel_eq_r [#1, l4]
l6: $ G ⇒ b ∊ ap H B $ by ap_intro [l5]

ap_eq
-----
l1: $ G , z ∊ ap F A ⇒ z ∊ ap F A $ by ax
l2: $ G , z ∊ ap F A ⇒ F = H $ by weaken [#1]
l3: $ G , z ∊ ap F A ⇒ A = B $ by weaken [#2]
l4: $ G , z ∊ ap F A ⇒ z ∊ ap H B $ by welc_ap_eq [l2, l3, l1]
l5: $ G ⇒ H = F $ by eq_sym [#1]
l6: $ G ⇒ B = A $ by eq_sym [#2]
l7: $ G , z ∊ ap H B ⇒ z ∊ ap H B $ by ax
l8: $ G , z ∊ ap H B ⇒ H = F $ by weaken [l5]
l9: $ G , z ∊ ap H B ⇒ B = A $ by weaken [l6]
l10: $ G , z ∊ ap H B ⇒ z ∊ ap F A $ by welc_ap_eq [l8, l9, l7]
l11: $ G ⇒ ap F A = ap H B $ by eq_intro [l4, l10]

sb_c_ap
-------
l1: $ (⟦ x / t ⟧ {y | ⟨ A , y ⟩ ∈ F}) ≐ {y | ⟨ ⟦ x / t ⟧ A , y ⟩ ∈ (⟦ x / t ⟧ F)} $ by ceqt_refl

lam_intro
---------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ G ⇒ isset ⟨ a , b ⟩ $ by opair_set [l1, l2]
l4: $ G , k = ⟨ a , b ⟩ ⇒ k = ⟨ a , b ⟩ $ by ax
l5: $ G , k = ⟨ a , b ⟩ ⇒ a ∊ A $ by weaken [#1]
l6: $ G , k = ⟨ a , b ⟩ ⇒ b ∊ (⟦ x / a ⟧ B) $ by weaken [#2]
l7: $ G , k = ⟨ a , b ⟩ ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by and_intro [l5, l6]
l8: $ G , k = ⟨ a , b ⟩ ⇒ k = ⟨ a , b ⟩ ∧ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by and_intro [l4, l7]
l9: $ G , k = ⟨ a , b ⟩ ⇒ ∃ y (k = ⟨ a , y ⟩ ∧ a ∊ A ∧ y ∊ (⟦ x / a ⟧ B)) $ by ex_intro (x := $ y $, t := $ b $, p := $ k = ⟨ a , y ⟩ ∧ a ∊ A ∧ y ∊ (⟦ x / a ⟧ B) $) [l8]
l10: $ G , k = ⟨ a , b ⟩ ⇒ ∃ x ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $ by ex_intro (x := $ x $, t := $ a $, p := $ ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $) [l9]
l11: $ G , k = ⟨ a , b ⟩ ⇒ k ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)} $ by cab_intro (x := $ z $, t := $ k $, p := $ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $) [l10]
l12: $ G , k = ⟨ a , b ⟩ ⇒ ⟨ a , b ⟩ ∈ lam x A B $ by wcel_intro [l4, l11]
l13: $ G ⇒ ⟨ a , b ⟩ ∈ lam x A B $ by isset_elim [l3, l12]

lam_elim
--------
l1: $ G , k = ⟨ a , b ⟩ , k ∊ lam x A B ⇒ k ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)} $ by ax
l2: $ G , k = ⟨ a , b ⟩ , k ∊ lam x A B ⇒ ∃ x ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $ by cab_elim (x := $ z $, t := $ k $, p := $ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $) [l1]
l2a: $ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ⟺ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by ex_alpha
l2b: $ G , k = ⟨ a , b ⟩ , k ∊ lam x A B ⇒ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ↔ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by weaken [l2a]
l2c: $ G , k = ⟨ a , b ⟩ , k ∊ lam x A B ⇒ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by bi_elim_l [l2b, l2]
l3: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) $ by ax
l4: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ k = ⟨ u , y ⟩ $ by and_elim_l [l3]
l5: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) $ by and_elim_r [l3]
l6: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by and_elim_l [l5]
l7: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ y ∊ (⟦ x / u ⟧ B) $ by and_elim_r [l5]
l8: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ k = ⟨ a , b ⟩ $ by ax
l9: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ ⟨ u , y ⟩ = k $ by eq_sym [l4]
l10: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ ⟨ u , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [l9, l8]
l11: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ u = a $ by opair_inj_l [l10]
l12: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ y = b $ by opair_inj_r [l10]
l13: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ a ∊ A $ by welc_eq_set [l11, l6]
l14: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ u ∊ {x | y ∊ B} $ by cab_intro (x := $ x $, t := $ u $, p := $ y ∊ B $) [l7]
l15: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ a ∊ {x | y ∊ B} $ by welc_eq_set [l11, l14]
l16: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ y ∊ (⟦ x / a ⟧ B) $ by cab_elim (x := $ x $, t := $ a $, p := $ y ∊ B $) [l15]
l17: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ b ∊ (⟦ x / a ⟧ B) $ by welc_eq_set [l12, l16]
l18: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by and_intro [l13, l17]
l19a: $ k = ⟨ a , b ⟩ , ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by ax
l19: $ k = ⟨ a , b ⟩ , ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by ex_elim [l19a, l18]
l20: $ G , k = ⟨ a , b ⟩ , k ∊ lam x A B ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by ex_elim [l2c, l19]
l21: $ G ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by wcel_elim [#1, l20]

--| Elimination of membership in a trace: a member is a pair `⟨ u , v ⟩` with
--| `u ∊ A` and `v ∊ ⟦ x / u ⟧ B`.
lam_elim_mem
------------
l1: $ G ⇒ c ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)} $ by weaken [#1]
l2: $ G ⇒ ∃ x ∃ y (c = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $ by cab_elim (x := $ z $, t := $ c $, p := $ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $) [l1]
l3: $ (∃ x ∃ y (c = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ⟺ ∃ u ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by ex_alpha
l4: $ G ⇒ (∃ x ∃ y (c = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ↔ ∃ u ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by weaken [l3]
l5: $ G ⇒ ∃ u ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by bi_elim_l [l4, l2]
l6: $ (∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B))) ⟺ ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B)) $ by ex_alpha
l7: $ H , ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by ax
l8: $ H , ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ (∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B))) ↔ ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B)) $ by weaken [l6]
l9: $ H , ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B)) $ by bi_elim_l [l8, l7]
l10: $ H , c = ⟨ u , v ⟩ , u ∊ A ⇒ v ∊ (⟦ x / u ⟧ B) → d $ by imp_intro [#2]
l11: $ H , c = ⟨ u , v ⟩ ⇒ u ∊ A → v ∊ (⟦ x / u ⟧ B) → d $ by imp_intro [l10]
l12: $ H ⇒ c = ⟨ u , v ⟩ → u ∊ A → v ∊ (⟦ x / u ⟧ B) → d $ by imp_intro [l11]
l13: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) $ by ax
l14: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ c = ⟨ u , v ⟩ $ by and_elim_l [l13]
l15: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) $ by and_elim_r [l13]
l16: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by and_elim_l [l15]
l17: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ B) $ by and_elim_r [l15]
l18: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ c = ⟨ u , v ⟩ → u ∊ A → v ∊ (⟦ x / u ⟧ B) → d $ by weaken [l12]
l19: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A → v ∊ (⟦ x / u ⟧ B) → d $ by imp_elim [l18, l14]
l20: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ B) → d $ by imp_elim [l19, l16]
l21: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ d $ by imp_elim [l20, l17]
l22: $ H , ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ d $ by ex_elim [l9, l21]
l23: $ G , H ⇒ d $ by ex_elim [l5, l22]

lam_rel
-------
l1: $ G , k ∊ lam x A B ⇒ k ∊ lam x A B $ by ax
l2: $ G , k ∊ lam x A B , k = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ k = ⟨ u , v ⟩ $ by ax
l3: $ G , k ∊ lam x A B , k = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ ∃ j (k = ⟨ u , j ⟩) $ by ex_intro (x := $ j $, t := $ v $, p := $ k = ⟨ u , j ⟩ $) [l2]
l4: $ G , k ∊ lam x A B , k = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ ∃ i ∃ j (k = ⟨ i , j ⟩) $ by ex_intro (x := $ i $, t := $ u $, p := $ ∃ j (k = ⟨ i , j ⟩) $) [l3]
l5: $ G , k ∊ lam x A B ⇒ ∃ i ∃ j (k = ⟨ i , j ⟩) $ by lam_elim_mem [l1, l4]
l6: $ G ⇒ rel (lam x A B) $ by rel_intro [l5]

lam_cdm
-------
l1: $ G , w ∊ cdm (lam x A B) ⇒ w ∊ cdm (lam x A B) $ by ax
l2: $ G , w ∊ cdm (lam x A B) , ⟨ w , v ⟩ ∈ lam x A B ⇒ ⟨ w , v ⟩ ∈ lam x A B $ by ax
l3: $ G , w ∊ cdm (lam x A B) , ⟨ w , v ⟩ ∈ lam x A B ⇒ w ∊ A ∧ v ∊ (⟦ x / w ⟧ B) $ by lam_elim [l2]
l4: $ G , w ∊ cdm (lam x A B) , ⟨ w , v ⟩ ∈ lam x A B ⇒ w ∊ A $ by and_elim_l [l3]
l5: $ G , w ∊ cdm (lam x A B) ⇒ w ∊ A $ by cdm_elim [l1, l4]
l6: $ G ⇒ cdm (lam x A B) ⊆ A $ by subset_intro [l5]

lam_ap
------
l1: $ G , w ∊ ap (lam x A B) a ⇒ w ∊ ap (lam x A B) a $ by ax
l2: $ G , w ∊ ap (lam x A B) a ⇒ ⟨ a , w ⟩ ∈ lam x A B $ by ap_elim [l1]
l3: $ G , w ∊ ap (lam x A B) a ⇒ a ∊ A ∧ w ∊ (⟦ x / a ⟧ B) $ by lam_elim [l2]
l4: $ G , w ∊ ap (lam x A B) a ⇒ w ∊ (⟦ x / a ⟧ B) $ by and_elim_r [l3]
l5: $ G , w ∊ (⟦ x / a ⟧ B) ⇒ w ∊ (⟦ x / a ⟧ B) $ by ax
l6: $ G , w ∊ (⟦ x / a ⟧ B) ⇒ a ∊ A $ by weaken [#1]
l7: $ G , w ∊ (⟦ x / a ⟧ B) ⇒ ⟨ a , w ⟩ ∈ lam x A B $ by lam_intro [l6, l5]
l8: $ G , w ∊ (⟦ x / a ⟧ B) ⇒ w ∊ ap (lam x A B) a $ by ap_intro [l7]
l9: $ G ⇒ ap (lam x A B) a = (⟦ x / a ⟧ B) $ by eq_intro [l4, l8]

--| The graph of the operation `x ↦ B`: replacement along it bounds a trace.
def r3_gr {x: set} (B: class x) (.w .y: set): class = $ {w | ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B)} $

lemma r3_gr_intro {x: set} (G: hyps x) (B: class x) (a b: set):
  $ G ⇒ b = (⟦ x / a ⟧ B) $ > $ G ⇒ ⟨ a , b ⟩ ∈ r3_gr x B $
----
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ G ⇒ isset ⟨ a , b ⟩ $ by opair_set [l1, l2]
l4: $ G , k = ⟨ a , b ⟩ ⇒ k = ⟨ a , b ⟩ $ by ax
l5: $ G , k = ⟨ a , b ⟩ ⇒ b = (⟦ x / a ⟧ B) $ by weaken [#1]
l6: $ G , k = ⟨ a , b ⟩ ⇒ k = ⟨ a , b ⟩ ∧ b = (⟦ x / a ⟧ B) $ by and_intro [l4, l5]
l7: $ G , k = ⟨ a , b ⟩ ⇒ ∃ y (k = ⟨ a , y ⟩ ∧ y = (⟦ x / a ⟧ B)) $ by ex_intro (x := $ y $, t := $ b $, p := $ k = ⟨ a , y ⟩ ∧ y = (⟦ x / a ⟧ B) $) [l6]
l8: $ G , k = ⟨ a , b ⟩ ⇒ ∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B) $ by ex_intro (x := $ x $, t := $ a $, p := $ ∃ y (k = ⟨ x , y ⟩ ∧ y = B) $) [l7]
l9: $ G , k = ⟨ a , b ⟩ ⇒ k ∊ {w | ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B)} $ by cab_intro (x := $ w $, t := $ k $, p := $ ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B) $) [l8]
l10: $ G , k = ⟨ a , b ⟩ ⇒ ⟨ a , b ⟩ ∈ r3_gr x B $ by wcel_intro [l4, l9]
l11: $ G ⇒ ⟨ a , b ⟩ ∈ r3_gr x B $ by isset_elim [l3, l10]

lemma r3_gr_elim {x: set} (G: hyps x) (B: class x) (a b: set):
  $ G ⇒ ⟨ a , b ⟩ ∈ r3_gr x B $ > $ G ⇒ b = (⟦ x / a ⟧ B) $
----
l1: $ G , k = ⟨ a , b ⟩ , k ∊ r3_gr x B ⇒ k ∊ {w | ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B)} $ by ax
l2: $ G , k = ⟨ a , b ⟩ , k ∊ r3_gr x B ⇒ ∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B) $ by cab_elim (x := $ w $, t := $ k $, p := $ ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B) $) [l1]
l3: $ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B)) ⟺ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by ex_alpha
l4: $ G , k = ⟨ a , b ⟩ , k ∊ r3_gr x B ⇒ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B)) ↔ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by weaken [l3]
l5: $ G , k = ⟨ a , b ⟩ , k ∊ r3_gr x B ⇒ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by bi_elim_l [l4, l2]
l6: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) $ by ax
l7: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ k = ⟨ u , y ⟩ $ by and_elim_l [l6]
l8: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ y = (⟦ x / u ⟧ B) $ by and_elim_r [l6]
l9: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ k = ⟨ a , b ⟩ $ by ax
l10: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ ⟨ a , b ⟩ = k $ by eq_sym [l9]
l11: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ ⟨ a , b ⟩ = ⟨ u , y ⟩ $ by eq_trans [l10, l7]
l12: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ a = u $ by opair_inj_l [l11]
l13: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ b = y $ by opair_inj_r [l11]
l14: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ u = a $ by eq_sym [l12]
l15: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ (⟦ x / u ⟧ B) = (⟦ x / a ⟧ B) $ by sb_c_eq [l14]
l16: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ b = (⟦ x / u ⟧ B) $ by eq_trans [l13, l8]
l17: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ b = (⟦ x / a ⟧ B) $ by eq_trans [l16, l15]
l18: $ G , k = ⟨ a , b ⟩ , ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) ⇒ ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by ax
l19: $ G , k = ⟨ a , b ⟩ , ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) ⇒ b = (⟦ x / a ⟧ B) $ by ex_elim [l18, l17]
l20: $ G , k = ⟨ a , b ⟩ , k ∊ r3_gr x B ⇒ b = (⟦ x / a ⟧ B) $ by ex_elim [l5, l19]
l21: $ G ⇒ b = (⟦ x / a ⟧ B) $ by wcel_elim [#1, l20]

lemma r3_gr_fun {x: set} (G: hyps x) (B: class x): $ G ⇒ functional (r3_gr x B) $
----
l1: $ G , ⟨ i , j ⟩ ∈ r3_gr x B , ⟨ i , c ⟩ ∈ r3_gr x B ⇒ ⟨ i , j ⟩ ∈ r3_gr x B $ by ax
l2: $ G , ⟨ i , j ⟩ ∈ r3_gr x B , ⟨ i , c ⟩ ∈ r3_gr x B ⇒ ⟨ i , c ⟩ ∈ r3_gr x B $ by ax
l3: $ G , ⟨ i , j ⟩ ∈ r3_gr x B , ⟨ i , c ⟩ ∈ r3_gr x B ⇒ j = (⟦ x / i ⟧ B) $ by r3_gr_elim [l1]
l4: $ G , ⟨ i , j ⟩ ∈ r3_gr x B , ⟨ i , c ⟩ ∈ r3_gr x B ⇒ c = (⟦ x / i ⟧ B) $ by r3_gr_elim [l2]
l5: $ G , ⟨ i , j ⟩ ∈ r3_gr x B , ⟨ i , c ⟩ ∈ r3_gr x B ⇒ (⟦ x / i ⟧ B) = c $ by eq_sym [l4]
l6: $ G , ⟨ i , j ⟩ ∈ r3_gr x B , ⟨ i , c ⟩ ∈ r3_gr x B ⇒ j = c $ by eq_trans [l3, l5]
l7: $ G ⇒ functional (r3_gr x B) $ by functional_intro [l6]

lam_set
-------
l1: $ G ⇒ functional (r3_gr x B) $ by r3_gr_fun
l2: $ G ⇒ isset (img (r3_gr x B) A) $ by img_set [l1, #1]
l3: $ G ⇒ isset (⋃ (img (r3_gr x B) A)) $ by cuni_set [l2]
l4: $ G ⇒ isset (A × ⋃ (img (r3_gr x B) A)) $ by cxp_set [#1, l3]
l5: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ ∀ x (x ∊ A → isset B) $ by weaken [#2]
l6: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A → isset (⟦ x / u ⟧ B) $ by all_elim [l5]
l7: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l8: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ isset (⟦ x / u ⟧ B) $ by imp_elim [l6, l7]
l9: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ j = (⟦ x / u ⟧ B) $ by ax
l10: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ (⟦ x / u ⟧ B) = j $ by eq_sym [l9]
l11: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ B) $ by ax
l12: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ v ∊ j $ by welc_eq [l10, l11]
l13: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ ⟨ u , j ⟩ ∈ r3_gr x B $ by r3_gr_intro [l9]
l14: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l15: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ j ∊ img (r3_gr x B) A $ by img_intro [l14, l13]
l16: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ v ∊ ⋃ (img (r3_gr x B) A) $ by cuni_intro [l12, l15]
l17: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ ⟨ u , v ⟩ ∈ A × ⋃ (img (r3_gr x B) A) $ by cxp_intro [l14, l16]
l18: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ w = ⟨ u , v ⟩ $ by ax
l19: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ ⟨ u , v ⟩ = w $ by eq_sym [l18]
l20: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ w ∈ A × ⋃ (img (r3_gr x B) A) $ by wcel_eq_l [l19, l17]
l21: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ w ∊ A × ⋃ (img (r3_gr x B) A) $ by wcel_welc [l20]
l22: $ G , w ∊ lam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ w ∊ A × ⋃ (img (r3_gr x B) A) $ by isset_elim [l8, l21]
l23: $ G , w ∊ lam x A B ⇒ w ∊ lam x A B $ by ax
l24: $ G , w ∊ lam x A B ⇒ w ∊ A × ⋃ (img (r3_gr x B) A) $ by lam_elim_mem [l23, l22]
l25: $ G ⇒ lam x A B ⊆ A × ⋃ (img (r3_gr x B) A) $ by subset_intro [l24]
