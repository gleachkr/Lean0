lemma r3_pi_sub {x: set} (G: hyps x) (A: class) (B: class x) (f g: set):
  $ G ⇒ f ∊ pi x A B $ > $ G ⇒ ∀ x (x ∊ A → ap f x = ap g x) $ > $ G ⇒ f ⊆ g $
----
l1: $ G ⇒ f ⊆ lam x A (⋃ B) $ by pi_elim_sub [#1]
l2: $ G , w ∊ f ⇒ f ⊆ lam x A (⋃ B) $ by weaken [l1]
l3: $ G , w ∊ f ⇒ w ∊ f $ by ax
l4: $ G , w ∊ f ⇒ w ∊ lam x A (⋃ B) $ by subset_elim [l2, l3]
l5: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w ∊ f $ by ax
l6: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w ∈ f $ by welc_wcel [l5]
l7: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w = ⟨ u , v ⟩ $ by ax
l8: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ⟨ u , v ⟩ ∈ f $ by wcel_eq_l [l7, l6]
l9: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ v ∊ ap f u $ by ap_intro [l8]
l10: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ∀ x (x ∊ A → ap f x = ap g x) $ by weaken [#2]
l11: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ u ∊ A → ap f u = ap g u $ by all_elim [l10]
l12: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l13: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ap f u = ap g u $ by imp_elim [l11, l12]
l14: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ v ∊ ap g u $ by welc_eq [l13, l9]
l15: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ⟨ u , v ⟩ ∈ g $ by ap_elim [l14]
l16: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ⟨ u , v ⟩ = w $ by eq_sym [l7]
l17: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w ∈ g $ by wcel_eq_l [l16, l15]
l18: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w ∊ g $ by wcel_welc [l17]
l19: $ G , w ∊ f ⇒ w ∊ g $ by lam_elim_mem [l4, l18]
l20: $ G ⇒ f ⊆ g $ by subset_intro [l19]

pi_ext
------
l1: $ G ⇒ f ⊆ g $ by r3_pi_sub [#1, #3]
l2: $ G , i ∊ A ⇒ ∀ x (x ∊ A → ap f x = ap g x) $ by weaken [#3]
l3: $ G , i ∊ A ⇒ i ∊ A → ap f i = ap g i $ by all_elim [l2]
l4: $ G , i ∊ A ⇒ i ∊ A $ by ax
l5: $ G , i ∊ A ⇒ ap f i = ap g i $ by imp_elim [l3, l4]
l6: $ G , i ∊ A ⇒ ap g i = ap f i $ by eq_sym [l5]
l7: $ G ⇒ i ∊ A → ap g i = ap f i $ by imp_intro [l6]
l8: $ G ⇒ ∀ i (i ∊ A → ap g i = ap f i) $ by all_intro [l7]
l9: $ (∀ x (x ∊ A → ap g x = ap f x)) ⟺ ∀ i (i ∊ A → ap g i = ap f i) $ by all_alpha
l10: $ G ⇒ (∀ x (x ∊ A → ap g x = ap f x)) ↔ ∀ i (i ∊ A → ap g i = ap f i) $ by weaken [l9]
l11: $ G ⇒ ∀ x (x ∊ A → ap g x = ap f x) $ by bi_elim_r [l10, l8]
l12: $ G ⇒ g ⊆ f $ by r3_pi_sub [#2, l11]
l13: $ G ⇒ f = g $ by subset_antisym [l1, l12]

pi_set
------
l1: $ G , w ∊ pi x A B ⇒ w ∊ pi x A B $ by ax
l2: $ G , w ∊ pi x A B ⇒ w ⊆ lam x A (⋃ B) $ by pi_elim_sub [l1]
l3: $ G , w ∊ pi x A B ⇒ w ∊ 𝒫 (lam x A (⋃ B)) $ by cpw_intro [l2]
l4: $ G ⇒ pi x A B ⊆ 𝒫 (lam x A (⋃ B)) $ by subset_intro [l3]
l5: $ G ⇒ isset (𝒫 (lam x A (⋃ B))) $ by cpw_set [#1]
l6: $ G ⇒ isset (pi x A B) $ by subset_isset [l5, l4]

pi_congr
--------
l0: $ ⋃ B ≐ ⋃ D $ by cuni_congr [#2]
l1: $ lam x A (⋃ B) ≐ lam x C (⋃ D) $ by lam_congr [#1, l0]
l2: $ cv g ≐ cv g $ by ceqt_refl
l3: $ (g ⊆ lam x A (⋃ B)) ⟺ (g ⊆ lam x C (⋃ D)) $ by subset_congr [l2, l1]
l4: $ seqt x x $ by seqt_refl
l5: $ (x ∊ A) ⟺ (x ∊ C) $ by welc_congr [l4, #1]
l6: $ ap g x ≐ ap g x $ by ceqt_refl
l7: $ (ap g x ∈ B) ⟺ (ap g x ∈ D) $ by wcel_congr [l6, #2]
l8: $ (x ∊ A → ap g x ∈ B) ⟺ (x ∊ C → ap g x ∈ D) $ by im_congr [l5, l7]
l9: $ (∀ x (x ∊ A → ap g x ∈ B)) ⟺ (∀ x (x ∊ C → ap g x ∈ D)) $ by all_congr [l8]
l10: $ (g ⊆ lam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)) ⟺ (g ⊆ lam x C (⋃ D) ∧ ∀ x (x ∊ C → ap g x ∈ D)) $ by and_congr [l3, l9]
l11: $ {g | g ⊆ lam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)} ≐ {g | g ⊆ lam x C (⋃ D) ∧ ∀ x (x ∊ C → ap g x ∈ D)} $ by cab_congr [l10]

sb_c_pi
-------
l1: $ (⟦ y / t ⟧ {g | g ⊆ lam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)}) ≐ {g | g ⊆ lam x (⟦ y / t ⟧ A) (⋃ (⟦ y / t ⟧ B)) ∧ ∀ x (x ∊ (⟦ y / t ⟧ A) → ap g x ∈ (⟦ y / t ⟧ B))} $ by ceqt_refl

two_intro_l
-----------
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G , k = ∅ ⇒ k = ∅ $ by ax
l3: $ G , k = ∅ ⇒ k = ∅ ∨ k = csn ∅ $ by or_intro_l [l2]
l4: $ G , k = ∅ ⇒ k ∊ cpr ∅ (csn ∅) $ by cpr_intro [l3]
l5: $ G , k = ∅ ⇒ ∅ ∈ two $ by wcel_intro [l2, l4]
l6: $ G ⇒ ∅ ∈ two $ by isset_elim [l1, l5]

two_intro_r
-----------
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ isset (csn ∅) $ by csn_set [l1]
l3: $ G , k = csn ∅ ⇒ k = csn ∅ $ by ax
l4: $ G , k = csn ∅ ⇒ k = ∅ ∨ k = csn ∅ $ by or_intro_r [l3]
l5: $ G , k = csn ∅ ⇒ k ∊ cpr ∅ (csn ∅) $ by cpr_intro [l4]
l6: $ G , k = csn ∅ ⇒ csn ∅ ∈ two $ by wcel_intro [l3, l5]
l7: $ G ⇒ csn ∅ ∈ two $ by isset_elim [l2, l6]

two_elim
--------
l1: $ G ⇒ a ∊ cpr ∅ (csn ∅) $ by weaken [#1]
l2: $ G ⇒ a = ∅ ∨ a = csn ∅ $ by cpr_elim [l1]

two_set
-------
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ isset (csn ∅) $ by csn_set [l1]
l3: $ G ⇒ isset (cpr ∅ (csn ∅)) $ by cpr_set [l1, l2]

lemma r3_pi_two_false {x: set} (G: hyps x) (A: class) (B: class x) (a: set):
  $ G ⇒ a ∊ A $ > $ G ⇒ (⟦ x / a ⟧ B) = ∅ $ > $ G ⇒ pi x A B = ∅ $
----
l1: $ G , w ∊ pi x A B ⇒ w ∊ pi x A B $ by ax
l2: $ G , w ∊ pi x A B ⇒ a ∊ A $ by weaken [#1]
l3: $ G , w ∊ pi x A B ⇒ ap w a ∈ (⟦ x / a ⟧ B) $ by pi_elim_ap [l1, l2]
l4: $ G , w ∊ pi x A B ⇒ (⟦ x / a ⟧ B) = ∅ $ by weaken [#2]
l5: $ G , w ∊ pi x A B ⇒ ap w a ∈ ∅ $ by wcel_eq_r [l4, l3]
l6: $ G , w ∊ pi x A B , k = ap w a , k ∊ ∅ ⇒ k ∊ ∅ $ by ax
l7: $ G , w ∊ pi x A B , k = ap w a , k ∊ ∅ ⇒ ⊥ $ by empty_elim [l6]
l8: $ G , w ∊ pi x A B ⇒ ⊥ $ by wcel_elim [l5, l7]
l9: $ G ⇒ pi x A B = ∅ $ by empty_eq_intro [l8]

lemma r3_pi_two_true {x: set} (G: hyps x) (A: class) (B: class x):
  $ G ⇒ ∀ x (x ∊ A → B = csn ∅) $ > $ G ⇒ pi x A B = csn ∅ $
----
l1: $ G , w ∊ pi x A B , v ∊ w ⇒ w ∊ pi x A B $ by ax
l2: $ G , w ∊ pi x A B , v ∊ w ⇒ w ⊆ lam x A (⋃ B) $ by pi_elim_sub [l1]
l3: $ G , w ∊ pi x A B , v ∊ w ⇒ v ∊ w $ by ax
l4: $ G , w ∊ pi x A B , v ∊ w ⇒ v ∊ lam x A (⋃ B) $ by subset_elim [l2, l3]
l5: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ v ∊ w $ by ax
l6: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ v ∈ w $ by welc_wcel [l5]
l7: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ v = ⟨ u , j ⟩ $ by ax
l8: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ⟨ u , j ⟩ ∈ w $ by wcel_eq_l [l7, l6]
l9: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ j ∊ ap w u $ by ap_intro [l8]
l10: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w ∊ pi x A B $ by ax
l11: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l12: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ap w u ∈ (⟦ x / u ⟧ B) $ by pi_elim_ap [l10, l11]
l13: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ∀ x (x ∊ A → B = csn ∅) $ by weaken [#1]
l14: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ u ∊ A → (⟦ x / u ⟧ B) = csn ∅ $ by all_elim [l13]
l15: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ (⟦ x / u ⟧ B) = csn ∅ $ by imp_elim [l14, l11]
l16: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ap w u ∈ csn ∅ $ by wcel_eq_r [l15, l12]
l17: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ k ∊ csn ∅ $ by ax
l18: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ k = ∅ $ by csn_elim [l17]
l19: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ k = ap w u $ by ax
l20: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ ap w u = k $ by eq_sym [l19]
l21: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ ap w u = ∅ $ by eq_trans [l20, l18]
l22: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ j ∊ ap w u $ by weaken [l9]
l23: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ j ∊ ∅ $ by welc_eq [l21, l22]
l24: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ ⊥ $ by empty_elim [l23]
l25: $ G , w ∊ pi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ⊥ $ by wcel_elim [l16, l24]
l26: $ G , w ∊ pi x A B , v ∊ w ⇒ ⊥ $ by lam_elim_mem [l4, l25]
l27: $ G , w ∊ pi x A B ⇒ w = ∅ $ by empty_eq_intro [l26]
l28: $ G , w ∊ pi x A B ⇒ w ∊ csn ∅ $ by csn_intro [l27]
l29: $ G , w ∊ csn ∅ ⇒ w ∊ csn ∅ $ by ax
l30: $ G , w ∊ csn ∅ ⇒ w = ∅ $ by csn_elim [l29]
l31: $ G , w ∊ csn ∅ ⇒ ∅ = w $ by eq_sym [l30]
l32: $ G , w ∊ csn ∅ ⇒ ∅ ⊆ lam x A (⋃ B) $ by empty_subset
l33: $ G , w ∊ csn ∅ ⇒ w ⊆ lam x A (⋃ B) $ by subset_eq_l [l31, l32]
l34: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i ⇒ v ∊ ap w i $ by ax
l35: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i ⇒ ⟨ i , v ⟩ ∈ w $ by ap_elim [l34]
l36: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i ⇒ w = ∅ $ by weaken [l30]
l37: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i ⇒ ⟨ i , v ⟩ ∈ ∅ $ by wcel_eq_r [l36, l35]
l38: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i , k = ⟨ i , v ⟩ , k ∊ ∅ ⇒ k ∊ ∅ $ by ax
l39: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i , k = ⟨ i , v ⟩ , k ∊ ∅ ⇒ ⊥ $ by empty_elim [l38]
l40: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i ⇒ ⊥ $ by wcel_elim [l37, l39]
l41: $ G , w ∊ csn ∅ , i ∊ A ⇒ ap w i = ∅ $ by empty_eq_intro [l40]
l42: $ G , w ∊ csn ∅ , i ∊ A ⇒ isset ∅ $ by ax_empty
l43: $ G , w ∊ csn ∅ , i ∊ A , k = ∅ ⇒ k = ∅ $ by ax
l44: $ G , w ∊ csn ∅ , i ∊ A , k = ∅ ⇒ k ∊ csn ∅ $ by csn_intro [l43]
l45: $ G , w ∊ csn ∅ , i ∊ A , k = ∅ ⇒ ∅ ∈ csn ∅ $ by wcel_intro [l43, l44]
l46: $ G , w ∊ csn ∅ , i ∊ A ⇒ ∅ ∈ csn ∅ $ by isset_elim [l42, l45]
l47: $ G , w ∊ csn ∅ , i ∊ A ⇒ ∅ = ap w i $ by eq_sym [l41]
l48: $ G , w ∊ csn ∅ , i ∊ A ⇒ ap w i ∈ csn ∅ $ by wcel_eq_l [l47, l46]
l49: $ G , w ∊ csn ∅ , i ∊ A ⇒ ∀ x (x ∊ A → B = csn ∅) $ by weaken [#1]
l50: $ G , w ∊ csn ∅ , i ∊ A ⇒ i ∊ A → (⟦ x / i ⟧ B) = csn ∅ $ by all_elim [l49]
l51: $ G , w ∊ csn ∅ , i ∊ A ⇒ i ∊ A $ by ax
l52: $ G , w ∊ csn ∅ , i ∊ A ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by imp_elim [l50, l51]
l53: $ G , w ∊ csn ∅ , i ∊ A ⇒ csn ∅ = (⟦ x / i ⟧ B) $ by eq_sym [l52]
l54: $ G , w ∊ csn ∅ , i ∊ A ⇒ ap w i ∈ (⟦ x / i ⟧ B) $ by wcel_eq_r [l53, l48]
l55: $ G , w ∊ csn ∅ ⇒ i ∊ A → ap w i ∈ (⟦ x / i ⟧ B) $ by imp_intro [l54]
l56: $ G , w ∊ csn ∅ ⇒ ∀ i (i ∊ A → ap w i ∈ (⟦ x / i ⟧ B)) $ by all_intro [l55]
l57: $ (∀ x (x ∊ A → ap w x ∈ B)) ⟺ ∀ i (i ∊ A → ap w i ∈ (⟦ x / i ⟧ B)) $ by all_alpha
l58: $ G , w ∊ csn ∅ ⇒ (∀ x (x ∊ A → ap w x ∈ B)) ↔ ∀ i (i ∊ A → ap w i ∈ (⟦ x / i ⟧ B)) $ by weaken [l57]
l59: $ G , w ∊ csn ∅ ⇒ ∀ x (x ∊ A → ap w x ∈ B) $ by bi_elim_r [l58, l56]
l60: $ G , w ∊ csn ∅ ⇒ w ∊ pi x A B $ by pi_intro [l33, l59]
l61: $ G ⇒ pi x A B = csn ∅ $ by eq_intro [l28, l60]

pi_two
------
l1: $ G ⇒ (∃ x (x ∊ A ∧ B = ∅)) ∨ ¬ ∃ x (x ∊ A ∧ B = ∅) $ by excluded_middle
l2: $ G , ∃ x (x ∊ A ∧ B = ∅) ⇒ ∃ x (x ∊ A ∧ B = ∅) $ by ax
l3: $ (∃ x (x ∊ A ∧ B = ∅)) ⟺ ∃ u (u ∊ A ∧ (⟦ x / u ⟧ B) = ∅) $ by ex_alpha
l4: $ G , ∃ x (x ∊ A ∧ B = ∅) ⇒ (∃ x (x ∊ A ∧ B = ∅)) ↔ ∃ u (u ∊ A ∧ (⟦ x / u ⟧ B) = ∅) $ by weaken [l3]
l5: $ G , ∃ x (x ∊ A ∧ B = ∅) ⇒ ∃ u (u ∊ A ∧ (⟦ x / u ⟧ B) = ∅) $ by bi_elim_l [l4, l2]
l6: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ $ by ax
l7: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ u ∊ A $ by and_elim_l [l6]
l8: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ (⟦ x / u ⟧ B) = ∅ $ by and_elim_r [l6]
l9: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ pi x A B = ∅ $ by r3_pi_two_false [l7, l8]
l10: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ ∅ ∈ two $ by two_intro_l
l11: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ ∅ = pi x A B $ by eq_sym [l9]
l12: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ pi x A B ∈ two $ by wcel_eq_l [l11, l10]
l13: $ G , ∃ x (x ∊ A ∧ B = ∅) ⇒ pi x A B ∈ two $ by ex_elim [l5, l12]
l14: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A ⇒ ∀ x (x ∊ A → B ∈ two) $ by weaken [#1]
l15: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A ⇒ i ∊ A → (⟦ x / i ⟧ B) ∈ two $ by all_elim [l14]
l16: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A ⇒ i ∊ A $ by ax
l17: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A ⇒ (⟦ x / i ⟧ B) ∈ two $ by imp_elim [l15, l16]
l18: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two ⇒ k ∊ two $ by ax
l19: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two ⇒ k = ∅ ∨ k = csn ∅ $ by two_elim [l18]
l20: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ k = ∅ $ by ax
l21: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ k = (⟦ x / i ⟧ B) $ by ax
l22: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ (⟦ x / i ⟧ B) = k $ by eq_sym [l21]
l23: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ (⟦ x / i ⟧ B) = ∅ $ by eq_trans [l22, l20]
l24: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ i ∊ A $ by ax
l25: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ i ∊ A ∧ (⟦ x / i ⟧ B) = ∅ $ by and_intro [l24, l23]
l26: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ ∃ x (x ∊ A ∧ B = ∅) $ by ex_intro (x := $ x $, t := $ i $, p := $ x ∊ A ∧ B = ∅ $) [l25]
l27: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ ¬ ∃ x (x ∊ A ∧ B = ∅) $ by ax
l28: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ ⊥ $ by not_elim [l27, l26]
l29: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by bot_elim [l28]
l30: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = csn ∅ ⇒ k = csn ∅ $ by ax
l31: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = csn ∅ ⇒ k = (⟦ x / i ⟧ B) $ by ax
l32: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = csn ∅ ⇒ (⟦ x / i ⟧ B) = k $ by eq_sym [l31]
l33: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = csn ∅ ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by eq_trans [l32, l30]
l34: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by or_elim [l19, l29, l33]
l35: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by wcel_elim [l17, l34]
l36: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ i ∊ A → (⟦ x / i ⟧ B) = csn ∅ $ by imp_intro [l35]
l37: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ ∀ i (i ∊ A → (⟦ x / i ⟧ B) = csn ∅) $ by all_intro [l36]
l38: $ (∀ x (x ∊ A → B = csn ∅)) ⟺ ∀ i (i ∊ A → (⟦ x / i ⟧ B) = csn ∅) $ by all_alpha
l39: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ (∀ x (x ∊ A → B = csn ∅)) ↔ ∀ i (i ∊ A → (⟦ x / i ⟧ B) = csn ∅) $ by weaken [l38]
l40: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ ∀ x (x ∊ A → B = csn ∅) $ by bi_elim_r [l39, l37]
l41: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ pi x A B = csn ∅ $ by r3_pi_two_true [l40]
l42: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ csn ∅ ∈ two $ by two_intro_r
l43: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ csn ∅ = pi x A B $ by eq_sym [l41]
l44: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ pi x A B ∈ two $ by wcel_eq_l [l43, l42]
l45: $ G ⇒ pi x A B ∈ two $ by or_elim [l1, l13, l44]

pi_two_true
-----------
l1: $ G ⇒ pi x A B = csn ∅ $ by r3_pi_two_true [#1]

pi_two_false
------------
l1: $ G ⇒ pi x A B = ∅ $ by r3_pi_two_false [#1, #2]
