-- Proofs for relations.mm0.

--| Membership in a product of a set equal to a pair.
cxp_intro_eq
------------
l1: $ G ⇒ a ∊ A ∧ b ∊ B $ by and_intro [#2, #3]
l2: $ G ⇒ c = ⟨ a , b ⟩ ∧ a ∊ A ∧ b ∊ B $ by and_intro [#1, l1]
l3: $ G ⇒ ∃ v (c = ⟨ a , v ⟩ ∧ a ∊ A ∧ v ∊ B) $ by ex_intro (x := $ v $, t := $ b $, p := $ c = ⟨ a , v ⟩ ∧ a ∊ A ∧ v ∊ B $) [l2]
l4: $ G ⇒ ∃ u ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ B) $ by ex_intro (x := $ u $, t := $ a $, p := $ ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ B) $) [l3]
l5: $ G ⇒ c ∊ {w | ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ B)} $ by cab_intro (x := $ w $, t := $ c $, p := $ ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ B) $) [l4]

cxp_intro
---------
