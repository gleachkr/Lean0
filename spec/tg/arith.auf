l6: $ G , u = A , u ∊ ω ⇒ ndbl u = ndbl A $ by ndbl_eq [l3]
l7: $ G , u = A , u ∊ ω ⇒ suc (ndbl u) = suc (ndbl A) $ by suc_eq [l6]
l8: $ G , u = A , u ∊ ω ⇒ suc (suc (ndbl u)) = suc (suc (ndbl A)) $ by suc_eq [l7]
