e13: $ G , c ∊ ω ∧ nadd b c = a ⇒ nadd (nsub a b) b = nadd b c $ by eq_trans [e11, e12]
e14: $ G , c ∊ ω ∧ nadd b c = a ⇒ nadd (nsub a b) b = a $ by eq_trans [e13, e3]
l2: $ G ⇒ nadd (nsub a b) b = a $ by ex_elim [l1, e14]

