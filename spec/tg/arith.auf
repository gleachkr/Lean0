--| Three-way case analysis.
lemma n2_cases3 (G: hyps) (p q r c: fml):
  $ G ⇒ p ∨ q ∨ r $ > $ G , p ⇒ c $ > $ G , q ⇒ c $ > $ G , r ⇒ c $ > $ G ⇒ c $
----
l1: $ G , q ∨ r , q ⇒ c $ by weaken [#3]
l2: $ G , q ∨ r , r ⇒ c $ by weaken [#4]
l3: $ G , q ∨ r ⇒ q ∨ r $ by ax
l4: $ G , q ∨ r ⇒ c $ by or_elim [l3, l1, l2]
l5: $ G ⇒ c $ by or_elim [#1, #2, l4]

ndbl_inj
--------
t1: $ G ⇒ a ∊ b ∨ a = b ∨ b ∊ a $ by omega_tricho [#1, #2]
c1: $ G , a ∊ b ⇒ a ∊ b $ by ax
c2: $ G , a ∊ b ⇒ a ∊ ω $ by weaken [#1]
c3: $ G , a ∊ b ⇒ b ∊ ω $ by weaken [#2]
c4: $ G , a ∊ b ⇒ nadd a a ∈ nadd b a $ by nadd_mono_lt [c2, c3, c2, c1]
c5: $ G , a ∊ b ⇒ nadd a a = nadd b b $ by weaken [#3]
c6: $ G , a ∊ b ⇒ nadd b b ∈ nadd b a $ by wcel_eq_l [c5, c4]
c7: $ G , a ∊ b ⇒ nadd b a = nadd a b $ by nadd_comm [c3, c2]
c8: $ G , a ∊ b ⇒ nadd b b ∈ nadd a b $ by wcel_eq_r [c7, c6]
c9: $ G , a ∊ b ⇒ b ∊ a $ by nadd_lt_cancel [c3, c2, c3, c8]
c10: $ G , a ∊ b ⇒ ⊥ $ by notin_cycle [c1, c9]
c11: $ G , a ∊ b ⇒ a = b $ by bot_elim [c10]
d1: $ G , a = b ⇒ a = b $ by ax
f1: $ G , b ∊ a ⇒ b ∊ a $ by ax
f2: $ G , b ∊ a ⇒ a ∊ ω $ by weaken [#1]
f3: $ G , b ∊ a ⇒ b ∊ ω $ by weaken [#2]
f4: $ G , b ∊ a ⇒ nadd b b ∈ nadd a b $ by nadd_mono_lt [f3, f2, f3, f1]
f5: $ G , b ∊ a ⇒ nadd a a = nadd b b $ by weaken [#3]
f6: $ G , b ∊ a ⇒ nadd b b = nadd a a $ by eq_sym [f5]
f7: $ G , b ∊ a ⇒ nadd a a ∈ nadd a b $ by wcel_eq_l [f6, f4]
f8: $ G , b ∊ a ⇒ nadd a b = nadd b a $ by nadd_comm [f2, f3]
f9: $ G , b ∊ a ⇒ nadd a a ∈ nadd b a $ by wcel_eq_r [f8, f7]
f10: $ G , b ∊ a ⇒ a ∊ b $ by nadd_lt_cancel [f2, f3, f2, f9]
f11: $ G , b ∊ a ⇒ ⊥ $ by notin_cycle [f10, f1]
f12: $ G , b ∊ a ⇒ a = b $ by bot_elim [f11]
g1: $ G ⇒ a = b $ by n2_cases3 [t1, c11, d1, f12]

--| Transport an equation along equalities of its two sides (other orientation).
lemma n2_tr2 (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ B = D $ > $ G ⇒ A = C $
----
l1: $ G ⇒ A = D $ by eq_trans [#1, #3]
l2: $ G ⇒ D = C $ by eq_sym [#2]
l3: $ G ⇒ A = C $ by eq_trans [l1, l2]

ndbl_ne_suc_ndbl
----------------
b1: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl z = suc (ndbl u) $ by ax
b2: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ z = ∅ $ by ax
b3: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl z = ndbl ∅ $ by ndbl_eq [b2]
b4: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl ∅ = ∅ $ by ndbl_zero
b5: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl z = ∅ $ by eq_trans [b3, b4]
b6: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ suc (ndbl u) = ndbl z $ by eq_sym [b1]
b7: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ suc (ndbl u) = ∅ $ by eq_trans [b6, b5]
b8: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ⊥ $ by suc_ne_empty [b7]
b9: $ G , z = ∅ , u ∊ ω ⇒ ndbl z = suc (ndbl u) → ⊥ $ by imp_intro [b8]
b10: $ G , z = ∅ ⇒ u ∊ ω → ndbl z = suc (ndbl u) → ⊥ $ by imp_intro [b9]
b11: $ G , z = ∅ ⇒ ∀ u (u ∊ ω → ndbl z = suc (ndbl u) → ⊥) $ by all_intro [b10]
s1: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ z = suc y $ by ax
s2: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl z = ndbl (suc y) $ by ndbl_eq [s1]
s3: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ y ∊ ω $ by ax
s4: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl (suc y) = suc (suc (ndbl y)) $ by ndbl_suc [s3]
s5: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl z = suc (ndbl u) $ by ax
s6: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl z = suc (suc (ndbl y)) $ by eq_trans [s2, s4]
s6b: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ suc (suc (ndbl y)) = ndbl z $ by eq_sym [s6]
s7: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ suc (suc (ndbl y)) = suc (ndbl u) $ by eq_trans [s6b, s5]
s8: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ isset (ndbl y) $ by nadd_set
s9: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ isset (suc (ndbl y)) $ by suc_set [s8]
s10: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ isset (ndbl u) $ by nadd_set
s11: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ suc (ndbl y) = ndbl u $ by suc_inj_c [s9, s10, s7]
s12: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ u ∊ ω $ by ax
s13: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ u = ∅ ∨ ∃ v (v ∊ ω ∧ u = suc v) $ by omega_cases [s12]
a1: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ u = ∅ $ by ax
a2: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ ndbl u = ndbl ∅ $ by ndbl_eq [a1]
a3: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ ndbl ∅ = ∅ $ by ndbl_zero
a4: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ suc (ndbl y) = ndbl u $ by weaken [s11]
a5: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ suc (ndbl y) = ndbl ∅ $ by eq_trans [a4, a2]
a6: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ suc (ndbl y) = ∅ $ by eq_trans [a5, a3]
a7: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ ⊥ $ by suc_ne_empty [a6]
e1: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ v ∊ ω ∧ u = suc v $ by ax
e2: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ v ∊ ω $ by and_elim_l [e1]
e3: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ u = suc v $ by and_elim_r [e1]
e4: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ ndbl u = ndbl (suc v) $ by ndbl_eq [e3]
e5: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ ndbl (suc v) = suc (suc (ndbl v)) $ by ndbl_suc [e2]
e6: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ suc (ndbl y) = ndbl u $ by weaken [s11]
e7: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ suc (ndbl y) = ndbl (suc v) $ by eq_trans [e6, e4]
e8: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ suc (ndbl y) = suc (suc (ndbl v)) $ by eq_trans [e7, e5]
e9: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ isset (ndbl y) $ by nadd_set
e10: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ isset (ndbl v) $ by nadd_set
e11: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ isset (suc (ndbl v)) $ by suc_set [e10]
e12: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ ndbl y = suc (ndbl v) $ by suc_inj_c [e9, e11, e8]
e13: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) $ by ax
e14: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ v ∊ ω → ndbl y = suc (ndbl v) → ⊥ $ by all_elim [e13]
e15: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ ndbl y = suc (ndbl v) → ⊥ $ by imp_elim [e14, e2]
e16: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ ⊥ $ by imp_elim [e15, e12]
e17: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , ∃ v (v ∊ ω ∧ u = suc v) ⇒ ∃ v (v ∊ ω ∧ u = suc v) $ by ax
e18: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , ∃ v (v ∊ ω ∧ u = suc v) ⇒ ⊥ $ by ex_elim [e17, e16]
s14: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ⊥ $ by or_elim [s13, a7, e18]
s15: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω ⇒ ndbl z = suc (ndbl u) → ⊥ $ by imp_intro [s14]
s16: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y ⇒ u ∊ ω → ndbl z = suc (ndbl u) → ⊥ $ by imp_intro [s15]
s17: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y ⇒ ∀ u (u ∊ ω → ndbl z = suc (ndbl u) → ⊥) $ by all_intro [s16]
m1: $ G ⇒ ∀ u (u ∊ ω → ndbl a = suc (ndbl u) → ⊥) $ by omega_ind_named [b11, s17, #1]
m2: $ G ⇒ b ∊ ω → ndbl a = suc (ndbl b) → ⊥ $ by all_elim [m1]
m3: $ G ⇒ ndbl a = suc (ndbl b) → ⊥ $ by imp_elim [m2, #2]
m4: $ G ⇒ ⊥ $ by imp_elim [m3, #3]

ndbl_eq_zero
