l2: $ G ⇒ a = ∅ $ by and_elim_l [l1]

--| The ordinal `1` is the singleton of `∅`.
lemma n2_suc_empty (G: hyps): $ G ⇒ suc ∅ = csn ∅ $
----
l1: $ G , z ∊ suc ∅ ⇒ z ∊ suc ∅ $ by ax
l2: $ G , z ∊ suc ∅ ⇒ z ∊ ∅ ∨ z = ∅ $ by suc_elim [l1]
l3: $ G , z ∊ suc ∅ , z ∊ ∅ ⇒ z ∊ ∅ $ by ax
l4: $ G , z ∊ suc ∅ , z ∊ ∅ ⇒ ⊥ $ by empty_elim [l3]
l5: $ G , z ∊ suc ∅ , z ∊ ∅ ⇒ z ∊ csn ∅ $ by bot_elim [l4]
l6: $ G , z ∊ suc ∅ , z = ∅ ⇒ z = ∅ $ by ax
l7: $ G , z ∊ suc ∅ , z = ∅ ⇒ z ∊ csn ∅ $ by csn_intro [l6]
l8: $ G , z ∊ suc ∅ ⇒ z ∊ csn ∅ $ by or_elim [l2, l5, l7]
l9: $ G , z ∊ csn ∅ ⇒ z ∊ csn ∅ $ by ax
l10: $ G , z ∊ csn ∅ ⇒ z = ∅ $ by csn_elim [l9]
l11: $ G , z ∊ csn ∅ ⇒ z ∊ suc ∅ $ by suc_intro_r [l10]
l12: $ G ⇒ suc ∅ = csn ∅ $ by eq_intro [l8, l11]

two_eq_suc
----------
m1: $ G , z ∊ two ⇒ z ∊ two $ by ax
m2: $ G , z ∊ two ⇒ z = ∅ ∨ z = csn ∅ $ by two_elim [m1]
m3: $ G , z ∊ two , z = ∅ ⇒ z = ∅ $ by ax
m4: $ G , z ∊ two , z = ∅ ⇒ z ∊ csn ∅ $ by csn_intro [m3]
m5: $ G , z ∊ two , z = ∅ ⇒ z ∊ suc (csn ∅) $ by suc_intro_l [m4]
m6: $ G , z ∊ two , z = csn ∅ ⇒ z = csn ∅ $ by ax
m7: $ G , z ∊ two , z = csn ∅ ⇒ z ∊ suc (csn ∅) $ by suc_intro_r [m6]
m8: $ G , z ∊ two ⇒ z ∊ suc (csn ∅) $ by or_elim [m2, m5, m7]
m9: $ G , z ∊ suc (csn ∅) ⇒ z ∊ suc (csn ∅) $ by ax
m10: $ G , z ∊ suc (csn ∅) ⇒ z ∊ csn ∅ ∨ z = csn ∅ $ by suc_elim [m9]
m11: $ G , z ∊ suc (csn ∅) , z ∊ csn ∅ ⇒ z ∊ csn ∅ $ by ax
m12: $ G , z ∊ suc (csn ∅) , z ∊ csn ∅ ⇒ z = ∅ $ by csn_elim [m11]
m13: $ G , z ∊ suc (csn ∅) , z ∊ csn ∅ ⇒ z = ∅ ∨ z = csn ∅ $ by or_intro_l [m12]
m14: $ G , z ∊ suc (csn ∅) , z ∊ csn ∅ ⇒ z ∊ cpr ∅ (csn ∅) $ by cpr_intro [m13]
m15: $ G , z ∊ suc (csn ∅) , z = csn ∅ ⇒ z = csn ∅ $ by ax
m16: $ G , z ∊ suc (csn ∅) , z = csn ∅ ⇒ z = ∅ ∨ z = csn ∅ $ by or_intro_r [m15]
m17: $ G , z ∊ suc (csn ∅) , z = csn ∅ ⇒ z ∊ cpr ∅ (csn ∅) $ by cpr_intro [m16]
m18: $ G , z ∊ suc (csn ∅) ⇒ z ∊ two $ by or_elim [m10, m14, m17]
m19: $ G ⇒ two = suc (csn ∅) $ by eq_intro [m8, m18]
m20: $ G ⇒ suc ∅ = csn ∅ $ by n2_suc_empty
m21: $ G ⇒ suc (suc ∅) = suc (csn ∅) $ by suc_eq [m20]
m22: $ G ⇒ suc (csn ∅) = suc (suc ∅) $ by eq_sym [m21]
m23: $ G ⇒ two = suc (suc ∅) $ by eq_trans [m19, m22]

