m8: $ G , z = A ⇒ ⋃ z = ⋃ A $ by cuni_eq [m1]
m9: $ G , z = A ⇒ fv (cgr x (⋃ x)) A = ⋃ z $ by eq_trans [m7, m4]
m10: $ G , z = A ⇒ fv (cgr x (⋃ x)) A = ⋃ A $ by eq_trans [m9, m8]
m11: $ G ⇒ fv (cgr x (⋃ x)) A = ⋃ A $ by isset_elim [#1, m10]

