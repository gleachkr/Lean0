-- Proofs for arith.mm0.

nadd_congr
----------
l1: $ cgr x (suc x) ≐ cgr x (suc x) $ by ceqt_refl
l2: $ omrec A (cgr x (suc x)) ≐ omrec B (cgr x (suc x)) $ by omrec_congr [#1, l1]
l3: $ fv (omrec A (cgr x (suc x))) C ≐ fv (omrec B (cgr x (suc x))) D $ by fv_congr [l2, #2]

nadd_eq
-------
l1: $ G ⇒ cgr x (suc x) = cgr x (suc x) $ by eq_refl
l2: $ G ⇒ omrec A (cgr x (suc x)) = omrec B (cgr x (suc x)) $ by omrec_eq [#1, l1]
l3: $ G ⇒ fv (omrec A (cgr x (suc x))) C = fv (omrec B (cgr x (suc x))) D $ by fv_eq [l2, #2]

sb_c_nadd
---------
l1: $ (⟦ x / t ⟧ (fv (omrec A (cgr y (suc y))) B)) ≐ fv (⟦ x / t ⟧ (omrec A (cgr y (suc y)))) (⟦ x / t ⟧ B) $ by sb_c_fv
l2: $ (⟦ x / t ⟧ (omrec A (cgr y (suc y)))) ≐ omrec (⟦ x / t ⟧ A) (⟦ x / t ⟧ (cgr y (suc y))) $ by sb_c_omrec
l3: $ (⟦ x / t ⟧ (cgr y (suc y))) ≐ cgr y (suc y) $ by sb_c_irrel
l4: $ (⟦ x / t ⟧ A) ≐ (⟦ x / t ⟧ A) $ by ceqt_refl
l5: $ omrec (⟦ x / t ⟧ A) (⟦ x / t ⟧ (cgr y (suc y))) ≐ omrec (⟦ x / t ⟧ A) (cgr y (suc y)) $ by omrec_congr [l4, l3]
l6: $ (⟦ x / t ⟧ (omrec A (cgr y (suc y)))) ≐ omrec (⟦ x / t ⟧ A) (cgr y (suc y)) $ by ceqt_trans [l2, l5]
l7: $ (⟦ x / t ⟧ B) ≐ (⟦ x / t ⟧ B) $ by ceqt_refl
l8: $ fv (⟦ x / t ⟧ (omrec A (cgr y (suc y)))) (⟦ x / t ⟧ B) ≐ fv (omrec (⟦ x / t ⟧ A) (cgr y (suc y))) (⟦ x / t ⟧ B) $ by fv_congr [l6, l7]
l9: $ (⟦ x / t ⟧ (fv (omrec A (cgr y (suc y))) B)) ≐ fv (omrec (⟦ x / t ⟧ A) (cgr y (suc y))) (⟦ x / t ⟧ B) $ by ceqt_trans [l1, l8]

nmul_congr
----------
l1: $ x ≐ x $ by ceqt_refl
l2: $ nadd x A ≐ nadd x B $ by nadd_congr [l1, #1]
l3: $ cgr x (nadd x A) ≐ cgr x (nadd x B) $ by cgr_congr [l2]
l4: $ ∅ ≐ ∅ $ by ceqt_refl
l5: $ omrec ∅ (cgr x (nadd x A)) ≐ omrec ∅ (cgr x (nadd x B)) $ by omrec_congr [l4, l3]
l6: $ fv (omrec ∅ (cgr x (nadd x A))) C ≐ fv (omrec ∅ (cgr x (nadd x B))) D $ by fv_congr [l5, #2]

nmul_eq
-------
l1: $ G ⇒ x = x $ by eq_refl
l2: $ G ⇒ nadd x A = nadd x B $ by nadd_eq [l1, #1]
l3: $ G ⇒ ∀ x (nadd x A = nadd x B) $ by all_intro [l2]
l4: $ G ⇒ cgr x (nadd x A) = cgr x (nadd x B) $ by cgr_eq [l3]
l5: $ G ⇒ ∅ = ∅ $ by eq_refl
l6: $ G ⇒ omrec ∅ (cgr x (nadd x A)) = omrec ∅ (cgr x (nadd x B)) $ by omrec_eq [l5, l4]
l7: $ G ⇒ fv (omrec ∅ (cgr x (nadd x A))) C = fv (omrec ∅ (cgr x (nadd x B))) D $ by fv_eq [l6, #2]

sb_c_nmul
---------
l1: $ (⟦ x / t ⟧ (fv (omrec ∅ (cgr y (nadd y A))) B)) ≐ fv (⟦ x / t ⟧ (omrec ∅ (cgr y (nadd y A)))) (⟦ x / t ⟧ B) $ by sb_c_fv
l2: $ (⟦ x / t ⟧ (omrec ∅ (cgr y (nadd y A)))) ≐ omrec (⟦ x / t ⟧ ∅) (⟦ x / t ⟧ (cgr y (nadd y A))) $ by sb_c_omrec
l3: $ (⟦ x / t ⟧ ∅) ≐ ∅ $ by sb_c_irrel
l4: $ (⟦ x / t ⟧ (cgr y (nadd y A))) ≐ cgr y (nadd y (⟦ x / t ⟧ A)) $ by ceqt_refl
l5: $ omrec (⟦ x / t ⟧ ∅) (⟦ x / t ⟧ (cgr y (nadd y A))) ≐ omrec ∅ (cgr y (nadd y (⟦ x / t ⟧ A))) $ by omrec_congr [l3, l4]
l6: $ (⟦ x / t ⟧ (omrec ∅ (cgr y (nadd y A)))) ≐ omrec ∅ (cgr y (nadd y (⟦ x / t ⟧ A))) $ by ceqt_trans [l2, l5]
l7: $ (⟦ x / t ⟧ B) ≐ (⟦ x / t ⟧ B) $ by ceqt_refl
l8: $ fv (⟦ x / t ⟧ (omrec ∅ (cgr y (nadd y A)))) (⟦ x / t ⟧ B) ≐ fv (omrec ∅ (cgr y (nadd y (⟦ x / t ⟧ A)))) (⟦ x / t ⟧ B) $ by fv_congr [l6, l7]
l9: $ (⟦ x / t ⟧ (fv (omrec ∅ (cgr y (nadd y A))) B)) ≐ fv (omrec ∅ (cgr y (nadd y (⟦ x / t ⟧ A)))) (⟦ x / t ⟧ B) $ by ceqt_trans [l1, l8]

npow_congr
----------
l1: $ x ≐ x $ by ceqt_refl
l2: $ nmul x A ≐ nmul x B $ by nmul_congr [l1, #1]
l3: $ cgr x (nmul x A) ≐ cgr x (nmul x B) $ by cgr_congr [l2]
l4: $ suc ∅ ≐ suc ∅ $ by ceqt_refl
l5: $ omrec (suc ∅) (cgr x (nmul x A)) ≐ omrec (suc ∅) (cgr x (nmul x B)) $ by omrec_congr [l4, l3]
l6: $ fv (omrec (suc ∅) (cgr x (nmul x A))) C ≐ fv (omrec (suc ∅) (cgr x (nmul x B))) D $ by fv_congr [l5, #2]

npow_eq
-------
l1: $ G ⇒ x = x $ by eq_refl
l2: $ G ⇒ nmul x A = nmul x B $ by nmul_eq [l1, #1]
l3: $ G ⇒ ∀ x (nmul x A = nmul x B) $ by all_intro [l2]
l4: $ G ⇒ cgr x (nmul x A) = cgr x (nmul x B) $ by cgr_eq [l3]
l5: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l6: $ G ⇒ omrec (suc ∅) (cgr x (nmul x A)) = omrec (suc ∅) (cgr x (nmul x B)) $ by omrec_eq [l5, l4]
l7: $ G ⇒ fv (omrec (suc ∅) (cgr x (nmul x A))) C = fv (omrec (suc ∅) (cgr x (nmul x B))) D $ by fv_eq [l6, #2]

sb_c_npow
---------
l1: $ (⟦ x / t ⟧ (fv (omrec (suc ∅) (cgr y (nmul y A))) B)) ≐ fv (⟦ x / t ⟧ (omrec (suc ∅) (cgr y (nmul y A)))) (⟦ x / t ⟧ B) $ by sb_c_fv
l2: $ (⟦ x / t ⟧ (omrec (suc ∅) (cgr y (nmul y A)))) ≐ omrec (⟦ x / t ⟧ (suc ∅)) (⟦ x / t ⟧ (cgr y (nmul y A))) $ by sb_c_omrec
l3: $ (⟦ x / t ⟧ (suc ∅)) ≐ suc ∅ $ by sb_c_irrel
l4a: $ (⟦ x / t ⟧ (cgr y (nmul y A))) ≐ cgr y (⟦ x / t ⟧ (nmul y A)) $ by sb_c_cgr
l4b: $ (⟦ x / t ⟧ (nmul y A)) ≐ nmul (⟦ x / t ⟧ y) (⟦ x / t ⟧ A) $ by sb_c_nmul
l4c: $ (⟦ x / t ⟧ y) ≐ y $ by sb_c_other
l4d: $ (⟦ x / t ⟧ A) ≐ (⟦ x / t ⟧ A) $ by ceqt_refl
l4e: $ nmul (⟦ x / t ⟧ y) (⟦ x / t ⟧ A) ≐ nmul y (⟦ x / t ⟧ A) $ by nmul_congr [l4c, l4d]
l4f: $ (⟦ x / t ⟧ (nmul y A)) ≐ nmul y (⟦ x / t ⟧ A) $ by ceqt_trans [l4b, l4e]
l4g: $ cgr y (⟦ x / t ⟧ (nmul y A)) ≐ cgr y (nmul y (⟦ x / t ⟧ A)) $ by cgr_congr [l4f]
l4: $ (⟦ x / t ⟧ (cgr y (nmul y A))) ≐ cgr y (nmul y (⟦ x / t ⟧ A)) $ by ceqt_trans [l4a, l4g]
l5: $ omrec (⟦ x / t ⟧ (suc ∅)) (⟦ x / t ⟧ (cgr y (nmul y A))) ≐ omrec (suc ∅) (cgr y (nmul y (⟦ x / t ⟧ A))) $ by omrec_congr [l3, l4]
l6: $ (⟦ x / t ⟧ (omrec (suc ∅) (cgr y (nmul y A)))) ≐ omrec (suc ∅) (cgr y (nmul y (⟦ x / t ⟧ A))) $ by ceqt_trans [l2, l5]
l7: $ (⟦ x / t ⟧ B) ≐ (⟦ x / t ⟧ B) $ by ceqt_refl
l8: $ fv (⟦ x / t ⟧ (omrec (suc ∅) (cgr y (nmul y A)))) (⟦ x / t ⟧ B) ≐ fv (omrec (suc ∅) (cgr y (nmul y (⟦ x / t ⟧ A)))) (⟦ x / t ⟧ B) $ by fv_congr [l6, l7]
l9: $ (⟦ x / t ⟧ (fv (omrec (suc ∅) (cgr y (nmul y A))) B)) ≐ fv (omrec (suc ∅) (cgr y (nmul y (⟦ x / t ⟧ A)))) (⟦ x / t ⟧ B) $ by ceqt_trans [l1, l8]

nsub_congr
----------
l1: $ cgr x (⋃ x) ≐ cgr x (⋃ x) $ by ceqt_refl
l2: $ omrec A (cgr x (⋃ x)) ≐ omrec B (cgr x (⋃ x)) $ by omrec_congr [#1, l1]
l3: $ fv (omrec A (cgr x (⋃ x))) C ≐ fv (omrec B (cgr x (⋃ x))) D $ by fv_congr [l2, #2]

nsub_eq
-------
l1: $ G ⇒ cgr x (⋃ x) = cgr x (⋃ x) $ by eq_refl
l2: $ G ⇒ omrec A (cgr x (⋃ x)) = omrec B (cgr x (⋃ x)) $ by omrec_eq [#1, l1]
l3: $ G ⇒ fv (omrec A (cgr x (⋃ x))) C = fv (omrec B (cgr x (⋃ x))) D $ by fv_eq [l2, #2]

sb_c_nsub
---------
l1: $ (⟦ x / t ⟧ (fv (omrec A (cgr y (⋃ y))) B)) ≐ fv (⟦ x / t ⟧ (omrec A (cgr y (⋃ y)))) (⟦ x / t ⟧ B) $ by sb_c_fv
l2: $ (⟦ x / t ⟧ (omrec A (cgr y (⋃ y)))) ≐ omrec (⟦ x / t ⟧ A) (⟦ x / t ⟧ (cgr y (⋃ y))) $ by sb_c_omrec
l3: $ (⟦ x / t ⟧ (cgr y (⋃ y))) ≐ cgr y (⋃ y) $ by sb_c_irrel
l4: $ (⟦ x / t ⟧ A) ≐ (⟦ x / t ⟧ A) $ by ceqt_refl
l5: $ omrec (⟦ x / t ⟧ A) (⟦ x / t ⟧ (cgr y (⋃ y))) ≐ omrec (⟦ x / t ⟧ A) (cgr y (⋃ y)) $ by omrec_congr [l4, l3]
l6: $ (⟦ x / t ⟧ (omrec A (cgr y (⋃ y)))) ≐ omrec (⟦ x / t ⟧ A) (cgr y (⋃ y)) $ by ceqt_trans [l2, l5]
l7: $ (⟦ x / t ⟧ B) ≐ (⟦ x / t ⟧ B) $ by ceqt_refl
l8: $ fv (⟦ x / t ⟧ (omrec A (cgr y (⋃ y)))) (⟦ x / t ⟧ B) ≐ fv (omrec (⟦ x / t ⟧ A) (cgr y (⋃ y))) (⟦ x / t ⟧ B) $ by fv_congr [l6, l7]
l9: $ (⟦ x / t ⟧ (fv (omrec A (cgr y (⋃ y))) B)) ≐ fv (omrec (⟦ x / t ⟧ A) (cgr y (⋃ y))) (⟦ x / t ⟧ B) $ by ceqt_trans [l1, l8]

ndbl_congr
----------
l1: $ nadd A A ≐ nadd B B $ by nadd_congr [#1, #1]

ndbl_eq
-------
l1: $ G ⇒ nadd A A = nadd B B $ by nadd_eq [#1, #1]

sb_c_ndbl
---------
l1: $ (⟦ x / t ⟧ (nadd A A)) ≐ nadd (⟦ x / t ⟧ A) (⟦ x / t ⟧ A) $ by sb_c_nadd

nmax_congr
----------
l1: $ (A ∪ C) ≐ (B ∪ D) $ by cun_congr [#1, #2]

nmax_eq
-------
l1: $ G ⇒ A ∪ C = B ∪ D $ by cun_eq [#1, #2]

sb_c_nmax
---------
l1: $ (⟦ x / t ⟧ (A ∪ B)) ≐ (⟦ x / t ⟧ A) ∪ (⟦ x / t ⟧ B) $ by sb_c_cun

nadd_set
--------
l1: $ G ⇒ functional (omrec a (cgr x (suc x))) $ by omrec_functional
l2: $ G ⇒ isset (fv (omrec a (cgr x (suc x))) b) $ by fv_set [l1]

nadd_set_c
----------
l1: $ G , v = A , w = B ⇒ v = A $ by ax
l2: $ G , v = A , w = B ⇒ w = B $ by ax
l3: $ G , v = A , w = B ⇒ nadd v w = nadd A B $ by nadd_eq [l1, l2]
l4: $ G , v = A , w = B ⇒ isset (nadd v w) $ by nadd_set
l5: $ G , v = A , w = B ⇒ isset (nadd A B) $ by isset_eq [l3, l4]
l6: $ G , v = A ⇒ isset (nadd A B) $ by isset_elim [#2, l5]
l7: $ G ⇒ isset (nadd A B) $ by isset_elim [#1, l6]

nadd_zero
---------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ functional (cgr x (suc x)) $ by cgr_functional
l3: $ G ⇒ fv (omrec a (cgr x (suc x))) ∅ = a $ by omrec_zero [l1, l2]

nadd_zero_c
-----------
l1: $ G , v = A ⇒ nadd v ∅ = v $ by nadd_zero
l2: $ G , v = A ⇒ v = A $ by ax
l3: $ G , v = A ⇒ ∅ = ∅ $ by eq_refl
l4: $ G , v = A ⇒ nadd v ∅ = nadd A ∅ $ by nadd_eq [l2, l3]
l5: $ G , v = A ⇒ nadd A ∅ = nadd v ∅ $ by eq_sym [l4]
l6: $ G , v = A ⇒ nadd A ∅ = v $ by eq_trans [l5, l1]
l7: $ G , v = A ⇒ nadd A ∅ = A $ by eq_trans [l6, l2]
l8: $ G ⇒ nadd A ∅ = A $ by isset_elim [#1, l7]

nadd_suc
--------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ functional (cgr x (suc x)) $ by cgr_functional
l3: $ G ⇒ fv (omrec a (cgr x (suc x))) (suc b) = fv (cgr x (suc x)) (fv (omrec a (cgr x (suc x))) b) $ by omrec_suc [l1, l2, #1]
l4: $ G ⇒ isset (nadd a b) $ by nadd_set
m1: $ G , v = nadd a b ⇒ isset v $ by isset_var
m2: $ G , v = nadd a b ⇒ isset (suc v) $ by suc_set [m1]
m3: $ G , v = nadd a b ⇒ fv (cgr x (suc x)) v = suc v $ by fv_cgr [m2]
m4: $ G , v = nadd a b ⇒ v = nadd a b $ by ax
m5: $ G , v = nadd a b ⇒ nadd a b = v $ by eq_sym [m4]
m6: $ G , v = nadd a b ⇒ cgr x (suc x) = cgr x (suc x) $ by eq_refl
m7: $ G , v = nadd a b ⇒ fv (cgr x (suc x)) (nadd a b) = fv (cgr x (suc x)) v $ by fv_eq [m6, m5]
m8: $ G , v = nadd a b ⇒ suc v = suc (nadd a b) $ by suc_eq [m4]
m9: $ G , v = nadd a b ⇒ fv (omrec a (cgr x (suc x))) (suc b) = fv (cgr x (suc x)) (fv (omrec a (cgr x (suc x))) b) $ by weaken [l3]
m10: $ G , v = nadd a b ⇒ nadd a (suc b) = fv (cgr x (suc x)) v $ by eq_trans [m9, m7]
m11: $ G , v = nadd a b ⇒ nadd a (suc b) = suc v $ by eq_trans [m10, m3]
m12: $ G , v = nadd a b ⇒ nadd a (suc b) = suc (nadd a b) $ by eq_trans [m11, m8]
m13: $ G ⇒ nadd a (suc b) = suc (nadd a b) $ by isset_elim [l4, m12]

--| Transport an equation along equalities of its two sides.
lemma n2_tr (G: hyps) (A B C D: class):
  $ G ⇒ B = A $ > $ G ⇒ D = C $ > $ G ⇒ B = D $ > $ G ⇒ A = C $
----
l1: $ G ⇒ A = B $ by eq_sym [#1]
l2: $ G ⇒ A = D $ by eq_trans [l1, #3]
l3: $ G ⇒ A = C $ by eq_trans [l2, #2]

nadd_suc_c
----------
l1: $ G , u = A , v = B , v ∊ ω ⇒ v ∊ ω $ by ax
l2: $ G , u = A , v = B , v ∊ ω ⇒ nadd u (suc v) = suc (nadd u v) $ by nadd_suc [l1]
l3: $ G , u = A , v = B , v ∊ ω ⇒ u = A $ by ax
l4: $ G , u = A , v = B , v ∊ ω ⇒ v = B $ by ax
l5: $ G , u = A , v = B , v ∊ ω ⇒ suc v = suc B $ by suc_eq [l4]
l6: $ G , u = A , v = B , v ∊ ω ⇒ nadd u (suc v) = nadd A (suc B) $ by nadd_eq [l3, l5]
l7: $ G , u = A , v = B , v ∊ ω ⇒ nadd u v = nadd A B $ by nadd_eq [l3, l4]
l8: $ G , u = A , v = B , v ∊ ω ⇒ suc (nadd u v) = suc (nadd A B) $ by suc_eq [l7]
l9: $ G , u = A , v = B , v ∊ ω ⇒ nadd A (suc B) = suc (nadd A B) $ by n2_tr [l6, l8, l2]
l10: $ G , u = A ⇒ B ∈ ω $ by weaken [#2]
l11: $ G , u = A ⇒ nadd A (suc B) = suc (nadd A B) $ by wcel_elim [l10, l9]
l12: $ G ⇒ nadd A (suc B) = suc (nadd A B) $ by isset_elim [#1, l11]

nadd_omega
----------
b1: $ G , z = ∅ ⇒ z = ∅ $ by ax
b2: $ G , z = ∅ ⇒ a = a $ by eq_refl
b3: $ G , z = ∅ ⇒ nadd a z = nadd a ∅ $ by nadd_eq [b2, b1]
b4: $ G , z = ∅ ⇒ nadd a ∅ = a $ by nadd_zero
b5: $ G , z = ∅ ⇒ nadd a z = a $ by eq_trans [b3, b4]
b6: $ G , z = ∅ ⇒ a = nadd a z $ by eq_sym [b5]
b7: $ G , z = ∅ ⇒ a ∊ ω $ by weaken [#1]
b8: $ G , z = ∅ ⇒ a ∈ ω $ by welc_wcel [b7]
b9: $ G , z = ∅ ⇒ nadd a z ∈ ω $ by wcel_eq_l [b6, b8]
s1: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ z = suc y $ by ax
s2: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ a = a $ by eq_refl
s3: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ nadd a z = nadd a (suc y) $ by nadd_eq [s2, s1]
s4: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ y ∊ ω $ by ax
s5: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ nadd a (suc y) = suc (nadd a y) $ by nadd_suc [s4]
s6: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ nadd a z = suc (nadd a y) $ by eq_trans [s3, s5]
s7: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ suc (nadd a y) = nadd a z $ by eq_sym [s6]
s8: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ nadd a y ∈ ω $ by ax
s9: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ suc (nadd a y) ∈ ω $ by omega_suc_c [s8]
s10: $ G , y ∊ ω , nadd a y ∈ ω , z = suc y ⇒ nadd a z ∈ ω $ by wcel_eq_l [s7, s9]
i1: $ G ⇒ nadd a b ∈ ω $ by omega_ind_named [b9, s10, #2]

nadd_omega_c
------------
l1: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ u ∊ ω $ by ax
l2: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ v ∊ ω $ by ax
l3: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ nadd u v ∈ ω $ by nadd_omega [l1, l2]
l4: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ u = A $ by ax
l5: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ v = B $ by ax
l6: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ nadd u v = nadd A B $ by nadd_eq [l4, l5]
l7: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ nadd A B ∈ ω $ by wcel_eq_l [l6, l3]
l8: $ G , u = A , u ∊ ω ⇒ B ∈ ω $ by weaken [#2]
l9: $ G , u = A , u ∊ ω ⇒ nadd A B ∈ ω $ by wcel_elim [l8, l7]
l10: $ G ⇒ nadd A B ∈ ω $ by wcel_elim [#1, l9]

zero_nadd
---------
b1: $ G , z = ∅ ⇒ z = ∅ $ by ax
b2: $ G , z = ∅ ⇒ ∅ = z $ by eq_sym [b1]
b3: $ G , z = ∅ ⇒ nadd ∅ z = nadd z ∅ $ by nadd_eq [b2, b1]
b4: $ G , z = ∅ ⇒ nadd z ∅ = z $ by nadd_zero
b5: $ G , z = ∅ ⇒ nadd ∅ z = z $ by eq_trans [b3, b4]
s1: $ G , y ∊ ω , nadd ∅ y = y , z = suc y ⇒ z = suc y $ by ax
s2: $ G , y ∊ ω , nadd ∅ y = y , z = suc y ⇒ ∅ = ∅ $ by eq_refl
