e8: $ G ⇒ nadd b (nadd a b) = nadd a (nadd b b) $ by eq_trans [e7, e5]
e9: $ G ⇒ nadd a (nadd b (nadd a b)) = nadd a (nadd a (nadd b b)) $ by nadd_eq [h5, e8]
e10: $ G ⇒ nadd (nadd a a) (nadd b b) = nadd a (nadd a (nadd b b)) $ by nadd_assoc_c [h1, h1, h4]
e11: $ G ⇒ nadd a (nadd a (nadd b b)) = nadd (nadd a a) (nadd b b) $ by eq_sym [e10]
e12: $ G ⇒ nadd (nadd a b) (nadd a b) = nadd a (nadd a (nadd b b)) $ by eq_trans [e1, e9]
e13: $ G ⇒ ndbl (nadd a b) = nadd (ndbl a) (ndbl b) $ by eq_trans [e12, e11]

