--| Monotonicity of addition in its second argument, for classes.
lemma n2_mono_le_r (G: hyps) (A B C: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ > $ G ⇒ A ⊆ B $ > $ G ⇒ nadd C A ⊆ nadd C B $
----
l1: $ G ⇒ nadd A C ⊆ nadd B C $ by nadd_mono_le_c [#1, #2, #3, #4]
l2: $ G ⇒ nadd C A = nadd A C $ by nadd_comm_c [#3, #1]
l3: $ G ⇒ nadd A C = nadd C A $ by eq_sym [l2]
l4: $ G ⇒ nadd C A ⊆ nadd B C $ by subset_eq_l [l3, l1]
l5: $ G ⇒ nadd B C = nadd C B $ by nadd_comm_c [#2, #3]
l6: $ G ⇒ nadd C A ⊆ nadd C B $ by subset_eq_r [l5, l4]

