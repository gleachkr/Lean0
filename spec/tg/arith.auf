x10: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ a = z $ by ax
x11: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ nadd a w = z $ by eq_trans [x9, x10]
x12: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ w ∊ ω ∧ nadd a w = z $ by and_intro [x5, x11]
x13: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ ∃ c (c ∊ ω ∧ nadd a c = z) $ by ex_intro [x12]
x14: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z ⇒ isset ∅ $ by ax_empty
x15: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z ⇒ ∃ c (c ∊ ω ∧ nadd a c = z) $ by isset_elim [x14, x13]
y1: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , z ∊ a ⇒ z ∊ a $ by ax
y2: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , z ∊ a ⇒ a ⊆ z $ by ax
y3: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , z ∊ a ⇒ z ∊ z $ by subset_elim [y2, y1]
y4: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , z ∊ a ⇒ ⊥ $ by notin_self [y3]
y5: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , z ∊ a ⇒ ∃ c (c ∊ ω ∧ nadd a c = z) $ by bot_elim [y4]
y6: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z ∨ z ∊ a ⇒ a = z ∨ z ∊ a $ by ax
y6a: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z ∨ z ∊ a , a = z ⇒ ∃ c (c ∊ ω ∧ nadd a c = z) $ by weaken [x15]
y6b: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z ∨ z ∊ a , z ∊ a ⇒ ∃ c (c ∊ ω ∧ nadd a c = z) $ by weaken [y5]
y7: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z , a = z ∨ z ∊ a ⇒ ∃ c (c ∊ ω ∧ nadd a c = z) $ by or_elim [y6, y6a, y6b]
y8: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y , a ⊆ z ⇒ ∃ c (c ∊ ω ∧ nadd a c = z) $ by or_elim [t8, u12, y7]
y9: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ nadd a c = y) , z = suc y ⇒ a ⊆ z → ∃ c (c ∊ ω ∧ nadd a c = z) $ by imp_intro [y8]
i1: $ G ⇒ a ⊆ b → ∃ c (c ∊ ω ∧ nadd a c = b) $ by omega_ind_named [n17, y9, #2]
i2: $ G ⇒ ∃ c (c ∊ ω ∧ nadd a c = b) $ by imp_elim [i1, #3]

nlt_ex
------
l1: $ G ⇒ suc a ⊆ b $ by omega_elem_suc_subset [#1, #2, #3]
l2: $ G ⇒ isset a $ by isset_var
l3: $ G ⇒ isset (suc a) $ by suc_set [l2]
m1: $ G , w = suc a ⇒ w = suc a $ by ax
m2: $ G , w = suc a ⇒ suc a = w $ by eq_sym [m1]
m2a: $ G , w = suc a ⇒ a ∊ ω $ by weaken [#1]
m3: $ G , w = suc a ⇒ suc a ∈ ω $ by omega_suc [m2a]
m4: $ G , w = suc a ⇒ w ∈ ω $ by wcel_eq_l [m2, m3]
m5: $ G , w = suc a ⇒ w ∊ ω $ by wcel_welc [m4]
m6: $ G , w = suc a ⇒ suc a ⊆ b $ by weaken [l1]
m7: $ G , w = suc a ⇒ w ⊆ b $ by subset_eq_l [m2, m6]
m8: $ G , w = suc a ⇒ b ∊ ω $ by weaken [#2]
m9: $ G , w = suc a ⇒ ∃ c (c ∊ ω ∧ nadd w c = b) $ by nle_ex [m5, m8, m7]
m10: $ (∃ c (c ∊ ω ∧ nadd w c = b)) ⟺ ∃ k (k ∊ ω ∧ nadd w k = b) $ by ex_alpha
m11: $ G , w = suc a ⇒ (∃ c (c ∊ ω ∧ nadd w c = b)) ↔ ∃ k (k ∊ ω ∧ nadd w k = b) $ by weaken [m10]
m12: $ G , w = suc a ⇒ ∃ k (k ∊ ω ∧ nadd w k = b) $ by bi_elim_l [m11, m9]
n1: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ k ∊ ω ∧ nadd w k = b $ by ax
n2: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ k ∊ ω $ by and_elim_l [n1]
n3: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ nadd w k = b $ by and_elim_r [n1]
n4: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ nadd a (suc k) = suc (nadd a k) $ by nadd_suc [n2]
n5: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ nadd (suc a) k = suc (nadd a k) $ by suc_nadd [n2]
n6: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ suc (nadd a k) = nadd (suc a) k $ by eq_sym [n5]
n7: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ k = k $ by eq_refl
n7a: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ suc a = w $ by weaken [m2]
n8: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ nadd (suc a) k = nadd w k $ by nadd_eq [n7a, n7]
n9: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ nadd a (suc k) = nadd (suc a) k $ by eq_trans [n4, n6]
n9a: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ nadd a (suc k) = nadd w k $ by eq_trans [n9, n8]
n9b: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ nadd a (suc k) = b $ by eq_trans [n9a, n3]
n10: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ k ∊ ω ∧ nadd a (suc k) = b $ by and_intro [n2, n9b]
n11: $ G , w = suc a , k ∊ ω ∧ nadd w k = b ⇒ ∃ c (c ∊ ω ∧ nadd a (suc c) = b) $ by ex_intro [n10]
n12: $ G , w = suc a ⇒ ∃ c (c ∊ ω ∧ nadd a (suc c) = b) $ by ex_elim [m12, n11]
n13: $ G ⇒ ∃ c (c ∊ ω ∧ nadd a (suc c) = b) $ by isset_elim [l3, n12]

