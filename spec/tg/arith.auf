h6: $ G ⇒ b = b $ by eq_refl
e1: $ G ⇒ nadd (nadd a b) (nadd a b) = nadd a (nadd b (nadd a b)) $ by nadd_assoc_c [h1, h2, h3]
e2: $ G ⇒ nadd (nadd b a) b = nadd b (nadd a b) $ by nadd_assoc [#2, #1, #2]
e3: $ G ⇒ nadd b a = nadd a b $ by nadd_comm [#2, #1]
e4: $ G ⇒ nadd (nadd b a) b = nadd (nadd a b) b $ by nadd_eq [e3, h6]
