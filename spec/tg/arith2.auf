l2: $ G ⇒ ∅ ∈ ω $ by omega_zero
l3: $ G ⇒ e ∈ ω $ by wcel_eq_l [l1, l2]
l4: $ G ⇒ e ∊ ω $ by wcel_welc [l3]
l5: $ G ⇒ a ∊ ω $ by omega_elem_omega [#1, #2]
l6: $ G ⇒ b = b $ by eq_refl
l7: $ G ⇒ nmul e b = nmul ∅ b $ by nmul_eq [#3, l6]
l8: $ G ⇒ nmul ∅ b = ∅ $ by zero_nmul [#1]
l9: $ G ⇒ nmul e b = ∅ $ by eq_trans [l7, l8]
l10: $ G ⇒ a = a $ by eq_refl
l11: $ G ⇒ nadd (nmul e b) a = nadd ∅ a $ by nadd_eq [l9, l10]
l12: $ G ⇒ nadd ∅ a = a $ by zero_nadd [l5]
l13: $ G ⇒ nadd (nmul e b) a = a $ by eq_trans [l11, l12]
l14: $ G ⇒ e ∊ ω ∧ nadd (nmul e b) a = a $ by and_intro [l4, l13]

