-- Proofs for arith2.mm0.

ndvd_congr
----------
l1: $ (c ∊ ω) ⟺ (c ∊ ω) $ by iff_refl
l2: $ c ≐ c $ by ceqt_refl
l3: $ nmul A c ≐ nmul B c $ by nmul_congr [#1, l2]
l4: $ (C = nmul A c) ⟺ (D = nmul B c) $ by ceq_congr [#2, l3]
l5: $ (c ∊ ω ∧ C = nmul A c) ⟺ (c ∊ ω ∧ D = nmul B c) $ by and_congr [l1, l4]
l6: $ ∃ c (c ∊ ω ∧ C = nmul A c) ⟺ ∃ c (c ∊ ω ∧ D = nmul B c) $ by ex_congr [l5]

ndvd_eq
-------
l1: $ (∃ c (c ∊ ω ∧ C = nmul A c)) ⟺ ∃ u (u ∊ ω ∧ C = nmul A u) $ by ex_alpha
l2: $ G ⇒ (∃ c (c ∊ ω ∧ C = nmul A c)) ↔ ∃ u (u ∊ ω ∧ C = nmul A u) $ by weaken [l1]
l3: $ G ⇒ ∃ u (u ∊ ω ∧ C = nmul A u) $ by bi_elim_l [l2, #3]
l4: $ G , u ∊ ω ∧ C = nmul A u ⇒ u ∊ ω ∧ C = nmul A u $ by ax
l5: $ G , u ∊ ω ∧ C = nmul A u ⇒ u ∊ ω $ by and_elim_l [l4]
l6: $ G , u ∊ ω ∧ C = nmul A u ⇒ C = nmul A u $ by and_elim_r [l4]
l7: $ G , u ∊ ω ∧ C = nmul A u ⇒ C = D $ by weaken [#2]
l8: $ G , u ∊ ω ∧ C = nmul A u ⇒ D = C $ by eq_sym [l7]
l9: $ G , u ∊ ω ∧ C = nmul A u ⇒ A = B $ by weaken [#1]
l10: $ G , u ∊ ω ∧ C = nmul A u ⇒ u = u $ by eq_refl
l11: $ G , u ∊ ω ∧ C = nmul A u ⇒ nmul A u = nmul B u $ by nmul_eq [l9, l10]
l12: $ G , u ∊ ω ∧ C = nmul A u ⇒ D = nmul A u $ by eq_trans [l8, l6]
l13: $ G , u ∊ ω ∧ C = nmul A u ⇒ D = nmul B u $ by eq_trans [l12, l11]
l14: $ G , u ∊ ω ∧ C = nmul A u ⇒ u ∊ ω ∧ D = nmul B u $ by and_intro [l5, l13]
l15: $ G , u ∊ ω ∧ C = nmul A u ⇒ ndvd B D $ by ex_intro [l14]
l16: $ G ⇒ ndvd B D $ by ex_elim [l3, l15]

sb_f_ndvd
---------
l1: $ [x/t] (∃ c (c ∊ ω ∧ B = nmul A c)) ⟺ ∃ c (c ∊ ω ∧ (⟦ x / t ⟧ B) = nmul (⟦ x / t ⟧ A) c) $ by iff_refl

ndiv_congr
----------
e0: $ ∅ ≐ ∅ $ by ceqt_refl
e1: $ (C = ∅) ⟺ (D = ∅) $ by ceq_congr [#2, e0]
e2: $ y ≐ y $ by ceqt_refl
e3: $ (y = ∅) ⟺ (y = ∅) $ by iff_refl
e4: $ (C = ∅ ∧ y = ∅) ⟺ (D = ∅ ∧ y = ∅) $ by and_congr [e1, e3]
e5: $ (∅ ∈ C) ⟺ (∅ ∈ D) $ by wcel_congr [e0, #2]
e6: $ seqt v v $ by seqt_refl
e7: $ (v ∊ C) ⟺ (v ∊ D) $ by welc_congr [e6, #2]
e8: $ nmul y C ≐ nmul y D $ by nmul_congr [e2, #2]
e9: $ v ≐ v $ by ceqt_refl
e10: $ nadd (nmul y C) v ≐ nadd (nmul y D) v $ by nadd_congr [e8, e9]
e11: $ (nadd (nmul y C) v = A) ⟺ (nadd (nmul y D) v = B) $ by ceq_congr [e10, #1]
e12: $ (v ∊ C ∧ nadd (nmul y C) v = A) ⟺ (v ∊ D ∧ nadd (nmul y D) v = B) $ by and_congr [e7, e11]
e13: $ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A) ⟺ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B) $ by ex_congr [e12]
e14: $ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)) ⟺ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)) $ by and_congr [e5, e13]
e15: $ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A))) ⟺ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B))) $ by or_congr [e4, e14]
e16: $ (y ∊ ω) ⟺ (y ∊ ω) $ by iff_refl
e17: $ (y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))) ⟺ (y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))) $ by and_congr [e16, e15]
e18: $ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ≐ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))} $ by cab_congr [e17]
e19: $ ⋃ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ≐ ⋃ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))} $ by cuni_congr [e18]

lemma q1_ndiv_sub {y v: set} (G: hyps) (A B C D: class) (z: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ z ∊ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))} $
----
s0: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} $ by ax
s1: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ z ∊ ω ∧ ((C = ∅ ∧ z = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A))) $ by cab_elim [s0]
s2: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ z ∊ ω $ by and_elim_l [s1]
s3: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ (C = ∅ ∧ z = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A)) $ by and_elim_r [s1]
a1: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , C = ∅ ∧ z = ∅ ⇒ C = ∅ ∧ z = ∅ $ by ax
a2: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , C = ∅ ∧ z = ∅ ⇒ C = ∅ $ by and_elim_l [a1]
a3: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , C = ∅ ∧ z = ∅ ⇒ z = ∅ $ by and_elim_r [a1]
a4: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , C = ∅ ∧ z = ∅ ⇒ C = D $ by weaken [#2]
a5: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , C = ∅ ∧ z = ∅ ⇒ D = C $ by eq_sym [a4]
a6: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , C = ∅ ∧ z = ∅ ⇒ D = ∅ $ by eq_trans [a5, a2]
a7: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , C = ∅ ∧ z = ∅ ⇒ D = ∅ ∧ z = ∅ $ by and_intro [a6, a3]
a8: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , C = ∅ ∧ z = ∅ ⇒ (D = ∅ ∧ z = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul z D) v = B)) $ by or_intro_l [a7]
c1: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ w ∊ C ∧ nadd (nmul z C) w = A $ by ax
c2: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ w ∊ C $ by and_elim_l [c1]
c3: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ nadd (nmul z C) w = A $ by and_elim_r [c1]
c4: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ C = D $ by weaken [#2]
c5: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ w ∊ D $ by welc_eq [c4, c2]
c6: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ z = z $ by eq_refl
c7: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ nmul z C = nmul z D $ by nmul_eq [c6, c4]
c8: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ w = w $ by eq_refl
c9: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ nadd (nmul z C) w = nadd (nmul z D) w $ by nadd_eq [c7, c8]
c10: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ nadd (nmul z D) w = nadd (nmul z C) w $ by eq_sym [c9]
c11: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ nadd (nmul z D) w = A $ by eq_trans [c10, c3]
c12: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ A = B $ by weaken [#1]
c13: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ nadd (nmul z D) w = B $ by eq_trans [c11, c12]
c14: $ G , w ∊ C ∧ nadd (nmul z C) w = A ⇒ w ∊ D ∧ nadd (nmul z D) w = B $ by and_intro [c5, c13]
c15: $ G ⇒ w ∊ C ∧ nadd (nmul z C) w = A → w ∊ D ∧ nadd (nmul z D) w = B $ by imp_intro [c14]
c16: $ G ⇒ ∀ w (w ∊ C ∧ nadd (nmul z C) w = A → w ∊ D ∧ nadd (nmul z D) w = B) $ by all_intro [c15]
e1: $ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⟺ ∃ w (w ∊ C ∧ nadd (nmul z C) w = A) $ by ex_alpha
e2: $ ∃ v (v ∊ D ∧ nadd (nmul z D) v = B) ⟺ ∃ w (w ∊ D ∧ nadd (nmul z D) w = B) $ by ex_alpha
b1: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) $ by ax
b2: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∅ ∈ C $ by and_elim_l [b1]
b3: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) $ by and_elim_r [b1]
b3a: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ↔ ∃ w (w ∊ C ∧ nadd (nmul z C) w = A) $ by weaken [e1]
b3b: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∃ w (w ∊ C ∧ nadd (nmul z C) w = A) $ by bi_elim_l [b3a, b3]
b4: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ C = D $ by weaken [#2]
b5: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∅ ∈ D $ by wcel_eq_r [b4, b2]
b6: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∀ w (w ∊ C ∧ nadd (nmul z C) w = A → w ∊ D ∧ nadd (nmul z D) w = B) $ by weaken [c16]
b7: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∃ w (w ∊ D ∧ nadd (nmul z D) w = B) $ by ex_mp [b6, b3b]
b7a: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∃ v (v ∊ D ∧ nadd (nmul z D) v = B) ↔ ∃ w (w ∊ D ∧ nadd (nmul z D) w = B) $ by weaken [e2]
b7b: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∃ v (v ∊ D ∧ nadd (nmul z D) v = B) $ by bi_elim_r [b7a, b7]
b8: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ ∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul z D) v = B) $ by and_intro [b5, b7b]
b9: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul z C) v = A) ⇒ (D = ∅ ∧ z = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul z D) v = B)) $ by or_intro_r [b8]
s4: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ (D = ∅ ∧ z = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul z D) v = B)) $ by or_elim [s3, a8, b9]
s5: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ z ∊ ω ∧ ((D = ∅ ∧ z = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul z D) v = B))) $ by and_intro [s2, s4]
s6: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ z ∊ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))} $ by cab_intro [s5]

ndiv_eq
-------
l4: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} ⇒ z ∊ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))} $ by q1_ndiv_sub [#1, #2]
l8: $ G ⇒ B = A $ by eq_sym [#1]
l9: $ G ⇒ D = C $ by eq_sym [#2]
l10: $ G , z ∊ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))} ⇒ z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} $ by q1_ndiv_sub [l8, l9]
l11: $ G ⇒ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} = {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))} $ by eq_intro [l4, l10]
l12: $ G ⇒ ⋃ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ nadd (nmul y C) v = A)))} = ⋃ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ nadd (nmul y D) v = B)))} $ by cuni_eq [l11]

sb_c_ndiv
---------
l1: $ (⟦ x / t ⟧ (⋃ {y | y ∊ ω ∧ ((B = ∅ ∧ y = ∅) ∨ (∅ ∈ B ∧ ∃ v (v ∊ B ∧ nadd (nmul y B) v = A)))})) ≐ ⋃ {y | y ∊ ω ∧ (((⟦ x / t ⟧ B) = ∅ ∧ y = ∅) ∨ (∅ ∈ (⟦ x / t ⟧ B) ∧ ∃ v (v ∊ (⟦ x / t ⟧ B) ∧ nadd (nmul y (⟦ x / t ⟧ B)) v = (⟦ x / t ⟧ A))))} $ by ceqt_refl

nmod_congr
----------
l1: $ ndiv A C ≐ ndiv B D $ by ndiv_congr [#1, #2]
l2: $ nmul (ndiv A C) C ≐ nmul (ndiv B D) D $ by nmul_congr [l1, #2]
l3: $ nsub A (nmul (ndiv A C) C) ≐ nsub B (nmul (ndiv B D) D) $ by nsub_congr [#1, l2]

nmod_eq
-------
l1: $ G ⇒ ndiv A C = ndiv B D $ by ndiv_eq [#1, #2]
l2: $ G ⇒ nmul (ndiv A C) C = nmul (ndiv B D) D $ by nmul_eq [l1, #2]
l3: $ G ⇒ nsub A (nmul (ndiv A C) C) = nsub B (nmul (ndiv B D) D) $ by nsub_eq [#1, l2]

sb_c_nmod
---------
l1: $ (⟦ x / t ⟧ (nsub A (nmul (ndiv A B) B))) ≐ nsub (⟦ x / t ⟧ A) (⟦ x / t ⟧ (nmul (ndiv A B) B)) $ by sb_c_nsub
l2: $ (⟦ x / t ⟧ (nmul (ndiv A B) B)) ≐ nmul (⟦ x / t ⟧ (ndiv A B)) (⟦ x / t ⟧ B) $ by sb_c_nmul
l3: $ (⟦ x / t ⟧ (ndiv A B)) ≐ ndiv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $ by sb_c_ndiv
l4: $ (⟦ x / t ⟧ B) ≐ (⟦ x / t ⟧ B) $ by ceqt_refl
l5: $ nmul (⟦ x / t ⟧ (ndiv A B)) (⟦ x / t ⟧ B) ≐ nmul (ndiv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (⟦ x / t ⟧ B) $ by nmul_congr [l3, l4]
l6: $ (⟦ x / t ⟧ (nmul (ndiv A B) B)) ≐ nmul (ndiv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (⟦ x / t ⟧ B) $ by ceqt_trans [l2, l5]
l7: $ (⟦ x / t ⟧ A) ≐ (⟦ x / t ⟧ A) $ by ceqt_refl
l8: $ nsub (⟦ x / t ⟧ A) (⟦ x / t ⟧ (nmul (ndiv A B) B)) ≐ nsub (⟦ x / t ⟧ A) (nmul (ndiv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (⟦ x / t ⟧ B)) $ by nsub_congr [l7, l6]
l9: $ (⟦ x / t ⟧ (nsub A (nmul (ndiv A B) B))) ≐ nsub (⟦ x / t ⟧ A) (nmul (ndiv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (⟦ x / t ⟧ B)) $ by ceqt_trans [l1, l8]

ngcd_congr
----------
l1: $ g ≐ g $ by ceqt_refl
l2: $ (g ∊ ω) ⟺ (g ∊ ω) $ by iff_refl
l3: $ ndvd g A ⟺ ndvd g B $ by ndvd_congr [l1, #1]
l4: $ ndvd g C ⟺ ndvd g D $ by ndvd_congr [l1, #2]
l5: $ k ≐ k $ by ceqt_refl
l6: $ ndvd k A ⟺ ndvd k B $ by ndvd_congr [l5, #1]
l7: $ ndvd k C ⟺ ndvd k D $ by ndvd_congr [l5, #2]
l8: $ ndvd k g ⟺ ndvd k g $ by iff_refl
l9: $ (ndvd k C → ndvd k g) ⟺ (ndvd k D → ndvd k g) $ by im_congr [l7, l8]
l10: $ (ndvd k A → ndvd k C → ndvd k g) ⟺ (ndvd k B → ndvd k D → ndvd k g) $ by im_congr [l6, l9]
l11: $ (k ∊ ω) ⟺ (k ∊ ω) $ by iff_refl
l12: $ (k ∊ ω → ndvd k A → ndvd k C → ndvd k g) ⟺ (k ∊ ω → ndvd k B → ndvd k D → ndvd k g) $ by im_congr [l11, l10]
l13: $ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g) ⟺ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g) $ by all_congr [l12]
l14: $ (ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)) ⟺ (ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)) $ by and_congr [l4, l13]
l15: $ (ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)) ⟺ (ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)) $ by and_congr [l3, l14]
l16: $ (g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)) ⟺ (g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)) $ by and_congr [l2, l15]
l17: $ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ≐ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $ by cab_congr [l16]
l18: $ ⋃ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ≐ ⋃ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $ by cuni_congr [l17]

lemma q1_ngcd_sub {g k: set} (G: hyps) (A B C D: class) (z: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $
----
s0: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} $ by ax
s1: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ ω ∧ ndvd z A ∧ ndvd z C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by cab_elim [s0]
s2: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ ω $ by and_elim_l [s1]
s3: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ndvd z A ∧ ndvd z C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by and_elim_r [s1]
s4: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ndvd z A $ by and_elim_l [s3]
s5: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ndvd z C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by and_elim_r [s3]
s6: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ndvd z C $ by and_elim_l [s5]
s7: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by and_elim_r [s5]
s8: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z = z $ by eq_refl
s9: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ A = B $ by weaken [#1]
s10: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ C = D $ by weaken [#2]
s11: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ndvd z B $ by ndvd_eq [s8, s9, s4]
s12: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ndvd z D $ by ndvd_eq [s8, s10, s6]
t1: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by weaken [s7]
t2: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ w ∊ ω → ndvd w A → ndvd w C → ndvd w z $ by all_elim [t1]
t3: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ w ∊ ω $ by ax
t4: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w A → ndvd w C → ndvd w z $ by imp_elim [t2, t3]
t5: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ w = w $ by eq_refl
t6a: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ A = B $ by weaken [#1]
t7a: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ C = D $ by weaken [#2]
t8: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w B $ by ax
t9: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w D $ by ax
t10: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ B = A $ by eq_sym [t6a]
t11: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ D = C $ by eq_sym [t7a]
t12: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w A $ by ndvd_eq [t5, t10, t8]
t13: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w C $ by ndvd_eq [t5, t11, t9]
t14: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w C → ndvd w z $ by imp_elim [t4, t12]
t15: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w z $ by imp_elim [t14, t13]
t16: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B ⇒ ndvd w D → ndvd w z $ by imp_intro [t15]
t17: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω ⇒ ndvd w B → ndvd w D → ndvd w z $ by imp_intro [t16]
t18: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ w ∊ ω → ndvd w B → ndvd w D → ndvd w z $ by imp_intro [t17]
t19: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ∀ w (w ∊ ω → ndvd w B → ndvd w D → ndvd w z) $ by all_intro [t18]
t20: $ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k z) ⟺ ∀ w (w ∊ ω → ndvd w B → ndvd w D → ndvd w z) $ by all_alpha
t21: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k z) ↔ ∀ w (w ∊ ω → ndvd w B → ndvd w D → ndvd w z) $ by weaken [t20]
t22: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k z) $ by bi_elim_r [t21, t19]
u1: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ndvd z D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k z) $ by and_intro [s12, t22]
u2: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ ndvd z B ∧ ndvd z D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k z) $ by and_intro [s11, u1]
u3: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ ω ∧ ndvd z B ∧ ndvd z D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k z) $ by and_intro [s2, u2]
u4: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $ by cab_intro [u3]

ngcd_eq
-------
l4: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $ by q1_ngcd_sub [#1, #2]
l8: $ G ⇒ B = A $ by eq_sym [#1]
l9: $ G ⇒ D = C $ by eq_sym [#2]
l10: $ G , z ∊ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} ⇒ z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} $ by q1_ngcd_sub [l8, l9]
l11: $ G ⇒ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} = {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $ by eq_intro [l4, l10]
l12: $ G ⇒ ⋃ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} = ⋃ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $ by cuni_eq [l11]

sb_c_ngcd
---------
l1: $ (⟦ x / t ⟧ (⋃ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g B ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k B → ndvd k g)})) ≐ ⋃ {g | g ∊ ω ∧ ndvd g (⟦ x / t ⟧ A) ∧ ndvd g (⟦ x / t ⟧ B) ∧ ∀ k (k ∊ ω → ndvd k (⟦ x / t ⟧ A) → ndvd k (⟦ x / t ⟧ B) → ndvd k g)} $ by ceqt_refl

nshl_congr
----------
l1: $ two ≐ two $ by ceqt_refl
l2: $ npow two C ≐ npow two D $ by npow_congr [l1, #2]
l3: $ nmul A (npow two C) ≐ nmul B (npow two D) $ by nmul_congr [#1, l2]

nshl_eq
-------
l1: $ G ⇒ two = two $ by eq_refl
l2: $ G ⇒ npow two C = npow two D $ by npow_eq [l1, #2]
l3: $ G ⇒ nmul A (npow two C) = nmul B (npow two D) $ by nmul_eq [#1, l2]

sb_c_nshl
---------
l1: $ (⟦ x / t ⟧ (nmul A (npow two B))) ≐ nmul (⟦ x / t ⟧ A) (⟦ x / t ⟧ (npow two B)) $ by sb_c_nmul
l2: $ (⟦ x / t ⟧ (npow two B)) ≐ npow (⟦ x / t ⟧ two) (⟦ x / t ⟧ B) $ by sb_c_npow
l3: $ (⟦ x / t ⟧ two) ≐ two $ by sb_c_irrel
l4: $ (⟦ x / t ⟧ B) ≐ (⟦ x / t ⟧ B) $ by ceqt_refl
l5: $ npow (⟦ x / t ⟧ two) (⟦ x / t ⟧ B) ≐ npow two (⟦ x / t ⟧ B) $ by npow_congr [l3, l4]
l6: $ (⟦ x / t ⟧ (npow two B)) ≐ npow two (⟦ x / t ⟧ B) $ by ceqt_trans [l2, l5]
l7: $ (⟦ x / t ⟧ A) ≐ (⟦ x / t ⟧ A) $ by ceqt_refl
l8: $ nmul (⟦ x / t ⟧ A) (⟦ x / t ⟧ (npow two B)) ≐ nmul (⟦ x / t ⟧ A) (npow two (⟦ x / t ⟧ B)) $ by nmul_congr [l7, l6]
l9: $ (⟦ x / t ⟧ (nmul A (npow two B))) ≐ nmul (⟦ x / t ⟧ A) (npow two (⟦ x / t ⟧ B)) $ by ceqt_trans [l1, l8]

omega_sind_f
------------
l1: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω , z ∊ x ⇒ ∀ y (y ∊ x → y ∊ ω → [x/y] p) $ by ax
l2: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω , z ∊ x ⇒ z ∊ x → z ∊ ω → [x/z] p $ by all_elim [l1]
l3: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω , z ∊ x ⇒ z ∊ x $ by ax
l4: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω , z ∊ x ⇒ z ∊ ω → [x/z] p $ by imp_elim [l2, l3]
l5: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω , z ∊ x ⇒ x ∊ ω $ by ax
l6: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω , z ∊ x ⇒ z ∊ ω $ by omega_elem_omega [l5, l3]
l7: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω , z ∊ x ⇒ [x/z] p $ by imp_elim [l4, l6]
l8: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω ⇒ z ∊ x → [x/z] p $ by imp_intro [l7]
l9: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω ⇒ ∀ z (z ∊ x → [x/z] p) $ by all_intro [l8]
l10: $ ∀ z (z ∊ x → [x/z] p) ⟺ ∀ y (y ∊ x → [x/y] p) $ by all_alpha
l11: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω ⇒ ∀ z (z ∊ x → [x/z] p) ↔ ∀ y (y ∊ x → [x/y] p) $ by weaken [l10]
l12: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω ⇒ ∀ y (y ∊ x → [x/y] p) $ by bi_elim_l [l11, l9]
l13: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) , x ∊ ω ⇒ p $ by cut [l12, #1]
l14: $ G , ord x , ∀ y (y ∊ x → y ∊ ω → [x/y] p) ⇒ x ∊ ω → p $ by imp_intro [l13]
l15: $ G ⇒ ∀ x (ord x → x ∊ ω → p) $ by ord_ind_f [l14]
l16: $ G , x ∊ ω ⇒ ∀ x (ord x → x ∊ ω → p) $ by weaken [l15]
l17: $ G , x ∊ ω ⇒ ord x → x ∊ ω → p $ by all_elim [l16]
l18: $ G , x ∊ ω ⇒ x ∊ ω $ by ax
l19: $ G , x ∊ ω ⇒ ord x $ by ord_omega_elem [l18]
l20: $ G , x ∊ ω ⇒ x ∊ ω → p $ by imp_elim [l17, l19]
l21: $ G , x ∊ ω ⇒ p $ by imp_elim [l20, l18]
l22: $ G ⇒ x ∊ ω → p $ by imp_intro [l21]
l23: $ G ⇒ ∀ x (x ∊ ω → p) $ by all_intro [l22]

two_omega
---------
l1: $ G ⇒ ∅ ∈ ω $ by omega_zero
l2: $ G ⇒ suc ∅ ∈ ω $ by omega_suc_c [l1]
l3: $ G ⇒ suc (suc ∅) ∈ ω $ by omega_suc_c [l2]
l4: $ G ⇒ two = suc (suc ∅) $ by two_eq_suc
l5: $ G ⇒ suc (suc ∅) = two $ by eq_sym [l4]
l6: $ G ⇒ two ∈ ω $ by wcel_eq_l [l5, l3]

two_names
---------
l1: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ t = two $ by ax
l2: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ e = ∅ $ by ax
l3: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ o = suc e $ by ax
l4: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ two = suc (suc ∅) $ by two_eq_suc
l5: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ suc e = suc ∅ $ by suc_eq [l2]
l6: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ o = suc ∅ $ by eq_trans [l3, l5]
l7: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ suc o = suc (suc ∅) $ by suc_eq [l6]
l8a: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ t = suc (suc ∅) $ by eq_trans [l1, l4]
l8b: $ G , t = two , t ∊ ω , e = ∅ , o = suc e ⇒ suc (suc ∅) = suc o $ by eq_sym [l7]
