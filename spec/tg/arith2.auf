c11: $ G , u = two , u ∊ ω ⇒ nmul a (npow two (suc b)) = nmul a (npow u (suc b)) $ by eq_sym [c7]
c12: $ G , u = two , u ∊ ω ⇒ nmul a (npow two (suc b)) = nmul (nmul u a) (npow u b) $ by eq_trans [c11, c3]
c13: $ G , u = two , u ∊ ω ⇒ nmul a (npow two (suc b)) = nmul (nmul two a) (npow two b) $ by eq_trans [c12, c10]
l2: $ G ⇒ nmul a (npow two (suc b)) = nmul (nmul two a) (npow two b) $ by wcel_elim [l1, c13]
