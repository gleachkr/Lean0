b3: $ G , ∅ ∈ a ⇒ a = b $ by or_elim [b2, d9, c4]
l2: $ G ⇒ a = b $ by or_elim [l1, b3, a3]

ndiv_set
--------
l1: $ G , z ∊ {x | x ∊ ω ∧ ((b = ∅ ∧ x = ∅) ∨ (∅ ∈ b ∧ ∃ y (y ∊ b ∧ nadd (nmul x b) y = a)))} ⇒ z ∊ {x | x ∊ ω ∧ ((b = ∅ ∧ x = ∅) ∨ (∅ ∈ b ∧ ∃ y (y ∊ b ∧ nadd (nmul x b) y = a)))} $ by ax
l2: $ G , z ∊ {x | x ∊ ω ∧ ((b = ∅ ∧ x = ∅) ∨ (∅ ∈ b ∧ ∃ y (y ∊ b ∧ nadd (nmul x b) y = a)))} ⇒ z ∊ ω ∧ ((b = ∅ ∧ z = ∅) ∨ (∅ ∈ b ∧ ∃ y (y ∊ b ∧ nadd (nmul z b) y = a))) $ by cab_elim [l1]
l3: $ G , z ∊ {x | x ∊ ω ∧ ((b = ∅ ∧ x = ∅) ∨ (∅ ∈ b ∧ ∃ y (y ∊ b ∧ nadd (nmul x b) y = a)))} ⇒ z ∊ ω $ by and_elim_l [l2]
l4: $ G ⇒ {x | x ∊ ω ∧ ((b = ∅ ∧ x = ∅) ∨ (∅ ∈ b ∧ ∃ y (y ∊ b ∧ nadd (nmul x b) y = a)))} ⊆ ω $ by subset_intro [l3]
l5: $ G ⇒ isset ω $ by omega_set
l6: $ G ⇒ isset {x | x ∊ ω ∧ ((b = ∅ ∧ x = ∅) ∨ (∅ ∈ b ∧ ∃ y (y ∊ b ∧ nadd (nmul x b) y = a)))} $ by subset_isset [l5, l4]
l7: $ G ⇒ isset (⋃ {x | x ∊ ω ∧ ((b = ∅ ∧ x = ∅) ∨ (∅ ∈ b ∧ ∃ y (y ∊ b ∧ nadd (nmul x b) y = a)))}) $ by cuni_set [l6]

--| The step of Euclid's existence proof: from `u·b + v = y` with `v < b`, a
--| quotient and remainder for `z = suc y`.
lemma q2_ex_step {q r: set} (G: hyps q r) (b y z u v: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ ∅ ∈ b $ > $ G ⇒ u ∊ ω $ > $ G ⇒ v ∊ b $ > $ G ⇒ nadd (nmul u b) v = y $ > $ G ⇒ z = suc y $ >
  $ G ⇒ ∃ q ∃ r (q ∊ ω ∧ r ∊ b ∧ nadd (nmul q b) r = z) $
----
l1: $ G ⇒ v ∊ ω $ by omega_elem_omega [#1, #4]
l2: $ G ⇒ suc v ⊆ b $ by omega_elem_suc_subset [l1, #1, #4]
l3: $ G ⇒ isset (nmul u b) $ by nmul_set
l4a: $ G ⇒ isset v $ by isset_var
l4: $ G ⇒ isset (suc v) $ by suc_set [l4a]
d1: $ G , k = nmul u b , w = suc v ⇒ k = nmul u b $ by ax
d2: $ G , k = nmul u b , w = suc v ⇒ w = suc v $ by ax
d3a: $ G , k = nmul u b , w = suc v ⇒ v = v $ by eq_refl
d3: $ G , k = nmul u b , w = suc v ⇒ nadd k v = nadd (nmul u b) v $ by nadd_eq [d1, d3a]
d4: $ G , k = nmul u b , w = suc v ⇒ nadd (nmul u b) v = y $ by weaken [#5]
d5: $ G , k = nmul u b , w = suc v ⇒ nadd k v = y $ by eq_trans [d3, d4]
d6: $ G , k = nmul u b , w = suc v ⇒ suc v = w $ by eq_sym [d2]
d7: $ G , k = nmul u b , w = suc v ⇒ suc v ⊆ b $ by weaken [l2]
d8: $ G , k = nmul u b , w = suc v ⇒ w ⊆ b $ by subset_eq_l [d6, d7]
d9: $ G , k = nmul u b , w = suc v ⇒ v ∊ ω $ by weaken [l1]
d10: $ G , k = nmul u b , w = suc v ⇒ suc v ∈ ω $ by omega_suc [d9]
d11: $ G , k = nmul u b , w = suc v ⇒ w ∈ ω $ by wcel_eq_l [d6, d10]
d12: $ G , k = nmul u b , w = suc v ⇒ w ∊ ω $ by wcel_welc [d11]
d13: $ G , k = nmul u b , w = suc v ⇒ b ∊ ω $ by weaken [#1]
d14: $ G , k = nmul u b , w = suc v ⇒ w ∊ b ∨ w = b $ by nle_lt_or_eq [d12, d13, d8]
d15a: $ G , k = nmul u b , w = suc v ⇒ k = k $ by eq_refl
d15: $ G , k = nmul u b , w = suc v ⇒ nadd k w = nadd k (suc v) $ by nadd_eq [d15a, d2]
