a1b: $ G , k = nmul u b , w = suc v , w ∊ b ⇒ w = w $ by eq_refl
a1: $ G , k = nmul u b , w = suc v , w ∊ b ⇒ nadd (nmul u b) w = nadd k w $ by nadd_eq [a1a, a1b]
