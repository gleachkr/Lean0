b14: $ G , z = ∅ ⇒ nadd ∅ z = z $ by zero_nadd [b5]
b15: $ G , z = ∅ ⇒ nadd (nmul z b) z = z $ by eq_trans [b13, b14]
b16a: $ G , z = ∅ ⇒ z ∊ b ∧ nadd (nmul z b) z = z $ by and_intro [b8, b15]
b16: $ G , z = ∅ ⇒ z ∊ ω ∧ z ∊ b ∧ nadd (nmul z b) z = z $ by and_intro [b5, b16a]
