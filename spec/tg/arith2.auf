b12: $ G , k = nmul u b , w = suc v , w = b , i = suc u , j = ∅ ⇒ b ∊ ω $ by weaken [#1]
b13: $ G , k = nmul u b , w = suc v , w = b , i = suc u , j = ∅ ⇒ nmul (suc u) b = nadd (nmul u b) b $ by suc_nmul [b4, b12]
b14a: $ G , k = nmul u b , w = suc v , w = b , i = suc u , j = ∅ ⇒ nmul u b = k $ by weaken [d21]
b14b: $ G , k = nmul u b , w = suc v , w = b , i = suc u , j = ∅ ⇒ b = w $ by eq_sym [b3]
b14: $ G , k = nmul u b , w = suc v , w = b , i = suc u , j = ∅ ⇒ nadd (nmul u b) b = nadd k w $ by nadd_eq [b14a, b14b]
b15: $ G , k = nmul u b , w = suc v , w = b , i = suc u , j = ∅ ⇒ nadd k w = z $ by weaken [d20]
