d17: $ G , k = nmul u b , w = suc v ⇒ suc (nadd k v) = suc y $ by suc_eq [d5]
d18: $ G , k = nmul u b , w = suc v ⇒ z = suc y $ by weaken [#6]
d19: $ G , k = nmul u b , w = suc v ⇒ suc y = z $ by eq_sym [d18]
d20a: $ G , k = nmul u b , w = suc v ⇒ nadd k w = suc (nadd k v) $ by eq_trans [d15, d16]
