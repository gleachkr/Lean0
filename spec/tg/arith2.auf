l2: $ G ⇒ w = w $ by eq_refl
l3: $ G ⇒ ndvd w (nmod v x) $ by ndvd_eq [l2, #3, #5]
l4: $ G ⇒ ndvd w v $ by ndvd_of_nmod [#4, #1, #2, #6, l3]
