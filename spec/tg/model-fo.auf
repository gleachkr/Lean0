l1: $ [x/t] ((∃ e ((e ∊ A) ∧ ((r_empty A e) ∧ (e ∈ B)))) ∧ (∀ n ((n ∊ A) → ((n ∈ B) → (∃ y ((y ∊ A) ∧ ((r_succ A y n) ∧ (y ∈ B)))))))) ⟺ ((∃ e ((e ∊ (⟦ x / t ⟧ A)) ∧ ((r_empty (⟦ x / t ⟧ A) e) ∧ (e ∈ (⟦ x / t ⟧ B))))) ∧ (∀ n ((n ∊ (⟦ x / t ⟧ A)) → ((n ∈ (⟦ x / t ⟧ B)) → (∃ y ((y ∊ (⟦ x / t ⟧ A)) ∧ ((r_succ (⟦ x / t ⟧ A) y n) ∧ (y ∈ (⟦ x / t ⟧ B))))))))) $ by iff_refl

