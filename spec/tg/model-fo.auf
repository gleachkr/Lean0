g32: $ ((r_sub A a p) → ((∃ f ((f ∊ A) ∧ (r_inj A f a w))) ∨ (∃ f ((f ∊ A) ∧ (r_inj A f p a))))) ⟺ ((r_sub B a p) → ((∃ f ((f ∊ B) ∧ (r_inj B f a w))) ∨ (∃ f ((f ∊ B) ∧ (r_inj B f p a))))) $ by im_congr [g14, g31]
g33: $ ((a ∊ A) → ((r_sub A a p) → ((∃ f ((f ∊ A) ∧ (r_inj A f a w))) ∨ (∃ f ((f ∊ A) ∧ (r_inj A f p a)))))) ⟺ ((a ∊ B) → ((r_sub B a p) → ((∃ f ((f ∊ B) ∧ (r_inj B f a w))) ∨ (∃ f ((f ∊ B) ∧ (r_inj B f p a)))))) $ by im_congr [g11, g32]
g34: $ (∀ a ((a ∊ A) → ((r_sub A a p) → ((∃ f ((f ∊ A) ∧ (r_inj A f a w))) ∨ (∃ f ((f ∊ A) ∧ (r_inj A f p a))))))) ⟺ (∀ a ((a ∊ B) → ((r_sub B a p) → ((∃ f ((f ∊ B) ∧ (r_inj B f a w))) ∨ (∃ f ((f ∊ B) ∧ (r_inj B f p a))))))) $ by all_congr [g33]
