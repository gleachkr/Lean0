ch_fm
-----
l1: $ _ ⇒ ∅ ∈ ω $ by omega_zero
l2: $ _ ⇒ ch_code ∈ fm ∅ $ by fm_ch [l1]

ch_sat
------
l1: $ G ⇒ ∅ ∈ fseq U $ by fseq_empty
l2: $ G ⇒ ∅ ∈ ω $ by omega_zero
l3: $ G ⇒ ⟪ U , ∅ ⊨ ch_code ⟫ ↔ r_ch U $ by sat_ch [#1, l1, l2]

ch_readback
-----------
l1: $ _ ⇒ ch_code ∈ fm ∅ $ by ch_fm
l2: $ _ ⇒ fv uni (suc ∅) ⊨ ch_code $ by pset_readback_c [#1, l1, #2, #3]
l3: $ _ ⇒ functional uni $ by uni_functional
l4: $ _ ⇒ isset ∅ $ by ax_empty
l5: $ _ ⇒ isset (fv uni (suc ∅)) $ by fv_set_c [l3, suc_set [l4]]
l6: $ _ ⇒ fv uni (suc ∅) ⊨ ch_code ↔ r_ch (fv uni (suc ∅)) $ by ch_sat [l5]
l7: $ _ ⇒ r_ch (fv uni (suc ∅)) $ by bi_elim_l [l6, l2]

nch_readback
------------
l1: $ _ ⇒ ch_code ∈ fm ∅ $ by ch_fm
l2: $ _ ⇒ ∅ ∈ ω $ by omega_zero
l3: $ _ ⇒ (¬ₒ ch_code) ∈ fm ∅ $ by fm_not [l2, l1]
l4: $ _ ⇒ fv uni (suc ∅) ⊨ (¬ₒ ch_code) $ by pset_readback_c [#1, l3, #2, #3]
l5: $ _ ⇒ functional uni $ by uni_functional
l6: $ _ ⇒ isset ∅ $ by ax_empty
l7: $ _ ⇒ isset (fv uni (suc ∅)) $ by fv_set_c [l5, suc_set [l6]]
l8: $ _ ⇒ ∅ ∈ fseq (fv uni (suc ∅)) $ by fseq_empty
l9: $ _ ⇒ isset ∅ $ by ax_empty
l10: $ _ ⇒ ch_code ∈ trees ω $ by and_elim_r [fm_tree [l1, l9]]
l11: $ _ ⇒ ⟪ fv uni (suc ∅) , ∅ ⊨ ¬ₒ ch_code ⟫ ↔ ¬ ⟪ fv uni (suc ∅) , ∅ ⊨ ch_code ⟫ $ by fsat_not_c [l7, l8, l10]
l12: $ _ ⇒ ¬ ⟪ fv uni (suc ∅) , ∅ ⊨ ch_code ⟫ $ by bi_elim_l [l11, l4]
l13: $ _ ⇒ ⟪ fv uni (suc ∅) , ∅ ⊨ ch_code ⟫ ↔ r_ch (fv uni (suc ∅)) $ by sat_ch [l7, l8, l2]
l14: $ _ ⇒ ¬ r_ch (fv uni (suc ∅)) $ by bi_elim_l [lg_not [l13], l12]
