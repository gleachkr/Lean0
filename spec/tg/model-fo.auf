l110: $ G , x1 = suc ∅ , x2 = scons p (scons q ∅) , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) p → a ∈ fv (fsf A) q ⇒ (x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅))) ∨ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) $ by or_intro_l [l109]
l111: $ G , x1 = suc ∅ , x2 = scons p (scons q ∅) , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) p → a ∈ fv (fsf A) q ⇒ a ∊ fseq A $ by weaken [#2]
l112: $ G , x1 = suc ∅ , x2 = scons p (scons q ∅) , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) p → a ∈ fv (fsf A) q ⇒ a ∊ fseq A ∧ ((x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅))) ∨ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5))) $ by and_intro [l111, l110]
l113: $ G , x1 = suc ∅ , x2 = scons p (scons q ∅) , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) p → a ∈ fv (fsf A) q ⇒ a ∊ fsb A x1 x2 x3 $ by cab_intro [l112]
