l111: $ G ⇒ (∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (∀ₒ p) e) w r ↔ ⟪ fv uni (suc ∅) , a ⊨ ∀ₒ p ⟫) ∧ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (∀ₒ p) e) w r ∈ two ∧ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (∀ₒ p) e ∈ trees ω $ by and_intro [l102, l110]

lemma sl_c (G: hyps) (A B S: class): $ G ⇒ S ∈ fseq A $ > $ G ⇒ isset B $ > $ G ⇒ cdm (scons B S) = suc (cdm S) $
----
l1: $ G , c = B , d = S ⇒ c = B $ by ax
l2: $ G , c = B , d = S ⇒ d = S $ by ax
l3: $ G , c = B , d = S ⇒ d ∊ fseq A $ by wcel_welc [wcel_eq_l [eq_sym [l2], weaken [#1]]]
l4: $ G , c = B , d = S ⇒ cdm (scons c d) = suc (cdm d) $ by scons_len [l3]
l5: $ G , c = B , d = S ⇒ cdm (scons B S) = suc (cdm S) $ by eq_trans [cdm_eq [scons_eq [eq_sym [l1], eq_sym [l2]]], eq_trans [l4, suc_eq [cdm_eq [l2]]]]
l6: $ G , c = B ⇒ isset S $ by wcel_isset [weaken [#1]]
l7: $ G , c = B ⇒ cdm (scons B S) = suc (cdm S) $ by isset_elim [l6, l5]
l8: $ G ⇒ isset B $ by weaken [#2]
l9: $ G ⇒ cdm (scons B S) = suc (cdm S) $ by isset_elim [l8, l7]

--| @freshen G i
lemma hy_imp {i: set} (G: hyps) (b: blk) (u w r e a n x: set): $ G ⇒ e ∊ fseq (trees ω) $ > $ G ⇒ cdm e = n $ > $ G ⇒ ∀ i (i ∊ n → fv r (fv nvf (fv e i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i)))) $ > $ G ⇒ ∀ i (i ∊ n → fv (scons x r) (fv nvf (fv (lup e) i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (lup e) i)))) $
----
l1: $ G , i ∊ n ⇒ i ∊ n $ by ax
l2: $ G , i ∊ n ⇒ i ∊ cdm e $ by welc_eq [eq_sym [weaken [#2]], l1]
l3: $ G , i ∊ n ⇒ ∀ i (i ∊ n → fv r (fv nvf (fv e i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i)))) $ by weaken [#3]
l4: $ G , i ∊ n ⇒ i ∊ n $ by ax
l5: $ G , i ∊ n ⇒ fv r (fv nvf (fv e i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i))) $ by imp_elim [all_elim [l3], l4]
l6: $ G , i ∊ n ⇒ fv r (fv nvf (fv e i)) ∈ psv u w b $ by and_elim_l [l5]
l7: $ G , i ∊ n ⇒ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i))) $ by and_elim_r [l5]
l8: $ G , i ∊ n ⇒ fv (scons x r) (fv nvf (fv (lup e) i)) = fv r (fv nvf (fv e i)) $ by lu_ix [weaken [#1], l2]
l9: $ G , i ∊ n ⇒ fv (scons x r) (fv nvf (fv (lup e) i)) ∈ psv u w b $ by wcel_eq_l [eq_sym [l8], l6]
l10: $ G , i ∊ n ⇒ (pcol u w b) = (pcol u w b) $ by eq_refl
l11: $ G , i ∊ n ⇒ fv a i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (lup e) i))) $ by eq_trans [l7, fv_eq [l10, eq_sym [l8]]]
l12: $ G , i ∊ n ⇒ fv (scons x r) (fv nvf (fv (lup e) i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (lup e) i))) $ by and_intro [l9, l11]
l13: $ G ⇒ i ∊ n → fv (scons x r) (fv nvf (fv (lup e) i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (lup e) i))) $ by imp_intro [l12]
l14: $ G ⇒ ∀ i (i ∊ n → fv (scons x r) (fv nvf (fv (lup e) i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (lup e) i)))) $ by all_intro [l13]

--| @freshen G i
lemma hy_all {i: set} (G: hyps) (b: blk) (u w r e a n x: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ e ∊ fseq (trees ω) $ > $ G ⇒ cdm e = n $ > $ G ⇒ n ∊ ω $ > $ G ⇒ x ∊ psv u w b $ > $ G ⇒ ∀ i (i ∊ n → fv r (fv nvf (fv e i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i)))) $ > $ G ⇒ ∀ i (i ∊ suc n → fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b ∧ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)))) $
----
l1: $ G , i ∊ suc n ⇒ i ∊ suc n $ by ax
l2: $ G , i ∊ suc n ⇒ i = ∅ ∨ ∃ m (m ∊ n ∧ i = suc m) $ by om_pred [weaken [#5], l1]
l3: $ G ⇒ lup e ∈ fseq (trees ω) ∧ cdm (lup e) = cdm e $ by lu_fs [#3]
l4: $ G ⇒ isset (lup e) $ by wcel_isset [and_elim_l [l3]]
l5: $ G ⇒ fv (pcol u w b) x ∈ fv uni (suc ∅) $ by pcol_val [#1, #2, #6]
l6: $ G ⇒ isset (fv (pcol u w b) x) $ by wcel_isset [l5]
l7: $ G , i ∊ suc n , i = ∅ ⇒ i = ∅ $ by ax
l8: $ G , i ∊ suc n , i = ∅ ⇒ (scons ⟨ kc_nz , ∅ ⟩ (lup e)) = (scons ⟨ kc_nz , ∅ ⟩ (lup e)) $ by eq_refl
l9: $ G , i ∊ suc n , i = ∅ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l10: $ G , i ∊ suc n , i = ∅ ⇒ isset (lup e) $ by weaken [l4]
l11: $ G , i ∊ suc n , i = ∅ ⇒ fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [fv_eq [l8, l7], scons_fv_zero_c [l9, l10]]
l12: $ G , i ∊ suc n , i = ∅ ⇒ nvf = nvf $ by eq_refl
l13: $ G , i ∊ suc n , i = ∅ ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l14: $ G , i ∊ suc n , i = ∅ ⇒ fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i) = ∅ $ by eq_trans [fv_eq [l12, l11], l13]
l15: $ G , i ∊ suc n , i = ∅ ⇒ (scons x r) = (scons x r) $ by eq_refl
l16: $ G , i ∊ suc n , i = ∅ ⇒ fv (scons x r) ∅ = x $ by scons_fv_zero
l17: $ G , i ∊ suc n , i = ∅ ⇒ fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) = x $ by eq_trans [fv_eq [l15, l14], l16]
l18: $ G , i ∊ suc n , i = ∅ ⇒ (scons (fv (pcol u w b) x) a) = (scons (fv (pcol u w b) x) a) $ by eq_refl
l19: $ G , i ∊ suc n , i = ∅ ⇒ isset (fv (pcol u w b) x) $ by weaken [l6]
l20: $ G , i ∊ suc n , i = ∅ ⇒ isset a $ by isset_var
l21: $ G , i ∊ suc n , i = ∅ ⇒ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) x $ by eq_trans [fv_eq [l18, l7], scons_fv_zero_c [l19, l20]]
l22: $ G , i ∊ suc n , i = ∅ ⇒ x ∈ psv u w b $ by welc_wcel [weaken [#6]]
l23: $ G , i ∊ suc n , i = ∅ ⇒ fv (pcol u w b) x = fv (pcol u w b) x $ by eq_refl
l24: $ G , i ∊ suc n , i = ∅ ⇒ fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b $ by wcel_eq_l [eq_sym [l17], l22]
l25: $ G , i ∊ suc n , i = ∅ ⇒ (pcol u w b) = (pcol u w b) $ by eq_refl
l26: $ G , i ∊ suc n , i = ∅ ⇒ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i))) $ by eq_trans [l21, eq_trans [l23, fv_eq [l25, eq_sym [l17]]]]
l27: $ G , i ∊ suc n , i = ∅ ⇒ fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b ∧ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i))) $ by and_intro [l24, l26]
l28: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) ⇒ ∃ m (m ∊ n ∧ i = suc m) $ by ax
l29: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ m ∊ n ∧ i = suc m $ by ax
l30: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ m ∊ n $ by and_elim_l [l29]
l31: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ i = suc m $ by and_elim_r [l29]
l32: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ m ∊ cdm e $ by welc_eq [eq_sym [weaken [#4]], l30]
l33: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ ∀ i (i ∊ n → fv r (fv nvf (fv e i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i)))) $ by weaken [#7]
l34: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv r (fv nvf (fv e m)) ∈ psv u w b ∧ fv a m = fv (pcol u w b) (fv r (fv nvf (fv e m))) $ by imp_elim [all_elim [l33], l30]
l35: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv r (fv nvf (fv e m)) ∈ psv u w b $ by and_elim_l [l34]
l36: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv a m = fv (pcol u w b) (fv r (fv nvf (fv e m))) $ by and_elim_r [l34]
l37: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ (scons ⟨ kc_nz , ∅ ⟩ (lup e)) = (scons ⟨ kc_nz , ∅ ⟩ (lup e)) $ by eq_refl
l38: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l39: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ isset (lup e) $ by weaken [l4]
l40: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ isset m $ by isset_var
l41: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i = fv (lup e) m $ by eq_trans [fv_eq [l37, l31], scons_fv_suc_c [l38, l39, l40]]
l42: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ (scons x r) = (scons x r) $ by eq_refl
l43: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ nvf = nvf $ by eq_refl
l44: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) = fv r (fv nvf (fv e m)) $ by eq_trans [fv_eq [l42, fv_eq [l43, l41]], lu_ix [weaken [#3], l32]]
l45: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ (scons (fv (pcol u w b) x) a) = (scons (fv (pcol u w b) x) a) $ by eq_refl
l46: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ isset (fv (pcol u w b) x) $ by weaken [l6]
l47: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ isset a $ by isset_var
l48: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ isset m $ by isset_var
l49: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv (scons (fv (pcol u w b) x) a) i = fv a m $ by eq_trans [fv_eq [l45, l31], scons_fv_suc_c [l46, l47, l48]]
l50: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b $ by wcel_eq_l [eq_sym [l44], l35]
l51: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ (pcol u w b) = (pcol u w b) $ by eq_refl
l52: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i))) $ by eq_trans [l49, eq_trans [l36, fv_eq [l51, eq_sym [l44]]]]
l53: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) , m ∊ n ∧ i = suc m ⇒ fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b ∧ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i))) $ by and_intro [l50, l52]
l54: $ G , i ∊ suc n , ∃ m (m ∊ n ∧ i = suc m) ⇒ fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b ∧ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i))) $ by ex_elim [l28, l53]
l55: $ G , i ∊ suc n ⇒ fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b ∧ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i))) $ by or_elim [l2, l27, l54]
l56: $ G ⇒ i ∊ suc n → fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b ∧ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i))) $ by imp_intro [l55]
l57: $ G ⇒ ∀ i (i ∊ suc n → fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)) ∈ psv u w b ∧ fv (scons (fv (pcol u w b) x) a) i = fv (pcol u w b) (fv (scons x r) (fv nvf (fv (scons ⟨ kc_nz , ∅ ⟩ (lup e)) i)))) $ by all_intro [l56]

lemma fm_lfp {x: set} (G: hyps): $ G ⇒ mono x (fmop x) ∧ setop x (fmop x) ∧ bounded x (fmop x) (ω × trees ω) ∧ isset (ω × trees ω) $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ isset (ω × trees ω) $ by cxp_set [l1, trees_set_c [l2]]
l4: $ G , x1 ⊆ x2 ⇒ x1 ⊆ x2 $ by ax
l5: $ G , x1 ⊆ x2 , z ∊ fmop x1 ⇒ z ∊ fmop x1 $ by ax
l6: $ G , x1 ⊆ x2 , z ∊ fmop x1 ⇒ z ∊ ω × trees ω ∧ ∃ m (m ∊ ω ∧ (z = ⟨ m , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ m , p →ₒ q ⟩ ∧ ⟨ m , p ⟩ ∈ x1 ∧ ⟨ m , q ⟩ ∈ x1) ∨ ∃ p (z = ⟨ m , ∀ₒ p ⟩ ∧ ⟨ suc m , p ⟩ ∈ x1) ∨ ∃ x4 ∃ x5 (x4 ∊ m ∧ x5 ∊ m ∧ (z = ⟨ m , x4 =ₒ x5 ⟩ ∨ z = ⟨ m , x4 ∈ₒ x5 ⟩)))) $ by cab_elim [l5]
l7: $ G , x1 ⊆ x2 , z ∊ fmop x1 ⇒ z ∊ ω × trees ω $ by and_elim_l [l6]
l8: $ G , x1 ⊆ x2 , z ∊ fmop x1 ⇒ ∃ m (m ∊ ω ∧ (z = ⟨ m , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ m , p →ₒ q ⟩ ∧ ⟨ m , p ⟩ ∈ x1 ∧ ⟨ m , q ⟩ ∈ x1) ∨ ∃ p (z = ⟨ m , ∀ₒ p ⟩ ∧ ⟨ suc m , p ⟩ ∈ x1) ∨ ∃ x4 ∃ x5 (x4 ∊ m ∧ x5 ∊ m ∧ (z = ⟨ m , x4 =ₒ x5 ⟩ ∨ z = ⟨ m , x4 ∈ₒ x5 ⟩)))) $ by and_elim_r [l6]
l9: $ G , x1 ⊆ x2 , z ∊ fmop x1 , m ∊ ω ∧ (z = ⟨ m , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ m , p →ₒ q ⟩ ∧ ⟨ m , p ⟩ ∈ x1 ∧ ⟨ m , q ⟩ ∈ x1) ∨ ∃ p (z = ⟨ m , ∀ₒ p ⟩ ∧ ⟨ suc m , p ⟩ ∈ x1) ∨ ∃ x4 ∃ x5 (x4 ∊ m ∧ x5 ∊ m ∧ (z = ⟨ m , x4 =ₒ x5 ⟩ ∨ z = ⟨ m , x4 ∈ₒ x5 ⟩))) ⇒ m ∊ ω ∧ (z = ⟨ m , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ m , p →ₒ q ⟩ ∧ ⟨ m , p ⟩ ∈ x1 ∧ ⟨ m , q ⟩ ∈ x1) ∨ ∃ p (z = ⟨ m , ∀ₒ p ⟩ ∧ ⟨ suc m , p ⟩ ∈ x1) ∨ ∃ x4 ∃ x5 (x4 ∊ m ∧ x5 ∊ m ∧ (z = ⟨ m , x4 =ₒ x5 ⟩ ∨ z = ⟨ m , x4 ∈ₒ x5 ⟩))) $ by ax
