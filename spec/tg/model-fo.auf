fsat_all
--------
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) $ by cgr3_functional
l3: $ G ⇒ functional (fsf A) $ by trc_functional_c [l1, l2]
l4: $ G ⇒ cdm (fsf A) = trees ω $ by trc_cdm_c [l1, l2]
l5: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ x1 = suc (suc ∅) $ by ax
l6: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ x2 = scons p ∅ $ by ax
l7: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ x3 = ccom (fsf A) x2 $ by ax
l8: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ ∅ ∈ ω $ by omega_zero
l9: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ suc ∅ ∈ ω $ by omega_suc_c [l8]
l10: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ suc (suc ∅) ∈ ω $ by omega_suc_c [l9]
l11: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ x1 ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l5], l10]]
l12: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l13: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ p ∈ trees ω $ by welc_wcel [weaken [#3]]
