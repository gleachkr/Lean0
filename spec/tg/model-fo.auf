l51: $ G , ¬ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) , ¬ ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) ⇒ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) $ by all_intro [l50]
l52: $ G , ¬ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) , ¬ ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) ⇒ ¬ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) $ by ax
l53: $ G , ¬ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) , ¬ ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) ⇒ ⊥ $ by not_elim [l52, l51]
l54: $ G , ¬ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) ⇒ ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) $ by by_contra [l53]
l55: $ G , ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) , ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) ⇒ ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) $ by ax
l56: $ G , ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) , ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) , x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫) ⇒ x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫) $ by ax
l57: $ G , ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) , ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) , x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫) ⇒ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) $ by ax
l58: $ G , ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) , ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) , x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫) ⇒ x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫) $ by all_elim [l57]
l59: $ G , ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) , ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) , x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫) ⇒ ⊥ $ by not_elim [imp_elim [l58, and_elim_l [l56]], and_elim_r [l56]]
l60: $ G , ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) , ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) ⇒ ⊥ $ by ex_elim [l55, l59]
l61: $ G , ∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫)) ⇒ ¬ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫)) $ by not_intro [l60]
l62: $ G ⇒ (¬ ∀ x (x ∊ A → ¬ (⟪ A , scons x S ⊨ P ⟫))) ↔ (∃ x (x ∊ A ∧ (⟪ A , scons x S ⊨ P ⟫))) $ by bi_intro [l54, l61]
l63: $ G ⇒ ⟪ A , S ⊨ ∃ₒ P ⟫ ↔ ∃ x (x ∊ A ∧ ⟪ A , scons x S ⊨ P ⟫) $ by bi_trans [l16, bi_trans [l42, l62]]

fm_not
------
l1: $ G ⇒ ⊥ₒ ∈ fm N $ by fm_bot [#1]
l2: $ G ⇒ (¬ₒ P) ∈ fm N $ by fm_imp [#1, #2, l1]

fm_and
------
l1: $ G ⇒ (¬ₒ Q) ∈ fm N $ by fm_not [#1, #3]
l2: $ G ⇒ (P →ₒ ¬ₒ Q) ∈ fm N $ by fm_imp [#1, #2, l1]
l3: $ G ⇒ (P ∧ₒ Q) ∈ fm N $ by fm_not [#1, l2]

fm_or
-----
l1: $ G ⇒ (¬ₒ P) ∈ fm N $ by fm_not [#1, #2]
l2: $ G ⇒ (P ∨ₒ Q) ∈ fm N $ by fm_imp [#1, l1, #3]

fm_iff
------
l1: $ G ⇒ (P →ₒ Q) ∈ fm N $ by fm_imp [#1, #2, #3]
l2: $ G ⇒ (Q →ₒ P) ∈ fm N $ by fm_imp [#1, #3, #2]
l3: $ G ⇒ (P ↔ₒ Q) ∈ fm N $ by fm_and [#1, l1, l2]

fm_ex
-----
l1: $ G ⇒ suc N ∈ ω $ by omega_suc_c [#1]
l2: $ G ⇒ (¬ₒ P) ∈ fm (suc N) $ by fm_not [l1, #2]
l3: $ G ⇒ (∀ₒ ¬ₒ P) ∈ fm N $ by fm_all [#1, l2]
l4: $ G ⇒ (∃ₒ P) ∈ fm N $ by fm_not [#1, l3]

lemma zs (G: hyps) (X: class): $ G ⇒ X ∈ ω $ > $ G ⇒ ∅ ∈ suc X $
----
l1: $ G , x = X ⇒ x = X $ by ax
l2: $ G , x = X ⇒ x ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l1], weaken [#1]]]
l3: $ G , x = X ⇒ ∅ ∈ x ∨ ∅ = x $ by omega_zero_le [l2]
l4: $ G , x = X , ∅ ∈ x ⇒ ∅ ∈ x $ by ax
l5: $ G , x = X , ∅ ∈ x ⇒ ∅ ∈ suc x $ by suc_mem_r [l4]
l6: $ G , x = X , ∅ = x ⇒ ∅ = x $ by ax
l7: $ G , x = X , ∅ = x ⇒ isset x $ by isset_var
l8: $ G , x = X , ∅ = x ⇒ ∅ ∈ suc x $ by wcel_eq_l [eq_sym [l6], suc_mem [l7]]
l9: $ G , x = X ⇒ ∅ ∈ suc x $ by or_elim [l3, l5, l8]
l10: $ G , x = X ⇒ ∅ ∈ suc X $ by wcel_eq_r [suc_eq [l1], l9]
l11: $ G ⇒ isset X $ by wcel_isset [#1]
l12: $ G ⇒ ∅ ∈ suc X $ by isset_elim [l11, l10]

c_sub_congr
-----------
g1: $ ∅ ≐ ∅ $ by ceqt_refl
g2: $ (suc A) ≐ (suc B) $ by suc_congr [#1]
g3: $ (fin ∅ (suc A)) ≐ (fin ∅ (suc B)) $ by fin_congr [g1, g2]
g4: $ ∅ ≐ ∅ $ by ceqt_refl
g5: $ (suc C) ≐ (suc D) $ by suc_congr [#2]
g6: $ (fin ∅ (suc C)) ≐ (fin ∅ (suc D)) $ by fin_congr [g4, g5]
g7: $ (fimp (fin ∅ (suc A)) (fin ∅ (suc C))) ≐ (fimp (fin ∅ (suc B)) (fin ∅ (suc D))) $ by fimp_congr [g3, g6]
g8: $ c_sub A C ≐ c_sub B D $ by fall_congr [g7]

sb_c_c_sub
----------
l1: $ (⟦ x / t ⟧ fall (fimp (fin ∅ (suc A)) (fin ∅ (suc B)))) ≐ fall (fimp (fin ∅ (suc (⟦ x / t ⟧ A))) (fin ∅ (suc (⟦ x / t ⟧ B)))) $ by ceqt_refl

r_sub_congr
-----------
g1: $ seqt z z $ by seqt_refl
g2: $ (z ∊ A) ⟺ (z ∊ B) $ by welc_congr [g1, #1]
g3: $ z ≐ z $ by ceqt_refl
g4: $ (z ∈ C) ⟺ (z ∈ D) $ by wcel_congr [g3, #2]
g5: $ z ≐ z $ by ceqt_refl
g6: $ (z ∈ E) ⟺ (z ∈ F) $ by wcel_congr [g5, #3]
g7: $ ((z ∈ C) → (z ∈ E)) ⟺ ((z ∈ D) → (z ∈ F)) $ by im_congr [g4, g6]
g8: $ ((z ∊ A) → ((z ∈ C) → (z ∈ E))) ⟺ ((z ∊ B) → ((z ∈ D) → (z ∈ F))) $ by im_congr [g2, g7]
g9: $ r_sub A C E ⟺ r_sub B D F $ by all_congr [g8]

sb_f_r_sub
----------
l1: $ [x/t] (∀ z ((z ∊ A) → ((z ∈ B) → (z ∈ C)))) ⟺ (∀ z ((z ∊ (⟦ x / t ⟧ A)) → ((z ∈ (⟦ x / t ⟧ B)) → (z ∈ (⟦ x / t ⟧ C))))) $ by iff_refl

