l8: $ _ , uadm u , w = clam l ω ∅ ⇒ isset ω $ by omega_set
l9: $ _ , uadm u , w = clam l ω ∅ ⇒ isset (clam l ω ∅) $ by clam_set [l8, l7]
l10: $ _ , uadm u , w = clam l ω ∅ ⇒ clam l ω ∅ ∈ cpi l ω ω $ by clam_cpi_intro [l9, l4]
l11: $ _ , uadm u , w = clam l ω ∅ ⇒ w ∊ lvals $ by wcel_welc [wcel_eq_l [eq_sym [l1], l10]]
l12: $ _ , uadm u , w = clam l ω ∅ ⇒ uadm u $ by ax
l13: $ _ , uadm u , w = clam l ω ∅ ⇒ C ∈ fm ∅ $ by weaken [#2]
l14: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ q = ∅ $ by ax
l15: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ c = C $ by ax
l16: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ w ∊ lvals $ by weaken [l11]
l17: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ sat u (mcv hfin) (enc_ctx nil) w = csn ∅ $ by sat_nil [l16]
l18: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ q ∊ sat u (mcv hfin) (enc_ctx nil) w $ by welc_eq [eq_sym [l17], csn_intro [l14]]
l19: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ C ∈ fm ∅ $ by weaken [l13]
l20: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ c ∊ fm ∅ $ by wcel_welc [wcel_eq_l [eq_sym [l15], l19]]
l21: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ uadm u $ by weaken [l12]
l22: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ w ∊ lvals $ by weaken [l11]
l23: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ ∃ z (z ∊ dt u (mcv hfin) (lsent b E M c) w ∅) ↔ fv uni (suc ∅) ⊨ c $ by pset_truth [#1, l21, l22, l20]
l24: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ ∀ yy2 (uadm yy2 → ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat yy2 (mcv hfin) (enc_ctx nil) yy3 → ∃ z (z ∊ dt yy2 (mcv hfin) (enc_expr T) yy3 yy4)))) $ by weaken [#4]
l25: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ uadm u $ by weaken [l12]
l26: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat u (mcv hfin) (enc_ctx nil) yy3 → ∃ z (z ∊ dt u (mcv hfin) (enc_expr T) yy3 yy4))) $ by imp_elim [all_elim [l24], l25]
l27: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ w ∊ lvals $ by weaken [l11]
l28: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ ∀ yy4 (yy4 ∊ sat u (mcv hfin) (enc_ctx nil) w → ∃ z (z ∊ dt u (mcv hfin) (enc_expr T) w yy4)) $ by imp_elim [all_elim [l26], l27]
l29: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ ∃ z (z ∊ dt u (mcv hfin) (enc_expr T) w q) $ by imp_elim [all_elim [l28], l18]
l30: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ (ltf (enc_expr (pset b)) (enc_expr E) (enc_expr M)) = (ltf (enc_expr (pset b)) (enc_expr E) (enc_expr M)) $ by eq_refl
l31: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ ∅ = ∅ $ by eq_refl
l32: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ lsent b E M C = lsent b E M c $ by ap_eq [fv_eq [l30, eq_sym [l15]], l31]
l33: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ u = u $ by eq_refl
l34: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ (mcv hfin) = (mcv hfin) $ by eq_refl
l35: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ enc_expr T = lsent b E M C $ by weaken [#3]
l36: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ w = w $ by eq_refl
l37: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ dt u (mcv hfin) (enc_expr T) w q = dt u (mcv hfin) (lsent b E M c) w ∅ $ by dt_eq [l33, l34, eq_trans [l35, l32], l36, l14]
l38: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C , z ∊ dt u (mcv hfin) (enc_expr T) w q ⇒ dt u (mcv hfin) (enc_expr T) w q = dt u (mcv hfin) (lsent b E M c) w ∅ $ by weaken [l37]
l39: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C , z ∊ dt u (mcv hfin) (enc_expr T) w q ⇒ z ∊ dt u (mcv hfin) (enc_expr T) w q $ by ax
l40: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C , z ∊ dt u (mcv hfin) (enc_expr T) w q ⇒ ∃ z (z ∊ dt u (mcv hfin) (lsent b E M c) w ∅) $ by ex_intro [welc_eq [l38, l39]]
l41: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ ∃ z (z ∊ dt u (mcv hfin) (lsent b E M c) w ∅) $ by ex_elim [l29, l40]
l42: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ fv uni (suc ∅) ⊨ c $ by bi_elim_l [l23, l41]
l43: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ (fsf (fv uni (suc ∅))) = (fsf (fv uni (suc ∅))) $ by eq_refl
l44: $ _ , uadm u , w = clam l ω ∅ , q = ∅ , c = C ⇒ fv uni (suc ∅) ⊨ C $ by wcel_eq_r [fv_eq [l43, l15], l42]
l45: $ _ , uadm u , w = clam l ω ∅ , q = ∅ ⇒ C ∈ fm ∅ $ by weaken [l13]
l46: $ _ , uadm u , w = clam l ω ∅ , q = ∅ ⇒ isset C $ by wcel_isset [l45]
l47: $ _ , uadm u , w = clam l ω ∅ , q = ∅ ⇒ fv uni (suc ∅) ⊨ C $ by isset_elim [l46, l44]
l48: $ _ , uadm u , w = clam l ω ∅ ⇒ isset ∅ $ by ax_empty
l49: $ _ , uadm u , w = clam l ω ∅ ⇒ fv uni (suc ∅) ⊨ C $ by isset_elim [l48, l47]
l50: $ _ , uadm u , l ∊ ω ⇒ isset ∅ $ by ax_empty
l51: $ _ , uadm u ⇒ l ∊ ω → isset ∅ $ by imp_intro [l50]
l52: $ _ , uadm u ⇒ ∀ l (l ∊ ω → isset ∅) $ by all_intro [l51]
l53: $ _ , uadm u ⇒ isset ω $ by omega_set
l54: $ _ , uadm u ⇒ isset (clam l ω ∅) $ by clam_set [l53, l52]
l55: $ _ , uadm u ⇒ fv uni (suc ∅) ⊨ C $ by isset_elim [l54, l49]
l56: $ _ ⇒ ∃ u (uadm u) $ by uadm_exists
l57: $ _ ⇒ fv uni (suc ∅) ⊨ C $ by ex_elim [l56, l55]

fnot_congr
----------
g1: $ fbot ≐ fbot $ by ceqt_refl
g2: $ fnot A ≐ fnot B $ by fimp_congr [#1, g1]

sb_c_fnot
---------
l1: $ (⟦ x / t ⟧ fimp A fbot) ≐ fimp (⟦ x / t ⟧ A) fbot $ by ceqt_refl

fand_congr
----------
g1: $ (fnot C) ≐ (fnot D) $ by fnot_congr [#2]
g2: $ (fimp A (fnot C)) ≐ (fimp B (fnot D)) $ by fimp_congr [#1, g1]
g3: $ fand A C ≐ fand B D $ by fnot_congr [g2]

sb_c_fand
---------
l1: $ (⟦ x / t ⟧ fnot (fimp A (fnot B))) ≐ fnot (fimp (⟦ x / t ⟧ A) (fnot (⟦ x / t ⟧ B))) $ by ceqt_refl

for_congr
---------
g1: $ (fnot A) ≐ (fnot B) $ by fnot_congr [#1]
g2: $ for A C ≐ for B D $ by fimp_congr [g1, #2]

sb_c_for
--------
l1: $ (⟦ x / t ⟧ fimp (fnot A) B) ≐ fimp (fnot (⟦ x / t ⟧ A)) (⟦ x / t ⟧ B) $ by ceqt_refl

fiff_congr
----------
g1: $ (fimp A C) ≐ (fimp B D) $ by fimp_congr [#1, #2]
g2: $ (fimp C A) ≐ (fimp D B) $ by fimp_congr [#2, #1]
g3: $ fiff A C ≐ fiff B D $ by fand_congr [g1, g2]

sb_c_fiff
---------
l1: $ (⟦ x / t ⟧ fand (fimp A B) (fimp B A)) ≐ fand (fimp (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (fimp (⟦ x / t ⟧ B) (⟦ x / t ⟧ A)) $ by ceqt_refl

fex_congr
---------
g1: $ (fnot A) ≐ (fnot B) $ by fnot_congr [#1]
g2: $ (fall (fnot A)) ≐ (fall (fnot B)) $ by fall_congr [g1]
g3: $ fex A ≐ fex B $ by fnot_congr [g2]

sb_c_fex
--------
l1: $ (⟦ x / t ⟧ fnot (fall (fnot A))) ≐ fnot (fall (fnot (⟦ x / t ⟧ A))) $ by ceqt_refl

lemma lg_imp (G: hyps) (p q r t: fml): $ G ⇒ p ↔ r $ > $ G ⇒ q ↔ t $ > $ G ⇒ (p → q) ↔ (r → t) $
----
l1: $ G , p → q ⇒ p → q $ by ax
l2: $ G , p → q , r ⇒ p → q $ by ax
l3: $ G , p → q , r ⇒ r $ by ax
l4: $ G , p → q , r ⇒ p ↔ r $ by weaken [#1]
l5: $ G , p → q , r ⇒ p $ by bi_elim_r [l4, l3]
l6: $ G , p → q , r ⇒ q $ by imp_elim [l2, l5]
l7: $ G , p → q , r ⇒ q ↔ t $ by weaken [#2]
l8: $ G , p → q , r ⇒ t $ by bi_elim_l [l7, l6]
l9: $ G , p → q ⇒ r → t $ by imp_intro [l8]
l10: $ G , r → t ⇒ r → t $ by ax
l11: $ G , r → t , p ⇒ r → t $ by ax
l12: $ G , r → t , p ⇒ p $ by ax
l13: $ G , r → t , p ⇒ p ↔ r $ by weaken [#1]
l14: $ G , r → t , p ⇒ r $ by bi_elim_l [l13, l12]
l15: $ G , r → t , p ⇒ t $ by imp_elim [l11, l14]
l16: $ G , r → t , p ⇒ q ↔ t $ by weaken [#2]
l17: $ G , r → t , p ⇒ q $ by bi_elim_r [l16, l15]
l18: $ G , r → t ⇒ p → q $ by imp_intro [l17]
l19: $ G ⇒ (p → q) ↔ (r → t) $ by bi_intro [l9, l18]

lemma lg_and (G: hyps) (p q r t: fml): $ G ⇒ p ↔ r $ > $ G ⇒ q ↔ t $ > $ G ⇒ (p ∧ q) ↔ (r ∧ t) $
----
l1: $ G , p ∧ q ⇒ p ∧ q $ by ax
l2: $ G , p ∧ q ⇒ p $ by and_elim_l [l1]
l3: $ G , p ∧ q ⇒ p ↔ r $ by weaken [#1]
l4: $ G , p ∧ q ⇒ r $ by bi_elim_l [l3, l2]
l5: $ G , p ∧ q ⇒ q $ by and_elim_r [l1]
l6: $ G , p ∧ q ⇒ q ↔ t $ by weaken [#2]
l7: $ G , p ∧ q ⇒ t $ by bi_elim_l [l6, l5]
l8: $ G , p ∧ q ⇒ r ∧ t $ by and_intro [l4, l7]
l9: $ G , r ∧ t ⇒ r ∧ t $ by ax
l10: $ G , r ∧ t ⇒ r $ by and_elim_l [l9]
l11: $ G , r ∧ t ⇒ p ↔ r $ by weaken [#1]
l12: $ G , r ∧ t ⇒ p $ by bi_elim_r [l11, l10]
l13: $ G , r ∧ t ⇒ t $ by and_elim_r [l9]
l14: $ G , r ∧ t ⇒ q ↔ t $ by weaken [#2]
l15: $ G , r ∧ t ⇒ q $ by bi_elim_r [l14, l13]
l16: $ G , r ∧ t ⇒ p ∧ q $ by and_intro [l12, l15]
l17: $ G ⇒ (p ∧ q) ↔ (r ∧ t) $ by bi_intro [l8, l16]

lemma lg_or (G: hyps) (p q r t: fml): $ G ⇒ p ↔ r $ > $ G ⇒ q ↔ t $ > $ G ⇒ (p ∨ q) ↔ (r ∨ t) $
----
l1: $ G , p ∨ q ⇒ p ∨ q $ by ax
l2: $ G , p ∨ q , p ⇒ p $ by ax
l3: $ G , p ∨ q , p ⇒ p ↔ r $ by weaken [#1]
l4: $ G , p ∨ q , p ⇒ r $ by bi_elim_l [l3, l2]
l5: $ G , p ∨ q , p ⇒ r ∨ t $ by or_intro_l [l4]
l6: $ G , p ∨ q , q ⇒ q $ by ax
l7: $ G , p ∨ q , q ⇒ q ↔ t $ by weaken [#2]
l8: $ G , p ∨ q , q ⇒ t $ by bi_elim_l [l7, l6]
l9: $ G , p ∨ q , q ⇒ r ∨ t $ by or_intro_r [l8]
l10: $ G , p ∨ q ⇒ r ∨ t $ by or_elim [l1, l5, l9]
l11: $ G , r ∨ t ⇒ r ∨ t $ by ax
l12: $ G , r ∨ t , r ⇒ r $ by ax
l13: $ G , r ∨ t , r ⇒ p ↔ r $ by weaken [#1]
l14: $ G , r ∨ t , r ⇒ p $ by bi_elim_r [l13, l12]
l15: $ G , r ∨ t , r ⇒ p ∨ q $ by or_intro_l [l14]
l16: $ G , r ∨ t , t ⇒ t $ by ax
l17: $ G , r ∨ t , t ⇒ q ↔ t $ by weaken [#2]
l18: $ G , r ∨ t , t ⇒ q $ by bi_elim_r [l17, l16]
l19: $ G , r ∨ t , t ⇒ p ∨ q $ by or_intro_r [l18]
l20: $ G , r ∨ t ⇒ p ∨ q $ by or_elim [l11, l15, l19]
l21: $ G ⇒ (p ∨ q) ↔ (r ∨ t) $ by bi_intro [l10, l20]

lemma lg_not (G: hyps) (p r: fml): $ G ⇒ p ↔ r $ > $ G ⇒ (¬ p) ↔ (¬ r) $
----
l1: $ G , ¬ p ⇒ ¬ p $ by ax
l2: $ G , ¬ p , r ⇒ ¬ p $ by ax
l3: $ G , ¬ p , r ⇒ r $ by ax
l4: $ G , ¬ p , r ⇒ p ↔ r $ by weaken [#1]
l5: $ G , ¬ p , r ⇒ p $ by bi_elim_r [l4, l3]
l6: $ G , ¬ p , r ⇒ ⊥ $ by not_elim [l2, l5]
l7: $ G , ¬ p ⇒ ¬ r $ by not_intro [l6]
l8: $ G , ¬ r ⇒ ¬ r $ by ax
l9: $ G , ¬ r , p ⇒ ¬ r $ by ax
l10: $ G , ¬ r , p ⇒ p $ by ax
l11: $ G , ¬ r , p ⇒ p ↔ r $ by weaken [#1]
l12: $ G , ¬ r , p ⇒ r $ by bi_elim_l [l11, l10]
l13: $ G , ¬ r , p ⇒ ⊥ $ by not_elim [l9, l12]
l14: $ G , ¬ r ⇒ ¬ p $ by not_intro [l13]
l15: $ G ⇒ (¬ p) ↔ (¬ r) $ by bi_intro [l7, l14]

lemma lg_bi (G: hyps) (p q r t: fml): $ G ⇒ p ↔ r $ > $ G ⇒ q ↔ t $ > $ G ⇒ (p ↔ q) ↔ (r ↔ t) $
----
l1: $ G , p ↔ q ⇒ p ↔ q $ by ax
l2: $ G , p ↔ q , r ⇒ p ↔ q $ by ax
l3: $ G , p ↔ q , r ⇒ r $ by ax
l4: $ G , p ↔ q , r ⇒ p ↔ r $ by weaken [#1]
l5: $ G , p ↔ q , r ⇒ p $ by bi_elim_r [l4, l3]
l6: $ G , p ↔ q , r ⇒ q $ by bi_elim_l [l2, l5]
l7: $ G , p ↔ q , r ⇒ q ↔ t $ by weaken [#2]
l8: $ G , p ↔ q , r ⇒ t $ by bi_elim_l [l7, l6]
l9: $ G , p ↔ q , t ⇒ p ↔ q $ by ax
l10: $ G , p ↔ q , t ⇒ t $ by ax
l11: $ G , p ↔ q , t ⇒ q ↔ t $ by weaken [#2]
l12: $ G , p ↔ q , t ⇒ q $ by bi_elim_r [l11, l10]
l13: $ G , p ↔ q , t ⇒ p $ by bi_elim_r [l9, l12]
l14: $ G , p ↔ q , t ⇒ p ↔ r $ by weaken [#1]
l15: $ G , p ↔ q , t ⇒ r $ by bi_elim_l [l14, l13]
l16: $ G , p ↔ q ⇒ r ↔ t $ by bi_intro [l8, l15]
l17: $ G , r ↔ t ⇒ r ↔ t $ by ax
l18: $ G , r ↔ t , p ⇒ r ↔ t $ by ax
l19: $ G , r ↔ t , p ⇒ p $ by ax
l20: $ G , r ↔ t , p ⇒ p ↔ r $ by weaken [#1]
l21: $ G , r ↔ t , p ⇒ r $ by bi_elim_l [l20, l19]
l22: $ G , r ↔ t , p ⇒ t $ by bi_elim_l [l18, l21]
l23: $ G , r ↔ t , p ⇒ q ↔ t $ by weaken [#2]
l24: $ G , r ↔ t , p ⇒ q $ by bi_elim_r [l23, l22]
l25: $ G , r ↔ t , q ⇒ r ↔ t $ by ax
l26: $ G , r ↔ t , q ⇒ q $ by ax
l27: $ G , r ↔ t , q ⇒ q ↔ t $ by weaken [#2]
l28: $ G , r ↔ t , q ⇒ t $ by bi_elim_l [l27, l26]
l29: $ G , r ↔ t , q ⇒ r $ by bi_elim_r [l25, l28]
l30: $ G , r ↔ t , q ⇒ p ↔ r $ by weaken [#1]
l31: $ G , r ↔ t , q ⇒ p $ by bi_elim_r [l30, l29]
l32: $ G , r ↔ t ⇒ p ↔ q $ by bi_intro [l24, l31]
l33: $ G ⇒ (p ↔ q) ↔ (r ↔ t) $ by bi_intro [l16, l32]

lemma lg_nimp (G: hyps) (p q: fml): $ G ⇒ (¬ (p → ¬ q)) ↔ (p ∧ q) $
----
l1: $ G , ¬ (p → ¬ q) ⇒ ¬ (p → ¬ q) $ by ax
l2: $ G , ¬ (p → ¬ q) , ¬ p , p ⇒ ¬ p $ by ax
l3: $ G , ¬ (p → ¬ q) , ¬ p , p ⇒ p $ by ax
l4: $ G , ¬ (p → ¬ q) , ¬ p , p ⇒ ¬ q $ by bot_elim [not_elim [l2, l3]]
l5: $ G , ¬ (p → ¬ q) , ¬ p ⇒ ¬ (p → ¬ q) $ by ax
l6: $ G , ¬ (p → ¬ q) , ¬ p ⇒ p → ¬ q $ by imp_intro [l4]
l7: $ G , ¬ (p → ¬ q) , ¬ p ⇒ ⊥ $ by not_elim [l5, l6]
l8: $ G , ¬ (p → ¬ q) ⇒ p $ by by_contra [l7]
l9: $ G , ¬ (p → ¬ q) , ¬ q ⇒ ¬ (p → ¬ q) $ by ax
l10: $ G , ¬ (p → ¬ q) , ¬ q , p ⇒ ¬ q $ by ax
l11: $ G , ¬ (p → ¬ q) , ¬ q ⇒ p → ¬ q $ by imp_intro [l10]
l12: $ G , ¬ (p → ¬ q) , ¬ q ⇒ ⊥ $ by not_elim [l9, l11]
l13: $ G , ¬ (p → ¬ q) ⇒ q $ by by_contra [l12]
l14: $ G , ¬ (p → ¬ q) ⇒ p ∧ q $ by and_intro [l8, l13]
l15: $ G , p ∧ q ⇒ p ∧ q $ by ax
l16: $ G , p ∧ q , p → ¬ q ⇒ p → ¬ q $ by ax
l17: $ G , p ∧ q , p → ¬ q ⇒ p ∧ q $ by ax
l18: $ G , p ∧ q , p → ¬ q ⇒ ¬ q $ by imp_elim [l16, and_elim_l [l17]]
l19: $ G , p ∧ q , p → ¬ q ⇒ p ∧ q $ by ax
l20: $ G , p ∧ q , p → ¬ q ⇒ ⊥ $ by not_elim [l18, and_elim_r [l19]]
l21: $ G , p ∧ q ⇒ ¬ (p → ¬ q) $ by not_intro [l20]
l22: $ G ⇒ (¬ (p → ¬ q)) ↔ (p ∧ q) $ by bi_intro [l14, l21]

lemma lg_dor (G: hyps) (p q: fml): $ G ⇒ (¬ p → q) ↔ (p ∨ q) $
----
l1: $ G , ¬ p → q ⇒ ¬ p → q $ by ax
l2: $ G , ¬ p → q ⇒ p ∨ ¬ p $ by excluded_middle
l3: $ G , ¬ p → q , p ⇒ p $ by ax
l4: $ G , ¬ p → q , p ⇒ p ∨ q $ by or_intro_l [l3]
l5: $ G , ¬ p → q , ¬ p ⇒ ¬ p → q $ by ax
l6: $ G , ¬ p → q , ¬ p ⇒ ¬ p $ by ax
l7: $ G , ¬ p → q , ¬ p ⇒ q $ by imp_elim [l5, l6]
l8: $ G , ¬ p → q , ¬ p ⇒ p ∨ q $ by or_intro_r [l7]
l9: $ G , ¬ p → q ⇒ p ∨ q $ by or_elim [l2, l4, l8]
l10: $ G , p ∨ q ⇒ p ∨ q $ by ax
l11: $ G , p ∨ q , p , ¬ p ⇒ ¬ p $ by ax
l12: $ G , p ∨ q , p , ¬ p ⇒ p $ by ax
l13: $ G , p ∨ q , p , ¬ p ⇒ q $ by bot_elim [not_elim [l11, l12]]
l14: $ G , p ∨ q , p ⇒ ¬ p → q $ by imp_intro [l13]
l15: $ G , p ∨ q , q , ¬ p ⇒ q $ by ax
l16: $ G , p ∨ q , q ⇒ ¬ p → q $ by imp_intro [l15]
