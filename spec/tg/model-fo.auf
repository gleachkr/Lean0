l520: $ G , ∃ c (c ∊ U ∧ (∃ d (d ∊ U ∧ ((r_pair U c x2 x2) ∧ ((r_pair U d x2 x3) ∧ (r_pair U x1 c d)))))) , c ∊ U ∧ (∃ d (d ∊ U ∧ ((r_pair U c x2 x2) ∧ ((r_pair U d x2 x3) ∧ (r_pair U x1 c d))))) ⇒ c ∊ U $ by and_elim_l [l519]
l521: $ G , ∃ c (c ∊ U ∧ (∃ d (d ∊ U ∧ ((r_pair U c x2 x2) ∧ ((r_pair U d x2 x3) ∧ (r_pair U x1 c d)))))) , c ∊ U ∧ (∃ d (d ∊ U ∧ ((r_pair U c x2 x2) ∧ ((r_pair U d x2 x3) ∧ (r_pair U x1 c d))))) ⇒ ∀ c (c ∊ U → ((⟪ U , scons c S ⊨ ∃ₒ ((c_pair (suc ∅) (suc (suc I)) (suc (suc I))) ∧ₒ ((c_pair ∅ (suc (suc I)) (suc (suc J))) ∧ₒ (c_pair (suc (suc K)) (suc ∅) ∅))) ⟫) ↔ (∃ d (d ∊ U ∧ ((r_pair U c x2 x2) ∧ ((r_pair U d x2 x3) ∧ (r_pair U x1 c d))))))) $ by weaken [l508]
