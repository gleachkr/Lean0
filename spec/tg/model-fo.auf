l106: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 , ∀ x (x ∊ A → scons x a ∈ fv (fsf A) p) ⇒ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) $ by or_intro_l [l105]
l107: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 , ∀ x (x ∊ A → scons x a ∈ fv (fsf A) p) ⇒ (x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅))) ∨ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) $ by or_intro_r [l106]
l108: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 , ∀ x (x ∊ A → scons x a ∈ fv (fsf A) p) ⇒ a ∊ fseq A $ by weaken [#2]
l109: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 , ∀ x (x ∊ A → scons x a ∈ fv (fsf A) p) ⇒ a ∊ fseq A ∧ ((x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅))) ∨ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5))) $ by and_intro [l108, l107]
l110: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 , ∀ x (x ∊ A → scons x a ∈ fv (fsf A) p) ⇒ a ∊ fsb A x1 x2 x3 $ by cab_intro [l109]
l111: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 , ∀ x (x ∊ A → scons x a ∈ fv (fsf A) p) ⇒ fv (fsf A) ⟨ suc (suc ∅) , scons p ∅ ⟩ = fsb A x1 x2 x3 $ by weaken [l19]
l112: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 , ∀ x (x ∊ A → scons x a ∈ fv (fsf A) p) ⇒ a ∈ fv (fsf A) ⟨ suc (suc ∅) , scons p ∅ ⟩ $ by wcel_eq_r [eq_sym [l111], welc_wcel [l110]]
l113: $ G , x1 = suc (suc ∅) , x2 = scons p ∅ , x3 = ccom (fsf A) x2 ⇒ (a ∈ fv (fsf A) ⟨ suc (suc ∅) , scons p ∅ ⟩) ↔ (∀ x (x ∊ A → scons x a ∈ fv (fsf A) p)) $ by bi_intro [l94, l112]
