g15: $ (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc A)))) ≐ (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc B)))) $ by fand_congr [g10, g14]
g16: $ (fex (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc A))))) ≐ (fex (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc B))))) $ by fex_congr [g15]
g17: $ (fimp (fin ∅ (suc A)) (fex (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc A)))))) ≐ (fimp (fin ∅ (suc B)) (fex (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc B)))))) $ by fimp_congr [g9, g16]
g18: $ (fall (fimp (fin ∅ (suc A)) (fex (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc A))))))) ≐ (fall (fimp (fin ∅ (suc B)) (fex (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc B))))))) $ by fall_congr [g17]
g19: $ c_ind A ≐ c_ind B $ by fand_congr [g6, g18]

sb_c_c_ind
