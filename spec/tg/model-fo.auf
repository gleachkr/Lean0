l1: $ (⟦ x / t ⟧ fand (fex (fand (c_empty ∅) (fin ∅ (suc A)))) (fall (fimp (fin ∅ (suc A)) (fex (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc A)))))))) ≐ fand (fex (fand (c_empty ∅) (fin ∅ (suc (⟦ x / t ⟧ A))))) (fall (fimp (fin ∅ (suc (⟦ x / t ⟧ A))) (fex (fand (c_succ ∅ (suc ∅)) (fin ∅ (suc (suc (⟦ x / t ⟧ A)))))))) $ by ceqt_refl

