g36: $ ((r_omega A w) → ((r_pow A p w) → (∀ a ((a ∊ A) → ((r_sub A a p) → ((∃ f ((f ∊ A) ∧ (r_inj A f a w))) ∨ (∃ f ((f ∊ A) ∧ (r_inj A f p a))))))))) ⟺ ((r_omega B w) → ((r_pow B p w) → (∀ a ((a ∊ B) → ((r_sub B a p) → ((∃ f ((f ∊ B) ∧ (r_inj B f a w))) ∨ (∃ f ((f ∊ B) ∧ (r_inj B f p a))))))))) $ by im_congr [g6, g35]
g37: $ ((p ∊ A) → ((r_omega A w) → ((r_pow A p w) → (∀ a ((a ∊ A) → ((r_sub A a p) → ((∃ f ((f ∊ A) ∧ (r_inj A f a w))) ∨ (∃ f ((f ∊ A) ∧ (r_inj A f p a)))))))))) ⟺ ((p ∊ B) → ((r_omega B w) → ((r_pow B p w) → (∀ a ((a ∊ B) → ((r_sub B a p) → ((∃ f ((f ∊ B) ∧ (r_inj B f a w))) ∨ (∃ f ((f ∊ B) ∧ (r_inj B f p a)))))))))) $ by im_congr [g4, g36]
g38: $ (∀ p ((p ∊ A) → ((r_omega A w) → ((r_pow A p w) → (∀ a ((a ∊ A) → ((r_sub A a p) → ((∃ f ((f ∊ A) ∧ (r_inj A f a w))) ∨ (∃ f ((f ∊ A) ∧ (r_inj A f p a))))))))))) ⟺ (∀ p ((p ∊ B) → ((r_omega B w) → ((r_pow B p w) → (∀ a ((a ∊ B) → ((r_sub B a p) → ((∃ f ((f ∊ B) ∧ (r_inj B f a w))) ∨ (∃ f ((f ∊ B) ∧ (r_inj B f p a))))))))))) $ by all_congr [g37]
g39: $ ((w ∊ A) → (∀ p ((p ∊ A) → ((r_omega A w) → ((r_pow A p w) → (∀ a ((a ∊ A) → ((r_sub A a p) → ((∃ f ((f ∊ A) ∧ (r_inj A f a w))) ∨ (∃ f ((f ∊ A) ∧ (r_inj A f p a)))))))))))) ⟺ ((w ∊ B) → (∀ p ((p ∊ B) → ((r_omega B w) → ((r_pow B p w) → (∀ a ((a ∊ B) → ((r_sub B a p) → ((∃ f ((f ∊ B) ∧ (r_inj B f a w))) ∨ (∃ f ((f ∊ B) ∧ (r_inj B f p a)))))))))))) $ by im_congr [g2, g38]
g40: $ r_ch A ⟺ r_ch B $ by all_congr [g39]

