l7: $ G ⇒ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (p →ₒ q) e = tpi (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) p e) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) q (lup e)) $ by ltr_imp [#4, #6, #7]
l8: $ G , d = ∅ ⇒ d = ∅ $ by ax
l9: $ G , d = ∅ ⇒ ∅ ∈ u $ by weaken [l6]
l10: $ G , d = ∅ ⇒ d ∊ u $ by wcel_welc [wcel_eq_l [eq_sym [l8], l9]]
