l137: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 , o ∊ fseq (trees ω) ⇒ isset (tapp (tapp M (tbv (fv o i))) (tbv (fv o j))) $ by opair_isset
l138: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ o ∊ fseq (trees ω) → isset (tapp (tapp M (tbv (fv o i))) (tbv (fv o j))) $ by imp_intro [l137]
l139: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ ∀ o (o ∊ fseq (trees ω) → isset (tapp (tapp M (tbv (fv o i))) (tbv (fv o j)))) $ by all_intro [l138]
l140: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ isset (clam o (fseq (trees ω)) (tapp (tapp M (tbv (fv o i))) (tbv (fv o j)))) $ by clam_set [l136, l139]
l141: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ isset (ltb P E M x1 x2 x3) $ by isset_eq [eq_sym [l134], l140]
l142: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ fv (ltf P E M) ⟨ x1 , x2 ⟩ = ltb P E M x1 x2 x3 $ by lt_nd [l13, l23, l7, l141]
l143: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ (ltf P E M) = (ltf P E M) $ by eq_refl
l144: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ fv (ltf P E M) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩ = ltb P E M x1 x2 x3 $ by eq_trans [fv_eq [l143, opair_eq [eq_sym [l5], eq_sym [l6]]], l142]
l145: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ fv (ltf P E M) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩ = clam o (fseq (trees ω)) (tapp (tapp M (tbv (fv o i))) (tbv (fv o j))) $ by eq_trans [l144, l134]
l146: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ r = r $ by eq_refl
l147: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ ap (fv (ltf P E M) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) r = ap (clam o (fseq (trees ω)) (tapp (tapp M (tbv (fv o i))) (tbv (fv o j)))) r $ by ap_eq [l145, l146]
l148: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ ap (clam o (fseq (trees ω)) (tapp (tapp M (tbv (fv o i))) (tbv (fv o j)))) r = tapp (tapp M (tbv (fv r i))) (tbv (fv r j)) $ by clam_ap [weaken [#1]]
l149: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (ltf P E M) x2 ⇒ ap (fv (ltf P E M) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) r = tapp (tapp M (tbv (fv r i))) (tbv (fv r j)) $ by eq_trans [l147, l148]
l150: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⇒ functional (ltf P E M) $ by weaken [l3]
l151: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⇒ isset x2 $ by isset_var
l152: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⇒ isset (ccom (ltf P E M) x2) $ by ccom_set [l150, l151]
l153: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⇒ ap (fv (ltf P E M) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) r = tapp (tapp M (tbv (fv r i))) (tbv (fv r j)) $ by isset_elim [l152, l149]
l154: $ G , x1 = suc (suc (suc (suc ∅))) ⇒ isset ∅ $ by ax_empty
l155: $ G , x1 = suc (suc (suc (suc ∅))) ⇒ isset (scons ⟨ j , ∅ ⟩ ∅) $ by scons_set [l154]
l156: $ G , x1 = suc (suc (suc (suc ∅))) ⇒ isset (scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅)) $ by scons_set [l155]
l157: $ G , x1 = suc (suc (suc (suc ∅))) ⇒ ap (fv (ltf P E M) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) r = tapp (tapp M (tbv (fv r i))) (tbv (fv r j)) $ by isset_elim [l156, l153]
l158: $ G ⇒ isset ∅ $ by ax_empty
l159: $ G ⇒ isset (suc ∅) $ by suc_set [l158]
l160: $ G ⇒ isset (suc (suc ∅)) $ by suc_set [l159]
l161: $ G ⇒ isset (suc (suc (suc ∅))) $ by suc_set [l160]
l162: $ G ⇒ isset (suc (suc (suc (suc ∅)))) $ by suc_set [l161]
l163: $ G ⇒ ap (fv (ltf P E M) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) r = tapp (tapp M (tbv (fv r i))) (tbv (fv r j)) $ by isset_elim [l162, l157]

lemma lu_eq {t: set} (G: hyps) (e: set): $ G ⇒ lup e = ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $
----
l1: $ G , z ∊ lup e ⇒ z ∊ lup e $ by ax
l2: $ G , z ∊ lup e ⇒ ∃ i ∃ y (z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e) $ by cab_elim [l1]
l3: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e ⇒ z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e $ by ax
l4: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e ⇒ z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e ⇒ ⟨ i , y ⟩ ∈ e $ by and_elim_r [l3]
l6: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e , d = ⟨ kc_s , scons y ∅ ⟩ ⇒ d = ⟨ kc_s , scons y ∅ ⟩ $ by ax
l7: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e , d = ⟨ kc_s , scons y ∅ ⟩ ⇒ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ $ by cgr_intro [l6]
l8: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e , d = ⟨ kc_s , scons y ∅ ⟩ ⇒ ⟨ i , y ⟩ ∈ e $ by weaken [l5]
l9: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e , d = ⟨ kc_s , scons y ∅ ⟩ ⇒ ⟨ i , d ⟩ ∈ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by ccom_intro [l8, l7]
l10: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e , d = ⟨ kc_s , scons y ∅ ⟩ ⇒ z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ $ by weaken [l4]
l11: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e , d = ⟨ kc_s , scons y ∅ ⟩ ⇒ i = i $ by eq_refl
l12: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e , d = ⟨ kc_s , scons y ∅ ⟩ ⇒ z = ⟨ i , d ⟩ $ by eq_trans [l10, opair_eq [l11, eq_sym [l6]]]
l13: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e , d = ⟨ kc_s , scons y ∅ ⟩ ⇒ z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by wcel_welc [wcel_eq_l [eq_sym [l12], l9]]
l14: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e ⇒ isset ⟨ kc_s , scons y ∅ ⟩ $ by opair_isset
l15: $ G , z ∊ lup e , z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e ⇒ z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by isset_elim [l14, l13]
l16: $ G , z ∊ lup e , ∃ y (z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e) ⇒ ∃ y (z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e) $ by ax
l17: $ … ⇒ z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by ex_elim [l16, l15]
l18: $ G , z ∊ lup e ⇒ z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by ex_elim [l2, l17]
l19: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e ⇒ z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by ax
l20: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e ⇒ ∃ i ∃ d (z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩)) $ by cab_elim [l19]
l21: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) ⇒ z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) $ by ax
l22: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) ⇒ z = ⟨ i , d ⟩ $ by and_elim_l [l21]
l23: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) ⇒ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) $ by and_elim_r [l21]
l24: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ $ by ax
l25: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ ⟨ i , y ⟩ ∈ e $ by and_elim_l [l24]
l26: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ $ by and_elim_r [l24]
l27: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ d = ⟨ kc_s , scons y ∅ ⟩ $ by cgr_elim [l26]
l28: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ z = ⟨ i , d ⟩ $ by weaken [l22]
l29: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ i = i $ by eq_refl
l30: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ $ by eq_trans [l28, opair_eq [l29, l27]]
l31: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e $ by and_intro [l30, l25]
l32: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ ∃ y (z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e) $ by ex_intro [l31]
l33: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ ∃ i ∃ y (z = ⟨ i , ⟨ kc_s , scons y ∅ ⟩ ⟩ ∧ ⟨ i , y ⟩ ∈ e) $ by ex_intro [l32]
l34: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) , ⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩ ⇒ z ∊ lup e $ by cab_intro [l33]
l35: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩) ⇒ z ∊ lup e $ by ex_elim [l23, l34]
l36: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e , ∃ d (z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩)) ⇒ ∃ d (z = ⟨ i , d ⟩ ∧ ∃ y (⟨ i , y ⟩ ∈ e ∧ ⟨ y , d ⟩ ∈ cgr t ⟨ kc_s , scons t ∅ ⟩)) $ by ax
l37: $ … ⇒ z ∊ lup e $ by ex_elim [l36, l35]
l38: $ G , z ∊ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e ⇒ z ∊ lup e $ by ex_elim [l20, l37]
l39: $ G ⇒ lup e = ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by eq_intro [l18, l38]

lemma lu_fn {t: set} (G: hyps): $ G ⇒ fn_into (cgr t ⟨ kc_s , scons t ∅ ⟩) (trees ω) (trees ω) $
----
l1: $ G , t ∊ trees ω ⇒ isset ω $ by omega_set
l2: $ G , t ∊ trees ω ⇒ kc_s ∈ ω $ by kc_s_omega
l3: $ G , t ∊ trees ω ⇒ t ∊ trees ω $ by ax
l4: $ G , t ∊ trees ω ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l5: $ G , t ∊ trees ω ⇒ ⟨ kc_s , scons t ∅ ⟩ ∈ trees ω $ by trees_intro_c [l1, l2, scons_fseq_c [welc_wcel [l3], l4]]
l6: $ G ⇒ t ∊ trees ω → ⟨ kc_s , scons t ∅ ⟩ ∈ trees ω $ by imp_intro [l5]
l7: $ G ⇒ ∀ t (t ∊ trees ω → ⟨ kc_s , scons t ∅ ⟩ ∈ trees ω) $ by all_intro [l6]
l8: $ G ⇒ fn_into (cgr t ⟨ kc_s , scons t ∅ ⟩) (trees ω) (trees ω) $ by cgr_fn_into [l7]

lemma lu_fs (G: hyps) (e: set): $ G ⇒ e ∊ fseq (trees ω) $ > $ G ⇒ lup e ∈ fseq (trees ω) ∧ cdm (lup e) = cdm e $
----
l1: $ G ⇒ fn_into (cgr t ⟨ kc_s , scons t ∅ ⟩) (trees ω) (trees ω) $ by lu_fn
l2: $ G ⇒ lup e = ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by lu_eq
l3: $ G ⇒ ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e ∈ fseq (trees ω) $ by ccom_fseq [#1, l1]
l4: $ G ⇒ lup e ∈ fseq (trees ω) $ by wcel_eq_l [eq_sym [l2], l3]
l5: $ G ⇒ cdm (lup e) = cdm e $ by eq_trans [cdm_eq [l2], ccom_len [#1, l1]]
l6: $ G ⇒ lup e ∈ fseq (trees ω) ∧ cdm (lup e) = cdm e $ by and_intro [l4, l5]

lemma lu_fv (G: hyps) (e i: set): $ G ⇒ e ∊ fseq (trees ω) $ > $ G ⇒ i ∊ cdm e $ > $ G ⇒ fv (lup e) i = ⟨ kc_s , scons (fv e i) ∅ ⟩ $
----
l1: $ G ⇒ fv e i ∈ trees ω $ by fseq_fv [#1, #2]
l2: $ G ⇒ lup e = ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by lu_eq
l3: $ G , m = fv e i ⇒ m = fv e i $ by ax
l4: $ G , m = fv e i ⇒ isset ⟨ kc_s , scons m ∅ ⟩ $ by opair_isset
l5: $ G , m = fv e i ⇒ m ∊ cdm (cgr t ⟨ kc_s , scons t ∅ ⟩) $ by cgr_cdm [l4]
l6: $ G , m = fv e i ⇒ fv e i ∈ cdm (cgr t ⟨ kc_s , scons t ∅ ⟩) $ by wcel_eq_l [l3, welc_wcel [l5]]
l7: $ G , m = fv e i ⇒ functional (cgr t ⟨ kc_s , scons t ∅ ⟩) $ by cgr_functional
l8: $ G , m = fv e i ⇒ fv (ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e) i = fv (cgr t ⟨ kc_s , scons t ∅ ⟩) (fv e i) $ by fv_ccom [l7, fseq_functional [weaken [#1]], weaken [#2], l6]
l9: $ G , m = fv e i ⇒ isset ⟨ kc_s , scons m ∅ ⟩ $ by opair_isset
l10: $ G , m = fv e i ⇒ fv (cgr t ⟨ kc_s , scons t ∅ ⟩) m = ⟨ kc_s , scons m ∅ ⟩ $ by fv_cgr [l9]
l11: $ G , m = fv e i ⇒ lup e = ccom (cgr t ⟨ kc_s , scons t ∅ ⟩) e $ by weaken [l2]
l12: $ G , m = fv e i ⇒ i = i $ by eq_refl
l13: $ G , m = fv e i ⇒ (cgr t ⟨ kc_s , scons t ∅ ⟩) = (cgr t ⟨ kc_s , scons t ∅ ⟩) $ by eq_refl
l14: $ G , m = fv e i ⇒ kc_s = kc_s $ by eq_refl
l15: $ G , m = fv e i ⇒ ∅ = ∅ $ by eq_refl
l16: $ G , m = fv e i ⇒ fv (lup e) i = ⟨ kc_s , scons (fv e i) ∅ ⟩ $ by eq_trans [fv_eq [l11, l12], eq_trans [l8, eq_trans [fv_eq [l13, eq_sym [l3]], eq_trans [l10, opair_eq [l14, scons_eq [l3, l15]]]]]]
l17: $ G ⇒ isset (fv e i) $ by wcel_isset [l1]
l18: $ G ⇒ fv (lup e) i = ⟨ kc_s , scons (fv e i) ∅ ⟩ $ by isset_elim [l17, l16]

lemma om_pred {m: set} (G: hyps) (n i: set): $ G ⇒ n ∊ ω $ > $ G ⇒ i ∊ suc n $ > $ G ⇒ i = ∅ ∨ ∃ m (m ∊ n ∧ i = suc m) $
----
l1: $ G ⇒ i ∊ ω $ by omega_suc_elem_omega [#1, #2]
l2: $ G ⇒ i = ∅ ∨ ∃ y (y ∊ ω ∧ i = suc y) $ by omega_cases [l1]
l3: $ G , i = ∅ ⇒ i = ∅ $ by ax
l4: $ G , i = ∅ ⇒ i = ∅ ∨ ∃ m (m ∊ n ∧ i = suc m) $ by or_intro_l [l3]
l5: $ G , ∃ y (y ∊ ω ∧ i = suc y) ⇒ ∃ y (y ∊ ω ∧ i = suc y) $ by ax
l6: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ y ∊ ω ∧ i = suc y $ by ax
l7: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ y ∊ ω $ by and_elim_l [l6]
l8: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ i = suc y $ by and_elim_r [l6]
l9: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ i ∊ n ∨ i = n $ by suc_elim [weaken [#2]]
l10: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ isset y $ by isset_var
l11: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ y ∈ suc y $ by suc_mem [l10]
l12: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n ⇒ transitive n $ by omega_elem_trans [weaken [#1]]
l13: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n ⇒ i = suc y $ by weaken [l8]
l14: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n ⇒ i ∊ n $ by ax
l15: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n ⇒ suc y ∈ n $ by wcel_eq_l [l13, welc_wcel [l14]]
l16: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n , d = suc y ⇒ d = suc y $ by ax
l17: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n , d = suc y ⇒ transitive n $ by weaken [l12]
l18: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n , d = suc y ⇒ suc y ∈ n $ by weaken [l15]
l19: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n , d = suc y ⇒ y ∈ suc y $ by weaken [l11]
l20: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n , d = suc y ⇒ y ∊ n $ by transitive_elim [l17, wcel_welc [wcel_eq_l [eq_sym [l16], l18]], wcel_welc [wcel_eq_r [eq_sym [l16], l19]]]
l21: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n ⇒ isset y $ by isset_var
l22: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n ⇒ isset (suc y) $ by suc_set [l21]
l23: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i ∊ n ⇒ y ∊ n $ by isset_elim [l22, l20]
l24: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i = n ⇒ i = suc y $ by weaken [l8]
l25: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i = n ⇒ i = n $ by ax
l26: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i = n ⇒ y ∈ suc y $ by weaken [l11]
l27: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y , i = n ⇒ y ∊ n $ by wcel_welc [wcel_eq_r [eq_trans [eq_sym [l24], l25], l26]]
l28: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ y ∊ n $ by or_elim [l9, l23, l27]
l29: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ y ∊ n ∧ i = suc y $ by and_intro [l28, l8]
l30: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ ∃ m (m ∊ n ∧ i = suc m) $ by ex_intro [l29]
l31: $ G , ∃ y (y ∊ ω ∧ i = suc y) , y ∊ ω ∧ i = suc y ⇒ i = ∅ ∨ ∃ m (m ∊ n ∧ i = suc m) $ by or_intro_r [l30]
l32: $ G , ∃ y (y ∊ ω ∧ i = suc y) ⇒ i = ∅ ∨ ∃ m (m ∊ n ∧ i = suc m) $ by ex_elim [l5, l31]
l33: $ G ⇒ i = ∅ ∨ ∃ m (m ∊ n ∧ i = suc m) $ by or_elim [l2, l4, l32]

lemma lu_ix (G: hyps) (e i x r: set): $ G ⇒ e ∊ fseq (trees ω) $ > $ G ⇒ i ∊ cdm e $ > $ G ⇒ fv (scons x r) (fv nvf (fv (lup e) i)) = fv r (fv nvf (fv e i)) $
----
l1: $ G ⇒ fv e i ∈ trees ω $ by fseq_fv [#1, #2]
l2: $ G ⇒ fv (lup e) i = ⟨ kc_s , scons (fv e i) ∅ ⟩ $ by lu_fv [#1, #2]
l3: $ G ⇒ fv nvf ⟨ kc_s , scons (fv e i) ∅ ⟩ = suc (fv nvf (fv e i)) $ by nvf_s [l1]
l4: $ G ⇒ isset (fv nvf (fv e i)) $ by wcel_isset [nvf_omega [wcel_isset [l1]]]
l5: $ G ⇒ isset x $ by isset_var
l6: $ G ⇒ isset r $ by isset_var
l7: $ G ⇒ fv (scons x r) (suc (fv nvf (fv e i))) = fv r (fv nvf (fv e i)) $ by scons_fv_suc_c [l5, l6, l4]
l8: $ G ⇒ (scons x r) = (scons x r) $ by eq_refl
l9: $ G ⇒ nvf = nvf $ by eq_refl
l10: $ G ⇒ fv (scons x r) (fv nvf (fv (lup e) i)) = fv r (fv nvf (fv e i)) $ by eq_trans [fv_eq [l8, eq_trans [fv_eq [l9, l2], l3]], l7]

lemma sm_bot (G: hyps) (b: blk) (E M: expr) (u w r e a: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ e ∊ fseq (trees ω) $ > $ G ⇒ a ∊ fseq (fv uni (suc ∅)) $ > $ G ⇒ (∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ↔ ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫) ∧ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ∈ two ∧ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e ∈ trees ω $
----
l1: $ G ⇒ uadm u $ by weaken [#1]
l2: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
l3: $ G ⇒ r ∈ fseq u $ by welc_wcel [#3]
l4: $ G ⇒ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e = enc_expr lfalse $ by ltr_bot [#4]
l5: $ G ⇒ w ∈ lvals $ by weaken [l2]
l6: $ G ⇒ r ∈ fseq u $ by weaken [l3]
l7: $ G ⇒ enc_expr (Prop) ∈ trees ω $ by enc_expr_trees
l8: $ G ⇒ enc_expr (bvar nz) ∈ trees ω $ by enc_expr_trees
l9: $ G ⇒ dt u (mcv hfin) (enc_expr (pi (Prop) (bvar nz))) w r = cpi p (dt u (mcv hfin) (enc_expr (Prop)) w r) (dt u (mcv hfin) (enc_expr (bvar nz)) w (scons p r)) $ by dt_pi_c [l7, l8, l5, l6]
l10: $ G ⇒ w ∈ lvals $ by weaken [l2]
l11: $ G ⇒ r ∈ fseq u $ by weaken [l3]
l12: $ G ⇒ enc_lvl lz ∈ trees ω $ by enc_lvl_trees
l13: $ G ⇒ dt u (mcv hfin) (enc_expr (Prop)) w r = fv uni (lv (enc_lvl lz) w) $ by dt_srt_c [l12, l10, l11]
l14: $ G ⇒ lv (enc_lvl lz) w = ∅ $ by lv_lz
l15: $ G ⇒ uni = uni $ by eq_refl
l16: $ G ⇒ fv uni (lv (enc_lvl lz) w) = fv uni ∅ $ by fv_eq [l15, l14]
l17: $ G ⇒ dt u (mcv hfin) (enc_expr (Prop)) w r = fv uni ∅ $ by eq_trans [l13, l16]
l18: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r $ by ax
l19: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ uadm u $ by weaken [l1]
l20: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ w ∈ lvals $ by weaken [l2]
l21: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ r ∈ fseq u $ by weaken [l3]
l22: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ scons p r ∈ fseq u $ by dt_scons_fseq [l19, l20, l21, l18]
l23: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ dt u (mcv hfin) (enc_expr (Prop)) w r = fv uni ∅ $ by weaken [l17]
l24: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ p ∊ fv uni ∅ $ by welc_eq [l23, l18]
l25: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ w ∈ lvals $ by weaken [l2]
l26: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ scons p r ∈ fseq u $ by weaken [l22]
l27: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l28: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ dt u (mcv hfin) (enc_expr (bvar nz)) w (scons p r) = fv (scons p r) (fv nvf (enc_nat nz)) $ by dt_bvar_c [l27, l25, l26]
l29: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ fv nvf (enc_nat nz) = ∅ $ by nvf_nz
l30: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ scons p r = scons p r $ by eq_refl
l31: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ fv (scons p r) (fv nvf (enc_nat nz)) = fv (scons p r) ∅ $ by fv_eq [l30, l29]
l32: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ r ∈ fseq u $ by weaken [l3]
l33: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ isset r $ by wcel_isset [l32]
l34: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ isset (scons p r) $ by scons_set [l33]
l35: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ isset ∅ $ by ax_empty
l36: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ isset p $ by isset_var
l37: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ fv (scons p r) ∅ = p $ by scons_fv_zero_c [l36, l33]
l38: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ fv (scons p r) (fv nvf (enc_nat nz)) = p $ by eq_trans [l31, l37]
l39: $ G , p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r ⇒ dt u (mcv hfin) (enc_expr (bvar nz)) w (scons p r) = p $ by eq_trans [l28, l38]
l40: $ G ⇒ p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r → dt u (mcv hfin) (enc_expr (bvar nz)) w (scons p r) = p $ by imp_intro [l39]
l41: $ G ⇒ ∀ p (p ∊ dt u (mcv hfin) (enc_expr (Prop)) w r → dt u (mcv hfin) (enc_expr (bvar nz)) w (scons p r) = p) $ by all_intro [l40]
l42: $ G ⇒ cpi p (dt u (mcv hfin) (enc_expr (Prop)) w r) (dt u (mcv hfin) (enc_expr (bvar nz)) w (scons p r)) = cpi p (fv uni ∅) p $ by cpi_eq_pt [l17, l41]
l43: $ G ⇒ dt u (mcv hfin) (enc_expr (pi (Prop) (bvar nz))) w r = cpi p (fv uni ∅) p $ by eq_trans [l9, l42]
l44: $ G ⇒ u = u $ by eq_refl
l45: $ G ⇒ (mcv hfin) = (mcv hfin) $ by eq_refl
l46: $ G ⇒ w = w $ by eq_refl
l47: $ G ⇒ r = r $ by eq_refl
l48: $ G ⇒ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r = cpi p (fv uni ∅) p $ by eq_trans [dt_eq [l44, l45, l4, l46, l47], l43]
l49: $ G , p ∊ fv uni ∅ ⇒ fv uni ∅ = two $ by uni_zero
l50: $ G , p ∊ fv uni ∅ ⇒ p ∊ fv uni ∅ $ by ax
l51: $ G , p ∊ fv uni ∅ ⇒ p ∈ two $ by welc_wcel [welc_eq [l49, l50]]
l52: $ G ⇒ p ∊ fv uni ∅ → p ∈ two $ by imp_intro [l51]
l53: $ G ⇒ ∀ p (p ∊ fv uni ∅ → p ∈ two) $ by all_intro [l52]
l54: $ G ⇒ cpi p (fv uni ∅) p ∈ two $ by cpi_two [l53]
l55: $ G ⇒ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ∈ two $ by wcel_eq_l [eq_sym [l48], l54]
l56: $ G , ∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ⇒ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r = cpi p (fv uni ∅) p $ by weaken [l48]
l57: $ G , ∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ⇒ ∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r $ by ax
l58: $ G , ∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ⇒ ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ $ by bot_elim [fl_bot2 [wcel_eq_r [l56, l57]]]
l59: $ G , ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ ⇒ functional uni $ by uni_functional
l60: $ G , ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ ⇒ isset ∅ $ by ax_empty
l61: $ G , ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ ⇒ isset (fv uni (suc ∅)) $ by fv_set_c [l59, suc_set [l60]]
l62: $ G , ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ ⇒ ¬ ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ $ by fsat_bot [l61, weaken [#5]]
l63: $ G , ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ ⇒ ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ $ by ax
l64: $ G , ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫ ⇒ ∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r $ by bot_elim [not_elim [l62, l63]]
l65: $ G ⇒ (∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ↔ ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫) $ by bi_intro [l58, l64]
l66: $ G ⇒ enc_expr lfalse ∈ trees ω $ by enc_expr_trees
l67: $ G ⇒ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e ∈ trees ω $ by wcel_eq_l [eq_sym [l4], l66]
l68: $ G ⇒ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ∈ two ∧ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e ∈ trees ω $ by and_intro [l55, l67]
l69: $ G ⇒ (∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ↔ ⟪ fv uni (suc ∅) , a ⊨ ⊥ₒ ⟫) ∧ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e) w r ∈ two ∧ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) ⊥ₒ e ∈ trees ω $ by and_intro [l65, l68]

lemma sm_eq (G: hyps) (b: blk) (E M: expr) (u w r e a i j: set): $ closed nz E $ > $ closed nz M $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ ty nil M (pi (pset b) (pi (pset b) Prop)) $ > $ inh nil (pset_e1 b E) $ > $ inh nil (pset_e2 b E) $ > $ inh nil (pset_e3 b E) $ > $ inh nil (pset_m1 b E M) $ > $ inh nil (pset_m2 b E M) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ e ∊ fseq (trees ω) $ > $ G ⇒ a ∊ fseq (fv uni (suc ∅)) $ > $ G ⇒ i ∊ cdm e $ > $ G ⇒ j ∊ cdm e $ > $ G ⇒ fv r (fv nvf (fv e i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i))) $ > $ G ⇒ fv r (fv nvf (fv e j)) ∈ psv u w b ∧ fv a j = fv (pcol u w b) (fv r (fv nvf (fv e j))) $ > $ G ⇒ (∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (i =ₒ j) e) w r ↔ ⟪ fv uni (suc ∅) , a ⊨ i =ₒ j ⟫) ∧ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (i =ₒ j) e) w r ∈ two ∧ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (i =ₒ j) e ∈ trees ω $
----
l1: $ G ⇒ uadm u $ by weaken [#10]
l2: $ G ⇒ w ∊ lvals $ by weaken [#11]
l3: $ G ⇒ w ∈ lvals $ by welc_wcel [#11]
l4: $ G ⇒ r ∈ fseq u $ by welc_wcel [#12]
