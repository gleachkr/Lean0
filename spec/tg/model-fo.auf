lemma sm_in (G: hyps) (b: blk) (E M: expr) (u w r e a i j: set): $ closed nz E $ > $ closed nz M $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ ty nil M (pi (pset b) (pi (pset b) Prop)) $ > $ inh nil (pset_e1 b E) $ > $ inh nil (pset_e2 b E) $ > $ inh nil (pset_e3 b E) $ > $ inh nil (pset_m1 b E M) $ > $ inh nil (pset_m2 b E M) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ e ∊ fseq (trees ω) $ > $ G ⇒ a ∊ fseq (fv uni (suc ∅)) $ > $ G ⇒ i ∊ cdm e $ > $ G ⇒ j ∊ cdm e $ > $ G ⇒ fv r (fv nvf (fv e i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i))) $ > $ G ⇒ fv r (fv nvf (fv e j)) ∈ psv u w b ∧ fv a j = fv (pcol u w b) (fv r (fv nvf (fv e j))) $ > $ G ⇒ (∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (i ∈ₒ j) e) w r ↔ ⟪ fv uni (suc ∅) , a ⊨ i ∈ₒ j ⟫) ∧ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (i ∈ₒ j) e) w r ∈ two ∧ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) (i ∈ₒ j) e ∈ trees ω $
----
