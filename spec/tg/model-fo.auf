l116: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) , (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) ⇒ fv a i ∈ fv a j $ by or_elim [l72, l96, l115]
l117: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) ⇒ fv a i ∈ fv a j $ by or_elim [l53, l71, l116]
l118: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩ ⇒ fv a i ∈ fv a j $ by or_elim [l40, l52, l117]
l119: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ fv a i ∈ fv a j $ by ax
l120: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ fv x2 ∅ = ⟨ i , ∅ ⟩ $ by weaken [l33]
l121: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ fv x2 (suc ∅) = ⟨ j , ∅ ⟩ $ by weaken [l35]
l122: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ fv x2 (suc ∅) = ⟨ j , ∅ ⟩ ∧ fv a i ∈ fv a j $ by and_intro [l121, l119]
l123: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ fv x2 ∅ = ⟨ i , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ j , ∅ ⟩ ∧ fv a i ∈ fv a j $ by and_intro [l120, l122]
l124: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ ∃ x5 (fv x2 ∅ = ⟨ i , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a i ∈ fv a x5) $ by ex_intro [l123]
l125: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5) $ by ex_intro [l124]
l126: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ x1 = suc (suc (suc (suc ∅))) $ by weaken [l5]
l127: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5) $ by and_intro [l126, l125]
l128: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) $ by or_intro_r [l127]
l129: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) $ by or_intro_r [l128]
l130: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ (x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅))) ∨ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) $ by or_intro_r [l129]
l131: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ a ∊ fseq A $ by weaken [#2]
l132: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ a ∊ fseq A ∧ ((x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅))) ∨ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5))) $ by and_intro [l131, l130]
l133: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ a ∊ fsb A x1 x2 x3 $ by cab_intro [l132]
l134: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩ = fsb A x1 x2 x3 $ by weaken [l27]
l135: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , fv a i ∈ fv a j ⇒ a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩ $ by wcel_eq_r [eq_sym [l134], welc_wcel [l133]]
l136: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 ⇒ (a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) ↔ (fv a i ∈ fv a j) $ by bi_intro [l118, l135]
l137: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⇒ functional (fsf A) $ by weaken [l3]
l138: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⇒ isset x2 $ by isset_var
l139: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⇒ isset (ccom (fsf A) x2) $ by ccom_set [l137, l138]
l140: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⇒ (a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) ↔ (fv a i ∈ fv a j) $ by isset_elim [l139, l136]
l141: $ G , x1 = suc (suc (suc (suc ∅))) ⇒ isset ∅ $ by ax_empty
l142: $ G , x1 = suc (suc (suc (suc ∅))) ⇒ isset (scons ⟨ j , ∅ ⟩ ∅) $ by scons_set [l141]
l143: $ G , x1 = suc (suc (suc (suc ∅))) ⇒ isset (scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅)) $ by scons_set [l142]
l144: $ G , x1 = suc (suc (suc (suc ∅))) ⇒ (a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) ↔ (fv a i ∈ fv a j) $ by isset_elim [l143, l140]
l145: $ G ⇒ isset ∅ $ by ax_empty
l146: $ G ⇒ isset (suc ∅) $ by suc_set [l145]
l147: $ G ⇒ isset (suc (suc ∅)) $ by suc_set [l146]
l148: $ G ⇒ isset (suc (suc (suc ∅))) $ by suc_set [l147]
l149: $ G ⇒ isset (suc (suc (suc (suc ∅)))) $ by suc_set [l148]
l150: $ G ⇒ (a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩) ↔ (fv a i ∈ fv a j) $ by isset_elim [l149, l144]

lemma lt_nd (G: hyps) (P E M: class) (x1 x2 x3: set): $ G ⇒ x1 ∊ ω $ > $ G ⇒ x2 ∊ fseq (trees ω) $ > $ G ⇒ x3 = ccom (ltf P E M) x2 $ > $ G ⇒ isset (ltb P E M x1 x2 x3) $ > $ G ⇒ fv (ltf P E M) ⟨ x1 , x2 ⟩ = ltb P E M x1 x2 x3 $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (cgr3 x7 x8 x9 (ltb P E M x7 x8 x9)) $ by cgr3_functional
l3: $ G ⇒ fv (ltf P E M) ⟨ x1 , x2 ⟩ = fv (cgr3 x7 x8 x9 (ltb P E M x7 x8 x9)) ⟨ x1 , ⟨ x2 , ccom (ltf P E M) x2 ⟩ ⟩ $ by trc_node_c [l1, l2, #1, #2]
l4: $ G ⇒ fv (cgr3 x7 x8 x9 (ltb P E M x7 x8 x9)) ⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ = ltb P E M x1 x2 x3 $ by fv_cgr3 [#4]
l5: $ G ⇒ x1 = x1 $ by eq_refl
l6: $ G ⇒ x2 = x2 $ by eq_refl
l7: $ G ⇒ ⟨ x1 , ⟨ x2 , ccom (ltf P E M) x2 ⟩ ⟩ = ⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ $ by opair_eq [l5, opair_eq [l6, eq_sym [#3]]]
l8: $ G ⇒ (cgr3 x7 x8 x9 (ltb P E M x7 x8 x9)) = (cgr3 x7 x8 x9 (ltb P E M x7 x8 x9)) $ by eq_refl
l9: $ G ⇒ fv (cgr3 x7 x8 x9 (ltb P E M x7 x8 x9)) ⟨ x1 , ⟨ x2 , ccom (ltf P E M) x2 ⟩ ⟩ = fv (cgr3 x7 x8 x9 (ltb P E M x7 x8 x9)) ⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ $ by fv_eq [l8, l7]
l10: $ G ⇒ fv (ltf P E M) ⟨ x1 , x2 ⟩ = ltb P E M x1 x2 x3 $ by eq_trans [l3, eq_trans [l9, l4]]

ltr_bot
-------
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (cgr3 x7 x8 x9 (ltb P E M x7 x8 x9)) $ by cgr3_functional
l3: $ G ⇒ functional (ltf P E M) $ by trc_functional_c [l1, l2]
l4: $ G ⇒ cdm (ltf P E M) = trees ω $ by trc_cdm_c [l1, l2]
l5: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 ⇒ x1 = ∅ $ by ax
l6: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 ⇒ x2 = ∅ $ by ax
l7: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 ⇒ x3 = ccom (ltf P E M) x2 $ by ax
l8: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 ⇒ ∅ ∈ ω $ by omega_zero
l9: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 ⇒ x1 ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l5], l8]]
l10: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l11: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 ⇒ x2 ∊ fseq (trees ω) $ by wcel_welc [wcel_eq_l [eq_sym [l6], l10]]
l12: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 , d ∊ ltb P E M x1 x2 x3 ⇒ d ∊ ltb P E M x1 x2 x3 $ by ax
l13: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 , d ∊ ltb P E M x1 x2 x3 ⇒ (x1 = ∅ ∧ d ∊ clam o (fseq (trees ω)) (enc_expr lfalse)) ∨ (x1 = suc ∅ ∧ d ∊ clam o (fseq (trees ω)) (tpi (ap (fv x3 ∅) o) (ap (fv x3 (suc ∅)) (lup o)))) ∨ (x1 = suc (suc ∅) ∧ d ∊ clam o (fseq (trees ω)) (tpi P (ap (fv x3 ∅) (scons ⟨ kc_nz , ∅ ⟩ (lup o))))) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ d ∊ clam o (fseq (trees ω)) (tapp (tapp E (tbv (fv o x4))) (tbv (fv o x5))))) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ d ∊ clam o (fseq (trees ω)) (tapp (tapp M (tbv (fv o x4))) (tbv (fv o x5))))) $ by cab_elim [l12]
l14: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 , d ∊ ltb P E M x1 x2 x3 , x1 = ∅ ∧ d ∊ clam o (fseq (trees ω)) (enc_expr lfalse) ⇒ x1 = ∅ ∧ d ∊ clam o (fseq (trees ω)) (enc_expr lfalse) $ by ax
l15: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 , d ∊ ltb P E M x1 x2 x3 , x1 = ∅ ∧ d ∊ clam o (fseq (trees ω)) (enc_expr lfalse) ⇒ d ∊ clam o (fseq (trees ω)) (enc_expr lfalse) $ by and_elim_r [l14]
l16: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (ltf P E M) x2 , d ∊ ltb P E M x1 x2 x3 , (x1 = suc ∅ ∧ d ∊ clam o (fseq (trees ω)) (tpi (ap (fv x3 ∅) o) (ap (fv x3 (suc ∅)) (lup o)))) ∨ (x1 = suc (suc ∅) ∧ d ∊ clam o (fseq (trees ω)) (tpi P (ap (fv x3 ∅) (scons ⟨ kc_nz , ∅ ⟩ (lup o))))) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ d ∊ clam o (fseq (trees ω)) (tapp (tapp E (tbv (fv o x4))) (tbv (fv o x5))))) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ d ∊ clam o (fseq (trees ω)) (tapp (tapp M (tbv (fv o x4))) (tbv (fv o x5))))) ⇒ (x1 = suc ∅ ∧ d ∊ clam o (fseq (trees ω)) (tpi (ap (fv x3 ∅) o) (ap (fv x3 (suc ∅)) (lup o)))) ∨ (x1 = suc (suc ∅) ∧ d ∊ clam o (fseq (trees ω)) (tpi P (ap (fv x3 ∅) (scons ⟨ kc_nz , ∅ ⟩ (lup o))))) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ d ∊ clam o (fseq (trees ω)) (tapp (tapp E (tbv (fv o x4))) (tbv (fv o x5))))) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ d ∊ clam o (fseq (trees ω)) (tapp (tapp M (tbv (fv o x4))) (tbv (fv o x5))))) $ by ax
