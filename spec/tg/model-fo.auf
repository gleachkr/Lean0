lemma fo_main {x y n c r e a i: set} (G: hyps) (b: blk) (E M: expr) (u w: set): $ closed nz E $ > $ closed nz M $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ ty nil M (pi (pset b) (pi (pset b) Prop)) $ > $ inh nil (pset_e1 b E) $ > $ inh nil (pset_e2 b E) $ > $ inh nil (pset_e3 b E) $ > $ inh nil (pset_m1 b E M) $ > $ inh nil (pset_m2 b E M) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lfp x (fmop x) ⊆ {y | y ∊ ω × trees ω ∧ ∀ n ∀ c (y = ⟨ n , c ⟩ → ∀ r ∀ e ∀ a (r ∊ fseq u → e ∊ fseq (trees ω) → a ∊ fseq (fv uni (suc ∅)) → cdm e = n → ∀ i (i ∊ n → fv r (fv nvf (fv e i)) ∈ psv u w b ∧ fv a i = fv (pcol u w b) (fv r (fv nvf (fv e i)))) → (∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) c e) w r ↔ ⟪ fv uni (suc ∅) , a ⊨ c ⟫) ∧ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) c e) w r ∈ two ∧ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) c e ∈ trees ω))} $
----
l1: $ G ⇒ mono x (fmop x) ∧ setop x (fmop x) ∧ bounded x (fmop x) (ω × trees ω) ∧ isset (ω × trees ω) $ by fm_lfp
