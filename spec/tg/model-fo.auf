l99: $ G , x1 = suc (suc (suc (suc ∅))) , x2 = scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ suc (suc (suc (suc ∅))) , scons ⟨ i , ∅ ⟩ (scons ⟨ j , ∅ ⟩ ∅) ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) , (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) , x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5) , fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5 ⇒ fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5 $ by ax
