
fimp_congr
----------
g1: $ (suc ∅) ≐ (suc ∅) $ by ceqt_refl
g2: $ ∅ ≐ ∅ $ by ceqt_refl
g3: $ (scons C ∅) ≐ (scons D ∅) $ by scons_congr [#2, g2]
g4: $ (scons A (scons C ∅)) ≐ (scons B (scons D ∅)) $ by scons_congr [#1, g3]
g5: $ fimp A C ≐ fimp B D $ by opair_congr [g1, g4]

sb_c_fimp
---------
l1: $ (⟦ x / t ⟧ opair (suc ∅) (scons A (scons B ∅))) ≐ opair (suc ∅) (scons (⟦ x / t ⟧ A) (scons (⟦ x / t ⟧ B) ∅)) $ by ceqt_refl

fall_congr
----------
g1: $ (suc (suc ∅)) ≐ (suc (suc ∅)) $ by ceqt_refl
g2: $ ∅ ≐ ∅ $ by ceqt_refl
g3: $ (scons A ∅) ≐ (scons B ∅) $ by scons_congr [#1, g2]
g4: $ fall A ≐ fall B $ by opair_congr [g1, g3]

sb_c_fall
---------
l1: $ (⟦ x / t ⟧ opair (suc (suc ∅)) (scons A ∅)) ≐ opair (suc (suc ∅)) (scons (⟦ x / t ⟧ A) ∅) $ by ceqt_refl

feq_congr
---------
g1: $ (suc (suc (suc ∅))) ≐ (suc (suc (suc ∅))) $ by ceqt_refl
g2: $ ∅ ≐ ∅ $ by ceqt_refl
g3: $ (opair A ∅) ≐ (opair B ∅) $ by opair_congr [#1, g2]
g4: $ ∅ ≐ ∅ $ by ceqt_refl
g5: $ (opair C ∅) ≐ (opair D ∅) $ by opair_congr [#2, g4]
g6: $ ∅ ≐ ∅ $ by ceqt_refl
g7: $ (scons (opair C ∅) ∅) ≐ (scons (opair D ∅) ∅) $ by scons_congr [g5, g6]
g8: $ (scons (opair A ∅) (scons (opair C ∅) ∅)) ≐ (scons (opair B ∅) (scons (opair D ∅) ∅)) $ by scons_congr [g3, g7]
g9: $ feq A C ≐ feq B D $ by opair_congr [g1, g8]

sb_c_feq
--------
l1: $ (⟦ x / t ⟧ opair (suc (suc (suc ∅))) (scons (opair A ∅) (scons (opair B ∅) ∅))) ≐ opair (suc (suc (suc ∅))) (scons (opair (⟦ x / t ⟧ A) ∅) (scons (opair (⟦ x / t ⟧ B) ∅) ∅)) $ by ceqt_refl

fin_congr
---------
g1: $ (suc (suc (suc (suc ∅)))) ≐ (suc (suc (suc (suc ∅)))) $ by ceqt_refl
g2: $ ∅ ≐ ∅ $ by ceqt_refl
g3: $ (opair A ∅) ≐ (opair B ∅) $ by opair_congr [#1, g2]
g4: $ ∅ ≐ ∅ $ by ceqt_refl
g5: $ (opair C ∅) ≐ (opair D ∅) $ by opair_congr [#2, g4]
g6: $ ∅ ≐ ∅ $ by ceqt_refl
g7: $ (scons (opair C ∅) ∅) ≐ (scons (opair D ∅) ∅) $ by scons_congr [g5, g6]
g8: $ (scons (opair A ∅) (scons (opair C ∅) ∅)) ≐ (scons (opair B ∅) (scons (opair D ∅) ∅)) $ by scons_congr [g3, g7]
g9: $ fin A C ≐ fin B D $ by opair_congr [g1, g8]

sb_c_fin
--------
l1: $ (⟦ x / t ⟧ opair (suc (suc (suc (suc ∅)))) (scons (opair A ∅) (scons (opair B ∅) ∅))) ≐ opair (suc (suc (suc (suc ∅)))) (scons (opair (⟦ x / t ⟧ A) ∅) (scons (opair (⟦ x / t ⟧ B) ∅) ∅)) $ by ceqt_refl

fmop_congr
----------
g1: $ (z ∊ (cxp ω (trees ω))) ⟺ (z ∊ (cxp ω (trees ω))) $ by iff_refl
g2: $ (n ∊ ω) ⟺ (n ∊ ω) $ by iff_refl
g3: $ (z = (opair n fbot)) ⟺ (z = (opair n fbot)) $ by iff_refl
g4: $ (z = (opair n (fimp p q))) ⟺ (z = (opair n (fimp p q))) $ by iff_refl
g5: $ (opair n p) ≐ (opair n p) $ by ceqt_refl
g6: $ ((opair n p) ∈ A) ⟺ ((opair n p) ∈ B) $ by wcel_congr [g5, #1]
g7: $ (opair n q) ≐ (opair n q) $ by ceqt_refl
g8: $ ((opair n q) ∈ A) ⟺ ((opair n q) ∈ B) $ by wcel_congr [g7, #1]
g9: $ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A)) ⟺ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B)) $ by and_congr [g6, g8]
g10: $ ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A))) ⟺ ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B))) $ by and_congr [g4, g9]
g11: $ (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A)))) ⟺ (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B)))) $ by ex_congr [g10]
g12: $ (∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A))))) ⟺ (∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B))))) $ by ex_congr [g11]
g13: $ (z = (opair n (fall p))) ⟺ (z = (opair n (fall p))) $ by iff_refl
g14: $ (opair (suc n) p) ≐ (opair (suc n) p) $ by ceqt_refl
g15: $ ((opair (suc n) p) ∈ A) ⟺ ((opair (suc n) p) ∈ B) $ by wcel_congr [g14, #1]
g16: $ ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A)) ⟺ ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ B)) $ by and_congr [g13, g15]
g17: $ (∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A))) ⟺ (∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ B))) $ by ex_congr [g16]
g18: $ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))) ⟺ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))) $ by iff_refl
g19: $ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j))))))))) ⟺ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ B))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j))))))))) $ by or_congr [g17, g18]
g20: $ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))))) ⟺ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ B))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))))) $ by or_congr [g12, g19]
g21: $ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j))))))))))) ⟺ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ B))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j))))))))))) $ by or_congr [g3, g20]
g22: $ ((n ∊ ω) ∧ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))))))) ⟺ ((n ∊ ω) ∧ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ B))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))))))) $ by and_congr [g2, g21]
g23: $ (∃ n ((n ∊ ω) ∧ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j))))))))))))) ⟺ (∃ n ((n ∊ ω) ∧ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ B))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j))))))))))))) $ by ex_congr [g22]
g24: $ ((z ∊ (cxp ω (trees ω))) ∧ (∃ n ((n ∊ ω) ∧ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))))))))) ⟺ ((z ∊ (cxp ω (trees ω))) ∧ (∃ n ((n ∊ ω) ∧ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ B) ∧ ((opair n q) ∈ B))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ B))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))))))))) $ by and_congr [g1, g23]
g25: $ fmop A ≐ fmop B $ by cab_congr [g24]

sb_c_fmop
---------
l1: $ (⟦ x / t ⟧ {z | (z ∊ (cxp ω (trees ω))) ∧ (∃ n ((n ∊ ω) ∧ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ A) ∧ ((opair n q) ∈ A))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ A))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))))))))}) ≐ {z | (z ∊ (cxp ω (trees ω))) ∧ (∃ n ((n ∊ ω) ∧ ((z = (opair n fbot)) ∨ ((∃ p (∃ q ((z = (opair n (fimp p q))) ∧ (((opair n p) ∈ (⟦ x / t ⟧ A)) ∧ ((opair n q) ∈ (⟦ x / t ⟧ A)))))) ∨ ((∃ p ((z = (opair n (fall p))) ∧ ((opair (suc n) p) ∈ (⟦ x / t ⟧ A)))) ∨ (∃ i (∃ j ((i ∊ n) ∧ ((j ∊ n) ∧ ((z = (opair n (feq i j))) ∨ (z = (opair n (fin i j)))))))))))))} $ by ceqt_refl

fm_congr
--------
g1: $ z ≐ z $ by ceqt_refl
g2: $ (opair A z) ≐ (opair B z) $ by opair_congr [#1, g1]
g3: $ fmla ≐ fmla $ by ceqt_refl
g4: $ ((opair A z) ∈ fmla) ⟺ ((opair B z) ∈ fmla) $ by wcel_congr [g2, g3]
g5: $ fm A ≐ fm B $ by cab_congr [g4]

sb_c_fm
-------
l1: $ (⟦ x / t ⟧ {z | (opair A z) ∈ fmla}) ≐ {z | (opair (⟦ x / t ⟧ A) z) ∈ fmla} $ by ceqt_refl

fsb_congr
---------
g1: $ seqt z z $ by seqt_refl
g2: $ (fseq A) ≐ (fseq B) $ by fseq_congr [#1]
g3: $ (z ∊ (fseq A)) ⟺ (z ∊ (fseq B)) $ by welc_congr [g1, g2]
g4: $ (suc ∅) ≐ (suc ∅) $ by ceqt_refl
g5: $ (C = (suc ∅)) ⟺ (D = (suc ∅)) $ by ceq_congr [#2, g4]
g6: $ seqt z z $ by seqt_refl
g7: $ ∅ ≐ ∅ $ by ceqt_refl
g8: $ (fv H ∅) ≐ (fv I ∅) $ by fv_congr [#4, g7]
g9: $ (z ∊ (fv H ∅)) ⟺ (z ∊ (fv I ∅)) $ by welc_congr [g6, g8]
g10: $ seqt z z $ by seqt_refl
g11: $ (suc ∅) ≐ (suc ∅) $ by ceqt_refl
g12: $ (fv H (suc ∅)) ≐ (fv I (suc ∅)) $ by fv_congr [#4, g11]
g13: $ (z ∊ (fv H (suc ∅))) ⟺ (z ∊ (fv I (suc ∅))) $ by welc_congr [g10, g12]
g14: $ ((z ∊ (fv H ∅)) → (z ∊ (fv H (suc ∅)))) ⟺ ((z ∊ (fv I ∅)) → (z ∊ (fv I (suc ∅)))) $ by im_congr [g9, g13]
g15: $ ((C = (suc ∅)) ∧ ((z ∊ (fv H ∅)) → (z ∊ (fv H (suc ∅))))) ⟺ ((D = (suc ∅)) ∧ ((z ∊ (fv I ∅)) → (z ∊ (fv I (suc ∅))))) $ by and_congr [g5, g14]
g16: $ (suc (suc ∅)) ≐ (suc (suc ∅)) $ by ceqt_refl
g17: $ (C = (suc (suc ∅))) ⟺ (D = (suc (suc ∅))) $ by ceq_congr [#2, g16]
g18: $ seqt y y $ by seqt_refl
g19: $ (y ∊ A) ⟺ (y ∊ B) $ by welc_congr [g18, #1]
g20: $ (scons y z) ≐ (scons y z) $ by ceqt_refl
g21: $ ∅ ≐ ∅ $ by ceqt_refl
g22: $ (fv H ∅) ≐ (fv I ∅) $ by fv_congr [#4, g21]
g23: $ ((scons y z) ∈ (fv H ∅)) ⟺ ((scons y z) ∈ (fv I ∅)) $ by wcel_congr [g20, g22]
g24: $ ((y ∊ A) → ((scons y z) ∈ (fv H ∅))) ⟺ ((y ∊ B) → ((scons y z) ∈ (fv I ∅))) $ by im_congr [g19, g23]
g25: $ (∀ y ((y ∊ A) → ((scons y z) ∈ (fv H ∅)))) ⟺ (∀ y ((y ∊ B) → ((scons y z) ∈ (fv I ∅)))) $ by all_congr [g24]
g26: $ ((C = (suc (suc ∅))) ∧ (∀ y ((y ∊ A) → ((scons y z) ∈ (fv H ∅))))) ⟺ ((D = (suc (suc ∅))) ∧ (∀ y ((y ∊ B) → ((scons y z) ∈ (fv I ∅))))) $ by and_congr [g17, g25]
g27: $ (suc (suc (suc ∅))) ≐ (suc (suc (suc ∅))) $ by ceqt_refl
g28: $ (C = (suc (suc (suc ∅)))) ⟺ (D = (suc (suc (suc ∅)))) $ by ceq_congr [#2, g27]
g29: $ ∅ ≐ ∅ $ by ceqt_refl
g30: $ (fv E ∅) ≐ (fv F ∅) $ by fv_congr [#3, g29]
g31: $ (opair i ∅) ≐ (opair i ∅) $ by ceqt_refl
g32: $ ((fv E ∅) = (opair i ∅)) ⟺ ((fv F ∅) = (opair i ∅)) $ by ceq_congr [g30, g31]
g33: $ (suc ∅) ≐ (suc ∅) $ by ceqt_refl
g34: $ (fv E (suc ∅)) ≐ (fv F (suc ∅)) $ by fv_congr [#3, g33]
g35: $ (opair j ∅) ≐ (opair j ∅) $ by ceqt_refl
g36: $ ((fv E (suc ∅)) = (opair j ∅)) ⟺ ((fv F (suc ∅)) = (opair j ∅)) $ by ceq_congr [g34, g35]
g37: $ ((fv z i) = (fv z j)) ⟺ ((fv z i) = (fv z j)) $ by iff_refl
g38: $ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j))) ⟺ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j))) $ by and_congr [g36, g37]
g39: $ (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j)))) ⟺ (((fv F ∅) = (opair i ∅)) ∧ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j)))) $ by and_congr [g32, g38]
g40: $ (∃ j (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j))))) ⟺ (∃ j (((fv F ∅) = (opair i ∅)) ∧ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j))))) $ by ex_congr [g39]
g41: $ (∃ i (∃ j (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j)))))) ⟺ (∃ i (∃ j (((fv F ∅) = (opair i ∅)) ∧ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j)))))) $ by ex_congr [g40]
g42: $ ((C = (suc (suc (suc ∅)))) ∧ (∃ i (∃ j (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j))))))) ⟺ ((D = (suc (suc (suc ∅)))) ∧ (∃ i (∃ j (((fv F ∅) = (opair i ∅)) ∧ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j))))))) $ by and_congr [g28, g41]
g43: $ (suc (suc (suc (suc ∅)))) ≐ (suc (suc (suc (suc ∅)))) $ by ceqt_refl
g44: $ (C = (suc (suc (suc (suc ∅))))) ⟺ (D = (suc (suc (suc (suc ∅))))) $ by ceq_congr [#2, g43]
g45: $ ∅ ≐ ∅ $ by ceqt_refl
g46: $ (fv E ∅) ≐ (fv F ∅) $ by fv_congr [#3, g45]
g47: $ (opair i ∅) ≐ (opair i ∅) $ by ceqt_refl
g48: $ ((fv E ∅) = (opair i ∅)) ⟺ ((fv F ∅) = (opair i ∅)) $ by ceq_congr [g46, g47]
g49: $ (suc ∅) ≐ (suc ∅) $ by ceqt_refl
g50: $ (fv E (suc ∅)) ≐ (fv F (suc ∅)) $ by fv_congr [#3, g49]
g51: $ (opair j ∅) ≐ (opair j ∅) $ by ceqt_refl
g52: $ ((fv E (suc ∅)) = (opair j ∅)) ⟺ ((fv F (suc ∅)) = (opair j ∅)) $ by ceq_congr [g50, g51]
g53: $ ((fv z i) ∈ (fv z j)) ⟺ ((fv z i) ∈ (fv z j)) $ by iff_refl
g54: $ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j))) ⟺ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j))) $ by and_congr [g52, g53]
g55: $ (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j)))) ⟺ (((fv F ∅) = (opair i ∅)) ∧ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j)))) $ by and_congr [g48, g54]
g56: $ (∃ j (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j))))) ⟺ (∃ j (((fv F ∅) = (opair i ∅)) ∧ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j))))) $ by ex_congr [g55]
g57: $ (∃ i (∃ j (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j)))))) ⟺ (∃ i (∃ j (((fv F ∅) = (opair i ∅)) ∧ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j)))))) $ by ex_congr [g56]
g58: $ ((C = (suc (suc (suc (suc ∅))))) ∧ (∃ i (∃ j (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j))))))) ⟺ ((D = (suc (suc (suc (suc ∅))))) ∧ (∃ i (∃ j (((fv F ∅) = (opair i ∅)) ∧ (((fv F (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j))))))) $ by and_congr [g44, g57]
