l40: $ G , a = S , i = I , j = J , ⟪ A , S ⊨ I ∈ₒ J ⟫ ⇒ fv S I ∈ fv S J $ by wcel_eq_l [eq_sym [l38], wcel_eq_r [eq_sym [l39], l37]]
l41: $ G , a = S , i = I , j = J , fv S I ∈ fv S J ⇒ fv S I = fv a i $ by weaken [l32]
l42: $ G , a = S , i = I , j = J , fv S I ∈ fv S J ⇒ fv S J = fv a j $ by weaken [l33]
l43: $ G , a = S , i = I , j = J , fv S I ∈ fv S J ⇒ fv S I ∈ fv S J $ by ax
l44: $ G , a = S , i = I , j = J , fv S I ∈ fv S J ⇒ fv a i ∈ fv a j $ by wcel_eq_l [l41, wcel_eq_r [l42, l43]]
l45: $ G , a = S , i = I , j = J , fv S I ∈ fv S J ⇒ ⟪ A , S ⊨ I ∈ₒ J ⟫ ↔ ⟪ A , a ⊨ i ∈ₒ j ⟫ $ by weaken [l31]
l46: $ G , a = S , i = I , j = J , fv S I ∈ fv S J ⇒ ⟪ A , a ⊨ i ∈ₒ j ⟫ ↔ fv a i ∈ fv a j $ by weaken [l11]
l47: $ G , a = S , i = I , j = J , fv S I ∈ fv S J ⇒ ⟪ A , S ⊨ I ∈ₒ J ⟫ $ by bi_elim_r [l45, bi_elim_r [l46, l44]]
l48: $ G , a = S , i = I , j = J ⇒ ⟪ A , S ⊨ I ∈ₒ J ⟫ ↔ fv S I ∈ fv S J $ by bi_intro [l40, l47]
l49: $ G , a = S , i = I ⇒ J ∈ ω $ by weaken [#4]
l50: $ G , a = S , i = I ⇒ isset J $ by wcel_isset [l49]
l51: $ G , a = S , i = I ⇒ ⟪ A , S ⊨ I ∈ₒ J ⟫ ↔ fv S I ∈ fv S J $ by isset_elim [l50, l48]
l52: $ G , a = S ⇒ I ∈ ω $ by weaken [#3]
l53: $ G , a = S ⇒ isset I $ by wcel_isset [l52]
l54: $ G , a = S ⇒ ⟪ A , S ⊨ I ∈ₒ J ⟫ ↔ fv S I ∈ fv S J $ by isset_elim [l53, l51]
l55: $ G ⇒ S ∈ fseq A $ by weaken [#2]
l56: $ G ⇒ isset S $ by wcel_isset [l55]
l57: $ G ⇒ ⟪ A , S ⊨ I ∈ₒ J ⟫ ↔ fv S I ∈ fv S J $ by isset_elim [l56, l54]

lemma fm_fix {x: set} (G: hyps): $ G ⇒ cap x (fmop x) fmla = fmla ∧ isset fmla $
----
l1: $ G ⇒ mono x (fmop x) ∧ setop x (fmop x) ∧ bounded x (fmop x) (ω × trees ω) ∧ isset (ω × trees ω) $ by fm_lfp
l2: $ G ⇒ mono x (fmop x) $ by and_elim_l [l1]
l3: $ G ⇒ setop x (fmop x) $ by and_elim_l [and_elim_r [l1]]
l4: $ G ⇒ bounded x (fmop x) (ω × trees ω) $ by and_elim_l [and_elim_r [and_elim_r [l1]]]
l5: $ G ⇒ isset (ω × trees ω) $ by and_elim_r [and_elim_r [and_elim_r [l1]]]
l6: $ G ⇒ cap x (fmop x) (lfp x (fmop x)) = lfp x (fmop x) $ by lfp_fix [l2, l3, l4, l5]
l7: $ G ⇒ isset (lfp x (fmop x)) $ by lfp_set [l4, l3, l5]
l8: $ G ⇒ cap x (fmop x) fmla = fmla ∧ isset fmla $ by and_intro [l6, l7]

lemma fm_cl (G: hyps) (z d: set): $ G ⇒ z ∊ fmop d $ > $ G ⇒ d = fmla $ > $ G ⇒ z ∊ fmla $
----
l1: $ G ⇒ cap x (fmop x) fmla = fmla ∧ isset fmla $ by fm_fix
l2: $ G ⇒ cap x (fmop x) fmla = fmla $ by and_elim_l [l1]
l3: $ G ⇒ z ∊ cap x (fmop x) fmla $ by cap_intro [#2, #1]
l4: $ G ⇒ z ∊ fmla $ by welc_eq [l2, l3]

lemma fm_i (G: hyps) (N C: class): $ G ⇒ isset C $ > $ G ⇒ ⟨ N , C ⟩ ∈ fmla $ > $ G ⇒ C ∈ fm N $
----
l1: $ G , z = C ⇒ N = N $ by eq_refl
l2: $ G , z = C ⇒ z = C $ by ax
l3: $ G , z = C ⇒ ⟨ N , z ⟩ ∈ fmla $ by wcel_eq_l [opair_eq [l1, eq_sym [l2]], weaken [#2]]
l4: $ G ⇒ C ∈ fm N $ by wcel_cab_intro [#1, l3]

lemma fm_e (G: hyps) (N C: class): $ G ⇒ C ∈ fm N $ > $ G ⇒ ⟨ N , C ⟩ ∈ fmla $
----
l1: $ G , c = C ⇒ c = C $ by ax
l2: $ G , c = C ⇒ C ∈ fm N $ by weaken [#1]
l3: $ G , c = C ⇒ c ∊ fm N $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , c = C ⇒ N = N $ by eq_refl
l5: $ G , c = C ⇒ ⟨ N , c ⟩ ∈ fmla $ by cab_elim [l3]
l6: $ G , c = C ⇒ ⟨ N , C ⟩ ∈ fmla $ by wcel_eq_l [opair_eq [l4, l1], l5]
l7: $ G ⇒ isset C $ by wcel_isset [#1]
l8: $ G ⇒ ⟨ N , C ⟩ ∈ fmla $ by isset_elim [l7, l6]

fm_tree
-------
l1: $ G ⇒ ⟨ N , C ⟩ ∈ fmla $ by fm_e [#1]
l2: $ G ⇒ cap x (fmop x) fmla = fmla ∧ isset fmla $ by fm_fix
l3: $ G ⇒ cap x (fmop x) fmla = fmla $ by and_elim_l [l2]
l4: $ G , z = ⟨ N , C ⟩ ⇒ z = ⟨ N , C ⟩ $ by ax
l5: $ G , z = ⟨ N , C ⟩ ⇒ cap x (fmop x) fmla = fmla $ by weaken [l3]
l6: $ G , z = ⟨ N , C ⟩ ⇒ ⟨ N , C ⟩ ∈ fmla $ by weaken [l1]
l7: $ G , z = ⟨ N , C ⟩ ⇒ z ∊ cap x (fmop x) fmla $ by welc_eq [eq_sym [l5], wcel_welc [wcel_eq_l [eq_sym [l4], l6]]]
l8: $ G , z = ⟨ N , C ⟩ ⇒ ∃ x (x = fmla ∧ z ∊ fmop x) $ by cap_elim [l7]
l9: $ G , z = ⟨ N , C ⟩ , x = fmla ∧ z ∊ fmop x ⇒ x = fmla ∧ z ∊ fmop x $ by ax
l10: $ G , z = ⟨ N , C ⟩ , x = fmla ∧ z ∊ fmop x ⇒ z ∊ fmop x $ by and_elim_r [l9]
l11: $ G , z = ⟨ N , C ⟩ , x = fmla ∧ z ∊ fmop x ⇒ z ∊ ω × trees ω ∧ ∃ m (m ∊ ω ∧ (z = ⟨ m , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ m , p →ₒ q ⟩ ∧ ⟨ m , p ⟩ ∈ x ∧ ⟨ m , q ⟩ ∈ x) ∨ ∃ p (z = ⟨ m , ∀ₒ p ⟩ ∧ ⟨ suc m , p ⟩ ∈ x) ∨ ∃ x4 ∃ x5 (x4 ∊ m ∧ x5 ∊ m ∧ (z = ⟨ m , x4 =ₒ x5 ⟩ ∨ z = ⟨ m , x4 ∈ₒ x5 ⟩)))) $ by cab_elim [l10]
l12: $ G , z = ⟨ N , C ⟩ , x = fmla ∧ z ∊ fmop x ⇒ z ∊ ω × trees ω $ by and_elim_l [l11]
l13: $ G , z = ⟨ N , C ⟩ , x = fmla ∧ z ∊ fmop x ⇒ z = ⟨ N , C ⟩ $ by weaken [l4]
l14: $ G , z = ⟨ N , C ⟩ , x = fmla ∧ z ∊ fmop x ⇒ N ∈ ω ∧ C ∈ trees ω $ by cxp_elim_pair_c [wcel_eq_l [l13, welc_wcel [l12]], weaken [#2], wcel_isset [weaken [#1]]]
l15: $ G , z = ⟨ N , C ⟩ ⇒ N ∈ ω ∧ C ∈ trees ω $ by ex_elim [l8, l14]
l16: $ G ⇒ isset ⟨ N , C ⟩ $ by opair_isset
l17: $ G ⇒ N ∈ ω ∧ C ∈ trees ω $ by isset_elim [l16, l15]

fm_bot
------
