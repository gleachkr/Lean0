sb_c_fsb
--------
l1: $ (⟦ x / t ⟧ {z | (z ∊ (fseq A)) ∧ (((B = (suc ∅)) ∧ ((z ∊ (fv D ∅)) → (z ∊ (fv D (suc ∅))))) ∨ (((B = (suc (suc ∅))) ∧ (∀ y ((y ∊ A) → ((scons y z) ∈ (fv D ∅))))) ∨ (((B = (suc (suc (suc ∅)))) ∧ (∃ i (∃ j (((fv C ∅) = (opair i ∅)) ∧ (((fv C (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j))))))) ∨ ((B = (suc (suc (suc (suc ∅))))) ∧ (∃ i (∃ j (((fv C ∅) = (opair i ∅)) ∧ (((fv C (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j))))))))))}) ≐ {z | (z ∊ (fseq (⟦ x / t ⟧ A))) ∧ ((((⟦ x / t ⟧ B) = (suc ∅)) ∧ ((z ∊ (fv (⟦ x / t ⟧ D) ∅)) → (z ∊ (fv (⟦ x / t ⟧ D) (suc ∅))))) ∨ ((((⟦ x / t ⟧ B) = (suc (suc ∅))) ∧ (∀ y ((y ∊ (⟦ x / t ⟧ A)) → ((scons y z) ∈ (fv (⟦ x / t ⟧ D) ∅))))) ∨ ((((⟦ x / t ⟧ B) = (suc (suc (suc ∅)))) ∧ (∃ i (∃ j (((fv (⟦ x / t ⟧ C) ∅) = (opair i ∅)) ∧ (((fv (⟦ x / t ⟧ C) (suc ∅)) = (opair j ∅)) ∧ ((fv z i) = (fv z j))))))) ∨ (((⟦ x / t ⟧ B) = (suc (suc (suc (suc ∅))))) ∧ (∃ i (∃ j (((fv (⟦ x / t ⟧ C) ∅) = (opair i ∅)) ∧ (((fv (⟦ x / t ⟧ C) (suc ∅)) = (opair j ∅)) ∧ ((fv z i) ∈ (fv z j))))))))))} $ by ceqt_refl

