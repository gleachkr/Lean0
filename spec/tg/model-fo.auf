l1: $ [x/t] (∀ w ((w ∊ A) → (∀ p ((p ∊ A) → ((r_omega A w) → ((r_pow A p w) → (∀ a ((a ∊ A) → ((r_sub A a p) → ((∃ f ((f ∊ A) ∧ (r_inj A f a w))) ∨ (∃ f ((f ∊ A) ∧ (r_inj A f p a))))))))))))) ⟺ (∀ w ((w ∊ (⟦ x / t ⟧ A)) → (∀ p ((p ∊ (⟦ x / t ⟧ A)) → ((r_omega (⟦ x / t ⟧ A) w) → ((r_pow (⟦ x / t ⟧ A) p w) → (∀ a ((a ∊ (⟦ x / t ⟧ A)) → ((r_sub (⟦ x / t ⟧ A) a p) → ((∃ f ((f ∊ (⟦ x / t ⟧ A)) ∧ (r_inj (⟦ x / t ⟧ A) f a w))) ∨ (∃ f ((f ∊ (⟦ x / t ⟧ A)) ∧ (r_inj (⟦ x / t ⟧ A) f p a))))))))))))) $ by iff_refl

