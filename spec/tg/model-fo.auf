c_omega_congr
-------------
g1: $ (c_ind A) ≐ (c_ind B) $ by c_ind_congr [#1]
g2: $ (c_ind ∅) ≐ (c_ind ∅) $ by ceqt_refl
g3: $ (suc A) ≐ (suc B) $ by suc_congr [#1]
g4: $ ∅ ≐ ∅ $ by ceqt_refl
g5: $ (c_sub (suc A) ∅) ≐ (c_sub (suc B) ∅) $ by c_sub_congr [g3, g4]
g6: $ (fimp (c_ind ∅) (c_sub (suc A) ∅)) ≐ (fimp (c_ind ∅) (c_sub (suc B) ∅)) $ by fimp_congr [g2, g5]
g7: $ (fall (fimp (c_ind ∅) (c_sub (suc A) ∅))) ≐ (fall (fimp (c_ind ∅) (c_sub (suc B) ∅))) $ by fall_congr [g6]
g8: $ c_omega A ≐ c_omega B $ by fand_congr [g1, g7]

sb_c_c_omega
------------
l1: $ (⟦ x / t ⟧ fand (c_ind A) (fall (fimp (c_ind ∅) (c_sub (suc A) ∅)))) ≐ fand (c_ind (⟦ x / t ⟧ A)) (fall (fimp (c_ind ∅) (c_sub (suc (⟦ x / t ⟧ A)) ∅))) $ by ceqt_refl

r_omega_congr
-------------
g1: $ (r_ind A C) ⟺ (r_ind B D) $ by r_ind_congr [#1, #2]
g2: $ seqt v v $ by seqt_refl
g3: $ (v ∊ A) ⟺ (v ∊ B) $ by welc_congr [g2, #1]
g4: $ v ≐ v $ by ceqt_refl
g5: $ (r_ind A v) ⟺ (r_ind B v) $ by r_ind_congr [#1, g4]
g6: $ v ≐ v $ by ceqt_refl
g7: $ (r_sub A C v) ⟺ (r_sub B D v) $ by r_sub_congr [#1, #2, g6]
g8: $ ((r_ind A v) → (r_sub A C v)) ⟺ ((r_ind B v) → (r_sub B D v)) $ by im_congr [g5, g7]
g9: $ ((v ∊ A) → ((r_ind A v) → (r_sub A C v))) ⟺ ((v ∊ B) → ((r_ind B v) → (r_sub B D v))) $ by im_congr [g3, g8]
g10: $ (∀ v ((v ∊ A) → ((r_ind A v) → (r_sub A C v)))) ⟺ (∀ v ((v ∊ B) → ((r_ind B v) → (r_sub B D v)))) $ by all_congr [g9]
g11: $ r_omega A C ⟺ r_omega B D $ by and_congr [g1, g10]

sb_f_r_omega
------------
l1: $ [x/t] ((r_ind A B) ∧ (∀ v ((v ∊ A) → ((r_ind A v) → (r_sub A B v))))) ⟺ ((r_ind (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) ∧ (∀ v ((v ∊ (⟦ x / t ⟧ A)) → ((r_ind (⟦ x / t ⟧ A) v) → (r_sub (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) v))))) $ by iff_refl

