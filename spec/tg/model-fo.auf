l2: $ G ⇒ r ∈ fseq u $ by welc_wcel [#3]
l3: $ G ⇒ (∅ ∈ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) p e) w r ↔ ⟪ fv uni (suc ∅) , a ⊨ p ⟫) $ by and_elim_l [#8]
l4: $ G ⇒ dt u (mcv hfin) (ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) p e) w r ∈ two $ by and_elim_l [and_elim_r [#8]]
l5: $ G ⇒ ltr (enc_expr (pset b)) (enc_expr E) (enc_expr M) p e ∈ trees ω $ by and_elim_r [and_elim_r [#8]]
