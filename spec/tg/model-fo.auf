l1: $ (⟦ x / t ⟧ {z | ((D = ∅) ∧ (z ∊ (clam r (fseq (trees ω)) (enc_expr lfalse)))) ∨ (((D = (suc ∅)) ∧ (z ∊ (clam r (fseq (trees ω)) (opair kc_pi (scons (ap (fv F ∅) r) (scons (ap (fv F (suc ∅)) (lup r)) ∅)))))) ∨ (((D = (suc (suc ∅))) ∧ (z ∊ (clam r (fseq (trees ω)) (opair kc_pi (scons A (scons (ap (fv F ∅) (scons (opair kc_nz ∅) (lup r))) ∅)))))) ∨ (((D = (suc (suc (suc ∅)))) ∧ (∃ i (∃ j (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ (z ∊ (clam r (fseq (trees ω)) (opair kc_app (scons (opair kc_app (scons B (scons (opair kc_bvar (scons (fv r i) ∅)) ∅))) (scons (opair kc_bvar (scons (fv r j) ∅)) ∅)))))))))) ∨ ((D = (suc (suc (suc (suc ∅))))) ∧ (∃ i (∃ j (((fv E ∅) = (opair i ∅)) ∧ (((fv E (suc ∅)) = (opair j ∅)) ∧ (z ∊ (clam r (fseq (trees ω)) (opair kc_app (scons (opair kc_app (scons C (scons (opair kc_bvar (scons (fv r i) ∅)) ∅))) (scons (opair kc_bvar (scons (fv r j) ∅)) ∅)))))))))))))}) ≐ {z | (((⟦ x / t ⟧ D) = ∅) ∧ (z ∊ (clam r (fseq (trees ω)) (enc_expr lfalse)))) ∨ ((((⟦ x / t ⟧ D) = (suc ∅)) ∧ (z ∊ (clam r (fseq (trees ω)) (opair kc_pi (scons (ap (fv (⟦ x / t ⟧ F) ∅) r) (scons (ap (fv (⟦ x / t ⟧ F) (suc ∅)) (lup r)) ∅)))))) ∨ ((((⟦ x / t ⟧ D) = (suc (suc ∅))) ∧ (z ∊ (clam r (fseq (trees ω)) (opair kc_pi (scons (⟦ x / t ⟧ A) (scons (ap (fv (⟦ x / t ⟧ F) ∅) (scons (opair kc_nz ∅) (lup r))) ∅)))))) ∨ ((((⟦ x / t ⟧ D) = (suc (suc (suc ∅)))) ∧ (∃ i (∃ j (((fv (⟦ x / t ⟧ E) ∅) = (opair i ∅)) ∧ (((fv (⟦ x / t ⟧ E) (suc ∅)) = (opair j ∅)) ∧ (z ∊ (clam r (fseq (trees ω)) (opair kc_app (scons (opair kc_app (scons (⟦ x / t ⟧ B) (scons (opair kc_bvar (scons (fv r i) ∅)) ∅))) (scons (opair kc_bvar (scons (fv r j) ∅)) ∅)))))))))) ∨ (((⟦ x / t ⟧ D) = (suc (suc (suc (suc ∅))))) ∧ (∃ i (∃ j (((fv (⟦ x / t ⟧ E) ∅) = (opair i ∅)) ∧ (((fv (⟦ x / t ⟧ E) (suc ∅)) = (opair j ∅)) ∧ (z ∊ (clam r (fseq (trees ω)) (opair kc_app (scons (opair kc_app (scons (⟦ x / t ⟧ C) (scons (opair kc_bvar (scons (fv r i) ∅)) ∅))) (scons (opair kc_bvar (scons (fv r j) ∅)) ∅)))))))))))))} $ by ceqt_refl

ltf_congr
---------
g0: $ k ≐ k $ by ceqt_refl
g1: $ j ≐ j $ by ceqt_refl
g2: $ v ≐ v $ by ceqt_refl
g3: $ ltb A C E k j v ≐ ltb B D F k j v $ by ltb_congr [#1, #2, #3, g0, g1, g2]
g4: $ cgr3 k j v (ltb A C E k j v) ≐ cgr3 k j v (ltb B D F k j v) $ by cgr3_congr [g3]
g5: $ ω ≐ ω $ by ceqt_refl
g6: $ ltf A C E ≐ ltf B D F $ by trc_congr [g5, g4]

sb_c_ltf
--------
l1: $ (⟦ x / t ⟧ (trc ω (cgr3 k j v (ltb A B C k j v)))) ≐ trc ω (cgr3 k j v (ltb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) k j v)) $ by ceqt_refl

ltr_congr
---------
g1: $ (ltf A C E) ≐ (ltf B D F) $ by ltf_congr [#1, #2, #3]
g2: $ (fv (ltf A C E) H) ≐ (fv (ltf B D F) I) $ by fv_congr [g1, #4]
g3: $ ltr A C E H J ≐ ltr B D F I K $ by ap_congr [g2, #5]

sb_c_ltr
--------
l1: $ (⟦ x / t ⟧ ap (fv (ltf A B C) D) E) ≐ ap (fv (ltf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C)) (⟦ x / t ⟧ D)) (⟦ x / t ⟧ E) $ by ceqt_refl

lemma fo_k0 (G: hyps) (F S: class) (p: set): $ G ⇒ functional F $ > $ G ⇒ p ∊ cdm F $ > $ G ⇒ isset S $ > $ G ⇒ fv (ccom F (scons p S)) ∅ = fv F p $
----
l1: $ G ⇒ isset (fv F p) $ by fv_set [#1]
l2: $ G ⇒ isset (ccom F S) $ by ccom_set [#1, #3]
l3: $ G ⇒ ccom F (scons p S) = scons (fv F p) (ccom F S) $ by ccom_scons_c [#1, welc_wcel [#2], #3]
l4: $ G ⇒ fv (scons (fv F p) (ccom F S)) ∅ = fv F p $ by scons_fv_zero_c [l1, l2]
l5: $ G ⇒ ∅ = ∅ $ by eq_refl
l6: $ G ⇒ fv (ccom F (scons p S)) ∅ = fv F p $ by eq_trans [fv_eq [l3, l5], l4]

lemma fo_k1 (G: hyps) (F S: class) (p q: set): $ G ⇒ functional F $ > $ G ⇒ p ∊ cdm F $ > $ G ⇒ q ∊ cdm F $ > $ G ⇒ isset S $ > $ G ⇒ fv (ccom F (scons p (scons q S))) (suc ∅) = fv F q $
----
l1: $ G ⇒ isset (fv F p) $ by fv_set [#1]
l2: $ G ⇒ isset (scons q S) $ by scons_set [#4]
l3: $ G ⇒ isset (ccom F (scons q S)) $ by ccom_set [#1, l2]
l4: $ G ⇒ ccom F (scons p (scons q S)) = scons (fv F p) (ccom F (scons q S)) $ by ccom_scons_c [#1, welc_wcel [#2], l2]
l5: $ G ⇒ isset ∅ $ by ax_empty
l6: $ G ⇒ fv (scons (fv F p) (ccom F (scons q S))) (suc ∅) = fv (ccom F (scons q S)) ∅ $ by scons_fv_suc_c [l1, l3, l5]
l7: $ G ⇒ fv (ccom F (scons q S)) ∅ = fv F q $ by fo_k0 [#1, #3, #4]
l8: $ G ⇒ (suc ∅) = (suc ∅) $ by eq_refl
l9: $ G ⇒ fv (ccom F (scons p (scons q S))) (suc ∅) = fv F q $ by eq_trans [fv_eq [l4, l8], eq_trans [l6, l7]]

lemma fs_set (G: hyps) (A K S V: class): $ G ⇒ isset A $ > $ G ⇒ isset (fsb A K S V) $
----
l1: $ G , z ∊ fsb A K S V ⇒ z ∊ fsb A K S V $ by ax
l2: $ G , z ∊ fsb A K S V ⇒ z ∊ fseq A ∧ ((K = suc ∅ ∧ (z ∊ fv V ∅ → z ∊ fv V (suc ∅))) ∨ (K = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y z ∈ fv V ∅)) ∨ (K = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv S ∅ = ⟨ x4 , ∅ ⟩ ∧ fv S (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv z x4 = fv z x5)) ∨ (K = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv S ∅ = ⟨ x4 , ∅ ⟩ ∧ fv S (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv z x4 ∈ fv z x5))) $ by cab_elim [l1]
l3: $ G , z ∊ fsb A K S V ⇒ z ∊ fseq A $ by and_elim_l [l2]
l4: $ G ⇒ fsb A K S V ⊆ fseq A $ by subset_intro [l3]
l5: $ G , d = fseq A ⇒ fsb A K S V ⊆ fseq A $ by weaken [l4]
l6: $ G , d = fseq A ⇒ d = fseq A $ by ax
l7: $ G , d = fseq A ⇒ fsb A K S V ⊆ d $ by subset_trans [l5, eq_subset [eq_sym [l6]]]
l8: $ G , d = fseq A ⇒ isset (fsb A K S V) $ by subset_set [l7]
l9: $ G ⇒ isset (fseq A) $ by fseq_set [#1]
l10: $ G ⇒ isset (fsb A K S V) $ by isset_elim [l9, l8]

lemma fs_nd (G: hyps) (A: class) (x1 x2 x3: set): $ G ⇒ x1 ∊ ω $ > $ G ⇒ x2 ∊ fseq (trees ω) $ > $ G ⇒ x3 = ccom (fsf A) x2 $ > $ G ⇒ isset A $ > $ G ⇒ fv (fsf A) ⟨ x1 , x2 ⟩ = fsb A x1 x2 x3 $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) $ by cgr3_functional
l3: $ G ⇒ fv (fsf A) ⟨ x1 , x2 ⟩ = fv (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) ⟨ x1 , ⟨ x2 , ccom (fsf A) x2 ⟩ ⟩ $ by trc_node_c [l1, l2, #1, #2]
l4: $ G ⇒ isset (fsb A x1 x2 x3) $ by fs_set [#4]
l5: $ G ⇒ fv (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) ⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ = fsb A x1 x2 x3 $ by fv_cgr3 [l4]
l6: $ G ⇒ x1 = x1 $ by eq_refl
l7: $ G ⇒ x2 = x2 $ by eq_refl
l8: $ G ⇒ ⟨ x1 , ⟨ x2 , ccom (fsf A) x2 ⟩ ⟩ = ⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ $ by opair_eq [l6, opair_eq [l7, eq_sym [#3]]]
l9: $ G ⇒ (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) = (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) $ by eq_refl
l10: $ G ⇒ fv (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) ⟨ x1 , ⟨ x2 , ccom (fsf A) x2 ⟩ ⟩ = fv (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) ⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ $ by fv_eq [l9, l8]
l11: $ G ⇒ fv (fsf A) ⟨ x1 , x2 ⟩ = fsb A x1 x2 x3 $ by eq_trans [l3, eq_trans [l10, l5]]

fsat_bot
--------
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (cgr3 x7 x8 x9 (fsb A x7 x8 x9)) $ by cgr3_functional
l3: $ G ⇒ functional (fsf A) $ by trc_functional_c [l1, l2]
l4: $ G ⇒ cdm (fsf A) = trees ω $ by trc_cdm_c [l1, l2]
l5: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ x1 = ∅ $ by ax
l6: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ x2 = ∅ $ by ax
l7: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ x3 = ccom (fsf A) x2 $ by ax
l8: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ ∅ ∈ ω $ by omega_zero
l9: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ x1 ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l5], l8]]
l10: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l11: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ x2 ∊ fseq (trees ω) $ by wcel_welc [wcel_eq_l [eq_sym [l6], l10]]
l12: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ isset A $ by weaken [#1]
l13: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ fv (fsf A) ⟨ x1 , x2 ⟩ = fsb A x1 x2 x3 $ by fs_nd [l9, l11, l7, l12]
l14: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ (fsf A) = (fsf A) $ by eq_refl
l15: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 ⇒ fv (fsf A) ⟨ ∅ , ∅ ⟩ = fsb A x1 x2 x3 $ by eq_trans [fv_eq [l14, opair_eq [eq_sym [l5], eq_sym [l6]]], l13]
l16: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ ⇒ fv (fsf A) ⟨ ∅ , ∅ ⟩ = fsb A x1 x2 x3 $ by weaken [l15]
l17: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ ⇒ a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ $ by ax
l18: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ ⇒ a ∊ fsb A x1 x2 x3 $ by wcel_welc [wcel_eq_r [l16, l17]]
l19: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ ⇒ a ∊ fseq A ∧ ((x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅))) ∨ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5))) $ by cab_elim [l18]
l20: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ ⇒ (x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅))) ∨ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) $ by and_elim_r [l19]
l21: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅)) ⇒ x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅)) $ by ax
l22: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅)) ⇒ x1 = suc ∅ $ by and_elim_l [l21]
l23: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅)) ⇒ x1 = ∅ $ by weaken [l5]
l24: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅)) ⇒ ∅ = suc ∅ $ by eq_trans [eq_sym [l23], l22]
l25: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅)) ⇒ suc ∅ = ∅ $ by eq_sym [l24]
l26: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , x1 = suc ∅ ∧ (a ∊ fv x3 ∅ → a ∊ fv x3 (suc ∅)) ⇒ ⊥ $ by suc_ne_empty [l25]
l27: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) ⇒ (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) $ by ax
l28: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) , x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅) ⇒ x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅) $ by ax
l29: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) , x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅) ⇒ x1 = suc (suc ∅) $ by and_elim_l [l28]
l30: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) , x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅) ⇒ x1 = ∅ $ by weaken [l5]
l31: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) , x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅) ⇒ ∅ = suc (suc ∅) $ by eq_trans [eq_sym [l30], l29]
l32: $ G , x1 = ∅ , x2 = ∅ , x3 = ccom (fsf A) x2 , a ∈ fv (fsf A) ⟨ ∅ , ∅ ⟩ , (x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅)) ∨ (x1 = suc (suc (suc ∅)) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 = fv a x5)) ∨ (x1 = suc (suc (suc (suc ∅))) ∧ ∃ x4 ∃ x5 (fv x2 ∅ = ⟨ x4 , ∅ ⟩ ∧ fv x2 (suc ∅) = ⟨ x5 , ∅ ⟩ ∧ fv a x4 ∈ fv a x5)) , x1 = suc (suc ∅) ∧ ∀ y (y ∊ A → scons y a ∈ fv x3 ∅) ⇒ suc (suc ∅) = ∅ $ by eq_sym [l31]
