l4: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ d = fmla $ by ax
l5: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ z = ⟨ n , ⊥ₒ ⟩ $ by ax
l6: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ n ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l3], weaken [#1]]]
l7: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
