l120: $ G , x1 = suc ∅ , x2 = scons p (scons q ∅) ⇒ (a ∈ fv (fsf A) ⟨ suc ∅ , scons p (scons q ∅) ⟩) ↔ (a ∈ fv (fsf A) p → a ∈ fv (fsf A) q) $ by isset_elim [l119, l116]
