l541: $ G , ∀ n (n ∊ U → (⟪ U , scons n S ⊨ (∅ ∈ₒ (suc I)) →ₒ (∃ₒ ((c_succ ∅ (suc ∅)) ∧ₒ (∅ ∈ₒ (suc (suc I))))) ⟫)) , n ∊ U ⇒ (⟪ U , scons n S ⊨ (∅ ∈ₒ (suc I)) →ₒ (∃ₒ ((c_succ ∅ (suc ∅)) ∧ₒ (∅ ∈ₒ (suc (suc I))))) ⟫) ↔ ((n ∈ x1) → (∃ y (y ∊ U ∧ ((r_succ U y n) ∧ (y ∈ x1))))) $ by imp_elim [all_elim [l540], l537]
