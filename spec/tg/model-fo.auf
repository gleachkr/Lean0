l1: $ _ ⇒ (ra_closed (enc_nat nz) (enc_expr E) ∈ lrel) ∧ (ra_closed (enc_nat nz) (enc_expr M) ∈ lrel) ∧ (∀ u (uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u (mcv hfin) (enc_ctx nil) w → dt u (mcv hfin) (enc_expr E) w r = dt u (mcv hfin) (enc_expr E) w r ∧ dt u (mcv hfin) (enc_expr E) w r ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) Prop))) w r)))) ∧ (∀ u (uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u (mcv hfin) (enc_ctx nil) w → dt u (mcv hfin) (enc_expr M) w r = dt u (mcv hfin) (enc_expr M) w r ∧ dt u (mcv hfin) (enc_expr M) w r ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) Prop))) w r)))) ∧ (∀ u (uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u (mcv hfin) (enc_ctx nil) w → ∃ x (x ∊ dt u (mcv hfin) (enc_expr (pset_e1 b E)) w r))))) ∧ (∀ u (uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u (mcv hfin) (enc_ctx nil) w → ∃ x (x ∊ dt u (mcv hfin) (enc_expr (pset_e2 b E)) w r))))) ∧ (∀ u (uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u (mcv hfin) (enc_ctx nil) w → ∃ x (x ∊ dt u (mcv hfin) (enc_expr (pset_e3 b E)) w r))))) ∧ (∀ u (uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u (mcv hfin) (enc_ctx nil) w → ∃ x (x ∊ dt u (mcv hfin) (enc_expr (pset_m1 b E M)) w r))))) ∧ (∀ u (uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u (mcv hfin) (enc_ctx nil) w → ∃ x (x ∊ dt u (mcv hfin) (enc_expr (pset_m2 b E M)) w r))))) $ by weaken [#1]
