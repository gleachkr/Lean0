g24: $ ((n ∈ C) → (∃ y ((y ∊ A) ∧ ((r_succ A y n) ∧ (y ∈ C))))) ⟺ ((n ∈ D) → (∃ y ((y ∊ B) ∧ ((r_succ B y n) ∧ (y ∈ D))))) $ by im_congr [g13, g23]
g25: $ ((n ∊ A) → ((n ∈ C) → (∃ y ((y ∊ A) ∧ ((r_succ A y n) ∧ (y ∈ C)))))) ⟺ ((n ∊ B) → ((n ∈ D) → (∃ y ((y ∊ B) ∧ ((r_succ B y n) ∧ (y ∈ D)))))) $ by im_congr [g11, g24]
g26: $ (∀ n ((n ∊ A) → ((n ∈ C) → (∃ y ((y ∊ A) ∧ ((r_succ A y n) ∧ (y ∈ C))))))) ⟺ (∀ n ((n ∊ B) → ((n ∈ D) → (∃ y ((y ∊ B) ∧ ((r_succ B y n) ∧ (y ∈ D))))))) $ by all_congr [g25]
g27: $ r_ind A C ⟺ r_ind B D $ by and_congr [g9, g26]

