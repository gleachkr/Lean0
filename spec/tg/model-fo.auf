l6215: $ G ⇒ ⟪ U , S ⊨ (∀ₒ ((∅ ∈ₒ (suc I)) →ₒ (∃ₒ ((∅ ∈ₒ (suc (suc J))) ∧ₒ (∃ₒ ((c_opair ∅ (suc (suc ∅)) (suc ∅)) ∧ₒ (∅ ∈ₒ (suc (suc (suc K)))))))))) ∧ₒ (∀ₒ (∀ₒ (∀ₒ (∀ₒ (∀ₒ (∀ₒ ((c_opair (suc ∅) (suc (suc (suc (suc (suc ∅))))) (suc (suc (suc ∅)))) →ₒ ((c_opair ∅ (suc (suc (suc (suc ∅)))) (suc (suc ∅))) →ₒ (((suc ∅) ∈ₒ (suc (suc (suc (suc (suc (suc K))))))) →ₒ ((∅ ∈ₒ (suc (suc (suc (suc (suc (suc K))))))) →ₒ (((suc (suc (suc (suc (suc ∅))))) =ₒ (suc (suc (suc (suc ∅))))) ↔ₒ ((suc (suc (suc ∅))) =ₒ (suc (suc ∅)))))))))))))) ⟫ ↔ ((∀ a (a ∊ U → ((a ∈ x2) → (∃ b (b ∊ U ∧ ((b ∈ x3) ∧ (∃ o (o ∊ U ∧ ((r_opair U o a b) ∧ (o ∈ x1)))))))))) ∧ (∀ a (a ∊ U → (∀ c (c ∊ U → (∀ b (b ∊ U → (∀ d (d ∊ U → (∀ o (o ∊ U → (∀ p (p ∊ U → ((r_opair U o a b) → ((r_opair U p c d) → ((o ∈ x1) → ((p ∈ x1) → ((a = c) ↔ (b = d))))))))))))))))))) $ by bi_trans [l488, l6214]

r_ch_congr
----------
g1: $ seqt w w $ by seqt_refl
g2: $ (w ∊ A) ⟺ (w ∊ B) $ by welc_congr [g1, #1]
g3: $ seqt p p $ by seqt_refl
g4: $ (p ∊ A) ⟺ (p ∊ B) $ by welc_congr [g3, #1]
g5: $ w ≐ w $ by ceqt_refl
g6: $ (r_omega A w) ⟺ (r_omega B w) $ by r_omega_congr [#1, g5]
g7: $ p ≐ p $ by ceqt_refl
g8: $ w ≐ w $ by ceqt_refl
g9: $ (r_pow A p w) ⟺ (r_pow B p w) $ by r_pow_congr [#1, g7, g8]
g10: $ seqt a a $ by seqt_refl
g11: $ (a ∊ A) ⟺ (a ∊ B) $ by welc_congr [g10, #1]
g12: $ a ≐ a $ by ceqt_refl
g13: $ p ≐ p $ by ceqt_refl
g14: $ (r_sub A a p) ⟺ (r_sub B a p) $ by r_sub_congr [#1, g12, g13]
g15: $ seqt f f $ by seqt_refl
g16: $ (f ∊ A) ⟺ (f ∊ B) $ by welc_congr [g15, #1]
g17: $ f ≐ f $ by ceqt_refl
g18: $ a ≐ a $ by ceqt_refl
g19: $ w ≐ w $ by ceqt_refl
g20: $ (r_inj A f a w) ⟺ (r_inj B f a w) $ by r_inj_congr [#1, g17, g18, g19]
g21: $ ((f ∊ A) ∧ (r_inj A f a w)) ⟺ ((f ∊ B) ∧ (r_inj B f a w)) $ by and_congr [g16, g20]
g22: $ (∃ f ((f ∊ A) ∧ (r_inj A f a w))) ⟺ (∃ f ((f ∊ B) ∧ (r_inj B f a w))) $ by ex_congr [g21]
g23: $ seqt f f $ by seqt_refl
