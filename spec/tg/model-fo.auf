l9: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ ∅ ∈ ω $ by omega_zero
l10: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ ⊥ₒ ∈ trees ω $ by trees_intro_c [l8, l9, l7]
l11: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ z ∊ ω × trees ω $ by wcel_welc [wcel_eq_l [eq_sym [l5], cxp_intro_c [welc_wcel [l6], l10]]]
l12: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ z = ⟨ n , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ n , p →ₒ q ⟩ ∧ ⟨ n , p ⟩ ∈ d ∧ ⟨ n , q ⟩ ∈ d) ∨ ∃ p (z = ⟨ n , ∀ₒ p ⟩ ∧ ⟨ suc n , p ⟩ ∈ d) ∨ ∃ x4 ∃ x5 (x4 ∊ n ∧ x5 ∊ n ∧ (z = ⟨ n , x4 =ₒ x5 ⟩ ∨ z = ⟨ n , x4 ∈ₒ x5 ⟩)) $ by or_intro_l [l5]
l13: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ n ∊ ω ∧ (z = ⟨ n , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ n , p →ₒ q ⟩ ∧ ⟨ n , p ⟩ ∈ d ∧ ⟨ n , q ⟩ ∈ d) ∨ ∃ p (z = ⟨ n , ∀ₒ p ⟩ ∧ ⟨ suc n , p ⟩ ∈ d) ∨ ∃ x4 ∃ x5 (x4 ∊ n ∧ x5 ∊ n ∧ (z = ⟨ n , x4 =ₒ x5 ⟩ ∨ z = ⟨ n , x4 ∈ₒ x5 ⟩))) $ by and_intro [l6, l12]
l14: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ ∃ m (m ∊ ω ∧ (z = ⟨ m , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ m , p →ₒ q ⟩ ∧ ⟨ m , p ⟩ ∈ d ∧ ⟨ m , q ⟩ ∈ d) ∨ ∃ p (z = ⟨ m , ∀ₒ p ⟩ ∧ ⟨ suc m , p ⟩ ∈ d) ∨ ∃ x4 ∃ x5 (x4 ∊ m ∧ x5 ∊ m ∧ (z = ⟨ m , x4 =ₒ x5 ⟩ ∨ z = ⟨ m , x4 ∈ₒ x5 ⟩)))) $ by ex_intro [l13]
l15: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ z ∊ ω × trees ω ∧ ∃ m (m ∊ ω ∧ (z = ⟨ m , ⊥ₒ ⟩ ∨ ∃ p ∃ q (z = ⟨ m , p →ₒ q ⟩ ∧ ⟨ m , p ⟩ ∈ d ∧ ⟨ m , q ⟩ ∈ d) ∨ ∃ p (z = ⟨ m , ∀ₒ p ⟩ ∧ ⟨ suc m , p ⟩ ∈ d) ∨ ∃ x4 ∃ x5 (x4 ∊ m ∧ x5 ∊ m ∧ (z = ⟨ m , x4 =ₒ x5 ⟩ ∨ z = ⟨ m , x4 ∈ₒ x5 ⟩)))) $ by and_intro [l11, l14]
l16: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ z ∊ fmop d $ by cab_intro [l15]
l17: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ z ∊ fmla $ by fm_cl [l16, l4]
l18: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ ⊥ₒ = ⊥ₒ $ by eq_refl
l19: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ ⟨ N , ⊥ₒ ⟩ ∈ fmla $ by wcel_eq_l [eq_trans [l5, opair_eq [l3, l18]], welc_wcel [l17]]
l20: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ isset ⊥ₒ $ by opair_isset
l21: $ G , n = N , d = fmla , z = ⟨ n , ⊥ₒ ⟩ ⇒ ⊥ₒ ∈ fm N $ by fm_i [l20, l19]
l22: $ G , n = N , d = fmla ⇒ isset ⟨ n , ⊥ₒ ⟩ $ by opair_isset
l23: $ G , n = N , d = fmla ⇒ ⊥ₒ ∈ fm N $ by isset_elim [l22, l21]
l24: $ G , n = N ⇒ isset fmla $ by weaken [l2]
l25: $ G , n = N ⇒ ⊥ₒ ∈ fm N $ by isset_elim [l24, l23]
l26: $ G ⇒ isset N $ by wcel_isset [weaken [#1]]
l27: $ G ⇒ ⊥ₒ ∈ fm N $ by isset_elim [l26, l25]

