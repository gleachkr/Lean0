l543: $ G , ∀ n (n ∊ U → (⟪ U , scons n S ⊨ (∅ ∈ₒ (suc I)) →ₒ (∃ₒ ((c_succ ∅ (suc ∅)) ∧ₒ (∅ ∈ₒ (suc (suc I))))) ⟫)) ⇒ n ∊ U → ((n ∈ x1) → (∃ y (y ∊ U ∧ ((r_succ U y n) ∧ (y ∈ x1))))) $ by imp_intro [l542]
l544: $ G , ∀ n (n ∊ U → (⟪ U , scons n S ⊨ (∅ ∈ₒ (suc I)) →ₒ (∃ₒ ((c_succ ∅ (suc ∅)) ∧ₒ (∅ ∈ₒ (suc (suc I))))) ⟫)) ⇒ ∀ n (n ∊ U → ((n ∈ x1) → (∃ y (y ∊ U ∧ ((r_succ U y n) ∧ (y ∈ x1)))))) $ by all_intro [l543]
l545: $ G , ∀ n (n ∊ U → ((n ∈ x1) → (∃ y (y ∊ U ∧ ((r_succ U y n) ∧ (y ∈ x1)))))) , n ∊ U ⇒ n ∊ U $ by ax
