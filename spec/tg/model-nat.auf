k1: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ a ∊ nnat $ by ax
k2a: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ = ap m a $ by e4_imrel_key [g6]
