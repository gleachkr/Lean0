l3: $ G ⇒ etel u (dnf u M) tn_K1 w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = nk1p u (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by nat_etel_K1 [l3a, l2]
l4: $ G ⇒ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = nk1p u (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by eq_trans [l1, l3]

lemma e4_k1_elim {b: set} (G: hyps) (M K P: class) (u w f g t a: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ K = tn_K1 $ >
  $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ >
  $ G ⇒ ∃ b (b ∊ nnat ∧ f = scons b ∅ ∧ g = scons b ∅ ∧ t = scons (csn ept0) ∅ ∧ a = ∅) $
----
l1: $ G ⇒ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = nk1p u (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by e4_k1_etel [#1, #2, #3, #4]
l2: $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ nk1p u (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by wcel_eq_r [l1, #5]
