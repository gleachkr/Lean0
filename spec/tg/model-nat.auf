a5: $ G ⇒ fv (scons a S) ∅ = a $ by scons_fv_zero_c [a4, #1]
a6: $ G ⇒ fv (scons a S) (fv nvf ⟨ kc_nz , ∅ ⟩) = a $ by eq_trans [a3, a5]

lemma e5_lk1 (G: hyps) (S: class) (a b: set): $ G ⇒ isset S $ > $ G ⇒ fv (scons a (scons b S)) (fv nvf (enc_nat n1)) = b $
----
a1: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
a2: $ G ⇒ fv nvf (enc_nat n1) = suc (fv nvf (enc_nat nz)) $ by nvf_s [a1]
a3: $ G ⇒ (scons a (scons b S)) = (scons a (scons b S)) $ by eq_refl
a4: $ G ⇒ fv (scons a (scons b S)) (fv nvf (enc_nat n1)) = fv (scons a (scons b S)) (suc (fv nvf (enc_nat nz))) $ by fv_eq [a3, a2]
a5: $ G ⇒ isset a $ by isset_var
a6: $ G ⇒ isset (scons b S) $ by scons_set [#1]
a7a: $ G ⇒ isset (enc_nat nz) $ by wcel_isset [a1]
a7b: $ G ⇒ fv nvf (enc_nat nz) ∈ ω $ by nvf_omega [a7a]
a7: $ G ⇒ isset (fv nvf (enc_nat nz)) $ by wcel_isset [a7b]
a8: $ G ⇒ fv (scons a (scons b S)) (suc (fv nvf (enc_nat nz))) = fv (scons b S) (fv nvf (enc_nat nz)) $ by scons_fv_suc_c [a5, a6, a7]
a9: $ G ⇒ fv (scons b S) (fv nvf (enc_nat nz)) = b $ by e5_lk0 [#1]
a10: $ G ⇒ fv (scons a (scons b S)) (fv nvf (enc_nat n1)) = fv (scons b S) (fv nvf (enc_nat nz)) $ by eq_trans [a4, a8]
a11: $ G ⇒ fv (scons a (scons b S)) (fv nvf (enc_nat n1)) = b $ by eq_trans [a10, a9]

lemma e5_lk2 (G: hyps) (S: class) (a b c: set): $ G ⇒ isset S $ > $ G ⇒ fv (scons a (scons b (scons c S))) (fv nvf (enc_nat n2)) = c $
----
a1: $ G ⇒ enc_nat n1 ∈ trees ω $ by enc_nat_trees
a2: $ G ⇒ fv nvf (enc_nat n2) = suc (fv nvf (enc_nat n1)) $ by nvf_s [a1]
a3: $ G ⇒ (scons a (scons b (scons c S))) = (scons a (scons b (scons c S))) $ by eq_refl
a4: $ G ⇒ fv (scons a (scons b (scons c S))) (fv nvf (enc_nat n2)) = fv (scons a (scons b (scons c S))) (suc (fv nvf (enc_nat n1))) $ by fv_eq [a3, a2]
a5: $ G ⇒ isset a $ by isset_var
a6p: $ G ⇒ isset (scons c S) $ by scons_set [#1]
a6: $ G ⇒ isset (scons b (scons c S)) $ by scons_set [a6p]
a7a: $ G ⇒ isset (enc_nat n1) $ by wcel_isset [a1]
a7b: $ G ⇒ fv nvf (enc_nat n1) ∈ ω $ by nvf_omega [a7a]
a7: $ G ⇒ isset (fv nvf (enc_nat n1)) $ by wcel_isset [a7b]
a8: $ G ⇒ fv (scons a (scons b (scons c S))) (suc (fv nvf (enc_nat n1))) = fv (scons b (scons c S)) (fv nvf (enc_nat n1)) $ by scons_fv_suc_c [a5, a6, a7]
a9: $ G ⇒ fv (scons b (scons c S)) (fv nvf (enc_nat n1)) = c $ by e5_lk1 [#1]
a10: $ G ⇒ fv (scons a (scons b (scons c S))) (fv nvf (enc_nat n2)) = fv (scons b (scons c S)) (fv nvf (enc_nat n1)) $ by eq_trans [a4, a8]
a11: $ G ⇒ fv (scons a (scons b (scons c S))) (fv nvf (enc_nat n2)) = c $ by eq_trans [a10, a9]

lemma e5_lk3 (G: hyps) (S: class) (a b c d: set): $ G ⇒ isset S $ > $ G ⇒ fv (scons a (scons b (scons c (scons d S)))) (fv nvf (enc_nat n3)) = d $
----
a1: $ G ⇒ enc_nat n2 ∈ trees ω $ by enc_nat_trees
a2: $ G ⇒ fv nvf (enc_nat n3) = suc (fv nvf (enc_nat n2)) $ by nvf_s [a1]
a3: $ G ⇒ (scons a (scons b (scons c (scons d S)))) = (scons a (scons b (scons c (scons d S)))) $ by eq_refl
a4: $ G ⇒ fv (scons a (scons b (scons c (scons d S)))) (fv nvf (enc_nat n3)) = fv (scons a (scons b (scons c (scons d S)))) (suc (fv nvf (enc_nat n2))) $ by fv_eq [a3, a2]
a5: $ G ⇒ isset a $ by isset_var
a6q: $ G ⇒ isset (scons d S) $ by scons_set [#1]
a6p: $ G ⇒ isset (scons c (scons d S)) $ by scons_set [a6q]
a6: $ G ⇒ isset (scons b (scons c (scons d S))) $ by scons_set [a6p]
a7a: $ G ⇒ isset (enc_nat n2) $ by wcel_isset [a1]
a7b: $ G ⇒ fv nvf (enc_nat n2) ∈ ω $ by nvf_omega [a7a]
a7: $ G ⇒ isset (fv nvf (enc_nat n2)) $ by wcel_isset [a7b]
a8: $ G ⇒ fv (scons a (scons b (scons c (scons d S)))) (suc (fv nvf (enc_nat n2))) = fv (scons b (scons c (scons d S))) (fv nvf (enc_nat n2)) $ by scons_fv_suc_c [a5, a6, a7]
a9: $ G ⇒ fv (scons b (scons c (scons d S))) (fv nvf (enc_nat n2)) = d $ by e5_lk2 [#1]
a10: $ G ⇒ fv (scons a (scons b (scons c (scons d S)))) (fv nvf (enc_nat n3)) = fv (scons b (scons c (scons d S))) (fv nvf (enc_nat n2)) $ by eq_trans [a4, a8]
a11: $ G ⇒ fv (scons a (scons b (scons c (scons d S)))) (fv nvf (enc_nat n3)) = d $ by eq_trans [a10, a9]

lemma e5_rt_B3 {y: set} (G: hyps) (H W R: class) (u m z k: set): $ G ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ scons k (scons z (scons m R)) ∈ fseq u $ > $ G ⇒ isset R $ > $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (app (bvar n3) (bvar nz)))) W (scons k (scons z (scons m R))) = cpi y nnat (ap m y) $
----
t1: $ G ⇒ enc_expr nat_ty ∈ trees ω $ by enc_expr_trees
t2: $ G ⇒ enc_expr (app (bvar n3) (bvar nz)) ∈ trees ω $ by enc_expr_trees
p1: $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (app (bvar n3) (bvar nz)))) W (scons k (scons z (scons m R))) = cpi y (dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R)))) (dt u (mcv H) (enc_expr (app (bvar n3) (bvar nz))) W (scons y (scons k (scons z (scons m R))))) $ by dt_pi_c [t1, t2, #3, #4]
p2: $ G ⇒ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) = nnat $ by dt_nat_ty [#1, #2, #3, #4]
w1: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ hind H $ by weaken [#1]
w2: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ uadm u $ by weaken [#2]
w3: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ W ∈ lvals $ by weaken [#3]
w4: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ scons k (scons z (scons m R)) ∈ fseq u $ by weaken [#4]
w5: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ isset R $ by weaken [#5]
q1: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) $ by ax
q2: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ scons y (scons k (scons z (scons m R))) ∈ fseq u $ by dt_scons_fseq [w2, w3, w4, q1]
q3: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ enc_expr (bvar n3) ∈ trees ω $ by enc_expr_trees
q4: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ enc_expr (bvar nz) ∈ trees ω $ by enc_expr_trees
q5: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ dt u (mcv H) (enc_expr (app (bvar n3) (bvar nz))) W (scons y (scons k (scons z (scons m R)))) = ap (dt u (mcv H) (enc_expr (bvar n3)) W (scons y (scons k (scons z (scons m R))))) (dt u (mcv H) (enc_expr (bvar nz)) W (scons y (scons k (scons z (scons m R))))) $ by dt_app_c [q3, q4, w3, q2]
q6: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ enc_nat n3 ∈ trees ω $ by enc_nat_trees
q7: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ dt u (mcv H) (enc_expr (bvar n3)) W (scons y (scons k (scons z (scons m R)))) = fv (scons y (scons k (scons z (scons m R)))) (fv nvf (enc_nat n3)) $ by dt_bvar_c [q6, w3, q2]
q8: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ fv (scons y (scons k (scons z (scons m R)))) (fv nvf (enc_nat n3)) = m $ by e5_lk3 [w5]
q9: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
q10: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ dt u (mcv H) (enc_expr (bvar nz)) W (scons y (scons k (scons z (scons m R)))) = fv (scons y (scons k (scons z (scons m R)))) (fv nvf (enc_nat nz)) $ by dt_bvar_c [q9, w3, q2]
q11a: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ isset (scons k (scons z (scons m R))) $ by wcel_isset [w4]
q11: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ fv (scons y (scons k (scons z (scons m R)))) (fv nvf (enc_nat nz)) = y $ by e5_lk0 [q11a]
q12: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ dt u (mcv H) (enc_expr (bvar n3)) W (scons y (scons k (scons z (scons m R)))) = m $ by eq_trans [q7, q8]
q13: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ dt u (mcv H) (enc_expr (bvar nz)) W (scons y (scons k (scons z (scons m R)))) = y $ by eq_trans [q10, q11]
q14: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ ap (dt u (mcv H) (enc_expr (bvar n3)) W (scons y (scons k (scons z (scons m R))))) (dt u (mcv H) (enc_expr (bvar nz)) W (scons y (scons k (scons z (scons m R))))) = ap m y $ by ap_eq [q12, q13]
q15: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) ⇒ dt u (mcv H) (enc_expr (app (bvar n3) (bvar nz))) W (scons y (scons k (scons z (scons m R)))) = ap m y $ by eq_trans [q5, q14]
r1: $ G ⇒ y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) → dt u (mcv H) (enc_expr (app (bvar n3) (bvar nz))) W (scons y (scons k (scons z (scons m R)))) = ap m y $ by imp_intro [q15]
r2: $ G ⇒ ∀ y (y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R))) → dt u (mcv H) (enc_expr (app (bvar n3) (bvar nz))) W (scons y (scons k (scons z (scons m R)))) = ap m y) $ by all_intro [r1]
r3: $ G ⇒ cpi y (dt u (mcv H) (enc_expr nat_ty) W (scons k (scons z (scons m R)))) (dt u (mcv H) (enc_expr (app (bvar n3) (bvar nz))) W (scons y (scons k (scons z (scons m R))))) = cpi y nnat (ap m y) $ by cpi_eq_pt [p2, r2]
r4: $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (app (bvar n3) (bvar nz)))) W (scons k (scons z (scons m R))) = cpi y nnat (ap m y) $ by eq_trans [p1, r3]

lemma e5_rt_A3 {y h: set} (G: hyps) (H W R: class) (u m z: set): $ G ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ scons z (scons m R) ∈ fseq u $ > $ G ⇒ isset R $ > $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))))) W (scons z (scons m R)) = cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $
----
t1: $ G ⇒ enc_expr nat_ty ∈ trees ω $ by enc_expr_trees
t2: $ G ⇒ enc_expr (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))) ∈ trees ω $ by enc_expr_trees
p1: $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))))) W (scons z (scons m R)) = cpi y (dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R))) (dt u (mcv H) (enc_expr (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) W (scons y (scons z (scons m R)))) $ by dt_pi_c [t1, t2, #3, #4]
p2: $ G ⇒ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) = nnat $ by dt_nat_ty [#1, #2, #3, #4]
w1: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ hind H $ by weaken [#1]
w2: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ uadm u $ by weaken [#2]
w3: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ W ∈ lvals $ by weaken [#3]
w4: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ scons z (scons m R) ∈ fseq u $ by weaken [#4]
w5: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ isset R $ by weaken [#5]
q1: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) $ by ax
q2: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ scons y (scons z (scons m R)) ∈ fseq u $ by dt_scons_fseq [w2, w3, w4, q1]
q2a: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) = nnat $ by weaken [p2]
q2b: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ y ∊ nnat $ by welc_eq [q2a, q1]
s0a: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ enc_expr (app (bvar n2) (bvar nz)) ∈ trees ω $ by enc_expr_trees
s0b: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ enc_expr (app (bvar n3) (app nat_succ (bvar n1))) ∈ trees ω $ by enc_expr_trees
s1: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) W (scons y (scons z (scons m R))) = cpi h (dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R)))) (dt u (mcv H) (enc_expr (app (bvar n3) (app nat_succ (bvar n1)))) W (scons h (scons y (scons z (scons m R))))) $ by dt_pi_c [s0a, s0b, w3, q2]
s2a: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ enc_expr (bvar n2) ∈ trees ω $ by enc_expr_trees
s2b: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ enc_expr (bvar nz) ∈ trees ω $ by enc_expr_trees
s2: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R))) = ap (dt u (mcv H) (enc_expr (bvar n2)) W (scons y (scons z (scons m R)))) (dt u (mcv H) (enc_expr (bvar nz)) W (scons y (scons z (scons m R)))) $ by dt_app_c [s2a, s2b, w3, q2]
s3a: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ enc_nat n2 ∈ trees ω $ by enc_nat_trees
s3: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr (bvar n2)) W (scons y (scons z (scons m R))) = fv (scons y (scons z (scons m R))) (fv nvf (enc_nat n2)) $ by dt_bvar_c [s3a, w3, q2]
s4: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ fv (scons y (scons z (scons m R))) (fv nvf (enc_nat n2)) = m $ by e5_lk2 [w5]
s5a: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
s5: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr (bvar nz)) W (scons y (scons z (scons m R))) = fv (scons y (scons z (scons m R))) (fv nvf (enc_nat nz)) $ by dt_bvar_c [s5a, w3, q2]
s6a: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ isset (scons z (scons m R)) $ by wcel_isset [w4]
s6: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ fv (scons y (scons z (scons m R))) (fv nvf (enc_nat nz)) = y $ by e5_lk0 [s6a]
s7: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr (bvar n2)) W (scons y (scons z (scons m R))) = m $ by eq_trans [s3, s4]
s8: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr (bvar nz)) W (scons y (scons z (scons m R))) = y $ by eq_trans [s5, s6]
s9: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ ap (dt u (mcv H) (enc_expr (bvar n2)) W (scons y (scons z (scons m R)))) (dt u (mcv H) (enc_expr (bvar nz)) W (scons y (scons z (scons m R)))) = ap m y $ by ap_eq [s7, s8]
s10: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R))) = ap m y $ by eq_trans [s2, s9]
u1: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) , h ∊ dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R))) ⇒ h ∊ dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R))) $ by ax
u0a: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) , h ∊ dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R))) ⇒ uadm u $ by weaken [#2]
u0b: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) , h ∊ dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R))) ⇒ W ∈ lvals $ by weaken [#3]
u0c: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) , h ∊ dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R))) ⇒ scons y (scons z (scons m R)) ∈ fseq u $ by weaken [q2]
u0d: $ G , y ∊ dt u (mcv H) (enc_expr nat_ty) W (scons z (scons m R)) , h ∊ dt u (mcv H) (enc_expr (app (bvar n2) (bvar nz))) W (scons y (scons z (scons m R))) ⇒ hind H $ by weaken [#1]
