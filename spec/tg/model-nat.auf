r2b: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ ⟨ ∅ , y0 ⟩ = ⟨ ∅ , nzr ⟩ $ by opair_eq [r2a, h4]
r2c: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , nzr ⟩ ⟩ $ by opair_eq [r2a, r2b]
r2d: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ o = z $ by ax
r2e: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ = ⟨ ⟨ ∅ , ⟨ ∅ , nzr ⟩ ⟩ , z ⟩ $ by opair_eq [r2c, r2d]
r2: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ q = ⟨ ⟨ ∅ , ⟨ ∅ , nzr ⟩ ⟩ , z ⟩ $ by eq_trans [r1, r2e]
r3a: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ scons ms (scons z ∅) = scons ms (scons z ∅) $ by eq_refl
r3: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ q ∊ ifold0 u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) $ by e4_f0_intro0 [h1, h2, r2a, r3a, h3, r2]
r4: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) $ by ifold_intro [r3]
r5: $ G , o = z , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) $ by wcel_intro [r1, r4]
r6: $ G , o = z ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) $ by isset_elim [r0, r5]
r7: $ G ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = z $ by bi_intro [e2, r6]
r8: $ G ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = z) $ by all_intro [r7]

--| The fold at `nsc x1`: `ms`'s value at `x1` and the fold's value there.
lemma e4_fs {x h o: set} (G: hyps o) (M: class) (u w m z ms x1 y1 v0 b0: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ms ∊ cpi x nnat (cpi h (ap m x) (ap m (nsc x))) $ > $ G ⇒ m ∊ u $ > $ G ⇒ x1 ∊ nnat $ > $ G ⇒ y1 = nsc x1 $ >
  $ G ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v0) $ > $ G ⇒ v0 ∊ ap m x1 $ > $ G ⇒ b0 = ap (ap ms x1) v0 $ >
  $ G ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = b0) $
----
s1: $ G ⇒ isset (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) $ by ifold_set
s2: $ G ⇒ isset (ap (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) e) $ by ap_set [s1]
s3: $ G ⇒ ∀ e (isset (ap (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) e)) $ by all_intro [s2]
t1: $ G ⇒ ap (ap ms x1) v0 ∈ ap m (nsc x1) $ by e4_ms_ap [#3, #5, #8]
t2: $ G ⇒ universe u $ by uadm_universe [#1]
t3a: $ G ⇒ m ∈ u $ by welc_wcel [#4]
t3c: $ G ⇒ isset (nsc x1) $ by nsc_set
t3: $ G ⇒ ap m (nsc x1) ∈ u $ by universe_ap_c [t2, t3a, t3c]
t4: $ G ⇒ ap (ap ms x1) v0 ∈ u $ by universe_elem_elem_c [t2, t3, t1]
