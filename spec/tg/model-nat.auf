lemma e4_ms_ap {x h: set} (G: hyps) (m ms n v: set):
  $ G ⇒ ms ∊ cpi x nnat (cpi h (ap m x) (ap m (nsc x))) $ > $ G ⇒ n ∊ nnat $ > $ G ⇒ v ∊ ap m n $ >
  $ G ⇒ ap (ap ms n) v ∈ ap m (nsc n) $
----
l1: $ G ⇒ ap ms n ∈ cpi h (ap m n) (ap m (nsc n)) $ by cpi_elim_ap [#1, #2]
l2: $ G , i = ap ms n , i ∊ cpi h (ap m n) (ap m (nsc n)) ⇒ i ∊ cpi h (ap m n) (ap m (nsc n)) $ by ax
l3a: $ G , i = ap ms n , i ∊ cpi h (ap m n) (ap m (nsc n)) ⇒ v ∊ ap m n $ by weaken [#3]
l3: $ G , i = ap ms n , i ∊ cpi h (ap m n) (ap m (nsc n)) ⇒ ap i v ∈ ap m (nsc n) $ by cpi_elim_ap [l2, l3a]
l4a: $ G , i = ap ms n , i ∊ cpi h (ap m n) (ap m (nsc n)) ⇒ i = ap ms n $ by ax
l4r: $ G , i = ap ms n , i ∊ cpi h (ap m n) (ap m (nsc n)) ⇒ v = v $ by eq_refl
l4: $ G , i = ap ms n , i ∊ cpi h (ap m n) (ap m (nsc n)) ⇒ ap i v = ap (ap ms n) v $ by ap_eq [l4a, l4r]
l5: $ G , i = ap ms n , i ∊ cpi h (ap m n) (ap m (nsc n)) ⇒ ap (ap ms n) v ∈ ap m (nsc n) $ by wcel_eq_l [l4, l3]
l6: $ G ⇒ ap (ap ms n) v ∈ ap m (nsc n) $ by wcel_elim [l1, l5]

--| The fold at `nzr`: exactly `z`.
lemma e4_fz {o: set} (G: hyps) (M: class) (u w ms z y0: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ z ∊ u $ > $ G ⇒ y0 = nzr $ >
  $ G ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = z) $
----
s1: $ G ⇒ isset (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) $ by ifold_set
s2: $ G ⇒ isset (ap (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) e) $ by ap_set [s1]
s3: $ G ⇒ ∀ e (isset (ap (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) e)) $ by all_intro [s2]
g1: $ G , ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ , q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ⇒ uadm u $ by weaken [#1]
g2: $ G , ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ , q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ⇒ w ∊ lvals $ by weaken [#2]
g3: $ G , ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ , q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ⇒ z ∊ u $ by weaken [#3]
g4: $ G , ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ , q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ⇒ y0 = nzr $ by weaken [#4]
g5: $ G , ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ , q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ⇒ ∀ e (isset (ap (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) e)) $ by weaken [s3]
a1: $ G , ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ , q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ⇒ q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) $ by ax
a2: $ G , ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) , q = ⟨ ⟨ ∅ , ⟨ ∅ , y0 ⟩ ⟩ , o ⟩ , q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ⇒ q ∊ ifold0 u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) $ by ifold_elim [a1]
