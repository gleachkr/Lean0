l7b: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
l7c: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l7: $ G ⇒ dt u M tn_F w ∅ = fv uni (lv ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ w) $ by dt_srt_c [l7a, l7b, l7c]
l8a: $ G ⇒ ⟨ kc_lz , ∅ ⟩ ∈ trees ω $ by enc_lvl_trees (e := $ lz $)
l8: $ G ⇒ lv ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ w = suc (lv ⟨ kc_lz , ∅ ⟩ w) $ by lv_ls [l8a, #2]
l9: $ G ⇒ lv ⟨ kc_lz , ∅ ⟩ w = ∅ $ by lv_lz
l10: $ G ⇒ suc (lv ⟨ kc_lz , ∅ ⟩ w) = suc ∅ $ by suc_eq [l9]
l11: $ G ⇒ lv ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ w = suc ∅ $ by eq_trans [l8, l10]
l12a: $ G ⇒ uni = uni $ by eq_refl
l12: $ G ⇒ fv uni (lv ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ w) = fv uni (suc ∅) $ by fv_eq [l12a, l11]
l13: $ G ⇒ dt u M tn_F w ∅ = fv uni (suc ∅) $ by eq_trans [l7, l12]
l14: $ G ⇒ da (fv (dnf u M) tn_F) w ∅ = dt u M tn_F w ∅ $ by eq_sym [l6]
l15: $ G ⇒ ipi u (dnf u M) tn_P tn_F w = dt u M tn_F w ∅ $ by eq_trans [l5, l14]
l16: $ G ⇒ ipi u (dnf u M) tn_P tn_F w = fv uni (suc ∅) $ by eq_trans [l15, l13]
l17: $ G ⇒ fv uni (suc ∅) = ipi u (dnf u M) tn_P tn_F w $ by eq_sym [l16]
l18: $ G ⇒ nnat ∈ fv uni (suc ∅) $ by nnat_uni
l19: $ G ⇒ nnat ∈ ipi u (dnf u M) tn_P tn_F w $ by wcel_eq_r [l17, l18]
l20: $ G ⇒ nnat = ity u (dnf u M) tr_nat_D ∅ w $ by eq_sym [l4]
l21: $ G ⇒ ity u (dnf u M) tr_nat_D ∅ w ∈ ipi u (dnf u M) tn_P tn_F w $ by wcel_eq_l [l20, l19]
l22: $ G ⇒ igate u (dnf u M) tr_nat_D ∅ w $ by igate_intro [l1, l2, l3, l21]

nat_ityv
--------
l1: $ G ⇒ igate u (dnf u M) tr_nat_D ∅ w $ by nat_igate [#1, #2]
l2: $ G ⇒ ityv u (dnf u M) tr_nat_D ∅ w = ity u (dnf u M) tr_nat_D ∅ w $ by ityv_gate [l1]
l3: $ G ⇒ ity u (dnf u M) tr_nat_D ∅ w = nnat $ by nat_ity [#1, #2]
l4: $ G ⇒ ityv u (dnf u M) tr_nat_D ∅ w = nnat $ by eq_trans [l2, l3]

