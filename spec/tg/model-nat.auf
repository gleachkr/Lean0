j5: $ G , x7 ∊ nnat , r = ap ms x7 , x8 ∊ ap m x7 , x6 = scat (scons x8 ∅) (scons x7 ∅) ⇒ apn ms x6 = ap r x8 $ by eq_trans [j5e, j5h]
j6: $ G , x7 ∊ nnat , r = ap ms x7 , x8 ∊ ap m x7 , x6 = scat (scons x8 ∅) (scons x7 ∅) ⇒ ap r x8 ∈ ap m (nsc x7) $ by wcel_eq_l [j5, j4]
j7: $ G , x7 ∊ nnat , r = ap ms x7 , x8 ∊ ap m x7 ⇒ ap r x8 ∈ ap m (nsc x7) $ by isset_elim [h4, j6]
j8: $ G , x7 ∊ nnat , r = ap ms x7 ⇒ x8 ∊ ap m x7 → ap r x8 ∈ ap m (nsc x7) $ by imp_intro [j7]
j9: $ G , x7 ∊ nnat , r = ap ms x7 ⇒ ∀ x8 (x8 ∊ ap m x7 → ap r x8 ∈ ap m (nsc x7)) $ by all_intro [j8]
j10a: $ ∀ x8 (x8 ∊ ap m x7 → ap r x8 ∈ ap m (nsc x7)) ⟺ ∀ h (h ∊ ap m x7 → ap r h ∈ ap m (nsc x7)) $ by all_alpha
j10b: $ G , x7 ∊ nnat , r = ap ms x7 ⇒ ∀ x8 (x8 ∊ ap m x7 → ap r x8 ∈ ap m (nsc x7)) ↔ ∀ h (h ∊ ap m x7 → ap r h ∈ ap m (nsc x7)) $ by weaken [j10a]
j10: $ G , x7 ∊ nnat , r = ap ms x7 ⇒ ∀ h (h ∊ ap m x7 → ap r h ∈ ap m (nsc x7)) $ by bi_elim_l [j10b, j9]
j11: $ G , x7 ∊ nnat , r = ap ms x7 ⇒ r ∊ cpi h (ap m x7) (ap m (nsc x7)) $ by cpi_intro_pts [f3, j10]
j12a: $ G , x7 ∊ nnat , r = ap ms x7 ⇒ r = ap ms x7 $ by ax
j12: $ G , x7 ∊ nnat , r = ap ms x7 ⇒ ap ms x7 ∈ cpi h (ap m x7) (ap m (nsc x7)) $ by wcel_intro [j12a, j11]
j13: $ G , x7 ∊ nnat ⇒ ap ms x7 ∈ cpi h (ap m x7) (ap m (nsc x7)) $ by isset_elim [a0, j12]
j14: $ G ⇒ x7 ∊ nnat → ap ms x7 ∈ cpi h (ap m x7) (ap m (nsc x7)) $ by imp_intro [j13]
j15: $ G ⇒ ∀ x7 (x7 ∊ nnat → ap ms x7 ∈ cpi h (ap m x7) (ap m (nsc x7))) $ by all_intro [j14]
j16a: $ ∀ x7 (x7 ∊ nnat → ap ms x7 ∈ cpi h (ap m x7) (ap m (nsc x7))) ⟺ ∀ y (y ∊ nnat → ap ms y ∈ cpi h (ap m y) (ap m (nsc y))) $ by all_alpha
j16b: $ G ⇒ ∀ x7 (x7 ∊ nnat → ap ms x7 ∈ cpi h (ap m x7) (ap m (nsc x7))) ↔ ∀ y (y ∊ nnat → ap ms y ∈ cpi h (ap m y) (ap m (nsc y))) $ by weaken [j16a]
j16: $ G ⇒ ∀ y (y ∊ nnat → ap ms y ∈ cpi h (ap m y) (ap m (nsc y))) $ by bi_elim_l [j16b, j15]
j17: $ G ⇒ ms ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by cpi_intro_pts [o2, j16]

lemma e4_vat2_0 (G: hyps) (MV A B K: class):
  $ G ⇒ MV = scons A (scons B ∅) $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ K = ∅ $ > $ G ⇒ vat MV (inmin tr_nat_D) K = B $
----
a0: $ G ⇒ isset ∅ $ by ax_empty
a1: $ G ⇒ isset (suc ∅) $ by suc_set [a0]
a2: $ G ⇒ inmin tr_nat_D = suc (suc ∅) $ by nat_inmin
a3: $ G ⇒ suc (suc ∅) = inmin tr_nat_D $ by eq_sym [a2]
a4a: $ G ⇒ ∅ ∈ ω $ by omega_zero
a4b: $ G ⇒ suc ∅ ∈ ω $ by omega_suc_c [a4a]
a4c: $ G ⇒ suc (suc ∅) ∈ ω $ by omega_suc_c [a4b]
a4: $ G ⇒ inmin tr_nat_D ∈ ω $ by wcel_eq_l [a3, a4c]
a5i: $ G ⇒ isset (∅) $ by ax_empty
a5j: $ G ⇒ ∅ = K $ by eq_sym [#4]
a5k: $ G ⇒ isset K $ by isset_eq [a5j, a5i]
a5l: $ G ⇒ isset (suc K) $ by suc_set [a5k]
a6: $ G ⇒ suc K = suc (∅) $ by suc_eq [#4]
b1a: $ G ⇒ ∅ ∈ suc ∅ $ by suc_mem [a0]
b1b: $ G ⇒ ∅ ∈ suc (suc ∅) $ by suc_mem_r [b1a]
b1c: $ G ⇒ K ∈ suc (suc ∅) $ by wcel_eq_l [a5j, b1b]
b1: $ G ⇒ K ∈ inmin tr_nat_D $ by wcel_eq_r [a3, b1c]
b2a: $ G ⇒ nadd (suc K) (suc ∅) = suc (nadd (suc K) ∅) $ by nadd_suc_c [a5l, a4a]
b2b: $ G ⇒ nadd (suc K) ∅ = suc K $ by nadd_zero_c [a5l]
b2c: $ G ⇒ nadd (suc K) ∅ = suc ∅ $ by eq_trans [b2b, a6]
b2d: $ G ⇒ suc (nadd (suc K) ∅) = suc (suc ∅) $ by suc_eq [b2c]
b2e: $ G ⇒ nadd (suc K) (suc ∅) = suc (suc ∅) $ by eq_trans [b2a, b2d]
b2: $ G ⇒ nadd (suc K) (suc ∅) = inmin tr_nat_D $ by eq_trans [b2e, a3]
b3: $ G ⇒ vat MV (inmin tr_nat_D) K = fv MV (suc ∅) $ by vat_eq [b1, a4, a4b, b2]
b4r: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
b4: $ G ⇒ fv MV (suc ∅) = fv (scons A (scons B ∅)) (suc ∅) $ by fv_eq [#1, b4r]
b5a: $ G ⇒ isset (scons B ∅) $ by scons_set [a0]
b5: $ G ⇒ fv (scons A (scons B ∅)) (suc ∅) = fv (scons B ∅) ∅ $ by scons_fv_suc_c [#2, b5a, a0]
b6: $ G ⇒ fv (scons B ∅) ∅ = B $ by scons_fv_zero_c [#3, a0]
b7: $ G ⇒ vat MV (inmin tr_nat_D) K = fv (scons A (scons B ∅)) (suc ∅) $ by eq_trans [b3, b4]
b8: $ G ⇒ vat MV (inmin tr_nat_D) K = fv (scons B ∅) ∅ $ by eq_trans [b7, b5]
b9: $ G ⇒ vat MV (inmin tr_nat_D) K = B $ by eq_trans [b8, b6]

lemma e4_vat2_1 (G: hyps) (MV A B K: class):
  $ G ⇒ MV = scons A (scons B ∅) $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ K = suc ∅ $ > $ G ⇒ vat MV (inmin tr_nat_D) K = A $
----
a0: $ G ⇒ isset ∅ $ by ax_empty
a1: $ G ⇒ isset (suc ∅) $ by suc_set [a0]
a2: $ G ⇒ inmin tr_nat_D = suc (suc ∅) $ by nat_inmin
a3: $ G ⇒ suc (suc ∅) = inmin tr_nat_D $ by eq_sym [a2]
a4a: $ G ⇒ ∅ ∈ ω $ by omega_zero
a4b: $ G ⇒ suc ∅ ∈ ω $ by omega_suc_c [a4a]
a4c: $ G ⇒ suc (suc ∅) ∈ ω $ by omega_suc_c [a4b]
a4: $ G ⇒ inmin tr_nat_D ∈ ω $ by wcel_eq_l [a3, a4c]
a5i: $ G ⇒ isset (suc ∅) $ by suc_set [a0]
a5j: $ G ⇒ suc ∅ = K $ by eq_sym [#4]
a5k: $ G ⇒ isset K $ by isset_eq [a5j, a5i]
a5l: $ G ⇒ isset (suc K) $ by suc_set [a5k]
a6: $ G ⇒ suc K = suc (suc ∅) $ by suc_eq [#4]
b1a: $ G ⇒ suc ∅ ∈ suc (suc ∅) $ by suc_mem [a1]
b1c: $ G ⇒ K ∈ suc (suc ∅) $ by wcel_eq_l [a5j, b1a]
b1: $ G ⇒ K ∈ inmin tr_nat_D $ by wcel_eq_r [a3, b1c]
b2b: $ G ⇒ nadd (suc K) ∅ = suc K $ by nadd_zero_c [a5l]
b2c: $ G ⇒ nadd (suc K) ∅ = suc (suc ∅) $ by eq_trans [b2b, a6]
b2: $ G ⇒ nadd (suc K) ∅ = inmin tr_nat_D $ by eq_trans [b2c, a3]
b3: $ G ⇒ vat MV (inmin tr_nat_D) K = fv MV ∅ $ by vat_eq [b1, a4, a4a, b2]
b4r: $ G ⇒ ∅ = ∅ $ by eq_refl
b4: $ G ⇒ fv MV ∅ = fv (scons A (scons B ∅)) ∅ $ by fv_eq [#1, b4r]
b5a: $ G ⇒ isset ∅ $ by ax_empty
b5b: $ G ⇒ isset (scons B ∅) $ by scons_set [b5a]
b5: $ G ⇒ fv (scons A (scons B ∅)) ∅ = A $ by scons_fv_zero_c [#2, b5b]
b7: $ G ⇒ vat MV (inmin tr_nat_D) K = fv (scons A (scons B ∅)) ∅ $ by eq_trans [b3, b4]
b9: $ G ⇒ vat MV (inmin tr_nat_D) K = A $ by eq_trans [b7, b5]

lemma e4_two_elim (G: hyps) (k: set): $ G ⇒ k ∊ suc (suc ∅) $ > $ G ⇒ k = ∅ ∨ k = suc ∅ $
----
l1: $ G ⇒ k ∊ suc ∅ ∨ k ∊ csn (suc ∅) $ by cun_elim [#1]
l2: $ G , k ∊ suc ∅ ⇒ k ∊ suc ∅ $ by ax
l3: $ G , k ∊ suc ∅ ⇒ k = ∅ $ by e4_one_elim [l2]
l4: $ G , k ∊ suc ∅ ⇒ k = ∅ ∨ k = suc ∅ $ by or_intro_l [l3]
l5: $ G , k ∊ csn (suc ∅) ⇒ k ∊ csn (suc ∅) $ by ax
l6: $ G , k ∊ csn (suc ∅) ⇒ k = suc ∅ $ by csn_elim [l5]
l7: $ G , k ∊ csn (suc ∅) ⇒ k = ∅ ∨ k = suc ∅ $ by or_intro_r [l6]
l8: $ G ⇒ k = ∅ ∨ k = suc ∅ $ by or_elim [l1, l4, l7]

--| A motive and a `succ` minor are elements of an admissible universe.
lemma e4_mot_u {x: set} (G: hyps x) (V: class) (u m: set):
  $ G ⇒ uadm u $ > $ G ⇒ V ∈ ω $ > $ G ⇒ m ∊ cpi x nnat (fv uni V) $ > $ G ⇒ m ∊ u $
----
u1: $ G ⇒ universe u $ by uadm_universe [#1]
u2: $ G ⇒ nnat ∈ u $ by nnat_u [#1]
u3: $ G ⇒ fv uni V ∈ u $ by uadm_uni_c [#1, #2]
u4: $ G , x9 ∊ nnat ⇒ fv uni V ∈ u $ by weaken [u3]
u5: $ G ⇒ x9 ∊ nnat → fv uni V ∈ u $ by imp_intro [u4]
u6a: $ G ⇒ ∀ x9 (x9 ∊ nnat → fv uni V ∈ u) $ by all_intro [u5]
u6b: $ ∀ x9 (x9 ∊ nnat → fv uni V ∈ u) ⟺ ∀ x (x ∊ nnat → fv uni V ∈ u) $ by all_alpha
u6c: $ G ⇒ ∀ x9 (x9 ∊ nnat → fv uni V ∈ u) ↔ ∀ x (x ∊ nnat → fv uni V ∈ u) $ by weaken [u6b]
u6: $ G ⇒ ∀ x (x ∊ nnat → fv uni V ∈ u) $ by bi_elim_l [u6c, u6a]
u7: $ G ⇒ cpi x nnat (fv uni V) ∈ u $ by universe_cpi [u1, u2, u6]
u8: $ G ⇒ m ∈ cpi x nnat (fv uni V) $ by welc_wcel [#3]
u9: $ G ⇒ m ∈ u $ by universe_elem_elem_c [u1, u7, u8]
u10: $ G ⇒ m ∊ u $ by wcel_welc [u9]

lemma e4_ms_u {y h: set} (G: hyps y h) (u m ms: set):
  $ G ⇒ uadm u $ > $ G ⇒ m ∊ u $ > $ G ⇒ ms ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ > $ G ⇒ ms ∊ u $
----
u1: $ G ⇒ universe u $ by uadm_universe [#1]
u2: $ G ⇒ nnat ∈ u $ by nnat_u [#1]
v1: $ G , x8 ∊ nnat ⇒ universe u $ by weaken [u1]
v2a: $ G , x8 ∊ nnat ⇒ m ∊ u $ by weaken [#2]
v2: $ G , x8 ∊ nnat ⇒ ap m x8 ∈ u $ by universe_ap [v1, v2a]
v3a: $ G , x8 ∊ nnat ⇒ m ∈ u $ by welc_wcel [v2a]
v3b: $ G , x8 ∊ nnat ⇒ isset (nsc x8) $ by nsc_set
v3: $ G , x8 ∊ nnat ⇒ ap m (nsc x8) ∈ u $ by universe_ap_c [v1, v3a, v3b]
v4: $ G , x8 ∊ nnat , x9 ∊ ap m x8 ⇒ ap m (nsc x8) ∈ u $ by weaken [v3]
v5: $ G , x8 ∊ nnat ⇒ x9 ∊ ap m x8 → ap m (nsc x8) ∈ u $ by imp_intro [v4]
v6: $ G , x8 ∊ nnat ⇒ ∀ x9 (x9 ∊ ap m x8 → ap m (nsc x8) ∈ u) $ by all_intro [v5]
v7: $ G , x8 ∊ nnat ⇒ cpi x9 (ap m x8) (ap m (nsc x8)) ∈ u $ by universe_cpi [v1, v2, v6]
w1: $ G ⇒ x8 ∊ nnat → cpi x9 (ap m x8) (ap m (nsc x8)) ∈ u $ by imp_intro [v7]
w2: $ G ⇒ ∀ x8 (x8 ∊ nnat → cpi x9 (ap m x8) (ap m (nsc x8)) ∈ u) $ by all_intro [w1]
w3a: $ G ⇒ cpi x8 nnat (cpi x9 (ap m x8) (ap m (nsc x8))) ∈ u $ by universe_cpi [u1, u2, w2]
w3b: $ cpi x8 nnat (cpi x9 (ap m x8) (ap m (nsc x8))) ≐ cpi y nnat (cpi x9 (ap m y) (ap m (nsc y))) $ by cpi_alpha
w3c: $ cpi x9 (ap m y) (ap m (nsc y)) ≐ cpi h (ap m y) (ap m (nsc y)) $ by cpi_alpha
w3d: $ nnat ≐ nnat $ by ceqt_refl
w3e: $ cpi y nnat (cpi x9 (ap m y) (ap m (nsc y))) ≐ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by cpi_congr [w3d, w3c]
w3f: $ cpi x8 nnat (cpi x9 (ap m x8) (ap m (nsc x8))) ≐ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by ceqt_trans [w3b, w3e]
w3g: $ G ⇒ cpi x8 nnat (cpi x9 (ap m x8) (ap m (nsc x8))) = cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by weaken [w3f]
w3: $ G ⇒ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) ∈ u $ by wcel_eq_l [w3g, w3a]
w4: $ G ⇒ ms ∈ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by welc_wcel [#3]
w5: $ G ⇒ ms ∈ u $ by universe_elem_elem_c [u1, w3, w4]
w6: $ G ⇒ ms ∊ u $ by wcel_welc [w5]

--| The minors' valuations at Nat: `ms` for `succ`, then `z` for `zero`.
lemma e4_imins_intro {y h e: set} (G: hyps) (M P CV: class) (u w m z ms: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ CV = scons m ∅ $ > $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ >
  $ G ⇒ z ∊ ap m nzr $ > $ G ⇒ ms ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ > $ G ⇒ z ∊ u $ > $ G ⇒ ms ∊ u $ >
  $ G ⇒ scons ms (scons z ∅) ∈ imins u (dnf u M) tr_nat_D w P CV $
----
s0: $ G ⇒ isset ∅ $ by ax_empty
s1a: $ G , x9 = ∅ ⇒ isset ∅ $ by ax_empty
s1: $ G , x9 = ∅ ⇒ isset (scons z ∅) $ by scons_set [s1a]
s2a: $ G , x9 = ∅ , x6 = scons z ∅ ⇒ isset x6 $ by isset_var
s2: $ G , x9 = ∅ , x6 = scons z ∅ ⇒ isset (scons ms x6) $ by scons_set [s2a]
g1: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ uadm u $ by weaken [#1]
g2: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ w ∊ lvals $ by weaken [#2]
g3: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ P = ∅ $ by weaken [#3]
g4: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ CV = scons m ∅ $ by weaken [#4]
g5: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by weaken [#5]
g6: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ z ∊ ap m nzr $ by weaken [#6]
g7: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ ms ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by weaken [#7]
g8: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ z ∊ u $ by weaken [#8]
g9: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ ms ∊ u $ by weaken [#9]
e1: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ x9 = ∅ $ by ax
e2: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ x6 = scons z ∅ $ by ax
e3: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ o = scons ms x6 $ by ax
f1a: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ z ∈ u $ by welc_wcel [g8]
f1b: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ ∅ ∈ fseq u $ by fseq_empty
f1c: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ scons z ∅ ∈ fseq u $ by scons_fseq_c [f1a, f1b]
f1d: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ scons z ∅ = x6 $ by eq_sym [e2]
f1e: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ x6 ∈ fseq u $ by wcel_eq_l [f1d, f1c]
f1: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ x6 ∊ fseq u $ by wcel_welc [f1e]
f2a: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ ms ∈ u $ by welc_wcel [g9]
f2b: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ scons ms x6 ∈ fseq u $ by scons_fseq_c [f2a, f1e]
f2c: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ scons ms x6 = o $ by eq_sym [e3]
f2d: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ o ∈ fseq u $ by wcel_eq_l [f2c, f2b]
f2: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ o ∊ fseq u $ by wcel_welc [f2d]
f3a: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ cdm o = cdm (scons ms x6) $ by cdm_eq [e3]
f3b: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ cdm (scons ms x6) = suc (cdm x6) $ by scons_len [f1]
f3c: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ cdm x6 = cdm (scons z ∅) $ by cdm_eq [e2]
f3d: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ cdm (scons z ∅) = suc ∅ $ by scons_empty_len
f3e: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ cdm x6 = suc ∅ $ by eq_trans [f3c, f3d]
f3f: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ suc (cdm x6) = suc (suc ∅) $ by suc_eq [f3e]
f3g: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ inmin tr_nat_D = suc (suc ∅) $ by nat_inmin
f3h: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ suc (suc ∅) = inmin tr_nat_D $ by eq_sym [f3g]
f3i: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ cdm o = suc (cdm x6) $ by eq_trans [f3a, f3b]
f3j: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ cdm o = suc (suc ∅) $ by eq_trans [f3i, f3f]
f3: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ cdm o = inmin tr_nat_D $ by eq_trans [f3j, f3h]
f4r: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ ms = ms $ by eq_refl
f4a: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ scons ms x6 = scons ms (scons z ∅) $ by scons_eq [f4r, e2]
f4: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ o = scons ms (scons z ∅) $ by eq_trans [e3, f4a]
f5i: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ isset ms $ by isset_var
f5j: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 ⇒ isset z $ by isset_var
k1: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 , k ∊ inmin tr_nat_D ⇒ k ∊ inmin tr_nat_D $ by ax
k2a: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 , k ∊ inmin tr_nat_D ⇒ inmin tr_nat_D = suc (suc ∅) $ by nat_inmin
k2b: $ G , x9 = ∅ , x6 = scons z ∅ , o = scons ms x6 , k ∊ inmin tr_nat_D ⇒ k ∊ suc (suc ∅) $ by welc_eq [k2a, k1]
