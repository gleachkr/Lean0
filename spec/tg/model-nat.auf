lemma e3_ient_N (G: hyps) (W Z: class): $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ⊆ csn ∅ × (csn ∅ × nnat) $ > $ G ⇒ ient tr_nat_D W Z ∅ ⊆ nnat $
