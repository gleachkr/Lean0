--| The value space of `succ`'s minor at a path: the motive at `nsc x`.
lemma e4_bq1_elim {e y d f g t a h: set} (G: hyps) (M I C P CV A: class) (u w m q x c: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = suc ∅ $ > $ G ⇒ CV = scons m ∅ $ > $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ >
  $ G ⇒ q = scat (scons c ∅) (scons x ∅) $ > $ G ⇒ A ∈ {y | ∃ d ∃ f ∃ g ∃ t ∃ a ∃ h (ictk tr_nat_D I C d ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∧ h ∊ ihv tr_nat_D d (imrel tr_nat_D CV) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))))} $ > $ G ⇒ A ∈ ap m (nsc x) $
