f2a: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j , k ∊ ω ∧ nadd (suc j) k = intys tr_nat_D ∧ w ∊ fv CV k ⇒ w ∈ u $ by welc_wcel [f1]
f2: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j , k ∊ ω ∧ nadd (suc j) k = intys tr_nat_D ∧ w ∊ fv CV k ⇒ ⟨ x , y ⟩ ∈ u $ by wcel_eq_l [g8, f2a]
f3: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j , k ∊ ω ∧ nadd (suc j) k = intys tr_nat_D ∧ w ∊ fv CV k ⇒ y ∊ u $ by universe_opair_r [f1a, f2]
f4a: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j , k ∊ ω ∧ nadd (suc j) k = intys tr_nat_D ∧ w ∊ fv CV k ⇒ o = y $ by weaken [j3a]
f4b: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j , k ∊ ω ∧ nadd (suc j) k = intys tr_nat_D ∧ w ∊ fv CV k ⇒ y = o $ by eq_sym [f4a]
f4: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j , k ∊ ω ∧ nadd (suc j) k = intys tr_nat_D ∧ w ∊ fv CV k ⇒ o ∊ u $ by welc_eq_set [f4b, f3]
f5: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j ⇒ o ∊ u $ by ex_elim [h0a, f4]
f6: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ o ∊ u $ by wcel_elim [j5, f5]
xa3: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) ⇒ ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) $ by ax
xb3: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) ⇒ o ∊ u $ by ex_elim [xa3, f6]
xa2: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , ∃ x ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) ⇒ ∃ x ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) $ by ax
xb2: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , ∃ x ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) ⇒ o ∊ u $ by ex_elim [xa2, xb3]
xa1: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , ∃ a ∃ x ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) ⇒ ∃ a ∃ x ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) $ by ax
xb1: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , ∃ a ∃ x ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) ⇒ o ∊ u $ by ex_elim [xa1, xb2]
xz: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV ⇒ o ∊ u $ by ex_elim [k2, xb1]
f8: $ G , o ∊ ap (imrel tr_nat_D CV) e ⇒ o ∊ u $ by wcel_elim [n1, xz]
f9: $ G ⇒ ap (imrel tr_nat_D CV) e ⊆ u $ by subset_intro [f8]
f10: $ G ⇒ isset u $ by isset_var
f11: $ G ⇒ isset (ap (imrel tr_nat_D CV) e) $ by subset_isset [f10, f9]
f12: $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by all_intro [f11]

lemma e4_one_elim (G: hyps) (j: set): $ G ⇒ j ∊ suc ∅ $ > $ G ⇒ j = ∅ $
----
l1: $ G ⇒ j ∊ ∅ ∨ j ∊ csn ∅ $ by cun_elim [#1]
l2: $ G , j ∊ ∅ ⇒ j ∊ ∅ $ by ax
l3: $ G , j ∊ ∅ ⇒ ⊥ $ by empty_elim [l2]
l4: $ G , j ∊ ∅ ⇒ j = ∅ $ by bot_elim [l3]
l5: $ G , j ∊ csn ∅ ⇒ j ∊ csn ∅ $ by ax
l6: $ G , j ∊ csn ∅ ⇒ j = ∅ $ by csn_elim [l5]
l7: $ G ⇒ j = ∅ $ by or_elim [l1, l4, l6]

--| Nat's value read at the paths of the motive.
lemma e4_apnity (G: hyps) (M J F P: class) (u w: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ J = ∅ $ > $ G ⇒ F = ∅ $ > $ G ⇒ P = ∅ $ >
  $ G ⇒ apn (ity u (dnf u M) tr_nat_D J w) (scat F P) = nnat $
----
l1: $ G ⇒ tr_nat_D = tr_nat_D $ by eq_refl
l2: $ G ⇒ w = w $ by eq_refl
l3: $ G ⇒ ifam u (dnf u M) tr_nat_D w = ifam u (dnf u M) tr_nat_D w $ by eq_refl
l4: $ G ⇒ ity u (dnf u M) tr_nat_D J w = ity u (dnf u M) tr_nat_D ∅ w $ by ient_eq [l1, l2, l3, #3]
l5: $ G ⇒ ity u (dnf u M) tr_nat_D ∅ w = nnat $ by nat_ity [#1, #2]
l6: $ G ⇒ ity u (dnf u M) tr_nat_D J w = nnat $ by eq_trans [l4, l5]
l7: $ G ⇒ scat F P = scat ∅ ∅ $ by scat_eq [#4, #5]
l8a: $ G ⇒ ∅ ∈ fseq ω $ by fseq_empty
l8: $ G ⇒ scat ∅ ∅ = ∅ $ by scat_empty_l_c [l8a]
l9: $ G ⇒ scat F P = ∅ $ by eq_trans [l7, l8]
l10: $ G ⇒ apn (ity u (dnf u M) tr_nat_D J w) (scat F P) = apn nnat ∅ $ by apn_eq [l6, l9]
l11: $ G ⇒ apn nnat ∅ = nnat $ by apn_empty
l12: $ G ⇒ apn (ity u (dnf u M) tr_nat_D J w) (scat F P) = nnat $ by eq_trans [l10, l11]

--| The motive's paths at Nat: an element of Nat.
lemma e4_imq_elim {b: set} (G: hyps) (M J P: class) (u w z: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ z ∊ imq u (dnf u M) tr_nat_D J w P $ >
  $ G ⇒ ∃ b (b ∊ nnat ∧ z = scons b ∅) $
----
k1: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ ityf tr_nat_D J o $ by ax
k2: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ J = ∅ ∧ o = tn_F $ by nat_ityf_det [k1]
k2a: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ J = ∅ $ by and_elim_l [k2]
k2b: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ o = tn_F $ by and_elim_r [k2]
k3a: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ w ∊ lvals $ by weaken [#2]
k3b: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ P = ∅ $ by weaken [#3]
k3c: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P $ by ax
k3: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ f = ∅ ∧ g = ∅ ∧ t = ∅ ∧ a = ∅ $ by e4_F_elim [k3a, k3b, k2b, k3c]
k4: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ f = ∅ $ by and_elim_l [k3]
k5a: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ uadm u $ by weaken [#1]
k5: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) = nnat $ by e4_apnity [k5a, k3a, k2a, k4, k3b]
k6a: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) $ by ax
k6: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ x ∊ nnat $ by welc_eq [k5, k6a]
k7a: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ z = scons x f $ by ax
k7r: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ x = x $ by eq_refl
k7b: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ scons x f = scons x ∅ $ by scons_eq [k7r, k4]
k7: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ z = scons x ∅ $ by eq_trans [k7a, k7b]
k8: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ x ∊ nnat ∧ z = scons x ∅ $ by and_intro [k6, k7]
k9: $ G , ityf tr_nat_D J o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P , x ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat f P) , z = scons x f ⇒ ∃ b (b ∊ nnat ∧ z = scons b ∅) $ by ex_intro [k8]
k10: $ G ⇒ ∃ b (b ∊ nnat ∧ z = scons b ∅) $ by imq_elim [#4, k9]

lemma e4_imq_intro (G: hyps) (M J P: class) (u w c: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ J = ∅ $ > $ G ⇒ c ∊ nnat $ >
  $ G ⇒ scons c ∅ ∈ imq u (dnf u M) tr_nat_D J w P $
----
i0: $ G ⇒ isset ∅ $ by ax_empty
i1: $ G , e = ∅ ⇒ isset tn_F $ by opair_isset
i2a: $ G , e = ∅ , o = tn_F ⇒ isset ∅ $ by ax_empty
i2: $ G , e = ∅ , o = tn_F ⇒ isset (scons c ∅) $ by scons_set [i2a]
k1a: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ ityf tr_nat_D ∅ tn_F $ by nat_ityf
k1b: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ tr_nat_D = tr_nat_D $ by eq_refl
k1c: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ J = ∅ $ by weaken [#4]
k1d: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ ∅ = J $ by eq_sym [k1c]
k1e: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ o = tn_F $ by ax
k1f: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ tn_F = o $ by eq_sym [k1e]
k1: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ ityf tr_nat_D J o $ by ityf_eq [k1b, k1d, k1f, k1a]
k2a: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ w ∊ lvals $ by weaken [#2]
k2b: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ P = ∅ $ by weaken [#3]
k2c: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ e = ∅ $ by ax
k2: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ ⟨ e , ⟨ e , ⟨ e , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w P $ by e4_F_intro [k2a, k2b, k1e, k2c]
k3a: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ uadm u $ by weaken [#1]
k3b: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ apn (ity u (dnf u M) tr_nat_D J w) (scat e P) = nnat $ by e4_apnity [k3a, k2a, k1c, k2c, k2b]
k3c: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ nnat = apn (ity u (dnf u M) tr_nat_D J w) (scat e P) $ by eq_sym [k3b]
k3d: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ c ∊ nnat $ by weaken [#5]
k3: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ c ∊ apn (ity u (dnf u M) tr_nat_D J w) (scat e P) $ by welc_eq [k3c, k3d]
k4a: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ z = scons c ∅ $ by ax
k4r: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ c = c $ by eq_refl
k4c: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ ∅ = e $ by eq_sym [k2c]
k4b: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ scons c ∅ = scons c e $ by scons_eq [k4r, k4c]
k4: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ z = scons c e $ by eq_trans [k4a, k4b]
k5: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ z ∊ imq u (dnf u M) tr_nat_D J w P $ by imq_intro [k1, k2, k3, k4]
k6: $ G , e = ∅ , o = tn_F , z = scons c ∅ ⇒ scons c ∅ ∈ imq u (dnf u M) tr_nat_D J w P $ by wcel_intro [k4a, k5]
k7: $ G , e = ∅ , o = tn_F ⇒ scons c ∅ ∈ imq u (dnf u M) tr_nat_D J w P $ by isset_elim [i2, k6]
k8: $ G , e = ∅ ⇒ scons c ∅ ∈ imq u (dnf u M) tr_nat_D J w P $ by isset_elim [i1, k7]
k9: $ G ⇒ scons c ∅ ∈ imq u (dnf u M) tr_nat_D J w P $ by isset_elim [i0, k8]

--| The motive's space at Nat: the traces on Nat into `U_V`.
lemma e4_imot_intro {x: set} (G: hyps) (M J P V: class) (u w m: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ J = ∅ $ > $ G ⇒ m ∊ cpi x nnat (fv uni V) $ >
  $ G ⇒ m ∊ imot u (dnf u M) tr_nat_D J w P V $
----
l0: $ G , o ∊ m ⇒ m ∊ cpi x nnat (fv uni V) $ by weaken [#5]
l1: $ G , o ∊ m ⇒ m ⊆ clam x nnat (⋃ (fv uni V)) $ by cpi_elim_sub [l0]
l2: $ G , o ∊ m ⇒ o ∊ m $ by ax
l3: $ G , o ∊ m ⇒ o ∊ clam x nnat (⋃ (fv uni V)) $ by subset_elim [l1, l2]
j0a: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) ⇒ isset ∅ $ by ax_empty
j0: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) ⇒ isset (scons a ∅) $ by scons_set [j0a]
h1: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ uadm u $ by weaken [#1]
h2: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ w ∊ lvals $ by weaken [#2]
h3: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ P = ∅ $ by weaken [#3]
h4: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ J = ∅ $ by weaken [#4]
h5: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ a ∊ nnat $ by ax
h6: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ scons a ∅ ∈ imq u (dnf u M) tr_nat_D J w P $ by e4_imq_intro [h1, h2, h3, h4, h5]
h7a: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ q = scons a ∅ $ by ax
h7b: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ scons a ∅ = q $ by eq_sym [h7a]
h7c: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ q ∈ imq u (dnf u M) tr_nat_D J w P $ by wcel_eq_l [h7b, h6]
h7: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ q ∊ imq u (dnf u M) tr_nat_D J w P $ by wcel_welc [h7c]
h8r: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ b = b $ by eq_refl
h8a: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ nest q b = nest (scons a ∅) b $ by nest_eq [h7a, h8r]
h8i: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ isset a $ by isset_var
h8j: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ isset b $ by isset_var
h8b: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ nest (scons a ∅) b = ⟨ a , b ⟩ $ by nest_one [h8i, h8j]
h8c: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ nest q b = ⟨ a , b ⟩ $ by eq_trans [h8a, h8b]
h8d: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ o = ⟨ a , b ⟩ $ by ax
h8e: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ ⟨ a , b ⟩ = nest q b $ by eq_sym [h8c]
h8: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ o = nest q b $ by eq_trans [h8d, h8e]
h9: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q b $ by and_intro [h7, h8]
h10: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) $ by ex_intro [h9]
h11: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) , q = scons a ∅ ⇒ ∃ q ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) $ by ex_intro [h10]
h12: $ G , o ∊ m , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ x / a ⟧ (⋃ (fv uni V))) ⇒ ∃ q ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) $ by isset_elim [j0, h11]
l4: $ G , o ∊ m ⇒ ∃ q ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) $ by clam_elim_mem [l3, h12]
l5: $ G ⇒ o ∊ m → ∃ q ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) $ by imp_intro [l4]
l6: $ G ⇒ ∀ o (o ∊ m → ∃ q ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k)) $ by all_intro [l5]
n1: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P ⇒ uadm u $ by weaken [#1]
n2: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P ⇒ w ∊ lvals $ by weaken [#2]
n3: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P ⇒ P = ∅ $ by weaken [#3]
n4: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P ⇒ q ∊ imq u (dnf u M) tr_nat_D J w P $ by ax
n5: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P ⇒ ∃ b (b ∊ nnat ∧ q = scons b ∅) $ by e4_imq_elim [n1, n2, n3, n4]
p1: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ b ∊ nnat ∧ q = scons b ∅ $ by ax
p2: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ b ∊ nnat $ by and_elim_l [p1]
p3: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ q = scons b ∅ $ by and_elim_r [p1]
p4r: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ m = m $ by eq_refl
p4a: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ apn m q = apn m (scons b ∅) $ by apn_eq [p4r, p3]
p4i: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ isset b $ by isset_var
p4b: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ apn m (scons b ∅) = ap m b $ by apn_one [p4i]
p4: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ apn m q = ap m b $ by eq_trans [p4a, p4b]
p5a: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ m ∊ cpi x nnat (fv uni V) $ by weaken [#5]
p5: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ ap m b ∈ fv uni V $ by cpi_elim_ap [p5a, p2]
p6a: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ ap m b = apn m q $ by eq_sym [p4]
p6: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P , b ∊ nnat ∧ q = scons b ∅ ⇒ apn m q ∈ fv uni V $ by wcel_eq_l [p6a, p5]
p7: $ G , q ∊ imq u (dnf u M) tr_nat_D J w P ⇒ apn m q ∈ fv uni V $ by ex_elim [n5, p6]
p8: $ G ⇒ q ∊ imq u (dnf u M) tr_nat_D J w P → apn m q ∈ fv uni V $ by imp_intro [p7]
p9: $ G ⇒ ∀ q (q ∊ imq u (dnf u M) tr_nat_D J w P → apn m q ∈ fv uni V) $ by all_intro [p8]
p10: $ G ⇒ m ∊ imot u (dnf u M) tr_nat_D J w P V $ by fpi_intro [l6, p9]

lemma e4_imot_elim {x: set} (G: hyps) (M J P V: class) (u w m: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ J = ∅ $ > $ G ⇒ m ∊ imot u (dnf u M) tr_nat_D J w P V $ >
  $ G ⇒ m ∊ cpi x nnat (fv uni V) $
----
l1: $ G , o ∊ m ⇒ m ∊ fpi q (imq u (dnf u M) tr_nat_D J w P) (fv uni V) $ by weaken [#5]
l2: $ G , o ∊ m ⇒ o ∊ m $ by ax
l3: $ G , o ∊ m ⇒ ∃ q ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) $ by fpi_pts [l1, l2]
m1: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k ⇒ q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k $ by ax
m2: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k ⇒ q ∊ imq u (dnf u M) tr_nat_D J w P $ by and_elim_l [m1]
m3: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k ⇒ o = nest q k $ by and_elim_r [m1]
m4a: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k ⇒ uadm u $ by weaken [#1]
m4b: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k ⇒ w ∊ lvals $ by weaken [#2]
m4c: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k ⇒ P = ∅ $ by weaken [#3]
m4: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k ⇒ ∃ b (b ∊ nnat ∧ q = scons b ∅) $ by e4_imq_elim [m4a, m4b, m4c, m2]
n1: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ b ∊ nnat ∧ q = scons b ∅ $ by ax
n2: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ b ∊ nnat $ by and_elim_l [n1]
n3: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ q = scons b ∅ $ by and_elim_r [n1]
n4r: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ k = k $ by eq_refl
n4a: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ nest q k = nest (scons b ∅) k $ by nest_eq [n3, n4r]
n4i: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ isset b $ by isset_var
n4j: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ isset k $ by isset_var
n4b: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ nest (scons b ∅) k = ⟨ b , k ⟩ $ by nest_one [n4i, n4j]
m3w: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ o = nest q k $ by weaken [m3]
n4c: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ o = nest (scons b ∅) k $ by eq_trans [m3w, n4a]
n4: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ o = ⟨ b , k ⟩ $ by eq_trans [n4c, n4b]
n5: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ b ∊ nnat ∧ o = ⟨ b , k ⟩ $ by and_intro [n2, n4]
n6: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ ∃ e (b ∊ nnat ∧ o = ⟨ b , e ⟩) $ by ex_intro [n5]
n7: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k , b ∊ nnat ∧ q = scons b ∅ ⇒ ∃ a ∃ e (a ∊ nnat ∧ o = ⟨ a , e ⟩) $ by ex_intro [n6]
n8: $ G , o ∊ m , q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k ⇒ ∃ a ∃ e (a ∊ nnat ∧ o = ⟨ a , e ⟩) $ by ex_elim [m4, n7]
xa1: $ G , o ∊ m , ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) ⇒ ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) $ by ax
xb1: $ G , o ∊ m , ∃ k (q ∊ imq u (dnf u M) tr_nat_D J w P ∧ o = nest q k) ⇒ ∃ a ∃ e (a ∊ nnat ∧ o = ⟨ a , e ⟩) $ by ex_elim [xa1, n8]
xz: $ G , o ∊ m ⇒ ∃ a ∃ e (a ∊ nnat ∧ o = ⟨ a , e ⟩) $ by ex_elim [l3, xb1]
p1: $ G ⇒ o ∊ m → ∃ a ∃ e (a ∊ nnat ∧ o = ⟨ a , e ⟩) $ by imp_intro [xz]
p2: $ G ⇒ ∀ o (o ∊ m → ∃ a ∃ e (a ∊ nnat ∧ o = ⟨ a , e ⟩)) $ by all_intro [p1]
r0a: $ G , x ∊ nnat ⇒ isset ∅ $ by ax_empty
r0: $ G , x ∊ nnat ⇒ isset (scons x ∅) $ by scons_set [r0a]
r1: $ G , x ∊ nnat , e = scons x ∅ ⇒ uadm u $ by weaken [#1]
r2: $ G , x ∊ nnat , e = scons x ∅ ⇒ w ∊ lvals $ by weaken [#2]
r3: $ G , x ∊ nnat , e = scons x ∅ ⇒ P = ∅ $ by weaken [#3]
r4: $ G , x ∊ nnat , e = scons x ∅ ⇒ J = ∅ $ by weaken [#4]
r5: $ G , x ∊ nnat , e = scons x ∅ ⇒ x ∊ nnat $ by ax
r6: $ G , x ∊ nnat , e = scons x ∅ ⇒ scons x ∅ ∈ imq u (dnf u M) tr_nat_D J w P $ by e4_imq_intro [r1, r2, r3, r4, r5]
r7a: $ G , x ∊ nnat , e = scons x ∅ ⇒ e = scons x ∅ $ by ax
r7b: $ G , x ∊ nnat , e = scons x ∅ ⇒ scons x ∅ = e $ by eq_sym [r7a]
r7c: $ G , x ∊ nnat , e = scons x ∅ ⇒ e ∈ imq u (dnf u M) tr_nat_D J w P $ by wcel_eq_l [r7b, r6]
r7: $ G , x ∊ nnat , e = scons x ∅ ⇒ e ∊ imq u (dnf u M) tr_nat_D J w P $ by wcel_welc [r7c]
r8a: $ G , x ∊ nnat , e = scons x ∅ ⇒ m ∊ fpi q (imq u (dnf u M) tr_nat_D J w P) (fv uni V) $ by weaken [#5]
r8: $ G , x ∊ nnat , e = scons x ∅ ⇒ apn m e ∈ fv uni V $ by fpi_ap [r8a, r7]
r9r: $ G , x ∊ nnat , e = scons x ∅ ⇒ m = m $ by eq_refl
r9a: $ G , x ∊ nnat , e = scons x ∅ ⇒ apn m e = apn m (scons x ∅) $ by apn_eq [r9r, r7a]
r9i: $ G , x ∊ nnat , e = scons x ∅ ⇒ isset x $ by isset_var
r9b: $ G , x ∊ nnat , e = scons x ∅ ⇒ apn m (scons x ∅) = ap m x $ by apn_one [r9i]
r9: $ G , x ∊ nnat , e = scons x ∅ ⇒ apn m e = ap m x $ by eq_trans [r9a, r9b]
r10: $ G , x ∊ nnat , e = scons x ∅ ⇒ ap m x ∈ fv uni V $ by wcel_eq_l [r9, r8]
r11: $ G , x ∊ nnat ⇒ ap m x ∈ fv uni V $ by isset_elim [r0, r10]
r12: $ G ⇒ x ∊ nnat → ap m x ∈ fv uni V $ by imp_intro [r11]
r13: $ G ⇒ ∀ x (x ∊ nnat → ap m x ∈ fv uni V) $ by all_intro [r12]
r14: $ G ⇒ m ∊ cpi x nnat (fv uni V) $ by cpi_intro_pts [p2, r13]

--| The motives' valuations at Nat: one motive.
lemma e4_imots_intro {x: set} (G: hyps) (M P V: class) (u w m: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ V ∈ ω $ > $ G ⇒ P = ∅ $ > $ G ⇒ m ∊ cpi x nnat (fv uni V) $ >
  $ G ⇒ scons m ∅ ∈ imots u (dnf u M) tr_nat_D w P V $
----
u1: $ G ⇒ universe u $ by uadm_universe [#1]
u2: $ G ⇒ nnat ∈ u $ by nnat_u [#1]
u3: $ G ⇒ fv uni V ∈ u $ by uadm_uni_c [#1, #3]
u4: $ G , x ∊ nnat ⇒ fv uni V ∈ u $ by weaken [u3]
u5: $ G ⇒ x ∊ nnat → fv uni V ∈ u $ by imp_intro [u4]
u6: $ G ⇒ ∀ x (x ∊ nnat → fv uni V ∈ u) $ by all_intro [u5]
u7: $ G ⇒ cpi x nnat (fv uni V) ∈ u $ by universe_cpi [u1, u2, u6]
u8: $ G ⇒ m ∈ cpi x nnat (fv uni V) $ by welc_wcel [#5]
u9: $ G ⇒ m ∈ u $ by universe_elem_elem_c [u1, u7, u8]
u10: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
u11: $ G ⇒ scons m ∅ ∈ fseq u $ by scons_fseq_c [u9, u10]
u12a: $ G ⇒ isset ∅ $ by ax_empty
u12: $ G ⇒ isset (scons m ∅) $ by scons_set [u12a]
k1: $ G , o = scons m ∅ ⇒ o = scons m ∅ $ by ax
k2a: $ G , o = scons m ∅ ⇒ scons m ∅ = o $ by eq_sym [k1]
k2b: $ G , o = scons m ∅ ⇒ scons m ∅ ∈ fseq u $ by weaken [u11]
k2c: $ G , o = scons m ∅ ⇒ o ∈ fseq u $ by wcel_eq_l [k2a, k2b]
k2: $ G , o = scons m ∅ ⇒ o ∊ fseq u $ by wcel_welc [k2c]
k3a: $ G , o = scons m ∅ ⇒ cdm o = cdm (scons m ∅) $ by cdm_eq [k1]
k3b: $ G , o = scons m ∅ ⇒ cdm (scons m ∅) = suc ∅ $ by scons_empty_len
k3c: $ G , o = scons m ∅ ⇒ intys tr_nat_D = suc ∅ $ by nat_intys
k3d: $ G , o = scons m ∅ ⇒ suc ∅ = intys tr_nat_D $ by eq_sym [k3c]
k3e: $ G , o = scons m ∅ ⇒ cdm o = suc ∅ $ by eq_trans [k3a, k3b]
k3: $ G , o = scons m ∅ ⇒ cdm o = intys tr_nat_D $ by eq_trans [k3e, k3d]
j1: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ j ∊ intys tr_nat_D $ by ax
j2a: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ intys tr_nat_D = suc ∅ $ by nat_intys
j2b: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ j ∊ suc ∅ $ by welc_eq [j2a, j1]
j2: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ j = ∅ $ by e4_one_elim [j2b]
j3a: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ o = scons m ∅ $ by ax
j3b: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ isset m $ by isset_var
j3: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ vat o (intys tr_nat_D) j = m $ by e4_vat1 [j3a, j3b, j2]
j4a: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ uadm u $ by weaken [#1]
j4b: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ w ∊ lvals $ by weaken [#2]
j4c: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ P = ∅ $ by weaken [#4]
j4d: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ m ∊ cpi x nnat (fv uni V) $ by weaken [#5]
j4: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ m ∊ imot u (dnf u M) tr_nat_D j w P V $ by e4_imot_intro [j4a, j4b, j4c, j2, j4d]
j5a: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ m = vat o (intys tr_nat_D) j $ by eq_sym [j3]
j5b: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ m ∈ imot u (dnf u M) tr_nat_D j w P V $ by welc_wcel [j4]
j5: $ G , o = scons m ∅ , j ∊ intys tr_nat_D ⇒ vat o (intys tr_nat_D) j ∈ imot u (dnf u M) tr_nat_D j w P V $ by wcel_eq_l [j5a, j5b]
k4: $ G , o = scons m ∅ ⇒ j ∊ intys tr_nat_D → vat o (intys tr_nat_D) j ∈ imot u (dnf u M) tr_nat_D j w P V $ by imp_intro [j5]
k5: $ G , o = scons m ∅ ⇒ ∀ j (j ∊ intys tr_nat_D → vat o (intys tr_nat_D) j ∈ imot u (dnf u M) tr_nat_D j w P V) $ by all_intro [k4]
k6: $ G , o = scons m ∅ ⇒ o ∊ ivals j u (intys tr_nat_D) (imot u (dnf u M) tr_nat_D j w P V) $ by ivals_intro [k2, k3, k5]
k7: $ G , o = scons m ∅ ⇒ scons m ∅ ∈ imots u (dnf u M) tr_nat_D w P V $ by wcel_intro [k1, k6]
k8: $ G ⇒ scons m ∅ ∈ imots u (dnf u M) tr_nat_D w P V $ by isset_elim [u12, k7]

lemma e4_imots_elim {x b: set} (G: hyps) (M P V: class) (u w cv: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ cv ∊ imots u (dnf u M) tr_nat_D w P V $ >
  $ G ⇒ ∃ b (b ∊ cpi x nnat (fv uni V) ∧ cv = scons b ∅) $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
l1: $ G ⇒ cv ∊ fseq u ∧ cdm cv = intys tr_nat_D $ by ivals_fseq [#4]
l2: $ G ⇒ cv ∊ fseq u $ by and_elim_l [l1]
l3: $ G ⇒ cdm cv = intys tr_nat_D $ by and_elim_r [l1]
l4a: $ G ⇒ intys tr_nat_D = suc ∅ $ by nat_intys
l4: $ G ⇒ cdm cv = suc ∅ $ by eq_trans [l3, l4a]
m1: $ G , k = ∅ ⇒ k = ∅ $ by ax
m2a: $ G , k = ∅ ⇒ ∅ = k $ by eq_sym [m1]
m2b: $ G , k = ∅ ⇒ suc ∅ = suc k $ by suc_eq [m2a]
m2c: $ G , k = ∅ ⇒ cdm cv = suc ∅ $ by weaken [l4]
m2: $ G , k = ∅ ⇒ cdm cv = suc k $ by eq_trans [m2c, m2b]
m3a: $ G , k = ∅ ⇒ cv ∊ fseq u $ by weaken [l2]
m3: $ G , k = ∅ ⇒ ∃ e ∃ f (f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f) $ by fseq_suc [m3a, m2]
n1: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f $ by ax
n2: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ f ∊ fseq u $ by and_elim_l [n1]
n3a: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ cdm f = k ∧ cv = scons e f $ by and_elim_r [n1]
n3: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ cdm f = k $ by and_elim_l [n3a]
n4: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ cv = scons e f $ by and_elim_r [n3a]
n5a: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ k = ∅ $ by ax
n5b: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ cdm f = ∅ $ by eq_trans [n3, n5a]
n5: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ f = ∅ $ by fseq_len_zero [n2, n5b]
n6r: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ e = e $ by eq_refl
n6a: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ scons e f = scons e ∅ $ by scons_eq [n6r, n5]
n6: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ cv = scons e ∅ $ by eq_trans [n4, n6a]
n7a: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ cv ∊ imots u (dnf u M) tr_nat_D w P V $ by weaken [#4]
n7b: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ ∅ ∈ suc ∅ ∧ suc ∅ ∈ ω ∧ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by e4_one
n7c: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ suc ∅ ∈ ω ∧ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by and_elim_r [n7b]
n7d: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by and_elim_r [n7c]
n7e: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ ∅ ∈ intys tr_nat_D $ by and_elim_r [n7d]
n7f: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ ∅ = k $ by eq_sym [n5a]
n7g: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ k ∈ intys tr_nat_D $ by wcel_eq_l [n7f, n7e]
n7h: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ k ∊ intys tr_nat_D $ by wcel_welc [n7g]
n7: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ vat cv (intys tr_nat_D) k ∈ imot u (dnf u M) tr_nat_D k w P V $ by ivals_elim [n7a, n7h]
n8i: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ isset e $ by isset_var
n8: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ vat cv (intys tr_nat_D) k = e $ by e4_vat1 [n6, n8i, n5a]
n9a: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ e ∈ imot u (dnf u M) tr_nat_D k w P V $ by wcel_eq_l [n8, n7]
n9: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ e ∊ imot u (dnf u M) tr_nat_D k w P V $ by wcel_welc [n9a]
n10a: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ uadm u $ by weaken [#1]
n10b: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ w ∊ lvals $ by weaken [#2]
n10c: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ P = ∅ $ by weaken [#3]
n10: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ e ∊ cpi x nnat (fv uni V) $ by e4_imot_elim [n10a, n10b, n10c, n5a, n9]
n11: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ e ∊ cpi x nnat (fv uni V) ∧ cv = scons e ∅ $ by and_intro [n10, n6]
n12: $ G , k = ∅ , f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f ⇒ ∃ b (b ∊ cpi x nnat (fv uni V) ∧ cv = scons b ∅) $ by ex_intro [n11]
xa1: $ G , k = ∅ , ∃ f (f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f) ⇒ ∃ f (f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f) $ by ax
xb1: $ G , k = ∅ , ∃ f (f ∊ fseq u ∧ cdm f = k ∧ cv = scons e f) ⇒ ∃ b (b ∊ cpi x nnat (fv uni V) ∧ cv = scons b ∅) $ by ex_elim [xa1, n12]
xz: $ G , k = ∅ ⇒ ∃ b (b ∊ cpi x nnat (fv uni V) ∧ cv = scons b ∅) $ by ex_elim [m3, xb1]
z1: $ G ⇒ ∃ b (b ∊ cpi x nnat (fv uni V) ∧ cv = scons b ∅) $ by isset_elim [l0, xz]

--| The paths of `zero`'s minor: the empty valuation.
lemma e4_iminq0_intro (G: hyps) (M I C P CV: class) (u w e: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = ∅ $ > $ G ⇒ e = ∅ $ >
  $ G ⇒ e ∊ iminq u (dnf u M) tr_nat_D I C w P CV $
----
l0: $ G ⇒ isset tn_K0 $ by opair_isset
k1a: $ G , o = tn_K0 ⇒ ictk tr_nat_D ∅ ∅ tn_K0 $ by nat_ictk0
k1b: $ G , o = tn_K0 ⇒ tr_nat_D = tr_nat_D $ by eq_refl
k1c0: $ G , o = tn_K0 ⇒ I = ∅ $ by weaken [#4]
k1c: $ G , o = tn_K0 ⇒ ∅ = I $ by eq_sym [k1c0]
k1d0: $ G , o = tn_K0 ⇒ C = ∅ $ by weaken [#5]
k1d: $ G , o = tn_K0 ⇒ ∅ = C $ by eq_sym [k1d0]
k1e0: $ G , o = tn_K0 ⇒ o = tn_K0 $ by ax
k1e: $ G , o = tn_K0 ⇒ tn_K0 = o $ by eq_sym [k1e0]
k1: $ G , o = tn_K0 ⇒ ictk tr_nat_D I C o $ by ictk_eq [k1b, k1c, k1d, k1e, k1a]
h1: $ G , o = tn_K0 ⇒ uadm u $ by weaken [#1]
h2: $ G , o = tn_K0 ⇒ w ∊ lvals $ by weaken [#2]
h3: $ G , o = tn_K0 ⇒ P = ∅ $ by weaken [#3]
h6: $ G , o = tn_K0 ⇒ e = ∅ $ by weaken [#6]
k2: $ G , o = tn_K0 ⇒ ⟨ e , ⟨ e , ⟨ e , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by e4_k0_intro [h1, h2, h3, k1e0, h6]
k3a: $ G , o = tn_K0 ⇒ cdm e = cdm ∅ $ by cdm_eq [h6]
k3b: $ G , o = tn_K0 ⇒ cdm ∅ = ∅ $ by cdm_empty
k3c: $ G , o = tn_K0 ⇒ cdm e = ∅ $ by eq_trans [k3a, k3b]
k3d: $ G , o = tn_K0 ⇒ ihv tr_nat_D o (imrel tr_nat_D CV) e e (cdm e) = ihv tr_nat_D o (imrel tr_nat_D CV) e e ∅ $ by ihv_eq_arg [k3c]
k3e: $ G , o = tn_K0 ⇒ ihv tr_nat_D o (imrel tr_nat_D CV) e e ∅ = csn ∅ $ by ihv_zero
k3f: $ G , o = tn_K0 ⇒ ihv tr_nat_D o (imrel tr_nat_D CV) e e (cdm e) = csn ∅ $ by eq_trans [k3d, k3e]
k3g: $ G , o = tn_K0 ⇒ csn ∅ = ihv tr_nat_D o (imrel tr_nat_D CV) e e (cdm e) $ by eq_sym [k3f]
k3h: $ G , o = tn_K0 ⇒ e ∊ csn ∅ $ by csn_intro [h6]
k3: $ G , o = tn_K0 ⇒ e ∊ ihv tr_nat_D o (imrel tr_nat_D CV) e e (cdm e) $ by welc_eq [k3g, k3h]
k4r: $ G , o = tn_K0 ⇒ e = e $ by eq_refl
k4a: $ G , o = tn_K0 ⇒ scat e e = scat e ∅ $ by scat_eq [k4r, h6]
k4b: $ G , o = tn_K0 ⇒ scat e ∅ = e $ by scat_empty_r
k4c: $ G , o = tn_K0 ⇒ scat e e = e $ by eq_trans [k4a, k4b]
k4: $ G , o = tn_K0 ⇒ e = scat e e $ by eq_sym [k4c]
k5: $ G , o = tn_K0 ⇒ e ∊ iminq u (dnf u M) tr_nat_D I C w P CV $ by iminq_intro [k1, k2, k3, k4]
k6: $ G ⇒ e ∊ iminq u (dnf u M) tr_nat_D I C w P CV $ by isset_elim [l0, k5]

--| `zero`'s minor's space: the motive at `nzr`.
lemma e4_imin0_intro (G: hyps) (M I C P CV: class) (u w m z: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = ∅ $ > $ G ⇒ CV = scons m ∅ $ >
  $ G ⇒ z ∊ ap m nzr $ > $ G ⇒ z ∊ imin u (dnf u M) tr_nat_D I C w P CV $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
g1: $ G , e = ∅ ⇒ uadm u $ by weaken [#1]
g2: $ G , e = ∅ ⇒ w ∊ lvals $ by weaken [#2]
g3: $ G , e = ∅ ⇒ P = ∅ $ by weaken [#3]
g4: $ G , e = ∅ ⇒ I = ∅ $ by weaken [#4]
g5: $ G , e = ∅ ⇒ C = ∅ $ by weaken [#5]
g6: $ G , e = ∅ ⇒ CV = scons m ∅ $ by weaken [#6]
g7: $ G , e = ∅ ⇒ z ∊ ap m nzr $ by weaken [#7]
g8: $ G , e = ∅ ⇒ e = ∅ $ by ax
g9: $ G , e = ∅ ⇒ e ∊ iminq u (dnf u M) tr_nat_D I C w P CV $ by e4_iminq0_intro [g1, g2, g3, g4, g5, g8]
a1: $ G , e = ∅ , o ∊ z ⇒ e ∊ iminq u (dnf u M) tr_nat_D I C w P CV $ by weaken [g9]
a2a: $ G , e = ∅ , o ∊ z ⇒ e = ∅ $ by weaken [g8]
a2r: $ G , e = ∅ , o ∊ z ⇒ o = o $ by eq_refl
a2b: $ G , e = ∅ , o ∊ z ⇒ nest e o = nest ∅ o $ by nest_eq [a2a, a2r]
a2i: $ G , e = ∅ , o ∊ z ⇒ isset o $ by isset_var
a2c: $ G , e = ∅ , o ∊ z ⇒ nest ∅ o = o $ by nest_empty [a2i]
a2d: $ G , e = ∅ , o ∊ z ⇒ nest e o = o $ by eq_trans [a2b, a2c]
a2: $ G , e = ∅ , o ∊ z ⇒ o = nest e o $ by eq_sym [a2d]
a3: $ G , e = ∅ , o ∊ z ⇒ e ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest e o $ by and_intro [a1, a2]
a4: $ G , e = ∅ , o ∊ z ⇒ ∃ k (e ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest e k) $ by ex_intro [a3]
a5: $ G , e = ∅ , o ∊ z ⇒ ∃ q ∃ k (q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q k) $ by ex_intro [a4]
a6: $ G , e = ∅ ⇒ o ∊ z → ∃ q ∃ k (q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q k) $ by imp_intro [a5]
a7: $ G , e = ∅ ⇒ ∀ o (o ∊ z → ∃ q ∃ k (q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q k)) $ by all_intro [a6]
c1: $ G , e = ∅ , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ uadm u $ by weaken [#1]
c2: $ G , e = ∅ , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ w ∊ lvals $ by weaken [#2]
c3: $ G , e = ∅ , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ P = ∅ $ by weaken [#3]
c4: $ G , e = ∅ , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ I = ∅ $ by weaken [#4]
c5: $ G , e = ∅ , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ C = ∅ $ by weaken [#5]
c6: $ G , e = ∅ , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ CV = scons m ∅ $ by weaken [#6]
