h4: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ y1 = nsc x1 $ by weaken [#6]
h5: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v0) $ by weaken [#7]
h6: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ v0 ∊ ap m x1 $ by weaken [#8]
h7: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ b0 = ap (ap ms x1) v0 $ by weaken [#9]
h8: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ∀ e (isset (ap (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) e)) $ by weaken [s3]
h9: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ap (ap ms x1) v0 ∈ u $ by weaken [t4]
r1: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ $ by ax
r2a: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ∅ = ∅ $ by eq_refl
r2b: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ⟨ ∅ , y1 ⟩ = ⟨ ∅ , nsc x1 ⟩ $ by opair_eq [r2a, h4]
r2c: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , nsc x1 ⟩ ⟩ $ by opair_eq [r2a, r2b]
r2d: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ x8 = b0 $ by ax
r2g: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ x8 = ap (ap ms x1) v0 $ by eq_trans [r2d, h7]
r2e: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ = ⟨ ⟨ ∅ , ⟨ ∅ , nsc x1 ⟩ ⟩ , ap (ap ms x1) v0 ⟩ $ by opair_eq [r2c, r2g]
r2: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ q = ⟨ ⟨ ∅ , ⟨ ∅ , nsc x1 ⟩ ⟩ , ap (ap ms x1) v0 ⟩ $ by eq_trans [r1, r2e]
r3a: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ v0 = v0 $ by eq_refl
r3b: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ , v0 ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ v0 = v0 $ by all_elim [h5]
r3c: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ , v0 ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) $ by bi_elim_r [r3b, r3a]
r3: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ v0 ∊ ap (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) ⟨ ∅ , ⟨ ∅ , x1 ⟩ ⟩ $ by ap_intro [r3c]
r4a: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ scons ms (scons z ∅) = scons ms (scons z ∅) $ by eq_refl
r4: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ q ∊ ifold0 u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) (ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅))) $ by e4_f0_intro1 [h1, h2, r2a, r4a, h8, h3, r3, h9, r2]
r5: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ q ∊ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) $ by ifold_intro [r4]
r6: $ G , x8 = b0 , q = ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) $ by wcel_intro [r1, r5]
r7: $ G , x8 = b0 ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) $ by isset_elim [r0, r6]
r8: $ G ⇒ ⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , x8 ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ x8 = b0 $ by bi_intro [e2, r7]
