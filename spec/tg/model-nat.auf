y10: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ o ∊ imin u (dnf u M) tr_nat_D i c w P CV $ by and_elim_r [y8]
y11: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ i = ∅ ∧ x9 = c $ by nat_iminx_cases [y9]
y12: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ i = ∅ $ by and_elim_l [y11]
y13a: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ x9 = c $ by and_elim_r [y11]
y13b: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ c = x9 $ by eq_sym [y13a]
y13c: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ x9 = suc ∅ $ by weaken [y1]
y13: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ c = suc ∅ $ by eq_trans [y13b, y13c]
v1: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ uadm u $ by weaken [#1]
v2: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ w ∊ lvals $ by weaken [#2]
v3: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ P = ∅ $ by weaken [#3]
v4: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ CV = scons m ∅ $ by weaken [#4]
v5: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by weaken [#5]
v6: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ n ∊ imins u (dnf u M) tr_nat_D w P CV $ by weaken [#6]
y14: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV ⇒ o ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by e4_imin1_elim [v1, v2, v3, y12, y13, v4, v5, y10]
yq: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , ∃ c (iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV) ⇒ ∃ c (iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV) $ by ax
y15a: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j , ∃ c (iminx tr_nat_D i c x9 ∧ o ∊ imin u (dnf u M) tr_nat_D i c w P CV) ⇒ o ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by ex_elim [yq, y14]
y15: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j ⇒ o ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by ex_elim [y7, y15a]
w1: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j ⇒ x5 ∊ ap m nzr ∧ o ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by and_intro [z15, y15]
w2: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j ⇒ n = scons o (scons x5 ∅) ∧ x5 ∊ ap m nzr ∧ o ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by and_intro [p3, w1]
w3: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j ⇒ ∃ b (n = scons o (scons b ∅) ∧ b ∊ ap m nzr ∧ o ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $ by ex_intro [w2]
w4: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j ⇒ ∃ a ∃ b (n = scons a (scons b ∅) ∧ b ∊ ap m nzr ∧ a ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $ by ex_intro [w3]
xa1: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , ∃ j (j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j) ⇒ ∃ j (j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j) $ by ax
xb1: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l , ∃ j (j ∊ fseq u ∧ cdm j = x8 ∧ l = scons x5 j) ⇒ ∃ a ∃ b (n = scons a (scons b ∅) ∧ b ∊ ap m nzr ∧ a ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $ by ex_elim [xa1, w4]
xz: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ ∃ a ∃ b (n = scons a (scons b ∅) ∧ b ∊ ap m nzr ∧ a ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $ by ex_elim [f3, xb1]
za1: $ G , x8 = ∅ , x9 = suc ∅ , ∃ l (l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l) ⇒ ∃ l (l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l) $ by ax
zb1: $ G , x8 = ∅ , x9 = suc ∅ , ∃ l (l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l) ⇒ ∃ a ∃ b (n = scons a (scons b ∅) ∧ b ∊ ap m nzr ∧ a ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $ by ex_elim [za1, xz]
zz: $ G , x8 = ∅ , x9 = suc ∅ ⇒ ∃ a ∃ b (n = scons a (scons b ∅) ∧ b ∊ ap m nzr ∧ a ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $ by ex_elim [e4, zb1]
zz2: $ G , x8 = ∅ ⇒ ∃ a ∃ b (n = scons a (scons b ∅) ∧ b ∊ ap m nzr ∧ a ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $ by isset_elim [l5, zz]
zz3: $ G ⇒ ∃ a ∃ b (n = scons a (scons b ∅) ∧ b ∊ ap m nzr ∧ a ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $ by isset_elim [l5a, zz2]

lemma e4_seq4 (G: hyps) (u j f n m p k a b c: set):
  $ G ⇒ f = ∅ $ > $ G ⇒ p = ∅ $ > $ G ⇒ n = scons c (scons b ∅) $ > $ G ⇒ m = scons a ∅ $ >
  $ G ⇒ n ∊ fseq u $ > $ G ⇒ m ∊ fseq u $ > $ G ⇒ j ∊ u $ >
  $ G ⇒ nest (scat (scons j f) (scat n (scat m p))) k = ⟨ a , ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ ⟩ $
----
l1r: $ G ⇒ m = m $ by eq_refl
l1a: $ G ⇒ scat m p = scat m ∅ $ by scat_eq [l1r, #2]
l1b: $ G ⇒ scat m ∅ = m $ by scat_empty_r
l1: $ G ⇒ scat m p = m $ by eq_trans [l1a, l1b]
l2r: $ G ⇒ n = n $ by eq_refl
l2: $ G ⇒ scat n (scat m p) = scat n m $ by scat_eq [l2r, l1]
l3a: $ G ⇒ j ∈ u $ by welc_wcel [#7]
l3b: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l3c: $ G ⇒ ∅ = f $ by eq_sym [#1]
l3d: $ G ⇒ f ∈ fseq u $ by wcel_eq_l [l3c, l3b]
l3: $ G ⇒ scons j f ∈ fseq u $ by scons_fseq_c [l3a, l3d]
l4: $ G ⇒ scat n m ∈ fseq u $ by scat_fseq [#5, #6]
l4a: $ G ⇒ scat n m = scat n (scat m p) $ by eq_sym [l2]
l4b: $ G ⇒ scat n (scat m p) ∈ fseq u $ by wcel_eq_l [l4a, l4]
l5i: $ G ⇒ isset k $ by isset_var
q0: $ G ⇒ isset (scons j f) $ by wcel_isset [l3]
q1a: $ G , x1 = scons j f ⇒ scat n (scat m p) ∈ fseq u $ by weaken [l4b]
q1: $ G , x1 = scons j f ⇒ isset (scat n (scat m p)) $ by wcel_isset [q1a]
c1: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ x1 = scons j f $ by ax
c2: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ x2 = scat n (scat m p) $ by ax
c3a: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ scons j f = x1 $ by eq_sym [c1]
c3b: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ scons j f ∈ fseq u $ by weaken [l3]
c3c: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ x1 ∈ fseq u $ by wcel_eq_l [c3a, c3b]
c3: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ x1 ∊ fseq u $ by wcel_welc [c3c]
c4a: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ scat n (scat m p) = x2 $ by eq_sym [c2]
c4b: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ scat n (scat m p) ∈ fseq u $ by weaken [l4b]
c4c: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ x2 ∈ fseq u $ by wcel_eq_l [c4a, c4b]
c4: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ x2 ∊ fseq u $ by wcel_welc [c4c]
c5i: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ isset k $ by isset_var
c5: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scat x1 x2) k = nest x2 (nest x1 k) $ by nest_scat [c3, c4, c5i]
c6r: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ k = k $ by eq_refl
c6a: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ scat (scons j f) (scat n (scat m p)) = scat x1 x2 $ by scat_eq [c3a, c4a]
c6: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scat (scons j f) (scat n (scat m p))) k = nest (scat x1 x2) k $ by nest_eq [c6a, c6r]
d1a: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ f = ∅ $ by weaken [#1]
d1r: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ j = j $ by eq_refl
d1b: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ scons j f = scons j ∅ $ by scons_eq [d1r, d1a]
d1c: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ x1 = scons j ∅ $ by eq_trans [c1, d1b]
d1d: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest x1 k = nest (scons j ∅) k $ by nest_eq [d1c, c6r]
d1i: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ isset j $ by isset_var
d1e: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scons j ∅) k = ⟨ j , k ⟩ $ by nest_one [d1i, c5i]
d1: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest x1 k = ⟨ j , k ⟩ $ by eq_trans [d1d, d1e]
d2b: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ scat n (scat m p) = scat n m $ by weaken [l2]
d2a: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ x2 = scat n m $ by eq_trans [c2, d2b]
d2c: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest x2 (nest x1 k) = nest (scat n m) ⟨ j , k ⟩ $ by nest_eq [d2a, d1]
d2d: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ n ∊ fseq u $ by weaken [#5]
d2e: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ m ∊ fseq u $ by weaken [#6]
d2f: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ isset ⟨ j , k ⟩ $ by opair_isset
d2g: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scat n m) ⟨ j , k ⟩ = nest m (nest n ⟨ j , k ⟩) $ by nest_scat [d2d, d2e, d2f]
d3a: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ n = scons c (scons b ∅) $ by weaken [#3]
d3r: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ ⟨ j , k ⟩ = ⟨ j , k ⟩ $ by eq_refl
d3b: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest n ⟨ j , k ⟩ = nest (scons c (scons b ∅)) ⟨ j , k ⟩ $ by nest_eq [d3a, d3r]
d3i: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ isset c $ by isset_var
d3j: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ isset b $ by isset_var
d3c: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scons c (scons b ∅)) ⟨ j , k ⟩ = ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ $ by nest_two [d3i, d3j, d2f]
d3: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest n ⟨ j , k ⟩ = ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ $ by eq_trans [d3b, d3c]
d4a: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ m = scons a ∅ $ by weaken [#4]
d4b: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest m (nest n ⟨ j , k ⟩) = nest (scons a ∅) ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ $ by nest_eq [d4a, d3]
d4i: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ isset a $ by isset_var
d4j: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ isset ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ $ by opair_isset
d4c: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scons a ∅) ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ = ⟨ a , ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ ⟩ $ by nest_one [d4i, d4j]
e1: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scat (scons j f) (scat n (scat m p))) k = nest x2 (nest x1 k) $ by eq_trans [c6, c5]
e2: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scat (scons j f) (scat n (scat m p))) k = nest (scat n m) ⟨ j , k ⟩ $ by eq_trans [e1, d2c]
e3: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scat (scons j f) (scat n (scat m p))) k = nest m (nest n ⟨ j , k ⟩) $ by eq_trans [e2, d2g]
e4: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scat (scons j f) (scat n (scat m p))) k = nest (scons a ∅) ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ $ by eq_trans [e3, d4b]
e5: $ G , x1 = scons j f , x2 = scat n (scat m p) ⇒ nest (scat (scons j f) (scat n (scat m p))) k = ⟨ a , ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ ⟩ $ by eq_trans [e4, d4c]
e6: $ G , x1 = scons j f ⇒ nest (scat (scons j f) (scat n (scat m p))) k = ⟨ a , ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ ⟩ $ by isset_elim [q1, e5]
e7: $ G ⇒ nest (scat (scons j f) (scat n (scat m p))) k = ⟨ a , ⟨ b , ⟨ c , ⟨ j , k ⟩ ⟩ ⟩ ⟩ $ by isset_elim [q0, e6]

--| The points of the recursor at Nat: over a motive, minors in their spaces,
--| and an element of Nat, with the fold's values.
lemma e4_irc_pts {x y h a b c d g: set} (G: hyps) (M V: class) (u w pt: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ V ∈ ω $ > $ G ⇒ pt ∊ irc u (dnf u M) tr_nat_D ∅ V w $ > $ G ⇒ ∃ a ∃ b ∃ c ∃ d ∃ g (a ∊ cpi x nnat (fv uni V) ∧ b ∊ ap a nzr ∧ c ∊ cpi y nnat (cpi h (ap a y) (ap a (nsc y))) ∧ d ∊ nnat ∧ g ∊ fv (ifold u (dnf u M) tr_nat_D w ∅ (scons c (scons b ∅))) ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ∧ pt = ⟨ a , ⟨ b , ⟨ c , ⟨ d , g ⟩ ⟩ ⟩ ⟩) $
----
g1: $ G , iprt tr_nat_D q x2 , p ∊ esat u (dnf u M) q w , m ∊ imots u (dnf u M) tr_nat_D w p V , n ∊ imins u (dnf u M) tr_nat_D w p m , ityf tr_nat_D ∅ o , ⟨ f , ⟨ l , ⟨ t , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w p , j ∊ apn (ity u (dnf u M) tr_nat_D ∅ w) (scat f p) , k ∊ fv (ifold u (dnf u M) tr_nat_D w p n) ⟨ ∅ , ⟨ scat f p , j ⟩ ⟩ , pt = nest (scat (scons j f) (scat n (scat m p))) k ⇒ uadm u $ by weaken [#1]
