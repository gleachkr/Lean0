u6d: $ G , x ∊ nnat , x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} , v = nsc x ⇒ ⟨ ∅ , nsc x ⟩ = ⟨ ∅ , v ⟩ $ by opair_eq [u6a, u6c]
u6e: $ G , x ∊ nnat , x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} , v = nsc x ⇒ ⟨ ∅ , ⟨ ∅ , nsc x ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , v ⟩ ⟩ $ by opair_eq [u6a, u6d]
u6f: $ G , x ∊ nnat , x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} , v = nsc x ⇒ ⟨ ∅ , ⟨ ∅ , nsc x ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w $ by weaken [u5]
u6: $ G , x ∊ nnat , x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} , v = nsc x ⇒ ⟨ ∅ , ⟨ ∅ , v ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w $ by wcel_eq_l [u6e, u6f]
u7b: $ G , x ∊ nnat , x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} ⇒ isset (nsc x) $ by nsc_set
u7: $ G , x ∊ nnat , x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} ⇒ nsc x ∈ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} $ by wcel_cab_intro (x := $ y $, z := $ v $, p := $ ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w $) [u7b, u6]
u8: $ G , x ∊ nnat ⇒ x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} → nsc x ∈ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} $ by imp_intro [u7]
u9: $ G ⇒ x ∊ nnat → x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} → nsc x ∈ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} $ by imp_intro [u8]
u10: $ G ⇒ ∀ x (x ∊ nnat → x ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} → nsc x ∈ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w}) $ by all_intro [u9]
u11: $ G ⇒ nnat ⊆ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} $ by nnat_ind [t4, u10]
v1: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ t ∊ nnat $ by ax
v2a: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ nnat ⊆ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} $ by weaken [u11]
v2: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ t ∊ {y | ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w} $ by subset_elim [v2a, v1]
v3: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ ⟨ ∅ , ⟨ ∅ , t ⟩ ⟩ ∈ ifam u (dnf u M) tr_nat_D w $ by cab_elim [v2]
v4a: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ a ∊ csn ∅ $ by ax
v4: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ a = ∅ $ by csn_elim [v4a]
v5a: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ c ∊ csn ∅ $ by ax
v5: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ c = ∅ $ by csn_elim [v5a]
v6a: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ b = ⟨ c , t ⟩ $ by ax
v6b: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ t = t $ by eq_refl
v6c: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ ⟨ c , t ⟩ = ⟨ ∅ , t ⟩ $ by opair_eq [v5, v6b]
v6d: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ b = ⟨ ∅ , t ⟩ $ by eq_trans [v6a, v6c]
v6e: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ ⟨ a , b ⟩ = ⟨ ∅ , ⟨ ∅ , t ⟩ ⟩ $ by opair_eq [v4, v6d]
v6f: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ v = ⟨ a , b ⟩ $ by ax
v6: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ v = ⟨ ∅ , ⟨ ∅ , t ⟩ ⟩ $ by eq_trans [v6f, v6e]
v7a: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ ⟨ ∅ , ⟨ ∅ , t ⟩ ⟩ = v $ by eq_sym [v6]
v7b: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ v ∈ ifam u (dnf u M) tr_nat_D w $ by wcel_eq_l [v7a, v3]
v7: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat , b = ⟨ c , t ⟩ , c ∊ csn ∅ , t ∊ nnat ⇒ v ∊ ifam u (dnf u M) tr_nat_D w $ by wcel_welc [v7b]
