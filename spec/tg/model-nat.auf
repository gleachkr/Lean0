lemma e4_lv2 {x6 z k y h: set} (G: hyps) (M V: class) (u w p: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ V ∈ ω $ > $ G ⇒ p ∊ cpi x6 nnat (fv uni V) $ >
  $ G ⇒ ap (irc u (dnf u M) tr_nat_D ∅ V w) p ∈ cpi z (ap p nzr) (cpi k (cpi y nnat (cpi h (ap p y) (ap p (nsc y)))) (cpi y nnat (ap p y))) $
