lemma e2_nctor_C (G: hyps) (t m k: set): $ G ⇒ t = e2_C $ > $ G ⇒ ra_nth_ctor t m k ∈ lrel $ > $ G ⇒ (m = e2_N0 ∧ k = tn_K0) ∨ (m = e2_N1 ∧ k = tn_K1) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by lrel_nth_ctor_cases [#2]
l2: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by ax
l3: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = e2_C $ by weaken [#1]
l5: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ e2_C = t $ by eq_sym [l4]
l6: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ ⟨ kc_ccons , scons tn_K0 (scons e2_C1 ∅) ⟩ = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by eq_trans [l5, l3]
l7: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ isset kc_ccons $ by e2_is_kc_ccons
l8: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ isset tn_K0 $ by e2_is_K0
l9: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ isset e2_C1 $ by e2_is_C1
l10: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ tn_K0 = x1 ∧ e2_C1 = x2 $ by node2_inj_c [l7, l8, l9, l6]
l11: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ tn_K0 = x1 $ by and_elim_l [l10]
l12: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by ax
l13: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by and_elim_r [l12]
l14: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ m = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l13]
