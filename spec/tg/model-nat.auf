l15: $ G , ityf tr_nat_D J f , ra_isort f k l ∈ lrel , lv l W = ∅ , w = W , w ∊ lvals ⇒ lv ⟨ kc_lz , ∅ ⟩ w = ∅ $ by lv_lz
l16: $ G , ityf tr_nat_D J f , ra_isort f k l ∈ lrel , lv l W = ∅ , w = W , w ∊ lvals ⇒ suc (lv ⟨ kc_lz , ∅ ⟩ w) = suc ∅ $ by suc_eq [l15]
l17: $ G , ityf tr_nat_D J f , ra_isort f k l ∈ lrel , lv l W = ∅ , w = W , w ∊ lvals ⇒ lv e2_L w = suc ∅ $ by eq_trans [l14, l16]
