w3: $ G , k ∊ dt u (mcv H) (enc_expr (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))))) W (scons z (scons m R)) ⇒ W ∈ lvals $ by weaken [#3]
w4: $ G , k ∊ dt u (mcv H) (enc_expr (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))))) W (scons z (scons m R)) ⇒ scons z (scons m R) ∈ fseq u $ by weaken [#4]
w5: $ G , k ∊ dt u (mcv H) (enc_expr (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))))) W (scons z (scons m R)) ⇒ isset R $ by weaken [#5]
q1: $ G , k ∊ dt u (mcv H) (enc_expr (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))))) W (scons z (scons m R)) ⇒ k ∊ dt u (mcv H) (enc_expr (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))))) W (scons z (scons m R)) $ by ax
