----
l1: $ G ⇒ tn_K1 ∈ trees ω $ by tn_K1_trees
l2: $ G ⇒ isset tn_K1 $ by wcel_isset [l1]

lemma e2_is_D (G: hyps): $ G ⇒ isset tr_nat_D $
----
l1: $ G ⇒ tr_nat_D ∈ trees ω $ by tr_nat_D_trees
l2: $ G ⇒ isset tr_nat_D $ by wcel_isset [l1]

lemma e2_is_kc_tcons (G: hyps): $ G ⇒ isset kc_tcons $
----
l1: $ G ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
l2: $ G ⇒ isset kc_tcons $ by wcel_isset [l1]

lemma e2_is_kc_tnil (G: hyps): $ G ⇒ isset kc_tnil $
----
l1: $ G ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
l2: $ G ⇒ isset kc_tnil $ by wcel_isset [l1]

lemma e2_is_kc_ccons (G: hyps): $ G ⇒ isset kc_ccons $
----
l1: $ G ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
l2: $ G ⇒ isset kc_ccons $ by wcel_isset [l1]

lemma e2_is_kc_cnil (G: hyps): $ G ⇒ isset kc_cnil $
----
l1: $ G ⇒ kc_cnil ∈ ω $ by kc_cnil_omega
l2: $ G ⇒ isset kc_cnil $ by wcel_isset [l1]

lemma e2_is_kc_srt (G: hyps): $ G ⇒ isset kc_srt $
----
l1: $ G ⇒ kc_srt ∈ ω $ by kc_srt_omega
l2: $ G ⇒ isset kc_srt $ by wcel_isset [l1]

lemma e2_is_kc_pi (G: hyps): $ G ⇒ isset kc_pi $
----
l1: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
l2: $ G ⇒ isset kc_pi $ by wcel_isset [l1]

nat_iprt_det
------------
l1: $ G , q = tn_P , r = tn_T ⇒ q = tn_P $ by ax
l2: $ G , q = tn_P , r = tn_T ⇒ r = tn_T $ by ax
l3: $ G , q = tn_P , r = tn_T ⇒ tn_P = q $ by eq_sym [l1]
l4: $ G , q = tn_P , r = tn_T ⇒ tn_T = r $ by eq_sym [l2]
l5: $ G , q = tn_P , r = tn_T ⇒ tr_nat_D = tr_nat_D $ by eq_refl
l6: $ G , q = tn_P , r = tn_T ⇒ iprt tr_nat_D tn_P tn_T $ by nat_iprt
l7: $ G , q = tn_P , r = tn_T ⇒ iprt tr_nat_D q r $ by iprt_eq [l5, l3, l4, l6]
l8: $ G , q = tn_P , r = tn_T ⇒ iprt tr_nat_D p t $ by weaken [#1]
l9: $ G , q = tn_P , r = tn_T ⇒ p = q ∧ t = r $ by iprt_det [l8, l7]
l10: $ G , q = tn_P , r = tn_T ⇒ p = q $ by and_elim_l [l9]
l11: $ G , q = tn_P , r = tn_T ⇒ t = r $ by and_elim_r [l9]
l12: $ G , q = tn_P , r = tn_T ⇒ p = tn_P $ by eq_trans [l10, l1]
l13: $ G , q = tn_P , r = tn_T ⇒ t = tn_T $ by eq_trans [l11, l2]
l14: $ G , q = tn_P , r = tn_T ⇒ p = tn_P ∧ t = tn_T $ by and_intro [l12, l13]
l15: $ G ⇒ isset tn_P $ by e2_is_P
l16: $ G ⇒ isset tn_T $ by e2_is_T
l17: $ G , q = tn_P ⇒ p = tn_P ∧ t = tn_T $ by isset_elim [l16, l14]
l18: $ G ⇒ p = tn_P ∧ t = tn_T $ by isset_elim [l15, l17]

lemma e2_tnil_tcons (G: hyps) (S T: class): $ G ⇒ ⟨ kc_tnil , S ⟩ = ⟨ kc_tcons , T ⟩ $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ isset kc_tnil $ by e2_is_kc_tnil
l2: $ G ⇒ isset kc_tcons $ by e2_is_kc_tcons
l3: $ G ⇒ kc_tnil = kc_tcons $ by opair_inj_l_c [#1, l1, l2]
l4: $ G ⇒ ¬ kc_tnil = kc_tcons $ by kc_tnil_ne_tcons
l5: $ G ⇒ ⊥ $ by not_elim [l4, l3]

lemma e2_cnil_ccons (G: hyps) (S T: class): $ G ⇒ ⟨ kc_cnil , S ⟩ = ⟨ kc_ccons , T ⟩ $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ isset kc_cnil $ by e2_is_kc_cnil
l2: $ G ⇒ isset kc_ccons $ by e2_is_kc_ccons
l3: $ G ⇒ kc_cnil = kc_ccons $ by opair_inj_l_c [#1, l1, l2]
l4: $ G ⇒ ¬ kc_cnil = kc_ccons $ by kc_cnil_ne_ccons
l5: $ G ⇒ ⊥ $ by not_elim [l4, l3]

lemma e2_srt_pi (G: hyps) (S T: class): $ G ⇒ ⟨ kc_srt , S ⟩ = ⟨ kc_pi , T ⟩ $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ isset kc_srt $ by e2_is_kc_srt
l2: $ G ⇒ isset kc_pi $ by e2_is_kc_pi
l3: $ G ⇒ kc_srt = kc_pi $ by opair_inj_l_c [#1, l1, l2]
l4: $ G ⇒ ¬ kc_srt = kc_pi $ by kc_srt_ne_pi
l5: $ G ⇒ ⊥ $ by not_elim [l4, l3]

lemma e2_nty_nil (G: hyps) (t i f c: set): $ G ⇒ t = e2_tnil $ > $ G ⇒ ra_nth_ty t i f c ∈ lrel $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) ∨ ∃ x1 ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by lrel_nth_ty_cases [#2]
l2: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 $ by ax
l3: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ t = e2_tnil $ by weaken [#1]
l5: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ e2_tnil = t $ by eq_sym [l4]
l6: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ $ by eq_trans [l5, l3]
l7: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ ⊥ $ by e2_tnil_tcons [l6]
l8: $ G , ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) ⇒ ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) $ by ax
l9: $ G , ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) ⇒ ⊥ $ by ex_elim [l8, l7]
l10: $ G , ∃ x2 ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) ⇒ ∃ x2 ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) $ by ax
l11: $ G , ∃ x2 ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) ⇒ ⊥ $ by ex_elim [l10, l9]
l12: $ G , ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) ⇒ ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) $ by ax
l13: $ G , ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) ⇒ ⊥ $ by ex_elim [l12, l11]
l14: $ G , t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel ⇒ t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel $ by ax
l15: $ G , t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel ⇒ t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ $ by and_elim_l [l14]
l16: $ G , t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel ⇒ t = e2_tnil $ by weaken [#1]
l17: $ G , t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel ⇒ e2_tnil = t $ by eq_sym [l16]
l18: $ G , t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ $ by eq_trans [l17, l15]
l19: $ G , t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel ⇒ ⊥ $ by e2_tnil_tcons [l18]
l20: $ G , ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by ax
l21: $ G , ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ⊥ $ by ex_elim [l20, l19]
l22: $ G , ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by ax
l23: $ G , ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ⊥ $ by ex_elim [l22, l21]
l24: $ G , ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by ax
l25: $ G , ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ⊥ $ by ex_elim [l24, l23]
l26: $ G , ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by ax
l27: $ G , ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ⊥ $ by ex_elim [l26, l25]
l28: $ G , ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by ax
l29: $ G , ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ⊥ $ by ex_elim [l28, l27]
l30: $ G , ∃ x1 ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ∃ x1 ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by ax
l31: $ G , ∃ x1 ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) ⇒ ⊥ $ by ex_elim [l30, l29]
l32: $ G ⇒ ⊥ $ by or_elim [l1, l13, l31]

lemma e2_nty_T (G: hyps) (t n f c: set): $ G ⇒ t = tn_T $ > $ G ⇒ ra_nth_ty t n f c ∈ lrel $ > $ G ⇒ n = e2_N0 ∧ f = tn_F ∧ c = e2_C $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2) ∨ ∃ x1 ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_s , scons x6 ∅ ⟩ ∧ f = x1 ∧ c = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by lrel_nth_ty_cases [#2]
l2: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 $ by ax
l3: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ t = tn_T $ by weaken [#1]
l5: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ tn_T = t $ by eq_sym [l4]
l6: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ ⟨ kc_tcons , scons tn_F (scons e2_C (scons e2_tnil ∅)) ⟩ = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ $ by eq_trans [l5, l3]
l7: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ isset kc_tcons $ by e2_is_kc_tcons
l8: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ isset tn_F $ by e2_is_F
l9: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ isset e2_C $ by e2_is_C
l10: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ isset e2_tnil $ by e2_is_tnil
l11: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ tn_F = x1 ∧ e2_C = x2 ∧ e2_tnil = x3 $ by node3_inj_c [l7, l8, l9, l10, l6]
l12: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ tn_F = x1 $ by and_elim_l [l11]
l13: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ c = x2 ⇒ e2_C = x2 ∧ e2_tnil = x3 $ by and_elim_r [l11]
