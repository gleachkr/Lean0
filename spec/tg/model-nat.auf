c2: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z $ by and_elim_l [c1]
c3: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ (iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x) $ by and_elim_r [c1]
c4a: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ Z ⊆ csn ∅ × (csn ∅ × nnat) $ by weaken [#2]
c4: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ csn ∅ × (csn ∅ × nnat) $ by wcel_subset [c4a, c2]
c5a: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ isset ∅ $ by ax_empty
c5b: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ isset ⟨ a , x ⟩ $ by opair_isset
c5: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ ∅ ∈ csn ∅ ∧ ⟨ a , x ⟩ ∈ csn ∅ × nnat $ by cxp_elim_pair_c [c4, c5a, c5b]
c6: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ ⟨ a , x ⟩ ∈ csn ∅ × nnat $ by and_elim_r [c5]
c7: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ a ∊ csn ∅ ∧ x ∊ nnat $ by cxp_elim_pair [c6]
c8a: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) ⇒ a ∊ csn ∅ $ by and_elim_l [c7]
