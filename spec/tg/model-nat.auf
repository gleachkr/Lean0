b11a: $ G ⇒ ixs tr_nat_D w Z = ixs tr_nat_D w Z $ by eq_refl
b11: $ G ⇒ scat p (ixs tr_nat_D w Z) = scat ∅ (ixs tr_nat_D w Z) $ by scat_eq [b9, b11a]
b12: $ G ⇒ scat ∅ (ixs tr_nat_D w Z) = ixs tr_nat_D w Z $ by scat_empty_l_c [b10]
b13: $ G ⇒ scat p (ixs tr_nat_D w Z) = ixs tr_nat_D w Z $ by eq_trans [b11, b12]
b14: $ G ⇒ j = ∅ ∧ ((c = ∅ ∧ k = tn_K0) ∨ (c = suc ∅ ∧ k = tn_K1)) $ by nat_ictk_cases [#7]
b15: $ G ⇒ j = ∅ $ by and_elim_l [b14]
b16: $ G ⇒ (c = ∅ ∧ k = tn_K0) ∨ (c = suc ∅ ∧ k = tn_K1) $ by and_elim_r [b14]
b17: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
b18: $ G ⇒ etf u (dnf u M) = etf u (dnf u M) $ by eq_refl
A0: $ G , c = ∅ ∧ k = tn_K0 ⇒ c = ∅ ∧ k = tn_K0 $ by ax
