lemma e4_imin0_elim (G: hyps) (M I C P CV: class) (u w m z: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = ∅ $ > $ G ⇒ CV = scons m ∅ $ >
  $ G ⇒ z ∊ imin u (dnf u M) tr_nat_D I C w P CV $ > $ G ⇒ z ∊ ap m nzr $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
g1: $ G , e = ∅ ⇒ uadm u $ by weaken [#1]
g2: $ G , e = ∅ ⇒ w ∊ lvals $ by weaken [#2]
g3: $ G , e = ∅ ⇒ P = ∅ $ by weaken [#3]
g4: $ G , e = ∅ ⇒ I = ∅ $ by weaken [#4]
g5: $ G , e = ∅ ⇒ C = ∅ $ by weaken [#5]
g6: $ G , e = ∅ ⇒ CV = scons m ∅ $ by weaken [#6]
g7: $ G , e = ∅ ⇒ z ∊ imin u (dnf u M) tr_nat_D I C w P CV $ by weaken [#7]
g8: $ G , e = ∅ ⇒ e = ∅ $ by ax
g9: $ G , e = ∅ ⇒ e ∊ iminq u (dnf u M) tr_nat_D I C w P CV $ by e4_iminq0_intro [g1, g2, g3, g4, g5, g8]
g10: $ G , e = ∅ ⇒ z ∊ fpi q (iminq u (dnf u M) tr_nat_D I C w P CV) {y | ∃ d ∃ f ∃ g ∃ t ∃ a ∃ h (ictk tr_nat_D I C d ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∧ h ∊ ihv tr_nat_D d (imrel tr_nat_D CV) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))))} $ by weaken [g7]
g11: $ G , e = ∅ ⇒ apn z e ∈ {y | ∃ d ∃ f ∃ g ∃ t ∃ a ∃ h (ictk tr_nat_D I C d ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∧ h ∊ ihv tr_nat_D d (imrel tr_nat_D CV) g t (cdm f) ∧ e = scat h f ∧ y ∊ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))))} $ by fpi_ap [g10, g9]
g12r: $ G , e = ∅ ⇒ z = z $ by eq_refl
g12a: $ G , e = ∅ ⇒ apn z e = apn z ∅ $ by apn_eq [g12r, g8]
g12b: $ G , e = ∅ ⇒ apn z ∅ = z $ by apn_empty
g12: $ G , e = ∅ ⇒ apn z e = z $ by eq_trans [g12a, g12b]
