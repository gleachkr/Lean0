B3: $ G , c = suc ∅ ∧ k = tn_K1 ⇒ etel u (dnf u M) k w (scat p (ixs tr_nat_D w Z)) = etel u (dnf u M) tn_K1 w (ixs tr_nat_D w Z) $ by da_eq [B3a, Bw4, Bw13]
B4: $ G , c = suc ∅ ∧ k = tn_K1 ⇒ etel u (dnf u M) tn_K1 w (ixs tr_nat_D w Z) = nk1p u (ixs tr_nat_D w Z) $ by nat_etel_K1 [Bw17, Bw10]
B5: $ G , c = suc ∅ ∧ k = tn_K1 ⇒ etel u (dnf u M) k w (scat p (ixs tr_nat_D w Z)) = nk1p u (ixs tr_nat_D w Z) $ by eq_trans [B3, B4]
