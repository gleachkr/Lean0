lemma e3_iop0_elim {y: set} (G: hyps) (M Z: class) (u w z: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ z ∊ iop0 u (dnf u M) tr_nat_D w Z $ > $ G ⇒ z = ⟨ ∅ , ⟨ ∅ , nzr ⟩ ⟩ ∨ ∃ y (y ∊ ient tr_nat_D w Z ∅ ∧ z = ⟨ ∅ , ⟨ ∅ , nsc y ⟩ ⟩) $
----
i0: $ G , iprt tr_nat_D q e ∧ p ∊ esat u (dnf u M) q w ∧ ictk tr_nat_D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) k w (scat p (ixs tr_nat_D w Z)) ∧ a ∊ fseq u ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ iprt tr_nat_D q e ∧ p ∊ esat u (dnf u M) q w ∧ ictk tr_nat_D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) k w (scat p (ixs tr_nat_D w Z)) ∧ a ∊ fseq u ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ $ by ax
