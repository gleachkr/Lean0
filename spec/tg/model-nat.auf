p6: $ G ⇒ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) = ap m nzr $ by eq_trans [p2, p5]
w1: $ G , z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) ⇒ hind H $ by weaken [#1]
w2: $ G , z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) ⇒ uadm u $ by weaken [#2]
w3: $ G , z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) ⇒ W ∈ lvals $ by weaken [#3]
w4: $ G , z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) ⇒ scons m R ∈ fseq u $ by weaken [#4]
w5: $ G , z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) ⇒ isset R $ by weaken [#5]
q1: $ G , z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) ⇒ z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) $ by ax
q2: $ G , z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) ⇒ scons z (scons m R) ∈ fseq u $ by dt_scons_fseq [w2, w3, w4, q1]
q3: $ G , z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) ⇒ dt u (mcv H) (enc_expr (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))) W (scons z (scons m R)) = cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)) $ by e5_rt_B2 [w1, w2, w3, q2, w5]
r1: $ G ⇒ z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) → dt u (mcv H) (enc_expr (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))) W (scons z (scons m R)) = cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)) $ by imp_intro [q3]
r2: $ G ⇒ ∀ z (z ∊ dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R) → dt u (mcv H) (enc_expr (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))) W (scons z (scons m R)) = cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y))) $ by all_intro [r1]
r3: $ G ⇒ cpi z (dt u (mcv H) (enc_expr (app (bvar nz) nat_zero)) W (scons m R)) (dt u (mcv H) (enc_expr (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))) W (scons z (scons m R))) = cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y))) $ by cpi_eq_pt [p6, r2]
r4: $ G ⇒ dt u (mcv H) (enc_expr (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz)))))) W (scons m R) = cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y))) $ by eq_trans [p1, r3]

lemma e5_rec_ty {m x z k y h: set} (G: hyps) (H W R: class) (v: lvl) (u: set): $ G ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u (mcv H) (enc_expr (pi (pi nat_ty (srt v)) (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))))) W R = cpi m (cpi x nnat (fv uni (lv (enc_lvl v) W))) (cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)))) $
----
t1: $ G ⇒ enc_expr (pi nat_ty (srt v)) ∈ trees ω $ by enc_expr_trees
t2: $ G ⇒ enc_expr (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))) ∈ trees ω $ by enc_expr_trees
p1: $ G ⇒ dt u (mcv H) (enc_expr (pi (pi nat_ty (srt v)) (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))))) W R = cpi m (dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R) (dt u (mcv H) (enc_expr (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz)))))) W (scons m R)) $ by dt_pi_c [t1, t2, #3, #4]
t3: $ G ⇒ enc_expr nat_ty ∈ trees ω $ by enc_expr_trees
t4: $ G ⇒ enc_expr (srt v) ∈ trees ω $ by enc_expr_trees
p2: $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R = cpi x (dt u (mcv H) (enc_expr nat_ty) W R) (dt u (mcv H) (enc_expr (srt v)) W (scons x R)) $ by dt_pi_c [t3, t4, #3, #4]
p3: $ G ⇒ dt u (mcv H) (enc_expr nat_ty) W R = nnat $ by dt_nat_ty [#1, #2, #3, #4]
w1: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ hind H $ by weaken [#1]
w2: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ uadm u $ by weaken [#2]
w3: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ W ∈ lvals $ by weaken [#3]
w4: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ R ∈ fseq u $ by weaken [#4]
q1: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ x ∊ dt u (mcv H) (enc_expr nat_ty) W R $ by ax
q2: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ scons x R ∈ fseq u $ by dt_scons_fseq [w2, w3, w4, q1]
q3: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ enc_lvl v ∈ trees ω $ by enc_lvl_trees
q4: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ dt u (mcv H) (enc_expr (srt v)) W (scons x R) = fv uni (lv (enc_lvl v) W) $ by dt_srt_c [q3, w3, q2]
r1: $ G ⇒ x ∊ dt u (mcv H) (enc_expr nat_ty) W R → dt u (mcv H) (enc_expr (srt v)) W (scons x R) = fv uni (lv (enc_lvl v) W) $ by imp_intro [q4]
r2: $ G ⇒ ∀ x (x ∊ dt u (mcv H) (enc_expr nat_ty) W R → dt u (mcv H) (enc_expr (srt v)) W (scons x R) = fv uni (lv (enc_lvl v) W)) $ by all_intro [r1]
r3: $ G ⇒ cpi x (dt u (mcv H) (enc_expr nat_ty) W R) (dt u (mcv H) (enc_expr (srt v)) W (scons x R)) = cpi x nnat (fv uni (lv (enc_lvl v) W)) $ by cpi_eq_pt [p3, r2]
r4: $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R = cpi x nnat (fv uni (lv (enc_lvl v) W)) $ by eq_trans [p2, r3]
s0a: $ G , m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R ⇒ hind H $ by weaken [#1]
s0b: $ G , m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R ⇒ uadm u $ by weaken [#2]
s0c: $ G , m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R ⇒ W ∈ lvals $ by weaken [#3]
s0d: $ G , m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R ⇒ R ∈ fseq u $ by weaken [#4]
s1: $ G , m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R ⇒ m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R $ by ax
s2: $ G , m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R ⇒ scons m R ∈ fseq u $ by dt_scons_fseq [s0b, s0c, s0d, s1]
s3: $ G , m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R ⇒ isset R $ by wcel_isset [s0d]
s4: $ G , m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R ⇒ dt u (mcv H) (enc_expr (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz)))))) W (scons m R) = cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y))) $ by e5_rt_B1 [s0a, s0b, s0c, s2, s3]
u1: $ G ⇒ m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R → dt u (mcv H) (enc_expr (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz)))))) W (scons m R) = cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y))) $ by imp_intro [s4]
u2: $ G ⇒ ∀ m (m ∊ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R → dt u (mcv H) (enc_expr (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz)))))) W (scons m R) = cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)))) $ by all_intro [u1]
u3: $ G ⇒ cpi m (dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R) (dt u (mcv H) (enc_expr (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz)))))) W (scons m R)) = cpi m (cpi x nnat (fv uni (lv (enc_lvl v) W))) (cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)))) $ by cpi_eq_pt [r4, u2]
u4: $ G ⇒ dt u (mcv H) (enc_expr (pi (pi nat_ty (srt v)) (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))))) W R = cpi m (cpi x nnat (fv uni (lv (enc_lvl v) W))) (cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)))) $ by eq_trans [p1, u3]

dt_nat_rec
----------
a1: $ G ⇒ hrec ⊆ H $ by hind_hrec [#1]
a2: $ G ⇒ functional H $ by hind_functional [#1]
a3: $ G ⇒ tr_nat_D ∈ trees ω $ by tr_nat_D_trees
a4: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
a4b: $ G ⇒ enc_lvl v ∈ trees ω $ by enc_lvl_trees
a5: $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ (scons (enc_lvl v) ∅)) ⟩ W R = mclip u (irc u (dnf u (mcv H)) tr_nat_D (fv nvf ⟨ kc_nz , ∅ ⟩) (lv (enc_lvl v) W) W) $ by dt_ind_rec_c [a1, a2, a3, a4, a4b, #3, #4]
b0: $ G ⇒ tr_nat_D = tr_nat_D $ by eq_refl
b1: $ G ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
b2: $ G ⇒ lv (enc_lvl v) W = lv (enc_lvl v) W $ by eq_refl
b3: $ G ⇒ W = W $ by eq_refl
b4: $ G ⇒ irc u (dnf u (mcv H)) tr_nat_D (fv nvf ⟨ kc_nz , ∅ ⟩) (lv (enc_lvl v) W) W = irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W $ by irc_eq [b0, b1, b2, b3]
c0: $ G ⇒ u = u $ by eq_refl
c1: $ G ⇒ mclip u (irc u (dnf u (mcv H)) tr_nat_D (fv nvf ⟨ kc_nz , ∅ ⟩) (lv (enc_lvl v) W) W) = mclip u (irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W) $ by mclip_eq [c0, b4]
d1: $ G , w = W , w ∊ lvals ⇒ uadm u $ by weaken [#2]
d2: $ G , w = W , w ∊ lvals ⇒ w ∊ lvals $ by ax
d3: $ G , w = W , w ∊ lvals ⇒ w ∈ lvals $ by welc_wcel [d2]
d4: $ G , w = W , w ∊ lvals ⇒ R ∈ fseq u $ by weaken [#4]
d5: $ G , w = W , w ∊ lvals ⇒ hind H $ by weaken [#1]
d6b: $ G , w = W , w ∊ lvals ⇒ enc_lvl v ∈ trees ω $ by weaken [a4b]
d6a: $ G , w = W , w ∊ lvals ⇒ isset (enc_lvl v) $ by wcel_isset [d6b]
d6: $ G , w = W , w ∊ lvals ⇒ lv (enc_lvl v) w ∈ ω $ by lv_omega [d6a, d2]
d7: $ G , w = W , w ∊ lvals ⇒ irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) w) w ∈ cpi m (cpi x nnat (fv uni (lv (enc_lvl v) w))) (cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)))) $ by nat_irc_mem [d1, d2, d6]
d8: $ G , w = W , w ∊ lvals ⇒ dt u (mcv H) (enc_expr (pi (pi nat_ty (srt v)) (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))))) w R = cpi m (cpi x nnat (fv uni (lv (enc_lvl v) w))) (cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)))) $ by e5_rec_ty [d5, d1, d3, d4]
d9: $ G , w = W , w ∊ lvals ⇒ dt u (mcv H) (enc_expr (pi (pi nat_ty (srt v)) (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))))) w R ∈ u $ by den_in_u_c [d1, d3, d4]
d10: $ G , w = W , w ∊ lvals ⇒ cpi m (cpi x nnat (fv uni (lv (enc_lvl v) w))) (cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)))) ∈ u $ by wcel_eq_l [d8, d9]
d11: $ G , w = W , w ∊ lvals ⇒ universe u $ by uadm_universe [d1]
d12: $ G , w = W , w ∊ lvals ⇒ irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) w) w ∈ u $ by universe_elem_elem_c [d11, d10, d7]
d13: $ G , w = W , w ∊ lvals ⇒ w = W $ by ax
d14: $ G , w = W , w ∊ lvals ⇒ enc_lvl v = enc_lvl v $ by eq_refl
d15: $ G , w = W , w ∊ lvals ⇒ lv (enc_lvl v) w = lv (enc_lvl v) W $ by lv_eq [d14, d13]
d16: $ G , w = W , w ∊ lvals ⇒ tr_nat_D = tr_nat_D $ by eq_refl
d17: $ G , w = W , w ∊ lvals ⇒ ∅ = ∅ $ by eq_refl
d18: $ G , w = W , w ∊ lvals ⇒ irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) w) w = irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W $ by irc_eq [d16, d17, d15, d13]
d19: $ G , w = W , w ∊ lvals ⇒ irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W ∈ u $ by wcel_eq_l [d18, d12]
d20: $ G ⇒ irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W ∈ u $ by wcel_elim [#3, d19]
c2: $ G ⇒ mclip u (irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W) = irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W $ by mclip_in [d20]
c3: $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ (scons (enc_lvl v) ∅)) ⟩ W R = mclip u (irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W) $ by eq_trans [a5, c1]
c4: $ G ⇒ dt u (mcv H) (enc_expr (ind_rec nat_D nz v)) W R = irc u (dnf u (mcv H)) tr_nat_D ∅ (lv (enc_lvl v) W) W $ by eq_trans [c3, c2]

dt_nat_rec_ty
-------------
l1: $ G ⇒ dt u (mcv H) (enc_expr (pi (pi nat_ty (srt v)) (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))))) W R = cpi m (cpi x nnat (fv uni (lv (enc_lvl v) W))) (cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)))) $ by e5_rec_ty [#1, #2, #3, #4]

lemma e5_lift1 (G: hyps) (M W: class) (mo m1: expr) (u x r: set): $ lift n1 nz mo m1 $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ x ∈ u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ dt u M (enc_expr m1) W (scons x r) = dt u M (enc_expr mo) W r $
----
a1: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
a2: $ G ⇒ scons x ∅ ∈ fseq u $ by scons_fseq_c [#3, a1]
a3: $ G ⇒ cdm (scons x ∅) = suc ∅ $ by scons_empty_len
a4: $ G ⇒ fv nvf (enc_nat n1) = suc ∅ $ by nvf_n1
a4b: $ G ⇒ suc ∅ = fv nvf (enc_nat n1) $ by eq_sym [a4]
a5: $ G ⇒ cdm (scons x ∅) = fv nvf (enc_nat n1) $ by eq_trans [a3, a4b]
a6: $ G ⇒ r ∈ fseq u $ by welc_wcel [#4]
a7: $ G ⇒ dt u M (enc_expr m1) W (scat (scons x ∅) r) = dt u M (enc_expr mo) W r $ by lift0_den_c [#1, #2, a2, a5, a6]
a8: $ G ⇒ scat (scons x ∅) r = scons x r $ by scat_scons_empty [#4]
a8b: $ G ⇒ scons x r = scat (scons x ∅) r $ by eq_sym [a8]
ru: $ G ⇒ u = u $ by eq_refl
rM: $ G ⇒ M = M $ by eq_refl
re: $ G ⇒ enc_expr m1 = enc_expr m1 $ by eq_refl
rW: $ G ⇒ W = W $ by eq_refl
a9: $ G ⇒ dt u M (enc_expr m1) W (scons x r) = dt u M (enc_expr m1) W (scat (scons x ∅) r) $ by dt_eq [ru, rM, re, rW, a8b]
a10: $ G ⇒ dt u M (enc_expr m1) W (scons x r) = dt u M (enc_expr mo) W r $ by eq_trans [a9, a7]

lemma e5_lift2 (G: hyps) (M W: class) (mo m2: expr) (u h x r: set): $ lift n2 nz mo m2 $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ h ∈ u $ > $ G ⇒ x ∈ u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ dt u M (enc_expr m2) W (scons h (scons x r)) = dt u M (enc_expr mo) W r $
----
a1: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
a2: $ G ⇒ scons x ∅ ∈ fseq u $ by scons_fseq_c [#4, a1]
b1: $ G , q = scons x ∅ , q ∊ fseq u ⇒ q ∊ fseq u $ by ax
b1a: $ G , q = scons x ∅ , q ∊ fseq u ⇒ q = scons x ∅ $ by ax
b1b: $ G , q = scons x ∅ , q ∊ fseq u ⇒ q ∈ fseq u $ by welc_wcel [b1]
b1c: $ G , q = scons x ∅ , q ∊ fseq u ⇒ h ∈ u $ by weaken [#3]
b2: $ G , q = scons x ∅ , q ∊ fseq u ⇒ scons h q ∈ fseq u $ by scons_fseq_c [b1c, b1b]
b3: $ G , q = scons x ∅ , q ∊ fseq u ⇒ cdm (scons h q) = suc (cdm q) $ by scons_len [b1]
b4: $ G , q = scons x ∅ , q ∊ fseq u ⇒ cdm q = cdm (scons x ∅) $ by cdm_eq [b1a]
b5: $ G , q = scons x ∅ , q ∊ fseq u ⇒ cdm (scons x ∅) = suc ∅ $ by scons_empty_len
b6: $ G , q = scons x ∅ , q ∊ fseq u ⇒ cdm q = suc ∅ $ by eq_trans [b4, b5]
b7: $ G , q = scons x ∅ , q ∊ fseq u ⇒ suc (cdm q) = suc (suc ∅) $ by suc_eq [b6]
b8: $ G , q = scons x ∅ , q ∊ fseq u ⇒ cdm (scons h q) = suc (suc ∅) $ by eq_trans [b3, b7]
c1: $ G , q = scons x ∅ , q ∊ fseq u ⇒ enc_nat n1 ∈ trees ω $ by enc_nat_trees
c2: $ G , q = scons x ∅ , q ∊ fseq u ⇒ fv nvf (enc_nat n2) = suc (fv nvf (enc_nat n1)) $ by nvf_s [c1]
c3: $ G , q = scons x ∅ , q ∊ fseq u ⇒ fv nvf (enc_nat n1) = suc ∅ $ by nvf_n1
c4: $ G , q = scons x ∅ , q ∊ fseq u ⇒ suc (fv nvf (enc_nat n1)) = suc (suc ∅) $ by suc_eq [c3]
c5: $ G , q = scons x ∅ , q ∊ fseq u ⇒ fv nvf (enc_nat n2) = suc (suc ∅) $ by eq_trans [c2, c4]
c6: $ G , q = scons x ∅ , q ∊ fseq u ⇒ suc (suc ∅) = fv nvf (enc_nat n2) $ by eq_sym [c5]
c7: $ G , q = scons x ∅ , q ∊ fseq u ⇒ cdm (scons h q) = fv nvf (enc_nat n2) $ by eq_trans [b8, c6]
d0: $ G , q = scons x ∅ , q ∊ fseq u ⇒ W ∈ lvals $ by weaken [#2]
d0a: $ G , q = scons x ∅ , q ∊ fseq u ⇒ r ∊ fseq u $ by weaken [#5]
d0b: $ G , q = scons x ∅ , q ∊ fseq u ⇒ r ∈ fseq u $ by welc_wcel [d0a]
d1: $ G , q = scons x ∅ , q ∊ fseq u ⇒ dt u M (enc_expr m2) W (scat (scons h q) r) = dt u M (enc_expr mo) W r $ by lift0_den_c [#1, d0, b2, c7, d0b]
d2: $ G , q = scons x ∅ , q ∊ fseq u ⇒ scat (scons h q) r = scons h (scat q r) $ by scat_scons [b1, d0a]
rr: $ G , q = scons x ∅ , q ∊ fseq u ⇒ r = r $ by eq_refl
rh: $ G , q = scons x ∅ , q ∊ fseq u ⇒ h = h $ by eq_refl
d3: $ G , q = scons x ∅ , q ∊ fseq u ⇒ scat q r = scat (scons x ∅) r $ by scat_eq [b1a, rr]
d4: $ G , q = scons x ∅ , q ∊ fseq u ⇒ scat (scons x ∅) r = scons x r $ by scat_scons_empty [d0a]
d5: $ G , q = scons x ∅ , q ∊ fseq u ⇒ scat q r = scons x r $ by eq_trans [d3, d4]
d6: $ G , q = scons x ∅ , q ∊ fseq u ⇒ scons h (scat q r) = scons h (scons x r) $ by scons_eq [rh, d5]
d7: $ G , q = scons x ∅ , q ∊ fseq u ⇒ scat (scons h q) r = scons h (scons x r) $ by eq_trans [d2, d6]
d8: $ G , q = scons x ∅ , q ∊ fseq u ⇒ scons h (scons x r) = scat (scons h q) r $ by eq_sym [d7]
ru: $ G , q = scons x ∅ , q ∊ fseq u ⇒ u = u $ by eq_refl
rM: $ G , q = scons x ∅ , q ∊ fseq u ⇒ M = M $ by eq_refl
re: $ G , q = scons x ∅ , q ∊ fseq u ⇒ enc_expr m2 = enc_expr m2 $ by eq_refl
rW: $ G , q = scons x ∅ , q ∊ fseq u ⇒ W = W $ by eq_refl
d9: $ G , q = scons x ∅ , q ∊ fseq u ⇒ dt u M (enc_expr m2) W (scons h (scons x r)) = dt u M (enc_expr m2) W (scat (scons h q) r) $ by dt_eq [ru, rM, re, rW, d8]
d10: $ G , q = scons x ∅ , q ∊ fseq u ⇒ dt u M (enc_expr m2) W (scons h (scons x r)) = dt u M (enc_expr mo) W r $ by eq_trans [d9, d1]
d11: $ G ⇒ dt u M (enc_expr m2) W (scons h (scons x r)) = dt u M (enc_expr mo) W r $ by wcel_elim [a2, d10]

lemma e5_mo_ty {x: set} (G: hyps) (H W R: class) (v: lvl) (u: set): $ G ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R = cpi x nnat (fv uni (lv (enc_lvl v) W)) $
----
t3: $ G ⇒ enc_expr nat_ty ∈ trees ω $ by enc_expr_trees
t4: $ G ⇒ enc_expr (srt v) ∈ trees ω $ by enc_expr_trees
p2: $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R = cpi x (dt u (mcv H) (enc_expr nat_ty) W R) (dt u (mcv H) (enc_expr (srt v)) W (scons x R)) $ by dt_pi_c [t3, t4, #3, #4]
p3: $ G ⇒ dt u (mcv H) (enc_expr nat_ty) W R = nnat $ by dt_nat_ty [#1, #2, #3, #4]
w2: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ uadm u $ by weaken [#2]
w3: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ W ∈ lvals $ by weaken [#3]
w4: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ R ∈ fseq u $ by weaken [#4]
q1: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ x ∊ dt u (mcv H) (enc_expr nat_ty) W R $ by ax
q2: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ scons x R ∈ fseq u $ by dt_scons_fseq [w2, w3, w4, q1]
q3: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ enc_lvl v ∈ trees ω $ by enc_lvl_trees
q4: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) W R ⇒ dt u (mcv H) (enc_expr (srt v)) W (scons x R) = fv uni (lv (enc_lvl v) W) $ by dt_srt_c [q3, w3, q2]
r1: $ G ⇒ x ∊ dt u (mcv H) (enc_expr nat_ty) W R → dt u (mcv H) (enc_expr (srt v)) W (scons x R) = fv uni (lv (enc_lvl v) W) $ by imp_intro [q4]
r2: $ G ⇒ ∀ x (x ∊ dt u (mcv H) (enc_expr nat_ty) W R → dt u (mcv H) (enc_expr (srt v)) W (scons x R) = fv uni (lv (enc_lvl v) W)) $ by all_intro [r1]
r3: $ G ⇒ cpi x (dt u (mcv H) (enc_expr nat_ty) W R) (dt u (mcv H) (enc_expr (srt v)) W (scons x R)) = cpi x nnat (fv uni (lv (enc_lvl v) W)) $ by cpi_eq_pt [p3, r2]
r4: $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (srt v))) W R = cpi x nnat (fv uni (lv (enc_lvl v) W)) $ by eq_trans [p2, r3]

lemma e5_ms_ty {x h: set} (G: hyps) (H: class) (mo m1 m2: expr) (u w r m: set): $ G ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ lift n1 nz mo m1 $ > $ lift n2 nz mo m2 $ > $ G ⇒ dt u (mcv H) (enc_expr mo) w r = m $ > $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (pi (app m1 (bvar nz)) (app m2 (app nat_succ (bvar n1)))))) w r = cpi x nnat (cpi h (ap m x) (ap m (nsc x))) $
----
b0: $ G ⇒ w ∈ lvals $ by welc_wcel [#3]
b0r: $ G ⇒ r ∈ fseq u $ by welc_wcel [#4]
t1: $ G ⇒ enc_expr nat_ty ∈ trees ω $ by enc_expr_trees
t2: $ G ⇒ enc_expr (pi (app m1 (bvar nz)) (app m2 (app nat_succ (bvar n1)))) ∈ trees ω $ by enc_expr_trees
p1: $ G ⇒ dt u (mcv H) (enc_expr (pi nat_ty (pi (app m1 (bvar nz)) (app m2 (app nat_succ (bvar n1)))))) w r = cpi x (dt u (mcv H) (enc_expr nat_ty) w r) (dt u (mcv H) (enc_expr (pi (app m1 (bvar nz)) (app m2 (app nat_succ (bvar n1))))) w (scons x r)) $ by dt_pi_c [t1, t2, b0, b0r]
p2: $ G ⇒ dt u (mcv H) (enc_expr nat_ty) w r = nnat $ by dt_nat_ty [#1, #2, b0, b0r]
k1: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ hind H $ by weaken [#1]
k2: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ uadm u $ by weaken [#2]
k3: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ w ∈ lvals $ by weaken [b0]
k4: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ r ∈ fseq u $ by weaken [b0r]
k4a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ r ∊ fseq u $ by weaken [#4]
k5: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr mo) w r = m $ by weaken [#7]
q1: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ x ∊ dt u (mcv H) (enc_expr nat_ty) w r $ by ax
q2: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ scons x r ∈ fseq u $ by dt_scons_fseq [k2, k3, k4, q1]
q3a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr nat_ty) w r = nnat $ by weaken [p2]
q3: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ x ∊ nnat $ by welc_eq [q3a, q1]
q4: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ nnat ⊆ u $ by nnat_sub_u [k2]
q5: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ x ∊ u $ by subset_elim [q4, q3]
q6: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ x ∈ u $ by welc_wcel [q5]
ta: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ enc_expr (app m1 (bvar nz)) ∈ trees ω $ by enc_expr_trees
tb: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ enc_expr (app m2 (app nat_succ (bvar n1))) ∈ trees ω $ by enc_expr_trees
s1: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr (pi (app m1 (bvar nz)) (app m2 (app nat_succ (bvar n1))))) w (scons x r) = cpi h (dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r)) (dt u (mcv H) (enc_expr (app m2 (app nat_succ (bvar n1)))) w (scons h (scons x r))) $ by dt_pi_c [ta, tb, k3, q2]
tm1: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ enc_expr m1 ∈ trees ω $ by enc_expr_trees
tbz: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ enc_expr (bvar nz) ∈ trees ω $ by enc_expr_trees
s2: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) = ap (dt u (mcv H) (enc_expr m1) w (scons x r)) (dt u (mcv H) (enc_expr (bvar nz)) w (scons x r)) $ by dt_app_c [tm1, tbz, k3, q2]
s3: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr m1) w (scons x r) = dt u (mcv H) (enc_expr mo) w r $ by e5_lift1 [#5, k3, q6, k4a]
s4: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr m1) w (scons x r) = m $ by eq_trans [s3, k5]
tnz: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
s5: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr (bvar nz)) w (scons x r) = fv (scons x r) (fv nvf (enc_nat nz)) $ by dt_bvar_c [tnz, k3, q2]
s6a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ isset r $ by isset_var
s6: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ fv (scons x r) (fv nvf (enc_nat nz)) = x $ by e5_lk0 [s6a]
s7: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr (bvar nz)) w (scons x r) = x $ by eq_trans [s5, s6]
s8: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ ap (dt u (mcv H) (enc_expr m1) w (scons x r)) (dt u (mcv H) (enc_expr (bvar nz)) w (scons x r)) = ap m x $ by ap_eq [s4, s7]
s9: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r ⇒ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) = ap m x $ by eq_trans [s2, s8]
u1: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) $ by ax
u0a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ uadm u $ by weaken [#2]
u0b: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ w ∈ lvals $ by weaken [b0]
u0c: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ scons x r ∈ fseq u $ by weaken [q2]
u0d: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ hind H $ by weaken [#1]
u0e: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ r ∊ fseq u $ by weaken [#4]
u0f: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ x ∈ u $ by weaken [q6]
u0g: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr mo) w r = m $ by weaken [#7]
u0h: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ x ∊ nnat $ by weaken [q3]
u2: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ scons h (scons x r) ∈ fseq u $ by dt_scons_fseq [u0a, u0b, u0c, u1]
u2a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ∈ u $ by den_in_u_c [u0a, u0b, u0c]
u2b: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ universe u $ by uadm_universe [u0a]
u2c: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ h ∈ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) $ by welc_wcel [u1]
u2d: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ h ∈ u $ by universe_elem_elem_c [u2b, u2a, u2c]
u3a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ enc_expr m2 ∈ trees ω $ by enc_expr_trees
u3b: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ enc_expr (app nat_succ (bvar n1)) ∈ trees ω $ by enc_expr_trees
u3: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr (app m2 (app nat_succ (bvar n1)))) w (scons h (scons x r)) = ap (dt u (mcv H) (enc_expr m2) w (scons h (scons x r))) (dt u (mcv H) (enc_expr (app nat_succ (bvar n1))) w (scons h (scons x r))) $ by dt_app_c [u3a, u3b, u0b, u2]
u4a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr m2) w (scons h (scons x r)) = dt u (mcv H) (enc_expr mo) w r $ by e5_lift2 [#6, u0b, u2d, u0f, u0e]
u4: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr m2) w (scons h (scons x r)) = m $ by eq_trans [u4a, u0g]
u5a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ enc_expr nat_succ ∈ trees ω $ by enc_expr_trees
u5b: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ enc_expr (bvar n1) ∈ trees ω $ by enc_expr_trees
u5: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr (app nat_succ (bvar n1))) w (scons h (scons x r)) = ap (dt u (mcv H) (enc_expr nat_succ) w (scons h (scons x r))) (dt u (mcv H) (enc_expr (bvar n1)) w (scons h (scons x r))) $ by dt_app_c [u5a, u5b, u0b, u2]
u6: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr nat_succ) w (scons h (scons x r)) = clam y nnat (nsc y) $ by dt_nat_succ [u0d, u0a, u0b, u2]
u7a: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ enc_nat n1 ∈ trees ω $ by enc_nat_trees
u7b: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr (bvar n1)) w (scons h (scons x r)) = fv (scons h (scons x r)) (fv nvf (enc_nat n1)) $ by dt_bvar_c [u7a, u0b, u2]
u7c: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ isset r $ by isset_var
u7d: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ fv (scons h (scons x r)) (fv nvf (enc_nat n1)) = x $ by e5_lk1 [u7c]
u7: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr (bvar n1)) w (scons h (scons x r)) = x $ by eq_trans [u7b, u7d]
u8: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ ap (dt u (mcv H) (enc_expr nat_succ) w (scons h (scons x r))) (dt u (mcv H) (enc_expr (bvar n1)) w (scons h (scons x r))) = ap (clam y nnat (nsc y)) x $ by ap_eq [u6, u7]
u9: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ ap (clam y nnat (nsc y)) x = nsc x $ by clam_ap [u0h]
u10: $ G , x ∊ dt u (mcv H) (enc_expr nat_ty) w r , h ∊ dt u (mcv H) (enc_expr (app m1 (bvar nz))) w (scons x r) ⇒ dt u (mcv H) (enc_expr (app nat_succ (bvar n1))) w (scons h (scons x r)) = ap (clam y nnat (nsc y)) x $ by eq_trans [u5, u8]
