--| `succ`'s minor's space at Nat: the traces taking `y` and a value of the
--| motive at `y` into the motive at `nsc y`.
lemma e4_imin1_intro {y h e: set} (G: hyps) (M I C P CV: class) (u w m ms: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = suc ∅ $ > $ G ⇒ CV = scons m ∅ $ > $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ >
  $ G ⇒ ms ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ > $ G ⇒ ms ∊ imin u (dnf u M) tr_nat_D I C w P CV $
----
l1: $ G , o ∊ ms ⇒ ms ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $ by weaken [#8]
l2: $ G , o ∊ ms ⇒ ms ⊆ clam y nnat (⋃ (cpi h (ap m y) (ap m (nsc y)))) $ by cpi_elim_sub [l1]
l3a: $ G , o ∊ ms ⇒ o ∊ ms $ by ax
l3: $ G , o ∊ ms ⇒ o ∊ clam y nnat (⋃ (cpi h (ap m y) (ap m (nsc y)))) $ by subset_elim [l2, l3a]
m1: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) ⇒ b ∊ ⋃ (cpi h (ap m a) (ap m (nsc a))) $ by ax
n1: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f ⇒ f ∊ cpi h (ap m a) (ap m (nsc a)) $ by ax
n2: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f ⇒ f ⊆ clam h (ap m a) (⋃ (ap m (nsc a))) $ by cpi_elim_sub [n1]
n3a: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f ⇒ b ∊ f $ by ax
n3: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f ⇒ b ∊ clam h (ap m a) (⋃ (ap m (nsc a))) $ by subset_elim [n2, n3a]
r0a: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ isset ∅ $ by ax_empty
r0b: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ isset (scons c ∅) $ by scons_set [r0a]
r0c: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ isset (scons a ∅) $ by scons_set [r0a]
r0d: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ isset (scons c (scons a ∅)) $ by scons_set [r0c]
r0i: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ isset c $ by isset_var
r0j: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ isset a $ by isset_var
r0e: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ scat (scons c ∅) (scons a ∅) = scons c (scons a ∅) $ by scat_single [r0i, r0j]
r0f: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ scons c (scons a ∅) = scat (scons c ∅) (scons a ∅) $ by eq_sym [r0e]
r0: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) ⇒ isset (scat (scons c ∅) (scons a ∅)) $ by isset_eq [r0f, r0d]
g1: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ uadm u $ by weaken [#1]
g2: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ w ∊ lvals $ by weaken [#2]
g3: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ P = ∅ $ by weaken [#3]
g4: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ I = ∅ $ by weaken [#4]
g5: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ C = suc ∅ $ by weaken [#5]
g6: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ CV = scons m ∅ $ by weaken [#6]
g7: $ G , o ∊ ms , o = ⟨ a , b ⟩ , a ∊ nnat , b ∊ (⟦ y / a ⟧ (⋃ (cpi h (ap m y) (ap m (nsc y))))) , f ∊ cpi h (ap m a) (ap m (nsc a)) , b ∊ f , b = ⟨ c , d ⟩ , c ∊ ap m a , d ∊ (⟦ h / c ⟧ (⋃ (ap m (nsc a)))) , x6 = scat (scons c ∅) (scons a ∅) ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by weaken [#7]
