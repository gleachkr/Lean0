--| The block's types at Nat after the parameters: Nat's value.
lemma e4_RR (G: hyps) (M P: class) (u w: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = scons nnat ∅ $
----
l1: $ G ⇒ (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) = scons (ient tr_nat_D w (ifam u (dnf u M) tr_nat_D w) ∅) ∅ $ by nat_ixs
l2: $ G ⇒ ity u (dnf u M) tr_nat_D ∅ w = nnat $ by nat_ity [#1, #2]
l3: $ G ⇒ ∅ = ∅ $ by eq_refl
l4: $ G ⇒ scons (ity u (dnf u M) tr_nat_D ∅ w) ∅ = scons nnat ∅ $ by scons_eq [l2, l3]
l5: $ G ⇒ (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) = scons nnat ∅ $ by eq_trans [l1, l4]
l6: $ G ⇒ nnat ∈ u $ by nnat_u [#1]
l7: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l8: $ G ⇒ scons nnat ∅ ∈ fseq u $ by scons_fseq_c [l6, l7]
l9a: $ G ⇒ scons nnat ∅ = (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) $ by eq_sym [l5]
l9: $ G ⇒ (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) ∈ fseq u $ by wcel_eq_l [l9a, l8]
l10r: $ G ⇒ (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) = (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) $ by eq_refl
l10: $ G ⇒ (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = scat ∅ (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) $ by scat_eq [#3, l10r]
l11: $ G ⇒ scat ∅ (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) = (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) $ by scat_empty_l_c [l9]
l12: $ G ⇒ (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) $ by eq_trans [l10, l11]
l13: $ G ⇒ (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = scons nnat ∅ $ by eq_trans [l12, l5]

