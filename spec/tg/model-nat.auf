k5c: $ G , o = ∅ ⇒ tn_K0 = tn_K0 $ by eq_refl
k5: $ G , o = ∅ ⇒ ictk tr_nat_D o o tn_K0 $ by ictk_eq [k5b, k0s, k0s, k5c, k5a]
k6a: $ G , o = ∅ ⇒ ifam u (dnf u M) tr_nat_D w ∈ u $ by e3_I_u [k0u, k0w]
