lemma e2_mi_nil (G: hyps) (t a b e: set): $ G ⇒ t = e2_tnil $ > $ G ⇒ ra_minor_idx t a b e ∈ lrel $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) $ by lrel_minor_idx_cases [#2]
