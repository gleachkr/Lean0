Bw10: $ G , c = suc ∅ ∧ k = tn_K1 ⇒ ixs tr_nat_D w Z ∈ fseq u $ by weaken [b10]
Bw8: $ G , c = suc ∅ ∧ k = tn_K1 ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) k w (scat p (ixs tr_nat_D w Z)) $ by weaken [#8]
B1: $ G , c = suc ∅ ∧ k = tn_K1 ⇒ c = suc ∅ $ by and_elim_l [B0]
B2: $ G , c = suc ∅ ∧ k = tn_K1 ⇒ k = tn_K1 $ by and_elim_r [B0]
