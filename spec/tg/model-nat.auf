r4: $ G ⇒ dt u (mcv H) (enc_expr (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz))))) W (scons z (scons m R)) = cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y)) $ by eq_trans [p1, r3]

lemma e5_rt_B1 {z k y h: set} (G: hyps) (H W R: class) (u m: set): $ G ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ scons m R ∈ fseq u $ > $ G ⇒ isset R $ > $ G ⇒ dt u (mcv H) (enc_expr (pi (app (bvar nz) nat_zero) (pi (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1))))) (pi nat_ty (app (bvar n3) (bvar nz)))))) W (scons m R) = cpi z (ap m nzr) (cpi k (cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) (cpi y nnat (ap m y))) $
