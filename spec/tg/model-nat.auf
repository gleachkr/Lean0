w1a: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 ⇒ isset (nsc n) $ by weaken [t5]
w1: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 ⇒ nsc n ∈ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by wcel_cab_intro (p := $ ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v)) $) [w1a, v9]
w2: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) ⇒ nsc n ∈ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by isset_elim [t4, w1]
w3: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} ⇒ nsc n ∈ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by ex_elim [s2, w2]
w4: $ G , n ∊ nnat ⇒ n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} → nsc n ∈ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by imp_intro [w3]
w5: $ G ⇒ n ∊ nnat → n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} → nsc n ∈ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by imp_intro [w4]
w6: $ G ⇒ ∀ n (n ∊ nnat → n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} → nsc n ∈ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))}) $ by all_intro [w5]
w7: $ G ⇒ nnat ⊆ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by nnat_ind [z9, w6]
w8: $ G ⇒ y ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by subset_elim [w7, #7]
w9: $ G ⇒ ∃ v (v ∊ ap m y ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v)) $ by cab_elim [w8]

lemma e4_imins_elim {y h e a b: set} (G: hyps) (M P CV: class) (u w m n: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ CV = scons m ∅ $ > $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ > $ G ⇒ n ∊ imins u (dnf u M) tr_nat_D w P CV $ >
  $ G ⇒ ∃ a ∃ b (n = scons a (scons b ∅) ∧ b ∊ ap m nzr ∧ a ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y)))) $
----
l1: $ G ⇒ n ∊ fseq u ∧ cdm n = inmin tr_nat_D $ by ivals_fseq [#6]
l2: $ G ⇒ n ∊ fseq u $ by and_elim_l [l1]
l3: $ G ⇒ cdm n = inmin tr_nat_D $ by and_elim_r [l1]
l4a: $ G ⇒ inmin tr_nat_D = suc (suc ∅) $ by nat_inmin
l4: $ G ⇒ cdm n = suc (suc ∅) $ by eq_trans [l3, l4a]
l5a: $ G ⇒ isset ∅ $ by ax_empty
l5b: $ G , x8 = ∅ ⇒ isset ∅ $ by ax_empty
l5: $ G , x8 = ∅ ⇒ isset (suc ∅) $ by suc_set [l5b]
g1: $ G , x8 = ∅ , x9 = suc ∅ ⇒ uadm u $ by weaken [#1]
g2: $ G , x8 = ∅ , x9 = suc ∅ ⇒ w ∊ lvals $ by weaken [#2]
g3: $ G , x8 = ∅ , x9 = suc ∅ ⇒ P = ∅ $ by weaken [#3]
g4: $ G , x8 = ∅ , x9 = suc ∅ ⇒ CV = scons m ∅ $ by weaken [#4]
g5: $ G , x8 = ∅ , x9 = suc ∅ ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by weaken [#5]
g6: $ G , x8 = ∅ , x9 = suc ∅ ⇒ n ∊ imins u (dnf u M) tr_nat_D w P CV $ by weaken [#6]
e1: $ G , x8 = ∅ , x9 = suc ∅ ⇒ x8 = ∅ $ by ax
e2: $ G , x8 = ∅ , x9 = suc ∅ ⇒ x9 = suc ∅ $ by ax
e3a: $ G , x8 = ∅ , x9 = suc ∅ ⇒ suc ∅ = x9 $ by eq_sym [e2]
e3b: $ G , x8 = ∅ , x9 = suc ∅ ⇒ suc (suc ∅) = suc x9 $ by suc_eq [e3a]
e3c: $ G , x8 = ∅ , x9 = suc ∅ ⇒ cdm n = suc (suc ∅) $ by weaken [l4]
e3: $ G , x8 = ∅ , x9 = suc ∅ ⇒ cdm n = suc x9 $ by eq_trans [e3c, e3b]
e4a: $ G , x8 = ∅ , x9 = suc ∅ ⇒ n ∊ fseq u $ by weaken [l2]
e4: $ G , x8 = ∅ , x9 = suc ∅ ⇒ ∃ o ∃ l (l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l) $ by fseq_suc [e4a, e3]
f1: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l $ by ax
s0: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ l ∊ fseq u $ by and_elim_l [f1]
sr0: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ cdm l = x9 ∧ n = scons o l $ by and_elim_r [f1]
s1: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ cdm l = x9 $ by and_elim_l [sr0]
sr1: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ n = scons o l $ by and_elim_r [sr0]
s2: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ n = scons o l $ by weaken [sr1]
e1w: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ x8 = ∅ $ by weaken [e1]
f2a: $ G , x8 = ∅ , x9 = suc ∅ , l ∊ fseq u ∧ cdm l = x9 ∧ n = scons o l ⇒ ∅ = x8 $ by eq_sym [e1w]
