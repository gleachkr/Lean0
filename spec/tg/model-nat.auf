lemma e2_nvf_N2 (G: hyps): $ G ⇒ fv nvf e2_N2 = suc (suc ∅) $
----
l1: $ G ⇒ e2_N1 ∈ trees ω $ by e2_tr_N1
l2: $ G ⇒ fv nvf ⟨ kc_s , scons e2_N1 ∅ ⟩ = suc (fv nvf e2_N1) $ by nvf_s [l1]
l3: $ G ⇒ fv nvf e2_N1 = suc ∅ $ by nvf_n1
l4: $ G ⇒ suc (fv nvf e2_N1) = suc (suc ∅) $ by suc_eq [l3]
l5: $ G ⇒ fv nvf e2_N2 = suc (suc ∅) $ by eq_trans [l2, l4]

lemma e2_ntys_fact (G: hyps): $ G ⇒ ra_ntys tn_T e2_N1 e2_N2 ∈ lrel $
----
l1: $ clen_c cnil nz $ by clen_c_nil
