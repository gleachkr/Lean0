lemma e4_imin1_elim {y h e: set} (G: hyps) (M I C P CV: class) (u w m ms: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = suc ∅ $ > $ G ⇒ CV = scons m ∅ $ > $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ >
  $ G ⇒ ms ∊ imin u (dnf u M) tr_nat_D I C w P CV $ > $ G ⇒ ms ∊ cpi y nnat (cpi h (ap m y) (ap m (nsc y))) $
----
g1: $ G , o ∊ ms ⇒ uadm u $ by weaken [#1]
g2: $ G , o ∊ ms ⇒ w ∊ lvals $ by weaken [#2]
g3: $ G , o ∊ ms ⇒ P = ∅ $ by weaken [#3]
g4: $ G , o ∊ ms ⇒ I = ∅ $ by weaken [#4]
g5: $ G , o ∊ ms ⇒ C = suc ∅ $ by weaken [#5]
g6: $ G , o ∊ ms ⇒ CV = scons m ∅ $ by weaken [#6]
g7: $ G , o ∊ ms ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by weaken [#7]
g8: $ G , o ∊ ms ⇒ ms ∊ fpi q (iminq u (dnf u M) tr_nat_D I C w P CV) {y | ∃ d ∃ f ∃ g ∃ t ∃ a ∃ h (ictk tr_nat_D I C d ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∧ h ∊ ihv tr_nat_D d (imrel tr_nat_D CV) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))))} $ by weaken [#8]
l1: $ G , o ∊ ms ⇒ o ∊ ms $ by ax
l2: $ G , o ∊ ms ⇒ ∃ q ∃ i (q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i) $ by fpi_pts [g8, l1]
m1: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i $ by ax
m2: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ q ∊ iminq u (dnf u M) tr_nat_D I C w P CV $ by and_elim_l [m1]
m3: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ o = nest q i $ by and_elim_r [m1]
p1: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ uadm u $ by weaken [#1]
