e3a: $ G , v ∊ ient tr_nat_D W Z ∅ , ⟨ ∅ , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop tr_nat_D ∅ W ∧ v = nest a ∅) ∨ (¬ iprop tr_nat_D ∅ W ∧ v = nest a x)) , ¬ iprop tr_nat_D ∅ W ∧ v = nest a x ⇒ a = ∅ $ by weaken [c8]
