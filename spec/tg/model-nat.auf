-- Proofs for model-nat.mm0.

nsc_congr
---------
l1: $ suc ∅ ≐ suc ∅ $ by ceqt_refl
l2: $ ∅ ≐ ∅ $ by ceqt_refl
l3: $ scons A ∅ ≐ scons B ∅ $ by scons_congr [#1, l2]
l4: $ scons (suc ∅) (scons A ∅) ≐ scons (suc ∅) (scons B ∅) $ by scons_congr [l1, l3]

sb_c_nsc
--------
l1: $ (⟦ x / t ⟧ (scons (suc ∅) (scons A ∅))) ≐ scons (suc ∅) (scons (⟦ x / t ⟧ A) ∅) $ by ceqt_refl

nsc_eq
------
l1: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l2: $ G ⇒ ∅ = ∅ $ by eq_refl
l3: $ G ⇒ scons A ∅ = scons B ∅ $ by scons_eq [#1, l2]
l4: $ G ⇒ scons (suc ∅) (scons A ∅) = scons (suc ∅) (scons B ∅) $ by scons_eq [l1, l3]

nzr_set
-------
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ isset (scons ∅ ∅) $ by scons_set [l1]

nsc_set
-------
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ isset (scons A ∅) $ by scons_set [l1]
l3: $ G ⇒ isset (scons (suc ∅) (scons A ∅)) $ by scons_set [l2]

nzr_ne_nsc
----------
l1: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ scons ∅ ∅ = scons (suc ∅) (scons y ∅) $ by ax
l2: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ ∅ = ∅ $ by eq_refl
l3: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ fv (scons ∅ ∅) ∅ = fv (scons (suc ∅) (scons y ∅)) ∅ $ by fv_eq [l1, l2]
l4: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ isset ∅ $ by ax_empty
l5: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ fv (scons ∅ ∅) ∅ = ∅ $ by scons_fv_zero_c [l4, l4]
l6: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ isset (suc ∅) $ by suc_set [l4]
l7: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ isset (scons y ∅) $ by scons_set [l4]
l8: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ fv (scons (suc ∅) (scons y ∅)) ∅ = suc ∅ $ by scons_fv_zero_c [l6, l7]
l9: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ ∅ = fv (scons ∅ ∅) ∅ $ by eq_sym [l5]
l10: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ ∅ = fv (scons (suc ∅) (scons y ∅)) ∅ $ by eq_trans [l9, l3]
l11: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ ∅ = suc ∅ $ by eq_trans [l10, l8]
l12: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ suc ∅ = ∅ $ by eq_sym [l11]
l13: $ G , scons ∅ ∅ = scons (suc ∅) (scons y ∅) ⇒ ⊥ $ by suc_ne_empty [l12]
l14: $ G ⇒ ¬ scons ∅ ∅ = scons (suc ∅) (scons y ∅) $ by not_intro [l13]

nsc_inj
-------
l1: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l2: $ G ⇒ fv (scons (suc ∅) (scons y ∅)) (suc ∅) = fv (scons (suc ∅) (scons y2 ∅)) (suc ∅) $ by fv_eq [#1, l1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (suc ∅) $ by suc_set [l3]
l5: $ G ⇒ isset (scons y ∅) $ by scons_set [l3]
l6: $ G ⇒ isset (scons y2 ∅) $ by scons_set [l3]
l7: $ G ⇒ fv (scons (suc ∅) (scons y ∅)) (suc ∅) = fv (scons y ∅) ∅ $ by scons_fv_suc_c [l4, l5, l3]
l8: $ G ⇒ fv (scons (suc ∅) (scons y2 ∅)) (suc ∅) = fv (scons y2 ∅) ∅ $ by scons_fv_suc_c [l4, l6, l3]
l9: $ G ⇒ isset y $ by isset_var
l10: $ G ⇒ isset y2 $ by isset_var
l11: $ G ⇒ fv (scons y ∅) ∅ = y $ by scons_fv_zero_c [l9, l3]
l12: $ G ⇒ fv (scons y2 ∅) ∅ = y2 $ by scons_fv_zero_c [l10, l3]
l13: $ G ⇒ fv (scons y ∅) ∅ = fv (scons (suc ∅) (scons y ∅)) (suc ∅) $ by eq_sym [l7]
l14: $ G ⇒ y = fv (scons y ∅) ∅ $ by eq_sym [l11]
l15: $ G ⇒ y = fv (scons (suc ∅) (scons y ∅)) (suc ∅) $ by eq_trans [l14, l13]
l16: $ G ⇒ y = fv (scons (suc ∅) (scons y2 ∅)) (suc ∅) $ by eq_trans [l15, l2]
l17: $ G ⇒ y = fv (scons y2 ∅) ∅ $ by eq_trans [l16, l8]
l18: $ G ⇒ y = y2 $ by eq_trans [l17, l12]

nnf_functional
--------------
l1: $ G ⇒ functional (omrec nzr (cgr y (nsc y))) $ by omrec_functional

nnf_cdm
-------
l1: $ G ⇒ isset nzr $ by nzr_set
l2: $ G ⇒ functional (cgr y (nsc y)) $ by cgr_functional
l3: $ G ⇒ cdm (omrec nzr (cgr y (nsc y))) = ω $ by omrec_cdm [l1, l2]

nnf_zero
--------
l1: $ G ⇒ isset nzr $ by nzr_set
l2: $ G ⇒ functional (cgr y (nsc y)) $ by cgr_functional
l3: $ G ⇒ fv (omrec nzr (cgr y (nsc y))) ∅ = nzr $ by omrec_zero [l1, l2]

nnf_suc
-------
l1: $ G ⇒ isset nzr $ by nzr_set
l2: $ G ⇒ functional (cgr y (nsc y)) $ by cgr_functional
l3: $ G ⇒ fv (omrec nzr (cgr y (nsc y))) (suc n) = fv (cgr y (nsc y)) (fv (omrec nzr (cgr y (nsc y))) n) $ by omrec_suc [l1, l2, #1]
l4: $ G ⇒ functional nnf $ by nnf_functional
l5: $ G ⇒ isset (fv nnf n) $ by fv_set [l4]
m1: $ G , v = fv nnf n ⇒ v = fv nnf n $ by ax
m2: $ G , v = fv nnf n ⇒ fv nnf n = v $ by eq_sym [m1]
m3: $ G , v = fv nnf n ⇒ cgr y (nsc y) = cgr y (nsc y) $ by eq_refl
m4: $ G , v = fv nnf n ⇒ fv (cgr y (nsc y)) (fv nnf n) = fv (cgr y (nsc y)) v $ by fv_eq [m3, m2]
m5: $ G , v = fv nnf n ⇒ isset (nsc v) $ by nsc_set
m6: $ G , v = fv nnf n ⇒ fv (cgr y (nsc y)) v = nsc v $ by fv_cgr [m5]
m7: $ G , v = fv nnf n ⇒ nsc v = nsc (fv nnf n) $ by nsc_eq [m1]
m8: $ G , v = fv nnf n ⇒ fv nnf (suc n) = fv (cgr y (nsc y)) (fv nnf n) $ by weaken [l3]
m9: $ G , v = fv nnf n ⇒ fv nnf (suc n) = fv (cgr y (nsc y)) v $ by eq_trans [m8, m4]
m10: $ G , v = fv nnf n ⇒ fv nnf (suc n) = nsc v $ by eq_trans [m9, m6]
m11: $ G , v = fv nnf n ⇒ fv nnf (suc n) = nsc (fv nnf n) $ by eq_trans [m10, m7]
m12: $ G ⇒ fv nnf (suc n) = nsc (fv nnf n) $ by isset_elim [l5, m11]

nnat_fv
-------
l1: $ G ⇒ functional nnf $ by nnf_functional
l2: $ G ⇒ cdm nnf = ω $ by nnf_cdm
l3: $ G ⇒ ω = cdm nnf $ by eq_sym [l2]
l4: $ G ⇒ n ∊ cdm nnf $ by welc_eq [l3, #1]
l5: $ G ⇒ ⟨ n , fv nnf n ⟩ ∈ nnf $ by fv_in [l1, l4]
l6: $ G ⇒ isset (fv nnf n) $ by fv_set [l1]
m1: $ G , v = fv nnf n ⇒ v = fv nnf n $ by ax
m2: $ G , v = fv nnf n ⇒ fv nnf n = v $ by eq_sym [m1]
m3: $ G , v = fv nnf n ⇒ n = n $ by eq_refl
m4: $ G , v = fv nnf n ⇒ ⟨ n , fv nnf n ⟩ = ⟨ n , v ⟩ $ by opair_eq [m3, m2]
m5: $ G , v = fv nnf n ⇒ ⟨ n , fv nnf n ⟩ ∈ nnf $ by weaken [l5]
m6: $ G , v = fv nnf n ⇒ ⟨ n , v ⟩ ∈ nnf $ by wcel_eq_l [m4, m5]
m7: $ G , v = fv nnf n ⇒ v ∊ crn nnf $ by crn_intro [m6]
m8: $ G , v = fv nnf n ⇒ fv nnf n ∈ crn nnf $ by wcel_intro [m1, m7]
m9: $ G ⇒ fv nnf n ∈ crn nnf $ by isset_elim [l6, m8]

nnat_fv_c
---------
m1: $ G , a = A , a ∊ ω ⇒ a = A $ by ax
m2: $ G , a = A , a ∊ ω ⇒ a ∊ ω $ by ax
m3: $ G , a = A , a ∊ ω ⇒ fv nnf a ∈ nnat $ by nnat_fv [m2]
m4: $ G , a = A , a ∊ ω ⇒ nnf = nnf $ by eq_refl
m5: $ G , a = A , a ∊ ω ⇒ fv nnf a = fv nnf A $ by fv_eq [m4, m1]
m6: $ G , a = A , a ∊ ω ⇒ fv nnf A ∈ nnat $ by wcel_eq_l [m5, m3]
m7: $ G ⇒ fv nnf A ∈ nnat $ by wcel_elim [#1, m6]

nnat_zero
---------
l1: $ G ⇒ ∅ ∈ ω $ by omega_zero
l2: $ G ⇒ fv nnf ∅ ∈ nnat $ by nnat_fv_c [l1]
l3: $ G ⇒ fv nnf ∅ = nzr $ by nnf_zero
l4: $ G ⇒ nzr ∈ nnat $ by wcel_eq_l [l3, l2]

nnat_suc
--------
l1: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ ⟨ k , y ⟩ ∈ nnf $ by ax
l2: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ k ∊ cdm nnf $ by cdm_intro [l1]
l3: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ cdm nnf = ω $ by nnf_cdm
l4: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ k ∊ ω $ by welc_eq [l3, l2]
l5: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ functional nnf $ by nnf_functional
l6: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ fv nnf k = y $ by fv_val [l5, l1]
l7: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ suc k ∈ ω $ by omega_suc [l4]
l8: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ fv nnf (suc k) ∈ nnat $ by nnat_fv_c [l7]
l9: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ fv nnf (suc k) = nsc (fv nnf k) $ by nnf_suc [l4]
l10: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ nsc (fv nnf k) = nsc y $ by nsc_eq [l6]
l11: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ fv nnf (suc k) = nsc y $ by eq_trans [l9, l10]
l12: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ nsc y ∈ nnat $ by wcel_eq_l [l11, l8]
l13: $ G ⇒ nsc y ∈ nnat $ by crn_elim [#1, l12]

nnat_cases
----------
l1: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ ⟨ k , y ⟩ ∈ nnf $ by ax
l2: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ k ∊ cdm nnf $ by cdm_intro [l1]
l3: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ cdm nnf = ω $ by nnf_cdm
l4: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ k ∊ ω $ by welc_eq [l3, l2]
l5: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ functional nnf $ by nnf_functional
l6: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ fv nnf k = y $ by fv_val [l5, l1]
l7: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ y = fv nnf k $ by eq_sym [l6]
l8: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ k = ∅ ∨ ∃ j (j ∊ ω ∧ k = suc j) $ by omega_cases [l4]
a1: $ G , ⟨ k , y ⟩ ∈ nnf , k = ∅ ⇒ k = ∅ $ by ax
a2: $ G , ⟨ k , y ⟩ ∈ nnf , k = ∅ ⇒ nnf = nnf $ by eq_refl
a3: $ G , ⟨ k , y ⟩ ∈ nnf , k = ∅ ⇒ fv nnf k = fv nnf ∅ $ by fv_eq [a2, a1]
a4: $ G , ⟨ k , y ⟩ ∈ nnf , k = ∅ ⇒ fv nnf ∅ = nzr $ by nnf_zero
a5: $ G , ⟨ k , y ⟩ ∈ nnf , k = ∅ ⇒ y = fv nnf k $ by weaken [l7]
a6: $ G , ⟨ k , y ⟩ ∈ nnf , k = ∅ ⇒ y = fv nnf ∅ $ by eq_trans [a5, a3]
a7: $ G , ⟨ k , y ⟩ ∈ nnf , k = ∅ ⇒ y = nzr $ by eq_trans [a6, a4]
a8: $ G , ⟨ k , y ⟩ ∈ nnf , k = ∅ ⇒ y = nzr ∨ ∃ x (x ∊ nnat ∧ y = nsc x) $ by or_intro_l [a7]
b1: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ j ∊ ω ∧ k = suc j $ by ax
b2: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ j ∊ ω $ by and_elim_l [b1]
b3: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ k = suc j $ by and_elim_r [b1]
b4: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ nnf = nnf $ by eq_refl
b5: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ fv nnf k = fv nnf (suc j) $ by fv_eq [b4, b3]
b6: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ fv nnf (suc j) = nsc (fv nnf j) $ by nnf_suc [b2]
b7: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ y = fv nnf k $ by weaken [l7]
b8: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ y = fv nnf (suc j) $ by eq_trans [b7, b5]
b9: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ y = nsc (fv nnf j) $ by eq_trans [b8, b6]
b10: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ fv nnf j ∈ nnat $ by nnat_fv [b2]
c1: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j , v = fv nnf j , v ∊ nnat ⇒ v = fv nnf j $ by ax
c2: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j , v = fv nnf j , v ∊ nnat ⇒ v ∊ nnat $ by ax
c3: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j , v = fv nnf j , v ∊ nnat ⇒ fv nnf j = v $ by eq_sym [c1]
c4: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j , v = fv nnf j , v ∊ nnat ⇒ nsc (fv nnf j) = nsc v $ by nsc_eq [c3]
c5: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j , v = fv nnf j , v ∊ nnat ⇒ y = nsc (fv nnf j) $ by weaken [b9]
c6: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j , v = fv nnf j , v ∊ nnat ⇒ y = nsc v $ by eq_trans [c5, c4]
c7: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j , v = fv nnf j , v ∊ nnat ⇒ v ∊ nnat ∧ y = nsc v $ by and_intro [c2, c6]
c8: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j , v = fv nnf j , v ∊ nnat ⇒ ∃ x (x ∊ nnat ∧ y = nsc x) $ by ex_intro [c7]
c9: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ ∃ x (x ∊ nnat ∧ y = nsc x) $ by wcel_elim [b10, c8]
c10: $ G , ⟨ k , y ⟩ ∈ nnf , j ∊ ω ∧ k = suc j ⇒ y = nzr ∨ ∃ x (x ∊ nnat ∧ y = nsc x) $ by or_intro_r [c9]
d1: $ G , ⟨ k , y ⟩ ∈ nnf , ∃ j (j ∊ ω ∧ k = suc j) ⇒ ∃ j (j ∊ ω ∧ k = suc j) $ by ax
d2: $ G , ⟨ k , y ⟩ ∈ nnf , ∃ j (j ∊ ω ∧ k = suc j) ⇒ y = nzr ∨ ∃ x (x ∊ nnat ∧ y = nsc x) $ by ex_elim [d1, c10]
d3: $ G , ⟨ k , y ⟩ ∈ nnf ⇒ y = nzr ∨ ∃ x (x ∊ nnat ∧ y = nsc x) $ by or_elim [l8, a8, d2]
d4: $ G ⇒ y = nzr ∨ ∃ x (x ∊ nnat ∧ y = nsc x) $ by crn_elim [#1, d3]

--| Induction over the numbers' tuples: a class containing `nzr` and closed
--| under `nsc` along the values of `nnf` contains every value.
lemma e1_nnf_ind {j: set} (G: hyps) (C: class) (n: set):
  $ G ⇒ nzr ∈ C $ > $ G ⇒ ∀ j (j ∊ ω → fv nnf j ∈ C → nsc (fv nnf j) ∈ C) $ > $ G ⇒ n ∊ ω $ >
  $ G ⇒ fv nnf n ∈ C $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G , k = ∅ ⇒ k = ∅ $ by ax
l3: $ G , k = ∅ ⇒ fv nnf ∅ = nzr $ by nnf_zero
l4: $ G , k = ∅ ⇒ ∅ = k $ by eq_sym [l2]
l5: $ G , k = ∅ ⇒ nnf = nnf $ by eq_refl
l6: $ G , k = ∅ ⇒ fv nnf ∅ = fv nnf k $ by fv_eq [l5, l4]
l7: $ G , k = ∅ ⇒ nzr = fv nnf ∅ $ by eq_sym [l3]
l8: $ G , k = ∅ ⇒ nzr = fv nnf k $ by eq_trans [l7, l6]
l9: $ G , k = ∅ ⇒ nzr ∈ C $ by weaken [#1]
l10: $ G , k = ∅ ⇒ fv nnf k ∈ C $ by wcel_eq_l [l8, l9]
l11: $ G , k = ∅ ⇒ k ∊ {i | fv nnf i ∈ C} $ by cab_intro [l10]
l12: $ G , k = ∅ ⇒ ∅ ∈ {i | fv nnf i ∈ C} $ by wcel_intro [l2, l11]
l13: $ G ⇒ ∅ ∈ {i | fv nnf i ∈ C} $ by isset_elim [l1, l12]
s1: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} $ by ax
s2: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ j ∊ ω $ by and_elim_l [s1]
s3: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ j ∊ {i | fv nnf i ∈ C} $ by and_elim_r [s1]
s4: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ fv nnf j ∈ C $ by cab_elim [s3]
s5: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ ∀ j (j ∊ ω → fv nnf j ∈ C → nsc (fv nnf j) ∈ C) $ by weaken [#2]
s6: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ j ∊ ω → fv nnf j ∈ C → nsc (fv nnf j) ∈ C $ by all_elim [s5]
s7: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ fv nnf j ∈ C → nsc (fv nnf j) ∈ C $ by imp_elim [s6, s2]
s8: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ nsc (fv nnf j) ∈ C $ by imp_elim [s7, s4]
s9: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ fv nnf (suc j) = nsc (fv nnf j) $ by nnf_suc [s2]
s10: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ nsc (fv nnf j) = fv nnf (suc j) $ by eq_sym [s9]
s11: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} ⇒ fv nnf (suc j) ∈ C $ by wcel_eq_l [s10, s8]
s12: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} , k = suc j ⇒ k = suc j $ by ax
s13: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} , k = suc j ⇒ suc j = k $ by eq_sym [s12]
s14: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} , k = suc j ⇒ nnf = nnf $ by eq_refl
s15: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} , k = suc j ⇒ fv nnf (suc j) = fv nnf k $ by fv_eq [s14, s13]
s16: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} , k = suc j ⇒ fv nnf (suc j) ∈ C $ by weaken [s11]
s17: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} , k = suc j ⇒ fv nnf k ∈ C $ by wcel_eq_l [s15, s16]
s18: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} , k = suc j ⇒ k ∊ {i | fv nnf i ∈ C} $ by cab_intro [s17]
s19: $ G , j ∊ ω ∧ j ∊ {i | fv nnf i ∈ C} , k = suc j ⇒ suc j ∈ {i | fv nnf i ∈ C} $ by wcel_intro [s12, s18]
