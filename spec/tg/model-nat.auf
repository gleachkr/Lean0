l5: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ ⟨ kc_nz , ∅ ⟩ = e2_N0 $ by eq_refl
l6: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ a = e2_N0 $ by eq_trans [l4, l5]
