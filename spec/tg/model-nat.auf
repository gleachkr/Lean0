b4: $ G ⇒ w = w $ by eq_refl
b5: $ G ⇒ esat u (dnf u M) q w = esat u (dnf u M) tn_P w $ by ap_eq [b3, b4]
b6: $ G ⇒ esat u (dnf u M) tn_P w = csn ∅ $ by esat_nil [#2]
b7: $ G ⇒ esat u (dnf u M) q w = csn ∅ $ by eq_trans [b5, b6]
