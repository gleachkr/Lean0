--| The recursor's value at a motive and both minors: a trace on Nat into the motive.
lemma e4_lv4 {x6 x7 x8: set} (G: hyps) (M V: class) (u w p r t: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ V ∈ ω $ > $ G ⇒ p ∊ cpi x6 nnat (fv uni V) $ > $ G ⇒ r ∊ ap p nzr $ >
  $ G ⇒ t ∊ cpi x7 nnat (cpi x8 (ap p x7) (ap p (nsc x7))) $ > $ G ⇒ ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t ∈ cpi x7 nnat (ap p x7) $
----
s0a: $ G ⇒ tr_nat_D ∈ trees ω $ by tr_nat_D_trees
s0b: $ G ⇒ isset ∅ $ by ax_empty
s0: $ G ⇒ isset (irc u (dnf u M) tr_nat_D ∅ V w) $ by irc_set [s0a, s0b]
s1: $ G ⇒ isset (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) $ by ap_set_c [s0]
s2: $ G ⇒ isset (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) $ by ap_set_c [s1]
s3: $ G ⇒ isset (ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t) $ by ap_set_c [s2]
a1: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ o ∊ f $ by ax
a2: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t $ by ax
a3: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ o ∊ ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t $ by welc_eq [a2, a1]
a4: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ ⟨ t , o ⟩ ∈ ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r $ by ap_elim [a3]
i2: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ isset ⟨ t , o ⟩ $ by opair_isset
a5a: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ ⟨ r , ⟨ t , o ⟩ ⟩ ∈ ap (irc u (dnf u M) tr_nat_D ∅ V w) p ↔ ⟨ t , o ⟩ ∈ ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r $ by ap_wcel [i2]
a5: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ ⟨ r , ⟨ t , o ⟩ ⟩ ∈ ap (irc u (dnf u M) tr_nat_D ∅ V w) p $ by bi_elim_r [a5a, a4]
i3: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ isset ⟨ r , ⟨ t , o ⟩ ⟩ $ by opair_isset
a6a: $ G , f = ap (ap (ap (irc u (dnf u M) tr_nat_D ∅ V w) p) r) t , o ∊ f ⇒ ⟨ p , ⟨ r , ⟨ t , o ⟩ ⟩ ⟩ ∈ irc u (dnf u M) tr_nat_D ∅ V w ↔ ⟨ r , ⟨ t , o ⟩ ⟩ ∈ ap (irc u (dnf u M) tr_nat_D ∅ V w) p $ by ap_wcel [i3]
