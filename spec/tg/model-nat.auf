r9: $ G ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , y1 ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = b0) $ by bi_elim_l [r9c, r9a]

--| The fold is a function on Nat's keys, with its value at `y` in the
--| motive at `y` (induction on Nat).
lemma e4_fold {x h o v: set} (G: hyps) (M V: class) (u w m z ms y: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ V ∈ ω $ > $ G ⇒ m ∊ cpi x nnat (fv uni V) $ > $ G ⇒ z ∊ ap m nzr $ >
  $ G ⇒ ms ∊ cpi x nnat (cpi h (ap m x) (ap m (nsc x))) $ > $ G ⇒ y ∊ nnat $ > $ G ⇒ ∃ v (v ∊ ap m y ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , y ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v)) $
----
u1: $ G ⇒ m ∊ u $ by e4_mot_u [#1, #3, #4]
u2: $ G ⇒ universe u $ by uadm_universe [#1]
u3a: $ G ⇒ m ∈ u $ by welc_wcel [u1]
u3b: $ G ⇒ isset nzr $ by nzr_set
u3: $ G ⇒ ap m nzr ∈ u $ by universe_ap_c [u2, u3a, u3b]
u4a: $ G ⇒ z ∈ ap m nzr $ by welc_wcel [#5]
u4b: $ G ⇒ z ∈ u $ by universe_elem_elem_c [u2, u3, u4a]
u4: $ G ⇒ z ∊ u $ by wcel_welc [u4b]
z1: $ G , l = nzr ⇒ uadm u $ by weaken [#1]
z2: $ G , l = nzr ⇒ w ∊ lvals $ by weaken [#2]
z3: $ G , l = nzr ⇒ z ∊ u $ by weaken [u4]
z4: $ G , l = nzr ⇒ l = nzr $ by ax
z5: $ G , l = nzr ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , l ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = z) $ by e4_fz [z1, z2, z3, z4]
z6r: $ G , l = nzr ⇒ m = m $ by eq_refl
z6a: $ G , l = nzr ⇒ nzr = l $ by eq_sym [z4]
z6b: $ G , l = nzr ⇒ ap m nzr = ap m l $ by ap_eq [z6r, z6a]
z6c: $ G , l = nzr ⇒ z ∊ ap m nzr $ by weaken [#5]
z6: $ G , l = nzr ⇒ z ∊ ap m l $ by welc_eq [z6b, z6c]
z7: $ G , l = nzr ⇒ z ∊ ap m l ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , l ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = z) $ by and_intro [z6, z5]
z8: $ G , l = nzr ⇒ ∃ v (v ∊ ap m l ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , l ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v)) $ by ex_intro [z7]
z9: $ G ⇒ nzr ∈ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by wcel_cab_intro (p := $ ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v)) $) [u3b, z8]
s1: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} ⇒ n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} $ by ax
s2a: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} ⇒ ∃ v (v ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v)) $ by cab_elim [s1]
s2b: $ ∃ v (v ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v)) ⟺ ∃ x7 (x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7)) $ by ex_alpha
s2c: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} ⇒ ∃ v (v ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v)) ↔ ∃ x7 (x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7)) $ by weaken [s2b]
s2: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} ⇒ ∃ x7 (x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7)) $ by bi_elim_l [s2c, s2a]
t1: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) ⇒ x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) $ by ax
t2: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) ⇒ x7 ∊ ap m n $ by and_elim_l [t1]
t3: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) $ by and_elim_r [t1]
t4a: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) ⇒ isset ms $ by isset_var
t4b: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) ⇒ isset (ap ms n) $ by ap_set [t4a]
t4: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) ⇒ isset (ap (ap ms n) x7) $ by ap_set_c [t4b]
t5: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) ⇒ isset (nsc n) $ by nsc_set
p1: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ uadm u $ by weaken [#1]
p2: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ w ∊ lvals $ by weaken [#2]
p3: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ ms ∊ cpi x nnat (cpi h (ap m x) (ap m (nsc x))) $ by weaken [#6]
p4: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ m ∊ u $ by weaken [u1]
v1: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ n ∊ nnat $ by ax
v2: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ l = nsc n $ by ax
v3: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) $ by weaken [t3]
v4: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ x7 ∊ ap m n $ by weaken [t2]
