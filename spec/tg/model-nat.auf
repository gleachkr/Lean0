l26: $ G , f = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ k = ⟨ kc_s , scons x4 ∅ ⟩ ∧ l = x1 ∧ ra_isort x3 x4 x1 ∈ lrel ⇒ tn_F = f $ by eq_sym [l25]
