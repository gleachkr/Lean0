p3: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ P = ∅ $ by weaken [#3]
p4: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ I = ∅ $ by weaken [#4]
p5: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ C = suc ∅ $ by weaken [#5]
p6: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ CV = scons m ∅ $ by weaken [#6]
p7: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by weaken [#7]
p8: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ ms ∊ fpi q (iminq u (dnf u M) tr_nat_D I C w P CV) {y | ∃ d ∃ f ∃ g ∃ t ∃ a ∃ h (ictk tr_nat_D I C d ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∧ h ∊ ihv tr_nat_D d (imrel tr_nat_D CV) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))))} $ by weaken [#8]
m4: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i ⇒ ∃ n ∃ l (n ∊ nnat ∧ l ∊ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ ∧ q = scat (scons l ∅) (scons n ∅)) $ by e4_iminq1_elim [p1, p2, p3, p5, p7, m2]
n1: $ G , o ∊ ms , q ∊ iminq u (dnf u M) tr_nat_D I C w P CV ∧ o = nest q i , n ∊ nnat ∧ l ∊ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ ∧ q = scat (scons l ∅) (scons n ∅) ⇒ n ∊ nnat ∧ l ∊ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ ∧ q = scat (scons l ∅) (scons n ∅) $ by ax
