lemma e3_ictor1_elim {x: set} (G: hyps) (M: class) (u w z: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ z ∊ ictor u (dnf u M) tr_nat_D ∅ (suc ∅) w $ > $ G ⇒ z ∊ clam x nnat (nsc x) $
