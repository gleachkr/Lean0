k12: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ v ∊ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)} $ by cab_intro [k11]
k13r: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ v = v $ by eq_refl
k13a: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ apn v q = apn v ∅ $ by apn_eq [k13r, k5q]
k13b: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ apn v ∅ = v $ by apn_empty
k13c: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ apn v q = v $ by eq_trans [k13a, k13b]
k13d: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ v = apn v q $ by eq_sym [k13c]
k13e: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ v ∈ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)} $ by welc_wcel [k12]
k13: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ apn v q ∈ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)} $ by wcel_eq_l [k13d, k13e]
a1: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) ⇒ ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) $ by ax
a2: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) ⇒ apn v q ∈ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)} $ by ex_elim [a1, k13]
a3: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) ⇒ ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) $ by ax
a4: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) ⇒ apn v q ∈ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)} $ by ex_elim [a3, a2]
a5: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} ⇒ apn v q ∈ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)} $ by ex_elim [n2, a4]
a6: $ G ⇒ q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} → apn v q ∈ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)} $ by imp_intro [a5]
a7: $ G ⇒ ∀ q (q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} → apn v q ∈ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)}) $ by all_intro [a6]
a8: $ G ⇒ v ∊ fpi q {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) q ⟩ ⟩)} $ by fpi_intro [m7, a7]
a9: $ G ⇒ v ∊ ihsp L gg tt d ∅ $ by weaken [a8]

--| The hypotheses' valuations at a path of `succ`'s type: one hypothesis,
--| a value of `L` at the field.
lemma e4_ihv1_suc {a y h z: set} (G: hyps) (L K tt gg N: class) (d: set):
  $ G ⇒ K = tn_K1 $ > $ G ⇒ tt = scons (csn ept0) ∅ $ > $ G ⇒ N = suc ∅ $ > $ G ⇒ ∀ a (isset (ap L a)) $ > $ G ⇒ d = ∅ $ >
  $ G ⇒ ihv tr_nat_D K L gg tt N = {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $
----
l1: $ G ⇒ ∅ = d $ by eq_sym [#5]
l2: $ G ⇒ suc ∅ = suc d $ by suc_eq [l1]
l3: $ G ⇒ N = suc d $ by eq_trans [#3, l2]
l4: $ G ⇒ ihv tr_nat_D K L gg tt N = ihv tr_nat_D K L gg tt (suc d) $ by ihv_eq_arg [l3]
l5a: $ G ⇒ irf tr_nat_D tn_K1 ∅ ∅ $ by nat_irf1
l5b: $ G ⇒ tn_K1 = K $ by eq_sym [#1]
l5zq1: $ G ⇒ tr_nat_D = tr_nat_D $ by eq_refl
l5zq2: $ G ⇒ ∅ = ∅ $ by eq_refl
l5: $ G ⇒ irf tr_nat_D K d ∅ $ by irf_eq [l5zq1, l5b, l1, l5zq2, l5a]
l6a: $ G ⇒ ∅ ∈ ω $ by omega_zero
l6b: $ G ⇒ d ∈ ω $ by wcel_eq_l [l1, l6a]
l6: $ G ⇒ d ∊ ω $ by wcel_welc [l6b]
l7a: $ G ⇒ isset ∅ $ by ax_empty
l7b: $ G ⇒ isset (scons (csn ept0) ∅) $ by scons_set [l7a]
l7c: $ G ⇒ scons (csn ept0) ∅ = tt $ by eq_sym [#2]
l7: $ G ⇒ isset tt $ by isset_eq [l7c, l7b]
l8: $ G ⇒ ihv tr_nat_D K L gg tt (suc d) = {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by ihv_suc_rec [l7, #4, l6, l5]
l9a: $ G ⇒ ihv tr_nat_D K L gg tt d = ihv tr_nat_D K L gg tt ∅ $ by ihv_eq_arg [#5]
l9b: $ G ⇒ ihv tr_nat_D K L gg tt ∅ = csn ∅ $ by ihv_zero
l9: $ G ⇒ ihv tr_nat_D K L gg tt d = csn ∅ $ by eq_trans [l9a, l9b]
m1: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} ⇒ o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by ax
m2: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} ⇒ ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by cab_elim [m1]
k1: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z $ by ax
k2: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ z ∊ ihv tr_nat_D K L gg tt d $ by and_elim_l [k1]
k3: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z $ by and_elim_r [k1]
k4a: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ ihv tr_nat_D K L gg tt d = csn ∅ $ by weaken [l9]
k4: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ z ∊ csn ∅ $ by welc_eq [k4a, k2]
k5: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z $ by and_intro [k4, k3]
k6: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_intro [k5]
k7: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_intro [k6]
a1: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) ⇒ ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ax
a2: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) ⇒ ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_elim [a1, k7]
a3: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} ⇒ ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_elim [m2, a2]
a4: $ G , o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} ⇒ o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by cab_intro [a3]
n1: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} ⇒ o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by ax
n2: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} ⇒ ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by cab_elim [n1]
j1: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z $ by ax
j2: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ z ∊ csn ∅ $ by and_elim_l [j1]
j3: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z $ by and_elim_r [j1]
j4a: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ ihv tr_nat_D K L gg tt d = csn ∅ $ by weaken [l9]
j4b: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ csn ∅ = ihv tr_nat_D K L gg tt d $ by eq_sym [j4a]
j4: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ z ∊ ihv tr_nat_D K L gg tt d $ by welc_eq [j4b, j2]
j5: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z $ by and_intro [j4, j3]
j6: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_intro [j5]
j7: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z ⇒ ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_intro [j6]
b1: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) ⇒ ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ax
b2: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} , ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) ⇒ ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_elim [b1, j7]
b3: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} ⇒ ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_elim [n2, b2]
b4: $ G , o ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} ⇒ o ∊ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by cab_intro [b3]
c1: $ G ⇒ {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} = {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by eq_intro [a4, b4]
c2: $ G ⇒ ihv tr_nat_D K L gg tt N = {y | ∃ h ∃ z (z ∊ ihv tr_nat_D K L gg tt d ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by eq_trans [l4, l8]
c3: $ G ⇒ ihv tr_nat_D K L gg tt N = {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by eq_trans [c2, c1]

lemma e4_ihv1_elim {a b: set} (G: hyps) (L K tt gg N: class) (x hh: set):
  $ G ⇒ K = tn_K1 $ > $ G ⇒ tt = scons (csn ept0) ∅ $ > $ G ⇒ gg = scons x ∅ $ > $ G ⇒ N = suc ∅ $ > $ G ⇒ ∀ a (isset (ap L a)) $ >
  $ G ⇒ hh ∊ ihv tr_nat_D K L gg tt N $ > $ G ⇒ ∃ b (b ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ ∧ hh = scons b ∅) $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
m1: $ G , d = ∅ ⇒ d = ∅ $ by ax
m2: $ G , d = ∅ ⇒ K = tn_K1 $ by weaken [#1]
m3: $ G , d = ∅ ⇒ tt = scons (csn ept0) ∅ $ by weaken [#2]
m4: $ G , d = ∅ ⇒ N = suc ∅ $ by weaken [#4]
m5: $ G , d = ∅ ⇒ ∀ a (isset (ap L a)) $ by weaken [#5]
m6: $ G , d = ∅ ⇒ ihv tr_nat_D K L gg tt N = {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by e4_ihv1_suc [m2, m3, m4, m5, m1]
m7a: $ G , d = ∅ ⇒ hh ∊ ihv tr_nat_D K L gg tt N $ by weaken [#6]
m7: $ G , d = ∅ ⇒ hh ∊ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by welc_eq [m6, m7a]
m8: $ G , d = ∅ ⇒ ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z) $ by cab_elim [m7]
k1: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z $ by ax
k2: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ z ∊ csn ∅ $ by and_elim_l [k1]
k3a: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z $ by and_elim_r [k1]
k3: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ h ∊ ihsp L gg tt d ∅ $ by and_elim_l [k3a]
k4: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ hh = scons h z $ by and_elim_r [k3a]
k5: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ z = ∅ $ by csn_elim [k2]
k6a: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ d = ∅ $ by weaken [m1]
k6b: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ tt = scons (csn ept0) ∅ $ by weaken [#2]
k6c: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ gg = scons x ∅ $ by weaken [#3]
k6: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ h ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by e4_ihsp_elim [k6a, k6b, k6c, k3]
k7r: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ h = h $ by eq_refl
k7a: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ scons h z = scons h ∅ $ by scons_eq [k7r, k5]
k7: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ hh = scons h ∅ $ by eq_trans [k4, k7a]
k8: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ h ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ ∧ hh = scons h ∅ $ by and_intro [k6, k7]
k9: $ G , d = ∅ , z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z ⇒ ∃ b (b ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ ∧ hh = scons b ∅) $ by ex_intro [k8]
a1: $ G , d = ∅ , ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z) ⇒ ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z) $ by ax
a2: $ G , d = ∅ , ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ hh = scons h z) ⇒ ∃ b (b ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ ∧ hh = scons b ∅) $ by ex_elim [a1, k9]
a3: $ G , d = ∅ ⇒ ∃ b (b ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ ∧ hh = scons b ∅) $ by ex_elim [m8, a2]
a4: $ G ⇒ ∃ b (b ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ ∧ hh = scons b ∅) $ by isset_elim [l0, a3]

lemma e4_ihv1_intro {a: set} (G: hyps) (L K tt gg N: class) (x v: set):
  $ G ⇒ K = tn_K1 $ > $ G ⇒ tt = scons (csn ept0) ∅ $ > $ G ⇒ gg = scons x ∅ $ > $ G ⇒ N = suc ∅ $ > $ G ⇒ ∀ a (isset (ap L a)) $ >
  $ G ⇒ v ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ > $ G ⇒ scons v ∅ ∈ ihv tr_nat_D K L gg tt N $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
m1: $ G , d = ∅ ⇒ d = ∅ $ by ax
m2: $ G , d = ∅ ⇒ K = tn_K1 $ by weaken [#1]
m3: $ G , d = ∅ ⇒ tt = scons (csn ept0) ∅ $ by weaken [#2]
m4: $ G , d = ∅ ⇒ N = suc ∅ $ by weaken [#4]
m5: $ G , d = ∅ ⇒ ∀ a (isset (ap L a)) $ by weaken [#5]
m6: $ G , d = ∅ ⇒ ihv tr_nat_D K L gg tt N = {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by e4_ihv1_suc [m2, m3, m4, m5, m1]
l0w: $ G , d = ∅ ⇒ isset ∅ $ by ax_empty
m7: $ G , d = ∅ ⇒ isset (scons v ∅) $ by scons_set [l0w]
k1: $ G , d = ∅ , o = scons v ∅ ⇒ o = scons v ∅ $ by ax
k2a: $ G , d = ∅ , o = scons v ∅ ⇒ d = ∅ $ by weaken [m1]
k2: $ G , d = ∅ , o = scons v ∅ ⇒ d ∊ csn ∅ $ by csn_intro [k2a]
k3a: $ G , d = ∅ , o = scons v ∅ ⇒ tt = scons (csn ept0) ∅ $ by weaken [#2]
k3b: $ G , d = ∅ , o = scons v ∅ ⇒ gg = scons x ∅ $ by weaken [#3]
k3c: $ G , d = ∅ , o = scons v ∅ ⇒ v ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by weaken [#6]
k3: $ G , d = ∅ , o = scons v ∅ ⇒ v ∊ ihsp L gg tt d ∅ $ by e4_ihsp_intro [k2a, k3a, k3b, k3c]
k4r: $ G , d = ∅ , o = scons v ∅ ⇒ v = v $ by eq_refl
k4b: $ G , d = ∅ , o = scons v ∅ ⇒ ∅ = d $ by eq_sym [k2a]
k4a: $ G , d = ∅ , o = scons v ∅ ⇒ scons v ∅ = scons v d $ by scons_eq [k4r, k4b]
k4: $ G , d = ∅ , o = scons v ∅ ⇒ o = scons v d $ by eq_trans [k1, k4a]
k5a: $ G , d = ∅ , o = scons v ∅ ⇒ v ∊ ihsp L gg tt d ∅ ∧ o = scons v d $ by and_intro [k3, k4]
k5: $ G , d = ∅ , o = scons v ∅ ⇒ d ∊ csn ∅ ∧ v ∊ ihsp L gg tt d ∅ ∧ o = scons v d $ by and_intro [k2, k5a]
k6: $ G , d = ∅ , o = scons v ∅ ⇒ ∃ z (z ∊ csn ∅ ∧ v ∊ ihsp L gg tt d ∅ ∧ o = scons v z) $ by ex_intro [k5]
k7: $ G , d = ∅ , o = scons v ∅ ⇒ ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ o = scons h z) $ by ex_intro [k6]
k8: $ G , d = ∅ ⇒ scons v ∅ ∈ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} $ by wcel_cab_intro (p := $ ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z) $) [m7, k7]
k9: $ G , d = ∅ ⇒ {y | ∃ h ∃ z (z ∊ csn ∅ ∧ h ∊ ihsp L gg tt d ∅ ∧ y = scons h z)} = ihv tr_nat_D K L gg tt N $ by eq_sym [m6]
k10: $ G , d = ∅ ⇒ scons v ∅ ∈ ihv tr_nat_D K L gg tt N $ by wcel_eq_r [k9, k8]
k11: $ G ⇒ scons v ∅ ∈ ihv tr_nat_D K L gg tt N $ by isset_elim [l0, k10]

--| Facts about the numbers one and two used below.
lemma e4_one (G: hyps): $ G ⇒ ∅ ∈ suc ∅ ∧ suc ∅ ∈ ω ∧ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
l1: $ G ⇒ ∅ ∈ suc ∅ $ by suc_mem [l0]
l2a: $ G ⇒ ∅ ∈ ω $ by omega_zero
l2: $ G ⇒ suc ∅ ∈ ω $ by omega_suc_c [l2a]
l3a: $ G ⇒ intys tr_nat_D = suc ∅ $ by nat_intys
l3b: $ G ⇒ suc ∅ = intys tr_nat_D $ by eq_sym [l3a]
l3: $ G ⇒ intys tr_nat_D ∈ ω $ by wcel_eq_l [l3b, l2]
l4: $ G ⇒ ∅ ∈ intys tr_nat_D $ by wcel_eq_r [l3b, l1]
l5: $ G ⇒ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by and_intro [l3, l4]
l6: $ G ⇒ suc ∅ ∈ ω ∧ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by and_intro [l2, l5]
l7: $ G ⇒ ∅ ∈ suc ∅ ∧ suc ∅ ∈ ω ∧ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by and_intro [l1, l6]

--| The motives' valuation at Nat: binder `0` is its one entry.
lemma e4_vat1 (G: hyps) (CV A J: class):
  $ G ⇒ CV = scons A ∅ $ > $ G ⇒ isset A $ > $ G ⇒ J = ∅ $ > $ G ⇒ vat CV (intys tr_nat_D) J = A $
----
l1: $ G ⇒ ∅ ∈ suc ∅ ∧ suc ∅ ∈ ω ∧ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by e4_one
l2a: $ G ⇒ suc ∅ ∈ ω ∧ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by and_elim_r [l1]
l2b: $ G ⇒ intys tr_nat_D ∈ ω ∧ ∅ ∈ intys tr_nat_D $ by and_elim_r [l2a]
l2: $ G ⇒ intys tr_nat_D ∈ ω $ by and_elim_l [l2b]
l3a: $ G ⇒ ∅ ∈ intys tr_nat_D $ by and_elim_r [l2b]
l3b: $ G ⇒ ∅ = J $ by eq_sym [#3]
l3: $ G ⇒ J ∈ intys tr_nat_D $ by wcel_eq_l [l3b, l3a]
l4: $ G ⇒ ∅ ∈ ω $ by omega_zero
l5a: $ G ⇒ suc J = suc ∅ $ by suc_eq [#3]
l5b: $ G ⇒ isset ∅ $ by ax_empty
l1b: $ G ⇒ suc ∅ ∈ ω $ by and_elim_l [l2a]
l5c: $ G ⇒ isset (suc ∅) $ by wcel_isset [l1b]
l5d: $ G ⇒ suc ∅ = suc J $ by eq_sym [l5a]
l5e: $ G ⇒ isset (suc J) $ by isset_eq [l5d, l5c]
l5f: $ G ⇒ nadd (suc J) ∅ = suc J $ by nadd_zero_c [l5e]
l5g: $ G ⇒ intys tr_nat_D = suc ∅ $ by nat_intys
l5h: $ G ⇒ suc ∅ = intys tr_nat_D $ by eq_sym [l5g]
l5i: $ G ⇒ nadd (suc J) ∅ = suc ∅ $ by eq_trans [l5f, l5a]
l5: $ G ⇒ nadd (suc J) ∅ = intys tr_nat_D $ by eq_trans [l5i, l5h]
l6: $ G ⇒ vat CV (intys tr_nat_D) J = fv CV ∅ $ by vat_eq [l3, l2, l4, l5]
l7r: $ G ⇒ ∅ = ∅ $ by eq_refl
l7: $ G ⇒ fv CV ∅ = fv (scons A ∅) ∅ $ by fv_eq [#1, l7r]
l8: $ G ⇒ fv (scons A ∅) ∅ = A $ by scons_fv_zero_c [#2, l5b]
l9: $ G ⇒ vat CV (intys tr_nat_D) J = fv (scons A ∅) ∅ $ by eq_trans [l6, l7]
l10: $ G ⇒ vat CV (intys tr_nat_D) J = A $ by eq_trans [l9, l8]

--| The motives as a relation at Nat's keys: the motive's values.
lemma e4_imrel_key (G: hyps) (CV: class) (m x: set):
  $ G ⇒ CV = scons m ∅ $ > $ G ⇒ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ = ap m x $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
l1i: $ G ⇒ isset x $ by isset_var
l1: $ G ⇒ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ = apn (vat CV (intys tr_nat_D) ∅) (scons x (cres ∅ (inidx tr_nat_D ∅))) $ by imrel_ap [l0, l0, l1i]
l2i: $ G ⇒ isset m $ by isset_var
l2r: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ vat CV (intys tr_nat_D) ∅ = m $ by e4_vat1 [#1, l2i, l2r]
l3a: $ G ⇒ cres ∅ (inidx tr_nat_D ∅) ⊆ ∅ $ by cres_subset
l3: $ G ⇒ cres ∅ (inidx tr_nat_D ∅) = ∅ $ by subset_empty [l3a]
l4r: $ G ⇒ x = x $ by eq_refl
l4: $ G ⇒ scons x (cres ∅ (inidx tr_nat_D ∅)) = scons x ∅ $ by scons_eq [l4r, l3]
l5: $ G ⇒ apn (vat CV (intys tr_nat_D) ∅) (scons x (cres ∅ (inidx tr_nat_D ∅))) = apn m (scons x ∅) $ by apn_eq [l2, l4]
l6: $ G ⇒ apn m (scons x ∅) = ap m x $ by apn_one [l1i]
l7: $ G ⇒ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ = apn m (scons x ∅) $ by eq_trans [l1, l5]
l8: $ G ⇒ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ = ap m x $ by eq_trans [l7, l6]

--| `nadd (suc J) k` is one only at `J = k = ∅`.
lemma e4_nadd_one (G: hyps) (J: class) (k: set):
  $ G ⇒ isset J $ > $ G ⇒ k ∊ ω $ > $ G ⇒ nadd (suc J) k = suc ∅ $ > $ G ⇒ J = ∅ ∧ k = ∅ $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
l1: $ G ⇒ k = ∅ ∨ ∃ y (y ∊ ω ∧ k = suc y) $ by omega_cases [#2]
la: $ G ⇒ isset (suc J) $ by suc_set [#1]
m1: $ G , k = ∅ ⇒ k = ∅ $ by ax
m2r: $ G , k = ∅ ⇒ suc J = suc J $ by eq_refl
m2: $ G , k = ∅ ⇒ nadd (suc J) k = nadd (suc J) ∅ $ by nadd_eq [m2r, m1]
m3a: $ G , k = ∅ ⇒ isset (suc J) $ by weaken [la]
m3: $ G , k = ∅ ⇒ nadd (suc J) ∅ = suc J $ by nadd_zero_c [m3a]
m4a: $ G , k = ∅ ⇒ suc J = nadd (suc J) ∅ $ by eq_sym [m3]
m4b: $ G , k = ∅ ⇒ nadd (suc J) ∅ = nadd (suc J) k $ by eq_sym [m2]
m4c: $ G , k = ∅ ⇒ suc J = nadd (suc J) k $ by eq_trans [m4a, m4b]
m4d: $ G , k = ∅ ⇒ nadd (suc J) k = suc ∅ $ by weaken [#3]
m4: $ G , k = ∅ ⇒ suc J = suc ∅ $ by eq_trans [m4c, m4d]
m5a: $ G , k = ∅ ⇒ isset J $ by weaken [#1]
m5b: $ G , k = ∅ ⇒ isset ∅ $ by ax_empty
m5: $ G , k = ∅ ⇒ J = ∅ $ by suc_inj_c [m5a, m5b, m4]
m6: $ G , k = ∅ ⇒ J = ∅ ∧ k = ∅ $ by and_intro [m5, m1]
n1: $ G , y ∊ ω ∧ k = suc y ⇒ y ∊ ω ∧ k = suc y $ by ax
n2: $ G , y ∊ ω ∧ k = suc y ⇒ y ∊ ω $ by and_elim_l [n1]
n3: $ G , y ∊ ω ∧ k = suc y ⇒ k = suc y $ by and_elim_r [n1]
n4r: $ G , y ∊ ω ∧ k = suc y ⇒ suc J = suc J $ by eq_refl
n4: $ G , y ∊ ω ∧ k = suc y ⇒ nadd (suc J) k = nadd (suc J) (suc y) $ by nadd_eq [n4r, n3]
n5a: $ G , y ∊ ω ∧ k = suc y ⇒ isset (suc J) $ by weaken [la]
n5b: $ G , y ∊ ω ∧ k = suc y ⇒ y ∈ ω $ by welc_wcel [n2]
n5: $ G , y ∊ ω ∧ k = suc y ⇒ nadd (suc J) (suc y) = suc (nadd (suc J) y) $ by nadd_suc_c [n5a, n5b]
n6a: $ G , y ∊ ω ∧ k = suc y ⇒ nadd (suc J) (suc y) = nadd (suc J) k $ by eq_sym [n4]
n6b: $ G , y ∊ ω ∧ k = suc y ⇒ suc (nadd (suc J) y) = nadd (suc J) (suc y) $ by eq_sym [n5]
n6c: $ G , y ∊ ω ∧ k = suc y ⇒ suc (nadd (suc J) y) = nadd (suc J) k $ by eq_trans [n6b, n6a]
n6d: $ G , y ∊ ω ∧ k = suc y ⇒ nadd (suc J) k = suc ∅ $ by weaken [#3]
n6: $ G , y ∊ ω ∧ k = suc y ⇒ suc (nadd (suc J) y) = suc ∅ $ by eq_trans [n6c, n6d]
n7b: $ G , y ∊ ω ∧ k = suc y ⇒ isset y $ by isset_var
n7a: $ G , y ∊ ω ∧ k = suc y ⇒ isset (nadd (suc J) y) $ by nadd_set_c [n5a, n7b]
n7c: $ G , y ∊ ω ∧ k = suc y ⇒ isset ∅ $ by ax_empty
n7: $ G , y ∊ ω ∧ k = suc y ⇒ nadd (suc J) y = ∅ $ by suc_inj_c [n7a, n7c, n6]
n8: $ G , y ∊ ω ∧ k = suc y ⇒ y = ∅ ∨ ∃ x (x ∊ ω ∧ y = suc x) $ by omega_cases [n2]
p1: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ y = ∅ $ by ax
p2r: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ suc J = suc J $ by eq_refl
p2: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ nadd (suc J) y = nadd (suc J) ∅ $ by nadd_eq [p2r, p1]
p3a: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ isset (suc J) $ by weaken [la]
p3: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ nadd (suc J) ∅ = suc J $ by nadd_zero_c [p3a]
p4a: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ nadd (suc J) y = suc J $ by eq_trans [p2, p3]
p4b: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ suc J = nadd (suc J) y $ by eq_sym [p4a]
p4c: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ nadd (suc J) y = ∅ $ by weaken [n7]
p4: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ suc J = ∅ $ by eq_trans [p4b, p4c]
p5: $ G , y ∊ ω ∧ k = suc y , y = ∅ ⇒ ⊥ $ by suc_ne_empty [p4]
q1: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ x ∊ ω ∧ y = suc x $ by ax
q2: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ y = suc x $ by and_elim_r [q1]
q2a: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ x ∊ ω $ by and_elim_l [q1]
q3r: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ suc J = suc J $ by eq_refl
q3: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ nadd (suc J) y = nadd (suc J) (suc x) $ by nadd_eq [q3r, q2]
q4a: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ isset (suc J) $ by weaken [la]
q4b: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ x ∈ ω $ by welc_wcel [q2a]
q4: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ nadd (suc J) (suc x) = suc (nadd (suc J) x) $ by nadd_suc_c [q4a, q4b]
q5a: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ nadd (suc J) y = suc (nadd (suc J) x) $ by eq_trans [q3, q4]
q5b: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ suc (nadd (suc J) x) = nadd (suc J) y $ by eq_sym [q5a]
q5c: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ nadd (suc J) y = ∅ $ by weaken [n7]
q5: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ suc (nadd (suc J) x) = ∅ $ by eq_trans [q5b, q5c]
q6: $ G , y ∊ ω ∧ k = suc y , x ∊ ω ∧ y = suc x ⇒ ⊥ $ by suc_ne_empty [q5]
q7a: $ G , y ∊ ω ∧ k = suc y , ∃ x (x ∊ ω ∧ y = suc x) ⇒ ∃ x (x ∊ ω ∧ y = suc x) $ by ax
q7: $ G , y ∊ ω ∧ k = suc y , ∃ x (x ∊ ω ∧ y = suc x) ⇒ ⊥ $ by ex_elim [q7a, q6]
q8: $ G , y ∊ ω ∧ k = suc y ⇒ ⊥ $ by or_elim [n8, p5, q7]
q9: $ G , y ∊ ω ∧ k = suc y ⇒ J = ∅ ∧ k = ∅ $ by bot_elim [q8]
r1: $ G , ∃ y (y ∊ ω ∧ k = suc y) ⇒ ∃ y (y ∊ ω ∧ k = suc y) $ by ax
r2: $ G , ∃ y (y ∊ ω ∧ k = suc y) ⇒ J = ∅ ∧ k = ∅ $ by ex_elim [r1, q9]
r3: $ G ⇒ J = ∅ ∧ k = ∅ $ by or_elim [l1, m6, r2]

--| At Nat the motives' relation has a set of values at every point.
lemma e4_imrel_set {e: set} (G: hyps) (CV: class) (u m: set):
  $ G ⇒ universe u $ > $ G ⇒ CV = scons m ∅ $ > $ G ⇒ m ∊ u $ > $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $
----
n0: $ G , o ∊ ap (imrel tr_nat_D CV) e ⇒ o ∊ ap (imrel tr_nat_D CV) e $ by ax
n1: $ G , o ∊ ap (imrel tr_nat_D CV) e ⇒ ⟨ e , o ⟩ ∈ imrel tr_nat_D CV $ by ap_elim [n0]
k1: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV ⇒ v ∊ {z | ∃ j ∃ a ∃ x ∃ y (z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))))} $ by ax
k2: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV ⇒ ∃ j ∃ a ∃ x ∃ y (v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j)))) $ by cab_elim [k1]
j1: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) $ by ax
j1a: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ $ by and_elim_l [j1]
j1b: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) $ by and_elim_r [j1]
j1c: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ v = ⟨ e , o ⟩ $ by ax
j1d: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ ⟨ e , o ⟩ = v $ by eq_sym [j1c]
j2: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ ⟨ e , o ⟩ = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ $ by eq_trans [j1d, j1a]
i0: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ isset e $ by isset_var
i1: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ isset o $ by isset_var
i2: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ isset ⟨ j , ⟨ a , x ⟩ ⟩ $ by opair_isset
i3: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ isset y $ by isset_var
j3: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ e = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ o = y $ by opair_inj_c [j2, i0, i1, i2, i3]
j3a: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ o = y $ by and_elim_r [j3]
j4: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ y ∈ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) $ by welc_wcel [j1b]
j4a: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ y ∈ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ↔ nest (scons x (cres a (inidx tr_nat_D j))) y ∈ vat CV (intys tr_nat_D) j $ by apn_wcel [i3]
j5: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) ⇒ nest (scons x (cres a (inidx tr_nat_D j))) y ∈ vat CV (intys tr_nat_D) j $ by bi_elim_l [j4a, j4]
h0: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j ⇒ w ∊ {y | ∃ k (k ∊ ω ∧ nadd (suc j) k = intys tr_nat_D ∧ y ∊ fv CV k)} $ by ax
h0a: $ G , o ∊ ap (imrel tr_nat_D CV) e , v = ⟨ e , o ⟩ , v ∊ imrel tr_nat_D CV , v = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat CV (intys tr_nat_D) j) (scons x (cres a (inidx tr_nat_D j))) , w = nest (scons x (cres a (inidx tr_nat_D j))) y , w ∊ vat CV (intys tr_nat_D) j ⇒ ∃ k (k ∊ ω ∧ nadd (suc j) k = intys tr_nat_D ∧ w ∊ fv CV k) $ by cab_elim [h0]
