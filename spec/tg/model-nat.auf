v8: $ G , v ∊ csn ∅ × (csn ∅ × nnat) , v = ⟨ a , b ⟩ , a ∊ csn ∅ , b ∊ csn ∅ × nnat ⇒ v ∊ ifam u (dnf u M) tr_nat_D w $ by cxp_elim [v8a, v7]
v9a: $ G , v ∊ csn ∅ × (csn ∅ × nnat) ⇒ v ∊ csn ∅ × (csn ∅ × nnat) $ by ax
v9: $ G , v ∊ csn ∅ × (csn ∅ × nnat) ⇒ v ∊ ifam u (dnf u M) tr_nat_D w $ by cxp_elim [v9a, v8]
v10: $ G ⇒ csn ∅ × (csn ∅ × nnat) ⊆ ifam u (dnf u M) tr_nat_D w $ by subset_intro [v9]
z1: $ G ⇒ ifam u (dnf u M) tr_nat_D w = csn ∅ × (csn ∅ × nnat) $ by subset_antisym [s1, v10]

lemma e3_ient_NN (G: hyps) (W: class): $ G ⇒ W ∈ lvals $ > $ G ⇒ ient tr_nat_D W (csn ∅ × (csn ∅ × nnat)) ∅ = nnat $
----
a1: $ G ⇒ csn ∅ × (csn ∅ × nnat) ⊆ csn ∅ × (csn ∅ × nnat) $ by subset_refl
a2: $ G ⇒ ient tr_nat_D W (csn ∅ × (csn ∅ × nnat)) ∅ ⊆ nnat $ by e3_ient_N [#1, a1]
b1: $ G , y ∊ nnat , o = ∅ ⇒ o = ∅ $ by ax
b2: $ G , y ∊ nnat , o = ∅ ⇒ o ∊ csn ∅ $ by csn_intro [b1]
b3: $ G , y ∊ nnat , o = ∅ ⇒ y ∊ nnat $ by ax
b4: $ G , y ∊ nnat , o = ∅ ⇒ ⟨ o , y ⟩ ∈ csn ∅ × nnat $ by cxp_intro [b2, b3]
b5a: $ G , y ∊ nnat , o = ∅ ⇒ isset ∅ $ by ax_empty
b5b: $ G , y ∊ nnat , o = ∅ ⇒ ∅ ∈ csn ∅ $ by cpr_intro_l_c [b5a]
b5: $ G , y ∊ nnat , o = ∅ ⇒ ⟨ ∅ , ⟨ o , y ⟩ ⟩ ∈ csn ∅ × (csn ∅ × nnat) $ by cxp_intro_c [b5b, b4]
b6a: $ G , y ∊ nnat , o = ∅ ⇒ W ∈ lvals $ by weaken [#1]
b6: $ G , y ∊ nnat , o = ∅ ⇒ ¬ iprop tr_nat_D ∅ W $ by nat_not_iprop [b6a]
b7: $ G , y ∊ nnat , o = ∅ ⇒ nest o y ∈ ient tr_nat_D W (csn ∅ × (csn ∅ × nnat)) ∅ $ by ient_intro [b5, b6]
b8a: $ G , y ∊ nnat , o = ∅ ⇒ y = y $ by eq_refl
b8b: $ G , y ∊ nnat , o = ∅ ⇒ nest o y = nest ∅ y $ by nest_eq [b1, b8a]
b8c: $ G , y ∊ nnat , o = ∅ ⇒ isset y $ by isset_var
b8d: $ G , y ∊ nnat , o = ∅ ⇒ nest ∅ y = y $ by nest_empty [b8c]
b8: $ G , y ∊ nnat , o = ∅ ⇒ nest o y = y $ by eq_trans [b8b, b8d]
b9: $ G , y ∊ nnat , o = ∅ ⇒ y ∈ ient tr_nat_D W (csn ∅ × (csn ∅ × nnat)) ∅ $ by wcel_eq_l [b8, b7]
b10: $ G , y ∊ nnat , o = ∅ ⇒ y ∊ ient tr_nat_D W (csn ∅ × (csn ∅ × nnat)) ∅ $ by wcel_welc [b9]
b11a: $ G , y ∊ nnat ⇒ isset ∅ $ by ax_empty
b11: $ G , y ∊ nnat ⇒ y ∊ ient tr_nat_D W (csn ∅ × (csn ∅ × nnat)) ∅ $ by isset_elim [b11a, b10]
b12: $ G ⇒ nnat ⊆ ient tr_nat_D W (csn ∅ × (csn ∅ × nnat)) ∅ $ by subset_intro [b11]
b13: $ G ⇒ ient tr_nat_D W (csn ∅ × (csn ∅ × nnat)) ∅ = nnat $ by subset_antisym [a2, b12]

lemma e3_I_u (G: hyps) (M: class) (u w: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ifam u (dnf u M) tr_nat_D w ∈ u $
----
a1: $ G ⇒ universe u $ by uadm_universe [#1]
a2: $ G ⇒ ∅ ∈ u $ by uadm_empty [#1]
a3: $ G ⇒ csn ∅ ∈ u $ by universe_cpr_c [a1, a2, a2]
a4: $ G ⇒ nnat ∈ u $ by nnat_u [#1]
a5: $ G ⇒ csn ∅ × nnat ∈ u $ by universe_cxp_c [a1, a3, a4]
a6: $ G ⇒ csn ∅ × (csn ∅ × nnat) ∈ u $ by universe_cxp_c [a1, a3, a5]
a7: $ G ⇒ ifam u (dnf u M) tr_nat_D w = csn ∅ × (csn ∅ × nnat) $ by nat_ifam [#1, #2]
a8: $ G ⇒ csn ∅ × (csn ∅ × nnat) = ifam u (dnf u M) tr_nat_D w $ by eq_sym [a7]
a9: $ G ⇒ ifam u (dnf u M) tr_nat_D w ∈ u $ by wcel_eq_l [a8, a6]

nat_ity
-------
a1: $ G ⇒ ifam u (dnf u M) tr_nat_D w = csn ∅ × (csn ∅ × nnat) $ by nat_ifam [#1, #2]
a2: $ G ⇒ tr_nat_D = tr_nat_D $ by eq_refl
a3: $ G ⇒ w = w $ by eq_refl
a4: $ G ⇒ ∅ = ∅ $ by eq_refl
a5: $ G ⇒ ient tr_nat_D w (ifam u (dnf u M) tr_nat_D w) ∅ = ient tr_nat_D w (csn ∅ × (csn ∅ × nnat)) ∅ $ by ient_eq [a2, a3, a1, a4]
a6: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
a7: $ G ⇒ ient tr_nat_D w (csn ∅ × (csn ∅ × nnat)) ∅ = nnat $ by e3_ient_NN [a6]
a8: $ G ⇒ ity u (dnf u M) tr_nat_D ∅ w = nnat $ by eq_trans [a5, a7]

nat_igate
