--| The paths of `zero`'s type and of Nat's type: one, with nothing.
lemma e4_k0_elim (G: hyps) (M K P: class) (u w f g t a: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ K = tn_K0 $ >
  $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ > $ G ⇒ f = ∅ ∧ g = ∅ ∧ t = ∅ ∧ a = ∅ $
----
l0: $ G ⇒ (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by eq_refl
l1zq1: $ G ⇒ w = w $ by eq_refl
l1: $ G ⇒ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = etel u (dnf u M) tn_K0 w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by etel_eq [#4, l1zq1, l0]
l2: $ G ⇒ (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∈ fseq u $ by e4_RRseq [#1, #2, #3]
l3a: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
l3: $ G ⇒ etel u (dnf u M) tn_K0 w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = csn ept0 $ by nat_etel_K0 [l3a, l2]
l4: $ G ⇒ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = csn ept0 $ by eq_trans [l1, l3]
l5: $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ csn ept0 $ by wcel_eq_r [l4, #5]
l6: $ G ⇒ f = ∅ ∧ g = ∅ ∧ t = ∅ ∧ a = ∅ $ by ept0_elim [l5]

