k8c: $ G , o = ∅ ⇒ scat ∅ (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) = ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w) $ by scat_empty_l_c [k7]
k8: $ G , o = ∅ ⇒ scat o (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w)) = ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w) $ by eq_trans [k8b, k8c]
