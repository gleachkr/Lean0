  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∈ fseq u $
----
l1: $ G ⇒ (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = scons nnat ∅ $ by e4_RR [#1, #2, #3]
l6: $ G ⇒ nnat ∈ u $ by nnat_u [#1]
