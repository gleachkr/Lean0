lemma e2_isort_F (G: hyps) (f k l: set): $ G ⇒ f = tn_F $ > $ G ⇒ ra_isort f k l ∈ lrel $ > $ G ⇒ k = e2_N0 ∧ l = e2_L $
----
l1: $ G ⇒ ∃ x1 (f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1) ∨ ∃ x2 ∃ x3 ∃ x4 ∃ x1 (f = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ k = ⟨ kc_s , scons x4 ∅ ⟩ ∧ l = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) $ by lrel_isort_cases [#2]
l2: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 $ by ax
l3: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ f = ⟨ kc_srt , scons x1 ∅ ⟩ $ by and_elim_l [l2]
l4: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ f = tn_F $ by weaken [#1]
l5: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ tn_F = f $ by eq_sym [l4]
l6: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ ⟨ kc_srt , scons e2_L ∅ ⟩ = ⟨ kc_srt , scons x1 ∅ ⟩ $ by eq_trans [l5, l3]
l7: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ isset kc_srt $ by e2_is_kc_srt
l8: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ isset e2_L $ by e2_is_L
l9: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ e2_L = x1 $ by node1_inj_c [l7, l8, l6]
l10: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 $ by ax
l11: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 $ by and_elim_r [l10]
l12: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ k = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l11]
l13: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ ⟨ kc_nz , ∅ ⟩ = e2_N0 $ by eq_refl
l14: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ k = e2_N0 $ by eq_trans [l12, l13]
l15: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 $ by ax
l16: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 $ by and_elim_r [l15]
l17: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ l = x1 $ by and_elim_r [l16]
l18: $ G , f = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x1 ⇒ x1 = e2_L $ by eq_sym [l9]
