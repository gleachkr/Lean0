lemma e4_bq0_val (G: hyps) (I C CV g a: class) (w m: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = ∅ $ > $ G ⇒ CV = scons m ∅ $ > $ G ⇒ g = ∅ $ > $ G ⇒ a = ∅ $ >
  $ G ⇒ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))) = ap m nzr $
----
v1i: $ G ⇒ isset m $ by isset_var
v1: $ G ⇒ vat CV (intys tr_nat_D) I = m $ by e4_vat1 [#4, v1i, #2]
v2a: $ G ⇒ w ∈ lvals $ by welc_wcel [#1]
v2b: $ G ⇒ ¬ iprop tr_nat_D I w $ by nat_not_iprop [v2a]
v2c: $ G ⇒ isset ∅ $ by ax_empty
v2x: $ G ⇒ ∅ = g $ by eq_sym [#5]
v2e: $ G ⇒ isset g $ by isset_eq [v2x, v2c]
v2d: $ G ⇒ isset (scons C g) $ by scons_set [v2e]
v2f: $ G ⇒ itup tr_nat_D I C g w = scons C g $ by itup_nprop [v2b, v2d]
v2g: $ G ⇒ scons C g = scons (∅) (∅) $ by scons_eq [#3, #5]
v2: $ G ⇒ itup tr_nat_D I C g w = scons (∅) (∅) $ by eq_trans [v2f, v2g]
v3r: $ G ⇒ inidx tr_nat_D I = inidx tr_nat_D I $ by eq_refl
v3a: $ G ⇒ cres a (inidx tr_nat_D I) = cres ∅ (inidx tr_nat_D I) $ by cres_eq [#6, v3r]
v3b: $ G ⇒ cres ∅ (inidx tr_nat_D I) ⊆ ∅ $ by cres_subset
v3c: $ G ⇒ cres ∅ (inidx tr_nat_D I) = ∅ $ by subset_empty [v3b]
v3: $ G ⇒ cres a (inidx tr_nat_D I) = ∅ $ by eq_trans [v3a, v3c]
v4: $ G ⇒ scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I)) = scons (scons (∅) (∅)) ∅ $ by scons_eq [v2, v3]
v5: $ G ⇒ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))) = apn m (scons (scons (∅) (∅)) ∅) $ by apn_eq [v1, v4]
v6j: $ G ⇒ isset (∅) $ by ax_empty
v6i: $ G ⇒ isset (scons (∅) (∅)) $ by scons_set [v6j]
v6: $ G ⇒ apn m (scons (scons (∅) (∅)) ∅) = ap m (scons (∅) (∅)) $ by apn_one [v6i]
v7: $ G ⇒ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))) = ap m nzr $ by eq_trans [v5, v6]

lemma e4_bq1_val (G: hyps) (I C CV g a: class) (w m x: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = suc ∅ $ > $ G ⇒ CV = scons m ∅ $ > $ G ⇒ g = scons x ∅ $ > $ G ⇒ a = ∅ $ >
  $ G ⇒ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))) = ap m (nsc x) $
----
v1i: $ G ⇒ isset m $ by isset_var
v1: $ G ⇒ vat CV (intys tr_nat_D) I = m $ by e4_vat1 [#4, v1i, #2]
v2a: $ G ⇒ w ∈ lvals $ by welc_wcel [#1]
v2b: $ G ⇒ ¬ iprop tr_nat_D I w $ by nat_not_iprop [v2a]
v2c: $ G ⇒ isset ∅ $ by ax_empty
v2y: $ G ⇒ isset (scons x ∅) $ by scons_set [v2c]
v2x: $ G ⇒ scons x ∅ = g $ by eq_sym [#5]
v2e: $ G ⇒ isset g $ by isset_eq [v2x, v2y]
v2d: $ G ⇒ isset (scons C g) $ by scons_set [v2e]
v2f: $ G ⇒ itup tr_nat_D I C g w = scons C g $ by itup_nprop [v2b, v2d]
v2g: $ G ⇒ scons C g = scons (suc ∅) (scons x ∅) $ by scons_eq [#3, #5]
v2: $ G ⇒ itup tr_nat_D I C g w = scons (suc ∅) (scons x ∅) $ by eq_trans [v2f, v2g]
v3r: $ G ⇒ inidx tr_nat_D I = inidx tr_nat_D I $ by eq_refl
v3a: $ G ⇒ cres a (inidx tr_nat_D I) = cres ∅ (inidx tr_nat_D I) $ by cres_eq [#6, v3r]
v3b: $ G ⇒ cres ∅ (inidx tr_nat_D I) ⊆ ∅ $ by cres_subset
v3c: $ G ⇒ cres ∅ (inidx tr_nat_D I) = ∅ $ by subset_empty [v3b]
v3: $ G ⇒ cres a (inidx tr_nat_D I) = ∅ $ by eq_trans [v3a, v3c]
v4: $ G ⇒ scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I)) = scons (scons (suc ∅) (scons x ∅)) ∅ $ by scons_eq [v2, v3]
v5: $ G ⇒ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))) = apn m (scons (scons (suc ∅) (scons x ∅)) ∅) $ by apn_eq [v1, v4]
v6j: $ G ⇒ isset (scons x ∅) $ by scons_set [v2c]
v6i: $ G ⇒ isset (scons (suc ∅) (scons x ∅)) $ by scons_set [v6j]
v6: $ G ⇒ apn m (scons (scons (suc ∅) (scons x ∅)) ∅) = ap m (scons (suc ∅) (scons x ∅)) $ by apn_one [v6i]
v7: $ G ⇒ apn (vat CV (intys tr_nat_D) I) (scons (itup tr_nat_D I C g w) (cres a (inidx tr_nat_D I))) = ap m (nsc x) $ by eq_trans [v5, v6]

--| The paths of `succ`'s minor: the field, then its hypothesis.
lemma e4_iminq1_intro {e: set} (G: hyps) (M I C P CV: class) (u w x c: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ I = ∅ $ > $ G ⇒ C = suc ∅ $ > $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ >
  $ G ⇒ x ∊ nnat $ > $ G ⇒ c ∊ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ > $ G ⇒ scat (scons c ∅) (scons x ∅) ∈ iminq u (dnf u M) tr_nat_D I C w P CV $
----
s0: $ G ⇒ isset tn_K1 $ by opair_isset
s1a: $ G , o = tn_K1 ⇒ isset ∅ $ by ax_empty
s1: $ G , o = tn_K1 ⇒ isset (scons x ∅) $ by scons_set [s1a]
s2a: $ G , o = tn_K1 , f = scons x ∅ ⇒ isset ∅ $ by ax_empty
s2: $ G , o = tn_K1 , f = scons x ∅ ⇒ isset (scons (csn ept0) ∅) $ by scons_set [s2a]
s3: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ ⇒ isset ∅ $ by ax_empty
s4a: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ ⇒ isset ∅ $ by ax_empty
s4: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ ⇒ isset (scons c ∅) $ by scons_set [s4a]
g1: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ uadm u $ by weaken [#1]
g2: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ w ∊ lvals $ by weaken [#2]
g3: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ P = ∅ $ by weaken [#3]
g4: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ I = ∅ $ by weaken [#4]
g5: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ C = suc ∅ $ by weaken [#5]
g6: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by weaken [#6]
g7: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ x ∊ nnat $ by weaken [#7]
g8: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ c ∊ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by weaken [#8]
e1: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ o = tn_K1 $ by ax
e2: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ f = scons x ∅ $ by ax
e3: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ t = scons (csn ept0) ∅ $ by ax
e4: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ x6 = ∅ $ by ax
e5: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ h = scons c ∅ $ by ax
k1a: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ictk tr_nat_D ∅ (suc ∅) tn_K1 $ by nat_ictk1
k1b: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ tr_nat_D = tr_nat_D $ by eq_refl
k1c: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ∅ = I $ by eq_sym [g4]
k1d: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ suc ∅ = C $ by eq_sym [g5]
k1e: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ tn_K1 = o $ by eq_sym [e1]
k1: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ictk tr_nat_D I C o $ by ictk_eq [k1b, k1c, k1d, k1e, k1a]
k2a: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ⟨ scons x ∅ , ⟨ scons x ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by e4_k1_intro [g1, g2, g3, e1, g7]
k2b: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ⟨ t , x6 ⟩ = ⟨ scons (csn ept0) ∅ , ∅ ⟩ $ by opair_eq [e3, e4]
k2c: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ⟨ f , ⟨ t , x6 ⟩ ⟩ = ⟨ scons x ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ $ by opair_eq [e2, k2b]
k2d: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ⟨ f , ⟨ f , ⟨ t , x6 ⟩ ⟩ ⟩ = ⟨ scons x ∅ , ⟨ scons x ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ $ by opair_eq [e2, k2c]
k2e: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ⟨ scons x ∅ , ⟨ scons x ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ = ⟨ f , ⟨ f , ⟨ t , x6 ⟩ ⟩ ⟩ $ by eq_sym [k2d]
k2: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ⟨ f , ⟨ f , ⟨ t , x6 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by wcel_eq_l [k2e, k2a]
k3a: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ cdm f = cdm (scons x ∅) $ by cdm_eq [e2]
k3b: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ cdm (scons x ∅) = suc ∅ $ by scons_empty_len
k3c: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ cdm f = suc ∅ $ by eq_trans [k3a, k3b]
k3d: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ scons c ∅ ∈ ihv tr_nat_D o (imrel tr_nat_D CV) f t (cdm f) $ by e4_ihv1_intro [e1, e3, e2, k3c, g6, g8]
k3e: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ scons c ∅ = h $ by eq_sym [e5]
k3f: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ h ∈ ihv tr_nat_D o (imrel tr_nat_D CV) f t (cdm f) $ by wcel_eq_l [k3e, k3d]
k3: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ h ∊ ihv tr_nat_D o (imrel tr_nat_D CV) f t (cdm f) $ by wcel_welc [k3f]
k4: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ z = scat h f $ by ax
k1w: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ ictk tr_nat_D I C o $ by weaken [k1]
k2w: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ ⟨ f , ⟨ f , ⟨ t , x6 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by weaken [k2]
k3w: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ h ∊ ihv tr_nat_D o (imrel tr_nat_D CV) f t (cdm f) $ by weaken [k3]
k5: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ z ∊ iminq u (dnf u M) tr_nat_D I C w P CV $ by iminq_intro [k1w, k2w, k3w, k4]
k6a: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ h = scons c ∅ $ by weaken [e5]
k6b: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ f = scons x ∅ $ by weaken [e2]
k6c: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ scat h f = scat (scons c ∅) (scons x ∅) $ by scat_eq [k6a, k6b]
k6d: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ z = scat (scons c ∅) (scons x ∅) $ by eq_trans [k4, k6c]
k6: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ , z = scat h f ⇒ scat (scons c ∅) (scons x ∅) ∈ iminq u (dnf u M) tr_nat_D I C w P CV $ by wcel_intro [k6d, k5]
q1c: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ isset c $ by isset_var
q1b: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ c ∈ cpr c x $ by cpr_intro_l_c [q1c]
q1d: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ ∅ ∈ fseq (cpr c x) $ by fseq_empty
q1a: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ scons c ∅ ∈ fseq (cpr c x) $ by scons_fseq_c [q1b, q1d]
q1: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ h ∈ fseq (cpr c x) $ by wcel_eq_l [k3e, q1a]
q2c: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ isset x $ by isset_var
q2b: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ x ∈ cpr c x $ by cpr_intro_r_c [q2c]
q2a: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ scons x ∅ ∈ fseq (cpr c x) $ by scons_fseq_c [q2b, q1d]
q2e: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ scons x ∅ = f $ by eq_sym [e2]
q2: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ f ∈ fseq (cpr c x) $ by wcel_eq_l [q2e, q2a]
q3a: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ h ∊ fseq (cpr c x) $ by wcel_welc [q1]
q3b: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ f ∊ fseq (cpr c x) $ by wcel_welc [q2]
q3c: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ scat h f ∈ fseq (cpr c x) $ by scat_fseq [q3a, q3b]
q3: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ isset (scat h f) $ by wcel_isset [q3c]
r0: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ , h = scons c ∅ ⇒ scat (scons c ∅) (scons x ∅) ∈ iminq u (dnf u M) tr_nat_D I C w P CV $ by isset_elim [q3, k6]
r1: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ , x6 = ∅ ⇒ scat (scons c ∅) (scons x ∅) ∈ iminq u (dnf u M) tr_nat_D I C w P CV $ by isset_elim [s4, r0]
r2: $ G , o = tn_K1 , f = scons x ∅ , t = scons (csn ept0) ∅ ⇒ scat (scons c ∅) (scons x ∅) ∈ iminq u (dnf u M) tr_nat_D I C w P CV $ by isset_elim [s3, r1]
