c6: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ = ⟨ j , ient tr_nat_D W Z j ⟩ $ by opair_eq [c4, c5]
c7: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ v = ⟨ j , ient tr_nat_D W Z j ⟩ $ by eq_trans [c2, c6]
c8: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ j ∊ suc ∅ $ by suc_intro_r [c3]
c9a: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ intys tr_nat_D = suc ∅ $ by nat_intys
c9b: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ suc ∅ = intys tr_nat_D $ by eq_sym [c9a]
c9: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ j ∊ intys tr_nat_D $ by welc_eq [c9b, c8]
c10: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ j ∊ intys tr_nat_D ∧ v = ⟨ j , ient tr_nat_D W Z j ⟩ $ by and_intro [c9, c7]
c11: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ ∃ j (j ∊ intys tr_nat_D ∧ v = ⟨ j , ient tr_nat_D W Z j ⟩) $ by ex_intro [c10]
c12: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ , j = ∅ ⇒ v ∊ ixs tr_nat_D W Z $ by cab_intro [c11]
c13a: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ ⇒ isset ∅ $ by ax_empty
c13: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ csn ⟨ ∅ , ient tr_nat_D W Z ∅ ⟩ ⇒ v ∊ ixs tr_nat_D W Z $ by isset_elim [c13a, c12]
d0: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} , v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅ ⇒ v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅ $ by ax
d1: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} , v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅ ⇒ ⟨ i , y ⟩ ∈ ∅ $ by and_elim_r [d0]
d2a: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} , v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅ , e = ⟨ i , y ⟩ , e ∊ ∅ ⇒ e ∊ ∅ $ by ax
d2b: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} , v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅ , e = ⟨ i , y ⟩ , e ∊ ∅ ⇒ ⊥ $ by empty_elim [d2a]
d2: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} , v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅ ⇒ ⊥ $ by wcel_elim [d1, d2b]
d3: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} , v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅ ⇒ v ∊ ixs tr_nat_D W Z $ by bot_elim [d2]
d4a: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} , ∃ y (v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅) ⇒ ∃ y (v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅) $ by ax
d4: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} , ∃ y (v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅) ⇒ v ∊ ixs tr_nat_D W Z $ by ex_elim [d4a, d3]
d5a: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} ⇒ v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} $ by ax
d5b: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} ⇒ ∃ i ∃ y (v = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅) $ by cab_elim [d5a]
d5: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ , v ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ ∅)} ⇒ v ∊ ixs tr_nat_D W Z $ by ex_elim [d5b, d4]
bw: $ G , v ∊ scons (ient tr_nat_D W Z ∅) ∅ ⇒ v ∊ ixs tr_nat_D W Z $ by or_elim [b2, c13, d5]
z1: $ G ⇒ ixs tr_nat_D W Z = scons (ient tr_nat_D W Z ∅) ∅ $ by eq_intro [fw, bw]

lemma e3_rx (G: hyps) (W Z: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ ixs tr_nat_D W Z ∈ fseq u $
----
a1: $ G ⇒ universe u $ by uadm_universe [#1]
a2a: $ G , j ∊ intys tr_nat_D ⇒ universe u $ by weaken [a1]
a2b: $ G , j ∊ intys tr_nat_D ⇒ Z ∈ u $ by weaken [#2]
a2c: $ G , j ∊ intys tr_nat_D ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by weaken [#3]
a2: $ G , j ∊ intys tr_nat_D ⇒ ient tr_nat_D W Z j ∈ u $ by ient_universe [a2a, a2b, a2c]
a3: $ G ⇒ j ∊ intys tr_nat_D → ient tr_nat_D W Z j ∈ u $ by imp_intro [a2]
a4: $ G ⇒ ∀ j (j ∊ intys tr_nat_D → ient tr_nat_D W Z j ∈ u) $ by all_intro [a3]
a5: $ G ⇒ intys tr_nat_D = suc ∅ $ by nat_intys
a5b: $ G ⇒ suc ∅ = intys tr_nat_D $ by eq_sym [a5]
a6a: $ G ⇒ ∅ ∈ ω $ by omega_zero
a6: $ G ⇒ suc ∅ ∈ ω $ by omega_suc_c [a6a]
a7: $ G ⇒ intys tr_nat_D ∈ ω $ by wcel_eq_l [a5b, a6]
a8: $ G ⇒ ixs tr_nat_D W Z ∈ fseq u $ by ixs_fseq [a4, a7]

lemma e3_rx0 (G: hyps) (W Z: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ fv (ixs tr_nat_D W Z) ∅ = ient tr_nat_D W Z ∅ $
----
a1: $ G ⇒ universe u $ by uadm_universe [#1]
a2: $ G ⇒ ient tr_nat_D W Z ∅ ∈ u $ by ient_universe [a1, #2, #3]
a3: $ G ⇒ isset (ient tr_nat_D W Z ∅) $ by wcel_isset [a2]
a4: $ G ⇒ isset ∅ $ by ax_empty
a5: $ G ⇒ fv (scons (ient tr_nat_D W Z ∅) ∅) ∅ = ient tr_nat_D W Z ∅ $ by scons_fv_zero_c [a3, a4]
a6: $ G ⇒ ixs tr_nat_D W Z = scons (ient tr_nat_D W Z ∅) ∅ $ by nat_ixs
a7: $ G ⇒ ∅ = ∅ $ by eq_refl
a8: $ G ⇒ fv (ixs tr_nat_D W Z) ∅ = fv (scons (ient tr_nat_D W Z ∅) ∅) ∅ $ by fv_eq [a6, a7]
a9: $ G ⇒ fv (ixs tr_nat_D W Z) ∅ = ient tr_nat_D W Z ∅ $ by eq_trans [a8, a5]

lemma e3_iop0_case {y: set} (G: hyps) (M Z: class) (u w z p q e j c k f g t a: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ iprt tr_nat_D q e $ > $ G ⇒ p ∊ esat u (dnf u M) q w $ > $ G ⇒ ictk tr_nat_D j c k $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) k w (scat p (ixs tr_nat_D w Z)) $ > $ G ⇒ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ $ > $ G ⇒ z = ⟨ ∅ , ⟨ ∅ , nzr ⟩ ⟩ ∨ ∃ y (y ∊ ient tr_nat_D w Z ∅ ∧ z = ⟨ ∅ , ⟨ ∅ , nsc y ⟩ ⟩) $
----
b1: $ G ⇒ q = tn_P ∧ e = tn_T $ by nat_iprt_det [#5]
b2: $ G ⇒ q = tn_P $ by and_elim_l [b1]
