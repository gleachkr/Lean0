l29: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel ⇒ tn_T = t $ by eq_sym [l28]
