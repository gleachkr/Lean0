l29: $ G , a = tn_P , b = tn_T , d = e2_N0 , f = tn_F , g = e2_C , h = e2_N1 ⇒ ra_nth_ctor e2_C e2_N1 tn_K1 = ra_nth_ctor g h tn_K1 $ by ra_nth_ctor_eq [l11, l12, l28]
l30: $ G , a = tn_P , b = tn_T , d = e2_N0 , f = tn_F , g = e2_C , h = e2_N1 ⇒ ra_nth_ctor g h tn_K1 ∈ lrel $ by wcel_eq_l [l29, l27]
l31: $ G , a = tn_P , b = tn_T , d = e2_N0 , f = tn_F , g = e2_C , h = e2_N1 ⇒ ictk tr_nat_D ∅ (suc ∅) tn_K1 $ by ictk_intro [l15, l19, l22, l26, l30]
l32: $ G , a = tn_P , b = tn_T , d = e2_N0 , f = tn_F , g = e2_C ⇒ isset e2_N1 $ by e2_is_N1
l33: $ G , a = tn_P , b = tn_T , d = e2_N0 , f = tn_F , g = e2_C ⇒ ictk tr_nat_D ∅ (suc ∅) tn_K1 $ by isset_elim [l32, l31]
l34: $ G , a = tn_P , b = tn_T , d = e2_N0 , f = tn_F ⇒ isset e2_C $ by e2_is_C
l35: $ G , a = tn_P , b = tn_T , d = e2_N0 , f = tn_F ⇒ ictk tr_nat_D ∅ (suc ∅) tn_K1 $ by isset_elim [l34, l33]
l36: $ G , a = tn_P , b = tn_T , d = e2_N0 ⇒ isset tn_F $ by e2_is_F
l37: $ G , a = tn_P , b = tn_T , d = e2_N0 ⇒ ictk tr_nat_D ∅ (suc ∅) tn_K1 $ by isset_elim [l36, l35]
l38: $ G , a = tn_P , b = tn_T ⇒ isset e2_N0 $ by e2_is_N0
l39: $ G , a = tn_P , b = tn_T ⇒ ictk tr_nat_D ∅ (suc ∅) tn_K1 $ by isset_elim [l38, l37]
l40: $ G , a = tn_P ⇒ isset tn_T $ by e2_is_T
l41: $ G , a = tn_P ⇒ ictk tr_nat_D ∅ (suc ∅) tn_K1 $ by isset_elim [l40, l39]
l42: $ G ⇒ isset tn_P $ by e2_is_P
l43: $ G ⇒ ictk tr_nat_D ∅ (suc ∅) tn_K1 $ by isset_elim [l42, l41]

lemma e2_nctor_nil (G: hyps) (t i k: set): $ G ⇒ t = e2_cnil $ > $ G ⇒ ra_nth_ctor t i k ∈ lrel $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by lrel_nth_ctor_cases [#2]
l2: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by ax
l3: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = e2_cnil $ by weaken [#1]
l5: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ e2_cnil = t $ by eq_sym [l4]
l6: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ ⟨ kc_cnil , ∅ ⟩ = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by eq_trans [l5, l3]
l7: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ ⊥ $ by e2_cnil_ccons [l6]
l8: $ G , ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ⇒ ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) $ by ax
l9: $ G , ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ⇒ ⊥ $ by ex_elim [l8, l7]
l10: $ G , ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) $ by ax
l11: $ G , ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ⇒ ⊥ $ by ex_elim [l10, l9]
l12: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel $ by ax
l13: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ $ by and_elim_l [l12]
l14: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ t = e2_cnil $ by weaken [#1]
l15: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ e2_cnil = t $ by eq_sym [l14]
l16: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ⟨ kc_cnil , ∅ ⟩ = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ $ by eq_trans [l15, l13]
l17: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ⊥ $ by e2_cnil_ccons [l16]
l18: $ G , ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l19: $ G , ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ⊥ $ by ex_elim [l18, l17]
l20: $ G , ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l21: $ G , ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ⊥ $ by ex_elim [l20, l19]
l22: $ G , ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l23: $ G , ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ⊥ $ by ex_elim [l22, l21]
l24: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l25: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ i = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ⊥ $ by ex_elim [l24, l23]
l26: $ G ⇒ ⊥ $ by or_elim [l1, l11, l25]

lemma e2_nctor_C1 (G: hyps) (t m k: set): $ G ⇒ t = e2_C1 $ > $ G ⇒ ra_nth_ctor t m k ∈ lrel $ > $ G ⇒ m = e2_N0 ∧ k = tn_K1 $
----
l1: $ G ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by lrel_nth_ctor_cases [#2]
l2: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by ax
l3: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = e2_C1 $ by weaken [#1]
l5: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ e2_C1 = t $ by eq_sym [l4]
l6: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ ⟨ kc_ccons , scons tn_K1 (scons e2_cnil ∅) ⟩ = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by eq_trans [l5, l3]
l7: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ isset kc_ccons $ by e2_is_kc_ccons
l8: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ isset tn_K1 $ by e2_is_K1
l9: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ isset e2_cnil $ by e2_is_cnil
l10: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ tn_K1 = x1 ∧ e2_cnil = x2 $ by node2_inj_c [l7, l8, l9, l6]
l11: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ tn_K1 = x1 $ by and_elim_l [l10]
l12: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by ax
l13: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by and_elim_r [l12]
l14: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ m = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l13]
l15: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ ⟨ kc_nz , ∅ ⟩ = e2_N0 $ by eq_refl
l16: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ m = e2_N0 $ by eq_trans [l14, l15]
l17: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by ax
l18: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 $ by and_elim_r [l17]
l19: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ k = x1 $ by and_elim_r [l18]
l20: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ x1 = tn_K1 $ by eq_sym [l11]
l21: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ k = tn_K1 $ by eq_trans [l19, l20]
l22: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1 ⇒ m = e2_N0 ∧ k = tn_K1 $ by and_intro [l16, l21]
l23: $ G , ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ⇒ ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) $ by ax
l24: $ G , ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ⇒ m = e2_N0 ∧ k = tn_K1 $ by ex_elim [l23, l22]
l25: $ G , ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) $ by ax
l26: $ G , ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ k = x1) ⇒ m = e2_N0 ∧ k = tn_K1 $ by ex_elim [l25, l24]
l27: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel $ by ax
l28: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ t = e2_C1 $ by weaken [#1]
l30: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ e2_C1 = t $ by eq_sym [l29]
l31: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ⟨ kc_ccons , scons tn_K1 (scons e2_cnil ∅) ⟩ = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ $ by eq_trans [l30, l28]
l32: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset kc_ccons $ by e2_is_kc_ccons
l33: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset tn_K1 $ by e2_is_K1
l34: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset e2_cnil $ by e2_is_cnil
l35: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ tn_K1 = x3 ∧ e2_cnil = x2 $ by node2_inj_c [l32, l33, l34, l31]
l36: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ m = ⟨ kc_s , scons x4 ∅ ⟩ ∧ k = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ e2_cnil = x2 $ by and_elim_r [l35]
