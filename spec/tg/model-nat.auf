r4: $ G , o = tn_K1 ⇒ scat (scons c ∅) (scons x ∅) ∈ iminq u (dnf u M) tr_nat_D I C w P CV $ by isset_elim [s1, r3]
r5: $ G ⇒ scat (scons c ∅) (scons x ∅) ∈ iminq u (dnf u M) tr_nat_D I C w P CV $ by isset_elim [s0, r4]

lemma e4_iminq1_elim {b k e: set} (G: hyps) (M I C P CV: class) (u w q: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ C = suc ∅ $ > $ G ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ > $ G ⇒ q ∊ iminq u (dnf u M) tr_nat_D I C w P CV $ >
  $ G ⇒ ∃ b ∃ k (b ∊ nnat ∧ k ∊ ap (imrel tr_nat_D CV) ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ∧ q = scat (scons k ∅) (scons b ∅)) $
----
c1: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ uadm u $ by weaken [#1]
c2: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ w ∊ lvals $ by weaken [#2]
c3: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ P = ∅ $ by weaken [#3]
c4: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ C = suc ∅ $ by weaken [#4]
c5: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ ∀ e (isset (ap (imrel tr_nat_D CV) e)) $ by weaken [#5]
b1: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ ictk tr_nat_D I C o $ by ax
b2: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ I = ∅ ∧ ((C = ∅ ∧ o = tn_K0) ∨ (C = suc ∅ ∧ o = tn_K1)) $ by nat_ictk_cases [b1]
b3: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 ⇒ (C = ∅ ∧ o = tn_K0) ∨ (C = suc ∅ ∧ o = tn_K1) $ by and_elim_r [b2]
d1: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 , C = ∅ ∧ o = tn_K0 ⇒ C = ∅ ∧ o = tn_K0 $ by ax
d2: $ G , ictk tr_nat_D I C o , ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) , x5 ∊ ihv tr_nat_D o (imrel tr_nat_D CV) x2 x3 (cdm x1) , q = scat x5 x1 , C = ∅ ∧ o = tn_K0 ⇒ C = ∅ $ by and_elim_l [d1]
