v7a: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ ap (ap ms n) x7 ∈ ap m (nsc n) $ by e4_ms_ap [p3, v1, v4]
v7b: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ ap (ap ms n) x7 = b $ by eq_sym [v5]
v7c: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ b ∈ ap m (nsc n) $ by wcel_eq_l [v7b, v7a]
v7d: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ b ∊ ap m (nsc n) $ by wcel_welc [v7c]
v7r: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ m = m $ by eq_refl
v7e: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ nsc n = l $ by eq_sym [v2]
v7f: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ ap m (nsc n) = ap m l $ by ap_eq [v7r, v7e]
v7: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ b ∊ ap m l $ by welc_eq [v7f, v7d]
v8: $ G , n ∊ nnat , n ∊ {k | ∃ v (v ∊ ap m k ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , k ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = v))} , x7 ∊ ap m n ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , n ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = x7) , b = ap (ap ms n) x7 , l = nsc n ⇒ b ∊ ap m l ∧ ∀ o (⟨ ⟨ ∅ , ⟨ ∅ , l ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u M) tr_nat_D w ∅ (scons ms (scons z ∅)) ↔ o = b) $ by and_intro [v7, v6]
