lemma e4_k1_intro (G: hyps) (M K P: class) (u w c: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ P = ∅ $ > $ G ⇒ K = tn_K1 $ > $ G ⇒ c ∊ nnat $ >
  $ G ⇒ ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ∈ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $
----
l1: $ G ⇒ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = nk1p u (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by e4_k1_etel [#1, #2, #3, #4]
l2: $ G ⇒ isset ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ $ by opair_isset
m1: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ $ by ax
m2z: $ G ⇒ fv (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∅ = nnat $ by e4_fvRR [#1, #2, #3]
m2a: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ fv (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∅ = nnat $ by weaken [m2z]
m2b: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ nnat = fv (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∅ $ by eq_sym [m2a]
m2c: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ c ∊ nnat $ by weaken [#5]
m2: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ c ∊ fv (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∅ $ by welc_eq [m2b, m2c]
m3b: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ uadm u $ by weaken [#1]
m3a: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ nnat ⊆ u $ by nnat_sub_u [m3b]
m3: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ c ∊ u $ by subset_elim [m3a, m2c]
m4a: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ c ∊ u ∧ y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ $ by and_intro [m3, m1]
m4: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ c ∊ fv (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∅ ∧ c ∊ u ∧ y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ $ by and_intro [m2, m4a]
m5: $ G , y = ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ⇒ ∃ x (x ∊ fv (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∅ ∧ x ∊ u ∧ y = ⟨ scons x ∅ , ⟨ scons x ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩) $ by ex_intro [m4]
m6: $ G ⇒ ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ∈ {z | ∃ x (x ∊ fv (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∅ ∧ x ∊ u ∧ z = ⟨ scons x ∅ , ⟨ scons x ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩)} $ by wcel_cab_intro (p := $ ∃ x (x ∊ fv (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) ∅ ∧ x ∊ u ∧ z = ⟨ scons x ∅ , ⟨ scons x ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩) $) [l2, m5]
m7: $ G ⇒ nk1p u (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) = etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by eq_sym [l1]
m8: $ G ⇒ ⟨ scons c ∅ , ⟨ scons c ∅ , ⟨ scons (csn ept0) ∅ , ∅ ⟩ ⟩ ⟩ ∈ etel u (dnf u M) K w (scat P (ixs tr_nat_D w (ifam u (dnf u M) tr_nat_D w))) $ by wcel_eq_r [m7, m6]

--| The inductive hypothesis of `succ`'s field: its own telescope has the one
--| path `∅`, so a hypothesis is a value of `L` at the field.
lemma e4_ihsp_d {z b c e: set} (G: hyps) (tt: class) (d: set):
  $ G ⇒ d = ∅ $ > $ G ⇒ tt = scons (csn ept0) ∅ $ > $ G ⇒ fv tt d = csn ept0 ∧ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $
----
l1: $ G ⇒ fv tt d = fv (scons (csn ept0) ∅) ∅ $ by fv_eq [#2, #1]
l2a: $ G ⇒ isset ept0 $ by opair_isset
l2b: $ G ⇒ isset (csn ept0) $ by csn_set [l2a]
l2c: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ fv (scons (csn ept0) ∅) ∅ = csn ept0 $ by scons_fv_zero_c [l2b, l2c]
l3: $ G ⇒ fv tt d = csn ept0 $ by eq_trans [l1, l2]
l4: $ G ⇒ ⟨ d , ⟨ d , ⟨ d , d ⟩ ⟩ ⟩ ∈ csn ept0 $ by ept0_intro [#1]
l5: $ G ⇒ csn ept0 = fv tt d $ by eq_sym [l3]
l6: $ G ⇒ ⟨ d , ⟨ d , ⟨ d , d ⟩ ⟩ ⟩ ∈ fv tt d $ by wcel_eq_r [l5, l4]
l7: $ G ⇒ ∃ e (⟨ d , ⟨ d , ⟨ d , e ⟩ ⟩ ⟩ ∈ fv tt d) $ by ex_intro [l6]
l8: $ G ⇒ ∃ c ∃ e (⟨ d , ⟨ d , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) $ by ex_intro [l7]
l9: $ G ⇒ ∃ b ∃ c ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) $ by ex_intro [l8]
l10: $ G ⇒ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by cab_intro [l9]
l11: $ G ⇒ fv tt d = csn ept0 ∧ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by and_intro [l3, l10]

lemma e4_ihsp_elim (G: hyps) (L gg tt: class) (d x v: set):
  $ G ⇒ d = ∅ $ > $ G ⇒ tt = scons (csn ept0) ∅ $ > $ G ⇒ gg = scons x ∅ $ > $ G ⇒ v ∊ ihsp L gg tt d ∅ $ >
  $ G ⇒ v ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $
----
l1: $ G ⇒ fv tt d = csn ept0 ∧ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by e4_ihsp_d [#1, #2]
l2: $ G ⇒ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by and_elim_r [l1]
l3: $ G ⇒ apn v d ∈ {y | ∃ b ∃ c ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩)} $ by fpi_ap [#4, l2]
l4r: $ G ⇒ v = v $ by eq_refl
l4a: $ G ⇒ apn v d = apn v ∅ $ by apn_eq [l4r, #1]
l4b: $ G ⇒ apn v ∅ = v $ by apn_empty
l4: $ G ⇒ apn v d = v $ by eq_trans [l4a, l4b]
l5: $ G ⇒ v ∈ {y | ∃ b ∃ c ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩)} $ by wcel_eq_l [l4, l3]
l6: $ G ⇒ v ∊ {y | ∃ b ∃ c ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ y ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩)} $ by wcel_welc [l5]
l7: $ G ⇒ ∃ b ∃ c ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩) $ by cab_elim [l6]
k1: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ $ by ax
k2: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d $ by and_elim_l [k1]
k3: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ $ by and_elim_r [k1]
k4a: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ fv tt d = csn ept0 ∧ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by weaken [l1]
k4b: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ fv tt d = csn ept0 $ by and_elim_l [k4a]
k4: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ csn ept0 $ by wcel_eq_r [k4b, k2]
k5: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ d = ∅ ∧ b = ∅ ∧ c = ∅ ∧ e = ∅ $ by ept0_elim [k4]
k5a: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ b = ∅ ∧ c = ∅ ∧ e = ∅ $ by and_elim_r [k5]
k5b: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ c = ∅ ∧ e = ∅ $ by and_elim_r [k5a]
k5c: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ e = ∅ $ by and_elim_r [k5b]
k6a: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ d = ∅ $ by weaken [#1]
k6r: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ fv gg d = fv gg d $ by eq_refl
k6b: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ apn (fv gg d) d = apn (fv gg d) ∅ $ by apn_eq [k6r, k6a]
k6c: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ apn (fv gg d) ∅ = fv gg d $ by apn_empty
k6d: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ gg = scons x ∅ $ by weaken [#3]
k6e: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ fv gg d = fv (scons x ∅) ∅ $ by fv_eq [k6d, k6a]
k6f: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ isset x $ by isset_var
k6g: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
k6h: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ fv (scons x ∅) ∅ = x $ by scons_fv_zero_c [k6f, k6g]
k6i: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ apn (fv gg d) d = fv gg d $ by eq_trans [k6b, k6c]
k6j: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ apn (fv gg d) d = fv (scons x ∅) ∅ $ by eq_trans [k6i, k6e]
k6: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ apn (fv gg d) d = x $ by eq_trans [k6j, k6h]
k7a: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ ⟨ e , apn (fv gg d) d ⟩ = ⟨ ∅ , x ⟩ $ by opair_eq [k5c, k6]
k7r: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ ∅ = ∅ $ by eq_refl
k7b: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by opair_eq [k7r, k7a]
k7l: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ L = L $ by eq_refl
k7c: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ = ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by ap_eq [k7l, k7b]
k7: $ G , ⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩ ⇒ v ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by welc_eq [k7c, k3]
a1: $ G , ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩) ⇒ ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩) $ by ax
a2: $ G , ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩) ⇒ v ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by ex_elim [a1, k7]
a3: $ G , ∃ c ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩) ⇒ ∃ c ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩) $ by ax
a4: $ G , ∃ c ∃ e (⟨ d , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ∧ v ∊ ap L ⟨ ∅ , ⟨ e , apn (fv gg d) d ⟩ ⟩) ⇒ v ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by ex_elim [a3, a2]
a5: $ G ⇒ v ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ by ex_elim [l7, a4]

lemma e4_ihsp_intro (G: hyps) (L gg tt: class) (d x v: set):
  $ G ⇒ d = ∅ $ > $ G ⇒ tt = scons (csn ept0) ∅ $ > $ G ⇒ gg = scons x ∅ $ > $ G ⇒ v ∊ ap L ⟨ ∅ , ⟨ ∅ , x ⟩ ⟩ $ >
  $ G ⇒ v ∊ ihsp L gg tt d ∅ $
----
l1: $ G ⇒ fv tt d = csn ept0 ∧ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by e4_ihsp_d [#1, #2]
l2: $ G ⇒ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by and_elim_r [l1]
m1: $ G , o ∊ v ⇒ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by weaken [l2]
m2a: $ G , o ∊ v ⇒ d = ∅ $ by weaken [#1]
m2r: $ G , o ∊ v ⇒ o = o $ by eq_refl
m2b: $ G , o ∊ v ⇒ nest d o = nest ∅ o $ by nest_eq [m2a, m2r]
m2i: $ G , o ∊ v ⇒ isset o $ by isset_var
m2c: $ G , o ∊ v ⇒ nest ∅ o = o $ by nest_empty [m2i]
m2d: $ G , o ∊ v ⇒ nest d o = o $ by eq_trans [m2b, m2c]
m2: $ G , o ∊ v ⇒ o = nest d o $ by eq_sym [m2d]
m3: $ G , o ∊ v ⇒ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} ∧ o = nest d o $ by and_intro [m1, m2]
m4: $ G , o ∊ v ⇒ ∃ k (d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} ∧ o = nest d k) $ by ex_intro [m3]
m5: $ G , o ∊ v ⇒ ∃ q ∃ k (q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} ∧ o = nest q k) $ by ex_intro [m4]
m6: $ G ⇒ o ∊ v → ∃ q ∃ k (q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} ∧ o = nest q k) $ by imp_intro [m5]
m7: $ G ⇒ ∀ o (o ∊ v → ∃ q ∃ k (q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} ∧ o = nest q k)) $ by all_intro [m6]
n1: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} ⇒ q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by ax
n2: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} ⇒ ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d) $ by cab_elim [n1]
k1: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d $ by ax
k4a: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ fv tt d = csn ept0 ∧ d ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} $ by weaken [l1]
k4b: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ fv tt d = csn ept0 $ by and_elim_l [k4a]
k4: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ csn ept0 $ by wcel_eq_r [k4b, k1]
k5: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ q = ∅ ∧ b = ∅ ∧ c = ∅ ∧ e = ∅ $ by ept0_elim [k4]
k5q: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ q = ∅ $ by and_elim_l [k5]
k5a: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ b = ∅ ∧ c = ∅ ∧ e = ∅ $ by and_elim_r [k5]
k5b: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ c = ∅ ∧ e = ∅ $ by and_elim_r [k5a]
k5c: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ e = ∅ $ by and_elim_r [k5b]
k6a: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ d = ∅ $ by weaken [#1]
k6r: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ fv gg d = fv gg d $ by eq_refl
k6b: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ apn (fv gg d) q = apn (fv gg d) ∅ $ by apn_eq [k6r, k5q]
k6c: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ apn (fv gg d) ∅ = fv gg d $ by apn_empty
k6d: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ gg = scons x ∅ $ by weaken [#3]
k6e: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv tt d ⇒ fv gg d = fv (scons x ∅) ∅ $ by fv_eq [k6d, k6a]
