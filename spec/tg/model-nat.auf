q3: $ G , k ∊ dt u (mcv H) (enc_expr (pi nat_ty (pi (app (bvar n2) (bvar nz)) (app (bvar n3) (app nat_succ (bvar n1)))))) W (scons z (scons m R)) ⇒ dt u (mcv H) (enc_expr (pi nat_ty (app (bvar n3) (bvar nz)))) W (scons k (scons z (scons m R))) = cpi y nnat (ap m y) $ by e5_rt_B3 [w1, w2, w3, q2, w5]
