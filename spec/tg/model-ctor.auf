def e4_cq (J D N Q L I C E: class) (.y .m .c .d .e .f: set): class = $ {y | ∀ m (ra_ctors_wf D N Q L I C y ∈ lrel3 J → ra_nth_ctor y m E ∈ lrel → ∃ c ∃ d ∃ e ∃ f (ra_ind_data D c d e ∈ lrel ∧ ra_pis d E f ∈ lrel ∧ ra_closed N f ∈ lrel))} $

lemma e4_cq_e {c d e f: set} (G: hyps) (J: class) (t1 t2 t3 t4 t5 t6 te ty tm: set): $ G ⇒ ty ∊ e4_cq J t1 t2 t3 t4 t5 t6 te $ > $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 ty ∈ lrel3 J $ > $ G ⇒ ra_nth_ctor ty tm te ∈ lrel $ > $ G ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $
----
l1: $ G ⇒ ∀ m (ra_ctors_wf t1 t2 t3 t4 t5 t6 ty ∈ lrel3 J → ra_nth_ctor ty m te ∈ lrel → ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel)) $ by cab_elim [#1]
l2: $ … ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 ty ∈ lrel3 J → ra_nth_ctor ty tm te ∈ lrel → ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by all_elim [l1]
l3: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by imp_elim [imp_elim [l2, #2], #3]

lemma e4_cq_node {c d e f: set} (G: hyps) (J: class) (t1 t2 t3 t4 t5 t6 te ty tm k1 j1: set): $ G ⇒ crn j1 ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 ty ∈ lrel3 J $ > $ G ⇒ ra_nth_ctor ty tm te ∈ lrel $ > $ G ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $
----
s0: $ … ⇒ ∃ x1 ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by lrel_nth_ctor_cases [#4]
a0: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 ⇒ ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 $ by ax
an1: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 ⇒ ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [a0]
an2: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 ⇒ tm = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [and_elim_r [a0]]
an3: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 ⇒ te = x1 $ by and_elim_r [and_elim_r [a0]]
a1: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 ty ∈ lrel3 J $ by weaken [#3]
ar2: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 ⇒ x2 = x2 $ by eq_refl
ark: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 ⇒ kc_ccons = kc_ccons $ by eq_refl
are: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1 ⇒ ∅ = ∅ $ by eq_refl
a2: $ … ⇒ ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ = ⟨ kc_ccons , scons te (scons x2 ∅) ⟩ $ by opair_eq [ark, scons_eq [eq_sym [an3], scons_eq [ar2, are]]]
a3: $ … ⇒ ty = ⟨ kc_ccons , scons te (scons x2 ∅) ⟩ $ by eq_trans [an1, a2]
a4: $ … ⇒ (∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel)) ∧ ra_ctors_wf t1 t2 t3 t4 t5 t6 x2 ∈ lrel3 J $ by e4_cc [a1, a3]
a5: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by and_elim_l [a4]
a6_x1: $ G , ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1) ⇒ ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1) $ by ax
a6_y1: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by ex_elim [a6_x1, a5]
a6_x0: $ G , ∃ x1 ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1) ⇒ ∃ x1 ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ∧ te = x1) $ by ax
a6: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by ex_elim [a6_x0, a6_y1]
b0: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel $ by ax
bn1: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ $ by and_elim_l [b0]
bn2: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ tm = ⟨ kc_s , scons x4 ∅ ⟩ $ by and_elim_l [and_elim_r [b0]]
bn3: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ te = x1 $ by and_elim_l [and_elim_r [and_elim_r [b0]]]
bn4: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ra_nth_ctor x2 x4 x1 ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [b0]]]
b1: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 ty ∈ lrel3 J $ by weaken [#3]
b2: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ crn j1 ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te $ by weaken [#1]
b3: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
b4: $ … ⇒ (∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d x3 f ∈ lrel ∧ ra_closed t2 f ∈ lrel)) ∧ ra_ctors_wf t1 t2 t3 t4 t5 t6 x2 ∈ lrel3 J $ by e4_cc [b1, bn1]
b5: $ … ⇒ ⟨ k1 , j1 ⟩ = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ $ by eq_trans [eq_sym [b3], bn1]
is_k1: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset k1 $ by isset_var
is_j1: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset j1 $ by isset_var
is_x2: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset x2 $ by isset_var
b6a: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
b6b: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset ∅ $ by ax_empty
b6: $ … ⇒ k1 = kc_ccons ∧ j1 = scons x3 (scons x2 ∅) $ by opair_inj_c [b5, is_k1, is_j1, wcel_isset [b6a], scons_set [scons_set [b6b]]]
b7: $ … ⇒ crn (scons x3 (scons x2 ∅)) ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te $ by subset_eq_l [crn_eq [and_elim_r [b6]], b2]
b8: $ … ⇒ x2 ∈ e4_cq J t1 t2 t3 t4 t5 t6 te $ by crn_scons_head [is_x2, crn_scons_tail [b7]]
br2: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x2 = x2 $ by eq_refl
br4: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x4 = x4 $ by eq_refl
b9: $ … ⇒ ra_nth_ctor x2 x4 te ∈ lrel $ by wcel_eq_l [ra_nth_ctor_eq [br2, br4, eq_sym [bn3]], bn4]
b10: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by e4_cq_e [wcel_welc [b8], and_elim_r [b4], b9]
b11_x3: $ G , ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
b11_y3: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by ex_elim [b11_x3, b10]
b11_x2: $ G , ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
b11_y2: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by ex_elim [b11_x2, b11_y3]
b11_x1: $ G , ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
b11_y1: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by ex_elim [b11_x1, b11_y2]
b11_x0: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tm = ⟨ kc_s , scons x4 ∅ ⟩ ∧ te = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
b11: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by ex_elim [b11_x0, b11_y1]
fin: $ G ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by or_elim [s0, a6, b11]

lemma e4_cq_all (G: hyps) (J: class) (t1 t2 t3 t4 t5 t6 te: set): $ G ⇒ trees ω ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te $
----
a3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te , y = ⟨ i , j ⟩ , ra_ctors_wf t1 t2 t3 t4 t5 t6 y ∈ lrel3 J , ra_nth_ctor y m te ∈ lrel ⇒ crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te $ by ax
a4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te , y = ⟨ i , j ⟩ , ra_ctors_wf t1 t2 t3 t4 t5 t6 y ∈ lrel3 J , ra_nth_ctor y m te ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
a5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te , y = ⟨ i , j ⟩ , ra_ctors_wf t1 t2 t3 t4 t5 t6 y ∈ lrel3 J , ra_nth_ctor y m te ∈ lrel ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 y ∈ lrel3 J $ by ax
a6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te , y = ⟨ i , j ⟩ , ra_ctors_wf t1 t2 t3 t4 t5 t6 y ∈ lrel3 J , ra_nth_ctor y m te ∈ lrel ⇒ ra_nth_ctor y m te ∈ lrel $ by ax
n1: $ … ⇒ ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by e4_cq_node [a3, a4, a5, a6]
n2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te , y = ⟨ i , j ⟩ ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 y ∈ lrel3 J → ra_nth_ctor y m te ∈ lrel → ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel) $ by imp_intro [imp_intro [n1]]
n3: $ … ⇒ ∀ m (ra_ctors_wf t1 t2 t3 t4 t5 t6 y ∈ lrel3 J → ra_nth_ctor y m te ∈ lrel → ∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d te f ∈ lrel ∧ ra_closed t2 f ∈ lrel)) $ by all_intro [n2]
n4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te , y = ⟨ i , j ⟩ ⇒ y ∊ e4_cq J t1 t2 t3 t4 t5 t6 te $ by cab_intro [n3]
n5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
n6: $ … ⇒ ⟨ i , j ⟩ ∈ e4_cq J t1 t2 t3 t4 t5 t6 te $ by wcel_intro [n5, n4]
n7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te ⇒ isset ⟨ i , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ i , j ⟩ ∈ e4_cq J t1 t2 t3 t4 t5 t6 te $ by isset_elim [n7, n6]
n9: $ … ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te → ⟨ i , j ⟩ ∈ e4_cq J t1 t2 t3 t4 t5 t6 te $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te → ⟨ i , j ⟩ ∈ e4_cq J t1 t2 t3 t4 t5 t6 te) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ e4_cq J t1 t2 t3 t4 t5 t6 te $ by trees_ind_c [n11, n10]

lrel3_ctors_wf_nth_closed
----
l1: $ G ⇒ trees ω ⊆ e4_cq J t1 t2 t3 t4 t5 t6 k $ by e4_cq_all
l2a: $ G ⇒ kr_nth_ctor ∈ ω $ by kr_nth_ctor_omega
l2: $ … ⇒ t7 ∊ trees ω ∧ m ∊ trees ω ∧ k ∊ trees ω $ by lrel_args3 [#2, wcel_isset [l2a]]
l3: $ … ⇒ t7 ∊ e4_cq J t1 t2 t3 t4 t5 t6 k $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ∃ b ∃ p ∃ t ∃ r (ra_ind_data t1 b p t ∈ lrel ∧ ra_pis p k r ∈ lrel ∧ ra_closed t2 r ∈ lrel) $ by e4_cq_e [l3, #1, #2]

ind_ctor_ty_wf
----
w1: $ G ⇒ ra_ind_wf tg td ∈ lrel3 J $ by iwf_wf [#1]
w2: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ y (ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J) $ by ind_wf_data [w1]
p1: $ G ⇒ iprt td tp tt $ by ex_intro [#3]
d0: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J $ by ax
d1: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_ind_data td x1 x2 x3 ∈ lrel $ by and_elim_l [d0]
d2: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_tys_closed x2 x3 ∈ lrel $ by and_elim_l [and_elim_r [d0]]
d3: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_clen x2 x4 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [d0]]]
d4: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_ntys x3 x5 x6 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [d0]]]]
d5: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_capp x2 tg x7 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [d0]]]]]
d6: $ G , ra_ind_data td x1 x2 x3 ∈ lrel ∧ ra_tys_closed x2 x3 ∈ lrel ∧ ra_clen x2 x4 ∈ lrel ∧ ra_ntys x3 x5 x6 ∈ lrel ∧ ra_capp x2 tg x7 ∈ lrel ∧ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel ∧ ra_isort x9 y x8 ∈ lrel ∧ ra_tys_wf td x5 x4 x8 ⟨ kc_nz , ∅ ⟩ x7 x3 ∈ lrel3 J ⇒ ra_nth_ty x3 ⟨ kc_nz , ∅ ⟩ x9 x0 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [d0]]]]]]
