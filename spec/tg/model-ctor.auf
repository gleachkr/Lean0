lemma e4_cl (G: hyps) (M: class) (u w k e q v r: set): $ G ⇒ ra_closed k e ∈ lrel $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ fv nvf k = nadd (cdm q) (cdm v) $ > $ G ⇒ etel u (dnf u M) e w (scat q (scat v r)) = etel u (dnf u M) e w (scat q v) $
----
w1: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ ra_closed k e ∈ lrel $ by weaken [#1]
w2: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ e ∊ trees ω $ by weaken [#2]
w3: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ w ∊ lvals $ by weaken [#3]
w4: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ q ∊ fseq u $ by weaken [#4]
w5: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ v ∊ fseq u $ by weaken [#5]
w6: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ r ∊ fseq u $ by weaken [#6]
w7: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ fv nvf k = nadd (cdm q) (cdm v) $ by weaken [#7]
ko: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ o = ∅ $ by ax
ka: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ a = scat q v $ by ax
kb: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ b = scat a r $ by ax
o0: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ ∅ ∈ fseq u $ by fseq_empty
o1: $ … ⇒ o ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [ko], o0]]
a0: $ … ⇒ scat q v ∈ fseq u $ by scat_fseq [w4, w5]
a1: $ … ⇒ a ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [ka], a0]]
b0: $ … ⇒ scat a r ∈ fseq u $ by scat_fseq [a1, w6]
b1: $ … ⇒ b ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [kb], b0]]
q1: $ … ⇒ ∀ i (i ∊ cdm a → fv (scat a r) i = fv (scat a o) i) $ by scat_agree [a1, w6, o1]
q2a: $ … ⇒ cdm (scat q v) = nadd (cdm q) (cdm v) $ by scat_len_c [welc_wcel [w4], welc_wcel [w5]]
q2: $ … ⇒ cdm a = fv nvf k $ by eq_trans [cdm_eq [ka], eq_trans [q2a, eq_sym [w7]]]
ra: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ a = a $ by eq_refl
q4a: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ scat a ∅ = a $ by scat_empty_r
q4: $ … ⇒ scat a o = a $ by eq_trans [scat_eq [ra, ko], q4a]
q5: $ … ⇒ ∀ i (i ∊ fv nvf k → fv b i = fv a i) $ by fv_agree_eq [q2, eq_sym [kb], q4, q1]
q6: $ … ⇒ etel u (dnf u M) e w b = etel u (dnf u M) e w a $ by lrel_closed_etel [w1, w2, w3, b1, a1, q5]
rr: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ r = r $ by eq_refl
q7a: $ … ⇒ scat (scat q v) r = scat q (scat v r) $ by scat_assoc_c [welc_wcel [w4], welc_wcel [w5], welc_wcel [w6]]
q7: $ … ⇒ b = scat q (scat v r) $ by eq_trans [kb, eq_trans [scat_eq [ka, rr], q7a]]
re: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ e = e $ by eq_refl
rw: $ G , o = ∅ , a = scat q v , b = scat a r ⇒ w = w $ by eq_refl
q8a: $ … ⇒ etel u (dnf u M) e w (scat q (scat v r)) = etel u (dnf u M) e w b $ by etel_eq [re, rw, eq_sym [q7]]
q8b: $ … ⇒ etel u (dnf u M) e w a = etel u (dnf u M) e w (scat q v) $ by etel_eq [re, rw, ka]
q8: $ … ⇒ etel u (dnf u M) e w (scat q (scat v r)) = etel u (dnf u M) e w (scat q v) $ by eq_trans [q8a, eq_trans [q6, q8b]]
z1a: $ G , o = ∅ , a = scat q v ⇒ a = scat q v $ by ax
z1b: $ G , o = ∅ , a = scat q v ⇒ q ∊ fseq u $ by weaken [#4]
z1c: $ G , o = ∅ , a = scat q v ⇒ v ∊ fseq u $ by weaken [#5]
z1d: $ … ⇒ scat q v ∈ fseq u $ by scat_fseq [z1b, z1c]
z1e: $ … ⇒ a ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [z1a], z1d]]
z1f: $ G , o = ∅ , a = scat q v ⇒ r ∊ fseq u $ by weaken [#6]
z1g: $ … ⇒ scat a r ∈ fseq u $ by scat_fseq [z1e, z1f]
z1: $ G , o = ∅ , a = scat q v ⇒ etel u (dnf u M) e w (scat q (scat v r)) = etel u (dnf u M) e w (scat q v) $ by isset_elim [wcel_isset [z1g], q8]
z2b: $ G , o = ∅ ⇒ q ∊ fseq u $ by weaken [#4]
z2c: $ G , o = ∅ ⇒ v ∊ fseq u $ by weaken [#5]
z2d: $ … ⇒ scat q v ∈ fseq u $ by scat_fseq [z2b, z2c]
z2: $ G , o = ∅ ⇒ etel u (dnf u M) e w (scat q (scat v r)) = etel u (dnf u M) e w (scat q v) $ by isset_elim [wcel_isset [z2d], z1]
z3a: $ G ⇒ isset ∅ $ by ax_empty
z3: $ … ⇒ etel u (dnf u M) e w (scat q (scat v r)) = etel u (dnf u M) e w (scat q v) $ by isset_elim [z3a, z2]

lemma e4_idx (G: hyps) (I: class) (u q v r: set): $ G ⇒ q ∊ fseq u $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ I ∈ cdm v $ > $ G ⇒ I ∈ ω $ > $ G ⇒ fv (scat q (scat v r)) (nadd (cdm q) I) = fv v I $
----
kb: $ G , b = scat v r ⇒ b = scat v r $ by ax
w1: $ G , b = scat v r ⇒ q ∊ fseq u $ by weaken [#1]
w2: $ G , b = scat v r ⇒ v ∊ fseq u $ by weaken [#2]
w3: $ G , b = scat v r ⇒ r ∊ fseq u $ by weaken [#3]
w4: $ G , b = scat v r ⇒ I ∈ cdm v $ by weaken [#4]
w5: $ G , b = scat v r ⇒ I ∈ ω $ by weaken [#5]
b0: $ … ⇒ scat v r ∈ fseq u $ by scat_fseq [w2, w3]
b1: $ … ⇒ b ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [kb], b0]]
i4: $ … ⇒ fv (scat q b) (nadd (cdm q) I) = fv b I $ by scat_fv_r_c [w1, b1, w5]
i5: $ … ⇒ fv (scat v r) I = fv v I $ by scat_fv_l_c [w2, w3, w4]
rq: $ G , b = scat v r ⇒ q = q $ by eq_refl
rn: $ G , b = scat v r ⇒ nadd (cdm q) I = nadd (cdm q) I $ by eq_refl
rI: $ G , b = scat v r ⇒ I = I $ by eq_refl
i6a: $ … ⇒ scat q (scat v r) = scat q b $ by scat_eq [rq, eq_sym [kb]]
i6: $ … ⇒ fv (scat q (scat v r)) (nadd (cdm q) I) = fv (scat q b) (nadd (cdm q) I) $ by fv_eq [i6a, rn]
i7: $ … ⇒ fv b I = fv (scat v r) I $ by fv_eq [kb, rI]
i8: $ … ⇒ fv (scat q (scat v r)) (nadd (cdm q) I) = fv v I $ by eq_trans [i6, eq_trans [i4, eq_trans [i7, i5]]]
i9: $ G ⇒ scat v r ∈ fseq u $ by scat_fseq [#2, #3]
i10: $ … ⇒ fv (scat q (scat v r)) (nadd (cdm q) I) = fv v I $ by isset_elim [wcel_isset [i9], i8]

lemma e4_fib {z f g t a y: set} (G: hyps) (J M: class) (u w td tn tm tl ti tx t7 tk q v r o x: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ra_cwf td tn tm tl ti tx t7 tk ∈ lrel3 J $ > $ G ⇒ tk ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ t7 ∊ trees ω $ > $ G ⇒ fv nvf t7 = ∅ $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ cdm q = fv nvf tm $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ fv nvf ti ∈ cdm v $ > $ G ⇒ o = scat q (scat v r) $ > $ G ⇒ ∀ z (z ∊ x → ∃ f ∃ g ∃ t ∃ a ∃ y (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o ∧ z = nest f y)) $ > $ G ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o → a ∊ fseq u → apn x f ∈ apn (fv v (fv nvf ti)) a) $ > $ G ⇒ x ∈ dt u M tk w o $
----
c1: $ … ⇒ cdm q ∈ ω $ by fseq_len [#7]
c2: $ G ⇒ ∅ ∈ ω $ by omega_zero
c3: $ … ⇒ nadd (fv nvf t7) (fv nvf tm) = nadd ∅ (cdm q) $ by nadd_eq [#6, eq_sym [#8]]
c4: $ … ⇒ nadd ∅ (cdm q) = nadd (cdm q) ∅ $ by nadd_comm_c [c2, c1]
c5: $ … ⇒ nadd (cdm q) ∅ = cdm q $ by nadd_zero_c [wcel_isset [c1]]
c6: $ … ⇒ nadd (fv nvf t7) (fv nvf tm) = cdm q $ by eq_trans [c3, eq_trans [c4, c5]]
ri: $ G ⇒ fv nvf ti = fv nvf ti $ by eq_refl
c7: $ … ⇒ nadd (nadd (fv nvf t7) (fv nvf tm)) (fv nvf ti) = nadd (cdm q) (fv nvf ti) $ by nadd_eq [c6, ri]
c8a: $ G ⇒ isset ti $ by isset_var
c8: $ … ⇒ fv nvf ti ∈ ω $ by nvf_omega [c8a]
c9: $ … ⇒ fv (scat q (scat v r)) (nadd (cdm q) (fv nvf ti)) = fv v (fv nvf ti) $ by e4_idx [#7, #9, #10, #11, c8]
c10: $ … ⇒ fv o (nadd (nadd (fv nvf t7) (fv nvf tm)) (fv nvf ti)) = fv v (fv nvf ti) $ by eq_trans [fv_eq [#12, c7], c9]
f1: $ … ⇒ scat v r ∈ fseq u $ by scat_fseq [#9, #10]
f2: $ … ⇒ scat q (scat v r) ∈ fseq u $ by scat_fseq_c [welc_wcel [#7], f1]
f3: $ … ⇒ o ∊ fseq u $ by wcel_welc [wcel_eq_l [eq_sym [#12], f2]]
h1: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o , a ∊ fseq u ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o → a ∊ fseq u → apn x f ∈ apn (fv v (fv nvf ti)) a) $ by weaken [#14]
h2: $ … ⇒ ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o → a ∊ fseq u → apn x f ∈ apn (fv v (fv nvf ti)) a) $ by all_elim [h1]
h3: $ … ⇒ ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o → a ∊ fseq u → apn x f ∈ apn (fv v (fv nvf ti)) a) $ by all_elim [h2]
h4: $ … ⇒ ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o → a ∊ fseq u → apn x f ∈ apn (fv v (fv nvf ti)) a) $ by all_elim [h3]
h5: $ … ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o → a ∊ fseq u → apn x f ∈ apn (fv v (fv nvf ti)) a $ by all_elim [h4]
kp: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o , a ∊ fseq u ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o $ by ax
ka: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o , a ∊ fseq u ⇒ a ∊ fseq u $ by ax
h6: $ … ⇒ apn x f ∈ apn (fv v (fv nvf ti)) a $ by imp_elim [imp_elim [h5, kp], ka]
h7: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o , a ∊ fseq u ⇒ fv o (nadd (nadd (fv nvf t7) (fv nvf tm)) (fv nvf ti)) = fv v (fv nvf ti) $ by weaken [c10]
ra: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o , a ∊ fseq u ⇒ a = a $ by eq_refl
h8: $ … ⇒ apn x f ∈ apn (fv o (nadd (nadd (fv nvf t7) (fv nvf tm)) (fv nvf ti))) a $ by wcel_eq_r [apn_eq [eq_sym [h7], ra], h6]
h9: $ G ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk w o → a ∊ fseq u → apn x f ∈ apn (fv o (nadd (nadd (fv nvf t7) (fv nvf tm)) (fv nvf ti))) a) $ by all_intro [all_intro [all_intro [all_intro [imp_intro [imp_intro [h8]]]]]]
h10: $ … ⇒ x ∈ dt u M tk w o $ by lrel3_cwf_trace [#3, #1, #4, #5, #2, f3, #13, h9]
lemma e4_ixs (G: hyps) (E: class) (u w td: set): $ G ⇒ universe u $ > $ G ⇒ (ifam u E td w) ∈ u $ > $ G ⇒ (ixs td w (ifam u E td w)) ∈ fseq u ∧ cdm (ixs td w (ifam u E td w)) = intys td $
----
f2: $ G ⇒ (ifam u E td w) ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by ifam_sub
x1a: $ G , i ∊ intys td ⇒ universe u $ by weaken [#1]
x1b: $ G , i ∊ intys td ⇒ (ifam u E td w) ∈ u $ by weaken [#2]
x1c: $ G , i ∊ intys td ⇒ (ifam u E td w) ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by weaken [f2]
x1: $ … ⇒ ient td w (ifam u E td w) i ∈ u $ by ient_universe [x1a, x1b, x1c]
x2: $ G ⇒ ∀ i (i ∊ intys td → ient td w (ifam u E td w) i ∈ u) $ by all_intro [imp_intro [x1]]
x3: $ G ⇒ intys td ∈ ω $ by intys_omega
x4: $ … ⇒ (ixs td w (ifam u E td w)) ∈ fseq u $ by ixs_fseq [x2, x3]
y0: $ G , i ∊ intys td ⇒ i ∊ intys td $ by ax
y1: $ … ⇒ ⟨ i , ient td w (ifam u E td w) i ⟩ ∈ (ixs td w (ifam u E td w)) $ by ixs_pair [x1a, x1b, x1c, y0]
y2: $ G , i ∊ intys td , b = ient td w (ifam u E td w) i ⇒ b = ient td w (ifam u E td w) i $ by ax
ri: $ G , i ∊ intys td , b = ient td w (ifam u E td w) i ⇒ i = i $ by eq_refl
y3: $ G , i ∊ intys td , b = ient td w (ifam u E td w) i ⇒ ⟨ i , ient td w (ifam u E td w) i ⟩ ∈ (ixs td w (ifam u E td w)) $ by weaken [y1]
y4: $ … ⇒ ⟨ i , b ⟩ ∈ (ixs td w (ifam u E td w)) $ by wcel_eq_l [opair_eq [ri, eq_sym [y2]], y3]
y5: $ … ⇒ i ∊ cdm (ixs td w (ifam u E td w)) $ by cdm_intro [y4]
y6: $ G , i ∊ intys td ⇒ i ∊ cdm (ixs td w (ifam u E td w)) $ by isset_elim [wcel_isset [x1], y5]
y7: $ G ⇒ intys td ⊆ cdm (ixs td w (ifam u E td w)) $ by subset_intro [y6]
d1: $ G , i ∊ cdm (ixs td w (ifam u E td w)) ⇒ i ∊ cdm (ixs td w (ifam u E td w)) $ by ax
d2: $ … ⇒ ∃ y (⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w))) $ by cab_elim [d1]
d3: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) ⇒ ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) $ by ax
e1: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) ⇒ d ∊ (ixs td w (ifam u E td w)) $ by ax
e2: $ … ⇒ ∃ k (k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩) $ by cab_elim [e1]
f0: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) , k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ ⇒ k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ $ by ax
fa: $ … ⇒ k ∊ intys td $ by and_elim_l [f0]
fb: $ … ⇒ d = ⟨ k , ient td w (ifam u E td w) k ⟩ $ by and_elim_r [f0]
fc: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) , k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ ⇒ d = ⟨ i , y ⟩ $ by ax
fd: $ … ⇒ ⟨ i , y ⟩ = ⟨ k , ient td w (ifam u E td w) k ⟩ $ by eq_trans [eq_sym [fc], fb]
g1: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) , k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ ⇒ universe u $ by weaken [#1]
g2: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) , k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ ⇒ (ifam u E td w) ∈ u $ by weaken [#2]
g3: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) , k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ ⇒ (ifam u E td w) ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by weaken [f2]
fe: $ … ⇒ ient td w (ifam u E td w) k ∈ u $ by ient_universe [g1, g2, g3]
isi: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) , k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ ⇒ isset i $ by isset_var
isy: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) , k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ ⇒ isset y $ by isset_var
isk: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) , k ∊ intys td ∧ d = ⟨ k , ient td w (ifam u E td w) k ⟩ ⇒ isset k $ by isset_var
ff: $ … ⇒ i = k ∧ y = ient td w (ifam u E td w) k $ by opair_inj_c [fd, isi, isy, isk, wcel_isset [fe]]
fg: $ … ⇒ i ∊ intys td $ by welc_eq_set [eq_sym [and_elim_l [ff]], fa]
e3: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) , d = ⟨ i , y ⟩ , d ∊ (ixs td w (ifam u E td w)) ⇒ i ∊ intys td $ by ex_elim [e2, fg]
d4: $ G , i ∊ cdm (ixs td w (ifam u E td w)) , ⟨ i , y ⟩ ∈ (ixs td w (ifam u E td w)) ⇒ i ∊ intys td $ by wcel_elim [d3, e3]
d5: $ G , i ∊ cdm (ixs td w (ifam u E td w)) ⇒ i ∊ intys td $ by ex_elim [d2, d4]
d6: $ G ⇒ cdm (ixs td w (ifam u E td w)) ⊆ intys td $ by subset_intro [d5]
d7: $ … ⇒ (ixs td w (ifam u E td w)) ∈ fseq u ∧ cdm (ixs td w (ifam u E td w)) = intys td $ by and_intro [x4, subset_antisym [d6, y7]]

lemma e4_cwf {i n m l x: set} (G: hyps) (J: class) (td tp tt j c tk: set): $ G ⇒ icwf J td $ > $ G ⇒ iprt td tp tt $ > $ G ⇒ ictk td j c tk $ > $ G ⇒ ∃ i ∃ n ∃ m ∃ l ∃ x (fv nvf i = j ∧ ra_clen tp m ∈ lrel ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $
----
u0: $ G , icwf J td ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J))) $ by ax
u1: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J))) $ by imp_elim [imp_intro [u0], #1]
k0: $ G , iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) ⇒ iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) $ by ax
k1: $ … ⇒ iprt td x1 x2 $ by and_elim_l [k0]
k2: $ … ⇒ ra_clen x1 x4 ∈ lrel $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) $ by and_elim_r [and_elim_r [k0]]
w2: $ G , iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) ⇒ iprt td tp tt $ by weaken [#2]
w3: $ G , iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) ⇒ ictk td j c tk $ by weaken [#3]
d1: $ … ⇒ tp = x1 ∧ tt = x2 $ by iprt_det [w2, k1]
r4: $ G , iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) ⇒ x4 = x4 $ by eq_refl
k2b: $ … ⇒ ra_clen tp x4 ∈ lrel $ by wcel_eq_l [ra_clen_eq [eq_sym [and_elim_l [d1]], r4], k2]
a1: $ … ⇒ ∀ x8 ∀ x9 (ictk td j x8 x9 → ∃ x0 (fv nvf x0 = j ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) $ by all_elim [k3]
a2: $ … ⇒ ∀ x9 (ictk td j c x9 → ∃ x0 (fv nvf x0 = j ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) $ by all_elim [a1]
a3: $ … ⇒ ictk td j c tk → ∃ x0 (fv nvf x0 = j ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by all_elim [a2]
a4: $ … ⇒ ∃ x0 (fv nvf x0 = j ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by imp_elim [a3, w3]
b0: $ G , iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) , fv nvf x0 = j ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ fv nvf x0 = j ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J $ by ax
b1: $ G , iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) , fv nvf x0 = j ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ ra_clen tp x4 ∈ lrel $ by weaken [k2b]
b2: $ … ⇒ fv nvf x0 = j ∧ ra_clen tp x4 ∈ lrel ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J $ by and_intro [and_elim_l [b0], and_intro [b1, and_elim_r [b0]]]
b3_4: $ … ⇒ ∃ x (fv nvf x0 = j ∧ ra_clen tp x4 ∈ lrel ∧ ra_cwf td x3 x4 x5 x0 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by ex_intro [b2]
b3_3: $ … ⇒ ∃ l ∃ x (fv nvf x0 = j ∧ ra_clen tp x4 ∈ lrel ∧ ra_cwf td x3 x4 l x0 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by ex_intro [b3_4]
b3_2: $ … ⇒ ∃ m ∃ l ∃ x (fv nvf x0 = j ∧ ra_clen tp m ∈ lrel ∧ ra_cwf td x3 m l x0 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by ex_intro [b3_3]
b3_1: $ … ⇒ ∃ n ∃ m ∃ l ∃ x (fv nvf x0 = j ∧ ra_clen tp m ∈ lrel ∧ ra_cwf td n m l x0 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by ex_intro [b3_2]
b3_0: $ … ⇒ ∃ i ∃ n ∃ m ∃ l ∃ x (fv nvf i = j ∧ ra_clen tp m ∈ lrel ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by ex_intro [b3_1]
b4: $ G , iprt td x1 x2 ∧ ra_clen x1 x4 ∈ lrel ∧ ∀ x7 ∀ x8 ∀ x9 (ictk td x7 x8 x9 → ∃ x0 (fv nvf x0 = x7 ∧ ra_cwf td x3 x4 x5 x0 x6 ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel3 J)) ⇒ ∃ i ∃ n ∃ m ∃ l ∃ x (fv nvf i = j ∧ ra_clen tp m ∈ lrel ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by ex_elim [a4, b3_0]
