lemma e4_tc_cons {r: set} (G: hyps) (t1 t2 t3 a1 a2 a3: set): $ G ⇒ ra_tys_closed t1 t2 ∈ lrel $ > $ G ⇒ t2 = ⟨ kc_tcons , scons a1 (scons a2 (scons a3 ∅)) ⟩ $ > $ G ⇒ t3 = a1 $ > $ G ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $
----
c1: $ … ⇒ ∃ x6 (t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) $ by lrel_tys_closed_cases [#1]
a1: $ G , t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩ ⇒ t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩ $ by ax
a2: $ G , t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩ ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tcons , scons a1 (scons a2 (scons a3 ∅)) ⟩ $ by eq_trans [eq_sym [and_elim_r [a1]], weaken [#2]]
a3: $ G , t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
a4: $ G , t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
a5: $ … ⇒ kc_tnil = kc_tcons $ by opair_inj_l_c [a2, wcel_isset [a3], wcel_isset [a4]]
a6: $ G , t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩ ⇒ ¬ kc_tnil = kc_tcons $ by kc_tnil_ne_tcons
a7: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by bot_elim [not_elim [a6, a5]]
a8: $ G , ∃ x6 (t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ⇒ ∃ x6 (t1 = x6 ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by ax
a9: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by ex_elim [a8, a7]
b1: $ G , t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel ⇒ t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel $ by ax
b2: $ … ⇒ t1 = x6 $ by and_elim_l [b1]
b3: $ … ⇒ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ $ by and_elim_l [and_elim_r [b1]]
b4: $ … ⇒ ra_pis x6 x7 x8 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [b1]]]
b5: $ … ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [b1]]]]
b6: $ … ⇒ ra_tys_closed x6 j ∈ lrel $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [b1]]]]
b7: $ G , t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel ⇒ ⟨ kc_tcons , scons a1 (scons a2 (scons a3 ∅)) ⟩ = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ $ by eq_trans [eq_sym [weaken [#2]], b3]
b7a: $ G , t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
b8: $ … ⇒ a1 = x7 ∧ a2 = x9 ∧ a3 = j $ by node3_inj [wcel_isset [b7a], b7]
b8a: $ G , t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel ⇒ t3 = x7 $ by eq_trans [weaken [#3], and_elim_l [b8]]
b8b: $ G , t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel ⇒ x8 = x8 $ by eq_refl
b9: $ … ⇒ ra_pis t1 t3 x8 ∈ lrel $ by wcel_eq_l [ra_pis_eq [eq_sym [b2], eq_sym [b8a], b8b], b4]
b10: $ … ⇒ ra_tys_closed t1 a3 ∈ lrel $ by wcel_eq_l [ra_tys_closed_eq [eq_sym [b2], eq_sym [and_elim_r [and_elim_r [b8]]]], b6]
b11: $ G , t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $ by ex_intro [and_intro [b9, b5]]
b12: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by and_intro [b11, b10]
e1: $ G , ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) ⇒ ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) $ by ax
e2: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by ex_elim [e1, b12]
e3: $ G , ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) ⇒ ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) $ by ax
e4: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by ex_elim [e3, e2]
e5: $ G , ∃ x8 ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) ⇒ ∃ x8 ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) $ by ax
e6: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by ex_elim [e5, e4]
e7: $ G , ∃ x7 ∃ x8 ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) ⇒ ∃ x7 ∃ x8 ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) $ by ax
e8: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by ex_elim [e7, e6]
e9: $ G , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) ⇒ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j (t1 = x6 ∧ t2 = ⟨ kc_tcons , scons x7 (scons x9 (scons j ∅)) ⟩ ∧ ra_pis x6 x7 x8 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x8 ∈ lrel ∧ ra_tys_closed x6 j ∈ lrel) $ by ax
e10: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by ex_elim [e9, e8]
e11: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 a3 ∈ lrel $ by or_elim [c1, a9, e10]

def e4_tc (P: class) (.y .i .f .e .r: set): class = $ {y | ∀ i ∀ f ∀ e (ra_nth_ty y i f e ∈ lrel → ra_tys_closed P y ∈ lrel → ∃ r (ra_pis P f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel))} $

lemma e4_tc_e {r: set} (G: hyps) (t1 t2 t3 t4 t5: set): $ G ⇒ t2 ∊ e4_tc t1 $ > $ G ⇒ ra_nth_ty t2 t5 t3 t4 ∈ lrel $ > $ G ⇒ ra_tys_closed t1 t2 ∈ lrel $ > $ G ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $
----
l1: $ G ⇒ ∀ i ∀ f ∀ e (ra_nth_ty t2 i f e ∈ lrel → ra_tys_closed t1 t2 ∈ lrel → ∃ r (ra_pis t1 f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel)) $ by cab_elim [#1]
l2: $ … ⇒ ∀ f ∀ e (ra_nth_ty t2 t5 f e ∈ lrel → ra_tys_closed t1 t2 ∈ lrel → ∃ r (ra_pis t1 f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel)) $ by all_elim [l1]
l3: $ … ⇒ ∀ e (ra_nth_ty t2 t5 t3 e ∈ lrel → ra_tys_closed t1 t2 ∈ lrel → ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel)) $ by all_elim [l2]
l4: $ … ⇒ ra_nth_ty t2 t5 t3 t4 ∈ lrel → ra_tys_closed t1 t2 ∈ lrel → ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $ by all_elim [l3]
l5: $ … ⇒ ∃ r (ra_pis t1 t3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $ by imp_elim [imp_elim [l4, #2], #3]

lemma e4_tc_all (G: hyps) (t1: set): $ G ⇒ trees ω ⊆ e4_tc t1 $
----
n1: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel ⇒ ra_nth_ty z i f e ∈ lrel $ by ax
n2: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel ⇒ ra_tys_closed t1 z ∈ lrel $ by ax
n3: $ … ⇒ ∃ x0 ∃ x1 ∃ x2 (z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1) ∨ ∃ x0 ∃ x3 ∃ x1 ∃ x4 ∃ x2 ∃ x5 (z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel) $ by lrel_nth_ty_cases [n1]
z1: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1 ⇒ z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1 $ by ax
z2: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1 ⇒ ∃ r (ra_pis t1 f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 x2 ∈ lrel $ by e4_tc_cons [weaken [n2], and_elim_l [z1], and_elim_l [and_elim_r [and_elim_r [z1]]]]
z3: $ … ⇒ ∃ r (ra_pis t1 f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $ by and_elim_l [z2]
z4: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , ∃ x2 (z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1) ⇒ ∃ x2 (z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1) $ by ax
z5: $ … ⇒ ∃ r (ra_pis t1 f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $ by ex_elim [z4, z3]
z6: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , ∃ x1 ∃ x2 (z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1) ⇒ ∃ x1 ∃ x2 (z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1) $ by ax
z7: $ … ⇒ ∃ r (ra_pis t1 f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $ by ex_elim [z6, z5]
z8: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , ∃ x0 ∃ x1 ∃ x2 (z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1) ⇒ ∃ x0 ∃ x1 ∃ x2 (z = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_nz , ∅ ⟩ ∧ f = x0 ∧ e = x1) $ by ax
z9: $ … ⇒ ∃ r (ra_pis t1 f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $ by ex_elim [z8, z7]
s1: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel ⇒ z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel $ by ax
s2: $ … ⇒ z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ $ by and_elim_l [s1]
s2a: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel ⇒ x3 = x3 $ by eq_refl
s3: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel ⇒ ∃ r (ra_pis t1 x3 r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) ∧ ra_tys_closed t1 x2 ∈ lrel $ by e4_tc_cons [weaken [n2], s2, s2a]
s4: $ … ⇒ ra_tys_closed t1 x2 ∈ lrel $ by and_elim_r [s3]
s5: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel ⇒ z = ⟨ k , c ⟩ $ by ax
s6: $ … ⇒ ⟨ k , c ⟩ = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ $ by eq_trans [eq_sym [s5], s2]
s6a: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
s6b: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel ⇒ isset k $ by isset_var
s6c: $ G , k ∊ ω , c ∊ fseq (trees ω) , crn c ⊆ e4_tc t1 , z = ⟨ k , c ⟩ , ra_nth_ty z i f e ∈ lrel , ra_tys_closed t1 z ∈ lrel , z = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ i = ⟨ kc_s , scons x5 ∅ ⟩ ∧ f = x0 ∧ e = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel ⇒ isset c $ by isset_var
