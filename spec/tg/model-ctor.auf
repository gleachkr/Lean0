lemma e4_nadd_suc_l (G: hyps) (A B: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ nadd (suc A) B = suc (nadd A B) $
----
n1: $ … ⇒ nadd (suc A) B = nadd B (suc A) $ by nadd_comm_c [omega_suc_c [#1], #2]
n2: $ … ⇒ nadd B (suc A) = suc (nadd B A) $ by nadd_suc_c [wcel_isset [#2], #1]
n3: $ … ⇒ suc (nadd B A) = suc (nadd A B) $ by suc_eq [nadd_comm_c [#2, #1]]
n4: $ … ⇒ nadd (suc A) B = suc (nadd A B) $ by eq_trans [n1, eq_trans [n2, n3]]

lemma e4_nadd_suc (G: hyps) (A B C: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ > $ G ⇒ nadd (nadd (suc A) B) C = suc (nadd (nadd A B) C) $
----
n1: $ … ⇒ nadd (suc A) B = suc (nadd A B) $ by e4_nadd_suc_l [#1, #2]
n2: $ G ⇒ C = C $ by eq_refl
n3: $ … ⇒ nadd (nadd (suc A) B) C = nadd (suc (nadd A B)) C $ by nadd_eq [n1, n2]
n4: $ … ⇒ nadd (suc (nadd A B)) C = suc (nadd (nadd A B) C) $ by e4_nadd_suc_l [nadd_omega_c [#1, #2], #3]
n5: $ … ⇒ nadd (nadd (suc A) B) C = suc (nadd (nadd A B) C) $ by eq_trans [n3, n4]

lemma e4_trans (G: hyps) (U A: class) (b1: set): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ b1 ∊ A $ > $ G ⇒ b1 ∊ U $
----
t1: $ G , d = A , d ∊ U ⇒ d ∊ U $ by ax
t2: $ G , d = A , d ∊ U ⇒ universe U $ by weaken [#1]
t3: $ … ⇒ d ⊆ U $ by universe_elem_subset [t2, t1]
t4: $ G , d = A , d ∊ U ⇒ d = A $ by ax
t5: $ G , d = A , d ∊ U ⇒ b1 ∊ A $ by weaken [#3]
t6: $ … ⇒ b1 ∊ d $ by welc_eq [eq_sym [t4], t5]
t7: $ … ⇒ b1 ∊ U $ by subset_elim [t3, t6]
t8: $ … ⇒ b1 ∊ U $ by wcel_elim [#2, t7]

