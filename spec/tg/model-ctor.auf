e5: $ G ⇒ fv nvf t5 = fv nvf t5 $ by eq_refl
g5: $ … ⇒ etel u (dnf u M) t8 w r0 = etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r0 $ by etel_eq [#10, ew, er]
g6a: $ … ⇒ dt u M t8 w r0 = dt u M ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r0 $ by dt_eq [eu, eM, #10, ew, er]
g6b: $ … ⇒ dt u M ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r0 = cpi i (dt u M ta w r0) (dt u M tb w (scons i r0)) $ by dt_pi [g1, g2, #2, #9]
n1: $ … ⇒ fv nvf td = suc (fv nvf t7) $ by eq_trans [fv_eq [env, #7], nvf_s [welc_wcel [#6]]]
n2: $ … ⇒ nadd (nadd (fv nvf td) (fv nvf t3)) (fv nvf t5) = nadd (nadd (suc (fv nvf t7)) (fv nvf t3)) (fv nvf t5) $ by nadd_eq [nadd_eq [n1, e3], e5]
v7: $ G ⇒ isset t7 $ by isset_var
