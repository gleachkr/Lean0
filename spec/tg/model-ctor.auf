lemma e4_pi_i (G: hyps) (M: class) (u w r ta tb x1 f1 g1 s1 a1: set): $ G ⇒ ta ∊ trees ω $ > $ G ⇒ tb ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ x1 ∊ dt u M ta w r $ > $ G ⇒ x1 ∊ u $ > $ G ⇒ ⟨ f1 , ⟨ g1 , ⟨ s1 , a1 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x1 r) $ > $ G ⇒ ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r $
----
l1: $ … ⇒ etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} $ by etel_pi [welc_wcel [#1], welc_wcel [#2], #3, #4]
m0: $ G , z = ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ ⇒ z = ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ $ by ax
m1: $ G , z = ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ ⇒ x1 ∊ dt u M ta w r ∧ x1 ∊ u ∧ ⟨ f1 , ⟨ g1 , ⟨ s1 , a1 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x1 r) ∧ z = ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ $ by and_intro [weaken [#5], and_intro [weaken [#6], and_intro [weaken [#7], m0]]]
m2: $ … ⇒ ∃ a (x1 ∊ dt u M ta w r ∧ x1 ∊ u ∧ ⟨ f1 , ⟨ g1 , ⟨ s1 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x1 r) ∧ z = ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a ⟩ ⟩ ⟩) $ by ex_intro [m1]
m3: $ … ⇒ ∃ t ∃ a (x1 ∊ dt u M ta w r ∧ x1 ∊ u ∧ ⟨ f1 , ⟨ g1 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x1 r) ∧ z = ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩) $ by ex_intro [m2]
m4: $ … ⇒ ∃ g ∃ t ∃ a (x1 ∊ dt u M ta w r ∧ x1 ∊ u ∧ ⟨ f1 , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x1 r) ∧ z = ⟨ ssnoc f1 x1 , ⟨ scons x1 g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩) $ by ex_intro [m3]
m5: $ … ⇒ ∃ f ∃ g ∃ t ∃ a (x1 ∊ dt u M ta w r ∧ x1 ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x1 r) ∧ z = ⟨ ssnoc f x1 , ⟨ scons x1 g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩) $ by ex_intro [m4]
m6: $ … ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩) $ by ex_intro [m5]
m7: $ G , z = ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ ⇒ z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} $ by cab_intro [m6]
m8: $ … ⇒ ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ ∈ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} $ by wcel_intro [m0, m7]
m9: $ G ⇒ isset ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ $ by opair_isset
m10: $ … ⇒ ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ ∈ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} $ by isset_elim [m9, m8]
m11: $ … ⇒ ⟨ ssnoc f1 x1 , ⟨ scons x1 g1 , ⟨ scons (etel u (dnf u M) ta w r) s1 , a1 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r $ by wcel_eq_r [eq_sym [l1], m10]

def e4_cw (U M W J D N Q L I: class) (.y .c .d .r .x .z .f .g .t .a .v: set): class = $ {y | ∀ c ∀ d ∀ r ∀ x (ra_cwf D N Q L I c d y ∈ lrel3 J → y ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → r ∊ fseq U → (∀ z (z ∊ x → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) y W r ∧ z = nest f v))) → (∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) y W r → a ∊ fseq U → apn x f ∈ apn (fv r (nadd (nadd (fv nvf d) (fv nvf Q)) (fv nvf I))) a)) → x ∈ dt U M y W r)} $

lemma e4_cw_e {z f g t a v: set} (G: hyps) (J M: class) (u w t1 t2 t3 t4 t5 ty tc td tr tx: set): $ G ⇒ ty ∊ e4_cw u M w J t1 t2 t3 t4 t5 $ > $ G ⇒ ra_cwf t1 t2 t3 t4 t5 tc td ty ∈ lrel3 J $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ tr ∊ fseq u $ > $ G ⇒ ∀ z (z ∊ tx → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w tr ∧ z = nest f v)) $ > $ G ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w tr → a ∊ fseq u → apn tx f ∈ apn (fv tr (nadd (nadd (fv nvf td) (fv nvf t3)) (fv nvf t5))) a) $ > $ G ⇒ tx ∈ dt u M ty w tr $
----
l1: $ G ⇒ ∀ c ∀ d ∀ r ∀ x (ra_cwf t1 t2 t3 t4 t5 c d ty ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → r ∊ fseq u → (∀ z (z ∊ x → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r ∧ z = nest f v))) → (∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → a ∊ fseq u → apn x f ∈ apn (fv r (nadd (nadd (fv nvf d) (fv nvf t3)) (fv nvf t5))) a)) → x ∈ dt u M ty w r) $ by cab_elim [#1]
l2: $ … ⇒ ∀ d ∀ r ∀ x (ra_cwf t1 t2 t3 t4 t5 tc d ty ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → r ∊ fseq u → (∀ z (z ∊ x → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r ∧ z = nest f v))) → (∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → a ∊ fseq u → apn x f ∈ apn (fv r (nadd (nadd (fv nvf d) (fv nvf t3)) (fv nvf t5))) a)) → x ∈ dt u M ty w r) $ by all_elim [l1]
l3: $ … ⇒ ∀ r ∀ x (ra_cwf t1 t2 t3 t4 t5 tc td ty ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → td ∊ trees ω → r ∊ fseq u → (∀ z (z ∊ x → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r ∧ z = nest f v))) → (∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w r → a ∊ fseq u → apn x f ∈ apn (fv r (nadd (nadd (fv nvf td) (fv nvf t3)) (fv nvf t5))) a)) → x ∈ dt u M ty w r) $ by all_elim [l2]
l4: $ … ⇒ ∀ x (ra_cwf t1 t2 t3 t4 t5 tc td ty ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → td ∊ trees ω → tr ∊ fseq u → (∀ z (z ∊ x → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w tr ∧ z = nest f v))) → (∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w tr → a ∊ fseq u → apn x f ∈ apn (fv tr (nadd (nadd (fv nvf td) (fv nvf t3)) (fv nvf t5))) a)) → x ∈ dt u M ty w tr) $ by all_elim [l3]
l5: $ … ⇒ ra_cwf t1 t2 t3 t4 t5 tc td ty ∈ lrel3 J → ty ∊ ofsort lsig lopen ks_expr → td ∊ trees ω → tr ∊ fseq u → (∀ z (z ∊ tx → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w tr ∧ z = nest f v))) → (∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ty w tr → a ∊ fseq u → apn tx f ∈ apn (fv tr (nadd (nadd (fv nvf td) (fv nvf t3)) (fv nvf t5))) a)) → tx ∈ dt u M ty w tr $ by all_elim [l4]
l6: $ … ⇒ tx ∈ dt u M ty w tr $ by imp_elim [imp_elim [imp_elim [imp_elim [imp_elim [imp_elim [l5, #2], #3], #4], #5], #6], #7]

lemma e4_cw_base {f g t a: set} (G: hyps) (M: class) (u w t1 t2 t3 t5 t7 t8 r0 x0: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ra_indapp t1 t2 t3 t7 t8 t5 ∈ lrel $ > $ G ⇒ t8 ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ r0 ∊ fseq u $ > $ G ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 → a ∊ fseq u → apn x0 f ∈ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) a) $ > $ G ⇒ x0 ∈ dt u M t8 w r0 $
----
b0: $ … ⇒ t8 ∊ trees ω $ by wcel_welc [lsig_ofsort_trees [#4]]
b1: $ … ⇒ etel u (dnf u M) t8 w r0 = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t8 w r0 ⟩ ⟩ ⟩ ∧ dt u M t8 w r0 = apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) (sarg u (dnf u M) t8 w r0) $ by lrel_indapp_sem [#3, b0, #2, #5]
b2: $ … ⇒ sarg u (dnf u M) t8 w r0 ∈ fseq u $ by lrel_indapp_fseq [#3, #1, #4, #2, #5]
ke: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ e = ∅ $ by ax
kb: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ b = sarg u (dnf u M) t8 w r0 $ by ax
b3: $ … ⇒ ⟨ e , ⟨ e , ⟨ e , b ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t8 w r0 ⟩ ⟩ ⟩ $ by opair_eq [ke, opair_eq [ke, opair_eq [ke, kb]]]
b4a: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ isset ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t8 w r0 ⟩ ⟩ ⟩ $ by opair_isset
b4: $ … ⇒ ⟨ e , ⟨ e , ⟨ e , b ⟩ ⟩ ⟩ ∈ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t8 w r0 ⟩ ⟩ ⟩ $ by wcel_eq_l [eq_sym [b3], csn_intro_var_c [b4a]]
b5a: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ etel u (dnf u M) t8 w r0 = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t8 w r0 ⟩ ⟩ ⟩ $ by weaken [and_elim_l [b1]]
b5: $ … ⇒ ⟨ e , ⟨ e , ⟨ e , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 $ by wcel_eq_r [eq_sym [b5a], b4]
bfs: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ sarg u (dnf u M) t8 w r0 ∈ fseq u $ by weaken [b2]
b6a: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 → a ∊ fseq u → apn x0 f ∈ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) a) $ by weaken [#6]
b6b: $ … ⇒ ∀ g ∀ t ∀ a (⟨ e , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 → a ∊ fseq u → apn x0 e ∈ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) a) $ by all_elim [b6a]
b6c: $ … ⇒ ∀ t ∀ a (⟨ e , ⟨ e , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 → a ∊ fseq u → apn x0 e ∈ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) a) $ by all_elim [b6b]
b6d: $ … ⇒ ∀ a (⟨ e , ⟨ e , ⟨ e , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 → a ∊ fseq u → apn x0 e ∈ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) a) $ by all_elim [b6c]
b6e: $ … ⇒ ⟨ e , ⟨ e , ⟨ e , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 → b ∊ fseq u → apn x0 e ∈ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) b $ by all_elim [b6d]
b6: $ … ⇒ apn x0 e ∈ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) b $ by imp_elim [imp_elim [b6e, b5], wcel_welc [wcel_eq_l [eq_sym [kb], bfs]]]
b7a: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ x0 = x0 $ by eq_refl
b7b: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ apn x0 ∅ = x0 $ by apn_empty
b7: $ … ⇒ apn x0 e = x0 $ by eq_trans [apn_eq [b7a, ke], b7b]
b8a: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5)) = fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5)) $ by eq_refl
b8b: $ G , e = ∅ , b = sarg u (dnf u M) t8 w r0 ⇒ dt u M t8 w r0 = apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) (sarg u (dnf u M) t8 w r0) $ by weaken [and_elim_r [b1]]
b8: $ … ⇒ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) b = dt u M t8 w r0 $ by eq_trans [apn_eq [b8a, kb], eq_sym [b8b]]
b9: $ … ⇒ x0 ∈ dt u M t8 w r0 $ by wcel_eq_l [b7, wcel_eq_r [b8, b6]]
b10a: $ G , e = ∅ ⇒ sarg u (dnf u M) t8 w r0 ∈ fseq u $ by weaken [b2]
b10: $ … ⇒ x0 ∈ dt u M t8 w r0 $ by isset_elim [wcel_isset [b10a], b9]
b11a: $ G ⇒ isset ∅ $ by ax_empty
b11: $ … ⇒ x0 ∈ dt u M t8 w r0 $ by isset_elim [b11a, b10]

lemma e4_cw_step {z f g t a v: set} (G: hyps) (J M: class) (u w t1 t2 t3 t4 t5 t7 t8 ta tb tc td r0 x0: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ tb ∊ e4_cw u M w J t1 t2 t3 t4 t5 $ > $ G ⇒ ta ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tb ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ t7 ∊ trees ω $ > $ G ⇒ td = ⟨ kc_s , scons t7 ∅ ⟩ $ > $ G ⇒ ra_cwf t1 t2 t3 t4 t5 tc td tb ∈ lrel3 J $ > $ G ⇒ r0 ∊ fseq u $ > $ G ⇒ t8 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ $ > $ G ⇒ ∀ z (z ∊ x0 → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 ∧ z = nest f v)) $ > $ G ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r0 → a ∊ fseq u → apn x0 f ∈ apn (fv r0 (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf t5))) a) $ > $ G ⇒ x0 ∈ dt u M t8 w r0 $
----
g1: $ … ⇒ ta ∈ trees ω $ by lsig_ofsort_trees [#4]
g2: $ … ⇒ tb ∈ trees ω $ by lsig_ofsort_trees [#5]
g1s: $ … ⇒ ta ∊ trees ω $ by wcel_welc [g1]
g2s: $ … ⇒ tb ∊ trees ω $ by wcel_welc [g2]
g3: $ … ⇒ dt u M ta w r0 ∈ u $ by dt_in_u [#1, #4, #2, #9]
g4: $ … ⇒ universe u $ by uadm_universe [#1]
eu: $ G ⇒ u = u $ by eq_refl
eM: $ G ⇒ M = M $ by eq_refl
ew: $ G ⇒ w = w $ by eq_refl
er: $ G ⇒ r0 = r0 $ by eq_refl
env: $ G ⇒ nvf = nvf $ by eq_refl
