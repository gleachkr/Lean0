lemma e4_pc_all (G: hyps) (k: set): $ G ⇒ trees ω ⊆ e4_pc k $
----
a3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k , z = ⟨ i , j ⟩ , ra_pis z c d ∈ lrel , ra_closed k d ∈ lrel , ra_clen z q ∈ lrel ⇒ crn j ⊆ e4_pc k $ by ax
a4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k , z = ⟨ i , j ⟩ , ra_pis z c d ∈ lrel , ra_closed k d ∈ lrel , ra_clen z q ∈ lrel ⇒ z = ⟨ i , j ⟩ $ by ax
a5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k , z = ⟨ i , j ⟩ , ra_pis z c d ∈ lrel , ra_closed k d ∈ lrel , ra_clen z q ∈ lrel ⇒ ra_pis z c d ∈ lrel $ by ax
a6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k , z = ⟨ i , j ⟩ , ra_pis z c d ∈ lrel , ra_closed k d ∈ lrel , ra_clen z q ∈ lrel ⇒ ra_closed k d ∈ lrel $ by ax
a7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k , z = ⟨ i , j ⟩ , ra_pis z c d ∈ lrel , ra_closed k d ∈ lrel , ra_clen z q ∈ lrel ⇒ ra_clen z q ∈ lrel $ by ax
n1: $ … ⇒ ∃ x (ra_closed x c ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf k)) $ by e4_pc_node [a3, a4, a5, a6, a7]
n2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k , z = ⟨ i , j ⟩ ⇒ ra_pis z c d ∈ lrel → ra_closed k d ∈ lrel → ra_clen z q ∈ lrel → ∃ x (ra_closed x c ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf k)) $ by imp_intro [imp_intro [imp_intro [n1]]]
n3: $ … ⇒ ∀ c ∀ d ∀ q (ra_pis z c d ∈ lrel → ra_closed k d ∈ lrel → ra_clen z q ∈ lrel → ∃ x (ra_closed x c ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf k))) $ by all_intro [all_intro [all_intro [n2]]]
n4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k , z = ⟨ i , j ⟩ ⇒ z ∊ e4_pc k $ by cab_intro [n3]
n5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k , z = ⟨ i , j ⟩ ⇒ z = ⟨ i , j ⟩ $ by ax
n6: $ … ⇒ ⟨ i , j ⟩ ∈ e4_pc k $ by wcel_intro [n5, n4]
n7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_pc k ⇒ isset ⟨ i , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ i , j ⟩ ∈ e4_pc k $ by isset_elim [n7, n6]
n9: $ … ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ e4_pc k → ⟨ i , j ⟩ ∈ e4_pc k $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ e4_pc k → ⟨ i , j ⟩ ∈ e4_pc k) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ e4_pc k $ by trees_ind_c [n11, n10]

lrel_pis_closed
----
l1: $ G ⇒ trees ω ⊆ e4_pc k $ by e4_pc_all
l2a: $ G ⇒ kr_pis ∈ ω $ by kr_pis_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, wcel_isset [l2a]]
l3: $ … ⇒ t1 ∊ e4_pc k $ by subset_elim [l1, and_elim_l [l2]]
l4: $ … ⇒ ∃ x (ra_closed x t2 ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf k)) $ by e4_pc_e [l3, #1, #2, #3]

lemma e4_cc {c d e f: set} (G: hyps) (J: class) (t1 t2 t3 t4 t5 t6 z a b: set): $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 z ∈ lrel3 J $ > $ G ⇒ z = ⟨ kc_ccons , scons a (scons b ∅) ⟩ $ > $ G ⇒ (∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d a f ∈ lrel ∧ ra_closed t2 f ∈ lrel)) ∧ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J $
----
s0: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ m ∃ n ∃ o ∃ p (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_ccons , scons x7 (scons x8 ∅) ⟩ ∧ ra_ind_data x1 m n o ∈ lrel ∧ ra_pis n x7 p ∈ lrel ∧ ra_closed x2 p ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 x6 ⟨ kc_nz , ∅ ⟩ x7 ∈ lrel3 J ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x8 ∈ lrel3 J) $ by lrel3_ctors_wf_cases [#1]
a0: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ $ by ax
an1: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ t1 = x1 $ by and_elim_l [a0]
an2: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ t2 = x2 $ by and_elim_l [and_elim_r [a0]]
an3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ t3 = x3 $ by and_elim_l [and_elim_r [and_elim_r [a0]]]
an4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ t4 = x4 $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [a0]]]]
an5: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ t5 = x5 $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [a0]]]]]
an6: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ t6 = x6 $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [a0]]]]]]
an7: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ z = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [a0]]]]]]
a1: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ z = ⟨ kc_ccons , scons a (scons b ∅) ⟩ $ by weaken [#2]
a2: $ … ⇒ ⟨ kc_cnil , ∅ ⟩ = ⟨ kc_ccons , scons a (scons b ∅) ⟩ $ by eq_trans [eq_sym [an7], a1]
a3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ kc_cnil ∈ ω $ by kc_cnil_omega
a4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
a5: $ … ⇒ kc_cnil = kc_ccons $ by opair_inj_l_c [a2, wcel_isset [a3], wcel_isset [a4]]
a6: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩ ⇒ ¬ kc_cnil = kc_ccons $ by kc_cnil_ne_ccons
a7: $ … ⇒ (∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d a f ∈ lrel ∧ ra_closed t2 f ∈ lrel)) ∧ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J $ by bot_elim [not_elim [a6, a5]]
a8_x5: $ G , ∃ x6 (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩) ⇒ ∃ x6 (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_cnil , ∅ ⟩) $ by ax
a8_y5: $ … ⇒ (∃ c ∃ d ∃ e ∃ f (ra_ind_data t1 c d e ∈ lrel ∧ ra_pis d a f ∈ lrel ∧ ra_closed t2 f ∈ lrel)) ∧ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J $ by ex_elim [a8_x5, a7]
