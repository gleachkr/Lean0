lemma e4_etel_fseq (G: hyps) (E R: class) (u w t0 f1 g1 s1 a1: set): $ G ⇒ t0 ∊ trees ω $ > $ G ⇒ isset R $ > $ G ⇒ ⟨ f1 , ⟨ g1 , ⟨ s1 , a1 ⟩ ⟩ ⟩ ∈ etel u E t0 w R $ > $ G ⇒ f1 ∊ fseq u ∧ g1 ∊ fseq u ∧ cdm g1 = cdm f1 ∧ cdm s1 = cdm f1 $
----
a1: $ G , o = R ⇒ o = R $ by ax
a2: $ G , o = R ⇒ t0 = t0 $ by eq_refl
a3: $ G , o = R ⇒ w = w $ by eq_refl
a4: $ G , o = R ⇒ ⟨ f1 , ⟨ g1 , ⟨ s1 , a1 ⟩ ⟩ ⟩ ∈ etel u E t0 w o $ by wcel_eq_r [etel_eq [a2, a3, eq_sym [a1]], weaken [#3]]
a5: $ G , o = R ⇒ f1 ∊ fseq u ∧ g1 ∊ fseq u ∧ cdm g1 = cdm f1 ∧ cdm s1 = cdm f1 $ by etel_fseq [welc_wcel [weaken [#1]], a4]
a6: $ … ⇒ f1 ∊ fseq u ∧ g1 ∊ fseq u ∧ cdm g1 = cdm f1 ∧ cdm s1 = cdm f1 $ by isset_elim [#2, a5]

lemma e4_pi_e {x f g t: set} (G: hyps) (M: class) (u w r ta tb q1 q2 q3 q4: set): $ G ⇒ ta ∊ trees ω $ > $ G ⇒ tb ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r $ > $ G ⇒ ∃ x ∃ f ∃ g ∃ t (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , q4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ q1 = ssnoc f x ∧ q2 = scons x g) $
----
l1: $ … ⇒ etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} $ by etel_pi [welc_wcel [#1], welc_wcel [#2], #3, #4]
l2: $ … ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} $ by wcel_eq_r [l1, #5]
c0: $ G , z = ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ , z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} ⇒ z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} $ by ax
c1: $ … ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩) $ by cab_elim [c0]
k0: $ G , z = ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ , z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} , x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩ ⇒ x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩ $ by ax
k1: $ … ⇒ x ∊ dt u M ta w r $ by and_elim_l [k0]
k2: $ … ⇒ x ∊ u $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) $ by and_elim_l [and_elim_r [and_elim_r [k0]]]
k4: $ … ⇒ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩ $ by and_elim_r [and_elim_r [and_elim_r [k0]]]
k5: $ G , z = ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ , z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} , x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩ ⇒ z = ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ $ by ax
k6: $ … ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩ $ by eq_trans [eq_sym [k5], k4]
i1: $ G , z = ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ , z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩)} , x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) ta w r) t , a ⟩ ⟩ ⟩ ⇒ isset q1 $ by isset_var
