def e4_pc (K: class) (.z .c .d .q .x: set): class = $ {z | ∀ c ∀ d ∀ q (ra_pis z c d ∈ lrel → ra_closed K d ∈ lrel → ra_clen z q ∈ lrel → ∃ x (ra_closed x c ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf K)))} $

lemma e4_pc_e {x: set} (G: hyps) (k tz tc td tq: set): $ G ⇒ tz ∊ e4_pc k $ > $ G ⇒ ra_pis tz tc td ∈ lrel $ > $ G ⇒ ra_closed k td ∈ lrel $ > $ G ⇒ ra_clen tz tq ∈ lrel $ > $ G ⇒ ∃ x (ra_closed x tc ∈ lrel ∧ fv nvf x = nadd (fv nvf tq) (fv nvf k)) $
----
l1: $ G ⇒ ∀ c ∀ d ∀ q (ra_pis tz c d ∈ lrel → ra_closed k d ∈ lrel → ra_clen tz q ∈ lrel → ∃ x (ra_closed x c ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf k))) $ by cab_elim [#1]
l2: $ … ⇒ ∀ d ∀ q (ra_pis tz tc d ∈ lrel → ra_closed k d ∈ lrel → ra_clen tz q ∈ lrel → ∃ x (ra_closed x tc ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf k))) $ by all_elim [l1]
l3: $ … ⇒ ∀ q (ra_pis tz tc td ∈ lrel → ra_closed k td ∈ lrel → ra_clen tz q ∈ lrel → ∃ x (ra_closed x tc ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf k))) $ by all_elim [l2]
l4: $ … ⇒ ra_pis tz tc td ∈ lrel → ra_closed k td ∈ lrel → ra_clen tz tq ∈ lrel → ∃ x (ra_closed x tc ∈ lrel ∧ fv nvf x = nadd (fv nvf tq) (fv nvf k)) $ by all_elim [l3]
l5: $ … ⇒ ∃ x (ra_closed x tc ∈ lrel ∧ fv nvf x = nadd (fv nvf tq) (fv nvf k)) $ by imp_elim [imp_elim [imp_elim [l4, #2], #3], #4]

lemma e4_pc_node {x: set} (G: hyps) (t1 c d q k k1 j1: set): $ G ⇒ crn j1 ⊆ e4_pc k $ > $ G ⇒ t1 = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_pis t1 c d ∈ lrel $ > $ G ⇒ ra_closed k d ∈ lrel $ > $ G ⇒ ra_clen t1 q ∈ lrel $ > $ G ⇒ ∃ x (ra_closed x c ∈ lrel ∧ fv nvf x = nadd (fv nvf q) (fv nvf k)) $
----
