p7a: $ G , t8 = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ p = ⟨ kc_s , scons t7 ∅ ⟩ ∧ ra_cwf t1 t2 t3 t4 t5 o p n ∈ lrel3 J ⇒ isset k1 $ by isset_var
p7b: $ G , t8 = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ p = ⟨ kc_s , scons t7 ∅ ⟩ ∧ ra_cwf t1 t2 t3 t4 t5 o p n ∈ lrel3 J ⇒ isset j1 $ by isset_var
p7e: $ G , t8 = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ p = ⟨ kc_s , scons t7 ∅ ⟩ ∧ ra_cwf t1 t2 t3 t4 t5 o p n ∈ lrel3 J ⇒ isset n $ by isset_var
p7c: $ G , t8 = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ p = ⟨ kc_s , scons t7 ∅ ⟩ ∧ ra_cwf t1 t2 t3 t4 t5 o p n ∈ lrel3 J ⇒ kc_pi ∈ ω $ by kc_pi_omega
p7d: $ G , t8 = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ p = ⟨ kc_s , scons t7 ∅ ⟩ ∧ ra_cwf t1 t2 t3 t4 t5 o p n ∈ lrel3 J ⇒ isset ∅ $ by ax_empty
