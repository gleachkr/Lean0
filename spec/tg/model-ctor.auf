def e4_ha (U M W Y R X: class) (.z .f .g .t .a .v: set): fml = $ ∀ z (z ∊ X → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) Y W R ∧ z = nest f v)) $

def e4_hb (U M W Q I Y R X D: class) (.f .g .t .a: set): fml = $ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) Y W R → a ∊ fseq U → apn X f ∈ apn (fv R (nadd (nadd (fv nvf D) (fv nvf Q)) (fv nvf I))) a) $

lemma e4_cw_all (G: hyps) (J M: class) (u w t1 t2 t3 t4 t5: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ trees ω ⊆ e4_cw u M w J t1 t2 t3 t4 t5 $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ uadm u $ by weaken [#1]
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ w ∊ lvals $ by weaken [#2]
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 $ by ax
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ y = ⟨ k , j ⟩ $ by ax
a5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J $ by ax
a6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ y ∊ ofsort lsig lopen ks_expr $ by ax
a7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ d ∊ trees ω $ by ax
a8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ r ∊ fseq u $ by ax
a9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ ∀ z (z ∊ x → ∃ f ∃ g ∃ t ∃ a ∃ v (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w r ∧ z = nest f v)) $ by ax
a10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J , y ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , r ∊ fseq u , e4_ha u M w y r x , e4_hb u M w t3 t5 y r x d ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w r → a ∊ fseq u → apn x f ∈ apn (fv r (nadd (nadd (fv nvf d) (fv nvf t3)) (fv nvf t5))) a) $ by ax
n1: $ … ⇒ x ∈ dt u M y w r $ by e4_cw_node [a1, a2, a3, a4, a5, a6, a7, a8, a9, a10]
n2: $ … ⇒ ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J → y ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → r ∊ fseq u → e4_ha u M w y r x → e4_hb u M w t3 t5 y r x d → x ∈ dt u M y w r $ by imp_intro [imp_intro [imp_intro [imp_intro [imp_intro [imp_intro [n1]]]]]]
n3: $ … ⇒ ∀ c ∀ d ∀ r ∀ x (ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J → y ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → r ∊ fseq u → e4_ha u M w y r x → e4_hb u M w t3 t5 y r x d → x ∈ dt u M y w r) $ by all_intro [all_intro [all_intro [all_intro [n2]]]]
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ ⇒ y ∊ e4_cw u M w J t1 t2 t3 t4 t5 $ by cab_intro [n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 , y = ⟨ k , j ⟩ ⇒ y = ⟨ k , j ⟩ $ by ax
n6: $ … ⇒ ⟨ k , j ⟩ ∈ e4_cw u M w J t1 t2 t3 t4 t5 $ by wcel_intro [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n8: $ … ⇒ ⟨ k , j ⟩ ∈ e4_cw u M w J t1 t2 t3 t4 t5 $ by isset_elim [n7, n6]
n9: $ … ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 → ⟨ k , j ⟩ ∈ e4_cw u M w J t1 t2 t3 t4 t5 $ by imp_intro [imp_intro [imp_intro [n8]]]
n10: $ … ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ e4_cw u M w J t1 t2 t3 t4 t5 → ⟨ k , j ⟩ ∈ e4_cw u M w J t1 t2 t3 t4 t5) $ by all_intro [all_intro [n9]]
n11: $ G ⇒ isset ω $ by omega_set
n12: $ … ⇒ trees ω ⊆ e4_cw u M w J t1 t2 t3 t4 t5 $ by trees_ind_c [n11, n10]

lrel3_cwf_trace
----
l1: $ … ⇒ trees ω ⊆ e4_cw u M w J t1 t2 t3 t4 t5 $ by e4_cw_all [#2, #5]
l2: $ … ⇒ t8 ∊ e4_cw u M w J t1 t2 t3 t4 t5 $ by subset_elim [l1, wcel_welc [lsig_ofsort_trees [#3]]]
l3: $ … ⇒ x ∈ dt u M t8 w r $ by e4_cw_e [l2, #1, #3, #4, #6, #7, #8]


lemma e4_apn_empty (G: hyps) (S: class): $ G ⇒ apn ∅ S = ∅ $
----
s1: $ G , x ∊ apn ∅ S ⇒ x ∊ apn ∅ S $ by ax
s2: $ … ⇒ nest S x ∈ ∅ $ by cab_elim [s1]
s3: $ G , x ∊ apn ∅ S , d = nest S x , d ∊ ∅ ⇒ d ∊ ∅ $ by ax
s4: $ … ⇒ ⊥ $ by empty_elim [s3]
s5: $ … ⇒ x ∊ ∅ $ by bot_elim [s4]
s6: $ … ⇒ x ∊ ∅ $ by wcel_elim [s2, s5]
s7: $ … ⇒ apn ∅ S ⊆ ∅ $ by subset_intro [s6]
s8: $ … ⇒ apn ∅ S = ∅ $ by subset_empty [s7]

lemma e4_c_elim {p f g t a y: set} (G: hyps) (E: class) (u w td tp tt j c tk z: set): $ G ⇒ z ∊ (ictor u E td j c w) $ > $ G ⇒ iprt td tp tt $ > $ G ⇒ ictk td j c tk $ > $ G ⇒ tk ∊ trees ω $ > $ G ⇒ (ixs td w (ifam u E td w)) ∈ fseq u $ > $ G ⇒ ∃ p ∃ f ∃ g ∃ t ∃ a ∃ y (p ∊ esat u E tp w ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E tk w (scat p (ixs td w (ifam u E td w))) ∧ z = nest p (nest f y)) $
----
c1: $ … ⇒ ¬ iprop td j w ∧ ∃ x1 ∃ x7 ∃ x8 ∃ x9 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6) $ by cab_elim [#1]
c1r: $ … ⇒ ∃ x1 ∃ x7 ∃ x8 ∃ x9 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6) $ by and_elim_r [c1]
k0: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 $ by ax
k1: $ … ⇒ iprt td x7 x8 $ by and_elim_l [k0]
k2: $ … ⇒ x1 ∊ esat u E x7 w $ by and_elim_l [and_elim_r [k0]]
k3: $ … ⇒ ictk td j c x9 $ by and_elim_l [and_elim_r [and_elim_r [k0]]]
k4: $ … ⇒ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [k0]]]]
k6: $ … ⇒ z = nest (scat x2 x1) x6 $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [k0]]]]]
w2: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ iprt td tp tt $ by weaken [#2]
w3: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ ictk td j c tk $ by weaken [#3]
w4: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ tk ∊ trees ω $ by weaken [#4]
w5: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ (ixs td w (ifam u E td w)) ∈ fseq u $ by weaken [#5]
d1: $ … ⇒ tp = x7 ∧ tt = x8 $ by iprt_det [w2, k1]
d2: $ … ⇒ x9 = tk $ by ictk_det [k3, w3]
rw: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ w = w $ by eq_refl
e1: $ … ⇒ esat u E x7 w = esat u E tp w $ by esat_eq [eq_sym [and_elim_l [d1]], rw]
e2: $ … ⇒ x1 ∊ esat u E tp w $ by welc_eq [e1, k2]
rs: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ scat x1 (ixs td w (ifam u E td w)) = scat x1 (ixs td w (ifam u E td w)) $ by eq_refl
e3: $ … ⇒ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) = etel u E tk w (scat x1 (ixs td w (ifam u E td w))) $ by etel_eq [d2, rw, rs]
e4: $ … ⇒ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E tk w (scat x1 (ixs td w (ifam u E td w))) $ by wcel_eq_r [e3, k4]
pf0: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ esat u E tp w ⊆ fseq u $ by esat_fseq
pf: $ … ⇒ x1 ∊ fseq u $ by subset_elim [pf0, e2]
sx: $ … ⇒ scat x1 (ixs td w (ifam u E td w)) ∈ fseq u $ by scat_fseq_c [welc_wcel [pf], w5]
fs: $ … ⇒ x2 ∊ fseq u ∧ x3 ∊ fseq u ∧ cdm x3 = cdm x2 ∧ cdm x4 = cdm x2 $ by e4_etel_fseq [w4, wcel_isset [sx], e4]
iv: $ G , iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6 ⇒ isset x6 $ by isset_var
n1: $ … ⇒ nest (scat x2 x1) x6 = nest x1 (nest x2 x6) $ by nest_scat [and_elim_l [fs], pf, iv]
n2: $ … ⇒ z = nest x1 (nest x2 x6) $ by eq_trans [k6, n1]
r1: $ … ⇒ x1 ∊ esat u E tp w ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E tk w (scat x1 (ixs td w (ifam u E td w))) ∧ z = nest x1 (nest x2 x6) $ by and_intro [e2, and_intro [e4, n2]]
r2_5: $ … ⇒ ∃ y (x1 ∊ esat u E tp w ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E tk w (scat x1 (ixs td w (ifam u E td w))) ∧ z = nest x1 (nest x2 y)) $ by ex_intro [r1]
r2_4: $ … ⇒ ∃ a ∃ y (x1 ∊ esat u E tp w ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , a ⟩ ⟩ ⟩ ∈ etel u E tk w (scat x1 (ixs td w (ifam u E td w))) ∧ z = nest x1 (nest x2 y)) $ by ex_intro [r2_5]
r2_3: $ … ⇒ ∃ t ∃ a ∃ y (x1 ∊ esat u E tp w ∧ ⟨ x2 , ⟨ x3 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E tk w (scat x1 (ixs td w (ifam u E td w))) ∧ z = nest x1 (nest x2 y)) $ by ex_intro [r2_4]
r2_2: $ … ⇒ ∃ g ∃ t ∃ a ∃ y (x1 ∊ esat u E tp w ∧ ⟨ x2 , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E tk w (scat x1 (ixs td w (ifam u E td w))) ∧ z = nest x1 (nest x2 y)) $ by ex_intro [r2_3]
r2_1: $ … ⇒ ∃ f ∃ g ∃ t ∃ a ∃ y (x1 ∊ esat u E tp w ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E tk w (scat x1 (ixs td w (ifam u E td w))) ∧ z = nest x1 (nest f y)) $ by ex_intro [r2_2]
r2: $ … ⇒ ∃ p ∃ f ∃ g ∃ t ∃ a ∃ y (p ∊ esat u E tp w ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E tk w (scat p (ixs td w (ifam u E td w))) ∧ z = nest p (nest f y)) $ by ex_intro [r2_1]
c2_x8: $ G , ∃ x6 (iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6) ⇒ ∃ x6 (iprt td x7 x8 ∧ x1 ∊ esat u E x7 w ∧ ictk td j c x9 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x9 w (scat x1 (ixs td w (ifam u E td w))) ∧ x6 ∊ scons c x3 ∧ z = nest (scat x2 x1) x6) $ by ax
c2_y8: $ … ⇒ ∃ p ∃ f ∃ g ∃ t ∃ a ∃ y (p ∊ esat u E tp w ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E tk w (scat p (ixs td w (ifam u E td w))) ∧ z = nest p (nest f y)) $ by ex_elim [c2_x8, r2]
