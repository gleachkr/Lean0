-- model-core.mm0: the core rules of the judgment that need the metatheory of
-- the syntax (layer I of the reduction, audit §11), for every hook `M`: the
-- spec's `bvar`, `appDF`, `beta`, `eta`, `instDF` and `weakDF` with `mdeq M`
-- for `deq` (`ty G e A` is `deq G e e A`). With model-den.mm0's eight, these
-- are 14 of the 15 core rules; `eeqv_df` needs a property of the hook (its
-- invariance under `eeqv`) and waits for the hook's definition. Imports
-- model-meta.mm0; proofs in model-core.auf.

import "model-meta.mm0";

theorem mbvar (M: class) (G: ctx) (i: nat) (A: expr):
  $ lookup G i A $ > $ mdeq M G (bvar i) (bvar i) A $;
theorem mappDF (M: class) (G: ctx) (f f2 A B a a2 R: expr):
  $ mdeq M G f f2 (pi A B) $ > $ mdeq M G a a2 A $ > $ inst nz B a R $ >
  $ mdeq M G (app f a) (app f2 a2) R $;
theorem mbeta (M: class) (G: ctx) (A e B a r R: expr):
  $ mdeq M (cons A G) e e B $ > $ mdeq M G a a A $ > $ inst nz e a r $ > $ inst nz B a R $ >
  $ mdeq M G (app (lam A e) a) r R $;
theorem meta (M: class) (G: ctx) (A B e e1: expr):
  $ mdeq M G e e (pi A B) $ > $ lift n1 nz e e1 $ >
  $ mdeq M G (lam A (app e1 (bvar nz))) e (pi A B) $;
theorem minstDF (M: class) (k: nat) (G0 G1 G: ctx) (A0 a e e2 A r r2 R: expr):
  $ mdeq M G0 a a A0 $ > $ cinst k G0 A0 a G1 G $ > $ mdeq M G1 e e2 A $ >
  $ inst k e a r $ > $ inst k e2 a r2 $ > $ inst k A a R $ > $ mdeq M G r r2 R $;
theorem mweakDF (M: class) (n: nat) (G G2: ctx) (e e2 A r r2 R: expr):
  $ mdeq M G e e2 A $ > $ cext n G G2 $ >
  $ lift n nz e r $ > $ lift n nz e2 r2 $ > $ lift n nz A R $ > $ mdeq M G2 r r2 R $;
