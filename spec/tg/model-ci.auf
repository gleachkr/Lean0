l119: $ G , ∃ z (tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) ⇒ ∃ z (tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by ax
l120: $ … ⇒ esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l119, l118]
l121: $ G , ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) ⇒ ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by ax
l122: $ … ⇒ esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l121, l120]
