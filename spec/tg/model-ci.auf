l8: $ G , ∃ v (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v) ⇒ ∃ v (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v) $ by ax
