l177: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ , xx5 = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel , ra_add tnp tnf xx3 ∈ lrel ∧ ra_spine xx5 tmj xx3 ∈ lrel , ra_isort tF tni l ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by fci_inv_rec_rhs [l55, l176]
l178: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ , xx5 = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel , ra_add tnp tnf xx3 ∈ lrel ∧ ra_spine xx5 tmj xx3 ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by ex_elim [l53, l177]
l179: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ , xx5 = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel , ra_add xx1 tni xx2 ∈ lrel ∧ ra_spine xx4 te4 xx2 ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by ex_elim [l43, l178]
l180: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ , xx5 = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel , ra_add xx0 tm xx1 ∈ lrel ∧ ra_spine xx4 te3 xx1 ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by ex_elim [l34, l179]
l181: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ , xx5 = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ , ra_add tnp tn xx0 ∈ lrel ∧ ra_spine xx4 te2 xx0 ∈ lrel ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by ex_elim [l30, l180]
l182: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ , xx5 = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ , xx6 = ⟨ kc_nz , ∅ ⟩ ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by ex_elim [l26, l181]
l183: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ , xx5 = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l184: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ , xx5 = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by isset_elim [l183, l182]
l185: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ ⇒ isset ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ $ by opair_isset
l186: $ G , xx4 = ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by isset_elim [l185, l184]
l187: $ G ⇒ isset ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ $ by opair_isset
l188: $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $ by isset_elim [l187, l186]

def fci10_cc_q  (.y .x .r: set): class = $ {y | ∀ x ∀ r (ra_capp y x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx)} $

lemma fci10_cc_e (G: hyps)  (ty vx vr: set): $ G ⇒ ty ∊ fci10_cc_q  $ > $ G ⇒ ra_capp ty vx vr ∈ lrel $ > $ G ⇒ vr ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G ⇒ ∀ x ∀ r (ra_capp ty x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r (ra_capp ty vx r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx) $ by all_elim [l1]
l3: $ G ⇒ ra_capp ty vx vr ∈ lrel → vr ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by all_elim [l2]
l4: $ G ⇒ vr ∊ ofsort lsig lopen ks_ctx → ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l3, #2]
l5: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by imp_elim [l4, #3]

--| @freshen H qA
--| @freshen H qP
--| @freshen H qG2
lemma fci_inv_capp {qA qP qG2: set} (G H: hyps) (Cf: fml) (t1 t2 t3: set): $ G ⇒ ra_capp t1 t2 t3 ∈ lrel $ > $ H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 ⇒ Cf $ > $ H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_capp t1 t2 t3 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by lrel_capp_cases [l1]
l3: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x $ by ax
l4: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t3 = t2 $ by eq_trans [and_elim_r [and_elim_r [l3]], eq_sym [and_elim_l [and_elim_r [l3]]]]
l5: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 $ by and_intro [and_elim_l [l3], l4]
l6: $ H ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by imp_intro [#2]
l7: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = t2 → Cf $ by weaken [l6]
l8: $ G , H , t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x ⇒ Cf $ by imp_elim [l7, l5]
l9: $ G , H , ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ⇒ ∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) $ by ax
l10: $ … ⇒ Cf $ by ex_elim [l9, l8]
l11: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x)) → Cf $ by imp_intro [l10]
l12: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel $ by ax
l13: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ qP = qP $ by eq_refl
l14: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ qG2 = qG2 $ by eq_refl
l15: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ ra_capp qP t2 qG2 ∈ lrel $ by wcel_eq_l [ra_capp_eq [l13, eq_sym [and_elim_l [and_elim_r [l12]]], l14], and_elim_r [and_elim_r [and_elim_r [l12]]]]
l16: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel $ by and_intro [and_elim_l [l12], and_intro [and_elim_l [and_elim_r [and_elim_r [l12]]], l15]]
l17: $ H ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel → Cf $ by imp_intro [#3]
l18: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP t2 qG2 ∈ lrel → Cf $ by weaken [l17]
l19: $ G , H , t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel ⇒ Cf $ by imp_elim [l18, l16]
l20: $ G , H , ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l21: $ … ⇒ Cf $ by ex_elim [l20, l19]
l22: $ G , H , ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l23: $ … ⇒ Cf $ by ex_elim [l22, l21]
l24: $ G , H , ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l25: $ … ⇒ Cf $ by ex_elim [l24, l23]
l26: $ G , H , ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) ⇒ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel) $ by ax
l27: $ … ⇒ Cf $ by ex_elim [l26, l25]
l28: $ G , H ⇒ (∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel)) → Cf $ by imp_intro [l27]
l29: $ G , H ⇒ (∃ x (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x ∧ t3 = x) ∨ ∃ qA ∃ qP ∃ x ∃ qG2 (t1 = ⟨ kc_cons , scons qA (scons qP ∅) ⟩ ∧ t2 = x ∧ t3 = ⟨ kc_cons , scons qA (scons qG2 ∅) ⟩ ∧ ra_capp qP x qG2 ∈ lrel)) → Cf $ by or_elim_imp [l11, l28]
l30: $ G , H ⇒ Cf $ by imp_elim [l29, l2]

lemma fci10_cc_n (G: hyps)  (ty k1 j1 vx vr: set): $ G ⇒ crn j1 ⊆ fci10_cc_q  $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ ra_capp ty vx vr ∈ lrel $ > $ G ⇒ vr ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $
----
l1: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx $ by ax
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l1]
l3: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ vr = vx $ by and_elim_r [l1]
l4: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ vr ∊ ofsort lsig lopen ks_ctx $ by weaken [#6]
l5: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ⟨ kc_nil , ∅ ⟩ ∈ ofsort lsig lopen ks_ctx $ by ofsort_ctx_nil
l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [l2], l5]]
l7: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vr = vx ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by and_intro [l6, welc_eq_set [l3, l4]]
l8: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel $ by ax
l9: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ by and_elim_l [l8]
l10: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ $ by and_elim_l [and_elim_r [l8]]
l11: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ra_capp p vx x5 ∈ lrel $ by and_elim_r [and_elim_r [l8]]
l12: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ vr ∊ ofsort lsig lopen ks_ctx $ by weaken [#6]
l13: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ isset ∅ $ by ax_empty
l14: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ isset (scons p ∅) $ by scons_set [l13]
l15: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ isset (scons a (scons p ∅)) $ by scons_set [l14]
l16: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ crn j1 ⊆ fci10_cc_q  $ by weaken [#1]
l17: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l18: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l19: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ crn (scons a (scons p ∅)) ⊆ fci10_cc_q  $ by node_crn_sub [l16, l17, l9, wcel_isset [l18], l15]
l20: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ crn (scons p ∅) ⊆ fci10_cc_q  $ by crn_scons_tail [l19]
l21: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ isset p $ by isset_var
l22: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ p ∈ fci10_cc_q  $ by crn_scons_head [l21, l20]
l23: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ a ∊ ofsort lsig lopen ks_expr ∧ x5 ∊ ofsort lsig lopen ks_ctx $ by ofsort_cons_kids [wcel_eq_l [l10, welc_wcel [l12]]]
l24: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ p ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by fci10_cc_e [wcel_welc [l22], l11, and_elim_r [l23]]
l25: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx $ by wcel_welc [wcel_eq_l [eq_sym [l9], ofsort_ctx_cons [welc_wcel [and_elim_l [l23]], welc_wcel [and_elim_l [l24]]]]]
l26: $ G , ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vr = ⟨ kc_cons , scons a (scons x5 ∅) ⟩ ∧ ra_capp p vx x5 ∈ lrel ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by and_intro [l25, and_elim_r [l24]]
l27: $ G ⇒ ty ∊ ofsort lsig lopen ks_ctx ∧ vx ∊ ofsort lsig lopen ks_ctx $ by fci_inv_capp [#5, l7, l26]

lemma fci10_cc_all (G: hyps) : $ G ⇒ trees ω ⊆ fci10_cc_q  $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ crn x9 ⊆ fci10_cc_q  $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ ra_capp y x r ∈ lrel $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ r ∊ ofsort lsig lopen ks_ctx $ by ax
l7: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel , r ∊ ofsort lsig lopen ks_ctx ⇒ y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx $ by fci10_cc_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ , ra_capp y x r ∈ lrel ⇒ r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ra_capp y x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ r (ra_capp y x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ∀ x ∀ r (ra_capp y x r ∈ lrel → r ∊ ofsort lsig lopen ks_ctx → y ∊ ofsort lsig lopen ks_ctx ∧ x ∊ ofsort lsig lopen ks_ctx) $ by all_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ fci10_cc_q  $ by cab_intro [l11]
l13: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  , y = ⟨ x8 , x9 ⟩ ⇒ ⟨ x8 , x9 ⟩ ∈ fci10_cc_q  $ by wcel_intro [l13, l12]
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l16: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ fci10_cc_q  ⇒ ⟨ x8 , x9 ⟩ ∈ fci10_cc_q  $ by isset_elim [l15, l14]
l17: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci10_cc_q  → ⟨ x8 , x9 ⟩ ∈ fci10_cc_q  $ by imp_intro [imp_intro [imp_intro [l16]]]
l18: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ fci10_cc_q  → ⟨ x8 , x9 ⟩ ∈ fci10_cc_q ) $ by all_intro [all_intro [l17]]
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ trees ω ⊆ fci10_cc_q  $ by trees_ind_c [l19, l18]

capp_ctx_inv
------------
l1: $ G ⇒ trees ω ⊆ fci10_cc_q  $ by fci10_cc_all
l2: $ G ⇒ ⟨ kr_capp , scons t1 (scons t2 (scons t3 ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
l3: $ G ⇒ isset ∅ $ by ax_empty
l4: $ G ⇒ isset (scons t3 ∅) $ by scons_set [l3]
l5: $ G ⇒ isset (scons t2 (scons t3 ∅)) $ by scons_set [l4]
l6: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by scons_set [l5]
l7: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
l8: $ G ⇒ kr_capp ∈ ω ∧ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l2, wcel_isset [l7], l6]
l9: $ G ⇒ crn (scons t1 (scons t2 (scons t3 ∅))) ⊆ trees ω $ by fseq_crn_c [and_elim_r [l8]]
l10: $ G ⇒ isset ω $ by omega_set
l11: $ G ⇒ t1 ∈ trees ω $ by crn_scons_head_trees [l10, l9]
l12: $ G ⇒ t1 ∊ fci10_cc_q  $ by subset_elim [l1, wcel_welc [l11]]
l13: $ G ⇒ t1 ∊ ofsort lsig lopen ks_ctx ∧ t2 ∊ ofsort lsig lopen ks_ctx $ by fci10_cc_e [l12, #1, #2]

--| @freshen H qnp
--| @freshen H qn_v
--| @freshen H qm_v
--| @freshen H qmn
--| @freshen H qni
--| @freshen H ql_v
--| @freshen H qa_v
--| @freshen H qd1
--| @freshen H qio
--| @freshen H qmo
--| @freshen H qe1
--| @freshen H qe2
--| @freshen H qY
--| @freshen H qT2
--| @freshen H qT0
lemma fci_inv_iota_lhs {qnp qn_v qm_v qmn qni ql_v qa_v qd1 qio qmo qe1 qe2 qY qT2 qT0: set} (G H: hyps) (Cf: fml) (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set): $ G ⇒ ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ∈ lrel $ > $ H , t11 = ⟨ kc_app , scons qT0 (scons t9 ∅) ⟩ ∧ ra_ind_arity t1 qnp qn_v qm_v ∈ lrel ∧ ra_nidx t1 t3 qni ∈ lrel ∧ ra_add qnp qni ql_v ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons t1 (scons t3 ∅) ⟩ t6 ql_v ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_add t5 qm_v qa_v ∈ lrel ∧ ra_add qa_v qn_v qd1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons t1 (scons t3 (scons t2 ∅)) ⟩ qd1 qnp qe1 ∈ lrel ∧ ra_pargs qe1 qa_v qn_v qe2 ∈ lrel ∧ ra_pargs qe2 t5 qm_v t7 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons t1 (scons t3 ∅) ⟩ qd1 qnp qY ∈ lrel ∧ ra_lift qmn t5 t6 qT2 ∈ lrel ∧ ra_rehead qY t7 qni qT2 t10 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons t1 (scons t3 (scons t4 ∅)) ⟩ qd1 qnp t8 ∈ lrel ∧ ra_pargs t8 ⟨ kc_nz , ∅ ⟩ t5 t9 ∈ lrel ∧ ra_add qio ⟨ kc_s , scons t3 ∅ ⟩ qn_v ∈ lrel ∧ ra_add qa_v qio qmo ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , scons qmo ∅ ⟩ qni qT2 qT0 ∈ lrel ⇒ Cf $ > $ G , H ⇒ Cf $
----
l1: $ G , H ⇒ ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ∈ lrel $ by weaken [#1]
l2: $ G , H ⇒ ∃ x ∃ y ∃ z ∃ u ∃ qnp ∃ qn_v ∃ qm_v ∃ qmn ∃ v ∃ qni ∃ ql_v ∃ qa_v ∃ qd1 ∃ qio ∃ qmo ∃ w ∃ qe1 ∃ qe2 ∃ a ∃ b ∃ qY ∃ qT2 ∃ qT0 ∃ c ∃ f (t1 = x ∧ t2 = y ∧ t3 = z ∧ t4 = u ∧ t5 = v ∧ t6 = w ∧ t7 = a ∧ t8 = c ∧ t9 = f ∧ t10 = b ∧ t11 = ⟨ kc_app , scons qT0 (scons f ∅) ⟩ ∧ ra_ind_arity x qnp qn_v qm_v ∈ lrel ∧ ra_nidx x z qni ∈ lrel ∧ ra_add qnp qni ql_v ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons x (scons z ∅) ⟩ w ql_v ∈ lrel ∧ ra_add qm_v qn_v qmn ∈ lrel ∧ ra_add v qm_v qa_v ∈ lrel ∧ ra_add qa_v qn_v qd1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons x (scons z (scons y ∅)) ⟩ qd1 qnp qe1 ∈ lrel ∧ ra_pargs qe1 qa_v qn_v qe2 ∈ lrel ∧ ra_pargs qe2 v qm_v a ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons x (scons z ∅) ⟩ qd1 qnp qY ∈ lrel ∧ ra_lift qmn v w qT2 ∈ lrel ∧ ra_rehead qY a qni qT2 b ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons x (scons z (scons u ∅)) ⟩ qd1 qnp c ∈ lrel ∧ ra_pargs c ⟨ kc_nz , ∅ ⟩ v f ∈ lrel ∧ ra_add qio ⟨ kc_s , scons z ∅ ⟩ qn_v ∈ lrel ∧ ra_add qa_v qio qmo ∈ lrel ∧ ra_rehead qY ⟨ kc_bvar , scons qmo ∅ ⟩ qni qT2 qT0 ∈ lrel) $ by lrel_iota_lhs_cases [l1]
