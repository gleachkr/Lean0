def fci1_q (M: class) (u w s m tk: set) (.y .t: set): class = $ {y | ∀ t (w ∊ lvals → s ∊ fseq u → m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) y w)} $

lemma fci1_e (G: hyps) (M: class) (u w s m tk: set) (ty vt: set): $ G ⇒ ty ∊ fci1_q M u w s m tk $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ m ∊ fseq u $ > $ G ⇒ cdm m = fv nvf tk $ > $ G ⇒ ra_clift tk ty vt ∈ lrel $ > $ G ⇒ esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $
----
l1: $ G ⇒ ∀ t (w ∊ lvals → s ∊ fseq u → m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk ty t ∈ lrel → esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) ty w) $ by cab_elim [#1]
l2: $ G ⇒ w ∊ lvals → s ∊ fseq u → m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk ty vt ∈ lrel → esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by all_elim [l1]
l3: $ G ⇒ s ∊ fseq u → m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk ty vt ∈ lrel → esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by imp_elim [l2, #2]
l4: $ G ⇒ m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk ty vt ∈ lrel → esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by imp_elim [l3, #3]
l5: $ G ⇒ cdm m = fv nvf tk → ra_clift tk ty vt ∈ lrel → esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by imp_elim [l4, #4]
l6: $ G ⇒ ra_clift tk ty vt ∈ lrel → esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by imp_elim [l5, #5]
l7: $ G ⇒ esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by imp_elim [l6, #6]

lemma fci1_n (G: hyps) (M: class) (u w s m tk: set) (ty k1 j1 vt: set): $ G ⇒ crn j1 ⊆ fci1_q M u w s m tk $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ m ∊ fseq u $ > $ G ⇒ cdm m = fv nvf tk $ > $ G ⇒ ra_clift tk ty vt ∈ lrel $ > $ G ⇒ esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $
----
l1: $ G ⇒ ∃ k (tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩) ∨ ∃ k ∃ d ∃ a ∃ b ∃ p ∃ z (tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel) $ by lrel_clift_cases [#9]
l2: $ G , tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩ ⇒ tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩ $ by ax
l3: $ G , tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩ ⇒ w ∊ lvals $ by weaken [#5]
l4: $ G , tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩ ⇒ w = w $ by eq_refl
l5: $ G , tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩ ⇒ esat u (dsh u M (scat m s)) vt w = csn ∅ $ by eq_trans [esat_eq [and_elim_r [and_elim_r [l2]], l4], esat_nil [l3]]
l6: $ G , tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩ ⇒ esat u (dsh u M s) ty w = csn ∅ $ by eq_trans [esat_eq [and_elim_l [and_elim_r [l2]], l4], esat_nil [l3]]
l7: $ G , tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩ ⇒ esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by eq_trans [l5, eq_sym [l6]]
l8: $ G , ∃ k (tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ k (tk = k ∧ ty = ⟨ kc_nil , ∅ ⟩ ∧ vt = ⟨ kc_nil , ∅ ⟩) $ by ax
l9: $ … ⇒ esat u (dsh u M (scat m s)) vt w = esat u (dsh u M s) ty w $ by ex_elim [l8, l7]
l10: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel $ by ax
l11: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l12: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ isset ∅ $ by ax_empty
l13: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ crn (scons a (scons p ∅)) ⊆ fci1_q M u w s m tk $ by node_crn_sub [weaken [#1], weaken [#2], and_elim_l [and_elim_r [l10]], wcel_isset [l11], scons_set [scons_set [l12]]]
l14: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ isset p $ by isset_var
l15: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ p ∈ fci1_q M u w s m tk $ by crn_scons_head [l14, crn_scons_tail [l13]]
l16: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ isset ω $ by omega_set
l17: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
l18: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ ra_clift tk ty vt ∈ lrel $ by weaken [#9]
l19: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ kr_clift ∈ ω $ by kr_clift_omega
l20: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ tk ∊ trees ω ∧ ty ∊ trees ω ∧ vt ∊ trees ω $ by lrel_args3 [l18, wcel_isset [l19]]
l21: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ a ∊ trees ω ∧ p ∊ trees ω $ by trees_kids2 [l16, wcel_eq_l [and_elim_l [and_elim_r [l10]], welc_wcel [and_elim_l [and_elim_r [l20]]]], wcel_isset [l17]]
l22: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ b ∊ trees ω ∧ z ∊ trees ω $ by trees_kids2 [l16, wcel_eq_l [and_elim_l [and_elim_r [and_elim_r [l10]]], welc_wcel [and_elim_r [and_elim_r [l20]]]], wcel_isset [l17]]
l23: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ a ∈ trees ω $ by welc_wcel [and_elim_l [l21]]
l24: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ p ∈ trees ω $ by welc_wcel [and_elim_r [l21]]
l25: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ b ∈ trees ω $ by welc_wcel [and_elim_l [l22]]
l26: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ z ∈ trees ω $ by welc_wcel [and_elim_r [l22]]
l27: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ w ∊ lvals $ by weaken [#5]
l28: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ s ∊ fseq u $ by weaken [#6]
l29: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ m ∊ fseq u $ by weaken [#7]
l30: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ p = p $ by eq_refl
l31: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ z = z $ by eq_refl
l32: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ ra_clift tk p z ∈ lrel $ by wcel_eq_l [ra_clift_eq [eq_sym [and_elim_l [l10]], l30, l31], and_elim_l [and_elim_r [and_elim_r [and_elim_r [l10]]]]]
l33: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ cdm m = fv nvf tk $ by weaken [#8]
l34: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ esat u (dsh u M (scat m s)) z w = esat u (dsh u M s) p w $ by fci1_e [wcel_welc [l15], l27, l28, l29, l33, l32]
l35: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ cdm m = fv nvf tk $ by weaken [#8]
l36: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ nvf = nvf $ by eq_refl
l37: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ cdm m = fv nvf k $ by eq_trans [l35, fv_eq [l36, and_elim_l [l10]]]
l38: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel ⇒ scat m s ∈ fseq u $ by scat_fseq [l29, l28]
l39: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w ⇒ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ $ by weaken [and_elim_l [and_elim_r [and_elim_r [l10]]]]
l40: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w ⇒ w = w $ by eq_refl
l41: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w ⇒ l ∊ esat u (dsh u M (scat m s)) vt w $ by ax
l42: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w ⇒ l ∊ esat u (dsh u M (scat m s)) ⟨ kc_cons , scons b (scons z ∅) ⟩ w $ by welc_eq [esat_eq [l39, l40], l41]
l43: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w , c ∊ esat u (dsh u M (scat m s)) z w , h ∊ da (fv (dsh u M (scat m s)) b) w c , l = scons h c ⇒ w ∊ lvals $ by weaken [l27]
l44: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w , c ∊ esat u (dsh u M (scat m s)) z w , h ∊ da (fv (dsh u M (scat m s)) b) w c , l = scons h c ⇒ s ∊ fseq u $ by weaken [l28]
l45: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w , c ∊ esat u (dsh u M (scat m s)) z w , h ∊ da (fv (dsh u M (scat m s)) b) w c , l = scons h c ⇒ m ∊ fseq u $ by weaken [l29]
l46: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w , c ∊ esat u (dsh u M (scat m s)) z w , h ∊ da (fv (dsh u M (scat m s)) b) w c , l = scons h c ⇒ scat m s ∈ fseq u $ by weaken [l38]
l47: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w , c ∊ esat u (dsh u M (scat m s)) z w , h ∊ da (fv (dsh u M (scat m s)) b) w c , l = scons h c ⇒ esat u (dsh u M (scat m s)) z w = esat u (dsh u M s) p w $ by weaken [l34]
l48: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M (scat m s)) vt w , c ∊ esat u (dsh u M (scat m s)) z w , h ∊ da (fv (dsh u M (scat m s)) b) w c , l = scons h c ⇒ c ∊ esat u (dsh u M (scat m s)) z w $ by ax
