l111: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da (fv (dsh u M s) a) w c , l = scons h c ⇒ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ $ by weaken [and_elim_l [and_elim_r [and_elim_r [l10]]]]
l112: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da (fv (dsh u M s) a) w c , l = scons h c ⇒ w = w $ by eq_refl
l113: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da (fv (dsh u M s) a) w c , l = scons h c ⇒ l ∊ esat u (dsh u M (scat m s)) vt w $ by wcel_welc [wcel_eq_l [eq_sym [l110], wcel_eq_r [esat_eq [eq_sym [l111], l112], l109]]]
