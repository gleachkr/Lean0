lemma fci1_all (G: hyps) (M: class) (u w s m tk: set): $ G ⇒ trees ω ⊆ fci1_q M u w s m tk $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ crn j ⊆ fci1_q M u w s m tk $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ i ∊ ω $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
l5: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ w ∊ lvals $ by ax
l6: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ s ∊ fseq u $ by ax
l7: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ m ∊ fseq u $ by ax
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ cdm m = fv nvf tk $ by ax
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ ra_clift tk y t ∈ lrel $ by ax
l10: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk , ra_clift tk y t ∈ lrel ⇒ esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) y w $ by fci1_n [l1, l2, l3, l4, l5, l6, l7, l8, l9]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u , cdm m = fv nvf tk ⇒ ra_clift tk y t ∈ lrel → esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) y w $ by imp_intro [l10]
l12: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u , m ∊ fseq u ⇒ cdm m = fv nvf tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) y w $ by imp_intro [l11]
l13: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals , s ∊ fseq u ⇒ m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) y w $ by imp_intro [l12]
l14: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ , w ∊ lvals ⇒ s ∊ fseq u → m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) y w $ by imp_intro [l13]
l15: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ w ∊ lvals → s ∊ fseq u → m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) y w $ by imp_intro [l14]
l16: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ ∀ t (w ∊ lvals → s ∊ fseq u → m ∊ fseq u → cdm m = fv nvf tk → ra_clift tk y t ∈ lrel → esat u (dsh u M (scat m s)) t w = esat u (dsh u M s) y w) $ by all_intro [l15]
l17: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ y ∊ fci1_q M u w s m tk $ by cab_intro [l16]
l18: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l19: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk , y = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ fci1_q M u w s m tk $ by wcel_intro [l18, l17]
l20: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l21: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ fci1_q M u w s m tk ⇒ ⟨ i , j ⟩ ∈ fci1_q M u w s m tk $ by isset_elim [l20, l19]
l22: $ G ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ fci1_q M u w s m tk → ⟨ i , j ⟩ ∈ fci1_q M u w s m tk $ by imp_intro [imp_intro [imp_intro [l21]]]
l23: $ G ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ fci1_q M u w s m tk → ⟨ i , j ⟩ ∈ fci1_q M u w s m tk) $ by all_intro [all_intro [l22]]
l24: $ G ⇒ isset ω $ by omega_set
l25: $ G ⇒ trees ω ⊆ fci1_q M u w s m tk $ by trees_ind_c [l24, l23]

clift_sem
---------
l1: $ G ⇒ kr_clift ∈ ω $ by kr_clift_omega
l2: $ G ⇒ tk ∊ trees ω ∧ tX ∊ trees ω ∧ tY ∊ trees ω $ by lrel_args3 [#5, wcel_isset [l1]]
l3: $ G ⇒ trees ω ⊆ fci1_q M u w s m tk $ by fci1_all
l4: $ G ⇒ tX ∊ fci1_q M u w s m tk $ by subset_elim [l3, and_elim_l [and_elim_r [l2]]]
l5: $ G ⇒ esat u (dsh u M (scat m s)) tY w = esat u (dsh u M s) tX w $ by fci1_e [l4, #1, #2, #3, #4, #5]

def fci2_q (M: class) (u w p s s2 tk: set) (.y .b .t .q: set): class = $ {y | ∀ b ∀ t ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = fv nvf tk → ra_closed tk t ∈ lrel → ra_pis y b t ∈ lrel → ra_clen y q ∈ lrel → esat u (dsh u M (scat p s)) y w = esat u (dsh u M (scat p s2)) y w)} $

lemma fci2_e (G: hyps) (M: class) (u w p s s2 tk: set) (ty vb vt vq: set): $ G ⇒ ty ∊ fci2_q M u w p s s2 tk $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ s2 ∊ fseq u $ > $ G ⇒ cdm p = fv nvf tk $ > $ G ⇒ ra_closed tk vt ∈ lrel $ > $ G ⇒ ra_pis ty vb vt ∈ lrel $ > $ G ⇒ ra_clen ty vq ∈ lrel $ > $ G ⇒ esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $
----
l1: $ G ⇒ ∀ b ∀ t ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = fv nvf tk → ra_closed tk t ∈ lrel → ra_pis ty b t ∈ lrel → ra_clen ty q ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w) $ by cab_elim [#1]
l2: $ G ⇒ ∀ t ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = fv nvf tk → ra_closed tk t ∈ lrel → ra_pis ty vb t ∈ lrel → ra_clen ty q ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w) $ by all_elim [l1]
l3: $ G ⇒ ∀ q (w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = fv nvf tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty q ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w) $ by all_elim [l2]
l4: $ G ⇒ w ∊ lvals → p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = fv nvf tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by all_elim [l3]
l5: $ G ⇒ p ∊ fseq u → s ∊ fseq u → s2 ∊ fseq u → cdm p = fv nvf tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by imp_elim [l4, #2]
l6: $ G ⇒ s ∊ fseq u → s2 ∊ fseq u → cdm p = fv nvf tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by imp_elim [l5, #3]
l7: $ G ⇒ s2 ∊ fseq u → cdm p = fv nvf tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by imp_elim [l6, #4]
l8: $ G ⇒ cdm p = fv nvf tk → ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by imp_elim [l7, #5]
l9: $ G ⇒ ra_closed tk vt ∈ lrel → ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by imp_elim [l8, #6]
l10: $ G ⇒ ra_pis ty vb vt ∈ lrel → ra_clen ty vq ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by imp_elim [l9, #7]
l11: $ G ⇒ ra_clen ty vq ∈ lrel → esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by imp_elim [l10, #8]
l12: $ G ⇒ esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $ by imp_elim [l11, #9]

lemma fci2_n (G: hyps) (M: class) (u w p s s2 tk: set) (ty k1 j1 vb vt vq: set): $ G ⇒ crn j1 ⊆ fci2_q M u w p s s2 tk $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ k1 ∊ ω $ > $ G ⇒ j1 ∊ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ s2 ∊ fseq u $ > $ G ⇒ cdm p = fv nvf tk $ > $ G ⇒ ra_closed tk vt ∈ lrel $ > $ G ⇒ ra_pis ty vb vt ∈ lrel $ > $ G ⇒ ra_clen ty vq ∈ lrel $ > $ G ⇒ esat u (dsh u M (scat p s)) ty w = esat u (dsh u M (scat p s2)) ty w $
----
l1: $ G ⇒ ∃ v (ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v) ∨ ∃ a ∃ v ∃ z ∃ e (ty = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , scons a (scons v ∅) ⟩ z ∈ lrel) $ by lrel_pis_cases [#11]
l2: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v ⇒ ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v $ by ax
