l13: $ G , ty = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ vb = v ∧ vt = z ∧ ra_pis e ⟨ kc_pi , scons a (scons v ∅) ⟩ z ∈ lrel , ty = ⟨ kc_nil , ∅ ⟩ ∧ vq = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_cons , scons a (scons e ∅) ⟩ $ by eq_trans [eq_sym [and_elim_l [l11]], and_elim_l [l12]]
