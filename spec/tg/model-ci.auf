l106: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da (fv (dsh u M s) a) w c , l = scons h c ⇒ h ∊ u $ by scons_fseq_hd [wcel_eq_l [l105, welc_wcel [l104]]]
