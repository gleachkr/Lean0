pis_esat_closed
---------------
l1: $ G ⇒ kr_pis ∈ ω $ by kr_pis_omega
l2: $ G ⇒ tX ∊ trees ω ∧ tB ∊ trees ω ∧ tZ ∊ trees ω $ by lrel_args3 [#7, wcel_isset [l1]]
l3: $ G ⇒ trees ω ⊆ fci2_q M u w p s s2 tk $ by fci2_all
l4: $ G ⇒ tX ∊ fci2_q M u w p s s2 tk $ by subset_elim [l3, and_elim_l [l2]]
l5: $ G ⇒ esat u (dsh u M (scat p s)) tX w = esat u (dsh u M (scat p s2)) tX w $ by fci2_e [l4, #1, #2, #3, #4, #5, #6, #7, #8]

def fci3_q (M: class) (u w r tY tX sa sb: set) (.g .f .n .i .z .q: set): class = $ {g | ∀ f ∀ n (uadm u → w ∊ lvals → r ∊ fseq u → etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ → etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ → sa ∊ fseq u → sb ∊ fseq u → g ∊ ofsort lsig lopen ks_expr → f ∊ trees ω → ra_rehead tY tX n g f ∈ lrel → ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = fv nvf n ∧ etel u (dnf u M) g w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = scat i sa ∧ etel u (dnf u M) f w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = scat i sb))} $

--| @freshen G i
--| @freshen G z
--| @freshen G q
lemma fci3_e {i z q: set} (G: hyps) (M: class) (u w r tY tX sa sb: set) (ty vf vn: set): $ G ⇒ ty ∊ fci3_q M u w r tY tX sa sb $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ $ > $ G ⇒ etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ $ > $ G ⇒ sa ∊ fseq u $ > $ G ⇒ sb ∊ fseq u $ > $ G ⇒ ty ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ vf ∊ trees ω $ > $ G ⇒ ra_rehead tY tX vn ty vf ∈ lrel $ > $ G ⇒ ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = fv nvf vn ∧ etel u (dnf u M) ty w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = scat i sa ∧ etel u (dnf u M) vf w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = scat i sb) $
----
