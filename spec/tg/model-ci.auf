l6: $ G , ty = ⟨ kc_nil , ∅ ⟩ ∧ vb = v ∧ vt = v ⇒ esat u (dsh u M (scat p s2)) ty w = csn ∅ $ by eq_trans [esat_eq [and_elim_l [l2], l4], esat_nil [l3]]
