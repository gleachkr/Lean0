l95: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da (fv (dsh u M s) a) w c , l = scons h c ⇒ da (fv (dsh u M (scat m s)) b) w c = dt u M b w (scat c (scat m s)) $ by dsh_da [l85, l82, l91]
l96: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da (fv (dsh u M s) a) w c , l = scons h c ⇒ da (fv (dsh u M s) a) w c = dt u M a w (scat c s) $ by dsh_da [welc_wcel [l83], l82, l91]
l97: $ G , tk = k ∧ ty = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ vt = ⟨ kc_cons , scons b (scons z ∅) ⟩ ∧ ra_clift k p z ∈ lrel ∧ ra_clen p d ∈ lrel ∧ ra_lift k d a b ∈ lrel , l ∊ esat u (dsh u M s) ty w , c ∊ esat u (dsh u M s) p w , h ∊ da (fv (dsh u M s) a) w c , l = scons h c ⇒ ra_lift k d a b ∈ lrel $ by weaken [and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l10]]]]]]
