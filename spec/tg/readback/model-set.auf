l23: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ i = ⟨ kc_nz , ∅ ⟩ $ by ax
