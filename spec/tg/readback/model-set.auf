l137: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ p = q $ by ex_elim [l16, l136]
l138: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b , ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) ⇒ ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) $ by ax
l139: $ … ⇒ p = q $ by ex_elim [l138, l137]
l140: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b , ∃ d ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) ⇒ ∃ d ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) $ by ax
l141: $ … ⇒ p = q $ by ex_elim [l140, l139]
l142: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b ⇒ p = q $ by ex_elim [l4, l141]
l143: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ ⇒ ∀ p ∀ q (⟨ z , p ⟩ ∈ pcol u w b → ⟨ z , q ⟩ ∈ pcol u w b → p = q) $ by all_intro [all_intro [imp_intro [imp_intro [l142]]]]
l144: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) ⇒ isset (∅ +: i +: f +: ∅) $ by scons_set [scons_set [scons_set [ax_empty []]]]
l145: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) ⇒ ∅ +: i +: f +: ∅ ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)} $ by wcel_cab_intro [l144, l143]
l146: $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) → ∅ +: i +: f +: ∅ ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) $ by all_intro [all_intro [imp_intro [imp_intro [imp_intro [l145]]]]]
l147: $ G ⇒ psv u w b ⊆ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)} $ by ps_ind [#1, #2, l146]
l148: $ G ⇒ v ∊ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)} $ by subset_elim [l147, #3]
l149: $ G ⇒ ∀ p ∀ q (⟨ v , p ⟩ ∈ pcol u w b → ⟨ v , q ⟩ ∈ pcol u w b → p = q) $ by cab_elim [l148]
l150: $ G ⇒ ∀ q (⟨ v , t ⟩ ∈ pcol u w b → ⟨ v , q ⟩ ∈ pcol u w b → t = q) $ by all_elim [l149]
l151: $ G ⇒ ⟨ v , t ⟩ ∈ pcol u w b → ⟨ v , r ⟩ ∈ pcol u w b → t = r $ by all_elim [l150]
l152: $ G ⇒ t = r $ by imp_elim [imp_elim [l151, #4], #5]

lemma fset_u1 (G: hyps): $ G ⇒ universe U₁ $
----
l1: $ G , q = ∅ ⇒ q = ∅ $ by ax
l2: $ G , q = ∅ ⇒ ∅ ∈ ω $ by omega_zero
l3: $ G , q = ∅ ⇒ universe (uni' (suc q)) $ by uni_universe [wcel_welc [wcel_eq_l [eq_sym [l1], l2]]]
l4: $ G , q = ∅ ⇒ uni = uni $ by eq_refl
l5: $ G , q = ∅ ⇒ universe U₁ $ by universe_eq [fv_eq [l4, suc_eq [l1]], l3]
l6: $ G ⇒ isset ∅ $ by ax_empty
l7: $ G ⇒ universe U₁ $ by isset_elim [l6, l5]

--| @freshen G t
lemma pp_tot {t: set} (G: hyps) (b: blk) (u w v: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ v ∊ psv u w b $ > $ G ⇒ ∃ t (t ∊ U₁ ∧ ⟨ v , t ⟩ ∈ pcol u w b) $
----
l1: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) ⇒ i ∊ U₁ $ by ax
l2: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) ⇒ f ∊ (Πₛ a ∈ i, psv u w b) $ by ax
l3: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) ⇒ universe U₁ $ by fset_u1
l4: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i ⇒ ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) $ by ax
l5: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i ⇒ x ∊ i $ by ax
l6: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i ⇒ ap f x ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)} $ by imp_elim [all_elim [l4], l5]
l7: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i ⇒ f ∊ (Πₛ a ∈ i, psv u w b) $ by weaken [l2]
l8: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i ⇒ x ∊ i $ by ax
l9: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i ⇒ ap f x ∈ psv u w b $ by cpi_elim_ap [l7, l8]
l10: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x ⇒ k = ap f x $ by ax
l11: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x ⇒ ap f x ∈ psv u w b $ by weaken [l9]
l12: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x ⇒ k ∊ psv u w b $ by wcel_welc [wcel_eq_l [eq_sym [l10], l11]]
l13: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x ⇒ ap f x ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)} $ by weaken [l6]
l14: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x ⇒ k ∊ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)} $ by wcel_welc [wcel_eq_l [eq_sym [l10], l13]]
l15: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x ⇒ ∃ t (t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b) $ by cab_elim [l14]
l16: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b ⇒ t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b $ by ax
l17: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b ⇒ t ∊ U₁ $ by and_elim_l [l16]
l18: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b ⇒ ⟨ k , t ⟩ ∈ pcol u w b $ by and_elim_r [l16]
l19: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b ⇒ k = ap f x $ by weaken [l10]
l20: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b ⇒ k ∊ psv u w b $ by weaken [l12]
l21: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ k = ap f x $ by weaken [l19]
l22: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ k ∊ psv u w b $ by weaken [l20]
l23: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ ⟨ k , t ⟩ ∈ pcol u w b $ by weaken [l18]
l24: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} $ by ax
l25: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ ⟨ ap f x , h ⟩ ∈ pcol u w b $ by cab_elim [l24]
l26: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ h = h $ by eq_refl
l27: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ ⟨ k , h ⟩ ∈ pcol u w b $ by wcel_eq_l [opair_eq [eq_sym [l21], l26], l25]
l28: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ uadm u $ by weaken [#1]
l29: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ w ∊ lvals $ by weaken [#2]
l30: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ h = t $ by pp_fn [l28, l29, l22, l27, l23]
l31: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ⇒ h ∊ csn t $ by csn_intro [l30]
l32: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , x ∊ i , k = ap f x , t ∊ U₁ ∧ ⟨ k , t ⟩ ∈ pcol u w b , h ∊ csn t ⇒ h ∊ csn t $ by ax
