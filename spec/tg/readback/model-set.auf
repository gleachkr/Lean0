l382: $ G ⇒ ap (ap (dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅) i) f = ∅ +: i +: f +: ∅ $ by isset_elim [l381, l379]

--| @freshen G a
lemma fset_in {a: set} (G: hyps) (H: class) (b: blk) (u w i f: set): $ _ ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ i ∊ U₁ $ > $ G ⇒ f ∊ (Πₛ a ∈ i, dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅) $ > $ G ⇒ ∅ +: i +: f +: ∅ ∈ dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅ $
----
l1: $ G , q = ∅ ⇒ uadm u $ by weaken [#2]
l2: $ G , q = ∅ ⇒ w ∊ lvals $ by weaken [#3]
l3: $ G , q = ∅ ⇒ w ∈ lvals $ by welc_wcel [l2]
l4: $ G , q = ∅ ⇒ i ∊ U₁ $ by weaken [#4]
l5: $ G , q = ∅ ⇒ f ∊ (Πₛ a ∈ i, dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅) $ by weaken [#5]
l6: $ G , q = ∅ ⇒ q = ∅ $ by ax
l7: $ G , q = ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
l8: $ _ ⇒ ∀ yy2 (uadm yy2 → ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat yy2 (mcv H) (enc_ctx nil) yy3 → dt yy2 (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 = dt yy2 (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 ∧ dt yy2 (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 ∈ dt yy2 (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) yy3 yy4))) $ by set_t0 [#1]
l9: $ G , q = ∅ ⇒ ∀ yy2 (uadm yy2 → ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat yy2 (mcv H) (enc_ctx nil) yy3 → dt yy2 (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 = dt yy2 (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 ∧ dt yy2 (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 ∈ dt yy2 (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) yy3 yy4))) $ by weaken [l8]
l10: $ G , q = ∅ ⇒ ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat u (mcv H) (enc_ctx nil) yy3 → dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 ∧ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) yy3 yy4 ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) yy3 yy4)) $ by imp_elim [all_elim [l9], l1]
l11: $ G , q = ∅ ⇒ ∀ yy4 (yy4 ∊ sat u (mcv H) (enc_ctx nil) w → dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w yy4 = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w yy4 ∧ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w yy4 ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w yy4) $ by imp_elim [all_elim [l10], l2]
l12: $ G , q = ∅ ⇒ sat u (mcv H) (enc_ctx nil) w = csn ∅ $ by sat_nil [l2]
l13: $ G , q = ∅ ⇒ q ∊ sat u (mcv H) (enc_ctx nil) w $ by welc_eq [eq_sym [l12], csn_intro [l6]]
l14: $ G , q = ∅ ⇒ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w q = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w q ∧ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w q ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w q $ by imp_elim [all_elim [l11], l13]
l15: $ G , q = ∅ ⇒ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w q ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w q $ by and_elim_r [l14]
