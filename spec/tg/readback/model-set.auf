l1: $ G ⇒ ∃ t (t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b) $ by pp_tot [#1, #2, #3]
l2: $ G , t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b ⇒ t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b $ by ax
l3: $ G , t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b ⇒ t ∊ U₁ $ by and_elim_l [l2]
l4: $ G , t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b ⇒ ⟨ x , t ⟩ ∈ pcol u w b $ by and_elim_r [l2]
