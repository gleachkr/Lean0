lemma fse_3 {a f g i j m n: set} (G: hyps) (b: blk) (E: expr) (u w: set): $ closed nz E $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ inh nil (pset_e3 b E) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ i (i ∊ U₁ → (∀ f (f ∊ (Πₛ a ∈ i, psv u w b) → (∀ j (j ∊ U₁ → (∀ g (g ∊ (Πₛ a ∈ j, psv u w b) → ((∀ n (n ∊ i → ((∀ m (m ∊ j → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥))) → ((∀ m (m ∊ j → ((∀ n (n ∊ i → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥))) → ∅ ∈ ap (ap (cval u w E) (ap (ap (pmk u w b) i) f)) (ap (ap (pmk u w b) j) g)))))))))) $
