h5: $ tys_closed nil (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar (s (s nz)))) (bvar (s (s nz))))) cnil) tnil) $ by tys_closed_cons [h2, h3, h4]
