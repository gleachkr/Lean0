l369: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r ⇒ ∅ ∈ ap (ap (cval u w E) (ap (ap (pmk u w b) i) f)) (ap (ap (pmk u w b) j) g) $ by imp_elim [imp_elim [l368, l286], l367]
l370: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r ⇒ cval u w E = cval u w E $ by eq_refl
l371: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r ⇒ z = ap (ap (pmk u w b) i) f $ by weaken [l21]
l372: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r ⇒ r = ap (ap (pmk u w b) j) g $ by weaken [l22]
l373: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r ⇒ ∅ ∈ ap (ap (cval u w E) z) r $ by wcel_eq_r [ap_eq [ap_eq [l370, eq_sym [l371]], eq_sym [l372]], l369]
l374: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ ⇒ ∅ ∈ ap (ap (cval u w E) z) r ↔ (pcol u w b)' z = (pcol u w b)' r $ by bi_intro [l203, l373]
l375: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , ∃ g (j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅) ⇒ ∃ g (j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅) $ by ax
