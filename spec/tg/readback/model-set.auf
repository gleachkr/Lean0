l3: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ g = enc_ctx nil $ by ax
l4: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) $ by ax
l5: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ n = enc_nat n1 $ by ax
l6: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ i = enc_nat nz $ by ax
l7: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ l = enc_lvl (ls (ls lz)) $ by ax
l8: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ enc_ind (pset_D b) = d $ by eq_sym [l1]
l9: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ enc_blk b = k $ by eq_sym [l2]
l10: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ enc_ctx nil = g $ by eq_sym [l3]
l11: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) = t $ by eq_sym [l4]
