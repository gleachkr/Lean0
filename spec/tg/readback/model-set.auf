l98: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ , h ∊ {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} , n ∊ i ∧ h = (pcol u w b)' (ap f n) , y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b ⇒ h = (pcol u w b)' (ap f n) $ by weaken [l72]
l99: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ , h ∊ {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} , n ∊ i ∧ h = (pcol u w b)' (ap f n) , y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b ⇒ h = y $ by eq_trans [l98, l97]
l100: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ , h ∊ {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} , n ∊ i ∧ h = (pcol u w b)' (ap f n) , y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b ⇒ t = m $ by weaken [l36]
l101: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ , h ∊ {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} , n ∊ i ∧ h = (pcol u w b)' (ap f n) , y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b ⇒ h ∊ t $ by welc_eq [eq_sym [l100], welc_eq_set [eq_sym [l99], l78]]
l102: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ , h ∊ {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} , n ∊ i ∧ h = (pcol u w b)' (ap f n) ⇒ h ∊ t $ by ex_elim [l76, l101]
l103: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ , h ∊ {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} ⇒ h ∊ t $ by ex_elim [l69, l102]
l104: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ t = {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} $ by eq_intro [l67, l103]
l105: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ pcol u w b = pcol u w b $ by eq_refl
l106: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ ap (ap (pmk u w b) i) f = ∅ +: i +: f +: ∅ $ by weaken [l1]
l107: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ z = ∅ +: i +: f +: ∅ $ by weaken [l3]
l108: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ (pcol u w b)' z = t $ by weaken [l15]
l109: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ (pcol u w b)' (ap (ap (pmk u w b) i) f) = {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} $ by eq_trans [fv_eq [l105, eq_trans [l106, eq_sym [l107]]], eq_trans [l108, l104]]
l110: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) ⇒ ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) $ by ax
l111: $ … ⇒ (pcol u w b)' (ap (ap (pmk u w b) i) f) = {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} $ by ex_elim [l110, l109]
l112: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b , ∃ d ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) ⇒ ∃ d ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , t ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) $ by ax
l113: $ … ⇒ (pcol u w b)' (ap (ap (pmk u w b) i) f) = {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} $ by ex_elim [l112, l111]
l114: $ G , z = ∅ +: i +: f +: ∅ , t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b ⇒ (pcol u w b)' (ap (ap (pmk u w b) i) f) = {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} $ by ex_elim [l16, l113]
l115: $ G , z = ∅ +: i +: f +: ∅ ⇒ (pcol u w b)' (ap (ap (pmk u w b) i) f) = {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} $ by ex_elim [l8, l114]
l116: $ G ⇒ isset (∅ +: i +: f +: ∅) $ by scons_set [scons_set [scons_set [ax_empty []]]]
l117: $ G ⇒ (pcol u w b)' (ap (ap (pmk u w b) i) f) = {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} $ by isset_elim [l116, l115]
l118: $ G ⇒ ap (ap (pmk u w b) i) f ∈ psv u w b ∧ (pcol u w b)' (ap (ap (pmk u w b) i) f) = {y | ∃ n (n ∊ i ∧ y = (pcol u w b)' (ap f n))} $ by and_intro [wcel_eq_l [eq_sym [l1], l2], l117]

--| @freshen G x
lemma cp_i {x: set} (G: hyps) (A: class) (B: class x): $ G ⇒ ∀ x (x ∊ A → ∅ ∈ B) $ > $ G ⇒ ∅ ∈ (Πₛ x ∈ A, B) $
----
l1: $ G , q = ∅ ⇒ q = ∅ $ by ax
l2: $ G , q = ∅ ⇒ ∅ ⊆ (λₛ x ∈ A, ⋃ B) $ by empty_subset
l3: $ G , q = ∅ ⇒ q ⊆ (λₛ x ∈ A, ⋃ B) $ by subset_trans [eq_subset [l1], l2]
l4: $ G , q = ∅ , x ∊ A ⇒ ∀ x (x ∊ A → ∅ ∈ B) $ by weaken [#1]
l5: $ G , q = ∅ , x ∊ A ⇒ x ∊ A $ by ax
l6: $ G , q = ∅ , x ∊ A ⇒ ∅ ∈ B $ by imp_elim [all_elim [l4], l5]
l7: $ G , q = ∅ , x ∊ A ⇒ q = ∅ $ by weaken [l1]
l8: $ G , q = ∅ , x ∊ A ⇒ x = x $ by eq_refl
l9: $ G , q = ∅ , x ∊ A ⇒ ap ∅ x = ∅ $ by ap_empty
l10: $ G , q = ∅ , x ∊ A ⇒ ap q x = ∅ $ by eq_trans [ap_eq [l7, l8], l9]
l11: $ G , q = ∅ , x ∊ A ⇒ ap q x ∈ B $ by wcel_eq_l [eq_sym [l10], l6]
l12: $ G , q = ∅ ⇒ ∀ x (x ∊ A → ap q x ∈ B) $ by all_intro [imp_intro [l11]]
l13: $ G , q = ∅ ⇒ q ∊ (Πₛ x ∈ A, B) $ by cpi_intro [l3, l12]
l14: $ G , q = ∅ ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ by wcel_eq_l [l1, welc_wcel [l13]]
l15: $ G ⇒ isset ∅ $ by ax_empty
l16: $ G ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ by isset_elim [l15, l14]

lemma cp_e {x: set} (G: hyps x) (A: class) (B: class x) (a: set): $ G ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ > $ G ⇒ a ∊ A $ > $ G ⇒ ∅ ∈ ([[ x / a ]] B) $
----
l1: $ G , q = ∅ ⇒ q = ∅ $ by ax
l2: $ G , q = ∅ ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ by weaken [#1]
l3: $ G , q = ∅ ⇒ q ∊ (Πₛ x ∈ A, B) $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , q = ∅ ⇒ a ∊ A $ by weaken [#2]
l5: $ G , q = ∅ ⇒ ap q a ∈ ([[ x / a ]] B) $ by cpi_elim_ap [l3, l4]
l6: $ G , q = ∅ ⇒ a = a $ by eq_refl
l7: $ G , q = ∅ ⇒ ap ∅ a = ∅ $ by ap_empty
l8: $ G , q = ∅ ⇒ ap q a = ∅ $ by eq_trans [ap_eq [l1, l6], l7]
l9: $ G , q = ∅ ⇒ ∅ ∈ ([[ x / a ]] B) $ by wcel_eq_l [l8, l5]
l10: $ G ⇒ isset ∅ $ by ax_empty
l11: $ G ⇒ ∅ ∈ ([[ x / a ]] B) $ by isset_elim [l10, l9]

--| @freshen G x
--| @freshen G z
lemma fl_pi {x z: set} (G: hyps) (A: class) (B: class x) (f: set): $ G ⇒ f ∊ (Πₛ x ∈ A, B) $ > $ G ⇒ ∀ x (x ∊ A → ∃ z (z ∊ B) → ∅ ∈ B) $ > $ G ⇒ ∅ ∈ (Πₛ x ∈ A, B) $
----
l1: $ G ⇒ f ⊆ (λₛ x ∈ A, ⋃ B) ∧ ∀ x (x ∊ A → ap f x ∈ B) $ by cab_elim [#1]
l2: $ G , x ∊ A ⇒ ∀ x (x ∊ A → ap f x ∈ B) $ by weaken [and_elim_r [l1]]
l3: $ G , x ∊ A ⇒ x ∊ A $ by ax
l4: $ G , x ∊ A ⇒ ap f x ∈ B $ by imp_elim [all_elim [l2], l3]
l5: $ G , x ∊ A , y = ap f x ⇒ y = ap f x $ by ax
l6: $ G , x ∊ A , y = ap f x ⇒ ap f x ∈ B $ by weaken [l4]
l7: $ G , x ∊ A , y = ap f x ⇒ y ∊ B $ by wcel_welc [wcel_eq_l [eq_sym [l5], l6]]
l8: $ G , x ∊ A , y = ap f x ⇒ ∃ z (z ∊ B) $ by ex_intro [l7]
l9: $ G , x ∊ A , y = ap f x ⇒ ∀ x (x ∊ A → ∃ z (z ∊ B) → ∅ ∈ B) $ by weaken [#2]
l10: $ G , x ∊ A ⇒ x ∊ A $ by ax
l11: $ G , x ∊ A , y = ap f x ⇒ x ∊ A $ by weaken [l10]
l12: $ G , x ∊ A , y = ap f x ⇒ ∅ ∈ B $ by imp_elim [imp_elim [all_elim [l9], l11], l8]
l13: $ G , x ∊ A ⇒ isset (ap f x) $ by wcel_isset [l4]
l14: $ G , x ∊ A ⇒ ∅ ∈ B $ by isset_elim [l13, l12]
l15: $ G ⇒ ∀ x (x ∊ A → ∅ ∈ B) $ by all_intro [imp_intro [l14]]
l16: $ G ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ by cp_i [l15]

lemma fl_two (G: hyps) (V: class) (z: set): $ G ⇒ V ∈ two $ > $ G ⇒ z ∊ V $ > $ G ⇒ ∅ ∈ V $
----
l1: $ G , v = V ⇒ v = V $ by ax
l2: $ G , v = V ⇒ V ∈ two $ by weaken [#1]
l3: $ G , v = V ⇒ v ∊ two $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , v = V ⇒ v = ∅ ∨ v = csn ∅ $ by two_elim [l3]
l5: $ G , v = V ⇒ z ∊ V $ by weaken [#2]
l6: $ G , v = V , v = ∅ ⇒ v = V $ by weaken [l1]
l7: $ G , v = V , v = ∅ ⇒ v = ∅ $ by ax
l8: $ G , v = V , v = ∅ ⇒ z ∊ V $ by weaken [l5]
l9: $ G , v = V , v = ∅ ⇒ z ∊ ∅ $ by welc_eq [eq_trans [eq_sym [l6], l7], l8]
l10: $ G , v = V , v = ∅ ⇒ ∅ ∈ V $ by bot_elim [empty_elim [l9]]
l11: $ G , v = V , v = csn ∅ ⇒ isset ∅ $ by ax_empty
l12: $ G , v = V , v = csn ∅ ⇒ ∅ ∈ csn ∅ $ by csn_intro_var_c [l11]
l13: $ G , v = V , v = csn ∅ ⇒ v = csn ∅ $ by ax
l14: $ G , v = V , v = csn ∅ ⇒ v = V $ by weaken [l1]
l15: $ G , v = V , v = csn ∅ ⇒ ∅ ∈ V $ by wcel_eq_r [eq_trans [eq_sym [l13], l14], l12]
l16: $ G , v = V ⇒ ∅ ∈ V $ by or_elim [l4, l10, l15]
l17: $ G ⇒ V ∈ two $ by weaken [#1]
l18: $ G ⇒ isset V $ by wcel_isset [l17]
l19: $ G ⇒ ∅ ∈ V $ by isset_elim [l18, l16]

--| @freshen G p
lemma fl_bot {p: set} (G: hyps) (z: set): $ G ⇒ z ∊ (Πₛ p ∈ uni' ∅, p) $ > $ G ⇒ ⊥ $
----
l1: $ G , q = ∅ ⇒ q = ∅ $ by ax
l2: $ G , q = ∅ ⇒ uni' ∅ = two $ by uni_zero
l3: $ G , q = ∅ ⇒ ∅ ∈ two $ by two_intro_l
l4: $ G , q = ∅ ⇒ q ∊ uni' ∅ $ by wcel_welc [wcel_eq_l [eq_sym [l1], wcel_eq_r [eq_sym [l2], l3]]]
l5: $ G , q = ∅ ⇒ z ∊ (Πₛ p ∈ uni' ∅, p) $ by weaken [#1]
l6: $ G , q = ∅ ⇒ ap z q ∈ q $ by cpi_elim_ap [l5, l4]
l7: $ G , q = ∅ ⇒ ap z q ∈ ∅ $ by wcel_eq_r [l1, l6]
l8: $ G , q = ∅ , y = ap z q , y ∊ ∅ ⇒ y ∊ ∅ $ by ax
l9: $ G , q = ∅ , y = ap z q , y ∊ ∅ ⇒ ⊥ $ by empty_elim [l8]
l10: $ G , q = ∅ ⇒ ⊥ $ by wcel_elim [l7, l9]
l11: $ G ⇒ isset ∅ $ by ax_empty
l12: $ G ⇒ ⊥ $ by isset_elim [l11, l10]

--| @freshen G x
lemma cp_mp {x: set} (G: hyps) (A B: class): $ G ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ > $ G ⇒ ∅ ∈ A $ > $ G ⇒ ∅ ∈ B $
----
l1: $ G , q = ∅ ⇒ q = ∅ $ by ax
l2: $ G , q = ∅ ⇒ ∅ ∈ A $ by weaken [#2]
l3: $ G , q = ∅ ⇒ q ∊ A $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , q = ∅ ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ by weaken [#1]
l5: $ G , q = ∅ ⇒ ∅ ∈ B $ by cp_e [l4, l3]
l6: $ G ⇒ isset ∅ $ by ax_empty
l7: $ G ⇒ ∅ ∈ B $ by isset_elim [l6, l5]

--| @freshen G p
lemma fl_bot2 {p: set} (G: hyps): $ G ⇒ ∅ ∈ (Πₛ p ∈ uni' ∅, p) $ > $ G ⇒ ⊥ $
----
l1: $ G , q = ∅ ⇒ q = ∅ $ by ax
l2: $ G , q = ∅ ⇒ ∅ ∈ (Πₛ p ∈ uni' ∅, p) $ by weaken [#1]
l3: $ G , q = ∅ ⇒ q ∊ (Πₛ p ∈ uni' ∅, p) $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , q = ∅ ⇒ ⊥ $ by fl_bot [l3]
l5: $ G ⇒ isset ∅ $ by ax_empty
l6: $ G ⇒ ⊥ $ by isset_elim [l5, l4]

--| @freshen G x
--| @freshen G y
lemma at2 {x y: set} (G: hyps) (F S T Y: class): $ G ⇒ F ∈ (Πₛ x ∈ Y, (Πₛ y ∈ Y, uni' ∅)) $ > $ G ⇒ S ∈ Y $ > $ G ⇒ T ∈ Y $ > $ G ⇒ ap (ap F S) T ∈ two $
----
l1: $ G , f = F , i = S , j = T ⇒ f = F $ by ax
l2: $ G , f = F , i = S , j = T ⇒ i = S $ by ax
l3: $ G , f = F , i = S , j = T ⇒ j = T $ by ax
l4: $ G , f = F , i = S , j = T ⇒ F ∈ (Πₛ x ∈ Y, (Πₛ y ∈ Y, uni' ∅)) $ by weaken [#1]
l5: $ G , f = F , i = S , j = T ⇒ f ∊ (Πₛ x ∈ Y, (Πₛ y ∈ Y, uni' ∅)) $ by wcel_welc [wcel_eq_l [eq_sym [l1], l4]]
l6: $ G , f = F , i = S , j = T ⇒ S ∈ Y $ by weaken [#2]
l7: $ G , f = F , i = S , j = T ⇒ i ∊ Y $ by wcel_welc [wcel_eq_l [eq_sym [l2], l6]]
l8: $ G , f = F , i = S , j = T ⇒ T ∈ Y $ by weaken [#3]
l9: $ G , f = F , i = S , j = T ⇒ j ∊ Y $ by wcel_welc [wcel_eq_l [eq_sym [l3], l8]]
l10: $ G , f = F , i = S , j = T ⇒ ap f i ∈ (Πₛ y ∈ Y, uni' ∅) $ by cpi_elim_ap [l5, l7]
l11: $ G , f = F , i = S , j = T , g = ap f i ⇒ g = ap f i $ by ax
l12: $ G , f = F , i = S , j = T , g = ap f i ⇒ ap f i ∈ (Πₛ y ∈ Y, uni' ∅) $ by weaken [l10]
l13: $ G , f = F , i = S , j = T , g = ap f i ⇒ g ∊ (Πₛ y ∈ Y, uni' ∅) $ by wcel_welc [wcel_eq_l [eq_sym [l11], l12]]
l14: $ G , f = F , i = S , j = T , g = ap f i ⇒ j ∊ Y $ by weaken [l9]
l15: $ G , f = F , i = S , j = T , g = ap f i ⇒ ap g j ∈ uni' ∅ $ by cpi_elim_ap [l13, l14]
l16: $ G , f = F , i = S , j = T , g = ap f i ⇒ f = F $ by weaken [l1]
l17: $ G , f = F , i = S , j = T , g = ap f i ⇒ i = S $ by weaken [l2]
l18: $ G , f = F , i = S , j = T , g = ap f i ⇒ j = T $ by weaken [l3]
l19: $ G , f = F , i = S , j = T , g = ap f i ⇒ ap g j = ap (ap F S) T $ by ap_eq [eq_trans [l11, ap_eq [l16, l17]], l18]
l20: $ G , f = F , i = S , j = T , g = ap f i ⇒ uni' ∅ = two $ by uni_zero
l21: $ G , f = F , i = S , j = T , g = ap f i ⇒ ap (ap F S) T ∈ two $ by wcel_eq_l [l19, wcel_eq_r [l20, l15]]
l22: $ G , f = F , i = S , j = T ⇒ isset (ap f i) $ by wcel_isset [l10]
l23: $ G , f = F , i = S , j = T ⇒ ap (ap F S) T ∈ two $ by isset_elim [l22, l21]
l24: $ G , f = F , i = S ⇒ T ∈ Y $ by weaken [#3]
l25: $ G , f = F , i = S ⇒ isset T $ by wcel_isset [l24]
l26: $ G , f = F , i = S ⇒ ap (ap F S) T ∈ two $ by isset_elim [l25, l23]
l27: $ G , f = F ⇒ S ∈ Y $ by weaken [#2]
l28: $ G , f = F ⇒ isset S $ by wcel_isset [l27]
l29: $ G , f = F ⇒ ap (ap F S) T ∈ two $ by isset_elim [l28, l26]
l30: $ G ⇒ F ∈ (Πₛ x ∈ Y, (Πₛ y ∈ Y, uni' ∅)) $ by weaken [#1]
l31: $ G ⇒ isset F $ by wcel_isset [l30]
l32: $ G ⇒ ap (ap F S) T ∈ two $ by isset_elim [l31, l29]

--| @freshen G x
lemma cp_ea {x: set} (G: hyps) (A: class) (B: class x): $ G ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ > $ G ⇒ ∀ x (x ∊ A → ∅ ∈ B) $
----
l1: $ G , q = ∅ ⇒ q = ∅ $ by ax
l2: $ G , q = ∅ ⇒ ∅ ∈ (Πₛ x ∈ A, B) $ by weaken [#1]
l3: $ G , q = ∅ ⇒ q ∊ (Πₛ x ∈ A, B) $ by wcel_welc [wcel_eq_l [eq_sym [l1], l2]]
l4: $ G , q = ∅ ⇒ q ⊆ (λₛ x ∈ A, ⋃ B) ∧ ∀ x (x ∊ A → ap q x ∈ B) $ by cab_elim [l3]
l5: $ G , q = ∅ ⇒ ∀ x (x ∊ A → ap q x ∈ B) $ by and_elim_r [l4]
l6: $ G , q = ∅ , x ∊ A ⇒ ∀ x (x ∊ A → ap q x ∈ B) $ by weaken [l5]
l7: $ G , q = ∅ , x ∊ A ⇒ x ∊ A $ by ax
l8: $ G , q = ∅ , x ∊ A ⇒ ap q x ∈ B $ by imp_elim [all_elim [l6], l7]
l9: $ G , q = ∅ , x ∊ A ⇒ q = ∅ $ by weaken [l1]
l10: $ G , q = ∅ , x ∊ A ⇒ x = x $ by eq_refl
l11: $ G , q = ∅ , x ∊ A ⇒ ap ∅ x = ∅ $ by ap_empty
l12: $ G , q = ∅ , x ∊ A ⇒ ap q x = ∅ $ by eq_trans [ap_eq [l9, l10], l11]
l13: $ G , q = ∅ , x ∊ A ⇒ ∅ ∈ B $ by wcel_eq_l [l12, l8]
l14: $ G , q = ∅ ⇒ ∀ x (x ∊ A → ∅ ∈ B) $ by all_intro [imp_intro [l13]]
l15: $ G ⇒ isset ∅ $ by ax_empty
l16: $ G ⇒ ∀ x (x ∊ A → ∅ ∈ B) $ by isset_elim [l15, l14]

--| @freshen G a
--| @freshen G f
--| @freshen G g
--| @freshen G i
--| @freshen G j
--| @freshen G m
--| @freshen G n
lemma fse_1 {a f g i j m n: set} (G: hyps) (b: blk) (E: expr) (u w: set): $ closed nz E $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ inh nil (pset_e1 b E) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ i (i ∊ U₁ → (∀ f (f ∊ (Πₛ a ∈ i, psv u w b) → (∀ j (j ∊ U₁ → (∀ g (g ∊ (Πₛ a ∈ j, psv u w b) → (∅ ∈ ap (ap (cval u w E) (ap (ap (pmk u w b) i) f)) (ap (ap (pmk u w b) j) g) → (∀ n (n ∊ i → ((∀ m (m ∊ j → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥))))))))))) $
----
l1: $ G , q = ∅ ⇒ uadm u $ by weaken [#4]
l2: $ G , q = ∅ ⇒ w ∊ lvals $ by weaken [#5]
l3: $ G , q = ∅ ⇒ w ∈ lvals $ by welc_wcel [l2]
l4: $ G , q = ∅ ⇒ q = ∅ $ by ax
l5: $ G , q = ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
l6: $ G , q = ∅ ⇒ lv (enc_lvl lz) w = ∅ $ by lv_lz
l7: $ G , q = ∅ ⇒ enc_lvl lz ∈ trees ω $ by enc_lvl_trees
l8: $ G , q = ∅ ⇒ enc_lvl (ls lz) ∈ trees ω $ by enc_lvl_trees
l9: $ G , q = ∅ ⇒ lv (enc_lvl (ls lz)) w = suc (lv (enc_lvl lz) w) $ by lv_ls [l7, l2]
l10: $ G , q = ∅ ⇒ lv (enc_lvl (ls lz)) w = suc ∅ $ by eq_trans [l9, suc_eq [l6]]
l11: $ G , q = ∅ ⇒ lv (enc_lvl (ls (ls lz))) w = suc (lv (enc_lvl (ls lz)) w) $ by lv_ls [l8, l2]
l12: $ G , q = ∅ ⇒ lv (enc_lvl (ls (ls lz))) w = suc (suc ∅) $ by eq_trans [l11, suc_eq [l10]]
l13: $ G , q = ∅ ⇒ sat u (mcv hfin) (enc_ctx nil) w = csn ∅ $ by sat_nil [l2]
l14: $ G , q = ∅ ⇒ q ∊ sat u (mcv hfin) (enc_ctx nil) w $ by welc_eq [eq_sym [l13], csn_intro [l4]]
l15: $ G , q = ∅ ⇒ ∀ yy2 (uadm yy2 → ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat yy2 (mcv hfin) (enc_ctx nil) yy3 → dt yy2 (mcv hfin) (enc_expr (E)) yy3 yy4 = dt yy2 (mcv hfin) (enc_expr (E)) yy3 yy4 ∧ dt yy2 (mcv hfin) (enc_expr (E)) yy3 yy4 ∈ dt yy2 (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) yy3 yy4))) $ by weaken [#2]
l16: $ G , q = ∅ ⇒ ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat u (mcv hfin) (enc_ctx nil) yy3 → dt u (mcv hfin) (enc_expr (E)) yy3 yy4 = dt u (mcv hfin) (enc_expr (E)) yy3 yy4 ∧ dt u (mcv hfin) (enc_expr (E)) yy3 yy4 ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) yy3 yy4)) $ by imp_elim [all_elim [l15], l1]
l17: $ G , q = ∅ ⇒ ∀ yy4 (yy4 ∊ sat u (mcv hfin) (enc_ctx nil) w → dt u (mcv hfin) (enc_expr (E)) w yy4 = dt u (mcv hfin) (enc_expr (E)) w yy4 ∧ dt u (mcv hfin) (enc_expr (E)) w yy4 ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w yy4) $ by imp_elim [all_elim [l16], l2]
l18: $ G , q = ∅ ⇒ dt u (mcv hfin) (enc_expr (E)) w q = dt u (mcv hfin) (enc_expr (E)) w q ∧ dt u (mcv hfin) (enc_expr (E)) w q ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w q $ by imp_elim [all_elim [l17], l14]
l19: $ G , q = ∅ ⇒ dt u (mcv hfin) (enc_expr (E)) w q ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w q $ by and_elim_r [l18]
l20: $ G , q = ∅ ⇒ u = u $ by eq_refl
l21: $ G , q = ∅ ⇒ mcv hfin = mcv hfin $ by eq_refl
l22: $ G , q = ∅ ⇒ enc_expr (E) = enc_expr (E) $ by eq_refl
l23: $ G , q = ∅ ⇒ w = w $ by eq_refl
l24: $ G , q = ∅ ⇒ enc_expr (pi (pset b) (pi (pset b) (Prop))) = enc_expr (pi (pset b) (pi (pset b) (Prop))) $ by eq_refl
l25: $ G , q = ∅ ⇒ cval u w E ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w ∅ $ by wcel_eq_l [dt_eq [l20, l21, l22, l23, l4], wcel_eq_r [dt_eq [l20, l21, l24, l23, l4], l19]]
l26: $ G , q = ∅ ⇒ w ∈ lvals $ by weaken [l3]
l27: $ G , q = ∅ ⇒ ∅ ∈ fseq u $ by weaken [l5]
l28: $ G , q = ∅ ⇒ enc_expr (pset b) ∈ trees ω $ by enc_expr_trees
l29: $ G , q = ∅ ⇒ enc_expr (pi (pset b) (Prop)) ∈ trees ω $ by enc_expr_trees
l30: $ G , q = ∅ ⇒ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w ∅ = (Πₛ xx8 ∈ dt u (mcv hfin) (enc_expr (pset b)) w ∅, dt u (mcv hfin) (enc_expr (pi (pset b) (Prop))) w (xx8 +: ∅)) $ by dt_pi_c [l28, l29, l26, l27]
l31: $ G , q = ∅ ⇒ w ∈ lvals $ by weaken [l3]
l32: $ G , q = ∅ ⇒ ∅ ∈ fseq u $ by weaken [l5]
l33: $ G , q = ∅ ⇒ w ∈ lvals $ by weaken [l3]
l34: $ G , q = ∅ ⇒ ∅ ∈ fseq u $ by weaken [l5]
l35: $ G , q = ∅ ⇒ dt u (mcv hfin) (enc_expr (pset b)) w ∅ = psv u w b $ by closed0_den [fset_kt [], l33, l32, l34]
l36: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ $ by ax
l37: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ uadm u $ by weaken [l1]
l38: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ w ∈ lvals $ by weaken [l3]
l39: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ ∅ ∈ fseq u $ by weaken [l5]
l40: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ xx8 +: ∅ ∈ fseq u $ by dt_scons_fseq [l37, l38, l39, l36]
l41: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ dt u (mcv hfin) (enc_expr (pset b)) w ∅ = psv u w b $ by weaken [l35]
l42: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ xx8 ∊ psv u w b $ by welc_eq [l41, l36]
l43: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ w ∈ lvals $ by weaken [l3]
l44: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ xx8 +: ∅ ∈ fseq u $ by weaken [l40]
l45: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ enc_expr (pset b) ∈ trees ω $ by enc_expr_trees
l46: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ enc_expr (Prop) ∈ trees ω $ by enc_expr_trees
l47: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ dt u (mcv hfin) (enc_expr (pi (pset b) (Prop))) w (xx8 +: ∅) = (Πₛ xx9 ∈ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅), dt u (mcv hfin) (enc_expr (Prop)) w (xx9 +: xx8 +: ∅)) $ by dt_pi_c [l45, l46, l43, l44]
l48: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ w ∈ lvals $ by weaken [l3]
l49: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ xx8 +: ∅ ∈ fseq u $ by weaken [l40]
l50: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ w ∈ lvals $ by weaken [l3]
l51: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ ∅ ∈ fseq u $ by weaken [l5]
l52: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) = psv u w b $ by closed0_den [fset_kt [], l50, l49, l51]
l53: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) $ by ax
l54: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ uadm u $ by weaken [l1]
l55: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ w ∈ lvals $ by weaken [l3]
l56: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ xx8 +: ∅ ∈ fseq u $ by weaken [l40]
l57: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ xx9 +: xx8 +: ∅ ∈ fseq u $ by dt_scons_fseq [l54, l55, l56, l53]
l58: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) = psv u w b $ by weaken [l52]
l59: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ xx9 ∊ psv u w b $ by welc_eq [l58, l53]
l60: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ w ∈ lvals $ by weaken [l3]
l61: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ xx9 +: xx8 +: ∅ ∈ fseq u $ by weaken [l57]
l62: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ enc_lvl lz ∈ trees ω $ by enc_lvl_trees
l63: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ dt u (mcv hfin) (enc_expr (Prop)) w (xx9 +: xx8 +: ∅) = uni' (lv (enc_lvl lz) w) $ by dt_srt_c [l62, l60, l61]
l64: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ lv (enc_lvl lz) w = ∅ $ by lv_lz
l65: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ uni = uni $ by eq_refl
l66: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ uni' (lv (enc_lvl lz) w) = uni' ∅ $ by fv_eq [l65, l64]
l67: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ , xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) ⇒ dt u (mcv hfin) (enc_expr (Prop)) w (xx9 +: xx8 +: ∅) = uni' ∅ $ by eq_trans [l63, l66]
l68: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) → dt u (mcv hfin) (enc_expr (Prop)) w (xx9 +: xx8 +: ∅) = uni' ∅ $ by imp_intro [l67]
l69: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ ∀ xx9 (xx9 ∊ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅) → dt u (mcv hfin) (enc_expr (Prop)) w (xx9 +: xx8 +: ∅) = uni' ∅) $ by all_intro [l68]
l70: $ G , q = ∅ , xx8 ∊ dt u (mcv hfin) (enc_expr (pset b)) w ∅ ⇒ (Πₛ xx9 ∈ dt u (mcv hfin) (enc_expr (pset b)) w (xx8 +: ∅), dt u (mcv hfin) (enc_expr (Prop)) w (xx9 +: xx8 +: ∅)) = (Πₛ xx9 ∈ psv u w b, uni' ∅) $ by cpi_eq_pt [l52, l69]
