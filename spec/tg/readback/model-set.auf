l312: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r , m ∊ j , ∀ n (n ∊ i → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥)) , c = ap g m , v = (pcol u w b)' c , n ∊ i ∧ v = (pcol u w b)' (ap f n) ⇒ (pcol u w b)' (ap g m) = (pcol u w b)' (ap f n) $ by eq_trans [eq_sym [l311], l310]
l313: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r , m ∊ j , ∀ n (n ∊ i → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥)) , c = ap g m , v = (pcol u w b)' c , n ∊ i ∧ v = (pcol u w b)' (ap f n) ⇒ (pcol u w b)' (ap f n) = (pcol u w b)' (ap g m) $ by eq_sym [l312]
