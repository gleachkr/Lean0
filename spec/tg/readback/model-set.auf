l50: $ G , u ⊆ v , z ∊ pcop X u ⇒ z ∊ pcop X v $ by ex_elim [l2, l49]
l51: $ G , u ⊆ v ⇒ pcop X u ⊆ pcop X v $ by subset_intro [l50]
l52: $ G ⇒ mono c (pcop X c) $ by mono_intro [l51]
l53: $ G ⇒ functional uni $ by uni_functional
l54: $ G ⇒ isset ∅ $ by ax_empty
l55: $ G ⇒ isset U₁ $ by fv_set_c [l53, suc_set [l54]]
l56: $ G ⇒ isset (X × U₁) $ by cxp_set [#1, l55]
l57: $ G , d = X × U₁ ⇒ pcop X c ⊆ X × U₁ $ by pc_sub [weaken [#2]]
l58: $ G , d = X × U₁ ⇒ d = X × U₁ $ by ax
l59: $ G , d = X × U₁ ⇒ pcop X c ⊆ d $ by subset_trans [l57, eq_subset [eq_sym [l58]]]
l60: $ G , d = X × U₁ ⇒ isset (pcop X c) $ by subset_set [l59]
l61: $ G ⇒ isset (pcop X c) $ by isset_elim [l56, l60]
l62: $ G ⇒ setop c (pcop X c) $ by setop_intro [l61]
l63: $ G , u ⊆ X × U₁ ⇒ pcop X u ⊆ X × U₁ $ by pc_sub [weaken [#2]]
l64: $ G ⇒ bounded c (pcop X c) (X × U₁) $ by bounded_intro [l63]
l65: $ G ⇒ cap c (pcop X c) (plf X) = plf X $ by lfp_fix [l52, l62, l64, l56]
l66: $ G ⇒ isset (plf X) $ by lfp_set [l64, l62, l56]
l67: $ G ⇒ cap c (pcop X c) (plf X) = plf X ∧ isset (plf X) $ by and_intro [l65, l66]

--| @freshen G i
--| @freshen G f
--| @freshen G a
--| @freshen G n
--| @freshen G y
lemma pc_in {i f a n y: set} (G: hyps) (X: class) (j g t: set): $ G ⇒ isset X $ > $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, X) → ∅ +: i +: f +: ∅ ∈ X) $ > $ G ⇒ j ∊ U₁ $ > $ G ⇒ g ∊ (Πₛ a ∈ j, X) $ > $ G ⇒ t ∊ U₁ $ > $ G ⇒ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X)) $ > $ G ⇒ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X)) $ > $ G ⇒ ⟨ ∅ +: j +: g +: ∅ , t ⟩ ∈ plf X $
----
l1: $ G ⇒ cap c (pcop X c) (plf X) = plf X ∧ isset (plf X) $ by pc_fix [#1, #2]
l2: $ G ⇒ cap c (pcop X c) (plf X) = plf X $ by and_elim_l [l1]
l3: $ G ⇒ isset (plf X) $ by and_elim_r [l1]
l4: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ d = plf X $ by ax
l5: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ $ by ax
l6: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ j ∊ U₁ $ by weaken [#3]
l7: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ g ∊ (Πₛ a ∈ j, X) $ by weaken [#4]
l8: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ t ∊ U₁ $ by weaken [#5]
l9: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X)) $ by weaken [#6]
l10: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X)) $ by weaken [#7]
l11: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j ⇒ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X)) $ by weaken [l9]
l12: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j ⇒ n ∊ j $ by ax
l13: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j ⇒ ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X) $ by imp_elim [all_elim [l11], l12]
l14: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j , y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X $ by ax
l15: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j , y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ y ∊ t $ by and_elim_l [l14]
l16: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j , y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ ⟨ ap g n , y ⟩ ∈ plf X $ by and_elim_r [l14]
l17: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j , y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ d = plf X $ by weaken [l4]
l18: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j , y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ ⟨ ap g n , y ⟩ ∈ d $ by wcel_eq_r [eq_sym [l17], l16]
l19: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j , y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d $ by and_intro [l15, l18]
l20: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j , y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d) $ by ex_intro [l19]
l21: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , n ∊ j ⇒ ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d) $ by ex_elim [l13, l20]
l22: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d) $ by imp_intro [l21]
l23: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d)) $ by all_intro [l22]
l24: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t ⇒ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X)) $ by weaken [l10]
l25: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t ⇒ y ∊ t $ by ax
l26: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t ⇒ ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X) $ by imp_elim [all_elim [l24], l25]
l27: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t , n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X $ by ax
l28: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t , n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ n ∊ j $ by and_elim_l [l27]
l29: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t , n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ ⟨ ap g n , y ⟩ ∈ plf X $ by and_elim_r [l27]
l30: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t , n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ d = plf X $ by weaken [l4]
l31: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t , n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ ⟨ ap g n , y ⟩ ∈ d $ by wcel_eq_r [eq_sym [l30], l29]
l32: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t , n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d $ by and_intro [l28, l31]
l33: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t , n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ plf X ⇒ ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d) $ by ex_intro [l32]
l34: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ , y ∊ t ⇒ ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d) $ by ex_elim [l26, l33]
l35: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d) $ by imp_intro [l34]
l36: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d)) $ by all_intro [l35]
l37: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ $ by and_intro [l36, l5]
l38: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ $ by and_intro [l23, l37]
l39: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ t ∊ U₁ ∧ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ $ by and_intro [l8, l38]
l40: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ g ∊ (Πₛ a ∈ j, X) ∧ t ∊ U₁ ∧ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ $ by and_intro [l7, l39]
l41: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, X) ∧ t ∊ U₁ ∧ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ $ by and_intro [l6, l40]
l42: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∃ m (j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ j → ∃ y (y ∊ m ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ d)) ∧ z = ⟨ ∅ +: j +: g +: ∅ , m ⟩) $ by ex_intro [l41]
l43: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∃ f ∃ m (j ∊ U₁ ∧ f ∊ (Πₛ a ∈ j, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ j → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ d)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ j ∧ ⟨ ap f n , y ⟩ ∈ d)) ∧ z = ⟨ ∅ +: j +: f +: ∅ , m ⟩) $ by ex_intro [l42]
l44: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ d)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ d)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ex_intro [l43]
l45: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ z ∊ pcop X d $ by cab_intro [l44]
l46: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ z ∊ cap c (pcop X c) (plf X) $ by cap_intro [l4, l45]
l47: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ cap c (pcop X c) (plf X) = plf X $ by weaken [l2]
l48: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ z ∊ plf X $ by welc_eq [l47, l46]
l49: $ G , d = plf X , z = ⟨ ∅ +: j +: g +: ∅ , t ⟩ ⇒ ⟨ ∅ +: j +: g +: ∅ , t ⟩ ∈ plf X $ by wcel_eq_l [l5, welc_wcel [l48]]
l50: $ G , d = plf X ⇒ isset ⟨ ∅ +: j +: g +: ∅ , t ⟩ $ by opair_isset
l51: $ G , d = plf X ⇒ ⟨ ∅ +: j +: g +: ∅ , t ⟩ ∈ plf X $ by isset_elim [l50, l49]
l52: $ G ⇒ ⟨ ∅ +: j +: g +: ∅ , t ⟩ ∈ plf X $ by isset_elim [l3, l51]

--| @freshen G i
--| @freshen G f
--| @freshen G a
--| @freshen G m
--| @freshen G n
--| @freshen G y
lemma pc_el {i f a m n y: set} (G: hyps) (X: class) (x t: set): $ G ⇒ isset X $ > $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, X) → ∅ +: i +: f +: ∅ ∈ X) $ > $ G ⇒ ⟨ x , t ⟩ ∈ plf X $ > $ G ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $
----
l1: $ G ⇒ cap c (pcop X c) (plf X) = plf X ∧ isset (plf X) $ by pc_fix [#1, #2]
l2: $ G ⇒ cap c (pcop X c) (plf X) = plf X $ by and_elim_l [l1]
l3: $ G ⇒ isset (plf X) $ by and_elim_r [l1]
l4: $ G , z = ⟨ x , t ⟩ ⇒ z = ⟨ x , t ⟩ $ by ax
l5: $ G , z = ⟨ x , t ⟩ ⇒ ⟨ x , t ⟩ ∈ plf X $ by weaken [#3]
l6: $ G , z = ⟨ x , t ⟩ ⇒ z ∊ plf X $ by wcel_welc [wcel_eq_l [eq_sym [l4], l5]]
l7: $ G , z = ⟨ x , t ⟩ ⇒ cap c (pcop X c) (plf X) = plf X $ by weaken [l2]
l8: $ G , z = ⟨ x , t ⟩ ⇒ z ∊ cap c (pcop X c) (plf X) $ by welc_eq [eq_sym [l7], l6]
l9: $ G , z = ⟨ x , t ⟩ ⇒ ∃ c (c = plf X ∧ z ∊ pcop X c) $ by cab_elim [l8]
l10: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c ⇒ c = plf X ∧ z ∊ pcop X c $ by ax
l11: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c ⇒ c = plf X $ by and_elim_l [l10]
l12: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c ⇒ c = plf X ∧ z ∊ pcop X c $ by ax
l13: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c ⇒ z ∊ pcop X c $ by and_elim_r [l12]
l14: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by cab_elim [l13]
l15: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ $ by ax
l16: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ i ∊ U₁ $ by and_elim_l [l15]
l17: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ f ∊ (Πₛ a ∈ i, X) $ by and_elim_l [and_elim_r [l15]]
l18: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ m ∊ U₁ $ by and_elim_l [and_elim_r [and_elim_r [l15]]]
l19: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l15]]]]
l20: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l15]]]]]
l21: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l15]]]]]
l22: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ , n ∊ i ⇒ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) $ by weaken [l19]
l23: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ , n ∊ i ⇒ n ∊ i $ by ax
