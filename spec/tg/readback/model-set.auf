l119: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , y ∊ m , x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z ⇒ ⟨ ap f x , z ⟩ ∈ pcol u w b $ by cab_elim [l117]
l120: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , y ∊ m , x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z ⇒ ap f x = ap f x $ by eq_refl
l121: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , y ∊ m , x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z ⇒ ⟨ ap f x , y ⟩ ∈ pcol u w b $ by wcel_eq_l [opair_eq [l120, eq_sym [l118]], l119]
l122: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , y ∊ m , x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z ⇒ x ∊ i ∧ ⟨ ap f x , y ⟩ ∈ pcol u w b $ by and_intro [l116, l121]
l123: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , y ∊ m , x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z ⇒ ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ pcol u w b) $ by ex_intro [l122]
l124: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , y ∊ m , ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z) ⇒ ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z) $ by ax
l125: $ … ⇒ ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ pcol u w b) $ by ex_elim [l124, l123]
l126: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , y ∊ m ⇒ ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ pcol u w b) $ by ex_elim [l114, l125]
l127: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} ⇒ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ pcol u w b)) $ by all_intro [imp_intro [l126]]
l128: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} ⇒ uadm u $ by weaken [#1]
l129: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} ⇒ w ∊ lvals $ by weaken [#2]
l130: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} ⇒ i ∊ U₁ $ by weaken [l1]
l131: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} ⇒ f ∊ (Πₛ a ∈ i, psv u w b) $ by weaken [l2]
l132: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} ⇒ ⟨ ∅ +: i +: f +: ∅ , m ⟩ ∈ pcol u w b $ by pp_in [l128, l129, l130, l131, l77, l110, l127]
l133: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , z = ∅ +: i +: f +: ∅ ⇒ z = ∅ +: i +: f +: ∅ $ by ax
l134: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , z = ∅ +: i +: f +: ∅ ⇒ m = m $ by eq_refl
l135: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , z = ∅ +: i +: f +: ∅ ⇒ ⟨ ∅ +: i +: f +: ∅ , m ⟩ ∈ pcol u w b $ by weaken [l132]
l136: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , z = ∅ +: i +: f +: ∅ ⇒ ⟨ z , m ⟩ ∈ pcol u w b $ by wcel_eq_l [opair_eq [eq_sym [l133], l134], l135]
l137: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , z = ∅ +: i +: f +: ∅ ⇒ m ∊ U₁ $ by weaken [l77]
l138: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , z = ∅ +: i +: f +: ∅ ⇒ m ∊ U₁ ∧ ⟨ z , m ⟩ ∈ pcol u w b $ by and_intro [l137, l136]
l139: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} , z = ∅ +: i +: f +: ∅ ⇒ ∃ t (t ∊ U₁ ∧ ⟨ z , t ⟩ ∈ pcol u w b) $ by ex_intro [l138]
l140: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} ⇒ isset (∅ +: i +: f +: ∅) $ by scons_set [scons_set [scons_set [ax_empty []]]]
l141: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) , m = {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} ⇒ ∅ +: i +: f +: ∅ ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)} $ by wcel_cab_intro [l140, l139]
l142: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) ⇒ isset {y | ∃ x ∃ z (x ∊ i ∧ z ∊ {t | ⟨ ap f x , t ⟩ ∈ pcol u w b} ∧ y = z)} $ by wcel_isset [l74]
l143: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) ⇒ ∅ +: i +: f +: ∅ ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)} $ by isset_elim [l142, l141]
l144: $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∀ n (n ∊ i → ap f n ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) → ∅ +: i +: f +: ∅ ∈ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)}) $ by all_intro [all_intro [imp_intro [imp_intro [imp_intro [l143]]]]]
l145: $ G ⇒ psv u w b ⊆ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)} $ by ps_ind [#1, #2, l144]
l146: $ G ⇒ v ∊ {yy0 | ∃ t (t ∊ U₁ ∧ ⟨ yy0 , t ⟩ ∈ pcol u w b)} $ by subset_elim [l145, #3]
l147: $ G ⇒ ∃ t (t ∊ U₁ ∧ ⟨ v , t ⟩ ∈ pcol u w b) $ by cab_elim [l146]

lemma pp_fv (G: hyps) (b: blk) (u w v t: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ v ∊ psv u w b $ > $ G ⇒ ⟨ v , t ⟩ ∈ pcol u w b $ > $ G ⇒ (pcol u w b)' v = t $
----
l1: $ G , ⟨ v , o ⟩ ∈ pcol u w b ⇒ uadm u $ by weaken [#1]
l2: $ G , ⟨ v , o ⟩ ∈ pcol u w b ⇒ w ∊ lvals $ by weaken [#2]
l3: $ G , ⟨ v , o ⟩ ∈ pcol u w b ⇒ v ∊ psv u w b $ by weaken [#3]
l4: $ G , ⟨ v , o ⟩ ∈ pcol u w b ⇒ ⟨ v , o ⟩ ∈ pcol u w b $ by ax
l5: $ G , ⟨ v , o ⟩ ∈ pcol u w b ⇒ ⟨ v , t ⟩ ∈ pcol u w b $ by weaken [#4]
l6: $ G , ⟨ v , o ⟩ ∈ pcol u w b ⇒ o = t $ by pp_fn [l1, l2, l3, l4, l5]
l7: $ G , o = t ⇒ v = v $ by eq_refl
l8: $ G , o = t ⇒ o = t $ by ax
l9: $ G , o = t ⇒ ⟨ v , t ⟩ ∈ pcol u w b $ by weaken [#4]
l10: $ G , o = t ⇒ ⟨ v , o ⟩ ∈ pcol u w b $ by wcel_eq_l [opair_eq [l7, eq_sym [l8]], l9]
l11: $ G ⇒ ∀ o (⟨ v , o ⟩ ∈ pcol u w b ↔ o = t) $ by all_intro [bi_intro [l6, l10]]
l12: $ G ⇒ isset t $ by isset_var
l13: $ G ⇒ (pcol u w b)' v = t $ by fv_iff [l11, l12]

lemma pp_on {x v: set} (G: hyps) (b: blk) (u w: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ x (x ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , x ⟩ ∈ pcol u w b)) $
----
l1: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ ⇒ uadm u $ by weaken [#1]
l2: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ ⇒ w ∊ lvals $ by weaken [#2]
l3: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ ⇒ x ∊ U₁ $ by ax
l4: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ ⇒ universe U₁ $ by fset_u1
l5: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ ⇒ ∅ ∈ fseq u $ by fseq_empty
l6: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ ⇒ psv u w b ∈ u $ by den_in_u_c [l1, welc_wcel [l2], l5]
l7: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ ⇒ isset (psv u w b) $ by wcel_isset [l6]
l8: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ universe U₁ $ by weaken [l4]
l9: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ x ∊ U₁ $ by weaken [l3]
l10: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ a ∊ x $ by ax
l11: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ a ∊ U₁ $ by universe_elem_elem [l8, l9, l10]
l12: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) $ by ax
l13: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ a ∊ x → (a ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b)) $ by all_elim [l12]
l14: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ a ∊ x $ by ax
l15: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ ∃ v (v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b) $ by imp_elim [imp_elim [l13, l14], l11]
l16: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x , h ∊ {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} ⇒ h ∊ {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} $ by ax
l17: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x , h ∊ {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} ⇒ h ∊ psv u w b ∧ ⟨ h , a ⟩ ∈ pcol u w b $ by cab_elim [l16]
l18: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x , h ∊ {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} ⇒ h ∊ psv u w b $ by and_elim_l [l17]
l19: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} ⊆ psv u w b $ by subset_intro [l18]
l20: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ isset (psv u w b) $ by weaken [l7]
l21: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x ⇒ isset {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} $ by subset_isset [l20, l19]
l22: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x , o = {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} ⇒ o = {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} $ by ax
l23: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x , o = {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} ⇒ ∃ v (v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b) $ by weaken [l15]
l24: $ G , ∀ e (e ∊ x → (e ∊ U₁ → ∃ v (v ∊ psv u w b ∧ ⟨ v , e ⟩ ∈ pcol u w b))) , x ∊ U₁ , a ∊ x , o = {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} , v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b ⇒ o = {v | v ∊ psv u w b ∧ ⟨ v , a ⟩ ∈ pcol u w b} $ by weaken [l22]
