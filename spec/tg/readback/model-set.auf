l55: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ex_intro [l54]
l56: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ex_intro [l55]
l57: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ex_intro [l56]
l58: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) ⇒ ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ax
l59: $ … ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ex_elim [l58, l57]
l60: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c , ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) ⇒ ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ c)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ax
l61: $ … ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ex_elim [l60, l59]
l62: $ G , z = ⟨ x , t ⟩ , c = plf X ∧ z ∊ pcop X c ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ex_elim [l14, l61]
l63: $ G , z = ⟨ x , t ⟩ ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ex_elim [l9, l62]
l64: $ G ⇒ isset ⟨ x , t ⟩ $ by opair_isset
l65: $ G ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ plf X)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by isset_elim [l64, l63]

lemma pt_inj (G: hyps) (i f j g: set): $ G ⇒ ∅ +: i +: f +: ∅ = ∅ +: j +: g +: ∅ $ > $ G ⇒ i = j ∧ f = g $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ isset (suc ∅) $ by suc_set [l1]
l3: $ G ⇒ isset (f +: ∅) $ by scons_set [l1]
l4: $ G ⇒ isset (i +: f +: ∅) $ by scons_set [l3]
l5: $ G ⇒ isset i $ by isset_var
l6: $ G ⇒ isset f $ by isset_var
l7: $ G ⇒ (∅ +: i +: f +: ∅)' (suc ∅) = (i +: f +: ∅)' ∅ $ by scons_fv_suc_c [l1, l4, l1]
l8: $ G ⇒ (i +: f +: ∅)' ∅ = i $ by scons_fv_zero_c [l5, l3]
l9: $ G ⇒ (∅ +: i +: f +: ∅)' (suc (suc ∅)) = (i +: f +: ∅)' (suc ∅) $ by scons_fv_suc_c [l1, l4, l2]
l10: $ G ⇒ (i +: f +: ∅)' (suc ∅) = (f +: ∅)' ∅ $ by scons_fv_suc_c [l5, l3, l1]
l11: $ G ⇒ (f +: ∅)' ∅ = f $ by scons_fv_zero_c [l6, l1]
l12: $ G ⇒ (∅ +: i +: f +: ∅)' (suc ∅) = i $ by eq_trans [l7, l8]
l13: $ G ⇒ (∅ +: i +: f +: ∅)' (suc (suc ∅)) = f $ by eq_trans [l9, eq_trans [l10, l11]]
l14: $ G ⇒ isset (g +: ∅) $ by scons_set [l1]
l15: $ G ⇒ isset (j +: g +: ∅) $ by scons_set [l14]
l16: $ G ⇒ isset j $ by isset_var
l17: $ G ⇒ isset g $ by isset_var
l18: $ G ⇒ (∅ +: j +: g +: ∅)' (suc ∅) = (j +: g +: ∅)' ∅ $ by scons_fv_suc_c [l1, l15, l1]
l19: $ G ⇒ (j +: g +: ∅)' ∅ = j $ by scons_fv_zero_c [l16, l14]
l20: $ G ⇒ (∅ +: j +: g +: ∅)' (suc (suc ∅)) = (j +: g +: ∅)' (suc ∅) $ by scons_fv_suc_c [l1, l15, l2]
l21: $ G ⇒ (j +: g +: ∅)' (suc ∅) = (g +: ∅)' ∅ $ by scons_fv_suc_c [l16, l14, l1]
l22: $ G ⇒ (g +: ∅)' ∅ = g $ by scons_fv_zero_c [l17, l1]
l23: $ G ⇒ (∅ +: j +: g +: ∅)' (suc ∅) = j $ by eq_trans [l18, l19]
l24: $ G ⇒ (∅ +: j +: g +: ∅)' (suc (suc ∅)) = g $ by eq_trans [l20, eq_trans [l21, l22]]
l25: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l26: $ G ⇒ i = j $ by eq_trans [eq_sym [l12], eq_trans [fv_eq [#1, l25], l23]]
l27: $ G ⇒ suc (suc ∅) = suc (suc ∅) $ by eq_refl
l28: $ G ⇒ f = g $ by eq_trans [eq_sym [l13], eq_trans [fv_eq [#1, l27], l24]]
l29: $ G ⇒ i = j ∧ f = g $ by and_intro [l26, l28]

--| @freshen G a
--| @freshen G n
--| @freshen G y
lemma pp_in {a n y: set} (G: hyps) (b: blk) (u w j g t: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ j ∊ U₁ $ > $ G ⇒ g ∊ (Πₛ a ∈ j, psv u w b) $ > $ G ⇒ t ∊ U₁ $ > $ G ⇒ ∀ n (n ∊ j → ∃ y (y ∊ t ∧ ⟨ ap g n , y ⟩ ∈ pcol u w b)) $ > $ G ⇒ ∀ y (y ∊ t → ∃ n (n ∊ j ∧ ⟨ ap g n , y ⟩ ∈ pcol u w b)) $ > $ G ⇒ ⟨ ∅ +: j +: g +: ∅ , t ⟩ ∈ pcol u w b $
----
l1: $ G ⇒ uadm u $ by weaken [#1]
l2: $ G ⇒ w ∊ lvals $ by weaken [#2]
l3: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l4: $ G ⇒ psv u w b ∈ u $ by den_in_u_c [l1, welc_wcel [l2], l3]
l5: $ G ⇒ isset (psv u w b) $ by wcel_isset [l4]
l6: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ uadm u $ by weaken [#1]
l7: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ w ∊ lvals $ by weaken [#2]
l8: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ i ∊ U₁ $ by ax
l9: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ f ∊ (Πₛ a ∈ i, psv u w b) $ by ax
l10: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ ∅ +: i +: f +: ∅ ∈ psv u w b $ by ps_in [l6, l7, l8, l9]
l11: $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: f +: ∅ ∈ psv u w b) $ by all_intro [all_intro [imp_intro [imp_intro [l10]]]]
l12: $ G ⇒ ⟨ ∅ +: j +: g +: ∅ , t ⟩ ∈ pcol u w b $ by pc_in [l5, l11, #3, #4, #5, #6, #7]

--| @freshen G i
--| @freshen G f
--| @freshen G a
--| @freshen G m
--| @freshen G n
--| @freshen G y
lemma pp_el {i f a m n y: set} (G: hyps) (b: blk) (u w x t: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ⟨ x , t ⟩ ∈ pcol u w b $ > $ G ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ pcol u w b)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $
----
l1: $ G ⇒ uadm u $ by weaken [#1]
l2: $ G ⇒ w ∊ lvals $ by weaken [#2]
l3: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l4: $ G ⇒ psv u w b ∈ u $ by den_in_u_c [l1, welc_wcel [l2], l3]
l5: $ G ⇒ isset (psv u w b) $ by wcel_isset [l4]
l6: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ uadm u $ by weaken [#1]
l7: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ w ∊ lvals $ by weaken [#2]
l8: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ i ∊ U₁ $ by ax
l9: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ f ∊ (Πₛ a ∈ i, psv u w b) $ by ax
l10: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) ⇒ ∅ +: i +: f +: ∅ ∈ psv u w b $ by ps_in [l6, l7, l8, l9]
l11: $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: f +: ∅ ∈ psv u w b) $ by all_intro [all_intro [imp_intro [imp_intro [l10]]]]
l12: $ G ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ pcol u w b)) ∧ ⟨ x , t ⟩ = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by pc_el [l5, l11, #3]

lemma pp_fn (G: hyps) (b: blk) (u w v t r: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ v ∊ psv u w b $ > $ G ⇒ ⟨ v , t ⟩ ∈ pcol u w b $ > $ G ⇒ ⟨ v , r ⟩ ∈ pcol u w b $ > $ G ⇒ t = r $
----
l1: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b ⇒ uadm u $ by weaken [#1]
l2: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b ⇒ w ∊ lvals $ by weaken [#2]
l3: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b ⇒ ⟨ z , p ⟩ ∈ pcol u w b $ by ax
l4: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b ⇒ ∃ c ∃ d ∃ m (c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩) $ by pp_el [l1, l2, l3]
l5: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ $ by ax
l6: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ c ∊ U₁ $ by and_elim_l [l5]
l7: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ d ∊ (Πₛ a ∈ c, psv u w b) $ by and_elim_l [and_elim_r [l5]]
l8: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {x | ∀ p ∀ q (⟨ x , p ⟩ ∈ pcol u w b → ⟨ x , q ⟩ ∈ pcol u w b → p = q)}) , z = ∅ +: i +: f +: ∅ , ⟨ z , p ⟩ ∈ pcol u w b , ⟨ z , q ⟩ ∈ pcol u w b , c ∊ U₁ ∧ d ∊ (Πₛ a ∈ c, psv u w b) ∧ m ∊ U₁ ∧ ∀ n (n ∊ c → ∃ y (y ∊ m ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ c ∧ ⟨ ap d n , y ⟩ ∈ pcol u w b)) ∧ ⟨ z , p ⟩ = ⟨ ∅ +: c +: d +: ∅ , m ⟩ ⇒ m ∊ U₁ $ by and_elim_l [and_elim_r [and_elim_r [l5]]]
