l365: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r , m ∊ j ⇒ (∀ n (n ∊ i → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥ $ by imp_intro [l364]
l366: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r ⇒ m ∊ j → ((∀ n (n ∊ i → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥) $ by imp_intro [l365]
