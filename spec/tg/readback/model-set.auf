l12: $ G ⇒ ∃ x (x ∊ psv u w b ∧ (pcol u w b)' x = y) $ by ex_elim [l3, l11]

pcol_mk
-------
l1: $ G ⇒ ap (ap (pmk u w b) i) f = ∅ +: i +: f +: ∅ $ by ps_mk [#1, #2, #3, #4]
