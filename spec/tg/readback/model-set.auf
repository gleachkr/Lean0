l237: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r , n ∊ i , ∀ m (m ∊ j → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥)) , c = ap f n , v = (pcol u w b)' c , m ∊ j ∧ v = (pcol u w b)' (ap g m) ⇒ ap g m ∈ psv u w b $ by cpi_elim_ap [l236, l229]
l238: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ , (pcol u w b)' z = (pcol u w b)' r , n ∊ i , ∀ m (m ∊ j → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥)) , c = ap f n , v = (pcol u w b)' c , m ∊ j ∧ v = (pcol u w b)' (ap g m) , k = ap f n , e = ap g m ⇒ k = ap f n $ by ax
