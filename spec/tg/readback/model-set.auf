l122: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ ap m f ∈ dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅ $ by cpi_elim_ap [l120, l121]
l123: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ $ by weaken [l113]
l124: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ i = i $ by eq_refl
l125: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ f = f $ by eq_refl
l126: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ ap m f = ap (ap (dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅) i) f $ by ap_eq [eq_trans [l118, ap_eq [l123, l124]], l125]
l127: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ uadm u $ by weaken [l1]
l128: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ w ∊ lvals $ by weaken [l2]
l129: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ i ∊ U₁ $ by weaken [l4]
l130: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ f ∊ (Πₛ a ∈ i, dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅) $ by weaken [l5]
l131: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ ap (ap (dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅) i) f = ∅ +: i +: f +: ∅ $ by fset_mk [#1, l127, l128, l129, l130]
l132: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ ∅ +: i +: f +: ∅ ∈ dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅ $ by wcel_eq_l [eq_trans [l126, l131], l122]
l133: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ⇒ isset (ap y i) $ by wcel_isset [l117]
l134: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ⇒ ∅ +: i +: f +: ∅ ∈ dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅ $ by isset_elim [l133, l132]
