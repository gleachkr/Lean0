h10: $ mdeq (mcv H) nil (srt (ls (ls lz))) (srt (ls (ls lz))) (srt (ls (ls (ls lz)))) $ by msort [h9]
h11: $ deq_j (jmod (mcv H)) nil (srt (ls (ls lz))) (srt (ls (ls lz))) (srt (ls (ls (ls lz)))) $ by jmod_i [h10]
h12: $ tys_ty_j (jmod (mcv H)) nil tnil $ by tys_ty_nil_j
h13: $ tys_ty_j (jmod (mcv H)) nil (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar (s (s nz)))) (bvar (s (s nz))))) cnil) tnil) $ by tys_ty_cons_j [h8, h11, h12]
h14: $ tys_ok_j (jmod (mcv H)) nil (ind_mk b nil (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar (s (s nz)))) (bvar (s (s nz))))) cnil) tnil) nil) $ by tys_ok_i_j [h1, h5, h6, h7, h13]

