-- Proofs for model-set.mm0.

pcop_congr
----------
g1: $ (i ∊ U₁) ⟺ (i ∊ U₁) $ by iff_refl
g2: $ seqt f f $ by seqt_refl
g3: $ i ≐ i $ by ceqt_refl
g4: $ (Πₛ a ∈ i, A) ≐ (Πₛ a ∈ i, B) $ by cpi_congr [g3, #1]
g5: $ (f ∊ (Πₛ a ∈ i, A)) ⟺ (f ∊ (Πₛ a ∈ i, B)) $ by welc_congr [g2, g4]
g6: $ (m ∊ U₁) ⟺ (m ∊ U₁) $ by iff_refl
g7: $ (n ∊ i) ⟺ (n ∊ i) $ by iff_refl
g8: $ (y ∊ m) ⟺ (y ∊ m) $ by iff_refl
g9: $ (opair (ap f n) y) ≐ (opair (ap f n) y) $ by ceqt_refl
g10: $ ((opair (ap f n) y) ∈ C) ⟺ ((opair (ap f n) y) ∈ D) $ by wcel_congr [g9, #2]
g11: $ ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C)) ⟺ ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D)) $ by and_congr [g8, g10]
g12: $ (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))) ⟺ (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))) $ by ex_congr [g11]
g13: $ ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C)))) ⟺ ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D)))) $ by im_congr [g7, g12]
g14: $ (∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))))) ⟺ (∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))))) $ by all_congr [g13]
g15: $ (y ∊ m) ⟺ (y ∊ m) $ by iff_refl
g16: $ (n ∊ i) ⟺ (n ∊ i) $ by iff_refl
g17: $ (opair (ap f n) y) ≐ (opair (ap f n) y) $ by ceqt_refl
g18: $ ((opair (ap f n) y) ∈ C) ⟺ ((opair (ap f n) y) ∈ D) $ by wcel_congr [g17, #2]
g19: $ ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C)) ⟺ ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D)) $ by and_congr [g16, g18]
g20: $ (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))) ⟺ (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))) $ by ex_congr [g19]
g21: $ ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C)))) ⟺ ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D)))) $ by im_congr [g15, g20]
g22: $ (∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ⟺ (∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) $ by all_congr [g21]
g23: $ (z = (opair (∅ +: i +: f +: ∅) m)) ⟺ (z = (opair (∅ +: i +: f +: ∅) m)) $ by iff_refl
g24: $ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m))) ⟺ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m))) $ by and_congr [g22, g23]
g25: $ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))) ⟺ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))) $ by and_congr [g14, g24]
g26: $ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m))))) ⟺ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m))))) $ by and_congr [g6, g25]
g27: $ ((f ∊ (Πₛ a ∈ i, A)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))))) ⟺ ((f ∊ (Πₛ a ∈ i, B)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))))) $ by and_congr [g5, g26]
g28: $ ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, A)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m))))))) ⟺ ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, B)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m))))))) $ by and_congr [g1, g27]
g29: $ (∃ m ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, A)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))))))) ⟺ (∃ m ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, B)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))))))) $ by ex_congr [g28]
g30: $ (∃ f (∃ m ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, A)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m))))))))) ⟺ (∃ f (∃ m ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, B)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m))))))))) $ by ex_congr [g29]
g31: $ (∃ i (∃ f (∃ m ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, A)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ C))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ C))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))))))))) ⟺ (∃ i (∃ f (∃ m ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, B)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ D))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ D))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))))))))) $ by ex_congr [g30]
g32: $ pcop A C ≐ pcop B D $ by cab_congr [g31]

sb_c_pcop
---------
l1: $ ([[ x / t ]] {z | ∃ i (∃ f (∃ m ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, A)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ B))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ B))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))))))))}) ≐ {z | ∃ i (∃ f (∃ m ((i ∊ U₁) ∧ ((f ∊ (Πₛ a ∈ i, [[ x / t ]] A)) ∧ ((m ∊ U₁) ∧ ((∀ n ((n ∊ i) → (∃ y ((y ∊ m) ∧ ((opair (ap f n) y) ∈ ([[ x / t ]] B)))))) ∧ ((∀ y ((y ∊ m) → (∃ n ((n ∊ i) ∧ ((opair (ap f n) y) ∈ ([[ x / t ]] B)))))) ∧ (z = (opair (∅ +: i +: f +: ∅) m)))))))))} $ by ceqt_refl

plf_congr
---------
l1: $ c ≐ c $ by ceqt_refl
l2: $ pcop A c ≐ pcop B c $ by pcop_congr [#1, l1]
l3: $ plf A ≐ plf B $ by lfp_congr [l2]

sb_c_plf
--------
l1: $ ([[ x / t ]] (lfp c (pcop A c))) ≐ lfp c (pcop ([[ x / t ]] A) c) $ by ceqt_refl

