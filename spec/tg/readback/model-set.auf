l137: $ G ⇒ isset ∅ $ by ax_empty
l138: $ G ⇒ ∅ +: i +: f +: ∅ ∈ dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅ $ by isset_elim [l137, l136]

--| @freshen G i
--| @freshen G f
--| @freshen G a
lemma ps_el {i f a: set} (G: hyps) (b: blk) (u w x: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ x ∊ psv u w b $ > $ G ⇒ ∃ i ∃ f (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, psv u w b) ∧ x = ∅ +: i +: f +: ∅) $
----
l1: $ G ⇒ ∃ i ∃ f (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, psv u w b) ∧ x = ∅ +: i +: f +: ∅) $ by fset_el [hfin_hind [], #1, #2, #3]

--| @freshen G a
lemma ps_in {a: set} (G: hyps) (b: blk) (u w i f: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ i ∊ U₁ $ > $ G ⇒ f ∊ (Πₛ a ∈ i, psv u w b) $ > $ G ⇒ ∅ +: i +: f +: ∅ ∈ psv u w b $
----
l1: $ G ⇒ ∅ +: i +: f +: ∅ ∈ psv u w b $ by fset_in [hfin_hind [], #1, #2, #3, #4]

--| @freshen G a
lemma ps_mk {a: set} (G: hyps) (b: blk) (u w i f: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ i ∊ U₁ $ > $ G ⇒ f ∊ (Πₛ a ∈ i, psv u w b) $ > $ G ⇒ ap (ap (pmk u w b) i) f = ∅ +: i +: f +: ∅ $
----
l1: $ G ⇒ ap (ap (pmk u w b) i) f = ∅ +: i +: f +: ∅ $ by fset_mk [hfin_hind [], #1, #2, #3, #4]

lemma fset_sc (G: hyps) (A S: class) (j y: set): $ G ⇒ ⟨ j , y ⟩ ∈ S $ > $ G ⇒ ⟨ suc j , y ⟩ ∈ A +: S $
----
l1: $ G , z = ⟨ suc j , y ⟩ ⇒ z = ⟨ suc j , y ⟩ $ by ax
l2: $ G , z = ⟨ suc j , y ⟩ ⇒ ⟨ j , y ⟩ ∈ S $ by weaken [#1]
l3: $ G , z = ⟨ suc j , y ⟩ ⇒ z = ⟨ suc j , y ⟩ ∧ ⟨ j , y ⟩ ∈ S $ by and_intro [l1, l2]
l4: $ G , z = ⟨ suc j , y ⟩ ⇒ ∃ xx2 (z = ⟨ suc j , xx2 ⟩ ∧ ⟨ j , xx2 ⟩ ∈ S) $ by ex_intro [l3]
l5: $ G , z = ⟨ suc j , y ⟩ ⇒ ∃ xx1 ∃ xx2 (z = ⟨ suc xx1 , xx2 ⟩ ∧ ⟨ xx1 , xx2 ⟩ ∈ S) $ by ex_intro [l4]
l6: $ G , z = ⟨ suc j , y ⟩ ⇒ z ∊ {xx0 | ∃ xx1 ∃ xx2 (xx0 = ⟨ suc xx1 , xx2 ⟩ ∧ ⟨ xx1 , xx2 ⟩ ∈ S)} $ by cab_intro [l5]
l7: $ G , z = ⟨ suc j , y ⟩ ⇒ ⟨ suc j , y ⟩ ∈ {xx0 | ∃ xx1 ∃ xx2 (xx0 = ⟨ suc xx1 , xx2 ⟩ ∧ ⟨ xx1 , xx2 ⟩ ∈ S)} $ by wcel_eq_l [l1, welc_wcel [l6]]
l8: $ G , z = ⟨ suc j , y ⟩ ⇒ ⟨ suc j , y ⟩ ∈ A +: S $ by cun_intro_r_c [l7]
l9: $ G ⇒ isset ⟨ suc j , y ⟩ $ by opair_isset
l10: $ G ⇒ ⟨ suc j , y ⟩ ∈ A +: S $ by isset_elim [l9, l8]

lemma fset_d (G: hyps) (h a i f: set): $ G ⇒ ap h a = ∅ +: i +: f +: ∅ $ > $ G ⇒ f ∊ tcl h $
----
l1: $ G , z = ∅ , o = suc ∅ ⇒ z = ∅ $ by ax
l2: $ G , z = ∅ , o = suc ∅ ⇒ o = suc ∅ $ by ax
l3: $ G , z = ∅ , o = suc ∅ ⇒ isset ⟨ ∅ , f ⟩ $ by opair_isset
l4: $ G , z = ∅ , o = suc ∅ ⇒ ⟨ ∅ , f ⟩ ∈ f +: ∅ $ by cun_intro_l_c [csn_intro_var_c [l3]]
l5: $ G , z = ∅ , o = suc ∅ ⇒ f = f $ by eq_refl
l6: $ G , z = ∅ , o = suc ∅ ⇒ ⟨ z , f ⟩ ∈ f +: ∅ $ by wcel_eq_l [opair_eq [eq_sym [l1], l5], l4]
l7: $ G , z = ∅ , o = suc ∅ ⇒ ⟨ suc z , f ⟩ ∈ i +: f +: ∅ $ by fset_sc [l6]
l8: $ G , z = ∅ , o = suc ∅ ⇒ ⟨ o , f ⟩ ∈ i +: f +: ∅ $ by wcel_eq_l [opair_eq [eq_sym [eq_trans [l2, suc_eq [eq_sym [l1]]]], l5], l7]
l9: $ G , z = ∅ , o = suc ∅ ⇒ ⟨ suc o , f ⟩ ∈ ∅ +: i +: f +: ∅ $ by fset_sc [l8]
l10: $ G , z = ∅ , o = suc ∅ ⇒ suc o = suc (suc ∅) $ by suc_eq [l2]
l11: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ p = ⟨ suc (suc ∅) , f ⟩ $ by ax
l12: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ suc o = suc (suc ∅) $ by weaken [l10]
l13: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ f = f $ by eq_refl
l14: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ ⟨ suc o , f ⟩ ∈ ∅ +: i +: f +: ∅ $ by weaken [l9]
l15: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ p ∊ ∅ +: i +: f +: ∅ $ by wcel_welc [wcel_eq_l [eq_trans [opair_eq [l12, l13], eq_sym [l11]], l14]]
l16: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ ap h a = ∅ +: i +: f +: ∅ $ by weaken [#1]
l17: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ p ∊ ap h a $ by welc_eq [eq_sym [l16], l15]
l18: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ ⟨ a , p ⟩ ∈ h $ by ap_elim [l17]
l19: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ e = ⟨ a , p ⟩ $ by ax
l20: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ c = cpr a p $ by ax
l21: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ d = cpr (suc (suc ∅)) f $ by ax
l22: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ ⟨ a , p ⟩ ∈ h $ by weaken [l18]
l23: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ e ∊ tcl h $ by tcl_sub [wcel_welc [wcel_eq_l [eq_sym [l19], l22]]]
l24: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ isset (cpr a p) $ by cpr_isset
l25: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ cpr a p ∈ ⟨ a , p ⟩ $ by cpr_intro_r_c [l24]
l26: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ c ∊ e $ by wcel_welc [wcel_eq_l [eq_sym [l20], wcel_eq_r [eq_sym [l19], l25]]]
l27: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ c ∊ tcl h $ by tcl_tr [l23, l26]
l28: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ p ∊ cpr a p $ by cpr_intro_r
l29: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ p ∊ c $ by welc_eq [eq_sym [l20], l28]
l30: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ p ∊ tcl h $ by tcl_tr [l27, l29]
l31: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ p = ⟨ suc (suc ∅) , f ⟩ $ by weaken [l11]
l32: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ isset (cpr (suc (suc ∅)) f) $ by cpr_isset
l33: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ cpr (suc (suc ∅)) f ∈ ⟨ suc (suc ∅) , f ⟩ $ by cpr_intro_r_c [l32]
l34: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ d ∊ p $ by wcel_welc [wcel_eq_l [eq_sym [l21], wcel_eq_r [eq_sym [l31], l33]]]
l35: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ d ∊ tcl h $ by tcl_tr [l30, l34]
l36: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ isset f $ by isset_var
l37: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ f ∈ cpr (suc (suc ∅)) f $ by cpr_intro_r_c [l36]
l38: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ f ∊ d $ by wcel_welc [wcel_eq_r [eq_sym [l21], l37]]
l39: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p , d = cpr (suc (suc ∅)) f ⇒ f ∊ tcl h $ by tcl_tr [l35, l38]
l40: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p ⇒ isset (cpr (suc (suc ∅)) f) $ by cpr_isset
l41: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ , c = cpr a p ⇒ f ∊ tcl h $ by isset_elim [l40, l39]
l42: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ ⇒ isset (cpr a p) $ by cpr_isset
l43: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ , e = ⟨ a , p ⟩ ⇒ f ∊ tcl h $ by isset_elim [l42, l41]
l44: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ isset ⟨ a , p ⟩ $ by opair_isset
l45: $ G , z = ∅ , o = suc ∅ , p = ⟨ suc (suc ∅) , f ⟩ ⇒ f ∊ tcl h $ by isset_elim [l44, l43]
l46: $ G , z = ∅ , o = suc ∅ ⇒ isset ⟨ suc (suc ∅) , f ⟩ $ by opair_isset
l47: $ G , z = ∅ , o = suc ∅ ⇒ f ∊ tcl h $ by isset_elim [l46, l45]
l48: $ G , z = ∅ ⇒ isset ∅ $ by ax_empty
l49: $ G , z = ∅ ⇒ isset (suc ∅) $ by suc_set [l48]
l50: $ G , z = ∅ ⇒ f ∊ tcl h $ by isset_elim [l49, l47]
l51: $ G ⇒ isset ∅ $ by ax_empty
l52: $ G ⇒ f ∊ tcl h $ by isset_elim [l51, l50]

--| @freshen G i
--| @freshen G f
--| @freshen G a
--| @freshen G n
lemma ps_ind {i f a n: set} (G: hyps) (b: blk) (Q: class) (u w: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∀ n (n ∊ i → ap f n ∈ Q) → ∅ +: i +: f +: ∅ ∈ Q) $ > $ G ⇒ psv u w b ⊆ Q $
----
l1: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) ⇒ i ∊ U₁ $ by ax
l2: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) ⇒ h ∊ (Πₛ a ∈ i, psv u w b) $ by ax
l3: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i ⇒ h ∊ (Πₛ a ∈ i, psv u w b) $ by weaken [l2]
l4: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i ⇒ n ∊ i $ by ax
l5: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i ⇒ ap h n ∈ psv u w b $ by cpi_elim_ap [l3, l4]
l6: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n ⇒ y = ap h n $ by ax
l7: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n ⇒ ap h n ∈ psv u w b $ by weaken [l5]
l8: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n ⇒ y ∊ psv u w b $ by wcel_welc [wcel_eq_l [eq_sym [l6], l7]]
l9: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n ⇒ uadm u $ by weaken [#1]
l10: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n ⇒ w ∊ lvals $ by weaken [#2]
l11: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n ⇒ ∃ c ∃ f (c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅) $ by ps_el [l9, l10, l8]
l12: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ $ by ax
l13: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ c ∊ U₁ $ by and_elim_l [l12]
l14: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ f ∊ (Πₛ a ∈ c, psv u w b) $ by and_elim_l [and_elim_r [l12]]
l15: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ y = ∅ +: c +: f +: ∅ $ by and_elim_r [and_elim_r [l12]]
l16: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ y = ap h n $ by weaken [l6]
l17: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ ap h n = ∅ +: c +: f +: ∅ $ by eq_trans [eq_sym [l16], l15]
l18: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ f ∊ tcl h $ by fset_d [l17]
l19: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) $ by ax
l20: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ f ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)} $ by imp_elim [all_elim [l19], l18]
l21: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ ∀ i (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: f +: ∅ ∈ Q) $ by cab_elim [l20]
l22: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ ∅ +: c +: f +: ∅ ∈ Q $ by imp_elim [imp_elim [all_elim [l21], l13], l14]
l23: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅ ⇒ ap h n ∈ Q $ by wcel_eq_l [eq_sym [l17], l22]
l24: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n , ∃ f (c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅) ⇒ ∃ f (c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ y = ∅ +: c +: f +: ∅) $ by ax
l25: $ … ⇒ ap h n ∈ Q $ by ex_elim [l24, l23]
l26: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i , y = ap h n ⇒ ap h n ∈ Q $ by ex_elim [l11, l25]
l27: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i ⇒ isset (ap h n) $ by wcel_isset [l5]
l28: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) , n ∊ i ⇒ ap h n ∈ Q $ by isset_elim [l27, l26]
l29: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) ⇒ ∀ n (n ∊ i → ap h n ∈ Q) $ by all_intro [imp_intro [l28]]
l30: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∀ n (n ∊ i → ap f n ∈ Q) → ∅ +: i +: f +: ∅ ∈ Q) $ by weaken [#3]
l31: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) ⇒ ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∀ n (n ∊ i → ap f n ∈ Q) → ∅ +: i +: f +: ∅ ∈ Q) $ by all_elim [l30]
l32: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) ⇒ i ∊ U₁ → h ∊ (Πₛ a ∈ i, psv u w b) → ∀ n (n ∊ i → ap h n ∈ Q) → ∅ +: i +: h +: ∅ ∈ Q $ by all_elim [l31]
l33: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) , i ∊ U₁ , h ∊ (Πₛ a ∈ i, psv u w b) ⇒ ∅ +: i +: h +: ∅ ∈ Q $ by imp_elim [imp_elim [imp_elim [l32, l1], l2], l29]
l34: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) ⇒ ∀ i (i ∊ U₁ → h ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: h +: ∅ ∈ Q) $ by all_intro [imp_intro [imp_intro [l33]]]
l35: $ G , ∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) ⇒ h ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)} $ by cab_intro [l34]
l36: $ G ⇒ ∀ h (∀ j (j ∊ tcl h → j ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) → h ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) $ by all_intro [imp_intro [l35]]
l37: $ G ⇒ ∀ h (h ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) $ by tcl_ind [l36]
l38: $ G , x ∊ psv u w b ⇒ uadm u $ by weaken [#1]
l39: $ G , x ∊ psv u w b ⇒ w ∊ lvals $ by weaken [#2]
l40: $ G , x ∊ psv u w b ⇒ x ∊ psv u w b $ by ax
l41: $ G , x ∊ psv u w b ⇒ ∃ c ∃ f (c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅) $ by ps_el [l38, l39, l40]
l42: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ $ by ax
l43: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ c ∊ U₁ $ by and_elim_l [l42]
l44: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ f ∊ (Πₛ a ∈ c, psv u w b) $ by and_elim_l [and_elim_r [l42]]
l45: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ x = ∅ +: c +: f +: ∅ $ by and_elim_r [and_elim_r [l42]]
l46: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ ∀ h (h ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)}) $ by weaken [l37]
l47: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ f ∊ {y | ∀ i (i ∊ U₁ → y ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: y +: ∅ ∈ Q)} $ by all_elim [l46]
l48: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ ∀ i (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∅ +: i +: f +: ∅ ∈ Q) $ by cab_elim [l47]
l49: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ ∅ +: c +: f +: ∅ ∈ Q $ by imp_elim [imp_elim [all_elim [l48], l43], l44]
l50: $ G , x ∊ psv u w b , c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅ ⇒ x ∊ Q $ by wcel_welc [wcel_eq_l [eq_sym [l45], l49]]
l51: $ G , x ∊ psv u w b , ∃ f (c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅) ⇒ ∃ f (c ∊ U₁ ∧ f ∊ (Πₛ a ∈ c, psv u w b) ∧ x = ∅ +: c +: f +: ∅) $ by ax
l52: $ … ⇒ x ∊ Q $ by ex_elim [l51, l50]
l53: $ G , x ∊ psv u w b ⇒ x ∊ Q $ by ex_elim [l41, l52]
l54: $ G ⇒ psv u w b ⊆ Q $ by subset_intro [l53]

--| @freshen G i
--| @freshen G f
--| @freshen G a
lemma pc_sub {i f a: set} (G: hyps) (X C: class): $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, X) → ∅ +: i +: f +: ∅ ∈ X) $ > $ G ⇒ pcop X C ⊆ X × U₁ $
----
l1: $ G , z ∊ pcop X C ⇒ z ∊ pcop X C $ by ax
l2: $ G , z ∊ pcop X C ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by cab_elim [l1]
l3: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ $ by ax
l4: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ i ∊ U₁ $ by and_elim_l [l3]
l5: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ f ∊ (Πₛ a ∈ i, X) $ by and_elim_l [and_elim_r [l3]]
l6: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ m ∊ U₁ $ by and_elim_l [and_elim_r [and_elim_r [l3]]]
l7: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l3]]]]
l8: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]
l9: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l3]]]]]
l10: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, X) → ∅ +: i +: f +: ∅ ∈ X) $ by weaken [#1]
l11: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, X) → ∅ +: i +: f +: ∅ ∈ X) $ by all_elim [l10]
l12: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ i ∊ U₁ → f ∊ (Πₛ a ∈ i, X) → ∅ +: i +: f +: ∅ ∈ X $ by all_elim [l11]
l13: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∅ +: i +: f +: ∅ ∈ X $ by imp_elim [imp_elim [l12, l4], l5]
l14: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ⟨ ∅ +: i +: f +: ∅ , m ⟩ ∈ X × U₁ $ by cxp_intro_c [l13, welc_wcel [l6]]
l15: $ G , z ∊ pcop X C , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ z ∊ X × U₁ $ by wcel_welc [wcel_eq_l [eq_sym [l9], l14]]
l16: $ G , z ∊ pcop X C , ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) ⇒ ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ax
l17: $ … ⇒ z ∊ X × U₁ $ by ex_elim [l16, l15]
l18: $ G , z ∊ pcop X C , ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) ⇒ ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ C)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by ax
l19: $ … ⇒ z ∊ X × U₁ $ by ex_elim [l18, l17]
l20: $ G , z ∊ pcop X C ⇒ z ∊ X × U₁ $ by ex_elim [l2, l19]
l21: $ G ⇒ pcop X C ⊆ X × U₁ $ by subset_intro [l20]

--| @freshen G i
--| @freshen G f
--| @freshen G a
lemma pc_fix {i f a c: set} (G: hyps) (X: class): $ G ⇒ isset X $ > $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, X) → ∅ +: i +: f +: ∅ ∈ X) $ > $ G ⇒ cap c (pcop X c) (plf X) = plf X ∧ isset (plf X) $
----
l1: $ G , u ⊆ v , z ∊ pcop X u ⇒ z ∊ pcop X u $ by ax
l2: $ G , u ⊆ v , z ∊ pcop X u ⇒ ∃ i ∃ f ∃ m (i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩) $ by cab_elim [l1]
l3: $ G , u ⊆ v ⇒ u ⊆ v $ by ax
l4: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ $ by ax
l5: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ i ∊ U₁ $ by and_elim_l [l4]
l6: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ f ∊ (Πₛ a ∈ i, X) $ by and_elim_l [and_elim_r [l4]]
l7: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ m ∊ U₁ $ by and_elim_l [and_elim_r [and_elim_r [l4]]]
l8: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [l4]]]]
l9: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) $ by and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l4]]]]]
l10: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ ⇒ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ $ by and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l4]]]]]
l11: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ , n ∊ i ⇒ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) $ by weaken [l8]
l12: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ , n ∊ i ⇒ n ∊ i $ by ax
l13: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ , n ∊ i ⇒ ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u) $ by imp_elim [all_elim [l11], l12]
l14: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ , n ∊ i , y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u ⇒ y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u $ by ax
l15: $ G , u ⊆ v , z ∊ pcop X u , i ∊ U₁ ∧ f ∊ (Πₛ a ∈ i, X) ∧ m ∊ U₁ ∧ ∀ n (n ∊ i → ∃ y (y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ ∀ y (y ∊ m → ∃ n (n ∊ i ∧ ⟨ ap f n , y ⟩ ∈ u)) ∧ z = ⟨ ∅ +: i +: f +: ∅ , m ⟩ , n ∊ i , y ∊ m ∧ ⟨ ap f n , y ⟩ ∈ u ⇒ y ∊ m $ by and_elim_l [l14]
