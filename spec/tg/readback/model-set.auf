l381: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) ⇒ ∅ +: i +: f +: ∅ ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))} $ by wcel_cab_intro [l380, l379]
l382: $ G ⇒ ∀ i ∀ f (i ∊ U₁ → f ∊ (Πₛ a ∈ i, psv u w b) → ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) → ∅ +: i +: f +: ∅ ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) $ by all_intro [all_intro [imp_intro [imp_intro [imp_intro [l381]]]]]
l383: $ G ⇒ psv u w b ⊆ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))} $ by ps_ind [l1, l2, l382]

lemma et_rel {xx8 xx9: set} (G: hyps) (b: blk) (E: expr) (u w: set): $ closed nz E $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ cval u w E ∈ (Πₛ xx8 ∈ psv u w b, (Πₛ xx9 ∈ psv u w b, uni' ∅)) $
----
l1: $ G , q = ∅ ⇒ uadm u $ by weaken [#3]
