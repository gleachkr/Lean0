lemma pq_e (G: hyps) (b: blk) (E: expr) (u w x y: set): $ closed nz E $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ inh nil (pset_e1 b E) $ > $ inh nil (pset_e2 b E) $ > $ inh nil (pset_e3 b E) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ x ∊ psv u w b $ > $ G ⇒ y ∊ psv u w b $ > $ G ⇒ ∅ ∈ ap (ap (cval u w E) x) y ↔ (pcol u w b)' x = (pcol u w b)' y $
----
l1: $ G ⇒ psv u w b ⊆ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))} $ by pe_sub [#1, #2, #3, #4, #5, #6, #7]
l2: $ G ⇒ x ∊ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))} $ by subset_elim [l1, #8]
l3: $ G ⇒ ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) x) r ↔ (pcol u w b)' x = (pcol u w b)' r)) $ by cab_elim [l2]
l4: $ G ⇒ y ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) x) y ↔ (pcol u w b)' x = (pcol u w b)' y) $ by all_elim [l3]
l5: $ G ⇒ ∅ ∈ ap (ap (cval u w E) x) y ↔ (pcol u w b)' x = (pcol u w b)' y $ by imp_elim [l4, #9]

