l30: $ G , q = ∅ ⇒ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w ∅ = (Πₛ xx8 ∈ dt u (mcv hfin) (enc_expr (pset b)) w ∅, dt u (mcv hfin) (enc_expr (pi (pset b) (Prop))) w (xx8 +: ∅)) $ by dt_pi_c [l28, l29, l26, l27]
l31: $ G , q = ∅ ⇒ w ∈ lvals $ by weaken [l3]
