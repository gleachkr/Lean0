--| @freshen G a
--| @freshen G f
--| @freshen G g
--| @freshen G i
--| @freshen G j
--| @freshen G m
--| @freshen G n
lemma fse_2 {a f g i j m n: set} (G: hyps) (b: blk) (E: expr) (u w: set): $ closed nz E $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ inh nil (pset_e2 b E) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ i (i ∊ U₁ → (∀ f (f ∊ (Πₛ a ∈ i, psv u w b) → (∀ j (j ∊ U₁ → (∀ g (g ∊ (Πₛ a ∈ j, psv u w b) → (∅ ∈ ap (ap (cval u w E) (ap (ap (pmk u w b) i) f)) (ap (ap (pmk u w b) j) g) → (∀ m (m ∊ j → ((∀ n (n ∊ i → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥))))))))))) $
----
l1: $ G , q = ∅ ⇒ uadm u $ by weaken [#4]
l2: $ G , q = ∅ ⇒ w ∊ lvals $ by weaken [#5]
l3: $ G , q = ∅ ⇒ w ∈ lvals $ by welc_wcel [l2]
l4: $ G , q = ∅ ⇒ q = ∅ $ by ax
l5: $ G , q = ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
l6: $ G , q = ∅ ⇒ lv (enc_lvl lz) w = ∅ $ by lv_lz
l7: $ G , q = ∅ ⇒ enc_lvl lz ∈ trees ω $ by enc_lvl_trees
l8: $ G , q = ∅ ⇒ enc_lvl (ls lz) ∈ trees ω $ by enc_lvl_trees
l9: $ G , q = ∅ ⇒ lv (enc_lvl (ls lz)) w = suc (lv (enc_lvl lz) w) $ by lv_ls [l7, l2]
l10: $ G , q = ∅ ⇒ lv (enc_lvl (ls lz)) w = suc ∅ $ by eq_trans [l9, suc_eq [l6]]
l11: $ G , q = ∅ ⇒ lv (enc_lvl (ls (ls lz))) w = suc (lv (enc_lvl (ls lz)) w) $ by lv_ls [l8, l2]
l12: $ G , q = ∅ ⇒ lv (enc_lvl (ls (ls lz))) w = suc (suc ∅) $ by eq_trans [l11, suc_eq [l10]]
l13: $ G , q = ∅ ⇒ sat u (mcv hfin) (enc_ctx nil) w = csn ∅ $ by sat_nil [l2]
l14: $ G , q = ∅ ⇒ q ∊ sat u (mcv hfin) (enc_ctx nil) w $ by welc_eq [eq_sym [l13], csn_intro [l4]]
l15: $ G , q = ∅ ⇒ ∀ yy2 (uadm yy2 → ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat yy2 (mcv hfin) (enc_ctx nil) yy3 → dt yy2 (mcv hfin) (enc_expr (E)) yy3 yy4 = dt yy2 (mcv hfin) (enc_expr (E)) yy3 yy4 ∧ dt yy2 (mcv hfin) (enc_expr (E)) yy3 yy4 ∈ dt yy2 (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) yy3 yy4))) $ by weaken [#2]
l16: $ G , q = ∅ ⇒ ∀ yy3 (yy3 ∊ lvals → ∀ yy4 (yy4 ∊ sat u (mcv hfin) (enc_ctx nil) yy3 → dt u (mcv hfin) (enc_expr (E)) yy3 yy4 = dt u (mcv hfin) (enc_expr (E)) yy3 yy4 ∧ dt u (mcv hfin) (enc_expr (E)) yy3 yy4 ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) yy3 yy4)) $ by imp_elim [all_elim [l15], l1]
l17: $ G , q = ∅ ⇒ ∀ yy4 (yy4 ∊ sat u (mcv hfin) (enc_ctx nil) w → dt u (mcv hfin) (enc_expr (E)) w yy4 = dt u (mcv hfin) (enc_expr (E)) w yy4 ∧ dt u (mcv hfin) (enc_expr (E)) w yy4 ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w yy4) $ by imp_elim [all_elim [l16], l2]
l18: $ G , q = ∅ ⇒ dt u (mcv hfin) (enc_expr (E)) w q = dt u (mcv hfin) (enc_expr (E)) w q ∧ dt u (mcv hfin) (enc_expr (E)) w q ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w q $ by imp_elim [all_elim [l17], l14]
l19: $ G , q = ∅ ⇒ dt u (mcv hfin) (enc_expr (E)) w q ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w q $ by and_elim_r [l18]
l20: $ G , q = ∅ ⇒ u = u $ by eq_refl
l21: $ G , q = ∅ ⇒ mcv hfin = mcv hfin $ by eq_refl
l22: $ G , q = ∅ ⇒ enc_expr (E) = enc_expr (E) $ by eq_refl
l23: $ G , q = ∅ ⇒ w = w $ by eq_refl
l24: $ G , q = ∅ ⇒ enc_expr (pi (pset b) (pi (pset b) (Prop))) = enc_expr (pi (pset b) (pi (pset b) (Prop))) $ by eq_refl
l25: $ G , q = ∅ ⇒ cval u w E ∈ dt u (mcv hfin) (enc_expr (pi (pset b) (pi (pset b) (Prop)))) w ∅ $ by wcel_eq_l [dt_eq [l20, l21, l22, l23, l4], wcel_eq_r [dt_eq [l20, l21, l24, l23, l4], l19]]
