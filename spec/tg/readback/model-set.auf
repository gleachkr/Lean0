l378: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ ⇒ r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) z) r ↔ (pcol u w b)' z = (pcol u w b)' r) $ by imp_intro [l377]
l379: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ ⇒ ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) z) r ↔ (pcol u w b)' z = (pcol u w b)' r)) $ by all_intro [l378]
