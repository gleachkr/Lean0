z1: $ mdeq (mcv H) G (ind_ctor (pset_D b) nz nz) (ind_ctor (pset_D b) nz nz) (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz))) $ by mdeq_i [l103, l102]

lemma fset_iw (G: hyps) (H: class) (b: blk) (u w: set): $ _ ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ iwf u H (jmod (mcv H)) (enc_ctx nil) (enc_ind (pset_D b)) w ∅ $
----
l1: $ G , q = ∅ ⇒ uadm u $ by weaken [#2]
l2: $ G , q = ∅ ⇒ w ∊ lvals $ by weaken [#3]
l3: $ G , q = ∅ ⇒ hind H $ by weaken [#1]
l4: $ G , q = ∅ ⇒ hty ⊆ H $ by hind_hty [l3]
l5: $ G , q = ∅ ⇒ functional H $ by hind_functional [l3]
l6: $ G , q = ∅ ⇒ jval u (mcv H) (jmod (mcv H)) $ by jmod_jval [l1]
l7: $ _ ⇒ ra_ind_wf (enc_ctx nil) (enc_ind (pset_D b)) ∈ lrel3 (jmod (mcv H)) $ by pset_D_wf [#1]
l8: $ G , q = ∅ ⇒ ra_ind_wf (enc_ctx nil) (enc_ind (pset_D b)) ∈ lrel3 (jmod (mcv H)) $ by weaken [l7]
l9: $ _ ⇒ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind $ by enc_ind_sorted
l10: $ G , q = ∅ ⇒ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind $ by weaken [l9]
l11: $ G , q = ∅ ⇒ q = ∅ $ by ax
l12: $ G , q = ∅ ⇒ sat u (mcv H) (enc_ctx nil) w = csn ∅ $ by sat_nil [l2]
l13: $ G , q = ∅ ⇒ q ∊ sat u (mcv H) (enc_ctx nil) w $ by welc_eq [eq_sym [l12], csn_intro [l11]]
l14: $ G , q = ∅ ⇒ ∅ ∈ sat u (mcv H) (enc_ctx nil) w $ by wcel_eq_l [l11, welc_wcel [l13]]
l15: $ G , q = ∅ ⇒ w ∈ lvals $ by welc_wcel [l2]
l16: $ G , q = ∅ ⇒ w ∈ lvals ∧ ∅ ∈ sat u (mcv H) (enc_ctx nil) w $ by and_intro [l15, l14]
l17: $ G , q = ∅ ⇒ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ ∅ ∈ sat u (mcv H) (enc_ctx nil) w $ by and_intro [l10, l16]
l18: $ G , q = ∅ ⇒ ra_ind_wf (enc_ctx nil) (enc_ind (pset_D b)) ∈ lrel3 (jmod (mcv H)) ∧ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ ∅ ∈ sat u (mcv H) (enc_ctx nil) w $ by and_intro [l8, l17]
l19: $ G , q = ∅ ⇒ jval u (mcv H) (jmod (mcv H)) ∧ ra_ind_wf (enc_ctx nil) (enc_ind (pset_D b)) ∈ lrel3 (jmod (mcv H)) ∧ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ ∅ ∈ sat u (mcv H) (enc_ctx nil) w $ by and_intro [l6, l18]
l20: $ G , q = ∅ ⇒ functional H ∧ jval u (mcv H) (jmod (mcv H)) ∧ ra_ind_wf (enc_ctx nil) (enc_ind (pset_D b)) ∈ lrel3 (jmod (mcv H)) ∧ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ ∅ ∈ sat u (mcv H) (enc_ctx nil) w $ by and_intro [l5, l19]
l21: $ G , q = ∅ ⇒ hty ⊆ H ∧ functional H ∧ jval u (mcv H) (jmod (mcv H)) ∧ ra_ind_wf (enc_ctx nil) (enc_ind (pset_D b)) ∈ lrel3 (jmod (mcv H)) ∧ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ ∅ ∈ sat u (mcv H) (enc_ctx nil) w $ by and_intro [l4, l20]
l22: $ G , q = ∅ ⇒ uadm u ∧ hty ⊆ H ∧ functional H ∧ jval u (mcv H) (jmod (mcv H)) ∧ ra_ind_wf (enc_ctx nil) (enc_ind (pset_D b)) ∈ lrel3 (jmod (mcv H)) ∧ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ ∅ ∈ sat u (mcv H) (enc_ctx nil) w $ by and_intro [l1, l21]
l23: $ G , q = ∅ , uadm u ∧ hty ⊆ H ∧ functional H ∧ jval u (mcv H) (jmod (mcv H)) ∧ ra_ind_wf (enc_ctx nil) (enc_ind (pset_D b)) ∈ lrel3 (jmod (mcv H)) ∧ enc_ind (pset_D b) ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ ∅ ∈ sat u (mcv H) (enc_ctx nil) w ⇒ iwf u H (jmod (mcv H)) (enc_ctx nil) (enc_ind (pset_D b)) w ∅ $ by ax
l24: $ G , q = ∅ ⇒ iwf u H (jmod (mcv H)) (enc_ctx nil) (enc_ind (pset_D b)) w ∅ $ by imp_elim [imp_intro [l23], l22]
l25: $ G ⇒ isset ∅ $ by ax_empty
l26: $ G ⇒ iwf u H (jmod (mcv H)) (enc_ctx nil) (enc_ind (pset_D b)) w ∅ $ by isset_elim [l25, l24]

lemma fset_np (G: hyps) (H K: class) (b: blk) (w: set): $ _ ⇒ hind H $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ¬ iprop (enc_ind (pset_D b)) K w $
