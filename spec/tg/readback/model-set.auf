l17: $ G , q = ∅ ⇒ mcv H = mcv H $ by eq_refl
l18: $ G , q = ∅ ⇒ enc_expr (ind_ctor (pset_D b) nz nz) = enc_expr (ind_ctor (pset_D b) nz nz) $ by eq_refl
l19: $ G , q = ∅ ⇒ w = w $ by eq_refl
l20: $ G , q = ∅ ⇒ enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz))) = enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz))) $ by eq_refl
l21: $ G , q = ∅ ⇒ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w ∅ $ by wcel_eq_l [dt_eq [l16, l17, l18, l19, l6], wcel_eq_r [dt_eq [l16, l17, l20, l19, l6], l15]]
