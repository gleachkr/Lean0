l379: $ G , d = enc_ind (pset_D b) ⇒ ap (ap (dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅) i) f = ∅ +: i +: f +: ∅ $ by isset_elim [l378, l376]
