l13: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ enc_nat nz = i $ by eq_sym [l6]
l14: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ enc_lvl (ls (ls lz)) = l $ by eq_sym [l7]
l15: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ w ∊ lvals $ by weaken [#2]
l16: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ w ∈ lvals $ by welc_wcel [l15]
l17: $ _ ⇒ ra_ind_data (enc_ind (pset_D b)) (enc_blk b) (enc_ctx nil) (enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil)) ∈ lrel $ by fset_id
l18: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ ra_ind_data (enc_ind (pset_D b)) (enc_blk b) (enc_ctx nil) (enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil)) ∈ lrel $ by weaken [l17]
l19: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ ra_ind_data d k g t ∈ lrel $ by wcel_eq_l [ra_ind_data_eq [l8, l9, l10, l11], l18]
l20: $ _ ⇒ ra_tys_wf (enc_ind (pset_D b)) (enc_nat n1) (enc_nat nz) (enc_lvl (ls (ls lz))) (enc_nat nz) (enc_ctx nil) (enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil)) ∈ lrel3 (jmod (mcv H)) $ by fset_tw [#1]
l21: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , i = enc_nat nz , l = enc_lvl (ls (ls lz)) ⇒ ra_tys_wf (enc_ind (pset_D b)) (enc_nat n1) (enc_nat nz) (enc_lvl (ls (ls lz))) (enc_nat nz) (enc_ctx nil) (enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil)) ∈ lrel3 (jmod (mcv H)) $ by weaken [l20]
