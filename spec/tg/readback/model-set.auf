l120: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ , m = ap y i ⇒ m ∊ (Πₛ h ∈ (Πₛ a ∈ i, dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅), dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅) $ by wcel_welc [wcel_eq_l [eq_sym [l118], l119]]
