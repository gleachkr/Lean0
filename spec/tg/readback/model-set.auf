--| @freshen G a
lemma fset_mk {a: set} (G: hyps) (H: class) (b: blk) (u w i f: set): $ _ ⇒ hind H $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ i ∊ U₁ $ > $ G ⇒ f ∊ (Πₛ a ∈ i, dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅) $ > $ G ⇒ ap (ap (dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅) i) f = ∅ +: i +: f +: ∅ $
----
l1: $ G , d = enc_ind (pset_D b) , k = enc_blk b , g = enc_ctx nil , t = enc_tys (tcons (srt (ls (ls lz))) (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) tnil) , n = enc_nat n1 , z = enc_nat nz , e = enc_expr (srt (ls (ls lz))) , c = enc_ctors (ccons (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) cnil) , l = enc_lvl (ls (ls lz)) , x0 = enc_expr (ind_ty (pset_D b) nz) , x1 = enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (bvar n2)) (bvar n2))) , x2 = enc_expr (srt (ls lz)) , x3 = enc_expr (pi (pi (bvar nz) (bvar n2)) (bvar n2)) , x4 = enc_expr (pi (bvar nz) (bvar n2)) , x5 = enc_expr (bvar n2) , q = ∅ , v = ixs d w (ifam u (dnf u (mcv H)) d w) , y = enc_expr (ind_ctor (pset_D b) nz nz) , r = i +: v , m = f +: ∅ , j = etel u (dnf u (mcv H)) x4 w r +: ∅ , xx0 = f +: i +: ∅ , xx1 = i +: m , xx2 = etel u (dnf u (mcv H)) x2 w v +: j ⇒ d = enc_ind (pset_D b) $ by ax
