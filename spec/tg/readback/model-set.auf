l6: $ G , t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b ⇒ w ∊ lvals $ by weaken [#2]
l7: $ G , t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b ⇒ x ∊ psv u w b $ by weaken [#3]
l8: $ G , t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b ⇒ (pcol u w b)' x = t $ by pp_fv [l5, l6, l7, l4]
l9: $ G , t ∊ U₁ ∧ ⟨ x , t ⟩ ∈ pcol u w b ⇒ (pcol u w b)' x ∈ U₁ $ by wcel_eq_l [eq_sym [l8], welc_wcel [l3]]
l10: $ G ⇒ (pcol u w b)' x ∈ U₁ $ by ex_elim [l1, l9]

