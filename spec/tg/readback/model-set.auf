l114: $ G , q = ∅ , y = dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ⇒ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ∈ (Πₛ j ∈ U₁, (Πₛ h ∈ (Πₛ a ∈ j, dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅), dt u (mcv H) (enc_expr (ind_ty (pset_D b) nz)) w ∅)) $ by weaken [l112]
