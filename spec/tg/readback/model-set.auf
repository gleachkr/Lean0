l33: $ G , q = ∅ ⇒ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w ∅ = (Πₛ j ∈ dt u (mcv H) (enc_expr (srt (ls lz))) w ∅, dt u (mcv H) (enc_expr (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz))) w (j +: ∅)) $ by dt_pi_c [l31, l32, l29, l30]
l34: $ G , q = ∅ ⇒ w ∈ lvals $ by weaken [l3]
