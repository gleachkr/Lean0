--| @freshen G yy0
--| @freshen G r
lemma pe_sub {yy0 r: set} (G: hyps) (b: blk) (E: expr) (u w: set): $ closed nz E $ > $ ty nil E (pi (pset b) (pi (pset b) Prop)) $ > $ inh nil (pset_e1 b E) $ > $ inh nil (pset_e2 b E) $ > $ inh nil (pset_e3 b E) $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ psv u w b ⊆ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))} $
----
l1: $ G ⇒ uadm u $ by weaken [#6]
l2: $ G ⇒ w ∊ lvals $ by weaken [#7]
l3: $ G ⇒ ∀ i (i ∊ U₁ → (∀ f (f ∊ (Πₛ a ∈ i, psv u w b) → (∀ j (j ∊ U₁ → (∀ g (g ∊ (Πₛ a ∈ j, psv u w b) → (∅ ∈ ap (ap (cval u w E) (ap (ap (pmk u w b) i) f)) (ap (ap (pmk u w b) j) g) → (∀ n (n ∊ i → ((∀ m (m ∊ j → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥))))))))))) $ by fse_1 [#1, #2, #3, l1, l2]
l4: $ G ⇒ ∀ i (i ∊ U₁ → (∀ f (f ∊ (Πₛ a ∈ i, psv u w b) → (∀ j (j ∊ U₁ → (∀ g (g ∊ (Πₛ a ∈ j, psv u w b) → (∅ ∈ ap (ap (cval u w E) (ap (ap (pmk u w b) i) f)) (ap (ap (pmk u w b) j) g) → (∀ m (m ∊ j → ((∀ n (n ∊ i → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥))))))))))) $ by fse_2 [#1, #2, #4, l1, l2]
l5: $ G ⇒ ∀ i (i ∊ U₁ → (∀ f (f ∊ (Πₛ a ∈ i, psv u w b) → (∀ j (j ∊ U₁ → (∀ g (g ∊ (Πₛ a ∈ j, psv u w b) → ((∀ n (n ∊ i → ((∀ m (m ∊ j → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥))) → ((∀ m (m ∊ j → ((∀ n (n ∊ i → (∅ ∈ ap (ap (cval u w E) (ap f n)) (ap g m) → ⊥))) → ⊥))) → ∅ ∈ ap (ap (cval u w E) (ap (ap (pmk u w b) i) f)) (ap (ap (pmk u w b) j) g)))))))))) $ by fse_3 [#1, #2, #5, l1, l2]
l6: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b ⇒ uadm u $ by weaken [l1]
l7: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b ⇒ w ∊ lvals $ by weaken [l2]
l8: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b ⇒ r ∊ psv u w b $ by ax
l9: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b ⇒ ∃ j ∃ g (j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅) $ by ps_el [l6, l7, l8]
l10: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ ⇒ i ∊ U₁ $ by ax
l11: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ ⇒ f ∊ (Πₛ a ∈ i, psv u w b) $ by ax
l12: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ ⇒ j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ $ by ax
l13: $ G , i ∊ U₁ , f ∊ (Πₛ a ∈ i, psv u w b) , ∀ n (n ∊ i → ap f n ∈ {yy0 | ∀ r (r ∊ psv u w b → (∅ ∈ ap (ap (cval u w E) yy0) r ↔ (pcol u w b)' yy0 = (pcol u w b)' r))}) , z = ∅ +: i +: f +: ∅ , r ∊ psv u w b , j ∊ U₁ ∧ g ∊ (Πₛ a ∈ j, psv u w b) ∧ r = ∅ +: j +: g +: ∅ ⇒ j ∊ U₁ $ by and_elim_l [l12]
