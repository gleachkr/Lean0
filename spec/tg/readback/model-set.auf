l84: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w , g = enc_ctx nil , d = enc_ind (pset_D b) , k = enc_blk b ⇒ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w ∅ $ by isset_elim [l83, l81]
l85: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w , g = enc_ctx nil , d = enc_ind (pset_D b) ⇒ enc_blk b ∈ trees ω $ by enc_blk_trees
l86: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w , g = enc_ctx nil , d = enc_ind (pset_D b) ⇒ isset (enc_blk b) $ by wcel_isset [l85]
l87: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w , g = enc_ctx nil , d = enc_ind (pset_D b) ⇒ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w ∅ $ by isset_elim [l86, l84]
l88: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w , g = enc_ctx nil ⇒ enc_ind (pset_D b) ∈ trees ω $ by enc_ind_trees
l89: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w , g = enc_ctx nil ⇒ isset (enc_ind (pset_D b)) $ by wcel_isset [l88]
l90: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w , g = enc_ctx nil ⇒ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w ∅ $ by isset_elim [l89, l87]
l91: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w ⇒ enc_ctx nil ∈ trees ω $ by enc_ctx_trees
l92: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w ⇒ isset (enc_ctx nil) $ by wcel_isset [l91]
l93: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w ⇒ dt u (mcv H) (enc_expr (ind_ctor (pset_D b) nz nz)) w ∅ ∈ dt u (mcv H) (enc_expr (pi (srt (ls lz)) (pi (pi (bvar nz) (ind_ty (pset_D b) nz)) (ind_ty (pset_D b) nz)))) w ∅ $ by isset_elim [l92, l90]
l94: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w ⇒ w ∊ lvals $ by ax
l95: $ uadm u , w ∊ lvals , r ∊ sat u (mcv H) (enc_ctx G) w ⇒ w ∈ lvals $ by welc_wcel [l94]
