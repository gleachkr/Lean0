l63: $ G , ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ y (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel) ⇒ ∃ u ∃ v (ra_spine ⟨ kc_bvar , scons u ∅ ⟩ c v ∈ lrel ∧ fv nvf u = nadd (nadd (fv nvf d) (fv nvf e)) (fv nvf j)) $ by ex_elim [l62, l61]
l64: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ y (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel) ⇒ ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ y (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel) $ by ax
l65: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ y (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel) ⇒ ∃ u ∃ v (ra_spine ⟨ kc_bvar , scons u ∅ ⟩ c v ∈ lrel ∧ fv nvf u = nadd (nadd (fv nvf d) (fv nvf e)) (fv nvf j)) $ by ex_elim [l64, l63]
l66: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ y (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ y (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel) $ by ax
l67: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ y (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel) ⇒ ∃ u ∃ v (ra_spine ⟨ kc_bvar , scons u ∅ ⟩ c v ∈ lrel ∧ fv nvf u = nadd (nadd (fv nvf d) (fv nvf e)) (fv nvf j)) $ by ex_elim [l66, l65]
l68: $ G ⇒ ∃ u ∃ v (ra_spine ⟨ kc_bvar , scons u ∅ ⟩ c v ∈ lrel ∧ fv nvf u = nadd (nadd (fv nvf d) (fv nvf e)) (fv nvf j)) $ by ex_elim [l1, l67]

lemma d1_spine_bvar_pi (G: hyps) (u c v f g: set):
  $ G ⇒ ra_spine ⟨ kc_bvar , scons u ∅ ⟩ c v ∈ lrel $ > $ G ⇒ c = ⟨ kc_pi , scons f (scons g ∅) ⟩ $ > $ G ⇒ ⊥ $
----
l1: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ w = ⟨ kc_bvar , scons u ∅ ⟩ $ by ax
l2: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ ⟨ kc_bvar , scons u ∅ ⟩ = w $ by eq_sym [l1]
l3: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ c = c $ by eq_refl
l4: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ v = v $ by eq_refl
l5: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ ra_spine ⟨ kc_bvar , scons u ∅ ⟩ c v = ra_spine w c v $ by ra_spine_eq [l2, l3, l4]
l6: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ ra_spine ⟨ kc_bvar , scons u ∅ ⟩ c v ∈ lrel $ by weaken [#1]
l7: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ ra_spine w c v ∈ lrel $ by wcel_eq_l [l5, l6]
l8: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ ∃ x1 (w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) $ by lrel_spine_cases [l7]
l9: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ $ by ax
l10: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ w = x1 $ by and_elim_l [l9]
l11: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l9]
l12: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ c = x1 $ by and_elim_l [l11]
l13: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ v = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l11]
l14: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ x1 = c $ by eq_sym [l12]
l15: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ w = c $ by eq_trans [l10, l14]
l16: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_bvar , scons u ∅ ⟩ = w $ by weaken [l2]
l17: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_bvar , scons u ∅ ⟩ = c $ by eq_trans [l16, l15]
l18: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ c = ⟨ kc_pi , scons f (scons g ∅) ⟩ $ by weaken [#2]
l19: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_bvar , scons u ∅ ⟩ = ⟨ kc_pi , scons f (scons g ∅) ⟩ $ by eq_trans [l17, l18]
l20: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l21: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_bvar $ by wcel_isset [l20]
l22: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l23: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons u ∅) $ by scons_set [l22]
l24: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ kc_pi ∈ ω $ by kc_pi_omega
l25: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_pi $ by wcel_isset [l24]
l26: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l27: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons g ∅) $ by scons_set [l26]
l28: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons f (scons g ∅)) $ by scons_set [l27]
l29: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ kc_bvar = kc_pi ∧ scons u ∅ = scons f (scons g ∅) $ by opair_inj_c [l19, l21, l23, l25, l28]
l30: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ kc_bvar = kc_pi $ by and_elim_l [l29]
l31: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_bvar = kc_pi $ by kc_bvar_ne_pi
l32: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩ ⇒ ⊥ $ by not_elim [l31, l30]
l33: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x1 (w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ x1 (w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩) $ by ax
l34: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x1 (w = x1 ∧ c = x1 ∧ v = ⟨ kc_nz , ∅ ⟩) ⇒ ⊥ $ by ex_elim [l33, l32]
l35: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel $ by ax
l36: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ w = x1 $ by and_elim_l [l35]
l37: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel $ by and_elim_r [l35]
l38: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ $ by and_elim_l [l37]
l39: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel $ by and_elim_r [l37]
l40: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ v = ⟨ kc_s , scons x4 ∅ ⟩ $ by and_elim_l [l39]
l41: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ ra_spine x1 x2 x4 ∈ lrel $ by and_elim_r [l39]
l42: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ = c $ by eq_sym [l38]
l43: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ c = ⟨ kc_pi , scons f (scons g ∅) ⟩ $ by weaken [#2]
l44: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ = ⟨ kc_pi , scons f (scons g ∅) ⟩ $ by eq_trans [l42, l43]
l45: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
l46: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ isset kc_app $ by wcel_isset [l45]
l47: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ isset ∅ $ by ax_empty
l48: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ isset (scons x3 ∅) $ by scons_set [l47]
l49: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ isset (scons x2 (scons x3 ∅)) $ by scons_set [l48]
l50: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
l51: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ isset kc_pi $ by wcel_isset [l50]
l52: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ isset ∅ $ by ax_empty
l53: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ isset (scons g ∅) $ by scons_set [l52]
l54: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ isset (scons f (scons g ∅)) $ by scons_set [l53]
l55: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ kc_app = kc_pi ∧ scons x2 (scons x3 ∅) = scons f (scons g ∅) $ by opair_inj_c [l44, l46, l49, l51, l54]
l56: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ kc_app = kc_pi $ by and_elim_l [l55]
l57: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ ¬ kc_app = kc_pi $ by kc_app_ne_pi
l58: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel ⇒ ⊥ $ by not_elim [l57, l56]
l59: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) ⇒ ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) $ by ax
l60: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) ⇒ ⊥ $ by ex_elim [l59, l58]
l61: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) ⇒ ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) $ by ax
l62: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) ⇒ ⊥ $ by ex_elim [l61, l60]
l63: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x2 ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) ⇒ ∃ x2 ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) $ by ax
l64: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x2 ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) ⇒ ⊥ $ by ex_elim [l63, l62]
l65: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x1 ∃ x2 ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) $ by ax
l66: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ , ∃ x1 ∃ x2 ∃ x3 ∃ x4 (w = x1 ∧ c = ⟨ kc_app , scons x2 (scons x3 ∅) ⟩ ∧ v = ⟨ kc_s , scons x4 ∅ ⟩ ∧ ra_spine x1 x2 x4 ∈ lrel) ⇒ ⊥ $ by ex_elim [l65, l64]
l67: $ G , w = ⟨ kc_bvar , scons u ∅ ⟩ ⇒ ⊥ $ by or_elim [l8, l34, l66]
l68: $ G ⇒ isset ⟨ kc_bvar , scons u ∅ ⟩ $ by opair_isset
l69: $ G ⇒ ⊥ $ by isset_elim [l68, l67]

lemma d1_bvar_nap {x y: set} (G: hyps) (l u: set):
  $ G ⇒ l = ⟨ kc_bvar , scons u ∅ ⟩ $ > $ G ⇒ ¬ ∃ x ∃ y (l = ⟨ kc_app , scons x (scons y ∅) ⟩) $
----
l1: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ l = ⟨ kc_app , scons x (scons y ∅) ⟩ $ by ax
l2: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ l = ⟨ kc_bvar , scons u ∅ ⟩ $ by weaken [#1]
l3: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ ⟨ kc_bvar , scons u ∅ ⟩ = l $ by eq_sym [l2]
l4: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ ⟨ kc_bvar , scons u ∅ ⟩ = ⟨ kc_app , scons x (scons y ∅) ⟩ $ by eq_trans [l3, l1]
l5: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l6: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ isset kc_bvar $ by wcel_isset [l5]
l7: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ isset ∅ $ by ax_empty
l8: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ isset (scons u ∅) $ by scons_set [l7]
l9: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ kc_app ∈ ω $ by kc_app_omega
l10: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ isset kc_app $ by wcel_isset [l9]
l11: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ isset ∅ $ by ax_empty
l12: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ isset (scons y ∅) $ by scons_set [l11]
l13: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ isset (scons x (scons y ∅)) $ by scons_set [l12]
l14: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ kc_bvar = kc_app ∧ scons u ∅ = scons x (scons y ∅) $ by opair_inj_c [l4, l6, l8, l10, l13]
l15: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ kc_bvar = kc_app $ by and_elim_l [l14]
l16: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ ¬ kc_bvar = kc_app $ by kc_bvar_ne_app
l17: $ G , l = ⟨ kc_app , scons x (scons y ∅) ⟩ ⇒ ⊥ $ by not_elim [l16, l15]
l18: $ G , ∃ y (l = ⟨ kc_app , scons x (scons y ∅) ⟩) ⇒ ∃ y (l = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by ax
l19: $ G , ∃ y (l = ⟨ kc_app , scons x (scons y ∅) ⟩) ⇒ ⊥ $ by ex_elim [l18, l17]
l20: $ G , ∃ x ∃ y (l = ⟨ kc_app , scons x (scons y ∅) ⟩) ⇒ ∃ x ∃ y (l = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by ax
l21: $ G , ∃ x ∃ y (l = ⟨ kc_app , scons x (scons y ∅) ⟩) ⇒ ⊥ $ by ex_elim [l20, l19]
l22: $ G ⇒ ¬ ∃ x ∃ y (l = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by not_intro [l21]

lemma d1_rf_cases {f g: set} (G: hyps) (b n e d c j: set):
  $ G ⇒ ra_recfield b n e d c j ∈ lrel $ >
  $ G ⇒ ∃ f ∃ g (c = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ ra_recfield b n e ⟨ kc_s , scons d ∅ ⟩ g j ∈ lrel) ∨ ra_indapp b n e d c j ∈ lrel $
----
l1: $ G ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = x5 ∧ j = x4 ∧ ra_indapp x0 x1 x2 x3 x5 x4 ∈ lrel) $ by lrel_recfield_cases [#1]
l2: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel $ by ax
l3: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ b = x0 $ by and_elim_l [l2]
l4: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel $ by and_elim_r [l2]
l5: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ n = x1 $ by and_elim_l [l4]
l6: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel $ by and_elim_r [l4]
l7: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ e = x2 $ by and_elim_l [l6]
l8: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel $ by and_elim_r [l6]
l9: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ d = x3 $ by and_elim_l [l8]
l10: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel $ by and_elim_r [l8]
l11: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ $ by and_elim_l [l10]
l12: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel $ by and_elim_r [l10]
l13: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ j = x4 $ by and_elim_l [l12]
l14: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel $ by and_elim_r [l12]
l15: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ x0 = b $ by eq_sym [l3]
l16: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ x1 = n $ by eq_sym [l5]
l17: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ x2 = e $ by eq_sym [l7]
l18: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ x3 = d $ by eq_sym [l9]
l19: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ kc_s = kc_s $ by eq_refl
l20: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
l21: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ scons x3 ∅ = scons d ∅ $ by scons_eq [l18, l20]
l22: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ ⟨ kc_s , scons x3 ∅ ⟩ = ⟨ kc_s , scons d ∅ ⟩ $ by opair_eq [l19, l21]
l23: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ x6 = x6 $ by eq_refl
l24: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ x4 = j $ by eq_sym [l13]
l25: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 = ra_recfield b n e ⟨ kc_s , scons d ∅ ⟩ x6 j $ by ra_recfield_eq [l15, l16, l17, l22, l23, l24]
l26: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ ra_recfield b n e ⟨ kc_s , scons d ∅ ⟩ x6 j ∈ lrel $ by wcel_eq_l [l25, l14]
l27: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ ra_recfield b n e ⟨ kc_s , scons d ∅ ⟩ x6 j ∈ lrel $ by and_intro [l11, l26]
l28: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ ∃ g (c = ⟨ kc_pi , scons x5 (scons g ∅) ⟩ ∧ ra_recfield b n e ⟨ kc_s , scons d ∅ ⟩ g j ∈ lrel) $ by ex_intro [l27]
l29: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ ∃ f ∃ g (c = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ ra_recfield b n e ⟨ kc_s , scons d ∅ ⟩ g j ∈ lrel) $ by ex_intro [l28]
l30: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ j = x4 ∧ ra_recfield x0 x1 x2 ⟨ kc_s , scons x3 ∅ ⟩ x6 x4 ∈ lrel ⇒ ∃ f ∃ g (c = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ ra_recfield b n e ⟨ kc_s , scons d ∅ ⟩ g j ∈ lrel) ∨ ra_indapp b n e d c j ∈ lrel $ by or_intro_l [l29]
