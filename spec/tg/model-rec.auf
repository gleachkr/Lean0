c12: $ (ra_ntys t n m ∈ lrel) ⟺ (ra_ntys t n m ∈ lrel) $ by iff_refl
c13: $ (ra_clen p e ∈ lrel) ⟺ (ra_clen p e ∈ lrel) $ by iff_refl
c14: $ fv nvf h ≐ fv nvf h $ by ceqt_refl
c15: $ (fv nvf h = E) ⟺ (fv nvf h = F) $ by ceq_congr [c14, #3]
c16: $ ra_nth_pi C h a ≐ ra_nth_pi D h a $ by ra_nth_pi_congr [#2, c4, c5]
c17: $ (ra_nth_pi C h a ∈ lrel) ⟺ (ra_nth_pi D h a ∈ lrel) $ by wcel_congr [c16, c9]
c18: $ fv nvf i ≐ fv nvf i $ by ceqt_refl
c19: $ (fv nvf i = H) ⟺ (fv nvf i = I) $ by ceq_congr [c18, #4]
c20: $ ra_recfield A n e h a i ≐ ra_recfield B n e h a i $ by ra_recfield_congr [#1, c7, c3, c4, c5, c6]
c21: $ (ra_recfield A n e h a i ∈ lrel) ⟺ (ra_recfield B n e h a i ∈ lrel) $ by wcel_congr [c20, c9]
c22: $ (fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ (fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by and_congr [c19, c21]
c23: $ (ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ (ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by and_congr [c17, c22]
c24: $ (fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ (fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by and_congr [c15, c23]
c25: $ (ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ (ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by and_congr [c13, c24]
c26: $ (ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ (ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by and_congr [c12, c25]
c27: $ (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by and_congr [c11, c26]
c28: $ ∃ i (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ ∃ i (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by ex_congr [c27]
c29: $ ∃ a ∃ i (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ ∃ a ∃ i (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by ex_congr [c28]
c30: $ ∃ h ∃ a ∃ i (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ ∃ h ∃ a ∃ i (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by ex_congr [c29]
c31: $ ∃ e ∃ h ∃ a ∃ i (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ ∃ e ∃ h ∃ a ∃ i (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by ex_congr [c30]
c32: $ ∃ m ∃ e ∃ h ∃ a ∃ i (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ ∃ m ∃ e ∃ h ∃ a ∃ i (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by ex_congr [c31]
c33: $ ∃ n ∃ m ∃ e ∃ h ∃ a ∃ i (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ ∃ n ∃ m ∃ e ∃ h ∃ a ∃ i (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by ex_congr [c32]
c34: $ ∃ t ∃ n ∃ m ∃ e ∃ h ∃ a ∃ i (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ ∃ t ∃ n ∃ m ∃ e ∃ h ∃ a ∃ i (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by ex_congr [c33]
c35: $ ∃ p ∃ t ∃ n ∃ m ∃ e ∃ h ∃ a ∃ i (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = E ∧ ra_nth_pi C h a ∈ lrel ∧ fv nvf i = H ∧ ra_recfield A n e h a i ∈ lrel) ⟺ ∃ p ∃ t ∃ n ∃ m ∃ e ∃ h ∃ a ∃ i (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = F ∧ ra_nth_pi D h a ∈ lrel ∧ fv nvf i = I ∧ ra_recfield B n e h a i ∈ lrel) $ by ex_congr [c34]

sb_f_irf
--------
l1: $ [x/t] (∃ p ∃ y ∃ n ∃ m ∃ e ∃ h ∃ a ∃ i (iprt A p y ∧ ra_ntys y n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = C ∧ ra_nth_pi B h a ∈ lrel ∧ fv nvf i = D ∧ ra_recfield A n e h a i ∈ lrel)) ⟺ ∃ p ∃ y ∃ n ∃ m ∃ e ∃ h ∃ a ∃ i (iprt (⟦ x / t ⟧ A) p y ∧ ra_ntys y n m ∈ lrel ∧ ra_clen p e ∈ lrel ∧ fv nvf h = (⟦ x / t ⟧ C) ∧ ra_nth_pi (⟦ x / t ⟧ B) h a ∈ lrel ∧ fv nvf i = (⟦ x / t ⟧ D) ∧ ra_recfield (⟦ x / t ⟧ A) n e h a i ∈ lrel) $ by iff_refl

inidx_congr
-----------
c1: $ cv i ≐ cv i $ by ceqt_refl
c2: $ cv k ≐ cv k $ by ceqt_refl
c3: $ lrel ≐ lrel $ by ceqt_refl
c4: $ fv nvf i ≐ fv nvf i $ by ceqt_refl
c5: $ (fv nvf i = C) ⟺ (fv nvf i = D) $ by ceq_congr [c4, #2]
c6: $ ra_nidx A i k ≐ ra_nidx B i k $ by ra_nidx_congr [#1, c1, c2]
c7: $ (ra_nidx A i k ∈ lrel) ⟺ (ra_nidx B i k ∈ lrel) $ by wcel_congr [c6, c3]
c8: $ (y ∊ fv nvf k) ⟺ (y ∊ fv nvf k) $ by iff_refl
c9: $ (ra_nidx A i k ∈ lrel ∧ y ∊ fv nvf k) ⟺ (ra_nidx B i k ∈ lrel ∧ y ∊ fv nvf k) $ by and_congr [c7, c8]
c10: $ (fv nvf i = C ∧ ra_nidx A i k ∈ lrel ∧ y ∊ fv nvf k) ⟺ (fv nvf i = D ∧ ra_nidx B i k ∈ lrel ∧ y ∊ fv nvf k) $ by and_congr [c5, c9]
c11: $ ∃ k (fv nvf i = C ∧ ra_nidx A i k ∈ lrel ∧ y ∊ fv nvf k) ⟺ ∃ k (fv nvf i = D ∧ ra_nidx B i k ∈ lrel ∧ y ∊ fv nvf k) $ by ex_congr [c10]
c12: $ ∃ i ∃ k (fv nvf i = C ∧ ra_nidx A i k ∈ lrel ∧ y ∊ fv nvf k) ⟺ ∃ i ∃ k (fv nvf i = D ∧ ra_nidx B i k ∈ lrel ∧ y ∊ fv nvf k) $ by ex_congr [c11]
c13: $ {y | ∃ i ∃ k (fv nvf i = C ∧ ra_nidx A i k ∈ lrel ∧ y ∊ fv nvf k)} ≐ {y | ∃ i ∃ k (fv nvf i = D ∧ ra_nidx B i k ∈ lrel ∧ y ∊ fv nvf k)} $ by cab_congr [c12]

sb_c_inidx
----------
l1: $ (⟦ x / t ⟧ {y | ∃ i ∃ k (fv nvf i = B ∧ ra_nidx A i k ∈ lrel ∧ y ∊ fv nvf k)}) ≐ {y | ∃ i ∃ k (fv nvf i = (⟦ x / t ⟧ B) ∧ ra_nidx (⟦ x / t ⟧ A) i k ∈ lrel ∧ y ∊ fv nvf k)} $ by ceqt_refl

inmin_congr
-----------
c1: $ cv p ≐ cv p $ by ceqt_refl
c2: $ cv t ≐ cv t $ by ceqt_refl
c3: $ iprt A p t ⟺ iprt B p t $ by iprt_congr [#1, c1, c2]
c4: $ (ra_ntys t n m ∈ lrel) ⟺ (ra_ntys t n m ∈ lrel) $ by iff_refl
c5: $ (y ∊ fv nvf m) ⟺ (y ∊ fv nvf m) $ by iff_refl
c6: $ (ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⟺ (ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by and_congr [c4, c5]
c7: $ (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⟺ (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by and_congr [c3, c6]
c8: $ ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⟺ ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ex_congr [c7]
c9: $ ∃ n ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⟺ ∃ n ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ex_congr [c8]
c10: $ ∃ t ∃ n ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⟺ ∃ t ∃ n ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ex_congr [c9]
c11: $ ∃ p ∃ t ∃ n ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⟺ ∃ p ∃ t ∃ n ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ex_congr [c10]
c12: $ {y | ∃ p ∃ t ∃ n ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m)} ≐ {y | ∃ p ∃ t ∃ n ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m)} $ by cab_congr [c11]

sb_c_inmin
----------
l1: $ (⟦ x / t ⟧ {y | ∃ p ∃ u ∃ n ∃ m (iprt A p u ∧ ra_ntys u n m ∈ lrel ∧ y ∊ fv nvf m)}) ≐ {y | ∃ p ∃ u ∃ n ∃ m (iprt (⟦ x / t ⟧ A) p u ∧ ra_ntys u n m ∈ lrel ∧ y ∊ fv nvf m)} $ by ceqt_refl

iminx_congr
-----------
c1: $ cv p ≐ cv p $ by ceqt_refl
c2: $ cv t ≐ cv t $ by ceqt_refl
c3: $ iprt A p t ⟺ iprt B p t $ by iprt_congr [#1, c1, c2]
c4: $ fv nvf a ≐ fv nvf a $ by ceqt_refl
c5: $ fv nvf b ≐ fv nvf b $ by ceqt_refl
c6: $ fv nvf e ≐ fv nvf e $ by ceqt_refl
c7: $ (fv nvf a = C) ⟺ (fv nvf a = D) $ by ceq_congr [c4, #2]
c8: $ (fv nvf b = E) ⟺ (fv nvf b = F) $ by ceq_congr [c5, #3]
c9: $ (fv nvf e = H) ⟺ (fv nvf e = I) $ by ceq_congr [c6, #4]
c10: $ (ra_minor_idx t a b e ∈ lrel) ⟺ (ra_minor_idx t a b e ∈ lrel) $ by iff_refl
c11: $ (fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ (fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by and_congr [c9, c10]
c12: $ (fv nvf b = E ∧ fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ (fv nvf b = F ∧ fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by and_congr [c8, c11]
c13: $ (fv nvf a = C ∧ fv nvf b = E ∧ fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ (fv nvf a = D ∧ fv nvf b = F ∧ fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by and_congr [c7, c12]
c14: $ (iprt A p t ∧ fv nvf a = C ∧ fv nvf b = E ∧ fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ (iprt B p t ∧ fv nvf a = D ∧ fv nvf b = F ∧ fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by and_congr [c3, c13]
c15: $ ∃ e (iprt A p t ∧ fv nvf a = C ∧ fv nvf b = E ∧ fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ ∃ e (iprt B p t ∧ fv nvf a = D ∧ fv nvf b = F ∧ fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by ex_congr [c14]
c16: $ ∃ b ∃ e (iprt A p t ∧ fv nvf a = C ∧ fv nvf b = E ∧ fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ ∃ b ∃ e (iprt B p t ∧ fv nvf a = D ∧ fv nvf b = F ∧ fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by ex_congr [c15]
c17: $ ∃ a ∃ b ∃ e (iprt A p t ∧ fv nvf a = C ∧ fv nvf b = E ∧ fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ ∃ a ∃ b ∃ e (iprt B p t ∧ fv nvf a = D ∧ fv nvf b = F ∧ fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by ex_congr [c16]
c18: $ ∃ t ∃ a ∃ b ∃ e (iprt A p t ∧ fv nvf a = C ∧ fv nvf b = E ∧ fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ ∃ t ∃ a ∃ b ∃ e (iprt B p t ∧ fv nvf a = D ∧ fv nvf b = F ∧ fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by ex_congr [c17]
c19: $ ∃ p ∃ t ∃ a ∃ b ∃ e (iprt A p t ∧ fv nvf a = C ∧ fv nvf b = E ∧ fv nvf e = H ∧ ra_minor_idx t a b e ∈ lrel) ⟺ ∃ p ∃ t ∃ a ∃ b ∃ e (iprt B p t ∧ fv nvf a = D ∧ fv nvf b = F ∧ fv nvf e = I ∧ ra_minor_idx t a b e ∈ lrel) $ by ex_congr [c18]

sb_f_iminx
----------
l1: $ [x/t] (∃ p ∃ y ∃ a ∃ b ∃ e (iprt A p y ∧ fv nvf a = B ∧ fv nvf b = C ∧ fv nvf e = D ∧ ra_minor_idx y a b e ∈ lrel)) ⟺ ∃ p ∃ y ∃ a ∃ b ∃ e (iprt (⟦ x / t ⟧ A) p y ∧ fv nvf a = (⟦ x / t ⟧ B) ∧ fv nvf b = (⟦ x / t ⟧ C) ∧ fv nvf e = (⟦ x / t ⟧ D) ∧ ra_minor_idx y a b e ∈ lrel) $ by iff_refl

itup_congr
----------
c1: $ iprop A C J ⟺ iprop B D K $ by iprop_congr [#1, #2, #5]
c2: $ ¬ iprop A C J ⟺ ¬ iprop B D K $ by not_congr [c1]
c3: $ scons E H ≐ scons F I $ by scons_congr [#3, #4]
c4: $ seqt y y $ by seqt_refl
c5: $ (y ∊ scons E H) ⟺ (y ∊ scons F I) $ by welc_congr [c4, c3]
c6: $ (¬ iprop A C J ∧ y ∊ scons E H) ⟺ (¬ iprop B D K ∧ y ∊ scons F I) $ by and_congr [c2, c5]
c7: $ {y | ¬ iprop A C J ∧ y ∊ scons E H} ≐ {y | ¬ iprop B D K ∧ y ∊ scons F I} $ by cab_congr [c6]

sb_c_itup
---------
l1: $ (⟦ x / t ⟧ {y | ¬ iprop A B E ∧ y ∊ scons C D}) ≐ {y | ¬ iprop (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ E) ∧ y ∊ scons (⟦ x / t ⟧ C) (⟦ x / t ⟧ D)} $ by ceqt_refl

lemma d1_midx_z (G: hyps) (t a b e: set):
  $ G ⇒ ra_minor_idx t a b e ∈ lrel $ > $ G ⇒ fv nvf a = ∅ $ > $ G ⇒ e = b $
----
l1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) $ by lrel_minor_idx_cases [#1]
l2: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 $ by ax
l3: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 $ by and_elim_r [l2]
l5: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ a = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l4]
l6: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ b = x4 ∧ e = x4 $ by and_elim_r [l4]
l7: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ b = x4 $ by and_elim_l [l6]
l8: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ e = x4 $ by and_elim_r [l6]
l9: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ x4 = b $ by eq_sym [l7]
l10: $ G , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_nz , ∅ ⟩ ∧ b = x4 ∧ e = x4 ⇒ e = b $ by eq_trans [l8, l9]
