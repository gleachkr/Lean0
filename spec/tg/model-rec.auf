p0b: $ G , g ∊ fpi q Q B , z ∊ g ⇒ z ∊ g → ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by all_elim [p0]
p1: $ G , g ∊ fpi q Q B , z ∊ g ⇒ z ∊ g $ by ax
p2: $ G , g ∊ fpi q Q B , z ∊ g ⇒ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by imp_elim [p0b, p1]
c1: $ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) ⟺ ∃ a ∃ y (a ∊ Q ∧ z = nest a y) $ by ex_alpha
c2: $ ∃ y (a ∊ Q ∧ z = nest a y) ⟺ ∃ b (a ∊ Q ∧ z = nest a b) $ by ex_alpha
c3: $ ∃ a ∃ y (a ∊ Q ∧ z = nest a y) ⟺ ∃ a ∃ b (a ∊ Q ∧ z = nest a b) $ by ex_congr [c2]
c4: $ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) ⟺ ∃ a ∃ b (a ∊ Q ∧ z = nest a b) $ by iff_trans [c1, c3]
c5: $ G , g ∊ fpi q Q B , z ∊ g ⇒ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) ↔ ∃ a ∃ b (a ∊ Q ∧ z = nest a b) $ by weaken [c4]
p3: $ G , g ∊ fpi q Q B , z ∊ g ⇒ ∃ a ∃ b (a ∊ Q ∧ z = nest a b) $ by bi_elim_l [c5, p2]
a1: $ G , g ∊ fpi q Q B , z ∊ g , a ∊ Q ∧ z = nest a b ⇒ a ∊ Q ∧ z = nest a b $ by ax
a2: $ G , g ∊ fpi q Q B , z ∊ g , a ∊ Q ∧ z = nest a b ⇒ a ∊ Q $ by and_elim_l [a1]
a3: $ G , g ∊ fpi q Q B , z ∊ g , a ∊ Q ∧ z = nest a b ⇒ z = nest a b $ by and_elim_r [a1]
a4: $ G , g ∊ fpi q Q B , z ∊ g , a ∊ Q ∧ z = nest a b ⇒ Q = Q2 $ by weaken [#1]
a5: $ G , g ∊ fpi q Q B , z ∊ g , a ∊ Q ∧ z = nest a b ⇒ a ∊ Q2 $ by welc_eq [a4, a2]
a6: $ G , g ∊ fpi q Q B , z ∊ g , a ∊ Q ∧ z = nest a b ⇒ a ∊ Q2 ∧ z = nest a b $ by and_intro [a5, a3]
a7: $ G , g ∊ fpi q Q B , z ∊ g , a ∊ Q ∧ z = nest a b ⇒ ∃ y (a ∊ Q2 ∧ z = nest a y) $ by ex_intro [a6]
a8: $ G , g ∊ fpi q Q B , z ∊ g , a ∊ Q ∧ z = nest a b ⇒ ∃ q ∃ y (q ∊ Q2 ∧ z = nest q y) $ by ex_intro [a7]
b1: $ G , g ∊ fpi q Q B , z ∊ g , ∃ b (a ∊ Q ∧ z = nest a b) ⇒ ∃ b (a ∊ Q ∧ z = nest a b) $ by ax
b2: $ G , g ∊ fpi q Q B , z ∊ g , ∃ b (a ∊ Q ∧ z = nest a b) ⇒ ∃ q ∃ y (q ∊ Q2 ∧ z = nest q y) $ by ex_elim [b1, a8]
b3: $ G , g ∊ fpi q Q B , z ∊ g ⇒ ∃ q ∃ y (q ∊ Q2 ∧ z = nest q y) $ by ex_elim [p3, b2]
b4: $ G , g ∊ fpi q Q B ⇒ z ∊ g → ∃ q ∃ y (q ∊ Q2 ∧ z = nest q y) $ by imp_intro [b3]
b5: $ G , g ∊ fpi q Q B ⇒ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ Q2 ∧ z = nest q y)) $ by all_intro [b4]
m0: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ a ∊ Q2 $ by ax
m1w: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ Q = Q2 $ by weaken [#1]
m1: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ Q2 = Q $ by eq_sym [m1w]
m2: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ a ∊ Q $ by welc_eq [m1, m0]
m3: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ ∀ q (q ∊ Q → apn g q ∈ B) $ by weaken [u4]
m3b: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ a ∊ Q → apn g a ∈ (⟦ q / a ⟧ B) $ by all_elim [m3]
m4: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ apn g a ∈ (⟦ q / a ⟧ B) $ by imp_elim [m3b, m2]
m5w: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ ∀ q (q ∊ Q → B ⊆ B2) $ by weaken [#2]
m5: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ a ∊ Q → (⟦ q / a ⟧ B) ⊆ (⟦ q / a ⟧ B2) $ by all_elim [m5w]
m6: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ (⟦ q / a ⟧ B) ⊆ (⟦ q / a ⟧ B2) $ by imp_elim [m5, m2]
m7: $ G , g ∊ fpi q Q B , a ∊ Q2 ⇒ apn g a ∈ (⟦ q / a ⟧ B2) $ by wcel_subset [m6, m4]
m8: $ G , g ∊ fpi q Q B ⇒ a ∊ Q2 → apn g a ∈ (⟦ q / a ⟧ B2) $ by imp_intro [m7]
m9: $ G , g ∊ fpi q Q B ⇒ ∀ a (a ∊ Q2 → apn g a ∈ (⟦ q / a ⟧ B2)) $ by all_intro [m8]
m10: $ ∀ q (q ∊ Q2 → apn g q ∈ B2) ⟺ ∀ a (a ∊ Q2 → apn g a ∈ (⟦ q / a ⟧ B2)) $ by all_alpha
m11: $ G , g ∊ fpi q Q B ⇒ ∀ q (q ∊ Q2 → apn g q ∈ B2) ↔ ∀ a (a ∊ Q2 → apn g a ∈ (⟦ q / a ⟧ B2)) $ by weaken [m10]
m12: $ G , g ∊ fpi q Q B ⇒ ∀ q (q ∊ Q2 → apn g q ∈ B2) $ by bi_elim_r [m11, m9]
n0: $ G , g ∊ fpi q Q B ⇒ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ Q2 ∧ z = nest q y)) ∧ ∀ q (q ∊ Q2 → apn g q ∈ B2) $ by and_intro [b5, m12]
n1: $ G , g ∊ fpi q Q B ⇒ g ∊ fpi q Q2 B2 $ by cab_intro [n0]
n2: $ G ⇒ fpi q Q B ⊆ fpi q Q2 B2 $ by subset_intro [n1]

lemma d1_tr_apn {q b y: set} (G: hyps q b y) (A Q: class) (C: class q) (n g a: set):
  $ G ⇒ Q ⊆ fseq A $ > $ G ⇒ ∀ q (q ∊ Q → cdm q = n) $ >
  $ G ⇒ g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ > $ G ⇒ a ∊ Q $ > $ G ⇒ apn g a = (⟦ q / a ⟧ C) $
----
f1: $ G , x0 ∊ apn g a ⇒ x0 ∊ apn g a $ by ax
f2: $ G , x0 ∊ apn g a ⇒ nest a x0 ∈ g $ by cab_elim [f1]
f3: $ G , x0 ∊ apn g a ⇒ g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ by weaken [#3]
f4: $ G , x0 ∊ apn g a ⇒ nest a x0 ∈ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ by wcel_eq_r [f3, f2]
g1: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ by ax
g2: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ w = nest q b) $ by cab_elim [g1]
g3: $ ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ w = nest q b) ⟺ ∃ v ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) $ by ex_alpha
g4: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ w = nest q b) ↔ ∃ v ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) $ by weaken [g3]
g5: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ ∃ v ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) $ by bi_elim_l [g4, g2]
i1: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 $ by ax
i2: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ v ∊ Q $ by and_elim_l [i1]
i2b: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 $ by and_elim_r [i1]
i3: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ x1 ∊ (⟦ q / v ⟧ C) $ by and_elim_l [i2b]
i4: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ w = nest v x1 $ by and_elim_r [i2b]
i5: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ w = nest a x0 $ by ax
i5b: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ nest a x0 = w $ by eq_sym [i5]
i6: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ nest a x0 = nest v x1 $ by eq_trans [i5b, i4]
i7: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ Q ⊆ fseq A $ by weaken [#1]
i8: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ a ∊ Q $ by weaken [#4]
i9: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ a ∊ fseq A $ by subset_elim [i7, i8]
i10: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ v ∊ fseq A $ by subset_elim [i7, i2]
i11: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ ∀ q (q ∊ Q → cdm q = n) $ by weaken [#2]
i12: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ a ∊ Q → cdm a = n $ by all_elim [i11]
i13: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ cdm a = n $ by imp_elim [i12, i8]
i14: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ v ∊ Q → cdm v = n $ by all_elim [i11]
i15: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ cdm v = n $ by imp_elim [i14, i2]
i15b: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ n = cdm v $ by eq_sym [i15]
i16: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ cdm a = cdm v $ by eq_trans [i13, i15b]
i17: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ a = v ∧ x0 = x1 $ by nest_inj [i9, i10, i16, i6]
i18: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ a = v $ by and_elim_l [i17]
i19: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ x0 = x1 $ by and_elim_r [i17]
i20: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ x1 = x0 $ by eq_sym [i19]
i21: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ x0 ∊ (⟦ q / v ⟧ C) $ by welc_eq_set [i20, i3]
i22: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ v = a $ by eq_sym [i18]
i23: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ (⟦ q / v ⟧ C) = (⟦ q / a ⟧ C) $ by sb_c_eq [i22]
i24: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1 ⇒ x0 ∊ (⟦ q / a ⟧ C) $ by welc_eq [i23, i21]
j0: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) ⇒ ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) $ by ax
j1: $ ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) ⟺ ∃ x1 (v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1) $ by ex_alpha
j2: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) ⇒ ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) ↔ ∃ x1 (v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1) $ by weaken [j1]
j3: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) ⇒ ∃ x1 (v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ w = nest v x1) $ by bi_elim_l [j2, j0]
j4: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ w = nest v b) ⇒ x0 ∊ (⟦ q / a ⟧ C) $ by ex_elim [j3, i24]
k1: $ G , x0 ∊ apn g a , w = nest a x0 , w ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ x0 ∊ (⟦ q / a ⟧ C) $ by ex_elim [g5, j4]
k2: $ G , x0 ∊ apn g a ⇒ x0 ∊ (⟦ q / a ⟧ C) $ by wcel_elim [f4, k1]
r1: $ G , x0 ∊ (⟦ q / a ⟧ C) ⇒ isset (nest a x0) $ by nest_set
r2a: $ G , x0 ∊ (⟦ q / a ⟧ C) , w = nest a x0 ⇒ a ∊ Q $ by weaken [#4]
r2b: $ G , x0 ∊ (⟦ q / a ⟧ C) , w = nest a x0 ⇒ x0 ∊ (⟦ q / a ⟧ C) $ by ax
r2c: $ G , x0 ∊ (⟦ q / a ⟧ C) , w = nest a x0 ⇒ w = nest a x0 $ by ax
r2d: $ G , x0 ∊ (⟦ q / a ⟧ C) , w = nest a x0 ⇒ x0 ∊ (⟦ q / a ⟧ C) ∧ w = nest a x0 $ by and_intro [r2b, r2c]
r2e: $ G , x0 ∊ (⟦ q / a ⟧ C) , w = nest a x0 ⇒ a ∊ Q ∧ x0 ∊ (⟦ q / a ⟧ C) ∧ w = nest a x0 $ by and_intro [r2a, r2d]
r2f: $ G , x0 ∊ (⟦ q / a ⟧ C) , w = nest a x0 ⇒ ∃ b (a ∊ Q ∧ b ∊ (⟦ q / a ⟧ C) ∧ w = nest a b) $ by ex_intro [r2e]
r2g: $ G , x0 ∊ (⟦ q / a ⟧ C) , w = nest a x0 ⇒ ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ w = nest q b) $ by ex_intro [r2f]
r3: $ G , x0 ∊ (⟦ q / a ⟧ C) ⇒ nest a x0 ∈ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ by wcel_cab_intro (x := $ y $, z := $ w $, p := $ ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b) $) [r1, r2g]
r4: $ G , x0 ∊ (⟦ q / a ⟧ C) ⇒ g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ by weaken [#3]
r5: $ G , x0 ∊ (⟦ q / a ⟧ C) ⇒ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} = g $ by eq_sym [r4]
r6: $ G , x0 ∊ (⟦ q / a ⟧ C) ⇒ nest a x0 ∈ g $ by wcel_eq_r [r5, r3]
r7: $ G , x0 ∊ (⟦ q / a ⟧ C) ⇒ x0 ∊ apn g a $ by cab_intro [r6]
z1: $ G ⇒ apn g a = (⟦ q / a ⟧ C) $ by eq_intro [k2, r7]

