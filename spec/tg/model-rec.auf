--| The parts of a block are determined by the block.
lemma d3_iprt_det (G: hyps) (D P T: class) (q e: set):
  $ G ⇒ isset D $ > $ G ⇒ isset P $ > $ G ⇒ isset T $ > $ G ⇒ iprt D P T $ > $ G ⇒ iprt D q e $ > $ G ⇒ P = q ∧ T = e $
