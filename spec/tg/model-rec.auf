l121: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel , x5 = K , x6 = K2 , x7 = fv nvf d ⇒ ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 (ra_minor_idx x0 x1 j x2 ∈ lrel → ra_minor_idx x0 x3 y x4 ∈ lrel → fv nvf x2 = fv nvf x4 → d1_bd x0 x1 j → d1_bd x0 x3 y → fv nvf x1 = x7 → fv nvf x1 = fv nvf x3 ∧ fv nvf j = fv nvf y) $ by d1_minj_ind [l51]
l122: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel , x5 = K , x6 = K2 , x7 = fv nvf d ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (ra_minor_idx t x1 j x2 ∈ lrel → ra_minor_idx t x3 y x4 ∈ lrel → fv nvf x2 = fv nvf x4 → d1_bd t x1 j → d1_bd t x3 y → fv nvf x1 = x7 → fv nvf x1 = fv nvf x3 ∧ fv nvf j = fv nvf y) $ by all_elim (t := $ t $) [l121]
l123: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel , x5 = K , x6 = K2 , x7 = fv nvf d ⇒ ∀ x2 ∀ x3 ∀ x4 (ra_minor_idx t d j x2 ∈ lrel → ra_minor_idx t x3 y x4 ∈ lrel → fv nvf x2 = fv nvf x4 → d1_bd t d j → d1_bd t x3 y → fv nvf d = x7 → fv nvf d = fv nvf x3 ∧ fv nvf j = fv nvf y) $ by all_elim (t := $ d $) [l122]
l124: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel , x5 = K , x6 = K2 , x7 = fv nvf d ⇒ ∀ x3 ∀ x4 (ra_minor_idx t d j u ∈ lrel → ra_minor_idx t x3 y x4 ∈ lrel → fv nvf u = fv nvf x4 → d1_bd t d j → d1_bd t x3 y → fv nvf d = x7 → fv nvf d = fv nvf x3 ∧ fv nvf j = fv nvf y) $ by all_elim (t := $ u $) [l123]
