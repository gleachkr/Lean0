lemma d2_ihv_mono0 {e k: set} (G: hyps) (D K L L2 g t: class) (a: set):
  $ G ⇒ L ⊆ L2 $ > $ G ⇒ a ∊ ω $ > $ G ⇒ ∀ e ∀ k (isset (ihsp L2 g t e k)) $ >
  $ G ⇒ ihv D K L g t a ⊆ ihv D K L2 g t a $
----
