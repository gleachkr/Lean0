p3: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g ⇒ z ∊ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ by welc_eq [p2, p1]
p4: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g ⇒ ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ z = nest q b) $ by cab_elim [p3]
p5: $ ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ z = nest q b) ⟺ ∃ v ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) $ by ex_alpha
p6: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g ⇒ ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ z = nest q b) ↔ ∃ v ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) $ by weaken [p5]
p7: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g ⇒ ∃ v ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) $ by bi_elim_l [p6, p4]
q1: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 ⇒ v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 $ by ax
q2: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 ⇒ v ∊ Q $ by and_elim_l [q1]
q3: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 ⇒ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 $ by and_elim_r [q1]
q4: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 ⇒ z = nest v x1 $ by and_elim_r [q3]
q5: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 ⇒ v ∊ Q ∧ z = nest v x1 $ by and_intro [q2, q4]
q6: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 ⇒ ∃ y (v ∊ Q ∧ z = nest v y) $ by ex_intro [q5]
q7: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1 ⇒ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by ex_intro [q6]
q8: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) ⇒ ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) $ by ax
q9: $ ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) ⟺ ∃ x1 (v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1) $ by ex_alpha
q10: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) ⇒ ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) ↔ ∃ x1 (v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1) $ by weaken [q9]
q11: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) ⇒ ∃ x1 (v ∊ Q ∧ x1 ∊ (⟦ q / v ⟧ C) ∧ z = nest v x1) $ by bi_elim_l [q10, q8]
q12: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g , ∃ b (v ∊ Q ∧ b ∊ (⟦ q / v ⟧ C) ∧ z = nest v b) ⇒ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by ex_elim [q11, q7]
q13: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , z ∊ g ⇒ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by ex_elim [p7, q12]
q14: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ z ∊ g → ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by imp_intro [q13]
q15: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ Q ∧ z = nest q y)) $ by all_intro [q14]
s1: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ Q ⊆ fseq A $ by weaken [#1]
s2: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ ∀ q (q ∊ Q → cdm q = n) $ by weaken [#2]
s3: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ by ax
s4: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ v ∊ Q $ by ax
s5: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ apn g v = (⟦ q / v ⟧ C) $ by d1_tr_apn [s1, s2, s3, s4]
s6: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ ∀ q (q ∊ Q → C ∈ B) $ by weaken [#3]
s7: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ v ∊ Q → (⟦ q / v ⟧ C) ∈ (⟦ q / v ⟧ B) $ by all_elim [s6]
s8: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ (⟦ q / v ⟧ C) ∈ (⟦ q / v ⟧ B) $ by imp_elim [s7, s4]
s9: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ (⟦ q / v ⟧ C) = apn g v $ by eq_sym [s5]
s10: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} , v ∊ Q ⇒ apn g v ∈ (⟦ q / v ⟧ B) $ by wcel_eq_l [s9, s8]
s11: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ v ∊ Q → apn g v ∈ (⟦ q / v ⟧ B) $ by imp_intro [s10]
s12: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ ∀ v (v ∊ Q → apn g v ∈ (⟦ q / v ⟧ B)) $ by all_intro [s11]
s13: $ ∀ q (q ∊ Q → apn g q ∈ B) ⟺ ∀ v (v ∊ Q → apn g v ∈ (⟦ q / v ⟧ B)) $ by all_alpha
s14: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ ∀ q (q ∊ Q → apn g q ∈ B) ↔ ∀ v (v ∊ Q → apn g v ∈ (⟦ q / v ⟧ B)) $ by weaken [s13]
s15: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ ∀ q (q ∊ Q → apn g q ∈ B) $ by bi_elim_r [s14, s12]
t1: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ Q ∧ z = nest q y)) ∧ ∀ q (q ∊ Q → apn g q ∈ B) $ by and_intro [q15, s15]
t2: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ g ∊ fpi q Q B $ by cab_intro [t1]
t3: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} $ by ax
t4: $ G , g = {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ⇒ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ∈ fpi q Q B $ by wcel_intro [t3, t2]
t5: $ G ⇒ {y | ∃ q ∃ b (q ∊ Q ∧ b ∊ C ∧ y = nest q b)} ∈ fpi q Q B $ by isset_elim [#4, t4]

vat_eq
------
g1: $ G ⇒ j ∈ ω $ by omega_elem_omega_c [#1, #2]
