c4b: $ G , b ∊ ivals j U N A2 , a ∊ N2 ⇒ b = b $ by eq_refl
c4c: $ G , b ∊ ivals j U N A2 , a ∊ N2 ⇒ a = a $ by eq_refl
c5: $ G , b ∊ ivals j U N A2 , a ∊ N2 ⇒ vat b N a = vat b N2 a $ by vat_eq_args [c4b, c1a, c4c]
c6: $ G , b ∊ ivals j U N A2 , a ∊ N2 ⇒ vat b N2 a ∈ (⟦ j / a ⟧ A2) $ by wcel_eq_l [c5, c4]
c7: $ G , b ∊ ivals j U N A2 ⇒ a ∊ N2 → vat b N2 a ∈ (⟦ j / a ⟧ A2) $ by imp_intro [c6]
