lemma i0_ihsp_sub (G: hyps) (L L2 g g2 t t2 d d2 j j2: class): $ G ⇒ L = L2 $ > $ G ⇒ g = g2 $ > $ G ⇒ t = t2 $ > $ G ⇒ d = d2 $ > $ G ⇒ j = j2 $ > $ G ⇒ ihsp L g t d j ⊆ ihsp L2 g2 t2 d2 j2 $
----
l1: $ G ⇒ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} ⊆ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t2 d2)} $ by i0_ihq_sub [#3, #4]
l2a: $ G ⇒ t2 = t $ by eq_sym [#3]
l2b: $ G ⇒ d2 = d $ by eq_sym [#4]
l2: $ G ⇒ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t2 d2)} ⊆ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} $ by i0_ihq_sub [l2a, l2b]
l3: $ G ⇒ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} = {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t2 d2)} $ by subset_antisym [l1, l2]
l4: $ G ⇒ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⊆ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t2 d2 ∧ y ∊ ap L2 ⟨ j2 , ⟨ e , apn (fv g2 d2) q ⟩ ⟩)} $ by i0_ihb_sub [#1, #2, #3, #4, #5]
l5: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} ⇒ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⊆ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t2 d2 ∧ y ∊ ap L2 ⟨ j2 , ⟨ e , apn (fv g2 d2) q ⟩ ⟩)} $ by weaken [l4]
l6: $ G ⇒ q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} → {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⊆ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t2 d2 ∧ y ∊ ap L2 ⟨ j2 , ⟨ e , apn (fv g2 d2) q ⟩ ⟩)} $ by imp_intro [l5]
l7: $ G ⇒ ∀ q (q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} → {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⊆ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t2 d2 ∧ y ∊ ap L2 ⟨ j2 , ⟨ e , apn (fv g2 d2) q ⟩ ⟩)}) $ by all_intro [l6]
l8: $ G ⇒ ihsp L g t d j ⊆ ihsp L2 g2 t2 d2 j2 $ by fpi_sub [l3, l7]

ihsp_eq
-------
q1: $ G ⇒ ihsp L g t d j ⊆ ihsp L2 g2 t2 d2 j2 $ by i0_ihsp_sub [#1, #2, #3, #4, #5]
qs0: $ G ⇒ L2 = L $ by eq_sym [#1]
qs1: $ G ⇒ g2 = g $ by eq_sym [#2]
qs2: $ G ⇒ t2 = t $ by eq_sym [#3]
qs3: $ G ⇒ d2 = d $ by eq_sym [#4]
qs4: $ G ⇒ j2 = j $ by eq_sym [#5]
q2: $ G ⇒ ihsp L2 g2 t2 d2 j2 ⊆ ihsp L g t d j $ by i0_ihsp_sub [qs0, qs1, qs2, qs3, qs4]
q3: $ G ⇒ ihsp L g t d j = ihsp L2 g2 t2 d2 j2 $ by subset_antisym [q1, q2]

lemma i0_ihY_sub {y i h z x1 x2 x3 x7: set} (G: hyps) (D D2 K K2 L L2 P P2 Q Q2: class) (d s: set): $ G ⇒ D = D2 $ > $ G ⇒ K = K2 $ > $ G ⇒ L = L2 $ > $ G ⇒ P = P2 $ > $ G ⇒ Q = Q2 $ > $ G ⇒ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ s) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ s ∧ h ∊ ihsp L P Q d i ∧ y = scons h z)} ⊆ {x7 | (¬ ∃ x1 (irf D2 K2 d x1) ∧ x7 ∊ s) ∨ ∃ x1 ∃ x2 ∃ x3 (irf D2 K2 d x1 ∧ x3 ∊ s ∧ x2 ∊ ihsp L2 P2 Q2 d x1 ∧ x7 = scons x2 x3)} $
----
c1: $ G , b ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ s) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ s ∧ h ∊ ihsp L P Q d i ∧ y = scons h z)} ⇒ b ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ s) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ s ∧ h ∊ ihsp L P Q d i ∧ y = scons h z)} $ by ax
c2: $ G , b ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ s) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ s ∧ h ∊ ihsp L P Q d i ∧ y = scons h z)} ⇒ (¬ ∃ i (irf D K d i) ∧ b ∊ s) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ s ∧ h ∊ ihsp L P Q d i ∧ b = scons h z) $ by cab_elim [c1]
d0: $ G , irf D K d i ∧ z ∊ s ∧ h ∊ ihsp L P Q d i ∧ b = scons h z ⇒ irf D K d i ∧ z ∊ s ∧ h ∊ ihsp L P Q d i ∧ b = scons h z $ by ax
