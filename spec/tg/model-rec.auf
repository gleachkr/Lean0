g21: $ (∃ i (∃ h (∃ z (((irf A C d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp E H J d i)) ∧ (y = (scons h z))))))))) ⟺ (∃ i (∃ h (∃ z (((irf B D d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp F I K d i)) ∧ (y = (scons h z))))))))) $ by ex_congr [g20]
g22: $ ((((¬ ∃ i ((irf A C d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf A C d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp E H J d i)) ∧ (y = (scons h z)))))))))) ⟺ ((((¬ ∃ i ((irf B D d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf B D d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp F I K d i)) ∧ (y = (scons h z)))))))))) $ by or_congr [g10, g21]
g23: $ ({y | (((¬ ∃ i ((irf A C d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf A C d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp E H J d i)) ∧ (y = (scons h z)))))))))}) ≐ ({y | (((¬ ∃ i ((irf B D d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf B D d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp F I K d i)) ∧ (y = (scons h z)))))))))}) $ by cab_congr [g22]
g24: $ (⟨ (suc d) , {y | (((¬ ∃ i ((irf A C d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf A C d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp E H J d i)) ∧ (y = (scons h z)))))))))} ⟩) ≐ (⟨ (suc d) , {y | (((¬ ∃ i ((irf B D d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf B D d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp F I K d i)) ∧ (y = (scons h z)))))))))} ⟩) $ by opair_congr [g3, g23]
g25: $ (⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf A C d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf A C d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp E H J d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩) ≐ (⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf B D d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf B D d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp F I K d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩) $ by opair_congr [g2, g24]
g26: $ ((w = ⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf A C d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf A C d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp E H J d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩)) ⟺ ((w = ⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf B D d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf B D d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp F I K d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩)) $ by ceq_congr [g1, g25]
g27: $ (∃ m ((w = ⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf A C d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf A C d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp E H J d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩))) ⟺ (∃ m ((w = ⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf B D d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf B D d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp F I K d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩))) $ by ex_congr [g26]
g28: $ (∃ d (∃ m ((w = ⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf A C d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf A C d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp E H J d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩)))) ⟺ (∃ d (∃ m ((w = ⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf B D d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf B D d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp F I K d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩)))) $ by ex_congr [g27]
g29: $ ihst A C E H J ≐ ihst B D F I K $ by cab_congr [g28]

sb_c_ihst
---------
l1: $ (⟦ x / t ⟧ {w | ∃ d (∃ m ((w = ⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf A B d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf A B d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp C D E d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩)))}) ≐ {w | ∃ d (∃ m ((w = ⟨ ⟨ d , m ⟩ , ⟨ (suc d) , {y | (((¬ ∃ i ((irf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) d i))) ∧ (y ∊ m)) ∨ ∃ i (∃ h (∃ z (((irf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) d i) ∧ ((z ∊ m) ∧ ((h ∊ (ihsp (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) d i)) ∧ (y = (scons h z)))))))))} ⟩ ⟩)))} $ by ceqt_refl

ihv_congr
---------
g1: $ (⟨ ∅ , (csn ∅) ⟩) ≐ (⟨ ∅ , (csn ∅) ⟩) $ by ceqt_refl
g2: $ ((ihst A C E H J)) ≐ ((ihst B D F I K)) $ by ihst_congr [#1, #2, #3, #4, #5]
g3: $ ((omrec ⟨ ∅ , (csn ∅) ⟩ (ihst A C E H J))) ≐ ((omrec ⟨ ∅ , (csn ∅) ⟩ (ihst B D F I K))) $ by omrec_congr [g1, g2]
g4: $ ((fv (omrec ⟨ ∅ , (csn ∅) ⟩ (ihst A C E H J)) L)) ≐ ((fv (omrec ⟨ ∅ , (csn ∅) ⟩ (ihst B D F I K)) N)) $ by fv_congr [g3, #6]
g5: $ ((csn (fv (omrec ⟨ ∅ , (csn ∅) ⟩ (ihst A C E H J)) L))) ≐ ((csn (fv (omrec ⟨ ∅ , (csn ∅) ⟩ (ihst B D F I K)) N))) $ by csn_congr [g4]
g6: $ ((crn (csn (fv (omrec ⟨ ∅ , (csn ∅) ⟩ (ihst A C E H J)) L)))) ≐ ((crn (csn (fv (omrec ⟨ ∅ , (csn ∅) ⟩ (ihst B D F I K)) N)))) $ by crn_congr [g5]
g7: $ ihv A C E H J L ≐ ihv B D F I K N $ by cuni_congr [g6]

sb_c_ihv
--------
l1: $ (⟦ x / t ⟧ (⋃ (crn (csn (fv (omrec ⟨ ∅ , (csn ∅) ⟩ (ihst A B C D E)) F))))) ≐ (⋃ (crn (csn (fv (omrec ⟨ ∅ , (csn ∅) ⟩ (ihst (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E))) (⟦ x / t ⟧ F))))) $ by ceqt_refl

lemma d2_imgn {w q y: set} (G: hyps) (S H: class):
  $ G ⇒ isset S $ > $ G ⇒ isset H $ > $ G ⇒ isset {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} $
----
g1: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ y ∊ S ∧ q ∊ H ∧ o = nest q y $ by ax
g2: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ y ∊ S $ by and_elim_l [g1]
g3: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ q ∊ H ∧ o = nest q y $ by and_elim_r [g1]
g4: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ q ∊ H $ by and_elim_l [g3]
g5: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ o = nest q y $ by and_elim_r [g3]
g6: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ ⟨ y , o ⟩ ∈ cgr k (nest q k) $ by cgr_intro (B := $ nest q k $) [g5]
g7: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ o ∊ img (cgr k (nest q k)) S $ by img_intro [g2, g6]
g8: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ functional (cgr k (nest q k)) $ by cgr_functional
g9: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ isset S $ by weaken [#1]
g10: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ isset (img (cgr k (nest q k)) S) $ by img_set [g8, g9]
g11: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y , c = img (cgr k (nest q k)) S ⇒ c = img (cgr k (nest q k)) S $ by ax
g12: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y , c = img (cgr k (nest q k)) S ⇒ ⟨ q , c ⟩ ∈ cgr l (img (cgr k (nest l k)) S) $ by cgr_intro (B := $ img (cgr k (nest l k)) S $) [g11]
g13: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y , c = img (cgr k (nest q k)) S ⇒ q ∊ H $ by weaken [g4]
g14: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y , c = img (cgr k (nest q k)) S ⇒ c ∊ img (cgr l (img (cgr k (nest l k)) S)) H $ by img_intro [g13, g12]
g15: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y , c = img (cgr k (nest q k)) S ⇒ img (cgr k (nest q k)) S = c $ by eq_sym [g11]
g16: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y , c = img (cgr k (nest q k)) S ⇒ o ∊ img (cgr k (nest q k)) S $ by weaken [g7]
g17: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y , c = img (cgr k (nest q k)) S ⇒ o ∊ c $ by welc_eq [g15, g16]
g18: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y , c = img (cgr k (nest q k)) S ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (nest l k)) S)) H) $ by cuni_intro [g17, g14]
g19: $ G , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (nest l k)) S)) H) $ by isset_elim [g10, g18]
g24: $ G , o ∊ {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} ⇒ o ∊ {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} $ by ax
g25: $ G , o ∊ {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} ⇒ ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ o = nest q y) $ by cab_elim [g24]
g19w: $ G , o ∊ {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} , y ∊ S ∧ q ∊ H ∧ o = nest q y ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (nest l k)) S)) H) $ by weaken [g19]
q1a: $ G , o ∊ {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} , ∃ y (y ∊ S ∧ q ∊ H ∧ o = nest q y) ⇒ ∃ y (y ∊ S ∧ q ∊ H ∧ o = nest q y) $ by ax
q1b: $ G , o ∊ {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} , ∃ y (y ∊ S ∧ q ∊ H ∧ o = nest q y) ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (nest l k)) S)) H) $ by ex_elim [q1a, g19w]
q0: $ G , o ∊ {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (nest l k)) S)) H) $ by ex_elim [g25, q1b]
g27: $ G ⇒ {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} ⊆ ⋃ (img (cgr l (img (cgr k (nest l k)) S)) H) $ by subset_intro [q0]
g28: $ G ⇒ functional (cgr l (img (cgr k (nest l k)) S)) $ by cgr_functional
g29: $ G ⇒ isset (img (cgr l (img (cgr k (nest l k)) S)) H) $ by img_set [g28, #2]
g30: $ G ⇒ isset (⋃ (img (cgr l (img (cgr k (nest l k)) S)) H)) $ by cuni_set [g29]
g31: $ G ⇒ isset {w | ∃ q ∃ y (y ∊ S ∧ q ∊ H ∧ w = nest q y)} $ by subset_isset [g30, g27]

lemma d2_apset {a: set} (G: hyps) (L A: class): $ G ⇒ ∀ a (isset (ap L a)) $ > $ G ⇒ isset A $ > $ G ⇒ isset (ap L A) $
----
p1: $ G , r = A ⇒ ∀ a (isset (ap L a)) $ by weaken [#1]
p2: $ G , r = A ⇒ isset (ap L r) $ by all_elim [p1]
p3: $ G , r = A ⇒ L = L $ by eq_refl
p4: $ G , r = A ⇒ r = A $ by ax
p5: $ G , r = A ⇒ ap L r = ap L A $ by ap_eq [p3, p4]
p6: $ G , r = A ⇒ isset (ap L A) $ by isset_eq [p5, p2]
p7: $ G ⇒ isset (ap L A) $ by isset_elim [#2, p6]

lemma d2_vset {x1 x2 x3 x4 x5 a: set} (G: hyps) (L g d j: class) (k: set):
  $ G ⇒ ∀ a (isset (ap L a)) $ > $ G ⇒ isset {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} $
----
e0: $ G ⇒ ∃ u ∃ v ∃ m ∃ n (k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩) ∨ ¬ ∃ u ∃ v ∃ m ∃ n (k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩) $ by excluded_middle
a1: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ ⇒ isset ⟨ j , ⟨ n , apn (fv g d) u ⟩ ⟩ $ by opair_isset
a2: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ ⇒ ∀ a (isset (ap L a)) $ by weaken [#1]
a3: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ ⇒ isset (ap L ⟨ j , ⟨ n , apn (fv g d) u ⟩ ⟩) $ by d2_apset [a2, a1]
b1: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} ⇒ o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} $ by ax
b2: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩) $ by cab_elim [b1]
c1: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} , k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ ⇒ k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ $ by ax
c2: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} , k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ ⇒ k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ $ by and_elim_l [c1]
c3: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} , k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ ⇒ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ $ by and_elim_r [c1]
c4: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} , k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ ⇒ k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ $ by ax
c5: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} , k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ ⇒ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ = k $ by eq_sym [c2]
c6: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} , k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ ⇒ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ $ by eq_trans [c5, c4]
i1: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} , k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ ⇒ isset x1 $ by isset_var
i3: $ G , k = ⟨ u , ⟨ v , ⟨ m , n ⟩ ⟩ ⟩ , o ∊ {x5 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 (k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ x5 ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩)} , k = ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∧ o ∊ ap L ⟨ j , ⟨ x4 , apn (fv g d) x1 ⟩ ⟩ ⇒ isset u $ by isset_var
