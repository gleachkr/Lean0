l55: $ G , fv nvf n = fv nvf a ∧ ra_nth_ty t n o q ∈ lrel ∧ fv nvf m = fv nvf b ∧ ra_nth_ctor q m k ∈ lrel , t = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_s , scons x6 ∅ ⟩ ∧ o = x1 ∧ q = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel ⇒ fv nvf b ∈ fv nvf l $ by bot_elim [l54]
l56: $ G , fv nvf n = fv nvf a ∧ ra_nth_ty t n o q ∈ lrel ∧ fv nvf m = fv nvf b ∧ ra_nth_ctor q m k ∈ lrel , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ o = x1 ∧ q = x2 ⇒ ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ = t $ by eq_sym [l11]
l57: $ G , fv nvf n = fv nvf a ∧ ra_nth_ty t n o q ∈ lrel ∧ fv nvf m = fv nvf b ∧ ra_nth_ctor q m k ∈ lrel , t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ∧ o = x1 ∧ q = x2 ⇒ t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ $ by weaken [#2]
