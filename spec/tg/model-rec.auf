lemma d1_minj_step {x0 x1 x2 x3 x4: set} (G: hyps x0 x1 x2 x3 x4) (b v y t a e u w: set):
  $ G ⇒ ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 (ra_minor_idx x0 x1 b x2 ∈ lrel → ra_minor_idx x0 x3 v x4 ∈ lrel → fv nvf x2 = fv nvf x4 → d1_bd x0 x1 b → d1_bd x0 x3 v → fv nvf x1 = y → fv nvf x1 = fv nvf x3 ∧ fv nvf b = fv nvf v) $ > $ G ⇒ ra_minor_idx t a b e ∈ lrel $ > $ G ⇒ ra_minor_idx t u v w ∈ lrel $ > $ G ⇒ fv nvf e = fv nvf w $ >
  $ G ⇒ d1_bd t a b $ > $ G ⇒ d1_bd t u v $ > $ G ⇒ fv nvf a = suc y $ > $ G ⇒ fv nvf a = fv nvf u ∧ fv nvf b = fv nvf v $
----
l1: $ G ⇒ ∃ f ∃ g ∃ h ∃ j ∃ k ∃ l (t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ ∧ fv nvf j = y ∧ ra_clen_c g l ∈ lrel ∧ ra_minor_idx h j b k ∈ lrel ∧ ra_add l k e ∈ lrel) $ by d1_midx_s [#2, #7]
l2: $ G , t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ ∧ fv nvf j = y ∧ ra_clen_c g l ∈ lrel ∧ ra_minor_idx h j b k ∈ lrel ∧ ra_add l k e ∈ lrel ⇒ t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ ∧ fv nvf j = y ∧ ra_clen_c g l ∈ lrel ∧ ra_minor_idx h j b k ∈ lrel ∧ ra_add l k e ∈ lrel $ by ax
