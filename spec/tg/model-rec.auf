l29: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x2 ∊ trees ω ∧ x4 ∊ trees ω ∧ x1 ∊ trees ω $ by lrel_args3 [l26, l28]
l30: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x4 ∊ trees ω ∧ x1 ∊ trees ω $ by and_elim_r [l29]
l31: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x4 ∊ trees ω $ by and_elim_l [l30]
l32: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x4 ∈ trees ω $ by welc_wcel [l31]
l33: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ fv nvf ⟨ kc_s , scons x4 ∅ ⟩ = suc (fv nvf x4) $ by nvf_s [l32]
l34: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l35: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ fv nvf h = fv nvf ⟨ kc_s , scons x4 ∅ ⟩ $ by fv_eq [l34, l23]
l36: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ fv nvf h = suc (fv nvf x4) $ by eq_trans [l35, l33]
l37: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ suc (fv nvf x4) = fv nvf h $ by eq_sym [l36]
l38: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ fv nvf h = suc y $ by weaken [#2]
l39: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ suc (fv nvf x4) = suc y $ by eq_trans [l37, l38]
l40: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ functional nvf $ by nvf_functional
l41: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset (fv nvf x4) $ by fv_set [l40]
l42: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ isset y $ by isset_var
l43: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ fv nvf x4 = y $ by suc_inj_c [l41, l42, l39]
l44: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x2 = x2 $ by eq_refl
l45: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x4 = x4 $ by eq_refl
l46: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ x1 = a $ by eq_sym [l25]
l47: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ra_nth_ctor x2 x4 x1 = ra_nth_ctor x2 x4 a $ by ra_nth_ctor_eq [l44, l45, l46]
l48: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ra_nth_ctor x2 x4 a ∈ lrel $ by wcel_eq_l [l47, l26]
l49: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ fv nvf x4 = y ∧ ra_nth_ctor x2 x4 a ∈ lrel $ by and_intro [l43, l48]
l50: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ fv nvf x4 = y ∧ ra_nth_ctor x2 x4 a ∈ lrel $ by and_intro [l21, l49]
l51: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ∃ j (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor x2 j a ∈ lrel) $ by ex_intro [l50]
l52: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ∃ g ∃ j (t = ⟨ kc_ccons , scons x3 (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $ by ex_intro [l51]
l53: $ G , t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $ by ex_intro [l52]
l54: $ G , ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l55: $ G , ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $ by ex_elim [l54, l53]
l56: $ G , ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l57: $ G , ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $ by ex_elim [l56, l55]
l58: $ G , ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l59: $ G , ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $ by ex_elim [l58, l57]
l60: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l61: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $ by ex_elim [l60, l59]
l62: $ G ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $ by or_elim [l1, l19, l61]

lemma d1_clenc_cons {q: set} (G: hyps) (t l f g: set):
  $ G ⇒ ra_clen_c t l ∈ lrel $ > $ G ⇒ t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ $ > $ G ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $
----
l1: $ G ⇒ (t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) $ by lrel_clen_c_cases [#1]
l2: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ t = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_cnil , ∅ ⟩ = t $ by eq_sym [l3]
l5: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ $ by weaken [#2]
l6: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_cnil , ∅ ⟩ = ⟨ kc_ccons , scons f (scons g ∅) ⟩ $ by eq_trans [l4, l5]
l7: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cnil ∈ ω $ by kc_cnil_omega
l8: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_cnil $ by wcel_isset [l7]
l9: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
l11: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_ccons $ by wcel_isset [l10]
l12: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l13: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons g ∅) $ by scons_set [l12]
l14: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ isset (scons f (scons g ∅)) $ by scons_set [l13]
l15: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cnil = kc_ccons ∧ ∅ = scons f (scons g ∅) $ by opair_inj_c [l6, l8, l9, l11, l14]
l16: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cnil = kc_ccons $ by and_elim_l [l15]
l17: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_cnil = kc_ccons $ by kc_cnil_ne_ccons
l18: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ ⊥ $ by not_elim [l17, l16]
l19: $ G , t = ⟨ kc_cnil , ∅ ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $ by bot_elim [l18]
l20: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel $ by ax
l21: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l20]
l22: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel $ by and_elim_r [l20]
l23: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ l = ⟨ kc_s , scons x3 ∅ ⟩ $ by and_elim_l [l22]
l24: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ ra_clen_c x2 x3 ∈ lrel $ by and_elim_r [l22]
l25: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ = t $ by eq_sym [l21]
l26: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ $ by weaken [#2]
l27: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ = ⟨ kc_ccons , scons f (scons g ∅) ⟩ $ by eq_trans [l25, l26]
l28: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
l29: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ isset kc_ccons $ by wcel_isset [l28]
l30: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ x1 = f ∧ x2 = g $ by node2_inj [l29, l27]
l31: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ x2 = g $ by and_elim_r [l30]
l32: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ x3 = x3 $ by eq_refl
l33: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ ra_clen_c x2 x3 = ra_clen_c g x3 $ by ra_clen_c_eq [l31, l32]
l34: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ ra_clen_c g x3 ∈ lrel $ by wcel_eq_l [l33, l24]
l35: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c g x3 ∈ lrel $ by and_intro [l23, l34]
l36: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $ by ex_intro [l35]
l37: $ G , ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) $ by ax
l38: $ G , ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $ by ex_elim [l37, l36]
l39: $ G , ∃ x2 ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ x2 ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) $ by ax
l40: $ G , ∃ x2 ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $ by ex_elim [l39, l38]
l41: $ G , ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) $ by ax
l42: $ G , ∃ x1 ∃ x2 ∃ x3 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ l = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $ by ex_elim [l41, l40]
l43: $ G ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $ by or_elim [l1, l19, l42]

lemma d1_ctl_base (G: hyps) (t m k l z: set):
  $ G ⇒ z = ∅ $ > $ G ⇒ ra_nth_ctor t m k ∈ lrel $ > $ G ⇒ ra_clen_c t l ∈ lrel → fv nvf m = z → fv nvf m ∈ fv nvf l $
----
l1: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ fv nvf m = z $ by ax
l2: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ z = ∅ $ by weaken [#1]
l3: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ fv nvf m = ∅ $ by eq_trans [l1, l2]
l4: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ ra_nth_ctor t m k ∈ lrel $ by weaken [#2]
l5: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ ∃ f ∃ g (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f) $ by d1_nctor_z [l4, l3]
l6: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f ⇒ t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f $ by ax
l7: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f ⇒ t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ $ by and_elim_l [l6]
l8: $ G , ra_clen_c t l ∈ lrel ⇒ ra_clen_c t l ∈ lrel $ by ax
l9: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ ra_clen_c t l ∈ lrel $ by weaken [l8]
l10: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ ra_clen_c t l ∈ lrel ∧ fv nvf m = z $ by and_intro [l9, l1]
l11: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ ra_clen_c t l ∈ lrel $ by and_elim_l [l10]
l12: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f ⇒ ra_clen_c t l ∈ lrel $ by weaken [l11]
l13: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $ by d1_clenc_cons [l12, l7]
l14: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel $ by ax
l15: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ l = ⟨ kc_s , scons q ∅ ⟩ $ by and_elim_l [l14]
l16: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ra_clen_c g q ∈ lrel $ by and_elim_r [l14]
l17: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ kr_clen_c ∈ ω $ by kr_clen_c_omega
l18: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ isset kr_clen_c $ by wcel_isset [l17]
l19: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ g ∊ trees ω ∧ q ∊ trees ω $ by lrel_args2 [l16, l18]
l20: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ q ∊ trees ω $ by and_elim_r [l19]
l21: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ q ∈ trees ω $ by welc_wcel [l20]
l22: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf ⟨ kc_s , scons q ∅ ⟩ = suc (fv nvf q) $ by nvf_s [l21]
l23: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ nvf = nvf $ by eq_refl
l24: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf l = fv nvf ⟨ kc_s , scons q ∅ ⟩ $ by fv_eq [l23, l15]
l25: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf l = suc (fv nvf q) $ by eq_trans [l24, l22]
l26: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ isset q $ by isset_var
l27: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf q ∈ ω $ by nvf_omega [l26]
l28: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ∅ ∈ suc (fv nvf q) $ by nzero_lt_suc_c [l27]
l29: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ suc (fv nvf q) = fv nvf l $ by eq_sym [l25]
l30: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ∅ ∈ fv nvf l $ by wcel_eq_r [l29, l28]
l31: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf m = ∅ $ by weaken [l3]
l32: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ∅ = fv nvf m $ by eq_sym [l31]
l33: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf m ∈ fv nvf l $ by wcel_eq_l [l32, l30]
l34: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f ⇒ fv nvf m ∈ fv nvf l $ by ex_elim [l13, l33]
l35: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , ∃ g (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f) ⇒ ∃ g (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f) $ by ax
l36: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , ∃ g (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ k = f) ⇒ fv nvf m ∈ fv nvf l $ by ex_elim [l35, l34]
l37: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ fv nvf m ∈ fv nvf l $ by ex_elim [l5, l36]
l38: $ G , ra_clen_c t l ∈ lrel ⇒ fv nvf m = z → fv nvf m ∈ fv nvf l $ by imp_intro [l37]
l39: $ G ⇒ ra_clen_c t l ∈ lrel → fv nvf m = z → fv nvf m ∈ fv nvf l $ by imp_intro [l38]

lemma d1_ctl_step {x5 x6 x7 x8: set} (G: hyps x5 x6 x7 x8) (t m k l y z: set):
  $ G ⇒ ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_nth_ctor x5 x6 x7 ∈ lrel → ra_clen_c x5 x8 ∈ lrel → fv nvf x6 = y → fv nvf x6 ∈ fv nvf x8) $ > $ G ⇒ z = suc y $ > $ G ⇒ ra_nth_ctor t m k ∈ lrel $ >
  $ G ⇒ ra_clen_c t l ∈ lrel → fv nvf m = z → fv nvf m ∈ fv nvf l $
----
l1: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ fv nvf m = z $ by ax
l2: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ z = suc y $ by weaken [#2]
l3: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ fv nvf m = suc y $ by eq_trans [l1, l2]
l4: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ ra_nth_ctor t m k ∈ lrel $ by weaken [#3]
l5: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel) $ by d1_nctor_s [l4, l3]
l6: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel ⇒ t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel $ by ax
l7: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel ⇒ t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ $ by and_elim_l [l6]
l8: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel ⇒ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel $ by and_elim_r [l6]
l9: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel ⇒ fv nvf j = y $ by and_elim_l [l8]
l10: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel ⇒ ra_nth_ctor g j k ∈ lrel $ by and_elim_r [l8]
l11: $ G , ra_clen_c t l ∈ lrel ⇒ ra_clen_c t l ∈ lrel $ by ax
l12: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel ⇒ ra_clen_c t l ∈ lrel $ by weaken [l11]
l13: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel ⇒ ∃ q (l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel) $ by d1_clenc_cons [l12, l7]
l14: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel $ by ax
l15: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ l = ⟨ kc_s , scons q ∅ ⟩ $ by and_elim_l [l14]
l16: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ra_clen_c g q ∈ lrel $ by and_elim_r [l14]
l17: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ kr_clen_c ∈ ω $ by kr_clen_c_omega
l18: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ isset kr_clen_c $ by wcel_isset [l17]
l19: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ g ∊ trees ω ∧ q ∊ trees ω $ by lrel_args2 [l16, l18]
l20: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ q ∊ trees ω $ by and_elim_r [l19]
l21: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ q ∈ trees ω $ by welc_wcel [l20]
l22: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf ⟨ kc_s , scons q ∅ ⟩ = suc (fv nvf q) $ by nvf_s [l21]
l23: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ nvf = nvf $ by eq_refl
l24: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf l = fv nvf ⟨ kc_s , scons q ∅ ⟩ $ by fv_eq [l23, l15]
l25: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf l = suc (fv nvf q) $ by eq_trans [l24, l22]
l26: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_nth_ctor x5 x6 x7 ∈ lrel → ra_clen_c x5 x8 ∈ lrel → fv nvf x6 = y → fv nvf x6 ∈ fv nvf x8) $ by weaken [#1]
l27: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ∀ x6 ∀ x7 ∀ x8 (ra_nth_ctor g x6 x7 ∈ lrel → ra_clen_c g x8 ∈ lrel → fv nvf x6 = y → fv nvf x6 ∈ fv nvf x8) $ by all_elim (t := $ g $) [l26]
l28: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ∀ x7 ∀ x8 (ra_nth_ctor g j x7 ∈ lrel → ra_clen_c g x8 ∈ lrel → fv nvf j = y → fv nvf j ∈ fv nvf x8) $ by all_elim (t := $ j $) [l27]
l29: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ∀ x8 (ra_nth_ctor g j k ∈ lrel → ra_clen_c g x8 ∈ lrel → fv nvf j = y → fv nvf j ∈ fv nvf x8) $ by all_elim (t := $ k $) [l28]
l30: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ra_nth_ctor g j k ∈ lrel → ra_clen_c g q ∈ lrel → fv nvf j = y → fv nvf j ∈ fv nvf q $ by all_elim (t := $ q $) [l29]
l31: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ra_nth_ctor g j k ∈ lrel $ by weaken [l10]
l32: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf j = y $ by weaken [l9]
l33: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ ra_clen_c g q ∈ lrel → fv nvf j = y → fv nvf j ∈ fv nvf q $ by imp_elim [l30, l31]
l34: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf j = y → fv nvf j ∈ fv nvf q $ by imp_elim [l33, l16]
l35: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf j ∈ fv nvf q $ by imp_elim [l34, l32]
l36: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ isset q $ by isset_var
l37: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf q ∈ ω $ by nvf_omega [l36]
l38: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ suc (fv nvf j) ∈ suc (fv nvf q) $ by omega_suc_mono_c [l37, l35]
l39: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ suc (fv nvf j) = suc y $ by suc_eq [l32]
l40: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf m = suc y $ by weaken [l3]
l41: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ suc y = fv nvf m $ by eq_sym [l40]
l42: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ suc (fv nvf j) = fv nvf m $ by eq_trans [l39, l41]
l43: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf m ∈ suc (fv nvf q) $ by wcel_eq_l [l42, l38]
l44: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ suc (fv nvf q) = fv nvf l $ by eq_sym [l25]
l45: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel , l = ⟨ kc_s , scons q ∅ ⟩ ∧ ra_clen_c g q ∈ lrel ⇒ fv nvf m ∈ fv nvf l $ by wcel_eq_r [l44, l43]
l46: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel ⇒ fv nvf m ∈ fv nvf l $ by ex_elim [l13, l45]
l47: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel) ⇒ ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel) $ by ax
l48: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel) ⇒ fv nvf m ∈ fv nvf l $ by ex_elim [l47, l46]
l49: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel) ⇒ ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel) $ by ax
l50: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z , ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j k ∈ lrel) ⇒ fv nvf m ∈ fv nvf l $ by ex_elim [l49, l48]
l51: $ G , ra_clen_c t l ∈ lrel , fv nvf m = z ⇒ fv nvf m ∈ fv nvf l $ by ex_elim [l5, l50]
l52: $ G , ra_clen_c t l ∈ lrel ⇒ fv nvf m = z → fv nvf m ∈ fv nvf l $ by imp_intro [l51]
l53: $ G ⇒ ra_clen_c t l ∈ lrel → fv nvf m = z → fv nvf m ∈ fv nvf l $ by imp_intro [l52]

lemma d1_ctor_lt_ind {x5 x6 x7 x8: set} (G: hyps) (n: set):
  $ G ⇒ n ∊ ω $ > $ G ⇒ ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_nth_ctor x5 x6 x7 ∈ lrel → ra_clen_c x5 x8 ∈ lrel → fv nvf x6 = n → fv nvf x6 ∈ fv nvf x8) $
----
l1: $ G , z = ∅ ⇒ z = ∅ $ by ax
l2: $ G , z = ∅ , ra_nth_ctor x0 x1 x2 ∈ lrel ⇒ ra_nth_ctor x0 x1 x2 ∈ lrel $ by ax
l3: $ G , z = ∅ , ra_nth_ctor x0 x1 x2 ∈ lrel ⇒ z = ∅ $ by weaken [l1]
