s10: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ m ⊆ n $ by subset_eq_r [s8, s9]
s11: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ L ⊆ L2 $ by weaken [#1]
s12: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} ⊆ {y | (¬ ∃ i (irf D K v i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ n ∧ h ∊ ihsp L2 g t v i ∧ y = scons h z)} $ by d2_ymono [s11, s10]
s13: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ∀ e ∀ k (isset (ihsp L2 g t e k)) $ by weaken [#3]
s14: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ isset {y | (¬ ∃ i (irf D K v i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ n ∧ h ∊ ihsp L2 g t v i ∧ y = scons h z)} $ by d2_yset [s13]
s15: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ isset {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} $ by subset_isset [s14, s12]
s16: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ isset v $ by isset_var
s17: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ isset (suc v) $ by suc_set [s16]
s18: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ⋃ (crn (csn ⟨ suc v , {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} ⟩)) = {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} $ by cuni_crn_csn_c [s17, s15]
s19: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ⋃ (crn (csn ⟨ suc v , {y | (¬ ∃ i (irf D K v i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ n ∧ h ∊ ihsp L2 g t v i ∧ y = scons h z)} ⟩)) = {y | (¬ ∃ i (irf D K v i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ n ∧ h ∊ ihsp L2 g t v i ∧ y = scons h z)} $ by cuni_crn_csn_c [s17, s14]
s20: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ihv D K L g t (suc v) = {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} $ by eq_trans [s4, s18]
s21: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ihv D K L2 g t (suc v) = {y | (¬ ∃ i (irf D K v i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ n ∧ h ∊ ihsp L2 g t v i ∧ y = scons h z)} $ by eq_trans [s5, s19]
s22: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} = ihv D K L g t (suc v) $ by eq_sym [s20]
s23: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ {y | (¬ ∃ i (irf D K v i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ n ∧ h ∊ ihsp L2 g t v i ∧ y = scons h z)} = ihv D K L2 g t (suc v) $ by eq_sym [s21]
s24: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ihv D K L g t (suc v) ⊆ {y | (¬ ∃ i (irf D K v i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ n ∧ h ∊ ihsp L2 g t v i ∧ y = scons h z)} $ by subset_eq_l [s22, s12]
s25: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ihv D K L g t (suc v) ⊆ ihv D K L2 g t (suc v) $ by subset_eq_r [s23, s24]
s26: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ u = suc v $ by ax
s27: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ suc v = u $ by eq_sym [s26]
s28: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ihv D K L g t (suc v) = ihv D K L g t u $ by ihv_eq_arg [s27]
s29: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ihv D K L2 g t (suc v) = ihv D K L2 g t u $ by ihv_eq_arg [s27]
s30: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ihv D K L g t u ⊆ ihv D K L2 g t (suc v) $ by subset_eq_l [s28, s25]
s31: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v , n = ihv D K L2 g t v ⇒ ihv D K L g t u ⊆ ihv D K L2 g t u $ by subset_eq_r [s29, s30]
s32: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v ⇒ isset (ihv D K L2 g t v) $ by d2_ihvs
s33: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v , m = ihv D K L g t v ⇒ ihv D K L g t u ⊆ ihv D K L2 g t u $ by isset_elim [s32, s31]
s34: $ G , v ∊ ω , ihv D K L g t v ⊆ ihv D K L2 g t v , u = suc v ⇒ isset (ihv D K L g t v) $ by d2_ihvs
