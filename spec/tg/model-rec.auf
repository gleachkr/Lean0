lemma d2_irf_ex {i: set} (G: hyps i) (D K d j: class): $ G ⇒ irf D K d j $ > $ G ⇒ ∃ i (irf D K d i) $
----
s1: $ G ⇒ isset j $ by irf_set [#1]
s2: $ G , u = j ⇒ u = j $ by ax
s3: $ G , u = j ⇒ j = u $ by eq_sym [s2]
s4: $ G , u = j ⇒ irf D K d j $ by weaken [#1]
s5: $ G , u = j ⇒ irf D K d u $ by irf_eq_arg [s3, s4]
s6: $ G , u = j ⇒ ∃ i (irf D K d i) $ by ex_intro [s5]
s7: $ G ⇒ ∃ i (irf D K d i) $ by isset_elim [s1, s6]

lemma d2_img2 {y h z: set} (G: hyps) (S H: class):
  $ G ⇒ isset S $ > $ G ⇒ isset H $ > $ G ⇒ isset {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} $
----
g1: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ z ∊ S ∧ h ∊ H ∧ o = scons h z $ by ax
g2: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ z ∊ S $ by and_elim_l [g1]
g3: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ h ∊ H ∧ o = scons h z $ by and_elim_r [g1]
g4: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ h ∊ H $ by and_elim_l [g3]
g5: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ o = scons h z $ by and_elim_r [g3]
g6: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ ⟨ z , o ⟩ ∈ cgr k (scons h k) $ by cgr_intro (B := $ scons h k $) [g5]
g7: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ o ∊ img (cgr k (scons h k)) S $ by img_intro [g2, g6]
g8: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ functional (cgr k (scons h k)) $ by cgr_functional
g9: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ isset S $ by weaken [#1]
g10: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ isset (img (cgr k (scons h k)) S) $ by img_set [g8, g9]
g11: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z , c = img (cgr k (scons h k)) S ⇒ c = img (cgr k (scons h k)) S $ by ax
g12: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z , c = img (cgr k (scons h k)) S ⇒ ⟨ h , c ⟩ ∈ cgr l (img (cgr k (scons l k)) S) $ by cgr_intro (B := $ img (cgr k (scons l k)) S $) [g11]
g13: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z , c = img (cgr k (scons h k)) S ⇒ h ∊ H $ by weaken [g4]
g14: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z , c = img (cgr k (scons h k)) S ⇒ c ∊ img (cgr l (img (cgr k (scons l k)) S)) H $ by img_intro [g13, g12]
g15: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z , c = img (cgr k (scons h k)) S ⇒ img (cgr k (scons h k)) S = c $ by eq_sym [g11]
g16: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z , c = img (cgr k (scons h k)) S ⇒ o ∊ img (cgr k (scons h k)) S $ by weaken [g7]
g17: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z , c = img (cgr k (scons h k)) S ⇒ o ∊ c $ by welc_eq [g15, g16]
g18: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z , c = img (cgr k (scons h k)) S ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (scons l k)) S)) H) $ by cuni_intro [g17, g14]
g19: $ G , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (scons l k)) S)) H) $ by isset_elim [g10, g18]
g24: $ G , o ∊ {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} ⇒ o ∊ {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} $ by ax
g25: $ G , o ∊ {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} ⇒ ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ o = scons h z) $ by cab_elim [g24]
g19w: $ G , o ∊ {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} , z ∊ S ∧ h ∊ H ∧ o = scons h z ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (scons l k)) S)) H) $ by weaken [g19]
q1a: $ G , o ∊ {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} , ∃ z (z ∊ S ∧ h ∊ H ∧ o = scons h z) ⇒ ∃ z (z ∊ S ∧ h ∊ H ∧ o = scons h z) $ by ax
q1b: $ G , o ∊ {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} , ∃ z (z ∊ S ∧ h ∊ H ∧ o = scons h z) ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (scons l k)) S)) H) $ by ex_elim [q1a, g19w]
q0: $ G , o ∊ {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} ⇒ o ∊ ⋃ (img (cgr l (img (cgr k (scons l k)) S)) H) $ by ex_elim [g25, q1b]
g27: $ G ⇒ {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} ⊆ ⋃ (img (cgr l (img (cgr k (scons l k)) S)) H) $ by subset_intro [q0]
g28: $ G ⇒ functional (cgr l (img (cgr k (scons l k)) S)) $ by cgr_functional
g29: $ G ⇒ isset (img (cgr l (img (cgr k (scons l k)) S)) H) $ by img_set [g28, #2]
g30: $ G ⇒ isset (⋃ (img (cgr l (img (cgr k (scons l k)) S)) H)) $ by cuni_set [g29]
g31: $ G ⇒ isset {y | ∃ h ∃ z (z ∊ S ∧ h ∊ H ∧ y = scons h z)} $ by subset_isset [g30, g27]

lemma d2_ihsp_sub (G: hyps) (L g t d j j2: class): $ G ⇒ j = j2 $ > $ G ⇒ ihsp L g t d j ⊆ ihsp L g t d j2 $
----
m3: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ $ by ax
m4: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d $ by and_elim_l [m3]
m5: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ $ by and_elim_r [m3]
m6a: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ L = L $ by eq_refl
m6b: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ j = j2 $ by weaken [#1]
m6c: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ ⟨ e , apn (fv g d) q ⟩ = ⟨ e , apn (fv g d) q ⟩ $ by eq_refl
m6d: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ = ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩ $ by opair_eq [m6b, m6c]
m7: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩ $ by welc_ap_eq [m6a, m6d, m5]
m8: $ G , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩ $ by and_intro [m4, m7]
m9: $ G ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ → ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩ $ by imp_intro [m8]
w0: $ G ⇒ ∀ e ((⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩) → (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)) $ by all_intro [m9]
w1: $ G , ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩) ⇒ ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩) $ by ax
w2: $ G , ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩) ⇒ ∀ e ((⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩) → (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)) $ by weaken [w0]
w3: $ G , ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩) ⇒ ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩) $ by ex_mp [w2, w1]
w4: $ G ⇒ ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩) → ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩) $ by imp_intro [w3]
w5: $ G ⇒ ∀ c ((∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)) → (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩))) $ by all_intro [w4]
w6: $ G , ∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)) ⇒ ∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)) $ by ax
w7: $ G , ∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)) ⇒ ∀ c ((∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)) → (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩))) $ by weaken [w5]
w8: $ G , ∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)) ⇒ ∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)) $ by ex_mp [w7, w6]
w9: $ G ⇒ ∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)) → ∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)) $ by imp_intro [w8]
w10: $ G ⇒ ∀ b ((∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) → (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)))) $ by all_intro [w9]
w11: $ G , ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) ⇒ ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) $ by ax
w12: $ G , ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) ⇒ ∀ b ((∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) → (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)))) $ by weaken [w10]
w13: $ G , ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) ⇒ ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩))) $ by ex_mp [w12, w11]
w14: $ G ⇒ ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) → ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩))) $ by imp_intro [w13]
o1: $ G , o ∊ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⇒ o ∊ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} $ by ax
o2: $ G , o ∊ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⇒ ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) $ by cab_elim [o1]
o3: $ G , o ∊ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⇒ ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩))) → ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩))) $ by weaken [w14]
o4: $ G , o ∊ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⇒ ∃ b (∃ c (∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ o ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩))) $ by imp_elim [o3, o2]
o5: $ G , o ∊ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⇒ o ∊ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)} $ by cab_intro [o4]
o6: $ G ⇒ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⊆ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)} $ by subset_intro [o5]
o7: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} ⇒ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⊆ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)} $ by weaken [o6]
o8: $ G ⇒ q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} → {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⊆ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)} $ by imp_intro [o7]
o9: $ G ⇒ ∀ q (q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} → {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩)} ⊆ {y | ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ∧ y ∊ ap L ⟨ j2 , ⟨ e , apn (fv g d) q ⟩ ⟩)}) $ by all_intro [o8]
o10: $ G ⇒ ihsp L g t d j ⊆ ihsp L g t d j2 $ by fpi_mono [o9]

ihsp_eq_arg
-----------
e1: $ G ⇒ ihsp L g t d j ⊆ ihsp L g t d j2 $ by d2_ihsp_sub [#1]
e2: $ G ⇒ j2 = j $ by eq_sym [#1]
e3: $ G ⇒ ihsp L g t d j2 ⊆ ihsp L g t d j $ by d2_ihsp_sub [e2]
e4: $ G ⇒ ihsp L g t d j = ihsp L g t d j2 $ by subset_antisym [e1, e3]

lemma d2_suc_rec {y h z: set} (G: hyps) (D K L g t j: class) (d: set):
  $ G ⇒ d ∊ ω $ > $ G ⇒ irf D K d j $ > $ G ⇒ isset (ihsp L g t d j) $ >
  $ G ⇒ ihv D K L g t (suc d) = {y | ∃ h ∃ z (z ∊ ihv D K L g t d ∧ h ∊ ihsp L g t d j ∧ y = scons h z)} $
----
n1: $ G , m = ihv D K L g t d ⇒ d ∊ ω $ by weaken [#1]
