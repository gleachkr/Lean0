l85: $ G , ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) ⇒ ∃ f ∃ g ∃ h ∃ j ∃ k ∃ l (t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ ∧ fv nvf j = y ∧ ra_clen_c g l ∈ lrel ∧ ra_minor_idx h j b k ∈ lrel ∧ ra_add l k e ∈ lrel) $ by ex_elim [l84, l83]
l86: $ G , ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) ⇒ ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) $ by ax
l87: $ G , ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) ⇒ ∃ f ∃ g ∃ h ∃ j ∃ k ∃ l (t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ ∧ fv nvf j = y ∧ ra_clen_c g l ∈ lrel ∧ ra_minor_idx h j b k ∈ lrel ∧ ra_add l k e ∈ lrel) $ by ex_elim [l86, l85]
l88: $ G , ∃ x2 ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) ⇒ ∃ x2 ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) $ by ax
l89: $ G , ∃ x2 ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) ⇒ ∃ f ∃ g ∃ h ∃ j ∃ k ∃ l (t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ ∧ fv nvf j = y ∧ ra_clen_c g l ∈ lrel ∧ ra_minor_idx h j b k ∈ lrel ∧ ra_add l k e ∈ lrel) $ by ex_elim [l88, l87]
l90: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) $ by ax
l91: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x5 ∃ x4 ∃ x6 ∃ x7 ∃ x8 (t = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ a = ⟨ kc_s , scons x5 ∅ ⟩ ∧ b = x4 ∧ e = x8 ∧ ra_clen_c x2 x7 ∈ lrel ∧ ra_minor_idx x3 x5 x4 x6 ∈ lrel ∧ ra_add x7 x6 x8 ∈ lrel) ⇒ ∃ f ∃ g ∃ h ∃ j ∃ k ∃ l (t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ ∧ fv nvf j = y ∧ ra_clen_c g l ∈ lrel ∧ ra_minor_idx h j b k ∈ lrel ∧ ra_add l k e ∈ lrel) $ by ex_elim [l90, l89]
l92: $ G ⇒ ∃ f ∃ g ∃ h ∃ j ∃ k ∃ l (t = ⟨ kc_tcons , scons f (scons g (scons h ∅)) ⟩ ∧ fv nvf j = y ∧ ra_clen_c g l ∈ lrel ∧ ra_minor_idx h j b k ∈ lrel ∧ ra_add l k e ∈ lrel) $ by or_elim [l1, l25, l91]

lemma d1_iprt_set (G: hyps) (D: class) (p t: set): $ G ⇒ iprt D p t $ > $ G ⇒ isset D $
----
l1: $ G ⇒ ∃ b (ra_ind_data D b p t ∈ lrel) $ by weaken [#1]
l2: $ G , ra_ind_data D b p t ∈ lrel ⇒ ra_ind_data D b p t ∈ lrel $ by ax
l3a: $ G , ra_ind_data D b p t ∈ lrel ⇒ kr_ind_data ∈ ω $ by kr_ind_data_omega
l3b: $ G , ra_ind_data D b p t ∈ lrel ⇒ isset kr_ind_data $ by wcel_isset [l3a]
l3c: $ G , ra_ind_data D b p t ∈ lrel ⇒ D ∈ trees ω ∧ b ∈ trees ω ∧ p ∈ trees ω ∧ t ∈ trees ω $ by lrel_args4_c [l2, l3b]
l3d: $ G , ra_ind_data D b p t ∈ lrel ⇒ D ∈ trees ω $ by and_elim_l [l3c]
l3: $ G , ra_ind_data D b p t ∈ lrel ⇒ isset D $ by wcel_isset [l3d]
l4: $ G ⇒ isset D $ by ex_elim [l1, l3]

lemma d1_npi_z {f g: set} (G: hyps) (t h a: set):
  $ G ⇒ ra_nth_pi t h a ∈ lrel $ > $ G ⇒ fv nvf h = ∅ $ > $ G ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by lrel_nth_pi_cases [#1]
l2: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 $ by ax
l3: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 $ by and_elim_r [l2]
l5: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ h = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l4]
l6: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ a = x1 $ by and_elim_r [l4]
l7: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ a = x1 $ by and_intro [l3, l6]
l8: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ ∃ g (t = ⟨ kc_pi , scons x1 (scons g ∅) ⟩ ∧ a = x1) $ by ex_intro [l7]
l9: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by ex_intro [l8]
l10: $ G , ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) $ by ax
l11: $ G , ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by ex_elim [l10, l9]
l12: $ G , ∃ x1 ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) $ by ax
l13: $ G , ∃ x1 ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by ex_elim [l12, l11]
l14: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel $ by ax
l15: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ $ by and_elim_l [l14]
l16: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel $ by and_elim_r [l14]
l17: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ h = ⟨ kc_s , scons x4 ∅ ⟩ $ by and_elim_l [l16]
l18: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel $ by and_elim_r [l16]
l19: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ a = x1 $ by and_elim_l [l18]
l20: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ra_nth_pi x2 x4 x1 ∈ lrel $ by and_elim_r [l18]
l21: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ kr_nth_pi ∈ ω $ by kr_nth_pi_omega
l22: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ isset kr_nth_pi $ by wcel_isset [l21]
l23: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x2 ∊ trees ω ∧ x4 ∊ trees ω ∧ x1 ∊ trees ω $ by lrel_args3 [l20, l22]
l24: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x4 ∊ trees ω ∧ x1 ∊ trees ω $ by and_elim_r [l23]
l25: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x4 ∊ trees ω $ by and_elim_l [l24]
l26: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x4 ∈ trees ω $ by welc_wcel [l25]
l27: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf ⟨ kc_s , scons x4 ∅ ⟩ = suc (fv nvf x4) $ by nvf_s [l26]
l28: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l29: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf h = fv nvf ⟨ kc_s , scons x4 ∅ ⟩ $ by fv_eq [l28, l17]
l30: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf h = suc (fv nvf x4) $ by eq_trans [l29, l27]
l31: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ suc (fv nvf x4) = fv nvf h $ by eq_sym [l30]
l32: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf h = ∅ $ by weaken [#2]
l33: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ suc (fv nvf x4) = ∅ $ by eq_trans [l31, l32]
l34: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ⊥ $ by suc_ne_empty [l33]
l35: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by bot_elim [l34]
l36: $ G , ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by ax
l37: $ G , ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by ex_elim [l36, l35]
l38: $ G , ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by ax
l39: $ G , ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by ex_elim [l38, l37]
l40: $ G , ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by ax
l41: $ G , ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by ex_elim [l40, l39]
l42: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by ax
l43: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by ex_elim [l42, l41]
l44: $ G ⇒ ∃ f ∃ g (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ a = f) $ by or_elim [l1, l13, l43]

lemma d1_npi_s {f g j: set} (G: hyps) (t h a y: set):
  $ G ⇒ ra_nth_pi t h a ∈ lrel $ > $ G ⇒ fv nvf h = suc y $ > $ G ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by lrel_nth_pi_cases [#1]
l2: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 $ by ax
l3: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 $ by and_elim_r [l2]
l5: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ h = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l4]
l6: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ a = x1 $ by and_elim_r [l4]
l7: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ nvf = nvf $ by eq_refl
l8: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ fv nvf h = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [l7, l5]
l9: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l10: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ fv nvf h = ∅ $ by eq_trans [l8, l9]
l11: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ fv nvf h = suc y $ by weaken [#2]
l12: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ suc y = fv nvf h $ by eq_sym [l11]
l13: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ suc y = ∅ $ by eq_trans [l12, l10]
l14: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ ⊥ $ by suc_ne_empty [l13]
l15: $ G , t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by bot_elim [l14]
l16: $ G , ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) $ by ax
l17: $ G , ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by ex_elim [l16, l15]
l18: $ G , ∃ x1 ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) $ by ax
l19: $ G , ∃ x1 ∃ x2 (t = ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by ex_elim [l18, l17]
l20: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel $ by ax
l21: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ $ by and_elim_l [l20]
l22: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel $ by and_elim_r [l20]
l23: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ h = ⟨ kc_s , scons x4 ∅ ⟩ $ by and_elim_l [l22]
l24: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel $ by and_elim_r [l22]
l25: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ a = x1 $ by and_elim_l [l24]
l26: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ra_nth_pi x2 x4 x1 ∈ lrel $ by and_elim_r [l24]
l27: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ kr_nth_pi ∈ ω $ by kr_nth_pi_omega
l28: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ isset kr_nth_pi $ by wcel_isset [l27]
l29: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x2 ∊ trees ω ∧ x4 ∊ trees ω ∧ x1 ∊ trees ω $ by lrel_args3 [l26, l28]
l30: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x4 ∊ trees ω ∧ x1 ∊ trees ω $ by and_elim_r [l29]
l31: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x4 ∊ trees ω $ by and_elim_l [l30]
l32: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x4 ∈ trees ω $ by welc_wcel [l31]
l33: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf ⟨ kc_s , scons x4 ∅ ⟩ = suc (fv nvf x4) $ by nvf_s [l32]
l34: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l35: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf h = fv nvf ⟨ kc_s , scons x4 ∅ ⟩ $ by fv_eq [l34, l23]
l36: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf h = suc (fv nvf x4) $ by eq_trans [l35, l33]
l37: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ suc (fv nvf x4) = fv nvf h $ by eq_sym [l36]
l38: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf h = suc y $ by weaken [#2]
l39: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ suc (fv nvf x4) = suc y $ by eq_trans [l37, l38]
l40: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ functional nvf $ by nvf_functional
l41: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ isset (fv nvf x4) $ by fv_set [l40]
l42: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ isset y $ by isset_var
l43: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf x4 = y $ by suc_inj_c [l41, l42, l39]
l44: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x2 = x2 $ by eq_refl
l45: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x4 = x4 $ by eq_refl
l46: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ x1 = a $ by eq_sym [l25]
l47: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ra_nth_pi x2 x4 x1 = ra_nth_pi x2 x4 a $ by ra_nth_pi_eq [l44, l45, l46]
l48: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ra_nth_pi x2 x4 a ∈ lrel $ by wcel_eq_l [l47, l26]
l49: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ fv nvf x4 = y ∧ ra_nth_pi x2 x4 a ∈ lrel $ by and_intro [l43, l48]
l50: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ fv nvf x4 = y ∧ ra_nth_pi x2 x4 a ∈ lrel $ by and_intro [l21, l49]
l51: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ∃ j (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi x2 j a ∈ lrel) $ by ex_intro [l50]
l52: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ∃ g ∃ j (t = ⟨ kc_pi , scons x3 (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by ex_intro [l51]
l53: $ G , t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by ex_intro [l52]
l54: $ G , ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by ax
l55: $ G , ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by ex_elim [l54, l53]
l56: $ G , ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by ax
l57: $ G , ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by ex_elim [l56, l55]
l58: $ G , ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by ax
l59: $ G , ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by ex_elim [l58, l57]
l60: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) $ by ax
l61: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_pi , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_pi x2 x4 x1 ∈ lrel) ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by ex_elim [l60, l59]
l62: $ G ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_pi g j a ∈ lrel) $ by or_elim [l1, l19, l61]

lemma d1_npi_det_ind {x5 x6 x7 x8 x9: set} (G: hyps) (n: set):
  $ G ⇒ n ∊ ω $ > $ G ⇒ ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (ra_nth_pi x5 x6 x7 ∈ lrel → ra_nth_pi x5 x8 x9 ∈ lrel → fv nvf x6 = n → fv nvf x8 = n → x7 = x9) $
----
