lemma i0_vat_sub (G: hyps) (S S2 N N2 A A2: class): $ G ⇒ S = S2 $ > $ G ⇒ N = N2 $ > $ G ⇒ A = A2 $ > $ G ⇒ vat S N A ⊆ vat S2 N2 A2 $
----
m0: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k $ by ax
ml0: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ k ∊ ω $ by and_elim_l [m0]
mr0: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ nadd (suc A) k = N ∧ y ∊ fv S k $ by and_elim_r [m0]
ml1: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ nadd (suc A) k = N $ by and_elim_l [mr0]
mr1: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ y ∊ fv S k $ by and_elim_r [mr0]
n1: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ S = S2 $ by weaken [#1]
n2: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ N = N2 $ by weaken [#2]
n3: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ A = A2 $ by weaken [#3]
n4: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ suc A = suc A2 $ by suc_eq [n3]
rk: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ k = k $ by eq_refl
n5: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ nadd (suc A) k = nadd (suc A2) k $ by nadd_eq [n4, rk]
n6: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ nadd (suc A2) k = nadd (suc A) k $ by eq_sym [n5]
n7: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ nadd (suc A2) k = N $ by eq_trans [n6, ml1]
n8: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ nadd (suc A2) k = N2 $ by eq_trans [n7, n2]
n9: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ fv S k = fv S2 k $ by fv_eq [n1, rk]
n10: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ y ∊ fv S2 k $ by welc_eq [n9, mr1]
c1: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ nadd (suc A2) k = N2 ∧ y ∊ fv S2 k $ by and_intro [n8, n10]
c0: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ k ∊ ω ∧ nadd (suc A2) k = N2 ∧ y ∊ fv S2 k $ by and_intro [ml0, c1]
x0: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ ∃ k (k ∊ ω ∧ nadd (suc A2) k = N2 ∧ y ∊ fv S2 k) $ by ex_intro [c0]
y1: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ y ∊ {y | ∃ k (k ∊ ω ∧ nadd (suc A2) k = N2 ∧ y ∊ fv S2 k)} $ by cab_intro [x0]
y2: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k ⇒ y ∊ vat S2 N2 A2 $ by weaken [y1]
ea0: $ G , ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k) ⇒ ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k) $ by ax
eb0: $ G , ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k) ⇒ y ∊ vat S2 N2 A2 $ by ex_elim [ea0, y2]
f1: $ G , y ∊ vat S N A ⇒ y ∊ {y | ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k)} $ by ax
f2: $ G , y ∊ vat S N A ⇒ ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ y ∊ fv S k) $ by cab_elim [f1]
f3: $ G , y ∊ vat S N A ⇒ y ∊ vat S2 N2 A2 $ by cut [f2, eb0]
f4: $ G ⇒ vat S N A ⊆ vat S2 N2 A2 $ by subset_intro [f3]

