n2: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ intys D = intys D2 $ by intys_eq [n1]
rj: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ j = j $ by eq_refl
n3: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ vat M (intys D) j = vat M2 (intys D2) j $ by vat_eq_args [nm, n2, rj]
n4: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ inidx D j = inidx D2 j $ by inidx_eq [n1, rj]
ra: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ a = a $ by eq_refl
rx: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ x = x $ by eq_refl
n5: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ cres a (inidx D j) = cres a (inidx D2 j) $ by cres_eq [ra, n4]
n6: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ scons x (cres a (inidx D j)) = scons x (cres a (inidx D2 j)) $ by scons_eq [rx, n5]
n7: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) = apn (vat M2 (intys D2) j) (scons x (cres a (inidx D2 j))) $ by apn_eq [n3, n6]
n8: $ G , z = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , y ⟩ ∧ y ∊ apn (vat M (intys D) j) (scons x (cres a (inidx D j))) ⇒ y ∊ apn (vat M2 (intys D2) j) (scons x (cres a (inidx D2 j))) $ by welc_eq [n7, mr0]
