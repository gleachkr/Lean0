l1: $ (⟦ x / t ⟧ fpi q ((iminq A B C D E F H I)) ({y | ∃ o (∃ f (∃ g (∃ r (∃ a (∃ h (((ictk C D E o) ∧ ((⟨ f , ⟨ g , ⟨ r , a ⟩ ⟩ ⟩ ∈ (etel A B o F (scat H (ixs C F (ifam A B C F))))) ∧ ((h ∊ (ihv C o (imrel C I) g r (cdm f))) ∧ ((q = (scat h f)) ∧ (y ∊ (apn (vat I (intys C) D) (scons (itup C D E g F) (cres a (inidx C D)))))))))))))))})) ≐ fpi q ((iminq (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) (⟦ x / t ⟧ F) (⟦ x / t ⟧ H) (⟦ x / t ⟧ I))) ({y | ∃ o (∃ f (∃ g (∃ r (∃ a (∃ h (((ictk (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) o) ∧ ((⟨ f , ⟨ g , ⟨ r , a ⟩ ⟩ ⟩ ∈ (etel (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) o (⟦ x / t ⟧ F) (scat (⟦ x / t ⟧ H) (ixs (⟦ x / t ⟧ C) (⟦ x / t ⟧ F) (ifam (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ F)))))) ∧ ((h ∊ (ihv (⟦ x / t ⟧ C) o (imrel (⟦ x / t ⟧ C) (⟦ x / t ⟧ I)) g r (cdm f))) ∧ ((q = (scat h f)) ∧ (y ∊ (apn (vat (⟦ x / t ⟧ I) (intys (⟦ x / t ⟧ C)) (⟦ x / t ⟧ D)) (scons (itup (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) g (⟦ x / t ⟧ F)) (cres a (inidx (⟦ x / t ⟧ C) (⟦ x / t ⟧ D))))))))))))))))}) $ by ceqt_refl

imins_congr
-----------
g1: $ ((inmin E)) ≐ ((inmin F)) $ by inmin_congr [#3]
g2: $ (i) ≐ (i) $ by ceqt_refl
g3: $ (c) ≐ (c) $ by ceqt_refl
g4: $ (k) ≐ (k) $ by ceqt_refl
g5: $ ((iminx E i c k)) ⟺ ((iminx F i c k)) $ by iminx_congr [#3, g2, g3, g4]
g6: $ seqt y y $ by seqt_refl
g7: $ ((imin A C E i c H J L)) ≐ ((imin B D F i c I K N)) $ by imin_congr [#1, #2, #3, g2, g3, #4, #5, #6]
g8: $ ((y ∊ (imin A C E i c H J L))) ⟺ ((y ∊ (imin B D F i c I K N))) $ by welc_congr [g6, g7]
g9: $ (((iminx E i c k) ∧ (y ∊ (imin A C E i c H J L)))) ⟺ (((iminx F i c k) ∧ (y ∊ (imin B D F i c I K N)))) $ by and_congr [g5, g8]
g10: $ (∃ c (((iminx E i c k) ∧ (y ∊ (imin A C E i c H J L))))) ⟺ (∃ c (((iminx F i c k) ∧ (y ∊ (imin B D F i c I K N))))) $ by ex_congr [g9]
g11: $ (∃ i (∃ c (((iminx E i c k) ∧ (y ∊ (imin A C E i c H J L)))))) ⟺ (∃ i (∃ c (((iminx F i c k) ∧ (y ∊ (imin B D F i c I K N)))))) $ by ex_congr [g10]
g12: $ ({y | ∃ i (∃ c (((iminx E i c k) ∧ (y ∊ (imin A C E i c H J L)))))}) ≐ ({y | ∃ i (∃ c (((iminx F i c k) ∧ (y ∊ (imin B D F i c I K N)))))}) $ by cab_congr [g11]
g13: $ imins A C E H J L ≐ imins B D F I K N $ by ivals_congr [#1, g1, g12]

sb_c_imins
----------
l1: $ (⟦ x / t ⟧ ivals k (A) ((inmin C)) ({y | ∃ i (∃ c (((iminx C i c k) ∧ (y ∊ (imin A B C i c D E F)))))})) ≐ ivals k ((⟦ x / t ⟧ A)) ((inmin (⟦ x / t ⟧ C))) ({y | ∃ i (∃ c (((iminx (⟦ x / t ⟧ C) i c k) ∧ (y ∊ (imin (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) i c (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) (⟦ x / t ⟧ F))))))}) $ by ceqt_refl

lemma d2_vat_sub (G: hyps) (S N A B: class): $ G ⇒ A = B $ > $ G ⇒ vat S N A ⊆ vat S N B $
----
i1: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k $ by ax
i2: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ k ∊ ω $ by and_elim_l [i1]
i3: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ nadd (suc A) k = N ∧ o ∊ fv S k $ by and_elim_r [i1]
i4: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ nadd (suc A) k = N $ by and_elim_l [i3]
i5: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ o ∊ fv S k $ by and_elim_r [i3]
i6: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ A = B $ by weaken [#1]
i7: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ B = A $ by eq_sym [i6]
i8: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ suc B = suc A $ by suc_eq [i7]
i9: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ k = k $ by eq_refl
i10: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ nadd (suc B) k = nadd (suc A) k $ by nadd_eq [i8, i9]
i11: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ nadd (suc B) k = N $ by eq_trans [i10, i4]
i12: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ nadd (suc B) k = N ∧ o ∊ fv S k $ by and_intro [i11, i5]
i13: $ G , k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k ⇒ k ∊ ω ∧ nadd (suc B) k = N ∧ o ∊ fv S k $ by and_intro [i2, i12]
i14: $ G ⇒ (k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) → (k ∊ ω ∧ nadd (suc B) k = N ∧ o ∊ fv S k) $ by imp_intro [i13]
x0: $ G ⇒ ∀ k ((k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) → (k ∊ ω ∧ nadd (suc B) k = N ∧ o ∊ fv S k)) $ by all_intro [i14]
x1: $ G , ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) ⇒ ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) $ by ax
x2: $ G , ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) ⇒ ∀ k ((k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) → (k ∊ ω ∧ nadd (suc B) k = N ∧ o ∊ fv S k)) $ by weaken [x0]
x3: $ G , ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) ⇒ ∃ k (k ∊ ω ∧ nadd (suc B) k = N ∧ o ∊ fv S k) $ by ex_mp [x2, x1]
x4: $ G ⇒ ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) → ∃ k (k ∊ ω ∧ nadd (suc B) k = N ∧ o ∊ fv S k) $ by imp_intro [x3]
v1: $ G , o ∊ vat S N A ⇒ o ∊ vat S N A $ by ax
v2: $ G , o ∊ vat S N A ⇒ ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) $ by cab_elim [v1]
v3: $ G , o ∊ vat S N A ⇒ ∃ k (k ∊ ω ∧ nadd (suc A) k = N ∧ o ∊ fv S k) → ∃ k (k ∊ ω ∧ nadd (suc B) k = N ∧ o ∊ fv S k) $ by weaken [x4]
v4: $ G , o ∊ vat S N A ⇒ ∃ k (k ∊ ω ∧ nadd (suc B) k = N ∧ o ∊ fv S k) $ by imp_elim [v3, v2]
v5: $ G , o ∊ vat S N A ⇒ o ∊ vat S N B $ by cab_intro [v4]
v6: $ G ⇒ vat S N A ⊆ vat S N B $ by subset_intro [v5]

vat_eq_arg
----------
e1: $ G ⇒ vat S N A ⊆ vat S N B $ by d2_vat_sub [#1]
e2: $ G ⇒ B = A $ by eq_sym [#1]
e3: $ G ⇒ vat S N B ⊆ vat S N A $ by d2_vat_sub [e2]
e4: $ G ⇒ vat S N A = vat S N B $ by subset_antisym [e1, e3]

lemma d2_inidx_sub (G: hyps) (D A B: class): $ G ⇒ A = B $ > $ G ⇒ inidx D A ⊆ inidx D B $
----
i1: $ G , fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k ⇒ fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k $ by ax
i2: $ G , fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k ⇒ fv nvf i = A $ by and_elim_l [i1]
i3: $ G , fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k ⇒ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k $ by and_elim_r [i1]
i4: $ G , fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k ⇒ A = B $ by weaken [#1]
i5: $ G , fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k ⇒ fv nvf i = B $ by eq_trans [i2, i4]
i6: $ G , fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k ⇒ fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k $ by and_intro [i5, i3]
i7: $ G ⇒ (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) → (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) $ by imp_intro [i6]
x0: $ G ⇒ ∀ k ((fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) → (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) $ by all_intro [i7]
x1: $ G , ∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) ⇒ ∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) $ by ax
x2: $ G , ∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) ⇒ ∀ k ((fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) → (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) $ by weaken [x0]
x3: $ G , ∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) ⇒ ∃ k (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) $ by ex_mp [x2, x1]
x4: $ G ⇒ ∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) → ∃ k (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k) $ by imp_intro [x3]
x5: $ G ⇒ ∀ i ((∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) → (∃ k (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k))) $ by all_intro [x4]
x6: $ G , ∃ i (∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) ⇒ ∃ i (∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) $ by ax
x7: $ G , ∃ i (∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) ⇒ ∀ i ((∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) → (∃ k (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k))) $ by weaken [x5]
x8: $ G , ∃ i (∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) ⇒ ∃ i (∃ k (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) $ by ex_mp [x7, x6]
x9: $ G ⇒ ∃ i (∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) → ∃ i (∃ k (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) $ by imp_intro [x8]
v1: $ G , o ∊ inidx D A ⇒ o ∊ inidx D A $ by ax
v2: $ G , o ∊ inidx D A ⇒ ∃ i (∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) $ by cab_elim [v1]
v3: $ G , o ∊ inidx D A ⇒ ∃ i (∃ k (fv nvf i = A ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) → ∃ i (∃ k (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) $ by weaken [x9]
v4: $ G , o ∊ inidx D A ⇒ ∃ i (∃ k (fv nvf i = B ∧ ra_nidx D i k ∈ lrel ∧ o ∊ fv nvf k)) $ by imp_elim [v3, v2]
v5: $ G , o ∊ inidx D A ⇒ o ∊ inidx D B $ by cab_intro [v4]
v6: $ G ⇒ inidx D A ⊆ inidx D B $ by subset_intro [v5]

inidx_eq_arg
------------
e1: $ G ⇒ inidx D A ⊆ inidx D B $ by d2_inidx_sub [#1]
e2: $ G ⇒ B = A $ by eq_sym [#1]
e3: $ G ⇒ inidx D B ⊆ inidx D A $ by d2_inidx_sub [e2]
e4: $ G ⇒ inidx D A = inidx D B $ by subset_antisym [e1, e3]

lemma d2_T_eq (G: hyps) (D cv J A X J2 A2 X2: class):
  $ G ⇒ J = J2 $ > $ G ⇒ A = A2 $ > $ G ⇒ X = X2 $ > $ G ⇒ apn (vat cv (intys D) J) (scons X (cres A (inidx D J))) = apn (vat cv (intys D) J2) (scons X2 (cres A2 (inidx D J2))) $
----
t1: $ G ⇒ vat cv (intys D) J = vat cv (intys D) J2 $ by vat_eq_arg [#1]
t2: $ G ⇒ inidx D J = inidx D J2 $ by inidx_eq_arg [#1]
t3: $ G ⇒ cres A (inidx D J) = cres A2 (inidx D J2) $ by cres_eq [#2, t2]
t4: $ G ⇒ scons X (cres A (inidx D J)) = scons X2 (cres A2 (inidx D J2)) $ by scons_eq [#3, t3]
t5: $ G ⇒ apn (vat cv (intys D) J) (scons X (cres A (inidx D J))) = apn (vat cv (intys D) J2) (scons X2 (cres A2 (inidx D J2))) $ by apn_eq [t1, t4]

lemma d2_imc (G: hyps) (D cv j a x: class) (o w b c e n: set):
  $ G ⇒ isset j $ > $ G ⇒ isset a $ > $ G ⇒ isset x $ > $ G ⇒ w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ $ >
  $ G ⇒ w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) $ > $ G ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $
----
c1: $ G ⇒ w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ $ by and_elim_l [#5]
c2: $ G ⇒ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) $ by and_elim_r [#5]
c3: $ G ⇒ ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ = w $ by eq_sym [#4]
c4: $ G ⇒ ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ $ by eq_trans [c3, c1]
c5: $ G ⇒ isset ⟨ j , ⟨ a , x ⟩ ⟩ $ by opair_isset
c6: $ G ⇒ isset o $ by isset_var
c7: $ G ⇒ isset ⟨ b , ⟨ c , e ⟩ ⟩ $ by opair_isset
c8: $ G ⇒ isset n $ by isset_var
c9: $ G ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = ⟨ b , ⟨ c , e ⟩ ⟩ ∧ o = n $ by opair_inj_c [c4, c5, c6, c7, c8]
c10: $ G ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = ⟨ b , ⟨ c , e ⟩ ⟩ $ by and_elim_l [c9]
c11: $ G ⇒ o = n $ by and_elim_r [c9]
c12: $ G ⇒ isset ⟨ a , x ⟩ $ by opair_isset
c13: $ G ⇒ isset b $ by isset_var
c14: $ G ⇒ isset ⟨ c , e ⟩ $ by opair_isset
c15: $ G ⇒ j = b ∧ ⟨ a , x ⟩ = ⟨ c , e ⟩ $ by opair_inj_c [c10, #1, c12, c13, c14]
c16: $ G ⇒ j = b $ by and_elim_l [c15]
c17: $ G ⇒ ⟨ a , x ⟩ = ⟨ c , e ⟩ $ by and_elim_r [c15]
c18: $ G ⇒ isset c $ by isset_var
c19: $ G ⇒ isset e $ by isset_var
c20: $ G ⇒ a = c ∧ x = e $ by opair_inj_c [c17, #2, #3, c18, c19]
c21: $ G ⇒ a = c $ by and_elim_l [c20]
c22: $ G ⇒ x = e $ by and_elim_r [c20]
c23: $ G ⇒ b = j $ by eq_sym [c16]
c24: $ G ⇒ c = a $ by eq_sym [c21]
c25: $ G ⇒ e = x $ by eq_sym [c22]
c26: $ G ⇒ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) = apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by d2_T_eq [c23, c24, c25]
c27: $ G ⇒ n ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by welc_eq [c26, c2]
c28: $ G ⇒ n = o $ by eq_sym [c11]
c29: $ G ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by welc_eq_set [c28, c27]

imrel_ap
--------
a1: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ ⇒ o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ $ by ax
a2: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ ⇒ ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ ∈ imrel D cv $ by ap_elim [a1]
a3: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv ⇒ w ∊ imrel D cv $ by ax
a4: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv ⇒ ∃ b ∃ c ∃ e ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) $ by cab_elim [a3]
a5: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) ⇒ isset j $ by weaken [#1]
a6: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) ⇒ isset a $ by weaken [#2]
a7: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) ⇒ isset x $ by weaken [#3]
a8: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) ⇒ w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ $ by ax
a9: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) ⇒ w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) $ by ax
a10: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by d2_imc [a5, a6, a7, a8, a9]
a11: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) ⇒ ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) $ by ax
a12: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by ex_elim [a11, a10]
a13: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , ∃ e ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) ⇒ ∃ e ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) $ by ax
a14: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , ∃ e ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by ex_elim [a13, a12]
a15: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , ∃ c ∃ e ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) ⇒ ∃ c ∃ e ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) $ by ax
a16: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv , ∃ c ∃ e ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by ex_elim [a15, a14]
a17: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ , w = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ , w ∊ imrel D cv ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by ex_elim [a4, a16]
a18: $ G , o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by wcel_elim [a2, a17]
a19: $ G ⇒ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ ⊆ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by subset_intro [a18]
b1: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ b = j $ by ax
b2: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ c = a $ by ax
b3: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ e = x $ by ax
b4a: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ j = b $ by eq_sym [b1]
b4b: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ a = c $ by eq_sym [b2]
b4c: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ x = e $ by eq_sym [b3]
b4d: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) = apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) $ by d2_T_eq [b4a, b4b, b4c]
b5: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by ax
b6: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ o ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) $ by welc_eq [b4d, b5]
b7: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ $ by ax
b8: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ o ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) $ by weaken [b6]
b9: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ∧ o ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b))) $ by and_intro [b7, b8]
b10: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ ∃ n (w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons e (cres c (inidx D b)))) $ by ex_intro [b9]
b11: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ ∃ m ∃ n (w = ⟨ ⟨ b , ⟨ c , m ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons m (cres c (inidx D b)))) $ by ex_intro [b10]
b12: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ ∃ l ∃ m ∃ n (w = ⟨ ⟨ b , ⟨ l , m ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) b) (scons m (cres l (inidx D b)))) $ by ex_intro [b11]
b13: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ ∃ k ∃ l ∃ m ∃ n (w = ⟨ ⟨ k , ⟨ l , m ⟩ ⟩ , n ⟩ ∧ n ∊ apn (vat cv (intys D) k) (scons m (cres l (inidx D k)))) $ by ex_intro [b12]
b14: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ w ∊ imrel D cv $ by cab_intro [b13]
b15: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x , w = ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ⇒ ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ∈ imrel D cv $ by wcel_intro [b7, b14]
b16: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ isset ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ $ by opair_isset
b17: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ ∈ imrel D cv $ by isset_elim [b16, b15]
b18: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ ⟨ c , e ⟩ = ⟨ a , x ⟩ $ by opair_eq [b2, b3]
b19: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ ⟨ b , ⟨ c , e ⟩ ⟩ = ⟨ j , ⟨ a , x ⟩ ⟩ $ by opair_eq [b1, b18]
b20: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ o = o $ by eq_refl
b21: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ ⟨ ⟨ b , ⟨ c , e ⟩ ⟩ , o ⟩ = ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ $ by opair_eq [b19, b20]
b22: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a , e = x ⇒ ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ ∈ imrel D cv $ by wcel_eq_l [b21, b17]
b23: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j , c = a ⇒ ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ ∈ imrel D cv $ by isset_elim [#3, b22]
b24: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) , b = j ⇒ ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ ∈ imrel D cv $ by isset_elim [#2, b23]
b25: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) ⇒ ⟨ ⟨ j , ⟨ a , x ⟩ ⟩ , o ⟩ ∈ imrel D cv $ by isset_elim [#1, b24]
b26: $ G , o ∊ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) ⇒ o ∊ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ $ by ap_intro [b25]
b27: $ G ⇒ apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) ⊆ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ $ by subset_intro [b26]
b28: $ G ⇒ ap (imrel D cv) ⟨ j , ⟨ a , x ⟩ ⟩ = apn (vat cv (intys D) j) (scons x (cres a (inidx D j))) $ by subset_antisym [a19, b27]

lemma i0_vat_set (G: hyps) (cv N J: class): $ G ⇒ isset cv $ > $ G ⇒ isset (vat cv N J) $
----
v1: $ G , v ∊ vat cv N J ⇒ v ∊ vat cv N J $ by ax
v2: $ G , v ∊ vat cv N J ⇒ ∃ k (k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k) $ by cab_elim [v1]
v3: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k ⇒ k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k $ by ax
v4: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k ⇒ nadd (suc J) k = N ∧ v ∊ fv cv k $ by and_elim_r [v3]
v5: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k ⇒ v ∊ fv cv k $ by and_elim_r [v4]
v6: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k ⇒ v ∊ ⋃ (ap cv k) $ by weaken [v5]
v7: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k , w ∊ ap cv k , v ∊ w ⇒ w ∊ ap cv k $ by ax
v8: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k , w ∊ ap cv k , v ∊ w ⇒ ap cv k ⊆ crn cv $ by ap_subset_crn
v9: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k , w ∊ ap cv k , v ∊ w ⇒ w ∊ crn cv $ by subset_elim [v8, v7]
v10: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k , w ∊ ap cv k , v ∊ w ⇒ v ∊ w $ by ax
v11: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k , w ∊ ap cv k , v ∊ w ⇒ v ∊ ⋃ (crn cv) $ by cuni_intro [v10, v9]
v12: $ G , v ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ v ∊ fv cv k ⇒ v ∊ ⋃ (crn cv) $ by cuni_elim [v6, v11]
v13: $ G , v ∊ vat cv N J ⇒ v ∊ ⋃ (crn cv) $ by ex_elim [v2, v12]
v14: $ G ⇒ vat cv N J ⊆ ⋃ (crn cv) $ by subset_intro [v13]
v15: $ G ⇒ isset (crn cv) $ by crn_set [#1]
v16: $ G ⇒ isset (⋃ (crn cv)) $ by cuni_set [v15]
v17: $ G ⇒ isset (vat cv N J) $ by subset_isset [v16, v14]

lemma i0_vat_ne {k: set} (G: hyps) (cv N J: class): $ G ⇒ ∀ k (¬ ∅ ∈ fv cv k) $ > $ G ⇒ ¬ ∅ ∈ vat cv N J $
----
n1: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J ⇒ o ∊ vat cv N J $ by ax
n2: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J ⇒ ∃ k (k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k) $ by cab_elim [n1]
n3: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k ⇒ k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k $ by ax
n4: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k ⇒ nadd (suc J) k = N ∧ o ∊ fv cv k $ by and_elim_r [n3]
n5: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k ⇒ o ∊ fv cv k $ by and_elim_r [n4]
n6: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k ⇒ o = ∅ $ by ax
n7: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k ⇒ ∅ ∈ fv cv k $ by wcel_intro [n6, n5]
n8: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k ⇒ ∀ k (¬ ∅ ∈ fv cv k) $ by weaken [#1]
n9: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k ⇒ ¬ ∅ ∈ fv cv k $ by all_elim [n8]
n10: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J , k ∊ ω ∧ nadd (suc J) k = N ∧ o ∊ fv cv k ⇒ ⊥ $ by not_elim [n9, n7]
n11: $ G , ∅ ∈ vat cv N J , o = ∅ , o ∊ vat cv N J ⇒ ⊥ $ by ex_elim [n2, n10]
n12a: $ G , ∅ ∈ vat cv N J ⇒ ∅ ∈ vat cv N J $ by ax
n12: $ G , ∅ ∈ vat cv N J ⇒ ⊥ $ by wcel_elim [n12a, n11]
n13: $ G ⇒ ¬ ∅ ∈ vat cv N J $ by not_intro [n12]

imrel_set
---------
p0: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ $ by ax
p0r: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ imrel D cv = imrel D cv $ by eq_refl
p1: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ ap (imrel D cv) e = ap (imrel D cv) ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ $ by ap_eq [p0r, p0]
p2a: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset x0 $ by isset_var
p2b: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset x1 $ by isset_var
p2c: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset x2 $ by isset_var
p2: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ ap (imrel D cv) ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ = apn (vat cv (intys D) x0) (scons x2 (cres x1 (inidx D x0))) $ by imrel_ap [p2a, p2b, p2c]
p3a: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset cv $ by weaken [#1]
p3: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset (vat cv (intys D) x0) $ by i0_vat_set [p3a]
p4: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ cres x1 (inidx D x0) ⊆ x1 $ by cres_subset
p6: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset (cres x1 (inidx D x0)) $ by subset_isset [p2b, p4]
p7: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset (scons x2 (cres x1 (inidx D x0))) $ by scons_set [p6]
p8a: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ ∀ k (¬ ∅ ∈ fv cv k) $ by weaken [#2]
p8: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ ¬ ∅ ∈ vat cv (intys D) x0 $ by i0_vat_ne [p8a]
p9: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset (apn (vat cv (intys D) x0) (scons x2 (cres x1 (inidx D x0)))) $ by apn_set [p3, p7, p8]
p10: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ ap (imrel D cv) e = apn (vat cv (intys D) x0) (scons x2 (cres x1 (inidx D x0))) $ by eq_trans [p1, p2]
p11: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ apn (vat cv (intys D) x0) (scons x2 (cres x1 (inidx D x0))) = ap (imrel D cv) e $ by eq_sym [p10]
p12: $ G , e = ⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ⇒ isset (ap (imrel D cv) e) $ by isset_eq [p11, p9]
