l141: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel , x5 = K , x6 = K2 , x7 = fv nvf d ⇒ i = i2 ∧ c = c2 $ by and_intro [l137, l140]
l142: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel , x5 = K , x6 = K2 ⇒ i = i2 ∧ c = c2 $ by isset_elim [l45, l141]
l143: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel , x5 = K ⇒ i = i2 ∧ c = c2 $ by isset_elim [l43, l142]
l144: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel ⇒ i = i2 ∧ c = c2 $ by isset_elim [l41, l143]
l145: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , ∃ z (iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel) ⇒ ∃ z (iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel) $ by ax
l146: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , ∃ z (iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel) ⇒ i = i2 ∧ c = c2 $ by ex_elim [l145, l144]
l147: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , ∃ y ∃ z (iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel) ⇒ ∃ y ∃ z (iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel) $ by ax
l148: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , ∃ y ∃ z (iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel) ⇒ i = i2 ∧ c = c2 $ by ex_elim [l147, l146]
l149: $ G , iprt D p t ∧ fv nvf n = i ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = c ∧ ra_nth_ctor e m K ∈ lrel , iprt D o q ∧ fv nvf r = i2 ∧ ra_nth_ty q r g h ∈ lrel ∧ fv nvf l = c2 ∧ ra_nth_ctor h l K2 ∈ lrel , iprt D a b ∧ fv nvf d = i ∧ fv nvf j = c ∧ fv nvf u = k ∧ ra_minor_idx b d j u ∈ lrel , ∃ x ∃ y ∃ z (iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel) ⇒ ∃ x ∃ y ∃ z (iprt D v w ∧ fv nvf x = i2 ∧ fv nvf y = c2 ∧ fv nvf z = k ∧ ra_minor_idx w x y z ∈ lrel) $ by ax
