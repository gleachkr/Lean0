lemma d1_indapp_val {u v: set} (G: hyps) (b n e d c j: set):
  $ G ⇒ ra_indapp b n e d c j ∈ lrel $ > $ G ⇒ ∃ u ∃ v (ra_spine ⟨ kc_bvar , scons u ∅ ⟩ c v ∈ lrel ∧ fv nvf u = nadd (nadd (fv nvf d) (fv nvf e)) (fv nvf j)) $
----
l1: $ G ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ y (b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel) $ by lrel_indapp_cases [#1]
l2: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel ⇒ b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel $ by ax
l3: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel ⇒ b = x0 $ by and_elim_l [l2]
l4: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel ⇒ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel $ by and_elim_r [l2]
l5: $ G , b = x0 ∧ n = x1 ∧ e = x2 ∧ d = x3 ∧ c = y ∧ j = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ y x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 y ∈ lrel ⇒ n = x1 $ by and_elim_l [l4]
