lemma d1_minj_ind {x0 x1 x2 x3 x4: set} (G: hyps) (b v n: set):
  $ G ⇒ n ∊ ω $ > $ G ⇒ ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 (ra_minor_idx x0 x1 b x2 ∈ lrel → ra_minor_idx x0 x3 v x4 ∈ lrel → fv nvf x2 = fv nvf x4 → d1_bd x0 x1 b → d1_bd x0 x3 v → fv nvf x1 = n → fv nvf x1 = fv nvf x3 ∧ fv nvf b = fv nvf v) $
----
l1: $ G , z = ∅ , ra_minor_idx x5 x6 b x7 ∈ lrel , ra_minor_idx x5 x8 v x9 ∈ lrel , fv nvf x7 = fv nvf x9 , d1_bd x5 x6 b , d1_bd x5 x8 v , fv nvf x6 = z ⇒ ra_minor_idx x5 x6 b x7 ∈ lrel $ by ax
l2: $ G , z = ∅ , ra_minor_idx x5 x6 b x7 ∈ lrel , ra_minor_idx x5 x8 v x9 ∈ lrel , fv nvf x7 = fv nvf x9 , d1_bd x5 x6 b , d1_bd x5 x8 v , fv nvf x6 = z ⇒ ra_minor_idx x5 x8 v x9 ∈ lrel $ by ax
