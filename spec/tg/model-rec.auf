----------
e1: $ G ⇒ omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t) = omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t) $ by eq_refl
e2: $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) M = fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) N $ by fv_eq [e1, #1]
