lemma d1_minj_base (G: hyps) (b v t a e u w: set):
  $ G ⇒ ra_minor_idx t a b e ∈ lrel $ > $ G ⇒ ra_minor_idx t u v w ∈ lrel $ > $ G ⇒ fv nvf e = fv nvf w $ >
  $ G ⇒ d1_bd t a b $ > $ G ⇒ d1_bd t u v $ > $ G ⇒ fv nvf a = ∅ $ > $ G ⇒ fv nvf a = fv nvf u ∧ fv nvf b = fv nvf v $
----
l1: $ G ⇒ functional nvf $ by nvf_functional
l2: $ G ⇒ isset (fv nvf u) $ by fv_set [l1]
l3: $ G ⇒ e = b $ by d1_midx_z [#1, #6]
