e6: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ N = nadd (suc j) k $ by eq_sym [e5]
e7: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ nadd (suc j) m = nadd (suc j) k $ by eq_trans [e3, e6]
e8: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ m ∈ ω $ by welc_wcel [e2]
e9: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ k ∈ ω $ by weaken [#3]
e10: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ suc j ∈ ω $ by weaken [g2]
e11: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ m = k $ by nadd_cancel_l_c [e8, e9, e10, e7]
e12a: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ S = S $ by eq_refl
e12: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ fv S m = fv S k $ by fv_eq [e12a, e11]
e13: $ G , y ∊ vat S N j , m ∊ ω ∧ nadd (suc j) m = N ∧ y ∊ fv S m ⇒ y ∊ fv S k $ by welc_eq [e12, e4]
x1: $ G , y ∊ vat S N j ⇒ y ∊ fv S k $ by ex_elim [f2, e13]
v1: $ G , y ∊ fv S k , x = k , x ∊ ω ⇒ x ∊ ω $ by ax
v2: $ G , y ∊ fv S k , x = k , x ∊ ω ⇒ x = k $ by ax
v2b: $ G , y ∊ fv S k , x = k , x ∊ ω ⇒ suc j = suc j $ by eq_refl
v3: $ G , y ∊ fv S k , x = k , x ∊ ω ⇒ nadd (suc j) x = nadd (suc j) k $ by nadd_eq [v2b, v2]
v4: $ G , y ∊ fv S k , x = k , x ∊ ω ⇒ nadd (suc j) k = N $ by weaken [#4]
