itup_nprop
----------
f1: $ G , y ∊ itup D i c g W ⇒ y ∊ itup D i c g W $ by ax
f2: $ G , y ∊ itup D i c g W ⇒ ¬ iprop D i W ∧ y ∊ scons c g $ by cab_elim [f1]
f3: $ G , y ∊ itup D i c g W ⇒ y ∊ scons c g $ by and_elim_r [f2]
b1: $ G , y ∊ scons c g ⇒ ¬ iprop D i W $ by weaken [#1]
b2: $ G , y ∊ scons c g ⇒ y ∊ scons c g $ by ax
b3: $ G , y ∊ scons c g ⇒ ¬ iprop D i W ∧ y ∊ scons c g $ by and_intro [b1, b2]
b4: $ G , y ∊ scons c g ⇒ y ∊ itup D i c g W $ by cab_intro [b3]
z1: $ G ⇒ itup D i c g W = scons c g $ by eq_intro [f3, b4]

itup_prop
---------
f1: $ G , y ∊ itup D i c g W ⇒ y ∊ itup D i c g W $ by ax
f2: $ G , y ∊ itup D i c g W ⇒ ¬ iprop D i W ∧ y ∊ scons c g $ by cab_elim [f1]
f3: $ G , y ∊ itup D i c g W ⇒ ¬ iprop D i W $ by and_elim_l [f2]
f4: $ G , y ∊ itup D i c g W ⇒ iprop D i W $ by weaken [#1]
f5: $ G , y ∊ itup D i c g W ⇒ ⊥ $ by not_elim [f3, f4]
z1: $ G ⇒ itup D i c g W = ∅ $ by empty_eq_intro [f5]

lemma i0_inidx_sub (G: hyps) (D D2 J J2: class): $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ inidx D J ⊆ inidx D2 J2 $
----
m0: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k $ by ax
ml0: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ fv nvf i = J $ by and_elim_l [m0]
mr0: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k $ by and_elim_r [m0]
ml1: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ ra_nidx D i k ∈ lrel $ by and_elim_l [mr0]
mr1: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ y ∊ fv nvf k $ by and_elim_r [mr0]
n1: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ D = D2 $ by weaken [#1]
n2: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ J = J2 $ by weaken [#2]
n3: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ fv nvf i = J2 $ by eq_trans [ml0, n2]
r8: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ i = i $ by eq_refl
r9: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ k = k $ by eq_refl
n4: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ ra_nidx D i k = ra_nidx D2 i k $ by ra_nidx_eq [n1, r8, r9]
n5: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ ra_nidx D2 i k ∈ lrel $ by wcel_eq_l [n4, ml1]
c1: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ ra_nidx D2 i k ∈ lrel ∧ y ∊ fv nvf k $ by and_intro [n5, mr1]
c0: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ fv nvf i = J2 ∧ ra_nidx D2 i k ∈ lrel ∧ y ∊ fv nvf k $ by and_intro [n3, c1]
x1: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ ∃ k (fv nvf i = J2 ∧ ra_nidx D2 i k ∈ lrel ∧ y ∊ fv nvf k) $ by ex_intro [c0]
x0: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ ∃ i ∃ k (fv nvf i = J2 ∧ ra_nidx D2 i k ∈ lrel ∧ y ∊ fv nvf k) $ by ex_intro [x1]
y1: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ y ∊ {y | ∃ i ∃ k (fv nvf i = J2 ∧ ra_nidx D2 i k ∈ lrel ∧ y ∊ fv nvf k)} $ by cab_intro [x0]
y2: $ G , fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k ⇒ y ∊ inidx D2 J2 $ by weaken [y1]
ea1: $ G , ∃ k (fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k) ⇒ ∃ k (fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k) $ by ax
eb1: $ G , ∃ k (fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k) ⇒ y ∊ inidx D2 J2 $ by ex_elim [ea1, y2]
ea0: $ G , ∃ i ∃ k (fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k) ⇒ ∃ i ∃ k (fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k) $ by ax
eb0: $ G , ∃ i ∃ k (fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k) ⇒ y ∊ inidx D2 J2 $ by ex_elim [ea0, eb1]
f1: $ G , y ∊ inidx D J ⇒ y ∊ {y | ∃ i ∃ k (fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k)} $ by ax
f2: $ G , y ∊ inidx D J ⇒ ∃ i ∃ k (fv nvf i = J ∧ ra_nidx D i k ∈ lrel ∧ y ∊ fv nvf k) $ by cab_elim [f1]
f3: $ G , y ∊ inidx D J ⇒ y ∊ inidx D2 J2 $ by cut [f2, eb0]
f4: $ G ⇒ inidx D J ⊆ inidx D2 J2 $ by subset_intro [f3]

inidx_eq
--------
q1: $ G ⇒ inidx D J ⊆ inidx D2 J2 $ by i0_inidx_sub [#1, #2]
qs0: $ G ⇒ D2 = D $ by eq_sym [#1]
qs1: $ G ⇒ J2 = J $ by eq_sym [#2]
q2: $ G ⇒ inidx D2 J2 ⊆ inidx D J $ by i0_inidx_sub [qs0, qs1]
q3: $ G ⇒ inidx D J = inidx D2 J2 $ by subset_antisym [q1, q2]

lemma i0_inmin_sub (G: hyps) (D D2: class): $ G ⇒ D = D2 $ > $ G ⇒ inmin D ⊆ inmin D2 $
----
m0: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m $ by ax
ml0: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ iprt D p t $ by and_elim_l [m0]
mr0: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m $ by and_elim_r [m0]
ml1: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ ra_ntys t n m ∈ lrel $ by and_elim_l [mr0]
mr1: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ y ∊ fv nvf m $ by and_elim_r [mr0]
n1: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ D = D2 $ by weaken [#1]
r6: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ p = p $ by eq_refl
r7: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ t = t $ by eq_refl
n2: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ iprt D2 p t $ by iprt_eq [n1, r6, r7, ml0]
c1: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m $ by and_intro [ml1, mr1]
c0: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m $ by and_intro [n2, c1]
x3: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ex_intro [c0]
x2: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ex_intro [x3]
x1: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ex_intro [x2]
x0: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ex_intro [x1]
y1: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ y ∊ {y | ∃ p ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m)} $ by cab_intro [x0]
y2: $ G , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m ⇒ y ∊ inmin D2 $ by weaken [y1]
ea3: $ G , ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⇒ ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ax
eb3: $ G , ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⇒ y ∊ inmin D2 $ by ex_elim [ea3, y2]
ea2: $ G , ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⇒ ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ax
eb2: $ G , ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⇒ y ∊ inmin D2 $ by ex_elim [ea2, eb3]
ea1: $ G , ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⇒ ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ax
eb1: $ G , ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⇒ y ∊ inmin D2 $ by ex_elim [ea1, eb2]
ea0: $ G , ∃ p ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by ax
eb0: $ G , ∃ p ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) ⇒ y ∊ inmin D2 $ by ex_elim [ea0, eb1]
f1: $ G , y ∊ inmin D ⇒ y ∊ {y | ∃ p ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m)} $ by ax
f2: $ G , y ∊ inmin D ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf m) $ by cab_elim [f1]
f3: $ G , y ∊ inmin D ⇒ y ∊ inmin D2 $ by cut [f2, eb0]
f4: $ G ⇒ inmin D ⊆ inmin D2 $ by subset_intro [f3]

inmin_eq
--------
q1: $ G ⇒ inmin D ⊆ inmin D2 $ by i0_inmin_sub [#1]
qs0: $ G ⇒ D2 = D $ by eq_sym [#1]
q2: $ G ⇒ inmin D2 ⊆ inmin D $ by i0_inmin_sub [qs0]
q3: $ G ⇒ inmin D = inmin D2 $ by subset_antisym [q1, q2]

lemma i0_itup_sub (G: hyps) (D D2 I I2 C C2 T T2 W W2: class): $ G ⇒ D = D2 $ > $ G ⇒ I = I2 $ > $ G ⇒ C = C2 $ > $ G ⇒ T = T2 $ > $ G ⇒ W = W2 $ > $ G ⇒ itup D I C T W ⊆ itup D2 I2 C2 T2 W2 $
----
m0: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ ¬ iprop D I W ∧ y ∊ scons C T $ by ax
ml0: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ ¬ iprop D I W $ by and_elim_l [m0]
mr0: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ y ∊ scons C T $ by and_elim_r [m0]
o1: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ D = D2 $ by weaken [#1]
o2: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ D2 = D $ by eq_sym [o1]
o3: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ I = I2 $ by weaken [#2]
o4: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ I2 = I $ by eq_sym [o3]
o5: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ W = W2 $ by weaken [#5]
o6: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ W2 = W $ by eq_sym [o5]
o7: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ iprop D2 I2 W2 $ by ax
o8: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ iprop D I W $ by iprop_eq [o2, o4, o6, o7]
o9: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ ¬ iprop D I W $ by weaken [ml0]
o10: $ G , ¬ iprop D I W ∧ y ∊ scons C T , iprop D2 I2 W2 ⇒ ⊥ $ by not_elim [o9, o8]
o11: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ ¬ iprop D2 I2 W2 $ by not_intro [o10]
o12: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ C = C2 $ by weaken [#3]
o13: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ T = T2 $ by weaken [#4]
o14: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ y ∊ scons C2 T2 $ by welc_scons_eq [o12, o13, mr0]
c0: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ ¬ iprop D2 I2 W2 ∧ y ∊ scons C2 T2 $ by and_intro [o11, o14]
y1: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ y ∊ {y | ¬ iprop D2 I2 W2 ∧ y ∊ scons C2 T2} $ by cab_intro [c0]
y2: $ G , ¬ iprop D I W ∧ y ∊ scons C T ⇒ y ∊ itup D2 I2 C2 T2 W2 $ by weaken [y1]
f1: $ G , y ∊ itup D I C T W ⇒ y ∊ {y | ¬ iprop D I W ∧ y ∊ scons C T} $ by ax
f2: $ G , y ∊ itup D I C T W ⇒ ¬ iprop D I W ∧ y ∊ scons C T $ by cab_elim [f1]
f3: $ G , y ∊ itup D I C T W ⇒ y ∊ itup D2 I2 C2 T2 W2 $ by cut [f2, y2]
f4: $ G ⇒ itup D I C T W ⊆ itup D2 I2 C2 T2 W2 $ by subset_intro [f3]

itup_eq
-------
q1: $ G ⇒ itup D I C T W ⊆ itup D2 I2 C2 T2 W2 $ by i0_itup_sub [#1, #2, #3, #4, #5]
qs0: $ G ⇒ D2 = D $ by eq_sym [#1]
qs1: $ G ⇒ I2 = I $ by eq_sym [#2]
qs2: $ G ⇒ C2 = C $ by eq_sym [#3]
qs3: $ G ⇒ T2 = T $ by eq_sym [#4]
qs4: $ G ⇒ W2 = W $ by eq_sym [#5]
q2: $ G ⇒ itup D2 I2 C2 T2 W2 ⊆ itup D I C T W $ by i0_itup_sub [qs0, qs1, qs2, qs3, qs4]
q3: $ G ⇒ itup D I C T W = itup D2 I2 C2 T2 W2 $ by subset_antisym [q1, q2]

