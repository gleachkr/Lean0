-- Proofs for model-rec.mm0.

fpi_congr
---------
a1: $ (z ∊ g) ⟺ (z ∊ g) $ by iff_refl
a0: $ seqt q q $ by seqt_refl
a2: $ (q ∊ A) ⟺ (q ∊ B) $ by welc_congr [a0, #1]
a3: $ (z = nest q y) ⟺ (z = nest q y) $ by iff_refl
a4: $ (q ∊ A ∧ z = nest q y) ⟺ (q ∊ B ∧ z = nest q y) $ by and_congr [a2, a3]
a5: $ ∃ y (q ∊ A ∧ z = nest q y) ⟺ ∃ y (q ∊ B ∧ z = nest q y) $ by ex_congr [a4]
a6: $ ∃ q ∃ y (q ∊ A ∧ z = nest q y) ⟺ ∃ q ∃ y (q ∊ B ∧ z = nest q y) $ by ex_congr [a5]
a7: $ (z ∊ g → ∃ q ∃ y (q ∊ A ∧ z = nest q y)) ⟺ (z ∊ g → ∃ q ∃ y (q ∊ B ∧ z = nest q y)) $ by im_congr [a1, a6]
a8: $ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ A ∧ z = nest q y)) ⟺ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ B ∧ z = nest q y)) $ by all_congr [a7]
b2: $ apn g q ≐ apn g q $ by ceqt_refl
b3: $ (apn g q ∈ C) ⟺ (apn g q ∈ D) $ by wcel_congr [b2, #2]
b4: $ (q ∊ A → apn g q ∈ C) ⟺ (q ∊ B → apn g q ∈ D) $ by im_congr [a2, b3]
b5: $ ∀ q (q ∊ A → apn g q ∈ C) ⟺ ∀ q (q ∊ B → apn g q ∈ D) $ by all_congr [b4]
c1: $ (∀ z (z ∊ g → ∃ q ∃ y (q ∊ A ∧ z = nest q y)) ∧ ∀ q (q ∊ A → apn g q ∈ C)) ⟺ (∀ z (z ∊ g → ∃ q ∃ y (q ∊ B ∧ z = nest q y)) ∧ ∀ q (q ∊ B → apn g q ∈ D)) $ by and_congr [a8, b5]
c2: $ {g | ∀ z (z ∊ g → ∃ q ∃ y (q ∊ A ∧ z = nest q y)) ∧ ∀ q (q ∊ A → apn g q ∈ C)} ≐ {g | ∀ z (z ∊ g → ∃ q ∃ y (q ∊ B ∧ z = nest q y)) ∧ ∀ q (q ∊ B → apn g q ∈ D)} $ by cab_congr [c1]

sb_c_fpi
--------
l1: $ (⟦ x / t ⟧ {g | ∀ z (z ∊ g → ∃ q ∃ y (q ∊ A ∧ z = nest q y)) ∧ ∀ q (q ∊ A → apn g q ∈ B)}) ≐ {g | ∀ z (z ∊ g → ∃ q ∃ y (q ∊ (⟦ x / t ⟧ A) ∧ z = nest q y)) ∧ ∀ q (q ∊ (⟦ x / t ⟧ A) → apn g q ∈ (⟦ x / t ⟧ B))} $ by ceqt_refl

vat_congr
---------
a1: $ (k ∊ ω) ⟺ (k ∊ ω) $ by iff_refl
a2: $ suc E ≐ suc F $ by suc_congr [#3]
a3: $ cv k ≐ cv k $ by ceqt_refl
a4: $ nadd (suc E) k ≐ nadd (suc F) k $ by nadd_congr [a2, a3]
a5: $ (nadd (suc E) k = C) ⟺ (nadd (suc F) k = D) $ by ceq_congr [a4, #2]
a6: $ fv A k ≐ fv B k $ by fv_congr [#1, a3]
a7: $ seqt y y $ by seqt_refl
a8: $ (y ∊ fv A k) ⟺ (y ∊ fv B k) $ by welc_congr [a7, a6]
a9: $ (nadd (suc E) k = C ∧ y ∊ fv A k) ⟺ (nadd (suc F) k = D ∧ y ∊ fv B k) $ by and_congr [a5, a8]
a10: $ (k ∊ ω ∧ nadd (suc E) k = C ∧ y ∊ fv A k) ⟺ (k ∊ ω ∧ nadd (suc F) k = D ∧ y ∊ fv B k) $ by and_congr [a1, a9]
a11: $ ∃ k (k ∊ ω ∧ nadd (suc E) k = C ∧ y ∊ fv A k) ⟺ ∃ k (k ∊ ω ∧ nadd (suc F) k = D ∧ y ∊ fv B k) $ by ex_congr [a10]
a12: $ {y | ∃ k (k ∊ ω ∧ nadd (suc E) k = C ∧ y ∊ fv A k)} ≐ {y | ∃ k (k ∊ ω ∧ nadd (suc F) k = D ∧ y ∊ fv B k)} $ by cab_congr [a11]

sb_c_vat
--------
l1: $ (⟦ x / t ⟧ {y | ∃ k (k ∊ ω ∧ nadd (suc C) k = B ∧ y ∊ fv A k)}) ≐ {y | ∃ k (k ∊ ω ∧ nadd (suc (⟦ x / t ⟧ C)) k = (⟦ x / t ⟧ B) ∧ y ∊ fv (⟦ x / t ⟧ A) k)} $ by ceqt_refl

ivals_congr
-----------
b1: $ fseq A ≐ fseq B $ by fseq_congr [#1]
b2: $ seqt u u $ by seqt_refl
b3: $ (u ∊ fseq A) ⟺ (u ∊ fseq B) $ by welc_congr [b2, b1]
b4: $ cdm u ≐ cdm u $ by ceqt_refl
b5: $ (cdm u = C) ⟺ (cdm u = D) $ by ceq_congr [b4, #2]
b6: $ seqt j j $ by seqt_refl
b7: $ (j ∊ C) ⟺ (j ∊ D) $ by welc_congr [b6, #2]
b8: $ cv u ≐ cv u $ by ceqt_refl
b9: $ cv j ≐ cv j $ by ceqt_refl
b10: $ vat u C j ≐ vat u D j $ by vat_congr [b8, #2, b9]
b11: $ (vat u C j ∈ E) ⟺ (vat u D j ∈ F) $ by wcel_congr [b10, #3]
b12: $ (j ∊ C → vat u C j ∈ E) ⟺ (j ∊ D → vat u D j ∈ F) $ by im_congr [b7, b11]
b13: $ ∀ j (j ∊ C → vat u C j ∈ E) ⟺ ∀ j (j ∊ D → vat u D j ∈ F) $ by all_congr [b12]
b14: $ (cdm u = C ∧ ∀ j (j ∊ C → vat u C j ∈ E)) ⟺ (cdm u = D ∧ ∀ j (j ∊ D → vat u D j ∈ F)) $ by and_congr [b5, b13]
b15: $ (u ∊ fseq A ∧ cdm u = C ∧ ∀ j (j ∊ C → vat u C j ∈ E)) ⟺ (u ∊ fseq B ∧ cdm u = D ∧ ∀ j (j ∊ D → vat u D j ∈ F)) $ by and_congr [b3, b14]
b16: $ {u | u ∊ fseq A ∧ cdm u = C ∧ ∀ j (j ∊ C → vat u C j ∈ E)} ≐ {u | u ∊ fseq B ∧ cdm u = D ∧ ∀ j (j ∊ D → vat u D j ∈ F)} $ by cab_congr [b15]

sb_c_ivals
----------
l1: $ (⟦ x / t ⟧ {u | u ∊ fseq A ∧ cdm u = B ∧ ∀ j (j ∊ B → vat u B j ∈ C)}) ≐ {u | u ∊ fseq (⟦ x / t ⟧ A) ∧ cdm u = (⟦ x / t ⟧ B) ∧ ∀ j (j ∊ (⟦ x / t ⟧ B) → vat u (⟦ x / t ⟧ B) j ∈ (⟦ x / t ⟧ C))} $ by ceqt_refl

fpi_intro
---------
l1: $ G ⇒ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ Q ∧ z = nest q y)) ∧ ∀ q (q ∊ Q → apn g q ∈ B) $ by and_intro [#1, #2]
l2: $ G ⇒ g ∊ fpi q Q B $ by cab_intro [l1]

fpi_ap
------
l1: $ G ⇒ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ Q ∧ z = nest q y)) ∧ ∀ q (q ∊ Q → apn g q ∈ B) $ by cab_elim [#1]
l2: $ G ⇒ ∀ q (q ∊ Q → apn g q ∈ B) $ by and_elim_r [l1]
