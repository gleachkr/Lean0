lemma d2_pr (G: hyps) (A B: class): $ G ⇒ isset A $ > $ G ⇒ ⟨ A , B ⟩ = ⟨ A , ⋃ (crn (csn ⟨ A , B ⟩)) ⟩ $
----
p1: $ G ⇒ isset B ∨ ¬ isset B $ by excluded_middle
p2: $ G , isset B ⇒ isset A $ by weaken [#1]
p3: $ G , isset B ⇒ isset B $ by ax
p4: $ G , isset B ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = B $ by cuni_crn_csn_c [p2, p3]
p5: $ G , isset B ⇒ B = ⋃ (crn (csn ⟨ A , B ⟩)) $ by eq_sym [p4]
p6: $ G , isset B ⇒ A = A $ by eq_refl
p7: $ G , isset B ⇒ ⟨ A , B ⟩ = ⟨ A , ⋃ (crn (csn ⟨ A , B ⟩)) ⟩ $ by opair_eq [p6, p5]
q1: $ G , ¬ isset B ⇒ ¬ isset B $ by ax
q2: $ G , ¬ isset B ⇒ ⟨ A , B ⟩ = ⟨ A , A ⟩ $ by opair_proper [q1]
q3: $ G , ¬ isset B ⇒ csn ⟨ A , B ⟩ = csn ⟨ A , A ⟩ $ by csn_eq [q2]
q4: $ G , ¬ isset B ⇒ crn (csn ⟨ A , B ⟩) = crn (csn ⟨ A , A ⟩) $ by crn_eq [q3]
q5: $ G , ¬ isset B ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = ⋃ (crn (csn ⟨ A , A ⟩)) $ by cuni_eq [q4]
q6: $ G , ¬ isset B ⇒ isset A $ by weaken [#1]
q7: $ G , ¬ isset B ⇒ ⋃ (crn (csn ⟨ A , A ⟩)) = A $ by cuni_crn_csn_c [q6, q6]
q8: $ G , ¬ isset B ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = A $ by eq_trans [q5, q7]
q9: $ G , ¬ isset B ⇒ A = ⋃ (crn (csn ⟨ A , B ⟩)) $ by eq_sym [q8]
q10: $ G , ¬ isset B ⇒ A = A $ by eq_refl
q11: $ G , ¬ isset B ⇒ ⟨ A , A ⟩ = ⟨ A , ⋃ (crn (csn ⟨ A , B ⟩)) ⟩ $ by opair_eq [q10, q9]
q12: $ G , ¬ isset B ⇒ ⟨ A , B ⟩ = ⟨ A , ⋃ (crn (csn ⟨ A , B ⟩)) ⟩ $ by eq_trans [q2, q11]
q13: $ G ⇒ ⟨ A , B ⟩ = ⟨ A , ⋃ (crn (csn ⟨ A , B ⟩)) ⟩ $ by or_elim [p1, p7, q12]

lemma d2_fold (G: hyps) (A B C: class): $ G ⇒ isset A $ > $ G ⇒ C = ⟨ A , B ⟩ $ > $ G ⇒ C = ⟨ A , ⋃ (crn (csn C)) ⟩ $
----
f1: $ G ⇒ ⟨ A , B ⟩ = ⟨ A , ⋃ (crn (csn ⟨ A , B ⟩)) ⟩ $ by d2_pr [#1]
f2: $ G ⇒ ⟨ A , B ⟩ = C $ by eq_sym [#2]
f3: $ G ⇒ csn ⟨ A , B ⟩ = csn C $ by csn_eq [f2]
f4: $ G ⇒ crn (csn ⟨ A , B ⟩) = crn (csn C) $ by crn_eq [f3]
f5: $ G ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = ⋃ (crn (csn C)) $ by cuni_eq [f4]
f6: $ G ⇒ A = A $ by eq_refl
f7: $ G ⇒ ⟨ A , ⋃ (crn (csn ⟨ A , B ⟩)) ⟩ = ⟨ A , ⋃ (crn (csn C)) ⟩ $ by opair_eq [f6, f5]
f8: $ G ⇒ C = ⟨ A , ⋃ (crn (csn ⟨ A , B ⟩)) ⟩ $ by eq_trans [#2, f1]
f9: $ G ⇒ C = ⟨ A , ⋃ (crn (csn C)) ⟩ $ by eq_trans [f8, f7]

lemma d2_ihvs (G: hyps) (D K L g t N: class): $ G ⇒ isset (ihv D K L g t N) $
----
s1: $ G ⇒ isset (csn (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) N)) $ by cpr_isset
s2: $ G ⇒ isset (crn (csn (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) N))) $ by crn_set [s1]
s3: $ G ⇒ isset (ihv D K L g t N) $ by cuni_set [s2]

lemma d2_stfc {y i h z: set} (G: hyps y i h z) (D K L g t: class) (a b c d m e n: set):
  $ G ⇒ ⟨ a , b ⟩ = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ $ > $ G ⇒ ⟨ a , c ⟩ = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ $ > $ G ⇒ b = c $
----
k1: $ G ⇒ isset a $ by isset_var
k2: $ G ⇒ isset b $ by isset_var
k3: $ G ⇒ isset c $ by isset_var
k4: $ G ⇒ isset ⟨ d , m ⟩ $ by opair_isset
k5: $ G ⇒ isset ⟨ e , n ⟩ $ by opair_isset
k6: $ G ⇒ isset ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by opair_isset
k7: $ G ⇒ isset ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ $ by opair_isset
k8: $ G ⇒ a = ⟨ d , m ⟩ ∧ b = ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by opair_inj_c [#1, k1, k2, k4, k6]
k9: $ G ⇒ a = ⟨ e , n ⟩ ∧ c = ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ $ by opair_inj_c [#2, k1, k3, k5, k7]
k10: $ G ⇒ a = ⟨ d , m ⟩ $ by and_elim_l [k8]
k11: $ G ⇒ a = ⟨ e , n ⟩ $ by and_elim_l [k9]
k12: $ G ⇒ ⟨ d , m ⟩ = a $ by eq_sym [k10]
k13: $ G ⇒ ⟨ d , m ⟩ = ⟨ e , n ⟩ $ by eq_trans [k12, k11]
k14: $ G ⇒ d = e $ by opair_inj_l [k13]
k15: $ G ⇒ m = n $ by opair_inj_r [k13]
k16: $ G ⇒ ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ = ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by eq_refl
k17: $ G ⇒ ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ = ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ m ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ $ by eq_replace [k14, k16]
k18: $ G ⇒ ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ = ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ $ by eq_replace [k15, k17]
k19: $ G ⇒ b = ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by and_elim_r [k8]
k20: $ G ⇒ c = ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ $ by and_elim_r [k9]
k21: $ G ⇒ b = ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ $ by eq_trans [k19, k18]
k22: $ G ⇒ ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ = c $ by eq_sym [k20]
k23: $ G ⇒ b = c $ by eq_trans [k21, k22]

lemma d2_stf (G: hyps) (D K L g t: class): $ G ⇒ functional (ihst D K L g t) $
----
f1: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t ⇒ ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t $ by ax
f2: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t ⇒ ⟨ a , b ⟩ ∈ ihst D K L g t $ by and_elim_l [f1]
f3: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t ⇒ ⟨ a , c ⟩ ∈ ihst D K L g t $ by and_elim_r [f1]
j1: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t ⇒ u ∊ ihst D K L g t $ by ax
j2: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t ⇒ ∃ d ∃ m (u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩) $ by cab_elim [j1]
j3: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t ⇒ v ∊ ihst D K L g t $ by ax
j4: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t ⇒ ∃ e ∃ n (v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩) $ by cab_elim [j3]
j5: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ u = ⟨ a , b ⟩ $ by ax
j6: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ $ by ax
j7: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ ⟨ a , b ⟩ = u $ by eq_sym [j5]
j8: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ ⟨ a , b ⟩ = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ $ by eq_trans [j7, j6]
j9: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ v = ⟨ a , c ⟩ $ by ax
j10: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ $ by ax
j11: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ ⟨ a , c ⟩ = v $ by eq_sym [j9]
j12: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ ⟨ a , c ⟩ = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ $ by eq_trans [j11, j10]
j13: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩ ⇒ b = c $ by d2_stfc [j8, j12]
j14: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , ∃ n (v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩) ⇒ ∃ n (v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩) $ by ax
j15: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ , ∃ n (v = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩) ⇒ b = c $ by ex_elim [j14, j13]
j18: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ ⇒ b = c $ by ex_elim [j4, j15]
j19: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , ∃ m (u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩) ⇒ ∃ m (u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩) $ by ax
j20: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t , ∃ m (u = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩) ⇒ b = c $ by ex_elim [j19, j18]
j21: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t , v = ⟨ a , c ⟩ , v ∊ ihst D K L g t ⇒ b = c $ by ex_elim [j2, j20]
j22: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t , u = ⟨ a , b ⟩ , u ∊ ihst D K L g t ⇒ b = c $ by wcel_elim [f3, j21]
j23: $ G , ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t ⇒ b = c $ by wcel_elim [f2, j22]
j24: $ G ⇒ ⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t → b = c $ by imp_intro [j23]
j25: $ G ⇒ ∀ c (⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t → b = c) $ by all_intro [j24]
j26: $ G ⇒ ∀ b ∀ c (⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t → b = c) $ by all_intro [j25]
j27: $ G ⇒ ∀ a ∀ b ∀ c (⟨ a , b ⟩ ∈ ihst D K L g t ∧ ⟨ a , c ⟩ ∈ ihst D K L g t → b = c) $ by all_intro [j26]

lemma d2_stv {y i h z: set} (G: hyps) (D K L g t: class) (d m: set):
  $ G ⇒ fv (ihst D K L g t) ⟨ d , m ⟩ = ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $
----
v1: $ G ⇒ functional (ihst D K L g t) $ by d2_stf
v2: $ G , o = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ ⇒ o = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ $ by ax
v3: $ G , o = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ ⇒ ∃ n (o = ⟨ ⟨ d , n ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ n ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩) $ by ex_intro [v2]
v4: $ G , o = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ ⇒ ∃ e ∃ n (o = ⟨ ⟨ e , n ⟩ , ⟨ suc e , {y | (¬ ∃ i (irf D K e i) ∧ y ∊ n) ∨ ∃ i ∃ h ∃ z (irf D K e i ∧ z ∊ n ∧ h ∊ ihsp L g t e i ∧ y = scons h z)} ⟩ ⟩) $ by ex_intro [v3]
v5: $ G ⇒ isset ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ $ by opair_isset
v6a: $ G , o = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ ⇒ o ∊ ihst D K L g t $ by cab_intro [v4]
v6b: $ G , o = ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ ⇒ ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ ∈ ihst D K L g t $ by wcel_intro [v2, v6a]
v6: $ G ⇒ ⟨ ⟨ d , m ⟩ , ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ ⟩ ∈ ihst D K L g t $ by isset_elim [v5, v6b]
v7: $ G ⇒ isset ⟨ d , m ⟩ $ by opair_isset
v8: $ G ⇒ isset ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by opair_isset
v9: $ G ⇒ fv (ihst D K L g t) ⟨ d , m ⟩ = ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by fv_val_c [v1, v6, v7, v8]

lemma d2_st (G: hyps) (D K L g t: class) (n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) n = ⟨ n , ihv D K L g t n ⟩ $
----
z1: $ G , u = ∅ ⇒ u = ∅ $ by ax
z2: $ G , u = ∅ ⇒ isset ⟨ ∅ , csn ∅ ⟩ $ by opair_isset
z3: $ G , u = ∅ ⇒ functional (ihst D K L g t) $ by d2_stf
z4: $ G , u = ∅ ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) ∅ = ⟨ ∅ , csn ∅ ⟩ $ by omrec_zero [z2, z3]
z5: $ G , u = ∅ ⇒ omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t) = omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t) $ by eq_refl
z6: $ G , u = ∅ ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) ∅ $ by fv_eq [z5, z1]
z7: $ G , u = ∅ ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = ⟨ ∅ , csn ∅ ⟩ $ by eq_trans [z6, z4]
z8: $ G , u = ∅ ⇒ ∅ = u $ by eq_sym [z1]
z9: $ G , u = ∅ ⇒ csn ∅ = csn ∅ $ by eq_refl
z10: $ G , u = ∅ ⇒ ⟨ ∅ , csn ∅ ⟩ = ⟨ u , csn ∅ ⟩ $ by opair_eq [z8, z9]
z11: $ G , u = ∅ ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = ⟨ u , csn ∅ ⟩ $ by eq_trans [z7, z10]
z12: $ G , u = ∅ ⇒ isset u $ by isset_var
z13: $ G , u = ∅ ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = ⟨ u , ihv D K L g t u ⟩ $ by d2_fold [z12, z11]
s1: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ v ∊ ω $ by ax
s2: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ isset ⟨ ∅ , csn ∅ ⟩ $ by opair_isset
s3: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ functional (ihst D K L g t) $ by d2_stf
s4: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) (suc v) = fv (ihst D K L g t) (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v) $ by omrec_suc [s2, s3, s1]
s5: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ $ by ax
s6: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ ihst D K L g t = ihst D K L g t $ by eq_refl
s7: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ fv (ihst D K L g t) (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v) = fv (ihst D K L g t) ⟨ v , ihv D K L g t v ⟩ $ by fv_eq [s6, s5]
s8: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ m = ihv D K L g t v $ by ax
s9: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ ihv D K L g t v = m $ by eq_sym [s8]
s10: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ v = v $ by eq_refl
s11: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ ⟨ v , ihv D K L g t v ⟩ = ⟨ v , m ⟩ $ by opair_eq [s10, s9]
s12: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ ihst D K L g t = ihst D K L g t $ by eq_refl
s13: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (ihst D K L g t) ⟨ v , ihv D K L g t v ⟩ = fv (ihst D K L g t) ⟨ v , m ⟩ $ by fv_eq [s12, s11]
s14: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (ihst D K L g t) ⟨ v , m ⟩ = ⟨ suc v , {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} ⟩ $ by d2_stv
s15: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ u = suc v $ by ax
s16: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t) = omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t) $ by eq_refl
s17: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) (suc v) $ by fv_eq [s16, s15]
s18: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) (suc v) = fv (ihst D K L g t) (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v) $ by weaken [s4]
s19: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (ihst D K L g t) (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v) = fv (ihst D K L g t) ⟨ v , ihv D K L g t v ⟩ $ by weaken [s7]
s20: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = fv (ihst D K L g t) (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v) $ by eq_trans [s17, s18]
s21: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = fv (ihst D K L g t) ⟨ v , ihv D K L g t v ⟩ $ by eq_trans [s20, s19]
s22: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = fv (ihst D K L g t) ⟨ v , m ⟩ $ by eq_trans [s21, s13]
s23: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = ⟨ suc v , {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} ⟩ $ by eq_trans [s22, s14]
s24: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ suc v = u $ by eq_sym [s15]
s25: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} = {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} $ by eq_refl
s26: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ ⟨ suc v , {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} ⟩ = ⟨ u , {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} ⟩ $ by opair_eq [s24, s25]
s27: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = ⟨ u , {y | (¬ ∃ i (irf D K v i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K v i ∧ z ∊ m ∧ h ∊ ihsp L g t v i ∧ y = scons h z)} ⟩ $ by eq_trans [s23, s26]
s28: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ isset u $ by isset_var
s29: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v , m = ihv D K L g t v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = ⟨ u , ihv D K L g t u ⟩ $ by d2_fold [s28, s27]
s30: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ isset (ihv D K L g t v) $ by d2_ihvs
s31: $ G , v ∊ ω , fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) v = ⟨ v , ihv D K L g t v ⟩ , u = suc v ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) u = ⟨ u , ihv D K L g t u ⟩ $ by isset_elim [s30, s29]
i1: $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) n = ⟨ n , ihv D K L g t n ⟩ $ by omega_ind_named [z13, s31, #1]

lemma d2_suc {y i h z: set} (G: hyps) (D K L g t: class) (d m: set):
  $ G ⇒ d ∊ ω $ > $ G ⇒ m = ihv D K L g t d $ > $ G ⇒ ihv D K L g t (suc d) = ⋃ (crn (csn ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩)) $
----
u1: $ G ⇒ isset ⟨ ∅ , csn ∅ ⟩ $ by opair_isset
u2: $ G ⇒ functional (ihst D K L g t) $ by d2_stf
u3: $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) (suc d) = fv (ihst D K L g t) (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) d) $ by omrec_suc [u1, u2, #1]
u4: $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) d = ⟨ d , ihv D K L g t d ⟩ $ by d2_st [#1]
u5: $ G ⇒ ihv D K L g t d = m $ by eq_sym [#2]
u6: $ G ⇒ d = d $ by eq_refl
u7: $ G ⇒ ⟨ d , ihv D K L g t d ⟩ = ⟨ d , m ⟩ $ by opair_eq [u6, u5]
u8: $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) d = ⟨ d , m ⟩ $ by eq_trans [u4, u7]
u9: $ G ⇒ ihst D K L g t = ihst D K L g t $ by eq_refl
u10: $ G ⇒ fv (ihst D K L g t) (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) d) = fv (ihst D K L g t) ⟨ d , m ⟩ $ by fv_eq [u9, u8]
u11: $ G ⇒ fv (ihst D K L g t) ⟨ d , m ⟩ = ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by d2_stv
u12: $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) (suc d) = fv (ihst D K L g t) ⟨ d , m ⟩ $ by eq_trans [u3, u10]
u13: $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) (suc d) = ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by eq_trans [u12, u11]
u14: $ G ⇒ csn (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) (suc d)) = csn ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ $ by csn_eq [u13]
u15: $ G ⇒ crn (csn (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) (suc d))) = crn (csn ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩) $ by crn_eq [u14]
u16: $ G ⇒ ihv D K L g t (suc d) = ⋃ (crn (csn ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩)) $ by cuni_eq [u15]

ihv_zero
--------
a1: $ G ⇒ isset ⟨ ∅ , csn ∅ ⟩ $ by opair_isset
a2: $ G ⇒ functional (ihst D K L g t) $ by d2_stf
a3: $ G ⇒ fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) ∅ = ⟨ ∅ , csn ∅ ⟩ $ by omrec_zero [a1, a2]
a4: $ G ⇒ csn (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) ∅) = csn ⟨ ∅ , csn ∅ ⟩ $ by csn_eq [a3]
a5: $ G ⇒ crn (csn (fv (omrec ⟨ ∅ , csn ∅ ⟩ (ihst D K L g t)) ∅)) = crn (csn ⟨ ∅ , csn ∅ ⟩) $ by crn_eq [a4]
a6: $ G ⇒ ihv D K L g t ∅ = ⋃ (crn (csn ⟨ ∅ , csn ∅ ⟩)) $ by cuni_eq [a5]
a7: $ G ⇒ isset ∅ $ by ax_empty
a8: $ G ⇒ isset (csn ∅) $ by csn_set [a7]
a9: $ G ⇒ ⋃ (crn (csn ⟨ ∅ , csn ∅ ⟩)) = csn ∅ $ by cuni_crn_csn_c [a7, a8]
a10: $ G ⇒ ihv D K L g t ∅ = csn ∅ $ by eq_trans [a6, a9]

ihv_suc_nr
----------
n1: $ G , m = ihv D K L g t d ⇒ d ∊ ω $ by weaken [#1]
n2: $ G , m = ihv D K L g t d ⇒ m = ihv D K L g t d $ by ax
n3: $ G , m = ihv D K L g t d ⇒ ihv D K L g t (suc d) = ⋃ (crn (csn ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩)) $ by d2_suc [n1, n2]
y1: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⇒ o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} $ by ax
y2: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⇒ (¬ ∃ i (irf D K d i) ∧ o ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) $ by cab_elim [y1]
y3: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} , ¬ ∃ i (irf D K d i) ∧ o ∊ m ⇒ ¬ ∃ i (irf D K d i) ∧ o ∊ m $ by ax
y4: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} , ¬ ∃ i (irf D K d i) ∧ o ∊ m ⇒ o ∊ m $ by and_elim_r [y3]
e1: $ G , irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z ⇒ irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z $ by ax
e2: $ G , irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z ⇒ irf D K d i $ by and_elim_l [e1]
e3: $ G , ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) $ by ax
e4: $ G , ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ irf D K d i $ by ex_elim [e3, e2]
e5: $ G , ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) $ by ax
e6: $ G , ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ irf D K d i $ by ex_elim [e5, e4]
e7: $ G ⇒ ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) → irf D K d i $ by imp_intro [e6]
e8: $ G ⇒ ∀ i (∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) → irf D K d i) $ by all_intro [e7]
e9: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} , ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) $ by ax
e10: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} , ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ ∀ i (∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) → irf D K d i) $ by weaken [e8]
e11: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} , ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ ∃ i (irf D K d i) $ by ex_mp [e10, e9]
e12: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} , ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ ¬ ∃ i (irf D K d i) $ by weaken [#2]
e13: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} , ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ ⊥ $ by not_elim [e12, e11]
e14: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} , ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) ⇒ o ∊ m $ by bot_elim [e13]
y5: $ G , m = ihv D K L g t d , o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⇒ o ∊ m $ by or_elim [y2, y4, e14]
y6: $ G , m = ihv D K L g t d ⇒ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⊆ m $ by subset_intro [y5]
w1: $ G , m = ihv D K L g t d , o ∊ m ⇒ o ∊ m $ by ax
w2: $ G , m = ihv D K L g t d , o ∊ m ⇒ ¬ ∃ i (irf D K d i) $ by weaken [#2]
w3: $ G , m = ihv D K L g t d , o ∊ m ⇒ ¬ ∃ i (irf D K d i) ∧ o ∊ m $ by and_intro [w2, w1]
w4: $ G , m = ihv D K L g t d , o ∊ m ⇒ (¬ ∃ i (irf D K d i) ∧ o ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ o = scons h z) $ by or_intro_l [w3]
w5: $ G , m = ihv D K L g t d , o ∊ m ⇒ o ∊ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} $ by cab_intro [w4]
w6: $ G , m = ihv D K L g t d ⇒ m ⊆ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} $ by subset_intro [w5]
w7: $ G , m = ihv D K L g t d ⇒ {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} = m $ by subset_antisym [y6, w6]
n4: $ G , m = ihv D K L g t d ⇒ suc d = suc d $ by eq_refl
n5: $ G , m = ihv D K L g t d ⇒ ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ = ⟨ suc d , m ⟩ $ by opair_eq [n4, w7]
n6: $ G , m = ihv D K L g t d ⇒ csn ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩ = csn ⟨ suc d , m ⟩ $ by csn_eq [n5]
n7: $ G , m = ihv D K L g t d ⇒ crn (csn ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩) = crn (csn ⟨ suc d , m ⟩) $ by crn_eq [n6]
n8: $ G , m = ihv D K L g t d ⇒ ⋃ (crn (csn ⟨ suc d , {y | (¬ ∃ i (irf D K d i) ∧ y ∊ m) ∨ ∃ i ∃ h ∃ z (irf D K d i ∧ z ∊ m ∧ h ∊ ihsp L g t d i ∧ y = scons h z)} ⟩)) = ⋃ (crn (csn ⟨ suc d , m ⟩)) $ by cuni_eq [n7]
n9: $ G , m = ihv D K L g t d ⇒ isset d $ by isset_var
n10: $ G , m = ihv D K L g t d ⇒ isset (suc d) $ by suc_set [n9]
n11: $ G , m = ihv D K L g t d ⇒ isset m $ by isset_var
n12: $ G , m = ihv D K L g t d ⇒ ⋃ (crn (csn ⟨ suc d , m ⟩)) = m $ by cuni_crn_csn_c [n10, n11]
n13: $ G , m = ihv D K L g t d ⇒ ihv D K L g t (suc d) = ⋃ (crn (csn ⟨ suc d , m ⟩)) $ by eq_trans [n3, n8]
n14: $ G , m = ihv D K L g t d ⇒ ihv D K L g t (suc d) = m $ by eq_trans [n13, n12]
n15: $ G , m = ihv D K L g t d ⇒ ihv D K L g t (suc d) = ihv D K L g t d $ by eq_trans [n14, n2]
n16: $ G ⇒ isset (ihv D K L g t d) $ by d2_ihvs
n17: $ G ⇒ ihv D K L g t (suc d) = ihv D K L g t d $ by isset_elim [n16, n15]

