l7: $ G , g ∊ fpi q Q B , v ∊ Q ⇒ ∀ q (q ∊ Q → B ⊆ C) $ by weaken [#1]
l8: $ G , g ∊ fpi q Q B , v ∊ Q ⇒ v ∊ Q → (⟦ q / v ⟧ B) ⊆ (⟦ q / v ⟧ C) $ by all_elim [l7]
l9: $ G , g ∊ fpi q Q B , v ∊ Q ⇒ (⟦ q / v ⟧ B) ⊆ (⟦ q / v ⟧ C) $ by imp_elim [l8, l5]
l10: $ G , g ∊ fpi q Q B , v ∊ Q ⇒ apn g v ∈ (⟦ q / v ⟧ C) $ by wcel_subset [l9, l6]
l11: $ G , g ∊ fpi q Q B ⇒ v ∊ Q → apn g v ∈ (⟦ q / v ⟧ C) $ by imp_intro [l10]
l12: $ G , g ∊ fpi q Q B ⇒ ∀ v (v ∊ Q → apn g v ∈ (⟦ q / v ⟧ C)) $ by all_intro [l11]
l13: $ ∀ q (q ∊ Q → apn g q ∈ C) ⟺ ∀ v (v ∊ Q → apn g v ∈ (⟦ q / v ⟧ C)) $ by all_alpha
l14: $ G , g ∊ fpi q Q B ⇒ ∀ q (q ∊ Q → apn g q ∈ C) ↔ ∀ v (v ∊ Q → apn g v ∈ (⟦ q / v ⟧ C)) $ by weaken [l13]
l15: $ G , g ∊ fpi q Q B ⇒ ∀ q (q ∊ Q → apn g q ∈ C) $ by bi_elim_r [l14, l12]
l16a: $ G , g ∊ fpi q Q B ⇒ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ Q ∧ z = nest q y)) ∧ ∀ q (q ∊ Q → apn g q ∈ C) $ by and_intro [l3, l15]
l16: $ G , g ∊ fpi q Q B ⇒ g ∊ fpi q Q C $ by cab_intro [l16a]
l17: $ G ⇒ fpi q Q B ⊆ fpi q Q C $ by subset_intro [l16]

lemma d1_fpi_sub {q: set} (G: hyps) (Q: class) (B: class q) (g h: set):
  $ G ⇒ g ∊ fpi q Q B $ > $ G ⇒ ∀ q (q ∊ Q → apn g q ⊆ apn h q) $ > $ G ⇒ g ⊆ h $
----
l1: $ G , z ∊ g ⇒ z ∊ g $ by ax
l2: $ G , z ∊ g ⇒ g ∊ fpi q Q B $ by weaken [#1]
l3: $ G , z ∊ g ⇒ ∃ q ∃ y (q ∊ Q ∧ z = nest q y) $ by fpi_pts [l2, l1]
m1: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ q ∊ Q ∧ z = nest q y $ by ax
m2: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ q ∊ Q $ by and_elim_l [m1]
m3: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ z = nest q y $ by and_elim_r [m1]
m4: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ z ∊ g $ by ax
m4b: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ z ∈ g $ by welc_wcel [m4]
m5: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ nest q y ∈ g $ by wcel_eq_l [m3, m4b]
m6: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ y ∊ apn g q $ by cab_intro [m5]
m7: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ ∀ q (q ∊ Q → apn g q ⊆ apn h q) $ by weaken [#2]
m8: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ q ∊ Q → apn g q ⊆ apn h q $ by all_elim [m7]
m9: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ apn g q ⊆ apn h q $ by imp_elim [m8, m2]
m10: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ y ∊ apn h q $ by subset_elim [m9, m6]
m11: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ nest q y ∈ h $ by cab_elim [m10]
m12: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ nest q y = z $ by eq_sym [m3]
m13: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ z ∈ h $ by wcel_eq_l [m12, m11]
m14: $ G , z ∊ g , q ∊ Q ∧ z = nest q y ⇒ z ∊ h $ by wcel_welc [m13]
n1: $ G , z ∊ g , ∃ y (q ∊ Q ∧ z = nest q y) ⇒ ∃ y (q ∊ Q ∧ z = nest q y) $ by ax
n2: $ G , z ∊ g , ∃ y (q ∊ Q ∧ z = nest q y) ⇒ z ∊ h $ by ex_elim [n1, m14]
n3: $ G , z ∊ g ⇒ z ∊ h $ by ex_elim [l3, n2]
n4: $ G ⇒ g ⊆ h $ by subset_intro [n3]

fpi_ext
-------
a1: $ G , q ∊ Q ⇒ q ∊ Q $ by ax
a2: $ G , q ∊ Q ⇒ ∀ q (q ∊ Q → apn g q = apn h q) $ by weaken [#3]
a3: $ G , q ∊ Q ⇒ q ∊ Q → apn g q = apn h q $ by all_elim [a2]
a4: $ G , q ∊ Q ⇒ apn g q = apn h q $ by imp_elim [a3, a1]
a5: $ G , q ∊ Q ⇒ apn g q ⊆ apn h q $ by eq_subset [a4]
a6: $ G , q ∊ Q ⇒ apn h q = apn g q $ by eq_sym [a4]
a7: $ G , q ∊ Q ⇒ apn h q ⊆ apn g q $ by eq_subset [a6]
a8: $ G ⇒ q ∊ Q → apn g q ⊆ apn h q $ by imp_intro [a5]
a9: $ G ⇒ q ∊ Q → apn h q ⊆ apn g q $ by imp_intro [a7]
b1: $ G ⇒ ∀ q (q ∊ Q → apn g q ⊆ apn h q) $ by all_intro [a8]
b2: $ G ⇒ ∀ q (q ∊ Q → apn h q ⊆ apn g q) $ by all_intro [a9]
b3: $ G ⇒ g ⊆ h $ by d1_fpi_sub [#1, b1]
b4: $ G ⇒ h ⊆ g $ by d1_fpi_sub [#2, b2]
b5: $ G ⇒ g = h $ by subset_antisym [b3, b4]

fpi_sub
-------
u1: $ G , g ∊ fpi q Q B ⇒ g ∊ fpi q Q B $ by ax
u2: $ G , g ∊ fpi q Q B ⇒ ∀ z (z ∊ g → ∃ q ∃ y (q ∊ Q ∧ z = nest q y)) ∧ ∀ q (q ∊ Q → apn g q ∈ B) $ by cab_elim [u1]
