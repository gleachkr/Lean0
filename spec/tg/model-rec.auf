lemma d1_nctor_s {f g j: set} (G: hyps) (t h a y: set):
  $ G ⇒ ra_nth_ctor t h a ∈ lrel $ > $ G ⇒ fv nvf h = suc y $ > $ G ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by lrel_nth_ctor_cases [#1]
l2: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 $ by ax
l3: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 $ by and_elim_r [l2]
l5: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ h = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l4]
l6: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ a = x1 $ by and_elim_r [l4]
l7: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ nvf = nvf $ by eq_refl
l8: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ fv nvf h = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [l7, l5]
l9: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l10: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ fv nvf h = ∅ $ by eq_trans [l8, l9]
l11: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ fv nvf h = suc y $ by weaken [#2]
l12: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ suc y = fv nvf h $ by eq_sym [l11]
l13: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ suc y = ∅ $ by eq_trans [l12, l10]
l14: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ ⊥ $ by suc_ne_empty [l13]
l15: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ ∃ f ∃ g ∃ j (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ fv nvf j = y ∧ ra_nth_ctor g j a ∈ lrel) $ by bot_elim [l14]
l16: $ G , ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ⇒ ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) $ by ax
