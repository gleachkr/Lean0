l46: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ ra_minor_idx t a b e ∈ lrel → ra_minor_idx t u v w ∈ lrel → fv nvf a = x → fv nvf u = x → fv nvf e = fv nvf w $ by all_elim (t := $ w $) [l45]
l47: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ fv nvf u = x $ by eq_trans [l32, l38]
l48: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ ra_minor_idx t u v w ∈ lrel → fv nvf a = x → fv nvf u = x → fv nvf e = fv nvf w $ by imp_elim [l46, l11]
l49: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ fv nvf a = x → fv nvf u = x → fv nvf e = fv nvf w $ by imp_elim [l48, l28]
l50: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ fv nvf u = x → fv nvf e = fv nvf w $ by imp_elim [l49, l38]
l51: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ fv nvf e = fv nvf w $ by imp_elim [l50, l47]
l52: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ k = fv nvf e $ by eq_sym [l10]
l53: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ k = fv nvf w $ by eq_trans [l52, l51]
l54: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel , x = fv nvf a ⇒ k = k2 $ by eq_trans [l53, l19]
l55: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel ⇒ k = k2 $ by isset_elim [l34, l54]
l56: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) ⇒ ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) $ by ax
l57: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) ⇒ k = k2 $ by ex_elim [l56, l55]
l58: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) ⇒ ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) $ by ax
l59: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) ⇒ k = k2 $ by ex_elim [l58, l57]
l60: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , ∃ u ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) ⇒ ∃ u ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) $ by ax
l61: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , ∃ u ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) ⇒ k = k2 $ by ex_elim [l60, l59]
l62: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , ∃ q ∃ u ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) ⇒ ∃ q ∃ u ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) $ by ax
l63: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel , ∃ q ∃ u ∃ v ∃ w (iprt D o q ∧ fv nvf u = i ∧ fv nvf v = c ∧ fv nvf w = k2 ∧ ra_minor_idx q u v w ∈ lrel) ⇒ k = k2 $ by ex_elim [l62, l61]
l64: $ G , iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel ⇒ k = k2 $ by ex_elim [l2, l63]
l65: $ G , ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) ⇒ ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) $ by ax
l66: $ G , ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) ⇒ k = k2 $ by ex_elim [l65, l64]
l67: $ G , ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) ⇒ ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) $ by ax
l68: $ G , ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) ⇒ k = k2 $ by ex_elim [l67, l66]
l69: $ G , ∃ a ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) ⇒ ∃ a ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) $ by ax
l70: $ G , ∃ a ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) ⇒ k = k2 $ by ex_elim [l69, l68]
l71: $ G , ∃ t ∃ a ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) ⇒ ∃ t ∃ a ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) $ by ax
l72: $ G , ∃ t ∃ a ∃ b ∃ e (iprt D p t ∧ fv nvf a = i ∧ fv nvf b = c ∧ fv nvf e = k ∧ ra_minor_idx t a b e ∈ lrel) ⇒ k = k2 $ by ex_elim [l71, l70]
l73: $ G ⇒ k = k2 $ by ex_elim [l1, l72]

minor_idx_nvf
-------------
l0: $ G ⇒ isset a $ by isset_var
l1: $ G ⇒ fv nvf a ∈ ω $ by nvf_omega [l0]
l2: $ G , x = fv nvf a , x ∊ ω ⇒ fv nvf b = fv nvf b2 $ by weaken [#4]
l3: $ G , x = fv nvf a , x ∊ ω ⇒ x ∊ ω $ by ax
l4: $ G , x = fv nvf a , x ∊ ω ⇒ ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (ra_minor_idx x5 x6 b x7 ∈ lrel → ra_minor_idx x5 x8 b2 x9 ∈ lrel → fv nvf x6 = x → fv nvf x8 = x → fv nvf x7 = fv nvf x9) $ by d1_midx_det_ind [l2, l3]
l5: $ G , x = fv nvf a , x ∊ ω ⇒ ∀ x6 ∀ x7 ∀ x8 ∀ x9 (ra_minor_idx t x6 b x7 ∈ lrel → ra_minor_idx t x8 b2 x9 ∈ lrel → fv nvf x6 = x → fv nvf x8 = x → fv nvf x7 = fv nvf x9) $ by all_elim [l4]
l6: $ G , x = fv nvf a , x ∊ ω ⇒ ∀ x7 ∀ x8 ∀ x9 (ra_minor_idx t a b x7 ∈ lrel → ra_minor_idx t x8 b2 x9 ∈ lrel → fv nvf a = x → fv nvf x8 = x → fv nvf x7 = fv nvf x9) $ by all_elim [l5]
l7: $ G , x = fv nvf a , x ∊ ω ⇒ ∀ x8 ∀ x9 (ra_minor_idx t a b e ∈ lrel → ra_minor_idx t x8 b2 x9 ∈ lrel → fv nvf a = x → fv nvf x8 = x → fv nvf e = fv nvf x9) $ by all_elim [l6]
l8: $ G , x = fv nvf a , x ∊ ω ⇒ ∀ x9 (ra_minor_idx t a b e ∈ lrel → ra_minor_idx t a2 b2 x9 ∈ lrel → fv nvf a = x → fv nvf a2 = x → fv nvf e = fv nvf x9) $ by all_elim [l7]
l9: $ G , x = fv nvf a , x ∊ ω ⇒ ra_minor_idx t a b e ∈ lrel → ra_minor_idx t a2 b2 e2 ∈ lrel → fv nvf a = x → fv nvf a2 = x → fv nvf e = fv nvf e2 $ by all_elim [l8]
l10: $ G , x = fv nvf a , x ∊ ω ⇒ ra_minor_idx t a b e ∈ lrel $ by weaken [#1]
l11: $ G , x = fv nvf a , x ∊ ω ⇒ ra_minor_idx t a2 b2 e2 ∈ lrel $ by weaken [#2]
l12: $ G , x = fv nvf a , x ∊ ω ⇒ x = fv nvf a $ by ax
l13: $ G , x = fv nvf a , x ∊ ω ⇒ fv nvf a = x $ by eq_sym [l12]
l14: $ G , x = fv nvf a , x ∊ ω ⇒ fv nvf a = fv nvf a2 $ by weaken [#3]
l15: $ G , x = fv nvf a , x ∊ ω ⇒ fv nvf a2 = fv nvf a $ by eq_sym [l14]
l16: $ G , x = fv nvf a , x ∊ ω ⇒ fv nvf a2 = x $ by eq_trans [l15, l13]
l17: $ G , x = fv nvf a , x ∊ ω ⇒ ra_minor_idx t a2 b2 e2 ∈ lrel → fv nvf a = x → fv nvf a2 = x → fv nvf e = fv nvf e2 $ by imp_elim [l9, l10]
l18: $ G , x = fv nvf a , x ∊ ω ⇒ fv nvf a = x → fv nvf a2 = x → fv nvf e = fv nvf e2 $ by imp_elim [l17, l11]
l19: $ G , x = fv nvf a , x ∊ ω ⇒ fv nvf a2 = x → fv nvf e = fv nvf e2 $ by imp_elim [l18, l13]
l20: $ G , x = fv nvf a , x ∊ ω ⇒ fv nvf e = fv nvf e2 $ by imp_elim [l19, l16]
l21: $ G ⇒ fv nvf e = fv nvf e2 $ by wcel_elim [l1, l20]

def d1_bd (T a b: class) (.n .f .c .m .k: set): fml = $ ∃ n ∃ f ∃ c ∃ m ∃ k (fv nvf n = fv nvf a ∧ ra_nth_ty T n f c ∈ lrel ∧ fv nvf m = fv nvf b ∧ ra_nth_ctor c m k ∈ lrel) $

--| @congr
lemma d1_bd_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ d1_bd A C E ⟺ d1_bd B D F $
----
c1: $ cv n ≐ cv n $ by ceqt_refl
c2: $ cv f ≐ cv f $ by ceqt_refl
c3: $ cv c ≐ cv c $ by ceqt_refl
c4: $ cv m ≐ cv m $ by ceqt_refl
c5: $ nvf ≐ nvf $ by ceqt_refl
c6: $ lrel ≐ lrel $ by ceqt_refl
c7: $ fv nvf n ≐ fv nvf n $ by ceqt_refl
c8: $ fv nvf m ≐ fv nvf m $ by ceqt_refl
c9: $ fv nvf C ≐ fv nvf D $ by fv_congr [c5, #2]
c10: $ fv nvf E ≐ fv nvf F $ by fv_congr [c5, #3]
c11: $ (fv nvf n = fv nvf C) ⟺ (fv nvf n = fv nvf D) $ by ceq_congr [c7, c9]
c12: $ ra_nth_ty A n f c ≐ ra_nth_ty B n f c $ by ra_nth_ty_congr [#1, c1, c2, c3]
c13: $ (ra_nth_ty A n f c ∈ lrel) ⟺ (ra_nth_ty B n f c ∈ lrel) $ by wcel_congr [c12, c6]
c14: $ (fv nvf m = fv nvf E) ⟺ (fv nvf m = fv nvf F) $ by ceq_congr [c8, c10]
c15: $ (ra_nth_ctor c m k ∈ lrel) ⟺ (ra_nth_ctor c m k ∈ lrel) $ by iff_refl
c16: $ (fv nvf m = fv nvf E ∧ ra_nth_ctor c m k ∈ lrel) ⟺ (fv nvf m = fv nvf F ∧ ra_nth_ctor c m k ∈ lrel) $ by and_congr [c14, c15]
c17: $ (ra_nth_ty A n f c ∈ lrel ∧ fv nvf m = fv nvf E ∧ ra_nth_ctor c m k ∈ lrel) ⟺ (ra_nth_ty B n f c ∈ lrel ∧ fv nvf m = fv nvf F ∧ ra_nth_ctor c m k ∈ lrel) $ by and_congr [c13, c16]
c18: $ (fv nvf n = fv nvf C ∧ ra_nth_ty A n f c ∈ lrel ∧ fv nvf m = fv nvf E ∧ ra_nth_ctor c m k ∈ lrel) ⟺ (fv nvf n = fv nvf D ∧ ra_nth_ty B n f c ∈ lrel ∧ fv nvf m = fv nvf F ∧ ra_nth_ctor c m k ∈ lrel) $ by and_congr [c11, c17]
c19: $ ∃ k (fv nvf n = fv nvf C ∧ ra_nth_ty A n f c ∈ lrel ∧ fv nvf m = fv nvf E ∧ ra_nth_ctor c m k ∈ lrel) ⟺ ∃ k (fv nvf n = fv nvf D ∧ ra_nth_ty B n f c ∈ lrel ∧ fv nvf m = fv nvf F ∧ ra_nth_ctor c m k ∈ lrel) $ by ex_congr [c18]
c20: $ ∃ m ∃ k (fv nvf n = fv nvf C ∧ ra_nth_ty A n f c ∈ lrel ∧ fv nvf m = fv nvf E ∧ ra_nth_ctor c m k ∈ lrel) ⟺ ∃ m ∃ k (fv nvf n = fv nvf D ∧ ra_nth_ty B n f c ∈ lrel ∧ fv nvf m = fv nvf F ∧ ra_nth_ctor c m k ∈ lrel) $ by ex_congr [c19]
c21: $ ∃ c ∃ m ∃ k (fv nvf n = fv nvf C ∧ ra_nth_ty A n f c ∈ lrel ∧ fv nvf m = fv nvf E ∧ ra_nth_ctor c m k ∈ lrel) ⟺ ∃ c ∃ m ∃ k (fv nvf n = fv nvf D ∧ ra_nth_ty B n f c ∈ lrel ∧ fv nvf m = fv nvf F ∧ ra_nth_ctor c m k ∈ lrel) $ by ex_congr [c20]
c22: $ ∃ f ∃ c ∃ m ∃ k (fv nvf n = fv nvf C ∧ ra_nth_ty A n f c ∈ lrel ∧ fv nvf m = fv nvf E ∧ ra_nth_ctor c m k ∈ lrel) ⟺ ∃ f ∃ c ∃ m ∃ k (fv nvf n = fv nvf D ∧ ra_nth_ty B n f c ∈ lrel ∧ fv nvf m = fv nvf F ∧ ra_nth_ctor c m k ∈ lrel) $ by ex_congr [c21]
c23: $ ∃ n ∃ f ∃ c ∃ m ∃ k (fv nvf n = fv nvf C ∧ ra_nth_ty A n f c ∈ lrel ∧ fv nvf m = fv nvf E ∧ ra_nth_ctor c m k ∈ lrel) ⟺ ∃ n ∃ f ∃ c ∃ m ∃ k (fv nvf n = fv nvf D ∧ ra_nth_ty B n f c ∈ lrel ∧ fv nvf m = fv nvf F ∧ ra_nth_ctor c m k ∈ lrel) $ by ex_congr [c22]

--| @rewrite
lemma d1_bd_sb {x: set} (t: set x) (A B C: class x): $ [x/t] (d1_bd A B C) ⟺ d1_bd (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $
----
l1: $ [x/t] (∃ n ∃ f ∃ c ∃ m ∃ k (fv nvf n = fv nvf B ∧ ra_nth_ty A n f c ∈ lrel ∧ fv nvf m = fv nvf C ∧ ra_nth_ctor c m k ∈ lrel)) ⟺ ∃ n ∃ f ∃ c ∃ m ∃ k (fv nvf n = fv nvf (⟦ x / t ⟧ B) ∧ ra_nth_ty (⟦ x / t ⟧ A) n f c ∈ lrel ∧ fv nvf m = fv nvf (⟦ x / t ⟧ C) ∧ ra_nth_ctor c m k ∈ lrel) $ by iff_refl

lemma d1_nctor_z {f g: set} (G: hyps) (t h a: set):
  $ G ⇒ ra_nth_ctor t h a ∈ lrel $ > $ G ⇒ fv nvf h = ∅ $ > $ G ⇒ ∃ f ∃ g (t = ⟨ kc_ccons , scons f (scons g ∅) ⟩ ∧ a = f) $
----
l1: $ G ⇒ ∃ x1 ∃ x2 (t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (t = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_s , scons x4 ∅ ⟩ ∧ a = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by lrel_nth_ctor_cases [#1]
l2: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 $ by ax
l3: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l2]
l4: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 $ by and_elim_r [l2]
l5: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ h = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l4]
l6: $ G , t = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ h = ⟨ kc_nz , ∅ ⟩ ∧ a = x1 ⇒ a = x1 $ by and_elim_r [l4]
