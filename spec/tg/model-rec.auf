m5: $ G , ictk D I C o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) , h ∊ ihv D o (imrel D M) g t (cdm f) , q = scat h f , z ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))) ⇒ z ∊ {x7 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (ictk D2 I2 C2 x1 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x1 W2 (scat S2 (ixs D2 W2 (ifam u E D2 W2))) ∧ x6 ∊ ihv D2 x1 (imrel D2 M2) x3 x4 (cdm x2) ∧ q = scat x6 x2 ∧ x7 ∊ apn (vat M2 (intys D2) I2) (scons (itup D2 I2 C2 x3 W2) (cres x5 (inidx D2 I2))))} $ by iminv_intro [m1, m2, m3, k4, m4]
n1: $ G , z ∊ {y | ∃ o ∃ f ∃ g ∃ t ∃ a ∃ h (ictk D I C o ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) ∧ h ∊ ihv D o (imrel D M) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))))} ⇒ z ∊ {y | ∃ o ∃ f ∃ g ∃ t ∃ a ∃ h (ictk D I C o ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) ∧ h ∊ ihv D o (imrel D M) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))))} $ by ax
n2: $ G , z ∊ {y | ∃ o ∃ f ∃ g ∃ t ∃ a ∃ h (ictk D I C o ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) ∧ h ∊ ihv D o (imrel D M) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))))} ⇒ z ∊ {x7 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (ictk D2 I2 C2 x1 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x1 W2 (scat S2 (ixs D2 W2 (ifam u E D2 W2))) ∧ x6 ∊ ihv D2 x1 (imrel D2 M2) x3 x4 (cdm x2) ∧ q = scat x6 x2 ∧ x7 ∊ apn (vat M2 (intys D2) I2) (scons (itup D2 I2 C2 x3 W2) (cres x5 (inidx D2 I2))))} $ by iminv_elim [n1, m5]
n3: $ G ⇒ {y | ∃ o ∃ f ∃ g ∃ t ∃ a ∃ h (ictk D I C o ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) ∧ h ∊ ihv D o (imrel D M) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))))} ⊆ {x7 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (ictk D2 I2 C2 x1 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x1 W2 (scat S2 (ixs D2 W2 (ifam u E D2 W2))) ∧ x6 ∊ ihv D2 x1 (imrel D2 M2) x3 x4 (cdm x2) ∧ q = scat x6 x2 ∧ x7 ∊ apn (vat M2 (intys D2) I2) (scons (itup D2 I2 C2 x3 W2) (cres x5 (inidx D2 I2))))} $ by subset_intro [n2]

lemma i0_imin_sub (G: hyps) (E D D2 I I2 C C2 W W2 S S2 M M2: class) (u: set): $ G ⇒ D = D2 $ > $ G ⇒ I = I2 $ > $ G ⇒ C = C2 $ > $ G ⇒ W = W2 $ > $ G ⇒ S = S2 $ > $ G ⇒ M = M2 $ > $ G ⇒ imin u E D I C W S M ⊆ imin u E D2 I2 C2 W2 S2 M2 $
----
l4: $ G ⇒ iminq u E D I C W S M = iminq u E D2 I2 C2 W2 S2 M2 $ by iminq_eq [#1, #2, #3, #4, #5, #6]
l51: $ G , q ∊ iminq u E D I C W S M ⇒ D = D2 $ by weaken [#1]
l52: $ G , q ∊ iminq u E D I C W S M ⇒ I = I2 $ by weaken [#2]
l53: $ G , q ∊ iminq u E D I C W S M ⇒ C = C2 $ by weaken [#3]
l54: $ G , q ∊ iminq u E D I C W S M ⇒ W = W2 $ by weaken [#4]
l55: $ G , q ∊ iminq u E D I C W S M ⇒ S = S2 $ by weaken [#5]
l56: $ G , q ∊ iminq u E D I C W S M ⇒ M = M2 $ by weaken [#6]
l5: $ G , q ∊ iminq u E D I C W S M ⇒ {y | ∃ o ∃ f ∃ g ∃ t ∃ a ∃ h (ictk D I C o ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) ∧ h ∊ ihv D o (imrel D M) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))))} ⊆ {x7 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (ictk D2 I2 C2 x1 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x1 W2 (scat S2 (ixs D2 W2 (ifam u E D2 W2))) ∧ x6 ∊ ihv D2 x1 (imrel D2 M2) x3 x4 (cdm x2) ∧ q = scat x6 x2 ∧ x7 ∊ apn (vat M2 (intys D2) I2) (scons (itup D2 I2 C2 x3 W2) (cres x5 (inidx D2 I2))))} $ by i0_iminv_sub [l51, l52, l53, l54, l55, l56]
l6: $ G ⇒ q ∊ iminq u E D I C W S M → {y | ∃ o ∃ f ∃ g ∃ t ∃ a ∃ h (ictk D I C o ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) ∧ h ∊ ihv D o (imrel D M) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))))} ⊆ {x7 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (ictk D2 I2 C2 x1 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x1 W2 (scat S2 (ixs D2 W2 (ifam u E D2 W2))) ∧ x6 ∊ ihv D2 x1 (imrel D2 M2) x3 x4 (cdm x2) ∧ q = scat x6 x2 ∧ x7 ∊ apn (vat M2 (intys D2) I2) (scons (itup D2 I2 C2 x3 W2) (cres x5 (inidx D2 I2))))} $ by imp_intro [l5]
l7: $ G ⇒ ∀ q (q ∊ iminq u E D I C W S M → {y | ∃ o ∃ f ∃ g ∃ t ∃ a ∃ h (ictk D I C o ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) ∧ h ∊ ihv D o (imrel D M) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))))} ⊆ {x7 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (ictk D2 I2 C2 x1 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x1 W2 (scat S2 (ixs D2 W2 (ifam u E D2 W2))) ∧ x6 ∊ ihv D2 x1 (imrel D2 M2) x3 x4 (cdm x2) ∧ q = scat x6 x2 ∧ x7 ∊ apn (vat M2 (intys D2) I2) (scons (itup D2 I2 C2 x3 W2) (cres x5 (inidx D2 I2))))}) $ by all_intro [l6]
l8: $ G ⇒ fpi q (iminq u E D I C W S M) {y | ∃ o ∃ f ∃ g ∃ t ∃ a ∃ h (ictk D I C o ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) ∧ h ∊ ihv D o (imrel D M) g t (cdm f) ∧ q = scat h f ∧ y ∊ apn (vat M (intys D) I) (scons (itup D I C g W) (cres a (inidx D I))))} ⊆ fpi q (iminq u E D2 I2 C2 W2 S2 M2) {x7 | ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (ictk D2 I2 C2 x1 ∧ ⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u E x1 W2 (scat S2 (ixs D2 W2 (ifam u E D2 W2))) ∧ x6 ∊ ihv D2 x1 (imrel D2 M2) x3 x4 (cdm x2) ∧ q = scat x6 x2 ∧ x7 ∊ apn (vat M2 (intys D2) I2) (scons (itup D2 I2 C2 x3 W2) (cres x5 (inidx D2 I2))))} $ by fpi_sub [l4, l7]

imin_eq
-------
q1: $ G ⇒ imin u E D I C W S M ⊆ imin u E D2 I2 C2 W2 S2 M2 $ by i0_imin_sub [#1, #2, #3, #4, #5, #6]
qs0: $ G ⇒ D2 = D $ by eq_sym [#1]
qs1: $ G ⇒ I2 = I $ by eq_sym [#2]
qs2: $ G ⇒ C2 = C $ by eq_sym [#3]
qs3: $ G ⇒ W2 = W $ by eq_sym [#4]
qs4: $ G ⇒ S2 = S $ by eq_sym [#5]
qs5: $ G ⇒ M2 = M $ by eq_sym [#6]
q2: $ G ⇒ imin u E D2 I2 C2 W2 S2 M2 ⊆ imin u E D I C W S M $ by i0_imin_sub [qs0, qs1, qs2, qs3, qs4, qs5]
q3: $ G ⇒ imin u E D I C W S M = imin u E D2 I2 C2 W2 S2 M2 $ by subset_antisym [q1, q2]

lemma i0_imins_sub (G: hyps) (E D D2 W W2 S S2 M M2: class) (u: set): $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ S = S2 $ > $ G ⇒ M = M2 $ > $ G ⇒ imins u E D W S M ⊆ imins u E D2 W2 S2 M2 $
----
a0: $ G , z ∊ {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⇒ z ∊ {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} $ by ax
a1: $ G , z ∊ {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⇒ ∃ i ∃ c (iminx D i c k ∧ z ∊ imin u E D i c W S M) $ by cab_elim [a0]
c1: $ ∃ i ∃ c (iminx D i c k ∧ z ∊ imin u E D i c W S M) ⟺ ∃ a ∃ c (iminx D a c k ∧ z ∊ imin u E D a c W S M) $ by ex_alpha
c2: $ ∃ c (iminx D a c k ∧ z ∊ imin u E D a c W S M) ⟺ ∃ b (iminx D a b k ∧ z ∊ imin u E D a b W S M) $ by ex_alpha
c3: $ ∃ a ∃ c (iminx D a c k ∧ z ∊ imin u E D a c W S M) ⟺ ∃ a ∃ b (iminx D a b k ∧ z ∊ imin u E D a b W S M) $ by ex_congr [c2]
c4: $ ∃ i ∃ c (iminx D i c k ∧ z ∊ imin u E D i c W S M) ⟺ ∃ a ∃ b (iminx D a b k ∧ z ∊ imin u E D a b W S M) $ by iff_trans [c1, c3]
c5: $ G , z ∊ {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⇒ ∃ i ∃ c (iminx D i c k ∧ z ∊ imin u E D i c W S M) ↔ ∃ a ∃ b (iminx D a b k ∧ z ∊ imin u E D a b W S M) $ by weaken [c4]
a2: $ G , z ∊ {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⇒ ∃ a ∃ b (iminx D a b k ∧ z ∊ imin u E D a b W S M) $ by bi_elim_l [c5, a1]
b1: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ iminx D a b k ∧ z ∊ imin u E D a b W S M $ by ax
b2: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ iminx D a b k $ by and_elim_l [b1]
b3: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ z ∊ imin u E D a b W S M $ by and_elim_r [b1]
bw1: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ D = D2 $ by weaken [#1]
bw2: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ W = W2 $ by weaken [#2]
bw3: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ S = S2 $ by weaken [#3]
bw4: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ M = M2 $ by weaken [#4]
ba: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ a = a $ by eq_refl
bb: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ b = b $ by eq_refl
bk: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ k = k $ by eq_refl
b6: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ imin u E D a b W S M ⊆ imin u E D2 a b W2 S2 M2 $ by i0_imin_sub [bw1, ba, bb, bw2, bw3, bw4]
b7: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ z ∊ imin u E D2 a b W2 S2 M2 $ by subset_elim [b6, b3]
b2b: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ iminx D2 a b k $ by iminx_eq [bw1, ba, bb, bk, b2]
b8: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ iminx D2 a b k ∧ z ∊ imin u E D2 a b W2 S2 M2 $ by and_intro [b2b, b7]
b9: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ ∃ c (iminx D2 a c k ∧ z ∊ imin u E D2 a c W2 S2 M2) $ by ex_intro [b8]
b10: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ ∃ i ∃ c (iminx D2 i c k ∧ z ∊ imin u E D2 i c W2 S2 M2) $ by ex_intro [b9]
b11: $ G , iminx D a b k ∧ z ∊ imin u E D a b W S M ⇒ z ∊ {y | ∃ i ∃ c (iminx D2 i c k ∧ y ∊ imin u E D2 i c W2 S2 M2)} $ by cab_intro [b10]
d1: $ G , ∃ b (iminx D a b k ∧ z ∊ imin u E D a b W S M) ⇒ ∃ b (iminx D a b k ∧ z ∊ imin u E D a b W S M) $ by ax
d2: $ G , ∃ b (iminx D a b k ∧ z ∊ imin u E D a b W S M) ⇒ z ∊ {y | ∃ i ∃ c (iminx D2 i c k ∧ y ∊ imin u E D2 i c W2 S2 M2)} $ by ex_elim [d1, b11]
d3: $ G , z ∊ {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⇒ z ∊ {y | ∃ i ∃ c (iminx D2 i c k ∧ y ∊ imin u E D2 i c W2 S2 M2)} $ by ex_elim [a2, d2]
d4: $ G ⇒ {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⊆ {y | ∃ i ∃ c (iminx D2 i c k ∧ y ∊ imin u E D2 i c W2 S2 M2)} $ by subset_intro [d3]
d5: $ G , k ∊ inmin D ⇒ {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⊆ {y | ∃ i ∃ c (iminx D2 i c k ∧ y ∊ imin u E D2 i c W2 S2 M2)} $ by weaken [d4]
d6: $ G ⇒ k ∊ inmin D → {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⊆ {y | ∃ i ∃ c (iminx D2 i c k ∧ y ∊ imin u E D2 i c W2 S2 M2)} $ by imp_intro [d5]
d7: $ G ⇒ ∀ k (k ∊ inmin D → {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⊆ {y | ∃ i ∃ c (iminx D2 i c k ∧ y ∊ imin u E D2 i c W2 S2 M2)}) $ by all_intro [d6]
d9: $ G ⇒ inmin D = inmin D2 $ by inmin_eq [#1]
d11: $ G ⇒ ivals k u (inmin D) {y | ∃ i ∃ c (iminx D i c k ∧ y ∊ imin u E D i c W S M)} ⊆ ivals k u (inmin D2) {y | ∃ i ∃ c (iminx D2 i c k ∧ y ∊ imin u E D2 i c W2 S2 M2)} $ by ivals_sub [d9, d7]

imins_eq
--------
q1: $ G ⇒ imins u E D W S M ⊆ imins u E D2 W2 S2 M2 $ by i0_imins_sub [#1, #2, #3, #4]
qs0: $ G ⇒ D2 = D $ by eq_sym [#1]
qs1: $ G ⇒ W2 = W $ by eq_sym [#2]
qs2: $ G ⇒ S2 = S $ by eq_sym [#3]
qs3: $ G ⇒ M2 = M $ by eq_sym [#4]
q2: $ G ⇒ imins u E D2 W2 S2 M2 ⊆ imins u E D W S M $ by i0_imins_sub [qs0, qs1, qs2, qs3]
q3: $ G ⇒ imins u E D W S M = imins u E D2 W2 S2 M2 $ by subset_antisym [q1, q2]

lemma i0_ifold0_sub (G: hyps) (E D D2 W W2 S S2 M M2 R R2: class) (u: set): $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ S = S2 $ > $ G ⇒ M = M2 $ > $ G ⇒ R = R2 $ > $ G ⇒ ifold0 u E D W S M R ⊆ ifold0 u E D2 W2 S2 M2 R2 $
----
k1: $ G , ictk D j c o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) , ⟨ j , ⟨ a , scons c g ⟩ ⟩ ∈ ifam u E D W , h ∊ ihv D o R g t (cdm f) , iminx D j c k , apn (vat M (inmin D) k) (scat h f) ∈ u , z = ⟨ ⟨ j , ⟨ a , itup D j c g W ⟩ ⟩ , apn (vat M (inmin D) k) (scat h f) ⟩ ⇒ ictk D j c o $ by ax
k2: $ G , ictk D j c o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) , ⟨ j , ⟨ a , scons c g ⟩ ⟩ ∈ ifam u E D W , h ∊ ihv D o R g t (cdm f) , iminx D j c k , apn (vat M (inmin D) k) (scat h f) ∈ u , z = ⟨ ⟨ j , ⟨ a , itup D j c g W ⟩ ⟩ , apn (vat M (inmin D) k) (scat h f) ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) $ by ax
k3: $ G , ictk D j c o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) , ⟨ j , ⟨ a , scons c g ⟩ ⟩ ∈ ifam u E D W , h ∊ ihv D o R g t (cdm f) , iminx D j c k , apn (vat M (inmin D) k) (scat h f) ∈ u , z = ⟨ ⟨ j , ⟨ a , itup D j c g W ⟩ ⟩ , apn (vat M (inmin D) k) (scat h f) ⟩ ⇒ ⟨ j , ⟨ a , scons c g ⟩ ⟩ ∈ ifam u E D W $ by ax
k4: $ G , ictk D j c o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W (scat S (ixs D W (ifam u E D W))) , ⟨ j , ⟨ a , scons c g ⟩ ⟩ ∈ ifam u E D W , h ∊ ihv D o R g t (cdm f) , iminx D j c k , apn (vat M (inmin D) k) (scat h f) ∈ u , z = ⟨ ⟨ j , ⟨ a , itup D j c g W ⟩ ⟩ , apn (vat M (inmin D) k) (scat h f) ⟩ ⇒ h ∊ ihv D o R g t (cdm f) $ by ax
