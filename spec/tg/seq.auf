t12: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b ⇒ suc (cdm b) = cdm v $ by eq_sym [t8]
t13: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b ⇒ suc (cdm b) = suc j $ by eq_trans [t12, t11]
t14: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b ⇒ cdm b ∈ ω $ by fseq_len [t4]
u1: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ c = cdm b $ by ax
u2: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ suc c = suc (cdm b) $ by suc_eq [u1]
