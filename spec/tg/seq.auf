lemma s2_wcel_csn (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ csn A $
----
l1: $ G , z = A ⇒ z = A $ by ax
l2: $ G , z = A ⇒ z ∊ csn A $ by csn_intro [l1]
l3: $ G , z = A ⇒ A ∈ csn A $ by wcel_intro [l1, l2]
l4: $ G ⇒ A ∈ csn A $ by isset_elim [#1, l3]

lemma s2_fseq_c (G: hyps) (A S: class):
  $ G ⇒ functional S $ > $ G ⇒ rel S $ > $ G ⇒ cdm S ∈ ω $ > $ G ⇒ crn S ⊆ A $ >
  $ G ⇒ S ∈ fseq A $
----
l1: $ G ⇒ isset (cdm S) $ by wcel_isset [#3]
l2: $ G ⇒ isset S $ by functional_set [#1, #2, l1]
l3: $ G , v = S ⇒ v = S $ by ax
l4: $ G , v = S ⇒ S = v $ by eq_sym [l3]
l5: $ G , v = S ⇒ functional S $ by weaken [#1]
l6: $ G , v = S ⇒ functional v $ by functional_eq [l4, l5]
l7: $ G , v = S ⇒ rel S $ by weaken [#2]
l8: $ G , v = S ⇒ rel v $ by rel_eq [l4, l7]
l9: $ G , v = S ⇒ cdm S = cdm v $ by cdm_eq [l4]
l10: $ G , v = S ⇒ cdm S ∈ ω $ by weaken [#3]
l11: $ G , v = S ⇒ cdm v ∈ ω $ by wcel_eq_l [l9, l10]
l12: $ G , v = S ⇒ crn S = crn v $ by crn_eq [l4]
l13: $ G , v = S ⇒ crn S ⊆ A $ by weaken [#4]
l14: $ G , v = S ⇒ crn v ⊆ A $ by subset_eq_l [l12, l13]
l15: $ G , v = S ⇒ v ∊ fseq A $ by fseq_of_fn [l6, l8, l11, l14]
l16: $ G , v = S ⇒ S ∈ fseq A $ by wcel_intro [l3, l15]
l17: $ G ⇒ S ∈ fseq A $ by isset_elim [l2, l16]

lemma s2_cdm_intro_c (G: hyps) (R A B: class):
  $ G ⇒ ⟨ A , B ⟩ ∈ R $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ A ∈ cdm R $
----
l1: $ G , x = A , y = B ⇒ x = A $ by ax
l2: $ G , x = A , y = B ⇒ y = B $ by ax
l3: $ G , x = A , y = B ⇒ A = x $ by eq_sym [l1]
l4: $ G , x = A , y = B ⇒ B = y $ by eq_sym [l2]
l5: $ G , x = A , y = B ⇒ ⟨ A , B ⟩ = ⟨ x , y ⟩ $ by opair_eq [l3, l4]
l6: $ G , x = A , y = B ⇒ ⟨ A , B ⟩ ∈ R $ by weaken [#1]
l7: $ G , x = A , y = B ⇒ ⟨ x , y ⟩ ∈ R $ by wcel_eq_l [l5, l6]
l8: $ G , x = A , y = B ⇒ x ∊ cdm R $ by cdm_intro [l7]
l9: $ G , x = A , y = B ⇒ A ∈ cdm R $ by wcel_intro [l1, l8]
l10: $ G , x = A ⇒ A ∈ cdm R $ by isset_elim [#3, l9]
l11: $ G ⇒ A ∈ cdm R $ by isset_elim [#2, l10]

lemma s2_crn_intro_c (G: hyps) (R A B: class):
  $ G ⇒ ⟨ A , B ⟩ ∈ R $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ B ∈ crn R $
----
l1: $ G , x = A , y = B ⇒ x = A $ by ax
l2: $ G , x = A , y = B ⇒ y = B $ by ax
l3: $ G , x = A , y = B ⇒ A = x $ by eq_sym [l1]
l4: $ G , x = A , y = B ⇒ B = y $ by eq_sym [l2]
l5: $ G , x = A , y = B ⇒ ⟨ A , B ⟩ = ⟨ x , y ⟩ $ by opair_eq [l3, l4]
l6: $ G , x = A , y = B ⇒ ⟨ A , B ⟩ ∈ R $ by weaken [#1]
l7: $ G , x = A , y = B ⇒ ⟨ x , y ⟩ ∈ R $ by wcel_eq_l [l5, l6]
l8: $ G , x = A , y = B ⇒ y ∊ crn R $ by crn_intro [l7]
l9: $ G , x = A , y = B ⇒ B ∈ crn R $ by wcel_intro [l2, l8]
l10: $ G , x = A ⇒ B ∈ crn R $ by isset_elim [#3, l9]
l11: $ G ⇒ B ∈ crn R $ by isset_elim [#2, l10]

lemma s2_fseq_pair_omega (G: hyps) (A: class) (s i y: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ ⟨ i , y ⟩ ∈ s $ > $ G ⇒ i ∊ ω $
----
l1: $ G ⇒ i ∊ cdm s $ by cdm_intro [#2]
l2: $ G ⇒ cdm s ∈ ω $ by fseq_len [#1]
l3: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
l4: $ G , k = cdm s , k ∊ ω ⇒ k ∊ ω $ by ax
l5: $ G , k = cdm s , k ∊ ω ⇒ cdm s = k $ by eq_sym [l3]
l6: $ G , k = cdm s , k ∊ ω ⇒ i ∊ cdm s $ by weaken [l1]
l7: $ G , k = cdm s , k ∊ ω ⇒ i ∊ k $ by welc_eq [l5, l6]
l8: $ G , k = cdm s , k ∊ ω ⇒ i ∊ ω $ by omega_elem_omega [l4, l7]
l9: $ G ⇒ i ∊ ω $ by wcel_elim [l2, l8]

lemma s2_opair_ex (G: hyps) {x y: set} (A B: class) (z: set):
  $ G ⇒ z = ⟨ A , B ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $
----
l1: $ G , u = A , v = B ⇒ u = A $ by ax
l2: $ G , u = A , v = B ⇒ v = B $ by ax
l3: $ G , u = A , v = B ⇒ A = u $ by eq_sym [l1]
l4: $ G , u = A , v = B ⇒ B = v $ by eq_sym [l2]
l5: $ G , u = A , v = B ⇒ ⟨ A , B ⟩ = ⟨ u , v ⟩ $ by opair_eq [l3, l4]
l6: $ G , u = A , v = B ⇒ z = ⟨ A , B ⟩ $ by weaken [#1]
l7: $ G , u = A , v = B ⇒ z = ⟨ u , v ⟩ $ by eq_trans [l6, l5]
l8: $ G , u = A , v = B ⇒ ∃ y (z = ⟨ u , y ⟩) $ by ex_intro (x := $ y $, t := $ v $, p := $ z = ⟨ u , y ⟩ $) [l7]
l9: $ G , u = A , v = B ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_intro (x := $ x $, t := $ u $, p := $ ∃ y (z = ⟨ x , y ⟩) $) [l8]
l10: $ G , u = A ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by isset_elim [#3, l9]
l11: $ G ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by isset_elim [#2, l10]

lemma s2_scons_zero (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ isset ⟨ ∅ , A ⟩ $ by opair_set [l1, #1]
l3: $ G ⇒ ⟨ ∅ , A ⟩ ∈ csn ⟨ ∅ , A ⟩ $ by s2_wcel_csn [l2]
l4: $ G ⇒ csn ⟨ ∅ , A ⟩ ⊆ csn ⟨ ∅ , A ⟩ ∪ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by cun_subset_l
l5: $ G ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by wcel_subset [l4, l3]

lemma s2_scons_suc (G: hyps) (A S: class) (j y: set):
  $ G ⇒ ⟨ j , y ⟩ ∈ S $ > $ G ⇒ ⟨ suc j , y ⟩ ∈ scons A S $
----
l1: $ G ⇒ isset j $ by isset_var
l2: $ G ⇒ isset (suc j) $ by suc_set [l1]
l3: $ G ⇒ isset y $ by isset_var
l4: $ G ⇒ isset ⟨ suc j , y ⟩ $ by opair_set [l2, l3]
l5: $ G , z = ⟨ suc j , y ⟩ ⇒ z = ⟨ suc j , y ⟩ $ by ax
l6: $ G , z = ⟨ suc j , y ⟩ ⇒ ⟨ j , y ⟩ ∈ S $ by weaken [#1]
l7: $ G , z = ⟨ suc j , y ⟩ ⇒ z = ⟨ suc j , y ⟩ ∧ ⟨ j , y ⟩ ∈ S $ by and_intro [l5, l6]
l8: $ G , z = ⟨ suc j , y ⟩ ⇒ ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by ex_intro (x := $ k $, t := $ y $, p := $ z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S $) [l7]
l9: $ G , z = ⟨ suc j , y ⟩ ⇒ ∃ i ∃ k (z = ⟨ suc i , k ⟩ ∧ ⟨ i , k ⟩ ∈ S) $ by ex_intro (x := $ i $, t := $ j $, p := $ ∃ k (z = ⟨ suc i , k ⟩ ∧ ⟨ i , k ⟩ ∈ S) $) [l8]
l10: $ G , z = ⟨ suc j , y ⟩ ⇒ z ∊ {w | ∃ i ∃ k (w = ⟨ suc i , k ⟩ ∧ ⟨ i , k ⟩ ∈ S)} $ by cab_intro (x := $ w $, t := $ z $, p := $ ∃ i ∃ k (w = ⟨ suc i , k ⟩ ∧ ⟨ i , k ⟩ ∈ S) $) [l9]
l11: $ G , z = ⟨ suc j , y ⟩ ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∪ {w | ∃ i ∃ k (w = ⟨ suc i , k ⟩ ∧ ⟨ i , k ⟩ ∈ S)} $ by cun_intro_r [l10]
l12: $ G , z = ⟨ suc j , y ⟩ ⇒ ⟨ suc j , y ⟩ ∈ scons A S $ by wcel_intro [l5, l11]
l13: $ G ⇒ ⟨ suc j , y ⟩ ∈ scons A S $ by isset_elim [l4, l12]

scons_pair
----------
l1: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∪ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by ax
l2: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∨ z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by cun_elim [l1]
a1: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z ∊ csn ⟨ ∅ , A ⟩ $ by ax
a2: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z = ⟨ ∅ , A ⟩ $ by csn_elim [a1]
a3: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z = ⟨ U , v ⟩ $ by ax
a4: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ ⟨ U , v ⟩ = z $ by eq_sym [a3]
a5: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ ⟨ U , v ⟩ = ⟨ ∅ , A ⟩ $ by eq_trans [a4, a2]
a6: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset U $ by weaken [#2]
a7: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset v $ by isset_var
a8: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset ∅ $ by ax_empty
a9: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset A $ by weaken [#3]
a10: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ U = ∅ ∧ v = A $ by opair_inj_c [a5, a6, a7, a8, a9]
a11: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by or_intro_l [a10]
b1: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by ax
b2: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} ⇒ ∃ j ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by cab_elim (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $) [b1]
c1: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S $ by ax
c2: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ z = ⟨ suc j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ ⟨ j , k ⟩ ∈ S $ by and_elim_r [c1]
c4: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ z = ⟨ U , v ⟩ $ by ax
c5: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ ⟨ U , v ⟩ = z $ by eq_sym [c4]
c6: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ ⟨ U , v ⟩ = ⟨ suc j , k ⟩ $ by eq_trans [c5, c2]
c7: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset U $ by weaken [#2]
c8: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset v $ by isset_var
c9: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset j $ by isset_var
c10: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset (suc j) $ by suc_set [c9]
c11: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset k $ by isset_var
c12: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ U = suc j ∧ v = k $ by opair_inj_c [c6, c7, c8, c10, c11]
c13: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ U = suc j $ by and_elim_l [c12]
c14: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ v = k $ by and_elim_r [c12]
c15: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ k = v $ by eq_sym [c14]
c16: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ j = j $ by eq_refl
c17: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ ⟨ j , k ⟩ = ⟨ j , v ⟩ $ by opair_eq [c16, c15]
c18: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ ⟨ j , v ⟩ ∈ S $ by wcel_eq_l [c17, c3]
c19: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ U = suc j ∧ ⟨ j , v ⟩ ∈ S $ by and_intro [c13, c18]
c20: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by ex_intro (x := $ i $, t := $ j $, p := $ U = suc i ∧ ⟨ i , v ⟩ ∈ S $) [c19]
c21: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by or_intro_r [c20]
d1: $ G , z = ⟨ U , v ⟩ , ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) ⇒ ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by ax
d2: $ G , z = ⟨ U , v ⟩ , ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by ex_elim [d1, c21]
d3: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by ex_elim [b2, d2]
e1: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by or_elim [l2, a11, d3]
e2: $ G ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by wcel_elim [#1, e1]

lemma s2_scons_rel (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ rel (scons A S) $
----
l1: $ G , z ∊ scons A S ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∪ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by ax
l2: $ G , z ∊ scons A S ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∨ z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by cun_elim [l1]
a1: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z ∊ csn ⟨ ∅ , A ⟩ $ by ax
a2: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z = ⟨ ∅ , A ⟩ $ by csn_elim [a1]
a3: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset ∅ $ by ax_empty
a4: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset A $ by weaken [#1]
a5: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by s2_opair_ex [a2, a3, a4]
b1: $ G , z ∊ scons A S , z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by ax
b2: $ G , z ∊ scons A S , z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} ⇒ ∃ j ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by cab_elim (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $) [b1]
c1: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S $ by ax
c2: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ z = ⟨ suc j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset j $ by isset_var
c4: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset (suc j) $ by suc_set [c3]
c5: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset k $ by isset_var
c6: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by s2_opair_ex [c2, c4, c5]
d1: $ G , z ∊ scons A S , ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) ⇒ ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by ax
d2: $ G , z ∊ scons A S , ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [d1, c6]
d3: $ G , z ∊ scons A S , z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [b2, d2]
e1: $ G , z ∊ scons A S ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by or_elim [l2, a5, d3]
e2: $ G ⇒ rel (scons A S) $ by rel_intro [e1]

lemma s2_scons_functional (G: hyps) (A S: class):
  $ G ⇒ isset A $ > $ G ⇒ functional S $ > $ G ⇒ functional (scons A S) $
----
f1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ ⟨ x , y ⟩ ∈ scons A S $ by ax
f2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ ⟨ x , z ⟩ ∈ scons A S $ by ax
f3: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ isset x $ by isset_var
f4: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ isset A $ by weaken [#1]
f5: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ (x = ∅ ∧ y = A) ∨ ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by scons_pair [f1, f3, f4]
f6: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ (x = ∅ ∧ z = A) ∨ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by scons_pair [f2, f3, f4]
g1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A ⇒ (x = ∅ ∧ z = A) ∨ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by weaken [f6]
h1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = ∅ ∧ z = A ⇒ x = ∅ ∧ y = A $ by ax
h2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = ∅ ∧ z = A ⇒ x = ∅ ∧ z = A $ by ax
h3: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = ∅ ∧ z = A ⇒ y = A $ by and_elim_r [h1]
h4: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = ∅ ∧ z = A ⇒ z = A $ by and_elim_r [h2]
h5: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = ∅ ∧ z = A ⇒ A = z $ by eq_sym [h4]
h6: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = ∅ ∧ z = A ⇒ y = z $ by eq_trans [h3, h5]
k1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = ∅ ∧ y = A $ by ax
k2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc j ∧ ⟨ j , z ⟩ ∈ S $ by ax
k3: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = ∅ $ by and_elim_l [k1]
k4: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc j $ by and_elim_l [k2]
k5: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ suc j = x $ by eq_sym [k4]
k6: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ suc j = ∅ $ by eq_trans [k5, k3]
k7: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ ⊥ $ by suc_ne_empty [k6]
k8: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ y = z $ by bot_elim [k7]
k9: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) ⇒ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by ax
k10: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) ⇒ y = z $ by ex_elim [k9, k8]
g2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A ⇒ y = z $ by or_elim [g1, h6, k10]
m1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ (x = ∅ ∧ z = A) ∨ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by weaken [f6]
n1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ x = suc i ∧ ⟨ i , y ⟩ ∈ S $ by ax
n2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ x = ∅ ∧ z = A $ by ax
n3: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ x = suc i $ by and_elim_l [n1]
n4: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ x = ∅ $ by and_elim_l [n2]
n5: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ suc i = x $ by eq_sym [n3]
n6: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ suc i = ∅ $ by eq_trans [n5, n4]
n7: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ ⊥ $ by suc_ne_empty [n6]
n8: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ y = z $ by bot_elim [n7]
p1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc i ∧ ⟨ i , y ⟩ ∈ S $ by ax
p2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc j ∧ ⟨ j , z ⟩ ∈ S $ by ax
p3: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc i $ by and_elim_l [p1]
p4: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc j $ by and_elim_l [p2]
p5: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ suc i = x $ by eq_sym [p3]
p6: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ suc i = suc j $ by eq_trans [p5, p4]
p7: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ i = j $ by suc_inj [p6]
p8: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ j = i $ by eq_sym [p7]
p9: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ z = z $ by eq_refl
p10: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ ⟨ j , z ⟩ = ⟨ i , z ⟩ $ by opair_eq [p8, p9]
p11: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ ⟨ j , z ⟩ ∈ S $ by and_elim_r [p2]
p12: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ ⟨ i , z ⟩ ∈ S $ by wcel_eq_l [p10, p11]
p13: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ ⟨ i , y ⟩ ∈ S $ by and_elim_r [p1]
p14: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ functional S $ by weaken [#2]
p15: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ y = z $ by functional_elim [p14, p13, p12]
p16: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) ⇒ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by ax
p17: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) ⇒ y = z $ by ex_elim [p16, p15]
m2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ y = z $ by or_elim [m1, n8, p17]
m3: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) ⇒ ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by ax
m4: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) ⇒ y = z $ by ex_elim [m3, m2]
q1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ y = z $ by or_elim [f5, g2, m4]
q2: $ G ⇒ functional (scons A S) $ by functional_intro [q1]

lemma s2_scons_cdm (G: hyps) (A S: class) (n: set):
  $ G ⇒ isset A $ > $ G ⇒ n ∊ ω $ > $ G ⇒ cdm S = n $ > $ G ⇒ cdm (scons A S) = suc n $
----
t1: $ G , w ∊ cdm (scons A S) ⇒ w ∊ cdm (scons A S) $ by ax
t2: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S ⇒ ⟨ w , y ⟩ ∈ scons A S $ by ax
t3: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S ⇒ isset w $ by isset_var
t4: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S ⇒ isset A $ by weaken [#1]
t5: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S ⇒ (w = ∅ ∧ y = A) ∨ ∃ j (w = suc j ∧ ⟨ j , y ⟩ ∈ S) $ by scons_pair [t2, t3, t4]
u1: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A ⇒ n ∊ ω $ by weaken [#2]
u2: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A ⇒ ∅ ∈ n ∨ ∅ = n $ by omega_zero_le [u1]
v1: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ ∅ ∈ n $ by ax
v2: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ w = ∅ ∧ y = A $ by ax
v3: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ w = ∅ $ by and_elim_l [v2]
v4: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ ∅ = w $ by eq_sym [v3]
v5: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ w ∈ n $ by wcel_eq_l [v4, v1]
v6: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ w ∊ n $ by wcel_welc [v5]
v7: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ w ∊ suc n $ by suc_intro_l [v6]
x1: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ = n ⇒ ∅ = n $ by ax
x2: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ = n ⇒ w = ∅ ∧ y = A $ by ax
x3: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ = n ⇒ w = ∅ $ by and_elim_l [x2]
x4: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ = n ⇒ w = n $ by eq_trans [x3, x1]
x5: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ = n ⇒ w ∊ suc n $ by suc_intro_r [x4]
u3: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A ⇒ w ∊ suc n $ by or_elim [u2, v7, x5]
y1: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ w = suc j ∧ ⟨ j , y ⟩ ∈ S $ by ax
y2: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ w = suc j $ by and_elim_l [y1]
y3: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ ⟨ j , y ⟩ ∈ S $ by and_elim_r [y1]
y4: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ j ∊ cdm S $ by cdm_intro [y3]
y5: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ cdm S = n $ by weaken [#3]
y6: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ j ∊ n $ by welc_eq [y5, y4]
y7: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ n ∊ ω $ by weaken [#2]
y9: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ suc j ∈ suc n $ by omega_suc_mono [y7, y6]
y10: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ suc j = w $ by eq_sym [y2]
y11: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ w ∈ suc n $ by wcel_eq_l [y10, y9]
y12: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ w ∊ suc n $ by wcel_welc [y11]
y13: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , ∃ j (w = suc j ∧ ⟨ j , y ⟩ ∈ S) ⇒ ∃ j (w = suc j ∧ ⟨ j , y ⟩ ∈ S) $ by ax
y14: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , ∃ j (w = suc j ∧ ⟨ j , y ⟩ ∈ S) ⇒ w ∊ suc n $ by ex_elim [y13, y12]
t6: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S ⇒ w ∊ suc n $ by or_elim [t5, u3, y14]
t7: $ G , w ∊ cdm (scons A S) ⇒ w ∊ suc n $ by cdm_elim [t1, t6]
z1: $ G , w ∊ suc n ⇒ w ∊ suc n $ by ax
z2: $ G , w ∊ suc n ⇒ n ∊ ω $ by weaken [#2]
z3: $ G , w ∊ suc n ⇒ w ∊ ω $ by omega_suc_elem_omega [z2, z1]
z4: $ G , w ∊ suc n ⇒ w = ∅ ∨ ∃ j (j ∊ ω ∧ w = suc j) $ by omega_cases [z3]
a1: $ G , w ∊ suc n , w = ∅ ⇒ w = ∅ $ by ax
a2: $ G , w ∊ suc n , w = ∅ ⇒ isset A $ by weaken [#1]
a3: $ G , w ∊ suc n , w = ∅ ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by s2_scons_zero [a2]
a4: $ G , w ∊ suc n , w = ∅ ⇒ isset ∅ $ by ax_empty
a5: $ G , w ∊ suc n , w = ∅ ⇒ ∅ ∈ cdm (scons A S) $ by s2_cdm_intro_c [a3, a4, a2]
a6: $ G , w ∊ suc n , w = ∅ ⇒ ∅ = w $ by eq_sym [a1]
a7: $ G , w ∊ suc n , w = ∅ ⇒ w ∈ cdm (scons A S) $ by wcel_eq_l [a6, a5]
a8: $ G , w ∊ suc n , w = ∅ ⇒ w ∊ cdm (scons A S) $ by wcel_welc [a7]
b1: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ j ∊ ω ∧ w = suc j $ by ax
b2: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ w = suc j $ by and_elim_r [b1]
b3: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ w ∊ suc n $ by ax
b4: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ w ∈ suc n $ by welc_wcel [b3]
b5: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ suc j ∈ suc n $ by wcel_eq_l [b2, b4]
b6: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ n ∊ ω $ by weaken [#2]
b7: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ ord n $ by ord_omega_elem [b6]
b8: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ j ∊ n $ by ord_suc_elem_suc_elim [b7, b5]
b9: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ cdm S = n $ by weaken [#3]
b10: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ n = cdm S $ by eq_sym [b9]
b11: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ j ∊ cdm S $ by welc_eq [b10, b8]
c1: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ ⟨ j , y ⟩ ∈ S $ by ax
c2: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ ⟨ suc j , y ⟩ ∈ scons A S $ by s2_scons_suc [c1]
c3: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ j ∊ ω ∧ w = suc j $ by ax
c4: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ w = suc j $ by and_elim_r [c3]
c5: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ suc j = w $ by eq_sym [c4]
c6: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ y = y $ by eq_refl
c7: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ ⟨ suc j , y ⟩ = ⟨ w , y ⟩ $ by opair_eq [c5, c6]
c8: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ ⟨ w , y ⟩ ∈ scons A S $ by wcel_eq_l [c7, c2]
c9: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ w ∊ cdm (scons A S) $ by cdm_intro [c8]
b12: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ w ∊ cdm (scons A S) $ by cdm_elim [b11, c9]
b13: $ G , w ∊ suc n , ∃ j (j ∊ ω ∧ w = suc j) ⇒ ∃ j (j ∊ ω ∧ w = suc j) $ by ax
b14: $ G , w ∊ suc n , ∃ j (j ∊ ω ∧ w = suc j) ⇒ w ∊ cdm (scons A S) $ by ex_elim [b13, b12]
z5: $ G , w ∊ suc n ⇒ w ∊ cdm (scons A S) $ by or_elim [z4, a8, b14]
z6: $ G ⇒ cdm (scons A S) = suc n $ by eq_intro [t7, z5]

scons_fseq
----------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ functional s $ by fseq_functional [#2]
l3: $ G ⇒ functional (scons a s) $ by s2_scons_functional [l1, l2]
l4: $ G ⇒ rel (scons a s) $ by s2_scons_rel [l1]
l5: $ G ⇒ cdm s ∈ ω $ by fseq_len [#2]
m1: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
m2: $ G , k = cdm s , k ∊ ω ⇒ k ∊ ω $ by ax
m3: $ G , k = cdm s , k ∊ ω ⇒ cdm s = k $ by eq_sym [m1]
m4: $ G , k = cdm s , k ∊ ω ⇒ isset a $ by isset_var
m5: $ G , k = cdm s , k ∊ ω ⇒ cdm (scons a s) = suc k $ by s2_scons_cdm [m4, m2, m3]
m6: $ G , k = cdm s , k ∊ ω ⇒ suc k ∈ ω $ by omega_suc [m2]
m7: $ G , k = cdm s , k ∊ ω ⇒ suc k = cdm (scons a s) $ by eq_sym [m5]
m8: $ G , k = cdm s , k ∊ ω ⇒ cdm (scons a s) ∈ ω $ by wcel_eq_l [m7, m6]
l6: $ G ⇒ cdm (scons a s) ∈ ω $ by wcel_elim [l5, m8]
n1: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s ⇒ ⟨ x , y ⟩ ∈ scons a s $ by ax
n2: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s ⇒ isset x $ by isset_var
n3: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s ⇒ isset a $ by isset_var
n4: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s ⇒ (x = ∅ ∧ y = a) ∨ ∃ j (x = suc j ∧ ⟨ j , y ⟩ ∈ s) $ by scons_pair [n1, n2, n3]
o1: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = ∅ ∧ y = a ⇒ x = ∅ ∧ y = a $ by ax
o2: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = ∅ ∧ y = a ⇒ y = a $ by and_elim_r [o1]
o3: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = ∅ ∧ y = a ⇒ a = y $ by eq_sym [o2]
o4: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = ∅ ∧ y = a ⇒ a ∊ A $ by weaken [#1]
o5: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = ∅ ∧ y = a ⇒ y ∊ A $ by welc_eq_set [o3, o4]
p1: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ x = suc j ∧ ⟨ j , y ⟩ ∈ s $ by ax
p2: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ ⟨ j , y ⟩ ∈ s $ by and_elim_r [p1]
p3: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ y ∊ crn s $ by crn_intro [p2]
p4: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ s ∊ fseq A $ by weaken [#2]
p5: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ crn s ⊆ A $ by fseq_crn [p4]
p6: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , x = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ y ∊ A $ by subset_elim [p5, p3]
p7: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , ∃ j (x = suc j ∧ ⟨ j , y ⟩ ∈ s) ⇒ ∃ j (x = suc j ∧ ⟨ j , y ⟩ ∈ s) $ by ax
p8: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s , ∃ j (x = suc j ∧ ⟨ j , y ⟩ ∈ s) ⇒ y ∊ A $ by ex_elim [p7, p6]
n5: $ G , y ∊ crn (scons a s) , ⟨ x , y ⟩ ∈ scons a s ⇒ y ∊ A $ by or_elim [n4, o5, p8]
n6: $ G , y ∊ crn (scons a s) ⇒ y ∊ crn (scons a s) $ by ax
n7: $ G , y ∊ crn (scons a s) ⇒ y ∊ A $ by crn_elim [n6, n5]
n8: $ G ⇒ crn (scons a s) ⊆ A $ by subset_intro [n7]
n9: $ G ⇒ scons a s ∈ fseq A $ by s2_fseq_c [l3, l4, l6, n8]

scons_len
---------
l1: $ G ⇒ cdm s ∈ ω $ by fseq_len [#1]
l2: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
l3: $ G , k = cdm s , k ∊ ω ⇒ k ∊ ω $ by ax
l4: $ G , k = cdm s , k ∊ ω ⇒ cdm s = k $ by eq_sym [l2]
l5: $ G , k = cdm s , k ∊ ω ⇒ isset a $ by isset_var
l6: $ G , k = cdm s , k ∊ ω ⇒ cdm (scons a s) = suc k $ by s2_scons_cdm [l5, l3, l4]
l7: $ G , k = cdm s , k ∊ ω ⇒ suc k = suc (cdm s) $ by suc_eq [l2]
l8: $ G , k = cdm s , k ∊ ω ⇒ cdm (scons a s) = suc (cdm s) $ by eq_trans [l6, l7]
l9: $ G ⇒ cdm (scons a s) = suc (cdm s) $ by wcel_elim [l1, l8]

lemma s2_scons_ap_zero (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ ap (scons A S) ∅ = csn A $
----
f1: $ G , y ∊ ap (scons A S) ∅ ⇒ y ∊ ap (scons A S) ∅ $ by ax
f2: $ G , y ∊ ap (scons A S) ∅ ⇒ ⟨ ∅ , y ⟩ ∈ scons A S $ by ap_elim [f1]
f3: $ G , y ∊ ap (scons A S) ∅ ⇒ isset ∅ $ by ax_empty
f4: $ G , y ∊ ap (scons A S) ∅ ⇒ isset A $ by weaken [#1]
f5: $ G , y ∊ ap (scons A S) ∅ ⇒ (∅ = ∅ ∧ y = A) ∨ ∃ i (∅ = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by scons_pair [f2, f3, f4]
g1: $ G , y ∊ ap (scons A S) ∅ , ∅ = ∅ ∧ y = A ⇒ ∅ = ∅ ∧ y = A $ by ax
g2: $ G , y ∊ ap (scons A S) ∅ , ∅ = ∅ ∧ y = A ⇒ y = A $ by and_elim_r [g1]
g3: $ G , y ∊ ap (scons A S) ∅ , ∅ = ∅ ∧ y = A ⇒ y ∊ csn A $ by csn_intro [g2]
h1: $ G , y ∊ ap (scons A S) ∅ , ∃ i (∅ = suc i ∧ ⟨ i , y ⟩ ∈ S) ⇒ ∃ i (∅ = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by ax
h2: $ G , y ∊ ap (scons A S) ∅ , ∅ = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ ∅ = suc i ∧ ⟨ i , y ⟩ ∈ S $ by ax
h3: $ G , y ∊ ap (scons A S) ∅ , ∅ = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ ∅ = suc i $ by and_elim_l [h2]
h4: $ G , y ∊ ap (scons A S) ∅ , ∅ = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ suc i = ∅ $ by eq_sym [h3]
h5: $ G , y ∊ ap (scons A S) ∅ , ∅ = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ ⊥ $ by suc_ne_empty [h4]
h6: $ G , y ∊ ap (scons A S) ∅ , ∅ = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ y ∊ csn A $ by bot_elim [h5]
h7: $ G , y ∊ ap (scons A S) ∅ , ∃ i (∅ = suc i ∧ ⟨ i , y ⟩ ∈ S) ⇒ y ∊ csn A $ by ex_elim [h1, h6]
f6: $ G , y ∊ ap (scons A S) ∅ ⇒ y ∊ csn A $ by or_elim [f5, g3, h7]
k1: $ G , y ∊ csn A ⇒ y ∊ csn A $ by ax
k2: $ G , y ∊ csn A ⇒ y = A $ by csn_elim [k1]
k3: $ G , y ∊ csn A ⇒ isset A $ by weaken [#1]
k4: $ G , y ∊ csn A ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by s2_scons_zero [k3]
k5: $ G , y ∊ csn A ⇒ ∅ = ∅ $ by eq_refl
k6: $ G , y ∊ csn A ⇒ A = y $ by eq_sym [k2]
k7: $ G , y ∊ csn A ⇒ ⟨ ∅ , A ⟩ = ⟨ ∅ , y ⟩ $ by opair_eq [k5, k6]
k8: $ G , y ∊ csn A ⇒ ⟨ ∅ , y ⟩ ∈ scons A S $ by wcel_eq_l [k7, k4]
k9: $ G , y ∊ csn A ⇒ y ∊ ap (scons A S) ∅ $ by ap_intro [k8]
f7: $ G ⇒ ap (scons A S) ∅ = csn A $ by eq_intro [f6, k9]

scons_fv_zero
-------------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ ap (scons a s) ∅ = csn a $ by s2_scons_ap_zero [l1]
l3: $ G ⇒ ⋃ (ap (scons a s) ∅) = ⋃ (csn a) $ by cuni_eq [l2]
l4: $ G ⇒ ⋃ (csn a) = a $ by cuni_csn [l1]
l5: $ G ⇒ fv (scons a s) ∅ = a $ by eq_trans [l3, l4]

scons_fv_suc
------------
m1: $ G , y ∊ ap (scons a s) (suc i) ⇒ y ∊ ap (scons a s) (suc i) $ by ax
m2: $ G , y ∊ ap (scons a s) (suc i) ⇒ ⟨ suc i , y ⟩ ∈ scons a s $ by ap_elim [m1]
m3: $ G , y ∊ ap (scons a s) (suc i) ⇒ isset i $ by isset_var
m4: $ G , y ∊ ap (scons a s) (suc i) ⇒ isset (suc i) $ by suc_set [m3]
m5: $ G , y ∊ ap (scons a s) (suc i) ⇒ isset a $ by isset_var
m6: $ G , y ∊ ap (scons a s) (suc i) ⇒ (suc i = ∅ ∧ y = a) ∨ ∃ j (suc i = suc j ∧ ⟨ j , y ⟩ ∈ s) $ by scons_pair [m2, m4, m5]
n1: $ G , y ∊ ap (scons a s) (suc i) , suc i = ∅ ∧ y = a ⇒ suc i = ∅ ∧ y = a $ by ax
n2: $ G , y ∊ ap (scons a s) (suc i) , suc i = ∅ ∧ y = a ⇒ suc i = ∅ $ by and_elim_l [n1]
n3: $ G , y ∊ ap (scons a s) (suc i) , suc i = ∅ ∧ y = a ⇒ ⊥ $ by suc_ne_empty [n2]
n4: $ G , y ∊ ap (scons a s) (suc i) , suc i = ∅ ∧ y = a ⇒ y ∊ ap s i $ by bot_elim [n3]
p1: $ G , y ∊ ap (scons a s) (suc i) , ∃ j (suc i = suc j ∧ ⟨ j , y ⟩ ∈ s) ⇒ ∃ j (suc i = suc j ∧ ⟨ j , y ⟩ ∈ s) $ by ax
p2: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ suc i = suc j ∧ ⟨ j , y ⟩ ∈ s $ by ax
p3: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ suc i = suc j $ by and_elim_l [p2]
p4: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ i = j $ by suc_inj [p3]
p5: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ ⟨ j , y ⟩ ∈ s $ by and_elim_r [p2]
p6: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ j = i $ by eq_sym [p4]
p7: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ y = y $ by eq_refl
p8: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ ⟨ j , y ⟩ = ⟨ i , y ⟩ $ by opair_eq [p6, p7]
p9: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ ⟨ i , y ⟩ ∈ s $ by wcel_eq_l [p8, p5]
p10: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ y ∊ ap s i $ by ap_intro [p9]
p11: $ G , y ∊ ap (scons a s) (suc i) , ∃ j (suc i = suc j ∧ ⟨ j , y ⟩ ∈ s) ⇒ y ∊ ap s i $ by ex_elim [p1, p10]
m7: $ G , y ∊ ap (scons a s) (suc i) ⇒ y ∊ ap s i $ by or_elim [m6, n4, p11]
q1: $ G , y ∊ ap s i ⇒ y ∊ ap s i $ by ax
q2: $ G , y ∊ ap s i ⇒ ⟨ i , y ⟩ ∈ s $ by ap_elim [q1]
q3: $ G , y ∊ ap s i ⇒ ⟨ suc i , y ⟩ ∈ scons a s $ by s2_scons_suc [q2]
q4: $ G , y ∊ ap s i ⇒ y ∊ ap (scons a s) (suc i) $ by ap_intro [q3]
r1: $ G ⇒ ap (scons a s) (suc i) = ap s i $ by eq_intro [m7, q4]
r2: $ G ⇒ fv (scons a s) (suc i) = fv s i $ by cuni_eq [r1]

lemma s2_scons_inj_half (G: hyps) (a b s t x y: set):
  $ G ⇒ scons a s = scons b t $ > $ G ⇒ ⟨ x , y ⟩ ∈ s $ > $ G ⇒ ⟨ x , y ⟩ ∈ t $
----
l1: $ G ⇒ ⟨ suc x , y ⟩ ∈ scons a s $ by s2_scons_suc [#2]
l2: $ G ⇒ ⟨ suc x , y ⟩ ∈ scons b t $ by wcel_eq_r [#1, l1]
l3: $ G ⇒ isset x $ by isset_var
l4: $ G ⇒ isset (suc x) $ by suc_set [l3]
l5: $ G ⇒ isset b $ by isset_var
l6: $ G ⇒ (suc x = ∅ ∧ y = b) ∨ ∃ j (suc x = suc j ∧ ⟨ j , y ⟩ ∈ t) $ by scons_pair [l2, l4, l5]
n1: $ G , suc x = ∅ ∧ y = b ⇒ suc x = ∅ ∧ y = b $ by ax
n2: $ G , suc x = ∅ ∧ y = b ⇒ suc x = ∅ $ by and_elim_l [n1]
n3: $ G , suc x = ∅ ∧ y = b ⇒ ⊥ $ by suc_ne_empty [n2]
n4: $ G , suc x = ∅ ∧ y = b ⇒ ⟨ x , y ⟩ ∈ t $ by bot_elim [n3]
p1: $ G , ∃ j (suc x = suc j ∧ ⟨ j , y ⟩ ∈ t) ⇒ ∃ j (suc x = suc j ∧ ⟨ j , y ⟩ ∈ t) $ by ax
p2: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ suc x = suc j ∧ ⟨ j , y ⟩ ∈ t $ by ax
p3: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ suc x = suc j $ by and_elim_l [p2]
p4: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ x = j $ by suc_inj [p3]
p5: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ j = x $ by eq_sym [p4]
p6: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ y = y $ by eq_refl
p7: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ ⟨ j , y ⟩ = ⟨ x , y ⟩ $ by opair_eq [p5, p6]
p8: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ ⟨ j , y ⟩ ∈ t $ by and_elim_r [p2]
p9: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ ⟨ x , y ⟩ ∈ t $ by wcel_eq_l [p7, p8]
p10: $ G , ∃ j (suc x = suc j ∧ ⟨ j , y ⟩ ∈ t) ⇒ ⟨ x , y ⟩ ∈ t $ by ex_elim [p1, p9]
l7: $ G ⇒ ⟨ x , y ⟩ ∈ t $ by or_elim [l6, n4, p10]

scons_inj
---------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ ⟨ ∅ , a ⟩ ∈ scons a s $ by s2_scons_zero [l1]
l3: $ G ⇒ ⟨ ∅ , a ⟩ ∈ scons b t $ by wcel_eq_r [#3, l2]
l4: $ G ⇒ isset ∅ $ by ax_empty
l5: $ G ⇒ isset b $ by isset_var
l6: $ G ⇒ (∅ = ∅ ∧ a = b) ∨ ∃ j (∅ = suc j ∧ ⟨ j , a ⟩ ∈ t) $ by scons_pair [l3, l4, l5]
n1: $ G , ∅ = ∅ ∧ a = b ⇒ ∅ = ∅ ∧ a = b $ by ax
n2: $ G , ∅ = ∅ ∧ a = b ⇒ a = b $ by and_elim_r [n1]
p1: $ G , ∃ j (∅ = suc j ∧ ⟨ j , a ⟩ ∈ t) ⇒ ∃ j (∅ = suc j ∧ ⟨ j , a ⟩ ∈ t) $ by ax
p2: $ G , ∅ = suc j ∧ ⟨ j , a ⟩ ∈ t ⇒ ∅ = suc j ∧ ⟨ j , a ⟩ ∈ t $ by ax
p3: $ G , ∅ = suc j ∧ ⟨ j , a ⟩ ∈ t ⇒ ∅ = suc j $ by and_elim_l [p2]
p4: $ G , ∅ = suc j ∧ ⟨ j , a ⟩ ∈ t ⇒ suc j = ∅ $ by eq_sym [p3]
p5: $ G , ∅ = suc j ∧ ⟨ j , a ⟩ ∈ t ⇒ ⊥ $ by suc_ne_empty [p4]
p6: $ G , ∅ = suc j ∧ ⟨ j , a ⟩ ∈ t ⇒ a = b $ by bot_elim [p5]
p7: $ G , ∃ j (∅ = suc j ∧ ⟨ j , a ⟩ ∈ t) ⇒ a = b $ by ex_elim [p1, p6]
l7: $ G ⇒ a = b $ by or_elim [l6, n2, p7]
q1: $ G , ⟨ x , y ⟩ ∈ s ⇒ scons a s = scons b t $ by weaken [#3]
q2: $ G , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
q3: $ G , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ t $ by s2_scons_inj_half [q1, q2]
q4: $ G ⇒ scons b t = scons a s $ by eq_sym [#3]
q5: $ G , ⟨ x , y ⟩ ∈ t ⇒ scons b t = scons a s $ by weaken [q4]
q6: $ G , ⟨ x , y ⟩ ∈ t ⇒ ⟨ x , y ⟩ ∈ t $ by ax
q7: $ G , ⟨ x , y ⟩ ∈ t ⇒ ⟨ x , y ⟩ ∈ s $ by s2_scons_inj_half [q5, q6]
q8: $ G ⇒ s = t $ by rel_eq_intro [#1, #2, q3, q7]
q9: $ G ⇒ a = b ∧ s = t $ by and_intro [l7, q8]

scons_ne_empty
--------------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ ⟨ ∅ , a ⟩ ∈ scons a s $ by s2_scons_zero [l1]
l3: $ G ⇒ ⟨ ∅ , a ⟩ ∈ ∅ $ by wcel_eq_r [#1, l2]
l4: $ G , z = ⟨ ∅ , a ⟩ , z ∊ ∅ ⇒ z ∊ ∅ $ by ax
l5: $ G , z = ⟨ ∅ , a ⟩ , z ∊ ∅ ⇒ ⊥ $ by empty_elim [l4]
l6: $ G ⇒ ⊥ $ by wcel_elim [l3, l5]

def s2_shd (S: class) (.i .y .z: set): class = $ {z | ∃ i ∃ y (z = ⟨ i , y ⟩ ∧ ⟨ suc i , y ⟩ ∈ S)} $

lemma s2_functional_elim_c (G: hyps) (F A: class) (b c: set):
  $ G ⇒ functional F $ > $ G ⇒ ⟨ A , b ⟩ ∈ F $ > $ G ⇒ ⟨ A , c ⟩ ∈ F $ > $ G ⇒ isset A $ > $ G ⇒ b = c $
----
l1: $ G , u = A ⇒ u = A $ by ax
l2: $ G , u = A ⇒ A = u $ by eq_sym [l1]
l3: $ G , u = A ⇒ b = b $ by eq_refl
l4: $ G , u = A ⇒ c = c $ by eq_refl
l5: $ G , u = A ⇒ ⟨ A , b ⟩ = ⟨ u , b ⟩ $ by opair_eq [l2, l3]
l6: $ G , u = A ⇒ ⟨ A , c ⟩ = ⟨ u , c ⟩ $ by opair_eq [l2, l4]
l7: $ G , u = A ⇒ ⟨ A , b ⟩ ∈ F $ by weaken [#2]
l8: $ G , u = A ⇒ ⟨ A , c ⟩ ∈ F $ by weaken [#3]
l9: $ G , u = A ⇒ ⟨ u , b ⟩ ∈ F $ by wcel_eq_l [l5, l7]
l10: $ G , u = A ⇒ ⟨ u , c ⟩ ∈ F $ by wcel_eq_l [l6, l8]
l11: $ G , u = A ⇒ functional F $ by weaken [#1]
l12: $ G , u = A ⇒ b = c $ by functional_elim [l11, l9, l10]
l13: $ G ⇒ b = c $ by isset_elim [#4, l12]

lemma s2_shd_intro (G: hyps) (S: class) (i y: set):
  $ G ⇒ ⟨ suc i , y ⟩ ∈ S $ > $ G ⇒ ⟨ i , y ⟩ ∈ s2_shd S $
----
l1: $ G ⇒ isset i $ by isset_var
l2: $ G ⇒ isset y $ by isset_var
l3: $ G ⇒ isset ⟨ i , y ⟩ $ by opair_set [l1, l2]
l4: $ G , z = ⟨ i , y ⟩ ⇒ z = ⟨ i , y ⟩ $ by ax
l5: $ G , z = ⟨ i , y ⟩ ⇒ ⟨ suc i , y ⟩ ∈ S $ by weaken [#1]
l6: $ G , z = ⟨ i , y ⟩ ⇒ z = ⟨ i , y ⟩ ∧ ⟨ suc i , y ⟩ ∈ S $ by and_intro [l4, l5]
l7: $ G , z = ⟨ i , y ⟩ ⇒ ∃ k (z = ⟨ i , k ⟩ ∧ ⟨ suc i , k ⟩ ∈ S) $ by ex_intro (x := $ k $, t := $ y $, p := $ z = ⟨ i , k ⟩ ∧ ⟨ suc i , k ⟩ ∈ S $) [l6]
l8: $ G , z = ⟨ i , y ⟩ ⇒ ∃ j ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by ex_intro (x := $ j $, t := $ i $, p := $ ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $) [l7]
l9: $ G , z = ⟨ i , y ⟩ ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S)} $ by cab_intro (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $) [l8]
l10: $ G , z = ⟨ i , y ⟩ ⇒ ⟨ i , y ⟩ ∈ s2_shd S $ by wcel_intro [l4, l9]
l11: $ G ⇒ ⟨ i , y ⟩ ∈ s2_shd S $ by isset_elim [l3, l10]

lemma s2_shd_elim (G: hyps) (S: class) (x y: set):
  $ G ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ > $ G ⇒ ⟨ suc x , y ⟩ ∈ S $
----
l1: $ G , z = ⟨ x , y ⟩ , z ∊ s2_shd S ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S)} $ by ax
l2: $ G , z = ⟨ x , y ⟩ , z ∊ s2_shd S ⇒ ∃ j ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by cab_elim (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $) [l1]
c1: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S $ by ax
c2: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ z = ⟨ j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ ⟨ suc j , k ⟩ ∈ S $ by and_elim_r [c1]
c4: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ z = ⟨ x , y ⟩ $ by ax
c5: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ ⟨ x , y ⟩ = z $ by eq_sym [c4]
c6: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ ⟨ x , y ⟩ = ⟨ j , k ⟩ $ by eq_trans [c5, c2]
c7: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ x = j $ by opair_inj_l [c6]
c8: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ y = k $ by opair_inj_r [c6]
c9: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ j = x $ by eq_sym [c7]
c10: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ k = y $ by eq_sym [c8]
c11: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ suc j = suc x $ by suc_eq [c9]
c12: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ ⟨ suc j , k ⟩ = ⟨ suc x , y ⟩ $ by opair_eq [c11, c10]
c13: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ ⟨ suc x , y ⟩ ∈ S $ by wcel_eq_l [c12, c3]
d1: $ G , z = ⟨ x , y ⟩ , ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) ⇒ ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by ax
d2: $ G , z = ⟨ x , y ⟩ , ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) ⇒ ⟨ suc x , y ⟩ ∈ S $ by ex_elim [d1, c13]
d3: $ G , z = ⟨ x , y ⟩ , z ∊ s2_shd S ⇒ ⟨ suc x , y ⟩ ∈ S $ by ex_elim [l2, d2]
d4: $ G ⇒ ⟨ suc x , y ⟩ ∈ S $ by wcel_elim [#1, d3]

lemma s2_shd_rel (G: hyps) (S: class): $ G ⇒ rel (s2_shd S) $
----
l1: $ G , z ∊ s2_shd S ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S)} $ by ax
l2: $ G , z ∊ s2_shd S ⇒ ∃ j ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by cab_elim (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $) [l1]
c1: $ G , z ∊ s2_shd S , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S $ by ax
c2: $ G , z ∊ s2_shd S , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ z = ⟨ j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z ∊ s2_shd S , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ isset j $ by isset_var
c5: $ G , z ∊ s2_shd S , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ isset k $ by isset_var
c6: $ G , z ∊ s2_shd S , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by s2_opair_ex [c2, c3, c5]
d1: $ G , z ∊ s2_shd S , ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) ⇒ ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by ax
d2: $ G , z ∊ s2_shd S , ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [d1, c6]
d3: $ G , z ∊ s2_shd S ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [l2, d2]
e2: $ G ⇒ rel (s2_shd S) $ by rel_intro [d3]

lemma s2_shd_functional (G: hyps) (S: class): $ G ⇒ functional S $ > $ G ⇒ functional (s2_shd S) $
----
l1: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ by ax
l2: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ ⟨ x , z ⟩ ∈ s2_shd S $ by ax
l3: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ ⟨ suc x , y ⟩ ∈ S $ by s2_shd_elim [l1]
l4: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ ⟨ suc x , z ⟩ ∈ S $ by s2_shd_elim [l2]
l5: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ functional S $ by weaken [#1]
l6: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ isset x $ by isset_var
l7: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ isset (suc x) $ by suc_set [l6]
l8: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ y = z $ by s2_functional_elim_c [l5, l3, l4, l7]
l9: $ G ⇒ functional (s2_shd S) $ by functional_intro [l8]

lemma s2_shd_cdm (G: hyps) (S: class) (m: set):
  $ G ⇒ m ∊ ω $ > $ G ⇒ cdm S = suc m $ > $ G ⇒ cdm (s2_shd S) = m $
----
a1: $ G , x ∊ cdm (s2_shd S) ⇒ x ∊ cdm (s2_shd S) $ by ax
a2: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ by ax
a3: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ ⟨ suc x , y ⟩ ∈ S $ by s2_shd_elim [a2]
a4: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset x $ by isset_var
a5: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset (suc x) $ by suc_set [a4]
a6: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset y $ by isset_var
a7: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ suc x ∈ cdm S $ by s2_cdm_intro_c [a3, a5, a6]
a8: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ cdm S = suc m $ by weaken [#2]
a9: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ suc x ∈ suc m $ by wcel_eq_r [a8, a7]
a10: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ m ∊ ω $ by weaken [#1]
a11: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ ord m $ by ord_omega_elem [a10]
a12: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ x ∊ m $ by ord_suc_elem_suc_elim [a11, a9]
a13: $ G , x ∊ cdm (s2_shd S) ⇒ x ∊ m $ by cdm_elim [a1, a12]
b1: $ G , x ∊ m ⇒ x ∊ m $ by ax
b2: $ G , x ∊ m ⇒ m ∊ ω $ by weaken [#1]
b3: $ G , x ∊ m ⇒ ord m $ by ord_omega_elem [b2]
b4: $ G , x ∊ m ⇒ suc x ∈ suc m $ by ord_suc_elem_suc [b3, b1]
b5: $ G , x ∊ m ⇒ cdm S = suc m $ by weaken [#2]
b6: $ G , x ∊ m ⇒ suc m = cdm S $ by eq_sym [b5]
b7: $ G , x ∊ m ⇒ suc x ∈ cdm S $ by wcel_eq_r [b6, b4]
c1: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ ⟨ u , y ⟩ ∈ S $ by ax
c2: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ u = suc x $ by ax
c3: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ y = y $ by eq_refl
c4: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ ⟨ u , y ⟩ = ⟨ suc x , y ⟩ $ by opair_eq [c2, c3]
c5: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ ⟨ suc x , y ⟩ ∈ S $ by wcel_eq_l [c4, c1]
c6: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ by s2_shd_intro [c5]
c7: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ x ∊ cdm (s2_shd S) $ by cdm_intro [c6]
c8: $ G , x ∊ m , u = suc x , u ∊ cdm S ⇒ u ∊ cdm S $ by ax
c9: $ G , x ∊ m , u = suc x , u ∊ cdm S ⇒ x ∊ cdm (s2_shd S) $ by cdm_elim [c8, c7]
c10: $ G , x ∊ m ⇒ x ∊ cdm (s2_shd S) $ by wcel_elim [b7, c9]
c11: $ G ⇒ cdm (s2_shd S) = m $ by eq_intro [a13, c10]

lemma s2_shd_crn (G: hyps) (S: class): $ G ⇒ crn (s2_shd S) ⊆ crn S $
----
l1: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ by ax
l2: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ ⟨ suc x , y ⟩ ∈ S $ by s2_shd_elim [l1]
l3: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset x $ by isset_var
l4: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset (suc x) $ by suc_set [l3]
l5: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset y $ by isset_var
l6: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ y ∈ crn S $ by s2_crn_intro_c [l2, l4, l5]
l7: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ y ∊ crn S $ by wcel_welc [l6]
l8: $ G , y ∊ crn (s2_shd S) ⇒ y ∊ crn (s2_shd S) $ by ax
l9: $ G , y ∊ crn (s2_shd S) ⇒ y ∊ crn S $ by crn_elim [l8, l7]
l10: $ G ⇒ crn (s2_shd S) ⊆ crn S $ by subset_intro [l9]

lemma s2_cases_eq (G: hyps) (s c m: set):
  $ G ⇒ rel s $ > $ G ⇒ functional s $ > $ G ⇒ m ∊ ω $ > $ G ⇒ cdm s = suc m $ >
  $ G ⇒ ⟨ ∅ , c ⟩ ∈ s $ > $ G ⇒ s = scons c (s2_shd s) $
----
l1: $ G ⇒ isset c $ by isset_var
l2: $ G ⇒ rel (scons c (s2_shd s)) $ by s2_scons_rel [l1]
a1: $ G , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
a2: $ G , ⟨ x , y ⟩ ∈ s ⇒ x ∊ cdm s $ by cdm_intro [a1]
a3: $ G , ⟨ x , y ⟩ ∈ s ⇒ cdm s = suc m $ by weaken [#4]
a4: $ G , ⟨ x , y ⟩ ∈ s ⇒ x ∊ suc m $ by welc_eq [a3, a2]
a5: $ G , ⟨ x , y ⟩ ∈ s ⇒ m ∊ ω $ by weaken [#3]
a6: $ G , ⟨ x , y ⟩ ∈ s ⇒ x ∊ ω $ by omega_suc_elem_omega [a5, a4]
a7: $ G , ⟨ x , y ⟩ ∈ s ⇒ x = ∅ ∨ ∃ j (j ∊ ω ∧ x = suc j) $ by omega_cases [a6]
p1: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ x = ∅ $ by ax
p2: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ y = y $ by eq_refl
p3: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ x , y ⟩ = ⟨ ∅ , y ⟩ $ by opair_eq [p1, p2]
p4: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ x , y ⟩ ∈ s $ by ax
p5: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ ∅ , y ⟩ ∈ s $ by wcel_eq_l [p3, p4]
p6: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ ∅ , c ⟩ ∈ s $ by weaken [#5]
p7: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ functional s $ by weaken [#2]
p8: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ isset ∅ $ by ax_empty
p9: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ c = y $ by s2_functional_elim_c [p7, p6, p5, p8]
p10: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ isset c $ by isset_var
p11: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ ∅ , c ⟩ ∈ scons c (s2_shd s) $ by s2_scons_zero [p10]
p12: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ∅ = x $ by eq_sym [p1]
p13: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ ∅ , c ⟩ = ⟨ x , y ⟩ $ by opair_eq [p12, p9]
p14: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ x , y ⟩ ∈ scons c (s2_shd s) $ by wcel_eq_l [p13, p11]
q1: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ j ∊ ω ∧ x = suc j $ by ax
q2: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ x = suc j $ by and_elim_r [q1]
q3: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ y = y $ by eq_refl
q4: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ ⟨ x , y ⟩ = ⟨ suc j , y ⟩ $ by opair_eq [q2, q3]
q5: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ ⟨ x , y ⟩ ∈ s $ by ax
q6: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ ⟨ suc j , y ⟩ ∈ s $ by wcel_eq_l [q4, q5]
q7: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ ⟨ j , y ⟩ ∈ s2_shd s $ by s2_shd_intro [q6]
q8: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ ⟨ suc j , y ⟩ ∈ scons c (s2_shd s) $ by s2_scons_suc [q7]
q9: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ suc j = x $ by eq_sym [q2]
q10: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ ⟨ suc j , y ⟩ = ⟨ x , y ⟩ $ by opair_eq [q9, q3]
q11: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ ⟨ x , y ⟩ ∈ scons c (s2_shd s) $ by wcel_eq_l [q10, q8]
q12: $ G , ⟨ x , y ⟩ ∈ s , ∃ j (j ∊ ω ∧ x = suc j) ⇒ ∃ j (j ∊ ω ∧ x = suc j) $ by ax
q13: $ G , ⟨ x , y ⟩ ∈ s , ∃ j (j ∊ ω ∧ x = suc j) ⇒ ⟨ x , y ⟩ ∈ scons c (s2_shd s) $ by ex_elim [q12, q11]
a8: $ G , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ scons c (s2_shd s) $ by or_elim [a7, p14, q13]
b1: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) ⇒ ⟨ x , y ⟩ ∈ scons c (s2_shd s) $ by ax
b2: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) ⇒ isset x $ by isset_var
b3: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) ⇒ isset c $ by isset_var
b4: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) ⇒ (x = ∅ ∧ y = c) ∨ ∃ j (x = suc j ∧ ⟨ j , y ⟩ ∈ s2_shd s) $ by scons_pair [b1, b2, b3]
r1: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) , x = ∅ ∧ y = c ⇒ x = ∅ ∧ y = c $ by ax
r2: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) , x = ∅ ∧ y = c ⇒ x = ∅ $ by and_elim_l [r1]
r3: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) , x = ∅ ∧ y = c ⇒ y = c $ by and_elim_r [r1]
r4: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) , x = ∅ ∧ y = c ⇒ ∅ = x $ by eq_sym [r2]
r5: $ G , ⟨ x , y ⟩ ∈ scons c (s2_shd s) , x = ∅ ∧ y = c ⇒ c = y $ by eq_sym [r3]
