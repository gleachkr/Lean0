-- Proofs for seq.mm0.

fseq_congr
----------
l1: $ g ≐ g $ by ceqt_refl
l2: $ k ≐ k $ by ceqt_refl
l3: $ fn_into g k A ⟺ fn_into g k B $ by fn_into_congr [l1, l2, #1]
l4: $ (cdm g = k) ⟺ (cdm g = k) $ by iff_refl
l5: $ (cdm g = k ∧ fn_into g k A) ⟺ (cdm g = k ∧ fn_into g k B) $ by and_congr [l4, l3]
l6: $ rel g ⟺ rel g $ by iff_refl
l7: $ (rel g ∧ cdm g = k ∧ fn_into g k A) ⟺ (rel g ∧ cdm g = k ∧ fn_into g k B) $ by and_congr [l6, l5]
l8: $ (k ∊ ω) ⟺ (k ∊ ω) $ by iff_refl
l9: $ (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) ⟺ (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k B) $ by and_congr [l8, l7]
l10: $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) ⟺ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k B) $ by ex_congr [l9]
l11: $ {g | ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A)} ≐ {g | ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k B)} $ by cab_congr [l10]

welc_fseq_eq
------------
l1: $ G ⇒ ∃ k (k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A) $ by cab_elim (x := $ g $, t := $ a $, p := $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) $) [#2]
l2: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A $ by ax
l3: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ k ∊ ω $ by and_elim_l [l2]
l4: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ rel a ∧ cdm a = k ∧ fn_into a k A $ by and_elim_r [l2]
l5: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ rel a $ by and_elim_l [l4]
l6: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ cdm a = k ∧ fn_into a k A $ by and_elim_r [l4]
l7: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ cdm a = k $ by and_elim_l [l6]
l8: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ fn_into a k A $ by and_elim_r [l6]
l9: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ A = B $ by weaken [#1]
l10: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ a = a $ by eq_refl
l11: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ k = k $ by eq_refl
l12: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ fn_into a k B $ by fn_into_eq [l10, l11, l9, l8]
l13: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ cdm a = k ∧ fn_into a k B $ by and_intro [l7, l12]
l14: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ rel a ∧ cdm a = k ∧ fn_into a k B $ by and_intro [l5, l13]
l15: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k B $ by and_intro [l3, l14]
l16: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ ∃ k (k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k B) $ by ex_intro (x := $ k $, t := $ k $, p := $ k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k B $) [l15]
l17: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ a ∊ fseq B $ by cab_intro (x := $ g $, t := $ a $, p := $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k B) $) [l16]
l18: $ G ⇒ a ∊ fseq B $ by ex_elim [l1, l17]

fseq_eq
-------
l1: $ G , u ∊ fseq A ⇒ u ∊ fseq A $ by ax
l2: $ G , u ∊ fseq A ⇒ A = B $ by weaken [#1]
l3: $ G , u ∊ fseq A ⇒ u ∊ fseq B $ by welc_fseq_eq [l2, l1]
l4: $ G ⇒ B = A $ by eq_sym [#1]
l5: $ G , u ∊ fseq B ⇒ u ∊ fseq B $ by ax
l6: $ G , u ∊ fseq B ⇒ B = A $ by weaken [l4]
l7: $ G , u ∊ fseq B ⇒ u ∊ fseq A $ by welc_fseq_eq [l6, l5]
l8: $ G ⇒ fseq A = fseq B $ by eq_intro [l3, l7]

sb_c_fseq
---------
l1: $ (⟦ x / t ⟧ {g | ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A)}) ≐ {g | ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k (⟦ x / t ⟧ A))} $ by ceqt_refl

scons_congr
-----------
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ ⟨ ∅ , A ⟩ ≐ ⟨ ∅ , B ⟩ $ by opair_congr [l1, #1]
l3: $ csn ⟨ ∅ , A ⟩ ≐ csn ⟨ ∅ , B ⟩ $ by csn_congr [l2]
l4: $ ⟨ i , y ⟩ ≐ ⟨ i , y ⟩ $ by ceqt_refl
l5: $ (⟨ i , y ⟩ ∈ C) ⟺ (⟨ i , y ⟩ ∈ D) $ by wcel_congr [l4, #2]
l6: $ (z = ⟨ suc i , y ⟩) ⟺ (z = ⟨ suc i , y ⟩) $ by iff_refl
l7: $ (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by and_congr [l6, l5]
l8: $ ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_congr [l7]
l9: $ ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_congr [l8]
l10: $ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ≐ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)} $ by cab_congr [l9]
l11: $ (csn ⟨ ∅ , A ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)}) ≐ (csn ⟨ ∅ , B ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)}) $ by cun_congr [l3, l10]

welc_scons_eq
-------------
l1: $ G ⇒ a ∊ csn ⟨ ∅ , A ⟩ ∨ a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} $ by cun_elim [#3]
l2: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ a ∊ csn ⟨ ∅ , A ⟩ $ by ax
l3: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ A = B $ by weaken [#1]
l4: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ ⟨ ∅ , A ⟩ = ⟨ ∅ , B ⟩ $ by opair_eq [l4, l3]
l6: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ csn ⟨ ∅ , A ⟩ = csn ⟨ ∅ , B ⟩ $ by csn_eq [l5]
l7: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ a ∊ csn ⟨ ∅ , B ⟩ $ by welc_eq [l6, l2]
l8: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ a ∊ scons B D $ by cun_intro_l [l7]
l9: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} $ by ax
l10: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ ∃ i ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) $ by cab_elim [l9]
l11: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C $ by ax
l12: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ suc i , y ⟩ $ by and_elim_l [l11]
l13: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ i , y ⟩ ∈ C $ by and_elim_r [l11]
l14: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ C = D $ by weaken [#2]
l15: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ i , y ⟩ ∈ D $ by wcel_eq_r [l14, l13]
l16: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D $ by and_intro [l12, l15]
l17: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_intro (x := $ y $, t := $ y $, p := $ a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D $) [l16]
l18: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ∃ i ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_intro (x := $ i $, t := $ i $, p := $ ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $) [l17]
l19: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)} $ by cab_intro (x := $ z $, t := $ a $, p := $ ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $) [l18]
l20: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a ∊ scons B D $ by cun_intro_r [l19]
l21: $ G , ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⇒ ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) $ by ax
l22: $ G , ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⇒ a ∊ scons B D $ by ex_elim [l21, l20]
l23: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ a ∊ scons B D $ by ex_elim [l10, l22]
l24: $ G ⇒ a ∊ scons B D $ by or_elim [l1, l8, l23]

scons_eq
--------
l1: $ G , u ∊ scons A C ⇒ u ∊ scons A C $ by ax
l2: $ G , u ∊ scons A C ⇒ A = B $ by weaken [#1]
l3: $ G , u ∊ scons A C ⇒ C = D $ by weaken [#2]
l4: $ G , u ∊ scons A C ⇒ u ∊ scons B D $ by welc_scons_eq [l2, l3, l1]
l5: $ G ⇒ B = A $ by eq_sym [#1]
l6: $ G ⇒ D = C $ by eq_sym [#2]
l7: $ G , u ∊ scons B D ⇒ u ∊ scons B D $ by ax
l8: $ G , u ∊ scons B D ⇒ B = A $ by weaken [l5]
l9: $ G , u ∊ scons B D ⇒ D = C $ by weaken [l6]
l10: $ G , u ∊ scons B D ⇒ u ∊ scons A C $ by welc_scons_eq [l8, l9, l7]
l11: $ G ⇒ scons A C = scons B D $ by eq_intro [l4, l10]

sb_c_scons
----------
l1: $ (⟦ x / t ⟧ (csn ⟨ ∅ , A ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ B)})) ≐ (csn ⟨ ∅ , ⟦ x / t ⟧ A ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ (⟦ x / t ⟧ B))}) $ by ceqt_refl

ssnoc_congr
-----------
l1: $ cdm A ≐ cdm B $ by cdm_congr [#1]
l2: $ ⟨ cdm A , C ⟩ ≐ ⟨ cdm B , D ⟩ $ by opair_congr [l1, #2]
l3: $ csn ⟨ cdm A , C ⟩ ≐ csn ⟨ cdm B , D ⟩ $ by csn_congr [l2]
l4: $ (A ∪ csn ⟨ cdm A , C ⟩) ≐ (B ∪ csn ⟨ cdm B , D ⟩) $ by cun_congr [#1, l3]

ssnoc_eq
--------
l1: $ G ⇒ cdm A = cdm B $ by cdm_eq [#1]
l2: $ G ⇒ ⟨ cdm A , C ⟩ = ⟨ cdm B , D ⟩ $ by opair_eq [l1, #2]
l3: $ G ⇒ csn ⟨ cdm A , C ⟩ = csn ⟨ cdm B , D ⟩ $ by csn_eq [l2]
l4: $ G ⇒ A ∪ csn ⟨ cdm A , C ⟩ = B ∪ csn ⟨ cdm B , D ⟩ $ by cun_eq [#1, l3]

sb_c_ssnoc
----------
l1: $ (⟦ x / t ⟧ (A ∪ csn ⟨ cdm A , B ⟩)) ≐ ((⟦ x / t ⟧ A) ∪ csn ⟨ cdm (⟦ x / t ⟧ A) , ⟦ x / t ⟧ B ⟩) $ by ceqt_refl

scat_congr
----------
l1: $ cdm A ≐ cdm B $ by cdm_congr [#1]
l2: $ i ≐ i $ by ceqt_refl
l3: $ nadd (cdm A) i ≐ nadd (cdm B) i $ by nadd_congr [l1, l2]
l4: $ y ≐ y $ by ceqt_refl
l5: $ ⟨ nadd (cdm A) i , y ⟩ ≐ ⟨ nadd (cdm B) i , y ⟩ $ by opair_congr [l3, l4]
l6: $ z ≐ z $ by ceqt_refl
l7: $ (z = ⟨ nadd (cdm A) i , y ⟩) ⟺ (z = ⟨ nadd (cdm B) i , y ⟩) $ by ceq_congr [l6, l5]
l8: $ ⟨ i , y ⟩ ≐ ⟨ i , y ⟩ $ by ceqt_refl
l9: $ (⟨ i , y ⟩ ∈ C) ⟺ (⟨ i , y ⟩ ∈ D) $ by wcel_congr [l8, #2]
l10: $ (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by and_congr [l7, l9]
l11: $ ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_congr [l10]
l12: $ ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_congr [l11]
l13: $ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ≐ {z | ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)} $ by cab_congr [l12]
l14: $ (A ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)}) ≐ (B ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)}) $ by cun_congr [#1, l13]

welc_scat_eq
------------
l1: $ G ⇒ a ∊ A ∨ a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} $ by cun_elim [#3]
l2: $ G , a ∊ A ⇒ a ∊ A $ by ax
l3: $ G , a ∊ A ⇒ A = B $ by weaken [#1]
l4: $ G , a ∊ A ⇒ a ∊ B $ by welc_eq [l3, l2]
l5: $ G , a ∊ A ⇒ a ∊ scat B D $ by cun_intro_l [l4]
l9: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} $ by ax
l10: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ ∃ i ∃ y (a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) $ by cab_elim [l9]
l11: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C $ by ax
l12: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ nadd (cdm A) i , y ⟩ $ by and_elim_l [l11]
l13: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ i , y ⟩ ∈ C $ by and_elim_r [l11]
l14: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ C = D $ by weaken [#2]
l15: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ i , y ⟩ ∈ D $ by wcel_eq_r [l14, l13]
l30: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ A = B $ by weaken [#1]
l31: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ cdm A = cdm B $ by cdm_eq [l30]
l32: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ i = i $ by eq_refl
l33: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ nadd (cdm A) i = nadd (cdm B) i $ by nadd_eq [l31, l32]
l34: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ y = y $ by eq_refl
l35: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ nadd (cdm A) i , y ⟩ = ⟨ nadd (cdm B) i , y ⟩ $ by opair_eq [l33, l34]
l36: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ nadd (cdm B) i , y ⟩ $ by eq_trans [l12, l35]
l16: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D $ by and_intro [l36, l15]
l17: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ∃ y (a = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_intro (x := $ y $, t := $ y $, p := $ a = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D $) [l16]
l18: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ∃ i ∃ y (a = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_intro (x := $ i $, t := $ i $, p := $ ∃ y (a = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $) [l17]
l19: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)} $ by cab_intro (x := $ z $, t := $ a $, p := $ ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $) [l18]
l20: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a ∊ scat B D $ by cun_intro_r [l19]
l21: $ G , ∃ y (a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⇒ ∃ y (a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) $ by ax
l22: $ G , ∃ y (a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⇒ a ∊ scat B D $ by ex_elim [l21, l20]
l23: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ a ∊ scat B D $ by ex_elim [l10, l22]
l24: $ G ⇒ a ∊ scat B D $ by or_elim [l1, l5, l23]

scat_eq
-------
l1: $ G , u ∊ scat A C ⇒ u ∊ scat A C $ by ax
l2: $ G , u ∊ scat A C ⇒ A = B $ by weaken [#1]
l3: $ G , u ∊ scat A C ⇒ C = D $ by weaken [#2]
l4: $ G , u ∊ scat A C ⇒ u ∊ scat B D $ by welc_scat_eq [l2, l3, l1]
l5: $ G ⇒ B = A $ by eq_sym [#1]
l6: $ G ⇒ D = C $ by eq_sym [#2]
l7: $ G , u ∊ scat B D ⇒ u ∊ scat B D $ by ax
l8: $ G , u ∊ scat B D ⇒ B = A $ by weaken [l5]
l9: $ G , u ∊ scat B D ⇒ D = C $ by weaken [l6]
l10: $ G , u ∊ scat B D ⇒ u ∊ scat A C $ by welc_scat_eq [l8, l9, l7]
l11: $ G ⇒ scat A C = scat B D $ by eq_intro [l4, l10]

sb_c_scat
---------
l1: $ (⟦ x / t ⟧ (A ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ B)})) ≐ ((⟦ x / t ⟧ A) ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm (⟦ x / t ⟧ A)) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ (⟦ x / t ⟧ B))}) $ by ceqt_refl

fseq_intro
----------
l1: $ G ⇒ cdm s = n ∧ fn_into s n A $ by and_intro [#3, #4]
l2: $ G ⇒ rel s ∧ cdm s = n ∧ fn_into s n A $ by and_intro [#2, l1]
l3: $ G ⇒ n ∊ ω ∧ rel s ∧ cdm s = n ∧ fn_into s n A $ by and_intro [#1, l2]
l4: $ G ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by ex_intro (x := $ k $, t := $ n $, p := $ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $) [l3]
l5: $ G ⇒ s ∊ fseq A $ by cab_intro (x := $ g $, t := $ s $, p := $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) $) [l4]

fseq_of_fn
----------
l1: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
l2: $ G , k = cdm s , k ∊ ω ⇒ k ∊ ω $ by ax
l3: $ G , k = cdm s , k ∊ ω , x ∊ k ⇒ x ∊ k $ by ax
l4: $ G , k = cdm s , k ∊ ω , x ∊ k ⇒ k = cdm s $ by weaken [l1]
l5: $ G , k = cdm s , k ∊ ω , x ∊ k ⇒ x ∊ cdm s $ by welc_eq [l4, l3]
l6: $ G , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
l7: $ G , ⟨ x , y ⟩ ∈ s ⇒ y ∊ crn s $ by crn_intro [l6]
l8: $ G , ⟨ x , y ⟩ ∈ s ⇒ crn s ⊆ A $ by weaken [#4]
l9: $ G , ⟨ x , y ⟩ ∈ s ⇒ y ∊ A $ by subset_elim [l8, l7]
l10: $ G , ⟨ x , y ⟩ ∈ s ⇒ y ∊ A ∧ ⟨ x , y ⟩ ∈ s $ by and_intro [l9, l6]
l11: $ G , ⟨ x , y ⟩ ∈ s ⇒ ∃ v (v ∊ A ∧ ⟨ x , v ⟩ ∈ s) $ by ex_intro (x := $ v $, t := $ y $, p := $ v ∊ A ∧ ⟨ x , v ⟩ ∈ s $) [l10]
l12: $ G , k = cdm s , k ∊ ω , x ∊ k ⇒ ∃ v (v ∊ A ∧ ⟨ x , v ⟩ ∈ s) $ by cdm_elim [l5, l11]
l13: $ G , k = cdm s , k ∊ ω ⇒ functional s $ by weaken [#1]
l14: $ G , k = cdm s , k ∊ ω ⇒ fn_into s k A $ by fn_into_intro [l13, l12]
l15: $ G , k = cdm s , k ∊ ω ⇒ rel s $ by weaken [#2]
l16: $ G , k = cdm s , k ∊ ω ⇒ cdm s = k $ by eq_sym [l1]
l17: $ G , k = cdm s , k ∊ ω ⇒ s ∊ fseq A $ by fseq_intro [l2, l15, l16, l14]
l18: $ G ⇒ s ∊ fseq A $ by wcel_elim [#3, l17]

fseq_functional
---------------
l1: $ G ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by cab_elim (x := $ g $, t := $ s $, p := $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) $) [#1]
l2: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $ by ax
l3: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ rel s ∧ cdm s = k ∧ fn_into s k A $ by and_elim_r [l2]
l4: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ cdm s = k ∧ fn_into s k A $ by and_elim_r [l3]
l5: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ fn_into s k A $ by and_elim_r [l4]
l6: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ functional s $ by fn_into_functional [l5]
l7: $ G ⇒ functional s $ by ex_elim [l1, l6]

fseq_rel
--------
l1: $ G ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by cab_elim (x := $ g $, t := $ s $, p := $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) $) [#1]
l2: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $ by ax
l3: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ rel s ∧ cdm s = k ∧ fn_into s k A $ by and_elim_r [l2]
l4: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ rel s $ by and_elim_l [l3]
l5: $ G ⇒ rel s $ by ex_elim [l1, l4]

fseq_len
--------
l1: $ G ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by cab_elim (x := $ g $, t := $ s $, p := $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) $) [#1]
l2: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $ by ax
l3: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω $ by and_elim_l [l2]
l4: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ rel s ∧ cdm s = k ∧ fn_into s k A $ by and_elim_r [l2]
l5: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ cdm s = k ∧ fn_into s k A $ by and_elim_r [l4]
l6: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ cdm s = k $ by and_elim_l [l5]
l7: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k = cdm s $ by eq_sym [l6]
l8: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ cdm s ∈ ω $ by wcel_intro [l7, l3]
l9: $ G ⇒ cdm s ∈ ω $ by ex_elim [l1, l8]

fseq_fn_into
------------
l1: $ G ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by cab_elim (x := $ g $, t := $ s $, p := $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) $) [#1]
l2: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $ by ax
l4: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ rel s ∧ cdm s = k ∧ fn_into s k A $ by and_elim_r [l2]
l5: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ cdm s = k ∧ fn_into s k A $ by and_elim_r [l4]
l6: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ cdm s = k $ by and_elim_l [l5]
l7: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ fn_into s k A $ by and_elim_r [l5]
l8: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k = cdm s $ by eq_sym [l6]
l9: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ s = s $ by eq_refl
l10: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ A = A $ by eq_refl
l11: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ fn_into s (cdm s) A $ by fn_into_eq [l9, l8, l10, l7]
l12: $ G ⇒ fn_into s (cdm s) A $ by ex_elim [l1, l11]

fseq_fv
-------
l1: $ G ⇒ fn_into s (cdm s) A $ by fseq_fn_into [#1]
l2: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ ⟨ i , y ⟩ ∈ s $ by ax
l3: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ y ∊ A $ by ax
l4: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ s ∊ fseq A $ by weaken [#1]
l5: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ functional s $ by fseq_functional [l4]
l6: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ fv s i = y $ by fv_val [l5, l2]
l7: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ y = fv s i $ by eq_sym [l6]
l8: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ fv s i ∈ A $ by wcel_intro [l7, l3]
l9: $ G ⇒ fv s i ∈ A $ by fn_into_elim [l1, #2, l8]

fseq_crn
--------
l1: $ G , u ∊ crn s ⇒ u ∊ crn s $ by ax
l2: $ G , ⟨ v , u ⟩ ∈ s ⇒ ⟨ v , u ⟩ ∈ s $ by ax
l3: $ G , ⟨ v , u ⟩ ∈ s ⇒ s ∊ fseq A $ by weaken [#1]
l4: $ G , ⟨ v , u ⟩ ∈ s ⇒ v ∊ cdm s $ by cdm_intro [l2]
l5: $ G , ⟨ v , u ⟩ ∈ s ⇒ fv s v ∈ A $ by fseq_fv [l3, l4]
l6: $ G , ⟨ v , u ⟩ ∈ s ⇒ functional s $ by fseq_functional [l3]
l7: $ G , ⟨ v , u ⟩ ∈ s ⇒ fv s v = u $ by fv_val [l6, l2]
l8: $ G , ⟨ v , u ⟩ ∈ s ⇒ u ∈ A $ by wcel_eq_l [l7, l5]
l9: $ G , ⟨ v , u ⟩ ∈ s ⇒ u ∊ A $ by wcel_welc [l8]
l10: $ G , u ∊ crn s ⇒ u ∊ A $ by crn_elim [l1, l9]
l11: $ G ⇒ crn s ⊆ A $ by subset_intro [l10]

fseq_mono
---------
l1: $ G , u ∊ fseq A ⇒ u ∊ fseq A $ by ax
l2: $ G , u ∊ fseq A ⇒ functional u $ by fseq_functional [l1]
l3: $ G , u ∊ fseq A ⇒ rel u $ by fseq_rel [l1]
l4: $ G , u ∊ fseq A ⇒ cdm u ∈ ω $ by fseq_len [l1]
l5: $ G , u ∊ fseq A ⇒ crn u ⊆ A $ by fseq_crn [l1]
l6: $ G , u ∊ fseq A ⇒ A ⊆ B $ by weaken [#1]
l7: $ G , u ∊ fseq A ⇒ crn u ⊆ B $ by subset_trans [l5, l6]
l8: $ G , u ∊ fseq A ⇒ u ∊ fseq B $ by fseq_of_fn [l2, l3, l4, l7]
l9: $ G ⇒ fseq A ⊆ fseq B $ by subset_intro [l8]

fseq_set
--------
l1: $ G , u ∊ fseq A ⇒ u ∊ fseq A $ by ax
l2: $ G , u ∊ fseq A ⇒ rel u $ by fseq_rel [l1]
l3: $ G , u ∊ fseq A ⇒ u ⊆ cdm u × crn u $ by rel_subset_cxp [l2]
l4: $ G , u ∊ fseq A ⇒ cdm u ∈ ω $ by fseq_len [l1]
l5: $ G , u ∊ fseq A , k = cdm u , k ∊ ω ⇒ k ∊ ω $ by ax
l6: $ G , u ∊ fseq A , k = cdm u , k ∊ ω ⇒ k = cdm u $ by ax
l7: $ G , u ∊ fseq A , k = cdm u , k ∊ ω ⇒ k ⊆ ω $ by omega_elem_subset [l5]
l8: $ G , u ∊ fseq A , k = cdm u , k ∊ ω ⇒ cdm u ⊆ ω $ by subset_eq_l [l6, l7]
l9: $ G , u ∊ fseq A ⇒ cdm u ⊆ ω $ by wcel_elim [l4, l8]
l10: $ G , u ∊ fseq A ⇒ crn u ⊆ A $ by fseq_crn [l1]
l11: $ G , u ∊ fseq A ⇒ cdm u × crn u ⊆ ω × A $ by cxp_mono [l9, l10]
l12: $ G , u ∊ fseq A ⇒ u ⊆ ω × A $ by subset_trans [l3, l11]
l13: $ G , u ∊ fseq A ⇒ u ∊ 𝒫 (ω × A) $ by cpw_intro [l12]
l14: $ G ⇒ fseq A ⊆ 𝒫 (ω × A) $ by subset_intro [l13]
l15: $ G ⇒ isset ω $ by omega_set
l16: $ G ⇒ isset (ω × A) $ by cxp_set [l15, #1]
l17: $ G ⇒ isset (𝒫 (ω × A)) $ by cpw_set [l16]
l18: $ G ⇒ isset (fseq A) $ by subset_isset [l17, l14]

fseq_ext
--------
l1: $ G ⇒ functional s $ by fseq_functional [#1]
l2: $ G ⇒ functional t $ by fseq_functional [#2]
l3: $ G ⇒ rel s $ by fseq_rel [#1]
l4: $ G ⇒ rel t $ by fseq_rel [#2]
l5: $ G ⇒ v ∊ cdm s → fv s v = fv t v $ by all_elim (x := $ i $, t := $ v $, p := $ i ∊ cdm s → fv s i = fv t i $) [#4]
l6: $ G , v ∊ cdm s ⇒ fv s v = fv t v $ by imp_use [l5]
l7: $ G ⇒ s = t $ by fv_ext [l1, l2, l3, l4, #3, l6]

lemma s1_mem_empty (G: hyps) (a b: set): $ G ⇒ a = ∅ $ > $ G ⇒ b ∊ a $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ b ∊ ∅ $ by welc_eq [#1, #2]
l2: $ G ⇒ ⊥ $ by empty_elim [l1]

lemma s1_wcel_empty (G: hyps) (A: class) (a: set): $ G ⇒ a = ∅ $ > $ G ⇒ A ∈ a $ > $ G ⇒ ⊥ $
----
l1: $ G , w = A , w ∊ a ⇒ w ∊ a $ by ax
l2: $ G , w = A , w ∊ a ⇒ a = ∅ $ by weaken [#1]
l3: $ G , w = A , w ∊ a ⇒ ⊥ $ by s1_mem_empty [l2, l1]
l4: $ G ⇒ ⊥ $ by wcel_elim [#2, l3]

fseq_empty
----------
l1: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u , ⟨ x , z ⟩ ∈ u ⇒ ⟨ x , y ⟩ ∈ u $ by ax
l2: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u , ⟨ x , z ⟩ ∈ u ⇒ u = ∅ $ by ax
l3: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u , ⟨ x , z ⟩ ∈ u ⇒ ⊥ $ by s1_wcel_empty [l2, l1]
l4: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u , ⟨ x , z ⟩ ∈ u ⇒ y = z $ by bot_elim [l3]
l5: $ G , u = ∅ ⇒ functional u $ by functional_intro [l4]
l6: $ G , u = ∅ , z ∊ u ⇒ z ∊ u $ by ax
l7: $ G , u = ∅ , z ∊ u ⇒ u = ∅ $ by ax
l8: $ G , u = ∅ , z ∊ u ⇒ ⊥ $ by s1_mem_empty [l7, l6]
l9: $ G , u = ∅ , z ∊ u ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by bot_elim [l8]
l10: $ G , u = ∅ ⇒ rel u $ by rel_intro [l9]
l11: $ G , u = ∅ , x ∊ cdm u ⇒ x ∊ cdm u $ by ax
l12: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u ⇒ ⟨ x , y ⟩ ∈ u $ by ax
l13: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u ⇒ u = ∅ $ by ax
l14: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u ⇒ ⊥ $ by s1_wcel_empty [l13, l12]
l15: $ G , u = ∅ , x ∊ cdm u ⇒ ⊥ $ by cdm_elim [l11, l14]
l16: $ G , u = ∅ ⇒ cdm u = ∅ $ by empty_eq_intro [l15]
l17: $ G , u = ∅ ⇒ ∅ = cdm u $ by eq_sym [l16]
l18: $ G , u = ∅ ⇒ ∅ ∈ ω $ by omega_zero
l19: $ G , u = ∅ ⇒ cdm u ∈ ω $ by wcel_eq_l [l17, l18]
l20: $ G , u = ∅ , y ∊ crn u ⇒ y ∊ crn u $ by ax
l21: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u ⇒ y ∊ A $ by bot_elim [l14]
l22: $ G , u = ∅ , y ∊ crn u ⇒ y ∊ A $ by crn_elim [l20, l21]
l23: $ G , u = ∅ ⇒ crn u ⊆ A $ by subset_intro [l22]
l24: $ G , u = ∅ ⇒ u ∊ fseq A $ by fseq_of_fn [l5, l10, l19, l23]
l25: $ G , u = ∅ ⇒ u = ∅ $ by ax
l26: $ G , u = ∅ ⇒ ∅ ∈ fseq A $ by wcel_intro [l25, l24]
l27: $ G ⇒ isset ∅ $ by ax_empty
l28: $ G ⇒ ∅ ∈ fseq A $ by isset_elim [l27, l26]

fseq_len_zero
-------------
l1: $ G , u ∊ s ⇒ u ∊ s $ by ax
l3: $ G , u ∊ s ⇒ s ∊ fseq A $ by weaken [#1]
l2: $ G , u ∊ s ⇒ rel s $ by fseq_rel [l3]
l4: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ u = ⟨ v , w ⟩ $ by ax
l5: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ u ∊ s $ by ax
l6: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ ⟨ v , w ⟩ ∈ s $ by wcel_intro [l4, l5]
l7: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ v ∊ cdm s $ by cdm_intro [l6]
l8: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ cdm s = ∅ $ by weaken [#2]
l9: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ v ∊ ∅ $ by welc_eq [l8, l7]
