u6: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ cdm b = c $ by eq_sym [u1]
u7: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ cdm b = j $ by eq_trans [u6, u5]
u8: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) $ by ax
u9: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ b ∊ fseq A → cdm b = j → b ∊ P $ by all_elim (t := $ b $) [u8]
u10: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ b ∊ fseq A $ by weaken [t4]
u11: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ cdm b = j → b ∊ P $ by imp_elim [u9, u10]
u12: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ b ∊ P $ by imp_elim [u11, u7]
u13: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ ∀ x ∀ y (x ∊ A → y ∊ fseq A → y ∊ P → scons x y ∈ P) $ by weaken [#2]
u14: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ ∀ y (a ∊ A → y ∊ fseq A → y ∊ P → scons a y ∈ P) $ by all_elim (t := $ a $) [u13]
u15: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ a ∊ A → b ∊ fseq A → b ∊ P → scons a b ∈ P $ by all_elim (t := $ b $) [u14]
u16: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ a ∊ A $ by weaken [t2]
u17: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ b ∊ fseq A → b ∊ P → scons a b ∈ P $ by imp_elim [u15, u16]
u18: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ b ∊ P → scons a b ∈ P $ by imp_elim [u17, u10]
u19: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ scons a b ∈ P $ by imp_elim [u18, u12]
u20: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ v = scons a b $ by weaken [t5]
u21: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ scons a b = v $ by eq_sym [u20]
u22: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ v ∈ P $ by wcel_eq_l [u21, u19]
u23: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b , c = cdm b , c ∊ ω ⇒ v ∊ P $ by wcel_welc [u22]
t15: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , a ∊ A ∧ b ∊ fseq A ∧ v = scons a b ⇒ v ∊ P $ by wcel_elim [t14, u23]
w1: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , ∃ b (a ∊ A ∧ b ∊ fseq A ∧ v = scons a b) ⇒ ∃ b (a ∊ A ∧ b ∊ fseq A ∧ v = scons a b) $ by ax
w2: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , ∃ b (a ∊ A ∧ b ∊ fseq A ∧ v = scons a b) ⇒ v ∊ P $ by ex_elim [w1, t15]
w3: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , ∃ a ∃ b (a ∊ A ∧ b ∊ fseq A ∧ v = scons a b) ⇒ ∃ a ∃ b (a ∊ A ∧ b ∊ fseq A ∧ v = scons a b) $ by ax
w4: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w , ∃ a ∃ b (a ∊ A ∧ b ∊ fseq A ∧ v = scons a b) ⇒ v ∊ P $ by ex_elim [w3, w2]
w5: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A , cdm v = w ⇒ v ∊ P $ by or_elim [s2, s7, w4]
w6: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j , v ∊ fseq A ⇒ cdm v = w → v ∊ P $ by imp_intro [w5]
w7: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j ⇒ v ∊ fseq A → cdm v = w → v ∊ P $ by imp_intro [w6]
w8: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j ⇒ ∀ v (v ∊ fseq A → cdm v = w → v ∊ P) $ by all_intro [w7]
w9: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j ⇒ w ∊ {k | ∀ v (v ∊ fseq A → cdm v = k → v ∊ P)} $ by cab_intro (x := $ k $, t := $ w $, p := $ ∀ v (v ∊ fseq A → cdm v = k → v ∊ P) $) [w8]
w10: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j ⇒ w = suc j $ by ax
w11: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) , w = suc j ⇒ suc j ∈ {k | ∀ v (v ∊ fseq A → cdm v = k → v ∊ P)} $ by wcel_intro [w10, w9]
w12: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) ⇒ isset j $ by isset_var
w13: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) ⇒ isset (suc j) $ by suc_set [w12]
w14: $ G , j ∊ ω , ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) ⇒ suc j ∈ {k | ∀ v (v ∊ fseq A → cdm v = k → v ∊ P)} $ by isset_elim [w13, w11]
w15: $ G , j ∊ ω ⇒ ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) → suc j ∈ {k | ∀ v (v ∊ fseq A → cdm v = k → v ∊ P)} $ by imp_intro [w14]
w16: $ G ⇒ j ∊ ω → ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) → suc j ∈ {k | ∀ v (v ∊ fseq A → cdm v = k → v ∊ P)} $ by imp_intro [w15]
w17: $ G ⇒ ∀ j (j ∊ ω → ∀ v (v ∊ fseq A → cdm v = j → v ∊ P) → suc j ∈ {k | ∀ v (v ∊ fseq A → cdm v = k → v ∊ P)}) $ by all_intro [w16]
f1: $ G ⇒ ∀ k (k ∊ ω → ∀ v (v ∊ fseq A → cdm v = k → v ∊ P)) $ by omega_ind_f [b17, w17]
f2: $ G , v ∊ fseq A ⇒ v ∊ fseq A $ by ax
f3: $ G , v ∊ fseq A ⇒ cdm v ∈ ω $ by fseq_len [f2]
g1: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ ∀ k (k ∊ ω → ∀ v (v ∊ fseq A → cdm v = k → v ∊ P)) $ by weaken [f1]
g2: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ c ∊ ω → ∀ v (v ∊ fseq A → cdm v = c → v ∊ P) $ by all_elim (t := $ c $) [g1]
g3: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ c ∊ ω $ by ax
g4: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ ∀ v (v ∊ fseq A → cdm v = c → v ∊ P) $ by imp_elim [g2, g3]
g5: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ v ∊ fseq A → cdm v = c → v ∊ P $ by all_elim (t := $ v $) [g4]
g6: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ v ∊ fseq A $ by ax
g7: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ cdm v = c → v ∊ P $ by imp_elim [g5, g6]
g8: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ c = cdm v $ by ax
g9: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ cdm v = c $ by eq_sym [g8]
g10: $ G , v ∊ fseq A , c = cdm v , c ∊ ω ⇒ v ∊ P $ by imp_elim [g7, g9]
g11: $ G , v ∊ fseq A ⇒ v ∊ P $ by wcel_elim [f3, g10]
g12: $ G ⇒ fseq A ⊆ P $ by subset_intro [g11]

lemma s2_ssnoc_eq (G: hyps) (S N A: class): $ G ⇒ cdm S = N $ > $ G ⇒ ssnoc S A = S ∪ csn ⟨ N , A ⟩ $
----
l1: $ G ⇒ A = A $ by eq_refl
l2: $ G ⇒ ⟨ cdm S , A ⟩ = ⟨ N , A ⟩ $ by opair_eq [#1, l1]
l3: $ G ⇒ csn ⟨ cdm S , A ⟩ = csn ⟨ N , A ⟩ $ by csn_eq [l2]
l4: $ G ⇒ S = S $ by eq_refl
l5: $ G ⇒ ssnoc S A = S ∪ csn ⟨ N , A ⟩ $ by cun_eq [l4, l3]

lemma s2_ssnoc_cdm (G: hyps) (s a k: set): $ G ⇒ cdm s = k $ > $ G ⇒ cdm (s ∪ csn ⟨ k , a ⟩) = suc k $
----
l1: $ G ⇒ cdm (s ∪ csn ⟨ k , a ⟩) = cdm s ∪ csn k $ by cdm_cun_csn
l2: $ G ⇒ csn k = csn k $ by eq_refl
l3: $ G ⇒ cdm s ∪ csn k = suc k $ by cun_eq [#1, l2]
l4: $ G ⇒ cdm (s ∪ csn ⟨ k , a ⟩) = suc k $ by eq_trans [l1, l3]

ssnoc_fseq
----------
l1: $ G ⇒ cdm s ∈ ω $ by fseq_len [#1]
c1: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
c2: $ G , k = cdm s , k ∊ ω ⇒ k ∊ ω $ by ax
c3: $ G , k = cdm s , k ∊ ω ⇒ cdm s = k $ by eq_sym [c1]
c4: $ G , k = cdm s , k ∊ ω ⇒ ssnoc s a = s ∪ csn ⟨ k , a ⟩ $ by s2_ssnoc_eq [c3]
c5: $ G , k = cdm s , k ∊ ω ⇒ s ∊ fseq A $ by weaken [#1]
c6: $ G , k = cdm s , k ∊ ω ⇒ functional s $ by fseq_functional [c5]
c7: $ G , k = cdm s , k ∊ ω ⇒ rel s $ by fseq_rel [c5]
d1: $ G , k = cdm s , k ∊ ω , k ∊ cdm s ⇒ k ∊ cdm s $ by ax
d2: $ G , k = cdm s , k ∊ ω , k ∊ cdm s ⇒ cdm s = k $ by weaken [c3]
d3: $ G , k = cdm s , k ∊ ω , k ∊ cdm s ⇒ k ∊ k $ by welc_eq [d2, d1]
d4: $ G , k = cdm s , k ∊ ω , k ∊ cdm s ⇒ ⊥ $ by notin_self [d3]
d5: $ G , k = cdm s , k ∊ ω ⇒ ¬ k ∊ cdm s $ by not_intro [d4]
c8: $ G , k = cdm s , k ∊ ω ⇒ functional (s ∪ csn ⟨ k , a ⟩) $ by functional_cun_csn [c6, d5]
c9: $ G , k = cdm s , k ∊ ω ⇒ rel (s ∪ csn ⟨ k , a ⟩) $ by rel_cun_csn [c7]
c10: $ G , k = cdm s , k ∊ ω ⇒ cdm (s ∪ csn ⟨ k , a ⟩) = suc k $ by s2_ssnoc_cdm [c3]
c11: $ G , k = cdm s , k ∊ ω ⇒ suc k ∈ ω $ by omega_suc [c2]
c12: $ G , k = cdm s , k ∊ ω ⇒ suc k = cdm (s ∪ csn ⟨ k , a ⟩) $ by eq_sym [c10]
c13: $ G , k = cdm s , k ∊ ω ⇒ cdm (s ∪ csn ⟨ k , a ⟩) ∈ ω $ by wcel_eq_l [c12, c11]
e1: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ ⇒ ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ $ by ax
e2: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ ⇒ ⟨ x , y ⟩ ∈ s ∨ (x = k ∧ y = a) $ by cun_csn_opair_elim [e1]
e3: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
e4: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , ⟨ x , y ⟩ ∈ s ⇒ y ∊ crn s $ by crn_intro [e3]
e5: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , ⟨ x , y ⟩ ∈ s ⇒ s ∊ fseq A $ by weaken [#1]
e6: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , ⟨ x , y ⟩ ∈ s ⇒ crn s ⊆ A $ by fseq_crn [e5]
e7: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , ⟨ x , y ⟩ ∈ s ⇒ y ∊ A $ by subset_elim [e6, e4]
e8: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , x = k ∧ y = a ⇒ x = k ∧ y = a $ by ax
e9: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , x = k ∧ y = a ⇒ y = a $ by and_elim_r [e8]
e10: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , x = k ∧ y = a ⇒ a = y $ by eq_sym [e9]
e11: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , x = k ∧ y = a ⇒ a ∊ A $ by weaken [#2]
e12: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ , x = k ∧ y = a ⇒ y ∊ A $ by welc_eq_set [e10, e11]
e13: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) , ⟨ x , y ⟩ ∈ s ∪ csn ⟨ k , a ⟩ ⇒ y ∊ A $ by or_elim [e2, e7, e12]
e14: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) ⇒ y ∊ crn (s ∪ csn ⟨ k , a ⟩) $ by ax
e15: $ G , k = cdm s , k ∊ ω , y ∊ crn (s ∪ csn ⟨ k , a ⟩) ⇒ y ∊ A $ by crn_elim [e14, e13]
e16: $ G , k = cdm s , k ∊ ω ⇒ crn (s ∪ csn ⟨ k , a ⟩) ⊆ A $ by subset_intro [e15]
f1: $ G , k = cdm s , k ∊ ω ⇒ s ∪ csn ⟨ k , a ⟩ ∈ fseq A $ by s2_fseq_c [c8, c9, c13, e16]
f2: $ G , k = cdm s , k ∊ ω ⇒ s ∪ csn ⟨ k , a ⟩ = ssnoc s a $ by eq_sym [c4]
f3: $ G , k = cdm s , k ∊ ω ⇒ ssnoc s a ∈ fseq A $ by wcel_eq_l [f2, f1]
f4: $ G ⇒ ssnoc s a ∈ fseq A $ by wcel_elim [l1, f3]

ssnoc_len
---------
l1: $ G ⇒ cdm s ∈ ω $ by fseq_len [#1]
c1: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
c3: $ G , k = cdm s , k ∊ ω ⇒ cdm s = k $ by eq_sym [c1]
c4: $ G , k = cdm s , k ∊ ω ⇒ ssnoc s a = s ∪ csn ⟨ k , a ⟩ $ by s2_ssnoc_eq [c3]
c5: $ G , k = cdm s , k ∊ ω ⇒ cdm (ssnoc s a) = cdm (s ∪ csn ⟨ k , a ⟩) $ by cdm_eq [c4]
c6: $ G , k = cdm s , k ∊ ω ⇒ cdm (s ∪ csn ⟨ k , a ⟩) = suc k $ by s2_ssnoc_cdm [c3]
c7: $ G , k = cdm s , k ∊ ω ⇒ suc k = suc (cdm s) $ by suc_eq [c1]
c8: $ G , k = cdm s , k ∊ ω ⇒ cdm (ssnoc s a) = suc k $ by eq_trans [c5, c6]
c9: $ G , k = cdm s , k ∊ ω ⇒ cdm (ssnoc s a) = suc (cdm s) $ by eq_trans [c8, c7]
c10: $ G ⇒ cdm (ssnoc s a) = suc (cdm s) $ by wcel_elim [l1, c9]

ssnoc_fv_last
-------------
l1: $ G ⇒ cdm s ∈ ω $ by fseq_len [#1]
c1: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
c3: $ G , k = cdm s , k ∊ ω ⇒ cdm s = k $ by eq_sym [c1]
c4: $ G , k = cdm s , k ∊ ω ⇒ ssnoc s a = s ∪ csn ⟨ k , a ⟩ $ by s2_ssnoc_eq [c3]
c5: $ G , k = cdm s , k ∊ ω ⇒ fv (ssnoc s a) (cdm s) = fv (s ∪ csn ⟨ k , a ⟩) k $ by fv_eq [c4, c3]
c8: $ G , k = cdm s , k ∊ ω ⇒ fv (s ∪ csn ⟨ k , a ⟩) k = a $ by fv_cun_csn_self [c3]
c9: $ G , k = cdm s , k ∊ ω ⇒ fv (ssnoc s a) (cdm s) = a $ by eq_trans [c5, c8]
c10: $ G ⇒ fv (ssnoc s a) (cdm s) = a $ by wcel_elim [l1, c9]

ssnoc_fv_lt
-----------
l1: $ G ⇒ cdm s ∈ ω $ by fseq_len [#1]
c1: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
c3: $ G , k = cdm s , k ∊ ω ⇒ cdm s = k $ by eq_sym [c1]
c4: $ G , k = cdm s , k ∊ ω ⇒ ssnoc s a = s ∪ csn ⟨ k , a ⟩ $ by s2_ssnoc_eq [c3]
c5: $ G , k = cdm s , k ∊ ω ⇒ i = i $ by eq_refl
c6: $ G , k = cdm s , k ∊ ω ⇒ fv (ssnoc s a) i = fv (s ∪ csn ⟨ k , a ⟩) i $ by fv_eq [c4, c5]
d1: $ G , k = cdm s , k ∊ ω , i = k ⇒ i = k $ by ax
d2: $ G , k = cdm s , k ∊ ω , i = k ⇒ i ∊ cdm s $ by weaken [#2]
d3: $ G , k = cdm s , k ∊ ω , i = k ⇒ cdm s = k $ by weaken [c3]
d4: $ G , k = cdm s , k ∊ ω , i = k ⇒ i ∊ k $ by welc_eq [d3, d2]
d5: $ G , k = cdm s , k ∊ ω , i = k ⇒ k ∊ k $ by welc_eq_set [d1, d4]
d6: $ G , k = cdm s , k ∊ ω , i = k ⇒ ⊥ $ by notin_self [d5]
d7: $ G , k = cdm s , k ∊ ω ⇒ i = k → ⊥ $ by imp_intro [d6]
d8: $ G , k = cdm s , k ∊ ω ⇒ isset i $ by isset_var
c7: $ G , k = cdm s , k ∊ ω ⇒ fv (s ∪ csn ⟨ k , a ⟩) i = fv s i $ by fv_cun_csn_other [d8, d7]
c8: $ G , k = cdm s , k ∊ ω ⇒ fv (ssnoc s a) i = fv s i $ by eq_trans [c6, c7]
c9: $ G ⇒ fv (ssnoc s a) i = fv s i $ by wcel_elim [l1, c8]

def s2_sh (T N: class) (.i .y .z: set): class = $ {z | ∃ i ∃ y (z = ⟨ nadd N i , y ⟩ ∧ ⟨ i , y ⟩ ∈ T)} $

lemma s2_sh_intro (G: hyps) (T N I: class) (y z: set):
  $ G ⇒ z = ⟨ nadd N I , y ⟩ $ > $ G ⇒ ⟨ I , y ⟩ ∈ T $ > $ G ⇒ isset I $ > $ G ⇒ z ∊ s2_sh T N $
----
l1: $ G , u = I ⇒ u = I $ by ax
l2: $ G , u = I ⇒ I = u $ by eq_sym [l1]
l3: $ G , u = I ⇒ N = N $ by eq_refl
l4: $ G , u = I ⇒ nadd N I = nadd N u $ by nadd_eq [l3, l2]
l5: $ G , u = I ⇒ y = y $ by eq_refl
l6: $ G , u = I ⇒ ⟨ nadd N I , y ⟩ = ⟨ nadd N u , y ⟩ $ by opair_eq [l4, l5]
l7: $ G , u = I ⇒ z = ⟨ nadd N I , y ⟩ $ by weaken [#1]
l8: $ G , u = I ⇒ z = ⟨ nadd N u , y ⟩ $ by eq_trans [l7, l6]
l9: $ G , u = I ⇒ ⟨ I , y ⟩ = ⟨ u , y ⟩ $ by opair_eq [l2, l5]
l10: $ G , u = I ⇒ ⟨ I , y ⟩ ∈ T $ by weaken [#2]
l11: $ G , u = I ⇒ ⟨ u , y ⟩ ∈ T $ by wcel_eq_l [l9, l10]
l12: $ G , u = I ⇒ z = ⟨ nadd N u , y ⟩ ∧ ⟨ u , y ⟩ ∈ T $ by and_intro [l8, l11]
l13: $ G , u = I ⇒ ∃ k (z = ⟨ nadd N u , k ⟩ ∧ ⟨ u , k ⟩ ∈ T) $ by ex_intro (x := $ k $, t := $ y $, p := $ z = ⟨ nadd N u , k ⟩ ∧ ⟨ u , k ⟩ ∈ T $) [l12]
l14: $ G , u = I ⇒ ∃ j ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $ by ex_intro (x := $ j $, t := $ u $, p := $ ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $) [l13]
l15: $ G , u = I ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T)} $ by cab_intro (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $) [l14]
l16: $ G , u = I ⇒ z ∊ s2_sh T N $ by weaken [l15]
l17: $ G ⇒ z ∊ s2_sh T N $ by isset_elim [#3, l16]

lemma s2_sh_intro_p (G: hyps) (T N I: class) (x y: set):
  $ G ⇒ x = nadd N I $ > $ G ⇒ ⟨ I , y ⟩ ∈ T $ > $ G ⇒ isset I $ > $ G ⇒ ⟨ x , y ⟩ ∈ s2_sh T N $
----
l1: $ G ⇒ isset x $ by isset_var
l2: $ G ⇒ isset y $ by isset_var
l3: $ G ⇒ isset ⟨ x , y ⟩ $ by opair_set [l1, l2]
l4: $ G , z = ⟨ x , y ⟩ ⇒ z = ⟨ x , y ⟩ $ by ax
l5: $ G , z = ⟨ x , y ⟩ ⇒ x = nadd N I $ by weaken [#1]
l6: $ G , z = ⟨ x , y ⟩ ⇒ y = y $ by eq_refl
l7: $ G , z = ⟨ x , y ⟩ ⇒ ⟨ x , y ⟩ = ⟨ nadd N I , y ⟩ $ by opair_eq [l5, l6]
l8: $ G , z = ⟨ x , y ⟩ ⇒ z = ⟨ nadd N I , y ⟩ $ by eq_trans [l4, l7]
l9: $ G , z = ⟨ x , y ⟩ ⇒ ⟨ I , y ⟩ ∈ T $ by weaken [#2]
l10: $ G , z = ⟨ x , y ⟩ ⇒ isset I $ by weaken [#3]
l11: $ G , z = ⟨ x , y ⟩ ⇒ z ∊ s2_sh T N $ by s2_sh_intro [l8, l9, l10]
l12: $ G , z = ⟨ x , y ⟩ ⇒ ⟨ x , y ⟩ ∈ s2_sh T N $ by wcel_intro [l4, l11]
l13: $ G ⇒ ⟨ x , y ⟩ ∈ s2_sh T N $ by isset_elim [l3, l12]

lemma s2_sh_intro_c (G: hyps) (T N I Y: class):
  $ G ⇒ ⟨ I , Y ⟩ ∈ T $ > $ G ⇒ isset I $ > $ G ⇒ isset Y $ > $ G ⇒ isset N $ >
  $ G ⇒ ⟨ nadd N I , Y ⟩ ∈ s2_sh T N $
----
l1: $ G , y = Y ⇒ y = Y $ by ax
l2: $ G , y = Y ⇒ Y = y $ by eq_sym [l1]
l3: $ G , y = Y ⇒ I = I $ by eq_refl
l4: $ G , y = Y ⇒ ⟨ I , Y ⟩ = ⟨ I , y ⟩ $ by opair_eq [l3, l2]
l5: $ G , y = Y ⇒ ⟨ I , Y ⟩ ∈ T $ by weaken [#1]
l6: $ G , y = Y ⇒ ⟨ I , y ⟩ ∈ T $ by wcel_eq_l [l4, l5]
l7: $ G , y = Y ⇒ isset N $ by weaken [#4]
l8: $ G , y = Y ⇒ isset I $ by weaken [#2]
l9: $ G , y = Y ⇒ isset (nadd N I) $ by nadd_set_c [l7, l8]
m1: $ G , y = Y , g = nadd N I ⇒ g = nadd N I $ by ax
m2: $ G , y = Y , g = nadd N I ⇒ ⟨ I , y ⟩ ∈ T $ by weaken [l6]
m3: $ G , y = Y , g = nadd N I ⇒ isset I $ by weaken [#2]
m4: $ G , y = Y , g = nadd N I ⇒ ⟨ g , y ⟩ ∈ s2_sh T N $ by s2_sh_intro_p [m1, m2, m3]
m5: $ G , y = Y , g = nadd N I ⇒ y = Y $ by ax
m6: $ G , y = Y , g = nadd N I ⇒ ⟨ g , y ⟩ = ⟨ nadd N I , Y ⟩ $ by opair_eq [m1, m5]
m7: $ G , y = Y , g = nadd N I ⇒ ⟨ nadd N I , Y ⟩ ∈ s2_sh T N $ by wcel_eq_l [m6, m4]
m8: $ G , y = Y ⇒ ⟨ nadd N I , Y ⟩ ∈ s2_sh T N $ by isset_elim [l9, m7]
m9: $ G ⇒ ⟨ nadd N I , Y ⟩ ∈ s2_sh T N $ by isset_elim [#3, m8]

lemma s2_sh_elim (G: hyps) {i: set} (T N: class) (x y: set):
  $ G ⇒ ⟨ x , y ⟩ ∈ s2_sh T N $ > $ G ⇒ isset N $ > $ G ⇒ ∃ i (x = nadd N i ∧ ⟨ i , y ⟩ ∈ T) $
----
l1: $ G , z = ⟨ x , y ⟩ , z ∊ s2_sh T N ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T)} $ by ax
l2: $ G , z = ⟨ x , y ⟩ , z ∊ s2_sh T N ⇒ ∃ j ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $ by cab_elim (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $) [l1]
c1: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T $ by ax
c2: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z = ⟨ nadd N j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ⟨ j , k ⟩ ∈ T $ by and_elim_r [c1]
c4: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z = ⟨ x , y ⟩ $ by ax
c5: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ⟨ x , y ⟩ = z $ by eq_sym [c4]
c6: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ⟨ x , y ⟩ = ⟨ nadd N j , k ⟩ $ by eq_trans [c5, c2]
c7: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset x $ by isset_var
c8: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset y $ by isset_var
c9: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset N $ by weaken [#2]
c10: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset j $ by isset_var
c11: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset (nadd N j) $ by nadd_set_c [c9, c10]
c12: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset k $ by isset_var
c13: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ x = nadd N j ∧ y = k $ by opair_inj_c [c6, c7, c8, c11, c12]
c14: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ x = nadd N j $ by and_elim_l [c13]
c15: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ y = k $ by and_elim_r [c13]
c16: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ k = y $ by eq_sym [c15]
c17: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ j = j $ by eq_refl
c18: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ⟨ j , k ⟩ = ⟨ j , y ⟩ $ by opair_eq [c17, c16]
c19: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ⟨ j , y ⟩ ∈ T $ by wcel_eq_l [c18, c3]
c20: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ x = nadd N j ∧ ⟨ j , y ⟩ ∈ T $ by and_intro [c14, c19]
c21: $ G , z = ⟨ x , y ⟩ , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ∃ i (x = nadd N i ∧ ⟨ i , y ⟩ ∈ T) $ by ex_intro (x := $ i $, t := $ j $, p := $ x = nadd N i ∧ ⟨ i , y ⟩ ∈ T $) [c20]
d1: $ G , z = ⟨ x , y ⟩ , ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) ⇒ ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $ by ax
d2: $ G , z = ⟨ x , y ⟩ , ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) ⇒ ∃ i (x = nadd N i ∧ ⟨ i , y ⟩ ∈ T) $ by ex_elim [d1, c21]
d3: $ G , z = ⟨ x , y ⟩ , z ∊ s2_sh T N ⇒ ∃ i (x = nadd N i ∧ ⟨ i , y ⟩ ∈ T) $ by ex_elim [l2, d2]
d4: $ G ⇒ ∃ i (x = nadd N i ∧ ⟨ i , y ⟩ ∈ T) $ by wcel_elim [#1, d3]

lemma s2_sh_sub (G: hyps) (T N M: class) (z: set):
  $ G ⇒ N = M $ > $ G ⇒ z ∊ s2_sh T N $ > $ G ⇒ z ∊ s2_sh T M $
----
l1: $ G ⇒ ∃ j ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $ by cab_elim (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $) [#2]
c1: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T $ by ax
c2: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z = ⟨ nadd N j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ⟨ j , k ⟩ ∈ T $ by and_elim_r [c1]
c4: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ N = M $ by weaken [#1]
c5: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ j = j $ by eq_refl
c6: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ nadd N j = nadd M j $ by nadd_eq [c4, c5]
c7: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ k = k $ by eq_refl
c8: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ⟨ nadd N j , k ⟩ = ⟨ nadd M j , k ⟩ $ by opair_eq [c6, c7]
c9: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z = ⟨ nadd M j , k ⟩ $ by eq_trans [c2, c8]
c10: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset j $ by isset_var
c11: $ G , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z ∊ s2_sh T M $ by s2_sh_intro [c9, c3, c10]
d1: $ G , ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) ⇒ ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $ by ax
d2: $ G , ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) ⇒ z ∊ s2_sh T M $ by ex_elim [d1, c11]
d3: $ G ⇒ z ∊ s2_sh T M $ by ex_elim [l1, d2]

lemma s2_sh_eq (G: hyps) (T N M: class): $ G ⇒ N = M $ > $ G ⇒ s2_sh T N = s2_sh T M $
----
l1: $ G , z ∊ s2_sh T N ⇒ N = M $ by weaken [#1]
l2: $ G , z ∊ s2_sh T N ⇒ z ∊ s2_sh T N $ by ax
l3: $ G , z ∊ s2_sh T N ⇒ z ∊ s2_sh T M $ by s2_sh_sub [l1, l2]
l4: $ G ⇒ M = N $ by eq_sym [#1]
l5: $ G , z ∊ s2_sh T M ⇒ M = N $ by weaken [l4]
l6: $ G , z ∊ s2_sh T M ⇒ z ∊ s2_sh T M $ by ax
l7: $ G , z ∊ s2_sh T M ⇒ z ∊ s2_sh T N $ by s2_sh_sub [l5, l6]
l8: $ G ⇒ s2_sh T N = s2_sh T M $ by eq_intro [l3, l7]

lemma s2_scat_eq (G: hyps) (S T N: class): $ G ⇒ cdm S = N $ > $ G ⇒ scat S T = S ∪ s2_sh T N $
----
l1: $ G ⇒ s2_sh T (cdm S) = s2_sh T N $ by s2_sh_eq [#1]
l2: $ G ⇒ S = S $ by eq_refl
l3: $ G ⇒ scat S T = S ∪ s2_sh T N $ by cun_eq [l2, l1]

lemma s2_sh_rel (G: hyps) (T N: class): $ G ⇒ isset N $ > $ G ⇒ rel (s2_sh T N) $
----
l1: $ G , z ∊ s2_sh T N ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T)} $ by ax
l2: $ G , z ∊ s2_sh T N ⇒ ∃ j ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $ by cab_elim (x := $ w $, t := $ z $, p := $ ∃ j ∃ k (w = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $) [l1]
c1: $ G , z ∊ s2_sh T N , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T $ by ax
c2: $ G , z ∊ s2_sh T N , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ z = ⟨ nadd N j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z ∊ s2_sh T N , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset N $ by weaken [#1]
c4: $ G , z ∊ s2_sh T N , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset j $ by isset_var
c5: $ G , z ∊ s2_sh T N , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset (nadd N j) $ by nadd_set_c [c3, c4]
c6: $ G , z ∊ s2_sh T N , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ isset k $ by isset_var
c7: $ G , z ∊ s2_sh T N , z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by s2_opair_ex [c2, c5, c6]
d1: $ G , z ∊ s2_sh T N , ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) ⇒ ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) $ by ax
d2: $ G , z ∊ s2_sh T N , ∃ k (z = ⟨ nadd N j , k ⟩ ∧ ⟨ j , k ⟩ ∈ T) ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [d1, c7]
d3: $ G , z ∊ s2_sh T N ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [l2, d2]
d4: $ G ⇒ rel (s2_sh T N) $ by rel_intro [d3]

lemma s2_rel_cun (G: hyps) (A B: class): $ G ⇒ rel A $ > $ G ⇒ rel B $ > $ G ⇒ rel (A ∪ B) $
----
l1: $ G , z ∊ A ∪ B ⇒ z ∊ A ∪ B $ by ax
l2: $ G , z ∊ A ∪ B ⇒ z ∊ A ∨ z ∊ B $ by cun_elim [l1]
l3: $ G , z ∊ A ∪ B , z ∊ A ⇒ rel A $ by weaken [#1]
l4: $ G , z ∊ A ∪ B , z ∊ A ⇒ z ∊ A → ∃ x ∃ y (z = ⟨ x , y ⟩) $ by all_elim (t := $ z $) [l3]
l5: $ G , z ∊ A ∪ B , z ∊ A ⇒ z ∊ A $ by ax
l6: $ G , z ∊ A ∪ B , z ∊ A ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by imp_elim [l4, l5]
l7: $ G , z ∊ A ∪ B , z ∊ B ⇒ rel B $ by weaken [#2]
l8: $ G , z ∊ A ∪ B , z ∊ B ⇒ z ∊ B → ∃ x ∃ y (z = ⟨ x , y ⟩) $ by all_elim (t := $ z $) [l7]
l9: $ G , z ∊ A ∪ B , z ∊ B ⇒ z ∊ B $ by ax
l10: $ G , z ∊ A ∪ B , z ∊ B ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by imp_elim [l8, l9]
l11: $ G , z ∊ A ∪ B ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by or_elim [l2, l6, l10]
l12: $ G ⇒ rel (A ∪ B) $ by rel_intro [l11]

lemma s2_cun_elim_w (G: hyps) (X A B: class): $ G ⇒ X ∈ A ∪ B $ > $ G ⇒ X ∈ A ∨ X ∈ B $
----
l1: $ G , z = X , z ∊ A ∪ B ⇒ z ∊ A ∪ B $ by ax
l2: $ G , z = X , z ∊ A ∪ B ⇒ z ∊ A ∨ z ∊ B $ by cun_elim [l1]
l3: $ G , z = X , z ∊ A ∪ B , z ∊ A ⇒ z = X $ by ax
l4: $ G , z = X , z ∊ A ∪ B , z ∊ A ⇒ z ∊ A $ by ax
l5: $ G , z = X , z ∊ A ∪ B , z ∊ A ⇒ X ∈ A $ by wcel_intro [l3, l4]
l6: $ G , z = X , z ∊ A ∪ B , z ∊ A ⇒ X ∈ A ∨ X ∈ B $ by or_intro_l [l5]
l7: $ G , z = X , z ∊ A ∪ B , z ∊ B ⇒ z = X $ by ax
l8: $ G , z = X , z ∊ A ∪ B , z ∊ B ⇒ z ∊ B $ by ax
l9: $ G , z = X , z ∊ A ∪ B , z ∊ B ⇒ X ∈ B $ by wcel_intro [l7, l8]
l10: $ G , z = X , z ∊ A ∪ B , z ∊ B ⇒ X ∈ A ∨ X ∈ B $ by or_intro_r [l9]
l11: $ G , z = X , z ∊ A ∪ B ⇒ X ∈ A ∨ X ∈ B $ by or_elim [l2, l6, l10]
l12: $ G ⇒ X ∈ A ∨ X ∈ B $ by wcel_elim [#1, l11]

lemma s2_nadd_notin (G: hyps) (k i x: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ i ∊ ω $ > $ G ⇒ x = nadd k i $ > $ G ⇒ x ∊ k $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ k ⊆ nadd k i $ by nadd_le_l [#1, #2]
l2: $ G ⇒ nadd k i = x $ by eq_sym [#3]
l3: $ G ⇒ k ⊆ x $ by subset_eq_r [l2, l1]
l4: $ G ⇒ x ∊ x $ by subset_elim [l3, #4]
l5: $ G ⇒ ⊥ $ by notin_self [l4]

lemma s2_scat_cdm (G: hyps) (s t k c: set):
  $ G ⇒ cdm s = k $ > $ G ⇒ k ∊ ω $ > $ G ⇒ cdm t = c $ > $ G ⇒ c ∊ ω $ >
  $ G ⇒ cdm (s ∪ s2_sh t k) = nadd k c $
----
a1: $ G , x ∊ cdm (s ∪ s2_sh t k) ⇒ x ∊ cdm (s ∪ s2_sh t k) $ by ax
a2: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k ⇒ ⟨ x , y ⟩ ∈ s ∪ s2_sh t k $ by ax
a3: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k ⇒ ⟨ x , y ⟩ ∈ s ∨ ⟨ x , y ⟩ ∈ s2_sh t k $ by s2_cun_elim_w [a2]
b1: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
b2: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s ⇒ x ∊ cdm s $ by cdm_intro [b1]
b3: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s ⇒ cdm s = k $ by weaken [#1]
b4: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s ⇒ x ∊ k $ by welc_eq [b3, b2]
b5: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s ⇒ k ∊ ω $ by weaken [#2]
b6: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s ⇒ c ∊ ω $ by weaken [#4]
b7: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s ⇒ k ⊆ nadd k c $ by nadd_le_l [b5, b6]
b8: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s ⇒ x ∊ nadd k c $ by subset_elim [b7, b4]
c1: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s2_sh t k ⇒ ⟨ x , y ⟩ ∈ s2_sh t k $ by ax
c2: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s2_sh t k ⇒ isset k $ by isset_var
c3: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s2_sh t k ⇒ ∃ i (x = nadd k i ∧ ⟨ i , y ⟩ ∈ t) $ by s2_sh_elim [c1, c2]
d1: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ x = nadd k i ∧ ⟨ i , y ⟩ ∈ t $ by ax
d2: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ x = nadd k i $ by and_elim_l [d1]
d3: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ ⟨ i , y ⟩ ∈ t $ by and_elim_r [d1]
d4: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ i ∊ cdm t $ by cdm_intro [d3]
d5: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ cdm t = c $ by weaken [#3]
d6: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ i ∊ c $ by welc_eq [d5, d4]
d7: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ c ∊ ω $ by weaken [#4]
d8: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ k ∊ ω $ by weaken [#2]
d9: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ i ∊ ω $ by omega_elem_omega [d7, d6]
d10: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ nadd i k ∈ nadd c k $ by nadd_mono_lt [d9, d7, d8, d6]
d11: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ nadd i k = nadd k i $ by nadd_comm [d9, d8]
d12: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ nadd c k = nadd k c $ by nadd_comm [d7, d8]
d13: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ nadd k i ∈ nadd c k $ by wcel_eq_l [d11, d10]
d14: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ nadd k i ∈ nadd k c $ by wcel_eq_r [d12, d13]
d15: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ nadd k i = x $ by eq_sym [d2]
d16: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ x ∈ nadd k c $ by wcel_eq_l [d15, d14]
d17: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , x = nadd k i ∧ ⟨ i , y ⟩ ∈ t ⇒ x ∊ nadd k c $ by wcel_welc [d16]
c4: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k , ⟨ x , y ⟩ ∈ s2_sh t k ⇒ x ∊ nadd k c $ by ex_elim [c3, d17]
a4: $ G , x ∊ cdm (s ∪ s2_sh t k) , ⟨ x , y ⟩ ∈ s ∪ s2_sh t k ⇒ x ∊ nadd k c $ by or_elim [a3, b8, c4]
a5: $ G , x ∊ cdm (s ∪ s2_sh t k) ⇒ x ∊ nadd k c $ by cdm_elim [a1, a4]
e1: $ G , x ∊ nadd k c ⇒ k ∊ ω $ by weaken [#2]
e2: $ G , x ∊ nadd k c ⇒ c ∊ ω $ by weaken [#4]
e3: $ G , x ∊ nadd k c ⇒ nadd k c ∈ ω $ by nadd_omega [e1, e2]
f1: $ G , x ∊ nadd k c , f = nadd k c , f ∊ ω ⇒ f = nadd k c $ by ax
f2: $ G , x ∊ nadd k c , f = nadd k c , f ∊ ω ⇒ nadd k c = f $ by eq_sym [f1]
f3: $ G , x ∊ nadd k c , f = nadd k c , f ∊ ω ⇒ x ∊ nadd k c $ by ax
f4: $ G , x ∊ nadd k c , f = nadd k c , f ∊ ω ⇒ x ∊ f $ by welc_eq [f2, f3]
f5: $ G , x ∊ nadd k c , f = nadd k c , f ∊ ω ⇒ f ∊ ω $ by ax
f6: $ G , x ∊ nadd k c , f = nadd k c , f ∊ ω ⇒ x ∊ ω $ by omega_elem_omega [f5, f4]
e4: $ G , x ∊ nadd k c ⇒ x ∊ ω $ by wcel_elim [e3, f6]
e5: $ G , x ∊ nadd k c ⇒ x ∊ k ∨ x = k ∨ k ∊ x $ by omega_tricho [e4, e1]
g1: $ G , x ∊ nadd k c , x ∊ k ⇒ x ∊ k $ by ax
g2: $ G , x ∊ nadd k c , x ∊ k ⇒ cdm s = k $ by weaken [#1]
g3: $ G , x ∊ nadd k c , x ∊ k ⇒ k = cdm s $ by eq_sym [g2]
g4: $ G , x ∊ nadd k c , x ∊ k ⇒ x ∊ cdm s $ by welc_eq [g3, g1]
g5: $ G , x ∊ nadd k c , x ∊ k , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
g6: $ G , x ∊ nadd k c , x ∊ k , ⟨ x , y ⟩ ∈ s ⇒ s ⊆ s ∪ s2_sh t k $ by cun_subset_l
g7: $ G , x ∊ nadd k c , x ∊ k , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s ∪ s2_sh t k $ by wcel_subset [g6, g5]
g8: $ G , x ∊ nadd k c , x ∊ k , ⟨ x , y ⟩ ∈ s ⇒ x ∊ cdm (s ∪ s2_sh t k) $ by cdm_intro [g7]
g9: $ G , x ∊ nadd k c , x ∊ k ⇒ x ∊ cdm (s ∪ s2_sh t k) $ by cdm_elim [g4, g8]
h1: $ G , x ∊ nadd k c , x = k ∨ k ∊ x ⇒ x = k ∨ k ∊ x $ by ax
h2: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , x = k ⇒ x = k $ by ax
h3: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , x = k ⇒ k = x $ by eq_sym [h2]
h4: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , x = k ⇒ k ⊆ x $ by eq_subset [h3]
h5: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , k ∊ x ⇒ x ∊ ω $ by weaken [e4]
h6: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , k ∊ x ⇒ transitive x $ by omega_elem_trans [h5]
h7: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , k ∊ x ⇒ k ∊ x $ by ax
h8: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , k ∊ x ⇒ k ⊆ x $ by transitive_subset [h6, h7]
h9: $ G , x ∊ nadd k c , x = k ∨ k ∊ x ⇒ k ⊆ x $ by or_elim [h1, h4, h8]
h10: $ G , x ∊ nadd k c , x = k ∨ k ∊ x ⇒ k ∊ ω $ by weaken [#2]
h11: $ G , x ∊ nadd k c , x = k ∨ k ∊ x ⇒ x ∊ ω $ by weaken [e4]
h12: $ G , x ∊ nadd k c , x = k ∨ k ∊ x ⇒ ∃ g (g ∊ ω ∧ nadd k g = x) $ by nle_ex [h10, h11, h9]
k1: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ g ∊ ω ∧ nadd k g = x $ by ax
k2: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ g ∊ ω $ by and_elim_l [k1]
k3: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ nadd k g = x $ by and_elim_r [k1]
k4: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ x ∊ nadd k c $ by ax
k5: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ x ∈ nadd k c $ by welc_wcel [k4]
k6: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ x = nadd k g $ by eq_sym [k3]
k7: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ nadd k g ∈ nadd k c $ by wcel_eq_l [k6, k5]
k8: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ k ∊ ω $ by weaken [#2]
k9: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ c ∊ ω $ by weaken [#4]
k10: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ nadd k g = nadd g k $ by nadd_comm [k8, k2]
k11: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ nadd k c = nadd c k $ by nadd_comm [k8, k9]
k12: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ nadd g k ∈ nadd k c $ by wcel_eq_l [k10, k7]
k13: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ nadd g k ∈ nadd c k $ by wcel_eq_r [k11, k12]
k14: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ g ∊ c $ by nadd_lt_cancel [k2, k9, k8, k13]
k15: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ cdm t = c $ by weaken [#3]
k16: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ c = cdm t $ by eq_sym [k15]
k17: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ g ∊ cdm t $ by welc_eq [k16, k14]
m1: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ ⟨ g , y ⟩ ∈ t $ by ax
m2: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ g ∊ ω ∧ nadd k g = x $ by ax
m3: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ nadd k g = x $ by and_elim_r [m2]
m4: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ x = nadd k g $ by eq_sym [m3]
m5: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ isset g $ by isset_var
m6: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ ⟨ x , y ⟩ ∈ s2_sh t k $ by s2_sh_intro_p [m4, m1, m5]
m7: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ s2_sh t k ⊆ s ∪ s2_sh t k $ by cun_subset_r
m8: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ ⟨ x , y ⟩ ∈ s ∪ s2_sh t k $ by wcel_subset [m7, m6]
m9: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x , ⟨ g , y ⟩ ∈ t ⇒ x ∊ cdm (s ∪ s2_sh t k) $ by cdm_intro [m8]
k18: $ G , x ∊ nadd k c , x = k ∨ k ∊ x , g ∊ ω ∧ nadd k g = x ⇒ x ∊ cdm (s ∪ s2_sh t k) $ by cdm_elim [k17, m9]
k21: $ G , x ∊ nadd k c , x = k ∨ k ∊ x ⇒ x ∊ cdm (s ∪ s2_sh t k) $ by ex_elim [h12, k18]
e6: $ G , x ∊ nadd k c ⇒ x ∊ cdm (s ∪ s2_sh t k) $ by or_elim [e5, g9, k21]
e7: $ G ⇒ cdm (s ∪ s2_sh t k) = nadd k c $ by eq_intro [a5, e6]

lemma s2_scat_functional (G: hyps) (A: class) (s t k: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ cdm s = k $ > $ G ⇒ k ∊ ω $ >
  $ G ⇒ functional (s ∪ s2_sh t k) $
----
