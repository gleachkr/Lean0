-- model-ci.mm0: the iota rule as a closed equation, in the model.
-- The recursor's rule in the context of its own variables (parameters, motives,
-- minors, fields), from the value lemmas of model-fold: the lemmas about
-- contexts and spines of variables that replace the typing premises.
import "model-top.mm0";

--| A context moved under more variables (`clift`) has the same valuations: over the table shifted by `m ++ s`,
--| `m` as long as the move, the valuations of `tY` are those of `tX` over the table shifted by `s`.
theorem clift_sem (G: hyps) (M: class) (u w s m tk tX tY: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ m ∊ fseq u $ > $ G ⇒ cdm m = fv nvf tk $ > $ G ⇒ ra_clift tk tX tY ∈ lrel $ >
  $ G ⇒ esat u (dsh u M (scat m s)) tY w = esat u (dsh u M s) tX w $;

--| The binders `tX` of a telescope type `Π tX. tB` closed at `tk` read only the first `tk` entries of the outer
--| valuation: over tables shifted by `p ++ s` and by `p ++ s2`, `p` of length `tk`, they have the same valuations.
theorem pis_esat_closed (G: hyps) (M: class) (u w p s s2 tk tX tB tZ tq: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ s2 ∊ fseq u $ > $ G ⇒ cdm p = fv nvf tk $ > $ G ⇒ ra_closed tk tZ ∈ lrel $ > $ G ⇒ ra_pis tX tB tZ ∈ lrel $ > $ G ⇒ ra_clen tX tq ∈ lrel $ >
  $ G ⇒ esat u (dsh u M (scat p s)) tX w = esat u (dsh u M (scat p s2)) tX w $;

--| `rehead Y X k e e2` in path form: when `Y` and `X` each have one path, with no fields and the arguments `sa` and
--| `sb`, so have `e` and `e2`, with the same `k` new arguments `i` in front of them (the sort is asked of `e2`).
--| @freshen G i
--| @freshen G z
--| @freshen G q
theorem rehead_etel {i z q: set} (G: hyps) (M: class) (u w r tY tX sa sb te te2 tk: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dnf u M) tY w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sa ⟩ ⟩ ⟩ $ > $ G ⇒ etel u (dnf u M) tX w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sb ⟩ ⟩ ⟩ $ > $ G ⇒ sa ∊ fseq u $ > $ G ⇒ sb ∊ fseq u $ > $ G ⇒ te ∊ trees ω $ > $ G ⇒ te2 ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ra_rehead tY tX tk te te2 ∈ lrel $ >
  $ G ⇒ ∃ i ∃ z ∃ q (i ∊ fseq u ∧ cdm i = fv nvf tk ∧ etel u (dnf u M) te w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z ⟩ ⟩ ⟩ ∧ z = scat i sa ∧ etel u (dnf u M) te2 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , q ⟩ ⟩ ⟩ ∧ q = scat i sb) $;

--| The recursor's side of the closed iota rule: at a valuation `r` that is `x`, the minors `m`, the motives `c` and
--| the parameters `p`, the recursor at the three windows (`te3`) re-headed from the major premise's type `tT2`, a spine
--| with `tni` arguments over the block's type at the parameters' window: its arguments are `tT2`'s first `tni`
--| arguments `f`, then `m`, `c` and `p`, and `tT2`'s are `f` and `p`; and the variable `tmo` of a motive (entry `tio` of `c`) re-headed likewise (`tT0`)
--| has the motive's value applied to `f`. No typing is involved.
--| @freshen G f
theorem ci_rec {f: set} (G: hyps) (M: class) (u w r x m c p td ti tv tnf tm tn tnp td1 td2 te1 te2 te3 tY tni tT2 te4 tio tmo tT0: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ x ∊ fseq u $ >
  $ G ⇒ m ∊ fseq u $ >
  $ G ⇒ c ∊ fseq u $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ r = scat x (scat m (scat c p)) $ >
  $ G ⇒ cdm x = fv nvf tnf $ >
  $ G ⇒ cdm m = fv nvf tm $ >
  $ G ⇒ cdm c = fv nvf tn $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ ra_add tnf tm td2 ∈ lrel $ >
  $ G ⇒ ra_add td2 tn td1 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ td1 tnp te1 ∈ lrel $ >
  $ G ⇒ ra_pargs te1 td2 tn te2 ∈ lrel $ >
  $ G ⇒ ra_pargs te2 tnf tm te3 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ td1 tnp tY ∈ lrel $ >
  $ G ⇒ ra_rehead tY te3 tni tT2 te4 ∈ lrel $ >
  $ G ⇒ tT2 ∊ trees ω $ >
  $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_add td2 tio tmo ∈ lrel $ >
  $ G ⇒ fv nvf tio ∈ fv nvf tn $ >
  $ G ⇒ ra_rehead tY ⟨ kc_bvar , scons tmo ∅ ⟩ tni tT2 tT0 ∈ lrel $ >
  $ G ⇒ tT0 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ∃ f (sarg u (dnf u M) te4 w r = scat f (scat m (scat c p)) ∧ f ∊ fseq u ∧ cdm f = fv nvf tni ∧ sarg u (dnf u M) tT2 w r = scat f p ∧ dt u M tT0 w r = apn (fv c (fv nvf tio)) f) $;

--| The constructor's side of the closed iota rule: at a valuation `r` that is the fields `f`, a valuation of the
--| constructor's binders moved under `tmn` more variables, then `m` of that length, then the parameters `p`, the
--| constructor at the parameters' and the fields' windows (`tmj`) has the arguments `f ++ p`, a valuation of the
--| constructor's context over `r`, and the lifted result `tT2` has the result's arguments there: the hypotheses of
--| `iota_ctor_sem`, with no typing involved.
theorem ci_ctor (G: hyps) (M: class) (u w r f m p td ti tc tp tt tF tE tX tXl tQ tB tK2 tnf tmn tnp td1 tc1 tmj tT2 tl: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ m ∊ fseq u $ >
  $ G ⇒ p ∊ esat u (dnf u M) tp w $ >
  $ G ⇒ f ∊ esat u (dsh u M (scat m p)) tXl w $ >
  $ G ⇒ r = scat f (scat m p) $ >
  $ G ⇒ cdm m = fv nvf tmn $ >
  $ G ⇒ ra_clift tmn tX tXl ∈ lrel $ >
  $ G ⇒ ra_clen tX tnf ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_tys_closed tp tt ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_capp tX tp tQ ∈ lrel $ >
  $ G ⇒ ra_pis tX tB tK2 ∈ lrel $ >
  $ G ⇒ ra_closed tnp tK2 ∈ lrel $ >
  $ G ⇒ ra_add tnf tmn td1 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ td1 tnp tc1 ∈ lrel $ >
  $ G ⇒ ra_pargs tc1 ⟨ kc_nz , ∅ ⟩ tnf tmj ∈ lrel $ >
  $ G ⇒ ra_lift tmn tnf tB tT2 ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tB tl ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tT2 tl ∈ lrel $ >
  $ G ⇒ sarg u (dnf u M) tmj w r ∈ esat u (dsh u M r) tQ w ∧ sarg u (dnf u M) tT2 w r = sarg u (dnf u M) tB w (scat (sarg u (dnf u M) tmj w r) r) ∧ sarg u (dnf u M) tmj w r = scat f p ∧ cdm f = fv nvf tnf $;

--| A valuation of the closed iota rule's context `tQ3` (the fields' context `tXl` appended to the minors, the motives
--| and the parameters) is the fields `x`, the minors `m`, the motives `c` and the parameters `p`, each in its space
--| (`lrel_capp_sem`, `imots_wf`, `imins_wf`).
--| @freshen G x
--| @freshen G m
--| @freshen G c
--| @freshen G p
theorem ci_shape {x m c p: set} (G: hyps) (H J: class) (u w r r0 tg td tv tb tp tt tnp tn tm tM tN tXl tQ1 tQ2 tQ3: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_capp tM tp tQ1 ∈ lrel $ >
  $ G ⇒ ra_capp tN tQ1 tQ2 ∈ lrel $ >
  $ G ⇒ ra_capp tXl tQ2 tQ3 ∈ lrel $ >
  $ G ⇒ r ∊ sat u (mcv H) tQ3 w $ >
  $ G ⇒ ∃ x ∃ m ∃ c ∃ p (r = scat x (scat m (scat c p)) ∧ p ∊ esat u (dnf u (mcv H)) tp w ∧ c ∊ imots u (dnf u (mcv H)) td w p (lv tv w) ∧ m ∊ imins u (dnf u (mcv H)) td w p c ∧ x ∊ esat u (dsh u (mcv H) (scat m (scat c p))) tXl w) $;

--| The type of the iota rule's left-hand side, semantically: the recursor's spine `te` with the arguments `sf`
--| (indices), `mv`, `cv`, `p`, applied to a constructor's spine `tmj` whose arguments are a path of the constructor's
--| type (with the arguments `pa = sf ++ p`) and `p`, has its value in the type's motive at the indices and the major
--| premise's value (`irc_apn`, `irc_val`). No typing of the two spines is involved.
theorem iota_lhs_ty (G: hyps) (H J K S: class) (u w r r0 tg td tv ti tc tb tp tt tnp tn tm tF tE tK tni tl te tk tmj tnq sf mv cv p pf pg pt pa sj sc: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK ∈ lrel $ >
  $ G ⇒ ra_isort tF tni tl ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ te tk ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ K , S ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ >
  $ G ⇒ ¬ K = kc_pi $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ w r = irc u (dnf u (mcv H)) td (fv nvf ti) (lv tv w) w $ >
  $ G ⇒ dt u (mcv H) ⟨ K , S ⟩ w r = ictor u (dnf u (mcv H)) td (fv nvf ti) (fv nvf tc) w $ >
  $ G ⇒ te ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ sarg u (dnf u (mcv H)) te w r = scat sf (scat mv (scat cv p)) $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tmj w r = scat pf p $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ pa = scat sf p $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ cdm sf = fv nvf tni $ >
  $ G ⇒ sj = fv nvf ti $ >
  $ G ⇒ sc = fv nvf tc $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te (scons tmj ∅) ⟩ w r ∈ apn (vat cv (intys td) (fv nvf ti)) (scons (dt u (mcv H) tmj w r) sf) $;

--| The closed iota rule in the model from its pieces, at one valuation `r` of the rule's context `tg` (the fields'
--| context moved under the minors and the motives, `tXl`, appended to the minors, the motives and the parameters):
--| the recursor at the context's variables and the indices of the constructor's lifted result `tT2` (`te4`), applied
--| to the constructor at the variables (`tmj`), has the value of the right-hand side `trhs` and lies in the value of
--| the motive's variable at those indices applied to `tmj`. No typing premise: the valuation gives the arguments'
--| spaces (`ci_shape`, `ci_rec`, `ci_ctor`), then `iota_vals_eq` and `iota_lhs_ty`.
theorem ci_core (G: hyps) (H J: class) (u w r tg td tv ti tc tb tp tt tnp tn tm tF tE tK0 tK2 tni tl te4 tks tmj tnq tM tN tM2 tN2 tR tR1 tR2 tVal tc1 trhs0 tnf trhs ta te3 tam tmk tk tAcc tQ1 tQ2 tXl td1 te1 te2 tY tT2 tio tmo tT0 tmn tX tQ tB tsl: set):
  $ G ⇒ iwf u H J tg td w r $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ hrec ⊆ H $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK0 ∈ lrel $ >
  $ G ⇒ ra_isort tF tni tl ∈ lrel $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ te4 tks ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_lams tp tR2 tR ∈ lrel $ >
  $ G ⇒ ra_lams tM tR1 tR2 ∈ lrel $ >
  $ G ⇒ ra_lams tN tVal tR1 ∈ lrel $ >
  $ G ⇒ ra_minor_idx tt ti tc tk ∈ lrel $ >
  $ G ⇒ ra_npis tK0 tnf ∈ lrel $ >
  $ G ⇒ ra_add tnf tm tam ∈ lrel $ >
  $ G ⇒ ra_add tmk ⟨ kc_s , scons tk ∅ ⟩ tam ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_bvar , scons tmk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tnf tAcc ∈ lrel $ >
  $ G ⇒ ra_rwalk td tnp tn tm tv tnf ⟨ kc_nz , ∅ ⟩ tAcc tK0 tVal ∈ lrel $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_rehead tc1 trhs0 tnf tmj trhs ∈ lrel $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM2 ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN2 ∈ lrel $ >
  $ G ⇒ tM2 ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN2 ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_capp tM2 tp tQ1 ∈ lrel $ >
  $ G ⇒ ra_capp tN2 tQ1 tQ2 ∈ lrel $ >
  $ G ⇒ ra_capp tXl tQ2 tg ∈ lrel $ >
  $ G ⇒ ra_add tam tn td1 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ td1 tnp te1 ∈ lrel $ >
  $ G ⇒ ra_pargs te1 tam tn te2 ∈ lrel $ >
  $ G ⇒ ra_pargs te2 tnf tm te3 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ td1 tnp tY ∈ lrel $ >
  $ G ⇒ ra_rehead tY te3 tni tT2 te4 ∈ lrel $ >
  $ G ⇒ ra_add tam tio tmo ∈ lrel $ >
  $ G ⇒ ra_add tio ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel $ >
  $ G ⇒ ra_rehead tY ⟨ kc_bvar , scons tmo ∅ ⟩ tni tT2 tT0 ∈ lrel $ >
  $ G ⇒ tT0 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_clift tmn tX tXl ∈ lrel $ >
  $ G ⇒ ra_clen tX tnf ∈ lrel $ >
  $ G ⇒ ra_capp tX tp tQ ∈ lrel $ >
  $ G ⇒ ra_pis tX tB tK2 ∈ lrel $ >
  $ G ⇒ ra_closed tnp tK2 ∈ lrel $ >
  $ G ⇒ ra_add tm tn tmn ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ td1 tnp tc1 ∈ lrel $ >
  $ G ⇒ ra_pargs tc1 ⟨ kc_nz , ∅ ⟩ tnf tmj ∈ lrel $ >
  $ G ⇒ ra_lift tmn tnf tB tT2 ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tB tsl ∈ lrel $ >
  $ G ⇒ ra_add tnp tni tsl ∈ lrel $ >
  $ G ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tnp tK0 tK2 ∈ lrel $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $;

--| Appending to a context is total: every context `t1` has an appended context over any tree `t2` (`capp`).
--| @freshen G q
theorem capp_total {q: set} (G: hyps) (t1 t2: set): $ G ⇒ t1 ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ t2 ∊ trees ω $ > $ G ⇒ ∃ q (ra_capp t1 t2 q ∈ lrel) $;

--| A term whose lift is a spine over a head that the lift keeps is a spine over that head, of the same length
--| (by induction on the lift: `lift_app_res`, `lift_inj`).
theorem lift_spine_inv (G: hyps) (tn tk th te te2 tl: set): $ G ⇒ ra_lift tn tk th th ∈ lrel $ > $ G ⇒ ra_lift tn tk te te2 ∈ lrel $ > $ G ⇒ ra_spine th te2 tl ∈ lrel $ > $ G ⇒ ra_spine th te tl ∈ lrel $;

--| A telescope type split at `tn` binders (`psplit` from the empty context): the context `tx` and the body `tr` give
--| the type back (`pis`), `tx` has `tn` entries, and `tx` can be appended to any tree `tp` (`capp`).
--| @freshen G e
theorem psplit_pis {e: set} (G: hyps) (tn tK tx tr tp: set): $ G ⇒ ra_psplit tn tK ⟨ kc_nil , ∅ ⟩ tx tr ∈ lrel $ > $ G ⇒ tp ∊ trees ω $ > $ G ⇒ ra_pis tx tr tK ∈ lrel ∧ ra_clen tx tn ∈ lrel ∧ ∃ e (ra_capp tx tp e ∈ lrel) $;

--| The new head of a re-headed spine that is an expression is an expression.
theorem rehead_head_sort (G: hyps) (tY tX tk te te2: set): $ G ⇒ ra_rehead tY tX tk te te2 ∈ lrel $ > $ G ⇒ te2 ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $;

--| `ci_core` with `rec_rhs` inverted and identified with the block's data by determinacy (the motives' and minors'
--| contexts of the right-hand side need not be the context's: `motives` and `minors` have no determinacy lemma), the
--| two spines' lengths from `pargs_spine` and `spine_trans2`, and `isort` from `nidx`.
theorem ci_wf1 (G: hyps) (H J: class) (u w r tg td tv ti tc tb tp tt tnp tn tm tF tE tK0 tK2 tni te4 tmj tM2 tN2 tR tc1 trhs0 tnf trhs ta te3 tam tQ1 tQ2 tXl td1 te1 te2 tY tT2 tio tmo tT0 tmn tX tQ tB tsl: set):
  $ G ⇒ iwf u H J tg td w r $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ hrec ⊆ H $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK0 ∈ lrel $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_npis tK0 tnf ∈ lrel $ >
  $ G ⇒ ra_add tnf tm tam ∈ lrel $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_rehead tc1 trhs0 tnf tmj trhs ∈ lrel $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM2 ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN2 ∈ lrel $ >
  $ G ⇒ tM2 ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN2 ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_capp tM2 tp tQ1 ∈ lrel $ >
  $ G ⇒ ra_capp tN2 tQ1 tQ2 ∈ lrel $ >
  $ G ⇒ ra_capp tXl tQ2 tg ∈ lrel $ >
  $ G ⇒ ra_add tam tn td1 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ td1 tnp te1 ∈ lrel $ >
  $ G ⇒ ra_pargs te1 tam tn te2 ∈ lrel $ >
  $ G ⇒ ra_pargs te2 tnf tm te3 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ td1 tnp tY ∈ lrel $ >
  $ G ⇒ ra_rehead tY te3 tni tT2 te4 ∈ lrel $ >
  $ G ⇒ ra_add tam tio tmo ∈ lrel $ >
  $ G ⇒ ra_add tio ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel $ >
  $ G ⇒ ra_rehead tY ⟨ kc_bvar , scons tmo ∅ ⟩ tni tT2 tT0 ∈ lrel $ >
  $ G ⇒ tT0 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_clift tmn tX tXl ∈ lrel $ >
  $ G ⇒ ra_clen tX tnf ∈ lrel $ >
  $ G ⇒ ra_capp tX tp tQ ∈ lrel $ >
  $ G ⇒ ra_pis tX tB tK2 ∈ lrel $ >
  $ G ⇒ ra_closed tnp tK2 ∈ lrel $ >
  $ G ⇒ ra_add tm tn tmn ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ td1 tnp tc1 ∈ lrel $ >
  $ G ⇒ ra_pargs tc1 ⟨ kc_nz , ∅ ⟩ tnf tmj ∈ lrel $ >
  $ G ⇒ ra_lift tmn tnf tB tT2 ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tB tsl ∈ lrel $ >
  $ G ⇒ ra_add tnp tni tsl ∈ lrel $ >
  $ G ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tnp tK0 tK2 ∈ lrel $ >
  $ G ⇒ ra_rec_rhs td tv ti tc tR ∈ lrel $ >
  $ G ⇒ ra_nidx td ti tni ∈ lrel $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) ⟨ kc_app , scons tT0 (scons tmj ∅) ⟩ w r $;

--| The two parts of a well-sorted appended context (`capp`) are contexts (the converse of `capp_ctx`).
theorem capp_ctx_inv (G: hyps) (t1 t2 t3: set): $ G ⇒ ra_capp t1 t2 t3 ∈ lrel $ > $ G ⇒ t3 ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ t1 ∊ ofsort lsig lopen ks_ctx ∧ t2 ∊ ofsort lsig lopen ks_ctx $;

--| `ci_wf1` with `iota_lhs` inverted: its counts are the block's (`ind_arity`), and the type is the motive's variable
--| at the indices applied to the major premise.
theorem ci_wf2 (G: hyps) (H J: class) (u w r tg td tv ti tc tb tp tt tnp tn tm tF tE tK0 tK2 te4 tmj tM2 tN2 tR tc1 trhs0 tnf trhs ta te3 tQ1 tQ2 tXl tmn tX tQ tB tT: set):
  $ G ⇒ iwf u H J tg td w r $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ hrec ⊆ H $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK0 ∈ lrel $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_npis tK0 tnf ∈ lrel $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_rehead tc1 trhs0 tnf tmj trhs ∈ lrel $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM2 ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN2 ∈ lrel $ >
  $ G ⇒ tM2 ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN2 ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_capp tM2 tp tQ1 ∈ lrel $ >
  $ G ⇒ ra_capp tN2 tQ1 tQ2 ∈ lrel $ >
  $ G ⇒ ra_capp tXl tQ2 tg ∈ lrel $ >
  $ G ⇒ ra_clift tmn tX tXl ∈ lrel $ >
  $ G ⇒ ra_clen tX tnf ∈ lrel $ >
  $ G ⇒ ra_capp tX tp tQ ∈ lrel $ >
  $ G ⇒ ra_pis tX tB tK2 ∈ lrel $ >
  $ G ⇒ ra_closed tnp tK2 ∈ lrel $ >
  $ G ⇒ ra_add tm tn tmn ∈ lrel $ >
  $ G ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tnp tK0 tK2 ∈ lrel $ >
  $ G ⇒ ra_rec_rhs td tv ti tc tR ∈ lrel $ >
  $ G ⇒ ra_iota_lhs td tv ti tc tnf tB te3 tc1 tmj te4 tT ∈ lrel $ >
  $ G ⇒ ra_ind_arity td tnp tn tm ∈ lrel $ >
  $ G ⇒ tT ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) tT w r $;

--| `ci_wf2` with `iota_tel` and `ind_arity` inverted: the fields' context and the result from `psplit_pis`, the
--| closedness of the constructor's type with the types put in from `ind_wf` (`ctor_closed_add`, `sinst_closed`).
theorem ci_wf3 (G: hyps) (H J: class) (u w r tg td tv ti tc tnp tn tm te4 tmj tR tc1 trhs0 tnf trhs ta te3 tX tB tT: set):
  $ G ⇒ iwf u H J tg td w r $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ hrec ⊆ H $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_rehead tc1 trhs0 tnf tmj trhs ∈ lrel $ >
  $ G ⇒ ra_rec_rhs td tv ti tc tR ∈ lrel $ >
  $ G ⇒ ra_iota_lhs td tv ti tc tnf tB te3 tc1 tmj te4 tT ∈ lrel $ >
  $ G ⇒ ra_ind_arity td tnp tn tm ∈ lrel $ >
  $ G ⇒ tT ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_iota_tel td tv ti tc tX tB tnf tg ∈ lrel $ >
  $ G ⇒ tg ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) ⟨ kc_app , scons te4 (scons tmj ∅) ⟩ w r ∈ dt u (mcv H) tT w r $;

--| The closed iota rule in the model from the rule's premises (`ind_iota_eq`), for a block without nested occurrences:
--| `iota_eq` inverted, the sorts of its parts from those of the two sides, then `ci_wf3`. At every valuation of the
--| rule's context, the left-hand side has the value of the right-hand side, an element of the type's value. No typing
--| premise.
theorem ind_iota_eq_rule (G: hyps) (H J: class) (u w r tg td tv ti tc tl trhs tT: set):
  $ G ⇒ iwf u H J tg td w r $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ hrec ⊆ H $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ tl ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ trhs ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tT ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tg ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_iota_eq td ti tc tv tg tl trhs tT ∈ lrel $ >
  $ G ⇒ dt u (mcv H) tl w r = dt u (mcv H) trhs w r ∧ dt u (mcv H) tl w r ∈ dt u (mcv H) tT w r $;


-- --------------------------------------------------------------------------
-- The spec's rule
-- --------------------------------------------------------------------------

theorem ind_iota_eq (D: ind) (i c: nat) (v: lvl) (Dl: ctx) (lhs rhs T: expr): $ ind_wf Dl D $ > $ elim_ok Dl D v $ > $ iota_eq D i c v Dl lhs rhs T $ > $ deq Dl lhs rhs T $;

--| A valuation `r` of a closed context `tg` appended to a base context `tg0` begins with a valuation `c` of `tg`
--| itself (`pis_esat_closed` at depth `0`), and every expression closed below `tg`'s length has the same value at
--| both (`lrel_closed_sem`).
--| @freshen G c
theorem weak_base_sem {c: set} (G: hyps) (M: class) (u w r tg tg0 tg2 tB tK tz tk te te2 tA: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ sat u M tg2 w $ >
  $ G ⇒ tg ∊ trees ω $ >
  $ G ⇒ tg0 ∊ trees ω $ >
  $ G ⇒ ra_capp tg tg0 tg2 ∈ lrel $ >
  $ G ⇒ ra_pis tg tB tK ∈ lrel $ >
  $ G ⇒ ra_closed tz tK ∈ lrel $ >
  $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ >
  $ G ⇒ ra_clen tg tk ∈ lrel $ >
  $ G ⇒ ra_closed tk te ∈ lrel $ >
  $ G ⇒ ra_closed tk te2 ∈ lrel $ >
  $ G ⇒ ra_closed tk tA ∈ lrel $ >
  $ G ⇒ ∃ c (c ∊ sat u M tg w ∧ dt u M te w r = dt u M te w c ∧ dt u M te2 w r = dt u M te2 w c ∧ dt u M tA w r = dt u M tA w c) $;

--| Weakening below a closed context, for every hook: a judgment in a context `G` whose entries and terms mention no
--| variable outside `G` holds over any base context `G0` (`weak_base_sem`).
theorem mweakBaseDF (M: class) (k: nat) (G G0 G2: ctx) (e e2 A K: expr):
  $ mdeq M G e e2 A $ > $ pis G (srt lz) K $ > $ closed nz K $ > $ clen G k $ > $ closed k e $ > $ closed k e2 $ > $ closed k A $ > $ capp G G0 G2 $ > $ mdeq M G2 e e2 A $;

theorem weakBaseDF (k: nat) (G G0 G2: ctx) (e e2 A K: expr): $ deq G e e2 A $ > $ pis G (srt lz) K $ > $ closed nz K $ > $ clen G k $ > $ closed k e $ > $ closed k e2 $ > $ closed k A $ > $ capp G G0 G2 $ > $ deq G2 e e2 A $;
