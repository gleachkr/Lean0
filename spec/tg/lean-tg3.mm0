--| The clauses of each relation.
def pr_sty (J: class): class = $ cl_sty_nil ∪ (cl_sty_app J) $;
def pr_cwf (J: class): class = $ cl_cwf_pi J ∪ (cl_cwf_pi_rec J ∪ cl_cwf_res) $;
def pr_ctors_wf: class = $ cl_ctors_wf_nil ∪ cl_ctors_wf_cons $;
def pr_tys_wf: class = $ cl_tys_wf_nil ∪ cl_tys_wf_cons $;
def pr_ctx_wf (J: class): class = $ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) $;
def pr_tys_ty (J: class): class = $ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) $;
def pr_tys_ok: class = $ cl_tys_ok_i $;
def pr_ind_wf: class = $ cl_ind_wf_i $;
def pr_nst_ok: class = $ cl_nst_ok_nil ∪ cl_nst_ok_cons $;
def pr_nst_ty: class = $ cl_nst_ty_i $;
def pr_large: class = $ cl_large_nz ∪ (cl_large_empty ∪ cl_large_single) $;
def pr_fir (J: class): class = $ cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J)) $;
def pr_elim_ok: class = $ cl_elim_prop ∪ cl_elim_large $;
def pr_fprops (J: class): class = $ cl_fprops_z ∪ (cl_fprops_s J) $;
def pr_proj_ok: class = $ cl_proj_ok_sort ∪ cl_proj_ok_prop $;
def pr_add_eqs (J: class): class = $ cl_add_eqs_i J $;
def pr_pred_eqs (J: class): class = $ cl_pred_eqs_i J $;
def pr_sub_eqs (J: class): class = $ cl_sub_eqs_i J $;
def pr_mul_eqs (J: class): class = $ cl_mul_eqs_i J $;
def pr_pow_eqs (J: class): class = $ cl_pow_eqs_i J $;
def pr_beq_eqs (J: class): class = $ cl_beq_eqs_i J $;
def pr_ble_eqs (J: class): class = $ cl_ble_eqs_i J $;
def pr_shl_eqs (J: class): class = $ cl_shl_eqs_i J $;
def pr_shr_eqs (J: class): class = $ cl_shr_eqs_i J $;
def pr_divmod_eqs (J: class): class = $ cl_divmod_eqs_i J $;
def pr_gcd_eqs (J: class): class = $ cl_gcd_eqs_i J $;
def pr_land_eqs (J: class): class = $ cl_land_eqs_i J $;
def pr_lor_eqs (J: class): class = $ cl_lor_eqs_i J $;
def pr_xor_eqs (J: class): class = $ cl_xor_eqs_i J $;

--| The program, at the atoms.
def lprog3 (J: class): class =
  $ (((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J)))))) ∩
    (fseq latoms × latoms) $;
--| The derivable atoms.
def lrel3 (J: class): class = $ horn (lprog3 J) $;

--| The judgment at `J`, and the relations: an atom is derivable.
def deq_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr): wff = $ _ ⇒ ra_deq (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) ∈ J $;
def sty_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr): wff = $ _ ⇒ ra_sty (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) ∈ lrel3 J $;
def cwf_j (J: class) (a1: ind) (a2: nat) (a3: nat) (a4: lvl) (a5: nat) (a6: ctx) (a7: nat) (a8: expr): wff = $ _ ⇒ ra_cwf (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_lvl a4) (enc_nat a5) (enc_ctx a6) (enc_nat a7) (enc_expr a8) ∈ lrel3 J $;
def ctors_wf_j (J: class) (a1: ind) (a2: nat) (a3: nat) (a4: lvl) (a5: nat) (a6: ctx) (a7: ctors): wff = $ _ ⇒ ra_ctors_wf (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_lvl a4) (enc_nat a5) (enc_ctx a6) (enc_ctors a7) ∈ lrel3 J $;
def tys_wf_j (J: class) (a1: ind) (a2: nat) (a3: nat) (a4: lvl) (a5: nat) (a6: ctx) (a7: tys): wff = $ _ ⇒ ra_tys_wf (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_lvl a4) (enc_nat a5) (enc_ctx a6) (enc_tys a7) ∈ lrel3 J $;
def ctx_wf_j (J: class) (a1: ctx) (a2: ctx): wff = $ _ ⇒ ra_ctx_wf (enc_ctx a1) (enc_ctx a2) ∈ lrel3 J $;
def tys_ty_j (J: class) (a1: ctx) (a2: tys): wff = $ _ ⇒ ra_tys_ty (enc_ctx a1) (enc_tys a2) ∈ lrel3 J $;
def tys_ok_j (J: class) (a1: ctx) (a2: ind): wff = $ _ ⇒ ra_tys_ok (enc_ctx a1) (enc_ind a2) ∈ lrel3 J $;
def ind_wf_j (J: class) (a1: ctx) (a2: ind): wff = $ _ ⇒ ra_ind_wf (enc_ctx a1) (enc_ind a2) ∈ lrel3 J $;
def nst_ok_j (J: class) (a1: ctx) (a2: ind) (a3: nat) (a4: ctx): wff = $ _ ⇒ ra_nst_ok (enc_ctx a1) (enc_ind a2) (enc_nat a3) (enc_ctx a4) ∈ lrel3 J $;
def nst_ty_j (J: class) (a1: ctx) (a2: ind) (a3: ind) (a4: expr): wff = $ _ ⇒ ra_nst_ty (enc_ctx a1) (enc_ind a2) (enc_ind a3) (enc_expr a4) ∈ lrel3 J $;
def large_j (J: class) (a1: ctx) (a2: ind): wff = $ _ ⇒ ra_large (enc_ctx a1) (enc_ind a2) ∈ lrel3 J $;
def fir_j (J: class) (a1: ind) (a2: nat) (a3: ctx) (a4: nat) (a5: expr): wff = $ _ ⇒ ra_fir (enc_ind a1) (enc_nat a2) (enc_ctx a3) (enc_nat a4) (enc_expr a5) ∈ lrel3 J $;
def elim_ok_j (J: class) (a1: ctx) (a2: ind) (a3: lvl): wff = $ _ ⇒ ra_elim_ok (enc_ctx a1) (enc_ind a2) (enc_lvl a3) ∈ lrel3 J $;
def fprops_j (J: class) (a1: ind) (a2: nat) (a3: nat) (a4: ctx) (a5: nat) (a6: nat) (a7: expr): wff = $ _ ⇒ ra_fprops (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_ctx a4) (enc_nat a5) (enc_nat a6) (enc_expr a7) ∈ lrel3 J $;
def proj_ok_j (J: class) (a1: ctx) (a2: ind) (a3: nat) (a4: nat): wff = $ _ ⇒ ra_proj_ok (enc_ctx a1) (enc_ind a2) (enc_nat a3) (enc_nat a4) ∈ lrel3 J $;
def add_eqs_j (J: class) (a1: ctx) (a2: expr): wff = $ _ ⇒ ra_add_eqs (enc_ctx a1) (enc_expr a2) ∈ lrel3 J $;
def pred_eqs_j (J: class) (a1: ctx) (a2: expr): wff = $ _ ⇒ ra_pred_eqs (enc_ctx a1) (enc_expr a2) ∈ lrel3 J $;
def sub_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr): wff = $ _ ⇒ ra_sub_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) ∈ lrel3 J $;
def mul_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr): wff = $ _ ⇒ ra_mul_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) ∈ lrel3 J $;
def pow_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr): wff = $ _ ⇒ ra_pow_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) ∈ lrel3 J $;
def beq_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr): wff = $ _ ⇒ ra_beq_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) ∈ lrel3 J $;
def ble_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr): wff = $ _ ⇒ ra_ble_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) ∈ lrel3 J $;
def shl_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr): wff = $ _ ⇒ ra_shl_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) ∈ lrel3 J $;
def shr_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr): wff = $ _ ⇒ ra_shr_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) ∈ lrel3 J $;
def divmod_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr): wff = $ _ ⇒ ra_divmod_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) ∈ lrel3 J $;
def gcd_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr) (a6: expr): wff = $ _ ⇒ ra_gcd_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) (enc_expr a6) ∈ lrel3 J $;
def land_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr) (a6: expr): wff = $ _ ⇒ ra_land_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) (enc_expr a6) ∈ lrel3 J $;
def lor_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr) (a6: expr): wff = $ _ ⇒ ra_lor_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) (enc_expr a6) ∈ lrel3 J $;
def xor_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr) (a6: expr): wff = $ _ ⇒ ra_xor_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) (enc_expr a6) ∈ lrel3 J $;
--| Part II's definitions over the judgment.
def ty_j (J: class) (G: ctx) (e A: expr): wff = $ deq_j J G e e A $;

theorem lprog3_hprog (G: hyps) (J: class): $ G ⇒ hprog (lprog3 J) latoms $;

--| The clause axioms at classes (`lrel3_A` for the clause axiom `A`), at every
--| `J`: at any trees `A1 .. An` for its variables, a clause's conclusion is
--| derivable when its premises are and its side conditions hold (the wide ones
--| after their instances' congruence).
theorem lrel3_sty_nil (G: hyps) (J A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_sty A1 A2 A3 A2 A3 ∈ lrel3 J $;
theorem lrel3_sty_app (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ ra_sty A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A7 ∅) ⟩ ∈ lrel3 J $ >
  $ G ⇒ ra_deq A1 A5 A5 A6 ∈ J $ >
  $ G ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ A7 A5 A8 ∈ lrel $ >
  $ G ⇒ ra_sty A1 A2 A3 ⟨ kc_app , scons A4 (scons A5 ∅) ⟩ A8 ∈ lrel3 J $;
theorem lrel3_cwf_pi (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ > $ G ⇒ A10 ∈ trees ω $ > $ G ⇒ A11 ∈ trees ω $ > $ G ⇒ A12 ∈ trees ω $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 ⟨ kc_cons , scons A11 (scons A6 ∅) ⟩ ⟨ kc_s , scons A7 ∅ ⟩ A10 ∈ lrel3 J $ >
  $ G ⇒ ra_add A7 A3 A8 ∈ lrel $ >
  $ G ⇒ ra_closed A8 A9 ∈ lrel $ >
  $ G ⇒ ra_sinst A1 ⟨ kc_nz , ∅ ⟩ A2 A8 A9 A11 ∈ lrel $ >
  $ G ⇒ ra_deq A6 A11 A11 ⟨ kc_srt , scons A12 ∅ ⟩ ∈ J $ >
  $ G ⇒ ra_ulevel A4 A12 ∈ lrel2 $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 ⟨ kc_pi , scons A9 (scons A10 ∅) ⟩ ∈ lrel3 J $;
theorem lrel3_cwf_pi_rec (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ > $ G ⇒ A10 ∈ trees ω $ > $ G ⇒ A11 ∈ trees ω $ > $ G ⇒ A12 ∈ trees ω $ >
  $ G ⇒ A13 ∈ trees ω $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 ⟨ kc_cons , scons A11 (scons A6 ∅) ⟩ ⟨ kc_s , scons A7 ∅ ⟩ A10 ∈ lrel3 J $ >
  $ G ⇒ ra_add A7 A3 A8 ∈ lrel $ >
  $ G ⇒ ra_sinst A1 ⟨ kc_nz , ∅ ⟩ A2 A8 A9 A11 ∈ lrel $ >
  $ G ⇒ ra_deq A6 A11 A11 ⟨ kc_srt , scons A13 ∅ ⟩ ∈ J $ >
  $ G ⇒ ra_ulevel A4 A13 ∈ lrel2 $ >
  $ G ⇒ ra_ipos A1 A2 A3 A7 A9 ∈ lrel $ >
  $ G ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ A10 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ A12 ∈ lrel $ >
  $ G ⇒ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A12 A10 ∈ lrel $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 ⟨ kc_pi , scons A9 (scons A10 ∅) ⟩ ∈ lrel3 J $;
theorem lrel3_cwf_res (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15 A16 A17 A18: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ > $ G ⇒ A10 ∈ trees ω $ > $ G ⇒ A11 ∈ trees ω $ > $ G ⇒ A12 ∈ trees ω $ >
  $ G ⇒ A13 ∈ trees ω $ > $ G ⇒ A14 ∈ trees ω $ > $ G ⇒ A15 ∈ trees ω $ > $ G ⇒ A16 ∈ trees ω $ >
  $ G ⇒ A17 ∈ trees ω $ > $ G ⇒ A18 ∈ trees ω $ >
  $ G ⇒ ra_sty A6 ⟨ kc_ind_ty , scons A1 (scons A5 ∅) ⟩ A17 A10 A18 ∈ lrel3 J $ >
  $ G ⇒ ra_indapp A1 A2 A3 A7 A9 A5 ∈ lrel $ >
  $ G ⇒ ra_add A7 A3 A8 ∈ lrel $ >
  $ G ⇒ ra_sinst A1 ⟨ kc_nz , ∅ ⟩ A2 A8 A9 A10 ∈ lrel $ >
  $ G ⇒ ra_ind_data A1 A11 A12 A13 ∈ lrel $ >
  $ G ⇒ ra_nth_ty A13 A5 A14 A15 ∈ lrel $ >
  $ G ⇒ ra_pis A12 A14 A16 ∈ lrel $ >
  $ G ⇒ ra_lift A8 ⟨ kc_nz , ∅ ⟩ A16 A17 ∈ lrel $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 A9 ∈ lrel3 J $;
theorem lrel3_ctors_wf_nil (G: hyps) (J A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_ctors_wf A1 A2 A3 A4 A5 A6 ⟨ kc_cnil , ∅ ⟩ ∈ lrel3 J $;
theorem lrel3_ctors_wf_cons (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ > $ G ⇒ A10 ∈ trees ω $ > $ G ⇒ A11 ∈ trees ω $ > $ G ⇒ A12 ∈ trees ω $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 ⟨ kc_nz , ∅ ⟩ A7 ∈ lrel3 J $ >
  $ G ⇒ ra_ctors_wf A1 A2 A3 A4 A5 A6 A8 ∈ lrel3 J $ >
  $ G ⇒ ra_ind_data A1 A9 A10 A11 ∈ lrel $ >
  $ G ⇒ ra_pis A10 A7 A12 ∈ lrel $ >
  $ G ⇒ ra_closed A2 A12 ∈ lrel $ >
  $ G ⇒ ra_ctors_wf A1 A2 A3 A4 A5 A6 ⟨ kc_ccons , scons A7 (scons A8 ∅) ⟩ ∈ lrel3 J $;
theorem lrel3_tys_wf_nil (G: hyps) (J A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_tys_wf A1 A2 A3 A4 A5 A6 ⟨ kc_tnil , ∅ ⟩ ∈ lrel3 J $;
theorem lrel3_tys_wf_cons (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ > $ G ⇒ A10 ∈ trees ω $ > $ G ⇒ A11 ∈ trees ω $ >
  $ G ⇒ ra_ctors_wf A1 A2 A3 A4 A6 A8 A10 ∈ lrel3 J $ >
  $ G ⇒ ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11 ∈ lrel3 J $ >
  $ G ⇒ ra_isort A9 A7 A5 ∈ lrel $ >
  $ G ⇒ lveq A5 A4 $ >
  $ G ⇒ ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ∈ lrel3 J $;
theorem lrel3_ctx_wf_nil (G: hyps) (J A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ∈ lrel3 J $;
theorem lrel3_ctx_wf_cons (G: hyps) (J A1 A2 A3 A4 A5: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ ra_ctx_wf A1 A2 ∈ lrel3 J $ >
  $ G ⇒ ra_capp A2 A1 A3 ∈ lrel $ >
  $ G ⇒ ra_deq A3 A4 A4 ⟨ kc_srt , scons A5 ∅ ⟩ ∈ J $ >
  $ G ⇒ ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ∈ lrel3 J $;
theorem lrel3_tys_ty_nil (G: hyps) (J A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ∈ lrel3 J $;
theorem lrel3_tys_ty_cons (G: hyps) (J A1 A2 A3 A4 A5 A6 A7: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ >
  $ G ⇒ ra_tys_ty A1 A4 ∈ lrel3 J $ >
  $ G ⇒ ra_isort A2 A7 A6 ∈ lrel $ >
  $ G ⇒ ra_deq A1 A2 A2 ⟨ kc_srt , scons A5 ∅ ⟩ ∈ J $ >
  $ G ⇒ ra_tys_ty A1 ⟨ kc_tcons , scons A2 (scons A3 (scons A4 ∅)) ⟩ ∈ lrel3 J $;
theorem lrel3_tys_ok_i (G: hyps) (J A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_ctx_wf A1 A5 ∈ lrel3 J $ >
  $ G ⇒ ra_tys_ty A2 A6 ∈ lrel3 J $ >
  $ G ⇒ ra_ind_data A3 A4 A5 A6 ∈ lrel $ >
  $ G ⇒ ra_tys_closed A5 A6 ∈ lrel $ >
  $ G ⇒ ra_capp A5 A1 A2 ∈ lrel $ >
  $ G ⇒ ra_tys_ok A1 A3 ∈ lrel3 J $;
theorem lrel3_ind_wf_i (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ > $ G ⇒ A10 ∈ trees ω $ > $ G ⇒ A11 ∈ trees ω $ > $ G ⇒ A12 ∈ trees ω $ >
  $ G ⇒ A13 ∈ trees ω $ > $ G ⇒ A14 ∈ trees ω $ > $ G ⇒ A15 ∈ trees ω $ >
  $ G ⇒ ra_tys_ok A1 A3 ∈ lrel3 J $ >
  $ G ⇒ ra_tys_wf A3 A9 A8 A13 ⟨ kc_nz , ∅ ⟩ A2 A7 ∈ lrel3 J $ >
  $ G ⇒ ra_nst_ok A1 A3 A12 A6 ∈ lrel3 J $ >
  $ G ⇒ ra_ind_data A3 A4 A5 A7 ∈ lrel $ >
  $ G ⇒ ra_clen A5 A8 ∈ lrel $ >
  $ G ⇒ ra_ntys A7 A9 A10 ∈ lrel $ >
  $ G ⇒ ra_capp A5 A1 A2 ∈ lrel $ >
  $ G ⇒ ra_nth_ty A7 ⟨ kc_nz , ∅ ⟩ A14 A15 ∈ lrel $ >
  $ G ⇒ ra_isort A14 A11 A13 ∈ lrel $ >
  $ G ⇒ ra_ind_nested A3 A6 ∈ lrel $ >
  $ G ⇒ ra_ndecl A6 A9 A12 ∈ lrel $ >
  $ G ⇒ ra_ind_wf A1 A3 ∈ lrel3 J $;
