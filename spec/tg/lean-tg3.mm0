--| The ground instances of each clause axiom: ⟨ premises , conclusion ⟩, with
--| its side conditions (and `J` when one of them is a judgment); a wide clause's
--| at given classes first.
def cl_sty_nil (.G .h .A .w: set): class =
  $ {w | ∃ G ∃ h ∃ A (w = ⟨ ∅ , ra_sty G h A h A ⟩)} $;
def cl_sty_app (J: class) (.G .h .A .f .a .B .C .C2 .w: set): class =
  $ {w | ∃ G ∃ h ∃ A ∃ f ∃ a ∃ B ∃ C ∃ C2 (w = ⟨ scons (ra_sty G h A f ⟨ kc_pi , scons B (scons C ∅) ⟩) ∅ , ra_sty G h A ⟨ kc_app , scons f (scons a ∅) ⟩ C2 ⟩ ∧ ra_deq G a a B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a C2 ∈ lrel)} $;
def cl_cwf_pi (J: class) (.D .n .np .l .i .Ctx .d .k .A .B .A2 .u .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx ∃ d ∃ k ∃ A ∃ B ∃ A2 ∃ u (w = ⟨ scons (ra_cwf D n np l i ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ B) ∅ , ra_cwf D n np l i Ctx d ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟩ ∧ ra_add d np k ∈ lrel ∧ ra_closed k A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n k A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u ∅ ⟩ ∈ J ∧ ra_ulevel l u ∈ lrel2)} $;
def cl_cwf_pi_rec (J: class) (.D .n .np .l .i .Ctx .d .k .A .B .A2 .B2 .u .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx ∃ d ∃ k ∃ A ∃ B ∃ A2 ∃ B2 ∃ u (w = ⟨ scons (ra_cwf D n np l i ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ B) ∅ , ra_cwf D n np l i Ctx d ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟩ ∧ ra_add d np k ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n k A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u ∅ ⟩ ∈ J ∧ ra_ulevel l u ∈ lrel2 ∧ ra_ipos D n np d A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel)} $;
def cl_cwf_res (.D .n .np .l .i .Ctx .d .k .K .K2 .b .P .T .F .C .R .R2 .S .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx ∃ d ∃ k ∃ K ∃ K2 ∃ b ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (w = ⟨ scons (ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i ∅) ⟩ R2 K2 S) ∅ , ra_cwf D n np l i Ctx d K ⟩ ∧ ra_indapp D n np d K i ∈ lrel ∧ ra_add d np k ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n k K K2 ∈ lrel ∧ ra_ind_data D b P T ∈ lrel ∧ ra_nth_ty T i F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel)} $;
def cl_ctors_wf_nil (.D .n .np .l .i .Ctx .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx (w = ⟨ ∅ , ra_ctors_wf D n np l i Ctx ⟨ kc_cnil , ∅ ⟩ ⟩)} $;
def cl_ctors_wf_cons (.D .n .np .l .i .Ctx .K .C .b .P .T .R .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx ∃ K ∃ C ∃ b ∃ P ∃ T ∃ R (w = ⟨ scons (ra_cwf D n np l i Ctx ⟨ kc_nz , ∅ ⟩ K) (scons (ra_ctors_wf D n np l i Ctx C) ∅) , ra_ctors_wf D n np l i Ctx ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟩ ∧ ra_ind_data D b P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n R ∈ lrel)} $;
def cl_tys_wf_nil (.D .n .np .l .i .Ctx .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx (w = ⟨ ∅ , ra_tys_wf D n np l i Ctx ⟨ kc_tnil , ∅ ⟩ ⟩)} $;
def cl_tys_wf_cons (.D .n .np .l .l2 .i .k .Ctx .F .C .T .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ l2 ∃ i ∃ k ∃ Ctx ∃ F ∃ C ∃ T (w = ⟨ scons (ra_ctors_wf D n np l i Ctx C) (scons (ra_tys_wf D n np l ⟨ kc_s , scons i ∅ ⟩ Ctx T) ∅) , ra_tys_wf D n np l i Ctx ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟩ ∧ ra_isort F k l2 ∈ lrel ∧ lveq l2 l)} $;
def cl_ctx_wf_nil (.G .w: set): class =
  $ {w | ∃ G (w = ⟨ ∅ , ra_ctx_wf G ⟨ kc_nil , ∅ ⟩ ⟩)} $;
def cl_ctx_wf_cons (J: class) (.G .P .G2 .A .u .w: set): class =
  $ {w | ∃ G ∃ P ∃ G2 ∃ A ∃ u (w = ⟨ scons (ra_ctx_wf G P) ∅ , ra_ctx_wf G ⟨ kc_cons , scons A (scons P ∅) ⟩ ⟩ ∧ ra_capp P G G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u ∅ ⟩ ∈ J)} $;
def cl_tys_ty_nil (.Ctx .w: set): class =
  $ {w | ∃ Ctx (w = ⟨ ∅ , ra_tys_ty Ctx ⟨ kc_tnil , ∅ ⟩ ⟩)} $;
def cl_tys_ty_cons (J: class) (.Ctx .F .C .T .u .l .k .w: set): class =
  $ {w | ∃ Ctx ∃ F ∃ C ∃ T ∃ u ∃ l ∃ k (w = ⟨ scons (ra_tys_ty Ctx T) ∅ , ra_tys_ty Ctx ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟩ ∧ ra_isort F k l ∈ lrel ∧ ra_deq Ctx F F ⟨ kc_srt , scons u ∅ ⟩ ∈ J)} $;
def cl_tys_ok_i (.G .G2 .D .b .P .T .w: set): class =
  $ {w | ∃ G ∃ G2 ∃ D ∃ b ∃ P ∃ T (w = ⟨ scons (ra_ctx_wf G P) (scons (ra_tys_ty G2 T) ∅) , ra_tys_ok G D ⟩ ∧ ra_ind_data D b P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_capp P G G2 ∈ lrel)} $;
def cl_ind_wf_i (.G .G2 .D .b .P .N .T .np .n .m .k .n0 .l .F .C .w: set): class =
  $ {w | ∃ G ∃ G2 ∃ D ∃ b ∃ P ∃ N ∃ T ∃ np ∃ n ∃ m ∃ k ∃ n0 ∃ l ∃ F ∃ C (w = ⟨ scons (ra_tys_ok G D) (scons (ra_tys_wf D n np l ⟨ kc_nz , ∅ ⟩ G2 T) (scons (ra_nst_ok G D n0 N) ∅)) , ra_ind_wf G D ⟩ ∧ ra_ind_data D b P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n m ∈ lrel ∧ ra_capp P G G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k l ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n n0 ∈ lrel)} $;
def cl_nst_ok_nil (.G .D .j .w: set): class =
  $ {w | ∃ G ∃ D ∃ j (w = ⟨ ∅ , ra_nst_ok G D j ⟨ kc_nil , ∅ ⟩ ⟩)} $;
def cl_nst_ok_cons (.G .D .I .j .j2 .npi .ni .mi .ni0 .X .N2 .N3 .NI .w: set): class =
  $ {w | ∃ G ∃ D ∃ I ∃ j ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (w = ⟨ scons (ra_ind_wf G I) (scons (ra_nst_ty G D I X) (scons (ra_nst_ok G D j2 N3) ∅)) , ra_nst_ok G D j ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ni0 ∈ lrel ∧ ra_nst_group G D I X j ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j ni0 j2 ∈ lrel)} $;
def cl_nst_ty_i (.G .G2 .D .I .b .bi_v .P .Pi .T .Ti .np .n .m .X .X1 .Fi .RI .S .Ci .w: set): class =
  $ {w | ∃ G ∃ G2 ∃ D ∃ I ∃ b ∃ bi_v ∃ P ∃ Pi ∃ T ∃ Ti ∃ np ∃ n ∃ m ∃ X ∃ X1 ∃ Fi ∃ RI ∃ S ∃ Ci (w = ⟨ scons (ra_sty G2 ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ RI X1 S) ∅ , ra_nst_ty G D I X ⟩ ∧ ra_ind_data D b P T ∈ lrel ∧ ra_capp P G G2 ∈ lrel ∧ ra_ind_arity D np n m ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n np X X1 ∈ lrel ∧ ra_closed np X1 ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty Ti ⟨ kc_nz , ∅ ⟩ Fi Ci ∈ lrel ∧ ra_pis Pi Fi RI ∈ lrel)} $;
def cl_large_nz (.G .D .b .P .T .F .C .k .l .w: set): class =
  $ {w | ∃ G ∃ D ∃ b ∃ P ∃ T ∃ F ∃ C ∃ k ∃ l (w = ⟨ ∅ , ra_large G D ⟩ ∧ ra_ind_data D b P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k l ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l ∅) ⟩ l)} $;
def cl_large_empty (.G .D .b .P .F .w: set): class =
  $ {w | ∃ G ∃ D ∃ b ∃ P ∃ F (w = ⟨ ∅ , ra_large G D ⟩ ∧ ra_ind_data D b P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel)} $;
def cl_large_single (.G .G2 .D .b .P .F .K .np .w: set): class =
  $ {w | ∃ G ∃ G2 ∃ D ∃ b ∃ P ∃ F ∃ K ∃ np (w = ⟨ scons (ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K) ∅ , ra_large G D ⟩ ∧ ra_ind_data D b P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G G2 ∈ lrel)} $;
def cl_fir_res (.D .np .Ctx .d .K .w: set): class =
  $ {w | ∃ D ∃ np ∃ Ctx ∃ d ∃ K (w = ⟨ ∅ , ra_fir D np Ctx d K ⟩ ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d K ⟨ kc_nz , ∅ ⟩ ∈ lrel)} $;
def cl_fir_arg (.D .np .Ctx .d .k .A .A2 .B .w: set): class =
  $ {w | ∃ D ∃ np ∃ Ctx ∃ d ∃ k ∃ A ∃ A2 ∃ B (w = ⟨ scons (ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ B) ∅ , ra_fir D np Ctx d ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d np k ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k A A2 ∈ lrel)} $;
def cl_fir_prop (J: class) (.D .np .Ctx .d .k .A .A2 .B .w: set): class =
  $ {w | ∃ D ∃ np ∃ Ctx ∃ d ∃ k ∃ A ∃ A2 ∃ B (w = ⟨ scons (ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ B) ∅ , ra_fir D np Ctx d ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟩ ∧ ra_add d np k ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J)} $;
def cl_elim_prop (.G .D .v .w: set): class =
  $ {w | ∃ G ∃ D ∃ v (w = ⟨ ∅ , ra_elim_ok G D v ⟩ ∧ lveq v ⟨ kc_lz , ∅ ⟩)} $;
def cl_elim_large (.G .D .v .w: set): class =
  $ {w | ∃ G ∃ D ∃ v (w = ⟨ scons (ra_large G D) ∅ , ra_elim_ok G D v ⟩)} $;
def cl_fprops_z (.D .n .np .Ctx .d .K .w: set): class =
