--| @rewrite
theorem enc_n7: $ enc_nat n7 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n8: $ enc_nat n8 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
