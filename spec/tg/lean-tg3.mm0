-- --------------------------------------------------------------------------
-- The program
-- --------------------------------------------------------------------------

--| Part II's definitions of expressions (the spec's, in prefix form).

--| The spec's definitions of terms, encoded. The normalizer keeps a definition
--| folded, so each has a rewrite `enc_D` from its encoding; a closed one with a
--| big tree (more than 16 constructors) is a def `tr_D`, which the trees
--| of the clauses below use.
def tr_nat_D: class = $ ⟨ kc_ind_mk , scons ⟨ kc_nat_blk , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_tcons , scons ⟨ kc_srt , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_pi , scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ⟩ $;
def tr_iff_D: class = $ ⟨ kc_ind_mk , scons ⟨ kc_iff_blk , ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_tcons , scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_pi , scons ⟨ kc_pi , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_pi , scons ⟨ kc_pi , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ⟩ $;
def tr_nat_ty: class = $ ⟨ kc_ind_ty , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ $;
def tr_nat_zero: class = $ ⟨ kc_ind_ctor , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ $;
def tr_nat_succ: class = $ ⟨ kc_ind_ctor , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅)) ⟩ $;
def tr_le_D: class = $ ⟨ kc_ind_mk , scons ⟨ kc_le_blk , ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_ind_ty , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tcons , scons ⟨ kc_pi , scons ⟨ kc_ind_ty , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_pi , scons ⟨ kc_ind_ty , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_pi , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_ind_ctor , scons tr_nat_D (scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅)) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ⟩ $;
--| @rewrite
theorem enc_n1: $ enc_nat n1 ≐ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n2: $ enc_nat n2 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n3: $ enc_nat n3 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n4: $ enc_nat n4 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n5: $ enc_nat n5 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n6: $ enc_nat n6 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n7: $ enc_nat n7 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n8: $ enc_nat n8 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_n9: $ enc_nat n9 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_Prop: $ enc_expr Prop ≐ ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_lit0: $ enc_expr lit0 ≐ ⟨ kc_lit , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_lit1: $ enc_expr lit1 ≐ ⟨ kc_lit , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_lit2: $ enc_expr lit2 ≐ ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_nat_D: $ enc_ind nat_D ≐ tr_nat_D $;
--| @rewrite
theorem enc_eq_D (u: lvl): $ enc_ind (eq_D u) ≐ ⟨ kc_ind_mk , scons ⟨ kc_eq_blk , ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_tcons , scons ⟨ kc_pi , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ⟩ $;
--| @rewrite
theorem enc_iff_D: $ enc_ind iff_D ≐ tr_iff_D $;
--| @rewrite
theorem enc_propext: $ enc_expr propext ≐ ⟨ kc_cst , scons ⟨ kc_propext_atom , ∅ ⟩ (scons ⟨ kc_lnil , ∅ ⟩ ∅) ⟩ $;
--| @rewrite
theorem enc_quot_sound (u: lvl): $ enc_expr (quot_sound u) ≐ ⟨ kc_cst , scons ⟨ kc_quot_sound_atom , ∅ ⟩ (scons ⟨ kc_lcons , scons (enc_lvl u) (scons ⟨ kc_lnil , ∅ ⟩ ∅) ⟩ ∅) ⟩ $;
--| @rewrite
theorem enc_nonempty_D (u: lvl): $ enc_ind (nonempty_D u) ≐ ⟨ kc_ind_mk , scons ⟨ kc_nonempty_blk , ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tcons , scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_pi , scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ⟩ $;
--| @rewrite
theorem enc_choice (u: lvl): $ enc_expr (choice u) ≐ ⟨ kc_cst , scons ⟨ kc_choice_atom , ∅ ⟩ (scons ⟨ kc_lcons , scons (enc_lvl u) (scons ⟨ kc_lnil , ∅ ⟩ ∅) ⟩ ∅) ⟩ $;
--| @rewrite
theorem enc_nat_ty: $ enc_expr nat_ty ≐ tr_nat_ty $;
--| @rewrite
theorem enc_nat_zero: $ enc_expr nat_zero ≐ tr_nat_zero $;
--| @rewrite
theorem enc_nat_succ: $ enc_expr nat_succ ≐ tr_nat_succ $;
--| @rewrite
theorem enc_le_D: $ enc_ind le_D ≐ tr_le_D $;
--| @rewrite
theorem enc_nat_eq (x y: expr): $ enc_expr (nat_eq x y) ≐ ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_ind_ty , scons ⟨ kc_ind_mk , scons ⟨ kc_eq_blk , ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_srt , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_tcons , scons ⟨ kc_pi , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ (scons tr_nat_ty ∅) ⟩ (scons (enc_expr x) ∅) ⟩ (scons (enc_expr y) ∅) ⟩ $;
--| @rewrite
theorem enc_nat_lt (x y: expr): $ enc_expr (nat_lt x y) ≐ ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_ind_ty , scons tr_le_D (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons (enc_expr x) ∅) ⟩ ∅) ⟩ (scons (enc_expr y) ∅) ⟩ $;

--| The ground instances of each clause axiom: ⟨ premises , conclusion ⟩, with
--| its side conditions (and `J` when one of them is a judgment); a wide clause's
--| at given classes first.
def cl_sty_nil (.G .h .A .w: set): class =
  $ {w | ∃ G ∃ h ∃ A (w = ⟨ ∅ , ra_sty G h A h A ⟩)} $;
def cl_sty_app (J: class) (.G .h .A .f .a .B .C .C2 .w: set): class =
  $ {w | ∃ G ∃ h ∃ A ∃ f ∃ a ∃ B ∃ C ∃ C2 (w = ⟨ scons (ra_sty G h A f ⟨ kc_pi , scons B (scons C ∅) ⟩) ∅ , ra_sty G h A ⟨ kc_app , scons f (scons a ∅) ⟩ C2 ⟩ ∧ ra_deq G a a B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a C2 ∈ lrel)} $;
def cl_cwf_pi (J: class) (.D .n .np .l .i .Ctx .d .k .A .B .A2 .u .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx ∃ d ∃ k ∃ A ∃ B ∃ A2 ∃ u (w = ⟨ scons (ra_cwf D n np l i ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ B) ∅ , ra_cwf D n np l i Ctx d ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟩ ∧ ra_add d np k ∈ lrel ∧ ra_closed k A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n k A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u ∅ ⟩ ∈ J ∧ ra_ulevel l u ∈ lrel2)} $;
def cl_cwf_pi_rec (J: class) (.D .n .np .l .i .Ctx .d .k .A .B .A2 .B2 .u .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx ∃ d ∃ k ∃ A ∃ B ∃ A2 ∃ B2 ∃ u (w = ⟨ scons (ra_cwf D n np l i ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ B) ∅ , ra_cwf D n np l i Ctx d ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟩ ∧ ra_add d np k ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n k A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u ∅ ⟩ ∈ J ∧ ra_ulevel l u ∈ lrel2 ∧ ra_ipos D n np d A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel)} $;
def cl_cwf_res (.D .n .np .l .i .Ctx .d .k .K .K2 .b .P .T .F .C .R .R2 .S .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx ∃ d ∃ k ∃ K ∃ K2 ∃ b ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (w = ⟨ scons (ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i ∅) ⟩ R2 K2 S) ∅ , ra_cwf D n np l i Ctx d K ⟩ ∧ ra_indapp D n np d K i ∈ lrel ∧ ra_add d np k ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n k K K2 ∈ lrel ∧ ra_ind_data D b P T ∈ lrel ∧ ra_nth_ty T i F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel)} $;
def cl_ctors_wf_nil (.D .n .np .l .i .Ctx .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx (w = ⟨ ∅ , ra_ctors_wf D n np l i Ctx ⟨ kc_cnil , ∅ ⟩ ⟩)} $;
def cl_ctors_wf_cons (.D .n .np .l .i .Ctx .K .C .b .P .T .R .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx ∃ K ∃ C ∃ b ∃ P ∃ T ∃ R (w = ⟨ scons (ra_cwf D n np l i Ctx ⟨ kc_nz , ∅ ⟩ K) (scons (ra_ctors_wf D n np l i Ctx C) ∅) , ra_ctors_wf D n np l i Ctx ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟩ ∧ ra_ind_data D b P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n R ∈ lrel)} $;
def cl_tys_wf_nil (.D .n .np .l .i .Ctx .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ i ∃ Ctx (w = ⟨ ∅ , ra_tys_wf D n np l i Ctx ⟨ kc_tnil , ∅ ⟩ ⟩)} $;
def cl_tys_wf_cons (.D .n .np .l .l2 .i .k .Ctx .F .C .T .w: set): class =
  $ {w | ∃ D ∃ n ∃ np ∃ l ∃ l2 ∃ i ∃ k ∃ Ctx ∃ F ∃ C ∃ T (w = ⟨ scons (ra_ctors_wf D n np l i Ctx C) (scons (ra_tys_wf D n np l ⟨ kc_s , scons i ∅ ⟩ Ctx T) ∅) , ra_tys_wf D n np l i Ctx ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟩ ∧ ra_isort F k l2 ∈ lrel ∧ lveq l2 l)} $;
def cl_ctx_wf_nil (.G .w: set): class =
  $ {w | ∃ G (w = ⟨ ∅ , ra_ctx_wf G ⟨ kc_nil , ∅ ⟩ ⟩)} $;
def cl_ctx_wf_cons (J: class) (.G .P .G2 .A .u .w: set): class =
