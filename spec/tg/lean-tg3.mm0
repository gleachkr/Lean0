  $ G ⇒ ra_deq A1 A7 A7 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_ind_ty , scons ⟨ kc_ind_mk , scons ⟨ kc_eq_blk , ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_srt , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_tcons , scons ⟨ kc_pi , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ (scons tr_nat_ty ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons A2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons A6 (scons ⟨ kc_app , scons ⟨ kc_app , scons A6 (scons ⟨ kc_app , scons ⟨ kc_app , scons A2 (scons ⟨ kc_app , scons ⟨ kc_app , scons A3 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons A3 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons A2 (scons ⟨ kc_app , scons ⟨ kc_app , scons A3 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons A3 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons A4 (scons ⟨ kc_app , scons ⟨ kc_app , scons A6 (scons ⟨ kc_app , scons ⟨ kc_app , scons A4 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons A4 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∈ J $ >
  $ G ⇒ ra_xor_eqs A1 A2 A3 A4 A5 A6 ∈ lrel3 J $;

--| The clause axioms, at every `J` (in prefix form; the wide ones after).
theorem sty_nil_j (J: class) (G: ctx) (h A: expr): $ sty_j J G h A h A $;
theorem sty_app_j (J: class) (G: ctx) (h A f a B C C2: expr): $ sty_j J G h A f (pi B C) $ > $ ty_j J G a B $ > $ inst nz C a C2 $ > $ sty_j J G h A (app f a) C2 $;
theorem cwf_pi_j (J: class) (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2: expr) (u: lvl): $ add d np k $ > $ closed k A $ > $ sinst D nz n k A A2 $ > $ ty_j J Ctx A2 (srt u) $ > $ ulevel l u $ > $ cwf_j J D n np l i (cons A2 Ctx) (s d) B $ > $ cwf_j J D n np l i Ctx d (pi A B) $;
theorem cwf_pi_rec_j (J: class) (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2 B2: expr) (u: lvl): $ add d np k $ > $ sinst D nz n k A A2 $ > $ ty_j J Ctx A2 (srt u) $ > $ ulevel l u $ > $ ipos D n np d A $ > $ inst nz B (srt lz) B2 $ > $ lift n1 nz B2 B $ > $ cwf_j J D n np l i (cons A2 Ctx) (s d) B $ > $ cwf_j J D n np l i Ctx d (pi A B) $;
theorem cwf_res_j (J: class) (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (K K2: expr) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (R R2 S: expr): $ indapp D n np d K i $ > $ add d np k $ > $ sinst D nz n k K K2 $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ pis P F R $ > $ lift k nz R R2 $ > $ sty_j J Ctx (ind_ty D i) R2 K2 S $ > $ cwf_j J D n np l i Ctx d K $;
theorem ctors_wf_nil_j (J: class) (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ ctors_wf_j J D n np l i Ctx cnil $;
theorem ctors_wf_cons_j (J: class) (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (K: expr) (C: ctors) (b: blk) (P: ctx) (T: tys) (R: expr): $ ind_data D b P T $ > $ pis P K R $ > $ closed n R $ > $ cwf_j J D n np l i Ctx nz K $ > $ ctors_wf_j J D n np l i Ctx C $ > $ ctors_wf_j J D n np l i Ctx (ccons K C) $;
theorem tys_wf_nil_j (J: class) (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ tys_wf_j J D n np l i Ctx tnil $;
theorem tys_wf_cons_j (J: class) (D: ind) (n np: nat) (l l2: lvl) (i k: nat) (Ctx: ctx) (F: expr) (C: ctors) (T: tys): $ isort F k l2 $ > $ leqv l2 l $ > $ ctors_wf_j J D n np l i Ctx C $ > $ tys_wf_j J D n np l (s i) Ctx T $ > $ tys_wf_j J D n np l i Ctx (tcons F C T) $;
theorem ctx_wf_nil_j (J: class) (G: ctx): $ ctx_wf_j J G nil $;
theorem ctx_wf_cons_j (J: class) (G P G2: ctx) (A: expr) (u: lvl): $ ctx_wf_j J G P $ > $ capp P G G2 $ > $ ty_j J G2 A (srt u) $ > $ ctx_wf_j J G (cons A P) $;
theorem tys_ty_nil_j (J: class) (Ctx: ctx): $ tys_ty_j J Ctx tnil $;
theorem tys_ty_cons_j (J: class) (Ctx: ctx) (F: expr) (C: ctors) (T: tys) (u l: lvl) (k: nat): $ isort F k l $ > $ ty_j J Ctx F (srt u) $ > $ tys_ty_j J Ctx T $ > $ tys_ty_j J Ctx (tcons F C T) $;
theorem tys_ok_i_j (J: class) (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys): $ ind_data D b P T $ > $ tys_closed P T $ > $ ctx_wf_j J G P $ > $ capp P G G2 $ > $ tys_ty_j J G2 T $ > $ tys_ok_j J G D $;
theorem ind_wf_i_j (J: class) (G G2: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (np n m k n0: nat) (l: lvl) (F: expr) (C: ctors): $ tys_ok_j J G D $ > $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ capp P G G2 $ > $ nth_ty T nz F C $ > $ isort F k l $ > $ tys_wf_j J D n np l nz G2 T $ > $ ind_nested D N $ > $ ndecl N n n0 $ > $ nst_ok_j J G D n0 N $ > $ ind_wf_j J G D $;
theorem nst_ok_nil_j (J: class) (G: ctx) (D: ind) (j: nat): $ nst_ok_j J G D j nil $;
theorem nst_ok_cons_j (J: class) (G: ctx) (D I: ind) (j j2 npi ni mi ni0: nat) (X: expr) (N2 N3 NI: ctx): $ spine (ind_ty I nz) X npi $ > $ ind_wf_j J G I $ > $ ind_arity I npi ni mi $ > $ ind_nested I NI $ > $ ndecl NI ni ni0 $ > $ lt nz ni0 $ > $ nst_ty_j J G D I X $ > $ nst_group G D I X j nz ni0 (cons X N2) N3 $ > $ add j ni0 j2 $ > $ nst_ok_j J G D j2 N3 $ > $ nst_ok_j J G D j (cons X N2) $;
theorem nst_ty_i_j (J: class) (G G2: ctx) (D I: ind) (b bi_v: blk) (P Pi: ctx) (T Ti: tys) (np n m: nat) (X X1 Fi RI S: expr) (Ci: ctors): $ ind_data D b P T $ > $ capp P G G2 $ > $ ind_arity D np n m $ > $ sinst D nz n np X X1 $ > $ closed np X1 $ > $ ind_data I bi_v Pi Ti $ > $ nth_ty Ti nz Fi Ci $ > $ pis Pi Fi RI $ > $ sty_j J G2 (ind_ty I nz) RI X1 S $ > $ nst_ty_j J G D I X $;
theorem large_nz_j (J: class) (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (k: nat) (l: lvl): $ ind_data D b P T $ > $ nth_ty T nz F C $ > $ isort F k l $ > $ leqv (lmax (ls lz) l) l $ > $ large_j J G D $;
theorem large_empty_j (J: class) (G: ctx) (D: ind) (b: blk) (P: ctx) (F: expr): $ ind_data D b P (tcons F cnil tnil) $ > $ large_j J G D $;
theorem large_single_j (J: class) (G G2: ctx) (D: ind) (b: blk) (P: ctx) (F K: expr) (np: nat): $ ind_data D b P (tcons F (ccons K cnil) tnil) $ > $ clen P np $ > $ capp P G G2 $ > $ fir_j J D np G2 nz K $ > $ large_j J G D $;
theorem fir_res_j (J: class) (D: ind) (np: nat) (Ctx: ctx) (d: nat) (K: expr): $ indapp D n1 np d K nz $ > $ fir_j J D np Ctx d K $;
theorem fir_arg_j (J: class) (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr): $ leaf_has nz B $ > $ add d np k $ > $ sinst D nz n1 k A A2 $ > $ fir_j J D np (cons A2 Ctx) (s d) B $ > $ fir_j J D np Ctx d (pi A B) $;
theorem fir_prop_j (J: class) (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr): $ add d np k $ > $ sinst D nz n1 k A A2 $ > $ ty_j J Ctx A2 Prop $ > $ fir_j J D np (cons A2 Ctx) (s d) B $ > $ fir_j J D np Ctx d (pi A B) $;
theorem elim_prop_j (J: class) (G: ctx) (D: ind) (v: lvl): $ leqv v lz $ > $ elim_ok_j J G D v $;
theorem elim_large_j (J: class) (G: ctx) (D: ind) (v: lvl): $ large_j J G D $ > $ elim_ok_j J G D v $;
theorem fprops_z_j (J: class) (D: ind) (n np: nat) (Ctx: ctx) (d: nat) (K: expr): $ fprops_j J D n np Ctx d nz K $;
theorem fprops_s_j (J: class) (D: ind) (n np: nat) (Ctx: ctx) (d cnt k: nat) (A A2 B: expr): $ add d np k $ > $ sinst D nz n k A A2 $ > $ ty_j J Ctx A2 Prop $ > $ fprops_j J D n np (cons A2 Ctx) (s d) cnt B $ > $ fprops_j J D n np Ctx d (s cnt) (pi A B) $;
theorem proj_ok_sort_j (J: class) (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i: nat) (F: expr) (C: ctors) (l: lvl): $ ind_data D b P T $ > $ nth_ty T j F C $ > $ isort F nz l $ > $ leqv (lmax (ls lz) l) l $ > $ proj_ok_j J G D j i $;
theorem proj_ok_prop_j (J: class) (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K: expr) (C: ctors): $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ capp P G G2 $ > $ nth_ty T j F C $ > $ nth_ctor C nz K $ > $ fprops_j J D n np G2 nz (s i) K $ > $ proj_ok_j J G D j i $;
theorem add_eqs_i_j (J: class) (G: ctx) (f: expr): $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app nat_succ (app (app f (bvar n1)) (bvar nz))) nat_ty $ > $ add_eqs_j J G f $;
theorem pred_eqs_i_j (J: class) (G: ctx) (p: expr): $ closed nz p $ > $ ty_j J G p (pi nat_ty nat_ty) $ > $ deq_j J G (app p nat_zero) nat_zero nat_ty $ > $ deq_j J (cons nat_ty G) (app p (app nat_succ (bvar nz))) (bvar nz) nat_ty $ > $ pred_eqs_j J G p $;
theorem sub_eqs_i_j (J: class) (G: ctx) (f p: expr): $ pred_eqs_j J G p $ > $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app p (app (app f (bvar n1)) (bvar nz))) nat_ty $ > $ sub_eqs_j J G f p $;
theorem mul_eqs_i_j (J: class) (G: ctx) (f fa: expr): $ add_eqs_j J G fa $ > $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) nat_zero nat_ty $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fa (app (app f (bvar n1)) (bvar nz))) (bvar n1)) nat_ty $ > $ mul_eqs_j J G f fa $;
theorem pow_eqs_i_j (J: class) (G: ctx) (f fm fa: expr): $ mul_eqs_j J G fm fa $ > $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (app nat_succ nat_zero) nat_ty $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fm (app (app f (bvar n1)) (bvar nz))) (bvar n1)) nat_ty $ > $ pow_eqs_j J G f fm fa $;
theorem beq_eqs_i_j (J: class) (G: ctx) (f B t u: expr): $ closed nz f $ > $ closed nz B $ > $ closed nz t $ > $ closed nz u $ > $ ty_j J G f (pi nat_ty (pi nat_ty B)) $ > $ deq_j J G (app (app f nat_zero) nat_zero) t B $ > $ deq_j J (cons nat_ty G) (app (app f nat_zero) (app nat_succ (bvar nz))) u B $ > $ deq_j J (cons nat_ty G) (app (app f (app nat_succ (bvar nz))) nat_zero) u B $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (app nat_succ (bvar n1))) (app nat_succ (bvar nz))) (app (app f (bvar n1)) (bvar nz)) B $ > $ beq_eqs_j J G f B t u $;
theorem ble_eqs_i_j (J: class) (G: ctx) (f B t u: expr): $ closed nz f $ > $ closed nz B $ > $ closed nz t $ > $ closed nz u $ > $ ty_j J G f (pi nat_ty (pi nat_ty B)) $ > $ deq_j J (cons nat_ty G) (app (app f nat_zero) (bvar nz)) t B $ > $ deq_j J (cons nat_ty G) (app (app f (app nat_succ (bvar nz))) nat_zero) u B $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (app nat_succ (bvar n1))) (app nat_succ (bvar nz))) (app (app f (bvar n1)) (bvar nz)) B $ > $ ble_eqs_j J G f B t u $;
theorem shl_eqs_i_j (J: class) (G: ctx) (f fm fa: expr): $ mul_eqs_j J G fm fa $ > $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app f (app (app fm (lit (bd0 (bd1 b0)))) (bvar n1))) (bvar nz)) nat_ty $ > $ shl_eqs_j J G f fm fa $;
theorem shr_eqs_i_j (J: class) (G: ctx) (f fd: expr): $ closed nz f $ > $ closed nz fd $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fd (app (app f (bvar n1)) (bvar nz))) (lit (bd0 (bd1 b0)))) nat_ty $ > $ shr_eqs_j J G f fd $;
theorem divmod_eqs_i_j (J: class) (G: ctx) (fd fm fmul fadd h1 h2 h3: expr): $ mul_eqs_j J G fmul fadd $ > $ closed nz fd $ > $ closed nz fm $ > $ ty_j J G fd (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty_j J G fm (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty_j J G h1 (pi nat_ty (pi nat_ty (nat_eq (app (app fadd (app (app fmul (bvar nz)) (app (app fd (bvar n1)) (bvar nz)))) (app (app fm (bvar n1)) (bvar nz))) (bvar n1)))) $ > $ ty_j J G h2 (pi nat_ty (pi nat_ty (pi (nat_lt lit0 (bvar nz)) (nat_lt (app (app fm (bvar n2)) (bvar n1)) (bvar n1))))) $ > $ ty_j J G h3 (pi nat_ty (nat_eq (app (app fd (bvar nz)) lit0) lit0)) $ > $ divmod_eqs_j J G fd fm fmul fadd $;
theorem gcd_eqs_i_j (J: class) (G: ctx) (f fd fm fmul fadd h1 h2: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty_j J G h1 (pi nat_ty (nat_eq (app (app f lit0) (bvar nz)) (bvar nz))) $ > $ ty_j J G h2 (pi nat_ty (pi nat_ty (nat_eq (app (app f (app nat_succ (bvar n1))) (bvar nz)) (app (app f (app (app fm (bvar nz)) (app nat_succ (bvar n1)))) (app nat_succ (bvar n1)))))) $ > $ gcd_eqs_j J G f fd fm fmul fadd $;
theorem land_eqs_i_j (J: class) (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty_j J G h (pi nat_ty (pi nat_ty (nat_eq (app (app f (bvar n1)) (bvar nz)) (app (app fadd (app (app fadd (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2))) (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2)))) (app (app fd (app (app fadd (app (app fm (bvar n1)) lit2)) (app (app fm (bvar nz)) lit2))) lit2))))) $ > $ land_eqs_j J G f fd fm fmul fadd $;
theorem lor_eqs_i_j (J: class) (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty_j J G h (pi nat_ty (pi nat_ty (nat_eq (app (app f (bvar n1)) (bvar nz)) (app (app fadd (app (app fadd (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2))) (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2)))) (app (app fd (app (app fadd (app (app fadd (app (app fm (bvar n1)) lit2)) (app (app fm (bvar nz)) lit2))) lit1)) lit2))))) $ > $ lor_eqs_j J G f fd fm fmul fadd $;
theorem xor_eqs_i_j (J: class) (G: ctx) (f fd fm fmul fadd h: expr): $ divmod_eqs_j J G fd fm fmul fadd $ > $ closed nz f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $ > $ ty_j J G h (pi nat_ty (pi nat_ty (nat_eq (app (app f (bvar n1)) (bvar nz)) (app (app fadd (app (app fadd (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2))) (app (app f (app (app fd (bvar n1)) lit2)) (app (app fd (bvar nz)) lit2)))) (app (app fm (app (app fadd (app (app fm (bvar n1)) lit2)) (app (app fm (bvar nz)) lit2))) lit2))))) $ > $ xor_eqs_j J G f fd fm fmul fadd $;

--| The program's clauses that conclude an atom of a relation are that relation's.
theorem lprog3_sty_pr (G: hyps) (J P A1 A2 A3 A4 A5: class):
  $ G ⇒ ⟨ P , ra_sty A1 A2 A3 A4 A5 ⟩ ∈ lprog3 J $ > $ G ⇒ ⟨ P , ra_sty A1 A2 A3 A4 A5 ⟩ ∈ pr_sty J $;
