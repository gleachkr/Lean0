theorem enc_Prop: $ enc_expr Prop ≐ ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_lit0: $ enc_expr lit0 ≐ ⟨ kc_lit , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $;
--| @rewrite
theorem enc_lit1: $ enc_expr lit1 ≐ ⟨ kc_lit , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ $;
--| @rewrite
