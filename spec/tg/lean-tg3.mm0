-- --------------------------------------------------------------------------
-- Congruence in `J`, substitution through it
-- --------------------------------------------------------------------------

--| The defs that take the judgment atoms `J` (a wide clause's instances `gi_A`
--| in their other classes too): congruence (`D_congr`, for rewriting) and
--| substitution through them (`sb_c_D`, for the normalizer); then `lrel3_eq`.
--| @congr
theorem cl_sty_app_congr (J J2: class): $ J ≐ J2 $ > $ cl_sty_app J ≐ cl_sty_app J2 $;
--| @rewrite
theorem sb_c_cl_sty_app {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (cl_sty_app J)) ≐ cl_sty_app (⟦ x / t ⟧ J) $;
--| @congr
theorem cl_cwf_pi_congr (J J2: class): $ J ≐ J2 $ > $ cl_cwf_pi J ≐ cl_cwf_pi J2 $;
--| @rewrite
theorem sb_c_cl_cwf_pi {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (cl_cwf_pi J)) ≐ cl_cwf_pi (⟦ x / t ⟧ J) $;
--| @congr
theorem cl_cwf_pi_rec_congr (J J2: class): $ J ≐ J2 $ > $ cl_cwf_pi_rec J ≐ cl_cwf_pi_rec J2 $;
--| @rewrite
theorem sb_c_cl_cwf_pi_rec {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (cl_cwf_pi_rec J)) ≐ cl_cwf_pi_rec (⟦ x / t ⟧ J) $;
--| @congr
theorem cl_ctx_wf_cons_congr (J J2: class): $ J ≐ J2 $ > $ cl_ctx_wf_cons J ≐ cl_ctx_wf_cons J2 $;
--| @rewrite
theorem sb_c_cl_ctx_wf_cons {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (cl_ctx_wf_cons J)) ≐ cl_ctx_wf_cons (⟦ x / t ⟧ J) $;
--| @congr
theorem cl_tys_ty_cons_congr (J J2: class): $ J ≐ J2 $ > $ cl_tys_ty_cons J ≐ cl_tys_ty_cons J2 $;
--| @rewrite
theorem sb_c_cl_tys_ty_cons {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (cl_tys_ty_cons J)) ≐ cl_tys_ty_cons (⟦ x / t ⟧ J) $;
--| @congr
theorem cl_fir_prop_congr (J J2: class): $ J ≐ J2 $ > $ cl_fir_prop J ≐ cl_fir_prop J2 $;
--| @rewrite
theorem sb_c_cl_fir_prop {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (cl_fir_prop J)) ≐ cl_fir_prop (⟦ x / t ⟧ J) $;
--| @congr
theorem cl_fprops_s_congr (J J2: class): $ J ≐ J2 $ > $ cl_fprops_s J ≐ cl_fprops_s J2 $;
--| @rewrite
theorem sb_c_cl_fprops_s {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (cl_fprops_s J)) ≐ cl_fprops_s (⟦ x / t ⟧ J) $;
--| @congr
theorem cl_add_eqs_i_congr (J J2: class): $ J ≐ J2 $ > $ cl_add_eqs_i J ≐ cl_add_eqs_i J2 $;
--| @rewrite
theorem sb_c_cl_add_eqs_i {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (cl_add_eqs_i J)) ≐ cl_add_eqs_i (⟦ x / t ⟧ J) $;
--| @congr
