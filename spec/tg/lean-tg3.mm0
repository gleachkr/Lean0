--| @congr
theorem ra_deq_congr (A1 B1 A2 B2 A3 B3 A4 B4: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ ra_deq A1 A2 A3 A4 ≐ ra_deq B1 B2 B3 B4 $;
theorem ra_deq_eq (G: hyps) (A1 B1 A2 B2 A3 B3 A4 B4: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ > $ G ⇒ ra_deq A1 A2 A3 A4 = ra_deq B1 B2 B3 B4 $;
--| @rewrite
theorem sb_c_ra_deq {x: set} (t: set x) (A1 A2 A3 A4: class x): $ (⟦ x / t ⟧ (ra_deq A1 A2 A3 A4)) ≐ ra_deq (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) $;
--| @congr
theorem ra_sty_congr (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ > $ ra_sty A1 A2 A3 A4 A5 ≐ ra_sty B1 B2 B3 B4 B5 $;
theorem ra_sty_eq (G: hyps) (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ > $ G ⇒ A5 = B5 $ > $ G ⇒ ra_sty A1 A2 A3 A4 A5 = ra_sty B1 B2 B3 B4 B5 $;
--| @rewrite
theorem sb_c_ra_sty {x: set} (t: set x) (A1 A2 A3 A4 A5: class x): $ (⟦ x / t ⟧ (ra_sty A1 A2 A3 A4 A5)) ≐ ra_sty (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) $;
--| @congr
theorem ra_cwf_congr (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6 A7 B7 A8 B8: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ > $ A6 ≐ B6 $ > $ A7 ≐ B7 $ > $ A8 ≐ B8 $ > $ ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ≐ ra_cwf B1 B2 B3 B4 B5 B6 B7 B8 $;
theorem ra_cwf_eq (G: hyps) (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6 A7 B7 A8 B8: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ > $ G ⇒ A5 = B5 $ > $ G ⇒ A6 = B6 $ > $ G ⇒ A7 = B7 $ > $ G ⇒ A8 = B8 $ > $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 = ra_cwf B1 B2 B3 B4 B5 B6 B7 B8 $;
--| @rewrite
theorem sb_c_ra_cwf {x: set} (t: set x) (A1 A2 A3 A4 A5 A6 A7 A8: class x): $ (⟦ x / t ⟧ (ra_cwf A1 A2 A3 A4 A5 A6 A7 A8)) ≐ ra_cwf (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) (⟦ x / t ⟧ A6) (⟦ x / t ⟧ A7) (⟦ x / t ⟧ A8) $;
--| @congr
theorem ra_ctors_wf_congr (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6 A7 B7: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ > $ A6 ≐ B6 $ > $ A7 ≐ B7 $ > $ ra_ctors_wf A1 A2 A3 A4 A5 A6 A7 ≐ ra_ctors_wf B1 B2 B3 B4 B5 B6 B7 $;
theorem ra_ctors_wf_eq (G: hyps) (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6 A7 B7: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ > $ G ⇒ A5 = B5 $ > $ G ⇒ A6 = B6 $ > $ G ⇒ A7 = B7 $ > $ G ⇒ ra_ctors_wf A1 A2 A3 A4 A5 A6 A7 = ra_ctors_wf B1 B2 B3 B4 B5 B6 B7 $;
