def dec_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr) (a6: expr) (a7: expr) (a8: expr) (a9: expr) (a10: expr) (a11: expr): wff = $ _ ⇒ ra_dec_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) (enc_expr a6) (enc_expr a7) (enc_expr a8) (enc_expr a9) (enc_expr a10) (enc_expr a11) ∈ lrel3 J $;
def ite_eqs_j (J: class) (a1: ctx) (a2: expr) (a3: expr) (a4: expr) (a5: expr) (a6: expr) (a7: expr): wff = $ _ ⇒ ra_ite_eqs (enc_ctx a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) (enc_expr a5) (enc_expr a6) (enc_expr a7) ∈ lrel3 J $;
