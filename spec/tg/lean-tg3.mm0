--| Inversion: a derivable atom of a relation is the conclusion of one of its
--| clauses, at sets, with the clause's premises derivable and its side
--| conditions true (as in lean-tg.mm0; a wide clause's at the arguments).
theorem lrel3_sty_cases (G: hyps) (J: class) {G_v h_v A f_v a_v B C C2: set} (t1 t2 t3 t4 t5: set):
  $ G ⇒ ra_sty t1 t2 t3 t4 t5 ∈ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨
      ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $;
theorem lrel3_cwf_cases (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v A B A2 u_v B2 K K2 b_v P T F C R R2 S: set} (t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨
      ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨
      ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $;
theorem lrel3_ctors_wf_cases (G: hyps) (J: class) {D n_v np l_v i_v Ctx K C b_v P T R: set} (t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ∈ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) ∨
      ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C ∃ b_v ∃ P ∃ T ∃ R (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n_v R ∈ lrel ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $;
theorem lrel3_tys_wf_cases (G: hyps) (J: class) {D n_v np l_v i_v Ctx l2 k_v F C T: set} (t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ∈ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) ∨
      ∃ D ∃ n_v ∃ np ∃ l_v ∃ l2 ∃ i_v ∃ k_v ∃ Ctx ∃ F ∃ C ∃ T (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_isort F k_v l2 ∈ lrel ∧ lveq l2 l_v ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J ∧ ra_tys_wf D n_v np l_v ⟨ kc_s , scons i_v ∅ ⟩ Ctx T ∈ lrel3 J) $;
theorem lrel3_ctx_wf_cases (G: hyps) (J: class) {G_v P G2 A u_v: set} (t1 t2: set):
  $ G ⇒ ra_ctx_wf t1 t2 ∈ lrel3 J $ >
  $ G ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨
      ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $;
theorem lrel3_tys_ty_cases (G: hyps) (J: class) {Ctx F C T u_v l_v k_v: set} (t1 t2: set):
  $ G ⇒ ra_tys_ty t1 t2 ∈ lrel3 J $ >
  $ G ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨
      ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v ∃ l_v ∃ k_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $;
theorem lrel3_tys_ok_cases (G: hyps) (J: class) {G_v G2 D b_v P T: set} (t1 t2: set):
  $ G ⇒ ra_tys_ok t1 t2 ∈ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $;
theorem lrel3_ind_wf_cases (G: hyps) (J: class) {G_v G2 D b_v P N T np n_v m_v k_v n0 l_v F C: set} (t1 t2: set):
  $ G ⇒ ra_ind_wf t1 t2 ∈ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $;
theorem lrel3_nst_ok_cases (G: hyps) (J: class) {G_v D j_v I j2 npi ni mi ni0 X N2 N3 NI: set} (t1 t2 t3 t4: set):
  $ G ⇒ ra_nst_ok t1 t2 t3 t4 ∈ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨
