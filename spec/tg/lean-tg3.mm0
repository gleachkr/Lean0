--| @rewrite
theorem enc_nat_D: $ enc_ind nat_D ≐ tr_nat_D $;
--| @rewrite
theorem enc_eq_D (u: lvl): $ enc_ind (eq_D u) ≐ ⟨ kc_ind_mk , scons ⟨ kc_eq_blk , ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (scons ⟨ kc_cons , scons ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_tcons , scons ⟨ kc_pi , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_ccons , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∅)) ⟩ $;
--| @rewrite
theorem enc_nat_ty: $ enc_expr nat_ty ≐ tr_nat_ty $;
--| @rewrite
theorem enc_nat_zero: $ enc_expr nat_zero ≐ tr_nat_zero $;
--| @rewrite
theorem enc_nat_succ: $ enc_expr nat_succ ≐ tr_nat_succ $;
--| @rewrite
theorem enc_fix_fty (al motive hm ltN: expr): $ enc_expr (fix_fty al motive hm ltN) ≐ ⟨ kc_pi , scons (enc_expr al) (scons ⟨ kc_pi , scons ⟨ kc_pi , scons (enc_expr al) (scons ⟨ kc_pi , scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr ltN) (scons ⟨ kc_app , scons (enc_expr hm) (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons (enc_expr hm) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons (enc_expr motive) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons (enc_expr motive) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ $;

