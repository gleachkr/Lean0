theorem fix_eqs_i_j (J: class) (G: ctx) (ite bp bd beq fix go eager al motive hm ltN pfx pfgo: expr): $ closed nz ite $ > $ closed nz bp $ > $ closed nz bd $ > $ closed nz beq $ > $ closed nz fix $ > $ closed nz go $ > $ closed nz eager $ > $ closed nz al $ > $ closed nz motive $ > $ closed nz hm $ > $ closed nz ltN $ > $ closed nz pfx $ > $ closed nz pfgo $ > $ ty_j J G ltN (pi nat_ty (pi nat_ty Prop)) $ > $ ty_j J G (app (app (app go al) motive) hm) (pi (fix_fty al motive hm ltN) (pi nat_ty (pi al (pi (app (app ltN (app hm (bvar nz))) (bvar n1)) (app motive (bvar n1)))))) $ > $ ty_j J G pfx (pi al (app (app ltN (app hm (bvar nz))) (app eager (app nat_succ (app hm (bvar nz)))))) $ > $ ty_j J G pfgo (pi nat_ty (pi al (pi (app (app ltN (app hm (bvar nz))) (app nat_succ (bvar n1))) (pi al (pi (app (app ltN (app hm (bvar nz))) (app hm (bvar n2))) (app (app ltN (app hm (bvar n1))) (bvar n4))))))) $ > $ deq_j J (cons al (cons (fix_fty al motive hm ltN) G)) (app (app (app (app (app fix al) motive) hm) (bvar n1)) (bvar nz)) (app (app (app (app (app (app (app go al) motive) hm) (bvar n1)) (app eager (app nat_succ (app hm (bvar nz))))) (bvar nz)) (app pfx (bvar nz))) (app motive (bvar nz)) $ > $ deq_j J (cons nat_ty G) (app eager (bvar nz)) (app (app (app (app ite (app bp (app (app beq (bvar nz)) (bvar nz)))) (app bd (app (app beq (bvar nz)) (bvar nz)))) (bvar nz)) (bvar nz)) nat_ty $ > $ deq_j J (cons (app (app ltN (app hm (bvar nz))) (app nat_succ (bvar n1))) (cons al (cons nat_ty (cons (fix_fty al motive hm ltN) G)))) (app (app (app (app (app (app (app go al) motive) hm) (bvar n3)) (app nat_succ (bvar n2))) (bvar n1)) (bvar nz)) (app (app (bvar n3) (bvar n1)) (lam al (lam (app (app ltN (app hm (bvar nz))) (app hm (bvar n2))) (app (app (app (app (app (app (app go al) motive) hm) (bvar n5)) (bvar n4)) (bvar n1)) (app (app (app (app (app pfgo (bvar n4)) (bvar n3)) (bvar n2)) (bvar n1)) (bvar nz)))))) (app motive (bvar n1)) $ > $ fix_eqs_j J G ite bp bd beq fix go eager al mo