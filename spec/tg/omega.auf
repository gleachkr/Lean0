-- Proofs for omega.mm0.

notin_self
----------
l1: $ ∀ y (y ∊ x → ¬ y ∊ y) , x ∊ x ⇒ ∀ y (y ∊ x → ¬ y ∊ y) $ by ax
l2: $ … ⇒ x ∊ x → ¬ x ∊ x $ by all_elim [l1]
l3: $ ∀ y (y ∊ x → ¬ y ∊ y) , x ∊ x ⇒ x ∊ x $ by ax
l4: $ … ⇒ ¬ x ∊ x $ by imp_elim [l2, l3]
l5: $ … ⇒ ⊥ $ by not_elim [l4, l3]
l6: $ … ⇒ ¬ x ∊ x $ by not_intro [l5]
l7: $ _ ⇒ ∀ x ¬ x ∊ x $ by ax_induction [l6]
l8: $ … ⇒ ¬ a ∊ a $ by all_elim [l7]
l9: $ G ⇒ ¬ a ∊ a $ by weaken [l8]
l10: $ … ⇒ ⊥ $ by not_elim [l9, #1]

notin_self_c
------------
l1: $ G , u = A , u ∊ A ⇒ u ∊ A $ by ax
l2: $ G , u = A , u ∊ A ⇒ u = A $ by ax
l3: $ … ⇒ A = u $ by eq_sym [l2]
l4: $ … ⇒ u ∊ u $ by welc_eq [l3, l1]
l5: $ … ⇒ ⊥ $ by notin_self [l4]
l6: $ … ⇒ ⊥ $ by wcel_elim [#1, l5]

notin_cycle
-----------
l1: $ ∀ y (y ∊ x → ∀ w (w ∊ y → ¬ y ∊ w)) , z ∊ x , x ∊ z ⇒ ∀ y (y ∊ x → ∀ w (w ∊ y → ¬ y ∊ w)) $ by ax
l2: $ … ⇒ z ∊ x → ∀ w (w ∊ z → ¬ z ∊ w) $ by all_elim [l1]
l3: $ ∀ y (y ∊ x → ∀ w (w ∊ y → ¬ y ∊ w)) , z ∊ x , x ∊ z ⇒ z ∊ x $ by ax
l4: $ … ⇒ ∀ w (w ∊ z → ¬ z ∊ w) $ by imp_elim [l2, l3]
l5: $ … ⇒ x ∊ z → ¬ z ∊ x $ by all_elim [l4]
l6: $ ∀ y (y ∊ x → ∀ w (w ∊ y → ¬ y ∊ w)) , z ∊ x , x ∊ z ⇒ x ∊ z $ by ax
l7: $ … ⇒ ¬ z ∊ x $ by imp_elim [l5, l6]
l8: $ … ⇒ ⊥ $ by not_elim [l7, l3]
l9: $ … ⇒ ¬ x ∊ z $ by not_intro [l8]
l10: $ … ⇒ z ∊ x → ¬ x ∊ z $ by imp_intro [l9]
l11: $ … ⇒ ∀ z (z ∊ x → ¬ x ∊ z) $ by all_intro [l10]
l12: $ ∀ w (w ∊ x → ¬ x ∊ w) ⟺ ∀ z (z ∊ x → ¬ x ∊ z) $ by all_alpha
l13: $ ∀ y (y ∊ x → ∀ w (w ∊ y → ¬ y ∊ w)) ⇒ ∀ w (w ∊ x → ¬ x ∊ w) ↔ ∀ z (z ∊ x → ¬ x ∊ z) $ by weaken [l12]
l14: $ … ⇒ ∀ w (w ∊ x → ¬ x ∊ w) $ by bi_elim_r [l13, l11]
l15: $ _ ⇒ ∀ x ∀ w (w ∊ x → ¬ x ∊ w) $ by ax_induction [l14]
l16: $ … ⇒ ∀ w (w ∊ a → ¬ a ∊ w) $ by all_elim [l15]
l17: $ … ⇒ b ∊ a → ¬ a ∊ b $ by all_elim [l16]
l18: $ G ⇒ b ∊ a → ¬ a ∊ b $ by weaken [l17]
l19: $ … ⇒ ¬ a ∊ b $ by imp_elim [l18, #2]
l20: $ … ⇒ ⊥ $ by not_elim [l19, #1]

