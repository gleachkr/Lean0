l6: $ … ⇒ functional g → rel g → cdm g = suc n → fv g ∅ = A → (∀ k (k ∊ n → fv g (suc k) = fv F (fv g k))) → c $ by imp_intro [l5]
l7: $ … ⇒ n ∊ ω → functional g → rel g → cdm g = suc n → fv g ∅ = A → (∀ k (k ∊ n → fv g (suc k) = fv F (fv g k))) → c $ by imp_intro [l6]
l8: $ H , n ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc n ∧ fv g ∅ = A ∧ ∀ k (k ∊ n → fv g (suc k) = fv F (fv g k)) ⇒ n ∊ ω → functional g → rel g → cdm g = suc n → fv g ∅ = A → (∀ k (k ∊ n → fv g (suc k) = fv F (fv g k))) → c $ by weaken [l7]
l9: $ H , n ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc n ∧ fv g ∅ = A ∧ ∀ k (k ∊ n → fv g (suc k) = fv F (fv g k)) ⇒ n ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc n ∧ fv g ∅ = A ∧ ∀ k (k ∊ n → fv g (suc k) = fv F (fv g k)) $ by ax
l10: $ … ⇒ n ∊ ω $ by and_elim_l [l9]
l11: $ … ⇒ functional g ∧ rel g ∧ cdm g = suc n ∧ fv g ∅ = A ∧ ∀ k (k ∊ n → fv g (suc k) = fv F (fv g k)) $ by and_elim_r [l9]
l12: $ … ⇒ functional g $ by and_elim_l [l11]
l13: $ … ⇒ rel g ∧ cdm g = suc n ∧ fv g ∅ = A ∧ ∀ k (k ∊ n → fv g (suc k) = fv F (fv g k)) $ by and_elim_r [l11]
l14: $ … ⇒ rel g $ by and_elim_l [l13]
l15: $ … ⇒ cdm g = suc n ∧ fv g ∅ = A ∧ ∀ k (k ∊ n → fv g (suc k) = fv F (fv g k)) $ by and_elim_r [l13]
l16: $ … ⇒ cdm g = suc n $ by and_elim_l [l15]
l17: $ … ⇒ fv g ∅ = A ∧ ∀ k (k ∊ n → fv g (suc k) = fv F (fv g k)) $ by and_elim_r [l15]
l18: $ … ⇒ fv g ∅ = A $ by and_elim_l [l17]
l19: $ … ⇒ ∀ k (k ∊ n → fv g (suc k) = fv F (fv g k)) $ by and_elim_r [l17]
l20: $ … ⇒ functional g → rel g → cdm g = suc n → fv g ∅ = A → (∀ k (k ∊ n → fv g (suc k) = fv F (fv g k))) → c $ by imp_elim [l8, l10]
l21: $ … ⇒ rel g → cdm g = suc n → fv g ∅ = A → (∀ k (k ∊ n → fv g (suc k) = fv F (fv g k))) → c $ by imp_elim [l20, l12]
l22: $ … ⇒ cdm g = suc n → fv g ∅ = A → (∀ k (k ∊ n → fv g (suc k) = fv F (fv g k))) → c $ by imp_elim [l21, l14]
