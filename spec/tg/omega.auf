z13: $ … ⇒ fv h w = fv (omrec A F) w $ by eq_trans [z11, z12]
z14: $ … ⇒ w ∊ {j | fv h j = fv (omrec A F) j} $ by cab_intro [z13]
z15: $ … ⇒ ∅ ∈ {j | fv h j = fv (omrec A F) j} $ by wcel_intro [z5, z14]
z16: $ … ⇒ ∅ ∈ {j | fv h j = fv (omrec A F) j} $ by isset_elim [z4, z15]
s2: $ G , k ∊ ω , fv h k = fv (omrec A F) k ⇒ isset k $ by isset_var
s3: $ … ⇒ isset (suc k) $ by suc_set [s2]
s4: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ ∀ n (n ∊ ω → fv h (suc n) = fv F (fv h n)) $ by weaken [#7]
s5: $ … ⇒ k ∊ ω → fv h (suc k) = fv F (fv h k) $ by all_elim [s4]
s6: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ k ∊ ω $ by ax
s7: $ … ⇒ fv h (suc k) = fv F (fv h k) $ by imp_elim [s5, s6]
s8: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ isset A $ by weaken [#1]
s9: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ functional F $ by weaken [#2]
s10: $ … ⇒ fv (omrec A F) (suc k) = fv F (fv (omrec A F) k) $ by omrec_suc [s8, s9, s6]
s11: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ fv h k = fv (omrec A F) k $ by ax
s12: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ F = F $ by eq_refl
s13: $ … ⇒ fv F (fv h k) = fv F (fv (omrec A F) k) $ by fv_eq [s12, s11]
s14: $ … ⇒ fv F (fv (omrec A F) k) = fv (omrec A F) (suc k) $ by eq_sym [s10]
s15: $ … ⇒ fv h (suc k) = fv F (fv (omrec A F) k) $ by eq_trans [s7, s13]
s16: $ … ⇒ fv h (suc k) = fv (omrec A F) (suc k) $ by eq_trans [s15, s14]
s17: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ w = suc k $ by ax
s18: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ h = h $ by eq_refl
s19: $ … ⇒ fv h w = fv h (suc k) $ by fv_eq [s18, s17]
s20: $ G , k ∊ ω , fv h k = fv (omrec A F) k , w = suc k ⇒ omrec A F = omrec A F $ by eq_refl
s21: $ … ⇒ fv (omrec A F) w = fv (omrec A F) (suc k) $ by fv_eq [s20, s17]
s22: $ … ⇒ fv (omrec A F) (suc k) = fv (omrec A F) w $ by eq_sym [s21]
s23: $ … ⇒ fv h w = fv (omrec A F) (suc k) $ by eq_trans [s19, s16]
s24: $ … ⇒ fv h w = fv (omrec A F) w $ by eq_trans [s23, s22]
s25: $ … ⇒ w ∊ {j | fv h j = fv (omrec A F) j} $ by cab_intro [s24]
s26: $ … ⇒ suc k ∈ {j | fv h j = fv (omrec A F) j} $ by wcel_intro [s17, s25]
s27: $ … ⇒ suc k ∈ {j | fv h j = fv (omrec A F) j} $ by isset_elim [s3, s26]
s28: $ … ⇒ fv h k = fv (omrec A F) k → suc k ∈ {j | fv h j = fv (omrec A F) j} $ by imp_intro [s27]
s29: $ … ⇒ k ∊ ω → fv h k = fv (omrec A F) k → suc k ∈ {j | fv h j = fv (omrec A F) j} $ by imp_intro [s28]
s30: $ … ⇒ ∀ k (k ∊ ω → fv h k = fv (omrec A F) k → suc k ∈ {j | fv h j = fv (omrec A F) j}) $ by all_intro [s29]
i1: $ … ⇒ ∀ j (j ∊ ω → fv h j = fv (omrec A F) j) $ by omega_ind_f [z16, s30]
e1: $ G , x ∊ cdm h ⇒ x ∊ cdm h $ by ax
e2: $ G , x ∊ cdm h ⇒ cdm h = ω $ by weaken [#5]
e3: $ … ⇒ x ∊ ω $ by welc_eq [e2, e1]
e4: $ G , x ∊ cdm h ⇒ ∀ j (j ∊ ω → fv h j = fv (omrec A F) j) $ by weaken [i1]
e5: $ … ⇒ x ∊ ω → fv h x = fv (omrec A F) x $ by all_elim [e4]
e6: $ … ⇒ fv h x = fv (omrec A F) x $ by imp_elim [e5, e3]
e7: $ … ⇒ h = omrec A F $ by fv_ext [#3, l1, #4, l2, l5, e6]

omrec_congr
-----------
c1: $ fv g ∅ ≐ fv g ∅ $ by ceqt_refl
c2: $ (fv g ∅ = A) ⟺ (fv g ∅ = B) $ by ceq_congr [c1, #1]
c3: $ fv g (suc i) ≐ fv g (suc i) $ by ceqt_refl
c4: $ fv g i ≐ fv g i $ by ceqt_refl
c5: $ fv F (fv g i) ≐ fv H (fv g i) $ by fv_congr [#2, c4]
c6: $ (fv g (suc i) = fv F (fv g i)) ⟺ (fv g (suc i) = fv H (fv g i)) $ by ceq_congr [c3, c5]
c7: $ (i ∊ k) ⟺ (i ∊ k) $ by iff_refl
c8: $ (i ∊ k → fv g (suc i) = fv F (fv g i)) ⟺ (i ∊ k → fv g (suc i) = fv H (fv g i)) $ by im_congr [c7, c6]
c9: $ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i)) ⟺ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i)) $ by all_congr [c8]
c10: $ (fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c2, c9]
c11: $ (cdm g = suc k) ⟺ (cdm g = suc k) $ by iff_refl
c12: $ (cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c11, c10]
c13: $ rel g ⟺ rel g $ by iff_refl
c14: $ (rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c13, c12]
c15: $ functional g ⟺ functional g $ by iff_refl
c16: $ (functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c15, c14]
c17: $ (k ∊ ω) ⟺ (k ∊ ω) $ by iff_refl
c18: $ (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c17, c16]
c19: $ ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by ex_congr [c18]
c20: $ {g | ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i)))} ≐ {g | ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i)))} $ by cab_congr [c19]
c21: $ omrec A F ≐ omrec B H $ by cuni_congr [c20]

omrec_eq
--------
l1: $ … ⇒ omapx A F = omapx B H $ by omapx_eq [#1, #2]
l2: $ … ⇒ ⋃ (omapx A F) = ⋃ (omapx B H) $ by cuni_eq [l1]

sb_c_omrec
----------
l1: $ (⟦ x / t ⟧ ⋃ {g | ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i)))}) ≐ ⋃ {g | ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = (⟦ x / t ⟧ A) ∧ ∀ i (i ∊ k → fv g (suc i) = fv (⟦ x / t ⟧ F) (fv g i)))} $ by ceqt_refl
