lemma o2_agree_core {k: set} (G: hyps k) (A F: class) (g h i j a: set):
  $ G ⇒ i ∊ ω $ > $ G ⇒ cdm g = suc i $ > $ G ⇒ fv g ∅ = A $ >
  $ G ⇒ ∀ k (k ∊ i → fv g (suc k) = fv F (fv g k)) $ >
  $ G ⇒ j ∊ ω $ > $ G ⇒ cdm h = suc j $ > $ G ⇒ fv h ∅ = A $ >
  $ G ⇒ ∀ k (k ∊ j → fv h (suc k) = fv F (fv h k)) $ >
  $ G ⇒ a ∊ ω $ > $ G ⇒ a ∊ cdm g $ > $ G ⇒ a ∊ cdm h $ > $ G ⇒ fv g a = fv h a $
----
b1: $ G , w = ∅ ⇒ w = ∅ $ by ax
b2: $ G , w = ∅ ⇒ g = g $ by eq_refl
b3: $ … ⇒ fv g w = fv g ∅ $ by fv_eq [b2, b1]
b4: $ G , w = ∅ ⇒ fv g ∅ = A $ by weaken [#3]
b5: $ … ⇒ fv g w = A $ by eq_trans [b3, b4]
b6: $ G , w = ∅ ⇒ h = h $ by eq_refl
b7: $ … ⇒ fv h w = fv h ∅ $ by fv_eq [b6, b1]
b8: $ G , w = ∅ ⇒ fv h ∅ = A $ by weaken [#7]
b9: $ … ⇒ fv h w = A $ by eq_trans [b7, b8]
b10: $ … ⇒ A = fv h w $ by eq_sym [b9]
b11: $ … ⇒ fv g w = fv h w $ by eq_trans [b5, b10]
b12: $ G , w = ∅ , w ∊ cdm g , w ∊ cdm h ⇒ fv g w = fv h w $ by weaken [b11]
b13: $ … ⇒ w ∊ cdm h → fv g w = fv h w $ by imp_intro [b12]
b14: $ … ⇒ w ∊ cdm g → w ∊ cdm h → fv g w = fv h w $ by imp_intro [b13]
b15: $ … ⇒ w ∊ {x | x ∊ cdm g → x ∊ cdm h → fv g x = fv h x} $ by cab_intro [b14]
b16: $ … ⇒ ∅ ∈ {x | x ∊ cdm g → x ∊ cdm h → fv g x = fv h x} $ by wcel_intro [b1, b15]
b17: $ G ⇒ isset ∅ $ by ax_empty
b18: $ … ⇒ ∅ ∈ {x | x ∊ cdm g → x ∊ cdm h → fv g x = fv h x} $ by isset_elim [b17, b16]
s1: $ G , v ∊ ω , v ∊ cdm g → v ∊ cdm h → fv g v = fv h v , w = suc v , w ∊ cdm g , w ∊ cdm h ⇒ i ∊ ω $ by weaken [#1]
s2: $ G , v ∊ ω , v ∊ cdm g → v ∊ cdm h → fv g v = fv h v , w = suc v , w ∊ cdm g , w ∊ cdm h ⇒ cdm g = suc i $ by weaken [#2]
s3: $ G , v ∊ ω , v ∊ cdm g → v ∊ cdm h → fv g v = fv h v , w = suc v , w ∊ cdm g , w ∊ cdm h ⇒ ∀ k (k ∊ i → fv g (suc k) = fv F (fv g k)) $ by weaken [#4]
s4: $ G , v ∊ ω , v ∊ cdm g → v ∊ cdm h → fv g v = fv h v , w = suc v , w ∊ cdm g , w ∊ cdm h ⇒ w = suc v $ by ax
s5: $ G , v ∊ ω , v ∊ cdm g → v ∊ cdm h → fv g v = fv h v , w = suc v , w ∊ cdm g , w ∊ cdm h ⇒ w ∊ cdm g $ by ax
