m26: $ … ⇒ i ∊ ω ∧ functional z ∧ rel z ∧ cdm z = suc i ∧ fv z ∅ = A ∧ ∀ v (v ∊ i → fv z (suc v) = fv F (fv z v)) $ by and_intro [m26e, m26d]
m27: $ … ⇒ ∃ j (j ∊ ω ∧ functional z ∧ rel z ∧ cdm z = suc j ∧ fv z ∅ = A ∧ ∀ v (v ∊ j → fv z (suc v) = fv F (fv z v))) $ by ex_intro [m26]
m28: $ … ⇒ z ∊ {u | ∃ j (j ∊ ω ∧ functional u ∧ rel u ∧ cdm u = suc j ∧ fv u ∅ = A ∧ ∀ v (v ∊ j → fv u (suc v) = fv F (fv u v)))} $ by cab_intro [m27]
m29: $ G , z = B ⇒ z ∊ omapx A F $ by weaken [m28]
m30: $ … ⇒ z ∊ omapx A F ∧ cdm z = suc i $ by and_intro [m29, m8]
m31: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc i) $ by ex_intro [m30]
m32: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc i) $ by isset_elim [#1, m31]

lemma o2_base_core {g: set} (G: hyps g) (A F: class) (e c: set):
  $ G ⇒ c = A $ > $ G ⇒ e = ∅ $ > $ G ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc e) $
----
p1a: $ G ⇒ isset e $ by isset_var
p1b: $ G ⇒ isset c $ by isset_var
p1c: $ … ⇒ isset ⟨ e , c ⟩ $ by opair_set [p1a, p1b]
p1: $ … ⇒ isset (csn ⟨ e , c ⟩) $ by csn_set [p1c]
p2a: $ G ⇒ ∅ ∈ ω $ by omega_zero
p2b: $ … ⇒ ∅ = e $ by eq_sym [#2]
p2c: $ … ⇒ e ∈ ω $ by wcel_eq_l [p2b, p2a]
p2: $ … ⇒ e ∊ ω $ by wcel_welc [p2c]
f1: $ G , ⟨ u , v ⟩ ∈ (csn ⟨ e , c ⟩) , ⟨ u , w ⟩ ∈ (csn ⟨ e , c ⟩) ⇒ ⟨ u , v ⟩ ∈ (csn ⟨ e , c ⟩) $ by ax
f2: $ … ⇒ u = e ∧ v = c $ by csn_opair_elim [f1]
f3: $ G , ⟨ u , v ⟩ ∈ (csn ⟨ e , c ⟩) , ⟨ u , w ⟩ ∈ (csn ⟨ e , c ⟩) ⇒ ⟨ u , w ⟩ ∈ (csn ⟨ e , c ⟩) $ by ax
f4: $ … ⇒ u = e ∧ w = c $ by csn_opair_elim [f3]
f5: $ … ⇒ v = c $ by and_elim_r [f2]
f6: $ … ⇒ w = c $ by and_elim_r [f4]
f7: $ … ⇒ c = w $ by eq_sym [f6]
f8: $ … ⇒ v = w $ by eq_trans [f5, f7]
p3: $ … ⇒ functional (csn ⟨ e , c ⟩) $ by functional_intro [f8]
r1: $ G , z ∊ (csn ⟨ e , c ⟩) ⇒ z ∊ (csn ⟨ e , c ⟩) $ by ax
r2: $ … ⇒ z = ⟨ e , c ⟩ $ by csn_elim [r1]
r3: $ … ⇒ ∃ v (z = ⟨ e , v ⟩) $ by ex_intro [r2]
r4: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_intro [r3]
p4: $ … ⇒ rel (csn ⟨ e , c ⟩) $ by rel_intro [r4]
c1: $ G , z ∊ cdm (csn ⟨ e , c ⟩) ⇒ z ∊ cdm (csn ⟨ e , c ⟩) $ by ax
c2: $ G , z ∊ cdm (csn ⟨ e , c ⟩) , ⟨ z , y ⟩ ∈ (csn ⟨ e , c ⟩) ⇒ ⟨ z , y ⟩ ∈ (csn ⟨ e , c ⟩) $ by ax
c3: $ … ⇒ z = e ∧ y = c $ by csn_opair_elim [c2]
c4: $ … ⇒ z = e $ by and_elim_l [c3]
c5: $ … ⇒ z ∊ suc e $ by suc_intro_r [c4]
c6: $ … ⇒ z ∊ suc e $ by cdm_elim [c1, c5]
d1: $ G , z ∊ suc e ⇒ z ∊ suc e $ by ax
d2: $ … ⇒ z ∊ e ∨ z = e $ by suc_elim [d1]
d3: $ G , z ∊ suc e , z ∊ e ⇒ z ∊ e $ by ax
d4: $ G , z ∊ suc e , z ∊ e ⇒ e = ∅ $ by weaken [#2]
d5: $ … ⇒ z ∊ ∅ $ by welc_eq [d4, d3]
d6: $ … ⇒ ⊥ $ by empty_elim [d5]
d7: $ … ⇒ z ∊ cdm (csn ⟨ e , c ⟩) $ by bot_elim [d6]
d8: $ G , z ∊ suc e , z = e ⇒ ⟨ e , c ⟩ ∈ (csn ⟨ e , c ⟩) $ by csn_opair_intro
d9: $ G , z ∊ suc e , z = e ⇒ z = e $ by ax
d10: $ … ⇒ e = z $ by eq_sym [d9]
d11: $ G , z ∊ suc e , z = e ⇒ c = c $ by eq_refl
d12: $ … ⇒ ⟨ e , c ⟩ = ⟨ z , c ⟩ $ by opair_eq [d10, d11]
d13: $ … ⇒ ⟨ z , c ⟩ ∈ (csn ⟨ e , c ⟩) $ by wcel_eq_l [d12, d8]
d14: $ … ⇒ z ∊ cdm (csn ⟨ e , c ⟩) $ by cdm_intro [d13]
d15: $ … ⇒ z ∊ cdm (csn ⟨ e , c ⟩) $ by or_elim [d2, d7, d14]
p5: $ … ⇒ cdm (csn ⟨ e , c ⟩) = suc e $ by eq_intro [c6, d15]
e1: $ G ⇒ ⟨ e , c ⟩ ∈ (csn ⟨ e , c ⟩) $ by csn_opair_intro
e2: $ … ⇒ fv (csn ⟨ e , c ⟩) e = c $ by fv_val [p3, e1]
e3: $ G ⇒ (csn ⟨ e , c ⟩) = (csn ⟨ e , c ⟩) $ by eq_refl
e4: $ … ⇒ fv (csn ⟨ e , c ⟩) ∅ = fv (csn ⟨ e , c ⟩) e $ by fv_eq [e3, p2b]
e5: $ … ⇒ fv (csn ⟨ e , c ⟩) ∅ = c $ by eq_trans [e4, e2]
p6: $ … ⇒ fv (csn ⟨ e , c ⟩) ∅ = A $ by eq_trans [e5, #1]
k1: $ G , v ∊ e ⇒ v ∊ e $ by ax
k2: $ G , v ∊ e ⇒ e = ∅ $ by weaken [#2]
k3: $ … ⇒ v ∊ ∅ $ by welc_eq [k2, k1]
k4: $ … ⇒ ⊥ $ by empty_elim [k3]
k5: $ … ⇒ fv (csn ⟨ e , c ⟩) (suc v) = fv F (fv (csn ⟨ e , c ⟩) v) $ by bot_elim [k4]
k6: $ … ⇒ v ∊ e → fv (csn ⟨ e , c ⟩) (suc v) = fv F (fv (csn ⟨ e , c ⟩) v) $ by imp_intro [k5]
p7: $ … ⇒ ∀ v (v ∊ e → fv (csn ⟨ e , c ⟩) (suc v) = fv F (fv (csn ⟨ e , c ⟩) v)) $ by all_intro [k6]
fin: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc e) $ by omapx_intro [p1, p2, p3, p4, p5, p6, p7]

lemma o2_base {g: set} (G: hyps g) (A F: class) (e: set):
  $ G ⇒ isset A $ > $ G ⇒ e = ∅ $ > $ G ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc e) $
----
l1: $ G , c = A ⇒ c = A $ by ax
l2: $ G , c = A ⇒ e = ∅ $ by weaken [#2]
l3: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc e) $ by o2_base_core [l1, l2]
l4: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc e) $ by isset_elim [#1, l3]

lemma o2_ext_core {g k: set} (G: hyps g k) (A F: class) (h x i s c: set):
  $ G ⇒ x ∊ ω $ > $ G ⇒ functional h $ > $ G ⇒ rel h $ > $ G ⇒ cdm h = suc x $ >
  $ G ⇒ fv h ∅ = A $ > $ G ⇒ ∀ k (k ∊ i → fv h (suc k) = fv F (fv h k)) $ >
  $ G ⇒ i = x $ > $ G ⇒ s = suc x $ > $ G ⇒ c = fv F (fv h x) $ >
  $ G ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $
----
q1: $ G ⇒ isset h $ by isset_var
q2: $ G ⇒ isset s $ by isset_var
q3: $ G ⇒ isset c $ by isset_var
q4: $ … ⇒ isset ⟨ s , c ⟩ $ by opair_set [q2, q3]
q5: $ … ⇒ isset (csn ⟨ s , c ⟩) $ by csn_set [q4]
p1: $ … ⇒ isset (h ∪ csn ⟨ s , c ⟩) $ by cun_set [q1, q5]
q6: $ … ⇒ suc x ∈ ω $ by omega_suc [#1]
q7: $ … ⇒ suc x = s $ by eq_sym [#8]
q8: $ … ⇒ s ∈ ω $ by wcel_eq_l [q7, q6]
p2: $ … ⇒ s ∊ ω $ by wcel_welc [q8]
n1: $ G , s ∊ cdm h ⇒ s ∊ cdm h $ by ax
n2: $ G , s ∊ cdm h ⇒ cdm h = suc x $ by weaken [#4]
n3: $ … ⇒ s ∊ suc x $ by welc_eq [n2, n1]
n4: $ G , s ∊ cdm h ⇒ suc x = s $ by weaken [q7]
n5: $ … ⇒ s ∊ s $ by welc_eq [n4, n3]
n6: $ … ⇒ ⊥ $ by notin_self [n5]
f1: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) ⇒ ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) $ by ax
f2: $ … ⇒ ⟨ u , v ⟩ ∈ h ∨ (u = s ∧ v = c) $ by cun_csn_opair_elim [f1]
f3: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) ⇒ ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) $ by ax
f4: $ … ⇒ ⟨ u , w ⟩ ∈ h ∨ (u = s ∧ w = c) $ by cun_csn_opair_elim [f3]
fa1: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , v ⟩ ∈ h ⇒ ⟨ u , w ⟩ ∈ h ∨ (u = s ∧ w = c) $ by weaken [f4]
fa2: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , v ⟩ ∈ h , ⟨ u , w ⟩ ∈ h ⇒ functional h $ by weaken [#2]
fa3: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , v ⟩ ∈ h , ⟨ u , w ⟩ ∈ h ⇒ ⟨ u , v ⟩ ∈ h $ by ax
fa4: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , v ⟩ ∈ h , ⟨ u , w ⟩ ∈ h ⇒ ⟨ u , w ⟩ ∈ h $ by ax
fa5: $ … ⇒ v = w $ by functional_elim [fa2, fa3, fa4]
fa6: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , v ⟩ ∈ h , u = s ∧ w = c ⇒ u = s ∧ w = c $ by ax
fa7: $ … ⇒ u = s $ by and_elim_l [fa6]
fa8: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , v ⟩ ∈ h , u = s ∧ w = c ⇒ ⟨ u , v ⟩ ∈ h $ by ax
fa9: $ … ⇒ u ∊ cdm h $ by cdm_intro [fa8]
fa10: $ … ⇒ s ∊ cdm h $ by welc_eq_set [fa7, fa9]
fa11: $ … ⇒ ⊥ $ by cut [fa10, n6]
fa12: $ … ⇒ v = w $ by bot_elim [fa11]
fa13: $ … ⇒ v = w $ by or_elim [fa1, fa5, fa12]
fb1: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , u = s ∧ v = c ⇒ ⟨ u , w ⟩ ∈ h ∨ (u = s ∧ w = c) $ by weaken [f4]
fb2: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , u = s ∧ v = c , ⟨ u , w ⟩ ∈ h ⇒ u = s ∧ v = c $ by ax
fb3: $ … ⇒ u = s $ by and_elim_l [fb2]
fb4: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , u = s ∧ v = c , ⟨ u , w ⟩ ∈ h ⇒ ⟨ u , w ⟩ ∈ h $ by ax
fb5: $ … ⇒ u ∊ cdm h $ by cdm_intro [fb4]
fb6: $ … ⇒ s ∊ cdm h $ by welc_eq_set [fb3, fb5]
fb7: $ … ⇒ ⊥ $ by cut [fb6, n6]
fb8: $ … ⇒ v = w $ by bot_elim [fb7]
fb9: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , u = s ∧ v = c , u = s ∧ w = c ⇒ u = s ∧ v = c $ by ax
fb10: $ … ⇒ v = c $ by and_elim_r [fb9]
fb11: $ G , ⟨ u , v ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ u , w ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , u = s ∧ v = c , u = s ∧ w = c ⇒ u = s ∧ w = c $ by ax
fb12: $ … ⇒ w = c $ by and_elim_r [fb11]
fb13: $ … ⇒ c = w $ by eq_sym [fb12]
fb14: $ … ⇒ v = w $ by eq_trans [fb10, fb13]
fb15: $ … ⇒ v = w $ by or_elim [fb1, fb8, fb14]
f5: $ … ⇒ v = w $ by or_elim [f2, fa13, fb15]
p3: $ … ⇒ functional (h ∪ csn ⟨ s , c ⟩) $ by functional_intro [f5]
r1: $ G , z ∊ (h ∪ csn ⟨ s , c ⟩) ⇒ z ∊ (h ∪ csn ⟨ s , c ⟩) $ by ax
r2: $ … ⇒ z ∊ h ∨ z ∊ csn ⟨ s , c ⟩ $ by cun_elim [r1]
r3: $ G , z ∊ (h ∪ csn ⟨ s , c ⟩) , z ∊ h ⇒ rel h $ by weaken [#3]
r4: $ G , z ∊ (h ∪ csn ⟨ s , c ⟩) , z ∊ h ⇒ z ∊ h $ by ax
r5: $ G , z ∊ (h ∪ csn ⟨ s , c ⟩) , z ∊ h , z = ⟨ a , b ⟩ ⇒ z = ⟨ a , b ⟩ $ by ax
r6: $ … ⇒ ∃ v (z = ⟨ a , v ⟩) $ by ex_intro [r5]
r7: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_intro [r6]
r8: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by rel_elim [r3, r4, r7]
r9: $ G , z ∊ (h ∪ csn ⟨ s , c ⟩) , z ∊ csn ⟨ s , c ⟩ ⇒ z ∊ csn ⟨ s , c ⟩ $ by ax
r10: $ … ⇒ z = ⟨ s , c ⟩ $ by csn_elim [r9]
r11: $ … ⇒ ∃ v (z = ⟨ s , v ⟩) $ by ex_intro [r10]
r12: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_intro [r11]
r13: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by or_elim [r2, r8, r12]
p4: $ … ⇒ rel (h ∪ csn ⟨ s , c ⟩) $ by rel_intro [r13]
c1: $ G , z ∊ cdm (h ∪ csn ⟨ s , c ⟩) ⇒ z ∊ cdm (h ∪ csn ⟨ s , c ⟩) $ by ax
c2: $ G , z ∊ cdm (h ∪ csn ⟨ s , c ⟩) , ⟨ z , y ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) ⇒ ⟨ z , y ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) $ by ax
c3: $ … ⇒ ⟨ z , y ⟩ ∈ h ∨ (z = s ∧ y = c) $ by cun_csn_opair_elim [c2]
c4: $ G , z ∊ cdm (h ∪ csn ⟨ s , c ⟩) , ⟨ z , y ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ z , y ⟩ ∈ h ⇒ ⟨ z , y ⟩ ∈ h $ by ax
c5: $ … ⇒ z ∊ cdm h $ by cdm_intro [c4]
c6: $ G , z ∊ cdm (h ∪ csn ⟨ s , c ⟩) , ⟨ z , y ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ z , y ⟩ ∈ h ⇒ cdm h = suc x $ by weaken [#4]
c7: $ … ⇒ z ∊ suc x $ by welc_eq [c6, c5]
c8: $ G , z ∊ cdm (h ∪ csn ⟨ s , c ⟩) , ⟨ z , y ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , ⟨ z , y ⟩ ∈ h ⇒ suc x = s $ by weaken [q7]
c9: $ … ⇒ z ∊ s $ by welc_eq [c8, c7]
c10: $ … ⇒ z ∊ suc s $ by suc_intro_l [c9]
c11: $ G , z ∊ cdm (h ∪ csn ⟨ s , c ⟩) , ⟨ z , y ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) , z = s ∧ y = c ⇒ z = s ∧ y = c $ by ax
c12: $ … ⇒ z = s $ by and_elim_l [c11]
c13: $ … ⇒ z ∊ suc s $ by suc_intro_r [c12]
c14: $ … ⇒ z ∊ suc s $ by or_elim [c3, c10, c13]
c15: $ … ⇒ z ∊ suc s $ by cdm_elim [c1, c14]
d1: $ G , z ∊ suc s ⇒ z ∊ suc s $ by ax
d2: $ … ⇒ z ∊ s ∨ z = s $ by suc_elim [d1]
d3: $ G , z ∊ suc s , z ∊ s ⇒ z ∊ s $ by ax
d4: $ G , z ∊ suc s , z ∊ s ⇒ s = suc x $ by weaken [#8]
d5: $ … ⇒ z ∊ suc x $ by welc_eq [d4, d3]
d6a: $ G , z ∊ suc s , z ∊ s ⇒ cdm h = suc x $ by weaken [#4]
d6: $ … ⇒ suc x = cdm h $ by eq_sym [d6a]
d7: $ … ⇒ z ∊ cdm h $ by welc_eq [d6, d5]
d8: $ G , z ∊ suc s , z ∊ s , ⟨ z , y ⟩ ∈ h ⇒ ⟨ z , y ⟩ ∈ h $ by ax
d9: $ G , z ∊ suc s , z ∊ s , ⟨ z , y ⟩ ∈ h ⇒ h ⊆ (h ∪ csn ⟨ s , c ⟩) $ by cun_subset_l
d10: $ … ⇒ ⟨ z , y ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) $ by wcel_subset [d9, d8]
d11: $ … ⇒ z ∊ cdm (h ∪ csn ⟨ s , c ⟩) $ by cdm_intro [d10]
d12: $ … ⇒ z ∊ cdm (h ∪ csn ⟨ s , c ⟩) $ by cdm_elim [d7, d11]
d13: $ G , z ∊ suc s , z = s ⇒ ⟨ s , c ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) $ by cun_csn_opair_intro
d14: $ G , z ∊ suc s , z = s ⇒ z = s $ by ax
d15: $ … ⇒ s = z $ by eq_sym [d14]
d16: $ G , z ∊ suc s , z = s ⇒ c = c $ by eq_refl
d17: $ … ⇒ ⟨ s , c ⟩ = ⟨ z , c ⟩ $ by opair_eq [d15, d16]
d18: $ … ⇒ ⟨ z , c ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) $ by wcel_eq_l [d17, d13]
d19: $ … ⇒ z ∊ cdm (h ∪ csn ⟨ s , c ⟩) $ by cdm_intro [d18]
d20: $ … ⇒ z ∊ cdm (h ∪ csn ⟨ s , c ⟩) $ by or_elim [d2, d12, d19]
p5: $ … ⇒ cdm (h ∪ csn ⟨ s , c ⟩) = suc s $ by eq_intro [c15, d20]
e1: $ G , ∅ = s ⇒ ∅ = s $ by ax
e2: $ G , ∅ = s ⇒ s = suc x $ by weaken [#8]
e3: $ … ⇒ ∅ = suc x $ by eq_trans [e1, e2]
e4: $ … ⇒ suc x = ∅ $ by eq_sym [e3]
e5: $ … ⇒ ⊥ $ by suc_ne_empty [e4]
e6: $ … ⇒ ∅ = s → ⊥ $ by imp_intro [e5]
e7: $ G ⇒ isset ∅ $ by ax_empty
e8: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) ∅ = fv h ∅ $ by fv_cun_csn_other [e7, e6]
p6: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) ∅ = A $ by eq_trans [e8, #5]
k1: $ G , v ∊ s ⇒ v ∊ s $ by ax
k2: $ G , v ∊ s , v = s ⇒ v = s $ by ax
k3: $ G , v ∊ s , v = s ⇒ v ∊ s $ by ax
k4: $ … ⇒ s ∊ s $ by welc_eq_set [k2, k3]
k5: $ … ⇒ ⊥ $ by notin_self [k4]
k6: $ … ⇒ v = s → ⊥ $ by imp_intro [k5]
k7: $ G , v ∊ s ⇒ isset v $ by isset_var
k8: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) v = fv h v $ by fv_cun_csn_other [k7, k6]
k9: $ G , v ∊ s ⇒ s = suc x $ by weaken [#8]
k10: $ … ⇒ v ∊ suc x $ by welc_eq [k9, k1]
k11: $ … ⇒ v ∊ x ∨ v = x $ by suc_elim [k10]
k12: $ G , v ∊ s , v ∊ x , suc v = s ⇒ suc v = s $ by ax
k13: $ G , v ∊ s , v ∊ x , suc v = s ⇒ s = suc x $ by weaken [#8]
k14: $ … ⇒ suc v = suc x $ by eq_trans [k12, k13]
k15: $ … ⇒ v = x $ by suc_inj [k14]
k16: $ G , v ∊ s , v ∊ x , suc v = s ⇒ v ∊ x $ by ax
k17: $ … ⇒ x ∊ x $ by welc_eq_set [k15, k16]
k18: $ … ⇒ ⊥ $ by notin_self [k17]
k19: $ … ⇒ suc v = s → ⊥ $ by imp_intro [k18]
k20: $ G , v ∊ s , v ∊ x ⇒ isset v $ by isset_var
k21: $ … ⇒ isset (suc v) $ by suc_set [k20]
k22: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv h (suc v) $ by fv_cun_csn_other [k21, k19]
k23: $ G , v ∊ s , v ∊ x ⇒ i = x $ by weaken [#7]
k24: $ … ⇒ x = i $ by eq_sym [k23]
k25: $ G , v ∊ s , v ∊ x ⇒ v ∊ x $ by ax
k26: $ … ⇒ v ∊ i $ by welc_eq [k24, k25]
k27: $ G , v ∊ s , v ∊ x ⇒ ∀ k (k ∊ i → fv h (suc k) = fv F (fv h k)) $ by weaken [#6]
k28: $ … ⇒ v ∊ i → fv h (suc v) = fv F (fv h v) $ by all_elim [k27]
k29: $ … ⇒ fv h (suc v) = fv F (fv h v) $ by imp_elim [k28, k26]
k30: $ G , v ∊ s , v ∊ x ⇒ fv (h ∪ csn ⟨ s , c ⟩) v = fv h v $ by weaken [k8]
k31: $ … ⇒ fv h v = fv (h ∪ csn ⟨ s , c ⟩) v $ by eq_sym [k30]
k32: $ G , v ∊ s , v ∊ x ⇒ F = F $ by eq_refl
k33: $ … ⇒ fv F (fv h v) = fv F (fv (h ∪ csn ⟨ s , c ⟩) v) $ by fv_eq [k32, k31]
k34: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv F (fv h v) $ by eq_trans [k22, k29]
k35: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv F (fv (h ∪ csn ⟨ s , c ⟩) v) $ by eq_trans [k34, k33]
k36: $ G , v ∊ s , v = x ⇒ v = x $ by ax
k37: $ … ⇒ suc v = suc x $ by suc_eq [k36]
k38: $ G , v ∊ s , v = x ⇒ s = suc x $ by weaken [#8]
k39: $ … ⇒ suc x = s $ by eq_sym [k38]
k40: $ … ⇒ suc v = s $ by eq_trans [k37, k39]
k41: $ G , v ∊ s , v = x ⇒ (h ∪ csn ⟨ s , c ⟩) = (h ∪ csn ⟨ s , c ⟩) $ by eq_refl
k42: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv (h ∪ csn ⟨ s , c ⟩) s $ by fv_eq [k41, k40]
k43: $ G , v ∊ s , v = x ⇒ functional (h ∪ csn ⟨ s , c ⟩) $ by weaken [p3]
k44: $ G , v ∊ s , v = x ⇒ ⟨ s , c ⟩ ∈ (h ∪ csn ⟨ s , c ⟩) $ by cun_csn_opair_intro
k45: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) s = c $ by fv_val [k43, k44]
k46: $ G , v ∊ s , v = x ⇒ c = fv F (fv h x) $ by weaken [#9]
k47: $ G , v ∊ s , v = x ⇒ h = h $ by eq_refl
k48: $ … ⇒ x = v $ by eq_sym [k36]
k49: $ … ⇒ fv h x = fv h v $ by fv_eq [k47, k48]
k50: $ G , v ∊ s , v = x ⇒ fv (h ∪ csn ⟨ s , c ⟩) v = fv h v $ by weaken [k8]
k51: $ … ⇒ fv h v = fv (h ∪ csn ⟨ s , c ⟩) v $ by eq_sym [k50]
k52: $ … ⇒ fv h x = fv (h ∪ csn ⟨ s , c ⟩) v $ by eq_trans [k49, k51]
k53: $ G , v ∊ s , v = x ⇒ F = F $ by eq_refl
k54: $ … ⇒ fv F (fv h x) = fv F (fv (h ∪ csn ⟨ s , c ⟩) v) $ by fv_eq [k53, k52]
k55: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) (suc v) = c $ by eq_trans [k42, k45]
k56: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv F (fv h x) $ by eq_trans [k55, k46]
k57: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv F (fv (h ∪ csn ⟨ s , c ⟩) v) $ by eq_trans [k56, k54]
k58: $ … ⇒ fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv F (fv (h ∪ csn ⟨ s , c ⟩) v) $ by or_elim [k11, k35, k57]
k59: $ … ⇒ v ∊ s → fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv F (fv (h ∪ csn ⟨ s , c ⟩) v) $ by imp_intro [k58]
p7: $ … ⇒ ∀ v (v ∊ s → fv (h ∪ csn ⟨ s , c ⟩) (suc v) = fv F (fv (h ∪ csn ⟨ s , c ⟩) v)) $ by all_intro [k59]
fin: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $ by omapx_intro [p1, p2, p3, p4, p5, p6, p7]

lemma o2_ext {g k: set} (G: hyps g k) (A F: class) (h x i s: set):
  $ G ⇒ functional F $ > $ G ⇒ x ∊ ω $ > $ G ⇒ functional h $ > $ G ⇒ rel h $ >
  $ G ⇒ cdm h = suc x $ > $ G ⇒ fv h ∅ = A $ >
  $ G ⇒ ∀ k (k ∊ i → fv h (suc k) = fv F (fv h k)) $ >
  $ G ⇒ i = x $ > $ G ⇒ s = suc x $ > $ G ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $
----
e1: $ G , a = fv h x , b = fv F a ⇒ x ∊ ω $ by weaken [#2]
e2: $ G , a = fv h x , b = fv F a ⇒ functional h $ by weaken [#3]
e3: $ G , a = fv h x , b = fv F a ⇒ rel h $ by weaken [#4]
e4: $ G , a = fv h x , b = fv F a ⇒ cdm h = suc x $ by weaken [#5]
e5: $ G , a = fv h x , b = fv F a ⇒ fv h ∅ = A $ by weaken [#6]
e6: $ G , a = fv h x , b = fv F a ⇒ ∀ k (k ∊ i → fv h (suc k) = fv F (fv h k)) $ by weaken [#7]
e7: $ G , a = fv h x , b = fv F a ⇒ i = x $ by weaken [#8]
e8: $ G , a = fv h x , b = fv F a ⇒ s = suc x $ by weaken [#9]
e9: $ G , a = fv h x , b = fv F a ⇒ b = fv F a $ by ax
e10: $ G , a = fv h x , b = fv F a ⇒ F = F $ by eq_refl
e11: $ G , a = fv h x , b = fv F a ⇒ a = fv h x $ by ax
e12: $ … ⇒ fv F a = fv F (fv h x) $ by fv_eq [e10, e11]
e13: $ … ⇒ b = fv F (fv h x) $ by eq_trans [e9, e12]
e14: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $ by o2_ext_core [e1, e2, e3, e4, e5, e6, e7, e8, e13]
e15: $ G , a = fv h x ⇒ functional F $ by weaken [#1]
e16: $ … ⇒ isset (fv F a) $ by fv_set [e15]
e17: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $ by isset_elim [e16, e14]
e18: $ … ⇒ isset (fv h x) $ by fv_set [#3]
e19: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $ by isset_elim [e18, e17]

lemma o2_step {g: set} (G: hyps g) (A F: class) (x s: set):
  $ G ⇒ functional F $ > $ G ⇒ x ∊ ω $ > $ G ⇒ s = suc x $ >
  $ G ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc x) $ > $ G ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $
----
a1: $ ∃ g (g ∊ omapx A F ∧ cdm g = suc x) ⟺ ∃ f (f ∊ omapx A F ∧ cdm f = suc x) $ by ex_alpha
a2: $ G ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc x) ↔ ∃ f (f ∊ omapx A F ∧ cdm f = suc x) $ by weaken [a1]
a3: $ … ⇒ ∃ f (f ∊ omapx A F ∧ cdm f = suc x) $ by bi_elim_l [a2, #4]
c1: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ functional F $ by weaken [#1]
c2: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ x ∊ ω $ by weaken [#2]
c3: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ functional f $ by ax
c4: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ rel f $ by ax
c5a: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ f ∊ omapx A F ∧ cdm f = suc x $ by ax
c5: $ … ⇒ cdm f = suc x $ by and_elim_r [c5a]
c6: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ fv f ∅ = A $ by ax
c7: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) $ by ax
c8a: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ cdm f = suc i $ by ax
c8b: $ … ⇒ suc i = cdm f $ by eq_sym [c8a]
c8c: $ … ⇒ suc i = suc x $ by eq_trans [c8b, c5]
c8: $ … ⇒ i = x $ by suc_inj [c8c]
c9: $ G , f ∊ omapx A F ∧ cdm f = suc x , i ∊ ω , functional f , rel f , cdm f = suc i , fv f ∅ = A , ∀ k (k ∊ i → fv f (suc k) = fv F (fv f k)) ⇒ s = suc x $ by weaken [#3]
c10: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $ by o2_ext [c1, c2, c3, c4, c5, c6, c7, c8, c9]
c11a: $ G , f ∊ omapx A F ∧ cdm f = suc x ⇒ f ∊ omapx A F ∧ cdm f = suc x $ by ax
c11b: $ … ⇒ f ∊ omapx A F $ by and_elim_l [c11a]
c11: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $ by omapx_elim [c11b, c10]
c12: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc s) $ by ex_elim [a3, c11]

omapx_exists
------------
b1a: $ G , w = ∅ ⇒ isset A $ by weaken [#1]
b1b: $ G , w = ∅ ⇒ w = ∅ $ by ax
b1: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc w) $ by o2_base [b1a, b1b]
b2: $ … ⇒ w ∊ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)} $ by cab_intro [b1]
b3: $ … ⇒ ∅ ∈ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)} $ by wcel_intro [b1b, b2]
b4: $ G ⇒ isset ∅ $ by ax_empty
b5: $ … ⇒ ∅ ∈ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)} $ by isset_elim [b4, b3]
s1a: $ G , v ∊ ω , ∃ g (g ∊ omapx A F ∧ cdm g = suc v) , w = suc v ⇒ functional F $ by weaken [#2]
s1b: $ G , v ∊ ω , ∃ g (g ∊ omapx A F ∧ cdm g = suc v) , w = suc v ⇒ v ∊ ω $ by ax
s1c: $ G , v ∊ ω , ∃ g (g ∊ omapx A F ∧ cdm g = suc v) , w = suc v ⇒ w = suc v $ by ax
s1d: $ G , v ∊ ω , ∃ g (g ∊ omapx A F ∧ cdm g = suc v) , w = suc v ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc v) $ by ax
s1: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc w) $ by o2_step [s1a, s1b, s1c, s1d]
s2: $ … ⇒ w ∊ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)} $ by cab_intro [s1]
s3: $ … ⇒ suc v ∈ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)} $ by wcel_intro [s1c, s2]
s4: $ G , v ∊ ω , ∃ g (g ∊ omapx A F ∧ cdm g = suc v) ⇒ isset v $ by isset_var
s5: $ … ⇒ isset (suc v) $ by suc_set [s4]
s6: $ … ⇒ suc v ∈ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)} $ by isset_elim [s5, s3]
s7: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc v) → suc v ∈ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)} $ by imp_intro [s6]
s8: $ … ⇒ v ∊ ω → ∃ g (g ∊ omapx A F ∧ cdm g = suc v) → suc v ∈ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)} $ by imp_intro [s7]
s9: $ … ⇒ ∀ v (v ∊ ω → ∃ g (g ∊ omapx A F ∧ cdm g = suc v) → suc v ∈ {x | ∃ g (g ∊ omapx A F ∧ cdm g = suc x)}) $ by all_intro [s8]
f1: $ … ⇒ ∀ x (x ∊ ω → ∃ g (g ∊ omapx A F ∧ cdm g = suc x)) $ by omega_ind_f [b5, s9]
f2: $ … ⇒ n ∊ ω → ∃ g (g ∊ omapx A F ∧ cdm g = suc n) $ by all_elim [f1]
f3: $ … ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc n) $ by imp_elim [f2, #3]
f4: $ G , g ∊ omapx A F ∧ cdm g = suc n ⇒ g ∊ omapx A F ∧ cdm g = suc n $ by ax
f5: $ … ⇒ g ∊ omapx A F $ by and_elim_l [f4]
f6: $ … ⇒ cdm g = suc n $ by and_elim_r [f4]
f7: $ … ⇒ suc n = cdm g $ by eq_sym [f6]
f8: $ G , g ∊ omapx A F ∧ cdm g = suc n ⇒ n ∊ suc n $ by suc_self
f9: $ … ⇒ n ∊ cdm g $ by welc_eq [f7, f8]
f10: $ … ⇒ g ∊ omapx A F ∧ n ∊ cdm g $ by and_intro [f5, f9]
f11: $ … ⇒ ∃ g (g ∊ omapx A F ∧ n ∊ cdm g) $ by ex_intro [f10]
f12: $ … ⇒ ∃ g (g ∊ omapx A F ∧ n ∊ cdm g) $ by ex_elim [f3, f11]

