omapx_congr
-----------
c1: $ fv g ∅ ≐ fv g ∅ $ by ceqt_refl
c2: $ (fv g ∅ = A) ⟺ (fv g ∅ = B) $ by ceq_congr [c1, #1]
c3: $ fv g (suc i) ≐ fv g (suc i) $ by ceqt_refl
c4: $ fv g i ≐ fv g i $ by ceqt_refl
c5: $ fv F (fv g i) ≐ fv H (fv g i) $ by fv_congr [#2, c4]
c6: $ (fv g (suc i) = fv F (fv g i)) ⟺ (fv g (suc i) = fv H (fv g i)) $ by ceq_congr [c3, c5]
c7: $ (i ∊ k) ⟺ (i ∊ k) $ by iff_refl
c8: $ (i ∊ k → fv g (suc i) = fv F (fv g i)) ⟺ (i ∊ k → fv g (suc i) = fv H (fv g i)) $ by im_congr [c7, c6]
c9: $ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i)) ⟺ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i)) $ by all_congr [c8]
c10: $ (fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c2, c9]
c11: $ (cdm g = suc k) ⟺ (cdm g = suc k) $ by iff_refl
c12: $ (cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c11, c10]
c13: $ rel g ⟺ rel g $ by iff_refl
c14: $ (rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c13, c12]
c15: $ functional g ⟺ functional g $ by iff_refl
c16: $ (functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c15, c14]
c17: $ (k ∊ ω) ⟺ (k ∊ ω) $ by iff_refl
c18: $ (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by and_congr [c17, c16]
c19: $ ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i))) ⟺ ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i))) $ by ex_congr [c18]
c20: $ {g | ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = A ∧ ∀ i (i ∊ k → fv g (suc i) = fv F (fv g i)))} ≐ {g | ∃ k (k ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc k ∧ fv g ∅ = B ∧ ∀ i (i ∊ k → fv g (suc i) = fv H (fv g i)))} $ by cab_congr [c19]

lemma x1_omapx_imp (G: hyps) (A B F H: class) (a: set):
  $ G ⇒ A = B $ > $ G ⇒ F = H $ > $ G ⇒ a ∊ omapx A F → a ∊ omapx B H $
----
m1: $ G , a ∊ omapx A F ⇒ a ∊ omapx A F $ by ax
m2: $ … ⇒ ∃ j (j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k))) $ by cab_elim [m1]
q0: $ G , j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) ⇒ j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) $ by ax
p0: $ … ⇒ j ∊ ω $ by and_elim_l [q0]
r0: $ … ⇒ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) $ by and_elim_r [q0]
p1: $ … ⇒ functional a $ by and_elim_l [r0]
r1: $ … ⇒ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) $ by and_elim_r [r0]
p2: $ … ⇒ rel a $ by and_elim_l [r1]
r2: $ … ⇒ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) $ by and_elim_r [r1]
p3: $ … ⇒ cdm a = suc j $ by and_elim_l [r2]
r3: $ … ⇒ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) $ by and_elim_r [r2]
p4: $ … ⇒ fv a ∅ = A $ by and_elim_l [r3]
r4: $ … ⇒ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) $ by and_elim_r [r3]
e1: $ G , j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) ⇒ A = B $ by weaken [#1]
e2: $ … ⇒ fv a ∅ = B $ by eq_trans [p4, e1]
f1: $ G , j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) , k ∊ j ⇒ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) $ by weaken [r4]
f2: $ … ⇒ k ∊ j → fv a (suc k) = fv F (fv a k) $ by all_elim [f1]
f3: $ G , j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) , k ∊ j ⇒ k ∊ j $ by ax
f4: $ … ⇒ fv a (suc k) = fv F (fv a k) $ by imp_elim [f2, f3]
f5: $ G , j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) , k ∊ j ⇒ F = H $ by weaken [#2]
f6: $ G , j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) , k ∊ j ⇒ fv a k = fv a k $ by eq_refl
f7: $ … ⇒ fv F (fv a k) = fv H (fv a k) $ by fv_eq [f5, f6]
f8: $ … ⇒ fv a (suc k) = fv H (fv a k) $ by eq_trans [f4, f7]
f9: $ … ⇒ k ∊ j → fv a (suc k) = fv H (fv a k) $ by imp_intro [f8]
f10: $ … ⇒ ∀ k (k ∊ j → fv a (suc k) = fv H (fv a k)) $ by all_intro [f9]
g4: $ … ⇒ fv a ∅ = B ∧ ∀ k (k ∊ j → fv a (suc k) = fv H (fv a k)) $ by and_intro [e2, f10]
g3: $ … ⇒ cdm a = suc j ∧ fv a ∅ = B ∧ ∀ k (k ∊ j → fv a (suc k) = fv H (fv a k)) $ by and_intro [p3, g4]
g2: $ … ⇒ rel a ∧ cdm a = suc j ∧ fv a ∅ = B ∧ ∀ k (k ∊ j → fv a (suc k) = fv H (fv a k)) $ by and_intro [p2, g3]
g1: $ … ⇒ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = B ∧ ∀ k (k ∊ j → fv a (suc k) = fv H (fv a k)) $ by and_intro [p1, g2]
g0: $ … ⇒ j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = B ∧ ∀ k (k ∊ j → fv a (suc k) = fv H (fv a k)) $ by and_intro [p0, g1]
h1: $ … ⇒ ∃ j (j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = B ∧ ∀ k (k ∊ j → fv a (suc k) = fv H (fv a k))) $ by ex_intro [g0]
h2: $ G , j ∊ ω ∧ functional a ∧ rel a ∧ cdm a = suc j ∧ fv a ∅ = A ∧ ∀ k (k ∊ j → fv a (suc k) = fv F (fv a k)) ⇒ a ∊ omapx B H $ by cab_intro [h1]
h3: $ … ⇒ a ∊ omapx B H $ by ex_elim [m2, h2]
h4: $ … ⇒ a ∊ omapx A F → a ∊ omapx B H $ by imp_intro [h3]

