lemma o2_apx_step {k: set} (G: hyps k) (F: class) (g i a w: set):
  $ G ⇒ i ∊ ω $ > $ G ⇒ cdm g = suc i $ > $ G ⇒ ∀ k (k ∊ i → fv g (suc k) = fv F (fv g k)) $ >
  $ G ⇒ w = suc a $ > $ G ⇒ w ∊ cdm g $ > $ G ⇒ a ∊ cdm g ∧ fv g w = fv F (fv g a) $
----
l1: $ … ⇒ w ∊ suc i $ by welc_eq [#2, #5]
l2: $ G ⇒ a ∊ suc a $ by suc_self
l3: $ … ⇒ suc a = w $ by eq_sym [#4]
l4: $ … ⇒ a ∊ w $ by welc_eq [l3, l2]
