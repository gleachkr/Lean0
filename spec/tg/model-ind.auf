pp2: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ g = r $ by and_elim_r [ppr0]
c1: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ nvf = nvf $ by eq_refl
c2: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ fv nvf l = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [c1, pp1]
c3: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
c4: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ suc (fv nvf h) = fv nvf l $ by weaken [e10]
c5: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ suc (fv nvf h) = fv nvf ⟨ kc_nz , ∅ ⟩ $ by eq_trans [c4, c2]
c6: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ suc (fv nvf h) = ∅ $ by eq_trans [c5, c3]
c7: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ ⊥ $ by suc_ne_empty [c6]
c8: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ k = g $ by bot_elim [c7]
q1: $ G , q = ⟨ kc_ccons , scons x0 (scons e ∅) ⟩ ∧ l = ⟨ kc_s , scons x1 ∅ ⟩ ∧ g = r ∧ ra_nth_ctor e x1 r ∈ lrel ⇒ q = ⟨ kc_ccons , scons x0 (scons e ∅) ⟩ ∧ l = ⟨ kc_s , scons x1 ∅ ⟩ ∧ g = r ∧ ra_nth_ctor e x1 r ∈ lrel $ by ax
