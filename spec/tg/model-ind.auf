lemma c6_eagr_eq (G: hyps) (E E1 E2 T T1: class): $ G ⇒ eagr E E2 T $ > $ G ⇒ E = E1 $ > $ G ⇒ T = T1 $ > $ G ⇒ eagr E1 E2 T1 $
----
t1: $ G , t ∊ fv tsub T1 ⇒ t ∊ fv tsub T1 $ by ax
t2a: $ G , t ∊ fv tsub T1 ⇒ T = T1 $ by weaken [#3]
t2: $ G , t ∊ fv tsub T1 ⇒ T1 = T $ by eq_sym [t2a]
t2b: $ G , t ∊ fv tsub T1 ⇒ tsub = tsub $ by eq_refl
t3: $ G , t ∊ fv tsub T1 ⇒ fv tsub T1 = fv tsub T $ by fv_eq [t2b, t2]
t4: $ G , t ∊ fv tsub T1 ⇒ t ∊ fv tsub T $ by welc_eq [t3, t1]
t5p: $ G ⇒ ∀ t (t ∊ fv tsub T → fv E t = fv E2 t) $ by and_elim_r [#1]
t5a: $ G ⇒ t ∊ fv tsub T → fv E t = fv E2 t $ by all_elim [t5p]
t5: $ G , t ∊ fv tsub T1 ⇒ t ∊ fv tsub T → fv E t = fv E2 t $ by weaken [t5a]
t6: $ G , t ∊ fv tsub T1 ⇒ fv E t = fv E2 t $ by imp_elim [t5, t4]
t7a: $ G , t ∊ fv tsub T1 ⇒ E = E1 $ by weaken [#2]
t7: $ G , t ∊ fv tsub T1 ⇒ E1 = E $ by eq_sym [t7a]
t7b: $ G , t ∊ fv tsub T1 ⇒ t = t $ by eq_refl
t8: $ G , t ∊ fv tsub T1 ⇒ fv E1 t = fv E t $ by fv_eq [t7, t7b]
t9: $ G , t ∊ fv tsub T1 ⇒ fv E1 t = fv E2 t $ by eq_trans [t8, t6]
t10: $ G ⇒ t ∊ fv tsub T1 → fv E1 t = fv E2 t $ by imp_intro [t9]
