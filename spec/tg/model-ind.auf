e9a: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ suc ∅ = suc ∅ $ by eq_refl
e9b: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ fv c (suc ∅) = fv (ccom (esf u E) s) (suc ∅) $ by fv_eq [e5a, e9a]
e9: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ fv c (suc ∅) = fv (esf u E) (fv s (suc ∅)) $ by eq_trans [e9b, e7]
e10a: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ w = w $ by eq_refl
e10: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ ap (fv c (suc ∅)) w = esat u E (fv s (suc ∅)) w $ by ap_eq [e9, e10a]
