t1: $ G , (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)})) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ z ∊ (clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)})) ∪ ((clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∪ (clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))) $ by c3_case_and [t2]
d1: $ G , z ∊ etb u E K S v ⇒ z ∊ etb u E K S v $ by ax
d2: $ G , z ∊ etb u E K S v ⇒ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)})) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by cab_elim [d1]
d3: $ G , z ∊ etb u E K S v ⇒ z ∊ (clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)})) ∪ ((clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∪ (clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))) $ by cut [d2, t1]
d4: $ G ⇒ etb u E K S v ⊆ (clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)})) ∪ ((clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∪ (clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))) $ by subset_intro [d3]
