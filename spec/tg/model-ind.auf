lemma c3_z3_inj (G: hyps) (a b: set): $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ $ > $ G ⇒ a = b $
----
s0: $ G ⇒ isset ∅ $ by ax_empty
s1: $ G ⇒ isset ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ $ by opair_isset
s2: $ G ⇒ isset ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ $ by opair_isset
s3: $ G ⇒ isset ⟨ ∅ , a ⟩ $ by opair_isset
s4: $ G ⇒ isset ⟨ ∅ , b ⟩ $ by opair_isset
s5: $ G ⇒ isset a $ by isset_var
s6: $ G ⇒ isset b $ by isset_var
i1: $ G ⇒ ∅ = ∅ ∧ ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ $ by opair_inj_c [#1, s0, s1, s0, s2]
i2: $ G ⇒ ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ $ by and_elim_r [i1]
i3: $ G ⇒ ∅ = ∅ ∧ ⟨ ∅ , a ⟩ = ⟨ ∅ , b ⟩ $ by opair_inj_c [i2, s0, s3, s0, s4]
i4: $ G ⇒ ⟨ ∅ , a ⟩ = ⟨ ∅ , b ⟩ $ by and_elim_r [i3]
i5: $ G ⇒ ∅ = ∅ ∧ a = b $ by opair_inj_c [i4, s0, s5, s0, s6]
i6: $ G ⇒ a = b $ by and_elim_r [i5]

lemma c3_h2_eq {x5 o: set} (G: hyps) (D: class) (c a: set): $ G ⇒ c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ $ > $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ = {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩)} $
----
f1: $ G , j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ $ by weaken [#1]
f2: $ G , j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ $ by ax
f3: $ G , j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ $ by and_intro [f1, f2]
f4: $ G , j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩) $ by ex_intro [f3]
f5: $ G , j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ j ∊ {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩)} $ by cab_intro [f4]
n1: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ $ by ax
n2: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ $ by and_elim_l [n1]
n3: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ $ by and_elim_r [n1]
n4: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ $ by weaken [#1]
n5: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ = c $ by eq_sym [n2]
n6: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ $ by eq_trans [n5, n4]
n7: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ x5 = a $ by c3_z3_inj [n6]
n8: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ D = D $ by eq_refl
n9: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ scons D x5 = scons D a $ by scons_eq [n8, n7]
n10: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ ∅ = ∅ $ by eq_refl
n11: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , scons D x5 ⟩ = ⟨ ∅ , scons D a ⟩ $ by opair_eq [n10, n9]
n12: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ $ by opair_eq [n10, n11]
n13: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ $ by opair_eq [n10, n12]
n14: $ G , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩ ⇒ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ $ by welc_eq [n13, n3]
m1: $ G , j ∊ {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩)} ⇒ j ∊ {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩)} $ by ax
m2: $ G , j ∊ {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩)} ⇒ ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩) $ by cab_elim [m1]
m3: $ G , j ∊ {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩)} ⇒ j ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ $ by ex_elim [m2, n14]
m4: $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ = {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D x5 ⟩ ⟩ ⟩)} $ by eq_intro [f5, m3]

lemma c3_x2_set {a y: set} (G: hyps) (E S: class) (v w r: set): $ G ⇒ isset {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $
----
s1: $ G ⇒ isset v $ by isset_var
s2: $ G ⇒ isset (fv v ∅) $ by fv_set_l [s1]
s8: $ G ⇒ isset (da (fv v ∅) w r) $ by da_set [s2]
s9: $ G , b = da (fv v ∅) w r ⇒ functional (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) $ by cgr_functional
s10: $ G , b = da (fv v ∅) w r ⇒ isset (img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) b) $ by ax_replace [s9]
s11a: $ G , b = da (fv v ∅) w r ⇒ cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)} = cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)} $ by eq_refl
s11b: $ G , b = da (fv v ∅) w r ⇒ b = da (fv v ∅) w r $ by ax
s11: $ G , b = da (fv v ∅) w r ⇒ img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) b = img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) (da (fv v ∅) w r) $ by img_eq [s11a, s11b]
s12: $ G , b = da (fv v ∅) w r ⇒ isset (img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) (da (fv v ∅) w r)) $ by isset_eq [s11, s10]
s13: $ G ⇒ isset (img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) (da (fv v ∅) w r)) $ by isset_elim [s8, s12]
k1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ $ by ax
k3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r $ by and_elim_l [k1]
k4: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ ⇒ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ $ by and_elim_r [k1]
r2: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ , c ∊ da (fv v ∅) w r ⇒ c ∊ da (fv v ∅) w r $ by ax
r3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ , c ∊ da (fv v ∅) w r ⇒ c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ $ by ax
r4: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ , c ∊ da (fv v ∅) w r ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ = {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)} $ by c3_h2_eq [r3]
r5a: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ , c ∊ da (fv v ∅) w r ⇒ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ $ by weaken [k4]
r5: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ , c ∊ da (fv v ∅) w r ⇒ z = {o | ∃ x5 (c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)} $ by eq_trans [r5a, r4]
r6: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ , c ∊ da (fv v ∅) w r ⇒ ⟨ c , z ⟩ ∈ cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)} $ by cgr_intro [r5]
r7: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ , c = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ , c ∊ da (fv v ∅) w r ⇒ z ∊ img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) (da (fv v ∅) w r) $ by img_intro [r2, r6]
r9: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩ ⇒ z ∊ img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) (da (fv v ∅) w r) $ by wcel_elim [k3, r7]
m1: $ G , z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} ⇒ z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $ by ax
m2: $ G , z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩) $ by cab_elim [m1]
m3: $ G , z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} ⇒ z ∊ img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) (da (fv v ∅) w r) $ by ex_elim [m2, r9]
m4: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} ⊆ img (cgr i {o | ∃ x5 (i = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , x5 ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) x5 ⟩ ⟩ ⟩)}) (da (fv v ∅) w r) $ by subset_intro [m3]
m5: $ G ⇒ isset {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $ by subset_isset [s13, m4]

lemma c3_cc_set (G: hyps) {w r: set} (u: set) (X: class w r): $ G ⇒ isset X $ > $ G ⇒ isset (clam w lvals (clam r (fseq u) X)) $
----
l1: $ G , r ∊ fseq u ⇒ isset X $ by weaken [#1]
l2: $ G ⇒ r ∊ fseq u → isset X $ by imp_intro [l1]
l3: $ G ⇒ ∀ r (r ∊ fseq u → isset X) $ by all_intro [l2]
l4: $ G ⇒ isset u $ by isset_var
l5: $ G ⇒ isset (fseq u) $ by fseq_set [l4]
l6: $ G ⇒ isset (clam r (fseq u) X) $ by clam_set [l5, l3]
l7: $ G , w ∊ lvals ⇒ isset (clam r (fseq u) X) $ by weaken [l6]
l8: $ G ⇒ w ∊ lvals → isset (clam r (fseq u) X) $ by imp_intro [l7]
l9: $ G ⇒ ∀ w (w ∊ lvals → isset (clam r (fseq u) X)) $ by all_intro [l8]
l10: $ G ⇒ isset lvals $ by lvals_set
l11: $ G ⇒ isset (clam w lvals (clam r (fseq u) X)) $ by clam_set [l10, l9]

lemma c3_case_and (G: hyps) (p q: fml) (A B: class) (z: set): $ G , q ⇒ z ∊ B $ > $ G , (p ∧ z ∊ A) ∨ q ⇒ z ∊ A ∪ B $
----
l1: $ G , (p ∧ z ∊ A) ∨ q ⇒ (p ∧ z ∊ A) ∨ q $ by ax
l2: $ G , (p ∧ z ∊ A) ∨ q , p ∧ z ∊ A ⇒ p ∧ z ∊ A $ by ax
l3: $ G , (p ∧ z ∊ A) ∨ q , p ∧ z ∊ A ⇒ z ∊ A $ by and_elim_r [l2]
l4: $ G , (p ∧ z ∊ A) ∨ q , p ∧ z ∊ A ⇒ z ∊ A ∪ B $ by cun_intro_l [l3]
l5: $ G , (p ∧ z ∊ A) ∨ q , q ⇒ z ∊ B $ by weaken [#1]
l6: $ G , (p ∧ z ∊ A) ∨ q , q ⇒ z ∊ A ∪ B $ by cun_intro_r [l5]
l7: $ G , (p ∧ z ∊ A) ∨ q ⇒ z ∊ A ∪ B $ by or_elim [l1, l4, l6]

lemma c3_etb_set (G: hyps) (E K S: class) (u v: set): $ G ⇒ isset (etb u E K S v) $
----
a1: $ G ⇒ isset {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)} $ by c3_x1_set
a2: $ G ⇒ isset (clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)})) $ by c3_cc_set [a1]
b1: $ G ⇒ isset {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $ by c3_x2_set
b2: $ G ⇒ isset (clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) $ by c3_cc_set [b1]
c0: $ G ⇒ isset ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by opair_isset
c1: $ G ⇒ isset (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩) $ by csn_set [c0]
c2: $ G ⇒ isset (clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by c3_cc_set [c1]
u1: $ G ⇒ isset ((clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∪ (clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))) $ by cun_set [b2, c2]
u0: $ G ⇒ isset ((clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)})) ∪ ((clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv v ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∪ (clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))))) $ by cun_set [a2, u1]
t3a: $ G , (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by ax
t3b: $ G , (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_elim_r [t3a]
t3: $ G , (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_elim_r [t3b]
