qq1: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ j = ⟨ kc_s , scons h ∅ ⟩ $ by and_elim_l [qqr0]
qqr1: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel $ by and_elim_r [qqr0]
qq2: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ f = a $ by and_elim_l [qqr1]
qqr2: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ c = b ∧ ra_nth_ty e h a b ∈ lrel $ by and_elim_r [qqr1]
qq3: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ c = b $ by and_elim_l [qqr2]
qq4: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ ra_nth_ty e h a b ∈ lrel $ by and_elim_r [qqr2]
