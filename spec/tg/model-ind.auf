lemma c6_hctor_core {w: set} (G: hyps w) (a b x0 u d j k e f g h l i: set): $ G ⇒ ⟨ a , b ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons k ∅)) , e ⟩ ⟩ ⟩ , clam w lvals (ictor u e d (fv nvf j) (fv nvf k) w) ⟩ $ > $ G ⇒ ⟨ a , x0 ⟩ = ⟨ ⟨ f , ⟨ kc_ind_ctor , ⟨ scons g (scons h (scons l ∅)) , i ⟩ ⟩ ⟩ , clam w lvals (ictor f i g (fv nvf h) (fv nvf l) w) ⟩ $ > $ G ⇒ b = x0 $
----
k0: $ G ⇒ isset (⟨ u , ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons k ∅)) , e ⟩ ⟩ ⟩) $ by opair_isset
k0z: $ G ⇒ isset a $ by isset_var
k1: $ G ⇒ a = ⟨ u , ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons k ∅)) , e ⟩ ⟩ ⟩ $ by opair_inj_l_c [#1, k0z, k0]
k2: $ G ⇒ isset (⟨ f , ⟨ kc_ind_ctor , ⟨ scons g (scons h (scons l ∅)) , i ⟩ ⟩ ⟩) $ by opair_isset
k3: $ G ⇒ a = ⟨ f , ⟨ kc_ind_ctor , ⟨ scons g (scons h (scons l ∅)) , i ⟩ ⟩ ⟩ $ by opair_inj_l_c [#2, k0z, k2]
k4: $ G ⇒ ⟨ u , ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons k ∅)) , e ⟩ ⟩ ⟩ = a $ by eq_sym [k1]
k5: $ G ⇒ ⟨ u , ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons k ∅)) , e ⟩ ⟩ ⟩ = ⟨ f , ⟨ kc_ind_ctor , ⟨ scons g (scons h (scons l ∅)) , i ⟩ ⟩ ⟩ $ by eq_trans [k4, k3]
k6: $ G ⇒ isset u $ by isset_var
k7: $ G ⇒ isset f $ by isset_var
k8: $ G ⇒ isset ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons k ∅)) , e ⟩ ⟩ $ by opair_isset
k9: $ G ⇒ isset ⟨ kc_ind_ctor , ⟨ scons g (scons h (scons l ∅)) , i ⟩ ⟩ $ by opair_isset
k10: $ G ⇒ u = f ∧ ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons k ∅)) , e ⟩ ⟩ = ⟨ kc_ind_ctor , ⟨ scons g (scons h (scons l ∅)) , i ⟩ ⟩ $ by opair_inj_c [k5, k6, k8, k7, k9]
k11: $ G ⇒ u = f $ by and_elim_l [k10]
k12: $ G ⇒ ⟨ kc_ind_ctor , ⟨ scons d (scons j (scons k ∅)) , e ⟩ ⟩ = ⟨ kc_ind_ctor , ⟨ scons g (scons h (scons l ∅)) , i ⟩ ⟩ $ by and_elim_r [k10]
k13: $ G ⇒ kc_ind_ctor ∈ ω $ by kc_ind_ctor_omega
k14: $ G ⇒ isset kc_ind_ctor $ by wcel_isset [k13]
k15: $ G ⇒ isset ⟨ scons d (scons j (scons k ∅)) , e ⟩ $ by opair_isset
k16: $ G ⇒ isset ⟨ scons g (scons h (scons l ∅)) , i ⟩ $ by opair_isset
k17: $ G ⇒ kc_ind_ctor = kc_ind_ctor ∧ ⟨ scons d (scons j (scons k ∅)) , e ⟩ = ⟨ scons g (scons h (scons l ∅)) , i ⟩ $ by opair_inj_c [k12, k14, k15, k14, k16]
k18: $ G ⇒ ⟨ scons d (scons j (scons k ∅)) , e ⟩ = ⟨ scons g (scons h (scons l ∅)) , i ⟩ $ by and_elim_r [k17]
k19a: $ G ⇒ isset ∅ $ by ax_empty
m1: $ G ⇒ isset (scons k ∅) $ by scons_set [k19a]
m2: $ G ⇒ isset (scons j (scons k ∅)) $ by scons_set [m1]
m3: $ G ⇒ isset (scons d (scons j (scons k ∅))) $ by scons_set [m2]
m4: $ G ⇒ isset (scons l ∅) $ by scons_set [k19a]
m5: $ G ⇒ isset (scons h (scons l ∅)) $ by scons_set [m4]
m6: $ G ⇒ isset (scons g (scons h (scons l ∅))) $ by scons_set [m5]
m7: $ G ⇒ isset e $ by isset_var
m8: $ G ⇒ isset i $ by isset_var
m9: $ G ⇒ scons d (scons j (scons k ∅)) = scons g (scons h (scons l ∅)) ∧ e = i $ by opair_inj_c [k18, m3, m7, m6, m8]
m10: $ G ⇒ scons d (scons j (scons k ∅)) = scons g (scons h (scons l ∅)) $ by and_elim_l [m9]
m11: $ G ⇒ e = i $ by and_elim_r [m9]
m12: $ G ⇒ isset (suc ∅) $ by suc_set [k19a]
m13: $ G ⇒ isset d $ by isset_var
m14: $ G ⇒ fv (scons d (scons j (scons k ∅))) ∅ = d $ by scons_fv_zero_c [m13, m2]
m15: $ G ⇒ isset g $ by isset_var
m16: $ G ⇒ fv (scons g (scons h (scons l ∅))) ∅ = g $ by scons_fv_zero_c [m15, m5]
m17: $ G ⇒ ∅ = ∅ $ by eq_refl
m18: $ G ⇒ fv (scons d (scons j (scons k ∅))) (∅) = fv (scons g (scons h (scons l ∅))) (∅) $ by fv_eq [m10, m17]
m19: $ G ⇒ d = fv (scons d (scons j (scons k ∅))) (∅) $ by eq_sym [m14]
m20: $ G ⇒ d = fv (scons g (scons h (scons l ∅))) (∅) $ by eq_trans [m19, m18]
m21: $ G ⇒ d = g $ by eq_trans [m20, m16]
m22: $ G ⇒ isset d $ by isset_var
m23: $ G ⇒ fv (scons d (scons j (scons k ∅))) (suc ∅) = fv (scons j (scons k ∅)) (∅) $ by scons_fv_suc_c [m22, m2, k19a]
m24: $ G ⇒ isset j $ by isset_var
m25: $ G ⇒ fv (scons j (scons k ∅)) ∅ = j $ by scons_fv_zero_c [m24, m1]
m26: $ G ⇒ fv (scons d (scons j (scons k ∅))) (suc ∅) = j $ by eq_trans [m23, m25]
m27: $ G ⇒ isset g $ by isset_var
m28: $ G ⇒ fv (scons g (scons h (scons l ∅))) (suc ∅) = fv (scons h (scons l ∅)) (∅) $ by scons_fv_suc_c [m27, m5, k19a]
m29: $ G ⇒ isset h $ by isset_var
m30: $ G ⇒ fv (scons h (scons l ∅)) ∅ = h $ by scons_fv_zero_c [m29, m4]
m31: $ G ⇒ fv (scons g (scons h (scons l ∅))) (suc ∅) = h $ by eq_trans [m28, m30]
m32: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
m33: $ G ⇒ fv (scons d (scons j (scons k ∅))) (suc ∅) = fv (scons g (scons h (scons l ∅))) (suc ∅) $ by fv_eq [m10, m32]
m34: $ G ⇒ j = fv (scons d (scons j (scons k ∅))) (suc ∅) $ by eq_sym [m26]
m35: $ G ⇒ j = fv (scons g (scons h (scons l ∅))) (suc ∅) $ by eq_trans [m34, m33]
m36: $ G ⇒ j = h $ by eq_trans [m35, m31]
m37: $ G ⇒ isset (suc (suc ∅)) $ by suc_set [m12]
m38: $ G ⇒ isset d $ by isset_var
m39: $ G ⇒ fv (scons d (scons j (scons k ∅))) (suc (suc ∅)) = fv (scons j (scons k ∅)) (suc ∅) $ by scons_fv_suc_c [m38, m2, m12]
m40: $ G ⇒ isset j $ by isset_var
m41: $ G ⇒ fv (scons j (scons k ∅)) (suc ∅) = fv (scons k ∅) (∅) $ by scons_fv_suc_c [m40, m1, k19a]
m42: $ G ⇒ isset k $ by isset_var
m43: $ G ⇒ fv (scons k ∅) ∅ = k $ by scons_fv_zero_c [m42, k19a]
m44: $ G ⇒ fv (scons d (scons j (scons k ∅))) (suc (suc ∅)) = fv (scons k ∅) (∅) $ by eq_trans [m39, m41]
m45: $ G ⇒ fv (scons d (scons j (scons k ∅))) (suc (suc ∅)) = k $ by eq_trans [m44, m43]
m46: $ G ⇒ isset g $ by isset_var
m47: $ G ⇒ fv (scons g (scons h (scons l ∅))) (suc (suc ∅)) = fv (scons h (scons l ∅)) (suc ∅) $ by scons_fv_suc_c [m46, m5, m12]
m48: $ G ⇒ isset h $ by isset_var
m49: $ G ⇒ fv (scons h (scons l ∅)) (suc ∅) = fv (scons l ∅) (∅) $ by scons_fv_suc_c [m48, m4, k19a]
