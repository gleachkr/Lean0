lemma c3_etb_k2 {w r a y: set} (G: hyps) (E K S V: class) (u: set): $ G ⇒ K = kc_app $ > $ G ⇒ etb u E K S V = clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)}) $
