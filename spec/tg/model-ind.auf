b18: $ G , v = X , X ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn X q ∈ da (fv E F) W q) ⇒ v ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn v q ∈ da (fv E F) W q) $ by and_intro [b5, b17]
b19: $ G , v = X , X ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn X q ∈ da (fv E F) W q) ⇒ v ∊ ipi U E P F W $ by cab_intro [b18]
b20: $ G , v = X , X ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn X q ∈ da (fv E F) W q) ⇒ v ∈ ipi U E P F W $ by welc_wcel [b19]
b21: $ G , v = X , X ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn X q ∈ da (fv E F) W q) ⇒ X ∈ ipi U E P F W $ by wcel_eq_l [b3, b20]
c1: $ G , v = X ⇒ X ∈ ipi U E P F W ↔ (X ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn X q ∈ da (fv E F) W q)) $ by bi_intro [a20, b21]
c2: $ G ⇒ X ∈ ipi U E P F W ↔ (X ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn X q ∈ da (fv E F) W q)) $ by isset_elim [#1, c1]

ipi_nil
-------
q0: $ G ⇒ isset ∅ $ by ax_empty
p1: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w $ by ax
p2: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ y = nest p z)} ∧ ∀ q (q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w → apn x q ∈ da (fv E F) w q) $ by cab_elim [p1]
p3: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ ∀ q (q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w → apn x q ∈ da (fv E F) w q) $ by and_elim_r [p2]
p4: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ e ∊ esat u E ⟨ kc_nil , ∅ ⟩ w → apn x e ∈ da (fv E F) w e $ by all_elim [p3]
p5: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ e = ∅ $ by ax
p6: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ e ∊ csn ∅ $ by csn_intro [p5]
p7: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ w ∊ lvals $ by weaken [#1]
p8: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ esat u E ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by esat_nil [p7]
p9: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ csn ∅ = esat u E ⟨ kc_nil , ∅ ⟩ w $ by eq_sym [p8]
p10: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ e ∊ esat u E ⟨ kc_nil , ∅ ⟩ w $ by welc_eq [p9, p6]
p11: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ apn x e ∈ da (fv E F) w e $ by imp_elim [p4, p10]
p12a: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ x = x $ by eq_refl
p12: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ apn x e = apn x ∅ $ by apn_eq [p12a, p5]
p13: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ apn x ∅ = x $ by apn_empty
p14: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ apn x e = x $ by eq_trans [p12, p13]
p15: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ x ∈ da (fv E F) w e $ by wcel_eq_l [p14, p11]
p16: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ fv E F = fv E F $ by eq_refl
p17: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ w = w $ by eq_refl
p18: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ da (fv E F) w e = da (fv E F) w ∅ $ by da_eq [p16, p17, p5]
p19: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ x ∈ da (fv E F) w ∅ $ by wcel_eq_r [p18, p15]
p20: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w , e = ∅ ⇒ x ∊ da (fv E F) w ∅ $ by wcel_welc [p19]
p21: $ G , x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w ⇒ x ∊ da (fv E F) w ∅ $ by isset_elim [q0, p20]
r1: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ isset v $ by isset_var
r2: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ nest ∅ v = v $ by nest_empty [r1]
r3: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ e = ∅ $ by ax
r3b: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ v = v $ by eq_refl
r3c: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ nest e v = nest ∅ v $ by nest_eq [r3, r3b]
r4: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ nest e v = v $ by eq_trans [r3c, r2]
r5: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ v = nest e v $ by eq_sym [r4]
r6a: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ e ∊ csn ∅ $ by csn_intro [r3]
r6b: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ w ∊ lvals $ by weaken [#1]
r6c: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ esat u E ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by esat_nil [r6b]
r6d: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ csn ∅ = esat u E ⟨ kc_nil , ∅ ⟩ w $ by eq_sym [r6c]
r6: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ e ∊ esat u E ⟨ kc_nil , ∅ ⟩ w $ by welc_eq [r6d, r6a]
r7: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ e ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ v = nest e v $ by and_intro [r6, r5]
r8: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ ∃ z (e ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ v = nest e z) $ by ex_intro [r7]
r9: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ ∃ p ∃ z (p ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ v = nest p z) $ by ex_intro [r8]
r10: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , v ∊ x ⇒ v ∊ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ y = nest p z)} $ by cab_intro [r9]
r11: $ G , x ∊ da (fv E F) w ∅ , e = ∅ ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ y = nest p z)} $ by subset_intro [r10]
s1: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w $ by ax
s2a: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ w ∊ lvals $ by weaken [#1]
s2: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ esat u E ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by esat_nil [s2a]
s3: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ q ∊ csn ∅ $ by welc_eq [s2, s1]
s4: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ q = ∅ $ by csn_elim [s3]
s5a: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ x = x $ by eq_refl
s5: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ apn x q = apn x ∅ $ by apn_eq [s5a, s4]
s6: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ apn x ∅ = x $ by apn_empty
s7: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ apn x q = x $ by eq_trans [s5, s6]
s8: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ x = apn x q $ by eq_sym [s7]
s9: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ x ∊ da (fv E F) w ∅ $ by ax
s10: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ x ∈ da (fv E F) w ∅ $ by welc_wcel [s9]
s11: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ apn x q ∈ da (fv E F) w ∅ $ by wcel_eq_l [s8, s10]
s12a: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ fv E F = fv E F $ by eq_refl
s12b: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ w = w $ by eq_refl
s12: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ da (fv E F) w q = da (fv E F) w ∅ $ by da_eq [s12a, s12b, s4]
s13: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ da (fv E F) w ∅ = da (fv E F) w q $ by eq_sym [s12]
s14: $ G , x ∊ da (fv E F) w ∅ , e = ∅ , q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ⇒ apn x q ∈ da (fv E F) w q $ by wcel_eq_r [s13, s11]
s15: $ G , x ∊ da (fv E F) w ∅ , e = ∅ ⇒ q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w → apn x q ∈ da (fv E F) w q $ by imp_intro [s14]
s16: $ G , x ∊ da (fv E F) w ∅ , e = ∅ ⇒ ∀ q (q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w → apn x q ∈ da (fv E F) w q) $ by all_intro [s15]
t1: $ G , x ∊ da (fv E F) w ∅ , e = ∅ ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ y = nest p z)} ∧ ∀ q (q ∊ esat u E ⟨ kc_nil , ∅ ⟩ w → apn x q ∈ da (fv E F) w q) $ by and_intro [r11, s16]
t2: $ G , x ∊ da (fv E F) w ∅ , e = ∅ ⇒ x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w $ by cab_intro [t1]
t3: $ G , x ∊ da (fv E F) w ∅ ⇒ x ∊ ipi u E ⟨ kc_nil , ∅ ⟩ F w $ by isset_elim [q0, t2]
t4: $ G ⇒ ipi u E ⟨ kc_nil , ∅ ⟩ F w = da (fv E F) w ∅ $ by eq_intro [p21, t3]

lemma i3_nsub {y p z: set} (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $
----
a1: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} $ by ax
a2: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ ∃ p ∃ z (p ∊ A ∧ v = nest p z) $ by cab_elim [a1]
b1: $ G , p ∊ A ∧ v = nest p z ⇒ p ∊ A ∧ v = nest p z $ by ax
b2: $ G , p ∊ A ∧ v = nest p z ⇒ p ∊ A $ by and_elim_l [b1]
b3: $ G , p ∊ A ∧ v = nest p z ⇒ v = nest p z $ by and_elim_r [b1]
b4: $ G , p ∊ A ∧ v = nest p z ⇒ A = B $ by weaken [#1]
b5: $ G , p ∊ A ∧ v = nest p z ⇒ p ∊ B $ by welc_eq [b4, b2]
b6: $ G , p ∊ A ∧ v = nest p z ⇒ p ∊ B ∧ v = nest p z $ by and_intro [b5, b3]
b7: $ G , p ∊ A ∧ v = nest p z ⇒ ∃ z (p ∊ B ∧ v = nest p z) $ by ex_intro [b6]
b8: $ G , p ∊ A ∧ v = nest p z ⇒ ∃ p ∃ z (p ∊ B ∧ v = nest p z) $ by ex_intro [b7]
b9: $ G , p ∊ A ∧ v = nest p z ⇒ v ∊ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by cab_intro [b8]
e0: $ G , ∃ z (p ∊ A ∧ v = nest p z) ⇒ ∃ z (p ∊ A ∧ v = nest p z) $ by ax
e1: $ G , ∃ z (p ∊ A ∧ v = nest p z) ⇒ v ∊ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by ex_elim [e0, b9]
e2: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ v ∊ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by ex_elim [a2, e1]
e3: $ G ⇒ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by subset_intro [e2]

lemma i3_ipi_sub (G: hyps) (U E E2 P P2 F F2 W W2: class): $ G ⇒ esat U E P W = esat U E2 P2 W2 $ > $ G ⇒ fv E F = fv E2 F2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ipi U E P F W ⊆ ipi U E2 P2 F2 W2 $
----
c1: $ G , x ∊ ipi U E P F W ⇒ x ∊ ipi U E P F W $ by ax
c2: $ G , x ∊ ipi U E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn x q ∈ da (fv E F) W q) $ by cab_elim [c1]
c3: $ G , x ∊ ipi U E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} $ by and_elim_l [c2]
c4a: $ G , x ∊ ipi U E P F W ⇒ esat U E P W = esat U E2 P2 W2 $ by weaken [#1]
c4: $ G , x ∊ ipi U E P F W ⇒ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ esat U E2 P2 W2 ∧ y = nest p z)} $ by i3_nsub [c4a]
c5: $ G , x ∊ ipi U E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat U E2 P2 W2 ∧ y = nest p z)} $ by subset_trans [c3, c4]
c6: $ G , x ∊ ipi U E P F W ⇒ ∀ q (q ∊ esat U E P W → apn x q ∈ da (fv E F) W q) $ by and_elim_r [c2]
d5: $ G , x ∊ ipi U E P F W ⇒ q ∊ esat U E P W → apn x q ∈ da (fv E F) W q $ by all_elim [c6]
d1: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ q ∊ esat U E2 P2 W2 $ by ax
d2: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ esat U E P W = esat U E2 P2 W2 $ by weaken [#1]
d3: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ esat U E2 P2 W2 = esat U E P W $ by eq_sym [d2]
d4: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ q ∊ esat U E P W $ by welc_eq [d3, d1]
d6: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ q ∊ esat U E P W → apn x q ∈ da (fv E F) W q $ by weaken [d5]
d7: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ apn x q ∈ da (fv E F) W q $ by imp_elim [d6, d4]
d8: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ fv E F = fv E2 F2 $ by weaken [#2]
d9: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ W = W2 $ by weaken [#3]
d10: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ q = q $ by eq_refl
d11: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ da (fv E F) W q = da (fv E2 F2) W2 q $ by da_eq [d8, d9, d10]
d12: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ apn x q ∈ da (fv E2 F2) W2 q $ by wcel_eq_r [d11, d7]
d13: $ G , x ∊ ipi U E P F W ⇒ q ∊ esat U E2 P2 W2 → apn x q ∈ da (fv E2 F2) W2 q $ by imp_intro [d12]
d14: $ G , x ∊ ipi U E P F W ⇒ ∀ q (q ∊ esat U E2 P2 W2 → apn x q ∈ da (fv E2 F2) W2 q) $ by all_intro [d13]
d15: $ G , x ∊ ipi U E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat U E2 P2 W2 ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E2 P2 W2 → apn x q ∈ da (fv E2 F2) W2 q) $ by and_intro [c5, d14]
d16: $ G , x ∊ ipi U E P F W ⇒ x ∊ ipi U E2 P2 F2 W2 $ by cab_intro [d15]
d17: $ G ⇒ ipi U E P F W ⊆ ipi U E2 P2 F2 W2 $ by subset_intro [d16]

lemma i3_ipi_eq (G: hyps) (U E P P2 F F2 W: class) (W2: class): $ G ⇒ P = P2 $ > $ G ⇒ F = F2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ipi U E P F W = ipi U E P2 F2 W2 $
----
e1b: $ G ⇒ esf U E = esf U E $ by eq_refl
e2: $ G ⇒ fv (esf U E) P = fv (esf U E) P2 $ by fv_eq [e1b, #1]
e3: $ G ⇒ esat U E P W = esat U E P2 W2 $ by ap_eq [e2, #3]
e4: $ G ⇒ E = E $ by eq_refl
e5: $ G ⇒ fv E F = fv E F2 $ by fv_eq [e4, #2]
e6: $ G ⇒ ipi U E P F W ⊆ ipi U E P2 F2 W2 $ by i3_ipi_sub [e3, e5, #3]
e7: $ G ⇒ P2 = P $ by eq_sym [#1]
e8: $ G ⇒ F2 = F $ by eq_sym [#2]
e9: $ G ⇒ W2 = W $ by eq_sym [#3]
e10: $ G ⇒ fv (esf U E) P2 = fv (esf U E) P $ by fv_eq [e1b, e7]
e11: $ G ⇒ esat U E P2 W2 = esat U E P W $ by ap_eq [e10, e9]
e12: $ G ⇒ fv E F2 = fv E F $ by fv_eq [e4, e8]
e13: $ G ⇒ ipi U E P2 F2 W2 ⊆ ipi U E P F W $ by i3_ipi_sub [e11, e12, e9]
e14: $ G ⇒ ipi U E P F W = ipi U E P2 F2 W2 $ by subset_antisym [e6, e13]

ipi_local
---------
l1: $ G ⇒ esat u E P W = esat u E2 P W $ by esat_local [#1, #3]
l2: $ G ⇒ F ∈ fv tsub F $ by tsub_self [#2]
m1: $ G , b = F , b ∊ fv tsub F ⇒ eagr E E2 F $ by weaken [#4]
