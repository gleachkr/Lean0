l6: $ G ⇒ ityv u E D J W = ityv u E2 D J W $ by subset_antisym [l4, l5]

lemma i3_igate_eq (G: hyps) (E D D2 J J2 W W2: class) (u: set): $ G ⇒ D = D2 $ > $ G ⇒ J = J2 $ > $ G ⇒ W = W2 $ > $ G ⇒ igate u E D J W $ > $ G ⇒ igate u E D2 J2 W2 $
----
z1: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W $ by ax
z2: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ iprt D p t $ by and_elim_l [z1]
z3: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W $ by and_elim_r [z1]
z4: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ityf D J f $ by and_elim_l [z3]
z5: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ity u E D J W ∈ ipi u E p f W $ by and_elim_r [z3]
z6: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ D = D2 $ by weaken [#1]
z7: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ J = J2 $ by weaken [#2]
z8: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ W = W2 $ by weaken [#3]
z9: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ p = p $ by eq_refl
z10: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ t = t $ by eq_refl
z11: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ f = f $ by eq_refl
z12: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ iprt D2 p t $ by iprt_eq [z6, z9, z10, z2]
z13: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ityf D2 J2 f $ by ityf_eq [z6, z7, z11, z4]
z14: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ity u E D J W = ity u E D2 J2 W2 $ by ity_eq [z6, z7, z8]
z15: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ipi u E p f W = ipi u E p f W2 $ by i3_ipi_eq [z9, z11, z8]
z16: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ity u E D2 J2 W2 ∈ ipi u E p f W $ by wcel_eq_l [z14, z5]
z17: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ity u E D2 J2 W2 ∈ ipi u E p f W2 $ by wcel_eq_r [z15, z16]
z18: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ityf D2 J2 f ∧ ity u E D2 J2 W2 ∈ ipi u E p f W2 $ by and_intro [z13, z17]
z19: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ iprt D2 p t ∧ ityf D2 J2 f ∧ ity u E D2 J2 W2 ∈ ipi u E p f W2 $ by and_intro [z12, z18]
z20: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ∃ f (iprt D2 p t ∧ ityf D2 J2 f ∧ ity u E D2 J2 W2 ∈ ipi u E p f W2) $ by ex_intro [z19]
z21: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ ∃ t ∃ f (iprt D2 p t ∧ ityf D2 J2 f ∧ ity u E D2 J2 W2 ∈ ipi u E p f W2) $ by ex_intro [z20]
z22: $ G , iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W ⇒ igate u E D2 J2 W2 $ by ex_intro [z21]
y0: $ G , ∃ f (iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W) ⇒ ∃ f (iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W) $ by ax
y1: $ G , ∃ f (iprt D p t ∧ ityf D J f ∧ ity u E D J W ∈ ipi u E p f W) ⇒ igate u E D2 J2 W2 $ by ex_elim [y0, z22]
