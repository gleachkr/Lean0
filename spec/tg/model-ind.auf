i1: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ , c ∊ crn h ⇒ c ∊ crn h $ by ax
i2: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ , c ∊ crn h ⇒ crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} $ by ax
i3: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ , c ∊ crn h ⇒ c ∊ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} $ by subset_elim [i2, i1]
i4: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ , c ∊ crn h ⇒ fv (cvf u H) c = cres (dnf u (mcv H)) (fv tsub c) $ by cab_elim [i3]
i5: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ ⇒ c ∊ crn h → fv (cvf u H) c = cres (dnf u (mcv H)) (fv tsub c) $ by imp_intro [i4]
i6: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ ⇒ ∀ c (c ∊ crn h → fv (cvf u H) c = cres (dnf u (mcv H)) (fv tsub c)) $ by all_intro [i5]
z1: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ ⇒ k ∊ ω $ by ax
z2: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ ⇒ h ∊ fseq (trees ω) $ by ax
z3: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ ⇒ z = ⟨ k , h ⟩ $ by ax
w6: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} , z = ⟨ k , h ⟩ ⇒ fv (cvf u H) z = cres (dnf u (mcv H)) (fv tsub z) $ by c1_cvf_step [z1, z2, z3, i6]
w7: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} ⇒ isset ⟨ k , h ⟩ $ by opair_isset
w8: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} ⇒ ⟨ k , h ⟩ ∈ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} $ by wcel_cab_intro [w7, w6]
s9: $ G , k ∊ ω , h ∊ fseq (trees ω) ⇒ crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} → ⟨ k , h ⟩ ∈ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} $ by imp_intro [w8]
s10: $ G , k ∊ ω ⇒ h ∊ fseq (trees ω) → crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} → ⟨ k , h ⟩ ∈ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} $ by imp_intro [s9]
s11: $ G ⇒ k ∊ ω → h ∊ fseq (trees ω) → crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} → ⟨ k , h ⟩ ∈ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} $ by imp_intro [s10]
s12: $ G ⇒ ∀ h (k ∊ ω → h ∊ fseq (trees ω) → crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} → ⟨ k , h ⟩ ∈ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)}) $ by all_intro [s11]
s13: $ G ⇒ ∀ k ∀ h (k ∊ ω → h ∊ fseq (trees ω) → crn h ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} → ⟨ k , h ⟩ ∈ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)}) $ by all_intro [s12]
j0: $ G ⇒ isset ω $ by omega_set
j2: $ G ⇒ trees ω ⊆ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} $ by trees_ind_c [j0, s13]
j3: $ G ⇒ t ∊ {x0 | fv (cvf u H) x0 = cres (dnf u (mcv H)) (fv tsub x0)} $ by subset_elim [j2, #1]
j4: $ G ⇒ fv (cvf u H) t = cres (dnf u (mcv H)) (fv tsub t) $ by cab_elim [j3]

lemma c1_pair_set (G: hyps) {v: set} (B: class) (h: set): $ G ⇒ ∃ v (⟨ h , B ⟩ = ⟨ h , v ⟩) $
----
a0: $ G , isset B ⇒ isset B $ by ax
a1: $ G , isset B , e = B ⇒ e = B $ by ax
a2: $ G , isset B , e = B ⇒ B = e $ by eq_sym [a1]
a3: $ G , isset B , e = B ⇒ h = h $ by eq_refl
a4: $ G , isset B , e = B ⇒ ⟨ h , B ⟩ = ⟨ h , e ⟩ $ by opair_eq [a3, a2]
a5: $ G , isset B , e = B ⇒ ∃ v (⟨ h , B ⟩ = ⟨ h , v ⟩) $ by ex_intro [a4]
a6: $ G , isset B ⇒ ∃ v (⟨ h , B ⟩ = ⟨ h , v ⟩) $ by isset_elim [a0, a5]
b0: $ G , ¬ isset B ⇒ ¬ isset B $ by ax
b1: $ G , ¬ isset B ⇒ ⟨ h , B ⟩ = ⟨ h , h ⟩ $ by opair_proper [b0]
b2: $ G , ¬ isset B ⇒ ∃ v (⟨ h , B ⟩ = ⟨ h , v ⟩) $ by ex_intro [b1]
c0: $ G ⇒ isset B ∨ ¬ isset B $ by excluded_middle
c1: $ G ⇒ ∃ v (⟨ h , B ⟩ = ⟨ h , v ⟩) $ by or_elim [c0, a6, b2]

lemma c1_mcv_fv_set (G: hyps) (H: class) (u k h v: set): $ G ⇒ functional H $ > $ G ⇒ h ∊ fseq (trees ω) $ > $ G ⇒ fv (mcv H) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ ⟩ $
----
q1: $ G ⇒ ap (mcv H) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ = ap (csn ⟨ ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ , fv H ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ ⟩) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ $ by c1_mcv_ap
q2: $ G ⇒ fv (mcv H) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ = fv (csn ⟨ ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ , fv H ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ ⟩) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ $ by cuni_eq [q1]
q3a: $ G ⇒ isset ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ $ by opair_isset
q3b: $ G ⇒ isset ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ $ by opair_isset
q3c: $ G ⇒ isset (fv H ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩) $ by fv_set_c [#1, q3b]
q3: $ G ⇒ fv (csn ⟨ ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ , fv H ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ ⟩) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ $ by fv_csn_c [q3a, q3c]
i1: $ G , c ∊ crn h ⇒ c ∊ crn h $ by ax
i2a: $ G , c ∊ crn h ⇒ h ∊ fseq (trees ω) $ by weaken [#2]
i2: $ G , c ∊ crn h ⇒ crn h ⊆ trees ω $ by fseq_crn [i2a]
i3: $ G , c ∊ crn h ⇒ c ∊ trees ω $ by subset_elim [i2, i1]
i4: $ G , c ∊ crn h ⇒ fv (cvf u H) c = cres (dnf u (mcv H)) (fv tsub c) $ by cvf_tab [i3]
i5: $ G ⇒ c ∊ crn h → fv (cvf u H) c = cres (dnf u (mcv H)) (fv tsub c) $ by imp_intro [i4]
i6: $ G ⇒ ∀ c (c ∊ crn h → fv (cvf u H) c = cres (dnf u (mcv H)) (fv tsub c)) $ by all_intro [i5]
n1: $ G ⇒ functional (cvf u H) $ by cvf_functional
n3: $ G ⇒ cdm (cvf u H) = trees ω $ by cvf_cdm
q4: $ G ⇒ ⋃ (crn (ccom (cvf u H) h)) = cres (dnf u (mcv H)) (psub h) $ by c1_uc [n1, #2, n3, i6]
q5a: $ G ⇒ h = h $ by eq_refl
q5b: $ G ⇒ k = k $ by eq_refl
q5c: $ G ⇒ u = u $ by eq_refl
q5d: $ G ⇒ H = H $ by eq_refl
q5e: $ G ⇒ ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ = ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ $ by opair_eq [q5a, q4]
q5f: $ G ⇒ ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ = ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ $ by opair_eq [q5b, q5e]
q5g: $ G ⇒ ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ = ⟨ u , ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ ⟩ $ by opair_eq [q5c, q5f]
q5: $ G ⇒ fv H ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ ⟩ $ by fv_eq [q5d, q5g]
q6: $ G ⇒ fv (mcv H) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ $ by eq_trans [q2, q3]
q7: $ G ⇒ fv (mcv H) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ ⟩ $ by eq_trans [q6, q5]

mcv_fv
------
c0: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ ∃ v (⟨ h , V ⟩ = ⟨ h , v ⟩) $ by c1_pair_set
d0a: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ functional H $ by weaken [#1]
d0b: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ h ∊ fseq (trees ω) $ by ax
d1: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ fv (mcv H) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ ⟩ $ by c1_mcv_fv_set [d0a, d0b]
d2a: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ h = S $ by ax
d2b: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ S = h $ by eq_sym [d2a]
d2c: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ V = V $ by eq_refl
d2d: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⟨ S , V ⟩ = ⟨ h , V ⟩ $ by opair_eq [d2b, d2c]
d2e: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⟨ h , V ⟩ = ⟨ h , v ⟩ $ by ax
d2f: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⟨ S , V ⟩ = ⟨ h , v ⟩ $ by eq_trans [d2d, d2e]
d2g: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ k = K $ by ax
d2h: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ K = k $ by eq_sym [d2g]
d2i: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⟨ K , ⟨ S , V ⟩ ⟩ = ⟨ k , ⟨ h , v ⟩ ⟩ $ by opair_eq [d2h, d2f]
d2j: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ u = u $ by eq_refl
d2: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ $ by opair_eq [d2j, d2i]
d3a: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ mcv H = mcv H $ by eq_refl
d3: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ fv (mcv H) ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = fv (mcv H) ⟨ u , ⟨ k , ⟨ h , v ⟩ ⟩ ⟩ $ by fv_eq [d3a, d2]
d4a: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ tsub = tsub $ by eq_refl
d4b: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ccom tsub h = ccom tsub S $ by ccom_eq [d4a, d2a]
d4c: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ crn (ccom tsub h) = crn (ccom tsub S) $ by crn_eq [d4b]
d4d: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⋃ (crn (ccom tsub h)) = ⋃ (crn (ccom tsub S)) $ by cuni_eq [d4c]
d4e: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ dnf u (mcv H) = dnf u (mcv H) $ by eq_refl
d4: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ cres (dnf u (mcv H)) (psub h) = cres (dnf u (mcv H)) (psub S) $ by cres_eq [d4e, d4d]
d5a: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ = ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ $ by opair_eq [d2a, d4]
d5b: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ = ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ $ by opair_eq [d2g, d5a]
d5: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ ⟨ u , ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ ⟩ = ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩ $ by opair_eq [d2j, d5b]
d6a: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ H = H $ by eq_refl
d6: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ fv H ⟨ u , ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩ $ by fv_eq [d6a, d5]
d7a: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ fv (mcv H) ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ k , ⟨ h , cres (dnf u (mcv H)) (psub h) ⟩ ⟩ ⟩ $ by eq_trans [d3, d1]
d7: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , ⟨ h , V ⟩ = ⟨ h , v ⟩ ⇒ fv (mcv H) ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩ $ by eq_trans [d7a, d6]
c1: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ fv (mcv H) ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩ $ by ex_elim [c0, d7]
c2: $ G , k = K , k ∊ ω ⇒ fv (mcv H) ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩ $ by wcel_elim [#3, c1]
c3: $ G ⇒ fv (mcv H) ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩ $ by wcel_elim [#2, c2]

dt_mcv
------
l1: $ G ⇒ dt u (mcv H) ⟨ K , S ⟩ w r = mclip u (ap (fv (mcv H) ⟨ u , ⟨ K , ⟨ S , ccom (dnf u (mcv H)) S ⟩ ⟩ ⟩) w) $ by dt_atom [#2, #3, #4, #5]
l2: $ G ⇒ kexa ⊆ ω $ by kexa_omega
l3: $ G ⇒ K ∈ ω $ by wcel_subset [l2, #2]
l4: $ G ⇒ fv (mcv H) ⟨ u , ⟨ K , ⟨ S , ccom (dnf u (mcv H)) S ⟩ ⟩ ⟩ = fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩ $ by mcv_fv [#1, l3, #3]
l5: $ G ⇒ w = w $ by eq_refl
l6: $ G ⇒ ap (fv (mcv H) ⟨ u , ⟨ K , ⟨ S , ccom (dnf u (mcv H)) S ⟩ ⟩ ⟩) w = ap (fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩) w $ by ap_eq [l4, l5]
l7: $ G ⇒ u = u $ by eq_refl
l8: $ G ⇒ mclip u (ap (fv (mcv H) ⟨ u , ⟨ K , ⟨ S , ccom (dnf u (mcv H)) S ⟩ ⟩ ⟩) w) = mclip u (ap (fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩) w) $ by mclip_eq [l7, l6]
l9: $ G ⇒ dt u (mcv H) ⟨ K , S ⟩ w r = mclip u (ap (fv H ⟨ u , ⟨ K , ⟨ S , cres (dnf u (mcv H)) (psub S) ⟩ ⟩ ⟩) w) $ by eq_trans [l1, l8]

--| A relation on the trees has no value at `∅` (not a tree).
lemma c3_fv0 (G: hyps) (R: class): $ G ⇒ cdm R ⊆ trees ω $ > $ G ⇒ fv R ∅ = ∅ $
----
a1: $ G , e = ∅ , e ∊ cdm R ⇒ e ∊ cdm R $ by ax
a2: $ G , e = ∅ , e ∊ cdm R ⇒ cdm R ⊆ trees ω $ by weaken [#1]
a3: $ G , e = ∅ , e ∊ cdm R ⇒ e ∊ trees ω $ by subset_elim [a2, a1]
a4: $ G , e = ∅ , e ∊ cdm R ⇒ isset ω $ by omega_set
a5: $ G , e = ∅ , e ∊ cdm R ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [a4]
a6: $ G , e = ∅ , e ∊ cdm R ⇒ trees ω = ω × fseq (trees ω) $ by eq_sym [a5]
a7: $ G , e = ∅ , e ∊ cdm R ⇒ e ∊ ω × fseq (trees ω) $ by welc_eq [a6, a3]
b1: $ G , e = ∅ , e = ⟨ x , y ⟩ , x ∊ ω , y ∊ fseq (trees ω) ⇒ e = ⟨ x , y ⟩ $ by ax
b2: $ G , e = ∅ , e = ⟨ x , y ⟩ , x ∊ ω , y ∊ fseq (trees ω) ⇒ ⟨ x , y ⟩ = e $ by eq_sym [b1]
b3: $ G , e = ∅ , e = ⟨ x , y ⟩ , x ∊ ω , y ∊ fseq (trees ω) ⇒ e = ∅ $ by ax
b4: $ G , e = ∅ , e = ⟨ x , y ⟩ , x ∊ ω , y ∊ fseq (trees ω) ⇒ ⟨ x , y ⟩ = ∅ $ by eq_trans [b2, b3]
b5: $ G , e = ∅ , e = ⟨ x , y ⟩ , x ∊ ω , y ∊ fseq (trees ω) ⇒ ⊥ $ by opair_ne_empty [b4]
a8: $ G , e = ∅ , e ∊ cdm R ⇒ ⊥ $ by cxp_elim [a7, b5]
a9: $ G , e = ∅ ⇒ e ∊ cdm R → ⊥ $ by imp_intro [a8]
a10: $ G , e = ∅ ⇒ fv R e = ∅ $ by fv_empty [a9]
a11: $ G , e = ∅ ⇒ R = R $ by eq_refl
a12a: $ G , e = ∅ ⇒ e = ∅ $ by ax
a12: $ G , e = ∅ ⇒ ∅ = e $ by eq_sym [a12a]
a13: $ G , e = ∅ ⇒ fv R ∅ = fv R e $ by fv_eq [a11, a12]
a14: $ G , e = ∅ ⇒ fv R ∅ = ∅ $ by eq_trans [a13, a10]
a15: $ G ⇒ isset ∅ $ by ax_empty
a16: $ G ⇒ fv R ∅ = ∅ $ by isset_elim [a15, a14]

eagr_psub
---------
a0: $ G ⇒ fv tsub (fv S i) ⊆ psub S $ by psub_child [#1, #2]
a1: $ G , t ∊ fv tsub (fv S i) ⇒ fv tsub (fv S i) ⊆ psub S $ by weaken [a0]
a1b: $ G , t ∊ fv tsub (fv S i) ⇒ t ∊ fv tsub (fv S i) $ by ax
a2: $ G , t ∊ fv tsub (fv S i) ⇒ t ∊ psub S $ by subset_elim [a1, a1b]
a3: $ G , t ∊ fv tsub (fv S i) ⇒ functional (dnf u M) $ by dnf_functional
a4: $ G , t ∊ fv tsub (fv S i) ⇒ fv (cres (dnf u M) (psub S)) t = fv (dnf u M) t $ by fv_cres [a3, a2]
a5: $ G ⇒ t ∊ fv tsub (fv S i) → fv (cres (dnf u M) (psub S)) t = fv (dnf u M) t $ by imp_intro [a4]
a6: $ G ⇒ ∀ t (t ∊ fv tsub (fv S i) → fv (cres (dnf u M) (psub S)) t = fv (dnf u M) t) $ by all_intro [a5]
p1: $ G ⇒ cres (dnf u M) (psub S) ⊆ dnf u M $ by cres_subset
p2: $ G ⇒ cdm (cres (dnf u M) (psub S)) ⊆ cdm (dnf u M) $ by cdm_mono [p1]
p3: $ G ⇒ cdm (dnf u M) = trees ω $ by dnf_cdm
p4: $ G ⇒ cdm (cres (dnf u M) (psub S)) ⊆ trees ω $ by subset_eq_r [p3, p2]
p5: $ G ⇒ fv (cres (dnf u M) (psub S)) ∅ = ∅ $ by c3_fv0 [p4]
p6: $ G ⇒ cdm (dnf u M) ⊆ trees ω $ by eq_subset [p3]
p7: $ G ⇒ fv (dnf u M) ∅ = ∅ $ by c3_fv0 [p6]
p8: $ G ⇒ ∅ = fv (dnf u M) ∅ $ by eq_sym [p7]
p9: $ G ⇒ fv (cres (dnf u M) (psub S)) ∅ = fv (dnf u M) ∅ $ by eq_trans [p5, p8]
p10: $ G ⇒ fv (cres (dnf u M) (psub S)) ∅ = fv (dnf u M) ∅ ∧ ∀ t (t ∊ fv tsub (fv S i) → fv (cres (dnf u M) (psub S)) t = fv (dnf u M) t) $ by and_intro [p9, a6]

eagr_sub
--------
b0: $ G ⇒ fv tsub T2 ⊆ fv tsub T $ by tsub_trans [#2]
b2p: $ G ⇒ ∀ t (t ∊ fv tsub T → fv E t = fv E2 t) $ by and_elim_r [#1]
b1a: $ G , t ∊ fv tsub T2 ⇒ fv tsub T2 ⊆ fv tsub T $ by weaken [b0]
b1b: $ G , t ∊ fv tsub T2 ⇒ t ∊ fv tsub T2 $ by ax
b1: $ G , t ∊ fv tsub T2 ⇒ t ∊ fv tsub T $ by subset_elim [b1a, b1b]
b2: $ G , t ∊ fv tsub T2 ⇒ ∀ t (t ∊ fv tsub T → fv E t = fv E2 t) $ by weaken [b2p]
b3: $ G , t ∊ fv tsub T2 ⇒ t ∊ fv tsub T → fv E t = fv E2 t $ by all_elim [b2]
b4: $ G , t ∊ fv tsub T2 ⇒ fv E t = fv E2 t $ by imp_elim [b3, b1]
b5: $ G ⇒ t ∊ fv tsub T2 → fv E t = fv E2 t $ by imp_intro [b4]
b6: $ G ⇒ ∀ t (t ∊ fv tsub T2 → fv E t = fv E2 t) $ by all_intro [b5]
b7: $ G ⇒ fv E ∅ = fv E2 ∅ $ by and_elim_l [#1]
b8: $ G ⇒ fv E ∅ = fv E2 ∅ ∧ ∀ t (t ∊ fv tsub T2 → fv E t = fv E2 t) $ by and_intro [b7, b6]

eagr_sym
--------
l0: $ G ⇒ ∀ t (t ∊ fv tsub T → fv E t = fv E2 t) $ by and_elim_r [#1]
l1: $ G ⇒ t ∊ fv tsub T → fv E t = fv E2 t $ by all_elim [l0]
l2: $ G , t ∊ fv tsub T ⇒ t ∊ fv tsub T → fv E t = fv E2 t $ by weaken [l1]
l3: $ G , t ∊ fv tsub T ⇒ t ∊ fv tsub T $ by ax
l4: $ G , t ∊ fv tsub T ⇒ fv E t = fv E2 t $ by imp_elim [l2, l3]
l5: $ G , t ∊ fv tsub T ⇒ fv E2 t = fv E t $ by eq_sym [l4]
l6: $ G ⇒ t ∊ fv tsub T → fv E2 t = fv E t $ by imp_intro [l5]
l7: $ G ⇒ ∀ t (t ∊ fv tsub T → fv E2 t = fv E t) $ by all_intro [l6]
l8: $ G ⇒ fv E ∅ = fv E2 ∅ $ by and_elim_l [#1]
l9: $ G ⇒ fv E2 ∅ = fv E ∅ $ by eq_sym [l8]
l10: $ G ⇒ fv E2 ∅ = fv E ∅ ∧ ∀ t (t ∊ fv tsub T → fv E2 t = fv E t) $ by and_intro [l9, l7]

eagr_at
-------
l0: $ G ⇒ ∀ t (t ∊ fv tsub T → fv E t = fv E2 t) $ by and_elim_r [#1]
l1: $ G ⇒ b ∊ fv tsub T → fv E b = fv E2 b $ by all_elim [l0]
l2: $ G ⇒ fv E b = fv E2 b $ by imp_elim [l1, #2]

nstep_congr
-----------
l1: $ i ≐ i $ by ceqt_refl
l2: $ a ≐ a $ by ceqt_refl
l3: $ fv A i ≐ fv B i $ by fv_congr [#1, l1]
l4: $ ⟨ fv A i , a ⟩ ≐ ⟨ fv B i , a ⟩ $ by opair_congr [l3, l2]
l5: $ suc i ≐ suc i $ by ceqt_refl
l6: $ ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ≐ ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ $ by opair_congr [l5, l4]
l7: $ ⟨ i , a ⟩ ≐ ⟨ i , a ⟩ $ by ceqt_refl
l8: $ ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ≐ ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩ $ by opair_congr [l7, l6]
l9: $ z ≐ z $ by ceqt_refl
l10: $ (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩) ⟺ (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩) $ by ceq_congr [l9, l8]
l11: $ ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩) ⟺ ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩) $ by ex_congr [l10]
l12: $ ∃ i ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩) ⟺ ∃ i ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩) $ by ex_congr [l11]
l13: $ {z | ∃ i ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩)} ≐ {z | ∃ i ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩)} $ by cab_congr [l12]

sb_c_nstep
----------
l1: $ (⟦ x / t ⟧ {z | ∃ i ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩)}) ≐ {z | ∃ i ∃ a (z = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv (⟦ x / t ⟧ A) i , a ⟩ ⟩ ⟩)} $ by ceqt_refl

nest_congr
----------
l1: $ nstep A ≐ nstep B $ by nstep_congr [#1]
l2: $ ∅ ≐ ∅ $ by ceqt_refl
l3: $ ⟨ ∅ , C ⟩ ≐ ⟨ ∅ , D ⟩ $ by opair_congr [l2, #2]
l4: $ omrec ⟨ ∅ , C ⟩ (nstep A) ≐ omrec ⟨ ∅ , D ⟩ (nstep B) $ by omrec_congr [l3, l1]
l5: $ cdm A ≐ cdm B $ by cdm_congr [#1]
l6: $ fv (omrec ⟨ ∅ , C ⟩ (nstep A)) (cdm A) ≐ fv (omrec ⟨ ∅ , D ⟩ (nstep B)) (cdm B) $ by fv_congr [l4, l5]
l7: $ csn (fv (omrec ⟨ ∅ , C ⟩ (nstep A)) (cdm A)) ≐ csn (fv (omrec ⟨ ∅ , D ⟩ (nstep B)) (cdm B)) $ by csn_congr [l6]
l8: $ crn (csn (fv (omrec ⟨ ∅ , C ⟩ (nstep A)) (cdm A))) ≐ crn (csn (fv (omrec ⟨ ∅ , D ⟩ (nstep B)) (cdm B))) $ by crn_congr [l7]
l9: $ ⋃ (crn (csn (fv (omrec ⟨ ∅ , C ⟩ (nstep A)) (cdm A)))) ≐ ⋃ (crn (csn (fv (omrec ⟨ ∅ , D ⟩ (nstep B)) (cdm B)))) $ by cuni_congr [l8]

sb_c_nest
---------
l1: $ (⟦ x / t ⟧ (⋃ (crn (csn (fv (omrec ⟨ ∅ , B ⟩ (nstep A)) (cdm A)))))) ≐ ⋃ (crn (csn (fv (omrec ⟨ ∅ , ⟦ x / t ⟧ B ⟩ (nstep (⟦ x / t ⟧ A))) (cdm (⟦ x / t ⟧ A))))) $ by ceqt_refl

lemma c2_welc_nstep_eq (G: hyps) (A B: class) (u: set): $ G ⇒ A = B $ > $ G ⇒ u ∊ nstep A $ > $ G ⇒ u ∊ nstep B $
----
l1: $ G ⇒ ∃ i ∃ a (u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩) $ by cab_elim [#2]
m1: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ $ by ax
m2: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ A = B $ by weaken [#1]
m3: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ i = i $ by eq_refl
m4: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ fv A i = fv B i $ by fv_eq [m2, m3]
m5: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ a = a $ by eq_refl
m6: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ ⟨ fv A i , a ⟩ = ⟨ fv B i , a ⟩ $ by opair_eq [m4, m5]
m7: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ suc i = suc i $ by eq_refl
m8: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ = ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ $ by opair_eq [m7, m6]
m9: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ ⟨ i , a ⟩ = ⟨ i , a ⟩ $ by eq_refl
m10: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩ $ by opair_eq [m9, m8]
m11: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩ $ by eq_trans [m1, m10]
m12: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ ∃ a (u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩) $ by ex_intro [m11]
m13: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ ∃ i ∃ a (u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv B i , a ⟩ ⟩ ⟩) $ by ex_intro [m12]
m14: $ G , u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩ ⇒ u ∊ nstep B $ by cab_intro [m13]
n0: $ G , ∃ a (u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩) ⇒ ∃ a (u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩) $ by ax
n1: $ G , ∃ a (u = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv A i , a ⟩ ⟩ ⟩) ⇒ u ∊ nstep B $ by ex_elim [n0, m14]
n2: $ G ⇒ u ∊ nstep B $ by ex_elim [l1, n1]

lemma c2_nstep_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ nstep A = nstep B $
----
l1: $ G , u ∊ nstep A ⇒ u ∊ nstep A $ by ax
l2: $ G , u ∊ nstep A ⇒ A = B $ by weaken [#1]
l3: $ G , u ∊ nstep A ⇒ u ∊ nstep B $ by c2_welc_nstep_eq [l2, l1]
l4: $ G ⇒ B = A $ by eq_sym [#1]
l5: $ G , u ∊ nstep B ⇒ u ∊ nstep B $ by ax
l6: $ G , u ∊ nstep B ⇒ B = A $ by weaken [l4]
l7: $ G , u ∊ nstep B ⇒ u ∊ nstep A $ by c2_welc_nstep_eq [l6, l5]
l8: $ G ⇒ nstep A = nstep B $ by eq_intro [l3, l7]

nest_eq
-------
l1: $ G ⇒ nstep A = nstep B $ by c2_nstep_eq [#1]
l2: $ G ⇒ ∅ = ∅ $ by eq_refl
l3: $ G ⇒ ⟨ ∅ , C ⟩ = ⟨ ∅ , D ⟩ $ by opair_eq [l2, #2]
l4: $ G ⇒ omrec ⟨ ∅ , C ⟩ (nstep A) = omrec ⟨ ∅ , D ⟩ (nstep B) $ by omrec_eq [l3, l1]
l5: $ G ⇒ cdm A = cdm B $ by cdm_eq [#1]
l6: $ G ⇒ fv (omrec ⟨ ∅ , C ⟩ (nstep A)) (cdm A) = fv (omrec ⟨ ∅ , D ⟩ (nstep B)) (cdm B) $ by fv_eq [l4, l5]
l7: $ G ⇒ csn (fv (omrec ⟨ ∅ , C ⟩ (nstep A)) (cdm A)) = csn (fv (omrec ⟨ ∅ , D ⟩ (nstep B)) (cdm B)) $ by csn_eq [l6]
l8: $ G ⇒ crn (csn (fv (omrec ⟨ ∅ , C ⟩ (nstep A)) (cdm A))) = crn (csn (fv (omrec ⟨ ∅ , D ⟩ (nstep B)) (cdm B))) $ by crn_eq [l7]
l9: $ G ⇒ nest A C = nest B D $ by cuni_eq [l8]

apn_congr
---------
l1: $ y ≐ y $ by ceqt_refl
l2: $ nest C y ≐ nest D y $ by nest_congr [#2, l1]
l3: $ (nest C y ∈ A) ⟺ (nest D y ∈ B) $ by wcel_congr [l2, #1]
l4: $ {y | nest C y ∈ A} ≐ {y | nest D y ∈ B} $ by cab_congr [l3]

sb_c_apn
--------
l1: $ (⟦ x / t ⟧ {y | nest B y ∈ A}) ≐ {y | nest (⟦ x / t ⟧ B) y ∈ (⟦ x / t ⟧ A)} $ by ceqt_refl

apn_eq
------
l1: $ G ⇒ y = y $ by eq_refl
l2: $ G ⇒ nest C y = nest D y $ by nest_eq [#2, l1]
l3: $ G , nest C y ∈ A ⇒ nest C y ∈ A $ by ax
l4: $ G , nest C y ∈ A ⇒ nest C y = nest D y $ by weaken [l2]
l5: $ G , nest C y ∈ A ⇒ nest D y ∈ A $ by wcel_eq_l [l4, l3]
l6: $ G , nest C y ∈ A ⇒ A = B $ by weaken [#1]
l7: $ G , nest C y ∈ A ⇒ nest D y ∈ B $ by wcel_eq_r [l6, l5]
l8: $ G ⇒ nest D y = nest C y $ by eq_sym [l2]
l9: $ G ⇒ B = A $ by eq_sym [#1]
l10: $ G , nest D y ∈ B ⇒ nest D y ∈ B $ by ax
l11: $ G , nest D y ∈ B ⇒ nest D y = nest C y $ by weaken [l8]
l12: $ G , nest D y ∈ B ⇒ nest C y ∈ B $ by wcel_eq_l [l11, l10]
l13: $ G , nest D y ∈ B ⇒ B = A $ by weaken [l9]
l14: $ G , nest D y ∈ B ⇒ nest C y ∈ A $ by wcel_eq_r [l13, l12]
l15: $ G ⇒ nest C y ∈ A ↔ nest D y ∈ B $ by bi_intro [l7, l14]
l16: $ G ⇒ ∀ y (nest C y ∈ A ↔ nest D y ∈ B) $ by all_intro [l15]
l17: $ G ⇒ apn A C = apn B D $ by cab_eq [l16]

--| The second component of a pair, as a class: `⋃ (crn (csn ⟨ a , b ⟩))` is `b`.
lemma c2_nstep_intro (G: hyps) (S: class) (j b: set): $ G ⇒ ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ ∈ nstep S $
----
r1: $ G ⇒ isset ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ $ by opair_isset
r2: $ G , w = ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ ⇒ w = ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ $ by ax
r3: $ G , w = ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ ⇒ ∃ a (w = ⟨ ⟨ j , a ⟩ , ⟨ suc j , ⟨ fv S j , a ⟩ ⟩ ⟩) $ by ex_intro [r2]
r4: $ G , w = ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ ⇒ ∃ i ∃ a (w = ⟨ ⟨ i , a ⟩ , ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ ⟩) $ by ex_intro [r3]
r5: $ G , w = ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ ⇒ w ∊ nstep S $ by cab_intro [r4]
r6: $ G , w = ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ ⇒ ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ ∈ nstep S $ by wcel_intro [r2, r5]
r7: $ G ⇒ ⟨ ⟨ j , b ⟩ , ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⟩ ∈ nstep S $ by isset_elim [r1, r6]

lemma c2_nstep_elim {i a: set} (G: hyps) (S: class) (c d: set): $ G ⇒ ⟨ c , d ⟩ ∈ nstep S $ > $ G ⇒ ∃ i ∃ a (c = ⟨ i , a ⟩ ∧ d = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) $
----
k1: $ G , w = ⟨ c , d ⟩ , w ∊ nstep S ⇒ w ∊ nstep S $ by ax
k2: $ G , w = ⟨ c , d ⟩ , w ∊ nstep S ⇒ ∃ u ∃ v (w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩) $ by cab_elim [k1]
k3: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ w = ⟨ c , d ⟩ $ by ax
k4: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ $ by ax
k5: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ ⟨ c , d ⟩ = w $ by eq_sym [k3]
k6: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ ⟨ c , d ⟩ = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ $ by eq_trans [k5, k4]
k7: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ isset c $ by isset_var
k8: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ isset d $ by isset_var
k9: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ isset ⟨ u , v ⟩ $ by opair_isset
k10: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ isset ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ $ by opair_isset
k11: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ c = ⟨ u , v ⟩ ∧ d = ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ $ by opair_inj_c [k6, k7, k8, k9, k10]
k12: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ ∃ a (c = ⟨ u , a ⟩ ∧ d = ⟨ suc u , ⟨ fv S u , a ⟩ ⟩) $ by ex_intro [k11]
k13: $ G , w = ⟨ c , d ⟩ , w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩ ⇒ ∃ i ∃ a (c = ⟨ i , a ⟩ ∧ d = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) $ by ex_intro [k12]
k14: $ G , w = ⟨ c , d ⟩ , ∃ v (w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩) ⇒ ∃ v (w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩) $ by ax
k15: $ G , w = ⟨ c , d ⟩ , ∃ v (w = ⟨ ⟨ u , v ⟩ , ⟨ suc u , ⟨ fv S u , v ⟩ ⟩ ⟩) ⇒ ∃ i ∃ a (c = ⟨ i , a ⟩ ∧ d = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) $ by ex_elim [k14, k13]
k16: $ G , w = ⟨ c , d ⟩ , w ∊ nstep S ⇒ ∃ i ∃ a (c = ⟨ i , a ⟩ ∧ d = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) $ by ex_elim [k2, k15]
k17: $ G ⇒ ∃ i ∃ a (c = ⟨ i , a ⟩ ∧ d = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) $ by wcel_elim [#1, k16]

lemma c2_nstep_fun (G: hyps) (S: class): $ G ⇒ functional (nstep S) $
----
p0: $ G , ⟨ x , y ⟩ ∈ nstep S , ⟨ x , z ⟩ ∈ nstep S ⇒ ⟨ x , y ⟩ ∈ nstep S $ by ax
p1: $ G , ⟨ x , y ⟩ ∈ nstep S , ⟨ x , z ⟩ ∈ nstep S ⇒ ∃ i ∃ a (x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) $ by c2_nstep_elim [p0]
p2a: $ G , ⟨ x , y ⟩ ∈ nstep S , ⟨ x , z ⟩ ∈ nstep S ⇒ ⟨ x , z ⟩ ∈ nstep S $ by ax
p2: $ G , ⟨ x , y ⟩ ∈ nstep S , ⟨ x , z ⟩ ∈ nstep S ⇒ ∃ j ∃ b (x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩) $ by c2_nstep_elim [p2a]
q0: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ $ by ax
q0b: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ $ by ax
q1: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ x = ⟨ i , a ⟩ $ by and_elim_l [q0]
q2: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ $ by and_elim_r [q0]
q3: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ x = ⟨ j , b ⟩ $ by and_elim_l [q0b]
q4: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ $ by and_elim_r [q0b]
q5a: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ ⟨ i , a ⟩ = x $ by eq_sym [q1]
q5: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ ⟨ i , a ⟩ = ⟨ j , b ⟩ $ by eq_trans [q5a, q3]
q6: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ i = j $ by opair_inj_l [q5]
q7: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ a = b $ by opair_inj_r [q5]
q8a: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ S = S $ by eq_refl
q8: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ fv S i = fv S j $ by fv_eq [q8a, q6]
q9: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ ⟨ fv S i , a ⟩ = ⟨ fv S j , b ⟩ $ by opair_eq [q8, q7]
q10: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ suc i = suc j $ by suc_eq [q6]
q11: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ $ by opair_eq [q10, q9]
q12: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ y = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ $ by eq_trans [q2, q11]
q13: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ = z $ by eq_sym [q4]
q14: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩ ⇒ y = z $ by eq_trans [q12, q13]
r0: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , ∃ b (x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩) ⇒ ∃ b (x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩) $ by ax
r1: $ x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ , ∃ b (x = ⟨ j , b ⟩ ∧ z = ⟨ suc j , ⟨ fv S j , b ⟩ ⟩) ⇒ y = z $ by ex_elim [r0, q14]
r4: $ G , ⟨ x , y ⟩ ∈ nstep S , ⟨ x , z ⟩ ∈ nstep S , x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩ ⇒ y = z $ by ex_elim [p2, r1]
r5: $ G , ⟨ x , y ⟩ ∈ nstep S , ⟨ x , z ⟩ ∈ nstep S , ∃ a (x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) ⇒ ∃ a (x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) $ by ax
r6: $ G , ⟨ x , y ⟩ ∈ nstep S , ⟨ x , z ⟩ ∈ nstep S , ∃ a (x = ⟨ i , a ⟩ ∧ y = ⟨ suc i , ⟨ fv S i , a ⟩ ⟩) ⇒ y = z $ by ex_elim [r5, r4]
r7: $ G , ⟨ x , y ⟩ ∈ nstep S , ⟨ x , z ⟩ ∈ nstep S ⇒ y = z $ by ex_elim [p1, r6]
r8: $ G ⇒ functional (nstep S) $ by functional_intro [r7]

lemma c2_nstep_fv (G: hyps) (S: class) (j: set) (B: class): $ G ⇒ isset B $ > $ G ⇒ fv (nstep S) ⟨ j , B ⟩ = ⟨ suc j , ⟨ fv S j , B ⟩ ⟩ $
----
s1: $ G , v = B ⇒ ⟨ ⟨ j , v ⟩ , ⟨ suc j , ⟨ fv S j , v ⟩ ⟩ ⟩ ∈ nstep S $ by c2_nstep_intro
s2: $ G , v = B ⇒ functional (nstep S) $ by c2_nstep_fun
s3: $ G , v = B ⇒ isset ⟨ j , v ⟩ $ by opair_isset
s4: $ G , v = B ⇒ isset ⟨ suc j , ⟨ fv S j , v ⟩ ⟩ $ by opair_isset
s5: $ G , v = B ⇒ fv (nstep S) ⟨ j , v ⟩ = ⟨ suc j , ⟨ fv S j , v ⟩ ⟩ $ by fv_val_c [s2, s1, s3, s4]
s6: $ G , v = B ⇒ v = B $ by ax
s7: $ G , v = B ⇒ B = v $ by eq_sym [s6]
s8: $ G , v = B ⇒ j = j $ by eq_refl
s9: $ G , v = B ⇒ ⟨ j , B ⟩ = ⟨ j , v ⟩ $ by opair_eq [s8, s7]
s10: $ G , v = B ⇒ nstep S = nstep S $ by eq_refl
s11: $ G , v = B ⇒ fv (nstep S) ⟨ j , B ⟩ = fv (nstep S) ⟨ j , v ⟩ $ by fv_eq [s10, s9]
s12: $ G , v = B ⇒ fv S j = fv S j $ by eq_refl
s13: $ G , v = B ⇒ ⟨ fv S j , v ⟩ = ⟨ fv S j , B ⟩ $ by opair_eq [s12, s6]
s14: $ G , v = B ⇒ suc j = suc j $ by eq_refl
s15: $ G , v = B ⇒ ⟨ suc j , ⟨ fv S j , v ⟩ ⟩ = ⟨ suc j , ⟨ fv S j , B ⟩ ⟩ $ by opair_eq [s14, s13]
s16: $ G , v = B ⇒ fv (nstep S) ⟨ j , B ⟩ = ⟨ suc j , ⟨ fv S j , v ⟩ ⟩ $ by eq_trans [s11, s5]
s17: $ G , v = B ⇒ fv (nstep S) ⟨ j , B ⟩ = ⟨ suc j , ⟨ fv S j , B ⟩ ⟩ $ by eq_trans [s16, s15]
s18: $ G ⇒ fv (nstep S) ⟨ j , B ⟩ = ⟨ suc j , ⟨ fv S j , B ⟩ ⟩ $ by isset_elim [#1, s17]

--| The states of `nest`'s recursion, and the value at step `N`.
def c2_R (S Y: class): class = $ omrec ⟨ ∅ , Y ⟩ (nstep S) $

def c2_nv (S Y N: class): class = $ ⋃ (crn (csn (fv (c2_R S Y) N))) $

--| @congr
lemma c2_R_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ c2_R A C ≐ c2_R B D $
----
l1: $ nstep A ≐ nstep B $ by nstep_congr [#1]
l2: $ ∅ ≐ ∅ $ by ceqt_refl
l3: $ ⟨ ∅ , C ⟩ ≐ ⟨ ∅ , D ⟩ $ by opair_congr [l2, #2]
l4: $ omrec ⟨ ∅ , C ⟩ (nstep A) ≐ omrec ⟨ ∅ , D ⟩ (nstep B) $ by omrec_congr [l3, l1]

--| @rewrite
lemma c2_sb_R {x: set} (t: set x) (A B: class x): $ (⟦ x / t ⟧ (c2_R A B)) ≐ c2_R (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $
----
l1: $ (⟦ x / t ⟧ (omrec ⟨ ∅ , B ⟩ (nstep A))) ≐ omrec ⟨ ∅ , ⟦ x / t ⟧ B ⟩ (nstep (⟦ x / t ⟧ A)) $ by ceqt_refl

--| @congr
lemma c2_nv_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ c2_nv A C E ≐ c2_nv B D F $
----
l1: $ c2_R A C ≐ c2_R B D $ by c2_R_congr [#1, #2]
l2: $ fv (c2_R A C) E ≐ fv (c2_R B D) F $ by fv_congr [l1, #3]
l3: $ csn (fv (c2_R A C) E) ≐ csn (fv (c2_R B D) F) $ by csn_congr [l2]
l4: $ crn (csn (fv (c2_R A C) E)) ≐ crn (csn (fv (c2_R B D) F)) $ by crn_congr [l3]
l5: $ ⋃ (crn (csn (fv (c2_R A C) E))) ≐ ⋃ (crn (csn (fv (c2_R B D) F))) $ by cuni_congr [l4]

--| @rewrite
lemma c2_sb_nv {x: set} (t: set x) (A B C: class x): $ (⟦ x / t ⟧ (c2_nv A B C)) ≐ c2_nv (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $
----
l1: $ (⟦ x / t ⟧ (⋃ (crn (csn (fv (c2_R A B) C))))) ≐ ⋃ (crn (csn (fv (c2_R (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (⟦ x / t ⟧ C)))) $ by ceqt_refl

lemma c2_nv_eqn (G: hyps) (S Y N M: class): $ G ⇒ N = M $ > $ G ⇒ c2_nv S Y N = c2_nv S Y M $
----
l1: $ G ⇒ c2_R S Y = c2_R S Y $ by eq_refl
l2: $ G ⇒ fv (c2_R S Y) N = fv (c2_R S Y) M $ by fv_eq [l1, #1]
l3: $ G ⇒ csn (fv (c2_R S Y) N) = csn (fv (c2_R S Y) M) $ by csn_eq [l2]
l4: $ G ⇒ crn (csn (fv (c2_R S Y) N)) = crn (csn (fv (c2_R S Y) M)) $ by crn_eq [l3]
l5: $ G ⇒ c2_nv S Y N = c2_nv S Y M $ by cuni_eq [l4]

--| The value of a functional relation is a set, at any argument.
lemma c2_nv_set (G: hyps) (S Y N: class): $ G ⇒ isset (c2_nv S Y N) $
----
l1: $ G ⇒ functional (c2_R S Y) $ by omrec_functional
l2: $ G ⇒ rel (c2_R S Y) $ by omrec_rel
l3: $ G ⇒ isset (fv (c2_R S Y) N) $ by fv_set_rel [l1, l2]
l4: $ G ⇒ isset (csn (fv (c2_R S Y) N)) $ by csn_set [l3]
l5: $ G ⇒ isset (crn (csn (fv (c2_R S Y) N))) $ by crn_set [l4]
l6: $ G ⇒ isset (c2_nv S Y N) $ by cuni_set [l5]

lemma c2_R_zero (G: hyps) (S Y: class): $ G ⇒ fv (c2_R S Y) ∅ = ⟨ ∅ , Y ⟩ $
----
l1: $ G ⇒ isset ⟨ ∅ , Y ⟩ $ by opair_isset
l2: $ G ⇒ functional (nstep S) $ by c2_nstep_fun
l3: $ G ⇒ fv (c2_R S Y) ∅ = ⟨ ∅ , Y ⟩ $ by omrec_zero [l1, l2]

lemma c2_nv_zero (G: hyps) (S Y: class): $ G ⇒ isset Y $ > $ G ⇒ c2_nv S Y ∅ = Y $
----
l1: $ G ⇒ fv (c2_R S Y) ∅ = ⟨ ∅ , Y ⟩ $ by c2_R_zero
l2: $ G ⇒ csn (fv (c2_R S Y) ∅) = csn ⟨ ∅ , Y ⟩ $ by csn_eq [l1]
l3: $ G ⇒ crn (csn (fv (c2_R S Y) ∅)) = crn (csn ⟨ ∅ , Y ⟩) $ by crn_eq [l2]
l4: $ G ⇒ c2_nv S Y ∅ = ⋃ (crn (csn ⟨ ∅ , Y ⟩)) $ by cuni_eq [l3]
l5: $ G ⇒ isset ∅ $ by ax_empty
l6: $ G ⇒ ⋃ (crn (csn ⟨ ∅ , Y ⟩)) = Y $ by cuni_crn_csn_c [l5, #1]
l7: $ G ⇒ c2_nv S Y ∅ = Y $ by eq_trans [l4, l6]

lemma c2_R_suc (G: hyps) (S Y: class) (n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ fv (c2_R S Y) n = ⟨ n , c2_nv S Y n ⟩ $ > $ G ⇒ fv (c2_R S Y) (suc n) = ⟨ suc n , ⟨ fv S n , c2_nv S Y n ⟩ ⟩ $
----
t0: $ G ⇒ isset ⟨ ∅ , Y ⟩ $ by opair_isset
t0b: $ G ⇒ functional (nstep S) $ by c2_nstep_fun
t1: $ G ⇒ fv (c2_R S Y) (suc n) = fv (nstep S) (fv (c2_R S Y) n) $ by omrec_suc [t0, t0b, #1]
t2: $ G ⇒ nstep S = nstep S $ by eq_refl
t3: $ G ⇒ fv (nstep S) (fv (c2_R S Y) n) = fv (nstep S) ⟨ n , c2_nv S Y n ⟩ $ by fv_eq [t2, #2]
t4: $ G ⇒ isset (c2_nv S Y n) $ by c2_nv_set
t5: $ G ⇒ fv (nstep S) ⟨ n , c2_nv S Y n ⟩ = ⟨ suc n , ⟨ fv S n , c2_nv S Y n ⟩ ⟩ $ by c2_nstep_fv [t4]
t6: $ G ⇒ fv (c2_R S Y) (suc n) = fv (nstep S) ⟨ n , c2_nv S Y n ⟩ $ by eq_trans [t1, t3]
t7: $ G ⇒ fv (c2_R S Y) (suc n) = ⟨ suc n , ⟨ fv S n , c2_nv S Y n ⟩ ⟩ $ by eq_trans [t6, t5]

--| The state at step `n` is `⟨ n , value ⟩`.
lemma c2_state (G: hyps) (S Y: class) (n: set): $ G ⇒ isset Y $ > $ G ⇒ n ∊ ω $ > $ G ⇒ fv (c2_R S Y) n = ⟨ n , c2_nv S Y n ⟩ $
----
b1: $ G , z = ∅ ⇒ z = ∅ $ by ax
b1a: $ G , z = ∅ ⇒ c2_R S Y = c2_R S Y $ by eq_refl
b2: $ G , z = ∅ ⇒ fv (c2_R S Y) z = fv (c2_R S Y) ∅ $ by fv_eq [b1a, b1]
b3: $ G , z = ∅ ⇒ fv (c2_R S Y) ∅ = ⟨ ∅ , Y ⟩ $ by c2_R_zero
b4: $ G , z = ∅ ⇒ c2_nv S Y z = c2_nv S Y ∅ $ by c2_nv_eqn [b1]
b5a: $ G , z = ∅ ⇒ isset Y $ by weaken [#1]
b5: $ G , z = ∅ ⇒ c2_nv S Y ∅ = Y $ by c2_nv_zero [b5a]
b6: $ G , z = ∅ ⇒ c2_nv S Y z = Y $ by eq_trans [b4, b5]
b7: $ G , z = ∅ ⇒ ⟨ z , c2_nv S Y z ⟩ = ⟨ ∅ , Y ⟩ $ by opair_eq [b1, b6]
b8: $ G , z = ∅ ⇒ fv (c2_R S Y) z = ⟨ ∅ , Y ⟩ $ by eq_trans [b2, b3]
b9: $ G , z = ∅ ⇒ ⟨ ∅ , Y ⟩ = ⟨ z , c2_nv S Y z ⟩ $ by eq_sym [b7]
b10: $ G , z = ∅ ⇒ fv (c2_R S Y) z = ⟨ z , c2_nv S Y z ⟩ $ by eq_trans [b8, b9]
s0: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ y ∊ ω $ by ax
s0b: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ $ by ax
s1: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ fv (c2_R S Y) (suc y) = ⟨ suc y , ⟨ fv S y , c2_nv S Y y ⟩ ⟩ $ by c2_R_suc [s0, s0b]
s2: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ z = suc y $ by ax
s2a: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ c2_R S Y = c2_R S Y $ by eq_refl
s3: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ fv (c2_R S Y) z = fv (c2_R S Y) (suc y) $ by fv_eq [s2a, s2]
s4: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ fv (c2_R S Y) z = ⟨ suc y , ⟨ fv S y , c2_nv S Y y ⟩ ⟩ $ by eq_trans [s3, s1]
s5: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ csn (fv (c2_R S Y) z) = csn ⟨ suc y , ⟨ fv S y , c2_nv S Y y ⟩ ⟩ $ by csn_eq [s4]
s6: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ crn (csn (fv (c2_R S Y) z)) = crn (csn ⟨ suc y , ⟨ fv S y , c2_nv S Y y ⟩ ⟩) $ by crn_eq [s5]
s7: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ c2_nv S Y z = ⋃ (crn (csn ⟨ suc y , ⟨ fv S y , c2_nv S Y y ⟩ ⟩)) $ by cuni_eq [s6]
s8a: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ isset y $ by isset_var
s8b: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ isset (suc y) $ by suc_set [s8a]
s8c: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ isset ⟨ fv S y , c2_nv S Y y ⟩ $ by opair_isset
s8: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ ⋃ (crn (csn ⟨ suc y , ⟨ fv S y , c2_nv S Y y ⟩ ⟩)) = ⟨ fv S y , c2_nv S Y y ⟩ $ by cuni_crn_csn_c [s8b, s8c]
s9: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ c2_nv S Y z = ⟨ fv S y , c2_nv S Y y ⟩ $ by eq_trans [s7, s8]
s10: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ ⟨ z , c2_nv S Y z ⟩ = ⟨ suc y , ⟨ fv S y , c2_nv S Y y ⟩ ⟩ $ by opair_eq [s2, s9]
s11: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ ⟨ suc y , ⟨ fv S y , c2_nv S Y y ⟩ ⟩ = ⟨ z , c2_nv S Y z ⟩ $ by eq_sym [s10]
s12: $ G , y ∊ ω , fv (c2_R S Y) y = ⟨ y , c2_nv S Y y ⟩ , z = suc y ⇒ fv (c2_R S Y) z = ⟨ z , c2_nv S Y z ⟩ $ by eq_trans [s4, s11]
i1: $ G ⇒ fv (c2_R S Y) n = ⟨ n , c2_nv S Y n ⟩ $ by omega_ind_named [b10, s12, #2]

lemma c2_nv_suc (G: hyps) (S Y: class) (n: set): $ G ⇒ isset Y $ > $ G ⇒ n ∊ ω $ > $ G ⇒ c2_nv S Y (suc n) = ⟨ fv S n , c2_nv S Y n ⟩ $
----
u1: $ G ⇒ fv (c2_R S Y) n = ⟨ n , c2_nv S Y n ⟩ $ by c2_state [#1, #2]
u2: $ G ⇒ fv (c2_R S Y) (suc n) = ⟨ suc n , ⟨ fv S n , c2_nv S Y n ⟩ ⟩ $ by c2_R_suc [#2, u1]
u3: $ G ⇒ csn (fv (c2_R S Y) (suc n)) = csn ⟨ suc n , ⟨ fv S n , c2_nv S Y n ⟩ ⟩ $ by csn_eq [u2]
u4: $ G ⇒ crn (csn (fv (c2_R S Y) (suc n))) = crn (csn ⟨ suc n , ⟨ fv S n , c2_nv S Y n ⟩ ⟩) $ by crn_eq [u3]
u5: $ G ⇒ c2_nv S Y (suc n) = ⋃ (crn (csn ⟨ suc n , ⟨ fv S n , c2_nv S Y n ⟩ ⟩)) $ by cuni_eq [u4]
u6a: $ G ⇒ isset n $ by isset_var
u6b: $ G ⇒ isset (suc n) $ by suc_set [u6a]
u6c: $ G ⇒ isset ⟨ fv S n , c2_nv S Y n ⟩ $ by opair_isset
u6: $ G ⇒ ⋃ (crn (csn ⟨ suc n , ⟨ fv S n , c2_nv S Y n ⟩ ⟩)) = ⟨ fv S n , c2_nv S Y n ⟩ $ by cuni_crn_csn_c [u6b, u6c]
u7: $ G ⇒ c2_nv S Y (suc n) = ⟨ fv S n , c2_nv S Y n ⟩ $ by eq_trans [u5, u6]

nest_set
--------
l1: $ G ⇒ isset (nest S Y) $ by c2_nv_set

nest_empty
----------
l1: $ G ⇒ cdm ∅ = ∅ $ by cdm_empty
l2: $ G ⇒ c2_nv ∅ Y (cdm ∅) = c2_nv ∅ Y ∅ $ by c2_nv_eqn [l1]
l3: $ G ⇒ c2_nv ∅ Y ∅ = Y $ by c2_nv_zero [#1]
l4: $ G ⇒ nest ∅ Y = Y $ by eq_trans [l2, l3]

--| Two sequences that agree below `n` give the same value at `n`.
lemma c2_agree {i: set} (G: hyps) (S T Y: class) (n: set): $ G ⇒ isset Y $ > $ G ⇒ n ∊ ω $ > $ G ⇒ ∀ i (i ∊ n → fv S i = fv T i) $ > $ G ⇒ c2_nv S Y n = c2_nv T Y n $
----
b1: $ G , z = ∅ ⇒ z = ∅ $ by ax
b2: $ G , z = ∅ ⇒ c2_nv S Y z = c2_nv S Y ∅ $ by c2_nv_eqn [b1]
b3a: $ G , z = ∅ ⇒ isset Y $ by weaken [#1]
b3: $ G , z = ∅ ⇒ c2_nv S Y ∅ = Y $ by c2_nv_zero [b3a]
b4: $ G , z = ∅ ⇒ c2_nv T Y z = c2_nv T Y ∅ $ by c2_nv_eqn [b1]
b5: $ G , z = ∅ ⇒ c2_nv T Y ∅ = Y $ by c2_nv_zero [b3a]
b6: $ G , z = ∅ ⇒ c2_nv S Y z = Y $ by eq_trans [b2, b3]
b7: $ G , z = ∅ ⇒ c2_nv T Y z = Y $ by eq_trans [b4, b5]
b8: $ G , z = ∅ ⇒ Y = c2_nv T Y z $ by eq_sym [b7]
b9: $ G , z = ∅ ⇒ c2_nv S Y z = c2_nv T Y z $ by eq_trans [b6, b8]
b10: $ G , z = ∅ , z ⊆ n ⇒ c2_nv S Y z = c2_nv T Y z $ by weaken [b9]
b11: $ G , z = ∅ ⇒ z ⊆ n → c2_nv S Y z = c2_nv T Y z $ by imp_intro [b10]
c1: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ z = suc y $ by ax
c2: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ z ⊆ n $ by ax
c3: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ suc y ⊆ n $ by subset_eq_l [c1, c2]
c4: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ y ⊆ suc y $ by suc_subset
c5: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ y ⊆ n $ by subset_trans [c4, c3]
c6a: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ y ⊆ n → c2_nv S Y y = c2_nv T Y y $ by ax
c6: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv S Y y = c2_nv T Y y $ by imp_elim [c6a, c5]
c7: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ y ∊ suc y $ by suc_self
c8: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ y ∊ n $ by subset_elim [c3, c7]
c9: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ ∀ i (i ∊ n → fv S i = fv T i) $ by weaken [#3]
c10: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ y ∊ n → fv S y = fv T y $ by all_elim [c9]
c11: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ fv S y = fv T y $ by imp_elim [c10, c8]
c12a: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ isset Y $ by weaken [#1]
c12b: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ y ∊ ω $ by ax
c12: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv S Y (suc y) = ⟨ fv S y , c2_nv S Y y ⟩ $ by c2_nv_suc [c12a, c12b]
c13: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv T Y (suc y) = ⟨ fv T y , c2_nv T Y y ⟩ $ by c2_nv_suc [c12a, c12b]
c14: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ ⟨ fv S y , c2_nv S Y y ⟩ = ⟨ fv T y , c2_nv T Y y ⟩ $ by opair_eq [c11, c6]
c15: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv S Y z = c2_nv S Y (suc y) $ by c2_nv_eqn [c1]
c16: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv T Y z = c2_nv T Y (suc y) $ by c2_nv_eqn [c1]
c17: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv S Y z = ⟨ fv S y , c2_nv S Y y ⟩ $ by eq_trans [c15, c12]
c18: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv S Y z = ⟨ fv T y , c2_nv T Y y ⟩ $ by eq_trans [c17, c14]
c19: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ ⟨ fv T y , c2_nv T Y y ⟩ = c2_nv T Y (suc y) $ by eq_sym [c13]
c20: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv S Y z = c2_nv T Y (suc y) $ by eq_trans [c18, c19]
c21: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv T Y (suc y) = c2_nv T Y z $ by eq_sym [c16]
c22: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y , z ⊆ n ⇒ c2_nv S Y z = c2_nv T Y z $ by eq_trans [c20, c21]
c23: $ G , y ∊ ω , (y ⊆ n → c2_nv S Y y = c2_nv T Y y) , z = suc y ⇒ z ⊆ n → c2_nv S Y z = c2_nv T Y z $ by imp_intro [c22]
i1: $ G ⇒ n ⊆ n → c2_nv S Y n = c2_nv T Y n $ by omega_ind_named [b11, c23, #2]
i2: $ G ⇒ n ⊆ n $ by subset_refl
i3: $ G ⇒ c2_nv S Y n = c2_nv T Y n $ by imp_elim [i1, i2]

--| The values for `scons a s` from `Y` are those for `s` from `⟨ a , Y ⟩`, one step later.
lemma c2_shift (G: hyps) (Y: class) (a s m: set): $ G ⇒ isset Y $ > $ G ⇒ m ∊ ω $ > $ G ⇒ c2_nv (scons a s) Y (suc m) = c2_nv s ⟨ a , Y ⟩ m $
----
b1: $ G , z = ∅ ⇒ z = ∅ $ by ax
b2a: $ G , z = ∅ ⇒ ∅ ∈ ω $ by omega_zero
b2b: $ G , z = ∅ ⇒ ∅ = z $ by eq_sym [b1]
b2c: $ G , z = ∅ ⇒ z ∈ ω $ by wcel_eq_l [b2b, b2a]
b2: $ G , z = ∅ ⇒ z ∊ ω $ by wcel_welc [b2c]
b3a: $ G , z = ∅ ⇒ isset Y $ by weaken [#1]
b3: $ G , z = ∅ ⇒ c2_nv (scons a s) Y (suc z) = ⟨ fv (scons a s) z , c2_nv (scons a s) Y z ⟩ $ by c2_nv_suc [b3a, b2]
b4a: $ G , z = ∅ ⇒ scons a s = scons a s $ by eq_refl
b4: $ G , z = ∅ ⇒ fv (scons a s) z = fv (scons a s) ∅ $ by fv_eq [b4a, b1]
b5: $ G , z = ∅ ⇒ fv (scons a s) ∅ = a $ by scons_fv_zero
b6: $ G , z = ∅ ⇒ fv (scons a s) z = a $ by eq_trans [b4, b5]
b7: $ G , z = ∅ ⇒ c2_nv (scons a s) Y z = c2_nv (scons a s) Y ∅ $ by c2_nv_eqn [b1]
b8: $ G , z = ∅ ⇒ c2_nv (scons a s) Y ∅ = Y $ by c2_nv_zero [b3a]
b9: $ G , z = ∅ ⇒ c2_nv (scons a s) Y z = Y $ by eq_trans [b7, b8]
