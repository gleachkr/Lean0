f2: $ G ⇒ s ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} $ by subset_elim [f1, #1]
f3: $ G ⇒ ∀ w (nest (scat s t) w = nest t (nest s w)) $ by cab_elim [f2]
f4a: $ G , q = Y ⇒ ∀ w (nest (scat s t) w = nest t (nest s w)) $ by weaken [f3]
f4: $ G , q = Y ⇒ nest (scat s t) q = nest t (nest s q) $ by all_elim [f4a]
f5: $ G , q = Y ⇒ q = Y $ by ax
f6a: $ G , q = Y ⇒ scat s t = scat s t $ by eq_refl
f6: $ G , q = Y ⇒ nest (scat s t) q = nest (scat s t) Y $ by nest_eq [f6a, f5]
f7a: $ G , q = Y ⇒ s = s $ by eq_refl
f7: $ G , q = Y ⇒ nest s q = nest s Y $ by nest_eq [f7a, f5]
f8a: $ G , q = Y ⇒ t = t $ by eq_refl
f8: $ G , q = Y ⇒ nest t (nest s q) = nest t (nest s Y) $ by nest_eq [f8a, f7]
f9: $ G , q = Y ⇒ nest (scat s t) Y = nest (scat s t) q $ by eq_sym [f6]
f10: $ G , q = Y ⇒ nest (scat s t) Y = nest t (nest s q) $ by eq_trans [f9, f4]
f11: $ G , q = Y ⇒ nest (scat s t) Y = nest t (nest s Y) $ by eq_trans [f10, f8]
f12: $ G ⇒ nest (scat s t) Y = nest t (nest s Y) $ by isset_elim [#3, f11]

--| A sequence of length `suc k` is an `scons` of one of length `k`.
--| Injectivity of `nest` at a fixed length, by induction on the length.
lemma c2_inj_ind {u v c d: set} (G: hyps) (A: class) (n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ ∀ u ∀ v ∀ c ∀ d (u ∊ fseq A → v ∊ fseq A → cdm u = n → cdm v = n → nest u c = nest v d → u = v ∧ c = d) $
----
