lemma c6_iop_sub (G: hyps) (E E2 D W Y: class) (u: set): $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ iop u E D W Y ⊆ iop u E2 D W Y $
----
a1: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x $ by ax
a2: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ∊ u ∧ z ∊ iop0 u E D W x $ by and_elim_r [a1]
a3: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ z ∊ iop0 u E D W x $ by and_elim_r [a2]
a4: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ D ∈ trees ω $ by weaken [#1]
a5: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ eagr E E2 D $ by weaken [#2]
a6: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ iop0 u E D W x ⊆ iop0 u E2 D W x $ by c6_iop0_sub [a4, a5]
a7: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ z ∊ iop0 u E2 D W x $ by subset_elim [a6, a3]
a8: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ Y $ by and_elim_l [a1]
a9: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ∊ u $ by and_elim_l [a2]
a10: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ∊ u ∧ z ∊ iop0 u E2 D W x $ by and_intro [a9, a7]
a11: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E2 D W x $ by and_intro [a8, a10]
a12: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ ∃ x (x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E2 D W x) $ by ex_intro [a11]
a13: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ z ∊ {z | ∃ x (x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E2 D W x)} $ by cab_intro [a12]
a14: $ G , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ z ∊ iop u E2 D W Y $ by weaken [a13]
b1: $ G , ∃ x (x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x) ⇒ ∃ x (x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $ by ax
b2: $ G , ∃ x (x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x) ⇒ z ∊ iop u E2 D W Y $ by ex_elim [b1, a14]
b3: $ G , z ∊ iop u E D W Y ⇒ z ∊ {z | ∃ x (x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x)} $ by ax
b4: $ G , z ∊ iop u E D W Y ⇒ ∃ x (x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $ by cab_elim [b3]
b5: $ G , z ∊ iop u E D W Y ⇒ z ∊ iop u E2 D W Y $ by cut [b4, b2]
b6: $ G ⇒ iop u E D W Y ⊆ iop u E2 D W Y $ by subset_intro [b5]

lemma c6_ifam_sub (G: hyps) (E E2 D W: class) (u: set): $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ ifam u E D W ⊆ ifam u E2 D W $
----
i1: $ G ⇒ isset (ifam u E2 D W) $ by ifam_set
i2: $ G , m = ifam u E2 D W ⇒ mono y (iop u E D W y) $ by iop_mono
i3: $ G , m = ifam u E2 D W ⇒ setop y (iop u E D W y) $ by iop_setop
i4: $ G , m = ifam u E2 D W ⇒ D ∈ trees ω $ by weaken [#1]
i5: $ G , m = ifam u E2 D W ⇒ eagr E E2 D $ by weaken [#2]
i6: $ G , m = ifam u E2 D W ⇒ iop u E D W m ⊆ iop u E2 D W m $ by c6_iop_sub [i4, i5]
i7: $ G , m = ifam u E2 D W ⇒ m = ifam u E2 D W $ by ax
i8: $ G , m = ifam u E2 D W ⇒ cap y (iop u E2 D W y) (ifam u E2 D W) = iop u E2 D W m $ by cap_eq [i7]
i9: $ G , m = ifam u E2 D W ⇒ cap y (iop u E2 D W y) (ifam u E2 D W) = ifam u E2 D W $ by ifam_fix
i10: $ G , m = ifam u E2 D W ⇒ iop u E2 D W m = cap y (iop u E2 D W y) (ifam u E2 D W) $ by eq_sym [i8]
i11: $ G , m = ifam u E2 D W ⇒ iop u E2 D W m = ifam u E2 D W $ by eq_trans [i10, i9]
i12: $ G , m = ifam u E2 D W ⇒ ifam u E2 D W = m $ by eq_sym [i7]
i13: $ G , m = ifam u E2 D W ⇒ iop u E2 D W m = m $ by eq_trans [i11, i12]
i14: $ G , m = ifam u E2 D W ⇒ iop u E2 D W m ⊆ m $ by eq_subset [i13]
i15: $ G , m = ifam u E2 D W ⇒ iop u E D W m ⊆ m $ by subset_trans [i6, i14]
i16: $ G , m = ifam u E2 D W ⇒ lfp y (iop u E D W y) ⊆ m $ by lfp_least [i2, i3, i15]
i17: $ G , m = ifam u E2 D W ⇒ ifam u E D W ⊆ ifam u E2 D W $ by subset_eq_r [i7, i16]
i18: $ G ⇒ ifam u E D W ⊆ ifam u E2 D W $ by isset_elim [i1, i17]

ifam_local
----------
l1: $ G ⇒ ifam u E D W ⊆ ifam u E2 D W $ by c6_ifam_sub [#1, #2]
l2: $ G ⇒ eagr E2 E D $ by eagr_sym [#2]
l3: $ G ⇒ ifam u E2 D W ⊆ ifam u E D W $ by c6_ifam_sub [#1, l2]
l4: $ G ⇒ ifam u E D W = ifam u E2 D W $ by subset_antisym [l1, l3]

ity_local
---------
l1: $ G ⇒ ifam u E D W = ifam u E2 D W $ by ifam_local [#1, #2]
l2: $ G ⇒ ifam u E D W ⊆ ifam u E2 D W $ by eq_subset [l1]
l3: $ G ⇒ ient D W (ifam u E D W) j ⊆ ient D W (ifam u E2 D W) j $ by ient_mono [l2]
l4: $ G ⇒ ifam u E2 D W = ifam u E D W $ by eq_sym [l1]
l5: $ G ⇒ ifam u E2 D W ⊆ ifam u E D W $ by eq_subset [l4]
l6: $ G ⇒ ient D W (ifam u E2 D W) j ⊆ ient D W (ifam u E D W) j $ by ient_mono [l5]
l7: $ G ⇒ ity u E D j W = ity u E2 D j W $ by subset_antisym [l3, l6]

lemma c6_ictor_sub (G: hyps) (E E2 D J C W: class) (u: set): $ G ⇒ D ∈ trees ω $ > $ G ⇒ eagr E E2 D $ > $ G ⇒ ictor u E D J C W ⊆ ictor u E2 D J C W $
----
m1: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y $ by ax
m2: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ iprt D q e $ by and_elim_l [m1]
m3: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y $ by and_elim_r [m1]
m4: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ p ∊ esat u E q W $ by and_elim_l [m3]
m5: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y $ by and_elim_r [m3]
m6: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ ictk D J C k $ by and_elim_l [m5]
m7: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y $ by and_elim_r [m5]
m8: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) $ by and_elim_l [m7]
m9: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ y ∊ scons C g ∧ z = nest (scat f p) y $ by and_elim_r [m7]
n1: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ D ∈ trees ω $ by weaken [#1]
n2: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ eagr E E2 D $ by weaken [#2]
n3: $ G , ¬ iprop D J W , iprt D q e ∧ p ∊ esat u E q W ∧ ictk D J C k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W (scat p (ixs D W (ifam u E D W))) ∧ y ∊ scons C g ∧ z = nest (scat f p) y ⇒ q ∈ fv tsub D ∧ e ∈ fv tsub D $ by iprt_tsub [n1, m2]
