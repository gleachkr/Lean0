n4a: $ G , k = kc_pi ∨ k = kc_app , k = kc_pi , x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a , b ∊ u ∧ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons b r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc d b ∧ g2 = scons b e ∧ t2 = scons (etel u E (fv s ∅) w r) h ∧ a2 = l ⇒ fv (etf u E) (fv s (suc ∅)) = fv (etf u E) (fv s (suc ∅)) $ by eq_refl
n4b: $ G , k = kc_pi ∨ k = kc_app , k = kc_pi , x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a , b ∊ u ∧ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons b r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc d b ∧ g2 = scons b e ∧ t2 = scons (etel u E (fv s ∅) w r) h ∧ a2 = l ⇒ w = w $ by eq_refl
n4c: $ G , k = kc_pi ∨ k = kc_app , k = kc_pi , x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a , b ∊ u ∧ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons b r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc d b ∧ g2 = scons b e ∧ t2 = scons (etel u E (fv s ∅) w r) h ∧ a2 = l ⇒ r = r $ by eq_refl
n4d: $ G , k = kc_pi ∨ k = kc_app , k = kc_pi , x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a , b ∊ u ∧ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons b r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc d b ∧ g2 = scons b e ∧ t2 = scons (etel u E (fv s ∅) w r) h ∧ a2 = l ⇒ scons b r = scons x r $ by scons_eq [m15, n4c]
n4: $ G , k = kc_pi ∨ k = kc_app , k = kc_pi , x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a , b ∊ u ∧ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons b r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc d b ∧ g2 = scons b e ∧ t2 = scons (etel u E (fv s ∅) w r) h ∧ a2 = l ⇒ da (fv (etf u E) (fv s (suc ∅))) w (scons b r) = da (fv (etf u E) (fv s (suc ∅))) w (scons x r) $ by da_eq [n4a, n4b, n4d]
n5: $ G , k = kc_pi ∨ k = kc_app , k = kc_pi , x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a , b ∊ u ∧ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons b r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc d b ∧ g2 = scons b e ∧ t2 = scons (etel u E (fv s ∅) w r) h ∧ a2 = l ⇒ ⟨ f , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) $ by wcel_eq_r [n4, n3]
n6a: $ G , k = kc_pi ∨ k = kc_app , k = kc_pi , x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a , b ∊ u ∧ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons b r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc d b ∧ g2 = scons b e ∧ t2 = scons (etel u E (fv s ∅) w r) h ∧ a2 = l ⇒ crn s ⊆ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x6 ∀ x7 ∀ x8 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x1 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)} $ by weaken [#3]
