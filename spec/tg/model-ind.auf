ra2: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ t0 = ∅ $ by and_elim_l [ra1r]
ra2r: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ a0 = ∅ $ by and_elim_r [ra1r]
rb0: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ f0 = ∅ $ by and_elim_l [r2]
rb0r: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ g2 = ∅ ∧ t2 = ∅ ∧ a2 = ∅ $ by and_elim_r [r2]
rb1: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ g2 = ∅ $ by and_elim_l [rb0r]
rb1r: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ t2 = ∅ ∧ a2 = ∅ $ by and_elim_r [rb0r]
rb2: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ t2 = ∅ $ by and_elim_l [rb1r]
rb2r: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ a2 = ∅ $ by and_elim_r [rb1r]
r3: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ ∅ = g2 $ by eq_sym [rb1]
r4: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ g0 = g2 $ by eq_trans [ra1, r3]
r5: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ ∅ = t2 $ by eq_sym [rb2]
r6: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ t0 = t2 $ by eq_trans [ra2, r5]
r7: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ ∅ = a2 $ by eq_sym [rb2r]
r8: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ a0 = a2 $ by eq_trans [ra2r, r7]
r9: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ t0 = t2 ∧ a0 = a2 $ by and_intro [r6, r8]
r10: $ G , ¬ (k = kc_pi ∨ k = kc_app) ⇒ g0 = g2 ∧ t0 = t2 ∧ a0 = a2 $ by and_intro [r4, r9]
cs1: $ G , k = kc_pi ∨ k = kc_app ⇒ k = kc_pi ∨ k = kc_app $ by ax
cs2: $ G , k = kc_pi ∨ k = kc_app ⇒ g0 = g2 ∧ t0 = t2 ∧ a0 = a2 $ by or_elim [cs1, xd9, q9]
cs3: $ G ⇒ (k = kc_pi ∨ k = kc_app) ∨ ¬ (k = kc_pi ∨ k = kc_app) $ by excluded_middle
cs4: $ G ⇒ g0 = g2 ∧ t0 = t2 ∧ a0 = a2 $ by or_elim [cs3, cs2, r10]

lemma c3_ed_node {y x0 x1 x2 x3 x4 x6 x7 x8: set} (G: hyps y x0 x1 x2 x3 x4 x6 x7 x8) (E: class) (u w k s: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ crn s ⊆ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x6 ∀ x7 ∀ x8 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x1 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)} $ > $ G ⇒ ⟨ k , s ⟩ ∈ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x6 ∀ x7 ∀ x8 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x1 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)} $
----
a1: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ z = ⟨ k , s ⟩ $ by ax
a2: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ (etf u E) = (etf u E) $ by eq_refl
a3: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ fv (etf u E) z = fv (etf u E) ⟨ k , s ⟩ $ by fv_eq [a2, a1]
a4: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ w = w $ by eq_refl
b0a: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ b = b $ by eq_refl
b0b: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ da (fv (etf u E) z) w b = da (fv (etf u E) ⟨ k , s ⟩) w b $ by da_eq [a3, a4, b0a]
b0c: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b $ by ax
b0d: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E ⟨ k , s ⟩ w b $ by wcel_eq_r [b0b, b0c]
b1a: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ b = b $ by eq_refl
b1b: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ da (fv (etf u E) z) w b = da (fv (etf u E) ⟨ k , s ⟩) w b $ by da_eq [a3, a4, b1a]
b1c: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b $ by ax
b1d: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E ⟨ k , s ⟩ w b $ by wcel_eq_r [b1b, b1c]
a9: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ k ∊ ω $ by weaken [#1]
a10: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ s ∊ fseq (trees ω) $ by weaken [#2]
a11: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ crn s ⊆ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x6 ∀ x7 ∀ x8 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x1 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)} $ by weaken [#3]
a12: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b , ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ e = m ∧ h = n ∧ l = o $ by c3_ed_step [a9, a10, a11, b0d, b1d]
c1: $ G , z = ⟨ k , s ⟩ , ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b ⇒ ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o $ by imp_intro [a12]
c0: $ G , z = ⟨ k , s ⟩ ⇒ ⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o $ by imp_intro [c1]
d7: $ G , z = ⟨ k , s ⟩ ⇒ ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o) $ by all_intro [c0]
d6: $ G , z = ⟨ k , s ⟩ ⇒ ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o) $ by all_intro [d7]
d5: $ G , z = ⟨ k , s ⟩ ⇒ ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o) $ by all_intro [d6]
d4: $ G , z = ⟨ k , s ⟩ ⇒ ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o) $ by all_intro [d5]
d3: $ G , z = ⟨ k , s ⟩ ⇒ ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o) $ by all_intro [d4]
d2: $ G , z = ⟨ k , s ⟩ ⇒ ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o) $ by all_intro [d3]
d1: $ G , z = ⟨ k , s ⟩ ⇒ ∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o) $ by all_intro [d2]
d0: $ G , z = ⟨ k , s ⟩ ⇒ ∀ b ∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o) $ by all_intro [d1]
g0a: $ (∀ b ∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o)) ⟺ (∀ x0 ∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o)) $ by all_alpha
g0w: $ G , z = ⟨ k , s ⟩ ⇒ (∀ b ∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w b → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w b → e = m ∧ h = n ∧ l = o)) ↔ (∀ x0 ∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o)) $ by weaken [g0a]
g0e: $ G , z = ⟨ k , s ⟩ ⇒ ∀ x0 ∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o) $ by bi_elim_l [g0w, d0]
g1a: $ (∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o)) ⟺ (∀ x1 ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o)) $ by all_alpha
g1c0: $ (∀ x0 (∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o))) ⟺ (∀ x0 (∀ x1 ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o))) $ by all_congr [g1a]
g1w: $ G , z = ⟨ k , s ⟩ ⇒ (∀ x0 ∀ d ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ d , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ d , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o)) ↔ (∀ x0 ∀ x1 ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o)) $ by weaken [g1c0]
g1e: $ G , z = ⟨ k , s ⟩ ⇒ ∀ x0 ∀ x1 ∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o) $ by bi_elim_l [g1w, g0e]
g2a: $ (∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o)) ⟺ (∀ x2 ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ x2 , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → x2 = m ∧ h = n ∧ l = o)) $ by all_alpha
g2c1: $ (∀ x1 (∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o))) ⟺ (∀ x1 (∀ x2 ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ x2 , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → x2 = m ∧ h = n ∧ l = o))) $ by all_congr [g2a]
g2c0: $ (∀ x0 (∀ x1 (∀ e ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ e , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → e = m ∧ h = n ∧ l = o)))) ⟺ (∀ x0 (∀ x1 (∀ x2 ∀ h ∀ l ∀ m ∀ n ∀ o (⟨ x1 , ⟨ x2 , ⟨ h , l ⟩ ⟩ ⟩ ∈ etel u E z w x0 → ⟨ x1 , ⟨ m , ⟨ n , o ⟩ ⟩ ⟩ ∈ etel u E z w x0 → x2 = m ∧ h = n ∧ l = o)))) $ by all_congr [g2c1]
