e16: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q) ⇒ ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q) $ by ax
e17: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q) ⇒ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by ex_elim [e16, e15]
e18: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by ex_elim [d9, e17]
e19: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by and_intro [d2, e18]
e20: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by or_intro_r [e19]
f1: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) ⇒ (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) $ by ax
f2: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by or_elim [f1, c10, e20]
f3: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by cut [b2, f2]
f4: $ G , c = ccom (esf u E) s ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by wcel_elim [a6, f3]
f5a: $ G ⇒ isset s $ by isset_var
f5b: $ G ⇒ functional (esf u E) $ by esf_functional
f5: $ G ⇒ isset (ccom (esf u E) s) $ by ccom_set [f5b, f5a]
f6: $ G ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by isset_elim [f5, f4]

lemma c3_es_use {y x0 x1: set} (G: hyps y x0 x1) (E A: class) (u w p q: set):
  $ G ⇒ A ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ > $ G ⇒ p ∊ esat u E A w $ > $ G ⇒ q ∊ esat u E A w $ > $ G ⇒ cdm p = cdm q $
----
l1: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by ax
l2: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ ∀ x0 ∀ x1 (x0 ∊ esat u E e w → x1 ∊ esat u E e w → cdm x0 = cdm x1) $ by cab_elim [l1]
l3: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ ∀ x1 (p ∊ esat u E e w → x1 ∊ esat u E e w → cdm p = cdm x1) $ by all_elim [l2]
l4: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ p ∊ esat u E e w → q ∊ esat u E e w → cdm p = cdm q $ by all_elim [l3]
l5: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ e = A $ by ax
l6: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ A = e $ by eq_sym [l5]
l7: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ (esf u E) = (esf u E) $ by eq_refl
l8: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ fv (esf u E) A = fv (esf u E) e $ by fv_eq [l7, l6]
l9: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ w = w $ by eq_refl
l10: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ esat u E A w = esat u E e w $ by ap_eq [l8, l9]
l11a: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ p ∊ esat u E A w $ by weaken [#2]
l11b: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ q ∊ esat u E A w $ by weaken [#3]
l11: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ p ∊ esat u E e w $ by welc_eq [l10, l11a]
l12: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ q ∊ esat u E e w $ by welc_eq [l10, l11b]
l13: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ q ∊ esat u E e w → cdm p = cdm q $ by imp_elim [l4, l11]
l14: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ cdm p = cdm q $ by imp_elim [l13, l12]
l15: $ G ⇒ cdm p = cdm q $ by wcel_elim [#1, l14]

lemma c3_esat_lab (G: hyps) (E: class) (u k s w p: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ p ∊ esat u E ⟨ k , s ⟩ w $ >
  $ G ⇒ k = kc_nil ∨ k = kc_cons $
----
l1: $ G ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by c3_esat_dec [#1, #2, #3]
a1: $ G , k = kc_nil ∧ p = ∅ ⇒ k = kc_nil ∧ p = ∅ $ by ax
b1: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by ax
a2: $ G , k = kc_nil ∧ p = ∅ ⇒ k = kc_nil $ by and_elim_l [a1]
a3: $ G , k = kc_nil ∧ p = ∅ ⇒ k = kc_nil ∨ k = kc_cons $ by or_intro_l [a2]
b2: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ k = kc_cons $ by and_elim_l [b1]
b3: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ k = kc_nil ∨ k = kc_cons $ by or_intro_r [b2]
z: $ G ⇒ k = kc_nil ∨ k = kc_cons $ by or_elim [l1, a3, b3]

lemma c3_esat_nil (G: hyps) (E: class) (u k s w p: set):
  $ G ⇒ k = kc_nil $ > $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ p ∊ esat u E ⟨ k , s ⟩ w $ >
  $ G ⇒ p = ∅ $
----
l1: $ G ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by c3_esat_dec [#2, #3, #4]
a1: $ G , k = kc_nil ∧ p = ∅ ⇒ k = kc_nil ∧ p = ∅ $ by ax
b1: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by ax
a3: $ G , k = kc_nil ∧ p = ∅ ⇒ p = ∅ $ by and_elim_r [a1]
b2: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ k = kc_cons $ by and_elim_l [b1]
b2a: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ k = kc_nil $ by weaken [#1]
b2b: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ kc_nil = k $ by eq_sym [b2a]
b2c: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ kc_nil = kc_cons $ by eq_trans [b2b, b2]
b2d: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
b2e: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ ⊥ $ by not_elim [b2d, b2c]
b3: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ p = ∅ $ by bot_elim [b2e]
z: $ G ⇒ p = ∅ $ by or_elim [l1, a3, b3]

lemma c3_esat_cons {x q: set} (G: hyps) (E: class) (u k s w p: set):
  $ G ⇒ k = kc_cons $ > $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ p ∊ esat u E ⟨ k , s ⟩ w $ >
  $ G ⇒ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $
----
l1: $ G ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by c3_esat_dec [#2, #3, #4]
a1: $ G , k = kc_nil ∧ p = ∅ ⇒ k = kc_nil ∧ p = ∅ $ by ax
b1: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by ax
a2: $ G , k = kc_nil ∧ p = ∅ ⇒ k = kc_nil $ by and_elim_l [a1]
a2a: $ G , k = kc_nil ∧ p = ∅ ⇒ k = kc_cons $ by weaken [#1]
a2b: $ G , k = kc_nil ∧ p = ∅ ⇒ kc_nil = k $ by eq_sym [a2]
a2c: $ G , k = kc_nil ∧ p = ∅ ⇒ kc_nil = kc_cons $ by eq_trans [a2b, a2a]
a2d: $ G , k = kc_nil ∧ p = ∅ ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
a2e: $ G , k = kc_nil ∧ p = ∅ ⇒ ⊥ $ by not_elim [a2d, a2c]
a3: $ G , k = kc_nil ∧ p = ∅ ⇒ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by bot_elim [a2e]
b3: $ G , k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) ⇒ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by and_elim_r [b1]
z: $ G ⇒ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q) $ by or_elim [l1, a3, b3]

lemma c3_es_step {y x0 x1: set} (G: hyps y x0 x1) (E: class) (u w k s p1 p2: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ crn s ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ > $ G ⇒ p1 ∊ esat u E ⟨ k , s ⟩ w $ > $ G ⇒ p2 ∊ esat u E ⟨ k , s ⟩ w $ >
  $ G ⇒ cdm p1 = cdm p2 $
----
s1: $ G ⇒ k = kc_nil ∨ k = kc_cons $ by c3_esat_lab [#1, #2, #4]
t0: $ G , k = kc_nil ⇒ k = kc_nil $ by ax
t0a: $ G , k = kc_nil ⇒ k ∊ ω $ by weaken [#1]
t0b: $ G , k = kc_nil ⇒ s ∊ fseq (trees ω) $ by weaken [#2]
t0c: $ G , k = kc_nil ⇒ p1 ∊ esat u E ⟨ k , s ⟩ w $ by weaken [#4]
t0d: $ G , k = kc_nil ⇒ p2 ∊ esat u E ⟨ k , s ⟩ w $ by weaken [#5]
t3: $ G , k = kc_nil ⇒ p1 = ∅ $ by c3_esat_nil [t0, t0a, t0b, t0c]
t4: $ G , k = kc_nil ⇒ p2 = ∅ $ by c3_esat_nil [t0, t0a, t0b, t0d]
t5: $ G , k = kc_nil ⇒ ∅ = p2 $ by eq_sym [t4]
t6: $ G , k = kc_nil ⇒ p1 = p2 $ by eq_trans [t3, t5]
t7: $ G , k = kc_nil ⇒ cdm p1 = cdm p2 $ by cdm_eq [t6]
w0: $ G , k = kc_cons ⇒ k = kc_cons $ by ax
w0a: $ G , k = kc_cons ⇒ k ∊ ω $ by weaken [#1]
w0b: $ G , k = kc_cons ⇒ s ∊ fseq (trees ω) $ by weaken [#2]
w0c: $ G , k = kc_cons ⇒ p1 ∊ esat u E ⟨ k , s ⟩ w $ by weaken [#4]
w0d: $ G , k = kc_cons ⇒ p2 ∊ esat u E ⟨ k , s ⟩ w $ by weaken [#5]
w3: $ G , k = kc_cons ⇒ ∃ x ∃ d (d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d) $ by c3_esat_cons [w0, w0a, w0b, w0c]
w4: $ G , k = kc_cons ⇒ ∃ b ∃ e (e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e) $ by c3_esat_cons [w0, w0a, w0b, w0d]
i1: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d $ by ax
i2: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e $ by ax
i3: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ d ∊ esat u E (fv s (suc ∅)) w $ by and_elim_l [i1]
i4: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d $ by and_elim_r [i1]
i5: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ fv s (suc ∅) ∈ crn s $ by and_elim_l [i4]
i6: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ p1 = scons x d $ by and_elim_r [i4]
i7: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ e ∊ esat u E (fv s (suc ∅)) w $ by and_elim_l [i2]
i8: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e $ by and_elim_r [i2]
i9: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ p2 = scons b e $ by and_elim_r [i8]
j1: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ crn s ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by weaken [#3]
j2: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ fv s (suc ∅) ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by wcel_subset [j1, i5]
j3: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm d = cdm e $ by c3_es_use [j2, i3, i7]
j4: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ esat u E (fv s (suc ∅)) w ⊆ fseq u $ by esat_fseq
j5: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ d ∊ fseq u $ by subset_elim [j4, i3]
j6: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ e ∊ fseq u $ by subset_elim [j4, i7]
j7: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm p1 = cdm (scons x d) $ by cdm_eq [i6]
j8: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm (scons x d) = suc (cdm d) $ by scons_len [j5]
j9: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ suc (cdm d) = suc (cdm e) $ by suc_eq [j3]
j10: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm p2 = cdm (scons b e) $ by cdm_eq [i9]
j11: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm (scons b e) = suc (cdm e) $ by scons_len [j6]
j12: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ suc (cdm e) = cdm (scons b e) $ by eq_sym [j11]
j13: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm (scons b e) = cdm p2 $ by eq_sym [j10]
j14: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm p1 = suc (cdm d) $ by eq_trans [j7, j8]
j15: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm p1 = suc (cdm e) $ by eq_trans [j14, j9]
j16: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm p1 = cdm (scons b e) $ by eq_trans [j15, j12]
j17: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e ⇒ cdm p1 = cdm p2 $ by eq_trans [j16, j13]
xa0a: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , ∃ e (e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e) ⇒ ∃ e (e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e) $ by ax
xa0b: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d , ∃ e (e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e) ⇒ cdm p1 = cdm p2 $ by ex_elim [xa0a, j17]
xa9: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d ⇒ ∃ b ∃ e (e ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p2 = scons b e) $ by weaken [w4]
xb9: $ G , k = kc_cons , d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d ⇒ cdm p1 = cdm p2 $ by ex_elim [xa9, xa0b]
xc0a: $ G , k = kc_cons , ∃ d (d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d) ⇒ ∃ d (d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d) $ by ax
xc0b: $ G , k = kc_cons , ∃ d (d ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p1 = scons x d) ⇒ cdm p1 = cdm p2 $ by ex_elim [xc0a, xb9]
xd9: $ G , k = kc_cons ⇒ cdm p1 = cdm p2 $ by ex_elim [w3, xc0b]
z1: $ G ⇒ cdm p1 = cdm p2 $ by or_elim [s1, t7, xd9]

lemma c3_es_node {y x0 x1: set} (G: hyps y x0 x1) (E: class) (u w k s: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ crn s ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ > $ G ⇒ ⟨ k , s ⟩ ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $
----
a1: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ z = ⟨ k , s ⟩ $ by ax
a2: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ (esf u E) = (esf u E) $ by eq_refl
a3: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ fv (esf u E) z = fv (esf u E) ⟨ k , s ⟩ $ by fv_eq [a2, a1]
a4: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ w = w $ by eq_refl
a5: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ esat u E z w = esat u E ⟨ k , s ⟩ w $ by ap_eq [a3, a4]
a6: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ b ∊ esat u E z w $ by ax
a7: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ d ∊ esat u E z w $ by ax
a8: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ b ∊ esat u E ⟨ k , s ⟩ w $ by welc_eq [a5, a6]
a9: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ d ∊ esat u E ⟨ k , s ⟩ w $ by welc_eq [a5, a7]
a10: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ k ∊ ω $ by weaken [#1]
a11: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ s ∊ fseq (trees ω) $ by weaken [#2]
a12: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ crn s ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by weaken [#3]
a13: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w , d ∊ esat u E z w ⇒ cdm b = cdm d $ by c3_es_step [a10, a11, a12, a8, a9]
c1: $ G , z = ⟨ k , s ⟩ , b ∊ esat u E z w ⇒ d ∊ esat u E z w → cdm b = cdm d $ by imp_intro [a13]
c0: $ G , z = ⟨ k , s ⟩ ⇒ b ∊ esat u E z w → d ∊ esat u E z w → cdm b = cdm d $ by imp_intro [c1]
d1: $ G , z = ⟨ k , s ⟩ ⇒ ∀ d (b ∊ esat u E z w → d ∊ esat u E z w → cdm b = cdm d) $ by all_intro [c0]
d0: $ G , z = ⟨ k , s ⟩ ⇒ ∀ b ∀ d (b ∊ esat u E z w → d ∊ esat u E z w → cdm b = cdm d) $ by all_intro [d1]
g0a: $ (∀ b ∀ d (b ∊ esat u E z w → d ∊ esat u E z w → cdm b = cdm d)) ⟺ (∀ x0 ∀ d (x0 ∊ esat u E z w → d ∊ esat u E z w → cdm x0 = cdm d)) $ by all_alpha
g0w: $ G , z = ⟨ k , s ⟩ ⇒ (∀ b ∀ d (b ∊ esat u E z w → d ∊ esat u E z w → cdm b = cdm d)) ↔ (∀ x0 ∀ d (x0 ∊ esat u E z w → d ∊ esat u E z w → cdm x0 = cdm d)) $ by weaken [g0a]
g0e: $ G , z = ⟨ k , s ⟩ ⇒ ∀ x0 ∀ d (x0 ∊ esat u E z w → d ∊ esat u E z w → cdm x0 = cdm d) $ by bi_elim_l [g0w, d0]
g1a: $ (∀ d (x0 ∊ esat u E z w → d ∊ esat u E z w → cdm x0 = cdm d)) ⟺ (∀ x1 (x0 ∊ esat u E z w → x1 ∊ esat u E z w → cdm x0 = cdm x1)) $ by all_alpha
g1c0: $ (∀ x0 (∀ d (x0 ∊ esat u E z w → d ∊ esat u E z w → cdm x0 = cdm d))) ⟺ (∀ x0 (∀ x1 (x0 ∊ esat u E z w → x1 ∊ esat u E z w → cdm x0 = cdm x1))) $ by all_congr [g1a]
g1w: $ G , z = ⟨ k , s ⟩ ⇒ (∀ x0 ∀ d (x0 ∊ esat u E z w → d ∊ esat u E z w → cdm x0 = cdm d)) ↔ (∀ x0 ∀ x1 (x0 ∊ esat u E z w → x1 ∊ esat u E z w → cdm x0 = cdm x1)) $ by weaken [g1c0]
g1e: $ G , z = ⟨ k , s ⟩ ⇒ ∀ x0 ∀ x1 (x0 ∊ esat u E z w → x1 ∊ esat u E z w → cdm x0 = cdm x1) $ by bi_elim_l [g1w, g0e]
h7: $ G ⇒ isset ⟨ k , s ⟩ $ by opair_isset
h8: $ G ⇒ ⟨ k , s ⟩ ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by wcel_cab_intro [h7, g1e]

esat_len
--------
n1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ k ∊ ω $ by ax
n2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ j ∊ fseq (trees ω) $ by ax
n3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by ax
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} ⇒ ⟨ k , j ⟩ ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by c3_es_node [n1, n2, n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} → ⟨ k , j ⟩ ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by imp_intro [n4]
n6: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} → ⟨ k , j ⟩ ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by imp_intro [n5]
n7: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} → ⟨ k , j ⟩ ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by imp_intro [n6]
n8: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} → ⟨ k , j ⟩ ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)}) $ by all_intro [n7]
n9: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} → ⟨ k , j ⟩ ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)}) $ by all_intro [n8]
n10: $ G ⇒ isset ω $ by omega_set
n11: $ G ⇒ trees ω ⊆ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by trees_ind_c [n10, n9]
n12: $ G ⇒ T ∈ {y | ∀ x0 ∀ x1 (x0 ∊ esat u E y w → x1 ∊ esat u E y w → cdm x0 = cdm x1)} $ by wcel_subset [n11, #1]
n13: $ G ⇒ cdm p = cdm q $ by c3_es_use [n12, #2, #3]

lemma c3_eq_node {x9: set} (G: hyps x9) (E E2: class) (u k s: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ crn s ⊆ {x9 | eagr E E2 x9 → fv (esf u E) x9 = fv (esf u E2) x9} $ > $ G ⇒ ⟨ k , s ⟩ ∈ {x9 | eagr E E2 x9 → fv (esf u E) x9 = fv (esf u E2) x9} $
----
a0a: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ k ∊ ω $ by weaken [#1]
a0b: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ s ∊ fseq (trees ω) $ by weaken [#2]
a1: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ z = ⟨ k , s ⟩ $ by ax
a2o: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ isset ω $ by omega_set
a2k: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ k ∈ ω $ by welc_wcel [a0a]
a2h: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ s ∈ fseq (trees ω) $ by welc_wcel [a0b]
a2: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ ⟨ k , s ⟩ ∈ trees ω $ by trees_intro_c [a2o, a2k, a2h]
a3: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ ⟨ k , s ⟩ ∈ fv tsub ⟨ k , s ⟩ $ by tsub_self [a2]
a4a: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ tsub = tsub $ by eq_refl
a4: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ fv tsub z = fv tsub ⟨ k , s ⟩ $ by fv_eq [a4a, a1]
a5: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ fv tsub ⟨ k , s ⟩ = fv tsub z $ by eq_sym [a4]
a6: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ ⟨ k , s ⟩ ∈ fv tsub z $ by wcel_eq_r [a5, a3]
a7: $ G , z = ⟨ k , s ⟩ , eagr E E2 z ⇒ eagr E E2 z $ by ax
