g7: $ G , (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) , (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) ⇒ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) } $ by welc_eq [g6, g5]
g8: $ G , (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) , (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) ⇒ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) }) $ by and_intro [g4, g7]
g9: $ G , (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) , (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) ⇒ (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) }) $ by or_intro_r [g8]
g10: $ G , (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) ⇒ (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) $ by ax
g11: $ G , (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) ⇒ (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) }) $ by or_elim [g10, g2, g9]
h1: $ G ⇒ ((E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) })) ↔ ((F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) })) $ by bi_intro [f11, g11]
h2: $ G ⇒ ∀ z (((E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) })) ↔ ((F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }))) $ by all_intro [h1]
h3: $ G ⇒ {z | (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) }) } = {z | (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) } $ by cab_eq [h2]

lemma c3_esb_set (G: hyps) (M K S: class) (u v: set): $ G ⇒ isset (esb u M K S v) $
----
a1: $ G ⇒ isset lvals $ by lvals_set
a2: $ G , w ∊ lvals ⇒ isset ∅ $ by ax_empty
a3: $ G , w ∊ lvals ⇒ isset (csn ∅) $ by csn_set [a2]
a4: $ G ⇒ w ∊ lvals → isset (csn ∅) $ by imp_intro [a3]
a5: $ G ⇒ ∀ w (w ∊ lvals → isset (csn ∅)) $ by all_intro [a4]
a6: $ G ⇒ isset (clam w lvals (csn ∅)) $ by clam_set [a1, a5]
b1: $ G , w ∊ lvals , y ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) } ⇒ y ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) } $ by ax
b2: $ G , w ∊ lvals , y ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) } ⇒ y ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ y = scons x q) $ by cab_elim [b1]
b3: $ G , w ∊ lvals , y ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) } ⇒ y ∊ fseq u $ by and_elim_l [b2]
b4: $ G , w ∊ lvals ⇒ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) } ⊆ fseq u $ by subset_intro [b3]
b5: $ G , w ∊ lvals ⇒ isset u $ by isset_var
b6: $ G , w ∊ lvals ⇒ isset (fseq u) $ by fseq_set [b5]
b7: $ G , w ∊ lvals ⇒ isset {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) } $ by subset_isset [b6, b4]
b8: $ G ⇒ w ∊ lvals → isset {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) } $ by imp_intro [b7]
b9: $ G ⇒ ∀ w (w ∊ lvals → isset {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) $ by all_intro [b8]
b10: $ G ⇒ isset (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) $ by clam_set [a1, b9]
c1: $ G ⇒ isset ((clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) })) $ by cun_set [a6, b10]
d1: $ G , z ∊ esb u M K S v ⇒ z ∊ esb u M K S v $ by ax
d2: $ G , z ∊ esb u M K S v ⇒ (K = kc_nil ∧ z ∊ (clam w lvals (csn ∅))) ∨ (K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) })) $ by cab_elim [d1]
d3: $ G , z ∊ esb u M K S v , K = kc_nil ∧ z ∊ (clam w lvals (csn ∅)) ⇒ K = kc_nil ∧ z ∊ (clam w lvals (csn ∅)) $ by ax
d4: $ G , z ∊ esb u M K S v , K = kc_nil ∧ z ∊ (clam w lvals (csn ∅)) ⇒ z ∊ (clam w lvals (csn ∅)) $ by and_elim_r [d3]
d5: $ G , z ∊ esb u M K S v , K = kc_nil ∧ z ∊ (clam w lvals (csn ∅)) ⇒ z ∊ (clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) $ by cun_intro_l [d4]
d6: $ G , z ∊ esb u M K S v , K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) ⇒ K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) $ by ax
d7: $ G , z ∊ esb u M K S v , K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) ⇒ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) $ by and_elim_r [d6]
d8: $ G , z ∊ esb u M K S v , K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) ⇒ z ∊ (clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) $ by cun_intro_r [d7]
d9: $ G , z ∊ esb u M K S v ⇒ z ∊ (clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) $ by or_elim [d2, d5, d8]
d10: $ G ⇒ esb u M K S v ⊆ (clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ da (fv M (fv S ∅)) w q ∧ r = scons x q) }) $ by subset_intro [d9]
d11: $ G ⇒ isset (esb u M K S v) $ by subset_isset [c1, d10]

esf_functional
--------------
l1: $ G ⇒ functional (cgr3 k j v (esb u M k j v)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (trc ω (cgr3 k j v (esb u M k j v))) $ by trc_functional_c [l2w, l1]

esf_node
--------
n1: $ G ⇒ functional (cgr3 i j v (esb u M i j v)) $ by cgr3_functional
n2w: $ G ⇒ isset ω $ by omega_set
n2: $ G ⇒ fv (esf u M) ⟨ k , s ⟩ = fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , ccom (esf u M) s ⟩ ⟩ $ by trc_node_c [n2w, n1, #1, #2]
n3: $ G ⇒ functional (esf u M) $ by esf_functional
n4: $ G ⇒ isset s $ by isset_var
n5: $ G ⇒ isset (ccom (esf u M) s) $ by ccom_set [n3, n4]
n6: $ G , c = ccom (esf u M) s ⇒ isset (esb u M k s c) $ by c3_esb_set
n7: $ G , c = ccom (esf u M) s ⇒ fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , c ⟩ ⟩ = esb u M k s c $ by fv_cgr3 [n6]
n8: $ G , c = ccom (esf u M) s ⇒ c = ccom (esf u M) s $ by ax
n9: $ G , c = ccom (esf u M) s ⇒ k = k $ by eq_refl
n10: $ G , c = ccom (esf u M) s ⇒ s = s $ by eq_refl
n11: $ G , c = ccom (esf u M) s ⇒ ⟨ s , c ⟩ = ⟨ s , ccom (esf u M) s ⟩ $ by opair_eq [n10, n8]
n12: $ G , c = ccom (esf u M) s ⇒ ⟨ k , ⟨ s , c ⟩ ⟩ = ⟨ k , ⟨ s , ccom (esf u M) s ⟩ ⟩ $ by opair_eq [n9, n11]
n13: $ G , c = ccom (esf u M) s ⇒ cgr3 i j v (esb u M i j v) = cgr3 i j v (esb u M i j v) $ by eq_refl
n14: $ G , c = ccom (esf u M) s ⇒ fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , c ⟩ ⟩ = fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , ccom (esf u M) s ⟩ ⟩ $ by fv_eq [n13, n12]
n15u: $ G , c = ccom (esf u M) s ⇒ u = u $ by eq_refl
n15m: $ G , c = ccom (esf u M) s ⇒ M = M $ by eq_refl
n15: $ G , c = ccom (esf u M) s ⇒ esb u M k s c = esb u M k s (ccom (esf u M) s) $ by esb_eq [n15u, n15m, n9, n10, n8]
n16: $ G , c = ccom (esf u M) s ⇒ fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , ccom (esf u M) s ⟩ ⟩ = fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , c ⟩ ⟩ $ by eq_sym [n14]
n17: $ G , c = ccom (esf u M) s ⇒ fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , ccom (esf u M) s ⟩ ⟩ = esb u M k s c $ by eq_trans [n16, n7]
n18: $ G , c = ccom (esf u M) s ⇒ fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , ccom (esf u M) s ⟩ ⟩ = esb u M k s (ccom (esf u M) s) $ by eq_trans [n17, n15]
n19: $ G , c = ccom (esf u M) s ⇒ fv (esf u M) ⟨ k , s ⟩ = fv (cgr3 i j v (esb u M i j v)) ⟨ k , ⟨ s , ccom (esf u M) s ⟩ ⟩ $ by weaken [n2]
n20: $ G , c = ccom (esf u M) s ⇒ fv (esf u M) ⟨ k , s ⟩ = esb u M k s (ccom (esf u M) s) $ by eq_trans [n19, n18]
n21: $ G ⇒ fv (esf u M) ⟨ k , s ⟩ = esb u M k s (ccom (esf u M) s) $ by isset_elim [n5, n20]

lemma c3_esb_pair_fseq (G: hyps) (M K S V W: class) (u y: set): $ G ⇒ ⟨ W , y ⟩ ∈ esb u M K S V $ > $ G ⇒ y ∊ fseq u $
----
r1: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V ⇒ c ∊ esb u M K S V $ by ax
r2: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V ⇒ (K = kc_nil ∧ c ∊ (clam g lvals (csn ∅))) ∨ (K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) })) $ by cab_elim [r1]
r3: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) ⇒ K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) $ by ax
r4: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) ⇒ c ∊ (clam g lvals (csn ∅)) $ by and_elim_r [r3]
s1: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ c = ⟨ W , y ⟩ $ by ax
s2: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ c = ⟨ a , b ⟩ $ by ax
s3: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ ⟨ W , y ⟩ = c $ by eq_sym [s1]
s4: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ ⟨ W , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [s3, s2]
s5: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset W $ by opair_eq_isset [s4]
s6: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset y $ by isset_var
s7: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset a $ by isset_var
s8: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset b $ by isset_var
s9: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ W = a ∧ y = b $ by opair_inj_c [s4, s5, s6, s7, s8]
s10: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ y = b $ by and_elim_r [s9]
s11: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ b ∊ csn ∅ $ by ax
s12: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ b = ∅ $ by csn_elim [s11]
