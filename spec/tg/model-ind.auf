z1: $ G ⇒ f = g ∧ c = d $ by or_elim [a1, fb0, hb0]

lemma c4_nvf_tyB {x i k: set} (G: hyps) (t j l f c g d a u b v e h: set): $ G ⇒ t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ $ > $ G ⇒ j = ⟨ kc_s , scons h ∅ ⟩ $ > $ G ⇒ f = a $ > $ G ⇒ c = b $ > $ G ⇒ ra_nth_ty e h a b ∈ lrel $ > $ G ⇒ ra_nth_ty t l g d ∈ lrel $ > $ G ⇒ fv nvf j = fv nvf l $ > $ G ⇒ ∀ x ∀ i ∀ k (ra_nth_ty x i f c ∈ lrel → ra_nth_ty x k g d ∈ lrel → fv nvf i = fv nvf k → suc (fv nvf i) = fv nvf j → f = g ∧ c = d) $ > $ G ⇒ f = g ∧ c = d $
----
a1: $ G ⇒ ∃ q ∃ r ∃ w (t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r) ∨ ∃ q ∃ x0 ∃ r ∃ x1 ∃ w ∃ x2 (t = ⟨ kc_tcons , scons x0 (scons x1 (scons w ∅)) ⟩ ∧ l = ⟨ kc_s , scons x2 ∅ ⟩ ∧ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel) $ by lrel_nth_ty_cases [#6]
a2: $ G ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
a3: $ G ⇒ isset kc_tcons $ by wcel_isset [a2]
a4: $ G ⇒ kr_nth_ty ∈ ω $ by kr_nth_ty_omega
a5: $ G ⇒ isset kr_nth_ty $ by wcel_isset [a4]
e1: $ G ⇒ e ∊ trees ω ∧ h ∊ trees ω ∧ a ∊ trees ω ∧ b ∊ trees ω $ by lrel_args4 [#5, a5]
e2: $ G ⇒ h ∊ trees ω ∧ a ∊ trees ω ∧ b ∊ trees ω $ by and_elim_r [e1]
e3: $ G ⇒ h ∊ trees ω $ by and_elim_l [e2]
e4: $ G ⇒ h ∈ trees ω $ by welc_wcel [e3]
e5: $ G ⇒ nvf = nvf $ by eq_refl
e6: $ G ⇒ fv nvf j = fv nvf ⟨ kc_s , scons h ∅ ⟩ $ by fv_eq [e5, #2]
e7: $ G ⇒ fv nvf ⟨ kc_s , scons h ∅ ⟩ = suc (fv nvf h) $ by nvf_s [e4]
e8: $ G ⇒ fv nvf j = suc (fv nvf h) $ by eq_trans [e6, e7]
e9: $ G ⇒ suc (fv nvf h) = fv nvf j $ by eq_sym [e8]
e10: $ G ⇒ suc (fv nvf h) = fv nvf l $ by eq_trans [e9, #7]
p1: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r $ by ax
pp0: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ $ by and_elim_l [p1]
ppr0: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r $ by and_elim_r [p1]
pp1: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ l = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [ppr0]
ppr1: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ g = q ∧ d = r $ by and_elim_r [ppr0]
pp2: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ g = q $ by and_elim_l [ppr1]
pp3: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ d = r $ by and_elim_r [ppr1]
c1: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ nvf = nvf $ by eq_refl
c2: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ fv nvf l = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [c1, pp1]
c3: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
c4: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ suc (fv nvf h) = fv nvf l $ by weaken [e10]
c5: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ suc (fv nvf h) = fv nvf ⟨ kc_nz , ∅ ⟩ $ by eq_trans [c4, c2]
c6: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ suc (fv nvf h) = ∅ $ by eq_trans [c5, c3]
c7: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ ⊥ $ by suc_ne_empty [c6]
c8: $ G , t = ⟨ kc_tcons , scons q (scons r (scons w ∅)) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = q ∧ d = r ⇒ f = g ∧ c = d $ by bot_elim [c7]
q1: $ G , t = ⟨ kc_tcons , scons x0 (scons x1 (scons w ∅)) ⟩ ∧ l = ⟨ kc_s , scons x2 ∅ ⟩ ∧ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel ⇒ t = ⟨ kc_tcons , scons x0 (scons x1 (scons w ∅)) ⟩ ∧ l = ⟨ kc_s , scons x2 ∅ ⟩ ∧ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel $ by ax
