lemma c5_iop_mono (G: hyps) (E D W A B: class) (u: set): $ G ⇒ A ⊆ B $ > $ G ⇒ iop u E D W A ⊆ iop u E D W B $
----
l1: $ G , z ∊ iop u E D W A ⇒ z ∊ iop u E D W A $ by ax
l2: $ G , z ∊ iop u E D W A ⇒ ∃ x (x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $ by cab_elim [l1]
l3: $ G , z ∊ iop u E D W A , x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x $ by ax
l4: $ G , z ∊ iop u E D W A , x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ A $ by and_elim_l [l3]
l5: $ G , z ∊ iop u E D W A , x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ∊ u ∧ z ∊ iop0 u E D W x $ by and_elim_r [l3]
l6: $ G , z ∊ iop u E D W A , x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ A ⊆ B $ by weaken [#1]
l7: $ G , z ∊ iop u E D W A , x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ B $ by subset_trans [l4, l6]
l8: $ G , z ∊ iop u E D W A , x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ B ∧ x ∊ u ∧ z ∊ iop0 u E D W x $ by and_intro [l7, l5]
l9: $ G , z ∊ iop u E D W A , x ⊆ A ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ ∃ x (x ⊆ B ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $ by ex_intro [l8]
l10: $ G , z ∊ iop u E D W A ⇒ ∃ x (x ⊆ B ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $ by ex_elim [l2, l9]
l11: $ G , z ∊ iop u E D W A ⇒ z ∊ iop u E D W B $ by cab_intro [l10]
l12: $ G ⇒ iop u E D W A ⊆ iop u E D W B $ by subset_intro [l11]

iop_mono
--------
m1: $ G , a ⊆ b ⇒ a ⊆ b $ by ax
m2: $ G , a ⊆ b ⇒ iop u E D W a ⊆ iop u E D W b $ by c5_iop_mono [m1]
m3: $ G ⇒ mono y (iop u E D W y) $ by mono_intro [m2]

lemma c5_iop_sub (G: hyps) (E D W Y: class) (u: set): $ G ⇒ iop u E D W Y ⊆ ω × (fseq u × fseq (ω ∪ u)) $
----
l1: $ G , z ∊ iop u E D W Y ⇒ z ∊ iop u E D W Y $ by ax
l2: $ G , z ∊ iop u E D W Y ⇒ ∃ x (x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $ by cab_elim [l1]
l3: $ G , z ∊ iop u E D W Y , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x $ by ax
l4: $ G , z ∊ iop u E D W Y , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ∊ u ∧ z ∊ iop0 u E D W x $ by and_elim_r [l3]
l5: $ G , z ∊ iop u E D W Y , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ z ∊ iop0 u E D W x $ by and_elim_r [l4]
l6: $ G , z ∊ iop u E D W Y , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ iop0 u E D W x ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by iop0_sub
l7: $ G , z ∊ iop u E D W Y , x ⊆ Y ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ z ∊ ω × (fseq u × fseq (ω ∪ u)) $ by subset_elim [l6, l5]
l8: $ G , z ∊ iop u E D W Y ⇒ z ∊ ω × (fseq u × fseq (ω ∪ u)) $ by ex_elim [l2, l7]
l9: $ G ⇒ iop u E D W Y ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by subset_intro [l8]

lemma c5_bound_set (G: hyps) (u: set): $ G ⇒ isset (ω × (fseq u × fseq (ω ∪ u))) $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset u $ by isset_var
l3: $ G ⇒ isset (fseq u) $ by fseq_set [l2]
l4: $ G ⇒ isset (ω ∪ u) $ by cun_set [l1, l2]
l5: $ G ⇒ isset (fseq (ω ∪ u)) $ by fseq_set [l4]
l6: $ G ⇒ isset (fseq u × fseq (ω ∪ u)) $ by cxp_set [l3, l5]
l7: $ G ⇒ isset (ω × (fseq u × fseq (ω ∪ u))) $ by cxp_set [l1, l6]

iop_setop
---------
s1: $ _ ⇒ iop u E D W y ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by c5_iop_sub
s2: $ _ ⇒ isset (ω × (fseq u × fseq (ω ∪ u))) $ by c5_bound_set
s3: $ _ ⇒ isset (iop u E D W y) $ by subset_isset [s2, s1]
s4: $ _ ⇒ setop y (iop u E D W y) $ by setop_intro [s3]
s5: $ G ⇒ setop y (iop u E D W y) $ by weaken [s4]

iop_bounded
-----------
l1: $ G , a ⊆ ω × (fseq u × fseq (ω ∪ u)) ⇒ iop u E D W a ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by c5_iop_sub
l2: $ G ⇒ bounded y (iop u E D W y) (ω × (fseq u × fseq (ω ∪ u))) $ by bounded_intro [l1]

ifam_fix
--------
l1: $ G ⇒ mono y (iop u E D W y) $ by iop_mono
l2: $ G ⇒ setop y (iop u E D W y) $ by iop_setop
l3: $ G ⇒ bounded y (iop u E D W y) (ω × (fseq u × fseq (ω ∪ u))) $ by iop_bounded
l4: $ G ⇒ isset (ω × (fseq u × fseq (ω ∪ u))) $ by c5_bound_set
l5: $ G ⇒ cap y (iop u E D W y) (lfp y (iop u E D W y)) = lfp y (iop u E D W y) $ by lfp_fix [l1, l2, l3, l4]

ifam_sub
--------
l2: $ G ⇒ setop y (iop u E D W y) $ by iop_setop
l3: $ G ⇒ bounded y (iop u E D W y) (ω × (fseq u × fseq (ω ∪ u))) $ by iop_bounded
l5: $ G ⇒ lfp y (iop u E D W y) ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by lfp_bounded [l3, l2]

ifam_set
--------
l2: $ G ⇒ setop y (iop u E D W y) $ by iop_setop
l3: $ G ⇒ bounded y (iop u E D W y) (ω × (fseq u × fseq (ω ∪ u))) $ by iop_bounded
l4: $ G ⇒ isset (ω × (fseq u × fseq (ω ∪ u))) $ by c5_bound_set
l5: $ G ⇒ isset (lfp y (iop u E D W y)) $ by lfp_set [l3, l2, l4]

--| The family is a fixed point of the operator, as an equation at the family itself.
lemma c5_ifam_eq (G: hyps) (E D W: class) (u: set): $ G ⇒ iop u E D W (ifam u E D W) = ifam u E D W $
----
k0: $ G ⇒ isset (ifam u E D W) $ by ifam_set
k1: $ G , a = ifam u E D W ⇒ a = ifam u E D W $ by ax
k2: $ G , a = ifam u E D W ⇒ cap y (iop u E D W y) (ifam u E D W) = iop u E D W a $ by cap_eq [k1]
k3: $ G , a = ifam u E D W ⇒ cap y (iop u E D W y) (ifam u E D W) = ifam u E D W $ by ifam_fix
k4: $ G , a = ifam u E D W ⇒ iop u E D W a = cap y (iop u E D W y) (ifam u E D W) $ by eq_sym [k2]
k5: $ G , a = ifam u E D W ⇒ iop u E D W a = ifam u E D W $ by eq_trans [k4, k3]
k6: $ G , a = ifam u E D W ⇒ ifam u E D W = a $ by eq_sym [k1]
k7: $ G , a = ifam u E D W ⇒ ifam u E D W ⊆ a $ by eq_subset [k6]
k8: $ G , a = ifam u E D W ⇒ a ⊆ ifam u E D W $ by eq_subset [k1]
k9: $ G , a = ifam u E D W ⇒ iop u E D W (ifam u E D W) ⊆ iop u E D W a $ by c5_iop_mono [k7]
k10: $ G , a = ifam u E D W ⇒ iop u E D W a ⊆ iop u E D W (ifam u E D W) $ by c5_iop_mono [k8]
k11: $ G , a = ifam u E D W ⇒ iop u E D W (ifam u E D W) = iop u E D W a $ by subset_antisym [k9, k10]
k12: $ G , a = ifam u E D W ⇒ iop u E D W (ifam u E D W) = ifam u E D W $ by eq_trans [k11, k5]
k13: $ G ⇒ iop u E D W (ifam u E D W) = ifam u E D W $ by isset_elim [k0, k12]

ifam_intro
----------
i0: $ G ⇒ x ∊ u ∧ z ∊ iop0 u E D W x $ by and_intro [#2, #3]
i1: $ G ⇒ x ⊆ ifam u E D W ∧ x ∊ u ∧ z ∊ iop0 u E D W x $ by and_intro [#1, i0]
i2: $ G ⇒ ∃ v (v ⊆ ifam u E D W ∧ v ∊ u ∧ z ∊ iop0 u E D W v) $ by ex_intro [i1]
i3: $ G ⇒ z ∊ iop u E D W (ifam u E D W) $ by cab_intro [i2]
i4: $ G ⇒ iop u E D W (ifam u E D W) = ifam u E D W $ by c5_ifam_eq
i5: $ G ⇒ iop u E D W (ifam u E D W) ⊆ ifam u E D W $ by eq_subset [i4]
i6: $ G ⇒ z ∊ ifam u E D W $ by subset_elim [i5, i3]

ifam_elim
---------
e0: $ G ⇒ iop u E D W (ifam u E D W) = ifam u E D W $ by c5_ifam_eq
e1: $ G ⇒ ifam u E D W = iop u E D W (ifam u E D W) $ by eq_sym [e0]
e2: $ G ⇒ ifam u E D W ⊆ iop u E D W (ifam u E D W) $ by eq_subset [e1]
e3: $ G ⇒ z ∊ iop u E D W (ifam u E D W) $ by subset_elim [e2, #1]
e4: $ G ⇒ ∃ x (x ⊆ ifam u E D W ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $ by cab_elim [e3]

ifam_ind
--------
a1: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w ⇒ z ∊ iop u E D W w $ by ax
a2: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w ⇒ ∃ x (x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x) $ by cab_elim [a1]
b1: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x $ by ax
b2: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ w $ by and_elim_l [b1]
b3: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ∊ u ∧ z ∊ iop0 u E D W x $ by and_elim_r [b1]
b4: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ∊ u $ by and_elim_l [b3]
b5: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ z ∊ iop0 u E D W x $ by and_elim_r [b3]
b6: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ w ⊆ ifam u E D W $ by ax
b7: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ ifam u E D W $ by subset_trans [b2, b6]
b8: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ w ⊆ {y | p} $ by ax
b9: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ {y | p} $ by subset_trans [b2, b8]
b10: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ ∀ x (x ⊆ ifam u E D W → x ∊ u → x ⊆ {y | p} → iop0 u E D W x ⊆ {y | p}) $ by weaken [#1]
b11: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ ifam u E D W → x ∊ u → x ⊆ {y | p} → iop0 u E D W x ⊆ {y | p} $ by all_elim [b10]
b12: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ∊ u → x ⊆ {y | p} → iop0 u E D W x ⊆ {y | p} $ by imp_elim [b11, b7]
b13: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ x ⊆ {y | p} → iop0 u E D W x ⊆ {y | p} $ by imp_elim [b12, b4]
b14: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ iop0 u E D W x ⊆ {y | p} $ by imp_elim [b13, b9]
b15: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w , x ⊆ w ∧ x ∊ u ∧ z ∊ iop0 u E D W x ⇒ z ∊ {y | p} $ by subset_elim [b14, b5]
b16: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} , z ∊ iop u E D W w ⇒ z ∊ {y | p} $ by ex_elim [a2, b15]
c1: $ G , w ⊆ ifam u E D W , w ⊆ {y | p} ⇒ iop u E D W w ⊆ {y | p} $ by subset_intro [b16]
c2: $ G , w ⊆ ifam u E D W ⇒ w ⊆ {y | p} → iop u E D W w ⊆ {y | p} $ by imp_intro [c1]
c3: $ G ⇒ w ⊆ ifam u E D W → w ⊆ {y | p} → iop u E D W w ⊆ {y | p} $ by imp_intro [c2]
c4: $ G ⇒ ∀ w (w ⊆ ifam u E D W → w ⊆ {y | p} → iop u E D W w ⊆ {y | p}) $ by all_intro [c3]
d1: $ G ⇒ mono v (iop u E D W v) $ by iop_mono
d2: $ G ⇒ setop v (iop u E D W v) $ by iop_setop
d3: $ G ⇒ bounded v (iop u E D W v) (ω × (fseq u × fseq (ω ∪ u))) $ by iop_bounded
d4: $ G ⇒ isset (ω × (fseq u × fseq (ω ∪ u))) $ by c5_bound_set
d5: $ G ⇒ lfp v (iop u E D W v) ⊆ {y | p} $ by lfp_ind [d1, d2, d3, d4, c4]

--| One step at equal candidates.
lemma c5_iop0_tr (G: hyps) (U E D W Z Z2: class): $ G ⇒ Z = Z2 $ > $ G ⇒ iop0 U E D W Z ⊆ iop0 U E D W Z2 $
----
y1: $ G , z ∊ iop0 U E D W Z ⇒ z ∊ iop0 U E D W Z $ by ax
y2: $ G , z ∊ iop0 U E D W Z ⇒ ∃ p ∃ q ∃ e ∃ j ∃ c ∃ k ∃ f ∃ g ∃ t ∃ a (iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) $ by cab_elim [y1]
c1: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ $ by ax
c2: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ iprt D q e $ by and_elim_l [c1]
c3: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ $ by and_elim_r [c1]
c4: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ p ∊ esat U E q W $ by and_elim_l [c3]
c5: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ $ by and_elim_r [c3]
c6: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ ictk D j c k $ by and_elim_l [c5]
c7: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ $ by and_elim_r [c5]
c8: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) $ by and_elim_l [c7]
c9: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ $ by and_elim_r [c7]
d1: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ Z = Z2 $ by weaken [#1]
d2d: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ D = D $ by eq_refl
d2w: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ W = W $ by eq_refl
d2: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ ixs D W Z = ixs D W Z2 $ by ixs_eq [d2d, d2w, d1]
d3: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ p = p $ by eq_refl
d4: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ scat p (ixs D W Z) = scat p (ixs D W Z2) $ by scat_eq [d3, d2]
d5: $ G , z ∊ iop0 U E D W Z , iprt D q e ∧ p ∊ esat U E q W ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W (scat p (ixs D W Z)) ∧ a ∊ fseq U ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩ ⇒ fv (etf U E) k = fv (etf U E) k $ by eq_refl
