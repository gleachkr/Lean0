r2: $ G , z ∊ etb u E K S V , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)}) ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by bot_elim [h2d]
r3a: $ G , z ∊ etb u E K S V , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_elim_r [p3]
r3: $ G , z ∊ etb u E K S V , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_elim_r [r3a]
s23a: $ G , z ∊ etb u E K S V , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by ax
s23: $ G , z ∊ etb u E K S V , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by or_elim [s23a, r2, r3]
s1: $ G , z ∊ etb u E K S V ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by or_elim [d2, r1, s23]
t1: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by ax
t2: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_pi $ by weaken [#1]
t2a: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_app $ by weaken [#2]
t2b: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_intro [t2a, t1]
t3: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_intro [t2, t2b]
t3a: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by or_intro_r [t3]
t4: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)})) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by or_intro_r [t3a]
t5: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ z ∊ etb u E K S V $ by cab_intro [t4]
t6: $ G ⇒ etb u E K S V = clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by eq_intro [s1, t5]

def c3_V (.x: set): class = $ {x | x = x} $

lemma c3_inV (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ c3_V $
----
l1: $ G , z = A ⇒ z = z $ by eq_refl
l2: $ G ⇒ A ∈ c3_V $ by wcel_cab_intro [#1, l1]

--| The values of the children of a node with two.
lemma c3_cc2 (G: hyps) (F T T2: class):
  $ G ⇒ functional F $ > $ G ⇒ T ∈ cdm F $ > $ G ⇒ T2 ∈ cdm F $ >
  $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) ∅ = fv F T ∧ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv F T2 $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ ccom F (scons T2 ∅) = scons (fv F T2) (ccom F ∅) $ by ccom_scons_c [#1, #3, l1]
l3: $ G ⇒ ccom F ∅ = ∅ $ by ccom_empty
l4: $ G ⇒ fv F T2 = fv F T2 $ by eq_refl
l5: $ G ⇒ scons (fv F T2) (ccom F ∅) = scons (fv F T2) ∅ $ by scons_eq [l4, l3]
l6: $ G ⇒ ccom F (scons T2 ∅) = scons (fv F T2) ∅ $ by eq_trans [l2, l5]
l7: $ G ⇒ isset T2 $ by wcel_isset [#3]
l8: $ G ⇒ isset (fv F T2) $ by fv_set_c [#1, l7]
l9: $ G ⇒ fv F T2 ∈ c3_V $ by c3_inV [l8]
l10: $ G ⇒ ∅ ∈ fseq c3_V $ by fseq_empty
l11: $ G ⇒ scons (fv F T2) ∅ ∈ fseq c3_V $ by scons_fseq_c [l9, l10]
l12: $ G ⇒ isset (scons (fv F T2) ∅) $ by wcel_isset [l11]
l13: $ G ⇒ scons (fv F T2) ∅ = ccom F (scons T2 ∅) $ by eq_sym [l6]
l14: $ G ⇒ isset (ccom F (scons T2 ∅)) $ by isset_eq [l13, l12]
l15: $ G ⇒ T2 ∈ c3_V $ by c3_inV [l7]
l16: $ G ⇒ scons T2 ∅ ∈ fseq c3_V $ by scons_fseq_c [l15, l10]
l17: $ G ⇒ isset (scons T2 ∅) $ by wcel_isset [l16]
l18: $ G ⇒ ccom F (scons T (scons T2 ∅)) = scons (fv F T) (ccom F (scons T2 ∅)) $ by ccom_scons_c [#1, #2, l17]
l19: $ G ⇒ isset T $ by wcel_isset [#2]
l20: $ G ⇒ isset (fv F T) $ by fv_set_c [#1, l19]
l21: $ G ⇒ fv (scons (fv F T) (ccom F (scons T2 ∅))) ∅ = fv F T $ by scons_fv_zero_c [l20, l14]
l22: $ G ⇒ ∅ = ∅ $ by eq_refl
l23: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) ∅ = fv (scons (fv F T) (ccom F (scons T2 ∅))) ∅ $ by fv_eq [l18, l22]
l24: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) ∅ = fv F T $ by eq_trans [l23, l21]
l25: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l26: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv (scons (fv F T) (ccom F (scons T2 ∅))) (suc ∅) $ by fv_eq [l18, l25]
l27: $ G ⇒ fv (scons (fv F T) (ccom F (scons T2 ∅))) (suc ∅) = fv (ccom F (scons T2 ∅)) ∅ $ by scons_fv_suc_c [l20, l14, l1]
l28: $ G ⇒ fv (ccom F (scons T2 ∅)) ∅ = fv (scons (fv F T2) ∅) ∅ $ by fv_eq [l6, l22]
l29: $ G ⇒ fv (scons (fv F T2) ∅) ∅ = fv F T2 $ by scons_fv_zero_c [l8, l1]
l30: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv (ccom F (scons T2 ∅)) ∅ $ by eq_trans [l26, l27]
l31: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv (scons (fv F T2) ∅) ∅ $ by eq_trans [l30, l28]
l32: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv F T2 $ by eq_trans [l31, l29]
l33: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) ∅ = fv F T ∧ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv F T2 $ by and_intro [l24, l32]

etf_cdm
-------
l1: $ G ⇒ functional (cgr3 k j v (etb u E k j v)) $ by cgr3_functional
l2: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ cdm (trc ω (cgr3 k j v (etb u E k j v))) = trees ω $ by trc_cdm_c [l2, l1]

etel_pi
-------
l1: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ G ⇒ scons B ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l2]
l4: $ G ⇒ scons A (scons B ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l3]
l5: $ G ⇒ functional (etf u E) $ by etf_functional
l6: $ G ⇒ cdm (etf u E) = trees ω $ by etf_cdm
l7: $ G ⇒ trees ω = cdm (etf u E) $ by eq_sym [l6]
l8: $ G ⇒ A ∈ cdm (etf u E) $ by wcel_eq_r [l7, #1]
l9: $ G ⇒ B ∈ cdm (etf u E) $ by wcel_eq_r [l7, #2]
l10: $ G ⇒ fv (ccom (etf u E) (scons A (scons B ∅))) ∅ = fv (etf u E) A ∧ fv (ccom (etf u E) (scons A (scons B ∅))) (suc ∅) = fv (etf u E) B $ by c3_cc2 [l5, l8, l9]
l11: $ G ⇒ fv (ccom (etf u E) (scons A (scons B ∅))) ∅ = fv (etf u E) A $ by and_elim_l [l10]
l12: $ G ⇒ fv (ccom (etf u E) (scons A (scons B ∅))) (suc ∅) = fv (etf u E) B $ by and_elim_r [l10]
l13: $ G ⇒ isset A $ by wcel_isset [#1]
l14: $ G ⇒ isset B $ by wcel_isset [#2]
l15: $ G ⇒ isset (scons B ∅) $ by wcel_isset [l3]
l16: $ G ⇒ isset ∅ $ by ax_empty
l17: $ G ⇒ fv (scons A (scons B ∅)) ∅ = A $ by scons_fv_zero_c [l13, l15]
l18a: $ G ⇒ isset ∅ $ by ax_empty
l18b: $ G ⇒ fv (scons A (scons B ∅)) (suc ∅) = fv (scons B ∅) ∅ $ by scons_fv_suc_c [l13, l15, l16]
l18c: $ G ⇒ fv (scons B ∅) ∅ = B $ by scons_fv_zero_c [l14, l16]
l18: $ G ⇒ fv (scons A (scons B ∅)) (suc ∅) = B $ by eq_trans [l18b, l18c]
n1: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ k ∊ ω $ by ax
n2: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ h ∊ fseq (trees ω) $ by ax
n3: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ c = ccom (etf u E) h $ by ax
n4: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ fv (etf u E) ⟨ k , h ⟩ = etb u E k h c $ by etf_node [n1, n2, n3]
n5: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ h = scons A (scons B ∅) $ by ax
n6: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ (etf u E) = (etf u E) $ by eq_refl
n7: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ ccom (etf u E) h = ccom (etf u E) (scons A (scons B ∅)) $ by ccom_eq [n6, n5]
n8: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ c = ccom (etf u E) (scons A (scons B ∅)) $ by eq_trans [n3, n7]
n9: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ ∅ = ∅ $ by eq_refl
n10: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ suc ∅ = suc ∅ $ by eq_refl
n11: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ fv c ∅ = fv (ccom (etf u E) (scons A (scons B ∅))) ∅ $ by fv_eq [n8, n9]
n12: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ fv c (suc ∅) = fv (ccom (etf u E) (scons A (scons B ∅))) (suc ∅) $ by fv_eq [n8, n10]
n13: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ fv h ∅ = fv (scons A (scons B ∅)) ∅ $ by fv_eq [n5, n9]
n14: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ fv h (suc ∅) = fv (scons A (scons B ∅)) (suc ∅) $ by fv_eq [n5, n10]
w0: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ w ∊ lvals $ by weaken [#3]
r0: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ r ∊ fseq u $ by weaken [#4]
w1: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ w = w $ by eq_refl
r1: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ r = r $ by eq_refl
e0: $ G , k = kc_pi , k ∊ ω , h = scons A (scons B ∅) , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ E = E $ by eq_refl
