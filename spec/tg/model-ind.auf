lemma c4_nty_tsub_one {x i: set} (G: hyps) (t j f c: set): $ G ⇒ ra_nth_ty t j f c ∈ lrel $ > $ G ⇒ ∀ x ∀ i (ra_nth_ty x i f c ∈ lrel → suc (fv nvf i) = fv nvf j → f ∈ fv tsub x ∧ c ∈ fv tsub x) $ > $ G ⇒ f ∈ fv tsub t ∧ c ∈ fv tsub t $
