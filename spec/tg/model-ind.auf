m14: $ G , k = cdm s ⇒ c2_nv s Y k = c2_nv s Y (cdm s) $ by c2_nv_eqn [m1]
m15: $ G , k = cdm s ⇒ c2_nv (ssnoc s a) Y k = c2_nv s Y (cdm s) $ by eq_trans [m13, m14]
m16: $ G , k = cdm s ⇒ ⟨ fv (ssnoc s a) k , c2_nv (ssnoc s a) Y k ⟩ = ⟨ a , c2_nv s Y (cdm s) ⟩ $ by opair_eq [m12, m15]
m17: $ G , k = cdm s ⇒ c2_nv (ssnoc s a) Y (cdm (ssnoc s a)) = ⟨ fv (ssnoc s a) k , c2_nv (ssnoc s a) Y k ⟩ $ by eq_trans [m8, m9]
