d4: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ scat e t = scons x (scat y t) $ by eq_trans [d3b, d3]
d5a: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ scat y t ∈ fseq A $ by scat_fseq [d2a, d2b]
