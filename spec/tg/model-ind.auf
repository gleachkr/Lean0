lemma i0_ucc0 (G: hyps): $ G ⇒ ⋃ (crn (csn ∅)) = ∅ $
----
k4: $ G , y ∊ crn (csn ∅) , a ∊ y ⇒ y ∊ crn (csn ∅) $ by ax
