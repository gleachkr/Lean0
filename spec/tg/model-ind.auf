k7: $ G , y ∊ crn (csn ∅) , a ∊ y , ⟨ x , y ⟩ ∈ csn ∅ , o = ⟨ x , y ⟩ , o ∊ csn ∅ ⇒ o = ∅ $ by csn_elim [k6]
k8: $ G , y ∊ crn (csn ∅) , a ∊ y , ⟨ x , y ⟩ ∈ csn ∅ , o = ⟨ x , y ⟩ , o ∊ csn ∅ ⇒ o = ⟨ x , y ⟩ $ by ax
k9: $ G , y ∊ crn (csn ∅) , a ∊ y , ⟨ x , y ⟩ ∈ csn ∅ , o = ⟨ x , y ⟩ , o ∊ csn ∅ ⇒ ⟨ x , y ⟩ = o $ by eq_sym [k8]
k10: $ G , y ∊ crn (csn ∅) , a ∊ y , ⟨ x , y ⟩ ∈ csn ∅ , o = ⟨ x , y ⟩ , o ∊ csn ∅ ⇒ ⟨ x , y ⟩ = ∅ $ by eq_trans [k9, k7]
k11: $ G , y ∊ crn (csn ∅) , a ∊ y , ⟨ x , y ⟩ ∈ csn ∅ , o = ⟨ x , y ⟩ , o ∊ csn ∅ ⇒ ⊥ $ by opair_ne_empty [k10]
k12: $ G , y ∊ crn (csn ∅) , a ∊ y , ⟨ x , y ⟩ ∈ csn ∅ ⇒ ⟨ x , y ⟩ ∈ csn ∅ $ by ax
k13: $ G , y ∊ crn (csn ∅) , a ∊ y , ⟨ x , y ⟩ ∈ csn ∅ ⇒ ⊥ $ by wcel_elim [k12, k11]
k14: $ G , y ∊ crn (csn ∅) , a ∊ y ⇒ ⊥ $ by ex_elim [k5, k13]
k1: $ G , a ∊ ⋃ (crn (csn ∅)) ⇒ a ∊ ⋃ (crn (csn ∅)) $ by ax
k2: $ G , a ∊ ⋃ (crn (csn ∅)) ⇒ ⊥ $ by cuni_elim [k1, k14]
k3: $ G ⇒ ⋃ (crn (csn ∅)) = ∅ $ by empty_eq_intro [k2]

lemma i0_nv_bad (G: hyps) (S Y: class) (n: set): $ G ⇒ ¬ n ∊ ω $ > $ G ⇒ c2_nv S Y n = ∅ $
----
l1: $ G , n ∊ cdm (omrec ⟨ ∅ , Y ⟩ (nstep S)) ⇒ n ∊ cdm (omrec ⟨ ∅ , Y ⟩ (nstep S)) $ by ax
l2: $ G , n ∊ cdm (omrec ⟨ ∅ , Y ⟩ (nstep S)) ⇒ n ∊ ω $ by omrec_cdm_elim [l1]
l3: $ G , n ∊ cdm (omrec ⟨ ∅ , Y ⟩ (nstep S)) ⇒ ¬ n ∊ ω $ by weaken [#1]
l4: $ G , n ∊ cdm (omrec ⟨ ∅ , Y ⟩ (nstep S)) ⇒ ⊥ $ by not_elim [l3, l2]
l5: $ G ⇒ n ∊ cdm (omrec ⟨ ∅ , Y ⟩ (nstep S)) → ⊥ $ by imp_intro [l4]
l6: $ G ⇒ fv (omrec ⟨ ∅ , Y ⟩ (nstep S)) n = ∅ $ by fv_empty [l5]
l7: $ G ⇒ csn (fv (omrec ⟨ ∅ , Y ⟩ (nstep S)) n) = csn ∅ $ by csn_eq [l6]
l8: $ G ⇒ crn (csn (fv (omrec ⟨ ∅ , Y ⟩ (nstep S)) n)) = crn (csn ∅) $ by crn_eq [l7]
l9: $ G ⇒ ⋃ (crn (csn (fv (omrec ⟨ ∅ , Y ⟩ (nstep S)) n))) = ⋃ (crn (csn ∅)) $ by cuni_eq [l8]
l10: $ G ⇒ ⋃ (crn (csn ∅)) = ∅ $ by i0_ucc0
l11: $ G ⇒ c2_nv S Y n = ∅ $ by eq_trans [l9, l10]

lemma i0_R_elim {o b: set} (G: hyps o b) (S: class) (x y: set): $ G ⇒ ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ > $ G ⇒ x = nest S y $
----
a1: $ G , q = ⟨ x , y ⟩ , q ∊ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ q ∊ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by ax
a2: $ G , q = ⟨ x , y ⟩ , q ∊ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ ∃ b (q = ⟨ nest S b , b ⟩) $ by cab_elim [a1]
a2a: $ ∃ b (q = ⟨ nest S b , b ⟩) ⟺ ∃ c [b/c] (q = ⟨ nest S b , b ⟩) $ by ex_alpha
a2b: $ G , q = ⟨ x , y ⟩ , q ∊ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ ∃ b (q = ⟨ nest S b , b ⟩) ↔ ∃ c (q = ⟨ nest S c , c ⟩) $ by weaken [a2a]
a2c: $ G , q = ⟨ x , y ⟩ , q ∊ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ ∃ c (q = ⟨ nest S c , c ⟩) $ by bi_elim_l [a2b, a2]
a3: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ q = ⟨ x , y ⟩ $ by ax
a4: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ ⟨ x , y ⟩ = q $ by eq_sym [a3]
a5: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ q = ⟨ nest S c , c ⟩ $ by ax
a6: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ ⟨ x , y ⟩ = ⟨ nest S c , c ⟩ $ by eq_trans [a4, a5]
a7: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ isset x $ by isset_var
a8: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ isset y $ by isset_var
a9: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ isset (nest S c) $ by nest_set
a10: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ isset c $ by isset_var
a11: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ x = nest S c ∧ y = c $ by opair_inj_c [a6, a7, a8, a9, a10]
a12: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ x = nest S c $ by and_elim_l [a11]
a13: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ y = c $ by and_elim_r [a11]
a14: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ c = y $ by eq_sym [a13]
a15: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ S = S $ by eq_refl
a16: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ nest S c = nest S y $ by nest_eq [a15, a14]
a17: $ G , q = ⟨ x , y ⟩ , q = ⟨ nest S c , c ⟩ ⇒ x = nest S y $ by eq_trans [a12, a16]
a18: $ G , q = ⟨ x , y ⟩ , q ∊ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ x = nest S y $ by ex_elim [a2c, a17]
a19: $ G ⇒ x = nest S y $ by wcel_elim [#1, a18]

lemma i0_R_intro {o b: set} (G: hyps) (S: class) (y: set): $ G ⇒ ⟨ nest S y , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $
----
a1: $ G , q = ⟨ nest S y , y ⟩ ⇒ q = ⟨ nest S y , y ⟩ $ by ax
a2: $ G , q = ⟨ nest S y , y ⟩ ⇒ ∃ b (q = ⟨ nest S b , b ⟩) $ by ex_intro [a1]
a3: $ G , q = ⟨ nest S y , y ⟩ ⇒ q ∊ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by cab_intro [a2]
a4: $ G , q = ⟨ nest S y , y ⟩ ⇒ ⟨ nest S y , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by wcel_intro [a1, a3]
a5: $ G ⇒ isset ⟨ nest S y , y ⟩ $ by opair_isset
a6: $ G ⇒ ⟨ nest S y , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by isset_elim [a5, a4]

apn_set
-------
c1: $ G , n = cdm S , n ∊ ω ⇒ isset S $ by weaken [#2]
c2: $ G , n = cdm S , n ∊ ω ⇒ n ∊ ω $ by ax
c3: $ G , n = cdm S , n ∊ ω ⇒ ∀ v ∀ w (c2_nv S v n = c2_nv S w n → v = w) $ by i0_nv_inj [c1, c2]
f1: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by ax
f2: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ x = nest S y $ by i0_R_elim [f1]
f3: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by ax
f4: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ x = nest S z $ by i0_R_elim [f3]
f5: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ nest S y = x $ by eq_sym [f2]
f6: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ nest S y = nest S z $ by eq_trans [f5, f4]
f7: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ c2_nv S y (cdm S) = c2_nv S z (cdm S) $ by weaken [f6]
f8: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ n = cdm S $ by ax
f9: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ cdm S = n $ by eq_sym [f8]
f10: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ c2_nv S y (cdm S) = c2_nv S y n $ by c2_nv_eqn [f9]
f11: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ c2_nv S z (cdm S) = c2_nv S z n $ by c2_nv_eqn [f9]
f12: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ c2_nv S y n = c2_nv S y (cdm S) $ by eq_sym [f10]
f13: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ c2_nv S y n = c2_nv S z (cdm S) $ by eq_trans [f12, f7]
f14: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ c2_nv S y n = c2_nv S z n $ by eq_trans [f13, f11]
f15: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ ∀ v ∀ w (c2_nv S v n = c2_nv S w n → v = w) $ by weaken [c3]
f16: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ ∀ w (c2_nv S y n = c2_nv S w n → y = w) $ by all_elim [f15]
f17: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ c2_nv S y n = c2_nv S z n → y = z $ by all_elim [f16]
f18: $ G , n = cdm S , n ∊ ω , ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} , ⟨ x , z ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} ⇒ y = z $ by imp_elim [f17, f14]
f19: $ G , n = cdm S , n ∊ ω ⇒ functional {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by functional_intro [f18]
f20: $ G , n = cdm S , n ∊ ω ⇒ isset F $ by weaken [#1]
f21: $ G , n = cdm S , n ∊ ω ⇒ isset (img {o | ∃ b (o = ⟨ nest S b , b ⟩)} F) $ by img_set [f19, f20]
g1: $ G , n = cdm S , n ∊ ω , y ∊ apn F S ⇒ y ∊ apn F S $ by ax
g2: $ G , n = cdm S , n ∊ ω , y ∊ apn F S ⇒ nest S y ∈ F $ by cab_elim [g1]
g3: $ G , n = cdm S , n ∊ ω , y ∊ apn F S , x = nest S y , x ∊ F ⇒ x ∊ F $ by ax
g4: $ G , n = cdm S , n ∊ ω , y ∊ apn F S , x = nest S y , x ∊ F ⇒ ⟨ nest S y , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by i0_R_intro
g5: $ G , n = cdm S , n ∊ ω , y ∊ apn F S , x = nest S y , x ∊ F ⇒ x = nest S y $ by ax
g6: $ G , n = cdm S , n ∊ ω , y ∊ apn F S , x = nest S y , x ∊ F ⇒ nest S y = x $ by eq_sym [g5]
g7: $ G , n = cdm S , n ∊ ω , y ∊ apn F S , x = nest S y , x ∊ F ⇒ y = y $ by eq_refl
g8: $ G , n = cdm S , n ∊ ω , y ∊ apn F S , x = nest S y , x ∊ F ⇒ ⟨ nest S y , y ⟩ = ⟨ x , y ⟩ $ by opair_eq [g6, g7]
g9: $ G , n = cdm S , n ∊ ω , y ∊ apn F S , x = nest S y , x ∊ F ⇒ ⟨ x , y ⟩ ∈ {o | ∃ b (o = ⟨ nest S b , b ⟩)} $ by wcel_eq_l [g8, g4]
g10: $ G , n = cdm S , n ∊ ω , y ∊ apn F S , x = nest S y , x ∊ F ⇒ y ∊ img {o | ∃ b (o = ⟨ nest S b , b ⟩)} F $ by img_intro [g3, g9]
g11: $ G , n = cdm S , n ∊ ω , y ∊ apn F S ⇒ y ∊ img {o | ∃ b (o = ⟨ nest S b , b ⟩)} F $ by wcel_elim [g2, g10]
g12: $ G , n = cdm S , n ∊ ω ⇒ apn F S ⊆ img {o | ∃ b (o = ⟨ nest S b , b ⟩)} F $ by subset_intro [g11]
g13: $ G , n = cdm S , n ∊ ω ⇒ isset (apn F S) $ by subset_isset [f21, g12]
h1: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ y ∊ apn F S $ by ax
h2: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ nest S y ∈ F $ by cab_elim [h1]
h3: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ c2_nv S y (cdm S) ∈ F $ by weaken [h2]
h4: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ n = cdm S $ by ax
h5: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ cdm S = n $ by eq_sym [h4]
h6: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ c2_nv S y (cdm S) = c2_nv S y n $ by c2_nv_eqn [h5]
h7: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ ¬ n ∊ ω $ by ax
h8: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ c2_nv S y n = ∅ $ by i0_nv_bad [h7]
h9: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ c2_nv S y (cdm S) = ∅ $ by eq_trans [h6, h8]
h10: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ ∅ ∈ F $ by wcel_eq_l [h9, h3]
h11: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ ¬ ∅ ∈ F $ by weaken [#3]
h12: $ G , n = cdm S , ¬ n ∊ ω , y ∊ apn F S ⇒ ⊥ $ by not_elim [h11, h10]
h13: $ G , n = cdm S , ¬ n ∊ ω ⇒ apn F S = ∅ $ by empty_eq_intro [h12]
h14: $ G , n = cdm S , ¬ n ∊ ω ⇒ apn F S ⊆ ∅ $ by eq_subset [h13]
h15: $ G , n = cdm S , ¬ n ∊ ω ⇒ isset ∅ $ by ax_empty
h16: $ G , n = cdm S , ¬ n ∊ ω ⇒ isset (apn F S) $ by subset_isset [h15, h14]
m1: $ G , n = cdm S ⇒ n ∊ ω ∨ ¬ n ∊ ω $ by excluded_middle
m2: $ G , n = cdm S ⇒ isset (apn F S) $ by or_elim [m1, g13, h16]
m3: $ G ⇒ isset (cdm S) $ by cdm_set [#2]
m4: $ G ⇒ isset (apn F S) $ by isset_elim [m3, m2]

nest_one
--------
l0: $ G ⇒ isset ∅ $ by ax_empty
m1: $ G , a = A , e = ∅ ⇒ e = ∅ $ by ax
m1b: $ G , a = A , e = ∅ ⇒ a = A $ by ax
m2: $ G , a = A , e = ∅ ⇒ ∅ ∈ fseq ω $ by fseq_empty
m2b: $ G , a = A , e = ∅ ⇒ ∅ = e $ by eq_sym [m1]
m3: $ G , a = A , e = ∅ ⇒ e ∈ fseq ω $ by wcel_eq_l [m2b, m2]
m3b: $ G , a = A , e = ∅ ⇒ e ∊ fseq ω $ by wcel_welc [m3]
m3c: $ G , a = A , e = ∅ ⇒ isset Y $ by weaken [#2]
m4: $ G , a = A , e = ∅ ⇒ nest (scons a e) Y = nest e ⟨ a , Y ⟩ $ by nest_scons [m3b, m3c]
m5r: $ G , a = A , e = ∅ ⇒ ⟨ a , Y ⟩ = ⟨ a , Y ⟩ $ by eq_refl
m5: $ G , a = A , e = ∅ ⇒ nest e ⟨ a , Y ⟩ = nest ∅ ⟨ a , Y ⟩ $ by nest_eq [m1, m5r]
m6i: $ G , a = A , e = ∅ ⇒ isset ⟨ a , Y ⟩ $ by opair_isset
m6: $ G , a = A , e = ∅ ⇒ nest ∅ ⟨ a , Y ⟩ = ⟨ a , Y ⟩ $ by nest_empty [m6i]
m7a: $ G , a = A , e = ∅ ⇒ A = a $ by eq_sym [m1b]
m7: $ G , a = A , e = ∅ ⇒ scons A ∅ = scons a e $ by scons_eq [m7a, m2b]
m8r: $ G , a = A , e = ∅ ⇒ Y = Y $ by eq_refl
m8: $ G , a = A , e = ∅ ⇒ nest (scons A ∅) Y = nest (scons a e) Y $ by nest_eq [m7, m8r]
m9: $ G , a = A , e = ∅ ⇒ ⟨ a , Y ⟩ = ⟨ A , Y ⟩ $ by opair_eq [m1b, m8r]
n1: $ G , a = A , e = ∅ ⇒ nest (scons A ∅) Y = nest e ⟨ a , Y ⟩ $ by eq_trans [m8, m4]
n2: $ G , a = A , e = ∅ ⇒ nest (scons A ∅) Y = nest ∅ ⟨ a , Y ⟩ $ by eq_trans [n1, m5]
n3: $ G , a = A , e = ∅ ⇒ nest (scons A ∅) Y = ⟨ a , Y ⟩ $ by eq_trans [n2, m6]
n4: $ G , a = A , e = ∅ ⇒ nest (scons A ∅) Y = ⟨ A , Y ⟩ $ by eq_trans [n3, m9]
n5: $ G , a = A ⇒ nest (scons A ∅) Y = ⟨ A , Y ⟩ $ by isset_elim [l0, n4]
n6: $ G ⇒ nest (scons A ∅) Y = ⟨ A , Y ⟩ $ by isset_elim [#1, n5]

nest_two
--------
l0a: $ G ⇒ isset ∅ $ by ax_empty
l0: $ G ⇒ isset (scons B ∅) $ by scons_set [l0a]
m1: $ G , a = A , q = scons B ∅ ⇒ a = A $ by ax
m2: $ G , a = A , q = scons B ∅ ⇒ q = scons B ∅ $ by ax
m3i: $ G , a = A , q = scons B ∅ ⇒ isset B $ by weaken [#2]
m3a: $ G , a = A , q = scons B ∅ ⇒ B ∈ cpr B B $ by cpr_intro_l_c [m3i]
m3b: $ G , a = A , q = scons B ∅ ⇒ ∅ ∈ fseq (cpr B B) $ by fseq_empty
m3c: $ G , a = A , q = scons B ∅ ⇒ scons B ∅ ∈ fseq (cpr B B) $ by scons_fseq_c [m3a, m3b]
m3d: $ G , a = A , q = scons B ∅ ⇒ scons B ∅ = q $ by eq_sym [m2]
