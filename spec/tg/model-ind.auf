lemma c3_esb_nil_eq {g: set} (G: hyps) (U M K S V: class): $ G ⇒ K = kc_nil $ > $ G ⇒ esb U M K S V = clam g lvals (csn ∅) $
----
a1: $ G , z ∊ esb U M K S V ⇒ z ∊ esb U M K S V $ by ax
a2: $ G , z ∊ esb U M K S V ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) $ by cab_elim [a1]
a3: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) $ by ax
a4: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ z ∊ clam g lvals (csn ∅) $ by and_elim_r [a3]
a5: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) $ by ax
a6: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ K = kc_cons $ by and_elim_l [a5]
a7: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ K = kc_nil $ by weaken [#1]
a8: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ kc_nil = K $ by eq_sym [a7]
a9: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ kc_nil = kc_cons $ by eq_trans [a8, a6]
a9b: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
a10: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ ⊥ $ by not_elim [a9b, a9]
a11: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ z ∊ clam g lvals (csn ∅) $ by bot_elim [a10]
a12: $ G , z ∊ esb U M K S V ⇒ z ∊ clam g lvals (csn ∅) $ by or_elim [a2, a4, a11]
b1: $ G , z ∊ clam g lvals (csn ∅) ⇒ K = kc_nil $ by weaken [#1]
b2: $ G , z ∊ clam g lvals (csn ∅) ⇒ z ∊ clam g lvals (csn ∅) $ by ax
b3: $ G , z ∊ clam g lvals (csn ∅) ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) $ by and_intro [b1, b2]
b4: $ G , z ∊ clam g lvals (csn ∅) ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) $ by or_intro_l [b3]
b5: $ G , z ∊ clam g lvals (csn ∅) ⇒ z ∊ esb U M K S V $ by cab_intro [b4]
b6: $ G ⇒ esb U M K S V = clam g lvals (csn ∅) $ by eq_intro [a12, b5]

lemma c3_esb_cons_eq {g r x q: set} (G: hyps) (U M K S V: class): $ G ⇒ K = kc_cons $ > $ G ⇒ esb U M K S V = clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } $
----
a1: $ G , z ∊ esb U M K S V ⇒ z ∊ esb U M K S V $ by ax
a2: $ G , z ∊ esb U M K S V ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) $ by cab_elim [a1]
a3: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) $ by ax
a4: $ G , z ∊ esb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } $ by and_elim_r [a3]
a5: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) $ by ax
a6: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ K = kc_nil $ by and_elim_l [a5]
a7: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ K = kc_cons $ by weaken [#1]
a8: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ kc_nil = K $ by eq_sym [a6]
a9: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ kc_nil = kc_cons $ by eq_trans [a8, a7]
a9b: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
a10: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ ⊥ $ by not_elim [a9b, a9]
a11: $ G , z ∊ esb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } $ by bot_elim [a10]
a12: $ G , z ∊ esb U M K S V ⇒ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } $ by or_elim [a2, a11, a4]
b1: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } ⇒ K = kc_cons $ by weaken [#1]
b2: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } ⇒ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } $ by ax
b3: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } ⇒ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) $ by and_intro [b1, b2]
b4: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) $ by or_intro_r [b3]
b5: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } ⇒ z ∊ esb U M K S V $ by cab_intro [b4]
b6: $ G ⇒ esb U M K S V = clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) } $ by eq_intro [a12, b5]

esat_nil
-------
a1: $ G ⇒ kc_nil ∈ ω $ by kc_nil_omega
a2: $ G ⇒ isset kc_nil $ by wcel_isset [a1]
a3: $ G , k = kc_nil ⇒ isset ∅ $ by ax_empty
b1: $ G , k = kc_nil , e = ∅ ⇒ k = kc_nil $ by ax
b2: $ G , k = kc_nil , e = ∅ ⇒ e = ∅ $ by ax
b3: $ G , k = kc_nil , e = ∅ ⇒ kc_nil = k $ by eq_sym [b1]
b4: $ G , k = kc_nil , e = ∅ ⇒ ∅ = e $ by eq_sym [b2]
b5: $ G , k = kc_nil , e = ∅ ⇒ kc_nil ∈ ω $ by weaken [a1]
b6: $ G , k = kc_nil , e = ∅ ⇒ k ∈ ω $ by wcel_eq_l [b3, b5]
b7: $ G , k = kc_nil , e = ∅ ⇒ k ∊ ω $ by wcel_welc [b6]
b8: $ G , k = kc_nil , e = ∅ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
b9: $ G , k = kc_nil , e = ∅ ⇒ e ∈ fseq (trees ω) $ by wcel_eq_l [b4, b8]
b10: $ G , k = kc_nil , e = ∅ ⇒ e ∊ fseq (trees ω) $ by wcel_welc [b9]
c1: $ G , k = kc_nil , e = ∅ ⇒ fv (esf u E) ⟨ k , e ⟩ = esb u E k e (ccom (esf u E) e) $ by esf_node [b7, b10]
c2: $ G , k = kc_nil , e = ∅ ⇒ esb u E k e (ccom (esf u E) e) = clam g lvals (csn ∅) $ by c3_esb_nil_eq [b1]
c3: $ G , k = kc_nil , e = ∅ ⇒ esf u E = esf u E $ by eq_refl
c4: $ G , k = kc_nil , e = ∅ ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ k , e ⟩ $ by opair_eq [b3, b4]
c5: $ G , k = kc_nil , e = ∅ ⇒ fv (esf u E) ⟨ kc_nil , ∅ ⟩ = fv (esf u E) ⟨ k , e ⟩ $ by fv_eq [c3, c4]
c6: $ G , k = kc_nil , e = ∅ ⇒ fv (esf u E) ⟨ kc_nil , ∅ ⟩ = esb u E k e (ccom (esf u E) e) $ by eq_trans [c5, c1]
c7: $ G , k = kc_nil , e = ∅ ⇒ fv (esf u E) ⟨ kc_nil , ∅ ⟩ = clam g lvals (csn ∅) $ by eq_trans [c6, c2]
c8: $ G , k = kc_nil , e = ∅ ⇒ w = w $ by eq_refl
c9: $ G , k = kc_nil , e = ∅ ⇒ ap (fv (esf u E) ⟨ kc_nil , ∅ ⟩) w = ap (clam g lvals (csn ∅)) w $ by ap_eq [c7, c8]
c10: $ G , k = kc_nil , e = ∅ ⇒ w ∊ lvals $ by weaken [#1]
c11: $ G , k = kc_nil , e = ∅ ⇒ ap (clam g lvals (csn ∅)) w = csn ∅ $ by clam_ap [c10]
c12: $ G , k = kc_nil , e = ∅ ⇒ esat u E ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by eq_trans [c9, c11]
d1: $ G , k = kc_nil ⇒ esat u E ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by isset_elim [a3, c12]
d2: $ G ⇒ esat u E ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by isset_elim [a2, d1]

esat_cons
--------
h1: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ c = ∅ $ by ax
h2: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ ∅ = c $ by eq_sym [h1]
h3: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
h4: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ c ∈ fseq (trees ω) $ by wcel_eq_l [h2, h3]
h5: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ c ∊ fseq (trees ω) $ by wcel_welc [h4]
h6: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ b ∊ trees ω $ by ax
h7: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ scons b c ∈ fseq (trees ω) $ by scons_fseq [h6, h5]
h8: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ isset (scons b c) $ by wcel_isset [h7]
h9: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ a ∊ trees ω $ by ax
h10: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ k = kc_cons $ by ax
h11: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ kc_cons = k $ by eq_sym [h10]
h12: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ kc_cons ∈ ω $ by kc_cons_omega
h13: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ k ∈ ω $ by wcel_eq_l [h11, h12]
h14: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ k ∊ ω $ by wcel_welc [h13]
h15a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ cdm c = cdm ∅ $ by cdm_eq [h1]
h15b: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ cdm ∅ = ∅ $ by cdm_empty
h15c: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ cdm c = ∅ $ by eq_trans [h15a, h15b]
h15: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ cdm c = c $ by eq_trans [h15c, h2]
h16a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ isset c $ by isset_var
h16: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ isset (suc c) $ by suc_set [h16a]
h17: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ a = A $ by ax
h18: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ b = T $ by ax
j1: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ d = scons b c $ by ax
j2: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ scons b c = d $ by eq_sym [j1]
j2a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ scons b c ∈ fseq (trees ω) $ by weaken [h7]
j2b: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ d ∈ fseq (trees ω) $ by wcel_eq_l [j2, j2a]
j3: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ d ∊ fseq (trees ω) $ by wcel_welc [j2b]
j3a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ a ∊ trees ω $ by weaken [h9]
j4: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ scons a d ∈ fseq (trees ω) $ by scons_fseq [j3a, j3]
j5: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ isset (scons a d) $ by wcel_isset [j4]
j5a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ c ∊ fseq (trees ω) $ by weaken [h5]
j6: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ cdm (scons b c) = suc (cdm c) $ by scons_len [j5a]
j7: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ cdm d = cdm (scons b c) $ by cdm_eq [j1]
j8: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ cdm d = suc (cdm c) $ by eq_trans [j7, j6]
j9a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ cdm c = c $ by weaken [h15]
j9: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ suc (cdm c) = suc c $ by suc_eq [j9a]
j10: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ cdm d = suc c $ by eq_trans [j8, j9]
j11: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ isset (suc c) $ by weaken [h16]
l1: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c ⇒ isset (scons a d) $ by weaken [j5]
k1: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ e = scons a d $ by ax
k2: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ scons a d = e $ by eq_sym [k1]
k2a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ scons a d ∈ fseq (trees ω) $ by weaken [j4]
k2b: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ e ∈ fseq (trees ω) $ by wcel_eq_l [k2, k2a]
k3: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ e ∊ fseq (trees ω) $ by wcel_welc [k2b]
k3a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ k ∊ ω $ by weaken [h14]
k4: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ fv (esf u E) ⟨ k , e ⟩ = esb u E k e (ccom (esf u E) e) $ by esf_node [k3a, k3]
k4a: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ k = kc_cons $ by weaken [h10]
