qq3: $ G , q = ⟨ kc_ccons , scons x0 (scons e ∅) ⟩ ∧ l = ⟨ kc_s , scons x1 ∅ ⟩ ∧ g = r ∧ ra_nth_ctor e x1 r ∈ lrel ⇒ ra_nth_ctor e x1 r ∈ lrel $ by and_elim_r [qqr1]
r0: $ G , q = ⟨ kc_ccons , scons x0 (scons e ∅) ⟩ ∧ l = ⟨ kc_s , scons x1 ∅ ⟩ ∧ g = r ∧ ra_nth_ctor e x1 r ∈ lrel ⇒ q = ⟨ kc_ccons , scons u (scons b ∅) ⟩ $ by weaken [#1]
r1: $ G , q = ⟨ kc_ccons , scons x0 (scons e ∅) ⟩ ∧ l = ⟨ kc_s , scons x1 ∅ ⟩ ∧ g = r ∧ ra_nth_ctor e x1 r ∈ lrel ⇒ ⟨ kc_ccons , scons u (scons b ∅) ⟩ = q $ by eq_sym [r0]
r2: $ G , q = ⟨ kc_ccons , scons x0 (scons e ∅) ⟩ ∧ l = ⟨ kc_s , scons x1 ∅ ⟩ ∧ g = r ∧ ra_nth_ctor e x1 r ∈ lrel ⇒ ⟨ kc_ccons , scons u (scons b ∅) ⟩ = ⟨ kc_ccons , scons x0 (scons e ∅) ⟩ $ by eq_trans [r1, qq0]
