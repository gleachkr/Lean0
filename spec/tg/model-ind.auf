k9: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ D = D2 $ by weaken [#1]
k10: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ p = p $ by eq_refl
k11: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ t = t $ by eq_refl
k12: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ iprt D2 p t $ by iprt_eq [k9, k10, k11, k1]
k13: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ J = J2 $ by weaken [#2]
k14: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ fv nvf n = J2 $ by eq_trans [k3, k13]
k15: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ C = C2 $ by weaken [#3]
k16: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ fv nvf m = C2 $ by eq_trans [k7, k15]
k17: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ K = K2 $ by weaken [#4]
k18: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ e = e $ by eq_refl
k19: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ m = m $ by eq_refl
k20: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ ra_nth_ctor e m K = ra_nth_ctor e m K2 $ by ra_nth_ctor_eq [k18, k19, k17]
k21: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ ra_nth_ctor e m K2 ∈ lrel $ by wcel_eq_l [k20, k8]
k22: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ ictk D2 J2 C2 K2 $ by ictk_intro [k12, k14, k5, k16, k21]
k23: $ G ⇒ ictk D2 J2 C2 K2 $ by ictk_elim [#5, k22]

iprop_eq
-------
k0: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ ityf D J f $ by ax
k1: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ ra_isort f k l ∈ lrel $ by ax
k2: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ lv l W = ∅ $ by ax
k3: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ D = D2 $ by weaken [#1]
k4: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ J = J2 $ by weaken [#2]
k5: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ f = f $ by eq_refl
k6: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ ityf D2 J2 f $ by ityf_eq [k3, k4, k5, k0]
k7: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ W = W2 $ by weaken [#3]
k8: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ W2 = W $ by eq_sym [k7]
k9: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ l = l $ by eq_refl
k10: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ lv l W2 = lv l W $ by lv_eq [k9, k8]
k11: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ lv l W2 = ∅ $ by eq_trans [k10, k2]
k12: $ G , ityf D J f , ra_isort f k l ∈ lrel , lv l W = ∅ ⇒ iprop D2 J2 W2 $ by iprop_intro [k6, k1, k11]
k13: $ G ⇒ iprop D2 J2 W2 $ by iprop_elim [#4, k12]

lemma t0_intys_sub (G: hyps) (D D2: class): $ G ⇒ D = D2 $ > $ G ⇒ intys D ⊆ intys D2 $
----
s0: $ G , v ∊ intys D ⇒ v ∊ intys D $ by ax
s1: $ G , v ∊ intys D ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by cab_elim [s0]
s2: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n $ by ax
s3: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ iprt D p t $ by and_elim_l [s2]
s4: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n $ by and_elim_r [s2]
s5: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ ra_ntys t n m ∈ lrel $ by and_elim_l [s4]
s6: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ v ∊ fv nvf n $ by and_elim_r [s4]
s7: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ D = D2 $ by weaken [#1]
s8: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ p = p $ by eq_refl
s9: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ t = t $ by eq_refl
s10: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ iprt D2 p t $ by iprt_eq [s7, s8, s9, s3]
s11: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n $ by and_intro [s5, s6]
s12: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n $ by and_intro [s10, s11]
s13: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ex_intro [s12]
s14: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ex_intro [s13]
s15: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ex_intro [s14]
s16: $ G , v ∊ intys D , iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ex_intro [s15]
s17: $ G , v ∊ intys D , ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) ⇒ ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ax
s18: $ G , v ∊ intys D , ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ex_elim [s17, s16]
s19: $ G , v ∊ intys D , ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) ⇒ ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ax
s20: $ G , v ∊ intys D , ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ex_elim [s19, s18]
s21: $ G , v ∊ intys D , ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) ⇒ ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ax
s22: $ G , v ∊ intys D , ∃ t ∃ n ∃ m (iprt D p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ex_elim [s21, s20]
s23: $ G , v ∊ intys D ⇒ ∃ p ∃ t ∃ n ∃ m (iprt D2 p t ∧ ra_ntys t n m ∈ lrel ∧ v ∊ fv nvf n) $ by ex_elim [s1, s22]
s24: $ G , v ∊ intys D ⇒ v ∊ intys D2 $ by cab_intro [s23]
s25: $ G ⇒ intys D ⊆ intys D2 $ by subset_intro [s24]

intys_eq
--------
l1: $ G ⇒ intys D ⊆ intys D2 $ by t0_intys_sub [#1]
l2: $ G ⇒ D2 = D $ by eq_sym [#1]
l3: $ G ⇒ intys D2 ⊆ intys D $ by t0_intys_sub [l2]
l4: $ G ⇒ intys D = intys D2 $ by subset_antisym [l1, l3]

ient_congr
----------
l1: $ (⟨ a , x ⟩) ≐ (⟨ a , x ⟩) $ by ceqt_refl
l2: $ (⟨ H , ⟨ a , x ⟩ ⟩) ≐ (⟨ I , ⟨ a , x ⟩ ⟩) $ by opair_congr [#4, l1]
l3: $ (⟨ H , ⟨ a , x ⟩ ⟩ ∈ E) ⟺ (⟨ I , ⟨ a , x ⟩ ⟩ ∈ F) $ by wcel_congr [l2, #3]
l4: $ (iprop A H C) ⟺ (iprop B I D) $ by iprop_congr [#1, #4, #2]
l5: $ (y = nest a ∅) ⟺ (y = nest a ∅) $ by iff_refl
l6: $ (iprop A H C ∧ y = nest a ∅) ⟺ (iprop B I D ∧ y = nest a ∅) $ by and_congr [l4, l5]
l7: $ (¬ iprop A H C) ⟺ (¬ iprop B I D) $ by not_congr [l4]
l8: $ (y = nest a x) ⟺ (y = nest a x) $ by iff_refl
l9: $ (¬ iprop A H C ∧ y = nest a x) ⟺ (¬ iprop B I D ∧ y = nest a x) $ by and_congr [l7, l8]
l10: $ ((iprop A H C ∧ y = nest a ∅) ∨ (¬ iprop A H C ∧ y = nest a x)) ⟺ ((iprop B I D ∧ y = nest a ∅) ∨ (¬ iprop B I D ∧ y = nest a x)) $ by or_congr [l6, l9]
l11: $ (⟨ H , ⟨ a , x ⟩ ⟩ ∈ E ∧ ((iprop A H C ∧ y = nest a ∅) ∨ (¬ iprop A H C ∧ y = nest a x))) ⟺ (⟨ I , ⟨ a , x ⟩ ⟩ ∈ F ∧ ((iprop B I D ∧ y = nest a ∅) ∨ (¬ iprop B I D ∧ y = nest a x))) $ by and_congr [l3, l10]
l12: $ (∃ x (⟨ H , ⟨ a , x ⟩ ⟩ ∈ E ∧ ((iprop A H C ∧ y = nest a ∅) ∨ (¬ iprop A H C ∧ y = nest a x)))) ⟺ (∃ x (⟨ I , ⟨ a , x ⟩ ⟩ ∈ F ∧ ((iprop B I D ∧ y = nest a ∅) ∨ (¬ iprop B I D ∧ y = nest a x)))) $ by ex_congr [l11]
l13: $ (∃ a ∃ x (⟨ H , ⟨ a , x ⟩ ⟩ ∈ E ∧ ((iprop A H C ∧ y = nest a ∅) ∨ (¬ iprop A H C ∧ y = nest a x)))) ⟺ (∃ a ∃ x (⟨ I , ⟨ a , x ⟩ ⟩ ∈ F ∧ ((iprop B I D ∧ y = nest a ∅) ∨ (¬ iprop B I D ∧ y = nest a x)))) $ by ex_congr [l12]
l14: $ ({y | ∃ a ∃ x (⟨ H , ⟨ a , x ⟩ ⟩ ∈ E ∧ ((iprop A H C ∧ y = nest a ∅) ∨ (¬ iprop A H C ∧ y = nest a x)))}) ≐ ({y | ∃ a ∃ x (⟨ I , ⟨ a , x ⟩ ⟩ ∈ F ∧ ((iprop B I D ∧ y = nest a ∅) ∨ (¬ iprop B I D ∧ y = nest a x)))}) $ by cab_congr [l13]

sb_c_ient
---------
l1: $ (⟦ x / t ⟧ ({y | ∃ a ∃ v (⟨ D , ⟨ a , v ⟩ ⟩ ∈ C ∧ ((iprop A D B ∧ y = nest a ∅) ∨ (¬ iprop A D B ∧ y = nest a v)))})) ≐ ({y | ∃ a ∃ v (⟨ (⟦ x / t ⟧ D) , ⟨ a , v ⟩ ⟩ ∈ (⟦ x / t ⟧ C) ∧ ((iprop (⟦ x / t ⟧ A) (⟦ x / t ⟧ D) (⟦ x / t ⟧ B) ∧ y = nest a ∅) ∨ (¬ iprop (⟦ x / t ⟧ A) (⟦ x / t ⟧ D) (⟦ x / t ⟧ B) ∧ y = nest a v)))}) $ by ceqt_refl

ixs_congr
---------
l1: $ (intys A) ≐ (intys B) $ by intys_congr [#1]
l2: $ seqt j j $ by seqt_refl
l3: $ (j ∊ intys A) ⟺ (j ∊ intys B) $ by welc_congr [l2, l1]
l4: $ (cv j) ≐ (cv j) $ by ceqt_refl
l5: $ (ient A C E j) ≐ (ient B D F j) $ by ient_congr [#1, #2, #3, l4]
l6: $ (⟨ j , ient A C E j ⟩) ≐ (⟨ j , ient B D F j ⟩) $ by opair_congr [l4, l5]
l7: $ (cv z) ≐ (cv z) $ by ceqt_refl
l8: $ (z = ⟨ j , ient A C E j ⟩) ⟺ (z = ⟨ j , ient B D F j ⟩) $ by ceq_congr [l7, l6]
l9: $ (j ∊ intys A ∧ z = ⟨ j , ient A C E j ⟩) ⟺ (j ∊ intys B ∧ z = ⟨ j , ient B D F j ⟩) $ by and_congr [l3, l8]
l10: $ (∃ j (j ∊ intys A ∧ z = ⟨ j , ient A C E j ⟩)) ⟺ (∃ j (j ∊ intys B ∧ z = ⟨ j , ient B D F j ⟩)) $ by ex_congr [l9]
l11: $ ({z | ∃ j (j ∊ intys A ∧ z = ⟨ j , ient A C E j ⟩)}) ≐ ({z | ∃ j (j ∊ intys B ∧ z = ⟨ j , ient B D F j ⟩)}) $ by cab_congr [l10]

sb_c_ixs
--------
l1: $ (⟦ x / t ⟧ ({z | ∃ j (j ∊ intys A ∧ z = ⟨ j , ient A B C j ⟩)})) ≐ ({z | ∃ j (j ∊ intys (⟦ x / t ⟧ A) ∧ z = ⟨ j , ient (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) j ⟩)}) $ by ceqt_refl

iop0_congr
----------
c1: $ (cv q) ≐ (cv q) $ by ceqt_refl
c2: $ (cv e) ≐ (cv e) $ by ceqt_refl
c3: $ (cv j) ≐ (cv j) $ by ceqt_refl
c4: $ (cv c) ≐ (cv c) $ by ceqt_refl
c5: $ (cv k) ≐ (cv k) $ by ceqt_refl
c6: $ (cv p) ≐ (cv p) $ by ceqt_refl
s1: $ seqt p p $ by seqt_refl
s2: $ seqt a a $ by seqt_refl
n1: $ (iprt E q e) ⟺ (iprt F q e) $ by iprt_congr [#3, c1, c2]
n2: $ (esat A C q H) ≐ (esat B D q I) $ by esat_congr [#1, #2, c1, #4]
n3: $ (p ∊ esat A C q H) ⟺ (p ∊ esat B D q I) $ by welc_congr [s1, n2]
n4: $ (ictk E j c k) ⟺ (ictk F j c k) $ by ictk_congr [#3, c3, c4, c5]
n5: $ (ixs E H J) ≐ (ixs F I K) $ by ixs_congr [#3, #4, #5]
n6: $ (scat p (ixs E H J)) ≐ (scat p (ixs F I K)) $ by scat_congr [c6, n5]
n7: $ (etel A C k H (scat p (ixs E H J))) ≐ (etel B D k I (scat p (ixs F I K))) $ by etel_congr [#1, #2, c5, #4, n6]
n8: $ (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩) ≐ (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩) $ by ceqt_refl
n9: $ (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k H (scat p (ixs E H J))) ⟺ (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k I (scat p (ixs F I K))) $ by wcel_congr [n8, n7]
n10: $ (fseq A) ≐ (fseq B) $ by fseq_congr [#1]
n11: $ (a ∊ fseq A) ⟺ (a ∊ fseq B) $ by welc_congr [s2, n10]
n12: $ (z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) ⟺ (z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) $ by iff_refl
n13: $ (a ∊ fseq A ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) ⟺ (a ∊ fseq B ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) $ by and_congr [n11, n12]
n14: $ (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k H (scat p (ixs E H J)) ∧ a ∊ fseq A ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) ⟺ (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k I (scat p (ixs F I K)) ∧ a ∊ fseq B ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) $ by and_congr [n9, n13]
n15: $ (ictk E j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k H (scat p (ixs E H J)) ∧ a ∊ fseq A ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) ⟺ (ictk F j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k I (scat p (ixs F I K)) ∧ a ∊ fseq B ∧ z = ⟨ j , ⟨ a , scons c g ⟩ ⟩) $ by and_congr [n4, n14]
