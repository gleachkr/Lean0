z1: $ G ⇒ isset r $ by isset_var
z3: $ G ⇒ g = g2 ∧ t = t2 ∧ a = a2 $ by c3_ed_use [n12, #2, #3, z1]

lemma c3_etb_eq2 (G: hyps) (E E2 K S V: class) (u: set):
  $ G ⇒ fv E (fv S ∅) = fv E2 (fv S ∅) $ > $ G ⇒ fv E (fv S (suc ∅)) = fv E2 (fv S (suc ∅)) $ >
  $ G ⇒ etb u E K S V = etb u E2 K S V $
----
e1: $ G , w ∊ lvals , r ∊ fseq u ⇒ fv E (fv S ∅) = fv E2 (fv S ∅) $ by weaken [#1]
e2: $ G , w ∊ lvals , r ∊ fseq u ⇒ fv E (fv S (suc ∅)) = fv E2 (fv S (suc ∅)) $ by weaken [#2]
e3: $ G , w ∊ lvals , r ∊ fseq u ⇒ w = w $ by eq_refl
e4: $ G , w ∊ lvals , r ∊ fseq u ⇒ r = r $ by eq_refl
e5: $ G , w ∊ lvals , r ∊ fseq u ⇒ da (fv E (fv S ∅)) w r = da (fv E2 (fv S ∅)) w r $ by da_eq [e1, e3, e4]
e5s: $ G , w ∊ lvals , r ∊ fseq u ⇒ da (fv E2 (fv S ∅)) w r = da (fv E (fv S ∅)) w r $ by eq_sym [e5]
e6: $ G , w ∊ lvals , r ∊ fseq u ⇒ da (fv E (fv S (suc ∅))) w r = da (fv E2 (fv S (suc ∅))) w r $ by da_eq [e2, e3, e4]
e6s: $ G , w ∊ lvals , r ∊ fseq u ⇒ da (fv E2 (fv S (suc ∅))) w r = da (fv E (fv S (suc ∅))) w r $ by eq_sym [e6]
e7: $ G , w ∊ lvals , r ∊ fseq u ⇒ fv V (suc ∅) = fv V (suc ∅) $ by eq_refl
e8: $ G , w ∊ lvals , r ∊ fseq u ⇒ da (fv V ∅) w r = da (fv V ∅) w r $ by eq_refl
e9: $ G , w ∊ lvals , r ∊ fseq u ⇒ fv V ∅ = fv V ∅ $ by eq_refl
f1: $ G , w ∊ lvals , r ∊ fseq u ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E2 (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)} $ by c3_x1g_sub [e5, e7, e8]
f2: $ G , w ∊ lvals , r ∊ fseq u ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E2 (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)} $ by c3_x1g_sub [e5s, e7, e8]
f3: $ G , w ∊ lvals , r ∊ fseq u ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)} = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E2 (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)} $ by subset_antisym [f1, f2]
f4: $ G , w ∊ lvals , r ∊ fseq u ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E2 (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $ by c3_x2g_sub [e9, e6]
f5: $ G , w ∊ lvals , r ∊ fseq u ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E2 (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $ by c3_x2g_sub [e9, e6s]
