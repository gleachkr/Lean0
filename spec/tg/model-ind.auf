g2: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ v = ⟨ x , m ⟩ $ by ax
g3a: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ scat y t = scat y t $ by eq_refl
g3: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ nest (scat y t) v = nest (scat y t) ⟨ x , m ⟩ $ by nest_eq [g3a, g2]
g4a: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ y = y $ by eq_refl
g4: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ nest y v = nest y ⟨ x , m ⟩ $ by nest_eq [g4a, g2]
g5a: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ t = t $ by eq_refl
g5: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ nest t (nest y v) = nest t (nest y ⟨ x , m ⟩) $ by nest_eq [g5a, g4]
g6: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ nest (scat y t) ⟨ x , m ⟩ = nest (scat y t) v $ by eq_sym [g3]
g7: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ nest (scat y t) ⟨ x , m ⟩ = nest t (nest y v) $ by eq_trans [g6, g1]
g8: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y , v = ⟨ x , m ⟩ ⇒ nest (scat y t) ⟨ x , m ⟩ = nest t (nest y ⟨ x , m ⟩) $ by eq_trans [g7, g5]
g9a: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ isset ⟨ x , m ⟩ $ by opair_isset
g9: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest (scat y t) ⟨ x , m ⟩ = nest t (nest y ⟨ x , m ⟩) $ by isset_elim [g9a, g8]
d8: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest e m = nest (scons x y) m $ by nest_eq [d1, d6a]
d9: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest (scons x y) m = nest y ⟨ x , m ⟩ $ by nest_scons [d2a, d5b]
d10: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest e m = nest y ⟨ x , m ⟩ $ by eq_trans [d8, d9]
d11: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest t (nest e m) = nest t (nest y ⟨ x , m ⟩) $ by nest_eq [d3a, d10]
d11b: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest t (nest y ⟨ x , m ⟩) = nest t (nest e m) $ by eq_sym [d11]
d12: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest (scat e t) m = nest (scat y t) ⟨ x , m ⟩ $ by eq_trans [d6, d5]
d13: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest (scat e t) m = nest t (nest y ⟨ x , m ⟩) $ by eq_trans [d12, g9]
d14: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ nest (scat e t) m = nest t (nest e m) $ by eq_trans [d13, d11b]
d15: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ ∀ m (nest (scat e t) m = nest t (nest e m)) $ by all_intro [d14]
d16: $ ∀ m (nest (scat e t) m = nest t (nest e m)) ⟺ ∀ w (nest (scat e t) w = nest t (nest e w)) $ by all_alpha
d17: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ ∀ m (nest (scat e t) m = nest t (nest e m)) ↔ ∀ w (nest (scat e t) w = nest t (nest e w)) $ by weaken [d16]
d18: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} , e = scons x y ⇒ ∀ w (nest (scat e t) w = nest t (nest e w)) $ by bi_elim_l [d17, d15]
d19b: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} ⇒ isset y $ by isset_var
d19a: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} ⇒ isset (scons x y) $ by scons_set [d19b]
d19: $ G , x ∊ A , y ∊ fseq A , y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} ⇒ scons x y ∈ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} $ by wcel_cab_intro [d19a, d18]
d20: $ G , x ∊ A , y ∊ fseq A ⇒ y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} → scons x y ∈ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} $ by imp_intro [d19]
d21: $ G , x ∊ A ⇒ y ∊ fseq A → y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} → scons x y ∈ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} $ by imp_intro [d20]
d22: $ G ⇒ x ∊ A → y ∊ fseq A → y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} → scons x y ∈ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} $ by imp_intro [d21]
d23: $ G ⇒ ∀ y (x ∊ A → y ∊ fseq A → y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} → scons x y ∈ {u | ∀ w (nest (scat u t) w = nest t (nest u w))}) $ by all_intro [d22]
d24: $ G ⇒ ∀ x ∀ y (x ∊ A → y ∊ fseq A → y ∊ {u | ∀ w (nest (scat u t) w = nest t (nest u w))} → scons x y ∈ {u | ∀ w (nest (scat u t) w = nest t (nest u w))}) $ by all_intro [d23]
