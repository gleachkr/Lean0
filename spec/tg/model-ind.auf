-- Proofs for model-ind.mm0.

tsb_congr
---------
l1: $ ⟨ A , C ⟩ ≐ ⟨ B , D ⟩ $ by opair_congr [#1, #2]
l2: $ csn ⟨ A , C ⟩ ≐ csn ⟨ B , D ⟩ $ by csn_congr [l1]
l3: $ crn E ≐ crn F $ by crn_congr [#3]
l4: $ ⋃ (crn E) ≐ ⋃ (crn F) $ by cuni_congr [l3]
l5: $ tsb A C E ≐ tsb B D F $ by cun_congr [l2, l4]

sb_c_tsb
--------
l1: $ (⟦ x / t ⟧ (csn ⟨ A , B ⟩ ∪ ⋃ (crn C))) ≐ csn ⟨ (⟦ x / t ⟧ A) , (⟦ x / t ⟧ B) ⟩ ∪ ⋃ (crn (⟦ x / t ⟧ C)) $ by ceqt_refl

psub_congr
----------
l0: $ tsub ≐ tsub $ by ceqt_refl
l1: $ ccom tsub A ≐ ccom tsub B $ by ccom_congr [l0, #1]
l2: $ crn (ccom tsub A) ≐ crn (ccom tsub B) $ by crn_congr [l1]
l3: $ psub A ≐ psub B $ by cuni_congr [l2]

sb_c_psub
---------
l1: $ (⟦ x / t ⟧ (⋃ (crn (ccom tsub A)))) ≐ ⋃ (crn (ccom tsub (⟦ x / t ⟧ A))) $ by ceqt_refl

cvv_congr
---------
g1: $ seqt i i $ by seqt_refl
g2: $ cdm A ≐ cdm B $ by cdm_congr [#1]
g3: $ (i ∊ cdm A) ⟺ (i ∊ cdm B) $ by welc_congr [g1, g2]
g4: $ cv i ≐ cv i $ by ceqt_refl
g5: $ fv C i ≐ fv D i $ by fv_congr [#2, g4]
g6: $ fv A i ≐ fv B i $ by fv_congr [#1, g4]
g7: $ fv (fv C i) (fv A i) ≐ fv (fv D i) (fv B i) $ by fv_congr [g5, g6]
g8: $ cv y ≐ cv y $ by ceqt_refl
g9: $ (y = fv (fv C i) (fv A i)) ⟺ (y = fv (fv D i) (fv B i)) $ by ceq_congr [g8, g7]
g10: $ (i ∊ cdm A ∧ y = fv (fv C i) (fv A i)) ⟺ (i ∊ cdm B ∧ y = fv (fv D i) (fv B i)) $ by and_congr [g3, g9]
g11: $ (z = ⟨ i , y ⟩) ⟺ (z = ⟨ i , y ⟩) $ by iff_refl
g12: $ (z = ⟨ i , y ⟩ ∧ i ∊ cdm A ∧ y = fv (fv C i) (fv A i)) ⟺ (z = ⟨ i , y ⟩ ∧ i ∊ cdm B ∧ y = fv (fv D i) (fv B i)) $ by and_congr [g11, g10]
g13: $ (∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm A ∧ y = fv (fv C i) (fv A i))) ⟺ (∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm B ∧ y = fv (fv D i) (fv B i))) $ by ex_congr [g12]
g14: $ (∃ i ∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm A ∧ y = fv (fv C i) (fv A i))) ⟺ (∃ i ∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm B ∧ y = fv (fv D i) (fv B i))) $ by ex_congr [g13]
g15: $ {z | ∃ i ∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm A ∧ y = fv (fv C i) (fv A i))} ≐ {z | ∃ i ∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm B ∧ y = fv (fv D i) (fv B i))} $ by cab_congr [g14]

sb_c_cvv
--------
l1: $ (⟦ x / t ⟧ {z | ∃ i ∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm A ∧ y = fv (fv B i) (fv A i))}) ≐ {z | ∃ i ∃ y (z = ⟨ i , y ⟩ ∧ i ∊ cdm (⟦ x / t ⟧ A) ∧ y = fv (fv (⟦ x / t ⟧ B) i) (fv (⟦ x / t ⟧ A) i))} $ by ceqt_refl

cvb_congr
---------
c1: $ crn J ≐ crn K $ by crn_congr [#5]
c2: $ ⋃ (crn J) ≐ ⋃ (crn K) $ by cuni_congr [c1]
c3: $ cvv H J ≐ cvv I K $ by cvv_congr [#4, #5]
c4: $ ⟨ H , ⋃ (crn J) ⟩ ≐ ⟨ I , ⋃ (crn K) ⟩ $ by opair_congr [#4, c2]
c5: $ ⟨ E , ⟨ H , ⋃ (crn J) ⟩ ⟩ ≐ ⟨ F , ⟨ I , ⋃ (crn K) ⟩ ⟩ $ by opair_congr [#3, c4]
c6: $ ⟨ A , ⟨ E , ⟨ H , ⋃ (crn J) ⟩ ⟩ ⟩ ≐ ⟨ B , ⟨ F , ⟨ I , ⋃ (crn K) ⟩ ⟩ ⟩ $ by opair_congr [#1, c5]
c7: $ fv C ⟨ A , ⟨ E , ⟨ H , ⋃ (crn J) ⟩ ⟩ ⟩ ≐ fv D ⟨ B , ⟨ F , ⟨ I , ⋃ (crn K) ⟩ ⟩ ⟩ $ by fv_congr [#2, c6]
c8: $ ⟨ H , cvv H J ⟩ ≐ ⟨ I , cvv I K ⟩ $ by opair_congr [#4, c3]
c9: $ ⟨ E , ⟨ H , cvv H J ⟩ ⟩ ≐ ⟨ F , ⟨ I , cvv I K ⟩ ⟩ $ by opair_congr [#3, c8]
c10: $ ⟨ A , ⟨ E , ⟨ H , cvv H J ⟩ ⟩ ⟩ ≐ ⟨ B , ⟨ F , ⟨ I , cvv I K ⟩ ⟩ ⟩ $ by opair_congr [#1, c9]
c11: $ ⟨ ⟨ A , ⟨ E , ⟨ H , cvv H J ⟩ ⟩ ⟩ , fv C ⟨ A , ⟨ E , ⟨ H , ⋃ (crn J) ⟩ ⟩ ⟩ ⟩ ≐ ⟨ ⟨ B , ⟨ F , ⟨ I , cvv I K ⟩ ⟩ ⟩ , fv D ⟨ B , ⟨ F , ⟨ I , ⋃ (crn K) ⟩ ⟩ ⟩ ⟩ $ by opair_congr [c10, c7]
c12: $ csn ⟨ ⟨ A , ⟨ E , ⟨ H , cvv H J ⟩ ⟩ ⟩ , fv C ⟨ A , ⟨ E , ⟨ H , ⋃ (crn J) ⟩ ⟩ ⟩ ⟩ ≐ csn ⟨ ⟨ B , ⟨ F , ⟨ I , cvv I K ⟩ ⟩ ⟩ , fv D ⟨ B , ⟨ F , ⟨ I , ⋃ (crn K) ⟩ ⟩ ⟩ ⟩ $ by csn_congr [c11]
c13: $ dnb A (csn ⟨ ⟨ A , ⟨ E , ⟨ H , cvv H J ⟩ ⟩ ⟩ , fv C ⟨ A , ⟨ E , ⟨ H , ⋃ (crn J) ⟩ ⟩ ⟩ ⟩) E H (cvv H J) ≐ dnb B (csn ⟨ ⟨ B , ⟨ F , ⟨ I , cvv I K ⟩ ⟩ ⟩ , fv D ⟨ B , ⟨ F , ⟨ I , ⋃ (crn K) ⟩ ⟩ ⟩ ⟩) F I (cvv I K) $ by dnb_congr [#1, c12, #3, #4, c3]
c14: $ ⟨ E , H ⟩ ≐ ⟨ F , I ⟩ $ by opair_congr [#3, #4]
c15: $ ⟨ ⟨ E , H ⟩ , dnb A (csn ⟨ ⟨ A , ⟨ E , ⟨ H , cvv H J ⟩ ⟩ ⟩ , fv C ⟨ A , ⟨ E , ⟨ H , ⋃ (crn J) ⟩ ⟩ ⟩ ⟩) E H (cvv H J) ⟩ ≐ ⟨ ⟨ F , I ⟩ , dnb B (csn ⟨ ⟨ B , ⟨ F , ⟨ I , cvv I K ⟩ ⟩ ⟩ , fv D ⟨ B , ⟨ F , ⟨ I , ⋃ (crn K) ⟩ ⟩ ⟩ ⟩) F I (cvv I K) ⟩ $ by opair_congr [c14, c13]
c16: $ csn ⟨ ⟨ E , H ⟩ , dnb A (csn ⟨ ⟨ A , ⟨ E , ⟨ H , cvv H J ⟩ ⟩ ⟩ , fv C ⟨ A , ⟨ E , ⟨ H , ⋃ (crn J) ⟩ ⟩ ⟩ ⟩) E H (cvv H J) ⟩ ≐ csn ⟨ ⟨ F , I ⟩ , dnb B (csn ⟨ ⟨ B , ⟨ F , ⟨ I , cvv I K ⟩ ⟩ ⟩ , fv D ⟨ B , ⟨ F , ⟨ I , ⋃ (crn K) ⟩ ⟩ ⟩ ⟩) F I (cvv I K) ⟩ $ by csn_congr [c15]
c17: $ cvb A C E H J ≐ cvb B D F I K $ by cun_congr [c2, c16]

sb_c_cvb
--------
l1: $ (⟦ x / t ⟧ (⋃ (crn E) ∪ csn ⟨ ⟨ C , D ⟩ , dnb A (csn ⟨ ⟨ A , ⟨ C , ⟨ D , cvv D E ⟩ ⟩ ⟩ , fv B ⟨ A , ⟨ C , ⟨ D , ⋃ (crn E) ⟩ ⟩ ⟩ ⟩) C D (cvv D E) ⟩)) ≐ ⋃ (crn (⟦ x / t ⟧ E)) ∪ csn ⟨ ⟨ (⟦ x / t ⟧ C) , (⟦ x / t ⟧ D) ⟩ , dnb (⟦ x / t ⟧ A) (csn ⟨ ⟨ (⟦ x / t ⟧ A) , ⟨ (⟦ x / t ⟧ C) , ⟨ (⟦ x / t ⟧ D) , cvv (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) ⟩ ⟩ ⟩ , fv (⟦ x / t ⟧ B) ⟨ (⟦ x / t ⟧ A) , ⟨ (⟦ x / t ⟧ C) , ⟨ (⟦ x / t ⟧ D) , ⋃ (crn (⟦ x / t ⟧ E)) ⟩ ⟩ ⟩ ⟩) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (cvv (⟦ x / t ⟧ D) (⟦ x / t ⟧ E)) ⟩ $ by ceqt_refl

cvf_congr
---------
g1: $ ω ≐ ω $ by ceqt_refl
g2: $ i ≐ i $ by ceqt_refl
g3: $ j ≐ j $ by ceqt_refl
g4: $ k ≐ k $ by ceqt_refl
g5: $ (cvb A C i j k) ≐ (cvb B D i j k) $ by cvb_congr [#1, #2, g2, g3, g4]
g6: $ (cgr3 i j k (cvb A C i j k)) ≐ (cgr3 i j k (cvb B D i j k)) $ by cgr3_congr [g5]
g7: $ cvf A C ≐ cvf B D $ by trc_congr [g1, g6]

sb_c_cvf
--------
l1: $ (⟦ x / t ⟧ (trc ω (cgr3 i j k (cvb A B i j k)))) ≐ trc ω (cgr3 i j k (cvb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) i j k)) $ by ceqt_refl

mcv_congr
---------
g1: $ cv u ≐ cv u $ by ceqt_refl
g2: $ cvf u A ≐ cvf u B $ by cvf_congr [g1, #1]
g3: $ cv j ≐ cv j $ by ceqt_refl
g4: $ ccom (cvf u A) j ≐ ccom (cvf u B) j $ by ccom_congr [g2, g3]
g5: $ crn (ccom (cvf u A) j) ≐ crn (ccom (cvf u B) j) $ by crn_congr [g4]
g6: $ ⋃ (crn (ccom (cvf u A) j)) ≐ ⋃ (crn (ccom (cvf u B) j)) $ by cuni_congr [g5]
g7: $ ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ≐ ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ $ by opair_congr [g3, g6]
g8: $ cv k ≐ cv k $ by ceqt_refl
g9: $ ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ≐ ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ $ by opair_congr [g8, g7]
g10: $ ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ≐ ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ ⟩ $ by opair_congr [g1, g9]
g11: $ fv A ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ≐ fv B ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ ⟩ $ by fv_congr [#1, g10]
g12: $ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ ≐ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ $ by ceqt_refl
g13: $ ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv A ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ⟩ ≐ ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv B ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ ⟩ ⟩ $ by opair_congr [g12, g11]
g14: $ cv z ≐ cv z $ by ceqt_refl
g15: $ (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv A ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ⟩) ⟺ (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv B ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ ⟩ ⟩) $ by ceq_congr [g14, g13]
g16: $ (∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv A ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ⟩)) ⟺ (∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv B ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ ⟩ ⟩)) $ by ex_congr [g15]
g17: $ (∃ j ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv A ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ⟩)) ⟺ (∃ j ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv B ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ ⟩ ⟩)) $ by ex_congr [g16]
g18: $ (∃ k ∃ j ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv A ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ⟩)) ⟺ (∃ k ∃ j ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv B ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ ⟩ ⟩)) $ by ex_congr [g17]
g19: $ (∃ u ∃ k ∃ j ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv A ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ⟩)) ⟺ (∃ u ∃ k ∃ j ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv B ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u B) j)) ⟩ ⟩ ⟩ ⟩)) $ by ex_congr [g18]
g20: $ mcv A ≐ mcv B $ by cab_congr [g19]

sb_c_mcv
--------
l1: $ (⟦ x / t ⟧ {z | ∃ u ∃ k ∃ j ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv A ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u A) j)) ⟩ ⟩ ⟩ ⟩)}) ≐ {z | ∃ u ∃ k ∃ j ∃ v (z = ⟨ ⟨ u , ⟨ k , ⟨ j , v ⟩ ⟩ ⟩ , fv (⟦ x / t ⟧ A) ⟨ u , ⟨ k , ⟨ j , ⋃ (crn (ccom (cvf u (⟦ x / t ⟧ A)) j)) ⟩ ⟩ ⟩ ⟩)} $ by ceqt_refl

eagr_congr
----------
g1: $ seqt t t $ by seqt_refl
g2: $ tsub ≐ tsub $ by ceqt_refl
g3: $ fv tsub E ≐ fv tsub F $ by fv_congr [g2, #3]
g4: $ (t ∊ fv tsub E) ⟺ (t ∊ fv tsub F) $ by welc_congr [g1, g3]
g5: $ cv t ≐ cv t $ by ceqt_refl
g6: $ fv A t ≐ fv B t $ by fv_congr [#1, g5]
g7: $ fv C t ≐ fv D t $ by fv_congr [#2, g5]
g8: $ (fv A t = fv C t) ⟺ (fv B t = fv D t) $ by ceq_congr [g6, g7]
g9: $ (t ∊ fv tsub E → fv A t = fv C t) ⟺ (t ∊ fv tsub F → fv B t = fv D t) $ by im_congr [g4, g8]
g10: $ (∀ t (t ∊ fv tsub E → fv A t = fv C t)) ⟺ (∀ t (t ∊ fv tsub F → fv B t = fv D t)) $ by all_congr [g9]
h1: $ ∅ ≐ ∅ $ by ceqt_refl
h2: $ fv A ∅ ≐ fv B ∅ $ by fv_congr [#1, h1]
h3: $ fv C ∅ ≐ fv D ∅ $ by fv_congr [#2, h1]
h4: $ (fv A ∅ = fv C ∅) ⟺ (fv B ∅ = fv D ∅) $ by ceq_congr [h2, h3]
h5: $ (fv A ∅ = fv C ∅ ∧ ∀ t (t ∊ fv tsub E → fv A t = fv C t)) ⟺ (fv B ∅ = fv D ∅ ∧ ∀ t (t ∊ fv tsub F → fv B t = fv D t)) $ by and_congr [h4, g10]

sb_f_eagr
---------
l1: $ [x/t] (fv A ∅ = fv B ∅ ∧ ∀ y (y ∊ fv tsub C → fv A y = fv B y)) ⟺ ((fv (⟦ x / t ⟧ A) ∅ = fv (⟦ x / t ⟧ B) ∅) ∧ ∀ y (y ∊ fv tsub (⟦ x / t ⟧ C) → fv (⟦ x / t ⟧ A) y = fv (⟦ x / t ⟧ B) y)) $ by iff_refl

tsub_functional
---------------
l1: $ G ⇒ functional (cgr3 k j v (tsb k j v)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (trc ω (cgr3 k j v (tsb k j v))) $ by trc_functional_c [l2w, l1]

tsub_cdm
--------
l1: $ G ⇒ functional (cgr3 k j v (tsb k j v)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ cdm (trc ω (cgr3 k j v (tsb k j v))) = trees ω $ by trc_cdm_c [l2w, l1]

tsub_node
---------
l1: $ G ⇒ functional (cgr3 a b c (tsb a b c)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ fv (trc ω (cgr3 a b c (tsb a b c))) ⟨ k , s ⟩ = fv (cgr3 a b c (tsb a b c)) ⟨ k , ⟨ s , ccom (trc ω (cgr3 a b c (tsb a b c))) s ⟩ ⟩ $ by trc_node_c [l2w, l1, #1, #2]
l3: $ G ⇒ functional (trc ω (cgr3 a b c (tsb a b c))) $ by trc_functional_c [l2w, l1]
l4: $ G ⇒ isset s $ by isset_var
l5: $ G ⇒ isset (ccom (trc ω (cgr3 a b c (tsb a b c))) s) $ by ccom_set [l3, l4]
h0a: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ isset ⟨ k , s ⟩ $ by opair_isset
h0b: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ isset (csn ⟨ k , s ⟩) $ by csn_set [h0a]
h0c: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ isset h $ by isset_var
h0d: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ isset (crn h) $ by crn_set [h0c]
h0e: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ isset (⋃ (crn h)) $ by cuni_set [h0d]
h1: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ isset (tsb k s h) $ by cun_set [h0b, h0e]
h2: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ fv (cgr3 a b c (tsb a b c)) ⟨ k , ⟨ s , h ⟩ ⟩ = tsb k s h $ by fv_cgr3 [h1]
h3: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ h = ccom (trc ω (cgr3 a b c (tsb a b c))) s $ by ax
h4: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ ccom (trc ω (cgr3 a b c (tsb a b c))) s = h $ by eq_sym [h3]
h5: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ s = s $ by eq_refl
h6: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ ⟨ s , ccom (trc ω (cgr3 a b c (tsb a b c))) s ⟩ = ⟨ s , h ⟩ $ by opair_eq [h5, h4]
h7: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ k = k $ by eq_refl
h8: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ ⟨ k , ⟨ s , ccom (trc ω (cgr3 a b c (tsb a b c))) s ⟩ ⟩ = ⟨ k , ⟨ s , h ⟩ ⟩ $ by opair_eq [h7, h6]
h9: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ cgr3 a b c (tsb a b c) = cgr3 a b c (tsb a b c) $ by eq_refl
h10: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ fv (cgr3 a b c (tsb a b c)) ⟨ k , ⟨ s , ccom (trc ω (cgr3 a b c (tsb a b c))) s ⟩ ⟩ = fv (cgr3 a b c (tsb a b c)) ⟨ k , ⟨ s , h ⟩ ⟩ $ by fv_eq [h9, h8]
h12: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ fv (trc ω (cgr3 a b c (tsb a b c))) ⟨ k , s ⟩ = fv (cgr3 a b c (tsb a b c)) ⟨ k , ⟨ s , ccom (trc ω (cgr3 a b c (tsb a b c))) s ⟩ ⟩ $ by weaken [l2]
h13: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ fv (trc ω (cgr3 a b c (tsb a b c))) ⟨ k , s ⟩ = fv (cgr3 a b c (tsb a b c)) ⟨ k , ⟨ s , h ⟩ ⟩ $ by eq_trans [h12, h10]
h14: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ fv (trc ω (cgr3 a b c (tsb a b c))) ⟨ k , s ⟩ = tsb k s h $ by eq_trans [h13, h2]
h15a: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ crn h = crn (ccom (trc ω (cgr3 a b c (tsb a b c))) s) $ by crn_eq [h3]
h15b: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ ⋃ (crn h) = ⋃ (crn (ccom (trc ω (cgr3 a b c (tsb a b c))) s)) $ by cuni_eq [h15a]
h15c: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ csn ⟨ k , s ⟩ = csn ⟨ k , s ⟩ $ by eq_refl
h15: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ csn ⟨ k , s ⟩ ∪ ⋃ (crn h) = csn ⟨ k , s ⟩ ∪ ⋃ (crn (ccom (trc ω (cgr3 a b c (tsb a b c))) s)) $ by cun_eq [h15c, h15b]
h16: $ G , h = ccom (trc ω (cgr3 a b c (tsb a b c))) s ⇒ fv (trc ω (cgr3 a b c (tsb a b c))) ⟨ k , s ⟩ = csn ⟨ k , s ⟩ ∪ ⋃ (crn (ccom (trc ω (cgr3 a b c (tsb a b c))) s)) $ by eq_trans [h14, h15]
l9: $ G ⇒ fv (trc ω (cgr3 a b c (tsb a b c))) ⟨ k , s ⟩ = csn ⟨ k , s ⟩ ∪ ⋃ (crn (ccom (trc ω (cgr3 a b c (tsb a b c))) s)) $ by isset_elim [l5, h16]

tsub_node_c
-----------
c1: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ k ∊ ω $ by ax
c2: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ h ∊ fseq (trees ω) $ by ax
c3: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ k , h ⟩ = csn ⟨ k , h ⟩ ∪ psub h $ by tsub_node [c1, c2]
c4: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ k = K $ by ax
c5: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ h = S $ by ax
c6: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ ⟨ k , h ⟩ = ⟨ K , S ⟩ $ by opair_eq [c4, c5]
c7: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ tsub = tsub $ by eq_refl
c8: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ k , h ⟩ = fv tsub ⟨ K , S ⟩ $ by fv_eq [c7, c6]
c9: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ csn ⟨ k , h ⟩ = csn ⟨ K , S ⟩ $ by csn_eq [c6]
c10: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ ccom tsub h = ccom tsub S $ by ccom_eq [c7, c5]
c11: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ crn (ccom tsub h) = crn (ccom tsub S) $ by crn_eq [c10]
c12: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ ⋃ (crn (ccom tsub h)) = ⋃ (crn (ccom tsub S)) $ by cuni_eq [c11]
c13: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ csn ⟨ k , h ⟩ ∪ psub h = csn ⟨ K , S ⟩ ∪ psub S $ by cun_eq [c9, c12]
c14: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ K , S ⟩ = fv tsub ⟨ k , h ⟩ $ by eq_sym [c8]
c15: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ K , S ⟩ = csn ⟨ k , h ⟩ ∪ psub h $ by eq_trans [c14, c3]
c16: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ K , S ⟩ = csn ⟨ K , S ⟩ ∪ psub S $ by eq_trans [c15, c13]
c17: $ G , k = K , k ∊ ω ⇒ fv tsub ⟨ K , S ⟩ = csn ⟨ K , S ⟩ ∪ psub S $ by wcel_elim [#2, c16]
c18: $ G ⇒ fv tsub ⟨ K , S ⟩ = csn ⟨ K , S ⟩ ∪ psub S $ by wcel_elim [#1, c17]

tsub_self
---------
a0: $ G ⇒ isset ω $ by omega_set
a0b: $ G ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [a0]
a0c: $ G ⇒ trees ω = ω × fseq (trees ω) $ by eq_sym [a0b]
a1: $ G , t = T , t ∊ trees ω ⇒ t ∊ trees ω $ by ax
a2: $ G , t = T , t ∊ trees ω ⇒ trees ω = ω × fseq (trees ω) $ by weaken [a0c]
a3: $ G , t = T , t ∊ trees ω ⇒ t ∊ ω × fseq (trees ω) $ by welc_eq [a2, a1]
b0: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ k ∊ ω $ by ax
b0b: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ h ∊ fseq (trees ω) $ by ax
b1: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ k , h ⟩ = csn ⟨ k , h ⟩ ∪ psub h $ by tsub_node [b0, b0b]
b2: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ ⟨ k , h ⟩ ∈ csn ⟨ k , h ⟩ $ by csn_opair_intro
b3: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ ⟨ k , h ⟩ ∈ csn ⟨ k , h ⟩ ∪ psub h $ by cun_intro_l_c [b2]
b4: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ csn ⟨ k , h ⟩ ∪ psub h = fv tsub ⟨ k , h ⟩ $ by eq_sym [b1]
b5: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ ⟨ k , h ⟩ ∈ fv tsub ⟨ k , h ⟩ $ by wcel_eq_r [b4, b3]
b6: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ t = ⟨ k , h ⟩ $ by ax
b6b: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ ⟨ k , h ⟩ = t $ by eq_sym [b6]
b6c: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ t = T $ by ax
b7: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ ⟨ k , h ⟩ = T $ by eq_trans [b6b, b6c]
b8: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ T ∈ fv tsub ⟨ k , h ⟩ $ by wcel_eq_l [b7, b5]
b9: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ tsub = tsub $ by eq_refl
b10: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ k , h ⟩ = fv tsub T $ by fv_eq [b9, b7]
b11: $ G , t = T , t ∊ trees ω , t = ⟨ k , h ⟩ , k ∊ ω , h ∊ fseq (trees ω) ⇒ T ∈ fv tsub T $ by wcel_eq_r [b10, b8]
c1: $ G , t = T , t ∊ trees ω ⇒ T ∈ fv tsub T $ by cxp_elim [a3, b11]
c2: $ G ⇒ T ∈ fv tsub T $ by wcel_elim [#1, c1]

lemma c1_tsub_rel (G: hyps): $ G ⇒ rel tsub $
----
l1: $ G ⇒ functional (cgr3 k j v (tsb k j v)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ rel (trc ω (cgr3 k j v (tsb k j v))) $ by trc_rel_c [l2w, l1]

lemma c1_fv_dom (G: hyps) (F A: class) (x: set): $ G ⇒ rel F $ > $ G ⇒ x ∊ fv F A $ > $ G ⇒ A ∈ cdm F $
----
p1: $ G , y ∊ ap F A , x ∊ y ⇒ y ∊ ap F A $ by ax
p2: $ G , y ∊ ap F A , x ∊ y ⇒ ⟨ A , y ⟩ ∈ F $ by ap_elim [p1]
q1: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F ⇒ rel F $ by weaken [#1]
q2: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F ⇒ z ∊ F $ by ax
r1: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , z = ⟨ a , b ⟩ ⇒ z = ⟨ a , b ⟩ $ by ax
r2: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , z = ⟨ a , b ⟩ ⇒ z = ⟨ A , y ⟩ $ by ax
r3: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , z = ⟨ a , b ⟩ ⇒ ⟨ A , y ⟩ = z $ by eq_sym [r2]
r4: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , z = ⟨ a , b ⟩ ⇒ ⟨ A , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [r3, r1]
r5: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , z = ⟨ a , b ⟩ ⇒ isset A $ by opair_eq_isset [r4]
q3: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F ⇒ isset A $ by rel_elim [q1, q2, r5]
s1: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , c = A ⇒ c = A $ by ax
s1b: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , c = A ⇒ A = c $ by eq_sym [s1]
s2: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , c = A ⇒ y = y $ by eq_refl
s3: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , c = A ⇒ ⟨ A , y ⟩ = ⟨ c , y ⟩ $ by opair_eq [s1b, s2]
s4: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , c = A ⇒ ⟨ A , y ⟩ ∈ F $ by weaken [p2]
s5: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , c = A ⇒ ⟨ c , y ⟩ ∈ F $ by wcel_eq_l [s3, s4]
s6: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , c = A ⇒ c ∊ cdm F $ by cdm_intro [s5]
s7: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F , c = A ⇒ A ∈ cdm F $ by wcel_intro [s1, s6]
q4: $ G , y ∊ ap F A , x ∊ y , z = ⟨ A , y ⟩ , z ∊ F ⇒ A ∈ cdm F $ by isset_elim [q3, s7]
p3: $ G , y ∊ ap F A , x ∊ y ⇒ A ∈ cdm F $ by wcel_elim [p2, q4]
f0: $ G ⇒ x ∊ ⋃ (ap F A) $ by weaken [#2]
f1: $ G ⇒ A ∈ cdm F $ by cuni_elim [f0, p3]

psub_elim
---------
g1: $ H , c ∊ crn S ⇒ x ∊ fv tsub c → d $ by imp_intro [#2]
g2: $ H ⇒ c ∊ crn S → x ∊ fv tsub c → d $ by imp_intro [g1]
e1: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ ⟨ i , c ⟩ ∈ S $ by ax
e2: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ c ∊ crn S $ by crn_intro [e1]
e3: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ functional tsub $ by tsub_functional
e4: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ ⟨ c , y ⟩ ∈ tsub $ by ax
e5: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ fv tsub c = y $ by fv_val [e3, e4]
e6: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ y = fv tsub c $ by eq_sym [e5]
e7: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ x ∊ y $ by ax
e8: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ x ∊ fv tsub c $ by welc_eq [e6, e7]
e9: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ c ∊ crn S → x ∊ fv tsub c → d $ by weaken [g2]
e10: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ x ∊ fv tsub c → d $ by imp_elim [e9, e2]
e11: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S , ⟨ i , c ⟩ ∈ S , ⟨ c , y ⟩ ∈ tsub ⇒ d $ by imp_elim [e10, e8]
f1: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S ⇒ ⟨ i , y ⟩ ∈ ccom tsub S $ by ax
f2: $ H , y ∊ crn (ccom tsub S) , x ∊ y , ⟨ i , y ⟩ ∈ ccom tsub S ⇒ d $ by ccom_elim [f1, e11]
k0: $ H , y ∊ crn (ccom tsub S) , x ∊ y ⇒ y ∊ crn (ccom tsub S) $ by ax
k1: $ H , y ∊ crn (ccom tsub S) , x ∊ y ⇒ d $ by crn_elim [k0, f2]
m0: $ G ⇒ x ∊ ⋃ (crn (ccom tsub S)) $ by weaken [#1]
m1: $ G , H ⇒ d $ by cuni_elim [m0, k1]

psub_intro
----------
n0: $ G ⇒ rel tsub $ by c1_tsub_rel
n1: $ G ⇒ c ∈ cdm tsub $ by c1_fv_dom [n0, #2]
n1b: $ G ⇒ c ∊ cdm tsub $ by wcel_welc [n1]
n2: $ G ⇒ functional tsub $ by tsub_functional
n3: $ G ⇒ ⟨ c , fv tsub c ⟩ ∈ tsub $ by fv_in [n2, n1b]
n4: $ G ⇒ isset (fv tsub c) $ by fv_set [n2]
p1: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ ⟨ i , c ⟩ ∈ S $ by ax
p2: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ e = fv tsub c $ by ax
p2b: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ fv tsub c = e $ by eq_sym [p2]
p3: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ c = c $ by eq_refl
p4: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ ⟨ c , fv tsub c ⟩ = ⟨ c , e ⟩ $ by opair_eq [p3, p2b]
p4b: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ ⟨ c , fv tsub c ⟩ ∈ tsub $ by weaken [n3]
p5: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ ⟨ c , e ⟩ ∈ tsub $ by wcel_eq_l [p4, p4b]
p6: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ ⟨ i , e ⟩ ∈ ccom tsub S $ by ccom_intro [p1, p5]
p7: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ e ∊ crn (ccom tsub S) $ by crn_intro [p6]
p8a: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ x ∊ fv tsub c $ by weaken [#2]
p8: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ x ∊ e $ by welc_eq [p2b, p8a]
p9: $ G , e = fv tsub c , ⟨ i , c ⟩ ∈ S ⇒ x ∊ ⋃ (crn (ccom tsub S)) $ by cuni_intro [p8, p7]
q1: $ G , e = fv tsub c ⇒ x ∊ ⋃ (crn (ccom tsub S)) $ by crn_elim [#1, p9]
q2: $ G ⇒ x ∊ ⋃ (crn (ccom tsub S)) $ by isset_elim [n4, q1]

lemma c1_tsub_trees_set (G: hyps) (t: set): $ G ⇒ t ∊ trees ω $ > $ G ⇒ fv tsub t ⊆ trees ω $
----
s1: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} ⇒ k ∊ ω $ by ax
s2: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} ⇒ h ∊ fseq (trees ω) $ by ax
s3: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} ⇒ fv tsub ⟨ k , h ⟩ = csn ⟨ k , h ⟩ ∪ psub h $ by tsub_node [s1, s2]
s4o: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} ⇒ isset ω $ by omega_set
s4k: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} ⇒ k ∈ ω $ by welc_wcel [s1]
s4h: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} ⇒ h ∈ fseq (trees ω) $ by welc_wcel [s2]
s4: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} ⇒ ⟨ k , h ⟩ ∈ trees ω $ by trees_intro_c [s4o, s4k, s4h]
s5: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} ⇒ csn ⟨ k , h ⟩ ⊆ trees ω $ by csn_subset_c [s4]
t1: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} , x ∊ psub h ⇒ x ∊ psub h $ by ax
u1: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} , c ∊ crn h , x ∊ fv tsub c ⇒ c ∊ crn h $ by ax
u2: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} , c ∊ crn h , x ∊ fv tsub c ⇒ crn h ⊆ {x0 | fv tsub x0 ⊆ trees ω} $ by ax
