lemma c4_nty_nvf_one {x i k: set} (G: hyps) (t j l f c g d: set): $ G ⇒ ra_nth_ty t j f c ∈ lrel $ > $ G ⇒ ra_nth_ty t l g d ∈ lrel $ > $ G ⇒ fv nvf j = fv nvf l $ > $ G ⇒ ∀ x ∀ i ∀ k (ra_nth_ty x i f c ∈ lrel → ra_nth_ty x k g d ∈ lrel → fv nvf i = fv nvf k → suc (fv nvf i) = fv nvf j → f = g ∧ c = d) $ > $ G ⇒ f = g ∧ c = d $
