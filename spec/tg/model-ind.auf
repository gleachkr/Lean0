lemma c4_nctor_nvf_one {x i w: set} (G: hyps) (q j l k g: set): $ G ⇒ ra_nth_ctor q j k ∈ lrel $ > $ G ⇒ ra_nth_ctor q l g ∈ lrel $ > $ G ⇒ fv nvf j = fv nvf l $ > $ G ⇒ ∀ x ∀ i ∀ w (ra_nth_ctor x i k ∈ lrel → ra_nth_ctor x w g ∈ lrel → fv nvf i = fv nvf w → suc (fv nvf i) = fv nvf j → k = g) $ > $ G ⇒ k = g $
----
a1: $ G ⇒ ∃ a ∃ b (q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a) ∨ ∃ a ∃ u ∃ b ∃ h (q = ⟨ kc_ccons , scons u (scons b ∅) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ k = a ∧ ra_nth_ctor b h a ∈ lrel) $ by lrel_nth_ctor_cases [#1]
p1: $ G , q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a ⇒ q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a $ by ax
pp0: $ G , q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a ⇒ q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ $ by and_elim_l [p1]
ppr0: $ G , q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a ⇒ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a $ by and_elim_r [p1]
pp1: $ G , q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a ⇒ j = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [ppr0]
pp2: $ G , q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a ⇒ k = a $ by and_elim_r [ppr0]
p5: $ G , q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a ⇒ ra_nth_ctor q l g ∈ lrel $ by weaken [#2]
p6: $ G , q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a ⇒ fv nvf j = fv nvf l $ by weaken [#3]
p7: $ G , q = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ j = ⟨ kc_nz , ∅ ⟩ ∧ k = a ⇒ k = g $ by c4_nvf_ctA [pp0, pp1, pp2, p5, p6]
