lemma c6_etel_fseq_R (G: hyps) (E D T W: class) (u p f g t a: set): $ G ⇒ isset W $ > $ G ⇒ T ∈ trees ω $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T W (scat p (ixs D W (ifam u E D W))) $ > $ G ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $
----
h1: $ G , r = scat p (ixs D W (ifam u E D W)) ⇒ r = scat p (ixs D W (ifam u E D W)) $ by ax
h2: $ G , r = scat p (ixs D W (ifam u E D W)) ⇒ scat p (ixs D W (ifam u E D W)) = r $ by eq_sym [h1]
h3: $ G , r = scat p (ixs D W (ifam u E D W)) ⇒ fv (etf u E) T = fv (etf u E) T $ by eq_refl
h4: $ G , r = scat p (ixs D W (ifam u E D W)) ⇒ W = W $ by eq_refl
h5: $ G , r = scat p (ixs D W (ifam u E D W)) ⇒ etel u E T W (scat p (ixs D W (ifam u E D W))) = etel u E T W r $ by da_eq [h3, h4, h2]
h6: $ G , r = scat p (ixs D W (ifam u E D W)) ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T W (scat p (ixs D W (ifam u E D W))) $ by weaken [#4]
h7: $ G , r = scat p (ixs D W (ifam u E D W)) ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T W r $ by wcel_eq_r [h5, h6]
