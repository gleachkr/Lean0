n8: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} → ⟨ k , j ⟩ ∈ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)}) $ by all_intro [n7]
n9: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} → ⟨ k , j ⟩ ∈ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)}) $ by all_intro [n8]
n10: $ G ⇒ isset ω $ by omega_set
n11: $ G ⇒ trees ω ⊆ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} $ by trees_ind_c [n10, n9]
n12: $ G ⇒ T ∈ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} $ by wcel_subset [n11, #1]
z1: $ G ⇒ isset r $ by isset_var
z2: $ G ⇒ isset r2 $ by isset_var
z3: $ G ⇒ cdm f = cdm f2 $ by c3_el_use [n12, #2, #3, z1, z2]

lemma c3_len_c (G: hyps) (E T R R2: class) (u w f g t a f2 g2 t2 a2: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w R $ > $ G ⇒ ⟨ f2 , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E T w R2 $ >
  $ G ⇒ isset R $ > $ G ⇒ isset R2 $ > $ G ⇒ cdm f = cdm f2 $
----
l1: $ G , q = R , o = R2 ⇒ fv (etf u E) T = fv (etf u E) T $ by eq_refl
l2: $ G , q = R , o = R2 ⇒ w = w $ by eq_refl
l3a: $ G , q = R , o = R2 ⇒ q = R $ by ax
l3: $ G , q = R , o = R2 ⇒ R = q $ by eq_sym [l3a]
l3c: $ G , q = R , o = R2 ⇒ o = R2 $ by ax
l3d: $ G , q = R , o = R2 ⇒ R2 = o $ by eq_sym [l3c]
l4: $ G , q = R , o = R2 ⇒ da (fv (etf u E) T) w R = da (fv (etf u E) T) w q $ by da_eq [l1, l2, l3]
l4b: $ G , q = R , o = R2 ⇒ da (fv (etf u E) T) w R2 = da (fv (etf u E) T) w o $ by da_eq [l1, l2, l3d]
l5: $ G , q = R , o = R2 ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w R $ by weaken [#2]
l5b: $ G , q = R , o = R2 ⇒ ⟨ f2 , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E T w R2 $ by weaken [#3]
l6: $ G , q = R , o = R2 ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w q $ by wcel_eq_r [l4, l5]
l6b: $ G , q = R , o = R2 ⇒ ⟨ f2 , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E T w o $ by wcel_eq_r [l4b, l5b]
l7: $ G , q = R , o = R2 ⇒ T ∈ trees ω $ by weaken [#1]
l8: $ G , q = R , o = R2 ⇒ cdm f = cdm f2 $ by etel_len [l7, l6, l6b]
l9a: $ G , q = R ⇒ isset R2 $ by weaken [#5]
l9: $ G , q = R ⇒ cdm f = cdm f2 $ by isset_elim [l9a, l8]
l10: $ G ⇒ cdm f = cdm f2 $ by isset_elim [#4, l9]

lemma c3_ssnoc_inj (G: hyps) (A: class) (f x d b: set): $ G ⇒ f ∊ fseq A $ > $ G ⇒ d ∊ fseq A $ > $ G ⇒ cdm f = cdm d $ > $ G ⇒ ssnoc f x = ssnoc d b $ > $ G ⇒ f = d ∧ x = b $
----
l1: $ G ⇒ fv (ssnoc f x) (cdm f) = x $ by ssnoc_fv_last [#1]
l2: $ G ⇒ fv (ssnoc d b) (cdm d) = b $ by ssnoc_fv_last [#2]
l3: $ G ⇒ fv (ssnoc f x) (cdm f) = fv (ssnoc d b) (cdm d) $ by fv_eq [#4, #3]
l4: $ G ⇒ x = fv (ssnoc f x) (cdm f) $ by eq_sym [l1]
l5: $ G ⇒ x = fv (ssnoc d b) (cdm d) $ by eq_trans [l4, l3]
l6: $ G ⇒ x = b $ by eq_trans [l5, l2]
m1: $ G , i ∊ cdm f ⇒ i ∊ cdm f $ by ax
m2: $ G , i ∊ cdm f ⇒ f ∊ fseq A $ by weaken [#1]
m3: $ G , i ∊ cdm f ⇒ d ∊ fseq A $ by weaken [#2]
m4: $ G , i ∊ cdm f ⇒ cdm f = cdm d $ by weaken [#3]
m5: $ G , i ∊ cdm f ⇒ i ∊ cdm d $ by welc_eq [m4, m1]
m6: $ G , i ∊ cdm f ⇒ fv (ssnoc f x) i = fv f i $ by ssnoc_fv_lt [m2, m1]
m7: $ G , i ∊ cdm f ⇒ fv (ssnoc d b) i = fv d i $ by ssnoc_fv_lt [m3, m5]
m8a: $ G , i ∊ cdm f ⇒ ssnoc f x = ssnoc d b $ by weaken [#4]
m8b: $ G , i ∊ cdm f ⇒ i = i $ by eq_refl
m8: $ G , i ∊ cdm f ⇒ fv (ssnoc f x) i = fv (ssnoc d b) i $ by fv_eq [m8a, m8b]
m9: $ G , i ∊ cdm f ⇒ fv f i = fv (ssnoc f x) i $ by eq_sym [m6]
m10: $ G , i ∊ cdm f ⇒ fv f i = fv (ssnoc d b) i $ by eq_trans [m9, m8]
m11: $ G , i ∊ cdm f ⇒ fv f i = fv d i $ by eq_trans [m10, m7]
m12: $ G ⇒ i ∊ cdm f → fv f i = fv d i $ by imp_intro [m11]
m13: $ G ⇒ ∀ i (i ∊ cdm f → fv f i = fv d i) $ by all_intro [m12]
m14: $ G ⇒ f = d $ by fseq_ext [#1, #2, #3, m13]
m15: $ G ⇒ f = d ∧ x = b $ by and_intro [m14, l6]

lemma c3_ed_use {y x0 x1 x2 x3 x4 x6 x7 x8: set} (G: hyps y x0 x1 x2 x3 x4 x6 x7 x8) (E A R: class) (u w f g t a g2 t2 a2: set):
  $ G ⇒ A ∈ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x6 ∀ x7 ∀ x8 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x1 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)} $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E A w R $ > $ G ⇒ ⟨ f , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E A w R $ > $ G ⇒ isset R $ >
  $ G ⇒ g = g2 ∧ t = t2 ∧ a = a2 $
