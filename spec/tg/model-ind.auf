y27: $ G ⇒ isset (ifam u E D W) $ by ifam_set
y28: $ G ⇒ isset (ity u E D J W) $ by isset_elim [y27, y26]

lemma i3_ityv_sub (G: hyps) (U E D J W: class): $ G ⇒ ityv U E D J W ⊆ ity U E D J W $
----
a1: $ G , x ∊ ityv U E D J W ⇒ x ∊ ityv U E D J W $ by ax
a2: $ G , x ∊ ityv U E D J W ⇒ igate U E D J W ∧ x ∈ ity U E D J W $ by cab_elim [a1]
a3: $ G , x ∊ ityv U E D J W ⇒ x ∈ ity U E D J W $ by and_elim_r [a2]
a4: $ G , x ∊ ityv U E D J W ⇒ x ∊ ity U E D J W $ by wcel_welc [a3]
a5: $ G ⇒ ityv U E D J W ⊆ ity U E D J W $ by subset_intro [a4]

ityv_set
--------
l1: $ G ⇒ isset (ity u E D J W) $ by ity_set
l2: $ G ⇒ ityv u E D J W ⊆ ity u E D J W $ by i3_ityv_sub
l3: $ G ⇒ isset (ityv u E D J W) $ by subset_isset [l1, l2]

lemma i3_ityv_sub2 (G: hyps) (U E E2 D D2 J J2 W W2: class): $ G ⇒ igate U E D J W → igate U E2 D2 J2 W2 $ > $ G ⇒ ity U E D J W = ity U E2 D2 J2 W2 $ > $ G ⇒ ityv U E D J W ⊆ ityv U E2 D2 J2 W2 $
