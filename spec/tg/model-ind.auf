lemma c1_cvvW {c: set} (G: hyps) (F D: class) (s: set): $ G ⇒ functional F $ > $ G ⇒ functional D $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ cdm F = trees ω $ > $ G ⇒ cdm D = trees ω $ > $ G ⇒ ∀ c (c ∊ crn s → fv F c = cres D (fv tsub c)) $ > $ G ⇒ cvv s (ccom F s) = ccom D s $
----
a1: $ G , w ∊ cvv s (ccom F s) ⇒ w ∊ {w | ∃ i ∃ y (w = ⟨ i , y ⟩ ∧ i ∊ cdm s ∧ y = fv (fv (ccom F s) i) (fv s i))} $ by ax
a2: $ G , w ∊ cvv s (ccom F s) ⇒ ∃ i ∃ y (w = ⟨ i , y ⟩ ∧ i ∊ cdm s ∧ y = fv (fv (ccom F s) i) (fv s i)) $ by cab_elim [a1]
