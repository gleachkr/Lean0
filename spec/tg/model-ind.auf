q19: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ kc_tcons ∈ ω $ by weaken [a7]
q20: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ u ∈ fv tsub ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ v ∈ fv tsub ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ e ∈ fv tsub ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ $ by c4_node3 [q19, q18]
q20b: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ v ∈ fv tsub ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ e ∈ fv tsub ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ $ by and_elim_r [q20]
q21: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ e ∈ fv tsub ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ $ by and_elim_r [q20b]
qms: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ = t $ by eq_sym [qq0]
