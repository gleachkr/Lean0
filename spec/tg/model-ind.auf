lemma c4_nvf_ctB {x i w: set} (G: hyps) (q j l k g a u b h: set): $ G ⇒ q = ⟨ kc_ccons , scons u (scons b ∅) ⟩ $ > $ G ⇒ j = ⟨ kc_s , scons h ∅ ⟩ $ > $ G ⇒ k = a $ > $ G ⇒ ra_nth_ctor b h a ∈ lrel $ > $ G ⇒ ra_nth_ctor q l g ∈ lrel $ > $ G ⇒ fv nvf j = fv nvf l $ > $ G ⇒ ∀ x ∀ i ∀ w (ra_nth_ctor x i k ∈ lrel → ra_nth_ctor x w g ∈ lrel → fv nvf i = fv nvf w → suc (fv nvf i) = fv nvf j → k = g) $ > $ G ⇒ k = g $
----
a1: $ G ⇒ ∃ r ∃ e (q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r) ∨ ∃ r ∃ x0 ∃ e ∃ x1 (q = ⟨ kc_ccons , scons x0 (scons e ∅) ⟩ ∧ l = ⟨ kc_s , scons x1 ∅ ⟩ ∧ g = r ∧ ra_nth_ctor e x1 r ∈ lrel) $ by lrel_nth_ctor_cases [#5]
a2: $ G ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
a3: $ G ⇒ isset kc_ccons $ by wcel_isset [a2]
a4: $ G ⇒ kr_nth_ctor ∈ ω $ by kr_nth_ctor_omega
a5: $ G ⇒ isset kr_nth_ctor $ by wcel_isset [a4]
e1: $ G ⇒ b ∊ trees ω ∧ h ∊ trees ω ∧ a ∊ trees ω $ by lrel_args3 [#4, a5]
e2: $ G ⇒ h ∊ trees ω ∧ a ∊ trees ω $ by and_elim_r [e1]
e3: $ G ⇒ h ∊ trees ω $ by and_elim_l [e2]
e4: $ G ⇒ h ∈ trees ω $ by welc_wcel [e3]
e5: $ G ⇒ nvf = nvf $ by eq_refl
e6: $ G ⇒ fv nvf j = fv nvf ⟨ kc_s , scons h ∅ ⟩ $ by fv_eq [e5, #2]
e7: $ G ⇒ fv nvf ⟨ kc_s , scons h ∅ ⟩ = suc (fv nvf h) $ by nvf_s [e4]
e8: $ G ⇒ fv nvf j = suc (fv nvf h) $ by eq_trans [e6, e7]
e9: $ G ⇒ suc (fv nvf h) = fv nvf j $ by eq_sym [e8]
e10: $ G ⇒ suc (fv nvf h) = fv nvf l $ by eq_trans [e9, #6]
p1: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r $ by ax
pp0: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ $ by and_elim_l [p1]
ppr0: $ G , q = ⟨ kc_ccons , scons r (scons e ∅) ⟩ ∧ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r ⇒ l = ⟨ kc_nz , ∅ ⟩ ∧ g = r $ by and_elim_r [p1]
