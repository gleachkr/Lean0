qqr0: $ G , t = ⟨ kc_tcons , scons x0 (scons x1 (scons w ∅)) ⟩ ∧ l = ⟨ kc_s , scons x2 ∅ ⟩ ∧ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel ⇒ l = ⟨ kc_s , scons x2 ∅ ⟩ ∧ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel $ by and_elim_r [q1]
qq1: $ G , t = ⟨ kc_tcons , scons x0 (scons x1 (scons w ∅)) ⟩ ∧ l = ⟨ kc_s , scons x2 ∅ ⟩ ∧ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel ⇒ l = ⟨ kc_s , scons x2 ∅ ⟩ $ by and_elim_l [qqr0]
qqr1: $ G , t = ⟨ kc_tcons , scons x0 (scons x1 (scons w ∅)) ⟩ ∧ l = ⟨ kc_s , scons x2 ∅ ⟩ ∧ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel ⇒ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel $ by and_elim_r [qqr0]
qq2: $ G , t = ⟨ kc_tcons , scons x0 (scons x1 (scons w ∅)) ⟩ ∧ l = ⟨ kc_s , scons x2 ∅ ⟩ ∧ g = q ∧ d = r ∧ ra_nth_ty w x2 q r ∈ lrel ⇒ g = q $ by and_elim_l [qqr1]
