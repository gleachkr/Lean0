l101: $ (((E = kc_app) ∧ (z ∊ (clam w lvals (clam r (fseq A) {y | ∃ a ((⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ (da (fv J ∅) w r)) ∧ (y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv C (fv H (suc ∅))) w r) a ⟩ ⟩ ⟩))})))) ∨ ((¬ (E = kc_pi)) ∧ ((¬ (E = kc_app)) ∧ (z ∊ (clam w lvals (clam r (fseq A) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))))))) ⟺ (((F = kc_app) ∧ (z ∊ (clam w lvals (clam r (fseq B) {y | ∃ a ((⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ (da (fv K ∅) w r)) ∧ (y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv D (fv I (suc ∅))) w r) a ⟩ ⟩ ⟩))})))) ∨ ((¬ (F = kc_pi)) ∧ ((¬ (F = kc_app)) ∧ (z ∊ (clam w lvals (clam r (fseq B) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))))))) $ by or_congr [l85, l100]
l102: $ (((E = kc_pi) ∧ (z ∊ (clam w lvals (clam r (fseq A) {y | ∃ x (∃ f (∃ g (∃ t (∃ a ((x ∊ (da (fv C (fv H ∅)) w r)) ∧ ((x ∊ A) ∧ ((⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ (da (fv J (suc ∅)) w (scons x r))) ∧ (y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv J ∅) w r) t , a ⟩ ⟩ ⟩))))))))})))) ∨ (((E = kc_app) ∧ (z ∊ (clam w lvals (clam r (fseq A) {y | ∃ a ((⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ (da (fv J ∅) w r)) ∧ (y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv C (fv H (suc ∅))) w r) a ⟩ ⟩ ⟩))})))) ∨ ((¬ (E = kc_pi)) ∧ ((¬ (E = kc_app)) ∧ (z ∊ (clam w lvals (clam r (fseq A) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))))))) ⟺ (((F = kc_pi) ∧ (z ∊ (clam w lvals (clam r (fseq B) {y | ∃ x (∃ f (∃ g (∃ t (∃ a ((x ∊ (da (fv D (fv I ∅)) w r)) ∧ ((x ∊ B) ∧ ((⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ (da (fv K (suc ∅)) w (scons x r))) ∧ (y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv K ∅) w r) t , a ⟩ ⟩ ⟩))))))))})))) ∨ (((F = kc_app) ∧ (z ∊ (clam w lvals (clam r (fseq B) {y | ∃ a ((⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ (da (fv K ∅) w r)) ∧ (y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv D (fv I (suc ∅))) w r) a ⟩ ⟩ ⟩))})))) ∨ ((¬ (F = kc_pi)) ∧ ((¬ (F = kc_app)) ∧ (z ∊ (clam w lvals (clam r (fseq B) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))))))) $ by or_congr [l50, l101]
l103: $ {z | ((E = kc_pi) ∧ (z ∊ (clam w lvals (clam r (fseq A) {y | ∃ x (∃ f (∃ g (∃ t (∃ a ((x ∊ (da (fv C (fv H ∅)) w r)) ∧ ((x ∊ A) ∧ ((⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ (da (fv J (suc ∅)) w (scons x r))) ∧ (y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv J ∅) w r) t , a ⟩ ⟩ ⟩))))))))})))) ∨ (((E = kc_app) ∧ (z ∊ (clam w lvals (clam r (fseq A) {y | ∃ a ((⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ (da (fv J ∅) w r)) ∧ (y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv C (fv H (suc ∅))) w r) a ⟩ ⟩ ⟩))})))) ∨ ((¬ (E = kc_pi)) ∧ ((¬ (E = kc_app)) ∧ (z ∊ (clam w lvals (clam r (fseq A) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))))))} ≐ {z | ((F = kc_pi) ∧ (z ∊ (clam w lvals (clam r (fseq B) {y | ∃ x (∃ f (∃ g (∃ t (∃ a ((x ∊ (da (fv D (fv I ∅)) w r)) ∧ ((x ∊ B) ∧ ((⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ (da (fv K (suc ∅)) w (scons x r))) ∧ (y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv K ∅) w r) t , a ⟩ ⟩ ⟩))))))))})))) ∨ (((F = kc_app) ∧ (z ∊ (clam w lvals (clam r (fseq B) {y | ∃ a ((⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ (da (fv K ∅) w r)) ∧ (y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv D (fv I (suc ∅))) w r) a ⟩ ⟩ ⟩))})))) ∨ ((¬ (F = kc_pi)) ∧ ((¬ (F = kc_app)) ∧ (z ∊ (clam w lvals (clam r (fseq B) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))))))} $ by cab_congr [l102]

sb_c_etb
--------
l1: $ (⟦ x / t ⟧ {z | (C = kc_pi ∧ z ∊ clam w lvals (clam r (fseq A) {y | ∃ i ∃ f ∃ g ∃ j ∃ a ( i ∊ da (fv B (fv D ∅)) w r ∧ i ∊ A ∧ ⟨ f , ⟨ g , ⟨ j , a ⟩ ⟩ ⟩ ∈ da (fv E (suc ∅)) w (scons i r) ∧ y = ⟨ ssnoc f i , ⟨ scons i g , ⟨ scons (da (fv E ∅) w r) j , a ⟩ ⟩ ⟩)})) ∨ (C = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) {y | ∃ a ( ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv E ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv B (fv D (suc ∅))) w r) a ⟩ ⟩ ⟩)})) ∨ (¬ C = kc_pi ∧ ¬ C = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))}) ≐ {z | ((⟦ x / t ⟧ C) = kc_pi ∧ z ∊ clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) {y | ∃ i ∃ f ∃ g ∃ j ∃ a ( i ∊ da (fv (⟦ x / t ⟧ B) (fv (⟦ x / t ⟧ D) ∅)) w r ∧ i ∊ (⟦ x / t ⟧ A) ∧ ⟨ f , ⟨ g , ⟨ j , a ⟩ ⟩ ⟩ ∈ da (fv (⟦ x / t ⟧ E) (suc ∅)) w (scons i r) ∧ y = ⟨ ssnoc f i , ⟨ scons i g , ⟨ scons (da (fv (⟦ x / t ⟧ E) ∅) w r) j , a ⟩ ⟩ ⟩)})) ∨ ((⟦ x / t ⟧ C) = kc_app ∧ z ∊ clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) {y | ∃ a ( ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv (⟦ x / t ⟧ E) ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (⟦ x / t ⟧ B) (fv (⟦ x / t ⟧ D) (suc ∅))) w r) a ⟩ ⟩ ⟩)})) ∨ (¬ (⟦ x / t ⟧ C) = kc_pi ∧ ¬ (⟦ x / t ⟧ C) = kc_app ∧ z ∊ clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)))} $ by ceqt_refl

etf_congr
---------
l1: $ cv k ≐ cv k $ by ceqt_refl
l2: $ cv j ≐ cv j $ by ceqt_refl
l3: $ cv v ≐ cv v $ by ceqt_refl
l4: $ etb A C k j v ≐ etb B D k j v $ by etb_congr [#1, #2, l1, l2, l3]
l5: $ cgr3 k j v (etb A C k j v) ≐ cgr3 k j v (etb B D k j v) $ by cgr3_congr [l4]
l6: $ ω ≐ ω $ by ceqt_refl
l7: $ trc ω (cgr3 k j v (etb A C k j v)) ≐ trc ω (cgr3 k j v (etb B D k j v)) $ by trc_congr [l6, l5]

sb_c_etf
--------
l1: $ (⟦ x / t ⟧ (trc ω (cgr3 k j v (etb A B k j v)))) ≐ trc ω (cgr3 k j v (etb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) k j v)) $ by ceqt_refl

etel_congr
----------
l1: $ etf A C ≐ etf B D $ by etf_congr [#1, #2]
l2: $ fv (etf A C) E ≐ fv (etf B D) F $ by fv_congr [l1, #3]
l3: $ da (fv (etf A C) E) H J ≐ da (fv (etf B D) F) I K $ by da_congr [l2, #4, #5]

sb_c_etel
---------
l1: $ (⟦ x / t ⟧ (da (fv (etf A B) C) D E)) ≐ da (fv (etf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (⟦ x / t ⟧ C)) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $ by ceqt_refl

esat_dnf
--------
l1: $ esb u (dnf u M) k j v ≐ stb u M k j v $ by ceqt_refl
l2: $ cgr3 k j v (esb u (dnf u M) k j v) ≐ cgr3 k j v (stb u M k j v) $ by cgr3_congr [l1]
l3: $ ω ≐ ω $ by ceqt_refl
l4: $ esf u (dnf u M) ≐ stf u M $ by trc_congr [l3, l2]
l5: $ T ≐ T $ by ceqt_refl
l6: $ fv (esf u (dnf u M)) T ≐ fv (stf u M) T $ by fv_congr [l4, l5]
l7: $ W ≐ W $ by ceqt_refl
l8: $ esat u (dnf u M) T W ≐ sat u M T W $ by ap_congr [l6, l7]

lemma c3_esq_ex {x q: set} (G: hyps) (U U2 M M2 A B D E: class) (w r: set):
  $ G ⇒ A = B $ > $ G ⇒ D = E $ > $ G ⇒ U = U2 $ > $ G ⇒ M = M2 $ >
  $ G ⇒ (∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $
----
p1: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q $ by ax
p2: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ D $ by and_elim_l [p1]
p3: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M A) w q ∧ r = scons x q $ by and_elim_r [p1]
p3a: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M A) w q $ by and_elim_l [p3]
p3b: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ r = scons x q $ by and_elim_r [p3]
p4: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ D = E $ by weaken [#2]
p5: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ E $ by welc_eq [p4, p2]
q1: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ A = B $ by weaken [#1]
q2: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ U = U2 $ by weaken [#3]
q3: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ M = M2 $ by weaken [#4]
q4: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ w = w $ by eq_refl
q5: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q = q $ by eq_refl
q6a: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ fv M A = fv M2 B $ by fv_eq [q3, q1]
q6: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ da (fv M A) w q = da (fv M2 B) w q $ by da_eq [q6a, q4, q5]
q7: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M2 B) w q $ by welc_eq [q6, p3a]
q8: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M2 B) w q ∧ r = scons x q $ by and_intro [q7, p3b]
p6: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q $ by and_intro [p5, q8]
p7: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by ex_intro [p6]
p8: $ G , q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by ex_intro [p7]
p9: $ G , ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by ax
p10: $ G , ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by ex_elim [p9, p8]
p11a: $ G , ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by ax
p11: $ G , ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by ex_elim [p11a, p10]
p12: $ G ⇒ (∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by imp_intro [p11]

lemma c3_esq_eq {r x q: set} (G: hyps) (U U2 M M2 A B D E: class) (w: set):
  $ G ⇒ A = B $ > $ G ⇒ D = E $ > $ G ⇒ U = U2 $ > $ G ⇒ M = M2 $ >
  $ G ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) } = {r | r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) } $
----
a1: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by ax
a2: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ r ∊ fseq U $ by and_elim_l [a1]
a3: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by and_elim_r [a1]
a4: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ U = U2 $ by weaken [#3]
a4b: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ r ∊ fseq U2 $ by welc_fseq_eq [a4, a2]
a5a: $ G ⇒ (∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by c3_esq_ex [#1, #2, #3, #4]
a5b: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ (∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by weaken [a5a]
a5: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by imp_elim [a5b, a3]
a6: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by and_intro [a4b, a5]
b1: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) ⇒ r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by ax
b2: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) ⇒ r ∊ fseq U2 $ by and_elim_l [b1]
b3: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) $ by and_elim_r [b1]
b4a: $ G ⇒ B = A $ by eq_sym [#1]
b4b: $ G ⇒ E = D $ by eq_sym [#2]
b4c: $ G ⇒ U2 = U $ by eq_sym [#3]
b4d: $ G ⇒ M2 = M $ by eq_sym [#4]
b4e: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) ⇒ U2 = U $ by weaken [b4c]
b4f: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) ⇒ r ∊ fseq U $ by welc_fseq_eq [b4e, b2]
b5a: $ G ⇒ (∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by c3_esq_ex [b4a, b4b, b4c, b4d]
b5b: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) ⇒ (∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by weaken [b5a]
b5: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by imp_elim [b5b, b3]
b6: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) ⇒ r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by and_intro [b4f, b5]
c1: $ G ⇒ (r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) ↔ (r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q)) $ by bi_intro [a6, b6]
c2: $ G ⇒ ∀ r ((r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) ↔ (r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q))) $ by all_intro [c1]
c3: $ G ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ da (fv M A) w q ∧ r = scons x q) } = {r | r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ da (fv M2 B) w q ∧ r = scons x q) } $ by cab_eq [c2]

esb_eq
------
e1: $ G , w ∊ lvals ⇒ J = K $ by weaken [#5]
e2: $ G , w ∊ lvals ⇒ suc ∅ = suc ∅ $ by eq_refl
e3: $ G , w ∊ lvals ⇒ fv J (suc ∅) = fv K (suc ∅) $ by fv_eq [e1, e2]
e4: $ G , w ∊ lvals ⇒ w = w $ by eq_refl
e5: $ G , w ∊ lvals ⇒ ap (fv J (suc ∅)) w = ap (fv K (suc ∅)) w $ by ap_eq [e3, e4]
e5a: $ G , w ∊ lvals ⇒ H = I $ by weaken [#4]
e5b: $ G , w ∊ lvals ⇒ ∅ = ∅ $ by eq_refl
e5c: $ G , w ∊ lvals ⇒ fv H ∅ = fv I ∅ $ by fv_eq [e5a, e5b]
e5d: $ G , w ∊ lvals ⇒ A = B $ by weaken [#1]
e5e: $ G , w ∊ lvals ⇒ C = D $ by weaken [#2]
e6: $ G , w ∊ lvals ⇒ {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) } = {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) } $ by c3_esq_eq [e5c, e5, e5d, e5e]
e7: $ G ⇒ w ∊ lvals → {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) } = {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) } $ by imp_intro [e6]
e8: $ G ⇒ ∀ w (w ∊ lvals → {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) } = {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) }) $ by all_intro [e7]
e9: $ G ⇒ lvals = lvals $ by eq_refl
e10: $ G ⇒ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) } = clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ da (fv D (fv I ∅)) w q ∧ r = scons x q) } $ by clam_eq_pt [e9, e8]
f1: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ da (fv C (fv H ∅)) w q ∧ r = scons x q) }) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) $ by ax
