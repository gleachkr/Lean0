x6: $ (∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt E q e ∧ p ∊ esat A C q L ∧ ictk E H J k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k L (scat p (ixs E L (ifam A C E L))) ∧ y ∊ scons J g ∧ z = nest (scat f p) y)) ⟺ (∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt F q e ∧ p ∊ esat B D q N ∧ ictk F I K k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k N (scat p (ixs F N (ifam B D F N))) ∧ y ∊ scons K g ∧ z = nest (scat f p) y)) $ by ex_congr [x5]
x7: $ (∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt E q e ∧ p ∊ esat A C q L ∧ ictk E H J k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k L (scat p (ixs E L (ifam A C E L))) ∧ y ∊ scons J g ∧ z = nest (scat f p) y)) ⟺ (∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt F q e ∧ p ∊ esat B D q N ∧ ictk F I K k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k N (scat p (ixs F N (ifam B D F N))) ∧ y ∊ scons K g ∧ z = nest (scat f p) y)) $ by ex_congr [x6]
x8: $ (∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt E q e ∧ p ∊ esat A C q L ∧ ictk E H J k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k L (scat p (ixs E L (ifam A C E L))) ∧ y ∊ scons J g ∧ z = nest (scat f p) y)) ⟺ (∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt F q e ∧ p ∊ esat B D q N ∧ ictk F I K k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k N (scat p (ixs F N (ifam B D F N))) ∧ y ∊ scons K g ∧ z = nest (scat f p) y)) $ by ex_congr [x7]
x9: $ (∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt E q e ∧ p ∊ esat A C q L ∧ ictk E H J k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k L (scat p (ixs E L (ifam A C E L))) ∧ y ∊ scons J g ∧ z = nest (scat f p) y)) ⟺ (∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt F q e ∧ p ∊ esat B D q N ∧ ictk F I K k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k N (scat p (ixs F N (ifam B D F N))) ∧ y ∊ scons K g ∧ z = nest (scat f p) y)) $ by ex_congr [x8]
y1: $ (¬ iprop E H L ∧ ∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt E q e ∧ p ∊ esat A C q L ∧ ictk E H J k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k L (scat p (ixs E L (ifam A C E L))) ∧ y ∊ scons J g ∧ z = nest (scat f p) y)) ⟺ (¬ iprop F I N ∧ ∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt F q e ∧ p ∊ esat B D q N ∧ ictk F I K k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k N (scat p (ixs F N (ifam B D F N))) ∧ y ∊ scons K g ∧ z = nest (scat f p) y)) $ by and_congr [m1, x9]
y2: $ ({z | ¬ iprop E H L ∧ ∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt E q e ∧ p ∊ esat A C q L ∧ ictk E H J k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel A C k L (scat p (ixs E L (ifam A C E L))) ∧ y ∊ scons J g ∧ z = nest (scat f p) y)}) ≐ ({z | ¬ iprop F I N ∧ ∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ t ∃ a ∃ y (iprt F q e ∧ p ∊ esat B D q N ∧ ictk F I K k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel B D k N (scat p (ixs F N (ifam B D F N))) ∧ y ∊ scons K g ∧ z = nest (scat f p) y)}) $ by cab_congr [y1]

sb_c_ictor
----------
l1: $ (⟦ x / t ⟧ ({z | ¬ iprop C D F ∧ ∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ d ∃ a ∃ y (iprt C q e ∧ p ∊ esat A B q F ∧ ictk C D E k ∧ ⟨ f , ⟨ g , ⟨ d , a ⟩ ⟩ ⟩ ∈ etel A B k F (scat p (ixs C F (ifam A B C F))) ∧ y ∊ scons E g ∧ z = nest (scat f p) y)})) ≐ ({z | ¬ iprop (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ F) ∧ ∃ p ∃ q ∃ e ∃ k ∃ f ∃ g ∃ d ∃ a ∃ y (iprt (⟦ x / t ⟧ C) q e ∧ p ∊ esat (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) q (⟦ x / t ⟧ F) ∧ ictk (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) k ∧ ⟨ f , ⟨ g , ⟨ d , a ⟩ ⟩ ⟩ ∈ etel (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) k (⟦ x / t ⟧ F) (scat p (ixs (⟦ x / t ⟧ C) (⟦ x / t ⟧ F) (ifam (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ F)))) ∧ y ∊ scons (⟦ x / t ⟧ E) g ∧ z = nest (scat f p) y)}) $ by ceqt_refl

ient_intro
----------
l1: $ G ⇒ isset (nest a x) $ by nest_set
l2: $ G , z = nest a x ⇒ z = nest a x $ by ax
l3: $ G , z = nest a x ⇒ ¬ iprop D j W $ by weaken [#2]
l4: $ G , z = nest a x ⇒ ¬ iprop D j W ∧ z = nest a x $ by and_intro [l3, l2]
l5: $ G , z = nest a x ⇒ (iprop D j W ∧ z = nest a ∅) ∨ (¬ iprop D j W ∧ z = nest a x) $ by or_intro_r [l4]
l6: $ G , z = nest a x ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z $ by weaken [#1]
l7: $ G , z = nest a x ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ z = nest a ∅) ∨ (¬ iprop D j W ∧ z = nest a x)) $ by and_intro [l6, l5]
l8: $ G , z = nest a x ⇒ ∃ v (⟨ j , ⟨ a , v ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ z = nest a ∅) ∨ (¬ iprop D j W ∧ z = nest a v))) $ by ex_intro [l7]
l9: $ G , z = nest a x ⇒ ∃ b ∃ v (⟨ j , ⟨ b , v ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ z = nest b ∅) ∨ (¬ iprop D j W ∧ z = nest b v))) $ by ex_intro [l8]
l10: $ G ⇒ nest a x ∈ {y | ∃ b ∃ v (⟨ j , ⟨ b , v ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest b ∅) ∨ (¬ iprop D j W ∧ y = nest b v)))} $ by wcel_cab_intro [l1, l9]

ient_intro_prop
---------------
l1: $ G ⇒ isset (nest a ∅) $ by nest_set
l2: $ G , z = nest a ∅ ⇒ z = nest a ∅ $ by ax
l3: $ G , z = nest a ∅ ⇒ iprop D j W $ by weaken [#2]
l4: $ G , z = nest a ∅ ⇒ iprop D j W ∧ z = nest a ∅ $ by and_intro [l3, l2]
l5: $ G , z = nest a ∅ ⇒ (iprop D j W ∧ z = nest a ∅) ∨ (¬ iprop D j W ∧ z = nest a x) $ by or_intro_l [l4]
l6: $ G , z = nest a ∅ ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z $ by weaken [#1]
l7: $ G , z = nest a ∅ ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ z = nest a ∅) ∨ (¬ iprop D j W ∧ z = nest a x)) $ by and_intro [l6, l5]
l8: $ G , z = nest a ∅ ⇒ ∃ v (⟨ j , ⟨ a , v ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ z = nest a ∅) ∨ (¬ iprop D j W ∧ z = nest a v))) $ by ex_intro [l7]
l9: $ G , z = nest a ∅ ⇒ ∃ b ∃ v (⟨ j , ⟨ b , v ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ z = nest b ∅) ∨ (¬ iprop D j W ∧ z = nest b v))) $ by ex_intro [l8]
l10: $ G ⇒ nest a ∅ ∈ {y | ∃ b ∃ v (⟨ j , ⟨ b , v ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest b ∅) ∨ (¬ iprop D j W ∧ y = nest b v)))} $ by wcel_cab_intro [l1, l9]

ient_mono
---------
l1: $ G , y ∊ ient D W Z j ⇒ y ∊ ient D W Z j $ by ax
l2: $ G , y ∊ ient D W Z j ⇒ ∃ a ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) $ by cab_elim [l1]
l3: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) $ by ax
l4: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z $ by and_elim_l [l3]
l5: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) $ by and_elim_r [l3]
l6: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ Z ⊆ Z2 $ by weaken [#1]
l7: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z2 $ by wcel_subset [l6, l4]
l8: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) $ by and_intro [l7, l5]
l9: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) $ by ex_intro [l8]
l10: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ∃ a ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) $ by ex_intro [l9]
l11: $ G , y ∊ ient D W Z j , ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) ⇒ ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) $ by ax
l12: $ G , y ∊ ient D W Z j , ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) ⇒ ∃ a ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) $ by ex_elim [l11, l10]
l13: $ G , y ∊ ient D W Z j ⇒ ∃ a ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) $ by ex_elim [l2, l12]
l14: $ G , y ∊ ient D W Z j ⇒ y ∊ ient D W Z2 j $ by cab_intro [l13]
l15: $ G ⇒ ient D W Z j ⊆ ient D W Z2 j $ by subset_intro [l14]

--| A restriction of a function on a natural number into `A` is a sequence over `A`.
--| The block's types valued by a candidate, as the graph of the entries restricted to the types.
lemma c5_ixs_cres {j: set} (G: hyps) (D W Z: class) (u: set):
  $ G ⇒ ∀ j (j ∊ intys D → ient D W Z j ∈ u) $ > $ G ⇒ cres (cgr j (ient D W Z j)) (intys D) = ixs D W Z $
----
f1: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) ⇒ v ∊ cres (cgr j (ient D W Z j)) (intys D) $ by ax
f2: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) ⇒ ∃ a ∃ b (v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j)) $ by cab_elim [f1]
f3: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) $ by ax
f4: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ v = ⟨ a , b ⟩ $ by and_elim_l [f3]
f5: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) $ by and_elim_r [f3]
f6: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ a ∊ intys D $ by and_elim_l [f5]
f7: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) $ by and_elim_r [f5]
f8: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ b = ient D W Z a $ by cgr_elim [f7]
f9: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ a = a $ by eq_refl
f10: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ ⟨ a , b ⟩ = ⟨ a , ient D W Z a ⟩ $ by opair_eq [f9, f8]
f11: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ v = ⟨ a , ient D W Z a ⟩ $ by eq_trans [f4, f10]
f12: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ $ by and_intro [f6, f11]
f13: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) ⇒ ∃ i (i ∊ intys D ∧ v = ⟨ i , ient D W Z i ⟩) $ by ex_intro [f12]
f14: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , ∃ b (v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j)) ⇒ ∃ b (v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j)) $ by ax
f15: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) , ∃ b (v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j)) ⇒ ∃ i (i ∊ intys D ∧ v = ⟨ i , ient D W Z i ⟩) $ by ex_elim [f14, f13]
f16: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) ⇒ ∃ i (i ∊ intys D ∧ v = ⟨ i , ient D W Z i ⟩) $ by ex_elim [f2, f15]
f17: $ G , v ∊ cres (cgr j (ient D W Z j)) (intys D) ⇒ v ∊ ixs D W Z $ by cab_intro [f16]
f18: $ G ⇒ cres (cgr j (ient D W Z j)) (intys D) ⊆ ixs D W Z $ by subset_intro [f17]
g0: $ G , v ∊ ixs D W Z ⇒ v ∊ ixs D W Z $ by ax
g1: $ G , v ∊ ixs D W Z ⇒ ∃ a (a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩) $ by cab_elim [g0]
g2: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ ⇒ a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ $ by ax
g3: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ ⇒ a ∊ intys D $ by and_elim_l [g2]
g4: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ ⇒ v = ⟨ a , ient D W Z a ⟩ $ by and_elim_r [g2]
g5: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ ⇒ ∀ j (j ∊ intys D → ient D W Z j ∈ u) $ by weaken [#1]
g6: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ ⇒ a ∊ intys D → ient D W Z a ∈ u $ by all_elim [g5]
g7: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ ⇒ ient D W Z a ∈ u $ by imp_elim [g6, g3]
g8: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ ⇒ isset (ient D W Z a) $ by wcel_isset [g7]
h1: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ b = ient D W Z a $ by ax
h2: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) $ by cgr_intro [h1]
h3: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ a ∊ intys D $ by weaken [g3]
h4: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ a = a $ by eq_refl
h5: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ ient D W Z a = b $ by eq_sym [h1]
h6: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ ⟨ a , ient D W Z a ⟩ = ⟨ a , b ⟩ $ by opair_eq [h4, h5]
h7: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ v = ⟨ a , ient D W Z a ⟩ $ by weaken [g4]
h8: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ v = ⟨ a , b ⟩ $ by eq_trans [h7, h6]
h9: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) $ by and_intro [h3, h2]
h10: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ v = ⟨ a , b ⟩ ∧ a ∊ intys D ∧ ⟨ a , b ⟩ ∈ cgr j (ient D W Z j) $ by and_intro [h8, h9]
h11: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ ∃ y (v = ⟨ a , y ⟩ ∧ a ∊ intys D ∧ ⟨ a , y ⟩ ∈ cgr j (ient D W Z j)) $ by ex_intro [h10]
h12: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ ∃ x ∃ y (v = ⟨ x , y ⟩ ∧ x ∊ intys D ∧ ⟨ x , y ⟩ ∈ cgr j (ient D W Z j)) $ by ex_intro [h11]
h13: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ , b = ient D W Z a ⇒ v ∊ cres (cgr j (ient D W Z j)) (intys D) $ by cab_intro [h12]
h14: $ G , v ∊ ixs D W Z , a ∊ intys D ∧ v = ⟨ a , ient D W Z a ⟩ ⇒ v ∊ cres (cgr j (ient D W Z j)) (intys D) $ by isset_elim [g8, h13]
h15: $ G , v ∊ ixs D W Z ⇒ v ∊ cres (cgr j (ient D W Z j)) (intys D) $ by ex_elim [g1, h14]
h16: $ G ⇒ ixs D W Z ⊆ cres (cgr j (ient D W Z j)) (intys D) $ by subset_intro [h15]
h17: $ G ⇒ cres (cgr j (ient D W Z j)) (intys D) = ixs D W Z $ by subset_antisym [f18, h16]

ixs_fseq
--------
e1: $ G ⇒ fn_into (cgr j (ient D W Z j)) (intys D) u $ by cgr_fn_into [#1]
e2: $ G ⇒ cres (cgr j (ient D W Z j)) (intys D) ∈ fseq u $ by cres_fseq [#2, e1]
e3: $ G ⇒ cres (cgr j (ient D W Z j)) (intys D) = ixs D W Z $ by c5_ixs_cres [#1]
e4: $ G ⇒ ixs D W Z ∈ fseq u $ by wcel_eq_l [e3, e2]

--| The map from a candidate's elements `⟨ i , ⟨ a , x ⟩ ⟩` to the pair of the two possible entries.
def c5_pf (.i .a .x .q: set): class = $ {q | ∃ i ∃ a ∃ x (q = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩)} $

lemma c5_pf_intro (G: hyps) (i a x: set): $ G ⇒ ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ∈ c5_pf $
----
l1: $ G ⇒ isset ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ $ by opair_isset
l2: $ G , o = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ o = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ $ by ax
l3: $ G , o = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ ∃ e (o = ⟨ ⟨ i , ⟨ a , e ⟩ ⟩ , cpr (nest a ∅) (nest a e) ⟩) $ by ex_intro [l2]
l4: $ G , o = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ ∃ d ∃ e (o = ⟨ ⟨ i , ⟨ d , e ⟩ ⟩ , cpr (nest d ∅) (nest d e) ⟩) $ by ex_intro [l3]
l5: $ G , o = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ ∃ k ∃ d ∃ e (o = ⟨ ⟨ k , ⟨ d , e ⟩ ⟩ , cpr (nest d ∅) (nest d e) ⟩) $ by ex_intro [l4]
l6: $ G ⇒ ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ∈ {q | ∃ k ∃ d ∃ e (q = ⟨ ⟨ k , ⟨ d , e ⟩ ⟩ , cpr (nest d ∅) (nest d e) ⟩)} $ by wcel_cab_intro [l1, l5]
l7: $ G ⇒ ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ∈ c5_pf $ by weaken [l6]

lemma c5_pf_elim {k d e: set} (G: hyps) (w b: set):
  $ G ⇒ ⟨ w , b ⟩ ∈ c5_pf $ > $ G ⇒ ∃ k ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $
----
k1: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf ⇒ v ∊ c5_pf $ by ax
k2: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf ⇒ ∃ i ∃ a ∃ x (v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩) $ by cab_elim [k1]
k3: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ $ by ax
k4: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ v = ⟨ w , b ⟩ $ by ax
k5: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ ⟨ w , b ⟩ = v $ by eq_sym [k4]
k6: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ ⟨ w , b ⟩ = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ $ by eq_trans [k5, k3]
k7: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ isset w $ by isset_var
k8: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ isset b $ by isset_var
k9: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ isset ⟨ i , ⟨ a , x ⟩ ⟩ $ by opair_isset
k10: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ isset (cpr (nest a ∅) (nest a x)) $ by cpr_isset
k11: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ w = ⟨ i , ⟨ a , x ⟩ ⟩ ∧ b = cpr (nest a ∅) (nest a x) $ by opair_inj_c [k6, k7, k8, k9, k10]
k12: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ ∃ e (w = ⟨ i , ⟨ a , e ⟩ ⟩ ∧ b = cpr (nest a ∅) (nest a e)) $ by ex_intro [k11]
k13: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ ∃ d ∃ e (w = ⟨ i , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by ex_intro [k12]
k14: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ⇒ ∃ k ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by ex_intro [k13]
k15: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , ∃ x (v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩) ⇒ ∃ x (v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩) $ by ax
k16: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , ∃ x (v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩) ⇒ ∃ k ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by ex_elim [k15, k14]
k17: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , ∃ a ∃ x (v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩) ⇒ ∃ a ∃ x (v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩) $ by ax
k18: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf , ∃ a ∃ x (v = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩) ⇒ ∃ k ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by ex_elim [k17, k16]
k19: $ G , v = ⟨ w , b ⟩ , v ∊ c5_pf ⇒ ∃ k ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by ex_elim [k2, k18]
k20: $ G ⇒ ∃ k ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by wcel_elim [#1, k19]

lemma c5_pf_functional (G: hyps): $ G ⇒ functional c5_pf $
----
m1: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf ⇒ ⟨ w , b ⟩ ∈ c5_pf $ by ax
m2: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf ⇒ ⟨ w , c ⟩ ∈ c5_pf $ by ax
m3: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf ⇒ ∃ k ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by c5_pf_elim [m1]
m4: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf ⇒ ∃ f ∃ g ∃ h (w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h)) $ by c5_pf_elim [m2]
n1: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) $ by ax
n2: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) $ by ax
n3: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ w = ⟨ k , ⟨ d , e ⟩ ⟩ $ by and_elim_l [n1]
n4: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ b = cpr (nest d ∅) (nest d e) $ by and_elim_r [n1]
n5: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ w = ⟨ f , ⟨ g , h ⟩ ⟩ $ by and_elim_l [n2]
n6: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ c = cpr (nest g ∅) (nest g h) $ by and_elim_r [n2]
n7: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ ⟨ k , ⟨ d , e ⟩ ⟩ = w $ by eq_sym [n3]
n8: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ ⟨ k , ⟨ d , e ⟩ ⟩ = ⟨ f , ⟨ g , h ⟩ ⟩ $ by eq_trans [n7, n5]
n9: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ isset k $ by isset_var
n10: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ isset ⟨ d , e ⟩ $ by opair_isset
n11: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ isset f $ by isset_var
n12: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ isset ⟨ g , h ⟩ $ by opair_isset
n13: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ k = f ∧ ⟨ d , e ⟩ = ⟨ g , h ⟩ $ by opair_inj_c [n8, n9, n10, n11, n12]
n14: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ ⟨ d , e ⟩ = ⟨ g , h ⟩ $ by and_elim_r [n13]
n15: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ d = g $ by opair_inj_l [n14]
n16: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ e = h $ by opair_inj_r [n14]
n17: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ ∅ = ∅ $ by eq_refl
n18: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ nest d ∅ = nest g ∅ $ by nest_eq [n15, n17]
n19: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ nest d e = nest g h $ by nest_eq [n15, n16]
n20: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ cpr (nest d ∅) (nest d e) = cpr (nest g ∅) (nest g h) $ by cpr_eq [n18, n19]
n21: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ b = cpr (nest g ∅) (nest g h) $ by eq_trans [n4, n20]
n22: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ cpr (nest g ∅) (nest g h) = c $ by eq_sym [n6]
n23: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h) ⇒ b = c $ by eq_trans [n21, n22]
o1: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , ∃ h (w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h)) ⇒ ∃ h (w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h)) $ by ax
o2: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , ∃ h (w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h)) ⇒ b = c $ by ex_elim [o1, n23]
o3: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , ∃ g ∃ h (w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h)) ⇒ ∃ g ∃ h (w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h)) $ by ax
o4: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) , ∃ g ∃ h (w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h)) ⇒ b = c $ by ex_elim [o3, o2]
o5: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) ⇒ ∃ f ∃ g ∃ h (w = ⟨ f , ⟨ g , h ⟩ ⟩ ∧ c = cpr (nest g ∅) (nest g h)) $ by weaken [m4]
o6: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e) ⇒ b = c $ by ex_elim [o5, o4]
o7: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) ⇒ ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by ax
o8: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) ⇒ b = c $ by ex_elim [o7, o6]
o9: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) ⇒ ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) $ by ax
o10: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf , ∃ d ∃ e (w = ⟨ k , ⟨ d , e ⟩ ⟩ ∧ b = cpr (nest d ∅) (nest d e)) ⇒ b = c $ by ex_elim [o9, o8]
o11: $ G , ⟨ w , b ⟩ ∈ c5_pf , ⟨ w , c ⟩ ∈ c5_pf ⇒ b = c $ by ex_elim [m3, o10]
o12: $ G ⇒ functional c5_pf $ by functional_intro [o11]

--| The second component of a pair in a universe is in it.
lemma c5_nest_empty_univ (G: hyps) (U: class) (s b: set): $ G ⇒ universe U $ > $ G ⇒ s ∊ fseq U $ > $ G ⇒ b ∊ U $ > $ G ⇒ nest s ∅ ∈ U $
----
u1: $ G ⇒ ∅ ∈ U $ by universe_empty [#1, #3]
u2: $ G , e = ∅ , e ∊ U ⇒ e ∊ U $ by ax
u3: $ G , e = ∅ , e ∊ U ⇒ universe U $ by weaken [#1]
u4: $ G , e = ∅ , e ∊ U ⇒ s ∊ fseq U $ by weaken [#2]
u5: $ G , e = ∅ , e ∊ U ⇒ nest s e ∈ U $ by nest_universe [u3, u4, u2]
u6: $ G , e = ∅ , e ∊ U ⇒ e = ∅ $ by ax
u7: $ G , e = ∅ , e ∊ U ⇒ s = s $ by eq_refl
u8: $ G , e = ∅ , e ∊ U ⇒ nest s e = nest s ∅ $ by nest_eq [u7, u6]
u9: $ G , e = ∅ , e ∊ U ⇒ nest s ∅ ∈ U $ by wcel_eq_l [u8, u5]
u10: $ G ⇒ nest s ∅ ∈ U $ by wcel_elim [u1, u9]

lemma c5_pf_fn_into (G: hyps) (U: class) (m: set):
  $ G ⇒ universe U $ > $ G ⇒ m ∊ U $ > $ G ⇒ m ⊆ ω × (fseq U × fseq (ω ∪ U)) $ > $ G ⇒ fn_into c5_pf m U $
----
p1: $ G , w ∊ m ⇒ w ∊ m $ by ax
p2: $ G , w ∊ m ⇒ m ⊆ ω × (fseq U × fseq (ω ∪ U)) $ by weaken [#3]
p3: $ G , w ∊ m ⇒ w ∊ ω × (fseq U × fseq (ω ∪ U)) $ by subset_elim [p2, p1]
q0: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) ⇒ p ∊ fseq U × fseq (ω ∪ U) $ by ax
r1: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ universe U $ by weaken [#1]
r2: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ m ∊ U $ by weaken [#2]
r3: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ w ∊ m $ by ax
r4: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ w ∊ U $ by universe_elem_elem [r1, r2, r3]
r5: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ w = ⟨ i , p ⟩ $ by ax
r6: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ ⟨ i , p ⟩ ∈ U $ by wcel_intro [r5, r4]
r7: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ p ∊ U $ by universe_opair_r [r1, r6]
r8: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ p = ⟨ a , x ⟩ $ by ax
r9: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ ⟨ a , x ⟩ ∈ U $ by wcel_intro [r8, r7]
r10: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ x ∊ U $ by universe_opair_r [r1, r9]
r11: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ a ∊ fseq U $ by ax
r12: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ nest a x ∈ U $ by nest_universe [r1, r11, r10]
r13: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ nest a ∅ ∈ U $ by c5_nest_empty_univ [r1, r11, r10]
r14: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ cpr (nest a ∅) (nest a x) ∈ U $ by universe_cpr_c [r1, r13, r12]
s1: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ v ∊ U $ by ax
s2: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ∈ c5_pf $ by c5_pf_intro
s3: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ i = i $ by eq_refl
s4: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ p = ⟨ a , x ⟩ $ by ax
s5: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ ⟨ i , p ⟩ = ⟨ i , ⟨ a , x ⟩ ⟩ $ by opair_eq [s3, s4]
s6: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ w = ⟨ i , p ⟩ $ by ax
s7: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ w = ⟨ i , ⟨ a , x ⟩ ⟩ $ by eq_trans [s6, s5]
s8: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ v = cpr (nest a ∅) (nest a x) $ by ax
s9: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ ⟨ w , v ⟩ = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ $ by opair_eq [s7, s8]
s10: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ = ⟨ w , v ⟩ $ by eq_sym [s9]
s11: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ ⟨ w , v ⟩ ∈ c5_pf $ by wcel_eq_l [s10, s2]
s12: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ v ∊ U ∧ ⟨ w , v ⟩ ∈ c5_pf $ by and_intro [s1, s11]
s13: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) , v = cpr (nest a ∅) (nest a x) , v ∊ U ⇒ ∃ y (y ∊ U ∧ ⟨ w , y ⟩ ∈ c5_pf) $ by ex_intro [s12]
r15: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) , p = ⟨ a , x ⟩ , a ∊ fseq U , x ∊ fseq (ω ∪ U) ⇒ ∃ y (y ∊ U ∧ ⟨ w , y ⟩ ∈ c5_pf) $ by wcel_elim [r14, s13]
q1: $ G , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ fseq U × fseq (ω ∪ U) ⇒ ∃ y (y ∊ U ∧ ⟨ w , y ⟩ ∈ c5_pf) $ by cxp_elim [q0, r15]
p4: $ G , w ∊ m ⇒ ∃ y (y ∊ U ∧ ⟨ w , y ⟩ ∈ c5_pf) $ by cxp_elim [p3, q1]
p5: $ G ⇒ functional c5_pf $ by c5_pf_functional
p6: $ G ⇒ fn_into c5_pf m U $ by fn_into_intro [p5, p4]

lemma c5_ient_sub (G: hyps) (D W Z j V: class) (m: set):
  $ G ⇒ Z ⊆ m $ > $ G ⇒ Z ⊆ ω × V $ > $ G ⇒ ient D W Z j ⊆ ⋃ (img c5_pf m) $
----
w1: $ G , y ∊ ient D W Z j ⇒ y ∊ ient D W Z j $ by ax
w2: $ G , y ∊ ient D W Z j ⇒ ∃ a ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) $ by cab_elim [w1]
x1: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) $ by ax
x2: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z $ by and_elim_l [x1]
x3: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) $ by and_elim_r [x1]
x4: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ Z ⊆ m $ by weaken [#1]
x5: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ m $ by wcel_subset [x4, x2]
x6: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ Z ⊆ ω × V $ by weaken [#2]
x7: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ω × V $ by wcel_subset [x6, x2]
c1: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , iprop D j W ∧ y = nest a ∅ ⇒ iprop D j W ∧ y = nest a ∅ $ by ax
c2: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , iprop D j W ∧ y = nest a ∅ ⇒ y = nest a ∅ $ by and_elim_r [c1]
c3: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , iprop D j W ∧ y = nest a ∅ ⇒ y = nest a ∅ ∨ y = nest a x $ by or_intro_l [c2]
d1: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , ¬ iprop D j W ∧ y = nest a x ⇒ ¬ iprop D j W ∧ y = nest a x $ by ax
d2: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , ¬ iprop D j W ∧ y = nest a x ⇒ y = nest a x $ by and_elim_r [d1]
d3: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , ¬ iprop D j W ∧ y = nest a x ⇒ y = nest a ∅ ∨ y = nest a x $ by or_intro_r [d2]
e1: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ y = nest a ∅ ∨ y = nest a x $ by or_elim [x3, c3, d3]
e2: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ y ∊ cpr (nest a ∅) (nest a x) $ by cpr_intro [e1]
f1: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m ⇒ w = ⟨ j , ⟨ a , x ⟩ ⟩ $ by ax
f2: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = w $ by eq_sym [f1]
f3: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ω × V $ by weaken [x7]
f4: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m ⇒ w ∈ ω × V $ by wcel_eq_l [f2, f3]
f5: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m ⇒ w ∊ ω × V $ by wcel_welc [f4]
g1: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ w = ⟨ i , p ⟩ $ by ax
g2: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = w $ by weaken [f2]
g3: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = ⟨ i , p ⟩ $ by eq_trans [g2, g1]
g4: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ isset j $ by opair_eq_isset [g3]
g5: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ isset ⟨ a , x ⟩ $ by opair_isset
g6: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ isset i $ by isset_var
g7: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ isset p $ by isset_var
g8: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ j = i ∧ ⟨ a , x ⟩ = p $ by opair_inj_c [g3, g4, g5, g6, g7]
g9: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ ⟨ a , x ⟩ = p $ by and_elim_r [g8]
g10: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ p = ⟨ a , x ⟩ $ by eq_sym [g9]
g11: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ i = i $ by eq_refl
g12: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ ⟨ i , p ⟩ = ⟨ i , ⟨ a , x ⟩ ⟩ $ by opair_eq [g11, g10]
g13: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ w = ⟨ i , ⟨ a , x ⟩ ⟩ $ by eq_trans [g1, g12]
g14: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ∈ c5_pf $ by c5_pf_intro
g15: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ isset (cpr (nest a ∅) (nest a x)) $ by cpr_isset
h1: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ c = cpr (nest a ∅) (nest a x) $ by ax
h2: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ w = ⟨ i , ⟨ a , x ⟩ ⟩ $ by weaken [g13]
h3: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ ⟨ w , c ⟩ = ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ $ by opair_eq [h2, h1]
h4: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ = ⟨ w , c ⟩ $ by eq_sym [h3]
h5: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ ⟨ ⟨ i , ⟨ a , x ⟩ ⟩ , cpr (nest a ∅) (nest a x) ⟩ ∈ c5_pf $ by weaken [g14]
h6: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ ⟨ w , c ⟩ ∈ c5_pf $ by wcel_eq_l [h4, h5]
h7: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ w ∊ m $ by ax
h8: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ c ∊ img c5_pf m $ by img_intro [h7, h6]
h9: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ cpr (nest a ∅) (nest a x) = c $ by eq_sym [h1]
h10: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ y ∊ cpr (nest a ∅) (nest a x) $ by weaken [e2]
h11: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ y ∊ c $ by welc_eq [h9, h10]
h12: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V , c = cpr (nest a ∅) (nest a x) ⇒ y ∊ ⋃ (img c5_pf m) $ by cuni_intro [h11, h8]
i1: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m , w = ⟨ i , p ⟩ , i ∊ ω , p ∊ V ⇒ y ∊ ⋃ (img c5_pf m) $ by isset_elim [g15, h12]
i2: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) , w = ⟨ j , ⟨ a , x ⟩ ⟩ , w ∊ m ⇒ y ∊ ⋃ (img c5_pf m) $ by cxp_elim [f5, i1]
i3: $ G , y ∊ ient D W Z j , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x)) ⇒ y ∊ ⋃ (img c5_pf m) $ by wcel_elim [x5, i2]
i4: $ G , y ∊ ient D W Z j , ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) ⇒ ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) $ by ax
i5: $ G , y ∊ ient D W Z j , ∃ x (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D j W ∧ y = nest a ∅) ∨ (¬ iprop D j W ∧ y = nest a x))) ⇒ y ∊ ⋃ (img c5_pf m) $ by ex_elim [i4, i3]
i6: $ G , y ∊ ient D W Z j ⇒ y ∊ ⋃ (img c5_pf m) $ by ex_elim [w2, i5]
i7: $ G ⇒ ient D W Z j ⊆ ⋃ (img c5_pf m) $ by subset_intro [i6]

ient_universe
-------------
v1: $ G , z = Z , z ∊ u ⇒ z = Z $ by ax
v2: $ G , z = Z , z ∊ u ⇒ Z = z $ by eq_sym [v1]
v3: $ G , z = Z , z ∊ u ⇒ z ⊆ Z $ by eq_subset [v1]
v4: $ G , z = Z , z ∊ u ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by weaken [#3]
v5: $ G , z = Z , z ∊ u ⇒ z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by subset_trans [v3, v4]
v6: $ G , z = Z , z ∊ u ⇒ universe u $ by weaken [#1]
v7: $ G , z = Z , z ∊ u ⇒ z ∊ u $ by ax
v8: $ G , z = Z , z ∊ u ⇒ fn_into c5_pf z u $ by c5_pf_fn_into [v6, v7, v5]
v9: $ G , z = Z , z ∊ u ⇒ img c5_pf z ∈ u $ by universe_img_fn_c [v6, v7, v8]
v10: $ G , z = Z , z ∊ u ⇒ ⋃ (img c5_pf z) ∈ u $ by universe_cuni_c [v6, v9]
v11: $ G , z = Z , z ∊ u ⇒ Z ⊆ z $ by eq_subset [v2]
v12: $ G , z = Z , z ∊ u ⇒ ient D W Z j ⊆ ⋃ (img c5_pf z) $ by c5_ient_sub [v11, v4]
v13: $ G , z = Z , z ∊ u ⇒ ient D W Z j ∈ u $ by universe_subset_c [v6, v10, v12]
v14: $ G ⇒ ient D W Z j ∈ u $ by wcel_elim [#2, v13]

lemma t0_ient_sub (G: hyps) (D D2 W W2 Z Z2 J J2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ Z = Z2 $ > $ G ⇒ J = J2 $ >
  $ G ⇒ ient D W Z J ⊆ ient D2 W2 Z2 J2 $
----
s0: $ G , v ∊ ient D W Z J ⇒ v ∊ ient D W Z J $ by ax
s1: $ G , v ∊ ient D W Z J ⇒ ∃ a ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x))) $ by cab_elim [s0]
s2: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) $ by ax
s3: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z $ by and_elim_l [s2]
s4: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) $ by and_elim_r [s2]
s5: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ D = D2 $ by weaken [#1]
s6: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ W = W2 $ by weaken [#2]
s7: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ Z = Z2 $ by weaken [#3]
s8: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ J = J2 $ by weaken [#4]
s9: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ D2 = D $ by eq_sym [s5]
s10: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ W2 = W $ by eq_sym [s6]
s11: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ Z2 = Z $ by eq_sym [s7]
s12: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ J2 = J $ by eq_sym [s8]
s13: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ⟨ a , x ⟩ = ⟨ a , x ⟩ $ by eq_refl
s14: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ = ⟨ J2 , ⟨ a , x ⟩ ⟩ $ by opair_eq [s8, s13]
s15: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ⟨ J2 , ⟨ a , x ⟩ ⟩ ∈ Z $ by wcel_eq_l [s14, s3]
s16: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ⟨ J2 , ⟨ a , x ⟩ ⟩ ∈ Z2 $ by wcel_eq_r [s7, s15]
s17: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ iprop D J W ∧ v = nest a ∅ $ by ax
s18: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ iprop D J W $ by and_elim_l [s17]
s19: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ v = nest a ∅ $ by and_elim_r [s17]
s20: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ D = D2 $ by weaken [s5]
s21: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ W = W2 $ by weaken [s6]
s22: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ Z = Z2 $ by weaken [s7]
s23: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ J = J2 $ by weaken [s8]
s24: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ iprop D2 J2 W2 $ by iprop_eq [s20, s23, s21, s18]
s25: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ iprop D2 J2 W2 ∧ v = nest a ∅ $ by and_intro [s24, s19]
s26: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , iprop D J W ∧ v = nest a ∅ ⇒ (iprop D2 J2 W2 ∧ v = nest a ∅) ∨ (¬ iprop D2 J2 W2 ∧ v = nest a x) $ by or_intro_l [s25]
s27: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x ⇒ ¬ iprop D J W ∧ v = nest a x $ by ax
s28: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x ⇒ ¬ iprop D J W $ by and_elim_l [s27]
s29: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x ⇒ v = nest a x $ by and_elim_r [s27]
s30: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x , iprop D2 J2 W2 ⇒ D2 = D $ by weaken [s9]
s31: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x , iprop D2 J2 W2 ⇒ W2 = W $ by weaken [s10]
s32: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x , iprop D2 J2 W2 ⇒ Z2 = Z $ by weaken [s11]
s33: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x , iprop D2 J2 W2 ⇒ J2 = J $ by weaken [s12]
s34: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x , iprop D2 J2 W2 ⇒ iprop D2 J2 W2 $ by ax
s35: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x , iprop D2 J2 W2 ⇒ iprop D J W $ by iprop_eq [s30, s33, s31, s34]
s36: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x , iprop D2 J2 W2 ⇒ ¬ iprop D J W $ by weaken [s28]
s37: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x , iprop D2 J2 W2 ⇒ ⊥ $ by not_elim [s36, s35]
s38: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x ⇒ ¬ iprop D2 J2 W2 $ by not_intro [s37]
s39: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x ⇒ ¬ iprop D2 J2 W2 ∧ v = nest a x $ by and_intro [s38, s29]
s40: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) , ¬ iprop D J W ∧ v = nest a x ⇒ (iprop D2 J2 W2 ∧ v = nest a ∅) ∨ (¬ iprop D2 J2 W2 ∧ v = nest a x) $ by or_intro_r [s39]
s41: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ (iprop D2 J2 W2 ∧ v = nest a ∅) ∨ (¬ iprop D2 J2 W2 ∧ v = nest a x) $ by or_elim [s4, s26, s40]
s42: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ⟨ J2 , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D2 J2 W2 ∧ v = nest a ∅) ∨ (¬ iprop D2 J2 W2 ∧ v = nest a x)) $ by and_intro [s16, s41]
s43: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ∃ x (⟨ J2 , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D2 J2 W2 ∧ v = nest a ∅) ∨ (¬ iprop D2 J2 W2 ∧ v = nest a x))) $ by ex_intro [s42]
s44: $ G , v ∊ ient D W Z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x)) ⇒ ∃ a ∃ x (⟨ J2 , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D2 J2 W2 ∧ v = nest a ∅) ∨ (¬ iprop D2 J2 W2 ∧ v = nest a x))) $ by ex_intro [s43]
s45: $ G , v ∊ ient D W Z J , ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x))) ⇒ ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x))) $ by ax
s46: $ G , v ∊ ient D W Z J , ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest a ∅) ∨ (¬ iprop D J W ∧ v = nest a x))) ⇒ ∃ a ∃ x (⟨ J2 , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D2 J2 W2 ∧ v = nest a ∅) ∨ (¬ iprop D2 J2 W2 ∧ v = nest a x))) $ by ex_elim [s45, s44]
s47: $ G , v ∊ ient D W Z J ⇒ ∃ a ∃ x (⟨ J2 , ⟨ a , x ⟩ ⟩ ∈ Z2 ∧ ((iprop D2 J2 W2 ∧ v = nest a ∅) ∨ (¬ iprop D2 J2 W2 ∧ v = nest a x))) $ by ex_elim [s1, s46]
s48: $ G , v ∊ ient D W Z J ⇒ v ∊ ient D2 W2 Z2 J2 $ by cab_intro [s47]
s49: $ G ⇒ ient D W Z J ⊆ ient D2 W2 Z2 J2 $ by subset_intro [s48]

ient_eq
-------
l0: $ G ⇒ ient D W Z J ⊆ ient D2 W2 Z2 J2 $ by t0_ient_sub [#1, #2, #3, #4]
l1: $ G ⇒ D2 = D $ by eq_sym [#1]
l2: $ G ⇒ W2 = W $ by eq_sym [#2]
l3: $ G ⇒ Z2 = Z $ by eq_sym [#3]
l4: $ G ⇒ J2 = J $ by eq_sym [#4]
l5: $ G ⇒ ient D2 W2 Z2 J2 ⊆ ient D W Z J $ by t0_ient_sub [l1, l2, l3, l4]
l6: $ G ⇒ ient D W Z J = ient D2 W2 Z2 J2 $ by subset_antisym [l0, l5]

lemma t0_ixs_sub (G: hyps) (D D2 W W2 Z Z2: class):
  $ G ⇒ D = D2 $ > $ G ⇒ W = W2 $ > $ G ⇒ Z = Z2 $ >
  $ G ⇒ ixs D W Z ⊆ ixs D2 W2 Z2 $
----
s0: $ G , v ∊ ixs D W Z ⇒ v ∊ ixs D W Z $ by ax
s1: $ G , v ∊ ixs D W Z ⇒ ∃ j (j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩) $ by cab_elim [s0]
s2: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ $ by ax
s3: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ j ∊ intys D $ by and_elim_l [s2]
s4: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ v = ⟨ j , ient D W Z j ⟩ $ by and_elim_r [s2]
s5: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ D = D2 $ by weaken [#1]
s6: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ W = W2 $ by weaken [#2]
s7: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ Z = Z2 $ by weaken [#3]
s8: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ intys D = intys D2 $ by intys_eq [s5]
s9: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ j ∊ intys D2 $ by welc_eq [s8, s3]
s10: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ j = j $ by eq_refl
s11: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ ient D W Z j = ient D2 W2 Z2 j $ by ient_eq [s5, s6, s7, s10]
s12: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ ⟨ j , ient D W Z j ⟩ = ⟨ j , ient D2 W2 Z2 j ⟩ $ by opair_eq [s10, s11]
s13: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ v = ⟨ j , ient D2 W2 Z2 j ⟩ $ by eq_trans [s4, s12]
s14: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ j ∊ intys D2 ∧ v = ⟨ j , ient D2 W2 Z2 j ⟩ $ by and_intro [s9, s13]
s15: $ G , v ∊ ixs D W Z , j ∊ intys D ∧ v = ⟨ j , ient D W Z j ⟩ ⇒ ∃ j (j ∊ intys D2 ∧ v = ⟨ j , ient D2 W2 Z2 j ⟩) $ by ex_intro [s14]
s16: $ G , v ∊ ixs D W Z ⇒ ∃ j (j ∊ intys D2 ∧ v = ⟨ j , ient D2 W2 Z2 j ⟩) $ by ex_elim [s1, s15]
s17: $ G , v ∊ ixs D W Z ⇒ v ∊ ixs D2 W2 Z2 $ by cab_intro [s16]
s18: $ G ⇒ ixs D W Z ⊆ ixs D2 W2 Z2 $ by subset_intro [s17]

ixs_eq
------
l0: $ G ⇒ ixs D W Z ⊆ ixs D2 W2 Z2 $ by t0_ixs_sub [#1, #2, #3]
l1: $ G ⇒ D2 = D $ by eq_sym [#1]
l2: $ G ⇒ W2 = W $ by eq_sym [#2]
l3: $ G ⇒ Z2 = Z $ by eq_sym [#3]
l4: $ G ⇒ ixs D2 W2 Z2 ⊆ ixs D W Z $ by t0_ixs_sub [l1, l2, l3]
l5: $ G ⇒ ixs D W Z = ixs D2 W2 Z2 $ by subset_antisym [l0, l4]

--| An element of a two-level trace is a nested pair.
lemma c5_clam2_shape {w r a b c: set} (G: hyps w r) (A A2: class) (B: class w r) (z: set):
  $ G ⇒ z ∊ clam w A (clam r A2 B) $ > $ G ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $
----
n1: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) , j = ⟨ l , m ⟩ , l ∊ A2 , m ∊ (⟦ r / l ⟧ (⟦ w / i ⟧ B)) ⇒ z = ⟨ i , j ⟩ $ by ax
n2: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) , j = ⟨ l , m ⟩ , l ∊ A2 , m ∊ (⟦ r / l ⟧ (⟦ w / i ⟧ B)) ⇒ j = ⟨ l , m ⟩ $ by ax
n3: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) , j = ⟨ l , m ⟩ , l ∊ A2 , m ∊ (⟦ r / l ⟧ (⟦ w / i ⟧ B)) ⇒ i = i $ by eq_refl
n4: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) , j = ⟨ l , m ⟩ , l ∊ A2 , m ∊ (⟦ r / l ⟧ (⟦ w / i ⟧ B)) ⇒ ⟨ i , j ⟩ = ⟨ i , ⟨ l , m ⟩ ⟩ $ by opair_eq [n3, n2]
n5: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) , j = ⟨ l , m ⟩ , l ∊ A2 , m ∊ (⟦ r / l ⟧ (⟦ w / i ⟧ B)) ⇒ z = ⟨ i , ⟨ l , m ⟩ ⟩ $ by eq_trans [n1, n4]
n6: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) , j = ⟨ l , m ⟩ , l ∊ A2 , m ∊ (⟦ r / l ⟧ (⟦ w / i ⟧ B)) ⇒ ∃ c (z = ⟨ i , ⟨ l , c ⟩ ⟩) $ by ex_intro [n5]
n7: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) , j = ⟨ l , m ⟩ , l ∊ A2 , m ∊ (⟦ r / l ⟧ (⟦ w / i ⟧ B)) ⇒ ∃ b ∃ c (z = ⟨ i , ⟨ b , c ⟩ ⟩) $ by ex_intro [n6]
n8: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) , j = ⟨ l , m ⟩ , l ∊ A2 , m ∊ (⟦ r / l ⟧ (⟦ w / i ⟧ B)) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by ex_intro [n7]
m1: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) ⇒ j ∊ clam r A2 (⟦ w / i ⟧ B) $ by ax
m2: $ G , z = ⟨ i , j ⟩ , i ∊ A , j ∊ clam r A2 (⟦ w / i ⟧ B) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by clam_elim_mem [m1, n8]
m3: $ G ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by clam_elim_mem [#1, m2]

--| An element of a value of `etb` is a nested pair.
lemma c5_etb_shape {a b c: set} (G: hyps) (E K S V: class) (u z: set):
  $ G ⇒ z ∊ etb u E K S V $ > $ G ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $
----
l1: $ G ⇒ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ d (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , d ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , d ⟩ ⟩ ⟩)})) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by cab_elim [#1]
a1: $ G , K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ d (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , d ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , d ⟩ ⟩ ⟩)}) ⇒ K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ d (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , d ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , d ⟩ ⟩ ⟩)}) $ by ax
a2: $ G , K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ d (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , d ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , d ⟩ ⟩ ⟩)}) ⇒ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ d (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , d ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , d ⟩ ⟩ ⟩)}) $ by and_elim_r [a1]
a3: $ G , K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ d (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , d ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , d ⟩ ⟩ ⟩)}) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by c5_clam2_shape [a2]
b1: $ G , K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)}) ⇒ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)}) $ by ax
b2: $ G , K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)}) ⇒ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)}) $ by and_elim_r [b1]
b3: $ G , K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)}) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by c5_clam2_shape [b2]
c1: $ G , ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by ax
c2: $ G , ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_elim_r [c1]
c3: $ G , ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_elim_r [c2]
c4: $ G , ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by c5_clam2_shape [c3]
d1: $ G , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by ax
d4: $ G , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)}) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by weaken [b3]
d5: $ G , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by weaken [c4]
d2: $ G , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ d (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , d ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv S (suc ∅))) w r) d ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by or_elim [d1, d4, d5]
d3: $ G ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by or_elim [l1, a3, d2]

--| An element of a value of `etf` at a tree is a nested pair.
lemma c5_etf_shape {a b c: set} (G: hyps) (E: class) (u o z: set):
  $ G ⇒ o ∊ trees ω $ > $ G ⇒ z ∊ fv (etf u E) o $ > $ G ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $
----
p1: $ G ⇒ isset ω $ by omega_set
p2: $ G ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [p1]
p3: $ G ⇒ trees ω = ω × fseq (trees ω) $ by eq_sym [p2]
p4: $ G ⇒ o ∊ ω × fseq (trees ω) $ by welc_eq [p3, #1]
k1: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ functional (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) $ by cgr3_functional
k2: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ isset ω $ by omega_set
k6: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ k ∊ ω $ by ax
k7: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ l ∊ fseq (trees ω) $ by ax
k3: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ fv (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) ⟨ k , l ⟩ = fv (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⟩ ⟩ $ by trc_node_c [k2, k1, k6, k7]
k4: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ functional (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) $ by trc_functional_c [k2, k1]
k8: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ isset l $ by isset_var
k5: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ isset (ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l) $ by ccom_set [k4, k8]
h1: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l $ by ax
h2: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l = h $ by eq_sym [h1]
h3: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ l = l $ by eq_refl
h4: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ ⟨ l , ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⟩ = ⟨ l , h ⟩ $ by opair_eq [h3, h2]
h5: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ k = k $ by eq_refl
h6: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ ⟨ k , ⟨ l , ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⟩ ⟩ = ⟨ k , ⟨ l , h ⟩ ⟩ $ by opair_eq [h5, h4]
h7: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ cgr3 x0 x1 x2 (etb u E x0 x1 x2) = cgr3 x0 x1 x2 (etb u E x0 x1 x2) $ by eq_refl
h8: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ fv (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⟩ ⟩ = fv (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ $ by fv_eq [h7, h6]
h9: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) = trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) $ by eq_refl
h10: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ o = ⟨ k , l ⟩ $ by ax
h11: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ fv (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) o = fv (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) ⟨ k , l ⟩ $ by fv_eq [h9, h10]
h12: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ fv (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) ⟨ k , l ⟩ = fv (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⟩ ⟩ $ by weaken [k3]
h13: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ fv (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) o = fv (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⟩ ⟩ $ by eq_trans [h11, h12]
h14: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ fv (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) o = fv (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ $ by eq_trans [h13, h8]
h15: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ z ∊ fv (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) o $ by weaken [#2]
h16: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ z ∊ fv (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ $ by welc_eq [h14, h15]
i1: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l , y ∊ ap (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ , z ∊ y ⇒ y ∊ ap (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ $ by ax
i2: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l , y ∊ ap (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ , z ∊ y ⇒ ⟨ ⟨ k , ⟨ l , h ⟩ ⟩ , y ⟩ ∈ cgr3 x0 x1 x2 (etb u E x0 x1 x2) $ by ap_elim [i1]
i3: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l , y ∊ ap (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ , z ∊ y ⇒ y = etb u E k l h $ by cgr3_elim [i2]
i4: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l , y ∊ ap (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ , z ∊ y ⇒ z ∊ y $ by ax
i5: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l , y ∊ ap (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ , z ∊ y ⇒ z ∊ etb u E k l h $ by welc_eq [i3, i4]
i6: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l , y ∊ ap (cgr3 x0 x1 x2 (etb u E x0 x1 x2)) ⟨ k , ⟨ l , h ⟩ ⟩ , z ∊ y ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by c5_etb_shape [i5]
i7: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) , h = ccom (trc ω (cgr3 x0 x1 x2 (etb u E x0 x1 x2))) l ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by cuni_elim [h16, i6]
i8: $ G , o = ⟨ k , l ⟩ , k ∊ ω , l ∊ fseq (trees ω) ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by isset_elim [k5, i7]
i9: $ G ⇒ ∃ a ∃ b ∃ c (z = ⟨ a , ⟨ b , c ⟩ ⟩) $ by cxp_elim [p4, i8]

--| A path of a telescope comes with set arguments.
etel_isset
----------
e2: $ G ⇒ ⟨ R , y ⟩ ∈ ap (fv (etf u E) o) W $ by ap_elim [#2]
f0: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W ⇒ v ∊ ap (fv (etf u E) o) W $ by ax
f1: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W ⇒ ⟨ W , v ⟩ ∈ fv (etf u E) o $ by ap_elim [f0]
g0: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o ⇒ q ∊ fv (etf u E) o $ by ax
g2: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o ⇒ o ∊ trees ω $ by weaken [#1]
g1: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o ⇒ ∃ a ∃ b ∃ c (q = ⟨ a , ⟨ b , c ⟩ ⟩) $ by c5_etf_shape [g2, g0]
h0: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ isset ⟨ b , c ⟩ $ by opair_isset
h1: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ q = ⟨ a , ⟨ b , c ⟩ ⟩ $ by ax
h2: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ e = ⟨ b , c ⟩ $ by ax
h3: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ ⟨ b , c ⟩ = e $ by eq_sym [h2]
h4: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ a = a $ by eq_refl
h5: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ ⟨ a , ⟨ b , c ⟩ ⟩ = ⟨ a , e ⟩ $ by opair_eq [h4, h3]
h6: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ q = ⟨ a , e ⟩ $ by eq_trans [h1, h5]
h7: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ q = ⟨ W , v ⟩ $ by ax
h8: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ ⟨ W , v ⟩ = q $ by eq_sym [h7]
h9: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ ⟨ W , v ⟩ = ⟨ a , e ⟩ $ by eq_trans [h8, h6]
h10: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ isset W $ by opair_eq_isset [h9]
j1: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ isset v $ by isset_var
j2: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ isset a $ by isset_var
j3: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ isset e $ by isset_var
h11: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ W = a ∧ v = e $ by opair_inj_c [h9, h10, j1, j2, j3]
h12: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ v = e $ by and_elim_r [h11]
h13: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ v = ⟨ R , y ⟩ $ by ax
h14: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ ⟨ R , y ⟩ = v $ by eq_sym [h13]
h15: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ ⟨ R , y ⟩ = e $ by eq_trans [h14, h12]
h16: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ ⟨ R , y ⟩ = ⟨ b , c ⟩ $ by eq_trans [h15, h2]
h17: $ G , v = ⟨ R , y ⟩ , v ∊ ap (fv (etf u E) o) W , q = ⟨ W , v ⟩ , q ∊ fv (etf u E) o , q = ⟨ a , ⟨ b , c ⟩ ⟩ , e = ⟨ b , c ⟩ ⇒ isset R $ by opair_eq_isset [h16]
