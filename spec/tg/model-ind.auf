q14: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ ra_nth_ty e h f c ∈ lrel → suc (fv nvf h) = fv nvf j → f ∈ fv tsub e ∧ c ∈ fv tsub e $ by all_elim [q13]
q15: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ suc (fv nvf h) = fv nvf j → f ∈ fv tsub e ∧ c ∈ fv tsub e $ by imp_elim [q14, q4]
q16: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ f ∈ fv tsub e ∧ c ∈ fv tsub e $ by imp_elim [q15, q11]
q17: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ t ∈ trees ω $ by weaken [a6]
