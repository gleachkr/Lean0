m1: $ G , j ∊ {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (c = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons D x8 , x9 ⟩ ⟩ ⟩)} ⇒ j ∊ {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (c = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons D x8 , x9 ⟩ ⟩ ⟩)} $ by ax
m2: $ G , j ∊ {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (c = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons D x8 , x9 ⟩ ⟩ ⟩)} ⇒ ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (c = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ j ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons D x8 , x9 ⟩ ⟩ ⟩) $ by cab_elim [m1]
m3: $ G , j ∊ {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (c = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons D x8 , x9 ⟩ ⟩ ⟩)} ⇒ j ∊ ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by ex_elim [m2, x3b]
m4: $ G ⇒ ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ = {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (c = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons D x8 , x9 ⟩ ⟩ ⟩)} $ by eq_intro [f9, m3]

lemma c3_x1_set {x f g t a y: set} (G: hyps) (E S: class) (u v w r: set): $ G ⇒ isset {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv v (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv v ∅) w r) t , a ⟩ ⟩ ⟩)} $
----
s1: $ G ⇒ isset v $ by isset_var
s2: $ G ⇒ isset (fv v (suc ∅)) $ by fv_set_l [s1]
s3: $ G ⇒ isset (da (fv v (suc ∅)) w (scons d r)) $ by da_set [s2]
s4: $ G , d ∊ u ⇒ isset (da (fv v (suc ∅)) w (scons d r)) $ by weaken [s3]
s5: $ G ⇒ d ∊ u → isset (da (fv v (suc ∅)) w (scons d r)) $ by imp_intro [s4]
s6: $ G ⇒ ∀ d (d ∊ u → isset (da (fv v (suc ∅)) w (scons d r))) $ by all_intro [s5]
s7: $ G ⇒ isset u $ by isset_var
s8: $ G ⇒ isset (clam d u (da (fv v (suc ∅)) w (scons d r))) $ by clam_set [s7, s6]
s9: $ G , b = clam d u (da (fv v (suc ∅)) w (scons d r)) ⇒ functional (cgr i {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (i = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons (da (fv v ∅) w r) x8 , x9 ⟩ ⟩ ⟩)}) $ by cgr_functional
