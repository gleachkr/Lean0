r4b: $ G ⇒ fv (dnf u (mcv H)) z = fv (dnf u (mcv H)) ⟨ k , h ⟩ $ by fv_eq [r4a, #3]
r4c: $ G ⇒ ⟨ z , fv (dnf u (mcv H)) z ⟩ = ⟨ ⟨ k , h ⟩ , fv (dnf u (mcv H)) ⟨ k , h ⟩ ⟩ $ by opair_eq [#3, r4b]
r4: $ G ⇒ csn ⟨ z , fv (dnf u (mcv H)) z ⟩ = csn ⟨ ⟨ k , h ⟩ , fv (dnf u (mcv H)) ⟨ k , h ⟩ ⟩ $ by csn_eq [r4c]
r5a: $ G ⇒ cres (dnf u (mcv H)) (psub h) = cres (dnf u (mcv H)) (psub h) $ by eq_refl
r5: $ G ⇒ cres (dnf u (mcv H)) (psub h) ∪ csn ⟨ z , fv (dnf u (mcv H)) z ⟩ = cres (dnf u (mcv H)) (psub h) ∪ csn ⟨ ⟨ k , h ⟩ , fv (dnf u (mcv H)) ⟨ k , h ⟩ ⟩ $ by cun_eq [r5a, r4]
t1: $ G ⇒ fv tsub ⟨ k , h ⟩ = csn ⟨ k , h ⟩ ∪ psub h $ by tsub_node [#1, #2]
t2a: $ G ⇒ tsub = tsub $ by eq_refl
t2: $ G ⇒ fv tsub z = fv tsub ⟨ k , h ⟩ $ by fv_eq [t2a, #3]
t3a: $ G ⇒ csn ⟨ k , h ⟩ = csn z $ by csn_eq [s2]
t3b: $ G ⇒ psub h = psub h $ by eq_refl
t3: $ G ⇒ csn ⟨ k , h ⟩ ∪ psub h = csn z ∪ psub h $ by cun_eq [t3a, t3b]
t4a: $ G ⇒ fv tsub z = csn ⟨ k , h ⟩ ∪ psub h $ by eq_trans [t2, t1]
t4: $ G ⇒ fv tsub z = csn z ∪ psub h $ by eq_trans [t4a, t3]
t5: $ G ⇒ cres (dnf u (mcv H)) (fv tsub z) = cres (dnf u (mcv H)) (csn z ∪ psub h) $ by cres_eq [r4a, t4]
f0: $ G ⇒ cvf u H = cvf u H $ by eq_refl
f1: $ G ⇒ fv (cvf u H) z = fv (cvf u H) ⟨ k , h ⟩ $ by fv_eq [f0, #3]
f2: $ G ⇒ fv (cvf u H) z = cvb u H k h (ccom (cvf u H) h) $ by eq_trans [f1, n5]
f3: $ G ⇒ fv (cvf u H) z = ⋃ (crn (ccom (cvf u H) h)) ∪ csn ⟨ ⟨ k , h ⟩ , dnb u (csn ⟨ ⟨ u , ⟨ k , ⟨ h , cvv h (ccom (cvf u H) h) ⟩ ⟩ ⟩ , fv H ⟨ u , ⟨ k , ⟨ h , ⋃ (crn (ccom (cvf u H) h)) ⟩ ⟩ ⟩ ⟩) k h (cvv h (ccom (cvf u H) h)) ⟩ $ by eq_trans [f2, r1]
f4: $ G ⇒ fv (cvf u H) z = cres (dnf u (mcv H)) (psub h) ∪ csn ⟨ ⟨ k , h ⟩ , fv (dnf u (mcv H)) ⟨ k , h ⟩ ⟩ $ by eq_trans [f3, r2]
f5a: $ G ⇒ cres (dnf u (mcv H)) (psub h) ∪ csn ⟨ ⟨ k , h ⟩ , fv (dnf u (mcv H)) ⟨ k , h ⟩ ⟩ = cres (dnf u (mcv H)) (psub h) ∪ csn ⟨ z , fv (dnf u (mcv H)) z ⟩ $ by eq_sym [r5]
f5: $ G ⇒ fv (cvf u H) z = cres (dnf u (mcv H)) (psub h) ∪ csn ⟨ z , fv (dnf u (mcv H)) z ⟩ $ by eq_trans [f4, f5a]
f6a: $ G ⇒ cres (dnf u (mcv H)) (psub h) ∪ csn ⟨ z , fv (dnf u (mcv H)) z ⟩ = cres (dnf u (mcv H)) (csn z ∪ psub h) $ by eq_sym [r3]
f6: $ G ⇒ fv (cvf u H) z = cres (dnf u (mcv H)) (csn z ∪ psub h) $ by eq_trans [f5, f6a]
f7a: $ G ⇒ cres (dnf u (mcv H)) (csn z ∪ psub h) = cres (dnf u (mcv H)) (fv tsub z) $ by eq_sym [t5]
f7: $ G ⇒ fv (cvf u H) z = cres (dnf u (mcv H)) (fv tsub z) $ by eq_trans [f6, f7a]

