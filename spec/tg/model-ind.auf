z3: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ S = h $ by eq_sym [n5]
z4: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ ⟨ K , S ⟩ = ⟨ k , h ⟩ $ by opair_eq [z2, z3]
z5: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ fv (etf u E) ⟨ K , S ⟩ = fv (etf u E) ⟨ k , h ⟩ $ by fv_eq [n6, z4]
z6: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ da (fv (etf u E) ⟨ K , S ⟩) w r = da (fv (etf u E) ⟨ k , h ⟩) w r $ by da_eq [z5, w1, r1]
z7: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) , c = ccom (etf u E) h ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [z6, q13]
y1: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ isset h $ by isset_var
y2: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ functional (etf u E) $ by etf_functional
y3: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ isset (ccom (etf u E) h) $ by ccom_set [y2, y1]
y4: $ G , k = K , k ∊ ω , h = S , h ∊ fseq (trees ω) ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by isset_elim [y3, z7]
y5: $ G , k = K , k ∊ ω ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by wcel_elim [l4, y4]
y6: $ G ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by wcel_elim [l1, y5]

etel_other_c
------------
a1: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ K ∈ ω $ by weaken [#1]
a2: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ S ∈ fseq (trees ω) $ by weaken [#2]
a3: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ ¬ K = kc_pi $ by weaken [#3]
a4: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ ¬ K = kc_app $ by weaken [#4]
a5: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ x ∊ lvals $ by ax
a6: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ y ∊ fseq u $ by ax
a7: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ etel u E ⟨ K , S ⟩ x y = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other [a1, a2, a3, a4, a5, a6]
b1: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ x = W $ by ax
b2: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ W = x $ by eq_sym [b1]
b3: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ y = R $ by ax
b4: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ R = y $ by eq_sym [b3]
b5: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ fv (etf u E) ⟨ K , S ⟩ = fv (etf u E) ⟨ K , S ⟩ $ by eq_refl
b6: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ da (fv (etf u E) ⟨ K , S ⟩) W R = da (fv (etf u E) ⟨ K , S ⟩) x y $ by da_eq [b5, b2, b4]
b7: $ G , x = W , x ∊ lvals , y = R , y ∊ fseq u ⇒ etel u E ⟨ K , S ⟩ W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [b6, a7]
c1: $ G , x = W , x ∊ lvals ⇒ etel u E ⟨ K , S ⟩ W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by wcel_elim [#6, b7]
c2: $ G ⇒ etel u E ⟨ K , S ⟩ W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by wcel_elim [#5, c1]

lemma c3_p4_inj (G: hyps) (A B C D: class) (f g t a: set):
  $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ isset C $ > $ G ⇒ isset D $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ = ⟨ A , ⟨ B , ⟨ C , D ⟩ ⟩ ⟩ $ >
  $ G ⇒ f = A ∧ g = B ∧ t = C ∧ a = D $
----
s1: $ G ⇒ isset f $ by isset_var
s2: $ G ⇒ isset g $ by isset_var
s3: $ G ⇒ isset t $ by isset_var
s4: $ G ⇒ isset a $ by isset_var
p1: $ G ⇒ isset ⟨ g , ⟨ t , a ⟩ ⟩ $ by opair_isset
p2: $ G ⇒ isset ⟨ B , ⟨ C , D ⟩ ⟩ $ by opair_isset
p3: $ G ⇒ isset ⟨ t , a ⟩ $ by opair_isset
p4: $ G ⇒ isset ⟨ C , D ⟩ $ by opair_isset
i1: $ G ⇒ f = A ∧ ⟨ g , ⟨ t , a ⟩ ⟩ = ⟨ B , ⟨ C , D ⟩ ⟩ $ by opair_inj_c [#5, s1, p1, #1, p2]
i2: $ G ⇒ ⟨ g , ⟨ t , a ⟩ ⟩ = ⟨ B , ⟨ C , D ⟩ ⟩ $ by and_elim_r [i1]
i3: $ G ⇒ g = B ∧ ⟨ t , a ⟩ = ⟨ C , D ⟩ $ by opair_inj_c [i2, s2, p3, #2, p4]
i4: $ G ⇒ ⟨ t , a ⟩ = ⟨ C , D ⟩ $ by and_elim_r [i3]
i5: $ G ⇒ t = C ∧ a = D $ by opair_inj_c [i4, s3, s4, #3, #4]
i6: $ G ⇒ g = B $ by and_elim_l [i3]
i7: $ G ⇒ g = B ∧ t = C ∧ a = D $ by and_intro [i6, i5]
i8: $ G ⇒ f = A $ by and_elim_l [i1]
i9: $ G ⇒ f = A ∧ g = B ∧ t = C ∧ a = D $ by and_intro [i8, i7]

lemma c3_etel_m (G: hyps) (E: class) (u k s w r c m: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ c = ccom (etf u E) s $ > $ G ⇒ m ∊ etel u E ⟨ k , s ⟩ w r $ >
  $ G ⇒ m ∊ ap (ap (etb u E k s c) w) r $
----
l1: $ G ⇒ fv (etf u E) ⟨ k , s ⟩ = etb u E k s c $ by etf_node [#1, #2, #3]
l2: $ G ⇒ w = w $ by eq_refl
l3: $ G ⇒ r = r $ by eq_refl
l4: $ G ⇒ da (fv (etf u E) ⟨ k , s ⟩) w r = da (etb u E k s c) w r $ by da_eq [l1, l2, l3]
l5: $ G ⇒ m ∊ ap (ap (etb u E k s c) w) r $ by welc_eq [l4, #4]

lemma c3_etel_dpi {x f g t a: set} (G: hyps) (E: class) (u k s w r f0 g0 t0 a0: set):
  $ G ⇒ k = kc_pi $ > $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ ∈ etel u E ⟨ k , s ⟩ w r $ >
  $ G ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a) $
----
a1: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ k ∊ ω $ by weaken [#2]
a2: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ s ∊ fseq (trees ω) $ by weaken [#3]
a3: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ c = ccom (etf u E) s $ by ax
a4: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ m ∊ etel u E ⟨ k , s ⟩ w r $ by ax
a5: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ m ∊ ap (ap (etb u E k s c) w) r $ by c3_etel_m [a1, a2, a3, a4]
a6: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ k = kc_pi $ by weaken [#1]
a7: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ etb u E k s c = clam o lvals (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) o p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) o (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) o p) t , a ⟩ ⟩ ⟩)}) $ by c3_etb_k1 [a6]
a8: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ w = w $ by eq_refl
a9: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ r = r $ by eq_refl
a10: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ ap (etb u E k s c) w = ap (clam o lvals (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) o p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) o (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) o p) t , a ⟩ ⟩ ⟩)})) w $ by ap_eq [a7, a8]
a11: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ ap (ap (etb u E k s c) w) r = ap (ap (clam o lvals (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) o p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) o (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) o p) t , a ⟩ ⟩ ⟩)})) w) r $ by ap_eq [a10, a9]
a12: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ m ∊ ap (ap (clam o lvals (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) o p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) o (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) o p) t , a ⟩ ⟩ ⟩)})) w) r $ by welc_eq [a11, a5]
a13: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ w ∊ lvals ∧ r ∊ fseq u ∧ m ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩)} $ by c3_cc_mem [a12]
a14: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ r ∊ fseq u ∧ m ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩)} $ by and_elim_r [a13]
a15: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ m ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩)} $ by and_elim_r [a14]
a16: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩) $ by cab_elim [a15]
i0: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ $ by ax
i0a: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ $ by and_elim_r [i0]
i0b: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ x ∊ u $ by and_elim_l [i0a]
i0c: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ $ by and_elim_r [i0a]
i1: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) $ by and_elim_l [i0c]
i11: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ $ by and_elim_r [i0c]
i1a: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ c = ccom (etf u E) s $ by ax
i2: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ suc ∅ ∈ cdm s $ by c3_dacc1 [i1a, i1]
i2a: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ functional (etf u E) $ by etf_functional
i2b: $ G , c = ccom (etf u E) s , m = ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ , m ∊ etel u E ⟨ k , s ⟩ w r , x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ m = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩ ⇒ cdm (etf u E) = trees ω $ by etf_cdm
