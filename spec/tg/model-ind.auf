n23: $ G ⇒ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $ by and_intro [n20, n22]
n24: $ G ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $ by and_intro [n21, n23]

lemma c3_fseq_c (G: hyps) (E T R: class) (u w f g t a: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w R $ > $ G ⇒ isset R $ >
  $ G ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $
----
l1: $ G , q = R ⇒ fv (etf u E) T = fv (etf u E) T $ by eq_refl
l2: $ G , q = R ⇒ w = w $ by eq_refl
l3a: $ G , q = R ⇒ q = R $ by ax
l3: $ G , q = R ⇒ R = q $ by eq_sym [l3a]
l4: $ G , q = R ⇒ da (fv (etf u E) T) w R = da (fv (etf u E) T) w q $ by da_eq [l1, l2, l3]
l5: $ G , q = R ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w R $ by weaken [#2]
l6: $ G , q = R ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E T w q $ by wcel_eq_r [l4, l5]
l7: $ G , q = R ⇒ T ∈ trees ω $ by weaken [#1]
l8: $ G , q = R ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $ by etel_fseq [l7, l6]
l9: $ G ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $ by isset_elim [#3, l8]

lemma c3_el_use {y x0 x1 x2 x3 x4 x5 x6 x7 x8 x9: set} (G: hyps y x0 x1 x2 x3 x4 x5 x6 x7 x8 x9) (E A R R2: class) (u w f g t a f2 g2 t2 a2: set):
  $ G ⇒ A ∈ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E A w R $ > $ G ⇒ ⟨ f2 , ⟨ g2 , ⟨ t2 , a2 ⟩ ⟩ ⟩ ∈ etel u E A w R2 $ > $ G ⇒ isset R $ > $ G ⇒ isset R2 $ >
  $ G ⇒ cdm f = cdm f2 $
----
l1: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} ⇒ e ∊ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} $ by ax
l2: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} ⇒ ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E e w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E e w x5 → cdm x1 = cdm x6) $ by cab_elim [l1]
m0: $ G , e = A , e ∊ {y | ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E y w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E y w x5 → cdm x1 = cdm x6)} , q = R , o = R2 ⇒ ∀ x0 ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 ∀ x6 ∀ x7 ∀ x8 ∀ x9 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E e w x0 → ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ∈ etel u E e w x5 → cdm x1 = cdm x6) $ by weaken [l2]
