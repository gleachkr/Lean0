q2b: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ b = c $ by eq_sym [qq3]
q2c: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ e = e $ by eq_refl
q2d: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ h = h $ by eq_refl
q3: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ ra_nth_ty e h a b = ra_nth_ty e h f c $ by ra_nth_ty_eq [q2c, q2d, q2, q2b]
q4: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ ra_nth_ty e h f c ∈ lrel $ by wcel_eq_l [q3, qq4]
q5a: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ isset kr_nth_ty $ by weaken [a3]
q5: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ e ∊ trees ω ∧ h ∊ trees ω ∧ a ∊ trees ω ∧ b ∊ trees ω $ by lrel_args4 [qq4, q5a]
q5b: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ h ∊ trees ω ∧ a ∊ trees ω ∧ b ∊ trees ω $ by and_elim_r [q5]
q5c: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ h ∊ trees ω $ by and_elim_l [q5b]
q6: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ h ∈ trees ω $ by welc_wcel [q5c]
q7: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ nvf = nvf $ by eq_refl
q8: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ fv nvf j = fv nvf ⟨ kc_s , scons h ∅ ⟩ $ by fv_eq [q7, qq1]
q9: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ fv nvf ⟨ kc_s , scons h ∅ ⟩ = suc (fv nvf h) $ by nvf_s [q6]
q10: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ fv nvf j = suc (fv nvf h) $ by eq_trans [q8, q9]
q11: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ suc (fv nvf h) = fv nvf j $ by eq_sym [q10]
q12: $ G , t = ⟨ kc_tcons , scons u (scons v (scons e ∅)) ⟩ ∧ j = ⟨ kc_s , scons h ∅ ⟩ ∧ f = a ∧ c = b ∧ ra_nth_ty e h a b ∈ lrel ⇒ ∀ x ∀ i (ra_nth_ty x i f c ∈ lrel → suc (fv nvf i) = fv nvf j → f ∈ fv tsub x ∧ c ∈ fv tsub x) $ by weaken [#2]
