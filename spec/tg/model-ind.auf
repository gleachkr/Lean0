z4: $ G ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E (fv s (suc ∅)) w (scons x r) ∧ fv s (suc ∅) ∈ crn s ∧ f0 = ssnoc f x ∧ g0 = scons x g ∧ t0 = scons (etel u E (fv s ∅) w r) t ∧ a0 = a) $ by isset_elim [z3, z2]

lemma c3_etel_dapp {a: set} (G: hyps) (E: class) (u k s w r f0 g0 t0 a0: set):
  $ G ⇒ k = kc_app $ > $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ ∈ etel u E ⟨ k , s ⟩ w r $ >
  $ G ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u E (fv s ∅) w r ∧ fv s ∅ ∈ crn s ∧ f0 = ∅ ∧ g0 = ∅ ∧ t0 = ∅ ∧ a0 = scons (da (fv E (fv s (suc ∅))) w r) a) $
----
