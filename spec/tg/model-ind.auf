l15: $ (ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ (ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by and_congr [l6, l14]
l16: $ (fv nvf n = C ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ (fv nvf n = D ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by and_congr [l5, l15]
l17: $ (iprt A p t ∧ fv nvf n = C ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ (iprt B p t ∧ fv nvf n = D ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by and_congr [l3, l16]
l18: $ ∃ m (iprt A p t ∧ fv nvf n = C ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ ∃ m (iprt B p t ∧ fv nvf n = D ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by ex_congr [l17]
l19: $ ∃ e ∃ m (iprt A p t ∧ fv nvf n = C ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ ∃ e ∃ m (iprt B p t ∧ fv nvf n = D ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by ex_congr [l18]
l20: $ ∃ f ∃ e ∃ m (iprt A p t ∧ fv nvf n = C ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ ∃ f ∃ e ∃ m (iprt B p t ∧ fv nvf n = D ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by ex_congr [l19]
l21: $ ∃ n ∃ f ∃ e ∃ m (iprt A p t ∧ fv nvf n = C ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ ∃ n ∃ f ∃ e ∃ m (iprt B p t ∧ fv nvf n = D ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by ex_congr [l20]
l22: $ ∃ t ∃ n ∃ f ∃ e ∃ m (iprt A p t ∧ fv nvf n = C ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ ∃ t ∃ n ∃ f ∃ e ∃ m (iprt B p t ∧ fv nvf n = D ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by ex_congr [l21]
l23: $ ∃ p ∃ t ∃ n ∃ f ∃ e ∃ m (iprt A p t ∧ fv nvf n = C ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = E ∧ ra_nth_ctor e m H ∈ lrel) ⟺ ∃ p ∃ t ∃ n ∃ f ∃ e ∃ m (iprt B p t ∧ fv nvf n = D ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = F ∧ ra_nth_ctor e m I ∈ lrel) $ by ex_congr [l22]

sb_f_ictk
---------
l1: $ [x/t] (∃ p ∃ q ∃ n ∃ f ∃ e ∃ m (iprt A p q ∧ fv nvf n = B ∧ ra_nth_ty q n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m D ∈ lrel)) ⟺ ∃ p ∃ q ∃ n ∃ f ∃ e ∃ m (iprt (⟦ x / t ⟧ A) p q ∧ fv nvf n = (⟦ x / t ⟧ B) ∧ ra_nth_ty q n f e ∈ lrel ∧ fv nvf m = (⟦ x / t ⟧ C) ∧ ra_nth_ctor e m (⟦ x / t ⟧ D) ∈ lrel) $ by iff_refl

iprop_congr
-----------
l1: $ f ≐ f $ by ceqt_refl
l2: $ ityf A C f ⟺ ityf B D f $ by ityf_congr [#1, #2, l1]
l3: $ (ra_isort f k l ∈ lrel) ⟺ (ra_isort f k l ∈ lrel) $ by iff_refl
l4: $ l ≐ l $ by ceqt_refl
l5: $ lv l E ≐ lv l F $ by lv_congr [l4, #3]
l6: $ ∅ ≐ ∅ $ by ceqt_refl
l7: $ (lv l E = ∅) ⟺ (lv l F = ∅) $ by ceq_congr [l5, l6]
l8: $ (ra_isort f k l ∈ lrel ∧ lv l E = ∅) ⟺ (ra_isort f k l ∈ lrel ∧ lv l F = ∅) $ by and_congr [l3, l7]
l9: $ (ityf A C f ∧ ra_isort f k l ∈ lrel ∧ lv l E = ∅) ⟺ (ityf B D f ∧ ra_isort f k l ∈ lrel ∧ lv l F = ∅) $ by and_congr [l2, l8]
l10: $ ∃ l (ityf A C f ∧ ra_isort f k l ∈ lrel ∧ lv l E = ∅) ⟺ ∃ l (ityf B D f ∧ ra_isort f k l ∈ lrel ∧ lv l F = ∅) $ by ex_congr [l9]
l11: $ ∃ k ∃ l (ityf A C f ∧ ra_isort f k l ∈ lrel ∧ lv l E = ∅) ⟺ ∃ k ∃ l (ityf B D f ∧ ra_isort f k l ∈ lrel ∧ lv l F = ∅) $ by ex_congr [l10]
l12: $ ∃ f ∃ k ∃ l (ityf A C f ∧ ra_isort f k l ∈ lrel ∧ lv l E = ∅) ⟺ ∃ f ∃ k ∃ l (ityf B D f ∧ ra_isort f k l ∈ lrel ∧ lv l F = ∅) $ by ex_congr [l11]

sb_f_iprop
----------
l1: $ [x/t] (∃ f ∃ k ∃ l (ityf A B f ∧ ra_isort f k l ∈ lrel ∧ lv l C = ∅)) ⟺ ∃ f ∃ k ∃ l (ityf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) f ∧ ra_isort f k l ∈ lrel ∧ lv l (⟦ x / t ⟧ C) = ∅) $ by iff_refl

intys_congr
-----------
l1: $ p ≐ p $ by ceqt_refl
l2: $ t ≐ t $ by ceqt_refl
l3: $ iprt A p t ⟺ iprt B p t $ by iprt_congr [#1, l1, l2]
l4: $ (ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) ⟺ (ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) $ by iff_refl
l5: $ (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) ⟺ (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) $ by and_congr [l3, l4]
l6: $ ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) ⟺ ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) $ by ex_congr [l5]
l7: $ ∃ n ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) ⟺ ∃ n ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) $ by ex_congr [l6]
l8: $ ∃ t ∃ n ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) ⟺ ∃ t ∃ n ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) $ by ex_congr [l7]
l9: $ ∃ p ∃ t ∃ n ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) ⟺ ∃ p ∃ t ∃ n ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n) $ by ex_congr [l8]
l10: $ {y | ∃ p ∃ t ∃ n ∃ m (iprt A p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n)} ≐ {y | ∃ p ∃ t ∃ n ∃ m (iprt B p t ∧ ra_ntys t n m ∈ lrel ∧ y ∊ fv nvf n)} $ by cab_congr [l9]

sb_c_intys
----------
l1: $ (⟦ x / t ⟧ {y | ∃ p ∃ q ∃ n ∃ m (iprt A p q ∧ ra_ntys q n m ∈ lrel ∧ y ∊ fv nvf n)}) ≐ {y | ∃ p ∃ q ∃ n ∃ m (iprt (⟦ x / t ⟧ A) p q ∧ ra_ntys q n m ∈ lrel ∧ y ∊ fv nvf n)} $ by ceqt_refl

lemma c4_node2 (G: hyps) (K: class) (a b: set): $ G ⇒ K ∈ ω $ > $ G ⇒ ⟨ K , scons a (scons b ∅) ⟩ ∈ trees ω $ > $ G ⇒ a ∈ fv tsub ⟨ K , scons a (scons b ∅) ⟩ ∧ b ∈ fv tsub ⟨ K , scons a (scons b ∅) ⟩ $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset K $ by wcel_isset [#1]
l3: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by trees_kids2 [l1, #2, l2]
l4: $ G ⇒ a ∊ trees ω $ by and_elim_l [l3]
l5: $ G ⇒ b ∊ trees ω $ by and_elim_r [l3]
l6: $ G ⇒ a ∈ trees ω $ by welc_wcel [l4]
l7: $ G ⇒ b ∈ trees ω $ by welc_wcel [l5]
f0: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
f1: $ G ⇒ scons b ∅ ∈ fseq (trees ω) $ by scons_fseq_c [l7, f0]
k0: $ G ⇒ a ∈ fv tsub ⟨ K , scons a (scons b ∅) ⟩ $ by tsub_kid0 [#1, l6, f1]
k1: $ G ⇒ b ∈ fv tsub ⟨ K , scons a (scons b ∅) ⟩ $ by tsub_kid1 [#1, l6, l7, f0]
k2: $ G ⇒ a ∈ fv tsub ⟨ K , scons a (scons b ∅) ⟩ ∧ b ∈ fv tsub ⟨ K , scons a (scons b ∅) ⟩ $ by and_intro [k0, k1]

lemma c4_node3 (G: hyps) (K: class) (a b e: set): $ G ⇒ K ∈ ω $ > $ G ⇒ ⟨ K , scons a (scons b (scons e ∅)) ⟩ ∈ trees ω $ > $ G ⇒ a ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ ∧ b ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ ∧ e ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset K $ by wcel_isset [#1]
l3: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω ∧ e ∊ trees ω $ by trees_kids3 [l1, #2, l2]
l4: $ G ⇒ a ∊ trees ω $ by and_elim_l [l3]
l4b: $ G ⇒ b ∊ trees ω ∧ e ∊ trees ω $ by and_elim_r [l3]
l5: $ G ⇒ b ∊ trees ω $ by and_elim_l [l4b]
l5b: $ G ⇒ e ∊ trees ω $ by and_elim_r [l4b]
l6: $ G ⇒ a ∈ trees ω $ by welc_wcel [l4]
l7: $ G ⇒ b ∈ trees ω $ by welc_wcel [l5]
l8: $ G ⇒ e ∈ trees ω $ by welc_wcel [l5b]
f0: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
f1: $ G ⇒ scons e ∅ ∈ fseq (trees ω) $ by scons_fseq_c [l8, f0]
f2: $ G ⇒ scons b (scons e ∅) ∈ fseq (trees ω) $ by scons_fseq_c [l7, f1]
k0: $ G ⇒ a ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ $ by tsub_kid0 [#1, l6, f2]
k1: $ G ⇒ b ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ $ by tsub_kid1 [#1, l6, l7, f1]
k2: $ G ⇒ e ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ $ by tsub_kid2 [#1, l6, l7, l8, f0]
k3: $ G ⇒ b ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ ∧ e ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ $ by and_intro [k1, k2]
k4: $ G ⇒ a ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ ∧ b ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ ∧ e ∈ fv tsub ⟨ K , scons a (scons b (scons e ∅)) ⟩ $ by and_intro [k0, k3]

lemma c4_node4 (G: hyps) (K: class) (a b e h: set): $ G ⇒ K ∈ ω $ > $ G ⇒ ⟨ K , scons a (scons b (scons e (scons h ∅))) ⟩ ∈ trees ω $ > $ G ⇒ b ∈ fv tsub ⟨ K , scons a (scons b (scons e (scons h ∅))) ⟩ ∧ e ∈ fv tsub ⟨ K , scons a (scons b (scons e (scons h ∅))) ⟩ $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset K $ by wcel_isset [#1]
e0: $ G ⇒ isset ∅ $ by ax_empty
e1: $ G ⇒ isset (scons h ∅) $ by scons_set [e0]
e2: $ G ⇒ isset (scons e (scons h ∅)) $ by scons_set [e1]
e3: $ G ⇒ isset (scons b (scons e (scons h ∅))) $ by scons_set [e2]
e4: $ G ⇒ isset (scons a (scons b (scons e (scons h ∅)))) $ by scons_set [e3]
l3: $ G ⇒ K ∈ ω ∧ scons a (scons b (scons e (scons h ∅))) ∈ fseq (trees ω) $ by trees_node_c [l1, #2, l2, e4]
l4: $ G ⇒ scons a (scons b (scons e (scons h ∅))) ∈ fseq (trees ω) $ by and_elim_r [l3]
c0: $ G ⇒ crn (scons a (scons b (scons e (scons h ∅)))) ⊆ trees ω $ by fseq_crn_c [l4]
s0: $ G ⇒ isset a $ by isset_var
h0: $ G ⇒ a ∈ trees ω $ by crn_scons_head [s0, c0]
c1: $ G ⇒ crn (scons b (scons e (scons h ∅))) ⊆ trees ω $ by crn_scons_tail [c0]
s1: $ G ⇒ isset b $ by isset_var
h1: $ G ⇒ b ∈ trees ω $ by crn_scons_head [s1, c1]
c2: $ G ⇒ crn (scons e (scons h ∅)) ⊆ trees ω $ by crn_scons_tail [c1]
s2: $ G ⇒ isset e $ by isset_var
h2: $ G ⇒ e ∈ trees ω $ by crn_scons_head [s2, c2]
c3: $ G ⇒ crn (scons h ∅) ⊆ trees ω $ by crn_scons_tail [c2]
s3: $ G ⇒ isset h $ by isset_var
h3: $ G ⇒ h ∈ trees ω $ by crn_scons_head [s3, c3]
f0: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
f1: $ G ⇒ scons h ∅ ∈ fseq (trees ω) $ by scons_fseq_c [h3, f0]
f2: $ G ⇒ scons e (scons h ∅) ∈ fseq (trees ω) $ by scons_fseq_c [h2, f1]
k1: $ G ⇒ b ∈ fv tsub ⟨ K , scons a (scons b (scons e (scons h ∅))) ⟩ $ by tsub_kid1 [#1, h0, h1, f2]
k2: $ G ⇒ e ∈ fv tsub ⟨ K , scons a (scons b (scons e (scons h ∅))) ⟩ $ by tsub_kid2 [#1, h0, h1, h2, f1]
k3: $ G ⇒ b ∈ fv tsub ⟨ K , scons a (scons b (scons e (scons h ∅))) ⟩ ∧ e ∈ fv tsub ⟨ K , scons a (scons b (scons e (scons h ∅))) ⟩ $ by and_intro [k1, k2]

lemma c4_iprt_tsub_s (G: hyps) (d b p t: set): $ G ⇒ ra_ind_data d b p t ∈ lrel $ > $ G ⇒ p ∈ fv tsub d ∧ t ∈ fv tsub d $
----
a1: $ G ⇒ ∃ x ∃ y ∃ z (d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z) ∨ ∃ x ∃ y ∃ z ∃ w (d = ⟨ kc_ind_mkn , scons x (scons y (scons z (scons w ∅))) ⟩ ∧ b = x ∧ p = y ∧ t = z) $ by lrel_ind_data_cases [#1]
a2: $ G ⇒ kr_ind_data ∈ ω $ by kr_ind_data_omega
a3: $ G ⇒ isset kr_ind_data $ by wcel_isset [a2]
a4: $ G ⇒ d ∊ trees ω ∧ b ∊ trees ω ∧ p ∊ trees ω ∧ t ∊ trees ω $ by lrel_args4 [#1, a3]
a5: $ G ⇒ d ∊ trees ω $ by and_elim_l [a4]
a6: $ G ⇒ d ∈ trees ω $ by welc_wcel [a5]
c1: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z $ by ax
c2: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ $ by and_elim_l [c1]
c3: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ b = x ∧ p = y ∧ t = z $ by and_elim_r [c1]
c4: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ p = y ∧ t = z $ by and_elim_r [c3]
c5: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ p = y $ by and_elim_l [c4]
c6: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ t = z $ by and_elim_r [c4]
c7: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ d ∈ trees ω $ by weaken [a6]
c8: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∈ trees ω $ by wcel_eq_l [c2, c7]
c9: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ kc_ind_mk ∈ ω $ by kc_ind_mk_omega
c10: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ x ∈ fv tsub ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ y ∈ fv tsub ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ z ∈ fv tsub ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ $ by c4_node3 [c9, c8]
c11: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ y ∈ fv tsub ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ z ∈ fv tsub ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ $ by and_elim_r [c10]
c12: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ y ∈ fv tsub ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ $ by and_elim_l [c11]
c13: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ z ∈ fv tsub ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ $ by and_elim_r [c11]
c14: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ = d $ by eq_sym [c2]
c15: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ tsub = tsub $ by eq_refl
c16: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ fv tsub ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ = fv tsub d $ by fv_eq [c15, c14]
c17: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ y ∈ fv tsub d $ by wcel_eq_r [c16, c12]
c18: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ z ∈ fv tsub d $ by wcel_eq_r [c16, c13]
c19: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ y = p $ by eq_sym [c5]
c20: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ p ∈ fv tsub d $ by wcel_eq_l [c19, c17]
c21: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ z = t $ by eq_sym [c6]
c22: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ t ∈ fv tsub d $ by wcel_eq_l [c21, c18]
c23: $ G , d = ⟨ kc_ind_mk , scons x (scons y (scons z ∅)) ⟩ ∧ b = x ∧ p = y ∧ t = z ⇒ p ∈ fv tsub d ∧ t ∈ fv tsub d $ by and_intro [c20, c22]
