lemma c1_kid (G: hyps) (K S A B: class): $ G ⇒ K ∈ ω $ > $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ ⟨ B , A ⟩ ∈ S $ > $ G ⇒ A ∈ fv tsub ⟨ K , S ⟩ $
----
c1: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ ⟨ B , A ⟩ ∈ S $ by weaken [#5]
c2a: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ b = B $ by ax
c2b: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ a = A $ by ax
c2c: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ h = S $ by ax
c3: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ ⟨ b , a ⟩ = ⟨ B , A ⟩ $ by opair_eq [c2a, c2b]
c3b: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ ⟨ B , A ⟩ = ⟨ b , a ⟩ $ by eq_sym [c3]
c4: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ ⟨ b , a ⟩ ∈ S $ by wcel_eq_l [c3b, c1]
c5: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ S = h $ by eq_sym [c2c]
c6: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ ⟨ b , a ⟩ ∈ h $ by wcel_eq_r [c5, c4]
c7: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ b ∊ cdm h $ by cdm_intro [c6]
c8a: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ h ∊ fseq (trees ω) $ by ax
c8: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ functional h $ by fseq_functional [c8a]
c9: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ fv h b = a $ by fv_val [c8, c6]
c9b: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ h ∈ fseq (trees ω) $ by welc_wcel [c8a]
c10: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ fv tsub (fv h b) ⊆ psub h $ by psub_child [c9b, c7]
c11: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ fv h b ∈ trees ω $ by fseq_fv [c8a, c7]
c12: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ a ∈ trees ω $ by wcel_eq_l [c9, c11]
c13: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ a ∈ fv tsub a $ by tsub_self [c12]
c13b: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ tsub = tsub $ by eq_refl
c14: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ fv tsub (fv h b) = fv tsub a $ by fv_eq [c13b, c9]
c15: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ fv tsub a ⊆ psub h $ by subset_eq_l [c14, c10]
c16: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ a ∈ psub h $ by wcel_subset [c15, c13]
c17: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ a ∈ csn ⟨ K , h ⟩ ∪ psub h $ by cun_intro_r_c [c16]
c18: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ K ∈ ω $ by weaken [#1]
c18b: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ h ∈ fseq (trees ω) $ by welc_wcel [c8a]
c19: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ K , h ⟩ = csn ⟨ K , h ⟩ ∪ psub h $ by tsub_node_c [c18, c18b]
c20: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ csn ⟨ K , h ⟩ ∪ psub h = fv tsub ⟨ K , h ⟩ $ by eq_sym [c19]
c21: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ a ∈ fv tsub ⟨ K , h ⟩ $ by wcel_eq_r [c20, c17]
c22a: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ K = K $ by eq_refl
c22: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ ⟨ K , h ⟩ = ⟨ K , S ⟩ $ by opair_eq [c22a, c2c]
c23: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ fv tsub ⟨ K , h ⟩ = fv tsub ⟨ K , S ⟩ $ by fv_eq [c13b, c22]
c24: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ a ∈ fv tsub ⟨ K , S ⟩ $ by wcel_eq_r [c23, c21]
c25: $ G , b = B , a = A , h = S , h ∊ fseq (trees ω) ⇒ A ∈ fv tsub ⟨ K , S ⟩ $ by wcel_eq_l [c2b, c24]
d1: $ G , b = B , a = A ⇒ A ∈ fv tsub ⟨ K , S ⟩ $ by wcel_elim [#2, c25]
d2: $ G , b = B ⇒ A ∈ fv tsub ⟨ K , S ⟩ $ by isset_elim [#3, d1]
d3: $ G ⇒ A ∈ fv tsub ⟨ K , S ⟩ $ by isset_elim [#4, d2]

lemma c1_scons_suc (G: hyps) (A T J Y: class): $ G ⇒ isset J $ > $ G ⇒ isset Y $ > $ G ⇒ ⟨ J , Y ⟩ ∈ T $ > $ G ⇒ ⟨ suc J , Y ⟩ ∈ scons A T $
----
c1: $ G , j = J , e = Y ⇒ ⟨ J , Y ⟩ ∈ T $ by weaken [#3]
c1a: $ G , j = J , e = Y ⇒ j = J $ by ax
c1b: $ G , j = J , e = Y ⇒ e = Y $ by ax
c2: $ G , j = J , e = Y ⇒ ⟨ j , e ⟩ = ⟨ J , Y ⟩ $ by opair_eq [c1a, c1b]
c2b: $ G , j = J , e = Y ⇒ ⟨ J , Y ⟩ = ⟨ j , e ⟩ $ by eq_sym [c2]
c3: $ G , j = J , e = Y ⇒ ⟨ j , e ⟩ ∈ T $ by wcel_eq_l [c2b, c1]
d1: $ G , j = J , e = Y , z = ⟨ suc j , e ⟩ ⇒ z = ⟨ suc j , e ⟩ $ by ax
d2: $ G , j = J , e = Y , z = ⟨ suc j , e ⟩ ⇒ ⟨ j , e ⟩ ∈ T $ by weaken [c3]
d3: $ G , j = J , e = Y , z = ⟨ suc j , e ⟩ ⇒ z = ⟨ suc j , e ⟩ ∧ ⟨ j , e ⟩ ∈ T $ by and_intro [d1, d2]
d4: $ G , j = J , e = Y , z = ⟨ suc j , e ⟩ ⇒ ∃ y (z = ⟨ suc j , y ⟩ ∧ ⟨ j , y ⟩ ∈ T) $ by ex_intro [d3]
d5: $ G , j = J , e = Y , z = ⟨ suc j , e ⟩ ⇒ ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ T) $ by ex_intro [d4]
c4: $ G , j = J , e = Y ⇒ isset ⟨ suc j , e ⟩ $ by opair_isset
c5: $ G , j = J , e = Y ⇒ ⟨ suc j , e ⟩ ∈ {x3 | ∃ i ∃ y (x3 = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ T)} $ by wcel_cab_intro [c4, d5]
c6: $ G , j = J , e = Y ⇒ ⟨ suc j , e ⟩ ∈ csn ⟨ ∅ , A ⟩ ∪ {x3 | ∃ i ∃ y (x3 = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ T)} $ by cun_intro_r_c [c5]
c7a: $ G , j = J , e = Y ⇒ suc j = suc J $ by suc_eq [c1a]
c7: $ G , j = J , e = Y ⇒ ⟨ suc j , e ⟩ = ⟨ suc J , Y ⟩ $ by opair_eq [c7a, c1b]
c8: $ G , j = J , e = Y ⇒ ⟨ suc J , Y ⟩ ∈ scons A T $ by wcel_eq_l [c7, c6]
f1: $ G , j = J ⇒ ⟨ suc J , Y ⟩ ∈ scons A T $ by isset_elim [#2, c8]
f2: $ G ⇒ ⟨ suc J , Y ⟩ ∈ scons A T $ by isset_elim [#1, f1]

lemma c1_scons_zero (G: hyps) (A T: class): $ G ⇒ ⟨ ∅ , A ⟩ ∈ scons A T $
----
k4: $ G ⇒ isset ⟨ ∅ , A ⟩ $ by opair_isset
k5: $ G ⇒ ⟨ ∅ , A ⟩ ∈ cpr ⟨ ∅ , A ⟩ ⟨ ∅ , A ⟩ $ by cpr_intro_l_c [k4]
k6: $ G ⇒ ⟨ ∅ , A ⟩ ∈ csn ⟨ ∅ , A ⟩ ∪ {x3 | ∃ i ∃ y (x3 = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ T)} $ by cun_intro_l_c [k5]
k7: $ G ⇒ ⟨ ∅ , A ⟩ ∈ scons A T $ by weaken [k6]

