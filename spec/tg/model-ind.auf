lemma c4_nty_nvf_s (G: hyps) (t j l f c g d: set): $ G ⇒ ra_nth_ty t j f c ∈ lrel $ > $ G ⇒ ra_nth_ty t l g d ∈ lrel $ > $ G ⇒ fv nvf j = fv nvf l $ > $ G ⇒ f = g ∧ c = d $
----
m0: $ G ⇒ isset j $ by isset_var
m1: $ G ⇒ fv nvf j ∈ ω $ by nvf_omega [m0]
b1: $ G , m = fv nvf j , m ∊ ω , z = ∅ , ra_nth_ty a b f c ∈ lrel , ra_nth_ty a o g d ∈ lrel , fv nvf b = fv nvf o , fv nvf b = z , ra_nth_ty x i f c ∈ lrel , ra_nth_ty x k g d ∈ lrel , fv nvf i = fv nvf k , suc (fv nvf i) = fv nvf b ⇒ suc (fv nvf i) = fv nvf b $ by ax
b2: $ G , m = fv nvf j , m ∊ ω , z = ∅ , ra_nth_ty a b f c ∈ lrel , ra_nth_ty a o g d ∈ lrel , fv nvf b = fv nvf o , fv nvf b = z , ra_nth_ty x i f c ∈ lrel , ra_nth_ty x k g d ∈ lrel , fv nvf i = fv nvf k , suc (fv nvf i) = fv nvf b ⇒ fv nvf b = z $ by ax
b3: $ G , m = fv nvf j , m ∊ ω , z = ∅ , ra_nth_ty a b f c ∈ lrel , ra_nth_ty a o g d ∈ lrel , fv nvf b = fv nvf o , fv nvf b = z , ra_nth_ty x i f c ∈ lrel , ra_nth_ty x k g d ∈ lrel , fv nvf i = fv nvf k , suc (fv nvf i) = fv nvf b ⇒ z = ∅ $ by ax
b4: $ G , m = fv nvf j , m ∊ ω , z = ∅ , ra_nth_ty a b f c ∈ lrel , ra_nth_ty a o g d ∈ lrel , fv nvf b = fv nvf o , fv nvf b = z , ra_nth_ty x i f c ∈ lrel , ra_nth_ty x k g d ∈ lrel , fv nvf i = fv nvf k , suc (fv nvf i) = fv nvf b ⇒ suc (fv nvf i) = z $ by eq_trans [b1, b2]
b5: $ G , m = fv nvf j , m ∊ ω , z = ∅ , ra_nth_ty a b f c ∈ lrel , ra_nth_ty a o g d ∈ lrel , fv nvf b = fv nvf o , fv nvf b = z , ra_nth_ty x i f c ∈ lrel , ra_nth_ty x k g d ∈ lrel , fv nvf i = fv nvf k , suc (fv nvf i) = fv nvf b ⇒ suc (fv nvf i) = ∅ $ by eq_trans [b4, b3]
b6: $ G , m = fv nvf j , m ∊ ω , z = ∅ , ra_nth_ty a b f c ∈ lrel , ra_nth_ty a o g d ∈ lrel , fv nvf b = fv nvf o , fv nvf b = z , ra_nth_ty x i f c ∈ lrel , ra_nth_ty x k g d ∈ lrel , fv nvf i = fv nvf k , suc (fv nvf i) = fv nvf b ⇒ ⊥ $ by suc_ne_empty [b5]
b7: $ G , m = fv nvf j , m ∊ ω , z = ∅ , ra_nth_ty a b f c ∈ lrel , ra_nth_ty a o g d ∈ lrel , fv nvf b = fv nvf o , fv nvf b = z , ra_nth_ty x i f c ∈ lrel , ra_nth_ty x k g d ∈ lrel , fv nvf i = fv nvf k , suc (fv nvf i) = fv nvf b ⇒ f = g ∧ c = d $ by bot_elim [b6]
