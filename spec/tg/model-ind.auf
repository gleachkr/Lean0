s11a: $ G , b = clam d u (da (fv v (suc ∅)) w (scons d r)) ⇒ cgr i {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (i = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons (da (fv v ∅) w r) x8 , x9 ⟩ ⟩ ⟩)} = cgr i {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (i = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons (da (fv v ∅) w r) x8 , x9 ⟩ ⟩ ⟩)} $ by eq_refl
s11b: $ G , b = clam d u (da (fv v (suc ∅)) w (scons d r)) ⇒ b = clam d u (da (fv v (suc ∅)) w (scons d r)) $ by ax
s11: $ G , b = clam d u (da (fv v (suc ∅)) w (scons d r)) ⇒ img (cgr i {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (i = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons (da (fv v ∅) w r) x8 , x9 ⟩ ⟩ ⟩)}) b = img (cgr i {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (i = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons (da (fv v ∅) w r) x8 , x9 ⟩ ⟩ ⟩)}) (clam d u (da (fv v (suc ∅)) w (scons d r))) $ by img_eq [s11a, s11b]
s12: $ G , b = clam d u (da (fv v (suc ∅)) w (scons d r)) ⇒ isset (img (cgr i {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (i = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons (da (fv v ∅) w r) x8 , x9 ⟩ ⟩ ⟩)}) (clam d u (da (fv v (suc ∅)) w (scons d r)))) $ by isset_eq [s11, s10]
s13: $ G ⇒ isset (img (cgr i {o | ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (i = ⟨ x5 , ⟨ x6 , ⟨ x7 , ⟨ x8 , x9 ⟩ ⟩ ⟩ ⟩ ∧ o ∊ ⟨ ssnoc x6 x5 , ⟨ scons x5 x7 , ⟨ scons (da (fv v ∅) w r) x8 , x9 ⟩ ⟩ ⟩)}) (clam d u (da (fv v (suc ∅)) w (scons d r)))) $ by isset_elim [s8, s12]
