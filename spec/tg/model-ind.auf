b15: $ G , z = ∅ ⇒ ⟨ a , Y ⟩ = c2_nv s ⟨ a , Y ⟩ z $ by eq_sym [b14]
b16: $ G , z = ∅ ⇒ c2_nv (scons a s) Y (suc z) = c2_nv s ⟨ a , Y ⟩ z $ by eq_trans [b11, b15]
c0: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ y ∊ ω $ by ax
c1: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ z = suc y $ by ax
c2: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ suc y ∈ ω $ by omega_suc [c0]
c2b: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ suc y = z $ by eq_sym [c1]
c3: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ z ∈ ω $ by wcel_eq_l [c2b, c2]
c4: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ z ∊ ω $ by wcel_welc [c3]
c5a: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ isset Y $ by weaken [#1]
c5: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv (scons a s) Y (suc z) = ⟨ fv (scons a s) z , c2_nv (scons a s) Y z ⟩ $ by c2_nv_suc [c5a, c4]
c6a: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ scons a s = scons a s $ by eq_refl
c6: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ fv (scons a s) z = fv (scons a s) (suc y) $ by fv_eq [c6a, c1]
c7: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ fv (scons a s) (suc y) = fv s y $ by scons_fv_suc
c8: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ fv (scons a s) z = fv s y $ by eq_trans [c6, c7]
c9: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv (scons a s) Y z = c2_nv (scons a s) Y (suc y) $ by c2_nv_eqn [c1]
c9b: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y $ by ax
c10: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv (scons a s) Y z = c2_nv s ⟨ a , Y ⟩ y $ by eq_trans [c9, c9b]
c11: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ ⟨ fv (scons a s) z , c2_nv (scons a s) Y z ⟩ = ⟨ fv s y , c2_nv s ⟨ a , Y ⟩ y ⟩ $ by opair_eq [c8, c10]
c12a: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ isset ⟨ a , Y ⟩ $ by opair_isset
c12: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv s ⟨ a , Y ⟩ (suc y) = ⟨ fv s y , c2_nv s ⟨ a , Y ⟩ y ⟩ $ by c2_nv_suc [c12a, c0]
c13: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv s ⟨ a , Y ⟩ z = c2_nv s ⟨ a , Y ⟩ (suc y) $ by c2_nv_eqn [c1]
c14: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv s ⟨ a , Y ⟩ z = ⟨ fv s y , c2_nv s ⟨ a , Y ⟩ y ⟩ $ by eq_trans [c13, c12]
c15: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv (scons a s) Y (suc z) = ⟨ fv s y , c2_nv s ⟨ a , Y ⟩ y ⟩ $ by eq_trans [c5, c11]
c15b: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ ⟨ fv s y , c2_nv s ⟨ a , Y ⟩ y ⟩ = c2_nv s ⟨ a , Y ⟩ z $ by eq_sym [c14]
c16: $ G , y ∊ ω , c2_nv (scons a s) Y (suc y) = c2_nv s ⟨ a , Y ⟩ y , z = suc y ⇒ c2_nv (scons a s) Y (suc z) = c2_nv s ⟨ a , Y ⟩ z $ by eq_trans [c15, c15b]
