q5: $ G , a = A , a ∊ trees ω , b = T , b ∊ trees ω ⇒ esat u E ⟨ kc_cons , scons A (scons T ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q) } $ by isset_elim [q5a, q4]
q6a: $ G , a = A , a ∊ trees ω ⇒ T ∈ trees ω $ by weaken [#2]
q6: $ G , a = A , a ∊ trees ω ⇒ esat u E ⟨ kc_cons , scons A (scons T ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q) } $ by wcel_elim [q6a, q5]
q7: $ G ⇒ esat u E ⟨ kc_cons , scons A (scons T ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q) } $ by wcel_elim [#1, q6]

lemma c3_cc_mem {o p: set} (G: hyps) (u: set) (X: class o p) (w r m: set):
  $ G ⇒ m ∊ ap (ap (clam o lvals (clam p (fseq u) X)) w) r $ >
  $ G ⇒ w ∊ lvals ∧ r ∊ fseq u ∧ m ∊ (⟦ p / r ⟧ (⟦ o / w ⟧ X)) $
----
a1: $ G ⇒ ⟨ r , m ⟩ ∈ ap (clam o lvals (clam p (fseq u) X)) w $ by ap_elim [#1]
b1: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ y ∊ ap (clam o lvals (clam p (fseq u) X)) w $ by ax
b2: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ ⟨ w , y ⟩ ∈ clam o lvals (clam p (fseq u) X) $ by ap_elim [b1]
b3: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ w ∊ lvals ∧ y ∊ (⟦ o / w ⟧ (clam p (fseq u) X)) $ by clam_elim [b2]
b4: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ w ∊ lvals $ by and_elim_l [b3]
b5: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ y ∊ clam p (fseq u) (⟦ o / w ⟧ X) $ by and_elim_r [b3]
b6: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ y = ⟨ r , m ⟩ $ by ax
b7: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ ⟨ r , m ⟩ ∈ clam p (fseq u) (⟦ o / w ⟧ X) $ by wcel_intro [b6, b5]
b8: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ r ∊ fseq u ∧ m ∊ (⟦ p / r ⟧ (⟦ o / w ⟧ X)) $ by clam_elim [b7]
b9: $ G , y = ⟨ r , m ⟩ , y ∊ ap (clam o lvals (clam p (fseq u) X)) w ⇒ w ∊ lvals ∧ r ∊ fseq u ∧ m ∊ (⟦ p / r ⟧ (⟦ o / w ⟧ X)) $ by and_intro [b4, b8]
c1: $ G ⇒ w ∊ lvals ∧ r ∊ fseq u ∧ m ∊ (⟦ p / r ⟧ (⟦ o / w ⟧ X)) $ by wcel_elim [a1, b9]

lemma c3_dacc_dom (G: hyps) (F A W Q: class) (s c i: set):
  $ G ⇒ c = ccom F s $ > $ G ⇒ A ∈ da (fv c i) W Q $ > $ G ⇒ i ∊ cdm s $
----
a1: $ G , b = A , b ∊ da (fv c i) W Q ⇒ b ∊ ap (ap (fv c i) W) Q $ by ax
a2: $ G , b = A , b ∊ da (fv c i) W Q ⇒ ⟨ Q , b ⟩ ∈ ap (fv c i) W $ by ap_elim [a1]
d1: $ G , e = ⟨ Q , b ⟩ , e ∊ ap (fv c i) W ⇒ e ∊ ap (fv c i) W $ by ax
d2: $ G , e = ⟨ Q , b ⟩ , e ∊ ap (fv c i) W ⇒ ⟨ W , e ⟩ ∈ fv c i $ by ap_elim [d1]
h1: $ G , h = ⟨ W , e ⟩ , h ∊ fv c i ⇒ h ∊ ⋃ (ap c i) $ by ax
y1: $ G , y ∊ ap c i , h ∊ y ⇒ y ∊ ap c i $ by ax
y2: $ G , y ∊ ap c i , h ∊ y ⇒ ⟨ i , y ⟩ ∈ c $ by ap_elim [y1]
y3: $ G , y ∊ ap c i , h ∊ y ⇒ c = ccom F s $ by weaken [#1]
y4: $ G , y ∊ ap c i , h ∊ y ⇒ ⟨ i , y ⟩ ∈ ccom F s $ by wcel_eq_r [y3, y2]
j1: $ G , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ F ⇒ ⟨ i , j ⟩ ∈ s $ by ax
j2: $ G , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ F ⇒ i ∊ cdm s $ by cdm_intro [j1]
y5: $ G , y ∊ ap c i , h ∊ y ⇒ i ∊ cdm s $ by ccom_elim [y4, j2]
h2: $ G , h = ⟨ W , e ⟩ , h ∊ fv c i ⇒ i ∊ cdm s $ by cuni_elim [h1, y5]
d3: $ G , e = ⟨ Q , b ⟩ , e ∊ ap (fv c i) W ⇒ i ∊ cdm s $ by wcel_elim [d2, h2]
a3: $ G , b = A , b ∊ da (fv c i) W Q ⇒ i ∊ cdm s $ by wcel_elim [a2, d3]
a4: $ G ⇒ i ∊ cdm s $ by wcel_elim [#2, a3]

lemma c3_dacc0 (G: hyps) (F A W Q: class) (s c: set):
  $ G ⇒ c = ccom F s $ > $ G ⇒ A ∈ da (fv c ∅) W Q $ > $ G ⇒ ∅ ∈ cdm s $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
l1: $ G , i = ∅ ⇒ c = c $ by eq_refl
l2: $ G , i = ∅ ⇒ i = ∅ $ by ax
l3: $ G , i = ∅ ⇒ ∅ = i $ by eq_sym [l2]
l4: $ G , i = ∅ ⇒ fv c ∅ = fv c i $ by fv_eq [l1, l3]
l5: $ G , i = ∅ ⇒ W = W $ by eq_refl
l6: $ G , i = ∅ ⇒ Q = Q $ by eq_refl
l7: $ G , i = ∅ ⇒ da (fv c ∅) W Q = da (fv c i) W Q $ by da_eq [l4, l5, l6]
l8: $ G , i = ∅ ⇒ A ∈ da (fv c ∅) W Q $ by weaken [#2]
l9: $ G , i = ∅ ⇒ A ∈ da (fv c i) W Q $ by wcel_eq_r [l7, l8]
l10: $ G , i = ∅ ⇒ c = ccom F s $ by weaken [#1]
l11: $ G , i = ∅ ⇒ i ∊ cdm s $ by c3_dacc_dom [l10, l9]
l12: $ G , i = ∅ ⇒ ∅ ∈ cdm s $ by wcel_intro [l2, l11]
l13: $ G ⇒ ∅ ∈ cdm s $ by isset_elim [l0, l12]

lemma c3_dacc1 (G: hyps) (F A W Q: class) (s c: set):
  $ G ⇒ c = ccom F s $ > $ G ⇒ A ∈ da (fv c (suc ∅)) W Q $ > $ G ⇒ (suc ∅) ∈ cdm s $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
l0a: $ G ⇒ isset (suc ∅) $ by suc_set [l0]
l1: $ G , i = (suc ∅) ⇒ c = c $ by eq_refl
l2: $ G , i = (suc ∅) ⇒ i = (suc ∅) $ by ax
l3: $ G , i = (suc ∅) ⇒ (suc ∅) = i $ by eq_sym [l2]
l4: $ G , i = (suc ∅) ⇒ fv c (suc ∅) = fv c i $ by fv_eq [l1, l3]
l5: $ G , i = (suc ∅) ⇒ W = W $ by eq_refl
l6: $ G , i = (suc ∅) ⇒ Q = Q $ by eq_refl
l7: $ G , i = (suc ∅) ⇒ da (fv c (suc ∅)) W Q = da (fv c i) W Q $ by da_eq [l4, l5, l6]
l8: $ G , i = (suc ∅) ⇒ A ∈ da (fv c (suc ∅)) W Q $ by weaken [#2]
l9: $ G , i = (suc ∅) ⇒ A ∈ da (fv c i) W Q $ by wcel_eq_r [l7, l8]
l10: $ G , i = (suc ∅) ⇒ c = ccom F s $ by weaken [#1]
l11: $ G , i = (suc ∅) ⇒ i ∊ cdm s $ by c3_dacc_dom [l10, l9]
l12: $ G , i = (suc ∅) ⇒ (suc ∅) ∈ cdm s $ by wcel_intro [l2, l11]
l13: $ G ⇒ (suc ∅) ∈ cdm s $ by isset_elim [l0a, l12]

lemma c3_om_zero (G: hyps) (A: class) (s: set): $ G ⇒ s ∊ fseq A $ > $ G ⇒ suc ∅ ∈ cdm s $ > $ G ⇒ ∅ ∈ cdm s $
----
l1: $ G ⇒ cdm s ∈ ω $ by fseq_len [#1]
l2a: $ G , n = cdm s , n ∊ ω ⇒ n ∊ ω $ by ax
l2: $ G , n = cdm s , n ∊ ω ⇒ transitive n $ by omega_elem_trans [l2a]
l3a: $ G , n = cdm s , n ∊ ω ⇒ n = cdm s $ by ax
l3: $ G , n = cdm s , n ∊ ω ⇒ cdm s = n $ by eq_sym [l3a]
l4a: $ G , n = cdm s , n ∊ ω ⇒ suc ∅ ∈ cdm s $ by weaken [#2]
l4: $ G , n = cdm s , n ∊ ω ⇒ suc ∅ ∈ n $ by wcel_eq_r [l3, l4a]
m1: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n ⇒ isset ∅ $ by ax_empty
m2: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n ⇒ ∅ ∈ suc ∅ $ by suc_mem [m1]
m3: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n ⇒ m = suc ∅ $ by ax
m4: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n ⇒ suc ∅ = m $ by eq_sym [m3]
m5: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n ⇒ ∅ ∈ m $ by wcel_eq_r [m4, m2]
e1: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n , e = ∅ , e ∊ m ⇒ transitive n $ by weaken [l2]
e2: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n , e = ∅ , e ∊ m ⇒ m ∊ n $ by ax
e3: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n , e = ∅ , e ∊ m ⇒ e ∊ m $ by ax
e4: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n , e = ∅ , e ∊ m ⇒ e ∊ n $ by transitive_elim [e1, e2, e3]
e5: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n , e = ∅ , e ∊ m ⇒ e = ∅ $ by ax
e6: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n , e = ∅ , e ∊ m ⇒ ∅ ∈ n $ by wcel_intro [e5, e4]
e7: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n , e = ∅ , e ∊ m ⇒ n = cdm s $ by ax
e8: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n , e = ∅ , e ∊ m ⇒ ∅ ∈ cdm s $ by wcel_eq_r [e7, e6]
m6: $ G , n = cdm s , n ∊ ω , m = suc ∅ , m ∊ n ⇒ ∅ ∈ cdm s $ by wcel_elim [m5, e8]
l5: $ G , n = cdm s , n ∊ ω ⇒ ∅ ∈ cdm s $ by wcel_elim [l4, m6]
l6: $ G ⇒ ∅ ∈ cdm s $ by wcel_elim [l1, l5]

lemma c3_child (G: hyps) (F I: class) (s: set):
  $ G ⇒ functional F $ > $ G ⇒ cdm F = trees ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ I ∈ cdm s $ >
  $ G ⇒ fv (ccom F s) I = fv F (fv s I) ∧ fv s I ∈ crn s $
----
k0: $ G , i = I , i ∊ cdm s ⇒ i ∊ cdm s $ by ax
k1: $ G , i = I , i ∊ cdm s ⇒ s ∊ fseq (trees ω) $ by weaken [#3]
k2: $ G , i = I , i ∊ cdm s ⇒ functional s $ by fseq_functional [k1]
k3: $ G , i = I , i ∊ cdm s ⇒ fv s i ∈ trees ω $ by fseq_fv [k1, k0]
k4: $ G , i = I , i ∊ cdm s ⇒ cdm F = trees ω $ by weaken [#2]
k5: $ G , i = I , i ∊ cdm s ⇒ trees ω = cdm F $ by eq_sym [k4]
k6: $ G , i = I , i ∊ cdm s ⇒ fv s i ∈ cdm F $ by wcel_eq_r [k5, k3]
k7: $ G , i = I , i ∊ cdm s ⇒ functional F $ by weaken [#1]
k8: $ G , i = I , i ∊ cdm s ⇒ fv (ccom F s) i = fv F (fv s i) $ by fv_ccom [k7, k2, k0, k6]
k9: $ G , i = I , i ∊ cdm s ⇒ ⟨ i , fv s i ⟩ ∈ s $ by fv_in [k2, k0]
b1: $ G , i = I , i ∊ cdm s , b = fv s i ⇒ b = fv s i $ by ax
b2: $ G , i = I , i ∊ cdm s , b = fv s i ⇒ i = i $ by eq_refl
b3: $ G , i = I , i ∊ cdm s , b = fv s i ⇒ ⟨ i , b ⟩ = ⟨ i , fv s i ⟩ $ by opair_eq [b2, b1]
b4: $ G , i = I , i ∊ cdm s , b = fv s i ⇒ ⟨ i , fv s i ⟩ = ⟨ i , b ⟩ $ by eq_sym [b3]
b5: $ G , i = I , i ∊ cdm s , b = fv s i ⇒ ⟨ i , fv s i ⟩ ∈ s $ by weaken [k9]
b6: $ G , i = I , i ∊ cdm s , b = fv s i ⇒ ⟨ i , b ⟩ ∈ s $ by wcel_eq_l [b4, b5]
b7: $ G , i = I , i ∊ cdm s , b = fv s i ⇒ b ∊ crn s $ by crn_intro [b6]
b8: $ G , i = I , i ∊ cdm s , b = fv s i ⇒ fv s i ∈ crn s $ by wcel_intro [b1, b7]
b9: $ G , i = I , i ∊ cdm s ⇒ isset (fv s i) $ by fv_set [k2]
c1: $ G , i = I , i ∊ cdm s ⇒ fv s i ∈ crn s $ by isset_elim [b9, b8]
c2: $ G , i = I , i ∊ cdm s ⇒ i = I $ by ax
c3: $ G , i = I , i ∊ cdm s ⇒ s = s $ by eq_refl
c4: $ G , i = I , i ∊ cdm s ⇒ fv s i = fv s I $ by fv_eq [c3, c2]
c5: $ G , i = I , i ∊ cdm s ⇒ ccom F s = ccom F s $ by eq_refl
c6: $ G , i = I , i ∊ cdm s ⇒ fv (ccom F s) i = fv (ccom F s) I $ by fv_eq [c5, c2]
c7: $ G , i = I , i ∊ cdm s ⇒ F = F $ by eq_refl
c8: $ G , i = I , i ∊ cdm s ⇒ fv F (fv s i) = fv F (fv s I) $ by fv_eq [c7, c4]
c9: $ G , i = I , i ∊ cdm s ⇒ fv (ccom F s) I = fv (ccom F s) i $ by eq_sym [c6]
d1: $ G , i = I , i ∊ cdm s ⇒ fv (ccom F s) I = fv F (fv s i) $ by eq_trans [c9, k8]
d2: $ G , i = I , i ∊ cdm s ⇒ fv (ccom F s) I = fv F (fv s I) $ by eq_trans [d1, c8]
d3: $ G , i = I , i ∊ cdm s ⇒ crn s = crn s $ by eq_refl
d4: $ G , i = I , i ∊ cdm s ⇒ fv s I ∈ crn s $ by wcel_eq_l [c4, c1]
d5: $ G , i = I , i ∊ cdm s ⇒ fv (ccom F s) I = fv F (fv s I) ∧ fv s I ∈ crn s $ by and_intro [d2, d4]
d6: $ G ⇒ fv (ccom F s) I = fv F (fv s I) ∧ fv s I ∈ crn s $ by wcel_elim [#4, d5]

esf_cdm
-------
l1: $ G ⇒ functional (cgr3 k j v (esb u E k j v)) $ by cgr3_functional
l2: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ cdm (trc ω (cgr3 k j v (esb u E k j v))) = trees ω $ by trc_cdm_c [l2, l1]

lemma c3_fvcc_dom (G: hyps) (F A: class) (s c i: set): $ G ⇒ c = ccom F s $ > $ G ⇒ A ∈ fv c i $ > $ G ⇒ i ∊ cdm s $
----
h1: $ G , h = A , h ∊ fv c i ⇒ h ∊ ⋃ (ap c i) $ by ax
y1: $ G , y ∊ ap c i , h ∊ y ⇒ y ∊ ap c i $ by ax
y2: $ G , y ∊ ap c i , h ∊ y ⇒ ⟨ i , y ⟩ ∈ c $ by ap_elim [y1]
y3: $ G , y ∊ ap c i , h ∊ y ⇒ c = ccom F s $ by weaken [#1]
y4: $ G , y ∊ ap c i , h ∊ y ⇒ ⟨ i , y ⟩ ∈ ccom F s $ by wcel_eq_r [y3, y2]
j1: $ G , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ F ⇒ ⟨ i , j ⟩ ∈ s $ by ax
j2: $ G , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ F ⇒ i ∊ cdm s $ by cdm_intro [j1]
y5: $ G , y ∊ ap c i , h ∊ y ⇒ i ∊ cdm s $ by ccom_elim [y4, j2]
h2: $ G , h = A , h ∊ fv c i ⇒ i ∊ cdm s $ by cuni_elim [h1, y5]
a4: $ G ⇒ i ∊ cdm s $ by wcel_elim [#2, h2]

lemma c3_apcc1 (G: hyps) (F W: class) (s c q: set): $ G ⇒ c = ccom F s $ > $ G ⇒ q ∊ ap (fv c (suc ∅)) W $ > $ G ⇒ suc ∅ ∈ cdm s $
----
l0: $ G ⇒ isset ∅ $ by ax_empty
l0a: $ G ⇒ isset (suc ∅) $ by suc_set [l0]
l1: $ G , i = suc ∅ ⇒ c = c $ by eq_refl
l2: $ G , i = suc ∅ ⇒ i = suc ∅ $ by ax
l3: $ G , i = suc ∅ ⇒ suc ∅ = i $ by eq_sym [l2]
l4: $ G , i = suc ∅ ⇒ fv c (suc ∅) = fv c i $ by fv_eq [l1, l3]
l5: $ G , i = suc ∅ ⇒ q ∊ ap (fv c (suc ∅)) W $ by weaken [#2]
l6: $ G , i = suc ∅ ⇒ ⟨ W , q ⟩ ∈ fv c (suc ∅) $ by ap_elim [l5]
l7: $ G , i = suc ∅ ⇒ ⟨ W , q ⟩ ∈ fv c i $ by wcel_eq_r [l4, l6]
l8: $ G , i = suc ∅ ⇒ c = ccom F s $ by weaken [#1]
l9: $ G , i = suc ∅ ⇒ i ∊ cdm s $ by c3_fvcc_dom [l8, l7]
l10: $ G , i = suc ∅ ⇒ suc ∅ ∈ cdm s $ by wcel_intro [l2, l9]
l11: $ G ⇒ suc ∅ ∈ cdm s $ by isset_elim [l0a, l10]

lemma c3_esq_ex2 {x q: set} (G: hyps) (M M2 A F: class) (s c w r: set):
  $ G ⇒ c = ccom F s $ > $ G ⇒ suc ∅ ∈ cdm s → fv M A = fv M2 A $ >
  $ G ⇒ (∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $
----
p1: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q $ by ax
p2: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ ap (fv c (suc ∅)) w $ by and_elim_l [p1]
p3: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M A) w q ∧ r = scons x q $ by and_elim_r [p1]
p4: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M A) w q $ by and_elim_l [p3]
p5: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ r = scons x q $ by and_elim_r [p3]
s1a: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ c = ccom F s $ by weaken [#1]
s1: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ suc ∅ ∈ cdm s $ by c3_apcc1 [s1a, p2]
s2a: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ suc ∅ ∈ cdm s → fv M A = fv M2 A $ by weaken [#2]
s2: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ fv M A = fv M2 A $ by imp_elim [s2a, s1]
s3a: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ w = w $ by eq_refl
s3b: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q = q $ by eq_refl
s3: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ da (fv M A) w q = da (fv M2 A) w q $ by da_eq [s2, s3a, s3b]
s4: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M2 A) w q $ by welc_eq [s3, p4]
s5: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M2 A) w q ∧ r = scons x q $ by and_intro [s4, p5]
s6: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q $ by and_intro [p2, s5]
s7: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by ex_intro [s6]
s8: $ G , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by ex_intro [s7]
s9: $ G , ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by ax
s10: $ G , ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by ex_elim [s9, s8]
s11: $ G , ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by ax
s12: $ G , ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by ex_elim [s11, s10]
s13: $ G ⇒ (∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by imp_intro [s12]

lemma c3_esq_eq2 {r x q: set} (G: hyps) (U M M2 A F: class) (s c w: set):
  $ G ⇒ c = ccom F s $ > $ G ⇒ suc ∅ ∈ cdm s → fv M A = fv M2 A $ >
  $ G ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} = {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} $
----
h1: $ G , suc ∅ ∈ cdm s ⇒ suc ∅ ∈ cdm s → fv M A = fv M2 A $ by weaken [#2]
h2: $ G , suc ∅ ∈ cdm s ⇒ suc ∅ ∈ cdm s $ by ax
h3: $ G , suc ∅ ∈ cdm s ⇒ fv M A = fv M2 A $ by imp_elim [h1, h2]
h4: $ G , suc ∅ ∈ cdm s ⇒ fv M2 A = fv M A $ by eq_sym [h3]
h5: $ G ⇒ suc ∅ ∈ cdm s → fv M2 A = fv M A $ by imp_intro [h4]
a1: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} $ by ax
a2: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by cab_elim [a1]
a3: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U $ by and_elim_l [a2]
a4: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by and_elim_r [a2]
a5c: $ G ⇒ (∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ z = scons x q)) → ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by c3_esq_ex2 [#1, #2]
a5: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ (∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ z = scons x q)) → ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by weaken [a5c]
a6: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by imp_elim [a5, a4]
a7: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by and_intro [a3, a6]
a8: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} $ by cab_intro [a7]
b1: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} $ by ax
b2: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by cab_elim [b1]
b3: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U $ by and_elim_l [b2]
b4: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by and_elim_r [b2]
b5c: $ G ⇒ (∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q)) → ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by c3_esq_ex2 [#1, h5]
b5: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ (∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q)) → ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by weaken [b5c]
b6: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by imp_elim [b5, b4]
b7: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by and_intro [b3, b6]
b8: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} $ by cab_intro [b7]
e1: $ G ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} = {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} $ by eq_intro [a8, b8]

lemma c3_esb_eq2 (G: hyps) (U E E2 K F: class) (s c: set):
  $ G ⇒ c = ccom F s $ > $ G ⇒ suc ∅ ∈ cdm s → fv E (fv s ∅) = fv E2 (fv s ∅) $ >
  $ G ⇒ esb U E K s c = esb U E2 K s c $
----
e0a: $ G , w ∊ lvals ⇒ c = ccom F s $ by weaken [#1]
e0b: $ G , w ∊ lvals ⇒ suc ∅ ∈ cdm s → fv E (fv s ∅) = fv E2 (fv s ∅) $ by weaken [#2]
e1: $ G , w ∊ lvals ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by c3_esq_eq2 [e0a, e0b]
e2: $ G ⇒ w ∊ lvals → {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by imp_intro [e1]
e3: $ G ⇒ ∀ w (w ∊ lvals → {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by all_intro [e2]
e4: $ G ⇒ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by clam_eq_body [e3]
e5: $ G ⇒ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by eq_sym [e4]
f1: $ G , z ∊ esb U E K s c ⇒ z ∊ esb U E K s c $ by ax
f2: $ G , z ∊ esb U E K s c ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) $ by cab_elim [f1]
f3: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ K = kc_nil ∧ z ∊ clam w lvals (csn ∅) $ by ax
f4: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by or_intro_l [f3]
f5: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by ax
f6: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons $ by and_elim_l [f5]
f7: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by and_elim_r [f5]
f8a: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by weaken [e4]
f8: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by welc_eq [f8a, f7]
f9: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by and_intro [f6, f8]
f10: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by or_intro_r [f9]
f11a: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) $ by ax
f11: $ G , z ∊ esb U E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by or_elim [f11a, f4, f10]
f12: $ G , z ∊ esb U E K s c ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by cut [f2, f11]
f13: $ G , z ∊ esb U E K s c ⇒ z ∊ esb U E2 K s c $ by cab_intro [f12]
g1: $ G , z ∊ esb U E2 K s c ⇒ z ∊ esb U E2 K s c $ by ax
g2: $ G , z ∊ esb U E2 K s c ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by cab_elim [g1]
g3: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ K = kc_nil ∧ z ∊ clam w lvals (csn ∅) $ by ax
g4: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) $ by or_intro_l [g3]
g5: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by ax
g6: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons $ by and_elim_l [g5]
g7: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} ⇒ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by and_elim_r [g5]
g8a: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} ⇒ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by weaken [e5]
g8: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} ⇒ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by welc_eq [g8a, g7]
g9: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by and_intro [g6, g8]
g10: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) $ by or_intro_r [g9]
g11a: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by ax
g11: $ G , z ∊ esb U E2 K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) $ by or_elim [g11a, g4, g10]
g12: $ G , z ∊ esb U E2 K s c ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) $ by cut [g2, g11]
g13: $ G , z ∊ esb U E2 K s c ⇒ z ∊ esb U E K s c $ by cab_intro [g12]
h1: $ G ⇒ esb U E K s c = esb U E2 K s c $ by eq_intro [f13, g13]

lemma c3_esat_dec {x q: set} (G: hyps) (E: class) (u k s w p: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ p ∊ esat u E ⟨ k , s ⟩ w $ >
  $ G ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $
----
a0: $ G , c = ccom (esf u E) s ⇒ c = ccom (esf u E) s $ by ax
a0a: $ G , c = ccom (esf u E) s ⇒ k ∊ ω $ by weaken [#1]
a0b: $ G , c = ccom (esf u E) s ⇒ s ∊ fseq (trees ω) $ by weaken [#2]
a1: $ G , c = ccom (esf u E) s ⇒ fv (esf u E) ⟨ k , s ⟩ = esb u E k s (ccom (esf u E) s) $ by esf_node [a0a, a0b]
r1: $ G , c = ccom (esf u E) s ⇒ u = u $ by eq_refl
r2: $ G , c = ccom (esf u E) s ⇒ E = E $ by eq_refl
r3: $ G , c = ccom (esf u E) s ⇒ k = k $ by eq_refl
r4: $ G , c = ccom (esf u E) s ⇒ s = s $ by eq_refl
a2a: $ G , c = ccom (esf u E) s ⇒ ccom (esf u E) s = c $ by eq_sym [a0]
a2: $ G , c = ccom (esf u E) s ⇒ esb u E k s (ccom (esf u E) s) = esb u E k s c $ by esb_eq [r1, r2, r3, r4, a2a]
a3: $ G , c = ccom (esf u E) s ⇒ fv (esf u E) ⟨ k , s ⟩ = esb u E k s c $ by eq_trans [a1, a2]
a4a: $ G , c = ccom (esf u E) s ⇒ w = w $ by eq_refl
a4: $ G , c = ccom (esf u E) s ⇒ ap (fv (esf u E) ⟨ k , s ⟩) w = ap (esb u E k s c) w $ by ap_eq [a3, a4a]
a5a: $ G , c = ccom (esf u E) s ⇒ p ∊ esat u E ⟨ k , s ⟩ w $ by weaken [#3]
a5: $ G , c = ccom (esf u E) s ⇒ p ∊ ap (esb u E k s c) w $ by welc_eq [a4, a5a]
a6: $ G , c = ccom (esf u E) s ⇒ ⟨ w , p ⟩ ∈ esb u E k s c $ by ap_elim [a5]
b1: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c ⇒ m ∊ esb u E k s c $ by ax
b2: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c ⇒ (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) $ by cab_elim [b1]
c1: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ k = kc_nil ∧ m ∊ clam o lvals (csn ∅) $ by ax
c2: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ k = kc_nil $ by and_elim_l [c1]
c3: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ m ∊ clam o lvals (csn ∅) $ by and_elim_r [c1]
c4: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ m = ⟨ w , p ⟩ $ by ax
c5: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ ⟨ w , p ⟩ ∈ clam o lvals (csn ∅) $ by wcel_intro [c4, c3]
c6: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ w ∊ lvals ∧ p ∊ csn ∅ $ by clam_elim [c5]
c7: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ p ∊ csn ∅ $ by and_elim_r [c6]
c8: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ p = ∅ $ by csn_elim [c7]
c9: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ k = kc_nil ∧ p = ∅ $ by and_intro [c2, c8]
c10: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_nil ∧ m ∊ clam o lvals (csn ∅) ⇒ (k = kc_nil ∧ p = ∅) ∨ (k = kc_cons ∧ ∃ x ∃ q (q ∊ esat u E (fv s (suc ∅)) w ∧ fv s (suc ∅) ∈ crn s ∧ p = scons x q)) $ by or_intro_l [c9]
d1: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} $ by ax
d2: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ k = kc_cons $ by and_elim_l [d1]
d3: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} $ by and_elim_r [d1]
d4: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ m = ⟨ w , p ⟩ $ by ax
d5: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ ⟨ w , p ⟩ ∈ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} $ by wcel_intro [d4, d3]
d6: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} ⇒ w ∊ lvals ∧ p ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by clam_elim [d5]
