e5a: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ c = ccom (esf u E) s $ by ax
e5: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ suc ∅ ∈ cdm s $ by c3_apcc1 [e5a, e2]
e6a: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ functional (esf u E) $ by esf_functional
e6b: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ cdm (esf u E) = trees ω $ by esf_cdm
e6c: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ s ∊ fseq (trees ω) $ by weaken [#2]
e6: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ fv (ccom (esf u E) s) (suc ∅) = fv (esf u E) (fv s (suc ∅)) ∧ fv s (suc ∅) ∈ crn s $ by c3_child [e6a, e6b, e6c, e5]
e7: $ G , c = ccom (esf u E) s , m = ⟨ w , p ⟩ , m ∊ esb u E k s c , (k = kc_nil ∧ m ∊ clam o lvals (csn ∅)) ∨ (k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)}) , k = kc_cons ∧ m ∊ clam o lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) o ∧ x ∊ da (fv E (fv s ∅)) o q ∧ r = scons x q)} , q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ p = scons x q ⇒ fv (ccom (esf u E) s) (suc ∅) = fv (esf u E) (fv s (suc ∅)) $ by and_elim_l [e6]
