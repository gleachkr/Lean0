lemma c4_nctor_tsub_one {x i: set} (G: hyps) (q j k: set): $ G ⇒ ra_nth_ctor q j k ∈ lrel $ > $ G ⇒ ∀ x ∀ i (ra_nth_ctor x i k ∈ lrel → suc (fv nvf i) = fv nvf j → k ∈ fv tsub x) $ > $ G ⇒ k ∈ fv tsub q $
