l301: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx G) w , x0 = enc_ctx G , x1 = enc_ind D , x2 = enc_lvl v , x3 = enc_nat i ⇒ (dt u (mcv hfin) ⟨ kc_app , scons (enc_expr e4) (scons (enc_expr maj) ∅) ⟩ w r = dt u (mcv hfin) (enc_expr rhs) w r) ∧ (dt u (mcv hfin) ⟨ kc_app , scons (enc_expr e4) (scons (enc_expr maj) ∅) ⟩ w r ∈ dt u (mcv hfin) (enc_expr T) w r) $ by isset_elim [l300, l298]
