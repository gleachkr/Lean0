l159: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx G) w , x0 = enc_ctx G ⇒ (dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e) ∅)) ⟩ w r = dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e2) ∅)) ⟩ w r) ∧ (dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e) ∅)) ⟩ w r ∈ dt u (mcv hfin) (enc_expr R) w r) $ by isset_elim [l158, l156]
l160: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx G) w ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
l161: $ … ⇒ isset (enc_ctx G) $ by wcel_isset [l160]
l162: $ uadm u , w ∊ lvals , r ∊ sat u (mcv hfin) (enc_ctx G) w ⇒ (dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e) ∅)) ⟩ w r = dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e2) ∅)) ⟩ w r) ∧ (dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e) ∅)) ⟩ w r ∈ dt u (mcv hfin) (enc_expr R) w r) $ by isset_elim [l161, l159]
l163: $ … ⇒ dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e) ∅)) ⟩ w r = dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e2) ∅)) ⟩ w r $ by and_elim_l [l162]
l164: $ … ⇒ dt u (mcv hfin) ⟨ kc_proj , scons (enc_blk b) (scons (enc_nat i) (scons (enc_expr e) ∅)) ⟩ w r ∈ dt u (mcv hfin) (enc_expr R) w r $ by and_elim_r [l162]
z1: $ deq G (proj b i e) (proj b i e2) R $ by mdeq_i [l163, l164]
