l7: $ G ⇒ lsv t1 w = lsv t2 w $ by f213_ls_e [l6, #1, #2]

mcv_inv_node_cst
----------------
l1: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l2: $ … ⇒ z ∊ trees ω ∧ t ∊ trees ω $ by f213_at [#6, l1]
l3: $ … ⇒ z ∈ trees ω $ by welc_wcel [and_elim_l [l2]]
l4: $ … ⇒ t ∈ trees ω $ by welc_wcel [and_elim_r [l2]]
l5: $ G ⇒ ∃ v (z = v ∧ t = v) ∨ ∃ b (z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩) ∨ ∃ c ∃ f (z = ⟨ kc_srt , scons c ∅ ⟩ ∧ t = ⟨ kc_srt , scons f ∅ ⟩ ∧ lveq c f) ∨ ∃ g ∃ i ∃ j ∃ k (z = ⟨ kc_app , scons g (scons i ∅) ⟩ ∧ t = ⟨ kc_app , scons j (scons k ∅) ⟩ ∧ ra_eeqv g j ∈ lrel2 ∧ ra_eeqv i k ∈ lrel2) ∨ ∃ h ∃ l ∃ m ∃ n (z = ⟨ kc_lam , scons h (scons l ∅) ⟩ ∧ t = ⟨ kc_lam , scons m (scons n ∅) ⟩ ∧ ra_eeqv h m ∈ lrel2 ∧ ra_eeqv l n ∈ lrel2) ∨ ∃ h ∃ l ∃ m ∃ n (z = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ ra_eeqv h m ∈ lrel2 ∧ ra_eeqv l n ∈ lrel2) ∨ ∃ o (z = ⟨ kc_lit , scons o ∅ ⟩ ∧ t = ⟨ kc_lit , scons o ∅ ⟩) ∨ ∃ i ∃ p ∃ q (z = ⟨ kc_cst , scons i (scons p ∅) ⟩ ∧ t = ⟨ kc_cst , scons i (scons q ∅) ⟩ ∧ ra_lseqv p q ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b (z = ⟨ kc_ind_ty , scons r (scons b ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x0 (scons b ∅) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b ∃ x5 (z = ⟨ kc_ind_ctor , scons r (scons b (scons x5 ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x0 (scons b (scons x5 ∅)) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b ∃ x6 ∃ x7 (z = ⟨ kc_ind_rec , scons r (scons b (scons x6 ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x0 (scons b (scons x7 ∅)) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2 ∧ lveq x6 x7) ∨ ∃ l ∃ b ∃ v ∃ x8 (z = ⟨ kc_proj , scons l (scons b (scons v ∅)) ⟩ ∧ t = ⟨ kc_proj , scons l (scons b (scons x8 ∅)) ⟩ ∧ ra_eeqv v x8 ∈ lrel2) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot_mk , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot_mk , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) ∨ ∃ x9 ∃ x6 ∃ xx0 ∃ x7 (z = ⟨ kc_quot_lift , scons x9 (scons x6 ∅) ⟩ ∧ t = ⟨ kc_quot_lift , scons xx0 (scons x7 ∅) ⟩ ∧ lveq x9 xx0 ∧ lveq x6 x7) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot_ind , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) $ by lrel2_eeqv_cases [#6]
l6: $ G , z = v ∧ t = v ⇒ z = v ∧ t = v $ by ax
l7: $ G , z = v ∧ t = v ⇒ u = u $ by eq_refl
l8: $ G , z = v ∧ t = v ⇒ (mcv H) = (mcv H) $ by eq_refl
l9: $ G , z = v ∧ t = v ⇒ w = w $ by eq_refl
l10: $ G , z = v ∧ t = v ⇒ d = d $ by eq_refl
l11: $ … ⇒ dt u (mcv H) z w d = dt u (mcv H) t w d $ by dt_eq [l7, l8, eq_trans [and_elim_l [l6], eq_sym [and_elim_r [l6]]], l9, l10]
l12: $ G , ∃ v (z = v ∧ t = v) ⇒ ∃ v (z = v ∧ t = v) $ by ax
l13: $ … ⇒ dt u (mcv H) z w d = dt u (mcv H) t w d $ by ex_elim [l12, l11]
l14: $ G ⇒ (∃ v (z = v ∧ t = v)) → dt u (mcv H) z w d = dt u (mcv H) t w d $ by imp_intro [l13]
l15: $ G , z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩ ⇒ z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩ $ by ax
l16: $ G , z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩ ⇒ ⟨ kc_bvar , scons b ∅ ⟩ = ⟨ kc_cst , y ⟩ $ by eq_trans [eq_sym [and_elim_l [l15]], weaken [#5]]
l17: $ G , z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l18: $ G , z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩ ⇒ kc_cst ∈ ω $ by kc_cst_omega
l19: $ … ⇒ kc_bvar = kc_cst $ by opair_inj_l_c [l16, wcel_isset [l17], wcel_isset [l18]]
l20: $ G , z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩ ⇒ ¬ kc_bvar = kc_cst $ by kc_bvar_ne_cst
l21: $ … ⇒ dt u (mcv H) z w d = dt u (mcv H) t w d $ by bot_elim [not_elim [l20, l19]]
l22: $ G , ∃ b (z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩) ⇒ ∃ b (z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩) $ by ax
l23: $ … ⇒ dt u (mcv H) z w d = dt u (mcv H) t w d $ by ex_elim [l22, l21]
l24: $ G ⇒ (∃ b (z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩)) → dt u (mcv H) z w d = dt u (mcv H) t w d $ by imp_intro [l23]
l25: $ G , z = ⟨ kc_srt , scons c ∅ ⟩ ∧ t = ⟨ kc_srt , scons f ∅ ⟩ ∧ lveq c f ⇒ z = ⟨ kc_srt , scons c ∅ ⟩ ∧ t = ⟨ kc_srt , scons f ∅ ⟩ ∧ lveq c f $ by ax
l26: $ G , z = ⟨ kc_srt , scons c ∅ ⟩ ∧ t = ⟨ kc_srt , scons f ∅ ⟩ ∧ lveq c f ⇒ ⟨ kc_srt , scons c ∅ ⟩ = ⟨ kc_cst , y ⟩ $ by eq_trans [eq_sym [and_elim_l [l25]], weaken [#5]]
l27: $ G , z = ⟨ kc_srt , scons c ∅ ⟩ ∧ t = ⟨ kc_srt , scons f ∅ ⟩ ∧ lveq c f ⇒ kc_srt ∈ ω $ by kc_srt_omega
l28: $ G , z = ⟨ kc_srt , scons c ∅ ⟩ ∧ t = ⟨ kc_srt , scons f ∅ ⟩ ∧ lveq c f ⇒ kc_cst ∈ ω $ by kc_cst_omega
l29: $ … ⇒ kc_srt = kc_cst $ by opair_inj_l_c [l26, wcel_isset [l27], wcel_isset [l28]]
