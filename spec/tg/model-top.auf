lemma f214_e_hlit {u l e w: set} (G: hyps) (o t: set): $ G ⇒ ⟨ o , t ⟩ ∈ hlit $ > $ G ⇒ ∃ u ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_lit , ⟨ scons l ∅ , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv nnf (fv nvf l))) ⟩) $
