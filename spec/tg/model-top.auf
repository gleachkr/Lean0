l275: $ … ⇒ (∃ b (z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩) ∨ ∃ c ∃ f (z = ⟨ kc_srt , scons c ∅ ⟩ ∧ t = ⟨ kc_srt , scons f ∅ ⟩ ∧ lveq c f) ∨ ∃ g ∃ i ∃ j ∃ k (z = ⟨ kc_app , scons g (scons i ∅) ⟩ ∧ t = ⟨ kc_app , scons j (scons k ∅) ⟩ ∧ ra_eeqv g j ∈ lrel2 ∧ ra_eeqv i k ∈ lrel2) ∨ ∃ h ∃ l ∃ m ∃ n (z = ⟨ kc_lam , scons h (scons l ∅) ⟩ ∧ t = ⟨ kc_lam , scons m (scons n ∅) ⟩ ∧ ra_eeqv h m ∈ lrel2 ∧ ra_eeqv l n ∈ lrel2) ∨ ∃ h ∃ l ∃ m ∃ n (z = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ ra_eeqv h m ∈ lrel2 ∧ ra_eeqv l n ∈ lrel2) ∨ ∃ o (z = ⟨ kc_lit , scons o ∅ ⟩ ∧ t = ⟨ kc_lit , scons o ∅ ⟩) ∨ ∃ i ∃ p ∃ q (z = ⟨ kc_cst , scons i (scons p ∅) ⟩ ∧ t = ⟨ kc_cst , scons i (scons q ∅) ⟩ ∧ ra_lseqv p q ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b (z = ⟨ kc_ind_ty , scons r (scons b ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x0 (scons b ∅) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b ∃ x5 (z = ⟨ kc_ind_ctor , scons r (scons b (scons x5 ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x0 (scons b (scons x5 ∅)) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b ∃ x6 ∃ x7 (z = ⟨ kc_ind_rec , scons r (scons b (scons x6 ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x0 (scons b (scons x7 ∅)) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2 ∧ lveq x6 x7) ∨ ∃ l ∃ b ∃ v ∃ x8 (z = ⟨ kc_proj , scons l (scons b (scons v ∅)) ⟩ ∧ t = ⟨ kc_proj , scons l (scons b (scons x8 ∅)) ⟩ ∧ ra_eeqv v x8 ∈ lrel2) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot_mk , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot_mk , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) ∨ ∃ x9 ∃ x6 ∃ xx0 ∃ x7 (z = ⟨ kc_quot_lift , scons x9 (scons x6 ∅) ⟩ ∧ t = ⟨ kc_quot_lift , scons xx0 (scons x7 ∅) ⟩ ∧ lveq x9 xx0 ∧ lveq x6 x7) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot_ind , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons xx0 ∅ ⟩ ∧ lveq x9 xx0)) → dt u (mcv H) z w d = dt u (mcv H) t w d $ by or_elim_imp [l24, l274]
l276: $ … ⇒ (∃ v (z = v ∧ t = v) ∨ ∃ b (z = ⟨ kc_bvar , scons b ∅ ⟩ ∧ t = ⟨ kc_bvar , scons b ∅ ⟩) ∨ ∃ c ∃ f (z = ⟨ kc_srt , scons c ∅ ⟩ ∧ t = ⟨ kc_srt , scons f ∅ ⟩ ∧ lveq c f) ∨ ∃ g ∃ i ∃ j ∃ k (z = ⟨ kc_app , scons g (scons i ∅) ⟩ ∧ t = ⟨ kc_app , scons j (scons k ∅) ⟩ ∧ ra_eeqv g j ∈ lrel2 ∧ ra_eeqv i k ∈ lrel2) ∨ ∃ h ∃ l ∃ m ∃ n (z = ⟨ kc_lam , scons h (scons l ∅) ⟩ ∧ t = ⟨ kc_lam , scons m (scons n ∅) ⟩ ∧ ra_eeqv h m ∈ lrel2 ∧ ra_eeqv l n ∈ lrel2) ∨ ∃ h ∃ l ∃ m ∃ n (z = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ ra_eeqv h m ∈ lrel2 ∧ ra_eeqv l n ∈ lrel2) ∨ ∃ o (z = ⟨ kc_lit , scons o ∅ ⟩ ∧ t = ⟨ kc_lit , scons o ∅ ⟩) ∨ ∃ i ∃ p ∃ q (z = ⟨ kc_cst , scons i (scons p ∅) ⟩ ∧ t = ⟨ kc_cst , scons i (scons q ∅) ⟩ ∧ ra_lseqv p q ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b (z = ⟨ kc_ind_ty , scons r (scons b ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x0 (scons b ∅) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b ∃ x5 (z = ⟨ kc_ind_ctor , scons r (scons b (scons x5 ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x0 (scons b (scons x5 ∅)) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b ∃ x6 ∃ x7 (z = ⟨ kc_ind_rec , scons r (scons b (scons x6 ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x0 (scons b (scons x7 ∅)) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2 ∧ lveq x6 x7) ∨ ∃ l ∃ b ∃ v ∃ x8 (z = ⟨ kc_proj , scons l (scons b (scons v ∅)) ⟩ ∧ t = ⟨ kc_proj , scons l (scons b (scons x8 ∅)) ⟩ ∧ ra_eeqv v x8 ∈ lrel2) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot_mk , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot_mk , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) ∨ ∃ x9 ∃ x6 ∃ xx0 ∃ x7 (z = ⟨ kc_quot_lift , scons x9 (scons x6 ∅) ⟩ ∧ t = ⟨ kc_quot_lift , scons xx0 (scons x7 ∅) ⟩ ∧ lveq x9 xx0 ∧ lveq x6 x7) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot_ind , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons xx0 ∅ ⟩ ∧ lveq x9 xx0)) → dt u (mcv H) z w d = dt u (mcv H) t w d $ by or_elim_imp [l14, l275]
l277: $ G ⇒ dt u (mcv H) z w d = dt u (mcv H) t w d $ by imp_elim [l276, l5]

lemma f214_un (G: hyps) (A B C: class): $ G ⇒ C ∈ A ∪ B $ > $ G ⇒ C ∈ A ∨ C ∈ B $
----
l1: $ x = C , x ∊ A ∪ B ⇒ x ∊ A ∪ B $ by ax
l2: $ … ⇒ x ∊ A ∨ x ∊ B $ by cun_elim [l1]
l3: $ x = C , x ∊ A ∪ B ⇒ x = C $ by ax
l4: $ x = C , x ∊ A ∪ B , x ∊ A ⇒ x ∊ A $ by ax
l5: $ x = C , x ∊ A ∪ B , x ∊ A ⇒ C ∈ A $ by wcel_intro [weaken [l3], l4]
l6: $ … ⇒ C ∈ A ∨ C ∈ B $ by or_intro_l [l5]
l7: $ x = C , x ∊ A ∪ B , x ∊ B ⇒ x ∊ B $ by ax
l8: $ x = C , x ∊ A ∪ B , x ∊ B ⇒ C ∈ B $ by wcel_intro [weaken [l3], l7]
l9: $ … ⇒ C ∈ A ∨ C ∈ B $ by or_intro_r [l8]
l10: $ x = C , x ∊ A ∪ B ⇒ C ∈ A ∨ C ∈ B $ by or_elim [l2, l6, l9]
l11: $ G ⇒ C ∈ A ∨ C ∈ B $ by wcel_elim [#1, l10]

lemma f214_x {x8 x9 xx8 xx9: set} (G: hyps) (A B: class) (o: set): $ G ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩) $ > $ G ⇒ ∃ xx8 ∃ xx9 (o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩) $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ A = B $
----
l1: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ ⇒ o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ $ by ax
l2: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ ⇒ o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ $ by ax
l3: $ … ⇒ ⟨ x8 , ⟨ A , x9 ⟩ ⟩ = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ $ by eq_trans [eq_sym [l1], l2]
l4: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ ⇒ isset x8 $ by isset_var
l5: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ ⇒ isset ⟨ A , x9 ⟩ $ by opair_isset
l6: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ ⇒ isset xx8 $ by isset_var
l7: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ ⇒ isset ⟨ B , xx9 ⟩ $ by opair_isset
l8: $ … ⇒ x8 = xx8 ∧ ⟨ A , x9 ⟩ = ⟨ B , xx9 ⟩ $ by opair_inj_c [l3, l4, l5, l6, l7]
l9: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ ⇒ isset A $ by weaken [#3]
l10: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩ ⇒ isset B $ by weaken [#4]
l11: $ … ⇒ A = B $ by opair_inj_l_c [and_elim_r [l8], l9, l10]
l12: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ ⇒ ∃ xx8 ∃ xx9 (o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩) $ by weaken [#2]
l13: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ , ∃ xx9 (o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩) ⇒ ∃ xx9 (o = ⟨ xx8 , ⟨ B , xx9 ⟩ ⟩) $ by ax
l14: $ … ⇒ A = B $ by ex_elim [l13, l11]
l15: $ G , o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩ ⇒ A = B $ by ex_elim [l12, l14]
l16: $ G , ∃ x9 (o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩) ⇒ ∃ x9 (o = ⟨ x8 , ⟨ A , x9 ⟩ ⟩) $ by ax
l17: $ … ⇒ A = B $ by ex_elim [l16, l15]
l18: $ G ⇒ A = B $ by ex_elim [#1, l17]

lemma f214_e_hty {u d j e w: set} (G: hyps) (o t: set): $ G ⇒ ⟨ o , t ⟩ ∈ hty $ > $ G ⇒ ∃ u ∃ d ∃ j ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $
----
l1: $ G , x = ⟨ o , t ⟩ , x ∊ hty , x = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩ ⇒ x = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩ $ by ax
l2: $ G , x = ⟨ o , t ⟩ , x ∊ hty , x = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩ ⇒ x = ⟨ o , t ⟩ $ by ax
l3: $ … ⇒ ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩ $ by eq_trans [eq_sym [l2], l1]
l4: $ … ⇒ ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by ex_intro [l3]
l5: $ … ⇒ ∃ j ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by ex_intro [l4]
l6: $ … ⇒ ∃ d ∃ j ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by ex_intro [l5]
l7: $ … ⇒ ∃ u ∃ d ∃ j ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by ex_intro [l6]
l8: $ G , x = ⟨ o , t ⟩ , x ∊ hty ⇒ x ∊ {z | ∃ u ∃ d ∃ j ∃ e (z = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩)} $ by ax
l9: $ … ⇒ ∃ u ∃ d ∃ j ∃ e (x = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by cab_elim [l8]
l10: $ G , x = ⟨ o , t ⟩ , x ∊ hty , ∃ e (x = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) ⇒ ∃ e (x = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by ax
l11: $ … ⇒ ∃ u ∃ d ∃ j ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by ex_elim [l10, l7]
l12: $ G , x = ⟨ o , t ⟩ , x ∊ hty , ∃ j ∃ e (x = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) ⇒ ∃ j ∃ e (x = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by ax
l13: $ … ⇒ ∃ u ∃ d ∃ j ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_ind_ty , ⟨ scons d (scons j ∅) , e ⟩ ⟩ ⟩ , clam w lvals (ityv u e d (fv nvf j) w) ⟩) $ by ex_elim [l12, l11]
