lemma f214_e_hquot {u l e w y n a r i j: set} (G: hyps) (o t: set): $ G ⇒ ⟨ o , t ⟩ ∈ hquot $ > $ G ⇒ ∃ u ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_quot , ⟨ scons l ∅ , e ⟩ ⟩ ⟩ , clam w lvals (sclip {y | ∃ n (n = lv l w ∧ y ∊ clam a (fv uni n) (clam r (cpi i a (cpi j a (fv uni ∅))) (qty a r)))}) ⟩) $
