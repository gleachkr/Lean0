l22: $ G , ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ kc_lcons ∈ ω $ by kc_lcons_omega
l23: $ G , ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ isset ω $ by omega_set
l24: $ … ⇒ x1 ∊ trees ω ∧ x3 ∊ trees ω $ by trees_kids2 [l23, l20, wcel_isset [l22]]
