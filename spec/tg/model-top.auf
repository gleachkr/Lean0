lemma f214_g_hty (G: hyps) (o t p: set): $ G ⇒ ⟨ o , t ⟩ ∈ hty $ > $ G ⇒ ⟨ o , p ⟩ ∈ hfin $ > $ G ⇒ t = p $
----
l1: $ G ⇒ hfin ⊆ hty ∪ (hctor ∪ (hrec ∪ (hquot ∪ (hqmk ∪ (hqlift ∪ (hqind ∪ (hlit ∪ hcst))))))) $ by subset_refl
