l39: $ … ⇒ lsv x3 w = lsv x4 w $ by f213_ls_e [wcel_welc [l38], l13, l14]
l40: $ … ⇒ w ∊ lvals → lv x1 w = lv x2 w $ by all_elim [l12]
l41: $ … ⇒ lv x1 w = lv x2 w $ by imp_elim [l40, l14]
l42: $ … ⇒ lsv ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ w = scons (lv x1 w) (lsv x3 w) $ by lsv_lcons [l25, l26, l14]
l43: $ … ⇒ lsv ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ w = scons (lv x2 w) (lsv x4 w) $ by lsv_lcons [l28, l29, l14]
l44: $ G , ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ w = w $ by eq_refl
l45: $ … ⇒ lsv ty w = lsv ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ w $ by lsv_eq [l10, l44]
l46: $ … ⇒ lsv vt w = lsv ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ w $ by lsv_eq [l11, l44]
l47: $ … ⇒ scons (lv x1 w) (lsv x3 w) = scons (lv x2 w) (lsv x4 w) $ by scons_eq [l41, l39]
l48: $ … ⇒ lsv ty w = lsv vt w $ by eq_trans [l45, eq_trans [l42, eq_trans [l47, eq_trans [eq_sym [l43], eq_sym [l46]]]]]
l49: $ G , ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) ⇒ ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by ax
l50: $ … ⇒ lsv ty w = lsv vt w $ by ex_elim [l49, l48]
l51: $ G , ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) ⇒ ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by ax
l52: $ … ⇒ lsv ty w = lsv vt w $ by ex_elim [l51, l50]
l53: $ G , ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) ⇒ ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by ax
l54: $ … ⇒ lsv ty w = lsv vt w $ by ex_elim [l53, l52]
l55: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2) $ by ax
l56: $ … ⇒ lsv ty w = lsv vt w $ by ex_elim [l55, l54]
l57: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2)) → lsv ty w = lsv vt w $ by imp_intro [l56]
l58: $ … ⇒ ((ty = ⟨ kc_lnil , ∅ ⟩ ∧ vt = ⟨ kc_lnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2)) → lsv ty w = lsv vt w $ by or_elim_imp [l8, l57]
l59: $ G ⇒ lsv ty w = lsv vt w $ by imp_elim [l58, l2]

lemma f213_ls_all (G: hyps) (w: set): $ G ⇒ trees ω ⊆ f213_ls_q w $
----
l1: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ , ra_lseqv y t ∈ lrel2 , w ∊ lvals ⇒ crn x9 ⊆ f213_ls_q w $ by ax
l2: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ , ra_lseqv y t ∈ lrel2 , w ∊ lvals ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l3: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ , ra_lseqv y t ∈ lrel2 , w ∊ lvals ⇒ x8 ∊ ω $ by ax
l4: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ , ra_lseqv y t ∈ lrel2 , w ∊ lvals ⇒ x9 ∊ fseq (trees ω) $ by ax
l5: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ , ra_lseqv y t ∈ lrel2 , w ∊ lvals ⇒ ra_lseqv y t ∈ lrel2 $ by ax
l6: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ , ra_lseqv y t ∈ lrel2 , w ∊ lvals ⇒ w ∊ lvals $ by ax
l7: $ … ⇒ lsv y w = lsv t w $ by f213_ls_n [l1, l2, l3, l4, l5, l6]
l8: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ , ra_lseqv y t ∈ lrel2 ⇒ w ∊ lvals → lsv y w = lsv t w $ by imp_intro [l7]
l9: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ ⇒ ra_lseqv y t ∈ lrel2 → w ∊ lvals → lsv y w = lsv t w $ by imp_intro [l8]
l10: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ ⇒ ∀ t (ra_lseqv y t ∈ lrel2 → w ∊ lvals → lsv y w = lsv t w) $ by all_intro [l9]
l11: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ ⇒ y ∊ f213_ls_q w $ by cab_intro [l10]
l12: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w , y = ⟨ x8 , x9 ⟩ ⇒ y = ⟨ x8 , x9 ⟩ $ by ax
l13: $ … ⇒ ⟨ x8 , x9 ⟩ ∈ f213_ls_q w $ by wcel_intro [l12, l11]
l14: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w ⇒ isset ⟨ x8 , x9 ⟩ $ by opair_isset
l15: $ G , x8 ∊ ω , x9 ∊ fseq (trees ω) , crn x9 ⊆ f213_ls_q w ⇒ ⟨ x8 , x9 ⟩ ∈ f213_ls_q w $ by isset_elim [l14, l13]
l16: $ G ⇒ x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f213_ls_q w → ⟨ x8 , x9 ⟩ ∈ f213_ls_q w $ by imp_intro [imp_intro [imp_intro [l15]]]
l17: $ G ⇒ ∀ x8 ∀ x9 (x8 ∊ ω → x9 ∊ fseq (trees ω) → crn x9 ⊆ f213_ls_q w → ⟨ x8 , x9 ⟩ ∈ f213_ls_q w) $ by all_intro [all_intro [l16]]
l18: $ G ⇒ isset ω $ by omega_set
l19: $ G ⇒ trees ω ⊆ f213_ls_q w $ by trees_ind_c [l18, l17]

lrel2_lseqv_lsv
---------------
l1: $ G ⇒ kr_lseqv ∈ ω $ by kr_lseqv_omega
l2: $ … ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω $ by f213_at [#1, l1]
l3: $ … ⇒ t1 ∈ trees ω $ by welc_wcel [and_elim_l [l2]]
l4: $ … ⇒ t2 ∈ trees ω $ by welc_wcel [and_elim_r [l2]]
