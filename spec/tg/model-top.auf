l273: $ … ⇒ (∃ g ∃ i ∃ j ∃ k (z = ⟨ kc_app , scons g (scons i ∅) ⟩ ∧ t = ⟨ kc_app , scons j (scons k ∅) ⟩ ∧ ra_eeqv g j ∈ lrel2 ∧ ra_eeqv i k ∈ lrel2) ∨ ∃ h ∃ l ∃ m ∃ n (z = ⟨ kc_lam , scons h (scons l ∅) ⟩ ∧ t = ⟨ kc_lam , scons m (scons n ∅) ⟩ ∧ ra_eeqv h m ∈ lrel2 ∧ ra_eeqv l n ∈ lrel2) ∨ ∃ h ∃ l ∃ m ∃ n (z = ⟨ kc_pi , scons h (scons l ∅) ⟩ ∧ t = ⟨ kc_pi , scons m (scons n ∅) ⟩ ∧ ra_eeqv h m ∈ lrel2 ∧ ra_eeqv l n ∈ lrel2) ∨ ∃ o (z = ⟨ kc_lit , scons o ∅ ⟩ ∧ t = ⟨ kc_lit , scons o ∅ ⟩) ∨ ∃ i ∃ p ∃ q (z = ⟨ kc_cst , scons i (scons p ∅) ⟩ ∧ t = ⟨ kc_cst , scons i (scons q ∅) ⟩ ∧ ra_lseqv p q ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b (z = ⟨ kc_ind_ty , scons r (scons b ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x0 (scons b ∅) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b ∃ x5 (z = ⟨ kc_ind_ctor , scons r (scons b (scons x5 ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x0 (scons b (scons x5 ∅)) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2) ∨ ∃ r ∃ x0 ∃ b ∃ x6 ∃ x7 (z = ⟨ kc_ind_rec , scons r (scons b (scons x6 ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x0 (scons b (scons x7 ∅)) ⟩ ∧ ra_ind_eqv r x0 ∈ lrel2 ∧ lveq x6 x7) ∨ ∃ l ∃ b ∃ v ∃ x8 (z = ⟨ kc_proj , scons l (scons b (scons v ∅)) ⟩ ∧ t = ⟨ kc_proj , scons l (scons b (scons x8 ∅)) ⟩ ∧ ra_eeqv v x8 ∈ lrel2) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot_mk , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot_mk , scons xx0 ∅ ⟩ ∧ lveq x9 xx0) ∨ ∃ x9 ∃ x6 ∃ xx0 ∃ x7 (z = ⟨ kc_quot_lift , scons x9 (scons x6 ∅) ⟩ ∧ t = ⟨ kc_quot_lift , scons xx0 (scons x7 ∅) ⟩ ∧ lveq x9 xx0 ∧ lveq x6 x7) ∨ ∃ x9 ∃ xx0 (z = ⟨ kc_quot_ind , scons x9 ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons xx0 ∅ ⟩ ∧ lveq x9 xx0)) → dt u (mcv H) z w d = dt u (mcv H) t w d $ by or_elim_imp [l52, l272]
