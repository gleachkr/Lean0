lemma f214_l_hqlift {x8 x9: set} (G: hyps) (o t: set): $ G ⇒ ⟨ o , t ⟩ ∈ hqlift $ > $ G ⇒ ∃ x8 ∃ x9 (o = ⟨ x8 , ⟨ kc_quot_lift , x9 ⟩ ⟩) $
