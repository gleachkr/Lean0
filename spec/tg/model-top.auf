lemma f214_e_hcst {u a l e w: set} (G: hyps) (o t: set): $ G ⇒ ⟨ o , t ⟩ ∈ hcst $ > $ G ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $
----
l1: $ G , x = ⟨ o , t ⟩ , x ∊ hcst , x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ $ by ax
l2: $ G , x = ⟨ o , t ⟩ , x ∊ hcst , x = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ ⇒ x = ⟨ o , t ⟩ $ by ax
l3: $ … ⇒ ⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩ $ by eq_trans [eq_sym [l2], l1]
l4: $ … ⇒ ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_intro [l3]
l5: $ … ⇒ ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_intro [l4]
l6: $ … ⇒ ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_intro [l5]
l7: $ … ⇒ ∃ u ∃ a ∃ l ∃ e (⟨ o , t ⟩ = ⟨ ⟨ u , ⟨ kc_cst , ⟨ scons a (scons l ∅) , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv Env ⟨ u , ⟨ a , lsv l w ⟩ ⟩)) ⟩) $ by ex_intro [l6]
