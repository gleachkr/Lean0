l29: $ … ⇒ x4 ∈ trees ω $ by welc_wcel [and_elim_r [l27]]
l30: $ G , ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ isset ∅ $ by ax_empty
l31: $ … ⇒ isset (scons x3 ∅) $ by scons_set [l30]
l32: $ … ⇒ isset (scons x1 (scons x3 ∅)) $ by scons_set [l31]
l33: $ G , ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ crn j1 ⊆ f213_ls_q w $ by weaken [#1]
l34: $ G , ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l35: $ … ⇒ crn (scons x1 (scons x3 ∅)) ⊆ f213_ls_q w $ by node_crn_sub [l33, l34, l10, wcel_isset [l22], l32]
l36: $ … ⇒ crn (scons x3 ∅) ⊆ f213_ls_q w $ by crn_scons_tail [l35]
l37: $ G , ty = ⟨ kc_lcons , scons x1 (scons x3 ∅) ⟩ ∧ vt = ⟨ kc_lcons , scons x2 (scons x4 ∅) ⟩ ∧ lveq x1 x2 ∧ ra_lseqv x3 x4 ∈ lrel2 ⇒ isset x3 $ by isset_var
