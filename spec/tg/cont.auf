-- Proofs for cont.mm0.

clord_congr
-----------
l1: $ suc A ≐ suc B $ by suc_congr [#1]
l2: $ ω ≐ ω $ by ceqt_refl
l3: $ (suc A × ω) ≐ (suc B × ω) $ by cxp_congr [l1, l2]
l4: $ 𝒫 (suc A × ω) ≐ 𝒫 (suc B × ω) $ by cpw_congr [l3]
l5: $ hartogs (𝒫 (suc A × ω)) ≐ hartogs (𝒫 (suc B × ω)) $ by hartogs_congr [l4]

clord_eq
--------
l1: $ G ⇒ suc A = suc B $ by suc_eq [#1]
l2: $ G ⇒ ω = ω $ by eq_refl
l3: $ G ⇒ (suc A × ω) = (suc B × ω) $ by cxp_eq [l1, l2]
l4: $ G ⇒ 𝒫 (suc A × ω) = 𝒫 (suc B × ω) $ by cpw_eq [l3]
l5: $ G ⇒ hartogs (𝒫 (suc A × ω)) = hartogs (𝒫 (suc B × ω)) $ by hartogs_eq [l4]

sb_c_clord
----------
l1: $ (⟦ x / t ⟧ (hartogs (𝒫 (suc A × ω)))) ≐ hartogs (𝒫 (suc (⟦ x / t ⟧ A) × ω)) $ by ceqt_refl

lemma c1_csn_cpw (G: hyps) (a w y: set):
  $ G ⇒ w ∊ ω $ > $ G ⇒ y = csn ⟨ a , w ⟩ $ > $ G ⇒ y ∊ 𝒫 (suc a × ω) $
----
k1: $ G , z ∊ csn ⟨ a , w ⟩ ⇒ z ∊ csn ⟨ a , w ⟩ $ by ax
k2: $ G , z ∊ csn ⟨ a , w ⟩ ⇒ z = ⟨ a , w ⟩ $ by csn_elim [k1]
k3: $ G , z ∊ csn ⟨ a , w ⟩ ⇒ a ∊ suc a $ by suc_self
k4: $ G , z ∊ csn ⟨ a , w ⟩ ⇒ w ∊ ω $ by weaken [#1]
k5: $ G , z ∊ csn ⟨ a , w ⟩ ⇒ z ∊ suc a × ω $ by cxp_intro_eq [k2, k3, k4]
k6: $ G ⇒ csn ⟨ a , w ⟩ ⊆ suc a × ω $ by subset_intro [k5]
k7: $ G ⇒ csn ⟨ a , w ⟩ = y $ by eq_sym [#2]
k8: $ G ⇒ y ⊆ suc a × ω $ by subset_eq_l [k7, k6]
k9: $ G ⇒ y ∊ 𝒫 (suc a × ω) $ by cpw_intro [k8]

inj_into_omega_cpw
------------------
m1: $ G ⇒ functional (cgr x (csn ⟨ a , x ⟩)) $ by cgr_functional
m2: $ G ⇒ functional (cres (cgr x (csn ⟨ a , x ⟩)) ω) $ by functional_cres [m1]
n1: $ G , w ∊ ω , u = csn ⟨ a , w ⟩ ⇒ u = csn ⟨ a , w ⟩ $ by ax
n2: $ G , w ∊ ω , u = csn ⟨ a , w ⟩ ⇒ w ∊ ω $ by ax
n3: $ G , w ∊ ω , u = csn ⟨ a , w ⟩ ⇒ u ∊ 𝒫 (suc a × ω) $ by c1_csn_cpw [n2, n1]
n4: $ G , w ∊ ω , u = csn ⟨ a , w ⟩ ⇒ ⟨ w , u ⟩ ∈ cgr x (csn ⟨ a , x ⟩) $ by cgr_intro [n1]
n5: $ G , w ∊ ω , u = csn ⟨ a , w ⟩ ⇒ ⟨ w , u ⟩ ∈ cres (cgr x (csn ⟨ a , x ⟩)) ω $ by cres_intro [n2, n4]
n6: $ G , w ∊ ω , u = csn ⟨ a , w ⟩ ⇒ u ∊ 𝒫 (suc a × ω) ∧ ⟨ w , u ⟩ ∈ cres (cgr x (csn ⟨ a , x ⟩)) ω $ by and_intro [n3, n5]
n7: $ G , w ∊ ω , u = csn ⟨ a , w ⟩ ⇒ ∃ v (v ∊ 𝒫 (suc a × ω) ∧ ⟨ w , v ⟩ ∈ cres (cgr x (csn ⟨ a , x ⟩)) ω) $ by ex_intro [n6]
n8: $ G , w ∊ ω ⇒ isset a $ by isset_var
n9: $ G , w ∊ ω ⇒ isset w $ by isset_var
n10: $ G , w ∊ ω ⇒ isset ⟨ a , w ⟩ $ by opair_set [n8, n9]
n11: $ G , w ∊ ω ⇒ isset (csn ⟨ a , w ⟩) $ by csn_set [n10]
n12: $ G , w ∊ ω ⇒ ∃ v (v ∊ 𝒫 (suc a × ω) ∧ ⟨ w , v ⟩ ∈ cres (cgr x (csn ⟨ a , x ⟩)) ω) $ by isset_elim [n11, n7]
n13: $ G ⇒ fn_into (cres (cgr x (csn ⟨ a , x ⟩)) ω) ω (𝒫 (suc a × ω)) $ by fn_into_intro [m2, n12]
k1: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) $ by ax
k2: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) $ by ax
k3: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ w = csn ⟨ a , u ⟩ $ by cgr_elim [k1]
k4: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ w = csn ⟨ a , v ⟩ $ by cgr_elim [k2]
k5: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ csn ⟨ a , u ⟩ = w $ by eq_sym [k3]
k6: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ csn ⟨ a , u ⟩ = csn ⟨ a , v ⟩ $ by eq_trans [k5, k4]
k7: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ isset a $ by isset_var
k8: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ isset u $ by isset_var
k9: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ isset ⟨ a , u ⟩ $ by opair_set [k7, k8]
k10: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ ⟨ a , u ⟩ = ⟨ a , v ⟩ $ by csn_inj_c [k9, k6]
k11: $ G , ⟨ u , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) , ⟨ v , w ⟩ ∈ cgr x (csn ⟨ a , x ⟩) ⇒ u = v $ by opair_inj_r [k10]
l1: $ G ⇒ injective (cgr x (csn ⟨ a , x ⟩)) $ by injective_intro [k11]
l2: $ G ⇒ injective (cres (cgr x (csn ⟨ a , x ⟩)) ω) $ by injective_cres [l1]
l3: $ G ⇒ injective (cres (cres (cgr x (csn ⟨ a , x ⟩)) ω) ω) $ by injective_cres [l2]
l4: $ G ⇒ injects (cres (cgr x (csn ⟨ a , x ⟩)) ω) ω (𝒫 (suc a × ω)) $ by injects_intro [n13, l3]
s1: $ G ⇒ isset ω $ by omega_set
s2: $ G ⇒ isset a $ by isset_var
s3: $ G ⇒ isset (suc a) $ by suc_set [s2]
s4: $ G ⇒ isset (suc a × ω) $ by cxp_set [s3, s1]
s5: $ G ⇒ isset (𝒫 (suc a × ω)) $ by cpw_set [s4]
s6: $ G ⇒ isset (ω × 𝒫 (suc a × ω)) $ by cxp_set [s1, s5]
r1: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ rel (cres (cgr x (csn ⟨ a , x ⟩)) ω) $ by cres_rel
r2: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω $ by ax
r3: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ z = ⟨ i , j ⟩ $ by ax
r4: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω $ by ax
r5: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ z ∈ cres (cgr x (csn ⟨ a , x ⟩)) ω $ by welc_wcel [r4]
r6: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ cres (cgr x (csn ⟨ a , x ⟩)) ω $ by wcel_eq_l [r3, r5]
r7: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ i ∊ ω ∧ ⟨ i , j ⟩ ∈ cgr x (csn ⟨ a , x ⟩) $ by cres_elim [r6]
r8: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ i ∊ ω $ by and_elim_l [r7]
r9: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ ⟨ i , j ⟩ ∈ cgr x (csn ⟨ a , x ⟩) $ by and_elim_r [r7]
r10: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ j = csn ⟨ a , i ⟩ $ by cgr_elim [r9]
r11: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ j ∊ 𝒫 (suc a × ω) $ by c1_csn_cpw [r8, r10]
r12: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω , z = ⟨ i , j ⟩ ⇒ z ∊ ω × 𝒫 (suc a × ω) $ by cxp_intro_eq [r3, r8, r11]
r13: $ G , z ∊ cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ z ∊ ω × 𝒫 (suc a × ω) $ by rel_elim [r1, r2, r12]
r14: $ G ⇒ cres (cgr x (csn ⟨ a , x ⟩)) ω ⊆ ω × 𝒫 (suc a × ω) $ by subset_intro [r13]
r15: $ G ⇒ isset (cres (cgr x (csn ⟨ a , x ⟩)) ω) $ by subset_isset [s6, r14]
f1: $ G , f = cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ f = cres (cgr x (csn ⟨ a , x ⟩)) ω $ by ax
f2: $ G , f = cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ cres (cgr x (csn ⟨ a , x ⟩)) ω = f $ by eq_sym [f1]
f3: $ G , f = cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ injects (cres (cgr x (csn ⟨ a , x ⟩)) ω) ω (𝒫 (suc a × ω)) $ by weaken [l4]
f4: $ G , f = cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ ω = ω $ by eq_refl
f5: $ G , f = cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ 𝒫 (suc a × ω) = 𝒫 (suc a × ω) $ by eq_refl
f6: $ G , f = cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ injects f ω (𝒫 (suc a × ω)) $ by injects_eq [f2, f4, f5, f3]
f7: $ G , f = cres (cgr x (csn ⟨ a , x ⟩)) ω ⇒ inj_into ω (𝒫 (suc a × ω)) $ by inj_into_intro [f6]
f8: $ G ⇒ inj_into ω (𝒫 (suc a × ω)) $ by isset_elim [r15, f7]

lemma c1_cgr_val {x v: set} (G: hyps) (B: class x) (A C T: class) (w: set):
  $ G ⇒ w ∊ A $ > $ G ⇒ (⟦ x / w ⟧ B) = T $ > $ G ⇒ T ∈ C $ >
  $ G ⇒ ∃ v (v ∊ C ∧ ⟨ w , v ⟩ ∈ cres (cgr x B) A) $
----
k1: $ G , u = T , u ∊ C ⇒ u = T $ by ax
k2: $ G , u = T , u ∊ C ⇒ (⟦ x / w ⟧ B) = T $ by weaken [#2]
k3: $ G , u = T , u ∊ C ⇒ T = (⟦ x / w ⟧ B) $ by eq_sym [k2]
k4: $ G , u = T , u ∊ C ⇒ u = (⟦ x / w ⟧ B) $ by eq_trans [k1, k3]
k5: $ G , u = T , u ∊ C ⇒ ⟨ w , u ⟩ ∈ cgr x B $ by cgr_intro [k4]
k6: $ G , u = T , u ∊ C ⇒ w ∊ A $ by weaken [#1]
k7: $ G , u = T , u ∊ C ⇒ ⟨ w , u ⟩ ∈ cres (cgr x B) A $ by cres_intro [k6, k5]
k8: $ G , u = T , u ∊ C ⇒ u ∊ C $ by ax
k9: $ G , u = T , u ∊ C ⇒ u ∊ C ∧ ⟨ w , u ⟩ ∈ cres (cgr x B) A $ by and_intro [k8, k7]
k10: $ G , u = T , u ∊ C ⇒ ∃ v (v ∊ C ∧ ⟨ w , v ⟩ ∈ cres (cgr x B) A) $ by ex_intro [k9]
k11: $ G ⇒ ∃ v (v ∊ C ∧ ⟨ w , v ⟩ ∈ cres (cgr x B) A) $ by wcel_elim [#3, k10]

lemma c1_v1 {y: set} (G: hyps y) (a w: set): $ G ⇒ w ∊ ω $ > $ G ⇒ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} = suc w $
----
p1: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} $ by ax
p2: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ (w ∊ ω ∧ k ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w) $ by cab_elim [p1]
p3: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ w ∊ ω ∧ k ∊ suc w $ by ax
p4: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ k ∊ suc w $ by and_elim_r [p3]
p5: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w $ by ax
p6: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ¬ w ∊ ω $ by and_elim_l [p5]
p7: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ w ∊ ω $ by weaken [#1]
p8: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ⊥ $ by not_elim [p6, p7]
p9: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ k ∊ suc w $ by bot_elim [p8]
p10: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ k ∊ suc w $ by or_elim [p2, p4, p9]
q1: $ G , k ∊ suc w ⇒ k ∊ suc w $ by ax
q2: $ G , k ∊ suc w ⇒ w ∊ ω $ by weaken [#1]
q3: $ G , k ∊ suc w ⇒ w ∊ ω ∧ k ∊ suc w $ by and_intro [q2, q1]
q4: $ G , k ∊ suc w ⇒ (w ∊ ω ∧ k ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w) $ by or_intro_l [q3]
q5: $ G , k ∊ suc w ⇒ k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} $ by cab_intro [q4]
q6: $ G ⇒ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} = suc w $ by eq_intro [p10, q5]

lemma c1_v2 {y: set} (G: hyps y) (a w: set): $ G ⇒ ¬ w ∊ ω $ > $ G ⇒ ¬ w = a $ > $ G ⇒ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} = w $
----
p1: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} $ by ax
p2: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ (w ∊ ω ∧ k ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w) $ by cab_elim [p1]
p3: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ w ∊ ω ∧ k ∊ suc w $ by ax
p4: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ w ∊ ω $ by and_elim_l [p3]
p5: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ ¬ w ∊ ω $ by weaken [#1]
p6: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ ⊥ $ by not_elim [p5, p4]
p7: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ k ∊ w $ by bot_elim [p6]
p8: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w $ by ax
p9: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ¬ w = a ∧ k ∊ w $ by and_elim_r [p8]
p10: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ k ∊ w $ by and_elim_r [p9]
p11: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ k ∊ w $ by or_elim [p2, p7, p10]
q1: $ G , k ∊ w ⇒ k ∊ w $ by ax
q2: $ G , k ∊ w ⇒ ¬ w ∊ ω $ by weaken [#1]
q3: $ G , k ∊ w ⇒ ¬ w = a $ by weaken [#2]
q4: $ G , k ∊ w ⇒ ¬ w = a ∧ k ∊ w $ by and_intro [q3, q1]
q5: $ G , k ∊ w ⇒ ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w $ by and_intro [q2, q4]
q6: $ G , k ∊ w ⇒ (w ∊ ω ∧ k ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w) $ by or_intro_r [q5]
q7: $ G , k ∊ w ⇒ k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} $ by cab_intro [q6]
q8: $ G ⇒ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} = w $ by eq_intro [p11, q7]

lemma c1_v3 {y: set} (G: hyps y) (a w: set): $ G ⇒ ω ⊆ a $ > $ G ⇒ w = a $ > $ G ⇒ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} = ∅ $
----
p1: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} $ by ax
p2: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ (w ∊ ω ∧ k ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w) $ by cab_elim [p1]
p3: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ w ∊ ω ∧ k ∊ suc w $ by ax
p4: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ w ∊ ω $ by and_elim_l [p3]
p5: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ w = a $ by weaken [#2]
p6: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ a ∊ ω $ by welc_eq_set [p5, p4]
p7: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ ω ⊆ a $ by weaken [#1]
p8: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ a ∊ a $ by subset_elim [p7, p6]
p9: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , w ∊ ω ∧ k ∊ suc w ⇒ ⊥ $ by notin_self [p8]
p10: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w $ by ax
p11: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ¬ w = a ∧ k ∊ w $ by and_elim_r [p10]
p12: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ¬ w = a $ by and_elim_l [p11]
p13: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ w = a $ by weaken [#2]
p14: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} , ¬ w ∊ ω ∧ ¬ w = a ∧ k ∊ w ⇒ ⊥ $ by not_elim [p12, p13]
p15: $ G , k ∊ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} ⇒ ⊥ $ by or_elim [p2, p9, p14]
p16: $ G ⇒ {y | (w ∊ ω ∧ y ∊ suc w) ∨ (¬ w ∊ ω ∧ ¬ w = a ∧ y ∊ w)} = ∅ $ by empty_eq_intro [p15]

lemma c1_or3 (G: hyps) (p q r c: fml):
  $ G ⇒ p ∨ q ∨ r $ > $ G , p ⇒ c $ > $ G , q ⇒ c $ > $ G , r ⇒ c $ > $ G ⇒ c $
----
l1: $ G , q ∨ r ⇒ q ∨ r $ by ax
l2: $ G , q ∨ r , q ⇒ c $ by weaken [#3]
l3: $ G , q ∨ r , r ⇒ c $ by weaken [#4]
l4: $ G , q ∨ r ⇒ c $ by or_elim [l1, l2, l3]
l5: $ G ⇒ c $ by or_elim [#1, #2, l4]

lemma c1_e1 (G: hyps) (z w: set): $ G ⇒ z = ∅ $ > $ G ⇒ z = suc w $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ suc w = z $ by eq_sym [#2]
l2: $ G ⇒ suc w = ∅ $ by eq_trans [l1, #1]
l3: $ G ⇒ ⊥ $ by suc_ne_empty [l2]

lemma c1_e2 (G: hyps) (z w: set): $ G ⇒ z = ∅ $ > $ G ⇒ z = w $ > $ G ⇒ ¬ w ∊ ω $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ w = z $ by eq_sym [#2]
l2: $ G ⇒ w = ∅ $ by eq_trans [l1, #1]
l3: $ G ⇒ ∅ = w $ by eq_sym [l2]
l4: $ G ⇒ ∅ ∈ ω $ by omega_zero
l5: $ G ⇒ w ∈ ω $ by wcel_eq_l [l3, l4]
l6: $ G ⇒ w ∊ ω $ by wcel_welc [l5]
l7: $ G ⇒ ⊥ $ by not_elim [#3, l6]

lemma c1_e3 (G: hyps) (z u w: set): $ G ⇒ u ∊ ω $ > $ G ⇒ z = suc u $ > $ G ⇒ z = w $ > $ G ⇒ ¬ w ∊ ω $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ suc u ∈ ω $ by omega_suc [#1]
l2: $ G ⇒ suc u = z $ by eq_sym [#2]
l3: $ G ⇒ suc u = w $ by eq_trans [l2, #3]
l4: $ G ⇒ w ∈ ω $ by wcel_eq_l [l3, l1]
l5: $ G ⇒ w ∊ ω $ by wcel_welc [l4]
l6: $ G ⇒ ⊥ $ by not_elim [#4, l5]

lemma c1_dinj (G: hyps) (a u v z: set): $ G ⇒ (u = a ∧ z = ∅) ∨ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $ > $ G ⇒ (v = a ∧ z = ∅) ∨ (v ∊ ω ∧ z = suc v) ∨ (¬ v ∊ ω ∧ z = v) $ > $ G ⇒ u = v $
----
a1: $ G , u = a ∧ z = ∅ ⇒ u = a ∧ z = ∅ $ by ax
a2: $ G , u = a ∧ z = ∅ ⇒ u = a $ by and_elim_l [a1]
a3: $ G , u = a ∧ z = ∅ ⇒ z = ∅ $ by and_elim_r [a1]
a4: $ G , u = a ∧ z = ∅ ⇒ (v = a ∧ z = ∅) ∨ (v ∊ ω ∧ z = suc v) ∨ (¬ v ∊ ω ∧ z = v) $ by weaken [#2]
aa1: $ G , u = a ∧ z = ∅ , v = a ∧ z = ∅ ⇒ v = a ∧ z = ∅ $ by ax
aa2: $ G , u = a ∧ z = ∅ , v = a ∧ z = ∅ ⇒ v = a $ by and_elim_l [aa1]
aa3: $ G , u = a ∧ z = ∅ , v = a ∧ z = ∅ ⇒ a = v $ by eq_sym [aa2]
aa4: $ G , u = a ∧ z = ∅ , v = a ∧ z = ∅ ⇒ u = a $ by weaken [a2]
aa5: $ G , u = a ∧ z = ∅ , v = a ∧ z = ∅ ⇒ u = v $ by eq_trans [aa4, aa3]
ab1: $ G , u = a ∧ z = ∅ , v ∊ ω ∧ z = suc v ⇒ v ∊ ω ∧ z = suc v $ by ax
ab2: $ G , u = a ∧ z = ∅ , v ∊ ω ∧ z = suc v ⇒ z = suc v $ by and_elim_r [ab1]
ab3: $ G , u = a ∧ z = ∅ , v ∊ ω ∧ z = suc v ⇒ z = ∅ $ by weaken [a3]
ab4: $ G , u = a ∧ z = ∅ , v ∊ ω ∧ z = suc v ⇒ ⊥ $ by c1_e1 [ab3, ab2]
ab5: $ G , u = a ∧ z = ∅ , v ∊ ω ∧ z = suc v ⇒ u = v $ by bot_elim [ab4]
ac1: $ G , u = a ∧ z = ∅ , ¬ v ∊ ω ∧ z = v ⇒ ¬ v ∊ ω ∧ z = v $ by ax
ac2: $ G , u = a ∧ z = ∅ , ¬ v ∊ ω ∧ z = v ⇒ ¬ v ∊ ω $ by and_elim_l [ac1]
ac3: $ G , u = a ∧ z = ∅ , ¬ v ∊ ω ∧ z = v ⇒ z = v $ by and_elim_r [ac1]
ac4: $ G , u = a ∧ z = ∅ , ¬ v ∊ ω ∧ z = v ⇒ z = ∅ $ by weaken [a3]
ac5: $ G , u = a ∧ z = ∅ , ¬ v ∊ ω ∧ z = v ⇒ ⊥ $ by c1_e2 [ac4, ac3, ac2]
ac6: $ G , u = a ∧ z = ∅ , ¬ v ∊ ω ∧ z = v ⇒ u = v $ by bot_elim [ac5]
a6: $ G , u = a ∧ z = ∅ ⇒ u = v $ by c1_or3 [a4, aa5, ab5, ac6]
b1: $ G , u ∊ ω ∧ z = suc u ⇒ u ∊ ω ∧ z = suc u $ by ax
b2: $ G , u ∊ ω ∧ z = suc u ⇒ u ∊ ω $ by and_elim_l [b1]
b3: $ G , u ∊ ω ∧ z = suc u ⇒ z = suc u $ by and_elim_r [b1]
b4: $ G , u ∊ ω ∧ z = suc u ⇒ (v = a ∧ z = ∅) ∨ (v ∊ ω ∧ z = suc v) ∨ (¬ v ∊ ω ∧ z = v) $ by weaken [#2]
ba1: $ G , u ∊ ω ∧ z = suc u , v = a ∧ z = ∅ ⇒ v = a ∧ z = ∅ $ by ax
ba2: $ G , u ∊ ω ∧ z = suc u , v = a ∧ z = ∅ ⇒ z = ∅ $ by and_elim_r [ba1]
ba3: $ G , u ∊ ω ∧ z = suc u , v = a ∧ z = ∅ ⇒ z = suc u $ by weaken [b3]
ba4: $ G , u ∊ ω ∧ z = suc u , v = a ∧ z = ∅ ⇒ ⊥ $ by c1_e1 [ba2, ba3]
ba5: $ G , u ∊ ω ∧ z = suc u , v = a ∧ z = ∅ ⇒ u = v $ by bot_elim [ba4]
bb1: $ G , u ∊ ω ∧ z = suc u , v ∊ ω ∧ z = suc v ⇒ v ∊ ω ∧ z = suc v $ by ax
bb2: $ G , u ∊ ω ∧ z = suc u , v ∊ ω ∧ z = suc v ⇒ z = suc v $ by and_elim_r [bb1]
bb3: $ G , u ∊ ω ∧ z = suc u , v ∊ ω ∧ z = suc v ⇒ z = suc u $ by weaken [b3]
bb4: $ G , u ∊ ω ∧ z = suc u , v ∊ ω ∧ z = suc v ⇒ suc u = z $ by eq_sym [bb3]
bb5: $ G , u ∊ ω ∧ z = suc u , v ∊ ω ∧ z = suc v ⇒ suc u = suc v $ by eq_trans [bb4, bb2]
bb6: $ G , u ∊ ω ∧ z = suc u , v ∊ ω ∧ z = suc v ⇒ u = v $ by suc_inj [bb5]
bc1: $ G , u ∊ ω ∧ z = suc u , ¬ v ∊ ω ∧ z = v ⇒ ¬ v ∊ ω ∧ z = v $ by ax
bc2: $ G , u ∊ ω ∧ z = suc u , ¬ v ∊ ω ∧ z = v ⇒ ¬ v ∊ ω $ by and_elim_l [bc1]
bc3: $ G , u ∊ ω ∧ z = suc u , ¬ v ∊ ω ∧ z = v ⇒ z = v $ by and_elim_r [bc1]
bc4: $ G , u ∊ ω ∧ z = suc u , ¬ v ∊ ω ∧ z = v ⇒ z = suc u $ by weaken [b3]
bc5: $ G , u ∊ ω ∧ z = suc u , ¬ v ∊ ω ∧ z = v ⇒ u ∊ ω $ by weaken [b2]
bc6: $ G , u ∊ ω ∧ z = suc u , ¬ v ∊ ω ∧ z = v ⇒ ⊥ $ by c1_e3 [bc5, bc4, bc3, bc2]
bc7: $ G , u ∊ ω ∧ z = suc u , ¬ v ∊ ω ∧ z = v ⇒ u = v $ by bot_elim [bc6]
b6: $ G , u ∊ ω ∧ z = suc u ⇒ u = v $ by c1_or3 [b4, ba5, bb6, bc7]
c1: $ G , ¬ u ∊ ω ∧ z = u ⇒ ¬ u ∊ ω ∧ z = u $ by ax
c2: $ G , ¬ u ∊ ω ∧ z = u ⇒ ¬ u ∊ ω $ by and_elim_l [c1]
c3: $ G , ¬ u ∊ ω ∧ z = u ⇒ z = u $ by and_elim_r [c1]
c4: $ G , ¬ u ∊ ω ∧ z = u ⇒ (v = a ∧ z = ∅) ∨ (v ∊ ω ∧ z = suc v) ∨ (¬ v ∊ ω ∧ z = v) $ by weaken [#2]
ca1: $ G , ¬ u ∊ ω ∧ z = u , v = a ∧ z = ∅ ⇒ v = a ∧ z = ∅ $ by ax
ca2: $ G , ¬ u ∊ ω ∧ z = u , v = a ∧ z = ∅ ⇒ z = ∅ $ by and_elim_r [ca1]
ca3: $ G , ¬ u ∊ ω ∧ z = u , v = a ∧ z = ∅ ⇒ z = u $ by weaken [c3]
ca4: $ G , ¬ u ∊ ω ∧ z = u , v = a ∧ z = ∅ ⇒ ¬ u ∊ ω $ by weaken [c2]
ca5: $ G , ¬ u ∊ ω ∧ z = u , v = a ∧ z = ∅ ⇒ ⊥ $ by c1_e2 [ca2, ca3, ca4]
ca6: $ G , ¬ u ∊ ω ∧ z = u , v = a ∧ z = ∅ ⇒ u = v $ by bot_elim [ca5]
cb1: $ G , ¬ u ∊ ω ∧ z = u , v ∊ ω ∧ z = suc v ⇒ v ∊ ω ∧ z = suc v $ by ax
cb2: $ G , ¬ u ∊ ω ∧ z = u , v ∊ ω ∧ z = suc v ⇒ v ∊ ω $ by and_elim_l [cb1]
cb3: $ G , ¬ u ∊ ω ∧ z = u , v ∊ ω ∧ z = suc v ⇒ z = suc v $ by and_elim_r [cb1]
cb4: $ G , ¬ u ∊ ω ∧ z = u , v ∊ ω ∧ z = suc v ⇒ z = u $ by weaken [c3]
cb5: $ G , ¬ u ∊ ω ∧ z = u , v ∊ ω ∧ z = suc v ⇒ ¬ u ∊ ω $ by weaken [c2]
cb6: $ G , ¬ u ∊ ω ∧ z = u , v ∊ ω ∧ z = suc v ⇒ ⊥ $ by c1_e3 [cb2, cb3, cb4, cb5]
cb7: $ G , ¬ u ∊ ω ∧ z = u , v ∊ ω ∧ z = suc v ⇒ u = v $ by bot_elim [cb6]
cc1: $ G , ¬ u ∊ ω ∧ z = u , ¬ v ∊ ω ∧ z = v ⇒ ¬ v ∊ ω ∧ z = v $ by ax
cc2: $ G , ¬ u ∊ ω ∧ z = u , ¬ v ∊ ω ∧ z = v ⇒ z = v $ by and_elim_r [cc1]
cc3: $ G , ¬ u ∊ ω ∧ z = u , ¬ v ∊ ω ∧ z = v ⇒ z = u $ by weaken [c3]
cc4: $ G , ¬ u ∊ ω ∧ z = u , ¬ v ∊ ω ∧ z = v ⇒ u = z $ by eq_sym [cc3]
cc5: $ G , ¬ u ∊ ω ∧ z = u , ¬ v ∊ ω ∧ z = v ⇒ u = v $ by eq_trans [cc4, cc2]
c6: $ G , ¬ u ∊ ω ∧ z = u ⇒ u = v $ by c1_or3 [c4, ca6, cb7, cc5]
d2: $ G ⇒ u = v $ by c1_or3 [#1, a6, b6, c6]

lemma c1_dcls {y: set} (G: hyps y) (a u z: set):
  $ G ⇒ ω ⊆ a $ > $ G ⇒ u ∊ suc a $ > $ G ⇒ z = {y | (u ∊ ω ∧ y ∊ suc u) ∨ (¬ u ∊ ω ∧ ¬ u = a ∧ y ∊ u)} $ > $ G ⇒ (u = a ∧ z = ∅) ∨ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $
----
s1: $ G ⇒ u ∊ a ∨ u = a $ by suc_elim [#2]
a1: $ G , u = a ⇒ u = a $ by ax
a2: $ G , u = a ⇒ ω ⊆ a $ by weaken [#1]
a3: $ G , u = a ⇒ {y | (u ∊ ω ∧ y ∊ suc u) ∨ (¬ u ∊ ω ∧ ¬ u = a ∧ y ∊ u)} = ∅ $ by c1_v3 [a2, a1]
a4: $ G , u = a ⇒ z = {y | (u ∊ ω ∧ y ∊ suc u) ∨ (¬ u ∊ ω ∧ ¬ u = a ∧ y ∊ u)} $ by weaken [#3]
a5: $ G , u = a ⇒ z = ∅ $ by eq_trans [a4, a3]
a6: $ G , u = a ⇒ u = a ∧ z = ∅ $ by and_intro [a1, a5]
a7: $ G , u = a ⇒ (u = a ∧ z = ∅) ∨ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $ by or_intro_l [a6]
b0: $ G , u ∊ a ⇒ u ∊ ω ∨ ¬ u ∊ ω $ by excluded_middle
b1: $ G , u ∊ a , u ∊ ω ⇒ u ∊ ω $ by ax
b2: $ G , u ∊ a , u ∊ ω ⇒ {y | (u ∊ ω ∧ y ∊ suc u) ∨ (¬ u ∊ ω ∧ ¬ u = a ∧ y ∊ u)} = suc u $ by c1_v1 [b1]
b3: $ G , u ∊ a , u ∊ ω ⇒ z = {y | (u ∊ ω ∧ y ∊ suc u) ∨ (¬ u ∊ ω ∧ ¬ u = a ∧ y ∊ u)} $ by weaken [#3]
b4: $ G , u ∊ a , u ∊ ω ⇒ z = suc u $ by eq_trans [b3, b2]
b5: $ G , u ∊ a , u ∊ ω ⇒ u ∊ ω ∧ z = suc u $ by and_intro [b1, b4]
b6: $ G , u ∊ a , u ∊ ω ⇒ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $ by or_intro_l [b5]
b7: $ G , u ∊ a , u ∊ ω ⇒ (u = a ∧ z = ∅) ∨ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $ by or_intro_r [b6]
c1: $ G , u ∊ a , ¬ u ∊ ω ⇒ ¬ u ∊ ω $ by ax
c2: $ G , u ∊ a , ¬ u ∊ ω , u = a ⇒ u = a $ by ax
c3: $ G , u ∊ a , ¬ u ∊ ω , u = a ⇒ u ∊ a $ by ax
c4: $ G , u ∊ a , ¬ u ∊ ω , u = a ⇒ a ∊ a $ by welc_eq_set [c2, c3]
c5: $ G , u ∊ a , ¬ u ∊ ω , u = a ⇒ ⊥ $ by notin_self [c4]
c6: $ G , u ∊ a , ¬ u ∊ ω ⇒ ¬ u = a $ by not_intro [c5]
c7: $ G , u ∊ a , ¬ u ∊ ω ⇒ {y | (u ∊ ω ∧ y ∊ suc u) ∨ (¬ u ∊ ω ∧ ¬ u = a ∧ y ∊ u)} = u $ by c1_v2 [c1, c6]
c8: $ G , u ∊ a , ¬ u ∊ ω ⇒ z = {y | (u ∊ ω ∧ y ∊ suc u) ∨ (¬ u ∊ ω ∧ ¬ u = a ∧ y ∊ u)} $ by weaken [#3]
c9: $ G , u ∊ a , ¬ u ∊ ω ⇒ z = u $ by eq_trans [c8, c7]
c10: $ G , u ∊ a , ¬ u ∊ ω ⇒ ¬ u ∊ ω ∧ z = u $ by and_intro [c1, c9]
c11: $ G , u ∊ a , ¬ u ∊ ω ⇒ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $ by or_intro_r [c10]
c12: $ G , u ∊ a , ¬ u ∊ ω ⇒ (u = a ∧ z = ∅) ∨ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $ by or_intro_r [c11]
b8: $ G , u ∊ a ⇒ (u = a ∧ z = ∅) ∨ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $ by or_elim [b0, b7, c12]
s2: $ G ⇒ (u = a ∧ z = ∅) ∨ (u ∊ ω ∧ z = suc u) ∨ (¬ u ∊ ω ∧ z = u) $ by or_elim [s1, b8, a7]

