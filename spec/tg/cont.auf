c19: $ G , c = clord a ⇒ fv (stg x B) (clord a) = lfp x B $ by eq_sym [c16]
c20: $ G , c = clord a ⇒ fv (stg x B) c = lfp x B $ by eq_trans [c18, c19]
c21: $ G , c = clord a ⇒ lfp x B ∈ U $ by wcel_eq_l [c20, c13]
c22: $ G ⇒ lfp x B ∈ U $ by isset_elim [c1, c21]
