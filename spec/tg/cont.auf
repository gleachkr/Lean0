c10: $ G , c = clord a ⇒ fv (stg x B) c = fv (stg x B) (clord a) $ by fv_eq [c7, c2]
c11: $ G , c = clord a ⇒ fv (stg x B) (suc (clord a)) = fv (stg x B) (suc c) $ by eq_sym [c9]
c12: $ G , c = clord a ⇒ fv (stg x B) (suc (clord a)) = fv (stg x B) c $ by eq_trans [c11, c6]
c13: $ G , c = clord a ⇒ fv (stg x B) (suc (clord a)) = fv (stg x B) (clord a) $ by eq_trans [c12, c10]
c14: $ G ⇒ fv (stg x B) (suc (clord a)) = fv (stg x B) (clord a) $ by isset_elim [c1, c13]

