w6: $ G , g = (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , w = ⋃ (crn g) , w ∊ c ⇒ crn f ⊆ fv (stg x B) w $ by c2_into [w4a, w4b, w4, w1, w3, w4c, w4d]
w7: $ G , g = (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , w = ⋃ (crn g) , w ∊ c ⇒ w ∊ c ∧ crn f ⊆ fv (stg x B) w $ by and_intro [w1, w6]
w8: $ G , g = (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , w = ⋃ (crn g) , w ∊ c ⇒ ∃ v (v ∊ c ∧ crn f ⊆ fv (stg x B) v) $ by ex_intro [w7]
w9: $ G , g = (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ ∃ v (v ∊ c ∧ crn f ⊆ fv (stg x B) v) $ by wcel_elim [u22, w8]
w10: $ G ⇒ ∃ v (v ∊ c ∧ crn f ⊆ fv (stg x B) v) $ by isset_elim [s32, w9]

stgb_clord_closed
-----------------
m1: $ G ⇒ isset (clord a) $ by clord_set
m2: $ G , c = clord a ⇒ c = clord a $ by ax
m3: $ G , c = clord a ⇒ ord (clord a) $ by clord_ord
m4: $ G , c = clord a ⇒ clord a = c $ by eq_sym [m2]
m5: $ G , c = clord a ⇒ ord c $ by ord_eq [m4, m3]
m6: $ G , c = clord a ⇒ isset (stgb x B c) $ by stgb_set [m5]
m7: $ G , c = clord a ⇒ stgb x B c = stgb x B (clord a) $ by stgb_eq [m2]
m8: $ G , c = clord a ⇒ isset (stgb x B (clord a)) $ by isset_eq [m7, m6]
n1: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) ⇒ z ∊ cap x B (stgb x B (clord a)) $ by ax
n2: $ (⟦ x / u ⟧ (stgb x B (clord a))) ≐ stgb x B (clord a) $ by sb_c_stgb_same
n3: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) ⇒ w = stgb x B (clord a) $ by ax
n4: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) ⇒ cap x B (stgb x B (clord a)) = (⟦ x / w ⟧ B) $ by capv_eq [n2, n3]
n5: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) ⇒ z ∊ (⟦ x / w ⟧ B) $ by welc_eq [n4, n1]
n6: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) ⇒ cont x B a $ by weaken [#3]
n7: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) ⇒ ∃ f (functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f)) $ by cont_elim [n6, n5]
o1: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) $ by ax
o2: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ functional f $ by and_elim_l [o1]
o3: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) $ by and_elim_r [o1]
o4: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ a $ by and_elim_l [o3]
o5: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ crn f ⊆ w ∧ z ∊ cap x B (crn f) $ by and_elim_r [o3]
o6: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ crn f ⊆ w $ by and_elim_l [o5]
o7: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ z ∊ cap x B (crn f) $ by and_elim_r [o5]
o8: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ w = stgb x B (clord a) $ by ax
o9: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ stgb x B c = stgb x B (clord a) $ by weaken [m7]
o10: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ stgb x B (clord a) = stgb x B c $ by eq_sym [o9]
o11: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ w = stgb x B c $ by eq_trans [o8, o10]
o12: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ crn f ⊆ stgb x B c $ by subset_eq_r [o11, o6]
o13: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ mono x B $ by weaken [#1]
o14: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ setop x B $ by weaken [#2]
o15: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ ord c $ by weaken [m5]
o16: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ c = clord a $ by ax
o20: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ ∃ v (v ∊ c ∧ crn f ⊆ fv (stg x B) v) $ by c2_key [o13, o14, o15, o16, o2, o4, o12]
q1: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ v ∊ c ∧ crn f ⊆ fv (stg x B) v $ by ax
q2: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ v ∊ c $ by and_elim_l [q1]
q3: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ crn f ⊆ fv (stg x B) v $ by and_elim_r [q1]
q3a: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ ord c $ by weaken [m5]
q4: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ ord v $ by ord_elem [q3a, q2]
q5: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ isset f $ by isset_var
q6: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ isset (crn f) $ by crn_set [q5]
q7: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ isset (fv (stg x B) v) $ by stg_set
q8: $ (⟦ x / u ⟧ (crn f)) ≐ crn f $ by ceqt_refl
q9: $ (⟦ x / u ⟧ (fv (stg x B) v)) ≐ fv (stg x B) v $ by sb_c_fvstg_vac
q9a: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ mono x B $ by weaken [#1]
q9b: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ setop x B $ by weaken [#2]
q10: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ cap x B (crn f) ⊆ cap x B (fv (stg x B) v) $ by capv_mono [q8, q9, q9a, q6, q7, q3]
q10a: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ z ∊ cap x B (crn f) $ by weaken [o7]
q11: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ z ∊ cap x B (fv (stg x B) v) $ by subset_elim [q10, q10a]
q12: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ fv (stg x B) (suc v) = cap x B (fv (stg x B) v) $ by stg_suc [q9a, q9b, q4]
q13: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ cap x B (fv (stg x B) v) = fv (stg x B) (suc v) $ by eq_sym [q12]
q14: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ z ∊ fv (stg x B) (suc v) $ by welc_eq [q13, q11]
q14a: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ c = clord a $ by ax
q15: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ v ∊ clord a $ by welc_eq [q14a, q2]
q16: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ suc v ∈ clord a $ by clord_suc [q15]
q16a: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ clord a = c $ by eq_sym [q14a]
q17: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ suc v ∈ c $ by wcel_eq_r [q16a, q16]
q18: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ z ∊ stgb x B c $ by stgb_intro_c [q3a, q17, q14]
q18a: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ stgb x B c = stgb x B (clord a) $ by weaken [m7]
q19: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) , v ∊ c ∧ crn f ⊆ fv (stg x B) v ⇒ z ∊ stgb x B (clord a) $ by welc_eq [q18a, q18]
o21: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) , functional f ∧ cdm f ⊆ a ∧ crn f ⊆ w ∧ z ∊ cap x B (crn f) ⇒ z ∊ stgb x B (clord a) $ by ex_elim [o20, q19]
p1: $ G , c = clord a , w = stgb x B (clord a) , z ∊ cap x B (stgb x B (clord a)) ⇒ z ∊ stgb x B (clord a) $ by ex_elim [n7, o21]
s1: $ G , c = clord a , w = stgb x B (clord a) ⇒ cap x B (stgb x B (clord a)) ⊆ stgb x B (clord a) $ by subset_intro [p1]
s2: $ G , c = clord a ⇒ cap x B (stgb x B (clord a)) ⊆ stgb x B (clord a) $ by isset_elim [m8, s1]
s3: $ G ⇒ cap x B (stgb x B (clord a)) ⊆ stgb x B (clord a) $ by isset_elim [m1, s2]

--| `clord a` named by a set variable is an ordinal.
lemma c2_clord_ord_var (G: hyps) (a c: set): $ G ⇒ c = clord a $ > $ G ⇒ ord c $
----
l1: $ G ⇒ ord (clord a) $ by clord_ord
l2: $ G ⇒ clord a = c $ by eq_sym [#1]
l3: $ G ⇒ ord c $ by ord_eq [l2, l1]

--| `stg_clord_stable` at a set variable naming `clord a`.
lemma c2_stable {x: set} (G: hyps x) (B: class x) (a c: set):
  $ G ⇒ mono x B $ > $ G ⇒ setop x B $ > $ G ⇒ cont x B a $ > $ G ⇒ c = clord a $ >
  $ G ⇒ fv (stg x B) (suc c) = fv (stg x B) c $
----
a4: $ G ⇒ ord c $ by c2_clord_ord_var [#4]
a8: $ G ⇒ cap x B (stgb x B (clord a)) ⊆ stgb x B (clord a) $ by stgb_clord_closed [#1, #2, #3]
a9: $ G ⇒ stgb x B c = stgb x B (clord a) $ by stgb_eq [#4]
a10: $ G ⇒ stgb x B (clord a) = stgb x B c $ by eq_sym [a9]
a11: $ (⟦ x / u ⟧ (stgb x B c)) ≐ stgb x B c $ by sb_c_stgb_same
a12: $ (⟦ x / u ⟧ (stgb x B (clord a))) ≐ stgb x B (clord a) $ by sb_c_stgb_same
a13: $ G ⇒ cap x B (stgb x B c) = cap x B (stgb x B (clord a)) $ by capv_eq_arg [a11, a12, a9]
a13a: $ G ⇒ cap x B (stgb x B (clord a)) = cap x B (stgb x B c) $ by eq_sym [a13]
a14a: $ G ⇒ cap x B (stgb x B c) ⊆ stgb x B (clord a) $ by subset_eq_l [a13a, a8]
a14: $ G ⇒ cap x B (stgb x B c) ⊆ stgb x B c $ by subset_eq_r [a10, a14a]
a15: $ G ⇒ fv (stg x B) c = cap x B (stgb x B c) $ by stg_eq [#2, a4]
a15a: $ G ⇒ cap x B (stgb x B c) = fv (stg x B) c $ by eq_sym [a15]
a16: $ G ⇒ fv (stg x B) c ⊆ stgb x B c $ by subset_eq_l [a15a, a14]
b1: $ G , z ∊ stgb x B c ⇒ z ∊ stgb x B c $ by ax
b2: $ G , z ∊ stgb x B c ⇒ ∃ b (b ∊ c ∧ z ∊ fv (stg x B) b) $ by stgb_elim [b1]
b3: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ b ∊ c ∧ z ∊ fv (stg x B) b $ by ax
b4: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ b ∊ c $ by and_elim_l [b3]
b5: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ z ∊ fv (stg x B) b $ by and_elim_r [b3]
b6: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ ord c $ by weaken [a4]
b7: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ ord b $ by ord_elem [b6, b4]
b8: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ b ⊆ c $ by ord_elem_subset [b6, b4]
b9: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ mono x B $ by weaken [#1]
b9a: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ setop x B $ by weaken [#2]
b10: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ fv (stg x B) b ⊆ fv (stg x B) c $ by stg_mono [b9, b9a, b7, b6, b8]
b11: $ G , z ∊ stgb x B c , b ∊ c ∧ z ∊ fv (stg x B) b ⇒ z ∊ fv (stg x B) c $ by subset_elim [b10, b5]
b12: $ G , z ∊ stgb x B c ⇒ z ∊ fv (stg x B) c $ by ex_elim [b2, b11]
b13: $ G ⇒ stgb x B c ⊆ fv (stg x B) c $ by subset_intro [b12]
b14: $ G ⇒ fv (stg x B) c = stgb x B c $ by subset_antisym [a16, b13]
b15: $ G ⇒ fv (stg x B) (suc c) = cap x B (fv (stg x B) c) $ by stg_suc [#1, #2, a4]
b16: $ (⟦ x / u ⟧ (fv (stg x B) c)) ≐ fv (stg x B) c $ by sb_c_fvstg_vac
b17: $ G ⇒ cap x B (fv (stg x B) c) = cap x B (stgb x B c) $ by capv_eq_arg [b16, a11, b14]
b18: $ G ⇒ fv (stg x B) (suc c) = cap x B (stgb x B c) $ by eq_trans [b15, b17]
b20: $ G ⇒ fv (stg x B) (suc c) = fv (stg x B) c $ by eq_trans [b18, a15a]

stg_clord_stable
----------------
c1: $ G ⇒ isset (clord a) $ by clord_set
c2: $ G , c = clord a ⇒ c = clord a $ by ax
c3: $ G , c = clord a ⇒ mono x B $ by weaken [#1]
c4: $ G , c = clord a ⇒ setop x B $ by weaken [#2]
c5: $ G , c = clord a ⇒ cont x B a $ by weaken [#3]
c6: $ G , c = clord a ⇒ fv (stg x B) (suc c) = fv (stg x B) c $ by c2_stable [c3, c4, c5, c2]
c7: $ G , c = clord a ⇒ stg x B = stg x B $ by eq_refl
c8: $ G , c = clord a ⇒ suc c = suc (clord a) $ by suc_eq [c2]
