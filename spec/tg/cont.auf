i3: $ G , w = suc a , y ∊ img f w ⇒ y ∊ img f w $ by ax
i4: $ G , w = suc a , y ∊ img f w ⇒ y ∊ crn f $ by img_elim [i3, i2]
j1: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ ⟨ k , y ⟩ ∈ f $ by ax
j2: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ k ∊ cdm f $ by cdm_intro [j1]
j3: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ cdm f ⊆ a $ by weaken [#2]
j4: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ k ∊ a $ by subset_elim [j3, j2]
j5: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ k ∊ suc a $ by suc_intro_l [j4]
j6: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ w = suc a $ by weaken [e1]
j7: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ suc a = w $ by eq_sym [j6]
j8: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ k ∊ w $ by welc_eq [j7, j5]
j9: $ G , w = suc a , y ∊ crn f , ⟨ k , y ⟩ ∈ f ⇒ y ∊ img f w $ by img_intro [j8, j1]
j10: $ G , w = suc a , y ∊ crn f ⇒ y ∊ crn f $ by ax
j11: $ G , w = suc a , y ∊ crn f ⇒ y ∊ img f w $ by crn_elim [j10, j9]
k1: $ G , w = suc a ⇒ img f w = crn f $ by eq_intro [i4, j11]
k2: $ G , w = suc a ⇒ ⋃ (img f w) = ⋃ (crn f) $ by cuni_eq [k1]
k3: $ G , w = suc a ⇒ ⋃ (crn f) ∈ hartogs (𝒫 (w × ω)) $ by wcel_eq_l [k2, b1]
k4: $ G , w = suc a ⇒ ⋃ (crn f) ∈ hartogs (𝒫 (suc a × ω)) $ by wcel_eq_r [e5, k3]
k5: $ G ⇒ isset a $ by isset_var
k6: $ G ⇒ isset (suc a) $ by suc_set [k5]
k7: $ G ⇒ ⋃ (crn f) ∈ hartogs (𝒫 (suc a × ω)) $ by isset_elim [k6, k4]

clord_universe
--------------
l1: $ G ⇒ suc a ∈ U $ by universe_suc [#1, #3]
l2: $ G , w = suc a , w ∊ U ⇒ w = suc a $ by ax
l3: $ G , w = suc a , w ∊ U ⇒ w ∊ U $ by ax
l4: $ G , w = suc a , w ∊ U ⇒ universe U $ by weaken [#1]
l5: $ G , w = suc a , w ∊ U ⇒ ω ∈ U $ by weaken [#2]
l6: $ G , w = suc a , w ∊ U ⇒ hartogs (𝒫 (w × ω)) ∈ U $ by hartogs_bound_universe [l4, l5, l3]
l7: $ G , w = suc a , w ∊ U ⇒ ω = ω $ by eq_refl
l8: $ G , w = suc a , w ∊ U ⇒ w × ω = suc a × ω $ by cxp_eq [l2, l7]
l9: $ G , w = suc a , w ∊ U ⇒ 𝒫 (w × ω) = 𝒫 (suc a × ω) $ by cpw_eq [l8]
l10: $ G , w = suc a , w ∊ U ⇒ hartogs (𝒫 (w × ω)) = hartogs (𝒫 (suc a × ω)) $ by hartogs_eq [l9]
l11: $ G , w = suc a , w ∊ U ⇒ hartogs (𝒫 (suc a × ω)) ∈ U $ by wcel_eq_l [l10, l6]
l12: $ G ⇒ hartogs (𝒫 (suc a × ω)) ∈ U $ by wcel_elim [l1, l11]

ord_cint
--------
l1: $ G ⇒ a ∊ P → ord a $ by all_elim [#2]
l2: $ G ⇒ ord a $ by imp_elim [l1, #1]
l3: $ G ⇒ ∃ u (u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P)) $ by ord_least [l2, #1]
m1: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) ⇒ u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) $ by ax
m2: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) ⇒ u ∊ P $ by and_elim_l [m1]
m3: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) ⇒ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) $ by and_elim_r [m1]
m4: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) ⇒ ord u $ by and_elim_l [m3]
m5: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) ⇒ ∀ v (v ∊ u → ¬ v ∊ P) $ by and_elim_r [m3]
p1: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ cint P ⇒ k ∊ cint P $ by ax
p2: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ cint P ⇒ u ∊ P $ by weaken [m2]
p3: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ cint P ⇒ k ∊ u $ by cint_elim [p1, p2]
q1: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P ⇒ j ∊ P $ by ax
q2: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P ⇒ ∀ y (y ∊ P → ord y) $ by weaken [#2]
q3: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P ⇒ j ∊ P → ord j $ by all_elim [q2]
q4: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P ⇒ ord j $ by imp_elim [q3, q1]
q5: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P ⇒ ord u $ by weaken [m4]
q6: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P ⇒ j ∊ u ∨ u ⊆ j $ by ord_elem_or_subset [q4, q5]
q7: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , j ∊ u ⇒ ∀ v (v ∊ u → ¬ v ∊ P) $ by weaken [m5]
q8: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , j ∊ u ⇒ j ∊ u → ¬ j ∊ P $ by all_elim [q7]
q9: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , j ∊ u ⇒ j ∊ u $ by ax
q10: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , j ∊ u ⇒ ¬ j ∊ P $ by imp_elim [q8, q9]
q11: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , j ∊ u ⇒ j ∊ P $ by weaken [q1]
q12: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , j ∊ u ⇒ ⊥ $ by not_elim [q10, q11]
q13: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , j ∊ u ⇒ k ∊ j $ by bot_elim [q12]
q14: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , u ⊆ j ⇒ u ⊆ j $ by ax
q15: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , u ⊆ j ⇒ k ∊ u $ by ax
q16: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P , u ⊆ j ⇒ k ∊ j $ by subset_elim [q14, q15]
q17: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u , j ∊ P ⇒ k ∊ j $ by or_elim [q6, q13, q16]
q18: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) , k ∊ u ⇒ k ∊ cint P $ by cint_intro [q17]
r1: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) ⇒ cint P = u $ by eq_intro [p3, q18]
r2: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) ⇒ u = cint P $ by eq_sym [r1]
r3: $ G , u ∊ P ∧ ord u ∧ ∀ v (v ∊ u → ¬ v ∊ P) ⇒ cint P ∈ P $ by wcel_intro [r2, m2]
r4: $ G ⇒ cint P ∈ P $ by ex_elim [l3, r3]

cont_congr
----------
l0: $ seqt u u $ by seqt_refl
l1: $ seqt z z $ by seqt_refl
l2: $ (⟦ x / u ⟧ B) ≐ (⟦ x / u ⟧ D) $ by sb_c_congr [l0, #1]
l3: $ (z ∊ (⟦ x / u ⟧ B)) ⟺ (z ∊ (⟦ x / u ⟧ D)) $ by welc_congr [l1, l2]
l4: $ functional f ⟺ functional f $ by iff_refl
l5: $ cdm f ≐ cdm f $ by ceqt_refl
l6: $ (cdm f ⊆ A) ⟺ (cdm f ⊆ C) $ by subset_congr [l5, #2]
l7: $ (crn f ⊆ u) ⟺ (crn f ⊆ u) $ by iff_refl
l8: $ crn f ≐ crn f $ by ceqt_refl
l9: $ cap x B (crn f) ≐ cap x D (crn f) $ by cap_congr [#1, l8]
l10: $ (z ∊ cap x B (crn f)) ⟺ (z ∊ cap x D (crn f)) $ by welc_congr [l1, l9]
l11: $ (crn f ⊆ u ∧ z ∊ cap x B (crn f)) ⟺ (crn f ⊆ u ∧ z ∊ cap x D (crn f)) $ by and_congr [l7, l10]
l12: $ (cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) ⟺ (cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x D (crn f)) $ by and_congr [l6, l11]
l13: $ (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) ⟺ (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x D (crn f)) $ by and_congr [l4, l12]
l14: $ ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) ⟺ ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x D (crn f)) $ by ex_congr [l13]
l15: $ (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f))) ⟺ (z ∊ (⟦ x / u ⟧ D) → ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x D (crn f))) $ by im_congr [l3, l14]
l16: $ ∀ z (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f))) ⟺ ∀ z (z ∊ (⟦ x / u ⟧ D) → ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x D (crn f))) $ by all_congr [l15]
l17: $ ∀ u ∀ z (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f))) ⟺ ∀ u ∀ z (z ∊ (⟦ x / u ⟧ D) → ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x D (crn f))) $ by all_congr [l16]

sb_f_cont
---------
l1: $ (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ≐ (⟦ x / u ⟧ (⟦ y / t ⟧ B)) $ by sb_c_swap
l0: $ seqt z z $ by seqt_refl
l2: $ (z ∊ (⟦ y / t ⟧ (⟦ x / u ⟧ B))) ⟺ (z ∊ (⟦ x / u ⟧ (⟦ y / t ⟧ B))) $ by welc_congr [l0, l1]
l3: $ ∃ f (functional f ∧ cdm f ⊆ (⟦ y / t ⟧ A) ∧ crn f ⊆ u ∧ z ∊ cap x (⟦ y / t ⟧ B) (crn f)) ⟺ ∃ f (functional f ∧ cdm f ⊆ (⟦ y / t ⟧ A) ∧ crn f ⊆ u ∧ z ∊ cap x (⟦ y / t ⟧ B) (crn f)) $ by iff_refl
l4: $ (z ∊ (⟦ y / t ⟧ (⟦ x / u ⟧ B)) → ∃ f (functional f ∧ cdm f ⊆ (⟦ y / t ⟧ A) ∧ crn f ⊆ u ∧ z ∊ cap x (⟦ y / t ⟧ B) (crn f))) ⟺ (z ∊ (⟦ x / u ⟧ (⟦ y / t ⟧ B)) → ∃ f (functional f ∧ cdm f ⊆ (⟦ y / t ⟧ A) ∧ crn f ⊆ u ∧ z ∊ cap x (⟦ y / t ⟧ B) (crn f))) $ by im_congr [l2, l3]
l5: $ ∀ z (z ∊ (⟦ y / t ⟧ (⟦ x / u ⟧ B)) → ∃ f (functional f ∧ cdm f ⊆ (⟦ y / t ⟧ A) ∧ crn f ⊆ u ∧ z ∊ cap x (⟦ y / t ⟧ B) (crn f))) ⟺ ∀ z (z ∊ (⟦ x / u ⟧ (⟦ y / t ⟧ B)) → ∃ f (functional f ∧ cdm f ⊆ (⟦ y / t ⟧ A) ∧ crn f ⊆ u ∧ z ∊ cap x (⟦ y / t ⟧ B) (crn f))) $ by all_congr [l4]
l6: $ [y/t] (∀ u ∀ z (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)))) ⟺ ∀ u ∀ z (z ∊ (⟦ x / u ⟧ (⟦ y / t ⟧ B)) → ∃ f (functional f ∧ cdm f ⊆ (⟦ y / t ⟧ A) ∧ crn f ⊆ u ∧ z ∊ cap x (⟦ y / t ⟧ B) (crn f))) $ by all_congr [l5]

cont_intro
----------
l1: $ G ⇒ z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by imp_intro [#1]
l2: $ G ⇒ ∀ z (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f))) $ by all_intro [l1]
l3: $ G ⇒ ∀ u ∀ z (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f))) $ by all_intro [l2]

cont_elim
---------
l1: $ G ⇒ ∀ i ∀ j (j ∊ (⟦ x / i ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ i ∧ j ∊ cap x B (crn f))) $ by weaken [#1]
l2: $ G ⇒ ∀ j (j ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ j ∊ cap x B (crn f))) $ by all_elim [l1]
l3: $ G ⇒ z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by all_elim [l2]
l4: $ G ⇒ ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by imp_elim [l3, #2]

cont_mono_index
---------------
l1: $ G , z ∊ (⟦ x / u ⟧ B) ⇒ cont x B A $ by weaken [#1]
l2: $ G , z ∊ (⟦ x / u ⟧ B) ⇒ z ∊ (⟦ x / u ⟧ B) $ by ax
l3: $ G , z ∊ (⟦ x / u ⟧ B) ⇒ ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by cont_elim [l1, l2]
p1: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by ax
p2: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ functional f $ by and_elim_l [p1]
p3: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by and_elim_r [p1]
p4: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ A $ by and_elim_l [p3]
p5: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by and_elim_r [p3]
p6: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ A ⊆ C $ by weaken [#2]
p7: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ C $ by subset_trans [p4, p6]
p8: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by and_intro [p7, p5]
p9: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by and_intro [p2, p8]
p10: $ G , z ∊ (⟦ x / u ⟧ B) ⇒ functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) → functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by imp_intro [p9]
p11: $ G , z ∊ (⟦ x / u ⟧ B) ⇒ ∀ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) → functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by all_intro [p10]
p12: $ G , z ∊ (⟦ x / u ⟧ B) ⇒ ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by ex_mp [p11, l3]
p13: $ G ⇒ cont x B C $ by cont_intro [p12]

--| The least stage containing the value `fv f u` (an element of
--| `stgb x B c`), as a set `j ∊ c`. The context may mention `y` and `k` (the
--| binders of the selector in `c2_key`).
lemma c2_pick {x j y: set} (G: hyps x y) (B: class x) (c f u: set):
  $ G ⇒ ord c $ > $ G ⇒ functional f $ > $ G ⇒ crn f ⊆ stgb x B c $ > $ G ⇒ u ∊ cdm f $ >
  $ G ⇒ ∃ j (j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j) $
----
p1: $ G , ⟨ u , i ⟩ ∈ f ⇒ ⟨ u , i ⟩ ∈ f $ by ax
p2: $ G , ⟨ u , i ⟩ ∈ f ⇒ i ∊ crn f $ by crn_intro [p1]
p3: $ G , ⟨ u , i ⟩ ∈ f ⇒ crn f ⊆ stgb x B c $ by weaken [#3]
p4: $ G , ⟨ u , i ⟩ ∈ f ⇒ i ∊ stgb x B c $ by subset_elim [p3, p2]
p5: $ G , ⟨ u , i ⟩ ∈ f ⇒ ∃ b (b ∊ c ∧ i ∊ fv (stg x B) b) $ by stgb_elim [p4]
p6: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ b ∊ c ∧ i ∊ fv (stg x B) b $ by ax
p7: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ b ∊ c $ by and_elim_l [p6]
p8: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ i ∊ fv (stg x B) b $ by and_elim_r [p6]
p9: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ functional f $ by weaken [#2]
p10: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ ⟨ u , i ⟩ ∈ f $ by weaken [p1]
p11: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ fv f u = i $ by fv_val [p9, p10]
p12: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ i = fv f u $ by eq_sym [p11]
p13: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ fv f u ∈ fv (stg x B) b $ by wcel_intro [p12, p8]
p14: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ b ∊ c ∧ fv f u ∈ fv (stg x B) b $ by and_intro [p7, p13]
p15: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ b ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} $ by cab_intro [p14]
p16: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , z ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ z ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} $ by ax
p17: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , z ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ z ∊ c ∧ fv f u ∈ fv (stg x B) z $ by cab_elim [p16]
p18: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , z ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ z ∊ c $ by and_elim_l [p17]
p19: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , z ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ ord c $ by weaken [#1]
p20: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , z ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ ord z $ by ord_elem [p19, p18]
p21: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ z ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} → ord z $ by imp_intro [p20]
p22: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ ∀ z (z ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} → ord z) $ by all_intro [p21]
p23: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∈ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} $ by ord_cint [p15, p22]
p24: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , g = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} , g ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ g ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} $ by ax
p25: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , g = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} , g ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ g = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} $ by ax
p26: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , g = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} , g ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ g ∊ c ∧ fv f u ∈ fv (stg x B) g $ by cab_elim [p24]
p27: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , g = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} , g ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ g = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ g ∊ c ∧ fv f u ∈ fv (stg x B) g $ by and_intro [p25, p26]
p28: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b , g = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} , g ∊ {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ⇒ ∃ j (j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j) $ by ex_intro [p27]
p29: $ G , ⟨ u , i ⟩ ∈ f , b ∊ c ∧ i ∊ fv (stg x B) b ⇒ ∃ j (j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j) $ by wcel_elim [p23, p28]
p30: $ G , ⟨ u , i ⟩ ∈ f ⇒ ∃ j (j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j) $ by ex_elim [p5, p29]
p31: $ G ⇒ ∃ j (j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j) $ by cdm_elim [#4, p30]

--| The values of `f` lie in the stage at `w`, when each lies in a stage
--| at an element of `crn g` and `w` is their union.
lemma c2_into {x b u: set} (G: hyps x) (B: class x) (c f g w: set):
  $ G ⇒ mono x B $ > $ G ⇒ setop x B $ > $ G ⇒ ord c $ > $ G ⇒ w ∊ c $ > $ G ⇒ ⋃ (crn g) = w $ >
  $ G ⇒ functional f $ > $ G ⇒ ∀ u (u ∊ cdm f → ∃ b (b ∊ crn g ∧ b ∊ c ∧ fv f u ∈ fv (stg x B) b)) $ >
  $ G ⇒ crn f ⊆ fv (stg x B) w $
----
e1: $ G , z ∊ crn f ⇒ z ∊ crn f $ by ax
e2: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f ⇒ ⟨ i , z ⟩ ∈ f $ by ax
e3: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f ⇒ i ∊ cdm f $ by cdm_intro [e2]
e4: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f ⇒ functional f $ by weaken [#6]
e5: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f ⇒ fv f i = z $ by fv_val [e4, e2]
e6: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f ⇒ ∀ u (u ∊ cdm f → ∃ b (b ∊ crn g ∧ b ∊ c ∧ fv f u ∈ fv (stg x B) b)) $ by weaken [#7]
e7: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f ⇒ i ∊ cdm f → ∃ b (b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b) $ by all_elim [e6]
e8: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f ⇒ ∃ b (b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b) $ by imp_elim [e7, e3]
e9: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b $ by ax
e10: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ b ∊ crn g $ by and_elim_l [e9]
e11: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ b ∊ c ∧ fv f i ∈ fv (stg x B) b $ by and_elim_r [e9]
e12: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ b ∊ c $ by and_elim_l [e11]
e13: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ fv f i ∈ fv (stg x B) b $ by and_elim_r [e11]
e14: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ b ⊆ ⋃ (crn g) $ by cuni_subset [e10]
e15: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ ⋃ (crn g) = w $ by weaken [#5]
e16: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ b ⊆ w $ by subset_eq_r [e15, e14]
e17: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ ord c $ by weaken [#3]
e18: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ ord b $ by ord_elem [e17, e12]
e19: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ w ∊ c $ by weaken [#4]
e20: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ ord w $ by ord_elem [e17, e19]
e21: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ mono x B $ by weaken [#1]
e22: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ setop x B $ by weaken [#2]
e23: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ fv (stg x B) b ⊆ fv (stg x B) w $ by stg_mono [e21, e22, e18, e20, e16]
e24: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ fv f i = z $ by weaken [e5]
e25: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ z ∈ fv (stg x B) b $ by wcel_eq_l [e24, e13]
e26: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ z ∊ fv (stg x B) b $ by wcel_welc [e25]
e27: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f , b ∊ crn g ∧ b ∊ c ∧ fv f i ∈ fv (stg x B) b ⇒ z ∊ fv (stg x B) w $ by subset_elim [e23, e26]
e28: $ G , z ∊ crn f , ⟨ i , z ⟩ ∈ f ⇒ z ∊ fv (stg x B) w $ by ex_elim [e8, e27]
e29: $ G , z ∊ crn f ⇒ z ∊ fv (stg x B) w $ by crn_elim [e1, e28]
e30: $ G ⇒ crn f ⊆ fv (stg x B) w $ by subset_intro [e29]

--| The heart of `stgb_clord_closed`: an `a`-indexed family of elements of
--| the stages below `c = clord a` lies in a single stage below `c`. The
--| selector `g` sends `u ∊ cdm f` to the least stage containing `fv f u`
--| (`c2_pick`); its values are bounded below `clord a` (`clord_bound`).
lemma c2_key {x v: set} (G: hyps x) (B: class x) (a c f: set):
  $ G ⇒ mono x B $ > $ G ⇒ setop x B $ > $ G ⇒ ord c $ > $ G ⇒ c = clord a $ >
  $ G ⇒ functional f $ > $ G ⇒ cdm f ⊆ a $ > $ G ⇒ crn f ⊆ stgb x B c $ >
  $ G ⇒ ∃ v (v ∊ c ∧ crn f ⊆ fv (stg x B) v) $
----
s1: $ G ⇒ rel (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) $ by cres_rel
s2: $ G ⇒ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⊆ cdm (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) × crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) $ by rel_subset_cxp [s1]
s3: $ G ⇒ cdm (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⊆ cdm f $ by cres_cdm
s4: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) $ by ax
s5: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) $ by ax
s6: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ u ∊ cdm f ∧ ⟨ u , z ⟩ ∈ (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) $ by cres_elim [s5]
s7: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ u ∊ cdm f $ by and_elim_l [s6]
s8: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ ⟨ u , z ⟩ ∈ (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) $ by and_elim_r [s6]
s9: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ z = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} $ by cgr_elim [s8]
s10: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ ord c $ by weaken [#3]
s11: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ functional f $ by weaken [#5]
s12: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ crn f ⊆ stgb x B c $ by weaken [#7]
s13: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ ∃ j (j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j) $ by c2_pick [s10, s11, s12, s7]
s14: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j $ by ax
s15: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} $ by and_elim_l [s14]
s16: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ j ∊ c ∧ fv f u ∈ fv (stg x B) j $ by and_elim_r [s14]
s17: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ j ∊ c $ by and_elim_l [s16]
s18: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ z = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} $ by weaken [s9]
s19: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} = j $ by eq_sym [s15]
s20: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ z = j $ by eq_trans [s18, s19]
s21: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ j = z $ by eq_sym [s20]
s22: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , j = cint {y | y ∊ c ∧ fv f u ∈ fv (stg x B) y} ∧ j ∊ c ∧ fv f u ∈ fv (stg x B) j ⇒ z ∊ c $ by welc_eq_set [s21, s17]
s23: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) , ⟨ u , z ⟩ ∈ (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ z ∊ c $ by ex_elim [s13, s22]
s24: $ G , z ∊ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⇒ z ∊ c $ by crn_elim [s4, s23]
s25: $ G ⇒ crn (cres (cgr k (cint {y | y ∊ c ∧ fv f k ∈ fv (stg x B) y})) (cdm f)) ⊆ c $ by subset_intro [s24]
