a5: $ … ⇒ isset B $ by isset_intro [a4]
a6: $ G , x ∊ cpr A B , x = B ⇒ ¬ isset B $ by weaken [#1]
a7: $ … ⇒ ⊥ $ by not_elim [a6, a5]
a8: $ … ⇒ x = A $ by bot_elim [a7]
a9: $ … ⇒ x = A $ by or_elim [a2, a3, a8]
a10: $ … ⇒ x ∊ csn A $ by csn_intro [a9]
b1: $ G , x ∊ csn A ⇒ x ∊ csn A $ by ax
b2: $ … ⇒ x = A $ by csn_elim [b1]
b3: $ … ⇒ x = A ∨ x = B $ by or_intro_l [b2]
b4: $ … ⇒ x ∊ cpr A B $ by cpr_intro [b3]
c1: $ … ⇒ cpr A B = csn A $ by eq_intro [a10, b4]

opair_proper
------------
l1: $ … ⇒ cpr A B = csn A $ by cpr_proper [#1]
l2: $ G ⇒ csn A = csn A $ by eq_refl
l3: $ … ⇒ cpr (csn A) (cpr A B) = cpr (csn A) (csn A) $ by cpr_eq [l2, l1]
l4: $ G ⇒ ⟨ A , B ⟩ = ⟨ A , A ⟩ $ by weaken [l3]

opair_inj_l_c
-------------
l0: $ … ⇒ isset (csn A) $ by csn_set [#2]
l1: $ … ⇒ csn A = csn C ∨ csn A = cpr C D $ by cpr_eq_elim_l [#1, l0]
a1: $ G , csn A = csn C ⇒ csn A = csn C $ by ax
a2: $ G , csn A = csn C ⇒ isset A $ by weaken [#2]
a5: $ … ⇒ A = C $ by csn_inj_c [a2, a1]
b1: $ G , csn A = cpr C D ⇒ csn A = cpr C D $ by ax
b2: $ … ⇒ cpr C D = csn A $ by eq_sym [b1]
b3: $ G , csn A = cpr C D ⇒ isset C $ by weaken [#3]
b4: $ … ⇒ C = A ∨ C = A $ by cpr_eq_elim_l [b2, b3]
b5: $ G , csn A = cpr C D , C = A ⇒ C = A $ by ax
b6: $ … ⇒ C = A $ by or_elim [b4, b5, b5]
b7: $ … ⇒ A = C $ by eq_sym [b6]
c1: $ … ⇒ A = C $ by or_elim [l1, a5, b7]

csn_opair_elim
--------------
l1: $ G , z = ⟨ a , b ⟩ , z ∊ csn ⟨ s , c ⟩ ⇒ z ∊ csn ⟨ s , c ⟩ $ by ax
l2: $ … ⇒ z = ⟨ s , c ⟩ $ by csn_elim [l1]
l3: $ G , z = ⟨ a , b ⟩ , z ∊ csn ⟨ s , c ⟩ ⇒ z = ⟨ a , b ⟩ $ by ax
l4: $ … ⇒ ⟨ a , b ⟩ = z $ by eq_sym [l3]
l5: $ … ⇒ ⟨ a , b ⟩ = ⟨ s , c ⟩ $ by eq_trans [l4, l2]
l6: $ … ⇒ a = s $ by opair_inj_l [l5]
l7: $ … ⇒ b = c $ by opair_inj_r [l5]
l8: $ … ⇒ a = s ∧ b = c $ by and_intro [l6, l7]
l9: $ … ⇒ a = s ∧ b = c $ by wcel_elim [#1, l8]

csn_opair_intro
---------------
l1: $ G ⇒ isset s $ by isset_var
l2: $ G ⇒ isset c $ by isset_var
l3: $ … ⇒ isset ⟨ s , c ⟩ $ by opair_set [l1, l2]
l4: $ G , z = ⟨ s , c ⟩ ⇒ z = ⟨ s , c ⟩ $ by ax
l5: $ … ⇒ z ∊ csn ⟨ s , c ⟩ $ by csn_intro [l4]
l6: $ … ⇒ ⟨ s , c ⟩ ∈ csn ⟨ s , c ⟩ $ by wcel_intro [l4, l5]
l7: $ … ⇒ ⟨ s , c ⟩ ∈ csn ⟨ s , c ⟩ $ by isset_elim [l3, l6]

--| The diagonal of a class: the pairs `⟨ y , y ⟩` with `y ∊ A` (for separation).
def sep_diag (A: class) (.w .y: set): class = $ {w | ∃ y (y ∊ A ∧ w = ⟨ y , y ⟩)} $

lemma sep_diag_elim (G: hyps) (A: class) (a b: set):
  $ G ⇒ ⟨ a , b ⟩ ∈ sep_diag A $ > $ G ⇒ a = b ∧ a ∊ A $
----
l1: $ G , k = ⟨ a , b ⟩ , k ∊ sep_diag A ⇒ k ∊ sep_diag A $ by ax
l2: $ G , k = ⟨ a , b ⟩ , k ∊ sep_diag A ⇒ k ∊ {w | ∃ y (y ∊ A ∧ w = ⟨ y , y ⟩)} $ by weaken [l1]
l3: $ … ⇒ ∃ y (y ∊ A ∧ k = ⟨ y , y ⟩) $ by cab_elim [l2]
l4: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ y ∊ A ∧ k = ⟨ y , y ⟩ $ by ax
l5: $ … ⇒ k = ⟨ y , y ⟩ $ by and_elim_r [l4]
l6: $ … ⇒ y ∊ A $ by and_elim_l [l4]
l7: $ G , k = ⟨ a , b ⟩ , y ∊ A ∧ k = ⟨ y , y ⟩ ⇒ k = ⟨ a , b ⟩ $ by ax
l8: $ … ⇒ ⟨ a , b ⟩ = k $ by eq_sym [l7]
l9: $ … ⇒ ⟨ a , b ⟩ = ⟨ y , y ⟩ $ by eq_trans [l8, l5]
l10: $ … ⇒ a = y $ by opair_inj_l [l9]
l11: $ … ⇒ b = y $ by opair_inj_r [l9]
l12: $ … ⇒ y = b $ by eq_sym [l11]
l13: $ … ⇒ a = b $ by eq_trans [l10, l12]
l14: $ … ⇒ y = a $ by eq_sym [l10]
l15: $ … ⇒ a ∊ A $ by welc_eq_set [l14, l6]
l16: $ … ⇒ a = b ∧ a ∊ A $ by and_intro [l13, l15]
l17: $ … ⇒ a = b ∧ a ∊ A $ by ex_elim [l3, l16]
l18: $ … ⇒ a = b ∧ a ∊ A $ by wcel_elim [#1, l17]

lemma sep_diag_intro (G: hyps) (A: class) (a: set):
  $ G ⇒ a ∊ A $ > $ G ⇒ ⟨ a , a ⟩ ∈ sep_diag A $
----
l1: $ G ⇒ isset a $ by isset_var
l2: $ … ⇒ isset ⟨ a , a ⟩ $ by opair_set [l1, l1]
l3: $ G , k = ⟨ a , a ⟩ ⇒ k = ⟨ a , a ⟩ $ by ax
l4: $ G , k = ⟨ a , a ⟩ ⇒ a ∊ A $ by weaken [#1]
l5: $ … ⇒ a ∊ A ∧ k = ⟨ a , a ⟩ $ by and_intro [l4, l3]
l6: $ … ⇒ ∃ y (y ∊ A ∧ k = ⟨ y , y ⟩) $ by ex_intro [l5]
l7: $ … ⇒ k ∊ {w | ∃ y (y ∊ A ∧ w = ⟨ y , y ⟩)} $ by cab_intro [l6]
l8: $ G , k = ⟨ a , a ⟩ ⇒ k ∊ sep_diag A $ by weaken [l7]
l9: $ … ⇒ ⟨ a , a ⟩ ∈ sep_diag A $ by wcel_intro [l3, l8]
l10: $ … ⇒ ⟨ a , a ⟩ ∈ sep_diag A $ by isset_elim [l2, l9]

lemma sep_diag_fun (G: hyps) (A: class): $ G ⇒ functional (sep_diag A) $
----
l1: $ G , ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A ⇒ ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A $ by ax
l2: $ … ⇒ ⟨ u , v ⟩ ∈ sep_diag A $ by and_elim_l [l1]
l3: $ … ⇒ ⟨ u , z ⟩ ∈ sep_diag A $ by and_elim_r [l1]
l4: $ … ⇒ u = v ∧ u ∊ A $ by sep_diag_elim [l2]
l5: $ … ⇒ u = z ∧ u ∊ A $ by sep_diag_elim [l3]
l6: $ … ⇒ u = v $ by and_elim_l [l4]
l7: $ … ⇒ u = z $ by and_elim_l [l5]
l8: $ … ⇒ v = u $ by eq_sym [l6]
l9: $ … ⇒ v = z $ by eq_trans [l8, l7]
l10: $ … ⇒ ⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A → v = z $ by imp_intro [l9]
l11: $ … ⇒ ∀ z (⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A → v = z) $ by all_intro [l10]
l12: $ … ⇒ ∀ v ∀ z (⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A → v = z) $ by all_intro [l11]
l13: $ … ⇒ ∀ u ∀ v ∀ z (⟨ u , v ⟩ ∈ sep_diag A ∧ ⟨ u , z ⟩ ∈ sep_diag A → v = z) $ by all_intro [l12]
l14: $ G ⇒ functional (sep_diag A) $ by weaken [l13]

subset_set
----------
l1: $ G , v ∊ img (sep_diag A) a ⇒ v ∊ img (sep_diag A) a $ by ax
l2: $ G , v ∊ img (sep_diag A) a ⇒ v ∊ {z | ∃ u (u ∊ a ∧ ⟨ u , z ⟩ ∈ sep_diag A)} $ by weaken [l1]
l3: $ … ⇒ ∃ u (u ∊ a ∧ ⟨ u , v ⟩ ∈ sep_diag A) $ by cab_elim [l2]
l4: $ G , u ∊ a ∧ ⟨ u , v ⟩ ∈ sep_diag A ⇒ u ∊ a ∧ ⟨ u , v ⟩ ∈ sep_diag A $ by ax
l5: $ … ⇒ ⟨ u , v ⟩ ∈ sep_diag A $ by and_elim_r [l4]
l6: $ … ⇒ u = v ∧ u ∊ A $ by sep_diag_elim [l5]
l7: $ … ⇒ u = v $ by and_elim_l [l6]
l8: $ … ⇒ u ∊ A $ by and_elim_r [l6]
l9: $ … ⇒ v ∊ A $ by welc_eq_set [l7, l8]
l10: $ … ⇒ v ∊ A $ by ex_elim [l3, l9]
l11: $ G , v ∊ A ⇒ v ∊ A $ by ax
l12: $ G , v ∊ A ⇒ A ⊆ a $ by weaken [#1]
l13: $ … ⇒ v ∊ a $ by subset_elim [l12, l11]
l14: $ … ⇒ ⟨ v , v ⟩ ∈ sep_diag A $ by sep_diag_intro [l11]
l15: $ … ⇒ v ∊ a ∧ ⟨ v , v ⟩ ∈ sep_diag A $ by and_intro [l13, l14]
l16: $ … ⇒ ∃ u (u ∊ a ∧ ⟨ u , v ⟩ ∈ sep_diag A) $ by ex_intro [l15]
l17: $ … ⇒ v ∊ {z | ∃ u (u ∊ a ∧ ⟨ u , z ⟩ ∈ sep_diag A)} $ by cab_intro [l16]
l18: $ G , v ∊ A ⇒ v ∊ img (sep_diag A) a $ by weaken [l17]
l19: $ … ⇒ img (sep_diag A) a = A $ by eq_intro [l10, l18]
l20: $ G ⇒ functional (sep_diag A) $ by sep_diag_fun
l21: $ … ⇒ isset (img (sep_diag A) a) $ by ax_replace [l20]
l22: $ … ⇒ isset A $ by isset_eq [l19, l21]

sep_set
-------
l1: $ G , u ∊ {x | x ∊ a ∧ p} ⇒ u ∊ {x | x ∊ a ∧ p} $ by ax
l2: $ … ⇒ u ∊ a ∧ [ x / u ] p $ by cab_elim [l1]
l3: $ … ⇒ u ∊ a $ by and_elim_l [l2]
l4: $ … ⇒ {x | x ∊ a ∧ p} ⊆ a $ by subset_intro [l3]
l5: $ … ⇒ isset {x | x ∊ a ∧ p} $ by subset_set [l4]

subset_isset
------------
l1: $ G , u = B ⇒ u = B $ by ax
l2: $ … ⇒ B = u $ by eq_sym [l1]
l3: $ G , u = B ⇒ A ⊆ B $ by weaken [#2]
l4: $ … ⇒ A ⊆ u $ by subset_eq_r [l2, l3]
l5: $ … ⇒ isset A $ by subset_set [l4]
l6: $ … ⇒ isset A $ by isset_elim [#1, l5]

lemma p0_pick (G: hyps) {u: set} (A: class): $ G ⇒ ∃ u (isset A → u = A) $
----
l1: $ G ⇒ isset A ∨ ¬ isset A $ by excluded_middle
l2: $ G , isset A ⇒ isset A $ by ax
l3: $ G , isset A , v = A ⇒ v = A $ by ax
l4: $ … ⇒ isset A → v = A $ by imp_intro [l3]
l5: $ … ⇒ ∃ u (isset A → u = A) $ by ex_intro [l4]
l6: $ … ⇒ ∃ u (isset A → u = A) $ by isset_elim [l2, l5]
n1: $ G , ¬ isset A , isset A ⇒ ¬ isset A $ by ax
n2: $ G , ¬ isset A , isset A ⇒ isset A $ by ax
n3: $ … ⇒ ⊥ $ by not_elim [n1, n2]
n4: $ … ⇒ v = A $ by bot_elim [n3]
n5: $ … ⇒ isset A → v = A $ by imp_intro [n4]
n6: $ … ⇒ ∃ u (isset A → u = A) $ by ex_intro [n5]
l7: $ … ⇒ ∃ u (isset A → u = A) $ by or_elim [l1, l6, n6]

lemma p0_cpr_sub (G: hyps) (A B: class) (u v: set): $ G ⇒ isset A → u = A $ > $ G ⇒ isset B → v = B $ > $ G ⇒ cpr A B ⊆ cpr u v $
----
l1: $ G , w ∊ cpr A B ⇒ w ∊ cpr A B $ by ax
l2: $ … ⇒ w = A ∨ w = B $ by cpr_elim [l1]
l3: $ G , w ∊ cpr A B , w = A ⇒ w = A $ by ax
l4: $ … ⇒ isset A $ by isset_intro [l3]
l5: $ G , w ∊ cpr A B , w = A ⇒ isset A → u = A $ by weaken [#1]
l6: $ … ⇒ u = A $ by imp_elim [l5, l4]
l7: $ … ⇒ A = u $ by eq_sym [l6]
l8: $ … ⇒ w = u $ by eq_trans [l3, l7]
l9: $ … ⇒ w = u ∨ w = v $ by or_intro_l [l8]
m3: $ G , w ∊ cpr A B , w = B ⇒ w = B $ by ax
m4: $ … ⇒ isset B $ by isset_intro [m3]
m5: $ G , w ∊ cpr A B , w = B ⇒ isset B → v = B $ by weaken [#2]
m6: $ … ⇒ v = B $ by imp_elim [m5, m4]
m7: $ … ⇒ B = v $ by eq_sym [m6]
m8: $ … ⇒ w = v $ by eq_trans [m3, m7]
m9: $ … ⇒ w = u ∨ w = v $ by or_intro_r [m8]
l10: $ … ⇒ w = u ∨ w = v $ by or_elim [l2, l9, m9]
l11: $ … ⇒ w ∊ cpr u v $ by cpr_intro [l10]
l12: $ … ⇒ cpr A B ⊆ cpr u v $ by subset_intro [l11]

cpr_isset
---------
l1: $ G ⇒ ∃ u (isset A → u = A) $ by p0_pick
l2: $ G ⇒ ∃ v (isset B → v = B) $ by p0_pick
l3: $ G , isset A → u = A , isset B → v = B ⇒ isset A → u = A $ by ax
l4: $ G , isset A → u = A , isset B → v = B ⇒ isset B → v = B $ by ax
l5: $ … ⇒ cpr A B ⊆ cpr u v $ by p0_cpr_sub [l3, l4]
l6: $ G , isset A → u = A , isset B → v = B ⇒ isset (cpr u v) $ by ax_pair
l7: $ … ⇒ isset (cpr A B) $ by subset_isset [l6, l5]
l8: $ G , isset A → u = A ⇒ ∃ v (isset B → v = B) $ by weaken [l2]
l9: $ … ⇒ isset (cpr A B) $ by ex_elim [l8, l7]
l10: $ … ⇒ isset (cpr A B) $ by ex_elim [l1, l9]

opair_isset
-----------
l1: $ G ⇒ isset (cpr (csn A) (cpr A B)) $ by cpr_isset

opair_ne_empty
--------------
l2: $ G ⇒ isset (csn A) $ by cpr_isset
l3: $ … ⇒ csn A ∈ cpr (csn A) (cpr A B) $ by cpr_intro_l_c [l2]
l4: $ … ⇒ csn A ∈ ∅ $ by wcel_eq_r [#1, l3]
l5: $ G , b = csn A , b ∊ ∅ ⇒ b ∊ ∅ $ by ax
l6: $ … ⇒ ⊥ $ by empty_elim [l5]
l7: $ … ⇒ ⊥ $ by wcel_elim [l4, l6]

cuni_intro
----------
l1: $ … ⇒ b ∊ A ∧ a ∊ b $ by and_intro [#2, #1]
l2: $ … ⇒ ∃ y (y ∊ A ∧ a ∊ y) $ by ex_intro [l1]
l3: $ … ⇒ a ∊ {z | ∃ y (y ∊ A ∧ z ∊ y)} $ by cab_intro [l2]

cuni_elim
---------
l1: $ … ⇒ ∃ y (y ∊ A ∧ a ∊ y) $ by cab_elim [#1]
l2: $ … ⇒ a ∊ y → c $ by imp_intro [#2]
l3: $ … ⇒ y ∊ A → a ∊ y → c $ by imp_intro [l2]
l4: $ H , y ∊ A ∧ a ∊ y ⇒ y ∊ A ∧ a ∊ y $ by ax
l5: $ … ⇒ y ∊ A $ by and_elim_l [l4]
l6: $ … ⇒ a ∊ y $ by and_elim_r [l4]
l7: $ H , y ∊ A ∧ a ∊ y ⇒ y ∊ A → a ∊ y → c $ by weaken [l3]
l8: $ … ⇒ a ∊ y → c $ by imp_elim [l7, l5]
l9: $ … ⇒ c $ by imp_elim [l8, l6]
l10: $ … ⇒ c $ by ex_elim [l1, l9]

wcel_cuni_elim
--------------
l1: $ H , w = C , w ∊ ⋃ A ⇒ w ∊ ⋃ A $ by ax
l2: $ H , w = C , y ∊ A , w ∊ y ⇒ w = C $ by ax
l3: $ H , w = C , y ∊ A , w ∊ y ⇒ w ∊ y $ by ax
l4: $ … ⇒ C ∈ y $ by wcel_intro [l2, l3]
l5: $ … ⇒ d $ by cut [l4, #2]
l6: $ … ⇒ d $ by cuni_elim [l1, l5]
l7: $ … ⇒ d $ by wcel_elim [#1, l6]

cuni_set
--------
l1: $ x = A ⇒ x = A $ by ax
l2: $ … ⇒ ⋃ x = ⋃ A $ by cuni_eq [l1]
l3: $ x = A ⇒ isset (⋃ x) $ by ax_union
l4: $ … ⇒ isset (⋃ A) $ by isset_eq [l2, l3]
l5: $ … ⇒ isset (⋃ A) $ by isset_elim [#1, l4]

cuni_subset
-----------
l1: $ G , z ∊ a ⇒ z ∊ a $ by ax
l2: $ G , z ∊ a ⇒ a ∊ A $ by weaken [#1]
l3: $ … ⇒ z ∊ ⋃ A $ by cuni_intro [l1, l2]
l4: $ … ⇒ a ⊆ ⋃ A $ by subset_intro [l3]

cuni_csn
--------
l1: $ G , z ∊ ⋃ (csn A) ⇒ z ∊ ⋃ (csn A) $ by ax
l2: $ G , z ∊ ⋃ (csn A) , y ∊ csn A , z ∊ y ⇒ y ∊ csn A $ by ax
l3: $ … ⇒ y = A $ by csn_elim [l2]
l4: $ G , z ∊ ⋃ (csn A) , y ∊ csn A , z ∊ y ⇒ z ∊ y $ by ax
l5: $ … ⇒ z ∊ A $ by welc_eq [l3, l4]
l6: $ … ⇒ z ∊ A $ by cuni_elim [l1, l5]
l7: $ G , z ∊ A ⇒ A ∈ csn A $ by cpr_intro_l_c [weaken [#1]]
l8: $ G , z ∊ A , w = A , w ∊ csn A ⇒ w = A $ by ax
l9: $ … ⇒ A = w $ by eq_sym [l8]
l10: $ G , z ∊ A , w = A , w ∊ csn A ⇒ z ∊ A $ by ax
l11: $ … ⇒ z ∊ w $ by welc_eq [l9, l10]
l12: $ G , z ∊ A , w = A , w ∊ csn A ⇒ w ∊ csn A $ by ax
l13: $ … ⇒ z ∊ ⋃ (csn A) $ by cuni_intro [l11, l12]
l14: $ … ⇒ z ∊ ⋃ (csn A) $ by wcel_elim [l7, l13]
l15: $ … ⇒ ⋃ (csn A) = A $ by eq_intro [l6, l14]

cun_intro_l
-----------
l1: $ … ⇒ a ∊ A ∨ a ∊ B $ by or_intro_l [#1]
l2: $ … ⇒ a ∊ {z | z ∊ A ∨ z ∊ B} $ by cab_intro [l1]

cun_intro_r
-----------
l1: $ … ⇒ a ∊ A ∨ a ∊ B $ by or_intro_r [#1]
l2: $ … ⇒ a ∊ {z | z ∊ A ∨ z ∊ B} $ by cab_intro [l1]

cun_elim
--------
l2: $ … ⇒ a ∊ A ∨ a ∊ B $ by cab_elim [#1]

cun_comm
--------
l1: $ G , z ∊ A ∪ B ⇒ z ∊ A ∪ B $ by ax
l2: $ … ⇒ z ∊ A ∨ z ∊ B $ by cun_elim [l1]
l3: $ … ⇒ z ∊ B ∨ z ∊ A $ by or_comm [l2]
l4: $ … ⇒ z ∊ {w | w ∊ B ∨ w ∊ A} $ by cab_intro [l3]
l5: $ G , z ∊ B ∪ A ⇒ z ∊ B ∪ A $ by ax
l6: $ … ⇒ z ∊ B ∨ z ∊ A $ by cun_elim [l5]
l7: $ … ⇒ z ∊ A ∨ z ∊ B $ by or_comm [l6]
l8: $ … ⇒ z ∊ {w | w ∊ A ∨ w ∊ B} $ by cab_intro [l7]
l9: $ … ⇒ A ∪ B = B ∪ A $ by eq_intro [l4, l8]

cun_subset_l
------------
l1: $ G , z ∊ A ⇒ z ∊ A $ by ax
l2: $ … ⇒ z ∊ A ∪ B $ by cun_intro_l [l1]
l3: $ … ⇒ A ⊆ A ∪ B $ by subset_intro [l2]

cun_subset_r
------------
l1: $ G , z ∊ B ⇒ z ∊ B $ by ax
l2: $ … ⇒ z ∊ A ∪ B $ by cun_intro_r [l1]
l3: $ … ⇒ B ⊆ A ∪ B $ by subset_intro [l2]

cun_intro_l_c
-------------
l1: $ G ⇒ B ⊆ B ∪ C $ by cun_subset_l
l2: $ … ⇒ A ∈ B ∪ C $ by wcel_subset [l1, #1]

cun_intro_r_c
-------------
l1: $ G ⇒ C ⊆ B ∪ C $ by cun_subset_r
l2: $ … ⇒ A ∈ B ∪ C $ by wcel_subset [l1, #1]

cun_least
---------
l1: $ G , z ∊ A ∪ B ⇒ z ∊ A ∪ B $ by ax
l2: $ … ⇒ z ∊ A ∨ z ∊ B $ by cun_elim [l1]
l3: $ G , z ∊ A ∪ B , z ∊ A ⇒ z ∊ A $ by ax
