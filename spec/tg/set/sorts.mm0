-- sorts.mm0: well-sorted trees over a many-sorted signature. A signature is
-- a set `T` of constructors `⟨ c , ⟨ k , a ⟩ ⟩` (a label `c`, the label `k` of
-- its result sort, and the sequence `a` of its arguments' sort labels, all
-- natural numbers) and a set `O` of open sorts, whose elements are any leaves
-- `⟨ n , ∅ ⟩` (sorts that later text extends with new constants, as a
-- certificate adds blocks and atoms). `sorted T O` is the set of pairs
-- `⟨ k , t ⟩` of a sort and a tree of that sort: the least fixed point of
-- `sgstep`, which adds `⟨ k , ⟨ c , s ⟩ ⟩` when `c` makes sort `k` from the
-- sorts `a` and each child `s i` is paired with `a i` in the set (`szip a s`),
-- and the leaves of the open sorts. The operator is continuous with index set
-- `ω`, so the fixed point exists, is a set, and has an induction principle;
-- its trees are in `trees ω`, where structural recursion (`trc`) defines
-- functions on them. `ofsort T O k` is the set of trees of sort `k`. The
-- syntax of spec/lean.mm0 is such a signature (lean-tg.mm0). Imports
-- trees.mm0; proofs in sorts.auf.

import "trees.mm0";

-- --------------------------------------------------------------------------
-- The definitions
-- --------------------------------------------------------------------------

--| The pairs `⟨ A i , S i ⟩` for `i` in the domain of `A`.
def szip (A S: class) (.i .z: set): class =
  $ {z | ∃ i (i ∊ cdm A ∧ z = ⟨ A' i , S' i ⟩)} $;
--| A signature: constructors with labels and argument sorts in `ω`, and open
--| sorts in `ω`.
def sig (T O: class): fml = $ T ⊆ ω × (ω × fseq ω) ∧ O ⊆ ω $;
--| One step of the sorting: the constructor nodes whose children are sorted
--| in `X` as the constructor requires, and the leaves of the open sorts.
def sgstep (T O X: class) (.c .k .a .s .n .z: set): class =
  $ {z | ∃ c ∃ k ∃ a ∃ s (⟨ c , ⟨ k , a ⟩ ⟩ ∈ T ∧ s ∊ fseq (crn X) ∧ cdm s = cdm a ∧
           szip a s ⊆ X ∧ z = ⟨ k , ⟨ c , s ⟩ ⟩) ∨
         ∃ k ∃ n (k ∊ O ∧ n ∊ ω ∧ z = ⟨ k , ⟨ n , ∅ ⟩ ⟩)} $;
--| The sorted trees, as pairs `⟨ sort , tree ⟩`.
def sorted (T O: class) (.x: set): class = $ lfp x (sgstep T O x) $;
--| The trees of sort `K`.
def ofsort (T O K: class) (.t: set): class = $ {t | ⟨ K , t ⟩ ∈ sorted T O} $;

-- --------------------------------------------------------------------------
-- Zipping
-- --------------------------------------------------------------------------

--| @congr
theorem szip_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ szip A C ≐ szip B D $;
theorem szip_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ szip A C = szip B D $;
--| @rewrite
theorem sb_c_szip {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (szip A B)) ≐ szip (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
theorem szip_intro (G: hyps) (A S: class) (i: set):
  $ G ⇒ i ∊ cdm A $ > $ G ⇒ ⟨ A' i , S' i ⟩ ∈ szip A S $;
--| @freshen G i
theorem szip_elim (G: hyps) {i: set} (A S: class) (z: set):
  $ G ⇒ z ∊ szip A S $ > $ G ⇒ ∃ i (i ∊ cdm A ∧ z = ⟨ A' i , S' i ⟩) $;
theorem szip_empty (G: hyps) (S: class): $ G ⇒ szip ∅ S = ∅ $;
--| Zipping two `scons`es: the heads, then the tails zipped.
theorem szip_scons (G: hyps) (A: class) (a b s t: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ szip (scons a s) (scons b t) = csn ⟨ a , b ⟩ ∪ szip s t $;
--| The second components of a zip are the values of the second sequence.
theorem crn_szip (G: hyps) (A: class) (a s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ cdm a = cdm s $ > $ G ⇒ crn (szip a s) = crn s $;

-- --------------------------------------------------------------------------
-- Signatures
-- --------------------------------------------------------------------------

--| @congr
theorem sig_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ sig A C ⟺ sig B D $;
--| @rewrite
theorem sb_f_sig {x: set} (t: set x) (A B: class x):
  $ [x/t] (sig A B) ⟺ sig (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
theorem sig_intro (G: hyps) (T O: class):
  $ G ⇒ T ⊆ ω × (ω × fseq ω) $ > $ G ⇒ O ⊆ ω $ > $ G ⇒ sig T O $;
theorem sig_table (G: hyps) (T O: class): $ G ⇒ sig T O $ > $ G ⇒ T ⊆ ω × (ω × fseq ω) $;
theorem sig_open (G: hyps) (T O: class): $ G ⇒ sig T O $ > $ G ⇒ O ⊆ ω $;
theorem sig_table_set (G: hyps) (T O: class): $ G ⇒ sig T O $ > $ G ⇒ isset T $;
--| The parts of a constructor.
theorem sig_entry (G: hyps) (T O: class) (c k a: set):
  $ G ⇒ sig T O $ > $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ T $ > $ G ⇒ c ∊ ω ∧ k ∊ ω ∧ a ∊ fseq ω $;

-- --------------------------------------------------------------------------
-- The sorting step
-- --------------------------------------------------------------------------

--| @congr
theorem sgstep_congr (A B C D E F: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ sgstep A C E ≐ sgstep B D F $;
theorem sgstep_eq (G: hyps) (A B C D E F: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ E = F $ > $ G ⇒ sgstep A C E = sgstep B D F $;
--| @rewrite
theorem sb_c_sgstep {x: set} (t: set x) (A B C: class x):
  $ (⟦ x / t ⟧ (sgstep A B C)) ≐ sgstep (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $;
theorem sgstep_node (G: hyps) (T O X: class) (c k a s: set):
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ T $ > $ G ⇒ s ∊ fseq (crn X) $ > $ G ⇒ cdm s = cdm a $ >
  $ G ⇒ szip a s ⊆ X $ > $ G ⇒ ⟨ k , ⟨ c , s ⟩ ⟩ ∈ sgstep T O X $;
theorem sgstep_leaf (G: hyps) (T O X: class) (k n: set):
  $ G ⇒ k ∊ O $ > $ G ⇒ n ∊ ω $ > $ G ⇒ ⟨ k , ⟨ n , ∅ ⟩ ⟩ ∈ sgstep T O X $;
--| @freshen G c
--| @freshen G k
--| @freshen G a
--| @freshen G s
--| @freshen G n
theorem sgstep_elim (G: hyps) {c k a s n: set} (T O X: class) (z: set):
  $ G ⇒ z ∊ sgstep T O X $ >
  $ G ⇒ ∃ c ∃ k ∃ a ∃ s (⟨ c , ⟨ k , a ⟩ ⟩ ∈ T ∧ s ∊ fseq (crn X) ∧ cdm s = cdm a ∧
           szip a s ⊆ X ∧ z = ⟨ k , ⟨ c , s ⟩ ⟩) ∨
         ∃ k ∃ n (k ∊ O ∧ n ∊ ω ∧ z = ⟨ k , ⟨ n , ∅ ⟩ ⟩) $;
theorem sgstep_mono {x: set} (G: hyps x) (T O: class): $ G ⇒ mono x (sgstep T O x) $;
theorem sgstep_setop {x: set} (G: hyps x) (T O: class):
  $ G ⇒ sig T O $ > $ G ⇒ setop x (sgstep T O x) $;
--| A node depends on its children, indexed by its length, an element of `ω`.
theorem sgstep_cont {x: set} (G: hyps x) (T O: class): $ G ⇒ cont x (sgstep T O x) ω $;
--| The step keeps the trees of `ω`.
theorem sgstep_trees (G: hyps) (T O X: class):
  $ G ⇒ sig T O $ > $ G ⇒ X ⊆ ω × trees ω $ > $ G ⇒ sgstep T O X ⊆ ω × trees ω $;

-- --------------------------------------------------------------------------
-- The sorted trees
-- --------------------------------------------------------------------------

--| @congr
theorem sorted_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ sorted A C ≐ sorted B D $;
theorem sorted_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ sorted A C = sorted B D $;
--| @rewrite
theorem sb_c_sorted {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (sorted A B)) ≐ sorted (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
theorem sorted_fix (G: hyps) (T O: class):
  $ G ⇒ sig T O $ > $ G ⇒ sgstep T O (sorted T O) = sorted T O $;
theorem sorted_set (G: hyps) (T O: class): $ G ⇒ sig T O $ > $ G ⇒ isset (sorted T O) $;
theorem sorted_sub (G: hyps) (T O: class): $ G ⇒ sig T O $ > $ G ⇒ sorted T O ⊆ ω × trees ω $;
theorem sorted_node (G: hyps) (T O: class) (c k a s: set):
  $ G ⇒ sig T O $ > $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ T $ > $ G ⇒ s ∊ fseq (trees ω) $ >
  $ G ⇒ cdm s = cdm a $ > $ G ⇒ szip a s ⊆ sorted T O $ > $ G ⇒ ⟨ k , ⟨ c , s ⟩ ⟩ ∈ sorted T O $;
theorem sorted_leaf (G: hyps) (T O: class) (k n: set):
  $ G ⇒ sig T O $ > $ G ⇒ k ∊ O $ > $ G ⇒ n ∊ ω $ > $ G ⇒ ⟨ k , ⟨ n , ∅ ⟩ ⟩ ∈ sorted T O $;
--| Inversion: a sorted tree is a constructor node or a leaf of an open sort.
--| @freshen G c
--| @freshen G a
--| @freshen G s
--| @freshen G n
theorem sorted_elim (G: hyps) {c a s n: set} (T O: class) (k t: set):
  $ G ⇒ sig T O $ > $ G ⇒ ⟨ k , t ⟩ ∈ sorted T O $ >
  $ G ⇒ ∃ c ∃ a ∃ s (⟨ c , ⟨ k , a ⟩ ⟩ ∈ T ∧ s ∊ fseq (trees ω) ∧ cdm s = cdm a ∧
           szip a s ⊆ sorted T O ∧ t = ⟨ c , s ⟩) ∨
         (k ∊ O ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩)) $;
--| Induction over the sorted trees.
--| @freshen G c
--| @freshen G k
--| @freshen G a
--| @freshen G s
--| @freshen G n
theorem sorted_ind (G: hyps) {c k a s n: set} (T O P: class):
  $ G ⇒ sig T O $ >
  $ G ⇒ ∀ c ∀ k ∀ a ∀ s (⟨ c , ⟨ k , a ⟩ ⟩ ∈ T → s ∊ fseq (trees ω) → cdm s = cdm a →
          szip a s ⊆ sorted T O ∩ P → ⟨ k , ⟨ c , s ⟩ ⟩ ∈ P) $ >
  $ G ⇒ ∀ k ∀ n (k ∊ O → n ∊ ω → ⟨ k , ⟨ n , ∅ ⟩ ⟩ ∈ P) $ >
  $ G ⇒ sorted T O ⊆ P $;
theorem sorted_universe (G: hyps) (T O U: class):
  $ G ⇒ sig T O $ > $ G ⇒ universe U $ > $ G ⇒ ω ∈ U $ > $ G ⇒ sorted T O ∈ U $;

-- --------------------------------------------------------------------------
-- The trees of one sort
-- --------------------------------------------------------------------------

--| @congr
theorem ofsort_congr (A B C D E F: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ ofsort A C E ≐ ofsort B D F $;
theorem ofsort_eq (G: hyps) (A B C D E F: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ E = F $ > $ G ⇒ ofsort A C E = ofsort B D F $;
--| @rewrite
theorem sb_c_ofsort {x: set} (t: set x) (A B C: class x):
  $ (⟦ x / t ⟧ (ofsort A B C)) ≐ ofsort (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) $;
theorem ofsort_intro (G: hyps) (T O K: class) (t: set):
  $ G ⇒ ⟨ K , t ⟩ ∈ sorted T O $ > $ G ⇒ t ∊ ofsort T O K $;
theorem ofsort_elim (G: hyps) (T O K: class) (t: set):
  $ G ⇒ t ∊ ofsort T O K $ > $ G ⇒ ⟨ K , t ⟩ ∈ sorted T O $;
theorem ofsort_mem_elim (G: hyps) (T O K A: class):
  $ G ⇒ A ∈ ofsort T O K $ > $ G ⇒ ⟨ K , A ⟩ ∈ sorted T O $;
theorem ofsort_trees (G: hyps) (T O K: class):
  $ G ⇒ sig T O $ > $ G ⇒ ofsort T O K ⊆ trees ω $;
theorem ofsort_set (G: hyps) (T O K: class): $ G ⇒ sig T O $ > $ G ⇒ isset (ofsort T O K) $;
--| The class form of membership, for the encodings (classes, not variables;
--| `A` must be a set: a proper class `A` makes `⟨ K , A ⟩` the pair `⟨ K , K ⟩`).
theorem ofsort_mem (G: hyps) (T O K A: class):
  $ G ⇒ ⟨ K , A ⟩ ∈ sorted T O $ > $ G ⇒ isset A $ > $ G ⇒ A ∈ ofsort T O K $;
theorem ofsort_leaf (G: hyps) (T O K: class) (n: set):
  $ G ⇒ sig T O $ > $ G ⇒ K ∈ O $ > $ G ⇒ n ∊ ω $ > $ G ⇒ ⟨ n , ∅ ⟩ ∈ ofsort T O K $;

--| The constructor nodes by arity, with the children as classes.
theorem ofsort_node0 (G: hyps) (T O C K: class):
  $ G ⇒ sig T O $ > $ G ⇒ ⟨ C , ⟨ K , ∅ ⟩ ⟩ ∈ T $ > $ G ⇒ ⟨ C , ∅ ⟩ ∈ ofsort T O K $;
theorem ofsort_node1 (G: hyps) (T O C K K1 A1: class):
  $ G ⇒ sig T O $ > $ G ⇒ ⟨ C , ⟨ K , scons K1 ∅ ⟩ ⟩ ∈ T $ > $ G ⇒ A1 ∈ ofsort T O K1 $ >
  $ G ⇒ ⟨ C , scons A1 ∅ ⟩ ∈ ofsort T O K $;
theorem ofsort_node2 (G: hyps) (T O C K K1 K2 A1 A2: class):
  $ G ⇒ sig T O $ > $ G ⇒ ⟨ C , ⟨ K , scons K1 (scons K2 ∅) ⟩ ⟩ ∈ T $ >
  $ G ⇒ A1 ∈ ofsort T O K1 $ > $ G ⇒ A2 ∈ ofsort T O K2 $ >
  $ G ⇒ ⟨ C , scons A1 (scons A2 ∅) ⟩ ∈ ofsort T O K $;
theorem ofsort_node3 (G: hyps) (T O C K K1 K2 K3 A1 A2 A3: class):
  $ G ⇒ sig T O $ > $ G ⇒ ⟨ C , ⟨ K , scons K1 (scons K2 (scons K3 ∅)) ⟩ ⟩ ∈ T $ >
  $ G ⇒ A1 ∈ ofsort T O K1 $ > $ G ⇒ A2 ∈ ofsort T O K2 $ > $ G ⇒ A3 ∈ ofsort T O K3 $ >
  $ G ⇒ ⟨ C , scons A1 (scons A2 (scons A3 ∅)) ⟩ ∈ ofsort T O K $;
theorem ofsort_node4 (G: hyps) (T O C K K1 K2 K3 K4 A1 A2 A3 A4: class):
  $ G ⇒ sig T O $ > $ G ⇒ ⟨ C , ⟨ K , scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⟩ ⟩ ∈ T $ >
  $ G ⇒ A1 ∈ ofsort T O K1 $ > $ G ⇒ A2 ∈ ofsort T O K2 $ > $ G ⇒ A3 ∈ ofsort T O K3 $ >
  $ G ⇒ A4 ∈ ofsort T O K4 $ >
  $ G ⇒ ⟨ C , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩ ∈ ofsort T O K $;

--| Inversion at a known constructor, by arity: the children have the sorts
--| the constructor's entry gives. (Which entries a sort has is the
--| signature's business: lean-tg.mm0 states the cases per sort.)
theorem szip_args0 (G: hyps) (s: set):
  $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ cdm s = cdm ∅ $ > $ G ⇒ s = ∅ $;
theorem szip_args1 {x: set} (G: hyps x) (X K1: class) (s: set):
  $ G ⇒ isset K1 $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ cdm s = cdm (scons K1 ∅) $ >
  $ G ⇒ szip (scons K1 ∅) s ⊆ X $ > $ G ⇒ ∃ x (s = scons x ∅ ∧ ⟨ K1 , x ⟩ ∈ X) $;
theorem szip_args2 {x y: set} (G: hyps x y) (X K1 K2: class) (s: set):
  $ G ⇒ isset K1 $ > $ G ⇒ isset K2 $ > $ G ⇒ s ∊ fseq (trees ω) $ >
  $ G ⇒ cdm s = cdm (scons K1 (scons K2 ∅)) $ > $ G ⇒ szip (scons K1 (scons K2 ∅)) s ⊆ X $ >
  $ G ⇒ ∃ x ∃ y (s = scons x (scons y ∅) ∧ ⟨ K1 , x ⟩ ∈ X ∧ ⟨ K2 , y ⟩ ∈ X) $;
theorem szip_args3 {x y z: set} (G: hyps x y z) (X K1 K2 K3: class) (s: set):
  $ G ⇒ isset K1 $ > $ G ⇒ isset K2 $ > $ G ⇒ isset K3 $ > $ G ⇒ s ∊ fseq (trees ω) $ >
  $ G ⇒ cdm s = cdm (scons K1 (scons K2 (scons K3 ∅))) $ >
  $ G ⇒ szip (scons K1 (scons K2 (scons K3 ∅))) s ⊆ X $ >
  $ G ⇒ ∃ x ∃ y ∃ z (s = scons x (scons y (scons z ∅)) ∧ ⟨ K1 , x ⟩ ∈ X ∧ ⟨ K2 , y ⟩ ∈ X ∧
         ⟨ K3 , z ⟩ ∈ X) $;
theorem szip_args4 {x y z w: set} (G: hyps x y z w) (X K1 K2 K3 K4: class) (s: set):
  $ G ⇒ isset K1 $ > $ G ⇒ isset K2 $ > $ G ⇒ isset K3 $ > $ G ⇒ isset K4 $ >
  $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ cdm s = cdm (scons K1 (scons K2 (scons K3 (scons K4 ∅)))) $ >
  $ G ⇒ szip (scons K1 (scons K2 (scons K3 (scons K4 ∅)))) s ⊆ X $ >
  $ G ⇒ ∃ x ∃ y ∃ z ∃ w (s = scons x (scons y (scons z (scons w ∅))) ∧ ⟨ K1 , x ⟩ ∈ X ∧
         ⟨ K2 , y ⟩ ∈ X ∧ ⟨ K3 , z ⟩ ∈ X ∧ ⟨ K4 , w ⟩ ∈ X) $;
