-- seq.mm0: finite sequences. A sequence over `A` is a function from a natural
-- number `n` (its length, `cdm s`) into `A`, with no other pairs (`fseq A`).
-- `scons a s` puts `a` in front (index `0`, the rest shifted up: the de
-- Bruijn order of a context `a :: s`), `ssnoc s a` appends at the end,
-- `scat s t` concatenates; a function `F` maps a sequence `s` to `ccom F s`
-- (`F` after `s`). Induction on sequences is by `scons`. Sequences over an
-- element of a universe are in the universe, and so is the set of them when
-- `ω` is. Imports arith2.mm0; proofs in seq.auf.

import "arith2.mm0";

-- --------------------------------------------------------------------------
-- The definitions
-- --------------------------------------------------------------------------

--| The finite sequences over `A`.
def fseq (A: class) (.n .s: set): class =
  $ {s | ∃ n (n ∊ ω ∧ rel s ∧ cdm s = n ∧ fn_into s n A)} $;
--| `A` in front of `S`.
def scons (A S: class) (.i .y .z: set): class =
  $ csn ⟨ ∅ , A ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S)} $;
--| `A` after the end of `S`.
def ssnoc (S A: class): class = $ S ∪ csn ⟨ cdm S , A ⟩ $;
--| `S` followed by `T`.
def scat (S T: class) (.i .y .z: set): class =
  $ S ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm S) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ T)} $;
--| `S ++ T`: concatenation, associating to the right.
infixr scat: $++$ prec 62;

--| @congr
theorem fseq_congr (A B: class): $ A ≐ B $ > $ fseq A ≐ fseq B $;
theorem welc_fseq_eq (G: hyps) (A B: class) (a: set): $ G ⇒ A = B $ > $ G ⇒ a ∊ fseq A $ > $ G ⇒ a ∊ fseq B $;
theorem fseq_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ fseq A = fseq B $;
--| @rewrite
theorem sb_c_fseq {x: set} (t: set x) (A: class x):
  $ (⟦ x / t ⟧ (fseq A)) ≐ fseq (⟦ x / t ⟧ A) $;
--| @congr
theorem scons_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ scons A C ≐ scons B D $;
theorem welc_scons_eq (G: hyps) (A B C D: class) (a: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ a ∊ scons A C $ > $ G ⇒ a ∊ scons B D $;
theorem scons_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ scons A C = scons B D $;
--| @rewrite
theorem sb_c_scons {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (scons A B)) ≐ scons (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
--| @congr
theorem ssnoc_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ ssnoc A C ≐ ssnoc B D $;
theorem ssnoc_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ ssnoc A C = ssnoc B D $;
--| @rewrite
theorem sb_c_ssnoc {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (ssnoc A B)) ≐ ssnoc (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;
--| @congr
theorem scat_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ A ++ C ≐ B ++ D $;
theorem welc_scat_eq (G: hyps) (A B C D: class) (a: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ a ∊ A ++ C $ > $ G ⇒ a ∊ B ++ D $;
theorem scat_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ A ++ C = B ++ D $;
--| @rewrite
theorem sb_c_scat {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (A ++ B)) ≐ (⟦ x / t ⟧ A) ++ (⟦ x / t ⟧ B) $;

-- --------------------------------------------------------------------------
-- Sequences
-- --------------------------------------------------------------------------

theorem fseq_intro (G: hyps) (A: class) (s n: set):
  $ G ⇒ n ∊ ω $ > $ G ⇒ rel s $ > $ G ⇒ cdm s = n $ > $ G ⇒ fn_into s n A $ > $ G ⇒ s ∊ fseq A $;
--| A function whose domain is a natural number and whose values are in `A`.
theorem fseq_of_fn (G: hyps) (A: class) (s: set):
  $ G ⇒ functional s $ > $ G ⇒ rel s $ > $ G ⇒ cdm s ∈ ω $ > $ G ⇒ crn s ⊆ A $ > $ G ⇒ s ∊ fseq A $;
theorem fseq_functional (G: hyps) (A: class) (s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ functional s $;
theorem fseq_rel (G: hyps) (A: class) (s: set): $ G ⇒ s ∊ fseq A $ > $ G ⇒ rel s $;
theorem fseq_len (G: hyps) (A: class) (s: set): $ G ⇒ s ∊ fseq A $ > $ G ⇒ cdm s ∈ ω $;
theorem fseq_fn_into (G: hyps) (A: class) (s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ fn_into s (cdm s) A $;
theorem fseq_fv (G: hyps) (A: class) (s i: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ i ∊ cdm s $ > $ G ⇒ s' i ∈ A $;
--| Every value of a sequence over `A` is in `A`, when `∅` is (out of the domain the value is `∅`).
theorem fseq_fv_total (G: hyps) (A I: class) (r: set): $ G ⇒ ∅ ∈ A $ > $ G ⇒ r ∊ fseq A $ > $ G ⇒ r' I ∈ A $;
theorem fseq_crn (G: hyps) (A: class) (s: set): $ G ⇒ s ∊ fseq A $ > $ G ⇒ crn s ⊆ A $;
--| Class form of `fseq_crn`.
theorem fseq_crn_c (G: hyps) (A S: class): $ G ⇒ S ∈ fseq A $ > $ G ⇒ crn S ⊆ A $;
theorem fseq_mono (G: hyps) (A B: class): $ G ⇒ A ⊆ B $ > $ G ⇒ fseq A ⊆ fseq B $;
--| `fseq A ⊆ 𝒫 (ω × A)`.
theorem fseq_set (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ isset (fseq A) $;
--| Two sequences of the same length with the same components are equal.
theorem fseq_ext {i: set} (G: hyps i) (A B: class) (s t: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq B $ > $ G ⇒ cdm s = cdm t $ >
  $ G ⇒ ∀ i (i ∊ cdm s → s' i = t' i) $ > $ G ⇒ s = t $;
theorem fseq_empty (G: hyps) (A: class): $ G ⇒ ∅ ∈ fseq A $;
--| A function restricted to a number.
theorem cres_fseq (G: hyps) (A F N: class): $ G ⇒ N ∈ ω $ > $ G ⇒ fn_into F N A $ > $ G ⇒ F ↾ N ∈ fseq A $;
theorem fseq_len_zero (G: hyps) (A: class) (s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ cdm s = ∅ $ > $ G ⇒ s = ∅ $;

-- --------------------------------------------------------------------------
-- In front, at the end, and concatenation
-- --------------------------------------------------------------------------

theorem scons_pair {i: set} (G: hyps i) (U A S: class) (v: set): $ G ⇒ ⟨ U , v ⟩ ∈ scons A S $ > $ G ⇒ isset U $ > $ G ⇒ isset A $ > $ G ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $;
theorem scons_fseq (G: hyps) (A: class) (a s: set):
  $ G ⇒ a ∊ A $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ scons a s ∈ fseq A $;
--| Class form of `scons_fseq`.
theorem scons_fseq_c (G: hyps) (A B C: class): $ G ⇒ B ∈ A $ > $ G ⇒ C ∈ fseq A $ > $ G ⇒ scons B C ∈ fseq A $;
--| `scons A S` is a set when `S` is (the head's pair is a set in any case).
theorem scons_set (G: hyps) (A S: class): $ G ⇒ isset S $ > $ G ⇒ isset (scons A S) $;
--| A proper class in front counts as `∅`.
theorem scons_proper (G: hyps) (A S: class): $ G ⇒ ¬ isset A $ > $ G ⇒ scons A S = scons ∅ S $;
theorem scons_len (G: hyps) (A: class) (a s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ cdm (scons a s) = suc (cdm s) $;
--| A one-entry sequence has length one.
theorem scons_empty_len (G: hyps) (x: set): $ G ⇒ cdm (scons x ∅) = suc ∅ $;
theorem scons_fv_zero (G: hyps) (a s: set): $ G ⇒ (scons a s)' ∅ = a $;
--| Class form of `scons_fv_zero`.
theorem scons_fv_zero_c (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ isset S $ > $ G ⇒ (scons A S)' ∅ = A $;
theorem scons_fv_suc (G: hyps) (a s i: set): $ G ⇒ (scons a s)' (suc i) = s' i $;
--| Class form of `scons_fv_suc`.
theorem scons_fv_suc_c (G: hyps) (A S I: class):
  $ G ⇒ isset A $ > $ G ⇒ isset S $ > $ G ⇒ isset I $ > $ G ⇒ (scons A S)' (suc I) = S' I $;
--| Entrywise inclusion of two sequences survives a common head.
--| @freshen G i
theorem scons_fv_sub {i: set} (G: hyps) (x a b: set):
  $ G ⇒ ∀ i (a' i ⊆ b' i) $ > $ G ⇒ ∀ i ((scons x a)' i ⊆ (scons x b)' i) $;
theorem scons_inj (G: hyps) (a b s t: set):
  $ G ⇒ rel s $ > $ G ⇒ rel t $ > $ G ⇒ scons a s = scons b t $ > $ G ⇒ a = b ∧ s = t $;
--| Class form of `scons_inj` for two-entry sequences.
theorem scons2_inj (G: hyps) (A A2 B B2: class): $ G ⇒ isset A $ > $ G ⇒ isset A2 $ > $ G ⇒ isset B $ > $ G ⇒ isset B2 $ > $ G ⇒ scons A (scons B ∅) = scons A2 (scons B2 ∅) $ > $ G ⇒ A = A2 ∧ B = B2 $;
theorem scons_ne_empty (G: hyps) (a s: set): $ G ⇒ scons a s = ∅ $ > $ G ⇒ ⊥ $;
--| The head of a sequence over `A` is in `A`.
theorem scons_fseq_hd (G: hyps) (A S: class) (x: set): $ G ⇒ scons x S ∈ fseq A $ > $ G ⇒ x ∊ A $;
--| The range of a sequence (Horn premise lists are sequences).
theorem crn_empty (G: hyps): $ G ⇒ crn ∅ = ∅ $;
theorem crn_empty_sub (G: hyps) (X: class): $ G ⇒ crn ∅ ⊆ X $;
theorem crn_scons_sub (G: hyps) (A S X: class):
  $ G ⇒ A ∈ X $ > $ G ⇒ crn S ⊆ X $ > $ G ⇒ crn (scons A S) ⊆ X $;
theorem crn_scons_head (G: hyps) (A S X: class):
  $ G ⇒ isset A $ > $ G ⇒ crn (scons A S) ⊆ X $ > $ G ⇒ A ∈ X $;
theorem crn_scons_tail (G: hyps) (A S X: class):
  $ G ⇒ crn (scons A S) ⊆ X $ > $ G ⇒ crn S ⊆ X $;
--| A sequence is empty or a `scons`.
theorem fseq_cases {x y: set} (G: hyps x y) (A: class) (s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ s = ∅ ∨ ∃ x ∃ y (x ∊ A ∧ y ∊ fseq A ∧ s = scons x y) $;
--| A sequence of length `suc k` is an element in front of a sequence of length `k`.
theorem fseq_suc {e f: set} (G: hyps e f) (A: class) (s k: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ cdm s = suc k $ > $ G ⇒ ∃ e ∃ f (f ∊ fseq A ∧ cdm f = k ∧ s = scons e f) $;
--| Induction on sequences.
theorem fseq_ind {x y: set} (G: hyps x y) (A P: class):
  $ G ⇒ ∅ ∈ P $ > $ G ⇒ ∀ x ∀ y (x ∊ A → y ∊ fseq A → y ∊ P → scons x y ∈ P) $ >
  $ G ⇒ fseq A ⊆ P $;

theorem ssnoc_fseq (G: hyps) (A: class) (s a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ a ∊ A $ > $ G ⇒ ssnoc s a ∈ fseq A $;
theorem ssnoc_len (G: hyps) (A: class) (s a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ cdm (ssnoc s a) = suc (cdm s) $;
theorem ssnoc_fv_last (G: hyps) (A: class) (s a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ (ssnoc s a)' (cdm s) = a $;
theorem ssnoc_fv_lt (G: hyps) (A: class) (s a i: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ i ∊ cdm s $ > $ G ⇒ (ssnoc s a)' i = s' i $;

theorem scat_fseq (G: hyps) (A: class) (s t: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ s ++ t ∈ fseq A $;
theorem scat_len (G: hyps) (A: class) (s t: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ cdm (s ++ t) = nadd (cdm s) (cdm t) $;
--| A sequence followed by a set of pairs at numbers is a set.
theorem scat_set (G: hyps) (A X: class) (p: set):
  $ G ⇒ p ∊ fseq A $ > $ G ⇒ isset X $ > $ G ⇒ cdm X ⊆ ω $ > $ G ⇒ isset (p ++ X) $;
--| Class form of `scat_fseq`.
theorem scat_fseq_c (G: hyps) (A S T: class):
  $ G ⇒ S ∈ fseq A $ > $ G ⇒ T ∈ fseq A $ > $ G ⇒ S ++ T ∈ fseq A $;
--| Class form of `scat_len`.
theorem scat_len_c (G: hyps) (A S T: class):
  $ G ⇒ S ∈ fseq A $ > $ G ⇒ T ∈ fseq A $ > $ G ⇒ cdm (S ++ T) = nadd (cdm S) (cdm T) $;
theorem scat_fv_l (G: hyps) (A: class) (s t i: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ i ∊ cdm s $ > $ G ⇒ (s ++ t)' i = s' i $;
theorem scat_fv_r (G: hyps) (A: class) (s t i: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ i ∊ cdm t $ >
  $ G ⇒ (s ++ t)' (nadd (cdm s) i) = t' i $;
theorem scat_empty_l (G: hyps) (A: class) (t: set): $ G ⇒ t ∊ fseq A $ > $ G ⇒ ∅ ++ t = t $;
theorem scat_empty_r (G: hyps) (s: set): $ G ⇒ s ++ ∅ = s $;
--| Class forms of `scat_fv_l`, `scat_fv_r` (at every index of `ω`: past `cdm t` both
--| sides are `∅`) and `scat_empty_l`.
theorem scat_fv_l_c (G: hyps) (A: class) (s t: set) (I: class):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ I ∈ cdm s $ > $ G ⇒ (s ++ t)' I = s' I $;
theorem scat_fv_r_c (G: hyps) (A: class) (s t: set) (I: class):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ I ∈ ω $ >
  $ G ⇒ (s ++ t)' (nadd (cdm s) I) = t' I $;
theorem scat_empty_l_c (G: hyps) (A T: class): $ G ⇒ T ∈ fseq A $ > $ G ⇒ ∅ ++ T = T $;
--| Concatenations of sequences of the same lengths are equal only for equal parts.
theorem scat_inj (G: hyps) (A: class) (s s2 t t2: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ s2 ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ t2 ∊ fseq A $ >
  $ G ⇒ cdm s = cdm s2 $ > $ G ⇒ cdm t = cdm t2 $ > $ G ⇒ s ++ t = s2 ++ t2 $ > $ G ⇒ s = s2 ∧ t = t2 $;
--| Class form of `scat_inj`.
theorem scat_inj_c (G: hyps) (A S S2 T T2: class):
  $ G ⇒ S ∈ fseq A $ > $ G ⇒ S2 ∈ fseq A $ > $ G ⇒ T ∈ fseq A $ > $ G ⇒ T2 ∈ fseq A $ >
  $ G ⇒ cdm S = cdm S2 $ > $ G ⇒ cdm T = cdm T2 $ > $ G ⇒ S ++ T = S2 ++ T2 $ > $ G ⇒ S = S2 ∧ T = T2 $;
--| Sequences that agree below `cdm p` after a common prefix `p`, and below `suc K`
--| after a common head.
--| @freshen G i
theorem scat_agree {i: set} (G: hyps) (A: class) (p s s2: set):
  $ G ⇒ p ∊ fseq A $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ s2 ∊ fseq A $ >
  $ G ⇒ ∀ i (i ∊ cdm p → (p ++ s)' i = (p ++ s2)' i) $;
theorem scons_agree {i: set} (G: hyps i) (K: class) (x s s2: set):
  $ G ⇒ K ∈ ω $ > $ G ⇒ ∀ i (i ∊ K → s' i = s2' i) $ >
  $ G ⇒ ∀ i (i ∊ suc K → (scons x s)' i = (scons x s2)' i) $;
theorem scat_scons (G: hyps) (A: class) (a s t: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ scons a s ++ t = scons a (s ++ t) $;
--| Class form of `scat_scons`.
theorem scat_scons_c (G: hyps) (V X S T: class):
  $ G ⇒ isset X $ > $ G ⇒ S ∈ fseq V $ > $ G ⇒ T ∈ fseq V $ > $ G ⇒ scons X S ++ T = scons X (S ++ T) $;
--| Prefixing a one-entry sequence is `scons`.
theorem scat_scons_empty (G: hyps) (A: class) (x q: set): $ G ⇒ q ∊ fseq A $ > $ G ⇒ (scons x ∅) ++ q = scons x q $;
--| Concatenating two one-entry sequences.
theorem scat_single (G: hyps) (A B: class): $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ (scons A ∅) ++ (scons B ∅) = scons A (scons B ∅) $;
theorem scat_ssnoc (G: hyps) (A: class) (s t a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ s ++ ssnoc t a = ssnoc (s ++ t) a $;
theorem scat_assoc (G: hyps) (A: class) (s t u: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ u ∊ fseq A $ >
  $ G ⇒ (s ++ t) ++ u = s ++ t ++ u $;
theorem ssnoc_scat (G: hyps) (A: class) (s a: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ ssnoc s a = s ++ (scons a ∅) $;
--| Appending to the empty sequence.
theorem ssnoc_empty (G: hyps) (x: set): $ G ⇒ ssnoc ∅ x = scons x ∅ $;
--| An entry moves from the end of the first part to the front of the second.
theorem scat_ssnoc_scons (G: hyps) (A: class) (e x s: set):
  $ G ⇒ e ∊ fseq A $ > $ G ⇒ x ∊ A $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ ssnoc e x ++ s = e ++ scons x s $;
--| A sequence is empty or ends in an entry.
theorem fseq_cases_snoc {e f: set} (G: hyps e f) (A: class) (v: set):
  $ G ⇒ v ∊ fseq A $ > $ G ⇒ v = ∅ ∨ ∃ e ∃ f (e ∊ fseq A ∧ f ∊ A ∧ v = ssnoc e f) $;

-- --------------------------------------------------------------------------
-- Mapping a function over a sequence
-- --------------------------------------------------------------------------

theorem fv_ccom (G: hyps) (F: class) (s i: set):
  $ G ⇒ functional F $ > $ G ⇒ functional s $ > $ G ⇒ i ∊ cdm s $ > $ G ⇒ s' i ∈ cdm F $ >
  $ G ⇒ (ccom F s)' i = F' s' i $;
theorem ccom_fseq (G: hyps) (F A B: class) (s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ fn_into F A B $ > $ G ⇒ ccom F s ∈ fseq B $;
theorem ccom_len (G: hyps) (F A B: class) (s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ fn_into F A B $ > $ G ⇒ cdm (ccom F s) = cdm s $;
theorem ccom_empty (G: hyps) (F: class): $ G ⇒ ccom F ∅ = ∅ $;
theorem ccom_scons (G: hyps) (F: class) (a s: set):
  $ G ⇒ functional F $ > $ G ⇒ a ∊ cdm F $ > $ G ⇒ ccom F (scons a s) = scons (F' a) (ccom F s) $;
--| Class form of `ccom_scons`.
theorem ccom_scons_c (G: hyps) (F A S: class):
  $ G ⇒ functional F $ > $ G ⇒ A ∈ cdm F $ > $ G ⇒ isset S $ > $ G ⇒ ccom F (scons A S) = scons (F' A) (ccom F S) $;
--| Mapping by a function or by an extension of it gives the same sequence.
theorem ccom_subset_eq (G: hyps) (H K: class) (s: set):
  $ G ⇒ functional K $ > $ G ⇒ H ⊆ K $ > $ G ⇒ crn s ⊆ cdm H $ > $ G ⇒ ccom H s = ccom K s $;

-- --------------------------------------------------------------------------
-- Sequences in a universe
-- --------------------------------------------------------------------------

theorem universe_fseq_elem (G: hyps) (U: class) (a s: set):
  $ G ⇒ universe U $ > $ G ⇒ a ∊ U $ > $ G ⇒ s ∊ fseq a $ > $ G ⇒ s ∈ U $;
--| Class form of `universe_fseq_elem`; two-entry sequences of elements are elements.
theorem universe_fseq_elem_c (G: hyps) (U A S: class): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ S ∈ fseq A $ > $ G ⇒ S ∈ U $;
theorem universe_scons2 (G: hyps) (U A B: class): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ B ∈ U $ > $ G ⇒ scons A (scons B ∅) ∈ U $;
theorem universe_fseq (G: hyps) (U: class) (a: set):
  $ G ⇒ universe U $ > $ G ⇒ ω ∈ U $ > $ G ⇒ a ∊ U $ > $ G ⇒ fseq a ∈ U $;
