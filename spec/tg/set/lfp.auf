l5: $ … ⇒ z ∊ fv (stg x B) w $ by and_elim_r [l3]
l6: $ G , w ∊ a ∧ z ∊ fv (stg x B) w ⇒ ord a $ by weaken [#1]
l7: $ … ⇒ ord w $ by ord_elem [l6, l4]
