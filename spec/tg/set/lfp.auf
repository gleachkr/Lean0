m11: $ … ⇒ rel (⟦ x / g ⟧ B) $ by imp_elim [m10, m8]
m12: $ G , ord v , ∀ k (k ∊ v → rel (fv (stg x B) k)) , g = stgb x B v ⇒ setop x B $ by weaken [#2]
m13: $ G , ord v , ∀ k (k ∊ v → rel (fv (stg x B) k)) , g = stgb x B v ⇒ ord v $ by ax
m14: $ … ⇒ fv (stg x B) v = cap x B (stgb x B v) $ by stg_eq [m12, m13]
m15: $ (⟦ x / j ⟧ (stgb x B v)) ≐ stgb x B v $ by sb_c_stgb_vac
m16: $ (⟦ x / g ⟧ (stgb x B v)) ≐ stgb x B v $ by sb_c_stgb_vac
m17: $ … ⇒ cap x B (stgb x B v) = (⟦ x / g ⟧ B) $ by cap_set_vac [m15, m16, m5]
m18: $ … ⇒ fv (stg x B) v = (⟦ x / g ⟧ B) $ by eq_trans [m14, m17]
m19: $ … ⇒ (⟦ x / g ⟧ B) = fv (stg x B) v $ by eq_sym [m18]
m20: $ … ⇒ rel (fv (stg x B) v) $ by rel_eq [m19, m11]
m21: $ … ⇒ rel (fv (stg x B) v) $ by isset_elim [m4, m20]
m22: $ … ⇒ ∀ v (ord v → rel (fv (stg x B) v)) $ by ord_ind_f [m21]
m23: $ … ⇒ ord a → rel (fv (stg x B) a) $ by all_elim [m22]
m24: $ … ⇒ rel (fv (stg x B) a) $ by imp_elim [m23, #4]

lfp_rel
-------
l1: $ G , z ∊ lfp x B ⇒ z ∊ lfp x B $ by ax
l2: $ … ⇒ ∃ w (ord w ∧ z ∊ fv (stg x B) w) $ by lfp_elim [l1]
l3: $ G , ord w ∧ z ∊ fv (stg x B) w ⇒ ord w ∧ z ∊ fv (stg x B) w $ by ax
l4: $ … ⇒ ord w $ by and_elim_l [l3]
l5: $ … ⇒ z ∊ fv (stg x B) w $ by and_elim_r [l3]
l6: $ G , ord w ∧ z ∊ fv (stg x B) w ⇒ mono x B $ by weaken [#1]
l7: $ G , ord w ∧ z ∊ fv (stg x B) w ⇒ setop x B $ by weaken [#2]
l8: $ G , ord w ∧ z ∊ fv (stg x B) w ⇒ ∀ u (rel u → rel (⟦ x / u ⟧ B)) $ by weaken [#3]
l9: $ … ⇒ rel (fv (stg x B) w) $ by stg_rel_val [l6, l7, l8, l4]
l10: $ G , ord w ∧ z ∊ fv (stg x B) w , z = ⟨ i , j ⟩ ⇒ z = ⟨ i , j ⟩ $ by ax
l11: $ … ⇒ ∃ g (z = ⟨ i , g ⟩) $ by ex_intro [l10]
l12: $ … ⇒ ∃ f ∃ g (z = ⟨ f , g ⟩) $ by ex_intro [l11]
l13: $ … ⇒ ∃ f ∃ g (z = ⟨ f , g ⟩) $ by rel_elim [l9, l5, l12]
l14: $ … ⇒ ∃ f ∃ g (z = ⟨ f , g ⟩) $ by ex_elim [l2, l13]
l15: $ … ⇒ rel (lfp x B) $ by rel_intro [l14]

lfp_fv
------
l1: $ … ⇒ functional (lfp x B) $ by lfp_functional [#1, #2, #3]
l2: $ … ⇒ fv (stg x B) a ⊆ lfp x B $ by stg_subset_lfp [#4]
l3: $ … ⇒ fv (fv (stg x B) a) c = fv (lfp x B) c $ by fv_subset [l1, l2, #5]
l4: $ … ⇒ fv (lfp x B) c = fv (fv (stg x B) a) c $ by eq_sym [l3]
