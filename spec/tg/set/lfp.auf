l4: $ crn (cres (stg x B) C) ≐ crn (cres (stg y (⟦ x / y ⟧ B)) C) $ by crn_congr [l3]
l5: $ stgb x B C ≐ stgb y (⟦ x / y ⟧ B) C $ by cuni_congr [l4]

