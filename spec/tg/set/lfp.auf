l10: $ … ⇒ z ∊ c $ by ex_elim [l2, l9]
l11: $ … ⇒ lfp x B ⊆ c $ by subset_intro [l10]

sb_c_stg_vac
------------
c1: $ (⟦ x / t ⟧ (trec (cgr g {v | ∃ x (x = ⋃ (crn g) ∧ v ∊ B)}))) ≐ trec (cgr g {v | ∃ x (x = ⋃ (crn g) ∧ v ∊ B)}) $ by ceqt_refl

cap_set_vac
-----------
m1: $ G , z ∊ cap x B C ⇒ z ∊ {y | ∃ x (x = C ∧ y ∊ B)} $ by ax
m2: $ … ⇒ ∃ x (x = C ∧ z ∊ B) $ by cab_elim [m1]
m3: $ (∃ x (x = C ∧ z ∊ B)) ⟺ ∃ w (w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B)) $ by ex_alpha
m4: $ G , z ∊ cap x B C ⇒ (∃ x (x = C ∧ z ∊ B)) ↔ ∃ w (w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B)) $ by weaken [m3]
m5: $ … ⇒ ∃ w (w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B)) $ by bi_elim_l [m4, m2]
m6: $ G , w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B) ⇒ w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B) $ by ax
m7: $ … ⇒ w = (⟦ x / w ⟧ C) $ by and_elim_l [m6]
m8: $ … ⇒ z ∊ (⟦ x / w ⟧ B) $ by and_elim_r [m6]
m9: $ G , w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B) ⇒ (⟦ x / w ⟧ C) = C $ by weaken [#1]
m10: $ G , w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B) ⇒ s = C $ by weaken [#3]
m11: $ … ⇒ C = s $ by eq_sym [m10]
m12: $ … ⇒ w = C $ by eq_trans [m7, m9]
m13: $ … ⇒ w = s $ by eq_trans [m12, m11]
m14: $ … ⇒ (⟦ x / w ⟧ B) = (⟦ x / s ⟧ B) $ by sb_c_eq [m13]
m15: $ … ⇒ z ∊ (⟦ x / s ⟧ B) $ by welc_eq [m14, m8]
m16: $ … ⇒ z ∊ (⟦ x / s ⟧ B) $ by ex_elim [m5, m15]
n1: $ G , z ∊ (⟦ x / s ⟧ B) ⇒ z ∊ (⟦ x / s ⟧ B) $ by ax
n2: $ G , z ∊ (⟦ x / s ⟧ B) ⇒ s = C $ by weaken [#3]
n3: $ G , z ∊ (⟦ x / s ⟧ B) ⇒ (⟦ x / s ⟧ C) = C $ by weaken [#2]
n4: $ … ⇒ C = (⟦ x / s ⟧ C) $ by eq_sym [n3]
n5: $ … ⇒ s = (⟦ x / s ⟧ C) $ by eq_trans [n2, n4]
n6: $ … ⇒ s = (⟦ x / s ⟧ C) ∧ z ∊ (⟦ x / s ⟧ B) $ by and_intro [n5, n1]
n7: $ … ⇒ ∃ w (w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B)) $ by ex_intro [n6]
n8: $ G , z ∊ (⟦ x / s ⟧ B) ⇒ (∃ x (x = C ∧ z ∊ B)) ↔ ∃ w (w = (⟦ x / w ⟧ C) ∧ z ∊ (⟦ x / w ⟧ B)) $ by weaken [m3]
n9: $ … ⇒ ∃ x (x = C ∧ z ∊ B) $ by bi_elim_r [n8, n7]
n10: $ … ⇒ z ∊ {y | ∃ x (x = C ∧ y ∊ B)} $ by cab_intro [n9]
n11: $ G , z ∊ (⟦ x / s ⟧ B) ⇒ z ∊ cap x B C $ by weaken [n10]
k1: $ … ⇒ cap x B C = (⟦ x / s ⟧ B) $ by eq_intro [m16, n11]

sb_c_stgb_vac
-------------
d1: $ (⟦ x / t ⟧ (stg x B)) ≐ stg x B $ by sb_c_stg_vac
d2: $ A ≐ A $ by ceqt_refl
d3: $ cres (⟦ x / t ⟧ (stg x B)) A ≐ cres (stg x B) A $ by cres_congr [d1, d2]
d4: $ crn (cres (⟦ x / t ⟧ (stg x B)) A) ≐ crn (cres (stg x B) A) $ by crn_congr [d3]
d5: $ (⟦ x / t ⟧ (⋃ (crn (cres (stg x B) A)))) ≐ ⋃ (crn (cres (stg x B) A)) $ by cuni_congr [d4]

sb_c_fvstg_vac
--------------
d1: $ (⟦ x / t ⟧ (stg x B)) ≐ stg x B $ by sb_c_stg_vac
d2: $ A ≐ A $ by ceqt_refl
d3: $ (⟦ x / t ⟧ (fv (stg x B) A)) ≐ fv (stg x B) A $ by fv_congr [d1, d2]

sb_c_lfp_vac
------------
d1: $ (⟦ x / t ⟧ (stg x B)) ≐ stg x B $ by sb_c_stg_vac
d2: $ a ≐ a $ by ceqt_refl
d3: $ fv (⟦ x / t ⟧ (stg x B)) a ≐ fv (stg x B) a $ by fv_congr [d1, d2]
d4: $ seqt y y $ by seqt_refl
d5: $ (y ∊ fv (⟦ x / t ⟧ (stg x B)) a) ⟺ (y ∊ fv (stg x B) a) $ by welc_congr [d4, d3]
d6: $ ord a ⟺ ord a $ by iff_refl
d7: $ (ord a ∧ y ∊ fv (⟦ x / t ⟧ (stg x B)) a) ⟺ (ord a ∧ y ∊ fv (stg x B) a) $ by and_congr [d6, d5]
d8: $ (∃ a (ord a ∧ y ∊ fv (⟦ x / t ⟧ (stg x B)) a)) ⟺ ∃ a (ord a ∧ y ∊ fv (stg x B) a) $ by ex_congr [d7]
d9: $ (⟦ x / t ⟧ {y | ∃ a (ord a ∧ y ∊ fv (stg x B) a)}) ≐ {y | ∃ a (ord a ∧ y ∊ fv (stg x B) a)} $ by cab_congr [d8]

lemma l2_stab_step {x k: set} (G: hyps x k) (B: class x) (a v: set):
  $ G ⇒ mono x B $ > $ G ⇒ setop x B $ > $ G ⇒ ord a $ > $ G ⇒ fv (stg x B) (suc a) = fv (stg x B) a $ > $ G ⇒ ord v $ > $ G ⇒ a ∊ v $ > $ G ⇒ ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) $ > $ G ⇒ fv (stg x B) v = fv (stg x B) a $
----
s1: $ G , z ∊ stgb x B v ⇒ z ∊ stgb x B v $ by ax
s2: $ … ⇒ ∃ w (w ∊ v ∧ z ∊ fv (stg x B) w) $ by stgb_elim [s1]
s3: $ G , w ∊ v ∧ z ∊ fv (stg x B) w ⇒ w ∊ v ∧ z ∊ fv (stg x B) w $ by ax
s4: $ … ⇒ w ∊ v $ by and_elim_l [s3]
s5: $ … ⇒ z ∊ fv (stg x B) w $ by and_elim_r [s3]
s6: $ G , w ∊ v ∧ z ∊ fv (stg x B) w ⇒ ord v $ by weaken [#5]
s7: $ … ⇒ ord w $ by ord_elem [s6, s4]
s8: $ G , w ∊ v ∧ z ∊ fv (stg x B) w ⇒ ord a $ by weaken [#3]
s9: $ … ⇒ w ⊆ a ∨ a ⊆ w $ by ord_subset_or [s7, s8]
s10: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ mono x B $ by weaken [#1]
s11: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ setop x B $ by weaken [#2]
s12: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ ord w $ by weaken [s7]
s13: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ ord a $ by weaken [#3]
s14: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ w ⊆ a $ by ax
s15: $ … ⇒ fv (stg x B) w ⊆ fv (stg x B) a $ by stg_mono [s10, s11, s12, s13, s14]
s16: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ z ∊ fv (stg x B) w $ by weaken [s5]
s17: $ … ⇒ z ∊ fv (stg x B) a $ by subset_elim [s15, s16]
s18: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) $ by weaken [#7]
s19: $ … ⇒ w ∊ v → a ⊆ w → fv (stg x B) w = fv (stg x B) a $ by all_elim [s18]
s20: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ w ∊ v $ by weaken [s4]
s21: $ … ⇒ a ⊆ w → fv (stg x B) w = fv (stg x B) a $ by imp_elim [s19, s20]
s22: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ a ⊆ w $ by ax
s23: $ … ⇒ fv (stg x B) w = fv (stg x B) a $ by imp_elim [s21, s22]
s24: $ G , w ∊ v ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ z ∊ fv (stg x B) w $ by weaken [s5]
s25: $ … ⇒ z ∊ fv (stg x B) a $ by welc_eq [s23, s24]
s26: $ … ⇒ z ∊ fv (stg x B) a $ by or_elim [s9, s17, s25]
s27: $ … ⇒ z ∊ fv (stg x B) a $ by ex_elim [s2, s26]
s28: $ … ⇒ stgb x B v ⊆ fv (stg x B) a $ by subset_intro [s27]
s29: $ … ⇒ fv (stg x B) a ⊆ stgb x B v $ by stg_subset_stgb [#5, #6]
s30: $ … ⇒ stgb x B v = fv (stg x B) a $ by subset_antisym [s28, s29]
s31: $ … ⇒ fv (stg x B) v = cap x B (stgb x B v) $ by stg_eq [#2, #5]
s32: $ G ⇒ isset (fv (stg x B) a) $ by stg_set
s33: $ G , u = fv (stg x B) a ⇒ u = fv (stg x B) a $ by ax
s34a: $ G , u = fv (stg x B) a ⇒ stgb x B v = fv (stg x B) a $ by weaken [s30]
s34: $ … ⇒ fv (stg x B) a = stgb x B v $ by eq_sym [s34a]
s35: $ … ⇒ u = stgb x B v $ by eq_trans [s33, s34]
s36: $ (⟦ x / j ⟧ (stgb x B v)) ≐ stgb x B v $ by sb_c_stgb_vac
s37: $ (⟦ x / u ⟧ (stgb x B v)) ≐ stgb x B v $ by sb_c_stgb_vac
s38: $ … ⇒ cap x B (stgb x B v) = (⟦ x / u ⟧ B) $ by cap_set_vac [s36, s37, s35]
s39: $ (⟦ x / j ⟧ (fv (stg x B) a)) ≐ fv (stg x B) a $ by sb_c_fvstg_vac
s40: $ (⟦ x / u ⟧ (fv (stg x B) a)) ≐ fv (stg x B) a $ by sb_c_fvstg_vac
s41: $ … ⇒ cap x B (fv (stg x B) a) = (⟦ x / u ⟧ B) $ by cap_set_vac [s39, s40, s33]
s43: $ … ⇒ fv (stg x B) (suc a) = cap x B (fv (stg x B) a) $ by stg_suc [#1, #2, #3]
s42: $ G , u = fv (stg x B) a ⇒ fv (stg x B) (suc a) = cap x B (fv (stg x B) a) $ by weaken [s43]
s44: $ G , u = fv (stg x B) a ⇒ fv (stg x B) v = cap x B (stgb x B v) $ by weaken [s31]
s45: $ … ⇒ fv (stg x B) v = (⟦ x / u ⟧ B) $ by eq_trans [s44, s38]
s46: $ … ⇒ fv (stg x B) (suc a) = (⟦ x / u ⟧ B) $ by eq_trans [s42, s41]
s47: $ … ⇒ (⟦ x / u ⟧ B) = fv (stg x B) (suc a) $ by eq_sym [s46]
s48: $ … ⇒ fv (stg x B) v = fv (stg x B) (suc a) $ by eq_trans [s45, s47]
s49: $ G , u = fv (stg x B) a ⇒ fv (stg x B) (suc a) = fv (stg x B) a $ by weaken [#4]
s50: $ … ⇒ fv (stg x B) v = fv (stg x B) a $ by eq_trans [s48, s49]
s51: $ … ⇒ fv (stg x B) v = fv (stg x B) a $ by isset_elim [s32, s50]

stg_stable_above
----------------
l1: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v ⇒ a = v ∨ ¬ a = v $ by excluded_middle
l2: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , a = v ⇒ a = v $ by ax
l3: $ … ⇒ v = a $ by eq_sym [l2]
l4: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , a = v ⇒ stg x B = stg x B $ by eq_refl
l5: $ … ⇒ fv (stg x B) v = fv (stg x B) a $ by fv_eq [l4, l3]
l6: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , ¬ a = v ⇒ ord a $ by weaken [#3]
l7: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , ¬ a = v ⇒ ord v $ by ax
l8: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , ¬ a = v ⇒ a ⊆ v $ by ax
l9: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , ¬ a = v ⇒ ¬ a = v $ by ax
l10: $ … ⇒ a ∊ v $ by ord_subset_elem [l6, l7, l8, l9]
l11: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , ¬ a = v ⇒ mono x B $ by weaken [#1]
l12: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , ¬ a = v ⇒ setop x B $ by weaken [#2]
l13: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , ¬ a = v ⇒ fv (stg x B) (suc a) = fv (stg x B) a $ by weaken [#4]
l14: $ G , ord v , ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) , a ⊆ v , ¬ a = v ⇒ ∀ k (k ∊ v → a ⊆ k → fv (stg x B) k = fv (stg x B) a) $ by ax
l15: $ … ⇒ fv (stg x B) v = fv (stg x B) a $ by l2_stab_step [l11, l12, l6, l13, l7, l10, l14]
l16: $ … ⇒ fv (stg x B) v = fv (stg x B) a $ by or_elim [l1, l5, l15]
l17: $ … ⇒ a ⊆ v → fv (stg x B) v = fv (stg x B) a $ by imp_intro [l16]
l18: $ … ⇒ ∀ v (ord v → a ⊆ v → fv (stg x B) v = fv (stg x B) a) $ by ord_ind_f [l17]
l19: $ … ⇒ ord b → a ⊆ b → fv (stg x B) b = fv (stg x B) a $ by all_elim [l18]
l20: $ … ⇒ a ⊆ b → fv (stg x B) b = fv (stg x B) a $ by imp_elim [l19, #5]
l21: $ … ⇒ fv (stg x B) b = fv (stg x B) a $ by imp_elim [l20, #6]

lfp_eq_stg
----------
l1: $ G , z ∊ lfp x B ⇒ z ∊ lfp x B $ by ax
l2: $ … ⇒ ∃ w (ord w ∧ z ∊ fv (stg x B) w) $ by lfp_elim [l1]
l3: $ G , ord w ∧ z ∊ fv (stg x B) w ⇒ ord w ∧ z ∊ fv (stg x B) w $ by ax
l4: $ … ⇒ ord w $ by and_elim_l [l3]
l5: $ … ⇒ z ∊ fv (stg x B) w $ by and_elim_r [l3]
l6: $ G , ord w ∧ z ∊ fv (stg x B) w ⇒ ord a $ by weaken [#3]
l7: $ … ⇒ w ⊆ a ∨ a ⊆ w $ by ord_subset_or [l4, l6]
l8: $ G , ord w ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ mono x B $ by weaken [#1]
l9: $ G , ord w ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ setop x B $ by weaken [#2]
l10: $ G , ord w ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ ord w $ by weaken [l4]
l11: $ G , ord w ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ ord a $ by weaken [#3]
l12: $ G , ord w ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ w ⊆ a $ by ax
l13: $ … ⇒ fv (stg x B) w ⊆ fv (stg x B) a $ by stg_mono [l8, l9, l10, l11, l12]
l14: $ G , ord w ∧ z ∊ fv (stg x B) w , w ⊆ a ⇒ z ∊ fv (stg x B) w $ by weaken [l5]
l15: $ … ⇒ z ∊ fv (stg x B) a $ by subset_elim [l13, l14]
l16: $ G , ord w ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ mono x B $ by weaken [#1]
l17: $ G , ord w ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ setop x B $ by weaken [#2]
l18: $ G , ord w ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ ord a $ by weaken [#3]
l19: $ G , ord w ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ fv (stg x B) (suc a) = fv (stg x B) a $ by weaken [#4]
l20: $ G , ord w ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ ord w $ by weaken [l4]
l21: $ G , ord w ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ a ⊆ w $ by ax
l22: $ … ⇒ fv (stg x B) w = fv (stg x B) a $ by stg_stable_above [l16, l17, l18, l19, l20, l21]
l23: $ G , ord w ∧ z ∊ fv (stg x B) w , a ⊆ w ⇒ z ∊ fv (stg x B) w $ by weaken [l5]
l24: $ … ⇒ z ∊ fv (stg x B) a $ by welc_eq [l22, l23]
l25: $ … ⇒ z ∊ fv (stg x B) a $ by or_elim [l7, l15, l24]
l26: $ … ⇒ z ∊ fv (stg x B) a $ by ex_elim [l2, l25]
l27: $ … ⇒ lfp x B ⊆ fv (stg x B) a $ by subset_intro [l26]
l28: $ … ⇒ fv (stg x B) a ⊆ lfp x B $ by stg_subset_lfp [#3]
l29: $ … ⇒ lfp x B = fv (stg x B) a $ by subset_antisym [l27, l28]

lfp_fix_of_stable
-----------------
l1: $ … ⇒ lfp x B = fv (stg x B) a $ by lfp_eq_stg [#1, #2, #3, #4]
l2: $ G ⇒ isset (fv (stg x B) a) $ by stg_set
l3: $ G , u = fv (stg x B) a ⇒ u = fv (stg x B) a $ by ax
l4: $ G , u = fv (stg x B) a ⇒ lfp x B = fv (stg x B) a $ by weaken [l1]
l5: $ … ⇒ fv (stg x B) a = lfp x B $ by eq_sym [l4]
l6: $ … ⇒ u = lfp x B $ by eq_trans [l3, l5]
l7: $ (⟦ x / j ⟧ (lfp x B)) ≐ lfp x B $ by sb_c_lfp_vac
l8: $ (⟦ x / u ⟧ (lfp x B)) ≐ lfp x B $ by sb_c_lfp_vac
l9: $ … ⇒ cap x B (lfp x B) = (⟦ x / u ⟧ B) $ by cap_set_vac [l7, l8, l6]
l10: $ (⟦ x / j ⟧ (fv (stg x B) a)) ≐ fv (stg x B) a $ by sb_c_fvstg_vac
l11: $ (⟦ x / u ⟧ (fv (stg x B) a)) ≐ fv (stg x B) a $ by sb_c_fvstg_vac
l12: $ … ⇒ cap x B (fv (stg x B) a) = (⟦ x / u ⟧ B) $ by cap_set_vac [l10, l11, l3]
l13: $ … ⇒ fv (stg x B) (suc a) = cap x B (fv (stg x B) a) $ by stg_suc [#1, #2, #3]
l14: $ G , u = fv (stg x B) a ⇒ fv (stg x B) (suc a) = cap x B (fv (stg x B) a) $ by weaken [l13]
l15: $ … ⇒ fv (stg x B) (suc a) = (⟦ x / u ⟧ B) $ by eq_trans [l14, l12]
l16: $ … ⇒ (⟦ x / u ⟧ B) = fv (stg x B) (suc a) $ by eq_sym [l15]
l17: $ … ⇒ cap x B (lfp x B) = fv (stg x B) (suc a) $ by eq_trans [l9, l16]
l18: $ G , u = fv (stg x B) a ⇒ fv (stg x B) (suc a) = fv (stg x B) a $ by weaken [#4]
l19: $ … ⇒ cap x B (lfp x B) = fv (stg x B) a $ by eq_trans [l17, l18]
l20: $ … ⇒ cap x B (lfp x B) = lfp x B $ by eq_trans [l19, l5]
l21: $ … ⇒ cap x B (lfp x B) = lfp x B $ by isset_elim [l2, l20]

stg_strict
----------
l0: $ … ⇒ ord a $ by ord_elem [#3, #4]
l1: $ G , fv (stg x B) a = fv (stg x B) b ⇒ ord a $ by weaken [l0]
l2a: $ G , fv (stg x B) a = fv (stg x B) b ⇒ isset a $ by isset_var
l2: $ … ⇒ isset (suc a) $ by suc_set [l2a]
l3: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ u = suc a $ by ax
l4: $ … ⇒ suc a = u $ by eq_sym [l3]
l5: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ ord a $ by weaken [l1]
l6: $ … ⇒ ord (suc a) $ by ord_suc [l5]
l7: $ … ⇒ ord u $ by ord_eq [l4, l6]
l8: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ ord b $ by weaken [#3]
l9: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ a ∊ b $ by weaken [#4]
l10: $ … ⇒ suc a ⊆ b $ by ord_elem_suc_subset [l8, l9]
l11: $ … ⇒ u ⊆ b $ by subset_eq_l [l4, l10]
l12: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ mono x B $ by weaken [#1]
l13: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ setop x B $ by weaken [#2]
l14: $ … ⇒ fv (stg x B) u ⊆ fv (stg x B) b $ by stg_mono [l12, l13, l7, l8, l11]
l15: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ stg x B = stg x B $ by eq_refl
l16: $ … ⇒ fv (stg x B) u = fv (stg x B) (suc a) $ by fv_eq [l15, l3]
l17: $ … ⇒ fv (stg x B) (suc a) ⊆ fv (stg x B) b $ by subset_eq_l [l16, l14]
l18: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ fv (stg x B) a = fv (stg x B) b $ by ax
l19: $ … ⇒ fv (stg x B) b = fv (stg x B) a $ by eq_sym [l18]
l20: $ … ⇒ fv (stg x B) (suc a) ⊆ fv (stg x B) a $ by subset_eq_r [l19, l17]
l21: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ a ⊆ suc a $ by suc_subset
l22: $ … ⇒ a ⊆ u $ by subset_eq_r [l4, l21]
l23: $ … ⇒ fv (stg x B) a ⊆ fv (stg x B) u $ by stg_mono [l12, l13, l5, l7, l22]
l24: $ … ⇒ fv (stg x B) a ⊆ fv (stg x B) (suc a) $ by subset_eq_r [l16, l23]
l25: $ … ⇒ fv (stg x B) (suc a) = fv (stg x B) a $ by subset_antisym [l20, l24]
l26: $ G , fv (stg x B) a = fv (stg x B) b , u = suc a ⇒ ¬ fv (stg x B) (suc a) = fv (stg x B) a $ by weaken [#5]
l27: $ … ⇒ ⊥ $ by not_elim [l26, l25]
l28: $ … ⇒ ⊥ $ by isset_elim [l2, l27]
l29: $ … ⇒ ¬ fv (stg x B) a = fv (stg x B) b $ by not_intro [l28]

def l2_sgr {x: set} (B: class x) (.u .v .z: set): class = $ {z | ∃ u ∃ v (z = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v)} $

lemma l2_sgr_intro {x: set} (G: hyps x) (B: class x) (i j: set): $ G ⇒ ord j $ > $ G ⇒ i = fv (stg x B) j $ > $ G ⇒ ⟨ i , j ⟩ ∈ l2_sgr x B $
----
r1: $ G ⇒ isset i $ by isset_var
r2: $ G ⇒ isset j $ by isset_var
r3: $ … ⇒ isset ⟨ i , j ⟩ $ by opair_set [r1, r2]
r4: $ G , w = ⟨ i , j ⟩ ⇒ w = ⟨ i , j ⟩ $ by ax
r5: $ G , w = ⟨ i , j ⟩ ⇒ ord j $ by weaken [#1]
r6: $ G , w = ⟨ i , j ⟩ ⇒ i = fv (stg x B) j $ by weaken [#2]
r7: $ … ⇒ ord j ∧ i = fv (stg x B) j $ by and_intro [r5, r6]
r8: $ … ⇒ w = ⟨ i , j ⟩ ∧ ord j ∧ i = fv (stg x B) j $ by and_intro [r4, r7]
r9: $ … ⇒ ∃ v (w = ⟨ i , v ⟩ ∧ ord v ∧ i = fv (stg x B) v) $ by ex_intro [r8]
r10: $ … ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v) $ by ex_intro [r9]
r11: $ … ⇒ w ∊ {z | ∃ u ∃ v (z = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v)} $ by cab_intro [r10]
r12: $ G , w = ⟨ i , j ⟩ ⇒ w ∊ l2_sgr x B $ by weaken [r11]
r13: $ … ⇒ ⟨ i , j ⟩ ∈ l2_sgr x B $ by wcel_intro [r4, r12]
r14: $ … ⇒ ⟨ i , j ⟩ ∈ l2_sgr x B $ by isset_elim [r3, r13]

lemma l2_sgr_elim {x: set} (G: hyps x) (B: class x) (i j: set): $ G ⇒ ⟨ i , j ⟩ ∈ l2_sgr x B $ > $ G ⇒ ord j ∧ i = fv (stg x B) j $
----
e1: $ G , w = ⟨ i , j ⟩ , w ∊ l2_sgr x B ⇒ w ∊ {z | ∃ u ∃ v (z = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v)} $ by ax
e2: $ … ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v) $ by cab_elim [e1]
e3: $ G , w = ⟨ i , j ⟩ , w ∊ l2_sgr x B , ∃ v (w = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v) ⇒ ∃ v (w = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v) $ by ax
e4: $ G , w = ⟨ i , j ⟩ , w = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v ⇒ w = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v $ by ax
e5: $ … ⇒ w = ⟨ u , v ⟩ $ by and_elim_l [e4]
e6: $ … ⇒ ord v ∧ u = fv (stg x B) v $ by and_elim_r [e4]
e7: $ … ⇒ ord v $ by and_elim_l [e6]
e8: $ … ⇒ u = fv (stg x B) v $ by and_elim_r [e6]
e9: $ G , w = ⟨ i , j ⟩ , w = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v ⇒ w = ⟨ i , j ⟩ $ by ax
e10: $ … ⇒ ⟨ u , v ⟩ = w $ by eq_sym [e5]
e11: $ … ⇒ ⟨ u , v ⟩ = ⟨ i , j ⟩ $ by eq_trans [e10, e9]
e12: $ … ⇒ u = i $ by opair_inj_l [e11]
e13: $ … ⇒ v = j $ by opair_inj_r [e11]
e14: $ … ⇒ ord j $ by ord_eq [e13, e7]
e15: $ … ⇒ i = u $ by eq_sym [e12]
e16: $ G , w = ⟨ i , j ⟩ , w = ⟨ u , v ⟩ ∧ ord v ∧ u = fv (stg x B) v ⇒ stg x B = stg x B $ by eq_refl
e17: $ … ⇒ fv (stg x B) v = fv (stg x B) j $ by fv_eq [e16, e13]
e18: $ … ⇒ i = fv (stg x B) v $ by eq_trans [e15, e8]
e19: $ … ⇒ i = fv (stg x B) j $ by eq_trans [e18, e17]
e20: $ … ⇒ ord j ∧ i = fv (stg x B) j $ by and_intro [e14, e19]
e21: $ … ⇒ ord j ∧ i = fv (stg x B) j $ by ex_elim [e3, e20]
e22: $ … ⇒ ord j ∧ i = fv (stg x B) j $ by ex_elim [e2, e21]
e23: $ … ⇒ ord j ∧ i = fv (stg x B) j $ by wcel_elim [#1, e22]

lemma l2_nostab {x a: set} (G: hyps x a) (B: class x) (k: set): $ G ⇒ ¬ ∃ a (ord a ∧ fv (stg x B) (suc a) = fv (stg x B) a) $ > $ G ⇒ ord k $ > $ G ⇒ ¬ fv (stg x B) (suc k) = fv (stg x B) k $
----
t1: $ G , fv (stg x B) (suc k) = fv (stg x B) k ⇒ ord k $ by weaken [#2]
t2: $ G , fv (stg x B) (suc k) = fv (stg x B) k ⇒ fv (stg x B) (suc k) = fv (stg x B) k $ by ax
t3: $ … ⇒ ord k ∧ fv (stg x B) (suc k) = fv (stg x B) k $ by and_intro [t1, t2]
t4: $ … ⇒ ∃ a (ord a ∧ fv (stg x B) (suc a) = fv (stg x B) a) $ by ex_intro [t3]
t5: $ G , fv (stg x B) (suc k) = fv (stg x B) k ⇒ ¬ ∃ a (ord a ∧ fv (stg x B) (suc a) = fv (stg x B) a) $ by weaken [#1]
