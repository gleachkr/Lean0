-- Proofs for lfp.mm0.

mono_intro
----------
l1: $ … ⇒ u ⊆ v → (⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B) $ by imp_intro [#1]
l2: $ … ⇒ ∀ v (u ⊆ v → (⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B)) $ by all_intro [l1]
l3: $ … ⇒ ∀ u ∀ v (u ⊆ v → (⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B)) $ by all_intro [l2]

mono_elim
---------
l1: $ G ⇒ ∀ u ∀ v (u ⊆ v → (⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B)) $ by weaken [#1]
l2: $ … ⇒ ∀ v (a ⊆ v → (⟦ x / a ⟧ B) ⊆ (⟦ x / v ⟧ B)) $ by all_elim [l1]
l3: $ … ⇒ a ⊆ b → (⟦ x / a ⟧ B) ⊆ (⟦ x / b ⟧ B) $ by all_elim [l2]
l4: $ … ⇒ (⟦ x / a ⟧ B) ⊆ (⟦ x / b ⟧ B) $ by imp_elim [l3, #2]

mono_cap
--------
k1: $ G , i = C , j = D ⇒ i = C $ by ax
k2: $ G , i = C , j = D ⇒ j = D $ by ax
k3: $ … ⇒ cap x B C = (⟦ x / i ⟧ B) $ by cap_eq [k1]
k4: $ … ⇒ cap x B D = (⟦ x / j ⟧ B) $ by cap_eq [k2]
k5: $ G , i = C , j = D ⇒ C ⊆ D $ by weaken [#4]
k6: $ … ⇒ C = i $ by eq_sym [k1]
k7: $ … ⇒ i ⊆ D $ by subset_eq_l [k6, k5]
k8: $ … ⇒ D = j $ by eq_sym [k2]
k9: $ … ⇒ i ⊆ j $ by subset_eq_r [k8, k7]
k10: $ G , i = C , j = D ⇒ mono x B $ by weaken [#1]
k11: $ … ⇒ (⟦ x / i ⟧ B) ⊆ (⟦ x / j ⟧ B) $ by mono_elim [k10, k9]
k12: $ … ⇒ (⟦ x / i ⟧ B) = cap x B C $ by eq_sym [k3]
k13: $ … ⇒ cap x B C ⊆ (⟦ x / j ⟧ B) $ by subset_eq_l [k12, k11]
k14: $ … ⇒ (⟦ x / j ⟧ B) = cap x B D $ by eq_sym [k4]
k15: $ … ⇒ cap x B C ⊆ cap x B D $ by subset_eq_r [k14, k13]
k16: $ … ⇒ cap x B C ⊆ cap x B D $ by isset_elim [#3, k15]
k17: $ … ⇒ cap x B C ⊆ cap x B D $ by isset_elim [#2, k16]

setop_intro
-----------
l1: $ … ⇒ ∀ x (isset B) $ by all_intro [#1]

setop_elim
----------
l1: $ G ⇒ ∀ x (isset B) $ by weaken [#1]
l2: $ … ⇒ isset (⟦ x / a ⟧ B) $ by all_elim [l1]

setop_cap
---------
k1: $ G , i = C ⇒ i = C $ by ax
k2: $ … ⇒ cap x B C = (⟦ x / i ⟧ B) $ by cap_eq [k1]
k3: $ … ⇒ (⟦ x / i ⟧ B) = cap x B C $ by eq_sym [k2]
k4: $ G , i = C ⇒ setop x B $ by weaken [#1]
k5: $ … ⇒ isset (⟦ x / i ⟧ B) $ by setop_elim [k4]
k6: $ … ⇒ isset (cap x B C) $ by isset_eq [k3, k5]
k7: $ … ⇒ isset (cap x B C) $ by isset_elim [#2, k6]

bounded_intro
-------------
l1: $ … ⇒ u ⊆ C → (⟦ x / u ⟧ B) ⊆ C $ by imp_intro [#1]
l2: $ … ⇒ ∀ u (u ⊆ C → (⟦ x / u ⟧ B) ⊆ C) $ by all_intro [l1]

bounded_elim
------------
l1: $ G ⇒ ∀ u (u ⊆ C → (⟦ x / u ⟧ B) ⊆ C) $ by weaken [#1]
l2: $ … ⇒ a ⊆ C → (⟦ x / a ⟧ B) ⊆ C $ by all_elim [l1]
l3: $ … ⇒ (⟦ x / a ⟧ B) ⊆ C $ by imp_elim [l2, #2]

bounded_cap
-----------
k1: $ G , i = D ⇒ i = D $ by ax
k2: $ … ⇒ D = i $ by eq_sym [k1]
k3: $ G , i = D ⇒ D ⊆ C $ by weaken [#3]
k4: $ … ⇒ i ⊆ C $ by subset_eq_l [k2, k3]
k5: $ G , i = D ⇒ bounded x B C $ by weaken [#1]
k6: $ … ⇒ (⟦ x / i ⟧ B) ⊆ C $ by bounded_elim [k5, k4]
k7: $ … ⇒ cap x B D = (⟦ x / i ⟧ B) $ by cap_eq [k1]
k8: $ … ⇒ (⟦ x / i ⟧ B) = cap x B D $ by eq_sym [k7]
k9: $ … ⇒ cap x B D ⊆ C $ by subset_eq_l [k8, k6]
k10: $ … ⇒ cap x B D ⊆ C $ by isset_elim [#2, k9]

mono_congr
----------
l0: $ seqt u u $ by seqt_refl
l1: $ seqt v v $ by seqt_refl
l2: $ (⟦ x / u ⟧ B) ≐ (⟦ x / u ⟧ D) $ by sb_c_congr [l0, #1]
l3: $ (⟦ x / v ⟧ B) ≐ (⟦ x / v ⟧ D) $ by sb_c_congr [l1, #1]
l4: $ ((⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B)) ⟺ ((⟦ x / u ⟧ D) ⊆ (⟦ x / v ⟧ D)) $ by subset_congr [l2, l3]
l5: $ (u ⊆ v) ⟺ (u ⊆ v) $ by iff_refl
l6: $ (u ⊆ v → (⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B)) ⟺ (u ⊆ v → (⟦ x / u ⟧ D) ⊆ (⟦ x / v ⟧ D)) $ by im_congr [l5, l4]
l7: $ ∀ v (u ⊆ v → (⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B)) ⟺ ∀ v (u ⊆ v → (⟦ x / u ⟧ D) ⊆ (⟦ x / v ⟧ D)) $ by all_congr [l6]
l8: $ ∀ u ∀ v (u ⊆ v → (⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B)) ⟺ ∀ u ∀ v (u ⊆ v → (⟦ x / u ⟧ D) ⊆ (⟦ x / v ⟧ D)) $ by all_congr [l7]

setop_congr
-----------
l1: $ isset B ⟺ isset D $ by isset_congr [#1]
l2: $ ∀ x (isset B) ⟺ ∀ x (isset D) $ by all_congr [l1]

bounded_congr
-------------
l0: $ seqt u u $ by seqt_refl
l1: $ (⟦ x / u ⟧ B) ≐ (⟦ x / u ⟧ D) $ by sb_c_congr [l0, #1]
l2: $ ((⟦ x / u ⟧ B) ⊆ C) ⟺ ((⟦ x / u ⟧ D) ⊆ E) $ by subset_congr [l1, #2]
l3: $ cv u ≐ cv u $ by ceqt_refl
l4: $ (u ⊆ C) ⟺ (u ⊆ E) $ by subset_congr [l3, #2]
l5: $ (u ⊆ C → (⟦ x / u ⟧ B) ⊆ C) ⟺ (u ⊆ E → (⟦ x / u ⟧ D) ⊆ E) $ by im_congr [l4, l2]
l6: $ ∀ u (u ⊆ C → (⟦ x / u ⟧ B) ⊆ C) ⟺ ∀ u (u ⊆ E → (⟦ x / u ⟧ D) ⊆ E) $ by all_congr [l5]

--| Substitutions of distinct variables commute (through `cap_var`: the
--| substitution of a set variable is the application `cap`).
sb_c_swap
---------
l1: $ cap x B u ≐ (⟦ x / u ⟧ B) $ by cap_var
l2: $ (⟦ x / u ⟧ B) ≐ cap x B u $ by ceqt_sym [l1]
l3: $ seqt t t $ by seqt_refl
l4: $ (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ≐ (⟦ y / t ⟧ (cap x B u)) $ by sb_c_congr [l3, l2]
l5: $ (⟦ y / t ⟧ (cap x B u)) ≐ cap x (⟦ y / t ⟧ B) u $ by sb_c_cap
l6: $ cap x (⟦ y / t ⟧ B) u ≐ (⟦ x / u ⟧ (⟦ y / t ⟧ B)) $ by cap_var
l7: $ (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ≐ cap x (⟦ y / t ⟧ B) u $ by ceqt_trans [l4, l5]
l8: $ (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ≐ (⟦ x / u ⟧ (⟦ y / t ⟧ B)) $ by ceqt_trans [l7, l6]

sb_f_mono
---------
l1: $ (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ≐ (⟦ x / u ⟧ (⟦ y / t ⟧ B)) $ by sb_c_swap
l2: $ (⟦ y / t ⟧ (⟦ x / v ⟧ B)) ≐ (⟦ x / v ⟧ (⟦ y / t ⟧ B)) $ by sb_c_swap
l3: $ ((⟦ y / t ⟧ (⟦ x / u ⟧ B)) ⊆ (⟦ y / t ⟧ (⟦ x / v ⟧ B))) ⟺ ((⟦ x / u ⟧ (⟦ y / t ⟧ B)) ⊆ (⟦ x / v ⟧ (⟦ y / t ⟧ B))) $ by subset_congr [l1, l2]
l4: $ (u ⊆ v) ⟺ (u ⊆ v) $ by iff_refl
l5: $ (u ⊆ v → (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ⊆ (⟦ y / t ⟧ (⟦ x / v ⟧ B))) ⟺ (u ⊆ v → (⟦ x / u ⟧ (⟦ y / t ⟧ B)) ⊆ (⟦ x / v ⟧ (⟦ y / t ⟧ B))) $ by im_congr [l4, l3]
l6: $ ∀ v (u ⊆ v → (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ⊆ (⟦ y / t ⟧ (⟦ x / v ⟧ B))) ⟺ ∀ v (u ⊆ v → (⟦ x / u ⟧ (⟦ y / t ⟧ B)) ⊆ (⟦ x / v ⟧ (⟦ y / t ⟧ B))) $ by all_congr [l5]
l7: $ [y/t] (∀ u ∀ v (u ⊆ v → (⟦ x / u ⟧ B) ⊆ (⟦ x / v ⟧ B))) ⟺ ∀ u ∀ v (u ⊆ v → (⟦ x / u ⟧ (⟦ y / t ⟧ B)) ⊆ (⟦ x / v ⟧ (⟦ y / t ⟧ B))) $ by all_congr [l6]

sb_f_setop
----------
l1: $ [y/t] (∀ x (isset B)) ⟺ ∀ x (isset (⟦ y / t ⟧ B)) $ by iff_refl

sb_f_bounded
------------
l1: $ (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ≐ (⟦ x / u ⟧ (⟦ y / t ⟧ B)) $ by sb_c_swap
l2: $ (⟦ y / t ⟧ C) ≐ (⟦ y / t ⟧ C) $ by ceqt_refl
l3: $ ((⟦ y / t ⟧ (⟦ x / u ⟧ B)) ⊆ (⟦ y / t ⟧ C)) ⟺ ((⟦ x / u ⟧ (⟦ y / t ⟧ B)) ⊆ (⟦ y / t ⟧ C)) $ by subset_congr [l1, l2]
l4: $ (u ⊆ (⟦ y / t ⟧ C)) ⟺ (u ⊆ (⟦ y / t ⟧ C)) $ by iff_refl
l5: $ (u ⊆ (⟦ y / t ⟧ C) → (⟦ y / t ⟧ (⟦ x / u ⟧ B)) ⊆ (⟦ y / t ⟧ C)) ⟺ (u ⊆ (⟦ y / t ⟧ C) → (⟦ x / u ⟧ (⟦ y / t ⟧ B)) ⊆ (⟦ y / t ⟧ C)) $ by im_congr [l4, l3]
l6: $ [y/t] (∀ u (u ⊆ C → (⟦ x / u ⟧ B) ⊆ C)) ⟺ ∀ u (u ⊆ (⟦ y / t ⟧ C) → (⟦ x / u ⟧ (⟦ y / t ⟧ B)) ⊆ (⟦ y / t ⟧ C)) $ by all_congr [l5]

stg_functional
--------------
l1: $ G ⇒ functional (trec (cgr g (cap x B (⋃ (crn g))))) $ by trec_functional

stg_rel
-------
l1: $ G ⇒ rel (trec (cgr g (cap x B (⋃ (crn g))))) $ by trec_rel

stg_cdm
-------
l1: $ G ⇒ functional (cgr g (cap x B (⋃ (crn g)))) $ by cgr_functional
l2: $ … ⇒ a ∊ cdm (trec (cgr g (cap x B (⋃ (crn g))))) $ by trec_cdm [l1, #1]

stg_set
-------
l1: $ G ⇒ functional (stg x B) $ by stg_functional
l2: $ … ⇒ isset (fv (stg x B) a) $ by fv_set [l1]

stgb_set
--------
l1: $ G ⇒ functional (cgr g (cap x B (⋃ (crn g)))) $ by cgr_functional
l2: $ … ⇒ cres (trec (cgr g (cap x B (⋃ (crn g))))) a ∈ trapx (cgr g (cap x B (⋃ (crn g)))) $ by trec_cres_apx [l1, #1]
l3: $ … ⇒ isset (cres (trec (cgr g (cap x B (⋃ (crn g))))) a) $ by wcel_isset [l2]
l4: $ … ⇒ isset (crn (cres (trec (cgr g (cap x B (⋃ (crn g))))) a)) $ by crn_set [l3]
l5: $ … ⇒ isset (⋃ (crn (cres (trec (cgr g (cap x B (⋃ (crn g))))) a))) $ by cuni_set [l4]

-- The class arguments of `cap x B C` must not mention `x`, but `stgb x B a`
-- and `fv (stg x B) a` do (MM0 counts the bound occurrence). The lemmas
-- below handle a class `E` that mentions `x` only bound, as witnessed by the
-- vacuity premise `⟦ x / u ⟧ E ≐ E`: renaming the binder of `cap` to `u`
-- brings `E` back into the scope of the `cap` lemmas.
sb_c_cap_same
-------------
l1: $ (⟦ x / t ⟧ {y | ∃ x (x = C ∧ y ∊ B)}) ≐ {y | ∃ x (x = C ∧ y ∊ B)} $ by ceqt_refl

sb_c_stg_same
-------------
l1: $ (⟦ x / t ⟧ (cap x B (⋃ (crn g)))) ≐ cap x B (⋃ (crn g)) $ by sb_c_cap_same
l2: $ cgr g (⟦ x / t ⟧ (cap x B (⋃ (crn g)))) ≐ cgr g (cap x B (⋃ (crn g))) $ by cgr_congr [l1]
l3: $ (⟦ x / t ⟧ (trec (cgr g (cap x B (⋃ (crn g)))))) ≐ trec (cgr g (cap x B (⋃ (crn g)))) $ by trec_congr [l2]

sb_c_stgb_same
--------------
l1: $ (⟦ x / t ⟧ (stg x B)) ≐ stg x B $ by sb_c_stg_same
l2: $ C ≐ C $ by ceqt_refl
l3: $ cres (⟦ x / t ⟧ (stg x B)) C ≐ cres (stg x B) C $ by cres_congr [l1, l2]
l4: $ crn (cres (⟦ x / t ⟧ (stg x B)) C) ≐ crn (cres (stg x B) C) $ by crn_congr [l3]
l5: $ (⟦ x / t ⟧ (⋃ (crn (cres (stg x B) C)))) ≐ ⋃ (crn (cres (stg x B) C)) $ by cuni_congr [l4]

capv_alpha
----------
a1: $ ∃ x (x = E ∧ y ∊ B) ⟺ ∃ u (u = (⟦ x / u ⟧ E) ∧ y ∊ (⟦ x / u ⟧ B)) $ by ex_alpha
a2: $ cv u ≐ cv u $ by ceqt_refl
a3: $ (u = (⟦ x / u ⟧ E)) ⟺ (u = E) $ by ceq_congr [a2, #1]
a4: $ (y ∊ (⟦ x / u ⟧ B)) ⟺ (y ∊ (⟦ x / u ⟧ B)) $ by iff_refl
a5: $ (u = (⟦ x / u ⟧ E) ∧ y ∊ (⟦ x / u ⟧ B)) ⟺ (u = E ∧ y ∊ (⟦ x / u ⟧ B)) $ by and_congr [a3, a4]
a6: $ ∃ u (u = (⟦ x / u ⟧ E) ∧ y ∊ (⟦ x / u ⟧ B)) ⟺ ∃ u (u = E ∧ y ∊ (⟦ x / u ⟧ B)) $ by ex_congr [a5]
a7: $ ∃ x (x = E ∧ y ∊ B) ⟺ ∃ u (u = E ∧ y ∊ (⟦ x / u ⟧ B)) $ by iff_trans [a1, a6]
a8: $ {y | ∃ x (x = E ∧ y ∊ B)} ≐ {y | ∃ u (u = E ∧ y ∊ (⟦ x / u ⟧ B))} $ by cab_congr [a7]

mono_alpha
----------
b1: $ G , i ⊆ j ⇒ mono x B $ by weaken [#1]
b2: $ G , i ⊆ j ⇒ i ⊆ j $ by ax
b3: $ … ⇒ (⟦ x / i ⟧ B) ⊆ (⟦ x / j ⟧ B) $ by mono_elim [b1, b2]
b4: $ … ⇒ mono u (⟦ x / u ⟧ B) $ by mono_intro [b3]

setop_alpha
-----------
c1: $ … ⇒ isset (⟦ x / u ⟧ B) $ by setop_elim [#1]
c2: $ … ⇒ setop u (⟦ x / u ⟧ B) $ by setop_intro [c1]

bounded_alpha
-------------
d1: $ G , i ⊆ C ⇒ bounded x B C $ by weaken [#1]
d2: $ G , i ⊆ C ⇒ i ⊆ C $ by ax
d3: $ … ⇒ (⟦ x / i ⟧ B) ⊆ C $ by bounded_elim [d1, d2]
d4: $ … ⇒ bounded u (⟦ x / u ⟧ B) C $ by bounded_intro [d3]

capv_eq
-------
e1: $ cap x B E ≐ cap u (⟦ x / u ⟧ B) E $ by capv_alpha [#1]
e2: $ G ⇒ cap x B E = cap u (⟦ x / u ⟧ B) E $ by weaken [e1]
e3: $ … ⇒ cap u (⟦ x / u ⟧ B) E = (⟦ x / a ⟧ B) $ by cap_eq [#2]
e4: $ … ⇒ cap x B E = (⟦ x / a ⟧ B) $ by eq_trans [e2, e3]

capv_eq_arg
-----------
f1: $ cap x B C ≐ cap u (⟦ x / u ⟧ B) C $ by capv_alpha [#1]
f2: $ cap x B E ≐ cap u (⟦ x / u ⟧ B) E $ by capv_alpha [#2]
f3: $ G ⇒ cap x B C = cap u (⟦ x / u ⟧ B) C $ by weaken [f1]
f4: $ G ⇒ cap x B E = cap u (⟦ x / u ⟧ B) E $ by weaken [f2]
f5: $ … ⇒ cap u (⟦ x / u ⟧ B) C = cap u (⟦ x / u ⟧ B) E $ by cap_eq_arg [#3]
f6: $ … ⇒ cap u (⟦ x / u ⟧ B) E = cap x B E $ by eq_sym [f4]
f7: $ … ⇒ cap x B C = cap u (⟦ x / u ⟧ B) E $ by eq_trans [f3, f5]
f8: $ … ⇒ cap x B C = cap x B E $ by eq_trans [f7, f6]

capv_mono
---------
g1: $ cap x B C ≐ cap u (⟦ x / u ⟧ B) C $ by capv_alpha [#1]
g2: $ cap x B E ≐ cap u (⟦ x / u ⟧ B) E $ by capv_alpha [#2]
g3: $ G ⇒ cap x B C = cap u (⟦ x / u ⟧ B) C $ by weaken [g1]
g4: $ G ⇒ cap x B E = cap u (⟦ x / u ⟧ B) E $ by weaken [g2]
g5: $ … ⇒ mono u (⟦ x / u ⟧ B) $ by mono_alpha [#3]
g6: $ … ⇒ cap u (⟦ x / u ⟧ B) C ⊆ cap u (⟦ x / u ⟧ B) E $ by mono_cap [g5, #4, #5, #6]
g7: $ … ⇒ cap u (⟦ x / u ⟧ B) C = cap x B C $ by eq_sym [g3]
g8: $ … ⇒ cap u (⟦ x / u ⟧ B) E = cap x B E $ by eq_sym [g4]
g9: $ … ⇒ cap x B C ⊆ cap u (⟦ x / u ⟧ B) E $ by subset_eq_l [g7, g6]
g10: $ … ⇒ cap x B C ⊆ cap x B E $ by subset_eq_r [g8, g9]

capv_bounded
------------
h1: $ cap x B D ≐ cap u (⟦ x / u ⟧ B) D $ by capv_alpha [#1]
h2: $ G ⇒ cap x B D = cap u (⟦ x / u ⟧ B) D $ by weaken [h1]
h3: $ … ⇒ bounded u (⟦ x / u ⟧ B) C $ by bounded_alpha [#2]
h4: $ … ⇒ cap u (⟦ x / u ⟧ B) D ⊆ C $ by bounded_cap [h3, #3, #4]
h5: $ … ⇒ cap u (⟦ x / u ⟧ B) D = cap x B D $ by eq_sym [h2]
h6: $ … ⇒ cap x B D ⊆ C $ by subset_eq_l [h5, h4]

stg_eq
------
q1: $ G ⇒ functional (cgr g (cap x B (⋃ (crn g)))) $ by cgr_functional
q2: $ … ⇒ fv (trec (cgr g (cap x B (⋃ (crn g))))) a = fv (cgr g (cap x B (⋃ (crn g)))) (cres (trec (cgr g (cap x B (⋃ (crn g))))) a) $ by trec_eq [q1, #2]
q3: $ … ⇒ cres (trec (cgr g (cap x B (⋃ (crn g))))) a ∈ trapx (cgr g (cap x B (⋃ (crn g)))) $ by trec_cres_apx [q1, #2]
q4: $ … ⇒ isset (cres (stg x B) a) $ by wcel_isset [q3]
q5: $ G , i = cres (stg x B) a ⇒ i = cres (stg x B) a $ by ax
q6: $ … ⇒ cres (stg x B) a = i $ by eq_sym [q5]
q7: $ G , i = cres (stg x B) a ⇒ cgr g (cap x B (⋃ (crn g))) = cgr g (cap x B (⋃ (crn g))) $ by eq_refl
q8: $ … ⇒ fv (cgr g (cap x B (⋃ (crn g)))) (cres (stg x B) a) = fv (cgr g (cap x B (⋃ (crn g)))) i $ by fv_eq [q7, q6]
q9: $ G , i = cres (stg x B) a ⇒ isset i $ by isset_var
q10: $ … ⇒ isset (crn i) $ by crn_set [q9]
q11: $ … ⇒ isset (⋃ (crn i)) $ by cuni_set [q10]
q12: $ G , i = cres (stg x B) a ⇒ setop x B $ by weaken [#1]
q13: $ … ⇒ isset (cap x B (⋃ (crn i))) $ by setop_cap [q12, q11]
q14: $ G , i = cres (stg x B) a ⇒ fv (cgr g (cap x B (⋃ (crn g)))) i = cap x B (⋃ (crn i)) $ by fv_cgr [q13]
q15: $ … ⇒ crn i = crn (cres (stg x B) a) $ by crn_eq [q5]
q16: $ … ⇒ ⋃ (crn i) = ⋃ (crn (cres (stg x B) a)) $ by cuni_eq [q15]
