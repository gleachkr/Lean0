n6: $ G , ord i , ∀ j (j ∊ i → ⋃ (crn (cres (stg x B) j)) ⊆ C) , w ∊ stgb x B i , k ∊ i ∧ w ∊ fv (stg x B) k ⇒ ord i $ by ax
n7: $ … ⇒ ord k $ by ord_elem [n6, n4]
n8: $ G , ord i , ∀ j (j ∊ i → ⋃ (crn (cres (stg x B) j)) ⊆ C) , w ∊ stgb x B i , k ∊ i ∧ w ∊ fv (stg x B) k ⇒ setop x B $ by weaken [#2]
n9: $ … ⇒ fv (stg x B) k = cap x B (stgb x B k) $ by stg_eq [n8, n7]
n10: $ … ⇒ w ∊ cap x B (stgb x B k) $ by welc_eq [n9, n5]
n11: $ G , ord i , ∀ j (j ∊ i → ⋃ (crn (cres (stg x B) j)) ⊆ C) , w ∊ stgb x B i , k ∊ i ∧ w ∊ fv (stg x B) k ⇒ ∀ j (j ∊ i → ⋃ (crn (cres (stg x B) j)) ⊆ C) $ by ax
n12: $ … ⇒ k ∊ i → ⋃ (crn (cres (stg x B) k)) ⊆ C $ by all_elim [n11]
n13: $ … ⇒ stgb x B k ⊆ C $ by imp_elim [n12, n4]
n14: $ … ⇒ isset (stgb x B k) $ by stgb_set [n7]
n15: $ G , ord i , ∀ j (j ∊ i → ⋃ (crn (cres (stg x B) j)) ⊆ C) , w ∊ stgb x B i , k ∊ i ∧ w ∊ fv (stg x B) k ⇒ bounded x B C $ by weaken [#1]
n16a: $ (⟦ x / u ⟧ (stgb x B k)) ≐ stgb x B k $ by sb_c_stgb_same
n16: $ … ⇒ cap x B (stgb x B k) ⊆ C $ by capv_bounded [n16a, n15, n14, n13]
n17: $ … ⇒ w ∊ C $ by subset_elim [n16, n10]
n18: $ … ⇒ w ∊ C $ by ex_elim [n2, n17]
n19: $ … ⇒ ⋃ (crn (cres (stg x B) i)) ⊆ C $ by subset_intro [n18]
n20: $ G ⇒ ∀ i (ord i → ⋃ (crn (cres (stg x B) i)) ⊆ C) $ by ord_ind_f [n19]
n21: $ … ⇒ ord a → ⋃ (crn (cres (stg x B) a)) ⊆ C $ by all_elim [n20]
n22: $ … ⇒ stgb x B a ⊆ C $ by imp_elim [n21, #3]

stg_bounded
-----------
y1: $ … ⇒ fv (stg x B) a = cap x B (stgb x B a) $ by stg_eq [#2, #3]
y2: $ … ⇒ stgb x B a ⊆ C $ by stgb_bounded [#1, #2, #3]
y3: $ … ⇒ isset (stgb x B a) $ by stgb_set [#3]
y4a: $ (⟦ x / u ⟧ (stgb x B a)) ≐ stgb x B a $ by sb_c_stgb_same
y4: $ … ⇒ cap x B (stgb x B a) ⊆ C $ by capv_bounded [y4a, #1, y3, y2]
y5: $ … ⇒ cap x B (stgb x B a) = fv (stg x B) a $ by eq_sym [y1]
y6: $ … ⇒ fv (stg x B) a ⊆ C $ by subset_eq_l [y5, y4]

stg_subset_prefix
-----------------
