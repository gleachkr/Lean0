c3: $ … ⇒ u ^ b ∈ ω $ by npow_omega [c1, c2]
d1: $ G , u = two , u ∊ ω , v = u ^ b , v ∊ ω ⇒ a ∊ ω $ by weaken [#1]
d2: $ G , u = two , u ∊ ω , v = u ^ b , v ∊ ω ⇒ v ∊ ω $ by ax
d3: $ … ⇒ a · v ∈ ω $ by nmul_omega [d1, d2]
d4: $ G , u = two , u ∊ ω , v = u ^ b , v ∊ ω ⇒ v = u ^ b $ by ax
d5: $ G , u = two , u ∊ ω , v = u ^ b , v ∊ ω ⇒ u = two $ by ax
d6: $ G , u = two , u ∊ ω , v = u ^ b , v ∊ ω ⇒ b = b $ by eq_refl
d7: $ … ⇒ u ^ b = two ^ b $ by npow_eq [d5, d6]
d8: $ … ⇒ v = two ^ b $ by eq_trans [d4, d7]
d9: $ G , u = two , u ∊ ω , v = u ^ b , v ∊ ω ⇒ a = a $ by eq_refl
d10: $ … ⇒ a · v = a · two ^ b $ by nmul_eq [d9, d8]
d11: $ … ⇒ a · two ^ b ∈ ω $ by wcel_eq_l [d10, d3]
c4: $ … ⇒ a · two ^ b ∈ ω $ by wcel_elim [c3, d11]
l2: $ … ⇒ a · two ^ b ∈ ω $ by wcel_elim [l1, c4]

nshl_zero
---------
l1: $ G ⇒ two ∈ ω $ by two_omega
c1: $ G , u = two , u ∊ ω ⇒ u ^ ∅ = suc ∅ $ by npow_zero
c2: $ G , u = two , u ∊ ω ⇒ u = two $ by ax
c3: $ G , u = two , u ∊ ω ⇒ ∅ = ∅ $ by eq_refl
c4: $ … ⇒ u ^ ∅ = two ^ ∅ $ by npow_eq [c2, c3]
c5: $ … ⇒ two ^ ∅ = u ^ ∅ $ by eq_sym [c4]
c6: $ … ⇒ two ^ ∅ = suc ∅ $ by eq_trans [c5, c1]
c7: $ G , u = two , u ∊ ω ⇒ a = a $ by eq_refl
c8: $ … ⇒ a · two ^ ∅ = a · suc ∅ $ by nmul_eq [c7, c6]
c9: $ G , u = two , u ∊ ω ⇒ a ∊ ω $ by weaken [#1]
c10: $ … ⇒ a · suc ∅ = a $ by nmul_one [c9]
c11: $ … ⇒ a · two ^ ∅ = a $ by eq_trans [c8, c10]
l2: $ … ⇒ a · two ^ ∅ = a $ by wcel_elim [l1, c11]

lemma q3_nshl_core (G: hyps) (a b u: set):
  $ G ⇒ u ∊ ω $ > $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a · u ^ suc b = u · a · u ^ b $
----
l1: $ … ⇒ u ^ suc b = u ^ b · u $ by npow_suc [#3]
l2: $ … ⇒ u ^ b ∈ ω $ by npow_omega [#1, #3]
p1: $ G , v = u ^ b , v ∊ ω ⇒ v = u ^ b $ by ax
p2: $ … ⇒ u ^ b = v $ by eq_sym [p1]
p3: $ G , v = u ^ b , v ∊ ω ⇒ v ∊ ω $ by ax
p3a: $ G , v = u ^ b , v ∊ ω ⇒ u ∊ ω $ by weaken [#1]
p3b: $ G , v = u ^ b , v ∊ ω ⇒ a ∊ ω $ by weaken [#2]
p4: $ G , v = u ^ b , v ∊ ω ⇒ u = u $ by eq_refl
p5: $ … ⇒ u ^ b · u = v · u $ by nmul_eq [p2, p4]
p5a: $ G , v = u ^ b , v ∊ ω ⇒ u ^ suc b = u ^ b · u $ by weaken [l1]
p6: $ … ⇒ u ^ suc b = v · u $ by eq_trans [p5a, p5]
p7: $ G , v = u ^ b , v ∊ ω ⇒ a = a $ by eq_refl
p8: $ … ⇒ a · u ^ suc b = a · (v · u) $ by nmul_eq [p7, p6]
p9: $ … ⇒ v · u = u · v $ by nmul_comm [p3, p3a]
p10: $ … ⇒ a · (v · u) = a · (u · v) $ by nmul_eq [p7, p9]
p11: $ … ⇒ a · u · v = a · (u · v) $ by nmul_assoc [p3b, p3a, p3]
p12: $ … ⇒ a · (u · v) = a · u · v $ by eq_sym [p11]
p13: $ … ⇒ a · u = u · a $ by nmul_comm [p3b, p3a]
p14: $ G , v = u ^ b , v ∊ ω ⇒ v = v $ by eq_refl
p15: $ … ⇒ a · u · v = u · a · v $ by nmul_eq [p13, p14]
p16a: $ G , v = u ^ b , v ∊ ω ⇒ u · a = u · a $ by eq_refl
p16: $ … ⇒ u · a · v = u · a · u ^ b $ by nmul_eq [p16a, p1]
e1: $ … ⇒ a · u ^ suc b = a · (u · v) $ by eq_trans [p8, p10]
e2: $ … ⇒ a · u ^ suc b = a · u · v $ by eq_trans [e1, p12]
e3: $ … ⇒ a · u ^ suc b = u · a · v $ by eq_trans [e2, p15]
e4: $ … ⇒ a · u ^ suc b = u · a · u ^ b $ by eq_trans [e3, p16]
l3: $ … ⇒ a · u ^ suc b = u · a · u ^ b $ by wcel_elim [l2, e4]

nshl_suc
--------
l1: $ G ⇒ two ∈ ω $ by two_omega
c1: $ G , u = two , u ∊ ω ⇒ u ∊ ω $ by ax
c1a: $ G , u = two , u ∊ ω ⇒ a ∊ ω $ by weaken [#1]
c1b: $ G , u = two , u ∊ ω ⇒ b ∊ ω $ by weaken [#2]
c2: $ G , u = two , u ∊ ω ⇒ u = two $ by ax
c3: $ … ⇒ a · u ^ suc b = u · a · u ^ b $ by q3_nshl_core [c1, c1a, c1b]
c4: $ G , u = two , u ∊ ω ⇒ suc b = suc b $ by eq_refl
c5: $ … ⇒ u ^ suc b = two ^ suc b $ by npow_eq [c2, c4]
c6: $ G , u = two , u ∊ ω ⇒ a = a $ by eq_refl
c7: $ … ⇒ a · u ^ suc b = a · two ^ suc b $ by nmul_eq [c6, c5]
c8: $ … ⇒ u · a = two · a $ by nmul_eq [c2, c6]
c9: $ G , u = two , u ∊ ω ⇒ b = b $ by eq_refl
c9a: $ … ⇒ u ^ b = two ^ b $ by npow_eq [c2, c9]
c10: $ … ⇒ u · a · u ^ b = two · a · two ^ b $ by nmul_eq [c8, c9a]
c11: $ … ⇒ a · two ^ suc b = a · u ^ suc b $ by eq_sym [c7]
c12: $ … ⇒ a · two ^ suc b = u · a · u ^ b $ by eq_trans [c11, c3]
c13: $ … ⇒ a · two ^ suc b = two · a · two ^ b $ by eq_trans [c12, c10]
l2: $ … ⇒ a · two ^ suc b = two · a · two ^ b $ by wcel_elim [l1, c13]
