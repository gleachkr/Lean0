lemma q1_zero_dvd (G: hyps) (a: set) (B: class): $ G ⇒ ∅ = a $ > $ G ⇒ ndvd a B $ > $ G ⇒ a = B $
----
l1: $ … ⇒ ∃ u (u ∊ ω ∧ B = a · u) $ by ndvd_elim [#2]
l2: $ G , u ∊ ω ∧ B = a · u ⇒ u ∊ ω ∧ B = a · u $ by ax
l3: $ … ⇒ u ∊ ω $ by and_elim_l [l2]
l4: $ … ⇒ B = a · u $ by and_elim_r [l2]
l5: $ G , u ∊ ω ∧ B = a · u ⇒ ∅ = a $ by weaken [#1]
l6: $ … ⇒ a = ∅ $ by eq_sym [l5]
l7: $ G , u ∊ ω ∧ B = a · u ⇒ u = u $ by eq_refl
l8: $ … ⇒ a · u = ∅ · u $ by nmul_eq [l6, l7]
l9: $ … ⇒ ∅ · u = ∅ $ by zero_nmul [l3]
l10: $ … ⇒ B = ∅ · u $ by eq_trans [l4, l8]
l11: $ … ⇒ B = ∅ $ by eq_trans [l10, l9]
l12: $ … ⇒ ∅ = B $ by eq_sym [l11]
l13: $ … ⇒ a = B $ by eq_trans [l6, l12]
l14: $ … ⇒ a = B $ by ex_elim [l1, l13]

