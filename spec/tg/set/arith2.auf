--| Below the divisor: `0·b + a = a`.
lemma q2_small_eq (G: hyps) (a b e: set): $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ b $ > $ G ⇒ e = ∅ $ >
  $ G ⇒ e ∊ ω ∧ e · b + a = a $
----
l1: $ … ⇒ ∅ = e $ by eq_sym [#3]
l2: $ G ⇒ ∅ ∈ ω $ by omega_zero
l3: $ … ⇒ e ∈ ω $ by wcel_eq_l [l1, l2]
l4: $ … ⇒ e ∊ ω $ by wcel_welc [l3]
l5: $ … ⇒ a ∊ ω $ by omega_elem_omega [#1, #2]
l6: $ G ⇒ b = b $ by eq_refl
l7: $ … ⇒ e · b = ∅ · b $ by nmul_eq [#3, l6]
l8: $ … ⇒ ∅ · b = ∅ $ by zero_nmul [#1]
l9: $ … ⇒ e · b = ∅ $ by eq_trans [l7, l8]
l10: $ G ⇒ a = a $ by eq_refl
l11: $ … ⇒ e · b + a = ∅ + a $ by nadd_eq [l9, l10]
l12: $ … ⇒ ∅ + a = a $ by zero_nadd [l5]
l13: $ … ⇒ e · b + a = a $ by eq_trans [l11, l12]
l14: $ … ⇒ e ∊ ω ∧ e · b + a = a $ by and_intro [l4, l13]

