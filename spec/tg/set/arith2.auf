--| The step of Euclid's existence proof: from `u·b + v = y` with `v < b`, a
--| quotient and remainder for `z = suc y`.
lemma q2_ex_step {q r: set} (G: hyps q r) (b y z u v: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ ∅ ∈ b $ > $ G ⇒ u ∊ ω $ > $ G ⇒ v ∊ b $ > $ G ⇒ u · b + v = y $ > $ G ⇒ z = suc y $ >
  $ G ⇒ ∃ q ∃ r (q ∊ ω ∧ r ∊ b ∧ q · b + r = z) $
----
l1: $ … ⇒ v ∊ ω $ by omega_elem_omega [#1, #4]
l2: $ … ⇒ suc v ⊆ b $ by omega_elem_suc_subset [l1, #1, #4]
l3: $ G ⇒ isset (u · b) $ by nmul_set
l4a: $ G ⇒ isset v $ by isset_var
l4: $ … ⇒ isset (suc v) $ by suc_set [l4a]
