--| One subtraction step of Lean's `Nat.div`/`Nat.mod` recursion: for `b ≤ a`,
--| `a - b` has the quotient one less and the same remainder.
lemma q2_sub_elim {s p: set} (G: hyps) (a b: set) (c: fml):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ ∅ ∈ b $ > $ G ⇒ b ⊆ a $ >
  $ G , s = nsub a b , p ∊ ω , ndiv a b = suc p , ndiv s b = p , nmod a b = nmod s b ⇒ c $ > $ G ⇒ c $
----
