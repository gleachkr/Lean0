-- Proofs for arith2.mm0.

ndvd_congr
----------
l1: $ (c ∊ ω) ⟺ (c ∊ ω) $ by iff_refl
l2: $ c ≐ c $ by ceqt_refl
l3: $ A · c ≐ B · c $ by nmul_congr [#1, l2]
l4: $ (C = A · c) ⟺ (D = B · c) $ by ceq_congr [#2, l3]
l5: $ (c ∊ ω ∧ C = A · c) ⟺ (c ∊ ω ∧ D = B · c) $ by and_congr [l1, l4]
l6: $ ∃ c (c ∊ ω ∧ C = A · c) ⟺ ∃ c (c ∊ ω ∧ D = B · c) $ by ex_congr [l5]

ndvd_eq
-------
l1: $ (∃ c (c ∊ ω ∧ C = A · c)) ⟺ ∃ u (u ∊ ω ∧ C = A · u) $ by ex_alpha
l2: $ G ⇒ (∃ c (c ∊ ω ∧ C = A · c)) ↔ ∃ u (u ∊ ω ∧ C = A · u) $ by weaken [l1]
l3: $ … ⇒ ∃ u (u ∊ ω ∧ C = A · u) $ by bi_elim_l [l2, #3]
l4: $ G , u ∊ ω ∧ C = A · u ⇒ u ∊ ω ∧ C = A · u $ by ax
l5: $ … ⇒ u ∊ ω $ by and_elim_l [l4]
l6: $ … ⇒ C = A · u $ by and_elim_r [l4]
l7: $ G , u ∊ ω ∧ C = A · u ⇒ C = D $ by weaken [#2]
l8: $ … ⇒ D = C $ by eq_sym [l7]
l9: $ G , u ∊ ω ∧ C = A · u ⇒ A = B $ by weaken [#1]
l10: $ G , u ∊ ω ∧ C = A · u ⇒ u = u $ by eq_refl
l11: $ … ⇒ A · u = B · u $ by nmul_eq [l9, l10]
l12: $ … ⇒ D = A · u $ by eq_trans [l8, l6]
l13: $ … ⇒ D = B · u $ by eq_trans [l12, l11]
l14: $ … ⇒ u ∊ ω ∧ D = B · u $ by and_intro [l5, l13]
l15: $ G , u ∊ ω ∧ C = A · u ⇒ ndvd B D $ by ex_intro [l14]
l16: $ … ⇒ ndvd B D $ by ex_elim [l3, l15]

sb_f_ndvd
---------
l1: $ [ x / t ] (∃ c (c ∊ ω ∧ B = A · c)) ⟺ ∃ c (c ∊ ω ∧ ([[ x / t ]] B) = ([[ x / t ]] A) · c) $ by iff_refl

ndiv_congr
----------
e0: $ ∅ ≐ ∅ $ by ceqt_refl
e1: $ (C = ∅) ⟺ (D = ∅) $ by ceq_congr [#2, e0]
e2: $ y ≐ y $ by ceqt_refl
e3: $ (y = ∅) ⟺ (y = ∅) $ by iff_refl
e4: $ (C = ∅ ∧ y = ∅) ⟺ (D = ∅ ∧ y = ∅) $ by and_congr [e1, e3]
e5: $ (∅ ∈ C) ⟺ (∅ ∈ D) $ by wcel_congr [e0, #2]
e6: $ seqt v v $ by seqt_refl
e7: $ (v ∊ C) ⟺ (v ∊ D) $ by welc_congr [e6, #2]
e8: $ y · C ≐ y · D $ by nmul_congr [e2, #2]
e9: $ v ≐ v $ by ceqt_refl
e10: $ y · C + v ≐ y · D + v $ by nadd_congr [e8, e9]
e11: $ (y · C + v = A) ⟺ (y · D + v = B) $ by ceq_congr [e10, #1]
e12: $ (v ∊ C ∧ y · C + v = A) ⟺ (v ∊ D ∧ y · D + v = B) $ by and_congr [e7, e11]
e13: $ ∃ v (v ∊ C ∧ y · C + v = A) ⟺ ∃ v (v ∊ D ∧ y · D + v = B) $ by ex_congr [e12]
e14: $ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)) ⟺ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)) $ by and_congr [e5, e13]
e15: $ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A))) ⟺ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B))) $ by or_congr [e4, e14]
e16: $ (y ∊ ω) ⟺ (y ∊ ω) $ by iff_refl
e17: $ (y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))) ⟺ (y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)))) $ by and_congr [e16, e15]
e18: $ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} ≐ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)))} $ by cab_congr [e17]
e19: $ ⋃ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} ≐ ⋃ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)))} $ by cuni_congr [e18]

lemma q1_ndiv_sub {y v: set} (G: hyps) (A B C D: class) (z: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} ⇒ z ∊ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)))} $
----
s0: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} ⇒ z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} $ by ax
s1: $ … ⇒ z ∊ ω ∧ ((C = ∅ ∧ z = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ z · C + v = A))) $ by cab_elim [s0]
s2: $ … ⇒ z ∊ ω $ by and_elim_l [s1]
s3: $ … ⇒ (C = ∅ ∧ z = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ z · C + v = A)) $ by and_elim_r [s1]
a1: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} , C = ∅ ∧ z = ∅ ⇒ C = ∅ ∧ z = ∅ $ by ax
a2: $ … ⇒ C = ∅ $ by and_elim_l [a1]
a3: $ … ⇒ z = ∅ $ by and_elim_r [a1]
a4: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} , C = ∅ ∧ z = ∅ ⇒ C = D $ by weaken [#2]
a5: $ … ⇒ D = C $ by eq_sym [a4]
a6: $ … ⇒ D = ∅ $ by eq_trans [a5, a2]
a7: $ … ⇒ D = ∅ ∧ z = ∅ $ by and_intro [a6, a3]
a8: $ … ⇒ (D = ∅ ∧ z = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ z · D + v = B)) $ by or_intro_l [a7]
c1: $ G , w ∊ C ∧ z · C + w = A ⇒ w ∊ C ∧ z · C + w = A $ by ax
c2: $ … ⇒ w ∊ C $ by and_elim_l [c1]
c3: $ … ⇒ z · C + w = A $ by and_elim_r [c1]
c4: $ G , w ∊ C ∧ z · C + w = A ⇒ C = D $ by weaken [#2]
c5: $ … ⇒ w ∊ D $ by welc_eq [c4, c2]
c6: $ G , w ∊ C ∧ z · C + w = A ⇒ z = z $ by eq_refl
c7: $ … ⇒ z · C = z · D $ by nmul_eq [c6, c4]
c8: $ G , w ∊ C ∧ z · C + w = A ⇒ w = w $ by eq_refl
c9: $ … ⇒ z · C + w = z · D + w $ by nadd_eq [c7, c8]
c10: $ … ⇒ z · D + w = z · C + w $ by eq_sym [c9]
c11: $ … ⇒ z · D + w = A $ by eq_trans [c10, c3]
c12: $ G , w ∊ C ∧ z · C + w = A ⇒ A = B $ by weaken [#1]
c13: $ … ⇒ z · D + w = B $ by eq_trans [c11, c12]
c14: $ … ⇒ w ∊ D ∧ z · D + w = B $ by and_intro [c5, c13]
c15: $ … ⇒ w ∊ C ∧ z · C + w = A → w ∊ D ∧ z · D + w = B $ by imp_intro [c14]
c16: $ … ⇒ ∀ w (w ∊ C ∧ z · C + w = A → w ∊ D ∧ z · D + w = B) $ by all_intro [c15]
e1: $ ∃ v (v ∊ C ∧ z · C + v = A) ⟺ ∃ w (w ∊ C ∧ z · C + w = A) $ by ex_alpha
e2: $ ∃ v (v ∊ D ∧ z · D + v = B) ⟺ ∃ w (w ∊ D ∧ z · D + w = B) $ by ex_alpha
b1: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ z · C + v = A) ⇒ ∅ ∈ C ∧ ∃ v (v ∊ C ∧ z · C + v = A) $ by ax
b2: $ … ⇒ ∅ ∈ C $ by and_elim_l [b1]
b3: $ … ⇒ ∃ v (v ∊ C ∧ z · C + v = A) $ by and_elim_r [b1]
b3a: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ z · C + v = A) ⇒ ∃ v (v ∊ C ∧ z · C + v = A) ↔ ∃ w (w ∊ C ∧ z · C + w = A) $ by weaken [e1]
b3b: $ … ⇒ ∃ w (w ∊ C ∧ z · C + w = A) $ by bi_elim_l [b3a, b3]
b4: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ z · C + v = A) ⇒ C = D $ by weaken [#2]
b5: $ … ⇒ ∅ ∈ D $ by wcel_eq_r [b4, b2]
b6: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ z · C + v = A) ⇒ ∀ w (w ∊ C ∧ z · C + w = A → w ∊ D ∧ z · D + w = B) $ by weaken [c16]
b7: $ … ⇒ ∃ w (w ∊ D ∧ z · D + w = B) $ by ex_mp [b6, b3b]
b7a: $ G , z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} , ∅ ∈ C ∧ ∃ v (v ∊ C ∧ z · C + v = A) ⇒ ∃ v (v ∊ D ∧ z · D + v = B) ↔ ∃ w (w ∊ D ∧ z · D + w = B) $ by weaken [e2]
b7b: $ … ⇒ ∃ v (v ∊ D ∧ z · D + v = B) $ by bi_elim_r [b7a, b7]
b8: $ … ⇒ ∅ ∈ D ∧ ∃ v (v ∊ D ∧ z · D + v = B) $ by and_intro [b5, b7b]
b9: $ … ⇒ (D = ∅ ∧ z = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ z · D + v = B)) $ by or_intro_r [b8]
s4: $ … ⇒ (D = ∅ ∧ z = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ z · D + v = B)) $ by or_elim [s3, a8, b9]
s5: $ … ⇒ z ∊ ω ∧ ((D = ∅ ∧ z = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ z · D + v = B))) $ by and_intro [s2, s4]
s6: $ … ⇒ z ∊ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)))} $ by cab_intro [s5]

ndiv_eq
-------
l4: $ … ⇒ z ∊ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)))} $ by q1_ndiv_sub [#1, #2]
l8: $ … ⇒ B = A $ by eq_sym [#1]
l9: $ … ⇒ D = C $ by eq_sym [#2]
l10: $ … ⇒ z ∊ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} $ by q1_ndiv_sub [l8, l9]
l11: $ … ⇒ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} = {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)))} $ by eq_intro [l4, l10]
l12: $ … ⇒ ⋃ {y | y ∊ ω ∧ ((C = ∅ ∧ y = ∅) ∨ (∅ ∈ C ∧ ∃ v (v ∊ C ∧ y · C + v = A)))} = ⋃ {y | y ∊ ω ∧ ((D = ∅ ∧ y = ∅) ∨ (∅ ∈ D ∧ ∃ v (v ∊ D ∧ y · D + v = B)))} $ by cuni_eq [l11]

sb_c_ndiv
---------
l1: $ ([[ x / t ]] (⋃ {y | y ∊ ω ∧ ((B = ∅ ∧ y = ∅) ∨ (∅ ∈ B ∧ ∃ v (v ∊ B ∧ y · B + v = A)))})) ≐ ⋃ {y | y ∊ ω ∧ ((([[ x / t ]] B) = ∅ ∧ y = ∅) ∨ (∅ ∈ ([[ x / t ]] B) ∧ ∃ v (v ∊ ([[ x / t ]] B) ∧ y · ([[ x / t ]] B) + v = ([[ x / t ]] A))))} $ by ceqt_refl

nmod_congr
----------
l1: $ ndiv A C ≐ ndiv B D $ by ndiv_congr [#1, #2]
l2: $ ndiv A C · C ≐ ndiv B D · D $ by nmul_congr [l1, #2]
l3: $ nsub A (ndiv A C · C) ≐ nsub B (ndiv B D · D) $ by nsub_congr [#1, l2]

nmod_eq
-------
l1: $ … ⇒ ndiv A C = ndiv B D $ by ndiv_eq [#1, #2]
l2: $ … ⇒ ndiv A C · C = ndiv B D · D $ by nmul_eq [l1, #2]
l3: $ … ⇒ nsub A (ndiv A C · C) = nsub B (ndiv B D · D) $ by nsub_eq [#1, l2]

sb_c_nmod
---------
l1: $ ([[ x / t ]] (nsub A (ndiv A B · B))) ≐ nsub ([[ x / t ]] A) ([[ x / t ]] (ndiv A B · B)) $ by sb_c_nsub
l2: $ ([[ x / t ]] (ndiv A B · B)) ≐ ([[ x / t ]] (ndiv A B)) · ([[ x / t ]] B) $ by sb_c_nmul
l3: $ ([[ x / t ]] (ndiv A B)) ≐ ndiv ([[ x / t ]] A) ([[ x / t ]] B) $ by sb_c_ndiv
l4: $ ([[ x / t ]] B) ≐ ([[ x / t ]] B) $ by ceqt_refl
l5: $ ([[ x / t ]] (ndiv A B)) · ([[ x / t ]] B) ≐ ndiv ([[ x / t ]] A) ([[ x / t ]] B) · ([[ x / t ]] B) $ by nmul_congr [l3, l4]
l6: $ ([[ x / t ]] (ndiv A B · B)) ≐ ndiv ([[ x / t ]] A) ([[ x / t ]] B) · ([[ x / t ]] B) $ by ceqt_trans [l2, l5]
l7: $ ([[ x / t ]] A) ≐ ([[ x / t ]] A) $ by ceqt_refl
l8: $ nsub ([[ x / t ]] A) ([[ x / t ]] (ndiv A B · B)) ≐ nsub ([[ x / t ]] A) (ndiv ([[ x / t ]] A) ([[ x / t ]] B) · ([[ x / t ]] B)) $ by nsub_congr [l7, l6]
l9: $ ([[ x / t ]] (nsub A (ndiv A B · B))) ≐ nsub ([[ x / t ]] A) (ndiv ([[ x / t ]] A) ([[ x / t ]] B) · ([[ x / t ]] B)) $ by ceqt_trans [l1, l8]

ngcd_congr
----------
l1: $ g ≐ g $ by ceqt_refl
l2: $ (g ∊ ω) ⟺ (g ∊ ω) $ by iff_refl
l3: $ ndvd g A ⟺ ndvd g B $ by ndvd_congr [l1, #1]
l4: $ ndvd g C ⟺ ndvd g D $ by ndvd_congr [l1, #2]
l5: $ k ≐ k $ by ceqt_refl
l6: $ ndvd k A ⟺ ndvd k B $ by ndvd_congr [l5, #1]
l7: $ ndvd k C ⟺ ndvd k D $ by ndvd_congr [l5, #2]
l8: $ ndvd k g ⟺ ndvd k g $ by iff_refl
l9: $ (ndvd k C → ndvd k g) ⟺ (ndvd k D → ndvd k g) $ by im_congr [l7, l8]
l10: $ (ndvd k A → ndvd k C → ndvd k g) ⟺ (ndvd k B → ndvd k D → ndvd k g) $ by im_congr [l6, l9]
l11: $ (k ∊ ω) ⟺ (k ∊ ω) $ by iff_refl
l12: $ (k ∊ ω → ndvd k A → ndvd k C → ndvd k g) ⟺ (k ∊ ω → ndvd k B → ndvd k D → ndvd k g) $ by im_congr [l11, l10]
l13: $ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g) ⟺ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g) $ by all_congr [l12]
l14: $ (ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)) ⟺ (ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)) $ by and_congr [l4, l13]
l15: $ (ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)) ⟺ (ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)) $ by and_congr [l3, l14]
l16: $ (g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)) ⟺ (g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)) $ by and_congr [l2, l15]
l17: $ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ≐ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $ by cab_congr [l16]
l18: $ ⋃ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ≐ ⋃ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $ by cuni_congr [l17]

lemma q1_ngcd_sub {g k: set} (G: hyps) (A B C D: class) (z: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ {g | g ∊ ω ∧ ndvd g B ∧ ndvd g D ∧ ∀ k (k ∊ ω → ndvd k B → ndvd k D → ndvd k g)} $
----
s0: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} $ by ax
s1: $ … ⇒ z ∊ ω ∧ ndvd z A ∧ ndvd z C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by cab_elim [s0]
s2: $ … ⇒ z ∊ ω $ by and_elim_l [s1]
s3: $ … ⇒ ndvd z A ∧ ndvd z C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by and_elim_r [s1]
s4: $ … ⇒ ndvd z A $ by and_elim_l [s3]
s5: $ … ⇒ ndvd z C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by and_elim_r [s3]
s6: $ … ⇒ ndvd z C $ by and_elim_l [s5]
s7: $ … ⇒ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by and_elim_r [s5]
s8: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ z = z $ by eq_refl
s9: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ A = B $ by weaken [#1]
s10: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} ⇒ C = D $ by weaken [#2]
s11: $ … ⇒ ndvd z B $ by ndvd_eq [s8, s9, s4]
s12: $ … ⇒ ndvd z D $ by ndvd_eq [s8, s10, s6]
t1: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k z) $ by weaken [s7]
t2: $ … ⇒ w ∊ ω → ndvd w A → ndvd w C → ndvd w z $ by all_elim [t1]
t3: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ w ∊ ω $ by ax
t4: $ … ⇒ ndvd w A → ndvd w C → ndvd w z $ by imp_elim [t2, t3]
t5: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ w = w $ by eq_refl
t6a: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ A = B $ by weaken [#1]
t7a: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ C = D $ by weaken [#2]
t8: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w B $ by ax
t9: $ G , z ∊ {g | g ∊ ω ∧ ndvd g A ∧ ndvd g C ∧ ∀ k (k ∊ ω → ndvd k A → ndvd k C → ndvd k g)} , w ∊ ω , ndvd w B , ndvd w D ⇒ ndvd w D $ by ax
