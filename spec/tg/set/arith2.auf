--| The elements of `two` are `0` and `1`.
lemma q2_two_cases (G: hyps) (t e o w: set):
  $ G ⇒ t = two $ > $ G ⇒ e = ∅ $ > $ G ⇒ o = suc e $ > $ G ⇒ w ∊ t $ > $ G ⇒ w = e ∨ w = o $
----
l1: $ G ⇒ two = suc (suc ∅) $ by two_eq_suc
l2: $ … ⇒ suc e = suc ∅ $ by suc_eq [#2]
l3: $ … ⇒ o = suc ∅ $ by eq_trans [#3, l2]
l4: $ … ⇒ suc o = suc (suc ∅) $ by suc_eq [l3]
l5: $ … ⇒ t = suc (suc ∅) $ by eq_trans [#1, l1]
l6a: $ … ⇒ suc (suc ∅) = suc o $ by eq_sym [l4]
l6: $ … ⇒ t = suc o $ by eq_trans [l5, l6a]
l7: $ … ⇒ w ∊ suc o $ by welc_eq [l6, #4]
l8: $ … ⇒ w ∊ o ∨ w = o $ by suc_elim [l7]
a1: $ G , w ∊ o ⇒ w ∊ o $ by ax
a2_w87: $ G , w ∊ o ⇒ o = suc e $ by weaken [#3]
a2: $ … ⇒ w ∊ suc e $ by welc_eq [a2_w87, a1]
a3: $ … ⇒ w ∊ e ∨ w = e $ by suc_elim [a2]
a4: $ G , w ∊ o , w ∊ e ⇒ w ∊ e $ by ax
a5_w88: $ G , w ∊ o , w ∊ e ⇒ e = ∅ $ by weaken [#2]
a5: $ … ⇒ w ∊ ∅ $ by welc_eq [a5_w88, a4]
a6: $ … ⇒ ⊥ $ by empty_elim [a5]
a7: $ … ⇒ w = e ∨ w = o $ by bot_elim [a6]
a8: $ G , w ∊ o , w = e ⇒ w = e $ by ax
a9: $ … ⇒ w = e ∨ w = o $ by or_intro_l [a8]
a10: $ … ⇒ w = e ∨ w = o $ by or_elim [a3, a7, a9]
b1: $ G , w = o ⇒ w = o $ by ax
b2: $ … ⇒ w = e ∨ w = o $ by or_intro_r [b1]
b3: $ … ⇒ w = e ∨ w = o $ by or_elim [l8, a10, b2]

--| `2a + 0` and `2a + 1` as `a·2 + r`.
lemma q2_dbl_facts (G: hyps) (a t e o n: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ t = two $ > $ G ⇒ e = ∅ $ > $ G ⇒ o = suc e $ > $ G ⇒ n = ndbl a $ >
  $ G ⇒ a · t + e = n ∧ a · t + o = suc n $
----
l1: $ G ⇒ a = a $ by eq_refl
l2: $ … ⇒ a · t = a · two $ by nmul_eq [l1, #2]
l3: $ … ⇒ a · two = ndbl a $ by nmul_two [#1]
l4: $ … ⇒ ndbl a = n $ by eq_sym [#5]
l5a: $ … ⇒ a · t = ndbl a $ by eq_trans [l2, l3]
l5: $ … ⇒ a · t = n $ by eq_trans [l5a, l4]
l6: $ … ⇒ a · t + e = n + ∅ $ by nadd_eq [l5, #3]
l7: $ G ⇒ n + ∅ = n $ by nadd_zero
l8: $ … ⇒ a · t + e = n $ by eq_trans [l6, l7]
l9a: $ … ⇒ ∅ = e $ by eq_sym [#3]
l9b: $ G ⇒ ∅ ∈ ω $ by omega_zero
l9c: $ … ⇒ e ∈ ω $ by wcel_eq_l [l9a, l9b]
l9: $ … ⇒ e ∊ ω $ by wcel_welc [l9c]
l10: $ … ⇒ a · t + o = n + suc e $ by nadd_eq [l5, #4]
l11: $ … ⇒ n + suc e = suc (n + e) $ by nadd_suc [l9]
l12a: $ G ⇒ n = n $ by eq_refl
l12b: $ … ⇒ n + e = n + ∅ $ by nadd_eq [l12a, #3]
l12: $ … ⇒ n + e = n $ by eq_trans [l12b, l7]
l13: $ … ⇒ suc (n + e) = suc n $ by suc_eq [l12]
l14a: $ … ⇒ a · t + o = suc (n + e) $ by eq_trans [l10, l11]
l14: $ … ⇒ a · t + o = suc n $ by eq_trans [l14a, l13]
l15: $ … ⇒ a · t + e = n ∧ a · t + o = suc n $ by and_intro [l8, l14]

