-- Proofs for relations.mm0.

--| Membership in a product of a set equal to a pair.
cxp_intro_eq
------------
l1: $ … ⇒ a ∊ A ∧ b ∊ B $ by and_intro [#2, #3]
l2: $ … ⇒ c = ⟨ a , b ⟩ ∧ a ∊ A ∧ b ∊ B $ by and_intro [#1, l1]
l3: $ … ⇒ ∃ v (c = ⟨ a , v ⟩ ∧ a ∊ A ∧ v ∊ B) $ by ex_intro [l2]
l4: $ … ⇒ ∃ u ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ B) $ by ex_intro [l3]
l5: $ … ⇒ c ∊ {w | ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ B)} $ by cab_intro [l4]

cxp_intro
---------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ … ⇒ isset ⟨ a , b ⟩ $ by opair_set [l1, l2]
l4: $ G , k = ⟨ a , b ⟩ ⇒ k = ⟨ a , b ⟩ $ by ax
l5: $ G , k = ⟨ a , b ⟩ ⇒ a ∊ A $ by weaken [#1]
l6: $ G , k = ⟨ a , b ⟩ ⇒ b ∊ B $ by weaken [#2]
l7: $ … ⇒ k ∊ A × B $ by cxp_intro_eq [l4, l5, l6]
l8: $ … ⇒ ⟨ a , b ⟩ ∈ A × B $ by wcel_intro [l4, l7]
l9: $ … ⇒ ⟨ a , b ⟩ ∈ A × B $ by isset_elim [l3, l8]

cxp_intro_c
-----------
l1: $ G , u = C , u ∊ A , v = D , v ∊ B ⇒ u ∊ A $ by ax
l2: $ G , u = C , u ∊ A , v = D , v ∊ B ⇒ v ∊ B $ by ax
l3: $ … ⇒ ⟨ u , v ⟩ ∈ A × B $ by cxp_intro [l1, l2]
l4: $ G , u = C , u ∊ A , v = D , v ∊ B ⇒ u = C $ by ax
l5: $ G , u = C , u ∊ A , v = D , v ∊ B ⇒ v = D $ by ax
l6: $ … ⇒ ⟨ u , v ⟩ = ⟨ C , D ⟩ $ by opair_eq [l4, l5]
l7: $ … ⇒ ⟨ C , D ⟩ ∈ A × B $ by wcel_eq_l [l6, l3]
l8: $ … ⇒ ⟨ C , D ⟩ ∈ A × B $ by wcel_elim [#2, l7]
l9: $ … ⇒ ⟨ C , D ⟩ ∈ A × B $ by wcel_elim [#1, l8]

cxp_elim
--------
l1: $ … ⇒ ∃ x ∃ y (c = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $ by cab_elim [#1]
l2: $ … ⇒ y ∊ B → d $ by imp_intro [#2]
l3: $ … ⇒ x ∊ A → y ∊ B → d $ by imp_intro [l2]
l4: $ … ⇒ c = ⟨ x , y ⟩ → x ∊ A → y ∊ B → d $ by imp_intro [l3]
