l4: $ … ⇒ ⟨ u , z ⟩ ∈ S $ by wcel_subset [l3, l2]
l5: $ … ⇒ z ∊ crn S $ by crn_intro [l4]
l6: $ … ⇒ z ∊ crn S $ by crn_elim [l1, l5]
l7: $ … ⇒ crn R ⊆ crn S $ by subset_intro [l6]

cdm_cxp
-------
l1: $ G , z ∊ cdm (A × B) ⇒ z ∊ cdm (A × B) $ by ax
l2: $ G , z ∊ cdm (A × B) , ⟨ z , v ⟩ ∈ A × B ⇒ ⟨ z , v ⟩ ∈ A × B $ by ax
l3: $ … ⇒ z ∊ A ∧ v ∊ B $ by cxp_elim_pair [l2]
l4: $ … ⇒ z ∊ A $ by and_elim_l [l3]
l5: $ … ⇒ z ∊ A $ by cdm_elim [l1, l4]
l6: $ G , z ∊ A ⇒ z ∊ A $ by ax
l7: $ G , z ∊ A ⇒ b ∊ B $ by weaken [#1]
l8: $ … ⇒ ⟨ z , b ⟩ ∈ A × B $ by cxp_intro [l6, l7]
l9: $ … ⇒ z ∊ cdm (A × B) $ by cdm_intro [l8]
l10: $ … ⇒ cdm (A × B) = A $ by eq_intro [l5, l9]

crn_cxp
-------
l1: $ G , z ∊ crn (A × B) ⇒ z ∊ crn (A × B) $ by ax
l2: $ G , z ∊ crn (A × B) , ⟨ u , z ⟩ ∈ A × B ⇒ ⟨ u , z ⟩ ∈ A × B $ by ax
l3: $ … ⇒ u ∊ A ∧ z ∊ B $ by cxp_elim_pair [l2]
l4: $ … ⇒ z ∊ B $ by and_elim_r [l3]
l5: $ … ⇒ z ∊ B $ by crn_elim [l1, l4]
l6: $ G , z ∊ B ⇒ z ∊ B $ by ax
l7: $ G , z ∊ B ⇒ a ∊ A $ by weaken [#1]
l8: $ … ⇒ ⟨ a , z ⟩ ∈ A × B $ by cxp_intro [l7, l6]
l9: $ … ⇒ z ∊ crn (A × B) $ by crn_intro [l8]
l10: $ … ⇒ crn (A × B) = B $ by eq_intro [l5, l9]

cdm_empty
---------
l1: $ G , x ∊ cdm ∅ ⇒ x ∊ cdm ∅ $ by ax
l2: $ G , x ∊ cdm ∅ , ⟨ x , y ⟩ ∈ ∅ , z = ⟨ x , y ⟩ , z ∊ ∅ ⇒ z ∊ ∅ $ by ax
l3: $ … ⇒ ⊥ $ by empty_elim [l2]
l4: $ G , x ∊ cdm ∅ , ⟨ x , y ⟩ ∈ ∅ ⇒ ⟨ x , y ⟩ ∈ ∅ $ by ax
l5: $ … ⇒ ⊥ $ by wcel_elim [l4, l3]
l6: $ … ⇒ ⊥ $ by cdm_elim [l1, l5]
l7: $ … ⇒ cdm ∅ = ∅ $ by empty_eq_intro [l6]

rel_subset_cxp
--------------
l1: $ G , z ∊ R ⇒ z ∊ R $ by ax
l2: $ G , z ∊ R ⇒ rel R $ by weaken [#1]
l3: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ z = ⟨ u , v ⟩ $ by ax
l4: $ G , z ∊ R , z = ⟨ u , v ⟩ ⇒ z ∊ R $ by ax
l5: $ … ⇒ z ∈ R $ by welc_wcel [l4]
l6: $ … ⇒ ⟨ u , v ⟩ ∈ R $ by wcel_eq_l [l3, l5]
l7: $ … ⇒ u ∊ cdm R $ by cdm_intro [l6]
l8: $ … ⇒ v ∊ crn R $ by crn_intro [l6]
l9: $ … ⇒ z ∊ cdm R × crn R $ by cxp_intro_eq [l3, l7, l8]
l10: $ … ⇒ z ∊ cdm R × crn R $ by rel_elim [l2, l1, l9]
l11: $ … ⇒ R ⊆ cdm R × crn R $ by subset_intro [l10]

cdm_set
-------
l1: $ G , z ∊ cdm R ⇒ z ∊ cdm R $ by ax
l2: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R ⇒ ⟨ z , v ⟩ ∈ R $ by ax
l3: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R ⇒ isset z $ by isset_var
l4: $ … ⇒ isset (csn z) $ by csn_set [l3]
l5: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ w = csn z $ by ax
l6: $ … ⇒ w = csn z ∨ w = cpr z v $ by or_intro_l [l5]
l7: $ … ⇒ w ∊ cpr (csn z) (cpr z v) $ by cpr_intro [l6]
l8: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ k = ⟨ z , v ⟩ $ by ax
l9: $ … ⇒ ⟨ z , v ⟩ = k $ by eq_sym [l8]
l10: $ … ⇒ w ∊ k $ by welc_eq [l9, l7]
l11: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ k ∊ R $ by ax
l12: $ … ⇒ w ∊ ⋃ R $ by cuni_intro [l10, l11]
l13: $ … ⇒ csn z = w $ by eq_sym [l5]
l14: $ G , z ∊ cdm R , ⟨ z , v ⟩ ∈ R , k = ⟨ z , v ⟩ , k ∊ R , w = csn z ⇒ z ∊ csn z $ by csn_intro_var
l15: $ … ⇒ z ∊ w $ by welc_eq [l13, l14]
l16: $ … ⇒ z ∊ ⋃ ⋃ R $ by cuni_intro [l15, l12]
l17: $ … ⇒ z ∊ ⋃ ⋃ R $ by isset_elim [l4, l16]
l18: $ … ⇒ z ∊ ⋃ ⋃ R $ by wcel_elim [l2, l17]
l19: $ … ⇒ z ∊ ⋃ ⋃ R $ by cdm_elim [l1, l18]
l20: $ … ⇒ cdm R ⊆ ⋃ ⋃ R $ by subset_intro [l19]
l21: $ … ⇒ isset (⋃ R) $ by cuni_set [#1]
l22: $ … ⇒ isset (⋃ ⋃ R) $ by cuni_set [l21]
l23: $ … ⇒ isset (cdm R) $ by subset_isset [l22, l20]

crn_set
-------
l1: $ G , z ∊ crn R ⇒ z ∊ crn R $ by ax
l2: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R ⇒ ⟨ u , z ⟩ ∈ R $ by ax
l3: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R ⇒ isset (cpr u z) $ by ax_pair
l5: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ w = cpr u z $ by ax
l6: $ … ⇒ w = csn u ∨ w = cpr u z $ by or_intro_r [l5]
l7: $ … ⇒ w ∊ cpr (csn u) (cpr u z) $ by cpr_intro [l6]
l8: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ k = ⟨ u , z ⟩ $ by ax
l9: $ … ⇒ ⟨ u , z ⟩ = k $ by eq_sym [l8]
l10: $ … ⇒ w ∊ k $ by welc_eq [l9, l7]
l11: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ k ∊ R $ by ax
l12: $ … ⇒ w ∊ ⋃ R $ by cuni_intro [l10, l11]
l13: $ … ⇒ cpr u z = w $ by eq_sym [l5]
l14: $ G , z ∊ crn R , ⟨ u , z ⟩ ∈ R , k = ⟨ u , z ⟩ , k ∊ R , w = cpr u z ⇒ z ∊ cpr u z $ by cpr_intro_r
l15: $ … ⇒ z ∊ w $ by welc_eq [l13, l14]
l16: $ … ⇒ z ∊ ⋃ ⋃ R $ by cuni_intro [l15, l12]
l17: $ … ⇒ z ∊ ⋃ ⋃ R $ by isset_elim [l3, l16]
l18: $ … ⇒ z ∊ ⋃ ⋃ R $ by wcel_elim [l2, l17]
l19: $ … ⇒ z ∊ ⋃ ⋃ R $ by crn_elim [l1, l18]
l20: $ … ⇒ crn R ⊆ ⋃ ⋃ R $ by subset_intro [l19]
l21: $ … ⇒ isset (⋃ R) $ by cuni_set [#1]
l22: $ … ⇒ isset (⋃ ⋃ R) $ by cuni_set [l21]
l23: $ … ⇒ isset (crn R) $ by subset_isset [l22, l20]

functional_set
--------------
l1: $ G , y ∊ crn F , ⟨ x , y ⟩ ∈ F ⇒ ⟨ x , y ⟩ ∈ F $ by ax
l2: $ … ⇒ x ∊ cdm F $ by cdm_intro [l1]
l3: $ … ⇒ y ∊ img F (cdm F) $ by img_intro [l2, l1]
l4: $ G , y ∊ crn F ⇒ y ∊ crn F $ by ax
l5: $ … ⇒ y ∊ img F (cdm F) $ by crn_elim [l4, l3]
l6: $ … ⇒ crn F ⊆ img F (cdm F) $ by subset_intro [l5]
l7: $ … ⇒ isset (img F (cdm F)) $ by img_set [#1, #3]
l8: $ … ⇒ isset (crn F) $ by subset_isset [l7, l6]
l9: $ … ⇒ isset (cdm F × crn F) $ by cxp_set [#3, l8]
l10: $ … ⇒ F ⊆ cdm F × crn F $ by rel_subset_cxp [#2]
l11: $ … ⇒ isset F $ by subset_isset [l9, l10]

cdm_congr
---------
l0: $ ⟨ u , v ⟩ ≐ ⟨ u , v ⟩ $ by ceqt_refl
l1: $ (⟨ u , v ⟩ ∈ R) ⟺ (⟨ u , v ⟩ ∈ S) $ by wcel_congr [l0, #1]
l2: $ ∃ v (⟨ u , v ⟩ ∈ R) ⟺ ∃ v (⟨ u , v ⟩ ∈ S) $ by ex_congr [l1]
l3: $ {u | ∃ v (⟨ u , v ⟩ ∈ R)} ≐ {u | ∃ v (⟨ u , v ⟩ ∈ S)} $ by cab_congr [l2]

crn_congr
---------
l0: $ ⟨ u , v ⟩ ≐ ⟨ u , v ⟩ $ by ceqt_refl
l1: $ (⟨ u , v ⟩ ∈ R) ⟺ (⟨ u , v ⟩ ∈ S) $ by wcel_congr [l0, #1]
l2: $ ∃ u (⟨ u , v ⟩ ∈ R) ⟺ ∃ u (⟨ u , v ⟩ ∈ S) $ by ex_congr [l1]
l3: $ {v | ∃ u (⟨ u , v ⟩ ∈ R)} ≐ {v | ∃ u (⟨ u , v ⟩ ∈ S)} $ by cab_congr [l2]

cdm_eq
------
l1: $ … ⇒ R ⊆ S $ by eq_subset [#1]
l2: $ … ⇒ S = R $ by eq_sym [#1]
l3: $ … ⇒ S ⊆ R $ by eq_subset [l2]
l4: $ … ⇒ cdm R ⊆ cdm S $ by cdm_mono [l1]
l5: $ … ⇒ cdm S ⊆ cdm R $ by cdm_mono [l3]
l6: $ … ⇒ cdm R = cdm S $ by subset_antisym [l4, l5]

crn_eq
------
l1: $ … ⇒ R ⊆ S $ by eq_subset [#1]
l2: $ … ⇒ S = R $ by eq_sym [#1]
l3: $ … ⇒ S ⊆ R $ by eq_subset [l2]
l4: $ … ⇒ crn R ⊆ crn S $ by crn_mono [l1]
l5: $ … ⇒ crn S ⊆ crn R $ by crn_mono [l3]
l6: $ … ⇒ crn R = crn S $ by subset_antisym [l4, l5]

cuni_crn_csn
------------
r1: $ G , x ∊ crn (csn ⟨ a , b ⟩) ⇒ x ∊ crn (csn ⟨ a , b ⟩) $ by ax
r2: $ G , ⟨ e , x ⟩ ∈ csn ⟨ a , b ⟩ ⇒ ⟨ e , x ⟩ ∈ csn ⟨ a , b ⟩ $ by ax
r3: $ … ⇒ e = a ∧ x = b $ by csn_opair_elim [r2]
r4: $ … ⇒ x = b $ by and_elim_r [r3]
r5: $ … ⇒ x ∊ csn b $ by csn_intro [r4]
r6: $ … ⇒ x ∊ csn b $ by crn_elim [r1, r5]
r7: $ … ⇒ crn (csn ⟨ a , b ⟩) ⊆ csn b $ by subset_intro [r6]
r8: $ G ⇒ ⟨ a , b ⟩ ∈ csn ⟨ a , b ⟩ $ by csn_opair_intro
r9: $ … ⇒ b ∊ crn (csn ⟨ a , b ⟩) $ by crn_intro [r8]
r10: $ … ⇒ csn b ⊆ crn (csn ⟨ a , b ⟩) $ by csn_subset [r9]
r11: $ … ⇒ crn (csn ⟨ a , b ⟩) = csn b $ by subset_antisym [r7, r10]
r12: $ … ⇒ ⋃ (crn (csn ⟨ a , b ⟩)) = ⋃ (csn b) $ by cuni_eq [r11]
r13: $ G ⇒ isset b $ by isset_var
r14: $ … ⇒ ⋃ (csn b) = b $ by cuni_csn [r13]
r15: $ … ⇒ ⋃ (crn (csn ⟨ a , b ⟩)) = b $ by eq_trans [r12, r14]

cuni_crn_csn_c
--------------
r1: $ G , a = A , b = B ⇒ a = A $ by ax
r2: $ G , a = A , b = B ⇒ b = B $ by ax
r3: $ … ⇒ A = a $ by eq_sym [r1]
r4: $ … ⇒ B = b $ by eq_sym [r2]
r5: $ … ⇒ ⟨ A , B ⟩ = ⟨ a , b ⟩ $ by opair_eq [r3, r4]
r6: $ … ⇒ csn ⟨ A , B ⟩ = csn ⟨ a , b ⟩ $ by csn_eq [r5]
r7: $ … ⇒ crn (csn ⟨ A , B ⟩) = crn (csn ⟨ a , b ⟩) $ by crn_eq [r6]
r8: $ … ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = ⋃ (crn (csn ⟨ a , b ⟩)) $ by cuni_eq [r7]
r9: $ G , a = A , b = B ⇒ ⋃ (crn (csn ⟨ a , b ⟩)) = b $ by cuni_crn_csn
r10: $ … ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = b $ by eq_trans [r8, r9]
r11: $ … ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = B $ by eq_trans [r10, r2]
r12: $ … ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = B $ by isset_elim [#2, r11]
r13: $ … ⇒ ⋃ (crn (csn ⟨ A , B ⟩)) = B $ by isset_elim [#1, r12]

sb_c_cdm
--------
l1: $ (⟦ x / t ⟧ {u | ∃ v (⟨ u , v ⟩ ∈ R)}) ≐ {u | ∃ v (⟨ u , v ⟩ ∈ (⟦ x / t ⟧ R))} $ by ceqt_refl

sb_c_crn
--------
l1: $ (⟦ x / t ⟧ {v | ∃ u (⟨ u , v ⟩ ∈ R)}) ≐ {v | ∃ u (⟨ u , v ⟩ ∈ (⟦ x / t ⟧ R))} $ by ceqt_refl

ccnv_intro
----------
l1: $ G ⇒ isset b $ by isset_var
l2: $ G ⇒ isset a $ by isset_var
l3: $ … ⇒ isset ⟨ b , a ⟩ $ by opair_set [l1, l2]
l4: $ G , u = ⟨ b , a ⟩ ⇒ u = ⟨ b , a ⟩ $ by ax
l5: $ G , u = ⟨ b , a ⟩ ⇒ ⟨ a , b ⟩ ∈ R $ by weaken [#1]
l6: $ … ⇒ u = ⟨ b , a ⟩ ∧ ⟨ a , b ⟩ ∈ R $ by and_intro [l4, l5]
l7: $ … ⇒ ∃ y (u = ⟨ y , a ⟩ ∧ ⟨ a , y ⟩ ∈ R) $ by ex_intro [l6]
l8: $ … ⇒ ∃ x ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by ex_intro [l7]
l9: $ … ⇒ u ∊ {z | ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R)} $ by cab_intro [l8]
l10: $ … ⇒ ⟨ b , a ⟩ ∈ ccnv R $ by wcel_intro [l4, l9]
l11: $ … ⇒ ⟨ b , a ⟩ ∈ ccnv R $ by isset_elim [l3, l10]

ccnv_elim
---------
l1: $ u = ⟨ b , a ⟩ , u ∊ ccnv R ⇒ u ∊ ccnv R $ by ax
l2: $ … ⇒ ∃ x ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [l1]
l3: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R $ by ax
l4: $ … ⇒ u = ⟨ y , x ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l3]
l6: $ u = ⟨ b , a ⟩ , u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ b , a ⟩ $ by ax
l7: $ … ⇒ ⟨ y , x ⟩ = u $ by eq_sym [l4]
l8: $ … ⇒ ⟨ y , x ⟩ = ⟨ b , a ⟩ $ by eq_trans [l7, l6]
l9: $ … ⇒ y = b $ by opair_inj_l [l8]
l10: $ … ⇒ x = a $ by opair_inj_r [l8]
l11: $ … ⇒ ⟨ x , y ⟩ = ⟨ a , b ⟩ $ by opair_eq [l10, l9]
l12: $ … ⇒ ⟨ a , b ⟩ ∈ R $ by wcel_eq_l [l11, l5]
l13: $ u = ⟨ b , a ⟩ , ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (u = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l14: $ … ⇒ ⟨ a , b ⟩ ∈ R $ by ex_elim [l13, l12]
l15: $ … ⇒ ⟨ a , b ⟩ ∈ R $ by ex_elim [l2, l14]
l16: $ … ⇒ ⟨ a , b ⟩ ∈ R $ by wcel_elim [#1, l15]

ccnv_rel
--------
l1: $ z ∊ ccnv R ⇒ z ∊ ccnv R $ by ax
l2: $ … ⇒ ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [l1]
l3: $ z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R $ by ax
l4: $ … ⇒ z = ⟨ y , x ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ ∃ v (z = ⟨ y , v ⟩) $ by ex_intro [l4]
l6: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_intro [l5]
l7: $ ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l8: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_elim [l7, l6]
l9: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_elim [l2, l8]
l10: $ G , z ∊ ccnv R ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by weaken [l9]
l11: $ … ⇒ rel (ccnv R) $ by rel_intro [l10]

ccnv_ccnv
---------
l1: $ G ⇒ rel (ccnv (ccnv R)) $ by ccnv_rel
l2: $ G , ⟨ x , y ⟩ ∈ ccnv (ccnv R) ⇒ ⟨ x , y ⟩ ∈ ccnv (ccnv R) $ by ax
l3: $ … ⇒ ⟨ y , x ⟩ ∈ ccnv R $ by ccnv_elim [l2]
l4: $ … ⇒ ⟨ x , y ⟩ ∈ R $ by ccnv_elim [l3]
l5: $ G , ⟨ x , y ⟩ ∈ R ⇒ ⟨ x , y ⟩ ∈ R $ by ax
l6: $ … ⇒ ⟨ y , x ⟩ ∈ ccnv R $ by ccnv_intro [l5]
l7: $ … ⇒ ⟨ x , y ⟩ ∈ ccnv (ccnv R) $ by ccnv_intro [l6]
l8: $ … ⇒ ccnv (ccnv R) = R $ by rel_eq_intro [l1, #1, l4, l7]

ccnv_congr
----------
l0: $ ⟨ x , y ⟩ ≐ ⟨ x , y ⟩ $ by ceqt_refl
l1: $ (⟨ x , y ⟩ ∈ R) ⟺ (⟨ x , y ⟩ ∈ S) $ by wcel_congr [l0, #1]
l2: $ (z = ⟨ y , x ⟩) ⟺ (z = ⟨ y , x ⟩) $ by iff_refl
l3: $ (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⟺ (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ S) $ by and_congr [l2, l1]
l4: $ ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⟺ ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ S) $ by ex_congr [l3]
l5: $ ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) ⟺ ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ S) $ by ex_congr [l4]
l6: $ {z | ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R)} ≐ {z | ∃ x ∃ y (z = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ S)} $ by cab_congr [l5]

welc_ccnv_eq
------------
l1: $ … ⇒ ∃ x ∃ y (a = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [#2]
l2: $ G , a = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ a = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R $ by ax
l3: $ … ⇒ a = ⟨ y , x ⟩ $ by and_elim_l [l2]
l4: $ … ⇒ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l2]
l5: $ G , a = ⟨ y , x ⟩ ∧ ⟨ x , y ⟩ ∈ R ⇒ R = S $ by weaken [#1]
l6: $ … ⇒ ⟨ x , y ⟩ ∈ S $ by wcel_eq_r [l5, l4]
