lemma r3_pi_sub {x: set} (G: hyps x) (A: class) (B: class x) (f g: set):
  $ G ⇒ f ∊ cpi x A B $ > $ G ⇒ ∀ x (x ∊ A → ap f x = ap g x) $ > $ G ⇒ f ⊆ g $
----
l1: $ … ⇒ f ⊆ clam x A (⋃ B) $ by cpi_elim_sub [#1]
l2: $ G , w ∊ f ⇒ f ⊆ clam x A (⋃ B) $ by weaken [l1]
l3: $ G , w ∊ f ⇒ w ∊ f $ by ax
l4: $ … ⇒ w ∊ clam x A (⋃ B) $ by subset_elim [l2, l3]
l5: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w ∊ f $ by ax
l6: $ … ⇒ w ∈ f $ by welc_wcel [l5]
l7: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w = ⟨ u , v ⟩ $ by ax
l8: $ … ⇒ ⟨ u , v ⟩ ∈ f $ by wcel_eq_l [l7, l6]
l9: $ … ⇒ v ∊ ap f u $ by ap_intro [l8]
l10: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ∀ x (x ∊ A → ap f x = ap g x) $ by weaken [#2]
l11: $ … ⇒ u ∊ A → ap f u = ap g u $ by all_elim [l10]
l12: $ G , w ∊ f , w = ⟨ u , v ⟩ , u ∊ A , v ∊ ⋃ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l13: $ … ⇒ ap f u = ap g u $ by imp_elim [l11, l12]
l14: $ … ⇒ v ∊ ap g u $ by welc_eq [l13, l9]
l15: $ … ⇒ ⟨ u , v ⟩ ∈ g $ by ap_elim [l14]
l16: $ … ⇒ ⟨ u , v ⟩ = w $ by eq_sym [l7]
l17: $ … ⇒ w ∈ g $ by wcel_eq_l [l16, l15]
l18: $ … ⇒ w ∊ g $ by wcel_welc [l17]
l19: $ … ⇒ w ∊ g $ by clam_elim_mem [l4, l18]
l20: $ … ⇒ f ⊆ g $ by subset_intro [l19]

cpi_ext
------
l1: $ … ⇒ f ⊆ g $ by r3_pi_sub [#1, #3]
l2: $ G , i ∊ A ⇒ ∀ x (x ∊ A → ap f x = ap g x) $ by weaken [#3]
l3: $ … ⇒ i ∊ A → ap f i = ap g i $ by all_elim [l2]
l4: $ G , i ∊ A ⇒ i ∊ A $ by ax
l5: $ … ⇒ ap f i = ap g i $ by imp_elim [l3, l4]
l6: $ … ⇒ ap g i = ap f i $ by eq_sym [l5]
l7: $ … ⇒ i ∊ A → ap g i = ap f i $ by imp_intro [l6]
l8: $ … ⇒ ∀ i (i ∊ A → ap g i = ap f i) $ by all_intro [l7]
l9: $ (∀ x (x ∊ A → ap g x = ap f x)) ⟺ ∀ i (i ∊ A → ap g i = ap f i) $ by all_alpha
l10: $ G ⇒ (∀ x (x ∊ A → ap g x = ap f x)) ↔ ∀ i (i ∊ A → ap g i = ap f i) $ by weaken [l9]
l11: $ … ⇒ ∀ x (x ∊ A → ap g x = ap f x) $ by bi_elim_r [l10, l8]
l12: $ … ⇒ g ⊆ f $ by r3_pi_sub [#2, l11]
l13: $ … ⇒ f = g $ by subset_antisym [l1, l12]

cpi_set
------
l1: $ G , w ∊ cpi x A B ⇒ w ∊ cpi x A B $ by ax
l2: $ … ⇒ w ⊆ clam x A (⋃ B) $ by cpi_elim_sub [l1]
l3: $ … ⇒ w ∊ 𝒫 (clam x A (⋃ B)) $ by cpw_intro [l2]
l4: $ … ⇒ cpi x A B ⊆ 𝒫 (clam x A (⋃ B)) $ by subset_intro [l3]
l5: $ … ⇒ isset (𝒫 (clam x A (⋃ B))) $ by cpw_set [#1]
l6: $ … ⇒ isset (cpi x A B) $ by subset_isset [l5, l4]

cpi_congr
--------
l0: $ ⋃ B ≐ ⋃ D $ by cuni_congr [#2]
l1: $ clam x A (⋃ B) ≐ clam x C (⋃ D) $ by clam_congr [#1, l0]
l2: $ cv g ≐ cv g $ by ceqt_refl
l3: $ (g ⊆ clam x A (⋃ B)) ⟺ (g ⊆ clam x C (⋃ D)) $ by subset_congr [l2, l1]
l4: $ seqt x x $ by seqt_refl
l5: $ (x ∊ A) ⟺ (x ∊ C) $ by welc_congr [l4, #1]
l6: $ ap g x ≐ ap g x $ by ceqt_refl
l7: $ (ap g x ∈ B) ⟺ (ap g x ∈ D) $ by wcel_congr [l6, #2]
l8: $ (x ∊ A → ap g x ∈ B) ⟺ (x ∊ C → ap g x ∈ D) $ by im_congr [l5, l7]
l9: $ (∀ x (x ∊ A → ap g x ∈ B)) ⟺ (∀ x (x ∊ C → ap g x ∈ D)) $ by all_congr [l8]
l10: $ (g ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)) ⟺ (g ⊆ clam x C (⋃ D) ∧ ∀ x (x ∊ C → ap g x ∈ D)) $ by and_congr [l3, l9]
l11: $ {g | g ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)} ≐ {g | g ⊆ clam x C (⋃ D) ∧ ∀ x (x ∊ C → ap g x ∈ D)} $ by cab_congr [l10]

clam_alpha
----------
l1: $ ∃ x ∃ v (z = ⟨ x , v ⟩ ∧ x ∊ A ∧ v ∊ B) ⟺ ∃ y ∃ v (z = ⟨ y , v ⟩ ∧ y ∊ A ∧ v ∊ (⟦ x / y ⟧ B)) $ by ex_alpha
l2: $ clam x A B ≐ clam y A (⟦ x / y ⟧ B) $ by cab_congr [l1]

cpi_alpha
---------
l1: $ clam x A (⋃ B) ≐ clam y A (⟦ x / y ⟧ (⋃ B)) $ by clam_alpha
l2: $ f ≐ f $ by ceqt_refl
l3: $ (f ⊆ clam x A (⋃ B)) ⟺ (f ⊆ clam y A (⋃ (⟦ x / y ⟧ B))) $ by subset_congr [l2, l1]
l4: $ ∀ x (x ∊ A → ap f x ∈ B) ⟺ ∀ y (y ∊ A → ap f y ∈ (⟦ x / y ⟧ B)) $ by all_alpha
l5: $ (f ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap f x ∈ B)) ⟺ (f ⊆ clam y A (⋃ (⟦ x / y ⟧ B)) ∧ ∀ y (y ∊ A → ap f y ∈ (⟦ x / y ⟧ B))) $ by and_congr [l3, l4]
l6: $ cpi x A B ≐ cpi y A (⟦ x / y ⟧ B) $ by cab_congr [l5]

cpi_intro_pts
-------------
l1: $ G , c ∊ f ⇒ ∀ c (c ∊ f → ∃ a ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩)) $ by weaken [#1]
l2: $ … ⇒ c ∊ f → ∃ a ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩) $ by all_elim [l1]
l3: $ G , c ∊ f ⇒ c ∊ f $ by ax
l4: $ … ⇒ ∃ a ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩) $ by imp_elim [l2, l3]
k1: $ G , c ∊ f , a ∊ A ∧ c = ⟨ a , b ⟩ ⇒ a ∊ A ∧ c = ⟨ a , b ⟩ $ by ax
k2: $ … ⇒ a ∊ A $ by and_elim_l [k1]
k3: $ … ⇒ c = ⟨ a , b ⟩ $ by and_elim_r [k1]
k4: $ G , c ∊ f , a ∊ A ∧ c = ⟨ a , b ⟩ ⇒ c ∊ f $ by ax
k5: $ … ⇒ ⟨ a , b ⟩ ∈ f $ by wcel_intro [k3, k4]
k6: $ … ⇒ b ∊ ap f a $ by ap_intro [k5]
k7a: $ G , c ∊ f , a ∊ A ∧ c = ⟨ a , b ⟩ ⇒ ∀ x (x ∊ A → ap f x ∈ B) $ by weaken [#2]
k7b: $ … ⇒ a ∊ A → ap f a ∈ (⟦ x / a ⟧ B) $ by all_elim [k7a]
k7: $ … ⇒ ap f a ∈ (⟦ x / a ⟧ B) $ by imp_elim [k7b, k2]
j1: $ G , c ∊ f , a ∊ A ∧ c = ⟨ a , b ⟩ , v = ap f a , v ∊ (⟦ x / a ⟧ B) ⇒ v = ap f a $ by ax
j2: $ … ⇒ ap f a = v $ by eq_sym [j1]
j3: $ G , c ∊ f , a ∊ A ∧ c = ⟨ a , b ⟩ , v = ap f a , v ∊ (⟦ x / a ⟧ B) ⇒ b ∊ ap f a $ by weaken [k6]
j4: $ … ⇒ b ∊ v $ by welc_eq [j2, j3]
j5: $ G , c ∊ f , a ∊ A ∧ c = ⟨ a , b ⟩ , v = ap f a , v ∊ (⟦ x / a ⟧ B) ⇒ v ∊ (⟦ x / a ⟧ B) $ by ax
j6: $ … ⇒ b ∊ ⋃ (⟦ x / a ⟧ B) $ by cuni_intro [j4, j5]
k8: $ … ⇒ b ∊ ⋃ (⟦ x / a ⟧ B) $ by wcel_elim [k7, j6]
k9: $ G , c ∊ f , a ∊ A ∧ c = ⟨ a , b ⟩ ⇒ ⟨ a , b ⟩ ∈ clam x A (⋃ B) $ by clam_intro [k2, k8]
k10: $ … ⇒ ⟨ a , b ⟩ = c $ by eq_sym [k3]
k11: $ … ⇒ c ∈ clam x A (⋃ B) $ by wcel_eq_l [k10, k9]
k12: $ … ⇒ c ∊ clam x A (⋃ B) $ by wcel_welc [k11]
ea1: $ G , c ∊ f , ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩) ⇒ ∃ b (a ∊ A ∧ c = ⟨ a , b ⟩) $ by ax
eb1: $ … ⇒ c ∊ clam x A (⋃ B) $ by ex_elim [ea1, k12]
ez: $ … ⇒ c ∊ clam x A (⋃ B) $ by ex_elim [l4, eb1]
m1: $ … ⇒ f ⊆ clam x A (⋃ B) $ by subset_intro [ez]
m2: $ … ⇒ f ∊ cpi x A B $ by cpi_intro [m1, #2]

lemma q0_cpi_dom_sub {x: set} (G: hyps x) (A C: class) (B: class x) (f: set):
  $ G ⇒ A = C $ > $ G ⇒ f ∊ cpi x A B $ > $ G ⇒ f ∊ cpi x C B $
----
l1: $ G , u ∊ C ⇒ u ∊ C $ by ax
l2: $ G , u ∊ C ⇒ A = C $ by weaken [#1]
l3: $ … ⇒ C = A $ by eq_sym [l2]
l4: $ … ⇒ u ∊ A $ by welc_eq [l3, l1]
l5: $ G , u ∊ C ⇒ f ∊ cpi x A B $ by weaken [#2]
l6: $ … ⇒ ap f u ∈ (⟦ x / u ⟧ B) $ by cpi_elim_ap [l5, l4]
l7: $ … ⇒ u ∊ C → ap f u ∈ (⟦ x / u ⟧ B) $ by imp_intro [l6]
l8: $ … ⇒ ∀ u (u ∊ C → ap f u ∈ (⟦ x / u ⟧ B)) $ by all_intro [l7]
l9: $ ∀ x (x ∊ C → ap f x ∈ B) ⟺ ∀ u (u ∊ C → ap f u ∈ (⟦ x / u ⟧ B)) $ by all_alpha
l10: $ G ⇒ ∀ x (x ∊ C → ap f x ∈ B) ↔ ∀ u (u ∊ C → ap f u ∈ (⟦ x / u ⟧ B)) $ by weaken [l9]
l11: $ … ⇒ ∀ x (x ∊ C → ap f x ∈ B) $ by bi_elim_r [l10, l8]
l12: $ … ⇒ f ⊆ clam x A (⋃ B) $ by cpi_elim_sub [#2]
l13: $ … ⇒ clam x A (⋃ B) = clam x C (⋃ B) $ by clam_eq_dom [#1]
l14: $ … ⇒ f ⊆ clam x C (⋃ B) $ by subset_eq_r [l13, l12]
l15: $ … ⇒ f ∊ cpi x C B $ by cpi_intro [l14, l11]

cpi_eq_dom
----------
l1: $ G , f ∊ cpi x A B ⇒ A = C $ by weaken [#1]
l2: $ G , f ∊ cpi x A B ⇒ f ∊ cpi x A B $ by ax
l3: $ … ⇒ f ∊ cpi x C B $ by q0_cpi_dom_sub [l1, l2]
l4: $ … ⇒ C = A $ by eq_sym [#1]
l5: $ G , f ∊ cpi x C B ⇒ C = A $ by weaken [l4]
l6: $ G , f ∊ cpi x C B ⇒ f ∊ cpi x C B $ by ax
l7: $ … ⇒ f ∊ cpi x A B $ by q0_cpi_dom_sub [l5, l6]
l8: $ … ⇒ cpi x A B = cpi x C B $ by eq_intro [l3, l7]

lemma a0_clam_sub {x: set} (G: hyps) (A: class) (B C: class x): $ G ⇒ ∀ x (x ∊ A → B ⊆ C) $ > $ G ⇒ clam x A (⋃ B) ⊆ clam x A (⋃ C) $
----
n1: $ G , c ∊ clam x A (⋃ B) ⇒ c ∊ clam x A (⋃ B) $ by ax
n2: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ b ∊ ⋃ (⟦ x / a ⟧ B) $ by ax
n3a: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ ∀ x (x ∊ A → B ⊆ C) $ by weaken [#1]
n3b: $ … ⇒ a ∊ A → (⟦ x / a ⟧ B) ⊆ (⟦ x / a ⟧ C) $ by all_elim [n3a]
n3c: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ a ∊ A $ by ax
n3d: $ … ⇒ (⟦ x / a ⟧ B) ⊆ (⟦ x / a ⟧ C) $ by imp_elim [n3b, n3c]
n3e0: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ e ∊ (⟦ x / a ⟧ B) $ by ax
n3e: $ … ⇒ e ∊ (⟦ x / a ⟧ C) $ by subset_elim [n3d, n3e0]
n3f: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ b ∊ e $ by ax
n3: $ … ⇒ b ∊ ⋃ (⟦ x / a ⟧ C) $ by cuni_intro [n3f, n3e]
n4: $ … ⇒ b ∊ ⋃ (⟦ x / a ⟧ C) $ by cuni_elim [n2, n3]
n5a: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ a ∊ A $ by ax
n5: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ ⟨ a , b ⟩ ∈ clam x A (⋃ C) $ by clam_intro [n5a, n4]
n6: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ c = ⟨ a , b ⟩ $ by ax
n7: $ … ⇒ ⟨ a , b ⟩ = c $ by eq_sym [n6]
n8: $ … ⇒ c ∈ clam x A (⋃ C) $ by wcel_eq_l [n7, n5]
n9: $ … ⇒ c ∊ clam x A (⋃ C) $ by wcel_welc [n8]
n10: $ … ⇒ c ∊ clam x A (⋃ C) $ by clam_elim_mem [n1, n9]
n11: $ … ⇒ clam x A (⋃ B) ⊆ clam x A (⋃ C) $ by subset_intro [n10]


cpi_mono
--------
l1: $ G , f ∊ cpi x A B ⇒ f ∊ cpi x A B $ by ax
l2: $ … ⇒ f ⊆ clam x A (⋃ B) $ by cpi_elim_sub [l1]
l3a: $ … ⇒ clam x A (⋃ B) ⊆ clam x A (⋃ C) $ by a0_clam_sub [#1]
l3: $ G , f ∊ cpi x A B ⇒ clam x A (⋃ B) ⊆ clam x A (⋃ C) $ by weaken [l3a]
l4: $ … ⇒ f ⊆ clam x A (⋃ C) $ by subset_trans [l2, l3]
m0: $ G , f ∊ cpi x A B , y ∊ A ⇒ f ∊ cpi x A B $ by weaken [l1]
m0b: $ G , f ∊ cpi x A B , y ∊ A ⇒ y ∊ A $ by ax
m1: $ … ⇒ ap f y ∈ (⟦ x / y ⟧ B) $ by cpi_elim_ap [m0, m0b]
m2: $ G , f ∊ cpi x A B , y ∊ A ⇒ ∀ x (x ∊ A → B ⊆ C) $ by weaken [#1]
m3: $ … ⇒ y ∊ A → (⟦ x / y ⟧ B) ⊆ (⟦ x / y ⟧ C) $ by all_elim [m2]
m4: $ … ⇒ (⟦ x / y ⟧ B) ⊆ (⟦ x / y ⟧ C) $ by imp_elim [m3, m0b]
m5: $ … ⇒ ap f y ∈ (⟦ x / y ⟧ C) $ by wcel_subset [m4, m1]
m6: $ … ⇒ y ∊ A → ap f y ∈ (⟦ x / y ⟧ C) $ by imp_intro [m5]
m7: $ … ⇒ ∀ y (y ∊ A → ap f y ∈ (⟦ x / y ⟧ C)) $ by all_intro [m6]
m8: $ _ ⇒ ∀ x (x ∊ A → ap f x ∈ C) ↔ ∀ y (y ∊ A → ap f y ∈ (⟦ x / y ⟧ C)) $ by all_alpha
m9: $ G , f ∊ cpi x A B ⇒ ∀ x (x ∊ A → ap f x ∈ C) ↔ ∀ y (y ∊ A → ap f y ∈ (⟦ x / y ⟧ C)) $ by weaken [m8]
m10: $ … ⇒ ∀ x (x ∊ A → ap f x ∈ C) $ by bi_elim_r [m9, m7]
l6: $ … ⇒ f ∊ cpi x A C $ by cpi_intro [l4, m10]
l7: $ … ⇒ cpi x A B ⊆ cpi x A C $ by subset_intro [l6]

--| Entrywise inclusion survives a common head.

sb_c_cpi
-------
l1: $ (⟦ y / t ⟧ {g | g ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)}) ≐ {g | g ⊆ clam x (⟦ y / t ⟧ A) (⋃ (⟦ y / t ⟧ B)) ∧ ∀ x (x ∊ (⟦ y / t ⟧ A) → ap g x ∈ (⟦ y / t ⟧ B))} $ by ceqt_refl

two_intro_l
-----------
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G , k = ∅ ⇒ k = ∅ $ by ax
l3: $ … ⇒ k = ∅ ∨ k = csn ∅ $ by or_intro_l [l2]
l4: $ … ⇒ k ∊ cpr ∅ (csn ∅) $ by cpr_intro [l3]
l5: $ … ⇒ ∅ ∈ two $ by wcel_intro [l2, l4]
l6: $ … ⇒ ∅ ∈ two $ by isset_elim [l1, l5]

two_intro_r
-----------
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ … ⇒ isset (csn ∅) $ by csn_set [l1]
l3: $ G , k = csn ∅ ⇒ k = csn ∅ $ by ax
l4: $ … ⇒ k = ∅ ∨ k = csn ∅ $ by or_intro_r [l3]
l5: $ … ⇒ k ∊ cpr ∅ (csn ∅) $ by cpr_intro [l4]
l6: $ … ⇒ csn ∅ ∈ two $ by wcel_intro [l3, l5]
l7: $ … ⇒ csn ∅ ∈ two $ by isset_elim [l2, l6]

two_elim
--------
l1: $ G ⇒ a ∊ cpr ∅ (csn ∅) $ by weaken [#1]
l2: $ … ⇒ a = ∅ ∨ a = csn ∅ $ by cpr_elim [l1]

two_set
-------
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ … ⇒ isset (csn ∅) $ by csn_set [l1]
l3: $ … ⇒ isset (cpr ∅ (csn ∅)) $ by cpr_set [l1, l2]

lemma r3_pi_two_false {x: set} (G: hyps x) (A: class) (B: class x) (a: set):
  $ G ⇒ a ∊ A $ > $ G ⇒ (⟦ x / a ⟧ B) = ∅ $ > $ G ⇒ cpi x A B = ∅ $
----
l1: $ G , w ∊ cpi x A B ⇒ w ∊ cpi x A B $ by ax
l2: $ G , w ∊ cpi x A B ⇒ a ∊ A $ by weaken [#1]
l3: $ … ⇒ ap w a ∈ (⟦ x / a ⟧ B) $ by cpi_elim_ap [l1, l2]
l4: $ G , w ∊ cpi x A B ⇒ (⟦ x / a ⟧ B) = ∅ $ by weaken [#2]
l5: $ … ⇒ ap w a ∈ ∅ $ by wcel_eq_r [l4, l3]
l6: $ G , w ∊ cpi x A B , k = ap w a , k ∊ ∅ ⇒ k ∊ ∅ $ by ax
l7: $ … ⇒ ⊥ $ by empty_elim [l6]
l8: $ … ⇒ ⊥ $ by wcel_elim [l5, l7]
l9: $ … ⇒ cpi x A B = ∅ $ by empty_eq_intro [l8]

lemma r3_pi_two_true {x: set} (G: hyps x) (A: class) (B: class x):
  $ G ⇒ ∀ x (x ∊ A → B = csn ∅) $ > $ G ⇒ cpi x A B = csn ∅ $
----
l1: $ G , w ∊ cpi x A B , v ∊ w ⇒ w ∊ cpi x A B $ by ax
l2: $ … ⇒ w ⊆ clam x A (⋃ B) $ by cpi_elim_sub [l1]
l3: $ G , w ∊ cpi x A B , v ∊ w ⇒ v ∊ w $ by ax
l4: $ … ⇒ v ∊ clam x A (⋃ B) $ by subset_elim [l2, l3]
l5: $ G , w ∊ cpi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ v ∊ w $ by ax
l6: $ … ⇒ v ∈ w $ by welc_wcel [l5]
l7: $ G , w ∊ cpi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ v = ⟨ u , j ⟩ $ by ax
l8: $ … ⇒ ⟨ u , j ⟩ ∈ w $ by wcel_eq_l [l7, l6]
l9: $ … ⇒ j ∊ ap w u $ by ap_intro [l8]
l10: $ G , w ∊ cpi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ w ∊ cpi x A B $ by ax
l11: $ G , w ∊ cpi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l12: $ … ⇒ ap w u ∈ (⟦ x / u ⟧ B) $ by cpi_elim_ap [l10, l11]
l13: $ G , w ∊ cpi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) ⇒ ∀ x (x ∊ A → B = csn ∅) $ by weaken [#1]
l14: $ … ⇒ u ∊ A → (⟦ x / u ⟧ B) = csn ∅ $ by all_elim [l13]
l15: $ … ⇒ (⟦ x / u ⟧ B) = csn ∅ $ by imp_elim [l14, l11]
l16: $ … ⇒ ap w u ∈ csn ∅ $ by wcel_eq_r [l15, l12]
l17: $ G , w ∊ cpi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ k ∊ csn ∅ $ by ax
l18: $ … ⇒ k = ∅ $ by csn_elim [l17]
l19: $ G , w ∊ cpi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ k = ap w u $ by ax
l20: $ … ⇒ ap w u = k $ by eq_sym [l19]
l21: $ … ⇒ ap w u = ∅ $ by eq_trans [l20, l18]
l22: $ G , w ∊ cpi x A B , v ∊ w , v = ⟨ u , j ⟩ , u ∊ A , j ∊ ⋃ (⟦ x / u ⟧ B) , k = ap w u , k ∊ csn ∅ ⇒ j ∊ ap w u $ by weaken [l9]
l23: $ … ⇒ j ∊ ∅ $ by welc_eq [l21, l22]
l24: $ … ⇒ ⊥ $ by empty_elim [l23]
l25: $ … ⇒ ⊥ $ by wcel_elim [l16, l24]
l26: $ … ⇒ ⊥ $ by clam_elim_mem [l4, l25]
l27: $ … ⇒ w = ∅ $ by empty_eq_intro [l26]
l28: $ … ⇒ w ∊ csn ∅ $ by csn_intro [l27]
l29: $ G , w ∊ csn ∅ ⇒ w ∊ csn ∅ $ by ax
l30: $ … ⇒ w = ∅ $ by csn_elim [l29]
l31: $ … ⇒ ∅ = w $ by eq_sym [l30]
l32: $ G , w ∊ csn ∅ ⇒ ∅ ⊆ clam x A (⋃ B) $ by empty_subset
l33: $ … ⇒ w ⊆ clam x A (⋃ B) $ by subset_eq_l [l31, l32]
l34: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i ⇒ v ∊ ap w i $ by ax
l35: $ … ⇒ ⟨ i , v ⟩ ∈ w $ by ap_elim [l34]
l36: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i ⇒ w = ∅ $ by weaken [l30]
l37: $ … ⇒ ⟨ i , v ⟩ ∈ ∅ $ by wcel_eq_r [l36, l35]
l38: $ G , w ∊ csn ∅ , i ∊ A , v ∊ ap w i , k = ⟨ i , v ⟩ , k ∊ ∅ ⇒ k ∊ ∅ $ by ax
l39: $ … ⇒ ⊥ $ by empty_elim [l38]
l40: $ … ⇒ ⊥ $ by wcel_elim [l37, l39]
l41: $ … ⇒ ap w i = ∅ $ by empty_eq_intro [l40]
l42: $ G , w ∊ csn ∅ , i ∊ A ⇒ isset ∅ $ by ax_empty
l43: $ G , w ∊ csn ∅ , i ∊ A , k = ∅ ⇒ k = ∅ $ by ax
l44: $ … ⇒ k ∊ csn ∅ $ by csn_intro [l43]
l45: $ … ⇒ ∅ ∈ csn ∅ $ by wcel_intro [l43, l44]
l46: $ … ⇒ ∅ ∈ csn ∅ $ by isset_elim [l42, l45]
l47: $ … ⇒ ∅ = ap w i $ by eq_sym [l41]
l48: $ … ⇒ ap w i ∈ csn ∅ $ by wcel_eq_l [l47, l46]
l49: $ G , w ∊ csn ∅ , i ∊ A ⇒ ∀ x (x ∊ A → B = csn ∅) $ by weaken [#1]
l50: $ … ⇒ i ∊ A → (⟦ x / i ⟧ B) = csn ∅ $ by all_elim [l49]
l51: $ G , w ∊ csn ∅ , i ∊ A ⇒ i ∊ A $ by ax
l52: $ … ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by imp_elim [l50, l51]
l53: $ … ⇒ csn ∅ = (⟦ x / i ⟧ B) $ by eq_sym [l52]
l54: $ … ⇒ ap w i ∈ (⟦ x / i ⟧ B) $ by wcel_eq_r [l53, l48]
l55: $ … ⇒ i ∊ A → ap w i ∈ (⟦ x / i ⟧ B) $ by imp_intro [l54]
l56: $ … ⇒ ∀ i (i ∊ A → ap w i ∈ (⟦ x / i ⟧ B)) $ by all_intro [l55]
l57: $ (∀ x (x ∊ A → ap w x ∈ B)) ⟺ ∀ i (i ∊ A → ap w i ∈ (⟦ x / i ⟧ B)) $ by all_alpha
l58: $ G , w ∊ csn ∅ ⇒ (∀ x (x ∊ A → ap w x ∈ B)) ↔ ∀ i (i ∊ A → ap w i ∈ (⟦ x / i ⟧ B)) $ by weaken [l57]
l59: $ … ⇒ ∀ x (x ∊ A → ap w x ∈ B) $ by bi_elim_r [l58, l56]
l60: $ … ⇒ w ∊ cpi x A B $ by cpi_intro [l33, l59]
l61: $ … ⇒ cpi x A B = csn ∅ $ by eq_intro [l28, l60]

cpi_two
------
l1: $ G ⇒ (∃ x (x ∊ A ∧ B = ∅)) ∨ ¬ ∃ x (x ∊ A ∧ B = ∅) $ by excluded_middle
l2: $ G , ∃ x (x ∊ A ∧ B = ∅) ⇒ ∃ x (x ∊ A ∧ B = ∅) $ by ax
l3: $ (∃ x (x ∊ A ∧ B = ∅)) ⟺ ∃ u (u ∊ A ∧ (⟦ x / u ⟧ B) = ∅) $ by ex_alpha
l4: $ G , ∃ x (x ∊ A ∧ B = ∅) ⇒ (∃ x (x ∊ A ∧ B = ∅)) ↔ ∃ u (u ∊ A ∧ (⟦ x / u ⟧ B) = ∅) $ by weaken [l3]
l5: $ … ⇒ ∃ u (u ∊ A ∧ (⟦ x / u ⟧ B) = ∅) $ by bi_elim_l [l4, l2]
l6: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ $ by ax
l7: $ … ⇒ u ∊ A $ by and_elim_l [l6]
l8: $ … ⇒ (⟦ x / u ⟧ B) = ∅ $ by and_elim_r [l6]
l9: $ … ⇒ cpi x A B = ∅ $ by r3_pi_two_false [l7, l8]
l10: $ G , ∃ x (x ∊ A ∧ B = ∅) , u ∊ A ∧ (⟦ x / u ⟧ B) = ∅ ⇒ ∅ ∈ two $ by two_intro_l
l11: $ … ⇒ ∅ = cpi x A B $ by eq_sym [l9]
l12: $ … ⇒ cpi x A B ∈ two $ by wcel_eq_l [l11, l10]
l13: $ … ⇒ cpi x A B ∈ two $ by ex_elim [l5, l12]
l14: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A ⇒ ∀ x (x ∊ A → B ∈ two) $ by weaken [#1]
l15: $ … ⇒ i ∊ A → (⟦ x / i ⟧ B) ∈ two $ by all_elim [l14]
l16: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A ⇒ i ∊ A $ by ax
l17: $ … ⇒ (⟦ x / i ⟧ B) ∈ two $ by imp_elim [l15, l16]
l18: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two ⇒ k ∊ two $ by ax
l19: $ … ⇒ k = ∅ ∨ k = csn ∅ $ by two_elim [l18]
l20: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ k = ∅ $ by ax
l21: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ k = (⟦ x / i ⟧ B) $ by ax
l22: $ … ⇒ (⟦ x / i ⟧ B) = k $ by eq_sym [l21]
l23: $ … ⇒ (⟦ x / i ⟧ B) = ∅ $ by eq_trans [l22, l20]
l24: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ i ∊ A $ by ax
l25: $ … ⇒ i ∊ A ∧ (⟦ x / i ⟧ B) = ∅ $ by and_intro [l24, l23]
l26: $ … ⇒ ∃ x (x ∊ A ∧ B = ∅) $ by ex_intro [l25]
l27: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = ∅ ⇒ ¬ ∃ x (x ∊ A ∧ B = ∅) $ by ax
l28: $ … ⇒ ⊥ $ by not_elim [l27, l26]
l29: $ … ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by bot_elim [l28]
l30: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = csn ∅ ⇒ k = csn ∅ $ by ax
l31: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) , i ∊ A , k = (⟦ x / i ⟧ B) , k ∊ two , k = csn ∅ ⇒ k = (⟦ x / i ⟧ B) $ by ax
l32: $ … ⇒ (⟦ x / i ⟧ B) = k $ by eq_sym [l31]
l33: $ … ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by eq_trans [l32, l30]
l34: $ … ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by or_elim [l19, l29, l33]
l35: $ … ⇒ (⟦ x / i ⟧ B) = csn ∅ $ by wcel_elim [l17, l34]
l36: $ … ⇒ i ∊ A → (⟦ x / i ⟧ B) = csn ∅ $ by imp_intro [l35]
l37: $ … ⇒ ∀ i (i ∊ A → (⟦ x / i ⟧ B) = csn ∅) $ by all_intro [l36]
l38: $ (∀ x (x ∊ A → B = csn ∅)) ⟺ ∀ i (i ∊ A → (⟦ x / i ⟧ B) = csn ∅) $ by all_alpha
l39: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ (∀ x (x ∊ A → B = csn ∅)) ↔ ∀ i (i ∊ A → (⟦ x / i ⟧ B) = csn ∅) $ by weaken [l38]
l40: $ … ⇒ ∀ x (x ∊ A → B = csn ∅) $ by bi_elim_r [l39, l37]
l41: $ … ⇒ cpi x A B = csn ∅ $ by r3_pi_two_true [l40]
l42: $ G , ¬ ∃ x (x ∊ A ∧ B = ∅) ⇒ csn ∅ ∈ two $ by two_intro_r
l43: $ … ⇒ csn ∅ = cpi x A B $ by eq_sym [l41]
l44: $ … ⇒ cpi x A B ∈ two $ by wcel_eq_l [l43, l42]
l45: $ … ⇒ cpi x A B ∈ two $ by or_elim [l1, l13, l44]

cpi_two_true
-----------
l1: $ … ⇒ cpi x A B = csn ∅ $ by r3_pi_two_true [#1]

cpi_two_false
------------
l1: $ … ⇒ cpi x A B = ∅ $ by r3_pi_two_false [#1, #2]
