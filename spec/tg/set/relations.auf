l8: $ G , z ∊ ccom S U ⇒ S = R $ by weaken [l5]
l9: $ G , z ∊ ccom S U ⇒ U = T $ by weaken [l6]
l10: $ … ⇒ z ∊ ccom R T $ by welc_ccom_eq [l8, l9, l7]
l11: $ … ⇒ ccom R T = ccom S U $ by eq_intro [l4, l10]

sb_c_ccom
---------
l1: $ (⟦ x / t ⟧ {w | ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ ∃ y (⟨ u , y ⟩ ∈ S ∧ ⟨ y , v ⟩ ∈ R))}) ≐ {w | ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ ∃ y (⟨ u , y ⟩ ∈ (⟦ x / t ⟧ S) ∧ ⟨ y , v ⟩ ∈ (⟦ x / t ⟧ R)))} $ by ceqt_refl

cres_intro
----------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ … ⇒ isset ⟨ a , b ⟩ $ by opair_set [l1, l2]
l4: $ G , u = ⟨ a , b ⟩ ⇒ u = ⟨ a , b ⟩ $ by ax
l5: $ G , u = ⟨ a , b ⟩ ⇒ a ∊ A $ by weaken [#1]
l6: $ G , u = ⟨ a , b ⟩ ⇒ ⟨ a , b ⟩ ∈ R $ by weaken [#2]
l7: $ … ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by and_intro [l5, l6]
l8: $ … ⇒ u = ⟨ a , b ⟩ ∧ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by and_intro [l4, l7]
l9: $ … ⇒ ∃ y (u = ⟨ a , y ⟩ ∧ a ∊ A ∧ ⟨ a , y ⟩ ∈ R) $ by ex_intro [l8]
l10: $ … ⇒ ∃ x ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by ex_intro [l9]
l11: $ … ⇒ u ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R)} $ by cab_intro [l10]
l12: $ … ⇒ ⟨ a , b ⟩ ∈ cres R A $ by wcel_intro [l4, l11]
l13: $ … ⇒ ⟨ a , b ⟩ ∈ cres R A $ by isset_elim [l3, l12]

cres_elim
---------
l1: $ u = ⟨ a , b ⟩ , u ∊ cres R A ⇒ u ∊ cres R A $ by ax
l2: $ … ⇒ ∃ x ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by cab_elim [l1]
l3: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by ax
l4: $ … ⇒ u = ⟨ x , y ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ x ∊ A ∧ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l3]
l6: $ … ⇒ x ∊ A $ by and_elim_l [l5]
l7: $ … ⇒ ⟨ x , y ⟩ ∈ R $ by and_elim_r [l5]
l8: $ u = ⟨ a , b ⟩ , u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R ⇒ u = ⟨ a , b ⟩ $ by ax
l9: $ … ⇒ ⟨ x , y ⟩ = u $ by eq_sym [l4]
l10: $ … ⇒ ⟨ x , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [l9, l8]
l11: $ … ⇒ x = a $ by opair_inj_l [l10]
l12: $ … ⇒ a ∊ A $ by welc_eq_set [l11, l6]
l13: $ … ⇒ ⟨ a , b ⟩ ∈ R $ by wcel_eq_l [l10, l7]
l14: $ … ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by and_intro [l12, l13]
l15: $ u = ⟨ a , b ⟩ , ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (u = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l16: $ … ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by ex_elim [l15, l14]
l17: $ … ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by ex_elim [l2, l16]
l18: $ … ⇒ a ∊ A ∧ ⟨ a , b ⟩ ∈ R $ by wcel_elim [#1, l17]

cres_rel
--------
