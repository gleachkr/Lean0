l5: $ … ⇒ ∃ v (z = ⟨ x , v ⟩) $ by ex_intro [l4]
l6: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_intro [l5]
l7: $ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) ⇒ ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ ⟨ x , y ⟩ ∈ R) $ by ax
l8: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_elim [l7, l6]
l9: $ … ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by ex_elim [l2, l8]
l10: $ G , z ∊ cres R A ⇒ ∃ u ∃ v (z = ⟨ u , v ⟩) $ by weaken [l9]
l11: $ … ⇒ rel (cres R A) $ by rel_intro [l10]

cres_subset
-----------
