l7: $ ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ C) ⟺ ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ B ∧ v ∊ D) $ by ex_congr [l6]
l8: $ ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ C) ⟺ ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ B ∧ v ∊ D) $ by ex_congr [l7]
l9: $ {w | ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ C)} ≐ {w | ∃ u ∃ v (w = ⟨ u , v ⟩ ∧ u ∊ B ∧ v ∊ D)} $ by cab_congr [l8]

