fn_into_cres
------------
l1: $ … ⇒ functional F $ by fn_into_functional [#1]
l2: $ … ⇒ functional (cres F A) $ by functional_cres [l1]
l3: $ G , u ∊ A ⇒ fn_into F A B $ by weaken [#1]
l4: $ G , u ∊ A ⇒ u ∊ A $ by ax
l5: $ G , u ∊ A , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ v ∊ B $ by ax
l6: $ G , u ∊ A , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ ⟨ u , v ⟩ ∈ F $ by ax
l7: $ G , u ∊ A , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ u ∊ A $ by ax
l8: $ … ⇒ ⟨ u , v ⟩ ∈ cres F A $ by cres_intro [l7, l6]
l9: $ … ⇒ v ∊ B ∧ ⟨ u , v ⟩ ∈ cres F A $ by and_intro [l5, l8]
l10: $ … ⇒ ∃ y (y ∊ B ∧ ⟨ u , y ⟩ ∈ cres F A) $ by ex_intro [l9]
l11: $ … ⇒ ∃ y (y ∊ B ∧ ⟨ u , y ⟩ ∈ cres F A) $ by fn_into_elim [l3, l4, l10]
l12: $ … ⇒ fn_into (cres F A) A B $ by fn_into_intro [l2, l11]

fn_into_subset_cod
------------------
l1: $ … ⇒ functional F $ by fn_into_functional [#1]
l2: $ G , x ∊ A ⇒ fn_into F A B $ by weaken [#1]
l3: $ G , x ∊ A ⇒ x ∊ A $ by ax
l4: $ G , x ∊ A , v ∊ B , ⟨ x , v ⟩ ∈ F ⇒ v ∊ B $ by ax
l5: $ G , x ∊ A , v ∊ B , ⟨ x , v ⟩ ∈ F ⇒ B ⊆ C $ by weaken [#2]
l6: $ … ⇒ v ∊ C $ by subset_elim [l5, l4]
l7: $ G , x ∊ A , v ∊ B , ⟨ x , v ⟩ ∈ F ⇒ ⟨ x , v ⟩ ∈ F $ by ax
l8: $ … ⇒ v ∊ C ∧ ⟨ x , v ⟩ ∈ F $ by and_intro [l6, l7]
l9: $ … ⇒ ∃ y (y ∊ C ∧ ⟨ x , y ⟩ ∈ F) $ by ex_intro [l8]
l10: $ … ⇒ ∃ y (y ∊ C ∧ ⟨ x , y ⟩ ∈ F) $ by fn_into_elim [l2, l3, l9]
l11: $ … ⇒ fn_into F A C $ by fn_into_intro [l1, l10]

ap_intro
--------
l1: $ … ⇒ b ∊ {y | ⟨ A , y ⟩ ∈ F} $ by cab_intro [#1]

ap_elim
-------
l1: $ G ⇒ b ∊ {y | ⟨ A , y ⟩ ∈ F} $ by weaken [#1]
l2: $ … ⇒ ⟨ A , b ⟩ ∈ F $ by cab_elim [l1]

ap_subset_crn
-------------
l1: $ G , z ∊ ap F a ⇒ z ∊ ap F a $ by ax
l2: $ … ⇒ ⟨ a , z ⟩ ∈ F $ by ap_elim [l1]
l3: $ … ⇒ z ∊ crn F $ by crn_intro [l2]
l4: $ … ⇒ ap F a ⊆ crn F $ by subset_intro [l3]

ap_set
------
l1: $ … ⇒ isset (crn F) $ by crn_set [#1]
l2: $ G ⇒ ap F a ⊆ crn F $ by ap_subset_crn
l3: $ … ⇒ isset (ap F a) $ by subset_isset [l1, l2]

ap_functional_set
-----------------
l1: $ G ⇒ (∃ y (⟨ a , y ⟩ ∈ F)) ∨ ¬ (∃ y (⟨ a , y ⟩ ∈ F)) $ by excluded_middle
l2: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ z ∊ ap F a $ by ax
l3: $ … ⇒ ⟨ a , z ⟩ ∈ F $ by ap_elim [l2]
l4: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ ⟨ a , y ⟩ ∈ F $ by ax
l5: $ G , ⟨ a , y ⟩ ∈ F , z ∊ ap F a ⇒ functional F $ by weaken [#1]
l6: $ … ⇒ y = z $ by functional_elim [l5, l4, l3]
l7: $ … ⇒ z = y $ by eq_sym [l6]
l8: $ … ⇒ z ∊ csn y $ by csn_intro [l7]
l9: $ … ⇒ ap F a ⊆ csn y $ by subset_intro [l8]
l10: $ G , ⟨ a , y ⟩ ∈ F ⇒ isset y $ by isset_var
l11: $ … ⇒ isset (csn y) $ by csn_set [l10]
l12: $ … ⇒ isset (ap F a) $ by subset_isset [l11, l9]
l13: $ G , ∃ y (⟨ a , y ⟩ ∈ F) ⇒ ∃ y (⟨ a , y ⟩ ∈ F) $ by ax
l14: $ … ⇒ isset (ap F a) $ by ex_elim [l13, l12]
l15: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) , z ∊ ap F a ⇒ z ∊ ap F a $ by ax
l16: $ … ⇒ ⟨ a , z ⟩ ∈ F $ by ap_elim [l15]
l17: $ … ⇒ ∃ y (⟨ a , y ⟩ ∈ F) $ by ex_intro [l16]
l18: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) , z ∊ ap F a ⇒ ¬ (∃ y (⟨ a , y ⟩ ∈ F)) $ by ax
l19: $ … ⇒ ⊥ $ by not_elim [l18, l17]
l20: $ … ⇒ ap F a = ∅ $ by empty_eq_intro [l19]
l21: $ … ⇒ ∅ = ap F a $ by eq_sym [l20]
l22: $ G , ¬ (∃ y (⟨ a , y ⟩ ∈ F)) ⇒ isset ∅ $ by ax_empty
l23: $ … ⇒ isset (ap F a) $ by isset_eq [l21, l22]
l24: $ … ⇒ isset (ap F a) $ by or_elim [l1, l14, l23]

ap_set_c
--------
l1: $ G , y ∊ ap F A ⇒ y ∊ ap F A $ by ax
l2: $ … ⇒ ⟨ A , y ⟩ ∈ F $ by ap_elim [l1]
l3: $ G , y ∊ ap F A ⇒ isset (cpr A y) $ by cpr_isset
l4: $ … ⇒ cpr A y ∈ ⟨ A , y ⟩ $ by cpr_intro_r_c [l3]
l5: $ G , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F ⇒ x = ⟨ A , y ⟩ $ by ax
l6: $ … ⇒ ⟨ A , y ⟩ = x $ by eq_sym [l5]
l7: $ G , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F ⇒ cpr A y ∈ ⟨ A , y ⟩ $ by weaken [l4]
l8: $ … ⇒ cpr A y ∈ x $ by wcel_eq_r [l6, l7]
l9: $ G , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , c = cpr A y , c ∊ x ⇒ c ∊ x $ by ax
l10: $ G , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , c = cpr A y , c ∊ x ⇒ x ∊ F $ by ax
l11: $ … ⇒ c ∊ ⋃ F $ by cuni_intro [l9, l10]
l12: $ G , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , c = cpr A y , c ∊ x ⇒ y = y $ by eq_refl
l13: $ … ⇒ y = A ∨ y = y $ by or_intro_r [l12]
l14: $ … ⇒ y ∊ cpr A y $ by cpr_intro [l13]
l15: $ G , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , c = cpr A y , c ∊ x ⇒ c = cpr A y $ by ax
l16: $ … ⇒ cpr A y = c $ by eq_sym [l15]
l17: $ … ⇒ y ∊ c $ by welc_eq [l16, l14]
l18: $ … ⇒ y ∊ ⋃ ⋃ F $ by cuni_intro [l17, l11]
l19: $ … ⇒ y ∊ ⋃ ⋃ F $ by wcel_elim [l8, l18]
l20: $ … ⇒ y ∊ ⋃ ⋃ F $ by wcel_elim [l2, l19]
l21: $ … ⇒ ap F A ⊆ ⋃ ⋃ F $ by subset_intro [l20]
l22: $ … ⇒ isset (⋃ F) $ by cuni_set [#1]
l23: $ … ⇒ isset (⋃ ⋃ F) $ by cuni_set [l22]
l24: $ … ⇒ isset (ap F A) $ by subset_isset [l23, l21]

ap_empty
--------
l1: $ G , y ∊ ap ∅ A ⇒ y ∊ ap ∅ A $ by ax
l2: $ … ⇒ ⟨ A , y ⟩ ∈ ∅ $ by ap_elim [l1]
l3: $ G , y ∊ ap ∅ A , c = ⟨ A , y ⟩ , c ∊ ∅ ⇒ c ∊ ∅ $ by ax
l4: $ … ⇒ ⊥ $ by empty_elim [l3]
l5: $ … ⇒ ⊥ $ by wcel_elim [l2, l4]
l6: $ … ⇒ ap ∅ A = ∅ $ by empty_eq_intro [l5]

ap_wcel
-------
a1: $ G , v = A , ⟨ a , A ⟩ ∈ F ⇒ ⟨ a , A ⟩ ∈ F $ by ax
a2: $ G , v = A , ⟨ a , A ⟩ ∈ F ⇒ v = A $ by ax
a3: $ … ⇒ A = v $ by eq_sym [a2]
a4: $ G , v = A , ⟨ a , A ⟩ ∈ F ⇒ a = a $ by eq_refl
a5: $ … ⇒ ⟨ a , A ⟩ = ⟨ a , v ⟩ $ by opair_eq [a4, a3]
a6: $ … ⇒ ⟨ a , v ⟩ ∈ F $ by wcel_eq_l [a5, a1]
a7: $ … ⇒ v ∊ ap F a $ by ap_intro [a6]
a8: $ … ⇒ v ∈ ap F a $ by welc_wcel [a7]
a9: $ … ⇒ A ∈ ap F a $ by wcel_eq_l [a2, a8]
c1: $ G , v = A , A ∈ ap F a ⇒ A ∈ ap F a $ by ax
c2: $ G , v = A , A ∈ ap F a ⇒ v = A $ by ax
c3: $ … ⇒ A = v $ by eq_sym [c2]
c4: $ … ⇒ v ∈ ap F a $ by wcel_eq_l [c3, c1]
c5: $ … ⇒ v ∊ ap F a $ by wcel_welc [c4]
c6: $ … ⇒ ⟨ a , v ⟩ ∈ F $ by ap_elim [c5]
c7: $ G , v = A , A ∈ ap F a ⇒ a = a $ by eq_refl
c8: $ … ⇒ ⟨ a , v ⟩ = ⟨ a , A ⟩ $ by opair_eq [c7, c2]
c9: $ … ⇒ ⟨ a , A ⟩ ∈ F $ by wcel_eq_l [c8, c6]
d1: $ … ⇒ ⟨ a , A ⟩ ∈ F ↔ A ∈ ap F a $ by bi_intro [a9, c9]
d2: $ … ⇒ ⟨ a , A ⟩ ∈ F ↔ A ∈ ap F a $ by isset_elim [#1, d1]

ap_mono
-------
l1: $ G , z ∊ ap F A ⇒ z ∊ ap F A $ by ax
l2: $ … ⇒ ⟨ A , z ⟩ ∈ F $ by ap_elim [l1]
l3: $ G , z ∊ ap F A ⇒ F ⊆ H $ by weaken [#1]
l4: $ … ⇒ ⟨ A , z ⟩ ∈ H $ by wcel_subset [l3, l2]
l5: $ … ⇒ z ∊ ap H A $ by ap_intro [l4]
l6: $ … ⇒ ap F A ⊆ ap H A $ by subset_intro [l5]

ap_congr
--------
l0: $ cv y ≐ cv y $ by ceqt_refl
l1: $ ⟨ A , y ⟩ ≐ ⟨ B , y ⟩ $ by opair_congr [#2, l0]
l2: $ (⟨ A , y ⟩ ∈ F) ⟺ (⟨ B , y ⟩ ∈ H) $ by wcel_congr [l1, #1]
l3: $ {y | ⟨ A , y ⟩ ∈ F} ≐ {y | ⟨ B , y ⟩ ∈ H} $ by cab_congr [l2]

welc_ap_eq
----------
l1: $ … ⇒ ⟨ A , b ⟩ ∈ F $ by ap_elim [#3]
l2: $ G ⇒ b = b $ by eq_refl
l3: $ … ⇒ ⟨ A , b ⟩ = ⟨ B , b ⟩ $ by opair_eq [#2, l2]
l4: $ … ⇒ ⟨ B , b ⟩ ∈ F $ by wcel_eq_l [l3, l1]
l5: $ … ⇒ ⟨ B , b ⟩ ∈ H $ by wcel_eq_r [#1, l4]
l6: $ … ⇒ b ∊ ap H B $ by ap_intro [l5]

ap_eq
-----
l1: $ G , z ∊ ap F A ⇒ z ∊ ap F A $ by ax
l2: $ G , z ∊ ap F A ⇒ F = H $ by weaken [#1]
l3: $ G , z ∊ ap F A ⇒ A = B $ by weaken [#2]
l4: $ … ⇒ z ∊ ap H B $ by welc_ap_eq [l2, l3, l1]
l5: $ … ⇒ H = F $ by eq_sym [#1]
l6: $ … ⇒ B = A $ by eq_sym [#2]
l7: $ G , z ∊ ap H B ⇒ z ∊ ap H B $ by ax
l8: $ G , z ∊ ap H B ⇒ H = F $ by weaken [l5]
l9: $ G , z ∊ ap H B ⇒ B = A $ by weaken [l6]
l10: $ … ⇒ z ∊ ap F A $ by welc_ap_eq [l8, l9, l7]
l11: $ … ⇒ ap F A = ap H B $ by eq_intro [l4, l10]

sb_c_ap
-------
l1: $ (⟦ x / t ⟧ {y | ⟨ A , y ⟩ ∈ F}) ≐ {y | ⟨ ⟦ x / t ⟧ A , y ⟩ ∈ (⟦ x / t ⟧ F)} $ by ceqt_refl

clam_intro
---------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ … ⇒ isset ⟨ a , b ⟩ $ by opair_set [l1, l2]
l4: $ G , k = ⟨ a , b ⟩ ⇒ k = ⟨ a , b ⟩ $ by ax
l5: $ G , k = ⟨ a , b ⟩ ⇒ a ∊ A $ by weaken [#1]
l6: $ G , k = ⟨ a , b ⟩ ⇒ b ∊ (⟦ x / a ⟧ B) $ by weaken [#2]
l7: $ … ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by and_intro [l5, l6]
l8: $ … ⇒ k = ⟨ a , b ⟩ ∧ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by and_intro [l4, l7]
l9: $ … ⇒ ∃ y (k = ⟨ a , y ⟩ ∧ a ∊ A ∧ y ∊ (⟦ x / a ⟧ B)) $ by ex_intro [l8]
l10: $ … ⇒ ∃ x ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $ by ex_intro [l9]
l11: $ … ⇒ k ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)} $ by cab_intro [l10]
l12: $ … ⇒ ⟨ a , b ⟩ ∈ clam x A B $ by wcel_intro [l4, l11]
l13: $ … ⇒ ⟨ a , b ⟩ ∈ clam x A B $ by isset_elim [l3, l12]

clam_elim
--------
l1: $ G , k = ⟨ a , b ⟩ , k ∊ clam x A B ⇒ k ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)} $ by ax
l2: $ … ⇒ ∃ x ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $ by cab_elim [l1]
l2a: $ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ⟺ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by ex_alpha
l2b: $ G , k = ⟨ a , b ⟩ , k ∊ clam x A B ⇒ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ↔ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by weaken [l2a]
l2c: $ … ⇒ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by bi_elim_l [l2b, l2]
l3: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) $ by ax
l4: $ … ⇒ k = ⟨ u , y ⟩ $ by and_elim_l [l3]
l5: $ … ⇒ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) $ by and_elim_r [l3]
l6: $ … ⇒ u ∊ A $ by and_elim_l [l5]
l7: $ … ⇒ y ∊ (⟦ x / u ⟧ B) $ by and_elim_r [l5]
l8: $ k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B) ⇒ k = ⟨ a , b ⟩ $ by ax
l9: $ … ⇒ ⟨ u , y ⟩ = k $ by eq_sym [l4]
l10: $ … ⇒ ⟨ u , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [l9, l8]
l11: $ … ⇒ u = a $ by opair_inj_l [l10]
l12: $ … ⇒ y = b $ by opair_inj_r [l10]
l13: $ … ⇒ a ∊ A $ by welc_eq_set [l11, l6]
l14: $ … ⇒ u ∊ {x | y ∊ B} $ by cab_intro [l7]
l15: $ … ⇒ a ∊ {x | y ∊ B} $ by welc_eq_set [l11, l14]
l16: $ … ⇒ y ∊ (⟦ x / a ⟧ B) $ by cab_elim [l15]
l17: $ … ⇒ b ∊ (⟦ x / a ⟧ B) $ by welc_eq_set [l12, l16]
l18: $ … ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by and_intro [l13, l17]
l19a: $ k = ⟨ a , b ⟩ , ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ ∃ y (k = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by ax
l19: $ … ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by ex_elim [l19a, l18]
l20: $ … ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by ex_elim [l2c, l19]
l21: $ … ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by wcel_elim [#1, l20]

--| Elimination of membership in a trace: a member is a pair `⟨ u , v ⟩` with
--| `u ∊ A` and `v ∊ ⟦ x / u ⟧ B`.
clam_elim_mem
------------
l1: $ G ⇒ c ∊ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)} $ by weaken [#1]
l2: $ … ⇒ ∃ x ∃ y (c = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) $ by cab_elim [l1]
l3: $ (∃ x ∃ y (c = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ⟺ ∃ u ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by ex_alpha
l4: $ G ⇒ (∃ x ∃ y (c = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ↔ ∃ u ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by weaken [l3]
l5: $ … ⇒ ∃ u ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by bi_elim_l [l4, l2]
l6: $ (∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B))) ⟺ ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B)) $ by ex_alpha
l7: $ H , ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) $ by ax
l8: $ H , ∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B)) ⇒ (∃ y (c = ⟨ u , y ⟩ ∧ u ∊ A ∧ y ∊ (⟦ x / u ⟧ B))) ↔ ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B)) $ by weaken [l6]
l9: $ … ⇒ ∃ v (c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B)) $ by bi_elim_l [l8, l7]
l10: $ … ⇒ v ∊ (⟦ x / u ⟧ B) → d $ by imp_intro [#2]
l11: $ … ⇒ u ∊ A → v ∊ (⟦ x / u ⟧ B) → d $ by imp_intro [l10]
l12: $ … ⇒ c = ⟨ u , v ⟩ → u ∊ A → v ∊ (⟦ x / u ⟧ B) → d $ by imp_intro [l11]
l13: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) $ by ax
l14: $ … ⇒ c = ⟨ u , v ⟩ $ by and_elim_l [l13]
l15: $ … ⇒ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) $ by and_elim_r [l13]
l16: $ … ⇒ u ∊ A $ by and_elim_l [l15]
l17: $ … ⇒ v ∊ (⟦ x / u ⟧ B) $ by and_elim_r [l15]
l18: $ H , c = ⟨ u , v ⟩ ∧ u ∊ A ∧ v ∊ (⟦ x / u ⟧ B) ⇒ c = ⟨ u , v ⟩ → u ∊ A → v ∊ (⟦ x / u ⟧ B) → d $ by weaken [l12]
l19: $ … ⇒ u ∊ A → v ∊ (⟦ x / u ⟧ B) → d $ by imp_elim [l18, l14]
l20: $ … ⇒ v ∊ (⟦ x / u ⟧ B) → d $ by imp_elim [l19, l16]
l21: $ … ⇒ d $ by imp_elim [l20, l17]
l22: $ … ⇒ d $ by ex_elim [l9, l21]
l23: $ … ⇒ d $ by ex_elim [l5, l22]

clam_rel
-------
l1: $ G , k ∊ clam x A B ⇒ k ∊ clam x A B $ by ax
l2: $ G , k ∊ clam x A B , k = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ k = ⟨ u , v ⟩ $ by ax
l3: $ … ⇒ ∃ j (k = ⟨ u , j ⟩) $ by ex_intro [l2]
l4: $ … ⇒ ∃ i ∃ j (k = ⟨ i , j ⟩) $ by ex_intro [l3]
l5: $ … ⇒ ∃ i ∃ j (k = ⟨ i , j ⟩) $ by clam_elim_mem [l1, l4]
l6: $ … ⇒ rel (clam x A B) $ by rel_intro [l5]

clam_cdm
-------
l1: $ G , w ∊ cdm (clam x A B) ⇒ w ∊ cdm (clam x A B) $ by ax
l2: $ G , w ∊ cdm (clam x A B) , ⟨ w , v ⟩ ∈ clam x A B ⇒ ⟨ w , v ⟩ ∈ clam x A B $ by ax
l3: $ … ⇒ w ∊ A ∧ v ∊ (⟦ x / w ⟧ B) $ by clam_elim [l2]
l4: $ … ⇒ w ∊ A $ by and_elim_l [l3]
l5: $ … ⇒ w ∊ A $ by cdm_elim [l1, l4]
l6: $ … ⇒ cdm (clam x A B) ⊆ A $ by subset_intro [l5]

clam_ap
------
l1: $ G , w ∊ ap (clam x A B) a ⇒ w ∊ ap (clam x A B) a $ by ax
l2: $ … ⇒ ⟨ a , w ⟩ ∈ clam x A B $ by ap_elim [l1]
l3: $ … ⇒ a ∊ A ∧ w ∊ (⟦ x / a ⟧ B) $ by clam_elim [l2]
l4: $ … ⇒ w ∊ (⟦ x / a ⟧ B) $ by and_elim_r [l3]
l5: $ G , w ∊ (⟦ x / a ⟧ B) ⇒ w ∊ (⟦ x / a ⟧ B) $ by ax
l6: $ G , w ∊ (⟦ x / a ⟧ B) ⇒ a ∊ A $ by weaken [#1]
l7: $ … ⇒ ⟨ a , w ⟩ ∈ clam x A B $ by clam_intro [l6, l5]
l8: $ … ⇒ w ∊ ap (clam x A B) a $ by ap_intro [l7]
l9: $ … ⇒ ap (clam x A B) a = (⟦ x / a ⟧ B) $ by eq_intro [l4, l8]

--| The graph of the operation `x ↦ B`: replacement along it bounds a trace.
def r3_gr {x: set} (B: class x) (.w .y: set): class = $ {w | ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B)} $

lemma r3_gr_intro {x: set} (G: hyps x) (B: class x) (a b: set):
  $ G ⇒ b = (⟦ x / a ⟧ B) $ > $ G ⇒ ⟨ a , b ⟩ ∈ r3_gr x B $
----
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ … ⇒ isset ⟨ a , b ⟩ $ by opair_set [l1, l2]
l4: $ G , k = ⟨ a , b ⟩ ⇒ k = ⟨ a , b ⟩ $ by ax
l5: $ G , k = ⟨ a , b ⟩ ⇒ b = (⟦ x / a ⟧ B) $ by weaken [#1]
l6: $ … ⇒ k = ⟨ a , b ⟩ ∧ b = (⟦ x / a ⟧ B) $ by and_intro [l4, l5]
l7: $ … ⇒ ∃ y (k = ⟨ a , y ⟩ ∧ y = (⟦ x / a ⟧ B)) $ by ex_intro [l6]
l8: $ … ⇒ ∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B) $ by ex_intro [l7]
l9: $ … ⇒ k ∊ {w | ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B)} $ by cab_intro [l8]
l10: $ … ⇒ ⟨ a , b ⟩ ∈ r3_gr x B $ by wcel_intro [l4, l9]
l11: $ … ⇒ ⟨ a , b ⟩ ∈ r3_gr x B $ by isset_elim [l3, l10]

lemma r3_gr_elim {x: set} (G: hyps x) (B: class x) (a b: set):
  $ G ⇒ ⟨ a , b ⟩ ∈ r3_gr x B $ > $ G ⇒ b = (⟦ x / a ⟧ B) $
----
l1: $ G , k = ⟨ a , b ⟩ , k ∊ r3_gr x B ⇒ k ∊ {w | ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B)} $ by ax
l2: $ … ⇒ ∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B) $ by cab_elim [l1]
l3: $ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B)) ⟺ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by ex_alpha
l4: $ G , k = ⟨ a , b ⟩ , k ∊ r3_gr x B ⇒ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B)) ↔ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by weaken [l3]
l5: $ … ⇒ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by bi_elim_l [l4, l2]
l6: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) $ by ax
l7: $ … ⇒ k = ⟨ u , y ⟩ $ by and_elim_l [l6]
l8: $ … ⇒ y = (⟦ x / u ⟧ B) $ by and_elim_r [l6]
l9: $ G , k = ⟨ a , b ⟩ , k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ k = ⟨ a , b ⟩ $ by ax
l10: $ … ⇒ ⟨ a , b ⟩ = k $ by eq_sym [l9]
l11: $ … ⇒ ⟨ a , b ⟩ = ⟨ u , y ⟩ $ by eq_trans [l10, l7]
l12: $ … ⇒ a = u $ by opair_inj_l [l11]
l13: $ … ⇒ b = y $ by opair_inj_r [l11]
l14: $ … ⇒ u = a $ by eq_sym [l12]
l15: $ … ⇒ (⟦ x / u ⟧ B) = (⟦ x / a ⟧ B) $ by sb_c_eq [l14]
l16: $ … ⇒ b = (⟦ x / u ⟧ B) $ by eq_trans [l13, l8]
l17: $ … ⇒ b = (⟦ x / a ⟧ B) $ by eq_trans [l16, l15]
l18: $ G , k = ⟨ a , b ⟩ , ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) ⇒ ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by ax
l19: $ … ⇒ b = (⟦ x / a ⟧ B) $ by ex_elim [l18, l17]
l20: $ … ⇒ b = (⟦ x / a ⟧ B) $ by ex_elim [l5, l19]
l21: $ … ⇒ b = (⟦ x / a ⟧ B) $ by wcel_elim [#1, l20]

lemma r3_gr_fun {x: set} (G: hyps x) (B: class x): $ G ⇒ functional (r3_gr x B) $
----
l1: $ G , ⟨ i , j ⟩ ∈ r3_gr x B , ⟨ i , c ⟩ ∈ r3_gr x B ⇒ ⟨ i , j ⟩ ∈ r3_gr x B $ by ax
l2: $ G , ⟨ i , j ⟩ ∈ r3_gr x B , ⟨ i , c ⟩ ∈ r3_gr x B ⇒ ⟨ i , c ⟩ ∈ r3_gr x B $ by ax
l3: $ … ⇒ j = (⟦ x / i ⟧ B) $ by r3_gr_elim [l1]
l4: $ … ⇒ c = (⟦ x / i ⟧ B) $ by r3_gr_elim [l2]
l5: $ … ⇒ (⟦ x / i ⟧ B) = c $ by eq_sym [l4]
l6: $ … ⇒ j = c $ by eq_trans [l3, l5]
l7: $ … ⇒ functional (r3_gr x B) $ by functional_intro [l6]

clam_set
-------
l1: $ G ⇒ functional (r3_gr x B) $ by r3_gr_fun
l2: $ … ⇒ isset (img (r3_gr x B) A) $ by img_set [l1, #1]
l3: $ … ⇒ isset (⋃ (img (r3_gr x B) A)) $ by cuni_set [l2]
l4: $ … ⇒ isset (A × ⋃ (img (r3_gr x B) A)) $ by cxp_set [#1, l3]
l5: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ ∀ x (x ∊ A → isset B) $ by weaken [#2]
l6: $ … ⇒ u ∊ A → isset (⟦ x / u ⟧ B) $ by all_elim [l5]
l7: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l8: $ … ⇒ isset (⟦ x / u ⟧ B) $ by imp_elim [l6, l7]
l9: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ j = (⟦ x / u ⟧ B) $ by ax
l10: $ … ⇒ (⟦ x / u ⟧ B) = j $ by eq_sym [l9]
l11: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ B) $ by ax
l12: $ … ⇒ v ∊ j $ by welc_eq [l10, l11]
l13: $ … ⇒ ⟨ u , j ⟩ ∈ r3_gr x B $ by r3_gr_intro [l9]
l14: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l15: $ … ⇒ j ∊ img (r3_gr x B) A $ by img_intro [l14, l13]
l16: $ … ⇒ v ∊ ⋃ (img (r3_gr x B) A) $ by cuni_intro [l12, l15]
l17: $ … ⇒ ⟨ u , v ⟩ ∈ A × ⋃ (img (r3_gr x B) A) $ by cxp_intro [l14, l16]
l18: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) , j = (⟦ x / u ⟧ B) ⇒ w = ⟨ u , v ⟩ $ by ax
l19: $ … ⇒ ⟨ u , v ⟩ = w $ by eq_sym [l18]
l20: $ … ⇒ w ∈ A × ⋃ (img (r3_gr x B) A) $ by wcel_eq_l [l19, l17]
l21: $ … ⇒ w ∊ A × ⋃ (img (r3_gr x B) A) $ by wcel_welc [l20]
l22: $ … ⇒ w ∊ A × ⋃ (img (r3_gr x B) A) $ by isset_elim [l8, l21]
l23: $ G , w ∊ clam x A B ⇒ w ∊ clam x A B $ by ax
l24: $ … ⇒ w ∊ A × ⋃ (img (r3_gr x B) A) $ by clam_elim_mem [l23, l22]
l25: $ … ⇒ clam x A B ⊆ A × ⋃ (img (r3_gr x B) A) $ by subset_intro [l24]
l26: $ … ⇒ isset (clam x A B) $ by subset_isset [l4, l25]

clam_congr
---------
l0: $ seqt x x $ by seqt_refl
l1: $ seqt y y $ by seqt_refl
l2: $ (x ∊ A) ⟺ (x ∊ C) $ by welc_congr [l0, #1]
l3: $ (y ∊ B) ⟺ (y ∊ D) $ by welc_congr [l1, #2]
l4: $ (x ∊ A ∧ y ∊ B) ⟺ (x ∊ C ∧ y ∊ D) $ by and_congr [l2, l3]
l5: $ (z = ⟨ x , y ⟩) ⟺ (z = ⟨ x , y ⟩) $ by iff_refl
l6: $ (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B) ⟺ (z = ⟨ x , y ⟩ ∧ x ∊ C ∧ y ∊ D) $ by and_congr [l5, l4]
l7: $ (∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ⟺ (∃ y (z = ⟨ x , y ⟩ ∧ x ∊ C ∧ y ∊ D)) $ by ex_congr [l6]
l8: $ (∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)) ⟺ (∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ C ∧ y ∊ D)) $ by ex_congr [l7]
l9: $ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ A ∧ y ∊ B)} ≐ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ C ∧ y ∊ D)} $ by cab_congr [l8]

clam_eq_dom
----------
l1: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l2: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ A = C $ by weaken [#1]
l3: $ … ⇒ u ∊ C $ by welc_eq [l2, l1]
l4: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ B) $ by ax
l5: $ … ⇒ ⟨ u , v ⟩ ∈ clam x C B $ by clam_intro [l3, l4]
l6: $ G , w ∊ clam x A B , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ w = ⟨ u , v ⟩ $ by ax
l7: $ … ⇒ ⟨ u , v ⟩ = w $ by eq_sym [l6]
l8: $ … ⇒ w ∈ clam x C B $ by wcel_eq_l [l7, l5]
l9: $ … ⇒ w ∊ clam x C B $ by wcel_welc [l8]
l10: $ G , w ∊ clam x A B ⇒ w ∊ clam x A B $ by ax
l11: $ … ⇒ w ∊ clam x C B $ by clam_elim_mem [l10, l9]
l12: $ … ⇒ C = A $ by eq_sym [#1]
l13: $ G , w ∊ clam x C B , w = ⟨ u , v ⟩ , u ∊ C , v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ C $ by ax
l14: $ G , w ∊ clam x C B , w = ⟨ u , v ⟩ , u ∊ C , v ∊ (⟦ x / u ⟧ B) ⇒ C = A $ by weaken [l12]
l15: $ … ⇒ u ∊ A $ by welc_eq [l14, l13]
l16: $ G , w ∊ clam x C B , w = ⟨ u , v ⟩ , u ∊ C , v ∊ (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ B) $ by ax
l17: $ … ⇒ ⟨ u , v ⟩ ∈ clam x A B $ by clam_intro [l15, l16]
l18: $ G , w ∊ clam x C B , w = ⟨ u , v ⟩ , u ∊ C , v ∊ (⟦ x / u ⟧ B) ⇒ w = ⟨ u , v ⟩ $ by ax
l19: $ … ⇒ ⟨ u , v ⟩ = w $ by eq_sym [l18]
l20: $ … ⇒ w ∈ clam x A B $ by wcel_eq_l [l19, l17]
l21: $ … ⇒ w ∊ clam x A B $ by wcel_welc [l20]
l22: $ G , w ∊ clam x C B ⇒ w ∊ clam x C B $ by ax
l23: $ … ⇒ w ∊ clam x A B $ by clam_elim_mem [l22, l21]
l24: $ … ⇒ clam x A B = clam x C B $ by eq_intro [l11, l23]

clam_eq_body
------------
l1: $ G , w ∊ clam x A B ⇒ w ∊ clam x A B $ by ax
l2: $ G , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ ∀ x (x ∊ A → B = C) $ by weaken [#1]
l3: $ … ⇒ u ∊ A → (⟦ x / u ⟧ B) = (⟦ x / u ⟧ C) $ by all_elim [l2]
l4: $ G , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l5: $ … ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ C) $ by imp_elim [l3, l4]
l6: $ G , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ B) $ by ax
l7: $ … ⇒ v ∊ (⟦ x / u ⟧ C) $ by welc_eq [l5, l6]
l8: $ … ⇒ ⟨ u , v ⟩ ∈ clam x A C $ by clam_intro [l4, l7]
l9: $ G , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ w = ⟨ u , v ⟩ $ by ax
l10: $ … ⇒ ⟨ u , v ⟩ = w $ by eq_sym [l9]
l11: $ … ⇒ w ∈ clam x A C $ by wcel_eq_l [l10, l8]
l12: $ … ⇒ w ∊ clam x A C $ by wcel_welc [l11]
l13: $ … ⇒ w ∊ clam x A C $ by clam_elim_mem [l1, l12]
m1: $ G , w ∊ clam x A C ⇒ w ∊ clam x A C $ by ax
m2: $ G , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) ⇒ ∀ x (x ∊ A → B = C) $ by weaken [#1]
m3: $ … ⇒ u ∊ A → (⟦ x / u ⟧ B) = (⟦ x / u ⟧ C) $ by all_elim [m2]
m4: $ G , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) ⇒ u ∊ A $ by ax
m5: $ … ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ C) $ by imp_elim [m3, m4]
m5b: $ … ⇒ (⟦ x / u ⟧ C) = (⟦ x / u ⟧ B) $ by eq_sym [m5]
m6: $ G , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) ⇒ v ∊ (⟦ x / u ⟧ C) $ by ax
m7: $ … ⇒ v ∊ (⟦ x / u ⟧ B) $ by welc_eq [m5b, m6]
m8: $ … ⇒ ⟨ u , v ⟩ ∈ clam x A B $ by clam_intro [m4, m7]
m9: $ G , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) ⇒ w = ⟨ u , v ⟩ $ by ax
m10: $ … ⇒ ⟨ u , v ⟩ = w $ by eq_sym [m9]
m11: $ … ⇒ w ∈ clam x A B $ by wcel_eq_l [m10, m8]
m12: $ … ⇒ w ∊ clam x A B $ by wcel_welc [m11]
m13: $ … ⇒ w ∊ clam x A B $ by clam_elim_mem [m1, m12]
m14: $ … ⇒ clam x A B = clam x A C $ by eq_intro [l13, m13]

sb_c_clam
--------
l1: $ (⟦ y / t ⟧ {z | ∃ x ∃ w (z = ⟨ x , w ⟩ ∧ x ∊ A ∧ w ∊ B)}) ≐ {z | ∃ x ∃ w (z = ⟨ x , w ⟩ ∧ x ∊ (⟦ y / t ⟧ A) ∧ w ∊ (⟦ y / t ⟧ B))} $ by ceqt_refl

cpi_intro
--------
l1: $ … ⇒ f ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap f x ∈ B) $ by and_intro [#1, #2]
l2: $ … ⇒ f ∊ {g | g ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)} $ by cab_intro [l1]

cpi_elim_sub
-----------
l1: $ G ⇒ f ∊ {g | g ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)} $ by weaken [#1]
l2: $ … ⇒ f ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap f x ∈ B) $ by cab_elim [l1]
l3: $ … ⇒ f ⊆ clam x A (⋃ B) $ by and_elim_l [l2]

cpi_elim_ap
----------
l1: $ G ⇒ f ∊ {g | g ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap g x ∈ B)} $ by weaken [#1]
l2: $ … ⇒ f ⊆ clam x A (⋃ B) ∧ ∀ x (x ∊ A → ap f x ∈ B) $ by cab_elim [l1]
l3: $ … ⇒ ∀ x (x ∊ A → ap f x ∈ B) $ by and_elim_r [l2]
l4: $ … ⇒ a ∊ A → ap f a ∈ (⟦ x / a ⟧ B) $ by all_elim [l3]
l5: $ … ⇒ ap f a ∈ (⟦ x / a ⟧ B) $ by imp_elim [l4, #2]

clam_cpi_intro
------------
l1: $ G , g = clam x A C , w ∊ g ⇒ w ∊ g $ by ax
l2: $ G , g = clam x A C , w ∊ g ⇒ g = clam x A C $ by ax
l3: $ … ⇒ w ∊ clam x A C $ by welc_eq [l2, l1]
l4: $ G , g = clam x A C , w ∊ g , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) ⇒ ∀ x (x ∊ A → C ∈ B) $ by weaken [#2]
l5: $ … ⇒ u ∊ A → (⟦ x / u ⟧ C) ∈ (⟦ x / u ⟧ B) $ by all_elim [l4]
l6: $ G , g = clam x A C , w ∊ g , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) ⇒ u ∊ A $ by ax
l7: $ … ⇒ (⟦ x / u ⟧ C) ∈ (⟦ x / u ⟧ B) $ by imp_elim [l5, l6]
l8: $ G , g = clam x A C , w ∊ g , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) , k = (⟦ x / u ⟧ C) , k ∊ (⟦ x / u ⟧ B) ⇒ k = (⟦ x / u ⟧ C) $ by ax
l9: $ … ⇒ (⟦ x / u ⟧ C) = k $ by eq_sym [l8]
l10: $ G , g = clam x A C , w ∊ g , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) , k = (⟦ x / u ⟧ C) , k ∊ (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ C) $ by ax
l11: $ … ⇒ v ∊ k $ by welc_eq [l9, l10]
l12: $ G , g = clam x A C , w ∊ g , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) , k = (⟦ x / u ⟧ C) , k ∊ (⟦ x / u ⟧ B) ⇒ k ∊ (⟦ x / u ⟧ B) $ by ax
l13: $ … ⇒ v ∊ ⋃ (⟦ x / u ⟧ B) $ by cuni_intro [l11, l12]
l14: $ … ⇒ v ∊ ⋃ (⟦ x / u ⟧ B) $ by wcel_elim [l7, l13]
l15: $ G , g = clam x A C , w ∊ g , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) ⇒ ⟨ u , v ⟩ ∈ clam x A (⋃ B) $ by clam_intro [l6, l14]
l16: $ G , g = clam x A C , w ∊ g , w = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ C) ⇒ w = ⟨ u , v ⟩ $ by ax
l17: $ … ⇒ ⟨ u , v ⟩ = w $ by eq_sym [l16]
l18: $ … ⇒ w ∈ clam x A (⋃ B) $ by wcel_eq_l [l17, l15]
l19: $ … ⇒ w ∊ clam x A (⋃ B) $ by wcel_welc [l18]
l20: $ … ⇒ w ∊ clam x A (⋃ B) $ by clam_elim_mem [l3, l19]
l21: $ … ⇒ g ⊆ clam x A (⋃ B) $ by subset_intro [l20]
l22: $ G , g = clam x A C , i ∊ A ⇒ g = clam x A C $ by ax
l23: $ G , g = clam x A C , i ∊ A ⇒ i = i $ by eq_refl
l24: $ … ⇒ ap g i = ap (clam x A C) i $ by ap_eq [l22, l23]
l25: $ G , g = clam x A C , i ∊ A ⇒ i ∊ A $ by ax
l26: $ … ⇒ ap (clam x A C) i = (⟦ x / i ⟧ C) $ by clam_ap [l25]
l27: $ … ⇒ ap g i = (⟦ x / i ⟧ C) $ by eq_trans [l24, l26]
l28: $ … ⇒ (⟦ x / i ⟧ C) = ap g i $ by eq_sym [l27]
l29: $ G , g = clam x A C , i ∊ A ⇒ ∀ x (x ∊ A → C ∈ B) $ by weaken [#2]
l30: $ … ⇒ i ∊ A → (⟦ x / i ⟧ C) ∈ (⟦ x / i ⟧ B) $ by all_elim [l29]
l31: $ … ⇒ (⟦ x / i ⟧ C) ∈ (⟦ x / i ⟧ B) $ by imp_elim [l30, l25]
l32: $ … ⇒ ap g i ∈ (⟦ x / i ⟧ B) $ by wcel_eq_l [l28, l31]
l33: $ … ⇒ i ∊ A → ap g i ∈ (⟦ x / i ⟧ B) $ by imp_intro [l32]
l34: $ … ⇒ ∀ i (i ∊ A → ap g i ∈ (⟦ x / i ⟧ B)) $ by all_intro [l33]
l35: $ (∀ x (x ∊ A → ap g x ∈ B)) ⟺ ∀ i (i ∊ A → ap g i ∈ (⟦ x / i ⟧ B)) $ by all_alpha
l36: $ G , g = clam x A C ⇒ (∀ x (x ∊ A → ap g x ∈ B)) ↔ ∀ i (i ∊ A → ap g i ∈ (⟦ x / i ⟧ B)) $ by weaken [l35]
l37: $ … ⇒ ∀ x (x ∊ A → ap g x ∈ B) $ by bi_elim_r [l36, l34]
l38: $ … ⇒ g ∊ cpi x A B $ by cpi_intro [l21, l37]
l39: $ G , g = clam x A C ⇒ g = clam x A C $ by ax
l40: $ … ⇒ clam x A C ∈ cpi x A B $ by wcel_intro [l39, l38]
l41: $ … ⇒ clam x A C ∈ cpi x A B $ by isset_elim [#1, l40]

