d3: $ G , c = cgr x (reps x s) ↾ hartogs s , u = hartogs s , v = 𝒫 (𝒫 s × 𝒫 (s × s)) , v ∊ U ⇒ u = hartogs s $ by ax
d4: $ … ⇒ hartogs s = u $ by eq_sym [d3]
d5: $ G , c = cgr x (reps x s) ↾ hartogs s , u = hartogs s , v = 𝒫 (𝒫 s × 𝒫 (s × s)) , v ∊ U ⇒ v = 𝒫 (𝒫 s × 𝒫 (s × s)) $ by ax
d6: $ … ⇒ 𝒫 (𝒫 s × 𝒫 (s × s)) = v $ by eq_sym [d5]
