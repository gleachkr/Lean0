l0: $ g ≐ g $ by ceqt_refl
l1: $ injects g A C ⟺ injects g B D $ by injects_congr [l0, #1, #2]
l2: $ A × C ≐ B × D $ by cxp_congr [#1, #2]
l3: $ (g ⊆ A × C) ⟺ (g ⊆ B × D) $ by subset_congr [l0, l2]
l4: $ (injects g A C ∧ g ⊆ A × C) ⟺ (injects g B D ∧ g ⊆ B × D) $ by and_congr [l1, l3]
l5: $ {g | injects g A C ∧ g ⊆ A × C} ≐ {g | injects g B D ∧ g ⊆ B × D} $ by cab_congr [l4]

injs_eq
-------
a1: $ G , g ∊ injs A C ⇒ g ∊ injs A C $ by ax
a2: $ … ⇒ injects g A C $ by injs_elim [a1]
a3: $ … ⇒ g ⊆ A × C $ by injs_elim_sub [a1]
a4: $ G , g ∊ injs A C ⇒ g = g $ by eq_refl
a5: $ G , g ∊ injs A C ⇒ A = B $ by weaken [#1]
a6: $ G , g ∊ injs A C ⇒ C = D $ by weaken [#2]
a7: $ … ⇒ injects g B D $ by injects_eq [a4, a5, a6, a2]
a8: $ … ⇒ A × C = B × D $ by cxp_eq [a5, a6]
a9: $ … ⇒ g ⊆ B × D $ by subset_eq_r [a8, a3]
a10: $ … ⇒ g ∊ injs B D $ by injs_intro [a7, a9]
b0: $ … ⇒ B = A $ by eq_sym [#1]
b00: $ … ⇒ D = C $ by eq_sym [#2]
b1: $ G , g ∊ injs B D ⇒ g ∊ injs B D $ by ax
b2: $ … ⇒ injects g B D $ by injs_elim [b1]
b3: $ … ⇒ g ⊆ B × D $ by injs_elim_sub [b1]
b4: $ G , g ∊ injs B D ⇒ g = g $ by eq_refl
b5: $ G , g ∊ injs B D ⇒ B = A $ by weaken [b0]
b6: $ G , g ∊ injs B D ⇒ D = C $ by weaken [b00]
b7: $ … ⇒ injects g A C $ by injects_eq [b4, b5, b6, b2]
b8: $ … ⇒ B × D = A × C $ by cxp_eq [b5, b6]
b9: $ … ⇒ g ⊆ A × C $ by subset_eq_r [b8, b3]
b10: $ … ⇒ g ∊ injs A C $ by injs_intro [b7, b9]
l1: $ … ⇒ injs A C = injs B D $ by eq_intro [a10, b10]

sb_c_injs
---------
l1: $ (⟦ x / t ⟧ {g | injects g A B ∧ g ⊆ A × B}) ≐ {g | injects g (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) ∧ g ⊆ (⟦ x / t ⟧ A) × (⟦ x / t ⟧ B)} $ by ceqt_refl

hartogs_intro
-------------
l1: $ … ⇒ ord a ∧ inj_into a A $ by and_intro [#1, #2]
l2: $ … ⇒ a ∊ {y | ord y ∧ inj_into y A} $ by cab_intro [l1]

hartogs_elim
------------
l1: $ … ⇒ ord a ∧ inj_into a A $ by cab_elim [#1]

hartogs_trans
-------------
l1: $ G , x ∊ hartogs A , y ∊ x ⇒ x ∊ hartogs A $ by ax
l2: $ … ⇒ ord x ∧ inj_into x A $ by hartogs_elim [l1]
l3: $ … ⇒ ord x $ by and_elim_l [l2]
l4: $ … ⇒ inj_into x A $ by and_elim_r [l2]
l5: $ G , x ∊ hartogs A , y ∊ x ⇒ y ∊ x $ by ax
l6: $ … ⇒ ord y $ by ord_elem [l3, l5]
l7: $ … ⇒ y ⊆ x $ by ord_elem_subset [l3, l5]
l8: $ … ⇒ inj_into y A $ by inj_into_subset_dom [l4, l7]
l9: $ … ⇒ y ∊ hartogs A $ by hartogs_intro [l6, l8]
l10: $ … ⇒ transitive (hartogs A) $ by transitive_intro [l9]

hartogs_ord
-----------
l1: $ G ⇒ transitive (hartogs A) $ by hartogs_trans
l2: $ G , x ∊ hartogs A ⇒ x ∊ hartogs A $ by ax
