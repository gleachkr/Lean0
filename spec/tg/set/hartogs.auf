p2: $ … ⇒ injects f a s $ by injs_elim [p1]
p3: $ G , f ∊ injs a s , w = ⟨ img f a , erel f a ⟩ , g ∊ injs b s , w = ⟨ img g b , erel g b ⟩ ⇒ g ∊ injs b s $ by ax
p4: $ … ⇒ injects g b s $ by injs_elim [p3]
p5: $ G , f ∊ injs a s , w = ⟨ img f a , erel f a ⟩ , g ∊ injs b s , w = ⟨ img g b , erel g b ⟩ ⇒ w = ⟨ img f a , erel f a ⟩ $ by ax
p6: $ G , f ∊ injs a s , w = ⟨ img f a , erel f a ⟩ , g ∊ injs b s , w = ⟨ img g b , erel g b ⟩ ⇒ w = ⟨ img g b , erel g b ⟩ $ by ax
p5s: $ … ⇒ ⟨ img f a , erel f a ⟩ = w $ by eq_sym [p5]
p7: $ … ⇒ ⟨ img f a , erel f a ⟩ = ⟨ img g b , erel g b ⟩ $ by eq_trans [p5s, p6]
q0: $ G , f ∊ injs a s , w = ⟨ img f a , erel f a ⟩ , g ∊ injs b s , w = ⟨ img g b , erel g b ⟩ ⇒ isset s $ by isset_var
q1: $ … ⇒ isset (s × s) $ by cxp_set [q0, q0]
q2: $ … ⇒ img f a ⊆ s $ by injects_img [p2]
q3: $ … ⇒ isset (img f a) $ by subset_set [q2]
q4: $ … ⇒ erel f a ⊆ s × s $ by erel_subset [p2]
q5: $ … ⇒ isset (erel f a) $ by subset_isset [q1, q4]
q6: $ … ⇒ img g b ⊆ s $ by injects_img [p4]
q7: $ … ⇒ isset (img g b) $ by subset_set [q6]
q8: $ … ⇒ erel g b ⊆ s × s $ by erel_subset [p4]
q9: $ … ⇒ isset (erel g b) $ by subset_isset [q1, q8]
p8: $ … ⇒ img f a = img g b ∧ erel f a = erel g b $ by opair_inj_c [p7, q3, q5, q7, q9]
p9: $ … ⇒ img f a = img g b $ by and_elim_l [p8]
p10: $ … ⇒ erel f a = erel g b $ by and_elim_r [p8]
p11: $ G , f ∊ injs a s , w = ⟨ img f a , erel f a ⟩ , g ∊ injs b s , w = ⟨ img g b , erel g b ⟩ ⇒ ord a $ by weaken [#1]
p12: $ G , f ∊ injs a s , w = ⟨ img f a , erel f a ⟩ , g ∊ injs b s , w = ⟨ img g b , erel g b ⟩ ⇒ ord b $ by weaken [#2]
p13: $ … ⇒ a = b $ by ord_rigid [p11, p12, p2, p4, p9, p10]
l2: $ … ⇒ a = b $ by reps_elim [l1, p13]
l3: $ … ⇒ a = b $ by reps_elim [#3, l2]

reps_congr
----------
l0: $ seqt f f $ by seqt_refl
m0: $ seqt w w $ by seqt_refl
l1: $ injs A S ≐ injs B T $ by injs_congr [#1, #2]
l2: $ (f ∊ injs A S) ⟺ (f ∊ injs B T) $ by welc_congr [l0, l1]
l3: $ img f A ≐ img f B $ by img_congr [l0, #1]
l4: $ erel f A ≐ erel f B $ by erel_congr [l0, #1]
l5: $ ⟨ img f A , erel f A ⟩ ≐ ⟨ img f B , erel f B ⟩ $ by opair_congr [l3, l4]
l6: $ (w = ⟨ img f A , erel f A ⟩) ⟺ (w = ⟨ img f B , erel f B ⟩) $ by ceq_congr [m0, l5]
l7: $ (f ∊ injs A S ∧ w = ⟨ img f A , erel f A ⟩) ⟺ (f ∊ injs B T ∧ w = ⟨ img f B , erel f B ⟩) $ by and_congr [l2, l6]
l8: $ ∃ f (f ∊ injs A S ∧ w = ⟨ img f A , erel f A ⟩) ⟺ ∃ f (f ∊ injs B T ∧ w = ⟨ img f B , erel f B ⟩) $ by ex_congr [l7]
l9: $ {w | ∃ f (f ∊ injs A S ∧ w = ⟨ img f A , erel f A ⟩)} ≐ {w | ∃ f (f ∊ injs B T ∧ w = ⟨ img f B , erel f B ⟩)} $ by cab_congr [l8]

sb_c_reps
---------
l1: $ (⟦ x / t ⟧ {w | ∃ f (f ∊ injs A S ∧ w = ⟨ img f A , erel f A ⟩)}) ≐ {w | ∃ f (f ∊ injs (⟦ x / t ⟧ A) (⟦ x / t ⟧ S) ∧ w = ⟨ img f (⟦ x / t ⟧ A) , erel f (⟦ x / t ⟧ A) ⟩)} $ by ceqt_refl

