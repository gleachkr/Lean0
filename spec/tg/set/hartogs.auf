l2: $ ⟨ v , w ⟩ ≐ ⟨ v , w ⟩ $ by ceqt_refl
l3: $ (⟨ v , w ⟩ ∈ F) ⟺ (⟨ v , w ⟩ ∈ H) $ by wcel_congr [l2, #1]
