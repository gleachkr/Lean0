l7: $ G , z = hartogs A ⇒ A = A $ by eq_refl
l8: $ … ⇒ inj_into z A $ by inj_into_eq [l3, l7, l6]
l9: $ … ⇒ z ∊ hartogs A $ by hartogs_intro [l5, l8]
l10: $ … ⇒ z ∊ z $ by welc_eq [l3, l9]
l11: $ … ⇒ ⊥ $ by notin_self [l10]
l12: $ … ⇒ ⊥ $ by isset_elim [l1, l11]

hartogs_mono
------------
l1: $ G , x ∊ hartogs A ⇒ x ∊ hartogs A $ by ax
