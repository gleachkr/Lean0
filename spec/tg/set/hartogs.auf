l4: $ … ⇒ ord x $ by and_elim_l [l3]
l5: $ … ⇒ transitive x $ by ord_trans [l4]
l6: $ … ⇒ x ∊ hartogs A → transitive x $ by imp_intro [l5]
l7: $ … ⇒ ∀ x (x ∊ hartogs A → transitive x) $ by all_intro [l6]
l8: $ … ⇒ ord (hartogs A) $ by ord_intro [l1, l7]

hartogs_not_inj
---------------
l1: $ … ⇒ isset (hartogs A) $ by inj_into_set [#1]
