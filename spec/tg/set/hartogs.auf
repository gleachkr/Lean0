g10: $ … ⇒ ∃ y (y ∊ 𝒫 (𝒫 s × 𝒫 (s × s)) ∧ ⟨ u , y ⟩ ∈ cgr x (reps x s) ↾ hartogs s) $ by ex_intro [g9]
f4: $ … ⇒ ∃ y (y ∊ 𝒫 (𝒫 s × 𝒫 (s × s)) ∧ ⟨ u , y ⟩ ∈ cgr x (reps x s) ↾ hartogs s) $ by isset_elim [f3, g10]
