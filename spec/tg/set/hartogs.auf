l7: $ … ⇒ inj_into u B $ by inj_into_eq [l5, l6, l4]
l8: $ … ⇒ u ∊ hartogs B $ by hartogs_intro [l3, l7]
l9: $ … ⇒ B = A $ by eq_sym [#1]
m1: $ G , u ∊ hartogs B ⇒ u ∊ hartogs B $ by ax
m2: $ … ⇒ ord u ∧ inj_into u B $ by hartogs_elim [m1]
m3: $ … ⇒ ord u $ by and_elim_l [m2]
m4: $ … ⇒ inj_into u B $ by and_elim_r [m2]
m5: $ G , u ∊ hartogs B ⇒ u = u $ by eq_refl
m6: $ G , u ∊ hartogs B ⇒ B = A $ by weaken [l9]
m7: $ … ⇒ inj_into u A $ by inj_into_eq [m5, m6, m4]
m8: $ … ⇒ u ∊ hartogs A $ by hartogs_intro [m3, m7]
l10: $ … ⇒ hartogs A = hartogs B $ by eq_intro [l8, m8]

