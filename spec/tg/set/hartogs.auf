------------
l1: $ (⟦ x / t ⟧ {y | ord y ∧ inj_into y A}) ≐ {y | ord y ∧ inj_into y (⟦ x / t ⟧ A)} $ by ceqt_refl

ord_cuni_suc
------------
l1: $ G , u ∊ ⋃ (img (cgr x (suc x)) a) ⇒ u ∊ ⋃ (img (cgr x (suc x)) a) $ by ax
l2: $ G , v ∊ img (cgr x (suc x)) a , u ∊ v ⇒ v ∊ img (cgr x (suc x)) a $ by ax
l3: $ G , v ∊ img (cgr x (suc x)) a , u ∊ v , w ∊ a , ⟨ w , v ⟩ ∈ cgr x (suc x) ⇒ ⟨ w , v ⟩ ∈ cgr x (suc x) $ by ax
