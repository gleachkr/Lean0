l11: $ … ⇒ u ∊ a $ by img_elim [l2, l10]
l12: $ … ⇒ u ∊ a $ by cuni_elim [l1, l11]
m0: $ G , u ∊ a ⇒ isset u $ by isset_var
m1: $ … ⇒ isset (suc u) $ by suc_set [m0]
m2: $ G , u ∊ a , v = suc u ⇒ v = suc u $ by ax
m3: $ G , u ∊ a , v = suc u ⇒ ⟨ u , v ⟩ ∈ cgr x (suc x) $ by cgr_intro [m2]
m4: $ G , u ∊ a , v = suc u ⇒ u ∊ a $ by ax
m5: $ … ⇒ v ∊ img (cgr x (suc x)) a $ by img_intro [m4, m3]
m6: $ … ⇒ suc u = v $ by eq_sym [m2]
m7: $ G , u ∊ a , v = suc u ⇒ u ∊ suc u $ by suc_self
m8: $ … ⇒ u ∊ v $ by welc_eq [m6, m7]
m9: $ … ⇒ u ∊ ⋃ (img (cgr x (suc x)) a) $ by cuni_intro [m8, m5]
m10: $ … ⇒ u ∊ ⋃ (img (cgr x (suc x)) a) $ by isset_elim [m1, m9]
l13: $ … ⇒ ⋃ (img (cgr x (suc x)) a) = a $ by eq_intro [l12, m10]

