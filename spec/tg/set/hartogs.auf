l125: $ G , functional g ∧ ∀ x (x ∊ a → g' x ∈ injs (f' x) s) , functional j ∧ ∀ y (y ∊ ⋃ (img f a) → j' y ∈ a ∧ y ∊ f' j' y) , i = cgr k ⟨ j' k , (g' j' k)' k ⟩ ↾ (⋃ (img f a)) ⇒ ⋃ (img f a) = ⋃ (img f a) $ by eq_refl
l126: $ G , functional g ∧ ∀ x (x ∊ a → g' x ∈ injs (f' x) s) , functional j ∧ ∀ y (y ∊ ⋃ (img f a) → j' y ∈ a ∧ y ∊ f' j' y) , i = cgr k ⟨ j' k , (g' j' k)' k ⟩ ↾ (⋃ (img f a)) ⇒ a × s = a × s $ by eq_refl
l127: $ G , functional g ∧ ∀ x (x ∊ a → g' x ∈ injs (f' x) s) , functional j ∧ ∀ y (y ∊ ⋃ (img f a) → j' y ∈ a ∧ y ∊ f' j' y) , i = cgr k ⟨ j' k , (g' j' k)' k ⟩ ↾ (⋃ (img f a)) ⇒ injects (cgr k ⟨ j' k , (g' j' k)' k ⟩ ↾ (⋃ (img f a))) (⋃ (img f a)) (a × s) $ by weaken [l117]
l128: $ … ⇒ injects i (⋃ (img f a)) (a × s) $ by injects_eq [l124, l125, l126, l127]
l129: $ … ⇒ inj_into (⋃ (img f a)) (a × s) $ by inj_into_intro [l128]
l130: $ … ⇒ inj_into (⋃ (img f a)) (a × s) $ by isset_elim [l122, l129]
l131: $ … ⇒ ∃ g (functional g ∧ ∀ x (x ∊ a → g' x ∈ injs (f' x) s)) $ by choice_injs [#1, #2]
l132: $ … ⇒ ∃ j (functional j ∧ ∀ y (y ∊ ⋃ (img f a) → j' y ∈ a ∧ y ∊ f' j' y)) $ by choice_index [#1]
l133: $ … ⇒ inj_into (⋃ (img f a)) (a × s) $ by ex_elim [l132, l130]
l134: $ … ⇒ inj_into (⋃ (img f a)) (a × s) $ by ex_elim [l131, l133]

shiftp_intro
------------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ isset b $ by isset_var
l3: $ … ⇒ isset (suc b) $ by suc_set [l2]
l4: $ … ⇒ isset ⟨ a , suc b ⟩ $ by opair_set [l1, l3]
l5: $ G , w = ⟨ a , suc b ⟩ ⇒ ⟨ a , b ⟩ ∈ X $ by weaken [#1]
l6: $ G , w = ⟨ a , suc b ⟩ ⇒ w = ⟨ a , suc b ⟩ $ by ax
l7: $ … ⇒ ⟨ a , b ⟩ ∈ X ∧ w = ⟨ a , suc b ⟩ $ by and_intro [l5, l6]
l8: $ … ⇒ ∃ k (⟨ a , k ⟩ ∈ X ∧ w = ⟨ a , suc k ⟩) $ by ex_intro [l7]
l9: $ … ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ex_intro [l8]
l10: $ G , w = ⟨ a , suc b ⟩ ⇒ w ∊ shiftp X $ by cab_intro [l9]
l11: $ … ⇒ ⟨ a , suc b ⟩ ∈ shiftp X $ by wcel_intro [l6, l10]
l12: $ … ⇒ ⟨ a , suc b ⟩ ∈ shiftp X $ by isset_elim [l4, l11]

shiftp_elim
-----------
l1: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X ⇒ w ∊ shiftp X $ by ax
l2: $ … ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by cab_elim [l1]
l3: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ $ by ax
l4: $ … ⇒ ⟨ j , k ⟩ ∈ X $ by and_elim_l [l3]
l5: $ … ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [l3]
l6: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ w = ⟨ a , c ⟩ $ by ax
l7: $ … ⇒ ⟨ a , c ⟩ = w $ by eq_sym [l6]
l8: $ … ⇒ ⟨ a , c ⟩ = ⟨ j , suc k ⟩ $ by eq_trans [l7, l5]
l9: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset a $ by isset_var
l10: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset c $ by isset_var
l11: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset j $ by isset_var
l12: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset k $ by isset_var
l13: $ … ⇒ isset (suc k) $ by suc_set [l12]
l14: $ … ⇒ a = j ∧ c = suc k $ by opair_inj_c [l8, l9, l10, l11, l13]
l15: $ … ⇒ a = j $ by and_elim_l [l14]
l16: $ … ⇒ c = suc k $ by and_elim_r [l14]
l17: $ … ⇒ j = a $ by eq_sym [l15]
l18: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ k = k $ by eq_refl
l19: $ … ⇒ ⟨ j , k ⟩ = ⟨ a , k ⟩ $ by opair_eq [l17, l18]
l20: $ … ⇒ ⟨ a , k ⟩ ∈ X $ by wcel_eq_l [l19, l4]
l21: $ … ⇒ ⟨ a , k ⟩ ∈ X ∧ c = suc k $ by and_intro [l20, l16]
l22: $ … ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $ by ex_intro [l21]
l23: $ G , w = ⟨ a , c ⟩ , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ax
l24: $ … ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $ by ex_elim [l23, l22]
l25: $ … ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $ by ex_elim [l2, l24]
l26: $ … ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $ by wcel_elim [#1, l25]

shiftp_rel
----------
l1: $ w ∊ shiftp X ⇒ w ∊ shiftp X $ by ax
l2: $ … ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by cab_elim [l1]
l3: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ isset k $ by isset_var
l4: $ … ⇒ isset (suc k) $ by suc_set [l3]
l5: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ $ by ax
l6: $ … ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [l5]
l7: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ i = suc k $ by ax
l8: $ … ⇒ suc k = i $ by eq_sym [l7]
l9: $ w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ , i = suc k ⇒ j = j $ by eq_refl
l10: $ … ⇒ ⟨ j , suc k ⟩ = ⟨ j , i ⟩ $ by opair_eq [l9, l8]
l11: $ … ⇒ w = ⟨ j , i ⟩ $ by eq_trans [l6, l10]
l12: $ … ⇒ ∃ v (w = ⟨ j , v ⟩) $ by ex_intro [l11]
l13: $ … ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by ex_intro [l12]
l14: $ … ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by isset_elim [l4, l13]
l15: $ w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ax
l16: $ … ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by ex_elim [l15, l14]
l17: $ … ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by ex_elim [l2, l16]
l18: $ G , w ∊ shiftp X ⇒ ∃ u ∃ v (w = ⟨ u , v ⟩) $ by weaken [l17]
l19: $ … ⇒ rel (shiftp X) $ by rel_intro [l18]

shiftp_subset
-------------
l1: $ G , w ∊ shiftp X ⇒ w ∊ shiftp X $ by ax
l2: $ … ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by cab_elim [l1]
l3: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ $ by ax
l4: $ … ⇒ ⟨ j , k ⟩ ∈ X $ by and_elim_l [l3]
l5: $ … ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [l3]
l6: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ X ⊆ a × ω $ by weaken [#1]
l7: $ … ⇒ ⟨ j , k ⟩ ∈ a × ω $ by wcel_subset [l6, l4]
l8: $ … ⇒ j ∊ a ∧ k ∊ ω $ by cxp_elim_pair [l7]
l9: $ … ⇒ j ∊ a $ by and_elim_l [l8]
l10: $ … ⇒ k ∊ ω $ by and_elim_r [l8]
l11: $ … ⇒ suc k ∈ ω $ by omega_suc [l10]
l12: $ … ⇒ j ∈ a $ by welc_wcel [l9]
l13: $ … ⇒ ⟨ j , suc k ⟩ ∈ a × ω $ by cxp_intro_c [l12, l11]
l14: $ … ⇒ ⟨ j , suc k ⟩ = w $ by eq_sym [l5]
l15: $ … ⇒ w ∈ a × ω $ by wcel_eq_l [l14, l13]
l16: $ … ⇒ w ∊ a × ω $ by wcel_welc [l15]
l17: $ G , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ax
l18: $ … ⇒ w ∊ a × ω $ by ex_elim [l17, l16]
l19: $ … ⇒ w ∊ a × ω $ by ex_elim [l2, l18]
l20: $ … ⇒ shiftp X ⊆ a × ω $ by subset_intro [l19]

lemma h3_shiftp_dir (G: hyps) (X Y: class) (a b: set):
  $ G ⇒ shiftp X = shiftp Y $ > $ G ⇒ ⟨ a , b ⟩ ∈ X $ > $ G ⇒ ⟨ a , b ⟩ ∈ Y $
----
l1: $ G , v = suc b ⇒ ⟨ a , b ⟩ ∈ X $ by weaken [#2]
l2: $ … ⇒ ⟨ a , suc b ⟩ ∈ shiftp X $ by shiftp_intro [l1]
l3: $ G , v = suc b ⇒ shiftp X = shiftp Y $ by weaken [#1]
l4: $ … ⇒ ⟨ a , suc b ⟩ ∈ shiftp Y $ by wcel_eq_r [l3, l2]
l5: $ G , v = suc b ⇒ a = a $ by eq_refl
l6: $ G , v = suc b ⇒ v = suc b $ by ax
l7: $ … ⇒ suc b = v $ by eq_sym [l6]
l8: $ … ⇒ ⟨ a , suc b ⟩ = ⟨ a , v ⟩ $ by opair_eq [l5, l7]
l9: $ … ⇒ ⟨ a , v ⟩ ∈ shiftp Y $ by wcel_eq_l [l8, l4]
l10: $ … ⇒ ∃ k (⟨ a , k ⟩ ∈ Y ∧ v = suc k) $ by shiftp_elim [l9]
l11: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ ⟨ a , k ⟩ ∈ Y ∧ v = suc k $ by ax
l12: $ … ⇒ ⟨ a , k ⟩ ∈ Y $ by and_elim_l [l11]
l13: $ … ⇒ v = suc k $ by and_elim_r [l11]
l14: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ v = suc b $ by ax
l15: $ … ⇒ suc b = v $ by eq_sym [l14]
l16: $ … ⇒ suc b = suc k $ by eq_trans [l15, l13]
l17: $ … ⇒ b = k $ by suc_inj [l16]
l18: $ … ⇒ k = b $ by eq_sym [l17]
l19: $ G , v = suc b , ⟨ a , k ⟩ ∈ Y ∧ v = suc k ⇒ a = a $ by eq_refl
l20: $ … ⇒ ⟨ a , k ⟩ = ⟨ a , b ⟩ $ by opair_eq [l19, l18]
l21: $ … ⇒ ⟨ a , b ⟩ ∈ Y $ by wcel_eq_l [l20, l12]
l22: $ … ⇒ ⟨ a , b ⟩ ∈ Y $ by ex_elim [l10, l21]
l23: $ G ⇒ isset b $ by isset_var
l24: $ … ⇒ isset (suc b) $ by suc_set [l23]
l25: $ … ⇒ ⟨ a , b ⟩ ∈ Y $ by isset_elim [l24, l22]

shiftp_inj
----------
l1: $ G , ⟨ x , y ⟩ ∈ X ⇒ shiftp X = shiftp Y $ by weaken [#3]
l2: $ G , ⟨ x , y ⟩ ∈ X ⇒ ⟨ x , y ⟩ ∈ X $ by ax
l3: $ … ⇒ ⟨ x , y ⟩ ∈ Y $ by h3_shiftp_dir [l1, l2]
l4: $ … ⇒ shiftp Y = shiftp X $ by eq_sym [#3]
l5: $ G , ⟨ x , y ⟩ ∈ Y ⇒ shiftp Y = shiftp X $ by weaken [l4]
l6: $ G , ⟨ x , y ⟩ ∈ Y ⇒ ⟨ x , y ⟩ ∈ Y $ by ax
l7: $ … ⇒ ⟨ x , y ⟩ ∈ X $ by h3_shiftp_dir [l5, l6]
l8: $ … ⇒ X = Y $ by rel_eq_intro [#1, #2, l3, l7]

shiftp_set
----------
l1: $ G ⇒ isset x $ by isset_var
l2: $ … ⇒ isset (cdm x) $ by cdm_set [l1]
l3: $ … ⇒ isset (crn x) $ by crn_set [l1]
l4: $ G ⇒ functional (cgr i (suc i)) $ by cgr_functional
l5: $ … ⇒ isset (img (cgr i (suc i)) (crn x)) $ by img_set [l4, l3]
l6: $ … ⇒ isset (cdm x × img (cgr i (suc i)) (crn x)) $ by cxp_set [l2, l5]
l7: $ G , w ∊ shiftp x ⇒ w ∊ shiftp x $ by ax
l8: $ … ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩) $ by cab_elim [l7]
l9: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ ⇒ isset k $ by isset_var
l10: $ … ⇒ isset (suc k) $ by suc_set [l9]
l11: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ $ by ax
l12: $ … ⇒ ⟨ j , k ⟩ ∈ x $ by and_elim_l [l11]
l13: $ … ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [l11]
l14: $ … ⇒ j ∊ cdm x $ by cdm_intro [l12]
l15: $ … ⇒ k ∊ crn x $ by crn_intro [l12]
l16: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ v = suc k $ by ax
l17: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ ⟨ k , v ⟩ ∈ cgr i (suc i) $ by cgr_intro [l16]
l18: $ … ⇒ v ∊ img (cgr i (suc i)) (crn x) $ by img_intro [l15, l17]
l19: $ G , w ∊ shiftp x , ⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩ , v = suc k ⇒ j = j $ by eq_refl
l20: $ … ⇒ suc k = v $ by eq_sym [l16]
l21: $ … ⇒ ⟨ j , suc k ⟩ = ⟨ j , v ⟩ $ by opair_eq [l19, l20]
l22: $ … ⇒ w = ⟨ j , v ⟩ $ by eq_trans [l13, l21]
l23: $ … ⇒ w ∊ cdm x × img (cgr i (suc i)) (crn x) $ by cxp_intro_eq [l22, l14, l18]
l24: $ … ⇒ w ∊ cdm x × img (cgr i (suc i)) (crn x) $ by isset_elim [l10, l23]
l25: $ G , w ∊ shiftp x , ∃ k (⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ x ∧ w = ⟨ j , suc k ⟩) $ by ax
l26: $ … ⇒ w ∊ cdm x × img (cgr i (suc i)) (crn x) $ by ex_elim [l25, l24]
l27: $ … ⇒ w ∊ cdm x × img (cgr i (suc i)) (crn x) $ by ex_elim [l8, l26]
l28: $ … ⇒ shiftp x ⊆ cdm x × img (cgr i (suc i)) (crn x) $ by subset_intro [l27]
l29: $ … ⇒ isset (shiftp x) $ by subset_isset [l6, l28]

shiftp_congr
------------
l0: $ ⟨ j , k ⟩ ≐ ⟨ j , k ⟩ $ by ceqt_refl
l1: $ (⟨ j , k ⟩ ∈ X) ⟺ (⟨ j , k ⟩ ∈ Y) $ by wcel_congr [l0, #1]
l2: $ (z = ⟨ j , suc k ⟩) ⟺ (z = ⟨ j , suc k ⟩) $ by iff_refl
l3: $ (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) ⟺ (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩) $ by and_congr [l1, l2]
l4: $ ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) ⟺ ∃ k (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩) $ by ex_congr [l3]
l5: $ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩) ⟺ ∃ j ∃ k (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩) $ by ex_congr [l4]
l6: $ {z | ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩)} ≐ {z | ∃ j ∃ k (⟨ j , k ⟩ ∈ Y ∧ z = ⟨ j , suc k ⟩)} $ by cab_congr [l5]

shiftp_eq
---------
a1: $ G , w ∊ shiftp X ⇒ w ∊ shiftp X $ by ax
a2: $ … ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by cab_elim [a1]
a3: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ $ by ax
a4: $ … ⇒ ⟨ j , k ⟩ ∈ X $ by and_elim_l [a3]
a5: $ … ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [a3]
a6: $ G , w ∊ shiftp X , ⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩ ⇒ X = Y $ by weaken [#1]
a7: $ … ⇒ ⟨ j , k ⟩ ∈ Y $ by wcel_eq_r [a6, a4]
a8: $ … ⇒ ⟨ j , suc k ⟩ ∈ shiftp Y $ by shiftp_intro [a7]
a9: $ … ⇒ ⟨ j , suc k ⟩ = w $ by eq_sym [a5]
a10: $ … ⇒ w ∈ shiftp Y $ by wcel_eq_l [a9, a8]
a11: $ … ⇒ w ∊ shiftp Y $ by wcel_welc [a10]
a12: $ G , w ∊ shiftp X , ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ X ∧ w = ⟨ j , suc k ⟩) $ by ax
a13: $ … ⇒ w ∊ shiftp Y $ by ex_elim [a12, a11]
a14: $ … ⇒ w ∊ shiftp Y $ by ex_elim [a2, a13]
b0: $ … ⇒ Y = X $ by eq_sym [#1]
b1: $ G , w ∊ shiftp Y ⇒ w ∊ shiftp Y $ by ax
b2: $ … ⇒ ∃ j ∃ k (⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩) $ by cab_elim [b1]
b3: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ $ by ax
b4: $ … ⇒ ⟨ j , k ⟩ ∈ Y $ by and_elim_l [b3]
b5: $ … ⇒ w = ⟨ j , suc k ⟩ $ by and_elim_r [b3]
b6: $ G , w ∊ shiftp Y , ⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩ ⇒ Y = X $ by weaken [b0]
b7: $ … ⇒ ⟨ j , k ⟩ ∈ X $ by wcel_eq_r [b6, b4]
b8: $ … ⇒ ⟨ j , suc k ⟩ ∈ shiftp X $ by shiftp_intro [b7]
b9: $ … ⇒ ⟨ j , suc k ⟩ = w $ by eq_sym [b5]
b10: $ … ⇒ w ∈ shiftp X $ by wcel_eq_l [b9, b8]
b11: $ … ⇒ w ∊ shiftp X $ by wcel_welc [b10]
b12: $ G , w ∊ shiftp Y , ∃ k (⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩) ⇒ ∃ k (⟨ j , k ⟩ ∈ Y ∧ w = ⟨ j , suc k ⟩) $ by ax
b13: $ … ⇒ w ∊ shiftp X $ by ex_elim [b12, b11]
b14: $ … ⇒ w ∊ shiftp X $ by ex_elim [b2, b13]
l1: $ … ⇒ shiftp X = shiftp Y $ by eq_intro [a14, b14]

sb_c_shiftp
-----------
l1: $ (⟦ x / t ⟧ {z | ∃ j ∃ k (⟨ j , k ⟩ ∈ X ∧ z = ⟨ j , suc k ⟩)}) ≐ {z | ∃ j ∃ k (⟨ j , k ⟩ ∈ (⟦ x / t ⟧ X) ∧ z = ⟨ j , suc k ⟩)} $ by ceqt_refl

lemma h3_notin_shiftp (G: hyps) (X: class) (a: set): $ G ⇒ ⟨ a , ∅ ⟩ ∈ shiftp X $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G , c = ∅ ⇒ a = a $ by eq_refl
l3: $ G , c = ∅ ⇒ c = ∅ $ by ax
l4: $ … ⇒ ∅ = c $ by eq_sym [l3]
l5: $ … ⇒ ⟨ a , ∅ ⟩ = ⟨ a , c ⟩ $ by opair_eq [l2, l4]
l6: $ G , c = ∅ ⇒ ⟨ a , ∅ ⟩ ∈ shiftp X $ by weaken [#1]
l7: $ … ⇒ ⟨ a , c ⟩ ∈ shiftp X $ by wcel_eq_l [l5, l6]
l8: $ … ⇒ ∃ k (⟨ a , k ⟩ ∈ X ∧ c = suc k) $ by shiftp_elim [l7]
l9: $ G , c = ∅ , ⟨ a , k ⟩ ∈ X ∧ c = suc k ⇒ ⟨ a , k ⟩ ∈ X ∧ c = suc k $ by ax
l10: $ … ⇒ c = suc k $ by and_elim_r [l9]
l11: $ … ⇒ suc k = c $ by eq_sym [l10]
l12: $ G , c = ∅ , ⟨ a , k ⟩ ∈ X ∧ c = suc k ⇒ c = ∅ $ by ax
l13: $ … ⇒ suc k = ∅ $ by eq_trans [l11, l12]
l14: $ … ⇒ ⊥ $ by suc_ne_empty [l13]
l15: $ … ⇒ ⊥ $ by ex_elim [l8, l14]
l16: $ … ⇒ ⊥ $ by isset_elim [l1, l15]

shift_val_fst
-------------
l1: $ G , c = ⟨ a , ∅ ⟩ ⇒ c = ⟨ a , ∅ ⟩ $ by ax
l2: $ … ⇒ c ∊ csn ⟨ a , ∅ ⟩ $ by csn_intro [l1]
l3: $ … ⇒ c ∊ csn ⟨ a , ∅ ⟩ ∪ shiftp u $ by cun_intro_l [l2]
l4: $ G , c = ⟨ a , ∅ ⟩ ⇒ csn ⟨ a , ∅ ⟩ ∪ shiftp u = csn ⟨ b , ∅ ⟩ ∪ shiftp v $ by weaken [#1]
l5: $ … ⇒ c ∊ csn ⟨ b , ∅ ⟩ ∪ shiftp v $ by welc_eq [l4, l3]
l6: $ … ⇒ c ∊ csn ⟨ b , ∅ ⟩ ∨ c ∊ shiftp v $ by cun_elim [l5]
l7: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ c ∊ csn ⟨ b , ∅ ⟩ $ by ax
l8: $ … ⇒ c = ⟨ b , ∅ ⟩ $ by csn_elim [l7]
l9: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ c = ⟨ a , ∅ ⟩ $ by ax
l10: $ … ⇒ ⟨ a , ∅ ⟩ = c $ by eq_sym [l9]
l11: $ … ⇒ ⟨ a , ∅ ⟩ = ⟨ b , ∅ ⟩ $ by eq_trans [l10, l8]
l12: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ isset a $ by isset_var
l13: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
l14: $ G , c = ⟨ a , ∅ ⟩ , c ∊ csn ⟨ b , ∅ ⟩ ⇒ isset b $ by isset_var
l15: $ … ⇒ a = b ∧ ∅ = ∅ $ by opair_inj_c [l11, l12, l13, l14, l13]
l16: $ … ⇒ a = b $ by and_elim_l [l15]
l17: $ G , c = ⟨ a , ∅ ⟩ , c ∊ shiftp v ⇒ c ∊ shiftp v $ by ax
l18: $ G , c = ⟨ a , ∅ ⟩ , c ∊ shiftp v ⇒ c = ⟨ a , ∅ ⟩ $ by ax
l19: $ … ⇒ ⟨ a , ∅ ⟩ ∈ shiftp v $ by wcel_intro [l18, l17]
l20: $ … ⇒ ⊥ $ by h3_notin_shiftp [l19]
l21: $ … ⇒ a = b $ by bot_elim [l20]
l22: $ … ⇒ a = b $ by or_elim [l6, l16, l21]
l23: $ G ⇒ isset a $ by isset_var
l24: $ G ⇒ isset ∅ $ by ax_empty
l25: $ … ⇒ isset ⟨ a , ∅ ⟩ $ by opair_set [l23, l24]
l26: $ … ⇒ a = b $ by isset_elim [l25, l22]

lemma h3_sv_dir (G: hyps) (a b u v w: set):
  $ G ⇒ csn ⟨ a , ∅ ⟩ ∪ shiftp u = csn ⟨ b , ∅ ⟩ ∪ shiftp v $ > $ G ⇒ w ∊ shiftp u $ > $ G ⇒ w ∊ shiftp v $
----
l1: $ … ⇒ w ∊ csn ⟨ a , ∅ ⟩ ∪ shiftp u $ by cun_intro_r [#2]
l2: $ … ⇒ w ∊ csn ⟨ b , ∅ ⟩ ∪ shiftp v $ by welc_eq [#1, l1]
l3: $ … ⇒ w ∊ csn ⟨ b , ∅ ⟩ ∨ w ∊ shiftp v $ by cun_elim [l2]
l4: $ G , w ∊ csn ⟨ b , ∅ ⟩ ⇒ w ∊ csn ⟨ b , ∅ ⟩ $ by ax
l5: $ … ⇒ w = ⟨ b , ∅ ⟩ $ by csn_elim [l4]
l6: $ G , w ∊ csn ⟨ b , ∅ ⟩ ⇒ w ∊ shiftp u $ by weaken [#2]
l7: $ … ⇒ ⟨ b , ∅ ⟩ ∈ shiftp u $ by wcel_intro [l5, l6]
l8: $ … ⇒ ⊥ $ by h3_notin_shiftp [l7]
l9: $ … ⇒ w ∊ shiftp v $ by bot_elim [l8]
l10: $ G , w ∊ shiftp v ⇒ w ∊ shiftp v $ by ax
l11: $ … ⇒ w ∊ shiftp v $ by or_elim [l3, l9, l10]

shift_val_snd
-------------
l1: $ G , x ∊ shiftp u ⇒ csn ⟨ a , ∅ ⟩ ∪ shiftp u = csn ⟨ b , ∅ ⟩ ∪ shiftp v $ by weaken [#1]
l2: $ G , x ∊ shiftp u ⇒ x ∊ shiftp u $ by ax
l3: $ … ⇒ x ∊ shiftp v $ by h3_sv_dir [l1, l2]
l4: $ … ⇒ csn ⟨ b , ∅ ⟩ ∪ shiftp v = csn ⟨ a , ∅ ⟩ ∪ shiftp u $ by eq_sym [#1]
l5: $ G , x ∊ shiftp v ⇒ csn ⟨ b , ∅ ⟩ ∪ shiftp v = csn ⟨ a , ∅ ⟩ ∪ shiftp u $ by weaken [l4]
l6: $ G , x ∊ shiftp v ⇒ x ∊ shiftp v $ by ax
l7: $ … ⇒ x ∊ shiftp u $ by h3_sv_dir [l5, l6]
l8: $ … ⇒ shiftp u = shiftp v $ by eq_intro [l3, l7]

lemma h3_val_eq (G: hyps) (i j u k: set): $ G ⇒ i = j $ > $ G ⇒ u = k $ > $ G ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u = csn ⟨ j , ∅ ⟩ ∪ shiftp k $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ … ⇒ ⟨ i , ∅ ⟩ = ⟨ j , ∅ ⟩ $ by opair_eq [#1, l1]
l3: $ … ⇒ csn ⟨ i , ∅ ⟩ = csn ⟨ j , ∅ ⟩ $ by csn_eq [l2]
l4: $ … ⇒ shiftp u = shiftp k $ by shiftp_eq [#2]
l5: $ … ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by cun_eq [l3, l4]

lemma h3_val_set (G: hyps) (i u: set): $ G ⇒ isset (csn ⟨ i , ∅ ⟩ ∪ shiftp u) $
----
l1: $ G ⇒ isset i $ by isset_var
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ … ⇒ isset ⟨ i , ∅ ⟩ $ by opair_set [l1, l2]
l4: $ … ⇒ isset (csn ⟨ i , ∅ ⟩) $ by csn_set [l3]
l5: $ G ⇒ isset (shiftp u) $ by shiftp_set
l6: $ … ⇒ isset (csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by cun_set [l4, l5]

lemma h3_val_in (G: hyps) (a i u: set): $ G ⇒ i ∊ a $ > $ G ⇒ u ⊆ a × ω $ > $ G ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u ∈ 𝒫 (a × ω) $
----
l1: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ z ∊ csn ⟨ i , ∅ ⟩ $ by ax
l2: $ … ⇒ z = ⟨ i , ∅ ⟩ $ by csn_elim [l1]
l3: $ … ⇒ ⟨ i , ∅ ⟩ = z $ by eq_sym [l2]
l4: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ i ∊ a $ by weaken [#1]
l5: $ … ⇒ i ∈ a $ by welc_wcel [l4]
l6: $ G , z ∊ csn ⟨ i , ∅ ⟩ ⇒ ∅ ∈ ω $ by omega_zero
l7: $ … ⇒ ⟨ i , ∅ ⟩ ∈ a × ω $ by cxp_intro_c [l5, l6]
l8: $ … ⇒ z ∈ a × ω $ by wcel_eq_l [l3, l7]
l9: $ … ⇒ z ∊ a × ω $ by wcel_welc [l8]
l10: $ … ⇒ csn ⟨ i , ∅ ⟩ ⊆ a × ω $ by subset_intro [l9]
l11: $ … ⇒ shiftp u ⊆ a × ω $ by shiftp_subset [#2]
l12: $ … ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u ⊆ a × ω $ by cun_least [l10, l11]
l13: $ G ⇒ isset (csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by h3_val_set
l14: $ … ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u ∈ 𝒫 (a × ω) $ by wcel_cpw [l13, l12]

lemma h3_shift_intro (G: hyps) (A: class) (i u: set): $ G ⇒ i ∊ A $ > $ G ⇒ u ⊆ A × ω $ > $ G ⇒ ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ∈ shift A $
----
l1: $ G ⇒ isset i $ by isset_var
l2: $ G ⇒ isset u $ by isset_var
l3: $ … ⇒ isset ⟨ i , u ⟩ $ by opair_set [l1, l2]
l4: $ G ⇒ isset (csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by h3_val_set
l5: $ … ⇒ isset ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ $ by opair_set [l3, l4]
l6: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ i ∊ A $ by weaken [#1]
l7: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ u ⊆ A × ω $ by weaken [#2]
l8: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ $ by ax
l9: $ … ⇒ u ⊆ A × ω ∧ c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ $ by and_intro [l7, l8]
l10: $ … ⇒ i ∊ A ∧ u ⊆ A × ω ∧ c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ $ by and_intro [l6, l9]
l11: $ … ⇒ ∃ k (i ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ i , k ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp k ⟩) $ by ex_intro [l10]
l12: $ … ⇒ ∃ j ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $ by ex_intro [l11]
l13: $ G , c = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ⇒ c ∊ shift A $ by cab_intro [l12]
l14: $ … ⇒ ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ∈ shift A $ by wcel_intro [l8, l13]
l15: $ … ⇒ ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩ ∈ shift A $ by isset_elim [l5, l14]

lemma h3_shift_elim (G: hyps) {i u: set} (A: class) (p q: set): $ G ⇒ ⟨ p , q ⟩ ∈ shift A $ >
  $ G ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $
----
l1: $ G , c = ⟨ p , q ⟩ , c ∊ shift A ⇒ c ∊ shift A $ by ax
l2: $ … ⇒ ∃ j ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $ by cab_elim [l1]
l3: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ $ by ax
l4: $ … ⇒ j ∊ A $ by and_elim_l [l3]
l5: $ … ⇒ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ $ by and_elim_r [l3]
l6: $ … ⇒ k ⊆ A × ω $ by and_elim_l [l5]
l7: $ … ⇒ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ $ by and_elim_r [l5]
l8: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ c = ⟨ p , q ⟩ $ by ax
l9: $ … ⇒ ⟨ p , q ⟩ = c $ by eq_sym [l8]
l10: $ … ⇒ ⟨ p , q ⟩ = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ $ by eq_trans [l9, l7]
l11: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset p $ by isset_var
l12: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset q $ by isset_var
l13: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset j $ by isset_var
l14: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset k $ by isset_var
l15: $ … ⇒ isset ⟨ j , k ⟩ $ by opair_set [l13, l14]
l16: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩ ⇒ isset (csn ⟨ j , ∅ ⟩ ∪ shiftp k) $ by h3_val_set
l17: $ … ⇒ p = ⟨ j , k ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by opair_inj_c [l10, l11, l12, l15, l16]
l18: $ … ⇒ k ⊆ A × ω ∧ p = ⟨ j , k ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by and_intro [l6, l17]
l19: $ … ⇒ j ∊ A ∧ k ⊆ A × ω ∧ p = ⟨ j , k ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by and_intro [l4, l18]
l20: $ … ⇒ ∃ u (j ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ j , u ⟩ ∧ q = csn ⟨ j , ∅ ⟩ ∪ shiftp u) $ by ex_intro [l19]
l21: $ … ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by ex_intro [l20]
l22: $ G , c = ⟨ p , q ⟩ , c ∊ shift A , ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) ⇒ ∃ k (j ∊ A ∧ k ⊆ A × ω ∧ c = ⟨ ⟨ j , k ⟩ , csn ⟨ j , ∅ ⟩ ∪ shiftp k ⟩) $ by ax
l23: $ … ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by ex_elim [l22, l21]
l24: $ … ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by ex_elim [l2, l23]
l25: $ … ⇒ ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ p = ⟨ i , u ⟩ ∧ q = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by wcel_elim [#1, l24]

shift_injects
-------------
l1: $ G , ⟨ x , y ⟩ ∈ shift a , ⟨ x , z ⟩ ∈ shift a ⇒ ⟨ x , y ⟩ ∈ shift a $ by ax
l2: $ G , ⟨ x , y ⟩ ∈ shift a , ⟨ x , z ⟩ ∈ shift a ⇒ ⟨ x , z ⟩ ∈ shift a $ by ax
l3: $ … ⇒ ∃ i ∃ u (i ∊ a ∧ u ⊆ a × ω ∧ x = ⟨ i , u ⟩ ∧ y = csn ⟨ i , ∅ ⟩ ∪ shiftp u) $ by h3_shift_elim [l1]
l4: $ … ⇒ ∃ j ∃ k (j ∊ a ∧ k ⊆ a × ω ∧ x = ⟨ j , k ⟩ ∧ z = csn ⟨ j , ∅ ⟩ ∪ shiftp k) $ by h3_shift_elim [l2]
l10: $ G , ⟨ x , y ⟩ ∈ shift a , ⟨ x , z ⟩ ∈ shift a , i ∊ a ∧ u ⊆ a × ω ∧ x = ⟨ i , u ⟩ ∧ y = csn ⟨ i , ∅ ⟩ ∪ shiftp u , j ∊ a ∧ k ⊆ a × ω ∧ x = ⟨ j , k ⟩ ∧ z = csn ⟨ j , ∅ ⟩ ∪ shiftp k ⇒ i ∊ a ∧ u ⊆ a × ω ∧ x = ⟨ i , u ⟩ ∧ y = csn ⟨ i , ∅ ⟩ ∪ shiftp u $ by ax
l11: $ … ⇒ u ⊆ a × ω ∧ x = ⟨ i , u ⟩ ∧ y = csn ⟨ i , ∅ ⟩ ∪ shiftp u $ by and_elim_r [l10]
l12: $ … ⇒ x = ⟨ i , u ⟩ ∧ y = csn ⟨ i , ∅ ⟩ ∪ shiftp u $ by and_elim_r [l11]
l13: $ … ⇒ x = ⟨ i , u ⟩ $ by and_elim_l [l12]
l14: $ … ⇒ y = csn ⟨ i , ∅ ⟩ ∪ shiftp u $ by and_elim_r [l12]
l20: $ G , ⟨ x , y ⟩ ∈ shift a , ⟨ x , z ⟩ ∈ shift a , i ∊ a ∧ u ⊆ a × ω ∧ x = ⟨ i , u ⟩ ∧ y = csn ⟨ i , ∅ ⟩ ∪ shiftp u , j ∊ a ∧ k ⊆ a × ω ∧ x = ⟨ j , k ⟩ ∧ z = csn ⟨ j , ∅ ⟩ ∪ shiftp k ⇒ j ∊ a ∧ k ⊆ a × ω ∧ x = ⟨ j , k ⟩ ∧ z = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by ax
l21: $ … ⇒ k ⊆ a × ω ∧ x = ⟨ j , k ⟩ ∧ z = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by and_elim_r [l20]
l22: $ … ⇒ x = ⟨ j , k ⟩ ∧ z = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by and_elim_r [l21]
l23: $ … ⇒ x = ⟨ j , k ⟩ $ by and_elim_l [l22]
l24: $ … ⇒ z = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by and_elim_r [l22]
l30: $ … ⇒ ⟨ i , u ⟩ = x $ by eq_sym [l13]
l31: $ … ⇒ ⟨ i , u ⟩ = ⟨ j , k ⟩ $ by eq_trans [l30, l23]
l32: $ … ⇒ i = j $ by opair_inj_l [l31]
l33: $ … ⇒ u = k $ by opair_inj_r [l31]
l34: $ … ⇒ csn ⟨ i , ∅ ⟩ ∪ shiftp u = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by h3_val_eq [l32, l33]
l35: $ … ⇒ y = csn ⟨ j , ∅ ⟩ ∪ shiftp k $ by eq_trans [l14, l34]
