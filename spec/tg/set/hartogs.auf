lemma h3_pick {x y: set} (G: hyps x y) (a s f g d z: set):
  $ G ⇒ functional g $ > $ G ⇒ functional d $ > $ G ⇒ ∀ x (x ∊ a → g' x ∈ injs (f' x) s) $ > $ G ⇒ ∀ y (y ∊ ⋃ (img f a) → d' y ∈ a ∧ y ∊ f' d' y) $ > $ G ⇒ z ∊ ⋃ (img f a) $ >
  $ G ⇒ d' z ∈ a ∧ z ∊ f' d' z ∧ injects (g' d' z) (f' d' z) s $
----
l1: $ … ⇒ z ∊ ⋃ (img f a) → d' z ∈ a ∧ z ∊ f' d' z $ by all_elim [#4]
l2: $ … ⇒ d' z ∈ a ∧ z ∊ f' d' z $ by imp_elim [l1, #5]
l3: $ … ⇒ d' z ∈ a $ by and_elim_l [l2]
l4: $ … ⇒ z ∊ f' d' z $ by and_elim_r [l2]
l5: $ … ⇒ isset (d' z) $ by fv_set [#2]
l6: $ G , b = d' z ⇒ b = d' z $ by ax
l7: $ … ⇒ d' z = b $ by eq_sym [l6]
l8: $ G , b = d' z ⇒ d' z ∈ a $ by weaken [l3]
l9: $ … ⇒ b ∈ a $ by wcel_eq_l [l7, l8]
l10: $ … ⇒ b ∊ a $ by wcel_welc [l9]
l11: $ G , b = d' z ⇒ ∀ x (x ∊ a → g' x ∈ injs (f' x) s) $ by weaken [#3]
l12: $ … ⇒ b ∊ a → g' b ∈ injs (f' b) s $ by all_elim [l11]
