l7: $ … ⇒ x ∊ hartogs B $ by hartogs_intro [l3, l6]
l8: $ … ⇒ hartogs A ⊆ hartogs B $ by subset_intro [l7]

hartogs_congr
-------------
l0: $ seqt y y $ by seqt_refl
l1: $ ord y ⟺ ord y $ by iff_refl
l2: $ inj_into y A ⟺ inj_into y B $ by inj_into_congr [l0, #1]
l3: $ (ord y ∧ inj_into y A) ⟺ (ord y ∧ inj_into y B) $ by and_congr [l1, l2]
l4: $ {y | ord y ∧ inj_into y A} ≐ {y | ord y ∧ inj_into y B} $ by cab_congr [l3]

hartogs_eq
----------
