l6: $ … ⇒ a ∊ u ∧ universe u → u ∊ univs a $ by imp_intro [l5]
l7: $ … ⇒ ∀ u (a ∊ u ∧ universe u → u ∊ univs a) $ by all_intro [l6]
l8: $ G ⇒ ∃ u (a ∊ u ∧ universe u) $ by ax_universe
l9: $ … ⇒ ∃ u (u ∊ univs a) $ by ex_mp [l7, l8]

