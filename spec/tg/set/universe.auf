-- Proofs for universe.mm0.

universe_trans
--------------
l1: $ … ⇒ transitive U $ by and_elim_l [#1]

universe_elem_subset
--------------------
l1: $ … ⇒ transitive U $ by universe_trans [#1]
l2: $ … ⇒ a ⊆ U $ by transitive_subset [l1, #2]

universe_elem_subset_c
----------------------
l1: $ G , v = A , v ∊ U ⇒ v ∊ U $ by ax
l2: $ G , v = A , v ∊ U ⇒ universe U $ by weaken [#1]
l3: $ … ⇒ v ⊆ U $ by universe_elem_subset [l2, l1]
l4: $ G , v = A , v ∊ U ⇒ v = A $ by ax
l5: $ … ⇒ A ⊆ U $ by subset_eq_l [l4, l3]
l6: $ … ⇒ A ⊆ U $ by wcel_elim [#2, l5]

universe_elem_elem
------------------
l1: $ … ⇒ transitive U $ by universe_trans [#1]
l2: $ … ⇒ b ∊ U $ by transitive_elim [l1, #2, #3]

universe_elem_elem_c
--------------------
t1: $ G , u = A , u ∊ U ⇒ u = A $ by ax
t2: $ … ⇒ A = u $ by eq_sym [t1]
t3: $ G , u = A , u ∊ U ⇒ B ∈ A $ by weaken [#3]
t4: $ … ⇒ B ∈ u $ by wcel_eq_r [t2, t3]
t5: $ G , u = A , u ∊ U , v = B , v ∊ u ⇒ v ∊ u $ by ax
t6: $ G , u = A , u ∊ U , v = B , v ∊ u ⇒ u ∊ U $ by ax
t7: $ G , u = A , u ∊ U , v = B , v ∊ u ⇒ universe U $ by weaken [#1]
t8: $ … ⇒ v ∊ U $ by universe_elem_elem [t7, t6, t5]
t9: $ G , u = A , u ∊ U , v = B , v ∊ u ⇒ v = B $ by ax
t10: $ … ⇒ B ∈ U $ by wcel_intro [t9, t8]
t11: $ … ⇒ B ∈ U $ by wcel_elim [t4, t10]
t12: $ … ⇒ B ∈ U $ by wcel_elim [#2, t11]

universe_cpr
------------
l1: $ … ⇒ ∀ x ∀ y (x ∊ U ∧ y ∊ U → cpr x y ∈ U) ∧ ∀ x (x ∊ U → 𝒫 x ∈ U) ∧ ∀ x ∀ f (x ∊ U ∧ ⌈ f : x → U ⌉ → ⋃ (img f x) ∈ U) $ by and_elim_r [#1]
l2: $ … ⇒ ∀ x ∀ y (x ∊ U ∧ y ∊ U → cpr x y ∈ U) $ by and_elim_l [l1]
l3: $ … ⇒ ∀ y (a ∊ U ∧ y ∊ U → cpr a y ∈ U) $ by all_elim [l2]
l4: $ … ⇒ a ∊ U ∧ b ∊ U → cpr a b ∈ U $ by all_elim [l3]
l5: $ … ⇒ a ∊ U ∧ b ∊ U $ by and_intro [#2, #3]
l6: $ … ⇒ cpr a b ∈ U $ by imp_elim [l4, l5]

universe_cpr_c
--------------
l1: $ G , u = A , u ∊ U , v = B , v ∊ U ⇒ universe U $ by weaken [#1]
l2: $ G , u = A , u ∊ U , v = B , v ∊ U ⇒ u ∊ U $ by ax
l3: $ G , u = A , u ∊ U , v = B , v ∊ U ⇒ v ∊ U $ by ax
l4: $ … ⇒ cpr u v ∈ U $ by universe_cpr [l1, l2, l3]
l5: $ G , u = A , u ∊ U , v = B , v ∊ U ⇒ u = A $ by ax
l6: $ G , u = A , u ∊ U , v = B , v ∊ U ⇒ v = B $ by ax
l7: $ … ⇒ cpr u v = cpr A B $ by cpr_eq [l5, l6]
l8: $ … ⇒ cpr A B ∈ U $ by wcel_eq_l [l7, l4]
l9: $ G , u = A , u ∊ U ⇒ B ∈ U $ by weaken [#3]
l10: $ … ⇒ cpr A B ∈ U $ by wcel_elim [l9, l8]
l11: $ … ⇒ cpr A B ∈ U $ by wcel_elim [#2, l10]

universe_cpw
------------
l1: $ … ⇒ ∀ x ∀ y (x ∊ U ∧ y ∊ U → cpr x y ∈ U) ∧ ∀ x (x ∊ U → 𝒫 x ∈ U) ∧ ∀ x ∀ f (x ∊ U ∧ ⌈ f : x → U ⌉ → ⋃ (img f x) ∈ U) $ by and_elim_r [#1]
l2: $ … ⇒ ∀ x (x ∊ U → 𝒫 x ∈ U) ∧ ∀ x ∀ f (x ∊ U ∧ ⌈ f : x → U ⌉ → ⋃ (img f x) ∈ U) $ by and_elim_r [l1]
l3: $ … ⇒ ∀ x (x ∊ U → 𝒫 x ∈ U) $ by and_elim_l [l2]
l4: $ … ⇒ a ∊ U → 𝒫 a ∈ U $ by all_elim [l3]
l5: $ … ⇒ 𝒫 a ∈ U $ by imp_elim [l4, #2]

universe_cpw_c
--------------
