l4: $ {u | universe u ∧ A ∈ u} ≐ {u | universe u ∧ B ∈ u} $ by cab_congr [l3]

sb_c_univs
----------
l1: $ ([[ x / t ]] {v | universe v ∧ A ∈ v}) ≐ {v | universe v ∧ ([[ x / t ]] A) ∈ v} $ by ceqt_refl

lemma u2_univ (G: hyps) {y: set} (A: class) (w: set):
  $ G ⇒ ∀ y (y ∊ A → universe y) $ > $ G ⇒ w ∊ A $ > $ G ⇒ universe w $
----
l1: $ … ⇒ w ∊ A → universe w $ by all_elim [#1]
l2: $ … ⇒ universe w $ by imp_elim [l1, #2]

lemma u2_wcel_cint (G: hyps) {w: set} (A C: class):
  $ G ⇒ isset C $ > $ G , w ∊ A ⇒ C ∈ w $ > $ G ⇒ C ∈ cint A $
----
l1: $ G , v = C ⇒ v = C $ by ax
l2: $ G , v = C , w ∊ A ⇒ C ∈ w $ by weaken [#2]
l3: $ G , v = C , w ∊ A ⇒ v = C $ by ax
l4: $ … ⇒ C = v $ by eq_sym [l3]
l5: $ … ⇒ v ∈ w $ by wcel_eq_l [l4, l2]
l6: $ … ⇒ v ∊ w $ by wcel_welc [l5]
l7: $ … ⇒ v ∊ cint A $ by cint_intro [l6]
l8: $ … ⇒ C ∈ cint A $ by wcel_intro [l1, l7]
l9: $ … ⇒ C ∈ cint A $ by isset_elim [#1, l8]

