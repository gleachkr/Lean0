----------
l0: $ seqt y y $ by seqt_refl
l1: $ (y ∊ A) ⟺ (y ∊ B) $ by welc_congr [l0, #1]
l2: $ (x ∊ y) ⟺ (x ∊ y) $ by iff_refl
l3: $ (y ∊ A → x ∊ y) ⟺ (y ∊ B → x ∊ y) $ by im_congr [l1, l2]
l4: $ ∀ y (y ∊ A → x ∊ y) ⟺ ∀ y (y ∊ B → x ∊ y) $ by all_congr [l3]
l5: $ {x | ∀ y (y ∊ A → x ∊ y)} ≐ {x | ∀ y (y ∊ B → x ∊ y)} $ by cab_congr [l4]

