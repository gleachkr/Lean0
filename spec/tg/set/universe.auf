l7: $ … ⇒ 𝒫 A ∈ U $ by wcel_elim [#2, l6]

universe_cuni_fn
----------------
l1: $ … ⇒ ∀ x ∀ y (x ∊ U ∧ y ∊ U → cpr x y ∈ U) ∧ ∀ x (x ∊ U → 𝒫 x ∈ U) ∧ ∀ x ∀ g (x ∊ U ∧ ⌈ g : x → U ⌉ → ⋃ (img g x) ∈ U) $ by and_elim_r [#1]
l2: $ … ⇒ ∀ x (x ∊ U → 𝒫 x ∈ U) ∧ ∀ x ∀ g (x ∊ U ∧ ⌈ g : x → U ⌉ → ⋃ (img g x) ∈ U) $ by and_elim_r [l1]
l3: $ … ⇒ ∀ x ∀ g (x ∊ U ∧ ⌈ g : x → U ⌉ → ⋃ (img g x) ∈ U) $ by and_elim_r [l2]
l4: $ … ⇒ ∀ g (a ∊ U ∧ ⌈ g : a → U ⌉ → ⋃ (img g a) ∈ U) $ by all_elim [l3]
l5: $ … ⇒ a ∊ U ∧ ⌈ f : a → U ⌉ → ⋃ (img f a) ∈ U $ by all_elim [l4]
l6: $ … ⇒ a ∊ U ∧ ⌈ f : a → U ⌉ $ by and_intro [#2, #3]
l7: $ … ⇒ ⋃ (img f a) ∈ U $ by imp_elim [l5, l6]

universe_cuni_fn_c
------------------
l1: $ … ⇒ functional F $ by fn_into_functional [#3]
l1a: $ G ⇒ isset a $ by isset_var
l2: $ … ⇒ isset (F ↾ a) $ by cres_set [l1, l1a]
l3: $ … ⇒ ⌈ F ↾ a : a → U ⌉ $ by fn_into_cres [#3]
l4: $ G , f = F ↾ a ⇒ f = F ↾ a $ by ax
l5: $ … ⇒ F ↾ a = f $ by eq_sym [l4]
l6: $ G , f = F ↾ a ⇒ a = a $ by eq_refl
l7: $ G , f = F ↾ a ⇒ U = U $ by eq_refl
l8: $ G , f = F ↾ a ⇒ ⌈ F ↾ a : a → U ⌉ $ by weaken [l3]
l9: $ … ⇒ ⌈ f : a → U ⌉ $ by fn_into_eq [l5, l6, l7, l8]
l10: $ G , f = F ↾ a ⇒ universe U $ by weaken [#1]
l11: $ G , f = F ↾ a ⇒ a ∊ U $ by weaken [#2]
l12: $ … ⇒ ⋃ (img f a) ∈ U $ by universe_cuni_fn [l10, l11, l9]
l13: $ … ⇒ img f a = img (F ↾ a) a $ by img_eq [l4, l6]
l14: $ G , f = F ↾ a ⇒ img (F ↾ a) a = img F a $ by img_cres
l15: $ … ⇒ img f a = img F a $ by eq_trans [l13, l14]
l16: $ … ⇒ ⋃ (img f a) = ⋃ (img F a) $ by cuni_eq [l15]
l17: $ … ⇒ ⋃ (img F a) ∈ U $ by wcel_eq_l [l16, l12]
l18: $ … ⇒ ⋃ (img F a) ∈ U $ by isset_elim [l2, l17]

