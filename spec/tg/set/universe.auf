w6: $ G , m = cpr a b , m ∊ o ∧ universe o ⇒ a ∊ cpr a b $ by cpr_intro_l
w7: $ … ⇒ a ∊ m $ by welc_eq [w5, w6]
w8: $ G , m = cpr a b , m ∊ o ∧ universe o ⇒ b ∊ cpr a b $ by cpr_intro_r
