l4: $ G , k = ⟨ a , b ⟩ , k ∊ cgr x B ⇒ (∃ x ∃ y (k = ⟨ x , y ⟩ ∧ y = B)) ↔ ∃ u ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by weaken [l3]
