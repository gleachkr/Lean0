m7: $ … ⇒ cdm z = a $ by eq_trans [m5, m6]
m8: $ G , z = B , v ∊ a ⇒ ∀ k (k ∊ a → B' k = F' (B ↾ k)) $ by weaken [#6]
m9: $ … ⇒ v ∊ a → B' v = F' (B ↾ v) $ by all_elim [m8]
m10: $ G , z = B , v ∊ a ⇒ v ∊ a $ by ax
m11: $ … ⇒ B' v = F' (B ↾ v) $ by imp_elim [m9, m10]
m12: $ G , z = B , v ∊ a ⇒ z = B $ by ax
m13: $ G , z = B , v ∊ a ⇒ v = v $ by eq_refl
m14: $ … ⇒ z' v = B' v $ by fv_eq [m12, m13]
m15: $ … ⇒ B = z $ by eq_sym [m12]
m16: $ … ⇒ B ↾ v = z ↾ v $ by cres_eq [m15, m13]
m17: $ G , z = B , v ∊ a ⇒ F = F $ by eq_refl
m18: $ … ⇒ F' (B ↾ v) = F' (z ↾ v) $ by fv_eq [m17, m16]
m19: $ … ⇒ z' v = F' (B ↾ v) $ by eq_trans [m14, m11]
m20: $ … ⇒ z' v = F' (z ↾ v) $ by eq_trans [m19, m18]
m21: $ … ⇒ v ∊ a → z' v = F' (z ↾ v) $ by imp_intro [m20]
m22: $ … ⇒ ∀ v (v ∊ a → z' v = F' (z ↾ v)) $ by all_intro [m21]
m23: $ … ⇒ cdm z = a ∧ ∀ v (v ∊ a → z' v = F' (z ↾ v)) $ by and_intro [m7, m22]
m24: $ … ⇒ rel z ∧ cdm z = a ∧ ∀ v (v ∊ a → z' v = F' (z ↾ v)) $ by and_intro [m4, m23]
m25: $ … ⇒ functional z ∧ rel z ∧ cdm z = a ∧ ∀ v (v ∊ a → z' v = F' (z ↾ v)) $ by and_intro [m3, m24]
m26a: $ G , z = B ⇒ ord a $ by weaken [#2]
m26: $ … ⇒ ord a ∧ functional z ∧ rel z ∧ cdm z = a ∧ ∀ v (v ∊ a → z' v = F' (z ↾ v)) $ by and_intro [m26a, m25]
m27: $ … ⇒ ∃ w (ord w ∧ functional z ∧ rel z ∧ cdm z = w ∧ ∀ v (v ∊ w → z' v = F' (z ↾ v))) $ by ex_intro [m26]
m28: $ … ⇒ z ∊ {u | ∃ w (ord w ∧ functional u ∧ rel u ∧ cdm u = w ∧ ∀ v (v ∊ w → u' v = F' (u ↾ v)))} $ by cab_intro [m27]
m29: $ G , z = B ⇒ z ∊ trapx F $ by weaken [m28]
m30: $ … ⇒ B ∈ trapx F $ by wcel_intro [m1, m29]
m31: $ … ⇒ B ∈ trapx F $ by isset_elim [#1, m30]

