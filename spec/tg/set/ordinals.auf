l13: $ … ⇒ rel g $ by and_elim_l [l12]
l14: $ … ⇒ cdm g = a ∧ ∀ k (k ∊ a → g' k = F' (g ↾ k)) $ by and_elim_r [l12]
l15: $ … ⇒ cdm g = a $ by and_elim_l [l14]
l16: $ … ⇒ ∀ k (k ∊ a → g' k = F' (g ↾ k)) $ by and_elim_r [l14]
l17: $ … ⇒ functional g → rel g → cdm g = a → (∀ k (k ∊ a → g' k = F' (g ↾ k))) → c $ by imp_elim [l7, l9]
l18: $ … ⇒ rel g → cdm g = a → (∀ k (k ∊ a → g' k = F' (g ↾ k))) → c $ by imp_elim [l17, l11]
l19: $ … ⇒ cdm g = a → (∀ k (k ∊ a → g' k = F' (g ↾ k))) → c $ by imp_elim [l18, l13]
l20: $ … ⇒ (∀ k (k ∊ a → g' k = F' (g ↾ k))) → c $ by imp_elim [l19, l15]
l21: $ … ⇒ c $ by imp_elim [l20, l16]
l22: $ … ⇒ c $ by ex_elim [l1, l21]

trapx_intro
-----------
m1: $ G , z = B ⇒ z = B $ by ax
