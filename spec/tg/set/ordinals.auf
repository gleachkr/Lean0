l17: $ … ⇒ b = (⟦ x / a ⟧ B) $ by eq_trans [l16, l15]
l18: $ G , k = ⟨ a , b ⟩ , ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) ⇒ ∃ y (k = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by ax
l19: $ … ⇒ b = (⟦ x / a ⟧ B) $ by ex_elim [l18, l17]
