l3: $ (∃ x (x = a ∧ z ∊ B)) ⟺ ∃ u (u = a ∧ z ∊ (⟦ x / u ⟧ B)) $ by ex_alpha
l4: $ z ∊ cap x B a ⇒ (∃ x (x = a ∧ z ∊ B)) ↔ ∃ u (u = a ∧ z ∊ (⟦ x / u ⟧ B)) $ by weaken [l3]
l5: $ … ⇒ ∃ u (u = a ∧ z ∊ (⟦ x / u ⟧ B)) $ by bi_elim_l [l4, l2]
l6: $ u = a ∧ z ∊ (⟦ x / u ⟧ B) ⇒ u = a ∧ z ∊ (⟦ x / u ⟧ B) $ by ax
