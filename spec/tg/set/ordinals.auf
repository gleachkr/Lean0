l5: $ G , w ∊ img (cgr x x) A , i ∊ A , ⟨ i , w ⟩ ∈ cgr x x ⇒ i ∊ A $ by ax
l6: $ … ⇒ w ∊ A $ by welc_eq_set [l4, l5]
l7: $ … ⇒ w ∊ A $ by img_elim [l1, l6]
l8: $ G , w ∊ A ⇒ w = w $ by eq_refl
l9: $ G , w ∊ A ⇒ ⟨ w , w ⟩ ∈ cgr x x $ by cgr_intro [l8]
l10: $ G , w ∊ A ⇒ w ∊ A $ by ax
l11: $ … ⇒ w ∊ img (cgr x x) A $ by img_intro [l10, l9]
l12: $ … ⇒ img (cgr x x) A = A $ by eq_intro [l7, l11]

cgr_congr
---------
l0: $ y ≐ y $ by ceqt_refl
l1: $ (y = B) ⟺ (y = D) $ by ceq_congr [l0, #1]
l2: $ (z = ⟨ x , y ⟩) ⟺ (z = ⟨ x , y ⟩) $ by iff_refl
l3: $ (z = ⟨ x , y ⟩ ∧ y = B) ⟺ (z = ⟨ x , y ⟩ ∧ y = D) $ by and_congr [l2, l1]
l4: $ (∃ y (z = ⟨ x , y ⟩ ∧ y = B)) ⟺ (∃ y (z = ⟨ x , y ⟩ ∧ y = D)) $ by ex_congr [l3]
l5: $ (∃ x ∃ y (z = ⟨ x , y ⟩ ∧ y = B)) ⟺ (∃ x ∃ y (z = ⟨ x , y ⟩ ∧ y = D)) $ by ex_congr [l4]
l6: $ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ y = B)} ≐ {z | ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ y = D)} $ by cab_congr [l5]

cgr_alpha
---------
l1: $ ∃ x ∃ v (z = ⟨ x , v ⟩ ∧ v = B) ⟺ ∃ y ∃ v (z = ⟨ y , v ⟩ ∧ v = (⟦ x / y ⟧ B)) $ by ex_alpha
l2: $ cgr x B ≐ cgr y (⟦ x / y ⟧ B) $ by cab_congr [l1]

lemma x1_cgr_sub {x: set} (G: hyps) (B D: class x) (w: set):
  $ G ⇒ ∀ x (B = D) $ > $ G , w ∊ cgr x B ⇒ w ∊ cgr x D $
----
l1: $ G , w ∊ cgr x B ⇒ w ∊ cgr x B $ by ax
l2: $ … ⇒ ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B) $ by cab_elim [l1]
l3: $ (∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B)) ⟺ ∃ u ∃ y (w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by ex_alpha
l4: $ G , w ∊ cgr x B ⇒ (∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = B)) ↔ ∃ u ∃ y (w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by weaken [l3]
l5: $ … ⇒ ∃ u ∃ y (w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by bi_elim_l [l4, l2]
l6: $ G , w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) $ by ax
l7: $ … ⇒ w = ⟨ u , y ⟩ $ by and_elim_l [l6]
l8: $ … ⇒ y = (⟦ x / u ⟧ B) $ by and_elim_r [l6]
l9: $ G , w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ ∀ x (B = D) $ by weaken [#1]
l10: $ … ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by all_elim [l9]
l11: $ … ⇒ y = (⟦ x / u ⟧ D) $ by eq_trans [l8, l10]
l12: $ … ⇒ w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ D) $ by and_intro [l7, l11]
l13: $ … ⇒ ∃ y (w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ D)) $ by ex_intro [l12]
l14: $ … ⇒ ∃ x ∃ y (w = ⟨ x , y ⟩ ∧ y = D) $ by ex_intro [l13]
l15: $ G , w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B) ⇒ w ∊ cgr x D $ by cab_intro [l14]
l16: $ G , ∃ y (w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) ⇒ ∃ y (w = ⟨ u , y ⟩ ∧ y = (⟦ x / u ⟧ B)) $ by ax
l17: $ … ⇒ w ∊ cgr x D $ by ex_elim [l16, l15]
l18: $ … ⇒ w ∊ cgr x D $ by ex_elim [l5, l17]

cgr_eq
------
l1: $ … ⇒ w ∊ cgr x D $ by x1_cgr_sub [#1]
l2: $ … ⇒ B = D $ by all_elim [#1]
l3: $ … ⇒ D = B $ by eq_sym [l2]
l4: $ … ⇒ ∀ x (D = B) $ by all_intro [l3]
l5: $ … ⇒ w ∊ cgr x B $ by x1_cgr_sub [l4]
l6: $ … ⇒ cgr x B = cgr x D $ by eq_intro [l1, l5]

sb_c_cgr
--------
l1: $ (⟦ y / t ⟧ {z | ∃ x ∃ w (z = ⟨ x , w ⟩ ∧ w = B)}) ≐ {z | ∃ x ∃ w (z = ⟨ x , w ⟩ ∧ w = (⟦ y / t ⟧ B))} $ by ceqt_refl

cres_cdm_self
-------------
l1: $ G ⇒ rel (R ↾ cdm R) $ by cres_rel
l2: $ G , ⟨ i , j ⟩ ∈ R ↾ cdm R ⇒ ⟨ i , j ⟩ ∈ R ↾ cdm R $ by ax
l3: $ … ⇒ i ∊ cdm R ∧ ⟨ i , j ⟩ ∈ R $ by cres_elim [l2]
l4: $ … ⇒ ⟨ i , j ⟩ ∈ R $ by and_elim_r [l3]
l5: $ G , ⟨ i , j ⟩ ∈ R ⇒ ⟨ i , j ⟩ ∈ R $ by ax
l6: $ … ⇒ i ∊ cdm R $ by cdm_intro [l5]
l7: $ … ⇒ ⟨ i , j ⟩ ∈ R ↾ cdm R $ by cres_intro [l6, l5]
l8: $ … ⇒ R ↾ cdm R = R $ by rel_eq_intro [l1, #1, l4, l7]

cres_subset_cdm
---------------
l1: $ G ⇒ rel (R ↾ A) $ by cres_rel
l2: $ G , ⟨ i , j ⟩ ∈ R ↾ A ⇒ ⟨ i , j ⟩ ∈ R ↾ A $ by ax
l3: $ … ⇒ i ∊ A ∧ ⟨ i , j ⟩ ∈ R $ by cres_elim [l2]
l4: $ … ⇒ ⟨ i , j ⟩ ∈ R $ by and_elim_r [l3]
l5: $ G , ⟨ i , j ⟩ ∈ R ⇒ ⟨ i , j ⟩ ∈ R $ by ax
l6: $ … ⇒ i ∊ cdm R $ by cdm_intro [l5]
l7: $ G , ⟨ i , j ⟩ ∈ R ⇒ cdm R ⊆ A $ by weaken [#2]
l8: $ … ⇒ i ∊ A $ by subset_elim [l7, l6]
l9: $ … ⇒ ⟨ i , j ⟩ ∈ R ↾ A $ by cres_intro [l8, l5]
l10: $ … ⇒ R ↾ A = R $ by rel_eq_intro [l1, #1, l4, l9]

cres_cres
---------
l1: $ G ⇒ rel (R ↾ B ↾ A) $ by cres_rel
l2: $ G ⇒ rel (R ↾ A) $ by cres_rel
l3: $ G , ⟨ i , j ⟩ ∈ R ↾ B ↾ A ⇒ ⟨ i , j ⟩ ∈ R ↾ B ↾ A $ by ax
l4: $ … ⇒ i ∊ A ∧ ⟨ i , j ⟩ ∈ R ↾ B $ by cres_elim [l3]
l5: $ … ⇒ i ∊ A $ by and_elim_l [l4]
l6: $ … ⇒ ⟨ i , j ⟩ ∈ R ↾ B $ by and_elim_r [l4]
l7: $ … ⇒ i ∊ B ∧ ⟨ i , j ⟩ ∈ R $ by cres_elim [l6]
l8: $ … ⇒ ⟨ i , j ⟩ ∈ R $ by and_elim_r [l7]
l9: $ … ⇒ ⟨ i , j ⟩ ∈ R ↾ A $ by cres_intro [l5, l8]
l10: $ G , ⟨ i , j ⟩ ∈ R ↾ A ⇒ ⟨ i , j ⟩ ∈ R ↾ A $ by ax
l11: $ … ⇒ i ∊ A ∧ ⟨ i , j ⟩ ∈ R $ by cres_elim [l10]
l12: $ … ⇒ i ∊ A $ by and_elim_l [l11]
l13: $ … ⇒ ⟨ i , j ⟩ ∈ R $ by and_elim_r [l11]
l14: $ G , ⟨ i , j ⟩ ∈ R ↾ A ⇒ A ⊆ B $ by weaken [#1]
l15: $ … ⇒ i ∊ B $ by subset_elim [l14, l12]
l16: $ … ⇒ ⟨ i , j ⟩ ∈ R ↾ B $ by cres_intro [l15, l13]
l17: $ … ⇒ ⟨ i , j ⟩ ∈ R ↾ B ↾ A $ by cres_intro [l12, l16]
l18: $ … ⇒ R ↾ B ↾ A = R ↾ A $ by rel_eq_intro [l1, l2, l9, l17]

cres_mono
---------
l1: $ G , w ∊ R ↾ A ⇒ w ∊ R ↾ A $ by ax
l2: $ G , w ∊ R ↾ A ⇒ rel (R ↾ A) $ by cres_rel
l3: $ G , w ∊ R ↾ A , w = ⟨ i , j ⟩ ⇒ w = ⟨ i , j ⟩ $ by ax
l4: $ G , w ∊ R ↾ A , w = ⟨ i , j ⟩ ⇒ w ∊ R ↾ A $ by ax
l5: $ … ⇒ w ∈ R ↾ A $ by welc_wcel [l4]
l6: $ … ⇒ ⟨ i , j ⟩ ∈ R ↾ A $ by wcel_eq_l [l3, l5]
l7: $ … ⇒ i ∊ A ∧ ⟨ i , j ⟩ ∈ R $ by cres_elim [l6]
l8: $ … ⇒ i ∊ A $ by and_elim_l [l7]
l9: $ … ⇒ ⟨ i , j ⟩ ∈ R $ by and_elim_r [l7]
l10: $ G , w ∊ R ↾ A , w = ⟨ i , j ⟩ ⇒ R ⊆ S $ by weaken [#1]
l11: $ … ⇒ ⟨ i , j ⟩ ∈ S $ by wcel_subset [l10, l9]
l12: $ … ⇒ ⟨ i , j ⟩ ∈ S ↾ A $ by cres_intro [l8, l11]
l13: $ … ⇒ ⟨ i , j ⟩ = w $ by eq_sym [l3]
l14: $ … ⇒ w ∈ S ↾ A $ by wcel_eq_l [l13, l12]
l15: $ … ⇒ w ∊ S ↾ A $ by wcel_welc [l14]
l16: $ … ⇒ w ∊ S ↾ A $ by rel_elim [l2, l1, l15]
l17: $ … ⇒ R ↾ A ⊆ S ↾ A $ by subset_intro [l16]

cres_cun_csn_self
-----------------
l1: $ G ⇒ rel ((R ∪ csn ⟨ a , c ⟩) ↾ a) $ by cres_rel
l2: $ G , ⟨ i , j ⟩ ∈ (R ∪ csn ⟨ a , c ⟩) ↾ a ⇒ ⟨ i , j ⟩ ∈ (R ∪ csn ⟨ a , c ⟩) ↾ a $ by ax
l3: $ … ⇒ i ∊ a ∧ ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by cres_elim [l2]
l4: $ … ⇒ i ∊ a $ by and_elim_l [l3]
l5: $ … ⇒ ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by and_elim_r [l3]
l6: $ … ⇒ ⟨ i , j ⟩ ∈ R ∨ (i = a ∧ j = c) $ by cun_csn_opair_elim [l5]
l7: $ G , ⟨ i , j ⟩ ∈ (R ∪ csn ⟨ a , c ⟩) ↾ a , ⟨ i , j ⟩ ∈ R ⇒ ⟨ i , j ⟩ ∈ R $ by ax
l8: $ G , ⟨ i , j ⟩ ∈ (R ∪ csn ⟨ a , c ⟩) ↾ a , i = a ∧ j = c ⇒ i = a ∧ j = c $ by ax
l9: $ … ⇒ i = a $ by and_elim_l [l8]
l10: $ G , ⟨ i , j ⟩ ∈ (R ∪ csn ⟨ a , c ⟩) ↾ a , i = a ∧ j = c ⇒ i ∊ a $ by weaken [l4]
l11: $ … ⇒ a ∊ a $ by welc_eq_set [l9, l10]
l12: $ … ⇒ ⊥ $ by notin_self [l11]
l13: $ … ⇒ ⟨ i , j ⟩ ∈ R $ by bot_elim [l12]
l14: $ … ⇒ ⟨ i , j ⟩ ∈ R $ by or_elim [l6, l7, l13]
l15: $ G , ⟨ i , j ⟩ ∈ R ⇒ ⟨ i , j ⟩ ∈ R $ by ax
l16: $ … ⇒ i ∊ cdm R $ by cdm_intro [l15]
l17: $ G , ⟨ i , j ⟩ ∈ R ⇒ cdm R = a $ by weaken [#2]
l18: $ … ⇒ i ∊ a $ by welc_eq [l17, l16]
l19: $ G , ⟨ i , j ⟩ ∈ R ⇒ R ⊆ R ∪ csn ⟨ a , c ⟩ $ by cun_subset_l
l20: $ … ⇒ ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by wcel_subset [l19, l15]
l21: $ … ⇒ ⟨ i , j ⟩ ∈ (R ∪ csn ⟨ a , c ⟩) ↾ a $ by cres_intro [l18, l20]
l22: $ … ⇒ (R ∪ csn ⟨ a , c ⟩) ↾ a = R $ by rel_eq_intro [l1, #1, l14, l21]

cdm_cun_csn
-----------
l1: $ G , w ∊ cdm (R ∪ csn ⟨ a , c ⟩) ⇒ w ∊ cdm (R ∪ csn ⟨ a , c ⟩) $ by ax
l2: $ G , w ∊ cdm (R ∪ csn ⟨ a , c ⟩) , ⟨ w , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ ⇒ ⟨ w , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by ax
l3: $ … ⇒ ⟨ w , j ⟩ ∈ R ∨ (w = a ∧ j = c) $ by cun_csn_opair_elim [l2]
l4: $ G , w ∊ cdm (R ∪ csn ⟨ a , c ⟩) , ⟨ w , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ , ⟨ w , j ⟩ ∈ R ⇒ ⟨ w , j ⟩ ∈ R $ by ax
l5: $ … ⇒ w ∊ cdm R $ by cdm_intro [l4]
l6: $ … ⇒ w ∊ cdm R ∪ csn a $ by cun_intro_l [l5]
l7: $ G , w ∊ cdm (R ∪ csn ⟨ a , c ⟩) , ⟨ w , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ , w = a ∧ j = c ⇒ w = a ∧ j = c $ by ax
l8: $ … ⇒ w = a $ by and_elim_l [l7]
l9: $ … ⇒ w ∊ csn a $ by csn_intro [l8]
l10: $ … ⇒ w ∊ cdm R ∪ csn a $ by cun_intro_r [l9]
l11: $ … ⇒ w ∊ cdm R ∪ csn a $ by or_elim [l3, l6, l10]
l12: $ … ⇒ w ∊ cdm R ∪ csn a $ by cdm_elim [l1, l11]
l13: $ G , w ∊ cdm R ∪ csn a ⇒ w ∊ cdm R ∪ csn a $ by ax
l14: $ … ⇒ w ∊ cdm R ∨ w ∊ csn a $ by cun_elim [l13]
l15: $ G , w ∊ cdm R ∪ csn a , w ∊ cdm R ⇒ w ∊ cdm R $ by ax
l16: $ G , w ∊ cdm R ∪ csn a , w ∊ cdm R , ⟨ w , j ⟩ ∈ R ⇒ ⟨ w , j ⟩ ∈ R $ by ax
l17: $ G , w ∊ cdm R ∪ csn a , w ∊ cdm R , ⟨ w , j ⟩ ∈ R ⇒ R ⊆ R ∪ csn ⟨ a , c ⟩ $ by cun_subset_l
l18: $ … ⇒ ⟨ w , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by wcel_subset [l17, l16]
l19: $ … ⇒ w ∊ cdm (R ∪ csn ⟨ a , c ⟩) $ by cdm_intro [l18]
l20: $ … ⇒ w ∊ cdm (R ∪ csn ⟨ a , c ⟩) $ by cdm_elim [l15, l19]
l21: $ G , w ∊ cdm R ∪ csn a , w ∊ csn a ⇒ w ∊ csn a $ by ax
l22: $ … ⇒ w = a $ by csn_elim [l21]
l23: $ … ⇒ a = w $ by eq_sym [l22]
l24: $ G , w ∊ cdm R ∪ csn a , w ∊ csn a ⇒ ⟨ a , c ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by cun_csn_opair_intro
l25: $ … ⇒ a ∊ cdm (R ∪ csn ⟨ a , c ⟩) $ by cdm_intro [l24]
l26: $ … ⇒ w ∊ cdm (R ∪ csn ⟨ a , c ⟩) $ by welc_eq_set [l23, l25]
l27: $ … ⇒ w ∊ cdm (R ∪ csn ⟨ a , c ⟩) $ by or_elim [l14, l20, l26]
l28: $ … ⇒ cdm (R ∪ csn ⟨ a , c ⟩) = cdm R ∪ csn a $ by eq_intro [l12, l27]

fv_cun_csn_self
---------------
l1: $ G , z ∊ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) ⇒ z ∊ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) $ by ax
l2: $ G , z ∊ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) , w ∊ ap (R ∪ csn ⟨ a , c ⟩) a , z ∊ w ⇒ w ∊ ap (R ∪ csn ⟨ a , c ⟩) a $ by ax
l3: $ … ⇒ ⟨ a , w ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by ap_elim [l2]
l4: $ … ⇒ ⟨ a , w ⟩ ∈ R ∨ (a = a ∧ w = c) $ by cun_csn_opair_elim [l3]
l5: $ G , z ∊ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) , w ∊ ap (R ∪ csn ⟨ a , c ⟩) a , z ∊ w , ⟨ a , w ⟩ ∈ R ⇒ ⟨ a , w ⟩ ∈ R $ by ax
l6: $ … ⇒ a ∊ cdm R $ by cdm_intro [l5]
l7: $ G , z ∊ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) , w ∊ ap (R ∪ csn ⟨ a , c ⟩) a , z ∊ w , ⟨ a , w ⟩ ∈ R ⇒ cdm R = a $ by weaken [#1]
l8: $ … ⇒ a ∊ a $ by welc_eq [l7, l6]
l9: $ … ⇒ ⊥ $ by notin_self [l8]
l10: $ … ⇒ w = c $ by bot_elim [l9]
l11: $ G , z ∊ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) , w ∊ ap (R ∪ csn ⟨ a , c ⟩) a , z ∊ w , a = a ∧ w = c ⇒ a = a ∧ w = c $ by ax
l12: $ … ⇒ w = c $ by and_elim_r [l11]
l13: $ … ⇒ w = c $ by or_elim [l4, l10, l12]
l14: $ G , z ∊ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) , w ∊ ap (R ∪ csn ⟨ a , c ⟩) a , z ∊ w ⇒ z ∊ w $ by ax
l15: $ … ⇒ z ∊ c $ by welc_eq [l13, l14]
l16: $ … ⇒ z ∊ c $ by cuni_elim [l1, l15]
l17: $ G , z ∊ c ⇒ z ∊ c $ by ax
l18: $ G , z ∊ c ⇒ ⟨ a , c ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by cun_csn_opair_intro
l19: $ … ⇒ c ∊ ap (R ∪ csn ⟨ a , c ⟩) a $ by ap_intro [l18]
l20: $ … ⇒ z ∊ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) $ by cuni_intro [l17, l19]
l21: $ … ⇒ ⋃ (ap (R ∪ csn ⟨ a , c ⟩) a) = c $ by eq_intro [l16, l20]

lemma d3_notin_cdm (G: hyps) (R: class) (a i j: set):
  $ G ⇒ ¬ a ∊ cdm R $ > $ G ⇒ ⟨ i , j ⟩ ∈ R $ > $ G ⇒ i = a $ > $ G ⇒ ⊥ $
----
l1: $ … ⇒ i ∊ cdm R $ by cdm_intro [#2]
l2: $ … ⇒ a ∊ cdm R $ by welc_eq_set [#3, l1]
l3: $ … ⇒ ⊥ $ by not_elim [#1, l2]

lemma d3_csn_side (G: hyps) (R: class) (a c i j: set):
  $ G ⇒ ¬ a ∊ cdm R $ > $ G ⇒ ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ > $ G ⇒ i = a $ > $ G ⇒ j = c $
----
l1: $ … ⇒ ⟨ i , j ⟩ ∈ R ∨ (i = a ∧ j = c) $ by cun_csn_opair_elim [#2]
l2: $ G , ⟨ i , j ⟩ ∈ R ⇒ ⟨ i , j ⟩ ∈ R $ by ax
l3: $ G , ⟨ i , j ⟩ ∈ R ⇒ ¬ a ∊ cdm R $ by weaken [#1]
l4: $ G , ⟨ i , j ⟩ ∈ R ⇒ i = a $ by weaken [#3]
l5: $ … ⇒ ⊥ $ by d3_notin_cdm [l3, l2, l4]
l6: $ … ⇒ j = c $ by bot_elim [l5]
l7: $ G , i = a ∧ j = c ⇒ i = a ∧ j = c $ by ax
l8: $ … ⇒ j = c $ by and_elim_r [l7]
l9: $ … ⇒ j = c $ by or_elim [l1, l6, l8]

functional_cun_csn
------------------
l1: $ G , ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ , ⟨ i , k ⟩ ∈ R ∪ csn ⟨ a , c ⟩ ⇒ ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by ax
l2: $ G , ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ , ⟨ i , k ⟩ ∈ R ∪ csn ⟨ a , c ⟩ ⇒ ⟨ i , k ⟩ ∈ R ∪ csn ⟨ a , c ⟩ $ by ax
l3: $ … ⇒ ⟨ i , j ⟩ ∈ R ∨ (i = a ∧ j = c) $ by cun_csn_opair_elim [l1]
l4: $ … ⇒ ⟨ i , k ⟩ ∈ R ∨ (i = a ∧ k = c) $ by cun_csn_opair_elim [l2]
l5: $ G , ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ , ⟨ i , k ⟩ ∈ R ∪ csn ⟨ a , c ⟩ , ⟨ i , j ⟩ ∈ R ⇒ ⟨ i , k ⟩ ∈ R ∨ (i = a ∧ k = c) $ by weaken [l4]
l6: $ G , ⟨ i , j ⟩ ∈ R ∪ csn ⟨ a , c ⟩ , ⟨ i , k ⟩ ∈ R ∪ csn ⟨ a , c ⟩ , ⟨ i , j ⟩ ∈ R , ⟨ i , k ⟩ ∈ R ⇒ ⟨ i , k ⟩ ∈ R $ by ax
