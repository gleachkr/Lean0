l7: $ … ⇒ [x/z] p $ by imp_elim [l4, l6]
l8: $ … ⇒ z ∊ x → [x/z] p $ by imp_intro [l7]
l9: $ … ⇒ ∀ z (z ∊ x → [x/z] p) $ by all_intro [l8]
