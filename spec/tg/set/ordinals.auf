f5: $ … ⇒ u ∊ cdm h $ by cdm_intro [f4]
f6: $ G , ord x , ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) , x ∊ cdm g , x ∊ cdm h , ⟨ u , v ⟩ ∈ h ↾ x ⇒ transitive (cdm g) $ by weaken [d7]
f7: $ G , ord x , ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) , x ∊ cdm g , x ∊ cdm h , ⟨ u , v ⟩ ∈ h ↾ x ⇒ x ∊ cdm g $ by ax
f8: $ … ⇒ u ∊ cdm g $ by transitive_elim [f6, f7, f3]
f9: $ G , ord x , ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) , x ∊ cdm g , x ∊ cdm h , ⟨ u , v ⟩ ∈ h ↾ x ⇒ ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) $ by ax
f10: $ … ⇒ u ∊ x → u ∊ cdm g → u ∊ cdm h → g' u = h' u $ by all_elim [f9]
f11: $ … ⇒ u ∊ cdm g → u ∊ cdm h → g' u = h' u $ by imp_elim [f10, f3]
f12: $ … ⇒ u ∊ cdm h → g' u = h' u $ by imp_elim [f11, f8]
f13: $ … ⇒ g' u = h' u $ by imp_elim [f12, f5]
f14: $ … ⇒ h' u = g' u $ by eq_sym [f13]
f15: $ G , ord x , ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) , x ∊ cdm g , x ∊ cdm h , ⟨ u , v ⟩ ∈ h ↾ x ⇒ functional h $ by weaken [d6]
f16: $ G , ord x , ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) , x ∊ cdm g , x ∊ cdm h , ⟨ u , v ⟩ ∈ h ↾ x ⇒ functional g $ by weaken [d5]
f17: $ … ⇒ ⟨ u , v ⟩ ∈ g $ by fv_pair_move [f15, f16, f4, f8, f14]
f18: $ … ⇒ ⟨ u , v ⟩ ∈ g ↾ x $ by cres_intro [f3, f17]
r1: $ G , ord x , ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) , x ∊ cdm g , x ∊ cdm h ⇒ rel (g ↾ x) $ by cres_rel
r2: $ G , ord x , ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) , x ∊ cdm g , x ∊ cdm h ⇒ rel (h ↾ x) $ by cres_rel
r3: $ … ⇒ g ↾ x = h ↾ x $ by rel_eq_intro [r1, r2, e17, f18]
r4: $ … ⇒ g' x = F' (g ↾ x) $ by trapx_step [d1, d3]
r5: $ … ⇒ h' x = F' (h ↾ x) $ by trapx_step [d2, d4]
r6: $ G , ord x , ∀ y (y ∊ x → y ∊ cdm g → y ∊ cdm h → g' y = h' y) , x ∊ cdm g , x ∊ cdm h ⇒ F = F $ by eq_refl
r7: $ … ⇒ F' (g ↾ x) = F' (h ↾ x) $ by fv_eq [r6, r3]
r8: $ … ⇒ F' (h ↾ x) = h' x $ by eq_sym [r5]
r9: $ … ⇒ g' x = F' (h ↾ x) $ by eq_trans [r4, r7]
r10: $ … ⇒ g' x = h' x $ by eq_trans [r9, r8]
r11: $ … ⇒ x ∊ cdm h → g' x = h' x $ by imp_intro [r10]
r12: $ … ⇒ x ∊ cdm g → x ∊ cdm h → g' x = h' x $ by imp_intro [r11]
r13: $ … ⇒ ∀ x (ord x → x ∊ cdm g → x ∊ cdm h → g' x = h' x) $ by ord_ind_f [r12]
r14: $ … ⇒ ord a → a ∊ cdm g → a ∊ cdm h → g' a = h' a $ by all_elim [r13]
r15: $ … ⇒ ord (cdm g) $ by trapx_ord [#1]
r16: $ … ⇒ ord a $ by ord_elem [r15, #3]
r17: $ … ⇒ a ∊ cdm g → a ∊ cdm h → g' a = h' a $ by imp_elim [r14, r16]
r18: $ … ⇒ a ∊ cdm h → g' a = h' a $ by imp_elim [r17, #3]
r19: $ … ⇒ g' a = h' a $ by imp_elim [r18, #4]

lemma d4_cres_sub (G: hyps) (F: class) (g h a u v: set):
  $ G ⇒ g ∊ trapx F $ > $ G ⇒ h ∊ trapx F $ > $ G ⇒ a ∊ cdm h $ >
  $ G ⇒ ⟨ u , v ⟩ ∈ g ↾ a $ > $ G ⇒ ⟨ u , v ⟩ ∈ h ↾ a $
----
l1: $ … ⇒ u ∊ a ∧ ⟨ u , v ⟩ ∈ g $ by cres_elim [#4]
l2: $ … ⇒ u ∊ a $ by and_elim_l [l1]
l3: $ … ⇒ ⟨ u , v ⟩ ∈ g $ by and_elim_r [l1]
l4: $ … ⇒ u ∊ cdm g $ by cdm_intro [l3]
l5: $ … ⇒ ord (cdm h) $ by trapx_ord [#2]
l6: $ … ⇒ transitive (cdm h) $ by ord_trans [l5]
l7: $ … ⇒ u ∊ cdm h $ by transitive_elim [l6, #3, l2]
l8: $ … ⇒ g' u = h' u $ by trapx_agree [#1, #2, l4, l7]
l9: $ … ⇒ functional g $ by trapx_functional [#1]
l10: $ … ⇒ functional h $ by trapx_functional [#2]
l11: $ … ⇒ ⟨ u , v ⟩ ∈ h $ by fv_pair_move [l9, l10, l3, l7, l8]
l12: $ … ⇒ ⟨ u , v ⟩ ∈ h ↾ a $ by cres_intro [l2, l11]

trapx_agree_cres
----------------
l1: $ G , ⟨ u , v ⟩ ∈ g ↾ a ⇒ ⟨ u , v ⟩ ∈ g ↾ a $ by ax
l2: $ G , ⟨ u , v ⟩ ∈ g ↾ a ⇒ g ∊ trapx F $ by weaken [#1]
l3: $ G , ⟨ u , v ⟩ ∈ g ↾ a ⇒ h ∊ trapx F $ by weaken [#2]
l4: $ G , ⟨ u , v ⟩ ∈ g ↾ a ⇒ a ∊ cdm h $ by weaken [#4]
l5: $ … ⇒ ⟨ u , v ⟩ ∈ h ↾ a $ by d4_cres_sub [l2, l3, l4, l1]
m1: $ G , ⟨ u , v ⟩ ∈ h ↾ a ⇒ ⟨ u , v ⟩ ∈ h ↾ a $ by ax
m2: $ G , ⟨ u , v ⟩ ∈ h ↾ a ⇒ g ∊ trapx F $ by weaken [#1]
m3: $ G , ⟨ u , v ⟩ ∈ h ↾ a ⇒ h ∊ trapx F $ by weaken [#2]
m4: $ G , ⟨ u , v ⟩ ∈ h ↾ a ⇒ a ∊ cdm g $ by weaken [#3]
m5: $ … ⇒ ⟨ u , v ⟩ ∈ g ↾ a $ by d4_cres_sub [m3, m2, m4, m1]
r1: $ G ⇒ rel (g ↾ a) $ by cres_rel
r2: $ G ⇒ rel (h ↾ a) $ by cres_rel
r3: $ … ⇒ g ↾ a = h ↾ a $ by rel_eq_intro [r1, r2, l5, m5]

trapx_subset
------------
s0: $ … ⇒ rel g $ by trapx_rel [#1]
s1: $ G , z ∊ g ⇒ rel g $ by weaken [s0]
s2: $ G , z ∊ g ⇒ z ∊ g $ by ax
p1: $ G , z ∊ g , z = ⟨ u , v ⟩ ⇒ z = ⟨ u , v ⟩ $ by ax
p2: $ G , z ∊ g , z = ⟨ u , v ⟩ ⇒ z ∊ g $ by ax
p3: $ … ⇒ ⟨ u , v ⟩ ∈ g $ by wcel_intro [p1, p2]
p4: $ … ⇒ u ∊ cdm g $ by cdm_intro [p3]
p5: $ G , z ∊ g , z = ⟨ u , v ⟩ ⇒ cdm g ⊆ cdm h $ by weaken [#3]
p6: $ … ⇒ u ∊ cdm h $ by subset_elim [p5, p4]
p7: $ G , z ∊ g , z = ⟨ u , v ⟩ ⇒ g ∊ trapx F $ by weaken [#1]
p8: $ G , z ∊ g , z = ⟨ u , v ⟩ ⇒ h ∊ trapx F $ by weaken [#2]
p9: $ … ⇒ g' u = h' u $ by trapx_agree [p7, p8, p4, p6]
p10: $ … ⇒ functional g $ by trapx_functional [p7]
p11: $ … ⇒ functional h $ by trapx_functional [p8]
