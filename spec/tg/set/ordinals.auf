l15: $ … ⇒ a = a ∧ z ∊ (⟦ x / a ⟧ B) $ by and_intro [l14, l12]
l16: $ … ⇒ ∃ x (x = a ∧ z ∊ B) $ by ex_intro [l15]
l17: $ z ∊ (⟦ x / a ⟧ B) ⇒ z ∊ cap x B a $ by cab_intro [l16]
l18: $ … ⇒ cap x B a = (⟦ x / a ⟧ B) $ by eq_intro [l11, l17]

