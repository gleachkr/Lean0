u10b: $ G , b = ⋃ a ⇒ functional ((⋃ (img (trapxd F) a))) $ by weaken [c13]
u10c: $ G , b = ⋃ a ⇒ rel ((⋃ (img (trapxd F) a))) $ by weaken [c14]
u10: $ … ⇒ (⋃ (img (trapxd F) a)) ∈ trapx F $ by trapx_intro [u10a, u3, u10b, u10c, u4, u9]
c19a: $ G ⇒ isset (⋃ a) $ by ax_union
c19: $ … ⇒ (⋃ (img (trapxd F) a)) ∈ trapx F $ by isset_elim [c19a, u10]
c20: $ … ⇒ (⋃ (img (trapxd F) a)) ∈ trapx F ∧ cdm (⋃ (img (trapxd F) a)) = ⋃ a $ by and_intro [c19, c16]

lemma d4_ex_cdm {g: set} (G: hyps g) (F: class) (j: set):
  $ G ⇒ ∃ g (g ∊ trapx F ∧ cdm g = j) $ > $ G ⇒ j ∊ cdm (trapxd F) $
----
l1: $ g ∊ trapx F ∧ cdm g = j ⇒ g ∊ trapx F ∧ cdm g = j $ by ax
l2: $ … ⇒ g ∊ trapx F $ by and_elim_l [l1]
l3: $ … ⇒ cdm g = j $ by and_elim_r [l1]
l4: $ … ⇒ ⟨ j , g ⟩ ∈ trapxd F $ by trapxd_intro [l2, l3]
l5: $ … ⇒ j ∊ cdm (trapxd F) $ by cdm_intro [l4]
l6: $ … ⇒ j ∊ cdm (trapxd F) $ by ex_elim [#1, l5]

lemma d4_wcel_ex {g: set} (G: hyps g) (F B A: class):
  $ G ⇒ B ∈ trapx F $ > $ G ⇒ cdm B = A $ > $ G ⇒ ∃ g (g ∊ trapx F ∧ cdm g = A) $
----
l1: $ G , z = B , z ∊ trapx F ⇒ z = B $ by ax
l2: $ … ⇒ cdm z = cdm B $ by cdm_eq [l1]
l3: $ G , z = B , z ∊ trapx F ⇒ cdm B = A $ by weaken [#2]
l4: $ … ⇒ cdm z = A $ by eq_trans [l2, l3]
l5: $ G , z = B , z ∊ trapx F ⇒ z ∊ trapx F $ by ax
l6: $ … ⇒ z ∊ trapx F ∧ cdm z = A $ by and_intro [l5, l4]
l7: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = A) $ by ex_intro [l6]
l8: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = A) $ by wcel_elim [#1, l7]

lemma d4_ext_ex {g: set} (G: hyps g) (F B A: class) (b: set):
  $ G ⇒ functional F $ > $ G ⇒ B ∈ trapx F $ > $ G ⇒ cdm B = b $ > $ G ⇒ suc b = A $ >
  $ G ⇒ ∃ g (g ∊ trapx F ∧ cdm g = A) $
----
w1: $ G , z = B , z ∊ trapx F ⇒ z = B $ by ax
w2: $ … ⇒ cdm z = cdm B $ by cdm_eq [w1]
w2a: $ G , z = B , z ∊ trapx F ⇒ cdm B = b $ by weaken [#3]
w3: $ … ⇒ cdm z = b $ by eq_trans [w2, w2a]
w4: $ G , z = B , z ∊ trapx F ⇒ z ∊ trapx F $ by ax
w5: $ G , z = B , z ∊ trapx F ⇒ functional F $ by weaken [#1]
w6: $ … ⇒ (z ∪ csn ⟨ b , F' z ⟩) ∈ trapx F $ by trapx_extend [w5, w4, w3]
v1: $ G , z = B , z ∊ trapx F , c = F' z ⇒ cdm (z ∪ csn ⟨ b , c ⟩) = cdm z ∪ csn b $ by cdm_cun_csn
v2: $ G , z = B , z ∊ trapx F , c = F' z ⇒ c = F' z $ by ax
v3: $ G , z = B , z ∊ trapx F , c = F' z ⇒ b = b $ by eq_refl
v4: $ … ⇒ ⟨ b , c ⟩ = ⟨ b , F' z ⟩ $ by opair_eq [v3, v2]
v5: $ … ⇒ csn ⟨ b , c ⟩ = csn ⟨ b , F' z ⟩ $ by csn_eq [v4]
v6: $ G , z = B , z ∊ trapx F , c = F' z ⇒ z = z $ by eq_refl
v7: $ … ⇒ (z ∪ csn ⟨ b , c ⟩) = (z ∪ csn ⟨ b , F' z ⟩) $ by cun_eq [v6, v5]
v8: $ … ⇒ cdm (z ∪ csn ⟨ b , c ⟩) = cdm (z ∪ csn ⟨ b , F' z ⟩) $ by cdm_eq [v7]
v9: $ … ⇒ cdm (z ∪ csn ⟨ b , F' z ⟩) = cdm (z ∪ csn ⟨ b , c ⟩) $ by eq_sym [v8]
v10: $ … ⇒ cdm (z ∪ csn ⟨ b , F' z ⟩) = cdm z ∪ csn b $ by eq_trans [v9, v1]
v11a: $ G , z = B , z ∊ trapx F , c = F' z ⇒ cdm z = b $ by weaken [w3]
v11b: $ G , z = B , z ∊ trapx F , c = F' z ⇒ csn b = csn b $ by eq_refl
v11: $ … ⇒ cdm z ∪ csn b = b ∪ csn b $ by cun_eq [v11a, v11b]
v12: $ … ⇒ cdm (z ∪ csn ⟨ b , F' z ⟩) = suc b $ by eq_trans [v10, v11]
v13a: $ G , z = B , z ∊ trapx F , c = F' z ⇒ suc b = A $ by weaken [#4]
v13: $ … ⇒ cdm (z ∪ csn ⟨ b , F' z ⟩) = A $ by eq_trans [v12, v13a]
v14a: $ G , z = B , z ∊ trapx F , c = F' z ⇒ (z ∪ csn ⟨ b , F' z ⟩) ∈ trapx F $ by weaken [w6]
v14: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = A) $ by d4_wcel_ex [v14a, v13]
w7: $ … ⇒ isset (F' z) $ by fv_set [w5]
w8: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = A) $ by isset_elim [w7, v14]
w9: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = A) $ by wcel_elim [#2, w8]

trapx_exists
------------
l1: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , k ∊ i ⇒ ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) $ by ax
l2: $ … ⇒ k ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = k) $ by all_elim [l1]
l3: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , k ∊ i ⇒ k ∊ i $ by ax
l4: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = k) $ by imp_elim [l2, l3]
l5: $ … ⇒ k ∊ cdm (trapxd F) $ by d4_ex_cdm [l4]
l6: $ … ⇒ k ∊ i → k ∊ cdm (trapxd F) $ by imp_intro [l5]
l7: $ … ⇒ ∀ k (k ∊ i → k ∊ cdm (trapxd F)) $ by all_intro [l6]
l8: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) ⇒ ord i $ by ax
l9: $ … ⇒ (⋃ (img (trapxd F) i)) ∈ trapx F ∧ cdm (⋃ (img (trapxd F) i)) = ⋃ i $ by trapx_cuni [l8, l7]
l10: $ … ⇒ (⋃ (img (trapxd F) i)) ∈ trapx F $ by and_elim_l [l9]
l11: $ … ⇒ cdm (⋃ (img (trapxd F) i)) = ⋃ i $ by and_elim_r [l9]
l12: $ … ⇒ i = ⋃ i ∨ i = suc (⋃ i) $ by ord_cuni_or_suc [l8]
m1: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = ⋃ i ⇒ i = ⋃ i $ by ax
m2: $ … ⇒ ⋃ i = i $ by eq_sym [m1]
m3a: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = ⋃ i ⇒ cdm (⋃ (img (trapxd F) i)) = ⋃ i $ by weaken [l11]
m3: $ … ⇒ cdm (⋃ (img (trapxd F) i)) = i $ by eq_trans [m3a, m2]
m4a: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = ⋃ i ⇒ (⋃ (img (trapxd F) i)) ∈ trapx F $ by weaken [l10]
m4: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = i) $ by d4_wcel_ex [m4a, m3]
n2: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = suc (⋃ i) , b = ⋃ i ⇒ b = ⋃ i $ by ax
n3: $ … ⇒ ⋃ i = b $ by eq_sym [n2]
n4a: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = suc (⋃ i) , b = ⋃ i ⇒ cdm (⋃ (img (trapxd F) i)) = ⋃ i $ by weaken [l11]
n4: $ … ⇒ cdm (⋃ (img (trapxd F) i)) = b $ by eq_trans [n4a, n3]
n6: $ … ⇒ suc b = suc (⋃ i) $ by suc_eq [n2]
n7: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = suc (⋃ i) , b = ⋃ i ⇒ i = suc (⋃ i) $ by ax
n8: $ … ⇒ suc (⋃ i) = i $ by eq_sym [n7]
n9: $ … ⇒ suc b = i $ by eq_trans [n6, n8]
n5a: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = suc (⋃ i) , b = ⋃ i ⇒ functional F $ by weaken [#1]
n5b: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = suc (⋃ i) , b = ⋃ i ⇒ (⋃ (img (trapxd F) i)) ∈ trapx F $ by weaken [l10]
n5: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = i) $ by d4_ext_ex [n5a, n5b, n4, n9]
n10a: $ G , ord i , ∀ j (j ∊ i → ∃ g (g ∊ trapx F ∧ cdm g = j)) , i = suc (⋃ i) ⇒ isset (⋃ i) $ by ax_union
n10: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = i) $ by isset_elim [n10a, n5]
l13: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = i) $ by or_elim [l12, m4, n10]
l14: $ … ⇒ ∀ i (ord i → ∃ g (g ∊ trapx F ∧ cdm g = i)) $ by ord_ind_f [l13]
l15: $ … ⇒ ord a → ∃ g (g ∊ trapx F ∧ cdm g = a) $ by all_elim [l14]
l16: $ … ⇒ ∃ g (g ∊ trapx F ∧ cdm g = a) $ by imp_elim [l15, #2]

trapx_exists_at
---------------
l1: $ … ⇒ ord (suc a) $ by ord_suc [#2]
l2: $ G ⇒ isset a $ by isset_var
l3: $ … ⇒ isset (suc a) $ by suc_set [l2]
l4: $ G , b = suc a ⇒ b = suc a $ by ax
l5: $ … ⇒ suc a = b $ by eq_sym [l4]
l6a: $ G , b = suc a ⇒ ord (suc a) $ by weaken [l1]
l6: $ … ⇒ ord b $ by ord_eq [l5, l6a]
l7: $ G , b = suc a ⇒ functional F $ by weaken [#1]
l8: $ … ⇒ ∃ u (u ∊ trapx F ∧ cdm u = b) $ by trapx_exists [l7, l6]
l9: $ G , b = suc a , u ∊ trapx F ∧ cdm u = b ⇒ u ∊ trapx F ∧ cdm u = b $ by ax
l10: $ … ⇒ u ∊ trapx F $ by and_elim_l [l9]
l11: $ … ⇒ cdm u = b $ by and_elim_r [l9]
l12: $ … ⇒ b = cdm u $ by eq_sym [l11]
l13: $ G , b = suc a , u ∊ trapx F ∧ cdm u = b ⇒ a ∊ suc a $ by suc_self
l14a: $ G , b = suc a , u ∊ trapx F ∧ cdm u = b ⇒ suc a = b $ by weaken [l5]
l14: $ … ⇒ a ∊ b $ by welc_eq [l14a, l13]
l15: $ … ⇒ a ∊ cdm u $ by welc_eq [l12, l14]
l16: $ … ⇒ u ∊ trapx F ∧ a ∊ cdm u $ by and_intro [l10, l15]
l17: $ … ⇒ ∃ g (g ∊ trapx F ∧ a ∊ cdm g) $ by ex_intro [l16]
l18: $ … ⇒ ∃ g (g ∊ trapx F ∧ a ∊ cdm g) $ by ex_elim [l8, l17]
l19: $ … ⇒ ∃ g (g ∊ trapx F ∧ a ∊ cdm g) $ by isset_elim [l3, l18]

trapx_congr
-----------
c1: $ g ↾ k ≐ g ↾ k $ by ceqt_refl
c2: $ F' (g ↾ k) ≐ H' (g ↾ k) $ by fv_congr [#1, c1]
c3: $ g' k ≐ g' k $ by ceqt_refl
c4: $ (g' k = F' (g ↾ k)) ⟺ (g' k = H' (g ↾ k)) $ by ceq_congr [c3, c2]
c5: $ (k ∊ a) ⟺ (k ∊ a) $ by iff_refl
c6: $ (k ∊ a → g' k = F' (g ↾ k)) ⟺ (k ∊ a → g' k = H' (g ↾ k)) $ by im_congr [c5, c4]
c7: $ ∀ k (k ∊ a → g' k = F' (g ↾ k)) ⟺ ∀ k (k ∊ a → g' k = H' (g ↾ k)) $ by all_congr [c6]
c8: $ (cdm g = a) ⟺ (cdm g = a) $ by iff_refl
c9: $ (cdm g = a ∧ ∀ k (k ∊ a → g' k = F' (g ↾ k))) ⟺ (cdm g = a ∧ ∀ k (k ∊ a → g' k = H' (g ↾ k))) $ by and_congr [c8, c7]
c10: $ rel g ⟺ rel g $ by iff_refl
c11: $ (rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = F' (g ↾ k))) ⟺ (rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = H' (g ↾ k))) $ by and_congr [c10, c9]
c12: $ functional g ⟺ functional g $ by iff_refl
c13: $ (functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = F' (g ↾ k))) ⟺ (functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = H' (g ↾ k))) $ by and_congr [c12, c11]
c14: $ ord a ⟺ ord a $ by iff_refl
c15: $ (ord a ∧ functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = F' (g ↾ k))) ⟺ (ord a ∧ functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = H' (g ↾ k))) $ by and_congr [c14, c13]
c16: $ ∃ a (ord a ∧ functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = F' (g ↾ k))) ⟺ ∃ a (ord a ∧ functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = H' (g ↾ k))) $ by ex_congr [c15]
c17: $ {g | ∃ a (ord a ∧ functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = F' (g ↾ k)))} ≐ {g | ∃ a (ord a ∧ functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = H' (g ↾ k)))} $ by cab_congr [c16]

sb_c_trapx
----------
l1: $ (⟦ x / t ⟧ {g | ∃ a (ord a ∧ functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = F' (g ↾ k)))}) ≐ {g | ∃ a (ord a ∧ functional g ∧ rel g ∧ cdm g = a ∧ ∀ k (k ∊ a → g' k = (⟦ x / t ⟧ F)' (g ↾ k)))} $ by ceqt_refl

trapxd_congr
------------
c0: $ seqt j j $ by seqt_refl
c1: $ trapx F ≐ trapx H $ by trapx_congr [#1]
c2: $ (j ∊ trapx F) ⟺ (j ∊ trapx H) $ by welc_congr [c0, c1]
c3: $ (cdm j = i) ⟺ (cdm j = i) $ by iff_refl
c4: $ (j ∊ trapx F ∧ cdm j = i) ⟺ (j ∊ trapx H ∧ cdm j = i) $ by and_congr [c2, c3]
c5: $ (z = ⟨ i , j ⟩) ⟺ (z = ⟨ i , j ⟩) $ by iff_refl
c6: $ (z = ⟨ i , j ⟩ ∧ j ∊ trapx F ∧ cdm j = i) ⟺ (z = ⟨ i , j ⟩ ∧ j ∊ trapx H ∧ cdm j = i) $ by and_congr [c5, c4]
c7: $ ∃ j (z = ⟨ i , j ⟩ ∧ j ∊ trapx F ∧ cdm j = i) ⟺ ∃ j (z = ⟨ i , j ⟩ ∧ j ∊ trapx H ∧ cdm j = i) $ by ex_congr [c6]
c8: $ ∃ i ∃ j (z = ⟨ i , j ⟩ ∧ j ∊ trapx F ∧ cdm j = i) ⟺ ∃ i ∃ j (z = ⟨ i , j ⟩ ∧ j ∊ trapx H ∧ cdm j = i) $ by ex_congr [c7]
c9: $ {z | ∃ i ∃ j (z = ⟨ i , j ⟩ ∧ j ∊ trapx F ∧ cdm j = i)} ≐ {z | ∃ i ∃ j (z = ⟨ i , j ⟩ ∧ j ∊ trapx H ∧ cdm j = i)} $ by cab_congr [c8]

sb_c_trapxd
-----------
l1: $ (⟦ x / t ⟧ {z | ∃ i ∃ j (z = ⟨ i , j ⟩ ∧ j ∊ trapx F ∧ cdm j = i)}) ≐ {z | ∃ i ∃ j (z = ⟨ i , j ⟩ ∧ j ∊ trapx (⟦ x / t ⟧ F) ∧ cdm j = i)} $ by ceqt_refl

trec_intro
----------
l1: $ G , w = ⟨ a , b ⟩ , w ∊ g ⇒ w ∊ g $ by ax
l2: $ G , w = ⟨ a , b ⟩ , w ∊ g ⇒ g ∊ trapx F $ by weaken [#1]
l3: $ … ⇒ w ∊ ⋃ (trapx F) $ by cuni_intro [l1, l2]
l4: $ G , w = ⟨ a , b ⟩ , w ∊ g ⇒ w = ⟨ a , b ⟩ $ by ax
l5: $ … ⇒ ⟨ a , b ⟩ ∈ ⋃ (trapx F) $ by wcel_intro [l4, l3]
l6: $ … ⇒ ⟨ a , b ⟩ ∈ trec F $ by wcel_elim [#2, l5]

trec_elim
---------
l1: $ G , w = ⟨ a , b ⟩ , y ∊ trapx F , w ∊ y ⇒ w = ⟨ a , b ⟩ $ by ax
l2: $ G , w = ⟨ a , b ⟩ , y ∊ trapx F , w ∊ y ⇒ w ∊ y $ by ax
l3: $ … ⇒ ⟨ a , b ⟩ ∈ y $ by wcel_intro [l1, l2]
l4: $ G , w = ⟨ a , b ⟩ , y ∊ trapx F , w ∊ y ⇒ y ∊ trapx F $ by ax
l5: $ … ⇒ y ∊ trapx F ∧ ⟨ a , b ⟩ ∈ y $ by and_intro [l4, l3]
l6: $ … ⇒ ∃ g (g ∊ trapx F ∧ ⟨ a , b ⟩ ∈ g) $ by ex_intro [l5]
l7: $ G , w = ⟨ a , b ⟩ , w ∊ ⋃ (trapx F) ⇒ w ∊ ⋃ (trapx F) $ by ax
l8: $ … ⇒ ∃ g (g ∊ trapx F ∧ ⟨ a , b ⟩ ∈ g) $ by cuni_elim [l7, l6]
l9: $ … ⇒ ∃ g (g ∊ trapx F ∧ ⟨ a , b ⟩ ∈ g) $ by wcel_elim [#1, l8]

trec_functional
---------------
l1: $ G , u ∊ trapx F ⇒ u ∊ trapx F $ by ax
l2: $ … ⇒ functional u $ by trapx_functional [l1]
l3: $ … ⇒ u ∊ trapx F → functional u $ by imp_intro [l2]
l4: $ … ⇒ ∀ u (u ∊ trapx F → functional u) $ by all_intro [l3]
h1: $ G , u ∊ trapx F ∧ v ∊ trapx F ⇒ u ∊ trapx F ∧ v ∊ trapx F $ by ax
h2: $ … ⇒ u ∊ trapx F $ by and_elim_l [h1]
h3: $ … ⇒ v ∊ trapx F $ by and_elim_r [h1]
h4: $ … ⇒ u ⊆ v ∨ v ⊆ u $ by trapx_chain [h2, h3]
h5: $ … ⇒ u ∊ trapx F ∧ v ∊ trapx F → u ⊆ v ∨ v ⊆ u $ by imp_intro [h4]
h6: $ … ⇒ ∀ v (u ∊ trapx F ∧ v ∊ trapx F → u ⊆ v ∨ v ⊆ u) $ by all_intro [h5]
h7: $ … ⇒ ∀ u ∀ v (u ∊ trapx F ∧ v ∊ trapx F → u ⊆ v ∨ v ⊆ u) $ by all_intro [h6]
l5: $ … ⇒ functional (⋃ (trapx F)) $ by functional_cuni_chain [l4, h7]

trec_rel
--------
l1: $ G , u ∊ trapx F ⇒ u ∊ trapx F $ by ax
l2: $ … ⇒ rel u $ by trapx_rel [l1]
l3: $ … ⇒ u ∊ trapx F → rel u $ by imp_intro [l2]
l4: $ … ⇒ ∀ u (u ∊ trapx F → rel u) $ by all_intro [l3]
l5: $ … ⇒ rel (⋃ (trapx F)) $ by rel_cuni [l4]

trec_cdm_ord
------------
l1: $ G , ⟨ a , y ⟩ ∈ trec F ⇒ ⟨ a , y ⟩ ∈ trec F $ by ax
l2: $ … ⇒ ∃ u (u ∊ trapx F ∧ ⟨ a , y ⟩ ∈ u) $ by trec_elim [l1]
l3: $ G , ⟨ a , y ⟩ ∈ trec F , u ∊ trapx F ∧ ⟨ a , y ⟩ ∈ u ⇒ u ∊ trapx F ∧ ⟨ a , y ⟩ ∈ u $ by ax
l4: $ … ⇒ u ∊ trapx F $ by and_elim_l [l3]
l5: $ … ⇒ ⟨ a , y ⟩ ∈ u $ by and_elim_r [l3]
l6: $ … ⇒ a ∊ cdm u $ by cdm_intro [l5]
l7: $ … ⇒ ord (cdm u) $ by trapx_ord [l4]
l8: $ … ⇒ ord a $ by ord_elem [l7, l6]
l9: $ … ⇒ ord a $ by ex_elim [l2, l8]
l10: $ … ⇒ ord a $ by cdm_elim [#1, l9]

trec_cdm
--------
l1: $ … ⇒ ∃ u (u ∊ trapx F ∧ a ∊ cdm u) $ by trapx_exists_at [#1, #2]
l2: $ G , u ∊ trapx F ∧ a ∊ cdm u ⇒ u ∊ trapx F ∧ a ∊ cdm u $ by ax
l3: $ … ⇒ u ∊ trapx F $ by and_elim_l [l2]
l4: $ … ⇒ a ∊ cdm u $ by and_elim_r [l2]
l5: $ G , u ∊ trapx F ∧ a ∊ cdm u , ⟨ a , v ⟩ ∈ u ⇒ ⟨ a , v ⟩ ∈ u $ by ax
l6: $ G , u ∊ trapx F ∧ a ∊ cdm u , ⟨ a , v ⟩ ∈ u ⇒ u ∊ trapx F $ by weaken [l3]
l7: $ … ⇒ ⟨ a , v ⟩ ∈ trec F $ by trec_intro [l6, l5]
l8: $ … ⇒ a ∊ cdm (trec F) $ by cdm_intro [l7]
l9: $ … ⇒ a ∊ cdm (trec F) $ by cdm_elim [l4, l8]
l10: $ … ⇒ a ∊ cdm (trec F) $ by ex_elim [l1, l9]

trec_fv
-------
l1: $ G ⇒ functional (trec F) $ by trec_functional
l2: $ … ⇒ g ⊆ trec F $ by cuni_subset [#1]
l3: $ … ⇒ g' a = (trec F)' a $ by fv_subset [l1, l2, #2]
l4: $ … ⇒ (trec F)' a = g' a $ by eq_sym [l3]

trec_cres
---------
l1: $ G ⇒ functional (trec F) $ by trec_functional
l2: $ … ⇒ g ⊆ trec F $ by cuni_subset [#1]
l3: $ … ⇒ ord (cdm g) $ by trapx_ord [#1]
l4: $ … ⇒ a ⊆ cdm g $ by ord_elem_subset [l3, #2]
l5: $ … ⇒ trec F ↾ a = g ↾ a $ by cres_subfun [l1, l2, l4]

trec_cres_apx
-------------
l1: $ … ⇒ ∃ u (u ∊ trapx F ∧ a ∊ cdm u) $ by trapx_exists_at [#1, #2]
l2: $ G , u ∊ trapx F ∧ a ∊ cdm u ⇒ u ∊ trapx F ∧ a ∊ cdm u $ by ax
l3: $ … ⇒ u ∊ trapx F $ by and_elim_l [l2]
l4: $ … ⇒ a ∊ cdm u $ by and_elim_r [l2]
l5: $ … ⇒ u ↾ a ∈ trapx F $ by trapx_cres [l3, l4]
l6: $ … ⇒ trec F ↾ a = u ↾ a $ by trec_cres [l3, l4]
l7: $ … ⇒ u ↾ a = trec F ↾ a $ by eq_sym [l6]
l8: $ … ⇒ trec F ↾ a ∈ trapx F $ by wcel_eq_l [l7, l5]
l9: $ … ⇒ trec F ↾ a ∈ trapx F $ by ex_elim [l1, l8]

trec_eq
-------
l1: $ … ⇒ ∃ u (u ∊ trapx F ∧ a ∊ cdm u) $ by trapx_exists_at [#1, #2]
l2: $ G , u ∊ trapx F ∧ a ∊ cdm u ⇒ u ∊ trapx F ∧ a ∊ cdm u $ by ax
l3: $ … ⇒ u ∊ trapx F $ by and_elim_l [l2]
l4: $ … ⇒ a ∊ cdm u $ by and_elim_r [l2]
l5: $ … ⇒ (trec F)' a = u' a $ by trec_fv [l3, l4]
l6: $ … ⇒ u' a = F' (u ↾ a) $ by trapx_step [l3, l4]
l7: $ … ⇒ trec F ↾ a = u ↾ a $ by trec_cres [l3, l4]
l8: $ … ⇒ u ↾ a = trec F ↾ a $ by eq_sym [l7]
l9: $ G , u ∊ trapx F ∧ a ∊ cdm u ⇒ F = F $ by eq_refl
l10: $ … ⇒ F' (u ↾ a) = F' (trec F ↾ a) $ by fv_eq [l9, l8]
l11: $ … ⇒ (trec F)' a = F' (u ↾ a) $ by eq_trans [l5, l6]
l12: $ … ⇒ (trec F)' a = F' (trec F ↾ a) $ by eq_trans [l11, l10]
l13: $ … ⇒ (trec F)' a = F' (trec F ↾ a) $ by ex_elim [l1, l12]

trec_unique
-----------
e1: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ H ↾ i ⇒ ⟨ u , v ⟩ ∈ H ↾ i $ by ax
e2: $ … ⇒ u ∊ i ∧ ⟨ u , v ⟩ ∈ H $ by cres_elim [e1]
e3: $ … ⇒ u ∊ i $ by and_elim_l [e2]
e4: $ … ⇒ ⟨ u , v ⟩ ∈ H $ by and_elim_r [e2]
e5: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ H ↾ i ⇒ ord i $ by ax
e6: $ … ⇒ ord u $ by ord_elem [e5, e3]
e7: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ H ↾ i ⇒ functional F $ by weaken [#1]
e8: $ … ⇒ u ∊ cdm (trec F) $ by trec_cdm [e7, e6]
e9: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ H ↾ i ⇒ ∀ j (j ∊ i → H' j = (trec F)' j) $ by ax
e10: $ … ⇒ u ∊ i → H' u = (trec F)' u $ by all_elim [e9]
e11: $ … ⇒ H' u = (trec F)' u $ by imp_elim [e10, e3]
e12: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ H ↾ i ⇒ functional H $ by weaken [#2]
e13: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ H ↾ i ⇒ functional (trec F) $ by trec_functional
e14: $ … ⇒ ⟨ u , v ⟩ ∈ trec F $ by fv_pair_move [e12, e13, e4, e8, e11]
e15: $ … ⇒ ⟨ u , v ⟩ ∈ trec F ↾ i $ by cres_intro [e3, e14]
f1: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ trec F ↾ i ⇒ ⟨ u , v ⟩ ∈ trec F ↾ i $ by ax
f2: $ … ⇒ u ∊ i ∧ ⟨ u , v ⟩ ∈ trec F $ by cres_elim [f1]
f3: $ … ⇒ u ∊ i $ by and_elim_l [f2]
f4: $ … ⇒ ⟨ u , v ⟩ ∈ trec F $ by and_elim_r [f2]
f5: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ trec F ↾ i ⇒ ord i $ by ax
f6: $ … ⇒ ord u $ by ord_elem [f5, f3]
f7: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ trec F ↾ i ⇒ ∀ x (x ∊ cdm H ↔ ord x) $ by weaken [#4]
f8: $ … ⇒ u ∊ cdm H ↔ ord u $ by all_elim [f7]
f9: $ … ⇒ u ∊ cdm H $ by bi_elim_r [f8, f6]
f10: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ trec F ↾ i ⇒ ∀ j (j ∊ i → H' j = (trec F)' j) $ by ax
f11: $ … ⇒ u ∊ i → H' u = (trec F)' u $ by all_elim [f10]
f12: $ … ⇒ H' u = (trec F)' u $ by imp_elim [f11, f3]
f13: $ … ⇒ (trec F)' u = H' u $ by eq_sym [f12]
f14: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ trec F ↾ i ⇒ functional (trec F) $ by trec_functional
f15: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) , ⟨ u , v ⟩ ∈ trec F ↾ i ⇒ functional H $ by weaken [#2]
f16: $ … ⇒ ⟨ u , v ⟩ ∈ H $ by fv_pair_move [f14, f15, f4, f9, f13]
f17: $ … ⇒ ⟨ u , v ⟩ ∈ H ↾ i $ by cres_intro [f3, f16]
r1: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) ⇒ rel (H ↾ i) $ by cres_rel
r2: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) ⇒ rel (trec F ↾ i) $ by cres_rel
r3: $ … ⇒ H ↾ i = trec F ↾ i $ by rel_eq_intro [r1, r2, e15, f17]
r4: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) ⇒ ∀ x (ord x → H' x = F' (H ↾ x)) $ by weaken [#5]
r5: $ … ⇒ ord i → H' i = F' (H ↾ i) $ by all_elim [r4]
r6: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) ⇒ ord i $ by ax
r7: $ … ⇒ H' i = F' (H ↾ i) $ by imp_elim [r5, r6]
r8: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) ⇒ F = F $ by eq_refl
r9: $ … ⇒ F' (H ↾ i) = F' (trec F ↾ i) $ by fv_eq [r8, r3]
r10: $ G , ord i , ∀ j (j ∊ i → H' j = (trec F)' j) ⇒ functional F $ by weaken [#1]
r11: $ … ⇒ (trec F)' i = F' (trec F ↾ i) $ by trec_eq [r10, r6]
r12: $ … ⇒ F' (trec F ↾ i) = (trec F)' i $ by eq_sym [r11]
r13: $ … ⇒ H' i = F' (trec F ↾ i) $ by eq_trans [r7, r9]
r14: $ … ⇒ H' i = (trec F)' i $ by eq_trans [r13, r12]
r15: $ … ⇒ ∀ i (ord i → H' i = (trec F)' i) $ by ord_ind_f [r14]
w1: $ G , w ∊ cdm H ⇒ w ∊ cdm H $ by ax
w2: $ G , w ∊ cdm H ⇒ ∀ x (x ∊ cdm H ↔ ord x) $ by weaken [#4]
w3: $ … ⇒ w ∊ cdm H ↔ ord w $ by all_elim [w2]
w4: $ … ⇒ ord w $ by bi_elim_l [w3, w1]
w5: $ G , w ∊ cdm H ⇒ functional F $ by weaken [#1]
w6: $ … ⇒ w ∊ cdm (trec F) $ by trec_cdm [w5, w4]
w7: $ G , w ∊ cdm (trec F) ⇒ w ∊ cdm (trec F) $ by ax
w8: $ … ⇒ ord w $ by trec_cdm_ord [w7]
w9: $ G , w ∊ cdm (trec F) ⇒ ∀ x (x ∊ cdm H ↔ ord x) $ by weaken [#4]
w10: $ … ⇒ w ∊ cdm H ↔ ord w $ by all_elim [w9]
w11: $ … ⇒ w ∊ cdm H $ by bi_elim_r [w10, w8]
w12: $ … ⇒ cdm H = cdm (trec F) $ by eq_intro [w6, w11]
v1: $ G , w ∊ cdm H ⇒ ∀ i (ord i → H' i = (trec F)' i) $ by weaken [r15]
v2: $ … ⇒ ord w → H' w = (trec F)' w $ by all_elim [v1]
v3: $ … ⇒ H' w = (trec F)' w $ by imp_elim [v2, w4]
z1: $ G ⇒ functional (trec F) $ by trec_functional
z2: $ G ⇒ rel (trec F) $ by trec_rel
z3: $ … ⇒ H = trec F $ by fv_ext [#2, z1, #3, z2, w12, v3]

trec_congr
----------
l1: $ trapx F ≐ trapx H $ by trapx_congr [#1]
l2: $ ⋃ (trapx F) ≐ ⋃ (trapx H) $ by cuni_congr [l1]

lemma x1_trapx_sub (G: hyps) (F H: class) (g: set):
  $ G ⇒ F = H $ > $ G ⇒ g ∊ trapx F $ > $ G ⇒ g ∊ trapx H $
----
s1: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) , k ∊ a ⇒ ∀ k (k ∊ a → g' k = F' (g ↾ k)) $ by ax
s2: $ … ⇒ k ∊ a → g' k = F' (g ↾ k) $ by all_elim [s1]
s3: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) , k ∊ a ⇒ k ∊ a $ by ax
s4: $ … ⇒ g' k = F' (g ↾ k) $ by imp_elim [s2, s3]
s5: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) , k ∊ a ⇒ F = H $ by weaken [#1]
s6: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) , k ∊ a ⇒ g ↾ k = g ↾ k $ by eq_refl
s7: $ … ⇒ F' (g ↾ k) = H' (g ↾ k) $ by fv_eq [s5, s6]
s8: $ … ⇒ g' k = H' (g ↾ k) $ by eq_trans [s4, s7]
s9: $ … ⇒ k ∊ a → g' k = H' (g ↾ k) $ by imp_intro [s8]
s10: $ … ⇒ ∀ k (k ∊ a → g' k = H' (g ↾ k)) $ by all_intro [s9]
s11: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) ⇒ isset g $ by isset_var
s12: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) ⇒ ord a $ by ax
s13: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) ⇒ functional g $ by ax
s14: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) ⇒ rel g $ by ax
s15: $ G , ord a , functional g , rel g , cdm g = a , ∀ k (k ∊ a → g' k = F' (g ↾ k)) ⇒ cdm g = a $ by ax
s16: $ … ⇒ g ∈ trapx H $ by trapx_intro [s11, s12, s13, s14, s15, s10]
s17: $ … ⇒ g ∊ trapx H $ by wcel_welc [s16]
s18: $ … ⇒ g ∊ trapx H $ by trapx_elim [#2, s17]

trec_eq_cong
------------
r1: $ G , g ∊ trapx F ⇒ g ∊ trapx F $ by ax
r2: $ G , g ∊ trapx F ⇒ F = H $ by weaken [#1]
r3: $ … ⇒ g ∊ trapx H $ by x1_trapx_sub [r2, r1]
r4: $ … ⇒ H = F $ by eq_sym [#1]
r5: $ G , g ∊ trapx H ⇒ g ∊ trapx H $ by ax
r6: $ G , g ∊ trapx H ⇒ H = F $ by weaken [r4]
r7: $ … ⇒ g ∊ trapx F $ by x1_trapx_sub [r6, r5]
r8: $ … ⇒ trapx F = trapx H $ by eq_intro [r3, r7]
r9: $ … ⇒ ⋃ (trapx F) = ⋃ (trapx H) $ by cuni_eq [r8]

sb_c_trec
---------
l1: $ (⟦ x / t ⟧ (⋃ (trapx F))) ≐ ⋃ (trapx (⟦ x / t ⟧ F)) $ by ceqt_refl
