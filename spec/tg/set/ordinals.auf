l11: $ G , ∀ y (y ∊ x → ord y → [x/y] p) , ord x ⇒ ∀ z (z ∊ x → [x/z] p) ↔ ∀ y (y ∊ x → [x/y] p) $ by weaken [l10]
l12: $ … ⇒ ∀ y (y ∊ x → [x/y] p) $ by bi_elim_l [l11, l9]
l13: $ … ⇒ p $ by cut [l12, #1]
l14: $ … ⇒ ord x → p $ by imp_intro [l13]
l15: $ … ⇒ ∀ x (ord x → p) $ by ax_induction [l14]

ord_ind
-------
l1: $ G , ord x , ∀ y (y ∊ x → y ∊ P) ⇒ ∀ x (ord x → x ⊆ P → x ∊ P) $ by weaken [#1]
l2: $ … ⇒ ord x → x ⊆ P → x ∊ P $ by all_elim [l1]
l3: $ G , ord x , ∀ y (y ∊ x → y ∊ P) ⇒ ord x $ by ax
l4: $ … ⇒ x ⊆ P → x ∊ P $ by imp_elim [l2, l3]
l5: $ G , ord x , ∀ y (y ∊ x → y ∊ P) ⇒ x ⊆ P $ by ax
l6: $ … ⇒ x ∊ P $ by imp_elim [l4, l5]
l7: $ … ⇒ ∀ x (ord x → x ∊ P) $ by ord_ind_f [l6]

ord_least
---------
l1: $ G , ¬ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) , ord z , ∀ w (w ∊ z → ¬ w ∊ P) , z ∊ P ⇒ z ∊ P $ by ax
l2: $ G , ¬ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) , ord z , ∀ w (w ∊ z → ¬ w ∊ P) , z ∊ P ⇒ ord z $ by ax
l3: $ G , ¬ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) , ord z , ∀ w (w ∊ z → ¬ w ∊ P) , z ∊ P ⇒ ∀ w (w ∊ z → ¬ w ∊ P) $ by ax
l4: $ ∀ w (w ∊ z → ¬ w ∊ P) ⟺ ∀ y (y ∊ z → ¬ y ∊ P) $ by all_alpha
l5: $ G , ¬ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) , ord z , ∀ w (w ∊ z → ¬ w ∊ P) , z ∊ P ⇒ ∀ w (w ∊ z → ¬ w ∊ P) ↔ ∀ y (y ∊ z → ¬ y ∊ P) $ by weaken [l4]
l6: $ … ⇒ ∀ y (y ∊ z → ¬ y ∊ P) $ by bi_elim_l [l5, l3]
l7: $ … ⇒ ord z ∧ ∀ y (y ∊ z → ¬ y ∊ P) $ by and_intro [l2, l6]
l8: $ … ⇒ z ∊ P ∧ ord z ∧ ∀ y (y ∊ z → ¬ y ∊ P) $ by and_intro [l1, l7]
l9: $ … ⇒ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) $ by ex_intro [l8]
l10: $ G , ¬ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) , ord z , ∀ w (w ∊ z → ¬ w ∊ P) , z ∊ P ⇒ ¬ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) $ by ax
l11: $ … ⇒ ⊥ $ by not_elim [l10, l9]
l12: $ … ⇒ ¬ z ∊ P $ by not_intro [l11]
l13: $ … ⇒ ∀ z (ord z → ¬ z ∊ P) $ by ord_ind_f [l12]
l14: $ … ⇒ ord a → ¬ a ∊ P $ by all_elim [l13]
l15: $ G , ¬ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) ⇒ ord a $ by weaken [#1]
l16: $ … ⇒ ¬ a ∊ P $ by imp_elim [l14, l15]
l17: $ G , ¬ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) ⇒ a ∊ P $ by weaken [#2]
l18: $ … ⇒ ⊥ $ by not_elim [l16, l17]
l19: $ … ⇒ ∃ x (x ∊ P ∧ ord x ∧ ∀ y (y ∊ x → ¬ y ∊ P)) $ by by_contra [l18]

lemma d2_tricho_core {z v w: set} (G: hyps z v w) (a b: set):
  $ G ⇒ ord a $ > $ G ⇒ ord b $ > $ G ⇒ ∀ z (z ∊ a → ∀ v (ord v → z ∊ v ∨ z = v ∨ v ∊ z)) $ > $ G ⇒ ∀ w (w ∊ b → a ∊ w ∨ a = w ∨ w ∊ a) $ > $ G ⇒ a ∊ b ∨ a = b ∨ b ∊ a $
----
l1: $ G ⇒ a ∊ b ∨ ¬ a ∊ b $ by excluded_middle
l2: $ G , a ∊ b ⇒ a ∊ b $ by ax
l3: $ … ⇒ a ∊ b ∨ a = b ∨ b ∊ a $ by or_intro_l [l2]
l4: $ G , ¬ a ∊ b ⇒ b ∊ a ∨ ¬ b ∊ a $ by excluded_middle
l5: $ G , ¬ a ∊ b , b ∊ a ⇒ b ∊ a $ by ax
l6: $ … ⇒ a = b ∨ b ∊ a $ by or_intro_r [l5]
l7: $ … ⇒ a ∊ b ∨ a = b ∨ b ∊ a $ by or_intro_r [l6]
m1: $ G , ¬ a ∊ b , ¬ b ∊ a , c ∊ a ⇒ ∀ z (z ∊ a → ∀ v (ord v → z ∊ v ∨ z = v ∨ v ∊ z)) $ by weaken [#3]
