-- Proofs for ordinals.mm0.

transitive_intro
----------------
l1: $ … ⇒ y ∊ x → y ∊ A $ by imp_intro [#1]
l2: $ … ⇒ ∀ y (y ∊ x → y ∊ A) $ by all_intro [l1]
l3: $ … ⇒ x ∊ A → ∀ y (y ∊ x → y ∊ A) $ by imp_intro [l2]
l4: $ … ⇒ ∀ x (x ∊ A → ∀ y (y ∊ x → y ∊ A)) $ by all_intro [l3]

transitive_elim
---------------
l1: $ … ⇒ a ∊ A → ∀ v (v ∊ a → v ∊ A) $ by all_elim [#1]
l2: $ … ⇒ ∀ v (v ∊ a → v ∊ A) $ by imp_elim [l1, #2]
l3: $ … ⇒ b ∊ a → b ∊ A $ by all_elim [l2]
l4: $ … ⇒ b ∊ A $ by imp_elim [l3, #3]

transitive_subset
-----------------
l1: $ … ⇒ a ∊ A → ∀ v (v ∊ a → v ∊ A) $ by all_elim [#1]
l2: $ … ⇒ ∀ v (v ∊ a → v ∊ A) $ by imp_elim [l1, #2]

transitive_empty
----------------
l1: $ G , u ∊ ∅ , v ∊ u ⇒ u ∊ ∅ $ by ax
l2: $ … ⇒ ⊥ $ by empty_elim [l1]
l3: $ … ⇒ v ∊ ∅ $ by bot_elim [l2]
l4: $ … ⇒ transitive ∅ $ by transitive_intro [l3]

transitive_suc
--------------
l1: $ G , u ∊ suc A , v ∊ u ⇒ u ∊ suc A $ by ax
l2: $ … ⇒ u ∊ A ∨ u = A $ by suc_elim [l1]
l3: $ G , u ∊ suc A , v ∊ u , u ∊ A ⇒ transitive A $ by weaken [#1]
l4: $ G , u ∊ suc A , v ∊ u , u ∊ A ⇒ u ∊ A $ by ax
l5: $ G , u ∊ suc A , v ∊ u , u ∊ A ⇒ v ∊ u $ by ax
l6: $ … ⇒ v ∊ A $ by transitive_elim [l3, l4, l5]
l7: $ … ⇒ v ∊ suc A $ by suc_intro_l [l6]
l8: $ G , u ∊ suc A , v ∊ u , u = A ⇒ u = A $ by ax
l9: $ G , u ∊ suc A , v ∊ u , u = A ⇒ v ∊ u $ by ax
l10: $ … ⇒ v ∊ A $ by welc_eq [l8, l9]
l11: $ … ⇒ v ∊ suc A $ by suc_intro_l [l10]
l12: $ … ⇒ v ∊ suc A $ by or_elim [l2, l7, l11]
l13: $ … ⇒ transitive (suc A) $ by transitive_intro [l12]

transitive_cuni
---------------
l1: $ G , u ∊ ⋃ A , v ∊ u ⇒ u ∊ ⋃ A $ by ax
l2: $ G , u ∊ ⋃ A , v ∊ u , w ∊ A , u ∊ w ⇒ ∀ x (x ∊ A → transitive x) $ by weaken [#1]
l3: $ … ⇒ w ∊ A → transitive w $ by all_elim [l2]
l4: $ G , u ∊ ⋃ A , v ∊ u , w ∊ A , u ∊ w ⇒ w ∊ A $ by ax
l5: $ … ⇒ transitive w $ by imp_elim [l3, l4]
l6: $ G , u ∊ ⋃ A , v ∊ u , w ∊ A , u ∊ w ⇒ u ∊ w $ by ax
l7: $ G , u ∊ ⋃ A , v ∊ u , w ∊ A , u ∊ w ⇒ v ∊ u $ by ax
l8: $ … ⇒ v ∊ w $ by transitive_elim [l5, l6, l7]
l9: $ … ⇒ v ∊ ⋃ A $ by cuni_intro [l8, l4]
l10: $ … ⇒ v ∊ ⋃ A $ by cuni_elim [l1, l9]
l11: $ … ⇒ transitive (⋃ A) $ by transitive_intro [l10]

transitive_cin
--------------
l1: $ G , u ∊ A ∩ B , v ∊ u ⇒ u ∊ A ∩ B $ by ax
l2: $ … ⇒ u ∊ A $ by cin_elim_l [l1]
l3: $ … ⇒ u ∊ B $ by cin_elim_r [l1]
l4: $ G , u ∊ A ∩ B , v ∊ u ⇒ v ∊ u $ by ax
l5: $ G , u ∊ A ∩ B , v ∊ u ⇒ transitive A $ by weaken [#1]
l6: $ G , u ∊ A ∩ B , v ∊ u ⇒ transitive B $ by weaken [#2]
l7: $ … ⇒ v ∊ A $ by transitive_elim [l5, l2, l4]
l8: $ … ⇒ v ∊ B $ by transitive_elim [l6, l3, l4]
l9: $ … ⇒ v ∊ A ∩ B $ by cin_intro [l7, l8]
l10: $ … ⇒ transitive (A ∩ B) $ by transitive_intro [l9]

transitive_cuni_subset
----------------------
l1: $ G , u ∊ ⋃ A ⇒ u ∊ ⋃ A $ by ax
l2: $ G , u ∊ ⋃ A , w ∊ A , u ∊ w ⇒ transitive A $ by weaken [#1]
l3: $ G , u ∊ ⋃ A , w ∊ A , u ∊ w ⇒ w ∊ A $ by ax
l4: $ G , u ∊ ⋃ A , w ∊ A , u ∊ w ⇒ u ∊ w $ by ax
l5: $ … ⇒ u ∊ A $ by transitive_elim [l2, l3, l4]
l6: $ … ⇒ u ∊ A $ by cuni_elim [l1, l5]
l7: $ … ⇒ ⋃ A ⊆ A $ by subset_intro [l6]

cuni_suc
--------
l1: $ G , u ∊ ⋃ (suc a) ⇒ u ∊ ⋃ (suc a) $ by ax
l2: $ G , u ∊ ⋃ (suc a) , w ∊ suc a , u ∊ w ⇒ w ∊ suc a $ by ax
l3: $ … ⇒ w ∊ a ∨ w = a $ by suc_elim [l2]
l4: $ G , u ∊ ⋃ (suc a) , w ∊ suc a , u ∊ w , w ∊ a ⇒ transitive a $ by weaken [#1]
l5: $ G , u ∊ ⋃ (suc a) , w ∊ suc a , u ∊ w , w ∊ a ⇒ w ∊ a $ by ax
l6: $ G , u ∊ ⋃ (suc a) , w ∊ suc a , u ∊ w , w ∊ a ⇒ u ∊ w $ by ax
l7: $ … ⇒ u ∊ a $ by transitive_elim [l4, l5, l6]
l8: $ G , u ∊ ⋃ (suc a) , w ∊ suc a , u ∊ w , w = a ⇒ w = a $ by ax
l9: $ G , u ∊ ⋃ (suc a) , w ∊ suc a , u ∊ w , w = a ⇒ u ∊ w $ by ax
l10: $ … ⇒ u ∊ a $ by welc_eq [l8, l9]
l11: $ … ⇒ u ∊ a $ by or_elim [l3, l7, l10]
l12: $ … ⇒ u ∊ a $ by cuni_elim [l1, l11]
l13: $ G , u ∊ a ⇒ u ∊ a $ by ax
l14: $ G , u ∊ a ⇒ a ∊ suc a $ by suc_self
l15: $ … ⇒ u ∊ ⋃ (suc a) $ by cuni_intro [l13, l14]
l16: $ … ⇒ ⋃ (suc a) = a $ by eq_intro [l12, l15]

cuni_least
----------
l1: $ G , u ∊ ⋃ A ⇒ u ∊ ⋃ A $ by ax
l2: $ G , u ∊ ⋃ A , w ∊ A , u ∊ w ⇒ ∀ x (x ∊ A → x ⊆ B) $ by weaken [#1]
l3: $ … ⇒ w ∊ A → w ⊆ B $ by all_elim [l2]
l4: $ G , u ∊ ⋃ A , w ∊ A , u ∊ w ⇒ w ∊ A $ by ax
l5: $ … ⇒ w ⊆ B $ by imp_elim [l3, l4]
l6: $ G , u ∊ ⋃ A , w ∊ A , u ∊ w ⇒ u ∊ w $ by ax
l7: $ … ⇒ u ∊ B $ by subset_elim [l5, l6]
l8: $ … ⇒ u ∊ B $ by cuni_elim [l1, l7]
l9: $ … ⇒ ⋃ A ⊆ B $ by subset_intro [l8]

ord_congr
---------
l1: $ transitive A ⟺ transitive B $ by transitive_congr [#1]
l0: $ seqt u u $ by seqt_refl
l2: $ (u ∊ A) ⟺ (u ∊ B) $ by welc_congr [l0, #1]
l3: $ transitive u ⟺ transitive u $ by iff_refl
l4: $ (u ∊ A → transitive u) ⟺ (u ∊ B → transitive u) $ by im_congr [l2, l3]
l5: $ ∀ u (u ∊ A → transitive u) ⟺ ∀ u (u ∊ B → transitive u) $ by all_congr [l4]
l6: $ (transitive A ∧ ∀ u (u ∊ A → transitive u)) ⟺ (transitive B ∧ ∀ u (u ∊ B → transitive u)) $ by and_congr [l1, l5]

sb_f_ord
--------
l1: $ [x/t] (transitive A ∧ ∀ u (u ∊ A → transitive u)) ⟺ (transitive (⟦ x / t ⟧ A) ∧ ∀ u (u ∊ (⟦ x / t ⟧ A) → transitive u)) $ by iff_refl

ord_intro
---------
l1: $ … ⇒ transitive A ∧ ∀ x (x ∊ A → transitive x) $ by and_intro [#1, #2]

ord_trans
---------
l1: $ … ⇒ transitive A $ by and_elim_l [#1]

ord_elem_trans
--------------
l1: $ … ⇒ ∀ u (u ∊ A → transitive u) $ by and_elim_r [#1]
l2: $ … ⇒ a ∊ A → transitive a $ by all_elim [l1]
l3: $ … ⇒ transitive a $ by imp_elim [l2, #2]

ord_eq
------
l1: $ … ⇒ transitive A $ by ord_trans [#2]
l2: $ … ⇒ transitive B $ by transitive_eq [#1, l1]
l3: $ … ⇒ B = A $ by eq_sym [#1]
l4: $ G , u ∊ B ⇒ u ∊ B $ by ax
l5: $ G , u ∊ B ⇒ B = A $ by weaken [l3]
l6: $ … ⇒ u ∊ A $ by welc_eq [l5, l4]
l7: $ G , u ∊ B ⇒ ord A $ by weaken [#2]
l8: $ … ⇒ transitive u $ by ord_elem_trans [l7, l6]
l9: $ … ⇒ u ∊ B → transitive u $ by imp_intro [l8]
l10: $ … ⇒ ∀ u (u ∊ B → transitive u) $ by all_intro [l9]
l11: $ … ⇒ ord B $ by ord_intro [l2, l10]

ord_elem
--------
l1: $ … ⇒ transitive a $ by ord_elem_trans [#1, #2]
l2: $ G , u ∊ a ⇒ ord A $ by weaken [#1]
l3: $ … ⇒ transitive A $ by ord_trans [l2]
l4: $ G , u ∊ a ⇒ a ∊ A $ by weaken [#2]
l5: $ G , u ∊ a ⇒ u ∊ a $ by ax
l6: $ … ⇒ u ∊ A $ by transitive_elim [l3, l4, l5]
l7: $ … ⇒ transitive u $ by ord_elem_trans [l2, l6]
l8: $ … ⇒ u ∊ a → transitive u $ by imp_intro [l7]
l9: $ … ⇒ ∀ u (u ∊ a → transitive u) $ by all_intro [l8]
l10: $ … ⇒ ord a $ by ord_intro [l1, l9]

ord_elem_subset
---------------
l1: $ … ⇒ transitive A $ by ord_trans [#1]
l2: $ … ⇒ a ⊆ A $ by transitive_subset [l1, #2]

ord_empty
---------
l1: $ G ⇒ transitive ∅ $ by transitive_empty
l2: $ G , u ∊ ∅ ⇒ u ∊ ∅ $ by ax
l3: $ … ⇒ ⊥ $ by empty_elim [l2]
l4: $ … ⇒ transitive u $ by bot_elim [l3]
l5: $ … ⇒ u ∊ ∅ → transitive u $ by imp_intro [l4]
l6: $ … ⇒ ∀ u (u ∊ ∅ → transitive u) $ by all_intro [l5]
l7: $ … ⇒ ord ∅ $ by ord_intro [l1, l6]

ord_suc
-------
l1: $ … ⇒ transitive A $ by ord_trans [#1]
l2: $ … ⇒ transitive (suc A) $ by transitive_suc [l1]
l3: $ G , u ∊ suc A ⇒ u ∊ suc A $ by ax
l4: $ … ⇒ u ∊ A ∨ u = A $ by suc_elim [l3]
