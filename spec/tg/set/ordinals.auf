l11: $ … ⇒ z ∊ (⟦ x / a ⟧ B) $ by ex_elim [l5, l10]
l12: $ z ∊ (⟦ x / a ⟧ B) ⇒ z ∊ (⟦ x / a ⟧ B) $ by ax
