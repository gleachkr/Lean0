e2: $ … ⇒ y ∊ trapx F ∧ cdm y = u $ by trapxd_elim [e1]
e3: $ … ⇒ cdm y = u $ by and_elim_r [e2]
e4: $ G , k ∊ cdm (⋃ (img (trapxd F) a)) , ⟨ k , v ⟩ ∈ (⋃ (img (trapxd F) a)) , w = ⟨ k , v ⟩ , w ∊ (⋃ (img (trapxd F) a)) , y ∊ img (trapxd F) a , w ∊ y , u ∊ a , ⟨ u , y ⟩ ∈ trapxd F ⇒ w = ⟨ k , v ⟩ $ by ax
e5: $ G , k ∊ cdm (⋃ (img (trapxd F) a)) , ⟨ k , v ⟩ ∈ (⋃ (img (trapxd F) a)) , w = ⟨ k , v ⟩ , w ∊ (⋃ (img (trapxd F) a)) , y ∊ img (trapxd F) a , w ∊ y , u ∊ a , ⟨ u , y ⟩ ∈ trapxd F ⇒ w ∊ y $ by ax
e6: $ … ⇒ ⟨ k , v ⟩ ∈ y $ by wcel_intro [e4, e5]
e7: $ … ⇒ k ∊ cdm y $ by cdm_intro [e6]
e8: $ … ⇒ k ∊ u $ by welc_eq [e3, e7]
e9: $ G , k ∊ cdm (⋃ (img (trapxd F) a)) , ⟨ k , v ⟩ ∈ (⋃ (img (trapxd F) a)) , w = ⟨ k , v ⟩ , w ∊ (⋃ (img (trapxd F) a)) , y ∊ img (trapxd F) a , w ∊ y , u ∊ a , ⟨ u , y ⟩ ∈ trapxd F ⇒ u ∊ a $ by ax
e10: $ … ⇒ k ∊ ⋃ a $ by cuni_intro [e8, e9]
d1: $ G , k ∊ cdm (⋃ (img (trapxd F) a)) , ⟨ k , v ⟩ ∈ (⋃ (img (trapxd F) a)) , w = ⟨ k , v ⟩ , w ∊ (⋃ (img (trapxd F) a)) , y ∊ img (trapxd F) a , w ∊ y ⇒ y ∊ img (trapxd F) a $ by ax
d2: $ … ⇒ k ∊ ⋃ a $ by img_elim [d1, e10]
d3: $ G , k ∊ cdm (⋃ (img (trapxd F) a)) , ⟨ k , v ⟩ ∈ (⋃ (img (trapxd F) a)) , w = ⟨ k , v ⟩ , w ∊ (⋃ (img (trapxd F) a)) ⇒ w ∊ (⋃ (img (trapxd F) a)) $ by ax
d4: $ … ⇒ k ∊ ⋃ a $ by cuni_elim [d3, d2]
d5: $ G , k ∊ cdm (⋃ (img (trapxd F) a)) , ⟨ k , v ⟩ ∈ (⋃ (img (trapxd F) a)) ⇒ ⟨ k , v ⟩ ∈ (⋃ (img (trapxd F) a)) $ by ax
d6: $ … ⇒ k ∊ ⋃ a $ by wcel_elim [d5, d4]
d7: $ G , k ∊ cdm (⋃ (img (trapxd F) a)) ⇒ k ∊ cdm (⋃ (img (trapxd F) a)) $ by ax
d8: $ … ⇒ k ∊ ⋃ a $ by cdm_elim [d7, d6]
g1: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w ⇒ w ∊ a $ by ax
g2: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w ⇒ ∀ x (x ∊ a → x ∊ cdm (trapxd F)) $ by weaken [#2]
g3: $ … ⇒ w ∊ a → w ∊ cdm (trapxd F) $ by all_elim [g2]
g4: $ … ⇒ w ∊ cdm (trapxd F) $ by imp_elim [g3, g1]
g5: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w , ⟨ w , y ⟩ ∈ trapxd F ⇒ ⟨ w , y ⟩ ∈ trapxd F $ by ax
g6: $ … ⇒ y ∊ trapx F ∧ cdm y = w $ by trapxd_elim [g5]
g7: $ … ⇒ cdm y = w $ by and_elim_r [g6]
g8: $ … ⇒ w = cdm y $ by eq_sym [g7]
g9: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w , ⟨ w , y ⟩ ∈ trapxd F ⇒ k ∊ w $ by ax
g10: $ … ⇒ k ∊ cdm y $ by welc_eq [g8, g9]
g11: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w , ⟨ w , y ⟩ ∈ trapxd F ⇒ w ∊ a $ by ax
g12: $ … ⇒ y ∊ img (trapxd F) a $ by img_intro [g11, g5]
g13: $ … ⇒ y ⊆ (⋃ (img (trapxd F) a)) $ by cuni_subset [g12]
g14: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w , ⟨ w , y ⟩ ∈ trapxd F , ⟨ k , v ⟩ ∈ y ⇒ ⟨ k , v ⟩ ∈ y $ by ax
g15: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w , ⟨ w , y ⟩ ∈ trapxd F , ⟨ k , v ⟩ ∈ y ⇒ y ⊆ (⋃ (img (trapxd F) a)) $ by weaken [g13]
g16: $ … ⇒ ⟨ k , v ⟩ ∈ (⋃ (img (trapxd F) a)) $ by wcel_subset [g15, g14]
g17: $ … ⇒ k ∊ cdm (⋃ (img (trapxd F) a)) $ by cdm_intro [g16]
g18: $ … ⇒ k ∊ cdm (⋃ (img (trapxd F) a)) $ by cdm_elim [g10, g17]
g19: $ … ⇒ k ∊ cdm (⋃ (img (trapxd F) a)) $ by cdm_elim [g4, g18]
g20: $ G , k ∊ ⋃ a ⇒ k ∊ ⋃ a $ by ax
g21: $ … ⇒ k ∊ cdm (⋃ (img (trapxd F) a)) $ by cuni_elim [g20, g19]
c16: $ … ⇒ cdm (⋃ (img (trapxd F) a)) = ⋃ a $ by eq_intro [d8, g21]
q1: $ … ⇒ y ∊ trapx F $ by and_elim_l [g6]
q2: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w , ⟨ w , y ⟩ ∈ trapxd F ⇒ functional ((⋃ (img (trapxd F) a))) $ by weaken [c13]
q3: $ … ⇒ y' k = (⋃ (img (trapxd F) a))' k $ by fv_subset [q2, g13, g10]
q4: $ … ⇒ (⋃ (img (trapxd F) a))' k = y' k $ by eq_sym [q3]
q5: $ … ⇒ y' k = F' (y ↾ k) $ by trapx_step [q1, g10]
q6: $ … ⇒ ord (cdm y) $ by trapx_ord [q1]
q7: $ … ⇒ k ⊆ cdm y $ by ord_elem_subset [q6, g10]
q8: $ … ⇒ (⋃ (img (trapxd F) a)) ↾ k = y ↾ k $ by cres_subfun [q2, g13, q7]
q9: $ … ⇒ y ↾ k = (⋃ (img (trapxd F) a)) ↾ k $ by eq_sym [q8]
q10: $ G , k ∊ ⋃ a , w ∊ a , k ∊ w , ⟨ w , y ⟩ ∈ trapxd F ⇒ F = F $ by eq_refl
q11: $ … ⇒ F' (y ↾ k) = F' ((⋃ (img (trapxd F) a)) ↾ k) $ by fv_eq [q10, q9]
q12: $ … ⇒ (⋃ (img (trapxd F) a))' k = F' (y ↾ k) $ by eq_trans [q4, q5]
q13: $ … ⇒ (⋃ (img (trapxd F) a))' k = F' ((⋃ (img (trapxd F) a)) ↾ k) $ by eq_trans [q12, q11]
q14: $ … ⇒ (⋃ (img (trapxd F) a))' k = F' ((⋃ (img (trapxd F) a)) ↾ k) $ by cdm_elim [g4, q13]
q15: $ … ⇒ (⋃ (img (trapxd F) a))' k = F' ((⋃ (img (trapxd F) a)) ↾ k) $ by cuni_elim [g20, q14]
c17: $ … ⇒ k ∊ ⋃ a → (⋃ (img (trapxd F) a))' k = F' ((⋃ (img (trapxd F) a)) ↾ k) $ by imp_intro [q15]
c18: $ … ⇒ ∀ k (k ∊ ⋃ a → (⋃ (img (trapxd F) a))' k = F' ((⋃ (img (trapxd F) a)) ↾ k)) $ by all_intro [c17]
u1: $ G , b = ⋃ a ⇒ b = ⋃ a $ by ax
u2: $ … ⇒ ⋃ a = b $ by eq_sym [u1]
u3a: $ G , b = ⋃ a ⇒ ord (⋃ a) $ by weaken [c15]
u3: $ … ⇒ ord b $ by ord_eq [u2, u3a]
u4a: $ G , b = ⋃ a ⇒ cdm (⋃ (img (trapxd F) a)) = ⋃ a $ by weaken [c16]
u4: $ … ⇒ cdm (⋃ (img (trapxd F) a)) = b $ by eq_trans [u4a, u2]
u5a: $ G , b = ⋃ a , k ∊ b ⇒ b = ⋃ a $ by ax
u5b: $ G , b = ⋃ a , k ∊ b ⇒ k ∊ b $ by ax
u5: $ … ⇒ k ∊ ⋃ a $ by welc_eq [u5a, u5b]
