u6: $ … ⇒ k ∊ ⋃ a → (⋃ (img (trapxd F) a))' k = F' ((⋃ (img (trapxd F) a)) ↾ k) $ by all_elim [u6a]
u7: $ … ⇒ (⋃ (img (trapxd F) a))' k = F' ((⋃ (img (trapxd F) a)) ↾ k) $ by imp_elim [u6, u5]
