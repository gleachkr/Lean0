-- Proofs for seq.mm0.

fseq_congr
----------
l1: $ g ≐ g $ by ceqt_refl
l2: $ k ≐ k $ by ceqt_refl
l3: $ fn_into g k A ⟺ fn_into g k B $ by fn_into_congr [l1, l2, #1]
l4: $ (cdm g = k) ⟺ (cdm g = k) $ by iff_refl
l5: $ (cdm g = k ∧ fn_into g k A) ⟺ (cdm g = k ∧ fn_into g k B) $ by and_congr [l4, l3]
l6: $ rel g ⟺ rel g $ by iff_refl
l7: $ (rel g ∧ cdm g = k ∧ fn_into g k A) ⟺ (rel g ∧ cdm g = k ∧ fn_into g k B) $ by and_congr [l6, l5]
l8: $ (k ∊ ω) ⟺ (k ∊ ω) $ by iff_refl
l9: $ (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) ⟺ (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k B) $ by and_congr [l8, l7]
l10: $ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A) ⟺ ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k B) $ by ex_congr [l9]
l11: $ {g | ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A)} ≐ {g | ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k B)} $ by cab_congr [l10]

welc_fseq_eq
------------
l1: $ … ⇒ ∃ k (k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A) $ by cab_elim [#2]
l2: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A $ by ax
l3: $ … ⇒ k ∊ ω $ by and_elim_l [l2]
l4: $ … ⇒ rel a ∧ cdm a = k ∧ fn_into a k A $ by and_elim_r [l2]
l5: $ … ⇒ rel a $ by and_elim_l [l4]
l6: $ … ⇒ cdm a = k ∧ fn_into a k A $ by and_elim_r [l4]
l7: $ … ⇒ cdm a = k $ by and_elim_l [l6]
l8: $ … ⇒ fn_into a k A $ by and_elim_r [l6]
l9: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ A = B $ by weaken [#1]
l10: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ a = a $ by eq_refl
l11: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ k = k $ by eq_refl
l12: $ … ⇒ fn_into a k B $ by fn_into_eq [l10, l11, l9, l8]
l13: $ … ⇒ cdm a = k ∧ fn_into a k B $ by and_intro [l7, l12]
l14: $ … ⇒ rel a ∧ cdm a = k ∧ fn_into a k B $ by and_intro [l5, l13]
l15: $ … ⇒ k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k B $ by and_intro [l3, l14]
l16: $ … ⇒ ∃ k (k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k B) $ by ex_intro [l15]
l17: $ G , k ∊ ω ∧ rel a ∧ cdm a = k ∧ fn_into a k A ⇒ a ∊ fseq B $ by cab_intro [l16]
l18: $ … ⇒ a ∊ fseq B $ by ex_elim [l1, l17]

fseq_eq
-------
l1: $ G , u ∊ fseq A ⇒ u ∊ fseq A $ by ax
l2: $ G , u ∊ fseq A ⇒ A = B $ by weaken [#1]
l3: $ … ⇒ u ∊ fseq B $ by welc_fseq_eq [l2, l1]
l4: $ … ⇒ B = A $ by eq_sym [#1]
l5: $ G , u ∊ fseq B ⇒ u ∊ fseq B $ by ax
l6: $ G , u ∊ fseq B ⇒ B = A $ by weaken [l4]
l7: $ … ⇒ u ∊ fseq A $ by welc_fseq_eq [l6, l5]
l8: $ … ⇒ fseq A = fseq B $ by eq_intro [l3, l7]

sb_c_fseq
---------
l1: $ (⟦ x / t ⟧ {g | ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k A)}) ≐ {g | ∃ k (k ∊ ω ∧ rel g ∧ cdm g = k ∧ fn_into g k (⟦ x / t ⟧ A))} $ by ceqt_refl

scons_congr
-----------
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ ⟨ ∅ , A ⟩ ≐ ⟨ ∅ , B ⟩ $ by opair_congr [l1, #1]
l3: $ csn ⟨ ∅ , A ⟩ ≐ csn ⟨ ∅ , B ⟩ $ by csn_congr [l2]
l4: $ ⟨ i , y ⟩ ≐ ⟨ i , y ⟩ $ by ceqt_refl
l5: $ (⟨ i , y ⟩ ∈ C) ⟺ (⟨ i , y ⟩ ∈ D) $ by wcel_congr [l4, #2]
l6: $ (z = ⟨ suc i , y ⟩) ⟺ (z = ⟨ suc i , y ⟩) $ by iff_refl
l7: $ (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by and_congr [l6, l5]
l8: $ ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_congr [l7]
l9: $ ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_congr [l8]
l10: $ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ≐ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)} $ by cab_congr [l9]
l11: $ (csn ⟨ ∅ , A ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)}) ≐ (csn ⟨ ∅ , B ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)}) $ by cun_congr [l3, l10]

welc_scons_eq
-------------
l1: $ G ⇒ a ∊ csn ⟨ ∅ , A ⟩ ∨ a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} $ by cun_elim [#3]
l2: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ a ∊ csn ⟨ ∅ , A ⟩ $ by ax
l3: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ A = B $ by weaken [#1]
l4: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ ∅ = ∅ $ by eq_refl
l5: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ ⟨ ∅ , A ⟩ = ⟨ ∅ , B ⟩ $ by opair_eq [l4, l3]
l6: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ csn ⟨ ∅ , A ⟩ = csn ⟨ ∅ , B ⟩ $ by csn_eq [l5]
l7: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ a ∊ csn ⟨ ∅ , B ⟩ $ by welc_eq [l6, l2]
l8: $ G , a ∊ csn ⟨ ∅ , A ⟩ ⇒ a ∊ scons B D $ by cun_intro_l [l7]
l9: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} $ by ax
l10: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ ∃ i ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) $ by cab_elim [l9]
l11: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C $ by ax
l12: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ suc i , y ⟩ $ by and_elim_l [l11]
l13: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ i , y ⟩ ∈ C $ by and_elim_r [l11]
l14: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ C = D $ by weaken [#2]
l15: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ i , y ⟩ ∈ D $ by wcel_eq_r [l14, l13]
l16: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D $ by and_intro [l12, l15]
l17: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_intro [l16]
l18: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ∃ i ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_intro [l17]
l19: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)} $ by cab_intro [l18]
l20: $ G , a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a ∊ scons B D $ by cun_intro_r [l19]
l21: $ G , ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⇒ ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) $ by ax
l22: $ G , ∃ y (a = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⇒ a ∊ scons B D $ by ex_elim [l21, l20]
l23: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ a ∊ scons B D $ by ex_elim [l10, l22]
l24: $ G ⇒ a ∊ scons B D $ by or_elim [l1, l8, l23]

scons_eq
--------
l1: $ G , u ∊ scons A C ⇒ u ∊ scons A C $ by ax
l2: $ G , u ∊ scons A C ⇒ A = B $ by weaken [#1]
l3: $ G , u ∊ scons A C ⇒ C = D $ by weaken [#2]
l4: $ … ⇒ u ∊ scons B D $ by welc_scons_eq [l2, l3, l1]
l5: $ … ⇒ B = A $ by eq_sym [#1]
l6: $ … ⇒ D = C $ by eq_sym [#2]
l7: $ G , u ∊ scons B D ⇒ u ∊ scons B D $ by ax
l8: $ G , u ∊ scons B D ⇒ B = A $ by weaken [l5]
l9: $ G , u ∊ scons B D ⇒ D = C $ by weaken [l6]
l10: $ … ⇒ u ∊ scons A C $ by welc_scons_eq [l8, l9, l7]
l11: $ … ⇒ scons A C = scons B D $ by eq_intro [l4, l10]

sb_c_scons
----------
l1: $ (⟦ x / t ⟧ (csn ⟨ ∅ , A ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ B)})) ≐ (csn ⟨ ∅ , ⟦ x / t ⟧ A ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ (⟦ x / t ⟧ B))}) $ by ceqt_refl

ssnoc_congr
-----------
l1: $ cdm A ≐ cdm B $ by cdm_congr [#1]
l2: $ ⟨ cdm A , C ⟩ ≐ ⟨ cdm B , D ⟩ $ by opair_congr [l1, #2]
l3: $ csn ⟨ cdm A , C ⟩ ≐ csn ⟨ cdm B , D ⟩ $ by csn_congr [l2]
l4: $ (A ∪ csn ⟨ cdm A , C ⟩) ≐ (B ∪ csn ⟨ cdm B , D ⟩) $ by cun_congr [#1, l3]

ssnoc_eq
--------
l1: $ … ⇒ cdm A = cdm B $ by cdm_eq [#1]
l2: $ … ⇒ ⟨ cdm A , C ⟩ = ⟨ cdm B , D ⟩ $ by opair_eq [l1, #2]
l3: $ … ⇒ csn ⟨ cdm A , C ⟩ = csn ⟨ cdm B , D ⟩ $ by csn_eq [l2]
l4: $ … ⇒ A ∪ csn ⟨ cdm A , C ⟩ = B ∪ csn ⟨ cdm B , D ⟩ $ by cun_eq [#1, l3]

sb_c_ssnoc
----------
l1: $ (⟦ x / t ⟧ (A ∪ csn ⟨ cdm A , B ⟩)) ≐ ((⟦ x / t ⟧ A) ∪ csn ⟨ cdm (⟦ x / t ⟧ A) , ⟦ x / t ⟧ B ⟩) $ by ceqt_refl

scat_congr
----------
l1: $ cdm A ≐ cdm B $ by cdm_congr [#1]
l2: $ i ≐ i $ by ceqt_refl
l3: $ nadd (cdm A) i ≐ nadd (cdm B) i $ by nadd_congr [l1, l2]
l4: $ y ≐ y $ by ceqt_refl
l5: $ ⟨ nadd (cdm A) i , y ⟩ ≐ ⟨ nadd (cdm B) i , y ⟩ $ by opair_congr [l3, l4]
l6: $ z ≐ z $ by ceqt_refl
l7: $ (z = ⟨ nadd (cdm A) i , y ⟩) ⟺ (z = ⟨ nadd (cdm B) i , y ⟩) $ by ceq_congr [l6, l5]
l8: $ ⟨ i , y ⟩ ≐ ⟨ i , y ⟩ $ by ceqt_refl
l9: $ (⟨ i , y ⟩ ∈ C) ⟺ (⟨ i , y ⟩ ∈ D) $ by wcel_congr [l8, #2]
l10: $ (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by and_congr [l7, l9]
l11: $ ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_congr [l10]
l12: $ ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⟺ ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_congr [l11]
l13: $ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ≐ {z | ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)} $ by cab_congr [l12]
l14: $ (A ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)}) ≐ (B ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)}) $ by cun_congr [#1, l13]

welc_scat_eq
------------
l1: $ G ⇒ a ∊ A ∨ a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} $ by cun_elim [#3]
l2: $ G , a ∊ A ⇒ a ∊ A $ by ax
l3: $ G , a ∊ A ⇒ A = B $ by weaken [#1]
l4: $ G , a ∊ A ⇒ a ∊ B $ by welc_eq [l3, l2]
l5: $ G , a ∊ A ⇒ a ∊ B ++ D $ by cun_intro_l [l4]
l9: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} $ by ax
l10: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ ∃ i ∃ y (a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) $ by cab_elim [l9]
l11: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C $ by ax
l12: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ nadd (cdm A) i , y ⟩ $ by and_elim_l [l11]
l13: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ i , y ⟩ ∈ C $ by and_elim_r [l11]
l14: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ C = D $ by weaken [#2]
l15: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ i , y ⟩ ∈ D $ by wcel_eq_r [l14, l13]
l30: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ A = B $ by weaken [#1]
l31: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ cdm A = cdm B $ by cdm_eq [l30]
l32: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ i = i $ by eq_refl
l33: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ nadd (cdm A) i = nadd (cdm B) i $ by nadd_eq [l31, l32]
l34: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ y = y $ by eq_refl
l35: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ⟨ nadd (cdm A) i , y ⟩ = ⟨ nadd (cdm B) i , y ⟩ $ by opair_eq [l33, l34]
l36: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ nadd (cdm B) i , y ⟩ $ by eq_trans [l12, l35]
l16: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D $ by and_intro [l36, l15]
l17: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ∃ y (a = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_intro [l16]
l18: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ ∃ i ∃ y (a = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D) $ by ex_intro [l17]
l19: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm B) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ D)} $ by cab_intro [l18]
l20: $ G , a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C ⇒ a ∊ B ++ D $ by cun_intro_r [l19]
l21: $ G , ∃ y (a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⇒ ∃ y (a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) $ by ax
l22: $ G , ∃ y (a = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C) ⇒ a ∊ B ++ D $ by ex_elim [l21, l20]
l23: $ G , a ∊ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ C)} ⇒ a ∊ B ++ D $ by ex_elim [l10, l22]
l24: $ G ⇒ a ∊ B ++ D $ by or_elim [l1, l5, l23]

scat_eq
-------
l1: $ G , u ∊ A ++ C ⇒ u ∊ A ++ C $ by ax
l2: $ G , u ∊ A ++ C ⇒ A = B $ by weaken [#1]
l3: $ G , u ∊ A ++ C ⇒ C = D $ by weaken [#2]
l4: $ … ⇒ u ∊ B ++ D $ by welc_scat_eq [l2, l3, l1]
l5: $ … ⇒ B = A $ by eq_sym [#1]
l6: $ … ⇒ D = C $ by eq_sym [#2]
l7: $ G , u ∊ B ++ D ⇒ u ∊ B ++ D $ by ax
l8: $ G , u ∊ B ++ D ⇒ B = A $ by weaken [l5]
l9: $ G , u ∊ B ++ D ⇒ D = C $ by weaken [l6]
l10: $ … ⇒ u ∊ A ++ C $ by welc_scat_eq [l8, l9, l7]
l11: $ … ⇒ A ++ C = B ++ D $ by eq_intro [l4, l10]

sb_c_scat
---------
l1: $ (⟦ x / t ⟧ (A ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm A) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ B)})) ≐ ((⟦ x / t ⟧ A) ∪ {z | ∃ i ∃ y (z = ⟨ nadd (cdm (⟦ x / t ⟧ A)) i , y ⟩ ∧ ⟨ i , y ⟩ ∈ (⟦ x / t ⟧ B))}) $ by ceqt_refl

fseq_intro
----------
l1: $ … ⇒ cdm s = n ∧ fn_into s n A $ by and_intro [#3, #4]
l2: $ … ⇒ rel s ∧ cdm s = n ∧ fn_into s n A $ by and_intro [#2, l1]
l3: $ … ⇒ n ∊ ω ∧ rel s ∧ cdm s = n ∧ fn_into s n A $ by and_intro [#1, l2]
l4: $ … ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by ex_intro [l3]
l5: $ G ⇒ s ∊ fseq A $ by cab_intro [l4]

fseq_of_fn
----------
l1: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
l2: $ G , k = cdm s , k ∊ ω ⇒ k ∊ ω $ by ax
l3: $ G , k = cdm s , k ∊ ω , x ∊ k ⇒ x ∊ k $ by ax
l4: $ G , k = cdm s , k ∊ ω , x ∊ k ⇒ k = cdm s $ by weaken [l1]
l5: $ … ⇒ x ∊ cdm s $ by welc_eq [l4, l3]
l6: $ G , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
l7: $ … ⇒ y ∊ crn s $ by crn_intro [l6]
l8: $ G , ⟨ x , y ⟩ ∈ s ⇒ crn s ⊆ A $ by weaken [#4]
l9: $ … ⇒ y ∊ A $ by subset_elim [l8, l7]
l10: $ … ⇒ y ∊ A ∧ ⟨ x , y ⟩ ∈ s $ by and_intro [l9, l6]
l11: $ … ⇒ ∃ v (v ∊ A ∧ ⟨ x , v ⟩ ∈ s) $ by ex_intro [l10]
l12: $ … ⇒ ∃ v (v ∊ A ∧ ⟨ x , v ⟩ ∈ s) $ by cdm_elim [l5, l11]
l13: $ G , k = cdm s , k ∊ ω ⇒ functional s $ by weaken [#1]
l14: $ … ⇒ fn_into s k A $ by fn_into_intro [l13, l12]
l15: $ G , k = cdm s , k ∊ ω ⇒ rel s $ by weaken [#2]
l16: $ … ⇒ cdm s = k $ by eq_sym [l1]
l17: $ … ⇒ s ∊ fseq A $ by fseq_intro [l2, l15, l16, l14]
l18: $ … ⇒ s ∊ fseq A $ by wcel_elim [#3, l17]

fseq_functional
---------------
l1: $ … ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by cab_elim [#1]
l2: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $ by ax
l3: $ … ⇒ rel s ∧ cdm s = k ∧ fn_into s k A $ by and_elim_r [l2]
l4: $ … ⇒ cdm s = k ∧ fn_into s k A $ by and_elim_r [l3]
l5: $ … ⇒ fn_into s k A $ by and_elim_r [l4]
l6: $ … ⇒ functional s $ by fn_into_functional [l5]
l7: $ … ⇒ functional s $ by ex_elim [l1, l6]

fseq_rel
--------
l1: $ … ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by cab_elim [#1]
l2: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $ by ax
l3: $ … ⇒ rel s ∧ cdm s = k ∧ fn_into s k A $ by and_elim_r [l2]
l4: $ … ⇒ rel s $ by and_elim_l [l3]
l5: $ … ⇒ rel s $ by ex_elim [l1, l4]

fseq_len
--------
l1: $ … ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by cab_elim [#1]
l2: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $ by ax
l3: $ … ⇒ k ∊ ω $ by and_elim_l [l2]
l4: $ … ⇒ rel s ∧ cdm s = k ∧ fn_into s k A $ by and_elim_r [l2]
l5: $ … ⇒ cdm s = k ∧ fn_into s k A $ by and_elim_r [l4]
l6: $ … ⇒ cdm s = k $ by and_elim_l [l5]
l7: $ … ⇒ k = cdm s $ by eq_sym [l6]
l8: $ … ⇒ cdm s ∈ ω $ by wcel_intro [l7, l3]
l9: $ … ⇒ cdm s ∈ ω $ by ex_elim [l1, l8]

fseq_fn_into
------------
l1: $ … ⇒ ∃ k (k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A) $ by cab_elim [#1]
l2: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A $ by ax
l4: $ … ⇒ rel s ∧ cdm s = k ∧ fn_into s k A $ by and_elim_r [l2]
l5: $ … ⇒ cdm s = k ∧ fn_into s k A $ by and_elim_r [l4]
l6: $ … ⇒ cdm s = k $ by and_elim_l [l5]
l7: $ … ⇒ fn_into s k A $ by and_elim_r [l5]
l8: $ … ⇒ k = cdm s $ by eq_sym [l6]
l9: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ s = s $ by eq_refl
l10: $ G , k ∊ ω ∧ rel s ∧ cdm s = k ∧ fn_into s k A ⇒ A = A $ by eq_refl
l11: $ … ⇒ fn_into s (cdm s) A $ by fn_into_eq [l9, l8, l10, l7]
l12: $ … ⇒ fn_into s (cdm s) A $ by ex_elim [l1, l11]

fseq_fv
-------
l1: $ … ⇒ fn_into s (cdm s) A $ by fseq_fn_into [#1]
l2: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ ⟨ i , y ⟩ ∈ s $ by ax
l3: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ y ∊ A $ by ax
l4: $ G , y ∊ A , ⟨ i , y ⟩ ∈ s ⇒ s ∊ fseq A $ by weaken [#1]
l5: $ … ⇒ functional s $ by fseq_functional [l4]
l6: $ … ⇒ s' i = y $ by fv_val [l5, l2]
l7: $ … ⇒ y = s' i $ by eq_sym [l6]
l8: $ … ⇒ s' i ∈ A $ by wcel_intro [l7, l3]
l9: $ … ⇒ s' i ∈ A $ by fn_into_elim [l1, #2, l8]

fseq_fv_total
-------------
l1: $ G ⇒ isset I ∨ ¬ isset I $ by excluded_middle
a0: $ G , isset I ⇒ isset I $ by ax
b1: $ G , isset I , i = I ⇒ i ∊ cdm r ∨ ¬ i ∊ cdm r $ by excluded_middle
b3: $ G , isset I , i = I , i ∊ cdm r ⇒ i ∊ cdm r $ by ax
wb4_1: $ G , i = I , i ∊ cdm r , isset I ⇒ r ∊ fseq A $ by weaken [#2]
b4: $ … ⇒ r' i ∈ A $ by fseq_fv [wb4_1, b3]
b5: $ G , isset I , i = I , ¬ i ∊ cdm r , i ∊ cdm r ⇒ ¬ i ∊ cdm r $ by ax
b6: $ G , isset I , i = I , ¬ i ∊ cdm r , i ∊ cdm r ⇒ i ∊ cdm r $ by ax
b7: $ … ⇒ ⊥ $ by not_elim [b5, b6]
b8: $ … ⇒ i ∊ cdm r → ⊥ $ by imp_intro [b7]
b9: $ … ⇒ r' i = ∅ $ by fv_empty [b8]
b11: $ G , isset I , i = I , ¬ i ∊ cdm r ⇒ ∅ ∈ A $ by weaken [#1]
b12: $ … ⇒ ∅ = r' i $ by eq_sym [b9]
b13: $ … ⇒ r' i ∈ A $ by wcel_eq_l [b12, b11]
b14: $ … ⇒ r' i ∈ A $ by or_elim [b1, b4, b13]
b15: $ G , isset I , i = I ⇒ r = r $ by eq_refl
b16: $ G , isset I , i = I ⇒ i = I $ by ax
b17: $ … ⇒ r' i = r' I $ by fv_eq [b15, b16]
b18: $ … ⇒ r' I ∈ A $ by wcel_eq_l [b17, b14]
b19: $ … ⇒ r' I ∈ A $ by isset_elim [a0, b18]
c1: $ G , ¬ isset I , x ∊ r' I ⇒ x ∊ r' I $ by ax
c2: $ G , ¬ isset I , x ∊ r' I , y ∊ ap r I , x ∊ y ⇒ y ∊ ap r I $ by ax
c3: $ … ⇒ ⟨ I , y ⟩ ∈ r $ by ap_elim [c2]
wc4_3: $ G , x ∊ r' I , x ∊ y , y ∊ ap r I , ¬ isset I ⇒ r ∊ fseq A $ by weaken [#2]
c4: $ … ⇒ rel r $ by fseq_rel [wc4_3]
c5: $ … ⇒ isset I $ by rel_pair_isset [c4, c3]
c6: $ G , ¬ isset I , x ∊ r' I , y ∊ ap r I , x ∊ y ⇒ ¬ isset I $ by ax
c7: $ … ⇒ ⊥ $ by not_elim [c6, c5]
c8: $ … ⇒ ⊥ $ by cuni_elim [c1, c7]
c9: $ … ⇒ r' I = ∅ $ by empty_eq_intro [c8]
c10: $ G , ¬ isset I ⇒ ∅ ∈ A $ by weaken [#1]
c11: $ … ⇒ ∅ = r' I $ by eq_sym [c9]
c12: $ … ⇒ r' I ∈ A $ by wcel_eq_l [c11, c10]
l2: $ … ⇒ r' I ∈ A $ by or_elim [l1, b19, c12]

fseq_crn
--------
l1: $ G , u ∊ crn s ⇒ u ∊ crn s $ by ax
l2: $ G , ⟨ v , u ⟩ ∈ s ⇒ ⟨ v , u ⟩ ∈ s $ by ax
l3: $ G , ⟨ v , u ⟩ ∈ s ⇒ s ∊ fseq A $ by weaken [#1]
l4: $ … ⇒ v ∊ cdm s $ by cdm_intro [l2]
l5: $ … ⇒ s' v ∈ A $ by fseq_fv [l3, l4]
l6: $ … ⇒ functional s $ by fseq_functional [l3]
l7: $ … ⇒ s' v = u $ by fv_val [l6, l2]
l8: $ … ⇒ u ∈ A $ by wcel_eq_l [l7, l5]
l9: $ … ⇒ u ∊ A $ by wcel_welc [l8]
l10: $ … ⇒ u ∊ A $ by crn_elim [l1, l9]
l11: $ … ⇒ crn s ⊆ A $ by subset_intro [l10]

fseq_crn_c
----------
l1: $ G , j = S , j ∊ fseq A ⇒ j ∊ fseq A $ by ax
l2: $ … ⇒ crn j ⊆ A $ by fseq_crn [l1]
l3: $ G , j = S , j ∊ fseq A ⇒ j = S $ by ax
l4: $ … ⇒ crn j = crn S $ by crn_eq [l3]
l5: $ … ⇒ crn S ⊆ A $ by subset_eq_l [l4, l2]
l6: $ … ⇒ crn S ⊆ A $ by wcel_elim [#1, l5]

fseq_mono
---------
l1: $ G , u ∊ fseq A ⇒ u ∊ fseq A $ by ax
l2: $ … ⇒ functional u $ by fseq_functional [l1]
l3: $ … ⇒ rel u $ by fseq_rel [l1]
l4: $ … ⇒ cdm u ∈ ω $ by fseq_len [l1]
l5: $ … ⇒ crn u ⊆ A $ by fseq_crn [l1]
l6: $ G , u ∊ fseq A ⇒ A ⊆ B $ by weaken [#1]
l7: $ … ⇒ crn u ⊆ B $ by subset_trans [l5, l6]
l8: $ … ⇒ u ∊ fseq B $ by fseq_of_fn [l2, l3, l4, l7]
l9: $ … ⇒ fseq A ⊆ fseq B $ by subset_intro [l8]

fseq_set
--------
l1: $ G , u ∊ fseq A ⇒ u ∊ fseq A $ by ax
l2: $ … ⇒ rel u $ by fseq_rel [l1]
l3: $ … ⇒ u ⊆ cdm u × crn u $ by rel_subset_cxp [l2]
l4: $ … ⇒ cdm u ∈ ω $ by fseq_len [l1]
l5: $ G , u ∊ fseq A , k = cdm u , k ∊ ω ⇒ k ∊ ω $ by ax
l6: $ G , u ∊ fseq A , k = cdm u , k ∊ ω ⇒ k = cdm u $ by ax
l7: $ … ⇒ k ⊆ ω $ by omega_elem_subset [l5]
l8: $ … ⇒ cdm u ⊆ ω $ by subset_eq_l [l6, l7]
l9: $ … ⇒ cdm u ⊆ ω $ by wcel_elim [l4, l8]
l10: $ … ⇒ crn u ⊆ A $ by fseq_crn [l1]
l11: $ … ⇒ cdm u × crn u ⊆ ω × A $ by cxp_mono [l9, l10]
l12: $ … ⇒ u ⊆ ω × A $ by subset_trans [l3, l11]
l13: $ … ⇒ u ∊ 𝒫 (ω × A) $ by cpw_intro [l12]
l14: $ … ⇒ fseq A ⊆ 𝒫 (ω × A) $ by subset_intro [l13]
l15: $ G ⇒ isset ω $ by omega_set
l16: $ … ⇒ isset (ω × A) $ by cxp_set [l15, #1]
l17: $ … ⇒ isset (𝒫 (ω × A)) $ by cpw_set [l16]
l18: $ … ⇒ isset (fseq A) $ by subset_isset [l17, l14]

fseq_ext
--------
l1: $ … ⇒ functional s $ by fseq_functional [#1]
l2: $ … ⇒ functional t $ by fseq_functional [#2]
l3: $ … ⇒ rel s $ by fseq_rel [#1]
l4: $ … ⇒ rel t $ by fseq_rel [#2]
l5: $ … ⇒ v ∊ cdm s → s' v = t' v $ by all_elim [#4]
l6: $ … ⇒ s' v = t' v $ by imp_use [l5]
l7: $ … ⇒ s = t $ by fv_ext [l1, l2, l3, l4, #3, l6]

lemma s1_mem_empty (G: hyps) (a b: set): $ G ⇒ a = ∅ $ > $ G ⇒ b ∊ a $ > $ G ⇒ ⊥ $
----
l1: $ … ⇒ b ∊ ∅ $ by welc_eq [#1, #2]
l2: $ … ⇒ ⊥ $ by empty_elim [l1]

lemma s1_wcel_empty (G: hyps) (A: class) (a: set): $ G ⇒ a = ∅ $ > $ G ⇒ A ∈ a $ > $ G ⇒ ⊥ $
----
l1: $ G , w = A , w ∊ a ⇒ w ∊ a $ by ax
l2: $ G , w = A , w ∊ a ⇒ a = ∅ $ by weaken [#1]
l3: $ … ⇒ ⊥ $ by s1_mem_empty [l2, l1]
l4: $ … ⇒ ⊥ $ by wcel_elim [#2, l3]

fseq_empty
----------
l1: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u , ⟨ x , z ⟩ ∈ u ⇒ ⟨ x , y ⟩ ∈ u $ by ax
l2: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u , ⟨ x , z ⟩ ∈ u ⇒ u = ∅ $ by ax
l3: $ … ⇒ ⊥ $ by s1_wcel_empty [l2, l1]
l4: $ … ⇒ y = z $ by bot_elim [l3]
l5: $ … ⇒ functional u $ by functional_intro [l4]
l6: $ G , u = ∅ , z ∊ u ⇒ z ∊ u $ by ax
l7: $ G , u = ∅ , z ∊ u ⇒ u = ∅ $ by ax
l8: $ … ⇒ ⊥ $ by s1_mem_empty [l7, l6]
l9: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by bot_elim [l8]
l10: $ … ⇒ rel u $ by rel_intro [l9]
l11: $ G , u = ∅ , x ∊ cdm u ⇒ x ∊ cdm u $ by ax
l12: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u ⇒ ⟨ x , y ⟩ ∈ u $ by ax
l13: $ G , u = ∅ , ⟨ x , y ⟩ ∈ u ⇒ u = ∅ $ by ax
l14: $ … ⇒ ⊥ $ by s1_wcel_empty [l13, l12]
l15: $ … ⇒ ⊥ $ by cdm_elim [l11, l14]
l16: $ … ⇒ cdm u = ∅ $ by empty_eq_intro [l15]
l17: $ … ⇒ ∅ = cdm u $ by eq_sym [l16]
l18: $ G , u = ∅ ⇒ ∅ ∈ ω $ by omega_zero
l19: $ … ⇒ cdm u ∈ ω $ by wcel_eq_l [l17, l18]
l20: $ G , u = ∅ , y ∊ crn u ⇒ y ∊ crn u $ by ax
l21: $ … ⇒ y ∊ A $ by bot_elim [l14]
l22: $ … ⇒ y ∊ A $ by crn_elim [l20, l21]
l23: $ … ⇒ crn u ⊆ A $ by subset_intro [l22]
l24: $ … ⇒ u ∊ fseq A $ by fseq_of_fn [l5, l10, l19, l23]
l25: $ G , u = ∅ ⇒ u = ∅ $ by ax
l26: $ … ⇒ ∅ ∈ fseq A $ by wcel_intro [l25, l24]
l27: $ G ⇒ isset ∅ $ by ax_empty
l28: $ … ⇒ ∅ ∈ fseq A $ by isset_elim [l27, l26]

cres_fseq
---------
a1: $ … ⇒ functional F $ by fn_into_functional [#2]
a2: $ … ⇒ isset N $ by wcel_isset [#1]
a3: $ … ⇒ isset (F ↾ N) $ by cres_set [a1, a2]
a4: $ … ⇒ fn_into (F ↾ N) N A $ by fn_into_cres [#2]
a5: $ … ⇒ N ⊆ cdm (F ↾ N) $ by fn_into_cdm [a4]
a6: $ G ⇒ cdm (F ↾ N) ⊆ N $ by cres_cdm
a7: $ … ⇒ cdm (F ↾ N) = N $ by subset_antisym [a6, a5]
a8: $ G ⇒ rel (F ↾ N) $ by cres_rel
b1: $ G , n = N , n ∊ ω , q = F ↾ N ⇒ q = F ↾ N $ by ax
b2: $ … ⇒ F ↾ N = q $ by eq_sym [b1]
b3: $ G , n = N , n ∊ ω , q = F ↾ N ⇒ rel (F ↾ N) $ by weaken [a8]
b4: $ … ⇒ rel q $ by rel_eq [b2, b3]
b5: $ G , n = N , n ∊ ω , q = F ↾ N ⇒ n = N $ by ax
b6: $ … ⇒ cdm q = cdm (F ↾ N) $ by cdm_eq [b1]
b7: $ G , n = N , n ∊ ω , q = F ↾ N ⇒ cdm (F ↾ N) = N $ by weaken [a7]
b8: $ … ⇒ N = n $ by eq_sym [b5]
b9: $ … ⇒ cdm q = N $ by eq_trans [b6, b7]
b10: $ … ⇒ cdm q = n $ by eq_trans [b9, b8]
b11: $ G , n = N , n ∊ ω , q = F ↾ N ⇒ fn_into (F ↾ N) N A $ by weaken [a4]
b12: $ G , n = N , n ∊ ω , q = F ↾ N ⇒ A = A $ by eq_refl
b13: $ … ⇒ fn_into q n A $ by fn_into_eq [b2, b8, b12, b11]
b14: $ G , n = N , n ∊ ω , q = F ↾ N ⇒ n ∊ ω $ by ax
b15: $ … ⇒ q ∊ fseq A $ by fseq_intro [b14, b4, b10, b13]
b16: $ … ⇒ F ↾ N ∈ fseq A $ by wcel_intro [b1, b15]
c0: $ G , n = N , n ∊ ω ⇒ isset (F ↾ N) $ by weaken [a3]
c1: $ … ⇒ F ↾ N ∈ fseq A $ by isset_elim [c0, b16]
c2: $ … ⇒ F ↾ N ∈ fseq A $ by wcel_elim [#1, c1]

fseq_len_zero
-------------
l1: $ G , u ∊ s ⇒ u ∊ s $ by ax
l3: $ G , u ∊ s ⇒ s ∊ fseq A $ by weaken [#1]
l2: $ … ⇒ rel s $ by fseq_rel [l3]
l4: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ u = ⟨ v , w ⟩ $ by ax
l5: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ u ∊ s $ by ax
l6: $ … ⇒ ⟨ v , w ⟩ ∈ s $ by wcel_intro [l4, l5]
l7: $ … ⇒ v ∊ cdm s $ by cdm_intro [l6]
l8: $ G , u ∊ s , u = ⟨ v , w ⟩ ⇒ cdm s = ∅ $ by weaken [#2]
l9: $ … ⇒ v ∊ ∅ $ by welc_eq [l8, l7]
l10: $ … ⇒ ⊥ $ by empty_elim [l9]
l11: $ … ⇒ ⊥ $ by rel_elim [l2, l1, l10]
l12: $ … ⇒ s = ∅ $ by empty_eq_intro [l11]

lemma s2_wcel_csn (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ csn A $
----
l1: $ G , z = A ⇒ z = A $ by ax
l2: $ … ⇒ z ∊ csn A $ by csn_intro [l1]
l3: $ … ⇒ A ∈ csn A $ by wcel_intro [l1, l2]
l4: $ … ⇒ A ∈ csn A $ by isset_elim [#1, l3]

lemma s2_fseq_c (G: hyps) (A S: class):
  $ G ⇒ functional S $ > $ G ⇒ rel S $ > $ G ⇒ cdm S ∈ ω $ > $ G ⇒ crn S ⊆ A $ >
  $ G ⇒ S ∈ fseq A $
----
l1: $ … ⇒ isset (cdm S) $ by wcel_isset [#3]
l2: $ … ⇒ isset S $ by functional_set [#1, #2, l1]
l3: $ G , v = S ⇒ v = S $ by ax
l4: $ … ⇒ S = v $ by eq_sym [l3]
l5: $ G , v = S ⇒ functional S $ by weaken [#1]
l6: $ … ⇒ functional v $ by functional_eq [l4, l5]
l7: $ G , v = S ⇒ rel S $ by weaken [#2]
l8: $ … ⇒ rel v $ by rel_eq [l4, l7]
l9: $ … ⇒ cdm S = cdm v $ by cdm_eq [l4]
l10: $ G , v = S ⇒ cdm S ∈ ω $ by weaken [#3]
l11: $ … ⇒ cdm v ∈ ω $ by wcel_eq_l [l9, l10]
l12: $ … ⇒ crn S = crn v $ by crn_eq [l4]
l13: $ G , v = S ⇒ crn S ⊆ A $ by weaken [#4]
l14: $ … ⇒ crn v ⊆ A $ by subset_eq_l [l12, l13]
l15: $ … ⇒ v ∊ fseq A $ by fseq_of_fn [l6, l8, l11, l14]
l16: $ … ⇒ S ∈ fseq A $ by wcel_intro [l3, l15]
l17: $ … ⇒ S ∈ fseq A $ by isset_elim [l2, l16]

lemma s2_cdm_intro_c (G: hyps) (R A B: class):
  $ G ⇒ ⟨ A , B ⟩ ∈ R $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ A ∈ cdm R $
----
l1: $ G , x = A , y = B ⇒ x = A $ by ax
l2: $ G , x = A , y = B ⇒ y = B $ by ax
l3: $ … ⇒ A = x $ by eq_sym [l1]
l4: $ … ⇒ B = y $ by eq_sym [l2]
l5: $ … ⇒ ⟨ A , B ⟩ = ⟨ x , y ⟩ $ by opair_eq [l3, l4]
l6: $ G , x = A , y = B ⇒ ⟨ A , B ⟩ ∈ R $ by weaken [#1]
l7: $ … ⇒ ⟨ x , y ⟩ ∈ R $ by wcel_eq_l [l5, l6]
l8: $ … ⇒ x ∊ cdm R $ by cdm_intro [l7]
l9: $ … ⇒ A ∈ cdm R $ by wcel_intro [l1, l8]
l10: $ … ⇒ A ∈ cdm R $ by isset_elim [#3, l9]
l11: $ … ⇒ A ∈ cdm R $ by isset_elim [#2, l10]

lemma s2_crn_intro_c (G: hyps) (R A B: class):
  $ G ⇒ ⟨ A , B ⟩ ∈ R $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ B ∈ crn R $
----
l1: $ G , x = A , y = B ⇒ x = A $ by ax
l2: $ G , x = A , y = B ⇒ y = B $ by ax
l3: $ … ⇒ A = x $ by eq_sym [l1]
l4: $ … ⇒ B = y $ by eq_sym [l2]
l5: $ … ⇒ ⟨ A , B ⟩ = ⟨ x , y ⟩ $ by opair_eq [l3, l4]
l6: $ G , x = A , y = B ⇒ ⟨ A , B ⟩ ∈ R $ by weaken [#1]
l7: $ … ⇒ ⟨ x , y ⟩ ∈ R $ by wcel_eq_l [l5, l6]
l8: $ … ⇒ y ∊ crn R $ by crn_intro [l7]
l9: $ … ⇒ B ∈ crn R $ by wcel_intro [l2, l8]
l10: $ … ⇒ B ∈ crn R $ by isset_elim [#3, l9]
l11: $ … ⇒ B ∈ crn R $ by isset_elim [#2, l10]

lemma s2_fseq_pair_omega (G: hyps) (A: class) (s i y: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ ⟨ i , y ⟩ ∈ s $ > $ G ⇒ i ∊ ω $
----
l1: $ … ⇒ i ∊ cdm s $ by cdm_intro [#2]
l2: $ … ⇒ cdm s ∈ ω $ by fseq_len [#1]
l3: $ G , k = cdm s , k ∊ ω ⇒ k = cdm s $ by ax
l4: $ G , k = cdm s , k ∊ ω ⇒ k ∊ ω $ by ax
l5: $ … ⇒ cdm s = k $ by eq_sym [l3]
l6: $ G , k = cdm s , k ∊ ω ⇒ i ∊ cdm s $ by weaken [l1]
l7: $ … ⇒ i ∊ k $ by welc_eq [l5, l6]
l8: $ … ⇒ i ∊ ω $ by omega_elem_omega [l4, l7]
l9: $ … ⇒ i ∊ ω $ by wcel_elim [l2, l8]

lemma s2_opair_ex (G: hyps) {x y: set} (A B: class) (z: set):
  $ G ⇒ z = ⟨ A , B ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $
----
l1: $ G , u = A , v = B ⇒ u = A $ by ax
l2: $ G , u = A , v = B ⇒ v = B $ by ax
l3: $ … ⇒ A = u $ by eq_sym [l1]
l4: $ … ⇒ B = v $ by eq_sym [l2]
l5: $ … ⇒ ⟨ A , B ⟩ = ⟨ u , v ⟩ $ by opair_eq [l3, l4]
l6: $ G , u = A , v = B ⇒ z = ⟨ A , B ⟩ $ by weaken [#1]
l7: $ … ⇒ z = ⟨ u , v ⟩ $ by eq_trans [l6, l5]
l8: $ … ⇒ ∃ y (z = ⟨ u , y ⟩) $ by ex_intro [l7]
l9: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_intro [l8]
l10: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by isset_elim [#3, l9]
l11: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by isset_elim [#2, l10]

lemma s2_scons_zero (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ … ⇒ isset ⟨ ∅ , A ⟩ $ by opair_set [l1, #1]
l3: $ … ⇒ ⟨ ∅ , A ⟩ ∈ csn ⟨ ∅ , A ⟩ $ by s2_wcel_csn [l2]
l4: $ G ⇒ csn ⟨ ∅ , A ⟩ ⊆ csn ⟨ ∅ , A ⟩ ∪ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by cun_subset_l
l5: $ … ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by wcel_subset [l4, l3]

lemma s2_scons_suc (G: hyps) (A S: class) (j y: set):
  $ G ⇒ ⟨ j , y ⟩ ∈ S $ > $ G ⇒ ⟨ suc j , y ⟩ ∈ scons A S $
----
l1: $ G ⇒ isset j $ by isset_var
l2: $ … ⇒ isset (suc j) $ by suc_set [l1]
l3: $ G ⇒ isset y $ by isset_var
l4: $ … ⇒ isset ⟨ suc j , y ⟩ $ by opair_set [l2, l3]
l5: $ G , z = ⟨ suc j , y ⟩ ⇒ z = ⟨ suc j , y ⟩ $ by ax
l6: $ G , z = ⟨ suc j , y ⟩ ⇒ ⟨ j , y ⟩ ∈ S $ by weaken [#1]
l7: $ … ⇒ z = ⟨ suc j , y ⟩ ∧ ⟨ j , y ⟩ ∈ S $ by and_intro [l5, l6]
l8: $ … ⇒ ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by ex_intro [l7]
l9: $ … ⇒ ∃ i ∃ k (z = ⟨ suc i , k ⟩ ∧ ⟨ i , k ⟩ ∈ S) $ by ex_intro [l8]
l10: $ … ⇒ z ∊ {w | ∃ i ∃ k (w = ⟨ suc i , k ⟩ ∧ ⟨ i , k ⟩ ∈ S)} $ by cab_intro [l9]
l11: $ … ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∪ {w | ∃ i ∃ k (w = ⟨ suc i , k ⟩ ∧ ⟨ i , k ⟩ ∈ S)} $ by cun_intro_r [l10]
l12: $ … ⇒ ⟨ suc j , y ⟩ ∈ scons A S $ by wcel_intro [l5, l11]
l13: $ … ⇒ ⟨ suc j , y ⟩ ∈ scons A S $ by isset_elim [l4, l12]

scons_pair
----------
l1: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∪ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by ax
l2: $ … ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∨ z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by cun_elim [l1]
a1: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z ∊ csn ⟨ ∅ , A ⟩ $ by ax
a2: $ … ⇒ z = ⟨ ∅ , A ⟩ $ by csn_elim [a1]
a3: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z = ⟨ U , v ⟩ $ by ax
a4: $ … ⇒ ⟨ U , v ⟩ = z $ by eq_sym [a3]
a5: $ … ⇒ ⟨ U , v ⟩ = ⟨ ∅ , A ⟩ $ by eq_trans [a4, a2]
a6: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset U $ by weaken [#2]
a7: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset v $ by isset_var
a8: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset ∅ $ by ax_empty
a9: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset A $ by weaken [#3]
a10: $ … ⇒ U = ∅ ∧ v = A $ by opair_inj_c [a5, a6, a7, a8, a9]
a11: $ … ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by or_intro_l [a10]
b1: $ G , z = ⟨ U , v ⟩ , z ∊ scons A S , z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by ax
b2: $ … ⇒ ∃ j ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by cab_elim [b1]
c1: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S $ by ax
c2: $ … ⇒ z = ⟨ suc j , k ⟩ $ by and_elim_l [c1]
c3: $ … ⇒ ⟨ j , k ⟩ ∈ S $ by and_elim_r [c1]
c4: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ z = ⟨ U , v ⟩ $ by ax
c5: $ … ⇒ ⟨ U , v ⟩ = z $ by eq_sym [c4]
c6: $ … ⇒ ⟨ U , v ⟩ = ⟨ suc j , k ⟩ $ by eq_trans [c5, c2]
c7: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset U $ by weaken [#2]
c8: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset v $ by isset_var
c9: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset j $ by isset_var
c10: $ … ⇒ isset (suc j) $ by suc_set [c9]
c11: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset k $ by isset_var
c12: $ … ⇒ U = suc j ∧ v = k $ by opair_inj_c [c6, c7, c8, c10, c11]
c13: $ … ⇒ U = suc j $ by and_elim_l [c12]
c14: $ … ⇒ v = k $ by and_elim_r [c12]
c15: $ … ⇒ k = v $ by eq_sym [c14]
c16: $ G , z = ⟨ U , v ⟩ , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ j = j $ by eq_refl
c17: $ … ⇒ ⟨ j , k ⟩ = ⟨ j , v ⟩ $ by opair_eq [c16, c15]
c18: $ … ⇒ ⟨ j , v ⟩ ∈ S $ by wcel_eq_l [c17, c3]
c19: $ … ⇒ U = suc j ∧ ⟨ j , v ⟩ ∈ S $ by and_intro [c13, c18]
c20: $ … ⇒ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by ex_intro [c19]
c21: $ … ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by or_intro_r [c20]
d1: $ G , z = ⟨ U , v ⟩ , ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) ⇒ ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by ax
d2: $ … ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by ex_elim [d1, c21]
d3: $ … ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by ex_elim [b2, d2]
e1: $ … ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by or_elim [l2, a11, d3]
e2: $ … ⇒ (U = ∅ ∧ v = A) ∨ ∃ i (U = suc i ∧ ⟨ i , v ⟩ ∈ S) $ by wcel_elim [#1, e1]

lemma s2_scons_rel (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ rel (scons A S) $
----
l1: $ G , z ∊ scons A S ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∪ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by ax
l2: $ … ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∨ z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by cun_elim [l1]
a1: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z ∊ csn ⟨ ∅ , A ⟩ $ by ax
a2: $ … ⇒ z = ⟨ ∅ , A ⟩ $ by csn_elim [a1]
a3: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset ∅ $ by ax_empty
a4: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset A $ by weaken [#1]
a5: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by s2_opair_ex [a2, a3, a4]
b1: $ G , z ∊ scons A S , z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S)} $ by ax
b2: $ … ⇒ ∃ j ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by cab_elim [b1]
c1: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S $ by ax
c2: $ … ⇒ z = ⟨ suc j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset j $ by isset_var
c4: $ … ⇒ isset (suc j) $ by suc_set [c3]
c5: $ G , z ∊ scons A S , z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S ⇒ isset k $ by isset_var
c6: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by s2_opair_ex [c2, c4, c5]
d1: $ G , z ∊ scons A S , ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) ⇒ ∃ k (z = ⟨ suc j , k ⟩ ∧ ⟨ j , k ⟩ ∈ S) $ by ax
d2: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [d1, c6]
d3: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [b2, d2]
e1: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by or_elim [l2, a5, d3]
e2: $ … ⇒ rel (scons A S) $ by rel_intro [e1]

lemma s2_scons_functional (G: hyps) (A S: class):
  $ G ⇒ isset A $ > $ G ⇒ functional S $ > $ G ⇒ functional (scons A S) $
----
f1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ ⟨ x , y ⟩ ∈ scons A S $ by ax
f2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ ⟨ x , z ⟩ ∈ scons A S $ by ax
f3: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ isset x $ by isset_var
f4: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S ⇒ isset A $ by weaken [#1]
f5: $ … ⇒ (x = ∅ ∧ y = A) ∨ ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by scons_pair [f1, f3, f4]
f6: $ … ⇒ (x = ∅ ∧ z = A) ∨ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by scons_pair [f2, f3, f4]
g1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A ⇒ (x = ∅ ∧ z = A) ∨ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by weaken [f6]
h1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = ∅ ∧ z = A ⇒ x = ∅ ∧ y = A $ by ax
h2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = ∅ ∧ z = A ⇒ x = ∅ ∧ z = A $ by ax
h3: $ … ⇒ y = A $ by and_elim_r [h1]
h4: $ … ⇒ z = A $ by and_elim_r [h2]
h5: $ … ⇒ A = z $ by eq_sym [h4]
h6: $ … ⇒ y = z $ by eq_trans [h3, h5]
k1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = ∅ ∧ y = A $ by ax
k2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc j ∧ ⟨ j , z ⟩ ∈ S $ by ax
k3: $ … ⇒ x = ∅ $ by and_elim_l [k1]
k4: $ … ⇒ x = suc j $ by and_elim_l [k2]
k5: $ … ⇒ suc j = x $ by eq_sym [k4]
k6: $ … ⇒ suc j = ∅ $ by eq_trans [k5, k3]
k7: $ … ⇒ ⊥ $ by suc_ne_empty [k6]
k8: $ … ⇒ y = z $ by bot_elim [k7]
k9: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = ∅ ∧ y = A , ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) ⇒ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by ax
k10: $ … ⇒ y = z $ by ex_elim [k9, k8]
g2: $ … ⇒ y = z $ by or_elim [g1, h6, k10]
m1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ (x = ∅ ∧ z = A) ∨ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by weaken [f6]
n1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ x = suc i ∧ ⟨ i , y ⟩ ∈ S $ by ax
n2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = ∅ ∧ z = A ⇒ x = ∅ ∧ z = A $ by ax
n3: $ … ⇒ x = suc i $ by and_elim_l [n1]
n4: $ … ⇒ x = ∅ $ by and_elim_l [n2]
n5: $ … ⇒ suc i = x $ by eq_sym [n3]
n6: $ … ⇒ suc i = ∅ $ by eq_trans [n5, n4]
n7: $ … ⇒ ⊥ $ by suc_ne_empty [n6]
n8: $ … ⇒ y = z $ by bot_elim [n7]
p1: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc i ∧ ⟨ i , y ⟩ ∈ S $ by ax
p2: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ x = suc j ∧ ⟨ j , z ⟩ ∈ S $ by ax
p3: $ … ⇒ x = suc i $ by and_elim_l [p1]
p4: $ … ⇒ x = suc j $ by and_elim_l [p2]
p5: $ … ⇒ suc i = x $ by eq_sym [p3]
p6: $ … ⇒ suc i = suc j $ by eq_trans [p5, p4]
p7: $ … ⇒ i = j $ by suc_inj [p6]
p8: $ … ⇒ j = i $ by eq_sym [p7]
p9: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ z = z $ by eq_refl
p10: $ … ⇒ ⟨ j , z ⟩ = ⟨ i , z ⟩ $ by opair_eq [p8, p9]
p11: $ … ⇒ ⟨ j , z ⟩ ∈ S $ by and_elim_r [p2]
p12: $ … ⇒ ⟨ i , z ⟩ ∈ S $ by wcel_eq_l [p10, p11]
p13: $ … ⇒ ⟨ i , y ⟩ ∈ S $ by and_elim_r [p1]
p14: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , x = suc j ∧ ⟨ j , z ⟩ ∈ S ⇒ functional S $ by weaken [#2]
p15: $ … ⇒ y = z $ by functional_elim [p14, p13, p12]
p16: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S , ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) ⇒ ∃ j (x = suc j ∧ ⟨ j , z ⟩ ∈ S) $ by ax
p17: $ … ⇒ y = z $ by ex_elim [p16, p15]
m2: $ … ⇒ y = z $ by or_elim [m1, n8, p17]
m3: $ G , ⟨ x , y ⟩ ∈ scons A S , ⟨ x , z ⟩ ∈ scons A S , ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) ⇒ ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by ax
m4: $ … ⇒ y = z $ by ex_elim [m3, m2]
q1: $ … ⇒ y = z $ by or_elim [f5, g2, m4]
q2: $ … ⇒ functional (scons A S) $ by functional_intro [q1]

lemma s2_scons_cdm (G: hyps) (A S: class) (n: set):
  $ G ⇒ isset A $ > $ G ⇒ n ∊ ω $ > $ G ⇒ cdm S = n $ > $ G ⇒ cdm (scons A S) = suc n $
----
t1: $ G , w ∊ cdm (scons A S) ⇒ w ∊ cdm (scons A S) $ by ax
t2: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S ⇒ ⟨ w , y ⟩ ∈ scons A S $ by ax
t3: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S ⇒ isset w $ by isset_var
t4: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S ⇒ isset A $ by weaken [#1]
t5: $ … ⇒ (w = ∅ ∧ y = A) ∨ ∃ j (w = suc j ∧ ⟨ j , y ⟩ ∈ S) $ by scons_pair [t2, t3, t4]
u1: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A ⇒ n ∊ ω $ by weaken [#2]
u2: $ … ⇒ ∅ ∈ n ∨ ∅ = n $ by omega_zero_le [u1]
v1: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ ∅ ∈ n $ by ax
v2: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ ∈ n ⇒ w = ∅ ∧ y = A $ by ax
v3: $ … ⇒ w = ∅ $ by and_elim_l [v2]
v4: $ … ⇒ ∅ = w $ by eq_sym [v3]
v5: $ … ⇒ w ∈ n $ by wcel_eq_l [v4, v1]
v6: $ … ⇒ w ∊ n $ by wcel_welc [v5]
v7: $ … ⇒ w ∊ suc n $ by suc_intro_l [v6]
x1: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ = n ⇒ ∅ = n $ by ax
x2: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = ∅ ∧ y = A , ∅ = n ⇒ w = ∅ ∧ y = A $ by ax
x3: $ … ⇒ w = ∅ $ by and_elim_l [x2]
x4: $ … ⇒ w = n $ by eq_trans [x3, x1]
x5: $ … ⇒ w ∊ suc n $ by suc_intro_r [x4]
u3: $ … ⇒ w ∊ suc n $ by or_elim [u2, v7, x5]
y1: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ w = suc j ∧ ⟨ j , y ⟩ ∈ S $ by ax
y2: $ … ⇒ w = suc j $ by and_elim_l [y1]
y3: $ … ⇒ ⟨ j , y ⟩ ∈ S $ by and_elim_r [y1]
y4: $ … ⇒ j ∊ cdm S $ by cdm_intro [y3]
y5: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ cdm S = n $ by weaken [#3]
y6: $ … ⇒ j ∊ n $ by welc_eq [y5, y4]
y7: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , w = suc j ∧ ⟨ j , y ⟩ ∈ S ⇒ n ∊ ω $ by weaken [#2]
y9: $ … ⇒ suc j ∈ suc n $ by omega_suc_mono [y7, y6]
y10: $ … ⇒ suc j = w $ by eq_sym [y2]
y11: $ … ⇒ w ∈ suc n $ by wcel_eq_l [y10, y9]
y12: $ … ⇒ w ∊ suc n $ by wcel_welc [y11]
y13: $ G , w ∊ cdm (scons A S) , ⟨ w , y ⟩ ∈ scons A S , ∃ j (w = suc j ∧ ⟨ j , y ⟩ ∈ S) ⇒ ∃ j (w = suc j ∧ ⟨ j , y ⟩ ∈ S) $ by ax
y14: $ … ⇒ w ∊ suc n $ by ex_elim [y13, y12]
t6: $ … ⇒ w ∊ suc n $ by or_elim [t5, u3, y14]
t7: $ … ⇒ w ∊ suc n $ by cdm_elim [t1, t6]
z1: $ G , w ∊ suc n ⇒ w ∊ suc n $ by ax
z2: $ G , w ∊ suc n ⇒ n ∊ ω $ by weaken [#2]
z3: $ … ⇒ w ∊ ω $ by omega_suc_elem_omega [z2, z1]
z4: $ … ⇒ w = ∅ ∨ ∃ j (j ∊ ω ∧ w = suc j) $ by omega_cases [z3]
a1: $ G , w ∊ suc n , w = ∅ ⇒ w = ∅ $ by ax
a2: $ G , w ∊ suc n , w = ∅ ⇒ isset A $ by weaken [#1]
a3: $ … ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by s2_scons_zero [a2]
a4: $ G , w ∊ suc n , w = ∅ ⇒ isset ∅ $ by ax_empty
a5: $ … ⇒ ∅ ∈ cdm (scons A S) $ by s2_cdm_intro_c [a3, a4, a2]
a6: $ … ⇒ ∅ = w $ by eq_sym [a1]
a7: $ … ⇒ w ∈ cdm (scons A S) $ by wcel_eq_l [a6, a5]
a8: $ … ⇒ w ∊ cdm (scons A S) $ by wcel_welc [a7]
b1: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ j ∊ ω ∧ w = suc j $ by ax
b2: $ … ⇒ w = suc j $ by and_elim_r [b1]
b3: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ w ∊ suc n $ by ax
b4: $ … ⇒ w ∈ suc n $ by welc_wcel [b3]
b5: $ … ⇒ suc j ∈ suc n $ by wcel_eq_l [b2, b4]
b6: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ n ∊ ω $ by weaken [#2]
b7: $ … ⇒ ord n $ by ord_omega_elem [b6]
b8: $ … ⇒ j ∊ n $ by ord_suc_elem_suc_elim [b7, b5]
b9: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j ⇒ cdm S = n $ by weaken [#3]
b10: $ … ⇒ n = cdm S $ by eq_sym [b9]
b11: $ … ⇒ j ∊ cdm S $ by welc_eq [b10, b8]
c1: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ ⟨ j , y ⟩ ∈ S $ by ax
c2: $ … ⇒ ⟨ suc j , y ⟩ ∈ scons A S $ by s2_scons_suc [c1]
c3: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ j ∊ ω ∧ w = suc j $ by ax
c4: $ … ⇒ w = suc j $ by and_elim_r [c3]
c5: $ … ⇒ suc j = w $ by eq_sym [c4]
c6: $ G , w ∊ suc n , j ∊ ω ∧ w = suc j , ⟨ j , y ⟩ ∈ S ⇒ y = y $ by eq_refl
c7: $ … ⇒ ⟨ suc j , y ⟩ = ⟨ w , y ⟩ $ by opair_eq [c5, c6]
c8: $ … ⇒ ⟨ w , y ⟩ ∈ scons A S $ by wcel_eq_l [c7, c2]
c9: $ … ⇒ w ∊ cdm (scons A S) $ by cdm_intro [c8]
b12: $ … ⇒ w ∊ cdm (scons A S) $ by cdm_elim [b11, c9]
b13: $ G , w ∊ suc n , ∃ j (j ∊ ω ∧ w = suc j) ⇒ ∃ j (j ∊ ω ∧ w = suc j) $ by ax
b14: $ … ⇒ w ∊ cdm (scons A S) $ by ex_elim [b13, b12]
z5: $ … ⇒ w ∊ cdm (scons A S) $ by or_elim [z4, a8, b14]
z6: $ … ⇒ cdm (scons A S) = suc n $ by eq_intro [t7, z5]

