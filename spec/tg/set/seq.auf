def a0_snp (A: class) (.c .e .f: set): class = $ {c | c = ∅ ∨ ∃ e ∃ f (e ∊ fseq A ∧ f ∊ A ∧ c = ssnoc e f)} $

--| i7: one more entry in front of a sequence ending in `f`.
lemma a0_snoc_b (G: hyps) (A: class) (x y e f: set): $ G ⇒ x ∊ A $ > $ G ⇒ e ∊ fseq A $ > $ G ⇒ f ∊ A $ > $ G ⇒ y = ssnoc e f $ > $ G ⇒ scons x y ∈ a0_snp A $
----
a1: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ x ∊ A $ by weaken [#1]
a2: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ e ∊ fseq A $ by weaken [#2]
a3: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ f ∊ A $ by weaken [#3]
a4: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ y = ssnoc e f $ by weaken [#4]
a5: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ z = scons x y $ by ax
b1: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ n = scons x e $ by ax
b2: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ m = scons f ∅ $ by ax
b3: $ … ⇒ scons x e ∈ fseq A $ by scons_fseq [a1, a2]
b4: $ … ⇒ scons x e = n $ by eq_sym [b1]
b5a: $ … ⇒ n ∈ fseq A $ by wcel_eq_l [b4, b3]
b5: $ … ⇒ n ∊ fseq A $ by wcel_welc [b5a]
b6a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ ∅ ∈ fseq A $ by fseq_empty
b6b: $ … ⇒ f ∈ A $ by welc_wcel [a3]
b6c: $ … ⇒ scons f ∅ ∈ fseq A $ by scons_fseq_c [b6b, b6a]
b6d: $ … ⇒ scons f ∅ = m $ by eq_sym [b2]
b6e: $ … ⇒ m ∈ fseq A $ by wcel_eq_l [b6d, b6c]
b6: $ … ⇒ m ∊ fseq A $ by wcel_welc [b6e]
c1: $ … ⇒ ssnoc e f = e ++ (scons f ∅) $ by ssnoc_scat [a2]
c2a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ e = e $ by eq_refl
c2: $ … ⇒ e ++ (scons f ∅) = e ++ m $ by scat_eq [c2a, b6d]
c3: $ … ⇒ scons x e ++ m = scons x (e ++ m) $ by scat_scons [a2, b6]
c4: $ … ⇒ ssnoc n f = n ++ (scons f ∅) $ by ssnoc_scat [b5]
c5a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ n = n $ by eq_refl
c5: $ … ⇒ n ++ (scons f ∅) = n ++ m $ by scat_eq [c5a, b6d]
c5b: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ m = m $ by eq_refl
c6: $ … ⇒ scons x e ++ m = n ++ m $ by scat_eq [b4, c5b]
d1a: $ … ⇒ ssnoc e f = e ++ m $ by eq_trans [c1, c2]
d1: $ … ⇒ y = e ++ m $ by eq_trans [a4, d1a]
d2a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ x = x $ by eq_refl
d2: $ … ⇒ scons x y = scons x (e ++ m) $ by scons_eq [d2a, d1]
d3: $ … ⇒ z = scons x (e ++ m) $ by eq_trans [a5, d2]
d4: $ … ⇒ scons x (e ++ m) = scons x e ++ m $ by eq_sym [c3]
d5: $ … ⇒ z = scons x e ++ m $ by eq_trans [d3, d4]
d6: $ … ⇒ z = n ++ m $ by eq_trans [d5, c6]
d7a: $ … ⇒ ssnoc n f = n ++ m $ by eq_trans [c4, c5]
d7b: $ … ⇒ n ++ m = ssnoc n f $ by eq_sym [d7a]
d7: $ … ⇒ z = ssnoc n f $ by eq_trans [d6, d7b]
d8a: $ … ⇒ f ∊ A ∧ z = ssnoc n f $ by and_intro [a3, d7]
d8: $ … ⇒ n ∊ fseq A ∧ f ∊ A ∧ z = ssnoc n f $ by and_intro [b5, d8a]
d9: $ … ⇒ ∃ x8 (n ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc n x8) $ by ex_intro [d8]
d10: $ … ⇒ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by ex_intro [d9]
d11: $ … ⇒ z = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by or_intro_r [d10]
e1: $ G , z = scons x y , n = scons x e ⇒ isset ∅ $ by ax_empty
e2: $ … ⇒ isset (scons f ∅) $ by scons_set [e1]
e3: $ … ⇒ z = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by isset_elim [e2, d11]
e4: $ G , z = scons x y ⇒ isset e $ by isset_var
e5: $ … ⇒ isset (scons x e) $ by scons_set [e4]
e6: $ … ⇒ z = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by isset_elim [e5, e3]
e7: $ G ⇒ isset y $ by isset_var
e8: $ … ⇒ isset (scons x y) $ by scons_set [e7]
e9: $ G ⇒ scons x y ∈ a0_snp A $ by wcel_cab_intro [e8, e6]

lemma a0_snoc_a (G: hyps) (A: class) (x y: set): $ G ⇒ x ∊ A $ > $ G ⇒ y ∊ fseq A $ > $ G ⇒ y = ∅ $ > $ G ⇒ scons x y ∈ a0_snp A $
----
f1: $ G , z = scons x y ⇒ y = ∅ $ by weaken [#3]
f2: $ G , z = scons x y ⇒ x = x $ by eq_refl
f3: $ … ⇒ ssnoc y x = ssnoc ∅ x $ by ssnoc_eq [f1, f2]
f4: $ G , z = scons x y ⇒ ssnoc ∅ x = scons x ∅ $ by ssnoc_empty
f5: $ … ⇒ scons x y = scons x ∅ $ by scons_eq [f2, f1]
f6: $ G , z = scons x y ⇒ z = scons x y $ by ax
f7: $ … ⇒ z = scons x ∅ $ by eq_trans [f6, f5]
f8: $ … ⇒ ssnoc y x = scons x ∅ $ by eq_trans [f3, f4]
f9: $ … ⇒ scons x ∅ = ssnoc y x $ by eq_sym [f8]
f10: $ … ⇒ z = ssnoc y x $ by eq_trans [f7, f9]
f11: $ G , z = scons x y ⇒ y ∊ fseq A $ by weaken [#2]
f12: $ G , z = scons x y ⇒ x ∊ A $ by weaken [#1]
f13a: $ … ⇒ x ∊ A ∧ z = ssnoc y x $ by and_intro [f12, f10]
f13: $ … ⇒ y ∊ fseq A ∧ x ∊ A ∧ z = ssnoc y x $ by and_intro [f11, f13a]
f14: $ … ⇒ ∃ x8 (y ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc y x8) $ by ex_intro [f13]
f15: $ … ⇒ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by ex_intro [f14]
f16: $ … ⇒ z = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by or_intro_r [f15]
f17: $ G ⇒ isset y $ by isset_var
f18: $ … ⇒ isset (scons x y) $ by scons_set [f17]
f19: $ G ⇒ scons x y ∈ a0_snp A $ by wcel_cab_intro [f18, f16]

fseq_cases_snoc
---------------
a1: $ G , z = ∅ ⇒ z = ∅ $ by ax
a2: $ … ⇒ z = ∅ ∨ ∃ x5 ∃ x6 (x5 ∊ fseq A ∧ x6 ∊ A ∧ z = ssnoc x5 x6) $ by or_intro_l [a1]
a3: $ G ⇒ isset ∅ $ by ax_empty
a4: $ G ⇒ ∅ ∈ a0_snp A $ by wcel_cab_intro [a3, a2]
b1: $ G , x ∊ A , y ∊ fseq A , y ∊ a0_snp A ⇒ y ∊ a0_snp A $ by ax
b2: $ … ⇒ y = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8) $ by cab_elim [b1]
b3: $ G , x ∊ A , y ∊ fseq A , y ∊ a0_snp A ⇒ x ∊ A $ by ax
b4: $ G , x ∊ A , y ∊ fseq A , y ∊ a0_snp A ⇒ y ∊ fseq A $ by ax
f1: $ G , x ∊ A , y ∊ fseq A , y ∊ a0_snp A , y = ∅ ⇒ x ∊ A $ by weaken [b3]
f2: $ G , x ∊ A , y ∊ fseq A , y ∊ a0_snp A , y = ∅ ⇒ y ∊ fseq A $ by weaken [b4]
f3: $ G , x ∊ A , y ∊ fseq A , y ∊ a0_snp A , y = ∅ ⇒ y = ∅ $ by ax
f4: $ … ⇒ scons x y ∈ a0_snp A $ by a0_snoc_a [f1, f2, f3]
g1: $ G , x ∊ A , y ∊ fseq A , y ∊ a0_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 $ by ax
gp0: $ … ⇒ x7 ∊ fseq A $ by and_elim_l [g1]
gp0r: $ … ⇒ x8 ∊ A ∧ y = ssnoc x7 x8 $ by and_elim_r [g1]
gp1: $ … ⇒ x8 ∊ A $ by and_elim_l [gp0r]
gp2: $ … ⇒ y = ssnoc x7 x8 $ by and_elim_r [gp0r]
g2: $ G , x ∊ A , y ∊ fseq A , y ∊ a0_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ x ∊ A $ by weaken [b3]
g4a: $ … ⇒ scons x y ∈ a0_snp A $ by a0_snoc_b [g2, gp0, gp1, gp2]
g4: $ … ⇒ (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8) → scons x y ∈ a0_snp A $ by imp_intro [g4a]
ha1: $ … ⇒ ∀ x8 ((x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8) → scons x y ∈ a0_snp A) $ by all_intro [g4]
hb1: $ … ⇒ (∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8)) → scons x y ∈ a0_snp A $ by ex_elim_imp [ha1]
ha0: $ … ⇒ ∀ x7 ((∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8)) → scons x y ∈ a0_snp A) $ by all_intro [hb1]
hb0: $ … ⇒ (∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8)) → scons x y ∈ a0_snp A $ by ex_elim_imp [ha0]
g9a: $ … ⇒ scons x y ∈ a0_snp A $ by imp_use [hb0]
g9: $ … ⇒ scons x y ∈ a0_snp A $ by or_elim [b2, f4, g9a]
k4: $ … ⇒ y ∊ a0_snp A → scons x y ∈ a0_snp A $ by imp_intro [g9]
k5: $ … ⇒ y ∊ fseq A → y ∊ a0_snp A → scons x y ∈ a0_snp A $ by imp_intro [k4]
k6: $ … ⇒ x ∊ A → y ∊ fseq A → y ∊ a0_snp A → scons x y ∈ a0_snp A $ by imp_intro [k5]
k7: $ … ⇒ ∀ y (x ∊ A → y ∊ fseq A → y ∊ a0_snp A → scons x y ∈ a0_snp A) $ by all_intro [k6]
k8: $ … ⇒ ∀ x ∀ y (x ∊ A → y ∊ fseq A → y ∊ a0_snp A → scons x y ∈ a0_snp A) $ by all_intro [k7]
k9: $ … ⇒ fseq A ⊆ a0_snp A $ by fseq_ind [a4, k8]
k10: $ … ⇒ v ∊ a0_snp A $ by subset_elim [k9, #1]
k11: $ … ⇒ v = ∅ ∨ ∃ e ∃ f (e ∊ fseq A ∧ f ∊ A ∧ v = ssnoc e f) $ by cab_elim [k10]

fv_ccom
-------
l1: $ G , b = s' i , b ∊ cdm F ⇒ b = s' i $ by ax
l2: $ G , b = s' i , b ∊ cdm F ⇒ b ∊ cdm F $ by ax
l3: $ G , b = s' i , b ∊ cdm F ⇒ functional s $ by weaken [#2]
l4: $ G , b = s' i , b ∊ cdm F ⇒ functional F $ by weaken [#1]
l5: $ G , b = s' i , b ∊ cdm F ⇒ i ∊ cdm s $ by weaken [#3]
l6: $ … ⇒ ⟨ i , s' i ⟩ ∈ s $ by fv_in [l3, l5]
l7: $ … ⇒ s' i = b $ by eq_sym [l1]
l8: $ G , b = s' i , b ∊ cdm F ⇒ ⟨ i , s' i ⟩ = ⟨ i , b ⟩ $ by opair_eq [eq_refl [], l7]
l9: $ … ⇒ ⟨ i , b ⟩ ∈ s $ by wcel_eq_l [l8, l6]
l10: $ … ⇒ ⟨ b , F' b ⟩ ∈ F $ by fv_in [l4, l2]
l11: $ … ⇒ isset (F' b) $ by fv_set [l4]
m1: $ G , b = s' i , b ∊ cdm F , c = F' b ⇒ c = F' b $ by ax
m2: $ … ⇒ F' b = c $ by eq_sym [m1]
m3: $ G , b = s' i , b ∊ cdm F , c = F' b ⇒ ⟨ b , F' b ⟩ = ⟨ b , c ⟩ $ by opair_eq [eq_refl [], m2]
m4: $ … ⇒ ⟨ b , c ⟩ ∈ F $ by wcel_eq_l [m3, weaken [l10]]
m5: $ G , b = s' i , b ∊ cdm F , c = F' b ⇒ ⟨ i , c ⟩ ∈ ccom F s $ by ccom_intro [weaken [l9], m4]
m6: $ G , b = s' i , b ∊ cdm F , c = F' b ⇒ functional (ccom F s) $ by ccom_functional [weaken [l4], weaken [l3]]
m7: $ … ⇒ (ccom F s)' i = c $ by fv_val [m6, m5]
m8: $ … ⇒ (ccom F s)' i = F' b $ by eq_trans [m7, m1]
m9: $ G , b = s' i , b ∊ cdm F , c = F' b ⇒ F' b = F' s' i $ by fv_eq [eq_refl [], weaken [l1]]
m10: $ … ⇒ (ccom F s)' i = F' s' i $ by eq_trans [m8, m9]
l12: $ … ⇒ (ccom F s)' i = F' s' i $ by isset_elim [l11, m10]
l13: $ … ⇒ (ccom F s)' i = F' s' i $ by wcel_elim [#4, l12]

lemma s2_ccom_cdm (G: hyps) (F A B: class) (s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ fn_into F A B $ > $ G ⇒ cdm (ccom F s) = cdm s $
----
a1: $ G , x ∊ cdm (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s , ⟨ x , u ⟩ ∈ s , ⟨ u , y ⟩ ∈ F ⇒ ⟨ x , u ⟩ ∈ s $ by ax
a2: $ … ⇒ x ∊ cdm s $ by cdm_intro [a1]
a3: $ G , x ∊ cdm (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s ⇒ ⟨ x , y ⟩ ∈ ccom F s $ by ax
a4: $ … ⇒ x ∊ cdm s $ by ccom_elim [a3, a2]
a5: $ G , x ∊ cdm (ccom F s) ⇒ x ∊ cdm (ccom F s) $ by ax
a6: $ … ⇒ x ∊ cdm s $ by cdm_elim [a5, a4]
b1: $ G , x ∊ cdm s , ⟨ x , u ⟩ ∈ s ⇒ ⟨ x , u ⟩ ∈ s $ by ax
b2: $ … ⇒ u ∊ crn s $ by crn_intro [b1]
b3: $ G , x ∊ cdm s , ⟨ x , u ⟩ ∈ s ⇒ s ∊ fseq A $ by weaken [#1]
b4: $ … ⇒ crn s ⊆ A $ by fseq_crn [b3]
b5: $ … ⇒ u ∊ A $ by subset_elim [b4, b2]
b6: $ G , x ∊ cdm s , ⟨ x , u ⟩ ∈ s ⇒ fn_into F A B $ by weaken [#2]
c1: $ G , x ∊ cdm s , ⟨ x , u ⟩ ∈ s , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ ⟨ x , u ⟩ ∈ s $ by ax
c2: $ G , x ∊ cdm s , ⟨ x , u ⟩ ∈ s , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ ⟨ u , v ⟩ ∈ F $ by ax
c3: $ … ⇒ ⟨ x , v ⟩ ∈ ccom F s $ by ccom_intro [c1, c2]
c4: $ … ⇒ x ∊ cdm (ccom F s) $ by cdm_intro [c3]
b7: $ … ⇒ x ∊ cdm (ccom F s) $ by fn_into_elim [b6, b5, c4]
b8: $ G , x ∊ cdm s ⇒ x ∊ cdm s $ by ax
b9: $ … ⇒ x ∊ cdm (ccom F s) $ by cdm_elim [b8, b7]
b10: $ … ⇒ cdm (ccom F s) = cdm s $ by eq_intro [a6, b9]

ccom_fseq
---------
l1: $ … ⇒ functional F $ by fn_into_functional [#2]
l2: $ … ⇒ functional s $ by fseq_functional [#1]
l3: $ … ⇒ functional (ccom F s) $ by ccom_functional [l1, l2]
l4: $ G ⇒ rel (ccom F s) $ by ccom_rel
l5: $ … ⇒ cdm (ccom F s) = cdm s $ by s2_ccom_cdm [#1, #2]
l6: $ … ⇒ cdm s = cdm (ccom F s) $ by eq_sym [l5]
l7: $ … ⇒ cdm s ∈ ω $ by fseq_len [#1]
l8: $ … ⇒ cdm (ccom F s) ∈ ω $ by wcel_eq_l [l6, l7]
a1: $ G , y ∊ crn (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s , ⟨ x , u ⟩ ∈ s , ⟨ u , y ⟩ ∈ F ⇒ ⟨ x , u ⟩ ∈ s $ by ax
a2: $ … ⇒ u ∊ crn s $ by crn_intro [a1]
a3: $ G , y ∊ crn (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s , ⟨ x , u ⟩ ∈ s , ⟨ u , y ⟩ ∈ F ⇒ s ∊ fseq A $ by weaken [#1]
a4: $ … ⇒ crn s ⊆ A $ by fseq_crn [a3]
a5: $ … ⇒ u ∊ A $ by subset_elim [a4, a2]
a6: $ G , y ∊ crn (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s , ⟨ x , u ⟩ ∈ s , ⟨ u , y ⟩ ∈ F ⇒ fn_into F A B $ by weaken [#2]
b1: $ G , y ∊ crn (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s , ⟨ x , u ⟩ ∈ s , ⟨ u , y ⟩ ∈ F , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ ⟨ u , y ⟩ ∈ F $ by ax
b2: $ G , y ∊ crn (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s , ⟨ x , u ⟩ ∈ s , ⟨ u , y ⟩ ∈ F , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ ⟨ u , v ⟩ ∈ F $ by ax
b3: $ G , y ∊ crn (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s , ⟨ x , u ⟩ ∈ s , ⟨ u , y ⟩ ∈ F , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ functional F $ by weaken [l1]
b4: $ … ⇒ y = v $ by functional_elim [b3, b1, b2]
b5: $ … ⇒ v = y $ by eq_sym [b4]
b6: $ G , y ∊ crn (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s , ⟨ x , u ⟩ ∈ s , ⟨ u , y ⟩ ∈ F , v ∊ B , ⟨ u , v ⟩ ∈ F ⇒ v ∊ B $ by ax
b7: $ … ⇒ y ∊ B $ by welc_eq_set [b5, b6]
a7: $ … ⇒ y ∊ B $ by fn_into_elim [a6, a5, b7]
a8: $ G , y ∊ crn (ccom F s) , ⟨ x , y ⟩ ∈ ccom F s ⇒ ⟨ x , y ⟩ ∈ ccom F s $ by ax
a9: $ … ⇒ y ∊ B $ by ccom_elim [a8, a7]
a10: $ G , y ∊ crn (ccom F s) ⇒ y ∊ crn (ccom F s) $ by ax
a11: $ … ⇒ y ∊ B $ by crn_elim [a10, a9]
a12: $ … ⇒ crn (ccom F s) ⊆ B $ by subset_intro [a11]
a13: $ … ⇒ ccom F s ∈ fseq B $ by s2_fseq_c [l3, l4, l8, a12]

ccom_len
--------
l1: $ … ⇒ cdm (ccom F s) = cdm s $ by s2_ccom_cdm [#1, #2]

ccom_empty
----------
a1: $ G , z ∊ ccom F ∅ , z = ⟨ x , y ⟩ , ⟨ x , u ⟩ ∈ ∅ , ⟨ u , y ⟩ ∈ F ⇒ ⟨ x , u ⟩ ∈ ∅ $ by ax
a2: $ G , z ∊ ccom F ∅ , z = ⟨ x , y ⟩ , ⟨ x , u ⟩ ∈ ∅ , ⟨ u , y ⟩ ∈ F , v = ⟨ x , u ⟩ , v ∊ ∅ ⇒ v ∊ ∅ $ by ax
a3: $ … ⇒ ⊥ $ by empty_elim [a2]
a4: $ … ⇒ ⊥ $ by wcel_elim [a1, a3]
b1: $ G , z ∊ ccom F ∅ , z = ⟨ x , y ⟩ ⇒ z = ⟨ x , y ⟩ $ by ax
b2: $ G , z ∊ ccom F ∅ , z = ⟨ x , y ⟩ ⇒ z ∊ ccom F ∅ $ by ax
b3: $ … ⇒ ⟨ x , y ⟩ ∈ ccom F ∅ $ by wcel_intro [b1, b2]
b4: $ … ⇒ ⊥ $ by ccom_elim [b3, a4]
c1: $ G , z ∊ ccom F ∅ ⇒ rel (ccom F ∅) $ by ccom_rel
c2: $ G , z ∊ ccom F ∅ ⇒ z ∊ ccom F ∅ $ by ax
c3: $ … ⇒ ⊥ $ by rel_elim [c1, c2, b4]
c4: $ … ⇒ ccom F ∅ = ∅ $ by empty_eq_intro [c3]

ccom_scons
----------
l1: $ … ⇒ isset (F' a) $ by fv_set [#1]
l2: $ G ⇒ rel (ccom F (scons a s)) $ by ccom_rel
l3: $ … ⇒ rel (scons (F' a) (ccom F s)) $ by s2_scons_rel [l1]
a1: $ G , ⟨ x , y ⟩ ∈ ccom F (scons a s) , ⟨ x , u ⟩ ∈ scons a s , ⟨ u , y ⟩ ∈ F ⇒ ⟨ x , u ⟩ ∈ scons a s $ by ax
a2: $ … ⇒ (x = ∅ ∧ u = a) ∨ ∃ j (x = suc j ∧ ⟨ j , u ⟩ ∈ s) $ by scons_pair [a1, isset_var [], isset_var []]
