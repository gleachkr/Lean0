lemma s2_scons_ap_zero (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ ap (scons A S) ∅ = csn A $
----
f1: $ G , y ∊ ap (scons A S) ∅ ⇒ y ∊ ap (scons A S) ∅ $ by ax
f2: $ … ⇒ ⟨ ∅ , y ⟩ ∈ scons A S $ by ap_elim [f1]
f3: $ G , y ∊ ap (scons A S) ∅ ⇒ isset ∅ $ by ax_empty
f4: $ G , y ∊ ap (scons A S) ∅ ⇒ isset A $ by weaken [#1]
f5: $ … ⇒ (∅ = ∅ ∧ y = A) ∨ ∃ i (∅ = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by scons_pair [f2, f3, f4]
g1: $ G , y ∊ ap (scons A S) ∅ , ∅ = ∅ ∧ y = A ⇒ ∅ = ∅ ∧ y = A $ by ax
g2: $ … ⇒ y = A $ by and_elim_r [g1]
g3: $ … ⇒ y ∊ csn A $ by csn_intro [g2]
h1: $ G , y ∊ ap (scons A S) ∅ , ∃ i (∅ = suc i ∧ ⟨ i , y ⟩ ∈ S) ⇒ ∃ i (∅ = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by ax
h2: $ G , y ∊ ap (scons A S) ∅ , ∅ = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ ∅ = suc i ∧ ⟨ i , y ⟩ ∈ S $ by ax
h3: $ … ⇒ ∅ = suc i $ by and_elim_l [h2]
h4: $ … ⇒ suc i = ∅ $ by eq_sym [h3]
h5: $ … ⇒ ⊥ $ by suc_ne_empty [h4]
h6: $ … ⇒ y ∊ csn A $ by bot_elim [h5]
h7: $ … ⇒ y ∊ csn A $ by ex_elim [h1, h6]
f6: $ … ⇒ y ∊ csn A $ by or_elim [f5, g3, h7]
k1: $ G , y ∊ csn A ⇒ y ∊ csn A $ by ax
k2: $ … ⇒ y = A $ by csn_elim [k1]
k3: $ G , y ∊ csn A ⇒ isset A $ by weaken [#1]
k4: $ … ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by s2_scons_zero [k3]
k5: $ G , y ∊ csn A ⇒ ∅ = ∅ $ by eq_refl
k6: $ … ⇒ A = y $ by eq_sym [k2]
k7: $ … ⇒ ⟨ ∅ , A ⟩ = ⟨ ∅ , y ⟩ $ by opair_eq [k5, k6]
k8: $ … ⇒ ⟨ ∅ , y ⟩ ∈ scons A S $ by wcel_eq_l [k7, k4]
k9: $ … ⇒ y ∊ ap (scons A S) ∅ $ by ap_intro [k8]
f7: $ … ⇒ ap (scons A S) ∅ = csn A $ by eq_intro [f6, k9]

scons_fv_zero
-------------
l1: $ G ⇒ isset a $ by isset_var
l2: $ … ⇒ ap (scons a s) ∅ = csn a $ by s2_scons_ap_zero [l1]
l3: $ … ⇒ ⋃ (ap (scons a s) ∅) = ⋃ (csn a) $ by cuni_eq [l2]
l4: $ … ⇒ ⋃ (csn a) = a $ by cuni_csn [l1]
l5: $ … ⇒ (scons a s)' ∅ = a $ by eq_trans [l3, l4]

scons_fv_zero_c
---------------
l1: $ G , a = A , q = S ⇒ (scons a q)' ∅ = a $ by scons_fv_zero
l2: $ G , a = A , q = S ⇒ a = A $ by ax
l3: $ G , a = A , q = S ⇒ q = S $ by ax
l4: $ … ⇒ scons a q = scons A S $ by scons_eq [l2, l3]
l5: $ G , a = A , q = S ⇒ ∅ = ∅ $ by eq_refl
l6: $ … ⇒ (scons a q)' ∅ = (scons A S)' ∅ $ by fv_eq [l4, l5]
l7: $ … ⇒ (scons A S)' ∅ = (scons a q)' ∅ $ by eq_sym [l6]
l8: $ … ⇒ (scons A S)' ∅ = a $ by eq_trans [l7, l1]
l9: $ … ⇒ (scons A S)' ∅ = A $ by eq_trans [l8, l2]
l10: $ … ⇒ (scons A S)' ∅ = A $ by isset_elim [#2, l9]
l11: $ … ⇒ (scons A S)' ∅ = A $ by isset_elim [#1, l10]

scons_fv_suc
------------
m1: $ G , y ∊ ap (scons a s) (suc i) ⇒ y ∊ ap (scons a s) (suc i) $ by ax
m2: $ … ⇒ ⟨ suc i , y ⟩ ∈ scons a s $ by ap_elim [m1]
m3: $ G , y ∊ ap (scons a s) (suc i) ⇒ isset i $ by isset_var
m4: $ … ⇒ isset (suc i) $ by suc_set [m3]
m5: $ G , y ∊ ap (scons a s) (suc i) ⇒ isset a $ by isset_var
m6: $ … ⇒ (suc i = ∅ ∧ y = a) ∨ ∃ j (suc i = suc j ∧ ⟨ j , y ⟩ ∈ s) $ by scons_pair [m2, m4, m5]
n1: $ G , y ∊ ap (scons a s) (suc i) , suc i = ∅ ∧ y = a ⇒ suc i = ∅ ∧ y = a $ by ax
n2: $ … ⇒ suc i = ∅ $ by and_elim_l [n1]
n3: $ … ⇒ ⊥ $ by suc_ne_empty [n2]
n4: $ … ⇒ y ∊ ap s i $ by bot_elim [n3]
p1: $ G , y ∊ ap (scons a s) (suc i) , ∃ j (suc i = suc j ∧ ⟨ j , y ⟩ ∈ s) ⇒ ∃ j (suc i = suc j ∧ ⟨ j , y ⟩ ∈ s) $ by ax
p2: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ suc i = suc j ∧ ⟨ j , y ⟩ ∈ s $ by ax
p3: $ … ⇒ suc i = suc j $ by and_elim_l [p2]
p4: $ … ⇒ i = j $ by suc_inj [p3]
p5: $ … ⇒ ⟨ j , y ⟩ ∈ s $ by and_elim_r [p2]
p6: $ … ⇒ j = i $ by eq_sym [p4]
p7: $ G , y ∊ ap (scons a s) (suc i) , suc i = suc j ∧ ⟨ j , y ⟩ ∈ s ⇒ y = y $ by eq_refl
p8: $ … ⇒ ⟨ j , y ⟩ = ⟨ i , y ⟩ $ by opair_eq [p6, p7]
p9: $ … ⇒ ⟨ i , y ⟩ ∈ s $ by wcel_eq_l [p8, p5]
p10: $ … ⇒ y ∊ ap s i $ by ap_intro [p9]
p11: $ … ⇒ y ∊ ap s i $ by ex_elim [p1, p10]
m7: $ … ⇒ y ∊ ap s i $ by or_elim [m6, n4, p11]
q1: $ G , y ∊ ap s i ⇒ y ∊ ap s i $ by ax
q2: $ … ⇒ ⟨ i , y ⟩ ∈ s $ by ap_elim [q1]
q3: $ … ⇒ ⟨ suc i , y ⟩ ∈ scons a s $ by s2_scons_suc [q2]
q4: $ … ⇒ y ∊ ap (scons a s) (suc i) $ by ap_intro [q3]
r1: $ … ⇒ ap (scons a s) (suc i) = ap s i $ by eq_intro [m7, q4]
r2: $ … ⇒ (scons a s)' (suc i) = s' i $ by cuni_eq [r1]

scons_fv_suc_c
--------------
l1: $ G , a = A , v = S , i = I ⇒ (scons a v)' (suc i) = v' i $ by scons_fv_suc
l2: $ G , a = A , v = S , i = I ⇒ a = A $ by ax
l3: $ G , a = A , v = S , i = I ⇒ v = S $ by ax
l4: $ G , a = A , v = S , i = I ⇒ i = I $ by ax
l5: $ … ⇒ scons a v = scons A S $ by scons_eq [l2, l3]
l6: $ … ⇒ scons A S = scons a v $ by eq_sym [l5]
l7: $ … ⇒ suc i = suc I $ by suc_eq [l4]
l8: $ … ⇒ suc I = suc i $ by eq_sym [l7]
l9: $ … ⇒ (scons A S)' (suc I) = (scons a v)' (suc i) $ by fv_eq [l6, l8]
l10: $ … ⇒ v' i = S' I $ by fv_eq [l3, l4]
l11: $ … ⇒ (scons A S)' (suc I) = v' i $ by eq_trans [l9, l1]
l12: $ … ⇒ (scons A S)' (suc I) = S' I $ by eq_trans [l11, l10]
l13: $ … ⇒ (scons A S)' (suc I) = S' I $ by isset_elim [#3, l12]
l14: $ … ⇒ (scons A S)' (suc I) = S' I $ by isset_elim [#2, l13]
l15: $ … ⇒ (scons A S)' (suc I) = S' I $ by isset_elim [#1, l14]

scons_fv_sub
------------
q0: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z ⇒ z ∊ ap (scons x a) i $ by ax
q1: $ … ⇒ ⟨ i , z ⟩ ∈ scons x a $ by cab_elim [q0]
q2a: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z ⇒ isset i $ by isset_var
q2b: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z ⇒ isset x $ by isset_var
q3: $ … ⇒ (i = ∅ ∧ z = x) ∨ ∃ j (i = suc j ∧ ⟨ j , z ⟩ ∈ a) $ by scons_pair [q1, q2a, q2b]
r0: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ i = ∅ ∧ z = x $ by ax
r1: $ … ⇒ i = ∅ $ by and_elim_l [r0]
r2: $ … ⇒ z = x $ by and_elim_r [r0]
r2b: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ y ∊ z $ by ax
r3: $ … ⇒ y ∊ x $ by welc_eq [r2, r2b]
r4: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ (scons x b)' ∅ = x $ by scons_fv_zero
r5: $ … ⇒ x = (scons x b)' ∅ $ by eq_sym [r4]
r6a: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ scons x b = scons x b $ by eq_refl
r6: $ … ⇒ (scons x b)' i = (scons x b)' ∅ $ by fv_eq [r6a, r1]
r7: $ … ⇒ (scons x b)' ∅ = (scons x b)' i $ by eq_sym [r6]
r8: $ … ⇒ x = (scons x b)' i $ by eq_trans [r5, r7]
r9: $ … ⇒ y ∊ (scons x b)' i $ by welc_eq [r8, r3]
s0: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ i = suc j ∧ ⟨ j , z ⟩ ∈ a $ by ax
s1: $ … ⇒ i = suc j $ by and_elim_l [s0]
s2: $ … ⇒ ⟨ j , z ⟩ ∈ a $ by and_elim_r [s0]
s3: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ z ∊ ap a j $ by cab_intro [s2]
s3b: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ y ∊ z $ by ax
s4: $ … ⇒ y ∊ a' j $ by cuni_intro [s3b, s3]
s5: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ ∀ i (a' i ⊆ b' i) $ by weaken [#1]
s6: $ … ⇒ a' j ⊆ b' j $ by all_elim [s5]
s7: $ … ⇒ y ∊ b' j $ by subset_elim [s6, s4]
s8: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ (scons x b)' (suc j) = b' j $ by scons_fv_suc
s9a: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ scons x b = scons x b $ by eq_refl
s9: $ … ⇒ (scons x b)' i = (scons x b)' (suc j) $ by fv_eq [s9a, s1]
s10: $ … ⇒ (scons x b)' i = b' j $ by eq_trans [s9, s8]
s11: $ … ⇒ b' j = (scons x b)' i $ by eq_sym [s10]
s12: $ … ⇒ y ∊ (scons x b)' i $ by welc_eq [s11, s7]
s13: $ G , y ∊ (scons x a)' i , z ∊ ap (scons x a) i , y ∊ z , ∃ j (i = suc j ∧ ⟨ j , z ⟩ ∈ a) ⇒ ∃ j (i = suc j ∧ ⟨ j , z ⟩ ∈ a) $ by ax
s14: $ … ⇒ y ∊ (scons x b)' i $ by ex_elim [s13, s12]
t1: $ … ⇒ y ∊ (scons x b)' i $ by or_elim [q3, r9, s14]
t2: $ G , y ∊ (scons x a)' i ⇒ y ∊ (scons x a)' i $ by ax
t3: $ … ⇒ y ∊ (scons x b)' i $ by cuni_elim [t2, t1]
t4: $ … ⇒ (scons x a)' i ⊆ (scons x b)' i $ by subset_intro [t3]
t5: $ … ⇒ ∀ i ((scons x a)' i ⊆ (scons x b)' i) $ by all_intro [t4]

lemma s2_scons_inj_half (G: hyps) (a b s t x y: set):
  $ G ⇒ scons a s = scons b t $ > $ G ⇒ ⟨ x , y ⟩ ∈ s $ > $ G ⇒ ⟨ x , y ⟩ ∈ t $
----
l1: $ … ⇒ ⟨ suc x , y ⟩ ∈ scons a s $ by s2_scons_suc [#2]
l2: $ … ⇒ ⟨ suc x , y ⟩ ∈ scons b t $ by wcel_eq_r [#1, l1]
l3: $ G ⇒ isset x $ by isset_var
l4: $ … ⇒ isset (suc x) $ by suc_set [l3]
l5: $ G ⇒ isset b $ by isset_var
l6: $ … ⇒ (suc x = ∅ ∧ y = b) ∨ ∃ j (suc x = suc j ∧ ⟨ j , y ⟩ ∈ t) $ by scons_pair [l2, l4, l5]
n1: $ G , suc x = ∅ ∧ y = b ⇒ suc x = ∅ ∧ y = b $ by ax
n2: $ … ⇒ suc x = ∅ $ by and_elim_l [n1]
n3: $ … ⇒ ⊥ $ by suc_ne_empty [n2]
n4: $ … ⇒ ⟨ x , y ⟩ ∈ t $ by bot_elim [n3]
p1: $ G , ∃ j (suc x = suc j ∧ ⟨ j , y ⟩ ∈ t) ⇒ ∃ j (suc x = suc j ∧ ⟨ j , y ⟩ ∈ t) $ by ax
p2: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ suc x = suc j ∧ ⟨ j , y ⟩ ∈ t $ by ax
p3: $ … ⇒ suc x = suc j $ by and_elim_l [p2]
p4: $ … ⇒ x = j $ by suc_inj [p3]
p5: $ … ⇒ j = x $ by eq_sym [p4]
p6: $ G , suc x = suc j ∧ ⟨ j , y ⟩ ∈ t ⇒ y = y $ by eq_refl
p7: $ … ⇒ ⟨ j , y ⟩ = ⟨ x , y ⟩ $ by opair_eq [p5, p6]
p8: $ … ⇒ ⟨ j , y ⟩ ∈ t $ by and_elim_r [p2]
p9: $ … ⇒ ⟨ x , y ⟩ ∈ t $ by wcel_eq_l [p7, p8]
p10: $ … ⇒ ⟨ x , y ⟩ ∈ t $ by ex_elim [p1, p9]
l7: $ … ⇒ ⟨ x , y ⟩ ∈ t $ by or_elim [l6, n4, p10]

scons_inj
---------
l1: $ G ⇒ isset a $ by isset_var
l2: $ … ⇒ ⟨ ∅ , a ⟩ ∈ scons a s $ by s2_scons_zero [l1]
l3: $ … ⇒ ⟨ ∅ , a ⟩ ∈ scons b t $ by wcel_eq_r [#3, l2]
l4: $ G ⇒ isset ∅ $ by ax_empty
l5: $ G ⇒ isset b $ by isset_var
l6: $ … ⇒ (∅ = ∅ ∧ a = b) ∨ ∃ j (∅ = suc j ∧ ⟨ j , a ⟩ ∈ t) $ by scons_pair [l3, l4, l5]
n1: $ G , ∅ = ∅ ∧ a = b ⇒ ∅ = ∅ ∧ a = b $ by ax
n2: $ … ⇒ a = b $ by and_elim_r [n1]
p1: $ G , ∃ j (∅ = suc j ∧ ⟨ j , a ⟩ ∈ t) ⇒ ∃ j (∅ = suc j ∧ ⟨ j , a ⟩ ∈ t) $ by ax
p2: $ G , ∅ = suc j ∧ ⟨ j , a ⟩ ∈ t ⇒ ∅ = suc j ∧ ⟨ j , a ⟩ ∈ t $ by ax
p3: $ … ⇒ ∅ = suc j $ by and_elim_l [p2]
p4: $ … ⇒ suc j = ∅ $ by eq_sym [p3]
p5: $ … ⇒ ⊥ $ by suc_ne_empty [p4]
p6: $ … ⇒ a = b $ by bot_elim [p5]
p7: $ … ⇒ a = b $ by ex_elim [p1, p6]
l7: $ … ⇒ a = b $ by or_elim [l6, n2, p7]
q1: $ G , ⟨ x , y ⟩ ∈ s ⇒ scons a s = scons b t $ by weaken [#3]
q2: $ G , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
q3: $ … ⇒ ⟨ x , y ⟩ ∈ t $ by s2_scons_inj_half [q1, q2]
q4: $ … ⇒ scons b t = scons a s $ by eq_sym [#3]
q5: $ G , ⟨ x , y ⟩ ∈ t ⇒ scons b t = scons a s $ by weaken [q4]
q6: $ G , ⟨ x , y ⟩ ∈ t ⇒ ⟨ x , y ⟩ ∈ t $ by ax
q7: $ … ⇒ ⟨ x , y ⟩ ∈ s $ by s2_scons_inj_half [q5, q6]
q8: $ … ⇒ s = t $ by rel_eq_intro [#1, #2, q3, q7]
q9: $ … ⇒ a = b ∧ s = t $ by and_intro [l7, q8]

scons2_inj
----------
l0: $ G ⇒ isset ∅ $ by ax_empty
l1: $ … ⇒ isset (scons B ∅) $ by scons_set [l0]
l2: $ … ⇒ isset (scons B2 ∅) $ by scons_set [l0]
l3r: $ G ⇒ ∅ = ∅ $ by eq_refl
l3: $ … ⇒ (scons A (scons B ∅))' ∅ = (scons A2 (scons B2 ∅))' ∅ $ by fv_eq [#5, l3r]
l4: $ … ⇒ (scons A (scons B ∅))' ∅ = A $ by scons_fv_zero_c [#1, l1]
l5: $ … ⇒ (scons A2 (scons B2 ∅))' ∅ = A2 $ by scons_fv_zero_c [#2, l2]
l6a: $ … ⇒ A = (scons A (scons B ∅))' ∅ $ by eq_sym [l4]
l6b: $ … ⇒ A = (scons A2 (scons B2 ∅))' ∅ $ by eq_trans [l6a, l3]
l6: $ … ⇒ A = A2 $ by eq_trans [l6b, l5]
k0: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
k1: $ … ⇒ (scons A (scons B ∅))' (suc ∅) = (scons A2 (scons B2 ∅))' (suc ∅) $ by fv_eq [#5, k0]
k2: $ … ⇒ (scons A (scons B ∅))' (suc ∅) = (scons B ∅)' ∅ $ by scons_fv_suc_c [#1, l1, l0]
k3: $ … ⇒ (scons A2 (scons B2 ∅))' (suc ∅) = (scons B2 ∅)' ∅ $ by scons_fv_suc_c [#2, l2, l0]
k4: $ … ⇒ (scons B ∅)' ∅ = B $ by scons_fv_zero_c [#3, l0]
k5: $ … ⇒ (scons B2 ∅)' ∅ = B2 $ by scons_fv_zero_c [#4, l0]
k6a: $ … ⇒ (scons B ∅)' ∅ = (scons A (scons B ∅))' (suc ∅) $ by eq_sym [k2]
k6b: $ … ⇒ B = (scons B ∅)' ∅ $ by eq_sym [k4]
k6c: $ … ⇒ B = (scons A (scons B ∅))' (suc ∅) $ by eq_trans [k6b, k6a]
k6d: $ … ⇒ B = (scons A2 (scons B2 ∅))' (suc ∅) $ by eq_trans [k6c, k1]
k6e: $ … ⇒ B = (scons B2 ∅)' ∅ $ by eq_trans [k6d, k3]
k6: $ … ⇒ B = B2 $ by eq_trans [k6e, k5]
k7: $ … ⇒ A = A2 ∧ B = B2 $ by and_intro [l6, k6]

scons_ne_empty
--------------
l1: $ G ⇒ isset a $ by isset_var
l2: $ … ⇒ ⟨ ∅ , a ⟩ ∈ scons a s $ by s2_scons_zero [l1]
l3: $ … ⇒ ⟨ ∅ , a ⟩ ∈ ∅ $ by wcel_eq_r [#1, l2]
l4: $ G , z = ⟨ ∅ , a ⟩ , z ∊ ∅ ⇒ z ∊ ∅ $ by ax
l5: $ … ⇒ ⊥ $ by empty_elim [l4]
l6: $ … ⇒ ⊥ $ by wcel_elim [l3, l5]

scons_fseq_hd
-------------
l1: $ … ⇒ crn (scons x S) ⊆ A $ by fseq_crn_c [#1]
l2: $ G ⇒ isset x $ by isset_var
l3: $ … ⇒ ⟨ ∅ , x ⟩ ∈ scons x S $ by s2_scons_zero [l2]
l4: $ G ⇒ isset ∅ $ by ax_empty
m1: $ G , b = ∅ ⇒ b = ∅ $ by ax
m2: $ … ⇒ ∅ = b $ by eq_sym [m1]
m3: $ G , b = ∅ ⇒ x = x $ by eq_refl
m4: $ … ⇒ ⟨ ∅ , x ⟩ = ⟨ b , x ⟩ $ by opair_eq [m2, m3]
m5: $ G , b = ∅ ⇒ ⟨ ∅ , x ⟩ ∈ scons x S $ by weaken [l3]
m6: $ … ⇒ ⟨ b , x ⟩ ∈ scons x S $ by wcel_eq_l [m4, m5]
m7: $ … ⇒ x ∊ crn (scons x S) $ by crn_intro [m6]
m8: $ G , b = ∅ ⇒ crn (scons x S) ⊆ A $ by weaken [l1]
m9: $ … ⇒ x ∊ A $ by subset_elim [m8, m7]
m10: $ … ⇒ x ∊ A $ by isset_elim [l4, m9]

crn_empty
---------
l1: $ G , y ∊ crn ∅ ⇒ y ∊ crn ∅ $ by ax
l2: $ G , ⟨ x , y ⟩ ∈ ∅ ⇒ ⟨ x , y ⟩ ∈ ∅ $ by ax
l3: $ G , ⟨ x , y ⟩ ∈ ∅ , w = ⟨ x , y ⟩ , w ∊ ∅ ⇒ w ∊ ∅ $ by ax
l4: $ … ⇒ ⊥ $ by empty_elim [l3]
l5: $ … ⇒ ⊥ $ by wcel_elim [l2, l4]
l6: $ … ⇒ ⊥ $ by crn_elim [l1, l5]
l7: $ … ⇒ crn ∅ = ∅ $ by empty_eq_intro [l6]

crn_empty_sub
-------------
l1: $ G ⇒ crn ∅ = ∅ $ by crn_empty
l2: $ … ⇒ ∅ = crn ∅ $ by eq_sym [l1]
l3: $ G ⇒ ∅ ⊆ X $ by empty_subset
l4: $ … ⇒ crn ∅ ⊆ X $ by subset_eq_l [l2, l3]

crn_scons_sub
-------------
l1: $ G , y ∊ crn (scons A S) ⇒ y ∊ crn (scons A S) $ by ax
m1: $ G , ⟨ x , y ⟩ ∈ scons A S ⇒ ⟨ x , y ⟩ ∈ scons A S $ by ax
m2: $ G , ⟨ x , y ⟩ ∈ scons A S ⇒ isset x $ by isset_var
m3a: $ G , ⟨ x , y ⟩ ∈ scons A S ⇒ A ∈ X $ by weaken [#1]
m3: $ … ⇒ isset A $ by wcel_isset [m3a]
m4: $ … ⇒ (x = ∅ ∧ y = A) ∨ ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by scons_pair [m1, m2, m3]
a1: $ G , ⟨ x , y ⟩ ∈ scons A S , x = ∅ ∧ y = A ⇒ x = ∅ ∧ y = A $ by ax
a2: $ … ⇒ y = A $ by and_elim_r [a1]
a3: $ … ⇒ A = y $ by eq_sym [a2]
a4: $ G , ⟨ x , y ⟩ ∈ scons A S , x = ∅ ∧ y = A ⇒ A ∈ X $ by weaken [#1]
a5: $ … ⇒ y ∈ X $ by wcel_eq_l [a3, a4]
a6: $ … ⇒ y ∊ X $ by wcel_welc [a5]
b1: $ G , ⟨ x , y ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ x = suc i ∧ ⟨ i , y ⟩ ∈ S $ by ax
b2: $ … ⇒ ⟨ i , y ⟩ ∈ S $ by and_elim_r [b1]
b3: $ … ⇒ y ∊ crn S $ by crn_intro [b2]
b4: $ G , ⟨ x , y ⟩ ∈ scons A S , x = suc i ∧ ⟨ i , y ⟩ ∈ S ⇒ crn S ⊆ X $ by weaken [#2]
b5: $ … ⇒ y ∊ X $ by subset_elim [b4, b3]
b6: $ G , ⟨ x , y ⟩ ∈ scons A S , ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) ⇒ ∃ i (x = suc i ∧ ⟨ i , y ⟩ ∈ S) $ by ax
b7: $ … ⇒ y ∊ X $ by ex_elim [b6, b5]
m5: $ … ⇒ y ∊ X $ by or_elim [m4, a6, b7]
l2: $ … ⇒ y ∊ X $ by crn_elim [l1, m5]
l3: $ … ⇒ crn (scons A S) ⊆ X $ by subset_intro [l2]

crn_scons_head
--------------
l1: $ G ⇒ isset ⟨ ∅ , A ⟩ $ by opair_isset
l2: $ G , w = ⟨ ∅ , A ⟩ ⇒ w = ⟨ ∅ , A ⟩ $ by ax
l3: $ … ⇒ w ∊ csn ⟨ ∅ , A ⟩ $ by csn_intro [l2]
l4: $ … ⇒ w ∊ scons A S $ by cun_intro_l [l3]
l5: $ … ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by wcel_intro [l2, l4]
l6: $ … ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by isset_elim [l1, l5]
l7: $ G ⇒ isset ∅ $ by ax_empty
m1: $ G , b = ∅ , a = A ⇒ b = ∅ $ by ax
m2: $ G , b = ∅ , a = A ⇒ a = A $ by ax
m3: $ … ⇒ ∅ = b $ by eq_sym [m1]
m4: $ … ⇒ A = a $ by eq_sym [m2]
m5: $ … ⇒ ⟨ ∅ , A ⟩ = ⟨ b , a ⟩ $ by opair_eq [m3, m4]
m6: $ G , b = ∅ , a = A ⇒ ⟨ ∅ , A ⟩ ∈ scons A S $ by weaken [l6]
m7: $ … ⇒ ⟨ b , a ⟩ ∈ scons A S $ by wcel_eq_l [m5, m6]
m8: $ … ⇒ a ∊ crn (scons A S) $ by crn_intro [m7]
m9: $ G , b = ∅ , a = A ⇒ crn (scons A S) ⊆ X $ by weaken [#2]
m10: $ … ⇒ a ∊ X $ by subset_elim [m9, m8]
m11: $ … ⇒ A ∈ X $ by wcel_intro [m2, m10]
m12: $ … ⇒ A ∈ X $ by isset_elim [#1, m11]
m13: $ … ⇒ A ∈ X $ by isset_elim [l7, m12]

crn_scons_tail
--------------
l1: $ G , y ∊ crn S ⇒ y ∊ crn S $ by ax
m1: $ G , ⟨ x , y ⟩ ∈ S ⇒ isset ⟨ suc x , y ⟩ $ by opair_isset
w1: $ G , ⟨ x , y ⟩ ∈ S , w = ⟨ suc x , y ⟩ ⇒ w = ⟨ suc x , y ⟩ $ by ax
w2: $ G , ⟨ x , y ⟩ ∈ S , w = ⟨ suc x , y ⟩ ⇒ ⟨ x , y ⟩ ∈ S $ by ax
w3: $ … ⇒ w = ⟨ suc x , y ⟩ ∧ ⟨ x , y ⟩ ∈ S $ by and_intro [w1, w2]
w4: $ … ⇒ ∃ v (w = ⟨ suc x , v ⟩ ∧ ⟨ x , v ⟩ ∈ S) $ by ex_intro [w3]
w5: $ … ⇒ ∃ i ∃ v (w = ⟨ suc i , v ⟩ ∧ ⟨ i , v ⟩ ∈ S) $ by ex_intro [w4]
w6: $ … ⇒ w ∊ {z | ∃ i ∃ v (z = ⟨ suc i , v ⟩ ∧ ⟨ i , v ⟩ ∈ S)} $ by cab_intro [w5]
w7: $ … ⇒ w ∊ scons A S $ by cun_intro_r [w6]
w8: $ … ⇒ ⟨ suc x , y ⟩ ∈ scons A S $ by wcel_intro [w1, w7]
m2: $ … ⇒ ⟨ suc x , y ⟩ ∈ scons A S $ by isset_elim [m1, w8]
m3a: $ G , ⟨ x , y ⟩ ∈ S ⇒ isset x $ by isset_var
m3: $ … ⇒ isset (suc x) $ by suc_set [m3a]
j1: $ G , ⟨ x , y ⟩ ∈ S , j = suc x ⇒ j = suc x $ by ax
j2: $ … ⇒ suc x = j $ by eq_sym [j1]
j3: $ G , ⟨ x , y ⟩ ∈ S , j = suc x ⇒ cv y = cv y $ by eq_refl
j4: $ … ⇒ ⟨ suc x , y ⟩ = ⟨ j , y ⟩ $ by opair_eq [j2, j3]
j5: $ G , ⟨ x , y ⟩ ∈ S , j = suc x ⇒ ⟨ suc x , y ⟩ ∈ scons A S $ by weaken [m2]
j6: $ … ⇒ ⟨ j , y ⟩ ∈ scons A S $ by wcel_eq_l [j4, j5]
j7: $ … ⇒ y ∊ crn (scons A S) $ by crn_intro [j6]
j8: $ G , ⟨ x , y ⟩ ∈ S , j = suc x ⇒ crn (scons A S) ⊆ X $ by weaken [#1]
j9: $ … ⇒ y ∊ X $ by subset_elim [j8, j7]
m4: $ … ⇒ y ∊ X $ by isset_elim [m3, j9]
l2: $ … ⇒ y ∊ X $ by crn_elim [l1, m4]
l3: $ … ⇒ crn S ⊆ X $ by subset_intro [l2]

def s2_shd (S: class) (.i .y .z: set): class = $ {z | ∃ i ∃ y (z = ⟨ i , y ⟩ ∧ ⟨ suc i , y ⟩ ∈ S)} $

lemma s2_functional_elim_c (G: hyps) (F A: class) (b c: set):
  $ G ⇒ functional F $ > $ G ⇒ ⟨ A , b ⟩ ∈ F $ > $ G ⇒ ⟨ A , c ⟩ ∈ F $ > $ G ⇒ isset A $ > $ G ⇒ b = c $
----
l1: $ G , u = A ⇒ u = A $ by ax
l2: $ … ⇒ A = u $ by eq_sym [l1]
l3: $ G , u = A ⇒ b = b $ by eq_refl
l4: $ G , u = A ⇒ c = c $ by eq_refl
l5: $ … ⇒ ⟨ A , b ⟩ = ⟨ u , b ⟩ $ by opair_eq [l2, l3]
l6: $ … ⇒ ⟨ A , c ⟩ = ⟨ u , c ⟩ $ by opair_eq [l2, l4]
l7: $ G , u = A ⇒ ⟨ A , b ⟩ ∈ F $ by weaken [#2]
l8: $ G , u = A ⇒ ⟨ A , c ⟩ ∈ F $ by weaken [#3]
l9: $ … ⇒ ⟨ u , b ⟩ ∈ F $ by wcel_eq_l [l5, l7]
l10: $ … ⇒ ⟨ u , c ⟩ ∈ F $ by wcel_eq_l [l6, l8]
l11: $ G , u = A ⇒ functional F $ by weaken [#1]
l12: $ … ⇒ b = c $ by functional_elim [l11, l9, l10]
l13: $ … ⇒ b = c $ by isset_elim [#4, l12]

lemma s2_shd_intro (G: hyps) (S: class) (i y: set):
  $ G ⇒ ⟨ suc i , y ⟩ ∈ S $ > $ G ⇒ ⟨ i , y ⟩ ∈ s2_shd S $
----
l1: $ G ⇒ isset i $ by isset_var
l2: $ G ⇒ isset y $ by isset_var
l3: $ … ⇒ isset ⟨ i , y ⟩ $ by opair_set [l1, l2]
l4: $ G , z = ⟨ i , y ⟩ ⇒ z = ⟨ i , y ⟩ $ by ax
l5: $ G , z = ⟨ i , y ⟩ ⇒ ⟨ suc i , y ⟩ ∈ S $ by weaken [#1]
l6: $ … ⇒ z = ⟨ i , y ⟩ ∧ ⟨ suc i , y ⟩ ∈ S $ by and_intro [l4, l5]
l7: $ … ⇒ ∃ k (z = ⟨ i , k ⟩ ∧ ⟨ suc i , k ⟩ ∈ S) $ by ex_intro [l6]
l8: $ … ⇒ ∃ j ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by ex_intro [l7]
l9: $ … ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S)} $ by cab_intro [l8]
l10: $ … ⇒ ⟨ i , y ⟩ ∈ s2_shd S $ by wcel_intro [l4, l9]
l11: $ … ⇒ ⟨ i , y ⟩ ∈ s2_shd S $ by isset_elim [l3, l10]

lemma s2_shd_elim (G: hyps) (S: class) (x y: set):
  $ G ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ > $ G ⇒ ⟨ suc x , y ⟩ ∈ S $
----
l1: $ G , z = ⟨ x , y ⟩ , z ∊ s2_shd S ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S)} $ by ax
l2: $ … ⇒ ∃ j ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by cab_elim [l1]
c1: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S $ by ax
c2: $ … ⇒ z = ⟨ j , k ⟩ $ by and_elim_l [c1]
c3: $ … ⇒ ⟨ suc j , k ⟩ ∈ S $ by and_elim_r [c1]
c4: $ G , z = ⟨ x , y ⟩ , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ z = ⟨ x , y ⟩ $ by ax
c5: $ … ⇒ ⟨ x , y ⟩ = z $ by eq_sym [c4]
c6: $ … ⇒ ⟨ x , y ⟩ = ⟨ j , k ⟩ $ by eq_trans [c5, c2]
c7: $ … ⇒ x = j $ by opair_inj_l [c6]
c8: $ … ⇒ y = k $ by opair_inj_r [c6]
c9: $ … ⇒ j = x $ by eq_sym [c7]
c10: $ … ⇒ k = y $ by eq_sym [c8]
c11: $ … ⇒ suc j = suc x $ by suc_eq [c9]
c12: $ … ⇒ ⟨ suc j , k ⟩ = ⟨ suc x , y ⟩ $ by opair_eq [c11, c10]
c13: $ … ⇒ ⟨ suc x , y ⟩ ∈ S $ by wcel_eq_l [c12, c3]
d1: $ G , z = ⟨ x , y ⟩ , ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) ⇒ ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by ax
d2: $ … ⇒ ⟨ suc x , y ⟩ ∈ S $ by ex_elim [d1, c13]
d3: $ … ⇒ ⟨ suc x , y ⟩ ∈ S $ by ex_elim [l2, d2]
d4: $ … ⇒ ⟨ suc x , y ⟩ ∈ S $ by wcel_elim [#1, d3]

lemma s2_shd_rel (G: hyps) (S: class): $ G ⇒ rel (s2_shd S) $
----
l1: $ G , z ∊ s2_shd S ⇒ z ∊ {w | ∃ j ∃ k (w = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S)} $ by ax
l2: $ … ⇒ ∃ j ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by cab_elim [l1]
c1: $ G , z ∊ s2_shd S , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S $ by ax
c2: $ … ⇒ z = ⟨ j , k ⟩ $ by and_elim_l [c1]
c3: $ G , z ∊ s2_shd S , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ isset j $ by isset_var
c5: $ G , z ∊ s2_shd S , z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S ⇒ isset k $ by isset_var
c6: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by s2_opair_ex [c2, c3, c5]
d1: $ G , z ∊ s2_shd S , ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) ⇒ ∃ k (z = ⟨ j , k ⟩ ∧ ⟨ suc j , k ⟩ ∈ S) $ by ax
d2: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [d1, c6]
d3: $ … ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩) $ by ex_elim [l2, d2]
e2: $ … ⇒ rel (s2_shd S) $ by rel_intro [d3]

lemma s2_shd_functional (G: hyps) (S: class): $ G ⇒ functional S $ > $ G ⇒ functional (s2_shd S) $
----
l1: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ by ax
l2: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ ⟨ x , z ⟩ ∈ s2_shd S $ by ax
l3: $ … ⇒ ⟨ suc x , y ⟩ ∈ S $ by s2_shd_elim [l1]
l4: $ … ⇒ ⟨ suc x , z ⟩ ∈ S $ by s2_shd_elim [l2]
l5: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ functional S $ by weaken [#1]
l6: $ G , ⟨ x , y ⟩ ∈ s2_shd S , ⟨ x , z ⟩ ∈ s2_shd S ⇒ isset x $ by isset_var
l7: $ … ⇒ isset (suc x) $ by suc_set [l6]
l8: $ … ⇒ y = z $ by s2_functional_elim_c [l5, l3, l4, l7]
l9: $ … ⇒ functional (s2_shd S) $ by functional_intro [l8]

lemma s2_shd_cdm (G: hyps) (S: class) (m: set):
  $ G ⇒ m ∊ ω $ > $ G ⇒ cdm S = suc m $ > $ G ⇒ cdm (s2_shd S) = m $
----
a1: $ G , x ∊ cdm (s2_shd S) ⇒ x ∊ cdm (s2_shd S) $ by ax
a2: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ by ax
a3: $ … ⇒ ⟨ suc x , y ⟩ ∈ S $ by s2_shd_elim [a2]
a4: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset x $ by isset_var
a5: $ … ⇒ isset (suc x) $ by suc_set [a4]
a6: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset y $ by isset_var
a7: $ … ⇒ suc x ∈ cdm S $ by s2_cdm_intro_c [a3, a5, a6]
a8: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ cdm S = suc m $ by weaken [#2]
a9: $ … ⇒ suc x ∈ suc m $ by wcel_eq_r [a8, a7]
a10: $ G , x ∊ cdm (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ m ∊ ω $ by weaken [#1]
a11: $ … ⇒ ord m $ by ord_omega_elem [a10]
a12: $ … ⇒ x ∊ m $ by ord_suc_elem_suc_elim [a11, a9]
a13: $ … ⇒ x ∊ m $ by cdm_elim [a1, a12]
b1: $ G , x ∊ m ⇒ x ∊ m $ by ax
b2: $ G , x ∊ m ⇒ m ∊ ω $ by weaken [#1]
b3: $ … ⇒ ord m $ by ord_omega_elem [b2]
b4: $ … ⇒ suc x ∈ suc m $ by ord_suc_elem_suc [b3, b1]
b5: $ G , x ∊ m ⇒ cdm S = suc m $ by weaken [#2]
b6: $ … ⇒ suc m = cdm S $ by eq_sym [b5]
b7: $ … ⇒ suc x ∈ cdm S $ by wcel_eq_r [b6, b4]
c1: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ ⟨ u , y ⟩ ∈ S $ by ax
c2: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ u = suc x $ by ax
c3: $ G , x ∊ m , u = suc x , u ∊ cdm S , ⟨ u , y ⟩ ∈ S ⇒ y = y $ by eq_refl
c4: $ … ⇒ ⟨ u , y ⟩ = ⟨ suc x , y ⟩ $ by opair_eq [c2, c3]
c5: $ … ⇒ ⟨ suc x , y ⟩ ∈ S $ by wcel_eq_l [c4, c1]
c6: $ … ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ by s2_shd_intro [c5]
c7: $ … ⇒ x ∊ cdm (s2_shd S) $ by cdm_intro [c6]
c8: $ G , x ∊ m , u = suc x , u ∊ cdm S ⇒ u ∊ cdm S $ by ax
c9: $ … ⇒ x ∊ cdm (s2_shd S) $ by cdm_elim [c8, c7]
c10: $ … ⇒ x ∊ cdm (s2_shd S) $ by wcel_elim [b7, c9]
c11: $ … ⇒ cdm (s2_shd S) = m $ by eq_intro [a13, c10]

lemma s2_shd_crn (G: hyps) (S: class): $ G ⇒ crn (s2_shd S) ⊆ crn S $
----
l1: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ ⟨ x , y ⟩ ∈ s2_shd S $ by ax
l2: $ … ⇒ ⟨ suc x , y ⟩ ∈ S $ by s2_shd_elim [l1]
l3: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset x $ by isset_var
l4: $ … ⇒ isset (suc x) $ by suc_set [l3]
l5: $ G , y ∊ crn (s2_shd S) , ⟨ x , y ⟩ ∈ s2_shd S ⇒ isset y $ by isset_var
l6: $ … ⇒ y ∈ crn S $ by s2_crn_intro_c [l2, l4, l5]
l7: $ … ⇒ y ∊ crn S $ by wcel_welc [l6]
l8: $ G , y ∊ crn (s2_shd S) ⇒ y ∊ crn (s2_shd S) $ by ax
l9: $ … ⇒ y ∊ crn S $ by crn_elim [l8, l7]
l10: $ … ⇒ crn (s2_shd S) ⊆ crn S $ by subset_intro [l9]

lemma s2_cases_eq (G: hyps) (s c m: set):
  $ G ⇒ rel s $ > $ G ⇒ functional s $ > $ G ⇒ m ∊ ω $ > $ G ⇒ cdm s = suc m $ >
  $ G ⇒ ⟨ ∅ , c ⟩ ∈ s $ > $ G ⇒ s = scons c (s2_shd s) $
----
l1: $ G ⇒ isset c $ by isset_var
l2: $ … ⇒ rel (scons c (s2_shd s)) $ by s2_scons_rel [l1]
a1: $ G , ⟨ x , y ⟩ ∈ s ⇒ ⟨ x , y ⟩ ∈ s $ by ax
a2: $ … ⇒ x ∊ cdm s $ by cdm_intro [a1]
a3: $ G , ⟨ x , y ⟩ ∈ s ⇒ cdm s = suc m $ by weaken [#4]
a4: $ … ⇒ x ∊ suc m $ by welc_eq [a3, a2]
a5: $ G , ⟨ x , y ⟩ ∈ s ⇒ m ∊ ω $ by weaken [#3]
a6: $ … ⇒ x ∊ ω $ by omega_suc_elem_omega [a5, a4]
a7: $ … ⇒ x = ∅ ∨ ∃ j (j ∊ ω ∧ x = suc j) $ by omega_cases [a6]
p1: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ x = ∅ $ by ax
p2: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ y = y $ by eq_refl
p3: $ … ⇒ ⟨ x , y ⟩ = ⟨ ∅ , y ⟩ $ by opair_eq [p1, p2]
p4: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ x , y ⟩ ∈ s $ by ax
p5: $ … ⇒ ⟨ ∅ , y ⟩ ∈ s $ by wcel_eq_l [p3, p4]
p6: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ ⟨ ∅ , c ⟩ ∈ s $ by weaken [#5]
p7: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ functional s $ by weaken [#2]
p8: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ isset ∅ $ by ax_empty
p9: $ … ⇒ c = y $ by s2_functional_elim_c [p7, p6, p5, p8]
p10: $ G , ⟨ x , y ⟩ ∈ s , x = ∅ ⇒ isset c $ by isset_var
p11: $ … ⇒ ⟨ ∅ , c ⟩ ∈ scons c (s2_shd s) $ by s2_scons_zero [p10]
p12: $ … ⇒ ∅ = x $ by eq_sym [p1]
p13: $ … ⇒ ⟨ ∅ , c ⟩ = ⟨ x , y ⟩ $ by opair_eq [p12, p9]
p14: $ … ⇒ ⟨ x , y ⟩ ∈ scons c (s2_shd s) $ by wcel_eq_l [p13, p11]
q1: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ j ∊ ω ∧ x = suc j $ by ax
q2: $ … ⇒ x = suc j $ by and_elim_r [q1]
q3: $ G , ⟨ x , y ⟩ ∈ s , j ∊ ω ∧ x = suc j ⇒ y = y $ by eq_refl
q4: $ … ⇒ ⟨ x , y ⟩ = ⟨ suc j , y ⟩ $ by opair_eq [q2, q3]
