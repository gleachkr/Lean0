n10: $ … ⇒ k ∊ ω ∧ a + suc k = b $ by and_intro [n2, n9b]
n11: $ … ⇒ ∃ c (c ∊ ω ∧ a + suc c = b) $ by ex_intro [n10]
n12: $ … ⇒ ∃ c (c ∊ ω ∧ a + suc c = b) $ by ex_elim [m12, n11]
