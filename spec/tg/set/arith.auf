b5: $ … ⇒ ndbl z = ∅ $ by eq_trans [b3, b4]
b6: $ … ⇒ suc (ndbl u) = ndbl z $ by eq_sym [b1]
b7: $ … ⇒ suc (ndbl u) = ∅ $ by eq_trans [b6, b5]
b8: $ … ⇒ ⊥ $ by suc_ne_empty [b7]
