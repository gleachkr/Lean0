s1: $ G , j ∊ ω , nsub (c + j) j = c , w = suc j ⇒ j ∊ ω $ by ax
s2: $ G , j ∊ ω , nsub (c + j) j = c , w = suc j ⇒ w = suc j $ by ax
s3: $ G , j ∊ ω , nsub (c + j) j = c , w = suc j ⇒ c = c $ by eq_refl
s4: $ … ⇒ c + w = c + suc j $ by nadd_eq [s3, s2]
s5: $ … ⇒ c + suc j = suc (c + j) $ by nadd_suc [s1]
s6: $ … ⇒ c + w = suc (c + j) $ by eq_trans [s4, s5]
s7: $ … ⇒ nsub (c + w) w = nsub (suc (c + j)) (suc j) $ by nsub_eq [s6, s2]
s8a: $ G , j ∊ ω , nsub (c + j) j = c , w = suc j ⇒ c ∊ ω $ by weaken [#2]
s8: $ … ⇒ c + j ∈ ω $ by nadd_omega [s8a, s1]
s1c: $ … ⇒ j ∈ ω $ by welc_wcel [s1]
s9: $ … ⇒ nsub (suc (c + j)) (suc j) = nsub (c + j) j $ by suc_nsub_suc_c [s8, s1c]
s10: $ G , j ∊ ω , nsub (c + j) j = c , w = suc j ⇒ nsub (c + j) j = c $ by ax
s11: $ … ⇒ nsub (c + w) w = nsub (c + j) j $ by eq_trans [s7, s9]
s12: $ … ⇒ nsub (c + w) w = c $ by eq_trans [s11, s10]
i3: $ … ⇒ nsub (c + b) b = c $ by omega_ind_named [b9, s12, #1]

lemma n3_nsub_self (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ nsub a a = ∅ $
----
b1: $ G , w = ∅ ⇒ w = ∅ $ by ax
b2: $ … ⇒ nsub w w = nsub ∅ ∅ $ by nsub_eq [b1, b1]
b3: $ G , w = ∅ ⇒ isset ∅ $ by ax_empty
b4: $ … ⇒ nsub ∅ ∅ = ∅ $ by nsub_zero_c [b3]
b5: $ … ⇒ nsub w w = ∅ $ by eq_trans [b2, b4]
s1: $ G , j ∊ ω , nsub j j = ∅ , w = suc j ⇒ j ∊ ω $ by ax
s2: $ G , j ∊ ω , nsub j j = ∅ , w = suc j ⇒ w = suc j $ by ax
s3: $ … ⇒ nsub w w = nsub (suc j) (suc j) $ by nsub_eq [s2, s2]
s4: $ … ⇒ nsub (suc j) (suc j) = nsub j j $ by suc_nsub_suc [s1, s1]
s5: $ G , j ∊ ω , nsub j j = ∅ , w = suc j ⇒ nsub j j = ∅ $ by ax
s6: $ … ⇒ nsub w w = nsub j j $ by eq_trans [s3, s4]
s7: $ … ⇒ nsub w w = ∅ $ by eq_trans [s6, s5]
i3: $ … ⇒ nsub a a = ∅ $ by omega_ind_named [b5, s7, #1]

lemma n3_nsub_nadd_self (G: hyps) (a c: set): $ G ⇒ a ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ nsub a (a + c) = ∅ $
----
b1: $ G , w = ∅ ⇒ w = ∅ $ by ax
b2: $ G , w = ∅ ⇒ a = a $ by eq_refl
b3: $ … ⇒ a + w = a + ∅ $ by nadd_eq [b2, b1]
b4: $ G , w = ∅ ⇒ a + ∅ = a $ by nadd_zero
b5: $ … ⇒ a + w = a $ by eq_trans [b3, b4]
b6: $ … ⇒ nsub a (a + w) = nsub a a $ by nsub_eq [b2, b5]
b7a: $ G , w = ∅ ⇒ a ∊ ω $ by weaken [#1]
b7: $ … ⇒ nsub a a = ∅ $ by n3_nsub_self [b7a]
b8: $ … ⇒ nsub a (a + w) = ∅ $ by eq_trans [b6, b7]
s1: $ G , j ∊ ω , nsub a (a + j) = ∅ , w = suc j ⇒ j ∊ ω $ by ax
s2: $ G , j ∊ ω , nsub a (a + j) = ∅ , w = suc j ⇒ w = suc j $ by ax
s3: $ G , j ∊ ω , nsub a (a + j) = ∅ , w = suc j ⇒ a = a $ by eq_refl
s4: $ … ⇒ a + w = a + suc j $ by nadd_eq [s3, s2]
s5: $ … ⇒ a + suc j = suc (a + j) $ by nadd_suc [s1]
s6: $ … ⇒ a + w = suc (a + j) $ by eq_trans [s4, s5]
s7: $ … ⇒ nsub a (a + w) = nsub a (suc (a + j)) $ by nsub_eq [s3, s6]
s8a: $ G , j ∊ ω , nsub a (a + j) = ∅ , w = suc j ⇒ a ∊ ω $ by weaken [#1]
s8: $ … ⇒ a + j ∈ ω $ by nadd_omega [s8a, s1]
s8b: $ G , j ∊ ω , nsub a (a + j) = ∅ , w = suc j ⇒ isset a $ by isset_var
s9: $ … ⇒ nsub a (suc (a + j)) = ⋃ (nsub a (a + j)) $ by nsub_suc_c [s8b, s8]
s10: $ G , j ∊ ω , nsub a (a + j) = ∅ , w = suc j ⇒ nsub a (a + j) = ∅ $ by ax
s11: $ … ⇒ ⋃ (nsub a (a + j)) = ⋃ ∅ $ by cuni_eq [s10]
s12: $ G , j ∊ ω , nsub a (a + j) = ∅ , w = suc j ⇒ ⋃ ∅ = ∅ $ by n3_cuni_empty
s13: $ … ⇒ nsub a (a + w) = ⋃ (nsub a (a + j)) $ by eq_trans [s7, s9]
s14: $ … ⇒ nsub a (a + w) = ⋃ ∅ $ by eq_trans [s13, s11]
s15: $ … ⇒ nsub a (a + w) = ∅ $ by eq_trans [s14, s12]
i3: $ … ⇒ nsub a (a + c) = ∅ $ by omega_ind_named [b8, s15, #2]

nsub_eq_zero
------------
l1: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = b) $ by nle_ex [#1, #2, #3]
e1: $ G , c ∊ ω ∧ a + c = b ⇒ c ∊ ω ∧ a + c = b $ by ax
e2: $ … ⇒ c ∊ ω $ by and_elim_l [e1]
e3: $ … ⇒ a + c = b $ by and_elim_r [e1]
e4: $ … ⇒ b = a + c $ by eq_sym [e3]
e5: $ G , c ∊ ω ∧ a + c = b ⇒ a = a $ by eq_refl
e6: $ … ⇒ nsub a b = nsub a (a + c) $ by nsub_eq [e5, e4]
e7a: $ G , c ∊ ω ∧ a + c = b ⇒ a ∊ ω $ by weaken [#1]
e7: $ … ⇒ nsub a (a + c) = ∅ $ by n3_nsub_nadd_self [e7a, e2]
e8: $ … ⇒ nsub a b = ∅ $ by eq_trans [e6, e7]
l2: $ … ⇒ nsub a b = ∅ $ by ex_elim [l1, e8]

lemma n3_cuni_le_c (G: hyps) (A: class): $ G ⇒ A ∈ ω $ > $ G ⇒ ⋃ A ⊆ A $
----
e1: $ G , v = A , v ∊ ω ⇒ v ∊ ω $ by ax
e2: $ … ⇒ transitive v $ by omega_elem_trans [e1]
e3: $ … ⇒ ⋃ v ⊆ v $ by transitive_cuni_subset [e2]
e4: $ G , v = A , v ∊ ω ⇒ v = A $ by ax
e5: $ … ⇒ ⋃ v = ⋃ A $ by cuni_eq [e4]
e6: $ … ⇒ ⋃ A ⊆ v $ by subset_eq_l [e5, e3]
e7: $ … ⇒ ⋃ A ⊆ A $ by subset_eq_r [e4, e6]
e8: $ … ⇒ ⋃ A ⊆ A $ by wcel_elim [#1, e7]

