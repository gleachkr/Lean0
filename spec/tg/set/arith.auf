b11: $ … ⇒ ∀ u (u ∊ ω → ndbl z = suc (ndbl u) → ⊥) $ by all_intro [b10]
s1: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ z = suc y $ by ax
s2: $ … ⇒ ndbl z = ndbl (suc y) $ by ndbl_eq [s1]
s3: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ y ∊ ω $ by ax
s4: $ … ⇒ ndbl (suc y) = suc (suc (ndbl y)) $ by ndbl_suc [s3]
s5: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl z = suc (ndbl u) $ by ax
s6: $ … ⇒ ndbl z = suc (suc (ndbl y)) $ by eq_trans [s2, s4]
s6b: $ … ⇒ suc (suc (ndbl y)) = ndbl z $ by eq_sym [s6]
s7: $ … ⇒ suc (suc (ndbl y)) = suc (ndbl u) $ by eq_trans [s6b, s5]
s8: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ isset (ndbl y) $ by nadd_set
s9: $ … ⇒ isset (suc (ndbl y)) $ by suc_set [s8]
s10: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ isset (ndbl u) $ by nadd_set
s11: $ … ⇒ suc (ndbl y) = ndbl u $ by suc_inj_c [s9, s10, s7]
s12: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) ⇒ u ∊ ω $ by ax
s13: $ … ⇒ u = ∅ ∨ ∃ v (v ∊ ω ∧ u = suc v) $ by omega_cases [s12]
a1: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ u = ∅ $ by ax
a2: $ … ⇒ ndbl u = ndbl ∅ $ by ndbl_eq [a1]
a3: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ ndbl ∅ = ∅ $ by ndbl_zero
a4: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , u = ∅ ⇒ suc (ndbl y) = ndbl u $ by weaken [s11]
a5: $ … ⇒ suc (ndbl y) = ndbl ∅ $ by eq_trans [a4, a2]
a6: $ … ⇒ suc (ndbl y) = ∅ $ by eq_trans [a5, a3]
a7: $ … ⇒ ⊥ $ by suc_ne_empty [a6]
e1: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ v ∊ ω ∧ u = suc v $ by ax
e2: $ … ⇒ v ∊ ω $ by and_elim_l [e1]
e3: $ … ⇒ u = suc v $ by and_elim_r [e1]
e4: $ … ⇒ ndbl u = ndbl (suc v) $ by ndbl_eq [e3]
e5: $ … ⇒ ndbl (suc v) = suc (suc (ndbl v)) $ by ndbl_suc [e2]
e6: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ suc (ndbl y) = ndbl u $ by weaken [s11]
e7: $ … ⇒ suc (ndbl y) = ndbl (suc v) $ by eq_trans [e6, e4]
e8: $ … ⇒ suc (ndbl y) = suc (suc (ndbl v)) $ by eq_trans [e7, e5]
e9: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ isset (ndbl y) $ by nadd_set
e10: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ isset (ndbl v) $ by nadd_set
e11: $ … ⇒ isset (suc (ndbl v)) $ by suc_set [e10]
e12: $ … ⇒ ndbl y = suc (ndbl v) $ by suc_inj_c [e9, e11, e8]
e13: $ G , y ∊ ω , ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) , z = suc y , u ∊ ω , ndbl z = suc (ndbl u) , v ∊ ω ∧ u = suc v ⇒ ∀ u (u ∊ ω → ndbl y = suc (ndbl u) → ⊥) $ by ax
