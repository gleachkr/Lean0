-- Proofs for arith.mm0.

nadd_congr
----------
l1: $ cgr x (suc x) ≐ cgr x (suc x) $ by ceqt_refl
l2: $ omrec A (cgr x (suc x)) ≐ omrec B (cgr x (suc x)) $ by omrec_congr [#1, l1]
l3: $ (omrec A (cgr x (suc x)))' C ≐ (omrec B (cgr x (suc x)))' D $ by fv_congr [l2, #2]

nadd_eq
-------
l1: $ G ⇒ cgr x (suc x) = cgr x (suc x) $ by eq_refl
l2: $ … ⇒ omrec A (cgr x (suc x)) = omrec B (cgr x (suc x)) $ by omrec_eq [#1, l1]
l3: $ … ⇒ (omrec A (cgr x (suc x)))' C = (omrec B (cgr x (suc x)))' D $ by fv_eq [l2, #2]

sb_c_nadd
---------
l1: $ ([[ x / t ]] ((omrec A (cgr y (suc y)))' B)) ≐ ([[ x / t ]] (omrec A (cgr y (suc y))))' ([[ x / t ]] B) $ by sb_c_fv
l2: $ ([[ x / t ]] (omrec A (cgr y (suc y)))) ≐ omrec ([[ x / t ]] A) ([[ x / t ]] (cgr y (suc y))) $ by sb_c_omrec
l3: $ ([[ x / t ]] (cgr y (suc y))) ≐ cgr y (suc y) $ by sb_c_irrel
l4: $ ([[ x / t ]] A) ≐ ([[ x / t ]] A) $ by ceqt_refl
l5: $ omrec ([[ x / t ]] A) ([[ x / t ]] (cgr y (suc y))) ≐ omrec ([[ x / t ]] A) (cgr y (suc y)) $ by omrec_congr [l4, l3]
l6: $ ([[ x / t ]] (omrec A (cgr y (suc y)))) ≐ omrec ([[ x / t ]] A) (cgr y (suc y)) $ by ceqt_trans [l2, l5]
l7: $ ([[ x / t ]] B) ≐ ([[ x / t ]] B) $ by ceqt_refl
l8: $ ([[ x / t ]] (omrec A (cgr y (suc y))))' ([[ x / t ]] B) ≐ (omrec ([[ x / t ]] A) (cgr y (suc y)))' ([[ x / t ]] B) $ by fv_congr [l6, l7]
l9: $ ([[ x / t ]] ((omrec A (cgr y (suc y)))' B)) ≐ (omrec ([[ x / t ]] A) (cgr y (suc y)))' ([[ x / t ]] B) $ by ceqt_trans [l1, l8]

nmul_congr
----------
l1: $ x ≐ x $ by ceqt_refl
l2: $ x + A ≐ x + B $ by nadd_congr [l1, #1]
l3: $ cgr x (x + A) ≐ cgr x (x + B) $ by cgr_congr [l2]
l4: $ ∅ ≐ ∅ $ by ceqt_refl
l5: $ omrec ∅ (cgr x (x + A)) ≐ omrec ∅ (cgr x (x + B)) $ by omrec_congr [l4, l3]
l6: $ (omrec ∅ (cgr x (x + A)))' C ≐ (omrec ∅ (cgr x (x + B)))' D $ by fv_congr [l5, #2]

nmul_eq
-------
l1: $ G ⇒ x = x $ by eq_refl
l2: $ … ⇒ x + A = x + B $ by nadd_eq [l1, #1]
l3: $ … ⇒ ∀ x (x + A = x + B) $ by all_intro [l2]
l4: $ … ⇒ cgr x (x + A) = cgr x (x + B) $ by cgr_eq [l3]
l5: $ G ⇒ ∅ = ∅ $ by eq_refl
l6: $ … ⇒ omrec ∅ (cgr x (x + A)) = omrec ∅ (cgr x (x + B)) $ by omrec_eq [l5, l4]
l7: $ … ⇒ (omrec ∅ (cgr x (x + A)))' C = (omrec ∅ (cgr x (x + B)))' D $ by fv_eq [l6, #2]

sb_c_nmul
---------
l1: $ ([[ x / t ]] ((omrec ∅ (cgr y (y + A)))' B)) ≐ ([[ x / t ]] (omrec ∅ (cgr y (y + A))))' ([[ x / t ]] B) $ by sb_c_fv
l2: $ ([[ x / t ]] (omrec ∅ (cgr y (y + A)))) ≐ omrec ([[ x / t ]] ∅) ([[ x / t ]] (cgr y (y + A))) $ by sb_c_omrec
l3: $ ([[ x / t ]] ∅) ≐ ∅ $ by sb_c_irrel
l4: $ ([[ x / t ]] (cgr y (y + A))) ≐ cgr y (y + ([[ x / t ]] A)) $ by ceqt_refl
l5: $ omrec ([[ x / t ]] ∅) ([[ x / t ]] (cgr y (y + A))) ≐ omrec ∅ (cgr y (y + ([[ x / t ]] A))) $ by omrec_congr [l3, l4]
l6: $ ([[ x / t ]] (omrec ∅ (cgr y (y + A)))) ≐ omrec ∅ (cgr y (y + ([[ x / t ]] A))) $ by ceqt_trans [l2, l5]
l7: $ ([[ x / t ]] B) ≐ ([[ x / t ]] B) $ by ceqt_refl
l8: $ ([[ x / t ]] (omrec ∅ (cgr y (y + A))))' ([[ x / t ]] B) ≐ (omrec ∅ (cgr y (y + ([[ x / t ]] A))))' ([[ x / t ]] B) $ by fv_congr [l6, l7]
l9: $ ([[ x / t ]] ((omrec ∅ (cgr y (y + A)))' B)) ≐ (omrec ∅ (cgr y (y + ([[ x / t ]] A))))' ([[ x / t ]] B) $ by ceqt_trans [l1, l8]

npow_congr
----------
l1: $ x ≐ x $ by ceqt_refl
l2: $ x · A ≐ x · B $ by nmul_congr [l1, #1]
l3: $ cgr x (x · A) ≐ cgr x (x · B) $ by cgr_congr [l2]
l4: $ suc ∅ ≐ suc ∅ $ by ceqt_refl
l5: $ omrec (suc ∅) (cgr x (x · A)) ≐ omrec (suc ∅) (cgr x (x · B)) $ by omrec_congr [l4, l3]
l6: $ (omrec (suc ∅) (cgr x (x · A)))' C ≐ (omrec (suc ∅) (cgr x (x · B)))' D $ by fv_congr [l5, #2]

npow_eq
-------
l1: $ G ⇒ x = x $ by eq_refl
l2: $ … ⇒ x · A = x · B $ by nmul_eq [l1, #1]
l3: $ … ⇒ ∀ x (x · A = x · B) $ by all_intro [l2]
l4: $ … ⇒ cgr x (x · A) = cgr x (x · B) $ by cgr_eq [l3]
l5: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l6: $ … ⇒ omrec (suc ∅) (cgr x (x · A)) = omrec (suc ∅) (cgr x (x · B)) $ by omrec_eq [l5, l4]
l7: $ … ⇒ (omrec (suc ∅) (cgr x (x · A)))' C = (omrec (suc ∅) (cgr x (x · B)))' D $ by fv_eq [l6, #2]

sb_c_npow
---------
l1: $ ([[ x / t ]] ((omrec (suc ∅) (cgr y (y · A)))' B)) ≐ ([[ x / t ]] (omrec (suc ∅) (cgr y (y · A))))' ([[ x / t ]] B) $ by sb_c_fv
l2: $ ([[ x / t ]] (omrec (suc ∅) (cgr y (y · A)))) ≐ omrec ([[ x / t ]] (suc ∅)) ([[ x / t ]] (cgr y (y · A))) $ by sb_c_omrec
l3: $ ([[ x / t ]] (suc ∅)) ≐ suc ∅ $ by sb_c_irrel
l4a: $ ([[ x / t ]] (cgr y (y · A))) ≐ cgr y ([[ x / t ]] (y · A)) $ by sb_c_cgr
l4b: $ ([[ x / t ]] (y · A)) ≐ ([[ x / t ]] y) · ([[ x / t ]] A) $ by sb_c_nmul
l4c: $ ([[ x / t ]] y) ≐ y $ by sb_c_other
l4d: $ ([[ x / t ]] A) ≐ ([[ x / t ]] A) $ by ceqt_refl
l4e: $ ([[ x / t ]] y) · ([[ x / t ]] A) ≐ y · ([[ x / t ]] A) $ by nmul_congr [l4c, l4d]
l4f: $ ([[ x / t ]] (y · A)) ≐ y · ([[ x / t ]] A) $ by ceqt_trans [l4b, l4e]
l4g: $ cgr y ([[ x / t ]] (y · A)) ≐ cgr y (y · ([[ x / t ]] A)) $ by cgr_congr [l4f]
l4: $ ([[ x / t ]] (cgr y (y · A))) ≐ cgr y (y · ([[ x / t ]] A)) $ by ceqt_trans [l4a, l4g]
l5: $ omrec ([[ x / t ]] (suc ∅)) ([[ x / t ]] (cgr y (y · A))) ≐ omrec (suc ∅) (cgr y (y · ([[ x / t ]] A))) $ by omrec_congr [l3, l4]
l6: $ ([[ x / t ]] (omrec (suc ∅) (cgr y (y · A)))) ≐ omrec (suc ∅) (cgr y (y · ([[ x / t ]] A))) $ by ceqt_trans [l2, l5]
l7: $ ([[ x / t ]] B) ≐ ([[ x / t ]] B) $ by ceqt_refl
l8: $ ([[ x / t ]] (omrec (suc ∅) (cgr y (y · A))))' ([[ x / t ]] B) ≐ (omrec (suc ∅) (cgr y (y · ([[ x / t ]] A))))' ([[ x / t ]] B) $ by fv_congr [l6, l7]
l9: $ ([[ x / t ]] ((omrec (suc ∅) (cgr y (y · A)))' B)) ≐ (omrec (suc ∅) (cgr y (y · ([[ x / t ]] A))))' ([[ x / t ]] B) $ by ceqt_trans [l1, l8]

nsub_congr
----------
l1: $ cgr x (⋃ x) ≐ cgr x (⋃ x) $ by ceqt_refl
l2: $ omrec A (cgr x (⋃ x)) ≐ omrec B (cgr x (⋃ x)) $ by omrec_congr [#1, l1]
l3: $ (omrec A (cgr x (⋃ x)))' C ≐ (omrec B (cgr x (⋃ x)))' D $ by fv_congr [l2, #2]

nsub_eq
-------
l1: $ G ⇒ cgr x (⋃ x) = cgr x (⋃ x) $ by eq_refl
l2: $ … ⇒ omrec A (cgr x (⋃ x)) = omrec B (cgr x (⋃ x)) $ by omrec_eq [#1, l1]
l3: $ … ⇒ (omrec A (cgr x (⋃ x)))' C = (omrec B (cgr x (⋃ x)))' D $ by fv_eq [l2, #2]

sb_c_nsub
---------
l1: $ ([[ x / t ]] ((omrec A (cgr y (⋃ y)))' B)) ≐ ([[ x / t ]] (omrec A (cgr y (⋃ y))))' ([[ x / t ]] B) $ by sb_c_fv
l2: $ ([[ x / t ]] (omrec A (cgr y (⋃ y)))) ≐ omrec ([[ x / t ]] A) ([[ x / t ]] (cgr y (⋃ y))) $ by sb_c_omrec
l3: $ ([[ x / t ]] (cgr y (⋃ y))) ≐ cgr y (⋃ y) $ by sb_c_irrel
l4: $ ([[ x / t ]] A) ≐ ([[ x / t ]] A) $ by ceqt_refl
l5: $ omrec ([[ x / t ]] A) ([[ x / t ]] (cgr y (⋃ y))) ≐ omrec ([[ x / t ]] A) (cgr y (⋃ y)) $ by omrec_congr [l4, l3]
l6: $ ([[ x / t ]] (omrec A (cgr y (⋃ y)))) ≐ omrec ([[ x / t ]] A) (cgr y (⋃ y)) $ by ceqt_trans [l2, l5]
l7: $ ([[ x / t ]] B) ≐ ([[ x / t ]] B) $ by ceqt_refl
l8: $ ([[ x / t ]] (omrec A (cgr y (⋃ y))))' ([[ x / t ]] B) ≐ (omrec ([[ x / t ]] A) (cgr y (⋃ y)))' ([[ x / t ]] B) $ by fv_congr [l6, l7]
l9: $ ([[ x / t ]] ((omrec A (cgr y (⋃ y)))' B)) ≐ (omrec ([[ x / t ]] A) (cgr y (⋃ y)))' ([[ x / t ]] B) $ by ceqt_trans [l1, l8]

ndbl_congr
----------
l1: $ A + A ≐ B + B $ by nadd_congr [#1, #1]

ndbl_eq
-------
l1: $ … ⇒ A + A = B + B $ by nadd_eq [#1, #1]

sb_c_ndbl
---------
l1: $ ([[ x / t ]] (A + A)) ≐ ([[ x / t ]] A) + ([[ x / t ]] A) $ by sb_c_nadd

nmax_congr
----------
l1: $ (A ∪ C) ≐ (B ∪ D) $ by cun_congr [#1, #2]

nmax_eq
-------
l1: $ … ⇒ A ∪ C = B ∪ D $ by cun_eq [#1, #2]

sb_c_nmax
---------
l1: $ ([[ x / t ]] (A ∪ B)) ≐ ([[ x / t ]] A) ∪ ([[ x / t ]] B) $ by sb_c_cun

nadd_set
--------
l1: $ G ⇒ functional (omrec a (cgr x (suc x))) $ by omrec_functional
l2: $ … ⇒ isset ((omrec a (cgr x (suc x)))' b) $ by fv_set [l1]

nadd_set_c
----------
l1: $ G , v = A , w = B ⇒ v = A $ by ax
l2: $ G , v = A , w = B ⇒ w = B $ by ax
l3: $ … ⇒ v + w = A + B $ by nadd_eq [l1, l2]
l4: $ G , v = A , w = B ⇒ isset (v + w) $ by nadd_set
l5: $ … ⇒ isset (A + B) $ by isset_eq [l3, l4]
l6: $ … ⇒ isset (A + B) $ by isset_elim [#2, l5]
l7: $ … ⇒ isset (A + B) $ by isset_elim [#1, l6]

nadd_zero
---------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ functional (cgr x (suc x)) $ by cgr_functional
l3: $ … ⇒ (omrec a (cgr x (suc x)))' ∅ = a $ by omrec_zero [l1, l2]

nadd_zero_c
-----------
l1: $ G , v = A ⇒ v + ∅ = v $ by nadd_zero
l2: $ G , v = A ⇒ v = A $ by ax
l3: $ G , v = A ⇒ ∅ = ∅ $ by eq_refl
l4: $ … ⇒ v + ∅ = A + ∅ $ by nadd_eq [l2, l3]
l5: $ … ⇒ A + ∅ = v + ∅ $ by eq_sym [l4]
l6: $ … ⇒ A + ∅ = v $ by eq_trans [l5, l1]
l7: $ … ⇒ A + ∅ = A $ by eq_trans [l6, l2]
l8: $ … ⇒ A + ∅ = A $ by isset_elim [#1, l7]

nadd_suc
--------
l1: $ G ⇒ isset a $ by isset_var
l2: $ G ⇒ functional (cgr x (suc x)) $ by cgr_functional
l3: $ … ⇒ (omrec a (cgr x (suc x)))' (suc b) = (cgr x (suc x))' (omrec a (cgr x (suc x)))' b $ by omrec_suc [l1, l2, #1]
l4: $ G ⇒ isset (a + b) $ by nadd_set
m1: $ G , v = a + b ⇒ isset v $ by isset_var
m2: $ … ⇒ isset (suc v) $ by suc_set [m1]
m3: $ G , v = a + b ⇒ (cgr x (suc x))' v = suc v $ by fv_cgr [m2]
m4: $ G , v = a + b ⇒ v = a + b $ by ax
m5: $ … ⇒ a + b = v $ by eq_sym [m4]
m6: $ G , v = a + b ⇒ cgr x (suc x) = cgr x (suc x) $ by eq_refl
m7: $ … ⇒ (cgr x (suc x))' (a + b) = (cgr x (suc x))' v $ by fv_eq [m6, m5]
m8: $ … ⇒ suc v = suc (a + b) $ by suc_eq [m4]
m9: $ G , v = a + b ⇒ (omrec a (cgr x (suc x)))' (suc b) = (cgr x (suc x))' (omrec a (cgr x (suc x)))' b $ by weaken [l3]
m10: $ … ⇒ a + suc b = (cgr x (suc x))' v $ by eq_trans [m9, m7]
m11: $ … ⇒ a + suc b = suc v $ by eq_trans [m10, m3]
m12: $ … ⇒ a + suc b = suc (a + b) $ by eq_trans [m11, m8]
m13: $ … ⇒ a + suc b = suc (a + b) $ by isset_elim [l4, m12]

--| Transport an equation along equalities of its two sides.
lemma n2_tr (G: hyps) (A B C D: class):
  $ G ⇒ B = A $ > $ G ⇒ D = C $ > $ G ⇒ B = D $ > $ G ⇒ A = C $
----
l1: $ … ⇒ A = B $ by eq_sym [#1]
l2: $ … ⇒ A = D $ by eq_trans [l1, #3]
l3: $ … ⇒ A = C $ by eq_trans [l2, #2]

nadd_suc_c
----------
l1: $ G , u = A , v = B , v ∊ ω ⇒ v ∊ ω $ by ax
l2: $ … ⇒ u + suc v = suc (u + v) $ by nadd_suc [l1]
l3: $ G , u = A , v = B , v ∊ ω ⇒ u = A $ by ax
l4: $ G , u = A , v = B , v ∊ ω ⇒ v = B $ by ax
l5: $ … ⇒ suc v = suc B $ by suc_eq [l4]
l6: $ … ⇒ u + suc v = A + suc B $ by nadd_eq [l3, l5]
l7: $ … ⇒ u + v = A + B $ by nadd_eq [l3, l4]
l8: $ … ⇒ suc (u + v) = suc (A + B) $ by suc_eq [l7]
l9: $ … ⇒ A + suc B = suc (A + B) $ by n2_tr [l6, l8, l2]
l10: $ G , u = A ⇒ B ∈ ω $ by weaken [#2]
l11: $ … ⇒ A + suc B = suc (A + B) $ by wcel_elim [l10, l9]
l12: $ … ⇒ A + suc B = suc (A + B) $ by isset_elim [#1, l11]

nadd_omega
----------
b1: $ G , z = ∅ ⇒ z = ∅ $ by ax
b2: $ G , z = ∅ ⇒ a = a $ by eq_refl
b3: $ … ⇒ a + z = a + ∅ $ by nadd_eq [b2, b1]
b4: $ G , z = ∅ ⇒ a + ∅ = a $ by nadd_zero
b5: $ … ⇒ a + z = a $ by eq_trans [b3, b4]
b6: $ … ⇒ a = a + z $ by eq_sym [b5]
b7: $ G , z = ∅ ⇒ a ∊ ω $ by weaken [#1]
b8: $ … ⇒ a ∈ ω $ by welc_wcel [b7]
b9: $ … ⇒ a + z ∈ ω $ by wcel_eq_l [b6, b8]
s1: $ G , y ∊ ω , a + y ∈ ω , z = suc y ⇒ z = suc y $ by ax
s2: $ G , y ∊ ω , a + y ∈ ω , z = suc y ⇒ a = a $ by eq_refl
s3: $ … ⇒ a + z = a + suc y $ by nadd_eq [s2, s1]
s4: $ G , y ∊ ω , a + y ∈ ω , z = suc y ⇒ y ∊ ω $ by ax
s5: $ … ⇒ a + suc y = suc (a + y) $ by nadd_suc [s4]
s6: $ … ⇒ a + z = suc (a + y) $ by eq_trans [s3, s5]
s7: $ … ⇒ suc (a + y) = a + z $ by eq_sym [s6]
s8: $ G , y ∊ ω , a + y ∈ ω , z = suc y ⇒ a + y ∈ ω $ by ax
s9: $ … ⇒ suc (a + y) ∈ ω $ by omega_suc_c [s8]
s10: $ … ⇒ a + z ∈ ω $ by wcel_eq_l [s7, s9]
i1: $ … ⇒ a + b ∈ ω $ by omega_ind_named [b9, s10, #2]

nadd_omega_c
------------
l1: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ u ∊ ω $ by ax
l2: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ v ∊ ω $ by ax
l3: $ … ⇒ u + v ∈ ω $ by nadd_omega [l1, l2]
l4: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ u = A $ by ax
l5: $ G , u = A , u ∊ ω , v = B , v ∊ ω ⇒ v = B $ by ax
l6: $ … ⇒ u + v = A + B $ by nadd_eq [l4, l5]
l7: $ … ⇒ A + B ∈ ω $ by wcel_eq_l [l6, l3]
l8: $ G , u = A , u ∊ ω ⇒ B ∈ ω $ by weaken [#2]
l9: $ … ⇒ A + B ∈ ω $ by wcel_elim [l8, l7]
l10: $ … ⇒ A + B ∈ ω $ by wcel_elim [#1, l9]

zero_nadd
---------
b1: $ G , z = ∅ ⇒ z = ∅ $ by ax
b2: $ … ⇒ ∅ = z $ by eq_sym [b1]
b3: $ … ⇒ ∅ + z = z + ∅ $ by nadd_eq [b2, b1]
b4: $ G , z = ∅ ⇒ z + ∅ = z $ by nadd_zero
b5: $ … ⇒ ∅ + z = z $ by eq_trans [b3, b4]
s1: $ G , y ∊ ω , ∅ + y = y , z = suc y ⇒ z = suc y $ by ax
s2: $ G , y ∊ ω , ∅ + y = y , z = suc y ⇒ ∅ = ∅ $ by eq_refl
s3: $ … ⇒ ∅ + z = ∅ + suc y $ by nadd_eq [s2, s1]
s4: $ G , y ∊ ω , ∅ + y = y , z = suc y ⇒ y ∊ ω $ by ax
s5: $ G , y ∊ ω , ∅ + y = y , z = suc y ⇒ isset ∅ $ by ax_empty
s4c: $ … ⇒ y ∈ ω $ by welc_wcel [s4]
s6: $ … ⇒ ∅ + suc y = suc (∅ + y) $ by nadd_suc_c [s5, s4c]
s7: $ G , y ∊ ω , ∅ + y = y , z = suc y ⇒ ∅ + y = y $ by ax
s8: $ … ⇒ suc (∅ + y) = suc y $ by suc_eq [s7]
s9: $ … ⇒ suc y = z $ by eq_sym [s1]
s10: $ … ⇒ ∅ + z = suc (∅ + y) $ by eq_trans [s3, s6]
s11: $ … ⇒ ∅ + z = suc y $ by eq_trans [s10, s8]
s12: $ … ⇒ ∅ + z = z $ by eq_trans [s11, s9]
i1: $ … ⇒ ∅ + a = a $ by omega_ind_named [b5, s12, #1]

suc_nadd
--------
c1: $ G , z = ∅ ⇒ z = ∅ $ by ax
c2: $ G , z = ∅ ⇒ suc a = suc a $ by eq_refl
c3: $ … ⇒ suc a + z = suc a + ∅ $ by nadd_eq [c2, c1]
c4: $ G , z = ∅ ⇒ isset a $ by isset_var
c5: $ … ⇒ isset (suc a) $ by suc_set [c4]
c6: $ … ⇒ suc a + ∅ = suc a $ by nadd_zero_c [c5]
c7: $ G , z = ∅ ⇒ a = a $ by eq_refl
c8: $ … ⇒ a + z = a + ∅ $ by nadd_eq [c7, c1]
c9: $ G , z = ∅ ⇒ a + ∅ = a $ by nadd_zero
c10: $ … ⇒ a + z = a $ by eq_trans [c8, c9]
c11: $ … ⇒ suc (a + z) = suc a $ by suc_eq [c10]
c12: $ … ⇒ suc a = suc (a + z) $ by eq_sym [c11]
c13: $ … ⇒ suc a + z = suc a $ by eq_trans [c3, c6]
c14: $ … ⇒ suc a + z = suc (a + z) $ by eq_trans [c13, c12]
d1: $ G , y ∊ ω , suc a + y = suc (a + y) , z = suc y ⇒ z = suc y $ by ax
d2: $ G , y ∊ ω , suc a + y = suc (a + y) , z = suc y ⇒ suc a = suc a $ by eq_refl
d3: $ … ⇒ suc a + z = suc a + suc y $ by nadd_eq [d2, d1]
d4: $ G , y ∊ ω , suc a + y = suc (a + y) , z = suc y ⇒ y ∊ ω $ by ax
