d2: $ … ⇒ a = ∅ $ by eq_sym [d1]
d3: $ G , ∅ = a ⇒ a ∊ suc a $ by suc_self
d4: $ … ⇒ a ∈ suc a $ by welc_wcel [d3]
d5: $ … ⇒ ∅ ∈ suc a $ by wcel_eq_l [d2, d4]
l2: $ … ⇒ ∅ ∈ suc a $ by or_elim [l1, c3, d5]

nzero_lt_suc_c
--------------
l1: $ G , a = A , a ∊ ω ⇒ a ∊ ω $ by ax
l2: $ … ⇒ ∅ ∈ suc a $ by nzero_lt_suc [l1]
l3: $ G , a = A , a ∊ ω ⇒ a = A $ by ax
l4: $ … ⇒ suc a = suc A $ by suc_eq [l3]
l5: $ … ⇒ ∅ ∈ suc A $ by wcel_eq_r [l4, l2]
l6: $ … ⇒ ∅ ∈ suc A $ by wcel_elim [#1, l5]

nzero_lt
--------
l1: $ … ⇒ r ∊ ω $ by omega_elem_omega [#1, #2]
l2: $ … ⇒ suc r ⊆ b $ by omega_elem_suc_subset [l1, #1, #2]
l3: $ … ⇒ ∅ ∈ suc r $ by nzero_lt_suc [l1]
l4: $ … ⇒ ∅ ∈ b $ by wcel_subset [l2, l3]

nlt_zero_ex
-----------
l1: $ … ⇒ a = ∅ ∨ ∃ y (y ∊ ω ∧ a = suc y) $ by omega_cases [#1]
c1: $ G , a = ∅ ⇒ a = ∅ $ by ax
c2: $ G , a = ∅ ⇒ ∅ ∈ a $ by weaken [#2]
c3: $ … ⇒ ∅ ∈ ∅ $ by wcel_eq_r [c1, c2]
c4: $ G , a = ∅ , z = ∅ , z ∊ ∅ ⇒ z ∊ ∅ $ by ax
c5: $ … ⇒ ⊥ $ by empty_elim [c4]
c6: $ … ⇒ ⊥ $ by wcel_elim [c3, c5]
c7: $ … ⇒ ∃ y (y ∊ ω ∧ a = suc y) $ by bot_elim [c6]
d1: $ G , ∃ y (y ∊ ω ∧ a = suc y) ⇒ ∃ y (y ∊ ω ∧ a = suc y) $ by ax
l2: $ … ⇒ ∃ y (y ∊ ω ∧ a = suc y) $ by or_elim [l1, c7, d1]
