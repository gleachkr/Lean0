--| Monotonicity of addition in its second argument, for classes.
lemma n2_mono_le_r (G: hyps) (A B C: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ > $ G ⇒ A ⊆ B $ > $ G ⇒ C + A ⊆ C + B $
----
l1: $ … ⇒ A + C ⊆ B + C $ by nadd_mono_le_c [#1, #2, #3, #4]
l2: $ … ⇒ C + A = A + C $ by nadd_comm_c [#3, #1]
l3: $ … ⇒ A + C = C + A $ by eq_sym [l2]
l4: $ … ⇒ C + A ⊆ B + C $ by subset_eq_l [l3, l1]
l5: $ … ⇒ B + C = C + B $ by nadd_comm_c [#2, #3]
l6: $ … ⇒ C + A ⊆ C + B $ by subset_eq_r [l5, l4]

