v4: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a ∊ z , k ∊ ω ∧ a + k = y ⇒ isset k $ by isset_var
v5: $ … ⇒ isset (suc k) $ by suc_set [v4]
w1: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a ∊ z , k ∊ ω ∧ a + k = y , w = suc k ⇒ w = suc k $ by ax
w1a: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a ∊ z , k ∊ ω ∧ a + k = y , w = suc k ⇒ k ∊ ω $ by weaken [v2]
w2: $ … ⇒ suc k ∈ ω $ by omega_suc [w1a]
w3: $ … ⇒ suc k = w $ by eq_sym [w1]
w4: $ … ⇒ w ∈ ω $ by wcel_eq_l [w3, w2]
w5: $ … ⇒ w ∊ ω $ by wcel_welc [w4]
w6: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a ∊ z , k ∊ ω ∧ a + k = y , w = suc k ⇒ a = a $ by eq_refl
w7: $ … ⇒ a + w = a + suc k $ by nadd_eq [w6, w1]
w8: $ … ⇒ a + suc k = suc (a + k) $ by nadd_suc [w1a]
w8a: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a ∊ z , k ∊ ω ∧ a + k = y , w = suc k ⇒ a + k = y $ by weaken [v3]
w9: $ … ⇒ suc (a + k) = suc y $ by suc_eq [w8a]
w10a: $ … ⇒ a + w = suc (a + k) $ by eq_trans [w7, w8]
w10: $ … ⇒ a + w = suc y $ by eq_trans [w10a, w9]
w10b: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a ∊ z , k ∊ ω ∧ a + k = y , w = suc k ⇒ suc y = z $ by weaken [t4]
w11: $ … ⇒ a + w = z $ by eq_trans [w10, w10b]
w12: $ … ⇒ w ∊ ω ∧ a + w = z $ by and_intro [w5, w11]
w13: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by ex_intro [w12]
w14: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by isset_elim [v5, w13]
u12: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by ex_elim [u11, w14]
x1: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ w = ∅ $ by ax
x2: $ … ⇒ ∅ = w $ by eq_sym [x1]
x3: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ ∅ ∈ ω $ by omega_zero
x4: $ … ⇒ w ∈ ω $ by wcel_eq_l [x2, x3]
x5: $ … ⇒ w ∊ ω $ by wcel_welc [x4]
x6: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ a = a $ by eq_refl
x7: $ … ⇒ a + w = a + ∅ $ by nadd_eq [x6, x1]
x8: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ a + ∅ = a $ by nadd_zero
x9: $ … ⇒ a + w = a $ by eq_trans [x7, x8]
x10: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z , w = ∅ ⇒ a = z $ by ax
x11: $ … ⇒ a + w = z $ by eq_trans [x9, x10]
x12: $ … ⇒ w ∊ ω ∧ a + w = z $ by and_intro [x5, x11]
x13: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by ex_intro [x12]
x14: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z ⇒ isset ∅ $ by ax_empty
x15: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by isset_elim [x14, x13]
y1: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , z ∊ a ⇒ z ∊ a $ by ax
y2: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , z ∊ a ⇒ a ⊆ z $ by ax
y3: $ … ⇒ z ∊ z $ by subset_elim [y2, y1]
y4: $ … ⇒ ⊥ $ by notin_self [y3]
y5: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by bot_elim [y4]
y6: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z ∨ z ∊ a ⇒ a = z ∨ z ∊ a $ by ax
y6a: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z ∨ z ∊ a , a = z ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by weaken [x15]
y6b: $ G , y ∊ ω , a ⊆ y → ∃ c (c ∊ ω ∧ a + c = y) , z = suc y , a ⊆ z , a = z ∨ z ∊ a , z ∊ a ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by weaken [y5]
y7: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by or_elim [y6, y6a, y6b]
y8: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = z) $ by or_elim [t8, u12, y7]
y9: $ … ⇒ a ⊆ z → ∃ c (c ∊ ω ∧ a + c = z) $ by imp_intro [y8]
i1: $ … ⇒ a ⊆ b → ∃ c (c ∊ ω ∧ a + c = b) $ by omega_ind_named [n17, y9, #2]
i2: $ … ⇒ ∃ c (c ∊ ω ∧ a + c = b) $ by imp_elim [i1, #3]

