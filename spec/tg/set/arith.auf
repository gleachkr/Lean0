--| Three-way case analysis.
lemma n2_cases3 (G: hyps) (p q r c: fml):
  $ G ⇒ p ∨ q ∨ r $ > $ G , p ⇒ c $ > $ G , q ⇒ c $ > $ G , r ⇒ c $ > $ G ⇒ c $
----
l1: $ G , q ∨ r , q ⇒ c $ by weaken [#3]
l2: $ G , q ∨ r , r ⇒ c $ by weaken [#4]
l3: $ G , q ∨ r ⇒ q ∨ r $ by ax
l4: $ … ⇒ c $ by or_elim [l3, l1, l2]
l5: $ … ⇒ c $ by or_elim [#1, #2, l4]

ndbl_inj
--------
t1: $ … ⇒ a ∊ b ∨ a = b ∨ b ∊ a $ by omega_tricho [#1, #2]
c1: $ G , a ∊ b ⇒ a ∊ b $ by ax
c2: $ G , a ∊ b ⇒ a ∊ ω $ by weaken [#1]
c3: $ G , a ∊ b ⇒ b ∊ ω $ by weaken [#2]
c4: $ … ⇒ a + a ∈ b + a $ by nadd_mono_lt [c2, c3, c2, c1]
c5: $ G , a ∊ b ⇒ a + a = b + b $ by weaken [#3]
c6: $ … ⇒ b + b ∈ b + a $ by wcel_eq_l [c5, c4]
c7: $ … ⇒ b + a = a + b $ by nadd_comm [c3, c2]
c8: $ … ⇒ b + b ∈ a + b $ by wcel_eq_r [c7, c6]
c9: $ … ⇒ b ∊ a $ by nadd_lt_cancel [c3, c2, c3, c8]
c10: $ … ⇒ ⊥ $ by notin_cycle [c1, c9]
c11: $ … ⇒ a = b $ by bot_elim [c10]
d1: $ G , a = b ⇒ a = b $ by ax
f1: $ G , b ∊ a ⇒ b ∊ a $ by ax
f2: $ G , b ∊ a ⇒ a ∊ ω $ by weaken [#1]
f3: $ G , b ∊ a ⇒ b ∊ ω $ by weaken [#2]
f4: $ … ⇒ b + b ∈ a + b $ by nadd_mono_lt [f3, f2, f3, f1]
f5: $ G , b ∊ a ⇒ a + a = b + b $ by weaken [#3]
f6: $ … ⇒ b + b = a + a $ by eq_sym [f5]
f7: $ … ⇒ a + a ∈ a + b $ by wcel_eq_l [f6, f4]
f8: $ … ⇒ a + b = b + a $ by nadd_comm [f2, f3]
f9: $ … ⇒ a + a ∈ b + a $ by wcel_eq_r [f8, f7]
f10: $ … ⇒ a ∊ b $ by nadd_lt_cancel [f2, f3, f2, f9]
f11: $ … ⇒ ⊥ $ by notin_cycle [f10, f1]
f12: $ … ⇒ a = b $ by bot_elim [f11]
g1: $ … ⇒ a = b $ by n2_cases3 [t1, c11, d1, f12]

--| Transport an equation along equalities of its two sides (other orientation).
lemma n2_tr2 (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ B = D $ > $ G ⇒ A = C $
----
l1: $ … ⇒ A = D $ by eq_trans [#1, #3]
l2: $ … ⇒ D = C $ by eq_sym [#2]
l3: $ … ⇒ A = C $ by eq_trans [l1, l2]

ndbl_ne_suc_ndbl
----------------
b1: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ ndbl z = suc (ndbl u) $ by ax
b2: $ G , z = ∅ , u ∊ ω , ndbl z = suc (ndbl u) ⇒ z = ∅ $ by ax
b3: $ … ⇒ ndbl z = ndbl ∅ $ by ndbl_eq [b2]
