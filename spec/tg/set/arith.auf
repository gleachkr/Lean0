--| Chains of equations.
lemma n2_tr3 (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ B = C $ > $ G ⇒ C = D $ > $ G ⇒ A = D $
----
l1: $ … ⇒ A = C $ by eq_trans [#1, #2]
l2: $ … ⇒ A = D $ by eq_trans [l1, #3]

lemma n2_tr4 (G: hyps) (A B C D E: class):
  $ G ⇒ A = B $ > $ G ⇒ B = C $ > $ G ⇒ C = D $ > $ G ⇒ D = E $ > $ G ⇒ A = E $
----
l1: $ … ⇒ A = C $ by eq_trans [#1, #2]
l2: $ … ⇒ A = D $ by eq_trans [l1, #3]
l3: $ … ⇒ A = E $ by eq_trans [l2, #4]

