lemma n3_fv_cgr_cuni {x: set} (G: hyps x) (A: class x): $ G ⇒ isset A $ > $ G ⇒ (cgr x (⋃ x))' A = ⋃ A $
----
m1: $ G , z = A ⇒ z = A $ by ax
m2: $ G , z = A ⇒ isset z $ by isset_var
m3: $ … ⇒ isset (⋃ z) $ by cuni_set [m2]
m4: $ G , z = A ⇒ (cgr x (⋃ x))' z = ⋃ z $ by fv_cgr [m3]
m5: $ … ⇒ A = z $ by eq_sym [m1]
m6: $ G , z = A ⇒ cgr x (⋃ x) = cgr x (⋃ x) $ by eq_refl
m7: $ … ⇒ (cgr x (⋃ x))' A = (cgr x (⋃ x))' z $ by fv_eq [m6, m5]
m8: $ … ⇒ ⋃ z = ⋃ A $ by cuni_eq [m1]
m9: $ … ⇒ (cgr x (⋃ x))' A = ⋃ z $ by eq_trans [m7, m4]
m10: $ … ⇒ (cgr x (⋃ x))' A = ⋃ A $ by eq_trans [m9, m8]
m11: $ … ⇒ (cgr x (⋃ x))' A = ⋃ A $ by isset_elim [#1, m10]

