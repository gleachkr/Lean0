-- omega.mm0: the natural numbers: consequences of foundation, `ω` as the
-- least inductive class, induction on `ω`, the order of the natural numbers,
-- function values, and the recursion theorem on `ω` (a function `omrec A F`
-- with `omrec A F ∅ = A` and `omrec A F (suc n) = F (omrec A F n)`). Imports
-- relations.mm0; proofs in omega.auf. Arithmetic is a later file.

import "relations.mm0";

-- --------------------------------------------------------------------------
-- Consequences of foundation
-- --------------------------------------------------------------------------

theorem notin_self (G: hyps) (a: set): $ G ⇒ a ∊ a $ > $ G ⇒ ⊥ $;
--| Class form of `notin_self`.
theorem notin_self_c (G: hyps) (A: class): $ G ⇒ A ∈ A $ > $ G ⇒ ⊥ $;
theorem notin_cycle (G: hyps) (a b: set): $ G ⇒ a ∊ b $ > $ G ⇒ b ∊ a $ > $ G ⇒ ⊥ $;
--| Class form of `notin_cycle`.
theorem notin_cycle_c (G: hyps) (A B: class): $ G ⇒ A ∈ B $ > $ G ⇒ B ∈ A $ > $ G ⇒ ⊥ $;
theorem suc_ne_empty (G: hyps) (A: class): $ G ⇒ suc A = ∅ $ > $ G ⇒ ⊥ $;
theorem suc_inj (G: hyps) (a b: set): $ G ⇒ suc a = suc b $ > $ G ⇒ a = b $;
--| Class form of `suc_inj`.
theorem suc_inj_c (G: hyps) (A B: class):
  $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ suc A = suc B $ > $ G ⇒ A = B $;
theorem suc_mem (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ suc A $;
theorem suc_mem_r (G: hyps) (A B: class): $ G ⇒ A ∈ B $ > $ G ⇒ A ∈ suc B $;
--| A member differs from its class (labels in `∈` order differ).
theorem mem_ne (G: hyps) (A B: class): $ G ⇒ A ∈ B $ > $ G ⇒ A = B $ > $ G ⇒ ⊥ $;

-- --------------------------------------------------------------------------
-- ω, the least inductive class
-- --------------------------------------------------------------------------

def omega (.x .y: set): class = $ {x | ∀ y (inductive y → x ∊ y)} $;
prefix omega: $om.$ prec max;
prefix omega: $ω$ prec max;

--| @freshen G y
theorem omega_intro (G: hyps) {y: set} (a: set):
  $ G , inductive y ⇒ a ∊ y $ > $ G ⇒ a ∊ ω $;
theorem omega_elim (G: hyps) (A: class) (a: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ inductive A $ > $ G ⇒ a ∊ A $;
theorem omega_zero (G: hyps): $ G ⇒ ∅ ∈ ω $;
theorem omega_suc (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ suc a ∈ ω $;
--| Class form of `omega_suc`.
theorem omega_suc_c (G: hyps) (A: class): $ G ⇒ A ∈ ω $ > $ G ⇒ suc A ∈ ω $;
theorem omega_inductive (G: hyps): $ G ⇒ inductive ω $;
--| `ω` is a subclass of the inductive set given by infinity.
theorem omega_set (G: hyps): $ G ⇒ isset ω $;
--| Induction, for a class and for a formula.
theorem omega_ind {x: set} (G: hyps x) (P: class):
  $ G ⇒ ∅ ∈ P $ > $ G ⇒ ∀ x (x ∊ ω ∧ x ∊ P → suc x ∈ P) $ > $ G ⇒ ω ⊆ P $;
--| @freshen G x
--| @freshen G y
--| @freshen p y
theorem omega_ind_f (G: hyps) {x y: set} (p: fml x):
  $ G ⇒ ∅ ∈ {x | p} $ > $ G ⇒ ∀ y (y ∊ ω → [x/y] p → suc y ∈ {x | p}) $ >
  $ G ⇒ ∀ x (x ∊ ω → p) $;
--| Induction with the cases at a named set `z`: `z = ∅`, and `z = suc y` given the case at `y`.
--| @view {x y z: set} (G: hyps) (p: fml x) (a: set) (q s r: fml): $ G , z = ∅ ⇒ q $ > $ G , y ∊ ω , s , z = suc y ⇒ q $ > $ G ⇒ a ∊ ω $ > $ G ⇒ r $
--| @abstract p r q x a z
--| @fresh x
theorem omega_ind_named {x y z: set} (G: hyps) (p: fml x) (a: set):
  $ G , z = ∅ ⇒ [x/z] p $ > $ G , y ∊ ω , [x/y] p , z = suc y ⇒ [x/z] p $ > $ G ⇒ a ∊ ω $ >
  $ G ⇒ [x/a] p $;

-- --------------------------------------------------------------------------
-- The order of the natural numbers (membership)
-- --------------------------------------------------------------------------

theorem omega_trans (G: hyps): $ G ⇒ transitive ω $;
theorem omega_elem_subset (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ a ⊆ ω $;
theorem omega_elem_trans (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ transitive a $;
theorem omega_elem_omega (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ a $ > $ G ⇒ b ∊ ω $;
--| Class form of `omega_elem_omega`.
theorem omega_elem_omega_c (G: hyps) (A B: class): $ G ⇒ A ∈ B $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A ∈ ω $;
theorem omega_cases {y: set} (G: hyps y) (a: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ a = ∅ ∨ ∃ y (y ∊ ω ∧ a = suc y) $;
theorem omega_suc_mono (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ b $ > $ G ⇒ suc a ∈ suc b $;
--| Class form of `omega_suc_mono`.
theorem omega_suc_mono_c (G: hyps) (A B: class):
  $ G ⇒ B ∈ ω $ > $ G ⇒ A ∈ B $ > $ G ⇒ suc A ∈ suc B $;
theorem omega_zero_le (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ ∅ ∈ a ∨ ∅ = a $;
theorem omega_tricho (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ b ∨ a = b ∨ b ∊ a $;
theorem omega_elem_suc_subset (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ b $ > $ G ⇒ suc a ⊆ b $;

-- --------------------------------------------------------------------------
-- Function values
-- --------------------------------------------------------------------------

--| The value of a functional class at `A`: the union of its singleton of
--| values (`∅` outside the domain).
def fv (F A: class): class = $ ⋃ (ap F A) $;
--| `F' a` is the value of `F` at `a` (Principia's notation). The mark adjoins the function and binds tighter than
--| every other operator: `F' a ∈ B ∪ G' b`, but `(F ∪ G)' a` and `F' (suc a)`. It associates to the right:
--| `F' G' a` is `F' (G' a)`.
delimiter $ $ $ ' $;
infixr fv: $'$ prec 90;

theorem fv_val (G: hyps) (F: class) (a b: set):
  $ G ⇒ functional F $ > $ G ⇒ ⟨ a , b ⟩ ∈ F $ > $ G ⇒ F' a = b $;
theorem fv_in (G: hyps) (F: class) (a: set):
  $ G ⇒ functional F $ > $ G ⇒ a ∊ cdm F $ > $ G ⇒ ⟨ a , F' a ⟩ ∈ F $;
--| A pair of one function is a pair of another with the same value at its first component.
theorem fv_pair_move (G: hyps) (R S: class) (u v: set):
  $ G ⇒ functional R $ > $ G ⇒ functional S $ > $ G ⇒ ⟨ u , v ⟩ ∈ R $ > $ G ⇒ u ∊ cdm S $ >
  $ G ⇒ R' u = S' u $ > $ G ⇒ ⟨ u , v ⟩ ∈ S $;
theorem fv_set (G: hyps) (F: class) (a: set):
  $ G ⇒ functional F $ > $ G ⇒ isset (F' a) $;
theorem fv_empty (G: hyps) (F: class) (a: set):
  $ G ⇒ a ∊ cdm F → ⊥ $ > $ G ⇒ F' a = ∅ $;
--| Two functional classes with the same domain and the same values are equal.
--| @freshen G x
theorem fv_ext (G: hyps) {x: set} (F H: class):
  $ G ⇒ functional F $ > $ G ⇒ functional H $ > $ G ⇒ rel F $ > $ G ⇒ rel H $ >
  $ G ⇒ cdm F = cdm H $ > $ G , x ∊ cdm F ⇒ F' x = H' x $ > $ G ⇒ F = H $;
--| @congr
theorem fv_congr (F H A B: class):
  $ F ≐ H $ > $ A ≐ B $ > $ F' A ≐ H' B $;
theorem fv_eq (G: hyps) (F H A B: class):
  $ G ⇒ F = H $ > $ G ⇒ A = B $ > $ G ⇒ F' A = H' B $;
--| @rewrite
theorem sb_c_fv {x: set} (t: set x) (F A: class x):
  $ (⟦ x / t ⟧ (F' A)) ≐ (⟦ x / t ⟧ F)' (⟦ x / t ⟧ A) $;
--| Class form of `fv_val`.
theorem fv_val_c (G: hyps) (F A B: class):
  $ G ⇒ functional F $ > $ G ⇒ ⟨ A , B ⟩ ∈ F $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ F' A = B $;
--| The value at `A` is `B` when `B` is the only value related to `A`.
theorem fv_iff {o: set} (G: hyps o) (F A B: class): $ G ⇒ ∀ o (⟨ A , o ⟩ ∈ F ↔ o = B) $ > $ G ⇒ isset B $ > $ G ⇒ F' A = B $;
--| The value of a singleton function.
theorem fv_csn_c (G: hyps) (A B: class): $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ (csn ⟨ A , B ⟩)' A = B $;
--| Class form of `fv_set`.
theorem fv_set_c (G: hyps) (F A: class): $ G ⇒ functional F $ > $ G ⇒ isset A $ > $ G ⇒ isset (F' A) $;
--| The values of a set at any class form a set.
theorem fv_set_l (G: hyps) (F A: class): $ G ⇒ isset F $ > $ G ⇒ isset (F' A) $;
--| `fv_set` for a relation, at any class.
theorem fv_set_rel (G: hyps) (F A: class): $ G ⇒ functional F $ > $ G ⇒ rel F $ > $ G ⇒ isset (F' A) $;
--| Agreement of two functions on a class, `∀ i (i ∊ K → A' i = B' i)`, and
--| pointwise inclusion, `∀ i (A' i ⊆ B' i)`: transport under equal
--| arguments, and their instances at a class.
theorem fv_agree_eq {i: set} (G: hyps i) (K L A B C D: class):
  $ G ⇒ K = L $ > $ G ⇒ A = C $ > $ G ⇒ B = D $ > $ G ⇒ ∀ i (i ∊ K → A' i = B' i) $ >
  $ G ⇒ ∀ i (i ∊ L → C' i = D' i) $;
theorem fv_agree_c {i: set} (G: hyps i) (K A R R2: class):
  $ G ⇒ ∀ i (i ∊ K → R' i = R2' i) $ > $ G ⇒ A ∈ K $ > $ G ⇒ R' A = R2' A $;
theorem fv_sub_eq {i: set} (G: hyps i) (A B C D: class):
  $ G ⇒ A = C $ > $ G ⇒ B = D $ > $ G ⇒ ∀ i (A' i ⊆ B' i) $ > $ G ⇒ ∀ i (C' i ⊆ D' i) $;
theorem fv_sub_c {i: set} (G: hyps i) (A R R2: class):
  $ G ⇒ ∀ i (R' i ⊆ R2' i) $ > $ G ⇒ isset A $ > $ G ⇒ R' A ⊆ R2' A $;

-- --------------------------------------------------------------------------
-- Recursion on ω
-- --------------------------------------------------------------------------

--| The approximations: functions `g` on an initial segment `suc n` of `ω`
--| that start at `A` and step by `F`.
def omapx (A F: class) (.g .n .k: set): class =
  $ {g | ∃ n (n ∊ ω ∧ functional g ∧ rel g ∧ cdm g = suc n ∧ g' ∅ = A ∧
      ∀ k (k ∊ n → g' (suc k) = F' g' k))} $;
--| The function defined by recursion: the union of the approximations.
def omrec (A F: class): class = $ ⋃ (omapx A F) $;

--| @congr
theorem omapx_congr (A B F H: class): $ A ≐ B $ > $ F ≐ H $ > $ omapx A F ≐ omapx B H $;
theorem omapx_eq (G: hyps) (A B F H: class):
  $ G ⇒ A = B $ > $ G ⇒ F = H $ > $ G ⇒ omapx A F = omapx B H $;

--| @freshen H n
--| @freshen c n
theorem omapx_elim {n k: set} (G: hyps n k) (H: hyps k) (A F: class) (g: set) (c: fml k): $ G ⇒ g ∊ omapx A F $ > $ H , n ∊ ω , functional g , rel g , cdm g = suc n , g' ∅ = A , ∀ k (k ∊ n → g' (suc k) = F' g' k) ⇒ c $ > $ G , H ⇒ c $;
theorem omega_suc_elem (G: hyps) (i w a: set): $ G ⇒ i ∊ ω $ > $ G ⇒ w ∊ suc i $ > $ G ⇒ a ∊ w $ > $ G ⇒ a ∊ i $;
theorem omega_suc_elem_omega (G: hyps) (i a: set): $ G ⇒ i ∊ ω $ > $ G ⇒ a ∊ suc i $ > $ G ⇒ a ∊ ω $;
--| Two approximations agree where both are defined.
theorem omapx_agree (G: hyps) (A F: class) (g h a: set):
  $ G ⇒ g ∊ omapx A F $ > $ G ⇒ h ∊ omapx A F $ >
  $ G ⇒ a ∊ cdm g $ > $ G ⇒ a ∊ cdm h $ > $ G ⇒ g' a = h' a $;
theorem cun_csn_opair_intro (G: hyps) (R: class) (s c: set): $ G ⇒ ⟨ s , c ⟩ ∈ R ∪ csn ⟨ s , c ⟩ $;
theorem cun_csn_opair_elim (G: hyps) (R: class) (a b s c: set): $ G ⇒ ⟨ a , b ⟩ ∈ R ∪ csn ⟨ s , c ⟩ $ > $ G ⇒ ⟨ a , b ⟩ ∈ R ∨ (a = s ∧ b = c) $;
theorem fv_cun_csn_other (G: hyps) (R A: class) (s c: set): $ G ⇒ isset A $ > $ G ⇒ A = s → ⊥ $ > $ G ⇒ (R ∪ csn ⟨ s , c ⟩)' A = R' A $;
theorem omapx_intro {g k: set} (G: hyps g k) (A F B: class) (i: set): $ G ⇒ isset B $ > $ G ⇒ i ∊ ω $ > $ G ⇒ functional B $ > $ G ⇒ rel B $ > $ G ⇒ cdm B = suc i $ > $ G ⇒ B' ∅ = A $ > $ G ⇒ ∀ k (k ∊ i → B' (suc k) = F' B' k) $ > $ G ⇒ ∃ g (g ∊ omapx A F ∧ cdm g = suc i) $;
--| An approximation defined at `n` exists for every `n ∊ ω`.
--| @freshen G g
theorem omapx_exists (G: hyps) {g: set} (A F: class) (n: set):
  $ G ⇒ isset A $ > $ G ⇒ functional F $ > $ G ⇒ n ∊ ω $ >
  $ G ⇒ ∃ g (g ∊ omapx A F ∧ n ∊ cdm g) $;
theorem omapx_functional (G: hyps) (A F: class) (g: set): $ G ⇒ g ∊ omapx A F $ > $ G ⇒ functional g $;
theorem omapx_rel (G: hyps) (A F: class) (g: set): $ G ⇒ g ∊ omapx A F $ > $ G ⇒ rel g $;
theorem omapx_zero (G: hyps) (A F: class) (g: set): $ G ⇒ g ∊ omapx A F $ > $ G ⇒ g' ∅ = A $;
theorem omapx_cdm (G: hyps) (A F: class) (g a: set): $ G ⇒ g ∊ omapx A F $ > $ G ⇒ a ∊ cdm g $ > $ G ⇒ a ∊ ω $;
theorem omapx_step (G: hyps) (A F: class) (g m n: set): $ G ⇒ g ∊ omapx A F $ > $ G ⇒ m = suc n $ > $ G ⇒ m ∊ cdm g $ > $ G ⇒ n ∊ cdm g ∧ g' (suc n) = F' g' n $;
theorem omrec_intro (G: hyps) (A F: class) (g a b: set): $ G ⇒ g ∊ omapx A F $ > $ G ⇒ ⟨ a , b ⟩ ∈ g $ > $ G ⇒ ⟨ a , b ⟩ ∈ omrec A F $;
theorem omrec_elim {g: set} (G: hyps g) (A F: class) (a b: set): $ G ⇒ ⟨ a , b ⟩ ∈ omrec A F $ > $ G ⇒ ∃ g (g ∊ omapx A F ∧ ⟨ a , b ⟩ ∈ g) $;
theorem omrec_functional (G: hyps) (A F: class): $ G ⇒ functional (omrec A F) $;
theorem omrec_rel (G: hyps) (A F: class): $ G ⇒ rel (omrec A F) $;
theorem omrec_cdm (G: hyps) (A F: class):
  $ G ⇒ isset A $ > $ G ⇒ functional F $ > $ G ⇒ cdm (omrec A F) = ω $;
--| The arguments of `omrec` are numbers.
theorem omrec_cdm_elim (G: hyps) (A F: class) (n: set): $ G ⇒ n ∊ cdm (omrec A F) $ > $ G ⇒ n ∊ ω $;
theorem omrec_fv (G: hyps) (A F: class) (g a: set): $ G ⇒ functional (omrec A F) $ > $ G ⇒ g ∊ omapx A F $ > $ G ⇒ a ∊ cdm g $ > $ G ⇒ (omrec A F)' a = g' a $;
theorem omrec_zero (G: hyps) (A F: class):
  $ G ⇒ isset A $ > $ G ⇒ functional F $ > $ G ⇒ (omrec A F)' ∅ = A $;
theorem omrec_suc (G: hyps) (A F: class) (n: set):
  $ G ⇒ isset A $ > $ G ⇒ functional F $ > $ G ⇒ n ∊ ω $ >
  $ G ⇒ (omrec A F)' (suc n) = F' (omrec A F)' n $;
--| Uniqueness: any function on `ω` satisfying the equations is `omrec A F`.
theorem omrec_unique {n: set} (G: hyps n) (A F: class) (h: set):
  $ G ⇒ isset A $ > $ G ⇒ functional F $ > $ G ⇒ functional h $ > $ G ⇒ rel h $ >
  $ G ⇒ cdm h = ω $ > $ G ⇒ h' ∅ = A $ >
  $ G ⇒ ∀ n (n ∊ ω → h' (suc n) = F' h' n) $ > $ G ⇒ h = omrec A F $;
--| @congr
theorem omrec_congr (A B F H: class):
  $ A ≐ B $ > $ F ≐ H $ > $ omrec A F ≐ omrec B H $;
theorem omrec_eq (G: hyps) (A B F H: class):
  $ G ⇒ A = B $ > $ G ⇒ F = H $ > $ G ⇒ omrec A F = omrec B H $;
--| @rewrite
theorem sb_c_omrec {x: set} (t: set x) (A F: class x):
  $ (⟦ x / t ⟧ (omrec A F)) ≐ omrec (⟦ x / t ⟧ A) (⟦ x / t ⟧ F) $;
