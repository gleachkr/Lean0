-- arith.mm0: arithmetic on `ω`, first part: the operations `nadd`, `nmul`,
-- `npow` and the truncated difference `nsub`, each by recursion on its second
-- argument (`omrec`, omega.mm0, through the graph `cgr` of the step,
-- ordinals.mm0), their defining equations, closure under `ω`, the ring laws,
-- the order `<` as `∊` and `≤` as `⊆` with its relation to `nadd`, `nmax` as
-- the union, the doubling `ndbl` with the identities the binary algorithms of
-- the spec compute with (`badd`, `baddc`, `bmul`, `bpow` in spec/lean.mm0),
-- and the facts behind the literal rules of `Nat.sub`, `Nat.beq` and
-- `Nat.ble`. Division, gcd, shifts and the bitwise operations are a later
-- file. Imports hartogs.mm0; proofs in arith.auf.
--
-- Every operation is stated for set variables; the hypotheses `a ∊ ω` are
-- those needed (the recursion equations hold for any set `a` and `b ∊ ω`).
-- The laws used at class terms (`suc a`, `nadd a b`, ...) also have class
-- forms, named `X_c` (not to be confused with the carry identities
-- `nadd_dbl_dbl_c` and the like), with premises `A ∈ ω` or `isset A`.

import "hartogs.mm0";

-- --------------------------------------------------------------------------
-- The operations
-- --------------------------------------------------------------------------

--| `a + b`, by recursion on `b`: `a + 0 = a`, `a + suc b = suc (a + b)`.
def nadd (A B: class) (.x: set): class = $ (omrec A (cgr x (suc x)))' B $;
infixl nadd: $+$ prec 64;
--| `a · b`: `a · 0 = 0`, `a · suc b = a · b + a`.
def nmul (A B: class) (.x: set): class = $ (omrec ∅ (cgr x (x + A)))' B $;
infixl nmul: $*$ prec 70;
infixl nmul: $·$ prec 70;
--| `a ^ b`: `a ^ 0 = 1`, `a ^ suc b = a ^ b · a`.
def npow (A B: class) (.x: set): class = $ (omrec (suc ∅) (cgr x (x · A)))' B $;
infixr npow: $^$ prec 75;
--| Truncated difference `a - b`: `a - 0 = a`, `a - suc b = pred (a - b)`, with
--| the predecessor of a natural number its union.
def nsub (A B: class) (.x: set): class = $ (omrec A (cgr x (⋃ x)))' B $;
--| Doubling: `A + A`.
def ndbl (A: class): class = $ A + A $;
--| The maximum of two natural numbers: their union, as for any two ordinals.
def nmax (A B: class): class = $ A ∪ B $;

--| @congr
theorem nadd_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ A + C ≐ B + D $;
theorem nadd_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ A + C = B + D $;
--| @rewrite
theorem sb_c_nadd {x: set} (t: set x) (A B: class x):
  $ ([[ x / t ]] (A + B)) ≐ ([[ x / t ]] A) + ([[ x / t ]] B) $;
--| @congr
theorem nmul_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ A · C ≐ B · D $;
theorem nmul_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ A · C = B · D $;
--| @rewrite
theorem sb_c_nmul {x: set} (t: set x) (A B: class x):
  $ ([[ x / t ]] (A · B)) ≐ ([[ x / t ]] A) · ([[ x / t ]] B) $;
--| @congr
theorem npow_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ A ^ C ≐ B ^ D $;
theorem npow_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ A ^ C = B ^ D $;
--| @rewrite
theorem sb_c_npow {x: set} (t: set x) (A B: class x):
  $ ([[ x / t ]] (A ^ B)) ≐ ([[ x / t ]] A) ^ ([[ x / t ]] B) $;
--| @congr
theorem nsub_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ nsub A C ≐ nsub B D $;
theorem nsub_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ nsub A C = nsub B D $;
--| @rewrite
theorem sb_c_nsub {x: set} (t: set x) (A B: class x):
  $ ([[ x / t ]] (nsub A B)) ≐ nsub ([[ x / t ]] A) ([[ x / t ]] B) $;
--| @congr
theorem ndbl_congr (A B: class): $ A ≐ B $ > $ ndbl A ≐ ndbl B $;
theorem ndbl_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ ndbl A = ndbl B $;
--| @rewrite
theorem sb_c_ndbl {x: set} (t: set x) (A: class x):
  $ ([[ x / t ]] (ndbl A)) ≐ ndbl ([[ x / t ]] A) $;
--| @congr
theorem nmax_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ nmax A C ≐ nmax B D $;
theorem nmax_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ nmax A C = nmax B D $;
--| @rewrite
theorem sb_c_nmax {x: set} (t: set x) (A B: class x):
  $ ([[ x / t ]] (nmax A B)) ≐ nmax ([[ x / t ]] A) ([[ x / t ]] B) $;

-- --------------------------------------------------------------------------
-- Addition
-- --------------------------------------------------------------------------

theorem nadd_set (G: hyps) (a b: set): $ G ⇒ isset (a + b) $;
--| Class form of `nadd_set`.
theorem nadd_set_c (G: hyps) (A B: class): $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ isset (A + B) $;
theorem nadd_zero (G: hyps) (a: set): $ G ⇒ a + ∅ = a $;
--| Class form of `nadd_zero`.
theorem nadd_zero_c (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A + ∅ = A $;
theorem nadd_suc (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ a + suc b = suc (a + b) $;
--| Class form of `nadd_suc`.
theorem nadd_suc_c (G: hyps) (A B: class):
  $ G ⇒ isset A $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A + suc B = suc (A + B) $;
theorem nadd_omega (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a + b ∈ ω $;
--| Class form of `nadd_omega`.
theorem nadd_omega_c (G: hyps) (A B: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A + B ∈ ω $;
theorem zero_nadd (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ ∅ + a = a $;
theorem suc_nadd (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ suc a + b = suc (a + b) $;
--| Class form of `suc_nadd`.
theorem suc_nadd_c (G: hyps) (A B: class):
  $ G ⇒ isset A $ > $ G ⇒ B ∈ ω $ > $ G ⇒ suc A + B = suc (A + B) $;
theorem nadd_comm (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a + b = b + a $;
--| Class form of `nadd_comm`.
theorem nadd_comm_c (G: hyps) (A B: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A + B = B + A $;
theorem nadd_assoc (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ >
  $ G ⇒ a + b + c = a + (b + c) $;
--| Class form of `nadd_assoc`.
theorem nadd_assoc_c (G: hyps) (A B C: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ >
  $ G ⇒ A + B + C = A + (B + C) $;
theorem nadd_cancel_r (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ a + c = b + c $ > $ G ⇒ a = b $;
theorem nadd_cancel_l (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ c + a = c + b $ > $ G ⇒ a = b $;
--| Class form of `nadd_cancel_l`.
theorem nadd_cancel_l_c (G: hyps) (A B C: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ > $ G ⇒ C + A = C + B $ > $ G ⇒ A = B $;
theorem nadd_eq_zero (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a + b = ∅ $ > $ G ⇒ a = ∅ ∧ b = ∅ $;
--| Addition and the order (`a ⊆ b` is `a ≤ b`, `a ∊ b` is `a < b`).
theorem nadd_le_l (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ⊆ a + b $;
--| Class form of `nadd_le_l`.
theorem nadd_le_l_c (G: hyps) (A B: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A ⊆ A + B $;
theorem nadd_le_r (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ b ⊆ a + b $;
theorem nlt_le (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ b $ > $ G ⇒ a ⊆ b $;
theorem nadd_lt_suc (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ a + suc b $;
theorem nadd_suc_ne (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a + suc b = a $ > $ G ⇒ ⊥ $;
--| Class form of `nadd_suc_ne`.
theorem nadd_suc_ne_c (G: hyps) (A B: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A + suc B = A $ > $ G ⇒ ⊥ $;
theorem nadd_mono_lt (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ a ∊ b $ > $ G ⇒ a + c ∈ b + c $;
--| Class form of `nadd_mono_lt`.
theorem nadd_mono_lt_c (G: hyps) (A B C: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ > $ G ⇒ A ∈ B $ > $ G ⇒ A + C ∈ B + C $;
theorem nadd_mono_le (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ a ⊆ b $ > $ G ⇒ a + c ⊆ b + c $;
--| Class form of `nadd_mono_le`.
theorem nadd_mono_le_c (G: hyps) (A B C: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ > $ G ⇒ A ⊆ B $ > $ G ⇒ A + C ⊆ B + C $;
theorem nadd_lt_cancel (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ a + c ∈ b + c $ > $ G ⇒ a ∊ b $;
--| `a ≤ b` and `a < b` as the existence of a difference.
theorem nle_ex {c: set} (G: hyps c) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ⊆ b $ > $ G ⇒ ∃ c (c ∊ ω ∧ a + c = b) $;
theorem nlt_ex {c: set} (G: hyps c) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ b $ > $ G ⇒ ∃ c (c ∊ ω ∧ a + suc c = b) $;
--| The facts behind `nat_ble_lit`, `nat_ble_lit_gt`, `nat_beq_lit_lt`.
theorem nle_of_nadd (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ a + c = b $ > $ G ⇒ a ⊆ b $;
theorem nlt_of_nadd_suc (G: hyps) (a b c: set):
  $ G ⇒ c ∊ ω $ > $ G ⇒ a + suc c = b $ > $ G ⇒ a ∊ b $;
theorem not_nle_of_nadd_suc (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ b + suc c = a $ > $ G ⇒ ¬ a ⊆ b $;
theorem ne_of_nadd_suc (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ a + suc c = b $ > $ G ⇒ ¬ a = b $;

-- --------------------------------------------------------------------------
-- Doubling and the digit identities of binary addition
-- --------------------------------------------------------------------------

theorem ndbl_omega (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ ndbl a ∈ ω $;
theorem ndbl_zero (G: hyps): $ G ⇒ ndbl ∅ = ∅ $;
theorem ndbl_suc (G: hyps) (a: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ ndbl (suc a) = suc (suc (ndbl a)) $;
--| Class form of `ndbl_suc`.
theorem ndbl_suc_c (G: hyps) (A: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ ndbl (suc A) = suc (suc (ndbl A)) $;
theorem ndbl_nadd (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ ndbl (a + b) = ndbl a + ndbl b $;
--| `2a + (2b + 1) = 2(a + b) + 1`, `(2a + 1) + 2b = 2(a + b) + 1`,
--| `(2a + 1) + (2b + 1) = 2(a + b + 1)`; and with a carry.
theorem nadd_dbl_dbl1 (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ ndbl a + suc (ndbl b) = suc (ndbl (a + b)) $;
theorem nadd_dbl1_dbl (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ suc (ndbl a) + ndbl b = suc (ndbl (a + b)) $;
theorem nadd_dbl1_dbl1 (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ >
  $ G ⇒ suc (ndbl a) + suc (ndbl b) = ndbl (suc (a + b)) $;
theorem nadd_dbl_dbl_c (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ suc (ndbl a + ndbl b) = suc (ndbl (a + b)) $;
theorem nadd_dbl_dbl1_c (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ >
  $ G ⇒ suc (ndbl a + suc (ndbl b)) = ndbl (suc (a + b)) $;
theorem nadd_dbl1_dbl_c (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ >
  $ G ⇒ suc (suc (ndbl a) + ndbl b) = ndbl (suc (a + b)) $;
theorem nadd_dbl1_dbl1_c (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ >
  $ G ⇒ suc (suc (ndbl a) + suc (ndbl b)) = suc (ndbl (suc (a + b))) $;
--| Parity: doubling is injective and never a successor of a double.
theorem ndbl_inj (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ ndbl a = ndbl b $ > $ G ⇒ a = b $;
theorem ndbl_ne_suc_ndbl (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ ndbl a = suc (ndbl b) $ > $ G ⇒ ⊥ $;
theorem ndbl_eq_zero (G: hyps) (a: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ ndbl a = ∅ $ > $ G ⇒ a = ∅ $;
--| `two` is the ordinal `2`.
theorem two_eq_suc (G: hyps): $ G ⇒ two = suc (suc ∅) $;

-- --------------------------------------------------------------------------
-- Multiplication and exponentiation
-- --------------------------------------------------------------------------

theorem nmul_set (G: hyps) (a b: set): $ G ⇒ isset (a · b) $;
--| Class form of `nmul_set`.
theorem nmul_set_c (G: hyps) (A B: class): $ G ⇒ isset B $ > $ G ⇒ isset (A · B) $;
theorem nmul_zero (G: hyps) (a: set): $ G ⇒ a · ∅ = ∅ $;
--| Class form of `nmul_zero`.
theorem nmul_zero_c (G: hyps) (A: class): $ G ⇒ A · ∅ = ∅ $;
theorem nmul_suc (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ a · suc b = a · b + a $;
--| Class form of `nmul_suc`.
theorem nmul_suc_c (G: hyps) (A B: class):
  $ G ⇒ isset A $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A · suc B = A · B + A $;
theorem nmul_omega (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a · b ∈ ω $;
--| Class form of `nmul_omega`.
theorem nmul_omega_c (G: hyps) (A B: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A · B ∈ ω $;
theorem zero_nmul (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ ∅ · a = ∅ $;
theorem nmul_one (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ a · suc ∅ = a $;
--| Class form of `nmul_one`.
theorem nmul_one_c (G: hyps) (A: class): $ G ⇒ A ∈ ω $ > $ G ⇒ A · suc ∅ = A $;
theorem one_nmul (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ suc ∅ · a = a $;
theorem suc_nmul (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ suc a · b = a · b + b $;
theorem nmul_comm (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a · b = b · a $;
--| Class form of `nmul_comm`.
theorem nmul_comm_c (G: hyps) (A B: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A · B = B · A $;
theorem nmul_nadd (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ >
  $ G ⇒ a · (b + c) = a · b + a · c $;
--| Class form of `nmul_nadd`.
theorem nmul_nadd_c (G: hyps) (A B C: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ >
  $ G ⇒ A · (B + C) = A · B + A · C $;
theorem nadd_nmul (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ >
  $ G ⇒ (a + b) · c = a · c + b · c $;
theorem nmul_assoc (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ >
  $ G ⇒ a · b · c = a · (b · c) $;
--| Class form of `nmul_assoc`.
theorem nmul_assoc_c (G: hyps) (A B C: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ C ∈ ω $ >
  $ G ⇒ A · B · C = A · (B · C) $;
--| The digit identities of `bmul`: `a · 2b = 2(a · b)`, `a · (2b + 1) = 2(a · b) + a`.
theorem nmul_dbl (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a · ndbl b = ndbl (a · b) $;
theorem nmul_dbl1 (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a · suc (ndbl b) = ndbl (a · b) + a $;
theorem nmul_two (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ a · two = ndbl a $;
theorem nmul_eq_zero (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a · b = ∅ $ > $ G ⇒ a = ∅ ∨ b = ∅ $;
theorem nmul_mono_le (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ a ⊆ b $ > $ G ⇒ a · c ⊆ b · c $;
theorem nmul_mono_lt (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ ∅ ∈ c $ > $ G ⇒ a ∊ b $ >
  $ G ⇒ a · c ∈ b · c $;
theorem nmul_cancel (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ ∅ ∈ c $ > $ G ⇒ a · c = b · c $ >
  $ G ⇒ a = b $;

theorem npow_set (G: hyps) (a b: set): $ G ⇒ isset (a ^ b) $;
theorem npow_zero (G: hyps) (a: set): $ G ⇒ a ^ ∅ = suc ∅ $;
theorem npow_suc (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ a ^ suc b = a ^ b · a $;
--| Class form of `npow_suc`.
theorem npow_suc_c (G: hyps) (A B: class):
  $ G ⇒ isset A $ > $ G ⇒ B ∈ ω $ > $ G ⇒ A ^ suc B = A ^ B · A $;
theorem npow_omega (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ^ b ∈ ω $;
theorem npow_one (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ a ^ suc ∅ = a $;
theorem npow_nadd (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ >
  $ G ⇒ a ^ (b + c) = a ^ b · a ^ c $;
--| The digit identities of `bpow`: `a ^ 2b = (a ^ b) · (a ^ b)`,
--| `a ^ (2b + 1) = (a ^ b) · (a ^ b) · a`.
theorem npow_dbl (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ^ ndbl b = a ^ b · a ^ b $;
theorem npow_dbl1 (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ >
  $ G ⇒ a ^ suc (ndbl b) = a ^ b · a ^ b · a $;

-- --------------------------------------------------------------------------
-- Predecessor, truncated difference, maximum
-- --------------------------------------------------------------------------

--| The predecessor of a natural number is its union.
theorem cuni_omega (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ ⋃ a ∈ ω $;
--| Class form of `cuni_omega`.
theorem cuni_omega_c (G: hyps) (A: class): $ G ⇒ A ∈ ω $ > $ G ⇒ ⋃ A ∈ ω $;
theorem cuni_suc_omega (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ ⋃ (suc a) = a $;
theorem nsub_set (G: hyps) (a b: set): $ G ⇒ isset (nsub a b) $;
--| Class form of `nsub_set`.
theorem nsub_set_c (G: hyps) (A B: class): $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ isset (nsub A B) $;
theorem nsub_zero (G: hyps) (a: set): $ G ⇒ nsub a ∅ = a $;
--| Class form of `nsub_zero`.
theorem nsub_zero_c (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ nsub A ∅ = A $;
theorem nsub_suc (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ nsub a (suc b) = ⋃ (nsub a b) $;
--| Class form of `nsub_suc`.
theorem nsub_suc_c (G: hyps) (A B: class):
  $ G ⇒ isset A $ > $ G ⇒ B ∈ ω $ > $ G ⇒ nsub A (suc B) = ⋃ (nsub A B) $;
theorem nsub_omega (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ nsub a b ∈ ω $;
theorem suc_nsub_suc (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ nsub (suc a) (suc b) = nsub a b $;
--| Class form of `suc_nsub_suc`.
theorem suc_nsub_suc_c (G: hyps) (A B: class):
  $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ nsub (suc A) (suc B) = nsub A B $;
theorem zero_nsub (G: hyps) (b: set): $ G ⇒ b ∊ ω $ > $ G ⇒ nsub ∅ b = ∅ $;
--| The facts behind `nat_sub_lit` and `nat_sub_lit0`: `(c + b) - b = c`, and
--| `a - b = 0` when `a ≤ b`.
theorem nsub_nadd (G: hyps) (b c: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ nsub (c + b) b = c $;
theorem nsub_eq_zero (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ⊆ b $ > $ G ⇒ nsub a b = ∅ $;
theorem nsub_le (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ nsub a b ⊆ a $;
theorem nadd_nsub (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ b ⊆ a $ > $ G ⇒ nsub a b + b = a $;

theorem nmax_eq_l (G: hyps) (a b: set): $ G ⇒ b ⊆ a $ > $ G ⇒ nmax a b = a $;
theorem nmax_eq_r (G: hyps) (a b: set): $ G ⇒ a ⊆ b $ > $ G ⇒ nmax a b = b $;
--| Class form of `nmax_eq_l`.
theorem nmax_eq_l_c (G: hyps) (A B: class): $ G ⇒ B ⊆ A $ > $ G ⇒ nmax A B = A $;
--| Class form of `nmax_eq_r`.
theorem nmax_eq_r_c (G: hyps) (A B: class): $ G ⇒ A ⊆ B $ > $ G ⇒ nmax A B = B $;
theorem nmax_cases (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ nmax a b = a ∨ nmax a b = b $;
theorem nmax_omega (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ nmax a b ∈ ω $;
--| Class form of `nmax_omega`.
theorem nmax_omega_c (G: hyps) (A B: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ nmax A B ∈ ω $;
theorem nmax_le_l (G: hyps) (a b: set): $ G ⇒ a ⊆ nmax a b $;
theorem nmax_le_r (G: hyps) (a b: set): $ G ⇒ b ⊆ nmax a b $;
theorem nmax_least (G: hyps) (a b c: set):
  $ G ⇒ a ⊆ c $ > $ G ⇒ b ⊆ c $ > $ G ⇒ nmax a b ⊆ c $;
theorem nmax_comm (G: hyps) (a b: set): $ G ⇒ nmax a b = nmax b a $;
--| Class form of `nmax_comm`.
theorem nmax_comm_c (G: hyps) (A B: class): $ G ⇒ nmax A B = nmax B A $;

-- --------------------------------------------------------------------------
-- The order on ω
-- --------------------------------------------------------------------------

theorem nlt_suc_le (G: hyps) (a b: set):
  $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ suc b $ > $ G ⇒ a ⊆ b $;
theorem nle_lt_suc (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ⊆ b $ > $ G ⇒ a ∊ suc b $;
theorem nle_lt_or_eq (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ⊆ b $ > $ G ⇒ a ∊ b ∨ a = b $;
theorem nlt_or_le (G: hyps) (a b: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ a ∊ b ∨ b ⊆ a $;
theorem nlt_not_le (G: hyps) (a b: set): $ G ⇒ a ∊ b $ > $ G ⇒ b ⊆ a $ > $ G ⇒ ⊥ $;
theorem nlt_le_trans (G: hyps) (a b c: set):
  $ G ⇒ a ∊ b $ > $ G ⇒ b ⊆ c $ > $ G ⇒ a ∊ c $;
theorem nle_lt_trans (G: hyps) (a b c: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ c ∊ ω $ > $ G ⇒ a ⊆ b $ > $ G ⇒ b ∊ c $ > $ G ⇒ a ∊ c $;
theorem nzero_lt_suc (G: hyps) (a: set): $ G ⇒ a ∊ ω $ > $ G ⇒ ∅ ∈ suc a $;
--| Class form of `nzero_lt_suc`.
theorem nzero_lt_suc_c (G: hyps) (A: class): $ G ⇒ A ∈ ω $ > $ G ⇒ ∅ ∈ suc A $;
--| A natural number with an element is positive.
theorem nzero_lt (G: hyps) (b r: set): $ G ⇒ b ∊ ω $ > $ G ⇒ r ∊ b $ > $ G ⇒ ∅ ∈ b $;
theorem nlt_zero_ex {y: set} (G: hyps y) (a: set):
  $ G ⇒ a ∊ ω $ > $ G ⇒ ∅ ∈ a $ > $ G ⇒ ∃ y (y ∊ ω ∧ a = suc y) $;
