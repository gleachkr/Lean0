l14: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l15: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l16: $ x ∊ lvals ⇒ lv (enc_lvl (limax a b)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl b) x) $ by lv_limax [l14, l15, l1]
l17: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l18: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l19: $ x ∊ lvals ⇒ lv (enc_lvl (limax a c)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x) $ by lv_limax [l17, l18, l1]
l20: $ x ∊ lvals ⇒ nmax (lv (enc_lvl (limax a b)) x) (lv (enc_lvl (limax a c)) x) = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) $ by nmax_eq [l16, l19]
l21: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (limax a b) (limax a c))) x = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) $ by eq_trans [l13, l20]
l22: $ x ∊ lvals ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l23: $ x ∊ lvals ⇒ lv (enc_lvl b) x ∈ ω $ by k6_lvo [l1]
l24: $ x ∊ lvals ⇒ lv (enc_lvl c) x ∈ ω $ by k6_lvo [l1]
l25: $ x ∊ lvals ⇒ nimax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) $ by nimax_nmax_c [l22, l23, l24]
l26: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (lmax b c))) x = lv (enc_lvl (lmax (limax a b) (limax a c))) x $ by k6_eq3 [l10, l21, l25]
l27: $ leqv (limax a (lmax b c)) (lmax (limax a b) (limax a c)) $ by leqv_i [l26]

limax_imax
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl (limax b c) ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (limax b c))) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl (limax b c)) x) $ by lv_limax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l7: $ x ∊ lvals ⇒ lv (enc_lvl (limax b c)) x = nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x) $ by lv_limax [l5, l6, l1]
l8: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l9: $ x ∊ lvals ⇒ nimax (lv (enc_lvl a) x) (lv (enc_lvl (limax b c)) x) = nimax (lv (enc_lvl a) x) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nimax_eq [l8, l7]
l10: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (limax b c))) x = nimax (lv (enc_lvl a) x) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by eq_trans [l4, l9]
l11: $ x ∊ lvals ⇒ enc_lvl (limax a c) ∈ trees ω $ by enc_lvl_trees
l12: $ x ∊ lvals ⇒ enc_lvl (limax b c) ∈ trees ω $ by enc_lvl_trees
l13: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (limax a c) (limax b c))) x = nmax (lv (enc_lvl (limax a c)) x) (lv (enc_lvl (limax b c)) x) $ by lv_lmax [l11, l12, l1]
l14: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l15: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l16: $ x ∊ lvals ⇒ lv (enc_lvl (limax a c)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x) $ by lv_limax [l14, l15, l1]
l17: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l18: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l19: $ x ∊ lvals ⇒ lv (enc_lvl (limax b c)) x = nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x) $ by lv_limax [l17, l18, l1]
l20: $ x ∊ lvals ⇒ nmax (lv (enc_lvl (limax a c)) x) (lv (enc_lvl (limax b c)) x) = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nmax_eq [l16, l19]
l21: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (limax a c) (limax b c))) x = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by eq_trans [l13, l20]
l22: $ x ∊ lvals ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l23: $ x ∊ lvals ⇒ lv (enc_lvl b) x ∈ ω $ by k6_lvo [l1]
l24: $ x ∊ lvals ⇒ lv (enc_lvl c) x ∈ ω $ by k6_lvo [l1]
l25: $ x ∊ lvals ⇒ nimax (lv (enc_lvl a) x) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) = nmax (nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x)) (nimax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nimax_nimax_c [l22, l23, l24]
l26: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (limax b c))) x = lv (enc_lvl (lmax (limax a c) (limax b c))) x $ by k6_eq3 [l10, l21, l25]
l27: $ leqv (limax a (limax b c)) (lmax (limax a c) (limax b c)) $ by leqv_i [l26]

lemma k6_lc0 (G: hyps) (n: nat) (l l0: lvl) (x k: set):
  $ lsubst n l lz l0 $ > $ G ⇒ x ∊ lvals $ > $ G ⇒ k = fv nvf (enc_nat n) $ >
  $ G ⇒ ap x k = ∅ $ > $ G ⇒ k ∊ ω $ >
  $ G ⇒ lv (enc_lvl l0) x = lv (enc_lvl l) x $
----
l1: $ G ⇒ lv (enc_lvl l0) x = lv (enc_lvl l) (lupd x (fv nvf (enc_nat n)) (lv (enc_lvl lz) x)) $ by lsubst_sem [#1, #2]
l2: $ G ⇒ x = x $ by eq_refl
l3: $ G ⇒ fv nvf (enc_nat n) = k $ by eq_sym [#3]
l4: $ G ⇒ lv (enc_lvl lz) x = ∅ $ by lv_lz
l5: $ G ⇒ ∅ = ap x k $ by eq_sym [#4]
l6: $ G ⇒ lv (enc_lvl lz) x = ap x k $ by eq_trans [l4, l5]
l7: $ G ⇒ lupd x (fv nvf (enc_nat n)) (lv (enc_lvl lz) x) = lupd x k (ap x k) $ by lupd_eq [l2, l3, l6]
l8: $ G ⇒ lupd x k (ap x k) = x $ by lupd_self [#2, #5]
l9: $ G ⇒ lupd x (fv nvf (enc_nat n)) (lv (enc_lvl lz) x) = x $ by eq_trans [l7, l8]
l10: $ G ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l11: $ G ⇒ lv (enc_lvl l) (lupd x (fv nvf (enc_nat n)) (lv (enc_lvl lz) x)) = lv (enc_lvl l) x $ by lv_eq [l10, l9]
l12: $ G ⇒ lv (enc_lvl l0) x = lv (enc_lvl l) x $ by eq_trans [l1, l11]

lemma k6_lcs1 (G: hyps) (n: nat) (l l1: lvl) (x k j m t: set):
  $ lsubst n l (ls (lparam n)) l1 $ > $ G ⇒ x ∊ lvals $ > $ G ⇒ k = fv nvf (enc_nat n) $ >
  $ G ⇒ ap x k = j $ > $ G ⇒ j = suc m $ > $ G ⇒ k ∊ ω $ > $ G ⇒ t = lupd x k m $ >
  $ G ⇒ t ∊ lvals $ >
  $ G ⇒ lv (enc_lvl l1) t = lv (enc_lvl l) x $
----
l1: $ G ⇒ lv (enc_lvl l1) t = lv (enc_lvl l) (lupd t (fv nvf (enc_nat n)) (lv (enc_lvl (ls (lparam n))) t)) $ by lsubst_sem [#1, #8]
l2: $ G ⇒ enc_lvl (lparam n) ∈ trees ω $ by enc_lvl_trees
l3: $ G ⇒ lv (enc_lvl (ls (lparam n))) t = suc (lv (enc_lvl (lparam n)) t) $ by lv_ls [l2, #8]
l4: $ G ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l5: $ G ⇒ lv (enc_lvl (lparam n)) t = ap t (fv nvf (enc_nat n)) $ by lv_lparam [l4, #8]
l6: $ G ⇒ fv nvf (enc_nat n) = k $ by eq_sym [#3]
l7: $ G ⇒ ap t (fv nvf (enc_nat n)) = ap (lupd x k m) k $ by ap_eq [#7, l6]
l8: $ G ⇒ ap (lupd x k m) k = m $ by lupd_ap_eq [#6]
l9: $ G ⇒ ap t (fv nvf (enc_nat n)) = m $ by eq_trans [l7, l8]
l10: $ G ⇒ lv (enc_lvl (lparam n)) t = m $ by eq_trans [l5, l9]
l11: $ G ⇒ suc (lv (enc_lvl (lparam n)) t) = suc m $ by suc_eq [l10]
l12: $ G ⇒ suc m = j $ by eq_sym [#5]
l13: $ G ⇒ suc (lv (enc_lvl (lparam n)) t) = j $ by eq_trans [l11, l12]
l14: $ G ⇒ lv (enc_lvl (ls (lparam n))) t = j $ by eq_trans [l3, l13]
l15: $ G ⇒ lupd t (fv nvf (enc_nat n)) (lv (enc_lvl (ls (lparam n))) t) = lupd (lupd x k m) k j $ by lupd_eq [#7, l6, l14]
l16: $ G ⇒ lupd (lupd x k m) k j = lupd x k j $ by lupd_twice
l17: $ G ⇒ x = x $ by eq_refl
l18: $ G ⇒ k = k $ by eq_refl
l19: $ G ⇒ j = ap x k $ by eq_sym [#4]
l20: $ G ⇒ lupd x k j = lupd x k (ap x k) $ by lupd_eq [l17, l18, l19]
l21: $ G ⇒ lupd x k (ap x k) = x $ by lupd_self [#2, #6]
l22: $ G ⇒ lupd x k j = x $ by eq_trans [l20, l21]
l23: $ G ⇒ lupd (lupd x k m) k j = x $ by eq_trans [l16, l22]
l24: $ G ⇒ lupd t (fv nvf (enc_nat n)) (lv (enc_lvl (ls (lparam n))) t) = x $ by eq_trans [l15, l23]
l25: $ G ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l26: $ G ⇒ lv (enc_lvl l) (lupd t (fv nvf (enc_nat n)) (lv (enc_lvl (ls (lparam n))) t)) = lv (enc_lvl l) x $ by lv_eq [l25, l24]
l27: $ G ⇒ lv (enc_lvl l1) t = lv (enc_lvl l) x $ by eq_trans [l1, l26]

lemma k6_lcs (G: hyps) (n: nat) (l r l1 r1: lvl) (x k j m: set):
  $ lsubst n l (ls (lparam n)) l1 $ > $ lsubst n r (ls (lparam n)) r1 $ > $ leqv l1 r1 $ >
  $ G ⇒ x ∊ lvals $ > $ G ⇒ k = fv nvf (enc_nat n) $ > $ G ⇒ ap x k = j $ > $ G ⇒ j = suc m $ >
  $ G ⇒ k ∊ ω $ > $ G ⇒ m ∊ ω $ >
  $ G ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $
----
l1: $ G ⇒ lupd x k m ∈ lvals $ by lupd_lvals [#4, #9]
l2: $ G , t = lupd x k m , t ∊ lvals ⇒ x ∊ lvals $ by weaken [#4]
l3: $ G , t = lupd x k m , t ∊ lvals ⇒ k = fv nvf (enc_nat n) $ by weaken [#5]
l4: $ G , t = lupd x k m , t ∊ lvals ⇒ ap x k = j $ by weaken [#6]
l5: $ G , t = lupd x k m , t ∊ lvals ⇒ j = suc m $ by weaken [#7]
l6: $ G , t = lupd x k m , t ∊ lvals ⇒ k ∊ ω $ by weaken [#8]
l7: $ G , t = lupd x k m , t ∊ lvals ⇒ t = lupd x k m $ by ax
l8: $ G , t = lupd x k m , t ∊ lvals ⇒ t ∊ lvals $ by ax
l9: $ G , t = lupd x k m , t ∊ lvals ⇒ lv (enc_lvl l1) t = lv (enc_lvl l) x $ by k6_lcs1 [#1, l2, l3, l4, l5, l6, l7, l8]
l10: $ G , t = lupd x k m , t ∊ lvals ⇒ lv (enc_lvl r1) t = lv (enc_lvl r) x $ by k6_lcs1 [#2, l2, l3, l4, l5, l6, l7, l8]
l11: $ G , t = lupd x k m , t ∊ lvals ⇒ lv (enc_lvl l1) t = lv (enc_lvl r1) t $ by leqv_e [#3, l8]
l12: $ G , t = lupd x k m , t ∊ lvals ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by k6_eq3s [l9, l10, l11]
l13: $ G ⇒ lv (enc_lvl l) x = lv (enc_lvl r) x $ by wcel_elim [l1, l12]

leqv_cases
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l3: $ x ∊ lvals ⇒ isset (enc_nat n) $ by wcel_isset [l2]
l4: $ x ∊ lvals ⇒ fv nvf (enc_nat n) ∈ ω $ by nvf_omega [l3]
l5: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω ⇒ x ∊ lvals $ by ax
l6: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω ⇒ k ∊ ω $ by ax
l7: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω ⇒ ap x k ∈ ω $ by lvals_ap [l5, l6]
l8: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω ⇒ j ∊ ω $ by ax
l9: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω ⇒ j = ∅ ∨ ∃ y (y ∊ ω ∧ j = suc y) $ by omega_cases [l8]
l10: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ x ∊ lvals $ by ax
l11: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ k = fv nvf (enc_nat n) $ by ax
l12: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ k ∊ ω $ by ax
l13: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ j = ap x k $ by ax
l14: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ j = ∅ $ by ax
l15: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ ap x k = j $ by eq_sym [l13]
l16: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ ap x k = ∅ $ by eq_trans [l15, l14]
l17: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ lv (enc_lvl l0) x = lv (enc_lvl l) x $ by k6_lc0 [#1, l10, l11, l16, l12]
l18: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ lv (enc_lvl r0) x = lv (enc_lvl r) x $ by k6_lc0 [#2, l10, l11, l16, l12]
l19: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , j = ∅ ⇒ lv (enc_lvl l0) x = lv (enc_lvl r0) x $ by leqv_e [#3, l10]
