l9: $ x ∊ lvals ⇒ lv (enc_lvl (ls lz)) x = suc ∅ $ by eq_trans [l6, l8]
l10: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l11: $ x ∊ lvals ⇒ nimax (lv (enc_lvl (ls lz)) x) (lv (enc_lvl a) x) = nimax (suc ∅) (lv (enc_lvl a) x) $ by nimax_eq [l9, l10]
