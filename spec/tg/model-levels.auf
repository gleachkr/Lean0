z6: $ G ⇒ fv nvf t1 ⊆ fv nvf t2 $ by imp_elim [z5, #1]

--| The trees `x` whose numbers add up in every derivable `add y x w`.
def k3_addp (.x .y .w: set): class = $ {x | ∀ y ∀ w (⟨ kr_add , scons y (scons x (scons w ∅)) ⟩ ∈ lrel → fv nvf w = nadd (fv nvf y) (fv nvf x))} $

