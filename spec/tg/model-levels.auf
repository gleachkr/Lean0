f5: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nimax a (nmax b c) = nmax a (nmax b c) $ by k1_nimax_wpos_c [f4]
f6: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nimax a b = nmax a b $ by k1_nimax_wpos_c [f1]
f7: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nimax a c = nmax a c $ by k1_nimax_wpos_c [f2]
f8: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nmax (nimax a b) (nimax a c) = nmax (nmax a b) (nmax a c) $ by nmax_eq [f6, f7]
f9: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nmax a (nmax b c) = nmax (nmax a b) (nmax a c) $ by k1_cun_distr
f10: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nmax (nmax a b) (nmax a c) = nmax (nimax a b) (nimax a c) $ by eq_sym [f8]
f11: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nimax a (nmax b c) = nmax (nmax a b) (nmax a c) $ by eq_trans [f5, f9]
f12: $ G , ∅ ∈ b , ∅ ∈ c ⇒ nimax a (nmax b c) = nmax (nimax a b) (nimax a c) $ by eq_trans [f11, f10]
g1: $ G , ∅ ∈ b ⇒ ∅ ∈ c ∨ ∅ = c $ by weaken [l2]
g2: $ G , ∅ ∈ b ⇒ nimax a (nmax b c) = nmax (nimax a b) (nimax a c) $ by or_elim [g1, f12, d14]
l3: $ G ⇒ nimax a (nmax b c) = nmax (nimax a b) (nimax a c) $ by or_elim [l1, g2, b14]

