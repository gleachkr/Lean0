leqv_inst
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ lv (enc_lvl l2) x = lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) $ by linst_sem [#2, l1]
l3: $ x ∊ lvals ⇒ lv (enc_lvl r2) x = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by linst_sem [#3, l1]
l4: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ y = lsv (enc_lvls S) x $ by ax
l5: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ lsub y = lsub (lsv (enc_lvls S) x) $ by lsub_eq [l4]
l6: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ z = lsub y $ by ax
l7: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ z = lsub (lsv (enc_lvls S) x) $ by eq_trans [l6, l5]
l8: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ z ∊ lvals $ by ax
l9: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ lv (enc_lvl l) z = lv (enc_lvl r) z $ by leqv_e [#1, l8]
l10: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l11: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ lv (enc_lvl l) z = lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) $ by lv_eq [l10, l7]
l12: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ enc_lvl r = enc_lvl r $ by eq_refl
l13: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ lv (enc_lvl r) z = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by lv_eq [l12, l7]
l14: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω , z = lsub y , z ∊ lvals ⇒ lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by k6_eq3s [l11, l13, l9]
l15: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω ⇒ y ∊ fseq ω $ by ax
l16: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω ⇒ lsub y ∈ lvals $ by lsub_lvals [l15]
l17: $ x ∊ lvals , y = lsv (enc_lvls S) x , y ∊ fseq ω ⇒ lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by wcel_elim [l16, l14]
l18: $ x ∊ lvals ⇒ enc_lvls S ∈ trees ω $ by enc_lvls_trees
l19: $ x ∊ lvals ⇒ isset (enc_lvls S) $ by wcel_isset [l18]
l20: $ x ∊ lvals ⇒ lsv (enc_lvls S) x ∈ fseq ω $ by lsv_fseq [l19, l1]
l21: $ x ∊ lvals ⇒ lv (enc_lvl l) (lsub (lsv (enc_lvls S) x)) = lv (enc_lvl r) (lsub (lsv (enc_lvls S) x)) $ by wcel_elim [l20, l17]
l22: $ x ∊ lvals ⇒ lv (enc_lvl l2) x = lv (enc_lvl r2) x $ by k6_eq3 [l2, l3, l21]
