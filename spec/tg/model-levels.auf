l10: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (lmax b c))) x = nimax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by eq_trans [l4, l9]
l11: $ x ∊ lvals ⇒ enc_lvl (limax a b) ∈ trees ω $ by enc_lvl_trees
