l5: $ G , i ∊ ω , i = n ⇒ {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap (lupd w n x) i)} = {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap w i)} $ by eq_trans [l2, l4]
l6: $ G , i ∊ ω , ¬ i = n ⇒ ¬ i = n $ by ax
l7: $ G , i ∊ ω , ¬ i = n ⇒ {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap (lupd w n x) i)} = ap (lupd w n x) i $ by k2_upd_ne [l6]
l8: $ G , i ∊ ω , ¬ i = n ⇒ i ∊ ω $ by ax
l9: $ G , i ∊ ω , ¬ i = n ⇒ ap (lupd w n x) i = ap w i $ by lupd_ap_ne [l8, l6]
l10: $ G , i ∊ ω , ¬ i = n ⇒ {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap w i)} = ap w i $ by k2_upd_ne [l6]
l11: $ G , i ∊ ω , ¬ i = n ⇒ ap w i = {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap w i)} $ by eq_sym [l10]
l12: $ G , i ∊ ω , ¬ i = n ⇒ {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap (lupd w n x) i)} = ap w i $ by eq_trans [l7, l9]
l13: $ G , i ∊ ω , ¬ i = n ⇒ {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap (lupd w n x) i)} = {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap w i)} $ by eq_trans [l12, l11]
l14: $ G , i ∊ ω ⇒ i = n ∨ ¬ i = n $ by excluded_middle
l15: $ G , i ∊ ω ⇒ {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap (lupd w n x) i)} = {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap w i)} $ by or_elim [l14, l5, l13]
l16: $ G ⇒ i ∊ ω → {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap (lupd w n x) i)} = {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap w i)} $ by imp_intro [l15]
l17: $ G ⇒ ∀ i (i ∊ ω → {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap (lupd w n x) i)} = {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap w i)}) $ by all_intro [l16]
l18: $ G ⇒ clam i ω {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap (lupd w n x) i)} = clam i ω {z | (i = n ∧ z ∊ y) ∨ (¬ i = n ∧ z ∊ ap w i)} $ by clam_eq_body [l17]

