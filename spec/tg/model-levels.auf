l6: $ x ∊ lvals ⇒ lv (enc_lvl (ls lz)) x = suc (lv (enc_lvl lz) x) $ by lv_ls [l5, l1]
l7: $ x ∊ lvals ⇒ lv (enc_lvl lz) x = ∅ $ by lv_lz
