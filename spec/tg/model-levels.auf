lt_sem
------
l1: $ G ⇒ fv nvf ⟨ kc_s , scons (enc_nat i) ∅ ⟩ ⊆ fv nvf (enc_nat n) $ by le_sem [#1]
l2: $ G ⇒ enc_nat i ∈ trees ω $ by enc_nat_trees
l3: $ G ⇒ fv nvf ⟨ kc_s , scons (enc_nat i) ∅ ⟩ = suc (fv nvf (enc_nat i)) $ by nvf_s [l2]
l4: $ G ⇒ suc (fv nvf (enc_nat i)) ⊆ fv nvf (enc_nat n) $ by subset_eq_l [l3, l1]
l5a: $ G ⇒ functional nvf $ by nvf_functional
l5b: $ G ⇒ isset (enc_nat i) $ by wcel_isset [l2]
l5: $ G ⇒ isset (fv nvf (enc_nat i)) $ by fv_set_c [l5a, l5b]
l6: $ G ⇒ fv nvf (enc_nat i) ∈ suc (fv nvf (enc_nat i)) $ by suc_mem [l5]
l7: $ G ⇒ fv nvf (enc_nat i) ∈ fv nvf (enc_nat n) $ by wcel_subset [l4, l6]

add_sem
-------
l1: $ G ⇒ ra_add (enc_nat i) (enc_nat n) (enc_nat j) ∈ lrel $ by weaken [#1]
l2: $ G ⇒ enc_nat i ∈ trees ω $ by enc_nat_trees
l3: $ G ⇒ isset (enc_nat i) $ by wcel_isset [l2]
l4: $ G ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l5: $ G ⇒ isset (enc_nat n) $ by wcel_isset [l4]
l6: $ G ⇒ enc_nat j ∈ trees ω $ by enc_nat_trees
l7: $ G ⇒ isset (enc_nat j) $ by wcel_isset [l6]
h1: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ a = enc_nat i $ by ax
h2: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ b = enc_nat n $ by ax
h2c: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ c = enc_nat j $ by ax
h3: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ ∅ = ∅ $ by eq_refl
h4a: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ scons c ∅ = scons (enc_nat j) ∅ $ by scons_eq [h2c, h3]
h4: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ scons b (scons c ∅) = scons (enc_nat n) (scons (enc_nat j) ∅) $ by scons_eq [h2, h4a]
h5: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ scons a (scons b (scons c ∅)) = scons (enc_nat i) (scons (enc_nat n) (scons (enc_nat j) ∅)) $ by scons_eq [h1, h4]
h6: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ kr_add = kr_add $ by eq_refl
h7: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ ⟨ kr_add , scons a (scons b (scons c ∅)) ⟩ = ⟨ kr_add , scons (enc_nat i) (scons (enc_nat n) (scons (enc_nat j) ∅)) ⟩ $ by opair_eq [h6, h5]
h8: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ ⟨ kr_add , scons (enc_nat i) (scons (enc_nat n) (scons (enc_nat j) ∅)) ⟩ = ⟨ kr_add , scons a (scons b (scons c ∅)) ⟩ $ by eq_sym [h7]
h9: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ ⟨ kr_add , scons (enc_nat i) (scons (enc_nat n) (scons (enc_nat j) ∅)) ⟩ ∈ lrel $ by weaken [l1]
h10: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ ⟨ kr_add , scons a (scons b (scons c ∅)) ⟩ ∈ lrel $ by wcel_eq_l [h8, h9]
h11: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ fv nvf c = nadd (fv nvf a) (fv nvf b) $ by lrel_add_sem [h10]
h12a: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ nvf = nvf $ by eq_refl
h12: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ fv nvf a = fv nvf (enc_nat i) $ by fv_eq [h12a, h1]
h13: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ fv nvf b = fv nvf (enc_nat n) $ by fv_eq [h12a, h2]
h13c: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ fv nvf c = fv nvf (enc_nat j) $ by fv_eq [h12a, h2c]
h14: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ nadd (fv nvf a) (fv nvf b) = nadd (fv nvf (enc_nat i)) (fv nvf (enc_nat n)) $ by nadd_eq [h12, h13]
h15: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ fv nvf (enc_nat j) = fv nvf c $ by eq_sym [h13c]
h16: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ fv nvf (enc_nat j) = nadd (fv nvf a) (fv nvf b) $ by eq_trans [h15, h11]
h17: $ G , a = enc_nat i , b = enc_nat n , c = enc_nat j ⇒ fv nvf (enc_nat j) = nadd (fv nvf (enc_nat i)) (fv nvf (enc_nat n)) $ by eq_trans [h16, h14]
h18: $ G , a = enc_nat i , b = enc_nat n ⇒ fv nvf (enc_nat j) = nadd (fv nvf (enc_nat i)) (fv nvf (enc_nat n)) $ by isset_elim [l7, h17]
h19: $ G , a = enc_nat i ⇒ fv nvf (enc_nat j) = nadd (fv nvf (enc_nat i)) (fv nvf (enc_nat n)) $ by isset_elim [l5, h18]
h20: $ G ⇒ fv nvf (enc_nat j) = nadd (fv nvf (enc_nat i)) (fv nvf (enc_nat n)) $ by isset_elim [l3, h19]

lvb_congr
---------
l0: $ ∅ ≐ ∅ $ by ceqt_refl
l1: $ fv E ∅ ≐ fv F ∅ $ by fv_congr [#3, l0]
l2: $ cv x ≐ cv x $ by ceqt_refl
l3: $ ap (fv E ∅) x ≐ ap (fv F ∅) x $ by ap_congr [l1, l2]
l4: $ suc (ap (fv E ∅) x) ≐ suc (ap (fv F ∅) x) $ by suc_congr [l3]
l5: $ lvals ≐ lvals $ by ceqt_refl
l6: $ clam x lvals (suc (ap (fv E ∅) x)) ≐ clam x lvals (suc (ap (fv F ∅) x)) $ by clam_congr [l5, l4]
l7: $ seqt z z $ by seqt_refl
l8: $ (z ∊ clam x lvals (suc (ap (fv E ∅) x))) ⟺ (z ∊ clam x lvals (suc (ap (fv F ∅) x))) $ by welc_congr [l7, l6]
l9: $ kc_ls ≐ kc_ls $ by ceqt_refl
l10: $ (A = kc_ls) ⟺ (B = kc_ls) $ by ceq_congr [#1, l9]
l11: $ (A = kc_ls ∧ z ∊ clam x lvals (suc (ap (fv E ∅) x))) ⟺ (B = kc_ls ∧ z ∊ clam x lvals (suc (ap (fv F ∅) x))) $ by and_congr [l10, l8]
l12: $ suc ∅ ≐ suc ∅ $ by ceqt_refl
l13: $ fv E (suc ∅) ≐ fv F (suc ∅) $ by fv_congr [#3, l12]
l14: $ ap (fv E (suc ∅)) x ≐ ap (fv F (suc ∅)) x $ by ap_congr [l13, l2]
l15: $ nmax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x) ≐ nmax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x) $ by nmax_congr [l3, l14]
l16: $ clam x lvals (nmax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x)) ≐ clam x lvals (nmax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x)) $ by clam_congr [l5, l15]
l17: $ (z ∊ clam x lvals (nmax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ⟺ (z ∊ clam x lvals (nmax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) $ by welc_congr [l7, l16]
l18: $ kc_lmax ≐ kc_lmax $ by ceqt_refl
l19: $ (A = kc_lmax) ⟺ (B = kc_lmax) $ by ceq_congr [#1, l18]
l20: $ (A = kc_lmax ∧ z ∊ clam x lvals (nmax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ⟺ (B = kc_lmax ∧ z ∊ clam x lvals (nmax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) $ by and_congr [l19, l17]
l21: $ nimax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x) ≐ nimax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x) $ by nimax_congr [l3, l14]
l22: $ clam x lvals (nimax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x)) ≐ clam x lvals (nimax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x)) $ by clam_congr [l5, l21]
l23: $ (z ∊ clam x lvals (nimax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ⟺ (z ∊ clam x lvals (nimax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) $ by welc_congr [l7, l22]
l24: $ kc_limax ≐ kc_limax $ by ceqt_refl
l25: $ (A = kc_limax) ⟺ (B = kc_limax) $ by ceq_congr [#1, l24]
l26: $ (A = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ⟺ (B = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) $ by and_congr [l25, l23]
l27: $ fv C ∅ ≐ fv D ∅ $ by fv_congr [#2, l0]
l28: $ nvf ≐ nvf $ by ceqt_refl
l29: $ fv nvf (fv C ∅) ≐ fv nvf (fv D ∅) $ by fv_congr [l28, l27]
l30: $ ap x (fv nvf (fv C ∅)) ≐ ap x (fv nvf (fv D ∅)) $ by ap_congr [l2, l29]
l31: $ clam x lvals (ap x (fv nvf (fv C ∅))) ≐ clam x lvals (ap x (fv nvf (fv D ∅))) $ by clam_congr [l5, l30]
l32: $ (z ∊ clam x lvals (ap x (fv nvf (fv C ∅)))) ⟺ (z ∊ clam x lvals (ap x (fv nvf (fv D ∅)))) $ by welc_congr [l7, l31]
l33: $ kc_lparam ≐ kc_lparam $ by ceqt_refl
l34: $ (A = kc_lparam) ⟺ (B = kc_lparam) $ by ceq_congr [#1, l33]
l35: $ (A = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv C ∅)))) ⟺ (B = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv D ∅)))) $ by and_congr [l34, l32]
l36: $ ((A = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ∨ (A = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv C ∅))))) ⟺ ((B = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) ∨ (B = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv D ∅))))) $ by or_congr [l26, l35]
l37: $ ((A = kc_lmax ∧ z ∊ clam x lvals (nmax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ∨ (A = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ∨ (A = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv C ∅))))) ⟺ ((B = kc_lmax ∧ z ∊ clam x lvals (nmax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) ∨ (B = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) ∨ (B = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv D ∅))))) $ by or_congr [l20, l36]
l38: $ ((A = kc_ls ∧ z ∊ clam x lvals (suc (ap (fv E ∅) x))) ∨ (A = kc_lmax ∧ z ∊ clam x lvals (nmax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ∨ (A = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ∨ (A = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv C ∅))))) ⟺ ((B = kc_ls ∧ z ∊ clam x lvals (suc (ap (fv F ∅) x))) ∨ (B = kc_lmax ∧ z ∊ clam x lvals (nmax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) ∨ (B = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) ∨ (B = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv D ∅))))) $ by or_congr [l11, l37]
l39: $ {z | (A = kc_ls ∧ z ∊ clam x lvals (suc (ap (fv E ∅) x))) ∨ (A = kc_lmax ∧ z ∊ clam x lvals (nmax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ∨ (A = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv E ∅) x) (ap (fv E (suc ∅)) x))) ∨ (A = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv C ∅))))} ≐ {z | (B = kc_ls ∧ z ∊ clam x lvals (suc (ap (fv F ∅) x))) ∨ (B = kc_lmax ∧ z ∊ clam x lvals (nmax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) ∨ (B = kc_limax ∧ z ∊ clam x lvals (nimax (ap (fv F ∅) x) (ap (fv F (suc ∅)) x))) ∨ (B = kc_lparam ∧ z ∊ clam x lvals (ap x (fv nvf (fv D ∅))))} $ by cab_congr [l38]

sb_c_lvb
--------
l1: $ (⟦ x / t ⟧ {z | (A = kc_ls ∧ z ∊ clam y lvals (suc (ap (fv C ∅) y))) ∨ (A = kc_lmax ∧ z ∊ clam y lvals (nmax (ap (fv C ∅) y) (ap (fv C (suc ∅)) y))) ∨ (A = kc_limax ∧ z ∊ clam y lvals (nimax (ap (fv C ∅) y) (ap (fv C (suc ∅)) y))) ∨ (A = kc_lparam ∧ z ∊ clam y lvals (ap y (fv nvf (fv B ∅))))}) ≐ {z | ((⟦ x / t ⟧ A) = kc_ls ∧ z ∊ clam y lvals (suc (ap (fv (⟦ x / t ⟧ C) ∅) y))) ∨ ((⟦ x / t ⟧ A) = kc_lmax ∧ z ∊ clam y lvals (nmax (ap (fv (⟦ x / t ⟧ C) ∅) y) (ap (fv (⟦ x / t ⟧ C) (suc ∅)) y))) ∨ ((⟦ x / t ⟧ A) = kc_limax ∧ z ∊ clam y lvals (nimax (ap (fv (⟦ x / t ⟧ C) ∅) y) (ap (fv (⟦ x / t ⟧ C) (suc ∅)) y))) ∨ ((⟦ x / t ⟧ A) = kc_lparam ∧ z ∊ clam y lvals (ap y (fv nvf (fv (⟦ x / t ⟧ B) ∅))))} $ by ceqt_refl

lv_congr
--------
l0: $ lvf ≐ lvf $ by ceqt_refl
l1: $ fv lvf A ≐ fv lvf B $ by fv_congr [l0, #1]
l2: $ ap (fv lvf A) C ≐ ap (fv lvf B) D $ by ap_congr [l1, #2]

lv_eq
-----
l0: $ G ⇒ lvf = lvf $ by eq_refl
l1: $ G ⇒ fv lvf A = fv lvf B $ by fv_eq [l0, #1]
l2: $ G ⇒ ap (fv lvf A) C = ap (fv lvf B) D $ by ap_eq [l1, #2]

sb_c_lv
-------
l1: $ (⟦ x / t ⟧ (ap (fv lvf A) B)) ≐ ap (fv lvf (⟦ x / t ⟧ A)) (⟦ x / t ⟧ B) $ by ceqt_refl

lemma k4_nimax_sub (G: hyps) (A B: class): $ G ⇒ nimax A B ⊆ nmax A B $
----
l1: $ G , y ∊ nimax A B ⇒ y ∊ nimax A B $ by ax
l2: $ G , y ∊ nimax A B ⇒ y ∊ nmax A B ∧ ∃ x (x ∊ B) $ by cab_elim [l1]
l3: $ G , y ∊ nimax A B ⇒ y ∊ nmax A B $ by and_elim_l [l2]
l4: $ G ⇒ nimax A B ⊆ nmax A B $ by subset_intro [l3]

lvb_set
-------
a1v: $ G ⇒ isset v $ by isset_var
a1: $ G ⇒ isset (ap v ∅) $ by ap_set_c [a1v]
a2: $ G ⇒ isset (fv v ∅) $ by cuni_set [a1]
a3v: $ G ⇒ isset v $ by isset_var
a3: $ G ⇒ isset (ap v (suc ∅)) $ by ap_set_c [a3v]
a4: $ G ⇒ isset (fv v (suc ∅)) $ by cuni_set [a3]
b1: $ G , x ∊ lvals ⇒ isset (fv v ∅) $ by weaken [a2]
b2: $ G , x ∊ lvals ⇒ isset (ap (fv v ∅) x) $ by ap_set [b1]
b3: $ G , x ∊ lvals ⇒ isset (suc (ap (fv v ∅) x)) $ by suc_set [b2]
b4: $ G , x ∊ lvals ⇒ isset (fv v (suc ∅)) $ by weaken [a4]
b5: $ G , x ∊ lvals ⇒ isset (ap (fv v (suc ∅)) x) $ by ap_set [b4]
b6: $ G , x ∊ lvals ⇒ isset (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) $ by cun_set [b2, b5]
b7: $ G , x ∊ lvals ⇒ nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x) ⊆ nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x) $ by k4_nimax_sub
b8: $ G , x ∊ lvals ⇒ isset (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) $ by subset_isset [b6, b7]
b9v: $ G , x ∊ lvals ⇒ isset x $ by isset_var
b9: $ G , x ∊ lvals ⇒ isset (ap x (fv nvf (fv S ∅))) $ by ap_set_c [b9v]
c1: $ G ⇒ x ∊ lvals → isset (suc (ap (fv v ∅) x)) $ by imp_intro [b3]
c2: $ G ⇒ ∀ x (x ∊ lvals → isset (suc (ap (fv v ∅) x))) $ by all_intro [c1]
c3: $ G ⇒ x ∊ lvals → isset (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) $ by imp_intro [b6]
c4: $ G ⇒ ∀ x (x ∊ lvals → isset (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x))) $ by all_intro [c3]
c5: $ G ⇒ x ∊ lvals → isset (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) $ by imp_intro [b8]
c6: $ G ⇒ ∀ x (x ∊ lvals → isset (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x))) $ by all_intro [c5]
c7: $ G ⇒ x ∊ lvals → isset (ap x (fv nvf (fv S ∅))) $ by imp_intro [b9]
c8: $ G ⇒ ∀ x (x ∊ lvals → isset (ap x (fv nvf (fv S ∅)))) $ by all_intro [c7]
d0: $ G ⇒ isset lvals $ by lvals_set
d1: $ G ⇒ isset (clam x lvals (suc (ap (fv v ∅) x))) $ by clam_set [d0, c2]
d2: $ G ⇒ isset (clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x))) $ by clam_set [d0, c4]
d3: $ G ⇒ isset (clam x lvals (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x))) $ by clam_set [d0, c6]
d4: $ G ⇒ isset (clam x lvals (ap x (fv nvf (fv S ∅)))) $ by clam_set [d0, c8]
d5: $ G ⇒ isset (clam x lvals (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ∪ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by cun_set [d3, d4]
d6: $ G ⇒ isset (clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ∪ (clam x lvals (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ∪ clam x lvals (ap x (fv nvf (fv S ∅))))) $ by cun_set [d2, d5]
d7: $ G ⇒ isset (clam x lvals (suc (ap (fv v ∅) x)) ∪ (clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ∪ (clam x lvals (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ∪ clam x lvals (ap x (fv nvf (fv S ∅)))))) $ by cun_set [d1, d6]
e1: $ G , y ∊ lvb K S v ⇒ y ∊ lvb K S v $ by ax
e2: $ G , y ∊ lvb K S v ⇒ (K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv v ∅) x))) ∨ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by cab_elim [e1]
f1: $ G , y ∊ lvb K S v , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv v ∅) x)) ⇒ K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv v ∅) x)) $ by ax
f2: $ G , y ∊ lvb K S v , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv v ∅) x)) ⇒ y ∊ clam x lvals (suc (ap (fv v ∅) x)) $ by and_elim_r [f1]
f3: $ G , y ∊ lvb K S v , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv v ∅) x)) ⇒ y ∊ clam x lvals (suc (ap (fv v ∅) x)) ∪ (clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ∪ (clam x lvals (nimax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ∪ clam x lvals (ap x (fv nvf (fv S ∅))))) $ by cun_intro_l [f2]
g1: $ G , y ∊ lvb K S v , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ⇒ K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) $ by ax
g2: $ G , y ∊ lvb K S v , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) ⇒ y ∊ clam x lvals (nmax (ap (fv v ∅) x) (ap (fv v (suc ∅)) x)) $ by and_elim_r [g1]
