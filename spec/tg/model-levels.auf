l8: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a a)) x = lv (enc_lvl a) x $ by k6_eq3 [l4, l5, l7]
l9: $ leqv (lmax a a) a $ by leqv_i [l8]

lmax_zero
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl lz ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (lmax lz a)) x = nmax (lv (enc_lvl lz) x) (lv (enc_lvl a) x) $ by lv_lmax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ lv (enc_lvl lz) x = ∅ $ by lv_lz
l6: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l7: $ x ∊ lvals ⇒ nmax (lv (enc_lvl lz) x) (lv (enc_lvl a) x) = nmax ∅ (lv (enc_lvl a) x) $ by nmax_eq [l5, l6]
l8: $ x ∊ lvals ⇒ lv (enc_lvl (lmax lz a)) x = nmax ∅ (lv (enc_lvl a) x) $ by eq_trans [l4, l7]
l9: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l11: $ x ∊ lvals ⇒ nmax ∅ (lv (enc_lvl a) x) = lv (enc_lvl a) x $ by nmax_zero_l_c
l12: $ x ∊ lvals ⇒ lv (enc_lvl (lmax lz a)) x = lv (enc_lvl a) x $ by k6_eq3 [l8, l9, l11]
l13: $ leqv (lmax lz a) a $ by leqv_i [l12]

lmax_succ
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl (ls a) ∈ trees ω $ by enc_lvl_trees
