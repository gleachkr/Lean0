l13: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l14: $ x ∊ lvals ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l15: $ x ∊ lvals ⇒ nimax (suc ∅) (lv (enc_lvl a) x) = lv (enc_lvl a) x $ by nimax_one_c [l14]
l16: $ x ∊ lvals ⇒ lv (enc_lvl (limax (ls lz) a)) x = lv (enc_lvl a) x $ by k6_eq3 [l12, l13, l15]
l17: $ leqv (limax (ls lz) a) a $ by leqv_i [l16]

limax_succ
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl (ls b) ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (ls b))) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl (ls b)) x) $ by lv_limax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ lv (enc_lvl (ls b)) x = suc (lv (enc_lvl b) x) $ by lv_ls [l5, l1]
l7: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l8: $ x ∊ lvals ⇒ nimax (lv (enc_lvl a) x) (lv (enc_lvl (ls b)) x) = nimax (lv (enc_lvl a) x) (suc (lv (enc_lvl b) x)) $ by nimax_eq [l7, l6]
l9: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (ls b))) x = nimax (lv (enc_lvl a) x) (suc (lv (enc_lvl b) x)) $ by eq_trans [l4, l8]
l10: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l11: $ x ∊ lvals ⇒ enc_lvl (ls b) ∈ trees ω $ by enc_lvl_trees
l12: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a (ls b))) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl (ls b)) x) $ by lv_lmax [l10, l11, l1]
l13: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l14: $ x ∊ lvals ⇒ lv (enc_lvl (ls b)) x = suc (lv (enc_lvl b) x) $ by lv_ls [l13, l1]
l15: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l16: $ x ∊ lvals ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl (ls b)) x) = nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl b) x)) $ by nmax_eq [l15, l14]
l17: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a (ls b))) x = nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl b) x)) $ by eq_trans [l12, l16]
l18: $ x ∊ lvals ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l19: $ x ∊ lvals ⇒ lv (enc_lvl b) x ∈ ω $ by k6_lvo [l1]
l19a: $ x ∊ lvals ⇒ isset (lv (enc_lvl a) x) $ by wcel_isset [l18]
l20: $ x ∊ lvals ⇒ nimax (lv (enc_lvl a) x) (suc (lv (enc_lvl b) x)) = nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl b) x)) $ by nimax_suc_c [l19a, l19]
l21: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (ls b))) x = lv (enc_lvl (lmax a (ls b))) x $ by k6_eq3 [l9, l17, l20]
l22: $ leqv (limax a (ls b)) (lmax a (ls b)) $ by leqv_i [l21]

