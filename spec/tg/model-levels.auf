lupd_congr
----------
l1: $ cv i ≐ cv i $ by ceqt_refl
l2: $ cv y ≐ cv y $ by ceqt_refl
l3: $ (i = C) ⟺ (i = D) $ by ceq_congr [l1, #2]
l4: $ (y ∊ E) ⟺ (y ∊ F) $ by welc_congr [l2, #3]
l5: $ (i = C ∧ y ∊ E) ⟺ (i = D ∧ y ∊ F) $ by and_congr [l3, l4]
l6: $ (¬ i = C) ⟺ (¬ i = D) $ by not_congr [l3]
l7: $ ap A i ≐ ap B i $ by ap_congr [#1, l1]
l8: $ (y ∊ ap A i) ⟺ (y ∊ ap B i) $ by welc_congr [l2, l7]
l9: $ (¬ i = C ∧ y ∊ ap A i) ⟺ (¬ i = D ∧ y ∊ ap B i) $ by and_congr [l6, l8]
l10: $ ((i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)) ⟺ ((i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)) $ by or_congr [l5, l9]
l11: $ {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} ≐ {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by cab_congr [l10]
l12: $ ω ≐ ω $ by ceqt_refl
l13: $ clam i ω {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} ≐ clam i ω {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by clam_congr [l12, l11]

--| One direction of the equality of `lupd`'s bodies.
lemma k2_lupd_body (G: hyps) (A B C D E F: class) (i y: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ E = F $ >
  $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $
----
l1: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ⇒ (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) $ by ax
a1: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ i = C ∧ y ∊ E $ by ax
a2: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ i = C $ by and_elim_l [a1]
a3: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ y ∊ E $ by and_elim_r [a1]
a4: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ C = D $ by weaken [#2]
a5: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ i = D $ by eq_trans [a2, a4]
a6: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ E = F $ by weaken [#3]
a7: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ y ∊ F $ by welc_eq [a6, a3]
a8: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ i = D ∧ y ∊ F $ by and_intro [a5, a7]
a9: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , i = C ∧ y ∊ E ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by or_intro_l [a8]
b1: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ ¬ i = C ∧ y ∊ ap A i $ by ax
b2: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ ¬ i = C $ by and_elim_l [b1]
b3: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ y ∊ ap A i $ by and_elim_r [b1]
b4: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ i = D $ by ax
b5: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ C = D $ by weaken [#2]
b6: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ D = C $ by eq_sym [b5]
b7: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ i = C $ by eq_trans [b4, b6]
b8: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ ¬ i = C $ by weaken [b2]
b9: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i , i = D ⇒ ⊥ $ by not_elim [b8, b7]
b10: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ ¬ i = D $ by not_intro [b9]
b11: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ A = B $ by weaken [#1]
b12: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ i = i $ by eq_refl
b13: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ y ∊ ap B i $ by welc_ap_eq [b11, b12, b3]
b14: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ ¬ i = D ∧ y ∊ ap B i $ by and_intro [b10, b13]
b15: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) , ¬ i = C ∧ y ∊ ap A i ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by or_intro_r [b14]
l2: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by or_elim [l1, a9, b15]

lupd_eq
-------
l1: $ G , (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ⇒ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by k2_lupd_body [#1, #2, #3]
l2: $ G ⇒ B = A $ by eq_sym [#1]
l3: $ G ⇒ D = C $ by eq_sym [#2]
l4: $ G ⇒ F = E $ by eq_sym [#3]
l5: $ G , (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) ⇒ (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) $ by k2_lupd_body [l2, l3, l4]
l6: $ G ⇒ (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ↔ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i) $ by bi_intro [l1, l5]
l7: $ G ⇒ ∀ y ((i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i) ↔ (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)) $ by all_intro [l6]
l8: $ G ⇒ {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by cab_eq [l7]
l9: $ G , i ∊ ω ⇒ {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by weaken [l8]
l10: $ G ⇒ i ∊ ω → {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by imp_intro [l9]
l11: $ G ⇒ ∀ i (i ∊ ω → {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)}) $ by all_intro [l10]
l12: $ G ⇒ clam i ω {y | (i = C ∧ y ∊ E) ∨ (¬ i = C ∧ y ∊ ap A i)} = clam i ω {y | (i = D ∧ y ∊ F) ∨ (¬ i = D ∧ y ∊ ap B i)} $ by clam_eq_body [l11]

sb_c_lupd
---------
l1: $ (⟦ x / t ⟧ (clam i ω {y | (i = B ∧ y ∊ C) ∨ (¬ i = B ∧ y ∊ ap A i)})) ≐ clam i ω {y | (i = (⟦ x / t ⟧ B) ∧ y ∊ (⟦ x / t ⟧ C)) ∨ (¬ i = (⟦ x / t ⟧ B) ∧ y ∊ ap (⟦ x / t ⟧ A) i)} $ by ceqt_refl

--| `lupd`'s body at the updated index.
lemma k2_upd_eq {y: set} (G: hyps) (N B C: class) (i: set):
  $ G ⇒ i = N $ > $ G ⇒ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} = B $
----
l1: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} ⇒ z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} $ by ax
l2: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} ⇒ (i = N ∧ z ∊ B) ∨ (¬ i = N ∧ z ∊ C) $ by cab_elim [l1]
l3: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ i = N ∧ z ∊ B $ by ax
l4: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ z ∊ B $ by and_elim_r [l3]
l5: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ ¬ i = N ∧ z ∊ C $ by ax
l6: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ ¬ i = N $ by and_elim_l [l5]
l7: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ i = N $ by weaken [#1]
l8: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ ⊥ $ by not_elim [l6, l7]
l9: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ z ∊ B $ by bot_elim [l8]
l10: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} ⇒ z ∊ B $ by or_elim [l2, l4, l9]
l11: $ G , z ∊ B ⇒ i = N $ by weaken [#1]
l12: $ G , z ∊ B ⇒ z ∊ B $ by ax
l13: $ G , z ∊ B ⇒ i = N ∧ z ∊ B $ by and_intro [l11, l12]
l14: $ G , z ∊ B ⇒ (i = N ∧ z ∊ B) ∨ (¬ i = N ∧ z ∊ C) $ by or_intro_l [l13]
l15: $ G , z ∊ B ⇒ z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} $ by cab_intro [l14]
l16: $ G ⇒ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} = B $ by eq_intro [l10, l15]

--| `lupd`'s body at another index.
lemma k2_upd_ne {y: set} (G: hyps) (N B C: class) (i: set):
  $ G ⇒ ¬ i = N $ > $ G ⇒ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} = C $
----
l1: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} ⇒ z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} $ by ax
l2: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} ⇒ (i = N ∧ z ∊ B) ∨ (¬ i = N ∧ z ∊ C) $ by cab_elim [l1]
l3: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ i = N ∧ z ∊ B $ by ax
l4: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ i = N $ by and_elim_l [l3]
l5: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ ¬ i = N $ by weaken [#1]
l6: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ ⊥ $ by not_elim [l5, l4]
l7: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , i = N ∧ z ∊ B ⇒ z ∊ C $ by bot_elim [l6]
l8: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ ¬ i = N ∧ z ∊ C $ by ax
l9: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} , ¬ i = N ∧ z ∊ C ⇒ z ∊ C $ by and_elim_r [l8]
l10: $ G , z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} ⇒ z ∊ C $ by or_elim [l2, l7, l9]
l11: $ G , z ∊ C ⇒ ¬ i = N $ by weaken [#1]
l12: $ G , z ∊ C ⇒ z ∊ C $ by ax
l13: $ G , z ∊ C ⇒ ¬ i = N ∧ z ∊ C $ by and_intro [l11, l12]
l14: $ G , z ∊ C ⇒ (i = N ∧ z ∊ B) ∨ (¬ i = N ∧ z ∊ C) $ by or_intro_r [l13]
l15: $ G , z ∊ C ⇒ z ∊ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} $ by cab_intro [l14]
l16: $ G ⇒ {y | (i = N ∧ y ∊ B) ∨ (¬ i = N ∧ y ∊ C)} = C $ by eq_intro [l10, l15]

lupd_lvals
----------
l1: $ G , i ∊ ω , i = n ⇒ i = n $ by ax
l2: $ G , i ∊ ω , i = n ⇒ {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} = x $ by k2_upd_eq [l1]
l3: $ G ⇒ x ∈ ω $ by welc_wcel [#2]
l4: $ G , i ∊ ω , i = n ⇒ x ∈ ω $ by weaken [l3]
l5: $ G , i ∊ ω , i = n ⇒ x = {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} $ by eq_sym [l2]
l6: $ G , i ∊ ω , i = n ⇒ {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} ∈ ω $ by wcel_eq_l [l5, l4]
l7: $ G , i ∊ ω , ¬ i = n ⇒ ¬ i = n $ by ax
l8: $ G , i ∊ ω , ¬ i = n ⇒ {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} = ap w i $ by k2_upd_ne [l7]
l9: $ G , i ∊ ω , ¬ i = n ⇒ w ∊ lvals $ by weaken [#1]
l10: $ G , i ∊ ω , ¬ i = n ⇒ i ∊ ω $ by ax
l11: $ G , i ∊ ω , ¬ i = n ⇒ ap w i ∈ ω $ by lvals_ap [l9, l10]
l12: $ G , i ∊ ω , ¬ i = n ⇒ ap w i = {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} $ by eq_sym [l8]
l13: $ G , i ∊ ω , ¬ i = n ⇒ {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} ∈ ω $ by wcel_eq_l [l12, l11]
l14: $ G , i ∊ ω ⇒ i = n ∨ ¬ i = n $ by excluded_middle
l15: $ G , i ∊ ω ⇒ {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} ∈ ω $ by or_elim [l14, l6, l13]
l16: $ G ⇒ i ∊ ω → {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} ∈ ω $ by imp_intro [l15]
l17: $ G ⇒ ∀ i (i ∊ ω → {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} ∈ ω) $ by all_intro [l16]
l18: $ G , i ∊ ω ⇒ isset {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} $ by wcel_isset [l15]
l19: $ G ⇒ i ∊ ω → isset {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} $ by imp_intro [l18]
l20: $ G ⇒ ∀ i (i ∊ ω → isset {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)}) $ by all_intro [l19]
l21: $ G ⇒ isset ω $ by omega_set
l22: $ G ⇒ isset (clam i ω {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)}) $ by clam_set [l21, l20]
l23: $ G ⇒ clam i ω {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} ∈ cpi i ω ω $ by clam_cpi_intro [l22, l17]

lupd_ap_eq
----------
l1: $ G ⇒ ap (clam i ω {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)}) n = {y | (n = n ∧ y ∊ x) ∨ (¬ n = n ∧ y ∊ ap w n)} $ by clam_ap [#1]
l2: $ G ⇒ n = n $ by eq_refl
l3: $ G ⇒ {y | (n = n ∧ y ∊ x) ∨ (¬ n = n ∧ y ∊ ap w n)} = x $ by k2_upd_eq [l2]
l4: $ G ⇒ ap (lupd w n x) n = x $ by eq_trans [l1, l3]

lupd_ap_ne
----------
l1: $ G ⇒ ap (clam j ω {y | (j = n ∧ y ∊ x) ∨ (¬ j = n ∧ y ∊ ap w j)}) i = {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} $ by clam_ap [#1]
l2: $ G ⇒ {y | (i = n ∧ y ∊ x) ∨ (¬ i = n ∧ y ∊ ap w i)} = ap w i $ by k2_upd_ne [#2]
l3: $ G ⇒ ap (lupd w n x) i = ap w i $ by eq_trans [l1, l2]

lupd_ap_ne_c
------------
