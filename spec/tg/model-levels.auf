l6: $ G ⇒ isset (lv t3 w) $ by wcel_isset [l5]
l7: $ G , i = fv nvf t1 ⇒ i = fv nvf t1 $ by ax
l8: $ G , i = fv nvf t1 ⇒ fv nvf t1 = i $ by eq_sym [l7]
l9: $ G , i = fv nvf t1 ⇒ fv nvf t1 ∈ ω $ by weaken [l2]
l10: $ G , i = fv nvf t1 ⇒ i ∈ ω $ by wcel_eq_l [l8, l9]
l11: $ G , i = fv nvf t1 ⇒ i ∊ ω $ by wcel_welc [l10]
l12: $ G , i = fv nvf t1 , j = lv t3 w ⇒ j = lv t3 w $ by ax
l13: $ G , i = fv nvf t1 , j = lv t3 w ⇒ lv t3 w = j $ by eq_sym [l12]
l14: $ G , i = fv nvf t1 , j = lv t3 w ⇒ lv t3 w ∈ ω $ by weaken [l5]
l15: $ G , i = fv nvf t1 , j = lv t3 w ⇒ j ∈ ω $ by wcel_eq_l [l13, l14]
l16: $ G , i = fv nvf t1 , j = lv t3 w ⇒ j ∊ ω $ by wcel_welc [l15]
l17: $ G , i = fv nvf t1 , j = lv t3 w ⇒ w ∊ lvals $ by weaken [#2]
l18: $ G , i = fv nvf t1 , j = lv t3 w ⇒ lupd w i j ∈ lvals $ by lupd_lvals [l17, l16]
l19: $ G , i = fv nvf t1 , j = lv t3 w ⇒ isset (lupd w i j) $ by wcel_isset [l18]
l20: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ f = lupd w i j $ by ax
