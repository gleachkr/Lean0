f7: $ G , ∅ ∈ c ⇒ nimax a (nimax b c) = nimax a (nmax b c) $ by nimax_eq [f6, f4]
f8: $ G , ∅ ∈ c ⇒ nimax a (nmax b c) = nmax a (nmax b c) $ by k1_nimax_wpos_c [f3]
f9: $ G , ∅ ∈ c ⇒ nmax a (nmax b c) = nmax (nmax a c) (nmax b c) $ by k1_cun_distr2
f10: $ G , ∅ ∈ c ⇒ nmax (nimax a c) (nimax b c) = nmax (nmax a c) (nmax b c) $ by nmax_eq [f5, f4]
f11: $ G , ∅ ∈ c ⇒ nmax (nmax a c) (nmax b c) = nmax (nimax a c) (nimax b c) $ by eq_sym [f10]
f12: $ G , ∅ ∈ c ⇒ nimax a (nimax b c) = nmax a (nmax b c) $ by eq_trans [f7, f8]
f13: $ G , ∅ ∈ c ⇒ nimax a (nimax b c) = nmax (nmax a c) (nmax b c) $ by eq_trans [f12, f9]
f14: $ G , ∅ ∈ c ⇒ nimax a (nimax b c) = nmax (nimax a c) (nimax b c) $ by eq_trans [f13, f11]
l2: $ G ⇒ nimax a (nimax b c) = nmax (nimax a c) (nimax b c) $ by or_elim [l1, f14, b10]

nimax_nimax_c
-------------
l1: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ y = A $ by ax
l2: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ z = B $ by ax
l3: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ u = C $ by ax
l4: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ y ∊ ω $ by ax
l5: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ z ∊ ω $ by ax
l6: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ u ∊ ω $ by ax
l7: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ nimax y (nimax z u) = nmax (nimax y u) (nimax z u) $ by nimax_nimax [l4, l5, l6]
l8: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ nimax z u = nimax B C $ by nimax_eq [l2, l3]
l9: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ nimax y (nimax z u) = nimax A (nimax B C) $ by nimax_eq [l1, l8]
l10: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ nimax y u = nimax A C $ by nimax_eq [l1, l3]
l11: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ nimax z u = nimax B C $ by nimax_eq [l2, l3]
l12: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ nmax (nimax y u) (nimax z u) = nmax (nimax A C) (nimax B C) $ by nmax_eq [l10, l11]
l13: $ G , y = A , y ∊ ω , z = B , z ∊ ω , u = C , u ∊ ω ⇒ nimax A (nimax B C) = nmax (nimax A C) (nimax B C) $ by k6_eq3s [l9, l12, l7]
l14: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ nimax A (nimax B C) = nmax (nimax A C) (nimax B C) $ by wcel_elim [#3, l13]
l15: $ G , y = A , y ∊ ω ⇒ nimax A (nimax B C) = nmax (nimax A C) (nimax B C) $ by wcel_elim [#2, l14]
l16: $ G ⇒ nimax A (nimax B C) = nmax (nimax A C) (nimax B C) $ by wcel_elim [#1, l15]

lvals_set
---------
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset (⋃ ω) $ by cuni_set [l1]
l3: $ G , x ∊ ω ⇒ isset (⋃ ω) $ by weaken [l2]
l4: $ G ⇒ x ∊ ω → isset (⋃ ω) $ by imp_intro [l3]
l5: $ G ⇒ ∀ x (x ∊ ω → isset (⋃ ω)) $ by all_intro [l4]
l6: $ G ⇒ isset (clam x ω (⋃ ω)) $ by clam_set [l1, l5]
l7: $ G ⇒ isset (cpi x ω ω) $ by cpi_set [l6]

