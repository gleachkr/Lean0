lemma k5_mva3 (G: hyps) (K A B C A2 B2 C2: class):
  $ G ⇒ ⟨ K , scons A (scons B (scons C ∅)) ⟩ ∈ lrel $ > $ G ⇒ A = A2 $ > $ G ⇒ B = B2 $ > $ G ⇒ C = C2 $ > $ G ⇒ ⟨ K , scons A2 (scons B2 (scons C2 ∅)) ⟩ ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons C ∅ = scons C2 ∅ $ by scons_eq [#4, l1]
l3: $ G ⇒ scons B (scons C ∅) = scons B2 (scons C2 ∅) $ by scons_eq [#3, l2]
l4: $ G ⇒ scons A (scons B (scons C ∅)) = scons A2 (scons B2 (scons C2 ∅)) $ by scons_eq [#2, l3]
l5: $ G ⇒ K = K $ by eq_refl
l6: $ G ⇒ ⟨ K , scons A (scons B (scons C ∅)) ⟩ = ⟨ K , scons A2 (scons B2 (scons C2 ∅)) ⟩ $ by opair_eq [l5, l4]
l7: $ G ⇒ ⟨ K , scons A2 (scons B2 (scons C2 ∅)) ⟩ ∈ lrel $ by wcel_eq_l [l6, #1]

lemma k5_mva4 (G: hyps) (K A B C D A2 B2 C2 D2: class):
  $ G ⇒ ⟨ K , scons A (scons B (scons C (scons D ∅))) ⟩ ∈ lrel $ > $ G ⇒ A = A2 $ > $ G ⇒ B = B2 $ > $ G ⇒ C = C2 $ > $ G ⇒ D = D2 $ > $ G ⇒ ⟨ K , scons A2 (scons B2 (scons C2 (scons D2 ∅))) ⟩ ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons D ∅ = scons D2 ∅ $ by scons_eq [#5, l1]
l3: $ G ⇒ scons C (scons D ∅) = scons C2 (scons D2 ∅) $ by scons_eq [#4, l2]
l4: $ G ⇒ scons B (scons C (scons D ∅)) = scons B2 (scons C2 (scons D2 ∅)) $ by scons_eq [#3, l3]
l5: $ G ⇒ scons A (scons B (scons C (scons D ∅))) = scons A2 (scons B2 (scons C2 (scons D2 ∅))) $ by scons_eq [#2, l4]
l6: $ G ⇒ K = K $ by eq_refl
l7: $ G ⇒ ⟨ K , scons A (scons B (scons C (scons D ∅))) ⟩ = ⟨ K , scons A2 (scons B2 (scons C2 (scons D2 ∅))) ⟩ $ by opair_eq [l6, l5]
l8: $ G ⇒ ⟨ K , scons A2 (scons B2 (scons C2 (scons D2 ∅))) ⟩ ∈ lrel $ by wcel_eq_l [l7, #1]

linst_sem
---------
l1: $ G ⇒ ra_linst (enc_lvls S) (enc_lvl l) (enc_lvl l2) ∈ lrel $ by weaken [#1]
l2: $ G ⇒ enc_lvls S ∈ trees ω $ by enc_lvls_trees
l3: $ G ⇒ isset (enc_lvls S) $ by wcel_isset [l2]
l4: $ G ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l5: $ G ⇒ isset (enc_lvl l) $ by wcel_isset [l4]
l6: $ G ⇒ enc_lvl l2 ∈ trees ω $ by enc_lvl_trees
l7: $ G ⇒ isset (enc_lvl l2) $ by wcel_isset [l6]
l8: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ x = enc_lvls S $ by ax
l9: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ enc_lvls S = x $ by eq_sym [l8]
l10: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ y = enc_lvl l $ by ax
l11: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ enc_lvl l = y $ by eq_sym [l10]
l12: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ z = enc_lvl l2 $ by ax
l13: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ enc_lvl l2 = z $ by eq_sym [l12]
l14: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ ra_linst (enc_lvls S) (enc_lvl l) (enc_lvl l2) ∈ lrel $ by weaken [l1]
l15: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ ⟨ kr_linst , scons x (scons y (scons z ∅)) ⟩ ∈ lrel $ by k5_mva3 [l14, l9, l11, l13]
l16: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ w ∊ lvals $ by weaken [#2]
l17: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ lv z w = lv y (lsub (lsv x w)) $ by lrel_linst_sem [l15, l16]
l18: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ w = w $ by eq_refl
l19: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ lv (enc_lvl l2) w = lv z w $ by lv_eq [l13, l18]
l20: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ lsv x w = lsv (enc_lvls S) w $ by lsv_eq [l8, l18]
l21: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ lsub (lsv x w) = lsub (lsv (enc_lvls S) w) $ by lsub_eq [l20]
l22: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ lv y (lsub (lsv x w)) = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by lv_eq [l10, l21]
l23: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ lv (enc_lvl l2) w = lv y (lsub (lsv x w)) $ by eq_trans [l19, l17]
l24: $ G , x = enc_lvls S , y = enc_lvl l , z = enc_lvl l2 ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by eq_trans [l23, l22]
l25: $ G , x = enc_lvls S , y = enc_lvl l ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by isset_elim [l7, l24]
l26: $ G , x = enc_lvls S ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by isset_elim [l5, l25]
l27: $ G ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lsub (lsv (enc_lvls S) w)) $ by isset_elim [l3, l26]

lsubst_sem
----------
l1: $ G ⇒ ra_lsubst (enc_nat n) (enc_lvl l) (enc_lvl a) (enc_lvl l2) ∈ lrel $ by weaken [#1]
