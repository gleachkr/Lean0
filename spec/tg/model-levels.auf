l23: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ j = suc y $ by and_elim_r [l21]
l24: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ x ∊ lvals $ by ax
l25: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ k = fv nvf (enc_nat n) $ by ax
l26: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ k ∊ ω $ by ax
l27: $ x ∊ lvals , k = fv nvf (enc_nat n) , k ∊ ω , j = ap x k , j ∊ ω , y ∊ ω ∧ j = suc y ⇒ j = ap x k $ by ax
