j7: $ G ⇒ isset (lvb K S v) $ by subset_isset [d7, j6]

--| A four-way case split.
lemma k4_or4 (G: hyps) (p1 p2 p3 p4 c: fml): $ G ⇒ p1 ∨ p2 ∨ p3 ∨ p4 $ > $ G , p1 ⇒ c $ > $ G , p2 ⇒ c $ > $ G , p3 ⇒ c $ > $ G , p4 ⇒ c $ > $ G ⇒ c $
----
l1: $ G , p3 ∨ p4 , p3 ⇒ c $ by weaken [#4]
l2: $ G , p3 ∨ p4 , p4 ⇒ c $ by weaken [#5]
l3: $ G , p3 ∨ p4 ⇒ p3 ∨ p4 $ by ax
l4: $ G , p3 ∨ p4 ⇒ c $ by or_elim [l3, l1, l2]
l5: $ G , p2 ∨ p3 ∨ p4 , p2 ⇒ c $ by weaken [#3]
l6: $ G , p2 ∨ p3 ∨ p4 , p3 ∨ p4 ⇒ c $ by weaken [l4]
l7: $ G , p2 ∨ p3 ∨ p4 ⇒ p2 ∨ p3 ∨ p4 $ by ax
l8: $ G , p2 ∨ p3 ∨ p4 ⇒ c $ by or_elim [l7, l5, l6]
l9: $ G ⇒ c $ by or_elim [#1, #2, l8]

lemma k4_lvb_sub (G: hyps) (K K2 S S2 A B: class): $ G ⇒ K = K2 $ > $ G ⇒ S = S2 $ > $ G ⇒ A = B $ > $ G ⇒ lvb K S A ⊆ lvb K2 S2 B $
----
e0: $ G ⇒ ∅ = ∅ $ by eq_refl
e1: $ G ⇒ fv A ∅ = fv B ∅ $ by fv_eq [#3, e0]
e2: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
e3: $ G ⇒ fv A (suc ∅) = fv B (suc ∅) $ by fv_eq [#3, e2]
e4: $ G ⇒ fv S ∅ = fv S2 ∅ $ by fv_eq [#2, e0]
e5: $ G ⇒ nvf = nvf $ by eq_refl
e6: $ G ⇒ fv nvf (fv S ∅) = fv nvf (fv S2 ∅) $ by fv_eq [e5, e4]
f0: $ G , x ∊ lvals ⇒ x = x $ by eq_refl
f1: $ G , x ∊ lvals ⇒ fv A ∅ = fv B ∅ $ by weaken [e1]
f2: $ G , x ∊ lvals ⇒ ap (fv A ∅) x = ap (fv B ∅) x $ by ap_eq [f1, f0]
f3: $ G , x ∊ lvals ⇒ fv A (suc ∅) = fv B (suc ∅) $ by weaken [e3]
f4: $ G , x ∊ lvals ⇒ ap (fv A (suc ∅)) x = ap (fv B (suc ∅)) x $ by ap_eq [f3, f0]
f5: $ G , x ∊ lvals ⇒ suc (ap (fv A ∅) x) = suc (ap (fv B ∅) x) $ by suc_eq [f2]
f6: $ G , x ∊ lvals ⇒ nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x) = nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x) $ by nmax_eq [f2, f4]
f7: $ G , x ∊ lvals ⇒ nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x) = nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x) $ by nimax_eq [f2, f4]
f8: $ G , x ∊ lvals ⇒ fv nvf (fv S ∅) = fv nvf (fv S2 ∅) $ by weaken [e6]
f9: $ G , x ∊ lvals ⇒ ap x (fv nvf (fv S ∅)) = ap x (fv nvf (fv S2 ∅)) $ by ap_eq [f0, f8]
g1: $ G ⇒ x ∊ lvals → suc (ap (fv A ∅) x) = suc (ap (fv B ∅) x) $ by imp_intro [f5]
g2: $ G ⇒ ∀ x (x ∊ lvals → suc (ap (fv A ∅) x) = suc (ap (fv B ∅) x)) $ by all_intro [g1]
g3: $ G ⇒ x ∊ lvals → nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x) = nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x) $ by imp_intro [f6]
g4: $ G ⇒ ∀ x (x ∊ lvals → nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x) = nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by all_intro [g3]
g5: $ G ⇒ x ∊ lvals → nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x) = nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x) $ by imp_intro [f7]
g6: $ G ⇒ ∀ x (x ∊ lvals → nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x) = nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by all_intro [g5]
g7: $ G ⇒ x ∊ lvals → ap x (fv nvf (fv S ∅)) = ap x (fv nvf (fv S2 ∅)) $ by imp_intro [f9]
g8: $ G ⇒ ∀ x (x ∊ lvals → ap x (fv nvf (fv S ∅)) = ap x (fv nvf (fv S2 ∅))) $ by all_intro [g7]
h1: $ G ⇒ clam x lvals (suc (ap (fv A ∅) x)) = clam x lvals (suc (ap (fv B ∅) x)) $ by clam_eq_body [g2]
h2: $ G ⇒ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) = clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by clam_eq_body [g4]
h3: $ G ⇒ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) = clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by clam_eq_body [g6]
h4: $ G ⇒ clam x lvals (ap x (fv nvf (fv S ∅))) = clam x lvals (ap x (fv nvf (fv S2 ∅))) $ by clam_eq_body [g8]
h5: $ G ⇒ K2 = K $ by eq_sym [#1]
i1: $ G , y ∊ lvb K S A ⇒ y ∊ lvb K S A $ by ax
i2: $ G , y ∊ lvb K S A ⇒ (K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x))) ∨ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by cab_elim [i1]
j0a: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) $ by ax
j0b: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ y ∊ clam x lvals (suc (ap (fv A ∅) x)) $ by and_elim_r [j0a]
j0c: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ clam x lvals (suc (ap (fv A ∅) x)) = clam x lvals (suc (ap (fv B ∅) x)) $ by weaken [h1]
j0d: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ y ∊ clam x lvals (suc (ap (fv B ∅) x)) $ by welc_eq [j0c, j0b]
j0e: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ K = kc_ls $ by and_elim_l [j0a]
j0e1: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ K2 = K $ by weaken [h5]
j0e2: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ K2 = kc_ls $ by eq_trans [j0e1, j0e]
j0f: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ K2 = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv B ∅) x)) $ by and_intro [j0e2, j0d]
j0g: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ (K2 = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv B ∅) x))) ∨ (K2 = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_l [j0f]
j0h: $ G , y ∊ lvb K S A , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv A ∅) x)) ⇒ y ∊ lvb K2 S2 B $ by cab_intro [j0g]
j1a: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) $ by ax
j1b: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) $ by and_elim_r [j1a]
j1c: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) = clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by weaken [h2]
j1d: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by welc_eq [j1c, j1b]
j1e: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K = kc_lmax $ by and_elim_l [j1a]
j1e1: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K2 = K $ by weaken [h5]
j1e2: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K2 = kc_lmax $ by eq_trans [j1e1, j1e]
j1f: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K2 = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by and_intro [j1e2, j1d]
j1g0: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ (K2 = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_l [j1f]
j1g: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ (K2 = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv B ∅) x))) ∨ (K2 = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_r [j1g0]
j1h: $ G , y ∊ lvb K S A , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ y ∊ lvb K2 S2 B $ by cab_intro [j1g]
j2a: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) $ by ax
j2b: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) $ by and_elim_r [j2a]
j2c: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) = clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by weaken [h3]
j2d: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by welc_eq [j2c, j2b]
j2e: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K = kc_limax $ by and_elim_l [j2a]
j2e1: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K2 = K $ by weaken [h5]
j2e2: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K2 = kc_limax $ by eq_trans [j2e1, j2e]
j2f: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x)) $ by and_intro [j2e2, j2d]
j2g00: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_l [j2f]
j2g0: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ (K2 = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_r [j2g00]
j2g: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ (K2 = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv B ∅) x))) ∨ (K2 = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_r [j2g0]
j2h: $ G , y ∊ lvb K S A , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv A ∅) x) (ap (fv A (suc ∅)) x)) ⇒ y ∊ lvb K2 S2 B $ by cab_intro [j2g]
j3a: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by ax
j3b: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by and_elim_r [j3a]
j3c: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ clam x lvals (ap x (fv nvf (fv S ∅))) = clam x lvals (ap x (fv nvf (fv S2 ∅))) $ by weaken [h4]
j3d: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅))) $ by welc_eq [j3c, j3b]
j3e: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K = kc_lparam $ by and_elim_l [j3a]
j3e1: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K2 = K $ by weaken [h5]
j3e2: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K2 = kc_lparam $ by eq_trans [j3e1, j3e]
j3f: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅))) $ by and_intro [j3e2, j3d]
j3g00: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_r [j3f]
j3g0: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ (K2 = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_r [j3g00]
j3g: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ (K2 = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv B ∅) x))) ∨ (K2 = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv B ∅) x) (ap (fv B (suc ∅)) x))) ∨ (K2 = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S2 ∅)))) $ by or_intro_r [j3g0]
j3h: $ G , y ∊ lvb K S A , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ y ∊ lvb K2 S2 B $ by cab_intro [j3g]
k1: $ G , y ∊ lvb K S A ⇒ y ∊ lvb K2 S2 B $ by k4_or4 [i2, j0h, j1h, j2h, j3h]
k2: $ G ⇒ lvb K S A ⊆ lvb K2 S2 B $ by subset_intro [k1]

lvb_eq
------
l1: $ G ⇒ lvb K S A ⊆ lvb K2 S2 B $ by k4_lvb_sub [#1, #2, #3]
l2: $ G ⇒ K2 = K $ by eq_sym [#1]
l3: $ G ⇒ S2 = S $ by eq_sym [#2]
l4: $ G ⇒ B = A $ by eq_sym [#3]
l5: $ G ⇒ lvb K2 S2 B ⊆ lvb K S A $ by k4_lvb_sub [l2, l3, l4]
l6: $ G ⇒ lvb K S A = lvb K2 S2 B $ by subset_antisym [l1, l5]

lvf_functional
--------------
l1: $ G ⇒ functional (cgr3 k j v (lvb k j v)) $ by cgr3_functional
l2o: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional lvf $ by trc_functional_c [l2o, l1]

lvf_node
--------
m0: $ G ⇒ functional lvf $ by lvf_functional
m1: $ G ⇒ isset s $ by isset_var
m2: $ G ⇒ isset (ccom lvf s) $ by ccom_set [m0, m1]
m3: $ G ⇒ functional (cgr3 i j v (lvb i j v)) $ by cgr3_functional
m4o: $ G ⇒ isset ω $ by omega_set
m4: $ G ⇒ fv lvf ⟨ k , s ⟩ = fv (cgr3 i j v (lvb i j v)) ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ $ by trc_node_c [m4o, m3, #1, #2]
n1: $ G , u = ccom lvf s ⇒ isset (lvb k s u) $ by lvb_set
n2: $ G , u = ccom lvf s ⇒ fv (cgr3 i j v (lvb i j v)) ⟨ k , ⟨ s , u ⟩ ⟩ = lvb k s u $ by fv_cgr3 (B := $ lvb i j v $, a := $ k $, b := $ s $, c := $ u $) [n1]
n3: $ G , u = ccom lvf s ⇒ u = ccom lvf s $ by ax
n4: $ G , u = ccom lvf s ⇒ s = s $ by eq_refl
n5: $ G , u = ccom lvf s ⇒ ⟨ s , u ⟩ = ⟨ s , ccom lvf s ⟩ $ by opair_eq [n4, n3]
n6: $ G , u = ccom lvf s ⇒ k = k $ by eq_refl
n7: $ G , u = ccom lvf s ⇒ ⟨ k , ⟨ s , u ⟩ ⟩ = ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ $ by opair_eq [n6, n5]
n8: $ G , u = ccom lvf s ⇒ cgr3 i j v (lvb i j v) = cgr3 i j v (lvb i j v) $ by eq_refl
n9: $ G , u = ccom lvf s ⇒ fv (cgr3 i j v (lvb i j v)) ⟨ k , ⟨ s , u ⟩ ⟩ = fv (cgr3 i j v (lvb i j v)) ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ $ by fv_eq [n8, n7]
n10: $ G , u = ccom lvf s ⇒ fv (cgr3 i j v (lvb i j v)) ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ = fv (cgr3 i j v (lvb i j v)) ⟨ k , ⟨ s , u ⟩ ⟩ $ by eq_sym [n9]
n11: $ G , u = ccom lvf s ⇒ fv (cgr3 i j v (lvb i j v)) ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ = lvb k s u $ by eq_trans [n10, n2]
n12: $ G , u = ccom lvf s ⇒ lvb k s u = lvb k s (ccom lvf s) $ by lvb_eq [n6, n4, n3]
n13: $ G , u = ccom lvf s ⇒ fv lvf ⟨ k , s ⟩ = fv (cgr3 i j v (lvb i j v)) ⟨ k , ⟨ s , ccom lvf s ⟩ ⟩ $ by weaken [m4]
n14: $ G , u = ccom lvf s ⇒ fv lvf ⟨ k , s ⟩ = lvb k s u $ by eq_trans [n13, n11]
n15: $ G , u = ccom lvf s ⇒ fv lvf ⟨ k , s ⟩ = lvb k s (ccom lvf s) $ by eq_trans [n14, n12]
n16: $ G ⇒ fv lvf ⟨ k , s ⟩ = lvb k s (ccom lvf s) $ by isset_elim [m2, n15]

--| The values of a function at the first two components of a sequence.
lemma k4_ch0 (G: hyps) (F T S: class): $ G ⇒ functional F $ > $ G ⇒ T ∈ cdm F $ > $ G ⇒ isset S $ > $ G ⇒ fv (ccom F (scons T S)) ∅ = fv F T $
----
l1: $ G ⇒ ccom F (scons T S) = scons (fv F T) (ccom F S) $ by ccom_scons_c [#1, #2, #3]
l2: $ G ⇒ ∅ = ∅ $ by eq_refl
l3: $ G ⇒ fv (ccom F (scons T S)) ∅ = fv (scons (fv F T) (ccom F S)) ∅ $ by fv_eq [l1, l2]
l4: $ G ⇒ isset T $ by wcel_isset [#2]
l5: $ G ⇒ isset (fv F T) $ by fv_set_c [#1, l4]
l6: $ G ⇒ isset (ccom F S) $ by ccom_set [#1, #3]
l7: $ G ⇒ fv (scons (fv F T) (ccom F S)) ∅ = fv F T $ by scons_fv_zero_c [l5, l6]
l8: $ G ⇒ fv (ccom F (scons T S)) ∅ = fv F T $ by eq_trans [l3, l7]

lemma k4_ch1 (G: hyps) (F T T2 S: class): $ G ⇒ functional F $ > $ G ⇒ T ∈ cdm F $ > $ G ⇒ T2 ∈ cdm F $ > $ G ⇒ isset S $ > $ G ⇒ isset (scons T2 S) $ > $ G ⇒ fv (ccom F (scons T (scons T2 S))) (suc ∅) = fv F T2 $
----
l1: $ G ⇒ ccom F (scons T (scons T2 S)) = scons (fv F T) (ccom F (scons T2 S)) $ by ccom_scons_c [#1, #2, #5]
l2: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l3: $ G ⇒ fv (ccom F (scons T (scons T2 S))) (suc ∅) = fv (scons (fv F T) (ccom F (scons T2 S))) (suc ∅) $ by fv_eq [l1, l2]
l4: $ G ⇒ isset T $ by wcel_isset [#2]
l5: $ G ⇒ isset (fv F T) $ by fv_set_c [#1, l4]
l6: $ G ⇒ isset (ccom F (scons T2 S)) $ by ccom_set [#1, #5]
l7e: $ G ⇒ isset ∅ $ by ax_empty
l7: $ G ⇒ fv (scons (fv F T) (ccom F (scons T2 S))) (suc ∅) = fv (ccom F (scons T2 S)) ∅ $ by scons_fv_suc_c [l5, l6, l7e]
l8: $ G ⇒ fv (ccom F (scons T2 S)) ∅ = fv F T2 $ by k4_ch0 [#1, #3, #4]
l9: $ G ⇒ fv (ccom F (scons T (scons T2 S))) (suc ∅) = fv (ccom F (scons T2 S)) ∅ $ by eq_trans [l3, l7]
l10: $ G ⇒ fv (ccom F (scons T (scons T2 S))) (suc ∅) = fv F T2 $ by eq_trans [l9, l8]

lemma k4_lvb_none (G: hyps) (K S V: class): $ G ⇒ ¬ K = kc_ls $ > $ G ⇒ ¬ K = kc_lmax $ > $ G ⇒ ¬ K = kc_limax $ > $ G ⇒ ¬ K = kc_lparam $ > $ G ⇒ lvb K S V = ∅ $
----
l1: $ G , y ∊ lvb K S V ⇒ y ∊ lvb K S V $ by ax
l2: $ G , y ∊ lvb K S V ⇒ (K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x))) ∨ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by cab_elim [l1]
m0a: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) $ by ax
m0b: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ K = kc_ls $ by and_elim_l [m0a]
m0c: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ ¬ K = kc_ls $ by weaken [#1]
m0d: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ ⊥ $ by not_elim [m0c, m0b]
m1a: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by ax
m1b: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_lmax $ by and_elim_l [m1a]
m1c: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ ¬ K = kc_lmax $ by weaken [#2]
m1d: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ ⊥ $ by not_elim [m1c, m1b]
m2a: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by ax
m2b: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_limax $ by and_elim_l [m2a]
m2c: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ ¬ K = kc_limax $ by weaken [#3]
m2d: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ ⊥ $ by not_elim [m2c, m2b]
m3a: $ G , y ∊ lvb K S V , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by ax
m3b: $ G , y ∊ lvb K S V , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K = kc_lparam $ by and_elim_l [m3a]
m3c: $ G , y ∊ lvb K S V , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ ¬ K = kc_lparam $ by weaken [#4]
m3d: $ G , y ∊ lvb K S V , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ ⊥ $ by not_elim [m3c, m3b]
l3: $ G , y ∊ lvb K S V ⇒ ⊥ $ by k4_or4 [l2, m0d, m1d, m2d, m3d]
l4: $ G ⇒ lvb K S V = ∅ $ by empty_eq_intro [l3]

lemma k4_lvb_ls {x: set} (G: hyps x) (K S V: class): $ G ⇒ K = kc_ls $ > $ G ⇒ lvb K S V = clam x lvals (suc (ap (fv V ∅) x)) $
----
l1: $ G , y ∊ lvb K S V ⇒ y ∊ lvb K S V $ by ax
l2: $ G , y ∊ lvb K S V ⇒ (K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x))) ∨ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by cab_elim [l1]
m0a: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) $ by ax
m0z: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ y ∊ clam x lvals (suc (ap (fv V ∅) x)) $ by and_elim_r [m0a]
