l19: $ G ⇒ lv ⟨ kc_limax , scons c (scons d ∅) ⟩ w = nimax (lv c w) (lv d w) $ by lv_limax [l15, l16, #5]
l20: $ G ⇒ lv z w = lv ⟨ kc_limax , scons c (scons d ∅) ⟩ w $ by lv_eq [#2, l17]
l21: $ G ⇒ lv ⟨ kc_limax , scons a (scons b ∅) ⟩ f = nimax (lv a f) (lv b f) $ by lv_limax [l7, l8, #6]
l22: $ G ⇒ lv q f = lv ⟨ kc_limax , scons a (scons b ∅) ⟩ f $ by lv_eq [#1, l18]
l23: $ G ⇒ nimax (lv c w) (lv d w) = nimax (lv a f) (lv b f) $ by nimax_eq [#7, #8]
l24: $ G ⇒ lv z w = nimax (lv c w) (lv d w) $ by eq_trans [l20, l19]
l25: $ G ⇒ lv z w = nimax (lv a f) (lv b f) $ by eq_trans [l24, l23]
l26: $ G ⇒ lv q f = nimax (lv a f) (lv b f) $ by eq_trans [l22, l21]
l27: $ G ⇒ nimax (lv a f) (lv b f) = lv q f $ by eq_sym [l26]
l28: $ G ⇒ lv z w = lv q f $ by eq_trans [l25, l27]

lemma k5_cs_pi (G: hyps) (q z n e f w: set):
  $ G ⇒ q = ⟨ kc_lparam , scons n ∅ ⟩ $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ f = lsub e $ > $ G ⇒ f ∊ lvals $ > $ G ⇒ lv z w = fv e (fv nvf n) $ > $ G ⇒ lv z w = lv q f $
----
l1: $ G ⇒ ⟨ kc_lparam , scons n ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #2]
l2: $ G ⇒ kc_lparam ∈ ω $ by kc_lparam_omega
l3: $ G ⇒ isset kc_lparam $ by wcel_isset [l2]
l4: $ G ⇒ n ∊ trees ω $ by k5_ch1 [l1, l3]
l5: $ G ⇒ n ∈ trees ω $ by welc_wcel [l4]
l6: $ G ⇒ f = f $ by eq_refl
l7: $ G ⇒ lv ⟨ kc_lparam , scons n ∅ ⟩ f = ap f (fv nvf n) $ by lv_lparam [l5, #4]
l8: $ G ⇒ lv q f = lv ⟨ kc_lparam , scons n ∅ ⟩ f $ by lv_eq [#1, l6]
l9: $ G ⇒ fv nvf n = fv nvf n $ by eq_refl
l10: $ G ⇒ ap f (fv nvf n) = ap (lsub e) (fv nvf n) $ by ap_eq [#3, l9]
l11: $ G ⇒ isset n $ by isset_var
l12: $ G ⇒ fv nvf n ∈ ω $ by nvf_omega [l11]
l13: $ G ⇒ ap (lsub e) (fv nvf n) = fv e (fv nvf n) $ by lsub_ap_c [l12]
l14: $ G ⇒ lv q f = ap f (fv nvf n) $ by eq_trans [l8, l7]
l15: $ G ⇒ lv q f = ap (lsub e) (fv nvf n) $ by eq_trans [l14, l10]
l16: $ G ⇒ lv q f = fv e (fv nvf n) $ by eq_trans [l15, l13]
l17: $ G ⇒ fv e (fv nvf n) = lv q f $ by eq_sym [l16]
l18: $ G ⇒ lv z w = lv q f $ by eq_trans [#5, l17]

lemma k5_cs_ne (G: hyps) (q z m w f i j: set):
  $ G ⇒ q = ⟨ kc_lparam , scons m ∅ ⟩ $ > $ G ⇒ z = ⟨ kc_lparam , scons m ∅ ⟩ $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ f = lupd w i j $ > $ G ⇒ f ∊ lvals $ > $ G ⇒ ¬ fv nvf m = i $ > $ G ⇒ lv z w = lv q f $
----
l1: $ G ⇒ ⟨ kc_lparam , scons m ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #3]
l2: $ G ⇒ kc_lparam ∈ ω $ by kc_lparam_omega
l3: $ G ⇒ isset kc_lparam $ by wcel_isset [l2]
l4: $ G ⇒ m ∊ trees ω $ by k5_ch1 [l1, l3]
l5: $ G ⇒ m ∈ trees ω $ by welc_wcel [l4]
l6: $ G ⇒ w = w $ by eq_refl
l7: $ G ⇒ f = f $ by eq_refl
l8: $ G ⇒ lv ⟨ kc_lparam , scons m ∅ ⟩ w = ap w (fv nvf m) $ by lv_lparam [l5, #4]
l9: $ G ⇒ lv z w = lv ⟨ kc_lparam , scons m ∅ ⟩ w $ by lv_eq [#2, l6]
l10: $ G ⇒ lv ⟨ kc_lparam , scons m ∅ ⟩ f = ap f (fv nvf m) $ by lv_lparam [l5, #6]
l11: $ G ⇒ lv q f = lv ⟨ kc_lparam , scons m ∅ ⟩ f $ by lv_eq [#1, l7]
l12: $ G ⇒ fv nvf m = fv nvf m $ by eq_refl
l13: $ G ⇒ ap f (fv nvf m) = ap (lupd w i j) (fv nvf m) $ by ap_eq [#5, l12]
l14: $ G ⇒ isset m $ by isset_var
l15: $ G ⇒ fv nvf m ∈ ω $ by nvf_omega [l14]
l16: $ G ⇒ ap (lupd w i j) (fv nvf m) = ap w (fv nvf m) $ by lupd_ap_ne_c [l15, #7]
l17: $ G ⇒ lv z w = ap w (fv nvf m) $ by eq_trans [l9, l8]
l18: $ G ⇒ lv q f = ap f (fv nvf m) $ by eq_trans [l11, l10]
l19: $ G ⇒ lv q f = ap (lupd w i j) (fv nvf m) $ by eq_trans [l18, l13]
l20: $ G ⇒ lv q f = ap w (fv nvf m) $ by eq_trans [l19, l16]
l21: $ G ⇒ ap w (fv nvf m) = lv q f $ by eq_sym [l20]
l22: $ G ⇒ lv z w = lv q f $ by eq_trans [l17, l21]

lemma k5_cs_eq (G: hyps) (q z n u w f i j: set):
  $ G ⇒ q = ⟨ kc_lparam , scons n ∅ ⟩ $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ f = lupd w i j $ > $ G ⇒ f ∊ lvals $ > $ G ⇒ i ∊ ω $ > $ G ⇒ fv nvf n = i $ > $ G ⇒ z = u $ > $ G ⇒ j = lv u w $ > $ G ⇒ lv z w = lv q f $
----
l1: $ G ⇒ ⟨ kc_lparam , scons n ∅ ⟩ ∈ trees ω $ by wcel_intro [#1, #2]
l2: $ G ⇒ kc_lparam ∈ ω $ by kc_lparam_omega
l3: $ G ⇒ isset kc_lparam $ by wcel_isset [l2]
l4: $ G ⇒ n ∊ trees ω $ by k5_ch1 [l1, l3]
l5: $ G ⇒ n ∈ trees ω $ by welc_wcel [l4]
l6: $ G ⇒ w = w $ by eq_refl
l7: $ G ⇒ f = f $ by eq_refl
l8: $ G ⇒ lv ⟨ kc_lparam , scons n ∅ ⟩ f = ap f (fv nvf n) $ by lv_lparam [l5, #4]
l9: $ G ⇒ lv q f = lv ⟨ kc_lparam , scons n ∅ ⟩ f $ by lv_eq [#1, l7]
l10: $ G ⇒ fv nvf n = fv nvf n $ by eq_refl
l11: $ G ⇒ ap f (fv nvf n) = ap (lupd w i j) (fv nvf n) $ by ap_eq [#3, l10]
l12: $ G ⇒ lupd w i j = lupd w i j $ by eq_refl
l13: $ G ⇒ ap (lupd w i j) (fv nvf n) = ap (lupd w i j) i $ by ap_eq [l12, #6]
l14: $ G ⇒ ap (lupd w i j) i = j $ by lupd_ap_eq [#5]
l15: $ G ⇒ lv q f = ap f (fv nvf n) $ by eq_trans [l9, l8]
l16: $ G ⇒ lv q f = ap (lupd w i j) (fv nvf n) $ by eq_trans [l15, l11]
l17: $ G ⇒ lv q f = ap (lupd w i j) i $ by eq_trans [l16, l13]
l18: $ G ⇒ lv q f = j $ by eq_trans [l17, l14]
l19: $ G ⇒ lv z w = lv u w $ by lv_eq [#7, l6]
l20: $ G ⇒ lv u w = j $ by eq_sym [#8]
l21: $ G ⇒ lv z w = j $ by eq_trans [l19, l20]
l22: $ G ⇒ j = lv q f $ by eq_sym [l18]
l23: $ G ⇒ lv z w = lv q f $ by eq_trans [l21, l22]

lemma k5_mv2 (G: hyps) (K A B D: class):
  $ G ⇒ ⟨ K , scons A (scons B ∅) ⟩ ∈ lrel $ > $ G ⇒ A = D $ > $ G ⇒ ⟨ K , scons D (scons B ∅) ⟩ ∈ lrel $
----
l1: $ G ⇒ scons B ∅ = scons B ∅ $ by eq_refl
l2: $ G ⇒ scons A (scons B ∅) = scons D (scons B ∅) $ by scons_eq [#2, l1]
l3: $ G ⇒ K = K $ by eq_refl
l4: $ G ⇒ ⟨ K , scons A (scons B ∅) ⟩ = ⟨ K , scons D (scons B ∅) ⟩ $ by opair_eq [l3, l2]
l5: $ G ⇒ ⟨ K , scons D (scons B ∅) ⟩ ∈ lrel $ by wcel_eq_l [l4, #1]

lemma k5_lt_ne (G: hyps) (m n i: set):
  $ G ⇒ ra_le ⟨ kc_s , scons m ∅ ⟩ n ∈ lrel $ > $ G ⇒ m ∈ trees ω $ > $ G ⇒ fv nvf n = i $ > $ G ⇒ ¬ fv nvf m = i $
----
l1: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ r = ⟨ kc_s , scons m ∅ ⟩ $ by ax
l2: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ ⟨ kc_s , scons m ∅ ⟩ = r $ by eq_sym [l1]
l3: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ ra_le ⟨ kc_s , scons m ∅ ⟩ n ∈ lrel $ by weaken [#1]
l4: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ ⟨ kr_le , scons r (scons n ∅) ⟩ ∈ lrel $ by k5_mv2 [l3, l2]
l5: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ fv nvf r ⊆ fv nvf n $ by lrel_le_sem [l4]
l6: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l7: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ fv nvf r = fv nvf ⟨ kc_s , scons m ∅ ⟩ $ by fv_eq [l6, l1]
l8: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ m ∈ trees ω $ by weaken [#2]
l9: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ fv nvf ⟨ kc_s , scons m ∅ ⟩ = suc (fv nvf m) $ by nvf_s [l8]
l10: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ fv nvf r = suc (fv nvf m) $ by eq_trans [l7, l9]
l11: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ suc (fv nvf m) ⊆ fv nvf n $ by subset_eq_l [l10, l5]
l12: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ fv nvf n = i $ by weaken [#3]
l13: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ suc (fv nvf m) ⊆ i $ by subset_eq_r [l12, l11]
l14: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ isset m $ by isset_var
l15: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ fv nvf m ∈ ω $ by nvf_omega [l14]
l16: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ isset (fv nvf m) $ by wcel_isset [l15]
l17: $ G , r = ⟨ kc_s , scons m ∅ ⟩ ⇒ ¬ fv nvf m = i $ by k5_sne1 [l13, l16]
l18: $ G ⇒ isset ⟨ kc_s , scons m ∅ ⟩ $ by opair_isset
l19: $ G ⇒ ¬ fv nvf m = i $ by isset_elim [l18, l17]

lemma k5_gt_ne (G: hyps) (m n i: set):
  $ G ⇒ ra_le ⟨ kc_s , scons n ∅ ⟩ m ∈ lrel $ > $ G ⇒ n ∈ trees ω $ > $ G ⇒ fv nvf n = i $ > $ G ⇒ ¬ fv nvf m = i $
----
l1: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ r = ⟨ kc_s , scons n ∅ ⟩ $ by ax
l2: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ ⟨ kc_s , scons n ∅ ⟩ = r $ by eq_sym [l1]
l3: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ ra_le ⟨ kc_s , scons n ∅ ⟩ m ∈ lrel $ by weaken [#1]
l4: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ ⟨ kr_le , scons r (scons m ∅) ⟩ ∈ lrel $ by k5_mv2 [l3, l2]
l5: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ fv nvf r ⊆ fv nvf m $ by lrel_le_sem [l4]
l6: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
l7: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ fv nvf r = fv nvf ⟨ kc_s , scons n ∅ ⟩ $ by fv_eq [l6, l1]
l8: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ n ∈ trees ω $ by weaken [#2]
l9: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ fv nvf ⟨ kc_s , scons n ∅ ⟩ = suc (fv nvf n) $ by nvf_s [l8]
l10: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ fv nvf r = suc (fv nvf n) $ by eq_trans [l7, l9]
l11: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ suc (fv nvf n) ⊆ fv nvf m $ by subset_eq_l [l10, l5]
l12: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ fv nvf n = i $ by weaken [#3]
l13: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ suc (fv nvf n) = suc i $ by suc_eq [l12]
l14: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ suc i ⊆ fv nvf m $ by subset_eq_l [l13, l11]
l15: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ isset i $ by isset_var
l16: $ G , r = ⟨ kc_s , scons n ∅ ⟩ ⇒ ¬ fv nvf m = i $ by k5_sne2 [l14, l15]
l17: $ G ⇒ isset ⟨ kc_s , scons n ∅ ⟩ $ by opair_isset
l18: $ G ⇒ ¬ fv nvf m = i $ by isset_elim [l17, l16]

