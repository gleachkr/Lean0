m3e: $ G , y ∊ lvb K S V , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ ⊥ $ by not_elim [m3g, m3f]
m3z: $ G , y ∊ lvb K S V , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by bot_elim [m3e]
l3: $ G , y ∊ lvb K S V ⇒ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by k4_or4 [l2, m0z, m1z, m2z, m3z]
r1: $ G , y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_limax $ by weaken [#1]
r2: $ G , y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by ax
r3: $ G , y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by and_intro [r1, r2]
r4: $ G , y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by or_intro_l [r3]
r5: $ G , y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by or_intro_r [r4]
r6: $ G , y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ (K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x))) ∨ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by or_intro_r [r5]
r7: $ G , y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ y ∊ lvb K S V $ by cab_intro [r6]
r8: $ G ⇒ lvb K S V = clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by eq_intro [l3, r7]

lemma k4_lvb_lparam {x: set} (G: hyps x) (K S V: class): $ G ⇒ K = kc_lparam $ > $ G ⇒ lvb K S V = clam x lvals (ap x (fv nvf (fv S ∅))) $
----
l1: $ G , y ∊ lvb K S V ⇒ y ∊ lvb K S V $ by ax
l2: $ G , y ∊ lvb K S V ⇒ (K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x))) ∨ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by cab_elim [l1]
m0a: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) $ by ax
m0b: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ K = kc_ls $ by and_elim_l [m0a]
m0c: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ K = kc_lparam $ by weaken [#1]
m0d: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ kc_ls = K $ by eq_sym [m0b]
m0f: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ kc_ls = kc_lparam $ by eq_trans [m0d, m0c]
m0g: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ ¬ kc_ls = kc_lparam $ by kc_ls_ne_lparam
m0e: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ ⊥ $ by not_elim [m0g, m0f]
m0z: $ G , y ∊ lvb K S V , K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x)) ⇒ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by bot_elim [m0e]
m1a: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by ax
m1b: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_lmax $ by and_elim_l [m1a]
m1c: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_lparam $ by weaken [#1]
m1d: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ kc_lmax = K $ by eq_sym [m1b]
m1f: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ kc_lmax = kc_lparam $ by eq_trans [m1d, m1c]
m1g: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ ¬ kc_lmax = kc_lparam $ by kc_lmax_ne_lparam
m1e: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ ⊥ $ by not_elim [m1g, m1f]
m1z: $ G , y ∊ lvb K S V , K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by bot_elim [m1e]
m2a: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by ax
m2b: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_limax $ by and_elim_l [m2a]
m2c: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_lparam $ by weaken [#1]
m2d: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ kc_limax = K $ by eq_sym [m2b]
m2f: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ kc_limax = kc_lparam $ by eq_trans [m2d, m2c]
m2g: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ ¬ kc_limax = kc_lparam $ by kc_limax_ne_lparam
m2e: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ ⊥ $ by not_elim [m2g, m2f]
m2z: $ G , y ∊ lvb K S V , K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) ⇒ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by bot_elim [m2e]
m3a: $ G , y ∊ lvb K S V , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by ax
m3z: $ G , y ∊ lvb K S V , K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by and_elim_r [m3a]
l3: $ G , y ∊ lvb K S V ⇒ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by k4_or4 [l2, m0z, m1z, m2z, m3z]
r1: $ G , y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K = kc_lparam $ by weaken [#1]
r2: $ G , y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by ax
r3: $ G , y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) $ by and_intro [r1, r2]
r4: $ G , y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by or_intro_r [r3]
r5: $ G , y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by or_intro_r [r4]
r6: $ G , y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ (K = kc_ls ∧ y ∊ clam x lvals (suc (ap (fv V ∅) x))) ∨ (K = kc_lmax ∧ y ∊ clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_limax ∧ y ∊ clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) ∨ (K = kc_lparam ∧ y ∊ clam x lvals (ap x (fv nvf (fv S ∅)))) $ by or_intro_r [r5]
r7: $ G , y ∊ clam x lvals (ap x (fv nvf (fv S ∅))) ⇒ y ∊ lvb K S V $ by cab_intro [r6]
r8: $ G ⇒ lvb K S V = clam x lvals (ap x (fv nvf (fv S ∅))) $ by eq_intro [l3, r7]

--| Class form of `lvf_node`.
lvf_node_c
----------
l1: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ m ∊ ω $ by ax
l2: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ q ∊ fseq (trees ω) $ by ax
l3: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lvf ⟨ m , q ⟩ = lvb m q (ccom lvf q) $ by lvf_node [l1, l2]
l4: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ m = K $ by ax
l5: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ q = S $ by ax
l6: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ lvf = lvf $ by eq_refl
l7: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ ccom lvf q = ccom lvf S $ by ccom_eq [l6, l5]
l8: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ lvb m q (ccom lvf q) = lvb K S (ccom lvf S) $ by lvb_eq [l4, l5, l7]
l9: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ ⟨ m , q ⟩ = ⟨ K , S ⟩ $ by opair_eq [l4, l5]
l10: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lvf ⟨ m , q ⟩ = fv lvf ⟨ K , S ⟩ $ by fv_eq [l6, l9]
l11: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lvf ⟨ K , S ⟩ = fv lvf ⟨ m , q ⟩ $ by eq_sym [l10]
l12: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lvf ⟨ K , S ⟩ = lvb m q (ccom lvf q) $ by eq_trans [l11, l3]
l13: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lvf ⟨ K , S ⟩ = lvb K S (ccom lvf S) $ by eq_trans [l12, l8]
l14: $ G , m = K , m ∊ ω ⇒ fv lvf ⟨ K , S ⟩ = lvb K S (ccom lvf S) $ by wcel_elim [#2, l13]
l15: $ G ⇒ fv lvf ⟨ K , S ⟩ = lvb K S (ccom lvf S) $ by wcel_elim [#1, l14]

lvf_cdm
-------
l1: $ G ⇒ functional (cgr3 k j v (lvb k j v)) $ by cgr3_functional
l2o: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ cdm lvf = trees ω $ by trc_cdm_c [l2o, l1]

--| A tree is in the domain of `lvf`.
lemma k4_lvf_dom (G: hyps) (T: class): $ G ⇒ T ∈ trees ω $ > $ G ⇒ T ∈ cdm lvf $
----
l1: $ G ⇒ cdm lvf = trees ω $ by lvf_cdm
l2: $ G ⇒ trees ω = cdm lvf $ by eq_sym [l1]
l3: $ G ⇒ T ∈ cdm lvf $ by wcel_eq_r [l2, #1]

lv_lz
-----
l1: $ G ⇒ kc_lz ∈ ω $ by kc_lz_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ G ⇒ fv lvf ⟨ kc_lz , ∅ ⟩ = lvb kc_lz ∅ (ccom lvf ∅) $ by lvf_node_c [l1, l2]
l7: $ G ⇒ ¬ kc_lz = kc_ls $ by kc_lz_ne_ls
l11: $ G ⇒ ¬ kc_lz = kc_lmax $ by kc_lz_ne_lmax
l15: $ G ⇒ ¬ kc_lz = kc_limax $ by kc_lz_ne_limax
l19: $ G ⇒ ¬ kc_lz = kc_lparam $ by kc_lz_ne_lparam
l20: $ G ⇒ lvb kc_lz ∅ (ccom lvf ∅) = ∅ $ by k4_lvb_none [l7, l11, l15, l19]
l21: $ G ⇒ fv lvf ⟨ kc_lz , ∅ ⟩ = ∅ $ by eq_trans [l3, l20]
l22: $ G ⇒ A = A $ by eq_refl
l23: $ G ⇒ ap (fv lvf ⟨ kc_lz , ∅ ⟩) A = ap ∅ A $ by ap_eq [l21, l22]
l24: $ G ⇒ ap ∅ A = ∅ $ by ap_empty
l25: $ G ⇒ ap (fv lvf ⟨ kc_lz , ∅ ⟩) A = ∅ $ by eq_trans [l23, l24]

lv_ls
-----
l1: $ G ⇒ kc_ls ∈ ω $ by kc_ls_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ G ⇒ scons T ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ fv lvf ⟨ kc_ls , scons T ∅ ⟩ = lvb kc_ls (scons T ∅) ((ccom lvf (scons T ∅))) $ by lvf_node_c [l1, l3]
l5: $ G ⇒ kc_ls = kc_ls $ by eq_refl
l6: $ G ⇒ lvb kc_ls (scons T ∅) ((ccom lvf (scons T ∅))) = clam x lvals (suc (ap (fv (ccom lvf (scons T ∅)) ∅) x)) $ by k4_lvb_ls [l5]
l7: $ G ⇒ fv lvf ⟨ kc_ls , scons T ∅ ⟩ = clam x lvals (suc (ap (fv (ccom lvf (scons T ∅)) ∅) x)) $ by eq_trans [l4, l6]
l8: $ G ⇒ w = w $ by eq_refl
l9: $ G ⇒ ap (fv lvf ⟨ kc_ls , scons T ∅ ⟩) w = ap (clam x lvals (suc (ap (fv (ccom lvf (scons T ∅)) ∅) x))) w $ by ap_eq [l7, l8]
l10: $ G ⇒ ap (clam x lvals (suc (ap (fv (ccom lvf (scons T ∅)) ∅) x))) w = suc (ap (fv (ccom lvf (scons T ∅)) ∅) w) $ by clam_ap [#2]
l11: $ G ⇒ functional lvf $ by lvf_functional
l12: $ G ⇒ T ∈ cdm lvf $ by k4_lvf_dom [#1]
l13: $ G ⇒ isset ∅ $ by ax_empty
l14: $ G ⇒ fv ((ccom lvf (scons T ∅))) ∅ = fv lvf T $ by k4_ch0 [l11, l12, l13]
l15: $ G ⇒ ap (fv (ccom lvf (scons T ∅)) ∅) w = ap (fv lvf T) w $ by ap_eq [l14, l8]
l16: $ G ⇒ suc (ap (fv (ccom lvf (scons T ∅)) ∅) w) = suc (ap (fv lvf T) w) $ by suc_eq [l15]
l17: $ G ⇒ ap (fv lvf ⟨ kc_ls , scons T ∅ ⟩) w = suc (ap (fv (ccom lvf (scons T ∅)) ∅) w) $ by eq_trans [l9, l10]
l18: $ G ⇒ ap (fv lvf ⟨ kc_ls , scons T ∅ ⟩) w = suc (ap (fv lvf T) w) $ by eq_trans [l17, l16]

lv_lmax
-------
l1: $ G ⇒ kc_lmax ∈ ω $ by kc_lmax_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3a: $ G ⇒ scons T2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l2]
l3: $ G ⇒ scons T (scons T2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l3a]
l4: $ G ⇒ fv lvf ⟨ kc_lmax , scons T (scons T2 ∅) ⟩ = lvb kc_lmax (scons T (scons T2 ∅)) ((ccom lvf (scons T (scons T2 ∅)))) $ by lvf_node_c [l1, l3]
l5: $ G ⇒ kc_lmax = kc_lmax $ by eq_refl
l6: $ G ⇒ lvb kc_lmax (scons T (scons T2 ∅)) ((ccom lvf (scons T (scons T2 ∅)))) = clam x lvals (nmax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) x) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) x)) $ by k4_lvb_lmax [l5]
l7: $ G ⇒ fv lvf ⟨ kc_lmax , scons T (scons T2 ∅) ⟩ = clam x lvals (nmax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) x) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) x)) $ by eq_trans [l4, l6]
l8: $ G ⇒ w = w $ by eq_refl
l9: $ G ⇒ ap (fv lvf ⟨ kc_lmax , scons T (scons T2 ∅) ⟩) w = ap (clam x lvals (nmax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) x) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) x))) w $ by ap_eq [l7, l8]
l10: $ G ⇒ ap (clam x lvals (nmax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) x) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) x))) w = nmax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) w) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) w) $ by clam_ap [#3]
l11: $ G ⇒ functional lvf $ by lvf_functional
l12: $ G ⇒ T ∈ cdm lvf $ by k4_lvf_dom [#1]
l12a: $ G ⇒ T2 ∈ cdm lvf $ by k4_lvf_dom [#2]
l13: $ G ⇒ isset ∅ $ by ax_empty
l14: $ G ⇒ isset (scons T2 ∅) $ by wcel_isset [l3a]
l15: $ G ⇒ fv ((ccom lvf (scons T (scons T2 ∅)))) ∅ = fv lvf T $ by k4_ch0 [l11, l12, l14]
l16: $ G ⇒ fv ((ccom lvf (scons T (scons T2 ∅)))) (suc ∅) = fv lvf T2 $ by k4_ch1 [l11, l12, l12a, l13, l14]
l17: $ G ⇒ ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) w = ap (fv lvf T) w $ by ap_eq [l15, l8]
l18: $ G ⇒ ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) w = ap (fv lvf T2) w $ by ap_eq [l16, l8]
l19: $ G ⇒ nmax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) w) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) w) = nmax (ap (fv lvf T) w) (ap (fv lvf T2) w) $ by nmax_eq [l17, l18]
l20: $ G ⇒ ap (fv lvf ⟨ kc_lmax , scons T (scons T2 ∅) ⟩) w = nmax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) w) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) w) $ by eq_trans [l9, l10]
l21: $ G ⇒ ap (fv lvf ⟨ kc_lmax , scons T (scons T2 ∅) ⟩) w = nmax (ap (fv lvf T) w) (ap (fv lvf T2) w) $ by eq_trans [l20, l19]

lv_limax
--------
l1: $ G ⇒ kc_limax ∈ ω $ by kc_limax_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3a: $ G ⇒ scons T2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l2]
l3: $ G ⇒ scons T (scons T2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l3a]
l4: $ G ⇒ fv lvf ⟨ kc_limax , scons T (scons T2 ∅) ⟩ = lvb kc_limax (scons T (scons T2 ∅)) ((ccom lvf (scons T (scons T2 ∅)))) $ by lvf_node_c [l1, l3]
l5: $ G ⇒ kc_limax = kc_limax $ by eq_refl
l6: $ G ⇒ lvb kc_limax (scons T (scons T2 ∅)) ((ccom lvf (scons T (scons T2 ∅)))) = clam x lvals (nimax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) x) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) x)) $ by k4_lvb_limax [l5]
l7: $ G ⇒ fv lvf ⟨ kc_limax , scons T (scons T2 ∅) ⟩ = clam x lvals (nimax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) x) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) x)) $ by eq_trans [l4, l6]
l8: $ G ⇒ w = w $ by eq_refl
l9: $ G ⇒ ap (fv lvf ⟨ kc_limax , scons T (scons T2 ∅) ⟩) w = ap (clam x lvals (nimax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) x) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) x))) w $ by ap_eq [l7, l8]
l10: $ G ⇒ ap (clam x lvals (nimax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) x) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) x))) w = nimax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) w) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) w) $ by clam_ap [#3]
l11: $ G ⇒ functional lvf $ by lvf_functional
l12: $ G ⇒ T ∈ cdm lvf $ by k4_lvf_dom [#1]
l12a: $ G ⇒ T2 ∈ cdm lvf $ by k4_lvf_dom [#2]
l13: $ G ⇒ isset ∅ $ by ax_empty
l14: $ G ⇒ isset (scons T2 ∅) $ by wcel_isset [l3a]
l15: $ G ⇒ fv ((ccom lvf (scons T (scons T2 ∅)))) ∅ = fv lvf T $ by k4_ch0 [l11, l12, l14]
l16: $ G ⇒ fv ((ccom lvf (scons T (scons T2 ∅)))) (suc ∅) = fv lvf T2 $ by k4_ch1 [l11, l12, l12a, l13, l14]
l17: $ G ⇒ ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) w = ap (fv lvf T) w $ by ap_eq [l15, l8]
l18: $ G ⇒ ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) w = ap (fv lvf T2) w $ by ap_eq [l16, l8]
l19: $ G ⇒ nimax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) w) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) w) = nimax (ap (fv lvf T) w) (ap (fv lvf T2) w) $ by nimax_eq [l17, l18]
l20: $ G ⇒ ap (fv lvf ⟨ kc_limax , scons T (scons T2 ∅) ⟩) w = nimax (ap (fv (ccom lvf (scons T (scons T2 ∅))) ∅) w) (ap (fv (ccom lvf (scons T (scons T2 ∅))) (suc ∅)) w) $ by eq_trans [l9, l10]
l21: $ G ⇒ ap (fv lvf ⟨ kc_limax , scons T (scons T2 ∅) ⟩) w = nimax (ap (fv lvf T) w) (ap (fv lvf T2) w) $ by eq_trans [l20, l19]

lv_lparam
---------
l1: $ G ⇒ kc_lparam ∈ ω $ by kc_lparam_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ G ⇒ scons T ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ fv lvf ⟨ kc_lparam , scons T ∅ ⟩ = lvb kc_lparam (scons T ∅) ((ccom lvf (scons T ∅))) $ by lvf_node_c [l1, l3]
l5: $ G ⇒ kc_lparam = kc_lparam $ by eq_refl
l6: $ G ⇒ lvb kc_lparam (scons T ∅) ((ccom lvf (scons T ∅))) = clam x lvals (ap x (fv nvf (fv (scons T ∅) ∅))) $ by k4_lvb_lparam [l5]
l7: $ G ⇒ fv lvf ⟨ kc_lparam , scons T ∅ ⟩ = clam x lvals (ap x (fv nvf (fv (scons T ∅) ∅))) $ by eq_trans [l4, l6]
l8: $ G ⇒ w = w $ by eq_refl
l9: $ G ⇒ ap (fv lvf ⟨ kc_lparam , scons T ∅ ⟩) w = ap (clam x lvals (ap x (fv nvf (fv (scons T ∅) ∅)))) w $ by ap_eq [l7, l8]
l10: $ G ⇒ ap (clam x lvals (ap x (fv nvf (fv (scons T ∅) ∅)))) w = ap w (fv nvf (fv (scons T ∅) ∅)) $ by clam_ap [#2]
l11: $ G ⇒ isset T $ by wcel_isset [#1]
l12: $ G ⇒ isset ∅ $ by ax_empty
l13: $ G ⇒ fv (scons T ∅) ∅ = T $ by scons_fv_zero_c [l11, l12]
l14: $ G ⇒ nvf = nvf $ by eq_refl
l15: $ G ⇒ fv nvf (fv (scons T ∅) ∅) = fv nvf T $ by fv_eq [l14, l13]
l16: $ G ⇒ ap w (fv nvf (fv (scons T ∅) ∅)) = ap w (fv nvf T) $ by ap_eq [l8, l15]
l17: $ G ⇒ ap (fv lvf ⟨ kc_lparam , scons T ∅ ⟩) w = ap w (fv nvf (fv (scons T ∅) ∅)) $ by eq_trans [l9, l10]
l18: $ G ⇒ ap (fv lvf ⟨ kc_lparam , scons T ∅ ⟩) w = ap w (fv nvf T) $ by eq_trans [l17, l16]

--| A child's value, read through `ccom` at the index `I` (`∅` past the end), satisfies
--| what every child's value satisfies.
lemma k4_ih {y: set} (G: hyps y) (F Q: class) (j w: set) (I: class): $ G ⇒ functional F $ > $ G ⇒ functional j $ > $ G ⇒ crn j ⊆ cdm F $ > $ G ⇒ crn j ⊆ {y | ap (fv F y) w ∈ Q} $ > $ G ⇒ ∅ ∈ Q $ > $ G ⇒ isset I $ > $ G ⇒ ap (fv (ccom F j) I) w ∈ Q $
----
a1: $ G , i = I , i ∊ cdm j ⇒ functional j $ by weaken [#2]
a2: $ G , i = I , i ∊ cdm j ⇒ isset (fv j i) $ by fv_set [a1]
a3: $ G , i = I , i ∊ cdm j ⇒ i ∊ cdm j $ by ax
a4: $ G , i = I , i ∊ cdm j ⇒ ⟨ i , fv j i ⟩ ∈ j $ by fv_in [a1, a3]
b1: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ c = fv j i $ by ax
b2: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ fv j i = c $ by eq_sym [b1]
b3: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ i = i $ by eq_refl
b4: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ ⟨ i , fv j i ⟩ = ⟨ i , c ⟩ $ by opair_eq [b3, b2]
b5: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ ⟨ i , fv j i ⟩ ∈ j $ by weaken [a4]
b6: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ ⟨ i , c ⟩ ∈ j $ by wcel_eq_l [b4, b5]
b7: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ c ∊ crn j $ by crn_intro [b6]
b8: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ crn j ⊆ cdm F $ by weaken [#3]
b9: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ c ∊ cdm F $ by subset_elim [b8, b7]
b10: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ crn j ⊆ {y | ap (fv F y) w ∈ Q} $ by weaken [#4]
b11: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ c ∊ {y | ap (fv F y) w ∈ Q} $ by subset_elim [b10, b7]
b12: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ ap (fv F c) w ∈ Q $ by cab_elim [b11]
b13: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ fv j i ∈ cdm F $ by wcel_intro [b1, b9]
b14: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ functional F $ by weaken [#1]
b15: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ functional j $ by weaken [#2]
b16: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ i ∊ cdm j $ by ax
b17: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ fv (ccom F j) i = fv F (fv j i) $ by fv_ccom [b14, b15, b16, b13]
b18: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ F = F $ by eq_refl
b19: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ fv F (fv j i) = fv F c $ by fv_eq [b18, b2]
b20: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ fv (ccom F j) i = fv F c $ by eq_trans [b17, b19]
b21: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ i = I $ by ax
b22: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ ccom F j = ccom F j $ by eq_refl
b23: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ fv (ccom F j) i = fv (ccom F j) I $ by fv_eq [b22, b21]
b24: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ fv (ccom F j) I = fv (ccom F j) i $ by eq_sym [b23]
b25: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ fv (ccom F j) I = fv F c $ by eq_trans [b24, b20]
b26: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ w = w $ by eq_refl
b27: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ ap (fv (ccom F j) I) w = ap (fv F c) w $ by ap_eq [b25, b26]
b28: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ ap (fv F c) w = ap (fv (ccom F j) I) w $ by eq_sym [b27]
b29: $ G , i = I , i ∊ cdm j , c = fv j i ⇒ ap (fv (ccom F j) I) w ∈ Q $ by wcel_eq_l [b28, b12]
b30: $ G , i = I , i ∊ cdm j ⇒ ap (fv (ccom F j) I) w ∈ Q $ by isset_elim [a2, b29]
d1: $ G , i = I , ¬ i ∊ cdm j , i ∊ cdm (ccom F j) ⇒ i ∊ cdm (ccom F j) $ by ax
d2: $ G , i = I , ¬ i ∊ cdm j , ⟨ i , b ⟩ ∈ ccom F j ⇒ ⟨ i , b ⟩ ∈ ccom F j $ by ax
d3: $ G , i = I , ¬ i ∊ cdm j , ⟨ i , c ⟩ ∈ j , ⟨ c , b ⟩ ∈ F ⇒ ⟨ i , c ⟩ ∈ j $ by ax
d4: $ G , i = I , ¬ i ∊ cdm j , ⟨ i , c ⟩ ∈ j , ⟨ c , b ⟩ ∈ F ⇒ i ∊ cdm j $ by cdm_intro [d3]
d5: $ G , i = I , ¬ i ∊ cdm j , ⟨ i , c ⟩ ∈ j , ⟨ c , b ⟩ ∈ F ⇒ ¬ i ∊ cdm j $ by ax
d6: $ G , i = I , ¬ i ∊ cdm j , ⟨ i , c ⟩ ∈ j , ⟨ c , b ⟩ ∈ F ⇒ ⊥ $ by not_elim [d5, d4]
d7: $ G , i = I , ¬ i ∊ cdm j , ⟨ i , b ⟩ ∈ ccom F j ⇒ ⊥ $ by ccom_elim [d2, d6]
d8: $ G , i = I , ¬ i ∊ cdm j , i ∊ cdm (ccom F j) ⇒ ⊥ $ by cdm_elim [d1, d7]
d9: $ G , i = I , ¬ i ∊ cdm j ⇒ i ∊ cdm (ccom F j) → ⊥ $ by imp_intro [d8]
d10: $ G , i = I , ¬ i ∊ cdm j ⇒ fv (ccom F j) i = ∅ $ by fv_empty [d9]
d11: $ G , i = I , ¬ i ∊ cdm j ⇒ i = I $ by ax
d12: $ G , i = I , ¬ i ∊ cdm j ⇒ ccom F j = ccom F j $ by eq_refl
d13: $ G , i = I , ¬ i ∊ cdm j ⇒ fv (ccom F j) i = fv (ccom F j) I $ by fv_eq [d12, d11]
d14: $ G , i = I , ¬ i ∊ cdm j ⇒ fv (ccom F j) I = fv (ccom F j) i $ by eq_sym [d13]
d15: $ G , i = I , ¬ i ∊ cdm j ⇒ fv (ccom F j) I = ∅ $ by eq_trans [d14, d10]
d16: $ G , i = I , ¬ i ∊ cdm j ⇒ w = w $ by eq_refl
d17: $ G , i = I , ¬ i ∊ cdm j ⇒ ap (fv (ccom F j) I) w = ap ∅ w $ by ap_eq [d15, d16]
d18: $ G , i = I , ¬ i ∊ cdm j ⇒ ap ∅ w = ∅ $ by ap_empty
d19: $ G , i = I , ¬ i ∊ cdm j ⇒ ap (fv (ccom F j) I) w = ∅ $ by eq_trans [d17, d18]
d20: $ G , i = I , ¬ i ∊ cdm j ⇒ ∅ = ap (fv (ccom F j) I) w $ by eq_sym [d19]
d21: $ G , i = I , ¬ i ∊ cdm j ⇒ ∅ ∈ Q $ by weaken [#5]
d22: $ G , i = I , ¬ i ∊ cdm j ⇒ ap (fv (ccom F j) I) w ∈ Q $ by wcel_eq_l [d20, d21]
e1: $ G , i = I ⇒ i ∊ cdm j ∨ ¬ i ∊ cdm j $ by excluded_middle
e2: $ G , i = I ⇒ ap (fv (ccom F j) I) w ∈ Q $ by or_elim [e1, b30, d22]
e3: $ G ⇒ ap (fv (ccom F j) I) w ∈ Q $ by isset_elim [#6, e2]

lemma k4_lvb_ap_om (G: hyps) (K S V: class) (w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ ap (fv V ∅) w ∈ ω $ > $ G ⇒ ap (fv V (suc ∅)) w ∈ ω $ > $ G ⇒ ap w (fv nvf (fv S ∅)) ∈ ω $ > $ G ⇒ ap (lvb K S V) w ∈ ω $
----
c0a: $ G, K = kc_ls ⇒ K = kc_ls $ by ax
c0b: $ G, K = kc_ls ⇒ lvb K S V = clam x lvals (suc (ap (fv V ∅) x)) $ by k4_lvb_ls [c0a]
c0c: $ G, K = kc_ls ⇒ w = w $ by eq_refl
c0d: $ G, K = kc_ls ⇒ ap (lvb K S V) w = ap (clam x lvals (suc (ap (fv V ∅) x))) w $ by ap_eq [c0b, c0c]
c0e: $ G, K = kc_ls ⇒ w ∊ lvals $ by weaken [#1]
c0f: $ G, K = kc_ls ⇒ ap (clam x lvals (suc (ap (fv V ∅) x))) w = suc (ap (fv V ∅) w) $ by clam_ap [c0e]
c0g: $ G, K = kc_ls ⇒ ap (lvb K S V) w = suc (ap (fv V ∅) w) $ by eq_trans [c0d, c0f]
c0h: $ G, K = kc_ls ⇒ suc (ap (fv V ∅) w) = ap (lvb K S V) w $ by eq_sym [c0g]
c0i: $ G, K = kc_ls ⇒ ap (fv V ∅) w ∈ ω $ by weaken [#2]
c0j: $ G, K = kc_ls ⇒ suc (ap (fv V ∅) w) ∈ ω $ by omega_suc_c [c0i]
c0k: $ G, K = kc_ls ⇒ ap (lvb K S V) w ∈ ω $ by wcel_eq_l [c0h, c0j]
c1a: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ K = kc_lmax $ by ax
c1b: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ lvb K S V = clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by k4_lvb_lmax [c1a]
c1c: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ w = w $ by eq_refl
c1d: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ ap (lvb K S V) w = ap (clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) w $ by ap_eq [c1b, c1c]
c1e: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ w ∊ lvals $ by weaken [#1]
c1f: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ ap (clam x lvals (nmax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) w = nmax (ap (fv V ∅) w) (ap (fv V (suc ∅)) w) $ by clam_ap [c1e]
c1g: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ ap (lvb K S V) w = nmax (ap (fv V ∅) w) (ap (fv V (suc ∅)) w) $ by eq_trans [c1d, c1f]
c1h: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ nmax (ap (fv V ∅) w) (ap (fv V (suc ∅)) w) = ap (lvb K S V) w $ by eq_sym [c1g]
c1i: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ ap (fv V ∅) w ∈ ω $ by weaken [#2]
c1i2: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ ap (fv V (suc ∅)) w ∈ ω $ by weaken [#3]
c1j: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ nmax (ap (fv V ∅) w) (ap (fv V (suc ∅)) w) ∈ ω $ by nmax_omega_c [c1i, c1i2]
c1k: $ G, ¬ K = kc_ls, K = kc_lmax ⇒ ap (lvb K S V) w ∈ ω $ by wcel_eq_l [c1h, c1j]
c2a: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ K = kc_limax $ by ax
c2b: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ lvb K S V = clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x)) $ by k4_lvb_limax [c2a]
c2c: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ w = w $ by eq_refl
c2d: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ ap (lvb K S V) w = ap (clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) w $ by ap_eq [c2b, c2c]
c2e: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ w ∊ lvals $ by weaken [#1]
c2f: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ ap (clam x lvals (nimax (ap (fv V ∅) x) (ap (fv V (suc ∅)) x))) w = nimax (ap (fv V ∅) w) (ap (fv V (suc ∅)) w) $ by clam_ap [c2e]
c2g: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ ap (lvb K S V) w = nimax (ap (fv V ∅) w) (ap (fv V (suc ∅)) w) $ by eq_trans [c2d, c2f]
c2h: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ nimax (ap (fv V ∅) w) (ap (fv V (suc ∅)) w) = ap (lvb K S V) w $ by eq_sym [c2g]
c2i: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ ap (fv V ∅) w ∈ ω $ by weaken [#2]
c2i2: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ ap (fv V (suc ∅)) w ∈ ω $ by weaken [#3]
c2j: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ nimax (ap (fv V ∅) w) (ap (fv V (suc ∅)) w) ∈ ω $ by nimax_omega_c [c2i, c2i2]
c2k: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, K = kc_limax ⇒ ap (lvb K S V) w ∈ ω $ by wcel_eq_l [c2h, c2j]
c3a: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ K = kc_lparam $ by ax
c3b: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ lvb K S V = clam x lvals (ap x (fv nvf (fv S ∅))) $ by k4_lvb_lparam [c3a]
c3c: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ w = w $ by eq_refl
c3d: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ ap (lvb K S V) w = ap (clam x lvals (ap x (fv nvf (fv S ∅)))) w $ by ap_eq [c3b, c3c]
c3e: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ w ∊ lvals $ by weaken [#1]
c3f: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ ap (clam x lvals (ap x (fv nvf (fv S ∅)))) w = ap w (fv nvf (fv S ∅)) $ by clam_ap [c3e]
c3g: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ ap (lvb K S V) w = ap w (fv nvf (fv S ∅)) $ by eq_trans [c3d, c3f]
c3h: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ ap w (fv nvf (fv S ∅)) = ap (lvb K S V) w $ by eq_sym [c3g]
c3j: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ ap w (fv nvf (fv S ∅)) ∈ ω $ by weaken [#4]
c3k: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, K = kc_lparam ⇒ ap (lvb K S V) w ∈ ω $ by wcel_eq_l [c3h, c3j]
c4a: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ¬ K = kc_ls $ by ax
c4b: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ¬ K = kc_lmax $ by ax
c4c: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ¬ K = kc_limax $ by ax
c4d: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ¬ K = kc_lparam $ by ax
c4e: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ lvb K S V = ∅ $ by k4_lvb_none [c4a, c4b, c4c, c4d]
c4f: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ w = w $ by eq_refl
c4g: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ap (lvb K S V) w = ap ∅ w $ by ap_eq [c4e, c4f]
c4h: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ap ∅ w = ∅ $ by ap_empty
c4i: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ap (lvb K S V) w = ∅ $ by eq_trans [c4g, c4h]
c4j: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ∅ = ap (lvb K S V) w $ by eq_sym [c4i]
c4l: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ∅ ∈ ω $ by omega_zero
c4k: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax, ¬ K = kc_lparam ⇒ ap (lvb K S V) w ∈ ω $ by wcel_eq_l [c4j, c4l]
o3a: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax ⇒ K = kc_lparam ∨ ¬ K = kc_lparam $ by excluded_middle
o3b: $ G, ¬ K = kc_ls, ¬ K = kc_lmax, ¬ K = kc_limax ⇒ ap (lvb K S V) w ∈ ω $ by or_elim [o3a, c3k, c4k]
o2a: $ G, ¬ K = kc_ls, ¬ K = kc_lmax ⇒ K = kc_limax ∨ ¬ K = kc_limax $ by excluded_middle
o2b: $ G, ¬ K = kc_ls, ¬ K = kc_lmax ⇒ ap (lvb K S V) w ∈ ω $ by or_elim [o2a, c2k, o3b]
o1a: $ G, ¬ K = kc_ls ⇒ K = kc_lmax ∨ ¬ K = kc_lmax $ by excluded_middle
o1b: $ G, ¬ K = kc_ls ⇒ ap (lvb K S V) w ∈ ω $ by or_elim [o1a, c1k, o2b]
o0a: $ G ⇒ K = kc_ls ∨ ¬ K = kc_ls $ by excluded_middle
o0b: $ G ⇒ ap (lvb K S V) w ∈ ω $ by or_elim [o0a, c0k, o1b]

lemma k4_lv_step {y: set} (G: hyps y) (k j w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ {y | lv y w ∈ ω} $ > $ G ⇒ lv ⟨ k , j ⟩ w ∈ ω $
----
s1: $ G ⇒ fv lvf ⟨ k , j ⟩ = lvb k j (ccom lvf j) $ by lvf_node [#2, #3]
s2: $ G ⇒ w = w $ by eq_refl
s3: $ G ⇒ ap (fv lvf ⟨ k , j ⟩) w = ap (lvb k j (ccom lvf j)) w $ by ap_eq [s1, s2]
s4: $ G ⇒ functional lvf $ by lvf_functional
s5: $ G ⇒ functional j $ by fseq_functional [#3]
s6: $ G ⇒ crn j ⊆ trees ω $ by fseq_crn [#3]
s7: $ G ⇒ cdm lvf = trees ω $ by lvf_cdm
s8: $ G ⇒ trees ω = cdm lvf $ by eq_sym [s7]
s9: $ G ⇒ crn j ⊆ cdm lvf $ by subset_eq_r [s8, s6]
s10: $ G ⇒ ∅ ∈ ω $ by omega_zero
s11: $ G ⇒ isset ∅ $ by ax_empty
s12: $ G ⇒ isset (suc ∅) $ by suc_set [s11]
s13: $ G ⇒ ap (fv (ccom lvf j) ∅) w ∈ ω $ by k4_ih [s4, s5, s9, #4, s10, s11]
s14: $ G ⇒ ap (fv (ccom lvf j) (suc ∅)) w ∈ ω $ by k4_ih [s4, s5, s9, #4, s10, s12]
s15v: $ G ⇒ isset j $ by isset_var
s15: $ G ⇒ isset (ap j ∅) $ by ap_set_c [s15v]
s16: $ G ⇒ isset (fv j ∅) $ by cuni_set [s15]
s17: $ G ⇒ fv nvf (fv j ∅) ∈ ω $ by nvf_omega [s16]
s18: $ G ⇒ ap w (fv nvf (fv j ∅)) ∈ ω $ by lvals_ap_c [#1, s17]
s19: $ G ⇒ ap (lvb k j (ccom lvf j)) w ∈ ω $ by k4_lvb_ap_om [#1, s13, s14, s18]
s20: $ G ⇒ ap (lvb k j (ccom lvf j)) w = ap (fv lvf ⟨ k , j ⟩) w $ by eq_sym [s3]
s21: $ G ⇒ ap (fv lvf ⟨ k , j ⟩) w ∈ ω $ by wcel_eq_l [s20, s19]

lv_omega
--------
t1: $ G ⇒ isset ω $ by omega_set
t2: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ u = ω $ by ax
t3: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ k ∊ u $ by ax
t4: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ k ∊ ω $ by welc_eq [t2, t3]
t5: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ trees u = trees ω $ by trees_eq [t2]
t6: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ j ∊ fseq (trees u) $ by ax
t7: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ j ∊ fseq (trees ω) $ by welc_fseq_eq [t5, t6]
t8: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ crn j ⊆ {y | lv y w ∈ ω} $ by ax
t9: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ w ∊ lvals $ by weaken [#2]
t10: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ lv ⟨ k , j ⟩ w ∈ ω $ by k4_lv_step [t9, t4, t7, t8]
t11: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ isset ⟨ k , j ⟩ $ by opair_isset
t12: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} , c = ⟨ k , j ⟩ ⇒ c = ⟨ k , j ⟩ $ by ax
t13: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} , c = ⟨ k , j ⟩ ⇒ w = w $ by eq_refl
t14: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} , c = ⟨ k , j ⟩ ⇒ lv c w = lv ⟨ k , j ⟩ w $ by lv_eq [t12, t13]
t15: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} , c = ⟨ k , j ⟩ ⇒ lv ⟨ k , j ⟩ w = lv c w $ by eq_sym [t14]
t16: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} , c = ⟨ k , j ⟩ ⇒ lv ⟨ k , j ⟩ w ∈ ω $ by weaken [t10]
t17: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} , c = ⟨ k , j ⟩ ⇒ lv c w ∈ ω $ by wcel_eq_l [t15, t16]
t18: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lv y w ∈ ω} ⇒ ⟨ k , j ⟩ ∈ {y | lv y w ∈ ω} $ by wcel_cab_intro (p := $ lv y w ∈ ω $) [t11, t17]
t19: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) ⇒ crn j ⊆ {y | lv y w ∈ ω} → ⟨ k , j ⟩ ∈ {y | lv y w ∈ ω} $ by imp_intro [t18]
t20: $ G , u = ω , k ∊ u ⇒ j ∊ fseq (trees u) → crn j ⊆ {y | lv y w ∈ ω} → ⟨ k , j ⟩ ∈ {y | lv y w ∈ ω} $ by imp_intro [t19]
t21: $ G , u = ω ⇒ k ∊ u → j ∊ fseq (trees u) → crn j ⊆ {y | lv y w ∈ ω} → ⟨ k , j ⟩ ∈ {y | lv y w ∈ ω} $ by imp_intro [t20]
t22: $ G , u = ω ⇒ ∀ j (k ∊ u → j ∊ fseq (trees u) → crn j ⊆ {y | lv y w ∈ ω} → ⟨ k , j ⟩ ∈ {y | lv y w ∈ ω}) $ by all_intro [t21]
t23: $ G , u = ω ⇒ ∀ k ∀ j (k ∊ u → j ∊ fseq (trees u) → crn j ⊆ {y | lv y w ∈ ω} → ⟨ k , j ⟩ ∈ {y | lv y w ∈ ω}) $ by all_intro [t22]
t24: $ G , u = ω ⇒ trees u ⊆ {y | lv y w ∈ ω} $ by trees_ind [t23]
t25: $ G , u = ω ⇒ u = ω $ by ax
t26: $ G , u = ω ⇒ trees u = trees ω $ by trees_eq [t25]
t27: $ G , u = ω ⇒ trees ω ⊆ {y | lv y w ∈ ω} $ by subset_eq_l [t26, t24]
t28: $ G ⇒ trees ω ⊆ {y | lv y w ∈ ω} $ by isset_elim [t1, t27]
p1: $ G , t = T , t ∊ trees ω ⇒ trees ω ⊆ {y | lv y w ∈ ω} $ by weaken [t28]
p2: $ G , t = T , t ∊ trees ω ⇒ t ∊ trees ω $ by ax
p3: $ G , t = T , t ∊ trees ω ⇒ t ∊ {y | lv y w ∈ ω} $ by subset_elim [p1, p2]
p4: $ G , t = T , t ∊ trees ω ⇒ lv t w ∈ ω $ by cab_elim [p3]
q1: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lvf ⇒ cdm lvf = trees ω $ by lvf_cdm
q2: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lvf ⇒ t ∊ cdm lvf $ by ax
q3: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lvf ⇒ t ∊ trees ω $ by welc_eq [q1, q2]
q4: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lvf ⇒ ¬ t ∊ trees ω $ by ax
q5: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lvf ⇒ ⊥ $ by not_elim [q4, q3]
q6: $ G , t = T , ¬ t ∊ trees ω ⇒ t ∊ cdm lvf → ⊥ $ by imp_intro [q5]
q7: $ G , t = T , ¬ t ∊ trees ω ⇒ fv lvf t = ∅ $ by fv_empty [q6]
q8: $ G , t = T , ¬ t ∊ trees ω ⇒ w = w $ by eq_refl
q9: $ G , t = T , ¬ t ∊ trees ω ⇒ ap (fv lvf t) w = ap ∅ w $ by ap_eq [q7, q8]
q10: $ G , t = T , ¬ t ∊ trees ω ⇒ ap ∅ w = ∅ $ by ap_empty
q11: $ G , t = T , ¬ t ∊ trees ω ⇒ ap (fv lvf t) w = ∅ $ by eq_trans [q9, q10]
q12: $ G , t = T , ¬ t ∊ trees ω ⇒ ∅ = ap (fv lvf t) w $ by eq_sym [q11]
q13: $ G , t = T , ¬ t ∊ trees ω ⇒ ∅ ∈ ω $ by omega_zero
q14: $ G , t = T , ¬ t ∊ trees ω ⇒ lv t w ∈ ω $ by wcel_eq_l [q12, q13]
r1: $ G , t = T ⇒ t ∊ trees ω ∨ ¬ t ∊ trees ω $ by excluded_middle
r2: $ G , t = T ⇒ lv t w ∈ ω $ by or_elim [r1, p4, q14]
r3: $ G , t = T ⇒ t = T $ by ax
r4: $ G , t = T ⇒ w = w $ by eq_refl
r5: $ G , t = T ⇒ lv t w = lv T w $ by lv_eq [r3, r4]
r6: $ G , t = T ⇒ lv T w ∈ ω $ by wcel_eq_l [r5, r2]
r7: $ G ⇒ lv T w ∈ ω $ by isset_elim [#1, r6]

lsb_congr
---------
l0: $ ∅ ≐ ∅ $ by ceqt_refl
l1: $ fv C ∅ ≐ fv D ∅ $ by fv_congr [#2, l0]
l2: $ cv x ≐ cv x $ by ceqt_refl
l3: $ lv (fv C ∅) x ≐ lv (fv D ∅) x $ by lv_congr [l1, l2]
l4: $ suc ∅ ≐ suc ∅ $ by ceqt_refl
l5: $ fv E (suc ∅) ≐ fv F (suc ∅) $ by fv_congr [#3, l4]
l6: $ ap (fv E (suc ∅)) x ≐ ap (fv F (suc ∅)) x $ by ap_congr [l5, l2]
l7: $ scons (lv (fv C ∅) x) (ap (fv E (suc ∅)) x) ≐ scons (lv (fv D ∅) x) (ap (fv F (suc ∅)) x) $ by scons_congr [l3, l6]
l8: $ lvals ≐ lvals $ by ceqt_refl
l9: $ clam x lvals (scons (lv (fv C ∅) x) (ap (fv E (suc ∅)) x)) ≐ clam x lvals (scons (lv (fv D ∅) x) (ap (fv F (suc ∅)) x)) $ by clam_congr [l8, l7]
l10: $ seqt z z $ by seqt_refl
l11: $ (z ∊ clam x lvals (scons (lv (fv C ∅) x) (ap (fv E (suc ∅)) x))) ⟺ (z ∊ clam x lvals (scons (lv (fv D ∅) x) (ap (fv F (suc ∅)) x))) $ by welc_congr [l10, l9]
l12: $ kc_lcons ≐ kc_lcons $ by ceqt_refl
l13: $ (A = kc_lcons) ⟺ (B = kc_lcons) $ by ceq_congr [#1, l12]
l14: $ (A = kc_lcons ∧ z ∊ clam x lvals (scons (lv (fv C ∅) x) (ap (fv E (suc ∅)) x))) ⟺ (B = kc_lcons ∧ z ∊ clam x lvals (scons (lv (fv D ∅) x) (ap (fv F (suc ∅)) x))) $ by and_congr [l13, l11]
l15: $ {z | A = kc_lcons ∧ z ∊ clam x lvals (scons (lv (fv C ∅) x) (ap (fv E (suc ∅)) x))} ≐ {z | B = kc_lcons ∧ z ∊ clam x lvals (scons (lv (fv D ∅) x) (ap (fv F (suc ∅)) x))} $ by cab_congr [l14]

sb_c_lsb
--------
l1: $ (⟦ x / t ⟧ {z | A = kc_lcons ∧ z ∊ clam y lvals (scons (lv (fv B ∅) y) (ap (fv C (suc ∅)) y))}) ≐ {z | (⟦ x / t ⟧ A) = kc_lcons ∧ z ∊ clam y lvals (scons (lv (fv (⟦ x / t ⟧ B) ∅) y) (ap (fv (⟦ x / t ⟧ C) (suc ∅)) y))} $ by ceqt_refl

lsv_congr
---------
l0: $ lsf ≐ lsf $ by ceqt_refl
l1: $ fv lsf A ≐ fv lsf B $ by fv_congr [l0, #1]
l2: $ ap (fv lsf A) C ≐ ap (fv lsf B) D $ by ap_congr [l1, #2]

sb_c_lsv
--------
l1: $ (⟦ x / t ⟧ (ap (fv lsf A) B)) ≐ ap (fv lsf (⟦ x / t ⟧ A)) (⟦ x / t ⟧ B) $ by ceqt_refl

lsv_eq
------
l1: $ G ⇒ lsf = lsf $ by eq_refl
l2: $ G ⇒ fv lsf A = fv lsf B $ by fv_eq [l1, #1]
l3: $ G ⇒ ap (fv lsf A) C = ap (fv lsf B) D $ by ap_eq [l2, #2]

lsb_set
-------
a1v: $ G ⇒ isset v $ by isset_var
a1: $ G ⇒ isset (ap v (suc ∅)) $ by ap_set_c [a1v]
a2: $ G ⇒ isset (fv v (suc ∅)) $ by cuni_set [a1]
b1: $ G , x ∊ lvals ⇒ isset (fv v (suc ∅)) $ by weaken [a2]
b2: $ G , x ∊ lvals ⇒ isset (ap (fv v (suc ∅)) x) $ by ap_set [b1]
b3: $ G , x ∊ lvals ⇒ isset (scons (lv (fv S ∅) x) (ap (fv v (suc ∅)) x)) $ by scons_set [b2]
c1: $ G ⇒ x ∊ lvals → isset (scons (lv (fv S ∅) x) (ap (fv v (suc ∅)) x)) $ by imp_intro [b3]
c2: $ G ⇒ ∀ x (x ∊ lvals → isset (scons (lv (fv S ∅) x) (ap (fv v (suc ∅)) x))) $ by all_intro [c1]
d0: $ G ⇒ isset lvals $ by lvals_set
d1: $ G ⇒ isset (clam x lvals (scons (lv (fv S ∅) x) (ap (fv v (suc ∅)) x))) $ by clam_set [d0, c2]
e1: $ G , y ∊ lsb K S v ⇒ y ∊ lsb K S v $ by ax
e2: $ G , y ∊ lsb K S v ⇒ K = kc_lcons ∧ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv v (suc ∅)) x)) $ by cab_elim [e1]
e3: $ G , y ∊ lsb K S v ⇒ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv v (suc ∅)) x)) $ by and_elim_r [e2]
e4: $ G ⇒ lsb K S v ⊆ clam x lvals (scons (lv (fv S ∅) x) (ap (fv v (suc ∅)) x)) $ by subset_intro [e3]
e5: $ G ⇒ isset (lsb K S v) $ by subset_isset [d1, e4]

lemma k4_lsb_sub (G: hyps) (K K2 S S2 A B: class): $ G ⇒ K = K2 $ > $ G ⇒ S = S2 $ > $ G ⇒ A = B $ > $ G ⇒ lsb K S A ⊆ lsb K2 S2 B $
----
e0: $ G ⇒ ∅ = ∅ $ by eq_refl
e1: $ G ⇒ fv S ∅ = fv S2 ∅ $ by fv_eq [#2, e0]
e2: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
e3: $ G ⇒ fv A (suc ∅) = fv B (suc ∅) $ by fv_eq [#3, e2]
f0: $ G , x ∊ lvals ⇒ x = x $ by eq_refl
f1: $ G , x ∊ lvals ⇒ fv S ∅ = fv S2 ∅ $ by weaken [e1]
f2: $ G , x ∊ lvals ⇒ lv (fv S ∅) x = lv (fv S2 ∅) x $ by lv_eq [f1, f0]
f3: $ G , x ∊ lvals ⇒ fv A (suc ∅) = fv B (suc ∅) $ by weaken [e3]
f4: $ G , x ∊ lvals ⇒ ap (fv A (suc ∅)) x = ap (fv B (suc ∅)) x $ by ap_eq [f3, f0]
f5: $ G , x ∊ lvals ⇒ scons (lv (fv S ∅) x) (ap (fv A (suc ∅)) x) = scons (lv (fv S2 ∅) x) (ap (fv B (suc ∅)) x) $ by scons_eq [f2, f4]
g1: $ G ⇒ x ∊ lvals → scons (lv (fv S ∅) x) (ap (fv A (suc ∅)) x) = scons (lv (fv S2 ∅) x) (ap (fv B (suc ∅)) x) $ by imp_intro [f5]
g2: $ G ⇒ ∀ x (x ∊ lvals → scons (lv (fv S ∅) x) (ap (fv A (suc ∅)) x) = scons (lv (fv S2 ∅) x) (ap (fv B (suc ∅)) x)) $ by all_intro [g1]
h1: $ G ⇒ clam x lvals (scons (lv (fv S ∅) x) (ap (fv A (suc ∅)) x)) = clam x lvals (scons (lv (fv S2 ∅) x) (ap (fv B (suc ∅)) x)) $ by clam_eq_body [g2]
h2: $ G ⇒ K2 = K $ by eq_sym [#1]
i1: $ G , y ∊ lsb K S A ⇒ y ∊ lsb K S A $ by ax
i2: $ G , y ∊ lsb K S A ⇒ K = kc_lcons ∧ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv A (suc ∅)) x)) $ by cab_elim [i1]
i3: $ G , y ∊ lsb K S A ⇒ K = kc_lcons $ by and_elim_l [i2]
i4: $ G , y ∊ lsb K S A ⇒ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv A (suc ∅)) x)) $ by and_elim_r [i2]
i5: $ G , y ∊ lsb K S A ⇒ clam x lvals (scons (lv (fv S ∅) x) (ap (fv A (suc ∅)) x)) = clam x lvals (scons (lv (fv S2 ∅) x) (ap (fv B (suc ∅)) x)) $ by weaken [h1]
i6: $ G , y ∊ lsb K S A ⇒ y ∊ clam x lvals (scons (lv (fv S2 ∅) x) (ap (fv B (suc ∅)) x)) $ by welc_eq [i5, i4]
i7: $ G , y ∊ lsb K S A ⇒ K2 = K $ by weaken [h2]
i8: $ G , y ∊ lsb K S A ⇒ K2 = kc_lcons $ by eq_trans [i7, i3]
i9: $ G , y ∊ lsb K S A ⇒ K2 = kc_lcons ∧ y ∊ clam x lvals (scons (lv (fv S2 ∅) x) (ap (fv B (suc ∅)) x)) $ by and_intro [i8, i6]
i10: $ G , y ∊ lsb K S A ⇒ y ∊ lsb K2 S2 B $ by cab_intro [i9]
i11: $ G ⇒ lsb K S A ⊆ lsb K2 S2 B $ by subset_intro [i10]

lsb_eq
------
l1: $ G ⇒ lsb K S A ⊆ lsb K2 S2 B $ by k4_lsb_sub [#1, #2, #3]
l2: $ G ⇒ K2 = K $ by eq_sym [#1]
l3: $ G ⇒ S2 = S $ by eq_sym [#2]
l4: $ G ⇒ B = A $ by eq_sym [#3]
l5: $ G ⇒ lsb K2 S2 B ⊆ lsb K S A $ by k4_lsb_sub [l2, l3, l4]
l6: $ G ⇒ lsb K S A = lsb K2 S2 B $ by subset_antisym [l1, l5]

lemma k4_lsb_lcons {x: set} (G: hyps x) (K S V: class): $ G ⇒ K = kc_lcons $ > $ G ⇒ lsb K S V = clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) $
----
l1: $ G , y ∊ lsb K S V ⇒ y ∊ lsb K S V $ by ax
l2: $ G , y ∊ lsb K S V ⇒ K = kc_lcons ∧ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) $ by cab_elim [l1]
l3: $ G , y ∊ lsb K S V ⇒ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) $ by and_elim_r [l2]
l4: $ G , y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_lcons $ by weaken [#1]
l5: $ G , y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) ⇒ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) $ by ax
l6: $ G , y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) ⇒ K = kc_lcons ∧ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) $ by and_intro [l4, l5]
l7: $ G , y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) ⇒ y ∊ lsb K S V $ by cab_intro [l6]
l8: $ G ⇒ lsb K S V = clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) $ by eq_intro [l3, l7]

lemma k4_lsb_none (G: hyps) (K S V: class): $ G ⇒ ¬ K = kc_lcons $ > $ G ⇒ lsb K S V = ∅ $
----
l1: $ G , y ∊ lsb K S V ⇒ y ∊ lsb K S V $ by ax
l2: $ G , y ∊ lsb K S V ⇒ K = kc_lcons ∧ y ∊ clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) $ by cab_elim [l1]
l3: $ G , y ∊ lsb K S V ⇒ K = kc_lcons $ by and_elim_l [l2]
l4: $ G , y ∊ lsb K S V ⇒ ¬ K = kc_lcons $ by weaken [#1]
l5: $ G , y ∊ lsb K S V ⇒ ⊥ $ by not_elim [l4, l3]
l6: $ G ⇒ lsb K S V = ∅ $ by empty_eq_intro [l5]

lsf_functional
--------------
l1: $ G ⇒ functional (cgr3 k j v (lsb k j v)) $ by cgr3_functional
l2o: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional lsf $ by trc_functional_c [l2o, l1]

lsf_cdm
-------
l1: $ G ⇒ functional (cgr3 k j v (lsb k j v)) $ by cgr3_functional
l2o: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ cdm lsf = trees ω $ by trc_cdm_c [l2o, l1]

lemma k4_lsf_dom (G: hyps) (T: class): $ G ⇒ T ∈ trees ω $ > $ G ⇒ T ∈ cdm lsf $
----
l1: $ G ⇒ cdm lsf = trees ω $ by lsf_cdm
l2: $ G ⇒ trees ω = cdm lsf $ by eq_sym [l1]
l3: $ G ⇒ T ∈ cdm lsf $ by wcel_eq_r [l2, #1]

--| The recursion equation of `lsf`, at any node.
lsf_node
--------
m0: $ G ⇒ functional lsf $ by lsf_functional
m1: $ G ⇒ isset q $ by isset_var
m2: $ G ⇒ isset (ccom lsf q) $ by ccom_set [m0, m1]
m3: $ G ⇒ functional (cgr3 i j v (lsb i j v)) $ by cgr3_functional
m4o: $ G ⇒ isset ω $ by omega_set
m4: $ G ⇒ fv lsf ⟨ k , q ⟩ = fv (cgr3 i j v (lsb i j v)) ⟨ k , ⟨ q , ccom lsf q ⟩ ⟩ $ by trc_node_c [m4o, m3, #1, #2]
n1: $ G , u = ccom lsf q ⇒ isset (lsb k q u) $ by lsb_set
n2: $ G , u = ccom lsf q ⇒ fv (cgr3 i j v (lsb i j v)) ⟨ k , ⟨ q , u ⟩ ⟩ = lsb k q u $ by fv_cgr3 (B := $ lsb i j v $, a := $ k $, b := $ q $, c := $ u $) [n1]
n3: $ G , u = ccom lsf q ⇒ u = ccom lsf q $ by ax
n4: $ G , u = ccom lsf q ⇒ q = q $ by eq_refl
n5: $ G , u = ccom lsf q ⇒ ⟨ q , u ⟩ = ⟨ q , ccom lsf q ⟩ $ by opair_eq [n4, n3]
n6: $ G , u = ccom lsf q ⇒ k = k $ by eq_refl
n7: $ G , u = ccom lsf q ⇒ ⟨ k , ⟨ q , u ⟩ ⟩ = ⟨ k , ⟨ q , ccom lsf q ⟩ ⟩ $ by opair_eq [n6, n5]
n8: $ G , u = ccom lsf q ⇒ cgr3 i j v (lsb i j v) = cgr3 i j v (lsb i j v) $ by eq_refl
n9: $ G , u = ccom lsf q ⇒ fv (cgr3 i j v (lsb i j v)) ⟨ k , ⟨ q , u ⟩ ⟩ = fv (cgr3 i j v (lsb i j v)) ⟨ k , ⟨ q , ccom lsf q ⟩ ⟩ $ by fv_eq [n8, n7]
n10: $ G , u = ccom lsf q ⇒ fv (cgr3 i j v (lsb i j v)) ⟨ k , ⟨ q , ccom lsf q ⟩ ⟩ = fv (cgr3 i j v (lsb i j v)) ⟨ k , ⟨ q , u ⟩ ⟩ $ by eq_sym [n9]
n11: $ G , u = ccom lsf q ⇒ fv (cgr3 i j v (lsb i j v)) ⟨ k , ⟨ q , ccom lsf q ⟩ ⟩ = lsb k q u $ by eq_trans [n10, n2]
n12: $ G , u = ccom lsf q ⇒ lsb k q u = lsb k q (ccom lsf q) $ by lsb_eq [n6, n4, n3]
n13: $ G , u = ccom lsf q ⇒ fv lsf ⟨ k , q ⟩ = fv (cgr3 i j v (lsb i j v)) ⟨ k , ⟨ q , ccom lsf q ⟩ ⟩ $ by weaken [m4]
n14: $ G , u = ccom lsf q ⇒ fv lsf ⟨ k , q ⟩ = lsb k q u $ by eq_trans [n13, n11]
n15: $ G , u = ccom lsf q ⇒ fv lsf ⟨ k , q ⟩ = lsb k q (ccom lsf q) $ by eq_trans [n14, n12]
n16: $ G ⇒ fv lsf ⟨ k , q ⟩ = lsb k q (ccom lsf q) $ by isset_elim [m2, n15]

lsf_node_c
----------
l1: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ m ∊ ω $ by ax
l2: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ q ∊ fseq (trees ω) $ by ax
l3: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lsf ⟨ m , q ⟩ = lsb m q (ccom lsf q) $ by lsf_node [l1, l2]
l4: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ m = K $ by ax
l5: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ q = S $ by ax
l6: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ lsf = lsf $ by eq_refl
l7: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ ccom lsf q = ccom lsf S $ by ccom_eq [l6, l5]
l8: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ lsb m q (ccom lsf q) = lsb K S (ccom lsf S) $ by lsb_eq [l4, l5, l7]
l9: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ ⟨ m , q ⟩ = ⟨ K , S ⟩ $ by opair_eq [l4, l5]
l10: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lsf ⟨ m , q ⟩ = fv lsf ⟨ K , S ⟩ $ by fv_eq [l6, l9]
l11: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lsf ⟨ K , S ⟩ = fv lsf ⟨ m , q ⟩ $ by eq_sym [l10]
l12: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lsf ⟨ K , S ⟩ = lsb m q (ccom lsf q) $ by eq_trans [l11, l3]
l13: $ G , m = K , m ∊ ω , q = S , q ∊ fseq (trees ω) ⇒ fv lsf ⟨ K , S ⟩ = lsb K S (ccom lsf S) $ by eq_trans [l12, l8]
l14: $ G , m = K , m ∊ ω ⇒ fv lsf ⟨ K , S ⟩ = lsb K S (ccom lsf S) $ by wcel_elim [#2, l13]
l15: $ G ⇒ fv lsf ⟨ K , S ⟩ = lsb K S (ccom lsf S) $ by wcel_elim [#1, l14]

lsv_lnil
--------
l1: $ G ⇒ kc_lnil ∈ ω $ by kc_lnil_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ G ⇒ fv lsf ⟨ kc_lnil , ∅ ⟩ = lsb kc_lnil ∅ (ccom lsf ∅) $ by lsf_node_c [l1, l2]
l7: $ G ⇒ ¬ kc_lnil = kc_lcons $ by kc_lnil_ne_lcons
l8: $ G ⇒ lsb kc_lnil ∅ (ccom lsf ∅) = ∅ $ by k4_lsb_none [l7]
l9: $ G ⇒ fv lsf ⟨ kc_lnil , ∅ ⟩ = ∅ $ by eq_trans [l3, l8]
l10: $ G ⇒ A = A $ by eq_refl
l11: $ G ⇒ ap (fv lsf ⟨ kc_lnil , ∅ ⟩) A = ap ∅ A $ by ap_eq [l9, l10]
l12: $ G ⇒ ap ∅ A = ∅ $ by ap_empty
l13: $ G ⇒ ap (fv lsf ⟨ kc_lnil , ∅ ⟩) A = ∅ $ by eq_trans [l11, l12]

lsv_lcons
---------
l1: $ G ⇒ kc_lcons ∈ ω $ by kc_lcons_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3a: $ G ⇒ scons T2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l2]
l3: $ G ⇒ scons T (scons T2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l3a]
l4: $ G ⇒ fv lsf ⟨ kc_lcons , scons T (scons T2 ∅) ⟩ = lsb kc_lcons (scons T (scons T2 ∅)) (ccom lsf (scons T (scons T2 ∅))) $ by lsf_node_c [l1, l3]
l5: $ G ⇒ kc_lcons = kc_lcons $ by eq_refl
l6: $ G ⇒ lsb kc_lcons (scons T (scons T2 ∅)) (ccom lsf (scons T (scons T2 ∅))) = clam x lvals (scons (lv (fv (scons T (scons T2 ∅)) ∅) x) (ap (fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅)) x)) $ by k4_lsb_lcons [l5]
l7: $ G ⇒ fv lsf ⟨ kc_lcons , scons T (scons T2 ∅) ⟩ = clam x lvals (scons (lv (fv (scons T (scons T2 ∅)) ∅) x) (ap (fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅)) x)) $ by eq_trans [l4, l6]
l8: $ G ⇒ w = w $ by eq_refl
l9: $ G ⇒ ap (fv lsf ⟨ kc_lcons , scons T (scons T2 ∅) ⟩) w = ap (clam x lvals (scons (lv (fv (scons T (scons T2 ∅)) ∅) x) (ap (fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅)) x))) w $ by ap_eq [l7, l8]
l10: $ G ⇒ ap (clam x lvals (scons (lv (fv (scons T (scons T2 ∅)) ∅) x) (ap (fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅)) x))) w = scons (lv (fv (scons T (scons T2 ∅)) ∅) w) (ap (fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅)) w) $ by clam_ap [#3]
l11: $ G ⇒ functional lsf $ by lsf_functional
l12: $ G ⇒ T ∈ cdm lsf $ by k4_lsf_dom [#1]
l13: $ G ⇒ T2 ∈ cdm lsf $ by k4_lsf_dom [#2]
l14: $ G ⇒ isset ∅ $ by ax_empty
l15: $ G ⇒ isset (scons T2 ∅) $ by wcel_isset [l3a]
l16: $ G ⇒ fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅) = fv lsf T2 $ by k4_ch1 [l11, l12, l13, l14, l15]
l17: $ G ⇒ isset T $ by wcel_isset [#1]
l18: $ G ⇒ fv (scons T (scons T2 ∅)) ∅ = T $ by scons_fv_zero_c [l17, l15]
l19: $ G ⇒ lv (fv (scons T (scons T2 ∅)) ∅) w = lv T w $ by lv_eq [l18, l8]
l20: $ G ⇒ ap (fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅)) w = ap (fv lsf T2) w $ by ap_eq [l16, l8]
l21: $ G ⇒ scons (lv (fv (scons T (scons T2 ∅)) ∅) w) (ap (fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅)) w) = scons (lv T w) (ap (fv lsf T2) w) $ by scons_eq [l19, l20]
l22: $ G ⇒ ap (fv lsf ⟨ kc_lcons , scons T (scons T2 ∅) ⟩) w = scons (lv (fv (scons T (scons T2 ∅)) ∅) w) (ap (fv (ccom lsf (scons T (scons T2 ∅))) (suc ∅)) w) $ by eq_trans [l9, l10]
l23: $ G ⇒ ap (fv lsf ⟨ kc_lcons , scons T (scons T2 ∅) ⟩) w = scons (lv T w) (ap (fv lsf T2) w) $ by eq_trans [l22, l21]

lemma k4_lsb_ap_fs (G: hyps) (K S V: class) (w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ lv (fv S ∅) w ∈ ω $ > $ G ⇒ ap (fv V (suc ∅)) w ∈ fseq ω $ > $ G ⇒ ap (lsb K S V) w ∈ fseq ω $
----
c0a: $ G , K = kc_lcons ⇒ K = kc_lcons $ by ax
c0b: $ G , K = kc_lcons ⇒ lsb K S V = clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x)) $ by k4_lsb_lcons [c0a]
c0c: $ G , K = kc_lcons ⇒ w = w $ by eq_refl
c0d: $ G , K = kc_lcons ⇒ ap (lsb K S V) w = ap (clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x))) w $ by ap_eq [c0b, c0c]
c0e: $ G , K = kc_lcons ⇒ w ∊ lvals $ by weaken [#1]
c0f: $ G , K = kc_lcons ⇒ ap (clam x lvals (scons (lv (fv S ∅) x) (ap (fv V (suc ∅)) x))) w = scons (lv (fv S ∅) w) (ap (fv V (suc ∅)) w) $ by clam_ap [c0e]
c0g: $ G , K = kc_lcons ⇒ ap (lsb K S V) w = scons (lv (fv S ∅) w) (ap (fv V (suc ∅)) w) $ by eq_trans [c0d, c0f]
c0h: $ G , K = kc_lcons ⇒ scons (lv (fv S ∅) w) (ap (fv V (suc ∅)) w) = ap (lsb K S V) w $ by eq_sym [c0g]
c0i: $ G , K = kc_lcons ⇒ lv (fv S ∅) w ∈ ω $ by weaken [#2]
c0j: $ G , K = kc_lcons ⇒ ap (fv V (suc ∅)) w ∈ fseq ω $ by weaken [#3]
c0k: $ G , K = kc_lcons ⇒ scons (lv (fv S ∅) w) (ap (fv V (suc ∅)) w) ∈ fseq ω $ by scons_fseq_c [c0i, c0j]
c0l: $ G , K = kc_lcons ⇒ ap (lsb K S V) w ∈ fseq ω $ by wcel_eq_l [c0h, c0k]
c1a: $ G , ¬ K = kc_lcons ⇒ ¬ K = kc_lcons $ by ax
c1b: $ G , ¬ K = kc_lcons ⇒ lsb K S V = ∅ $ by k4_lsb_none [c1a]
c1c: $ G , ¬ K = kc_lcons ⇒ w = w $ by eq_refl
c1d: $ G , ¬ K = kc_lcons ⇒ ap (lsb K S V) w = ap ∅ w $ by ap_eq [c1b, c1c]
c1e: $ G , ¬ K = kc_lcons ⇒ ap ∅ w = ∅ $ by ap_empty
c1f: $ G , ¬ K = kc_lcons ⇒ ap (lsb K S V) w = ∅ $ by eq_trans [c1d, c1e]
c1g: $ G , ¬ K = kc_lcons ⇒ ∅ = ap (lsb K S V) w $ by eq_sym [c1f]
c1h: $ G , ¬ K = kc_lcons ⇒ ∅ ∈ fseq ω $ by fseq_empty
c1i: $ G , ¬ K = kc_lcons ⇒ ap (lsb K S V) w ∈ fseq ω $ by wcel_eq_l [c1g, c1h]
c2: $ G ⇒ K = kc_lcons ∨ ¬ K = kc_lcons $ by excluded_middle
c3: $ G ⇒ ap (lsb K S V) w ∈ fseq ω $ by or_elim [c2, c0l, c1i]

lemma k4_ls_step {y: set} (G: hyps y) (k j w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ {y | lsv y w ∈ fseq ω} $ > $ G ⇒ lsv ⟨ k , j ⟩ w ∈ fseq ω $
----
s1: $ G ⇒ fv lsf ⟨ k , j ⟩ = lsb k j (ccom lsf j) $ by lsf_node [#2, #3]
s2: $ G ⇒ w = w $ by eq_refl
s3: $ G ⇒ ap (fv lsf ⟨ k , j ⟩) w = ap (lsb k j (ccom lsf j)) w $ by ap_eq [s1, s2]
s4: $ G ⇒ functional lsf $ by lsf_functional
s5: $ G ⇒ functional j $ by fseq_functional [#3]
s6: $ G ⇒ crn j ⊆ trees ω $ by fseq_crn [#3]
s7: $ G ⇒ cdm lsf = trees ω $ by lsf_cdm
s8: $ G ⇒ trees ω = cdm lsf $ by eq_sym [s7]
s9: $ G ⇒ crn j ⊆ cdm lsf $ by subset_eq_r [s8, s6]
s10: $ G ⇒ ∅ ∈ fseq ω $ by fseq_empty
s11: $ G ⇒ isset ∅ $ by ax_empty
s12: $ G ⇒ isset (suc ∅) $ by suc_set [s11]
s14: $ G ⇒ ap (fv (ccom lsf j) (suc ∅)) w ∈ fseq ω $ by k4_ih [s4, s5, s9, #4, s10, s12]
s15v: $ G ⇒ isset j $ by isset_var
s15: $ G ⇒ isset (ap j ∅) $ by ap_set_c [s15v]
s16: $ G ⇒ isset (fv j ∅) $ by cuni_set [s15]
s17: $ G ⇒ lv (fv j ∅) w ∈ ω $ by lv_omega [s16, #1]
s19: $ G ⇒ ap (lsb k j (ccom lsf j)) w ∈ fseq ω $ by k4_lsb_ap_fs [#1, s17, s14]
s20: $ G ⇒ ap (lsb k j (ccom lsf j)) w = ap (fv lsf ⟨ k , j ⟩) w $ by eq_sym [s3]
s21: $ G ⇒ ap (fv lsf ⟨ k , j ⟩) w ∈ fseq ω $ by wcel_eq_l [s20, s19]

lsv_fseq
--------
t1: $ G ⇒ isset ω $ by omega_set
t2: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ u = ω $ by ax
t3: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ k ∊ u $ by ax
t4: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ k ∊ ω $ by welc_eq [t2, t3]
t5: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ trees u = trees ω $ by trees_eq [t2]
t6: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ j ∊ fseq (trees u) $ by ax
t7: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ j ∊ fseq (trees ω) $ by welc_fseq_eq [t5, t6]
t8: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ crn j ⊆ {y | lsv y w ∈ fseq ω} $ by ax
t9: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ w ∊ lvals $ by weaken [#2]
t10: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ lsv ⟨ k , j ⟩ w ∈ fseq ω $ by k4_ls_step [t9, t4, t7, t8]
t11: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ isset ⟨ k , j ⟩ $ by opair_isset
t12: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} , c = ⟨ k , j ⟩ ⇒ c = ⟨ k , j ⟩ $ by ax
t13: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} , c = ⟨ k , j ⟩ ⇒ lsf = lsf $ by eq_refl
t13a: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} , c = ⟨ k , j ⟩ ⇒ fv lsf c = fv lsf ⟨ k , j ⟩ $ by fv_eq [t13, t12]
t13b: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} , c = ⟨ k , j ⟩ ⇒ w = w $ by eq_refl
t14: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} , c = ⟨ k , j ⟩ ⇒ lsv c w = lsv ⟨ k , j ⟩ w $ by ap_eq [t13a, t13b]
t15: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} , c = ⟨ k , j ⟩ ⇒ lsv ⟨ k , j ⟩ w = lsv c w $ by eq_sym [t14]
t16: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} , c = ⟨ k , j ⟩ ⇒ lsv ⟨ k , j ⟩ w ∈ fseq ω $ by weaken [t10]
t17: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} , c = ⟨ k , j ⟩ ⇒ lsv c w ∈ fseq ω $ by wcel_eq_l [t15, t16]
t18: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) , crn j ⊆ {y | lsv y w ∈ fseq ω} ⇒ ⟨ k , j ⟩ ∈ {y | lsv y w ∈ fseq ω} $ by wcel_cab_intro (p := $ lsv y w ∈ fseq ω $) [t11, t17]
t19: $ G , u = ω , k ∊ u , j ∊ fseq (trees u) ⇒ crn j ⊆ {y | lsv y w ∈ fseq ω} → ⟨ k , j ⟩ ∈ {y | lsv y w ∈ fseq ω} $ by imp_intro [t18]
t20: $ G , u = ω , k ∊ u ⇒ j ∊ fseq (trees u) → crn j ⊆ {y | lsv y w ∈ fseq ω} → ⟨ k , j ⟩ ∈ {y | lsv y w ∈ fseq ω} $ by imp_intro [t19]
t21: $ G , u = ω ⇒ k ∊ u → j ∊ fseq (trees u) → crn j ⊆ {y | lsv y w ∈ fseq ω} → ⟨ k , j ⟩ ∈ {y | lsv y w ∈ fseq ω} $ by imp_intro [t20]
t22: $ G , u = ω ⇒ ∀ j (k ∊ u → j ∊ fseq (trees u) → crn j ⊆ {y | lsv y w ∈ fseq ω} → ⟨ k , j ⟩ ∈ {y | lsv y w ∈ fseq ω}) $ by all_intro [t21]
t23: $ G , u = ω ⇒ ∀ k ∀ j (k ∊ u → j ∊ fseq (trees u) → crn j ⊆ {y | lsv y w ∈ fseq ω} → ⟨ k , j ⟩ ∈ {y | lsv y w ∈ fseq ω}) $ by all_intro [t22]
t24: $ G , u = ω ⇒ trees u ⊆ {y | lsv y w ∈ fseq ω} $ by trees_ind [t23]
t25: $ G , u = ω ⇒ u = ω $ by ax
t26: $ G , u = ω ⇒ trees u = trees ω $ by trees_eq [t25]
t27: $ G , u = ω ⇒ trees ω ⊆ {y | lsv y w ∈ fseq ω} $ by subset_eq_l [t26, t24]
t28: $ G ⇒ trees ω ⊆ {y | lsv y w ∈ fseq ω} $ by isset_elim [t1, t27]
p1: $ G , t = T , t ∊ trees ω ⇒ trees ω ⊆ {y | lsv y w ∈ fseq ω} $ by weaken [t28]
p2: $ G , t = T , t ∊ trees ω ⇒ t ∊ trees ω $ by ax
p3: $ G , t = T , t ∊ trees ω ⇒ t ∊ {y | lsv y w ∈ fseq ω} $ by subset_elim [p1, p2]
p4: $ G , t = T , t ∊ trees ω ⇒ lsv t w ∈ fseq ω $ by cab_elim [p3]
q1: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lsf ⇒ cdm lsf = trees ω $ by lsf_cdm
q2: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lsf ⇒ t ∊ cdm lsf $ by ax
q3: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lsf ⇒ t ∊ trees ω $ by welc_eq [q1, q2]
q4: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lsf ⇒ ¬ t ∊ trees ω $ by ax
q5: $ G , t = T , ¬ t ∊ trees ω , t ∊ cdm lsf ⇒ ⊥ $ by not_elim [q4, q3]
q6: $ G , t = T , ¬ t ∊ trees ω ⇒ t ∊ cdm lsf → ⊥ $ by imp_intro [q5]
q7: $ G , t = T , ¬ t ∊ trees ω ⇒ fv lsf t = ∅ $ by fv_empty [q6]
q8: $ G , t = T , ¬ t ∊ trees ω ⇒ w = w $ by eq_refl
q9: $ G , t = T , ¬ t ∊ trees ω ⇒ ap (fv lsf t) w = ap ∅ w $ by ap_eq [q7, q8]
q10: $ G , t = T , ¬ t ∊ trees ω ⇒ ap ∅ w = ∅ $ by ap_empty
q11: $ G , t = T , ¬ t ∊ trees ω ⇒ ap (fv lsf t) w = ∅ $ by eq_trans [q9, q10]
q12: $ G , t = T , ¬ t ∊ trees ω ⇒ ∅ = ap (fv lsf t) w $ by eq_sym [q11]
q13: $ G , t = T , ¬ t ∊ trees ω ⇒ ∅ ∈ fseq ω $ by fseq_empty
q14: $ G , t = T , ¬ t ∊ trees ω ⇒ lsv t w ∈ fseq ω $ by wcel_eq_l [q12, q13]
r1: $ G , t = T ⇒ t ∊ trees ω ∨ ¬ t ∊ trees ω $ by excluded_middle
r2: $ G , t = T ⇒ lsv t w ∈ fseq ω $ by or_elim [r1, p4, q14]
r3: $ G , t = T ⇒ t = T $ by ax
r3a: $ G , t = T ⇒ lsf = lsf $ by eq_refl
r3b: $ G , t = T ⇒ fv lsf t = fv lsf T $ by fv_eq [r3a, r3]
r4: $ G , t = T ⇒ w = w $ by eq_refl
r5: $ G , t = T ⇒ lsv t w = lsv T w $ by ap_eq [r3b, r4]
r6: $ G , t = T ⇒ lsv T w ∈ fseq ω $ by wcel_eq_l [r5, r2]
r7: $ G ⇒ lsv T w ∈ fseq ω $ by isset_elim [#1, r6]

--| A class containing every set.
def k5_V (.x: set): class = $ {x | x = x} $

lemma k5_inV (G: hyps) (A: class):
  $ G ⇒ isset A $ > $ G ⇒ A ∈ k5_V $
----
l1: $ G , z = A ⇒ z = z $ by eq_refl
l2: $ G ⇒ A ∈ k5_V $ by wcel_cab_intro (p := $ x = x $) [#1, l1]

lemma k5_fsV (G: hyps) (A S: class):
  $ G ⇒ isset A $ > $ G ⇒ S ∈ fseq k5_V $ > $ G ⇒ scons A S ∈ fseq k5_V $
----
l1: $ G ⇒ A ∈ k5_V $ by k5_inV [#1]
l2: $ G ⇒ scons A S ∈ fseq k5_V $ by scons_fseq_c [l1, #2]

lemma k5_fsp (G: hyps) (X S: class) (a: set):
  $ G ⇒ scons a S ∈ fseq X $ > $ G ⇒ S ∈ fseq k5_V $ > $ G ⇒ a ∊ X ∧ S ∈ fseq X $
----
l1: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ v ∊ fseq k5_V $ by ax
l2: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ rel v $ by fseq_rel [l1]
l3: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ a = a $ by eq_refl
l4: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ v = S $ by ax
l5: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ scons a v = scons a S $ by scons_eq [l3, l4]
l6: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ u = scons a S $ by ax
l7: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ scons a S = u $ by eq_sym [l6]
l8: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ scons a v = u $ by eq_trans [l5, l7]
l9: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ u ∊ fseq X $ by ax
l10: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ u = ∅ ∨ ∃ x ∃ y (x ∊ X ∧ y ∊ fseq X ∧ u = scons x y) $ by fseq_cases [l9]
l11: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , u = ∅ ⇒ scons a v = u $ by weaken [l8]
l12: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , u = ∅ ⇒ u = ∅ $ by ax
l13: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , u = ∅ ⇒ scons a v = ∅ $ by eq_trans [l11, l12]
l14: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , u = ∅ ⇒ ⊥ $ by scons_ne_empty [l13]
l15: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , u = ∅ ⇒ a ∊ X ∧ S ∈ fseq X $ by bot_elim [l14]
l16: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ x ∊ X ∧ y ∊ fseq X ∧ u = scons x y $ by ax
l17: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ x ∊ X $ by and_elim_l [l16]
l18: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ y ∊ fseq X ∧ u = scons x y $ by and_elim_r [l16]
l19: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ y ∊ fseq X $ by and_elim_l [l18]
l20: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ u = scons x y $ by and_elim_r [l18]
l21: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ rel y $ by fseq_rel [l19]
l22: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ scons a v = u $ by weaken [l8]
l23: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ scons a v = scons x y $ by eq_trans [l22, l20]
l24: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ rel v $ by weaken [l2]
l25: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ a = x ∧ v = y $ by scons_inj [l24, l21, l23]
l26: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ a = x $ by and_elim_l [l25]
l27: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ v = y $ by and_elim_r [l25]
l28: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ x = a $ by eq_sym [l26]
l29: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ a ∊ X $ by welc_eq_set [l28, l17]
l30: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ y = v $ by eq_sym [l27]
l31: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ v ∊ fseq X $ by welc_eq_set [l30, l19]
l32: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ v = S $ by weaken [l4]
l33: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ S ∈ fseq X $ by wcel_intro [l32, l31]
l34: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , x ∊ X ∧ y ∊ fseq X ∧ u = scons x y ⇒ a ∊ X ∧ S ∈ fseq X $ by and_intro [l29, l33]
l35: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , ∃ y (x ∊ X ∧ y ∊ fseq X ∧ u = scons x y) ⇒ ∃ y (x ∊ X ∧ y ∊ fseq X ∧ u = scons x y) $ by ax
l36: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , ∃ y (x ∊ X ∧ y ∊ fseq X ∧ u = scons x y) ⇒ a ∊ X ∧ S ∈ fseq X $ by ex_elim [l35, l34]
l37: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , ∃ x ∃ y (x ∊ X ∧ y ∊ fseq X ∧ u = scons x y) ⇒ ∃ x ∃ y (x ∊ X ∧ y ∊ fseq X ∧ u = scons x y) $ by ax
l38: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X , ∃ x ∃ y (x ∊ X ∧ y ∊ fseq X ∧ u = scons x y) ⇒ a ∊ X ∧ S ∈ fseq X $ by ex_elim [l37, l36]
l39: $ G , v = S , v ∊ fseq k5_V , u = scons a S , u ∊ fseq X ⇒ a ∊ X ∧ S ∈ fseq X $ by or_elim [l10, l15, l38]
l40: $ G , v = S , v ∊ fseq k5_V ⇒ a ∊ X ∧ S ∈ fseq X $ by wcel_elim [#1, l39]
l41: $ G ⇒ a ∊ X ∧ S ∈ fseq X $ by wcel_elim [#2, l40]

lemma k5_fs1 (G: hyps) (X: class) (a: set):
  $ G ⇒ scons a ∅ ∈ fseq X $ > $ G ⇒ a ∊ X $
----
l1: $ G ⇒ ∅ ∈ fseq k5_V $ by fseq_empty
l2: $ G ⇒ a ∊ X ∧ ∅ ∈ fseq X $ by k5_fsp [#1, l1]
l3: $ G ⇒ a ∊ X $ by and_elim_l [l2]

lemma k5_fs2 (G: hyps) (X: class) (a b: set):
  $ G ⇒ scons a (scons b ∅) ∈ fseq X $ > $ G ⇒ a ∊ X ∧ b ∊ X $
----
l1: $ G ⇒ ∅ ∈ fseq k5_V $ by fseq_empty
l2: $ G ⇒ isset b $ by isset_var
l3: $ G ⇒ scons b ∅ ∈ fseq k5_V $ by k5_fsV [l2, l1]
l4: $ G ⇒ a ∊ X ∧ scons b ∅ ∈ fseq X $ by k5_fsp [#1, l3]
l5: $ G ⇒ a ∊ X $ by and_elim_l [l4]
l6: $ G ⇒ scons b ∅ ∈ fseq X $ by and_elim_r [l4]
l7: $ G ⇒ b ∊ X ∧ ∅ ∈ fseq X $ by k5_fsp [l6, l1]
l8: $ G ⇒ b ∊ X $ by and_elim_l [l7]
l9: $ G ⇒ a ∊ X ∧ b ∊ X $ by and_intro [l5, l8]

lemma k5_ch1 (G: hyps) (K: class) (a: set):
  $ G ⇒ ⟨ K , scons a ∅ ⟩ ∈ trees ω $ > $ G ⇒ isset K $ > $ G ⇒ a ∊ trees ω $
----
l1: $ G ⇒ ∅ ∈ fseq k5_V $ by fseq_empty
l2: $ G ⇒ isset a $ by isset_var
l3: $ G ⇒ scons a ∅ ∈ fseq k5_V $ by k5_fsV [l2, l1]
l4: $ G ⇒ isset (scons a ∅) $ by wcel_isset [l3]
l5o: $ G ⇒ isset ω $ by omega_set
l5c: $ G ⇒ K ∈ ω ∧ scons a ∅ ∈ fseq (trees ω) $ by trees_node_c [l5o, #1, #2, l4]
l5: $ G ⇒ scons a ∅ ∈ fseq (trees ω) $ by and_elim_r [l5c]
l6: $ G ⇒ a ∊ trees ω $ by k5_fs1 [l5]

lemma k5_ch2 (G: hyps) (K: class) (a b: set):
  $ G ⇒ ⟨ K , scons a (scons b ∅) ⟩ ∈ trees ω $ > $ G ⇒ isset K $ > $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $
----
l1: $ G ⇒ ∅ ∈ fseq k5_V $ by fseq_empty
l2: $ G ⇒ isset b $ by isset_var
l3: $ G ⇒ scons b ∅ ∈ fseq k5_V $ by k5_fsV [l2, l1]
l4: $ G ⇒ isset a $ by isset_var
l5: $ G ⇒ scons a (scons b ∅) ∈ fseq k5_V $ by k5_fsV [l4, l3]
l6: $ G ⇒ isset (scons a (scons b ∅)) $ by wcel_isset [l5]
l7o: $ G ⇒ isset ω $ by omega_set
l7c: $ G ⇒ K ∈ ω ∧ scons a (scons b ∅) ∈ fseq (trees ω) $ by trees_node_c [l7o, #1, #2, l6]
l7: $ G ⇒ scons a (scons b ∅) ∈ fseq (trees ω) $ by and_elim_r [l7c]
l8: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by k5_fs2 [l7]

lemma k5_crn (G: hyps) (S: class) (a: set):
  $ G ⇒ a ∊ crn (scons a S) $
----
l1: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ e = ⟨ o , a ⟩ $ by ax
l2: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ o = ∅ $ by ax
l3: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ a = a $ by eq_refl
l4: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ ⟨ o , a ⟩ = ⟨ ∅ , a ⟩ $ by opair_eq [l2, l3]
l5: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ e = ⟨ ∅ , a ⟩ $ by eq_trans [l1, l4]
l6: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ e ∊ csn ⟨ ∅ , a ⟩ $ by csn_intro [l5]
l7: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ e ∊ scons a S $ by cun_intro_l [l6]
l8: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ ⟨ o , a ⟩ ∈ scons a S $ by wcel_intro [l1, l7]
l9: $ G , o = ∅ , e = ⟨ o , a ⟩ ⇒ a ∊ crn (scons a S) $ by crn_intro [l8]
l10: $ G , o = ∅ ⇒ isset ⟨ o , a ⟩ $ by opair_isset
l11: $ G , o = ∅ ⇒ a ∊ crn (scons a S) $ by isset_elim [l10, l9]
l12: $ G ⇒ isset ∅ $ by ax_empty
l13: $ G ⇒ a ∊ crn (scons a S) $ by isset_elim [l12, l11]

lemma k5_sne1 (G: hyps) (A B: class):
  $ G ⇒ suc A ⊆ B $ > $ G ⇒ isset A $ > $ G ⇒ ¬ A = B $
----
l1: $ G , A = B ⇒ isset A $ by weaken [#2]
l2: $ G , A = B ⇒ A ∈ suc A $ by suc_mem [l1]
l3: $ G , A = B ⇒ suc A ⊆ B $ by weaken [#1]
l4: $ G , A = B ⇒ A ∈ B $ by wcel_subset [l3, l2]
l5: $ G , A = B ⇒ A = B $ by ax
l6: $ G , A = B ⇒ B ∈ B $ by wcel_eq_l [l5, l4]
l7: $ G , A = B ⇒ ⊥ $ by notin_self_c [l6]
l8: $ G ⇒ ¬ A = B $ by not_intro [l7]

lemma k5_sne2 (G: hyps) (A B: class):
  $ G ⇒ suc B ⊆ A $ > $ G ⇒ isset B $ > $ G ⇒ ¬ A = B $
----
l1: $ G , A = B ⇒ isset B $ by weaken [#2]
l2: $ G , A = B ⇒ B ∈ suc B $ by suc_mem [l1]
l3: $ G , A = B ⇒ suc B ⊆ A $ by weaken [#1]
l4: $ G , A = B ⇒ B ∈ A $ by wcel_subset [l3, l2]
l5: $ G , A = B ⇒ A = B $ by ax
l6: $ G , A = B ⇒ B ∈ B $ by wcel_eq_r [l5, l4]
l7: $ G , A = B ⇒ ⊥ $ by notin_self_c [l6]
l8: $ G ⇒ ¬ A = B $ by not_intro [l7]

lemma k5_sc0 (G: hyps) (S: class) (a: set):
  $ G ⇒ ⟨ ∅ , a ⟩ ∈ scons a S $
----
l1: $ G , e = ⟨ ∅ , a ⟩ ⇒ e = ⟨ ∅ , a ⟩ $ by ax
l2: $ G , e = ⟨ ∅ , a ⟩ ⇒ e ∊ csn ⟨ ∅ , a ⟩ $ by csn_intro [l1]
l3: $ G , e = ⟨ ∅ , a ⟩ ⇒ e ∊ scons a S $ by cun_intro_l [l2]
l4: $ G , e = ⟨ ∅ , a ⟩ ⇒ ⟨ ∅ , a ⟩ ∈ scons a S $ by wcel_intro [l1, l3]
l5: $ G ⇒ isset ⟨ ∅ , a ⟩ $ by opair_isset
l6: $ G ⇒ ⟨ ∅ , a ⟩ ∈ scons a S $ by isset_elim [l5, l4]

lemma k5_crn2 (G: hyps) (A S: class) (b: set):
  $ G ⇒ b ∊ crn (scons A (scons b S)) $
----
l1: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ ⟨ ∅ , b ⟩ ∈ scons b S $ by k5_sc0
l2: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ o = ∅ $ by ax
l3: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ b = b $ by eq_refl
l4: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ ⟨ o , b ⟩ = ⟨ ∅ , b ⟩ $ by opair_eq [l2, l3]
l5: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ ⟨ ∅ , b ⟩ = ⟨ o , b ⟩ $ by eq_sym [l4]
l6: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ ⟨ o , b ⟩ ∈ scons b S $ by wcel_eq_l [l5, l1]
l7: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ e = ⟨ h , b ⟩ $ by ax
l8: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ h = suc o $ by ax
l9: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ ⟨ h , b ⟩ = ⟨ suc o , b ⟩ $ by opair_eq [l8, l3]
l10: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ e = ⟨ suc o , b ⟩ $ by eq_trans [l7, l9]
l11: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ e = ⟨ suc o , b ⟩ ∧ ⟨ o , b ⟩ ∈ scons b S $ by and_intro [l10, l6]
l12: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ ∃ y (e = ⟨ suc o , y ⟩ ∧ ⟨ o , y ⟩ ∈ scons b S) $ by ex_intro [l11]
l13: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ ∃ i ∃ y (e = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ scons b S) $ by ex_intro [l12]
l14: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ e ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ scons b S)} $ by cab_intro [l13]
l15: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ e ∊ scons A (scons b S) $ by cun_intro_r [l14]
l16: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ ⟨ h , b ⟩ ∈ scons A (scons b S) $ by wcel_intro [l7, l15]
l17: $ G , o = ∅ , h = suc o , e = ⟨ h , b ⟩ ⇒ b ∊ crn (scons A (scons b S)) $ by crn_intro [l16]
l18: $ G , o = ∅ , h = suc o ⇒ isset ⟨ h , b ⟩ $ by opair_isset
l19: $ G , o = ∅ , h = suc o ⇒ b ∊ crn (scons A (scons b S)) $ by isset_elim [l18, l17]
l20: $ G , o = ∅ ⇒ isset o $ by isset_var
l21: $ G , o = ∅ ⇒ isset (suc o) $ by suc_set [l20]
l22: $ G , o = ∅ ⇒ b ∊ crn (scons A (scons b S)) $ by isset_elim [l21, l19]
l23: $ G ⇒ isset ∅ $ by ax_empty
l24: $ G ⇒ b ∊ crn (scons A (scons b S)) $ by isset_elim [l23, l22]

lemma k5_vq (G: hyps) (K S: class) (q k v: set):
  $ G ⇒ q = ⟨ k , v ⟩ $ > $ G ⇒ q = ⟨ K , S ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset S $ > $ G ⇒ v = S $
----
l1: $ G ⇒ ⟨ k , v ⟩ = q $ by eq_sym [#1]
l2: $ G ⇒ ⟨ k , v ⟩ = ⟨ K , S ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ isset k $ by isset_var
l4: $ G ⇒ isset v $ by isset_var
l5: $ G ⇒ k = K ∧ v = S $ by opair_inj_c [l2, l3, l4, #3, #4]
l6: $ G ⇒ v = S $ by and_elim_r [l5]

lemma k5_crnsub (G: hyps) (X S: class) (a v: set):
  $ G ⇒ crn v ⊆ X $ > $ G ⇒ v = S $ > $ G ⇒ a ∊ crn S $ > $ G ⇒ a ∊ X $
----
l1: $ G ⇒ crn v = crn S $ by crn_eq [#2]
l2: $ G ⇒ crn S = crn v $ by eq_sym [l1]
l3: $ G ⇒ a ∊ crn v $ by welc_eq [l2, #3]
l4: $ G ⇒ a ∊ X $ by subset_elim [#1, l3]

lemma k5_mv3 (G: hyps) (K A B C D: class):
  $ G ⇒ ⟨ K , scons A (scons B (scons C ∅)) ⟩ ∈ lrel $ > $ G ⇒ A = D $ > $ G ⇒ ⟨ K , scons D (scons B (scons C ∅)) ⟩ ∈ lrel $
----
l1: $ G ⇒ scons B (scons C ∅) = scons B (scons C ∅) $ by eq_refl
l2: $ G ⇒ scons A (scons B (scons C ∅)) = scons D (scons B (scons C ∅)) $ by scons_eq [#2, l1]
l3: $ G ⇒ K = K $ by eq_refl
l4: $ G ⇒ ⟨ K , scons A (scons B (scons C ∅)) ⟩ = ⟨ K , scons D (scons B (scons C ∅)) ⟩ $ by opair_eq [l3, l2]
l5: $ G ⇒ ⟨ K , scons D (scons B (scons C ∅)) ⟩ ∈ lrel $ by wcel_eq_l [l4, #1]

lemma k5_mv4 (G: hyps) (K A B C E A2 C2: class):
  $ G ⇒ ⟨ K , scons A (scons B (scons C (scons E ∅))) ⟩ ∈ lrel $ > $ G ⇒ A = A2 $ > $ G ⇒ C = C2 $ > $ G ⇒ ⟨ K , scons A2 (scons B (scons C2 (scons E ∅))) ⟩ ∈ lrel $
----
l1: $ G ⇒ scons E ∅ = scons E ∅ $ by eq_refl
l2: $ G ⇒ scons C (scons E ∅) = scons C2 (scons E ∅) $ by scons_eq [#3, l1]
l3: $ G ⇒ B = B $ by eq_refl
l4: $ G ⇒ scons B (scons C (scons E ∅)) = scons B (scons C2 (scons E ∅)) $ by scons_eq [l3, l2]
l5: $ G ⇒ scons A (scons B (scons C (scons E ∅))) = scons A2 (scons B (scons C2 (scons E ∅))) $ by scons_eq [#2, l4]
l6: $ G ⇒ K = K $ by eq_refl
l7: $ G ⇒ ⟨ K , scons A (scons B (scons C (scons E ∅))) ⟩ = ⟨ K , scons A2 (scons B (scons C2 (scons E ∅))) ⟩ $ by opair_eq [l6, l5]
l8: $ G ⇒ ⟨ K , scons A2 (scons B (scons C2 (scons E ∅))) ⟩ ∈ lrel $ by wcel_eq_l [l7, #1]

lemma k5_ln_c1 (G: hyps) (y q z a b w: set):
  $ G ⇒ y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ $ > $ G ⇒ q = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ z = a $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lv z w = fv (lsv y w) (fv nvf q) $
----
l1: $ G ⇒ ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∈ trees ω $ by wcel_intro [#1, #4]
l2: $ G ⇒ kc_lcons ∈ ω $ by kc_lcons_omega
l3: $ G ⇒ isset kc_lcons $ by wcel_isset [l2]
l4: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by k5_ch2 [l1, l3]
l5: $ G ⇒ a ∊ trees ω $ by and_elim_l [l4]
l6: $ G ⇒ b ∊ trees ω $ by and_elim_r [l4]
l7: $ G ⇒ a ∈ trees ω $ by welc_wcel [l5]
l8: $ G ⇒ b ∈ trees ω $ by welc_wcel [l6]
l9: $ G ⇒ lsv ⟨ kc_lcons , scons a (scons b ∅) ⟩ w = scons (lv a w) (lsv b w) $ by lsv_lcons [l7, l8, #5]
l10: $ G ⇒ w = w $ by eq_refl
l11: $ G ⇒ lsv y w = lsv ⟨ kc_lcons , scons a (scons b ∅) ⟩ w $ by lsv_eq [#1, l10]
l12: $ G ⇒ lsv y w = scons (lv a w) (lsv b w) $ by eq_trans [l11, l9]
l13: $ G ⇒ nvf = nvf $ by eq_refl
l14: $ G ⇒ fv nvf q = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [l13, #2]
l15: $ G ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l16: $ G ⇒ fv nvf q = ∅ $ by eq_trans [l14, l15]
l17: $ G ⇒ fv (lsv y w) (fv nvf q) = fv (scons (lv a w) (lsv b w)) ∅ $ by fv_eq [l12, l16]
l18: $ G ⇒ isset a $ by isset_var
l19: $ G ⇒ lv a w ∈ ω $ by lv_omega [l18, #5]
l20: $ G ⇒ isset (lv a w) $ by wcel_isset [l19]
l21: $ G ⇒ isset b $ by isset_var
l22: $ G ⇒ lsv b w ∈ fseq ω $ by lsv_fseq [l21, #5]
l23: $ G ⇒ isset (lsv b w) $ by wcel_isset [l22]
l24: $ G ⇒ fv (scons (lv a w) (lsv b w)) ∅ = lv a w $ by scons_fv_zero_c [l20, l23]
l25: $ G ⇒ fv (lsv y w) (fv nvf q) = lv a w $ by eq_trans [l17, l24]
l26: $ G ⇒ lv z w = lv a w $ by lv_eq [#3, l10]
l27: $ G ⇒ lv a w = fv (lsv y w) (fv nvf q) $ by eq_sym [l25]
l28: $ G ⇒ lv z w = fv (lsv y w) (fv nvf q) $ by eq_trans [l26, l27]

lemma k5_ln_c2 (G: hyps) (y q z a b c n w: set):
  $ G ⇒ y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ $ > $ G ⇒ q = ⟨ kc_s , scons n ∅ ⟩ $ > $ G ⇒ z = c $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lv c w = fv (lsv b w) (fv nvf n) $ > $ G ⇒ lv z w = fv (lsv y w) (fv nvf q) $
----
l1: $ G ⇒ ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∈ trees ω $ by wcel_intro [#1, #4]
l2: $ G ⇒ kc_lcons ∈ ω $ by kc_lcons_omega
l3: $ G ⇒ isset kc_lcons $ by wcel_isset [l2]
l4: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by k5_ch2 [l1, l3]
l5: $ G ⇒ a ∊ trees ω $ by and_elim_l [l4]
l6: $ G ⇒ b ∊ trees ω $ by and_elim_r [l4]
l7: $ G ⇒ a ∈ trees ω $ by welc_wcel [l5]
l8: $ G ⇒ b ∈ trees ω $ by welc_wcel [l6]
l9: $ G ⇒ lsv ⟨ kc_lcons , scons a (scons b ∅) ⟩ w = scons (lv a w) (lsv b w) $ by lsv_lcons [l7, l8, #6]
l10: $ G ⇒ w = w $ by eq_refl
l11: $ G ⇒ lsv y w = lsv ⟨ kc_lcons , scons a (scons b ∅) ⟩ w $ by lsv_eq [#1, l10]
l12: $ G ⇒ lsv y w = scons (lv a w) (lsv b w) $ by eq_trans [l11, l9]
l13: $ G ⇒ ⟨ kc_s , scons n ∅ ⟩ ∈ trees ω $ by wcel_intro [#2, #5]
l14: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
l15: $ G ⇒ isset kc_s $ by wcel_isset [l14]
l16: $ G ⇒ n ∊ trees ω $ by k5_ch1 [l13, l15]
l17: $ G ⇒ n ∈ trees ω $ by welc_wcel [l16]
l18: $ G ⇒ nvf = nvf $ by eq_refl
l19: $ G ⇒ fv nvf q = fv nvf ⟨ kc_s , scons n ∅ ⟩ $ by fv_eq [l18, #2]
l20: $ G ⇒ fv nvf ⟨ kc_s , scons n ∅ ⟩ = suc (fv nvf n) $ by nvf_s [l17]
l21: $ G ⇒ fv nvf q = suc (fv nvf n) $ by eq_trans [l19, l20]
l22: $ G ⇒ fv (lsv y w) (fv nvf q) = fv (scons (lv a w) (lsv b w)) (suc (fv nvf n)) $ by fv_eq [l12, l21]
l23: $ G ⇒ isset a $ by isset_var
l24: $ G ⇒ lv a w ∈ ω $ by lv_omega [l23, #6]
l25: $ G ⇒ isset (lv a w) $ by wcel_isset [l24]
l26: $ G ⇒ isset b $ by isset_var
l27: $ G ⇒ lsv b w ∈ fseq ω $ by lsv_fseq [l26, #6]
l28: $ G ⇒ isset (lsv b w) $ by wcel_isset [l27]
l29: $ G ⇒ isset n $ by isset_var
l30: $ G ⇒ fv nvf n ∈ ω $ by nvf_omega [l29]
l31: $ G ⇒ isset (fv nvf n) $ by wcel_isset [l30]
l32: $ G ⇒ fv (scons (lv a w) (lsv b w)) (suc (fv nvf n)) = fv (lsv b w) (fv nvf n) $ by scons_fv_suc_c [l25, l28, l31]
l33: $ G ⇒ fv (lsv y w) (fv nvf q) = fv (lsv b w) (fv nvf n) $ by eq_trans [l22, l32]
l34: $ G ⇒ lv z w = lv c w $ by lv_eq [#3, l10]
l35: $ G ⇒ lv z w = fv (lsv b w) (fv nvf n) $ by eq_trans [l34, #7]
l36: $ G ⇒ fv (lsv b w) (fv nvf n) = fv (lsv y w) (fv nvf q) $ by eq_sym [l33]
l37: $ G ⇒ lv z w = fv (lsv y w) (fv nvf q) $ by eq_trans [l35, l36]

lrel_lnth_sem
-------------
l1: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel $ by ax
l2: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ ∃ a ∃ b (y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∧ q = ⟨ kc_nz , ∅ ⟩ ∧ z = a) ∨ ∃ a ∃ c ∃ b ∃ n (y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∧ q = ⟨ kc_s , scons n ∅ ⟩ ∧ z = c ∧ ra_lnth b n c ∈ lrel) $ by lrel_lnth_cases [l1]
l3: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ kr_lnth ∈ ω $ by kr_lnth_omega
l4: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ isset kr_lnth $ by wcel_isset [l3]
l5: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ y ∊ trees ω ∧ q ∊ trees ω ∧ z ∊ trees ω $ by lrel_args3 [l1, l4]
l6: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ y ∊ trees ω $ by and_elim_l [l5]
l7: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ q ∊ trees ω ∧ z ∊ trees ω $ by and_elim_r [l5]
l8: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ q ∊ trees ω $ by and_elim_l [l7]
l9: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ w ∊ lvals $ by weaken [#2]
l10: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel , y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∧ q = ⟨ kc_nz , ∅ ⟩ ∧ z = a ⇒ y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∧ q = ⟨ kc_nz , ∅ ⟩ ∧ z = a $ by ax
l11: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel , y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∧ q = ⟨ kc_nz , ∅ ⟩ ∧ z = a ⇒ y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ $ by and_elim_l [l10]
l12: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel , y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∧ q = ⟨ kc_nz , ∅ ⟩ ∧ z = a ⇒ q = ⟨ kc_nz , ∅ ⟩ ∧ z = a $ by and_elim_r [l10]
l13: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel , y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∧ q = ⟨ kc_nz , ∅ ⟩ ∧ z = a ⇒ q = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l12]
l14: $ G , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ y ∀ z (⟨ kr_lnth , scons y (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = fv (lsv y w) (fv nvf x))} , q = ⟨ k , v ⟩ , ⟨ kr_lnth , scons y (scons q (scons z ∅)) ⟩ ∈ lrel , y = ⟨ kc_lcons , scons a (scons b ∅) ⟩ ∧ q = ⟨ kc_nz , ∅ ⟩ ∧ z = a ⇒ z = a $ by and_elim_r [l12]
