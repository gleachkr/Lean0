l18: $ G ⇒ f = f $ by eq_refl
l19: $ G ⇒ lv ⟨ kc_lmax , scons c (scons d ∅) ⟩ w = nmax (lv c w) (lv d w) $ by lv_lmax [l15, l16, #5]
l20: $ G ⇒ lv z w = lv ⟨ kc_lmax , scons c (scons d ∅) ⟩ w $ by lv_eq [#2, l17]
l21: $ G ⇒ lv ⟨ kc_lmax , scons a (scons b ∅) ⟩ f = nmax (lv a f) (lv b f) $ by lv_lmax [l7, l8, #6]
l22: $ G ⇒ lv q f = lv ⟨ kc_lmax , scons a (scons b ∅) ⟩ f $ by lv_eq [#1, l18]
l23: $ G ⇒ nmax (lv c w) (lv d w) = nmax (lv a f) (lv b f) $ by nmax_eq [#7, #8]
l24: $ G ⇒ lv z w = nmax (lv c w) (lv d w) $ by eq_trans [l20, l19]
l25: $ G ⇒ lv z w = nmax (lv a f) (lv b f) $ by eq_trans [l24, l23]
l26: $ G ⇒ lv q f = nmax (lv a f) (lv b f) $ by eq_trans [l22, l21]
l27: $ G ⇒ nmax (lv a f) (lv b f) = lv q f $ by eq_sym [l26]
l28: $ G ⇒ lv z w = lv q f $ by eq_trans [l25, l27]

