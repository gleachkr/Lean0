l17: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , scons t1 (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , scons t1 (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ ∃ u (t1 = u ∧ q = ⟨ kc_lz , ∅ ⟩ ∧ z = ⟨ kc_lz , ∅ ⟩) ∨ ∃ u ∃ a ∃ c (t1 = u ∧ q = ⟨ kc_ls , scons a ∅ ⟩ ∧ z = ⟨ kc_ls , scons c ∅ ⟩ ∧ ra_linst u a c ∈ lrel) ∨ ∃ u ∃ a ∃ b ∃ c ∃ d (t1 = u ∧ q = ⟨ kc_lmax , scons a (scons b ∅) ⟩ ∧ z = ⟨ kc_lmax , scons c (scons d ∅) ⟩ ∧ ra_linst u a c ∈ lrel ∧ ra_linst u b d ∈ lrel) ∨ ∃ u ∃ a ∃ b ∃ c ∃ d (t1 = u ∧ q = ⟨ kc_limax , scons a (scons b ∅) ⟩ ∧ z = ⟨ kc_limax , scons c (scons d ∅) ⟩ ∧ ra_linst u a c ∈ lrel ∧ ra_linst u b d ∈ lrel) ∨ ∃ u ∃ n ∃ a (t1 = u ∧ q = ⟨ kc_lparam , scons n ∅ ⟩ ∧ z = a ∧ ra_lnth u n a ∈ lrel) $ by lrel_linst_cases [l16]
l18: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , scons t1 (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , scons t1 (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ kr_linst ∈ ω $ by kr_linst_omega
l19: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , scons t1 (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , scons t1 (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ isset kr_linst $ by wcel_isset [l18]
l20: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , scons t1 (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , scons t1 (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ t1 ∊ trees ω ∧ q ∊ trees ω ∧ z ∊ trees ω $ by lrel_args3 [l16, l19]
l21: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , scons t1 (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , scons t1 (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ q ∊ trees ω ∧ z ∊ trees ω $ by and_elim_r [l20]
l22: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , scons t1 (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , scons t1 (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ q ∊ trees ω $ by and_elim_l [l21]
l23: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , scons t1 (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , scons t1 (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ z ∊ trees ω $ by and_elim_r [l21]
l24: $ G , e = lsv t1 w , f = lsub e , k ∊ ω , v ∊ fseq (trees ω) , crn v ⊆ {x | ∀ z (⟨ kr_linst , scons t1 (scons x (scons z ∅)) ⟩ ∈ lrel → lv z w = lv x f)} , q = ⟨ k , v ⟩ , ⟨ kr_linst , scons t1 (scons q (scons z ∅)) ⟩ ∈ lrel ⇒ w ∊ lvals $ by weaken [#2]
