lemma k1_cun_distr (G: hyps) (A B C: class): $ G ⇒ A ∪ (B ∪ C) = (A ∪ B) ∪ (A ∪ C) $
----
l1: $ G ⇒ A ⊆ A ∪ B $ by cun_subset_l
l2: $ G ⇒ A ∪ B ⊆ (A ∪ B) ∪ (A ∪ C) $ by cun_subset_l
l3: $ G ⇒ A ∪ C ⊆ (A ∪ B) ∪ (A ∪ C) $ by cun_subset_r
l4: $ G ⇒ A ⊆ (A ∪ B) ∪ (A ∪ C) $ by subset_trans [l1, l2]
l5: $ G ⇒ B ⊆ A ∪ B $ by cun_subset_r
l6: $ G ⇒ B ⊆ (A ∪ B) ∪ (A ∪ C) $ by subset_trans [l5, l2]
l7: $ G ⇒ C ⊆ A ∪ C $ by cun_subset_r
l8: $ G ⇒ C ⊆ (A ∪ B) ∪ (A ∪ C) $ by subset_trans [l7, l3]
l9: $ G ⇒ B ∪ C ⊆ (A ∪ B) ∪ (A ∪ C) $ by cun_least [l6, l8]
l10: $ G ⇒ A ∪ (B ∪ C) ⊆ (A ∪ B) ∪ (A ∪ C) $ by cun_least [l4, l9]
m1: $ G ⇒ A ⊆ A ∪ (B ∪ C) $ by cun_subset_l
m2: $ G ⇒ B ∪ C ⊆ A ∪ (B ∪ C) $ by cun_subset_r
m3: $ G ⇒ B ⊆ B ∪ C $ by cun_subset_l
m4: $ G ⇒ C ⊆ B ∪ C $ by cun_subset_r
m5: $ G ⇒ B ⊆ A ∪ (B ∪ C) $ by subset_trans [m3, m2]
m6: $ G ⇒ C ⊆ A ∪ (B ∪ C) $ by subset_trans [m4, m2]
m7: $ G ⇒ A ∪ B ⊆ A ∪ (B ∪ C) $ by cun_least [m1, m5]
m8: $ G ⇒ A ∪ C ⊆ A ∪ (B ∪ C) $ by cun_least [m1, m6]
m9: $ G ⇒ (A ∪ B) ∪ (A ∪ C) ⊆ A ∪ (B ∪ C) $ by cun_least [m7, m8]
l11: $ G ⇒ A ∪ (B ∪ C) = (A ∪ B) ∪ (A ∪ C) $ by subset_antisym [l10, m9]

