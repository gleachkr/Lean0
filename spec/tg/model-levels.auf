l11: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ enc_nat n = x $ by eq_sym [l10]
l12: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ y = enc_lvl l $ by ax
l13: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ enc_lvl l = y $ by eq_sym [l12]
l14: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ z = enc_lvl a $ by ax
l15: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ enc_lvl a = z $ by eq_sym [l14]
l16: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ u = enc_lvl l2 $ by ax
l17: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ enc_lvl l2 = u $ by eq_sym [l16]
l18: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ ra_lsubst (enc_nat n) (enc_lvl l) (enc_lvl a) (enc_lvl l2) ∈ lrel $ by weaken [l1]
l19: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ ⟨ kr_lsubst , scons x (scons y (scons z (scons u ∅))) ⟩ ∈ lrel $ by k5_mva4 [l18, l11, l13, l15, l17]
l20: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ w ∊ lvals $ by weaken [#2]
l21: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ lv u w = lv y (lupd w (fv nvf x) (lv z w)) $ by lrel_lsubst_sem [l19, l20]
l22: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ w = w $ by eq_refl
l23: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ lv (enc_lvl l2) w = lv u w $ by lv_eq [l17, l22]
l24: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ nvf = nvf $ by eq_refl
l25: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ fv nvf x = fv nvf (enc_nat n) $ by fv_eq [l24, l10]
l26: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ lv z w = lv (enc_lvl a) w $ by lv_eq [l14, l22]
l27: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ lupd w (fv nvf x) (lv z w) = lupd w (fv nvf (enc_nat n)) (lv (enc_lvl a) w) $ by lupd_eq [l22, l25, l26]
l28: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ lv y (lupd w (fv nvf x) (lv z w)) = lv (enc_lvl l) (lupd w (fv nvf (enc_nat n)) (lv (enc_lvl a) w)) $ by lv_eq [l12, l27]
l29: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ lv (enc_lvl l2) w = lv y (lupd w (fv nvf x) (lv z w)) $ by eq_trans [l23, l21]
l30: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a , u = enc_lvl l2 ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (fv nvf (enc_nat n)) (lv (enc_lvl a) w)) $ by eq_trans [l29, l28]
l31: $ G , x = enc_nat n , y = enc_lvl l , z = enc_lvl a ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (fv nvf (enc_nat n)) (lv (enc_lvl a) w)) $ by isset_elim [l9, l30]
l32: $ G , x = enc_nat n , y = enc_lvl l ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (fv nvf (enc_nat n)) (lv (enc_lvl a) w)) $ by isset_elim [l7, l31]
l33: $ G , x = enc_nat n ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (fv nvf (enc_nat n)) (lv (enc_lvl a) w)) $ by isset_elim [l5, l32]
l34: $ G ⇒ lv (enc_lvl l2) w = lv (enc_lvl l) (lupd w (fv nvf (enc_nat n)) (lv (enc_lvl a) w)) $ by isset_elim [l3, l33]

leqv_i
------
l1: $ _ ⇒ x ∊ lvals → lv (enc_lvl a) x = lv (enc_lvl b) x $ by imp_intro [#1]
l2: $ leqv a b $ by all_intro [l1]

leqv_e
------
l1: $ _ ⇒ w ∊ lvals → lv (enc_lvl a) w = lv (enc_lvl b) w $ by all_elim [#1]
l2: $ G ⇒ w ∊ lvals → lv (enc_lvl a) w = lv (enc_lvl b) w $ by weaken [l1]
l3: $ G ⇒ lv (enc_lvl a) w = lv (enc_lvl b) w $ by imp_elim [l2, #2]

leqv_refl
---------
l1: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l2: $ leqv a a $ by leqv_i [l1]

leqv_symm
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ x ∊ lvals ⇒ lv (enc_lvl b) x = lv (enc_lvl a) x $ by eq_sym [l2]
l4: $ leqv b a $ by leqv_i [l3]

leqv_trans
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ x ∊ lvals ⇒ lv (enc_lvl b) x = lv (enc_lvl c) x $ by leqv_e [#2, l1]
l4: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl c) x $ by eq_trans [l2, l3]
l5: $ leqv a c $ by leqv_i [l4]

lemma k6_eq3 (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ B = D $ > $ G ⇒ A = C $
----
l1: $ G ⇒ A = D $ by eq_trans [#1, #3]
l2: $ G ⇒ D = C $ by eq_sym [#2]
l3: $ G ⇒ A = C $ by eq_trans [l1, l2]

lemma k6_lvo (G: hyps) (a: lvl) (w: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ lv (enc_lvl a) w ∈ ω $
----
l1: $ G ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l2: $ G ⇒ isset (enc_lvl a) $ by wcel_isset [l1]
l3: $ G ⇒ lv (enc_lvl a) w ∈ ω $ by lv_omega [l2, #1]

leqv_succ
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (ls a)) x = suc (lv (enc_lvl a) x) $ by lv_ls [l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ lv (enc_lvl (ls b)) x = suc (lv (enc_lvl b) x) $ by lv_ls [l5, l1]
l7: $ x ∊ lvals ⇒ suc (lv (enc_lvl a) x) = suc (lv (enc_lvl b) x) $ by suc_eq [l2]
l8: $ x ∊ lvals ⇒ lv (enc_lvl (ls a)) x = lv (enc_lvl (ls b)) x $ by k6_eq3 [l4, l6, l7]
l9: $ leqv (ls a) (ls b) $ by leqv_i [l8]

leqv_max
--------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ x ∊ lvals ⇒ lv (enc_lvl c) x = lv (enc_lvl d) x $ by leqv_e [#2, l1]
l4: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l5: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a c)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl c) x) $ by lv_lmax [l4, l5, l1]
l7: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l8: $ x ∊ lvals ⇒ enc_lvl d ∈ trees ω $ by enc_lvl_trees
l9: $ x ∊ lvals ⇒ lv (enc_lvl (lmax b d)) x = nmax (lv (enc_lvl b) x) (lv (enc_lvl d) x) $ by lv_lmax [l7, l8, l1]
l10: $ x ∊ lvals ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl c) x) = nmax (lv (enc_lvl b) x) (lv (enc_lvl d) x) $ by nmax_eq [l2, l3]
l11: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a c)) x = lv (enc_lvl (lmax b d)) x $ by k6_eq3 [l6, l9, l10]
l12: $ leqv (lmax a c) (lmax b d) $ by leqv_i [l11]

leqv_imax
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl b) x $ by leqv_e [#1, l1]
l3: $ x ∊ lvals ⇒ lv (enc_lvl c) x = lv (enc_lvl d) x $ by leqv_e [#2, l1]
l4: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l5: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ lv (enc_lvl (limax a c)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x) $ by lv_limax [l4, l5, l1]
l7: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l8: $ x ∊ lvals ⇒ enc_lvl d ∈ trees ω $ by enc_lvl_trees
l9: $ x ∊ lvals ⇒ lv (enc_lvl (limax b d)) x = nimax (lv (enc_lvl b) x) (lv (enc_lvl d) x) $ by lv_limax [l7, l8, l1]
l10: $ x ∊ lvals ⇒ nimax (lv (enc_lvl a) x) (lv (enc_lvl c) x) = nimax (lv (enc_lvl b) x) (lv (enc_lvl d) x) $ by nimax_eq [l2, l3]
l11: $ x ∊ lvals ⇒ lv (enc_lvl (limax a c)) x = lv (enc_lvl (limax b d)) x $ by k6_eq3 [l6, l9, l10]
l12: $ leqv (limax a c) (limax b d) $ by leqv_i [l11]

lmax_comm
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a b)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x) $ by lv_lmax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l7: $ x ∊ lvals ⇒ lv (enc_lvl (lmax b a)) x = nmax (lv (enc_lvl b) x) (lv (enc_lvl a) x) $ by lv_lmax [l5, l6, l1]
l10: $ x ∊ lvals ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x) = nmax (lv (enc_lvl b) x) (lv (enc_lvl a) x) $ by nmax_comm_c
l11: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a b)) x = lv (enc_lvl (lmax b a)) x $ by k6_eq3 [l4, l7, l10]
l12: $ leqv (lmax a b) (lmax b a) $ by leqv_i [l11]

lmax_assoc
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl (lmax a b) ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (lmax a b) c)) x = nmax (lv (enc_lvl (lmax a b)) x) (lv (enc_lvl c) x) $ by lv_lmax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l7: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a b)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x) $ by lv_lmax [l5, l6, l1]
l8: $ x ∊ lvals ⇒ lv (enc_lvl c) x = lv (enc_lvl c) x $ by eq_refl
l9: $ x ∊ lvals ⇒ nmax (lv (enc_lvl (lmax a b)) x) (lv (enc_lvl c) x) = nmax (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (lv (enc_lvl c) x) $ by nmax_eq [l7, l8]
l10: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (lmax a b) c)) x = nmax (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (lv (enc_lvl c) x) $ by eq_trans [l4, l9]
l11: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l12: $ x ∊ lvals ⇒ enc_lvl (lmax b c) ∈ trees ω $ by enc_lvl_trees
l13: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a (lmax b c))) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl (lmax b c)) x) $ by lv_lmax [l11, l12, l1]
l14: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l15: $ x ∊ lvals ⇒ enc_lvl c ∈ trees ω $ by enc_lvl_trees
l16: $ x ∊ lvals ⇒ lv (enc_lvl (lmax b c)) x = nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x) $ by lv_lmax [l14, l15, l1]
l17: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l18: $ x ∊ lvals ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl (lmax b c)) x) = nmax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nmax_eq [l17, l16]
l19: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a (lmax b c))) x = nmax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by eq_trans [l13, l18]
l23: $ x ∊ lvals ⇒ nmax (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) (lv (enc_lvl c) x) = nmax (lv (enc_lvl a) x) (nmax (lv (enc_lvl b) x) (lv (enc_lvl c) x)) $ by nmax_assoc_c
l24: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (lmax a b) c)) x = lv (enc_lvl (lmax a (lmax b c))) x $ by k6_eq3 [l10, l19, l23]
l25: $ leqv (lmax (lmax a b) c) (lmax a (lmax b c)) $ by leqv_i [l24]

lmax_idem
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a a)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl a) x) $ by lv_lmax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
