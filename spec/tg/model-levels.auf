l8: $ x ∊ lvals ⇒ lv (enc_lvl (limax a a)) x = lv (enc_lvl a) x $ by k6_eq3 [l4, l5, l7]
l9: $ leqv (limax a a) a $ by leqv_i [l8]

limax_max
---------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
