l357: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j , k ∊ ω ⇒ v ∊ fseq (trees ω) → crn v ⊆ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)} → ⟨ k , v ⟩ ∈ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)} $ by imp_intro [l356]
l358: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ k ∊ ω → v ∊ fseq (trees ω) → crn v ⊆ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)} → ⟨ k , v ⟩ ∈ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)} $ by imp_intro [l357]
l359: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ ∀ v (k ∊ ω → v ∊ fseq (trees ω) → crn v ⊆ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)} → ⟨ k , v ⟩ ∈ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)}) $ by all_intro [l358]
l360: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ ∀ k ∀ v (k ∊ ω → v ∊ fseq (trees ω) → crn v ⊆ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)} → ⟨ k , v ⟩ ∈ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)}) $ by all_intro [l359]
l361o: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ isset ω $ by omega_set
l361: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ trees ω ⊆ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)} $ by trees_ind_c [l361o, l360]
l362: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ kr_lsubst ∈ ω $ by kr_lsubst_omega
l363: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ isset kr_lsubst $ by wcel_isset [l362]
l364: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ ra_lsubst t1 t2 t3 t4 ∈ lrel $ by weaken [#1]
l365: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by lrel_args4 [l364, l363]
l366: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [l365]
l367: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ t2 ∊ trees ω $ by and_elim_l [l366]
l368: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ t2 ∊ {x | ∀ z (⟨ kr_lsubst , scons t1 (scons x (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv x f)} $ by subset_elim [l361, l367]
l369: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ ∀ z (⟨ kr_lsubst , scons t1 (scons t2 (scons t3 (scons z ∅))) ⟩ ∈ lrel → lv z w = lv t2 f) $ by cab_elim [l368]
l370: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ ⟨ kr_lsubst , scons t1 (scons t2 (scons t3 (scons t4 ∅))) ⟩ ∈ lrel → lv t4 w = lv t2 f $ by all_elim [l369]
l371: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ lv t4 w = lv t2 f $ by imp_elim [l370, l364]
l372: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ w = w $ by eq_refl
l373: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ i = fv nvf t1 $ by ax
l374: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ j = lv t3 w $ by ax
l375: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ lupd w i j = lupd w (fv nvf t1) (lv t3 w) $ by lupd_eq [l372, l373, l374]
l376: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ f = lupd w (fv nvf t1) (lv t3 w) $ by eq_trans [l20, l375]
l377: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ t2 = t2 $ by eq_refl
l378: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ lv t2 f = lv t2 (lupd w (fv nvf t1) (lv t3 w)) $ by lv_eq [l377, l376]
l379: $ G , i = fv nvf t1 , j = lv t3 w , f = lupd w i j ⇒ lv t4 w = lv t2 (lupd w (fv nvf t1) (lv t3 w)) $ by eq_trans [l371, l378]
l380: $ G , i = fv nvf t1 , j = lv t3 w ⇒ lv t4 w = lv t2 (lupd w (fv nvf t1) (lv t3 w)) $ by isset_elim [l19, l379]
l381: $ G , i = fv nvf t1 ⇒ lv t4 w = lv t2 (lupd w (fv nvf t1) (lv t3 w)) $ by isset_elim [l6, l380]
