d9: $ G , ∅ ∈ b , ∅ = c ⇒ nmax (nimax a b) (nimax a c) = nmax (nimax a b) ∅ $ by nmax_eq [d8, d2]
d10: $ G , ∅ ∈ b , ∅ = c ⇒ ∅ ⊆ nimax a b $ by empty_subset
d11: $ G , ∅ ∈ b , ∅ = c ⇒ nmax (nimax a b) ∅ = nimax a b $ by nmax_eq_l_c [d10]
