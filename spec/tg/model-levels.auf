l3: $ x ∊ lvals ⇒ enc_lvl (lmax b c) ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (limax a (lmax b c))) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl (lmax b c)) x) $ by lv_limax [l2, l3, l1]
