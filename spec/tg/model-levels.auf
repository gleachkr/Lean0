-- Proofs for model-levels.mm0.

lsig_ofsort_trees
-----------------
l1: $ G ⇒ sig lsig lopen $ by lsig_sig
l2: $ G ⇒ ofsort lsig lopen K ⊆ trees ω $ by ofsort_trees [l1]
l3: $ G ⇒ t ∊ trees ω $ by subset_elim [l2, #1]
l4: $ G ⇒ t ∈ trees ω $ by welc_wcel [l3]

lrel_latoms
-----------
l1: $ G ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ G ⇒ horn lprog ⊆ latoms $ by horn_sub [l1]
l3: $ G ⇒ X ∈ latoms $ by wcel_subset [l2, #1]

lrel_args2
----------
l1: $ G ⇒ ⟨ K , scons a (scons b ∅) ⟩ ∈ latoms $ by lrel_latoms [#1]
e0: $ G ⇒ isset ∅ $ by ax_empty
e1: $ G ⇒ isset (scons b ∅) $ by scons_set [e0]
e2: $ G ⇒ isset (scons a (scons b ∅)) $ by scons_set [e1]
m1: $ G ⇒ K ∈ ω ∧ scons a (scons b ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, #2, e2]
m2: $ G ⇒ scons a (scons b ∅) ∈ fseq (trees ω) $ by and_elim_r [m1]
c0: $ G ⇒ crn (scons a (scons b ∅)) ⊆ trees ω $ by fseq_crn_c [m2]
s0: $ G ⇒ isset a $ by isset_var
h0: $ G ⇒ a ∈ trees ω $ by crn_scons_head [s0, c0]
w0: $ G ⇒ a ∊ trees ω $ by wcel_welc [h0]
c1: $ G ⇒ crn (scons b ∅) ⊆ trees ω $ by crn_scons_tail [c0]
s1: $ G ⇒ isset b $ by isset_var
h1: $ G ⇒ b ∈ trees ω $ by crn_scons_head [s1, c1]
w1: $ G ⇒ b ∊ trees ω $ by wcel_welc [h1]
k0: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by and_intro [w0, w1]

lrel_args3
----------
l1: $ G ⇒ ⟨ K , scons a (scons b (scons c ∅)) ⟩ ∈ latoms $ by lrel_latoms [#1]
e0: $ G ⇒ isset ∅ $ by ax_empty
e1: $ G ⇒ isset (scons c ∅) $ by scons_set [e0]
e2: $ G ⇒ isset (scons b (scons c ∅)) $ by scons_set [e1]
e3: $ G ⇒ isset (scons a (scons b (scons c ∅))) $ by scons_set [e2]
m1: $ G ⇒ K ∈ ω ∧ scons a (scons b (scons c ∅)) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, #2, e3]
m2: $ G ⇒ scons a (scons b (scons c ∅)) ∈ fseq (trees ω) $ by and_elim_r [m1]
c0: $ G ⇒ crn (scons a (scons b (scons c ∅))) ⊆ trees ω $ by fseq_crn_c [m2]
s0: $ G ⇒ isset a $ by isset_var
h0: $ G ⇒ a ∈ trees ω $ by crn_scons_head [s0, c0]
w0: $ G ⇒ a ∊ trees ω $ by wcel_welc [h0]
c1: $ G ⇒ crn (scons b (scons c ∅)) ⊆ trees ω $ by crn_scons_tail [c0]
s1: $ G ⇒ isset b $ by isset_var
h1: $ G ⇒ b ∈ trees ω $ by crn_scons_head [s1, c1]
w1: $ G ⇒ b ∊ trees ω $ by wcel_welc [h1]
c2: $ G ⇒ crn (scons c ∅) ⊆ trees ω $ by crn_scons_tail [c1]
s2: $ G ⇒ isset c $ by isset_var
h2: $ G ⇒ c ∈ trees ω $ by crn_scons_head [s2, c2]
w2: $ G ⇒ c ∊ trees ω $ by wcel_welc [h2]
k1: $ G ⇒ b ∊ trees ω ∧ c ∊ trees ω $ by and_intro [w1, w2]
k0: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω ∧ c ∊ trees ω $ by and_intro [w0, k1]

lrel_args4
----------
l1: $ G ⇒ ⟨ K , scons a (scons b (scons c (scons d ∅))) ⟩ ∈ latoms $ by lrel_latoms [#1]
e0: $ G ⇒ isset ∅ $ by ax_empty
e1: $ G ⇒ isset (scons d ∅) $ by scons_set [e0]
e2: $ G ⇒ isset (scons c (scons d ∅)) $ by scons_set [e1]
e3: $ G ⇒ isset (scons b (scons c (scons d ∅))) $ by scons_set [e2]
e4: $ G ⇒ isset (scons a (scons b (scons c (scons d ∅)))) $ by scons_set [e3]
m1: $ G ⇒ K ∈ ω ∧ scons a (scons b (scons c (scons d ∅))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, #2, e4]
m2: $ G ⇒ scons a (scons b (scons c (scons d ∅))) ∈ fseq (trees ω) $ by and_elim_r [m1]
c0: $ G ⇒ crn (scons a (scons b (scons c (scons d ∅)))) ⊆ trees ω $ by fseq_crn_c [m2]
s0: $ G ⇒ isset a $ by isset_var
h0: $ G ⇒ a ∈ trees ω $ by crn_scons_head [s0, c0]
w0: $ G ⇒ a ∊ trees ω $ by wcel_welc [h0]
c1: $ G ⇒ crn (scons b (scons c (scons d ∅))) ⊆ trees ω $ by crn_scons_tail [c0]
s1: $ G ⇒ isset b $ by isset_var
h1: $ G ⇒ b ∈ trees ω $ by crn_scons_head [s1, c1]
w1: $ G ⇒ b ∊ trees ω $ by wcel_welc [h1]
c2: $ G ⇒ crn (scons c (scons d ∅)) ⊆ trees ω $ by crn_scons_tail [c1]
s2: $ G ⇒ isset c $ by isset_var
h2: $ G ⇒ c ∈ trees ω $ by crn_scons_head [s2, c2]
w2: $ G ⇒ c ∊ trees ω $ by wcel_welc [h2]
c3: $ G ⇒ crn (scons d ∅) ⊆ trees ω $ by crn_scons_tail [c2]
s3: $ G ⇒ isset d $ by isset_var
h3: $ G ⇒ d ∈ trees ω $ by crn_scons_head [s3, c3]
w3: $ G ⇒ d ∊ trees ω $ by wcel_welc [h3]
k2: $ G ⇒ c ∊ trees ω ∧ d ∊ trees ω $ by and_intro [w2, w3]
k1: $ G ⇒ b ∊ trees ω ∧ c ∊ trees ω ∧ d ∊ trees ω $ by and_intro [w1, k2]
k0: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω ∧ c ∊ trees ω ∧ d ∊ trees ω $ by and_intro [w0, k1]

nimax_congr
-----------
l1: $ nmax A C ≐ nmax B D $ by nmax_congr [#1, #2]
l2: $ seqt x x $ by seqt_refl
l3: $ (x ∊ nmax A C) ⟺ (x ∊ nmax B D) $ by welc_congr [l2, l1]
l4: $ seqt y y $ by seqt_refl
l5: $ (y ∊ C) ⟺ (y ∊ D) $ by welc_congr [l4, #2]
l6: $ ∃ y (y ∊ C) ⟺ ∃ y (y ∊ D) $ by ex_congr [l5]
l7: $ (x ∊ nmax A C ∧ ∃ y (y ∊ C)) ⟺ (x ∊ nmax B D ∧ ∃ y (y ∊ D)) $ by and_congr [l3, l6]
l8: $ {x | x ∊ nmax A C ∧ ∃ y (y ∊ C)} ≐ {x | x ∊ nmax B D ∧ ∃ y (y ∊ D)} $ by cab_congr [l7]

lemma k1_welc_nimax_eq (G: hyps) (A B C D: class) (a: set):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ a ∊ nimax A C $ > $ G ⇒ a ∊ nimax B D $
----
l1: $ G ⇒ a ∊ nmax A C ∧ ∃ y (y ∊ C) $ by cab_elim [#3]
l2: $ G ⇒ a ∊ nmax A C $ by and_elim_l [l1]
l3: $ G ⇒ nmax A C = nmax B D $ by nmax_eq [#1, #2]
l4: $ G ⇒ a ∊ nmax B D $ by welc_eq [l3, l2]
l5: $ G ⇒ ∃ y (y ∊ C) $ by and_elim_r [l1]
l6: $ G , y ∊ C ⇒ y ∊ C $ by ax
l7: $ G , y ∊ C ⇒ C = D $ by weaken [#2]
l8: $ G , y ∊ C ⇒ y ∊ D $ by welc_eq [l7, l6]
l9: $ G ⇒ y ∊ C → y ∊ D $ by imp_intro [l8]
l10: $ G ⇒ ∀ y (y ∊ C → y ∊ D) $ by all_intro [l9]
l11: $ G ⇒ ∃ y (y ∊ D) $ by ex_mp [l10, l5]
l12: $ G ⇒ a ∊ nmax B D ∧ ∃ y (y ∊ D) $ by and_intro [l4, l11]
l13: $ G ⇒ a ∊ nimax B D $ by cab_intro [l12]

nimax_eq
--------
l1: $ G , u ∊ nimax A C ⇒ u ∊ nimax A C $ by ax
l2: $ G , u ∊ nimax A C ⇒ A = B $ by weaken [#1]
l3: $ G , u ∊ nimax A C ⇒ C = D $ by weaken [#2]
l4: $ G , u ∊ nimax A C ⇒ u ∊ nimax B D $ by k1_welc_nimax_eq [l2, l3, l1]
l5: $ G ⇒ B = A $ by eq_sym [#1]
l6: $ G ⇒ D = C $ by eq_sym [#2]
l7: $ G , u ∊ nimax B D ⇒ u ∊ nimax B D $ by ax
l8: $ G , u ∊ nimax B D ⇒ B = A $ by weaken [l5]
l9: $ G , u ∊ nimax B D ⇒ D = C $ by weaken [l6]
l10: $ G , u ∊ nimax B D ⇒ u ∊ nimax A C $ by k1_welc_nimax_eq [l8, l9, l7]
l11: $ G ⇒ nimax A C = nimax B D $ by eq_intro [l4, l10]

sb_c_nimax
----------
l1: $ (⟦ x / t ⟧ {z | z ∊ nmax A B ∧ ∃ y (y ∊ B)}) ≐ {z | z ∊ nmax (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) ∧ ∃ y (y ∊ (⟦ x / t ⟧ B))} $ by ceqt_refl

nimax_pos_c
-----------
l1: $ G , u ∊ nimax A B ⇒ u ∊ nimax A B $ by ax
l2: $ G , u ∊ nimax A B ⇒ u ∊ nmax A B ∧ ∃ y (y ∊ B) $ by cab_elim [l1]
l3: $ G , u ∊ nimax A B ⇒ u ∊ nmax A B $ by and_elim_l [l2]
l4: $ G , u ∊ nmax A B ⇒ u ∊ nmax A B $ by ax
l5: $ G , u ∊ nmax A B ⇒ c ∊ B $ by weaken [#1]
l6: $ G , u ∊ nmax A B ⇒ ∃ y (y ∊ B) $ by ex_intro [l5]
l7: $ G , u ∊ nmax A B ⇒ u ∊ nmax A B ∧ ∃ y (y ∊ B) $ by and_intro [l4, l6]
l8: $ G , u ∊ nmax A B ⇒ u ∊ nimax A B $ by cab_intro [l7]
l9: $ G ⇒ nimax A B = nmax A B $ by eq_intro [l3, l8]

nimax_zero_c
------------
l1: $ G , u ∊ nimax A B ⇒ u ∊ nimax A B $ by ax
l2: $ G , u ∊ nimax A B ⇒ u ∊ nmax A B ∧ ∃ y (y ∊ B) $ by cab_elim [l1]
l3: $ G , u ∊ nimax A B ⇒ ∃ y (y ∊ B) $ by and_elim_r [l2]
l4: $ G , y ∊ B ⇒ y ∊ B $ by ax
l5: $ G , y ∊ B ⇒ B = ∅ $ by weaken [#1]
l6: $ G , y ∊ B ⇒ ⊥ $ by empty_eq_elim [l5, l4]
l7: $ G , u ∊ nimax A B ⇒ ⊥ $ by ex_elim [l3, l6]
l8: $ G ⇒ nimax A B = ∅ $ by empty_eq_intro [l7]

lemma k1_nimax_wpos_c (G: hyps) (A B: class):
  $ G ⇒ ∅ ∈ B $ > $ G ⇒ nimax A B = nmax A B $
----
l1: $ G , x = ∅ , x ∊ B ⇒ x ∊ B $ by ax
l2: $ G , x = ∅ , x ∊ B ⇒ nimax A B = nmax A B $ by nimax_pos_c [l1]
l3: $ G ⇒ nimax A B = nmax A B $ by wcel_elim [#1, l2]

nimax_zero
----------
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ nimax a ∅ = ∅ $ by nimax_zero_c [l1]

nimax_pos
---------
l1: $ G ⇒ nimax a b = nmax a b $ by nimax_pos_c [#1]

nimax_omega
-----------
l1: $ G ⇒ ∅ ∈ b ∨ ∅ = b $ by omega_zero_le [#2]
c1: $ G , ∅ ∈ b ⇒ ∅ ∈ b $ by ax
c2: $ G , ∅ ∈ b ⇒ nimax a b = nmax a b $ by k1_nimax_wpos_c [c1]
c3: $ G , ∅ ∈ b ⇒ nmax a b = nimax a b $ by eq_sym [c2]
c4: $ G , ∅ ∈ b ⇒ a ∊ ω $ by weaken [#1]
c5: $ G , ∅ ∈ b ⇒ b ∊ ω $ by weaken [#2]
c6: $ G , ∅ ∈ b ⇒ nmax a b ∈ ω $ by nmax_omega [c4, c5]
c7: $ G , ∅ ∈ b ⇒ nimax a b ∈ ω $ by wcel_eq_l [c3, c6]
d1: $ G , ∅ = b ⇒ ∅ = b $ by ax
d2s: $ G , ∅ = b ⇒ b = ∅ $ by eq_sym [d1]
d2: $ G , ∅ = b ⇒ nimax a b = ∅ $ by nimax_zero_c [d2s]
d3: $ G , ∅ = b ⇒ ∅ = nimax a b $ by eq_sym [d2]
d4: $ G , ∅ = b ⇒ ∅ ∈ ω $ by omega_zero
d5: $ G , ∅ = b ⇒ nimax a b ∈ ω $ by wcel_eq_l [d3, d4]
l2: $ G ⇒ nimax a b ∈ ω $ by or_elim [l1, c7, d5]

nimax_omega_c
-------------
l1: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ a ∊ ω $ by ax
l2: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ b ∊ ω $ by ax
l3: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ nimax a b ∈ ω $ by nimax_omega [l1, l2]
l4: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ a = A $ by ax
l5: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ b = B $ by ax
l6: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ nimax a b = nimax A B $ by nimax_eq [l4, l5]
l7: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ nimax A B ∈ ω $ by wcel_eq_l [l6, l3]
l8: $ G , a = A , a ∊ ω ⇒ nimax A B ∈ ω $ by wcel_elim [#2, l7]
l9: $ G ⇒ nimax A B ∈ ω $ by wcel_elim [#1, l8]

nmax_assoc
----------
l1: $ G ⇒ a ⊆ nmax a (nmax b c) $ by cun_subset_l
l2: $ G ⇒ nmax b c ⊆ nmax a (nmax b c) $ by cun_subset_r
l3: $ G ⇒ b ⊆ nmax b c $ by cun_subset_l
l4: $ G ⇒ c ⊆ nmax b c $ by cun_subset_r
l5: $ G ⇒ b ⊆ nmax a (nmax b c) $ by subset_trans [l3, l2]
l6: $ G ⇒ c ⊆ nmax a (nmax b c) $ by subset_trans [l4, l2]
l7: $ G ⇒ nmax a b ⊆ nmax a (nmax b c) $ by cun_least [l1, l5]
l8: $ G ⇒ nmax (nmax a b) c ⊆ nmax a (nmax b c) $ by cun_least [l7, l6]
m1: $ G ⇒ nmax a b ⊆ nmax (nmax a b) c $ by cun_subset_l
m2: $ G ⇒ c ⊆ nmax (nmax a b) c $ by cun_subset_r
m3: $ G ⇒ a ⊆ nmax a b $ by cun_subset_l
m4: $ G ⇒ b ⊆ nmax a b $ by cun_subset_r
m5: $ G ⇒ a ⊆ nmax (nmax a b) c $ by subset_trans [m3, m1]
m6: $ G ⇒ b ⊆ nmax (nmax a b) c $ by subset_trans [m4, m1]
m7: $ G ⇒ nmax b c ⊆ nmax (nmax a b) c $ by cun_least [m6, m2]
m8: $ G ⇒ nmax a (nmax b c) ⊆ nmax (nmax a b) c $ by cun_least [m5, m7]
l9: $ G ⇒ nmax (nmax a b) c = nmax a (nmax b c) $ by subset_antisym [l8, m8]

nmax_assoc_c
------------
l1: $ G ⇒ A ⊆ nmax A (nmax B C) $ by cun_subset_l
l2: $ G ⇒ nmax B C ⊆ nmax A (nmax B C) $ by cun_subset_r
l3: $ G ⇒ B ⊆ nmax B C $ by cun_subset_l
l4: $ G ⇒ C ⊆ nmax B C $ by cun_subset_r
l5: $ G ⇒ B ⊆ nmax A (nmax B C) $ by subset_trans [l3, l2]
l6: $ G ⇒ C ⊆ nmax A (nmax B C) $ by subset_trans [l4, l2]
l7: $ G ⇒ nmax A B ⊆ nmax A (nmax B C) $ by cun_least [l1, l5]
l8: $ G ⇒ nmax (nmax A B) C ⊆ nmax A (nmax B C) $ by cun_least [l7, l6]
m1: $ G ⇒ nmax A B ⊆ nmax (nmax A B) C $ by cun_subset_l
m2: $ G ⇒ C ⊆ nmax (nmax A B) C $ by cun_subset_r
m3: $ G ⇒ A ⊆ nmax A B $ by cun_subset_l
m4: $ G ⇒ B ⊆ nmax A B $ by cun_subset_r
m5: $ G ⇒ A ⊆ nmax (nmax A B) C $ by subset_trans [m3, m1]
m6: $ G ⇒ B ⊆ nmax (nmax A B) C $ by subset_trans [m4, m1]
m7: $ G ⇒ nmax B C ⊆ nmax (nmax A B) C $ by cun_least [m6, m2]
m8: $ G ⇒ nmax A (nmax B C) ⊆ nmax (nmax A B) C $ by cun_least [m5, m7]
l9: $ G ⇒ nmax (nmax A B) C = nmax A (nmax B C) $ by subset_antisym [l8, m8]

nmax_idem
---------
l1: $ G ⇒ a ⊆ a $ by subset_refl
l2: $ G ⇒ nmax a a = a $ by nmax_eq_l [l1]

nmax_idem_c
-----------
l1: $ G ⇒ A ⊆ A $ by subset_refl
l2: $ G ⇒ nmax A A = A $ by nmax_eq_l_c [l1]

nmax_zero_l
-----------
l1: $ G ⇒ ∅ ⊆ a $ by empty_subset
l2: $ G ⇒ nmax ∅ a = a $ by nmax_eq_r_c [l1]

nmax_zero_l_c
-------------
l1: $ G ⇒ ∅ ⊆ A $ by empty_subset
l2: $ G ⇒ nmax ∅ A = A $ by nmax_eq_r_c [l1]

nmax_suc
--------
l1: $ G ⇒ ord a $ by ord_omega_elem [#1]
l2: $ G ⇒ ord b $ by ord_omega_elem [#2]
l3: $ G ⇒ a ⊆ b ∨ b ⊆ a $ by ord_subset_or [l1, l2]
c1: $ G , a ⊆ b ⇒ a ⊆ b $ by ax
c2: $ G , a ⊆ b ⇒ ord a $ by weaken [l1]
c3: $ G , a ⊆ b ⇒ ord b $ by weaken [l2]
c4: $ G , a ⊆ b ⇒ suc a ⊆ suc b $ by ord_suc_subset [c2, c3, c1]
c5: $ G , a ⊆ b ⇒ nmax (suc a) (suc b) = suc b $ by nmax_eq_r_c [c4]
c6: $ G , a ⊆ b ⇒ nmax a b = b $ by nmax_eq_r [c1]
c7: $ G , a ⊆ b ⇒ suc (nmax a b) = suc b $ by suc_eq [c6]
c8: $ G , a ⊆ b ⇒ suc b = suc (nmax a b) $ by eq_sym [c7]
c9: $ G , a ⊆ b ⇒ nmax (suc a) (suc b) = suc (nmax a b) $ by eq_trans [c5, c8]
d1: $ G , b ⊆ a ⇒ b ⊆ a $ by ax
d2: $ G , b ⊆ a ⇒ ord a $ by weaken [l1]
d3: $ G , b ⊆ a ⇒ ord b $ by weaken [l2]
d4: $ G , b ⊆ a ⇒ suc b ⊆ suc a $ by ord_suc_subset [d3, d2, d1]
d5: $ G , b ⊆ a ⇒ nmax (suc a) (suc b) = suc a $ by nmax_eq_l_c [d4]
d6: $ G , b ⊆ a ⇒ nmax a b = a $ by nmax_eq_l [d1]
d7: $ G , b ⊆ a ⇒ suc (nmax a b) = suc a $ by suc_eq [d6]
d8: $ G , b ⊆ a ⇒ suc a = suc (nmax a b) $ by eq_sym [d7]
d9: $ G , b ⊆ a ⇒ nmax (suc a) (suc b) = suc (nmax a b) $ by eq_trans [d5, d8]
l4: $ G ⇒ nmax (suc a) (suc b) = suc (nmax a b) $ by or_elim [l3, c9, d9]

lemma k6_eq3s (G: hyps) (A B C D: class):
  $ G ⇒ B = A $ > $ G ⇒ D = C $ > $ G ⇒ B = D $ > $ G ⇒ A = C $
----
l1: $ G ⇒ A = B $ by eq_sym [#1]
l2: $ G ⇒ A = D $ by eq_trans [l1, #3]
l3: $ G ⇒ A = C $ by eq_trans [l2, #2]

nmax_suc_c
----------
l1: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ y = A $ by ax
l2: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ z = B $ by ax
l3: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ y ∊ ω $ by ax
l4: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ z ∊ ω $ by ax
l5: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ nmax (suc y) (suc z) = suc (nmax y z) $ by nmax_suc [l3, l4]
l6: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ suc y = suc A $ by suc_eq [l1]
l7: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ suc z = suc B $ by suc_eq [l2]
l8: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ nmax (suc y) (suc z) = nmax (suc A) (suc B) $ by nmax_eq [l6, l7]
l9: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ nmax y z = nmax A B $ by nmax_eq [l1, l2]
l10: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ suc (nmax y z) = suc (nmax A B) $ by suc_eq [l9]
l11: $ G , y = A , y ∊ ω , z = B , z ∊ ω ⇒ nmax (suc A) (suc B) = suc (nmax A B) $ by k6_eq3s [l8, l10, l5]
