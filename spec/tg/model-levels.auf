l16: $ G ⇒ nimax A (nmax B C) = nmax (nimax A B) (nimax A C) $ by wcel_elim [#1, l15]

lemma k1_cun_distr2 (G: hyps) (A B C: class): $ G ⇒ A ∪ (B ∪ C) = (A ∪ C) ∪ (B ∪ C) $
----
l1: $ G ⇒ A ⊆ A ∪ C $ by cun_subset_l
l2: $ G ⇒ A ∪ C ⊆ (A ∪ C) ∪ (B ∪ C) $ by cun_subset_l
l3: $ G ⇒ B ∪ C ⊆ (A ∪ C) ∪ (B ∪ C) $ by cun_subset_r
l4: $ G ⇒ A ⊆ (A ∪ C) ∪ (B ∪ C) $ by subset_trans [l1, l2]
l5: $ G ⇒ A ∪ (B ∪ C) ⊆ (A ∪ C) ∪ (B ∪ C) $ by cun_least [l4, l3]
m1: $ G ⇒ A ⊆ A ∪ (B ∪ C) $ by cun_subset_l
m2: $ G ⇒ B ∪ C ⊆ A ∪ (B ∪ C) $ by cun_subset_r
m3: $ G ⇒ C ⊆ B ∪ C $ by cun_subset_r
m4: $ G ⇒ C ⊆ A ∪ (B ∪ C) $ by subset_trans [m3, m2]
m5: $ G ⇒ A ∪ C ⊆ A ∪ (B ∪ C) $ by cun_least [m1, m4]
m6: $ G ⇒ (A ∪ C) ∪ (B ∪ C) ⊆ A ∪ (B ∪ C) $ by cun_least [m5, m2]
l6: $ G ⇒ A ∪ (B ∪ C) = (A ∪ C) ∪ (B ∪ C) $ by subset_antisym [l5, m6]

