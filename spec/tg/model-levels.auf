l4: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (ls a) (ls b))) x = nmax (lv (enc_lvl (ls a)) x) (lv (enc_lvl (ls b)) x) $ by lv_lmax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ lv (enc_lvl (ls a)) x = suc (lv (enc_lvl a) x) $ by lv_ls [l5, l1]
l7: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l8: $ x ∊ lvals ⇒ lv (enc_lvl (ls b)) x = suc (lv (enc_lvl b) x) $ by lv_ls [l7, l1]
l9: $ x ∊ lvals ⇒ nmax (lv (enc_lvl (ls a)) x) (lv (enc_lvl (ls b)) x) = nmax (suc (lv (enc_lvl a) x)) (suc (lv (enc_lvl b) x)) $ by nmax_eq [l6, l8]
l10: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (ls a) (ls b))) x = nmax (suc (lv (enc_lvl a) x)) (suc (lv (enc_lvl b) x)) $ by eq_trans [l4, l9]
l11: $ x ∊ lvals ⇒ enc_lvl (lmax a b) ∈ trees ω $ by enc_lvl_trees
l12: $ x ∊ lvals ⇒ lv (enc_lvl (ls (lmax a b))) x = suc (lv (enc_lvl (lmax a b)) x) $ by lv_ls [l11, l1]
l13: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l14: $ x ∊ lvals ⇒ enc_lvl b ∈ trees ω $ by enc_lvl_trees
l15: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a b)) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x) $ by lv_lmax [l13, l14, l1]
l16: $ x ∊ lvals ⇒ suc (lv (enc_lvl (lmax a b)) x) = suc (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) $ by suc_eq [l15]
l17: $ x ∊ lvals ⇒ lv (enc_lvl (ls (lmax a b))) x = suc (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) $ by eq_trans [l12, l16]
l18: $ x ∊ lvals ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l19: $ x ∊ lvals ⇒ lv (enc_lvl b) x ∈ ω $ by k6_lvo [l1]
l20: $ x ∊ lvals ⇒ nmax (suc (lv (enc_lvl a) x)) (suc (lv (enc_lvl b) x)) = suc (nmax (lv (enc_lvl a) x) (lv (enc_lvl b) x)) $ by nmax_suc_c [l18, l19]
l21: $ x ∊ lvals ⇒ lv (enc_lvl (lmax (ls a) (ls b))) x = lv (enc_lvl (ls (lmax a b))) x $ by k6_eq3 [l10, l17, l20]
l22: $ leqv (lmax (ls a) (ls b)) (ls (lmax a b)) $ by leqv_i [l21]

lmax_succ_self
--------------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl (ls a) ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a (ls a))) x = nmax (lv (enc_lvl a) x) (lv (enc_lvl (ls a)) x) $ by lv_lmax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l6: $ x ∊ lvals ⇒ lv (enc_lvl (ls a)) x = suc (lv (enc_lvl a) x) $ by lv_ls [l5, l1]
l7: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l8: $ x ∊ lvals ⇒ nmax (lv (enc_lvl a) x) (lv (enc_lvl (ls a)) x) = nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl a) x)) $ by nmax_eq [l7, l6]
l9: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a (ls a))) x = nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl a) x)) $ by eq_trans [l4, l8]
l10: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l11: $ x ∊ lvals ⇒ lv (enc_lvl (ls a)) x = suc (lv (enc_lvl a) x) $ by lv_ls [l10, l1]
l12: $ x ∊ lvals ⇒ lv (enc_lvl a) x ∈ ω $ by k6_lvo [l1]
l13: $ x ∊ lvals ⇒ nmax (lv (enc_lvl a) x) (suc (lv (enc_lvl a) x)) = suc (lv (enc_lvl a) x) $ by nmax_suc_self_c [l12]
l14: $ x ∊ lvals ⇒ lv (enc_lvl (lmax a (ls a))) x = lv (enc_lvl (ls a)) x $ by k6_eq3 [l9, l11, l13]
l15: $ leqv (lmax a (ls a)) (ls a) $ by leqv_i [l14]

limax_zero
----------
l1: $ x ∊ lvals ⇒ x ∊ lvals $ by ax
l2: $ x ∊ lvals ⇒ enc_lvl a ∈ trees ω $ by enc_lvl_trees
l3: $ x ∊ lvals ⇒ enc_lvl lz ∈ trees ω $ by enc_lvl_trees
l4: $ x ∊ lvals ⇒ lv (enc_lvl (limax a lz)) x = nimax (lv (enc_lvl a) x) (lv (enc_lvl lz) x) $ by lv_limax [l2, l3, l1]
l5: $ x ∊ lvals ⇒ lv (enc_lvl lz) x = ∅ $ by lv_lz
l6: $ x ∊ lvals ⇒ lv (enc_lvl a) x = lv (enc_lvl a) x $ by eq_refl
l7: $ x ∊ lvals ⇒ nimax (lv (enc_lvl a) x) (lv (enc_lvl lz) x) = nimax (lv (enc_lvl a) x) ∅ $ by nimax_eq [l6, l5]
l8: $ x ∊ lvals ⇒ lv (enc_lvl (limax a lz)) x = nimax (lv (enc_lvl a) x) ∅ $ by eq_trans [l4, l7]
l9: $ x ∊ lvals ⇒ lv (enc_lvl lz) x = ∅ $ by lv_lz
l10: $ x ∊ lvals ⇒ ∅ = ∅ $ by eq_refl
l11: $ x ∊ lvals ⇒ nimax (lv (enc_lvl a) x) ∅ = ∅ $ by nimax_zero_c [l10]
l12: $ x ∊ lvals ⇒ lv (enc_lvl (limax a lz)) x = lv (enc_lvl lz) x $ by k6_eq3 [l8, l9, l11]
l13: $ leqv (limax a lz) lz $ by leqv_i [l12]

