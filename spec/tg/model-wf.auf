sc6: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b g ff ee ∈ lrel → fv nvf g = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $ by imp_intro [sc5]
sr1: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ g (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b g ff ee ∈ lrel → fv nvf g = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by all_intro [sc6]
sr2: $ ∀ g (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b g ff ee ∈ lrel → fv nvf g = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) ⟺ ∀ x6 (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by all_alpha
sr3: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ g (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b g ff ee ∈ lrel → fv nvf g = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) ↔ ∀ x6 (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by weaken [sr2]
sr4: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ x6 (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by bi_elim_l [sr3, sr1]
sr5: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ b ∀ x6 (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by all_intro [sr4]
sr6: $ ∀ b ∀ x6 (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) ⟺ ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv a cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by all_alpha
sr7: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ b ∀ x6 (ra_tys_wf dd nv np lv a cx b ∈ lrel3 J → ra_nth_ty b x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) ↔ ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv a cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by weaken [sr6]
sr8: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv a cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by bi_elim_l [sr7, sr5]
sr9: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ a ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv a cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by all_intro [sr8]
sr10: $ ∀ a ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv a cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) ⟺ ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by all_alpha
sr11: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ a ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv a cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) ↔ ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by weaken [sr10]
sr12: $ G , m = fv nvf jj , m ∊ ω , x3 ∊ ω , ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x3 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) , x2 = suc x3 ⇒ ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = x2 → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by bi_elim_l [sr11, sr9]
f1: $ G , m = fv nvf jj , m ∊ ω ⇒ m ∊ ω $ by ax
f2: $ G , m = fv nvf jj , m ∊ ω ⇒ ∀ x4 ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv x4 cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = m → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by omega_ind_named [br12, sr12, f1]
f3: $ G , m = fv nvf jj , m ∊ ω ⇒ ∀ x5 ∀ x6 (ra_tys_wf dd nv np lv iv cx x5 ∈ lrel3 J → ra_nth_ty x5 x6 ff ee ∈ lrel → fv nvf x6 = m → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by all_elim [f2]
f4: $ G , m = fv nvf jj , m ∊ ω ⇒ ∀ x6 (ra_tys_wf dd nv np lv iv cx bb ∈ lrel3 J → ra_nth_ty bb x6 ff ee ∈ lrel → fv nvf x6 = m → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv)) $ by all_elim [f3]
f5: $ G , m = fv nvf jj , m ∊ ω ⇒ ra_tys_wf dd nv np lv iv cx bb ∈ lrel3 J → ra_nth_ty bb jj ff ee ∈ lrel → fv nvf jj = m → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $ by all_elim [f4]
f6: $ G , m = fv nvf jj , m ∊ ω ⇒ ra_tys_wf dd nv np lv iv cx bb ∈ lrel3 J $ by weaken [#1]
f7: $ G , m = fv nvf jj , m ∊ ω ⇒ ra_nth_ty bb jj ff ee ∈ lrel → fv nvf jj = m → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $ by imp_elim [f5, f6]
f8: $ G , m = fv nvf jj , m ∊ ω ⇒ ra_nth_ty bb jj ff ee ∈ lrel $ by weaken [#2]
f9: $ G , m = fv nvf jj , m ∊ ω ⇒ fv nvf jj = m → ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $ by imp_elim [f7, f8]
f10: $ G , m = fv nvf jj , m ∊ ω ⇒ m = fv nvf jj $ by ax
f11: $ G , m = fv nvf jj , m ∊ ω ⇒ fv nvf jj = m $ by eq_sym [f10]
f12: $ G , m = fv nvf jj , m ∊ ω ⇒ ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $ by imp_elim [f9, f11]
f13: $ G ⇒ isset jj $ by isset_var
f14: $ G ⇒ fv nvf jj ∈ ω $ by nvf_omega [f13]
f15: $ G ⇒ ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $ by wcel_elim [f14, f12]

lemma b3_iwf_w (G: hyps) (U H J C D W R: class) (w: set): $ G ⇒ iwf U H J C D W R $ > $ G ⇒ W = w $ > $ G ⇒ iwf U H J C D w R $
----
a1: $ G ⇒ uadm U $ by iwf_uadm [#1]
a2: $ G ⇒ hty ⊆ H $ by iwf_hty [#1]
a3: $ G ⇒ functional H $ by iwf_fn [#1]
a4: $ G ⇒ jval U (mcv H) J $ by iwf_jval [#1]
a5: $ G ⇒ ra_ind_wf C D ∈ lrel3 J $ by iwf_wf [#1]
a6: $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ by iwf_sort [#1]
a7: $ G ⇒ W ∈ lvals $ by iwf_lvals [#1]
a8: $ G ⇒ R ∈ sat U (mcv H) C W $ by iwf_sat [#1]
b1: $ G ⇒ w ∈ lvals $ by wcel_eq_l [#2, a7]
b2: $ G ⇒ C = C $ by eq_refl
b3: $ G ⇒ sat U (mcv H) C W = sat U (mcv H) C w $ by sat_eq [b2, #2]
b4: $ G ⇒ R ∈ sat U (mcv H) C w $ by wcel_eq_r [b3, a8]
c1: $ G ⇒ w ∈ lvals ∧ R ∈ sat U (mcv H) C w $ by and_intro [b1, b4]
c2: $ G ⇒ D ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ R ∈ sat U (mcv H) C w $ by and_intro [a6, c1]
c3: $ G ⇒ ra_ind_wf C D ∈ lrel3 J ∧ D ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ R ∈ sat U (mcv H) C w $ by and_intro [a5, c2]
c4: $ G ⇒ jval U (mcv H) J ∧ ra_ind_wf C D ∈ lrel3 J ∧ D ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ R ∈ sat U (mcv H) C w $ by and_intro [a4, c3]
c5: $ G ⇒ functional H ∧ jval U (mcv H) J ∧ ra_ind_wf C D ∈ lrel3 J ∧ D ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ R ∈ sat U (mcv H) C w $ by and_intro [a3, c4]
c6: $ G ⇒ hty ⊆ H ∧ functional H ∧ jval U (mcv H) J ∧ ra_ind_wf C D ∈ lrel3 J ∧ D ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ R ∈ sat U (mcv H) C w $ by and_intro [a2, c5]
c7: $ G ⇒ uadm U ∧ hty ⊆ H ∧ functional H ∧ jval U (mcv H) J ∧ ra_ind_wf C D ∈ lrel3 J ∧ D ∈ ofsort lsig lopen ks_ind ∧ w ∈ lvals ∧ R ∈ sat U (mcv H) C w $ by and_intro [a1, c6]

lemma b3_wf_set {c: set} (G: hyps) (J C: class) (d: set): $ G ⇒ ra_ind_wf C d ∈ lrel3 J $ > $ G ⇒ ∃ c (ra_ind_wf c d ∈ lrel3 J) $
----
a1: $ G , c = C ⇒ c = C $ by ax
a2: $ G , c = C ⇒ C = c $ by eq_sym [a1]
a3: $ G , c = C ⇒ d = d $ by eq_refl
a4: $ G , c = C ⇒ ra_ind_wf C d = ra_ind_wf c d $ by ra_ind_wf_eq [a2, a3]
a5: $ G , c = C ⇒ ra_ind_wf C d ∈ lrel3 J $ by weaken [#1]
a6: $ G , c = C ⇒ ra_ind_wf c d ∈ lrel3 J $ by wcel_eq_l [a4, a5]
a7: $ G , c = C ⇒ ∃ c (ra_ind_wf c d ∈ lrel3 J) $ by ex_intro [a6]
a8: $ G , isset C ⇒ isset C $ by ax
a9: $ G , isset C ⇒ ∃ c (ra_ind_wf c d ∈ lrel3 J) $ by isset_elim [a8, a7]
b1: $ G , ¬ isset C ⇒ ¬ isset C $ by ax
b2: $ G , ¬ isset C ⇒ scons C (scons d ∅) = scons ∅ (scons d ∅) $ by scons_proper [b1]
b3: $ G , ¬ isset C ⇒ kr_ind_wf = kr_ind_wf $ by eq_refl
b4: $ G , ¬ isset C ⇒ ⟨ kr_ind_wf , scons C (scons d ∅) ⟩ = ⟨ kr_ind_wf , scons ∅ (scons d ∅) ⟩ $ by opair_eq [b3, b2]
b6: $ G , ¬ isset C ⇒ ra_ind_wf C d ∈ lrel3 J $ by weaken [#1]
b7: $ G , ¬ isset C ⇒ ⟨ kr_ind_wf , scons ∅ (scons d ∅) ⟩ ∈ lrel3 J $ by wcel_eq_l [b4, b6]
b8: $ G , ¬ isset C , e = ∅ ⇒ e = ∅ $ by ax
b9: $ G , ¬ isset C , e = ∅ ⇒ ∅ = e $ by eq_sym [b8]
b10: $ G , ¬ isset C , e = ∅ ⇒ d = d $ by eq_refl
b11: $ G , ¬ isset C , e = ∅ ⇒ ra_ind_wf ∅ d = ra_ind_wf e d $ by ra_ind_wf_eq [b9, b10]
b12: $ G , ¬ isset C , e = ∅ ⇒ ra_ind_wf ∅ d ∈ lrel3 J $ by weaken [b7]
b13: $ G , ¬ isset C , e = ∅ ⇒ ra_ind_wf e d ∈ lrel3 J $ by wcel_eq_l [b11, b12]
b14: $ G , ¬ isset C , e = ∅ ⇒ ∃ c (ra_ind_wf c d ∈ lrel3 J) $ by ex_intro [b13]
b15: $ G , ¬ isset C ⇒ isset ∅ $ by ax_empty
b16: $ G , ¬ isset C ⇒ ∃ c (ra_ind_wf c d ∈ lrel3 J) $ by isset_elim [b15, b14]
c1: $ G ⇒ isset C ∨ ¬ isset C $ by excluded_middle
c2: $ G ⇒ ∃ c (ra_ind_wf c d ∈ lrel3 J) $ by or_elim [c1, a9, b16]

lemma b3_uni_sub (G: hyps) (A B: class) (n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ ¬ n = ∅ $ > $ G ⇒ A ∈ fv uni n $ > $ G ⇒ B ⊆ A $ > $ G ⇒ B ∈ fv uni n $
----
a1: $ G , n = ∅ ⇒ n = ∅ $ by ax
a2: $ G , n = ∅ ⇒ ¬ n = ∅ $ by weaken [#2]
a3: $ G , n = ∅ ⇒ ⊥ $ by not_elim [a2, a1]
a4: $ G , n = ∅ ⇒ B ∈ fv uni n $ by bot_elim [a3]
b1: $ G , y ∊ ω ∧ n = suc y ⇒ y ∊ ω ∧ n = suc y $ by ax
b2: $ G , y ∊ ω ∧ n = suc y ⇒ y ∊ ω $ by and_elim_l [b1]
b3: $ G , y ∊ ω ∧ n = suc y ⇒ n = suc y $ by and_elim_r [b1]
b4: $ G , y ∊ ω ∧ n = suc y ⇒ universe (fv uni (suc y)) $ by uni_universe [b2]
b5: $ G , y ∊ ω ∧ n = suc y ⇒ uni = uni $ by eq_refl
b6: $ G , y ∊ ω ∧ n = suc y ⇒ fv uni n = fv uni (suc y) $ by fv_eq [b5, b3]
b7: $ G , y ∊ ω ∧ n = suc y ⇒ A ∈ fv uni n $ by weaken [#3]
b8: $ G , y ∊ ω ∧ n = suc y ⇒ A ∈ fv uni (suc y) $ by wcel_eq_r [b6, b7]
b9: $ G , y ∊ ω ∧ n = suc y ⇒ B ⊆ A $ by weaken [#4]
b10: $ G , y ∊ ω ∧ n = suc y ⇒ B ∈ fv uni (suc y) $ by universe_subset_c [b4, b8, b9]
b11: $ G , y ∊ ω ∧ n = suc y ⇒ fv uni (suc y) = fv uni n $ by eq_sym [b6]
b12: $ G , y ∊ ω ∧ n = suc y ⇒ B ∈ fv uni n $ by wcel_eq_r [b11, b10]
c1: $ G , ∃ y (y ∊ ω ∧ n = suc y) ⇒ ∃ y (y ∊ ω ∧ n = suc y) $ by ax
c2: $ G , ∃ y (y ∊ ω ∧ n = suc y) ⇒ B ∈ fv uni n $ by ex_elim [c1, b12]
c3: $ G ⇒ n = ∅ ∨ ∃ y (y ∊ ω ∧ n = suc y) $ by omega_cases [#1]
c4: $ G ⇒ B ∈ fv uni n $ by or_elim [c3, a4, c2]

lemma b3_nest_len (G: hyps) (E T Ye Yc: class) (u w b q q0 x g o v x0 g0 o0 v0: set): $ G ⇒ b ∈ trees ω $ > $ G ⇒ T ∈ trees ω $ > $ G ⇒ q ∊ esat u E b w $ > $ G ⇒ q0 ∊ esat u E b w $ > $ G ⇒ ⟨ x , ⟨ g , ⟨ o , v ⟩ ⟩ ⟩ ∈ etel u E T w q $ > $ G ⇒ ⟨ x0 , ⟨ g0 , ⟨ o0 , v0 ⟩ ⟩ ⟩ ∈ etel u E T w q0 $ > $ G ⇒ nest (scat x q) Ye = nest (scat x0 q0) Yc $ > $ G ⇒ isset Ye $ > $ G ⇒ isset Yc $ > $ G ⇒ scat x q = scat x0 q0 ∧ Ye = Yc $
----
a1: $ G ⇒ isset w $ by isset_var
a2: $ G ⇒ x ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm x ∧ cdm o = cdm x $ by etel_fseq_c [a1, #2, #5]
a3: $ G ⇒ x ∊ fseq u $ by and_elim_l [a2]
a4: $ G ⇒ x0 ∊ fseq u ∧ g0 ∊ fseq u ∧ cdm g0 = cdm x0 ∧ cdm o0 = cdm x0 $ by etel_fseq_c [a1, #2, #6]
a5: $ G ⇒ x0 ∊ fseq u $ by and_elim_l [a4]
a6: $ G ⇒ esat u E b w ⊆ fseq u $ by esat_fseq
a7: $ G ⇒ q ∊ fseq u $ by subset_elim [a6, #3]
a8: $ G ⇒ q0 ∊ fseq u $ by subset_elim [a6, #4]
a9: $ G ⇒ scat x q ∈ fseq u $ by scat_fseq [a3, a7]
a10: $ G ⇒ scat x0 q0 ∈ fseq u $ by scat_fseq [a5, a8]
a11: $ G ⇒ cdm (scat x q) = nadd (cdm x) (cdm q) $ by scat_len [a3, a7]
a12: $ G ⇒ cdm (scat x0 q0) = nadd (cdm x0) (cdm q0) $ by scat_len [a5, a8]
a13: $ G ⇒ cdm x = cdm x0 $ by etel_len [#2, #5, #6]
a14: $ G ⇒ cdm q = cdm q0 $ by esat_len_c [a1, #1, #3, #4]
