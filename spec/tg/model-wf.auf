t1: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) $ by ax
t2: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ ¬ iprop D J w $ by and_elim_l [t1]
t3: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ r = nest (scat x q) (scons ∅ ∅) $ by and_elim_r [t1]
t4: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ nest m e = r $ by weaken [k40]
t5: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ nest m e = nest (scat x q) (scons ∅ ∅) $ by eq_trans [t4, t3]
t6: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ m ∈ fseq u $ by weaken [k36]
t7: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ scat x q ∈ fseq u $ by weaken [k37]
t8: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ cdm m = cdm (scat x q) $ by weaken [k34]
t9: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ isset e $ by isset_var
t10: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ isset (scons ∅ ∅) $ by weaken [k42]
t11: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ m = scat x q ∧ e = scons ∅ ∅ $ by nest_inj_c [t6, t7, t8, t5, t9, t10]
t12: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ e = scons ∅ ∅ $ by and_elim_r [t11]
t13: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ ¬ iprop D J w ∧ e = scons ∅ ∅ $ by and_intro [t2, t12]
t14: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) , ¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅) ⇒ (iprop D J w ∧ e = ∅) ∨ (¬ iprop D J w ∧ e = scons ∅ ∅) $ by or_intro_r [t13]
u1: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) ⇒ (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) $ by ax
u2: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) ⇒ (iprop D J w ∧ e = ∅) ∨ (¬ iprop D J w ∧ e = scons ∅ ∅) $ by or_elim [u1, s14, t14]
u3: $ G , r = nest m e , r ∊ itriv u E D J w ⇒ r ∊ itriv u E D J w $ by ax
