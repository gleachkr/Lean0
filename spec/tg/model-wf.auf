lemma b14_cond_s {i m q e g: set} (G: hyps) (D X Y: class) (t3 o x y: set): $ G ⇒ b6_cond D t3 X Y $ > $ G ⇒ x = X $ > $ G ⇒ y = Y $ > $ G ⇒ o = D $ > $ G ⇒ ∀ i ∀ m ∀ q (ra_nidx o i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q))) $
----
a1: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ ∀ i ∀ m ∀ q (ra_nidx D i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv X (fv nvf i)) q → ∃ g (g ∊ apn (fv Y (fv nvf i)) q))) $ by weaken [#1]
a2: $ … ⇒ ∀ m ∀ q (ra_nidx D i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv X (fv nvf i)) q → ∃ g (g ∊ apn (fv Y (fv nvf i)) q))) $ by all_elim [a1]
a3: $ … ⇒ ∀ q (ra_nidx D i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv X (fv nvf i)) q → ∃ g (g ∊ apn (fv Y (fv nvf i)) q))) $ by all_elim [a2]
a4: $ … ⇒ ra_nidx D i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv X (fv nvf i)) q → ∃ g (g ∊ apn (fv Y (fv nvf i)) q)) $ by all_elim [a3]
a5: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ o = D $ by weaken [#4]
a6: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ i = i $ by eq_refl
a7: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ m = m $ by eq_refl
a8: $ … ⇒ ra_nidx o i m = ra_nidx D i m $ by ra_nidx_eq [a5, a6, a7]
a9: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ ra_nidx o i m ∈ lrel $ by ax
a10: $ … ⇒ ra_nidx D i m ∈ lrel $ by wcel_eq_l [a8, a9]
a11: $ … ⇒ cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv X (fv nvf i)) q → ∃ g (g ∊ apn (fv Y (fv nvf i)) q)) $ by imp_elim [a4, a10]
a12: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ cdm q = nadd (fv nvf m) (fv nvf t3) $ by ax
a13: $ … ⇒ q ∊ fseq b6_V → ∀ e (e ∊ apn (fv X (fv nvf i)) q → ∃ g (g ∊ apn (fv Y (fv nvf i)) q)) $ by imp_elim [a11, a12]
a14: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ q ∊ fseq b6_V $ by ax
a15: $ … ⇒ ∀ e (e ∊ apn (fv X (fv nvf i)) q → ∃ g (g ∊ apn (fv Y (fv nvf i)) q)) $ by imp_elim [a13, a14]
a16: $ … ⇒ e ∊ apn (fv X (fv nvf i)) q → ∃ g (g ∊ apn (fv Y (fv nvf i)) q) $ by all_elim [a15]
a17: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ x = X $ by weaken [#2]
a18: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ fv nvf i = fv nvf i $ by eq_refl
a19: $ … ⇒ fv x (fv nvf i) = fv X (fv nvf i) $ by fv_eq [a17, a18]
a20: $ G , ra_nidx o i m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf t3) , q ∊ fseq b6_V , e ∊ apn (fv x (fv nvf i)) q ⇒ q = q $ by eq_refl
