wi6: $ G , z = scons x y ⇒ ∀ e ∀ f (ra_sinst t1 j t3 t4 e f ∈ lrel → j ∊ trees ω → nadd (fv nvf j) (cdm z) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) → etel u (dnf u M) f w (scat p s) = etel u (dnf u M) e w (scat p (scat z s))) $ by all_intro [wi5]
wi7: $ G , z = scons x y ⇒ ∀ j ∀ e ∀ f (ra_sinst t1 j t3 t4 e f ∈ lrel → j ∊ trees ω → nadd (fv nvf j) (cdm z) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) → etel u (dnf u M) f w (scat p s) = etel u (dnf u M) e w (scat p (scat z s))) $ by all_intro [wi6]
wi8: $ G ⇒ isset (scons x y) $ by scons_set [wi0]
wi9: $ G ⇒ scons x y ∈ b6s_sip u M t1 t3 t4 w p s $ by wcel_cab_intro [wi8, wi7]

lemma b6_sinst_etel (G: hyps) {i b: set} (M: class) (u w t1 t2 t3 t4 t5 t6 p s v: set): $ G ⇒ ra_sinst t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ G ⇒ uadm u $ > $ G ⇒ t1 ∊ trees ω $ > $ G ⇒ t2 ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = fv nvf t4 $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ nadd (fv nvf t2) (cdm v) = fv nvf t3 $ > $ G ⇒ ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) $ > $ G ⇒ etel u (dnf u M) t6 w (scat p s) = etel u (dnf u M) t5 w (scat p (scat v s)) $
----
m1: $ G ⇒ ∅ ∈ b6s_sip u M t1 t3 t4 w p s $ by b6s_si_base [#8]
q3: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ t1 ∊ trees ω $ by weaken [#3]
q5: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ w ∊ lvals $ by weaken [#5]
q6: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ p ∊ fseq u $ by weaken [#6]
q7: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ cdm p = fv nvf t4 $ by weaken [#7]
q8: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ s ∊ fseq u $ by weaken [#8]
q9: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ x ∊ u $ by ax
q10: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ y ∊ fseq u $ by ax
q11a: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ y ∊ b6s_sip u M t1 t3 t4 w p s $ by ax
q11: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ y ∈ b6s_sip u M t1 t3 t4 w p s $ by welc_wcel [q11a]
q12: $ G , x ∊ u , y ∊ fseq u , y ∊ b6s_sip u M t1 t3 t4 w p s ⇒ scons x y ∈ b6s_sip u M t1 t3 t4 w p s $ by b6s_si_step [q3, q5, q6, q7, q8, q9, q10, q11]
q13: $ G , x ∊ u , y ∊ fseq u ⇒ y ∊ b6s_sip u M t1 t3 t4 w p s → scons x y ∈ b6s_sip u M t1 t3 t4 w p s $ by imp_intro [q12]
q14: $ G , x ∊ u ⇒ y ∊ fseq u → y ∊ b6s_sip u M t1 t3 t4 w p s → scons x y ∈ b6s_sip u M t1 t3 t4 w p s $ by imp_intro [q13]
q15: $ G ⇒ x ∊ u → y ∊ fseq u → y ∊ b6s_sip u M t1 t3 t4 w p s → scons x y ∈ b6s_sip u M t1 t3 t4 w p s $ by imp_intro [q14]
q16: $ G ⇒ ∀ y (x ∊ u → y ∊ fseq u → y ∊ b6s_sip u M t1 t3 t4 w p s → scons x y ∈ b6s_sip u M t1 t3 t4 w p s) $ by all_intro [q15]
q17: $ G ⇒ ∀ x ∀ y (x ∊ u → y ∊ fseq u → y ∊ b6s_sip u M t1 t3 t4 w p s → scons x y ∈ b6s_sip u M t1 t3 t4 w p s) $ by all_intro [q16]
m3: $ G ⇒ fseq u ⊆ b6s_sip u M t1 t3 t4 w p s $ by fseq_ind [m1, q17]
m4: $ G ⇒ v ∊ b6s_sip u M t1 t3 t4 w p s $ by subset_elim [m3, #9]
m5: $ G ⇒ ∀ x7 ∀ x8 ∀ x9 (ra_sinst t1 x7 t3 t4 x8 x9 ∈ lrel → x7 ∊ trees ω → nadd (fv nvf x7) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf x7) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → etel u (dnf u M) x9 w (scat p s) = etel u (dnf u M) x8 w (scat p (scat v s))) $ by cab_elim [m4]
m6: $ G ⇒ ∀ x8 ∀ x9 (ra_sinst t1 t2 t3 t4 x8 x9 ∈ lrel → t2 ∊ trees ω → nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → etel u (dnf u M) x9 w (scat p s) = etel u (dnf u M) x8 w (scat p (scat v s))) $ by all_elim [m5]
m7: $ G ⇒ ∀ x9 (ra_sinst t1 t2 t3 t4 t5 x9 ∈ lrel → t2 ∊ trees ω → nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → etel u (dnf u M) x9 w (scat p s) = etel u (dnf u M) t5 w (scat p (scat v s))) $ by all_elim [m6]
m8: $ G ⇒ ra_sinst t1 t2 t3 t4 t5 t6 ∈ lrel → t2 ∊ trees ω → nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → etel u (dnf u M) t6 w (scat p s) = etel u (dnf u M) t5 w (scat p (scat v s)) $ by all_elim [m7]
m9: $ G ⇒ t2 ∊ trees ω → nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → etel u (dnf u M) t6 w (scat p s) = etel u (dnf u M) t5 w (scat p (scat v s)) $ by imp_elim [m8, #1]
m10: $ G ⇒ nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → etel u (dnf u M) t6 w (scat p s) = etel u (dnf u M) t5 w (scat p (scat v s)) $ by imp_elim [m9, #4]
m11: $ G ⇒ ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → etel u (dnf u M) t6 w (scat p s) = etel u (dnf u M) t5 w (scat p (scat v s)) $ by imp_elim [m10, #10]
m12: $ G ⇒ etel u (dnf u M) t6 w (scat p s) = etel u (dnf u M) t5 w (scat p (scat v s)) $ by imp_elim [m11, #11]

lemma b6_scat_agree (G: hyps) {i: set} (A: class) (q s t k: set): $ G ⇒ q ∊ fseq A $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ k ∊ ω $ > $ G ⇒ ∀ i (i ∊ k → fv s i = fv t i) $ > $ G ⇒ ∀ i (i ∊ nadd (cdm q) k → fv (scat q s) i = fv (scat q t) i) $
----
q1: $ G , i ∊ nadd (cdm q) k ⇒ q ∊ fseq A $ by weaken [#1]
q2: $ G , i ∊ nadd (cdm q) k ⇒ cdm q ∈ ω $ by fseq_len [q1]
q3: $ G , i ∊ nadd (cdm q) k ⇒ isset q $ by isset_var
q4: $ G , i ∊ nadd (cdm q) k ⇒ isset (cdm q) $ by cdm_set [q3]
q5: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ c = cdm q $ by ax
q6: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ cdm q = c $ by eq_sym [q5]
q7: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ cdm q ∈ ω $ by weaken [q2]
q8: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ c ∈ ω $ by wcel_eq_l [q6, q7]
q9: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ c ∊ ω $ by wcel_welc [q8]
q10: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ k ∊ ω $ by weaken [#4]
q11: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ cdm q ∈ ω $ by weaken [q2]
q12: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ k ∈ ω $ by welc_wcel [q10]
q13: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ nadd (cdm q) k ∈ ω $ by nadd_omega_c [q11, q12]
q14: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ i ∊ nadd (cdm q) k $ by ax
q15: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ i ∈ nadd (cdm q) k $ by welc_wcel [q14]
q16: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ i ∈ ω $ by omega_elem_omega_c [q15, q13]
q17: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ i ∊ ω $ by wcel_welc [q16]
q18: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ i ∊ c ∨ c ⊆ i $ by nlt_or_le [q17, q9]
q19: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ q ∊ fseq A $ by weaken [#1]
q20: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ s ∊ fseq A $ by weaken [#2]
q21: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ t ∊ fseq A $ by weaken [#3]
q22: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ c = cdm q $ by ax
q23: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ i ∊ c $ by ax
q24: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ i ∈ c $ by welc_wcel [q23]
q25: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ i ∈ cdm q $ by wcel_eq_r [q22, q24]
q26: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ q ∊ fseq A $ by weaken [q19]
q27: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ s ∊ fseq A $ by weaken [q20]
q28: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ fv (scat q s) i = fv q i $ by scat_fv_l_c [q26, q27, q25]
q29: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ q ∊ fseq A $ by weaken [q19]
q30: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ t ∊ fseq A $ by weaken [q21]
q31: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ fv (scat q t) i = fv q i $ by scat_fv_l_c [q29, q30, q25]
q32: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ fv q i = fv (scat q t) i $ by eq_sym [q31]
q33: $ G , i ∊ nadd (cdm q) k , c = cdm q , i ∊ c ⇒ fv (scat q s) i = fv (scat q t) i $ by eq_trans [q28, q32]
q34: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i ⇒ c ∊ ω $ by weaken [q9]
q35: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i ⇒ i ∊ ω $ by weaken [q17]
q36: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i ⇒ c ⊆ i $ by ax
q37: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i ⇒ ∃ j (j ∊ ω ∧ nadd c j = i) $ by nle_ex [q34, q35, q36]
q38: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ j ∊ ω ∧ nadd c j = i $ by ax
q39: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ j ∊ ω $ by and_elim_l [q38]
q40: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd c j = i $ by and_elim_r [q38]
q41: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ c = cdm q $ by ax
q42: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ j ∈ ω $ by welc_wcel [q39]
q43: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ cdm q = c $ by eq_sym [q41]
q44: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ j = j $ by eq_refl
q45: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd (cdm q) j = nadd c j $ by nadd_eq [q43, q44]
q46: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd (cdm q) j = i $ by eq_trans [q45, q40]
q47: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ i = nadd (cdm q) j $ by eq_sym [q46]
q48: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ q ∊ fseq A $ by weaken [q19]
q49: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ s ∊ fseq A $ by weaken [q20]
q50: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv (scat q s) (nadd (cdm q) j) = fv s j $ by scat_fv_r_c [q48, q49, q42]
q51: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ q ∊ fseq A $ by weaken [q19]
q52: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ t ∊ fseq A $ by weaken [q21]
q53: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv (scat q t) (nadd (cdm q) j) = fv t j $ by scat_fv_r_c [q51, q52, q42]
q54: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ i ∊ nadd (cdm q) k $ by ax
q55: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ i = nadd c j $ by eq_sym [q40]
q56: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ i ∈ nadd (cdm q) k $ by welc_wcel [q54]
q57: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd c j ∈ nadd (cdm q) k $ by wcel_eq_l [q55, q56]
q58: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ cdm q = c $ by eq_sym [q41]
q59: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ k = k $ by eq_refl
q60: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd (cdm q) k = nadd c k $ by nadd_eq [q58, q59]
q61: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd c j ∈ nadd c k $ by wcel_eq_r [q60, q57]
q62: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ k ∊ ω $ by weaken [#4]
q63: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ c ∊ ω $ by weaken [q9]
q64: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd c j = nadd j c $ by nadd_comm [q63, q39]
q65: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd c k = nadd k c $ by nadd_comm [q63, q62]
q66: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd j c ∈ nadd c k $ by wcel_eq_l [q64, q61]
q67: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ nadd j c ∈ nadd k c $ by wcel_eq_r [q65, q66]
q68: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ j ∊ k $ by nadd_lt_cancel [q39, q62, q63, q67]
q69: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ ∀ i (i ∊ k → fv s i = fv t i) $ by weaken [#5]
q70: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ j ∊ k → fv s j = fv t j $ by all_elim [q69]
q71: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv s j = fv t j $ by imp_elim [q70, q68]
q72: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv t j = fv (scat q t) (nadd (cdm q) j) $ by eq_sym [q53]
q73: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv s j = fv (scat q t) (nadd (cdm q) j) $ by eq_trans [q71, q72]
q74: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv (scat q s) (nadd (cdm q) j) = fv (scat q t) (nadd (cdm q) j) $ by eq_trans [q50, q73]
q75: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ scat q s = scat q s $ by eq_refl
q76: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv (scat q s) i = fv (scat q s) (nadd (cdm q) j) $ by fv_eq [q75, q47]
q77: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ scat q t = scat q t $ by eq_refl
q78: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv (scat q t) (nadd (cdm q) j) = fv (scat q t) i $ by fv_eq [q77, q46]
q79: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv (scat q s) i = fv (scat q t) (nadd (cdm q) j) $ by eq_trans [q76, q74]
q80: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , j ∊ ω ∧ nadd c j = i ⇒ fv (scat q s) i = fv (scat q t) i $ by eq_trans [q79, q78]
q81: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , ∃ j (j ∊ ω ∧ nadd c j = i) ⇒ ∃ j (j ∊ ω ∧ nadd c j = i) $ by ax
q82: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i , ∃ j (j ∊ ω ∧ nadd c j = i) ⇒ fv (scat q s) i = fv (scat q t) i $ by ex_elim [q81, q80]
q83: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i ⇒ ∃ j (j ∊ ω ∧ nadd c j = i) → fv (scat q s) i = fv (scat q t) i $ by imp_intro [q82]
q84: $ G , i ∊ nadd (cdm q) k , c = cdm q , c ⊆ i ⇒ fv (scat q s) i = fv (scat q t) i $ by imp_elim [q83, q37]
q85: $ G , i ∊ nadd (cdm q) k , c = cdm q ⇒ fv (scat q s) i = fv (scat q t) i $ by or_elim [q18, q33, q84]
q86: $ G , i ∊ nadd (cdm q) k ⇒ fv (scat q s) i = fv (scat q t) i $ by isset_elim [q4, q85]
q87: $ G ⇒ i ∊ nadd (cdm q) k → fv (scat q s) i = fv (scat q t) i $ by imp_intro [q86]
q88: $ G ⇒ ∀ i (i ∊ nadd (cdm q) k → fv (scat q s) i = fv (scat q t) i) $ by all_intro [q87]

lemma b6_esat_cons_eq (G: hyps) {q: set} (E E2 A T: class) (u w: set): $ G ⇒ A ∈ trees ω $ > $ G ⇒ T ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ esat u E T w = esat u E2 T w $ > $ G ⇒ ∀ q (q ∊ esat u E T w → da (fv E A) w q = da (fv E2 A) w q) $ > $ G ⇒ esat u E ⟨ kc_cons , scons A (scons T ∅) ⟩ w = esat u E2 ⟨ kc_cons , scons A (scons T ∅) ⟩ w $
----
q1: $ G ⇒ esat u E ⟨ kc_cons , scons A (scons T ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by esat_cons [#1, #2, #3]
q2: $ G ⇒ esat u E2 ⟨ kc_cons , scons A (scons T ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} $ by esat_cons [#1, #2, #3]
q3: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by ax
q4: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} ⇒ z ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) $ by cab_elim [q3]
q5: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} ⇒ z ∊ fseq u $ by and_elim_l [q4]
q6: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) $ by and_elim_r [q4]
q7: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q $ by ax
q8: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ q ∊ esat u E T w $ by and_elim_l [q7]
q9: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ x ∊ da (fv E A) w q ∧ z = scons x q $ by and_elim_r [q7]
q10: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ x ∊ da (fv E A) w q $ by and_elim_l [q9]
q11: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ z = scons x q $ by and_elim_r [q9]
q12: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ esat u E T w = esat u E2 T w $ by weaken [#4]
q13: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ q ∊ esat u E2 T w $ by welc_eq [q12, q8]
q14: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ ∀ q (q ∊ esat u E T w → da (fv E A) w q = da (fv E2 A) w q) $ by weaken [#5]
q15: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ q ∊ esat u E T w → da (fv E A) w q = da (fv E2 A) w q $ by all_elim [q14]
q16: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ da (fv E A) w q = da (fv E2 A) w q $ by imp_elim [q15, q8]
q17: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ x ∊ da (fv E2 A) w q $ by welc_eq [q16, q10]
q18: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ x ∊ da (fv E2 A) w q ∧ z = scons x q $ by and_intro [q17, q11]
q19: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q $ by and_intro [q13, q18]
q20: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) $ by ex_intro [q19]
q21: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) $ by ex_intro [q20]
q22: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ z ∊ fseq u $ by weaken [q5]
q23: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ z ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) $ by and_intro [q22, q21]
q24: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} $ by cab_intro [q23]
q25: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) ⇒ ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) $ by ax
q26: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} $ by ex_elim [q25, q24]
q27: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) ⇒ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) $ by ax
q28: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} , ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} $ by ex_elim [q27, q26]
q29: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) → z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} $ by imp_intro [q28]
q30: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} $ by imp_elim [q29, q6]
