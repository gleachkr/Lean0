e4w: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ fv nvf t3 = fv nvf t3 $ by eq_refl
e4a: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ nadd (fv nvf T7) (fv nvf t3) = nadd (fv nvf x) (fv nvf t3) $ by nadd_eq [e4z, e4w]
e4b: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ ∀ i (i ∊ nadd (fv nvf T7) (fv nvf t3) → fv R i = fv R2 i) $ by weaken [#7]
e4: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ ∀ i (i ∊ nadd (fv nvf x) (fv nvf t3) → fv y i = fv z i) $ by fv_agree_eq [e4a, e0f, e0h, e4b]
e5a: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ b7_hw D X0 R R2 T7 t3 $ by weaken [#8]
e5: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ b7_hw o X0 y z x t3 $ by b7_hw_eqc [e0d, e0f, e0h, e0x, r3, e5a]
e6x: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ T7 ∈ trees ω $ by weaken [#2]
e6y: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ x ∈ trees ω $ by wcel_eq_l [e0x, e6x]
e6a: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ x ∊ trees ω $ by wcel_welc [e6y]
e6b: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ t8 ∊ trees ω $ by weaken [#3]
e6c: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ uadm u $ by weaken [#9]
e6: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ etel u (dnf u M) t8 v y ⊆ etel u (dnf u M) t8 v z $ by b7_cwf_mono [e1, e6a, e6b, e2, e3, e3e, e4, e5, e6c]
e7a: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ etel u (dnf u M) t8 W R = etel u (dnf u M) t8 v y $ by etel_eq [r8, e0e, e0f]
e7b: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ etel u (dnf u M) t8 W R2 = etel u (dnf u M) t8 v z $ by etel_eq [r8, e0e, e0h]
e7c: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ etel u (dnf u M) t8 v y = etel u (dnf u M) t8 W R $ by eq_sym [e7a]
e7d: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ etel u (dnf u M) t8 v z = etel u (dnf u M) t8 W R2 $ by eq_sym [e7b]
e7e: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ etel u (dnf u M) t8 W R ⊆ etel u (dnf u M) t8 v z $ by subset_eq_l [e7c, e6]
e7: $ G , x = T7 , o = D , v = W , y = R , z = R2 ⇒ etel u (dnf u M) t8 W R ⊆ etel u (dnf u M) t8 W R2 $ by subset_eq_r [e7d, e7e]
e8: $ G , x = T7 , o = D , v = W , y = R ⇒ etel u (dnf u M) t8 W R ⊆ etel u (dnf u M) t8 W R2 $ by isset_elim [k4, e7]
e9: $ G , x = T7 , o = D , v = W ⇒ etel u (dnf u M) t8 W R ⊆ etel u (dnf u M) t8 W R2 $ by isset_elim [k3, e8]
e10: $ G , x = T7 , o = D ⇒ etel u (dnf u M) t8 W R ⊆ etel u (dnf u M) t8 W R2 $ by isset_elim [k2, e9]
e11: $ G , x = T7 ⇒ etel u (dnf u M) t8 W R ⊆ etel u (dnf u M) t8 W R2 $ by isset_elim [k1, e10]
e12: $ G ⇒ etel u (dnf u M) t8 W R ⊆ etel u (dnf u M) t8 W R2 $ by isset_elim [k0, e11]

lemma b7_ixs_fv_in (G: hyps) (D W Z Y: class) (u j: set): $ G ⇒ universe u $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Y ∈ fv (ixs D W Z) j $ > $ G ⇒ j ∊ intys D ∧ Y ∈ ient D W Z j $
----
a0: $ G ⇒ Y ∈ ⋃ (ap (ixs D W Z) j) $ by weaken [#4]
b1: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v ⇒ v ∊ ap (ixs D W Z) j $ by ax
b2: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v ⇒ ⟨ j , v ⟩ ∈ ixs D W Z $ by cab_elim [b1]
c1: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z ⇒ c ∊ ixs D W Z $ by ax
c2: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z ⇒ ∃ k (k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩) $ by cab_elim [c1]
d1: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ $ by ax
d2: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ k ∊ intys D $ by and_elim_l [d1]
d3: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ c = ⟨ k , ient D W Z k ⟩ $ by and_elim_r [d1]
d4a: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ c = ⟨ j , v ⟩ $ by ax
d4b: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ ⟨ j , v ⟩ = c $ by eq_sym [d4a]
d4: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ ⟨ j , v ⟩ = ⟨ k , ient D W Z k ⟩ $ by eq_trans [d4b, d3]
d5a: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ universe u $ by weaken [#1]
d5b: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ Z ∈ u $ by weaken [#2]
d5c: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by weaken [#3]
d5d: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ ient D W Z k ∈ u $ by ient_universe [d5a, d5b, d5c]
d5: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ isset (ient D W Z k) $ by wcel_isset [d5d]
d6a: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ isset j $ by isset_var
d6b: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ isset v $ by isset_var
d6c: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ isset k $ by isset_var
d6: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ j = k ∧ v = ient D W Z k $ by opair_inj_c [d4, d6a, d6b, d6c, d5]
d7: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ j = k $ by and_elim_l [d6]
d8: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ v = ient D W Z k $ by and_elim_r [d6]
d9a: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ k = j $ by eq_sym [d7]
d9: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ j ∊ intys D $ by welc_eq_set [d9a, d2]
d10a: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ Y ∈ v $ by ax
d10b: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ Y ∈ ient D W Z k $ by wcel_eq_r [d8, d10a]
d10c: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ D = D $ by eq_refl
d10d: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ W = W $ by eq_refl
d10e: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ Z = Z $ by eq_refl
d10f: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ ient D W Z k = ient D W Z j $ by ient_eq [d10c, d10d, d10e, d9a]
d10: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ Y ∈ ient D W Z j $ by wcel_eq_r [d10f, d10b]
d11: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z , k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩ ⇒ j ∊ intys D ∧ Y ∈ ient D W Z j $ by and_intro [d9, d10]
d12: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v , c = ⟨ j , v ⟩ , c ∊ ixs D W Z ⇒ j ∊ intys D ∧ Y ∈ ient D W Z j $ by ex_elim [c2, d11]
d13: $ G , v ∊ ap (ixs D W Z) j , Y ∈ v ⇒ j ∊ intys D ∧ Y ∈ ient D W Z j $ by wcel_elim [b2, d12]
d14: $ G ⇒ j ∊ intys D ∧ Y ∈ ient D W Z j $ by wcel_cuni_elim [a0, d13]

lemma b7_ixs_fv_out (G: hyps) (D W Z: class) (u j o: set): $ G ⇒ universe u $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ j ∊ intys D $ > $ G ⇒ o ∈ ient D W Z j $ > $ G ⇒ o ∊ fv (ixs D W Z) j $
----
a1: $ G ⇒ ient D W Z j ∈ u $ by ient_universe [#1, #2, #3]
a2: $ G ⇒ isset (ient D W Z j) $ by wcel_isset [a1]
b1: $ G , v = ient D W Z j ⇒ v = ient D W Z j $ by ax
b2: $ G , v = ient D W Z j ⇒ isset ⟨ j , v ⟩ $ by opair_isset
c1: $ G , v = ient D W Z j , c = ⟨ j , v ⟩ ⇒ c = ⟨ j , v ⟩ $ by ax
c2a: $ G , v = ient D W Z j , c = ⟨ j , v ⟩ ⇒ j = j $ by eq_refl
c2b: $ G , v = ient D W Z j , c = ⟨ j , v ⟩ ⇒ v = ient D W Z j $ by ax
c2: $ G , v = ient D W Z j , c = ⟨ j , v ⟩ ⇒ ⟨ j , v ⟩ = ⟨ j , ient D W Z j ⟩ $ by opair_eq [c2a, c2b]
c3: $ G , v = ient D W Z j , c = ⟨ j , v ⟩ ⇒ c = ⟨ j , ient D W Z j ⟩ $ by eq_trans [c1, c2]
c4: $ G , v = ient D W Z j , c = ⟨ j , v ⟩ ⇒ j ∊ intys D $ by weaken [#4]
c5: $ G , v = ient D W Z j , c = ⟨ j , v ⟩ ⇒ j ∊ intys D ∧ c = ⟨ j , ient D W Z j ⟩ $ by and_intro [c4, c3]
c6: $ G , v = ient D W Z j , c = ⟨ j , v ⟩ ⇒ ∃ k (k ∊ intys D ∧ c = ⟨ k , ient D W Z k ⟩) $ by ex_intro [c5]
b3: $ G , v = ient D W Z j ⇒ ⟨ j , v ⟩ ∈ ixs D W Z $ by wcel_cab_intro [b2, c6]
b4: $ G , v = ient D W Z j ⇒ v ∊ ap (ixs D W Z) j $ by cab_intro [b3]
b5a: $ G , v = ient D W Z j ⇒ o ∈ ient D W Z j $ by weaken [#5]
b5b: $ G , v = ient D W Z j ⇒ ient D W Z j = v $ by eq_sym [b1]
b5c: $ G , v = ient D W Z j ⇒ o ∈ v $ by wcel_eq_r [b5b, b5a]
b5: $ G , v = ient D W Z j ⇒ o ∊ v $ by wcel_welc [b5c]
b6: $ G , v = ient D W Z j ⇒ o ∊ ⋃ (ap (ixs D W Z) j) $ by cuni_intro [b5, b4]
b7: $ G , v = ient D W Z j ⇒ o ∊ fv (ixs D W Z) j $ by weaken [b6]
b8: $ G ⇒ o ∊ fv (ixs D W Z) j $ by isset_elim [a2, b7]

lemma b7_iprt_eqp (G: hyps) (D P T: class) (p t: set): $ G ⇒ iprt D P T $ > $ G ⇒ iprt D p t $ > $ G ⇒ P = p $
----
a0: $ G ⇒ ∃ b (ra_ind_data D b P T ∈ lrel) $ by weaken [#1]
a1: $ G , ra_ind_data D b P T ∈ lrel ⇒ ra_ind_data D b P T ∈ lrel $ by ax
a2a: $ G , ra_ind_data D b P T ∈ lrel ⇒ kr_ind_data ∈ ω $ by kr_ind_data_omega
a2b: $ G , ra_ind_data D b P T ∈ lrel ⇒ isset kr_ind_data $ by wcel_isset [a2a]
a2: $ G , ra_ind_data D b P T ∈ lrel ⇒ D ∈ trees ω ∧ b ∈ trees ω ∧ P ∈ trees ω ∧ T ∈ trees ω $ by lrel_args4_c [a1, a2b]
a3a: $ G , ra_ind_data D b P T ∈ lrel ⇒ b ∈ trees ω ∧ P ∈ trees ω ∧ T ∈ trees ω $ by and_elim_r [a2]
a3b: $ G , ra_ind_data D b P T ∈ lrel ⇒ P ∈ trees ω ∧ T ∈ trees ω $ by and_elim_r [a3a]
a3c: $ G , ra_ind_data D b P T ∈ lrel ⇒ P ∈ trees ω $ by and_elim_l [a3b]
a3d: $ G , ra_ind_data D b P T ∈ lrel ⇒ T ∈ trees ω $ by and_elim_r [a3b]
a3: $ G , ra_ind_data D b P T ∈ lrel ⇒ isset P $ by wcel_isset [a3c]
a4: $ G , ra_ind_data D b P T ∈ lrel ⇒ isset T $ by wcel_isset [a3d]
c1: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ e = P $ by ax
c2: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ h = T $ by ax
c3a: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ D = D $ by eq_refl
c3b: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ P = e $ by eq_sym [c1]
c3c: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ T = h $ by eq_sym [c2]
c3d: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ iprt D P T $ by weaken [#1]
c3: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ iprt D e h $ by iprt_eq [c3a, c3b, c3c, c3d]
c4a: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ iprt D p t $ by weaken [#2]
c4: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ e = p ∧ h = t $ by iprt_det [c3, c4a]
c5: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ e = p $ by and_elim_l [c4]
c6: $ G , ra_ind_data D b P T ∈ lrel , e = P , h = T ⇒ P = p $ by eq_trans [c3b, c5]
c7: $ G , ra_ind_data D b P T ∈ lrel , e = P ⇒ P = p $ by isset_elim [a4, c6]
c8: $ G , ra_ind_data D b P T ∈ lrel ⇒ P = p $ by isset_elim [a3, c7]
c9: $ G ⇒ P = p $ by ex_elim [a0, c8]

lemma b7_path_args {j c k i x7 x8 x9: set} (G: hyps j c k i) (J M D W Z: class) (u p t n m l x q e y v b d f g h a: set): $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p m ∈ lrel $ > $ G ⇒ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ > $ G ⇒ iprt D q e $ > $ G ⇒ y ∊ esat u (dnf u M) q W $ > $ G ⇒ ictk D v b d $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ h , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d W (scat y (ixs D W Z)) $ > $ G ⇒ uadm u $ > $ G ⇒ D ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ ∃ x7 ∃ x8 ∃ x9 (fv nvf x7 = v ∧ ra_nidx D x7 x8 ∈ lrel ∧ x9 ∊ fseq b7_V ∧ cdm x9 = fv nvf x8 ∧ a = scat x9 y ∧ cdm y = fv nvf m) $
----
e3: $ G ⇒ p = q ∧ t = e $ by iprt_det [#1, #4]
e3a: $ G ⇒ p = q $ by and_elim_l [e3]
e4a: $ G ⇒ m = m $ by eq_refl
e4: $ G ⇒ ra_clen p m = ra_clen q m $ by ra_clen_eq [e3a, e4a]
e5: $ G ⇒ ra_clen q m ∈ lrel $ by wcel_eq_l [e4, #2]
e7: $ G ⇒ q ∈ fv tsub D ∧ e ∈ fv tsub D $ by iprt_tsub [#9, #4]
e8: $ G ⇒ q ∈ fv tsub D $ by and_elim_l [e7]
e9: $ G ⇒ fv tsub D ⊆ trees ω $ by tsub_trees
e10: $ G ⇒ q ∈ trees ω $ by wcel_subset [e9, e8]
e11: $ G ⇒ q ∊ trees ω $ by wcel_welc [e10]
e13: $ G ⇒ cdm y = fv nvf m $ by esat_clen_c [e5, e11, #5]
e14a: $ G ⇒ ∀ c ∀ k (ictk D v c k → ∃ i (fv nvf i = v ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ by all_elim [#3]
e14b: $ G ⇒ ∀ k (ictk D v b k → ∃ i (fv nvf i = v ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ by all_elim [e14a]
e14: $ G ⇒ ictk D v b d → ∃ i (fv nvf i = v ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ d ∈ lrel3 J) $ by all_elim [e14b]
e16: $ G ⇒ ∃ i (fv nvf i = v ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ d ∈ lrel3 J) $ by imp_elim [e14, #6]
