q31: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ p = tP $ by and_elim_l [q30]
q32: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ t = tT $ by and_elim_r [q30]
q33: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ n = n $ by eq_refl
q34: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ f = f $ by eq_refl
