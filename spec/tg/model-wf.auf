def b10_S (U E D W: class) (.z .j .a .x: set): class = $ {z | ∃ j ∃ a ∃ x (z = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W)} $

lemma b10_S_elim (G: hyps) (U E D W: class) (tj ta tx: set): $ G ⇒ ⟨ tj , ⟨ ta , tx ⟩ ⟩ ∈ b10_S U E D W $ > $ G ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $
----
q1: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W ⇒ v ∊ b10_S U E D W $ by ax
q2: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W ⇒ ∃ j ∃ a ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) $ by cab_elim [q1]
q3: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by ax
q4: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ v = ⟨ j , ⟨ a , x ⟩ ⟩ $ by and_elim_l [q3]
q5: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by and_elim_r [q3]
q6: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W ⇒ v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ $ by ax
q7: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ $ by weaken [q6]
q8: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ⟨ tj , ⟨ ta , tx ⟩ ⟩ = v $ by eq_sym [q7]
q9: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ⟨ tj , ⟨ ta , tx ⟩ ⟩ = ⟨ j , ⟨ a , x ⟩ ⟩ $ by eq_trans [q8, q4]
q10: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ isset tj $ by isset_var
q11: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ isset ⟨ ta , tx ⟩ $ by opair_isset
q12: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ isset j $ by isset_var
q13: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ isset ⟨ a , x ⟩ $ by opair_isset
q14: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ tj = j ∧ ⟨ ta , tx ⟩ = ⟨ a , x ⟩ $ by opair_inj_c [q9, q10, q11, q12, q13]
q15: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ tj = j $ by and_elim_l [q14]
q16: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ⟨ ta , tx ⟩ = ⟨ a , x ⟩ $ by and_elim_r [q14]
q17: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ isset ta $ by isset_var
q18: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ isset tx $ by isset_var
q19: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ isset a $ by isset_var
q20: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ isset x $ by isset_var
q21: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ta = a ∧ tx = x $ by opair_inj_c [q16, q17, q18, q19, q20]
q22: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ta = a $ by and_elim_l [q21]
q23: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ a = ta $ by eq_sym [q22]
q24: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ scons ∅ ∅ = scons ∅ ∅ $ by eq_refl
q25: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ⟨ a , scons ∅ ∅ ⟩ = ⟨ ta , scons ∅ ∅ ⟩ $ by opair_eq [q23, q24]
q26: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ j = tj $ by eq_sym [q15]
q27: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ = ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ $ by opair_eq [q26, q25]
q28: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by wcel_eq_l [q27, q5]
q29: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) ⇒ ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) $ by ax
q30: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by ex_elim [q29, q28]
q31: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , ∃ a ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) ⇒ ∃ a ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) $ by ax
q32: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , ∃ a ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by ex_elim [q31, q30]
q33: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , ∃ j ∃ a ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) ⇒ ∃ j ∃ a ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) $ by ax
q34: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W , ∃ j ∃ a ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by ex_elim [q33, q32]
q35: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W ⇒ ∃ j ∃ a ∃ x (v = ⟨ j , ⟨ a , x ⟩ ⟩ ∧ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W) → ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by imp_intro [q34]
q36: $ G , v = ⟨ tj , ⟨ ta , tx ⟩ ⟩ , v ∊ b10_S U E D W ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by imp_elim [q35, q2]
q37: $ G ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc U E D W $ by wcel_elim [#1, q36]

lemma b10_cond_ok (G: hyps) {i: set} (M: class) (u w d tx tb tq te tnp tv tr tX tY: set): $ G ⇒ uadm u $ > $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ tx ⊆ ifam u (dnf u M) d w $ > $ G ⇒ tx ⊆ b10_S u (dnf u M) d w $ > $ G ⇒ ra_ind_data d tb tq te ∈ lrel $ > $ G ⇒ ra_clen tq tnp ∈ lrel $ > $ G ⇒ tv ∊ fseq u $ > $ G ⇒ cdm tv = intys d $ > $ G ⇒ ∀ i (i ∊ intys d → fv tv i = ityv u (dnf u M) d i w) $ > $ G ⇒ tr ∊ fseq u $ > $ G ⇒ tx ∊ u $ > $ G ⇒ tX = ixs d w tx $ > $ G ⇒ tY = scat tv tr $ > $ G ⇒ b6_cond d tnp tX tY $
----
q1: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V ⇒ ra_nidx d o m ∈ lrel $ by ax
q2: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel) $ by lrel_nidx_cases [q1]
q3: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V ⇒ cdm q = nadd (fv nvf m) (fv nvf tnp) $ by ax
q4: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V ⇒ q ∊ fseq b6_V $ by ax
