--| The step of `lrel_cwf_mono` at `cwf_pi`: the rest's paths at `v :: a`, `v :: b`.
lemma b7_cm_st {i v: set} (G: hyps) (J M C X0: class) (u w a b t1 t2 t3 t4 t5 d x0: set): $ G ⇒ ra_cwf t1 t2 t3 t4 t5 C ⟨ kc_s , scons d ∅ ⟩ x0 ∈ lrel3 J $ > $ G ⇒ isset C $ > $ G ⇒ x0 ∊ b7_cm u M w J t1 t2 t3 t4 t5 X0 $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ b ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) $ > $ G ⇒ b7_hw t1 X0 a b d t3 $ > $ G ⇒ ∀ v (v ∊ u → etel u (dnf u M) x0 w (scons v a) ⊆ etel u (dnf u M) x0 w (scons v b)) $
