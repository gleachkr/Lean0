o11: $ G , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) , r ∊ h ⇒ r ∊ clam o (dt u M d w q) (⋃ (dt u M b w (scons o q))) $ by b3_pts_elim [o10, o6]
o12: $ G , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ h ⊆ clam o (dt u M d w q) (⋃ (dt u M b w (scons o q))) $ by subset_intro [o11]
o13: $ G , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ h ∊ cpi o (dt u M d w q) (dt u M b w (scons o q)) $ by cpi_intro [o12, y27]
o14: $ G , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ h ∈ cpi o (dt u M d w q) (dt u M b w (scons o q)) $ by welc_wcel [o13]
o15: $ G , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ cpi o (dt u M d w q) (dt u M b w (scons o q)) = dt u M f w q $ by weaken [g8]
o16: $ G , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ h ∈ dt u M f w q $ by wcel_eq_r [o15, o14]
o17: $ G ⇒ h ∈ dt u M f w q ↔ (h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N)) $ by bi_intro [j23, o16]

lemma b3_pi_sort (G: hyps) (f i j: set): $ G ⇒ f ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ f = ⟨ kc_pi , scons i (scons j ∅) ⟩ $ > $ G ⇒ i ∊ ofsort lsig lopen ks_expr ∧ j ∊ ofsort lsig lopen ks_expr $
----
u1: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
u2: $ G ⇒ isset kc_pi $ by wcel_isset [u1]
x0a: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat $ by ax
x0b: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ f = ⟨ kc_bvar , scons g ∅ ⟩ $ by and_elim_l [x0a]
x0c: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ ⟨ kc_bvar , scons g ∅ ⟩ = f $ by eq_sym [x0b]
x0d: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ f = ⟨ kc_pi , scons i (scons j ∅) ⟩ $ by weaken [#2]
x0e: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ ⟨ kc_bvar , scons g ∅ ⟩ = ⟨ kc_pi , scons i (scons j ∅) ⟩ $ by eq_trans [x0c, x0d]
x0f: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
x0g: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ isset kc_bvar $ by wcel_isset [x0f]
x0h: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ isset kc_pi $ by weaken [u2]
x0i: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ kc_bvar = kc_pi $ by opair_inj_l_c [x0e, x0g, x0h]
x0j: $ G , f = ⟨ kc_bvar , scons g ∅ ⟩ ∧ g ∊ ofsort lsig lopen ks_nat ⇒ ¬ kc_bvar = kc_pi $ by kc_bvar_ne_pi
