--| The trees `x` whose derivable `lift n k x e` (for the fixed `n`) give `e`
--| the paths of `x` with the entries `q` inserted after the first `k`.
def b5_lp (U M W N Q S: class) (.x .k .e .p .r .o: set): class = $ {x | ∀ k ∀ e ∀ p ∀ r ∀ o (ra_lift N k x e ∈ lrel → p ∊ fseq U → cdm p = fv nvf k → r = scat p (scat Q S) → o = scat p S → etel U (dnf U M) e W r = etel U (dnf U M) x W o)} $

lemma b5_ih (G: hyps) (M: class) (u w n q s t h f: set) (P R O: class): $ G ⇒ t ∈ b5_lp u M w n q s $ > $ G ⇒ ra_lift n h t f ∈ lrel $ > $ G ⇒ P ∈ fseq u $ > $ G ⇒ cdm P = fv nvf h $ > $ G ⇒ isset R $ > $ G ⇒ R = scat P (scat q s) $ > $ G ⇒ isset O $ > $ G ⇒ O = scat P s $ > $ G ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w O $
----
i1: $ G ⇒ t ∊ b5_lp u M w n q s $ by wcel_welc [#1]
i2: $ G ⇒ ∀ k ∀ e ∀ p ∀ r ∀ o (ra_lift n k t e ∈ lrel → p ∊ fseq u → cdm p = fv nvf k → r = scat p (scat q s) → o = scat p s → etel u (dnf u M) e w r = etel u (dnf u M) t w o) $ by cab_elim [i1]
i3: $ G ⇒ ∀ e ∀ p ∀ r ∀ o (ra_lift n h t e ∈ lrel → p ∊ fseq u → cdm p = fv nvf h → r = scat p (scat q s) → o = scat p s → etel u (dnf u M) e w r = etel u (dnf u M) t w o) $ by all_elim [i2]
i4: $ G ⇒ ∀ p ∀ r ∀ o (ra_lift n h t f ∈ lrel → p ∊ fseq u → cdm p = fv nvf h → r = scat p (scat q s) → o = scat p s → etel u (dnf u M) f w r = etel u (dnf u M) t w o) $ by all_elim [i3]
j1: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ∀ p ∀ r ∀ o (ra_lift n h t f ∈ lrel → p ∊ fseq u → cdm p = fv nvf h → r = scat p (scat q s) → o = scat p s → etel u (dnf u M) f w r = etel u (dnf u M) t w o) $ by weaken [i4]
j2: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ∀ r ∀ o (ra_lift n h t f ∈ lrel → v ∊ fseq u → cdm v = fv nvf h → r = scat v (scat q s) → o = scat v s → etel u (dnf u M) f w r = etel u (dnf u M) t w o) $ by all_elim [j1]
j3: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ∀ o (ra_lift n h t f ∈ lrel → v ∊ fseq u → cdm v = fv nvf h → x0 = scat v (scat q s) → o = scat v s → etel u (dnf u M) f w x0 = etel u (dnf u M) t w o) $ by all_elim [j2]
j4: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ra_lift n h t f ∈ lrel → v ∊ fseq u → cdm v = fv nvf h → x0 = scat v (scat q s) → x1 = scat v s → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by all_elim [j3]
j5: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ra_lift n h t f ∈ lrel $ by weaken [#2]
j6: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ v ∊ fseq u → cdm v = fv nvf h → x0 = scat v (scat q s) → x1 = scat v s → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j4, j5]
j7: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ v ∊ fseq u $ by ax
j8: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm v = fv nvf h → x0 = scat v (scat q s) → x1 = scat v s → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j6, j7]
k1: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ v = P $ by ax
k2: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm v = cdm P $ by cdm_eq [k1]
k3: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm P = fv nvf h $ by weaken [#4]
k4: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm v = fv nvf h $ by eq_trans [k2, k3]
j9: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = scat v (scat q s) → x1 = scat v s → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j8, k4]
k5: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ P = v $ by eq_sym [k1]
k6: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ scat q s = scat q s $ by eq_refl
k7: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ scat P (scat q s) = scat v (scat q s) $ by scat_eq [k5, k6]
k8: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = R $ by ax
k9: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ R = scat P (scat q s) $ by weaken [#6]
k10: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = scat P (scat q s) $ by eq_trans [k8, k9]
k11: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = scat v (scat q s) $ by eq_trans [k10, k7]
j10: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = scat v s → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j9, k11]
k12: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ s = s $ by eq_refl
k13: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ scat P s = scat v s $ by scat_eq [k5, k12]
k14: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = O $ by ax
k15: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ O = scat P s $ by weaken [#8]
k16: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = scat P s $ by eq_trans [k14, k15]
k17: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = scat v s $ by eq_trans [k16, k13]
j11: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j10, k17]
m3: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ f = f $ by eq_refl
m4: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ w = w $ by eq_refl
m5: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ t = t $ by eq_refl
m6: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ R = x0 $ by eq_sym [k8]
m7: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) f w R = etel u (dnf u M) f w x0 $ by etel_eq [m3, m4, m6]
m8: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) t w x1 = etel u (dnf u M) t w O $ by etel_eq [m5, m4, k14]
m9: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w x1 $ by eq_trans [m7, j11]
m10: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w O $ by eq_trans [m9, m8]
