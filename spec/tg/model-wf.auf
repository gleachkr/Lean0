lemma b5_lstep (G: hyps) (M: class) (u w q s c j: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ dt u M q w s ∈ u $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ b5_is u M w q s $ > $ G ⇒ ⟨ c , j ⟩ ∈ b5_is u M w q s $
----
g1: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ w ∊ lvals $ by weaken [#1]
g2: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ s ∊ fseq u $ by weaken [#2]
g3: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ dt u M q w s ∈ u $ by weaken [#3]
g4: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ j ∊ fseq (trees ω) $ by weaken [#4]
g5: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ crn j ⊆ b5_is u M w q s $ by weaken [#5]
g6: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ z = ⟨ c , j ⟩ $ by ax
g7: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ ra_isort z m l ∈ lrel $ by ax
g8: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ ra_inst k z q e ∈ lrel $ by ax
d1: $ G , z = ⟨ c , j ⟩ , ra_isort z m l ∈ lrel , ra_inst k z q e ∈ lrel ⇒ ∃ x0 ∃ x2 ∃ x6 (k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel) ∨ ∃ x0 ∃ x6 ∃ x8 (k = x0 ∧ z = ⟨ kc_bvar , scons x0 ∅ ⟩ ∧ q = x6 ∧ e = x8 ∧ ra_lift x0 ⟨ kc_nz , ∅ ⟩ x6 x8 ∈ lrel) ∨ ∃ x0 ∃ x2 ∃ x6 (k = x0 ∧ z = ⟨ kc_bvar , scons ⟨ kc_s , scons x2 ∅ ⟩ ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le x0 x2 ∈ lrel) ∨ ∃ x0 ∃ x4 ∃ x6 (k = x0 ∧ z = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_srt , scons x4 ∅ ⟩) ∨ ∃ x0 ∃ x5 ∃ x3 ∃ x6 ∃ x7 ∃ x1 (k = x0 ∧ z = ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_app , scons x7 (scons x1 ∅) ⟩ ∧ ra_inst x0 x5 x6 x7 ∈ lrel ∧ ra_inst x0 x3 x6 x1 ∈ lrel) ∨ ∃ x0 ∃ x9 ∃ b ∃ x6 ∃ o ∃ r (k = x0 ∧ z = ⟨ kc_lam , scons x9 (scons b ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_lam , scons o (scons r ∅) ⟩ ∧ ra_inst x0 x9 x6 o ∈ lrel ∧ ra_inst ⟨ kc_s , scons x0 ∅ ⟩ b x6 r ∈ lrel) ∨ ∃ x0 ∃ x9 ∃ b ∃ x6 ∃ o ∃ r (k = x0 ∧ z = ⟨ kc_pi , scons x9 (scons b ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_pi , scons o (scons r ∅) ⟩ ∧ ra_inst x0 x9 x6 o ∈ lrel ∧ ra_inst ⟨ kc_s , scons x0 ∅ ⟩ b x6 r ∈ lrel) ∨ ∃ n ∃ x0 ∃ v ∃ x6 (k = x0 ∧ z = v ∧ q = x6 ∧ e = v ∧ ra_closed n v ∈ lrel ∧ ra_le n x0 ∈ lrel) ∨ ∃ x0 ∃ b ∃ x2 ∃ v ∃ x6 ∃ y (k = x0 ∧ z = ⟨ kc_proj , scons b (scons x2 (scons v ∅)) ⟩ ∧ q = x6 ∧ e = ⟨ kc_proj , scons b (scons x2 (scons y ∅)) ⟩ ∧ ra_inst x0 v x6 y ∈ lrel) $ by lrel_inst_cases [g8]
