n14: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J ⇒ o ∊ cpr (nest b ∅) (nest b e) $ by ex_elim [n2, n13b]
k1: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ ient D W (csn q) J ⊆ cpr (nest b ∅) (nest b e) $ by subset_intro [n14]
k2: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ universe u $ by weaken [#1]
k3: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ b ∊ fseq u $ by ax
k4: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ e ∊ u $ by ax
k5: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ nest b e ∈ u $ by nest_universe [k2, k3, k4]
k6: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ ∅ ∈ u $ by universe_empty [k2, k4]
k7: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , h = ∅ , h ∊ u ⇒ h ∊ u $ by ax
k8a: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , h = ∅ , h ∊ u ⇒ universe u $ by weaken [k2]
k8b: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , h = ∅ , h ∊ u ⇒ b ∊ fseq u $ by ax
k8: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , h = ∅ , h ∊ u ⇒ nest b h ∈ u $ by nest_universe [k8a, k8b, k7]
k9a: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , h = ∅ , h ∊ u ⇒ b = b $ by eq_refl
k9b: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , h = ∅ , h ∊ u ⇒ h = ∅ $ by ax
k9: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , h = ∅ , h ∊ u ⇒ nest b h = nest b ∅ $ by nest_eq [k9a, k9b]
k10: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , h = ∅ , h ∊ u ⇒ nest b ∅ ∈ u $ by wcel_eq_l [k9, k8]
k11: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ nest b ∅ ∈ u $ by wcel_elim [k6, k10]
k12: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ cpr (nest b ∅) (nest b e) ∈ u $ by universe_cpr_c [k2, k11, k5]
k13: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ ient D W (csn q) J ∈ u $ by universe_subset_c [k2, k12, k1]
k14: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u ⇒ ient D W (csn q) J ∈ u $ by cxp_elim [c1, k13]
k15: $ G ⇒ ient D W (csn q) J ∈ u $ by cxp_elim [#2, k14]

lemma b7_ient_universe (G: hyps) (D W Z J: class) (u: set): $ G ⇒ universe u $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × u) $ > $ G ⇒ ient D W Z J ∈ u $
----
s1: $ G , z = Z , z ∊ u ⇒ z = Z $ by ax
s2: $ G , z = Z , z ∊ u ⇒ z ⊆ Z $ by eq_subset [s1]
s3: $ G , z = Z , z ∊ u ⇒ Z ⊆ ω × (fseq u × u) $ by weaken [#3]
s4: $ G , z = Z , z ∊ u ⇒ z ⊆ ω × (fseq u × u) $ by subset_trans [s2, s3]
s5: $ G , z = Z , z ∊ u ⇒ universe u $ by weaken [#1]
s6: $ G , z = Z , z ∊ u ⇒ z ∊ u $ by ax
t1: $ G , z = Z , z ∊ u , k ∊ z ⇒ k ∊ z $ by ax
t2: $ G , z = Z , z ∊ u , k ∊ z ⇒ z ⊆ ω × (fseq u × u) $ by weaken [s4]
t3: $ G , z = Z , z ∊ u , k ∊ z ⇒ k ∊ ω × (fseq u × u) $ by subset_elim [t2, t1]
t4: $ G , z = Z , z ∊ u , k ∊ z ⇒ universe u $ by weaken [s5]
t5: $ G , z = Z , z ∊ u , k ∊ z ⇒ ient D W (csn k) J ∈ u $ by b7_ient_csn [t4, t3]
t6: $ G , z = Z , z ∊ u ⇒ k ∊ z → ient D W (csn k) J ∈ u $ by imp_intro [t5]
t7: $ G , z = Z , z ∊ u ⇒ ∀ k (k ∊ z → ient D W (csn k) J ∈ u) $ by all_intro [t6]
t8: $ G , z = Z , z ∊ u ⇒ ⋃ (img (cgr k (ient D W (csn k) J)) z) ∈ u $ by universe_cuni_op [s5, s6, t7]
m1: $ G , z = Z , z ∊ u , o ∊ ient D W z J ⇒ o ∊ ient D W z J $ by ax
m2: $ G , z = Z , z ∊ u , o ∊ ient D W z J ⇒ ∃ a ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x))) $ by cab_elim [m1]
m3: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) $ by ax
m4: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z $ by and_elim_l [m3]
m5: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ (iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x) $ by and_elim_r [m3]
w1: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ q = ⟨ J , ⟨ a , x ⟩ ⟩ $ by ax
w2: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q $ by b7_csn_in [w1]
w3: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ (iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x) $ by weaken [m5]
w4: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) $ by and_intro [w2, w3]
w5: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x))) $ by ex_intro [w4]
w6: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ ∃ a ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x))) $ by ex_intro [w5]
w7: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ o ∊ ient D W (csn q) J $ by cab_intro [w6]
w8: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ q ∊ z $ by ax
w9a: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ z ⊆ ω × (fseq u × u) $ by weaken [s4]
w9b: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ q ∊ ω × (fseq u × u) $ by subset_elim [w9a, w8]
w9c: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ universe u $ by weaken [s5]
w9: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ ient D W (csn q) J ∈ u $ by b7_ient_csn [w9c, w9b]
w10: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ isset (ient D W (csn q) J) $ by wcel_isset [w9]
y1: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z , r = ient D W (csn q) J ⇒ r = ient D W (csn q) J $ by ax
y2: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z , r = ient D W (csn q) J ⇒ ⟨ q , r ⟩ ∈ cgr k (ient D W (csn k) J) $ by cgr_intro [y1]
y3: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z , r = ient D W (csn q) J ⇒ q ∊ z $ by ax
y4: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z , r = ient D W (csn q) J ⇒ r ∊ img (cgr k (ient D W (csn k) J)) z $ by img_intro [y3, y2]
y5: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z , r = ient D W (csn q) J ⇒ ient D W (csn q) J = r $ by eq_sym [y1]
y6: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z , r = ient D W (csn q) J ⇒ o ∊ ient D W (csn q) J $ by weaken [w7]
y7: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z , r = ient D W (csn q) J ⇒ o ∊ r $ by welc_eq [y5, y6]
y8: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z , r = ient D W (csn q) J ⇒ o ∊ ⋃ (img (cgr k (ient D W (csn k) J)) z) $ by cuni_intro [y7, y4]
y9: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , q = ⟨ J , ⟨ a , x ⟩ ⟩ , q ∊ z ⇒ o ∊ ⋃ (img (cgr k (ient D W (csn k) J)) z) $ by isset_elim [w10, y8]
y10: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ o ∊ ⋃ (img (cgr k (ient D W (csn k) J)) z) $ by wcel_elim [m4, y9]
y10a: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x))) ⇒ ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x))) $ by ax
y10b: $ G , z = Z , z ∊ u , o ∊ ient D W z J , ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ z ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x))) ⇒ o ∊ ⋃ (img (cgr k (ient D W (csn k) J)) z) $ by ex_elim [y10a, y10]
y11: $ G , z = Z , z ∊ u , o ∊ ient D W z J ⇒ o ∊ ⋃ (img (cgr k (ient D W (csn k) J)) z) $ by ex_elim [m2, y10b]
y12: $ G , z = Z , z ∊ u ⇒ ient D W z J ⊆ ⋃ (img (cgr k (ient D W (csn k) J)) z) $ by subset_intro [y11]
y13: $ G , z = Z , z ∊ u ⇒ ient D W z J ∈ u $ by universe_subset_c [s5, t8, y12]
y14: $ G , z = Z , z ∊ u ⇒ z = Z $ by ax
y15a: $ G , z = Z , z ∊ u ⇒ D = D $ by eq_refl
y15b: $ G , z = Z , z ∊ u ⇒ W = W $ by eq_refl
y15c: $ G , z = Z , z ∊ u ⇒ J = J $ by eq_refl
y15: $ G , z = Z , z ∊ u ⇒ ient D W z J = ient D W Z J $ by ient_eq [y15a, y15b, y14, y15c]
y16: $ G , z = Z , z ∊ u ⇒ ient D W Z J ∈ u $ by wcel_eq_l [y15, y13]
y17: $ G ⇒ ient D W Z J ∈ u $ by wcel_elim [#2, y16]

--| The class of all sets.
def b7_V (.x: set): class = $ {x | x = x} $

lemma b7_V_in (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ b7_V $
----
a1: $ G , z = A ⇒ z = z $ by eq_refl
a2: $ G , z = A ⇒ z ∊ {x | x = x} $ by cab_intro [a1]
a3: $ G , z = A ⇒ z = A $ by ax
a4: $ G , z = A ⇒ A ∈ {x | x = x} $ by wcel_intro [a3, a2]
a5: $ G ⇒ A ∈ b7_V $ by isset_elim [#1, a4]

lemma b7_fseqV (G: hyps) (A S: class): $ G ⇒ S ∈ fseq A $ > $ G ⇒ S ∈ fseq b7_V $
----
a1: $ G , z ∊ A ⇒ isset z $ by isset_var
a2: $ G , z ∊ A ⇒ z ∈ b7_V $ by b7_V_in [a1]
a3: $ G , z ∊ A ⇒ z ∊ b7_V $ by wcel_welc [a2]
a4: $ G ⇒ A ⊆ b7_V $ by subset_intro [a3]
a5: $ G ⇒ fseq A ⊆ fseq b7_V $ by fseq_mono [a4]
a6: $ G ⇒ S ∈ fseq b7_V $ by wcel_subset [a5, #1]

--| Positions from `K` on of the valuation `A` grow into `B` at the points over `Q`
--| with an index count of type `j` in front.
def b7_hq (D Q A B K: class) (.j .m .x .y: set): fml = $ ∀ j ∀ m ∀ x ∀ y (ra_nidx D j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x Q) y ∈ fv A (nadd K (fv nvf j)) → nest (scat x Q) y ∈ fv B (nadd K (fv nvf j))) $

--| `b7_hq` from the types' positions at depth `E`, and the parameters' window is `Q`.
def b7_hw (D Q A B E N: class): fml = $ b7_hq D Q A B (nadd (fv nvf E) (fv nvf N)) ∧ swin A (fv nvf E) (fv nvf N) = Q $

--| @congr
lemma b7_hq_congr (A B C D E F H I J K: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ b7_hq A C E H J ⟺ b7_hq B D F I K $
----
c0a: $ j ≐ j $ by ceqt_refl
c0b: $ m ≐ m $ by ceqt_refl
c0c: $ lrel ≐ lrel $ by ceqt_refl
c1: $ ra_nidx A j m ≐ ra_nidx B j m $ by ra_nidx_congr [#1, c0a, c0b]
c2: $ (ra_nidx A j m ∈ lrel) ⟺ (ra_nidx B j m ∈ lrel) $ by wcel_congr [c1, c0c]
c3: $ (x ∊ fseq b7_V) ⟺ (x ∊ fseq b7_V) $ by iff_refl
c4: $ (cdm x = fv nvf m) ⟺ (cdm x = fv nvf m) $ by iff_refl
c5a: $ x ≐ x $ by ceqt_refl
c5: $ scat x C ≐ scat x D $ by scat_congr [c5a, #2]
c6a: $ y ≐ y $ by ceqt_refl
c6: $ nest (scat x C) y ≐ nest (scat x D) y $ by nest_congr [c5, c6a]
c7a: $ fv nvf j ≐ fv nvf j $ by ceqt_refl
c7: $ nadd J (fv nvf j) ≐ nadd K (fv nvf j) $ by nadd_congr [#5, c7a]
c8: $ fv E (nadd J (fv nvf j)) ≐ fv F (nadd K (fv nvf j)) $ by fv_congr [#3, c7]
c9: $ fv H (nadd J (fv nvf j)) ≐ fv I (nadd K (fv nvf j)) $ by fv_congr [#4, c7]
c10: $ (nest (scat x C) y ∈ fv E (nadd J (fv nvf j))) ⟺ (nest (scat x D) y ∈ fv F (nadd K (fv nvf j))) $ by wcel_congr [c6, c8]
c11: $ (nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by wcel_congr [c6, c9]
c12: $ (nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c10, c11]
c13: $ (cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c4, c12]
c14: $ (x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c3, c13]
c15: $ (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c2, c14]
c16: $ (∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j)))) ⟺ (∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j)))) $ by all_congr [c15]
c17: $ (∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j)))) ⟺ (∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j)))) $ by all_congr [c16]
c18: $ (∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j)))) ⟺ (∀ m ∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j)))) $ by all_congr [c17]
c19: $ (∀ j ∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j)))) ⟺ (∀ j ∀ m ∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j)))) $ by all_congr [c18]

--| @rewrite
lemma b7_sb_hq {z: set} (t: set z) (A B C D E: class z): $ [z/t] (b7_hq A B C D E) ⟺ b7_hq (⟦ z / t ⟧ A) (⟦ z / t ⟧ B) (⟦ z / t ⟧ C) (⟦ z / t ⟧ D) (⟦ z / t ⟧ E) $
----
l1: $ [z/t] (∀ j ∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x B) y ∈ fv C (nadd E (fv nvf j)) → nest (scat x B) y ∈ fv D (nadd E (fv nvf j)))) ⟺ ∀ j ∀ m ∀ x ∀ y (ra_nidx (⟦ z / t ⟧ A) j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x (⟦ z / t ⟧ B)) y ∈ fv (⟦ z / t ⟧ C) (nadd (⟦ z / t ⟧ E) (fv nvf j)) → nest (scat x (⟦ z / t ⟧ B)) y ∈ fv (⟦ z / t ⟧ D) (nadd (⟦ z / t ⟧ E) (fv nvf j))) $ by iff_refl

--| @congr
lemma b7_hw_congr (A B C D E F H I J K L N: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ L ≐ N $ > $ b7_hw A C E H J L ⟺ b7_hw B D F I K N $
----
c0: $ nvf ≐ nvf $ by ceqt_refl
c1: $ fv nvf J ≐ fv nvf K $ by fv_congr [c0, #5]
c2: $ fv nvf L ≐ fv nvf N $ by fv_congr [c0, #6]
c3: $ nadd (fv nvf J) (fv nvf L) ≐ nadd (fv nvf K) (fv nvf N) $ by nadd_congr [c1, c2]
c4: $ b7_hq A C E H (nadd (fv nvf J) (fv nvf L)) ⟺ b7_hq B D F I (nadd (fv nvf K) (fv nvf N)) $ by b7_hq_congr [#1, #2, #3, #4, c3]
c5: $ swin E (fv nvf J) (fv nvf L) ≐ swin F (fv nvf K) (fv nvf N) $ by swin_congr [#3, c1, c2]
c6: $ (swin E (fv nvf J) (fv nvf L) = C) ⟺ (swin F (fv nvf K) (fv nvf N) = D) $ by ceq_congr [c5, #2]
c7: $ (b7_hq A C E H (nadd (fv nvf J) (fv nvf L)) ∧ swin E (fv nvf J) (fv nvf L) = C) ⟺ (b7_hq B D F I (nadd (fv nvf K) (fv nvf N)) ∧ swin F (fv nvf K) (fv nvf N) = D) $ by and_congr [c4, c6]

--| @rewrite
lemma b7_sb_hw {z: set} (t: set z) (A B C D E F: class z): $ [z/t] (b7_hw A B C D E F) ⟺ b7_hw (⟦ z / t ⟧ A) (⟦ z / t ⟧ B) (⟦ z / t ⟧ C) (⟦ z / t ⟧ D) (⟦ z / t ⟧ E) (⟦ z / t ⟧ F) $
----
l1: $ [z/t] (b7_hq A B C D (nadd (fv nvf E) (fv nvf F)) ∧ swin C (fv nvf E) (fv nvf F) = B) ⟺ (b7_hq (⟦ z / t ⟧ A) (⟦ z / t ⟧ B) (⟦ z / t ⟧ C) (⟦ z / t ⟧ D) (nadd (fv nvf (⟦ z / t ⟧ E)) (fv nvf (⟦ z / t ⟧ F))) ∧ swin (⟦ z / t ⟧ C) (fv nvf (⟦ z / t ⟧ E)) (fv nvf (⟦ z / t ⟧ F)) = (⟦ z / t ⟧ B)) $ by iff_refl

lemma b7_hw_eq (G: hyps) (Q A B: class) (d1 d2 e1 e2 n1 n2: set): $ G ⇒ d1 = d2 $ > $ G ⇒ e1 = e2 $ > $ G ⇒ n1 = n2 $ > $ G ⇒ b7_hw d1 Q A B e1 n1 $ > $ G ⇒ b7_hw d2 Q A B e2 n2 $
----
l1: $ G ⇒ b7_hw d2 Q A B e1 n1 $ by eq_subst [#1, #4]
l2: $ G ⇒ b7_hw d2 Q A B e2 n1 $ by eq_subst [#2, l1]
l3: $ G ⇒ b7_hw d2 Q A B e2 n2 $ by eq_subst [#3, l2]

lemma b7_swin_scons (G: hyps) (D N: class) (c a: set): $ G ⇒ D ∈ ω $ > $ G ⇒ N ∈ ω $ > $ G ⇒ swin (scons c a) (suc D) N = swin a D N $
----
a1: $ G , z ∊ swin (scons c a) (suc D) N ⇒ z ∊ swin (scons c a) (suc D) N $ by ax
a2: $ G , z ∊ swin (scons c a) (suc D) N ⇒ ∃ i (i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩) $ by cab_elim [a1]
b1: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ $ by ax
b2: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ i ∊ N $ by and_elim_l [b1]
b3: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ $ by and_elim_r [b1]
b4a: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ D ∈ ω $ by weaken [#1]
b4b: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ isset D $ by wcel_isset [b4a]
b4c: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ N ∈ ω $ by weaken [#2]
b4d: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ i ∈ N $ by welc_wcel [b2]
b4e: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ i ∈ ω $ by omega_elem_omega_c [b4d, b4c]
b4: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ nadd (suc D) i = suc (nadd D i) $ by suc_nadd_c [b4b, b4e]
b5a: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ scons c a = scons c a $ by eq_refl
b5: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ fv (scons c a) (nadd (suc D) i) = fv (scons c a) (suc (nadd D i)) $ by fv_eq [b5a, b4]
b6a: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ isset c $ by isset_var
b6b: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ isset a $ by isset_var
b6c: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ nadd D i ∈ ω $ by nadd_omega_c [b4a, b4e]
b6d: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ isset (nadd D i) $ by wcel_isset [b6c]
b6: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ fv (scons c a) (suc (nadd D i)) = fv a (nadd D i) $ by scons_fv_suc_c [b6a, b6b, b6d]
b7: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ fv (scons c a) (nadd (suc D) i) = fv a (nadd D i) $ by eq_trans [b5, b6]
b8a: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ i = i $ by eq_refl
b8: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ = ⟨ i , fv a (nadd D i) ⟩ $ by opair_eq [b8a, b7]
b9: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ z = ⟨ i , fv a (nadd D i) ⟩ $ by eq_trans [b3, b8]
b10: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ $ by and_intro [b2, b9]
b11: $ G , z ∊ swin (scons c a) (suc D) N , i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ ⇒ ∃ i (i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩) $ by ex_intro [b10]
b12: $ G , z ∊ swin (scons c a) (suc D) N ⇒ ∃ i (i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩) $ by ex_elim [a2, b11]
b13: $ G , z ∊ swin (scons c a) (suc D) N ⇒ z ∊ swin a D N $ by cab_intro [b12]
d1: $ G , z ∊ swin a D N ⇒ z ∊ swin a D N $ by ax
d2: $ G , z ∊ swin a D N ⇒ ∃ i (i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩) $ by cab_elim [d1]
e1: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ $ by ax
e2: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ i ∊ N $ by and_elim_l [e1]
e3: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ z = ⟨ i , fv a (nadd D i) ⟩ $ by and_elim_r [e1]
e4a: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ D ∈ ω $ by weaken [#1]
e4b: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ isset D $ by wcel_isset [e4a]
e4c: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ N ∈ ω $ by weaken [#2]
e4d: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ i ∈ N $ by welc_wcel [e2]
e4e: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ i ∈ ω $ by omega_elem_omega_c [e4d, e4c]
e4: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ nadd (suc D) i = suc (nadd D i) $ by suc_nadd_c [e4b, e4e]
e5a: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ scons c a = scons c a $ by eq_refl
e5: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ fv (scons c a) (nadd (suc D) i) = fv (scons c a) (suc (nadd D i)) $ by fv_eq [e5a, e4]
e6a: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ isset c $ by isset_var
e6b: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ isset a $ by isset_var
e6c: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ nadd D i ∈ ω $ by nadd_omega_c [e4a, e4e]
e6d: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ isset (nadd D i) $ by wcel_isset [e6c]
e6: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ fv (scons c a) (suc (nadd D i)) = fv a (nadd D i) $ by scons_fv_suc_c [e6a, e6b, e6d]
e7: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ fv (scons c a) (nadd (suc D) i) = fv a (nadd D i) $ by eq_trans [e5, e6]
e7b: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ fv a (nadd D i) = fv (scons c a) (nadd (suc D) i) $ by eq_sym [e7]
e8a: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ i = i $ by eq_refl
e8: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ ⟨ i , fv a (nadd D i) ⟩ = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ $ by opair_eq [e8a, e7b]
e9: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ $ by eq_trans [e3, e8]
e10: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩ $ by and_intro [e2, e9]
e11: $ G , z ∊ swin a D N , i ∊ N ∧ z = ⟨ i , fv a (nadd D i) ⟩ ⇒ ∃ i (i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩) $ by ex_intro [e10]
e12: $ G , z ∊ swin a D N ⇒ ∃ i (i ∊ N ∧ z = ⟨ i , fv (scons c a) (nadd (suc D) i) ⟩) $ by ex_elim [d2, e11]
e13: $ G , z ∊ swin a D N ⇒ z ∊ swin (scons c a) (suc D) N $ by cab_intro [e12]
e14: $ G ⇒ swin (scons c a) (suc D) N = swin a D N $ by eq_intro [b13, e13]

lemma b7_hw_scons (G: hyps) (D Q: class) (a b c e n: set): $ G ⇒ b7_hw D Q a b e n $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ b7_hw D Q (scons c a) (scons c b) ⟨ kc_s , scons e ∅ ⟩ n $
----
s0: $ G ⇒ e ∈ trees ω $ by welc_wcel [#2]
s1: $ G ⇒ fv nvf ⟨ kc_s , scons e ∅ ⟩ = suc (fv nvf e) $ by nvf_s [s0]
s1b: $ G ⇒ fv nvf n = fv nvf n $ by eq_refl
s2: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = nadd (suc (fv nvf e)) (fv nvf n) $ by nadd_eq [s1, s1b]
s3a: $ G ⇒ functional nvf $ by nvf_functional
s3b: $ G ⇒ isset (fv nvf e) $ by fv_set [s3a]
s3c: $ G ⇒ isset n $ by isset_var
s3d: $ G ⇒ fv nvf n ∈ ω $ by nvf_omega [s3c]
s3: $ G ⇒ nadd (suc (fv nvf e)) (fv nvf n) = suc (nadd (fv nvf e) (fv nvf n)) $ by suc_nadd_c [s3b, s3d]
s4: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = suc (nadd (fv nvf e) (fv nvf n)) $ by eq_trans [s2, s3]
s5a: $ G ⇒ isset e $ by isset_var
s5b: $ G ⇒ fv nvf e ∈ ω $ by nvf_omega [s5a]
s5: $ G ⇒ nadd (fv nvf e) (fv nvf n) ∈ ω $ by nadd_omega_c [s5b, s3d]
s6: $ G ⇒ isset (nadd (fv nvf e) (fv nvf n)) $ by wcel_isset [s5]
h0: $ G ⇒ b7_hq D Q a b (nadd (fv nvf e) (fv nvf n)) $ by and_elim_l [#1]
t0a: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , nest (scat x Q) y ∈ fv (scons c a) (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ isset j $ by isset_var
t0: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , nest (scat x Q) y ∈ fv (scons c a) (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ (fv nvf j) ∈ ω $ by nvf_omega [t0a]
