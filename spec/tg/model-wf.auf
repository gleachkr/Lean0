d2: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ = bb $ by eq_sym [cl6]
