def b6_cpis (.y .b .c .q .m .l .o: set): class = $ {y | ∀ b ∀ c (ra_pis y b c ∈ lrel → (y ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen y q ∈ lrel → ra_isort b m l ∈ lrel → ∃ o (ra_isort c o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m))))} $

lemma b6_zero_nadd (G: hyps) (X: class): $ G ⇒ X ∈ ω $ > $ G ⇒ nadd ∅ X = X $
----
q1: $ G ⇒ ∅ ∈ ω $ by omega_zero
q2: $ G ⇒ nadd ∅ X = nadd X ∅ $ by nadd_comm_c [q1, #1]
q3: $ G ⇒ isset X $ by wcel_isset [#1]
q4: $ G ⇒ nadd X ∅ = X $ by nadd_zero_c [q3]
q5: $ G ⇒ nadd ∅ X = X $ by eq_trans [q2, q4]

lemma b6_pis_st (G: hyps) {q m l o: set} (z k s t2 t3: set): $ G ⇒ crn s ⊆ b6_cpis $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_pis z t2 t3 ∈ lrel $ > $ G ⇒ (z ∊ ofsort lsig lopen ks_ctx → t2 ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen z q ∈ lrel → ra_isort t2 m l ∈ lrel → ∃ o (ra_isort t3 o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m))) $
----
q1: $ G ⇒ ∃ e (z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e) ∨ ∃ d ∃ e ∃ f ∃ g (z = ⟨ kc_cons , scons d (scons g ∅) ⟩ ∧ t2 = e ∧ t3 = f ∧ ra_pis g ⟨ kc_pi , scons d (scons e ∅) ⟩ f ∈ lrel) $ by lrel_pis_cases [#4]
q2: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e $ by ax
q3: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [q2]
