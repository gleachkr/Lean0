q52: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ nadd (fv nvf x4) (fv nvf x3) = fv nvf x5 $ by eq_sym [q45]
q53: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ cdm t6 = fv nvf x5 $ by eq_trans [q51, q52]
q54: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ h = scat t6 X $ by weaken [q7]
q55: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ scat t6 X = h $ by eq_sym [q54]
q56: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ l = scat t6 Y $ by weaken [q8]
q57: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ scat t6 Y = l $ by eq_sym [q56]
