lemma b11_nc_sargset (G: hyps) (M: class) (u w t1 t2 t3 d y j0 r: set): $ G ⇒ uadm u $ > $ G ⇒ ra_indapp t1 t2 t3 d y j0 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ isset (sarg u (dnf u M) y w r) $
