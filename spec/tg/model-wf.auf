lemma b15_tys_lv {kk ll: set} (G: hyps) (J: class) (dd nv np lv iv cx bb jj ff ee: set): $ G ⇒ ra_tys_wf dd nv np lv iv cx bb ∈ lrel3 J $ > $ G ⇒ ra_nth_ty bb jj ff ee ∈ lrel $ > $ G ⇒ ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $
----
bz1: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ⇒ b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 $ by ax
bz2: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ⇒ b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ $ by and_elim_l [bz1]
bz3: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ⇒ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 $ by and_elim_r [bz1]
bz4: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ⇒ ff = x7 ∧ ee = x8 $ by and_elim_r [bz3]
bz5: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ⇒ ff = x7 $ by and_elim_l [bz4]
bz6: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ⇒ ra_tys_wf dd nv np lv a cx b ∈ lrel3 J $ by ax
bz7: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons x7 (scons x8 (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_nz , ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ⇒ ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $ by b15_tys_head [bz6, bz2, bz5]
bs1: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel $ by ax
bs2: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ $ by and_elim_l [bs1]
