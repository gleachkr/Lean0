lemma b14_mod {x k: set} (G: hyps x) (C: class) (B: class x) (h a e y: set): $ G ⇒ isset C $ > $ G ⇒ h ∊ cpi x C B $ > $ G ⇒ a ∊ C $ > $ G ⇒ e ∊ (⟦ x / a ⟧ B) $ > $ G ⇒ y ∊ e $ > $ G ⇒ ∃ k (k ∊ cpi x C B ∧ ⟨ a , y ⟩ ∈ k) $
----
c1: $ G , i ∊ C , i = a , d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ⇒ d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} $ by ax
c2: $ … ⇒ (i = a ∧ d ∊ e) ∨ (¬ i = a ∧ d ∊ ap h i) $ by cab_elim [c1]
c3: $ G , i ∊ C , i = a , d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} , i = a ∧ d ∊ e ⇒ i = a ∧ d ∊ e $ by ax
c4: $ … ⇒ d ∊ e $ by and_elim_r [c3]
c5: $ G , i ∊ C , i = a , d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} , ¬ i = a ∧ d ∊ ap h i ⇒ ¬ i = a ∧ d ∊ ap h i $ by ax
c6: $ … ⇒ ¬ i = a $ by and_elim_l [c5]
c7: $ G , i ∊ C , i = a , d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} , ¬ i = a ∧ d ∊ ap h i ⇒ i = a $ by ax
c8: $ … ⇒ ⊥ $ by not_elim [c6, c7]
c9: $ … ⇒ d ∊ e $ by bot_elim [c8]
c10: $ … ⇒ d ∊ e $ by or_elim [c2, c4, c9]
c11: $ G , i ∊ C , i = a , d ∊ e ⇒ d ∊ e $ by ax
c12: $ G , i ∊ C , i = a , d ∊ e ⇒ i = a $ by ax
c13: $ … ⇒ i = a ∧ d ∊ e $ by and_intro [c12, c11]
c14: $ … ⇒ (i = a ∧ d ∊ e) ∨ (¬ i = a ∧ d ∊ ap h i) $ by or_intro_l [c13]
c15: $ … ⇒ d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} $ by cab_intro [c14]
c16: $ … ⇒ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} = e $ by eq_intro [c10, c15]
c17: $ G , i ∊ C , i = a ⇒ i = a $ by ax
c18: $ … ⇒ a = i $ by eq_sym [c17]
c19: $ … ⇒ (⟦ x / a ⟧ B) = (⟦ x / i ⟧ B) $ by sb_c_eq [c18]
c20: $ G , i ∊ C , i = a ⇒ e ∊ (⟦ x / a ⟧ B) $ by weaken [#4]
c21: $ … ⇒ e ∊ (⟦ x / i ⟧ B) $ by welc_eq [c19, c20]
c22: $ … ⇒ e ∈ (⟦ x / i ⟧ B) $ by welc_wcel [c21]
c23: $ … ⇒ e = {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} $ by eq_sym [c16]
c24: $ … ⇒ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ∈ (⟦ x / i ⟧ B) $ by wcel_eq_l [c23, c22]
d1: $ G , i ∊ C , ¬ i = a , d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ⇒ d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} $ by ax
d2: $ … ⇒ (i = a ∧ d ∊ e) ∨ (¬ i = a ∧ d ∊ ap h i) $ by cab_elim [d1]
d3: $ G , i ∊ C , ¬ i = a , d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} , i = a ∧ d ∊ e ⇒ i = a ∧ d ∊ e $ by ax
d4: $ … ⇒ i = a $ by and_elim_l [d3]
d5: $ G , i ∊ C , ¬ i = a , d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} , i = a ∧ d ∊ e ⇒ ¬ i = a $ by ax
d6: $ … ⇒ ⊥ $ by not_elim [d5, d4]
d7: $ … ⇒ d ∊ ap h i $ by bot_elim [d6]
d8: $ G , i ∊ C , ¬ i = a , d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} , ¬ i = a ∧ d ∊ ap h i ⇒ ¬ i = a ∧ d ∊ ap h i $ by ax
d9: $ … ⇒ d ∊ ap h i $ by and_elim_r [d8]
d10: $ … ⇒ d ∊ ap h i $ by or_elim [d2, d7, d9]
d11: $ G , i ∊ C , ¬ i = a , d ∊ ap h i ⇒ d ∊ ap h i $ by ax
d12: $ G , i ∊ C , ¬ i = a , d ∊ ap h i ⇒ ¬ i = a $ by ax
d13: $ … ⇒ ¬ i = a ∧ d ∊ ap h i $ by and_intro [d12, d11]
d14: $ … ⇒ (i = a ∧ d ∊ e) ∨ (¬ i = a ∧ d ∊ ap h i) $ by or_intro_r [d13]
d15: $ … ⇒ d ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} $ by cab_intro [d14]
d16: $ … ⇒ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} = ap h i $ by eq_intro [d10, d15]
d17: $ G , i ∊ C , ¬ i = a ⇒ h ∊ cpi x C B $ by weaken [#2]
d18: $ G , i ∊ C , ¬ i = a ⇒ i ∊ C $ by ax
d19: $ … ⇒ ap h i ∈ (⟦ x / i ⟧ B) $ by cpi_elim_ap [d17, d18]
d20: $ … ⇒ ap h i = {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} $ by eq_sym [d16]
d21: $ … ⇒ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ∈ (⟦ x / i ⟧ B) $ by wcel_eq_l [d20, d19]
e1: $ G , i ∊ C ⇒ i = a ∨ ¬ i = a $ by excluded_middle
e2: $ … ⇒ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ∈ (⟦ x / i ⟧ B) $ by or_elim [e1, c24, d21]
e3: $ … ⇒ i ∊ C → {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ∈ (⟦ x / i ⟧ B) $ by imp_intro [e2]
e4: $ … ⇒ ∀ i (i ∊ C → {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ∈ (⟦ x / i ⟧ B)) $ by all_intro [e3]
e4a: $ _ ⇒ ∀ x (x ∊ C → {j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)} ∈ B) ↔ ∀ i (i ∊ C → {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ∈ (⟦ x / i ⟧ B)) $ by all_alpha
e4b: $ G ⇒ ∀ x (x ∊ C → {j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)} ∈ B) ↔ ∀ i (i ∊ C → {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} ∈ (⟦ x / i ⟧ B)) $ by weaken [e4a]
e4c: $ … ⇒ ∀ x (x ∊ C → {j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)} ∈ B) $ by bi_elim_r [e4b, e4]
e5: $ … ⇒ isset ({j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)}) $ by wcel_isset [e2]
e6: $ … ⇒ i ∊ C → isset ({j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)}) $ by imp_intro [e5]
e7: $ … ⇒ ∀ i (i ∊ C → isset ({j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)})) $ by all_intro [e6]
e7a: $ _ ⇒ ∀ x (x ∊ C → isset ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)})) ↔ ∀ i (i ∊ C → isset ({j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)})) $ by all_alpha
e7b: $ G ⇒ ∀ x (x ∊ C → isset ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)})) ↔ ∀ i (i ∊ C → isset ({j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)})) $ by weaken [e7a]
e7c: $ … ⇒ ∀ x (x ∊ C → isset ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)})) $ by bi_elim_r [e7b, e7]
e8: $ … ⇒ isset (clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)})) $ by clam_set [#1, e7c]
e9: $ … ⇒ clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) ∈ cpi x C B $ by clam_cpi_intro [e8, e4c]
g0: $ G ⇒ isset a $ by isset_var
g1: $ G , i = a ⇒ i = a $ by ax
g2a: $ G , i = a ⇒ y ∊ e $ by weaken [#5]
g2: $ … ⇒ i = a ∧ y ∊ e $ by and_intro [g1, g2a]
g3: $ … ⇒ (i = a ∧ y ∊ e) ∨ (¬ i = a ∧ y ∊ ap h i) $ by or_intro_l [g2]
g4: $ … ⇒ y ∊ {j | (i = a ∧ j ∊ e) ∨ (¬ i = a ∧ j ∊ ap h i)} $ by cab_intro [g3]
g4a: $ G , i = a ⇒ a ∊ C $ by weaken [#3]
g4b: $ … ⇒ a = i $ by eq_sym [g1]
g4c: $ … ⇒ i ∊ C $ by welc_eq_set [g4b, g4a]
g4x: $ G , i = a ⇒ y ∊ (⟦ x / i ⟧ {j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) $ by weaken [g4]
g4d: $ … ⇒ ⟨ i , y ⟩ ∈ clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) $ by clam_intro [g4c, g4x]
g4e: $ G , i = a ⇒ y = y $ by eq_refl
g4f: $ … ⇒ ⟨ i , y ⟩ = ⟨ a , y ⟩ $ by opair_eq [g1, g4e]
g4g: $ … ⇒ ⟨ a , y ⟩ ∈ clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) $ by wcel_eq_l [g4f, g4d]
g5: $ … ⇒ ⟨ a , y ⟩ ∈ clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) $ by isset_elim [g0, g4g]
h1: $ G , k = clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) ⇒ k = clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) $ by ax
h2: $ … ⇒ clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) = k $ by eq_sym [h1]
h3: $ G , k = clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) ⇒ clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) ∈ cpi x C B $ by weaken [e9]
h4: $ … ⇒ k ∈ cpi x C B $ by wcel_eq_l [h2, h3]
h5: $ … ⇒ k ∊ cpi x C B $ by wcel_welc [h4]
h6: $ G , k = clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) ⇒ ⟨ a , y ⟩ ∈ clam x C ({j | (x = a ∧ j ∊ e) ∨ (¬ x = a ∧ j ∊ ap h x)}) $ by weaken [g5]
h7: $ … ⇒ ⟨ a , y ⟩ ∈ k $ by wcel_eq_r [h2, h6]
h8: $ … ⇒ k ∊ cpi x C B ∧ ⟨ a , y ⟩ ∈ k $ by and_intro [h5, h7]
h9: $ … ⇒ ∃ k (k ∊ cpi x C B ∧ ⟨ a , y ⟩ ∈ k) $ by ex_intro [h8]
h10: $ … ⇒ ∃ k (k ∊ cpi x C B ∧ ⟨ a , y ⟩ ∈ k) $ by isset_elim [e8, h9]

lemma b14_cpi_pt {x i j h y: set} (G: hyps x) (C: class) (A B: class x) (k h0 p: set): $ G ⇒ isset C $ > $ G ⇒ k ∊ cpi x C A $ > $ G ⇒ h0 ∊ cpi x C B $ > $ G ⇒ ∀ x (x ∊ C → B ⊆ csn ∅ → A ⊆ csn ∅) $ > $ G ⇒ p ∊ k $ > $ G ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $
----
a1: $ G ⇒ k ⊆ clam x C (⋃ A) $ by cpi_elim_sub [#2]
a2: $ … ⇒ p ∊ clam x C (⋃ A) $ by subset_elim [a1, #5]
b1: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) ⇒ p = ⟨ i , j ⟩ $ by ax
b2: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) ⇒ i ∊ C $ by ax
b3: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) ⇒ p ∊ k $ by weaken [#5]
b4: $ … ⇒ p ∈ k $ by welc_wcel [b3]
b5: $ … ⇒ ⟨ i , j ⟩ ∈ k $ by wcel_eq_l [b1, b4]
b6: $ … ⇒ j ∊ ap k i $ by ap_intro [b5]
b7: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) ⇒ k ∊ cpi x C A $ by weaken [#2]
b8: $ … ⇒ ap k i ∈ (⟦ x / i ⟧ A) $ by cpi_elim_ap [b7, b2]
c1: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e ⇒ e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e $ by ax
c2: $ … ⇒ e ∊ (⟦ x / i ⟧ B) $ by and_elim_l [c1]
c3: $ … ⇒ y ∊ e $ by and_elim_r [c1]
c4: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e ⇒ isset C $ by weaken [#1]
c5: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e ⇒ h0 ∊ cpi x C B $ by weaken [#3]
c6: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e ⇒ i ∊ C $ by ax
c7: $ … ⇒ ∃ h (h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by b14_mod [c4, c5, c6, c2, c3]
c8: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h ⇒ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by ax
c9: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h ⇒ p = ⟨ i , j ⟩ $ by ax
c10: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h ⇒ i ∊ C $ by ax
c11: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h ⇒ j ∊ ap k i $ by weaken [b6]
c12: $ … ⇒ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_intro [c11, c8]
c13: $ … ⇒ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_intro [c10, c12]
c14: $ … ⇒ p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_intro [c9, c13]
c15: $ … ⇒ ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ex_intro [c14]
c16: $ … ⇒ ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ex_intro [c15]
c17: $ … ⇒ ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ex_intro [c16]
c18: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ex_intro [c17]
c19: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ex_elim [c7, c18]
c20: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) ⇒ ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) $ by ax
c21: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ex_elim [c20, c19]
c22: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) ⇒ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) $ by ax
c23: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ex_elim [c22, c21]
d1: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) , e ∊ (⟦ x / i ⟧ B) , y ∊ e ⇒ e ∊ (⟦ x / i ⟧ B) $ by ax
d2: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) , e ∊ (⟦ x / i ⟧ B) , y ∊ e ⇒ y ∊ e $ by ax
d3: $ … ⇒ e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e $ by and_intro [d1, d2]
d4: $ … ⇒ ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) $ by ex_intro [d3]
d5: $ … ⇒ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) $ by ex_intro [d4]
d6: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) , e ∊ (⟦ x / i ⟧ B) , y ∊ e ⇒ ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) $ by ax
d7: $ … ⇒ ⊥ $ by not_elim [d6, d5]
d8: $ … ⇒ e = ∅ $ by empty_eq_intro [d7]
d9: $ … ⇒ e ∊ csn ∅ $ by csn_intro [d8]
d10: $ … ⇒ (⟦ x / i ⟧ B) ⊆ csn ∅ $ by subset_intro [d9]
d11: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) ⇒ ∀ x (x ∊ C → B ⊆ csn ∅ → A ⊆ csn ∅) $ by weaken [#4]
d12: $ … ⇒ i ∊ C → (⟦ x / i ⟧ B) ⊆ csn ∅ → (⟦ x / i ⟧ A) ⊆ csn ∅ $ by all_elim [d11]
d13: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) ⇒ i ∊ C $ by ax
d14: $ … ⇒ (⟦ x / i ⟧ B) ⊆ csn ∅ → (⟦ x / i ⟧ A) ⊆ csn ∅ $ by imp_elim [d12, d13]
d15: $ … ⇒ (⟦ x / i ⟧ A) ⊆ csn ∅ $ by imp_elim [d14, d10]
d16: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) ⇒ ap k i ∈ (⟦ x / i ⟧ A) $ by weaken [b8]
d17: $ … ⇒ ap k i ∈ csn ∅ $ by wcel_subset [d15, d16]
d18: $ … ⇒ ap k i = ∅ $ by csn_elim_c [d17]
d19: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) , ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) ⇒ j ∊ ap k i $ by weaken [b6]
d20: $ … ⇒ ⊥ $ by empty_eq_elim [d18, d19]
d21: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by bot_elim [d20]
e1: $ G , p = ⟨ i , j ⟩ , i ∊ C , j ∊ ⋃ (⟦ x / i ⟧ A) ⇒ (∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e)) ∨ ¬ ∃ e ∃ y (e ∊ (⟦ x / i ⟧ B) ∧ y ∊ e) $ by excluded_middle
e2: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by or_elim [e1, c23, d21]
e3: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by clam_elim_mem [a2, e2]

lemma b14_cpi_e {x v: set} (G: hyps x) (C: class) (A B: class x): $ G ⇒ isset C $ > $ G ⇒ (∃ v (v ∊ cpi x C A)) → ∃ v (v ∊ cpi x C B) $ > $ G ⇒ ∀ x (x ∊ C → B ⊆ csn ∅ → A ⊆ csn ∅) $ > $ G ⇒ cpi x C B ⊆ csn ∅ → cpi x C A ⊆ csn ∅ $
----
a1: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A ⇒ k ∊ cpi x C A $ by ax
a2: $ … ⇒ ∃ v (v ∊ cpi x C A) $ by ex_intro [a1]
a3: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A ⇒ (∃ v (v ∊ cpi x C A)) → ∃ v (v ∊ cpi x C B) $ by weaken [#2]
a4: $ … ⇒ ∃ v (v ∊ cpi x C B) $ by imp_elim [a3, a2]
b1: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ isset C $ by weaken [#1]
b2: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ k ∊ cpi x C A $ by ax
b3: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ v ∊ cpi x C B $ by ax
b4: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ ∀ x (x ∊ C → B ⊆ csn ∅ → A ⊆ csn ∅) $ by weaken [#3]
b5: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ p ∊ k $ by ax
b6: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by b14_cpi_pt [b1, b2, b3, b4, b5]
c1: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h ⇒ p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by ax
c2: $ … ⇒ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_elim_r [c1]
c3: $ … ⇒ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_elim_r [c2]
c4: $ … ⇒ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_elim_r [c3]
c5: $ … ⇒ h ∊ cpi x C B $ by and_elim_l [c4]
c6: $ … ⇒ ⟨ i , y ⟩ ∈ h $ by and_elim_r [c4]
c7: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h ⇒ cpi x C B ⊆ csn ∅ $ by ax
c8: $ … ⇒ h ∊ csn ∅ $ by subset_elim [c7, c5]
c9: $ … ⇒ h = ∅ $ by csn_elim [c8]
c10: $ … ⇒ ⟨ i , y ⟩ ∈ ∅ $ by wcel_eq_r [c9, c6]
c11: $ d = ⟨ i , y ⟩ , d ∊ ∅ ⇒ d ∊ ∅ $ by ax
c12: $ … ⇒ ⊥ $ by empty_elim [c11]
c13: $ … ⇒ ⊥ $ by wcel_elim [c10, c12]
c14: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) ⇒ ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ax
c15: $ … ⇒ ⊥ $ by ex_elim [c14, c13]
c16: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) ⇒ ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ax
c17: $ … ⇒ ⊥ $ by ex_elim [c16, c15]
c18: $ G , cpi x C B ⊆ csn ∅ , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) ⇒ ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ax
c19: $ … ⇒ ⊥ $ by ex_elim [c18, c17]
c20: $ … ⇒ ⊥ $ by ex_elim [b6, c19]
c21: $ … ⇒ k = ∅ $ by empty_eq_intro [c20]
c22: $ … ⇒ k ∊ csn ∅ $ by csn_intro [c21]
c23: $ … ⇒ k ∊ csn ∅ $ by ex_elim [a4, c22]
c24: $ … ⇒ cpi x C A ⊆ csn ∅ $ by subset_intro [c23]
c25: $ … ⇒ cpi x C B ⊆ csn ∅ → cpi x C A ⊆ csn ∅ $ by imp_intro [c24]

lemma b14_un_in (G: hyps) (P X: class) (h: set): $ G ⇒ X ∈ h $ > $ G ⇒ h ∊ P $ > $ G ⇒ X ∈ ⋃ P $
----
a1: $ G , d = X , d ∊ h ⇒ d ∊ h $ by ax
a2: $ G , d = X , d ∊ h ⇒ h ∊ P $ by weaken [#2]
a3: $ … ⇒ d ∊ ⋃ P $ by cuni_intro [a1, a2]
a4: $ … ⇒ d ∈ ⋃ P $ by welc_wcel [a3]
a5: $ G , d = X , d ∊ h ⇒ d = X $ by ax
a6: $ … ⇒ X ∈ ⋃ P $ by wcel_eq_l [a5, a4]
a7: $ … ⇒ X ∈ ⋃ P $ by wcel_elim [#1, a6]

lemma b14_cpi_dom {x z: set} (G: hyps x) (N C: class) (A B: class x): $ G ⇒ universe N $ > $ G ⇒ isset C $ > $ G ⇒ ∀ x (x ∊ C → B ∈ N → A ∈ N) $ > $ G ⇒ cpi x C B ∈ N $ > $ G ⇒ ∀ z (z ∊ cdm (⋃ (cpi x C B)) → (⟦ x / z ⟧ A) ∈ N) $
----
a1: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h ⇒ d = ⟨ z , y ⟩ $ by ax
a2: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h ⇒ d ∊ h $ by ax
a3: $ … ⇒ d ∈ h $ by welc_wcel [a2]
a4: $ … ⇒ ⟨ z , y ⟩ ∈ h $ by wcel_eq_l [a1, a3]
a5: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h ⇒ h ∊ cpi x C B $ by ax
a6: $ … ⇒ h ⊆ clam x C (⋃ B) $ by cpi_elim_sub [a5]
a7: $ … ⇒ ⟨ z , y ⟩ ∈ clam x C (⋃ B) $ by wcel_subset [a6, a4]
a8: $ … ⇒ z ∊ C ∧ y ∊ ⋃ (⟦ x / z ⟧ B) $ by clam_elim [a7]
a9: $ … ⇒ z ∊ C $ by and_elim_l [a8]
b1: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h , e ∊ (⟦ x / z ⟧ B) , j ∊ e ⇒ isset C $ by weaken [#2]
b2: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h , e ∊ (⟦ x / z ⟧ B) , j ∊ e ⇒ h ∊ cpi x C B $ by ax
b3: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h , e ∊ (⟦ x / z ⟧ B) , j ∊ e ⇒ z ∊ C $ by weaken [a9]
b4: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h , e ∊ (⟦ x / z ⟧ B) , j ∊ e ⇒ e ∊ (⟦ x / z ⟧ B) $ by ax
b5: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h , e ∊ (⟦ x / z ⟧ B) , j ∊ e ⇒ j ∊ e $ by ax
b6: $ … ⇒ ∃ m (m ∊ cpi x C B ∧ ⟨ z , j ⟩ ∈ m) $ by b14_mod [b1, b2, b3, b4, b5]
b7: $ m ∊ cpi x C B ∧ ⟨ z , j ⟩ ∈ m ⇒ m ∊ cpi x C B ∧ ⟨ z , j ⟩ ∈ m $ by ax
b8: $ … ⇒ m ∊ cpi x C B $ by and_elim_l [b7]
b9: $ … ⇒ ⟨ z , j ⟩ ∈ m $ by and_elim_r [b7]
b10: $ … ⇒ ⟨ z , j ⟩ ∈ ⋃ (cpi x C B) $ by b14_un_in [b9, b8]
b11: $ … ⇒ j ∊ crn (⋃ (cpi x C B)) $ by crn_intro [b10]
b12: $ … ⇒ j ∊ crn (⋃ (cpi x C B)) $ by ex_elim [b6, b11]
b13: $ … ⇒ e ⊆ crn (⋃ (cpi x C B)) $ by subset_intro [b12]
b14: $ … ⇒ e ∊ 𝒫 (crn (⋃ (cpi x C B))) $ by cpw_intro [b13]
b15: $ … ⇒ (⟦ x / z ⟧ B) ⊆ 𝒫 (crn (⋃ (cpi x C B))) $ by subset_intro [b14]
c1: $ G ⇒ ⋃ (cpi x C B) ∈ N $ by universe_cuni_c [#1, #4]
c2: $ … ⇒ crn (⋃ (cpi x C B)) ∈ N $ by b8_crn_u [#1, c1]
c3: $ … ⇒ 𝒫 (crn (⋃ (cpi x C B))) ∈ N $ by universe_cpw_c [#1, c2]
c4: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h ⇒ 𝒫 (crn (⋃ (cpi x C B))) ∈ N $ by weaken [c3]
c5: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h ⇒ universe N $ by weaken [#1]
c6: $ … ⇒ (⟦ x / z ⟧ B) ∈ N $ by universe_subset_c [c5, c4, b15]
c7: $ G , d = ⟨ z , y ⟩ , h ∊ cpi x C B , d ∊ h ⇒ ∀ x (x ∊ C → B ∈ N → A ∈ N) $ by weaken [#3]
c8: $ … ⇒ z ∊ C → (⟦ x / z ⟧ B) ∈ N → (⟦ x / z ⟧ A) ∈ N $ by all_elim [c7]
c9: $ … ⇒ (⟦ x / z ⟧ B) ∈ N → (⟦ x / z ⟧ A) ∈ N $ by imp_elim [c8, a9]
c10: $ … ⇒ (⟦ x / z ⟧ A) ∈ N $ by imp_elim [c9, c6]
d1: $ G , d = ⟨ z , y ⟩ , d ∊ ⋃ (cpi x C B) ⇒ d ∊ ⋃ (cpi x C B) $ by ax
d2: $ … ⇒ (⟦ x / z ⟧ A) ∈ N $ by cuni_elim [d1, c10]
d3: $ G , ⟨ z , y ⟩ ∈ ⋃ (cpi x C B) ⇒ ⟨ z , y ⟩ ∈ ⋃ (cpi x C B) $ by ax
d4: $ … ⇒ (⟦ x / z ⟧ A) ∈ N $ by wcel_elim [d3, d2]
d5: $ G , z ∊ cdm (⋃ (cpi x C B)) ⇒ z ∊ cdm (⋃ (cpi x C B)) $ by ax
d6: $ … ⇒ (⟦ x / z ⟧ A) ∈ N $ by cdm_elim [d5, d4]
d7: $ … ⇒ z ∊ cdm (⋃ (cpi x C B)) → (⟦ x / z ⟧ A) ∈ N $ by imp_intro [d6]
d8: $ … ⇒ ∀ z (z ∊ cdm (⋃ (cpi x C B)) → (⟦ x / z ⟧ A) ∈ N) $ by all_intro [d7]

lemma b14_cpi_n {x v: set} (G: hyps) (N C: class) (A B: class x): $ G ⇒ universe N $ > $ G ⇒ isset C $ > $ G ⇒ (∃ v (v ∊ cpi x C A)) → ∃ v (v ∊ cpi x C B) $ > $ G ⇒ ∀ x (x ∊ C → B ⊆ csn ∅ → A ⊆ csn ∅) $ > $ G ⇒ ∀ x (x ∊ C → B ∈ N → A ∈ N) $ > $ G ⇒ cpi x C B ∈ N → cpi x C A ∈ N $
----
a1: $ G , cpi x C B ∈ N ⇒ cpi x C B ∈ N $ by ax
a2: $ G , cpi x C B ∈ N ⇒ universe N $ by weaken [#1]
a3: $ G , cpi x C B ∈ N ⇒ isset C $ by weaken [#2]
a4: $ G , cpi x C B ∈ N ⇒ ∀ x (x ∊ C → B ∈ N → A ∈ N) $ by weaken [#5]
a5: $ … ⇒ ∀ z (z ∊ cdm (⋃ (cpi x C B)) → (⟦ x / z ⟧ A) ∈ N) $ by b14_cpi_dom [a2, a3, a4, a1]
a6: $ … ⇒ ⋃ (cpi x C B) ∈ N $ by universe_cuni_c [a2, a1]
a7: $ … ⇒ cdm (⋃ (cpi x C B)) ∈ N $ by b3_cdm_u [a2, a6]
a8: $ … ⇒ ⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B)))) ∈ N $ by b8_cuop [a2, a7, a5]
a9: $ … ⇒ ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) ∈ N $ by universe_cuni_c [a2, a8]
a10: $ … ⇒ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) ∈ N $ by universe_cxp_c [a2, a7, a9]
a11: $ … ⇒ 𝒫 (cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B)))))) ∈ N $ by universe_cpw_c [a2, a10]
b1: $ G , cpi x C B ∈ N , k ∊ cpi x C A ⇒ k ∊ cpi x C A $ by ax
b2: $ … ⇒ ∃ v (v ∊ cpi x C A) $ by ex_intro [b1]
b3: $ G , cpi x C B ∈ N , k ∊ cpi x C A ⇒ (∃ v (v ∊ cpi x C A)) → ∃ v (v ∊ cpi x C B) $ by weaken [#3]
b4: $ … ⇒ ∃ v (v ∊ cpi x C B) $ by imp_elim [b3, b2]
b5: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ isset C $ by weaken [#2]
b6: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ k ∊ cpi x C A $ by ax
b7: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ v ∊ cpi x C B $ by ax
b8: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ ∀ x (x ∊ C → B ⊆ csn ∅ → A ⊆ csn ∅) $ by weaken [#4]
b9: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k ⇒ p ∊ k $ by ax
b10: $ … ⇒ ∃ i ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by b14_cpi_pt [b5, b6, b7, b8, b9]
c1: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h ⇒ p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by ax
c1a: $ … ⇒ p = ⟨ i , j ⟩ $ by and_elim_l [c1]
c2: $ … ⇒ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_elim_r [c1]
c2a: $ … ⇒ i ∊ C $ by and_elim_l [c2]
c3: $ … ⇒ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_elim_r [c2]
c3a: $ … ⇒ j ∊ ap k i $ by and_elim_l [c3]
c4: $ … ⇒ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h $ by and_elim_r [c3]
c5: $ … ⇒ h ∊ cpi x C B $ by and_elim_l [c4]
c6: $ … ⇒ ⟨ i , y ⟩ ∈ h $ by and_elim_r [c4]
c7: $ … ⇒ ⟨ i , y ⟩ ∈ ⋃ (cpi x C B) $ by b14_un_in [c6, c5]
c8: $ … ⇒ i ∊ cdm (⋃ (cpi x C B)) $ by cdm_intro [c7]
c9: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h ⇒ k ∊ cpi x C A $ by ax
c10: $ … ⇒ ap k i ∈ (⟦ x / i ⟧ A) $ by cpi_elim_ap [c9, c2a]
c11: $ … ⇒ isset (ap k i) $ by wcel_isset [c10]
d1: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h , o = ap k i ⇒ o = ap k i $ by ax
d2: $ … ⇒ ap k i = o $ by eq_sym [d1]
d3: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h , o = ap k i ⇒ ap k i ∈ (⟦ x / i ⟧ A) $ by weaken [c10]
d4: $ … ⇒ o ∈ (⟦ x / i ⟧ A) $ by wcel_eq_l [d2, d3]
d5: $ … ⇒ o ∊ (⟦ x / i ⟧ A) $ by wcel_welc [d4]
d5a: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h , o = ap k i ⇒ o ∊ (⟦ z / i ⟧ (⟦ x / z ⟧ A)) $ by weaken [d5]
d7: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h , o = ap k i ⇒ i ∊ cdm (⋃ (cpi x C B)) $ by weaken [c8]
d6: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h , o = ap k i ⇒ ∀ z (z ∊ cdm (⋃ (cpi x C B)) → (⟦ x / z ⟧ A) ∈ N) $ by weaken [a5]
d6b: $ … ⇒ i ∊ cdm (⋃ (cpi x C B)) → (⟦ z / i ⟧ (⟦ x / z ⟧ A)) ∈ N $ by all_elim [d6]
d6c: $ … ⇒ (⟦ z / i ⟧ (⟦ x / z ⟧ A)) ∈ N $ by imp_elim [d6b, d7]
d6a: $ … ⇒ isset (⟦ z / i ⟧ (⟦ x / z ⟧ A)) $ by wcel_isset [d6c]
d8: $ … ⇒ o ∊ ⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B)))) $ by b8_cu_in [d7, d5a, d6a]
d9: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h , o = ap k i ⇒ j ∊ ap k i $ by weaken [c3a]
d10: $ … ⇒ j ∊ o $ by welc_eq [d2, d9]
d11: $ … ⇒ j ∊ ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by cuni_intro [d10, d8]
d12: $ … ⇒ ⟨ i , j ⟩ ∈ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by cxp_intro [d7, d11]
d13: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h , o = ap k i ⇒ p = ⟨ i , j ⟩ $ by weaken [c1a]
d14: $ … ⇒ ⟨ i , j ⟩ = p $ by eq_sym [d13]
d15: $ … ⇒ p ∈ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by wcel_eq_l [d14, d12]
d16: $ … ⇒ p ∊ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by wcel_welc [d15]
d17: $ … ⇒ p ∊ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by isset_elim [c11, d16]
e1: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) ⇒ ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ax
e2: $ … ⇒ p ∊ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by ex_elim [e1, d17]
e3: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) ⇒ ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ax
e4: $ … ⇒ p ∊ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by ex_elim [e3, e2]
e5: $ G , cpi x C B ∈ N , k ∊ cpi x C A , v ∊ cpi x C B , p ∊ k , ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) ⇒ ∃ j ∃ h ∃ y (p = ⟨ i , j ⟩ ∧ i ∊ C ∧ j ∊ ap k i ∧ h ∊ cpi x C B ∧ ⟨ i , y ⟩ ∈ h) $ by ax
e6: $ … ⇒ p ∊ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by ex_elim [e5, e4]
e7: $ … ⇒ p ∊ cdm (⋃ (cpi x C B)) × ⋃ (⋃ (img (cgr z (⟦ x / z ⟧ A)) (cdm (⋃ (cpi x C B))))) $ by ex_elim [b10, e6]
