c29: $ G , r = nest m e0 , r ∊ ity u E d kk w , ⟨ kk , ⟨ a , i ⟩ ⟩ ∈ ifam u E d w , (iprop d kk w ∧ r = nest a ∅) ∨ (¬ iprop d kk w ∧ r = nest a i) , iprt d p t , ityf d kk x1 , q ∊ esat u E p w , ⟨ x5 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E x1 w q , a = scat x5 q , ¬ iprop d kk w ∧ r = nest a i ⇒ ⟨ kk , ⟨ a , i ⟩ ⟩ ∈ ifam u E d w $ by ax
c30: $ G , r = nest m e0 , r ∊ ity u E d kk w , ⟨ kk , ⟨ a , i ⟩ ⟩ ∈ ifam u E d w , (iprop d kk w ∧ r = nest a ∅) ∨ (¬ iprop d kk w ∧ r = nest a i) , iprt d p t , ityf d kk x1 , q ∊ esat u E p w , ⟨ x5 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E x1 w q , a = scat x5 q , ¬ iprop d kk w ∧ r = nest a i ⇒ ⟨ kk , ⟨ m , e0 ⟩ ⟩ ∈ ifam u E d w $ by wcel_eq_l [c28, c29]
c31: $ G , r = nest m e0 , r ∊ ity u E d kk w , ⟨ kk , ⟨ a , i ⟩ ⟩ ∈ ifam u E d w , (iprop d kk w ∧ r = nest a ∅) ∨ (¬ iprop d kk w ∧ r = nest a i) , iprt d p t , ityf d kk x1 , q ∊ esat u E p w , ⟨ x5 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E x1 w q , a = scat x5 q , ¬ iprop d kk w ∧ r = nest a i ⇒ ¬ iprop d kk w ∧ ⟨ kk , ⟨ m , e0 ⟩ ⟩ ∈ ifam u E d w $ by and_intro [c1, c30]
c32: $ G , r = nest m e0 , r ∊ ity u E d kk w , ⟨ kk , ⟨ a , i ⟩ ⟩ ∈ ifam u E d w , (iprop d kk w ∧ r = nest a ∅) ∨ (¬ iprop d kk w ∧ r = nest a i) , iprt d p t , ityf d kk x1 , q ∊ esat u E p w , ⟨ x5 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E x1 w q , a = scat x5 q , ¬ iprop d kk w ∧ r = nest a i ⇒ (iprop d kk w ∧ e0 = ∅) ∨ (¬ iprop d kk w ∧ ⟨ kk , ⟨ m , e0 ⟩ ⟩ ∈ ifam u E d w) $ by or_intro_r [c31]
d1: $ G , r = nest m e0 , r ∊ ity u E d kk w , ⟨ kk , ⟨ a , i ⟩ ⟩ ∈ ifam u E d w , (iprop d kk w ∧ r = nest a ∅) ∨ (¬ iprop d kk w ∧ r = nest a i) , iprt d p t , ityf d kk x1 , q ∊ esat u E p w , ⟨ x5 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E x1 w q , a = scat x5 q ⇒ (iprop d kk w ∧ e0 = ∅) ∨ (¬ iprop d kk w ∧ ⟨ kk , ⟨ m , e0 ⟩ ⟩ ∈ ifam u E d w) $ by or_elim [a21, b20, c32]
d2: $ G , r = nest m e0 , r ∊ ity u E d kk w ⇒ d ∈ trees ω $ by weaken [#1]
d3: $ G , r = nest m e0 , r ∊ ity u E d kk w ⇒ w ∈ lvals $ by weaken [#2]
d4: $ G , r = nest m e0 , r ∊ ity u E d kk w ⇒ isup (ifam u E d w) (csn (scons ∅ ∅)) ⊆ itc u E d w $ by weaken [#3]
d5: $ G , r = nest m e0 , r ∊ ity u E d kk w ⇒ r ∊ ity u E d kk w $ by ax
d6: $ G , r = nest m e0 , r ∊ ity u E d kk w ⇒ (iprop d kk w ∧ e0 = ∅) ∨ (¬ iprop d kk w ∧ ⟨ kk , ⟨ m , e0 ⟩ ⟩ ∈ ifam u E d w) $ by b3_ity_elim [d2, d3, d4, d5, d1]
d7: $ G ⇒ (iprop d kk w ∧ e0 = ∅) ∨ (¬ iprop d kk w ∧ ⟨ kk , ⟨ m , e0 ⟩ ⟩ ∈ ifam u E d w) $ by wcel_elim [g1, d6]

lemma b3_ity_ipi (G: hyps) (H J C R: class) (u d w kk b c f k l: set): $ G ⇒ iwf u H J C d w R $ > $ G ⇒ icwf J d $ > $ G ⇒ iprt d b c $ > $ G ⇒ ityf d kk f $ > $ G ⇒ ra_isort f k l ∈ lrel $ > $ G ⇒ lv l w = ilev d w $ > $ G ⇒ ilev d w ∈ ω $ > $ G ⇒ ity u (dnf u (mcv H)) d kk w ∈ ipi u (dnf u (mcv H)) b f w $
----
g1: $ G ⇒ uadm u $ by iwf_uadm [#1]
g2: $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ by iwf_sort [#1]
g3: $ G ⇒ w ∈ lvals $ by iwf_lvals [#1]
g4: $ G ⇒ w ∊ lvals $ by wcel_welc [g3]
g5: $ G ⇒ sig lsig lopen $ by lsig_sig
g6: $ G ⇒ ofsort lsig lopen ks_ind ⊆ trees ω $ by ofsort_trees [g5]
g7: $ G ⇒ d ∈ trees ω $ by wcel_subset [g6, g2]
g8: $ G ⇒ isup (ifam u (dnf u (mcv H)) d w) (csn (scons ∅ ∅)) ⊆ itc u (dnf u (mcv H)) d w $ by ifam_supp [#1]
g9: $ G ⇒ isup (ifam u (dnf u (mcv H)) d w) (csn (scons ∅ ∅)) ⊆ ijs u (dnf u (mcv H)) d w $ by ifam_ijs [#1]
g10: $ G ⇒ f ∈ ofsort lsig lopen ks_expr $ by ityf_sort [g2, #4]
g11: $ G ⇒ ofsort lsig lopen ks_expr ⊆ trees ω $ by ofsort_trees [g5]
g12: $ G ⇒ f ∈ trees ω $ by wcel_subset [g11, g10]
g13: $ G ⇒ universe u $ by uadm_universe [g1]
g14: $ G ⇒ itc u (dnf u (mcv H)) d w ∈ u $ by itc_universe [g1, g2, g3]
g15: $ G ⇒ ijs u (dnf u (mcv H)) d w ⊆ itc u (dnf u (mcv H)) d w $ by ijs_sub
g16: $ G ⇒ ijs u (dnf u (mcv H)) d w ∈ u $ by universe_subset_c [g13, g14, g15]
g17: $ G ⇒ itc u (dnf u (mcv H)) d w ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by itc_sub
g18: $ G ⇒ ijs u (dnf u (mcv H)) d w ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by subset_trans [g15, g17]
g19: $ G ⇒ isset (ity u (dnf u (mcv H)) d kk w) $ by ity_set
z7: $ G ⇒ ity u (dnf u (mcv H)) d kk w ∈ ipi u (dnf u (mcv H)) b f w ↔ (ity u (dnf u (mcv H)) d kk w ⊆ {e | ∃ m ∃ n (m ∊ esat u (dnf u (mcv H)) b w ∧ e = nest m n)} ∧ ∀ q (q ∊ esat u (dnf u (mcv H)) b w → apn (ity u (dnf u (mcv H)) d kk w) q ∈ da (fv (dnf u (mcv H)) f) w q)) $ by ipi_wcel [g19]
s1: $ G , r ∊ ity u (dnf u (mcv H)) d kk w ⇒ d ∈ trees ω $ by weaken [g7]
s2: $ G , r ∊ ity u (dnf u (mcv H)) d kk w ⇒ w ∈ lvals $ by weaken [g3]
s3: $ G , r ∊ ity u (dnf u (mcv H)) d kk w ⇒ isup (ifam u (dnf u (mcv H)) d w) (csn (scons ∅ ∅)) ⊆ itc u (dnf u (mcv H)) d w $ by weaken [g8]
s4: $ G , r ∊ ity u (dnf u (mcv H)) d kk w ⇒ iprt d b c $ by weaken [#3]
s5: $ G , r ∊ ity u (dnf u (mcv H)) d kk w ⇒ r ∊ ity u (dnf u (mcv H)) d kk w $ by ax
s6: $ G , r ∊ ity u (dnf u (mcv H)) d kk w ⇒ r ∊ {e | ∃ m ∃ n (m ∊ esat u (dnf u (mcv H)) b w ∧ e = nest m n)} $ by b3_ity_ps [s1, s2, s3, s4, s5]
s7: $ G ⇒ ity u (dnf u (mcv H)) d kk w ⊆ {e | ∃ m ∃ n (m ∊ esat u (dnf u (mcv H)) b w ∧ e = nest m n)} $ by subset_intro [s6]
f1: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ q ∊ esat u (dnf u (mcv H)) b w $ by ax
f2: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ esat u (dnf u (mcv H)) b w ⊆ fseq u $ by esat_fseq
f3: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ q ∊ fseq u $ by subset_elim [f2, f1]
f4: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ q ∈ fseq u $ by welc_wcel [f3]
f5: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ isset (ity u (dnf u (mcv H)) d kk w) $ by weaken [g19]
f6: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ isset (apn (ity u (dnf u (mcv H)) d kk w) q) $ by b3_apn_set [f5, f3]
f7: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ uadm u $ by weaken [g1]
f8: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ ra_isort f k l ∈ lrel $ by weaken [#5]
f9: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ f ∈ ofsort lsig lopen ks_expr $ by weaken [g10]
f10: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ w ∈ lvals $ by weaken [g3]
f11: $ G , q ∊ esat u (dnf u (mcv H)) b w ⇒ apn (ity u (dnf u (mcv H)) d kk w) q ∈ dt u (mcv H) f w q ↔ (apn (ity u (dnf u (mcv H)) d kk w) q ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q) → apn (apn (ity u (dnf u (mcv H)) d kk w) q) x ∈ fv uni (lv l w))) $ by isort_wcel [f7, f8, f9, f10, f4, f6]
f12a: $ G , q ∊ esat u (dnf u (mcv H)) b w , e ∊ apn (ity u (dnf u (mcv H)) d kk w) q ⇒ d ∈ trees ω $ by weaken [g7]
f12b: $ G , q ∊ esat u (dnf u (mcv H)) b w , e ∊ apn (ity u (dnf u (mcv H)) d kk w) q ⇒ w ∈ lvals $ by weaken [g3]
f12c: $ G , q ∊ esat u (dnf u (mcv H)) b w , e ∊ apn (ity u (dnf u (mcv H)) d kk w) q ⇒ isup (ifam u (dnf u (mcv H)) d w) (csn (scons ∅ ∅)) ⊆ itc u (dnf u (mcv H)) d w $ by weaken [g8]
