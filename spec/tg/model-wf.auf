--| Sequences of length `N` are determined by their nest over `⟨ ∅ , ∅ ⟩`.
def b11_sp_nq (N: class) (.a .b: set): fml = $ ∀ a ∀ b (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = N → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) $

--| @congr
lemma b11_sp_nq_congr (A B: class): $ A ≐ B $ > $ b11_sp_nq A ⟺ b11_sp_nq B $
----
c1: $ cdm a ≐ cdm a $ by ceqt_refl
c2: $ (cdm a = A) ⟺ (cdm a = B) $ by ceq_congr [c1, #1]
c3: $ (nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) ⟺ (nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) $ by iff_refl
c4: $ (cdm a = A → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) ⟺ (cdm a = B → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) $ by im_congr [c2, c3]
c5: $ (b ∊ fseq b7_V) ⟺ (b ∊ fseq b7_V) $ by iff_refl
c6: $ (b ∊ fseq b7_V → cdm a = A → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) ⟺ (b ∊ fseq b7_V → cdm a = B → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) $ by im_congr [c5, c4]
c7: $ (a ∊ fseq b7_V) ⟺ (a ∊ fseq b7_V) $ by iff_refl
c8: $ (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = A → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) ⟺ (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = B → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) $ by im_congr [c7, c6]
c9: $ (∀ b (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = A → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b)) ⟺ (∀ b (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = B → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b)) $ by all_congr [c8]
c10: $ (∀ a ∀ b (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = A → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b)) ⟺ (∀ a ∀ b (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = B → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b)) $ by all_congr [c9]

--| @rewrite
lemma b11_sp_sb_nq {z: set} (t: set z) (A: class z): $ [z/t] (b11_sp_nq A) ⟺ b11_sp_nq (⟦ z / t ⟧ A) $
----
l1: $ [z/t] (∀ a ∀ b (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = A → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b)) ⟺ ∀ a ∀ b (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = (⟦ z / t ⟧ A) → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) $ by iff_refl

