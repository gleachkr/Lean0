lemma b3_ity_ps {e m n: set} (G: hyps) (E: class) (u d w kk b c r: set): $ G ⇒ d ∈ trees ω $ > $ G ⇒ w ∈ lvals $ > $ G ⇒ isup (ifam u E d w) (csn (scons ∅ ∅)) ⊆ itc u E d w $ > $ G ⇒ iprt d b c $ > $ G ⇒ r ∊ ity u E d kk w $ > $ G ⇒ r ∊ {e | ∃ m ∃ n (m ∊ esat u E b w ∧ e = nest m n)} $
