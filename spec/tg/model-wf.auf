v2d: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ fv nvf k = cdm p $ by eq_sym [f9]
v2: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ fv nvf x1 = cdm p $ by eq_trans [v2c, v2d]
v3: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ fv nvf x3 ⊆ cdm p $ by subset_eq_r [v2, v1]
g1: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ i ∊ fv nvf x3 $ by ax
g2: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv nvf x3 ⊆ cdm p $ by weaken [v3]
g3: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ i ∊ cdm p $ by subset_elim [g2, g1]
g4: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ p ∊ fseq u $ by weaken [f8]
g5: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ d ∊ fseq u $ by weaken [dfw]
g6: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ s ∊ fseq u $ by weaken [f4]
g7: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ r = scat p d $ by weaken [rd]
g8: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ o = scat p s $ by weaken [f11]
g9: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ i = i $ by eq_refl
g10: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv r i = fv (scat p d) i $ by fv_eq [g7, g9]
g11: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv (scat p d) i = fv p i $ by scat_fv_l [g4, g5, g3]
g12: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv o i = fv (scat p s) i $ by fv_eq [g8, g9]
g13: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv (scat p s) i = fv p i $ by scat_fv_l [g4, g6, g3]
g14: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv r i = fv p i $ by eq_trans [g10, g11]
g15: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv o i = fv p i $ by eq_trans [g12, g13]
g16: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv p i = fv o i $ by eq_sym [g15]
g17: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s , i ∊ fv nvf x3 ⇒ fv r i = fv o i $ by eq_trans [g14, g16]
g18: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ i ∊ fv nvf x3 → fv r i = fv o i $ by imp_intro [g17]
g19: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ ∀ i (i ∊ fv nvf x3 → fv r i = fv o i) $ by all_intro [g18]
c1: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ etel u (dnf u M) h w r = etel u (dnf u M) h w o $ by lrel_closed_etel [q5, th, f1, rv, ov, g19]
ww: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ w = w $ by eq_refl
rr: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ r = r $ by eq_refl
oo: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ o = o $ by eq_refl
w3: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ etel u (dnf u M) e w r = etel u (dnf u M) h w r $ by etel_eq [q4, ww, rr]
w4: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ etel u (dnf u M) z w o = etel u (dnf u M) h w o $ by etel_eq [q3, ww, oo]
c2: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ etel u (dnf u M) e w r = etel u (dnf u M) h w o $ by eq_trans [w3, c1]
c3: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ etel u (dnf u M) h w o = etel u (dnf u M) z w o $ by eq_sym [w4]
fin: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel , d = scat q s ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by eq_trans [c2, c3]
cq2: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ q ∊ fseq u $ by weaken [#2]
cq4: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ s ∊ fseq u $ by weaken [#4]
cq5: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ q ∈ fseq u $ by welc_wcel [cq2]
cq6: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ s ∈ fseq u $ by welc_wcel [cq4]
cq7: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ scat q s ∈ fseq u $ by scat_fseq_c [cq5, cq6]
z0: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ isset (scat q s) $ by wcel_isset [cq7]
fin2: $ H , n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by isset_elim [z0, fin]
end: $ H ⇒ (n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by imp_intro [fin2]

lemma b5_exi {x: set} (G: hyps) (p: fml x) (c: fml): $ G ⇒ ∀ x (p → c) $ > $ G ⇒ (∃ x p) → c $
----
l1: $ G , ∃ x p ⇒ ∃ x p $ by ax
l2: $ G , p ⇒ ∀ x (p → c) $ by weaken [#1]
l3: $ G , p ⇒ p → c $ by all_elim [l2]
l4: $ G , p ⇒ p $ by ax
l5: $ G , p ⇒ c $ by imp_elim [l3, l4]
l6: $ G , ∃ x p ⇒ c $ by ex_elim [l1, l5]
l7: $ G ⇒ (∃ x p) → c $ by imp_intro [l6]

lemma b5_or8 (G: hyps) (p1 p2 p3 p4 p5 p6 p7 p8 c: fml): $ G ⇒ p1 ∨ p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 $ > $ G ⇒ p1 → c $ > $ G ⇒ p2 → c $ > $ G ⇒ p3 → c $ > $ G ⇒ p4 → c $ > $ G ⇒ p5 → c $ > $ G ⇒ p6 → c $ > $ G ⇒ p7 → c $ > $ G ⇒ p8 → c $ > $ G ⇒ c $
----
a1: $ G , p1 ⇒ c $ by imp_use [#2]
a2: $ G , p2 ⇒ c $ by imp_use [#3]
a3: $ G , p3 ⇒ c $ by imp_use [#4]
a4: $ G , p4 ⇒ c $ by imp_use [#5]
a5: $ G , p5 ⇒ c $ by imp_use [#6]
a6: $ G , p6 ⇒ c $ by imp_use [#7]
a7: $ G , p7 ⇒ c $ by imp_use [#8]
a8: $ G , p8 ⇒ c $ by imp_use [#9]
b7: $ G , p7 ∨ p8 ⇒ p7 ∨ p8 $ by ax
b7a: $ G , p7 ∨ p8 , p7 ⇒ c $ by weaken [a7]
b7b: $ G , p7 ∨ p8 , p8 ⇒ c $ by weaken [a8]
c7: $ G , p7 ∨ p8 ⇒ c $ by or_elim [b7, b7a, b7b]
b6: $ G , p6 ∨ p7 ∨ p8 ⇒ p6 ∨ p7 ∨ p8 $ by ax
b6a: $ G , p6 ∨ p7 ∨ p8 , p6 ⇒ c $ by weaken [a6]
b6b: $ G , p6 ∨ p7 ∨ p8 , p7 ∨ p8 ⇒ c $ by weaken [c7]
c6: $ G , p6 ∨ p7 ∨ p8 ⇒ c $ by or_elim [b6, b6a, b6b]
b5: $ G , p5 ∨ p6 ∨ p7 ∨ p8 ⇒ p5 ∨ p6 ∨ p7 ∨ p8 $ by ax
b5a: $ G , p5 ∨ p6 ∨ p7 ∨ p8 , p5 ⇒ c $ by weaken [a5]
b5b: $ G , p5 ∨ p6 ∨ p7 ∨ p8 , p6 ∨ p7 ∨ p8 ⇒ c $ by weaken [c6]
c5: $ G , p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by or_elim [b5, b5a, b5b]
b4: $ G , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 $ by ax
b4a: $ G , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p4 ⇒ c $ by weaken [a4]
b4b: $ G , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by weaken [c5]
c4: $ G , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by or_elim [b4, b4a, b4b]
b3: $ G , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 $ by ax
b3a: $ G , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p3 ⇒ c $ by weaken [a3]
b3b: $ G , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by weaken [c4]
c3: $ G , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by or_elim [b3, b3a, b3b]
b2: $ G , p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 $ by ax
b2a: $ G , p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p2 ⇒ c $ by weaken [a2]
b2b: $ G , p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 , p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by weaken [c3]
c2: $ G , p2 ∨ p3 ∨ p4 ∨ p5 ∨ p6 ∨ p7 ∨ p8 ⇒ c $ by or_elim [b2, b2a, b2b]
b1a: $ G , p1 ⇒ c $ by weaken [a1]
c1: $ G ⇒ c $ by or_elim [#1, b1a, c2]

lemma b5_lift_ind (G: hyps) (M: class) (u w n q s: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ cdm q = fv nvf n $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ trees ω ⊆ b5_lp u M w n q s $
----
g1: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ w ∊ lvals $ by weaken [#1]
g2: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ q ∊ fseq u $ by weaken [#2]
g3: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ cdm q = fv nvf n $ by weaken [#3]
g4: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ s ∊ fseq u $ by weaken [#4]
g5: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ crn j ⊆ b5_lp u M w n q s $ by ax
g6: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ z = ⟨ c , j ⟩ $ by ax
g7: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ ra_lift n k z e ∈ lrel $ by ax
g8: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ p ∊ fseq u $ by ax
g9: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ cdm p = fv nvf k $ by ax
g10: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ r = scat p (scat q s) $ by ax
g11: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ o = scat p s $ by ax
d1: $ G , c ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b5_lp u M w n q s , z = ⟨ c , j ⟩ , ra_lift n k z e ∈ lrel , p ∊ fseq u , cdm p = fv nvf k , r = scat p (scat q s) , o = scat p s ⇒ ∃ x0 ∃ x1 ∃ x2 (n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le x1 x2 ∈ lrel ∧ ra_add x2 x0 x3 ∈ lrel) ∨ ∃ x0 ∃ x1 ∃ x4 (n = x0 ∧ k = x1 ∧ z = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ e = ⟨ kc_srt , scons x4 ∅ ⟩) ∨ ∃ x0 ∃ x1 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (n = x0 ∧ k = x1 ∧ z = ⟨ kc_app , scons x5 (scons x6 ∅) ⟩ ∧ e = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_lift x0 x1 x5 x7 ∈ lrel ∧ ra_lift x0 x1 x6 x8 ∈ lrel) ∨ ∃ x0 ∃ x1 ∃ x9 ∃ b ∃ l ∃ m (n = x0 ∧ k = x1 ∧ z = ⟨ kc_lam , scons x9 (scons b ∅) ⟩ ∧ e = ⟨ kc_lam , scons l (scons m ∅) ⟩ ∧ ra_lift x0 x1 x9 l ∈ lrel ∧ ra_lift x0 ⟨ kc_s , scons x1 ∅ ⟩ b m ∈ lrel) ∨ ∃ x0 ∃ x1 ∃ x9 ∃ b ∃ l ∃ m (n = x0 ∧ k = x1 ∧ z = ⟨ kc_pi , scons x9 (scons b ∅) ⟩ ∧ e = ⟨ kc_pi , scons l (scons m ∅) ⟩ ∧ ra_lift x0 x1 x9 l ∈ lrel ∧ ra_lift x0 ⟨ kc_s , scons x1 ∅ ⟩ b m ∈ lrel) ∨ ∃ x0 ∃ x3 ∃ x1 ∃ h (n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel) ∨ ∃ x0 ∃ x1 ∃ b ∃ x2 ∃ h ∃ v (n = x0 ∧ k = x1 ∧ z = ⟨ kc_proj , scons b (scons x2 (scons h ∅)) ⟩ ∧ e = ⟨ kc_proj , scons b (scons x2 (scons v ∅)) ⟩ ∧ ra_lift x0 x1 h v ∈ lrel) $ by lrel_lift_cases [g7]
