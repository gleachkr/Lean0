lemma b6_si_step (G: hyps) (d n k x j e f: set): $ G ⇒ x ∊ ω $ > $ G ⇒ x ∊ b6_csi d n k $ > $ G ⇒ ra_sinst d j n k e f ∈ lrel $ > $ G ⇒ nadd (fv nvf j) (suc x) = fv nvf n $ > $ G ⇒ j ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ e ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ f ∊ ofsort lsig lopen ks_expr $
----
q1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ∨ ∃ x1 ∃ x5 ∃ x2 ∃ x3 ∃ x4 ∃ x6 ∃ x7 (d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel) $ by lrel_sinst_cases [#3]
q2: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 $ by ax
q3: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ d = x1 $ by and_elim_l [q2]
q4: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 $ by and_elim_r [q2]
q5: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ j = x2 $ by and_elim_l [q4]
q6: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 $ by and_elim_r [q4]
q7: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ n = x2 $ by and_elim_l [q6]
q8: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ k = x3 ∧ e = x4 ∧ f = x4 $ by and_elim_r [q6]
q9: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ k = x3 $ by and_elim_l [q8]
q10: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ e = x4 ∧ f = x4 $ by and_elim_r [q8]
q11: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ e = x4 $ by and_elim_l [q10]
q12: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ f = x4 $ by and_elim_r [q10]
q13: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ nvf = nvf $ by eq_refl
q14: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ functional nvf $ by nvf_functional
q15: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ isset (fv nvf j) $ by fv_set [q14]
q16: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ isset j $ by isset_var
q17: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ fv nvf j ∈ ω $ by nvf_omega [q16]
q18: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ x ∊ ω $ by weaken [#1]
q19: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ x ∈ ω $ by welc_wcel [q18]
q20: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ nadd (fv nvf j) (suc x) = fv nvf n $ by weaken [#4]
q21: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ x2 = n $ by eq_sym [q7]
q22: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ j = n $ by eq_trans [q5, q21]
q23: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ fv nvf j = fv nvf n $ by fv_eq [q13, q22]
q24: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ fv nvf n = fv nvf j $ by eq_sym [q23]
q25: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ nadd (fv nvf j) (suc x) = fv nvf j $ by eq_trans [q20, q24]
q26: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ ⊥ $ by nadd_suc_ne_c [q17, q19, q25]
q27: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ f ∊ ofsort lsig lopen ks_expr $ by bot_elim [q26]
q28: $ G , ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) $ by ax
q29: $ G , ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ f ∊ ofsort lsig lopen ks_expr $ by ex_elim [q28, q27]
q30: $ G , ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) $ by ax
q31: $ G , ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ f ∊ ofsort lsig lopen ks_expr $ by ex_elim [q30, q29]
