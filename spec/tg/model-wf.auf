lemma b14_t13 (G: hyps) (D: class) (t2 t12 t10 t13: set): $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ ra_sinst D ⟨ kc_nz , ∅ ⟩ t2 t12 t10 t13 ∈ lrel $ > $ G ⇒ t13 ∈ trees ω $
