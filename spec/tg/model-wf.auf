q36: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ q ∊ esat u E2 T w $ by and_elim_l [q35]
q37: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ x ∊ da (fv E2 A) w q ∧ z = scons x q $ by and_elim_r [q35]
q38: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ x ∊ da (fv E2 A) w q $ by and_elim_l [q37]
q39: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ z = scons x q $ by and_elim_r [q37]
q40: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ esat u E T w = esat u E2 T w $ by weaken [#4]
q41: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ esat u E2 T w = esat u E T w $ by eq_sym [q40]
q42: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ q ∊ esat u E T w $ by welc_eq [q41, q36]
