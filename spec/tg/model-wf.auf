d3: $ G , y ∊ ilev D W , ityf D ∅ f , ra_isort f k l ∈ lrel , y ∊ lv l W , x1 = sclip K , x2 = sclip L ⇒ x2 = sclip L $ by ax
d4: $ G , y ∊ ilev D W , ityf D ∅ f , ra_isort f k l ∈ lrel , y ∊ lv l W , x1 = sclip K , x2 = sclip L ⇒ ra_isort F K L = ra_isort f x1 x2 $ by b4_isort_cl [d1, d2, d3]
d5: $ G , y ∊ ilev D W , ityf D ∅ f , ra_isort f k l ∈ lrel , y ∊ lv l W , x1 = sclip K , x2 = sclip L ⇒ ra_isort F K L ∈ lrel $ by weaken [#2]
d6: $ G , y ∊ ilev D W , ityf D ∅ f , ra_isort f k l ∈ lrel , y ∊ lv l W , x1 = sclip K , x2 = sclip L ⇒ ra_isort f x1 x2 ∈ lrel $ by wcel_eq_l [d4, d5]
d7: $ G , y ∊ ilev D W , ityf D ∅ f , ra_isort f k l ∈ lrel , y ∊ lv l W , x1 = sclip K , x2 = sclip L ⇒ ra_isort f k l ∈ lrel $ by ax
d8: $ G , y ∊ ilev D W , ityf D ∅ f , ra_isort f k l ∈ lrel , y ∊ lv l W , x1 = sclip K , x2 = sclip L ⇒ k = x1 ∧ l = x2 $ by lrel_isort_det [d7, d6]
d9: $ G , y ∊ ilev D W , ityf D ∅ f , ra_isort f k l ∈ lrel , y ∊ lv l W , x1 = sclip K , x2 = sclip L ⇒ l = x2 $ by and_elim_r [d8]
d10: $ G , y ∊ ilev D W , ityf D ∅ f , ra_isort f k l ∈ lrel , y ∊ lv l W , x1 = sclip K , x2 = sclip L ⇒ l = sclip L $ by eq_trans [d9, d3]
