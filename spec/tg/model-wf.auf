t7l: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V , nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ nest (scat x X0) y ∈ fv a (nadd (nadd (fv nvf e) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv b (nadd (nadd (fv nvf e) (fv nvf n)) (fv nvf j)) $ by imp_elim [t7k, t7v]
t7: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V , nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ nest (scat x X0) y ∈ fv b (nadd (nadd (fv nvf e) (fv nvf n)) (fv nvf j)) $ by imp_elim [t7l, t6]
o4a: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V , nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ fv (scons h b) (nadd (suc (nadd (fv nvf e) (fv nvf n))) (fv nvf j)) = fv b (nadd (nadd (fv nvf e) (fv nvf n)) (fv nvf j)) $ by b9_fvsh [w10_s5, t0]
w13_h4: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V , nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ p = scons h b $ by weaken [#4]
o4c: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V , nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) = fv (scons h b) (nadd (suc (nadd (fv nvf e) (fv nvf n))) (fv nvf j)) $ by fv_eq [w13_h4, t1]
o4: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V , nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) = fv b (nadd (nadd (fv nvf e) (fv nvf n)) (fv nvf j)) $ by eq_trans [o4c, o4a]
o5: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V , nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ fv b (nadd (nadd (fv nvf e) (fv nvf n)) (fv nvf j)) = fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) $ by eq_sym [o4]
o6: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V , nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) ⇒ nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) $ by wcel_eq_r [o5, t7]
u0: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m , y ∊ V ⇒ nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) $ by imp_intro [o6]
u1: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V , cdm x = fv nvf m ⇒ y ∊ V → nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) $ by imp_intro [u0]
u2: $ G , ra_nidx D j m ∈ lrel , x ∊ fseq b7_V ⇒ cdm x = fv nvf m → y ∊ V → nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) $ by imp_intro [u1]
u3: $ G , ra_nidx D j m ∈ lrel ⇒ x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ V → nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) $ by imp_intro [u2]
u4: $ G ⇒ ra_nidx D j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ V → nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) $ by imp_intro [u3]
u5: $ G ⇒ ∀ y (ra_nidx D j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ V → nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j))) $ by all_intro [u4]
u6: $ G ⇒ ∀ x ∀ y (ra_nidx D j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ V → nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j))) $ by all_intro [u5]
u7: $ G ⇒ ∀ m ∀ x ∀ y (ra_nidx D j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ V → nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j))) $ by all_intro [u6]
u8: $ G ⇒ ∀ j ∀ m ∀ x ∀ y (ra_nidx D j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ V → nest (scat x X0) y ∈ fv q (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j)) → nest (scat x X0) y ∈ fv p (nadd (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) (fv nvf j))) $ by all_intro [u7]
u9: $ G ⇒ b9_hb D X0 q p (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) V $ by weaken [u8]

lemma b9_sw_sh (G: hyps) (X0: class) (a c e n q: set): $ G ⇒ swin a (fv nvf e) (fv nvf n) = X0 $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ q = scons c a $ > $ G ⇒ swin q (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = X0 $
----
s0: $ G ⇒ e ∈ trees ω $ by welc_wcel [#2]
s1: $ G ⇒ fv nvf ⟨ kc_s , scons e ∅ ⟩ = suc (fv nvf e) $ by nvf_s [s0]
s1b: $ G ⇒ fv nvf n = fv nvf n $ by eq_refl
s3c: $ G ⇒ isset n $ by isset_var
s3d: $ G ⇒ fv nvf n ∈ ω $ by nvf_omega [s3c]
s5a: $ G ⇒ isset e $ by isset_var
s5b: $ G ⇒ fv nvf e ∈ ω $ by nvf_omega [s5a]
w2: $ G ⇒ swin q (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = swin (scons c a) (suc (fv nvf e)) (fv nvf n) $ by swin_eq [#3, s1, s1b]
w3: $ G ⇒ swin (scons c a) (suc (fv nvf e)) (fv nvf n) = swin a (fv nvf e) (fv nvf n) $ by b7_swin_scons [s5b, s3d]
w4a: $ G ⇒ swin (scons c a) (suc (fv nvf e)) (fv nvf n) = X0 $ by eq_trans [w3, #1]
w4: $ G ⇒ swin q (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = X0 $ by eq_trans [w2, w4a]

lemma b9_ag_sh (G: hyps) (a b c h e n q p: set): $ G ⇒ b9_ag a b (nadd (fv nvf e) (fv nvf n)) $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ c = h $ > $ G ⇒ q = scons c a $ > $ G ⇒ p = scons h b $ > $ G ⇒ b9_ag q p (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) $
----
s0: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = suc (nadd (fv nvf e) (fv nvf n)) ∧ nadd (fv nvf e) (fv nvf n) ∈ ω $ by b9_kshift [#2]
s4: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = suc (nadd (fv nvf e) (fv nvf n)) $ by and_elim_l [s0]
s5: $ G ⇒ nadd (fv nvf e) (fv nvf n) ∈ ω $ by and_elim_r [s0]
v8: $ G ⇒ ∀ i (i ∊ suc (nadd (fv nvf e) (fv nvf n)) → fv (scons c a) i = fv (scons c b) i) $ by scons_agree [s5, #1]
v9: $ G ⇒ suc (nadd (fv nvf e) (fv nvf n)) = nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) $ by eq_sym [s4]
v10: $ G ⇒ scons c a = q $ by eq_sym [#4]
v11a: $ G ⇒ b = b $ by eq_refl
v11b: $ G ⇒ scons c b = scons h b $ by scons_eq [#3, v11a]
v11c: $ G ⇒ scons h b = p $ by eq_sym [#5]
v11: $ G ⇒ scons c b = p $ by eq_trans [v11b, v11c]
v12: $ G ⇒ ∀ i (i ∊ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) → fv q i = fv p i) $ by fv_agree_eq [v9, v10, v11, v8]
v13: $ G ⇒ b9_ag q p (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) $ by weaken [v12]

--| Equal valuations give equal values and paths.
lemma b9_dteq (G: hyps) (M T R R2: class) (u w: set): $ G ⇒ R = R2 $ > $ G ⇒ dt u M T w R = dt u M T w R2 $
----
a1: $ G ⇒ u = u $ by eq_refl
a2: $ G ⇒ M = M $ by eq_refl
a3: $ G ⇒ T = T $ by eq_refl
a4: $ G ⇒ w = w $ by eq_refl
a5: $ G ⇒ dt u M T w R = dt u M T w R2 $ by dt_eq [a1, a2, a3, a4, #1]

lemma b9_eteq (G: hyps) (M T R R2: class) (u w: set): $ G ⇒ R = R2 $ > $ G ⇒ etel u (dnf u M) T w R = etel u (dnf u M) T w R2 $
----
a3: $ G ⇒ T = T $ by eq_refl
a4: $ G ⇒ w = w $ by eq_refl
a5: $ G ⇒ etel u (dnf u M) T w R = etel u (dnf u M) T w R2 $ by etel_eq [a3, a4, #1]

lemma b9_dtz (G: hyps) (M T R: class) (u w z: set): $ G ⇒ z = T $ > $ G ⇒ dt u M z w R = dt u M T w R $
----
a1: $ G ⇒ u = u $ by eq_refl
a2: $ G ⇒ M = M $ by eq_refl
a3: $ G ⇒ R = R $ by eq_refl
a4: $ G ⇒ w = w $ by eq_refl
a5: $ G ⇒ dt u M z w R = dt u M T w R $ by dt_eq [a1, a2, #1, a4, a3]

lemma b9_etz (G: hyps) (M T R: class) (u w z: set): $ G ⇒ z = T $ > $ G ⇒ etel u (dnf u M) z w R = etel u (dnf u M) T w R $
----
a3: $ G ⇒ R = R $ by eq_refl
a4: $ G ⇒ w = w $ by eq_refl
a5: $ G ⇒ etel u (dnf u M) z w R = etel u (dnf u M) T w R $ by etel_eq [#1, a4, a3]

--| The positive field types whose values either do not depend on the entries
--| (`DEP`) or are, at the shape's valuation, one value whose points name the
--| paths at which the elements must be kept (`SING`).
def b9_pn (U M W D N Q X0 X: class) (.y .d .r .o .a .s .h .b .v .c .g .t .e: set): class = $ {y | ∀ d (ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → (∀ r ∀ o (r ∊ fseq U → o ∊ fseq U → b9_ag r o (nadd (fv nvf d) (fv nvf Q)) → dt U M y W r = dt U M y W o)) ∨ (∀ a ∀ s ∀ h (a ∊ fseq U → s ∊ fseq U → b9_ag a s (nadd (fv nvf d) (fv nvf Q)) → b9_hs D X0 a s (nadd (fv nvf d) (fv nvf Q)) X → swin a (fv nvf d) (fv nvf Q) = X0 → h ∊ dt U M y W a → dt U M y W s = csn (⋃ (dt U M y W s)) ∧ ∀ b ∀ v (b ∊ fseq U → b9_ag a b (nadd (fv nvf d) (fv nvf Q)) → b9_hb D X0 a b (nadd (fv nvf d) (fv nvf Q)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel U (dnf U M) y W a → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt U M y W s) → apn h c ∈ X → apn h c ∈ v) → h ∈ dt U M y W b))))} $

lemma b9_pn_i {d x0 x1 q p f l n x2 x3 x4 x5: set} (G: hyps) (M X0 X: class) (u w t1 t2 t3 y: set): $ G , ra_ipos t1 t2 t3 d y ∈ lrel , d ∊ trees ω ⇒ (∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1)) ∨ (∀ q ∀ p ∀ f (q ∊ fseq u → p ∊ fseq u → b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X → swin q (fv nvf d) (fv nvf t3) = X0 → f ∊ dt u M y w q → dt u M y w p = csn (⋃ (dt u M y w p)) ∧ ∀ l ∀ n (l ∊ fseq u → b9_ag q l (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 q l (nadd (fv nvf d) (fv nvf t3)) n → ∅ ∈ n → ∀ x2 ∀ x3 ∀ x4 ∀ x5 (⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w q → nest x2 ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w p) → apn f x2 ∈ X → apn f x2 ∈ n) → f ∈ dt u M y w l))) $ > $ G ⇒ y ∊ b9_pn u M w t1 t2 t3 X0 X $
----
l0: $ G , ra_ipos t1 t2 t3 d y ∈ lrel ⇒ d ∊ trees ω → (∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1)) ∨ (∀ q ∀ p ∀ f (q ∊ fseq u → p ∊ fseq u → b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X → swin q (fv nvf d) (fv nvf t3) = X0 → f ∊ dt u M y w q → dt u M y w p = csn (⋃ (dt u M y w p)) ∧ ∀ l ∀ n (l ∊ fseq u → b9_ag q l (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 q l (nadd (fv nvf d) (fv nvf t3)) n → ∅ ∈ n → ∀ x2 ∀ x3 ∀ x4 ∀ x5 (⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w q → nest x2 ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w p) → apn f x2 ∈ X → apn f x2 ∈ n) → f ∈ dt u M y w l))) $ by imp_intro [#1]
l1: $ G ⇒ ra_ipos t1 t2 t3 d y ∈ lrel → d ∊ trees ω → (∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1)) ∨ (∀ q ∀ p ∀ f (q ∊ fseq u → p ∊ fseq u → b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X → swin q (fv nvf d) (fv nvf t3) = X0 → f ∊ dt u M y w q → dt u M y w p = csn (⋃ (dt u M y w p)) ∧ ∀ l ∀ n (l ∊ fseq u → b9_ag q l (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 q l (nadd (fv nvf d) (fv nvf t3)) n → ∅ ∈ n → ∀ x2 ∀ x3 ∀ x4 ∀ x5 (⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w q → nest x2 ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w p) → apn f x2 ∈ X → apn f x2 ∈ n) → f ∈ dt u M y w l))) $ by imp_intro [l0]
l2: $ G ⇒ ∀ d (ra_ipos t1 t2 t3 d y ∈ lrel → d ∊ trees ω → (∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1)) ∨ (∀ q ∀ p ∀ f (q ∊ fseq u → p ∊ fseq u → b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X → swin q (fv nvf d) (fv nvf t3) = X0 → f ∊ dt u M y w q → dt u M y w p = csn (⋃ (dt u M y w p)) ∧ ∀ l ∀ n (l ∊ fseq u → b9_ag q l (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 q l (nadd (fv nvf d) (fv nvf t3)) n → ∅ ∈ n → ∀ x2 ∀ x3 ∀ x4 ∀ x5 (⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w q → nest x2 ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w p) → apn f x2 ∈ X → apn f x2 ∈ n) → f ∈ dt u M y w l)))) $ by all_intro [l1]
l3: $ G ⇒ y ∊ b9_pn u M w t1 t2 t3 X0 X $ by cab_intro [l2]

lemma b9_pn_e {r o a s h b v c g t e: set} (G: hyps) (M X0 X: class) (u w t1 t2 t3 y d: set): $ G ⇒ y ∊ b9_pn u M w t1 t2 t3 X0 X $ > $ G ⇒ ra_ipos t1 t2 t3 d y ∈ lrel $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ (∀ r ∀ o (r ∊ fseq u → o ∊ fseq u → b9_ag r o (nadd (fv nvf d) (fv nvf t3)) → dt u M y w r = dt u M y w o)) ∨ (∀ a ∀ s ∀ h (a ∊ fseq u → s ∊ fseq u → b9_ag a s (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 a s (nadd (fv nvf d) (fv nvf t3)) X → swin a (fv nvf d) (fv nvf t3) = X0 → h ∊ dt u M y w a → dt u M y w s = csn (⋃ (dt u M y w s)) ∧ ∀ b ∀ v (b ∊ fseq u → b9_ag a b (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 a b (nadd (fv nvf d) (fv nvf t3)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w a → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w s) → apn h c ∈ X → apn h c ∈ v) → h ∈ dt u M y w b))) $
----
c1: $ G ⇒ ∀ z (ra_ipos t1 t2 t3 z y ∈ lrel → z ∊ trees ω → (∀ r ∀ o (r ∊ fseq u → o ∊ fseq u → b9_ag r o (nadd (fv nvf z) (fv nvf t3)) → dt u M y w r = dt u M y w o)) ∨ (∀ a ∀ s ∀ h (a ∊ fseq u → s ∊ fseq u → b9_ag a s (nadd (fv nvf z) (fv nvf t3)) → b9_hs t1 X0 a s (nadd (fv nvf z) (fv nvf t3)) X → swin a (fv nvf z) (fv nvf t3) = X0 → h ∊ dt u M y w a → dt u M y w s = csn (⋃ (dt u M y w s)) ∧ ∀ b ∀ v (b ∊ fseq u → b9_ag a b (nadd (fv nvf z) (fv nvf t3)) → b9_hb t1 X0 a b (nadd (fv nvf z) (fv nvf t3)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w a → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w s) → apn h c ∈ X → apn h c ∈ v) → h ∈ dt u M y w b)))) $ by cab_elim [#1]
c2: $ G ⇒ ra_ipos t1 t2 t3 d y ∈ lrel → d ∊ trees ω → (∀ r ∀ o (r ∊ fseq u → o ∊ fseq u → b9_ag r o (nadd (fv nvf d) (fv nvf t3)) → dt u M y w r = dt u M y w o)) ∨ (∀ a ∀ s ∀ h (a ∊ fseq u → s ∊ fseq u → b9_ag a s (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 a s (nadd (fv nvf d) (fv nvf t3)) X → swin a (fv nvf d) (fv nvf t3) = X0 → h ∊ dt u M y w a → dt u M y w s = csn (⋃ (dt u M y w s)) ∧ ∀ b ∀ v (b ∊ fseq u → b9_ag a b (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 a b (nadd (fv nvf d) (fv nvf t3)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w a → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w s) → apn h c ∈ X → apn h c ∈ v) → h ∈ dt u M y w b))) $ by all_elim [c1]
c3: $ G ⇒ d ∊ trees ω → (∀ r ∀ o (r ∊ fseq u → o ∊ fseq u → b9_ag r o (nadd (fv nvf d) (fv nvf t3)) → dt u M y w r = dt u M y w o)) ∨ (∀ a ∀ s ∀ h (a ∊ fseq u → s ∊ fseq u → b9_ag a s (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 a s (nadd (fv nvf d) (fv nvf t3)) X → swin a (fv nvf d) (fv nvf t3) = X0 → h ∊ dt u M y w a → dt u M y w s = csn (⋃ (dt u M y w s)) ∧ ∀ b ∀ v (b ∊ fseq u → b9_ag a b (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 a b (nadd (fv nvf d) (fv nvf t3)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w a → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w s) → apn h c ∈ X → apn h c ∈ v) → h ∈ dt u M y w b))) $ by imp_elim [c2, #2]
c4: $ G ⇒ (∀ r ∀ o (r ∊ fseq u → o ∊ fseq u → b9_ag r o (nadd (fv nvf d) (fv nvf t3)) → dt u M y w r = dt u M y w o)) ∨ (∀ a ∀ s ∀ h (a ∊ fseq u → s ∊ fseq u → b9_ag a s (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 a s (nadd (fv nvf d) (fv nvf t3)) X → swin a (fv nvf d) (fv nvf t3) = X0 → h ∊ dt u M y w a → dt u M y w s = csn (⋃ (dt u M y w s)) ∧ ∀ b ∀ v (b ∊ fseq u → b9_ag a b (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 a b (nadd (fv nvf d) (fv nvf t3)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w a → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M y w s) → apn h c ∈ X → apn h c ∈ v) → h ∈ dt u M y w b))) $ by imp_elim [c3, #3]

lemma b9_nc_cl {x0 x1: set} (G: hyps) (M: class) (u w t3 d k y: set): $ G ⇒ ra_add d t3 k ∈ lrel $ > $ G ⇒ ra_closed k y ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1) $
----
k1: $ G ⇒ fv nvf k = nadd (fv nvf d) (fv nvf t3) $ by lrel_add_sem [#1]
k2: $ G ⇒ nadd (fv nvf d) (fv nvf t3) = fv nvf k $ by eq_sym [k1]
a1: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) $ by ax
a2a: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x0 = x0 $ by eq_refl
a2b: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x1 = x1 $ by eq_refl
w14_k2: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ nadd (fv nvf d) (fv nvf t3) = fv nvf k $ by weaken [k2]
a2: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ ∀ i (i ∊ fv nvf k → fv x0 i = fv x1 i) $ by fv_agree_eq [w14_k2, a2a, a2b, a1]
a3r: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x0 ∊ fseq u $ by ax
a3o: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x1 ∊ fseq u $ by ax
w15_h2: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ ra_closed k y ∈ lrel $ by weaken [#2]
w16_h3: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ w ∊ lvals $ by weaken [#3]
a3: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ dt u M y w x0 = dt u M y w x1 $ by lrel_closed_sem [w15_h2, w16_h3, a3r, a3o, a2]
a4: $ G , x0 ∊ fseq u , x1 ∊ fseq u ⇒ b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1 $ by imp_intro [a3]
a5: $ G , x0 ∊ fseq u ⇒ x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1 $ by imp_intro [a4]
a6: $ G ⇒ x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1 $ by imp_intro [a5]
a7: $ G ⇒ ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1) $ by all_intro [a6]
a8: $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M y w x0 = dt u M y w x1) $ by all_intro [a7]

lemma b9_et_cl {x0 x1: set} (G: hyps) (M: class) (u w t3 d k y: set): $ G ⇒ ra_add d t3 k ∈ lrel $ > $ G ⇒ ra_closed k y ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1) $
----
k1: $ G ⇒ fv nvf k = nadd (fv nvf d) (fv nvf t3) $ by lrel_add_sem [#1]
k2: $ G ⇒ nadd (fv nvf d) (fv nvf t3) = fv nvf k $ by eq_sym [k1]
a1: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) $ by ax
a2a: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x0 = x0 $ by eq_refl
a2b: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x1 = x1 $ by eq_refl
w17_k2: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ nadd (fv nvf d) (fv nvf t3) = fv nvf k $ by weaken [k2]
a2: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ ∀ i (i ∊ fv nvf k → fv x0 i = fv x1 i) $ by fv_agree_eq [w17_k2, a2a, a2b, a1]
a3r: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x0 ∊ fseq u $ by ax
a3o: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x1 ∊ fseq u $ by ax
w18_h2: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ ra_closed k y ∈ lrel $ by weaken [#2]
w19_h4: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ y ∊ trees ω $ by weaken [#4]
w20_h3: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ w ∊ lvals $ by weaken [#3]
a3: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1 $ by lrel_closed_etel [w18_h2, w19_h4, w20_h3, a3r, a3o, a2]
a4: $ G , x0 ∊ fseq u , x1 ∊ fseq u ⇒ b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1 $ by imp_intro [a3]
a5: $ G , x0 ∊ fseq u ⇒ x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1 $ by imp_intro [a4]
a6: $ G ⇒ x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1 $ by imp_intro [a5]
a7: $ G ⇒ ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1) $ by all_intro [a6]
a8: $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1) $ by all_intro [a7]

lemma b9_et_ip {x0 x1: set} (G: hyps) (M: class) (u w t1 t2 t3 d y: set): $ G ⇒ ra_ipos t1 t2 t3 d y ∈ lrel $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1) $
----
a1: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) $ by ax
a3r: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x0 ∊ fseq u $ by ax
a3o: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ x1 ∊ fseq u $ by ax
w21_h1: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ ra_ipos t1 t2 t3 d y ∈ lrel $ by weaken [#1]
w22_h2: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ d ∊ trees ω $ by weaken [#2]
w23_h3: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ y ∊ trees ω $ by weaken [#3]
w24_h4: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ w ∊ lvals $ by weaken [#4]
a3: $ G , x0 ∊ fseq u , x1 ∊ fseq u , b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) ⇒ etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1 $ by lrel_ipos_etel [w21_h1, w22_h2, w23_h3, w24_h4, a3r, a3o, a1]
a4: $ G , x0 ∊ fseq u , x1 ∊ fseq u ⇒ b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1 $ by imp_intro [a3]
a5: $ G , x0 ∊ fseq u ⇒ x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1 $ by imp_intro [a4]
a6: $ G ⇒ x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1 $ by imp_intro [a5]
a7: $ G ⇒ ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1) $ by all_intro [a6]
a8: $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → etel u (dnf u M) y w x0 = etel u (dnf u M) y w x1) $ by all_intro [a7]

lemma b9_wcel_empty (G: hyps) (Y: class): $ G ⇒ Y ∈ ∅ $ > $ G ⇒ ⊥ $
----
a0: $ G ⇒ isset Y $ by wcel_isset [#1]
a1: $ G , x = Y ⇒ x = Y $ by ax
a2: $ G , x = Y ⇒ Y = x $ by eq_sym [a1]
w25_h1: $ G , x = Y ⇒ Y ∈ ∅ $ by weaken [#1]
a3: $ G , x = Y ⇒ x ∈ ∅ $ by wcel_eq_l [a2, w25_h1]
a4: $ G , x = Y ⇒ x ∊ ∅ $ by wcel_welc [a3]
a5: $ G , x = Y ⇒ ⊥ $ by empty_elim [a4]
a6: $ G ⇒ ⊥ $ by isset_elim [a0, a5]

--| A field value at a valuation over `u` has its domain's elements in `u`.
lemma b9_inu (G: hyps) (M W Y T: class) (u t1 t2 t3 B x a: set): $ G ⇒ ra_ipos t1 t2 t3 T B ∈ lrel $ > $ G ⇒ isset T $ > $ G ⇒ B ∊ trees ω $ > $ G ⇒ Y ∈ dt u M B W (scons x a) $ > $ G ⇒ x ∊ u $
----
e1: $ G ⇒ x ∊ u ∨ ¬ x ∊ u $ by excluded_middle
e2: $ G , x ∊ u ⇒ x ∊ u $ by ax
n1: $ G , ¬ x ∊ u ⇒ ¬ x ∊ u $ by ax
n2a: $ G , ¬ x ∊ u , scons x a ∈ fseq u ⇒ scons x a ∈ fseq u $ by ax
n2: $ G , ¬ x ∊ u , scons x a ∈ fseq u ⇒ x ∊ u $ by scons_fseq_hd [n2a]
w26_n1: $ G , ¬ x ∊ u , scons x a ∈ fseq u ⇒ ¬ x ∊ u $ by weaken [n1]
n3: $ G , ¬ x ∊ u , scons x a ∈ fseq u ⇒ ⊥ $ by not_elim [w26_n1, n2]
n4: $ G , ¬ x ∊ u ⇒ ¬ scons x a ∈ fseq u $ by not_intro [n3]
w27_h1: $ G , ¬ x ∊ u ⇒ ra_ipos t1 t2 t3 T B ∈ lrel $ by weaken [#1]
w28_h2: $ G , ¬ x ∊ u ⇒ isset T $ by weaken [#2]
w29_h3: $ G , ¬ x ∊ u ⇒ B ∊ trees ω $ by weaken [#3]
n5: $ G , ¬ x ∊ u ⇒ dt u M B W (scons x a) = ∅ $ by lrel_ipos_out_c [w27_h1, w28_h2, w29_h3, n4]
w30_h4: $ G , ¬ x ∊ u ⇒ Y ∈ dt u M B W (scons x a) $ by weaken [#4]
n6: $ G , ¬ x ∊ u ⇒ Y ∈ ∅ $ by wcel_eq_r [n5, w30_h4]
n7: $ G , ¬ x ∊ u ⇒ ⊥ $ by b9_wcel_empty [n6]
n8: $ G , ¬ x ∊ u ⇒ x ∊ u $ by bot_elim [n7]
e3: $ G ⇒ x ∊ u $ by or_elim [e1, e2, n8]

--| A trace in a `Π` of singletons has those values.
lemma b9_cpi1 {y: set} (G: hyps y) (A: class) (F: class y) (g x: set): $ G ⇒ g ∊ cpi y A (csn F) $ > $ G ⇒ x ∊ A $ > $ G ⇒ ap g x = (⟦ y / x ⟧ F) $
----
b1: $ G ⇒ ap g x ∈ csn (⟦ y / x ⟧ F) $ by cpi_elim_ap [#1, #2]
b2a: $ G ⇒ isset g $ by isset_var
b2: $ G ⇒ isset (ap g x) $ by ap_set [b2a]
b3: $ G , z = ap g x ⇒ z = ap g x $ by ax
b4: $ G , z = ap g x ⇒ ap g x = z $ by eq_sym [b3]
w31_b1: $ G , z = ap g x ⇒ ap g x ∈ csn (⟦ y / x ⟧ F) $ by weaken [b1]
b5: $ G , z = ap g x ⇒ z ∈ csn (⟦ y / x ⟧ F) $ by wcel_eq_l [b4, w31_b1]
b6: $ G , z = ap g x ⇒ z ∊ csn (⟦ y / x ⟧ F) $ by wcel_welc [b5]
b7: $ G , z = ap g x ⇒ z = (⟦ y / x ⟧ F) $ by csn_elim [b6]
b8: $ G , z = ap g x ⇒ ap g x = (⟦ y / x ⟧ F) $ by eq_trans [b4, b7]
b9: $ G ⇒ ap g x = (⟦ y / x ⟧ F) $ by isset_elim [b2, b8]

lemma b9_csn_self (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ csn A $
----
a1: $ G , z = A ⇒ z = A $ by ax
a2: $ G , z = A ⇒ z ∊ csn A $ by csn_intro [a1]
a3: $ G , z = A ⇒ A ∈ csn A $ by wcel_intro [a1, a2]
a4: $ G ⇒ A ∈ csn A $ by isset_elim [#1, a3]

--| A `Π` whose fibers are singletons is a singleton.
lemma b9_cpi_csn {y: set} (G: hyps) (A: class) (F: class y): $ G ⇒ isset A $ > $ G ⇒ ∀ y (y ∊ A → isset F) $ > $ G ⇒ cpi y A (csn F) = csn (clam y A F) $
----
h0: $ G ⇒ isset (clam y A F) $ by clam_set [#1, #2]
w32_h2: $ G , y ∊ A ⇒ ∀ y (y ∊ A → isset F) $ by weaken [#2]
k0a: $ G , y ∊ A ⇒ y ∊ A → isset F $ by all_elim [w32_h2]
