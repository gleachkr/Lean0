lemma b6_so_s (G: hyps) (A: class): $ G ⇒ A ∈ ofsort lsig lopen ks_nat $ > $ G ⇒ ⟨ kc_s , scons A ∅ ⟩ ∈ ofsort lsig lopen ks_nat $
----
q1: $ G ⇒ sig lsig lopen $ by lsig_sig
q2: $ G ⇒ ⟨ kc_s , ⟨ ks_nat , scons ks_nat ∅ ⟩ ⟩ ∈ lsig $ by b6_sig_s
q3: $ G ⇒ ⟨ kc_s , scons A ∅ ⟩ ∈ ofsort lsig lopen ks_nat $ by ofsort_node1 [q1, q2, #1]

lemma b6_so_bvar (G: hyps) (A: class): $ G ⇒ A ∈ ofsort lsig lopen ks_nat $ > $ G ⇒ ⟨ kc_bvar , scons A ∅ ⟩ ∈ ofsort lsig lopen ks_expr $
----
q1: $ G ⇒ sig lsig lopen $ by lsig_sig
q2: $ G ⇒ ⟨ kc_bvar , ⟨ ks_expr , scons ks_nat ∅ ⟩ ⟩ ∈ lsig $ by b6_sig_bvar
q3: $ G ⇒ ⟨ kc_bvar , scons A ∅ ⟩ ∈ ofsort lsig lopen ks_expr $ by ofsort_node1 [q1, q2, #1]

lemma b6_so_app (G: hyps) (A B: class): $ G ⇒ A ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ B ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ ⟨ kc_app , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $
----
q1: $ G ⇒ sig lsig lopen $ by lsig_sig
q2: $ G ⇒ ⟨ kc_app , ⟨ ks_expr , scons ks_expr (scons ks_expr ∅) ⟩ ⟩ ∈ lsig $ by b6_sig_app
q3: $ G ⇒ ⟨ kc_app , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ by ofsort_node2 [q1, q2, #1, #2]

lemma b6_so_lam (G: hyps) (A B: class): $ G ⇒ A ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ B ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ ⟨ kc_lam , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $
