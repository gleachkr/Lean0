p12: $ … ⇒ a0 ∊ ofsort lsig lopen ks_expr $ by and_elim_l [p11]
p13: $ … ⇒ b0 ∊ ofsort lsig lopen ks_expr $ by and_elim_r [p11]
q1: $ … ⇒ dt u M (⟨ kc_pi , scons a0 (scons b0 ∅) ⟩) w (scat t6 X) = cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X))) $ by dt_pi_c [p9, p10, r3, r1]
q2: $ … ⇒ dt u M (⟨ kc_pi , scons a0 (scons b0 ∅) ⟩) w (scat t6 Y) = cpi x (dt u M a0 w (scat t6 Y)) (dt u M b0 w (scons x (scat t6 Y))) $ by dt_pi_c [p9, p10, r3, r2]
q3: $ G ⇒ u = u $ by eq_refl
q4: $ G ⇒ M = M $ by eq_refl
q5: $ G ⇒ w = w $ by eq_refl
q6: $ G ⇒ scat t6 X = scat t6 X $ by eq_refl
q7: $ G ⇒ scat t6 Y = scat t6 Y $ by eq_refl
q8: $ … ⇒ dt u M z w (scat t6 X) = dt u M (⟨ kc_pi , scons a0 (scons b0 ∅) ⟩) w (scat t6 X) $ by dt_eq [q3, q4, #9, q5, q6]
q9: $ … ⇒ dt u M z w (scat t6 Y) = dt u M (⟨ kc_pi , scons a0 (scons b0 ∅) ⟩) w (scat t6 Y) $ by dt_eq [q3, q4, #9, q5, q7]
q10: $ … ⇒ dt u M z w (scat t6 X) = cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X))) $ by eq_trans [q8, q1]
q11: $ … ⇒ dt u M z w (scat t6 Y) = cpi x (dt u M a0 w (scat t6 Y)) (dt u M b0 w (scons x (scat t6 Y))) $ by eq_trans [q9, q2]
q12: $ G ⇒ dt u M a0 w (scat t6 X) = dt u M a0 w (scat t6 Y) $ by b14_ip_cl [#2, #3, #4, #7, #8, #13, #14]
q13: $ … ⇒ dt u M a0 w (scat t6 Y) = dt u M a0 w (scat t6 X) $ by eq_sym [q12]
q14: $ … ⇒ cpi x (dt u M a0 w (scat t6 Y)) (dt u M b0 w (scons x (scat t6 Y))) = cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 Y))) $ by cpi_eq_dom [q13]
q15: $ … ⇒ dt u M z w (scat t6 Y) = cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 Y))) $ by eq_trans [q11, q14]
q16: $ G ⇒ dt u M a0 w (scat t6 X) ∈ u $ by dt_in_u_c [#1, p12, r3, r1]
q17: $ … ⇒ isset (dt u M a0 w (scat t6 X)) $ by wcel_isset [q16]
q18: $ G ⇒ universe u $ by uadm_universe [#1]
h1: $ G , v ∊ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X))) ⇒ v ∊ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X))) $ by ax
h2: $ G , v ∊ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X))) ⇒ dt u M z w (scat t6 X) = cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X))) $ by weaken [q10]
h3: $ … ⇒ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X))) = dt u M z w (scat t6 X) $ by eq_sym [h2]
h4: $ … ⇒ v ∊ dt u M z w (scat t6 X) $ by welc_eq [h3, h1]
