q18: $ G ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
q19: $ G ⇒ fv nvf tz = ∅ $ by eq_trans [q17, q18]
q20: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel $ by ax
q21: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ iprt d p t $ by and_elim_l [q20]
q22: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel $ by and_elim_r [q20]
q23: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ fv nvf n = tj $ by and_elim_l [q22]
q24: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel $ by and_elim_r [q22]
q25: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ ra_nth_ty t n f e ∈ lrel $ by and_elim_l [q24]
q26: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel $ by and_elim_r [q24]
q27: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ fv nvf m = tm $ by and_elim_l [q26]
q28: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ ra_nth_ctor e m tk ∈ lrel $ by and_elim_r [q26]
q29: $ G , iprt d p t ∧ fv nvf n = tj ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = tm ∧ ra_nth_ctor e m tk ∈ lrel ⇒ iprt d tP tT $ by weaken [q1]
