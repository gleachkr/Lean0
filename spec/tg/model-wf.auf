lemma b6_so_pi (G: hyps) (A B: class): $ G ⇒ A ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ B ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ ⟨ kc_pi , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $
