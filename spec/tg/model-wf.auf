q7: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel $ by and_elim_r [q5]
q8: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ o = x4 $ by and_elim_l [q7]
q9: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel $ by and_elim_r [q7]
q10: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ m = x5 $ by and_elim_l [q9]
q11: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel $ by and_elim_r [q9]
q12: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ ra_ind_data x0 x1 x2 x3 ∈ lrel $ by and_elim_l [q11]
q13: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel $ by and_elim_r [q11]
q14: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ ra_nth_ty x3 x4 x6 x7 ∈ lrel $ by and_elim_l [q13]
q15: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel ⇒ ra_isort x6 x5 x8 ∈ lrel $ by and_elim_r [q13]
q16: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q ⇒ tX = ixs d w tx $ by weaken [#13]
q17: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q ⇒ fv nvf o = fv nvf o $ by eq_refl
q18: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q ⇒ fv tX (fv nvf o) = fv (ixs d w tx) (fv nvf o) $ by fv_eq [q16, q17]
q19: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q ⇒ q = q $ by eq_refl
q20: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q ⇒ apn (fv tX (fv nvf o)) q = apn (fv (ixs d w tx) (fv nvf o)) q $ by apn_eq [q18, q19]
q21: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q ⇒ e ∊ apn (fv tX (fv nvf o)) q $ by ax
