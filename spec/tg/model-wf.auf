def b6_cpe (u M w: class) (.y .b .c .d .q .e .f .x0 .o: set): class = $ {y | ∀ b ∀ c ∀ d ∀ q (ra_pis y b c ∈ lrel → ra_closed d c ∈ lrel → ra_clen y q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) y w = esat u (dsh u M f) y w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d)))} $

lemma b6_alpha_ag {x0 i: set} (G: hyps x0 i) (K A B: class): $ G ⇒ ∀ x0 (x0 ∊ K → fv A x0 = fv B x0) $ > $ G ⇒ ∀ i (i ∊ K → fv A i = fv B i) $
----
q1: $ _ ⇒ ∀ x0 (x0 ∊ K → fv A x0 = fv B x0) ↔ ∀ i (i ∊ K → fv A i = fv B i) $ by all_alpha
q2: $ G ⇒ ∀ x0 (x0 ∊ K → fv A x0 = fv B x0) ↔ ∀ i (i ∊ K → fv A i = fv B i) $ by weaken [q1]
q3: $ G ⇒ ∀ i (i ∊ K → fv A i = fv B i) $ by bi_elim_l [q2, #1]

lemma b6_pe_st (G: hyps) {e f x0 o: set} (M: class) (u w z k s t2 t3 t4 t5: set): $ G ⇒ crn s ⊆ b6_cpe u M w $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ra_pis z t2 t3 ∈ lrel $ > $ G ⇒ ra_closed t4 t3 ∈ lrel $ > $ G ⇒ ra_clen z t5 ∈ lrel $ > $ G ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $
----
q1: $ G ⇒ ∃ x3 (z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3) ∨ ∃ x1 ∃ x3 ∃ x4 ∃ x2 (z = ⟨ kc_cons , scons x1 (scons x2 ∅) ⟩ ∧ t2 = x3 ∧ t3 = x4 ∧ ra_pis x2 ⟨ kc_pi , scons x1 (scons x3 ∅) ⟩ x4 ∈ lrel) $ by lrel_pis_cases [#5]
q2: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 $ by ax
q3: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [q2]
q4: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 ⇒ t2 = x3 ∧ t3 = x3 $ by and_elim_r [q2]
q5: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 ⇒ t2 = x3 $ by and_elim_l [q4]
q6: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 ⇒ t3 = x3 $ by and_elim_r [q4]
q7: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 ⇒ w ∊ lvals $ by weaken [#4]
q8: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 ⇒ ra_clen z t5 ∈ lrel $ by weaken [#7]
q9: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 ⇒ (z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x5 ∃ x6 ∃ x7 (z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel) $ by lrel_clen_cases [q8]
q10: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ $ by ax
q11: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [q10]
q12: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ t5 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [q10]
q13: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by weaken [q3]
q14: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ e ∊ fseq u $ by ax
q15: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ f ∊ fseq u $ by ax
q16: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) $ by ax
q17: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by weaken [q13]
q18: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ w ∊ lvals $ by weaken [q7]
q19: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ w = w $ by eq_refl
q20: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ esat u (dsh u M e) z w = esat u (dsh u M e) ⟨ kc_nil , ∅ ⟩ w $ by esat_eq [q17, q19]
q21: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ esat u (dsh u M e) ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by esat_nil [q18]
q22: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ w = w $ by eq_refl
q23: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ esat u (dsh u M f) z w = esat u (dsh u M f) ⟨ kc_nil , ∅ ⟩ w $ by esat_eq [q17, q22]
q24: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ esat u (dsh u M f) ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by esat_nil [q18]
q25: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ esat u (dsh u M e) z w = csn ∅ $ by eq_trans [q20, q21]
q26: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ esat u (dsh u M f) z w = csn ∅ $ by eq_trans [q23, q24]
q27: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ csn ∅ = esat u (dsh u M f) z w $ by eq_sym [q26]
q28: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u , ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) ⇒ esat u (dsh u M e) z w = esat u (dsh u M f) z w $ by eq_trans [q25, q27]
q29: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u , f ∊ fseq u ⇒ (∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0)) → esat u (dsh u M e) z w = esat u (dsh u M f) z w $ by imp_intro [q28]
q30: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ , e ∊ fseq u ⇒ f ∊ fseq u → (∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0)) → esat u (dsh u M e) z w = esat u (dsh u M f) z w $ by imp_intro [q29]
q31: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ e ∊ fseq u → f ∊ fseq u → (∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0)) → esat u (dsh u M e) z w = esat u (dsh u M f) z w $ by imp_intro [q30]
q32: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ ∀ f (e ∊ fseq u → f ∊ fseq u → (∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0)) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) $ by all_intro [q31]
q33: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) $ by all_intro [q32]
q34: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ t3 = x3 $ by weaken [q6]
q35: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ t2 = x3 $ by weaken [q5]
q36: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ x3 = t2 $ by eq_sym [q35]
q37: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ t3 = t2 $ by eq_trans [q34, q36]
q38: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed t4 t3 ∈ lrel $ by weaken [#6]
q39: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ t4 = t4 $ by eq_refl
q40: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed t4 t3 = ra_closed t4 t2 $ by ra_closed_eq [q39, q37]
q41: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed t4 t2 ∈ lrel $ by wcel_eq_l [q40, q38]
q42: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
q43: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ fv nvf t5 = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [q42, q12]
q44: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
q45: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ fv nvf t5 = ∅ $ by eq_trans [q43, q44]
q46: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ fv nvf t4 = fv nvf t4 $ by eq_refl
q47: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ nadd (fv nvf t5) (fv nvf t4) = nadd ∅ (fv nvf t4) $ by nadd_eq [q45, q46]
q48: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ isset t4 $ by isset_var
q49: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ fv nvf t4 ∈ ω $ by nvf_omega [q48]
q50: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ nadd ∅ (fv nvf t4) = fv nvf t4 $ by b6_zero_nadd [q49]
q51: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ nadd (fv nvf t5) (fv nvf t4) = fv nvf t4 $ by eq_trans [q47, q50]
q52: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ fv nvf t4 = nadd (fv nvf t5) (fv nvf t4) $ by eq_sym [q51]
q53: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed t4 t2 ∈ lrel ∧ fv nvf t4 = nadd (fv nvf t5) (fv nvf t4) $ by and_intro [q41, q52]
q54: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $ by ex_intro [q53]
q55: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_nil , ∅ ⟩ ∧ t5 = ⟨ kc_nz , ∅ ⟩ ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $ by and_intro [q33, q54]
q56: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel $ by ax
q57: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ $ by and_elim_l [q56]
q58: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel $ by and_elim_r [q56]
q59: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ t5 = ⟨ kc_s , scons x7 ∅ ⟩ $ by and_elim_l [q58]
q60: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ ra_clen x6 x7 ∈ lrel $ by and_elim_r [q58]
q61: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by weaken [q3]
q62: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
q63: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ kc_nil ∈ ω $ by kc_nil_omega
q64: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
q65: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ ¬ kc_cons = kc_nil $ by ne_sym [q64]
q66: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $ by b6_clash [q57, q61, q65, q62, q63]
q67: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x3 ∧ t3 = x3 , ∃ x7 (z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel) ⇒ ∃ x7 (z = ⟨ kc_cons , scons x5 (scons x6 ∅) ⟩ ∧ t5 = ⟨ kc_s , scons x7 ∅ ⟩ ∧ ra_clen x6 x7 ∈ lrel) $ by ax
