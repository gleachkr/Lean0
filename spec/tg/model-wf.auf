u5: $ G , r = nest m e , r ∊ itriv u E D J w ⇒ (iprop D J w ∧ e = ∅) ∨ (¬ iprop D J w ∧ e = scons ∅ ∅) $ by b3_itriv_elim [u4, u3, u2]
u6: $ G ⇒ (iprop D J w ∧ e = ∅) ∨ (¬ iprop D J w ∧ e = scons ∅ ∅) $ by wcel_elim [a1, u5]

lemma b3_ps0_in {y e m: set} (G: hyps) (E Y: class) (u w b q x r: set): $ G ⇒ x ∊ fseq u $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ q ∊ esat u E b w $ > $ G ⇒ isset Y $ > $ G ⇒ r = nest (scat x q) Y $ > $ G ⇒ r ∊ {y | ∃ e ∃ m (e ∊ esat u E b w ∧ y = nest e m)} $
----
a1: $ G ⇒ nest (scat x q) Y = nest q (nest x Y) $ by nest_scat [#1, #2, #4]
a2: $ G ⇒ r = nest q (nest x Y) $ by eq_trans [#5, a1]
a3: $ G ⇒ isset (nest x Y) $ by nest_set
b1: $ G , n = nest x Y ⇒ n = nest x Y $ by ax
b2: $ G , n = nest x Y ⇒ nest x Y = n $ by eq_sym [b1]
b3: $ G , n = nest x Y ⇒ q = q $ by eq_refl
b4: $ G , n = nest x Y ⇒ nest q (nest x Y) = nest q n $ by nest_eq [b3, b2]
b5: $ G , n = nest x Y ⇒ r = nest q (nest x Y) $ by weaken [a2]
b6: $ G , n = nest x Y ⇒ r = nest q n $ by eq_trans [b5, b4]
b7: $ G , n = nest x Y ⇒ q ∊ esat u E b w $ by weaken [#3]
b8: $ G , n = nest x Y ⇒ q ∊ esat u E b w ∧ r = nest q n $ by and_intro [b7, b6]
b9: $ G , n = nest x Y ⇒ ∃ m (q ∊ esat u E b w ∧ r = nest q m) $ by ex_intro [b8]
b10: $ G , n = nest x Y ⇒ ∃ e ∃ m (e ∊ esat u E b w ∧ r = nest e m) $ by ex_intro [b9]
b11: $ G , n = nest x Y ⇒ r ∊ {y | ∃ e ∃ m (e ∊ esat u E b w ∧ y = nest e m)} $ by cab_intro [b10]
b12: $ G ⇒ r ∊ {y | ∃ e ∃ m (e ∊ esat u E b w ∧ y = nest e m)} $ by isset_elim [a3, b11]

lemma b3_sub_pts {x y z v: set} (G: hyps) (E D J: class) (u w b c d q e: set): $ G ⇒ D ∈ trees ω $ > $ G ⇒ iprt D b c $ > $ G ⇒ ityf D J d $ > $ G ⇒ q ∊ esat u E b w $ > $ G ⇒ e ∊ apn (itriv u E D J w) q $ > $ G ⇒ e ∊ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E d w q) ∧ y = nest x z)} $
----
a1: $ G ⇒ nest q e ∈ itriv u E D J w $ by cab_elim [#5]
a2: $ G ⇒ d ∈ fv tsub D $ by ityf_tsub [#1, #3]
a3: $ G ⇒ fv tsub D ⊆ trees ω $ by tsub_trees
a4: $ G ⇒ d ∈ trees ω $ by wcel_subset [a3, a2]
a5: $ G ⇒ b ∈ fv tsub D ∧ c ∈ fv tsub D $ by iprt_tsub [#1, #2]
a6: $ G ⇒ b ∈ fv tsub D $ by and_elim_l [a5]
a7: $ G ⇒ b ∈ trees ω $ by wcel_subset [a3, a6]
a8: $ G ⇒ esat u E b w ⊆ fseq u $ by esat_fseq
a9: $ G ⇒ q ∊ fseq u $ by subset_elim [a8, #4]
a10: $ G ⇒ q ∈ fseq u $ by welc_wcel [a9]
k1: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ iprt D p t $ by ax
k2: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ iprt D b c $ by weaken [#2]
k3: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ p = b ∧ t = c $ by iprt_det [k1, k2]
k4: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ p = b $ by and_elim_l [k3]
k5: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ w = w $ by eq_refl
k6: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ esat u E p w = esat u E b w $ by esat_eq [k4, k5]
k7: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ x8 ∊ esat u E p w $ by ax
k8: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ x8 ∊ esat u E b w $ by welc_eq [k6, k7]
k9: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ isset w $ by isset_var
k10: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ b ∈ trees ω $ by weaken [a7]
k11: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ q ∊ esat u E b w $ by weaken [#4]
k12: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ cdm q = cdm x8 $ by esat_len_c [k9, k10, k11, k8]
k13: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ ityf D J f $ by ax
k14: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ ityf D J d $ by weaken [#3]
k15: $ G , r = nest q e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , x8 ∊ esat u E p w , ⟨ x9 , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w x8 , (iprop D J w ∧ r = nest (scat x9 x8) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x9 x8) (scons ∅ ∅)) ⇒ f = d $ by ityf_det [k13, k14]
