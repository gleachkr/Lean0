fin: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_proj , scons b (scons x2 (scons h ∅)) ⟩ ∧ e = ⟨ kc_proj , scons b (scons x2 (scons v ∅)) ⟩ ∧ ra_lift x0 x1 h v ∈ lrel ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by b5_k_oth [f1, f2, f4, f7, f8, f10, f11, q3, q4, n1, n2]
end: $ H ⇒ (n = x0 ∧ k = x1 ∧ z = ⟨ kc_proj , scons b (scons x2 (scons h ∅)) ⟩ ∧ e = ⟨ kc_proj , scons b (scons x2 (scons v ∅)) ⟩ ∧ ra_lift x0 x1 h v ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by imp_intro [fin]

lemma b5_k_app (H: hyps) (M: class) (u w n q s k z e p r o c j x0 x1 x5 x6 x7 x8: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ q ∊ fseq u $ > $ H ⇒ cdm q = fv nvf n $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ crn j ⊆ b5_lp u M w n q s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_lift n k z e ∈ lrel $ > $ H ⇒ p ∊ fseq u $ > $ H ⇒ cdm p = fv nvf k $ > $ H ⇒ r = scat p (scat q s) $ > $ H ⇒ o = scat p s $ > $ H ⇒ (n = x0 ∧ k = x1 ∧ z = ⟨ kc_app , scons x5 (scons x6 ∅) ⟩ ∧ e = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_lift x0 x1 x5 x7 ∈ lrel ∧ ra_lift x0 x1 x6 x8 ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $
----
