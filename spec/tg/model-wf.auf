q89: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ nvf = nvf $ by eq_refl
q90: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ t3 = x3 $ by weaken [q7]
q91: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ x3 = t3 $ by eq_sym [q90]
q92: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ fv nvf x3 = fv nvf t3 $ by fv_eq [q89, q91]
q93: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ fv nvf x8 = fv nvf x8 $ by eq_refl
q94: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ nadd (fv nvf x8) (fv nvf x3) = nadd (fv nvf x8) (fv nvf t3) $ by nadd_eq [q93, q92]
q95: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ t5 = d $ by weaken [q11]
q96: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ w = w $ by eq_refl
q97: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ r = r $ by eq_refl
q98: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ sarg u (dnf u M) t5 w r = sarg u (dnf u M) d w r $ by sarg_eq [q95, q96, q97]
q99: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ cdm (sarg u (dnf u M) t5 w r) = cdm (sarg u (dnf u M) d w r) $ by cdm_eq [q98]
q100: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ cdm (sarg u (dnf u M) t5 w r) = nadd (fv nvf x8) (cdm v) $ by eq_trans [q99, q83]
q101: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ nadd (fv nvf x8) (cdm v) = nadd (fv nvf x8) (fv nvf t3) $ by eq_trans [q88, q94]
q102: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ cdm (sarg u (dnf u M) t5 w r) = nadd (fv nvf x8) (fv nvf t3) $ by eq_trans [q100, q101]
