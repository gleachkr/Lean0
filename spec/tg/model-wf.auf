x2b: $ G , ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩) ⇒ z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $ by ex_elim [x2a, x1b]
x3a: $ G , ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩) ⇒ ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩) $ by ax
x3b: $ G , ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩) ⇒ z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $ by ex_elim [x3a, x2b]
m1: $ G , z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} ⇒ z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} $ by ax
m2: $ G , z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩) $ by cab_elim [m1]
m3: $ G , z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} ⇒ z ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $ by ex_elim [m2, x3b]
m4: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $ by subset_intro [m3]

lemma b5_x1_eq {x f g t a y: set} (G: hyps) (E P P2 D D2 B B2 R O: class) (u w: set): $ G ⇒ P = P2 $ > $ G ⇒ D = D2 $ > $ G ⇒ ∀ x (x ∊ u → etel u E B w (scons x R) = etel u E B2 w (scons x O)) $ > $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $
----
s1: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $ by b5_x1_sub [#1, #2, #3]
s2: $ G ⇒ P2 = P $ by eq_sym [#1]
s3: $ G ⇒ D2 = D $ by eq_sym [#2]
s4a: $ G , x ∊ u ⇒ ∀ x (x ∊ u → etel u E B w (scons x R) = etel u E B2 w (scons x O)) $ by weaken [#3]
s4b: $ G , x ∊ u ⇒ x ∊ u → etel u E B w (scons x R) = etel u E B2 w (scons x O) $ by all_elim [s4a]
s4c: $ G , x ∊ u ⇒ x ∊ u $ by ax
s4d: $ G , x ∊ u ⇒ etel u E B w (scons x R) = etel u E B2 w (scons x O) $ by imp_elim [s4b, s4c]
s4e: $ G , x ∊ u ⇒ etel u E B2 w (scons x O) = etel u E B w (scons x R) $ by eq_sym [s4d]
s4f: $ G ⇒ x ∊ u → etel u E B2 w (scons x O) = etel u E B w (scons x R) $ by imp_intro [s4e]
s4g: $ G ⇒ ∀ x (x ∊ u → etel u E B2 w (scons x O) = etel u E B w (scons x R)) $ by all_intro [s4f]
s4: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} $ by b5_x1_sub [s2, s3, s4g]
s5: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $ by subset_antisym [s1, s4]

lemma b5_k_bvlt (H: hyps) (M: class) (u w n q s k z e p r o c j x0 x1 x2: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ q ∊ fseq u $ > $ H ⇒ cdm q = fv nvf n $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ crn j ⊆ b5_lp u M w n q s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_lift n k z e ∈ lrel $ > $ H ⇒ p ∊ fseq u $ > $ H ⇒ cdm p = fv nvf k $ > $ H ⇒ r = scat p (scat q s) $ > $ H ⇒ o = scat p s $ > $ H ⇒ (n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $
----
f1: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel ⇒ w ∊ lvals $ by weaken [#1]
f2: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel ⇒ q ∊ fseq u $ by weaken [#2]
f3: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel ⇒ cdm q = fv nvf n $ by weaken [#3]
f4: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel ⇒ s ∊ fseq u $ by weaken [#4]
f5: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel ⇒ crn j ⊆ b5_lp u M w n q s $ by weaken [#5]
f6: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel ⇒ z = ⟨ c , j ⟩ $ by weaken [#6]
f7: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel ⇒ ra_lift n k z e ∈ lrel $ by weaken [#7]
f8: $ H , n = x0 ∧ k = x1 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x1 ∈ lrel ⇒ p ∊ fseq u $ by weaken [#8]
