q67: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ swin r (fv nvf x4) (fv nvf x3) = v $ by eq_sym [q61]
q68: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ ∅ = ∅ $ by eq_refl
q69: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ scat (swin r (fv nvf x4) (fv nvf x3)) ∅ = scat v ∅ $ by scat_eq [q67, q68]
q70: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = d ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ d x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 d ∈ lrel , h = ⟨ kc_bvar , scons x7 ∅ ⟩ , v = swin r (fv nvf x4) (fv nvf x3) ⇒ scat v ∅ = v $ by scat_empty_r
