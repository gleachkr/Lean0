lemma b7_iphi_mono (G: hyps) (E D W Z Q A B: class) (u: set): $ G ⇒ A ⊆ B $ > $ G ⇒ iphi u E D W Z Q A ⊆ iphi u E D W Z Q B $
----
l1: $ G , z ∊ iphi u E D W Z Q A ⇒ z ∊ iphi u E D W Z Q A $ by ax
l2: $ G , z ∊ iphi u E D W Z Q A ⇒ ∃ x (x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x) $ by cab_elim [l1]
l3: $ G , z ∊ iphi u E D W Z Q A , x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x ⇒ x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x $ by ax
l4: $ G , z ∊ iphi u E D W Z Q A , x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x ⇒ x ⊆ A $ by and_elim_l [l3]
l5: $ G , z ∊ iphi u E D W Z Q A , x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x ⇒ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x $ by and_elim_r [l3]
l6: $ G , z ∊ iphi u E D W Z Q A , x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x ⇒ A ⊆ B $ by weaken [#1]
l7: $ G , z ∊ iphi u E D W Z Q A , x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x ⇒ x ⊆ B $ by subset_trans [l4, l6]
l8: $ G , z ∊ iphi u E D W Z Q A , x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x ⇒ x ⊆ B ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x $ by and_intro [l7, l5]
l9: $ G , z ∊ iphi u E D W Z Q A , x ⊆ A ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x ⇒ ∃ x (x ⊆ B ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x) $ by ex_intro [l8]
l10: $ G , z ∊ iphi u E D W Z Q A ⇒ ∃ x (x ⊆ B ∧ x ∊ u ∧ z ∊ iphi0 u E D W Z Q x) $ by ex_elim [l2, l9]
l11: $ G , z ∊ iphi u E D W Z Q A ⇒ z ∊ iphi u E D W Z Q B $ by cab_intro [l10]
l12: $ G ⇒ iphi u E D W Z Q A ⊆ iphi u E D W Z Q B $ by subset_intro [l11]

lemma b7_pt3a (G: hyps) (B1 B2 B3: class) (j a y: set): $ G ⇒ ⟨ j , ⟨ a , y ⟩ ⟩ ∈ B1 × (B2 × B3) $ > $ G ⇒ j ∊ B1 ∧ a ∊ B2 ∧ y ∊ B3 $
----
a1: $ G ⇒ isset j $ by isset_var
a2: $ G ⇒ isset ⟨ a , y ⟩ $ by opair_isset
a3: $ G ⇒ j ∈ B1 ∧ ⟨ a , y ⟩ ∈ B2 × B3 $ by cxp_elim_pair_c [#1, a1, a2]
a4: $ G ⇒ j ∈ B1 $ by and_elim_l [a3]
a5: $ G ⇒ j ∊ B1 $ by wcel_welc [a4]
a6: $ G ⇒ ⟨ a , y ⟩ ∈ B2 × B3 $ by and_elim_r [a3]
a7: $ G ⇒ a ∊ B2 ∧ y ∊ B3 $ by cxp_elim_pair [a6]
a8: $ G ⇒ j ∊ B1 ∧ a ∊ B2 ∧ y ∊ B3 $ by and_intro [a5, a7]

lemma b7_csn_eq (G: hyps) (A: class) (q: set): $ G ⇒ A ∈ csn q $ > $ G ⇒ A = q $
----
a1: $ G , c = A , c ∊ csn q ⇒ c ∊ csn q $ by ax
a2: $ G , c = A , c ∊ csn q ⇒ c = q ∨ c = q $ by cpr_elim [a1]
a3: $ G , c = A , c ∊ csn q ⇒ c = A $ by ax
a4: $ G , c = A , c ∊ csn q ⇒ A = c $ by eq_sym [a3]
a5: $ G , c = A , c ∊ csn q , c = q ⇒ c = q $ by ax
a6: $ G , c = A , c ∊ csn q , c = q ⇒ A = c $ by weaken [a4]
a7: $ G , c = A , c ∊ csn q , c = q ⇒ A = q $ by eq_trans [a6, a5]
a8: $ G , c = A , c ∊ csn q ⇒ A = q $ by or_elim [a2, a7, a7]
a9: $ G ⇒ A = q $ by wcel_elim [#1, a8]

lemma b7_csn_in (G: hyps) (A: class) (q: set): $ G ⇒ q = A $ > $ G ⇒ A ∈ csn q $
----
a1: $ G ⇒ isset q $ by isset_var
a2: $ G ⇒ q ∈ csn q $ by cpr_intro_l_c [a1]
a3: $ G ⇒ A ∈ csn q $ by wcel_eq_l [#1, a2]

lemma b7_ient_csn (G: hyps) (D W J: class) (u q: set): $ G ⇒ universe u $ > $ G ⇒ q ∊ ω × (fseq u × u) $ > $ G ⇒ ient D W (csn q) J ∈ u $
----
c1: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u ⇒ v ∊ fseq u × u $ by ax
c2: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ q = ⟨ i , v ⟩ $ by ax
c3: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ v = ⟨ b , e ⟩ $ by ax
c4: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ i = i $ by eq_refl
c5: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ ⟨ i , v ⟩ = ⟨ i , ⟨ b , e ⟩ ⟩ $ by opair_eq [c4, c3]
c6: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u ⇒ q = ⟨ i , ⟨ b , e ⟩ ⟩ $ by eq_trans [c2, c5]
n1: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J ⇒ o ∊ ient D W (csn q) J $ by ax
n2: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J ⇒ ∃ a ∃ x (⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x))) $ by cab_elim [n1]
n3: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) $ by ax
n4: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q $ by and_elim_l [n3]
n5: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ (iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x) $ by and_elim_r [n3]
n6: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ = q $ by b7_csn_eq [n4]
n7a: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ q = ⟨ i , v ⟩ $ by ax
n7: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ ⟨ J , ⟨ a , x ⟩ ⟩ = ⟨ i , v ⟩ $ by eq_trans [n6, n7a]
n8: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ isset J $ by opair_eq_isset [n7]
n9a: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ isset ⟨ a , x ⟩ $ by opair_isset
n9b: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ isset i $ by isset_var
n9c: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ isset v $ by isset_var
n9: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ J = i ∧ ⟨ a , x ⟩ = v $ by opair_inj_c [n7, n8, n9a, n9b, n9c]
n10a: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ ⟨ a , x ⟩ = v $ by and_elim_r [n9]
n10b: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ v = ⟨ b , e ⟩ $ by ax
n10: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ ⟨ a , x ⟩ = ⟨ b , e ⟩ $ by eq_trans [n10a, n10b]
n11: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ a = b $ by opair_inj_l [n10]
n12: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) ⇒ x = e $ by opair_inj_r [n10]
p1: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , iprop D J W ∧ o = nest a ∅ ⇒ iprop D J W ∧ o = nest a ∅ $ by ax
p2: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , iprop D J W ∧ o = nest a ∅ ⇒ o = nest a ∅ $ by and_elim_r [p1]
p3a: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , iprop D J W ∧ o = nest a ∅ ⇒ a = b $ by weaken [n11]
p3b: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , iprop D J W ∧ o = nest a ∅ ⇒ ∅ = ∅ $ by eq_refl
p3: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , iprop D J W ∧ o = nest a ∅ ⇒ nest a ∅ = nest b ∅ $ by nest_eq [p3a, p3b]
p4: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , iprop D J W ∧ o = nest a ∅ ⇒ o = nest b ∅ $ by eq_trans [p2, p3]
p5: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , iprop D J W ∧ o = nest a ∅ ⇒ o = nest b ∅ ∨ o = nest b e $ by or_intro_l [p4]
p6: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , iprop D J W ∧ o = nest a ∅ ⇒ o ∊ cpr (nest b ∅) (nest b e) $ by cpr_intro [p5]
r1: $ G , q = ⟨ i , v ⟩ , i ∊ ω , v ∊ fseq u × u , v = ⟨ b , e ⟩ , b ∊ fseq u , e ∊ u , o ∊ ient D W (csn q) J , ⟨ J , ⟨ a , x ⟩ ⟩ ∈ csn q ∧ ((iprop D J W ∧ o = nest a ∅) ∨ (¬ iprop D J W ∧ o = nest a x)) , ¬ iprop D J W ∧ o = nest a x ⇒ ¬ iprop D J W ∧ o = nest a x $ by ax
