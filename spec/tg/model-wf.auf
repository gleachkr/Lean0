--| `b11_top_hb` at one entry.
lemma b11_hb_hb1 (G: hyps) (M D W Z Q P T F: class) (u x p t t3 t1 t7 a b v tj tm tc ty: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Z ⊆ itc u (dnf u M) D W $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ x ∊ u $ > $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p t3 ∈ lrel $ > $ G ⇒ F ⊆ x $ > $ G ⇒ F = ∅ → x = ∅ $ > $ G ⇒ ∅ ∈ x → ∅ ∈ F $ > $ G ⇒ t1 = D $ > $ G ⇒ t7 = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ a = scat Q (ixs D W (isup Z x)) $ > $ G ⇒ b = scat Q (ixs D W (isup Z F)) $ > $ G ⇒ v = F ∪ csn ∅ $ > $ G ⇒ ra_nidx t1 tj tm ∈ lrel $ > $ G ⇒ tc ∊ fseq b7_V $ > $ G ⇒ cdm tc = fv nvf tm $ > $ G ⇒ ty ∊ v $ > $ G ⇒ nest (scat tc Q) ty ∈ fv a (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf tj)) $ > $ G ⇒ nest (scat tc Q) ty ∈ fv b (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf tj)) $
