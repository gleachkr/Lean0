q3: $ G ⇒ ⟨ kc_pi , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ by ofsort_node2 [q1, q2, #1, #2]

lemma b6_so_proj (G: hyps) (A B C: class): $ G ⇒ A ∈ ofsort lsig lopen ks_blk $ > $ G ⇒ B ∈ ofsort lsig lopen ks_nat $ > $ G ⇒ C ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ ⟨ kc_proj , scons A (scons B (scons C ∅)) ⟩ ∈ ofsort lsig lopen ks_expr $
----
