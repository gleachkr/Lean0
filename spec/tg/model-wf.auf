p4: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) $ by and_elim_r [p2r]
p5a: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ x = x $ by eq_refl
p5b: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ swin a (fv nvf t4) (fv nvf t3) = Q $ by weaken [l5]
p5c: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ scat x (swin a (fv nvf t4) (fv nvf t3)) = scat x Q $ by scat_eq [p5a, p5b]
p5: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ sarg u (dnf u M) t5 w a = scat x Q $ by eq_trans [p4, p5c]
p6a: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ uadm u $ by weaken [#8]
p6b: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ a ∊ fseq u $ by weaken [#4]
p6c: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ isset t3 $ by isset_var
p6d: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ fv nvf t3 ∈ ω $ by nvf_omega [p6c]
