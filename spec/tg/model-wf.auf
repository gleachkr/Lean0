lemma b6s_si_step (G: hyps) (M: class) (u w t1 t3 t4 p s x y: set): $ G ⇒ t1 ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = fv nvf t4 $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ x ∊ u $ > $ G ⇒ y ∊ fseq u $ > $ G ⇒ y ∈ b6s_sip u M t1 t3 t4 w p s $ > $ G ⇒ scons x y ∈ b6s_sip u M t1 t3 t4 w p s $
----
c1: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ ra_sinst t1 j t3 t4 e f ∈ lrel $ by ax
c2: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ z = scons x y $ by ax
c3: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ j ∊ trees ω $ by ax
c4: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ nadd (fv nvf j) (cdm z) = fv nvf t3 $ by ax
c5a: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) $ by ax
c5: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ b6s_sih u M t1 w z j $ by b6s_id [c5a]
h1: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ t1 ∊ trees ω $ by weaken [#1]
h2: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ w ∊ lvals $ by weaken [#2]
h3: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ p ∊ fseq u $ by weaken [#3]
h4: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ cdm p = fv nvf t4 $ by weaken [#4]
h5: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ s ∊ fseq u $ by weaken [#5]
h6: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ x ∊ u $ by weaken [#6]
h7: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ y ∊ fseq u $ by weaken [#7]
h8: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ y ∈ b6s_sip u M t1 t3 t4 w p s $ by weaken [#8]
c0: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ (∃ x0 ∃ x1 ∃ x2 ∃ x3 (t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3)) ∨ ∃ x0 ∃ x4 ∃ x1 ∃ x2 ∃ x3 ∃ x5 ∃ x6 (t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel) $ by lrel_sinst_cases [c1]
a1: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ (t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3) → etel u (dnf u M) f w (scat p s) = etel u (dnf u M) e w (scat p (scat z s)) $ by b6s_si_s1 [c2, h7, c4]
ea3: $ G , z = scons x y , ra_sinst t1 j t3 t4 e f ∈ lrel , j ∊ trees ω , nadd (fv nvf j) (cdm z) = fv nvf t3 , ∀ i ∀ b (i ∊ cdm z → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv z i) ⇒ ∀ x3 ((t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3) → etel u (dnf u M) f w (scat p s) = etel u (dnf u M) e w (scat p (scat z s))) $ by all_intro [a1]
