lemma b3_isw_step {o p c e x y z v: set} (G: hyps o p c e x y z v) (M: class) (u w l f k: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ra_isort f k l ∈ lrel $ > $ G ⇒ f ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ∀ o ∀ p (ra_isort o p l ∈ lrel → suc (fv nvf p) = fv nvf k → o ∊ ofsort lsig lopen ks_expr → ∀ c (c ∊ fseq u → ∀ e (e ∈ dt u M o w c ↔ (e ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) o w c) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) o w c) → apn e x ∈ fv uni (lv l w)))))) $ > $ G ⇒ ∀ c (c ∊ fseq u → ∀ e (e ∈ dt u M f w c ↔ (e ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w c) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w c) → apn e x ∈ fv uni (lv l w))))) $
----
a1: $ G ⇒ kr_isort ∈ ω $ by kr_isort_omega
a2: $ G ⇒ isset kr_isort $ by wcel_isset [a1]
a3: $ G ⇒ f ∊ trees ω ∧ k ∊ trees ω ∧ l ∊ trees ω $ by lrel_args3 [#3, a2]
a4: $ G ⇒ k ∊ trees ω ∧ l ∊ trees ω $ by and_elim_r [a3]
a5: $ G ⇒ l ∊ trees ω $ by and_elim_r [a4]
a6: $ G ⇒ l ∈ trees ω $ by welc_wcel [a5]
s1: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 $ by ax
s2: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ f = ⟨ kc_srt , scons x4 ∅ ⟩ $ by and_elim_l [s1]
s3a: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 $ by and_elim_r [s1]
s3: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ l = x4 $ by and_elim_r [s3a]
s4: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ x4 = l $ by eq_sym [s3]
s5a: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ l ∈ trees ω $ by ax
s5: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ x4 ∈ trees ω $ by wcel_eq_l [s3, s5a]
s6a: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ w ∊ lvals $ by ax
s6b: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ x8 ∊ fseq u $ by ax
s6: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ dt u M ⟨ kc_srt , scons x4 ∅ ⟩ w x8 = fv uni (lv x4 w) $ by dt_srt [s5, s6a, s6b]
s7a: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ u = u $ by eq_refl
s7b: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ M = M $ by eq_refl
s7c: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ w = w $ by eq_refl
s7d: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ x8 = x8 $ by eq_refl
s7: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ dt u M f w x8 = dt u M ⟨ kc_srt , scons x4 ∅ ⟩ w x8 $ by dt_eq [s7a, s7b, s2, s7c, s7d]
s8a: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ lv x4 w = lv l w $ by lv_eq [s4, s7c]
s8b: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ uni = uni $ by eq_refl
s8: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ fv uni (lv x4 w) = fv uni (lv l w) $ by fv_eq [s8b, s8a]
s9a: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ dt u M f w x8 = fv uni (lv x4 w) $ by eq_trans [s7, s6]
s9: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ dt u M f w x8 = fv uni (lv l w) $ by eq_trans [s9a, s8]
s10: $ f = ⟨ kc_srt , scons x4 ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = x4 , x8 ∊ fseq u , w ∊ lvals , l ∈ trees ω ⇒ x9 ∈ dt u M f w x8 ↔ (x9 ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w x8) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w x8) → apn x9 x ∈ fv uni (lv l w))) $ by b3_isw_srt [s6a, s6b, s5, s9, s2]
p1: $ G , f = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ k = ⟨ kc_s , scons x7 ∅ ⟩ ∧ l = x4 ∧ ra_isort x6 x7 x4 ∈ lrel , x8 ∊ fseq u ⇒ f = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ k = ⟨ kc_s , scons x7 ∅ ⟩ ∧ l = x4 ∧ ra_isort x6 x7 x4 ∈ lrel $ by ax
