a6: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ ⟨ kc_cons , scons e (scons x6 ∅) ⟩ = ⟨ kc_cons , scons e (scons x6 ∅) ⟩ $ by eq_refl
a7a: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ kc_s = kc_s $ by eq_refl
a7b: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ x7 = d $ by eq_sym [b7]
a7c: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ ∅ = ∅ $ by eq_refl
a7d: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ scons x7 ∅ = scons d ∅ $ by scons_eq [a7b, a7c]
a7: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ ⟨ kc_s , scons x7 ∅ ⟩ = ⟨ kc_s , scons d ∅ ⟩ $ by opair_eq [a7a, a7d]
a8: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ x0 = x0 $ by eq_refl
a9: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 = ra_cwf t1 t2 t3 t4 t5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ x0 $ by ra_cwf_eq [a1, a2, a3, a4, a5, a6, a7, a8]
a10: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ ra_cwf t1 t2 t3 t4 t5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons d ∅ ⟩ x0 ∈ lrel3 J $ by wcel_eq_l [a9, b14]
a11: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ isset ⟨ kc_cons , scons e (scons x6 ∅) ⟩ $ by opair_isset
a12: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) $ by weaken [#8]
