zr: $ G , z = ⟨ k , h ⟩ , r ∊ fseq u ⇒ r = r $ by eq_refl
zrs: $ G , z = ⟨ k , h ⟩ , r ∊ fseq u ⇒ scat r s = scat r s $ by eq_refl
z7: $ G , z = ⟨ k , h ⟩ , r ∊ fseq u ⇒ etel u (dsh u M s) z w r = etel u (dsh u M s) ⟨ k , h ⟩ w r $ by etel_eq [z5, zw, zr]
z8: $ G , z = ⟨ k , h ⟩ , r ∊ fseq u ⇒ etel u (dnf u M) ⟨ k , h ⟩ w (scat r s) = etel u (dnf u M) z w (scat r s) $ by etel_eq [z6, zw, zrs]
z9: $ G , z = ⟨ k , h ⟩ , r ∊ fseq u ⇒ etel u (dsh u M s) z w r = etel u (dnf u M) ⟨ k , h ⟩ w (scat r s) $ by eq_trans [z7, z4]
z10: $ G , z = ⟨ k , h ⟩ , r ∊ fseq u ⇒ etel u (dsh u M s) z w r = etel u (dnf u M) z w (scat r s) $ by eq_trans [z9, z8]
z11: $ G , z = ⟨ k , h ⟩ ⇒ r ∊ fseq u → etel u (dsh u M s) z w r = etel u (dnf u M) z w (scat r s) $ by imp_intro [z10]
z12: $ G , z = ⟨ k , h ⟩ ⇒ ∀ r (r ∊ fseq u → etel u (dsh u M s) z w r = etel u (dnf u M) z w (scat r s)) $ by all_intro [z11]
z13: $ G ⇒ isset ⟨ k , h ⟩ $ by opair_isset
z14: $ G ⇒ ⟨ k , h ⟩ ∈ b5_dp u M w s $ by wcel_cab_intro [z13, z12]

lemma b5_dsh_ind (G: hyps) (M: class) (u w s: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ trees ω ⊆ b5_dp u M w s $
----
n1: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ b5_dp u M w s ⇒ w ∊ lvals $ by weaken [#1]
n2: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ b5_dp u M w s ⇒ s ∊ fseq u $ by weaken [#2]
n3: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ b5_dp u M w s ⇒ k ∊ ω $ by ax
n4: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ b5_dp u M w s ⇒ h ∊ fseq (trees ω) $ by ax
n5: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ b5_dp u M w s ⇒ crn h ⊆ b5_dp u M w s $ by ax
n6: $ G , k ∊ ω , h ∊ fseq (trees ω) , crn h ⊆ b5_dp u M w s ⇒ ⟨ k , h ⟩ ∈ b5_dp u M w s $ by b5_dstep [n1, n2, n3, n4, n5]
n7: $ G , k ∊ ω , h ∊ fseq (trees ω) ⇒ crn h ⊆ b5_dp u M w s → ⟨ k , h ⟩ ∈ b5_dp u M w s $ by imp_intro [n6]
n8: $ G , k ∊ ω ⇒ h ∊ fseq (trees ω) → crn h ⊆ b5_dp u M w s → ⟨ k , h ⟩ ∈ b5_dp u M w s $ by imp_intro [n7]
n9: $ G ⇒ k ∊ ω → h ∊ fseq (trees ω) → crn h ⊆ b5_dp u M w s → ⟨ k , h ⟩ ∈ b5_dp u M w s $ by imp_intro [n8]
n10: $ G ⇒ ∀ h (k ∊ ω → h ∊ fseq (trees ω) → crn h ⊆ b5_dp u M w s → ⟨ k , h ⟩ ∈ b5_dp u M w s) $ by all_intro [n9]
n11: $ G ⇒ ∀ k ∀ h (k ∊ ω → h ∊ fseq (trees ω) → crn h ⊆ b5_dp u M w s → ⟨ k , h ⟩ ∈ b5_dp u M w s) $ by all_intro [n10]
n12: $ G ⇒ isset ω $ by omega_set
n13: $ G ⇒ trees ω ⊆ b5_dp u M w s $ by trees_ind_c [n12, n11]

lemma b5_etel_dsh (G: hyps) (M T: class) (u w s r: set): $ G ⇒ T ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dsh u M s) T w r = etel u (dnf u M) T w (scat r s) $
----
l1: $ G ⇒ trees ω ⊆ b5_dp u M w s $ by b5_dsh_ind [#2, #3]
l2: $ G ⇒ T ∈ b5_dp u M w s $ by wcel_subset [l1, #1]
t1: $ G , y = T , y ∊ b5_dp u M w s ⇒ y ∊ b5_dp u M w s $ by ax
t2: $ G , y = T , y ∊ b5_dp u M w s ⇒ ∀ o (o ∊ fseq u → etel u (dsh u M s) y w o = etel u (dnf u M) y w (scat o s)) $ by cab_elim [t1]
t3: $ G , y = T , y ∊ b5_dp u M w s ⇒ r ∊ fseq u → etel u (dsh u M s) y w r = etel u (dnf u M) y w (scat r s) $ by all_elim [t2]
t3a: $ G , y = T , y ∊ b5_dp u M w s ⇒ r ∊ fseq u $ by weaken [#4]
t4: $ G , y = T , y ∊ b5_dp u M w s ⇒ etel u (dsh u M s) y w r = etel u (dnf u M) y w (scat r s) $ by imp_elim [t3, t3a]
t5: $ G , y = T , y ∊ b5_dp u M w s ⇒ y = T $ by ax
t5s: $ G , y = T , y ∊ b5_dp u M w s ⇒ T = y $ by eq_sym [t5]
tw: $ G , y = T , y ∊ b5_dp u M w s ⇒ w = w $ by eq_refl
tr: $ G , y = T , y ∊ b5_dp u M w s ⇒ r = r $ by eq_refl
trs: $ G , y = T , y ∊ b5_dp u M w s ⇒ scat r s = scat r s $ by eq_refl
t6: $ G , y = T , y ∊ b5_dp u M w s ⇒ etel u (dsh u M s) T w r = etel u (dsh u M s) y w r $ by etel_eq [t5s, tw, tr]
t7: $ G , y = T , y ∊ b5_dp u M w s ⇒ etel u (dnf u M) y w (scat r s) = etel u (dnf u M) T w (scat r s) $ by etel_eq [t5, tw, trs]
t8: $ G , y = T , y ∊ b5_dp u M w s ⇒ etel u (dsh u M s) T w r = etel u (dnf u M) y w (scat r s) $ by eq_trans [t6, t4]
t9: $ G , y = T , y ∊ b5_dp u M w s ⇒ etel u (dsh u M s) T w r = etel u (dnf u M) T w (scat r s) $ by eq_trans [t8, t7]
l3: $ G ⇒ etel u (dsh u M s) T w r = etel u (dnf u M) T w (scat r s) $ by wcel_elim [l2, t9]

--| The context trees `z` for which `pis z b e` puts a valuation of `z` (over `s`) behind every path of `e`.
def b5_pp (U M W S: class) (.z .b .e .f .g .t .a .x .g2 .s2 .a2 .p: set): class = $ {z | ∀ b ∀ e ∀ f ∀ g ∀ t ∀ a (ra_pis z b e ∈ lrel → b ∊ trees ω → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) e W S → ∃ x ∃ g2 ∃ s2 ∃ a2 ∃ p (p ∊ esat U (dsh U M S) z W ∧ ⟨ x , ⟨ g2 , ⟨ s2 , a2 ⟩ ⟩ ⟩ ∈ etel U (dsh U M S) b W p ∧ f = scat x p))} $

lemma b5_pc_nil {x g2 s2 a2 p: set} (H: hyps) (M: class) (u w s c j z v o r q i k m: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ j ∊ fseq (trees ω) $ > $ H ⇒ crn j ⊆ b5_pp u M w s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_pis z v o ∈ lrel $ > $ H ⇒ v ∊ trees ω $ > $ H ⇒ ⟨ r , ⟨ q , ⟨ i , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w s $ > $ H ⇒ (z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m) → ∃ x ∃ g2 ∃ s2 ∃ a2 ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ x , ⟨ g2 , ⟨ s2 , a2 ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat x p) $
----
f1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ w ∊ lvals $ by weaken [#1]
f2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ s ∊ fseq u $ by weaken [#2]
f3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ j ∊ fseq (trees ω) $ by weaken [#3]
f4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ crn j ⊆ b5_pp u M w s $ by weaken [#4]
f5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ z = ⟨ c , j ⟩ $ by weaken [#5]
f6: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ra_pis z v o ∈ lrel $ by weaken [#6]
f7: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ v ∊ trees ω $ by weaken [#7]
f8: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ⟨ r , ⟨ q , ⟨ i , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w s $ by weaken [#8]
p0: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m $ by ax
q1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [p0]
qr1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ v = m ∧ o = m $ by and_elim_r [p0]
q2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ v = m $ by and_elim_l [qr1]
qr2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ o = m $ by and_elim_r [qr1]
ww: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ w = w $ by eq_refl
ss: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ s = s $ by eq_refl
n0: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ m = v $ by eq_sym [q2]
n1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ o = v $ by eq_trans [qr2, n0]
n2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ etel u (dnf u M) o w s = etel u (dnf u M) v w s $ by etel_eq [n1, ww, ss]
n3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ⟨ r , ⟨ q , ⟨ i , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) v w s $ by wcel_eq_r [n2, f8]
n4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ v ∈ trees ω $ by welc_wcel [f7]
d1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ d = ∅ $ by ax
d2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ∅ = d $ by eq_sym [d1]
d3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
d4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ d ∈ fseq u $ by wcel_eq_l [d2, d3]
d5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ d ∊ fseq u $ by wcel_welc [d4]
n5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ etel u (dsh u M s) v w d = etel u (dnf u M) v w (scat d s) $ by b5_etel_dsh [n4, f1, f2, d5]
n6a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ scat d s = scat ∅ s $ by scat_eq [d1, ss]
n6b: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ scat ∅ s = s $ by scat_empty_l [f2]
n6: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ scat d s = s $ by eq_trans [n6a, n6b]
vv: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ v = v $ by eq_refl
n7: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ etel u (dnf u M) v w (scat d s) = etel u (dnf u M) v w s $ by etel_eq [vv, ww, n6]
n8: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ etel u (dsh u M s) v w d = etel u (dnf u M) v w s $ by eq_trans [n5, n7]
n9: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ etel u (dnf u M) v w s = etel u (dsh u M s) v w d $ by eq_sym [n8]
n10: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ⟨ r , ⟨ q , ⟨ i , k ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w d $ by wcel_eq_r [n9, n3]
n11: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ esat u (dsh u M s) ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by esat_nil [f1]
n12: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ esat u (dsh u M s) z w = esat u (dsh u M s) ⟨ kc_nil , ∅ ⟩ w $ by esat_eq [q1, ww]
n13: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ esat u (dsh u M s) z w = csn ∅ $ by eq_trans [n12, n11]
n13s: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ csn ∅ = esat u (dsh u M s) z w $ by eq_sym [n13]
n14: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ d ∊ csn ∅ $ by csn_intro [d1]
n15: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ d ∊ esat u (dsh u M s) z w $ by welc_eq [n13s, n14]
rr: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ r = r $ by eq_refl
n16a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ scat r d = scat r ∅ $ by scat_eq [rr, d1]
n16b: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ scat r ∅ = r $ by scat_empty_r
n16c: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ scat r d = r $ by eq_trans [n16a, n16b]
n16: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ r = scat r d $ by eq_sym [n16c]
n17a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ⟨ r , ⟨ q , ⟨ i , k ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w d ∧ r = scat r d $ by and_intro [n10, n16]
n17: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ d ∊ esat u (dsh u M s) z w ∧ ⟨ r , ⟨ q , ⟨ i , k ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w d ∧ r = scat r d $ by and_intro [n15, n17a]
x1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ r , ⟨ q , ⟨ i , k ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat r p) $ by ex_intro [n17]
x2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ∃ a2 ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ r , ⟨ q , ⟨ i , a2 ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat r p) $ by ex_intro [x1]
x3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ∃ s2 ∃ a2 ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ r , ⟨ q , ⟨ s2 , a2 ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat r p) $ by ex_intro [x2]
x4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ∃ g2 ∃ s2 ∃ a2 ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ r , ⟨ g2 , ⟨ s2 , a2 ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat r p) $ by ex_intro [x3]
fin: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m , d = ∅ ⇒ ∃ x ∃ g2 ∃ s2 ∃ a2 ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ x , ⟨ g2 , ⟨ s2 , a2 ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat x p) $ by ex_intro [x4]
y0: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m ⇒ isset ∅ $ by ax_empty
fin2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m ⇒ ∃ x ∃ g2 ∃ s2 ∃ a2 ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ x , ⟨ g2 , ⟨ s2 , a2 ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat x p) $ by isset_elim [y0, fin]
end: $ H ⇒ (z = ⟨ kc_nil , ∅ ⟩ ∧ v = m ∧ o = m) → ∃ x ∃ g2 ∃ s2 ∃ a2 ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ x , ⟨ g2 , ⟨ s2 , a2 ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat x p) $ by imp_intro [fin2]

lemma b5_pc_cons {x g2 s2 a2 p: set} (H: hyps) (M: class) (u w s c j z v o r q i k x5 m x6 x7: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ j ∊ fseq (trees ω) $ > $ H ⇒ crn j ⊆ b5_pp u M w s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_pis z v o ∈ lrel $ > $ H ⇒ v ∊ trees ω $ > $ H ⇒ ⟨ r , ⟨ q , ⟨ i , k ⟩ ⟩ ⟩ ∈ etel u (dnf u M) o w s $ > $ H ⇒ (z = ⟨ kc_cons , scons x5 (scons x7 ∅) ⟩ ∧ v = m ∧ o = x6 ∧ ra_pis x7 ⟨ kc_pi , scons x5 (scons m ∅) ⟩ x6 ∈ lrel) → ∃ x ∃ g2 ∃ s2 ∃ a2 ∃ p (p ∊ esat u (dsh u M s) z w ∧ ⟨ x , ⟨ g2 , ⟨ s2 , a2 ⟩ ⟩ ⟩ ∈ etel u (dsh u M s) v w p ∧ r = scat x p) $
----
f1: $ H , z = ⟨ kc_cons , scons x5 (scons x7 ∅) ⟩ ∧ v = m ∧ o = x6 ∧ ra_pis x7 ⟨ kc_pi , scons x5 (scons m ∅) ⟩ x6 ∈ lrel , l = ⟨ kc_pi , scons x5 (scons m ∅) ⟩ ⇒ w ∊ lvals $ by weaken [#1]
f2: $ H , z = ⟨ kc_cons , scons x5 (scons x7 ∅) ⟩ ∧ v = m ∧ o = x6 ∧ ra_pis x7 ⟨ kc_pi , scons x5 (scons m ∅) ⟩ x6 ∈ lrel , l = ⟨ kc_pi , scons x5 (scons m ∅) ⟩ ⇒ s ∊ fseq u $ by weaken [#2]
