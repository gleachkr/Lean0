lemma b15_cond {i: set} (G: hyps i) (H J C D W R S: class) (u tb tP tT tnp tn tm0 tl tG2 tv: set): $ G ⇒ iwf u H J C D W R $ > $ G ⇒ ra_ind_data D tb tP tT ∈ lrel $ > $ G ⇒ ra_clen tP tnp ∈ lrel $ > $ G ⇒ ra_ntys tT tn tm0 ∈ lrel $ > $ G ⇒ ra_tys_wf D tn tnp tl ⟨ kc_nz , ∅ ⟩ tG2 tT ∈ lrel3 J $ > $ G ⇒ ¬ lv tl W = ∅ $ > $ G ⇒ S ∈ u $ > $ G ⇒ tv ∊ fseq u $ > $ G ⇒ cdm tv = intys D $ > $ G ⇒ ∀ i (i ∊ intys D → fv tv i = ityv u (dnf u (mcv H)) D i W) $ > $ G ⇒ b6_cond D tnp (ixs D W (isup (ijs u (dnf u (mcv H)) D W) S)) (scat tv R) $
