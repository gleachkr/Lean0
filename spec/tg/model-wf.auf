q156: $ G ⇒ fv (scons e (scons f (scons g (scons h ∅)))) (suc (suc (suc ∅))) = fv (scons h ∅) (∅) $ by eq_trans [q155, q151]
q157: $ G ⇒ fv (scons e (scons f (scons g (scons h ∅)))) (suc (suc (suc ∅))) = h $ by eq_trans [q156, q154]
q158: $ G ⇒ d = fv (scons a (scons b (scons c (scons d ∅)))) (suc (suc (suc ∅))) $ by eq_sym [q129]
q159: $ G ⇒ d = fv (scons e (scons f (scons g (scons h ∅)))) (suc (suc (suc ∅))) $ by eq_trans [q158, q101]
q160: $ G ⇒ d = h $ by eq_trans [q159, q157]
q161: $ G ⇒ c = g ∧ d = h $ by and_intro [q99, q160]
q162: $ G ⇒ b = f ∧ c = g ∧ d = h $ by and_intro [q52, q161]
q163: $ G ⇒ a = e ∧ b = f ∧ c = g ∧ d = h $ by and_intro [q19, q162]

lemma b6_ninj1 (G: hyps) (Z K: class) (a e: set): $ G ⇒ Z = ⟨ K , scons a ∅ ⟩ $ > $ G ⇒ Z = ⟨ K , scons e ∅ ⟩ $ > $ G ⇒ K ∈ ω $ > $ G ⇒ a = e $
----
q1: $ G ⇒ ⟨ K , scons a ∅ ⟩ = Z $ by eq_sym [#1]
q2: $ G ⇒ ⟨ K , scons a ∅ ⟩ = ⟨ K , scons e ∅ ⟩ $ by eq_trans [q1, #2]
q3: $ G ⇒ isset K $ by wcel_isset [#3]
q4: $ G ⇒ isset ∅ $ by ax_empty
q5: $ G ⇒ isset (scons a ∅) $ by scons_set [q4]
q6: $ G ⇒ isset ∅ $ by ax_empty
q7: $ G ⇒ isset (scons e ∅) $ by scons_set [q6]
q8: $ G ⇒ K = K ∧ scons a ∅ = scons e ∅ $ by opair_inj_c [q2, q3, q5, q3, q7]
q9: $ G ⇒ scons a ∅ = scons e ∅ $ by and_elim_r [q8]
q10: $ G ⇒ a = e $ by b6_sc1 [q9]

lemma b6_ninj2 (G: hyps) (Z K: class) (a b e f: set): $ G ⇒ Z = ⟨ K , scons a (scons b ∅) ⟩ $ > $ G ⇒ Z = ⟨ K , scons e (scons f ∅) ⟩ $ > $ G ⇒ K ∈ ω $ > $ G ⇒ a = e ∧ b = f $
----
q1: $ G ⇒ ⟨ K , scons a (scons b ∅) ⟩ = Z $ by eq_sym [#1]
q2: $ G ⇒ ⟨ K , scons a (scons b ∅) ⟩ = ⟨ K , scons e (scons f ∅) ⟩ $ by eq_trans [q1, #2]
q3: $ G ⇒ isset K $ by wcel_isset [#3]
q4: $ G ⇒ isset ∅ $ by ax_empty
q5: $ G ⇒ isset (scons b ∅) $ by scons_set [q4]
q6: $ G ⇒ isset (scons a (scons b ∅)) $ by scons_set [q5]
q7: $ G ⇒ isset ∅ $ by ax_empty
q8: $ G ⇒ isset (scons f ∅) $ by scons_set [q7]
q9: $ G ⇒ isset (scons e (scons f ∅)) $ by scons_set [q8]
q10: $ G ⇒ K = K ∧ scons a (scons b ∅) = scons e (scons f ∅) $ by opair_inj_c [q2, q3, q6, q3, q9]
q11: $ G ⇒ scons a (scons b ∅) = scons e (scons f ∅) $ by and_elim_r [q10]
q12: $ G ⇒ a = e ∧ b = f $ by b6_sc2 [q11]

lemma b6_ninj3 (G: hyps) (Z K: class) (a b c e f g: set): $ G ⇒ Z = ⟨ K , scons a (scons b (scons c ∅)) ⟩ $ > $ G ⇒ Z = ⟨ K , scons e (scons f (scons g ∅)) ⟩ $ > $ G ⇒ K ∈ ω $ > $ G ⇒ a = e ∧ b = f ∧ c = g $
----
q1: $ G ⇒ ⟨ K , scons a (scons b (scons c ∅)) ⟩ = Z $ by eq_sym [#1]
q2: $ G ⇒ ⟨ K , scons a (scons b (scons c ∅)) ⟩ = ⟨ K , scons e (scons f (scons g ∅)) ⟩ $ by eq_trans [q1, #2]
q3: $ G ⇒ isset K $ by wcel_isset [#3]
q4: $ G ⇒ isset ∅ $ by ax_empty
q5: $ G ⇒ isset (scons c ∅) $ by scons_set [q4]
q6: $ G ⇒ isset (scons b (scons c ∅)) $ by scons_set [q5]
q7: $ G ⇒ isset (scons a (scons b (scons c ∅))) $ by scons_set [q6]
q8: $ G ⇒ isset ∅ $ by ax_empty
q9: $ G ⇒ isset (scons g ∅) $ by scons_set [q8]
q10: $ G ⇒ isset (scons f (scons g ∅)) $ by scons_set [q9]
q11: $ G ⇒ isset (scons e (scons f (scons g ∅))) $ by scons_set [q10]
q12: $ G ⇒ K = K ∧ scons a (scons b (scons c ∅)) = scons e (scons f (scons g ∅)) $ by opair_inj_c [q2, q3, q7, q3, q11]
q13: $ G ⇒ scons a (scons b (scons c ∅)) = scons e (scons f (scons g ∅)) $ by and_elim_r [q12]
q14: $ G ⇒ a = e ∧ b = f ∧ c = g $ by b6_sc3 [q13]

lemma b6_kc_s (H: hyps) (z a: set): $ H ⇒ z ∊ ofsort lsig lopen ks_nat $ > $ H ⇒ z = ⟨ kc_s , scons a ∅ ⟩ $ > $ H ⇒ a ∊ ofsort lsig lopen ks_nat $
----
q1: $ H ⇒ (z = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x (z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $ by ofsort_nat_cases [#1]
q2: $ H , z = ⟨ kc_nz , ∅ ⟩ ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by ax
q3: $ H , z = ⟨ kc_nz , ∅ ⟩ ⇒ z = ⟨ kc_s , scons a ∅ ⟩ $ by weaken [#2]
q4: $ H , z = ⟨ kc_nz , ∅ ⟩ ⇒ kc_nz ∈ ω $ by kc_nz_omega
q5: $ H , z = ⟨ kc_nz , ∅ ⟩ ⇒ kc_s ∈ ω $ by kc_s_omega
q6: $ H , z = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_nz = kc_s $ by kc_nz_ne_s
q7: $ H , z = ⟨ kc_nz , ∅ ⟩ ⇒ a ∊ ofsort lsig lopen ks_nat $ by b6_clash [q2, q3, q6, q4, q5]
q8: $ H , z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat $ by ax
q9: $ H , z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_s , scons x ∅ ⟩ $ by and_elim_l [q8]
q10: $ H , z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ x ∊ ofsort lsig lopen ks_nat $ by and_elim_r [q8]
q11: $ H , z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_s , scons a ∅ ⟩ $ by weaken [#2]
q12: $ H , z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ kc_s ∈ ω $ by kc_s_omega
q13: $ H , z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ x = a $ by b6_ninj1 [q9, q11, q12]
q14: $ H , z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ a ∊ ofsort lsig lopen ks_nat $ by welc_eq_set [q13, q10]
q15: $ H , ∃ x (z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ ∃ x (z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $ by ax
q16: $ H , ∃ x (z = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ a ∊ ofsort lsig lopen ks_nat $ by ex_elim [q15, q14]
q17: $ H ⇒ a ∊ ofsort lsig lopen ks_nat $ by or_elim [q1, q7, q16]

lemma b6_kids_s (G: hyps) (a: set): $ G ⇒ ⟨ kc_s , scons a ∅ ⟩ ∈ ofsort lsig lopen ks_nat $ > $ G ⇒ a ∊ ofsort lsig lopen ks_nat $
----
q1: $ G , z = ⟨ kc_s , scons a ∅ ⟩ , z ∊ ofsort lsig lopen ks_nat ⇒ z ∊ ofsort lsig lopen ks_nat $ by ax
q2: $ G , z = ⟨ kc_s , scons a ∅ ⟩ , z ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_s , scons a ∅ ⟩ $ by ax
q3: $ G , z = ⟨ kc_s , scons a ∅ ⟩ , z ∊ ofsort lsig lopen ks_nat ⇒ a ∊ ofsort lsig lopen ks_nat $ by b6_kc_s [q1, q2]
q4: $ G ⇒ a ∊ ofsort lsig lopen ks_nat $ by wcel_elim [#1, q3]

lemma b6_kc_bvar (H: hyps) (z a: set): $ H ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ H ⇒ z = ⟨ kc_bvar , scons a ∅ ⟩ $ > $ H ⇒ a ∊ ofsort lsig lopen ks_nat $
----
q1: $ H ⇒ ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ∨ ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_pi , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_cst , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_atom ∧ y ∊ ofsort lsig lopen ks_lvls) ∨ ∃ x (z = ⟨ kc_lit , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) ∨ ∃ x ∃ y (z = ⟨ kc_ind_ty , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_ind_ctor , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_nat) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_ind_rec , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_proj , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_expr) ∨ ∃ x (z = ⟨ kc_quot , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (z = ⟨ kc_quot_mk , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (z = ⟨ kc_quot_lift , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (z = ⟨ kc_quot_ind , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) $ by ofsort_expr_cases [#1]
q2: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat $ by ax
q3: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons x ∅ ⟩ $ by and_elim_l [q2]
q4: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ x ∊ ofsort lsig lopen ks_nat $ by and_elim_r [q2]
q5: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons a ∅ ⟩ $ by weaken [#2]
q6: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
q7: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ x = a $ by b6_ninj1 [q3, q5, q6]
q8: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ a ∊ ofsort lsig lopen ks_nat $ by welc_eq_set [q7, q4]
q9: $ H , ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $ by ax
q10: $ H , ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ a ∊ ofsort lsig lopen ks_nat $ by ex_elim [q9, q8]
q11: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl $ by ax
q12: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_srt , scons x ∅ ⟩ $ by and_elim_l [q11]
q13: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ x ∊ ofsort lsig lopen ks_lvl $ by and_elim_r [q11]
q14: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_bvar , scons a ∅ ⟩ $ by weaken [#2]
q15: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ kc_srt ∈ ω $ by kc_srt_omega
q16: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
q17: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ ¬ kc_bvar = kc_srt $ by kc_bvar_ne_srt
q18: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ ¬ kc_srt = kc_bvar $ by ne_sym [q17]
q19: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ a ∊ ofsort lsig lopen ks_nat $ by b6_clash [q12, q14, q18, q15, q16]
q20: $ H , ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ⇒ ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) $ by ax
q21: $ H , ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ⇒ a ∊ ofsort lsig lopen ks_nat $ by ex_elim [q20, q19]
q22: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by ax
q23: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_app , scons x (scons y ∅) ⟩ $ by and_elim_l [q22]
q24: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by and_elim_r [q22]
q25: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr $ by and_elim_l [q24]
q26: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ y ∊ ofsort lsig lopen ks_expr $ by and_elim_r [q24]
q27: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_bvar , scons a ∅ ⟩ $ by weaken [#2]
q28: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ kc_app ∈ ω $ by kc_app_omega
q29: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
q30: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ ¬ kc_bvar = kc_app $ by kc_bvar_ne_app
q31: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ ¬ kc_app = kc_bvar $ by ne_sym [q30]
q32: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_nat $ by b6_clash [q23, q27, q31, q28, q29]
q33: $ H , ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ⇒ ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) $ by ax
q34: $ H , ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ⇒ a ∊ ofsort lsig lopen ks_nat $ by ex_elim [q33, q32]
q35: $ H , ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ⇒ ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) $ by ax
q36: $ H , ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ⇒ a ∊ ofsort lsig lopen ks_nat $ by ex_elim [q35, q34]
q37: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by ax
q38: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_lam , scons x (scons y ∅) ⟩ $ by and_elim_l [q37]
q39: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by and_elim_r [q37]
q40: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr $ by and_elim_l [q39]
q41: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ y ∊ ofsort lsig lopen ks_expr $ by and_elim_r [q39]
