c1: $ H , k = x0 ∧ z = ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_app , scons x7 (scons x1 ∅) ⟩ ∧ ra_inst x0 x5 x6 x7 ∈ lrel ∧ ra_inst x0 x3 x6 x1 ∈ lrel ⇒ etel u (dnf u M) e w r = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x7 w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) x1) w r) a ⟩ ⟩ ⟩)} $ by eq_trans [w4, w1]
c2: $ H , k = x0 ∧ z = ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_app , scons x7 (scons x1 ∅) ⟩ ∧ ra_inst x0 x5 x6 x7 ∈ lrel ∧ ra_inst x0 x3 x6 x1 ∈ lrel ⇒ etel u (dnf u M) e w r = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x5 w o ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) x3) w o) a ⟩ ⟩ ⟩)} $ by eq_trans [c1, w3]
c3: $ H , k = x0 ∧ z = ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_app , scons x7 (scons x1 ∅) ⟩ ∧ ra_inst x0 x5 x6 x7 ∈ lrel ∧ ra_inst x0 x3 x6 x1 ∈ lrel ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x5 w o ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) x3) w o) a ⟩ ⟩ ⟩)} = etel u (dnf u M) ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ w o $ by eq_sym [w2]
c4: $ H , k = x0 ∧ z = ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_app , scons x7 (scons x1 ∅) ⟩ ∧ ra_inst x0 x5 x6 x7 ∈ lrel ∧ ra_inst x0 x3 x6 x1 ∈ lrel ⇒ etel u (dnf u M) e w r = etel u (dnf u M) ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ w o $ by eq_trans [c2, c3]
c5: $ H , k = x0 ∧ z = ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_app , scons x7 (scons x1 ∅) ⟩ ∧ ra_inst x0 x5 x6 x7 ∈ lrel ∧ ra_inst x0 x3 x6 x1 ∈ lrel ⇒ etel u (dnf u M) ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ w o = etel u (dnf u M) z w o $ by eq_sym [w5]
fin: $ H , k = x0 ∧ z = ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_app , scons x7 (scons x1 ∅) ⟩ ∧ ra_inst x0 x5 x6 x7 ∈ lrel ∧ ra_inst x0 x3 x6 x1 ∈ lrel ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by eq_trans [c4, c5]
end: $ H ⇒ (k = x0 ∧ z = ⟨ kc_app , scons x5 (scons x3 ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_app , scons x7 (scons x1 ∅) ⟩ ∧ ra_inst x0 x5 x6 x7 ∈ lrel ∧ ra_inst x0 x3 x6 x1 ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by imp_intro [fin]

lemma b5_ibody (G: hyps) (M: class) (u w q s k h p r o b m x: set): $ G ⇒ s ∊ fseq u $ > $ G ⇒ dt u M q w s ∈ u $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = fv nvf k $ > $ G ⇒ r = scat p s $ > $ G ⇒ o = scat p (scons (dt u M q w s) s) $ > $ G ⇒ b ∈ b5_ip u M w q s $ > $ G ⇒ ra_inst h b q m ∈ lrel $ > $ G ⇒ fv nvf h = suc (fv nvf k) $ > $ G ⇒ x ∊ u $ > $ G ⇒ etel u (dnf u M) m w (scons x r) = etel u (dnf u M) b w (scons x o) $
----
a3: $ G ⇒ scons x p ∈ fseq u $ by scons_fseq [#10, #3]
a4: $ G ⇒ cdm (scons x p) = suc (cdm p) $ by scons_len [#3]
a5: $ G ⇒ suc (cdm p) = suc (fv nvf k) $ by suc_eq [#4]
a6: $ G ⇒ suc (fv nvf k) = fv nvf h $ by eq_sym [#9]
a7a: $ G ⇒ cdm (scons x p) = suc (fv nvf k) $ by eq_trans [a4, a5]
a7: $ G ⇒ cdm (scons x p) = fv nvf h $ by eq_trans [a7a, a6]
a8a: $ G ⇒ isset r $ by isset_var
a8: $ G ⇒ isset (scons x r) $ by scons_set [a8a]
b2: $ G ⇒ s ∈ fseq u $ by welc_wcel [#1]
b3: $ G ⇒ scons (dt u M q w s) s ∈ fseq u $ by scons_fseq_c [#2, b2]
b4: $ G ⇒ p ∈ fseq u $ by welc_wcel [#3]
b5: $ G ⇒ isset x $ by isset_var
a9: $ G ⇒ scat (scons x p) s = scons x (scat p s) $ by scat_scons [#3, #1]
a10a: $ G ⇒ x = x $ by eq_refl
a10: $ G ⇒ scons x r = scons x (scat p s) $ by scons_eq [a10a, #5]
a11a: $ G ⇒ scons x (scat p s) = scat (scons x p) s $ by eq_sym [a9]
a11: $ G ⇒ scons x r = scat (scons x p) s $ by eq_trans [a10, a11a]
a12a: $ G ⇒ isset o $ by isset_var
a12: $ G ⇒ isset (scons x o) $ by scons_set [a12a]
a13: $ G ⇒ scat (scons x p) (scons (dt u M q w s) s) = scons x (scat p (scons (dt u M q w s) s)) $ by scat_scons_c [b5, b4, b3]
a14: $ G ⇒ scons x o = scons x (scat p (scons (dt u M q w s) s)) $ by scons_eq [a10a, #6]
a15a: $ G ⇒ scons x (scat p (scons (dt u M q w s) s)) = scat (scons x p) (scons (dt u M q w s) s) $ by eq_sym [a13]
a15: $ G ⇒ scons x o = scat (scons x p) (scons (dt u M q w s) s) $ by eq_trans [a14, a15a]
a16: $ G ⇒ etel u (dnf u M) m w (scons x r) = etel u (dnf u M) b w (scons x o) $ by b5_iih [#7, #8, a3, a7, a8, a11, a12, a15]

lemma b5_ki_pi (H: hyps) (M: class) (u w q s k z e p r o c j x0 x9 b x6 l m: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ dt u M q w s ∈ u $ > $ H ⇒ etel u (dnf u M) q w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ > $ H ⇒ crn j ⊆ b5_ip u M w q s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_inst k z q e ∈ lrel $ > $ H ⇒ p ∊ fseq u $ > $ H ⇒ cdm p = fv nvf k $ > $ H ⇒ r = scat p s $ > $ H ⇒ o = scat p (scons (dt u M q w s) s) $ > $ H ⇒ (k = x0 ∧ z = ⟨ kc_pi , scons x9 (scons b ∅) ⟩ ∧ q = x6 ∧ e = ⟨ kc_pi , scons l (scons m ∅) ⟩ ∧ ra_inst x0 x9 x6 l ∈ lrel ∧ ra_inst ⟨ kc_s , scons x0 ∅ ⟩ b x6 m ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $
