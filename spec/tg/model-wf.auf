q19: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z ∊ ofsort lsig lopen ks_ctx , t2 ∊ ofsort lsig lopen ks_expr ⇒ t2 ∊ ofsort lsig lopen ks_expr $ by ax
