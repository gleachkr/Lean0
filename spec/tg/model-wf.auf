f0: $ G ⇒ isset n $ by isset_var
f1: $ G ⇒ fv nvf n ∈ ω $ by nvf_omega [f0]
f2: $ G ⇒ i ∈ fv nvf n $ by welc_wcel [#2]
f3: $ G ⇒ i ∈ ω $ by omega_elem_omega_c [f2, f1]
f4: $ G ⇒ i ∊ ω $ by wcel_welc [f3]
f5: $ G ⇒ ∀ x4 ∀ x5 ∀ x6 (ra_ntys x4 x5 x6 ∈ lrel → i ∊ fv nvf x5 → ∃ t ∃ o ∃ p (fv nvf t = i ∧ ra_nth_ty x4 t o p ∈ lrel)) $ by omega_ind_named [zs12, ys12, f4]
f6: $ G ⇒ ∀ x5 ∀ x6 (ra_ntys r x5 x6 ∈ lrel → i ∊ fv nvf x5 → ∃ t ∃ o ∃ p (fv nvf t = i ∧ ra_nth_ty r t o p ∈ lrel)) $ by all_elim [f5]
f7: $ G ⇒ ∀ x6 (ra_ntys r n x6 ∈ lrel → i ∊ fv nvf n → ∃ t ∃ o ∃ p (fv nvf t = i ∧ ra_nth_ty r t o p ∈ lrel)) $ by all_elim [f6]
f8: $ G ⇒ ra_ntys r n m ∈ lrel → i ∊ fv nvf n → ∃ t ∃ o ∃ p (fv nvf t = i ∧ ra_nth_ty r t o p ∈ lrel) $ by all_elim [f7]
f9: $ G ⇒ i ∊ fv nvf n → ∃ t ∃ o ∃ p (fv nvf t = i ∧ ra_nth_ty r t o p ∈ lrel) $ by imp_elim [f8, #1]
f10: $ G ⇒ ∃ t ∃ o ∃ p (fv nvf t = i ∧ ra_nth_ty r t o p ∈ lrel) $ by imp_elim [f9, #2]

lemma b3_tys_head {kk ll: set} (G: hyps kk ll) (J: class) (dd nv np lv iv cx bb ff y1 y2 y3: set): $ G ⇒ ra_tys_wf dd nv np lv iv cx bb ∈ lrel3 J $ > $ G ⇒ bb = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ > $ G ⇒ ff = y1 $ > $ G ⇒ ∃ kk ∃ ll (ra_isort ff kk ll ∈ lrel ∧ lveq ll lv) $
----
n0: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tnil , ∅ ⟩ $ by ax
