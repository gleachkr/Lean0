d1: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ bb = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ by weaken [#2]
d2: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ = bb $ by eq_sym [cl6]
d3: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ by eq_trans [d2, d1]
d4: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
d5: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ isset kc_tcons $ by wcel_isset [d4]
d6: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ x1 = y1 ∧ p = y2 ∧ c = y3 $ by node3_inj [d5, d3]
d7: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ p = y2 ∧ c = y3 $ by and_elim_r [d6]
d8: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ c = y3 $ by and_elim_r [d7]
d9: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ u = dd $ by eq_sym [cl0]
d10: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ v = nv $ by eq_sym [cl1]
d11: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ w = np $ by eq_sym [cl2]
d12: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ y = lv $ by eq_sym [cl3]
d13: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ r = iv $ by eq_sym [cl4]
d14: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ x0 = cx $ by eq_sym [cl5]
d15: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ kc_s = kc_s $ by eq_refl
d16: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ ∅ = ∅ $ by eq_refl
d17: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ scons r ∅ = scons iv ∅ $ by scons_eq [d13, d16]
d18: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ ⟨ kc_s , scons r ∅ ⟩ = ⟨ kc_s , scons iv ∅ ⟩ $ by opair_eq [d15, d17]
d19: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c = ra_tys_wf dd nv np lv ⟨ kc_s , scons iv ∅ ⟩ cx y3 $ by ra_tys_wf_eq [d9, d10, d11, d12, d18, d14, d8]
d20: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tcons , scons x1 (scons p (scons c ∅)) ⟩ ∧ ra_isort x1 o z ∈ lrel ∧ lveq z y ∧ ra_ctors_wf u v w y r x0 p ∈ lrel3 J ∧ ra_tys_wf u v w y ⟨ kc_s , scons r ∅ ⟩ x0 c ∈ lrel3 J ⇒ ra_tys_wf dd nv np lv ⟨ kc_s , scons iv ∅ ⟩ cx y3 ∈ lrel3 J $ by wcel_eq_l [d19, cr9]
ney6: $ G , ∃ x0 (dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tnil , ∅ ⟩) ⇒ ∃ x0 (dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tnil , ∅ ⟩) $ by ax
