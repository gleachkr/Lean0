q506: $ G , t1 = x1 ∧ z = h ∧ t3 = x2 ∧ t4 = h ∧ ra_closed x4 h ∈ lrel ∧ ra_le x4 x1 ∈ lrel ⇒ t1 = x1 $ by and_elim_l [q505]
