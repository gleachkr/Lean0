bs10: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ kr_nth_ty ∈ ω $ by kr_nth_ty_omega
bs11: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ isset kr_nth_ty $ by wcel_isset [bs10]
bs12: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ x9 ∊ trees ω ∧ q ∊ trees ω ∧ x7 ∊ trees ω ∧ x8 ∊ trees ω $ by lrel_args4 [bs9, bs11]
bs13: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ q ∊ trees ω ∧ x7 ∊ trees ω ∧ x8 ∊ trees ω $ by and_elim_r [bs12]
bs14: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ q ∊ trees ω $ by and_elim_l [bs13]
bs15: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ q ∈ trees ω $ by welc_wcel [bs14]
bs16: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ nvf = nvf $ by eq_refl
bs17: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ fv nvf g = fv nvf ⟨ kc_s , scons q ∅ ⟩ $ by fv_eq [bs16, bs4]
bs18: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ fv nvf ⟨ kc_s , scons q ∅ ⟩ = suc (fv nvf q) $ by nvf_s [bs15]
bs19: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ fv nvf g = suc (fv nvf q) $ by eq_trans [bs17, bs18]
bs20: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ fv nvf g = x2 $ by ax
bs21: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ suc (fv nvf q) = fv nvf g $ by eq_sym [bs19]
bs22: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ suc (fv nvf q) = x2 $ by eq_trans [bs21, bs20]
bs23: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ x2 = ∅ $ by ax
