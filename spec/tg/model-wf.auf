lemma b4_lvf_clip (G: hyps) (X: class): $ G ⇒ fv lvf X = fv lvf (sclip X) $
----
l1: $ G ⇒ functional (cgr3 k x0 v (lvb k x0 v)) $ by cgr3_functional
l2: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ rel lvf $ by trc_rel_c [l2, l1]
l4: $ G ⇒ cdm lvf = trees ω $ by trc_cdm_c [l2, l1]
l5: $ G ⇒ cdm lvf ⊆ trees ω $ by eq_subset [l4]
l6: $ G ⇒ fv lvf X = fv lvf (sclip X) $ by b4_fv_clip [l3, l5]

lemma b4_lv_cl (G: hyps) (L W: class) (l: set): $ G ⇒ l = sclip L $ > $ G ⇒ lv l W = lv L W $
----
l1: $ G ⇒ fv lvf L = fv lvf (sclip L) $ by b4_lvf_clip
l2: $ G ⇒ sclip L = l $ by eq_sym [#1]
l3: $ G ⇒ lvf = lvf $ by eq_refl
l4: $ G ⇒ fv lvf (sclip L) = fv lvf l $ by fv_eq [l3, l2]
l5: $ G ⇒ fv lvf L = fv lvf l $ by eq_trans [l1, l4]
l6: $ G ⇒ fv lvf l = fv lvf L $ by eq_sym [l5]
l7: $ G ⇒ W = W $ by eq_refl
l8: $ G ⇒ lv l W = lv L W $ by ap_eq [l6, l7]

lemma b4_isort_cl (G: hyps) (F K L: class) (f k l: set): $ G ⇒ f = sclip F $ > $ G ⇒ k = sclip K $ > $ G ⇒ l = sclip L $ > $ G ⇒ ra_isort F K L = ra_isort f k l $
----
l0: $ G ⇒ ∅ = ∅ $ by eq_refl
l1: $ G ⇒ scons L ∅ = scons l ∅ $ by b4_scons_cl [#3, l0]
l2: $ G ⇒ scons K (scons L ∅) = scons k (scons l ∅) $ by b4_scons_cl [#2, l1]
l3: $ G ⇒ scons F (scons K (scons L ∅)) = scons f (scons k (scons l ∅)) $ by b4_scons_cl [#1, l2]
l4: $ G ⇒ kr_isort = kr_isort $ by eq_refl
l5: $ G ⇒ ra_isort F K L = ra_isort f k l $ by opair_eq [l4, l3]

lemma b4_ityf_clip (G: hyps) (D J F: class): $ G ⇒ ityf D J F $ > $ G ⇒ ityf D J (sclip F) $
----
n1: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ ra_nth_ty t n F c ∈ lrel $ by ax
n2: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ c = c $ by eq_refl
n3: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ ∅ = ∅ $ by eq_refl
n4: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ scons c ∅ = scons c ∅ $ by scons_eq [n2, n3]
n5: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ scons F (scons c ∅) = scons (sclip F) (scons c ∅) $ by b4_scons_clip
n6: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ n = n $ by eq_refl
n7: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ scons n (scons F (scons c ∅)) = scons n (scons (sclip F) (scons c ∅)) $ by scons_eq [n6, n5]
n8: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ t = t $ by eq_refl
n9: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ scons t (scons n (scons F (scons c ∅))) = scons t (scons n (scons (sclip F) (scons c ∅))) $ by scons_eq [n8, n7]
n10: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ kr_nth_ty = kr_nth_ty $ by eq_refl
n11: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ ra_nth_ty t n F c = ra_nth_ty t n (sclip F) c $ by opair_eq [n10, n9]
n12: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ ra_nth_ty t n (sclip F) c ∈ lrel $ by wcel_eq_l [n11, n1]
n13: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ iprt D p t $ by ax
n14: $ G , iprt D p t , fv nvf n = J , ra_nth_ty t n F c ∈ lrel ⇒ fv nvf n = J $ by ax
