q1: $ G ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ b ∃ p ∃ x3 ∃ t ∃ x4 ∃ n ∃ m ∃ k ∃ x5 ∃ l ∃ f ∃ c (tc = x0 ∧ d = x2 ∧ ra_tys_ok x0 x2 ∈ lrel3 J ∧ ra_ind_data x2 b p t ∈ lrel ∧ ra_clen p x4 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_capp p x0 x1 ∈ lrel ∧ ra_nth_ty t ⟨ kc_nz , ∅ ⟩ f c ∈ lrel ∧ ra_isort f k l ∈ lrel ∧ ra_tys_wf x2 n x4 l ⟨ kc_nz , ∅ ⟩ x1 t ∈ lrel3 J ∧ ra_ind_nested x2 x3 ∈ lrel ∧ ra_ndecl x3 n x5 ∈ lrel ∧ ra_nst_ok x0 x2 x5 x3 ∈ lrel3 J) $ by lrel3_ind_wf_cases [#5]
