def b6_Qc (U M W P T I: class) (.y .x .q .v .e .g .t .a: set): class = $ {y | ∃ x ∃ q ∃ v ∃ e (ra_nth_ty T I v e ∈ lrel ∧ q ∊ esat U (dnf U M) P W ∧ y = scat x q ∧ ∃ g ∃ t ∃ a (⟨ x , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) v W q))} $

def b6_vt (U M W D V: class) (.i .b: set): fml = $ ∀ i ∀ b (i ∊ cdm V → b ∊ trees ω → fv nvf b = i → dt U M ⟨ kc_ind_ty , scons D (scons b ∅) ⟩ W ∅ = fv V i) $

def b6_cond (D NP X Y: class) (.o .m .q .e .g: set): fml = $ ∀ o ∀ m ∀ q (ra_nidx D o m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf NP) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv X (fv nvf o)) q → ∃ g (g ∊ apn (fv Y (fv nvf o)) q))) $

lemma b6_res_isort (G: hyps) {o l: set} (t1 t3 t5 t9 t13 t14 t15 t16 t17 t18 t20 t21: set): $ G ⇒ ra_ind_data t1 t9 t13 t14 ∈ lrel $ > $ G ⇒ ra_nth_ty t14 t5 t15 t16 ∈ lrel $ > $ G ⇒ ra_pis t13 t15 t17 ∈ lrel $ > $ G ⇒ ra_lift t20 ⟨ kc_nz , ∅ ⟩ t17 t18 ∈ lrel $ > $ G ⇒ ra_clen t13 t3 ∈ lrel $ > $ G ⇒ ra_nidx t1 t5 t21 ∈ lrel $ > $ G ⇒ ∃ o ∃ l (ra_isort t18 o l ∈ lrel ∧ fv nvf o = nadd (fv nvf t3) (fv nvf t21)) $
----
q1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (t1 = x1 ∧ t5 = x5 ∧ t21 = x6 ∧ ra_ind_data x1 x2 x3 x4 ∈ lrel ∧ ra_nth_ty x4 x5 x7 x8 ∈ lrel ∧ ra_isort x7 x6 x9 ∈ lrel) $ by lrel_nidx_cases [#6]
q2: $ G , t1 = x1 ∧ t5 = x5 ∧ t21 = x6 ∧ ra_ind_data x1 x2 x3 x4 ∈ lrel ∧ ra_nth_ty x4 x5 x7 x8 ∈ lrel ∧ ra_isort x7 x6 x9 ∈ lrel ⇒ t1 = x1 ∧ t5 = x5 ∧ t21 = x6 ∧ ra_ind_data x1 x2 x3 x4 ∈ lrel ∧ ra_nth_ty x4 x5 x7 x8 ∈ lrel ∧ ra_isort x7 x6 x9 ∈ lrel $ by ax
q3: $ G , t1 = x1 ∧ t5 = x5 ∧ t21 = x6 ∧ ra_ind_data x1 x2 x3 x4 ∈ lrel ∧ ra_nth_ty x4 x5 x7 x8 ∈ lrel ∧ ra_isort x7 x6 x9 ∈ lrel ⇒ t1 = x1 $ by and_elim_l [q2]
