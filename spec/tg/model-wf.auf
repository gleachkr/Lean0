def b7_pm (U M W D N Q X0: class) (.y .d .a .b .i: set): class = $ {y | ∀ d ∀ a ∀ b (ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → a ∊ fseq U → b ∊ fseq U → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → b7_hw D X0 a b d Q → dt U M y W a ⊆ dt U M y W b)} $

lemma b7_pm_i {d a b i: set} (G: hyps) (M D N Q X0: class) (u w y: set): $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) , b7_hw D X0 a b d Q ⇒ dt u M y w a ⊆ dt u M y w b $ > $ G ⇒ y ∊ b7_pm u M w D N Q X0 $
----
l0: $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) ⇒ b7_hw D X0 a b d Q → dt u M y w a ⊆ dt u M y w b $ by imp_intro [#1]
