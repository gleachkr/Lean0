g1: $ G ⇒ a = ⟨ kc_tnil , ∅ ⟩ ∨ ∃ x ∃ y ∃ u (a = ⟨ kc_tcons , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors ∧ u ∊ ofsort lsig lopen ks_tys) $ by ofsort_tys_cases [#1]
g2: $ G ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors ∧ h ∊ ofsort lsig lopen ks_tys $ by or_elim [g1, n12, e6]

lemma b3_nty_step {x i: set} (G: hyps) (a b f e: set): $ G ⇒ a ∊ ofsort lsig lopen ks_tys $ > $ G ⇒ ra_nth_ty a b f e ∈ lrel $ > $ G ⇒ ∀ x ∀ i (x ∊ ofsort lsig lopen ks_tys → ra_nth_ty x i f e ∈ lrel → suc (fv nvf i) = fv nvf b → f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors) $ > $ G ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $
----
p1: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u $ by ax
p2: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ $ by and_elim_l [p1]
p3: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u $ by and_elim_r [p1]
p4: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ f = y ∧ e = u $ by and_elim_r [p3]
p5: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ f = y $ by and_elim_l [p4]
p6: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ e = u $ by and_elim_r [p4]
p7: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ a ∊ ofsort lsig lopen ks_tys $ by weaken [#1]
p8: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ y ∊ ofsort lsig lopen ks_expr ∧ u ∊ ofsort lsig lopen ks_ctors ∧ v ∊ ofsort lsig lopen ks_tys $ by b3_tys_tcons [p7, p2]
p9: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ y ∊ ofsort lsig lopen ks_expr $ by and_elim_l [p8]
p10: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ u ∊ ofsort lsig lopen ks_ctors ∧ v ∊ ofsort lsig lopen ks_tys $ by and_elim_r [p8]
p11: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ u ∊ ofsort lsig lopen ks_ctors $ by and_elim_l [p10]
p12: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ y = f $ by eq_sym [p5]
p13: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ u = e $ by eq_sym [p6]
p14: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ f ∊ ofsort lsig lopen ks_expr $ by welc_eq_set [p12, p9]
p15: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ e ∊ ofsort lsig lopen ks_ctors $ by welc_eq_set [p13, p11]
p16: $ G , a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by and_intro [p14, p15]
q1: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel $ by ax
q2: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ $ by and_elim_l [q1]
q3: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel $ by and_elim_r [q1]
q4: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ b = ⟨ kc_s , scons o ∅ ⟩ $ by and_elim_l [q3]
q5: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel $ by and_elim_r [q3]
q6: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ f = y $ by and_elim_l [q5]
q7: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ e = u ∧ ra_nth_ty v o y u ∈ lrel $ by and_elim_r [q5]
q8: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ e = u $ by and_elim_l [q7]
q9: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ ra_nth_ty v o y u ∈ lrel $ by and_elim_r [q7]
q10: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ a ∊ ofsort lsig lopen ks_tys $ by weaken [#1]
q11: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ k ∊ ofsort lsig lopen ks_expr ∧ l ∊ ofsort lsig lopen ks_ctors ∧ v ∊ ofsort lsig lopen ks_tys $ by b3_tys_tcons [q10, q2]
q12: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ l ∊ ofsort lsig lopen ks_ctors ∧ v ∊ ofsort lsig lopen ks_tys $ by and_elim_r [q11]
q13: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ v ∊ ofsort lsig lopen ks_tys $ by and_elim_r [q12]
q14: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ v = v $ by eq_refl
q15: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ o = o $ by eq_refl
q16: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ y = f $ by eq_sym [q6]
q17: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ u = e $ by eq_sym [q8]
q18: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ ra_nth_ty v o y u = ra_nth_ty v o f e $ by ra_nth_ty_eq [q14, q15, q16, q17]
q19: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ ra_nth_ty v o f e ∈ lrel $ by wcel_eq_l [q18, q9]
q20: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ kr_nth_ty ∈ ω $ by kr_nth_ty_omega
q21: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ isset kr_nth_ty $ by wcel_isset [q20]
q22: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ v ∊ trees ω ∧ o ∊ trees ω ∧ y ∊ trees ω ∧ u ∊ trees ω $ by lrel_args4 [q9, q21]
q23: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ o ∊ trees ω ∧ y ∊ trees ω ∧ u ∊ trees ω $ by and_elim_r [q22]
q24: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ o ∊ trees ω $ by and_elim_l [q23]
q25: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ o ∈ trees ω $ by welc_wcel [q24]
q26: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ nvf = nvf $ by eq_refl
q27: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ fv nvf b = fv nvf ⟨ kc_s , scons o ∅ ⟩ $ by fv_eq [q26, q4]
q28: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ fv nvf ⟨ kc_s , scons o ∅ ⟩ = suc (fv nvf o) $ by nvf_s [q25]
q29: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ fv nvf b = suc (fv nvf o) $ by eq_trans [q27, q28]
q30: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ suc (fv nvf o) = fv nvf b $ by eq_sym [q29]
q31: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ ∀ x ∀ i (x ∊ ofsort lsig lopen ks_tys → ra_nth_ty x i f e ∈ lrel → suc (fv nvf i) = fv nvf b → f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors) $ by weaken [#3]
q32: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ ∀ i (v ∊ ofsort lsig lopen ks_tys → ra_nth_ty v i f e ∈ lrel → suc (fv nvf i) = fv nvf b → f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors) $ by all_elim [q31]
q33: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ v ∊ ofsort lsig lopen ks_tys → ra_nth_ty v o f e ∈ lrel → suc (fv nvf o) = fv nvf b → f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by all_elim [q32]
q34: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ ra_nth_ty v o f e ∈ lrel → suc (fv nvf o) = fv nvf b → f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by imp_elim [q33, q13]
q35: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ suc (fv nvf o) = fv nvf b → f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by imp_elim [q34, q19]
q36: $ G , a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by imp_elim [q35, q30]
r1: $ G , ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) ⇒ ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) $ by ax
r2: $ G , ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by ex_elim [r1, p16]
r3: $ G , ∃ u ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) ⇒ ∃ u ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) $ by ax
r4: $ G , ∃ u ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by ex_elim [r3, r2]
r5: $ G , ∃ y ∃ u ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) ⇒ ∃ y ∃ u ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) $ by ax
r6: $ G , ∃ y ∃ u ∃ v (a = ⟨ kc_tcons , scons y (scons u (scons v ∅)) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ f = y ∧ e = u) ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by ex_elim [r5, r4]
s1: $ G , ∃ o (a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel) ⇒ ∃ o (a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel) $ by ax
s2: $ G , ∃ o (a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel) ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by ex_elim [s1, q36]
s3: $ G , ∃ v ∃ o (a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel) ⇒ ∃ v ∃ o (a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel) $ by ax
s4: $ G , ∃ v ∃ o (a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel) ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by ex_elim [s3, s2]
s5: $ G , ∃ l ∃ v ∃ o (a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel) ⇒ ∃ l ∃ v ∃ o (a = ⟨ kc_tcons , scons k (scons l (scons v ∅)) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ f = y ∧ e = u ∧ ra_nth_ty v o y u ∈ lrel) $ by ax
