c3: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} , ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)) , o = D ⇒ W ∈ lvals $ by weaken [#1]
c4: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} , ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)) , o = D ⇒ y ∊ csn ∅ $ by wcel_elim [c3, c2]
c5: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} , ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)) ⇒ isset D $ by weaken [r4]
c6: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} , ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)) ⇒ y ∊ csn ∅ $ by isset_elim [c5, c4]
o2a: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} , ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X))) ⇒ ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X))) $ by ax
o2: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} , ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X))) ⇒ y ∊ csn ∅ $ by ex_elim [o2a, c6]
o1a: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} , ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X))) ⇒ ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X))) $ by ax
o1: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} , ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X))) ⇒ y ∊ csn ∅ $ by ex_elim [o1a, o2]
d0a: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} $ by ax
d1: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X))) $ by cab_elim [d0a]
d2: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} ⇒ y ∊ csn ∅ $ by ex_elim [d1, o1]
d3: $ G ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} ⊆ csn ∅ $ by subset_intro [d2]
u1: $ G ⇒ universe (fv uni (lv t4 W)) ∧ ω ∈ fv uni (lv t4 W) $ by b12_nlu [#1, #5]
u2: $ G ⇒ universe (fv uni (lv t4 W)) $ by and_elim_l [u1]
u3: $ G ⇒ ω ∈ fv uni (lv t4 W) $ by and_elim_r [u1]
u4: $ G ⇒ ∅ ∈ ω $ by omega_zero
u5: $ G ⇒ ∅ ∈ fv uni (lv t4 W) $ by universe_elem_elem_c [u2, u3, u4]
u6: $ G ⇒ csn ∅ ∈ fv uni (lv t4 W) $ by b8_csn0_u [u2, u5]
u7: $ G ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by universe_subset_c [u2, u6, d3]

lemma b13_Gsub {g f t a: set} (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} ⊆ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $
----
a1: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} $ by ax
a2: $ … ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by cab_elim [a1]
a3: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} , ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A ⇒ ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A $ by ax
a4: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} , ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A ⇒ A = B $ by weaken [#1]
a5: $ … ⇒ ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ B $ by wcel_eq_r [a4, a3]
a6: $ … ⇒ ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [a5]
a7: $ … ⇒ ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [a6]
a8: $ … ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [a7]
a9: $ … ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by cab_intro [a8]
b1: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} , ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) ⇒ ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by ax
b2: $ … ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by ex_elim [b1, a9]
b3: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} , ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) ⇒ ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by ax
b4: $ … ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by ex_elim [b3, b2]
b5: $ … ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by ex_elim [a2, b4]
b6: $ … ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} ⊆ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by subset_intro [b5]

lemma b13_Geq {g f t a: set} (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} = {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $
----
c1: $ … ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} ⊆ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by b13_Gsub [#1]
c2: $ … ⇒ B = A $ by eq_sym [#1]
c3: $ … ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} ⊆ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} $ by b13_Gsub [c2]
c4: $ … ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} = {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by subset_antisym [c1, c3]

lemma b13_cu_in {x: set} (G: hyps x) (A: class) (B: class x) (a z: set): $ G ⇒ a ∊ A $ > $ G ⇒ z ∊ (⟦ x / a ⟧ B) $ > $ G ⇒ isset (⟦ x / a ⟧ B) $ > $ G ⇒ z ∊ ⋃ (img (cgr x B) A) $
----
n1: $ G , v = (⟦ x / a ⟧ B) ⇒ v = (⟦ x / a ⟧ B) $ by ax
n2: $ … ⇒ ⟨ a , v ⟩ ∈ cgr x B $ by cgr_intro [n1]
n3: $ G , v = (⟦ x / a ⟧ B) ⇒ a ∊ A $ by weaken [#1]
n4: $ … ⇒ v ∊ img (cgr x B) A $ by img_intro [n3, n2]
n5: $ … ⇒ (⟦ x / a ⟧ B) = v $ by eq_sym [n1]
n6: $ G , v = (⟦ x / a ⟧ B) ⇒ z ∊ (⟦ x / a ⟧ B) $ by weaken [#2]
n7: $ … ⇒ z ∊ v $ by welc_eq [n5, n6]
n8: $ … ⇒ z ∊ ⋃ (img (cgr x B) A) $ by cuni_intro [n7, n4]
n9: $ … ⇒ z ∊ ⋃ (img (cgr x B) A) $ by isset_elim [#3, n8]

lemma b13_path {b c g f t a: set} (G: hyps b c g f t a) (E W R0: class) (u t10 t11: set) (f0 g0 s0 a0: set g f t a): $ G ⇒ t10 ∈ trees ω $ > $ G ⇒ t11 ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R0 ∈ fseq u $ > $ G ⇒ ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ W R0 $ > $ G ⇒ ∃ b ∃ c (b ∊ da (fv E t10) W R0 ∧ c ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E t11 W (scons b R0))} ∧ c ∊ fseq u ∧ g0 = scons b c) $
----
p1: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u ⇒ t10 ∈ trees ω $ by weaken [#1]
p2: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u ⇒ t11 ∈ trees ω $ by weaken [#2]
p3: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u ⇒ v ∊ lvals $ by ax
p4: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
p5: $ … ⇒ etel u E ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ v r = {y | ∃ x ∃ i ∃ j ∃ k ∃ l (x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ y = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩)} $ by etel_pi [p1, p2, p3, p4]
p6: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u ⇒ v = W $ by ax
p7: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u ⇒ r = R0 $ by ax
p8: $ … ⇒ W = v $ by eq_sym [p6]
p9: $ … ⇒ R0 = r $ by eq_sym [p7]
p10: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u ⇒ ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ = ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ $ by eq_refl
p11: $ … ⇒ etel u E ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ W R0 = etel u E ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ v r $ by etel_eq [p10, p8, p9]
p12: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u ⇒ ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ W R0 $ by weaken [#5]
p13: $ … ⇒ ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ v r $ by wcel_eq_r [p11, p12]
p14: $ … ⇒ ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ ∈ {y | ∃ x ∃ i ∃ j ∃ k ∃ l (x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ y = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩)} $ by wcel_eq_r [p5, p13]
q1: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u , o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ , x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ ⇒ x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ $ by ax
q2: $ … ⇒ x ∊ da (fv E t10) v r $ by and_elim_l [q1]
q3: $ … ⇒ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ $ by and_elim_r [q1]
q5: $ … ⇒ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ $ by and_elim_r [q3]
q6: $ … ⇒ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) $ by and_elim_l [q5]
q7: $ … ⇒ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ $ by and_elim_r [q5]
q8: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u , o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ , x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ ⇒ o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ $ by ax
q9: $ … ⇒ ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ = o $ by eq_sym [q8]
q10: $ … ⇒ ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ $ by eq_trans [q9, q7]
q11: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u , o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ , x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ ⇒ isset f0 $ by isset_var
q12: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u , o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ , x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ ⇒ isset ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ $ by opair_isset
q13a: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u , o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ , x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ ⇒ isset i $ by isset_var
q13b: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u , o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ , x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ ⇒ isset ⟨ cdm i , x ⟩ $ by opair_isset
q13c: $ … ⇒ isset (csn ⟨ cdm i , x ⟩) $ by csn_set [q13b]
q13: $ … ⇒ isset (ssnoc i x) $ by cun_set [q13a, q13c]
q14: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u , o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ , x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ ⇒ isset ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ $ by opair_isset
q15: $ … ⇒ f0 = ssnoc i x ∧ ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ = ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ $ by opair_inj_c [q10, q11, q12, q13, q14]
q16: $ … ⇒ ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ = ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ $ by and_elim_r [q15]
q17: $ G , v = W , v ∊ lvals , r = R0 , r ∊ fseq u , o = ⟨ f0 , ⟨ g0 , ⟨ s0 , a0 ⟩ ⟩ ⟩ , x ∊ da (fv E t10) v r ∧ x ∊ u ∧ ⟨ i , ⟨ j , ⟨ k , l ⟩ ⟩ ⟩ ∈ etel u E t11 v (scons x r) ∧ o = ⟨ ssnoc i x , ⟨ scons x j , ⟨ scons (etel u E t10 v r) k , l ⟩ ⟩ ⟩ ⇒ isset g0 $ by isset_var
