--| @rewrite
lemma b7_sb_shp {z: set} (t2: set z) (A B C: class z): $ (⟦ z / t2 ⟧ (b7_shp A B C)) ≐ b7_shp (⟦ z / t2 ⟧ A) (⟦ z / t2 ⟧ B) (⟦ z / t2 ⟧ C) $
----
l1: $ (⟦ z / t2 ⟧ {o | ∃ f ∃ g ∃ t ∃ r ∃ m ∃ x (o = ⟨ f , ⟨ g , ⟨ t , r ⟩ ⟩ ⟩ ∧ ra_nidx A B m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ r = scat x C)}) ≐ {o | ∃ f ∃ g ∃ t ∃ r ∃ m ∃ x (o = ⟨ f , ⟨ g , ⟨ t , r ⟩ ⟩ ⟩ ∧ ra_nidx (⟦ z / t2 ⟧ A) (⟦ z / t2 ⟧ B) m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ r = scat x (⟦ z / t2 ⟧ C))} $ by ceqt_refl

lemma b7_shp_in (G: hyps) (D K S F H T: class) (o x7 x8 x9: set): $ G ⇒ o = ⟨ F , ⟨ H , ⟨ T , x7 ⟩ ⟩ ⟩ $ > $ G ⇒ isset F $ > $ G ⇒ isset H $ > $ G ⇒ isset T $ > $ G ⇒ ra_nidx D K x8 ∈ lrel $ > $ G ⇒ x9 ∊ fseq b7_V $ > $ G ⇒ cdm x9 = fv nvf x8 $ > $ G ⇒ x7 = scat x9 S $ > $ G ⇒ o ∊ b7_shp D K S $
----
a1: $ G , f = F , g = H , t = T ⇒ f = F $ by ax
a2: $ G , f = F , g = H , t = T ⇒ g = H $ by ax
