lemma b3_isw_all {c e x y z v: set} (G: hyps) (M: class) (u w l f k: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ra_isort f k l ∈ lrel $ > $ G ⇒ f ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ∀ c (c ∊ fseq u → ∀ e (e ∈ dt u M f w c ↔ (e ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w c) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w c) → apn e x ∈ fv uni (lv l w))))) $
