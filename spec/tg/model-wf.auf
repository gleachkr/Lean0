lemma b6_pis (G: hyps) {q m l o: set} (t1 t2 t3: set): $ G ⇒ ra_pis t1 t2 t3 ∈ lrel $ > $ G ⇒ (t1 ∊ ofsort lsig lopen ks_ctx → t2 ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen t1 q ∈ lrel → ra_isort t2 m l ∈ lrel → ∃ o (ra_isort t3 o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m))) $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ crn j ⊆ b6_cpis $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ ra_pis z b c ∈ lrel $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ (z ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen z q ∈ lrel → ra_isort b m l ∈ lrel → ∃ o (ra_isort c o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m))) $ by b6_pis_st [q4, q3, q5, q6]
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ ⇒ ra_pis z b c ∈ lrel → (z ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen z q ∈ lrel → ra_isort b m l ∈ lrel → ∃ o (ra_isort c o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m))) $ by imp_intro [q7]
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ ⇒ ∀ c (ra_pis z b c ∈ lrel → (z ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen z q ∈ lrel → ra_isort b m l ∈ lrel → ∃ o (ra_isort c o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m)))) $ by all_intro [q8]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ ⇒ ∀ b ∀ c (ra_pis z b c ∈ lrel → (z ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen z q ∈ lrel → ra_isort b m l ∈ lrel → ∃ o (ra_isort c o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m)))) $ by all_intro [q9]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ ⇒ z ∊ b6_cpis $ by cab_intro [q10]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b6_cpis $ by wcel_intro [q12, q11]
q14: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis ⇒ isset ⟨ k , j ⟩ $ by opair_isset
q15: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpis ⇒ ⟨ k , j ⟩ ∈ b6_cpis $ by isset_elim [q14, q13]
q16: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b6_cpis → ⟨ k , j ⟩ ∈ b6_cpis $ by imp_intro [q15]
q17: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b6_cpis → ⟨ k , j ⟩ ∈ b6_cpis $ by imp_intro [q16]
q18: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpis → ⟨ k , j ⟩ ∈ b6_cpis $ by imp_intro [q17]
q19: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpis → ⟨ k , j ⟩ ∈ b6_cpis) $ by all_intro [q18]
q20: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpis → ⟨ k , j ⟩ ∈ b6_cpis) $ by all_intro [q19]
q21: $ G ⇒ isset ω $ by omega_set
q22: $ G ⇒ trees ω ⊆ b6_cpis $ by trees_ind_c [q21, q20]
q23: $ G ⇒ kr_pis ∈ ω $ by kr_pis_omega
q24: $ G ⇒ isset kr_pis $ by wcel_isset [q23]
q25: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, q24]
q26: $ G ⇒ t1 ∊ trees ω $ by and_elim_l [q25]
q27: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by and_elim_r [q25]
q28: $ G ⇒ t2 ∊ trees ω $ by and_elim_l [q27]
q29: $ G ⇒ t3 ∊ trees ω $ by and_elim_r [q27]
q30: $ G ⇒ t1 ∊ b6_cpis $ by subset_elim [q22, q26]
q31: $ G ⇒ ∀ b ∀ c (ra_pis t1 b c ∈ lrel → (t1 ∊ ofsort lsig lopen ks_ctx → b ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen t1 q ∈ lrel → ra_isort b m l ∈ lrel → ∃ o (ra_isort c o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m)))) $ by cab_elim [q30]
q32: $ G ⇒ ∀ c (ra_pis t1 t2 c ∈ lrel → (t1 ∊ ofsort lsig lopen ks_ctx → t2 ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen t1 q ∈ lrel → ra_isort t2 m l ∈ lrel → ∃ o (ra_isort c o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m)))) $ by all_elim [q31]
q33: $ G ⇒ ra_pis t1 t2 t3 ∈ lrel → (t1 ∊ ofsort lsig lopen ks_ctx → t2 ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen t1 q ∈ lrel → ra_isort t2 m l ∈ lrel → ∃ o (ra_isort t3 o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m))) $ by all_elim [q32]
q34: $ G ⇒ (t1 ∊ ofsort lsig lopen ks_ctx → t2 ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr) ∧ ∀ q ∀ m ∀ l (ra_clen t1 q ∈ lrel → ra_isort t2 m l ∈ lrel → ∃ o (ra_isort t3 o l ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf m))) $ by imp_elim [q33, #1]

def b6_cpd (.y .b .c .e: set): class = $ {y | ∀ b ∀ c ∀ e (ra_pis y b c ∈ lrel → ra_pis y b e ∈ lrel → c = e)} $

lemma b6_pd_st (G: hyps) (z k s t2 t3 t4: set): $ G ⇒ crn s ⊆ b6_cpd $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_pis z t2 t3 ∈ lrel $ > $ G ⇒ ra_pis z t2 t4 ∈ lrel $ > $ G ⇒ t3 = t4 $
----
q1: $ G ⇒ ∃ e (z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e) ∨ ∃ d ∃ e ∃ f ∃ g (z = ⟨ kc_cons , scons d (scons g ∅) ⟩ ∧ t2 = e ∧ t3 = f ∧ ra_pis g ⟨ kc_pi , scons d (scons e ∅) ⟩ f ∈ lrel) $ by lrel_pis_cases [#4]
q2: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e $ by ax
q3: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [q2]
