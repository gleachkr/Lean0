i3: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ trees ω ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} $ by weaken [h11]
i4: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ p ∈ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} $ by wcel_subset [i3, i2]
i5: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ p ∊ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} $ by wcel_welc [i4]
i6: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ p ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) p w ∈ u $ by cab_elim [i5]
i7: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ esat u (dnf u M) p w ∈ u $ by imp_elim [i6, i1]
i8: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ p = P $ by ax
i9: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ w = W $ by ax
i10: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ esat u (dnf u M) p w = esat u (dnf u M) P W $ by esat_eq [i8, i9]
i11: $ G , w = W , w ∊ lvals , p = P , p ∊ ofsort lsig lopen ks_ctx ⇒ esat u (dnf u M) P W ∈ u $ by wcel_eq_l [i10, i7]
i12: $ G , w = W , w ∊ lvals ⇒ esat u (dnf u M) P W ∈ u $ by wcel_elim [#2, i11]
i13: $ G ⇒ esat u (dnf u M) P W ∈ u $ by wcel_elim [#3, i12]

lemma b3_ih_at {q: set} (G: hyps q) (M R: class) (u w d: set): $ G ⇒ ∀ q (q ∊ fseq u → etel u (dnf u M) d w q ∈ u) $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ etel u (dnf u M) d w R ∈ u $
----
l1: $ G , h = R , h ∊ fseq u ⇒ ∀ q (q ∊ fseq u → etel u (dnf u M) d w q ∈ u) $ by weaken [#1]
l2: $ G , h = R , h ∊ fseq u ⇒ h ∊ fseq u → etel u (dnf u M) d w h ∈ u $ by all_elim [l1]
l3: $ G , h = R , h ∊ fseq u ⇒ h ∊ fseq u $ by ax
l4: $ G , h = R , h ∊ fseq u ⇒ etel u (dnf u M) d w h ∈ u $ by imp_elim [l2, l3]
l5: $ G , h = R , h ∊ fseq u ⇒ d = d $ by eq_refl
l6: $ G , h = R , h ∊ fseq u ⇒ w = w $ by eq_refl
l7: $ G , h = R , h ∊ fseq u ⇒ h = R $ by ax
l8: $ G , h = R , h ∊ fseq u ⇒ etel u (dnf u M) d w h = etel u (dnf u M) d w R $ by etel_eq [l5, l6, l7]
l9: $ G , h = R , h ∊ fseq u ⇒ etel u (dnf u M) d w R ∈ u $ by wcel_eq_l [l8, l4]
l10: $ G ⇒ etel u (dnf u M) d w R ∈ u $ by wcel_elim [#2, l9]

lemma b3_path_parts (G: hyps) (C: class) (f g t a: set): $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ C $ > $ G ⇒ f ∊ cdm C ∧ g ∊ cdm (crn C) ∧ t ∊ cdm (crn (crn C)) ∧ a ∊ crn (crn (crn C)) $
----
m1: $ G ⇒ isset ⟨ g , ⟨ t , a ⟩ ⟩ $ by opair_isset
n1: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ m = ⟨ g , ⟨ t , a ⟩ ⟩ $ by ax
n2: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ n = ⟨ t , a ⟩ $ by ax
n3: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ f = f $ by eq_refl
n4: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ g , ⟨ t , a ⟩ ⟩ = m $ by eq_sym [n1]
n5: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ = ⟨ f , m ⟩ $ by opair_eq [n3, n4]
n6: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ C $ by weaken [#1]
n7: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ f , m ⟩ ∈ C $ by wcel_eq_l [n5, n6]
n8: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ f ∊ cdm C $ by cdm_intro [n7]
n9: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ m ∊ crn C $ by crn_intro [n7]
n10: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ m ∈ crn C $ by welc_wcel [n9]
n11: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ g , ⟨ t , a ⟩ ⟩ ∈ crn C $ by wcel_eq_l [n1, n10]
n12: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ g = g $ by eq_refl
n13: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ t , a ⟩ = n $ by eq_sym [n2]
n14: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ g , ⟨ t , a ⟩ ⟩ = ⟨ g , n ⟩ $ by opair_eq [n12, n13]
n15: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ g , n ⟩ ∈ crn C $ by wcel_eq_l [n14, n11]
n16: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ g ∊ cdm (crn C) $ by cdm_intro [n15]
n17: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ n ∊ crn (crn C) $ by crn_intro [n15]
n18: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ n ∈ crn (crn C) $ by welc_wcel [n17]
n19: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ ⟨ t , a ⟩ ∈ crn (crn C) $ by wcel_eq_l [n2, n18]
n20: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ t ∊ cdm (crn (crn C)) $ by cdm_intro [n19]
n21: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ a ∊ crn (crn (crn C)) $ by crn_intro [n19]
n22: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ t ∊ cdm (crn (crn C)) ∧ a ∊ crn (crn (crn C)) $ by and_intro [n20, n21]
n23: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ g ∊ cdm (crn C) ∧ t ∊ cdm (crn (crn C)) ∧ a ∊ crn (crn (crn C)) $ by and_intro [n16, n22]
n24: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ , n = ⟨ t , a ⟩ ⇒ f ∊ cdm C ∧ g ∊ cdm (crn C) ∧ t ∊ cdm (crn (crn C)) ∧ a ∊ crn (crn (crn C)) $ by and_intro [n8, n23]
o1: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ isset ⟨ t , a ⟩ $ by opair_isset
o2: $ G , m = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ f ∊ cdm C ∧ g ∊ cdm (crn C) ∧ t ∊ cdm (crn (crn C)) ∧ a ∊ crn (crn (crn C)) $ by isset_elim [o1, n24]
o3: $ G ⇒ f ∊ cdm C ∧ g ∊ cdm (crn C) ∧ t ∊ cdm (crn (crn C)) ∧ a ∊ crn (crn (crn C)) $ by isset_elim [m1, o2]

lemma b3_etel_oth (G: hyps) (E K S: class) (u w r z: set): $ G ⇒ uadm u $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ z ∈ trees ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u E z w r ∈ u $
----
l1: $ G ⇒ ⟨ K , S ⟩ = z $ by eq_sym [#2]
l2: $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ by wcel_eq_l [#2, #3]
l3: $ G ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_trees [l2, #4, #5, #6, #7]
l4: $ G ⇒ universe u $ by uadm_universe [#1]
l5: $ G ⇒ ∅ ∈ u $ by uadm_empty [#1]
l6: $ G ⇒ ⟨ ∅ , ∅ ⟩ ∈ u $ by b3_opair_u [l4, l5, l5]
l7: $ G ⇒ ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ∈ u $ by b3_opair_u [l4, l5, l6]
l8: $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ ∈ u $ by b3_opair_u [l4, l5, l7]
l9: $ G ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ ∈ u $ by universe_cpr_c [l4, l8, l8]
l10: $ G ⇒ z = z $ by eq_refl
l11: $ G ⇒ w = w $ by eq_refl
l12: $ G ⇒ r = r $ by eq_refl
l13: $ G ⇒ etel u E z w r = etel u E ⟨ K , S ⟩ w r $ by etel_eq [#2, l11, l12]
l14: $ G ⇒ etel u E z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [l13, l3]
l15: $ G ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ = etel u E z w r $ by eq_sym [l14]
l16: $ G ⇒ etel u E z w r ∈ u $ by wcel_eq_l [l15, l9]

lemma b3_etel_pi_u {q: set} (G: hyps q) (M: class) (u w r c d: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ c ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ d ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ etel u (dnf u M) c w r ∈ u $ > $ G ⇒ ∀ q (q ∊ fseq u → etel u (dnf u M) d w q ∈ u) $ > $ G ⇒ etel u (dnf u M) ⟨ kc_pi , scons c (scons d ∅) ⟩ w r ∈ u $
----
p1: $ G ⇒ universe u $ by uadm_universe [#1]
p2: $ G ⇒ dt u M c w r ∈ u $ by dt_in_u [#1, #4, #2, #3]
i1: $ G , i ∊ dt u M c w r ⇒ i ∊ dt u M c w r $ by ax
i2: $ G , i ∊ dt u M c w r ⇒ i ∈ dt u M c w r $ by welc_wcel [i1]
i3: $ G , i ∊ dt u M c w r ⇒ universe u $ by weaken [p1]
i4: $ G , i ∊ dt u M c w r ⇒ dt u M c w r ∈ u $ by weaken [p2]
i5: $ G , i ∊ dt u M c w r ⇒ i ∈ u $ by universe_elem_elem_c [i3, i4, i2]
i6: $ G , i ∊ dt u M c w r ⇒ i ∊ u $ by wcel_welc [i5]
i7: $ G , i ∊ dt u M c w r ⇒ r ∊ fseq u $ by weaken [#3]
i8: $ G , i ∊ dt u M c w r ⇒ scons i r ∈ fseq u $ by scons_fseq [i6, i7]
i9: $ G , i ∊ dt u M c w r ⇒ ∀ q (q ∊ fseq u → etel u (dnf u M) d w q ∈ u) $ by weaken [#7]
i10: $ G , i ∊ dt u M c w r ⇒ etel u (dnf u M) d w (scons i r) ∈ u $ by b3_ih_at [i9, i8]
i11: $ G , i ∊ dt u M c w r ⇒ cdm (etel u (dnf u M) d w (scons i r)) ∈ u $ by b3_cdm_u [i3, i10]
i12: $ G , i ∊ dt u M c w r ⇒ crn (etel u (dnf u M) d w (scons i r)) ∈ u $ by b3_crn_u [i3, i10]
i13: $ G , i ∊ dt u M c w r ⇒ cdm (crn (etel u (dnf u M) d w (scons i r))) ∈ u $ by b3_cdm_u [i3, i12]
i14: $ G , i ∊ dt u M c w r ⇒ crn (crn (etel u (dnf u M) d w (scons i r))) ∈ u $ by b3_crn_u [i3, i12]
i15: $ G , i ∊ dt u M c w r ⇒ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ∈ u $ by b3_cdm_u [i3, i14]
i16: $ G , i ∊ dt u M c w r ⇒ crn (crn (crn (etel u (dnf u M) d w (scons i r)))) ∈ u $ by b3_crn_u [i3, i14]
i17: $ G , i ∊ dt u M c w r ⇒ etel u (dnf u M) c w r ∈ u $ by weaken [#6]
v11: $ G ⇒ i ∊ dt u M c w r → cdm (etel u (dnf u M) d w (scons i r)) ∈ u $ by imp_intro [i11]
v12: $ G ⇒ ∀ i (i ∊ dt u M c w r → cdm (etel u (dnf u M) d w (scons i r)) ∈ u) $ by all_intro [v11]
v13: $ G , i ∊ dt u M c w r , l ∊ cdm (etel u (dnf u M) d w (scons i r)) ⇒ l ∊ cdm (etel u (dnf u M) d w (scons i r)) $ by ax
v14: $ G , i ∊ dt u M c w r , l ∊ cdm (etel u (dnf u M) d w (scons i r)) ⇒ l ∈ cdm (etel u (dnf u M) d w (scons i r)) $ by welc_wcel [v13]
v15: $ G , i ∊ dt u M c w r , l ∊ cdm (etel u (dnf u M) d w (scons i r)) ⇒ cdm (etel u (dnf u M) d w (scons i r)) ∈ u $ by weaken [i11]
v16: $ G , i ∊ dt u M c w r , l ∊ cdm (etel u (dnf u M) d w (scons i r)) ⇒ universe u $ by weaken [i3]
v17: $ G , i ∊ dt u M c w r , l ∊ cdm (etel u (dnf u M) d w (scons i r)) ⇒ l ∈ u $ by universe_elem_elem_c [v16, v15, v14]
v18: $ G , i ∊ dt u M c w r , l ∊ cdm (etel u (dnf u M) d w (scons i r)) ⇒ i ∈ u $ by weaken [i5]
v19: $ G , i ∊ dt u M c w r , l ∊ cdm (etel u (dnf u M) d w (scons i r)) ⇒ etel u (dnf u M) c w r ∈ u $ by weaken [i17]
v110: $ G , i ∊ dt u M c w r , l ∊ cdm (etel u (dnf u M) d w (scons i r)) ⇒ ssnoc l i ∈ u $ by b3_ssnoc_u [v16, v17, v18]
v111: $ G , i ∊ dt u M c w r ⇒ l ∊ cdm (etel u (dnf u M) d w (scons i r)) → ssnoc l i ∈ u $ by imp_intro [v110]
v112: $ G ⇒ i ∊ dt u M c w r → l ∊ cdm (etel u (dnf u M) d w (scons i r)) → ssnoc l i ∈ u $ by imp_intro [v111]
v113: $ G ⇒ ∀ l (i ∊ dt u M c w r → l ∊ cdm (etel u (dnf u M) d w (scons i r)) → ssnoc l i ∈ u) $ by all_intro [v112]
v114: $ G ⇒ ∀ i ∀ l (i ∊ dt u M c w r → l ∊ cdm (etel u (dnf u M) d w (scons i r)) → ssnoc l i ∈ u) $ by all_intro [v113]
v115: $ G ⇒ {o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (etel u (dnf u M) d w (scons i r)) ∧ o = ssnoc l i)} ∈ u $ by b3_repl2 [p1, p2, v12, v114]
v21: $ G ⇒ i ∊ dt u M c w r → cdm (crn (etel u (dnf u M) d w (scons i r))) ∈ u $ by imp_intro [i13]
v22: $ G ⇒ ∀ i (i ∊ dt u M c w r → cdm (crn (etel u (dnf u M) d w (scons i r))) ∈ u) $ by all_intro [v21]
v23: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ⇒ l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) $ by ax
v24: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ⇒ l ∈ cdm (crn (etel u (dnf u M) d w (scons i r))) $ by welc_wcel [v23]
v25: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ⇒ cdm (crn (etel u (dnf u M) d w (scons i r))) ∈ u $ by weaken [i13]
v26: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ⇒ universe u $ by weaken [i3]
v27: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ⇒ l ∈ u $ by universe_elem_elem_c [v26, v25, v24]
v28: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ⇒ i ∈ u $ by weaken [i5]
v29: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ⇒ etel u (dnf u M) c w r ∈ u $ by weaken [i17]
v210: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ⇒ scons i l ∈ u $ by b3_scons_u [v26, v28, v27]
v211: $ G , i ∊ dt u M c w r ⇒ l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) → scons i l ∈ u $ by imp_intro [v210]
v212: $ G ⇒ i ∊ dt u M c w r → l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) → scons i l ∈ u $ by imp_intro [v211]
v213: $ G ⇒ ∀ l (i ∊ dt u M c w r → l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) → scons i l ∈ u) $ by all_intro [v212]
v214: $ G ⇒ ∀ i ∀ l (i ∊ dt u M c w r → l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) → scons i l ∈ u) $ by all_intro [v213]
v215: $ G ⇒ {o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ∧ o = scons i l)} ∈ u $ by b3_repl2 [p1, p2, v22, v214]
v31: $ G ⇒ i ∊ dt u M c w r → cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ∈ u $ by imp_intro [i15]
v32: $ G ⇒ ∀ i (i ∊ dt u M c w r → cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ∈ u) $ by all_intro [v31]
v33: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ⇒ l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) $ by ax
v34: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ⇒ l ∈ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) $ by welc_wcel [v33]
v35: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ⇒ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ∈ u $ by weaken [i15]
v36: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ⇒ universe u $ by weaken [i3]
v37: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ⇒ l ∈ u $ by universe_elem_elem_c [v36, v35, v34]
v38: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ⇒ i ∈ u $ by weaken [i5]
v39: $ G , i ∊ dt u M c w r , l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ⇒ etel u (dnf u M) c w r ∈ u $ by weaken [i17]
