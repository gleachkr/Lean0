lemma b6_kids_lam (G: hyps) (a b: set): $ G ⇒ ⟨ kc_lam , scons a (scons b ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $
----
q1: $ G , z = ⟨ kc_lam , scons a (scons b ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z ∊ ofsort lsig lopen ks_expr $ by ax
q2: $ G , z = ⟨ kc_lam , scons a (scons b ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_lam , scons a (scons b ∅) ⟩ $ by ax
q3: $ G , z = ⟨ kc_lam , scons a (scons b ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by b6_kc_lam [q1, q2]
q4: $ G ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by wcel_elim [#1, q3]

lemma b6_kc_pi (H: hyps) (z a b: set): $ H ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ H ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ > $ H ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $
----
q1: $ H ⇒ ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ∨ ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_pi , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_cst , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_atom ∧ y ∊ ofsort lsig lopen ks_lvls) ∨ ∃ x (z = ⟨ kc_lit , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) ∨ ∃ x ∃ y (z = ⟨ kc_ind_ty , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_ind_ctor , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_nat) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_ind_rec , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_proj , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_expr) ∨ ∃ x (z = ⟨ kc_quot , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (z = ⟨ kc_quot_mk , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (z = ⟨ kc_quot_lift , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (z = ⟨ kc_quot_ind , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) $ by ofsort_expr_cases [#1]
q2: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat $ by ax
q3: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons x ∅ ⟩ $ by and_elim_l [q2]
q4: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ x ∊ ofsort lsig lopen ks_nat $ by and_elim_r [q2]
q5: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by weaken [#2]
q6: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
q7: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ kc_pi ∈ ω $ by kc_pi_omega
q8: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ ¬ kc_bvar = kc_pi $ by kc_bvar_ne_pi
q9: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by b6_clash [q3, q5, q8, q6, q7]
q10: $ H , ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $ by ax
q11: $ H , ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by ex_elim [q10, q9]
q12: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl $ by ax
q13: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_srt , scons x ∅ ⟩ $ by and_elim_l [q12]
q14: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ x ∊ ofsort lsig lopen ks_lvl $ by and_elim_r [q12]
q15: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by weaken [#2]
q16: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ kc_srt ∈ ω $ by kc_srt_omega
q17: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ kc_pi ∈ ω $ by kc_pi_omega
q18: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ ¬ kc_srt = kc_pi $ by kc_srt_ne_pi
q19: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by b6_clash [q13, q15, q18, q16, q17]
q20: $ H , ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ⇒ ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) $ by ax
q21: $ H , ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by ex_elim [q20, q19]
q22: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by ax
q23: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_app , scons x (scons y ∅) ⟩ $ by and_elim_l [q22]
q24: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by and_elim_r [q22]
q25: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr $ by and_elim_l [q24]
q26: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ y ∊ ofsort lsig lopen ks_expr $ by and_elim_r [q24]
q27: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by weaken [#2]
q28: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ kc_app ∈ ω $ by kc_app_omega
q29: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ kc_pi ∈ ω $ by kc_pi_omega
q30: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ ¬ kc_app = kc_pi $ by kc_app_ne_pi
q31: $ H , z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by b6_clash [q23, q27, q30, q28, q29]
q32: $ H , ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ⇒ ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) $ by ax
q33: $ H , ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by ex_elim [q32, q31]
q34: $ H , ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ⇒ ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) $ by ax
