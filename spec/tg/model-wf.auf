lemma b6_kids_pi (G: hyps) (a b: set): $ G ⇒ ⟨ kc_pi , scons a (scons b ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $
----
q1: $ G , z = ⟨ kc_pi , scons a (scons b ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z ∊ ofsort lsig lopen ks_expr $ by ax
q2: $ G , z = ⟨ kc_pi , scons a (scons b ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by ax
q3: $ G , z = ⟨ kc_pi , scons a (scons b ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by b6_kc_pi [q1, q2]
q4: $ G ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $ by wcel_elim [#1, q3]

lemma b6_kc_proj (H: hyps) (z a b c: set): $ H ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ H ⇒ z = ⟨ kc_proj , scons a (scons b (scons c ∅)) ⟩ $ > $ H ⇒ a ∊ ofsort lsig lopen ks_blk ∧ b ∊ ofsort lsig lopen ks_nat ∧ c ∊ ofsort lsig lopen ks_expr $
