a14: $ … ⇒ k ∈ fseq A $ by wcel_eq_l [a6, a13]
a15: $ … ⇒ k ∊ fseq A $ by wcel_welc [a14]
a16: $ … ⇒ scat (scat i j) k = scat i (scat j k) $ by scat_assoc [a9, a12, a15]
a17: $ … ⇒ scat S T = scat i j $ by scat_eq [a4, a5]
a18: $ … ⇒ scat (scat S T) U = scat (scat i j) k $ by scat_eq [a17, a6]
a19: $ … ⇒ scat j k = scat T U $ by scat_eq [a2, a3]
a20: $ … ⇒ scat i (scat j k) = scat S (scat T U) $ by scat_eq [a1, a19]
a21: $ … ⇒ scat (scat S T) U = scat i (scat j k) $ by eq_trans [a18, a16]
a22: $ … ⇒ scat (scat S T) U = scat S (scat T U) $ by eq_trans [a21, a20]
a23: $ G ⇒ isset U $ by wcel_isset [#3]
a24: $ … ⇒ scat (scat S T) U = scat S (scat T U) $ by isset_elim [a23, a22]
a25: $ G ⇒ isset T $ by wcel_isset [#2]
a26: $ … ⇒ scat (scat S T) U = scat S (scat T U) $ by isset_elim [a25, a24]
a27: $ G ⇒ isset S $ by wcel_isset [#1]
a28: $ … ⇒ scat (scat S T) U = scat S (scat T U) $ by isset_elim [a27, a26]

lemma b14_sin (G: hyps) (M W D P0 R: class) (u t2 t12 t10 t13 t8: set): $ G ⇒ ra_sinst D ⟨ kc_nz , ∅ ⟩ t2 t12 t10 t13 ∈ lrel $ > $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ P0 ∈ fseq u $ > $ G ⇒ cdm P0 = fv nvf t12 $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ t8 ∊ fseq u $ > $ G ⇒ cdm t8 = fv nvf t2 $ > $ G ⇒ b6_vt u M W D t8 $ > $ G ⇒ dt u M t13 W (scat P0 R) = dt u M t10 W (scat P0 (scat t8 R)) $
