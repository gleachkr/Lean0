e0: $ G ⇒ ∃ m (ra_nidx t1 j0 m ∈ lrel ∧ cdm (sarg u (dnf u M) y w r) = nadd (fv nvf m) (fv nvf t3) ∧ isset (sarg u (dnf u M) y w r) ∧ sarg u (dnf u M) y w r ∈ fseq b6_V) $ by b6_indapp_cnt [#2, #1, #3, #4]
