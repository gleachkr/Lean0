lemma b10_closed (G: hyps) {f r: set} (tP tT t2 t3 t4: set): $ G ⇒ ra_tys_closed tP tT ∈ lrel $ > $ G ⇒ ra_nth_ty tT t2 t3 t4 ∈ lrel $ > $ G ⇒ ∃ f ∃ r (ra_pis tP f r ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ r ∈ lrel) $
----
q1: $ G ⇒ ∃ x0 ∃ x1 ∃ x2 (tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1) ∨ ∃ x0 ∃ x3 ∃ x1 ∃ x4 ∃ x2 ∃ x5 (tT = ⟨ kc_tcons , scons x3 (scons x4 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons x5 ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ∧ ra_nth_ty x2 x5 x0 x1 ∈ lrel) $ by lrel_nth_ty_cases [#2]
q2: $ G , tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ⇒ tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 $ by ax
q3: $ G , tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ⇒ tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ $ by and_elim_l [q2]
q4: $ G , tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 $ by and_elim_r [q2]
q5: $ G , tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [q4]
q6: $ G , tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ⇒ t3 = x0 ∧ t4 = x1 $ by and_elim_r [q4]
q7: $ G , tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ⇒ t3 = x0 $ by and_elim_l [q6]
q8: $ G , tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ⇒ t4 = x1 $ by and_elim_r [q6]
q9: $ G , tT = ⟨ kc_tcons , scons x0 (scons x1 (scons x2 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x0 ∧ t4 = x1 ⇒ ra_tys_closed tP tT ∈ lrel $ by weaken [#1]
