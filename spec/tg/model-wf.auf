q14: $ G , h = scat t6 X , l = scat t6 Y ⇒ h ∈ fseq u $ by wcel_eq_l [q12, q13]
q15: $ G , h = scat t6 X , l = scat t6 Y ⇒ h ∊ fseq u $ by wcel_welc [q14]
q16: $ G , h = scat t6 X , l = scat t6 Y ⇒ scat t6 Y = l $ by eq_sym [q8]
q17: $ G , h = scat t6 X , l = scat t6 Y ⇒ scat t6 Y ∈ fseq u $ by scat_fseq [q9, q11]
q18: $ G , h = scat t6 X , l = scat t6 Y ⇒ l ∈ fseq u $ by wcel_eq_l [q16, q17]
q19: $ G , h = scat t6 X , l = scat t6 Y ⇒ l ∊ fseq u $ by wcel_welc [q18]
q20: $ G , h = scat t6 X , l = scat t6 Y ⇒ w ∊ lvals $ by weaken [#5]
q21: $ G , h = scat t6 X , l = scat t6 Y ⇒ scat t6 X = h $ by eq_sym [q7]
q22: $ G , h = scat t6 X , l = scat t6 Y ⇒ u = u $ by eq_refl
q23: $ G , h = scat t6 X , l = scat t6 Y ⇒ M = M $ by eq_refl
q24: $ G , h = scat t6 X , l = scat t6 Y ⇒ z = z $ by eq_refl
q25: $ G , h = scat t6 X , l = scat t6 Y ⇒ w = w $ by eq_refl
q26: $ G , h = scat t6 X , l = scat t6 Y ⇒ dt u M z w (scat t6 X) = dt u M z w h $ by dt_eq [q22, q23, q24, q25, q21]
q27: $ G , h = scat t6 X , l = scat t6 Y ⇒ t7 ∊ dt u M z w (scat t6 X) $ by weaken [#13]
q28: $ G , h = scat t6 X , l = scat t6 Y ⇒ t7 ∊ dt u M z w h $ by welc_eq [q26, q27]
q29: $ G , h = scat t6 X , l = scat t6 Y ⇒ ∀ i (i ∊ cdm t6 → fv (scat t6 X) i = fv (scat t6 Y) i) $ by scat_agree [q9, q10, q11]
q30: $ G , h = scat t6 X , l = scat t6 Y ⇒ ra_ipos t1 t2 t3 t4 z ∈ lrel $ by weaken [#9]
q31: $ G , h = scat t6 X , l = scat t6 Y ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ∧ ra_ipos x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x7 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x8 ∃ x6 (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_indapp x1 x2 x3 x4 x6 x8 ∈ lrel) $ by lrel_ipos_cases [q30]
q32: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel $ by ax
