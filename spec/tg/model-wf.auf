w6: $ G ⇒ b7_hw D Q (scons c a) (scons c b) ⟨ kc_s , scons e ∅ ⟩ n $ by weaken [w5]

--| The trees `y` whose paths, for `iargs K m X y`, are `X`'s with `m` arguments in front.
def b7_ias (U M W K X R A0: class) (.y .m .x: set): class = $ {y | ∀ m (ra_iargs K m X y ∈ lrel → ∃ x (x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ etel U (dnf U M) y W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩))} $

lemma b7_ias_step {x: set} (G: hyps) (M A0: class) (u w r t1 t3 z k j v x1 x2 x3 x4 x5: set): $ G ⇒ crn j ⊆ b7_ias u M w t1 t3 r A0 $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ t1 = x1 $ > $ G ⇒ t3 = x3 $ > $ G ⇒ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ $ > $ G ⇒ ra_iargs x1 x2 x3 x4 ∈ lrel $ > $ G ⇒ ra_closed x1 x5 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ A0 ∈ fseq b7_V $ > $ G ⇒ v = ⟨ kc_s , scons x2 ∅ ⟩ $ > $ G ⇒ ∃ x (x ∊ fseq b7_V ∧ cdm x = fv nvf v ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩) $
----
a0: $ G ⇒ kc_app ∈ ω $ by kc_app_omega
a1: $ G ⇒ isset kc_app $ by wcel_isset [a0]
a2a: $ G ⇒ isset ∅ $ by ax_empty
a2b: $ G ⇒ isset (scons x5 ∅) $ by scons_set [a2a]
a2: $ G ⇒ isset (scons x4 (scons x5 ∅)) $ by scons_set [a2b]
a3: $ G ⇒ crn (scons x4 (scons x5 ∅)) ⊆ b7_ias u M w t1 t3 r A0 $ by node_crn_sub [#1, #2, #5, a1, a2]
a4a: $ G ⇒ isset x4 $ by isset_var
a4b: $ G ⇒ x4 ∈ b7_ias u M w t1 t3 r A0 $ by crn_scons_head [a4a, a3]
a4: $ G ⇒ x4 ∊ b7_ias u M w t1 t3 r A0 $ by wcel_welc [a4b]
a5: $ G ⇒ ∀ m (ra_iargs t1 m t3 x4 ∈ lrel → ∃ x (x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩)) $ by cab_elim [a4]
a6: $ G ⇒ ra_iargs t1 x2 t3 x4 ∈ lrel → ∃ x (x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩) $ by all_elim [a5]
b1: $ G ⇒ x1 = t1 $ by eq_sym [#3]
b2: $ G ⇒ x2 = x2 $ by eq_refl
b3: $ G ⇒ x3 = t3 $ by eq_sym [#4]
b4: $ G ⇒ x4 = x4 $ by eq_refl
b5: $ G ⇒ ra_iargs x1 x2 x3 x4 = ra_iargs t1 x2 t3 x4 $ by ra_iargs_eq [b1, b2, b3, b4]
b6: $ G ⇒ ra_iargs t1 x2 t3 x4 ∈ lrel $ by wcel_eq_l [b5, #6]
b7: $ G ⇒ ∃ x (x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩) $ by imp_elim [a6, b6]
k0a: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
k0: $ G ⇒ isset kr_closed $ by wcel_isset [k0a]
k1: $ G ⇒ x1 ∊ trees ω ∧ x5 ∊ trees ω $ by lrel_args2 [#7, k0]
k2a: $ G ⇒ x5 ∊ trees ω $ by and_elim_r [k1]
k2: $ G ⇒ x5 ∈ trees ω $ by welc_wcel [k2a]
k3a: $ G ⇒ kr_iargs ∈ ω $ by kr_iargs_omega
k3: $ G ⇒ isset kr_iargs $ by wcel_isset [k3a]
k4: $ G ⇒ x1 ∊ trees ω ∧ x2 ∊ trees ω ∧ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by lrel_args4 [#6, k3]
k5a: $ G ⇒ x2 ∊ trees ω ∧ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by and_elim_r [k4]
k5x: $ G ⇒ x2 ∊ trees ω $ by and_elim_l [k5a]
k5y: $ G ⇒ x2 ∈ trees ω $ by welc_wcel [k5x]
k5b: $ G ⇒ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by and_elim_r [k5a]
k5c: $ G ⇒ x4 ∊ trees ω $ by and_elim_r [k5b]
k5: $ G ⇒ x4 ∈ trees ω $ by welc_wcel [k5c]
k6a: $ G ⇒ isset (dt u M x5 w r) $ by dt_set
k6: $ G ⇒ isset (da (fv (dnf u M) x5) w r) $ by weaken [k6a]
k7: $ G ⇒ fv nvf ⟨ kc_s , scons x2 ∅ ⟩ = suc (fv nvf x2) $ by nvf_s [k5y]
p0: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ $ by ax
p1: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ x ∊ fseq b7_V $ by and_elim_l [p0]
p1r: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ $ by and_elim_r [p0]
p2: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ cdm x = fv nvf x2 $ by and_elim_l [p1r]
p3: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ $ by and_elim_r [p1r]
p4a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ x ∈ fseq b7_V $ by welc_wcel [p1]
p4b: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ A0 ∈ fseq b7_V $ by weaken [#10]
p4c: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ scat x A0 ∈ fseq b7_V $ by scat_fseq_c [p4a, p4b]
p4: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ isset (scat x A0) $ by wcel_isset [p4c]
p5a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ x4 ∈ trees ω $ by weaken [k5]
p5b: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ x5 ∈ trees ω $ by weaken [k2]
p5c: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ w ∊ lvals $ by weaken [#8]
p5d: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ r ∊ fseq u $ by weaken [#9]
p5: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ etel u (dnf u M) ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) x5) w r) (scat x A0) ⟩ ⟩ ⟩ $ by etel_app_csn [p5a, p5b, p5c, p5d, p3, p4]
p6a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ $ by weaken [#5]
p6b: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ w = w $ by eq_refl
p6c: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ r = r $ by eq_refl
p6: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ etel u (dnf u M) z w r = etel u (dnf u M) ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ w r $ by etel_eq [p6a, p6b, p6c]
p7: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) x5) w r) (scat x A0) ⟩ ⟩ ⟩ $ by eq_trans [p6, p5]
p8: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ ⇒ isset (da (fv (dnf u M) x5) w r) $ by weaken [k6]
q0: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ o = da (fv (dnf u M) x5) w r $ by ax
q0b: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ da (fv (dnf u M) x5) w r = o $ by eq_sym [q0]
q1a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ isset o $ by isset_var
q1b: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ x ∈ fseq b7_V $ by weaken [p4a]
q1c: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ A0 ∈ fseq b7_V $ by weaken [p4b]
q1: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ scat (scons o x) A0 = scons o (scat x A0) $ by scat_scons_c [q1a, q1b, q1c]
q2a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ scat x A0 = scat x A0 $ by eq_refl
q2: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ scons (da (fv (dnf u M) x5) w r) (scat x A0) = scons o (scat x A0) $ by scons_eq [q0b, q2a]
q3a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ scons o (scat x A0) = scat (scons o x) A0 $ by eq_sym [q1]
q3: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ scons (da (fv (dnf u M) x5) w r) (scat x A0) = scat (scons o x) A0 $ by eq_trans [q2, q3a]
q4: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) x5) w r) (scat x A0) ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (scons o x) A0 ⟩ ⟩ ⟩ $ by path0_eq [q3]
q5: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) x5) w r) (scat x A0) ⟩ ⟩ ⟩ = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (scons o x) A0 ⟩ ⟩ ⟩ $ by csn_eq [q4]
q6a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) x5) w r) (scat x A0) ⟩ ⟩ ⟩ $ by weaken [p7]
q6: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (scons o x) A0 ⟩ ⟩ ⟩ $ by eq_trans [q6a, q5]
q7a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ isset x $ by isset_var
q7: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ isset (scons o x) $ by scons_set [q7a]
q8a: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ o ∈ b7_V $ by b7_V_in [q1a]
q8b: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ o ∊ b7_V $ by wcel_welc [q8a]
q8c: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ x ∊ fseq b7_V $ by weaken [p1]
q8: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ scons o x ∈ fseq b7_V $ by scons_fseq [q8b, q8c]
q9b: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ cdm (scons o x) = suc (cdm x) $ by scons_len [q8c]
q9c: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ cdm x = fv nvf x2 $ by weaken [p2]
q9d: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ suc (cdm x) = suc (fv nvf x2) $ by suc_eq [q9c]
q9e: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ fv nvf ⟨ kc_s , scons x2 ∅ ⟩ = suc (fv nvf x2) $ by weaken [k7]
q9f: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ suc (fv nvf x2) = fv nvf ⟨ kc_s , scons x2 ∅ ⟩ $ by eq_sym [q9e]
q9g: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ cdm (scons o x) = suc (fv nvf x2) $ by eq_trans [q9b, q9d]
q9: $ G , x ∊ fseq b7_V ∧ cdm x = fv nvf x2 ∧ etel u (dnf u M) x4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x A0 ⟩ ⟩ ⟩ , o = da (fv (dnf u M) x5) w r ⇒ cdm (scons o x) = fv nvf ⟨ kc_s , scons x2 ∅ ⟩ $ by eq_trans [q9g, q9f]
