q23: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q ⇒ isset (nest q e) $ by nest_set
q24: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q , v = nest q e ⇒ v = nest q e $ by ax
q25: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q , v = nest q e ⇒ isset e $ by isset_var
q26: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q , v = nest q e ⇒ e ∈ apn (fv (ixs d w tx) (fv nvf o)) q ↔ nest q e ∈ fv (ixs d w tx) (fv nvf o) $ by apn_wcel [q25]
q27: $ G , ra_nidx d o m ∈ lrel , cdm q = nadd (fv nvf m) (fv nvf tnp) , q ∊ fseq b6_V , d = x0 ∧ o = x4 ∧ m = x5 ∧ ra_ind_data x0 x1 x2 x3 ∈ lrel ∧ ra_nth_ty x3 x4 x6 x7 ∈ lrel ∧ ra_isort x6 x5 x8 ∈ lrel , e ∊ apn (fv tX (fv nvf o)) q , v = nest q e ⇒ e ∊ apn (fv (ixs d w tx) (fv nvf o)) q $ by weaken [q22]
