l13: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ f = z $ by eq_sym [b8]
l14: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ w = w $ by eq_refl
