lemma b11_sp_ocrn (G: hyps) (S F X Y: class): $ G ⇒ crn (b11_sp_O S F X Y) ⊆ X $
----
n1: $ G , n ∊ crn (b11_sp_O S F X Y) ⇒ n ∊ crn (b11_sp_O S F X Y) $ by ax
m1: $ G , n ∊ crn (b11_sp_O S F X Y) , ⟨ m , n ⟩ ∈ b11_sp_O S F X Y ⇒ ⟨ m , n ⟩ ∈ b11_sp_O S F X Y $ by ax
m2: $ … ⇒ b11_sp_kv S F X m n ∨ (m = ∅ ∧ n = Y ∧ Y ∈ X) $ by b11_sp_oe [m1]
c1: $ G , n ∊ crn (b11_sp_O S F X Y) , ⟨ m , n ⟩ ∈ b11_sp_O S F X Y , b11_sp_kv S F X m n ⇒ b11_sp_kv S F X m n $ by ax
c2: $ … ⇒ n ∈ X $ by b11_sp_kvx [c1]
c3: $ … ⇒ n ∊ X $ by wcel_welc [c2]
d0: $ G , n ∊ crn (b11_sp_O S F X Y) , ⟨ m , n ⟩ ∈ b11_sp_O S F X Y , m = ∅ ∧ n = Y ∧ Y ∈ X ⇒ m = ∅ ∧ n = Y ∧ Y ∈ X $ by ax
d1: $ … ⇒ n = Y ∧ Y ∈ X $ by and_elim_r [d0]
d2: $ … ⇒ n = Y $ by and_elim_l [d1]
d3: $ … ⇒ Y ∈ X $ by and_elim_r [d1]
d4: $ … ⇒ Y = n $ by eq_sym [d2]
d5: $ … ⇒ n ∈ X $ by wcel_eq_l [d4, d3]
d6: $ … ⇒ n ∊ X $ by wcel_welc [d5]
m3: $ G , n ∊ crn (b11_sp_O S F X Y) , ⟨ m , n ⟩ ∈ b11_sp_O S F X Y ⇒ n ∊ X $ by or_elim [m2, c3, d6]
n2: $ G , n ∊ crn (b11_sp_O S F X Y) ⇒ n ∊ X $ by crn_elim [n1, m3]
zz: $ G ⇒ crn (b11_sp_O S F X Y) ⊆ X $ by subset_intro [n2]

lemma b11_sp_pr {x y: set} (G: hyps x y) (A B: class) (n0: set): $ G ⇒ n0 = ⟨ A , B ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ ∃ x ∃ y (n0 = ⟨ x , y ⟩) $
----
h1: $ G , h = A , l = B ⇒ h = A $ by ax
l1: $ G , h = A , l = B ⇒ l = B $ by ax
e1: $ … ⇒ ⟨ h , l ⟩ = ⟨ A , B ⟩ $ by opair_eq [h1, l1]
e2: $ … ⇒ ⟨ A , B ⟩ = ⟨ h , l ⟩ $ by eq_sym [e1]
w715_h1: $ G , h = A , l = B ⇒ n0 = ⟨ A , B ⟩ $ by weaken [#1]
e3: $ … ⇒ n0 = ⟨ h , l ⟩ $ by eq_trans [w715_h1, e2]
e4: $ … ⇒ ∃ y (n0 = ⟨ h , y ⟩) $ by ex_intro [e3]
e5: $ … ⇒ ∃ x ∃ y (n0 = ⟨ x , y ⟩) $ by ex_intro [e4]
w716_h3: $ G , h = A ⇒ isset B $ by weaken [#3]
e6: $ G , h = A ⇒ ∃ x ∃ y (n0 = ⟨ x , y ⟩) $ by isset_elim [w716_h3, e5]
e7: $ G ⇒ ∃ x ∃ y (n0 = ⟨ x , y ⟩) $ by isset_elim [#2, e6]

