z1: $ G ⇒ ∃ m ∃ x (ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w r = scat x (swin r (fv nvf t4) (fv nvf t3))) $ by ex_elim [a0, e1]

lemma b7_leaf {i: set} (G: hyps) (M Q: class) (u w a b t1 t2 t3 t4 t5 t6: set): $ G ⇒ ra_indapp t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ G ⇒ t5 ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ b ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ nadd (fv nvf t4) (fv nvf t3) → fv a i = fv b i) $ > $ G ⇒ b7_hw t1 Q a b t4 t3 $ > $ G ⇒ uadm u $ > $ G ⇒ dt u M t5 w a ⊆ dt u M t5 w b $
----
l1: $ G ⇒ etel u (dnf u M) t5 w a = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t5 w a ⟩ ⟩ ⟩ ∧ dt u M t5 w a = apn (fv a (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w a) $ by lrel_indapp_sem [#1, #2, #3, #4]
l2: $ G ⇒ etel u (dnf u M) t5 w b = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t5 w b ⟩ ⟩ ⟩ ∧ dt u M t5 w b = apn (fv b (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w b) $ by lrel_indapp_sem [#1, #2, #3, #5]
l3: $ G ⇒ etel u (dnf u M) t5 w a = etel u (dnf u M) t5 w b $ by lrel_indapp_etel [#1, #2, #3, #4, #5, #6]
l4: $ G ⇒ ∃ m ∃ x (ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3))) $ by b7_indapp_shape [#1, #2, #3, #4, #8]
l5: $ G ⇒ swin a (fv nvf t4) (fv nvf t3) = Q $ by and_elim_r [#7]
l6: $ G ⇒ b7_hq t1 Q a b (nadd (fv nvf t4) (fv nvf t3)) $ by and_elim_l [#7]
p0: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) $ by ax
