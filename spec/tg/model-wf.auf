lemma b15_ient_pt {z o: set} (G: hyps z o) (M D W Z: class) (u tb tP tT tnp to tm tj tq te: set): $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ ra_ind_data D tb tP tT ∈ lrel $ > $ G ⇒ ra_clen tP tnp ∈ lrel $ > $ G ⇒ ra_nidx D to tm ∈ lrel $ > $ G ⇒ fv nvf to = tj $ > $ G ⇒ cdm tq = nadd (fv nvf tm) (fv nvf tnp) $ > $ G ⇒ tq ∊ fseq b6_V $ > $ G ⇒ ¬ iprop D tj W $ > $ G ⇒ ∀ z ∀ o (⟨ tj , ⟨ z , o ⟩ ⟩ ∈ Z → ⟨ tj , ⟨ z , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u M) D W) $ > $ G ⇒ nest tq te ∈ ient D W Z tj $ > $ G ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ Z $
----
q1: $ G ⇒ isset (nest tq te) $ by nest_set
q2: $ G , v = nest tq te ⇒ v = nest tq te $ by ax
q3: $ … ⇒ nest tq te = v $ by eq_sym [q2]
q4: $ G , v = nest tq te ⇒ nest tq te ∈ ient D W Z tj $ by weaken [#11]
q5: $ … ⇒ v ∈ ient D W Z tj $ by wcel_eq_l [q3, q4]
q6: $ … ⇒ v ∊ ient D W Z tj $ by wcel_welc [q5]
q7: $ … ⇒ ∃ x1 ∃ x2 (⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2))) $ by b7_ient_el [q6]
q8: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) ⇒ ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) $ by ax
q9: $ … ⇒ ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z $ by and_elim_l [q8]
q10: $ … ⇒ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) $ by and_elim_r [q8]
q11: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , iprop D tj W ∧ v = nest x1 ∅ ⇒ iprop D tj W ∧ v = nest x1 ∅ $ by ax
q12: $ … ⇒ iprop D tj W $ by and_elim_l [q11]
q13: $ … ⇒ v = nest x1 ∅ $ by and_elim_r [q11]
q14: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , iprop D tj W ∧ v = nest x1 ∅ ⇒ ¬ iprop D tj W $ by weaken [#9]
q15: $ … ⇒ ⊥ $ by not_elim [q14, q12]
q16: $ … ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ Z $ by bot_elim [q15]
q17: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ ¬ iprop D tj W ∧ v = nest x1 x2 $ by ax
q18: $ … ⇒ ¬ iprop D tj W $ by and_elim_l [q17]
q19: $ … ⇒ v = nest x1 x2 $ by and_elim_r [q17]
q20: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ ∀ z ∀ o (⟨ tj , ⟨ z , o ⟩ ⟩ ∈ Z → ⟨ tj , ⟨ z , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u M) D W) $ by weaken [#10]
q21: $ … ⇒ ∀ o (⟨ tj , ⟨ x1 , o ⟩ ⟩ ∈ Z → ⟨ tj , ⟨ x1 , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u M) D W) $ by all_elim [q20]
q22: $ … ⇒ ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z → ⟨ tj , ⟨ x1 , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u M) D W $ by all_elim [q21]
q23: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z $ by weaken [q9]
q24: $ … ⇒ ⟨ tj , ⟨ x1 , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u M) D W $ by imp_elim [q22, q23]
q25: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ D ∈ ofsort lsig lopen ks_ind $ by weaken [#1]
q26: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ W ∈ lvals $ by weaken [#2]
q27: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ ra_ind_data D tb tP tT ∈ lrel $ by weaken [#3]
q28: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ ra_clen tP tnp ∈ lrel $ by weaken [#4]
q29: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ ra_nidx D to tm ∈ lrel $ by weaken [#5]
q30: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ fv nvf to = tj $ by weaken [#6]
q31: $ … ⇒ cdm x1 = nadd (fv nvf tm) (fv nvf tnp) $ by b15_len [q25, q26, q27, q28, q29, q30, q24]
q32: $ … ⇒ nadd (fv nvf tm) (fv nvf tnp) = cdm x1 $ by eq_sym [q31]
q33: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ cdm tq = nadd (fv nvf tm) (fv nvf tnp) $ by weaken [#7]
q34: $ … ⇒ cdm tq = cdm x1 $ by eq_trans [q33, q32]
q35: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ itc u (dnf u M) D W ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by itc_sub
q36: $ … ⇒ ⟨ tj , ⟨ x1 , scons ∅ ∅ ⟩ ⟩ ∈ ω × (fseq u × fseq (ω ∪ u)) $ by wcel_subset [q35, q24]
q37: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ isset tj $ by isset_var
q38: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ isset ⟨ x1 , scons ∅ ∅ ⟩ $ by opair_isset
q39: $ … ⇒ tj ∈ ω ∧ ⟨ x1 , scons ∅ ∅ ⟩ ∈ fseq u × fseq (ω ∪ u) $ by cxp_elim_pair_c [q36, q37, q38]
q40: $ … ⇒ tj ∈ ω $ by and_elim_l [q39]
q41: $ … ⇒ ⟨ x1 , scons ∅ ∅ ⟩ ∈ fseq u × fseq (ω ∪ u) $ by and_elim_r [q39]
q42: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ isset x1 $ by isset_var
q43: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ isset ∅ $ by ax_empty
q44: $ … ⇒ isset (scons ∅ ∅) $ by scons_set [q43]
q45: $ … ⇒ x1 ∈ fseq u ∧ scons ∅ ∅ ∈ fseq (ω ∪ u) $ by cxp_elim_pair_c [q41, q42, q44]
q46: $ … ⇒ x1 ∈ fseq u $ by and_elim_l [q45]
q47: $ … ⇒ scons ∅ ∅ ∈ fseq (ω ∪ u) $ by and_elim_r [q45]
q48: $ … ⇒ x1 ∊ fseq u $ by wcel_welc [q46]
q49: $ … ⇒ x1 ∊ fseq b6_V $ by b6_fseq_V [q48]
q50: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ nest tq te = v $ by weaken [q3]
q51: $ … ⇒ nest tq te = nest x1 x2 $ by eq_trans [q50, q19]
q52: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ tq ∊ fseq b6_V $ by weaken [#8]
q53: $ … ⇒ tq = x1 ∧ te = x2 $ by nest_inj [q52, q49, q34, q51]
q54: $ … ⇒ tq = x1 $ by and_elim_l [q53]
q55: $ … ⇒ te = x2 $ by and_elim_r [q53]
q56: $ … ⇒ x1 = tq $ by eq_sym [q54]
q57: $ … ⇒ x2 = te $ by eq_sym [q55]
q58: $ G , v = nest tq te , ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2)) , ¬ iprop D tj W ∧ v = nest x1 x2 ⇒ tj = tj $ by eq_refl
q59: $ … ⇒ ⟨ x1 , x2 ⟩ = ⟨ tq , te ⟩ $ by opair_eq [q56, q57]
q60: $ … ⇒ ⟨ tj , ⟨ x1 , x2 ⟩ ⟩ = ⟨ tj , ⟨ tq , te ⟩ ⟩ $ by opair_eq [q58, q59]
q61: $ … ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ Z $ by wcel_eq_l [q60, q23]
q62: $ … ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ Z $ by or_elim [q10, q16, q61]
q63: $ G , v = nest tq te , ∃ x2 (⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2))) ⇒ ∃ x2 (⟨ tj , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ ((iprop D tj W ∧ v = nest x1 ∅) ∨ (¬ iprop D tj W ∧ v = nest x1 x2))) $ by ax
q64: $ … ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ Z $ by ex_elim [q63, q62]
q65: $ … ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ Z $ by ex_elim [q7, q64]
q66: $ … ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ Z $ by isset_elim [q1, q65]

lemma b15_yval {i: set} (G: hyps i) (H D W R: class) (u tv tj: set): $ G ⇒ tv ∊ fseq u $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ cdm tv = intys D $ > $ G ⇒ ∀ i (i ∊ intys D → fv tv i = ityv u (dnf u (mcv H)) D i W) $ > $ G ⇒ tj ∊ intys D $ > $ G ⇒ fv (scat tv R) tj = ityv u (dnf u (mcv H)) D tj W $
----
q1: $ … ⇒ isset R $ by wcel_isset [#2]
q2: $ G , r = R ⇒ r = R $ by ax
q3: $ … ⇒ R = r $ by eq_sym [q2]
q4: $ G , r = R ⇒ R ∈ fseq u $ by weaken [#2]
q5: $ … ⇒ r ∈ fseq u $ by wcel_eq_l [q3, q4]
q6: $ … ⇒ r ∊ fseq u $ by wcel_welc [q5]
q7: $ G , r = R ⇒ cdm tv = intys D $ by weaken [#3]
q8: $ … ⇒ intys D = cdm tv $ by eq_sym [q7]
q9: $ G , r = R ⇒ tj ∊ intys D $ by weaken [#5]
q10: $ … ⇒ tj ∊ cdm tv $ by welc_eq [q8, q9]
q11: $ G , r = R ⇒ tv ∊ fseq u $ by weaken [#1]
q12: $ … ⇒ fv (scat tv r) tj = fv tv tj $ by scat_fv_l [q11, q6, q10]
q13: $ G , r = R ⇒ tv = tv $ by eq_refl
q14: $ G , r = R ⇒ tj = tj $ by eq_refl
q15: $ … ⇒ scat tv R = scat tv r $ by scat_eq [q13, q3]
q16: $ … ⇒ fv (scat tv R) tj = fv (scat tv r) tj $ by fv_eq [q15, q14]
q17: $ G , r = R ⇒ ∀ i (i ∊ intys D → fv tv i = ityv u (dnf u (mcv H)) D i W) $ by weaken [#4]
q18: $ … ⇒ tj ∊ intys D → fv tv tj = ityv u (dnf u (mcv H)) D tj W $ by all_elim [q17]
q19: $ … ⇒ fv tv tj = ityv u (dnf u (mcv H)) D tj W $ by imp_elim [q18, q9]
q20: $ … ⇒ fv (scat tv R) tj = fv tv tj $ by eq_trans [q16, q12]
q21: $ … ⇒ fv (scat tv R) tj = ityv u (dnf u (mcv H)) D tj W $ by eq_trans [q20, q19]
q22: $ … ⇒ fv (scat tv R) tj = ityv u (dnf u (mcv H)) D tj W $ by isset_elim [q1, q21]

lemma b15_ntys_s {j l: set} (G: hyps) (tT tn tm0 y1 y2 y3: set): $ G ⇒ ra_ntys tT tn tm0 ∈ lrel $ > $ G ⇒ tT = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ > $ G ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $
----
q1: $ … ⇒ (tT = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm0 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) $ by lrel_ntys_cases [#1]
q2: $ G ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
q3: $ … ⇒ isset kc_tcons $ by wcel_isset [q2]
q4: $ G , tT = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm0 = ⟨ kc_nz , ∅ ⟩ ⇒ tT = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm0 = ⟨ kc_nz , ∅ ⟩ $ by ax
q5: $ … ⇒ tT = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [q4]
q6: $ … ⇒ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm0 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [q4]
q7: $ … ⇒ tn = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [q6]
q8: $ … ⇒ tm0 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [q6]
q9: $ … ⇒ ⟨ kc_tnil , ∅ ⟩ = tT $ by eq_sym [q5]
q10: $ G , tT = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm0 = ⟨ kc_nz , ∅ ⟩ ⇒ tT = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ by weaken [#2]
q11: $ … ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ by eq_trans [q9, q10]
q12: $ G , tT = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm0 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
q13: $ … ⇒ isset kc_tnil $ by wcel_isset [q12]
q14: $ G , tT = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm0 = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_tcons $ by weaken [q3]
q15: $ … ⇒ kc_tnil = kc_tcons $ by opair_inj_l_c [q11, q13, q14]
q16: $ G , tT = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm0 = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_tnil = kc_tcons $ by kc_tnil_ne_tcons
q17: $ … ⇒ ⊥ $ by not_elim [q16, q15]
q18: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by bot_elim [q17]
q19: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel ⇒ tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel $ by ax
q20: $ … ⇒ tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ $ by and_elim_l [q19]
q21: $ … ⇒ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel $ by and_elim_r [q19]
q22: $ … ⇒ tn = ⟨ kc_s , scons x1 ∅ ⟩ $ by and_elim_l [q21]
q23: $ … ⇒ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel $ by and_elim_r [q21]
q24: $ … ⇒ tm0 = m $ by and_elim_l [q23]
q25: $ … ⇒ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel $ by and_elim_r [q23]
q26: $ … ⇒ ra_ntys g x1 x2 ∈ lrel $ by and_elim_l [q25]
q27: $ … ⇒ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel $ by and_elim_r [q25]
q28: $ … ⇒ ra_clen_c e o ∈ lrel $ by and_elim_l [q27]
q29: $ … ⇒ ra_add x2 o m ∈ lrel $ by and_elim_r [q27]
q30: $ … ⇒ ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ = tT $ by eq_sym [q20]
q31: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel ⇒ tT = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ by weaken [#2]
q32: $ … ⇒ ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ by eq_trans [q30, q31]
q33: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel ⇒ isset kc_tcons $ by weaken [q3]
q34: $ … ⇒ d = y1 ∧ e = y2 ∧ g = y3 $ by node3_inj [q33, q32]
q35: $ … ⇒ d = y1 $ by and_elim_l [q34]
q36: $ … ⇒ e = y2 ∧ g = y3 $ by and_elim_r [q34]
q37: $ … ⇒ e = y2 $ by and_elim_l [q36]
q38: $ … ⇒ g = y3 $ by and_elim_r [q36]
q39: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel ⇒ x1 = x1 $ by eq_refl
q40: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel ⇒ x2 = x2 $ by eq_refl
q41: $ … ⇒ ra_ntys g x1 x2 = ra_ntys y3 x1 x2 $ by ra_ntys_eq [q38, q39, q40]
q42: $ … ⇒ ra_ntys y3 x1 x2 ∈ lrel $ by wcel_eq_l [q41, q26]
q43: $ … ⇒ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ ra_ntys y3 x1 x2 ∈ lrel $ by and_intro [q22, q42]
q44: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel ⇒ ∃ l (tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ ra_ntys y3 x1 l ∈ lrel) $ by ex_intro [q43]
q45: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by ex_intro [q44]
q46: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) ⇒ ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) $ by ax
q47: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by ex_elim [q46, q45]
q48: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) ⇒ ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) $ by ax
q49: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by ex_elim [q48, q47]
q50: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) ⇒ ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) $ by ax
q51: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by ex_elim [q50, q49]
q52: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) $ by ax
q53: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by ex_elim [q52, q51]
q54: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) ⇒ ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) $ by ax
q55: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by ex_elim [q54, q53]
q56: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) , ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) ⇒ ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) $ by ax
q57: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by ex_elim [q56, q55]
q58: $ G , ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) ⇒ ∃ d ∃ e ∃ g ∃ x1 ∃ x2 ∃ o ∃ m (tT = ⟨ kc_tcons , scons d (scons e (scons g ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x1 ∅ ⟩ ∧ tm0 = m ∧ ra_ntys g x1 x2 ∈ lrel ∧ ra_clen_c e o ∈ lrel ∧ ra_add x2 o m ∈ lrel) $ by ax
q59: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by ex_elim [q58, q57]
q60: $ … ⇒ ∃ j ∃ l (tn = ⟨ kc_s , scons j ∅ ⟩ ∧ ra_ntys y3 j l ∈ lrel) $ by or_elim [q1, q18, q59]

lemma b15_rng_case {x4 x5 x6 x7: set} (G: hyps x4 x5 x6 x7) (tT ti tf te tn tm0: set): $ G ⇒ ra_nth_ty tT ti tf te ∈ lrel $ > $ G ⇒ ra_ntys tT tn tm0 ∈ lrel $ > $ G ⇒ ∀ x4 ∀ x5 ∀ x6 ∀ x7 (ra_nth_ty x5 x6 tf te ∈ lrel → ra_ntys x5 x4 x7 ∈ lrel → suc (fv nvf x6) = fv nvf ti → fv nvf x6 ∈ fv nvf x4) $ > $ G ⇒ fv nvf ti ∈ fv nvf tn $
----
q1: $ … ⇒ ∃ a ∃ b ∃ c (tT = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = a ∧ te = b) ∨ ∃ a ∃ h ∃ b ∃ k ∃ c ∃ q (tT = ⟨ kc_tcons , scons h (scons k (scons c ∅)) ⟩ ∧ ti = ⟨ kc_s , scons q ∅ ⟩ ∧ tf = a ∧ te = b ∧ ra_nth_ty c q a b ∈ lrel) $ by lrel_nth_ty_cases [#1]
q2: $ G ⇒ nvf = nvf $ by eq_refl
q3: $ G ⇒ kr_ntys ∈ ω $ by kr_ntys_omega
q4: $ … ⇒ isset kr_ntys $ by wcel_isset [q3]
q5: $ G , ∃ a ∃ b ∃ c (tT = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = a ∧ te = b) , tT = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = a ∧ te = b ⇒ tT = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = a ∧ te = b $ by ax
