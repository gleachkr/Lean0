m5: $ G ⇒ ap (clam o lvals (clam p (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) o p ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) o p) a) ⟩ ⟩ ⟩)})) w = clam p (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w p ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) w p) a) ⟩ ⟩ ⟩)} $ by clam_ap [#5]
m6: $ G ⇒ ap (fv (etf u E) ⟨ k , h ⟩) w = clam p (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w p ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) w p) a) ⟩ ⟩ ⟩)} $ by eq_trans [m4, m5]
m7: $ G ⇒ ap (ap (fv (etf u E) ⟨ k , h ⟩) w) r = ap (clam p (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w p ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) w p) a) ⟩ ⟩ ⟩)}) r $ by ap_eq [m6, r1]
m8: $ G ⇒ ap (clam p (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w p ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) w p) a) ⟩ ⟩ ⟩)}) r = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $ by clam_ap [#6]
m9: $ G ⇒ da (fv (etf u E) ⟨ k , h ⟩) w r = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $ by eq_trans [m7, m8]

lemma b5_nd3 (G: hyps) (E: class) (u k h c w r: set): $ G ⇒ k ∊ ω $ > $ G ⇒ h ∊ fseq (trees ω) $ > $ G ⇒ c = ccom (etf u E) h $ > $ G ⇒ ¬ k = kc_pi $ > $ G ⇒ ¬ k = kc_app $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ da (fv (etf u E) ⟨ k , h ⟩) w r = (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩) $
----
n4: $ G ⇒ fv (etf u E) ⟨ k , h ⟩ = etb u E k h c $ by etf_node [#1, #2, #3]
m2: $ G ⇒ etb u E k h c = clam o lvals (clam p (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by b5_etb_k3 [#4, #5]
m3: $ G ⇒ fv (etf u E) ⟨ k , h ⟩ = clam o lvals (clam p (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by eq_trans [n4, m2]
w1: $ G ⇒ w = w $ by eq_refl
r1: $ G ⇒ r = r $ by eq_refl
m4: $ G ⇒ ap (fv (etf u E) ⟨ k , h ⟩) w = ap (clam o lvals (clam p (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) w $ by ap_eq [m3, w1]
m5: $ G ⇒ ap (clam o lvals (clam p (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) w = clam p (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩) $ by clam_ap [#6]
m6: $ G ⇒ ap (fv (etf u E) ⟨ k , h ⟩) w = clam p (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩) $ by eq_trans [m4, m5]
m7: $ G ⇒ ap (ap (fv (etf u E) ⟨ k , h ⟩) w) r = ap (clam p (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) r $ by ap_eq [m6, r1]
m8: $ G ⇒ ap (clam p (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) r = (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩) $ by clam_ap [#7]
m9: $ G ⇒ da (fv (etf u E) ⟨ k , h ⟩) w r = (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩) $ by eq_trans [m7, m8]

lemma b5_xq_sub {x f g t a y: set} (G: hyps) (P P2 D D2 Q Q2 R O: class) (u w: set): $ G ⇒ P = P2 $ > $ G ⇒ D = D2 $ > $ G ⇒ ∀ x (x ∊ u → da Q w (scons x R) = da Q2 w (scons x O)) $ > $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $
----
k1: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by ax
k2: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ P $ by and_elim_l [k1]
k1a: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by and_elim_r [k1]
k3: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ u $ by and_elim_l [k1a]
k3a: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by and_elim_r [k1a]
k4: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) $ by and_elim_l [k3a]
k5: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by and_elim_r [k3a]
h1: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ P = P2 $ by weaken [#1]
h2a: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ∀ x (x ∊ u → da Q w (scons x R) = da Q2 w (scons x O)) $ by weaken [#3]
h2b: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ u → da Q w (scons x R) = da Q2 w (scons x O) $ by all_elim [h2a]
h2: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ da Q w (scons x R) = da Q2 w (scons x O) $ by imp_elim [h2b, k3]
h3: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ D = D2 $ by weaken [#2]
e1: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ P2 $ by welc_eq [h1, k2]
e3: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q2 w (scons x O) $ by wcel_eq_r [h2, k4]
w3: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ t = t $ by eq_refl
w4: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ a = a $ by eq_refl
w5: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ scons x g = scons x g $ by eq_refl
w6: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ssnoc f x = ssnoc f x $ by eq_refl
e4: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ scons D t = scons D2 t $ by scons_eq [h3, w3]
e5: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ scons D t , a ⟩ = ⟨ scons D2 t , a ⟩ $ by opair_eq [e4, w4]
e6: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ = ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ $ by opair_eq [w5, e5]
e7: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩ $ by opair_eq [w6, e6]
e8: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩ $ by eq_trans [k5, e7]
c1: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q2 w (scons x O) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩ $ by and_intro [e3, e8]
c2: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q2 w (scons x O) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩ $ by and_intro [k3, c1]
