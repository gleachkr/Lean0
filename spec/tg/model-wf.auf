q54: $ G , z = ⟨ kc_cons , scons d (scons g ∅) ⟩ ∧ t2 = e ∧ t3 = f ∧ ra_pis g ⟨ kc_pi , scons d (scons e ∅) ⟩ f ∈ lrel ⇒ ∃ x2 (z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (z = ⟨ kc_cons , scons x1 (scons x4 ∅) ⟩ ∧ t2 = x2 ∧ t4 = x3 ∧ ra_pis x4 ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ x3 ∈ lrel) $ by lrel_pis_cases [q53]
