lemma b8_etel_dom (G: hyps) (E K W R: class) (u y: set):
  $ G ⇒ K ∈ trees ω $ > $ G ⇒ y ∊ etel u E K W R $ > $ G ⇒ R ∈ fseq u $
----
a0: $ G ⇒ isset K $ by wcel_isset [#1]
m1: $ G , k = K ⇒ k = K $ by ax
m2: $ G , k = K ⇒ K = k $ by eq_sym [m1]
m3: $ G , k = K ⇒ K ∈ trees ω $ by weaken [#1]
m4: $ G , k = K ⇒ k ∈ trees ω $ by wcel_eq_l [m2, m3]
m5: $ G , k = K ⇒ k ∊ trees ω $ by wcel_welc [m4]
m6: $ G , k = K ⇒ W = W $ by eq_refl
m7: $ G , k = K ⇒ R = R $ by eq_refl
m8: $ G , k = K ⇒ etel u E K W R = etel u E k W R $ by etel_eq [m2, m6, m7]
m9: $ G , k = K ⇒ y ∊ etel u E K W R $ by weaken [#2]
m10: $ G , k = K ⇒ y ∊ etel u E k W R $ by welc_eq [m8, m9]
m11: $ G , k = K ⇒ isset W ∧ isset R $ by etel_isset [m5, m10]
m12: $ G , k = K ⇒ isset W $ by and_elim_l [m11]
m13: $ G , k = K ⇒ isset R $ by and_elim_r [m11]
n0: $ G , k = K , w = W ⇒ isset R $ by weaken [m13]
n1: $ G , k = K , w = W , r = R ⇒ w = W $ by ax
n2: $ G , k = K , w = W , r = R ⇒ r = R $ by ax
n3: $ G , k = K , w = W , r = R ⇒ W = w $ by eq_sym [n1]
n4: $ G , k = K , w = W , r = R ⇒ R = r $ by eq_sym [n2]
n5: $ G , k = K , w = W , r = R ⇒ k = k $ by eq_refl
n6: $ G , k = K , w = W , r = R ⇒ etel u E k W R = etel u E k w r $ by etel_eq [n5, n3, n4]
n7: $ G , k = K , w = W , r = R ⇒ y ∊ etel u E k W R $ by weaken [m10]
n8: $ G , k = K , w = W , r = R ⇒ y ∊ etel u E k w r $ by welc_eq [n6, n7]
n8b: $ G , k = K , w = W , r = R ⇒ y ∈ etel u E k w r $ by welc_wcel [n8]
n9: $ G , k = K , w = W , r = R ⇒ k ∊ trees ω $ by weaken [m5]
n10: $ G , k = K , w = W , r = R ⇒ w ∊ lvals ∧ r ∊ fseq u $ by etel_dom [n9, n8b]
n11: $ G , k = K , w = W , r = R ⇒ r ∊ fseq u $ by and_elim_r [n10]
n12: $ G , k = K , w = W , r = R ⇒ r ∈ fseq u $ by welc_wcel [n11]
n13: $ G , k = K , w = W , r = R ⇒ R ∈ fseq u $ by wcel_eq_l [n2, n12]
n14: $ G , k = K , w = W ⇒ R ∈ fseq u $ by isset_elim [n0, n13]
p1: $ G , k = K ⇒ R ∈ fseq u $ by isset_elim [m12, n14]
p2: $ G ⇒ R ∈ fseq u $ by isset_elim [a0, p1]

lemma b8_etel_u (G: hyps) (M K W R: class) (u: set):
  $ G ⇒ uadm u $ > $ G ⇒ K ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ etel u (dnf u M) K W R ∈ u $
----
a1: $ G ⇒ R ∈ fseq u ∨ ¬ R ∈ fseq u $ by excluded_middle
b1: $ G , R ∈ fseq u ⇒ uadm u $ by weaken [#1]
b2: $ G , R ∈ fseq u ⇒ K ∈ ofsort lsig lopen ks_expr $ by weaken [#2]
b3: $ G , R ∈ fseq u ⇒ W ∈ lvals $ by weaken [#3]
b4: $ G , R ∈ fseq u ⇒ R ∈ fseq u $ by ax
b5: $ G , R ∈ fseq u ⇒ etel u (dnf u M) K W R ∈ u $ by etel_universe [b1, b2, b3, b4]
c1: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ sig lsig lopen $ by lsig_sig
c2: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ ofsort lsig lopen ks_expr ⊆ trees ω $ by ofsort_trees [c1]
c3: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ K ∈ ofsort lsig lopen ks_expr $ by weaken [#2]
c4: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ K ∈ trees ω $ by wcel_subset [c2, c3]
c5: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ y ∊ etel u (dnf u M) K W R $ by ax
c6: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ R ∈ fseq u $ by b8_etel_dom [c4, c5]
c7: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ ¬ R ∈ fseq u $ by ax
c8: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ ⊥ $ by not_elim [c7, c6]
c9: $ G , ¬ R ∈ fseq u , y ∊ etel u (dnf u M) K W R ⇒ y ∊ ∅ $ by bot_elim [c8]
c10: $ G , ¬ R ∈ fseq u ⇒ etel u (dnf u M) K W R ⊆ ∅ $ by subset_intro [c9]
c11: $ G , ¬ R ∈ fseq u ⇒ uadm u $ by weaken [#1]
c12: $ G , ¬ R ∈ fseq u ⇒ universe u $ by uadm_universe [c11]
c13: $ G , ¬ R ∈ fseq u ⇒ ∅ ∈ u $ by uadm_empty [c11]
c14: $ G , ¬ R ∈ fseq u ⇒ etel u (dnf u M) K W R ∈ u $ by universe_subset_c [c12, c13, c10]
d1: $ G ⇒ etel u (dnf u M) K W R ∈ u $ by or_elim [a1, b5, c14]

lemma b8_etel_g (G: hyps) (E K W R: class) (u f g t a: set):
  $ G ⇒ isset W $ > $ G ⇒ K ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E K W R $ > $ G ⇒ g ∊ fseq u $
----
a1: $ G , h = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , h ∊ etel u E K W R ⇒ h ∊ etel u E K W R $ by ax
a2: $ G , h = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , h ∊ etel u E K W R ⇒ K ∈ trees ω $ by weaken [#2]
a3: $ G , h = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , h ∊ etel u E K W R ⇒ R ∈ fseq u $ by b8_etel_dom [a2, a1]
a4: $ G , h = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , h ∊ etel u E K W R ⇒ isset R $ by wcel_isset [a3]
a5: $ G ⇒ isset R $ by wcel_elim [#3, a4]
b1: $ G , r = R ⇒ r = R $ by ax
b2: $ G , r = R ⇒ R = r $ by eq_sym [b1]
b2a: $ G , r = R ⇒ K = K $ by eq_refl
b2b: $ G , r = R ⇒ W = W $ by eq_refl
b3: $ G , r = R ⇒ etel u E K W R = etel u E K W r $ by etel_eq [b2a, b2b, b2]
b4: $ G , r = R ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E K W R $ by weaken [#3]
b5: $ G , r = R ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E K W r $ by wcel_eq_r [b3, b4]
b5a: $ G , r = R ⇒ isset W $ by weaken [#1]
b5b: $ G , r = R ⇒ K ∈ trees ω $ by weaken [#2]
b6: $ G , r = R ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $ by etel_fseq_c [b5a, b5b, b5]
b7: $ G , r = R ⇒ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $ by and_elim_r [b6]
b8: $ G , r = R ⇒ g ∊ fseq u $ by and_elim_l [b7]
b9: $ G ⇒ g ∊ fseq u $ by isset_elim [a5, b8]

lemma b8_cuop {x: set} (G: hyps) (U A: class) (B: class x):
  $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ ∀ x (x ∊ A → B ∈ U) $ > $ G ⇒ ⋃ (img (cgr x B) A) ∈ U $
----
l1: $ G , v = A , v ∊ U , x ∊ v ⇒ ∀ x (x ∊ A → B ∈ U) $ by weaken [#3]
l2: $ G , v = A , v ∊ U , x ∊ v ⇒ x ∊ A → B ∈ U $ by all_elim [l1]
l3: $ G , v = A , v ∊ U , x ∊ v ⇒ v = A $ by ax
l4: $ G , v = A , v ∊ U , x ∊ v ⇒ x ∊ v $ by ax
l5: $ G , v = A , v ∊ U , x ∊ v ⇒ x ∊ A $ by welc_eq [l3, l4]
l6: $ G , v = A , v ∊ U , x ∊ v ⇒ B ∈ U $ by imp_elim [l2, l5]
l7: $ G , v = A , v ∊ U ⇒ x ∊ v → B ∈ U $ by imp_intro [l6]
l8: $ G , v = A , v ∊ U ⇒ ∀ x (x ∊ v → B ∈ U) $ by all_intro [l7]
l9: $ G , v = A , v ∊ U ⇒ universe U $ by weaken [#1]
l10: $ G , v = A , v ∊ U ⇒ v ∊ U $ by ax
l11: $ G , v = A , v ∊ U ⇒ ⋃ (img (cgr x B) v) ∈ U $ by universe_cuni_op [l9, l10, l8]
l12: $ G , v = A , v ∊ U ⇒ v = A $ by ax
l13: $ G , v = A , v ∊ U ⇒ cgr x B = cgr x B $ by eq_refl
l14: $ G , v = A , v ∊ U ⇒ img (cgr x B) v = img (cgr x B) A $ by img_eq [l13, l12]
l15: $ G , v = A , v ∊ U ⇒ ⋃ (img (cgr x B) v) = ⋃ (img (cgr x B) A) $ by cuni_eq [l14]
l16: $ G , v = A , v ∊ U ⇒ ⋃ (img (cgr x B) A) ∈ U $ by wcel_eq_l [l15, l11]
l17: $ G ⇒ ⋃ (img (cgr x B) A) ∈ U $ by wcel_elim [#2, l16]

lemma b8_cu_in {x: set} (G: hyps) (A: class) (B: class x) (a z: set):
  $ G ⇒ a ∊ A $ > $ G ⇒ z ∊ (⟦ x / a ⟧ B) $ > $ G ⇒ isset (⟦ x / a ⟧ B) $ > $ G ⇒ z ∊ ⋃ (img (cgr x B) A) $
----
n1: $ G , v = (⟦ x / a ⟧ B) ⇒ v = (⟦ x / a ⟧ B) $ by ax
n2: $ G , v = (⟦ x / a ⟧ B) ⇒ ⟨ a , v ⟩ ∈ cgr x B $ by cgr_intro [n1]
n3: $ G , v = (⟦ x / a ⟧ B) ⇒ a ∊ A $ by weaken [#1]
n4: $ G , v = (⟦ x / a ⟧ B) ⇒ v ∊ img (cgr x B) A $ by img_intro [n3, n2]
n5: $ G , v = (⟦ x / a ⟧ B) ⇒ (⟦ x / a ⟧ B) = v $ by eq_sym [n1]
n6: $ G , v = (⟦ x / a ⟧ B) ⇒ z ∊ (⟦ x / a ⟧ B) $ by weaken [#2]
n7: $ G , v = (⟦ x / a ⟧ B) ⇒ z ∊ v $ by welc_eq [n5, n6]
n8: $ G , v = (⟦ x / a ⟧ B) ⇒ z ∊ ⋃ (img (cgr x B) A) $ by cuni_intro [n7, n4]
n9: $ G ⇒ z ∊ ⋃ (img (cgr x B) A) $ by isset_elim [#3, n8]

lemma b8_g_in (G: hyps) (T: class) (f g t a: set):
  $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ T $ > $ G ⇒ g ∊ cdm (crn T) $
----
i0: $ G ⇒ isset t $ by isset_var
i1: $ G ⇒ isset a $ by isset_var
i2: $ G ⇒ isset ⟨ t , a ⟩ $ by opair_set [i0, i1]
j1: $ G , v = ⟨ t , a ⟩ ⇒ isset g $ by isset_var
j2: $ G , v = ⟨ t , a ⟩ ⇒ isset v $ by isset_var
j3: $ G , v = ⟨ t , a ⟩ ⇒ isset ⟨ g , v ⟩ $ by opair_set [j1, j2]
k1: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ v = ⟨ t , a ⟩ $ by ax
k2: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ w = ⟨ g , v ⟩ $ by ax
k3: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ g = g $ by eq_refl
k4: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ ⟨ t , a ⟩ = v $ by eq_sym [k1]
k5: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ ⟨ g , ⟨ t , a ⟩ ⟩ = ⟨ g , v ⟩ $ by opair_eq [k3, k4]
k6: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ ⟨ g , v ⟩ = w $ by eq_sym [k2]
k7: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ ⟨ g , ⟨ t , a ⟩ ⟩ = w $ by eq_trans [k5, k6]
k8: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ f = f $ by eq_refl
k9: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ = ⟨ f , w ⟩ $ by opair_eq [k8, k7]
k10: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ T $ by weaken [#1]
k11: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ ⟨ f , w ⟩ ∈ T $ by wcel_eq_l [k9, k10]
k12: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ w ∊ crn T $ by crn_intro [k11]
k13: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ w ∈ crn T $ by welc_wcel [k12]
k14: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ ⟨ g , v ⟩ ∈ crn T $ by wcel_eq_l [k2, k13]
k15: $ G , v = ⟨ t , a ⟩ , w = ⟨ g , v ⟩ ⇒ g ∊ cdm (crn T) $ by cdm_intro [k14]
k16: $ G , v = ⟨ t , a ⟩ ⇒ g ∊ cdm (crn T) $ by isset_elim [j3, k15]
k17: $ G ⇒ g ∊ cdm (crn T) $ by isset_elim [i2, k16]

lemma b8_fv_in (G: hyps) (A: class) (g d y: set):
  $ G ⇒ g ∊ A $ > $ G ⇒ y ∊ fv g d $ > $ G ⇒ y ∊ ⋃ (crn (⋃ A)) $
----
q2: $ G , v ∊ ap g d , y ∊ v ⇒ v ∊ ap g d $ by ax
q3: $ G , v ∊ ap g d , y ∊ v ⇒ ⟨ d , v ⟩ ∈ g $ by cab_elim [q2]
q4: $ G , v ∊ ap g d , y ∊ v ⇒ g ∊ A $ by weaken [#1]
q5: $ G , v ∊ ap g d , y ∊ v ⇒ g ⊆ ⋃ A $ by cuni_subset [q4]
q6: $ G , v ∊ ap g d , y ∊ v ⇒ ⟨ d , v ⟩ ∈ ⋃ A $ by wcel_subset [q5, q3]
q7: $ G , v ∊ ap g d , y ∊ v ⇒ v ∊ crn (⋃ A) $ by crn_intro [q6]
q8: $ G , v ∊ ap g d , y ∊ v ⇒ y ∊ v $ by ax
q9: $ G , v ∊ ap g d , y ∊ v ⇒ y ∊ ⋃ (crn (⋃ A)) $ by cuni_intro [q8, q7]
q10: $ G ⇒ y ∊ ⋃ (crn (⋃ A)) $ by cuni_elim [#2, q9]

lemma b8_crn_u (G: hyps) (U A: class):
  $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ crn A ∈ U $
----
r1: $ G , v = A , v ∊ U ⇒ universe U $ by weaken [#1]
r2: $ G , v = A , v ∊ U ⇒ v ∊ U $ by ax
r3: $ G , v = A , v ∊ U ⇒ crn v ∈ U $ by universe_crn [r1, r2]
r4: $ G , v = A , v ∊ U ⇒ v = A $ by ax
r5: $ G , v = A , v ∊ U ⇒ crn v = crn A $ by crn_eq [r4]
r6: $ G , v = A , v ∊ U ⇒ crn A ∈ U $ by wcel_eq_l [r5, r3]
r7: $ G ⇒ crn A ∈ U $ by wcel_elim [#2, r6]

lemma b8_cdm_u (G: hyps) (U A: class):
  $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ cdm A ∈ U $
----
r1: $ G , v = A , v ∊ U ⇒ universe U $ by weaken [#1]
r2: $ G , v = A , v ∊ U ⇒ v ∊ U $ by ax
r3: $ G , v = A , v ∊ U ⇒ cdm v ∈ U $ by universe_cdm [r1, r2]
r4: $ G , v = A , v ∊ U ⇒ v = A $ by ax
r5: $ G , v = A , v ∊ U ⇒ cdm v = cdm A $ by cdm_eq [r4]
r6: $ G , v = A , v ∊ U ⇒ cdm A ∈ U $ by wcel_eq_l [r5, r3]
r7: $ G ⇒ cdm A ∈ U $ by wcel_elim [#2, r6]

lemma b8_fseq_u (G: hyps) (U A: class):
  $ G ⇒ universe U $ > $ G ⇒ ω ∈ U $ > $ G ⇒ A ∈ U $ > $ G ⇒ fseq A ∈ U $
----
r1: $ G , v = A , v ∊ U ⇒ universe U $ by weaken [#1]
r1b: $ G , v = A , v ∊ U ⇒ ω ∈ U $ by weaken [#2]
r2: $ G , v = A , v ∊ U ⇒ v ∊ U $ by ax
r3: $ G , v = A , v ∊ U ⇒ fseq v ∈ U $ by universe_fseq [r1, r1b, r2]
r4: $ G , v = A , v ∊ U ⇒ v = A $ by ax
r5: $ G , v = A , v ∊ U ⇒ fseq v = fseq A $ by fseq_eq [r4]
r6: $ G , v = A , v ∊ U ⇒ fseq A ∈ U $ by wcel_eq_l [r5, r3]
r7: $ G ⇒ fseq A ∈ U $ by wcel_elim [#3, r6]

lemma b8_csn0_u (G: hyps) (U: class):
  $ G ⇒ universe U $ > $ G ⇒ ∅ ∈ U $ > $ G ⇒ csn ∅ ∈ U $
----
r1: $ G , v = ∅ , v ∊ U ⇒ universe U $ by weaken [#1]
r2: $ G , v = ∅ , v ∊ U ⇒ v ∊ U $ by ax
r3: $ G , v = ∅ , v ∊ U ⇒ csn v ∈ U $ by universe_csn [r1, r2]
r4: $ G , v = ∅ , v ∊ U ⇒ v = ∅ $ by ax
r5: $ G , v = ∅ , v ∊ U ⇒ csn v = csn ∅ $ by csn_eq [r4]
r6: $ G , v = ∅ , v ∊ U ⇒ csn ∅ ∈ U $ by wcel_eq_l [r5, r3]
r7: $ G ⇒ csn ∅ ∈ U $ by wcel_elim [#2, r6]

lemma b8_fseq_cdm (G: hyps) (A Q: class):
  $ G ⇒ Q ∈ fseq A $ > $ G ⇒ cdm Q ⊆ ω $
----
f1: $ G , q = Q , q ∊ fseq A ⇒ q ∊ fseq A $ by ax
f2: $ G , q = Q , q ∊ fseq A ⇒ cdm q ∈ ω $ by fseq_len [f1]
f3: $ G , q = Q , q ∊ fseq A , n = cdm q , n ∊ ω ⇒ n ∊ ω $ by ax
f4: $ G , q = Q , q ∊ fseq A , n = cdm q , n ∊ ω ⇒ n ⊆ ω $ by omega_elem_subset [f3]
f5: $ G , q = Q , q ∊ fseq A , n = cdm q , n ∊ ω ⇒ n = cdm q $ by ax
f6: $ G , q = Q , q ∊ fseq A , n = cdm q , n ∊ ω ⇒ cdm q ⊆ ω $ by subset_eq_l [f5, f4]
f7: $ G , q = Q , q ∊ fseq A ⇒ cdm q ⊆ ω $ by wcel_elim [f2, f6]
f8: $ G , q = Q , q ∊ fseq A ⇒ q = Q $ by ax
f9: $ G , q = Q , q ∊ fseq A ⇒ cdm q = cdm Q $ by cdm_eq [f8]
f10: $ G , q = Q , q ∊ fseq A ⇒ cdm Q ⊆ ω $ by subset_eq_l [f9, f7]
f11: $ G ⇒ cdm Q ⊆ ω $ by wcel_elim [#1, f10]

lemma b8_ofs_u (G: hyps) (K: class) (u: set):
  $ G ⇒ uadm u $ > $ G ⇒ ofsort lsig lopen K ∈ u $
----
v0: $ G ⇒ isset ω $ by omega_set
v1: $ G , w = ω ⇒ w = ω $ by ax
v2: $ G , w = ω ⇒ ω = w $ by eq_sym [v1]
v3: $ G , w = ω ⇒ uadm u $ by weaken [#1]
v3b: $ G , w = ω ⇒ ω ∈ u $ by uadm_omega [v3]
v4: $ G , w = ω ⇒ w ∈ u $ by wcel_eq_l [v2, v3b]
v5: $ G , w = ω ⇒ w ∊ u $ by wcel_welc [v4]
v6: $ G , w = ω ⇒ universe u $ by uadm_universe [v3]
v7: $ G , w = ω ⇒ trees w ∈ u $ by trees_universe [v6, v3b, v5]
v8: $ G , w = ω ⇒ trees w = trees ω $ by trees_eq [v1]
v9: $ G , w = ω ⇒ trees ω ∈ u $ by wcel_eq_l [v8, v7]
v10: $ G ⇒ trees ω ∈ u $ by isset_elim [v0, v9]
v11: $ G ⇒ sig lsig lopen $ by lsig_sig
v12: $ G ⇒ ofsort lsig lopen K ⊆ trees ω $ by ofsort_trees [v11]
v13: $ G ⇒ universe u $ by uadm_universe [#1]
v14: $ G ⇒ ofsort lsig lopen K ∈ u $ by universe_subset_c [v13, v10, v12]

lemma b8_B1_u {x2: set} (G: hyps) (M R W: class) (u: set):
  $ G ⇒ uadm u $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ ⋃ (img (cgr x2 (etel u (dnf u M) x2 W R)) (ofsort lsig lopen ks_expr)) ∈ u $
----
u1: $ G , x2 ∊ ofsort lsig lopen ks_expr ⇒ uadm u $ by weaken [#1]
u2: $ G , x2 ∊ ofsort lsig lopen ks_expr ⇒ x2 ∊ ofsort lsig lopen ks_expr $ by ax
u3: $ G , x2 ∊ ofsort lsig lopen ks_expr ⇒ x2 ∈ ofsort lsig lopen ks_expr $ by welc_wcel [u2]
u4: $ G , x2 ∊ ofsort lsig lopen ks_expr ⇒ W ∈ lvals $ by weaken [#2]
u5: $ G , x2 ∊ ofsort lsig lopen ks_expr ⇒ etel u (dnf u M) x2 W R ∈ u $ by b8_etel_u [u1, u3, u4]
u6: $ G ⇒ x2 ∊ ofsort lsig lopen ks_expr → etel u (dnf u M) x2 W R ∈ u $ by imp_intro [u5]
u7: $ G ⇒ ∀ x2 (x2 ∊ ofsort lsig lopen ks_expr → etel u (dnf u M) x2 W R ∈ u) $ by all_intro [u6]
u8: $ G ⇒ universe u $ by uadm_universe [#1]
u9: $ G ⇒ ofsort lsig lopen ks_expr ∈ u $ by b8_ofs_u [#1]
