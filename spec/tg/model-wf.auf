rr: $ G , v = nest (scat tc Q) ty , v ∊ ient D W (isup Z S) tk , ⟨ tk , ⟨ z , o ⟩ ⟩ ∈ isup Z S ∧ ((iprop D tk W ∧ v = nest z ∅) ∨ (¬ iprop D tk W ∧ v = nest z o)) , w = ⟨ tk , ⟨ z , o ⟩ ⟩ , w ∊ isup Z S , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z , y ∊ S , w = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ scat tc Q = z ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = o)) $ by or_elim [w442_l2, c10, d10]
t1: $ … ⇒ scat tc Q = z $ by and_elim_l [rr]
t2: $ … ⇒ (iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = o) $ by and_elim_r [rr]
t3: $ … ⇒ z = scat tc Q $ by eq_sym [t1]
t4: $ … ⇒ ⟨ z , x ⟩ = ⟨ scat tc Q , x ⟩ $ by opair_eq [t3, rx]
rk: $ G , v = nest (scat tc Q) ty , v ∊ ient D W (isup Z S) tk , ⟨ tk , ⟨ z , o ⟩ ⟩ ∈ isup Z S ∧ ((iprop D tk W ∧ v = nest z ∅) ∨ (¬ iprop D tk W ∧ v = nest z o)) , w = ⟨ tk , ⟨ z , o ⟩ ⟩ , w ∊ isup Z S , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z , y ∊ S , w = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ tk = tk $ by eq_refl
t5: $ … ⇒ ⟨ tk , ⟨ z , x ⟩ ⟩ = ⟨ tk , ⟨ scat tc Q , x ⟩ ⟩ $ by opair_eq [rk, t4]
t6: $ … ⇒ ⟨ tk , ⟨ scat tc Q , x ⟩ ⟩ ∈ Z $ by wcel_eq_l [t5, m14]
t7: $ … ⇒ o ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = o)) $ by and_intro [m15, t2]
t8: $ … ⇒ ⟨ tk , ⟨ scat tc Q , x ⟩ ⟩ ∈ Z ∧ o ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = o)) $ by and_intro [t6, t7]
w443_fi1: $ G , v = nest (scat tc Q) ty , v ∊ ient D W (isup Z S) tk , ⟨ tk , ⟨ z , o ⟩ ⟩ ∈ isup Z S ∧ ((iprop D tk W ∧ v = nest z ∅) ∨ (¬ iprop D tk W ∧ v = nest z o)) , w = ⟨ tk , ⟨ z , o ⟩ ⟩ , w ∊ isup Z S , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z , y ∊ S , w = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ tk ∊ intys D $ by weaken [fi1]
t9: $ … ⇒ tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , x ⟩ ⟩ ∈ Z ∧ o ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = o)) $ by and_intro [w443_fi1, t8]
t10: $ … ⇒ ∃ h (tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , x ⟩ ⟩ ∈ Z ∧ h ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = h))) $ by ex_intro [t9]
t11: $ … ⇒ ∃ e ∃ h (tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , e ⟩ ⟩ ∈ Z ∧ h ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = h))) $ by ex_intro [t10]
w2: $ G , v = nest (scat tc Q) ty , v ∊ ient D W (isup Z S) tk , ⟨ tk , ⟨ z , o ⟩ ⟩ ∈ isup Z S ∧ ((iprop D tk W ∧ v = nest z ∅) ∨ (¬ iprop D tk W ∧ v = nest z o)) , w = ⟨ tk , ⟨ z , o ⟩ ⟩ , w ∊ isup Z S ⇒ ∃ e ∃ h (tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , e ⟩ ⟩ ∈ Z ∧ h ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = h))) $ by isup_elim [ws, t11]
w3: $ G , v = nest (scat tc Q) ty , v ∊ ient D W (isup Z S) tk , ⟨ tk , ⟨ z , o ⟩ ⟩ ∈ isup Z S ∧ ((iprop D tk W ∧ v = nest z ∅) ∨ (¬ iprop D tk W ∧ v = nest z o)) ⇒ ∃ e ∃ h (tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , e ⟩ ⟩ ∈ Z ∧ h ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = h))) $ by wcel_elim [l1, w2]
w4: $ G , v = nest (scat tc Q) ty , v ∊ ient D W (isup Z S) tk , ∃ o (⟨ tk , ⟨ z , o ⟩ ⟩ ∈ isup Z S ∧ ((iprop D tk W ∧ v = nest z ∅) ∨ (¬ iprop D tk W ∧ v = nest z o))) ⇒ ∃ o (⟨ tk , ⟨ z , o ⟩ ⟩ ∈ isup Z S ∧ ((iprop D tk W ∧ v = nest z ∅) ∨ (¬ iprop D tk W ∧ v = nest z o))) $ by ax
w5: $ G , v = nest (scat tc Q) ty , v ∊ ient D W (isup Z S) tk , ∃ o (⟨ tk , ⟨ z , o ⟩ ⟩ ∈ isup Z S ∧ ((iprop D tk W ∧ v = nest z ∅) ∨ (¬ iprop D tk W ∧ v = nest z o))) ⇒ ∃ e ∃ h (tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , e ⟩ ⟩ ∈ Z ∧ h ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = h))) $ by ex_elim [w4, w3]
w6: $ G , v = nest (scat tc Q) ty , v ∊ ient D W (isup Z S) tk ⇒ ∃ e ∃ h (tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , e ⟩ ⟩ ∈ Z ∧ h ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = h))) $ by ex_elim [el, w5]
w7: $ G ⇒ ∃ e ∃ h (tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , e ⟩ ⟩ ∈ Z ∧ h ∊ S ∧ ((iprop D tk W ∧ ty = ∅) ∨ (¬ iprop D tk W ∧ ty = h))) $ by wcel_elim [fi2, w6]

--| The converse: an entry from a point of `Z` and an element of `S`.
lemma b11_hb_out (G: hyps) (M D W Z P T Q S K A0 Y Y0: class) (u p t t3 tk tx: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Z ⊆ itc u (dnf u M) D W $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p t3 ∈ lrel $ > $ G ⇒ S ∈ u $ > $ G ⇒ K = cdm Q $ > $ G ⇒ tk ∊ intys D $ > $ G ⇒ ⟨ tk , ⟨ A0 , tx ⟩ ⟩ ∈ Z $ > $ G ⇒ isset A0 $ > $ G ⇒ Y0 ∈ S $ > $ G ⇒ (iprop D tk W ∧ Y = ∅) ∨ (¬ iprop D tk W ∧ Y = Y0) $ > $ G ⇒ nest A0 Y ∈ fv (scat Q (ixs D W (isup Z S))) (nadd K tk) $
----
uu: $ … ⇒ universe u $ by uadm_universe [#1]
cq0: $ G ⇒ esat u (dnf u M) P W ⊆ fseq u $ by esat_fseq
cq2: $ … ⇒ Q ∈ fseq u $ by wcel_subset [cq0, #8]
k0: $ G ⇒ intys D ⊆ ω $ by intys_sub
k1: $ … ⇒ tk ∊ ω $ by subset_elim [k0, #13]
k3: $ … ⇒ tk ∈ ω $ by welc_wcel [k1]
lk: $ … ⇒ fv (scat Q (ixs D W (isup Z S))) (nadd K tk) = fv (ixs D W (isup Z S)) tk $ by b11_hb_look [#1, #4, #5, #11, cq2, #12, k3]
zs: $ … ⇒ isup Z S ∈ u ∧ isup Z S ⊆ ω × (fseq u × u) $ by b11_hb_zs [uu, #4, #5, #11]
zs1: $ … ⇒ isup Z S ∈ u $ by and_elim_l [zs]
zs2: $ … ⇒ isup Z S ⊆ ω × (fseq u × u) $ by and_elim_r [zs]
i1: $ G ⇒ isset tk $ by isset_var
p1: $ … ⇒ ⟨ tk , ⟨ A0 , Y0 ⟩ ⟩ ∈ isup Z S $ by isup_intro [i1, #15, #14, #16]
iy: $ … ⇒ isset Y0 $ by wcel_isset [#16]
ea: $ G , a = A0 , y = Y0 ⇒ a = A0 $ by ax
ey: $ G , a = A0 , y = Y0 ⇒ y = Y0 $ by ax
ae: $ … ⇒ A0 = a $ by eq_sym [ea]
ye: $ … ⇒ Y0 = y $ by eq_sym [ey]
p2a: $ … ⇒ ⟨ A0 , Y0 ⟩ = ⟨ a , y ⟩ $ by opair_eq [ae, ye]
rk: $ G , a = A0 , y = Y0 ⇒ tk = tk $ by eq_refl
p2b: $ … ⇒ ⟨ tk , ⟨ A0 , Y0 ⟩ ⟩ = ⟨ tk , ⟨ a , y ⟩ ⟩ $ by opair_eq [rk, p2a]
w444_p1: $ G , a = A0 , y = Y0 ⇒ ⟨ tk , ⟨ A0 , Y0 ⟩ ⟩ ∈ isup Z S $ by weaken [p1]
p2: $ … ⇒ ⟨ tk , ⟨ a , y ⟩ ⟩ ∈ isup Z S $ by wcel_eq_l [p2b, w444_p1]
c0: $ G , a = A0 , y = Y0 , iprop D tk W ∧ Y = ∅ ⇒ iprop D tk W ∧ Y = ∅ $ by ax
c1: $ … ⇒ iprop D tk W $ by and_elim_l [c0]
c2: $ … ⇒ Y = ∅ $ by and_elim_r [c0]
w445_p2: $ G , a = A0 , y = Y0 , iprop D tk W ∧ Y = ∅ ⇒ ⟨ tk , ⟨ a , y ⟩ ⟩ ∈ isup Z S $ by weaken [p2]
c3: $ … ⇒ nest a ∅ ∈ ient D W (isup Z S) tk $ by ient_intro_prop [w445_p2, c1]
c4: $ … ⇒ ∅ = Y $ by eq_sym [c2]
w446_ea: $ G , a = A0 , y = Y0 , iprop D tk W ∧ Y = ∅ ⇒ a = A0 $ by weaken [ea]
c5: $ … ⇒ nest a ∅ = nest A0 Y $ by nest_eq [w446_ea, c4]
c6: $ … ⇒ nest A0 Y ∈ ient D W (isup Z S) tk $ by wcel_eq_l [c5, c3]
d0: $ G , a = A0 , y = Y0 , ¬ iprop D tk W ∧ Y = Y0 ⇒ ¬ iprop D tk W ∧ Y = Y0 $ by ax
d1: $ … ⇒ ¬ iprop D tk W $ by and_elim_l [d0]
d2: $ … ⇒ Y = Y0 $ by and_elim_r [d0]
w447_p2: $ G , a = A0 , y = Y0 , ¬ iprop D tk W ∧ Y = Y0 ⇒ ⟨ tk , ⟨ a , y ⟩ ⟩ ∈ isup Z S $ by weaken [p2]
d3: $ … ⇒ nest a y ∈ ient D W (isup Z S) tk $ by ient_intro [w447_p2, d1]
d4: $ … ⇒ Y0 = Y $ by eq_sym [d2]
w448_ey: $ G , a = A0 , y = Y0 , ¬ iprop D tk W ∧ Y = Y0 ⇒ y = Y0 $ by weaken [ey]
d4b: $ … ⇒ y = Y $ by eq_trans [w448_ey, d4]
w449_ea: $ G , a = A0 , y = Y0 , ¬ iprop D tk W ∧ Y = Y0 ⇒ a = A0 $ by weaken [ea]
d5: $ … ⇒ nest a y = nest A0 Y $ by nest_eq [w449_ea, d4b]
d6: $ … ⇒ nest A0 Y ∈ ient D W (isup Z S) tk $ by wcel_eq_l [d5, d3]
w450_h17: $ G , a = A0 , y = Y0 ⇒ (iprop D tk W ∧ Y = ∅) ∨ (¬ iprop D tk W ∧ Y = Y0) $ by weaken [#17]
e1: $ G , a = A0 , y = Y0 ⇒ nest A0 Y ∈ ient D W (isup Z S) tk $ by or_elim [w450_h17, c6, d6]
w451_iy: $ G , a = A0 ⇒ isset Y0 $ by weaken [iy]
e2: $ G , a = A0 ⇒ nest A0 Y ∈ ient D W (isup Z S) tk $ by isset_elim [w451_iy, e1]
e3: $ G ⇒ nest A0 Y ∈ ient D W (isup Z S) tk $ by isset_elim [#15, e2]
ns: $ G ⇒ isset (nest A0 Y) $ by nest_set
eo: $ G , o = nest A0 Y ⇒ o = nest A0 Y $ by ax
oe: $ … ⇒ nest A0 Y = o $ by eq_sym [eo]
w452_e3: $ G , o = nest A0 Y ⇒ nest A0 Y ∈ ient D W (isup Z S) tk $ by weaken [e3]
f1: $ … ⇒ o ∈ ient D W (isup Z S) tk $ by wcel_eq_l [oe, w452_e3]
w453_uu: $ G , o = nest A0 Y ⇒ universe u $ by weaken [uu]
w454_zs1: $ G , o = nest A0 Y ⇒ isup Z S ∈ u $ by weaken [zs1]
w455_zs2: $ G , o = nest A0 Y ⇒ isup Z S ⊆ ω × (fseq u × u) $ by weaken [zs2]
w456_h13: $ G , o = nest A0 Y ⇒ tk ∊ intys D $ by weaken [#13]
f2: $ … ⇒ o ∊ fv (ixs D W (isup Z S)) tk $ by b11_hb_fvout [w453_uu, w454_zs1, w455_zs2, w456_h13, f1]
f3: $ … ⇒ o ∈ fv (ixs D W (isup Z S)) tk $ by welc_wcel [f2]
f4: $ … ⇒ nest A0 Y ∈ fv (ixs D W (isup Z S)) tk $ by wcel_eq_l [eo, f3]
w457_lk: $ G , o = nest A0 Y ⇒ fv (scat Q (ixs D W (isup Z S))) (nadd K tk) = fv (ixs D W (isup Z S)) tk $ by weaken [lk]
f5: $ … ⇒ fv (ixs D W (isup Z S)) tk = fv (scat Q (ixs D W (isup Z S))) (nadd K tk) $ by eq_sym [w457_lk]
f6: $ … ⇒ nest A0 Y ∈ fv (scat Q (ixs D W (isup Z S))) (nadd K tk) $ by wcel_eq_r [f5, f4]
f7: $ G ⇒ nest A0 Y ∈ fv (scat Q (ixs D W (isup Z S))) (nadd K tk) $ by isset_elim [ns, f6]

--| The shape world's class at a point of `Z` is a singleton.
lemma b11_hb_shp (G: hyps) (M D W Z P T Q K O: class) (u p t t3 tj tm tk tc tx: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Z ⊆ itc u (dnf u M) D W $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p t3 ∈ lrel $ > $ G ⇒ K = cdm Q $ > $ G ⇒ ra_nidx D tj tm ∈ lrel $ > $ G ⇒ tk = fv nvf tj $ > $ G ⇒ tc ∊ fseq b7_V $ > $ G ⇒ cdm tc = fv nvf tm $ > $ G ⇒ tk ∊ intys D $ > $ G ⇒ ⟨ tk , ⟨ scat tc Q , tx ⟩ ⟩ ∈ Z $ > $ G ⇒ (iprop D tk W ∧ O = ∅) ∨ (¬ iprop D tk W ∧ O = scons ∅ ∅) $ > $ G ⇒ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) = csn O $
----
uu: $ … ⇒ universe u $ by uadm_universe [#1]
em0: $ … ⇒ ∅ ∈ u $ by uadm_empty [#1]
sc: $ … ⇒ scons ∅ ∅ ∈ u $ by b3_scons_u [uu, em0, em0]
su: $ … ⇒ csn (scons ∅ ∅) ∈ u $ by universe_cpr_c [uu, sc, sc]
cq0: $ G ⇒ esat u (dnf u M) P W ⊆ fseq u $ by esat_fseq
cq2: $ … ⇒ Q ∈ fseq u $ by wcel_subset [cq0, #8]
s1: $ … ⇒ tc ∈ fseq b7_V $ by welc_wcel [#14]
s2: $ … ⇒ Q ∈ fseq b7_V $ by b7_fseqV [cq2]
s3: $ … ⇒ scat tc Q ∈ fseq b7_V $ by scat_fseq_c [s1, s2]
isc: $ … ⇒ isset (scat tc Q) $ by wcel_isset [s3]
is0: $ … ⇒ isset (scons ∅ ∅) $ by wcel_isset [sc]
sc0: $ … ⇒ scons ∅ ∅ ∈ csn (scons ∅ ∅) $ by csn_intro_var_c [is0]
f1: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) $ by ax
f2: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ nest (scat tc Q) w ∈ fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk) $ by cab_elim [f1]
w458_h1: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ uadm u $ by weaken [#1]
w459_h2: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ D ∈ ofsort lsig lopen ks_ind $ by weaken [#2]
w460_h3: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ W ∈ lvals $ by weaken [#3]
w461_h4: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ Z ∈ u $ by weaken [#4]
w462_h5: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by weaken [#5]
w463_h6: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ Z ⊆ itc u (dnf u M) D W $ by weaken [#6]
w464_h7: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ iprt D P T $ by weaken [#7]
w465_h8: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ Q ∈ esat u (dnf u M) P W $ by weaken [#8]
w466_h9: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ iprt D p t $ by weaken [#9]
w467_h10: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ ra_clen p t3 ∈ lrel $ by weaken [#10]
w468_su: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ csn (scons ∅ ∅) ∈ u $ by weaken [su]
w469_h11: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ K = cdm Q $ by weaken [#11]
w470_h12: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ ra_nidx D tj tm ∈ lrel $ by weaken [#12]
w471_h13: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ tk = fv nvf tj $ by weaken [#13]
w472_h14: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ tc ∊ fseq b7_V $ by weaken [#14]
w473_h15: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ cdm tc = fv nvf tm $ by weaken [#15]
en: $ G , w ∊ apn (fv (scat Q (ixs D W (isup Z (csn (scons ∅ ∅))))) (nadd K tk)) (scat tc Q) ⇒ ∃ e ∃ h (tk ∊ intys D ∧ ⟨ tk , ⟨ scat tc Q , e ⟩ ⟩ ∈ Z ∧ h ∊ csn (scons ∅ ∅) ∧ ((iprop D tk W ∧ w = ∅) ∨ (¬ iprop D tk W ∧ w = h))) $ by b11_hb_ent [w458_h1, w459_h2, w460_h3, w461_h4, w462_h5, w463_h6, w464_h7, w465_h8, w466_h9, w467_h10, w468_su, w469_h11, w470_h12, w471_h13, w472_h14, w473_h15, f2]
