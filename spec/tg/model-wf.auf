q285: $ G , ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) ⇒ ∃ o (ra_isort t5 o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) z w r))) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V $ by ex_elim [q284, q283]
q286: $ G , ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) ⇒ ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) $ by ax
q287: $ G , ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) ⇒ ∃ o (ra_isort t5 o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) z w r))) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V $ by ex_elim [q286, q285]
q288: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) ⇒ ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) $ by ax
q289: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) ⇒ ∃ o (ra_isort t5 o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) z w r))) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V $ by ex_elim [q288, q287]
q290: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) $ by ax
q291: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 (c = x1 ∧ h = x2 ∧ A = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ t5 = x8 ∧ ra_sty x1 x2 x3 x4 ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x1 x5 x5 x6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x7 x5 x8 ∈ lrel) ⇒ ∃ o (ra_isort t5 o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) z w r))) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V $ by ex_elim [q290, q289]
q292: $ G ⇒ ∃ o (ra_isort t5 o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) z w r))) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V $ by or_elim [q1, q64, q291]

lemma b6_sty_is (G: hyps) {o: set} (J M K S0: class) (u w r c h A N l e t5: set): $ G ⇒ ra_sty c h A e t5 ∈ lrel3 J $ > $ G ⇒ h = ⟨ K , S0 ⟩ $ > $ G ⇒ ⟨ K , S0 ⟩ ∈ trees ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ra_isort A N l ∈ lrel $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ ∃ o (ra_isort t5 o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) e w r))) ∧ etel u (dnf u M) e w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) e w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) e w r ∈ fseq b6_V $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ crn j ⊆ b6_csy J M u w r c h A N l $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ ra_sty c h A z t ∈ lrel3 J $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ h = ⟨ K , S0 ⟩ $ by weaken [#2]
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ ⟨ K , S0 ⟩ ∈ trees ω $ by weaken [#3]
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ ¬ K = kc_pi $ by weaken [#4]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ ¬ K = kc_app $ by weaken [#5]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ w ∊ lvals $ by weaken [#6]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ r ∊ fseq u $ by weaken [#7]
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ ra_isort A N l ∈ lrel $ by weaken [#8]
q14: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ , ra_sty c h A z t ∈ lrel3 J ⇒ ∃ o (ra_isort t o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) z w r))) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V $ by b6_sy_st [q4, q3, q5, q7, q8, q9, q10, q11, q12, q13, q6]
q15: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ ⇒ ra_sty c h A z t ∈ lrel3 J → ∃ o (ra_isort t o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) z w r))) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V $ by imp_intro [q14]
q16: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ ⇒ ∀ t (ra_sty c h A z t ∈ lrel3 J → ∃ o (ra_isort t o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) z w r))) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V) $ by all_intro [q15]
q17: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ ⇒ z ∊ b6_csy J M u w r c h A N l $ by cab_intro [q16]
q18: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
q19: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b6_csy J M u w r c h A N l $ by wcel_intro [q18, q17]
q20: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l ⇒ isset ⟨ k , j ⟩ $ by opair_isset
q21: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_csy J M u w r c h A N l ⇒ ⟨ k , j ⟩ ∈ b6_csy J M u w r c h A N l $ by isset_elim [q20, q19]
q22: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b6_csy J M u w r c h A N l → ⟨ k , j ⟩ ∈ b6_csy J M u w r c h A N l $ by imp_intro [q21]
q23: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b6_csy J M u w r c h A N l → ⟨ k , j ⟩ ∈ b6_csy J M u w r c h A N l $ by imp_intro [q22]
q24: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_csy J M u w r c h A N l → ⟨ k , j ⟩ ∈ b6_csy J M u w r c h A N l $ by imp_intro [q23]
q25: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_csy J M u w r c h A N l → ⟨ k , j ⟩ ∈ b6_csy J M u w r c h A N l) $ by all_intro [q24]
q26: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_csy J M u w r c h A N l → ⟨ k , j ⟩ ∈ b6_csy J M u w r c h A N l) $ by all_intro [q25]
q27: $ G ⇒ isset ω $ by omega_set
q28: $ G ⇒ trees ω ⊆ b6_csy J M u w r c h A N l $ by trees_ind_c [q27, q26]
q29: $ G ⇒ e ∊ b6_csy J M u w r c h A N l $ by subset_elim [q28, #9]
q30: $ G ⇒ ∀ t (ra_sty c h A e t ∈ lrel3 J → ∃ o (ra_isort t o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) e w r))) ∧ etel u (dnf u M) e w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) e w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) e w r ∈ fseq b6_V) $ by cab_elim [q29]
q31: $ G ⇒ ra_sty c h A e t5 ∈ lrel3 J → ∃ o (ra_isort t5 o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) e w r))) ∧ etel u (dnf u M) e w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) e w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) e w r ∈ fseq b6_V $ by all_elim [q30]
q32: $ G ⇒ ∃ o (ra_isort t5 o l ∈ lrel ∧ fv nvf N = nadd (fv nvf o) (cdm (sarg u (dnf u M) e w r))) ∧ etel u (dnf u M) e w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) e w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) e w r ∈ fseq b6_V $ by imp_elim [q31, #1]

lemma b6s_exi {x: set} (G: hyps) (p: fml x) (c: fml): $ G ⇒ ∀ x (p → c) $ > $ G ⇒ (∃ x p) → c $
----
l1: $ G , ∃ x p ⇒ ∃ x p $ by ax
l2: $ G , p ⇒ ∀ x (p → c) $ by weaken [#1]
l3: $ G , p ⇒ p → c $ by all_elim [l2]
l4: $ G , p ⇒ p $ by ax
l5: $ G , p ⇒ c $ by imp_elim [l3, l4]
l6: $ G , ∃ x p ⇒ c $ by ex_elim [l1, l5]
l7: $ G ⇒ (∃ x p) → c $ by imp_intro [l6]

lemma b6s_or2 (G: hyps) (p q c: fml): $ G ⇒ p ∨ q $ > $ G ⇒ p → c $ > $ G ⇒ q → c $ > $ G ⇒ c $
----
l1: $ G , p ⇒ c $ by imp_use [#2]
l2: $ G , q ⇒ c $ by imp_use [#3]
l3: $ G ⇒ c $ by or_elim [#1, l1, l2]

def b6s_sih (U M D W V J: class) (.i .b: set): fml = $ ∀ i ∀ b (i ∊ cdm V → b ∊ trees ω → fv nvf b = nadd (fv nvf J) i → dt U M ⟨ kc_ind_ty , scons D (scons b ∅) ⟩ W ∅ = fv V i) $

--| The property of the induction for `lrel_sinst_sem` (over the valuation `v`).
def b6s_sip (U M D N K W P S: class) (.v .j .e .f .i .b: set): class = $ {v | ∀ j ∀ e ∀ f (ra_sinst D j N K e f ∈ lrel → j ∊ trees ω → nadd (fv nvf j) (cdm v) = fv nvf N → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt U M ⟨ kc_ind_ty , scons D (scons b ∅) ⟩ W ∅ = fv v i) → etel U (dnf U M) f W (scat P S) = etel U (dnf U M) e W (scat P (scat v S)))} $

lemma b6s_id (G: hyps) (p: fml): $ G ⇒ p $ > $ G ⇒ p $
----
l1: $ G , p ⇒ p $ by ax
l2: $ G ⇒ p → p $ by imp_intro [l1]
l3: $ G ⇒ p $ by imp_elim [l2, #1]

lemma b6s_sih_use (G: hyps) (M: class) (u w t1 v j i b: set): $ G ⇒ b6s_sih u M t1 w v j $ > $ G ⇒ i ∊ cdm v $ > $ G ⇒ b ∊ trees ω $ > $ G ⇒ fv nvf b = nadd (fv nvf j) i $ > $ G ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $
----
l1: $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ cdm v → x1 ∊ trees ω → fv nvf x1 = nadd (fv nvf j) x0 → dt u M ⟨ kc_ind_ty , scons t1 (scons x1 ∅) ⟩ w ∅ = fv v x0) $ by b6s_id [#1]
l2: $ G ⇒ ∀ x1 (i ∊ cdm v → x1 ∊ trees ω → fv nvf x1 = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons x1 ∅) ⟩ w ∅ = fv v i) $ by all_elim [l1]
l3: $ G ⇒ i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by all_elim [l2]
l4: $ G ⇒ b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_elim [l3, #2]
l5: $ G ⇒ fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_elim [l4, #3]
l6: $ G ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_elim [l5, #4]

lemma b6s_sih_intro {i b: set} (G: hyps) (M: class) (u w t1 v j: set): $ G , i ∊ cdm v , b ∊ trees ω , fv nvf b = nadd (fv nvf j) i ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ > $ G ⇒ b6s_sih u M t1 w v j $
----
l1: $ G , i ∊ cdm v , b ∊ trees ω ⇒ fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_intro [#1]
l2: $ G , i ∊ cdm v ⇒ b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_intro [l1]
l3: $ G ⇒ i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_intro [l2]
l4: $ G ⇒ ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) $ by all_intro [l3]
l5: $ G ⇒ ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) $ by all_intro [l4]
l6: $ G ⇒ b6s_sih u M t1 w v j $ by b6s_id [l5]

lemma b6s_sih_zero (G: hyps) (M: class) (u w t1 v j: set): $ G ⇒ b6s_sih u M t1 w v j $ > $ G ⇒ ∅ ∈ cdm v $ > $ G ⇒ j ∊ trees ω $ > $ G ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons j ∅) ⟩ w ∅ = fv v ∅ $
----
l1: $ G , n = ∅ ⇒ n = ∅ $ by ax
l2: $ G , n = ∅ ⇒ ∅ = n $ by eq_sym [l1]
l2a: $ G , n = ∅ ⇒ ∅ ∈ cdm v $ by weaken [#2]
l3: $ G , n = ∅ ⇒ n ∈ cdm v $ by wcel_eq_l [l2, l2a]
l4: $ G , n = ∅ ⇒ n ∊ cdm v $ by wcel_welc [l3]
l5a: $ G , n = ∅ ⇒ isset j $ by isset_var
l5b: $ G , n = ∅ ⇒ fv nvf j ∈ ω $ by nvf_omega [l5a]
l5: $ G , n = ∅ ⇒ isset (fv nvf j) $ by wcel_isset [l5b]
l6: $ G , n = ∅ ⇒ nadd (fv nvf j) ∅ = fv nvf j $ by nadd_zero_c [l5]
l7a: $ G , n = ∅ ⇒ fv nvf j = fv nvf j $ by eq_refl
l7: $ G , n = ∅ ⇒ nadd (fv nvf j) n = nadd (fv nvf j) ∅ $ by nadd_eq [l7a, l1]
l8: $ G , n = ∅ ⇒ nadd (fv nvf j) n = fv nvf j $ by eq_trans [l7, l6]
l9: $ G , n = ∅ ⇒ fv nvf j = nadd (fv nvf j) n $ by eq_sym [l8]
l10a: $ G , n = ∅ ⇒ b6s_sih u M t1 w v j $ by weaken [#1]
l10b: $ G , n = ∅ ⇒ j ∊ trees ω $ by weaken [#3]
l10: $ G , n = ∅ ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons j ∅) ⟩ w ∅ = fv v n $ by b6s_sih_use [l10a, l4, l10b, l9]
l11a: $ G , n = ∅ ⇒ v = v $ by eq_refl
l11: $ G , n = ∅ ⇒ fv v n = fv v ∅ $ by fv_eq [l11a, l1]
l12: $ G , n = ∅ ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons j ∅) ⟩ w ∅ = fv v ∅ $ by eq_trans [l10, l11]
l13: $ G ⇒ isset ∅ $ by ax_empty
l14: $ G ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons j ∅) ⟩ w ∅ = fv v ∅ $ by isset_elim [l13, l12]

lemma b6s_si_b1 (G: hyps) (M: class) (u w t1 t3 t4 p s z j e f x0 x1 x2 x3: set): $ G ⇒ z = ∅ $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ (t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3) → etel u (dnf u M) f w (scat p s) = etel u (dnf u M) e w (scat p (scat z s)) $
----
a0: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 $ by ax
p0: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t1 = x0 $ by and_elim_l [a0]
p0r: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 $ by and_elim_r [a0]
p1: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ j = x1 $ by and_elim_l [p0r]
p1r: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 $ by and_elim_r [p0r]
p2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t3 = x1 $ by and_elim_l [p1r]
p2r: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t4 = x2 ∧ e = x3 ∧ f = x3 $ by and_elim_r [p1r]
p3: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t4 = x2 $ by and_elim_l [p2r]
p3r: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ e = x3 ∧ f = x3 $ by and_elim_r [p2r]
p4: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ e = x3 $ by and_elim_l [p3r]
p5: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ f = x3 $ by and_elim_r [p3r]
b2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ x3 = e $ by eq_sym [p4]
b3: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ f = e $ by eq_trans [p5, b2]
c1: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ z = ∅ $ by weaken [#1]
c2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ s = s $ by eq_refl
c3: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat z s = scat ∅ s $ by scat_eq [c1, c2]
c4: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ s ∊ fseq u $ by weaken [#2]
c5: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat ∅ s = s $ by scat_empty_l [c4]
c6: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat z s = s $ by eq_trans [c3, c5]
c7: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ p = p $ by eq_refl
c8: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat p (scat z s) = scat p s $ by scat_eq [c7, c6]
c9: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat p s = scat p (scat z s) $ by eq_sym [c8]
d1: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ u = u $ by eq_refl
d2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ M = M $ by eq_refl
d3: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ w = w $ by eq_refl
d4: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ etel u (dnf u M) f w (scat p s) = etel u (dnf u M) e w (scat p (scat z s)) $ by etel_eq [b3, d3, c9]
d5: $ G ⇒ (t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3) → etel u (dnf u M) f w (scat p s) = etel u (dnf u M) e w (scat p (scat z s)) $ by imp_intro [d4]

lemma b6s_si_b2 (G: hyps) (M: class) (u w t1 t3 t4 p s z j e f x0 x1 x2 x3 x4 x5 x6: set): $ G ⇒ z = ∅ $ > $ G ⇒ j ∊ trees ω $ > $ G ⇒ nadd (fv nvf j) (cdm z) = fv nvf t3 $ > $ G ⇒ (t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel) → etel u (dnf u M) f w (scat p s) = etel u (dnf u M) e w (scat p (scat z s)) $
