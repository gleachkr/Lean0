lemma b12_prt (G: hyps) (D P T: class) (q0 e0: set): $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ iprt D P T $ > $ G ⇒ iprt D q0 e0 $ > $ G ⇒ q0 = P $
----
l1: $ G ⇒ P ∈ ofsort lsig lopen ks_ctx ∧ T ∈ ofsort lsig lopen ks_tys $ by iprt_sort [#1, #2]
l2: $ G ⇒ P ∈ ofsort lsig lopen ks_ctx $ by and_elim_l [l1]
l3: $ G ⇒ T ∈ ofsort lsig lopen ks_tys $ by and_elim_r [l1]
m1: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ D = D $ by eq_refl
m2: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ x = P $ by ax
m3: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ P = x $ by eq_sym [m2]
m4: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ y = T $ by ax
m5: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ T = y $ by eq_sym [m4]
m6: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ iprt D P T $ by weaken [#2]
m7: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ iprt D x y $ by iprt_eq [m1, m3, m5, m6]
m8: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ iprt D q0 e0 $ by weaken [#3]
m9: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ q0 = x ∧ e0 = y $ by iprt_det [m8, m7]
m10: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ q0 = x $ by and_elim_l [m9]
m11: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx , y = T , y ∊ ofsort lsig lopen ks_tys ⇒ q0 = P $ by eq_trans [m10, m2]
m12: $ G , x = P , x ∊ ofsort lsig lopen ks_ctx ⇒ q0 = P $ by wcel_elim [l3, m11]
m13: $ G ⇒ q0 = P $ by wcel_elim [l2, m12]

lemma b12_mem (G: hyps) (H J C D W R P T Q S: class) (u i0 m0 y0: set): $ G ⇒ iwf u H J C D W R $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u (mcv H)) P W $ > $ G ⇒ m0 ∊ fseq (crn m0) $ > $ G ⇒ ⟨ i0 , ⟨ scat m0 Q , y0 ⟩ ⟩ ∈ iop0 u (dnf u (mcv H)) D W (isup (ijs u (dnf u (mcv H)) D W) S) $ > $ G ⇒ y0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) S)))))) $
----
