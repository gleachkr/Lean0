p16: $ G , f = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ k = ⟨ kc_s , scons x7 ∅ ⟩ ∧ l = x4 ∧ ra_isort x6 x7 x4 ∈ lrel , x8 ∊ fseq u ⇒ suc (fv nvf x7) = fv nvf k → x6 ∊ ofsort lsig lopen ks_expr → ∀ c (c ∊ fseq u → ∀ e (e ∈ dt u M x6 w c ↔ (e ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) x6 w c) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) x6 w c) → apn e x ∈ fv uni (lv l w))))) $ by imp_elim [p15, p7]
