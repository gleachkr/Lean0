i8: $ G ⇒ x6 ∊ dt u M B w x7 → dt u M B w x8 = csn (⋃ (dt u M B w x8)) ∧ ∀ b ∀ v (b ∊ fseq u → b9_ag x7 b (nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3)) → b9_hb t1 X0 x7 b (nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w x7 → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M B w x8) → apn x6 c ∈ X → apn x6 c ∈ v) → x6 ∈ dt u M B w b) $ by imp_elim [i7, n5]
i9: $ G ⇒ dt u M B w x8 = csn (⋃ (dt u M B w x8)) ∧ ∀ b ∀ v (b ∊ fseq u → b9_ag x7 b (nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3)) → b9_hb t1 X0 x7 b (nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w x7 → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M B w x8) → apn x6 c ∈ X → apn x6 c ∈ v) → x6 ∈ dt u M B w b) $ by imp_elim [i8, #11]

--| The fibers of the fields `G` at the points where the shape fields `S` have the
--| point `⟨ ∅ , ∅ ⟩`, if in `X`, are in `V`.
def b11_cnd (S G X V: class) (.d .c: set): fml = $ ∀ d ∀ c (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv S d → apn (fv G d) c ∈ X → apn (fv G d) c ∈ V) $

--| @congr
lemma b11_cnd_congr (A B C D E F H I: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ b11_cnd A C E H ⟺ b11_cnd B D F I $
----
c1: $ (d ∊ ω) ⟺ (d ∊ ω) $ by iff_refl
c2: $ (c ∊ fseq b7_V) ⟺ (c ∊ fseq b7_V) $ by iff_refl
c3a: $ d ≐ d $ by ceqt_refl
c3b: $ c ≐ c $ by ceqt_refl
c3c: $ nest c ⟨ ∅ , ∅ ⟩ ≐ nest c ⟨ ∅ , ∅ ⟩ $ by ceqt_refl
c3d: $ fv A d ≐ fv B d $ by fv_congr [#1, c3a]
c3: $ (nest c ⟨ ∅ , ∅ ⟩ ∈ fv A d) ⟺ (nest c ⟨ ∅ , ∅ ⟩ ∈ fv B d) $ by wcel_congr [c3c, c3d]
c4a: $ fv C d ≐ fv D d $ by fv_congr [#2, c3a]
c4b: $ apn (fv C d) c ≐ apn (fv D d) c $ by apn_congr [c4a, c3b]
c4: $ (apn (fv C d) c ∈ E) ⟺ (apn (fv D d) c ∈ F) $ by wcel_congr [c4b, #3]
c5: $ (apn (fv C d) c ∈ H) ⟺ (apn (fv D d) c ∈ I) $ by wcel_congr [c4b, #4]
c6: $ (apn (fv C d) c ∈ E → apn (fv C d) c ∈ H) ⟺ (apn (fv D d) c ∈ F → apn (fv D d) c ∈ I) $ by im_congr [c4, c5]
c7: $ (nest c ⟨ ∅ , ∅ ⟩ ∈ fv A d → apn (fv C d) c ∈ E → apn (fv C d) c ∈ H) ⟺ (nest c ⟨ ∅ , ∅ ⟩ ∈ fv B d → apn (fv D d) c ∈ F → apn (fv D d) c ∈ I) $ by im_congr [c3, c6]
c8: $ (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv A d → apn (fv C d) c ∈ E → apn (fv C d) c ∈ H) ⟺ (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv B d → apn (fv D d) c ∈ F → apn (fv D d) c ∈ I) $ by im_congr [c2, c7]
c9: $ (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv A d → apn (fv C d) c ∈ E → apn (fv C d) c ∈ H) ⟺ (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv B d → apn (fv D d) c ∈ F → apn (fv D d) c ∈ I) $ by im_congr [c1, c8]
c10: $ (∀ c (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv A d → apn (fv C d) c ∈ E → apn (fv C d) c ∈ H)) ⟺ (∀ c (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv B d → apn (fv D d) c ∈ F → apn (fv D d) c ∈ I)) $ by all_congr [c9]
c11: $ (∀ d ∀ c (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv A d → apn (fv C d) c ∈ E → apn (fv C d) c ∈ H)) ⟺ (∀ d ∀ c (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv B d → apn (fv D d) c ∈ F → apn (fv D d) c ∈ I)) $ by all_congr [c10]

--| @rewrite
lemma b11_sb_cnd {z: set} (t: set z) (A B C D: class z): $ [z/t] (b11_cnd A B C D) ⟺ b11_cnd (⟦ z / t ⟧ A) (⟦ z / t ⟧ B) (⟦ z / t ⟧ C) (⟦ z / t ⟧ D) $
----
l1: $ [z/t] (∀ d ∀ c (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv A d → apn (fv B d) c ∈ C → apn (fv B d) c ∈ D)) ⟺ ∀ d ∀ c (d ∊ ω → c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ fv (⟦ z / t ⟧ A) d → apn (fv (⟦ z / t ⟧ B) d) c ∈ (⟦ z / t ⟧ C) → apn (fv (⟦ z / t ⟧ B) d) c ∈ (⟦ z / t ⟧ D)) $ by iff_refl

lemma b11_np_pisg {a s h b v c g t e q p f l n x2 x3 x4 x5: set} (G: hyps) (M X0 X: class) (u w t1 t2 t3 d k z A B: set): $ G ⇒ ra_add d t3 k ∈ lrel $ > $ G ⇒ ra_closed k A ∈ lrel $ > $ G ⇒ ra_ipos t1 t2 t3 ⟨ kc_s , scons d ∅ ⟩ B ∈ lrel $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ A ∊ trees ω $ > $ G ⇒ B ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ z = ⟨ kc_pi , scons A (scons B ∅) ⟩ $ > $ G ⇒ ∀ a ∀ s ∀ h (a ∊ fseq u → s ∊ fseq u → b9_ag a s (nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3)) → b9_hs t1 X0 a s (nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3)) X → swin a (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3) = X0 → h ∊ dt u M B w a → dt u M B w s = csn (⋃ (dt u M B w s)) ∧ ∀ b ∀ v (b ∊ fseq u → b9_ag a b (nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3)) → b9_hb t1 X0 a b (nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3)) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w a → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M B w s) → apn h c ∈ X → apn h c ∈ v) → h ∈ dt u M B w b)) $ > $ G ⇒ ∀ q ∀ p ∀ f (q ∊ fseq u → p ∊ fseq u → b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X → swin q (fv nvf d) (fv nvf t3) = X0 → f ∊ dt u M z w q → dt u M z w p = csn (⋃ (dt u M z w p)) ∧ ∀ l ∀ n (l ∊ fseq u → b9_ag q l (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 q l (nadd (fv nvf d) (fv nvf t3)) n → ∅ ∈ n → ∀ x2 ∀ x3 ∀ x4 ∀ x5 (⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z w q → nest x2 ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M z w p) → apn f x2 ∈ X → apn f x2 ∈ n) → f ∈ dt u M z w l)) $
----
c0: $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M A w x0 = dt u M A w x1) $ by b9_nc_cl [#1, #2, #7]
c1: $ … ⇒ A ∈ trees ω $ by welc_wcel [#5]
c2: $ … ⇒ B ∈ trees ω $ by welc_wcel [#6]
c3: $ G ⇒ isset ⟨ kc_s , scons d ∅ ⟩ $ by opair_isset
h0: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ q ∊ fseq u $ by ax
h1: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ p ∊ fseq u $ by ax
h2: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ b9_ag q p (nadd (fv nvf d) (fv nvf t3)) $ by ax
h3: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X $ by ax
h4: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ swin q (fv nvf d) (fv nvf t3) = X0 $ by ax
h5: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ f ∊ dt u M z w q $ by ax
w1_c1: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ A ∈ trees ω $ by weaken [c1]
w2_c2: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ B ∈ trees ω $ by weaken [c2]
w3_h7: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ w ∊ lvals $ by weaken [#7]
q1a: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ dt u M ⟨ kc_pi , scons A (scons B ∅) ⟩ w q = cpi y (dt u M A w q) (dt u M B w (scons y q)) $ by dt_pi [w1_c1, w2_c2, w3_h7, h0]
w4_h8: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ z = ⟨ kc_pi , scons A (scons B ∅) ⟩ $ by weaken [#8]
q1b: $ … ⇒ dt u M z w q = dt u M ⟨ kc_pi , scons A (scons B ∅) ⟩ w q $ by b9_dtz [w4_h8]
q1: $ … ⇒ dt u M z w q = cpi y (dt u M A w q) (dt u M B w (scons y q)) $ by eq_trans [q1b, q1a]
q2a: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ dt u M ⟨ kc_pi , scons A (scons B ∅) ⟩ w p = cpi y (dt u M A w p) (dt u M B w (scons y p)) $ by dt_pi [w1_c1, w2_c2, w3_h7, h1]
q2b: $ … ⇒ dt u M z w p = dt u M ⟨ kc_pi , scons A (scons B ∅) ⟩ w p $ by b9_dtz [w4_h8]
q2: $ … ⇒ dt u M z w p = cpi y (dt u M A w p) (dt u M B w (scons y p)) $ by eq_trans [q2b, q2a]
w5_c0: $ G , q ∊ fseq u , p ∊ fseq u , b9_ag q p (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X , swin q (fv nvf d) (fv nvf t3) = X0 , f ∊ dt u M z w q ⇒ ∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M A w x0 = dt u M A w x1) $ by weaken [c0]
q3a: $ … ⇒ ∀ x1 (q ∊ fseq u → x1 ∊ fseq u → b9_ag q x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M A w q = dt u M A w x1) $ by all_elim [w5_c0]
q3b: $ … ⇒ q ∊ fseq u → p ∊ fseq u → b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → dt u M A w q = dt u M A w p $ by all_elim [q3a]
q3c: $ … ⇒ p ∊ fseq u → b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → dt u M A w q = dt u M A w p $ by imp_elim [q3b, h0]
q3d: $ … ⇒ b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → dt u M A w q = dt u M A w p $ by imp_elim [q3c, h1]
q3: $ … ⇒ dt u M A w q = dt u M A w p $ by imp_elim [q3d, h2]
q3s: $ … ⇒ dt u M A w p = dt u M A w q $ by eq_sym [q3]
