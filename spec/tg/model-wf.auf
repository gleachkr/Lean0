q11: $ H , ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ a ∊ ofsort lsig lopen ks_blk ∧ b ∊ ofsort lsig lopen ks_nat ∧ c ∊ ofsort lsig lopen ks_expr $ by ex_elim [q10, q9]
q12: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl $ by ax
q13: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_srt , scons x ∅ ⟩ $ by and_elim_l [q12]
