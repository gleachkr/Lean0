lemma b14_Gsub {g f t a: set} (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} ⊆ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $
----
a1: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} $ by ax
a2: $ … ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by cab_elim [a1]
a3: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} , ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A ⇒ ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A $ by ax
a4: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} , ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A ⇒ A = B $ by weaken [#1]
a5: $ … ⇒ ⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ B $ by wcel_eq_r [a4, a3]
a6: $ … ⇒ ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [a5]
a7: $ … ⇒ ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [a6]
a8: $ … ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [a7]
a9: $ … ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by cab_intro [a8]
b1: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} , ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) ⇒ ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by ax
b2: $ … ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by ex_elim [b1, a9]
b3: $ G , y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} , ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) ⇒ ∃ t ∃ a (⟨ f , ⟨ y , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by ax
b4: $ … ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by ex_elim [b3, b2]
b5: $ … ⇒ y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by ex_elim [a2, b4]
b6: $ … ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} ⊆ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by subset_intro [b5]

lemma b14_Geq {g f t a: set} (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} = {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $
----
c1: $ … ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} ⊆ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by b14_Gsub [#1]
c2: $ … ⇒ B = A $ by eq_sym [#1]
c3: $ … ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} ⊆ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} $ by b14_Gsub [c2]
c4: $ … ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} = {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by subset_antisym [c1, c3]

lemma b14_sat (G: hyps) (M W H T T2: class) (u y0: set): $ G ⇒ T ∈ trees ω $ > $ G ⇒ T2 ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ H ∈ sat u M T2 W $ > $ G ⇒ y0 ∊ dt u M T W H $ > $ G ⇒ y0 ∊ u $ > $ G ⇒ scons y0 H ∈ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ W $
----
s1: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ v = W $ by ax
s2: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ h = H $ by ax
s3: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ h ∊ sat u M T2 W $ by ax
s4: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ T2 = T2 $ by eq_refl
s5: $ … ⇒ W = v $ by eq_sym [s1]
s6: $ … ⇒ sat u M T2 W = sat u M T2 v $ by sat_eq [s4, s5]
s7: $ … ⇒ h ∊ sat u M T2 v $ by welc_eq [s6, s3]
s8: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ u = u $ by eq_refl
s9: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ M = M $ by eq_refl
s10: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ T = T $ by eq_refl
s11: $ … ⇒ H = h $ by eq_sym [s2]
s12: $ … ⇒ dt u M T W H = dt u M T v h $ by dt_eq [s8, s9, s10, s5, s11]
s13: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ y0 ∊ dt u M T W H $ by weaken [#5]
s14: $ … ⇒ y0 ∊ dt u M T v h $ by welc_eq [s12, s13]
s15: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ T ∈ trees ω $ by weaken [#1]
s16: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ T2 ∈ trees ω $ by weaken [#2]
s17: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ v ∊ lvals $ by ax
s18: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ y0 ∊ u $ by weaken [#6]
s19: $ … ⇒ scons y0 h ∈ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ v $ by sat_cons_intro [s15, s16, s17, s7, s14, s18]
s20: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ y0 = y0 $ by eq_refl
s21: $ … ⇒ scons y0 h = scons y0 H $ by scons_eq [s20, s2]
s22: $ … ⇒ scons y0 H ∈ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ v $ by wcel_eq_l [s21, s19]
s23: $ G , v = W , v ∊ lvals , h = H , h ∊ sat u M T2 W ⇒ ⟨ kc_cons , scons T (scons T2 ∅) ⟩ = ⟨ kc_cons , scons T (scons T2 ∅) ⟩ $ by eq_refl
s24: $ … ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ v = sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ W $ by sat_eq [s23, s1]
s25: $ … ⇒ scons y0 H ∈ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ W $ by wcel_eq_r [s24, s22]
s26: $ … ⇒ scons y0 H ∈ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ W $ by wcel_elim [#4, s25]
s27: $ … ⇒ scons y0 H ∈ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ W $ by wcel_elim [#3, s26]

lemma b14_ulc (G: hyps) (W: class) (t4 t14: set): $ G ⇒ ra_ulevel t4 t14 ∈ lrel2 $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ ¬ lv t4 W = ∅ $ > $ G ⇒ t14 ∈ trees ω ∧ fv uni (lv t14 W) ⊆ fv uni (lv t4 W) $
