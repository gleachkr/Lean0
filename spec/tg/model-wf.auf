l2: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ fv nvf d = fv nvf x7 $ by fv_eq [l1, b7]
l3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ fv nvf t3 = fv nvf x3 $ by fv_eq [l1, b3]
l4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ nadd (fv nvf d) (fv nvf t3) = nadd (fv nvf x7) (fv nvf x3) $ by nadd_eq [l2, l3]
l8: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ a = a $ by eq_refl
l9: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ b = b $ by eq_refl
l10a: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) $ by weaken [#5]
l10: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ ∀ i (i ∊ nadd (fv nvf x7) (fv nvf x3) → fv a i = fv b i) $ by fv_agree_eq [l4, l8, l9, l10a]
l11a: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J ⇒ z ∊ trees ω $ by weaken [#1]
