h0d: $ G ⇒ isset (scons x0 ∅) $ by scons_set [h0c]
h0e: $ G ⇒ isset (scons x9 (scons x0 ∅)) $ by scons_set [h0d]
h1: $ G ⇒ crn (scons x9 (scons x0 ∅)) ⊆ b7_cs u M w J t1 t2 t3 t4 t5 $ by node_crn_sub [#1, #2, #3, r5, h0e]
h2: $ G ⇒ crn (scons x0 ∅) ⊆ b7_cs u M w J t1 t2 t3 t4 t5 $ by crn_scons_tail [h1]
h3a: $ G ⇒ isset x0 $ by isset_var
h3: $ G ⇒ x0 ∈ b7_cs u M w J t1 t2 t3 t4 t5 $ by crn_scons_head [h3a, h2]
h4: $ G ⇒ x0 ∊ b7_cs u M w J t1 t2 t3 t4 t5 $ by wcel_welc [h3]
a1: $ G ⇒ x1 = t1 $ by eq_sym [#5]
a2: $ G ⇒ t2 = t2 $ by eq_refl
a3: $ G ⇒ x3 = t3 $ by eq_sym [#6]
a4: $ G ⇒ x4 = t4 $ by eq_sym [#7]
a5: $ G ⇒ x5 = t5 $ by eq_sym [#8]
a6: $ G ⇒ CC = CC $ by eq_refl
a7a: $ G ⇒ kc_s = kc_s $ by eq_refl
a7b: $ G ⇒ x7 = d $ by eq_sym [#9]
a7c: $ G ⇒ ∅ = ∅ $ by eq_refl
a7d: $ G ⇒ scons x7 ∅ = scons d ∅ $ by scons_eq [a7b, a7c]
a7: $ G ⇒ ⟨ kc_s , scons x7 ∅ ⟩ = ⟨ kc_s , scons d ∅ ⟩ $ by opair_eq [a7a, a7d]
a8: $ G ⇒ x0 = x0 $ by eq_refl
a9: $ G ⇒ ra_cwf x1 t2 x3 x4 x5 CC ⟨ kc_s , scons x7 ∅ ⟩ x0 = ra_cwf t1 t2 t3 t4 t5 CC ⟨ kc_s , scons d ∅ ⟩ x0 $ by ra_cwf_eq [a1, a2, a3, a4, a5, a6, a7, a8]
a10: $ G ⇒ ra_cwf t1 t2 t3 t4 t5 CC ⟨ kc_s , scons d ∅ ⟩ x0 ∈ lrel3 J $ by wcel_eq_l [a9, #10]
a11a: $ G ⇒ d ∈ trees ω $ by welc_wcel [#14]
a11b: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
a11c: $ G ⇒ scons d ∅ ∈ fseq (trees ω) $ by scons_fseq_c [a11a, a11b]
a11d: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
a11: $ G ⇒ ⟨ kc_s , scons d ∅ ⟩ ∈ trees ω $ by trees_intro_c [r3, a11d, a11c]
a12: $ G ⇒ fv nvf ⟨ kc_s , scons d ∅ ⟩ = suc (fv nvf d) $ by nvf_s [a11a]
a13a: $ G ⇒ functional nvf $ by nvf_functional
a13b: $ G ⇒ isset d $ by isset_var
a13c: $ G ⇒ fv nvf d ∈ ω $ by nvf_omega [a13b]
a13d: $ G ⇒ isset t3 $ by isset_var
a13e: $ G ⇒ fv nvf t3 ∈ ω $ by nvf_omega [a13d]
a14: $ G ⇒ w = w $ by eq_refl
a15: $ G ⇒ r = r $ by eq_refl
a16: $ G ⇒ etel u (dnf u M) z w r = etel u (dnf u M) ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ w r $ by etel_eq [#3, a14, a15]
a17: $ G ⇒ etel u (dnf u M) ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ w r = {q | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) x9) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x0 w (scons x r) ∧ q = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) x9 w r) t , a ⟩ ⟩ ⟩)} $ by etel_pi [r7w, r8w, #12, #13]
b1: $ G , q ∊ etel u (dnf u M) z w r ⇒ q ∊ etel u (dnf u M) z w r $ by ax
b2a: $ G , q ∊ etel u (dnf u M) z w r ⇒ etel u (dnf u M) z w r = etel u (dnf u M) ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ w r $ by weaken [a16]
b2: $ G , q ∊ etel u (dnf u M) z w r ⇒ q ∊ etel u (dnf u M) ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ w r $ by welc_eq [b2a, b1]
b3a: $ G , q ∊ etel u (dnf u M) z w r ⇒ etel u (dnf u M) ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ w r = {q | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) x9) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x0 w (scons x r) ∧ q = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) x9 w r) t , a ⟩ ⟩ ⟩)} $ by weaken [a17]
b3: $ G , q ∊ etel u (dnf u M) z w r ⇒ q ∊ {q | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) x9) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x0 w (scons x r) ∧ q = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) x9 w r) t , a ⟩ ⟩ ⟩)} $ by welc_eq [b3a, b2]
b4: $ G , q ∊ etel u (dnf u M) z w r ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) x9) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) x0 w (scons x r) ∧ q = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) x9 w r) t , a ⟩ ⟩ ⟩) $ by cab_elim [b3]
