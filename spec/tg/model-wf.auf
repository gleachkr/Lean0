lemma b3_lq_u {y: set} (G: hyps) (J M D W Z P T: class) (u q: set): $ G ⇒ icwf J D $ > $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Z ⊆ itc u (dnf u M) D W $ > $ G ⇒ iprt D P T $ > $ G ⇒ q ∊ esat u (dnf u M) P W $ > $ G ⇒ lfp y (iphi u (dnf u M) D W Z q y) ∈ u $
----
