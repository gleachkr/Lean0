a8: $ … ⇒ t13 ∈ trees ω $ by isset_elim [a7, a6]

lemma b14_assoc (G: hyps) (A S T U: class): $ G ⇒ S ∈ fseq A $ > $ G ⇒ T ∈ fseq A $ > $ G ⇒ U ∈ fseq A $ > $ G ⇒ scat (scat S T) U = scat S (scat T U) $
----
a1: $ G , i = S , j = T , k = U ⇒ i = S $ by ax
a2: $ G , i = S , j = T , k = U ⇒ j = T $ by ax
a3: $ G , i = S , j = T , k = U ⇒ k = U $ by ax
a4: $ … ⇒ S = i $ by eq_sym [a1]
a5: $ … ⇒ T = j $ by eq_sym [a2]
a6: $ … ⇒ U = k $ by eq_sym [a3]
a7: $ G , i = S , j = T , k = U ⇒ S ∈ fseq A $ by weaken [#1]
a8: $ … ⇒ i ∈ fseq A $ by wcel_eq_l [a4, a7]
a9: $ … ⇒ i ∊ fseq A $ by wcel_welc [a8]
