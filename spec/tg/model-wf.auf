q53: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ z ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ z = scons x q) $ by and_intro [q52, q51]
q54: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by cab_intro [q53]
q55: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) ⇒ ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) $ by ax
q56: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by ex_elim [q55, q54]
q57: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) ⇒ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) $ by ax
q58: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} , ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by ex_elim [q57, q56]
q59: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ z = scons x q) → z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by imp_intro [q58]
q60: $ G , z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by imp_elim [q59, q34]
q61: $ G ⇒ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} $ by eq_intro [q30, q60]
q62: $ G ⇒ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E2 T w ∧ x ∊ da (fv E2 A) w q ∧ r = scons x q)} = esat u E2 ⟨ kc_cons , scons A (scons T ∅) ⟩ w $ by eq_sym [q2]
q63: $ G ⇒ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E T w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} = esat u E2 ⟨ kc_cons , scons A (scons T ∅) ⟩ w $ by eq_trans [q61, q62]
q64: $ G ⇒ esat u E ⟨ kc_cons , scons A (scons T ∅) ⟩ w = esat u E2 ⟨ kc_cons , scons A (scons T ∅) ⟩ w $ by eq_trans [q1, q63]

lemma b6_closed_pi (G: hyps) (k a b z: set): $ G ⇒ ra_closed k z ∈ lrel $ > $ G ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ > $ G ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $
----
q1: $ G ⇒ ∃ x1 ∃ x2 (k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel) ∨ ∃ x2 ∃ x3 (k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩) ∨ ∃ x2 ∃ x4 ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) ∨ ∃ x2 ∃ x6 ∃ x7 (k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel) ∨ ∃ x2 ∃ x6 ∃ x7 (k = x2 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel) ∨ ∃ x2 ∃ x5 ∃ x8 (k = x2 ∧ z = ⟨ kc_cst , scons x5 (scons x8 ∅) ⟩) ∨ ∃ x2 ∃ x9 (k = x2 ∧ z = ⟨ kc_lit , scons x9 ∅ ⟩) ∨ ∃ x2 ∃ x0 ∃ x1 (k = x2 ∧ z = ⟨ kc_ind_ty , scons x0 (scons x1 ∅) ⟩) ∨ ∃ x2 ∃ x0 ∃ x1 ∃ d (k = x2 ∧ z = ⟨ kc_ind_ctor , scons x0 (scons x1 (scons d ∅)) ⟩) ∨ ∃ x2 ∃ x0 ∃ x1 ∃ e (k = x2 ∧ z = ⟨ kc_ind_rec , scons x0 (scons x1 (scons e ∅)) ⟩) ∨ ∃ x2 ∃ x7 ∃ x1 ∃ f (k = x2 ∧ z = ⟨ kc_proj , scons x7 (scons x1 (scons f ∅)) ⟩ ∧ ra_closed x2 f ∈ lrel) ∨ ∃ x2 ∃ g (k = x2 ∧ z = ⟨ kc_quot , scons g ∅ ⟩) ∨ ∃ x2 ∃ g (k = x2 ∧ z = ⟨ kc_quot_mk , scons g ∅ ⟩) ∨ ∃ x2 ∃ g ∃ e (k = x2 ∧ z = ⟨ kc_quot_lift , scons g (scons e ∅) ⟩) ∨ ∃ x2 ∃ g (k = x2 ∧ z = ⟨ kc_quot_ind , scons g ∅ ⟩) $ by lrel_closed_cases [#1]
q2: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel $ by ax
q3: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ k = x2 $ by and_elim_l [q2]
q4: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel $ by and_elim_r [q2]
q5: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ z = ⟨ kc_bvar , scons x1 ∅ ⟩ $ by and_elim_l [q4]
q6: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel $ by and_elim_r [q4]
q7: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by weaken [#2]
q8: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
q9: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
q10: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ ¬ kc_bvar = kc_pi $ by kc_bvar_ne_pi
q11: $ G , k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by b6_clash [q5, q7, q10, q8, q9]
q12: $ G , ∃ x2 (k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel) ⇒ ∃ x2 (k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel) $ by ax
q13: $ G , ∃ x2 (k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel) ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by ex_elim [q12, q11]
q14: $ G , ∃ x1 ∃ x2 (k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel) ⇒ ∃ x1 ∃ x2 (k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel) $ by ax
q15: $ G , ∃ x1 ∃ x2 (k = x2 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x1 ∅ ⟩ x2 ∈ lrel) ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by ex_elim [q14, q13]
q16: $ G , k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ ⇒ k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ $ by ax
q17: $ G , k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ ⇒ k = x2 $ by and_elim_l [q16]
q18: $ G , k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ ⇒ z = ⟨ kc_srt , scons x3 ∅ ⟩ $ by and_elim_r [q16]
q19: $ G , k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by weaken [#2]
q20: $ G , k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ ⇒ kc_srt ∈ ω $ by kc_srt_omega
q21: $ G , k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ ⇒ kc_pi ∈ ω $ by kc_pi_omega
q22: $ G , k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ ⇒ ¬ kc_srt = kc_pi $ by kc_srt_ne_pi
q23: $ G , k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩ ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by b6_clash [q18, q19, q22, q20, q21]
q24: $ G , ∃ x3 (k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩) ⇒ ∃ x3 (k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩) $ by ax
q25: $ G , ∃ x3 (k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩) ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by ex_elim [q24, q23]
q26: $ G , ∃ x2 ∃ x3 (k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩) ⇒ ∃ x2 ∃ x3 (k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩) $ by ax
q27: $ G , ∃ x2 ∃ x3 (k = x2 ∧ z = ⟨ kc_srt , scons x3 ∅ ⟩) ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by ex_elim [q26, q25]
q28: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel $ by ax
q29: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ k = x2 $ by and_elim_l [q28]
q30: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel $ by and_elim_r [q28]
q31: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ $ by and_elim_l [q30]
q32: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel $ by and_elim_r [q30]
q33: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ ra_closed x2 x4 ∈ lrel $ by and_elim_l [q32]
q34: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ ra_closed x2 x5 ∈ lrel $ by and_elim_r [q32]
q35: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ z = ⟨ kc_pi , scons a (scons b ∅) ⟩ $ by weaken [#2]
q36: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ kc_app ∈ ω $ by kc_app_omega
q37: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
q38: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ ¬ kc_app = kc_pi $ by kc_app_ne_pi
q39: $ G , k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by b6_clash [q31, q35, q38, q36, q37]
q40: $ G , ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) ⇒ ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) $ by ax
q41: $ G , ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by ex_elim [q40, q39]
q42: $ G , ∃ x4 ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) ⇒ ∃ x4 ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) $ by ax
q43: $ G , ∃ x4 ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by ex_elim [q42, q41]
q44: $ G , ∃ x2 ∃ x4 ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) ⇒ ∃ x2 ∃ x4 ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) $ by ax
q45: $ G , ∃ x2 ∃ x4 ∃ x5 (k = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_closed x2 x4 ∈ lrel ∧ ra_closed x2 x5 ∈ lrel) ⇒ ra_closed k a ∈ lrel ∧ ra_closed ⟨ kc_s , scons k ∅ ⟩ b ∈ lrel $ by ex_elim [q44, q43]
q46: $ G , k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel ⇒ k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel $ by ax
q47: $ G , k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel ⇒ k = x2 $ by and_elim_l [q46]
q48: $ G , k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel ⇒ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel $ by and_elim_r [q46]
q49: $ G , k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel ⇒ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ $ by and_elim_l [q48]
q50: $ G , k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel ⇒ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel $ by and_elim_r [q48]
q51: $ G , k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel ⇒ ra_closed x2 x6 ∈ lrel $ by and_elim_l [q50]
q52: $ G , k = x2 ∧ z = ⟨ kc_lam , scons x6 (scons x7 ∅) ⟩ ∧ ra_closed x2 x6 ∈ lrel ∧ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel ⇒ ra_closed ⟨ kc_s , scons x2 ∅ ⟩ x7 ∈ lrel $ by and_elim_r [q50]
