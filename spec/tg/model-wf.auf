lemma b6_kids_proj (G: hyps) (a b c: set): $ G ⇒ ⟨ kc_proj , scons a (scons b (scons c ∅)) ⟩ ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ a ∊ ofsort lsig lopen ks_blk ∧ b ∊ ofsort lsig lopen ks_nat ∧ c ∊ ofsort lsig lopen ks_expr $
----
q1: $ G , z = ⟨ kc_proj , scons a (scons b (scons c ∅)) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z ∊ ofsort lsig lopen ks_expr $ by ax
q2: $ G , z = ⟨ kc_proj , scons a (scons b (scons c ∅)) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_proj , scons a (scons b (scons c ∅)) ⟩ $ by ax
q3: $ G , z = ⟨ kc_proj , scons a (scons b (scons c ∅)) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_blk ∧ b ∊ ofsort lsig lopen ks_nat ∧ c ∊ ofsort lsig lopen ks_expr $ by b6_kc_proj [q1, q2]
q4: $ G ⇒ a ∊ ofsort lsig lopen ks_blk ∧ b ∊ ofsort lsig lopen ks_nat ∧ c ∊ ofsort lsig lopen ks_expr $ by wcel_elim [#1, q3]

def b6_cadd (.y .a .c: set): class = $ {y | ∀ a ∀ c (ra_add a y c ∈ lrel → a ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat)} $

lemma b6_add_st (G: hyps) (z k s t1 t3: set): $ G ⇒ crn s ⊆ b6_cadd $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_add t1 z t3 ∈ lrel $ > $ G ⇒ t1 ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ t3 ∊ ofsort lsig lopen ks_nat $
----
q1: $ G ⇒ ∃ x (t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ∨ ∃ x ∃ y ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) $ by lrel_add_cases [#4]
q2: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x $ by ax
q3: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = x $ by and_elim_l [q2]
q4: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x $ by and_elim_r [q2]
q5: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [q4]
q6: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t3 = x $ by and_elim_r [q4]
q7: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ x = t3 $ by eq_sym [q6]
q8: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 = t3 $ by eq_trans [q3, q7]
q9: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t1 ∊ ofsort lsig lopen ks_nat $ by weaken [#5]
q10: $ G , t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x ⇒ t3 ∊ ofsort lsig lopen ks_nat $ by welc_eq_set [q8, q9]
q11: $ G , ∃ x (t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ⇒ ∃ x (t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) $ by ax
q12: $ G , ∃ x (t1 = x ∧ z = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x) ⇒ t3 ∊ ofsort lsig lopen ks_nat $ by ex_elim [q11, q10]
q13: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel $ by ax
q14: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ t1 = x $ by and_elim_l [q13]
q15: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel $ by and_elim_r [q13]
q16: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ z = ⟨ kc_s , scons y ∅ ⟩ $ by and_elim_l [q15]
q17: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel $ by and_elim_r [q15]
q18: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ t3 = ⟨ kc_s , scons v ∅ ⟩ $ by and_elim_l [q17]
q19: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ ra_add x y v ∈ lrel $ by and_elim_r [q17]
q20: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ crn s ⊆ b6_cadd $ by weaken [#1]
q21: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ z = ⟨ k , s ⟩ $ by weaken [#2]
q22: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
q23: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ isset kc_s $ by wcel_isset [q22]
q24: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ isset ∅ $ by ax_empty
q25: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ isset (scons y ∅) $ by scons_set [q24]
q26: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ crn (scons y ∅) ⊆ b6_cadd $ by node_crn_sub [q20, q21, q16, q23, q25]
q27: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ isset y $ by isset_var
q28: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ y ∈ b6_cadd $ by crn_scons_head [q27, q26]
q29: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ y ∊ b6_cadd $ by wcel_welc [q28]
q30: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ ∀ a ∀ c (ra_add a y c ∈ lrel → a ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat) $ by cab_elim [q29]
q31: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ ∀ c (ra_add x y c ∈ lrel → x ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat) $ by all_elim [q30]
q32: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ ra_add x y v ∈ lrel → x ∊ ofsort lsig lopen ks_nat → v ∊ ofsort lsig lopen ks_nat $ by all_elim [q31]
q33: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ t1 ∊ ofsort lsig lopen ks_nat $ by weaken [#5]
q34: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ x ∊ ofsort lsig lopen ks_nat $ by welc_eq_set [q14, q33]
q35: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ x ∊ ofsort lsig lopen ks_nat → v ∊ ofsort lsig lopen ks_nat $ by imp_elim [q32, q19]
q36: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ v ∊ ofsort lsig lopen ks_nat $ by imp_elim [q35, q34]
q37: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ v ∈ ofsort lsig lopen ks_nat $ by welc_wcel [q36]
q38: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ ⟨ kc_s , scons v ∅ ⟩ ∈ ofsort lsig lopen ks_nat $ by b6_so_s [q37]
q39: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ ⟨ kc_s , scons v ∅ ⟩ = t3 $ by eq_sym [q18]
q40: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ t3 ∈ ofsort lsig lopen ks_nat $ by wcel_eq_l [q39, q38]
q41: $ G , t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel ⇒ t3 ∊ ofsort lsig lopen ks_nat $ by wcel_welc [q40]
q42: $ G , ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) ⇒ ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) $ by ax
q43: $ G , ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) ⇒ t3 ∊ ofsort lsig lopen ks_nat $ by ex_elim [q42, q41]
q44: $ G , ∃ y ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) ⇒ ∃ y ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) $ by ax
q45: $ G , ∃ y ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) ⇒ t3 ∊ ofsort lsig lopen ks_nat $ by ex_elim [q44, q43]
q46: $ G , ∃ x ∃ y ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) ⇒ ∃ x ∃ y ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) $ by ax
q47: $ G , ∃ x ∃ y ∃ v (t1 = x ∧ z = ⟨ kc_s , scons y ∅ ⟩ ∧ t3 = ⟨ kc_s , scons v ∅ ⟩ ∧ ra_add x y v ∈ lrel) ⇒ t3 ∊ ofsort lsig lopen ks_nat $ by ex_elim [q46, q45]
q48: $ G ⇒ t3 ∊ ofsort lsig lopen ks_nat $ by or_elim [q1, q12, q47]

lemma b6_add_nat (G: hyps) (t1 t2 t3: set): $ G ⇒ ra_add t1 t2 t3 ∈ lrel $ > $ G ⇒ t1 ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ t3 ∊ ofsort lsig lopen ks_nat $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel , a ∊ ofsort lsig lopen ks_nat ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel , a ∊ ofsort lsig lopen ks_nat ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel , a ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel , a ∊ ofsort lsig lopen ks_nat ⇒ crn j ⊆ b6_cadd $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel , a ∊ ofsort lsig lopen ks_nat ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel , a ∊ ofsort lsig lopen ks_nat ⇒ ra_add a z c ∈ lrel $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel , a ∊ ofsort lsig lopen ks_nat ⇒ a ∊ ofsort lsig lopen ks_nat $ by ax
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel , a ∊ ofsort lsig lopen ks_nat ⇒ c ∊ ofsort lsig lopen ks_nat $ by b6_add_st [q4, q3, q5, q6, q7]
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ , ra_add a z c ∈ lrel ⇒ a ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat $ by imp_intro [q8]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ ⇒ ra_add a z c ∈ lrel → a ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat $ by imp_intro [q9]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ ⇒ ∀ c (ra_add a z c ∈ lrel → a ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat) $ by all_intro [q10]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ ⇒ ∀ a ∀ c (ra_add a z c ∈ lrel → a ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat) $ by all_intro [q11]
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ ⇒ z ∊ b6_cadd $ by cab_intro [q12]
q14: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
q15: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b6_cadd $ by wcel_intro [q14, q13]
q16: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd ⇒ isset ⟨ k , j ⟩ $ by opair_isset
q17: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cadd ⇒ ⟨ k , j ⟩ ∈ b6_cadd $ by isset_elim [q16, q15]
q18: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b6_cadd → ⟨ k , j ⟩ ∈ b6_cadd $ by imp_intro [q17]
q19: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b6_cadd → ⟨ k , j ⟩ ∈ b6_cadd $ by imp_intro [q18]
q20: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cadd → ⟨ k , j ⟩ ∈ b6_cadd $ by imp_intro [q19]
q21: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cadd → ⟨ k , j ⟩ ∈ b6_cadd) $ by all_intro [q20]
q22: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cadd → ⟨ k , j ⟩ ∈ b6_cadd) $ by all_intro [q21]
q23: $ G ⇒ isset ω $ by omega_set
q24: $ G ⇒ trees ω ⊆ b6_cadd $ by trees_ind_c [q23, q22]
q25: $ G ⇒ kr_add ∈ ω $ by kr_add_omega
q26: $ G ⇒ isset kr_add $ by wcel_isset [q25]
q27: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, q26]
q28: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by and_elim_r [q27]
q29: $ G ⇒ t2 ∊ trees ω $ by and_elim_l [q28]
q30: $ G ⇒ t2 ∊ b6_cadd $ by subset_elim [q24, q29]
q31: $ G ⇒ ∀ a ∀ c (ra_add a t2 c ∈ lrel → a ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat) $ by cab_elim [q30]
q32: $ G ⇒ ∀ c (ra_add t1 t2 c ∈ lrel → t1 ∊ ofsort lsig lopen ks_nat → c ∊ ofsort lsig lopen ks_nat) $ by all_elim [q31]
q33: $ G ⇒ ra_add t1 t2 t3 ∈ lrel → t1 ∊ ofsort lsig lopen ks_nat → t3 ∊ ofsort lsig lopen ks_nat $ by all_elim [q32]
q34: $ G ⇒ t1 ∊ ofsort lsig lopen ks_nat → t3 ∊ ofsort lsig lopen ks_nat $ by imp_elim [q33, #1]
q35: $ G ⇒ t3 ∊ ofsort lsig lopen ks_nat $ by imp_elim [q34, #2]

lemma b6_isort_same (G: hyps) {n l: set} (z t: set): $ G ⇒ z = t $ > $ G ⇒ (z ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel) $
----
q1: $ G , z ∊ ofsort lsig lopen ks_expr ⇒ z = t $ by weaken [#1]
q2: $ G , z ∊ ofsort lsig lopen ks_expr ⇒ z ∊ ofsort lsig lopen ks_expr $ by ax
q3: $ G , z ∊ ofsort lsig lopen ks_expr ⇒ t ∊ ofsort lsig lopen ks_expr $ by welc_eq_set [q1, q2]
q4: $ G ⇒ z ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr $ by imp_intro [q3]
q5: $ G , ra_isort z n l ∈ lrel ⇒ z = t $ by weaken [#1]
q6: $ G , ra_isort z n l ∈ lrel ⇒ n = n $ by eq_refl
q7: $ G , ra_isort z n l ∈ lrel ⇒ l = l $ by eq_refl
q8: $ G , ra_isort z n l ∈ lrel ⇒ ra_isort z n l = ra_isort t n l $ by ra_isort_eq [q5, q6, q7]
q9: $ G , ra_isort z n l ∈ lrel ⇒ ra_isort z n l ∈ lrel $ by ax
q10: $ G , ra_isort z n l ∈ lrel ⇒ ra_isort t n l ∈ lrel $ by wcel_eq_l [q8, q9]
q11: $ G ⇒ ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel $ by imp_intro [q10]
q12: $ G ⇒ ∀ l (ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel) $ by all_intro [q11]
q13: $ G ⇒ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel) $ by all_intro [q12]
q14: $ G ⇒ (z ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel) $ by and_intro [q4, q13]

lemma b6_isort_no (G: hyps) (z t m: set) (K S: class) (p: fml): $ G ⇒ ra_isort z t m ∈ lrel $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ ¬ kc_srt = K $ > $ G ⇒ ¬ kc_pi = K $ > $ G ⇒ K ∈ ω $ > $ G ⇒ p $
----
q1: $ G ⇒ ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x) ∨ ∃ y ∃ v ∃ w ∃ x (z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel) $ by lrel_isort_cases [#1]
q2: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x $ by ax
q3: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ z = ⟨ kc_srt , scons x ∅ ⟩ $ by and_elim_l [q2]
q4: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x $ by and_elim_r [q2]
q5: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ t = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [q4]
q6: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ m = x $ by and_elim_r [q4]
q7: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ z = ⟨ K , S ⟩ $ by weaken [#2]
q8: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ ¬ kc_srt = K $ by weaken [#3]
q9: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ kc_srt ∈ ω $ by kc_srt_omega
q10: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ K ∈ ω $ by weaken [#5]
q11: $ G , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x ⇒ p $ by b6_clash [q3, q7, q8, q9, q10]
q12: $ G , ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x) ⇒ ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x) $ by ax
q13: $ G , ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ t = ⟨ kc_nz , ∅ ⟩ ∧ m = x) ⇒ p $ by ex_elim [q12, q11]
q14: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel $ by ax
q15: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ z = ⟨ kc_pi , scons y (scons v ∅) ⟩ $ by and_elim_l [q14]
q16: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel $ by and_elim_r [q14]
q17: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ t = ⟨ kc_s , scons w ∅ ⟩ $ by and_elim_l [q16]
q18: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ m = x ∧ ra_isort v w x ∈ lrel $ by and_elim_r [q16]
q19: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ m = x $ by and_elim_l [q18]
q20: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ ra_isort v w x ∈ lrel $ by and_elim_r [q18]
q21: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ z = ⟨ K , S ⟩ $ by weaken [#2]
q22: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ ¬ kc_pi = K $ by weaken [#4]
q23: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ kc_pi ∈ ω $ by kc_pi_omega
q24: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ K ∈ ω $ by weaken [#5]
q25: $ G , z = ⟨ kc_pi , scons y (scons v ∅) ⟩ ∧ t = ⟨ kc_s , scons w ∅ ⟩ ∧ m = x ∧ ra_isort v w x ∈ lrel ⇒ p $ by b6_clash [q15, q21, q22, q23, q24]
