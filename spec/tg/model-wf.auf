cy0: $ G , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j ∃ a (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = a ∧ ra_indapp x6 x7 x8 x9 a j ∈ lrel) ⇒ b11_nc_dp u M w y (nadd (fv nvf d) (fv nvf t3)) ∨ b11_nc_sg u M w t1 X0 X y (fv nvf d) (fv nvf t3) $ by ex_elim [cx0, cy1]
o1: $ G , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ k ∃ a ∃ b (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ ra_add x9 x8 k ∈ lrel ∧ ra_closed k a ∈ lrel ∧ ra_ipos x6 x7 x8 ⟨ kc_s , scons x9 ∅ ⟩ b ∈ lrel) ∨ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j ∃ a (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = a ∧ ra_indapp x6 x7 x8 x9 a j ∈ lrel) ⇒ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ k ∃ a ∃ b (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ ra_add x9 x8 k ∈ lrel ∧ ra_closed k a ∈ lrel ∧ ra_ipos x6 x7 x8 ⟨ kc_s , scons x9 ∅ ⟩ b ∈ lrel) ∨ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j ∃ a (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = a ∧ ra_indapp x6 x7 x8 x9 a j ∈ lrel) $ by ax
o1b: $ G , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ k ∃ a ∃ b (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ ra_add x9 x8 k ∈ lrel ∧ ra_closed k a ∈ lrel ∧ ra_ipos x6 x7 x8 ⟨ kc_s , scons x9 ∅ ⟩ b ∈ lrel) ∨ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j ∃ a (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = a ∧ ra_indapp x6 x7 x8 x9 a j ∈ lrel) , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ k ∃ a ∃ b (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ ra_add x9 x8 k ∈ lrel ∧ ra_closed k a ∈ lrel ∧ ra_ipos x6 x7 x8 ⟨ kc_s , scons x9 ∅ ⟩ b ∈ lrel) ⇒ b11_nc_dp u M w y (nadd (fv nvf d) (fv nvf t3)) ∨ b11_nc_sg u M w t1 X0 X y (fv nvf d) (fv nvf t3) $ by weaken [by0]
o1c: $ G , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ k ∃ a ∃ b (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ ra_add x9 x8 k ∈ lrel ∧ ra_closed k a ∈ lrel ∧ ra_ipos x6 x7 x8 ⟨ kc_s , scons x9 ∅ ⟩ b ∈ lrel) ∨ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j ∃ a (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = a ∧ ra_indapp x6 x7 x8 x9 a j ∈ lrel) , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j ∃ a (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = a ∧ ra_indapp x6 x7 x8 x9 a j ∈ lrel) ⇒ b11_nc_dp u M w y (nadd (fv nvf d) (fv nvf t3)) ∨ b11_nc_sg u M w t1 X0 X y (fv nvf d) (fv nvf t3) $ by weaken [cy0]
o2: $ G , ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ k ∃ a ∃ b (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ ra_add x9 x8 k ∈ lrel ∧ ra_closed k a ∈ lrel ∧ ra_ipos x6 x7 x8 ⟨ kc_s , scons x9 ∅ ⟩ b ∈ lrel) ∨ ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ j ∃ a (t1 = x6 ∧ t2 = x7 ∧ t3 = x8 ∧ d = x9 ∧ y = a ∧ ra_indapp x6 x7 x8 x9 a j ∈ lrel) ⇒ b11_nc_dp u M w y (nadd (fv nvf d) (fv nvf t3)) ∨ b11_nc_sg u M w t1 X0 X y (fv nvf d) (fv nvf t3) $ by or_elim [o1, o1b, o1c]
o3: $ G ⇒ b11_nc_dp u M w y (nadd (fv nvf d) (fv nvf t3)) ∨ b11_nc_sg u M w t1 X0 X y (fv nvf d) (fv nvf t3) $ by or_elim [inv, ay0, o2]

--| (NC) Every tree, as a positive field type, is DEP or SING (`b9_pn`).
lemma b11_nc (G: hyps) (M X0 X: class) (u w t1 t2 t3 y: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ t1 ∊ trees ω $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ y ∊ b9_pn u M w t1 t2 t3 X0 X $
----
s1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X ⇒ k ∊ ω $ by ax
s2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X ⇒ j ∊ fseq (trees ω) $ by ax
s3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X ⇒ crn j ⊆ b9_pn u M w t1 t2 t3 X0 X $ by ax
s4a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X ⇒ isset k $ by isset_var
s4: $ … ⇒ isset ⟨ k , j ⟩ $ by opair_set_l [s4a]
z0: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
w164_s1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ ⇒ k ∊ ω $ by weaken [s1]
w165_s2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ ⇒ j ∊ fseq (trees ω) $ by weaken [s2]
z1: $ … ⇒ z ∊ trees ω $ by trees_omega_intro [w164_s1, w165_s2, z0]
i1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ , ra_ipos t1 t2 t3 d z ∈ lrel , d ∊ trees ω ⇒ ra_ipos t1 t2 t3 d z ∈ lrel $ by ax
i2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ , ra_ipos t1 t2 t3 d z ∈ lrel , d ∊ trees ω ⇒ d ∊ trees ω $ by ax
w166_h1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ , ra_ipos t1 t2 t3 d z ∈ lrel , d ∊ trees ω ⇒ uadm u $ by weaken [#1]
w167_h2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ , ra_ipos t1 t2 t3 d z ∈ lrel , d ∊ trees ω ⇒ w ∊ lvals $ by weaken [#2]
w168_z1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ , ra_ipos t1 t2 t3 d z ∈ lrel , d ∊ trees ω ⇒ z ∊ trees ω $ by weaken [z1]
w169_z0: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ , ra_ipos t1 t2 t3 d z ∈ lrel , d ∊ trees ω ⇒ z = ⟨ k , j ⟩ $ by weaken [z0]
w170_s3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ , ra_ipos t1 t2 t3 d z ∈ lrel , d ∊ trees ω ⇒ crn j ⊆ b9_pn u M w t1 t2 t3 X0 X $ by weaken [s3]
cs: $ … ⇒ b11_nc_dp u M w z (nadd (fv nvf d) (fv nvf t3)) ∨ b11_nc_sg u M w t1 X0 X z (fv nvf d) (fv nvf t3) $ by b11_nc_case [w166_h1, w167_h2, i1, i2, w168_z1, w169_z0, w170_s3]
cs2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ , ra_ipos t1 t2 t3 d z ∈ lrel , d ∊ trees ω ⇒ (∀ x0 ∀ x1 (x0 ∊ fseq u → x1 ∊ fseq u → b9_ag x0 x1 (nadd (fv nvf d) (fv nvf t3)) → dt u M z w x0 = dt u M z w x1)) ∨ (∀ q ∀ p ∀ f (q ∊ fseq u → p ∊ fseq u → b9_ag q p (nadd (fv nvf d) (fv nvf t3)) → b9_hs t1 X0 q p (nadd (fv nvf d) (fv nvf t3)) X → swin q (fv nvf d) (fv nvf t3) = X0 → f ∊ dt u M z w q → dt u M z w p = csn (⋃ (dt u M z w p)) ∧ ∀ l ∀ n (l ∊ fseq u → b9_ag q l (nadd (fv nvf d) (fv nvf t3)) → b9_hb t1 X0 q l (nadd (fv nvf d) (fv nvf t3)) n → ∅ ∈ n → ∀ x2 ∀ x3 ∀ x4 ∀ x5 (⟨ x2 , ⟨ x3 , ⟨ x4 , x5 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z w q → nest x2 ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt u M z w p) → apn f x2 ∈ X → apn f x2 ∈ n) → f ∈ dt u M z w l))) $ by weaken [cs]
pn: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X , z = ⟨ k , j ⟩ ⇒ z ∊ b9_pn u M w t1 t2 t3 X0 X $ by b9_pn_i [cs2]
pn2: $ … ⇒ z ∈ b9_pn u M w t1 t2 t3 X0 X $ by welc_wcel [pn]
pn3: $ … ⇒ ⟨ k , j ⟩ ∈ b9_pn u M w t1 t2 t3 X0 X $ by wcel_eq_l [z0, pn2]
st: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b9_pn u M w t1 t2 t3 X0 X ⇒ ⟨ k , j ⟩ ∈ b9_pn u M w t1 t2 t3 X0 X $ by isset_elim [s4, pn3]
ind: $ G ⇒ trees ω ⊆ b9_pn u M w t1 t2 t3 X0 X $ by trees_omega_ind [st]
fin: $ … ⇒ y ∊ b9_pn u M w t1 t2 t3 X0 X $ by subset_elim [ind, #4]

--| The fibers of `F` at the points `c` with `nest c ⟨ ∅ , ∅ ⟩` in `H`, if in `X`, are in `V`.
def b11_sh_c0 (H F X V: class) (.c: set): fml = $ ∀ c (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ H → apn F c ∈ X → apn F c ∈ V) $

--| @congr
lemma b11_sh_c0_congr (A1 B1 A2 B2 A3 B3 A4 B4: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ b11_sh_c0 A1 A2 A3 A4 ⟺ b11_sh_c0 B1 B2 B3 B4 $
----
e0: $ (c ∊ fseq b7_V) ⟺ (c ∊ fseq b7_V) $ by iff_refl
c2: $ c ≐ c $ by ceqt_refl
c3: $ nest c ⟨ ∅ , ∅ ⟩ ≐ nest c ⟨ ∅ , ∅ ⟩ $ by ceqt_refl
e1: $ (nest c ⟨ ∅ , ∅ ⟩ ∈ A1) ⟺ (nest c ⟨ ∅ , ∅ ⟩ ∈ B1) $ by wcel_congr [c3, #1]
c4: $ apn A2 c ≐ apn B2 c $ by apn_congr [#2, c2]
e2: $ (apn A2 c ∈ A3) ⟺ (apn B2 c ∈ B3) $ by wcel_congr [c4, #3]
e3: $ (apn A2 c ∈ A4) ⟺ (apn B2 c ∈ B4) $ by wcel_congr [c4, #4]
f2: $ (apn A2 c ∈ A3 → apn A2 c ∈ A4) ⟺ (apn B2 c ∈ B3 → apn B2 c ∈ B4) $ by im_congr [e2, e3]
f1: $ (nest c ⟨ ∅ , ∅ ⟩ ∈ A1 → apn A2 c ∈ A3 → apn A2 c ∈ A4) ⟺ (nest c ⟨ ∅ , ∅ ⟩ ∈ B1 → apn B2 c ∈ B3 → apn B2 c ∈ B4) $ by im_congr [e1, f2]
f0: $ (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ A1 → apn A2 c ∈ A3 → apn A2 c ∈ A4) ⟺ (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ B1 → apn B2 c ∈ B3 → apn B2 c ∈ B4) $ by im_congr [e0, f1]
g1: $ (∀ c (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ A1 → apn A2 c ∈ A3 → apn A2 c ∈ A4)) ⟺ (∀ c (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ B1 → apn B2 c ∈ B3 → apn B2 c ∈ B4)) $ by all_congr [f0]

--| @rewrite
lemma b11_sh_sb_c0 {z: set} (t: set z) (A1 A2 A3 A4: class z): $ [z/t] (b11_sh_c0 A1 A2 A3 A4) ⟺ b11_sh_c0 (⟦ z / t ⟧ A1) (⟦ z / t ⟧ A2) (⟦ z / t ⟧ A3) (⟦ z / t ⟧ A4) $
----
l1: $ [z/t] (∀ c (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ A1 → apn A2 c ∈ A3 → apn A2 c ∈ A4)) ⟺ ∀ c (c ∊ fseq b7_V → nest c ⟨ ∅ , ∅ ⟩ ∈ (⟦ z / t ⟧ A1) → apn (⟦ z / t ⟧ A2) c ∈ (⟦ z / t ⟧ A3) → apn (⟦ z / t ⟧ A2) c ∈ (⟦ z / t ⟧ A4)) $ by iff_refl

--| The field's value `Y` is a value of `T` at every world that has `A`'s entries at the elements of a class with its fibers at the points of `H`.
def b11_sh_F (U M T W A K D X0 X H Y: class) (.b .v: set): fml = $ ∀ b ∀ v (b ∊ fseq U → b9_ag A b K → b9_hb D X0 A b K v → ∅ ∈ v → b11_sh_c0 H Y X v → Y ∈ dt U M T W b) $

--| (SH) the transfer: the path `P` is a path of `T` at every world that has `A`'s entries at the elements of a class with the fibers of `G` at the shape's points `S`.
def b11_sh_T (U M T W A K D X0 X S G P: class) (.l .n: set): fml = $ ∀ l ∀ n (l ∊ fseq U → b9_ag A l K → b9_hb D X0 A l K n → ∅ ∈ n → b11_cnd S G X n → P ∈ etel U (dnf U M) T W l) $

--| @congr
lemma b11_sh_T_congr (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6 A7 B7 A8 B8 A9 B9 A10 B10 A11 B11 A12 B12: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ > $ A6 ≐ B6 $ > $ A7 ≐ B7 $ > $ A8 ≐ B8 $ > $ A9 ≐ B9 $ > $ A10 ≐ B10 $ > $ A11 ≐ B11 $ > $ A12 ≐ B12 $ > $ b11_sh_T A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 ⟺ b11_sh_T B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 B12 $
----
c1: $ fseq A1 ≐ fseq B1 $ by fseq_congr [#1]
s0: $ seqt l l $ by seqt_refl
e0: $ (l ∊ fseq A1) ⟺ (l ∊ fseq B1) $ by welc_congr [s0, c1]
c3: $ l ≐ l $ by ceqt_refl
e1: $ b9_ag A5 l A6 ⟺ b9_ag B5 l B6 $ by b9_ag_congr [#5, c3, #6]
c5: $ n ≐ n $ by ceqt_refl
e2: $ b9_hb A7 A8 A5 l A6 n ⟺ b9_hb B7 B8 B5 l B6 n $ by b9_hb_congr [#7, #8, #5, c3, #6, c5]
e3: $ (∅ ∈ n) ⟺ (∅ ∈ n) $ by iff_refl
e4: $ b11_cnd A10 A11 A9 n ⟺ b11_cnd B10 B11 B9 n $ by b11_cnd_congr [#10, #11, #9, c5]
c9: $ dnf A1 A2 ≐ dnf B1 B2 $ by dnf_congr [#1, #2]
c10: $ etel A1 (dnf A1 A2) A3 A4 l ≐ etel B1 (dnf B1 B2) B3 B4 l $ by etel_congr [#1, c9, #3, #4, c3]
e5: $ (A12 ∈ etel A1 (dnf A1 A2) A3 A4 l) ⟺ (B12 ∈ etel B1 (dnf B1 B2) B3 B4 l) $ by wcel_congr [#12, c10]
f4: $ (b11_cnd A10 A11 A9 n → A12 ∈ etel A1 (dnf A1 A2) A3 A4 l) ⟺ (b11_cnd B10 B11 B9 n → B12 ∈ etel B1 (dnf B1 B2) B3 B4 l) $ by im_congr [e4, e5]
f3: $ (∅ ∈ n → b11_cnd A10 A11 A9 n → A12 ∈ etel A1 (dnf A1 A2) A3 A4 l) ⟺ (∅ ∈ n → b11_cnd B10 B11 B9 n → B12 ∈ etel B1 (dnf B1 B2) B3 B4 l) $ by im_congr [e3, f4]
f2: $ (b9_hb A7 A8 A5 l A6 n → ∅ ∈ n → b11_cnd A10 A11 A9 n → A12 ∈ etel A1 (dnf A1 A2) A3 A4 l) ⟺ (b9_hb B7 B8 B5 l B6 n → ∅ ∈ n → b11_cnd B10 B11 B9 n → B12 ∈ etel B1 (dnf B1 B2) B3 B4 l) $ by im_congr [e2, f3]
f1: $ (b9_ag A5 l A6 → b9_hb A7 A8 A5 l A6 n → ∅ ∈ n → b11_cnd A10 A11 A9 n → A12 ∈ etel A1 (dnf A1 A2) A3 A4 l) ⟺ (b9_ag B5 l B6 → b9_hb B7 B8 B5 l B6 n → ∅ ∈ n → b11_cnd B10 B11 B9 n → B12 ∈ etel B1 (dnf B1 B2) B3 B4 l) $ by im_congr [e1, f2]
f0: $ (l ∊ fseq A1 → b9_ag A5 l A6 → b9_hb A7 A8 A5 l A6 n → ∅ ∈ n → b11_cnd A10 A11 A9 n → A12 ∈ etel A1 (dnf A1 A2) A3 A4 l) ⟺ (l ∊ fseq B1 → b9_ag B5 l B6 → b9_hb B7 B8 B5 l B6 n → ∅ ∈ n → b11_cnd B10 B11 B9 n → B12 ∈ etel B1 (dnf B1 B2) B3 B4 l) $ by im_congr [e0, f1]
g1: $ (∀ n (l ∊ fseq A1 → b9_ag A5 l A6 → b9_hb A7 A8 A5 l A6 n → ∅ ∈ n → b11_cnd A10 A11 A9 n → A12 ∈ etel A1 (dnf A1 A2) A3 A4 l)) ⟺ (∀ n (l ∊ fseq B1 → b9_ag B5 l B6 → b9_hb B7 B8 B5 l B6 n → ∅ ∈ n → b11_cnd B10 B11 B9 n → B12 ∈ etel B1 (dnf B1 B2) B3 B4 l)) $ by all_congr [f0]
g2: $ (∀ l ∀ n (l ∊ fseq A1 → b9_ag A5 l A6 → b9_hb A7 A8 A5 l A6 n → ∅ ∈ n → b11_cnd A10 A11 A9 n → A12 ∈ etel A1 (dnf A1 A2) A3 A4 l)) ⟺ (∀ l ∀ n (l ∊ fseq B1 → b9_ag B5 l B6 → b9_hb B7 B8 B5 l B6 n → ∅ ∈ n → b11_cnd B10 B11 B9 n → B12 ∈ etel B1 (dnf B1 B2) B3 B4 l)) $ by all_congr [g1]

--| @rewrite
lemma b11_sh_sb_T {z: set} (t: set z) (A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12: class z): $ [z/t] (b11_sh_T A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12) ⟺ b11_sh_T (⟦ z / t ⟧ A1) (⟦ z / t ⟧ A2) (⟦ z / t ⟧ A3) (⟦ z / t ⟧ A4) (⟦ z / t ⟧ A5) (⟦ z / t ⟧ A6) (⟦ z / t ⟧ A7) (⟦ z / t ⟧ A8) (⟦ z / t ⟧ A9) (⟦ z / t ⟧ A10) (⟦ z / t ⟧ A11) (⟦ z / t ⟧ A12) $
----
l1: $ [z/t] (∀ l ∀ n (l ∊ fseq A1 → b9_ag A5 l A6 → b9_hb A7 A8 A5 l A6 n → ∅ ∈ n → b11_cnd A10 A11 A9 n → A12 ∈ etel A1 (dnf A1 A2) A3 A4 l)) ⟺ ∀ l ∀ n (l ∊ fseq (⟦ z / t ⟧ A1) → b9_ag (⟦ z / t ⟧ A5) l (⟦ z / t ⟧ A6) → b9_hb (⟦ z / t ⟧ A7) (⟦ z / t ⟧ A8) (⟦ z / t ⟧ A5) l (⟦ z / t ⟧ A6) n → ∅ ∈ n → b11_cnd (⟦ z / t ⟧ A10) (⟦ z / t ⟧ A11) (⟦ z / t ⟧ A9) n → (⟦ z / t ⟧ A12) ∈ etel (⟦ z / t ⟧ A1) (dnf (⟦ z / t ⟧ A1) (⟦ z / t ⟧ A2)) (⟦ z / t ⟧ A3) (⟦ z / t ⟧ A4) l) $ by iff_refl

--| (SH) the conclusion: a shape path at `R` with the transfer.
def b11_sh_C (U M T W A R K D X0 X G P: class) (.x1 .x2 .x3 .x4: set): fml = $ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel U (dnf U M) T W R ∧ b11_sh_T U M T W A K D X0 X x2 G P) $

--| @congr
lemma b11_sh_C_congr (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6 A7 B7 A8 B8 A9 B9 A10 B10 A11 B11 A12 B12: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ > $ A6 ≐ B6 $ > $ A7 ≐ B7 $ > $ A8 ≐ B8 $ > $ A9 ≐ B9 $ > $ A10 ≐ B10 $ > $ A11 ≐ B11 $ > $ A12 ≐ B12 $ > $ b11_sh_C A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 ⟺ b11_sh_C B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 B12 $
----
d1: $ dnf A1 A2 ≐ dnf B1 B2 $ by dnf_congr [#1, #2]
d2: $ etel A1 (dnf A1 A2) A3 A4 A6 ≐ etel B1 (dnf B1 B2) B3 B4 B6 $ by etel_congr [#1, d1, #3, #4, #6]
d3: $ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ≐ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ $ by ceqt_refl
d4: $ (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel A1 (dnf A1 A2) A3 A4 A6) ⟺ (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel B1 (dnf B1 B2) B3 B4 B6) $ by wcel_congr [d3, d2]
d5: $ x2 ≐ x2 $ by ceqt_refl
d6: $ b11_sh_T A1 A2 A3 A4 A5 A7 A8 A9 A10 x2 A11 A12 ⟺ b11_sh_T B1 B2 B3 B4 B5 B7 B8 B9 B10 x2 B11 B12 $ by b11_sh_T_congr [#1, #2, #3, #4, #5, #7, #8, #9, #10, d5, #11, #12]
d7: $ (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel A1 (dnf A1 A2) A3 A4 A6 ∧ b11_sh_T A1 A2 A3 A4 A5 A7 A8 A9 A10 x2 A11 A12) ⟺ (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel B1 (dnf B1 B2) B3 B4 B6 ∧ b11_sh_T B1 B2 B3 B4 B5 B7 B8 B9 B10 x2 B11 B12) $ by and_congr [d4, d6]
d8: $ (∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel A1 (dnf A1 A2) A3 A4 A6 ∧ b11_sh_T A1 A2 A3 A4 A5 A7 A8 A9 A10 x2 A11 A12)) ⟺ (∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel B1 (dnf B1 B2) B3 B4 B6 ∧ b11_sh_T B1 B2 B3 B4 B5 B7 B8 B9 B10 x2 B11 B12)) $ by ex_congr [d7]
d9: $ (∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel A1 (dnf A1 A2) A3 A4 A6 ∧ b11_sh_T A1 A2 A3 A4 A5 A7 A8 A9 A10 x2 A11 A12)) ⟺ (∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel B1 (dnf B1 B2) B3 B4 B6 ∧ b11_sh_T B1 B2 B3 B4 B5 B7 B8 B9 B10 x2 B11 B12)) $ by ex_congr [d8]
d10: $ (∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel A1 (dnf A1 A2) A3 A4 A6 ∧ b11_sh_T A1 A2 A3 A4 A5 A7 A8 A9 A10 x2 A11 A12)) ⟺ (∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel B1 (dnf B1 B2) B3 B4 B6 ∧ b11_sh_T B1 B2 B3 B4 B5 B7 B8 B9 B10 x2 B11 B12)) $ by ex_congr [d9]
d11: $ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel A1 (dnf A1 A2) A3 A4 A6 ∧ b11_sh_T A1 A2 A3 A4 A5 A7 A8 A9 A10 x2 A11 A12)) ⟺ (∃ x1 ∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel B1 (dnf B1 B2) B3 B4 B6 ∧ b11_sh_T B1 B2 B3 B4 B5 B7 B8 B9 B10 x2 B11 B12)) $ by ex_congr [d10]

--| @rewrite
lemma b11_sh_sb_C {z: set} (t: set z) (A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12: class z): $ [z/t] (b11_sh_C A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12) ⟺ b11_sh_C (⟦ z / t ⟧ A1) (⟦ z / t ⟧ A2) (⟦ z / t ⟧ A3) (⟦ z / t ⟧ A4) (⟦ z / t ⟧ A5) (⟦ z / t ⟧ A6) (⟦ z / t ⟧ A7) (⟦ z / t ⟧ A8) (⟦ z / t ⟧ A9) (⟦ z / t ⟧ A10) (⟦ z / t ⟧ A11) (⟦ z / t ⟧ A12) $
----
l1: $ [z/t] (∃ x1 ∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel A1 (dnf A1 A2) A3 A4 A6 ∧ b11_sh_T A1 A2 A3 A4 A5 A7 A8 A9 A10 x2 A11 A12)) ⟺ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel (⟦ z / t ⟧ A1) (dnf (⟦ z / t ⟧ A1) (⟦ z / t ⟧ A2)) (⟦ z / t ⟧ A3) (⟦ z / t ⟧ A4) (⟦ z / t ⟧ A6) ∧ b11_sh_T (⟦ z / t ⟧ A1) (⟦ z / t ⟧ A2) (⟦ z / t ⟧ A3) (⟦ z / t ⟧ A4) (⟦ z / t ⟧ A5) (⟦ z / t ⟧ A7) (⟦ z / t ⟧ A8) (⟦ z / t ⟧ A9) (⟦ z / t ⟧ A10) x2 (⟦ z / t ⟧ A11) (⟦ z / t ⟧ A12)) $ by iff_refl

--| (SH) the induction predicate over the constructor type.
def b11_sh_I (U M W J D N Q L K X0 X: class) (.y .c .d .a .b .e .h .m .v: set): class = $ {y | ∀ c ∀ d ∀ a ∀ b ∀ e ∀ h ∀ m ∀ v (ra_cwf D N Q L K c d y ∈ lrel3 J → y ∊ ofsort lsig lopen ks_expr → d ∊ trees ω → a ∊ fseq U → b ∊ fseq U → b9_ag a b (nadd (fv nvf d) (fv nvf Q)) → b9_hs D X0 a b (nadd (fv nvf d) (fv nvf Q)) X → swin a (fv nvf d) (fv nvf Q) = X0 → ⟨ e , ⟨ h , ⟨ m , v ⟩ ⟩ ⟩ ∈ etel U (dnf U M) y W a → b11_sh_C U M y W a b (nadd (fv nvf d) (fv nvf Q)) D X0 X h ⟨ e , ⟨ h , ⟨ m , v ⟩ ⟩ ⟩)} $

lemma b11_sh_Ii {c d a b e h m v: set} (G: hyps) (J M X0 X: class) (uu ww t1 t2 t3 t4 t5 z: set): $ G , ra_cwf t1 t2 t3 t4 t5 c d z ∈ lrel3 J , z ∊ ofsort lsig lopen ks_expr , d ∊ trees ω , a ∊ fseq uu , b ∊ fseq uu , b9_ag a b (nadd (fv nvf d) (fv nvf t3)) , b9_hs t1 X0 a b (nadd (fv nvf d) (fv nvf t3)) X , swin a (fv nvf d) (fv nvf t3) = X0 , ⟨ e , ⟨ h , ⟨ m , v ⟩ ⟩ ⟩ ∈ etel uu (dnf uu M) z ww a ⇒ b11_sh_C uu M z ww a b (nadd (fv nvf d) (fv nvf t3)) t1 X0 X h ⟨ e , ⟨ h , ⟨ m , v ⟩ ⟩ ⟩ $ > $ G ⇒ z ∊ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X $
----
