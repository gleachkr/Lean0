e5: $ G , ∃ x ∃ y (a = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors) ⇒ ∃ x ∃ y (a = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors) $ by ax
e6: $ G , ∃ x ∃ y (a = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors) ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by ex_elim [e5, e4]
g1: $ G ⇒ a = ⟨ kc_cnil , ∅ ⟩ ∨ ∃ x ∃ y (a = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors) $ by ofsort_ctors_cases [#1]
g2: $ G ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by or_elim [g1, n12, e6]

lemma b3_nctor_step {x i: set} (G: hyps) (a b k: set): $ G ⇒ a ∊ ofsort lsig lopen ks_ctors $ > $ G ⇒ ra_nth_ctor a b k ∈ lrel $ > $ G ⇒ ∀ x ∀ i (x ∊ ofsort lsig lopen ks_ctors → ra_nth_ctor x i k ∈ lrel → suc (fv nvf i) = fv nvf b → k ∊ ofsort lsig lopen ks_expr) $ > $ G ⇒ k ∊ ofsort lsig lopen ks_expr $
----
p1: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y $ by ax
p2: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ $ by and_elim_l [p1]
p3: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y $ by and_elim_r [p1]
p5: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ k = y $ by and_elim_r [p3]
p7: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ a ∊ ofsort lsig lopen ks_ctors $ by weaken [#1]
p8: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ y ∊ ofsort lsig lopen ks_expr ∧ u ∊ ofsort lsig lopen ks_ctors $ by b3_ctors_ccons [p7, p2]
p9: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ y ∊ ofsort lsig lopen ks_expr $ by and_elim_l [p8]
p12: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ y = k $ by eq_sym [p5]
p16: $ G , a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y ⇒ k ∊ ofsort lsig lopen ks_expr $ by welc_eq_set [p12, p9]
q1: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel $ by ax
q2: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ $ by and_elim_l [q1]
q3: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel $ by and_elim_r [q1]
q4: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ b = ⟨ kc_s , scons o ∅ ⟩ $ by and_elim_l [q3]
q5: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ k = y ∧ ra_nth_ctor u o y ∈ lrel $ by and_elim_r [q3]
q6: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ k = y $ by and_elim_l [q5]
q9: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ ra_nth_ctor u o y ∈ lrel $ by and_elim_r [q5]
q10: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ a ∊ ofsort lsig lopen ks_ctors $ by weaken [#1]
q11: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ l ∊ ofsort lsig lopen ks_expr ∧ u ∊ ofsort lsig lopen ks_ctors $ by b3_ctors_ccons [q10, q2]
q13: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ u ∊ ofsort lsig lopen ks_ctors $ by and_elim_r [q11]
q14: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ u = u $ by eq_refl
q15: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ o = o $ by eq_refl
q16: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ y = k $ by eq_sym [q6]
q18: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ ra_nth_ctor u o y = ra_nth_ctor u o k $ by ra_nth_ctor_eq [q14, q15, q16]
q19: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ ra_nth_ctor u o k ∈ lrel $ by wcel_eq_l [q18, q9]
q20: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ kr_nth_ctor ∈ ω $ by kr_nth_ctor_omega
q21: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ isset kr_nth_ctor $ by wcel_isset [q20]
q22: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ u ∊ trees ω ∧ o ∊ trees ω ∧ y ∊ trees ω $ by lrel_args3 [q9, q21]
q23: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ o ∊ trees ω ∧ y ∊ trees ω $ by and_elim_r [q22]
q24: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ o ∊ trees ω $ by and_elim_l [q23]
q25: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ o ∈ trees ω $ by welc_wcel [q24]
q26: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ nvf = nvf $ by eq_refl
q27: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ fv nvf b = fv nvf ⟨ kc_s , scons o ∅ ⟩ $ by fv_eq [q26, q4]
q28: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ fv nvf ⟨ kc_s , scons o ∅ ⟩ = suc (fv nvf o) $ by nvf_s [q25]
q29: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ fv nvf b = suc (fv nvf o) $ by eq_trans [q27, q28]
q30: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ suc (fv nvf o) = fv nvf b $ by eq_sym [q29]
q31: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ ∀ x ∀ i (x ∊ ofsort lsig lopen ks_ctors → ra_nth_ctor x i k ∈ lrel → suc (fv nvf i) = fv nvf b → k ∊ ofsort lsig lopen ks_expr) $ by weaken [#3]
q32: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ ∀ i (u ∊ ofsort lsig lopen ks_ctors → ra_nth_ctor u i k ∈ lrel → suc (fv nvf i) = fv nvf b → k ∊ ofsort lsig lopen ks_expr) $ by all_elim [q31]
q33: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ u ∊ ofsort lsig lopen ks_ctors → ra_nth_ctor u o k ∈ lrel → suc (fv nvf o) = fv nvf b → k ∊ ofsort lsig lopen ks_expr $ by all_elim [q32]
q34: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ ra_nth_ctor u o k ∈ lrel → suc (fv nvf o) = fv nvf b → k ∊ ofsort lsig lopen ks_expr $ by imp_elim [q33, q13]
q35: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ suc (fv nvf o) = fv nvf b → k ∊ ofsort lsig lopen ks_expr $ by imp_elim [q34, q19]
q36: $ G , a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel ⇒ k ∊ ofsort lsig lopen ks_expr $ by imp_elim [q35, q30]
r3: $ G , ∃ u (a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y) ⇒ ∃ u (a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y) $ by ax
r4: $ G , ∃ u (a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y) ⇒ k ∊ ofsort lsig lopen ks_expr $ by ex_elim [r3, p16]
r5: $ G , ∃ y ∃ u (a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y) ⇒ ∃ y ∃ u (a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y) $ by ax
r6: $ G , ∃ y ∃ u (a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y) ⇒ k ∊ ofsort lsig lopen ks_expr $ by ex_elim [r5, r4]
s1: $ G , ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) ⇒ ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) $ by ax
s2: $ G , ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) ⇒ k ∊ ofsort lsig lopen ks_expr $ by ex_elim [s1, q36]
s3: $ G , ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) ⇒ ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) $ by ax
s4: $ G , ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) ⇒ k ∊ ofsort lsig lopen ks_expr $ by ex_elim [s3, s2]
s5: $ G , ∃ l ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) ⇒ ∃ l ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) $ by ax
s6: $ G , ∃ l ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) ⇒ k ∊ ofsort lsig lopen ks_expr $ by ex_elim [s5, s4]
s11: $ G , ∃ y ∃ l ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) ⇒ ∃ y ∃ l ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) $ by ax
s12: $ G , ∃ y ∃ l ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) ⇒ k ∊ ofsort lsig lopen ks_expr $ by ex_elim [s11, s6]
t1: $ G ⇒ ∃ y ∃ u (a = ⟨ kc_ccons , scons y (scons u ∅) ⟩ ∧ b = ⟨ kc_nz , ∅ ⟩ ∧ k = y) ∨ ∃ y ∃ l ∃ u ∃ o (a = ⟨ kc_ccons , scons l (scons u ∅) ⟩ ∧ b = ⟨ kc_s , scons o ∅ ⟩ ∧ k = y ∧ ra_nth_ctor u o y ∈ lrel) $ by lrel_nth_ctor_cases [#2]
t2: $ G ⇒ k ∊ ofsort lsig lopen ks_expr $ by or_elim [t1, r6, s12]

lemma b3_nctor_sort (G: hyps) (t j k: set): $ G ⇒ t ∊ ofsort lsig lopen ks_ctors $ > $ G ⇒ ra_nth_ctor t j k ∈ lrel $ > $ G ⇒ k ∊ ofsort lsig lopen ks_expr $
----
m0: $ G ⇒ isset j $ by isset_var
m1: $ G ⇒ fv nvf j ∈ ω $ by nvf_omega [m0]
z1: $ G , m = fv nvf j , m ∊ ω , z = ∅ , a ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor a b k ∈ lrel , fv nvf b = z , x ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor x i k ∈ lrel , suc (fv nvf i) = fv nvf b ⇒ suc (fv nvf i) = fv nvf b $ by ax
z2: $ G , m = fv nvf j , m ∊ ω , z = ∅ , a ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor a b k ∈ lrel , fv nvf b = z , x ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor x i k ∈ lrel , suc (fv nvf i) = fv nvf b ⇒ fv nvf b = z $ by ax
z3: $ G , m = fv nvf j , m ∊ ω , z = ∅ , a ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor a b k ∈ lrel , fv nvf b = z , x ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor x i k ∈ lrel , suc (fv nvf i) = fv nvf b ⇒ z = ∅ $ by ax
z4: $ G , m = fv nvf j , m ∊ ω , z = ∅ , a ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor a b k ∈ lrel , fv nvf b = z , x ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor x i k ∈ lrel , suc (fv nvf i) = fv nvf b ⇒ suc (fv nvf i) = z $ by eq_trans [z1, z2]
z5: $ G , m = fv nvf j , m ∊ ω , z = ∅ , a ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor a b k ∈ lrel , fv nvf b = z , x ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor x i k ∈ lrel , suc (fv nvf i) = fv nvf b ⇒ suc (fv nvf i) = ∅ $ by eq_trans [z4, z3]
z6: $ G , m = fv nvf j , m ∊ ω , z = ∅ , a ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor a b k ∈ lrel , fv nvf b = z , x ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor x i k ∈ lrel , suc (fv nvf i) = fv nvf b ⇒ ⊥ $ by suc_ne_empty [z5]
z7: $ G , m = fv nvf j , m ∊ ω , z = ∅ , a ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor a b k ∈ lrel , fv nvf b = z , x ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor x i k ∈ lrel , suc (fv nvf i) = fv nvf b ⇒ k ∊ ofsort lsig lopen ks_expr $ by bot_elim [z6]
z8: $ G , m = fv nvf j , m ∊ ω , z = ∅ , a ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor a b k ∈ lrel , fv nvf b = z , x ∊ ofsort lsig lopen ks_ctors , ra_nth_ctor x i k ∈ lrel ⇒ suc (fv nvf i) = fv nvf b → k ∊ ofsort lsig lopen ks_expr $ by imp_intro [z7]
