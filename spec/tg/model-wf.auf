lemma b5_lift_etel (G: hyps) (M: class) (u w t1 t2 t3 t4 p q s: set): $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = fv nvf t2 $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ cdm q = fv nvf t1 $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ etel u (dnf u M) t4 w (scat p (scat q s)) = etel u (dnf u M) t3 w (scat p s) $
----
c5: $ G ⇒ trees ω ⊆ b5_lp u M w t1 q s $ by b5_lift_ind [#2, #5, #6, #7]
c6: $ G ⇒ kr_lift ∈ ω $ by kr_lift_omega
c7: $ G ⇒ isset kr_lift $ by wcel_isset [c6]
c9: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by lrel_args4 [#1, c7]
c10: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [c9]
c11: $ G ⇒ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [c10]
c12: $ G ⇒ t3 ∊ trees ω $ by and_elim_l [c11]
c13: $ G ⇒ t3 ∊ b5_lp u M w t1 q s $ by subset_elim [c5, c12]
c14: $ G ⇒ t3 ∈ b5_lp u M w t1 q s $ by welc_wcel [c13]
c16: $ G ⇒ p ∈ fseq u $ by welc_wcel [#3]
cq: $ G ⇒ q ∈ fseq u $ by welc_wcel [#5]
cs: $ G ⇒ s ∈ fseq u $ by welc_wcel [#7]
cqs: $ G ⇒ scat q s ∈ fseq u $ by scat_fseq_c [cq, cs]
c18: $ G ⇒ scat p (scat q s) ∈ fseq u $ by scat_fseq_c [c16, cqs]
c19: $ G ⇒ isset (scat p (scat q s)) $ by wcel_isset [c18]
c20: $ G ⇒ scat p (scat q s) = scat p (scat q s) $ by eq_refl
c21: $ G ⇒ scat p s ∈ fseq u $ by scat_fseq_c [c16, cs]
c22: $ G ⇒ isset (scat p s) $ by wcel_isset [c21]
c23: $ G ⇒ scat p s = scat p s $ by eq_refl
c24: $ G ⇒ etel u (dnf u M) t4 w (scat p (scat q s)) = etel u (dnf u M) t3 w (scat p s) $ by b5_ih [c14, #1, c16, #4, c19, c20, c22, c23]

--| The trees `x` whose derivable `inst k x q e` give `e` at `p ++ s` the paths
--| of `x` at `p ++ v :: s`, `v` the value of `q` at `s`.
def b5_ip (U M W A S: class) (.x .k .e .p .r .o: set): class = $ {x | ∀ k ∀ e ∀ p ∀ r ∀ o (ra_inst k x A e ∈ lrel → p ∊ fseq U → cdm p = fv nvf k → r = scat p S → o = scat p (scons (dt U M A W S) S) → etel U (dnf U M) e W r = etel U (dnf U M) x W o)} $

lemma b5_iih (G: hyps) (M: class) (u w q s t h f: set) (P R O: class): $ G ⇒ t ∈ b5_ip u M w q s $ > $ G ⇒ ra_inst h t q f ∈ lrel $ > $ G ⇒ P ∈ fseq u $ > $ G ⇒ cdm P = fv nvf h $ > $ G ⇒ isset R $ > $ G ⇒ R = scat P s $ > $ G ⇒ isset O $ > $ G ⇒ O = scat P (scons (dt u M q w s) s) $ > $ G ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w O $
----
i1: $ G ⇒ t ∊ b5_ip u M w q s $ by wcel_welc [#1]
i2: $ G ⇒ ∀ k ∀ e ∀ p ∀ r ∀ o (ra_inst k t q e ∈ lrel → p ∊ fseq u → cdm p = fv nvf k → r = scat p s → o = scat p (scons (dt u M q w s) s) → etel u (dnf u M) e w r = etel u (dnf u M) t w o) $ by cab_elim [i1]
i3: $ G ⇒ ∀ e ∀ p ∀ r ∀ o (ra_inst h t q e ∈ lrel → p ∊ fseq u → cdm p = fv nvf h → r = scat p s → o = scat p (scons (dt u M q w s) s) → etel u (dnf u M) e w r = etel u (dnf u M) t w o) $ by all_elim [i2]
i4: $ G ⇒ ∀ p ∀ r ∀ o (ra_inst h t q f ∈ lrel → p ∊ fseq u → cdm p = fv nvf h → r = scat p s → o = scat p (scons (dt u M q w s) s) → etel u (dnf u M) f w r = etel u (dnf u M) t w o) $ by all_elim [i3]
j1: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ∀ p ∀ r ∀ o (ra_inst h t q f ∈ lrel → p ∊ fseq u → cdm p = fv nvf h → r = scat p s → o = scat p (scons (dt u M q w s) s) → etel u (dnf u M) f w r = etel u (dnf u M) t w o) $ by weaken [i4]
j2: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ∀ r ∀ o (ra_inst h t q f ∈ lrel → v ∊ fseq u → cdm v = fv nvf h → r = scat v s → o = scat v (scons (dt u M q w s) s) → etel u (dnf u M) f w r = etel u (dnf u M) t w o) $ by all_elim [j1]
j3: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ∀ o (ra_inst h t q f ∈ lrel → v ∊ fseq u → cdm v = fv nvf h → x0 = scat v s → o = scat v (scons (dt u M q w s) s) → etel u (dnf u M) f w x0 = etel u (dnf u M) t w o) $ by all_elim [j2]
j4: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ra_inst h t q f ∈ lrel → v ∊ fseq u → cdm v = fv nvf h → x0 = scat v s → x1 = scat v (scons (dt u M q w s) s) → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by all_elim [j3]
j5: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ ra_inst h t q f ∈ lrel $ by weaken [#2]
j6: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ v ∊ fseq u → cdm v = fv nvf h → x0 = scat v s → x1 = scat v (scons (dt u M q w s) s) → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j4, j5]
j7: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ v ∊ fseq u $ by ax
j8: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm v = fv nvf h → x0 = scat v s → x1 = scat v (scons (dt u M q w s) s) → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j6, j7]
k1: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ v = P $ by ax
k2: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm v = cdm P $ by cdm_eq [k1]
k3: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm P = fv nvf h $ by weaken [#4]
k4: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ cdm v = fv nvf h $ by eq_trans [k2, k3]
j9: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = scat v s → x1 = scat v (scons (dt u M q w s) s) → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j8, k4]
k5: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ P = v $ by eq_sym [k1]
k6: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ s = s $ by eq_refl
k7: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ scat P s = scat v s $ by scat_eq [k5, k6]
k8: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = R $ by ax
k9: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ R = scat P s $ by weaken [#6]
k10: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = scat P s $ by eq_trans [k8, k9]
k11: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x0 = scat v s $ by eq_trans [k10, k7]
j10: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = scat v (scons (dt u M q w s) s) → etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j9, k11]
k12: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ scons (dt u M q w s) s = scons (dt u M q w s) s $ by eq_refl
k13: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ scat P (scons (dt u M q w s) s) = scat v (scons (dt u M q w s) s) $ by scat_eq [k5, k12]
k14: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = O $ by ax
k15: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ O = scat P (scons (dt u M q w s) s) $ by weaken [#8]
k16: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = scat P (scons (dt u M q w s) s) $ by eq_trans [k14, k15]
k17: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ x1 = scat v (scons (dt u M q w s) s) $ by eq_trans [k16, k13]
j11: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) f w x0 = etel u (dnf u M) t w x1 $ by imp_elim [j10, k17]
m3: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ f = f $ by eq_refl
m4: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ w = w $ by eq_refl
m5: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ t = t $ by eq_refl
m6: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ R = x0 $ by eq_sym [k8]
m7: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) f w R = etel u (dnf u M) f w x0 $ by etel_eq [m3, m4, m6]
m8: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) t w x1 = etel u (dnf u M) t w O $ by etel_eq [m5, m4, k14]
m9: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w x1 $ by eq_trans [m7, j11]
m10: $ G , v = P , v ∊ fseq u , x0 = R , x1 = O ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w O $ by eq_trans [m9, m8]
n1: $ G , v = P , v ∊ fseq u , x0 = R ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w O $ by isset_elim [#7, m10]
n2: $ G , v = P , v ∊ fseq u ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w O $ by isset_elim [#5, n1]
n3: $ G ⇒ etel u (dnf u M) f w R = etel u (dnf u M) t w O $ by wcel_elim [#3, n2]

lemma b5_ki_oth (H: hyps) (M K S S2: class) (u w q s k z e p r o: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ dt u M q w s ∈ u $ > $ H ⇒ ra_inst k z q e ∈ lrel $ > $ H ⇒ p ∊ fseq u $ > $ H ⇒ r = scat p s $ > $ H ⇒ o = scat p (scons (dt u M q w s) s) $ > $ H ⇒ z = ⟨ K , S ⟩ $ > $ H ⇒ e = ⟨ K , S2 ⟩ $ > $ H ⇒ ¬ K = kc_pi $ > $ H ⇒ ¬ K = kc_app $ > $ H ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $
----
tk0: $ H ⇒ kr_inst ∈ ω $ by kr_inst_omega
tk: $ H ⇒ isset kr_inst $ by wcel_isset [tk0]
t0: $ H ⇒ k ∊ trees ω ∧ z ∊ trees ω ∧ q ∊ trees ω ∧ e ∊ trees ω $ by lrel_args4 [#4, tk]
ta: $ H ⇒ k ∊ trees ω $ by and_elim_l [t0]
t1: $ H ⇒ z ∊ trees ω ∧ q ∊ trees ω ∧ e ∊ trees ω $ by and_elim_r [t0]
tb: $ H ⇒ z ∊ trees ω $ by and_elim_l [t1]
t2: $ H ⇒ q ∊ trees ω ∧ e ∊ trees ω $ by and_elim_r [t1]
tc: $ H ⇒ q ∊ trees ω $ by and_elim_l [t2]
td: $ H ⇒ e ∊ trees ω $ by and_elim_r [t2]
tTa: $ H ⇒ k ∈ trees ω $ by welc_wcel [ta]
tTb: $ H ⇒ z ∈ trees ω $ by welc_wcel [tb]
tTc: $ H ⇒ q ∈ trees ω $ by welc_wcel [tc]
tTd: $ H ⇒ e ∈ trees ω $ by welc_wcel [td]
a2: $ H ⇒ s ∈ fseq u $ by welc_wcel [#2]
a3: $ H ⇒ scons (dt u M q w s) s ∈ fseq u $ by scons_fseq_c [#3, a2]
rv: $ H ⇒ r ∊ fseq u $ by b5_val [#5, a2, #6]
ov: $ H ⇒ o ∊ fseq u $ by b5_val [#5, a3, #7]
fin: $ H ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by b5_oth [tb, td, #8, #9, #10, #11, #1, rv, ov]

lemma b5_ki_bvlt (H: hyps) (M: class) (u w q s k z e p r o c j x0 x2 x6: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ dt u M q w s ∈ u $ > $ H ⇒ etel u (dnf u M) q w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ > $ H ⇒ crn j ⊆ b5_ip u M w q s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_inst k z q e ∈ lrel $ > $ H ⇒ p ∊ fseq u $ > $ H ⇒ cdm p = fv nvf k $ > $ H ⇒ r = scat p s $ > $ H ⇒ o = scat p (scons (dt u M q w s) s) $ > $ H ⇒ (k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $
----
f1: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ w ∊ lvals $ by weaken [#1]
f2: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ s ∊ fseq u $ by weaken [#2]
f3: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ dt u M q w s ∈ u $ by weaken [#3]
f4: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ etel u (dnf u M) q w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by weaken [#4]
f5: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ crn j ⊆ b5_ip u M w q s $ by weaken [#5]
f6: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ z = ⟨ c , j ⟩ $ by weaken [#6]
f7: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ ra_inst k z q e ∈ lrel $ by weaken [#7]
f8: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ p ∊ fseq u $ by weaken [#8]
f9: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ cdm p = fv nvf k $ by weaken [#9]
f10: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ r = scat p s $ by weaken [#10]
f11: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ o = scat p (scons (dt u M q w s) s) $ by weaken [#11]
p0: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel $ by ax
q1: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ k = x0 $ by and_elim_l [p0]
qr1: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel $ by and_elim_r [p0]
q2: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ z = ⟨ kc_bvar , scons x2 ∅ ⟩ $ by and_elim_l [qr1]
qr2: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel $ by and_elim_r [qr1]
q3: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ q = x6 $ by and_elim_l [qr2]
qr3: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel $ by and_elim_r [qr2]
q4: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ e = ⟨ kc_bvar , scons x2 ∅ ⟩ $ by and_elim_l [qr3]
