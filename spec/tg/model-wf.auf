a2: $ … ⇒ D = o $ by eq_sym [a1]
r1: $ G , o = D ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
r2: $ G , o = D ⇒ t2 = t2 $ by eq_refl
r3: $ G , o = D ⇒ t12 = t12 $ by eq_refl
r4: $ G , o = D ⇒ t10 = t10 $ by eq_refl
