lemma b3_tys_tail (G: hyps) (J: class) (dd nv np lv iv cx bb y1 y2 y3: set): $ G ⇒ ra_tys_wf dd nv np lv iv cx bb ∈ lrel3 J $ > $ G ⇒ bb = ⟨ kc_tcons , scons y1 (scons y2 (scons y3 ∅)) ⟩ $ > $ G ⇒ ra_tys_wf dd nv np lv ⟨ kc_s , scons iv ∅ ⟩ cx y3 ∈ lrel3 J $
----
n0: $ G , dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tnil , ∅ ⟩ ⇒ dd = u ∧ nv = v ∧ np = w ∧ lv = y ∧ iv = r ∧ cx = x0 ∧ bb = ⟨ kc_tnil , ∅ ⟩ $ by ax
