q36: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by ax
q37: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_lam , scons x (scons y ∅) ⟩ $ by and_elim_l [q36]
q38: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by and_elim_r [q36]
q39: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr $ by and_elim_l [q38]
q40: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ y ∊ ofsort lsig lopen ks_expr $ by and_elim_r [q38]
q41: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_lam , scons a (scons b ∅) ⟩ $ by weaken [#2]
q42: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ kc_lam ∈ ω $ by kc_lam_omega
q43: $ H , z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr ⇒ x = a ∧ y = b $ by b6_ninj2 [q37, q41, q42]
