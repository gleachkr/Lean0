q144: $ G , ∃ d ∃ e ∃ f ∃ g (z = ⟨ kc_cons , scons d (scons g ∅) ⟩ ∧ t2 = e ∧ t3 = f ∧ ra_pis g ⟨ kc_pi , scons d (scons e ∅) ⟩ f ∈ lrel) ⇒ ∃ d ∃ e ∃ f ∃ g (z = ⟨ kc_cons , scons d (scons g ∅) ⟩ ∧ t2 = e ∧ t3 = f ∧ ra_pis g ⟨ kc_pi , scons d (scons e ∅) ⟩ f ∈ lrel) $ by ax
q145: $ G , ∃ d ∃ e ∃ f ∃ g (z = ⟨ kc_cons , scons d (scons g ∅) ⟩ ∧ t2 = e ∧ t3 = f ∧ ra_pis g ⟨ kc_pi , scons d (scons e ∅) ⟩ f ∈ lrel) ⇒ t3 = t4 $ by ex_elim [q144, q143]
q146: $ G ⇒ t3 = t4 $ by or_elim [q1, q45, q145]

lemma b6_pis_det (G: hyps) (t1 t2 t3 t4: set): $ G ⇒ ra_pis t1 t2 t3 ∈ lrel $ > $ G ⇒ ra_pis t1 t2 t4 ∈ lrel $ > $ G ⇒ t3 = t4 $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_pis z b e ∈ lrel ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_pis z b e ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_pis z b e ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_pis z b e ∈ lrel ⇒ crn j ⊆ b6_cpd $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_pis z b e ∈ lrel ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_pis z b e ∈ lrel ⇒ ra_pis z b c ∈ lrel $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_pis z b e ∈ lrel ⇒ ra_pis z b e ∈ lrel $ by ax
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_pis z b e ∈ lrel ⇒ c = e $ by b6_pd_st [q4, q3, q5, q6, q7]
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ ra_pis z b e ∈ lrel → c = e $ by imp_intro [q8]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ ⇒ ra_pis z b c ∈ lrel → ra_pis z b e ∈ lrel → c = e $ by imp_intro [q9]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ ⇒ ∀ e (ra_pis z b c ∈ lrel → ra_pis z b e ∈ lrel → c = e) $ by all_intro [q10]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ ⇒ ∀ c ∀ e (ra_pis z b c ∈ lrel → ra_pis z b e ∈ lrel → c = e) $ by all_intro [q11]
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ ⇒ ∀ b ∀ c ∀ e (ra_pis z b c ∈ lrel → ra_pis z b e ∈ lrel → c = e) $ by all_intro [q12]
q14: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ ⇒ z ∊ b6_cpd $ by cab_intro [q13]
q15: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
q16: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b6_cpd $ by wcel_intro [q15, q14]
q17: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd ⇒ isset ⟨ k , j ⟩ $ by opair_isset
q18: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpd ⇒ ⟨ k , j ⟩ ∈ b6_cpd $ by isset_elim [q17, q16]
q19: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b6_cpd → ⟨ k , j ⟩ ∈ b6_cpd $ by imp_intro [q18]
q20: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b6_cpd → ⟨ k , j ⟩ ∈ b6_cpd $ by imp_intro [q19]
q21: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpd → ⟨ k , j ⟩ ∈ b6_cpd $ by imp_intro [q20]
q22: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpd → ⟨ k , j ⟩ ∈ b6_cpd) $ by all_intro [q21]
q23: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpd → ⟨ k , j ⟩ ∈ b6_cpd) $ by all_intro [q22]
q24: $ G ⇒ isset ω $ by omega_set
q25: $ G ⇒ trees ω ⊆ b6_cpd $ by trees_ind_c [q24, q23]
q26: $ G ⇒ kr_pis ∈ ω $ by kr_pis_omega
q27: $ G ⇒ isset kr_pis $ by wcel_isset [q26]
q28: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, q27]
q29: $ G ⇒ t1 ∊ trees ω $ by and_elim_l [q28]
q30: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by and_elim_r [q28]
q31: $ G ⇒ t2 ∊ trees ω $ by and_elim_l [q30]
q32: $ G ⇒ t3 ∊ trees ω $ by and_elim_r [q30]
q33: $ G ⇒ t1 ∊ b6_cpd $ by subset_elim [q25, q29]
q34: $ G ⇒ ∀ b ∀ c ∀ e (ra_pis t1 b c ∈ lrel → ra_pis t1 b e ∈ lrel → c = e) $ by cab_elim [q33]
q35: $ G ⇒ ∀ c ∀ e (ra_pis t1 t2 c ∈ lrel → ra_pis t1 t2 e ∈ lrel → c = e) $ by all_elim [q34]
q36: $ G ⇒ ∀ e (ra_pis t1 t2 t3 ∈ lrel → ra_pis t1 t2 e ∈ lrel → t3 = e) $ by all_elim [q35]
q37: $ G ⇒ ra_pis t1 t2 t3 ∈ lrel → ra_pis t1 t2 t4 ∈ lrel → t3 = t4 $ by all_elim [q36]
q38: $ G ⇒ ra_pis t1 t2 t4 ∈ lrel → t3 = t4 $ by imp_elim [q37, #1]
q39: $ G ⇒ t3 = t4 $ by imp_elim [q38, #2]

def b6_ctc (P: class) (.y .x6 .x7 .x8 .x9: set): class = $ {y | ∀ x6 ∀ x7 ∀ x8 ∀ x9 (ra_tys_closed P y ∈ lrel → ra_nth_ty y x6 x7 x8 ∈ lrel → ra_pis P x7 x9 ∈ lrel → ra_closed ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel)} $

lemma b6_tc_st (G: hyps) (t0 z k s t2 t3 t4 t5: set): $ G ⇒ crn s ⊆ b6_ctc t0 $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_tys_closed t0 z ∈ lrel $ > $ G ⇒ ra_nth_ty z t2 t3 t4 ∈ lrel $ > $ G ⇒ ra_pis t0 t3 t5 ∈ lrel $ > $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $
----
q1: $ G ⇒ ∃ d ∃ e ∃ f (z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e) ∨ ∃ d ∃ g ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) $ by lrel_nth_ty_cases [#5]
q2: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e $ by ax
q3: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ $ by and_elim_l [q2]
q4: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e $ by and_elim_r [q2]
q5: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [q4]
q6: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ t3 = d ∧ t4 = e $ by and_elim_r [q4]
q7: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ t3 = d $ by and_elim_l [q6]
q8: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ t4 = e $ by and_elim_r [q6]
q9: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ ra_tys_closed t0 z ∈ lrel $ by weaken [#4]
q10: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e ⇒ ∃ x1 (t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel) $ by lrel_tys_closed_cases [q9]
q11: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ $ by ax
q12: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t0 = x1 $ by and_elim_l [q11]
q13: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ z = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [q11]
q14: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ $ by weaken [q3]
q15: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
q16: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
q17: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ ¬ kc_tnil = kc_tcons $ by kc_tnil_ne_tcons
q18: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $ by b6_clash [q13, q14, q17, q15, q16]
q19: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , ∃ x1 (t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩) ⇒ ∃ x1 (t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩) $ by ax
q20: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , ∃ x1 (t0 = x1 ∧ z = ⟨ kc_tnil , ∅ ⟩) ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $ by ex_elim [q19, q18]
q21: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel $ by ax
q22: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ t0 = x1 $ by and_elim_l [q21]
q23: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel $ by and_elim_r [q21]
q24: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ $ by and_elim_l [q23]
q25: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel $ by and_elim_r [q23]
q26: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ ra_pis x1 x2 x3 ∈ lrel $ by and_elim_l [q25]
q27: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel $ by and_elim_r [q25]
q28: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel $ by and_elim_l [q27]
q29: $ G , z = ⟨ kc_tcons , scons d (scons e (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = d ∧ t4 = e , t0 = x1 ∧ z = ⟨ kc_tcons , scons x2 (scons x4 (scons x5 ∅)) ⟩ ∧ ra_pis x1 x2 x3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ x3 ∈ lrel ∧ ra_tys_closed x1 x5 ∈ lrel ⇒ ra_tys_closed x1 x5 ∈ lrel $ by and_elim_r [q27]
