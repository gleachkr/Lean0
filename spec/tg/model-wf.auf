cons x3 (scons h ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons e (scons x3 (scons i ∅)) ⟩ ∧ ra_lift x1 x2 h i ∈ lrel) ⇒ (z ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by weaken [q552]
