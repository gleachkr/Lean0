s28: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X → ⟨ k , j ⟩ ∈ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X $ by imp_intro [s27]
s29: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X → ⟨ k , j ⟩ ∈ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X $ by imp_intro [s28]
s30: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X → ⟨ k , j ⟩ ∈ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X $ by imp_intro [s29]
s31: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X → ⟨ k , j ⟩ ∈ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X) $ by all_intro [s30]
s32: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X → ⟨ k , j ⟩ ∈ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X) $ by all_intro [s31]
s33: $ G ⇒ isset ω $ by omega_set
s34: $ G ⇒ trees ω ⊆ b11_sh_I uu M ww J t1 t2 t3 t4 t5 X0 X $ by trees_ind_c [s33, s32]

--| (SH) A path of a constructor type at the world `a` has a shape path at the shape
--| world `r`, and it is a path at every world `l` that has `a`'s entries at the elements
--| of `n`, if `n` has the fibers of its fields at the shape's points.
lemma b11_sh {x1 x2 x3 x4 l n: set} (G: hyps) (J M X0 X: class) (u w a r t1 t2 t3 t4 t5 t6 t7 t8 f g h e: set): $ G ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel3 J $ > $ G ⇒ t7 ∊ trees ω $ > $ G ⇒ t8 ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ uadm u $ > $ G ⇒ t1 ∊ trees ω $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ b9_ag a r (nadd (fv nvf t7) (fv nvf t3)) $ > $ G ⇒ b9_hs t1 X0 a r (nadd (fv nvf t7) (fv nvf t3)) X $ > $ G ⇒ swin a (fv nvf t7) (fv nvf t3) = X0 $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ h , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w a $ > $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r ∧ ∀ l ∀ n (l ∊ fseq u → b9_ag a l (nadd (fv nvf t7) (fv nvf t3)) → b9_hb t1 X0 a l (nadd (fv nvf t7) (fv nvf t3)) n → ∅ ∈ n → b11_cnd x2 g X n → ⟨ f , ⟨ g , ⟨ h , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w l)) $
----
a1: $ … ⇒ trees ω ⊆ b11_sh_I u M w J t1 t2 t3 t4 t5 X0 X $ by b11_sh_all [#5, #4, #6]
a2: $ G ⇒ sig lsig lopen $ by lsig_sig
a3: $ … ⇒ ofsort lsig lopen ks_expr ⊆ trees ω $ by ofsort_trees [a2]
a4: $ … ⇒ t8 ∊ trees ω $ by subset_elim [a3, #3]
a5: $ … ⇒ t8 ∊ b11_sh_I u M w J t1 t2 t3 t4 t5 X0 X $ by subset_elim [a1, a4]
a6: $ … ⇒ b11_sh_C u M t8 w a r (nadd (fv nvf t7) (fv nvf t3)) t1 X0 X g ⟨ f , ⟨ g , ⟨ h , e ⟩ ⟩ ⟩ $ by b11_sh_Ie [a5, #1, #3, #2, #7, #8, #9, #10, #11, #12]
a7: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r ∧ ∀ l ∀ n (l ∊ fseq u → b9_ag a l (nadd (fv nvf t7) (fv nvf t3)) → b9_hb t1 X0 a l (nadd (fv nvf t7) (fv nvf t3)) n → ∅ ∈ n → b11_cnd x2 g X n → ⟨ f , ⟨ g , ⟨ h , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w l)) $ by weaken [a6]

--| The entries' sequence at a set of the universe.
lemma b11_tp_ixs (G: hyps) (D W Z S0: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ S0 ∈ u $ > $ G ⇒ ixs D W (isup Z S0) ∈ fseq u $
----
u1: $ … ⇒ universe u $ by uadm_universe [#1]
s1: $ … ⇒ S0 ⊆ u $ by universe_elem_subset_c [u1, #4]
i1: $ … ⇒ isup Z S0 ∈ u $ by isup_universe [u1, #2, #4]
i2: $ … ⇒ isup Z S0 ⊆ ω × (fseq u × u) $ by b7_isup_sub2 [#3, s1]
e1: $ … ⇒ ient D W (isup Z S0) x5 ∈ u $ by b7_ient_universe [u1, i1, i2]
e2: $ G , x5 ∊ intys D ⇒ ient D W (isup Z S0) x5 ∈ u $ by weaken [e1]
e3: $ G ⇒ x5 ∊ intys D → ient D W (isup Z S0) x5 ∈ u $ by imp_intro [e2]
e4: $ G ⇒ ∀ x5 (x5 ∊ intys D → ient D W (isup Z S0) x5 ∈ u) $ by all_intro [e3]
e5: $ G ⇒ intys D ∈ ω $ by intys_omega
e6: $ G ⇒ ixs D W (isup Z S0) ∈ fseq u $ by ixs_fseq [e4, e5]

--| The length of parameter values.
lemma b11_tp_clen (G: hyps) (M D W P T Q: class) (u p t t3: set): $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p t3 ∈ lrel $ > $ G ⇒ cdm Q = fv nvf t3 $
----
ls: $ G ⇒ sig lsig lopen $ by lsig_sig
dt0: $ … ⇒ ofsort lsig lopen ks_ind ⊆ trees ω $ by ofsort_trees [ls]
dtr: $ … ⇒ D ∈ trees ω $ by wcel_subset [dt0, #1]
b1: $ … ⇒ P = p $ by b7_iprt_eqp [#2, #4]
b2: $ G ⇒ W = W $ by eq_refl
b3: $ … ⇒ esat u (dnf u M) P W = esat u (dnf u M) p W $ by esat_eq [b1, b2]
b4: $ … ⇒ Q ∈ esat u (dnf u M) p W $ by wcel_eq_r [b3, #3]
c1: $ … ⇒ p ∈ fv tsub D ∧ t ∈ fv tsub D $ by iprt_tsub [dtr, #4]
c2: $ … ⇒ p ∈ fv tsub D $ by and_elim_l [c1]
c3: $ G ⇒ fv tsub D ⊆ trees ω $ by tsub_trees
c4: $ … ⇒ p ∈ trees ω $ by wcel_subset [c3, c2]
c5: $ … ⇒ p ∊ trees ω $ by wcel_welc [c4]
e1: $ G , o = Q , o ∊ esat u (dnf u M) p W ⇒ o = Q $ by ax
e2: $ G , o = Q , o ∊ esat u (dnf u M) p W ⇒ o ∊ esat u (dnf u M) p W $ by ax
w383_h5: $ G , o = Q , o ∊ esat u (dnf u M) p W ⇒ ra_clen p t3 ∈ lrel $ by weaken [#5]
w384_c5: $ G , o = Q , o ∊ esat u (dnf u M) p W ⇒ p ∊ trees ω $ by weaken [c5]
e3: $ … ⇒ cdm o = fv nvf t3 $ by esat_clen_c [w383_h5, w384_c5, e2]
e4: $ … ⇒ Q = o $ by eq_sym [e1]
e5: $ … ⇒ cdm Q = cdm o $ by cdm_eq [e4]
e6: $ … ⇒ cdm Q = fv nvf t3 $ by eq_trans [e5, e3]
e7: $ G ⇒ cdm Q = fv nvf t3 $ by wcel_elim [b4, e6]

--| The first part of a concatenation, as a window.
lemma b11_tp_sw (G: hyps) (S X N: class) (u: set): $ G ⇒ S ∈ fseq u $ > $ G ⇒ X ∈ fseq u $ > $ G ⇒ cdm S = N $ > $ G ⇒ swin (scat S X) ∅ N = S $
----
a1: $ G , x = S , x ∊ fseq u , y = X , y ∊ fseq u ⇒ x ∊ fseq u $ by ax
a2: $ G , x = S , x ∊ fseq u , y = X , y ∊ fseq u ⇒ y ∊ fseq u $ by ax
a3: $ … ⇒ swin (scat x y) ∅ (cdm x) = x $ by b7_swin_scat [a1, a2]
e1: $ G , x = S , x ∊ fseq u , y = X , y ∊ fseq u ⇒ x = S $ by ax
e2: $ G , x = S , x ∊ fseq u , y = X , y ∊ fseq u ⇒ y = X $ by ax
e3: $ … ⇒ scat x y = scat S X $ by scat_eq [e1, e2]
e4: $ G , x = S , x ∊ fseq u , y = X , y ∊ fseq u ⇒ ∅ = ∅ $ by eq_refl
e5: $ … ⇒ cdm x = cdm S $ by cdm_eq [e1]
w385_h3: $ G , x = S , x ∊ fseq u , y = X , y ∊ fseq u ⇒ cdm S = N $ by weaken [#3]
e6: $ … ⇒ cdm x = N $ by eq_trans [e5, w385_h3]
e7: $ … ⇒ swin (scat x y) ∅ (cdm x) = swin (scat S X) ∅ N $ by swin_eq [e3, e4, e6]
e8: $ … ⇒ swin (scat S X) ∅ N = swin (scat x y) ∅ (cdm x) $ by eq_sym [e7]
e9: $ … ⇒ swin (scat S X) ∅ N = x $ by eq_trans [e8, a3]
ea: $ … ⇒ swin (scat S X) ∅ N = S $ by eq_trans [e9, e1]
w386_h2: $ G , x = S , x ∊ fseq u ⇒ X ∈ fseq u $ by weaken [#2]
z1: $ G , x = S , x ∊ fseq u ⇒ swin (scat S X) ∅ N = S $ by wcel_elim [w386_h2, ea]
z2: $ G ⇒ swin (scat S X) ∅ N = S $ by wcel_elim [#1, z1]

--| Two concatenations agree below the first part's length.
lemma b11_tp_ag (G: hyps) (S X1 X2 K A B: class) (u: set): $ G ⇒ S ∈ fseq u $ > $ G ⇒ X1 ∈ fseq u $ > $ G ⇒ X2 ∈ fseq u $ > $ G ⇒ K = cdm S $ > $ G ⇒ A = scat S X1 $ > $ G ⇒ B = scat S X2 $ > $ G ⇒ b9_ag A B K $
----
ax: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ x ∊ fseq u $ by ax
ay: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ y ∊ fseq u $ by ax
az: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ z ∊ fseq u $ by ax
ex: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ x = S $ by ax
ey: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ y = X1 $ by ax
ez: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ z = X2 $ by ax
g0: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ ∀ i (i ∊ cdm x → fv (scat x y) i = fv (scat x z) i) $ by scat_agree [ax, ay, az]
g1: $ … ⇒ i ∊ cdm x → fv (scat x y) i = fv (scat x z) i $ by all_elim [g0]
sx: $ … ⇒ S = x $ by eq_sym [ex]
k0: $ … ⇒ cdm S = cdm x $ by cdm_eq [sx]
w387_h4: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ K = cdm S $ by weaken [#4]
k1: $ … ⇒ K = cdm x $ by eq_trans [w387_h4, k0]
p0: $ … ⇒ scat x y = scat S X1 $ by scat_eq [ex, ey]
p1: $ … ⇒ scat S X1 = scat x y $ by eq_sym [p0]
w388_h5: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ A = scat S X1 $ by weaken [#5]
p2: $ … ⇒ A = scat x y $ by eq_trans [w388_h5, p1]
p3: $ … ⇒ scat x z = scat S X2 $ by scat_eq [ex, ez]
w389_h6: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ B = scat S X2 $ by weaken [#6]
p4: $ … ⇒ scat S X2 = B $ by eq_sym [w389_h6]
p5: $ … ⇒ scat x z = B $ by eq_trans [p3, p4]
h1: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u , i ∊ K ⇒ i ∊ K $ by ax
w390_k1: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u , i ∊ K ⇒ K = cdm x $ by weaken [k1]
h2: $ … ⇒ i ∊ cdm x $ by welc_eq [w390_k1, h1]
w391_g1: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u , i ∊ K ⇒ i ∊ cdm x → fv (scat x y) i = fv (scat x z) i $ by weaken [g1]
h3: $ … ⇒ fv (scat x y) i = fv (scat x z) i $ by imp_elim [w391_g1, h2]
ri: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u , i ∊ K ⇒ i = i $ by eq_refl
w392_p2: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u , i ∊ K ⇒ A = scat x y $ by weaken [p2]
h4: $ … ⇒ fv A i = fv (scat x y) i $ by fv_eq [w392_p2, ri]
w393_p5: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u , i ∊ K ⇒ scat x z = B $ by weaken [p5]
h5: $ … ⇒ fv (scat x z) i = fv B i $ by fv_eq [w393_p5, ri]
h6: $ … ⇒ fv A i = fv (scat x z) i $ by eq_trans [h4, h3]
h7: $ … ⇒ fv A i = fv B i $ by eq_trans [h6, h5]
h8: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ i ∊ K → fv A i = fv B i $ by imp_intro [h7]
h9: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ ∀ i (i ∊ K → fv A i = fv B i) $ by all_intro [h8]
ha: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u , z = X2 , z ∊ fseq u ⇒ b9_ag A B K $ by weaken [h9]
w394_h3: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u ⇒ X2 ∈ fseq u $ by weaken [#3]
z1: $ G , x = S , x ∊ fseq u , y = X1 , y ∊ fseq u ⇒ b9_ag A B K $ by wcel_elim [w394_h3, ha]
w395_h2: $ G , x = S , x ∊ fseq u ⇒ X1 ∈ fseq u $ by weaken [#2]
z2: $ G , x = S , x ∊ fseq u ⇒ b9_ag A B K $ by wcel_elim [w395_h2, z1]
z3: $ G ⇒ b9_ag A B K $ by wcel_elim [#1, z2]

--| The top-level valuations are sequences in `u`.
lemma b11_wd (G: hyps) (M D W Z Q P S0: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ S0 ∈ u $ > $ G ⇒ scat Q (ixs D W (isup Z S0)) ∈ fseq u $
----
x1: $ … ⇒ ixs D W (isup Z S0) ∈ fseq u $ by b11_tp_ixs [#1, #2, #3, #5]
q1: $ G ⇒ esat u (dnf u M) P W ⊆ fseq u $ by esat_fseq
q2: $ … ⇒ Q ∈ fseq u $ by wcel_subset [q1, #4]
l1: $ … ⇒ scat Q (ixs D W (isup Z S0)) ∈ fseq u $ by scat_fseq_c [q2, x1]

--| Two top-level valuations agree below the parameters.
lemma b11_top_ag (G: hyps) (M D W Z Q P T S1 S2: class) (u p t t3 t7 a b: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p t3 ∈ lrel $ > $ G ⇒ S1 ∈ u $ > $ G ⇒ S2 ∈ u $ > $ G ⇒ t7 = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ a = scat Q (ixs D W (isup Z S1)) $ > $ G ⇒ b = scat Q (ixs D W (isup Z S2)) $ > $ G ⇒ b9_ag a b (nadd (fv nvf t7) (fv nvf t3)) $
----
q1: $ G ⇒ esat u (dnf u M) P W ⊆ fseq u $ by esat_fseq
q2: $ … ⇒ Q ∈ fseq u $ by wcel_subset [q1, #6]
x1: $ … ⇒ ixs D W (isup Z S1) ∈ fseq u $ by b11_tp_ixs [#1, #3, #4, #9]
c1: $ … ⇒ cdm Q = fv nvf t3 $ by b11_tp_clen [#2, #5, #6, #7, #8]
f0: $ G ⇒ nvf = nvf $ by eq_refl
f1: $ … ⇒ fv nvf t7 = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [f0, #11]
f2: $ G ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
n1: $ … ⇒ fv nvf t7 = ∅ $ by eq_trans [f1, f2]
x2: $ … ⇒ ixs D W (isup Z S2) ∈ fseq u $ by b11_tp_ixs [#1, #3, #4, #10]
c2: $ … ⇒ fv nvf t3 = cdm Q $ by eq_sym [c1]
k1: $ … ⇒ nadd (fv nvf t7) (fv nvf t3) = nadd ∅ (cdm Q) $ by nadd_eq [n1, c2]
z0: $ G ⇒ ∅ ∈ ω $ by omega_zero
i3: $ G ⇒ isset t3 $ by isset_var
i4: $ … ⇒ fv nvf t3 ∈ ω $ by nvf_omega [i3]
cl: $ … ⇒ cdm Q ∈ ω $ by wcel_eq_l [c2, i4]
k2: $ … ⇒ nadd ∅ (cdm Q) = nadd (cdm Q) ∅ $ by nadd_comm_c [z0, cl]
is: $ … ⇒ isset (cdm Q) $ by wcel_isset [cl]
k3: $ … ⇒ nadd (cdm Q) ∅ = cdm Q $ by nadd_zero_c [is]
k4: $ … ⇒ nadd (fv nvf t7) (fv nvf t3) = nadd (cdm Q) ∅ $ by eq_trans [k1, k2]
k5: $ … ⇒ nadd (fv nvf t7) (fv nvf t3) = cdm Q $ by eq_trans [k4, k3]
l1: $ … ⇒ b9_ag a b (nadd (fv nvf t7) (fv nvf t3)) $ by b11_tp_ag [q2, x1, x2, k5, #12, #13]

--| The parameters of a top-level valuation.
lemma b11_top_sw (G: hyps) (M D W Z Q P T S1: class) (u p t t3 t7 a: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p t3 ∈ lrel $ > $ G ⇒ S1 ∈ u $ > $ G ⇒ t7 = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ a = scat Q (ixs D W (isup Z S1)) $ > $ G ⇒ swin a (fv nvf t7) (fv nvf t3) = Q $
----
q1: $ G ⇒ esat u (dnf u M) P W ⊆ fseq u $ by esat_fseq
q2: $ … ⇒ Q ∈ fseq u $ by wcel_subset [q1, #6]
x1: $ … ⇒ ixs D W (isup Z S1) ∈ fseq u $ by b11_tp_ixs [#1, #3, #4, #9]
c1: $ … ⇒ cdm Q = fv nvf t3 $ by b11_tp_clen [#2, #5, #6, #7, #8]
f0: $ G ⇒ nvf = nvf $ by eq_refl
f1: $ … ⇒ fv nvf t7 = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [f0, #10]
f2: $ G ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
n1: $ … ⇒ fv nvf t7 = ∅ $ by eq_trans [f1, f2]
s1: $ … ⇒ swin (scat Q (ixs D W (isup Z S1))) ∅ (fv nvf t3) = Q $ by b11_tp_sw [q2, x1, c1]
r3: $ G ⇒ fv nvf t3 = fv nvf t3 $ by eq_refl
s2: $ … ⇒ swin a (fv nvf t7) (fv nvf t3) = swin (scat Q (ixs D W (isup Z S1))) ∅ (fv nvf t3) $ by swin_eq [#11, n1, r3]
