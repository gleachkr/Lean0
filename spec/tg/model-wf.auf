c3: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ (∃ m (ra_isort e m l ∈ lrel)) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq u ∧ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) e w r → ∃ i ∃ d ∃ n (⟨ scat f (sarg u (dnf u M) z w r) , ⟨ i , ⟨ d , n ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w r)) $ by and_intro [A1, c2]
end: $ H ⇒ (c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2) → (∃ m (ra_isort e m l ∈ lrel)) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq u ∧ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) e w r → ∃ i ∃ d ∃ n (⟨ scat f (sarg u (dnf u M) z w r) , ⟨ i , ⟨ d , n ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w r)) $ by imp_intro [c3]

lemma b5_sc_app {m f g t a i d n: set} (H: hyps) (J M K S: class) (u w c h q r l o z k j e x0 x1 x2 x3 x4 x5 x6 x7: set): $ H ⇒ jval u M J $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ r ∊ sat u M c w $ > $ H ⇒ ra_isort q o l ∈ lrel $ > $ H ⇒ h = ⟨ K , S ⟩ $ > $ H ⇒ ⟨ K , S ⟩ ∈ trees ω $ > $ H ⇒ ¬ K = kc_pi $ > $ H ⇒ ¬ K = kc_app $ > $ H ⇒ j ∊ fseq (trees ω) $ > $ H ⇒ crn j ⊆ b5_sy u M w J c h q r l $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ H ⇒ ra_sty c h q z e ∈ lrel3 J $ > $ H ⇒ (c = x0 ∧ h = x1 ∧ q = x2 ∧ z = ⟨ kc_app , scons x3 (scons x4 ∅) ⟩ ∧ e = x7 ∧ ra_sty x0 x1 x2 x3 ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x0 x4 x4 x5 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x6 x4 x7 ∈ lrel) → (∃ m (ra_isort e m l ∈ lrel)) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq u ∧ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) e w r → ∃ i ∃ d ∃ n (⟨ scat f (sarg u (dnf u M) z w r) , ⟨ i , ⟨ d , n ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w r)) $
----
cf1: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = ⟨ kc_app , scons x3 (scons x4 ∅) ⟩ ∧ e = x7 ∧ ra_sty x0 x1 x2 x3 ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∈ lrel3 J ∧ ra_deq x0 x4 x4 x5 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ x6 x4 x7 ∈ lrel , b = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ⇒ jval u M J $ by weaken [#1]
