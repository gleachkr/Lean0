--| The depth of the top level is the parameters' length.
lemma b11_hb_kt (G: hyps) (Q: class) (t3 t7: set): $ G ⇒ cdm Q = fv nvf t3 $ > $ G ⇒ t7 = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ nadd (fv nvf t7) (fv nvf t3) = cdm Q $
----
f0: $ G ⇒ nvf = nvf $ by eq_refl
f1: $ … ⇒ fv nvf t7 = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [f0, #2]
f2: $ G ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
n1: $ … ⇒ fv nvf t7 = ∅ $ by eq_trans [f1, f2]
c2: $ … ⇒ fv nvf t3 = cdm Q $ by eq_sym [#1]
k1: $ … ⇒ nadd (fv nvf t7) (fv nvf t3) = nadd ∅ (cdm Q) $ by nadd_eq [n1, c2]
z0: $ G ⇒ ∅ ∈ ω $ by omega_zero
i3: $ G ⇒ isset t3 $ by isset_var
i4: $ … ⇒ fv nvf t3 ∈ ω $ by nvf_omega [i3]
cl: $ … ⇒ cdm Q ∈ ω $ by wcel_eq_l [c2, i4]
k2: $ … ⇒ nadd ∅ (cdm Q) = nadd (cdm Q) ∅ $ by nadd_comm_c [z0, cl]
is: $ … ⇒ isset (cdm Q) $ by wcel_isset [cl]
k3: $ … ⇒ nadd (cdm Q) ∅ = cdm Q $ by nadd_zero_c [is]
k4: $ … ⇒ nadd (fv nvf t7) (fv nvf t3) = nadd (cdm Q) ∅ $ by eq_trans [k1, k2]
k5: $ … ⇒ nadd (fv nvf t7) (fv nvf t3) = cdm Q $ by eq_trans [k4, k3]

--| `b11_top_hs` at one entry.
lemma b11_hb_hs1 {o: set} (G: hyps) (M D W Z Q P T: class) (u x p t t3 t1 t7 a r tj tm tc ty: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Z ⊆ itc u (dnf u M) D W $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ x ∊ u $ > $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p t3 ∈ lrel $ > $ G ⇒ t1 = D $ > $ G ⇒ t7 = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ a = scat Q (ixs D W (isup Z x)) $ > $ G ⇒ r = scat Q (ixs D W (isup Z (csn (scons ∅ ∅)))) $ > $ G ⇒ ra_nidx t1 tj tm ∈ lrel $ > $ G ⇒ tc ∊ fseq b7_V $ > $ G ⇒ cdm tc = fv nvf tm $ > $ G ⇒ nest (scat tc Q) ty ∈ fv a (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf tj)) $ > $ G ⇒ ∃ o (apn (fv r (nadd (nadd (fv nvf t7) (fv nvf t3)) (fv nvf tj))) (scat tc Q) = csn o ∧ (ty = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ ty ∊ x))) $
----
