b7: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ nadd (fv nvf j) (cdm z) = fv nvf j $ by eq_trans [b6, b5]
c1: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ z = scons x y $ by weaken [#1]
c2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ cdm z = cdm (scons x y) $ by cdm_eq [c1]
