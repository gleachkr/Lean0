b10: $ G , v = W , v ∊ lvals , t4 = l ∧ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩ ⇒ lv ⟨ kc_lz , ∅ ⟩ v = ∅ $ by lv_lz
b11: $ … ⇒ lv l v = ∅ $ by eq_trans [b9, b10]
b12: $ G , v = W , v ∊ lvals , t4 = l ∧ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩ ⇒ v = W $ by ax
b13: $ … ⇒ W = v $ by eq_sym [b12]
b14: $ … ⇒ lv t4 W = lv l v $ by lv_eq [b2, b13]
b15: $ … ⇒ lv t4 W = ∅ $ by eq_trans [b14, b11]
b16: $ G , v = W , v ∊ lvals , t4 = l ∧ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩ ⇒ ¬ lv t4 W = ∅ $ by weaken [#3]
b17: $ … ⇒ ⊥ $ by not_elim [b16, b15]
b18: $ … ⇒ lv t14 v ⊆ lv t4 v $ by bot_elim [b17]
b19: $ G , v = W , v ∊ lvals , ∃ m (t4 = l ∧ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩) ⇒ ∃ m (t4 = l ∧ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩) $ by ax
b20: $ … ⇒ lv t14 v ⊆ lv t4 v $ by ex_elim [b19, b18]
