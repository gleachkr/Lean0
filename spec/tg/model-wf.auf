lemma b6_sinst_sort (G: hyps) (d n k e f: set): $ G ⇒ ra_sinst d ⟨ kc_nz , ∅ ⟩ n k e f ∈ lrel $ > $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ e ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ f ∊ ofsort lsig lopen ks_expr $
----
q1: $ G , v = ∅ , ra_sinst d q n k o m ∈ lrel , nadd (fv nvf q) v = fv nvf n , q ∊ ofsort lsig lopen ks_nat , d ∈ ofsort lsig lopen ks_ind , o ∊ ofsort lsig lopen ks_expr ⇒ ra_sinst d q n k o m ∈ lrel $ by ax
q2: $ G , v = ∅ , ra_sinst d q n k o m ∈ lrel , nadd (fv nvf q) v = fv nvf n , q ∊ ofsort lsig lopen ks_nat , d ∈ ofsort lsig lopen ks_ind , o ∊ ofsort lsig lopen ks_expr ⇒ nadd (fv nvf q) v = fv nvf n $ by ax
q3: $ G , v = ∅ , ra_sinst d q n k o m ∈ lrel , nadd (fv nvf q) v = fv nvf n , q ∊ ofsort lsig lopen ks_nat , d ∈ ofsort lsig lopen ks_ind , o ∊ ofsort lsig lopen ks_expr ⇒ q ∊ ofsort lsig lopen ks_nat $ by ax
