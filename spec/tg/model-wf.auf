lemma b14_ip_st (G: hyps) (M N S: class) (u w X Y t1 t2 t3 z k s t4 t6: set): $ G ⇒ crn s ⊆ b14_cip u M w X Y t1 t2 t3 N $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ X ∊ fseq u $ > $ G ⇒ Y ∊ fseq u $ > $ G ⇒ b6_cond t1 t3 X Y $ > $ G ⇒ b12_bnd t1 t3 X S $ > $ G ⇒ b12_ne t1 t3 Y $ > $ G ⇒ universe N $ > $ G ⇒ S ∈ N $ > $ G ⇒ ra_ipos t1 t2 t3 t4 z ∈ lrel $ > $ G ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ t6 ∊ fseq u $ > $ G ⇒ cdm t6 = nadd (fv nvf t4) (fv nvf t3) $ > $ G ⇒ (dt u M z w (scat t6 Y) ⊆ csn ∅ → dt u M z w (scat t6 X) ⊆ csn ∅) ∧ (dt u M z w (scat t6 Y) ∈ N → dt u M z w (scat t6 X) ∈ N) $
