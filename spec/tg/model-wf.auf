b7: $ … ⇒ apn (fv Y (fv nvf i)) q = apn (fv y (fv nvf i)) q $ by apn_eq [b5, b6]
b8: $ … ⇒ g ∊ apn (fv y (fv nvf i)) q $ by welc_eq [b7, b1]
b9: $ … ⇒ ∃ g (g ∊ apn (fv y (fv nvf i)) q) $ by ex_intro [b8]
b10: $ … ⇒ ∃ g (g ∊ apn (fv y (fv nvf i)) q) $ by ex_elim [a24, b9]
b11: $ … ⇒ e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q) $ by imp_intro [b10]
b12: $ … ⇒ ∀ e (e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q)) $ by all_intro [b11]
b13: $ … ⇒ q ∊ fseq b6_V → ∀ e (e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q)) $ by imp_intro [b12]
b14: $ … ⇒ cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q)) $ by imp_intro [b13]
b15: $ … ⇒ ra_nidx o i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q)) $ by imp_intro [b14]
b16: $ … ⇒ ∀ q (ra_nidx o i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q))) $ by all_intro [b15]
b17: $ … ⇒ ∀ m ∀ q (ra_nidx o i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q))) $ by all_intro [b16]
b18: $ … ⇒ ∀ i ∀ m ∀ q (ra_nidx o i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv x (fv nvf i)) q → ∃ g (g ∊ apn (fv y (fv nvf i)) q))) $ by all_intro [b17]

lemma b14_bnd_s {i m q: set} (G: hyps) (D X S: class) (t3 o x: set): $ G ⇒ b12_bnd D t3 X S $ > $ G ⇒ x = X $ > $ G ⇒ o = D $ > $ G ⇒ ∀ i ∀ m ∀ q (ra_nidx o i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → apn (fv x (fv nvf i)) q ⊆ S) $
