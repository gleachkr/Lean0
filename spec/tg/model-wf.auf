lemma b7_hw_eqc (G: hyps) (D D2 Q A A2 B B2 E E2 N N2: class): $ G ⇒ D = D2 $ > $ G ⇒ A = A2 $ > $ G ⇒ B = B2 $ > $ G ⇒ E = E2 $ > $ G ⇒ N = N2 $ > $ G ⇒ b7_hw D Q A B E N $ > $ G ⇒ b7_hw D2 Q A2 B2 E2 N2 $
----
k0: $ G ⇒ nvf = nvf $ by eq_refl
k1: $ G ⇒ fv nvf E = fv nvf E2 $ by fv_eq [k0, #4]
k2: $ G ⇒ fv nvf N = fv nvf N2 $ by fv_eq [k0, #5]
k3: $ G ⇒ nadd (fv nvf E) (fv nvf N) = nadd (fv nvf E2) (fv nvf N2) $ by nadd_eq [k1, k2]
k4: $ G ⇒ nadd (fv nvf E2) (fv nvf N2) = nadd (fv nvf E) (fv nvf N) $ by eq_sym [k3]
h0: $ G ⇒ b7_hq D Q A B (nadd (fv nvf E) (fv nvf N)) $ by and_elim_l [#6]
