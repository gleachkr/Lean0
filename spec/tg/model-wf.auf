lemma b5_body (G: hyps) (M: class) (u w n q s k h p r o b m x: set): $ G ⇒ q ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = fv nvf k $ > $ G ⇒ r = scat p (scat q s) $ > $ G ⇒ o = scat p s $ > $ G ⇒ b ∈ b5_lp u M w n q s $ > $ G ⇒ ra_lift n h b m ∈ lrel $ > $ G ⇒ fv nvf h = suc (fv nvf k) $ > $ G ⇒ x ∊ u $ > $ G ⇒ etel u (dnf u M) m w (scons x r) = etel u (dnf u M) b w (scons x o) $
----
a3: $ G ⇒ scons x p ∈ fseq u $ by scons_fseq [#10, #3]
a4: $ G ⇒ cdm (scons x p) = suc (cdm p) $ by scons_len [#3]
a5: $ G ⇒ suc (cdm p) = suc (fv nvf k) $ by suc_eq [#4]
a6: $ G ⇒ suc (fv nvf k) = fv nvf h $ by eq_sym [#9]
a7a: $ G ⇒ cdm (scons x p) = suc (fv nvf k) $ by eq_trans [a4, a5]
a7: $ G ⇒ cdm (scons x p) = fv nvf h $ by eq_trans [a7a, a6]
a8a: $ G ⇒ isset r $ by isset_var
a8: $ G ⇒ isset (scons x r) $ by scons_set [a8a]
b1: $ G ⇒ q ∈ fseq u $ by welc_wcel [#1]
b2: $ G ⇒ s ∈ fseq u $ by welc_wcel [#2]
b3: $ G ⇒ scat q s ∈ fseq u $ by scat_fseq_c [b1, b2]
b4: $ G ⇒ p ∈ fseq u $ by welc_wcel [#3]
b5: $ G ⇒ isset x $ by isset_var
a9: $ G ⇒ scat (scons x p) (scat q s) = scons x (scat p (scat q s)) $ by scat_scons_c [b5, b4, b3]
a10a: $ G ⇒ x = x $ by eq_refl
a10: $ G ⇒ scons x r = scons x (scat p (scat q s)) $ by scons_eq [a10a, #5]
a11a: $ G ⇒ scons x (scat p (scat q s)) = scat (scons x p) (scat q s) $ by eq_sym [a9]
a11: $ G ⇒ scons x r = scat (scons x p) (scat q s) $ by eq_trans [a10, a11a]
a12a: $ G ⇒ isset o $ by isset_var
a12: $ G ⇒ isset (scons x o) $ by scons_set [a12a]
a13: $ G ⇒ scat (scons x p) s = scons x (scat p s) $ by scat_scons [#3, #2]
a14: $ G ⇒ scons x o = scons x (scat p s) $ by scons_eq [a10a, #6]
a15a: $ G ⇒ scons x (scat p s) = scat (scons x p) s $ by eq_sym [a13]
a15: $ G ⇒ scons x o = scat (scons x p) s $ by eq_trans [a14, a15a]
a16: $ G ⇒ etel u (dnf u M) m w (scons x r) = etel u (dnf u M) b w (scons x o) $ by b5_ih [#7, #8, a3, a7, a8, a11, a12, a15]

lemma b5_k_pi (H: hyps) (M: class) (u w n q s k z e p r o c j x0 x1 x9 b l m: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ q ∊ fseq u $ > $ H ⇒ cdm q = fv nvf n $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ crn j ⊆ b5_lp u M w n q s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_lift n k z e ∈ lrel $ > $ H ⇒ p ∊ fseq u $ > $ H ⇒ cdm p = fv nvf k $ > $ H ⇒ r = scat p (scat q s) $ > $ H ⇒ o = scat p s $ > $ H ⇒ (n = x0 ∧ k = x1 ∧ z = ⟨ kc_pi , scons x9 (scons b ∅) ⟩ ∧ e = ⟨ kc_pi , scons l (scons m ∅) ⟩ ∧ ra_lift x0 x1 x9 l ∈ lrel ∧ ra_lift x0 ⟨ kc_s , scons x1 ∅ ⟩ b m ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $
