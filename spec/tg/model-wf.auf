q3: $ G ⇒ ⟨ kc_proj , scons A (scons B (scons C ∅)) ⟩ ∈ ofsort lsig lopen ks_expr $ by ofsort_node3 [q1, q2, #1, #2, #3]

lemma b6_so_ind_ty (G: hyps) (A B: class): $ G ⇒ A ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ B ∈ ofsort lsig lopen ks_nat $ > $ G ⇒ ⟨ kc_ind_ty , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $
