lemma b3_tys_tcons (G: hyps) (a f e h: set): $ G ⇒ a ∊ ofsort lsig lopen ks_tys $ > $ G ⇒ a = ⟨ kc_tcons , scons f (scons e (scons h ∅)) ⟩ $ > $ G ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors ∧ h ∊ ofsort lsig lopen ks_tys $
