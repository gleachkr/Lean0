lemma b5_val (G: hyps) (u p r: set) (T: class): $ G ⇒ p ∊ fseq u $ > $ G ⇒ T ∈ fseq u $ > $ G ⇒ r = scat p T $ > $ G ⇒ r ∊ fseq u $
----
l1: $ G ⇒ p ∈ fseq u $ by welc_wcel [#1]
l2: $ G ⇒ scat p T ∈ fseq u $ by scat_fseq_c [l1, #2]
l3: $ G ⇒ scat p T = r $ by eq_sym [#3]
l4: $ G ⇒ r ∈ fseq u $ by wcel_eq_l [l3, l2]
l5: $ G ⇒ r ∊ fseq u $ by wcel_welc [l4]

lemma b5_kid2 (G: hyps) (P K: class) (k j a b: set): $ G ⇒ crn j ⊆ P $ > $ G ⇒ ⟨ k , j ⟩ = ⟨ K , scons a (scons b ∅) ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ a ∈ P ∧ b ∈ P $
----
l1: $ G ⇒ isset k $ by isset_var
l2: $ G ⇒ isset j $ by isset_var
l3a: $ G ⇒ isset ∅ $ by ax_empty
l3b: $ G ⇒ isset (scons b ∅) $ by scons_set [l3a]
l3: $ G ⇒ isset (scons a (scons b ∅)) $ by scons_set [l3b]
l4: $ G ⇒ k = K ∧ j = scons a (scons b ∅) $ by opair_inj_c [#2, l1, l2, #3, l3]
l5: $ G ⇒ j = scons a (scons b ∅) $ by and_elim_r [l4]
l6: $ G ⇒ crn j = crn (scons a (scons b ∅)) $ by crn_eq [l5]
l7: $ G ⇒ crn (scons a (scons b ∅)) ⊆ P $ by subset_eq_l [l6, #1]
l8: $ G ⇒ isset a $ by isset_var
l9: $ G ⇒ a ∈ P $ by crn_scons_head [l8, l7]
l10: $ G ⇒ crn (scons b ∅) ⊆ P $ by crn_scons_tail [l7]
l11: $ G ⇒ isset b $ by isset_var
l12: $ G ⇒ b ∈ P $ by crn_scons_head [l11, l10]
l13: $ G ⇒ a ∈ P ∧ b ∈ P $ by and_intro [l9, l12]

lemma b5_oth (G: hyps) (M K S S2: class) (u w z e r o: set): $ G ⇒ z ∊ trees ω $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ e = ⟨ K , S2 ⟩ $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ o ∊ fseq u $ > $ G ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $
----
a1: $ G ⇒ z ∈ trees ω $ by welc_wcel [#1]
a2: $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ by wcel_eq_l [#3, a1]
a3: $ G ⇒ e ∈ trees ω $ by welc_wcel [#2]
a4: $ G ⇒ ⟨ K , S2 ⟩ ∈ trees ω $ by wcel_eq_l [#4, a3]
b1: $ G ⇒ etel u (dnf u M) ⟨ K , S ⟩ w o = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_trees [a2, #5, #6, #7, #9]
b2: $ G ⇒ etel u (dnf u M) ⟨ K , S2 ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_trees [a4, #5, #6, #7, #8]
r1: $ G ⇒ w = w $ by eq_refl
r2: $ G ⇒ r = r $ by eq_refl
r3: $ G ⇒ o = o $ by eq_refl
c1: $ G ⇒ etel u (dnf u M) e w r = etel u (dnf u M) ⟨ K , S2 ⟩ w r $ by etel_eq [#4, r1, r2]
c2: $ G ⇒ etel u (dnf u M) z w o = etel u (dnf u M) ⟨ K , S ⟩ w o $ by etel_eq [#3, r1, r3]
c3: $ G ⇒ etel u (dnf u M) e w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [c1, b2]
c4: $ G ⇒ etel u (dnf u M) z w o = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [c2, b1]
c5: $ G ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ = etel u (dnf u M) z w o $ by eq_sym [c4]
c6: $ G ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by eq_trans [c3, c5]

lemma b5_k_oth (H: hyps) (M K S S2: class) (u w n q s k z e p r o: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ q ∊ fseq u $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ ra_lift n k z e ∈ lrel $ > $ H ⇒ p ∊ fseq u $ > $ H ⇒ r = scat p (scat q s) $ > $ H ⇒ o = scat p s $ > $ H ⇒ z = ⟨ K , S ⟩ $ > $ H ⇒ e = ⟨ K , S2 ⟩ $ > $ H ⇒ ¬ K = kc_pi $ > $ H ⇒ ¬ K = kc_app $ > $ H ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $
----
t1: $ H ⇒ kr_lift ∈ ω $ by kr_lift_omega
t2: $ H ⇒ isset kr_lift $ by wcel_isset [t1]
t3: $ H ⇒ n ∊ trees ω ∧ k ∊ trees ω ∧ z ∊ trees ω ∧ e ∊ trees ω $ by lrel_args4 [#4, t2]
t4: $ H ⇒ k ∊ trees ω ∧ z ∊ trees ω ∧ e ∊ trees ω $ by and_elim_r [t3]
t5: $ H ⇒ z ∊ trees ω ∧ e ∊ trees ω $ by and_elim_r [t4]
tz: $ H ⇒ z ∊ trees ω $ by and_elim_l [t5]
te: $ H ⇒ e ∊ trees ω $ by and_elim_r [t5]
a1: $ H ⇒ q ∈ fseq u $ by welc_wcel [#2]
a2: $ H ⇒ s ∈ fseq u $ by welc_wcel [#3]
a3: $ H ⇒ scat q s ∈ fseq u $ by scat_fseq_c [a1, a2]
rv: $ H ⇒ r ∊ fseq u $ by b5_val [#5, a3, #6]
ov: $ H ⇒ o ∊ fseq u $ by b5_val [#5, a2, #7]
fin: $ H ⇒ etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by b5_oth [tz, te, #8, #9, #10, #11, #1, rv, ov]

lemma b5_x2_sub {a y: set} (G: hyps) (P P2 D D2: class): $ G ⇒ P = P2 $ > $ G ⇒ D = D2 $ > $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩)} $
----
k1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ $ by ax
k2: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P $ by and_elim_l [k1]
k3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ $ by and_elim_r [k1]
h1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ P = P2 $ by weaken [#1]
h2: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ D = D2 $ by weaken [#2]
e2: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 $ by wcel_eq_r [h1, k2]
w3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ a = a $ by eq_refl
w4: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ∅ = ∅ $ by eq_refl
e3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ scons D a = scons D2 a $ by scons_eq [h2, w3]
e4: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , scons D a ⟩ = ⟨ ∅ , scons D2 a ⟩ $ by opair_eq [w4, e3]
e5: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ $ by opair_eq [w4, e4]
e6: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩ $ by opair_eq [w4, e5]
e7: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩ $ by eq_trans [k3, e6]
c1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩ $ by and_intro [e2, e7]
c2: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩) $ by ex_intro [c1]
c3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩ ⇒ z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩)} $ by cab_intro [c2]
m1: $ G , z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} ⇒ z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} $ by ax
m2: $ G , z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ z = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩) $ by cab_elim [m1]
m3: $ G , z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} ⇒ z ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩)} $ by ex_elim [m2, c3]
m4: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩)} $ by subset_intro [m3]

lemma b5_x2_eq {a y: set} (G: hyps) (P P2 D D2: class): $ G ⇒ P = P2 $ > $ G ⇒ D = D2 $ > $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩)} $
----
s1: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩)} $ by b5_x2_sub [#1, #2]
s2: $ G ⇒ P2 = P $ by eq_sym [#1]
s3: $ G ⇒ D2 = D $ by eq_sym [#2]
s4: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} $ by b5_x2_sub [s2, s3]
s5: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D a ⟩ ⟩ ⟩)} = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons D2 a ⟩ ⟩ ⟩)} $ by subset_antisym [s1, s4]

lemma b5_x1_sub {x f g t a y: set} (G: hyps) (E P P2 D D2 B B2 R O: class) (u w: set): $ G ⇒ P = P2 $ > $ G ⇒ D = D2 $ > $ G ⇒ ∀ x (x ∊ u → etel u E B w (scons x R) = etel u E B2 w (scons x O)) $ > $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $
----
k1: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by ax
k2: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ P $ by and_elim_l [k1]
k1a: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by and_elim_r [k1]
k3: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ u $ by and_elim_l [k1a]
k3a: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by and_elim_r [k1a]
k4: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) $ by and_elim_l [k3a]
k5: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ $ by and_elim_r [k3a]
h1: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ P = P2 $ by weaken [#1]
h2a: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ∀ x (x ∊ u → etel u E B w (scons x R) = etel u E B2 w (scons x O)) $ by weaken [#3]
h2b: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ u → etel u E B w (scons x R) = etel u E B2 w (scons x O) $ by all_elim [h2a]
h2: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ etel u E B w (scons x R) = etel u E B2 w (scons x O) $ by imp_elim [h2b, k3]
h3: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ D = D2 $ by weaken [#2]
e1: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ x ∊ P2 $ by welc_eq [h1, k2]
e3: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B2 w (scons x O) $ by wcel_eq_r [h2, k4]
w3: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ t = t $ by eq_refl
w4: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ a = a $ by eq_refl
w5: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ scons x g = scons x g $ by eq_refl
w6: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ssnoc f x = ssnoc f x $ by eq_refl
e4: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ scons D t = scons D2 t $ by scons_eq [h3, w3]
e5: $ G , x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E B w (scons x R) ∧ z = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩ ⇒ ⟨ scons D t , a ⟩ = ⟨ scons D2 t , a ⟩ $ by opair_eq [e4, w4]
