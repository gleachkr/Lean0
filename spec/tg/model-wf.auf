s6d: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = l ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ l x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 l ∈ lrel , x ∊ fseq b7_V ∧ cdm x = fv nvf x8 ∧ etel u (dnf u M) l w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x (swin r (fv nvf x4) (fv nvf x3)) ⟩ ⟩ ⟩ ⇒ fv nvf x4 = fv nvf t4 $ by fv_eq [s6a, s6b]
s6e: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = l ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ l x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 l ∈ lrel , x ∊ fseq b7_V ∧ cdm x = fv nvf x8 ∧ etel u (dnf u M) l w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x (swin r (fv nvf x4) (fv nvf x3)) ⟩ ⟩ ⟩ ⇒ fv nvf x3 = fv nvf t3 $ by fv_eq [s6a, s6c]
s6: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = l ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ l x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 l ∈ lrel , x ∊ fseq b7_V ∧ cdm x = fv nvf x8 ∧ etel u (dnf u M) l w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x (swin r (fv nvf x4) (fv nvf x3)) ⟩ ⟩ ⟩ ⇒ swin r (fv nvf x4) (fv nvf x3) = swin r (fv nvf t4) (fv nvf t3) $ by swin_eq [s5b, s6d, s6e]
s7a: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = l ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ l x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 l ∈ lrel , x ∊ fseq b7_V ∧ cdm x = fv nvf x8 ∧ etel u (dnf u M) l w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x (swin r (fv nvf x4) (fv nvf x3)) ⟩ ⟩ ⟩ ⇒ x = x $ by eq_refl
s7: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = l ∧ t6 = x5 ∧ ra_spine ⟨ kc_bvar , scons x7 ∅ ⟩ l x9 ∈ lrel ∧ ra_add x4 x3 x6 ∈ lrel ∧ ra_add x6 x5 x7 ∈ lrel ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x7 ∅ ⟩ x4 x3 x0 ∈ lrel ∧ ra_nidx x1 x5 x8 ∈ lrel ∧ ra_iargs x6 x8 x0 l ∈ lrel , x ∊ fseq b7_V ∧ cdm x = fv nvf x8 ∧ etel u (dnf u M) l w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat x (swin r (fv nvf x4) (fv nvf x3)) ⟩ ⟩ ⟩ ⇒ scat x (swin r (fv nvf x4) (fv nvf x3)) = scat x (swin r (fv nvf t4) (fv nvf t3)) $ by scat_eq [s7a, s6]
