lemma b14_goal_eq (G: hyps) (A B N: class): $ G ⇒ A = B $ > $ G ⇒ (B ⊆ csn ∅ → A ⊆ csn ∅) ∧ (B ∈ N → A ∈ N) $
----
a1: $ G ⇒ B = A $ by eq_sym [#1]
a2: $ G , B ⊆ csn ∅ ⇒ B ⊆ csn ∅ $ by ax
a3: $ G , B ⊆ csn ∅ ⇒ B = A $ by weaken [a1]
a4: $ … ⇒ A ⊆ csn ∅ $ by subset_eq_l [a3, a2]
a5: $ … ⇒ B ⊆ csn ∅ → A ⊆ csn ∅ $ by imp_intro [a4]
a6: $ G , B ∈ N ⇒ B ∈ N $ by ax
a7: $ G , B ∈ N ⇒ B = A $ by weaken [a1]
a8: $ … ⇒ A ∈ N $ by wcel_eq_l [a7, a6]
a9: $ … ⇒ B ∈ N → A ∈ N $ by imp_intro [a8]
a10: $ … ⇒ (B ⊆ csn ∅ → A ⊆ csn ∅) ∧ (B ∈ N → A ∈ N) $ by and_intro [a5, a9]

lemma b14_ip_cl (G: hyps) (M: class) (u w X Y t3 t4 t6 k5 z: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ X ∊ fseq u $ > $ G ⇒ Y ∊ fseq u $ > $ G ⇒ t6 ∊ fseq u $ > $ G ⇒ cdm t6 = nadd (fv nvf t4) (fv nvf t3) $ > $ G ⇒ ra_add t4 t3 k5 ∈ lrel $ > $ G ⇒ ra_closed k5 z ∈ lrel $ > $ G ⇒ dt u M z w (scat t6 X) = dt u M z w (scat t6 Y) $
----
a1: $ G ⇒ scat t6 X ∈ fseq u $ by scat_fseq [#4, #2]
a2: $ G ⇒ scat t6 Y ∈ fseq u $ by scat_fseq [#4, #3]
a3: $ … ⇒ isset (scat t6 X) $ by wcel_isset [a1]
a4: $ … ⇒ isset (scat t6 Y) $ by wcel_isset [a2]
a5: $ G , h = scat t6 X , l = scat t6 Y ⇒ h = scat t6 X $ by ax
a6: $ G , h = scat t6 X , l = scat t6 Y ⇒ l = scat t6 Y $ by ax
a7: $ … ⇒ scat t6 X = h $ by eq_sym [a5]
a8: $ … ⇒ scat t6 Y = l $ by eq_sym [a6]
a9: $ G , h = scat t6 X , l = scat t6 Y ⇒ scat t6 X ∈ fseq u $ by weaken [a1]
a10: $ … ⇒ h ∈ fseq u $ by wcel_eq_l [a7, a9]
a11: $ … ⇒ h ∊ fseq u $ by wcel_welc [a10]
a12: $ G , h = scat t6 X , l = scat t6 Y ⇒ scat t6 Y ∈ fseq u $ by weaken [a2]
a13: $ … ⇒ l ∈ fseq u $ by wcel_eq_l [a8, a12]
a14: $ … ⇒ l ∊ fseq u $ by wcel_welc [a13]
a15: $ G ⇒ ∀ i (i ∊ cdm t6 → fv (scat t6 X) i = fv (scat t6 Y) i) $ by scat_agree [#4, #2, #3]
a16: $ G , h = scat t6 X , l = scat t6 Y ⇒ ∀ i (i ∊ cdm t6 → fv (scat t6 X) i = fv (scat t6 Y) i) $ by weaken [a15]
a17: $ G ⇒ fv nvf k5 = nadd (fv nvf t4) (fv nvf t3) $ by lrel_add_sem [#6]
a18: $ … ⇒ nadd (fv nvf t4) (fv nvf t3) = fv nvf k5 $ by eq_sym [a17]
a19: $ … ⇒ cdm t6 = fv nvf k5 $ by eq_trans [#5, a18]
a20: $ G , h = scat t6 X , l = scat t6 Y ⇒ cdm t6 = fv nvf k5 $ by weaken [a19]
a21: $ … ⇒ ∀ i (i ∊ fv nvf k5 → fv h i = fv l i) $ by fv_agree_eq [a20, a7, a8, a16]
a22: $ G , h = scat t6 X , l = scat t6 Y ⇒ ra_closed k5 z ∈ lrel $ by weaken [#7]
a23: $ G , h = scat t6 X , l = scat t6 Y ⇒ w ∊ lvals $ by weaken [#1]
a24: $ … ⇒ dt u M z w h = dt u M z w l $ by lrel_closed_sem [a22, a23, a11, a14, a21]
a25: $ G , h = scat t6 X , l = scat t6 Y ⇒ u = u $ by eq_refl
a26: $ G , h = scat t6 X , l = scat t6 Y ⇒ M = M $ by eq_refl
a27: $ G , h = scat t6 X , l = scat t6 Y ⇒ z = z $ by eq_refl
a28: $ G , h = scat t6 X , l = scat t6 Y ⇒ w = w $ by eq_refl
a29: $ … ⇒ dt u M z w (scat t6 X) = dt u M z w h $ by dt_eq [a25, a26, a27, a28, a7]
