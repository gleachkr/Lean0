lemma b11_nc_sarg (G: hyps) (M: class) (u w t1 t2 t3 d y j0 r r2: set): $ G ⇒ uadm u $ > $ G ⇒ ra_indapp t1 t2 t3 d y j0 ∈ lrel $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ > $ G ⇒ etel u (dnf u M) y w r = etel u (dnf u M) y w r2 $ > $ G ⇒ sarg u (dnf u M) y w r2 = sarg u (dnf u M) y w r $
----
s1: $ … ⇒ etel u (dnf u M) y w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w r ⟩ ⟩ ⟩ ∧ dt u M y w r = apn (fv r (nadd (nadd (fv nvf d) (fv nvf t3)) (fv nvf j0))) (sarg u (dnf u M) y w r) $ by lrel_indapp_sem [#2, #3, #4, #5]
s2: $ … ⇒ etel u (dnf u M) y w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w r ⟩ ⟩ ⟩ $ by and_elim_l [s1]
s3: $ … ⇒ etel u (dnf u M) y w r2 = etel u (dnf u M) y w r $ by eq_sym [#7]
s4: $ … ⇒ etel u (dnf u M) y w r2 = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w r ⟩ ⟩ ⟩ $ by eq_trans [s3, s2]
s5: $ … ⇒ isset (sarg u (dnf u M) y w r) $ by b11_nc_sargset [#1, #2, #4, #5]
fin: $ … ⇒ sarg u (dnf u M) y w r2 = sarg u (dnf u M) y w r $ by sarg_csn [s4, s5]

lemma b11_nc_dtl (G: hyps) (M X0: class) (u w t1 t2 t3 d y j0 q r x: set): $ G ⇒ uadm u $ > $ G ⇒ ra_indapp t1 t2 t3 d y j0 ∈ lrel $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dnf u M) y w q = etel u (dnf u M) y w r $ > $ G ⇒ sarg u (dnf u M) y w q = scat x X0 $ > $ G ⇒ dt u M y w r = apn (fv r (nadd (nadd (fv nvf d) (fv nvf t3)) (fv nvf j0))) (scat x X0) $
