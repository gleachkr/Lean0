q141: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel , ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) ⇒ cdm t5 = fv nvf t2 $ by ex_elim [q140, q139]
q142: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel , ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) ⇒ ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) $ by ax
q143: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel , ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) ⇒ cdm t5 = fv nvf t2 $ by ex_elim [q142, q141]
q144: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel , ∃ f ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) ⇒ ∃ f ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) $ by ax
q145: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel , ∃ f ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) ⇒ cdm t5 = fv nvf t2 $ by ex_elim [q144, q143]
q146: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel , ∃ x ∃ f ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) ⇒ ∃ x ∃ f ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) $ by ax
q147: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel , ∃ x ∃ f ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) ⇒ cdm t5 = fv nvf t2 $ by ex_elim [q146, q145]
q148: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel ⇒ ∃ x ∃ f ∃ g ∃ t (x ∊ da (fv E x2) w t4 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , t8 ⟩ ⟩ ⟩ ∈ etel u E x3 w (scons x t4) ∧ t5 = ssnoc f x) → cdm t5 = fv nvf t2 $ by imp_intro [q147]
q149: $ G , z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel ⇒ cdm t5 = fv nvf t2 $ by imp_elim [q148, q67]
q150: $ G , ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) ⇒ ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) $ by ax
q151: $ G , ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) ⇒ cdm t5 = fv nvf t2 $ by ex_elim [q150, q149]
q152: $ G , ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) ⇒ ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) $ by ax
q153: $ G , ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) ⇒ cdm t5 = fv nvf t2 $ by ex_elim [q152, q151]
q154: $ G , ∃ x3 ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) ⇒ ∃ x3 ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) $ by ax
q155: $ G , ∃ x3 ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) ⇒ cdm t5 = fv nvf t2 $ by ex_elim [q154, q153]
q156: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) ⇒ ∃ x2 ∃ x3 ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) $ by ax
q157: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) ⇒ cdm t5 = fv nvf t2 $ by ex_elim [q156, q155]
q158: $ G ⇒ cdm t5 = fv nvf t2 $ by or_elim [q1, q40, q157]

lemma b6_isort_fields (G: hyps) (E: class) (u w t1 t2 t3 t4 t5 t6 t7 t8: set): $ G ⇒ ra_isort t1 t2 t3 ∈ lrel $ > $ G ⇒ ⟨ t5 , ⟨ t6 , ⟨ t7 , t8 ⟩ ⟩ ⟩ ∈ etel u E t1 w t4 $ > $ G ⇒ cdm t5 = fv nvf t2 $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r ⇒ crn j ⊆ b6_cif u E w $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r ⇒ ra_isort z m l ∈ lrel $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r $ by ax
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r ⇒ cdm f = fv nvf m $ by b6_if_st [q4, q3, q5, q6, q7]
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ , ra_isort z m l ∈ lrel ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m $ by imp_intro [q8]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ra_isort z m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m $ by imp_intro [q9]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ∀ a (ra_isort z m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m) $ by all_intro [q10]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ∀ t ∀ a (ra_isort z m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m) $ by all_intro [q11]
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ∀ g ∀ t ∀ a (ra_isort z m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m) $ by all_intro [q12]
q14: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ∀ f ∀ g ∀ t ∀ a (ra_isort z m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m) $ by all_intro [q13]
q15: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ∀ r ∀ f ∀ g ∀ t ∀ a (ra_isort z m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m) $ by all_intro [q14]
q16: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ∀ l ∀ r ∀ f ∀ g ∀ t ∀ a (ra_isort z m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m) $ by all_intro [q15]
q17: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ∀ m ∀ l ∀ r ∀ f ∀ g ∀ t ∀ a (ra_isort z m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E z w r → cdm f = fv nvf m) $ by all_intro [q16]
q18: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ z ∊ b6_cif u E w $ by cab_intro [q17]
q19: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
q20: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b6_cif u E w $ by wcel_intro [q19, q18]
q21: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
q22: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cif u E w ⇒ ⟨ k , j ⟩ ∈ b6_cif u E w $ by isset_elim [q21, q20]
q23: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b6_cif u E w → ⟨ k , j ⟩ ∈ b6_cif u E w $ by imp_intro [q22]
q24: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b6_cif u E w → ⟨ k , j ⟩ ∈ b6_cif u E w $ by imp_intro [q23]
q25: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cif u E w → ⟨ k , j ⟩ ∈ b6_cif u E w $ by imp_intro [q24]
q26: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cif u E w → ⟨ k , j ⟩ ∈ b6_cif u E w) $ by all_intro [q25]
q27: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cif u E w → ⟨ k , j ⟩ ∈ b6_cif u E w) $ by all_intro [q26]
q28: $ G ⇒ isset ω $ by omega_set
q29: $ G ⇒ trees ω ⊆ b6_cif u E w $ by trees_ind_c [q28, q27]
q30: $ G ⇒ kr_isort ∈ ω $ by kr_isort_omega
q31: $ G ⇒ isset kr_isort $ by wcel_isset [q30]
q32: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, q31]
q33: $ G ⇒ t1 ∊ trees ω $ by and_elim_l [q32]
q34: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by and_elim_r [q32]
q35: $ G ⇒ t2 ∊ trees ω $ by and_elim_l [q34]
q36: $ G ⇒ t3 ∊ trees ω $ by and_elim_r [q34]
q37: $ G ⇒ t1 ∊ b6_cif u E w $ by subset_elim [q29, q33]
q38: $ G ⇒ ∀ m ∀ l ∀ r ∀ f ∀ g ∀ t ∀ a (ra_isort t1 m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E t1 w r → cdm f = fv nvf m) $ by cab_elim [q37]
q39: $ G ⇒ ∀ l ∀ r ∀ f ∀ g ∀ t ∀ a (ra_isort t1 t2 l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E t1 w r → cdm f = fv nvf t2) $ by all_elim [q38]
q40: $ G ⇒ ∀ r ∀ f ∀ g ∀ t ∀ a (ra_isort t1 t2 t3 ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E t1 w r → cdm f = fv nvf t2) $ by all_elim [q39]
q41: $ G ⇒ ∀ f ∀ g ∀ t ∀ a (ra_isort t1 t2 t3 ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E t1 w t4 → cdm f = fv nvf t2) $ by all_elim [q40]
q42: $ G ⇒ ∀ g ∀ t ∀ a (ra_isort t1 t2 t3 ∈ lrel → ⟨ t5 , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E t1 w t4 → cdm t5 = fv nvf t2) $ by all_elim [q41]
q43: $ G ⇒ ∀ t ∀ a (ra_isort t1 t2 t3 ∈ lrel → ⟨ t5 , ⟨ t6 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E t1 w t4 → cdm t5 = fv nvf t2) $ by all_elim [q42]
q44: $ G ⇒ ∀ a (ra_isort t1 t2 t3 ∈ lrel → ⟨ t5 , ⟨ t6 , ⟨ t7 , a ⟩ ⟩ ⟩ ∈ etel u E t1 w t4 → cdm t5 = fv nvf t2) $ by all_elim [q43]
q45: $ G ⇒ ra_isort t1 t2 t3 ∈ lrel → ⟨ t5 , ⟨ t6 , ⟨ t7 , t8 ⟩ ⟩ ⟩ ∈ etel u E t1 w t4 → cdm t5 = fv nvf t2 $ by all_elim [q44]
q46: $ G ⇒ ⟨ t5 , ⟨ t6 , ⟨ t7 , t8 ⟩ ⟩ ⟩ ∈ etel u E t1 w t4 → cdm t5 = fv nvf t2 $ by imp_elim [q45, #1]
q47: $ G ⇒ cdm t5 = fv nvf t2 $ by imp_elim [q46, #2]

def b6_V (.x: set): class = $ {x | x = x} $

lemma b6_inV (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ b6_V $
----
q1: $ G , z = A ⇒ z = z $ by eq_refl
q2: $ G ⇒ A ∈ b6_V $ by wcel_cab_intro [#1, q1]

lemma b6_swin_cdm (G: hyps) (D N: class) (r: set): $ G ⇒ cdm (swin r D N) = N $
----
q1: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} ⇒ v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} $ by ax
q2: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} ⇒ ∃ i (i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩) $ by cab_elim [q1]
q3: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ $ by ax
q4: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ i ∊ N $ by and_elim_l [q3]
q5: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ v = ⟨ i , fv r (nadd D i) ⟩ $ by and_elim_r [q3]
q6: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ v = ⟨ x , y ⟩ $ by ax
q7: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ ⟨ x , y ⟩ = v $ by eq_sym [q6]
q8: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ ⟨ x , y ⟩ = ⟨ i , fv r (nadd D i) ⟩ $ by eq_trans [q7, q5]
q9: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ isset x $ by isset_var
q10: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ isset i $ by isset_var
q11: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ x = i $ by opair_inj_l_c [q8, q9, q10]
q12: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ i = x $ by eq_sym [q11]
q13: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩ ⇒ x ∊ N $ by welc_eq_set [q12, q4]
q14: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , ∃ i (i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩) ⇒ ∃ i (i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩) $ by ax
q15: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} , ∃ i (i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩) ⇒ x ∊ N $ by ex_elim [q14, q13]
q16: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} ⇒ ∃ i (i ∊ N ∧ v = ⟨ i , fv r (nadd D i) ⟩) → x ∊ N $ by imp_intro [q15]
q17: $ G , ⟨ x , y ⟩ ∈ swin r D N , v = ⟨ x , y ⟩ , v ∊ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} ⇒ x ∊ N $ by imp_elim [q16, q2]
q18: $ G , ⟨ x , y ⟩ ∈ swin r D N ⇒ ⟨ x , y ⟩ ∈ swin r D N $ by ax
q19: $ G , ⟨ x , y ⟩ ∈ swin r D N ⇒ x ∊ N $ by wcel_elim [q18, q17]
q20: $ G , x ∊ cdm (swin r D N) ⇒ x ∊ cdm (swin r D N) $ by ax
q21: $ G , x ∊ cdm (swin r D N) ⇒ x ∊ N $ by cdm_elim [q20, q19]
q22: $ G , x ∊ N , y = fv r (nadd D x) , o = ⟨ x , y ⟩ ⇒ y = fv r (nadd D x) $ by ax
q23: $ G , x ∊ N , y = fv r (nadd D x) , o = ⟨ x , y ⟩ ⇒ o = ⟨ x , y ⟩ $ by ax
q24: $ G , x ∊ N , y = fv r (nadd D x) , o = ⟨ x , y ⟩ ⇒ x = x $ by eq_refl
q25: $ G , x ∊ N , y = fv r (nadd D x) , o = ⟨ x , y ⟩ ⇒ ⟨ x , y ⟩ = ⟨ x , fv r (nadd D x) ⟩ $ by opair_eq [q24, q22]
q26: $ G , x ∊ N , y = fv r (nadd D x) , o = ⟨ x , y ⟩ ⇒ o = ⟨ x , fv r (nadd D x) ⟩ $ by eq_trans [q23, q25]
q27: $ G , x ∊ N , y = fv r (nadd D x) , o = ⟨ x , y ⟩ ⇒ x ∊ N $ by ax
q28: $ G , x ∊ N , y = fv r (nadd D x) , o = ⟨ x , y ⟩ ⇒ x ∊ N ∧ o = ⟨ x , fv r (nadd D x) ⟩ $ by and_intro [q27, q26]
q29: $ G , x ∊ N , y = fv r (nadd D x) , o = ⟨ x , y ⟩ ⇒ ∃ i (i ∊ N ∧ o = ⟨ i , fv r (nadd D i) ⟩) $ by ex_intro [q28]
q30: $ G , x ∊ N , y = fv r (nadd D x) ⇒ isset ⟨ x , y ⟩ $ by opair_isset
q31: $ G , x ∊ N , y = fv r (nadd D x) ⇒ ⟨ x , y ⟩ ∈ {z | ∃ i (i ∊ N ∧ z = ⟨ i , fv r (nadd D i) ⟩)} $ by wcel_cab_intro [q30, q29]
q32: $ G , x ∊ N , y = fv r (nadd D x) ⇒ x ∊ cdm (swin r D N) $ by cdm_intro [q31]
q33: $ G , x ∊ N ⇒ isset r $ by isset_var
q34: $ G , x ∊ N ⇒ isset (fv r (nadd D x)) $ by fv_set_l [q33]
q35: $ G , x ∊ N ⇒ x ∊ cdm (swin r D N) $ by isset_elim [q34, q32]
q36: $ G ⇒ cdm (swin r D N) = N $ by eq_intro [q21, q35]

def b6_cia (U M W R Z: class) (.y .q .m .x: set): class = $ {y | ∀ q ∀ m ∀ x (ra_iargs q m x y ∈ lrel → etel U (dnf U M) x W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , Z ⟩ ⟩ ⟩ → etel U (dnf U M) y W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg U (dnf U M) y W R ⟩ ⟩ ⟩ ∧ sarg U (dnf U M) y W R ∈ fseq b6_V ∧ cdm (sarg U (dnf U M) y W R) = nadd (fv nvf m) (cdm Z))} $

lemma b6_ia_st (G: hyps) (M: class) (u w r z0 z k s t1 t2 t3: set): $ G ⇒ crn s ⊆ b6_cia u M w r z0 $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ z0 ∊ fseq b6_V $ > $ G ⇒ ra_iargs t1 t2 t3 z ∈ lrel $ > $ G ⇒ etel u (dnf u M) t3 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z0 ⟩ ⟩ ⟩ $ > $ G ⇒ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V ∧ cdm (sarg u (dnf u M) z w r) = nadd (fv nvf t2) (cdm z0) $
----
q1: $ G ⇒ ∃ x1 ∃ x2 (t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 ∃ x5 (t1 = x1 ∧ t2 = ⟨ kc_s , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_iargs x1 x3 x2 x4 ∈ lrel ∧ ra_closed x1 x5 ∈ lrel) $ by lrel_iargs_cases [#7]
q2: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 $ by ax
