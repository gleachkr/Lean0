q3: $ G ⇒ ⟨ kc_ind_ty , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ by ofsort_node2 [q1, q2, #1, #2]

lemma b6_sc1 (G: hyps) (a e: set): $ G ⇒ scons a ∅ = scons e ∅ $ > $ G ⇒ a = e $
----
q1: $ G ⇒ ∅ = ∅ $ by eq_refl
q2: $ G ⇒ fv (scons a ∅) (∅) = fv (scons e ∅) (∅) $ by fv_eq [#1, q1]
q3: $ G ⇒ isset ∅ $ by ax_empty
q4: $ G ⇒ isset a $ by isset_var
q5: $ G ⇒ isset ∅ $ by ax_empty
q6: $ G ⇒ fv (scons a ∅) ∅ = a $ by scons_fv_zero_c [q4, q5]
q7: $ G ⇒ isset ∅ $ by ax_empty
q8: $ G ⇒ isset e $ by isset_var
q9: $ G ⇒ isset ∅ $ by ax_empty
q10: $ G ⇒ fv (scons e ∅) ∅ = e $ by scons_fv_zero_c [q8, q9]
q11: $ G ⇒ a = fv (scons a ∅) (∅) $ by eq_sym [q6]
q12: $ G ⇒ a = fv (scons e ∅) (∅) $ by eq_trans [q11, q2]
q13: $ G ⇒ a = e $ by eq_trans [q12, q10]

lemma b6_sc2 (G: hyps) (a b e f: set): $ G ⇒ scons a (scons b ∅) = scons e (scons f ∅) $ > $ G ⇒ a = e ∧ b = f $
----
q1: $ G ⇒ ∅ = ∅ $ by eq_refl
q2: $ G ⇒ fv (scons a (scons b ∅)) (∅) = fv (scons e (scons f ∅)) (∅) $ by fv_eq [#1, q1]
q3: $ G ⇒ isset ∅ $ by ax_empty
q4: $ G ⇒ isset a $ by isset_var
q5: $ G ⇒ isset ∅ $ by ax_empty
q6: $ G ⇒ isset (scons b ∅) $ by scons_set [q5]
q7: $ G ⇒ fv (scons a (scons b ∅)) ∅ = a $ by scons_fv_zero_c [q4, q6]
q8: $ G ⇒ isset ∅ $ by ax_empty
q9: $ G ⇒ isset e $ by isset_var
q10: $ G ⇒ isset ∅ $ by ax_empty
q11: $ G ⇒ isset (scons f ∅) $ by scons_set [q10]
q12: $ G ⇒ fv (scons e (scons f ∅)) ∅ = e $ by scons_fv_zero_c [q9, q11]
q13: $ G ⇒ a = fv (scons a (scons b ∅)) (∅) $ by eq_sym [q7]
q14: $ G ⇒ a = fv (scons e (scons f ∅)) (∅) $ by eq_trans [q13, q2]
q15: $ G ⇒ a = e $ by eq_trans [q14, q12]
q16: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
q17: $ G ⇒ fv (scons a (scons b ∅)) (suc ∅) = fv (scons e (scons f ∅)) (suc ∅) $ by fv_eq [#1, q16]
q18: $ G ⇒ isset ∅ $ by ax_empty
q19: $ G ⇒ isset ∅ $ by ax_empty
q20: $ G ⇒ isset (scons b ∅) $ by scons_set [q19]
q21: $ G ⇒ isset ∅ $ by ax_empty
q22: $ G ⇒ isset a $ by isset_var
q23: $ G ⇒ fv (scons a (scons b ∅)) (suc ∅) = fv (scons b ∅) (∅) $ by scons_fv_suc_c [q22, q20, q21]
q24: $ G ⇒ isset b $ by isset_var
q25: $ G ⇒ isset ∅ $ by ax_empty
q26: $ G ⇒ fv (scons b ∅) ∅ = b $ by scons_fv_zero_c [q24, q25]
q27: $ G ⇒ fv (scons a (scons b ∅)) (suc ∅) = b $ by eq_trans [q23, q26]
q28: $ G ⇒ isset ∅ $ by ax_empty
q29: $ G ⇒ isset ∅ $ by ax_empty
q30: $ G ⇒ isset (scons f ∅) $ by scons_set [q29]
q31: $ G ⇒ isset ∅ $ by ax_empty
q32: $ G ⇒ isset e $ by isset_var
q33: $ G ⇒ fv (scons e (scons f ∅)) (suc ∅) = fv (scons f ∅) (∅) $ by scons_fv_suc_c [q32, q30, q31]
q34: $ G ⇒ isset f $ by isset_var
q35: $ G ⇒ isset ∅ $ by ax_empty
q36: $ G ⇒ fv (scons f ∅) ∅ = f $ by scons_fv_zero_c [q34, q35]
q37: $ G ⇒ fv (scons e (scons f ∅)) (suc ∅) = f $ by eq_trans [q33, q36]
q38: $ G ⇒ b = fv (scons a (scons b ∅)) (suc ∅) $ by eq_sym [q27]
q39: $ G ⇒ b = fv (scons e (scons f ∅)) (suc ∅) $ by eq_trans [q38, q17]
q40: $ G ⇒ b = f $ by eq_trans [q39, q37]
q41: $ G ⇒ a = e ∧ b = f $ by and_intro [q15, q40]

lemma b6_sc3 (G: hyps) (a b c e f g: set): $ G ⇒ scons a (scons b (scons c ∅)) = scons e (scons f (scons g ∅)) $ > $ G ⇒ a = e ∧ b = f ∧ c = g $
----
q1: $ G ⇒ ∅ = ∅ $ by eq_refl
q2: $ G ⇒ fv (scons a (scons b (scons c ∅))) (∅) = fv (scons e (scons f (scons g ∅))) (∅) $ by fv_eq [#1, q1]
