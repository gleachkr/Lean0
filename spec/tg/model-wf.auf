q56: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_ccw J M u w t1 t2 t3 t4 t5 t6 t7 t9 tp tt → ⟨ k , j ⟩ ∈ b6_ccw J M u w t1 t2 t3 t4 t5 t6 t7 t9 tp tt) $ by all_intro [q55]
q57: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_ccw J M u w t1 t2 t3 t4 t5 t6 t7 t9 tp tt → ⟨ k , j ⟩ ∈ b6_ccw J M u w t1 t2 t3 t4 t5 t6 t7 t9 tp tt) $ by all_intro [q56]
q58: $ G ⇒ isset ω $ by omega_set
q59: $ G ⇒ trees ω ⊆ b6_ccw J M u w t1 t2 t3 t4 t5 t6 t7 t9 tp tt $ by trees_ind_c [q58, q57]
q60: $ G ⇒ t0 ∊ b6_ccw J M u w t1 t2 t3 t4 t5 t6 t7 t9 tp tt $ by subset_elim [q59, #27]
q61: $ G ⇒ ∀ c ∀ d ∀ f ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_cwf t1 t2 t3 t4 t5 c d t0 ∈ lrel3 J → c ∊ trees ω → d ∊ trees ω → f ∊ fseq u → cdm f = fv nvf d → scat f (scat t6 t9) ∈ sat u M c w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f (scat t6 t7)) → x8 ∊ b6_Qc u M w tp tt t5) $ by cab_elim [q60]
q62: $ G ⇒ ∀ d ∀ f ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_cwf t1 t2 t3 t4 t5 c0 d t0 ∈ lrel3 J → c0 ∊ trees ω → d ∊ trees ω → f ∊ fseq u → cdm f = fv nvf d → scat f (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f (scat t6 t7)) → x8 ∊ b6_Qc u M w tp tt t5) $ by all_elim [q61]
q63: $ G ⇒ ∀ f ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_cwf t1 t2 t3 t4 t5 c0 d0 t0 ∈ lrel3 J → c0 ∊ trees ω → d0 ∊ trees ω → f ∊ fseq u → cdm f = fv nvf d0 → scat f (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f (scat t6 t7)) → x8 ∊ b6_Qc u M w tp tt t5) $ by all_elim [q62]
q64: $ G ⇒ ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_cwf t1 t2 t3 t4 t5 c0 d0 t0 ∈ lrel3 J → c0 ∊ trees ω → d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → x8 ∊ b6_Qc u M w tp tt t5) $ by all_elim [q63]
q65: $ G ⇒ ∀ x6 ∀ x7 ∀ x8 (ra_cwf t1 t2 t3 t4 t5 c0 d0 t0 ∈ lrel3 J → c0 ∊ trees ω → d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → x8 ∊ b6_Qc u M w tp tt t5) $ by all_elim [q64]
q66: $ G ⇒ ∀ x7 ∀ x8 (ra_cwf t1 t2 t3 t4 t5 c0 d0 t0 ∈ lrel3 J → c0 ∊ trees ω → d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → x8 ∊ b6_Qc u M w tp tt t5) $ by all_elim [q65]
q67: $ G ⇒ ∀ x8 (ra_cwf t1 t2 t3 t4 t5 c0 d0 t0 ∈ lrel3 J → c0 ∊ trees ω → d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ p7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → x8 ∊ b6_Qc u M w tp tt t5) $ by all_elim [q66]
q68: $ G ⇒ ra_cwf t1 t2 t3 t4 t5 c0 d0 t0 ∈ lrel3 J → c0 ∊ trees ω → d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → p8 ∊ b6_Qc u M w tp tt t5 $ by all_elim [q67]
q69: $ G ⇒ c0 ∊ trees ω → d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → p8 ∊ b6_Qc u M w tp tt t5 $ by imp_elim [q68, #19]
q70: $ G ⇒ d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → p8 ∊ b6_Qc u M w tp tt t5 $ by imp_elim [q69, #20]
q71: $ G ⇒ f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → p8 ∊ b6_Qc u M w tp tt t5 $ by imp_elim [q70, #21]
q72: $ G ⇒ cdm f0 = fv nvf d0 → scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → p8 ∊ b6_Qc u M w tp tt t5 $ by imp_elim [q71, #22]
q73: $ G ⇒ scat f0 (scat t6 t9) ∈ sat u M c0 w → t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → p8 ∊ b6_Qc u M w tp tt t5 $ by imp_elim [q72, #23]
q74: $ G ⇒ t0 ∊ ofsort lsig lopen ks_expr → ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → p8 ∊ b6_Qc u M w tp tt t5 $ by imp_elim [q73, #24]
q75: $ G ⇒ ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w (scat f0 (scat t6 t7)) → p8 ∊ b6_Qc u M w tp tt t5 $ by imp_elim [q74, #25]
q76: $ G ⇒ p8 ∊ b6_Qc u M w tp tt t5 $ by imp_elim [q75, #26]

lemma b6_wf_trees (G: hyps) (J C D: class): $ G ⇒ ra_ind_wf C D ∈ lrel3 J $ > $ G ⇒ C ∈ trees ω $
----
q1: $ G ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
q2: $ G ⇒ horn (lprog3 J) ⊆ latoms $ by horn_sub [q1]
q3: $ G ⇒ ra_ind_wf C D ∈ latoms $ by wcel_subset [q2, #1]
q4: $ G ⇒ kr_ind_wf ∈ ω $ by kr_ind_wf_omega
q5: $ G ⇒ isset kr_ind_wf $ by wcel_isset [q4]
q6: $ G ⇒ isset ∅ $ by ax_empty
q7: $ G ⇒ isset (scons D ∅) $ by scons_set [q6]
q8: $ G ⇒ isset (scons C (scons D ∅)) $ by scons_set [q7]
q9: $ G ⇒ kr_ind_wf ∈ ω ∧ scons C (scons D ∅) ∈ fseq (trees ω) $ by cxp_elim_pair_c [q3, q5, q8]
q10: $ G ⇒ scons C (scons D ∅) ∈ fseq (trees ω) $ by and_elim_r [q9]
q11: $ G ⇒ crn (scons C (scons D ∅)) ⊆ trees ω $ by fseq_crn_c [q10]
q12: $ G ⇒ isset ω $ by omega_set
q13: $ G ⇒ C ∈ trees ω $ by crn_scons_head_trees [q12, q11]

lemma b6_intys (G: hyps) (d tb tq te tn tm: set): $ G ⇒ ra_ind_data d tb tq te ∈ lrel $ > $ G ⇒ ra_ntys te tn tm ∈ lrel $ > $ G ⇒ intys d = fv nvf tn $
----
q1: $ G , x ∊ intys d ⇒ x ∊ intys d $ by ax
q2: $ G , x ∊ intys d ⇒ ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) $ by cab_elim [q1]
q3: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n $ by ax
q4: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ iprt d p t $ by and_elim_l [q3]
q5: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n $ by and_elim_r [q3]
q6: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ ra_ntys t n m ∈ lrel $ by and_elim_l [q5]
q7: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ x ∊ fv nvf n $ by and_elim_r [q5]
q8: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ ra_ind_data d tb tq te ∈ lrel $ by weaken [#1]
q9: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ iprt d tq te $ by ex_intro [q8]
q10: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ tq = p ∧ te = t $ by iprt_det [q9, q4]
q11: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ te = t $ by and_elim_r [q10]
q12: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ t = te $ by eq_sym [q11]
q13: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ n = n $ by eq_refl
q14: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ m = m $ by eq_refl
q15: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ ra_ntys t n m = ra_ntys te n m $ by ra_ntys_eq [q12, q13, q14]
q16: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ ra_ntys te n m ∈ lrel $ by wcel_eq_l [q15, q6]
q17: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ ra_ntys te tn tm ∈ lrel $ by weaken [#2]
q18: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ tn = n ∧ tm = m $ by lrel_ntys_det [q17, q16]
q19: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ tn = n $ by and_elim_l [q18]
q20: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ nvf = nvf $ by eq_refl
q21: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ n = tn $ by eq_sym [q19]
q22: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ fv nvf n = fv nvf tn $ by fv_eq [q20, q21]
q23: $ G , x ∊ intys d , iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n ⇒ x ∊ fv nvf tn $ by welc_eq [q22, q7]
q24: $ G , x ∊ intys d , ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) ⇒ ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) $ by ax
q25: $ G , x ∊ intys d , ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) ⇒ x ∊ fv nvf tn $ by ex_elim [q24, q23]
q26: $ G , x ∊ intys d , ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) ⇒ ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) $ by ax
q27: $ G , x ∊ intys d , ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) ⇒ x ∊ fv nvf tn $ by ex_elim [q26, q25]
q28: $ G , x ∊ intys d , ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) ⇒ ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) $ by ax
q29: $ G , x ∊ intys d , ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) ⇒ x ∊ fv nvf tn $ by ex_elim [q28, q27]
q30: $ G , x ∊ intys d , ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) ⇒ ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) $ by ax
q31: $ G , x ∊ intys d , ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) ⇒ x ∊ fv nvf tn $ by ex_elim [q30, q29]
q32: $ G , x ∊ intys d ⇒ ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) → x ∊ fv nvf tn $ by imp_intro [q31]
q33: $ G , x ∊ intys d ⇒ x ∊ fv nvf tn $ by imp_elim [q32, q2]
q34: $ G , x ∊ fv nvf tn ⇒ ra_ind_data d tb tq te ∈ lrel $ by weaken [#1]
q35: $ G , x ∊ fv nvf tn ⇒ iprt d tq te $ by ex_intro [q34]
q36: $ G , x ∊ fv nvf tn ⇒ ra_ntys te tn tm ∈ lrel $ by weaken [#2]
q37: $ G , x ∊ fv nvf tn ⇒ x ∊ fv nvf tn $ by ax
q38: $ G , x ∊ fv nvf tn ⇒ ra_ntys te tn tm ∈ lrel ∧ x ∊ fv nvf tn $ by and_intro [q36, q37]
q39: $ G , x ∊ fv nvf tn ⇒ iprt d tq te ∧ ra_ntys te tn tm ∈ lrel ∧ x ∊ fv nvf tn $ by and_intro [q35, q38]
q40: $ G , x ∊ fv nvf tn ⇒ ∃ m (iprt d tq te ∧ ra_ntys te tn m ∈ lrel ∧ x ∊ fv nvf tn) $ by ex_intro [q39]
q41: $ G , x ∊ fv nvf tn ⇒ ∃ n ∃ m (iprt d tq te ∧ ra_ntys te n m ∈ lrel ∧ x ∊ fv nvf n) $ by ex_intro [q40]
q42: $ G , x ∊ fv nvf tn ⇒ ∃ t ∃ n ∃ m (iprt d tq t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) $ by ex_intro [q41]
q43: $ G , x ∊ fv nvf tn ⇒ ∃ p ∃ t ∃ n ∃ m (iprt d p t ∧ ra_ntys t n m ∈ lrel ∧ x ∊ fv nvf n) $ by ex_intro [q42]
q44: $ G , x ∊ fv nvf tn ⇒ x ∊ intys d $ by cab_intro [q43]
q45: $ G ⇒ intys d = fv nvf tn $ by eq_intro [q33, q44]

lemma b6_vals (G: hyps) {v i: set} (M: class) (u w d: set): $ G ⇒ uadm u $ > $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ∈ fseq u ∧ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) = intys d ∧ ∀ i (i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w) $
----
q1: $ G , v ∊ intys d ⇒ uadm u $ by weaken [#1]
q2: $ G , v ∊ intys d ⇒ d ∈ ofsort lsig lopen ks_ind $ by weaken [#2]
q3: $ G , v ∊ intys d ⇒ w ∊ lvals $ by weaken [#3]
q4: $ G , v ∊ intys d ⇒ w ∈ lvals $ by welc_wcel [q3]
q5: $ G , v ∊ intys d ⇒ ityv u (dnf u M) d v w ∈ u $ by ityv_universe [q1, q2, q4]
q6: $ G ⇒ v ∊ intys d → ityv u (dnf u M) d v w ∈ u $ by imp_intro [q5]
q7: $ G ⇒ ∀ v (v ∊ intys d → ityv u (dnf u M) d v w ∈ u) $ by all_intro [q6]
q8: $ G ⇒ fn_into (cgr v (ityv u (dnf u M) d v w)) (intys d) u $ by cgr_fn_into [q7]
q9: $ G ⇒ intys d ∈ ω $ by intys_omega
q10: $ G ⇒ cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ∈ fseq u $ by cres_fseq [q9, q8]
q11: $ G ⇒ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) ⊆ intys d $ by cres_cdm
q12: $ G ⇒ fn_into (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) (intys d) u $ by fn_into_cres [q8]
q13: $ G ⇒ intys d ⊆ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) $ by fn_into_cdm [q12]
q14: $ G ⇒ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) = intys d $ by subset_antisym [q11, q13]
q15: $ G , i ∊ intys d ⇒ i ∊ intys d $ by ax
q16: $ G , i ∊ intys d ⇒ isset (ityv u (dnf u M) d i w) $ by ityv_set
q17: $ G , i ∊ intys d ⇒ fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w $ by fv_cres_cgr [q15, q16]
q18: $ G ⇒ i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w $ by imp_intro [q17]
q19: $ G ⇒ ∀ i (i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w) $ by all_intro [q18]
q20: $ G ⇒ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) = intys d ∧ ∀ i (i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w) $ by and_intro [q14, q19]
q21: $ G ⇒ cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ∈ fseq u ∧ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) = intys d ∧ ∀ i (i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w) $ by and_intro [q10, q20]

lemma b6_vt_ok (G: hyps) {i: set} (H: class) (u w d tv: set): $ G ⇒ hty ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ uadm u $ > $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ cdm tv = intys d $ > $ G ⇒ ∀ i (i ∊ intys d → fv tv i = ityv u (dnf u (mcv H)) d i w) $ > $ G ⇒ b6_vt u (mcv H) w d tv $
----
q1: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ cdm tv = intys d $ by weaken [#6]
q2: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ i ∊ cdm tv $ by ax
q3: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ i ∊ intys d $ by welc_eq [q1, q2]
q4: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ ∀ i (i ∊ intys d → fv tv i = ityv u (dnf u (mcv H)) d i w) $ by weaken [#7]
q5: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ i ∊ intys d → fv tv i = ityv u (dnf u (mcv H)) d i w $ by all_elim [q4]
q6: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ fv tv i = ityv u (dnf u (mcv H)) d i w $ by imp_elim [q5, q3]
q7: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ d ∈ ofsort lsig lopen ks_ind $ by weaken [#4]
q8: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ d ∊ ofsort lsig lopen ks_ind $ by wcel_welc [q7]
q9: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ d ∈ trees ω $ by lsig_ofsort_trees [q8]
q10: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ b ∊ trees ω $ by ax
q11: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ b ∈ trees ω $ by welc_wcel [q10]
q12: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ w ∊ lvals $ by weaken [#5]
q13: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ w ∈ lvals $ by welc_wcel [q12]
q14: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ hty ⊆ H $ by weaken [#1]
q15: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ functional H $ by weaken [#2]
q16: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ ∅ ∈ fseq u $ by fseq_empty
q17: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons d (scons b ∅) ⟩ w ∅ = mclip u (ityv u (dnf u (mcv H)) d (fv nvf b) w) $ by dt_ind_ty_c [q14, q15, q9, q11, q13, q16]
q18: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ uadm u $ by weaken [#3]
q19: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ d ∈ ofsort lsig lopen ks_ind $ by weaken [#4]
q20: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ ityv u (dnf u (mcv H)) d (fv nvf b) w ∈ u $ by ityv_universe [q18, q19, q13]
q21: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ mclip u (ityv u (dnf u (mcv H)) d (fv nvf b) w) = ityv u (dnf u (mcv H)) d (fv nvf b) w $ by mclip_in [q20]
q22: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ d = d $ by eq_refl
q23: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ fv nvf b = i $ by ax
q24: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ w = w $ by eq_refl
q25: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ ityv u (dnf u (mcv H)) d (fv nvf b) w = ityv u (dnf u (mcv H)) d i w $ by ityv_eq [q22, q23, q24]
q26: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons d (scons b ∅) ⟩ w ∅ = ityv u (dnf u (mcv H)) d (fv nvf b) w $ by eq_trans [q17, q21]
q27: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons d (scons b ∅) ⟩ w ∅ = ityv u (dnf u (mcv H)) d i w $ by eq_trans [q26, q25]
q28: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ ityv u (dnf u (mcv H)) d i w = fv tv i $ by eq_sym [q6]
q29: $ G , i ∊ cdm tv , b ∊ trees ω , fv nvf b = i ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons d (scons b ∅) ⟩ w ∅ = fv tv i $ by eq_trans [q27, q28]
q30: $ G , i ∊ cdm tv , b ∊ trees ω ⇒ fv nvf b = i → dt u (mcv H) ⟨ kc_ind_ty , scons d (scons b ∅) ⟩ w ∅ = fv tv i $ by imp_intro [q29]
q31: $ G , i ∊ cdm tv ⇒ b ∊ trees ω → fv nvf b = i → dt u (mcv H) ⟨ kc_ind_ty , scons d (scons b ∅) ⟩ w ∅ = fv tv i $ by imp_intro [q30]
q32: $ G ⇒ i ∊ cdm tv → b ∊ trees ω → fv nvf b = i → dt u (mcv H) ⟨ kc_ind_ty , scons d (scons b ∅) ⟩ w ∅ = fv tv i $ by imp_intro [q31]
q33: $ G ⇒ ∀ b (i ∊ cdm tv → b ∊ trees ω → fv nvf b = i → dt u (mcv H) ⟨ kc_ind_ty , scons d (scons b ∅) ⟩ w ∅ = fv tv i) $ by all_intro [q32]
q34: $ G ⇒ b6_vt u (mcv H) w d tv $ by all_intro [q33]

lemma b6_itc_len (G: hyps) (M: class) (u w d tb tq te tnp tj ta tF tm tl: set): $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ ra_ind_data d tb tq te ∈ lrel $ > $ G ⇒ ra_clen tq tnp ∈ lrel $ > $ G ⇒ ityf d tj tF $ > $ G ⇒ ra_isort tF tm tl ∈ lrel $ > $ G ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u M) d w $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ cdm ta = nadd (fv nvf tm) (fv nvf tnp) $
----
q1: $ G , z = ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ⇒ z = ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ $ by ax
q2: $ G , z = ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ = z $ by eq_sym [q1]
q3: $ G , z = ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u M) d w $ by weaken [#6]
q4: $ G , z = ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ⇒ z ∈ itc u (dnf u M) d w $ by wcel_eq_l [q2, q3]
q5: $ G , z = ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ⇒ z ∊ itc u (dnf u M) d w $ by wcel_welc [q4]
