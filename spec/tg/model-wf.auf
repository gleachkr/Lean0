q149: $ G , ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $ by ex_elim [q148, q147]
q150: $ G , ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) ⇒ ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) $ by ax
q151: $ G , ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $ by ex_elim [q150, q149]
q152: $ G , ∃ g ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) ⇒ ∃ g ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) $ by ax
q153: $ G , ∃ g ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $ by ex_elim [q152, q151]
q154: $ G , ∃ d ∃ g ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) ⇒ ∃ d ∃ g ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) $ by ax
q155: $ G , ∃ d ∃ g ∃ e ∃ h ∃ f ∃ i (z = ⟨ kc_tcons , scons g (scons h (scons f ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i ∅ ⟩ ∧ t3 = d ∧ t4 = e ∧ ra_nth_ty f i d e ∈ lrel) ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $ by ex_elim [q154, q153]
q156: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $ by or_elim [q1, q62, q155]

lemma b6_tc_nth (G: hyps) (t0 t1 t2 t3 t4 t5: set): $ G ⇒ ra_tys_closed t0 t1 ∈ lrel $ > $ G ⇒ ra_nth_ty t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ ra_pis t0 t3 t5 ∈ lrel $ > $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ t5 ∈ lrel $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ crn j ⊆ b6_ctc t0 $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ ra_tys_closed t0 z ∈ lrel $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ ra_nth_ty z x6 x7 x8 ∈ lrel $ by ax
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ ra_pis t0 x7 x9 ∈ lrel $ by ax
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel , ra_pis t0 x7 x9 ∈ lrel ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel $ by b6_tc_st [q4, q3, q5, q6, q7, q8]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel , ra_nth_ty z x6 x7 x8 ∈ lrel ⇒ ra_pis t0 x7 x9 ∈ lrel → ra_closed ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel $ by imp_intro [q9]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ , ra_tys_closed t0 z ∈ lrel ⇒ ra_nth_ty z x6 x7 x8 ∈ lrel → ra_pis t0 x7 x9 ∈ lrel → ra_closed ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel $ by imp_intro [q10]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ ⇒ ra_tys_closed t0 z ∈ lrel → ra_nth_ty z x6 x7 x8 ∈ lrel → ra_pis t0 x7 x9 ∈ lrel → ra_closed ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel $ by imp_intro [q11]
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_ctc t0 , z = ⟨ k , j ⟩ ⇒ ∀ x9 (ra_tys_closed t0 z ∈ lrel → ra_nth_ty z x6 x7 x8 ∈ lrel → ra_pis t0 x7 x9 ∈ lrel → ra_closed ⟨ kc_nz , ∅ ⟩ x9 ∈ lrel) $ by all_intro [q12]
