lemma b14_ne_s {i m q g: set} (G: hyps) (D Y: class) (t3 o y: set): $ G ⇒ b12_ne D t3 Y $ > $ G ⇒ y = Y $ > $ G ⇒ o = D $ > $ G ⇒ ∀ i ∀ m ∀ q (ra_nidx o i m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ g (g ∊ apn (fv y (fv nvf i)) q → ¬ g = ∅)) $
