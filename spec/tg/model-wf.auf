--| The spines `x` such that `sty C H A x y` makes `y` a sort's telescope, `x` a spine
--| with arguments over `U`, and the paths of `y` followed by the arguments paths of `A`.
def b5_sy (U M W J C H A R L: class) (.x .y .m .f .g .t .a .i .d .n: set): class = $ {x | x ∊ ofsort lsig lopen ks_expr → ∀ y (ra_sty C H A x y ∈ lrel3 J → (∃ m (ra_isort y m L ∈ lrel)) ∧ etel U (dnf U M) x W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg U (dnf U M) x W R ⟩ ⟩ ⟩ ∧ sarg U (dnf U M) x W R ∈ fseq U ∧ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) y W R → ∃ i ∃ d ∃ n (⟨ scat f (sarg U (dnf U M) x W R) , ⟨ i , ⟨ d , n ⟩ ⟩ ⟩ ∈ etel U (dnf U M) A W R)))} $

lemma b5_sc_nil {m f g t a i d n: set} (H: hyps) (J M K S: class) (u w c h q r l o z k j e x0 x1 x2: set): $ H ⇒ jval u M J $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ r ∊ sat u M c w $ > $ H ⇒ ra_isort q o l ∈ lrel $ > $ H ⇒ h = ⟨ K , S ⟩ $ > $ H ⇒ ⟨ K , S ⟩ ∈ trees ω $ > $ H ⇒ ¬ K = kc_pi $ > $ H ⇒ ¬ K = kc_app $ > $ H ⇒ j ∊ fseq (trees ω) $ > $ H ⇒ crn j ⊆ b5_sy u M w J c h q r l $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ H ⇒ ra_sty c h q z e ∈ lrel3 J $ > $ H ⇒ (c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2) → (∃ m (ra_isort e m l ∈ lrel)) ∧ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq u ∧ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) e w r → ∃ i ∃ d ∃ n (⟨ scat f (sarg u (dnf u M) z w r) , ⟨ i , ⟨ d , n ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w r)) $
----
f1: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ jval u M J $ by weaken [#1]
f2: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ uadm u $ by weaken [#2]
f3: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ w ∊ lvals $ by weaken [#3]
f4: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ r ∊ sat u M c w $ by weaken [#4]
f5: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ ra_isort q o l ∈ lrel $ by weaken [#5]
f6: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ h = ⟨ K , S ⟩ $ by weaken [#6]
f7: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ ⟨ K , S ⟩ ∈ trees ω $ by weaken [#7]
f8: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ ¬ K = kc_pi $ by weaken [#8]
f9: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ ¬ K = kc_app $ by weaken [#9]
f10: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ j ∊ fseq (trees ω) $ by weaken [#10]
f11: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ crn j ⊆ b5_sy u M w J c h q r l $ by weaken [#11]
f12: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ z = ⟨ k , j ⟩ $ by weaken [#12]
f13: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ z ∊ ofsort lsig lopen ks_expr $ by weaken [#13]
f14: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ ra_sty c h q z e ∈ lrel3 J $ by weaken [#14]
p0: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 $ by ax
q1: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ c = x0 $ by and_elim_l [p0]
qr1: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 $ by and_elim_r [p0]
q2: $ H , c = x0 ∧ h = x1 ∧ q = x2 ∧ z = x1 ∧ e = x2 ⇒ h = x1 $ by and_elim_l [qr1]
