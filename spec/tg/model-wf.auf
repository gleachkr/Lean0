j1: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ x = x $ by eq_refl
j2: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ v = ⟨ g , ⟨ t , a ⟩ ⟩ $ by ax
j3: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ ⟨ x , v ⟩ = ⟨ x , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ $ by opair_eq [j1, j2]
j4: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q $ by ax
j5: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ ⟨ x , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) f w q $ by wcel_eq_l [j3, j4]
j6: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ isset w $ by isset_var
j7: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ f ∈ trees ω $ by weaken [g12]
j8: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ x ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm x ∧ cdm t = cdm x $ by etel_fseq_c [j6, j7, j5]
j9: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ x ∊ fseq u $ by and_elim_l [j8]
j10: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ q ∊ fseq u $ by weaken [f3]
j11: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ scat x q ∈ fseq u $ by scat_fseq [j9, j10]
j12: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ isset (scat x q) $ by wcel_isset [j11]
j13: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ ⇒ apn (ity u (dnf u (mcv H)) d kk w) (scat x q) = apn (apn (ity u (dnf u (mcv H)) d kk w) q) x $ by apn_scat [j9, j10]
k1: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ m = scat x q $ by ax
k2: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ scat x q = m $ by eq_sym [k1]
k3: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ scat x q ∈ fseq u $ by weaken [j11]
k4: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ m ∈ fseq u $ by wcel_eq_l [k2, k3]
k5: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ m ∊ fseq u $ by wcel_welc [k4]
k6: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ isset (ity u (dnf u (mcv H)) d kk w) $ by weaken [g19]
k7: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ isset (apn (ity u (dnf u (mcv H)) d kk w) m) $ by b3_apn_set [k6, k5]
k8: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ ity u (dnf u (mcv H)) d kk w = ity u (dnf u (mcv H)) d kk w $ by eq_refl
k9: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ apn (ity u (dnf u (mcv H)) d kk w) m = apn (ity u (dnf u (mcv H)) d kk w) (scat x q) $ by apn_eq [k8, k1]
k10: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ apn (ity u (dnf u (mcv H)) d kk w) (scat x q) = apn (apn (ity u (dnf u (mcv H)) d kk w) q) x $ by weaken [j13]
k11: $ G , q ∊ esat u (dnf u (mcv H)) b w , ⟨ x , v ⟩ ∈ etel u (dnf u (mcv H)) f w q , v = ⟨ g , ⟨ t , a ⟩ ⟩ , m = scat x q ⇒ apn (ity u (dnf u (mcv H)) d kk w) m = apn (apn (ity u (dnf u (mcv H)) d kk w) q) x $ by eq_trans [k9, k10]
