l7: $ G , p ∧ q ∧ r ⇒ q ∧ r $ by and_elim_r [l5]
l8: $ G , p ∧ q ∧ r ⇒ q $ by and_elim_l [l7]
l9: $ G , p ∧ q ∧ r ⇒ r $ by and_elim_r [l7]
