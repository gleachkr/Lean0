def b12_gs (U E D W X: class) (.g .j .c .k .f .t .a: set): class = $ {g | ∃ j (j ∊ ω ∧ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E k W X)))} $

lemma b12_un (G: hyps) (H J C D W R: class) (u: set): $ G ⇒ iwf u H J C D W R $ > $ G ⇒ ¬ ilev D W = ∅ $ > $ G ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $
----
i1: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W $ by ax
i2: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ ityf D ∅ f $ by and_elim_l [i1]
i3: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ ra_isort f k l ∈ lrel ∧ y ∊ lv l W $ by and_elim_r [i1]
i4: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ ra_isort f k l ∈ lrel $ by and_elim_l [i3]
i5: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ iwf u H J C D W R $ by weaken [#1]
i6: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ W ∈ lvals $ by iwf_lvals [i5]
i7: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ ilev D W = lv l W $ by ilev_eq [i2, i4, i6]
k1: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , w = W , w ∊ lvals ⇒ isset l $ by isset_var
k2: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , w = W , w ∊ lvals ⇒ w ∊ lvals $ by ax
k3: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , w = W , w ∊ lvals ⇒ lv l w ∈ ω $ by lv_omega [k1, k2]
k4: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , w = W , w ∊ lvals ⇒ w = W $ by ax
k4b: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , w = W , w ∊ lvals ⇒ l = l $ by eq_refl
k5: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , w = W , w ∊ lvals ⇒ lv l w = lv l W $ by lv_eq [k4b, k4]
k6: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , w = W , w ∊ lvals ⇒ lv l W ∈ ω $ by wcel_eq_l [k5, k3]
i8: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ lv l W ∈ ω $ by wcel_elim [i6, k6]
i9: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ lv l W = ilev D W $ by eq_sym [i7]
i10: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ ilev D W ∈ ω $ by wcel_eq_l [i9, i8]
n1: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω ⇒ n ∊ ω $ by ax
n2: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω ⇒ n = ∅ ∨ ∃ m (m ∊ ω ∧ n = suc m) $ by omega_cases [n1]
n3: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω ⇒ n = ilev D W $ by ax
n4: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω ⇒ ilev D W = n $ by eq_sym [n3]
z1: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , n = ∅ ⇒ n = ∅ $ by ax
z2: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , n = ∅ ⇒ ilev D W = n $ by weaken [n4]
z3: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , n = ∅ ⇒ ilev D W = ∅ $ by eq_trans [z2, z1]
z4: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , n = ∅ ⇒ ¬ ilev D W = ∅ $ by weaken [#2]
z5: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , n = ∅ ⇒ ⊥ $ by not_elim [z4, z3]
z6: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , n = ∅ ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by bot_elim [z5]
s1: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ m ∊ ω ∧ n = suc m $ by ax
s2: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ m ∊ ω $ by and_elim_l [s1]
s3: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ n = suc m $ by and_elim_r [s1]
s4: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ universe (fv uni (suc m)) $ by uni_universe [s2]
s5: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ ω ∈ fv uni (suc m) $ by uni_omega [s2]
s6: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ ilev D W = n $ by weaken [n4]
s7: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ ilev D W = suc m $ by eq_trans [s6, s3]
s8: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ suc m = ilev D W $ by eq_sym [s7]
s9: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ uni = uni $ by eq_refl
s10: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ fv uni (suc m) = fv uni (ilev D W) $ by fv_eq [s9, s8]
s11: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ universe (fv uni (ilev D W)) $ by universe_eq [s10, s4]
s12: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ ω ∈ fv uni (ilev D W) $ by wcel_eq_r [s10, s5]
s13: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , m ∊ ω ∧ n = suc m ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by and_intro [s11, s12]
s14: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , ∃ m (m ∊ ω ∧ n = suc m) ⇒ ∃ m (m ∊ ω ∧ n = suc m) $ by ax
s15: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω , ∃ m (m ∊ ω ∧ n = suc m) ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by ex_elim [s14, s13]
n5: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W , n = ilev D W , n ∊ ω ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by or_elim [n2, z6, s15]
i11: $ G , y ∊ ilev D W , ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by wcel_elim [i10, n5]
o2a: $ G , y ∊ ilev D W , ∃ l (ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W) ⇒ ∃ l (ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W) $ by ax
o2: $ G , y ∊ ilev D W , ∃ l (ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W) ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by ex_elim [o2a, i11]
o1a: $ G , y ∊ ilev D W , ∃ k ∃ l (ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W) ⇒ ∃ k ∃ l (ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W) $ by ax
o1: $ G , y ∊ ilev D W , ∃ k ∃ l (ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W) ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by ex_elim [o1a, o2]
e0: $ G , y ∊ ilev D W ⇒ y ∊ {y | ∃ f ∃ k ∃ l (ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W)} $ by ax
e1: $ G , y ∊ ilev D W ⇒ ∃ f ∃ k ∃ l (ityf D ∅ f ∧ ra_isort f k l ∈ lrel ∧ y ∊ lv l W) $ by cab_elim [e0]
e2: $ G , y ∊ ilev D W ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by ex_elim [e1, o1]
c1: $ G , ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) , y ∊ ilev D W ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by weaken [e2]
c2: $ G , ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) , y ∊ ilev D W ⇒ ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) $ by ax
c3: $ G , ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) , y ∊ ilev D W ⇒ ⊥ $ by not_elim [c2, c1]
c4: $ G , ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) ⇒ ilev D W = ∅ $ by empty_eq_intro [c3]
c5: $ G , ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) ⇒ ¬ ilev D W = ∅ $ by weaken [#2]
c6: $ G , ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) ⇒ ⊥ $ by not_elim [c5, c4]
c7: $ G , ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by bot_elim [c6]
c8: $ G , universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by ax
c9: $ G ⇒ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) ∨ ¬ (universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W)) $ by excluded_middle
c10: $ G ⇒ universe (fv uni (ilev D W)) ∧ ω ∈ fv uni (ilev D W) $ by or_elim [c9, c8, c7]

lemma b12_gs_in (G: hyps) (E D W X: class) (u j0 c0 k0 f0 g0 t0 a0: set): $ G ⇒ ictk D j0 c0 k0 $ > $ G ⇒ ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ ∈ etel u E k0 W X $ > $ G ⇒ g0 ∊ b12_gs u E D W X $
----
l1: $ G ⇒ ictk D j0 c0 k0 ∧ ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ ∈ etel u E k0 W X $ by and_intro [#1, #2]
l2: $ G ⇒ ∃ a (ictk D j0 c0 k0 ∧ ⟨ f0 , ⟨ g0 , ⟨ t0 , a ⟩ ⟩ ⟩ ∈ etel u E k0 W X) $ by ex_intro [l1]
l3: $ G ⇒ ∃ t ∃ a (ictk D j0 c0 k0 ∧ ⟨ f0 , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k0 W X) $ by ex_intro [l2]
l4: $ G ⇒ ∃ f ∃ t ∃ a (ictk D j0 c0 k0 ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k0 W X) $ by ex_intro [l3]
l5: $ G ⇒ ∃ k ∃ f ∃ t ∃ a (ictk D j0 c0 k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) $ by ex_intro [l4]
l6: $ G ⇒ j0 ∈ ω ∧ c0 ∈ ω $ by ictk_omega [#1]
l7: $ G ⇒ c0 ∈ ω $ by and_elim_r [l6]
l8: $ G ⇒ c0 ∊ ω $ by wcel_welc [l7]
l9: $ G ⇒ c0 ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j0 c0 k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) $ by and_intro [l8, l5]
l10: $ G ⇒ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j0 c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X)) $ by ex_intro [l9]
l11: $ G ⇒ j0 ∈ ω $ by and_elim_l [l6]
l12: $ G ⇒ j0 ∊ ω $ by wcel_welc [l11]
l13: $ G ⇒ j0 ∊ ω ∧ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j0 c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X)) $ by and_intro [l12, l10]
l14: $ G ⇒ ∃ j (j ∊ ω ∧ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X))) $ by ex_intro [l13]
l15: $ G ⇒ g0 ∊ b12_gs u E D W X $ by cab_intro [l14]

lemma b12_gsq (G: hyps) (E D W X: class) (u g0: set): $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ isset W $ > $ G ⇒ g0 ∊ b12_gs u E D W X $ > $ G ⇒ g0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u E D W X))) $
----
a1: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X $ by ax
a2: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ ictk D j c k $ by and_elim_l [a1]
a3: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X $ by and_elim_r [a1]
a4: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ D ∈ ofsort lsig lopen ks_ind $ by weaken [#1]
a5: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ k ∈ ofsort lsig lopen ks_expr $ by ictk_sort [a4, a2]
a6: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ sig lsig lopen $ by lsig_sig
a7: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ ofsort lsig lopen ks_expr ⊆ trees ω $ by ofsort_trees [a6]
a8: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ k ∈ trees ω $ by wcel_subset [a7, a5]
a9: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ isset W $ by weaken [#2]
a10: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ g0 ∊ fseq u $ by b8_etel_g [a9, a8, a3]
a11: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ functional g0 $ by fseq_functional [a10]
a12: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ rel g0 $ by fseq_rel [a10]
a13: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ cdm g0 ∈ ω $ by fseq_len [a10]
a14: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ g0 ∊ b12_gs u E D W X $ by weaken [#3]
a15: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ g0 ⊆ ⋃ (b12_gs u E D W X) $ by cuni_subset [a14]
a16: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ crn g0 ⊆ crn (⋃ (b12_gs u E D W X)) $ by crn_mono [a15]
a17: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ crn (⋃ (b12_gs u E D W X)) ⊆ ω ∪ crn (⋃ (b12_gs u E D W X)) $ by cun_subset_r
a18: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ crn g0 ⊆ ω ∪ crn (⋃ (b12_gs u E D W X)) $ by subset_trans [a16, a17]
a19: $ G , ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X ⇒ g0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u E D W X))) $ by fseq_of_fn [a11, a12, a13, a18]
o0a: $ G , ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) $ by ax
o0: $ G , ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ g0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u E D W X))) $ by ex_elim [o0a, a19]
o1a: $ G , ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) $ by ax
o1: $ G , ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ g0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u E D W X))) $ by ex_elim [o1a, o0]
o2a: $ G , ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) $ by ax
o2: $ G , ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ g0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u E D W X))) $ by ex_elim [o2a, o1]
c1: $ G , c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) $ by ax
c2: $ G , c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) $ by and_elim_r [c1]
c3: $ G , c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X) ⇒ g0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u E D W X))) $ by ex_elim [c2, o2]
j1: $ G , j ∊ ω ∧ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X)) ⇒ j ∊ ω ∧ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X)) $ by ax
j2: $ G , j ∊ ω ∧ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X)) ⇒ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X)) $ by and_elim_r [j1]
j3: $ G , j ∊ ω ∧ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X)) ⇒ g0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u E D W X))) $ by ex_elim [j2, c3]
j4: $ G ⇒ ∃ j (j ∊ ω ∧ ∃ c (c ∊ ω ∧ ∃ k ∃ f ∃ t ∃ a (ictk D j c k ∧ ⟨ f , ⟨ g0 , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E k W X))) $ by cab_elim [#3]
j5: $ G ⇒ g0 ∊ fseq (ω ∪ crn (⋃ (b12_gs u E D W X))) $ by ex_elim [j4, j3]

lemma b12_s0 (G: hyps) (U: class): $ G ⇒ universe U $ > $ G ⇒ ω ∈ U $ > $ G ⇒ csn (scons ∅ ∅) ∈ U $
----
l1: $ G ⇒ ∅ ∈ ω $ by omega_zero
l2: $ G ⇒ ∅ ∈ U $ by universe_elem_elem_c [#1, #2, l1]
l3: $ G ⇒ csn ∅ ∈ U $ by b8_csn0_u [#1, l2]
l4: $ G ⇒ ∅ ∈ fseq (csn ∅) $ by fseq_empty
l5: $ G ⇒ isset ∅ $ by wcel_isset [l1]
l6: $ G ⇒ ∅ ∈ csn ∅ $ by b9_csn_self [l5]
l7: $ G ⇒ scons ∅ ∅ ∈ fseq (csn ∅) $ by scons_fseq_c [l6, l4]
l8: $ G ⇒ scons ∅ ∅ ∈ U $ by universe_fseq_elem_c [#1, l3, l7]
l9: $ G , x = scons ∅ ∅ , x ∊ U ⇒ x ∊ U $ by ax
l10: $ G , x = scons ∅ ∅ , x ∊ U ⇒ universe U $ by weaken [#1]
l11: $ G , x = scons ∅ ∅ , x ∊ U ⇒ csn x ∈ U $ by universe_csn [l10, l9]
l12: $ G , x = scons ∅ ∅ , x ∊ U ⇒ x = scons ∅ ∅ $ by ax
l13: $ G , x = scons ∅ ∅ , x ∊ U ⇒ csn x = csn (scons ∅ ∅) $ by csn_eq [l12]
l14: $ G , x = scons ∅ ∅ , x ∊ U ⇒ csn (scons ∅ ∅) ∈ U $ by wcel_eq_l [l13, l11]
l15: $ G ⇒ csn (scons ∅ ∅) ∈ U $ by wcel_elim [l8, l14]

lemma b16_fvl (G: hyps) (X: class) (u tp ti: set): $ G ⇒ scat tp X ∈ fseq u $ > $ G ⇒ tp ∊ fseq u $ > $ G ⇒ ti ∊ cdm tp $ > $ G ⇒ fv (scat tp X) ti = fv tp ti $
----
a1: $ G , r = scat tp X , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
a2: $ … ⇒ functional r $ by fseq_functional [a1]
a3: $ G , r = scat tp X , r ∊ fseq u ⇒ r = scat tp X $ by ax
a4: $ … ⇒ functional (scat tp X) $ by functional_eq [a3, a2]
a5: $ … ⇒ functional (scat tp X) $ by wcel_elim [#1, a4]
b1: $ … ⇒ functional tp $ by fseq_functional [#2]
b2: $ … ⇒ ⟨ ti , fv tp ti ⟩ ∈ tp $ by fv_in [b1, #3]
b3: $ G ⇒ tp ⊆ scat tp X $ by cun_subset_l
b4: $ … ⇒ ⟨ ti , fv tp ti ⟩ ∈ scat tp X $ by wcel_subset [b3, b2]
b5: $ G ⇒ isset ti $ by isset_var
b6: $ … ⇒ isset (fv tp ti) $ by fv_set [b1]
b7: $ … ⇒ fv (scat tp X) ti = fv tp ti $ by fv_val_c [a5, b4, b5, b6]

lemma b16_swin (G: hyps) (X: class) (u tp: set): $ G ⇒ scat tp X ∈ fseq u $ > $ G ⇒ tp ∊ fseq u $ > $ G ⇒ swin (scat tp X) ∅ (cdm tp) = tp $
----
a1: $ G , i ∊ cdm tp ⇒ scat tp X ∈ fseq u $ by weaken [#1]
a2: $ G , i ∊ cdm tp ⇒ tp ∊ fseq u $ by weaken [#2]
a3: $ G , i ∊ cdm tp ⇒ i ∊ cdm tp $ by ax
a4: $ … ⇒ fv (scat tp X) i = fv tp i $ by b16_fvl [a1, a2, a3]
a5: $ … ⇒ i ∊ cdm tp → fv (scat tp X) i = fv tp i $ by imp_intro [a4]
a6: $ … ⇒ ∀ i (i ∊ cdm tp → fv (scat tp X) i = fv tp i) $ by all_intro [a5]
c1: $ … ⇒ cdm tp ∈ ω $ by fseq_len [#2]
c2: $ G ⇒ ∅ ∈ ω $ by omega_zero
c3: $ … ⇒ nadd ∅ (cdm tp) = nadd (cdm tp) ∅ $ by nadd_comm_c [c2, c1]
c4: $ … ⇒ isset (cdm tp) $ by wcel_isset [c1]
c5: $ … ⇒ nadd (cdm tp) ∅ = cdm tp $ by nadd_zero_c [c4]
c6: $ … ⇒ nadd ∅ (cdm tp) = cdm tp $ by eq_trans [c3, c5]
c7: $ … ⇒ cdm tp = nadd ∅ (cdm tp) $ by eq_sym [c6]
d1: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ r = scat tp X $ by ax
d2: $ … ⇒ scat tp X = r $ by eq_sym [d1]
d3: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ tp = tp $ by eq_refl
d4: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ ∀ i (i ∊ cdm tp → fv (scat tp X) i = fv tp i) $ by weaken [a6]
d5: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ cdm tp = nadd ∅ (cdm tp) $ by weaken [c7]
d6: $ … ⇒ ∀ i (i ∊ nadd ∅ (cdm tp) → fv r i = fv tp i) $ by fv_agree_eq [d5, d2, d3, d4]
d7: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ ∅ ∈ ω $ by weaken [c2]
d8: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ cdm tp ∈ ω $ by weaken [c1]
d9: $ … ⇒ swin r ∅ (cdm tp) = swin tp ∅ (cdm tp) $ by swin_agree [d7, d8, d6]
e1: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ e = ∅ $ by ax
e2: $ … ⇒ ∅ = e $ by eq_sym [e1]
e3: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
e4: $ … ⇒ e ∈ fseq u $ by wcel_eq_l [e2, e3]
e5: $ … ⇒ e ∊ fseq u $ by wcel_welc [e4]
e6: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ tp ∊ fseq u $ by weaken [#2]
e7: $ … ⇒ swin (scat tp e) ∅ (cdm tp) = tp $ by b7_swin_scat [e6, e5]
e8: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ scat tp ∅ = tp $ by scat_empty_r
e9: $ … ⇒ scat tp e = scat tp ∅ $ by scat_eq [d3, e1]
e10: $ … ⇒ scat tp e = tp $ by eq_trans [e9, e8]
e10s: $ … ⇒ tp = scat tp e $ by eq_sym [e10]
e11: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ ∅ = ∅ $ by eq_refl
e12: $ G , r = scat tp X , r ∊ fseq u , e = ∅ ⇒ cdm tp = cdm tp $ by eq_refl
e13: $ … ⇒ swin tp ∅ (cdm tp) = swin (scat tp e) ∅ (cdm tp) $ by swin_eq [e10s, e11, e12]
e14: $ … ⇒ swin tp ∅ (cdm tp) = tp $ by eq_trans [e13, e7]
e15: $ … ⇒ swin (scat tp X) ∅ (cdm tp) = swin r ∅ (cdm tp) $ by swin_eq [d2, e11, e12]
e16: $ … ⇒ swin (scat tp X) ∅ (cdm tp) = swin tp ∅ (cdm tp) $ by eq_trans [e15, d9]
e17: $ … ⇒ swin (scat tp X) ∅ (cdm tp) = tp $ by eq_trans [e16, e14]
f1: $ G , r = scat tp X , r ∊ fseq u ⇒ isset ∅ $ by ax_empty
f2: $ … ⇒ swin (scat tp X) ∅ (cdm tp) = tp $ by isset_elim [f1, e17]
f3: $ … ⇒ swin (scat tp X) ∅ (cdm tp) = tp $ by wcel_elim [#1, f2]

lemma b16_args (G: hyps) (J M W X Q: class) (u td tn tm tl ti tx1 tk tp tf tg tt ta tx: set): $ G ⇒ ra_cwf td tn tm tl ti tx1 ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J $ > $ G ⇒ tk ∊ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ uadm u $ > $ G ⇒ td ∈ trees ω $ > $ G ⇒ tp ∊ fseq u $ > $ G ⇒ cdm tp = fv nvf tm $ > $ G ⇒ ⟨ tf , ⟨ tg , ⟨ tt , ta ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk W (scat tp X) $ > $ G ⇒ ta = scat tx Q $ > $ G ⇒ tx ∊ fseq (crn tx) $ > $ G ⇒ Q ∈ fseq u $ > $ G ⇒ cdm Q = cdm tp $ > $ G ⇒ tp = Q $
----
s0a: $ G , y = ⟨ tf , ⟨ tg , ⟨ tt , ta ⟩ ⟩ ⟩ , y ∊ etel u (dnf u M) tk W (scat tp X) ⇒ y ∊ etel u (dnf u M) tk W (scat tp X) $ by ax
s0b: $ … ⇒ tk ∈ trees ω $ by welc_wcel [#2]
s0c: $ G , y = ⟨ tf , ⟨ tg , ⟨ tt , ta ⟩ ⟩ ⟩ , y ∊ etel u (dnf u M) tk W (scat tp X) ⇒ tk ∈ trees ω $ by weaken [s0b]
s0d: $ … ⇒ scat tp X ∈ fseq u $ by b8_etel_dom [s0c, s0a]
s1: $ … ⇒ scat tp X ∈ fseq u $ by wcel_elim [#8, s0d]
s2a: $ G ⇒ isset ω $ by omega_set
s2b: $ G ⇒ kc_nz ∈ ω $ by kc_nz_omega
s2c: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
