lemma b15_len (G: hyps) (M D W: class) (u tb tP tT tnp to tm tj ta: set): $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ ra_ind_data D tb tP tT ∈ lrel $ > $ G ⇒ ra_clen tP tnp ∈ lrel $ > $ G ⇒ ra_nidx D to tm ∈ lrel $ > $ G ⇒ fv nvf to = tj $ > $ G ⇒ ⟨ tj , ⟨ ta , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u M) D W $ > $ G ⇒ cdm ta = nadd (fv nvf tm) (fv nvf tnp) $
