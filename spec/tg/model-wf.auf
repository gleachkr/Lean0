lemma b12_core (G: hyps) (H J C D W R P T Q S: class) (u: set): $ G ⇒ iwf u H J C D W R $ > $ G ⇒ ¬ ilev D W = ∅ $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u (mcv H)) P W $ > $ G ⇒ S ∈ fv uni (ilev D W) $ > $ G ⇒ b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) S))) ∈ fv uni (ilev D W) $
