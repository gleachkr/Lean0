def b6_cif (U E W: class) (.y .m .l .r .f .g .t .a: set): class = $ {y | ∀ m ∀ l ∀ r ∀ f ∀ g ∀ t ∀ a (ra_isort y m l ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E y W r → cdm f = fv nvf m)} $

lemma b6_if_st (G: hyps) (E: class) (u w z k s t2 t3 t4 t5 t6 t7 t8: set): $ G ⇒ crn s ⊆ b6_cif u E w $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_isort z t2 t3 ∈ lrel $ > $ G ⇒ ⟨ t5 , ⟨ t6 , ⟨ t7 , t8 ⟩ ⟩ ⟩ ∈ etel u E z w t4 $ > $ G ⇒ cdm t5 = fv nvf t2 $
----
q1: $ G ⇒ ∃ x1 (z = ⟨ kc_srt , scons x1 ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x1) ∨ ∃ x2 ∃ x3 ∃ x4 ∃ x1 (z = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons x4 ∅ ⟩ ∧ t3 = x1 ∧ ra_isort x3 x4 x1 ∈ lrel) $ by lrel_isort_cases [#4]
