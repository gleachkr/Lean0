lemma b6_inst (G: hyps) {n l: set} (t1 t2 t3 t4: set): $ G ⇒ ra_inst t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ (t2 ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t2 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ , ra_inst b z a c ∈ lrel ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ , ra_inst b z a c ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ , ra_inst b z a c ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ , ra_inst b z a c ∈ lrel ⇒ crn j ⊆ b6_cinst $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ , ra_inst b z a c ∈ lrel ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ , ra_inst b z a c ∈ lrel ⇒ ra_inst b z a c ∈ lrel $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ , ra_inst b z a c ∈ lrel ⇒ (z ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel) $ by b6_inst_st [q4, q3, q5, q6]
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ ⇒ ra_inst b z a c ∈ lrel → (z ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel) $ by imp_intro [q7]
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ ⇒ ∀ c (ra_inst b z a c ∈ lrel → (z ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_intro [q8]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ ⇒ ∀ a ∀ c (ra_inst b z a c ∈ lrel → (z ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_intro [q9]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ ⇒ ∀ b ∀ a ∀ c (ra_inst b z a c ∈ lrel → (z ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_intro [q10]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ ⇒ z ∊ b6_cinst $ by cab_intro [q11]
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
q14: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b6_cinst $ by wcel_intro [q13, q12]
q15: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst ⇒ isset ⟨ k , j ⟩ $ by opair_isset
q16: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cinst ⇒ ⟨ k , j ⟩ ∈ b6_cinst $ by isset_elim [q15, q14]
q17: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b6_cinst → ⟨ k , j ⟩ ∈ b6_cinst $ by imp_intro [q16]
q18: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b6_cinst → ⟨ k , j ⟩ ∈ b6_cinst $ by imp_intro [q17]
q19: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cinst → ⟨ k , j ⟩ ∈ b6_cinst $ by imp_intro [q18]
q20: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cinst → ⟨ k , j ⟩ ∈ b6_cinst) $ by all_intro [q19]
q21: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cinst → ⟨ k , j ⟩ ∈ b6_cinst) $ by all_intro [q20]
q22: $ G ⇒ isset ω $ by omega_set
q23: $ G ⇒ trees ω ⊆ b6_cinst $ by trees_ind_c [q22, q21]
q24: $ G ⇒ kr_inst ∈ ω $ by kr_inst_omega
q25: $ G ⇒ isset kr_inst $ by wcel_isset [q24]
q26: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by lrel_args4 [#1, q25]
q27: $ G ⇒ t1 ∊ trees ω $ by and_elim_l [q26]
q28: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [q26]
q29: $ G ⇒ t2 ∊ trees ω $ by and_elim_l [q28]
q30: $ G ⇒ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [q28]
q31: $ G ⇒ t3 ∊ trees ω $ by and_elim_l [q30]
q32: $ G ⇒ t4 ∊ trees ω $ by and_elim_r [q30]
q33: $ G ⇒ t2 ∊ b6_cinst $ by subset_elim [q23, q29]
q34: $ G ⇒ ∀ b ∀ a ∀ c (ra_inst b t2 a c ∈ lrel → (t2 ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t2 n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by cab_elim [q33]
q35: $ G ⇒ ∀ a ∀ c (ra_inst t1 t2 a c ∈ lrel → (t2 ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t2 n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_elim [q34]
q36: $ G ⇒ ∀ c (ra_inst t1 t2 t3 c ∈ lrel → (t2 ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t2 n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_elim [q35]
q37: $ G ⇒ ra_inst t1 t2 t3 t4 ∈ lrel → (t2 ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t2 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by all_elim [q36]
q38: $ G ⇒ (t2 ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t2 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by imp_elim [q37, #1]

lemma b6_so_nz (G: hyps): $ G ⇒ ⟨ kc_nz , ∅ ⟩ ∈ ofsort lsig lopen ks_nat $
----
q1: $ G ⇒ sig lsig lopen $ by lsig_sig
q2: $ G ⇒ isset ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ $ by opair_isset
q3: $ G ⇒ ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ $ by csn_intro_var_c [q2]
q4: $ G ⇒ ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ∈ lsig $ by cun_intro_l_c [q3]
q5: $ G ⇒ ⟨ kc_nz , ∅ ⟩ ∈ ofsort lsig lopen ks_nat $ by ofsort_node0 [q1, q4]

lemma b6_inst_c (G: hyps) (T: class) (t1 t2 t4: set): $ G ⇒ isset T $ > $ G ⇒ ra_inst t1 t2 T t4 ∈ lrel $ > $ G ⇒ t2 ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ T ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ t4 ∊ ofsort lsig lopen ks_expr $
----
q1: $ G , w = T ⇒ w = T $ by ax
q2: $ G , w = T ⇒ T = w $ by eq_sym [q1]
q3: $ G , w = T ⇒ ra_inst t1 t2 T t4 ∈ lrel $ by weaken [#2]
q4: $ G , w = T ⇒ t1 = t1 $ by eq_refl
q5: $ G , w = T ⇒ t2 = t2 $ by eq_refl
q6: $ G , w = T ⇒ t4 = t4 $ by eq_refl
q7: $ G , w = T ⇒ ra_inst t1 t2 T t4 = ra_inst t1 t2 w t4 $ by ra_inst_eq [q4, q5, q2, q6]
q8: $ G , w = T ⇒ ra_inst t1 t2 w t4 ∈ lrel $ by wcel_eq_l [q7, q3]
q9: $ G , w = T ⇒ (t2 ∊ ofsort lsig lopen ks_expr → w ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t2 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by b6_inst [q8]
q10: $ G , w = T ⇒ t2 ∊ ofsort lsig lopen ks_expr → w ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr $ by and_elim_l [q9]
q11: $ G , w = T ⇒ t2 ∊ ofsort lsig lopen ks_expr $ by weaken [#3]
q12: $ G , w = T ⇒ w ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr $ by imp_elim [q10, q11]
q13: $ G , w = T ⇒ T ∈ ofsort lsig lopen ks_expr $ by weaken [#4]
q14: $ G , w = T ⇒ w ∈ ofsort lsig lopen ks_expr $ by wcel_eq_l [q2, q13]
q15: $ G , w = T ⇒ w ∊ ofsort lsig lopen ks_expr $ by wcel_welc [q14]
q16: $ G , w = T ⇒ t4 ∊ ofsort lsig lopen ks_expr $ by imp_elim [q12, q15]
q17: $ G ⇒ t4 ∊ ofsort lsig lopen ks_expr $ by isset_elim [#1, q16]

def b6_csi (d n k: class) (.x .q .o .m: set): class = $ {x | ∀ q ∀ o ∀ m (ra_sinst d q n k o m ∈ lrel → nadd (fv nvf q) x = fv nvf n → q ∊ ofsort lsig lopen ks_nat → d ∈ ofsort lsig lopen ks_ind → o ∊ ofsort lsig lopen ks_expr → m ∊ ofsort lsig lopen ks_expr)} $

lemma b6_si_base (G: hyps) (d j n k e f: set): $ G ⇒ ra_sinst d j n k e f ∈ lrel $ > $ G ⇒ nadd (fv nvf j) ∅ = fv nvf n $ > $ G ⇒ e ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ f ∊ ofsort lsig lopen ks_expr $
----
q1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ∨ ∃ x1 ∃ x5 ∃ x2 ∃ x3 ∃ x4 ∃ x6 ∃ x7 (d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel) $ by lrel_sinst_cases [#1]
q2: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 $ by ax
q3: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ d = x1 $ by and_elim_l [q2]
q4: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 $ by and_elim_r [q2]
q5: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ j = x2 $ by and_elim_l [q4]
q6: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 $ by and_elim_r [q4]
q7: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ n = x2 $ by and_elim_l [q6]
q8: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ k = x3 ∧ e = x4 ∧ f = x4 $ by and_elim_r [q6]
q9: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ k = x3 $ by and_elim_l [q8]
q10: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ e = x4 ∧ f = x4 $ by and_elim_r [q8]
q11: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ e = x4 $ by and_elim_l [q10]
q12: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ f = x4 $ by and_elim_r [q10]
q13: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ x4 = f $ by eq_sym [q12]
q14: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ e = f $ by eq_trans [q11, q13]
q15: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ e ∊ ofsort lsig lopen ks_expr $ by weaken [#3]
q16: $ G , d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4 ⇒ f ∊ ofsort lsig lopen ks_expr $ by welc_eq_set [q14, q15]
q17: $ G , ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) $ by ax
q18: $ G , ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ f ∊ ofsort lsig lopen ks_expr $ by ex_elim [q17, q16]
q19: $ G , ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) $ by ax
q20: $ G , ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ f ∊ ofsort lsig lopen ks_expr $ by ex_elim [q19, q18]
q21: $ G , ∃ x2 ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ ∃ x2 ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) $ by ax
q22: $ G , ∃ x2 ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ f ∊ ofsort lsig lopen ks_expr $ by ex_elim [q21, q20]
q23: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) $ by ax
q24: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 (d = x1 ∧ j = x2 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x4) ⇒ f ∊ ofsort lsig lopen ks_expr $ by ex_elim [q23, q22]
q25: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel $ by ax
q26: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ d = x1 $ by and_elim_l [q25]
q27: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel $ by and_elim_r [q25]
q28: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ j = x5 $ by and_elim_l [q27]
q29: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel $ by and_elim_r [q27]
q30: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ n = x2 $ by and_elim_l [q29]
q31: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel $ by and_elim_r [q29]
q32: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ k = x3 $ by and_elim_l [q31]
q33: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel $ by and_elim_r [q31]
q34: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ e = x4 $ by and_elim_l [q33]
q35: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel $ by and_elim_r [q33]
q36: $ G , d = x1 ∧ j = x5 ∧ n = x2 ∧ k = x3 ∧ e = x4 ∧ f = x7 ∧ ra_le ⟨ kc_s , scons x5 ∅ ⟩ x2 ∈ lrel ∧ ra_inst x3 x4 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x6 ∈ lrel ∧ ra_sinst x1 ⟨ kc_s , scons x5 ∅ ⟩ x2 x3 x6 x7 ∈ lrel ⇒ f = x7 $ by and_elim_l [q35]
