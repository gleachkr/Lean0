q340: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ∧ ra_ipos x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x7 ∈ lrel ⇒ dt u M x6 w l = dt u M x6 w l $ by eq_refl
q341: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ∧ ra_ipos x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x7 ∈ lrel ⇒ cpi x0 (dt u M x6 w l) (fv (cgr e (dt u M x7 w (scons e l))) x0) = cpi x0 (dt u M x6 w l) (dt u M x7 w (scons x0 l)) $ by cpi_eq_pt [q340, q339]
q342: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ∧ ra_ipos x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x7 ∈ lrel ⇒ dt u M z w l = cpi x0 (dt u M x6 w l) (dt u M x7 w (scons x0 l)) $ by eq_trans [q141, q131]
q343: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ∧ ra_ipos x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x7 ∈ lrel ⇒ cpi x0 (dt u M x6 w l) (dt u M x7 w (scons x0 l)) = dt u M z w l $ by eq_sym [q342]
q344: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ∧ ra_ipos x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x7 ∈ lrel ⇒ cpi x0 (dt u M x6 w l) (fv (cgr e (dt u M x7 w (scons e l))) x0) = dt u M z w l $ by eq_trans [q341, q343]
q345: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ∧ ra_ipos x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x7 ∈ lrel , f ∊ cpi x0 (dt u M x6 w l) (fv (cgr e (dt u M x7 w (scons e l))) x0) ⇒ f ∊ cpi x0 (dt u M x6 w l) (fv (cgr e (dt u M x7 w (scons e l))) x0) $ by ax
q346: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = ⟨ kc_pi , scons x6 (scons x7 ∅) ⟩ ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ∧ ra_ipos x1 x2 x3 ⟨ kc_s , scons x4 ∅ ⟩ x7 ∈ lrel , f ∊ cpi x0 (dt u M x6 w l) (fv (cgr e (dt u M x7 w (scons e l))) x0) ⇒ cpi x0 (dt u M x6 w l) (fv (cgr e (dt u M x7 w (scons e l))) x0) = dt u M z w l $ by weaken [q344]
