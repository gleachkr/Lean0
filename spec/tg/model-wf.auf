lemma b9_hb_sh (G: hyps) (D X0 V: class) (a b c h e n q p: set): $ G ⇒ b9_hb D X0 a b (nadd (fv nvf e) (fv nvf n)) V $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ q = scons c a $ > $ G ⇒ p = scons h b $ > $ G ⇒ b9_hb D X0 q p (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) V $
