lrel_inst_etel
--------------
c5: $ G ⇒ trees ω ⊆ b5_ip u M w t3 s $ by b5_inst_ind [#2, #5, #6, #7]
c6: $ G ⇒ kr_inst ∈ ω $ by kr_inst_omega
c7: $ G ⇒ isset kr_inst $ by wcel_isset [c6]
c9: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by lrel_args4 [#1, c7]
c10: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [c9]
c12: $ G ⇒ t2 ∊ trees ω $ by and_elim_l [c10]
c13: $ G ⇒ t2 ∊ b5_ip u M w t3 s $ by subset_elim [c5, c12]
c14: $ G ⇒ t2 ∈ b5_ip u M w t3 s $ by welc_wcel [c13]
c16: $ G ⇒ p ∈ fseq u $ by welc_wcel [#3]
cs: $ G ⇒ s ∈ fseq u $ by welc_wcel [#5]
cvs: $ G ⇒ scons (dt u M t3 w s) s ∈ fseq u $ by scons_fseq_c [#6, cs]
c18: $ G ⇒ scat p s ∈ fseq u $ by scat_fseq_c [c16, cs]
c19: $ G ⇒ isset (scat p s) $ by wcel_isset [c18]
c20: $ G ⇒ scat p s = scat p s $ by eq_refl
c21: $ G ⇒ scat p (scons (dt u M t3 w s) s) ∈ fseq u $ by scat_fseq_c [c16, cvs]
c22: $ G ⇒ isset (scat p (scons (dt u M t3 w s) s)) $ by wcel_isset [c21]
c23: $ G ⇒ scat p (scons (dt u M t3 w s) s) = scat p (scons (dt u M t3 w s) s) $ by eq_refl
c24: $ G ⇒ etel u (dnf u M) t4 w (scat p s) = etel u (dnf u M) t2 w (scat p (scons (dt u M t3 w s) s)) $ by b5_iih [c14, #1, c16, #4, c19, c20, c22, c23]

lrel_lift_etel
--------------
l1: $ G ⇒ etel u (dnf u M) t4 w (scat p (scat q s)) = etel u (dnf u M) t3 w (scat p s) $ by b5_lift_etel [#1, #2, #3, #4, #5, #6, #7]

lemma b5_etb_k1 {w r x f g t a y: set} (G: hyps) (E K S V: class) (u: set): $ G ⇒ K = kc_pi $ > $ G ⇒ etb u E K S V = clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)}) $
----
d1: $ G , z ∊ etb u E K S V ⇒ z ∊ etb u E K S V $ by ax
d2: $ G , z ∊ etb u E K S V ⇒ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)})) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by cab_elim [d1]
p1: $ G , z ∊ etb u E K S V , K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)}) ⇒ K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)}) $ by ax
p2: $ G , z ∊ etb u E K S V , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)}) ⇒ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)}) $ by ax
p3: $ G , z ∊ etb u E K S V , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by ax
