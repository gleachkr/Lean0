r7: $ G , H , ⟨ J , ⟨ i , j ⟩ ⟩ ∈ itc u E D W ∧ ((iprop D J W ∧ r = nest i ∅) ∨ (¬ iprop D J W ∧ r = nest i j)) , z = ⟨ J , ⟨ i , j ⟩ ⟩ , z ∊ itc u E D W ⇒ z ∊ itc u E D W $ by ax
r8: $ G , H , ⟨ J , ⟨ i , j ⟩ ⟩ ∈ itc u E D W ∧ ((iprop D J W ∧ r = nest i ∅) ∨ (¬ iprop D J W ∧ r = nest i j)) , z = ⟨ J , ⟨ i , j ⟩ ⟩ , z ∊ itc u E D W ⇒ c0 $ by itc_elim [r7, r5]
r9: $ G , H , ⟨ J , ⟨ i , j ⟩ ⟩ ∈ itc u E D W ∧ ((iprop D J W ∧ r = nest i ∅) ∨ (¬ iprop D J W ∧ r = nest i j)) ⇒ c0 $ by wcel_elim [m2, r8]
r10: $ G , H , ∃ j (⟨ J , ⟨ i , j ⟩ ⟩ ∈ itc u E D W ∧ ((iprop D J W ∧ r = nest i ∅) ∨ (¬ iprop D J W ∧ r = nest i j))) ⇒ ∃ j (⟨ J , ⟨ i , j ⟩ ⟩ ∈ itc u E D W ∧ ((iprop D J W ∧ r = nest i ∅) ∨ (¬ iprop D J W ∧ r = nest i j))) $ by ax
r11: $ G , H , ∃ j (⟨ J , ⟨ i , j ⟩ ⟩ ∈ itc u E D W ∧ ((iprop D J W ∧ r = nest i ∅) ∨ (¬ iprop D J W ∧ r = nest i j))) ⇒ c0 $ by ex_elim [r10, r9]
r12: $ G , H ⇒ c0 $ by ex_elim [l1, r11]

lemma b3_sub_two (G: hyps) (A: class): $ G ⇒ A ⊆ csn ∅ $ > $ G ⇒ isset A $ > $ G ⇒ A ∈ two $
----
a1: $ G , ∅ ∈ A ⇒ ∅ ∈ A $ by ax
a2: $ G , ∅ ∈ A ⇒ csn ∅ ⊆ A $ by csn_subset_c [a1]
a3: $ G , ∅ ∈ A ⇒ A ⊆ csn ∅ $ by weaken [#1]
a4: $ G , ∅ ∈ A ⇒ A = csn ∅ $ by subset_antisym [a3, a2]
a5: $ G , ∅ ∈ A ⇒ csn ∅ ∈ two $ by two_intro_r
a6: $ G , ∅ ∈ A ⇒ csn ∅ = A $ by eq_sym [a4]
a7: $ G , ∅ ∈ A ⇒ A ∈ two $ by wcel_eq_l [a6, a5]
b1: $ G , ¬ ∅ ∈ A , x ∊ A ⇒ x ∊ A $ by ax
b2: $ G , ¬ ∅ ∈ A , x ∊ A ⇒ A ⊆ csn ∅ $ by weaken [#1]
b3: $ G , ¬ ∅ ∈ A , x ∊ A ⇒ x ∊ csn ∅ $ by subset_elim [b2, b1]
b4: $ G , ¬ ∅ ∈ A , x ∊ A ⇒ x = ∅ $ by csn_elim [b3]
b5: $ G , ¬ ∅ ∈ A , x ∊ A ⇒ ∅ ∈ A $ by wcel_intro [b4, b1]
b6: $ G , ¬ ∅ ∈ A , x ∊ A ⇒ ¬ ∅ ∈ A $ by ax
b7: $ G , ¬ ∅ ∈ A , x ∊ A ⇒ ⊥ $ by not_elim [b6, b5]
b8: $ G , ¬ ∅ ∈ A ⇒ A = ∅ $ by empty_eq_intro [b7]
b9: $ G , ¬ ∅ ∈ A ⇒ ∅ ∈ two $ by two_intro_l
b10: $ G , ¬ ∅ ∈ A ⇒ ∅ = A $ by eq_sym [b8]
b11: $ G , ¬ ∅ ∈ A ⇒ A ∈ two $ by wcel_eq_l [b10, b9]
c1: $ G ⇒ ∅ ∈ A ∨ ¬ ∅ ∈ A $ by excluded_middle
c2: $ G ⇒ A ∈ two $ by or_elim [c1, a7, b11]

lemma b3_sub_un (G: hyps) (A: class) (n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ ¬ n = ∅ $ > $ G ⇒ isset A $ > $ G ⇒ A ⊆ csn (scons ∅ ∅) $ > $ G ⇒ A ∈ fv uni n $
----
a1: $ G , n = ∅ ⇒ n = ∅ $ by ax
a2: $ G , n = ∅ ⇒ ¬ n = ∅ $ by weaken [#2]
a3: $ G , n = ∅ ⇒ ⊥ $ by not_elim [a2, a1]
a4: $ G , n = ∅ ⇒ A ∈ fv uni n $ by bot_elim [a3]
b1: $ G , y ∊ ω ∧ n = suc y ⇒ y ∊ ω ∧ n = suc y $ by ax
b2: $ G , y ∊ ω ∧ n = suc y ⇒ y ∊ ω $ by and_elim_l [b1]
b3: $ G , y ∊ ω ∧ n = suc y ⇒ n = suc y $ by and_elim_r [b1]
b4: $ G , y ∊ ω ∧ n = suc y ⇒ universe (fv uni (suc y)) $ by uni_universe [b2]
b5: $ G , y ∊ ω ∧ n = suc y ⇒ two ∈ fv uni (suc y) $ by uni_two [b2]
b6: $ G , y ∊ ω ∧ n = suc y ⇒ ∅ ∈ two $ by two_intro_l
b7: $ G , y ∊ ω ∧ n = suc y ⇒ ∅ ∈ fv uni (suc y) $ by universe_elem_elem_c [b4, b5, b6]
b8: $ G , y ∊ ω ∧ n = suc y ⇒ scons ∅ ∅ ∈ fv uni (suc y) $ by b3_scons_u [b4, b7, b7]
b9: $ G , y ∊ ω ∧ n = suc y ⇒ csn (scons ∅ ∅) ∈ fv uni (suc y) $ by universe_cpr_c [b4, b8, b8]
b10: $ G , y ∊ ω ∧ n = suc y ⇒ 𝒫 (csn (scons ∅ ∅)) ∈ fv uni (suc y) $ by universe_cpw_c [b4, b9]
b11: $ G , y ∊ ω ∧ n = suc y ⇒ isset A $ by weaken [#3]
b12: $ G , y ∊ ω ∧ n = suc y ⇒ A ⊆ csn (scons ∅ ∅) $ by weaken [#4]
b13: $ G , y ∊ ω ∧ n = suc y ⇒ A ∈ 𝒫 (csn (scons ∅ ∅)) $ by b3_cpw_c [b11, b12]
b14: $ G , y ∊ ω ∧ n = suc y ⇒ A ∈ fv uni (suc y) $ by universe_elem_elem_c [b4, b10, b13]
b15: $ G , y ∊ ω ∧ n = suc y ⇒ uni = uni $ by eq_refl
b16: $ G , y ∊ ω ∧ n = suc y ⇒ suc y = n $ by eq_sym [b3]
b17: $ G , y ∊ ω ∧ n = suc y ⇒ fv uni (suc y) = fv uni n $ by fv_eq [b15, b16]
b18: $ G , y ∊ ω ∧ n = suc y ⇒ A ∈ fv uni n $ by wcel_eq_r [b17, b14]
c1: $ G , ∃ y (y ∊ ω ∧ n = suc y) ⇒ ∃ y (y ∊ ω ∧ n = suc y) $ by ax
c2: $ G , ∃ y (y ∊ ω ∧ n = suc y) ⇒ A ∈ fv uni n $ by ex_elim [c1, b18]
c3: $ G ⇒ n = ∅ ∨ ∃ y (y ∊ ω ∧ n = suc y) $ by omega_cases [#1]
c4: $ G ⇒ A ∈ fv uni n $ by or_elim [c3, a4, c2]

lemma b3_rel_elim {o y: set} (G: hyps o y) (s i j: set): $ G ⇒ ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} $ > $ G ⇒ i = nest s j $
----
a1: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ c = ⟨ i , j ⟩ $ by ax
a2: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ c = ⟨ nest s x0 , x0 ⟩ $ by ax
a3: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ ⟨ i , j ⟩ = c $ by eq_sym [a1]
a4: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ ⟨ i , j ⟩ = ⟨ nest s x0 , x0 ⟩ $ by eq_trans [a3, a2]
a5: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ isset i $ by isset_var
a6: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ isset j $ by isset_var
a7: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ isset (nest s x0) $ by nest_set
a8: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ isset x0 $ by isset_var
a9: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ i = nest s x0 ∧ j = x0 $ by opair_inj_c [a4, a5, a6, a7, a8]
a10: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ i = nest s x0 $ by and_elim_l [a9]
a11: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ j = x0 $ by and_elim_r [a9]
a12: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ s = s $ by eq_refl
a13: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ x0 = j $ by eq_sym [a11]
a14: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ nest s x0 = nest s j $ by nest_eq [a12, a13]
a15: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} , c = ⟨ nest s x0 , x0 ⟩ ⇒ i = nest s j $ by eq_trans [a10, a14]
b1: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} $ by ax
b2: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ ∃ y (c = ⟨ nest s y , y ⟩) $ by cab_elim [b1]
b2a: $ ∃ y (c = ⟨ nest s y , y ⟩) ⟺ ∃ x0 (c = ⟨ nest s x0 , x0 ⟩) $ by ex_alpha
b2b: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ ∃ y (c = ⟨ nest s y , y ⟩) ↔ ∃ x0 (c = ⟨ nest s x0 , x0 ⟩) $ by weaken [b2a]
b2c: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ ∃ x0 (c = ⟨ nest s x0 , x0 ⟩) $ by bi_elim_l [b2b, b2]
b3: $ G , c = ⟨ i , j ⟩ , c ∊ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ i = nest s j $ by ex_elim [b2c, a15]
b5: $ G ⇒ i = nest s j $ by wcel_elim [#1, b3]

lemma b3_apn_set (G: hyps) (F A: class) (s: set): $ G ⇒ isset F $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ isset (apn F s) $
----
a1: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} $ by ax
a2: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} $ by and_elim_l [a1]
a3: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} $ by and_elim_r [a1]
a4: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ i = nest s j $ by b3_rel_elim [a2]
a5: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ i = nest s k $ by b3_rel_elim [a3]
a6: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ nest s j = i $ by eq_sym [a4]
a7: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ nest s j = nest s k $ by eq_trans [a6, a5]
a8: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ s ∊ fseq A $ by weaken [#2]
a9: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ cdm s = cdm s $ by eq_refl
a10: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ s = s ∧ j = k $ by nest_inj [a8, a8, a9, a7]
a11: $ G , ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ⇒ j = k $ by and_elim_r [a10]
a12: $ G ⇒ ⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} → j = k $ by imp_intro [a11]
a13: $ G ⇒ ∀ k (⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} → j = k) $ by all_intro [a12]
a14: $ G ⇒ ∀ j ∀ k (⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} → j = k) $ by all_intro [a13]
a15: $ G ⇒ ∀ i ∀ j ∀ k (⟨ i , j ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} ∧ ⟨ i , k ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} → j = k) $ by all_intro [a14]
a16: $ G ⇒ isset (img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F) $ by img_set [a15, #1]
c1: $ G , e ∊ apn F s ⇒ e ∊ apn F s $ by ax
c2: $ G , e ∊ apn F s ⇒ nest s e ∈ F $ by cab_elim [c1]
d1: $ G , e ∊ apn F s , n = nest s e , n ∊ F ⇒ n ∊ F $ by ax
d2: $ G , e ∊ apn F s , n = nest s e , n ∊ F , h = ⟨ n , e ⟩ ⇒ h = ⟨ n , e ⟩ $ by ax
d3: $ G , e ∊ apn F s , n = nest s e , n ∊ F , h = ⟨ n , e ⟩ ⇒ n = nest s e $ by ax
d4: $ G , e ∊ apn F s , n = nest s e , n ∊ F , h = ⟨ n , e ⟩ ⇒ e = e $ by eq_refl
d5: $ G , e ∊ apn F s , n = nest s e , n ∊ F , h = ⟨ n , e ⟩ ⇒ ⟨ n , e ⟩ = ⟨ nest s e , e ⟩ $ by opair_eq [d3, d4]
d6: $ G , e ∊ apn F s , n = nest s e , n ∊ F , h = ⟨ n , e ⟩ ⇒ h = ⟨ nest s e , e ⟩ $ by eq_trans [d2, d5]
d7: $ G , e ∊ apn F s , n = nest s e , n ∊ F , h = ⟨ n , e ⟩ ⇒ ∃ y (h = ⟨ nest s y , y ⟩) $ by ex_intro [d6]
d8: $ G , e ∊ apn F s , n = nest s e , n ∊ F ⇒ isset ⟨ n , e ⟩ $ by opair_isset
d9: $ G , e ∊ apn F s , n = nest s e , n ∊ F ⇒ ⟨ n , e ⟩ ∈ {o | ∃ y (o = ⟨ nest s y , y ⟩)} $ by wcel_cab_intro [d8, d7]
d10: $ G , e ∊ apn F s , n = nest s e , n ∊ F ⇒ e ∊ img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F $ by img_intro [d1, d9]
d11: $ G , e ∊ apn F s ⇒ e ∊ img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F $ by wcel_elim [c2, d10]
d12: $ G ⇒ apn F s ⊆ img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F $ by subset_intro [d11]
d13: $ G , m = img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F ⇒ m = img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F $ by ax
d14: $ G , m = img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F ⇒ img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F = m $ by eq_sym [d13]
d15: $ G , m = img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F ⇒ apn F s ⊆ img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F $ by weaken [d12]
d16: $ G , m = img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F ⇒ apn F s ⊆ m $ by subset_eq_r [d14, d15]
d17: $ G , m = img {o | ∃ y (o = ⟨ nest s y , y ⟩)} F ⇒ isset (apn F s) $ by subset_set [d16]
d18: $ G ⇒ isset (apn F s) $ by isset_elim [a16, d17]

lemma b3_fib (G: hyps) (E D J: class) (u w b c d x1 x2 x3 x4 x0 m e: set): $ G ⇒ D ∈ trees ω $ > $ G ⇒ iprt D b c $ > $ G ⇒ ityf D J d $ > $ G ⇒ x0 ∊ esat u E b w $ > $ G ⇒ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E d w x0 $ > $ G ⇒ m = scat x1 x0 $ > $ G ⇒ e ∊ apn (itriv u E D J w) m $ > $ G ⇒ (iprop D J w ∧ e = ∅) ∨ (¬ iprop D J w ∧ e = scons ∅ ∅) $
----
a1: $ G ⇒ nest m e ∈ itriv u E D J w $ by cab_elim [#7]
a2: $ G ⇒ d ∈ fv tsub D $ by ityf_tsub [#1, #3]
a3: $ G ⇒ fv tsub D ⊆ trees ω $ by tsub_trees
a4: $ G ⇒ d ∈ trees ω $ by wcel_subset [a3, a2]
a5: $ G ⇒ isset w $ by isset_var
a6: $ G ⇒ x1 ∊ fseq u ∧ x2 ∊ fseq u ∧ cdm x2 = cdm x1 ∧ cdm x3 = cdm x1 $ by etel_fseq_c [a5, a4, #5]
a7: $ G ⇒ x1 ∊ fseq u $ by and_elim_l [a6]
a8: $ G ⇒ esat u E b w ⊆ fseq u $ by esat_fseq
a9: $ G ⇒ x0 ∊ fseq u $ by subset_elim [a8, #4]
a10: $ G ⇒ scat x1 x0 ∈ fseq u $ by scat_fseq [a7, a9]
a11: $ G ⇒ m = scat x1 x0 $ by weaken [#6]
a12: $ G ⇒ scat x1 x0 = m $ by eq_sym [a11]
a13: $ G ⇒ m ∈ fseq u $ by wcel_eq_l [a12, a10]
a14: $ G ⇒ cdm (scat x1 x0) = nadd (cdm x1) (cdm x0) $ by scat_len [a7, a9]
a15: $ G ⇒ cdm m = cdm (scat x1 x0) $ by cdm_eq [a11]
a16: $ G ⇒ cdm m = nadd (cdm x1) (cdm x0) $ by eq_trans [a15, a14]
a17: $ G ⇒ b ∈ fv tsub D ∧ c ∈ fv tsub D $ by iprt_tsub [#1, #2]
a18: $ G ⇒ b ∈ fv tsub D $ by and_elim_l [a17]
a19: $ G ⇒ b ∈ trees ω $ by wcel_subset [a3, a18]
k1: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) ⇒ iprt D p t $ by ax
k2: $ G , r = nest m e , r ∊ itriv u E D J w , iprt D p t , ityf D J f , q ∊ esat u E p w , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f w q , (iprop D J w ∧ r = nest (scat x q) ∅) ∨ (¬ iprop D J w ∧ r = nest (scat x q) (scons ∅ ∅)) ⇒ iprt D b c $ by weaken [#2]
