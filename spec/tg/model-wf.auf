h5: $ … ⇒ scat l r = scons y r $ by eq_trans [h3, h4]
h6: $ … ⇒ scat k (scat l r) = scat ∅ (scons y r) $ by scat_eq [a3, h5]
h7: $ … ⇒ scons y r ∈ fseq u $ by scons_fseq_c [yu, rf]
h8: $ … ⇒ scat ∅ (scons y r) = scons y r $ by scat_empty_l_c [h7]
h9: $ … ⇒ scat k (scat l r) = scons y r $ by eq_trans [h6, h8]
h10: $ … ⇒ scons y r = scat k (scat l r) $ by eq_sym [h9]
ww: $ G , i = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ , j = ⟨ kc_nz , ∅ ⟩ , k = ∅ , l = scons y k ⇒ w = w $ by eq_refl
o1: $ … ⇒ etel u (dnf u M) B w (scons y r) = etel u (dnf u M) B w (scat k (scat l r)) $ by etel_eq [b4, ww, h10]
o2: $ … ⇒ etel u (dnf u M) B2 w (scat k r) = etel u (dnf u M) B2 w r $ by etel_eq [b3, ww, g3]
