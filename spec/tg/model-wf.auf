lemma b6_sinst_t6 (G: hyps) (t1 t3 t4 t5 t6: set): $ G ⇒ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ t3 t4 t5 t6 ∈ lrel $ > $ G ⇒ t6 ∈ trees ω $
----
q1: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by ax
q2: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ t3 t4 t5 t6 ∈ lrel $ by weaken [#1]
q3: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ = z $ by eq_sym [q1]
q4: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t1 = t1 $ by eq_refl
q5: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t3 = t3 $ by eq_refl
q6: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t4 = t4 $ by eq_refl
q7: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t5 = t5 $ by eq_refl
q8: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t6 = t6 $ by eq_refl
q9: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ t3 t4 t5 t6 = ra_sinst t1 z t3 t4 t5 t6 $ by ra_sinst_eq [q4, q3, q5, q6, q7, q8]
q10: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_sinst t1 z t3 t4 t5 t6 ∈ lrel $ by wcel_eq_l [q9, q2]
q11: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ kr_sinst ∈ ω $ by kr_sinst_omega
q12: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ isset kr_sinst $ by wcel_isset [q11]
q13: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t1 ∊ trees ω ∧ z ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω ∧ t6 ∊ trees ω $ by lrel_args6 [q10, q12]
q14: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t1 ∊ trees ω $ by and_elim_l [q13]
q15: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ z ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω ∧ t6 ∊ trees ω $ by and_elim_r [q13]
q16: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ z ∊ trees ω $ by and_elim_l [q15]
q17: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω ∧ t6 ∊ trees ω $ by and_elim_r [q15]
q18: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t3 ∊ trees ω $ by and_elim_l [q17]
q19: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t4 ∊ trees ω ∧ t5 ∊ trees ω ∧ t6 ∊ trees ω $ by and_elim_r [q17]
q20: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t4 ∊ trees ω $ by and_elim_l [q19]
q21: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t5 ∊ trees ω ∧ t6 ∊ trees ω $ by and_elim_r [q19]
q22: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t5 ∊ trees ω $ by and_elim_l [q21]
q23: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t6 ∊ trees ω $ by and_elim_r [q21]
q24: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ t6 ∈ trees ω $ by welc_wcel [q23]
q25: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
q26: $ G ⇒ t6 ∈ trees ω $ by isset_elim [q25, q24]

lemma b6_sat_mv (G: hyps) (M C X Y: class) (u w m: set): $ G ⇒ X = Y $ > $ G ⇒ Y ∈ sat u M C w $ > $ G ⇒ m = C $ > $ G ⇒ X ∈ sat u M m w $
----
q1: $ G ⇒ Y = X $ by eq_sym [#1]
q2: $ G ⇒ X ∈ sat u M C w $ by wcel_eq_l [q1, #2]
q3: $ G ⇒ C = m $ by eq_sym [#3]
q4: $ G ⇒ w = w $ by eq_refl
q5: $ G ⇒ sat u M C w = sat u M m w $ by sat_eq [q3, q4]
q6: $ G ⇒ X ∈ sat u M m w $ by wcel_eq_r [q5, q2]

lemma b6_closed_agree (G: hyps) (M: class) (u w k e o s t: set): $ G ⇒ ra_closed k e ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ o ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ t ∊ fseq u $ > $ G ⇒ cdm o = fv nvf k $ > $ G ⇒ dt u M e w (scat o s) = dt u M e w (scat o t) $
----
q1: $ G ⇒ ∀ i (i ∊ cdm o → fv (scat o s) i = fv (scat o t) i) $ by scat_agree [#3, #4, #5]
q2: $ G ⇒ scat o s = scat o s $ by eq_refl
q3: $ G ⇒ scat o t = scat o t $ by eq_refl
q4: $ G ⇒ ∀ i (i ∊ fv nvf k → fv (scat o s) i = fv (scat o t) i) $ by fv_agree_eq [#6, q2, q3, q1]
q5: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
q6: $ G ⇒ scat o s ∈ fseq u $ by scat_fseq [#3, #4]
q7: $ G ⇒ scat o t ∈ fseq u $ by scat_fseq [#3, #5]
q8: $ G ⇒ dt u M e w (scat o s) = dt u M e w (scat o t) $ by lrel_closed_sem_c [#1, q5, q6, q7, q4]

def b6_ccw (J M u w t1 t2 t3 t4 t5 t6 t7 t9 tp tt: class) (.y .c .d .f .x5 .x6 .x7 .x8 .x .q .v .e .g .t .a: set): class = $ {y | ∀ c ∀ d ∀ f ∀ x5 ∀ x6 ∀ x7 ∀ x8 (ra_cwf t1 t2 t3 t4 t5 c d y ∈ lrel3 J → c ∊ trees ω → d ∊ trees ω → f ∊ fseq u → cdm f = fv nvf d → scat f (scat t6 t9) ∈ sat u M c w → y ∊ ofsort lsig lopen ks_expr → ⟨ x5 , ⟨ x6 , ⟨ x7 , x8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) y w (scat f (scat t6 t7)) → x8 ∊ b6_Qc u M w tp tt t5)} $

lemma b6_cw_pi (G: hyps) (J M: class) (u w t1 t2 t3 t4 t5 t6 t7 t8 t9 tp tt c0 d0 f0 z t10 t11 t12 t13 t15 p5 p6 p7 p8: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ t6 ∊ fseq u $ > $ G ⇒ cdm t6 = fv nvf t3 $ > $ G ⇒ t9 ∊ fseq u $ > $ G ⇒ t7 ∊ fseq u $ > $ G ⇒ t8 ∊ fseq u $ > $ G ⇒ cdm t8 = fv nvf t2 $ > $ G ⇒ b6_vt u M w t1 t8 $ > $ G ⇒ t1 ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ c0 ∊ trees ω $ > $ G ⇒ d0 ∊ trees ω $ > $ G ⇒ f0 ∊ fseq u $ > $ G ⇒ cdm f0 = fv nvf d0 $ > $ G ⇒ scat f0 (scat t6 t9) ∈ sat u M c0 w $ > $ G ⇒ z = ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ $ > $ G ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_add d0 t3 t12 ∈ lrel $ > $ G ⇒ ra_closed t12 t10 ∈ lrel $ > $ G ⇒ ra_sinst t1 ⟨ kc_nz , ∅ ⟩ t2 t12 t10 t13 ∈ lrel $ > $ G ⇒ ra_cwf t1 t2 t3 t4 t5 ⟨ kc_cons , scons t13 (scons c0 ∅) ⟩ ⟨ kc_s , scons d0 ∅ ⟩ t11 ∈ lrel3 J $ > $ G ⇒ t11 ∊ b6_ccw J M u w t1 t2 t3 t4 t5 t6 t7 t9 tp tt $ > $ G ⇒ ⟨ p5 , ⟨ p6 , ⟨ p7 , p8 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z w (scat f0 (scat t6 t7)) $ > $ G ⇒ t15 ∊ fseq u $ > $ G ⇒ t15 = scat t8 t9 $ > $ G ⇒ p8 ∊ b6_Qc u M w tp tt t5 $
