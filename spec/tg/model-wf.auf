y0b: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) T w r2 ∧ b11_sh_T u M T w a K t1 X0 X x2 g P) $ by ex_elim [h0, y1b]
fin: $ G ⇒ b11_sh_C u M T w a r2 K t1 X0 X g P $ by weaken [y0b]

--| (SH) the induction hypothesis for the rest, under one more field.
lemma b11_sh_ih (G: hyps) (J M X0 X: class) (u w t1 t2 t3 t4 t5 cc dd d0 B a r x q p f g t e: set): $ G ⇒ ra_cwf t1 t2 t3 t4 t5 cc dd B ∈ lrel3 J $ > $ G ⇒ dd = ⟨ kc_s , scons d0 ∅ ⟩ $ > $ G ⇒ B ∊ b11_sh_I u M w J t1 t2 t3 t4 t5 X0 X $ > $ G ⇒ B ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ d0 ∊ trees ω $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ b9_ag a r (nadd (fv nvf d0) (fv nvf t3)) $ > $ G ⇒ b9_hs t1 X0 a r (nadd (fv nvf d0) (fv nvf t3)) X $ > $ G ⇒ swin a (fv nvf d0) (fv nvf t3) = X0 $ > $ G ⇒ x ∊ u $ > $ G ⇒ q = scons x a $ > $ G ⇒ p = scons x r $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w q $ > $ G ⇒ b11_sh_C u M B w q p (nadd (fv nvf dd) (fv nvf t3)) t1 X0 X g ⟨ f , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ $
----
n1: $ G ⇒ isset ω $ by omega_set
n2: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
n3: $ … ⇒ d0 ∈ trees ω $ by welc_wcel [#5]
n4: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
n5: $ … ⇒ scons d0 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [n3, n4]
n6: $ … ⇒ ⟨ kc_s , scons d0 ∅ ⟩ ∈ trees ω $ by trees_intro_c [n1, n2, n5]
k0: $ … ⇒ ⟨ kc_s , scons d0 ∅ ⟩ = dd $ by eq_sym [#2]
k1: $ G ⇒ nvf = nvf $ by eq_refl
k2: $ … ⇒ fv nvf ⟨ kc_s , scons d0 ∅ ⟩ = fv nvf dd $ by fv_eq [k1, k0]
k3: $ G ⇒ fv nvf t3 = fv nvf t3 $ by eq_refl
k4: $ … ⇒ nadd (fv nvf ⟨ kc_s , scons d0 ∅ ⟩) (fv nvf t3) = nadd (fv nvf dd) (fv nvf t3) $ by nadd_eq [k2, k3]
n8: $ … ⇒ dd ∈ trees ω $ by wcel_eq_l [k0, n6]
n9: $ … ⇒ dd ∊ trees ω $ by wcel_welc [n8]
xu: $ … ⇒ x ∈ u $ by welc_wcel [#11]
af: $ … ⇒ a ∈ fseq u $ by welc_wcel [#6]
rf: $ … ⇒ r ∈ fseq u $ by welc_wcel [#7]
q1: $ … ⇒ scons x a ∈ fseq u $ by scons_fseq_c [xu, af]
q2: $ … ⇒ scons x a = q $ by eq_sym [#12]
q3: $ … ⇒ q ∈ fseq u $ by wcel_eq_l [q2, q1]
q4: $ … ⇒ q ∊ fseq u $ by wcel_welc [q3]
p1: $ … ⇒ scons x r ∈ fseq u $ by scons_fseq_c [xu, rf]
p2: $ … ⇒ scons x r = p $ by eq_sym [#13]
p3: $ … ⇒ p ∈ fseq u $ by wcel_eq_l [p2, p1]
p4: $ … ⇒ p ∊ fseq u $ by wcel_welc [p3]
xx: $ G ⇒ x = x $ by eq_refl
g1: $ … ⇒ b9_ag q p (nadd (fv nvf ⟨ kc_s , scons d0 ∅ ⟩) (fv nvf t3)) $ by b9_ag_sh [#8, #5, xx, #12, #13]
g2: $ G ⇒ ∀ i (i ∊ nadd (fv nvf ⟨ kc_s , scons d0 ∅ ⟩) (fv nvf t3) → fv q i = fv p i) $ by weaken [g1]
qq: $ G ⇒ q = q $ by eq_refl
pp: $ G ⇒ p = p $ by eq_refl
g3: $ G ⇒ ∀ i (i ∊ nadd (fv nvf dd) (fv nvf t3) → fv q i = fv p i) $ by fv_agree_eq [k4, qq, pp, g2]
g4: $ G ⇒ b9_ag q p (nadd (fv nvf dd) (fv nvf t3)) $ by weaken [g3]
h1: $ … ⇒ b9_hs t1 X0 q p (nadd (fv nvf ⟨ kc_s , scons d0 ∅ ⟩) (fv nvf t3)) X $ by b9_hs_sh [#9, #5, #12, #13]
h2: $ … ⇒ b9_hs t1 X0 q p (nadd (fv nvf dd) (fv nvf t3)) X $ by b11_sh_hs_k [k4, h1]
s1: $ … ⇒ swin q (fv nvf ⟨ kc_s , scons d0 ∅ ⟩) (fv nvf t3) = X0 $ by b9_sw_sh [#10, #5, #12]
s2: $ … ⇒ swin q (fv nvf ⟨ kc_s , scons d0 ∅ ⟩) (fv nvf t3) = swin q (fv nvf dd) (fv nvf t3) $ by swin_eq [qq, k2, k3]
s3: $ … ⇒ swin q (fv nvf dd) (fv nvf t3) = swin q (fv nvf ⟨ kc_s , scons d0 ∅ ⟩) (fv nvf t3) $ by eq_sym [s2]
s4: $ … ⇒ swin q (fv nvf dd) (fv nvf t3) = X0 $ by eq_trans [s3, s1]
fin: $ … ⇒ b11_sh_C u M B w q p (nadd (fv nvf dd) (fv nvf t3)) t1 X0 X g ⟨ f , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ $ by b11_sh_Ie [#3, #1, #4, n9, q4, p4, g4, h2, s4, #14]

--| The paths of a lifted type do not depend on the first entry.
lemma b11_sh_lift (G: hyps) (M: class) (u w B B2 r y: set): $ G ⇒ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ y ∊ u $ > $ G ⇒ etel u (dnf u M) B w (scons y r) = etel u (dnf u M) B2 w r $
----
i1: $ G ⇒ isset ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ by opair_isset
i2: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
