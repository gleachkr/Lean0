e1: $ G , x4 ∊ {y | ∃ p ∃ t ∃ j ∃ c ∃ k ∃ f ∃ g ∃ x3 ∃ a ∃ d (iprt D p t ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ x3 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅))))) ∧ y ∊ fv g d)} ⇒ ∃ p ∃ t ∃ j ∃ c ∃ k ∃ f ∃ g ∃ x3 ∃ a ∃ d (iprt D p t ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ x3 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅))))) ∧ x4 ∊ fv g d) $ by cab_elim [e0]
e2: $ G , x4 ∊ {y | ∃ p ∃ t ∃ j ∃ c ∃ k ∃ f ∃ g ∃ x3 ∃ a ∃ d (iprt D p t ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ x3 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅))))) ∧ y ∊ fv g d)} ⇒ x4 ∊ ⋃ (crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅)))))))) $ by ex_elim [e1, o1]
e3: $ G ⇒ {y | ∃ p ∃ t ∃ j ∃ c ∃ k ∃ f ∃ g ∃ x3 ∃ a ∃ d (iprt D p t ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ x3 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅))))) ∧ y ∊ fv g d)} ⊆ ⋃ (crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅)))))))) $ by subset_intro [e2]
e4: $ G ⇒ ω ⊆ ω $ by subset_refl
e5: $ G ⇒ ω × {y | ∃ p ∃ t ∃ j ∃ c ∃ k ∃ f ∃ g ∃ x3 ∃ a ∃ d (iprt D p t ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ x3 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅))))) ∧ y ∊ fv g d)} ⊆ ω × ⋃ (crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅)))))))) $ by cxp_mono [e4, e3]
e6: $ G ⇒ ω × ⋃ (crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅)))))))) ⊆ csn ∅ ∪ ω × ⋃ (crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅)))))))) $ by cun_subset_r
e7: $ G ⇒ ω × {y | ∃ p ∃ t ∃ j ∃ c ∃ k ∃ f ∃ g ∃ x3 ∃ a ∃ d (iprt D p t ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ x3 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅))))) ∧ y ∊ fv g d)} ⊆ csn ∅ ∪ ω × ⋃ (crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅)))))))) $ by subset_trans [e5, e6]
e8: $ G ⇒ csn ∅ ⊆ csn ∅ ∪ ω × ⋃ (crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅)))))))) $ by cun_subset_l
e9: $ G ⇒ csn ∅ ∪ ω × {y | ∃ p ∃ t ∃ j ∃ c ∃ k ∃ f ∃ g ∃ x3 ∃ a ∃ d (iprt D p t ∧ ictk D j c k ∧ ⟨ f , ⟨ g , ⟨ x3 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅))))) ∧ y ∊ fv g d)} ⊆ csn ∅ ∪ ω × ⋃ (crn (⋃ (b12_gs u (dnf u (mcv H)) D W (scat Q (ixs D W (isup (ijs u (dnf u (mcv H)) D W) (csn (scons ∅ ∅)))))))) $ by cun_least [e8, e7]
e10: $ G ⇒ iax u (dnf u (mcv H)) D W (ijs u (dnf u (mcv H)) D W) Q ∈ fv uni (ilev D W) $ by universe_subset_c [h2, h13, e9]

lemma b3_cont_eq {x: set} (G: hyps x) (B: class x) (A C: class): $ G ⇒ A = C $ > $ G ⇒ cont x B A $ > $ G ⇒ cont x B C $
----
l2: $ G ⇒ ∀ z (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f))) $ by all_elim [#2]
l3: $ G ⇒ z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by all_elim [l2]
l4: $ G , z ∊ (⟦ x / u ⟧ B) ⇒ ∃ f (functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by imp_use [l3]
m1: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by ax
m2: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ functional f $ by and_elim_l [m1]
m3: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by and_elim_r [m1]
m4: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ A $ by and_elim_l [m3]
m5: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by and_elim_r [m3]
m6: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ A = C $ by weaken [#1]
m7: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ C $ by subset_eq_r [m6, m4]
m8: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by and_intro [m7, m5]
m9: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) $ by and_intro [m2, m8]
m10: $ G , z ∊ (⟦ x / u ⟧ B) , functional f ∧ cdm f ⊆ A ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f) ⇒ ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by ex_intro [m9]
m11: $ G , z ∊ (⟦ x / u ⟧ B) ⇒ ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by ex_elim [l4, m10]
m12: $ G ⇒ z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f)) $ by imp_intro [m11]
m13: $ G ⇒ ∀ z (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f))) $ by all_intro [m12]
m14: $ G ⇒ ∀ u ∀ z (z ∊ (⟦ x / u ⟧ B) → ∃ f (functional f ∧ cdm f ⊆ C ∧ crn f ⊆ u ∧ z ∊ cap x B (crn f))) $ by all_intro [m13]

lemma b3_iwf_eq (G: hyps) (U H J C D W R: class) (d: set): $ G ⇒ iwf U H J C D W R $ > $ G ⇒ D = d $ > $ G ⇒ iwf U H J C d W R $
----
a1: $ G ⇒ uadm U $ by iwf_uadm [#1]
a2: $ G ⇒ hty ⊆ H $ by iwf_hty [#1]
a3: $ G ⇒ functional H $ by iwf_fn [#1]
a4: $ G ⇒ jval U (mcv H) J $ by iwf_jval [#1]
a5: $ G ⇒ ra_ind_wf C D ∈ lrel3 J $ by iwf_wf [#1]
a6: $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ by iwf_sort [#1]
a7: $ G ⇒ W ∈ lvals $ by iwf_lvals [#1]
a8: $ G ⇒ R ∈ sat U (mcv H) C W $ by iwf_sat [#1]
b1: $ G ⇒ C = C $ by eq_refl
b2: $ G ⇒ ra_ind_wf C D = ra_ind_wf C d $ by ra_ind_wf_eq [b1, #2]
b3: $ G ⇒ ra_ind_wf C d ∈ lrel3 J $ by wcel_eq_l [b2, a5]
b4: $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ by wcel_eq_l [#2, a6]
c1: $ G ⇒ W ∈ lvals ∧ R ∈ sat U (mcv H) C W $ by and_intro [a7, a8]
c2: $ G ⇒ d ∈ ofsort lsig lopen ks_ind ∧ W ∈ lvals ∧ R ∈ sat U (mcv H) C W $ by and_intro [b4, c1]
c3: $ G ⇒ ra_ind_wf C d ∈ lrel3 J ∧ d ∈ ofsort lsig lopen ks_ind ∧ W ∈ lvals ∧ R ∈ sat U (mcv H) C W $ by and_intro [b3, c2]
c4: $ G ⇒ jval U (mcv H) J ∧ ra_ind_wf C d ∈ lrel3 J ∧ d ∈ ofsort lsig lopen ks_ind ∧ W ∈ lvals ∧ R ∈ sat U (mcv H) C W $ by and_intro [a4, c3]
c5: $ G ⇒ functional H ∧ jval U (mcv H) J ∧ ra_ind_wf C d ∈ lrel3 J ∧ d ∈ ofsort lsig lopen ks_ind ∧ W ∈ lvals ∧ R ∈ sat U (mcv H) C W $ by and_intro [a3, c4]
c6: $ G ⇒ hty ⊆ H ∧ functional H ∧ jval U (mcv H) J ∧ ra_ind_wf C d ∈ lrel3 J ∧ d ∈ ofsort lsig lopen ks_ind ∧ W ∈ lvals ∧ R ∈ sat U (mcv H) C W $ by and_intro [a2, c5]
c7: $ G ⇒ uadm U ∧ hty ⊆ H ∧ functional H ∧ jval U (mcv H) J ∧ ra_ind_wf C d ∈ lrel3 J ∧ d ∈ ofsort lsig lopen ks_ind ∧ W ∈ lvals ∧ R ∈ sat U (mcv H) C W $ by and_intro [a1, c6]

lemma b3_icwf (G: hyps) (J C: class) (d: set): $ G ⇒ ra_ind_wf C d ∈ lrel3 J $ > $ G ⇒ icwf J d $
----
a1: $ G , c = C ⇒ c = C $ by ax
a2: $ G , c = C ⇒ C = c $ by eq_sym [a1]
a3: $ G , c = C ⇒ d = d $ by eq_refl
a4: $ G , c = C ⇒ ra_ind_wf C d = ra_ind_wf c d $ by ra_ind_wf_eq [a2, a3]
a5: $ G , c = C ⇒ ra_ind_wf C d ∈ lrel3 J $ by weaken [#1]
a6: $ G , c = C ⇒ ra_ind_wf c d ∈ lrel3 J $ by wcel_eq_l [a4, a5]
a7: $ G , c = C ⇒ icwf J d $ by ind_wf_icwf [a6]
a8: $ G , isset C ⇒ isset C $ by ax
a9: $ G , isset C ⇒ icwf J d $ by isset_elim [a8, a7]
b1: $ G , ¬ isset C ⇒ ¬ isset C $ by ax
b2: $ G , ¬ isset C ⇒ scons C (scons d ∅) = scons ∅ (scons d ∅) $ by scons_proper [b1]
b3: $ G , ¬ isset C ⇒ kr_ind_wf = kr_ind_wf $ by eq_refl
b4: $ G , ¬ isset C ⇒ ⟨ kr_ind_wf , scons C (scons d ∅) ⟩ = ⟨ kr_ind_wf , scons ∅ (scons d ∅) ⟩ $ by opair_eq [b3, b2]
b6: $ G , ¬ isset C ⇒ ra_ind_wf C d ∈ lrel3 J $ by weaken [#1]
b7: $ G , ¬ isset C ⇒ ⟨ kr_ind_wf , scons ∅ (scons d ∅) ⟩ ∈ lrel3 J $ by wcel_eq_l [b4, b6]
b8: $ G , ¬ isset C , e = ∅ ⇒ e = ∅ $ by ax
b9: $ G , ¬ isset C , e = ∅ ⇒ ∅ = e $ by eq_sym [b8]
b10: $ G , ¬ isset C , e = ∅ ⇒ d = d $ by eq_refl
b11: $ G , ¬ isset C , e = ∅ ⇒ ra_ind_wf ∅ d = ra_ind_wf e d $ by ra_ind_wf_eq [b9, b10]
b12: $ G , ¬ isset C , e = ∅ ⇒ ra_ind_wf ∅ d ∈ lrel3 J $ by weaken [b7]
b13: $ G , ¬ isset C , e = ∅ ⇒ ra_ind_wf e d ∈ lrel3 J $ by wcel_eq_l [b11, b12]
b14: $ G , ¬ isset C , e = ∅ ⇒ icwf J d $ by ind_wf_icwf [b13]
b15: $ G , ¬ isset C ⇒ isset ∅ $ by ax_empty
b16: $ G , ¬ isset C ⇒ icwf J d $ by isset_elim [b15, b14]
c1: $ G ⇒ isset C ∨ ¬ isset C $ by excluded_middle
c2: $ G ⇒ icwf J d $ by or_elim [c1, a9, b16]

lemma b3_ifam_pt {j a y p t f q x g o v: set} (G H: hyps) (E D W: class) (u r: set) (c0: fml): $ G ⇒ D ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ isup (ifam u E D W) (csn (scons ∅ ∅)) ⊆ itc u E D W $ > $ G ⇒ r ∊ ifam u E D W $ > $ H , r = ⟨ j , ⟨ a , y ⟩ ⟩ , ⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , v ⟩ ⟩ ⟩ ∈ etel u E f W q , a = scat x q ⇒ c0 $ > $ G , H ⇒ c0 $
----
a1: $ G ⇒ ifam u E D W ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by ifam_sub
a2: $ G ⇒ r ∊ ω × (fseq u × fseq (ω ∪ u)) $ by subset_elim [a1, #4]
b1: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ r = ⟨ j , e ⟩ $ by ax
b2: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ e = ⟨ a , y ⟩ $ by ax
b3: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ j = j $ by eq_refl
b4: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ ⟨ j , e ⟩ = ⟨ j , ⟨ a , y ⟩ ⟩ $ by opair_eq [b3, b2]
b5: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ r = ⟨ j , ⟨ a , y ⟩ ⟩ $ by eq_trans [b1, b4]
b6: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ r ∊ ifam u E D W $ by weaken [#4]
b7: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ r ∈ ifam u E D W $ by welc_wcel [b6]
b8: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ ⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W $ by wcel_eq_l [b5, b7]
b9: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ isset j $ by isset_var
b10: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ isset a $ by isset_var
b11: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ isset ∅ $ by ax_empty
b12: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ isset (scons ∅ ∅) $ by scons_set [b11]
b13: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ scons ∅ ∅ ∈ csn (scons ∅ ∅) $ by csn_intro_var_c [b12]
b14: $ G , H , r = ⟨ j , e ⟩ , j ∊ ω , e ∊ fseq u × fseq (ω ∪ u) , e = ⟨ a , y ⟩ , a ∊ fseq u , y ∊ fseq (ω ∪ u) ⇒ ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∈ isup (ifam u E D W) (csn (scons ∅ ∅)) $ by isup_intro [b9, b10, b8, b13]
