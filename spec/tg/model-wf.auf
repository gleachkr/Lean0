g4: $ G , x0 = scat x q , x0 ∊ fseq A , e ∊ A ∧ f ∊ fseq A ∧ q = scons e f , h = ∅ , m = cdm x ⇒ m ∊ cdm x0 $ by cdm_intro [g3]
g5: $ G , x0 = scat x q , x0 ∊ fseq A , e ∊ A ∧ f ∊ fseq A ∧ q = scons e f , h = ∅ , m = cdm x ⇒ cdm x ∈ cdm x0 $ by wcel_intro [g1, g4]
g6: $ G , x0 = scat x q , x0 ∊ fseq A , e ∊ A ∧ f ∊ fseq A ∧ q = scons e f , h = ∅ , m = cdm x ⇒ cdm x0 ∈ ω $ by weaken [a8b]
g7: $ G , x0 = scat x q , x0 ∊ fseq A , e ∊ A ∧ f ∊ fseq A ∧ q = scons e f , h = ∅ , m = cdm x ⇒ cdm x ∈ ω $ by omega_elem_omega_c [g5, g6]
e6: $ G , x0 = scat x q , x0 ∊ fseq A , e ∊ A ∧ f ∊ fseq A ∧ q = scons e f , h = ∅ ⇒ cdm x ∈ ω $ by isset_elim [e4d, g7]
e7: $ G , x0 = scat x q , x0 ∊ fseq A , e ∊ A ∧ f ∊ fseq A ∧ q = scons e f ⇒ cdm x ∈ ω $ by isset_elim [d4, e6]
d8a: $ G , x0 = scat x q , x0 ∊ fseq A , ∃ f (e ∊ A ∧ f ∊ fseq A ∧ q = scons e f) ⇒ ∃ f (e ∊ A ∧ f ∊ fseq A ∧ q = scons e f) $ by ax
d8: $ G , x0 = scat x q , x0 ∊ fseq A , ∃ f (e ∊ A ∧ f ∊ fseq A ∧ q = scons e f) ⇒ cdm x ∈ ω $ by ex_elim [d8a, e7]
d9a: $ G , x0 = scat x q , x0 ∊ fseq A , ∃ e ∃ f (e ∊ A ∧ f ∊ fseq A ∧ q = scons e f) ⇒ ∃ e ∃ f (e ∊ A ∧ f ∊ fseq A ∧ q = scons e f) $ by ax
d9: $ G , x0 = scat x q , x0 ∊ fseq A , ∃ e ∃ f (e ∊ A ∧ f ∊ fseq A ∧ q = scons e f) ⇒ cdm x ∈ ω $ by ex_elim [d9a, d8]
a9: $ G , x0 = scat x q , x0 ∊ fseq A ⇒ cdm x ∈ ω $ by or_elim [a8, c9, d9]
a10: $ G , x0 = scat x q , x0 ∊ fseq A ⇒ x ∊ fseq (crn x) $ by fseq_of_fn [a5, a6, a9, a7]
a11: $ G ⇒ x ∊ fseq (crn x) $ by wcel_elim [#1, a10]

--| The shape's entries: at a point over `X0` of the valuation `A` from `K` on,
--| `S` has one value there, with `⟨ ∅ , ∅ ⟩` in it unless the element is `∅`
--| (then the element is in `X`).
def b9_hs (D X0 A S K X: class) (.j .m .x .y .o: set): fml = $ ∀ j ∀ m ∀ x ∀ y (ra_nidx D j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x X0) y ∈ fv A (nadd K (fv nvf j)) → ∃ o (apn (fv S (nadd K (fv nvf j))) (scat x X0) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ X)))) $

--| The entries of `A` from `K` on, at points over `X0` with an element in `V`,
--| are entries of `B`.
def b9_hb (D X0 A B K V: class) (.j .m .x .y: set): fml = $ ∀ j ∀ m ∀ x ∀ y (ra_nidx D j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ V → nest (scat x X0) y ∈ fv A (nadd K (fv nvf j)) → nest (scat x X0) y ∈ fv B (nadd K (fv nvf j))) $

--| @congr
lemma b9_hs_congr (A B C D E F H I J K L N: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ L ≐ N $ > $ b9_hs A C E H J L ⟺ b9_hs B D F I K N $
----
c0a: $ j ≐ j $ by ceqt_refl
c0b: $ m ≐ m $ by ceqt_refl
c0c: $ lrel ≐ lrel $ by ceqt_refl
c1: $ ra_nidx A j m ≐ ra_nidx B j m $ by ra_nidx_congr [#1, c0a, c0b]
c2: $ (ra_nidx A j m ∈ lrel) ⟺ (ra_nidx B j m ∈ lrel) $ by wcel_congr [c1, c0c]
c3: $ (x ∊ fseq b7_V) ⟺ (x ∊ fseq b7_V) $ by iff_refl
c4: $ (cdm x = fv nvf m) ⟺ (cdm x = fv nvf m) $ by iff_refl
c5a: $ x ≐ x $ by ceqt_refl
c5: $ scat x C ≐ scat x D $ by scat_congr [c5a, #2]
c6a: $ y ≐ y $ by ceqt_refl
c6: $ nest (scat x C) y ≐ nest (scat x D) y $ by nest_congr [c5, c6a]
c7a: $ fv nvf j ≐ fv nvf j $ by ceqt_refl
c7: $ nadd J (fv nvf j) ≐ nadd K (fv nvf j) $ by nadd_congr [#5, c7a]
c8: $ fv E (nadd J (fv nvf j)) ≐ fv F (nadd K (fv nvf j)) $ by fv_congr [#3, c7]
c9: $ fv H (nadd J (fv nvf j)) ≐ fv I (nadd K (fv nvf j)) $ by fv_congr [#4, c7]
c10: $ (nest (scat x C) y ∈ fv E (nadd J (fv nvf j))) ⟺ (nest (scat x D) y ∈ fv F (nadd K (fv nvf j))) $ by wcel_congr [c6, c8]
c11: $ apn (fv H (nadd J (fv nvf j))) (scat x C) ≐ apn (fv I (nadd K (fv nvf j))) (scat x D) $ by apn_congr [c9, c5]
c12a: $ o ≐ o $ by ceqt_refl
c12b: $ csn o ≐ csn o $ by csn_congr [c12a]
c12: $ (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o) ⟺ (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o) $ by ceq_congr [c11, c12b]
c13a: $ (y = ∅) ⟺ (y = ∅) $ by iff_refl
c13b: $ (⟨ ∅ , ∅ ⟩ ∈ o) ⟺ (⟨ ∅ , ∅ ⟩ ∈ o) $ by iff_refl
c13c: $ seqt y y $ by seqt_refl
c13d: $ (y ∊ L) ⟺ (y ∊ N) $ by welc_congr [c13c, #6]
c13e: $ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L) ⟺ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N) $ by and_congr [c13b, c13d]
c13: $ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L)) ⟺ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N)) $ by or_congr [c13a, c13e]
c14: $ (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L))) ⟺ (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N))) $ by and_congr [c12, c13]
c15: $ (∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L)))) ⟺ (∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N)))) $ by ex_congr [c14]
c16: $ (nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → ∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L)))) ⟺ (nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → ∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N)))) $ by im_congr [c10, c15]
c17: $ (cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → ∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L)))) ⟺ (cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → ∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N)))) $ by im_congr [c4, c16]
c18: $ (x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → ∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L)))) ⟺ (x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → ∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N)))) $ by im_congr [c3, c17]
c19: $ (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → ∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L)))) ⟺ (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → ∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N)))) $ by im_congr [c2, c18]
c20: $ (∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → ∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L))))) ⟺ (∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → ∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N))))) $ by all_congr [c19]
c21: $ (∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → ∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L))))) ⟺ (∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → ∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N))))) $ by all_congr [c20]
c22: $ (∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → ∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L))))) ⟺ (∀ m ∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → ∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N))))) $ by all_congr [c21]
c23: $ (∀ j ∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → ∃ o (apn (fv H (nadd J (fv nvf j))) (scat x C) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ L))))) ⟺ (∀ j ∀ m ∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → ∃ o (apn (fv I (nadd K (fv nvf j))) (scat x D) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ N))))) $ by all_congr [c22]

--| @rewrite
lemma b9_sb_hs {z: set} (t: set z) (A B C D E F: class z): $ [z/t] (b9_hs A B C D E F) ⟺ b9_hs (⟦ z / t ⟧ A) (⟦ z / t ⟧ B) (⟦ z / t ⟧ C) (⟦ z / t ⟧ D) (⟦ z / t ⟧ E) (⟦ z / t ⟧ F) $
----
l1: $ [z/t] (∀ j ∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x B) y ∈ fv C (nadd E (fv nvf j)) → ∃ o (apn (fv D (nadd E (fv nvf j))) (scat x B) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ F))))) ⟺ ∀ j ∀ m ∀ x ∀ y (ra_nidx (⟦ z / t ⟧ A) j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → nest (scat x (⟦ z / t ⟧ B)) y ∈ fv (⟦ z / t ⟧ C) (nadd (⟦ z / t ⟧ E) (fv nvf j)) → ∃ o (apn (fv (⟦ z / t ⟧ D) (nadd (⟦ z / t ⟧ E) (fv nvf j))) (scat x (⟦ z / t ⟧ B)) = csn o ∧ (y = ∅ ∨ (⟨ ∅ , ∅ ⟩ ∈ o ∧ y ∊ (⟦ z / t ⟧ F))))) $ by iff_refl

--| @congr
lemma b9_hb_congr (A B C D E F H I J K L N: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ L ≐ N $ > $ b9_hb A C E H J L ⟺ b9_hb B D F I K N $
----
c0a: $ j ≐ j $ by ceqt_refl
c0b: $ m ≐ m $ by ceqt_refl
c0c: $ lrel ≐ lrel $ by ceqt_refl
c1: $ ra_nidx A j m ≐ ra_nidx B j m $ by ra_nidx_congr [#1, c0a, c0b]
c2: $ (ra_nidx A j m ∈ lrel) ⟺ (ra_nidx B j m ∈ lrel) $ by wcel_congr [c1, c0c]
c3: $ (x ∊ fseq b7_V) ⟺ (x ∊ fseq b7_V) $ by iff_refl
c4: $ (cdm x = fv nvf m) ⟺ (cdm x = fv nvf m) $ by iff_refl
c5a: $ x ≐ x $ by ceqt_refl
c5: $ scat x C ≐ scat x D $ by scat_congr [c5a, #2]
c6a: $ y ≐ y $ by ceqt_refl
c6: $ nest (scat x C) y ≐ nest (scat x D) y $ by nest_congr [c5, c6a]
c7a: $ fv nvf j ≐ fv nvf j $ by ceqt_refl
c7: $ nadd J (fv nvf j) ≐ nadd K (fv nvf j) $ by nadd_congr [#5, c7a]
c8: $ fv E (nadd J (fv nvf j)) ≐ fv F (nadd K (fv nvf j)) $ by fv_congr [#3, c7]
c9: $ fv H (nadd J (fv nvf j)) ≐ fv I (nadd K (fv nvf j)) $ by fv_congr [#4, c7]
c10: $ (nest (scat x C) y ∈ fv E (nadd J (fv nvf j))) ⟺ (nest (scat x D) y ∈ fv F (nadd K (fv nvf j))) $ by wcel_congr [c6, c8]
c11: $ (nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by wcel_congr [c6, c9]
c12: $ (nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c10, c11]
c12a: $ seqt y y $ by seqt_refl
c12b: $ (y ∊ L) ⟺ (y ∊ N) $ by welc_congr [c12a, #6]
c12c: $ (y ∊ L → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (y ∊ N → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c12b, c12]
c13: $ (cdm x = fv nvf m → y ∊ L → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (cdm x = fv nvf m → y ∊ N → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c4, c12c]
c14: $ (x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ L → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ N → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c3, c13]
c15: $ (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ L → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j))) ⟺ (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ N → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j))) $ by im_congr [c2, c14]
c16: $ (∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ L → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j)))) ⟺ (∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ N → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j)))) $ by all_congr [c15]
c17: $ (∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ L → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j)))) ⟺ (∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ N → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j)))) $ by all_congr [c16]
c18: $ (∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ L → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j)))) ⟺ (∀ m ∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ N → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j)))) $ by all_congr [c17]
c19: $ (∀ j ∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ L → nest (scat x C) y ∈ fv E (nadd J (fv nvf j)) → nest (scat x C) y ∈ fv H (nadd J (fv nvf j)))) ⟺ (∀ j ∀ m ∀ x ∀ y (ra_nidx B j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ N → nest (scat x D) y ∈ fv F (nadd K (fv nvf j)) → nest (scat x D) y ∈ fv I (nadd K (fv nvf j)))) $ by all_congr [c18]

--| @rewrite
lemma b9_sb_hb {z: set} (t: set z) (A B C D E F: class z): $ [z/t] (b9_hb A B C D E F) ⟺ b9_hb (⟦ z / t ⟧ A) (⟦ z / t ⟧ B) (⟦ z / t ⟧ C) (⟦ z / t ⟧ D) (⟦ z / t ⟧ E) (⟦ z / t ⟧ F) $
----
l1: $ [z/t] (∀ j ∀ m ∀ x ∀ y (ra_nidx A j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ F → nest (scat x B) y ∈ fv C (nadd E (fv nvf j)) → nest (scat x B) y ∈ fv D (nadd E (fv nvf j)))) ⟺ ∀ j ∀ m ∀ x ∀ y (ra_nidx (⟦ z / t ⟧ A) j m ∈ lrel → x ∊ fseq b7_V → cdm x = fv nvf m → y ∊ (⟦ z / t ⟧ F) → nest (scat x (⟦ z / t ⟧ B)) y ∈ fv (⟦ z / t ⟧ C) (nadd (⟦ z / t ⟧ E) (fv nvf j)) → nest (scat x (⟦ z / t ⟧ B)) y ∈ fv (⟦ z / t ⟧ D) (nadd (⟦ z / t ⟧ E) (fv nvf j))) $ by iff_refl

--| `A` and `B` agree below `K`.
def b9_ag (A B K: class) (.i: set): fml = $ ∀ i (i ∊ K → fv A i = fv B i) $

--| @congr
lemma b9_ag_congr (A B C D E F: class): $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ b9_ag A C E ⟺ b9_ag B D F $
----
c1: $ seqt i i $ by seqt_refl
c2: $ (i ∊ E) ⟺ (i ∊ F) $ by welc_congr [c1, #3]
c3a: $ i ≐ i $ by ceqt_refl
c3: $ fv A i ≐ fv B i $ by fv_congr [#1, c3a]
c4: $ fv C i ≐ fv D i $ by fv_congr [#2, c3a]
c5: $ (fv A i = fv C i) ⟺ (fv B i = fv D i) $ by ceq_congr [c3, c4]
c6: $ (i ∊ E → fv A i = fv C i) ⟺ (i ∊ F → fv B i = fv D i) $ by im_congr [c2, c5]
c7: $ (∀ i (i ∊ E → fv A i = fv C i)) ⟺ (∀ i (i ∊ F → fv B i = fv D i)) $ by all_congr [c6]

--| @rewrite
lemma b9_sb_ag {z: set} (t: set z) (A B C: class z): $ [z/t] (b9_ag A B C) ⟺ b9_ag (⟦ z / t ⟧ A) (⟦ z / t ⟧ B) (⟦ z / t ⟧ C) $
----
l1: $ [z/t] (∀ i (i ∊ C → fv A i = fv B i)) ⟺ ∀ i (i ∊ (⟦ z / t ⟧ C) → fv (⟦ z / t ⟧ A) i = fv (⟦ z / t ⟧ B) i) $ by iff_refl

--| The index shift under one more field.
lemma b9_kshift (G: hyps) (e n: set): $ G ⇒ e ∊ trees ω $ > $ G ⇒ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = suc (nadd (fv nvf e) (fv nvf n)) ∧ nadd (fv nvf e) (fv nvf n) ∈ ω $
----
s0: $ G ⇒ e ∈ trees ω $ by welc_wcel [#1]
s1: $ G ⇒ fv nvf ⟨ kc_s , scons e ∅ ⟩ = suc (fv nvf e) $ by nvf_s [s0]
s1b: $ G ⇒ fv nvf n = fv nvf n $ by eq_refl
s2: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = nadd (suc (fv nvf e)) (fv nvf n) $ by nadd_eq [s1, s1b]
s3a: $ G ⇒ functional nvf $ by nvf_functional
s3b: $ G ⇒ isset (fv nvf e) $ by fv_set [s3a]
s3c: $ G ⇒ isset n $ by isset_var
s3d: $ G ⇒ fv nvf n ∈ ω $ by nvf_omega [s3c]
s3: $ G ⇒ nadd (suc (fv nvf e)) (fv nvf n) = suc (nadd (fv nvf e) (fv nvf n)) $ by suc_nadd_c [s3b, s3d]
s4: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = suc (nadd (fv nvf e) (fv nvf n)) $ by eq_trans [s2, s3]
s5a: $ G ⇒ isset e $ by isset_var
s5b: $ G ⇒ fv nvf e ∈ ω $ by nvf_omega [s5a]
s5: $ G ⇒ nadd (fv nvf e) (fv nvf n) ∈ ω $ by nadd_omega_c [s5b, s3d]
s6: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n) = suc (nadd (fv nvf e) (fv nvf n)) ∧ nadd (fv nvf e) (fv nvf n) ∈ ω $ by and_intro [s4, s5]

--| A valuation's entries past one more field.
lemma b9_fvsh (G: hyps) (K J: class) (c a: set): $ G ⇒ K ∈ ω $ > $ G ⇒ J ∈ ω $ > $ G ⇒ fv (scons c a) (nadd (suc K) J) = fv a (nadd K J) $
----
t0: $ G ⇒ isset K $ by wcel_isset [#1]
t2: $ G ⇒ nadd (suc K) J = suc (nadd K J) $ by suc_nadd_c [t0, #2]
t4b: $ G ⇒ nadd K J ∈ ω $ by nadd_omega_c [#1, #2]
t4c: $ G ⇒ isset (nadd K J) $ by wcel_isset [t4b]
t4d: $ G ⇒ isset c $ by isset_var
t4e: $ G ⇒ isset a $ by isset_var
t5a: $ G ⇒ scons c a = scons c a $ by eq_refl
t5b: $ G ⇒ fv (scons c a) (nadd (suc K) J) = fv (scons c a) (suc (nadd K J)) $ by fv_eq [t5a, t2]
t5c: $ G ⇒ fv (scons c a) (suc (nadd K J)) = fv a (nadd K J) $ by scons_fv_suc_c [t4d, t4e, t4c]
t5: $ G ⇒ fv (scons c a) (nadd (suc K) J) = fv a (nadd K J) $ by eq_trans [t5b, t5c]

lemma b9_hs_sh (G: hyps) (D X0 X: class) (a s c h e n q p: set): $ G ⇒ b9_hs D X0 a s (nadd (fv nvf e) (fv nvf n)) X $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ q = scons c a $ > $ G ⇒ p = scons h s $ > $ G ⇒ b9_hs D X0 q p (nadd (fv nvf ⟨ kc_s , scons e ∅ ⟩) (fv nvf n)) X $
----
