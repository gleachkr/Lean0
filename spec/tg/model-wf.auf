h0: $ G , o ∊ b7_shp D K S ⇒ o ∊ b7_shp D K S2 $ by ex_elim [a2, h1]
h9: $ G ⇒ b7_shp D K S ⊆ b7_shp D K S2 $ by subset_intro [h0]

--| The trees `y` whose paths, for `cwf D N Q L K c d y`, have arguments some indices of type `K` in front of the parameters' window.
def b7_cs (U M W J D N Q L K: class) (.y .c .d .a: set): class = $ {y | ∀ c ∀ d ∀ a (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq U → etel U (dnf U M) y W a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q)))} $

lemma b7_cs_i {c d a: set} (G: hyps) (J M D N Q L K: class) (u w y: set): $ G , ra_cwf D N Q L K c d y ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u ⇒ etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q)) $ > $ G ⇒ y ∊ b7_cs u M w J D N Q L K $
----
l1: $ G , ra_cwf D N Q L K c d y ∈ lrel3 J , d ∊ trees ω ⇒ a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q)) $ by imp_intro [#1]
l2: $ G , ra_cwf D N Q L K c d y ∈ lrel3 J ⇒ d ∊ trees ω → a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q)) $ by imp_intro [l1]
l3: $ G ⇒ ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q)) $ by imp_intro [l2]
l4: $ G ⇒ ∀ a (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q))) $ by all_intro [l3]
l5: $ G ⇒ ∀ d ∀ a (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q))) $ by all_intro [l4]
l6: $ G ⇒ ∀ c ∀ d ∀ a (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q))) $ by all_intro [l5]
l7: $ G ⇒ y ∊ b7_cs u M w J D N Q L K $ by cab_intro [l6]

lemma b7_cs_e (G: hyps) (J M D N Q L K: class) (u w y n o p: set): $ G ⇒ y ∊ b7_cs u M w J D N Q L K $ > $ G ⇒ ra_cwf D N Q L K n o y ∈ lrel3 J $ > $ G ⇒ o ∊ trees ω $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ etel u (dnf u M) y w p ⊆ b7_shp D K (swin p (fv nvf o) (fv nvf Q)) $
----
l1: $ G ⇒ ∀ c ∀ d ∀ a (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q))) $ by cab_elim [#1]
l2: $ G ⇒ ∀ d ∀ a (ra_cwf D N Q L K n d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf d) (fv nvf Q))) $ by all_elim [l1]
l3: $ G ⇒ ∀ a (ra_cwf D N Q L K n o y ∈ lrel3 J → o ∊ trees ω → a ∊ fseq u → etel u (dnf u M) y w a ⊆ b7_shp D K (swin a (fv nvf o) (fv nvf Q))) $ by all_elim [l2]
l4: $ G ⇒ ra_cwf D N Q L K n o y ∈ lrel3 J → o ∊ trees ω → p ∊ fseq u → etel u (dnf u M) y w p ⊆ b7_shp D K (swin p (fv nvf o) (fv nvf Q)) $ by all_elim [l3]
l5: $ G ⇒ o ∊ trees ω → p ∊ fseq u → etel u (dnf u M) y w p ⊆ b7_shp D K (swin p (fv nvf o) (fv nvf Q)) $ by imp_elim [l4, #2]
l6: $ G ⇒ p ∊ fseq u → etel u (dnf u M) y w p ⊆ b7_shp D K (swin p (fv nvf o) (fv nvf Q)) $ by imp_elim [l5, #3]
l7: $ G ⇒ etel u (dnf u M) y w p ⊆ b7_shp D K (swin p (fv nvf o) (fv nvf Q)) $ by imp_elim [l6, #4]

lemma b7_cs_pi (G: hyps) (J M CC: class) (u w r t1 t2 t3 t4 t5 d z k j x1 x3 x4 x5 x7 x9 x0: set): $ G ⇒ crn j ⊆ b7_cs u M w J t1 t2 t3 t4 t5 $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ t1 = x1 $ > $ G ⇒ t3 = x3 $ > $ G ⇒ t4 = x4 $ > $ G ⇒ t5 = x5 $ > $ G ⇒ d = x7 $ > $ G ⇒ ra_cwf x1 t2 x3 x4 x5 CC ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J $ > $ G ⇒ isset CC $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ etel u (dnf u M) z w r ⊆ b7_shp t1 t5 (swin r (fv nvf d) (fv nvf t3)) $
----
r1: $ G ⇒ z ∈ trees ω $ by welc_wcel [#4]
x6: $ G ⇒ ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∈ trees ω $ by wcel_eq_l [#3, r1]
r3: $ G ⇒ isset ω $ by omega_set
r4: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
r5: $ G ⇒ isset kc_pi $ by wcel_isset [r4]
