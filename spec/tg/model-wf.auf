q4: $ G , f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel , i ∊ dt u M c w q , i ∊ u , ⟨ m , ⟨ n , ⟨ p , r ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons i q) , x = ssnoc m i , v = ⟨ scons i n , ⟨ scons (etel u (dnf u M) c w q) p , r ⟩ ⟩ ⇒ isset p $ by isset_var
q5: $ G , f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel , i ∊ dt u M c w q , i ∊ u , ⟨ m , ⟨ n , ⟨ p , r ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons i q) , x = ssnoc m i , v = ⟨ scons i n , ⟨ scons (etel u (dnf u M) c w q) p , r ⟩ ⟩ ⇒ isset (scons (etel u (dnf u M) c w q) p) $ by scons_set [q4]
q6: $ G , f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel , i ∊ dt u M c w q , i ∊ u , ⟨ m , ⟨ n , ⟨ p , r ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons i q) , x = ssnoc m i , v = ⟨ scons i n , ⟨ scons (etel u (dnf u M) c w q) p , r ⟩ ⟩ ⇒ isset r $ by isset_var
q7: $ G , f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel , i ∊ dt u M c w q , i ∊ u , ⟨ m , ⟨ n , ⟨ p , r ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons i q) , x = ssnoc m i , v = ⟨ scons i n , ⟨ scons (etel u (dnf u M) c w q) p , r ⟩ ⟩ ⇒ ∃ g ∃ t ∃ a (v = ⟨ g , ⟨ t , a ⟩ ⟩) $ by b3_tup3v [q3, q5, q6, q1]
q8: $ G , f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel ⇒ ∃ g ∃ t ∃ a (v = ⟨ g , ⟨ t , a ⟩ ⟩) $ by b3_pip_elim [p11, p12, p13, p14, p19, q7]
r1: $ G , ∃ o (f = ⟨ kc_srt , scons o ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = o) ⇒ ∃ o (f = ⟨ kc_srt , scons o ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = o) $ by ax
r2: $ G , ∃ o (f = ⟨ kc_srt , scons o ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = o) ⇒ ∃ g ∃ t ∃ a (v = ⟨ g , ⟨ t , a ⟩ ⟩) $ by ex_elim [r1, s23]
r3: $ G , ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) ⇒ ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) $ by ax
r4: $ G , ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) ⇒ ∃ g ∃ t ∃ a (v = ⟨ g , ⟨ t , a ⟩ ⟩) $ by ex_elim [r3, q8]
r5: $ G , ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) ⇒ ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) $ by ax
r6: $ G , ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) ⇒ ∃ g ∃ t ∃ a (v = ⟨ g , ⟨ t , a ⟩ ⟩) $ by ex_elim [r5, r4]
r7: $ G , ∃ d ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) ⇒ ∃ d ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) $ by ax
r8: $ G , ∃ d ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) ⇒ ∃ g ∃ t ∃ a (v = ⟨ g , ⟨ t , a ⟩ ⟩) $ by ex_elim [r7, r6]
r9: $ G , ∃ c ∃ d ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) ⇒ ∃ c ∃ d ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) $ by ax
r10: $ G , ∃ c ∃ d ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) ⇒ ∃ g ∃ t ∃ a (v = ⟨ g , ⟨ t , a ⟩ ⟩) $ by ex_elim [r9, r8]
r11: $ G ⇒ ∃ o (f = ⟨ kc_srt , scons o ∅ ⟩ ∧ k = ⟨ kc_nz , ∅ ⟩ ∧ l = o) ∨ ∃ c ∃ d ∃ e ∃ o (f = ⟨ kc_pi , scons c (scons d ∅) ⟩ ∧ k = ⟨ kc_s , scons e ∅ ⟩ ∧ l = o ∧ ra_isort d e o ∈ lrel) $ by lrel_isort_cases [#1]
r12: $ G ⇒ ∃ g ∃ t ∃ a (v = ⟨ g , ⟨ t , a ⟩ ⟩) $ by or_elim [r11, r2, r10]

lemma b3_exv {v: set} (G: hyps v) (C V: class) (x: set): $ G ⇒ isset V $ > $ G ⇒ ⟨ x , V ⟩ ∈ C $ > $ G ⇒ ∃ v (⟨ x , v ⟩ ∈ C) $
----
l1: $ G , j = V ⇒ j = V $ by ax
l2: $ G , j = V ⇒ V = j $ by eq_sym [l1]
l3: $ G , j = V ⇒ x = x $ by eq_refl
l4: $ G , j = V ⇒ ⟨ x , V ⟩ = ⟨ x , j ⟩ $ by opair_eq [l3, l2]
l5: $ G , j = V ⇒ ⟨ x , V ⟩ ∈ C $ by weaken [#2]
l6: $ G , j = V ⇒ ⟨ x , j ⟩ ∈ C $ by wcel_eq_l [l4, l5]
l7: $ G , j = V ⇒ ∃ v (⟨ x , v ⟩ ∈ C) $ by ex_intro [l6]
l8: $ G ⇒ ∃ v (⟨ x , v ⟩ ∈ C) $ by isset_elim [#1, l7]

lemma b3_pts_in {x y z v: set} (G: hyps x y z v) (E T W Q: class) (u r: set) (X V Z: class): $ G ⇒ isset X $ > $ G ⇒ isset V $ > $ G ⇒ isset Z $ > $ G ⇒ ⟨ X , V ⟩ ∈ etel u E T W Q $ > $ G ⇒ r = nest X Z $ > $ G ⇒ r ∊ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ y = nest x z)} $
----
l1: $ G , i = X , j = V , k = Z ⇒ i = X $ by ax
l2: $ G , i = X , j = V , k = Z ⇒ j = V $ by ax
l3: $ G , i = X , j = V , k = Z ⇒ k = Z $ by ax
l4: $ G , i = X , j = V , k = Z ⇒ X = i $ by eq_sym [l1]
l5: $ G , i = X , j = V , k = Z ⇒ V = j $ by eq_sym [l2]
l6: $ G , i = X , j = V , k = Z ⇒ Z = k $ by eq_sym [l3]
l7: $ G , i = X , j = V , k = Z ⇒ ⟨ X , V ⟩ = ⟨ i , j ⟩ $ by opair_eq [l4, l5]
l8: $ G , i = X , j = V , k = Z ⇒ ⟨ X , V ⟩ ∈ etel u E T W Q $ by weaken [#4]
l9: $ G , i = X , j = V , k = Z ⇒ ⟨ i , j ⟩ ∈ etel u E T W Q $ by wcel_eq_l [l7, l8]
l10: $ G , i = X , j = V , k = Z ⇒ ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) $ by ex_intro [l9]
l11: $ G , i = X , j = V , k = Z ⇒ nest X Z = nest i k $ by nest_eq [l4, l6]
l12: $ G , i = X , j = V , k = Z ⇒ r = nest X Z $ by weaken [#5]
l13: $ G , i = X , j = V , k = Z ⇒ r = nest i k $ by eq_trans [l12, l11]
l14: $ G , i = X , j = V , k = Z ⇒ ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i k $ by and_intro [l10, l13]
l15: $ G , i = X , j = V , k = Z ⇒ ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) $ by ex_intro [l14]
l16: $ G , i = X , j = V , k = Z ⇒ ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ r = nest x z) $ by ex_intro [l15]
l17: $ G , i = X , j = V , k = Z ⇒ r ∊ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ y = nest x z)} $ by cab_intro [l16]
l18: $ G , i = X , j = V ⇒ r ∊ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ y = nest x z)} $ by isset_elim [#3, l17]
l19: $ G , i = X ⇒ r ∊ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ y = nest x z)} $ by isset_elim [#2, l18]
l20: $ G ⇒ r ∊ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ y = nest x z)} $ by isset_elim [#1, l19]

lemma b3_ih_phi {c e x y z v: set} (G: hyps c e x y z v) (M N: class) (u w b m n: set): $ G ⇒ ∀ c (c ∊ fseq u → ∀ e (e ∈ dt u M b w c ↔ (e ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w c) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w c) → apn e x ∈ N)))) $ > $ G ⇒ m ∊ fseq u $ > $ G ⇒ n ∈ dt u M b w m ↔ (n ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w m) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w m) → apn n x ∈ N)) $
----
l1: $ G ⇒ m ∊ fseq u → ∀ e (e ∈ dt u M b w m ↔ (e ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w m) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w m) → apn e x ∈ N))) $ by all_elim [#1]
l2: $ G ⇒ ∀ e (e ∈ dt u M b w m ↔ (e ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w m) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w m) → apn e x ∈ N))) $ by imp_elim [l1, #2]
l3: $ G ⇒ n ∈ dt u M b w m ↔ (n ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w m) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w m) → apn n x ∈ N)) $ by all_elim [l2]

lemma b3_isw_srt {x y z v: set} (G: hyps) (M N: class) (u w q l h f: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ l ∈ trees ω $ > $ G ⇒ dt u M f w q = N $ > $ G ⇒ f = ⟨ kc_srt , scons l ∅ ⟩ $ > $ G ⇒ h ∈ dt u M f w q ↔ (h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N)) $
----
a1: $ G ⇒ isset ω $ by omega_set
a2: $ G ⇒ kc_srt ∈ ω $ by kc_srt_omega
a3: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
a4: $ G ⇒ scons l ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#3, a3]
a5: $ G ⇒ ⟨ kc_srt , scons l ∅ ⟩ ∈ trees ω $ by trees_intro_c [a1, a2, a4]
a6: $ G ⇒ ¬ kc_srt = kc_pi $ by kc_srt_ne_pi
a7: $ G ⇒ ¬ kc_srt = kc_app $ by kc_srt_ne_app
a8: $ G ⇒ etel u (dnf u M) ⟨ kc_srt , scons l ∅ ⟩ w q = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_trees [a5, a6, a7, #1, #2]
a9a: $ G ⇒ w = w $ by eq_refl
a9b: $ G ⇒ q = q $ by eq_refl
a9: $ G ⇒ etel u (dnf u M) f w q = etel u (dnf u M) ⟨ kc_srt , scons l ∅ ⟩ w q $ by etel_eq [#5, a9a, a9b]
a10: $ G ⇒ etel u (dnf u M) f w q = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [a9, a8]
k1: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ e = ∅ $ by ax
k2: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ o = ⟨ e , ⟨ e , e ⟩ ⟩ $ by ax
k3: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ ⟨ e , e ⟩ = ⟨ ∅ , ∅ ⟩ $ by opair_eq [k1, k1]
k4: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ ⟨ e , ⟨ e , e ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ $ by opair_eq [k1, k3]
k5: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ o = ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ $ by eq_trans [k2, k4]
k6: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ ⟨ e , o ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by opair_eq [k1, k5]
k7: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ isset ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by opair_isset
k8: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ ∈ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by csn_intro_var_c [k7]
k9: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ = ⟨ e , o ⟩ $ by eq_sym [k6]
k10: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ ⟨ e , o ⟩ ∈ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by wcel_eq_l [k9, k8]
k11: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ etel u (dnf u M) f w q = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by weaken [a10]
k12: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ = etel u (dnf u M) f w q $ by eq_sym [k11]
k13: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ ⟨ e , o ⟩ ∈ etel u (dnf u M) f w q $ by wcel_eq_r [k12, k10]
k14: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ ∃ v (⟨ e , v ⟩ ∈ etel u (dnf u M) f w q) $ by ex_intro [k13]
k15: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ h = h $ by eq_refl
k16: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ apn h e = apn h ∅ $ by apn_eq [k15, k1]
k17: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ apn h ∅ = h $ by apn_empty
k18: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ apn h e = h $ by eq_trans [k16, k17]
k19: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ dt u M f w q = N $ by weaken [#4]
k20: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ N = dt u M f w q $ by eq_sym [k19]
b1: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q ⇒ h ∈ dt u M f w q $ by ax
b1a: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q ⇒ dt u M f w q = N $ by weaken [k19]
b2: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q ⇒ h ∈ N $ by wcel_eq_r [b1a, b1]
b3: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ isset r $ by isset_var
b4: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ isset e $ by isset_var
b5: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ isset o $ by isset_var
b6: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ ⟨ e , o ⟩ ∈ etel u (dnf u M) f w q $ by weaken [k13]
b7: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ nest ∅ r = r $ by nest_empty [b3]
b8: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ e = ∅ $ by weaken [k1]
b9: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ r = r $ by eq_refl
b10: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ nest e r = nest ∅ r $ by nest_eq [b8, b9]
b11: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ nest e r = r $ by eq_trans [b10, b7]
b12: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ r = nest e r $ by eq_sym [b11]
b13: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , r ∊ h ⇒ r ∊ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} $ by b3_pts_in [b4, b5, b3, b6, b12]
b14: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q ⇒ h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} $ by subset_intro [b13]
c1: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q $ by ax
c2: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ etel u (dnf u M) f w q = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by weaken [a10]
c3: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ ⟨ x , v ⟩ ∈ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by wcel_eq_r [c2, c1]
c4: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ ⟨ x , v ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by csn_elim_c [c3]
c5: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ isset x $ by isset_var
c6: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ isset v $ by isset_var
c7: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ isset ∅ $ by ax_empty
c8: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ isset ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ $ by opair_isset
c9: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ x = ∅ ∧ v = ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ $ by opair_inj_c [c4, c5, c6, c7, c8]
c10: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ x = ∅ $ by and_elim_l [c9]
c11: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ h = h $ by eq_refl
c12: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ apn h x = apn h ∅ $ by apn_eq [c11, c10]
c13: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ apn h ∅ = h $ by apn_empty
c14: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ apn h x = h $ by eq_trans [c12, c13]
c15: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ h = apn h x $ by eq_sym [c14]
c16: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ h ∈ N $ by weaken [b2]
c17: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ⟨ x , v ⟩ ∈ etel u (dnf u M) f w q ⇒ apn h x ∈ N $ by wcel_eq_l [c15, c16]
c18: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ⇒ ∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) $ by ax
c19: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q , ∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ⇒ apn h x ∈ N $ by ex_elim [c18, c17]
c20: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q ⇒ ∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N $ by imp_intro [c19]
c21: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q ⇒ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) $ by all_intro [c20]
c22: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ∈ dt u M f w q ⇒ h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) $ by and_intro [b14, c21]
d1: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) $ by ax
d2: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) $ by and_elim_r [d1]
d3: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ ∃ v (⟨ e , v ⟩ ∈ etel u (dnf u M) f w q) → apn h e ∈ N $ by all_elim [d2]
d4: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ ∃ v (⟨ e , v ⟩ ∈ etel u (dnf u M) f w q) $ by weaken [k14]
d5: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ apn h e ∈ N $ by imp_elim [d3, d4]
d6: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ apn h e = h $ by weaken [k18]
d7: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ h ∈ N $ by wcel_eq_l [d6, d5]
d8: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ N = dt u M f w q $ by weaken [k20]
d9: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ , h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N) ⇒ h ∈ dt u M f w q $ by wcel_eq_r [d8, d7]
d10: $ G , e = ∅ , o = ⟨ e , ⟨ e , e ⟩ ⟩ ⇒ h ∈ dt u M f w q ↔ (h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N)) $ by bi_intro [c22, d9]
d11: $ G , e = ∅ ⇒ isset ⟨ e , ⟨ e , e ⟩ ⟩ $ by opair_isset
d12: $ G , e = ∅ ⇒ h ∈ dt u M f w q ↔ (h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N)) $ by isset_elim [d11, d10]
d13: $ G ⇒ isset ∅ $ by ax_empty
d14: $ G ⇒ h ∈ dt u M f w q ↔ (h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N)) $ by isset_elim [d13, d12]

lemma b3_efs (G: hyps) (E W R: class) (u o f g t a: set): $ G ⇒ o ∈ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W R $ > $ G ⇒ f ∊ fseq u $
----
l1: $ G ⇒ o ∊ trees ω $ by wcel_welc [#1]
l3: $ G , y = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , y ∊ etel u E o W R ⇒ y ∊ etel u E o W R $ by ax
l4: $ G , y = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , y ∊ etel u E o W R ⇒ o ∊ trees ω $ by weaken [l1]
l5: $ G , y = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , y ∊ etel u E o W R ⇒ isset W ∧ isset R $ by etel_isset [l4, l3]
l6: $ G ⇒ isset W ∧ isset R $ by wcel_elim [#2, l5]
l7: $ G ⇒ isset W $ by and_elim_l [l6]
l8: $ G ⇒ isset R $ by and_elim_r [l6]
m1: $ G , r = R ⇒ r = R $ by ax
m2: $ G , r = R ⇒ W = W $ by eq_refl
m3: $ G , r = R ⇒ o = o $ by eq_refl
m4: $ G , r = R ⇒ R = r $ by eq_sym [m1]
m5: $ G , r = R ⇒ etel u E o W R = etel u E o W r $ by etel_eq [m3, m2, m4]
m6: $ G , r = R ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W R $ by weaken [#2]
m7: $ G , r = R ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o W r $ by wcel_eq_r [m5, m6]
m8: $ G , r = R ⇒ isset W $ by weaken [l7]
m9a: $ G , r = R ⇒ o ∈ trees ω $ by weaken [#1]
m9: $ G , r = R ⇒ f ∊ fseq u ∧ g ∊ fseq u ∧ cdm g = cdm f ∧ cdm t = cdm f $ by etel_fseq_c [m8, m9a, m7]
m10: $ G , r = R ⇒ f ∊ fseq u $ by and_elim_l [m9]
m11: $ G ⇒ f ∊ fseq u $ by isset_elim [l8, m10]

lemma b3_pts_elim {x y z v i j p: set} (G H: hyps x y z v) (E T W Q: class) (u r: set) (c0: fml x y z v): $ G ⇒ r ∊ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ y = nest x z)} $ > $ H , ⟨ i , p ⟩ ∈ etel u E T W Q , r = nest i j ⇒ c0 $ > $ G , H ⇒ c0 $
----
l1: $ G ⇒ ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ r = nest x z) $ by cab_elim [#1]
l2: $ ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ r = nest x z) ⟺ ∃ i ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) $ by ex_alpha
l3: $ G ⇒ ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u E T W Q) ∧ r = nest x z) ↔ ∃ i ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) $ by weaken [l2]
l4: $ G ⇒ ∃ i ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) $ by bi_elim_l [l3, l1]
m1: $ H , ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) ⇒ ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) $ by ax
m2: $ ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) ⟺ ∃ j (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j) $ by ex_alpha
m3: $ H , ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) ⇒ ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) ↔ ∃ j (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j) $ by weaken [m2]
m4: $ H , ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) ⇒ ∃ j (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j) $ by bi_elim_l [m3, m1]
n1: $ H , ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j ⇒ ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j $ by ax
n2: $ H , ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j ⇒ ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) $ by and_elim_l [n1]
n3: $ H , ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j ⇒ r = nest i j $ by and_elim_r [n1]
n4: $ ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ⟺ ∃ p (⟨ i , p ⟩ ∈ etel u E T W Q) $ by ex_alpha
n5: $ H , ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j ⇒ ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ↔ ∃ p (⟨ i , p ⟩ ∈ etel u E T W Q) $ by weaken [n4]
n6: $ H , ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j ⇒ ∃ p (⟨ i , p ⟩ ∈ etel u E T W Q) $ by bi_elim_l [n5, n2]
o1: $ H , ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j , ⟨ i , p ⟩ ∈ etel u E T W Q ⇒ r = nest i j $ by weaken [n3]
o2: $ H , ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j , ⟨ i , p ⟩ ∈ etel u E T W Q ⇒ c0 $ by cut [o1, #2]
o3: $ H , ∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i j ⇒ c0 $ by ex_elim [n6, o2]
o4: $ H , ∃ z (∃ v (⟨ i , v ⟩ ∈ etel u E T W Q) ∧ r = nest i z) ⇒ c0 $ by ex_elim [m4, o3]
o5: $ G , H ⇒ c0 $ by ex_elim [l4, o4]

lemma b3_isw_pi {x y z v c e: set} (G: hyps c e x y z v) (M N: class) (u w q d b k1 l1 h f: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ d ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ b ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ra_isort b k1 l1 ∈ lrel $ > $ G ⇒ ∀ c (c ∊ fseq u → ∀ e (e ∈ dt u M b w c ↔ (e ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w c) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) b w c) → apn e x ∈ N)))) $ > $ G ⇒ f = ⟨ kc_pi , scons d (scons b ∅) ⟩ $ > $ G ⇒ h ∈ dt u M f w q ↔ (h ⊆ {y | ∃ x ∃ z (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) ∧ y = nest x z)} ∧ ∀ x (∃ v (⟨ x , v ⟩ ∈ etel u (dnf u M) f w q) → apn h x ∈ N)) $
----
g1: $ G ⇒ universe u $ by uadm_universe [#1]
g2: $ G ⇒ d ∈ trees ω $ by lsig_ofsort_trees [#4]
g3: $ G ⇒ b ∈ trees ω $ by lsig_ofsort_trees [#5]
g4: $ G ⇒ dt u M d w q ∈ u $ by dt_in_u [#1, #4, #2, #3]
g5: $ G ⇒ isset h $ by isset_var
g6t: $ G ⇒ dt u M ⟨ kc_pi , scons d (scons b ∅) ⟩ w q = cpi o (dt u M d w q) (dt u M b w (scons o q)) $ by dt_pi [g2, g3, #2, #3]
g6u: $ G ⇒ u = u $ by eq_refl
g6m: $ G ⇒ M = M $ by eq_refl
g6w: $ G ⇒ w = w $ by eq_refl
g6q: $ G ⇒ q = q $ by eq_refl
g6x: $ G ⇒ dt u M f w q = dt u M ⟨ kc_pi , scons d (scons b ∅) ⟩ w q $ by dt_eq [g6u, g6m, #8, g6w, g6q]
g6: $ G ⇒ dt u M f w q = cpi o (dt u M d w q) (dt u M b w (scons o q)) $ by eq_trans [g6x, g6t]
g9: $ G ⇒ etel u (dnf u M) f w q = etel u (dnf u M) ⟨ kc_pi , scons d (scons b ∅) ⟩ w q $ by etel_eq [#8, g6w, g6q]
g10: $ G ⇒ etel u (dnf u M) ⟨ kc_pi , scons d (scons b ∅) ⟩ w q = etel u (dnf u M) f w q $ by eq_sym [g9]
g7: $ G ⇒ isset w $ by isset_var
g8: $ G ⇒ cpi o (dt u M d w q) (dt u M b w (scons o q)) = dt u M f w q $ by eq_sym [g6]
a1: $ G , h ∈ dt u M f w q , r ∊ h ⇒ h ∈ dt u M f w q $ by ax
a1a: $ G , h ∈ dt u M f w q , r ∊ h ⇒ dt u M f w q = cpi o (dt u M d w q) (dt u M b w (scons o q)) $ by weaken [g6]
a2: $ G , h ∈ dt u M f w q , r ∊ h ⇒ h ∈ cpi o (dt u M d w q) (dt u M b w (scons o q)) $ by wcel_eq_r [a1a, a1]
a3: $ G , h ∈ dt u M f w q , r ∊ h ⇒ h ∊ cpi o (dt u M d w q) (dt u M b w (scons o q)) $ by wcel_welc [a2]
a4: $ G , h ∈ dt u M f w q , r ∊ h ⇒ h ⊆ clam o (dt u M d w q) (⋃ (dt u M b w (scons o q))) $ by cpi_elim_sub [a3]
a5: $ G , h ∈ dt u M f w q , r ∊ h ⇒ r ∊ h $ by ax
a6: $ G , h ∈ dt u M f w q , r ∊ h ⇒ r ∊ clam o (dt u M d w q) (⋃ (dt u M b w (scons o q))) $ by subset_elim [a4, a5]
b1a: $ G , h ∈ dt u M f w q , r ∊ h , r = ⟨ k , l ⟩ , k ∊ dt u M d w q , l ∊ ⋃ (dt u M b w (scons k q)) ⇒ r ∊ h $ by ax
b1b: $ G , h ∈ dt u M f w q , r ∊ h , r = ⟨ k , l ⟩ , k ∊ dt u M d w q , l ∊ ⋃ (dt u M b w (scons k q)) ⇒ r ∈ h $ by welc_wcel [b1a]
