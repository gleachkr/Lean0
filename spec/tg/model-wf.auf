lemma b7_ient_el {z o: set} (G: hyps) (D W Z J: class) (v: set): $ G ⇒ v ∊ ient D W Z J $ > $ G ⇒ ∃ z ∃ o (⟨ J , ⟨ z , o ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest z ∅) ∨ (¬ iprop D J W ∧ v = nest z o))) $
----
l1: $ G ⇒ ∃ z ∃ o (⟨ J , ⟨ z , o ⟩ ⟩ ∈ Z ∧ ((iprop D J W ∧ v = nest z ∅) ∨ (¬ iprop D J W ∧ v = nest z o))) $ by cab_elim [#1]

lemma b7_hq_top {j c k i x y: set} (G: hyps j c k i x y) (J M D W Z Z2 Q: class) (u p t n x0 l x4 r: set): $ G ⇒ iprt D p t $ > $ G ⇒ ra_clen p x0 ∈ lrel $ > $ G ⇒ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n x0 l i x4 ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ > $ G ⇒ uadm u $ > $ G ⇒ D ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Z2 ∈ u $ > $ G ⇒ Z2 ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Z ⊆ ifam u (dnf u M) D W $ > $ G ⇒ Q ∈ fseq u $ > $ G ⇒ r = Q $ > $ G ⇒ cdm r = fv nvf x0 $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ ∀ j ∀ x ∀ y (⟨ j , ⟨ scat x Q , y ⟩ ⟩ ∈ Z → ⟨ j , ⟨ scat x Q , y ⟩ ⟩ ∈ Z2) $ > $ G ⇒ b7_hq D Q (scat r (ixs D W Z)) (scat r (ixs D W Z2)) (nadd (fv nvf ⟨ kc_nz , ∅ ⟩) (fv nvf x0)) $
----
