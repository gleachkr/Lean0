end: $ H ⇒ (n = x0 ∧ k = x1 ∧ z = ⟨ kc_pi , scons x9 (scons b ∅) ⟩ ∧ e = ⟨ kc_pi , scons l (scons m ∅) ⟩ ∧ ra_lift x0 x1 x9 l ∈ lrel ∧ ra_lift x0 ⟨ kc_s , scons x1 ∅ ⟩ b m ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $ by imp_intro [fin2]

lemma b5_k_cl (H: hyps) (M: class) (u w n q s k z e p r o c j x0 x3 x1 h: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ q ∊ fseq u $ > $ H ⇒ cdm q = fv nvf n $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ crn j ⊆ b5_lp u M w n q s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_lift n k z e ∈ lrel $ > $ H ⇒ p ∊ fseq u $ > $ H ⇒ cdm p = fv nvf k $ > $ H ⇒ r = scat p (scat q s) $ > $ H ⇒ o = scat p s $ > $ H ⇒ (n = x0 ∧ k = x1 ∧ z = h ∧ e = h ∧ ra_closed x3 h ∈ lrel ∧ ra_le x3 x1 ∈ lrel) → etel u (dnf u M) e w r = etel u (dnf u M) z w o $
----
