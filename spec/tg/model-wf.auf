l4f: $ G ⇒ fv nvf x3 = fv nvf t3 $ by fv_eq [l4b, l4d]
l4: $ G ⇒ swin r (fv nvf x7) (fv nvf x3) = swin r (fv nvf d) (fv nvf t3) $ by swin_eq [l4a, l4e, l4f]
l5a: $ G ⇒ isset x3 $ by isset_var
l5b: $ G ⇒ fv nvf x3 ∈ ω $ by nvf_omega [l5a]
l5c: $ G ⇒ swin r (fv nvf x7) (fv nvf x3) ∈ fseq u $ by swin_fseq [#10, #9, l5b]
l5: $ G ⇒ swin r (fv nvf x7) (fv nvf x3) ∈ fseq b7_V $ by b7_fseqV [l5c]
