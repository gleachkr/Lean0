lemma b15_main {n p l i v b c d h: set} (G: hyps) (H J C D W R P T Q S: class) (u j0 c0 k0 tb tP tT tnp tn tm0 tG2 tl tf te tk: set): $ G ⇒ iwf u H J C D W R $ > $ G ⇒ ¬ ilev D W = ∅ $ > $ G ⇒ Q ∈ esat u (dnf u (mcv H)) tP W $ > $ G ⇒ S ∈ fv uni (ilev D W) $ > $ G ⇒ ictk D j0 c0 k0 $ > $ G ⇒ tP = P $ > $ G ⇒ tT = T $ > $ G ⇒ ra_ind_data D tb tP tT ∈ lrel $ > $ G ⇒ ra_tys_closed tP tT ∈ lrel $ > $ G ⇒ ra_clen tP tnp ∈ lrel $ > $ G ⇒ ra_ntys tT tn tm0 ∈ lrel $ > $ G ⇒ ra_capp tP C tG2 ∈ lrel $ > $ G ⇒ ra_nth_ty tT ⟨ kc_nz , ∅ ⟩ tf te ∈ lrel $ > $ G ⇒ ra_isort tf tk tl ∈ lrel $ > $ G ⇒ ra_tys_wf D tn tnp tl ⟨ kc_nz , ∅ ⟩ tG2 tT ∈ lrel3 J $ > $ G ⇒ ∃ n ∃ p ∃ l ∃ i ∃ v ∃ b ∃ c ∃ d ∃ h (b12_sub H J D W R P T Q S u k0 n p l i v b c d h) $
