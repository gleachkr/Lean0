q49: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ nadd (fv nvf t4) (fv nvf t3) = nadd (fv nvf x4) (fv nvf x3) $ by nadd_eq [q47, q48]
q50: $ G , h = scat t6 X , l = scat t6 Y , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ z = x6 ∧ ra_add x4 x3 x5 ∈ lrel ∧ ra_closed x5 x6 ∈ lrel ⇒ cdm t6 = nadd (fv nvf t4) (fv nvf t3) $ by weaken [#12]
