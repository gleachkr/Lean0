--| Equal concatenations whose second parts have the same length.
lemma b11_pq_inj (G: hyps) (Q N: class) (u p y x2: set): $ G ⇒ scat y p = scat x2 Q $ > $ G ⇒ y ∊ fseq b7_V $ > $ G ⇒ x2 ∊ fseq (crn x2) $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ Q ∈ fseq u $ > $ G ⇒ cdm p = N $ > $ G ⇒ cdm Q = N $ > $ G ⇒ p = Q $
----
yv: $ … ⇒ y ∈ fseq b7_V $ by welc_wcel [#2]
xa: $ … ⇒ x2 ∈ fseq (crn x2) $ by welc_wcel [#3]
xv: $ … ⇒ x2 ∈ fseq b7_V $ by b7_fseqV [xa]
pa: $ … ⇒ p ∈ fseq u $ by welc_wcel [#4]
pv: $ … ⇒ p ∈ fseq b7_V $ by b7_fseqV [pa]
qv: $ … ⇒ Q ∈ fseq b7_V $ by b7_fseqV [#5]
ns: $ … ⇒ N = cdm Q $ by eq_sym [#7]
e5: $ … ⇒ cdm p = cdm Q $ by eq_trans [#6, ns]
l1: $ … ⇒ cdm (scat y p) = nadd (cdm y) (cdm p) $ by scat_len_c [yv, pv]
l2: $ … ⇒ cdm (scat x2 Q) = nadd (cdm x2) (cdm Q) $ by scat_len_c [xv, qv]
l3: $ … ⇒ cdm (scat y p) = cdm (scat x2 Q) $ by cdm_eq [#1]
l4: $ … ⇒ nadd (cdm y) (cdm p) = cdm (scat y p) $ by eq_sym [l1]
l5: $ … ⇒ nadd (cdm y) (cdm p) = cdm (scat x2 Q) $ by eq_trans [l4, l3]
l6: $ … ⇒ nadd (cdm y) (cdm p) = nadd (cdm x2) (cdm Q) $ by eq_trans [l5, l2]
ry: $ G ⇒ cdm y = cdm y $ by eq_refl
l7: $ … ⇒ nadd (cdm y) (cdm p) = nadd (cdm y) (cdm Q) $ by nadd_eq [ry, e5]
l8: $ … ⇒ nadd (cdm y) (cdm Q) = nadd (cdm y) (cdm p) $ by eq_sym [l7]
l9: $ … ⇒ nadd (cdm y) (cdm Q) = nadd (cdm x2) (cdm Q) $ by eq_trans [l8, l6]
o1: $ … ⇒ cdm y ∈ ω $ by fseq_len [#2]
o2: $ … ⇒ cdm x2 ∈ ω $ by fseq_len [#3]
o3: $ … ⇒ cdm p ∈ ω $ by fseq_len [#4]
o4: $ … ⇒ cdm Q ∈ ω $ by wcel_eq_l [e5, o3]
m1: $ … ⇒ nadd (cdm y) (cdm Q) = nadd (cdm Q) (cdm y) $ by nadd_comm_c [o1, o4]
m2: $ … ⇒ nadd (cdm x2) (cdm Q) = nadd (cdm Q) (cdm x2) $ by nadd_comm_c [o2, o4]
m3: $ … ⇒ nadd (cdm Q) (cdm y) = nadd (cdm y) (cdm Q) $ by eq_sym [m1]
m4: $ … ⇒ nadd (cdm Q) (cdm y) = nadd (cdm x2) (cdm Q) $ by eq_trans [m3, l9]
m5: $ … ⇒ nadd (cdm Q) (cdm y) = nadd (cdm Q) (cdm x2) $ by eq_trans [m4, m2]
m6: $ … ⇒ cdm y = cdm x2 $ by nadd_cancel_l_c [o1, o2, o4, m5]
m7: $ … ⇒ y = x2 ∧ p = Q $ by scat_inj_c [yv, xv, pv, qv, m6, e5, #1]
m8: $ … ⇒ p = Q $ by and_elim_r [m7]

--| The parameters of a path's valuation are `Q`, if its arguments end in `Q`.
lemma b11_pq (G: hyps) (J M D W Z P T Q: class) (u x p3 e3 t2 t3 t4 t5 t6 q e p j c k f g t a x2: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ Z ∈ u $ > $ G ⇒ Z ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ x ∊ u $ > $ G ⇒ iprt D p3 e3 $ > $ G ⇒ ra_clen p3 t3 ∈ lrel $ > $ G ⇒ ra_cwf D t2 t3 t4 t5 t6 ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J $ > $ G ⇒ iprt D q e $ > $ G ⇒ p ∊ esat u (dnf u M) q W $ > $ G ⇒ ictk D j c k $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) k W (scat p (ixs D W (isup Z x))) $ > $ G ⇒ a = scat x2 Q $ > $ G ⇒ x2 ∊ fseq (crn x2) $ > $ G ⇒ p = Q $
----
xu: $ … ⇒ x ∈ u $ by welc_wcel [#8]
pe: $ … ⇒ p ∈ esat u (dnf u M) q W $ by welc_wcel [#13]
rf: $ … ⇒ scat p (ixs D W (isup Z x)) ∈ fseq u $ by b11_wd [#1, #4, #5, pe, xu]
xf: $ … ⇒ ixs D W (isup Z x) ∈ fseq u $ by b11_tp_ixs [#1, #4, #5, xu]
q0: $ G ⇒ esat u (dnf u M) q W ⊆ fseq u $ by esat_fseq
pf: $ … ⇒ p ∊ fseq u $ by subset_elim [q0, #13]
pc: $ … ⇒ p ∈ fseq u $ by welc_wcel [pf]
q1: $ G ⇒ esat u (dnf u M) P W ⊆ fseq u $ by esat_fseq
qf: $ … ⇒ Q ∈ fseq u $ by wcel_subset [q1, #7]
ls: $ G ⇒ sig lsig lopen $ by lsig_sig
dt0: $ … ⇒ ofsort lsig lopen ks_ind ⊆ trees ω $ by ofsort_trees [ls]
dtr: $ … ⇒ D ∈ trees ω $ by wcel_subset [dt0, #2]
