m3: $ G ⇒ fv (etf u E) ⟨ k , h ⟩ = clam o lvals (clam p (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) o p ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) o p) a) ⟩ ⟩ ⟩)}) $ by eq_trans [n4, m2]
w1: $ G ⇒ w = w $ by eq_refl
r1: $ G ⇒ r = r $ by eq_refl
