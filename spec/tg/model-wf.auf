lemma b14_lift1 (G: hyps) (M W R: class) (u t3 t4 x y: set): $ G ⇒ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t3 t4 ∈ lrel $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ x ∊ u $ > $ G ⇒ y ∊ u $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ etel u (dnf u M) t4 W (scons x R) = etel u (dnf u M) t4 W (scons y R) $
----
a1: $ G , w = W , r = R ⇒ w = W $ by ax
a2: $ G , w = W , r = R ⇒ r = R $ by ax
a3: $ … ⇒ W = w $ by eq_sym [a1]
a4: $ … ⇒ R = r $ by eq_sym [a2]
a5: $ G , w = W , r = R ⇒ W ∈ lvals $ by weaken [#2]
a6: $ … ⇒ w ∈ lvals $ by wcel_eq_l [a3, a5]
a7: $ … ⇒ w ∊ lvals $ by wcel_welc [a6]
a8: $ G , w = W , r = R ⇒ R ∈ fseq u $ by weaken [#5]
a9: $ … ⇒ r ∈ fseq u $ by wcel_eq_l [a4, a8]
a10: $ … ⇒ r ∊ fseq u $ by wcel_welc [a9]
a11: $ G , w = W , r = R ⇒ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t3 t4 ∈ lrel $ by weaken [#1]
a12: $ G , w = W , r = R ⇒ x ∊ u $ by weaken [#3]
a13: $ G , w = W , r = R ⇒ y ∊ u $ by weaken [#4]
a14: $ … ⇒ etel u (dnf u M) t4 w (scons x r) = etel u (dnf u M) t4 w (scons y r) $ by b6_lift1_etel [a11, a7, a12, a13, a10]
a15: $ G , w = W , r = R ⇒ t4 = t4 $ by eq_refl
a16: $ G , w = W , r = R ⇒ x = x $ by eq_refl
a17: $ G , w = W , r = R ⇒ y = y $ by eq_refl
a18: $ … ⇒ scons x R = scons x r $ by scons_eq [a16, a4]
a19: $ … ⇒ scons y r = scons y R $ by scons_eq [a17, a2]
a20: $ … ⇒ etel u (dnf u M) t4 W (scons x R) = etel u (dnf u M) t4 w (scons x r) $ by etel_eq [a15, a3, a18]
a21: $ … ⇒ etel u (dnf u M) t4 w (scons y r) = etel u (dnf u M) t4 W (scons y R) $ by etel_eq [a15, a1, a19]
a22: $ … ⇒ etel u (dnf u M) t4 W (scons x R) = etel u (dnf u M) t4 w (scons y r) $ by eq_trans [a20, a14]
a23: $ … ⇒ etel u (dnf u M) t4 W (scons x R) = etel u (dnf u M) t4 W (scons y R) $ by eq_trans [a22, a21]
a24: $ G ⇒ isset R $ by wcel_isset [#5]
a25: $ … ⇒ etel u (dnf u M) t4 W (scons x R) = etel u (dnf u M) t4 W (scons y R) $ by isset_elim [a24, a23]
a26: $ G ⇒ isset W $ by wcel_isset [#2]
a27: $ … ⇒ etel u (dnf u M) t4 W (scons x R) = etel u (dnf u M) t4 W (scons y R) $ by isset_elim [a26, a25]

lemma b14_mv {g f t a: set} (G: hyps g f t a) (A B: class) (c: set): $ G ⇒ A = B $ > $ G ⇒ c ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ A)} $ > $ G ⇒ c ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $
----
l1: $ G ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by cab_elim [#2]
l2: $ A = B , ⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A ⇒ ⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A $ by ax
l3: $ A = B , ⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A ⇒ A = B $ by ax
l4: $ … ⇒ ⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B $ by wcel_eq_r [l3, l2]
l5: $ … ⇒ ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [l4]
l6: $ … ⇒ ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [l5]
l7: $ … ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_intro [l6]
l8: $ A = B , ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) ⇒ ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by ax
l9: $ A = B , ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_elim [l8, l7]
l10: $ A = B , ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) ⇒ ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) $ by ax
l11: $ A = B , ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ A) ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_elim [l10, l9]
l12: $ G , A = B ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by ex_elim [l1, l11]
l13: $ G ⇒ A = B → ∃ f ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by imp_intro [l12]
l14: $ G ⇒ ∃ f ∃ t ∃ a (⟨ f , ⟨ c , ⟨ t , a ⟩ ⟩ ⟩ ∈ B) $ by imp_elim [l13, #1]
l15: $ G ⇒ c ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ B)} $ by cab_intro [l14]

lemma b14_d0 {y b c g f t a: set} (G: hyps) (M W R: class) (u z t10 t11: set): $ G ⇒ z = ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ ∀ y (y ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W R)} → ∃ b ∃ c (b ∊ da (fv (dnf u M) t10) W R ∧ b ∊ u ∧ c ∊ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t11 W (scons b R))} ∧ c ∊ fseq u ∧ y = scons b c)) $
----
t1: $ G ⇒ z ∈ trees ω $ by welc_wcel [#2]
t2: $ … ⇒ ⟨ kc_pi , scons t10 (scons t11 ∅) ⟩ ∈ trees ω $ by wcel_eq_l [#1, t1]
