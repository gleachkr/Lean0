q5: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [q4]
q6: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ t3 = x2 ∧ z = x2 $ by and_elim_r [q4]
q7: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ t3 = x2 $ by and_elim_l [q6]
q8: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ z = x2 $ by and_elim_r [q6]
q9: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ w ∊ lvals $ by weaken [#4]
q10: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ r ∊ fseq u $ by weaken [#5]
q11: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ z0 ∊ fseq b6_V $ by weaken [#6]
q12: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ isset z0 $ by isset_var
q13: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ x2 = z $ by eq_sym [q8]
q14: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ t3 = z $ by eq_trans [q7, q13]
q15: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ etel u (dnf u M) t3 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z0 ⟩ ⟩ ⟩ $ by weaken [#8]
q16: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ z = t3 $ by eq_sym [q14]
q17: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ w = w $ by eq_refl
q18: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ r = r $ by eq_refl
q19: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ etel u (dnf u M) z w r = etel u (dnf u M) t3 w r $ by etel_eq [q16, q17, q18]
q20: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z0 ⟩ ⟩ ⟩ $ by eq_trans [q19, q15]
q21: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ sarg u (dnf u M) z w r = z0 $ by sarg_csn [q20, q12]
q22: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ z0 = sarg u (dnf u M) z w r $ by eq_sym [q21]
q23: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z0 ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ $ by path0_eq [q22]
q24: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , z0 ⟩ ⟩ ⟩ = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ $ by csn_eq [q23]
q25: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ $ by eq_trans [q20, q24]
q26: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ z0 = sarg u (dnf u M) z w r $ by eq_sym [q21]
q27: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ z0 ∈ fseq b6_V $ by welc_wcel [q11]
q28: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ sarg u (dnf u M) z w r ∈ fseq b6_V $ by wcel_eq_l [q26, q27]
q29: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ cdm z0 ∈ ω $ by fseq_len [q11]
q30: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ nvf = nvf $ by eq_refl
q31: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ fv nvf t2 = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [q30, q5]
q32: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
q33: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ fv nvf t2 = ∅ $ by eq_trans [q31, q32]
q34: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ cdm z0 = cdm z0 $ by eq_refl
q35: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ nadd (fv nvf t2) (cdm z0) = nadd ∅ (cdm z0) $ by nadd_eq [q33, q34]
q36: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ nadd ∅ (cdm z0) = cdm z0 $ by b6_zero_nadd [q29]
q37: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ nadd (fv nvf t2) (cdm z0) = cdm z0 $ by eq_trans [q35, q36]
q38: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ cdm (sarg u (dnf u M) z w r) = cdm z0 $ by cdm_eq [q21]
q39: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ cdm z0 = nadd (fv nvf t2) (cdm z0) $ by eq_sym [q37]
q40: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ cdm (sarg u (dnf u M) z w r) = nadd (fv nvf t2) (cdm z0) $ by eq_trans [q38, q39]
q41: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ sarg u (dnf u M) z w r ∈ fseq b6_V ∧ cdm (sarg u (dnf u M) z w r) = nadd (fv nvf t2) (cdm z0) $ by and_intro [q28, q40]
q42: $ G , t1 = x1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x2 ∧ z = x2 ⇒ etel u (dnf u M) z w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) z w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) z w r ∈ fseq b6_V ∧ cdm (sarg u (dnf u M) z w r) = nadd (fv nvf t2) (cdm z0) $ by and_intro [q25, q41]
