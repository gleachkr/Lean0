ijs_sub
-------
l1: $ G , z ∊ ijs u E D W ⇒ z ∊ ijs u E D W $ by ax
l2: $ G , z ∊ ijs u E D W ⇒ z ∈ itc u E D W ∧ ∃ j ∃ a (z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W))) $ by cab_elim [l1]
l3: $ G , z ∊ ijs u E D W ⇒ z ∈ itc u E D W $ by and_elim_l [l2]
l4: $ G , z ∊ ijs u E D W ⇒ z ∊ itc u E D W $ by wcel_welc [l3]
l5: $ G ⇒ ijs u E D W ⊆ itc u E D W $ by subset_intro [l4]

lemma b6_clash (G: hyps) (Z A B C D: class) (p: fml): $ G ⇒ Z = ⟨ A , B ⟩ $ > $ G ⇒ Z = ⟨ C , D ⟩ $ > $ G ⇒ ¬ A = C $ > $ G ⇒ A ∈ ω $ > $ G ⇒ C ∈ ω $ > $ G ⇒ p $
----
q1: $ G ⇒ ⟨ A , B ⟩ = Z $ by eq_sym [#1]
q2: $ G ⇒ ⟨ A , B ⟩ = ⟨ C , D ⟩ $ by eq_trans [q1, #2]
q3: $ G ⇒ isset A $ by wcel_isset [#4]
q4: $ G ⇒ isset C $ by wcel_isset [#5]
q5: $ G ⇒ A = C $ by opair_inj_l_c [q2, q3, q4]
q6: $ G ⇒ ⊥ $ by not_elim [#3, q5]
q7: $ G ⇒ p $ by bot_elim [q6]

lemma b6_sig_s (G: hyps): $ G ⇒ ⟨ kc_s , ⟨ ks_nat , scons ks_nat ∅ ⟩ ⟩ ∈ lsig $
----
q1: $ G ⇒ isset ⟨ kc_s , ⟨ ks_nat , scons ks_nat ∅ ⟩ ⟩ $ by opair_isset
q2: $ G ⇒ ⟨ kc_s , ⟨ ks_nat , scons ks_nat ∅ ⟩ ⟩ ∈ csn ⟨ kc_s , ⟨ ks_nat , scons ks_nat ∅ ⟩ ⟩ $ by csn_intro_var_c [q1]
q3: $ G ⇒ ⟨ kc_s , ⟨ ks_nat , scons ks_nat ∅ ⟩ ⟩ ∈ csn ⟨ kc_s , ⟨ ks_nat , scons ks_nat ∅ ⟩ ⟩ ∪ (csn ⟨ kc_lz , ⟨ ks_lvl , ∅ ⟩ ⟩ ∪ (csn ⟨ kc_ls , ⟨ ks_lvl , scons ks_lvl ∅ ⟩ ⟩ ∪ (csn ⟨ kc_lmax , ⟨ ks_lvl , scons ks_lvl (scons ks_lvl ∅) ⟩ ⟩ ∪ (csn ⟨ kc_limax , ⟨ ks_lvl , scons ks_lvl (scons ks_lvl ∅) ⟩ ⟩ ∪ (csn ⟨ kc_lparam , ⟨ ks_lvl , scons ks_nat ∅ ⟩ ⟩ ∪ (csn ⟨ kc_lnil , ⟨ ks_lvls , ∅ ⟩ ⟩ ∪ (csn ⟨ kc_lcons , ⟨ ks_lvls , scons ks_lvl (scons ks_lvls ∅) ⟩ ⟩ ∪ (csn ⟨ kc_bvar , ⟨ ks_expr , scons ks_nat ∅ ⟩ ⟩ ∪ (csn ⟨ kc_srt , ⟨ ks_expr , scons ks_lvl ∅ ⟩ ⟩ ∪ (csn ⟨ kc_app , ⟨ ks_expr , scons ks_expr (scons ks_expr ∅) ⟩ ⟩ ∪ (csn ⟨ kc_lam , ⟨ ks_expr , scons ks_expr (scons ks_expr ∅) ⟩ ⟩ ∪ (csn ⟨ kc_pi , ⟨ ks_expr , scons ks_expr (scons ks_expr ∅) ⟩ ⟩ ∪ (csn ⟨ kc_cst , ⟨ ks_expr , scons ks_atom (scons ks_lvls ∅) ⟩ ⟩ ∪ (csn ⟨ kc_nil , ⟨ ks_ctx , ∅ ⟩ ⟩ ∪ (csn ⟨ kc_cons , ⟨ ks_ctx , scons ks_expr (scons ks_ctx ∅) ⟩ ⟩ ∪ (csn ⟨ kc_b0 , ⟨ ks_bin , ∅ ⟩ ⟩ ∪ (csn ⟨ kc_bd0 , ⟨ ks_bin , scons ks_bin ∅ ⟩ ⟩ ∪ (csn ⟨ kc_bd1 , ⟨ ks_bin , scons ks_bin ∅ ⟩ ⟩ ∪ (csn ⟨ kc_lit , ⟨ ks_expr , scons ks_bin ∅ ⟩ ⟩ ∪ (csn ⟨ kc_ind_mk , ⟨ ks_ind , scons ks_blk (scons ks_ctx (scons ks_tys ∅)) ⟩ ⟩ ∪ (csn ⟨ kc_tnil , ⟨ ks_tys , ∅ ⟩ ⟩ ∪ (csn ⟨ kc_tcons , ⟨ ks_tys , scons ks_expr (scons ks_ctors (scons ks_tys ∅)) ⟩ ⟩ ∪ (csn ⟨ kc_cnil , ⟨ ks_ctors , ∅ ⟩ ⟩ ∪ (csn ⟨ kc_ccons , ⟨ ks_ctors , scons ks_expr (scons ks_ctors ∅) ⟩ ⟩ ∪ (csn ⟨ kc_ind_mkn , ⟨ ks_ind , scons ks_blk (scons ks_ctx (scons ks_tys (scons ks_ctx ∅))) ⟩ ⟩ ∪ (csn ⟨ kc_ind_ty , ⟨ ks_expr , scons ks_ind (scons ks_nat ∅) ⟩ ⟩ ∪ (csn ⟨ kc_ind_ctor , ⟨ ks_expr , scons ks_ind (scons ks_nat (scons ks_nat ∅)) ⟩ ⟩ ∪ (csn ⟨ kc_ind_rec , ⟨ ks_expr , scons ks_ind (scons ks_nat (scons ks_lvl ∅)) ⟩ ⟩ ∪ (csn ⟨ kc_proj , ⟨ ks_expr , scons ks_blk (scons ks_nat (scons ks_expr ∅)) ⟩ ⟩ ∪ (csn ⟨ kc_nat_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ∪ (csn ⟨ kc_eq_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ∪ (csn ⟨ kc_quot , ⟨ ks_expr , scons ks_lvl ∅ ⟩ ⟩ ∪ (csn ⟨ kc_quot_mk , ⟨ ks_expr , scons ks_lvl ∅ ⟩ ⟩ ∪ (csn ⟨ kc_quot_lift , ⟨ ks_expr , scons ks_lvl (scons ks_lvl ∅) ⟩ ⟩ ∪ (csn ⟨ kc_quot_ind , ⟨ ks_expr , scons ks_lvl ∅ ⟩ ⟩))))))))))))))))))))))))))))))))))) $ by cun_intro_l_c [q2]
q4: $ G ⇒ ⟨ kc_s , ⟨ ks_nat , scons ks_nat ∅ ⟩ ⟩ ∈ lsig $ by cun_intro_r_c [q3]

