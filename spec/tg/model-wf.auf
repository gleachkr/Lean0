lemma b6_lift (G: hyps) {n l: set} (t1 t2 t3 t4: set): $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ (t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ , ra_lift a b z c ∈ lrel ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ , ra_lift a b z c ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ , ra_lift a b z c ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ , ra_lift a b z c ∈ lrel ⇒ crn j ⊆ b6_clift $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ , ra_lift a b z c ∈ lrel ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ , ra_lift a b z c ∈ lrel ⇒ ra_lift a b z c ∈ lrel $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ , ra_lift a b z c ∈ lrel ⇒ (z ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel) $ by b6_lift_st [q4, q3, q5, q6]
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ ⇒ ra_lift a b z c ∈ lrel → (z ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel) $ by imp_intro [q7]
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ ⇒ ∀ c (ra_lift a b z c ∈ lrel → (z ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_intro [q8]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ ⇒ ∀ b ∀ c (ra_lift a b z c ∈ lrel → (z ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_intro [q9]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ ⇒ ∀ a ∀ b ∀ c (ra_lift a b z c ∈ lrel → (z ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_intro [q10]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ ⇒ z ∊ b6_clift $ by cab_intro [q11]
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
q14: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b6_clift $ by wcel_intro [q13, q12]
q15: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift ⇒ isset ⟨ k , j ⟩ $ by opair_isset
q16: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_clift ⇒ ⟨ k , j ⟩ ∈ b6_clift $ by isset_elim [q15, q14]
q17: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b6_clift → ⟨ k , j ⟩ ∈ b6_clift $ by imp_intro [q16]
q18: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b6_clift → ⟨ k , j ⟩ ∈ b6_clift $ by imp_intro [q17]
q19: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_clift → ⟨ k , j ⟩ ∈ b6_clift $ by imp_intro [q18]
q20: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_clift → ⟨ k , j ⟩ ∈ b6_clift) $ by all_intro [q19]
q21: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_clift → ⟨ k , j ⟩ ∈ b6_clift) $ by all_intro [q20]
q22: $ G ⇒ isset ω $ by omega_set
q23: $ G ⇒ trees ω ⊆ b6_clift $ by trees_ind_c [q22, q21]
q24: $ G ⇒ kr_lift ∈ ω $ by kr_lift_omega
q25: $ G ⇒ isset kr_lift $ by wcel_isset [q24]
q26: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by lrel_args4 [#1, q25]
q27: $ G ⇒ t1 ∊ trees ω $ by and_elim_l [q26]
q28: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [q26]
q29: $ G ⇒ t2 ∊ trees ω $ by and_elim_l [q28]
q30: $ G ⇒ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [q28]
q31: $ G ⇒ t3 ∊ trees ω $ by and_elim_l [q30]
q32: $ G ⇒ t4 ∊ trees ω $ by and_elim_r [q30]
q33: $ G ⇒ t3 ∊ b6_clift $ by subset_elim [q23, q31]
q34: $ G ⇒ ∀ a ∀ b ∀ c (ra_lift a b t3 c ∈ lrel → (t3 ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by cab_elim [q33]
q35: $ G ⇒ ∀ b ∀ c (ra_lift t1 b t3 c ∈ lrel → (t3 ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_elim [q34]
q36: $ G ⇒ ∀ c (ra_lift t1 t2 t3 c ∈ lrel → (t3 ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort c n l ∈ lrel)) $ by all_elim [q35]
q37: $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel → (t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by all_elim [q36]
q38: $ G ⇒ (t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by imp_elim [q37, #1]

def b6_cinst (.y .a .b .c .n .l: set): class = $ {y | ∀ b ∀ a ∀ c (ra_inst b y a c ∈ lrel → (y ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort y n l ∈ lrel → ra_isort c n l ∈ lrel))} $

lemma b6_lift_c (G: hyps) {n l: set} (T: class) (t1 t3 t4: set): $ G ⇒ isset T $ > $ G ⇒ ra_lift t1 T t3 t4 ∈ lrel $ > $ G ⇒ (t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $
----
q1: $ G , w = T ⇒ w = T $ by ax
q2: $ G , w = T ⇒ T = w $ by eq_sym [q1]
q3: $ G , w = T ⇒ t1 = t1 $ by eq_refl
q4: $ G , w = T ⇒ t3 = t3 $ by eq_refl
q5: $ G , w = T ⇒ t4 = t4 $ by eq_refl
q6: $ G , w = T ⇒ ra_lift t1 T t3 t4 = ra_lift t1 w t3 t4 $ by ra_lift_eq [q3, q2, q4, q5]
q7: $ G , w = T ⇒ ra_lift t1 T t3 t4 ∈ lrel $ by weaken [#2]
q8: $ G , w = T ⇒ ra_lift t1 w t3 t4 ∈ lrel $ by wcel_eq_l [q6, q7]
q9: $ G , w = T ⇒ (t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by b6_lift [q8]
q10: $ G ⇒ (t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort t3 n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by isset_elim [#1, q9]

lemma b6_inst_same (G: hyps) {n l: set} (z t a: set): $ G ⇒ z = t $ > $ G ⇒ (z ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel) $
----
q1: $ G ⇒ (z ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel) $ by b6_isort_same [#1]
q2: $ G ⇒ z ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr $ by and_elim_l [q1]
q3: $ G ⇒ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel) $ by and_elim_r [q1]
q4: $ G , z ∊ ofsort lsig lopen ks_expr , a ∊ ofsort lsig lopen ks_expr ⇒ z ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr $ by weaken [q2]
q5: $ G , z ∊ ofsort lsig lopen ks_expr , a ∊ ofsort lsig lopen ks_expr ⇒ z ∊ ofsort lsig lopen ks_expr $ by ax
q6: $ G , z ∊ ofsort lsig lopen ks_expr , a ∊ ofsort lsig lopen ks_expr ⇒ t ∊ ofsort lsig lopen ks_expr $ by imp_elim [q4, q5]
q7: $ G , z ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr $ by imp_intro [q6]
q8: $ G ⇒ z ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr $ by imp_intro [q7]
q9: $ G ⇒ (z ∊ ofsort lsig lopen ks_expr → a ∊ ofsort lsig lopen ks_expr → t ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t n l ∈ lrel) $ by and_intro [q8, q3]

lemma b6_inst_st (G: hyps) {n l: set} (z k s t1 t3 t4: set): $ G ⇒ crn s ⊆ b6_cinst $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_inst t1 z t3 t4 ∈ lrel $ > $ G ⇒ (z ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t4 n l ∈ lrel) $
----
q1: $ G ⇒ ∃ x1 ∃ x3 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x0 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel) ∨ ∃ x1 ∃ x3 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons ⟨ kc_s , scons x3 ∅ ⟩ ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le x1 x3 ∈ lrel) ∨ ∃ x1 ∃ x5 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_srt , scons x5 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_srt , scons x5 ∅ ⟩) ∨ ∃ x1 ∃ x6 ∃ x7 ∃ x2 ∃ x8 ∃ x9 (t1 = x1 ∧ z = ⟨ kc_app , scons x6 (scons x7 ∅) ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_app , scons x8 (scons x9 ∅) ⟩ ∧ ra_inst x1 x6 x2 x8 ∈ lrel ∧ ra_inst x1 x7 x2 x9 ∈ lrel) ∨ ∃ x1 ∃ d ∃ e ∃ x2 ∃ f ∃ g (t1 = x1 ∧ z = ⟨ kc_lam , scons d (scons e ∅) ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_lam , scons f (scons g ∅) ⟩ ∧ ra_inst x1 d x2 f ∈ lrel ∧ ra_inst ⟨ kc_s , scons x1 ∅ ⟩ e x2 g ∈ lrel) ∨ ∃ x1 ∃ d ∃ e ∃ x2 ∃ f ∃ g (t1 = x1 ∧ z = ⟨ kc_pi , scons d (scons e ∅) ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ ra_inst x1 d x2 f ∈ lrel ∧ ra_inst ⟨ kc_s , scons x1 ∅ ⟩ e x2 g ∈ lrel) ∨ ∃ x4 ∃ x1 ∃ h ∃ x2 (t1 = x1 ∧ z = h ∧ t3 = x2 ∧ t4 = h ∧ ra_closed x4 h ∈ lrel ∧ ra_le x4 x1 ∈ lrel) ∨ ∃ x1 ∃ e ∃ x3 ∃ h ∃ x2 ∃ i (t1 = x1 ∧ z = ⟨ kc_proj , scons e (scons x3 (scons h ∅)) ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_proj , scons e (scons x3 (scons i ∅)) ⟩ ∧ ra_inst x1 h x2 i ∈ lrel) $ by lrel_inst_cases [#4]
q2: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel $ by ax
q3: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ t1 = x1 $ by and_elim_l [q2]
q4: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel $ by and_elim_r [q2]
q5: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ z = ⟨ kc_bvar , scons x3 ∅ ⟩ $ by and_elim_l [q4]
q6: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel $ by and_elim_r [q4]
q7: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ t3 = x2 $ by and_elim_l [q6]
q8: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel $ by and_elim_r [q6]
q9: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ $ by and_elim_l [q8]
q10: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel $ by and_elim_r [q8]
q11: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ ⟨ kc_bvar , scons x3 ∅ ⟩ = t4 $ by eq_sym [q9]
q12: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ z = t4 $ by eq_trans [q5, q11]
q13: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel ⇒ (z ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by b6_inst_same [q12]
q14: $ G , ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) ⇒ ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) $ by ax
q15: $ G , ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) ⇒ (z ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by ex_elim [q14, q13]
q16: $ G , ∃ x3 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) ⇒ ∃ x3 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) $ by ax
q17: $ G , ∃ x3 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) ⇒ (z ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by ex_elim [q16, q15]
q18: $ G , ∃ x1 ∃ x3 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) ⇒ ∃ x1 ∃ x3 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) $ by ax
q19: $ G , ∃ x1 ∃ x3 ∃ x2 (t1 = x1 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t3 = x2 ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x1 ∈ lrel) ⇒ (z ∊ ofsort lsig lopen ks_expr → t3 ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t4 n l ∈ lrel) $ by ex_elim [q18, q17]
q20: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel ⇒ t1 = x1 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel $ by ax
q21: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel ⇒ t1 = x1 $ by and_elim_l [q20]
q22: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel ⇒ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel $ by and_elim_r [q20]
q23: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel ⇒ z = ⟨ kc_bvar , scons x1 ∅ ⟩ $ by and_elim_l [q22]
q24: $ G , t1 = x1 ∧ z = ⟨ kc_bvar , scons x1 ∅ ⟩ ∧ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel ⇒ t3 = x2 ∧ t4 = x0 ∧ ra_lift x1 ⟨ kc_nz , ∅ ⟩ x2 x0 ∈ lrel $ by and_elim_r [q22]
