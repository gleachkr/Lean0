def b6_cip (u M w X Y t1 t2 t3: class) (.y .d .c .x .v: set): class = $ {y | ∀ d ∀ c ∀ x (ra_ipos t1 t2 t3 d y ∈ lrel → y ∊ ofsort lsig lopen ks_expr → c ∊ fseq u → cdm c = nadd (fv nvf d) (fv nvf t3) → x ∊ dt u M y w (scat c X) → ∃ v (v ∊ dt u M y w (scat c Y)))} $

lemma b6_ex_eq (G: hyps) {v: set} (A B: class): $ G ⇒ A = B $ > $ G ⇒ ∃ v (v ∊ A) $ > $ G ⇒ ∃ v (v ∊ B) $
----
q1: $ G , v ∊ A ⇒ A = B $ by weaken [#1]
q2: $ G , v ∊ A ⇒ v ∊ A $ by ax
q3: $ G , v ∊ A ⇒ v ∊ B $ by welc_eq [q1, q2]
q4: $ G , v ∊ A ⇒ ∃ v (v ∊ B) $ by ex_intro [q3]
q5: $ G ⇒ ∃ v (v ∊ B) $ by ex_elim [#2, q4]

lemma b6_ip_st (G: hyps) {o m q e g v: set} (M: class) (u w X Y t1 t2 t3 z k s t4 t6 t7: set): $ G ⇒ crn s ⊆ b6_cip u M w X Y t1 t2 t3 $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ X ∊ fseq u $ > $ G ⇒ Y ∊ fseq u $ > $ G ⇒ ∀ o ∀ m ∀ q (ra_nidx t1 o m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf t3) → q ∊ fseq b6_V → ∀ e (e ∊ apn (fv X (fv nvf o)) q → ∃ g (g ∊ apn (fv Y (fv nvf o)) q))) $ > $ G ⇒ ra_ipos t1 t2 t3 t4 z ∈ lrel $ > $ G ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ t6 ∊ fseq u $ > $ G ⇒ cdm t6 = nadd (fv nvf t4) (fv nvf t3) $ > $ G ⇒ t7 ∊ dt u M z w (scat t6 X) $ > $ G ⇒ ∃ v (v ∊ dt u M z w (scat t6 Y)) $
----
q1: $ G ⇒ scat t6 X ∈ fseq u $ by scat_fseq [#11, #6]
q2: $ G ⇒ isset (scat t6 X) $ by wcel_isset [q1]
q3: $ G , h = scat t6 X ⇒ t6 ∊ fseq u $ by weaken [#11]
q4: $ G , h = scat t6 X ⇒ Y ∊ fseq u $ by weaken [#7]
q5: $ G , h = scat t6 X ⇒ scat t6 Y ∈ fseq u $ by scat_fseq [q3, q4]
q6: $ G , h = scat t6 X ⇒ isset (scat t6 Y) $ by wcel_isset [q5]
q7: $ G , h = scat t6 X , l = scat t6 Y ⇒ h = scat t6 X $ by ax
q8: $ G , h = scat t6 X , l = scat t6 Y ⇒ l = scat t6 Y $ by ax
q9: $ G , h = scat t6 X , l = scat t6 Y ⇒ t6 ∊ fseq u $ by weaken [#11]
q10: $ G , h = scat t6 X , l = scat t6 Y ⇒ X ∊ fseq u $ by weaken [#6]
q11: $ G , h = scat t6 X , l = scat t6 Y ⇒ Y ∊ fseq u $ by weaken [#7]
q12: $ G , h = scat t6 X , l = scat t6 Y ⇒ scat t6 X = h $ by eq_sym [q7]
