b8r: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ isset r $ by isset_var
b8v: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ isset v $ by isset_var
b8: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ A = r ∧ B = v $ by scons2_inj [b5a, b8r, b5b, b8v, b7]
b9: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ B = v $ by and_elim_r [b8]
b9s: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ v = B $ by eq_sym [b9]
b10: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ i = i $ by eq_refl
b11: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ n = l $ by eq_sym [bb3]
b12: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ ra_isort v i n = ra_isort B i l $ by ra_isort_eq [b9s, b10, b11]
b13: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ ra_isort B i l ∈ lrel $ by wcel_eq_l [b12, bbr3]
b14: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ m = ⟨ kc_s , scons i ∅ ⟩ ∧ ra_isort B i l ∈ lrel $ by and_intro [bb2, b13]
b15: $ H , z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel ⇒ ∃ y (m = ⟨ kc_s , scons y ∅ ⟩ ∧ ra_isort B y l ∈ lrel) $ by ex_intro [b14]
y0a: $ H , ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) ⇒ ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) $ by ax
y0b: $ H , ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) ⇒ ∃ y (m = ⟨ kc_s , scons y ∅ ⟩ ∧ ra_isort B y l ∈ lrel) $ by ex_elim [y0a, b15]
y1a: $ H , ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) ⇒ ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) $ by ax
y1b: $ H , ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) ⇒ ∃ y (m = ⟨ kc_s , scons y ∅ ⟩ ∧ ra_isort B y l ∈ lrel) $ by ex_elim [y1a, y0b]
y2a: $ H , ∃ v ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) ⇒ ∃ v ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) $ by ax
y2b: $ H , ∃ v ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) ⇒ ∃ y (m = ⟨ kc_s , scons y ∅ ⟩ ∧ ra_isort B y l ∈ lrel) $ by ex_elim [y2a, y1b]
y3a: $ H , ∃ r ∃ v ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) ⇒ ∃ r ∃ v ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) $ by ax
y3b: $ H , ∃ r ∃ v ∃ i ∃ n (z = ⟨ kc_pi , scons r (scons v ∅) ⟩ ∧ m = ⟨ kc_s , scons i ∅ ⟩ ∧ l = n ∧ ra_isort v i n ∈ lrel) ⇒ ∃ y (m = ⟨ kc_s , scons y ∅ ⟩ ∧ ra_isort B y l ∈ lrel) $ by ex_elim [y3a, y2b]
fin: $ H ⇒ ∃ y (m = ⟨ kc_s , scons y ∅ ⟩ ∧ ra_isort B y l ∈ lrel) $ by or_elim [d, a11, y3b]

lemma b5_pifs {f g t a i d h x: set} (G: hyps) (E Al Bm Ax Bb: class) (u w r o: set): $ G ⇒ Al ∈ trees ω $ > $ G ⇒ Bm ∈ trees ω $ > $ G ⇒ Ax ∈ trees ω $ > $ G ⇒ Bb ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ o ∊ fseq u $ > $ G ⇒ da (fv E Al) w r = da (fv E Ax) w o $ > $ G ⇒ ∀ x (x ∊ u → ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E Bm w (scons x r) → ∃ i ∃ d ∃ h (⟨ f , ⟨ i , ⟨ d , h ⟩ ⟩ ⟩ ∈ etel u E Bb w (scons x o)))) $ > $ G ⇒ ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r → ∃ i ∃ d ∃ h (⟨ f , ⟨ i , ⟨ d , h ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Ax (scons Bb ∅) ⟩ w o)) $
----
q2g: $ G ⇒ etel u E ⟨ kc_pi , scons Ax (scons Bb ∅) ⟩ w o = {y | ∃ x ∃ x1 ∃ x2 ∃ x3 ∃ x4 (x ∊ da (fv E Ax) w o ∧ x ∊ u ∧ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E Bb w (scons x o) ∧ y = ⟨ ssnoc x1 x , ⟨ scons x x2 , ⟨ scons (etel u E Ax w o) x3 , x4 ⟩ ⟩ ⟩)} $ by etel_pi [#3, #4, #5, #7]
c1: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r $ by ax
w1: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r ⇒ Al ∈ trees ω $ by weaken [#1]
w2: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r ⇒ Bm ∈ trees ω $ by weaken [#2]
w5: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r ⇒ w ∊ lvals $ by weaken [#5]
w6: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r ⇒ r ∊ fseq u $ by weaken [#6]
c2: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r ⇒ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r = {y | ∃ x ∃ x1 ∃ x2 ∃ x3 ∃ x4 (x ∊ da (fv E Al) w r ∧ x ∊ u ∧ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E Bm w (scons x r) ∧ y = ⟨ ssnoc x1 x , ⟨ scons x x2 , ⟨ scons (etel u E Al w r) x3 , x4 ⟩ ⟩ ⟩)} $ by etel_pi [w1, w2, w5, w6]
c3: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ {y | ∃ x ∃ x1 ∃ x2 ∃ x3 ∃ x4 (x ∊ da (fv E Al) w r ∧ x ∊ u ∧ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E Bm w (scons x r) ∧ y = ⟨ ssnoc x1 x , ⟨ scons x x2 , ⟨ scons (etel u E Al w r) x3 , x4 ⟩ ⟩ ⟩)} $ by wcel_eq_r [c2, c1]
k1: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r , z = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , z ∊ {y | ∃ x ∃ x1 ∃ x2 ∃ x3 ∃ x4 (x ∊ da (fv E Al) w r ∧ x ∊ u ∧ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E Bm w (scons x r) ∧ y = ⟨ ssnoc x1 x , ⟨ scons x x2 , ⟨ scons (etel u E Al w r) x3 , x4 ⟩ ⟩ ⟩)} ⇒ z ∊ {y | ∃ x ∃ x1 ∃ x2 ∃ x3 ∃ x4 (x ∊ da (fv E Al) w r ∧ x ∊ u ∧ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E Bm w (scons x r) ∧ y = ⟨ ssnoc x1 x , ⟨ scons x x2 , ⟨ scons (etel u E Al w r) x3 , x4 ⟩ ⟩ ⟩)} $ by ax
k2: $ G , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons Al (scons Bm ∅) ⟩ w r , z = ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ , z ∊ {y | ∃ x ∃ x1 ∃ x2 ∃ x3 ∃ x4 (x ∊ da (fv E Al) w r ∧ x ∊ u ∧ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E Bm w (scons x r) ∧ y = ⟨ ssnoc x1 x , ⟨ scons x x2 , ⟨ scons (etel u E Al w r) x3 , x4 ⟩ ⟩ ⟩)} ⇒ ∃ x ∃ x1 ∃ x2 ∃ x3 ∃ x4 (x ∊ da (fv E Al) w r ∧ x ∊ u ∧ ⟨ x1 , ⟨ x2 , ⟨ x3 , x4 ⟩ ⟩ ⟩ ∈ etel u E Bm w (scons x r) ∧ z = ⟨ ssnoc x1 x , ⟨ scons x x2 , ⟨ scons (etel u E Al w r) x3 , x4 ⟩ ⟩ ⟩) $ by cab_elim [k1]
