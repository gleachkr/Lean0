lemma b10_esat0 (G: hyps) (M: class) (u w tP tT t2 t3 t4 tnp tr: set): $ G ⇒ ra_tys_closed tP tT ∈ lrel $ > $ G ⇒ ra_nth_ty tT t2 t3 t4 ∈ lrel $ > $ G ⇒ ra_clen tP tnp ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ tr ∊ fseq u $ > $ G ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $
----
q1: $ G ⇒ ∃ a ∃ b (ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel) $ by b10_closed [#1, #2]
q2: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel ⇒ ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel $ by ax
q3: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel ⇒ ra_pis tP a b ∈ lrel $ by and_elim_l [q2]
q4: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel $ by and_elim_r [q2]
q5: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by ax
q6: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel $ by weaken [q4]
q7: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ = z $ by eq_sym [q5]
q8: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ b = b $ by eq_refl
q9: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ b = ra_closed z b $ by ra_closed_eq [q7, q8]
q10: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_closed z b ∈ lrel $ by wcel_eq_l [q9, q6]
q11: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_pis tP a b ∈ lrel $ by weaken [q3]
q12: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen tP tnp ∈ lrel $ by weaken [#3]
q13: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ w ∊ lvals $ by weaken [#4]
q14: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → (∀ x0 (x0 ∊ fv nvf z → fv e x0 = fv f x0)) → esat u (dsh u M e) tP w = esat u (dsh u M f) tP w) ∧ ∃ o (ra_closed o a ∈ lrel ∧ fv nvf o = nadd (fv nvf tnp) (fv nvf z)) $ by b6_pis_esat [q11, q10, q12, q13]
q15: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → (∀ x0 (x0 ∊ fv nvf z → fv e x0 = fv f x0)) → esat u (dsh u M e) tP w = esat u (dsh u M f) tP w) $ by and_elim_l [q14]
q16: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
q17: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ y = ∅ $ by ax
q18: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ ∅ = y $ by eq_sym [q17]
q19: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
q20: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ y ∈ fseq u $ by wcel_eq_l [q18, q19]
q21: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ y ∊ fseq u $ by wcel_welc [q20]
q22: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ nvf = nvf $ by eq_refl
q23: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by weaken [q5]
q24: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ fv nvf z = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [q22, q23]
q25: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
q26: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ fv nvf z = ∅ $ by eq_trans [q24, q25]
q27: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ x0 ∊ fv nvf z $ by ax
q28: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ x0 ∊ ∅ $ by welc_eq [q26, q27]
q29: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ ⊥ $ by empty_elim [q28]
q30: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ , x0 ∊ fv nvf z ⇒ fv tr x0 = fv y x0 $ by bot_elim [q29]
q31: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ x0 ∊ fv nvf z → fv tr x0 = fv y x0 $ by imp_intro [q30]
q32: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ ∀ x0 (x0 ∊ fv nvf z → fv tr x0 = fv y x0) $ by all_intro [q31]
q33: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → (∀ x0 (x0 ∊ fv nvf z → fv e x0 = fv f x0)) → esat u (dsh u M e) tP w = esat u (dsh u M f) tP w) $ by weaken [q15]
q34: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ ∀ f (tr ∊ fseq u → f ∊ fseq u → (∀ x0 (x0 ∊ fv nvf z → fv tr x0 = fv f x0)) → esat u (dsh u M tr) tP w = esat u (dsh u M f) tP w) $ by all_elim [q33]
q35: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ tr ∊ fseq u → y ∊ fseq u → (∀ x0 (x0 ∊ fv nvf z → fv tr x0 = fv y x0)) → esat u (dsh u M tr) tP w = esat u (dsh u M y) tP w $ by all_elim [q34]
q36: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ tr ∊ fseq u $ by weaken [#5]
q37: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ y ∊ fseq u → (∀ x0 (x0 ∊ fv nvf z → fv tr x0 = fv y x0)) → esat u (dsh u M tr) tP w = esat u (dsh u M y) tP w $ by imp_elim [q35, q36]
q38: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ (∀ x0 (x0 ∊ fv nvf z → fv tr x0 = fv y x0)) → esat u (dsh u M tr) tP w = esat u (dsh u M y) tP w $ by imp_elim [q37, q21]
q39: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ esat u (dsh u M tr) tP w = esat u (dsh u M y) tP w $ by imp_elim [q38, q32]
q40: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ ra_clen tP tnp ∈ lrel $ by weaken [#3]
q41: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ kr_clen ∈ ω $ by kr_clen_omega
q42: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ isset kr_clen $ by wcel_isset [q41]
q43: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ tP ∊ trees ω ∧ tnp ∊ trees ω $ by lrel_args2 [q40, q42]
q44: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ tP ∊ trees ω $ by and_elim_l [q43]
q45: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ tnp ∊ trees ω $ by and_elim_r [q43]
q46: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ tP ∈ trees ω $ by welc_wcel [q44]
q47: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ eagv u (dsh u M y) (dnf u M) $ by b6_eagv_dsh0 [q17]
q48: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ esat u (dsh u M y) tP w = esat u (dnf u M) tP w $ by esat_agv [q46, q47]
q49: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ , y = ∅ ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ by eq_trans [q39, q48]
q50: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel , z = ⟨ kc_nz , ∅ ⟩ ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ by isset_elim [q16, q49]
q51: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
q52: $ G , ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ by isset_elim [q51, q50]
q53: $ G , ∃ b (ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel) ⇒ ∃ b (ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel) $ by ax
q54: $ G , ∃ b (ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel) ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ by ex_elim [q53, q52]
q55: $ G , ∃ a ∃ b (ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel) ⇒ ∃ a ∃ b (ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel) $ by ax
q56: $ G , ∃ a ∃ b (ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel) ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ by ex_elim [q55, q54]
q57: $ G ⇒ ∃ a ∃ b (ra_pis tP a b ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ b ∈ lrel) → esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ by imp_intro [q56]
q58: $ G ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ by imp_elim [q57, q1]

lemma b10_sat (G: hyps) (M: class) (u w tc tr tP tG2 tp: set): $ G ⇒ ra_capp tP tc tG2 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ tr ∊ sat u M tc w $ > $ G ⇒ tp ∊ esat u (dnf u M) tP w $ > $ G ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ > $ G ⇒ scat tp tr ∈ sat u M tG2 w $
----
q1: $ G ⇒ kr_capp ∈ ω $ by kr_capp_omega
q2: $ G ⇒ isset kr_capp $ by wcel_isset [q1]
q3: $ G ⇒ tP ∊ trees ω ∧ tc ∊ trees ω ∧ tG2 ∊ trees ω $ by lrel_args3 [#1, q2]
q4: $ G ⇒ tP ∊ trees ω $ by and_elim_l [q3]
q5: $ G ⇒ tc ∊ trees ω ∧ tG2 ∊ trees ω $ by and_elim_r [q3]
q6: $ G ⇒ tc ∊ trees ω $ by and_elim_l [q5]
q7: $ G ⇒ tG2 ∊ trees ω $ by and_elim_r [q5]
q8: $ G ⇒ sat u M tG2 w = {y | ∃ g ∃ p (g ∊ sat u M tc w ∧ p ∊ esat u (dsh u M g) tP w ∧ y = scat p g)} $ by lrel_capp_sem [#1, q4, q6, #2]
q9: $ G ⇒ esat u (dnf u M) tP w ⊆ fseq u $ by esat_fseq
q10: $ G ⇒ tp ∊ fseq u $ by subset_elim [q9, #4]
q11: $ G ⇒ sat u M tc w ⊆ fseq u $ by sat_fseq
q12: $ G ⇒ tr ∊ fseq u $ by subset_elim [q11, #3]
q13: $ G ⇒ scat tp tr ∈ fseq u $ by scat_fseq [q10, q12]
q14: $ G ⇒ isset (scat tp tr) $ by wcel_isset [q13]
q15: $ G , v = scat tp tr ⇒ v = scat tp tr $ by ax
q16: $ G , v = scat tp tr ⇒ esat u (dsh u M tr) tP w = esat u (dnf u M) tP w $ by weaken [#5]
q17: $ G , v = scat tp tr ⇒ esat u (dnf u M) tP w = esat u (dsh u M tr) tP w $ by eq_sym [q16]
q18: $ G , v = scat tp tr ⇒ tp ∊ esat u (dnf u M) tP w $ by weaken [#4]
q19: $ G , v = scat tp tr ⇒ tp ∊ esat u (dsh u M tr) tP w $ by welc_eq [q17, q18]
q20: $ G , v = scat tp tr ⇒ tr ∊ sat u M tc w $ by weaken [#3]
q21: $ G , v = scat tp tr ⇒ tp ∊ esat u (dsh u M tr) tP w ∧ v = scat tp tr $ by and_intro [q19, q15]
q22: $ G , v = scat tp tr ⇒ tr ∊ sat u M tc w ∧ tp ∊ esat u (dsh u M tr) tP w ∧ v = scat tp tr $ by and_intro [q20, q21]
q23: $ G , v = scat tp tr ⇒ ∃ p (tr ∊ sat u M tc w ∧ p ∊ esat u (dsh u M tr) tP w ∧ v = scat p tr) $ by ex_intro [q22]
q24: $ G , v = scat tp tr ⇒ ∃ g ∃ p (g ∊ sat u M tc w ∧ p ∊ esat u (dsh u M g) tP w ∧ v = scat p g) $ by ex_intro [q23]
q25: $ G , v = scat tp tr ⇒ v ∊ {y | ∃ g ∃ p (g ∊ sat u M tc w ∧ p ∊ esat u (dsh u M g) tP w ∧ y = scat p g)} $ by cab_intro [q24]
q26: $ G , v = scat tp tr ⇒ sat u M tG2 w = {y | ∃ g ∃ p (g ∊ sat u M tc w ∧ p ∊ esat u (dsh u M g) tP w ∧ y = scat p g)} $ by weaken [q8]
q27: $ G , v = scat tp tr ⇒ {y | ∃ g ∃ p (g ∊ sat u M tc w ∧ p ∊ esat u (dsh u M g) tP w ∧ y = scat p g)} = sat u M tG2 w $ by eq_sym [q26]
q28: $ G , v = scat tp tr ⇒ v ∊ sat u M tG2 w $ by welc_eq [q27, q25]
q29: $ G , v = scat tp tr ⇒ scat tp tr ∈ sat u M tG2 w $ by wcel_intro [q15, q28]
q30: $ G ⇒ scat tp tr ∈ sat u M tG2 w $ by isset_elim [q14, q29]

lemma b10_vals (G: hyps) {y i: set} (M: class) (u w d: set): $ G ⇒ uadm u $ > $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∃ y (y ∊ fseq u ∧ cdm y = intys d ∧ ∀ i (i ∊ intys d → fv y i = ityv u (dnf u M) d i w)) $
----
q1: $ G ⇒ cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ∈ fseq u ∧ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) = intys d ∧ ∀ i (i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w) $ by b6_vals [#1, #2, #3]
q2: $ G ⇒ cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ∈ fseq u $ by and_elim_l [q1]
q3: $ G ⇒ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) = intys d ∧ ∀ i (i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w) $ by and_elim_r [q1]
q4: $ G ⇒ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) = intys d $ by and_elim_l [q3]
q5: $ G ⇒ ∀ i (i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w) $ by and_elim_r [q3]
q6: $ G ⇒ isset (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) $ by wcel_isset [q2]
q7: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) $ by ax
q8: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ cres (cgr v (ityv u (dnf u M) d v w)) (intys d) = z $ by eq_sym [q7]
q9: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ∈ fseq u $ by weaken [q2]
q10: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ z ∈ fseq u $ by wcel_eq_l [q8, q9]
q11: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ z ∊ fseq u $ by wcel_welc [q10]
q12: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ cdm z = cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) $ by cdm_eq [q7]
q13: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ cdm (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) = intys d $ by weaken [q4]
q14: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ cdm z = intys d $ by eq_trans [q12, q13]
q15: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) , i ∊ intys d ⇒ ∀ i (i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w) $ by weaken [q5]
q16: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) , i ∊ intys d ⇒ i ∊ intys d → fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w $ by all_elim [q15]
q17: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) , i ∊ intys d ⇒ i ∊ intys d $ by ax
q18: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) , i ∊ intys d ⇒ fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i = ityv u (dnf u M) d i w $ by imp_elim [q16, q17]
q19: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) , i ∊ intys d ⇒ z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) $ by weaken [q7]
q20: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) , i ∊ intys d ⇒ i = i $ by eq_refl
q21: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) , i ∊ intys d ⇒ fv z i = fv (cres (cgr v (ityv u (dnf u M) d v w)) (intys d)) i $ by fv_eq [q19, q20]
q22: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) , i ∊ intys d ⇒ fv z i = ityv u (dnf u M) d i w $ by eq_trans [q21, q18]
q23: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ i ∊ intys d → fv z i = ityv u (dnf u M) d i w $ by imp_intro [q22]
q24: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ ∀ i (i ∊ intys d → fv z i = ityv u (dnf u M) d i w) $ by all_intro [q23]
q25: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ cdm z = intys d ∧ ∀ i (i ∊ intys d → fv z i = ityv u (dnf u M) d i w) $ by and_intro [q14, q24]
q26: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ z ∊ fseq u ∧ cdm z = intys d ∧ ∀ i (i ∊ intys d → fv z i = ityv u (dnf u M) d i w) $ by and_intro [q11, q25]
q27: $ G , z = cres (cgr v (ityv u (dnf u M) d v w)) (intys d) ⇒ ∃ y (y ∊ fseq u ∧ cdm y = intys d ∧ ∀ i (i ∊ intys d → fv y i = ityv u (dnf u M) d i w)) $ by ex_intro [q26]
q28: $ G ⇒ ∃ y (y ∊ fseq u ∧ cdm y = intys d ∧ ∀ i (i ∊ intys d → fv y i = ityv u (dnf u M) d i w)) $ by isset_elim [q6, q27]

lemma b10_pt3 (G: hyps) (H J: class) (u tc d w tr tx tb tP tT tnp tn tm0 tl tG2 tz ti tj tk tp t2 t3 t4 sf sg st sa: set): $ G ⇒ uadm u $ > $ G ⇒ hty ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ jval u (mcv H) J $ > $ G ⇒ d ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ tr ∊ sat u (mcv H) tc w $ > $ G ⇒ tx ⊆ ifam u (dnf u (mcv H)) d w $ > $ G ⇒ tx ∊ u $ > $ G ⇒ tx ⊆ b10_S u (dnf u (mcv H)) d w $ > $ G ⇒ ra_ind_data d tb tP tT ∈ lrel $ > $ G ⇒ ra_tys_closed tP tT ∈ lrel $ > $ G ⇒ ra_clen tP tnp ∈ lrel $ > $ G ⇒ ra_ntys tT tn tm0 ∈ lrel $ > $ G ⇒ ra_capp tP tc tG2 ∈ lrel $ > $ G ⇒ ra_cwf d tn tnp tl ti tG2 tz tk ∈ lrel3 J $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ fv nvf ti = tj $ > $ G ⇒ ra_nth_ty tT t2 t3 t4 ∈ lrel $ > $ G ⇒ tk ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ tp ∊ esat u (dnf u (mcv H)) tP w $ > $ G ⇒ ⟨ sf , ⟨ sg , ⟨ st , sa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat tp (ixs d w tx)) $ > $ G ⇒ ⟨ tj , ⟨ sa , scons ∅ ∅ ⟩ ⟩ ∈ itc u (dnf u (mcv H)) d w $
