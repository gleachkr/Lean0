--| The trees `x` such that substituting `q` (at `s`) into a sort's telescope `x` keeps
--| it a sort's telescope and keeps the fields of its paths.
def b5_is (U M W A S: class) (.x .m .l .k .e .p .f .g .t .a .i .d .h: set): class = $ {x | ∀ m ∀ l ∀ k ∀ e (ra_isort x m l ∈ lrel → ra_inst k x A e ∈ lrel → ra_isort e m l ∈ lrel ∧ ∀ p (p ∊ fseq U → cdm p = fv nvf k → ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) e W (scat p S) → ∃ i ∃ d ∃ h (⟨ f , ⟨ i , ⟨ d , h ⟩ ⟩ ⟩ ∈ etel U (dnf U M) x W (scat p (scons (dt U M A W S) S))))))} $

lemma b5_csn0 (G: hyps) (E K S R: class) (u w: set): $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ etel u E ⟨ K , S ⟩ w R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $
----
a1: $ G , r = R , r ∊ fseq u ⇒ ⟨ K , S ⟩ ∈ trees ω $ by weaken [#1]
a2: $ G , r = R , r ∊ fseq u ⇒ ¬ K = kc_pi $ by weaken [#2]
a3: $ G , r = R , r ∊ fseq u ⇒ ¬ K = kc_app $ by weaken [#3]
a4: $ G , r = R , r ∊ fseq u ⇒ w ∊ lvals $ by weaken [#4]
a5: $ G , r = R , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
a6: $ G , r = R , r ∊ fseq u ⇒ etel u E ⟨ K , S ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_trees [a1, a2, a3, a4, a5]
a7: $ G , r = R , r ∊ fseq u ⇒ r = R $ by ax
a8: $ G , r = R , r ∊ fseq u ⇒ ⟨ K , S ⟩ = ⟨ K , S ⟩ $ by eq_refl
a9: $ G , r = R , r ∊ fseq u ⇒ w = w $ by eq_refl
a7s: $ G , r = R , r ∊ fseq u ⇒ R = r $ by eq_sym [a7]
a10: $ G , r = R , r ∊ fseq u ⇒ etel u E ⟨ K , S ⟩ w R = etel u E ⟨ K , S ⟩ w r $ by etel_eq [a8, a9, a7s]
a11: $ G , r = R , r ∊ fseq u ⇒ etel u E ⟨ K , S ⟩ w R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [a10, a6]
a12: $ G ⇒ etel u E ⟨ K , S ⟩ w R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by wcel_elim [#5, a11]

lemma b5_lc_bvlt {p f g t a i d h: set} (H: hyps) (M: class) (u w q s z c j m l k e x0 x2 x6: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ dt u M q w s ∈ u $ > $ H ⇒ j ∊ fseq (trees ω) $ > $ H ⇒ crn j ⊆ b5_is u M w q s $ > $ H ⇒ z = ⟨ c , j ⟩ $ > $ H ⇒ ra_isort z m l ∈ lrel $ > $ H ⇒ ra_inst k z q e ∈ lrel $ > $ H ⇒ (k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel) → ra_isort e m l ∈ lrel ∧ ∀ p (p ∊ fseq u → cdm p = fv nvf k → ∀ f ∀ g ∀ t ∀ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) e w (scat p s) → ∃ i ∃ d ∃ h (⟨ f , ⟨ i , ⟨ d , h ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z w (scat p (scons (dt u M q w s) s))))) $
----
f1: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ w ∊ lvals $ by weaken [#1]
f2: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ s ∊ fseq u $ by weaken [#2]
f3: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ dt u M q w s ∈ u $ by weaken [#3]
f4: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ j ∊ fseq (trees ω) $ by weaken [#4]
f5: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ crn j ⊆ b5_is u M w q s $ by weaken [#5]
f6: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ z = ⟨ c , j ⟩ $ by weaken [#6]
f7: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ ra_isort z m l ∈ lrel $ by weaken [#7]
f8: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ ra_inst k z q e ∈ lrel $ by weaken [#8]
p0: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel $ by ax
q1: $ H , k = x0 ∧ z = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ q = x6 ∧ e = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x2 ∅ ⟩ x0 ∈ lrel ⇒ k = x0 $ by and_elim_l [p0]
