lemma b7_cs_res (G: hyps) (M: class) (u w r t1 t3 t5 d z f x1 x2 x3 x5 x7: set): $ G ⇒ z = f $ > $ G ⇒ t1 = x1 $ > $ G ⇒ t3 = x3 $ > $ G ⇒ t5 = x5 $ > $ G ⇒ d = x7 $ > $ G ⇒ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ uadm u $ > $ G ⇒ etel u (dnf u M) z w r ⊆ b7_shp t1 t5 (swin r (fv nvf d) (fv nvf t3)) $
----
l1: $ G ⇒ f ∊ trees ω $ by welc_eq_set [#1, #7]
l2: $ G ⇒ etel u (dnf u M) f w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) f w r ⟩ ⟩ ⟩ ∧ dt u M f w r = apn (fv r (nadd (nadd (fv nvf x7) (fv nvf x3)) (fv nvf x5))) (sarg u (dnf u M) f w r) $ by lrel_indapp_sem [#6, l1, #8, #9]
l2a: $ G ⇒ etel u (dnf u M) f w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) f w r ⟩ ⟩ ⟩ $ by and_elim_l [l2]
l3: $ G ⇒ ∃ m ∃ x (ra_nidx x1 x5 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) f w r = scat x (swin r (fv nvf x7) (fv nvf x3))) $ by b7_indapp_shape [#6, l1, #8, #9, #10]
