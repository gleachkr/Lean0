lemma b11_nc_pi (G: hyps) (M X0 X: class) (u w t1 t2 t3 d k0 z A B: set): $ G ⇒ ra_add d t3 k0 ∈ lrel $ > $ G ⇒ ra_closed k0 A ∈ lrel $ > $ G ⇒ ra_ipos t1 t2 t3 ⟨ kc_s , scons d ∅ ⟩ B ∈ lrel $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ A ∊ trees ω $ > $ G ⇒ B ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ z = ⟨ kc_pi , scons A (scons B ∅) ⟩ $ > $ G ⇒ B ∊ b9_pn u M w t1 t2 t3 X0 X $ > $ G ⇒ b11_nc_dp u M w z (nadd (fv nvf d) (fv nvf t3)) ∨ b11_nc_sg u M w t1 X0 X z (fv nvf d) (fv nvf t3) $
----
t1a: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
t1b: $ … ⇒ isset kc_s $ by wcel_isset [t1a]
t0: $ … ⇒ isset ⟨ kc_s , scons d ∅ ⟩ $ by opair_set_l [t1b]
t2a: $ … ⇒ d ∈ trees ω $ by welc_wcel [#4]
t2b: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
t2c: $ … ⇒ scons d ∅ ∈ fseq (trees ω) $ by scons_fseq_c [t2a, t2b]
t2d: $ G ⇒ isset ω $ by omega_set
t2: $ … ⇒ ⟨ kc_s , scons d ∅ ⟩ ∈ trees ω $ by trees_intro_c [t2d, t1a, t2c]
e0: $ G , x6 = ⟨ kc_s , scons d ∅ ⟩ ⇒ x6 = ⟨ kc_s , scons d ∅ ⟩ $ by ax
e1: $ … ⇒ ⟨ kc_s , scons d ∅ ⟩ = x6 $ by eq_sym [e0]
rt1: $ G , x6 = ⟨ kc_s , scons d ∅ ⟩ ⇒ t1 = t1 $ by eq_refl
rt2: $ G , x6 = ⟨ kc_s , scons d ∅ ⟩ ⇒ t2 = t2 $ by eq_refl
rt3: $ G , x6 = ⟨ kc_s , scons d ∅ ⟩ ⇒ t3 = t3 $ by eq_refl
