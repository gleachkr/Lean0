s23: $ G , z ∊ etb u E K S V , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by or_elim [s23a, r2, r3]
s1: $ G , z ∊ etb u E K S V ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by or_elim [d2, r1, s23]
t1: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by ax
t2: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_pi $ by weaken [#1]
t2a: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_app $ by weaken [#2]
t2b: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_intro [t2a, t1]
t3: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ ¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by and_intro [t2, t2b]
t3a: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by or_intro_r [t3]
t4: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv S ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)})) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv S (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by or_intro_r [t3a]
t5: $ G , z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ z ∊ etb u E K S V $ by cab_intro [t4]
t6: $ G ⇒ etb u E K S V = clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) $ by eq_intro [s1, t5]

--| The trees whose paths with the table shifted by `s` are their paths at `r ++ s`.
def b5_dp (U M W S: class) (.y .r: set): class = $ {y | ∀ r (r ∊ fseq U → etel U (dsh U M S) y W r = etel U (dnf U M) y W (scat r S))} $

lemma b5_cco (G: hyps) (F: class) (h i: set): $ G ⇒ ¬ i ∊ cdm h $ > $ G ⇒ fv (ccom F h) i = ∅ $
----
l2: $ G , ⟨ i , v ⟩ ∈ h , ⟨ v , y ⟩ ∈ F ⇒ ⟨ i , v ⟩ ∈ h $ by ax
l3: $ G , ⟨ i , v ⟩ ∈ h , ⟨ v , y ⟩ ∈ F ⇒ i ∊ cdm h $ by cdm_intro [l2]
l4: $ G , ⟨ i , v ⟩ ∈ h , ⟨ v , y ⟩ ∈ F ⇒ ¬ i ∊ cdm h $ by weaken [#1]
l5: $ G , ⟨ i , v ⟩ ∈ h , ⟨ v , y ⟩ ∈ F ⇒ ⊥ $ by not_elim [l4, l3]
l6: $ G , ⟨ i , y ⟩ ∈ ccom F h ⇒ ⟨ i , y ⟩ ∈ ccom F h $ by ax
l7: $ G , ⟨ i , y ⟩ ∈ ccom F h ⇒ ⊥ $ by ccom_elim [l6, l5]
l1: $ G , i ∊ cdm (ccom F h) ⇒ i ∊ cdm (ccom F h) $ by ax
l8: $ G , i ∊ cdm (ccom F h) ⇒ ⊥ $ by cdm_elim [l1, l7]
l9: $ G ⇒ i ∊ cdm (ccom F h) → ⊥ $ by imp_intro [l8]
l10: $ G ⇒ fv (ccom F h) i = ∅ $ by fv_empty [l9]

lemma b5_dch (G: hyps) (M: class) (u w s h i r: set): $ G ⇒ h ∊ fseq (trees ω) $ > $ G ⇒ crn h ⊆ b5_dp u M w s $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) $
----
e0: $ G ⇒ i ∊ cdm h ∨ ¬ i ∊ cdm h $ by excluded_middle
a0: $ G , i ∊ cdm h ⇒ h ∊ fseq (trees ω) $ by weaken [#1]
ai: $ G , i ∊ cdm h ⇒ i ∊ cdm h $ by ax
a1: $ G , i ∊ cdm h ⇒ functional h $ by fseq_functional [a0]
a2: $ G , i ∊ cdm h ⇒ functional (etf u (dsh u M s)) $ by etf_functional
a2n: $ G , i ∊ cdm h ⇒ functional (etf u (dnf u M)) $ by etf_functional
a3: $ G , i ∊ cdm h ⇒ fv h i ∈ trees ω $ by fseq_fv [a0, ai]
a4: $ G , i ∊ cdm h ⇒ cdm (etf u (dsh u M s)) = trees ω $ by etf_cdm
a4s: $ G , i ∊ cdm h ⇒ trees ω = cdm (etf u (dsh u M s)) $ by eq_sym [a4]
a5: $ G , i ∊ cdm h ⇒ fv h i ∈ cdm (etf u (dsh u M s)) $ by wcel_eq_r [a4s, a3]
a4n: $ G , i ∊ cdm h ⇒ cdm (etf u (dnf u M)) = trees ω $ by etf_cdm
a4ns: $ G , i ∊ cdm h ⇒ trees ω = cdm (etf u (dnf u M)) $ by eq_sym [a4n]
a5n: $ G , i ∊ cdm h ⇒ fv h i ∈ cdm (etf u (dnf u M)) $ by wcel_eq_r [a4ns, a3]
a6: $ G , i ∊ cdm h ⇒ fv (ccom (etf u (dsh u M s)) h) i = fv (etf u (dsh u M s)) (fv h i) $ by fv_ccom [a2, a1, ai, a5]
a7: $ G , i ∊ cdm h ⇒ fv (ccom (etf u (dnf u M)) h) i = fv (etf u (dnf u M)) (fv h i) $ by fv_ccom [a2n, a1, ai, a5n]
a8: $ G , i ∊ cdm h ⇒ isset (fv h i) $ by fv_set [a1]
a9: $ G , i ∊ cdm h ⇒ ⟨ i , fv h i ⟩ ∈ h $ by fv_in [a1, ai]
b1: $ G , i ∊ cdm h , y = fv h i ⇒ y = fv h i $ by ax
b2: $ G , i ∊ cdm h , y = fv h i ⇒ ⟨ i , fv h i ⟩ ∈ h $ by weaken [a9]
b3: $ G , i ∊ cdm h , y = fv h i ⇒ fv h i = y $ by eq_sym [b1]
b3i: $ G , i ∊ cdm h , y = fv h i ⇒ i = i $ by eq_refl
b4: $ G , i ∊ cdm h , y = fv h i ⇒ ⟨ i , fv h i ⟩ = ⟨ i , y ⟩ $ by opair_eq [b3i, b3]
b5: $ G , i ∊ cdm h , y = fv h i ⇒ ⟨ i , y ⟩ ∈ h $ by wcel_eq_l [b4, b2]
b6: $ G , i ∊ cdm h , y = fv h i ⇒ y ∊ crn h $ by crn_intro [b5]
b6a: $ G , i ∊ cdm h , y = fv h i ⇒ crn h ⊆ b5_dp u M w s $ by weaken [#2]
b7: $ G , i ∊ cdm h , y = fv h i ⇒ y ∊ b5_dp u M w s $ by subset_elim [b6a, b6]
b8: $ G , i ∊ cdm h , y = fv h i ⇒ ∀ o (o ∊ fseq u → etel u (dsh u M s) y w o = etel u (dnf u M) y w (scat o s)) $ by cab_elim [b7]
b9: $ G , i ∊ cdm h , y = fv h i ⇒ r ∊ fseq u → etel u (dsh u M s) y w r = etel u (dnf u M) y w (scat r s) $ by all_elim [b8]
b9a: $ G , i ∊ cdm h , y = fv h i ⇒ r ∊ fseq u $ by weaken [#3]
b10: $ G , i ∊ cdm h , y = fv h i ⇒ etel u (dsh u M s) y w r = etel u (dnf u M) y w (scat r s) $ by imp_elim [b9, b9a]
c0: $ G , i ∊ cdm h , y = fv h i ⇒ etf u (dsh u M s) = etf u (dsh u M s) $ by eq_refl
c0n: $ G , i ∊ cdm h , y = fv h i ⇒ etf u (dnf u M) = etf u (dnf u M) $ by eq_refl
c1: $ G , i ∊ cdm h , y = fv h i ⇒ fv (etf u (dsh u M s)) (fv h i) = fv (etf u (dsh u M s)) y $ by fv_eq [c0, b3]
c1n: $ G , i ∊ cdm h , y = fv h i ⇒ fv (etf u (dnf u M)) (fv h i) = fv (etf u (dnf u M)) y $ by fv_eq [c0n, b3]
a6w: $ G , i ∊ cdm h , y = fv h i ⇒ fv (ccom (etf u (dsh u M s)) h) i = fv (etf u (dsh u M s)) (fv h i) $ by weaken [a6]
a7w: $ G , i ∊ cdm h , y = fv h i ⇒ fv (ccom (etf u (dnf u M)) h) i = fv (etf u (dnf u M)) (fv h i) $ by weaken [a7]
c2: $ G , i ∊ cdm h , y = fv h i ⇒ fv (ccom (etf u (dsh u M s)) h) i = fv (etf u (dsh u M s)) y $ by eq_trans [a6w, c1]
c2n: $ G , i ∊ cdm h , y = fv h i ⇒ fv (ccom (etf u (dnf u M)) h) i = fv (etf u (dnf u M)) y $ by eq_trans [a7w, c1n]
ww: $ G , i ∊ cdm h , y = fv h i ⇒ w = w $ by eq_refl
rr: $ G , i ∊ cdm h , y = fv h i ⇒ r = r $ by eq_refl
rs: $ G , i ∊ cdm h , y = fv h i ⇒ scat r s = scat r s $ by eq_refl
c3: $ G , i ∊ cdm h , y = fv h i ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = da (fv (etf u (dsh u M s)) y) w r $ by da_eq [c2, ww, rr]
c3n: $ G , i ∊ cdm h , y = fv h i ⇒ da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) = da (fv (etf u (dnf u M)) y) w (scat r s) $ by da_eq [c2n, ww, rs]
c4: $ G , i ∊ cdm h , y = fv h i ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = etel u (dnf u M) y w (scat r s) $ by eq_trans [c3, b10]
c5: $ G , i ∊ cdm h , y = fv h i ⇒ da (fv (etf u (dnf u M)) y) w (scat r s) = da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) $ by eq_sym [c3n]
c6: $ G , i ∊ cdm h , y = fv h i ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) $ by eq_trans [c4, c5]
c7: $ G , i ∊ cdm h ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) $ by isset_elim [a8, c6]
o0: $ G , ¬ i ∊ cdm h ⇒ ¬ i ∊ cdm h $ by ax
o1: $ G , ¬ i ∊ cdm h ⇒ fv (ccom (etf u (dsh u M s)) h) i = ∅ $ by b5_cco [o0]
o2: $ G , ¬ i ∊ cdm h ⇒ fv (ccom (etf u (dnf u M)) h) i = ∅ $ by b5_cco [o0]
oww: $ G , ¬ i ∊ cdm h ⇒ w = w $ by eq_refl
orr: $ G , ¬ i ∊ cdm h ⇒ r = r $ by eq_refl
ors: $ G , ¬ i ∊ cdm h ⇒ scat r s = scat r s $ by eq_refl
o3: $ G , ¬ i ∊ cdm h ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = da ∅ w r $ by da_eq [o1, oww, orr]
o4: $ G , ¬ i ∊ cdm h ⇒ da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) = da ∅ w (scat r s) $ by da_eq [o2, oww, ors]
o5a: $ G , ¬ i ∊ cdm h ⇒ ap ∅ w = ∅ $ by ap_empty
o5b: $ G , ¬ i ∊ cdm h ⇒ r = r $ by eq_refl
o5c: $ G , ¬ i ∊ cdm h ⇒ ap (ap ∅ w) r = ap ∅ r $ by ap_eq [o5a, o5b]
o5d: $ G , ¬ i ∊ cdm h ⇒ ap ∅ r = ∅ $ by ap_empty
o5: $ G , ¬ i ∊ cdm h ⇒ da ∅ w r = ∅ $ by eq_trans [o5c, o5d]
o6a: $ G , ¬ i ∊ cdm h ⇒ ap ∅ w = ∅ $ by ap_empty
o6b: $ G , ¬ i ∊ cdm h ⇒ (scat r s) = (scat r s) $ by eq_refl
o6c: $ G , ¬ i ∊ cdm h ⇒ ap (ap ∅ w) (scat r s) = ap ∅ (scat r s) $ by ap_eq [o6a, o6b]
o6d: $ G , ¬ i ∊ cdm h ⇒ ap ∅ (scat r s) = ∅ $ by ap_empty
o6: $ G , ¬ i ∊ cdm h ⇒ da ∅ w (scat r s) = ∅ $ by eq_trans [o6c, o6d]
o7: $ G , ¬ i ∊ cdm h ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = ∅ $ by eq_trans [o3, o5]
o8: $ G , ¬ i ∊ cdm h ⇒ da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) = ∅ $ by eq_trans [o4, o6]
o9: $ G , ¬ i ∊ cdm h ⇒ ∅ = da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) $ by eq_sym [o8]
o10: $ G , ¬ i ∊ cdm h ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) $ by eq_trans [o7, o9]
fin: $ G ⇒ da (fv (ccom (etf u (dsh u M s)) h) i) w r = da (fv (ccom (etf u (dnf u M)) h) i) w (scat r s) $ by or_elim [e0, c7, o10]

lemma b5_nd1 {x f g t a y: set} (G: hyps) (E: class) (u k h c w r: set): $ G ⇒ k ∊ ω $ > $ G ⇒ h ∊ fseq (trees ω) $ > $ G ⇒ c = ccom (etf u E) h $ > $ G ⇒ k = kc_pi $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ da (fv (etf u E) ⟨ k , h ⟩) w r = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩)} $
----
n4: $ G ⇒ fv (etf u E) ⟨ k , h ⟩ = etb u E k h c $ by etf_node [#1, #2, #3]
m2: $ G ⇒ etb u E k h c = clam o lvals (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) o p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) o (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) o p) t , a ⟩ ⟩ ⟩)}) $ by b5_etb_k1 [#4]
m3: $ G ⇒ fv (etf u E) ⟨ k , h ⟩ = clam o lvals (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) o p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) o (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) o p) t , a ⟩ ⟩ ⟩)}) $ by eq_trans [n4, m2]
w1: $ G ⇒ w = w $ by eq_refl
r1: $ G ⇒ r = r $ by eq_refl
m4: $ G ⇒ ap (fv (etf u E) ⟨ k , h ⟩) w = ap (clam o lvals (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) o p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) o (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) o p) t , a ⟩ ⟩ ⟩)})) w $ by ap_eq [m3, w1]
m5: $ G ⇒ ap (clam o lvals (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) o p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) o (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) o p) t , a ⟩ ⟩ ⟩)})) w = clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) w p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w p) t , a ⟩ ⟩ ⟩)} $ by clam_ap [#5]
m6: $ G ⇒ ap (fv (etf u E) ⟨ k , h ⟩) w = clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) w p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w p) t , a ⟩ ⟩ ⟩)} $ by eq_trans [m4, m5]
m7: $ G ⇒ ap (ap (fv (etf u E) ⟨ k , h ⟩) w) r = ap (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) w p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w p) t , a ⟩ ⟩ ⟩)}) r $ by ap_eq [m6, r1]
m8: $ G ⇒ ap (clam p (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) w p ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x p) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w p) t , a ⟩ ⟩ ⟩)}) r = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩)} $ by clam_ap [#6]
m9: $ G ⇒ da (fv (etf u E) ⟨ k , h ⟩) w r = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv h ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv c (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv c ∅) w r) t , a ⟩ ⟩ ⟩)} $ by eq_trans [m7, m8]

lemma b5_nd2 {a y: set} (G: hyps) (E: class) (u k h c w r: set): $ G ⇒ k ∊ ω $ > $ G ⇒ h ∊ fseq (trees ω) $ > $ G ⇒ c = ccom (etf u E) h $ > $ G ⇒ k = kc_app $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ da (fv (etf u E) ⟨ k , h ⟩) w r = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv h (suc ∅))) w r) a) ⟩ ⟩ ⟩)} $
----
n4: $ G ⇒ fv (etf u E) ⟨ k , h ⟩ = etb u E k h c $ by etf_node [#1, #2, #3]
