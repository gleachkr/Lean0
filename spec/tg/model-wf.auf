bs5: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel $ by and_elim_r [bs3]
bs6: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ ff = x7 $ by and_elim_l [bs5]
bs7: $ G , m = fv nvf jj , m ∊ ω , x2 = ∅ , ra_tys_wf dd nv np lv a cx b ∈ lrel3 J , ra_nth_ty b g ff ee ∈ lrel , fv nvf g = x2 , b = ⟨ kc_tcons , scons h (scons k (scons x9 ∅)) ⟩ ∧ g = ⟨ kc_s , scons q ∅ ⟩ ∧ ff = x7 ∧ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel ⇒ ee = x8 ∧ ra_nth_ty x9 q x7 x8 ∈ lrel $ by and_elim_r [bs5]
