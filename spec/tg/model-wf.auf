lemma b6_pis_esat (G: hyps) {e f x0 o: set} (M: class) (u w t1 t2 t3 t4 t5: set): $ G ⇒ ra_pis t1 t2 t3 ∈ lrel $ > $ G ⇒ ra_closed t4 t3 ∈ lrel $ > $ G ⇒ ra_clen t1 t5 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $
----
q1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ k ∊ ω $ by ax
q2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ j ∊ fseq (trees ω) $ by ax
q3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by ax
q4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ crn j ⊆ b6_cpe u M w $ by ax
q5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ z ∊ trees ω $ by trees_omega_intro [q1, q2, q3]
q6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ ra_pis z b c ∈ lrel $ by ax
q7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ ra_closed d c ∈ lrel $ by ax
q8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ ra_clen z q ∈ lrel $ by ax
q9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ w ∊ lvals $ by weaken [#4]
q10: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel , ra_clen z q ∈ lrel ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d)) $ by b6_pe_st [q4, q3, q5, q9, q6, q7, q8]
q11: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel , ra_closed d c ∈ lrel ⇒ ra_clen z q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d)) $ by imp_intro [q10]
q12: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ , ra_pis z b c ∈ lrel ⇒ ra_closed d c ∈ lrel → ra_clen z q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d)) $ by imp_intro [q11]
q13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ ⇒ ra_pis z b c ∈ lrel → ra_closed d c ∈ lrel → ra_clen z q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d)) $ by imp_intro [q12]
q14: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ ⇒ ∀ q (ra_pis z b c ∈ lrel → ra_closed d c ∈ lrel → ra_clen z q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d))) $ by all_intro [q13]
q15: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ ⇒ ∀ d ∀ q (ra_pis z b c ∈ lrel → ra_closed d c ∈ lrel → ra_clen z q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d))) $ by all_intro [q14]
q16: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ ⇒ ∀ c ∀ d ∀ q (ra_pis z b c ∈ lrel → ra_closed d c ∈ lrel → ra_clen z q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d))) $ by all_intro [q15]
q17: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ ⇒ ∀ b ∀ c ∀ d ∀ q (ra_pis z b c ∈ lrel → ra_closed d c ∈ lrel → ra_clen z q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) z w = esat u (dsh u M f) z w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d))) $ by all_intro [q16]
q18: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ ⇒ z ∊ b6_cpe u M w $ by cab_intro [q17]
q19: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
q20: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b6_cpe u M w $ by wcel_intro [q19, q18]
q21: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
q22: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b6_cpe u M w ⇒ ⟨ k , j ⟩ ∈ b6_cpe u M w $ by isset_elim [q21, q20]
q23: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b6_cpe u M w → ⟨ k , j ⟩ ∈ b6_cpe u M w $ by imp_intro [q22]
q24: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b6_cpe u M w → ⟨ k , j ⟩ ∈ b6_cpe u M w $ by imp_intro [q23]
q25: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpe u M w → ⟨ k , j ⟩ ∈ b6_cpe u M w $ by imp_intro [q24]
q26: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpe u M w → ⟨ k , j ⟩ ∈ b6_cpe u M w) $ by all_intro [q25]
q27: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b6_cpe u M w → ⟨ k , j ⟩ ∈ b6_cpe u M w) $ by all_intro [q26]
q28: $ G ⇒ isset ω $ by omega_set
q29: $ G ⇒ trees ω ⊆ b6_cpe u M w $ by trees_ind_c [q28, q27]
q30: $ G ⇒ kr_pis ∈ ω $ by kr_pis_omega
q31: $ G ⇒ isset kr_pis $ by wcel_isset [q30]
q32: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by lrel_args3 [#1, q31]
q33: $ G ⇒ t1 ∊ trees ω $ by and_elim_l [q32]
q34: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω $ by and_elim_r [q32]
q35: $ G ⇒ t2 ∊ trees ω $ by and_elim_l [q34]
q36: $ G ⇒ t3 ∊ trees ω $ by and_elim_r [q34]
q37: $ G ⇒ t1 ∊ b6_cpe u M w $ by subset_elim [q29, q33]
q38: $ G ⇒ ∀ b ∀ c ∀ d ∀ q (ra_pis t1 b c ∈ lrel → ra_closed d c ∈ lrel → ra_clen t1 q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o b ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d))) $ by cab_elim [q37]
q39: $ G ⇒ ∀ c ∀ d ∀ q (ra_pis t1 t2 c ∈ lrel → ra_closed d c ∈ lrel → ra_clen t1 q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d))) $ by all_elim [q38]
q40: $ G ⇒ ∀ d ∀ q (ra_pis t1 t2 t3 ∈ lrel → ra_closed d t3 ∈ lrel → ra_clen t1 q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf d → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf d))) $ by all_elim [q39]
q41: $ G ⇒ ∀ q (ra_pis t1 t2 t3 ∈ lrel → ra_closed t4 t3 ∈ lrel → ra_clen t1 q ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf q) (fv nvf t4))) $ by all_elim [q40]
q42: $ G ⇒ ra_pis t1 t2 t3 ∈ lrel → ra_closed t4 t3 ∈ lrel → ra_clen t1 t5 ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $ by all_elim [q41]
q43: $ G ⇒ ra_closed t4 t3 ∈ lrel → ra_clen t1 t5 ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $ by imp_elim [q42, #1]
q44: $ G ⇒ ra_clen t1 t5 ∈ lrel → ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $ by imp_elim [q43, #2]
q45: $ G ⇒ ∀ e ∀ f (e ∊ fseq u → f ∊ fseq u → ∀ x0 (x0 ∊ fv nvf t4 → fv e x0 = fv f x0) → esat u (dsh u M e) t1 w = esat u (dsh u M f) t1 w) ∧ ∃ o (ra_closed o t2 ∈ lrel ∧ fv nvf o = nadd (fv nvf t5) (fv nvf t4)) $ by imp_elim [q44, #3]

lemma b6_cpi_ne {x y f: set} (G: hyps) (A F: class): $ G ⇒ isset A $ > $ G ⇒ functional F $ > $ G ⇒ ∀ x (x ∊ A → x ∊ cdm F) $ > $ G ⇒ ∀ x (x ∊ A → ∃ y (y ∊ fv F x)) $ > $ G ⇒ ∃ f (f ∊ cpi x A (fv F x)) $
----
q1: $ G ⇒ isset (cres F A) $ by cres_set [#2, #1]
q2: $ G ⇒ isset (crn (cres F A)) $ by crn_set [q1]
q3: $ G , a = crn (cres F A) ⇒ a = crn (cres F A) $ by ax
q4: $ G , a = crn (cres F A) ⇒ ∃ g (chooses g a) $ by ax_choice
q5: $ G , a = crn (cres F A) , chooses g a ⇒ chooses g a $ by ax
q6: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ x ∊ A $ by ax
q7: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ ∀ x (x ∊ A → x ∊ cdm F) $ by weaken [#3]
q8: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ x ∊ A → x ∊ cdm F $ by all_elim [q7]
q9: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ x ∊ cdm F $ by imp_elim [q8, q6]
q10: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ functional F $ by weaken [#2]
q11: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ ⟨ x , fv F x ⟩ ∈ F $ by fv_in [q10, q9]
q12: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ isset (fv F x) $ by fv_set [q10]
q13: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ b = fv F x $ by ax
q14: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ x = x $ by eq_refl
q15: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ fv F x = b $ by eq_sym [q13]
q16: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ ⟨ x , fv F x ⟩ = ⟨ x , b ⟩ $ by opair_eq [q14, q15]
q17: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ ⟨ x , fv F x ⟩ ∈ F $ by weaken [q11]
q18: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ ⟨ x , b ⟩ ∈ F $ by wcel_eq_l [q16, q17]
q19: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ x ∊ A $ by ax
q20: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ ⟨ x , b ⟩ ∈ cres F A $ by cres_intro [q19, q18]
q21: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ b ∊ crn (cres F A) $ by crn_intro [q20]
q22: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ a = crn (cres F A) $ by weaken [q3]
q23: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ crn (cres F A) = a $ by eq_sym [q22]
q24: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ b ∊ a $ by welc_eq [q23, q21]
q25: $ G , a = crn (cres F A) , chooses g a , x ∊ A , b = fv F x ⇒ fv F x ∈ a $ by wcel_intro [q13, q24]
q26: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ fv F x ∈ a $ by isset_elim [q12, q25]
q27: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ ∀ x (x ∊ A → ∃ y (y ∊ fv F x)) $ by weaken [#4]
q28: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ x ∊ A → ∃ y (y ∊ fv F x) $ by all_elim [q27]
q29: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ ∃ y (y ∊ fv F x) $ by imp_elim [q28, q6]
q30: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ chooses g a $ by weaken [q5]
q31: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ fv g (fv F x) ∈ fv F x $ by chooses_fv_c [q30, q26, q29]
q32: $ G , a = crn (cres F A) , chooses g a ⇒ x ∊ A → fv g (fv F x) ∈ fv F x $ by imp_intro [q31]
q33: $ G , a = crn (cres F A) , chooses g a ⇒ ∀ x (x ∊ A → fv g (fv F x) ∈ fv F x) $ by all_intro [q32]
q34: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ chooses g a $ by weaken [q5]
q35: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ functional g $ by and_elim_l [q34]
q36: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ functional F $ by weaken [#2]
q37: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ isset (fv F x) $ by fv_set [q36]
q38: $ G , a = crn (cres F A) , chooses g a , x ∊ A ⇒ isset (fv g (fv F x)) $ by fv_set_c [q35, q37]
q39: $ G , a = crn (cres F A) , chooses g a ⇒ x ∊ A → isset (fv g (fv F x)) $ by imp_intro [q38]
q40: $ G , a = crn (cres F A) , chooses g a ⇒ ∀ x (x ∊ A → isset (fv g (fv F x))) $ by all_intro [q39]
q41: $ G , a = crn (cres F A) , chooses g a ⇒ isset A $ by weaken [#1]
q42: $ G , a = crn (cres F A) , chooses g a ⇒ isset (clam x A (fv g (fv F x))) $ by clam_set [q41, q40]
q43: $ G , a = crn (cres F A) , chooses g a ⇒ clam x A (fv g (fv F x)) ∈ cpi x A (fv F x) $ by clam_cpi_intro [q42, q33]
q44: $ G , a = crn (cres F A) , chooses g a , h = clam x A (fv g (fv F x)) ⇒ h = clam x A (fv g (fv F x)) $ by ax
q45: $ G , a = crn (cres F A) , chooses g a , h = clam x A (fv g (fv F x)) ⇒ clam x A (fv g (fv F x)) = h $ by eq_sym [q44]
q46: $ G , a = crn (cres F A) , chooses g a , h = clam x A (fv g (fv F x)) ⇒ clam x A (fv g (fv F x)) ∈ cpi x A (fv F x) $ by weaken [q43]
q47: $ G , a = crn (cres F A) , chooses g a , h = clam x A (fv g (fv F x)) ⇒ h ∈ cpi x A (fv F x) $ by wcel_eq_l [q45, q46]
q48: $ G , a = crn (cres F A) , chooses g a , h = clam x A (fv g (fv F x)) ⇒ h ∊ cpi x A (fv F x) $ by wcel_welc [q47]
q49: $ G , a = crn (cres F A) , chooses g a , h = clam x A (fv g (fv F x)) ⇒ ∃ f (f ∊ cpi x A (fv F x)) $ by ex_intro [q48]
q50: $ G , a = crn (cres F A) , chooses g a ⇒ ∃ f (f ∊ cpi x A (fv F x)) $ by isset_elim [q42, q49]
q51: $ G , a = crn (cres F A) , ∃ g (chooses g a) ⇒ ∃ g (chooses g a) $ by ax
q52: $ G , a = crn (cres F A) , ∃ g (chooses g a) ⇒ ∃ f (f ∊ cpi x A (fv F x)) $ by ex_elim [q51, q50]
q53: $ G , a = crn (cres F A) ⇒ ∃ g (chooses g a) → ∃ f (f ∊ cpi x A (fv F x)) $ by imp_intro [q52]
q54: $ G , a = crn (cres F A) ⇒ ∃ f (f ∊ cpi x A (fv F x)) $ by imp_elim [q53, q4]
q55: $ G ⇒ ∃ f (f ∊ cpi x A (fv F x)) $ by isset_elim [q2, q54]

lemma b6_sarg_etel (G: hyps) (U E T W R T2 W2 R2: class): $ G ⇒ etel U E T W R = etel U E T2 W2 R2 $ > $ G ⇒ sarg U E T W R = sarg U E T2 W2 R2 $
----
q1: $ G , z ∊ sarg U E T W R ⇒ z ∊ sarg U E T W R $ by ax
q2: $ G , z ∊ sarg U E T W R ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ z ∈ a) $ by cab_elim [q1]
