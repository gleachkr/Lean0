lemma b5_xq_eq {x f g t a y: set} (G: hyps) (P P2 D D2 Q Q2 R O: class) (u w: set): $ G ⇒ P = P2 $ > $ G ⇒ D = D2 $ > $ G ⇒ ∀ x (x ∊ u → da Q w (scons x R) = da Q2 w (scons x O)) $ > $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $
----
s1: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $ by b5_xq_sub [#1, #2, #3]
s2: $ G ⇒ P2 = P $ by eq_sym [#1]
s3: $ G ⇒ D2 = D $ by eq_sym [#2]
s4a: $ G , x ∊ u ⇒ ∀ x (x ∊ u → da Q w (scons x R) = da Q2 w (scons x O)) $ by weaken [#3]
s4b: $ G , x ∊ u ⇒ x ∊ u → da Q w (scons x R) = da Q2 w (scons x O) $ by all_elim [s4a]
s4c: $ G , x ∊ u ⇒ x ∊ u $ by ax
s4d: $ G , x ∊ u ⇒ da Q w (scons x R) = da Q2 w (scons x O) $ by imp_elim [s4b, s4c]
s4e: $ G , x ∊ u ⇒ da Q2 w (scons x O) = da Q w (scons x R) $ by eq_sym [s4d]
s4f: $ G ⇒ x ∊ u → da Q2 w (scons x O) = da Q w (scons x R) $ by imp_intro [s4e]
s4g: $ G ⇒ ∀ x (x ∊ u → da Q2 w (scons x O) = da Q w (scons x R)) $ by all_intro [s4f]
s4: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} $ by b5_xq_sub [s2, s3, s4g]
s5: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q w (scons x R) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D t , a ⟩ ⟩ ⟩)} = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ P2 ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da Q2 w (scons x O) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons D2 t , a ⟩ ⟩ ⟩)} $ by subset_antisym [s1, s4]

lemma b5_dstep (G: hyps) (M: class) (u w s k h: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ k ∊ ω $ > $ G ⇒ h ∊ fseq (trees ω) $ > $ G ⇒ crn h ⊆ b5_dp u M w s $ > $ G ⇒ ⟨ k , h ⟩ ∈ b5_dp u M w s $
----
b1: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ w ∊ lvals $ by weaken [#1]
b2: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ s ∊ fseq u $ by weaken [#2]
b3: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ k ∊ ω $ by weaken [#3]
b4: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ h ∊ fseq (trees ω) $ by weaken [#4]
b5: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ crn h ⊆ b5_dp u M w s $ by weaken [#5]
b6: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ r ∊ fseq u $ by ax
b7: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ c = ccom (etf u (dsh u M s)) h $ by ax
b8: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ d = ccom (etf u (dnf u M)) h $ by ax
b9: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ o = scat r s $ by ax
b10: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ x0 = ∅ $ by ax
b11: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ x1 = suc ∅ $ by ax
f1: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ r ∈ fseq u $ by welc_wcel [b6]
f2: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ s ∈ fseq u $ by welc_wcel [b2]
f3: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ scat r s ∈ fseq u $ by scat_fseq_c [f1, f2]
f4: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ scat r s = o $ by eq_sym [b9]
f5: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ o ∈ fseq u $ by wcel_eq_l [f4, f3]
ol: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ o ∊ fseq u $ by wcel_welc [f5]
wc: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ w ∈ lvals $ by welc_wcel [b1]
ww: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ w = w $ by eq_refl
rr: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ r = r $ by eq_refl
g1: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ da (fv (ccom (etf u (dsh u M s)) h) x0) w r = da (fv (ccom (etf u (dnf u M)) h) x0) w (scat r s) $ by b5_dch [b4, b5, b6]
g2: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ ccom (etf u (dsh u M s)) h = c $ by eq_sym [b7]
g3: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ fv (ccom (etf u (dsh u M s)) h) x0 = fv c ∅ $ by fv_eq [g2, b10]
g4: $ G , r ∊ fseq u , c = ccom (etf u (dsh u M s)) h , d = ccom (etf u (dnf u M)) h , o = scat r s , x0 = ∅ , x1 = suc ∅ ⇒ ccom (etf u (dnf u M)) h = d $ by eq_sym [b8]
