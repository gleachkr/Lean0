lemma b16_core (G: hyps) (J M W P T X Q: class) (u td tp tj tc tk tf tg tt ta tx: set): $ G ⇒ icwf J td $ > $ G ⇒ uadm u $ > $ G ⇒ td ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ iprt td P T $ > $ G ⇒ Q ∈ esat u (dnf u M) P W $ > $ G ⇒ tp ∊ esat u (dnf u M) P W $ > $ G ⇒ ictk td tj tc tk $ > $ G ⇒ ⟨ tf , ⟨ tg , ⟨ tt , ta ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk W (scat tp X) $ > $ G ⇒ ta = scat tx Q $ > $ G ⇒ tx ∊ fseq (crn tx) $ > $ G ⇒ tp = Q $
----
c0: $ G ⇒ ∃ p ∃ t ∃ n ∃ m ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) $ by weaken [#1]
c1: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) ⇒ iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ by ax
c2: $ … ⇒ iprt td p t $ by and_elim_l [c1]
c3r: $ … ⇒ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ by and_elim_r [c1]
c3: $ … ⇒ ra_clen p m ∈ lrel $ by and_elim_l [c3r]
c4: $ … ⇒ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ by and_elim_r [c3r]
c5: $ … ⇒ ∀ c ∀ k (ictk td tj c k → ∃ i (fv nvf i = tj ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ by all_elim [c4]
c6: $ … ⇒ ∀ k (ictk td tj tc k → ∃ i (fv nvf i = tj ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) $ by all_elim [c5]
c7: $ … ⇒ ictk td tj tc tk → ∃ i (fv nvf i = tj ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by all_elim [c6]
c8: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) ⇒ ictk td tj tc tk $ by weaken [#8]
c9: $ … ⇒ ∃ i (fv nvf i = tj ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by imp_elim [c7, c8]
c10: $ _ ⇒ (∃ i (fv nvf i = tj ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J)) ↔ ∃ x3 (fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by ex_alpha
c11: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) ⇒ (∃ i (fv nvf i = tj ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J)) ↔ ∃ x3 (fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by weaken [c10]
c12: $ … ⇒ ∃ x3 (fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J) $ by bi_elim_l [c11, c9]
f0: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J $ by ax
f2: $ … ⇒ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J $ by and_elim_r [f0]
d1: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ td ∈ trees ω $ by weaken [#3]
d1b: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ ictk td tj tc tk $ by weaken [#8]
d2: $ … ⇒ tk ∈ fv tsub td $ by ictk_tsub [d1, d1b]
d3: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ fv tsub td ⊆ trees ω $ by tsub_trees
d4: $ … ⇒ tk ∈ trees ω $ by wcel_subset [d3, d2]
d5: $ … ⇒ tk ∊ trees ω $ by wcel_welc [d4]
b1: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ iprt td P T $ by weaken [#5]
b2: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ iprt td p t $ by weaken [c2]
b3: $ … ⇒ P = p $ by b7_iprt_eqp [b1, b2]
b4: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ W = W $ by eq_refl
b5: $ … ⇒ esat u (dnf u M) P W = esat u (dnf u M) p W $ by esat_eq [b3, b4]
b6: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ tp ∊ esat u (dnf u M) P W $ by weaken [#7]
b7: $ … ⇒ tp ∊ esat u (dnf u M) p W $ by welc_eq [b5, b6]
b8: $ … ⇒ p ∈ fv tsub td ∧ t ∈ fv tsub td $ by iprt_tsub [d1, b2]
b9: $ … ⇒ p ∈ fv tsub td $ by and_elim_l [b8]
b10: $ … ⇒ p ∈ trees ω $ by wcel_subset [d3, b9]
b11: $ … ⇒ p ∊ trees ω $ by wcel_welc [b10]
b12: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ ra_clen p m ∈ lrel $ by weaken [c3]
b13: $ … ⇒ cdm tp = fv nvf m $ by esat_clen_c [b12, b11, b7]
g1: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ Q ∈ esat u (dnf u M) P W $ by weaken [#6]
g2: $ … ⇒ Q ∈ esat u (dnf u M) p W $ by wcel_eq_r [b5, g1]
g3: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J , o = Q , o ∊ esat u (dnf u M) p W ⇒ o ∊ esat u (dnf u M) p W $ by ax
g4: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J , o = Q , o ∊ esat u (dnf u M) p W ⇒ ra_clen p m ∈ lrel $ by weaken [b12]
g5: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J , o = Q , o ∊ esat u (dnf u M) p W ⇒ p ∊ trees ω $ by weaken [b11]
g6: $ … ⇒ cdm o = fv nvf m $ by esat_clen_c [g4, g5, g3]
g7: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J , o = Q , o ∊ esat u (dnf u M) p W ⇒ o = Q $ by ax
g8: $ … ⇒ cdm o = cdm Q $ by cdm_eq [g7]
g9: $ … ⇒ cdm Q = cdm o $ by eq_sym [g8]
g10: $ … ⇒ cdm Q = fv nvf m $ by eq_trans [g9, g6]
g11: $ … ⇒ cdm Q = fv nvf m $ by wcel_elim [g2, g10]
g12: $ … ⇒ fv nvf m = cdm tp $ by eq_sym [b13]
g13: $ … ⇒ cdm Q = cdm tp $ by eq_trans [g11, g12]
h1: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ esat u (dnf u M) P W ⊆ fseq u $ by esat_fseq
h2: $ … ⇒ Q ∈ fseq u $ by wcel_subset [h1, g1]
h3: $ … ⇒ tp ∊ fseq u $ by subset_elim [h1, b6]
v1: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ W ∈ lvals $ by weaken [#4]
v2: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ uadm u $ by weaken [#2]
v3: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ ⟨ tf , ⟨ tg , ⟨ tt , ta ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tk W (scat tp X) $ by weaken [#9]
v4: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ ta = scat tx Q $ by weaken [#10]
v5: $ G , iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J)) , fv nvf x3 = tj ∧ ra_cwf td n m l x3 x ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J ⇒ tx ∊ fseq (crn tx) $ by weaken [#11]
r0: $ … ⇒ tp = Q $ by b16_args [f2, d5, v1, v2, d1, h3, b13, v3, v4, v5, h2, g13]
r1: $ … ⇒ tp = Q $ by ex_elim [c12, r0]
ya1: $ G , ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) ⇒ ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) $ by ax
y1: $ … ⇒ tp = Q $ by ex_elim [ya1, r1]
ya2: $ G , ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) ⇒ ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) $ by ax
y2: $ … ⇒ tp = Q $ by ex_elim [ya2, y1]
ya3: $ G , ∃ m ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) ⇒ ∃ m ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) $ by ax
y3: $ … ⇒ tp = Q $ by ex_elim [ya3, y2]
ya4: $ G , ∃ n ∃ m ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) ⇒ ∃ n ∃ m ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) $ by ax
y4: $ … ⇒ tp = Q $ by ex_elim [ya4, y3]
ya5: $ G , ∃ t ∃ n ∃ m ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) ⇒ ∃ t ∃ n ∃ m ∃ l ∃ x (iprt td p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk td j c k → ∃ i (fv nvf i = j ∧ ra_cwf td n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 J))) $ by ax
y5: $ … ⇒ tp = Q $ by ex_elim [ya5, y4]
y6: $ … ⇒ tp = Q $ by ex_elim [c0, y5]

lemma b16_icwf (G: hyps) (J C: class) (d: set): $ G ⇒ ra_ind_wf C d ∈ lrel3 J $ > $ G ⇒ icwf J d $
----
a1: $ G , c = C ⇒ c = C $ by ax
a2: $ … ⇒ C = c $ by eq_sym [a1]
a3: $ G , c = C ⇒ d = d $ by eq_refl
a4: $ … ⇒ ra_ind_wf C d = ra_ind_wf c d $ by ra_ind_wf_eq [a2, a3]
a5: $ G , c = C ⇒ ra_ind_wf C d ∈ lrel3 J $ by weaken [#1]
a6: $ … ⇒ ra_ind_wf c d ∈ lrel3 J $ by wcel_eq_l [a4, a5]
a7: $ … ⇒ icwf J d $ by ind_wf_icwf [a6]
a8: $ G , isset C ⇒ isset C $ by ax
a9: $ … ⇒ icwf J d $ by isset_elim [a8, a7]
b1: $ G , ¬ isset C ⇒ ¬ isset C $ by ax
b2: $ … ⇒ scons C (scons d ∅) = scons ∅ (scons d ∅) $ by scons_proper [b1]
b3: $ G , ¬ isset C ⇒ kr_ind_wf = kr_ind_wf $ by eq_refl
b4: $ … ⇒ ⟨ kr_ind_wf , scons C (scons d ∅) ⟩ = ⟨ kr_ind_wf , scons ∅ (scons d ∅) ⟩ $ by opair_eq [b3, b2]
b6: $ G , ¬ isset C ⇒ ra_ind_wf C d ∈ lrel3 J $ by weaken [#1]
b7: $ … ⇒ ⟨ kr_ind_wf , scons ∅ (scons d ∅) ⟩ ∈ lrel3 J $ by wcel_eq_l [b4, b6]
b8: $ G , ¬ isset C , e = ∅ ⇒ e = ∅ $ by ax
b9: $ … ⇒ ∅ = e $ by eq_sym [b8]
b10: $ G , ¬ isset C , e = ∅ ⇒ d = d $ by eq_refl
b11: $ … ⇒ ra_ind_wf ∅ d = ra_ind_wf e d $ by ra_ind_wf_eq [b9, b10]
b12: $ G , ¬ isset C , e = ∅ ⇒ ra_ind_wf ∅ d ∈ lrel3 J $ by weaken [b7]
b13: $ … ⇒ ra_ind_wf e d ∈ lrel3 J $ by wcel_eq_l [b11, b12]
b14: $ … ⇒ icwf J d $ by ind_wf_icwf [b13]
b15: $ G , ¬ isset C ⇒ isset ∅ $ by ax_empty
b16: $ … ⇒ icwf J d $ by isset_elim [b15, b14]
c1: $ G ⇒ isset C ∨ ¬ isset C $ by excluded_middle
c2: $ … ⇒ icwf J d $ by or_elim [c1, a9, b16]

lemma b12_pin (G: hyps) (H J C D W R P T Q X: class) (u p0 j0 c0 k0 f0 g0 t0 a0 x0: set): $ G ⇒ iwf u H J C D W R $ > $ G ⇒ iprt D P T $ > $ G ⇒ Q ∈ esat u (dnf u (mcv H)) P W $ > $ G ⇒ p0 ∊ esat u (dnf u (mcv H)) P W $ > $ G ⇒ ictk D j0 c0 k0 $ > $ G ⇒ ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k0 W (scat p0 X) $ > $ G ⇒ a0 = scat x0 Q $ > $ G ⇒ x0 ∊ fseq (crn x0) $ > $ G ⇒ p0 = Q $
----
h1: $ … ⇒ uadm u $ by iwf_uadm [#1]
h2: $ … ⇒ ra_ind_wf C D ∈ lrel3 J $ by iwf_wf [#1]
h3: $ … ⇒ D ∈ ofsort lsig lopen ks_ind $ by iwf_sort [#1]
h4: $ … ⇒ W ∈ lvals $ by iwf_lvals [#1]
h5: $ G ⇒ sig lsig lopen $ by lsig_sig
h6: $ … ⇒ ofsort lsig lopen ks_ind ⊆ trees ω $ by ofsort_trees [h5]
h7: $ … ⇒ D ∈ trees ω $ by wcel_subset [h6, h3]
h8: $ … ⇒ isset D $ by wcel_isset [h3]
k1: $ G , d = D ⇒ d = D $ by ax
k2: $ … ⇒ D = d $ by eq_sym [k1]
k3: $ G , d = D ⇒ C = C $ by eq_refl
k4: $ … ⇒ ra_ind_wf C D = ra_ind_wf C d $ by ra_ind_wf_eq [k3, k2]
k5: $ G , d = D ⇒ ra_ind_wf C D ∈ lrel3 J $ by weaken [h2]
k6: $ … ⇒ ra_ind_wf C d ∈ lrel3 J $ by wcel_eq_l [k4, k5]
k7: $ … ⇒ icwf J d $ by b16_icwf [k6]
k8: $ G , d = D ⇒ D ∈ trees ω $ by weaken [h7]
k9: $ … ⇒ d ∈ trees ω $ by wcel_eq_l [k2, k8]
k10: $ G , d = D ⇒ P = P $ by eq_refl
k11: $ G , d = D ⇒ T = T $ by eq_refl
k12: $ G , d = D ⇒ iprt D P T $ by weaken [#2]
k13: $ … ⇒ iprt d P T $ by iprt_eq [k2, k10, k11, k12]
k14: $ G , d = D ⇒ j0 = j0 $ by eq_refl
k15: $ G , d = D ⇒ c0 = c0 $ by eq_refl
k16: $ G , d = D ⇒ k0 = k0 $ by eq_refl
k17: $ G , d = D ⇒ ictk D j0 c0 k0 $ by weaken [#5]
k18: $ … ⇒ ictk d j0 c0 k0 $ by ictk_eq [k2, k14, k15, k16, k17]
k19: $ G , d = D ⇒ uadm u $ by weaken [h1]
k20: $ G , d = D ⇒ W ∈ lvals $ by weaken [h4]
k21: $ G , d = D ⇒ Q ∈ esat u (dnf u (mcv H)) P W $ by weaken [#3]
k22: $ G , d = D ⇒ p0 ∊ esat u (dnf u (mcv H)) P W $ by weaken [#4]
k23: $ G , d = D ⇒ ⟨ f0 , ⟨ g0 , ⟨ t0 , a0 ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k0 W (scat p0 X) $ by weaken [#6]
k24: $ G , d = D ⇒ a0 = scat x0 Q $ by weaken [#7]
k25: $ G , d = D ⇒ x0 ∊ fseq (crn x0) $ by weaken [#8]
k26: $ … ⇒ p0 = Q $ by b16_core [k7, k19, k9, k20, k13, k21, k22, k18, k23, k24, k25]
k27: $ … ⇒ p0 = Q $ by isset_elim [h8, k26]

def b12_cgk (J M U W D t2 t3 t4 t5 Q X R: class) (.y .c .d .r .g .f .t .a: set): class = $ {y | ∀ c ∀ d ∀ r (ra_cwf D t2 t3 t4 t5 c d y ∈ lrel3 J → c ∊ trees ω → d ∊ trees ω → r ∊ fseq U → cdm r = fv nvf d → scat r (scat Q R) ∈ sat U M c W → y ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U (dnf U M) y W (scat r (scat Q X)))} ∈ fv uni (lv t4 W))} $

def b12_bnd (D NP X S: class) (.o .m .q: set): fml = $ ∀ o ∀ m ∀ q (ra_nidx D o m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf NP) → q ∊ fseq b6_V → apn (fv X (fv nvf o)) q ⊆ S) $

def b12_ne (D NP Y: class) (.o .m .q .g: set): fml = $ ∀ o ∀ m ∀ q (ra_nidx D o m ∈ lrel → cdm q = nadd (fv nvf m) (fv nvf NP) → q ∊ fseq b6_V → ∀ g (g ∊ apn (fv Y (fv nvf o)) q → ¬ g = ∅)) $

lemma b12_nlu (G: hyps) (W: class) (l: set): $ G ⇒ W ∈ lvals $ > $ G ⇒ ¬ lv l W = ∅ $ > $ G ⇒ universe (fv uni (lv l W)) ∧ ω ∈ fv uni (lv l W) $
