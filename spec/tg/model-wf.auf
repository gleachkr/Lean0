lemma b3_ofsort_u (G: hyps) (K: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ ofsort lsig lopen K ∈ u $
----
l1: $ G ⇒ universe u $ by uadm_universe [#1]
l2: $ G ⇒ ω ∈ u $ by uadm_omega [#1]
l3: $ G ⇒ isset ω $ by omega_set
l4: $ G , o = ω ⇒ universe u $ by weaken [l1]
l5: $ G , o = ω ⇒ ω ∈ u $ by weaken [l2]
l6: $ G , o = ω ⇒ o = ω $ by ax
l7: $ G , o = ω ⇒ ω = o $ by eq_sym [l6]
l8: $ G , o = ω ⇒ o ∈ u $ by wcel_eq_l [l7, l5]
l9: $ G , o = ω ⇒ o ∊ u $ by wcel_welc [l8]
l10: $ G , o = ω ⇒ trees o ∈ u $ by trees_universe [l4, l5, l9]
l11: $ G , o = ω ⇒ trees o = trees ω $ by trees_eq [l6]
l12: $ G , o = ω ⇒ trees ω ∈ u $ by wcel_eq_l [l11, l10]
l13: $ G ⇒ trees ω ∈ u $ by isset_elim [l3, l12]
l14: $ G ⇒ sig lsig lopen $ by lsig_sig
l15: $ G ⇒ ofsort lsig lopen K ⊆ trees ω $ by ofsort_trees [l14]
l16: $ G ⇒ ofsort lsig lopen K ∈ u $ by universe_subset_c [l1, l13, l15]

lemma b3_scat_u (G: hyps) (U: class) (x q: set): $ G ⇒ universe U $ > $ G ⇒ x ∊ U $ > $ G ⇒ q ∊ U $ > $ G ⇒ x ∊ fseq U $ > $ G ⇒ q ∊ fseq U $ > $ G ⇒ scat x q ∈ U $
----
l1: $ G ⇒ crn x ⊆ crn x ∪ crn q $ by cun_subset_l
l2: $ G ⇒ crn q ⊆ crn x ∪ crn q $ by cun_subset_r
l3: $ G ⇒ functional x $ by fseq_functional [#4]
l4: $ G ⇒ rel x $ by fseq_rel [#4]
l5: $ G ⇒ cdm x ∈ ω $ by fseq_len [#4]
l6: $ G ⇒ x ∊ fseq (crn x ∪ crn q) $ by fseq_of_fn [l3, l4, l5, l1]
l7: $ G ⇒ functional q $ by fseq_functional [#5]
l8: $ G ⇒ rel q $ by fseq_rel [#5]
l9: $ G ⇒ cdm q ∈ ω $ by fseq_len [#5]
l10: $ G ⇒ q ∊ fseq (crn x ∪ crn q) $ by fseq_of_fn [l7, l8, l9, l2]
l11: $ G ⇒ scat x q ∈ fseq (crn x ∪ crn q) $ by scat_fseq [l6, l10]
l12: $ G ⇒ crn x ∈ U $ by universe_crn [#1, #2]
l13: $ G ⇒ crn q ∈ U $ by universe_crn [#1, #3]
l14: $ G ⇒ crn x ∪ crn q ∈ U $ by universe_cun_c [#1, l12, l13]
l15: $ G ⇒ scat x q ∈ U $ by universe_fseq_elem_c [#1, l14, l11]

