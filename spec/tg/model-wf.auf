q264: $ H , ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_pi , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_cst , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_atom ∧ y ∊ ofsort lsig lopen ks_lvls) ∨ ∃ x (z = ⟨ kc_lit , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) ∨ ∃ x ∃ y (z = ⟨ kc_ind_ty , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_ind_ctor , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_nat) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_ind_rec , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_proj , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_expr) ∨ ∃ x (z = ⟨ kc_quot , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (z = ⟨ kc_quot_mk , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (z = ⟨ kc_quot_lift , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (z = ⟨ kc_quot_ind , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ⇒ a ∊ ofsort lsig lopen ks_nat $ by or_elim [q261, q262, q263]
q265: $ H ⇒ a ∊ ofsort lsig lopen ks_nat $ by or_elim [q1, q10, q264]

lemma b6_kids_bvar (G: hyps) (a: set): $ G ⇒ ⟨ kc_bvar , scons a ∅ ⟩ ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ a ∊ ofsort lsig lopen ks_nat $
----
q1: $ G , z = ⟨ kc_bvar , scons a ∅ ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z ∊ ofsort lsig lopen ks_expr $ by ax
q2: $ G , z = ⟨ kc_bvar , scons a ∅ ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_bvar , scons a ∅ ⟩ $ by ax
q3: $ G , z = ⟨ kc_bvar , scons a ∅ ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_nat $ by b6_kc_bvar [q1, q2]
q4: $ G ⇒ a ∊ ofsort lsig lopen ks_nat $ by wcel_elim [#1, q3]

lemma b6_kc_lam (H: hyps) (z a b: set): $ H ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ H ⇒ z = ⟨ kc_lam , scons a (scons b ∅) ⟩ $ > $ H ⇒ a ∊ ofsort lsig lopen ks_expr ∧ b ∊ ofsort lsig lopen ks_expr $
----
q1: $ H ⇒ ∃ x (z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ∨ ∃ x (z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (z = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_pi , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨ ∃ x ∃ y (z = ⟨ kc_cst , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_atom ∧ y ∊ ofsort lsig lopen ks_lvls) ∨ ∃ x (z = ⟨ kc_lit , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) ∨ ∃ x ∃ y (z = ⟨ kc_ind_ty , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_ind_ctor , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_nat) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_ind_rec , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y ∃ u (z = ⟨ kc_proj , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_expr) ∨ ∃ x (z = ⟨ kc_quot , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (z = ⟨ kc_quot_mk , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (z = ⟨ kc_quot_lift , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (z = ⟨ kc_quot_ind , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) $ by ofsort_expr_cases [#1]
q2: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat $ by ax
q3: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons x ∅ ⟩ $ by and_elim_l [q2]
q4: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ x ∊ ofsort lsig lopen ks_nat $ by and_elim_r [q2]
q5: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_lam , scons a (scons b ∅) ⟩ $ by weaken [#2]
q6: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
q7: $ H , z = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat ⇒ kc_lam ∈ ω $ by kc_lam_omega
