q15: $ H , z = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ⇒ z = ⟨ kc_proj , scons a (scons b (scons c ∅)) ⟩ $ by weaken [#2]
