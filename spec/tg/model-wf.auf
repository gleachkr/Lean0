ic: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel $ by and_elim_r [ib]
id: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ ra_nth_ctor e m K ∈ lrel $ by and_elim_r [ic]
i2: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ D ∈ ofsort lsig lopen ks_ind $ by weaken [#1]
i3: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ p ∈ ofsort lsig lopen ks_ctx ∧ t ∈ ofsort lsig lopen ks_tys $ by iprt_sort [i2, i1]
i4: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ t ∈ ofsort lsig lopen ks_tys $ by and_elim_r [i3]
i5: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ t ∊ ofsort lsig lopen ks_tys $ by wcel_welc [i4]
i7: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ f ∊ ofsort lsig lopen ks_expr ∧ e ∊ ofsort lsig lopen ks_ctors $ by b3_nty_sort [i5, i6]
i8: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ e ∊ ofsort lsig lopen ks_ctors $ by and_elim_r [i7]
i9: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ kr_nth_ctor ∈ ω $ by kr_nth_ctor_omega
i10: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ isset kr_nth_ctor $ by wcel_isset [i9]
i11: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ e ∈ trees ω ∧ m ∈ trees ω ∧ K ∈ trees ω $ by lrel_args3_c [id, i10]
i12: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ m ∈ trees ω ∧ K ∈ trees ω $ by and_elim_r [i11]
i13a: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ K ∈ trees ω $ by and_elim_r [i12]
i13: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ isset K $ by wcel_isset [i13a]
j1: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ k = K $ by ax
j2: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ K = k $ by eq_sym [j1]
j3: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ e = e $ by eq_refl
j4: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ m = m $ by eq_refl
j6: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ ra_nth_ctor e m K = ra_nth_ctor e m k $ by ra_nth_ctor_eq [j3, j4, j2]
j7: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ ra_nth_ctor e m K ∈ lrel $ by weaken [id]
j8: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ ra_nth_ctor e m k ∈ lrel $ by wcel_eq_l [j6, j7]
j9: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ e ∊ ofsort lsig lopen ks_ctors $ by weaken [i8]
j11: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ k ∊ ofsort lsig lopen ks_expr $ by b3_nctor_sort [j9, j8]
j12: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel , k = K ⇒ K ∈ ofsort lsig lopen ks_expr $ by wcel_intro [j1, j11]
j13: $ G , iprt D p t ∧ fv nvf n = J ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ K ∈ ofsort lsig lopen ks_expr $ by isset_elim [i13, j12]
j14: $ G ⇒ K ∈ ofsort lsig lopen ks_expr $ by ictk_elim [#2, j13]

lemma b3_opair_u (G: hyps) (U A B: class): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ B ∈ U $ > $ G ⇒ ⟨ A , B ⟩ ∈ U $
----
l1: $ G ⇒ csn A ∈ U $ by universe_cpr_c [#1, #2, #2]
l2: $ G ⇒ cpr A B ∈ U $ by universe_cpr_c [#1, #2, #3]
l3: $ G ⇒ ⟨ A , B ⟩ ∈ U $ by universe_cpr_c [#1, l1, l2]

lemma b3_cdm_u (G: hyps) (U A: class): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ cdm A ∈ U $
----
l1: $ G , a = A , a ∊ U ⇒ universe U $ by weaken [#1]
l2: $ G , a = A , a ∊ U ⇒ a ∊ U $ by ax
l3: $ G , a = A , a ∊ U ⇒ cdm a ∈ U $ by universe_cdm [l1, l2]
l4: $ G , a = A , a ∊ U ⇒ a = A $ by ax
l5: $ G , a = A , a ∊ U ⇒ cdm a = cdm A $ by cdm_eq [l4]
l6: $ G , a = A , a ∊ U ⇒ cdm A ∈ U $ by wcel_eq_l [l5, l3]
l7: $ G ⇒ cdm A ∈ U $ by wcel_elim [#2, l6]

lemma b3_crn_u (G: hyps) (U A: class): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ crn A ∈ U $
----
l1: $ G , a = A , a ∊ U ⇒ universe U $ by weaken [#1]
l2: $ G , a = A , a ∊ U ⇒ a ∊ U $ by ax
l3: $ G , a = A , a ∊ U ⇒ crn a ∈ U $ by universe_crn [l1, l2]
l4: $ G , a = A , a ∊ U ⇒ a = A $ by ax
l5: $ G , a = A , a ∊ U ⇒ crn a = crn A $ by crn_eq [l4]
l6: $ G , a = A , a ∊ U ⇒ crn A ∈ U $ by wcel_eq_l [l5, l3]
l7: $ G ⇒ crn A ∈ U $ by wcel_elim [#2, l6]

lemma b3_cpw_c (G: hyps) (A B: class): $ G ⇒ isset A $ > $ G ⇒ A ⊆ B $ > $ G ⇒ A ∈ 𝒫 B $
----
l1: $ G , w = A ⇒ w = A $ by ax
l2: $ G , w = A ⇒ A = w $ by eq_sym [l1]
l3: $ G , w = A ⇒ A ⊆ B $ by weaken [#2]
l4: $ G , w = A ⇒ w ⊆ B $ by subset_eq_l [l2, l3]
l5: $ G , w = A ⇒ w ∊ 𝒫 B $ by cpw_intro [l4]
l6: $ G , w = A ⇒ A ∈ 𝒫 B $ by wcel_intro [l1, l5]
l7: $ G ⇒ A ∈ 𝒫 B $ by isset_elim [#1, l6]

lemma b3_scons_u (G: hyps) (U A S: class): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ S ∈ U $ > $ G ⇒ scons A S ∈ U $
----
k1: $ G ⇒ cdm S ∈ U $ by b3_cdm_u [#1, #3]
k2: $ G ⇒ ⋃ (cdm S) ∈ U $ by universe_cuni_c [#1, k1]
k3: $ G ⇒ ⋃ (cdm S) ∪ cdm S ∈ U $ by universe_cun_c [#1, k2, k1]
k4: $ G ⇒ 𝒫 (⋃ (cdm S) ∪ cdm S) ∈ U $ by universe_cpw_c [#1, k3]
k5: $ G ⇒ csn A ∈ U $ by universe_cpr_c [#1, #2, #2]
k6: $ G ⇒ crn S ∈ U $ by b3_crn_u [#1, #3]
k7: $ G ⇒ csn A ∪ crn S ∈ U $ by universe_cun_c [#1, k5, k6]
k8: $ G ⇒ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) ∈ U $ by universe_cxp_c [#1, k4, k7]
a1: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z ∊ csn ⟨ ∅ , A ⟩ $ by ax
a2: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z = ⟨ ∅ , A ⟩ $ by csn_elim [a1]
a3: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset ∅ $ by ax_empty
a4: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ ∅ ⊆ ⋃ (cdm S) ∪ cdm S $ by empty_subset
a5: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ ∅ ∈ 𝒫 (⋃ (cdm S) ∪ cdm S) $ by b3_cpw_c [a3, a4]
a6: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ A ∈ U $ by weaken [#2]
a7: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ isset A $ by wcel_isset [a6]
a8: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ A ∈ csn A $ by csn_intro_var_c [a7]
a9: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ A ∈ csn A ∪ crn S $ by cun_intro_l_c [a8]
a10: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ ⟨ ∅ , A ⟩ ∈ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by cxp_intro_c [a5, a9]
a11: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ ⟨ ∅ , A ⟩ = z $ by eq_sym [a2]
a12: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z ∈ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by wcel_eq_l [a11, a10]
a13: $ G , z ∊ scons A S , z ∊ csn ⟨ ∅ , A ⟩ ⇒ z ∊ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by wcel_welc [a12]
b1: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S $ by ax
b2: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ z = ⟨ suc i , y ⟩ $ by and_elim_l [b1]
b3: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ ⟨ i , y ⟩ ∈ S $ by and_elim_r [b1]
b4: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ i ∊ cdm S $ by cdm_intro [b3]
b5: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ y ∊ crn S $ by crn_intro [b3]
b6: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ i ⊆ ⋃ (cdm S) $ by cuni_subset [b4]
b7: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ ⋃ (cdm S) ⊆ ⋃ (cdm S) ∪ cdm S $ by cun_subset_l
b8: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ i ⊆ ⋃ (cdm S) ∪ cdm S $ by subset_trans [b6, b7]
b9: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ csn i ⊆ cdm S $ by csn_subset [b4]
b10: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ cdm S ⊆ ⋃ (cdm S) ∪ cdm S $ by cun_subset_r
b11: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ csn i ⊆ ⋃ (cdm S) ∪ cdm S $ by subset_trans [b9, b10]
b12: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ suc i ⊆ ⋃ (cdm S) ∪ cdm S $ by cun_least [b8, b11]
b13: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ isset i $ by isset_var
b14: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ isset (suc i) $ by suc_set [b13]
b15: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ suc i ∈ 𝒫 (⋃ (cdm S) ∪ cdm S) $ by b3_cpw_c [b14, b12]
b16: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ y ∊ csn A ∪ crn S $ by cun_intro_r [b5]
b17: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ y ∈ csn A ∪ crn S $ by welc_wcel [b16]
b18: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ ⟨ suc i , y ⟩ ∈ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by cxp_intro_c [b15, b17]
b19: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ ⟨ suc i , y ⟩ = z $ by eq_sym [b2]
b20: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ z ∈ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by wcel_eq_l [b19, b18]
b21: $ G , z ∊ scons A S , z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S ⇒ z ∊ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by wcel_welc [b20]
c1: $ G , z ∊ scons A S , ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S) ⇒ ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S) $ by ax
c2: $ G , z ∊ scons A S , ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S) ⇒ z ∊ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by ex_elim [c1, b21]
c3: $ G , z ∊ scons A S , ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S) ⇒ ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S) $ by ax
c4: $ G , z ∊ scons A S , ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S) ⇒ z ∊ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by ex_elim [c3, c2]
c5: $ G , z ∊ scons A S , z ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S)} ⇒ z ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S)} $ by ax
c6: $ G , z ∊ scons A S , z ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S)} ⇒ ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S) $ by cab_elim [c5]
c7: $ G , z ∊ scons A S , z ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S)} ⇒ z ∊ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by cut [c6, c4]
d1: $ G , z ∊ scons A S ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∪ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S)} $ by ax
d2: $ G , z ∊ scons A S ⇒ z ∊ csn ⟨ ∅ , A ⟩ ∨ z ∊ {z | ∃ i ∃ y (z = ⟨ suc i , y ⟩ ∧ ⟨ i , y ⟩ ∈ S)} $ by cun_elim [d1]
d3: $ G , z ∊ scons A S ⇒ z ∊ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by or_elim [d2, a13, c7]
d4: $ G ⇒ scons A S ⊆ 𝒫 (⋃ (cdm S) ∪ cdm S) × (csn A ∪ crn S) $ by subset_intro [d3]
d5: $ G ⇒ scons A S ∈ U $ by universe_subset_c [#1, k8, d4]

lemma b3_ssnoc_u (G: hyps) (U S A: class): $ G ⇒ universe U $ > $ G ⇒ S ∈ U $ > $ G ⇒ A ∈ U $ > $ G ⇒ ssnoc S A ∈ U $
----
l1: $ G ⇒ cdm S ∈ U $ by b3_cdm_u [#1, #2]
l2: $ G ⇒ ⟨ cdm S , A ⟩ ∈ U $ by b3_opair_u [#1, l1, #3]
l3: $ G ⇒ csn ⟨ cdm S , A ⟩ ∈ U $ by universe_cpr_c [#1, l2, l2]
l4: $ G ⇒ ssnoc S A ∈ U $ by universe_cun_c [#1, #2, l3]

lemma b3_repl1 {z y: set} (G: hyps) (U X: class) (B: class z): $ G ⇒ universe U $ > $ G ⇒ X ∈ U $ > $ G ⇒ ∀ z (z ∊ X → B ∈ U) $ > $ G ⇒ {y | ∃ z (z ∊ X ∧ y = B)} ∈ U $
----
a1: $ G , a = X , a ∊ U , z ∊ a ⇒ z ∊ a $ by ax
a2: $ G , a = X , a ∊ U , z ∊ a ⇒ a = X $ by ax
a3: $ G , a = X , a ∊ U , z ∊ a ⇒ z ∊ X $ by welc_eq [a2, a1]
a4: $ G , a = X , a ∊ U , z ∊ a ⇒ ∀ z (z ∊ X → B ∈ U) $ by weaken [#3]
a5: $ G , a = X , a ∊ U , z ∊ a ⇒ z ∊ X → B ∈ U $ by all_elim [a4]
a6: $ G , a = X , a ∊ U , z ∊ a ⇒ B ∈ U $ by imp_elim [a5, a3]
a7: $ G , a = X , a ∊ U ⇒ z ∊ a → B ∈ U $ by imp_intro [a6]
a8: $ G , a = X , a ∊ U ⇒ ∀ z (z ∊ a → B ∈ U) $ by all_intro [a7]
a9: $ G , a = X , a ∊ U ⇒ universe U $ by weaken [#1]
a10: $ G , a = X , a ∊ U ⇒ a ∊ U $ by ax
a11: $ G , a = X , a ∊ U ⇒ img (cgr z B) a ∈ U $ by universe_img_op [a9, a10, a8]
b1: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} ⇒ w ∊ {y | ∃ z (z ∊ X ∧ y = B)} $ by ax
b2: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} ⇒ ∃ z (z ∊ X ∧ w = B) $ by cab_elim [b1]
b3: $ ∃ z (z ∊ X ∧ w = B) ⟺ ∃ v (v ∊ X ∧ w = (⟦ z / v ⟧ B)) $ by ex_alpha
b4: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} ⇒ ∃ z (z ∊ X ∧ w = B) ↔ ∃ v (v ∊ X ∧ w = (⟦ z / v ⟧ B)) $ by weaken [b3]
b5: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} ⇒ ∃ v (v ∊ X ∧ w = (⟦ z / v ⟧ B)) $ by bi_elim_l [b4, b2]
c1: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} , v ∊ X ∧ w = (⟦ z / v ⟧ B) ⇒ v ∊ X ∧ w = (⟦ z / v ⟧ B) $ by ax
c2: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} , v ∊ X ∧ w = (⟦ z / v ⟧ B) ⇒ v ∊ X $ by and_elim_l [c1]
c3: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} , v ∊ X ∧ w = (⟦ z / v ⟧ B) ⇒ w = (⟦ z / v ⟧ B) $ by and_elim_r [c1]
c4: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} , v ∊ X ∧ w = (⟦ z / v ⟧ B) ⇒ ⟨ v , w ⟩ ∈ cgr z B $ by cgr_intro [c3]
c6: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} , v ∊ X ∧ w = (⟦ z / v ⟧ B) ⇒ a = X $ by ax
c5: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} , v ∊ X ∧ w = (⟦ z / v ⟧ B) ⇒ X = a $ by eq_sym [c6]
c7: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} , v ∊ X ∧ w = (⟦ z / v ⟧ B) ⇒ v ∊ a $ by welc_eq [c5, c2]
c8: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} , v ∊ X ∧ w = (⟦ z / v ⟧ B) ⇒ w ∊ img (cgr z B) a $ by img_intro [c7, c4]
c9: $ G , a = X , a ∊ U , w ∊ {y | ∃ z (z ∊ X ∧ y = B)} ⇒ w ∊ img (cgr z B) a $ by ex_elim [b5, c8]
c10: $ G , a = X , a ∊ U ⇒ {y | ∃ z (z ∊ X ∧ y = B)} ⊆ img (cgr z B) a $ by subset_intro [c9]
c11: $ G , a = X , a ∊ U ⇒ {y | ∃ z (z ∊ X ∧ y = B)} ∈ U $ by universe_subset_c [a9, a11, c10]
c12: $ G ⇒ {y | ∃ z (z ∊ X ∧ y = B)} ∈ U $ by wcel_elim [#2, c11]

lemma b3_repl2 {x z y: set} (G: hyps) (U A: class) (C: class x) (B: class x z): $ G ⇒ universe U $ > $ G ⇒ A ∈ U $ > $ G ⇒ ∀ x (x ∊ A → C ∈ U) $ > $ G ⇒ ∀ x ∀ z (x ∊ A → z ∊ C → B ∈ U) $ > $ G ⇒ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ∈ U $
----
d1: $ G , a = A , a ∊ U , x ∊ a ⇒ x ∊ a $ by ax
d2: $ G , a = A , a ∊ U , x ∊ a ⇒ a = A $ by ax
d3: $ G , a = A , a ∊ U , x ∊ a ⇒ x ∊ A $ by welc_eq [d2, d1]
d4: $ G , a = A , a ∊ U , x ∊ a ⇒ universe U $ by weaken [#1]
d5: $ G , a = A , a ∊ U , x ∊ a ⇒ ∀ x (x ∊ A → C ∈ U) $ by weaken [#3]
d6: $ G , a = A , a ∊ U , x ∊ a ⇒ x ∊ A → C ∈ U $ by all_elim [d5]
d7: $ G , a = A , a ∊ U , x ∊ a ⇒ C ∈ U $ by imp_elim [d6, d3]
d8: $ G , a = A , a ∊ U , x ∊ a , z ∊ C ⇒ ∀ x ∀ z (x ∊ A → z ∊ C → B ∈ U) $ by weaken [#4]
d9: $ G , a = A , a ∊ U , x ∊ a , z ∊ C ⇒ ∀ z (x ∊ A → z ∊ C → B ∈ U) $ by all_elim [d8]
d10: $ G , a = A , a ∊ U , x ∊ a , z ∊ C ⇒ x ∊ A → z ∊ C → B ∈ U $ by all_elim [d9]
d11: $ G , a = A , a ∊ U , x ∊ a , z ∊ C ⇒ x ∊ A $ by weaken [d3]
d12: $ G , a = A , a ∊ U , x ∊ a , z ∊ C ⇒ z ∊ C → B ∈ U $ by imp_elim [d10, d11]
d13: $ G , a = A , a ∊ U , x ∊ a , z ∊ C ⇒ z ∊ C $ by ax
d14: $ G , a = A , a ∊ U , x ∊ a , z ∊ C ⇒ B ∈ U $ by imp_elim [d12, d13]
d15: $ G , a = A , a ∊ U , x ∊ a ⇒ z ∊ C → B ∈ U $ by imp_intro [d14]
d16: $ G , a = A , a ∊ U , x ∊ a ⇒ ∀ z (z ∊ C → B ∈ U) $ by all_intro [d15]
d17: $ G , a = A , a ∊ U , x ∊ a ⇒ {y | ∃ z (z ∊ C ∧ y = B)} ∈ U $ by b3_repl1 [d4, d7, d16]
d18: $ G , a = A , a ∊ U ⇒ x ∊ a → {y | ∃ z (z ∊ C ∧ y = B)} ∈ U $ by imp_intro [d17]
d19: $ G , a = A , a ∊ U ⇒ ∀ x (x ∊ a → {y | ∃ z (z ∊ C ∧ y = B)} ∈ U) $ by all_intro [d18]
d20: $ G , a = A , a ∊ U ⇒ universe U $ by weaken [#1]
d21: $ G , a = A , a ∊ U ⇒ a ∊ U $ by ax
d22: $ G , a = A , a ∊ U ⇒ ⋃ (img (cgr x {y | ∃ z (z ∊ C ∧ y = B)}) a) ∈ U $ by universe_cuni_op [d20, d21, d19]
e1: $ G , a = A , a ∊ U , w ∊ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ⇒ w ∊ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} $ by ax
e2: $ G , a = A , a ∊ U , w ∊ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ⇒ ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ w = B) $ by cab_elim [e1]
e3: $ ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ w = B) ⟺ ∃ v ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) $ by ex_alpha
e4: $ G , a = A , a ∊ U , w ∊ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ⇒ ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ w = B) ↔ ∃ v ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) $ by weaken [e3]
e5: $ G , a = A , a ∊ U , w ∊ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ⇒ ∃ v ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) $ by bi_elim_l [e4, e2]
f1: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) $ by ax
f2: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ v ∊ A $ by and_elim_l [f1]
f2a: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) $ by and_elim_r [f1]
f3: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ ∃ z (z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) $ by ex_intro [f2a]
f4: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ w ∊ (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) $ by cab_intro [f3]
f5: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ a = A $ by ax
f6: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ A = a $ by eq_sym [f5]
f7: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ v ∊ a $ by welc_eq [f6, f2]
f8: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ ∀ x (x ∊ a → {y | ∃ z (z ∊ C ∧ y = B)} ∈ U) $ by weaken [d19]
f9: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ v ∊ a → (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ∈ U $ by all_elim [f8]
f10: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ∈ U $ by imp_elim [f9, f7]
f11: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ isset ((⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)})) $ by wcel_isset [f10]
g1: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) , b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ⇒ b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) $ by ax
g2: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) , b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ⇒ ⟨ v , b ⟩ ∈ cgr x {y | ∃ z (z ∊ C ∧ y = B)} $ by cgr_intro [g1]
g3: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) , b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ⇒ v ∊ a $ by weaken [f7]
g4: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) , b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ⇒ b ∊ img (cgr x {y | ∃ z (z ∊ C ∧ y = B)}) a $ by img_intro [g3, g2]
g5: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) , b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ⇒ (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) = b $ by eq_sym [g1]
g6: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) , b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ⇒ w ∊ (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) $ by weaken [f4]
g7: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) , b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ⇒ w ∊ b $ by welc_eq [g5, g6]
g8: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) , b = (⟦ x / v ⟧ {y | ∃ z (z ∊ C ∧ y = B)}) ⇒ w ∊ ⋃ (img (cgr x {y | ∃ z (z ∊ C ∧ y = B)}) a) $ by cuni_intro [g7, g4]
g9: $ G , a = A , a ∊ U , v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B)) ⇒ w ∊ ⋃ (img (cgr x {y | ∃ z (z ∊ C ∧ y = B)}) a) $ by isset_elim [f11, g8]
g9a: $ G , a = A , a ∊ U , ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) ⇒ ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) $ by ax
g9e: $ ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) ⟺ ∃ o (v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B))) $ by ex_alpha
g9f: $ G , a = A , a ∊ U , ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) ⇒ ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) ↔ ∃ o (v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B))) $ by weaken [g9e]
g9g: $ G , a = A , a ∊ U , ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) ⇒ ∃ o (v ∊ A ∧ o ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ z / o ⟧ (⟦ x / v ⟧ B))) $ by bi_elim_l [g9f, g9a]
g9b: $ G , a = A , a ∊ U , ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) ⇒ w ∊ ⋃ (img (cgr x {y | ∃ z (z ∊ C ∧ y = B)}) a) $ by ex_elim [g9g, g9]
g9c: $ G , a = A , a ∊ U , ∃ v ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) ⇒ ∃ v ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) $ by ax
g9d: $ G , a = A , a ∊ U , ∃ v ∃ z (v ∊ A ∧ z ∊ (⟦ x / v ⟧ C) ∧ w = (⟦ x / v ⟧ B)) ⇒ w ∊ ⋃ (img (cgr x {y | ∃ z (z ∊ C ∧ y = B)}) a) $ by ex_elim [g9c, g9b]
g10: $ G , a = A , a ∊ U , w ∊ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ⇒ w ∊ ⋃ (img (cgr x {y | ∃ z (z ∊ C ∧ y = B)}) a) $ by cut [e5, g9d]
g11: $ G , a = A , a ∊ U ⇒ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ⊆ ⋃ (img (cgr x {y | ∃ z (z ∊ C ∧ y = B)}) a) $ by subset_intro [g10]
g12: $ G , a = A , a ∊ U ⇒ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ∈ U $ by universe_subset_c [d20, d22, g11]
g13: $ G ⇒ {y | ∃ x ∃ z (x ∊ A ∧ z ∊ C ∧ y = B)} ∈ U $ by wcel_elim [#2, g12]

esat_universe
-------------
u1: $ G , w = W , w ∊ lvals ⇒ uadm u $ by weaken [#1]
u2: $ G , w = W , w ∊ lvals ⇒ universe u $ by uadm_universe [u1]
u3: $ G , w = W , w ∊ lvals ⇒ w ∊ lvals $ by ax
n1: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ w ∊ lvals $ by weaken [u3]
n2: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ esat u (dnf u M) ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by esat_nil [n1]
n3: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ uadm u $ by weaken [u1]
n4: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ ∅ ∈ u $ by uadm_empty [n3]
n5: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ universe u $ by weaken [u2]
n6: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ csn ∅ ∈ u $ by universe_cpr_c [n5, n4, n4]
n7: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by ax
n8: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ w = w $ by eq_refl
n9: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ esat u (dnf u M) z w = esat u (dnf u M) ⟨ kc_nil , ∅ ⟩ w $ by esat_eq [n7, n8]
n10: $ G , w = W , w ∊ lvals , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {a | a ∊ ofsort lsig lopen ks_ctx → esat u (dnf u M) a w ∈ u} , z = ⟨ k , j ⟩ , z ∊ ofsort lsig lopen ks_ctx , z = ⟨ kc_nil , ∅ ⟩ ⇒ esat u (dnf u M) z w = csn ∅ $ by eq_trans [n9, n2]
