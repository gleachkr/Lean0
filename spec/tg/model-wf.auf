--------
l1: $ (⟦ x / t ⟧ {y | ∃ j ∃ v (v ∊ fseq (crn v) ∧ ⟨ j , ⟨ scat v B , y ⟩ ⟩ ∈ A)}) ≐ {y | ∃ j ∃ v (v ∊ fseq (crn v) ∧ ⟨ j , ⟨ scat v (⟦ x / t ⟧ B) , y ⟩ ⟩ ∈ (⟦ x / t ⟧ A))} $ by ceqt_refl

lemma b4_isup_in (G: hyps) (Z S: class) (j a x y z: set): $ G ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z $ > $ G ⇒ y ∊ S $ > $ G ⇒ z = ⟨ j , ⟨ a , y ⟩ ⟩ $ > $ G ⇒ z ∊ isup Z S $
----
l1: $ G ⇒ y ∊ S ∧ z = ⟨ j , ⟨ a , y ⟩ ⟩ $ by and_intro [#2, #3]
l2: $ G ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ y ∊ S ∧ z = ⟨ j , ⟨ a , y ⟩ ⟩ $ by and_intro [#1, l1]
l3: $ G ⇒ ∃ x3 (⟨ j , ⟨ a , x ⟩ ⟩ ∈ Z ∧ x3 ∊ S ∧ z = ⟨ j , ⟨ a , x3 ⟩ ⟩) $ by ex_intro [l2]
l4: $ G ⇒ ∃ x2 ∃ x3 (⟨ j , ⟨ a , x2 ⟩ ⟩ ∈ Z ∧ x3 ∊ S ∧ z = ⟨ j , ⟨ a , x3 ⟩ ⟩) $ by ex_intro [l3]
l5: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 (⟨ j , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ x3 ∊ S ∧ z = ⟨ j , ⟨ x1 , x3 ⟩ ⟩) $ by ex_intro [l4]
l6: $ G ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (⟨ x0 , ⟨ x1 , x2 ⟩ ⟩ ∈ Z ∧ x3 ∊ S ∧ z = ⟨ x0 , ⟨ x1 , x3 ⟩ ⟩) $ by ex_intro [l5]
l7: $ G ⇒ z ∊ isup Z S $ by cab_intro [l6]

lemma b4_isup_intro_c (G: hyps) (Z S J A X Y: class): $ G ⇒ isset J $ > $ G ⇒ isset A $ > $ G ⇒ ⟨ J , ⟨ A , X ⟩ ⟩ ∈ Z $ > $ G ⇒ Y ∈ S $ > $ G ⇒ ⟨ J , ⟨ A , Y ⟩ ⟩ ∈ isup Z S $
----
k1: $ G , j = J , a = A , y = Y , y ∊ S , z = ⟨ J , ⟨ A , Y ⟩ ⟩ ⇒ j = J $ by ax
k2: $ G , j = J , a = A , y = Y , y ∊ S , z = ⟨ J , ⟨ A , Y ⟩ ⟩ ⇒ J = j $ by eq_sym [k1]
