ad: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R , z = ⟨ k , j ⟩ ⇒ ∀ d ∀ r (ra_cwf D t2 t3 t4 t5 c d z ∈ lrel3 J → c ∊ trees ω → d ∊ trees ω → r ∊ fseq u → cdm r = fv nvf d → scat r (scat Q R) ∈ sat u M c W → z ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat r (scat Q X)))} ∈ fv uni (lv t4 W)) $ by all_intro [ar]
ac: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R , z = ⟨ k , j ⟩ ⇒ ∀ c ∀ d ∀ r (ra_cwf D t2 t3 t4 t5 c d z ∈ lrel3 J → c ∊ trees ω → d ∊ trees ω → r ∊ fseq u → cdm r = fv nvf d → scat r (scat Q R) ∈ sat u M c W → z ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) z W (scat r (scat Q X)))} ∈ fv uni (lv t4 W)) $ by all_intro [ad]
c1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R , z = ⟨ k , j ⟩ ⇒ z ∊ b12_cgk J M u W D t2 t3 t4 t5 Q X R $ by cab_intro [ac]
c2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
c3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ b12_cgk J M u W D t2 t3 t4 t5 Q X R $ by wcel_intro [c2, c1]
c4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R ⇒ isset ⟨ k , j ⟩ $ by opair_isset
c5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R ⇒ ⟨ k , j ⟩ ∈ b12_cgk J M u W D t2 t3 t4 t5 Q X R $ by isset_elim [c4, c3]
c6: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R → ⟨ k , j ⟩ ∈ b12_cgk J M u W D t2 t3 t4 t5 Q X R $ by imp_intro [c5]
c7: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R → ⟨ k , j ⟩ ∈ b12_cgk J M u W D t2 t3 t4 t5 Q X R $ by imp_intro [c6]
c8: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R → ⟨ k , j ⟩ ∈ b12_cgk J M u W D t2 t3 t4 t5 Q X R $ by imp_intro [c7]
c9: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R → ⟨ k , j ⟩ ∈ b12_cgk J M u W D t2 t3 t4 t5 Q X R) $ by all_intro [c8]
c10: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R → ⟨ k , j ⟩ ∈ b12_cgk J M u W D t2 t3 t4 t5 Q X R) $ by all_intro [c9]
c11: $ G ⇒ isset ω $ by omega_set
c12: $ G ⇒ trees ω ⊆ b12_cgk J M u W D t2 t3 t4 t5 Q X R $ by trees_ind_c [c11, c10]
c13: $ G ⇒ t0 ∊ b12_cgk J M u W D t2 t3 t4 t5 Q X R $ by subset_elim [c12, #28]
d0: $ G ⇒ ∀ c ∀ d ∀ r (ra_cwf D t2 t3 t4 t5 c d t0 ∈ lrel3 J → c ∊ trees ω → d ∊ trees ω → r ∊ fseq u → cdm r = fv nvf d → scat r (scat Q R) ∈ sat u M c W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat r (scat Q X)))} ∈ fv uni (lv t4 W)) $ by cab_elim [c13]
d1: $ G ⇒ ∀ d ∀ r (ra_cwf D t2 t3 t4 t5 c0 d t0 ∈ lrel3 J → c0 ∊ trees ω → d ∊ trees ω → r ∊ fseq u → cdm r = fv nvf d → scat r (scat Q R) ∈ sat u M c0 W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat r (scat Q X)))} ∈ fv uni (lv t4 W)) $ by all_elim [d0]
d2: $ G ⇒ ∀ r (ra_cwf D t2 t3 t4 t5 c0 d0 t0 ∈ lrel3 J → c0 ∊ trees ω → d0 ∊ trees ω → r ∊ fseq u → cdm r = fv nvf d0 → scat r (scat Q R) ∈ sat u M c0 W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat r (scat Q X)))} ∈ fv uni (lv t4 W)) $ by all_elim [d1]
d3: $ G ⇒ ra_cwf D t2 t3 t4 t5 c0 d0 t0 ∈ lrel3 J → c0 ∊ trees ω → d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat Q R) ∈ sat u M c0 W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by all_elim [d2]
e0: $ G ⇒ c0 ∊ trees ω → d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat Q R) ∈ sat u M c0 W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by imp_elim [d3, #21]
e1: $ G ⇒ d0 ∊ trees ω → f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat Q R) ∈ sat u M c0 W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by imp_elim [e0, #22]
e2: $ G ⇒ f0 ∊ fseq u → cdm f0 = fv nvf d0 → scat f0 (scat Q R) ∈ sat u M c0 W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by imp_elim [e1, #23]
e3: $ G ⇒ cdm f0 = fv nvf d0 → scat f0 (scat Q R) ∈ sat u M c0 W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by imp_elim [e2, #24]
e4: $ G ⇒ scat f0 (scat Q R) ∈ sat u M c0 W → t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by imp_elim [e3, #25]
e5: $ G ⇒ t0 ∊ ofsort lsig lopen ks_expr → {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by imp_elim [e4, #26]
e6: $ G ⇒ {g | ∃ f ∃ t ∃ a (⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 W (scat f0 (scat Q X)))} ∈ fv uni (lv t4 W) $ by imp_elim [e5, #27]

def b12_sub (H J D W R P T Q S U K n p l i v b c d h: class): fml = $ Q ∈ fseq U ∧ cdm Q = fv nvf p ∧ R ∈ fseq U ∧ ixs D W (isup (ijs U (dnf U (mcv H)) D W) S) ∈ fseq U ∧ v ∈ fseq U ∧ cdm v = fv nvf n ∧ b6_vt U (mcv H) W D v ∧ b6_cond D p (ixs D W (isup (ijs U (dnf U (mcv H)) D W) S)) (scat v R) ∧ ra_ind_data D b P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ P ∈ ofsort lsig lopen ks_ctx ∧ ra_clen P p ∈ lrel ∧ ilev D W = lv l W ∧ b12_bnd D p (ixs D W (isup (ijs U (dnf U (mcv H)) D W) S)) S ∧ b12_ne D p (scat v R) ∧ ra_cwf D n p l i c d K ∈ lrel3 J ∧ c ∈ trees ω ∧ d ∈ trees ω ∧ h = ∅ ∧ cdm h = fv nvf d ∧ scat h (scat Q R) ∈ sat U (mcv H) c W ∧ K ∈ ofsort lsig lopen ks_expr ∧ K ∈ trees ω $

def b15_dat (J c d b P T np n m g2 l f e k: class): fml = $ ra_ind_data d b P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n m ∈ lrel ∧ ra_capp P c g2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ f e ∈ lrel ∧ ra_isort f k l ∈ lrel ∧ ra_tys_wf d n np l ⟨ kc_nz , ∅ ⟩ g2 T ∈ lrel3 J $

lemma b15_sort_trees (G: hyps) (D K: class): $ G ⇒ D ∈ ofsort lsig lopen K $ > $ G ⇒ D ∈ trees ω $
----
q1: $ … ⇒ isset D $ by wcel_isset [#1]
q2: $ G , x = D ⇒ x = D $ by ax
q3: $ … ⇒ D = x $ by eq_sym [q2]
q4: $ G , x = D ⇒ D ∈ ofsort lsig lopen K $ by weaken [#1]
q5: $ … ⇒ x ∈ ofsort lsig lopen K $ by wcel_eq_l [q3, q4]
q6: $ … ⇒ x ∊ ofsort lsig lopen K $ by wcel_welc [q5]
q7: $ … ⇒ x ∈ trees ω $ by lsig_ofsort_trees [q6]
q8: $ … ⇒ D ∈ trees ω $ by wcel_eq_l [q2, q7]
q9: $ … ⇒ D ∈ trees ω $ by isset_elim [q1, q8]

lemma b15_intys (G: hyps) (D: class) (tb tP tT tn tm0: set): $ G ⇒ ra_ind_data D tb tP tT ∈ lrel $ > $ G ⇒ ra_ntys tT tn tm0 ∈ lrel $ > $ G ⇒ intys D = fv nvf tn $
----
q1: $ G ⇒ kr_ind_data ∈ ω $ by kr_ind_data_omega
q2: $ … ⇒ isset kr_ind_data $ by wcel_isset [q1]
q3: $ … ⇒ D ∈ trees ω ∧ tb ∈ trees ω ∧ tP ∈ trees ω ∧ tT ∈ trees ω $ by lrel_args4_c [#1, q2]
q4: $ … ⇒ D ∈ trees ω $ by and_elim_l [q3]
q5: $ … ⇒ isset D $ by wcel_isset [q4]
q6: $ G , x = D ⇒ x = D $ by ax
q7: $ … ⇒ D = x $ by eq_sym [q6]
q8: $ G , x = D ⇒ tb = tb $ by eq_refl
q9: $ G , x = D ⇒ tP = tP $ by eq_refl
q10: $ G , x = D ⇒ tT = tT $ by eq_refl
q11: $ … ⇒ ra_ind_data D tb tP tT = ra_ind_data x tb tP tT $ by ra_ind_data_eq [q7, q8, q9, q10]
q12: $ G , x = D ⇒ ra_ind_data D tb tP tT ∈ lrel $ by weaken [#1]
q13: $ … ⇒ ra_ind_data x tb tP tT ∈ lrel $ by wcel_eq_l [q11, q12]
q14: $ G , x = D ⇒ ra_ntys tT tn tm0 ∈ lrel $ by weaken [#2]
q15: $ … ⇒ intys x = fv nvf tn $ by b6_intys [q13, q14]
q16: $ … ⇒ intys D = intys x $ by intys_eq [q7]
q17: $ … ⇒ intys D = fv nvf tn $ by eq_trans [q16, q15]
q18: $ … ⇒ intys D = fv nvf tn $ by isset_elim [q5, q17]

lemma b15_ilev (G: hyps) (D W: class) (tb tP tT tf te tk tl: set): $ G ⇒ ra_ind_data D tb tP tT ∈ lrel $ > $ G ⇒ ra_nth_ty tT ⟨ kc_nz , ∅ ⟩ tf te ∈ lrel $ > $ G ⇒ ra_isort tf tk tl ∈ lrel $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ ilev D W = lv tl W $
----
q1: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
q2: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ z = ⟨ kc_nz , ∅ ⟩ $ by ax
q3: $ … ⇒ ⟨ kc_nz , ∅ ⟩ = z $ by eq_sym [q2]
q4: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ ∈ ofsort lsig lopen ks_nat $ by b6_so_nz
q5: $ … ⇒ z ∈ ofsort lsig lopen ks_nat $ by wcel_eq_l [q3, q4]
q6: $ … ⇒ z ∊ ofsort lsig lopen ks_nat $ by wcel_welc [q5]
q7: $ … ⇒ z ∈ trees ω $ by lsig_ofsort_trees [q6]
q8: $ … ⇒ z ∊ trees ω $ by wcel_welc [q7]
q9: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
q10: $ … ⇒ fv nvf z = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [q9, q2]
q11: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
q12: $ … ⇒ fv nvf z = ∅ $ by eq_trans [q10, q11]
q13: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ind_data D tb tP tT ∈ lrel $ by weaken [#1]
q14: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ iprt D tP tT $ by ex_intro [q13]
q15: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ tT = tT $ by eq_refl
q16: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ tf = tf $ by eq_refl
q17: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ te = te $ by eq_refl
q18: $ … ⇒ ra_nth_ty tT ⟨ kc_nz , ∅ ⟩ tf te = ra_nth_ty tT z tf te $ by ra_nth_ty_eq [q15, q3, q16, q17]
q19: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_nth_ty tT ⟨ kc_nz , ∅ ⟩ tf te ∈ lrel $ by weaken [#2]
q20: $ … ⇒ ra_nth_ty tT z tf te ∈ lrel $ by wcel_eq_l [q18, q19]
q21: $ … ⇒ ityf D ∅ tf $ by ityf_intro [q14, q12, q20]
q22: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ ra_isort tf tk tl ∈ lrel $ by weaken [#3]
q23: $ G , z = ⟨ kc_nz , ∅ ⟩ ⇒ W ∈ lvals $ by weaken [#4]
q24: $ … ⇒ ilev D W = lv tl W $ by ilev_eq [q21, q22, q23]
q25: $ … ⇒ ilev D W = lv tl W $ by isset_elim [q1, q24]

lemma b15_su (G: hyps) (H J C D W R S: class) (u tl: set): $ G ⇒ iwf u H J C D W R $ > $ G ⇒ ilev D W = lv tl W $ > $ G ⇒ S ∈ fv uni (ilev D W) $ > $ G ⇒ S ∈ u $
----
q1: $ … ⇒ uadm u $ by iwf_uadm [#1]
q2: $ … ⇒ W ∈ lvals $ by iwf_lvals [#1]
q3: $ … ⇒ isset W $ by wcel_isset [q2]
q4: $ G , w = W ⇒ w = W $ by ax
q5: $ … ⇒ W = w $ by eq_sym [q4]
q6: $ G , w = W ⇒ W ∈ lvals $ by weaken [q2]
q7: $ … ⇒ w ∈ lvals $ by wcel_eq_l [q5, q6]
q8: $ … ⇒ w ∊ lvals $ by wcel_welc [q7]
q9: $ G , w = W ⇒ isset tl $ by isset_var
q10: $ … ⇒ lv tl w ∈ ω $ by lv_omega [q9, q8]
q11: $ G , w = W ⇒ tl = tl $ by eq_refl
q12: $ … ⇒ lv tl w = lv tl W $ by lv_eq [q11, q4]
q13: $ … ⇒ lv tl W ∈ ω $ by wcel_eq_l [q12, q10]
q14: $ … ⇒ lv tl W ∈ ω $ by isset_elim [q3, q13]
q15: $ … ⇒ lv tl W = ilev D W $ by eq_sym [#2]
q16: $ … ⇒ ilev D W ∈ ω $ by wcel_eq_l [q15, q14]
q17: $ … ⇒ fv uni (ilev D W) ∈ u $ by uadm_uni_c [q1, q16]
q18: $ … ⇒ universe u $ by uadm_universe [q1]
q19: $ … ⇒ fv uni (ilev D W) ⊆ u $ by universe_elem_subset_c [q18, q17]
q20: $ … ⇒ S ∈ u $ by wcel_subset [q19, #3]

lemma b15_q (G: hyps) (M W Q: class) (u tP tnp: set): $ G ⇒ Q ∈ esat u (dnf u M) tP W $ > $ G ⇒ ra_clen tP tnp ∈ lrel $ > $ G ⇒ cdm Q = fv nvf tnp $
----
q1: $ … ⇒ isset Q $ by wcel_isset [#1]
q2: $ G ⇒ kr_clen ∈ ω $ by kr_clen_omega
q3: $ … ⇒ isset kr_clen $ by wcel_isset [q2]
q4: $ … ⇒ tP ∊ trees ω ∧ tnp ∊ trees ω $ by lrel_args2 [#2, q3]
q5: $ … ⇒ tP ∊ trees ω $ by and_elim_l [q4]
q6: $ … ⇒ tnp ∊ trees ω $ by and_elim_r [q4]
q7: $ G , q = Q ⇒ q = Q $ by ax
q8: $ … ⇒ Q = q $ by eq_sym [q7]
q9: $ G , q = Q ⇒ Q ∈ esat u (dnf u M) tP W $ by weaken [#1]
q10: $ … ⇒ q ∈ esat u (dnf u M) tP W $ by wcel_eq_l [q8, q9]
q11: $ … ⇒ q ∊ esat u (dnf u M) tP W $ by wcel_welc [q10]
q12: $ G , q = Q ⇒ ra_clen tP tnp ∈ lrel $ by weaken [#2]
q13: $ G , q = Q ⇒ tP ∊ trees ω $ by weaken [q5]
q14: $ … ⇒ cdm q = fv nvf tnp $ by esat_clen_c [q12, q13, q11]
q15: $ … ⇒ cdm Q = cdm q $ by cdm_eq [q8]
q16: $ … ⇒ cdm Q = fv nvf tnp $ by eq_trans [q15, q14]
q17: $ … ⇒ cdm Q = fv nvf tnp $ by isset_elim [q1, q16]

lemma b15_z (G: hyps) (M D W S: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ S ∈ u $ > $ G ⇒ isup (ijs u (dnf u M) D W) S ∈ u ∧ isup (ijs u (dnf u M) D W) S ⊆ ω × (fseq u × u) $
----
q1: $ … ⇒ universe u $ by uadm_universe [#1]
q2: $ … ⇒ itc u (dnf u M) D W ∈ u $ by itc_universe [#1, #2, #3]
q3: $ G ⇒ ijs u (dnf u M) D W ⊆ itc u (dnf u M) D W $ by ijs_sub
q4: $ … ⇒ ijs u (dnf u M) D W ∈ u $ by universe_subset_c [q1, q2, q3]
q5: $ … ⇒ isup (ijs u (dnf u M) D W) S ∈ u $ by isup_universe [q1, q4, #4]
q6: $ G ⇒ itc u (dnf u M) D W ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by itc_sub
q7: $ … ⇒ ijs u (dnf u M) D W ⊆ ω × (fseq u × fseq (ω ∪ u)) $ by subset_trans [q3, q6]
q8: $ … ⇒ S ⊆ u $ by universe_elem_subset_c [q1, #4]
q9: $ … ⇒ isup (ijs u (dnf u M) D W) S ⊆ ω × (fseq u × u) $ by b7_isup_sub2 [q7, q8]
q10: $ … ⇒ isup (ijs u (dnf u M) D W) S ∈ u ∧ isup (ijs u (dnf u M) D W) S ⊆ ω × (fseq u × u) $ by and_intro [q5, q9]

lemma b15_xr (G: hyps) (M D W S: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ S ∈ u $ > $ G ⇒ ixs D W (isup (ijs u (dnf u M) D W) S) ∈ fseq u $
----
q1: $ … ⇒ isup (ijs u (dnf u M) D W) S ∈ u ∧ isup (ijs u (dnf u M) D W) S ⊆ ω × (fseq u × u) $ by b15_z [#1, #2, #3, #4]
q2: $ … ⇒ isup (ijs u (dnf u M) D W) S ∈ u $ by and_elim_l [q1]
q3: $ … ⇒ isup (ijs u (dnf u M) D W) S ⊆ ω × (fseq u × u) $ by and_elim_r [q1]
q4: $ … ⇒ universe u $ by uadm_universe [#1]
q5: $ … ⇒ ient D W (isup (ijs u (dnf u M) D W) S) j ∈ u $ by b7_ient_universe [q4, q2, q3]
q6: $ G , j ∊ intys D ⇒ ient D W (isup (ijs u (dnf u M) D W) S) j ∈ u $ by weaken [q5]
q7: $ … ⇒ j ∊ intys D → ient D W (isup (ijs u (dnf u M) D W) S) j ∈ u $ by imp_intro [q6]
q8: $ … ⇒ ∀ j (j ∊ intys D → ient D W (isup (ijs u (dnf u M) D W) S) j ∈ u) $ by all_intro [q7]
q9: $ G ⇒ intys D ∈ ω $ by intys_omega
q10: $ … ⇒ ixs D W (isup (ijs u (dnf u M) D W) S) ∈ fseq u $ by ixs_fseq [q8, q9]

lemma b15_vals {v i: set} (G: hyps) (M D W: class) (u: set): $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ ∃ v (v ∊ fseq u ∧ cdm v = intys D ∧ ∀ i (i ∊ intys D → fv v i = ityv u (dnf u M) D i W)) $
----
q1: $ … ⇒ isset D $ by wcel_isset [#2]
q2: $ … ⇒ isset W $ by wcel_isset [#3]
q3: $ G , x5 = D ⇒ x5 = D $ by ax
q4: $ … ⇒ D = x5 $ by eq_sym [q3]
q5: $ G , x5 = D , w = W ⇒ w = W $ by ax
q6: $ … ⇒ W = w $ by eq_sym [q5]
q7: $ G , x5 = D , w = W ⇒ W ∈ lvals $ by weaken [#3]
q8: $ … ⇒ w ∈ lvals $ by wcel_eq_l [q6, q7]
q9: $ … ⇒ w ∊ lvals $ by wcel_welc [q8]
q10: $ G , x5 = D , w = W ⇒ D = x5 $ by weaken [q4]
q11: $ G , x5 = D , w = W ⇒ D ∈ ofsort lsig lopen ks_ind $ by weaken [#2]
q12: $ … ⇒ x5 ∈ ofsort lsig lopen ks_ind $ by wcel_eq_l [q10, q11]
q13: $ G , x5 = D , w = W ⇒ uadm u $ by weaken [#1]
q14: $ … ⇒ cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) ∈ fseq u ∧ cdm (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) = intys x5 ∧ ∀ x4 (x4 ∊ intys x5 → fv (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) x4 = ityv u (dnf u M) x5 x4 w) $ by b6_vals [q13, q12, q9]
q15: $ … ⇒ cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) ∈ fseq u $ by and_elim_l [q14]
q16: $ … ⇒ cdm (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) = intys x5 ∧ ∀ x4 (x4 ∊ intys x5 → fv (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) x4 = ityv u (dnf u M) x5 x4 w) $ by and_elim_r [q14]
q17: $ … ⇒ cdm (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) = intys x5 $ by and_elim_l [q16]
q18: $ … ⇒ ∀ x4 (x4 ∊ intys x5 → fv (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) x4 = ityv u (dnf u M) x5 x4 w) $ by and_elim_r [q16]
q19: $ … ⇒ isset (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) $ by wcel_isset [q15]
q20: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) ⇒ z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) $ by ax
q21: $ … ⇒ cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) = z $ by eq_sym [q20]
q22: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) ⇒ cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) ∈ fseq u $ by weaken [q15]
q23: $ … ⇒ z ∈ fseq u $ by wcel_eq_l [q21, q22]
q24: $ … ⇒ z ∊ fseq u $ by wcel_welc [q23]
q25: $ … ⇒ cdm z = cdm (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) $ by cdm_eq [q20]
q26: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) ⇒ x5 = D $ by ax
q27: $ … ⇒ intys x5 = intys D $ by intys_eq [q26]
q28: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) ⇒ cdm (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) = intys x5 $ by weaken [q17]
q29: $ … ⇒ cdm z = intys x5 $ by eq_trans [q25, q28]
q30: $ … ⇒ cdm z = intys D $ by eq_trans [q29, q27]
q31: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) , i ∊ intys D ⇒ intys x5 = intys D $ by weaken [q27]
q32: $ … ⇒ intys D = intys x5 $ by eq_sym [q31]
q33: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) , i ∊ intys D ⇒ i ∊ intys D $ by ax
q34: $ … ⇒ i ∊ intys x5 $ by welc_eq [q32, q33]
q35: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) , i ∊ intys D ⇒ ∀ x4 (x4 ∊ intys x5 → fv (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) x4 = ityv u (dnf u M) x5 x4 w) $ by weaken [q18]
q36: $ … ⇒ i ∊ intys x5 → fv (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) i = ityv u (dnf u M) x5 i w $ by all_elim [q35]
q37: $ … ⇒ fv (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) i = ityv u (dnf u M) x5 i w $ by imp_elim [q36, q34]
q38: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) , i ∊ intys D ⇒ i = i $ by eq_refl
q39: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) , i ∊ intys D ⇒ z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) $ by ax
q40: $ … ⇒ fv z i = fv (cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5)) i $ by fv_eq [q39, q38]
q41: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) , i ∊ intys D ⇒ x5 = D $ by ax
q42: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) , i ∊ intys D ⇒ w = W $ by ax
q43: $ … ⇒ ityv u (dnf u M) x5 i w = ityv u (dnf u M) D i W $ by ityv_eq [q41, q38, q42]
q44: $ … ⇒ fv z i = ityv u (dnf u M) x5 i w $ by eq_trans [q40, q37]
q45: $ … ⇒ fv z i = ityv u (dnf u M) D i W $ by eq_trans [q44, q43]
q46: $ … ⇒ i ∊ intys D → fv z i = ityv u (dnf u M) D i W $ by imp_intro [q45]
q47: $ … ⇒ ∀ i (i ∊ intys D → fv z i = ityv u (dnf u M) D i W) $ by all_intro [q46]
q48: $ … ⇒ cdm z = intys D ∧ ∀ i (i ∊ intys D → fv z i = ityv u (dnf u M) D i W) $ by and_intro [q30, q47]
q49: $ … ⇒ z ∊ fseq u ∧ cdm z = intys D ∧ ∀ i (i ∊ intys D → fv z i = ityv u (dnf u M) D i W) $ by and_intro [q24, q48]
q50: $ G , x5 = D , w = W , z = cres (cgr x3 (ityv u (dnf u M) x5 x3 w)) (intys x5) ⇒ ∃ v (v ∊ fseq u ∧ cdm v = intys D ∧ ∀ i (i ∊ intys D → fv v i = ityv u (dnf u M) D i W)) $ by ex_intro [q49]
q51: $ … ⇒ ∃ v (v ∊ fseq u ∧ cdm v = intys D ∧ ∀ i (i ∊ intys D → fv v i = ityv u (dnf u M) D i W)) $ by isset_elim [q19, q50]
q52: $ G , x5 = D ⇒ isset W $ by weaken [q2]
q53: $ … ⇒ ∃ v (v ∊ fseq u ∧ cdm v = intys D ∧ ∀ i (i ∊ intys D → fv v i = ityv u (dnf u M) D i W)) $ by isset_elim [q52, q51]
q54: $ … ⇒ ∃ v (v ∊ fseq u ∧ cdm v = intys D ∧ ∀ i (i ∊ intys D → fv v i = ityv u (dnf u M) D i W)) $ by isset_elim [q1, q53]

lemma b15_vt {i: set} (G: hyps i) (H D W: class) (u tv: set): $ G ⇒ hty ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ uadm u $ > $ G ⇒ D ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ cdm tv = intys D $ > $ G ⇒ ∀ i (i ∊ intys D → fv tv i = ityv u (dnf u (mcv H)) D i W) $ > $ G ⇒ b6_vt u (mcv H) W D tv $
----
q1: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ cdm tv = intys D $ by weaken [#6]
q2: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ x1 ∊ cdm tv $ by ax
q3: $ … ⇒ x1 ∊ intys D $ by welc_eq [q1, q2]
q4: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ ∀ i (i ∊ intys D → fv tv i = ityv u (dnf u (mcv H)) D i W) $ by weaken [#7]
q5: $ … ⇒ x1 ∊ intys D → fv tv x1 = ityv u (dnf u (mcv H)) D x1 W $ by all_elim [q4]
q6: $ … ⇒ fv tv x1 = ityv u (dnf u (mcv H)) D x1 W $ by imp_elim [q5, q3]
q7: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ D ∈ ofsort lsig lopen ks_ind $ by weaken [#4]
q8: $ … ⇒ D ∈ trees ω $ by b15_sort_trees [q7]
q9: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ x2 ∊ trees ω $ by ax
q10: $ … ⇒ x2 ∈ trees ω $ by welc_wcel [q9]
q11: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ ∅ ∈ fseq u $ by fseq_empty
q12: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ hty ⊆ H $ by weaken [#1]
q13: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ functional H $ by weaken [#2]
q14: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ W ∈ lvals $ by weaken [#5]
q15: $ … ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = mclip u (ityv u (dnf u (mcv H)) D (fv nvf x2) W) $ by dt_ind_ty_c [q12, q13, q8, q10, q14, q11]
q16: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ uadm u $ by weaken [#3]
q17: $ … ⇒ ityv u (dnf u (mcv H)) D (fv nvf x2) W ∈ u $ by ityv_universe [q16, q7, q14]
q18: $ … ⇒ mclip u (ityv u (dnf u (mcv H)) D (fv nvf x2) W) = ityv u (dnf u (mcv H)) D (fv nvf x2) W $ by mclip_in [q17]
q19: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ D = D $ by eq_refl
q20: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ W = W $ by eq_refl
q21: $ G , x1 ∊ cdm tv , x2 ∊ trees ω , fv nvf x2 = x1 ⇒ fv nvf x2 = x1 $ by ax
q22: $ … ⇒ ityv u (dnf u (mcv H)) D (fv nvf x2) W = ityv u (dnf u (mcv H)) D x1 W $ by ityv_eq [q19, q21, q20]
q23: $ … ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = ityv u (dnf u (mcv H)) D (fv nvf x2) W $ by eq_trans [q15, q18]
q24: $ … ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = ityv u (dnf u (mcv H)) D x1 W $ by eq_trans [q23, q22]
q25: $ … ⇒ ityv u (dnf u (mcv H)) D x1 W = fv tv x1 $ by eq_sym [q6]
q26: $ … ⇒ dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = fv tv x1 $ by eq_trans [q24, q25]
q27: $ … ⇒ fv nvf x2 = x1 → dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = fv tv x1 $ by imp_intro [q26]
q28: $ … ⇒ x2 ∊ trees ω → fv nvf x2 = x1 → dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = fv tv x1 $ by imp_intro [q27]
q29: $ … ⇒ x1 ∊ cdm tv → x2 ∊ trees ω → fv nvf x2 = x1 → dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = fv tv x1 $ by imp_intro [q28]
q30: $ … ⇒ ∀ x2 (x1 ∊ cdm tv → x2 ∊ trees ω → fv nvf x2 = x1 → dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = fv tv x1) $ by all_intro [q29]
q31: $ … ⇒ ∀ x1 ∀ x2 (x1 ∊ cdm tv → x2 ∊ trees ω → fv nvf x2 = x1 → dt u (mcv H) ⟨ kc_ind_ty , scons D (scons x2 ∅) ⟩ W ∅ = fv tv x1) $ by all_intro [q30]
q32: $ G ⇒ b6_vt u (mcv H) W D tv $ by weaken [q31]

lemma b15_ijs_el {y: set} (G: hyps) (E D W: class) (u tj tq: set): $ G ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ∈ ijs u E D W $ > $ G ⇒ igate u E D tj W → ∃ y (⟨ tj , ⟨ tq , y ⟩ ⟩ ∈ ifam u E D W) $
----
q1: $ G ⇒ isset ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ $ by opair_isset
q2: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ⇒ z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ $ by ax
q3: $ … ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ = z $ by eq_sym [q2]
q4: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ∈ ijs u E D W $ by weaken [#1]
q5: $ … ⇒ z ∈ ijs u E D W $ by wcel_eq_l [q3, q4]
q6: $ … ⇒ z ∊ ijs u E D W $ by wcel_welc [q5]
q7: $ … ⇒ z ∈ itc u E D W ∧ ∃ j ∃ a (z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W))) $ by cab_elim [q6]
q8: $ … ⇒ z ∈ itc u E D W $ by and_elim_l [q7]
q9: $ … ⇒ ∃ j ∃ a (z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W))) $ by and_elim_r [q7]
q10: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) $ by ax
q11: $ … ⇒ z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ $ by and_elim_l [q10]
q12: $ … ⇒ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) $ by and_elim_r [q10]
q13: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ = z $ by weaken [q3]
q14: $ … ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ $ by eq_trans [q13, q11]
q15: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset ∅ $ by ax_empty
q16: $ … ⇒ isset (scons ∅ ∅) $ by scons_set [q15]
q17: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset ⟨ tq , scons ∅ ∅ ⟩ $ by opair_isset
q18: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset ⟨ a , scons ∅ ∅ ⟩ $ by opair_isset
q19: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset tj $ by isset_var
q20: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset j $ by isset_var
q21: $ … ⇒ tj = j ∧ ⟨ tq , scons ∅ ∅ ⟩ = ⟨ a , scons ∅ ∅ ⟩ $ by opair_inj_c [q14, q19, q17, q20, q18]
q22: $ … ⇒ tj = j $ by and_elim_l [q21]
q23: $ … ⇒ ⟨ tq , scons ∅ ∅ ⟩ = ⟨ a , scons ∅ ∅ ⟩ $ by and_elim_r [q21]
q24: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset tq $ by isset_var
q25: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset a $ by isset_var
q26: $ … ⇒ tq = a ∧ scons ∅ ∅ = scons ∅ ∅ $ by opair_inj_c [q23, q24, q16, q25, q16]
q27: $ … ⇒ tq = a $ by and_elim_l [q26]
q28: $ … ⇒ scons ∅ ∅ = scons ∅ ∅ $ by and_elim_r [q26]
q29: $ … ⇒ j = tj $ by eq_sym [q22]
q30: $ … ⇒ a = tq $ by eq_sym [q27]
q31: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W)) ⇒ igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W) $ by weaken [q12]
q32: $ … ⇒ igate u E D tj W → ∃ y (⟨ tj , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W) $ by eq_subst [q29, q31]
q33: $ … ⇒ igate u E D tj W → ∃ y (⟨ tj , ⟨ tq , y ⟩ ⟩ ∈ ifam u E D W) $ by eq_subst [q30, q32]
q34: $ G , z = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ , ∃ a (z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W))) ⇒ ∃ a (z = ⟨ j , ⟨ a , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D j W → ∃ y (⟨ j , ⟨ a , y ⟩ ⟩ ∈ ifam u E D W))) $ by ax
q35: $ … ⇒ igate u E D tj W → ∃ y (⟨ tj , ⟨ tq , y ⟩ ⟩ ∈ ifam u E D W) $ by ex_elim [q34, q33]
q36: $ … ⇒ igate u E D tj W → ∃ y (⟨ tj , ⟨ tq , y ⟩ ⟩ ∈ ifam u E D W) $ by ex_elim [q9, q35]
q37: $ … ⇒ igate u E D tj W → ∃ y (⟨ tj , ⟨ tq , y ⟩ ⟩ ∈ ifam u E D W) $ by isset_elim [q1, q36]

lemma b15_zpt (G: hyps) (E D W S: class) (u tj tq te: set): $ G ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ isup (ijs u E D W) S $ > $ G ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ∈ ijs u E D W ∧ te ∊ S $
----
q1: $ G ⇒ isset ⟨ tj , ⟨ tq , te ⟩ ⟩ $ by opair_isset
q2: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ ⇒ z = ⟨ tj , ⟨ tq , te ⟩ ⟩ $ by ax
q3: $ … ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ = z $ by eq_sym [q2]
q4: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ ∈ isup (ijs u E D W) S $ by weaken [#1]
q5: $ … ⇒ z ∈ isup (ijs u E D W) S $ by wcel_eq_l [q3, q4]
q6: $ … ⇒ z ∊ isup (ijs u E D W) S $ by wcel_welc [q5]
q7: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ = z $ by weaken [q3]
q8: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ z = ⟨ j , ⟨ a , y ⟩ ⟩ $ by ax
q9: $ … ⇒ ⟨ tj , ⟨ tq , te ⟩ ⟩ = ⟨ j , ⟨ a , y ⟩ ⟩ $ by eq_trans [q7, q8]
q10: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset ⟨ tq , te ⟩ $ by opair_isset
q11: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset ⟨ a , y ⟩ $ by opair_isset
q12: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset tj $ by isset_var
q13: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset j $ by isset_var
q14: $ … ⇒ tj = j ∧ ⟨ tq , te ⟩ = ⟨ a , y ⟩ $ by opair_inj_c [q9, q12, q10, q13, q11]
q15: $ … ⇒ tj = j $ by and_elim_l [q14]
q16: $ … ⇒ ⟨ tq , te ⟩ = ⟨ a , y ⟩ $ by and_elim_r [q14]
q17: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset tq $ by isset_var
q18: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset te $ by isset_var
q19: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset a $ by isset_var
q20: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset y $ by isset_var
q21: $ … ⇒ tq = a ∧ te = y $ by opair_inj_c [q16, q17, q18, q19, q20]
q22: $ … ⇒ tq = a $ by and_elim_l [q21]
q23: $ … ⇒ te = y $ by and_elim_r [q21]
q24: $ … ⇒ y = te $ by eq_sym [q23]
q25: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ y ∊ S $ by ax
q26: $ … ⇒ te ∊ S $ by welc_eq_set [q24, q25]
q27: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ isset ⟨ j , ⟨ a , x ⟩ ⟩ $ by opair_isset
q28: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ ⇒ x0 = ⟨ j , ⟨ a , x ⟩ ⟩ $ by ax
q29: $ … ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = x0 $ by eq_sym [q28]
q30: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W $ by ax
q31: $ … ⇒ x0 ∈ ijs u E D W $ by wcel_eq_l [q29, q30]
q32: $ … ⇒ x0 ∊ ijs u E D W $ by wcel_welc [q31]
q33: $ … ⇒ x0 ∈ itc u E D W ∧ ∃ x1 ∃ x2 (x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W))) $ by cab_elim [q32]
q34: $ … ⇒ x0 ∈ itc u E D W $ by and_elim_l [q33]
q35: $ … ⇒ ∃ x1 ∃ x2 (x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W))) $ by and_elim_r [q33]
q36: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) $ by ax
q37: $ … ⇒ x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ $ by and_elim_l [q36]
q38: $ … ⇒ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) $ by and_elim_r [q36]
q39: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = x0 $ by weaken [q29]
q40: $ … ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ $ by eq_trans [q39, q37]
q41: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset ∅ $ by ax_empty
q42: $ … ⇒ isset (scons ∅ ∅) $ by scons_set [q41]
q43: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset ⟨ a , x ⟩ $ by opair_isset
q44: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset ⟨ x2 , scons ∅ ∅ ⟩ $ by opair_isset
q45: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset j $ by isset_var
q46: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset x1 $ by isset_var
q47: $ … ⇒ j = x1 ∧ ⟨ a , x ⟩ = ⟨ x2 , scons ∅ ∅ ⟩ $ by opair_inj_c [q40, q45, q43, q46, q44]
q48: $ … ⇒ j = x1 $ by and_elim_l [q47]
q49: $ … ⇒ ⟨ a , x ⟩ = ⟨ x2 , scons ∅ ∅ ⟩ $ by and_elim_r [q47]
q50: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset a $ by isset_var
q51: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset x $ by isset_var
q52: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W)) ⇒ isset x2 $ by isset_var
q53: $ … ⇒ a = x2 ∧ x = scons ∅ ∅ $ by opair_inj_c [q49, q50, q51, q52, q42]
q54: $ … ⇒ a = x2 $ by and_elim_l [q53]
q55: $ … ⇒ x = scons ∅ ∅ $ by and_elim_r [q53]
q56: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ , x0 = ⟨ j , ⟨ a , x ⟩ ⟩ , ∃ x2 (x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W))) ⇒ ∃ x2 (x0 = ⟨ x1 , ⟨ x2 , scons ∅ ∅ ⟩ ⟩ ∧ (igate u E D x1 W → ∃ x3 (⟨ x1 , ⟨ x2 , x3 ⟩ ⟩ ∈ ifam u E D W))) $ by ax
q57: $ … ⇒ x = scons ∅ ∅ $ by ex_elim [q56, q55]
q58: $ … ⇒ x = scons ∅ ∅ $ by ex_elim [q35, q57]
q59: $ … ⇒ x = scons ∅ ∅ $ by isset_elim [q27, q58]
q60: $ … ⇒ j = tj $ by eq_sym [q15]
q61: $ … ⇒ a = tq $ by eq_sym [q22]
q62: $ … ⇒ ⟨ a , x ⟩ = ⟨ tq , scons ∅ ∅ ⟩ $ by opair_eq [q61, q59]
q63: $ … ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ = ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ $ by opair_eq [q60, q62]
q64: $ G , z = ⟨ tj , ⟨ tq , te ⟩ ⟩ , ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W , y ∊ S , z = ⟨ j , ⟨ a , y ⟩ ⟩ ⇒ ⟨ j , ⟨ a , x ⟩ ⟩ ∈ ijs u E D W $ by ax
q65: $ … ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ∈ ijs u E D W $ by wcel_eq_l [q63, q64]
q66: $ … ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ∈ ijs u E D W ∧ te ∊ S $ by and_intro [q65, q26]
q67: $ … ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ∈ ijs u E D W ∧ te ∊ S $ by isup_elim [q6, q66]
q68: $ … ⇒ ⟨ tj , ⟨ tq , scons ∅ ∅ ⟩ ⟩ ∈ ijs u E D W ∧ te ∊ S $ by isset_elim [q1, q67]

lemma b15_itc_el (G: hyps) (E D W: class) (u tj tz tx: set): $ G ⇒ ⟨ tj , ⟨ tz , tx ⟩ ⟩ ∈ itc u E D W $ > $ G ⇒ tx = scons ∅ ∅ $
----
q1: $ G ⇒ isset ⟨ tj , ⟨ tz , tx ⟩ ⟩ $ by opair_isset
q2: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ ⇒ z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ $ by ax
q3: $ … ⇒ ⟨ tj , ⟨ tz , tx ⟩ ⟩ = z $ by eq_sym [q2]
q4: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ ⇒ ⟨ tj , ⟨ tz , tx ⟩ ⟩ ∈ itc u E D W $ by weaken [#1]
q5: $ … ⇒ z ∈ itc u E D W $ by wcel_eq_l [q3, q4]
q6: $ … ⇒ z ∊ itc u E D W $ by wcel_welc [q5]
q7: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f W q , z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ ⇒ ⟨ tj , ⟨ tz , tx ⟩ ⟩ = z $ by weaken [q3]
q8: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f W q , z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ ⇒ z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ $ by ax
q9: $ … ⇒ ⟨ tj , ⟨ tz , tx ⟩ ⟩ = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ $ by eq_trans [q7, q8]
q10: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f W q , z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ ⇒ isset ⟨ tz , tx ⟩ $ by opair_isset
q11: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f W q , z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ ⇒ isset ⟨ scat x q , scons ∅ ∅ ⟩ $ by opair_isset
q12: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f W q , z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ ⇒ isset tj $ by isset_var
q13: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f W q , z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ ⇒ isset j $ by isset_var
q14: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f W q , z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ ⇒ isset tz $ by isset_var
q15: $ G , z = ⟨ tj , ⟨ tz , tx ⟩ ⟩ , iprt D p t , ityf D j f , q ∊ esat u E p W , ⟨ x , ⟨ g , ⟨ o , a ⟩ ⟩ ⟩ ∈ etel u E f W q , z = ⟨ j , ⟨ scat x q , scons ∅ ∅ ⟩ ⟩ ⇒ isset tx $ by isset_var
q16: $ … ⇒ tj = j ∧ ⟨ tz , tx ⟩ = ⟨ scat x q , scons ∅ ∅ ⟩ $ by opair_inj_c [q9, q12, q10, q13, q11]
q17: $ … ⇒ tj = j $ by and_elim_l [q16]
q18: $ … ⇒ ⟨ tz , tx ⟩ = ⟨ scat x q , scons ∅ ∅ ⟩ $ by and_elim_r [q16]
q19: $ … ⇒ ⟨ scat x q , scons ∅ ∅ ⟩ = ⟨ tz , tx ⟩ $ by eq_sym [q18]
q20: $ … ⇒ isset (scat x q) $ by opair_eq_isset [q19]
