def b11_nc_dp (U M W Y K: class) (.r .o: set): fml = $ ∀ r ∀ o (r ∊ fseq U → o ∊ fseq U → b9_ag r o K → dt U M Y W r = dt U M Y W o) $

def b11_nc_sg (U M W D X0 X Y N Q: class) (.a .s .h .b .v .c .g .t .e: set): fml = $ ∀ a ∀ s ∀ h (a ∊ fseq U → s ∊ fseq U → b9_ag a s (nadd N Q) → b9_hs D X0 a s (nadd N Q) X → swin a N Q = X0 → h ∊ dt U M Y W a → dt U M Y W s = csn (⋃ (dt U M Y W s)) ∧ ∀ b ∀ v (b ∊ fseq U → b9_ag a b (nadd N Q) → b9_hb D X0 a b (nadd N Q) v → ∅ ∈ v → ∀ c ∀ g ∀ t ∀ e (⟨ c , ⟨ g , ⟨ t , e ⟩ ⟩ ⟩ ∈ etel U (dnf U M) Y W a → nest c ⟨ ∅ , ∅ ⟩ ∈ ⋃ (dt U M Y W s) → apn h c ∈ X → apn h c ∈ v) → h ∈ dt U M Y W b)) $

lemma b11_nc_kid2 (G: hyps) (P K: class) (k j a b: set): $ G ⇒ crn j ⊆ P $ > $ G ⇒ ⟨ k , j ⟩ = ⟨ K , scons a (scons b ∅) ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ a ∈ P ∧ b ∈ P $
----
l1: $ G ⇒ isset k $ by isset_var
l2: $ G ⇒ isset j $ by isset_var
l3a: $ G ⇒ isset ∅ $ by ax_empty
l3b: $ … ⇒ isset (scons b ∅) $ by scons_set [l3a]
l3: $ … ⇒ isset (scons a (scons b ∅)) $ by scons_set [l3b]
l4: $ … ⇒ k = K ∧ j = scons a (scons b ∅) $ by opair_inj_c [#2, l1, l2, #3, l3]
l5: $ … ⇒ j = scons a (scons b ∅) $ by and_elim_r [l4]
l6: $ … ⇒ crn j = crn (scons a (scons b ∅)) $ by crn_eq [l5]
l7: $ … ⇒ crn (scons a (scons b ∅)) ⊆ P $ by subset_eq_l [l6, #1]
l8: $ G ⇒ isset a $ by isset_var
l9: $ … ⇒ a ∈ P $ by crn_scons_head [l8, l7]
l10: $ … ⇒ crn (scons b ∅) ⊆ P $ by crn_scons_tail [l7]
l11: $ G ⇒ isset b $ by isset_var
l12: $ … ⇒ b ∈ P $ by crn_scons_head [l11, l10]
l13: $ … ⇒ a ∈ P ∧ b ∈ P $ by and_intro [l9, l12]

