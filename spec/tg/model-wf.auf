--| `c ↦ nest c ⟨ ∅ , ∅ ⟩` is injective on sequences of any lengths.
lemma b11_sp_ninj (G: hyps) (c1 c2: set): $ G ⇒ c1 ∊ fseq b7_V $ > $ G ⇒ c2 ∊ fseq b7_V $ > $ G ⇒ nest c1 ⟨ ∅ , ∅ ⟩ = nest c2 ⟨ ∅ , ∅ ⟩ $ > $ G ⇒ c1 = c2 $
----
l1: $ … ⇒ cdm c1 ∈ ω $ by fseq_len [#1]
n1: $ G , n = cdm c1 , n ∊ ω ⇒ n = cdm c1 $ by ax
n2: $ G , n = cdm c1 , n ∊ ω ⇒ n ∊ ω $ by ax
bz: $ G , n = cdm c1 , n ∊ ω , z = ∅ ⇒ z = ∅ $ by ax
bq: $ G , n = cdm c1 , n ∊ ω , z = ∅ ⇒ b11_sp_nq z $ by b11_sp_nbase [bz]
sy: $ G , n = cdm c1 , n ∊ ω , y ∊ ω , b11_sp_nq y , z = suc y ⇒ b11_sp_nq y $ by ax
sz: $ G , n = cdm c1 , n ∊ ω , y ∊ ω , b11_sp_nq y , z = suc y ⇒ z = suc y $ by ax
sq: $ G , n = cdm c1 , n ∊ ω , y ∊ ω , b11_sp_nq y , z = suc y ⇒ b11_sp_nq z $ by b11_sp_nstep [sy, sz]
q0: $ G , n = cdm c1 , n ∊ ω ⇒ b11_sp_nq n $ by omega_ind_named [bq, sq, n2]
q1: $ G , n = cdm c1 , n ∊ ω ⇒ ∀ a ∀ b (a ∊ fseq b7_V → b ∊ fseq b7_V → cdm a = n → nest a ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → a = b) $ by weaken [q0]
q2: $ … ⇒ ∀ b (c1 ∊ fseq b7_V → b ∊ fseq b7_V → cdm c1 = n → nest c1 ⟨ ∅ , ∅ ⟩ = nest b ⟨ ∅ , ∅ ⟩ → c1 = b) $ by all_elim [q1]
q3: $ … ⇒ c1 ∊ fseq b7_V → c2 ∊ fseq b7_V → cdm c1 = n → nest c1 ⟨ ∅ , ∅ ⟩ = nest c2 ⟨ ∅ , ∅ ⟩ → c1 = c2 $ by all_elim [q2]
w683_h1: $ G , n = cdm c1 , n ∊ ω ⇒ c1 ∊ fseq b7_V $ by weaken [#1]
q4: $ … ⇒ c2 ∊ fseq b7_V → cdm c1 = n → nest c1 ⟨ ∅ , ∅ ⟩ = nest c2 ⟨ ∅ , ∅ ⟩ → c1 = c2 $ by imp_elim [q3, w683_h1]
w684_h2: $ G , n = cdm c1 , n ∊ ω ⇒ c2 ∊ fseq b7_V $ by weaken [#2]
q5: $ … ⇒ cdm c1 = n → nest c1 ⟨ ∅ , ∅ ⟩ = nest c2 ⟨ ∅ , ∅ ⟩ → c1 = c2 $ by imp_elim [q4, w684_h2]
n3: $ … ⇒ cdm c1 = n $ by eq_sym [n1]
q6: $ … ⇒ nest c1 ⟨ ∅ , ∅ ⟩ = nest c2 ⟨ ∅ , ∅ ⟩ → c1 = c2 $ by imp_elim [q5, n3]
w685_h3: $ G , n = cdm c1 , n ∊ ω ⇒ nest c1 ⟨ ∅ , ∅ ⟩ = nest c2 ⟨ ∅ , ∅ ⟩ $ by weaken [#3]
q7: $ … ⇒ c1 = c2 $ by imp_elim [q6, w685_h3]
zz: $ G ⇒ c1 = c2 $ by wcel_elim [l1, q7]

--| `A` is a point `⟨ d , nest c ⟨ ∅ , ∅ ⟩ ⟩` of the shape fields `S`, and `B` the fiber
--| of the fields `F` there, which is in `X`.
def b11_sp_kv (S F X A B: class) (.d .c: set): fml = $ ∃ d ∃ c (d ∊ ω ∧ c ∊ fseq b7_V ∧ nest c ⟨ ∅ , ∅ ⟩ ∈ fv S d ∧ apn (fv F d) c ∈ X ∧ A = ⟨ d , nest c ⟨ ∅ , ∅ ⟩ ⟩ ∧ B = apn (fv F d) c) $

--| The support function: the points of `S` to the fibers of `F` in `X`, and `∅` to `Y`
--| if `Y ∈ X`.
def b11_sp_O (S F X Y: class) (.y .d .c: set): class = $ {y | (∃ d ∃ c (d ∊ ω ∧ c ∊ fseq b7_V ∧ nest c ⟨ ∅ , ∅ ⟩ ∈ fv S d ∧ apn (fv F d) c ∈ X ∧ y = ⟨ ⟨ d , nest c ⟨ ∅ , ∅ ⟩ ⟩ , apn (fv F d) c ⟩)) ∨ (y = ⟨ ∅ , Y ⟩ ∧ Y ∈ X)} $

lemma b11_sp_oe (G: hyps) (S F X Y: class) (a0 b0: set): $ G ⇒ ⟨ a0 , b0 ⟩ ∈ b11_sp_O S F X Y $ > $ G ⇒ b11_sp_kv S F X a0 b0 ∨ (a0 = ∅ ∧ b0 = Y ∧ Y ∈ X) $
----
n1: $ G , n = ⟨ a0 , b0 ⟩ , n ∊ b11_sp_O S F X Y ⇒ n = ⟨ a0 , b0 ⟩ $ by ax
n2: $ G , n = ⟨ a0 , b0 ⟩ , n ∊ b11_sp_O S F X Y ⇒ n ∊ b11_sp_O S F X Y $ by ax
n3: $ G , n = ⟨ a0 , b0 ⟩ , n ∊ b11_sp_O S F X Y ⇒ (∃ d ∃ c (d ∊ ω ∧ c ∊ fseq b7_V ∧ nest c ⟨ ∅ , ∅ ⟩ ∈ fv S d ∧ apn (fv F d) c ∈ X ∧ n = ⟨ ⟨ d , nest c ⟨ ∅ , ∅ ⟩ ⟩ , apn (fv F d) c ⟩)) ∨ (n = ⟨ ∅ , Y ⟩ ∧ Y ∈ X) $ by cab_elim [n2]
n4: $ … ⇒ ⟨ a0 , b0 ⟩ = n $ by eq_sym [n1]
ia: $ G , n = ⟨ a0 , b0 ⟩ , n ∊ b11_sp_O S F X Y ⇒ isset a0 $ by isset_var
ib: $ G , n = ⟨ a0 , b0 ⟩ , n ∊ b11_sp_O S F X Y ⇒ isset b0 $ by isset_var
