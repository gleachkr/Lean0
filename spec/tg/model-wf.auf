lemma b15_inv {y1 y2 y3 y4 y5 y6 y7 y8 y9 ya yb: set} (G: hyps) (J: class) (tc td: set): $ G ⇒ ra_ind_wf tc td ∈ lrel3 J $ > $ G ⇒ ∃ y1 ∃ y2 ∃ y3 ∃ y4 ∃ y5 ∃ y6 ∃ y7 ∃ y8 ∃ y9 ∃ ya ∃ yb (b15_dat J tc td y1 y2 y3 y4 y5 y6 y7 y8 y9 ya yb) $
----
q1: $ … ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ b ∃ p ∃ x3 ∃ t ∃ x4 ∃ n ∃ m ∃ k ∃ x5 ∃ l ∃ f ∃ c (tc = x0 ∧ td = x2 ∧ ra_tys_ok x0 x2 ∈ lrel3 J ∧ ra_ind_data x2 b p t ∈ lrel ∧ ra_clen p x4 ∈ lrel ∧ ra_ntys t n m ∈ lrel ∧ ra_capp p x0 x1 ∈ lrel ∧ ra_nth_ty t ⟨ kc_nz , ∅ ⟩ f c ∈ lrel ∧ ra_isort f k l ∈ lrel ∧ ra_tys_wf x2 n x4 l ⟨ kc_nz , ∅ ⟩ x1 t ∈ lrel3 J ∧ ra_ind_nested x2 x3 ∈ lrel ∧ ra_ndecl x3 n x5 ∈ lrel ∧ ra_nst_ok x0 x2 x5 x3 ∈ lrel3 J) $ by lrel3_ind_wf_cases [#1]
