p6f: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ swin a (fv nvf t4) (fv nvf t3) ∈ fseq b7_V $ by b7_fseqV [p6e]
p6g: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ x ∈ fseq b7_V $ by welc_wcel [p2]
p6h: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ scat x (swin a (fv nvf t4) (fv nvf t3)) ∈ fseq b7_V $ by scat_fseq_c [p6g, p6f]
p6i: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ isset (scat x (swin a (fv nvf t4) (fv nvf t3))) $ by wcel_isset [p6h]
p6j: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ scat x (swin a (fv nvf t4) (fv nvf t3)) = sarg u (dnf u M) t5 w a $ by eq_sym [p4]
