q8: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e ⇒ ∃ x2 (z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (z = ⟨ kc_cons , scons x1 (scons x4 ∅) ⟩ ∧ t2 = x2 ∧ t4 = x3 ∧ ra_pis x4 ⟨ kc_pi , scons x1 (scons x2 ∅) ⟩ x3 ∈ lrel) $ by lrel_pis_cases [q7]
q9: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 $ by ax
q10: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [q9]
q11: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ t2 = x2 ∧ t4 = x2 $ by and_elim_r [q9]
q12: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ t2 = x2 $ by and_elim_l [q11]
q13: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ t4 = x2 $ by and_elim_r [q11]
q14: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ t3 = e $ by weaken [q6]
q15: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ t2 = e $ by weaken [q5]
q16: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ e = t2 $ by eq_sym [q15]
q17: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ t3 = t2 $ by eq_trans [q14, q16]
q18: $ G , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = e ∧ t3 = e , z = ⟨ kc_nil , ∅ ⟩ ∧ t2 = x2 ∧ t4 = x2 ⇒ x2 = t4 $ by eq_sym [q13]
