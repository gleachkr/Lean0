h18: $ … ⇒ ∃ v (v ∊ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 Y)))) $ by ex_intro [h17]
h19: $ … ⇒ ∃ v (v ∊ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 Y)))) $ by ex_elim [h14, h18]
h20: $ G , ∃ v (v ∊ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X)))) ⇒ ∃ v (v ∊ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 X)))) $ by ax
h21: $ … ⇒ ∃ v (v ∊ cpi x (dt u M a0 w (scat t6 X)) (dt u M b0 w (scons x (scat t6 Y)))) $ by ex_elim [h20, h19]
