lemma b14_goal_mv (G: hyps) (A B A2 B2 N: class): $ G ⇒ A = A2 $ > $ G ⇒ B = B2 $ > $ G ⇒ (B ⊆ csn ∅ → A ⊆ csn ∅) ∧ (B ∈ N → A ∈ N) $ > $ G ⇒ (B2 ⊆ csn ∅ → A2 ⊆ csn ∅) ∧ (B2 ∈ N → A2 ∈ N) $
----
a1: $ G ⇒ B2 = B $ by eq_sym [#2]
a2: $ G ⇒ B ⊆ csn ∅ → A ⊆ csn ∅ $ by and_elim_l [#3]
a3: $ G ⇒ B ∈ N → A ∈ N $ by and_elim_r [#3]
b1: $ G , B2 ⊆ csn ∅ ⇒ B2 ⊆ csn ∅ $ by ax
b2: $ G , B2 ⊆ csn ∅ ⇒ B2 = B $ by weaken [a1]
b3: $ … ⇒ B ⊆ csn ∅ $ by subset_eq_l [b2, b1]
b4: $ G , B2 ⊆ csn ∅ ⇒ B ⊆ csn ∅ → A ⊆ csn ∅ $ by weaken [a2]
b5: $ … ⇒ A ⊆ csn ∅ $ by imp_elim [b4, b3]
b6: $ G , B2 ⊆ csn ∅ ⇒ A = A2 $ by weaken [#1]
b7: $ … ⇒ A2 ⊆ csn ∅ $ by subset_eq_l [b6, b5]
b8: $ … ⇒ B2 ⊆ csn ∅ → A2 ⊆ csn ∅ $ by imp_intro [b7]
c1: $ G , B2 ∈ N ⇒ B2 ∈ N $ by ax
c2: $ G , B2 ∈ N ⇒ B2 = B $ by weaken [a1]
c3: $ … ⇒ B ∈ N $ by wcel_eq_l [c2, c1]
c4: $ G , B2 ∈ N ⇒ B ∈ N → A ∈ N $ by weaken [a3]
c5: $ … ⇒ A ∈ N $ by imp_elim [c4, c3]
c6: $ G , B2 ∈ N ⇒ A = A2 $ by weaken [#1]
c7: $ … ⇒ A2 ∈ N $ by wcel_eq_l [c6, c5]
c8: $ … ⇒ B2 ∈ N → A2 ∈ N $ by imp_intro [c7]
c9: $ … ⇒ (B2 ⊆ csn ∅ → A2 ⊆ csn ∅) ∧ (B2 ∈ N → A2 ∈ N) $ by and_intro [b8, c8]

def b14_cip (U M W X Y t1 t2 t3 N: class) (.y .d .c: set): class = $ {y | ∀ d ∀ c (ra_ipos t1 t2 t3 d y ∈ lrel → y ∊ ofsort lsig lopen ks_expr → c ∊ fseq U → cdm c = nadd (fv nvf d) (fv nvf t3) → (dt U M y W (scat c Y) ⊆ csn ∅ → dt U M y W (scat c X) ⊆ csn ∅) ∧ (dt U M y W (scat c Y) ∈ N → dt U M y W (scat c X) ∈ N))} $

lemma b14_ip_pi (G: hyps) (M N: class) (u w X Y t1 t2 t3 t4 t6 z a0 b0 k5: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ X ∊ fseq u $ > $ G ⇒ Y ∊ fseq u $ > $ G ⇒ b6_cond t1 t3 X Y $ > $ G ⇒ universe N $ > $ G ⇒ t6 ∊ fseq u $ > $ G ⇒ cdm t6 = nadd (fv nvf t4) (fv nvf t3) $ > $ G ⇒ z = ⟨ kc_pi , scons a0 (scons b0 ∅) ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ ra_ipos t1 t2 t3 t4 z ∈ lrel $ > $ G ⇒ ra_add t4 t3 k5 ∈ lrel $ > $ G ⇒ ra_closed k5 a0 ∈ lrel $ > $ G ⇒ ra_ipos t1 t2 t3 ⟨ kc_s , scons t4 ∅ ⟩ b0 ∈ lrel $ > $ G ⇒ b0 ∊ b14_cip u M w X Y t1 t2 t3 N $ > $ G ⇒ (dt u M z w (scat t6 Y) ⊆ csn ∅ → dt u M z w (scat t6 X) ⊆ csn ∅) ∧ (dt u M z w (scat t6 Y) ∈ N → dt u M z w (scat t6 X) ∈ N) $
----
r1: $ G ⇒ scat t6 X ∈ fseq u $ by scat_fseq [#7, #3]
r2: $ G ⇒ scat t6 Y ∈ fseq u $ by scat_fseq [#7, #4]
r3: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
p1: $ G ⇒ z ∈ trees ω $ by welc_wcel [#10]
p2: $ … ⇒ ⟨ kc_pi , scons a0 (scons b0 ∅) ⟩ ∈ trees ω $ by wcel_eq_l [#9, p1]
p3: $ G ⇒ isset ω $ by omega_set
p4: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
p5: $ … ⇒ isset kc_pi $ by wcel_isset [p4]
p6: $ … ⇒ a0 ∊ trees ω ∧ b0 ∊ trees ω $ by trees_kids2 [p3, p2, p5]
p7: $ … ⇒ a0 ∊ trees ω $ by and_elim_l [p6]
p8: $ … ⇒ b0 ∊ trees ω $ by and_elim_r [p6]
