e1a: $ G , ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩) ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩) $ by ax
e1b: $ G , ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩) ⇒ v ∊ {o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (etel u (dnf u M) d w (scons i r)) ∧ o = ssnoc l i)} × ({o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ∧ o = scons i l)} × ({o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ∧ o = scons (etel u (dnf u M) c w r) l)} × {o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ crn (crn (crn (etel u (dnf u M) d w (scons i r)))) ∧ o = l)})) $ by ex_elim [e1a, e2b]
e6: $ G , v ∊ {o | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ o = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩)} ⇒ v ∊ {o | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ o = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩)} $ by ax
e7: $ G , v ∊ {o | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ o = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩)} ⇒ ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩) $ by cab_elim [e6]
e8: $ G , v ∊ {o | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ o = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩)} ⇒ v ∊ {o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (etel u (dnf u M) d w (scons i r)) ∧ o = ssnoc l i)} × ({o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ∧ o = scons i l)} × ({o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ∧ o = scons (etel u (dnf u M) c w r) l)} × {o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ crn (crn (crn (etel u (dnf u M) d w (scons i r)))) ∧ o = l)})) $ by cut [e7, e1b]
e9: $ G ⇒ {o | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ o = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩)} ⊆ {o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (etel u (dnf u M) d w (scons i r)) ∧ o = ssnoc l i)} × ({o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (crn (etel u (dnf u M) d w (scons i r))) ∧ o = scons i l)} × ({o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ cdm (crn (crn (etel u (dnf u M) d w (scons i r)))) ∧ o = scons (etel u (dnf u M) c w r) l)} × {o | ∃ i ∃ l (i ∊ dt u M c w r ∧ l ∊ crn (crn (crn (etel u (dnf u M) d w (scons i r)))) ∧ o = l)})) $ by subset_intro [e8]
e10: $ G ⇒ {o | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ o = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩)} ∈ u $ by universe_subset_c [p1, w3, e9]
e11: $ G ⇒ c ∈ trees ω $ by lsig_ofsort_trees [#4]
e12: $ G ⇒ d ∈ trees ω $ by lsig_ofsort_trees [#5]
e13: $ G ⇒ etel u (dnf u M) ⟨ kc_pi , scons c (scons d ∅) ⟩ w r = {o | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ o = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩)} $ by etel_pi [e11, e12, #2, #3]
e14: $ G ⇒ {o | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ dt u M c w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) d w (scons x r) ∧ o = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) c w r) t , a ⟩ ⟩ ⟩)} = etel u (dnf u M) ⟨ kc_pi , scons c (scons d ∅) ⟩ w r $ by eq_sym [e13]
e15: $ G ⇒ etel u (dnf u M) ⟨ kc_pi , scons c (scons d ∅) ⟩ w r ∈ u $ by wcel_eq_l [e14, e10]

lemma b3_etel_app_u (G: hyps) (M: class) (u w r c d: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ c ∈ trees ω $ > $ G ⇒ d ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ etel u (dnf u M) c w r ∈ u $ > $ G ⇒ etel u (dnf u M) ⟨ kc_app , scons c (scons d ∅) ⟩ w r ∈ u $
----
p1: $ G ⇒ universe u $ by uadm_universe [#1]
p2: $ G ⇒ dt u M d w r ∈ u $ by dt_in_u [#1, #5, #2, #3]
p3: $ G ⇒ crn (etel u (dnf u M) c w r) ∈ u $ by b3_crn_u [p1, #6]
p4: $ G ⇒ crn (crn (etel u (dnf u M) c w r)) ∈ u $ by b3_crn_u [p1, p3]
p5: $ G ⇒ crn (crn (crn (etel u (dnf u M) c w r))) ∈ u $ by b3_crn_u [p1, p4]
q1: $ G , l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ⇒ l ∊ crn (crn (crn (etel u (dnf u M) c w r))) $ by ax
q2: $ G , l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ⇒ l ∈ crn (crn (crn (etel u (dnf u M) c w r))) $ by welc_wcel [q1]
q3: $ G , l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ⇒ universe u $ by weaken [p1]
q4: $ G , l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ⇒ crn (crn (crn (etel u (dnf u M) c w r))) ∈ u $ by weaken [p5]
q5: $ G , l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ⇒ l ∈ u $ by universe_elem_elem_c [q3, q4, q2]
q6: $ G , l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ⇒ dt u M d w r ∈ u $ by weaken [p2]
q7: $ G , l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ⇒ scons (dt u M d w r) l ∈ u $ by b3_scons_u [q3, q6, q5]
q8: $ G ⇒ l ∊ crn (crn (crn (etel u (dnf u M) c w r))) → scons (dt u M d w r) l ∈ u $ by imp_intro [q7]
q9: $ G ⇒ ∀ l (l ∊ crn (crn (crn (etel u (dnf u M) c w r))) → scons (dt u M d w r) l ∈ u) $ by all_intro [q8]
q10: $ G ⇒ {o | ∃ l (l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ∧ o = scons (dt u M d w r) l)} ∈ u $ by b3_repl1 [p1, p5, q9]
q11: $ G ⇒ ∅ ∈ u $ by uadm_empty [#1]
q12: $ G ⇒ csn ∅ ∈ u $ by universe_cpr_c [p1, q11, q11]
q13: $ G ⇒ csn ∅ × {o | ∃ l (l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ∧ o = scons (dt u M d w r) l)} ∈ u $ by universe_cxp_c [p1, q12, q10]
q14: $ G ⇒ csn ∅ × (csn ∅ × {o | ∃ l (l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ∧ o = scons (dt u M d w r) l)}) ∈ u $ by universe_cxp_c [p1, q12, q13]
q15: $ G ⇒ csn ∅ × (csn ∅ × (csn ∅ × {o | ∃ l (l ∊ crn (crn (crn (etel u (dnf u M) c w r))) ∧ o = scons (dt u M d w r) l)})) ∈ u $ by universe_cxp_c [p1, q12, q14]
r1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ $ by ax
r2: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r $ by and_elim_l [r1]
r3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ $ by and_elim_r [r1]
r4: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ e = ∅ $ by ax
r5: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ ∅ = e $ by eq_sym [r4]
r6: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ a = a $ by eq_refl
r7: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ ⟨ ∅ , a ⟩ = ⟨ e , a ⟩ $ by opair_eq [r5, r6]
r8: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ = ⟨ e , ⟨ e , a ⟩ ⟩ $ by opair_eq [r5, r7]
r9: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ = ⟨ e , ⟨ e , ⟨ e , a ⟩ ⟩ ⟩ $ by opair_eq [r5, r8]
r10: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ ⟨ e , ⟨ e , ⟨ e , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r $ by wcel_eq_l [r9, r2]
r11: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ e ∊ cdm (etel u (dnf u M) c w r) ∧ e ∊ cdm (crn (etel u (dnf u M) c w r)) ∧ e ∊ cdm (crn (crn (etel u (dnf u M) c w r))) ∧ a ∊ crn (crn (crn (etel u (dnf u M) c w r))) $ by b3_path_parts [r10]
r12: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ e ∊ cdm (crn (etel u (dnf u M) c w r)) ∧ e ∊ cdm (crn (crn (etel u (dnf u M) c w r))) ∧ a ∊ crn (crn (crn (etel u (dnf u M) c w r))) $ by and_elim_r [r11]
r13: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ e ∊ cdm (crn (crn (etel u (dnf u M) c w r))) ∧ a ∊ crn (crn (crn (etel u (dnf u M) c w r))) $ by and_elim_r [r12]
r14: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , e = ∅ ⇒ a ∊ crn (crn (crn (etel u (dnf u M) c w r))) $ by and_elim_r [r13]
r15: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
r16: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ ⇒ a ∊ crn (crn (crn (etel u (dnf u M) c w r))) $ by isset_elim [r15, r14]
s1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) c w r ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (dt u M d w r) a ⟩ ⟩ ⟩ , h = scons (dt u M d w r) a ⇒ a ∊ crn (crn (crn (etel u (dnf u M) c w r))) $ by weaken [r16]
