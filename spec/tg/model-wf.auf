a11: $ … ⇒ crn (scons t4 (scons t14 ∅)) ⊆ trees ω $ by fseq_crn_c [a10]
a12: $ G ⇒ isset t4 $ by isset_var
a13: $ … ⇒ t4 ∈ trees ω $ by crn_scons_head [a12, a11]
a14: $ … ⇒ crn (scons t14 ∅) ⊆ trees ω $ by crn_scons_tail [a11]
a15: $ G ⇒ isset t14 $ by isset_var
a16: $ … ⇒ t14 ∈ trees ω $ by crn_scons_head [a15, a14]
a17: $ … ⇒ (∃ l ∃ m (t4 = l ∧ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩)) ∨ (∃ l ∃ m (t4 = l ∧ t14 = m ∧ lveq ⟨ kc_lmax , scons l (scons m ∅) ⟩ l)) $ by lrel2_ulevel_cases [#1]
b1: $ G , v = W , v ∊ lvals , t4 = l ∧ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩ ⇒ t4 = l ∧ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩ $ by ax
b2: $ … ⇒ t4 = l $ by and_elim_l [b1]
b3: $ … ⇒ t14 = m ∧ lveq l ⟨ kc_lz , ∅ ⟩ $ by and_elim_r [b1]
b5: $ … ⇒ lveq l ⟨ kc_lz , ∅ ⟩ $ by and_elim_r [b3]
