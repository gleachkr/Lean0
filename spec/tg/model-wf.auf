p8d: $ G , ra_nidx t1 t6 m ∈ lrel ∧ x ∊ fseq b7_V ∧ cdm x = fv nvf m ∧ sarg u (dnf u M) t5 w a = scat x (swin a (fv nvf t4) (fv nvf t3)) ⇒ dt u M t5 w b = apn (fv b (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w b) $ by and_elim_r [p8c]
