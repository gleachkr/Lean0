q8: $ G , e = ∅ , a = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ , b = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_nz , ∅ ⟩ = b $ by eq_sym [q4]
q9: $ G , e = ∅ , a = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ , b = ⟨ kc_nz , ∅ ⟩ ⇒ t3 = t3 $ by eq_refl
q10: $ G , e = ∅ , a = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ , b = ⟨ kc_nz , ∅ ⟩ ⇒ t4 = t4 $ by eq_refl
q11: $ G , e = ∅ , a = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ , b = ⟨ kc_nz , ∅ ⟩ ⇒ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ t3 t4 = ra_lift a b t3 t4 $ by ra_lift_eq [q7, q8, q9, q10]
q12: $ G , e = ∅ , a = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ , b = ⟨ kc_nz , ∅ ⟩ ⇒ ra_lift a b t3 t4 ∈ lrel $ by wcel_eq_l [q11, q5]
q13: $ G , e = ∅ , a = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ , b = ⟨ kc_nz , ∅ ⟩ ⇒ e = ∅ $ by weaken [q2]
q14: $ G , e = ∅ , a = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ , b = ⟨ kc_nz , ∅ ⟩ ⇒ ∅ = e $ by eq_sym [q13]
