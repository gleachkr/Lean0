n4: $ G , n = lv l W , n ∊ ω ⇒ lv l W = n $ by eq_sym [n3]
z1: $ G , n = lv l W , n ∊ ω , n = ∅ ⇒ n = ∅ $ by ax
z2: $ G , n = lv l W , n ∊ ω , n = ∅ ⇒ lv l W = n $ by weaken [n4]
