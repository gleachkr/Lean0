def b6_clift (.y .a .b .c .n .l: set): class = $ {y | ∀ a ∀ b ∀ c (ra_lift a b y c ∈ lrel → (y ∊ ofsort lsig lopen ks_expr → c ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort y n l ∈ lrel → ra_isort c n l ∈ lrel))} $

lemma b6_lift_st (G: hyps) {n l: set} (z k s t1 t2 t4: set): $ G ⇒ crn s ⊆ b6_clift $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_lift t1 t2 z t4 ∈ lrel $ > $ G ⇒ (z ∊ ofsort lsig lopen ks_expr → t4 ∊ ofsort lsig lopen ks_expr) ∧ ∀ n ∀ l (ra_isort z n l ∈ lrel → ra_isort t4 n l ∈ lrel) $
----
q1: $ G ⇒ ∃ x1 ∃ x2 ∃ x3 (t1 = x1 ∧ t2 = x2 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons x3 ∅ ⟩ x2 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 (t1 = x1 ∧ t2 = x2 ∧ z = ⟨ kc_bvar , scons x3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons x4 ∅ ⟩ ∧ ra_le x2 x3 ∈ lrel ∧ ra_add x3 x1 x4 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ x5 (t1 = x1 ∧ t2 = x2 ∧ z = ⟨ kc_srt , scons x5 ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons x5 ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (t1 = x1 ∧ t2 = x2 ∧ z = ⟨ kc_app , scons x6 (scons x7 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons x8 (scons x9 ∅) ⟩ ∧ ra_lift x1 x2 x6 x8 ∈ lrel ∧ ra_lift x1 x2 x7 x9 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ d ∃ e ∃ f ∃ g (t1 = x1 ∧ t2 = x2 ∧ z = ⟨ kc_lam , scons d (scons e ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons f (scons g ∅) ⟩ ∧ ra_lift x1 x2 d f ∈ lrel ∧ ra_lift x1 ⟨ kc_s , scons x2 ∅ ⟩ e g ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ d ∃ e ∃ f ∃ g (t1 = x1 ∧ t2 = x2 ∧ z = ⟨ kc_pi , scons d (scons e ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons f (scons g ∅) ⟩ ∧ ra_lift x1 x2 d f ∈ lrel ∧ ra_lift x1 ⟨ kc_s , scons x2 ∅ ⟩ e g ∈ lrel) ∨ ∃ x1 ∃ x4 ∃ x2 ∃ h (t1 = x1 ∧ t2 = x2 ∧ z = h ∧ t4 = h ∧ ra_closed x4 h ∈ lrel ∧ ra_le x4 x2 ∈ lrel) ∨ ∃ x1 ∃ x2 ∃ e ∃ x3 ∃ h ∃ i (t1 = x1 ∧ t2 = x2 ∧ z = ⟨ kc_proj , scons e (scons x3 (scons h ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons e (scons x3 (scons i ∅)) ⟩ ∧ ra_lift x1 x2 h i ∈ lrel) $ by lrel_lift_cases [#4]
