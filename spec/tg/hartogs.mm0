-- hartogs.mm0: injections, Hartogs numbers and the bounding lemma.
-- `hartogs A` is the class of ordinals that inject into `A`; it is an ordinal
-- that does not inject into `A`. The universe axiom makes it a set (every
-- ordinal injecting into an element of a universe is in the universe, by
-- transfinite induction and the universe's closure under element-indexed
-- unions), and the rigidity of ordinals (an injection of an ordinal into a
-- set, with its image and the induced relation, determines the ordinal)
-- injects `hartogs s` into `𝒫 (𝒫 s × 𝒫 (s × s))`, so `hartogs s` is in every
-- universe containing `s`. The bounding lemma: an `a`-indexed family of
-- ordinals below `hartogs (𝒫 (a × ω))` is bounded below it, by choice (an
-- injection for each member and an index for each element of the union) and
-- the injection of `a × 𝒫 (a × ω)` into `𝒫 (a × ω)` that shifts the second
-- components. Imports universe.mm0; proofs in hartogs.auf.

import "universe.mm0";

-- --------------------------------------------------------------------------
-- Injections
-- --------------------------------------------------------------------------

--| A value determines its argument.
def injective (F: class) (.x .y .z: set): fml =
  $ ∀ x ∀ y ∀ z (⟨ x , z ⟩ ∈ F ∧ ⟨ y , z ⟩ ∈ F → x = y) $;
--| An injection from `A` into `B`: a function on `A` into `B`, injective on `A`.
def injects (F A B: class): fml = $ fn_into F A B ∧ injective (cres F A) $;
--| `A` injects into `B`.
def inj_into (A B: class) (.f: set): fml = $ ∃ f (injects f A B) $;
--| The injections of `A` into `B`, as a set when `A` and `B` are.
def injs (A B: class) (.f: set): class = $ {f | injects f A B ∧ f ⊆ A × B} $;

--| @freshen G x
--| @freshen G y
--| @freshen G z
theorem injective_intro (G: hyps) {x y z: set} (F: class):
  $ G , ⟨ x , z ⟩ ∈ F , ⟨ y , z ⟩ ∈ F ⇒ x = y $ > $ G ⇒ injective F $;
theorem injective_elim (G: hyps) (F: class) (a b c: set):
  $ G ⇒ injective F $ > $ G ⇒ ⟨ a , c ⟩ ∈ F $ > $ G ⇒ ⟨ b , c ⟩ ∈ F $ > $ G ⇒ a = b $;
theorem injective_subset (G: hyps) (F H: class):
  $ G ⇒ injective H $ > $ G ⇒ F ⊆ H $ > $ G ⇒ injective F $;
theorem injective_cres (G: hyps) (F A: class):
  $ G ⇒ injective F $ > $ G ⇒ injective (cres F A) $;
--| An injective relation's converse is functional.
theorem injective_ccnv (G: hyps) (F: class):
  $ G ⇒ injective F $ > $ G ⇒ functional (ccnv F) $;
--| @congr
theorem injective_congr (F H: class): $ F ≐ H $ > $ injective F ⟺ injective H $;
theorem injective_eq (G: hyps) (F H: class):
  $ G ⇒ F = H $ > $ G ⇒ injective F $ > $ G ⇒ injective H $;
--| @rewrite
theorem sb_f_injective {x: set} (t: set x) (F: class x):
  $ [x/t] (injective F) ⟺ injective (⟦ x / t ⟧ F) $;

theorem injects_intro (G: hyps) (F A B: class):
  $ G ⇒ fn_into F A B $ > $ G ⇒ injective (cres F A) $ > $ G ⇒ injects F A B $;
theorem injects_fn_into (G: hyps) (F A B: class):
  $ G ⇒ injects F A B $ > $ G ⇒ fn_into F A B $;
theorem injects_functional (G: hyps) (F A B: class):
  $ G ⇒ injects F A B $ > $ G ⇒ functional F $;
--| Values of an injection: in `B`, and determining the argument.
theorem injects_fv (G: hyps) (F A B: class) (a: set):
  $ G ⇒ injects F A B $ > $ G ⇒ a ∊ A $ > $ G ⇒ fv F a ∈ B $;
theorem injects_fv_in (G: hyps) (F A B: class) (a: set):
  $ G ⇒ injects F A B $ > $ G ⇒ a ∊ A $ > $ G ⇒ ⟨ a , fv F a ⟩ ∈ F $;
theorem injects_elim_inj (G: hyps) (F A B: class) (a b: set):
  $ G ⇒ injects F A B $ > $ G ⇒ a ∊ A $ > $ G ⇒ b ∊ A $ > $ G ⇒ fv F a = fv F b $ >
  $ G ⇒ a = b $;
theorem injects_subset_dom (G: hyps) (F A B C: class):
  $ G ⇒ injects F A B $ > $ G ⇒ C ⊆ A $ > $ G ⇒ injects F C B $;
theorem injects_subset_cod (G: hyps) (F A B C: class):
  $ G ⇒ injects F A B $ > $ G ⇒ B ⊆ C $ > $ G ⇒ injects F A C $;
theorem injects_cres (G: hyps) (F A B: class):
  $ G ⇒ injects F A B $ > $ G ⇒ injects (cres F A) A B $;
theorem injects_img (G: hyps) (F A B: class):
  $ G ⇒ injects F A B $ > $ G ⇒ img F A ⊆ B $;
--| The converse of an injection restricted to its domain inverts it.
theorem injects_ccnv_functional (G: hyps) (F A B: class):
  $ G ⇒ injects F A B $ > $ G ⇒ functional (ccnv (cres F A)) $;
theorem injects_ccnv_fv (G: hyps) (F A B: class) (a: set):
  $ G ⇒ injects F A B $ > $ G ⇒ a ∊ A $ > $ G ⇒ fv (ccnv (cres F A)) (fv F a) = a $;
--| The inverse at a value given by a pair of the injection.
theorem injects_ccnv_fv_pair (G: hyps) (F A B: class) (k z: set):
  $ G ⇒ injects F A B $ > $ G ⇒ z ∊ A $ > $ G ⇒ ⟨ z , k ⟩ ∈ F $ > $ G ⇒ fv (ccnv (cres F A)) k = z $;
--| The identity on `A` and the composite of two injections.
theorem injects_id {x: set} (G: hyps x) (A B: class):
  $ G ⇒ A ⊆ B $ > $ G ⇒ injects (cres (cgr x x) A) A B $;
theorem injects_ccom (G: hyps) (F H A B C: class):
  $ G ⇒ injects F A B $ > $ G ⇒ injects H B C $ > $ G ⇒ injects (ccom H F) A C $;
--| @congr
theorem injects_congr (F H A B C D: class):
  $ F ≐ H $ > $ A ≐ B $ > $ C ≐ D $ > $ injects F A C ⟺ injects H B D $;
theorem injects_eq (G: hyps) (F H A B C D: class):
  $ G ⇒ F = H $ > $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ injects F A C $ >
  $ G ⇒ injects H B D $;
--| @rewrite
theorem sb_f_injects {x: set} (t: set x) (F A B: class x):
  $ [x/t] (injects F A B) ⟺ injects (⟦ x / t ⟧ F) (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;

theorem inj_into_intro (G: hyps) (A B: class) (f: set):
  $ G ⇒ injects f A B $ > $ G ⇒ inj_into A B $;
--| Class form of `inj_into_intro`: an injection that is a set.
theorem inj_into_intro_c (G: hyps) (F A B: class):
  $ G ⇒ isset F $ > $ G ⇒ injects F A B $ > $ G ⇒ inj_into A B $;
--| @freshen H f
--| @freshen c f
theorem inj_into_elim {f: set} (G: hyps f) (H: hyps) (A B: class) (c: fml):
  $ G ⇒ inj_into A B $ > $ H , injects f A B ⇒ c $ > $ G , H ⇒ c $;
--| A class that injects into any class is a set (the injection is a set).
theorem inj_into_set (G: hyps) (A B: class):
  $ G ⇒ inj_into A B $ > $ G ⇒ isset A $;
theorem inj_into_subset (G: hyps) (A B: class):
  $ G ⇒ isset A $ > $ G ⇒ A ⊆ B $ > $ G ⇒ inj_into A B $;
theorem inj_into_refl (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ inj_into A A $;
theorem inj_into_trans (G: hyps) (A B C: class):
  $ G ⇒ inj_into A B $ > $ G ⇒ inj_into B C $ > $ G ⇒ inj_into A C $;
theorem inj_into_subset_dom (G: hyps) (A B C: class):
  $ G ⇒ inj_into A B $ > $ G ⇒ C ⊆ A $ > $ G ⇒ inj_into C B $;
theorem inj_into_subset_cod (G: hyps) (A B C: class):
  $ G ⇒ inj_into A B $ > $ G ⇒ B ⊆ C $ > $ G ⇒ inj_into A C $;
--| @congr
theorem inj_into_congr (A B C D: class):
  $ A ≐ B $ > $ C ≐ D $ > $ inj_into A C ⟺ inj_into B D $;
theorem inj_into_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ inj_into A C $ > $ G ⇒ inj_into B D $;
--| @rewrite
theorem sb_f_inj_into {x: set} (t: set x) (A B: class x):
  $ [x/t] (inj_into A B) ⟺ inj_into (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;

theorem injs_intro (G: hyps) (A B: class) (f: set):
  $ G ⇒ injects f A B $ > $ G ⇒ f ⊆ A × B $ > $ G ⇒ f ∊ injs A B $;
theorem injs_elim (G: hyps) (A B: class) (f: set):
  $ G ⇒ f ∊ injs A B $ > $ G ⇒ injects f A B $;
--| A member of `injs A B` lies in `A × B`.
theorem injs_elim_sub (G: hyps) (A B: class) (f: set): $ G ⇒ f ∊ injs A B $ > $ G ⇒ f ⊆ A × B $;
theorem injs_set (G: hyps) (A B: class):
  $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ isset (injs A B) $;
--| Restricting an injection gives a member of `injs`.
theorem injs_nonempty {u: set} (G: hyps u) (A B: class):
  $ G ⇒ inj_into A B $ > $ G ⇒ ∃ u (u ∊ injs A B) $;
--| @congr
theorem injs_congr (A B C D: class): $ A ≐ B $ > $ C ≐ D $ > $ injs A C ≐ injs B D $;
theorem injs_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ injs A C = injs B D $;
--| @rewrite
theorem sb_c_injs {x: set} (t: set x) (A B: class x):
  $ (⟦ x / t ⟧ (injs A B)) ≐ injs (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $;

-- --------------------------------------------------------------------------
-- Hartogs numbers
-- --------------------------------------------------------------------------

--| The ordinals that inject into `A`.
def hartogs (A: class) (.a: set): class = $ {a | ord a ∧ inj_into a A} $;

theorem hartogs_intro (G: hyps) (A: class) (a: set):
  $ G ⇒ ord a $ > $ G ⇒ inj_into a A $ > $ G ⇒ a ∊ hartogs A $;
theorem hartogs_elim (G: hyps) (A: class) (a: set):
  $ G ⇒ a ∊ hartogs A $ > $ G ⇒ ord a ∧ inj_into a A $;
theorem hartogs_trans (G: hyps) (A: class): $ G ⇒ transitive (hartogs A) $;
theorem hartogs_ord (G: hyps) (A: class): $ G ⇒ ord (hartogs A) $;
--| The Hartogs number does not inject into `A`.
theorem hartogs_not_inj (G: hyps) (A: class): $ G ⇒ inj_into (hartogs A) A $ > $ G ⇒ ⊥ $;
theorem hartogs_mono (G: hyps) (A B: class):
  $ G ⇒ A ⊆ B $ > $ G ⇒ hartogs A ⊆ hartogs B $;
--| @congr
theorem hartogs_congr (A B: class): $ A ≐ B $ > $ hartogs A ≐ hartogs B $;
theorem hartogs_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ hartogs A = hartogs B $;
--| @rewrite
theorem sb_c_hartogs {x: set} (t: set x) (A: class x):
  $ (⟦ x / t ⟧ (hartogs A)) ≐ hartogs (⟦ x / t ⟧ A) $;

--| An ordinal that injects into an element of a universe is in the universe
--| (transfinite induction: `a` is the union of the family `suc x`, `x ∊ a`,
--| indexed through the injection by the image of `a`, an element).
theorem ord_cuni_suc {x: set} (G: hyps x) (a: set):
  $ G ⇒ ord a $ > $ G ⇒ ⋃ (img (cgr x (suc x)) a) = a $;
theorem universe_ord_inj (G: hyps) (U: class) (a b: set):
  $ G ⇒ universe U $ > $ G ⇒ b ∊ U $ > $ G ⇒ ord a $ > $ G ⇒ inj_into a b $ > $ G ⇒ a ∊ U $;
theorem hartogs_subset_universe (G: hyps) (U: class) (b: set):
  $ G ⇒ universe U $ > $ G ⇒ b ∊ U $ > $ G ⇒ hartogs b ⊆ U $;
theorem hartogs_set (G: hyps) (a: set): $ G ⇒ isset (hartogs a) $;

-- --------------------------------------------------------------------------
-- Rigidity, and the Hartogs number of an element of a universe
-- --------------------------------------------------------------------------

--| The image of the membership relation on `A` under `F`.
def erel (F A: class) (.x .y .w: set): class =
  $ {w | ∃ x ∃ y (x ∊ A ∧ y ∊ A ∧ x ∊ y ∧ w = ⟨ fv F x , fv F y ⟩)} $;
--| The representations of `A` in `S`: the image and the induced relation of
--| each injection of `A` into `S`.
def reps (A S: class) (.f .w: set): class =
  $ {w | ∃ f (f ∊ injs A S ∧ w = ⟨ img f A , erel f A ⟩)} $;

theorem erel_intro (G: hyps) (F A: class) (a b: set):
  $ G ⇒ a ∊ A $ > $ G ⇒ b ∊ A $ > $ G ⇒ a ∊ b $ > $ G ⇒ ⟨ fv F a , fv F b ⟩ ∈ erel F A $;
--| @freshen H x
--| @freshen H y
--| @freshen d x
--| @freshen d y
theorem erel_elim {x y: set} (G: hyps x y) (H: hyps) (F A: class) (c: set) (d: fml):
  $ G ⇒ c ∊ erel F A $ >
  $ H , x ∊ A , y ∊ A , x ∊ y , c = ⟨ fv F x , fv F y ⟩ ⇒ d $ > $ G , H ⇒ d $;
theorem erel_subset (G: hyps) (F A B: class):
  $ G ⇒ injects F A B $ > $ G ⇒ erel F A ⊆ B × B $;
--| @congr
theorem erel_congr (F H A B: class): $ F ≐ H $ > $ A ≐ B $ > $ erel F A ≐ erel H B $;
--| @rewrite
theorem sb_c_erel {x: set} (t: set x) (F A: class x):
  $ (⟦ x / t ⟧ (erel F A)) ≐ erel (⟦ x / t ⟧ F) (⟦ x / t ⟧ A) $;
--| Rigidity, the core: two injections of ordinals with the same induced
--| relation agree in the sense that equal values have equal arguments
--| (membership induction on the argument).
--| @freshen G x
--| @freshen G y
theorem ord_rigid_core (G: hyps) {x y: set} (a b s g h: set):
  $ G ⇒ ord a $ > $ G ⇒ ord b $ > $ G ⇒ injects g a s $ > $ G ⇒ injects h b s $ >
  $ G ⇒ erel g a = erel h b $ >
  $ G ⇒ ∀ x (x ∊ a → ∀ y (y ∊ b → fv g x = fv h y → x = y)) $;
--| Rigidity: the same image and the same induced relation give the same ordinal.
theorem ord_rigid (G: hyps) (a b s g h: set):
  $ G ⇒ ord a $ > $ G ⇒ ord b $ > $ G ⇒ injects g a s $ > $ G ⇒ injects h b s $ >
  $ G ⇒ img g a = img h b $ > $ G ⇒ erel g a = erel h b $ > $ G ⇒ a = b $;

theorem reps_intro (G: hyps) (A S: class) (f: set):
  $ G ⇒ f ∊ injs A S $ > $ G ⇒ ⟨ img f A , erel f A ⟩ ∈ reps A S $;
--| @freshen H f
--| @freshen d f
theorem reps_elim {f: set} (G: hyps f) (H: hyps) (A S: class) (c: set) (d: fml):
  $ G ⇒ c ∊ reps A S $ > $ H , f ∊ injs A S , c = ⟨ img f A , erel f A ⟩ ⇒ d $ > $ G , H ⇒ d $;
theorem reps_subset (G: hyps) (a s: set): $ G ⇒ reps a s ⊆ 𝒫 s × 𝒫 (s × s) $;
theorem reps_set (G: hyps) (a s: set): $ G ⇒ isset (reps a s) $;
theorem reps_nonempty {w: set} (G: hyps w) (a s: set):
  $ G ⇒ inj_into a s $ > $ G ⇒ ∃ w (w ∊ reps a s) $;
--| Distinct ordinals have disjoint representations.
theorem reps_disjoint (G: hyps) (a b s w: set):
  $ G ⇒ ord a $ > $ G ⇒ ord b $ > $ G ⇒ w ∊ reps a s $ > $ G ⇒ w ∊ reps b s $ > $ G ⇒ a = b $;
--| @congr
theorem reps_congr (A B S T: class): $ A ≐ B $ > $ S ≐ T $ > $ reps A S ≐ reps B T $;
--| @rewrite
theorem sb_c_reps {x: set} (t: set x) (A S: class x):
  $ (⟦ x / t ⟧ (reps A S)) ≐ reps (⟦ x / t ⟧ A) (⟦ x / t ⟧ S) $;
--| `a ↦ reps a s` injects the Hartogs number of `s` into `𝒫 (𝒫 s × 𝒫 (s × s))`.
theorem hartogs_inj_into {x: set} (G: hyps x) (s: set):
  $ G ⇒ injects (cres (cgr x (reps x s)) (hartogs s)) (hartogs s) (𝒫 (𝒫 s × 𝒫 (s × s))) $;
theorem hartogs_universe (G: hyps) (U: class) (s: set):
  $ G ⇒ universe U $ > $ G ⇒ s ∊ U $ > $ G ⇒ hartogs s ∈ U $;

-- --------------------------------------------------------------------------
-- Choice, the shift injection, and the bounding lemma
-- --------------------------------------------------------------------------

--| A choice function picks an element of each nonempty member.
--| @freshen G y
theorem chooses_fv (G: hyps) {y: set} (f a b: set):
  $ G ⇒ chooses f a $ > $ G ⇒ b ∊ a $ > $ G ⇒ ∃ y (y ∊ b) $ > $ G ⇒ fv f b ∈ b $;
--| Class form of `chooses_fv`.
--| @freshen G y
theorem chooses_fv_c (G: hyps) {y: set} (f a: set) (B: class):
  $ G ⇒ chooses f a $ > $ G ⇒ B ∈ a $ > $ G ⇒ ∃ y (y ∊ B) $ > $ G ⇒ fv f B ∈ B $;
--| A uniform choice of injections: when every member `fv f x`, `x ∊ a`,
--| injects into `s`, some function `g` picks an injection `fv g x` for each.
--| @freshen G x
--| @freshen G g
theorem choice_injs (G: hyps) {x g: set} (a s f: set):
  $ G ⇒ functional f $ > $ G ⇒ ∀ x (x ∊ a → inj_into (fv f x) s) $ >
  $ G ⇒ ∃ g (functional g ∧ ∀ x (x ∊ a → fv g x ∈ injs (fv f x) s)) $;
--| A choice of index: some function `d` picks, for each element `y` of the
--| union of the family, an index `fv d y ∊ a` with `y ∊ fv f (fv d y)`.
--| @freshen G y
--| @freshen G d
theorem choice_index (G: hyps) {y d: set} (a f: set):
  $ G ⇒ functional f $ >
  $ G ⇒ ∃ d (functional d ∧ ∀ y (y ∊ ⋃ (img f a) → fv d y ∈ a ∧ y ∊ fv f (fv d y))) $;
--| The union of a family of sets each injecting into `s` injects into `a × s`.
--| @freshen G x
theorem inj_into_cuni_fam (G: hyps) {x: set} (a s f: set):
  $ G ⇒ functional f $ > $ G ⇒ ∀ x (x ∊ a → inj_into (fv f x) s) $ >
  $ G ⇒ inj_into (⋃ (img f a)) (a × s) $;

--| The shift of a relation: `⟨ j , n ⟩ ↦ ⟨ j , suc n ⟩`.
def shiftp (X: class) (.j .n .z: set): class =
  $ {z | ∃ j ∃ n (⟨ j , n ⟩ ∈ X ∧ z = ⟨ j , suc n ⟩)} $;
--| `⟨ i , u ⟩ ↦ {⟨ i , ∅ ⟩} ∪ shiftp u`, an injection of `A × 𝒫 (A × ω)`
--| into `𝒫 (A × ω)`.
def shift (A: class) (.i .u .w: set): class =
  $ {w | ∃ i ∃ u (i ∊ A ∧ u ⊆ A × ω ∧ w = ⟨ ⟨ i , u ⟩ , csn ⟨ i , ∅ ⟩ ∪ shiftp u ⟩)} $;

theorem shiftp_intro (G: hyps) (X: class) (a b: set):
  $ G ⇒ ⟨ a , b ⟩ ∈ X $ > $ G ⇒ ⟨ a , suc b ⟩ ∈ shiftp X $;
theorem shiftp_elim {n: set} (G: hyps n) (X: class) (a c: set):
  $ G ⇒ ⟨ a , c ⟩ ∈ shiftp X $ > $ G ⇒ ∃ n (⟨ a , n ⟩ ∈ X ∧ c = suc n) $;
theorem shiftp_rel (G: hyps) (X: class): $ G ⇒ rel (shiftp X) $;
theorem shiftp_subset (G: hyps) (X: class) (a: set):
  $ G ⇒ X ⊆ a × ω $ > $ G ⇒ shiftp X ⊆ a × ω $;
theorem shiftp_inj (G: hyps) (X Y: class):
  $ G ⇒ rel X $ > $ G ⇒ rel Y $ > $ G ⇒ shiftp X = shiftp Y $ > $ G ⇒ X = Y $;
theorem shiftp_set (G: hyps) (x: set): $ G ⇒ isset (shiftp x) $;
--| @congr
theorem shiftp_congr (X Y: class): $ X ≐ Y $ > $ shiftp X ≐ shiftp Y $;
theorem shiftp_eq (G: hyps) (X Y: class): $ G ⇒ X = Y $ > $ G ⇒ shiftp X = shiftp Y $;
--| @rewrite
theorem sb_c_shiftp {x: set} (t: set x) (X: class x):
  $ (⟦ x / t ⟧ (shiftp X)) ≐ shiftp (⟦ x / t ⟧ X) $;
--| The two parts of a shifted value are recovered from it.
theorem shift_val_fst (G: hyps) (a b u v: set):
  $ G ⇒ csn ⟨ a , ∅ ⟩ ∪ shiftp u = csn ⟨ b , ∅ ⟩ ∪ shiftp v $ > $ G ⇒ a = b $;
theorem shift_val_snd (G: hyps) (a b u v: set):
  $ G ⇒ csn ⟨ a , ∅ ⟩ ∪ shiftp u = csn ⟨ b , ∅ ⟩ ∪ shiftp v $ > $ G ⇒ shiftp u = shiftp v $;
theorem shift_injects (G: hyps) (a: set):
  $ G ⇒ injects (shift a) (a × 𝒫 (a × ω)) (𝒫 (a × ω)) $;
theorem inj_into_cxp_cpw (G: hyps) (a: set):
  $ G ⇒ inj_into (a × 𝒫 (a × ω)) (𝒫 (a × ω)) $;
--| @congr
theorem shift_congr (A B: class): $ A ≐ B $ > $ shift A ≐ shift B $;
theorem shift_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ shift A = shift B $;
--| @rewrite
theorem sb_c_shift {x: set} (t: set x) (A: class x):
  $ (⟦ x / t ⟧ (shift A)) ≐ shift (⟦ x / t ⟧ A) $;

--| The bounding lemma: an `a`-indexed family of ordinals below
--| `hartogs (𝒫 (a × ω))` is bounded below it.
--| @freshen G x
theorem hartogs_bound (G: hyps) {x: set} (a f: set):
  $ G ⇒ functional f $ > $ G ⇒ ∀ x (x ∊ a → fv f x ∈ hartogs (𝒫 (a × ω))) $ >
  $ G ⇒ ⋃ (img f a) ∈ hartogs (𝒫 (a × ω)) $;
--| The bound lies in every universe containing `a` and `ω`.
theorem hartogs_bound_universe (G: hyps) (U: class) (a: set):
  $ G ⇒ universe U $ > $ G ⇒ ω ∈ U $ > $ G ⇒ a ∊ U $ > $ G ⇒ hartogs (𝒫 (a × ω)) ∈ U $;
