-- model-fold.mm0: the fold of an inductive block in general (layer E5 of the
-- reduction, audit §11): the fold's values lie in the motives. Imports
-- model-inv.mm0; proofs in model-fold.auf.

import "model-inv.mm0";

-- --------------------------------------------------------------------------
-- The motives as a relation
-- --------------------------------------------------------------------------

--| A point of a curried trace is not empty when its value is not.
theorem nest_nempty (G: hyps) (A Y: class) (s: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ isset Y $ > $ G ⇒ ¬ Y = ∅ $ > $ G ⇒ ¬ nest s Y = ∅ $;

--| No entry of the motives has `∅` among its points: each point is over a
--| path with the major in front.
theorem imots_pts (G: hyps) (E D V: class) (u w p cv k: set):
  $ G ⇒ cv ∊ imots u E D w p V $ > $ G ⇒ ¬ ∅ ∈ fv cv k $;

--| So the motives as a relation have sets for values (`imrel_set`).
theorem imots_imrel_set {e: set} (G: hyps) (E D V: class) (u w p cv: set):
  $ G ⇒ cv ∊ imots u E D w p V $ > $ G ⇒ ∀ e (isset (ap (imrel D cv) e)) $;

-- --------------------------------------------------------------------------
-- The minor of a constructor
-- --------------------------------------------------------------------------

--| The minor of a constructor of a list of types is below the number of the
--| list's constructors (the numerals of the type and the constructor up to their values).
theorem minor_idx_lt (G: hyps) (tf te tc tc2 tK ty ti tj tk tn tm: set):
  $ G ⇒ ra_nth_ty ty ti tf te ∈ lrel $ > $ G ⇒ ra_minor_idx ty tj tc2 tk ∈ lrel $ > $ G ⇒ fv nvf ti = fv nvf tj $ >
  $ G ⇒ ra_ntys ty tn tm ∈ lrel $ > $ G ⇒ ra_nth_ctor te tc tK ∈ lrel $ > $ G ⇒ fv nvf tc = fv nvf tc2 $ >
  $ G ⇒ fv nvf tk ∈ fv nvf tm $;

--| The number of constructors of a block, from `ntys`.
theorem inmin_ntys_c (G: hyps) (D: class) (tb tp tt tn tm: set):
  $ G ⇒ ra_ind_data D tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ inmin D = fv nvf tm $;

--| The minor of a constructor of a block is below the number of its constructors.
theorem iminx_lt (G: hyps) (D j c k K: class) (tb tp tt tn tm: set):
  $ G ⇒ ra_ind_data D tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ictk D j c K $ > $ G ⇒ iminx D j c k $ >
  $ G ⇒ k ∈ inmin D $;

-- --------------------------------------------------------------------------
-- The fold's values lie in the motives
-- --------------------------------------------------------------------------

--| A constructor's type is a tree.
theorem ictk_tree (G: hyps) (D I C K: class): $ G ⇒ ictk D I C K $ > $ G ⇒ K ∈ trees ω $;

--| The fold relates each point to an element of its motive there: the fold
--| is a subclass of the motives as a relation. The block has its numbers of
--| types and constructors (`ntys`), and the valuations are sequences.
theorem ifold_imrel (G: hyps) (E D V: class) (u w p cv mv tb tp tt tn tm: set):
  $ G ⇒ ra_ind_data D tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ ixs D w (ifam u E D w) ∈ fseq u $ > $ G ⇒ cv ∊ imots u E D w p V $ > $ G ⇒ mv ∊ imins u E D w p cv $ >
  $ G ⇒ ifold u E D w p mv ⊆ imrel D cv $;

-- --------------------------------------------------------------------------
-- The inductive hypotheses' valuations: inhabited and unique
-- --------------------------------------------------------------------------

--| The hypotheses' valuations at `n` fields are inhabited when each recursive
--| field's space below `n` is.
--| @freshen G a
--| @freshen G d
--| @freshen G i
--| @freshen G h
--| @freshen G e
theorem ihv_inh {a d i h e: set} (G: hyps) (D K L g t: class) (n: set):
  $ G ⇒ isset t $ > $ G ⇒ ∀ a (isset (ap L a)) $ > $ G ⇒ n ∊ ω $ >
  $ G ⇒ ∀ d ∀ i (d ∊ n → irf D K d i → ∃ h (h ∊ ihsp L g t d i)) $ >
  $ G ⇒ ∃ e (e ∊ ihv D K L g t n) $;

--| Two valuations of the hypotheses at `n` fields are equal when each recursive
--| field's space below `n` has at most one element.
--| @freshen G a
--| @freshen G d
--| @freshen G i
--| @freshen G x0
--| @freshen G x1
theorem ihv_uniq {a d i x0 x1: set} (G: hyps) (D K L g t: class) (n h h2: set):
  $ G ⇒ isset t $ > $ G ⇒ ∀ a (isset (ap L a)) $ > $ G ⇒ n ∊ ω $ >
  $ G ⇒ ∀ d ∀ i ∀ x0 ∀ x1 (d ∊ n → irf D K d i → x0 ∊ ihsp L g t d i → x1 ∊ ihsp L g t d i → x0 = x1) $ >
  $ G ⇒ h ∊ ihv D K L g t n $ > $ G ⇒ h2 ∊ ihv D K L g t n $ > $ G ⇒ h = h2 $;

--| A recursive field's hypothesis space has at most one element when the relation
--| has at most one value at each of the field's points (the field's telescopes
--| `fv t d` the paths of a tree `A`).
--| @freshen G q
--| @freshen G b
--| @freshen G c
--| @freshen G e
--| @freshen G x0
--| @freshen G x1
theorem ihsp_uniq {q b c e x0 x1: set} (G: hyps) (E L g t d j A: class) (u w r h h2: set):
  $ G ⇒ A ∈ trees ω $ > $ G ⇒ fv t d = etel u E A w r $ >
  $ G ⇒ ∀ q ∀ b ∀ c ∀ e ∀ x0 ∀ x1 (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → ⟨ ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ , x0 ⟩ ∈ L → ⟨ ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ , x1 ⟩ ∈ L → x0 = x1) $ >
  $ G ⇒ h ∊ ihsp L g t d j $ > $ G ⇒ h2 ∊ ihsp L g t d j $ > $ G ⇒ h = h2 $;

--| A recursive field's hypothesis space has an element when the relation has
--| exactly one value, an element of `u`, at each of the field's points.
--| @freshen G q
--| @freshen G b
--| @freshen G c
--| @freshen G e
--| @freshen G y
--| @freshen G o
--| @freshen G h
theorem ihsp_inh {q b c e y o h: set} (G: hyps) (E L g t d j A: class) (u w r: set):
  $ G ⇒ universe u $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ fv t d = etel u E A w r $ >
  $ G ⇒ ∀ q ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → ∃ y (y ∊ u ∧ ∀ o (⟨ ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ , o ⟩ ∈ L ↔ o = y))) $ >
  $ G ⇒ ∃ h (h ∊ ihsp L g t d j) $;

--| A path of `Π A. B`: a path of `B` over an extended valuation, with `A`'s
--| paths at the head of the telescopes, the head `x` last among the fields as a
--| valuation and first among the fields in order.
--| @freshen G x
--| @freshen G f
--| @freshen G g
--| @freshen G t
theorem etel_pi_tab {x f g t: set} (G: hyps) (E: class) (u w r ta tb q1 q2 q3 q4: set):
  $ G ⇒ ta ∊ trees ω $ > $ G ⇒ tb ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r $ >
  $ G ⇒ ∃ x ∃ f ∃ g ∃ t (⟨ f , ⟨ g , ⟨ t , q4 ⟩ ⟩ ⟩ ∈ etel u E tb w (scons x r) ∧ q1 = ssnoc f x ∧ q2 = scons x g ∧ q3 = scons (etel u E ta w r) t) $;

--| A path's telescope table has, at each field, the paths of the field's type
--| at some valuation.
--| @freshen G o
theorem etel_tab {o: set} (G: hyps) (E: class) (u w r t1 t2 t3 p1 p2 p3 p4: set):
  $ G ⇒ ra_nth_pi t1 t2 t3 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ⟨ p1 , ⟨ p2 , ⟨ p3 , p4 ⟩ ⟩ ⟩ ∈ etel u E t1 w r $ >
  $ G ⇒ ∃ o (fv p3 (fv nvf t2) = etel u E t3 w o) $;

--| A path of a type with `npis` (binders over an application or a variable) is
--| determined by its fields in order.
theorem etel_det_g (G: hyps) (E: class) (u w r t1 t2 p1 p2 p3 p4 q1 q3 q4: set):
  $ G ⇒ ra_npis t1 t2 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ⟨ p1 , ⟨ p2 , ⟨ p3 , p4 ⟩ ⟩ ⟩ ∈ etel u E t1 w r $ > $ G ⇒ ⟨ q1 , ⟨ p2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u E t1 w r $ >
  $ G ⇒ p1 = q1 $;

-- --------------------------------------------------------------------------
-- The recursive fields' points
-- --------------------------------------------------------------------------

--| Two windows with the same entries are equal.
--| @freshen G i
theorem swin_sh {i: set} (G: hyps) (D D2 N R R2: class):
  $ G ⇒ ∀ i (i ∊ N → fv R (nadd D i) = fv R2 (nadd D2 i)) $ > $ G ⇒ swin R D N = swin R2 D2 N $;

--| A path of `Π A. B`, in full: `etel_pi_tab` with the head in `A`'s value and
--| in the universe.
--| @freshen G x
--| @freshen G f
--| @freshen G g
--| @freshen G t
theorem etel_pi_all {x f g t: set} (G: hyps) (E: class) (u w r ta tb q1 q2 q3 q4: set):
  $ G ⇒ ta ∊ trees ω $ > $ G ⇒ tb ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r $ >
  $ G ⇒ ∃ x ∃ f ∃ g ∃ t (x ∊ da (fv E ta) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , q4 ⟩ ⟩ ⟩ ∈ etel u E tb w (scons x r) ∧ q1 = ssnoc f x ∧ q2 = scons x g ∧ q3 = scons (etel u E ta w r) t) $;

--| A recursive field's value `v` at a path of its type: the value applied to
--| the path's fields lies in the entry of the valuation that stands for type
--| `t6`, at the path's arguments, which are the type's indices followed by
--| the window of the parameters.
--| @freshen G m
--| @freshen G e
--| @freshen G y
theorem recfield_pt {m e y: set} (G: hyps) (M: class) (u w r v t1 t2 t3 t4 t5 t6 q1 q2 q3 q4: set):
  $ G ⇒ ra_recfield t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ v ∊ dt u M t5 w r $ > $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t5 w r $ >
  $ G ⇒ nest q4 (apn v q1) ∈ fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6)) ∧ ∃ m ∃ e (ra_nidx t1 t6 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin r (fv nvf t4) (fv nvf t3)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf t3)) $;

--| Field `t2` of a path: the table has the paths of the field's type at a
--| valuation `o`, the field's value lies in the type's value there, and `o` is
--| the path's outer valuation after the earlier fields.
--| @freshen G o
--| @freshen G i
theorem etel_field {o i: set} (G: hyps) (M: class) (u w r t1 t2 t3 p1 p2 p3 p4: set):
  $ G ⇒ ra_nth_pi t1 t2 t3 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ⟨ p1 , ⟨ p2 , ⟨ p3 , p4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t1 w r $ >
  $ G ⇒ ∃ o (o ∊ fseq u ∧ fv p3 (fv nvf t2) = etel u (dnf u M) t3 w o ∧ fv p2 (fv nvf t2) ∈ dt u M t3 w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf t2) i) = fv r i)) $;

--| A point of type `ti`'s entry over a candidate inside the family: when the
--| arguments `q4` have the length of the type's indices and the parameters,
--| the candidate has a point at `q4` whose value, read as the type's elements,
--| is `y0` (the empty set for a proposition).
--| @freshen G x
--| @freshen G y
theorem ient_pt {x y: set} (G: hyps) (H J C R: class) (u w zc td tb tp tt te ti tf tc tm tl q4 y0: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tf tc ∈ lrel $ > $ G ⇒ ra_isort tf tm tl ∈ lrel $ >
  $ G ⇒ zc ⊆ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ q4 ∊ fseq {y | y = y} $ >
  $ G ⇒ cdm q4 = nadd (fv nvf tm) (fv nvf te) $ > $ G ⇒ nest q4 y0 ∈ ient td w zc (fv nvf ti) $ >
  $ G ⇒ ∃ x (⟨ fv nvf ti , ⟨ q4 , x ⟩ ⟩ ∈ zc ∧ y0 = {y | ¬ iprop td (fv nvf ti) w ∧ y ∊ x}) $;

--| The point of a recursive field: for a path of a constructor's type over a
--| candidate `zc` inside the family, a recursive field `th` on type `ti` and an
--| entry of the field's paths, the candidate has a point of type `ti` at the
--| entry's arguments whose value, read as the type's elements, is the field's
--| value at the entry; the arguments are the type's indices followed by the
--| parameters `p`.
--| @freshen G x
--| @freshen G m
--| @freshen G e
--| @freshen G y
theorem ifold_rec_pt {x m e y: set} (G: hyps) (H J C R: class) (u w p zc td tb tp tt tn tm te tk th ta ti f g t a q1 q2 q3 q4: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ zc ⊆ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ zc ∊ u $ >
  $ G ⇒ ra_nth_pi tk th ta ∈ lrel $ > $ G ⇒ ra_recfield td tn te th ta ti ∈ lrel $ >
  $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat p (ixs td w zc)) $ > $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ fv t (fv nvf th) $ >
  $ G ⇒ ∃ x ∃ m ∃ e (⟨ fv nvf ti , ⟨ q4 , x ⟩ ⟩ ∈ zc ∧ apn (fv g (fv nvf th)) q1 = {y | ¬ iprop td (fv nvf ti) w ∧ y ∊ x} ∧ ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e p) $;

--| A universe has the values of its curried traces.
theorem apn_universe (G: hyps) (U A: class) (v s: set):
  $ G ⇒ universe U $ > $ G ⇒ v ∊ U $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ apn v s ∈ U $;

--| The number of a type's indices depends on the type's number only.
theorem nidx_nvf (G: hyps) (t1 t2 t3 t4 t5: set):
  $ G ⇒ ra_nidx t1 t2 t3 ∈ lrel $ > $ G ⇒ ra_nidx t1 t4 t5 ∈ lrel $ > $ G ⇒ fv nvf t2 = fv nvf t4 $ > $ G ⇒ t3 = t5 $;

--| A constructor type's paths over the parameters `p` and the types valued
--| by a candidate are monotone in the candidate.
theorem etel_ixs_mono (G: hyps) (J M Z Z2: class) (u w p td tn te tl ti tx tk: set):
  $ G ⇒ ra_cwf td tn te tl ti tx ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J $ > $ G ⇒ uadm u $ > $ G ⇒ td ∊ trees ω $ > $ G ⇒ tk ∊ trees ω $ >
  $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = fv nvf te $ > $ G ⇒ Z2 ∈ u $ > $ G ⇒ Z2 ⊆ ω × (fseq u × fseq (ω ∪ u)) $ > $ G ⇒ Z ⊆ Z2 $ >
  $ G ⇒ etel u (dnf u M) tk w (scat p (ixs td w Z)) ⊆ etel u (dnf u M) tk w (scat p (ixs td w Z2)) $;

--| A path of a constructor's type: its arguments are the indices of the
--| constructor's type followed by the window of the parameters.
--| @freshen G m
--| @freshen G e
--| @freshen G y
theorem cwf_args {m e y: set} (G: hyps) (J M: class) (u w r t1 t2 t3 t4 t5 t6 t7 t8 q1 q2 q3 q4: set):
  $ G ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel3 J $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r $ > $ G ⇒ t8 ∊ trees ω $ > $ G ⇒ t7 ∊ trees ω $ >
  $ G ⇒ ∃ m ∃ e (ra_nidx t1 t5 m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin r (fv nvf t7) (fv nvf t3)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf t3)) $;

--| Two paths of a constructor's type at one valuation with the same fields in
--| order have the same fields as a valuation (`etel_det_g` from `cwf`).
theorem etel_det_cwf (G: hyps) (J M: class) (u w r t1 t2 t3 t4 t5 t6 t7 t8 p1 p2 p3 p4 q1 q3 q4: set):
  $ G ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel3 J $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ t8 ∊ trees ω $ >
  $ G ⇒ ⟨ p1 , ⟨ p2 , ⟨ p3 , p4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r $ > $ G ⇒ ⟨ q1 , ⟨ p2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t8 w r $ >
  $ G ⇒ p1 = q1 $;

-- --------------------------------------------------------------------------
-- A minor for every constructor
-- --------------------------------------------------------------------------

--| Every natural number is the value of a numeral.
--| @freshen G b
theorem num_ex {b: set} (G: hyps) (n: set): $ G ⇒ n ∊ ω $ > $ G ⇒ ∃ b (b ∊ ofsort lsig lopen ks_nat ∧ fv nvf b = n) $;

--| The number of a list of constructors is a numeral.
theorem clen_c_nat (G: hyps) (t1 t2: set): $ G ⇒ ra_clen_c t1 t2 ∈ lrel $ > $ G ⇒ t2 ∊ ofsort lsig lopen ks_nat $;

--| Addition is total on numerals.
--| @freshen G c
theorem add_total {c: set} (G: hyps) (t1 t2: set): $ G ⇒ t1 ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ t2 ∊ ofsort lsig lopen ks_nat $ > $ G ⇒ ∃ c (ra_add t1 t2 c ∈ lrel ∧ c ∊ ofsort lsig lopen ks_nat) $;

--| An existing type has a minor index for every numeral (taken as a
--| constructor's number).
--| @freshen G k
theorem minor_idx_total {k: set} (G: hyps) (t1 t2 tf te tn tm tb: set):
  $ G ⇒ ra_nth_ty t1 t2 tf te ∈ lrel $ > $ G ⇒ ra_ntys t1 tn tm ∈ lrel $ > $ G ⇒ tb ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ ∃ k (ra_minor_idx t1 t2 tb k ∈ lrel ∧ k ∊ ofsort lsig lopen ks_nat) $;

--| Every existing constructor has a minor.
--| @freshen G k
theorem iminx_ex {k: set} (G: hyps) (j c K: class) (td tb tp tt tn tm: set):
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ > $ G ⇒ ictk td j c K $ >
  $ G ⇒ ∃ k (iminx td j c k) $;

-- --------------------------------------------------------------------------
-- The fold's single value: the inductive hypotheses at a path
-- --------------------------------------------------------------------------

--| A single value at a point, at an equal point.
--| @freshen G v
--| @freshen G o
theorem uval_eq {v o: set} (G: hyps) (A B L: class) (u: set):
  $ G ⇒ A = B $ > $ G ⇒ ∃ v (v ∊ u ∧ ∀ o (⟨ A , o ⟩ ∈ L ↔ o = v)) $ > $ G ⇒ ∃ v (v ∊ u ∧ ∀ o (⟨ B , o ⟩ ∈ L ↔ o = v)) $;

--| The fold's value at a recursive field's point: when a relation `L` has a
--| single value at every point of the candidate over the parameters `p`, it
--| has one at the point of each entry of a recursive field of a path.
--| @freshen G i
--| @freshen G a
--| @freshen G x
--| @freshen G e
--| @freshen G m
--| @freshen G v
--| @freshen G o
--| @freshen G y
theorem ifold_rec_val {i a x e m v o y: set} (G: hyps) (H J C R L: class) (u w p zc td tb tp tt tn tm te tk th ta ti pf pg pt pa q1 q2 q3 q4: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ zc ⊆ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ zc ∊ u $ >
  $ G ⇒ ra_nth_pi tk th ta ∈ lrel $ > $ G ⇒ ra_recfield td tn te th ta ti ∈ lrel $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat p (ixs td w zc)) $ > $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ fv pt (fv nvf th) $ >
  $ G ⇒ ∀ i ∀ a ∀ x ∀ e ∀ m (⟨ fv nvf i , ⟨ a , x ⟩ ⟩ ∈ zc → a = scat e p → ra_nidx td i m ∈ lrel → e ∊ fseq {y | y = y} → cdm e = fv nvf m → ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf i , ⟨ a , {y | ¬ iprop td (fv nvf i) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ L ↔ o = v))) $ >
  $ G ⇒ ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf ti , ⟨ q4 , apn (fv pg (fv nvf th)) q1 ⟩ ⟩ , o ⟩ ∈ L ↔ o = v)) $;

--| A recursive field's hypothesis at a path: under `ifold_rec_val`'s
--| conditions it exists and is unique.
--| @freshen G i
--| @freshen G a
--| @freshen G x
--| @freshen G e
--| @freshen G m
--| @freshen G v
--| @freshen G o
--| @freshen G y
--| @freshen G h
--| @freshen G k
theorem ifold_ihsp {i a x e m v o y h k: set} (G: hyps) (H J C R L: class) (u w p zc td tb tp tt tn tm te tk pf pg pt pa sd si: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ zc ⊆ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ zc ∊ u $ >
  $ G ⇒ tk ∊ trees ω $ > $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat p (ixs td w zc)) $ >
  $ G ⇒ ∀ i ∀ a ∀ x ∀ e ∀ m (⟨ fv nvf i , ⟨ a , x ⟩ ⟩ ∈ zc → a = scat e p → ra_nidx td i m ∈ lrel → e ∊ fseq {y | y = y} → cdm e = fv nvf m → ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf i , ⟨ a , {y | ¬ iprop td (fv nvf i) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ L ↔ o = v))) $ >
  $ G ⇒ irf td tk sd si $ >
  $ G ⇒ (∃ h (h ∊ ihsp L pg pt sd si)) ∧ ∀ h ∀ k (h ∊ ihsp L pg pt sd si → k ∊ ihsp L pg pt sd si → h = k) $;

--| The inductive hypotheses' valuation at a path: under `ifold_rec_val`'s
--| conditions it exists and is unique.
--| @freshen G i
--| @freshen G a
--| @freshen G x
--| @freshen G e
--| @freshen G m
--| @freshen G v
--| @freshen G o
--| @freshen G y
--| @freshen G h
--| @freshen G k
--| @freshen G b
theorem ifold_ihv {i a x e m v o y h k b: set} (G: hyps) (H J C R L: class) (u w p zc td tb tp tt tn tm te tk pf pg pt pa: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ zc ⊆ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ zc ∊ u $ >
  $ G ⇒ tk ∊ trees ω $ > $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat p (ixs td w zc)) $ >
  $ G ⇒ ∀ i ∀ a ∀ x ∀ e ∀ m (⟨ fv nvf i , ⟨ a , x ⟩ ⟩ ∈ zc → a = scat e p → ra_nidx td i m ∈ lrel → e ∊ fseq {y | y = y} → cdm e = fv nvf m → ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf i , ⟨ a , {y | ¬ iprop td (fv nvf i) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ L ↔ o = v))) $ >
  $ G ⇒ ∀ b (isset (ap L b)) $ >
  $ G ⇒ (∃ h (h ∊ ihv td tk L pg pt (cdm pf))) ∧ ∀ h ∀ k (h ∊ ihv td tk L pg pt (cdm pf) → k ∊ ihv td tk L pg pt (cdm pf) → h = k) $;

--| A binder's value in a valuation over an admissible universe lies in it.
theorem vat_universe (G: hyps) (U N j: class) (s: set):
  $ G ⇒ uadm U $ > $ G ⇒ s ∊ fseq U $ > $ G ⇒ j ∈ N $ > $ G ⇒ N ∈ ω $ > $ G ⇒ vat s N j ∈ U $;

--| The fiber: a constructor's path whose arguments are a type's indices
--| followed by the parameters `p` is a path over `p`.
--| @freshen G y
theorem iop0_fiber {y: set} (G: hyps) (H J C R Z: class) (u w p p2 td tb tp tt te tk sj sc ti tq se pf pg pt pa: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ p2 ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ ictk td sj sc tk $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat p2 (ixs td w Z)) $ > $ G ⇒ pa = scat se p $ >
  $ G ⇒ ra_nidx td ti tq ∈ lrel $ > $ G ⇒ fv nvf ti = sj $ > $ G ⇒ se ∊ fseq {y | y = y} $ > $ G ⇒ cdm se = fv nvf tq $ >
  $ G ⇒ p2 = p $;

--| The fold's step is single-valued: at the point of a constructor's path
--| over the parameters, any value of the fold is the minor's value at the
--| path and its hypotheses. For a proposition, either every value is empty or
--| the point determines the constructor and its fields (the two forms of
--| elimination).
--| @freshen G i
--| @freshen G a
--| @freshen G x
--| @freshen G e
--| @freshen G m
--| @freshen G v
--| @freshen G o
--| @freshen G y
--| @freshen G h
--| @freshen G k
--| @freshen G b
--| @freshen G j
theorem ifold_step_uniq {i a x e m v o y h k b j: set} (G: hyps) (H J C R: class) (u w p zc mv td tb tp tt tn tm te tk sj sc k1 h1 y1 o1 pf pg pt pa: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ zc ⊆ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ zc ∊ u $ >
  $ G ⇒ ∀ i ∀ a ∀ x ∀ e ∀ m (⟨ fv nvf i , ⟨ a , x ⟩ ⟩ ∈ zc → a = scat e p → ra_nidx td i m ∈ lrel → e ∊ fseq {y | y = y} → cdm e = fv nvf m → ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf i , ⟨ a , {y | ¬ iprop td (fv nvf i) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v))) $ >
  $ G ⇒ (∀ j ∀ a ∀ o (iprop td j w → ⟨ ⟨ j , ⟨ a , ∅ ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv → o = ∅)) ∨ ∀ j ∀ a ∀ b ∀ k ∀ h ∀ x ∀ y ∀ v ∀ e ∀ i ∀ m ∀ o (iprop td j w → ictk td j a k → ictk td j b h → ⟨ x , ⟨ y , ⟨ v , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → ⟨ i , ⟨ m , ⟨ o , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) h w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → a = b ∧ y = m) $ >
  $ G ⇒ ictk td sj sc tk $ > $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat p (ixs td w zc)) $ >
  $ G ⇒ h1 ∊ ihv td tk (ifold u (dnf u (mcv H)) td w p mv) pg pt (cdm pf) $ > $ G ⇒ iminx td sj sc k1 $ >
  $ G ⇒ y1 = apn (vat mv (inmin td) k1) (scat h1 pf) $ >
  $ G ⇒ ⟨ ⟨ sj , ⟨ pa , itup td sj sc pg w ⟩ ⟩ , y1 ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv $ > $ G ⇒ ⟨ ⟨ sj , ⟨ pa , itup td sj sc pg w ⟩ ⟩ , o1 ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv $ >
  $ G ⇒ o1 = y1 $;

--| The fold at the point of a constructor's path over the parameters has
--| exactly one value, an element of the universe, when it has one at every
--| point of the candidate over the parameters.
--| @freshen G i
--| @freshen G a
--| @freshen G x
--| @freshen G e
--| @freshen G m
--| @freshen G v
--| @freshen G o
--| @freshen G y
--| @freshen G h
--| @freshen G k
--| @freshen G b
--| @freshen G j
theorem ifold_pt_val {i a x e m v o y h k b j: set} (G: hyps) (H J C R: class) (u w p zc mv td tb tp tt tn tm te tk sj sc pf pg pt pa: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ zc ⊆ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ zc ∊ u $ >
  $ G ⇒ ∀ i ∀ a ∀ x ∀ e ∀ m (⟨ fv nvf i , ⟨ a , x ⟩ ⟩ ∈ zc → a = scat e p → ra_nidx td i m ∈ lrel → e ∊ fseq {y | y = y} → cdm e = fv nvf m → ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf i , ⟨ a , {y | ¬ iprop td (fv nvf i) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v))) $ >
  $ G ⇒ (∀ j ∀ a ∀ o (iprop td j w → ⟨ ⟨ j , ⟨ a , ∅ ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv → o = ∅)) ∨ ∀ j ∀ a ∀ b ∀ k ∀ h ∀ x ∀ y ∀ v ∀ e ∀ i ∀ m ∀ o (iprop td j w → ictk td j a k → ictk td j b h → ⟨ x , ⟨ y , ⟨ v , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → ⟨ i , ⟨ m , ⟨ o , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) h w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → a = b ∧ y = m) $ >
  $ G ⇒ mv ∊ fseq u $ > $ G ⇒ ictk td sj sc tk $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat p (ixs td w zc)) $ > $ G ⇒ ⟨ sj , ⟨ pa , scons sc pg ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w $ >
  $ G ⇒ ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ sj , ⟨ pa , itup td sj sc pg w ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v)) $;

--| The step of the fold's single value: a point of the operator's value at a
--| candidate, over the parameters, has exactly one value under the fold when
--| the candidate's points over the parameters do.
--| @freshen G i
--| @freshen G a
--| @freshen G x
--| @freshen G e
--| @freshen G m
--| @freshen G v
--| @freshen G o
--| @freshen G y
--| @freshen G h
--| @freshen G k
--| @freshen G b
--| @freshen G j
theorem ifold_step {i a x e m v o y h k b j: set} (G: hyps) (H J C R: class) (u w p zc mv td tb tp tt tn tm te ti tq sk sa sx se: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ zc ⊆ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ zc ∊ u $ >
  $ G ⇒ ∀ i ∀ a ∀ x ∀ e ∀ m (⟨ fv nvf i , ⟨ a , x ⟩ ⟩ ∈ zc → a = scat e p → ra_nidx td i m ∈ lrel → e ∊ fseq {y | y = y} → cdm e = fv nvf m → ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf i , ⟨ a , {y | ¬ iprop td (fv nvf i) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v))) $ >
  $ G ⇒ (∀ j ∀ a ∀ o (iprop td j w → ⟨ ⟨ j , ⟨ a , ∅ ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv → o = ∅)) ∨ ∀ j ∀ a ∀ b ∀ k ∀ h ∀ x ∀ y ∀ v ∀ e ∀ i ∀ m ∀ o (iprop td j w → ictk td j a k → ictk td j b h → ⟨ x , ⟨ y , ⟨ v , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → ⟨ i , ⟨ m , ⟨ o , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) h w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → a = b ∧ y = m) $ >
  $ G ⇒ mv ∊ fseq u $ > $ G ⇒ sk ∊ iop0 u (dnf u (mcv H)) td w zc $ >
  $ G ⇒ sk = ⟨ fv nvf ti , ⟨ sa , sx ⟩ ⟩ $ > $ G ⇒ sa = scat se p $ >
  $ G ⇒ ra_nidx td ti tq ∈ lrel $ > $ G ⇒ se ∊ fseq {y | y = y} $ > $ G ⇒ cdm se = fv nvf tq $ >
  $ G ⇒ ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf ti , ⟨ sa , {y | ¬ iprop td (fv nvf ti) w ∧ y ∊ sx} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v)) $;

--| The fold is single-valued on the family over the parameters `p` (with
--| values in the universe): at a point of type `i` whose arguments are the
--| type's indices followed by `p`, read as the type's elements. For a
--| proposition this needs one of the two forms of elimination: every value
--| of the fold at a proposition's point is empty, or a proposition's point
--| determines its constructor and fields.
--| @freshen G i
--| @freshen G a
--| @freshen G x
--| @freshen G e
--| @freshen G m
--| @freshen G v
--| @freshen G o
--| @freshen G y
--| @freshen G h
--| @freshen G k
--| @freshen G b
--| @freshen G j
theorem ifold_fn {i a x e m v o y h k b j: set} (G: hyps) (H J C R: class) (u w p mv td tb tp tt tn tm te: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ mv ∊ fseq u $ >
  $ G ⇒ (∀ j ∀ a ∀ o (iprop td j w → ⟨ ⟨ j , ⟨ a , ∅ ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv → o = ∅)) ∨ ∀ j ∀ a ∀ b ∀ k ∀ h ∀ x ∀ y ∀ v ∀ e ∀ i ∀ m ∀ o (iprop td j w → ictk td j a k → ictk td j b h → ⟨ x , ⟨ y , ⟨ v , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → ⟨ i , ⟨ m , ⟨ o , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) h w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → a = b ∧ y = m) $ >
  $ G ⇒ ∀ i ∀ a ∀ x ∀ e ∀ m (⟨ fv nvf i , ⟨ a , x ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w → a = scat e p → ra_nidx td i m ∈ lrel → e ∊ fseq {y | y = y} → cdm e = fv nvf m → ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf i , ⟨ a , {y | ¬ iprop td (fv nvf i) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ o = v))) $;

-- --------------------------------------------------------------------------
-- The fold's values in the motives
-- --------------------------------------------------------------------------

--| A concatenation restricted to its first part's length is that part.
theorem cres_scat_l (G: hyps) (A: class) (s t: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ cres (scat s t) (cdm s) = s $;

--| The number of a type's indices, as a set.
theorem inidx_val (G: hyps) (td ti tm: set):
  $ G ⇒ ra_nidx td ti tm ∈ lrel $ > $ G ⇒ inidx td (fv nvf ti) = fv nvf tm $;

--| A constructor's value is a set.
theorem itup_set (G: hyps) (D i c g W: class): $ G ⇒ isset g $ > $ G ⇒ isset (itup D i c g W) $;

--| A point of the family gives an element of its type at its arguments: the
--| constructor's value.
theorem ifam_pt_ity (G: hyps) (H: class) (u w td sj sa sc sg: set):
  $ G ⇒ ⟨ sj , ⟨ sa , scons sc sg ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ itup td sj sc sg w ∈ apn (ity u (dnf u (mcv H)) td sj w) sa $;

--| A point of the family over the parameters `p`: its indices are a path of
--| the type's type at `p`.
--| @freshen G g
--| @freshen G t
--| @freshen G a
--| @freshen G y
theorem ifam_pt_tel {g t a y: set} (G: hyps) (H J C R X: class) (u w p td tb tp tt te ti tf tc tq tl sj sa se: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ ⟨ sj , ⟨ sa , X ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w $ > $ G ⇒ sa = scat se p $ >
  $ G ⇒ ra_nth_ty tt ti tf tc ∈ lrel $ > $ G ⇒ fv nvf ti = sj $ > $ G ⇒ ra_isort tf tq tl ∈ lrel $ >
  $ G ⇒ se ∊ fseq {y | y = y} $ > $ G ⇒ cdm se = fv nvf tq $ >
  $ G ⇒ ∃ g ∃ t ∃ a (⟨ se , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tf w p) $;

--| A point with a value under the fold: a point of the family at a type's
--| indices followed by the parameters, with a constructor's value.
--| @freshen G i
--| @freshen G m
--| @freshen G e
--| @freshen G c
--| @freshen G g
--| @freshen G y
theorem ifold_pt_shape {i m e c g y: set} (G: hyps) (H J C R: class) (u w p mv td tb tp tt te sj sa sx so: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ > $ G ⇒ ⟨ ⟨ sj , ⟨ sa , sx ⟩ ⟩ , so ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv $ >
  $ G ⇒ ∃ i ∃ m ∃ e ∃ c ∃ g (fv nvf i = sj ∧ ra_nidx td i m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ sa = scat e p ∧ ⟨ sj , ⟨ sa , scons c g ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ sx = itup td sj c g w) $;

--| The fold's values lie in the motives: a value at a point is an element of
--| the point's motive at the point's indices and value, and that motive's
--| value is an element of the motives' universe.
--| @freshen G e
theorem ifold_motive {e: set} (G: hyps) (H J C R V: class) (u w p cv mv td tb tp tt tn tm te sj sa sx so: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p V $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ > $ G ⇒ ⟨ ⟨ sj , ⟨ sa , sx ⟩ ⟩ , so ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv $ >
  $ G ⇒ ∃ e (sa = scat e p ∧ so ∊ apn (vat cv (intys td) sj) (scons sx e) ∧ apn (vat cv (intys td) sj) (scons sx e) ∈ fv uni V) $;

--| With motives at level `0`, every value of the fold is empty (the first form
--| of elimination for `ifold_fn`).
--| @freshen G j
--| @freshen G a
--| @freshen G o
theorem ifold_zero {j a o: set} (G: hyps) (H J C R: class) (u w p cv mv td tb tp tt tn tm te: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p ∅ $ > $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ∀ j ∀ a ∀ o (iprop td j w → ⟨ ⟨ j , ⟨ a , ∅ ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv → o = ∅) $;

-- --------------------------------------------------------------------------
-- Large elimination: a proposition's paths with the same arguments (E9)
-- --------------------------------------------------------------------------

--| A path of an application: no fields, and the argument's value first among
--| the arguments of a path of the function (`b` names the empty set).
--| @freshen G a
--| @freshen G b
theorem etel_app_elim {a b: set} (G: hyps) (E: class) (u w r ta tb q1 q2 q3 q4: set):
  $ G ⇒ ta ∊ trees ω $ > $ G ⇒ tb ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u E ⟨ kc_app , scons ta (scons tb ∅) ⟩ w r $ >
  $ G ⇒ ∃ a ∃ b (b = ∅ ∧ ⟨ b , ⟨ b , ⟨ b , a ⟩ ⟩ ⟩ ∈ etel u E ta w r ∧ q2 = b ∧ q4 = scons (da (fv E tb) w r) a) $;

--| An argument of an application has the same value at two valuations when the
--| paths there have the same arguments.
--| @freshen G x0
theorem has_arg_val {x0: set} (G: hyps) (M: class) (u w r1 r2 t1 t2 o1 o2 p1 p2 p3 q1 q2 q3: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ r1 ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ > $ G ⇒ ra_has_arg t1 t2 ∈ lrel $ > $ G ⇒ ⟨ p1 , ⟨ p2 , ⟨ p3 , o1 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t1 w r1 $ > $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , o2 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t1 w r2 $ > $ G ⇒ ∀ x0 (fv o1 x0 = fv o2 x0) $ >
  $ G ⇒ dt u M t2 w r1 = dt u M t2 w r2 $;

--| An element of a truth value is the empty set.
theorem two_mem_empty (G: hyps) (A: class) (x: set): $ G ⇒ A ∈ two $ > $ G ⇒ x ∊ A $ > $ G ⇒ x = ∅ $;

--| The value of a term closed at a depth does not read the valuation past that depth (`closed_etel_scat` for values).
theorem closed_dt_scat (G: hyps) (M: class) (u w k e q v r: set):
  $ G ⇒ ra_closed k e ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ fv nvf k = nadd (cdm q) (cdm v) $ > $ G ⇒ dt u M e w (scat q (scat v r)) = dt u M e w (scat q v) $;

--| A variable among the leaf's arguments of `Π A. B` is its successor among those of `B`.
theorem leaf_has_pi_inv (G: hyps) (t1 t2 ta tb: set):
  $ G ⇒ ra_leaf_has t1 t2 ∈ lrel $ > $ G ⇒ t2 = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ $ > $ G ⇒ ra_leaf_has ⟨ kc_s , scons t1 ∅ ⟩ tb ∈ lrel $;

--| A variable among the leaf's arguments of a term with a path without fields is an
--| argument of the term (`z` names the variable).
--| @freshen G z
theorem leaf_has_nopi {z: set} (G: hyps) (E: class) (u w r t1 t2 q1 q2 q3 q4: set):
  $ G ⇒ ra_leaf_has t1 t2 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u E t2 w r $ > $ G ⇒ q2 = ∅ $ > $ G ⇒ ∃ z (z = ⟨ kc_bvar , scons t1 ∅ ⟩ ∧ ra_has_arg t2 z ∈ lrel) $;

--| The walk over `fir`: two paths of the rest `t0` of a constructor's type with the
--| same arguments `o0`, at valuations `q0`, `r0` of the earlier fields and the
--| parameters (followed by the types' values `v` for the paths, by the context's
--| valuation `s` for the typings), have the same fields, and the valuations agree
--| at the variables among the result's arguments. `tz`, `ts` name `0` and `1`.
--| @freshen G x3
--| @freshen G x4
--| @freshen G x5
theorem fir_fields {x3 x4 x5: set} (G: hyps) (J M: class) (u w v s t1 t3 tz ts: set) (t0 c0 d0 n0 q0 r0 e0 g0 p1 p2 p3 p5 p6 p7 o0: set):
  $ G ⇒ jval u M J $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ v ∊ fseq u $ >
  $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ t1 ∊ trees ω $ >
  $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ >
  $ G ⇒ ts = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ >
  $ G ⇒ nadd (fv nvf tz) (cdm v) = fv nvf ts $ >
  $ G ⇒ ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → fv nvf x5 = nadd (fv nvf tz) x4 → dt u M ⟨ kc_ind_ty , scons t1 (scons x5 ∅) ⟩ w ∅ = fv v x4) $ >
  $ G ⇒ ra_fir t1 t3 c0 d0 t0 ∈ lrel3 J $ >
  $ G ⇒ c0 ∊ trees ω $ >
  $ G ⇒ ra_closed n0 t0 ∈ lrel $ >
  $ G ⇒ q0 ∊ fseq u $ >
  $ G ⇒ r0 ∊ fseq u $ >
  $ G ⇒ cdm q0 = nadd (fv nvf d0) (fv nvf t3) $ >
  $ G ⇒ cdm r0 = cdm q0 $ >
  $ G ⇒ fv nvf n0 = nadd (cdm q0) (cdm v) $ >
  $ G ⇒ scat q0 s ∈ sat u M c0 w $ >
  $ G ⇒ scat r0 s ∈ sat u M c0 w $ >
  $ G ⇒ e0 = scat q0 v $ >
  $ G ⇒ g0 = scat r0 v $ >
  $ G ⇒ ⟨ p1 , ⟨ p2 , ⟨ p3 , o0 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w e0 $ >
  $ G ⇒ ⟨ p5 , ⟨ p6 , ⟨ p7 , o0 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) t0 w g0 $ >
  $ G ⇒ p2 = p6 ∧ ∀ x3 (ra_leaf_has x3 t0 ∈ lrel → fv e0 (fv nvf x3) = fv g0 (fv nvf x3)) $;

--| The value of a block's type is its entry in the family's valuation `v` (the
--| hypothesis of `lrel_sinst_sem` at the family; `tz` names `0`).
theorem ixs_ind_ty {x4 x5: set} (G: hyps) (H J C R: class) (u w td v tz: set):
  $ G ⇒ iwf u H J C td w R $ > $ G ⇒ v = ixs td w (ifam u (dnf u (mcv H)) td w) $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ >
  $ G ⇒ ∀ x4 ∀ x5 (x4 ∊ cdm v → x5 ∊ trees ω → fv nvf x5 = nadd (fv nvf tz) x4 → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons x5 ∅) ⟩ w ∅ = fv v x4) $;

--| The types of a block with one type.
theorem nth_ty_single (G: hyps) (TF TC: class) (t n f e: set):
  $ G ⇒ ra_nth_ty t n f e ∈ lrel $ > $ G ⇒ t = ⟨ kc_tcons , scons TF (scons TC (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ > $ G ⇒ isset TF $ > $ G ⇒ isset TC $ > $ G ⇒ n = ⟨ kc_nz , ∅ ⟩ ∧ f = TF ∧ e = TC $;

--| No constructor in an empty list.
theorem nth_ctor_nil (G: hyps) (e m k: set): $ G ⇒ ra_nth_ctor e m k ∈ lrel $ > $ G ⇒ e = ⟨ kc_cnil , ∅ ⟩ $ > $ G ⇒ ⊥ $;

--| The constructor of a one-constructor list.
theorem nth_ctor_single (G: hyps) (TK: class) (e m k: set):
  $ G ⇒ ra_nth_ctor e m k ∈ lrel $ > $ G ⇒ e = ⟨ kc_ccons , scons TK (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ $ > $ G ⇒ isset TK $ > $ G ⇒ m = ⟨ kc_nz , ∅ ⟩ ∧ k = TK $;

--| A block with one type has one type.
theorem ntys_single (G: hyps) (TF TC: class) (t n k: set):
  $ G ⇒ ra_ntys t n k ∈ lrel $ > $ G ⇒ t = ⟨ kc_tcons , scons TF (scons TC (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ > $ G ⇒ isset TF $ > $ G ⇒ isset TC $ > $ G ⇒ n = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $;

--| The constructors of a block with one type and one constructor.
theorem single_ictk (G: hyps) (td tb tp tt tf tk j c k: set):
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ tt = ⟨ kc_tcons , scons tf (scons ⟨ kc_ccons , scons tk (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ > $ G ⇒ ictk td j c k $ > $ G ⇒ c = ∅ ∧ k = tk $;

--| A block with one type and no constructor has no constructor.
theorem empty_ictk (G: hyps) (td tb tp tt tf j c k: set):
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ tt = ⟨ kc_tcons , scons tf (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ > $ G ⇒ ictk td j c k $ > $ G ⇒ ⊥ $;

--| A level that absorbs `1` is not `0` at any valuation.
theorem large_nz_level (G: hyps) (w tl: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ tl ∊ trees ω $ > $ G ⇒ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons tl ∅) ⟩ tl $ > $ G ⇒ ¬ lv tl w = ∅ $;

--| The constructor's type of a well-formed block with one type and one constructor
--| is closed past the parameters and the types.
--| @freshen G x
theorem tys_wf_single_closed {x: set} (G: hyps) (J: class) (td tn tm tl ta tc tt tf tk tb tp te: set):
  $ G ⇒ ra_tys_wf td tn tm tl ta tc tt ∈ lrel3 J $ > $ G ⇒ tt = ⟨ kc_tcons , scons tf (scons ⟨ kc_ccons , scons tk (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ ∃ x (ra_closed x tk ∈ lrel ∧ fv nvf x = nadd (fv nvf te) (fv nvf tn)) $;

--| A well-formed block with one type and one constructor: the constructor's type is
--| closed past the parameters and the type, there is one type, and the parameters'
--| telescope does not read the outer valuation.
--| @freshen G x
--| @freshen G z
theorem single_block {x z: set} (G: hyps) (H J R: class) (u w tc td tb tp tt tf tk te: set):
  $ G ⇒ iwf u H J tc td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ tt = ⟨ kc_tcons , scons tf (scons ⟨ kc_ccons , scons tk (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ > $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ (∃ x (ra_closed x tk ∈ lrel ∧ fv nvf x = nadd (fv nvf te) (suc ∅))) ∧ intys td = suc ∅ ∧ ∀ z (z ∊ fseq u → esat u (dsh u (mcv H) z) tp w = esat u (dnf u (mcv H)) tp w) $;

--| No type of a well-formed block is a proposition when the first type's level absorbs `1`
--| (`tz` names `0`).
theorem large_nz_noprop (G: hyps) (H J R K: class) (u w tc td tb tp tt tz tf tq tk tl: set):
  $ G ⇒ iwf u H J tc td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_nth_ty tt tz tf tq ∈ lrel $ > $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ >
  $ G ⇒ ra_isort tf tk tl ∈ lrel $ > $ G ⇒ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons tl ∅) ⟩ tl $ > $ G ⇒ ¬ iprop td K w $;

--| Large elimination for one type with one constructor (`fir`): two paths of the
--| constructor over the parameters `p` with the same arguments have the same fields.
--| @freshen G j
--| @freshen G a
--| @freshen G b
--| @freshen G k
--| @freshen G h
--| @freshen G x
--| @freshen G y
--| @freshen G v
--| @freshen G e
--| @freshen G i
--| @freshen G m
--| @freshen G o
theorem large_single_paths {j a b k h x y v e i m o: set} (G: hyps) (H J R: class) (u w p tc td tb tp tt tf tk te tg: set):
  $ G ⇒ iwf u H J tc td w R $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ tt = ⟨ kc_tcons , scons tf (scons ⟨ kc_ccons , scons tk (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ > $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ ra_capp tp tc tg ∈ lrel $ > $ G ⇒ ra_fir td te tg ⟨ kc_nz , ∅ ⟩ tk ∈ lrel3 J $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ ∀ j ∀ a ∀ b ∀ k ∀ h ∀ x ∀ y ∀ v ∀ e ∀ i ∀ m ∀ o (iprop td j w → ictk td j a k → ictk td j b h → ⟨ x , ⟨ y , ⟨ v , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → ⟨ i , ⟨ m , ⟨ o , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) h w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → a = b ∧ y = m) $;

--| Large elimination (`large`): at a proposition, two constructor paths over the
--| parameters `p` with the same arguments have the same constructor and fields
--| (no type is a proposition, or there is no constructor, or one whose fields are
--| propositions or arguments of its result).
--| @freshen G j
--| @freshen G a
--| @freshen G b
--| @freshen G k
--| @freshen G h
--| @freshen G x
--| @freshen G y
--| @freshen G v
--| @freshen G e
--| @freshen G i
--| @freshen G m
--| @freshen G o
theorem large_paths {j a b k h x y v e i m o: set} (G: hyps) (H J R: class) (u w p tc td tb tp tt te: set):
  $ G ⇒ iwf u H J tc td w R $ > $ G ⇒ ra_large tc td ∈ lrel3 J $ > $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ > $ G ⇒ ra_clen tp te ∈ lrel $ > $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ ∀ j ∀ a ∀ b ∀ k ∀ h ∀ x ∀ y ∀ v ∀ e ∀ i ∀ m ∀ o (iprop td j w → ictk td j a k → ictk td j b h → ⟨ x , ⟨ y , ⟨ v , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → ⟨ i , ⟨ m , ⟨ o , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) h w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → a = b ∧ y = m) $;

--| `elim_ok` gives `ifold_fn`'s elimination hypothesis: the motives are at level `0`
--| (every value of the fold at a proposition is `∅`), or the block eliminates into
--| every sort (`large_paths`).
--| @freshen G j
--| @freshen G a
--| @freshen G b
--| @freshen G k
--| @freshen G h
--| @freshen G x
--| @freshen G y
--| @freshen G v
--| @freshen G e
--| @freshen G i
--| @freshen G m
--| @freshen G o
theorem ifold_elim_ok {j a b k h x y v e i m o: set} (G: hyps) (H J R: class) (u w p cv mv tc td tb tp tt tn tm te tv: set):
  $ G ⇒ iwf u H J tc td w R $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tc td tv ∈ lrel3 J $ >
  $ G ⇒ (∀ j ∀ a ∀ o (iprop td j w → ⟨ ⟨ j , ⟨ a , ∅ ⟩ ⟩ , o ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv → o = ∅)) ∨ ∀ j ∀ a ∀ b ∀ k ∀ h ∀ x ∀ y ∀ v ∀ e ∀ i ∀ m ∀ o (iprop td j w → ictk td j a k → ictk td j b h → ⟨ x , ⟨ y , ⟨ v , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) k w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → ⟨ i , ⟨ m , ⟨ o , e ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) h w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) → a = b ∧ y = m) $;

-- --------------------------------------------------------------------------
-- The recursor's value in its type, semantically (E5)
-- --------------------------------------------------------------------------

--| The fold's value at a major premise `sx` of type `ti` at the indices `sf` (a path
--| of the type's type over the parameters `p`) is an element of the motive there:
--| the recursor's value lies in its motive, for motives `cv` at the level of `tv`
--| and minors `mv`, when the block eliminates into that level (`elim_ok`).
theorem irc_val (G: hyps) (H J R: class) (u w p cv mv tc td tb tp tt tn tm te tv ti tf tq tk tl sf sg st sa sx: set):
  $ G ⇒ iwf u H J tc td w R $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tc td tv ∈ lrel3 J $ >
  $ G ⇒ ra_nth_ty tt ti tf tq ∈ lrel $ >
  $ G ⇒ ra_isort tf tk tl ∈ lrel $ >
  $ G ⇒ ⟨ sf , ⟨ sg , ⟨ st , sa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tf w p $ >
  $ G ⇒ sx ∊ apn (ity u (dnf u (mcv H)) td (fv nvf ti) w) (scat sf p) $ >
  $ G ⇒ fv (ifold u (dnf u (mcv H)) td w p mv) ⟨ fv nvf ti , ⟨ scat sf p , sx ⟩ ⟩ ∈ apn (vat cv (intys td) (fv nvf ti)) (scons sx sf) $;

-- --------------------------------------------------------------------------
-- Trace spaces of `Π` chains (D6 for the recursor's type)
-- --------------------------------------------------------------------------

--| One `Π` step of a curried trace, into the flat space: a function on `A` whose value
--| at `a` is a trace over the paths `q` with `ssnoc q a` in `S`, valued in `T`'s values
--| at `ssnoc q a`, is a trace over `S` valued in `T`'s values.
--| @freshen G a
--| @freshen G q
--| @freshen G s
--| @freshen G x
--| @freshen G b
--| @freshen G c
theorem cpi_fpi {a q s x b c: set} (G: hyps) (A S T V: class) (h: set):
  $ G ⇒ h ∊ cpi a A (fpi q {x | x ∊ fseq V ∧ ssnoc x a ∈ S} (ap T (ssnoc q a))) $ > $ G ⇒ ∀ s (s ∊ S → ∃ c ∃ b (b ∊ A ∧ c ∊ fseq V ∧ s = ssnoc c b)) $ >
  $ G ⇒ h ∊ fpi s S (ap T s) $;

--| One `Π` step of a curried trace, from the flat space: the converse of `cpi_fpi`.
--| @freshen G a
--| @freshen G q
--| @freshen G s
--| @freshen G x
--| @freshen G b
--| @freshen G c
theorem fpi_cpi {a q s x b c: set} (G: hyps) (A S T V: class) (h: set):
  $ G ⇒ h ∊ fpi s S (ap T s) $ > $ G ⇒ ∀ s (s ∊ S → ∃ c ∃ b (b ∊ A ∧ c ∊ fseq V ∧ s = ssnoc c b)) $ >
  $ G ⇒ h ∊ cpi a A (fpi q {x | x ∊ fseq V ∧ ssnoc x a ∈ S} (ap T (ssnoc q a))) $;

--| The last binder of a `Π` chain: a function on `A` valued in `T`'s values at the
--| one-entry valuations is a trace over them.
--| @freshen G a
--| @freshen G s
--| @freshen G x
--| @freshen G b
theorem cpi_fpi1 {a s x b: set} (G: hyps) (A T: class) (h: set):
  $ G ⇒ h ∊ cpi a A (ap T (scons a ∅)) $ > $ G ⇒ h ∊ fpi s {x | ∃ b (b ∊ A ∧ x = scons b ∅)} (ap T s) $;

--| The converse of `cpi_fpi1`.
--| @freshen G a
--| @freshen G s
--| @freshen G x
--| @freshen G b
theorem fpi_cpi1 {a s x b: set} (G: hyps) (A T: class) (h: set):
  $ G ⇒ h ∊ fpi s {x | ∃ b (b ∊ A ∧ x = scons b ∅)} (ap T s) $ > $ G ⇒ h ∊ cpi a A (ap T (scons a ∅)) $;

--| An entry appended after one put in front.
theorem ssnoc_scons (G: hyps) (A: class) (x f a: set):
  $ G ⇒ f ∊ fseq A $ > $ G ⇒ x ∊ A $ > $ G ⇒ a ∊ A $ > $ G ⇒ ssnoc (scons x f) a = scons x (ssnoc f a) $;

--| Appending an entry is injective.
theorem ssnoc_inj (G: hyps) (A: class) (s t a b: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ a ∊ A $ > $ G ⇒ b ∊ A $ > $ G ⇒ ssnoc s a = ssnoc t b $ >
  $ G ⇒ s = t ∧ a = b $;

--| The paths with a major (the fields `c` of a path of `K` at `r`, then `m` in the
--| table `Y`'s value at `c`), at a `Π` node: a sequence `s` whose extension by `a` is
--| such a path of `Π A. B` is one of `B` at `scons a r`, for the table shifted by `a`.
--| @freshen G z
--| @freshen G c
--| @freshen G d
--| @freshen G h
--| @freshen G o
--| @freshen G m
--| @freshen G v
--| @freshen G q
--| @freshen G y
theorem mpth_pi_out {z c d h o m v q y: set} (G: hyps) (M Y V: class) (u w r ta tb a s: set):
  $ G ⇒ ta ∊ trees ω $ > $ G ⇒ tb ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ u ⊆ V $ > $ G ⇒ a ∊ V $ > $ G ⇒ s ∊ fseq V $ > $ G ⇒ ssnoc s a ∈ {z | ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r ∧ m ∊ ap (Y) c ∧ m ∊ V ∧ z = scons m c)} $ >
  $ G ⇒ s ∊ {z | ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap ({v | ∃ q ∃ y (q ∊ fseq V ∧ v = ⟨ q , y ⟩ ∧ ⟨ ssnoc q a , y ⟩ ∈ Y)}) c ∧ m ∊ V ∧ z = scons m c)} $;

--| The converse of `mpth_pi_out`, for `a` in the value of `A`.
--| @freshen G z
--| @freshen G c
--| @freshen G d
--| @freshen G h
--| @freshen G o
--| @freshen G m
--| @freshen G v
--| @freshen G q
--| @freshen G y
theorem mpth_pi_in {z c d h o m v q y: set} (G: hyps) (M Y V: class) (u w r ta tb a s: set):
  $ G ⇒ ta ∊ trees ω $ > $ G ⇒ tb ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ u ⊆ V $ > $ G ⇒ a ∊ dt u M ta w r $ > $ G ⇒ a ∊ u $ > $ G ⇒ s ∊ {z | ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons a r) ∧ m ∊ ap ({v | ∃ q ∃ y (q ∊ fseq V ∧ v = ⟨ q , y ⟩ ∧ ⟨ ssnoc q a , y ⟩ ∈ Y)}) c ∧ m ∊ V ∧ z = scons m c)} $ >
  $ G ⇒ s ∊ fseq V ∧ ssnoc s a ∈ {z | ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r ∧ m ∊ ap (Y) c ∧ m ∊ V ∧ z = scons m c)} $;

-- --------------------------------------------------------------------------
-- The generic `Π` step and the leaf of a walk (D6 for the recursor's type)
-- --------------------------------------------------------------------------

--| The paths with a major of `K` at `R`: the fields `c` of a path, then an
--| element `m` of the universe in the table `Y`'s value at `c`.
def mpth (U E K W R Y: class) (.c .d .h .o .m .z: set): class =
  $ {z | ∃ c ∃ d ∃ h ∃ o ∃ m (⟨ c , ⟨ d , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel U E K W R ∧ m ∊ ap Y c ∧ m ∊ U ∧ z = scons m c)} $;
--| @congr
theorem mpth_congr (A B C D E F H I J K L N: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ L ≐ N $ > $ mpth A C E H J L ≐ mpth B D F I K N $;
--| @rewrite
theorem sb_c_mpth {x: set} (t: set x) (A B C D E F: class x):
  $ (⟦ x / t ⟧ (mpth A B C D E F)) ≐ mpth (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) (⟦ x / t ⟧ F) $;

--| The paths with a major of the body of a `Π` node at `scons a r`, for a table `Y2` whose
--| values are `Y`'s at the sequences extended by `a`: the sequences whose extension by `a`
--| is such a path of the node (`mpth_pi_out`, `mpth_pi_in` without the shifted table).
--| @freshen G q
--| @freshen G x
theorem mpth_pi_dom {q x: set} (G: hyps) (M Y Y2: class) (u w r ta tb a: set):
  $ G ⇒ ta ∊ trees ω $ > $ G ⇒ tb ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ a ∊ dt u M ta w r $ > $ G ⇒ a ∊ u $ > $ G ⇒ ∀ q (q ∊ fseq u → ap (Y2) q = ap (Y) (ssnoc q a)) $ >
  $ G ⇒ mpth u (dnf u M) tb w (scons a r) (Y2) = {x | x ∊ fseq u ∧ ssnoc x a ∈ mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)} $;

--| The generic `Π` step of a walk over a type `Π A. B` whose value is a space of traces
--| over the paths with a major: if the body's value at `scons a r`, for every `a` in `A`'s
--| value, is the space over the body's paths there with the tables `Y2`, `T2`, whose values
--| are those of `Y`, `T` at the sequences extended by `a`, then the node's value is the
--| space over the node's paths with `Y`, `T`.
--| @freshen G s
--| @freshen G a
--| @freshen G q
theorem dpi_step {s a q: set} (G: hyps) (M Y T: class) (Y2 T2: class a) (u w r ta tb tm: set):
  $ G ⇒ ta ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tb ∊ trees ω $ >
  $ G ⇒ tm ∊ trees ω $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ ∀ a (a ∊ dt u M ta w r → dt u M tm w (scons a r) = fpi s (mpth u (dnf u M) tb w (scons a r) (Y2)) (ap (T2) s)) $ >
  $ G ⇒ ∀ a (a ∊ dt u M ta w r → ∀ q (q ∊ fseq u → ap (Y2) q = ap (Y) (ssnoc q a))) $ >
  $ G ⇒ ∀ a (a ∊ dt u M ta w r → ∀ q (q ∊ fseq u → ap (T2) q = ap (T) (ssnoc q a))) $ >
  $ G ⇒ dt u M ⟨ kc_pi , scons ta (scons tm ∅) ⟩ w r = fpi s (mpth u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r (Y)) (ap (T) s) $;

--| The leaf of a walk: over a type `B` with the one path of nothing, the value of `Π I. X`
--| for `I`'s value the table `Y`'s at `∅` and `X`'s value at each `a` the table `T`'s at the
--| one-entry sequence, is the space over `B`'s paths with a major.
--| @freshen G s
--| @freshen G a
theorem dpi_leaf {s a: set} (G: hyps) (M Y T: class) (u w r ti tx tb: set):
  $ G ⇒ ti ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tx ∊ trees ω $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ etel u (dnf u M) tb w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ >
  $ G ⇒ dt u M ti w r = ap (Y) ∅ $ >
  $ G ⇒ ∀ a (a ∊ dt u M ti w r → dt u M tx w (scons a r) = ap (T) (scons a ∅)) $ >
  $ G ⇒ dt u M ⟨ kc_pi , scons ti (scons tx ∅) ⟩ w r = fpi s (mpth u (dnf u M) tb w r (Y)) (ap (T) s) $;

--| Trace spaces over equal paths with equal values at each path are equal.
--| @freshen G q
theorem fpi_eq_pt {q: set} (G: hyps) (Q Q2: class) (B B2: class q):
  $ G ⇒ Q = Q2 $ > $ G ⇒ ∀ q (q ∊ Q → B = B2) $ > $ G ⇒ fpi q Q B = fpi q Q2 B2 $;

--| The paths with a major at equal trees and valuations, for tables with the same values
--| at every sequence over the universe.
--| @freshen G q
theorem mpth_eq {q: set} (G: hyps) (E K K2 Y Y2 R R2: class) (u w: set):
  $ G ⇒ K ∈ trees ω $ > $ G ⇒ K = K2 $ > $ G ⇒ R = R2 $ > $ G ⇒ isset R $ > $ G ⇒ ∀ q (q ∊ fseq u → ap (Y) q = ap (Y2) q) $ >
  $ G ⇒ mpth u E K w R (Y) = mpth u E K2 w R2 (Y2) $;

--| A window on the middle of three concatenated sequences.
theorem swin_scat_mid (G: hyps) (u a p x: set):
  $ G ⇒ a ∊ fseq u $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ x ∊ fseq u $ > $ G ⇒ swin (scat a (scat p x)) (cdm a) (cdm p) = p $;

--| The value of a head `n0` applied to the parameters and then to the binders passed so
--| far (`pargs` twice, as in `mty_srt` and `rtail_srt`), at a valuation `e` of those binders
--| in front of `c0` and the parameters `p`: the head's value `Z` at `scat e p`.
theorem pargs_ind_val (G: hyps) (M Z: class) (u w n0 k tnp tz d x i e c0 p rr r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ e ∊ fseq u $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ r = scat e (scat c0 (scat p rr)) $ >
  $ G ⇒ fv nvf k = nadd (cdm e) (cdm c0) $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ cdm e = fv nvf d $ >
  $ G ⇒ fv nvf tz = ∅ $ >
  $ G ⇒ etel u (dnf u M) n0 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ >
  $ G ⇒ dt u M n0 w r = Z $ >
  $ G ⇒ ra_pargs n0 k tnp x ∈ lrel $ >
  $ G ⇒ ra_pargs x tz d i ∈ lrel $ >
  $ G ⇒ dt u M i w r = apn (Z) (scat e p) $;

--| The value of a motive's type, read off the type's type `t1` by `mty` at depth `td0`, at a
--| valuation `e` of the binders passed so far in front of `c0` (the earlier motives) and the
--| parameters `p`: the traces over `t1`'s paths with a major in `Z` (the value of `n0`, the
--| type itself) at the indices and parameters, valued in the motives' universe.
--| @freshen G x
--| @freshen G t
--| @freshen G f
theorem mty_sem {x t f: set} (G: hyps) (M Z: class) (u w td tj tnp tv p c0 rr n0 t1 td0 tm e r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ cdm c0 = fv nvf tj $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ >
  $ G ⇒ n0 ∊ trees ω $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u M n0 w x = Z) $ >
  $ G ⇒ tv ∊ trees ω $ >
  $ G ⇒ ra_mty td tnp tj td0 tv t1 tm ∈ lrel $ >
  $ G ⇒ t1 ∊ trees ω $ >
  $ G ⇒ tm ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ td0 ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ e ∊ fseq u $ >
  $ G ⇒ cdm e = fv nvf td0 $ >
  $ G ⇒ r = scat e (scat c0 (scat p rr)) $ >
  $ G ⇒ dt u M tm w r = fpi t (mpth u (dnf u M) t1 w r (clam f (fseq u) (apn (Z) (scat f (scat e p))))) (ap (clam f (fseq u) (fv uni (lv tv w))) t) $;

-- --------------------------------------------------------------------------
-- Sorts of telescopes (`pis`, `capp`)
-- --------------------------------------------------------------------------

--| The empty context and a context extended by a type are of the sort of contexts.
theorem ofsort_ctx_nil (G: hyps): $ G ⇒ ⟨ kc_nil , ∅ ⟩ ∈ ofsort lsig lopen ks_ctx $;

theorem ofsort_ctx_cons (G: hyps) (A B: class):
  $ G ⇒ A ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ B ∈ ofsort lsig lopen ks_ctx $ > $ G ⇒ ⟨ kc_cons , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_ctx $;

--| `pis P b T` for an expression `T`: `P` is a context and `b` an expression.
theorem pis_sort (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_pis t1 t2 t3 ∈ lrel $ > $ G ⇒ t3 ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ t1 ∊ ofsort lsig lopen ks_ctx ∧ t2 ∊ ofsort lsig lopen ks_expr $;

--| `capp P G T` for a context `T`: `P` and `G` are contexts.
theorem capp_sort (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_capp t1 t2 t3 ∈ lrel $ > $ G ⇒ t3 ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ t1 ∊ ofsort lsig lopen ks_ctx ∧ t2 ∊ ofsort lsig lopen ks_ctx $;

-- --------------------------------------------------------------------------
-- Appended telescopes; the motives (D6 for the recursor's type)
-- --------------------------------------------------------------------------

--| The valuations of an appended telescope `G ++ P` over the table shifted by `s`: a
--| valuation `g` of `G`, then one of `P` over the table shifted by `g` too.
--| @freshen G x
--| @freshen G g
--| @freshen G q
theorem esat_capp_dsh {x g q: set} (G: hyps) (M: class) (u w s t1 t2 t3: set):
  $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ ra_capp t1 t2 t3 ∈ lrel $ >
  $ G ⇒ esat u (dsh u M s) t3 w = {x | ∃ g ∃ q (g ∊ esat u (dsh u M s) t2 w ∧ q ∊ esat u (dsh u M (scat g s)) t1 w ∧ x = scat q g)} $;

--| A path with a major is a sequence over the universe.
theorem mpth_fseq (G: hyps) (E K R Y: class) (u w: set):
  $ G ⇒ K ∈ trees ω $ > $ G ⇒ isset R $ > $ G ⇒ mpth u E K w R (Y) ⊆ fseq u $;

--| The type of motive `tj` (`mty` on the type's type `tf` lifted over the `tj` earlier
--| motives), at a valuation `c0` of those motives in front of the parameters `p`: its value
--| is the motive's space, for the type's value `ity` the value of `n0`.
--| @freshen G x
theorem mot_val {x: set} (G: hyps) (M: class) (u w td tj tnp tv tz tf tf2 tm p c0 rr n0 r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ cdm c0 = fv nvf tj $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ >
  $ G ⇒ n0 ∊ trees ω $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u M n0 w x = ity u (dnf u M) td (fv nvf tj) w) $ >
  $ G ⇒ tv ∊ trees ω $ >
  $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ >
  $ G ⇒ ra_lift tj tz tf tf2 ∈ lrel $ >
  $ G ⇒ ra_mty td tnp tj tz tv tf2 tm ∈ lrel $ >
  $ G ⇒ tm ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ityf td (fv nvf tj) tf $ >
  $ G ⇒ ra_closed tnp tf ∈ lrel $ >
  $ G ⇒ ity u (dnf u M) td (fv nvf tj) w ∈ u $ >
  $ G ⇒ r = scat c0 (scat p rr) $ >
  $ G ⇒ dt u M tm w r = imot u (dnf u M) td (fv nvf tj) w p (lv tv w) $;

-- --------------------------------------------------------------------------
-- The motives' telescope (D6 for the recursor's type)
-- --------------------------------------------------------------------------

--| Satisfaction over tables shifted by equal valuations.
theorem esat_dsh_eq (G: hyps) (M S S2 T W: class) (u: set):
  $ G ⇒ T ∈ trees ω $ > $ G ⇒ S ∈ fseq u $ > $ G ⇒ S = S2 $ > $ G ⇒ esat u (dsh u M S) T W = esat u (dsh u M S2) T W $;

--| The motives' telescope: for the types `tt` of a block from the number `tj` on (`tk` of
--| them, `nadd` to the block's `tn`), each with its type by `ityf` and closed over the
--| parameters, the valuations of `motives`'s output over `c0` (the earlier motives) and the
--| parameters `p` are the sequences of `tk` motives, the motive of type `i` in the space `imot`.
--| @freshen G a
--| @freshen G b
--| @freshen G x
--| @freshen G f
--| @freshen G l
--| @freshen G i
theorem motives_sem {a b x f l i: set} (G: hyps) (M: class) (u w td tnp tv tn p rr tt tj tm c0 r tk to: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ tv ∊ trees ω $ >
  $ G ⇒ ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → fv nvf a ∈ fv nvf tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (fv nvf a) w) $ >
  $ G ⇒ ∀ a (a ∊ ofsort lsig lopen ks_nat → fv nvf a ∈ fv nvf tn → ity u (dnf u M) td (fv nvf a) w ∈ u) $ >
  $ G ⇒ ra_motives td tnp tv tj tt tm ∈ lrel $ >
  $ G ⇒ tm ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tj ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ ra_ntys tt tk to ∈ lrel $ >
  $ G ⇒ nadd (fv nvf tj) (fv nvf tk) = fv nvf tn $ >
  $ G ⇒ ∀ a ∀ f ∀ b (ra_nth_ty tt a f b ∈ lrel → ityf td (nadd (fv nvf tj) (fv nvf a)) f ∧ ra_closed tnp f ∈ lrel) $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ cdm c0 = fv nvf tj $ >
  $ G ⇒ r = scat c0 (scat p rr) $ >
  $ G ⇒ esat u (dsh u M r) tm w = {l | l ∊ fseq u ∧ cdm l = fv nvf tk ∧ ∀ i (i ∊ fv nvf tn → fv nvf tj ⊆ i → vat (scat l c0) (fv nvf tn) i ∈ imot u (dnf u M) td i w p (lv tv w))} $;

-- --------------------------------------------------------------------------
-- The recursor's tail (D6 for the recursor's type)
-- --------------------------------------------------------------------------

--| The leaf of the recursor's tail: `X2 @ #0` for `X2` the variable `#mi` applied to the
--| binders passed so far (`pargs #mi 1 d`), at a valuation `scons a r` with `r` the binders
--| `e` in front of `c0` (the minors and motives) and the parameters: the entry `K` of `c0`
--| (the motive) at the indices `e` and the major `a`.
theorem rtail_leaf_val (G: hyps) (M K: class) (u w d mi t1 tz x2 tbm tb0 tap e c0 p rr r a: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ e ∊ fseq u $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ r = scat e (scat c0 (scat p rr)) $ >
  $ G ⇒ a ∊ u $ >
  $ G ⇒ cdm e = fv nvf d $ >
  $ G ⇒ K ∈ cdm c0 $ >
  $ G ⇒ fv nvf mi = suc (nadd (cdm e) K) $ >
  $ G ⇒ tbm = ⟨ kc_bvar , scons mi ∅ ⟩ $ >
  $ G ⇒ mi ∊ trees ω $ >
  $ G ⇒ fv nvf t1 = suc ∅ $ >
  $ G ⇒ ra_pargs tbm t1 d x2 ∈ lrel $ >
  $ G ⇒ tb0 = ⟨ kc_bvar , scons tz ∅ ⟩ $ >
  $ G ⇒ tz ∊ trees ω $ >
  $ G ⇒ fv nvf tz = ∅ $ >
  $ G ⇒ x2 ∊ trees ω $ >
  $ G ⇒ tap = ⟨ kc_app , scons x2 (scons tb0 ∅) ⟩ $ >
  $ G ⇒ dt u M tap w (scons a r) = apn (fv c0 K) (scons a e) $;

--| The value of the recursor's tail, read off the type's type `t1` by `rtail` at depth `td0`,
--| at a valuation `e` of the binders passed so far in front of `c0` (the minors and motives)
--| and the parameters `p`: the traces over `t1`'s paths with a major in `Z` (the type itself),
--| valued in the entry `K` of `c0` (the type's motive) at the indices and the major.
--| @freshen G x
--| @freshen G t
--| @freshen G f
theorem rtail_sem {x t f: set} (G: hyps) (M Z K: class) (u w td tn tm ti tnp p c0 rr n0 t1 td0 tb e r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ cdm c0 = nadd (fv nvf tm) (fv nvf tn) $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $ >
  $ G ⇒ n0 ∊ trees ω $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u M n0 w x = Z) $ >
  $ G ⇒ K ∈ cdm c0 $ >
  $ G ⇒ nadd (suc K) (fv nvf ti) = cdm c0 $ >
  $ G ⇒ ra_rtail td tnp tn tm ti td0 t1 tb ∈ lrel $ >
  $ G ⇒ t1 ∊ trees ω $ >
  $ G ⇒ tb ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ td0 ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ e ∊ fseq u $ >
  $ G ⇒ cdm e = fv nvf td0 $ >
  $ G ⇒ r = scat e (scat c0 (scat p rr)) $ >
  $ G ⇒ dt u M tb w r = fpi t (mpth u (dnf u M) t1 w r (clam f (fseq u) (apn (Z) (scat f (scat e p))))) (ap (clam f (fseq u) (apn (fv c0 K) (scat f e))) t) $;

-- --------------------------------------------------------------------------
-- The minors (D6 for the recursor's type): the inductive hypotheses
-- --------------------------------------------------------------------------

--| `sinst` for the paths: as `lrel_sinst_sem`, `e2`'s paths at `p ++ s` are `e`'s at `p ++ v ++ s`.
--| @freshen G i
--| @freshen G b
theorem lrel_sinst_etel {i b: set} (G: hyps) (M: class) (u w t1 t2 t3 t4 t5 t6 p s v: set):
  $ G ⇒ ra_sinst t1 t2 t3 t4 t5 t6 ∈ lrel $ > $ G ⇒ uadm u $ > $ G ⇒ t1 ∊ trees ω $ > $ G ⇒ t2 ∊ trees ω $ >
  $ G ⇒ w ∊ lvals $ > $ G ⇒ p ∊ fseq u $ > $ G ⇒ cdm p = fv nvf t4 $ > $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ v ∊ fseq u $ > $ G ⇒ nadd (fv nvf t2) (cdm v) = fv nvf t3 $ >
  $ G ⇒ ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i →
      dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) $ >
  $ G ⇒ etel u (dnf u M) t6 w (scat p s) = etel u (dnf u M) t5 w (scat p (scat v s)) $;

--| The generic `Π` step over any classes of paths: if the body's value at `scons a r`, for every
--| `a` in `A`'s value, is the space over the paths `S2` with the table `T2`, where `S2` is the
--| sequences whose extension by `a` is in `S` and `T2`'s values there are `T`'s at the extension,
--| and every element of `S` is such an extension, then the node's value is the space over `S`
--| with `T`.
--| @freshen G s
--| @freshen G a
--| @freshen G q
--| @freshen G x
--| @freshen G b
--| @freshen G c
theorem gpi_step {s a q x b c: set} (G: hyps) (M S T: class) (S2 T2: class a) (u w r ta tm: set):
  $ G ⇒ ta ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tm ∊ trees ω $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ ∀ a (a ∊ dt u M ta w r → dt u M tm w (scons a r) = fpi s (S2) (ap (T2) s)) $ >
  $ G ⇒ ∀ a (a ∊ dt u M ta w r → S2 = {x | x ∊ fseq u ∧ ssnoc x a ∈ S}) $ >
  $ G ⇒ ∀ s (s ∊ S → ∃ c ∃ b (b ∊ dt u M ta w r ∧ c ∊ fseq u ∧ s = ssnoc c b)) $ >
  $ G ⇒ ∀ a (a ∊ dt u M ta w r → ∀ q (q ∊ S2 → ap (T2) q = ap (T) (ssnoc q a))) $ >
  $ G ⇒ dt u M ⟨ kc_pi , scons ta (scons tm ∅) ⟩ w r = fpi s (S) (ap (T) s) $;

--| The arguments of a path of a spine: the spine's own (as many as its number), in front
--| of a path's of the head (whose paths' arguments are sequences).
--| @freshen G i
--| @freshen G b
--| @freshen G y
theorem spine_args {i b y: set} (G: hyps) (M: class) (u w r tY te tk a: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) $ >
  $ G ⇒ ra_spine tY te tk ∈ lrel $ >
  $ G ⇒ te ∊ trees ω $ >
  $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) te w r $ >
  $ G ⇒ ∃ i ∃ b (a = scat i b ∧ i ∊ fseq {y | y = y} ∧ cdm i = fv nvf tk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r) $;

--| The arguments of a path of a re-headed spine `e`: the spine's own `i`, in front of a
--| path's of the old head `Y`; and the result's value is the new head `X`'s applied to `i`.
--| @freshen G i
--| @freshen G b
--| @freshen G y
theorem rehead_args {i b y: set} (G: hyps) (M: class) (u w r tY tX te tk te2 a: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) $ >
  $ G ⇒ ra_rehead tY tX tk te te2 ∈ lrel $ >
  $ G ⇒ te ∊ trees ω $ >
  $ G ⇒ te2 ∊ trees ω $ >
  $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) te w r $ >
  $ G ⇒ ∃ i ∃ b (a = scat i b ∧ i ∊ fseq {y | y = y} ∧ cdm i = fv nvf tk ∧ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r ∧ dt u M te2 w r = apn (dt u M tX w r) i) $;

--| The value of the type of an inductive hypothesis at its leaf `X @ U` (`ihty_app`): the motive
--| (the entry `tmj`) at the indices, the first `tni` arguments of a path of the field's result
--| `tA`, and the field (the entry `tf`) applied to the binders passed.
theorem ihty_leaf_val (G: hyps) (M: class) (u w r td tj tmj tf tni tnp ty tA tX tU tY n0 x0 x1 z0 a: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ >
  $ G ⇒ n0 ∊ trees ω $ >
  $ G ⇒ x0 = ⟨ kc_bvar , scons tmj ∅ ⟩ $ >
  $ G ⇒ tmj ∊ trees ω $ >
  $ G ⇒ x1 = ⟨ kc_bvar , scons tf ∅ ⟩ $ >
  $ G ⇒ tf ∊ trees ω $ >
  $ G ⇒ fv nvf z0 = ∅ $ >
  $ G ⇒ ra_rehead tY x0 tni tA tX ∈ lrel $ >
  $ G ⇒ ra_spine n0 tY tnp ∈ lrel $ >
  $ G ⇒ ra_pargs x1 z0 ty tU ∈ lrel $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ tX ∊ trees ω $ >
  $ G ⇒ tU ∊ trees ω $ >
  $ G ⇒ tY ∊ trees ω $ >
  $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tA w r $ >
  $ G ⇒ fv r (fv nvf tf) ∈ u $ >
  $ G ⇒ dt u M ⟨ kc_app , scons tX (scons tU ∅) ⟩ w r = apn (fv r (fv nvf tmj)) (scons (apn (fv r (fv nvf tf)) (swin r ∅ (fv nvf ty))) (cres a (fv nvf tni))) $;

--| The fields of the paths in `Q`.
def tpth (Q: class) (.z .g .h .o: set): class = $ {z | ∃ g ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q)} $;
--| @congr
theorem tpth_congr (A B: class): $ A ≐ B $ > $ tpth A ≐ tpth B $;
--| @rewrite
theorem sb_c_tpth {x: set} (t: set x) (A: class x): $ (⟦ x / t ⟧ (tpth A)) ≐ tpth (⟦ x / t ⟧ A) $;
--| The table of an inductive hypothesis's type over the paths `Q` of its field's type: at
--| the fields `f` of a path with the arguments `o`, the trace `C` (a motive) at the first `N`
--| arguments and the field `V` applied to `f` and the binders `E` passed before.
def ihtb (U Q C V E N: class) (.f .l .g .h .o: set): class =
  $ clam f (fseq U) {l | ∃ g ∃ h ∃ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ l ∊ apn C (scons (apn V (scat f E)) (cres o N)))} $;
--| @congr
theorem ihtb_congr (A B C D E F H I J K L N: class):
  $ A ≐ B $ > $ C ≐ D $ > $ E ≐ F $ > $ H ≐ I $ > $ J ≐ K $ > $ L ≐ N $ > $ ihtb A C E H J L ≐ ihtb B D F I K N $;
--| @rewrite
theorem sb_c_ihtb {x: set} (t: set x) (A B C D E F: class x):
  $ (⟦ x / t ⟧ (ihtb A B C D E F)) ≐ ihtb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) (⟦ x / t ⟧ F) $;

--| An element of the paths' fields is the fields of a path.
--| @freshen G g
--| @freshen G h
--| @freshen G o
theorem tpth_elim {g h o: set} (G: hyps) (Q: class) (z: set):
  $ G ⇒ z ∊ tpth Q $ > $ G ⇒ ∃ g ∃ h ∃ o (⟨ z , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q) $;

--| The fields of a path (whose other parts are sets) are an element of the paths' fields.
theorem tpth_intro (G: hyps) (Q A B C: class) (z: set):
  $ G ⇒ ⟨ z , ⟨ A , ⟨ B , C ⟩ ⟩ ⟩ ∈ Q $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ isset C $ > $ G ⇒ z ∊ tpth Q $;

--| `tpth` at equal classes.
theorem tpth_eq (G: hyps) (Q Q2: class): $ G ⇒ Q = Q2 $ > $ G ⇒ tpth Q = tpth Q2 $;

--| An element of an inductive hypothesis's table at `s`: a path with the fields `s`, and an
--| element of the trace `C` at the path's arguments and the field's value.
--| @freshen G g
--| @freshen G h
--| @freshen G o
theorem ihtb_elim {g h o: set} (G: hyps) (Q C V E N: class) (u s y: set):
  $ G ⇒ s ∊ fseq u $ > $ G ⇒ y ∊ ap (ihtb u Q C V E N) s $ >
  $ G ⇒ ∃ g ∃ h ∃ o (⟨ s , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ Q ∧ y ∊ apn C (scons (apn V (scat s E)) (cres o N))) $;

--| Introduction for an inductive hypothesis's table (the path's other parts are sets).
theorem ihtb_intro (G: hyps) (Q C V E N A B D: class) (u s y: set):
  $ G ⇒ s ∊ fseq u $ > $ G ⇒ ⟨ s , ⟨ A , ⟨ B , D ⟩ ⟩ ⟩ ∈ Q $ > $ G ⇒ y ∊ apn C (scons (apn V (scat s E)) (cres D N)) $ >
  $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ isset D $ > $ G ⇒ y ∊ ap (ihtb u Q C V E N) s $;

--| `ihtb` at equal arguments.
theorem ihtb_eq (G: hyps) (U Q Q2 C C2 V V2 E E2 N N2: class):
  $ G ⇒ Q = Q2 $ > $ G ⇒ C = C2 $ > $ G ⇒ V = V2 $ > $ G ⇒ E = E2 $ > $ G ⇒ N = N2 $ >
  $ G ⇒ ihtb U Q C V E N = ihtb U Q2 C2 V2 E2 N2 $;

--| The space over the one empty path is the table's value there.
--| @freshen G q
theorem fpi_one {q: set} (G: hyps) (Q T: class):
  $ G ⇒ ∅ ∈ Q $ > $ G ⇒ ∀ q (q ∊ Q → q = ∅) $ > $ G ⇒ fpi q Q (ap T q) = ap T ∅ $;

--| The paths of a tree are a set.
theorem etel_set (G: hyps) (E T W R: class) (u: set): $ G ⇒ isset T $ > $ G ⇒ isset (etel u E T W R) $;

--| The arguments of a tree's one path of nothing are a set.
theorem sarg_set (G: hyps) (E T W R: class) (u: set): $ G ⇒ isset T $ > $ G ⇒ isset (sarg u E T W R) $;

--| The value of the type of an inductive hypothesis (`ihty`, read off the field's type `tA` at
--| depth `ty`) at a valuation `e` of the binders passed, in front of `v0`: the traces over the
--| fields of `tA`'s paths, valued in the motive (the entry `tmo + K` of `v0`, `K` the type's
--| entry among the motives) at the path's first `N` arguments (the type's indices) and the
--| field (the entry `tfld` of `v0`) applied to the binders.
--| @freshen G c
--| @freshen G z
theorem ihty_sem {c z: set} (G: hyps) (M K N: class) (u w v0 td tnp tn tmo tfld tj n0 tA ty tIH e r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ v0 ∊ fseq u $ >
  $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ >
  $ G ⇒ n0 ∊ trees ω $ >
  $ G ⇒ fv v0 (fv nvf tfld) ∈ u $ >
  $ G ⇒ K ∈ ω $ >
  $ G ⇒ nadd (suc K) (fv nvf tj) = fv nvf tn $ >
  $ G ⇒ ∀ c (ra_nidx td tj c ∈ lrel → fv nvf c = N) $ >
  $ G ⇒ ra_ihty td tnp tn tmo tfld ty tj tA tIH ∈ lrel $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ tIH ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ty ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ e ∊ fseq u $ >
  $ G ⇒ cdm e = fv nvf ty $ >
  $ G ⇒ r = scat e v0 $ >
  $ G ⇒ dt u M tIH w r = fpi z (tpth (etel u (dnf u M) tA w r)) (ap (ihtb u (etel u (dnf u M) tA w r) (fv v0 (nadd (fv nvf tmo) K)) (fv v0 (fv nvf tfld)) e (N)) z) $;

-- --------------------------------------------------------------------------
-- The minors (D6 for the recursor's type): the fields
-- --------------------------------------------------------------------------

--| A type closed at `d + np` is not a recursive field's type at depth `d`: `mwalk`'s two
--| clauses for a field exclude each other.
theorem closed_recfield_ex (G: hyps) (td tn tnp tj tk td0 ta: set):
  $ G ⇒ ra_closed tk ta ∈ lrel $ > $ G ⇒ ra_recfield td tn tnp td0 ta tj ∈ lrel $ >
  $ G ⇒ fv nvf tk = nadd (fv nvf td0) (fv nvf tnp) $ > $ G ⇒ ⊥ $;

--| A recursive field's type is one of the block's types.
theorem recfield_lt (G: hyps) (td tn tnp tj td0 ta: set):
  $ G ⇒ ra_recfield td tn tnp td0 ta tj ∈ lrel $ > $ G ⇒ fv nvf tj ∈ fv nvf tn $;

--| The type of an inductive hypothesis (`ihty` at depth `0`) has the hypothesis's space as its
--| value at `v0`, for tables `Gg`, `Tt` whose entries at `Dd` are the field (the entry `tfld`
--| of `v0`) and the paths of the field's type there, and the motives `cv` whose entry for the
--| field's type is the entry `tmo + K` of `v0`.
theorem ih_val (G: hyps) (M K Tt Gg Dd: class) (u w v0 td tnp tn tmo tfld tj tA tIH cv: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ v0 ∊ fseq u $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ tj ∊ trees ω $ >
  $ G ⇒ fv v0 (fv nvf tfld) ∈ u $ >
  $ G ⇒ K ∈ ω $ >
  $ G ⇒ nadd (suc K) (fv nvf tj) = fv nvf tn $ >
  $ G ⇒ ra_ihty td tnp tn tmo tfld ⟨ kc_nz , ∅ ⟩ tj tA tIH ∈ lrel $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ tIH ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ fv Tt Dd = etel u (dnf u M) tA w v0 $ >
  $ G ⇒ fv Gg Dd = fv v0 (fv nvf tfld) $ >
  $ G ⇒ fv v0 (nadd (fv nvf tmo) K) = vat cv (intys td) (fv nvf tj) $ >
  $ G ⇒ dt u M tIH w v0 = ihsp (imrel td cv) Gg Tt Dd (fv nvf tj) $;

--| The paths of a minor: the fields `f` of a path in `Q`, behind inductive hypotheses `h` for
--| the fields in order (`G`, then the path's `g`) and their telescopes (`T`, then `t`).
def mqp (Q D K L G T N: class) (.z .f .g .c .a .h: set): class =
  $ {z | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (scat G g) (scat T c) N ∧ z = scat h f)} $;
--| @congr
theorem mqp_congr (A0 B0 A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6: class):
  $ A0 ≐ B0 $ > $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ > $ A6 ≐ B6 $ >
  $ mqp A0 A1 A2 A3 A4 A5 A6 ≐ mqp B0 B1 B2 B3 B4 B5 B6 $;
--| @rewrite
theorem sb_c_mqp {x: set} (t: set x) (A0 A1 A2 A3 A4 A5 A6: class x):
  $ (⟦ x / t ⟧ (mqp A0 A1 A2 A3 A4 A5 A6)) ≐ mqp (⟦ x / t ⟧ A0) (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) (⟦ x / t ⟧ A6) $;

--| The table of a minor's type over its paths: at `scat h f`, the trace `C` (the motive) at the
--| first `I` arguments `a` of the path (the indices) and the trace `V` (the constructor)
--| applied to the fields `f`, those passed before `F` and the parameters `P`.
def mtb (U Q D K L G T N C V F P I: class) (.z .y .f .g .c .a .h: set): class =
  $ clam z (fseq U) {y | ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (scat G g) (scat T c) N ∧ z = scat h f ∧ y ∊ apn C (scons (apn V (scat (scat f F) P)) (cres a I)))} $;
--| @congr
theorem mtb_congr (A0 B0 A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6 A7 B7 A8 B8 A9 B9 A10 B10 A11 B11 A12 B12: class):
  $ A0 ≐ B0 $ > $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ > $ A6 ≐ B6 $ > $ A7 ≐ B7 $ > $ A8 ≐ B8 $ > $ A9 ≐ B9 $ > $ A10 ≐ B10 $ > $ A11 ≐ B11 $ > $ A12 ≐ B12 $ >
  $ mtb A0 A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 ≐ mtb B0 B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 B12 $;
--| @rewrite
theorem sb_c_mtb {x: set} (t: set x) (A0 A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12: class x):
  $ (⟦ x / t ⟧ (mtb A0 A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12)) ≐ mtb (⟦ x / t ⟧ A0) (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) (⟦ x / t ⟧ A6) (⟦ x / t ⟧ A7) (⟦ x / t ⟧ A8) (⟦ x / t ⟧ A9) (⟦ x / t ⟧ A10) (⟦ x / t ⟧ A11) (⟦ x / t ⟧ A12) $;

--| An element of a minor's paths.
--| @freshen G f
--| @freshen G g
--| @freshen G c
--| @freshen G a
--| @freshen G h
theorem mqp_elim {f g c a h: set} (G: hyps) (Q D K L X Y N: class) (z: set):
  $ G ⇒ z ∊ mqp Q D K L X Y N $ >
  $ G ⇒ ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (scat X g) (scat Y c) N ∧ z = scat h f) $;

--| Introduction for a minor's paths (the path's parts are sets).
theorem mqp_intro (G: hyps) (Q D K L X Y N A1 A2 A3 A4 A5: class) (z: set):
  $ G ⇒ ⟨ A1 , ⟨ A2 , ⟨ A3 , A4 ⟩ ⟩ ⟩ ∈ Q $ > $ G ⇒ A5 ∈ ihv D K L (scat X A2) (scat Y A3) N $ > $ G ⇒ z = scat A5 A1 $ >
  $ G ⇒ isset A1 $ > $ G ⇒ isset A2 $ > $ G ⇒ isset A3 $ > $ G ⇒ isset A4 $ > $ G ⇒ z ∊ mqp Q D K L X Y N $;

--| `mqp` at equal arguments.
theorem mqp_eq (G: hyps) (Q Q2 D K L X X2 Y Y2 N: class):
  $ G ⇒ Q = Q2 $ > $ G ⇒ X = X2 $ > $ G ⇒ Y = Y2 $ > $ G ⇒ mqp Q D K L X Y N = mqp Q2 D K L X2 Y2 N $;

--| An element of a minor's table at `s`.
--| @freshen G f
--| @freshen G g
--| @freshen G c
--| @freshen G a
--| @freshen G h
theorem mtb_elim {f g c a h: set} (G: hyps) (Q D K L X Y N C V F P I: class) (u s v: set):
  $ G ⇒ s ∊ fseq u $ > $ G ⇒ v ∊ ap (mtb u Q D K L X Y N C V F P I) s $ >
  $ G ⇒ ∃ f ∃ g ∃ c ∃ a ∃ h (⟨ f , ⟨ g , ⟨ c , a ⟩ ⟩ ⟩ ∈ Q ∧ h ∊ ihv D K L (scat X g) (scat Y c) N ∧ s = scat h f ∧ v ∊ apn C (scons (apn V (scat (scat f F) P)) (cres a I))) $;

--| Introduction for a minor's table (the path's parts are sets).
theorem mtb_intro (G: hyps) (Q D K L X Y N C V F P I A1 A2 A3 A4 A5: class) (u s v: set):
  $ G ⇒ s ∊ fseq u $ > $ G ⇒ ⟨ A1 , ⟨ A2 , ⟨ A3 , A4 ⟩ ⟩ ⟩ ∈ Q $ > $ G ⇒ A5 ∈ ihv D K L (scat X A2) (scat Y A3) N $ > $ G ⇒ s = scat A5 A1 $ >
  $ G ⇒ v ∊ apn C (scons (apn V (scat (scat A1 F) P)) (cres A4 I)) $ >
  $ G ⇒ isset A1 $ > $ G ⇒ isset A2 $ > $ G ⇒ isset A3 $ > $ G ⇒ isset A4 $ > $ G ⇒ v ∊ ap (mtb u Q D K L X Y N C V F P I) s $;

--| `mtb` at equal arguments.
theorem mtb_eq (G: hyps) (U Q Q2 D K L X X2 Y Y2 N C V F F2 P I: class):
  $ G ⇒ Q = Q2 $ > $ G ⇒ X = X2 $ > $ G ⇒ Y = Y2 $ > $ G ⇒ F = F2 $ >
  $ G ⇒ mtb U Q D K L X Y N C V F P I = mtb U Q2 D K L X2 Y2 N C V F2 P I $;

-- --------------------------------------------------------------------------
-- The minors (D6 for the recursor's type): the walk
-- --------------------------------------------------------------------------

--| The step of the walk over a minor's type at a field `tA`, whose type in the minor is `tA3`
--| with the same value: if at every `a` in that value the rest's value is the space over the
--| rest's paths (with `a` put after the fields `gd` and the field's paths after the telescopes
--| `hd`) and its hypotheses' valuations are sequences over `u`, the same holds for the node.
--| @freshen G a
--| @freshen G z
--| @freshen G y
--| @freshen G f
--| @freshen G g
--| @freshen G c
--| @freshen G o
theorem mw_step {a z y f g c o: set} (G: hyps) (M D K L N C V P I: class) (u w rm rk fd gd hd tA3 tA tB tMin: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ rm ∊ fseq u $ >
  $ G ⇒ rk ∊ fseq u $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ gd ∊ fseq u $ >
  $ G ⇒ hd ∊ fseq {y | y = y} $ >
  $ G ⇒ tA3 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ tB ∊ trees ω $ >
  $ G ⇒ tMin ∊ trees ω $ >
  $ G ⇒ dt u M tA3 w rm = dt u M tA w rk $ >
  $ G ⇒ ∀ a (a ∊ dt u M tA3 w rm → dt u M tMin w (scons a rm) = fpi z (mqp (etel u (dnf u M) tB w (scons a rk)) D K L (ssnoc gd a) (ssnoc hd (etel u (dnf u M) tA w rk)) N) (ap (mtb u (etel u (dnf u M) tB w (scons a rk)) D K L (ssnoc gd a) (ssnoc hd (etel u (dnf u M) tA w rk)) N C V (scons a fd) P I) z)) $ >
  $ G ⇒ ∀ a (a ∊ dt u M tA3 w rm → ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) → ihv D K L (scat (ssnoc gd a) g) (scat (ssnoc hd (etel u (dnf u M) tA w rk)) c) N ⊆ fseq u)) $ >
  $ G ⇒ dt u M ⟨ kc_pi , scons tA3 (scons tMin ∅) ⟩ w rm = fpi z (mqp (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N) (ap (mtb u (etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk) D K L gd hd N C V fd P I) z) ∧ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk → ihv D K L (scat gd g) (scat hd c) N ⊆ fseq u) $;

--| A non-recursive field's type in a minor (`tA3`, the field's type lifted over the minors and
--| motives `c0`) has the value of the field's type in the constructor's, at the fields passed
--| `fd`, the parameters `pp` and the types' values `xs`.
theorem fld_nr (G: hyps) (M: class) (u w fd pp xs c0 rr d tnp tdp tkn tA tA3: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ pp ∊ fseq u $ >
  $ G ⇒ cdm pp = fv nvf tnp $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ cdm c0 = fv nvf tkn $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ ra_add d tnp tdp ∈ lrel $ >
  $ G ⇒ ra_closed tdp tA ∈ lrel $ >
  $ G ⇒ ra_lift tkn d tA tA3 ∈ lrel $ >
  $ G ⇒ dt u M tA3 w (scat fd (scat c0 (scat pp rr))) = dt u M tA w (scat fd (scat pp xs)) $;

--| A recursive field's type in a minor (the block's types put in, then lifted) has the value
--| of the field's type in the constructor's, which is closed past the types (`tx`).
--| @freshen G i
--| @freshen G b
theorem fld_rec {i b: set} (G: hyps) (M: class) (u w fd pp xs c0 rr d tnp tdp tkn tA tA3 tA2 td tn tx: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ pp ∊ fseq u $ >
  $ G ⇒ cdm pp = fv nvf tnp $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ cdm c0 = fv nvf tkn $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ ra_add d tnp tdp ∈ lrel $ >
  $ G ⇒ ra_closed tx tA ∈ lrel $ >
  $ G ⇒ fv nvf tx = nadd (fv nvf tdp) (cdm xs) $ >
  $ G ⇒ ra_lift tkn d tA2 tA3 ∈ lrel $ >
  $ G ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tdp tA tA2 ∈ lrel $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ ∀ i ∀ b (i ∊ cdm xs → b ∊ trees ω → fv nvf b = i → dt u M ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = fv xs i) $ >
  $ G ⇒ dt u M tA3 w (scat fd (scat c0 (scat pp rr))) = dt u M tA w (scat fd (scat pp xs)) $;

--| Likewise its paths.
--| @freshen G i
--| @freshen G b
theorem fld_rec_etel {i b: set} (G: hyps) (M: class) (u w fd pp xs c0 rr d tnp tdp tkn tA tA3 tA2 td tn tx: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ pp ∊ fseq u $ >
  $ G ⇒ cdm pp = fv nvf tnp $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ c0 ∊ fseq u $ >
  $ G ⇒ cdm c0 = fv nvf tkn $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ ra_add d tnp tdp ∈ lrel $ >
  $ G ⇒ ra_closed tx tA ∈ lrel $ >
  $ G ⇒ fv nvf tx = nadd (fv nvf tdp) (cdm xs) $ >
  $ G ⇒ ra_lift tkn d tA2 tA3 ∈ lrel $ >
  $ G ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tdp tA tA2 ∈ lrel $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ ∀ i ∀ b (i ∊ cdm xs → b ∊ trees ω → fv nvf b = i → dt u M ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = fv xs i) $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ etel u (dnf u M) tA3 w (scat fd (scat c0 (scat pp rr))) = etel u (dnf u M) tA w (scat fd (scat pp xs)) $;

--| The valuations of the hypotheses' context with one more hypothesis `tIH` in front, over `rv`:
--| when the context's are the inductive hypotheses' valuations up to field `Dn`, a recursive
--| field on type `J`, and the new hypothesis's type has the hypothesis's space as its value
--| over each of them, they are the valuations up to the next field.
--| @freshen G q
--| @freshen G a
theorem hih_rec {q a: set} (G: hyps) (M D K L Gg Tt Dn J: class) (u w rv tIH tIhs: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ rv ∊ fseq u $ >
  $ G ⇒ tIH ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tIhs ∊ trees ω $ >
  $ G ⇒ esat u (dsh u M rv) tIhs w = ihv D K L Gg Tt Dn $ >
  $ G ⇒ ∀ q (q ∊ esat u (dsh u M rv) tIhs w → dt u M tIH w (scat q rv) = ihsp L Gg Tt Dn J) $ >
  $ G ⇒ isset Tt $ >
  $ G ⇒ ∀ a (isset (ap L a)) $ >
  $ G ⇒ Dn ∈ ω $ >
  $ G ⇒ irf D K Dn J $ >
  $ G ⇒ esat u (dsh u M rv) ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ w = ihv D K L Gg Tt (suc Dn) $;

--| The type of the inductive hypothesis of field `d` (`mwalk_pi_rec`) at the valuation with the
--| hypotheses `q` before it, the later fields `f` and the field `a` in front of the minor's
--| valuation `rm` at the field: the hypothesis's space, for tables whose entries at `d` are `a`
--| and the paths of the field's type `tA3` at `rm`.
theorem ih_at (G: hyps) (M Gg Tt: class) (u w q f a rm fd mk cv c0 rs d td tnp tn tk tnf tr ta tsh tfld tmo tj tA3 tA4 tIH: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ q ∊ fseq u $ >
  $ G ⇒ cdm q = fv nvf tr $ >
  $ G ⇒ f ∊ fseq u $ >
  $ G ⇒ nadd (suc (cdm f)) (fv nvf d) = fv nvf tnf $ >
  $ G ⇒ a ∊ u $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ mk ∊ fseq u $ >
  $ G ⇒ cdm mk = fv nvf tk $ >
  $ G ⇒ cv ∊ fseq u $ >
  $ G ⇒ cdm cv = fv nvf tn $ >
  $ G ⇒ c0 = scat mk cv $ >
  $ G ⇒ rs ∊ fseq u $ >
  $ G ⇒ rm = scat fd (scat c0 rs) $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ tj ∊ trees ω $ >
  $ G ⇒ fv nvf tj ∈ fv nvf tn $ >
  $ G ⇒ intys td = fv nvf tn $ >
  $ G ⇒ ra_add tr tnf ta ∈ lrel $ >
  $ G ⇒ ra_add tsh d ta ∈ lrel $ >
  $ G ⇒ ra_add tfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tsh ∈ lrel $ >
  $ G ⇒ ra_add ta tk tmo ∈ lrel $ >
  $ G ⇒ ra_lift tsh ⟨ kc_nz , ∅ ⟩ tA3 tA4 ∈ lrel $ >
  $ G ⇒ ra_ihty td tnp tn tmo tfld ⟨ kc_nz , ∅ ⟩ tj tA4 tIH ∈ lrel $ >
  $ G ⇒ tA4 ∊ trees ω $ >
  $ G ⇒ tIH ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ fv Tt (fv nvf d) = etel u (dnf u M) tA3 w rm $ >
  $ G ⇒ fv Gg (fv nvf d) = a $ >
  $ G ⇒ dt u M tIH w (scat q (scat f (scons a rm))) = ihsp (imrel td cv) Gg Tt (fv nvf d) (fv nvf tj) $;

--| A field whose type is closed at its depth past the parameters is not recursive (`irf`).
--| @freshen G v
theorem nr_not_irf {v: set} (G: hyps) (td tp tt tnp tdp d te tA tK0: set):
  $ G ⇒ iprt td tp tt $ > $ G ⇒ ra_clen tp tnp ∈ lrel $ > $ G ⇒ ra_add d tnp tdp ∈ lrel $ > $ G ⇒ ra_closed tdp tA ∈ lrel $ > $ G ⇒ ra_nth_pi tK0 te tA ∈ lrel $ > $ G ⇒ fv nvf te = fv nvf d $ >
  $ G ⇒ ¬ ∃ v (irf td tK0 (fv nvf d) v) $;

-- --------------------------------------------------------------------------
-- The minors (D6 for the recursor's type): the leaf of the walk
-- --------------------------------------------------------------------------

--| The curried `Π` of a telescope and a type is the space over the telescope's valuations.
--| @freshen G z
theorem ipi_fpi {z: set} (G: hyps) (E P F: class) (u w: set):
  $ G ⇒ ipi u E P F w = fpi z (esat u E P w) (da (fv E F) w z) $;

--| The value of a re-headed spine `tX` of a spine `tA` of a head `n0` with one path of nothing:
--| the new head's `x0` applied to the first `tni` arguments of `tA`'s path.
--| @freshen G y
theorem rehead_val {y: set} (G: hyps) (M: class) (u w r n0 x0 tnp tni tA tX tY a: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ etel u (dnf u M) n0 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ >
  $ G ⇒ ra_spine n0 tY tnp ∈ lrel $ >
  $ G ⇒ ra_rehead tY x0 tni tA tX ∈ lrel $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ tX ∊ trees ω $ >
  $ G ⇒ tY ∊ trees ω $ >
  $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tA w r $ >
  $ G ⇒ cres a (fv nvf tni) ∈ fseq {y | y = y} ∧ dt u M tX w r = apn (dt u M x0 w r) (cres a (fv nvf tni)) $;

--| The value of a minor's result type `X @ Y2` (`mwalk_res`) at the hypotheses `q` in front of
--| the minor's valuation: the motive (the entry `Km` of the motives `cv`) at the indices (the
--| first `NI` arguments `e` of the constructor type's result at the fields `fd`, the parameters
--| `pp` and the types' values) and the constructor's trace `CT` at the fields and parameters.
--| @freshen G x
--| @freshen G c
theorem mw_leaf_val {x c: set} (G: hyps) (M CT Km NI: class) (u w q fd pp xs mk cv c0 rr rm rk nc e d td ti tc tn tnp tk tkn tr ta tb tmi th tni tK tK2 tK3 tY tX tY1 tY2: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ q ∊ fseq u $ >
  $ G ⇒ cdm q = fv nvf tr $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ pp ∊ fseq u $ >
  $ G ⇒ cdm pp = fv nvf tnp $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ mk ∊ fseq u $ >
  $ G ⇒ cdm mk = fv nvf tk $ >
  $ G ⇒ cv ∊ fseq u $ >
  $ G ⇒ cdm cv = fv nvf tn $ >
  $ G ⇒ c0 = scat mk cv $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ rm = scat fd (scat c0 (scat pp rr)) $ >
  $ G ⇒ rk = scat fd (scat pp xs) $ >
  $ G ⇒ nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ $ >
  $ G ⇒ nc ∊ trees ω $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u M nc w x = CT) $ >
  $ G ⇒ ∀ x (isset (apn (CT) x)) $ >
  $ G ⇒ Km ∈ ω $ >
  $ G ⇒ nadd (suc Km) (fv nvf ti) = fv nvf tn $ >
  $ G ⇒ ∀ c (ra_nidx td ti c ∈ lrel → fv nvf c = NI) $ >
  $ G ⇒ ra_add tk tn tkn ∈ lrel $ >
  $ G ⇒ ra_lift tkn d tK tK2 ∈ lrel $ >
  $ G ⇒ ra_lift tr ⟨ kc_nz , ∅ ⟩ tK2 tK3 ∈ lrel $ >
  $ G ⇒ ra_nidx td ti tni ∈ lrel $ >
  $ G ⇒ ra_rehead tY ⟨ kc_bvar , scons tmi ∅ ⟩ tni tK3 tX ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_bvar , scons th ∅ ⟩ tY tnp ∈ lrel $ >
  $ G ⇒ ra_add tr d ta ∈ lrel $ >
  $ G ⇒ ra_add ta tkn tb ∈ lrel $ >
  $ G ⇒ ra_add tmi ⟨ kc_s , scons ti ∅ ⟩ tb ∈ lrel $ >
  $ G ⇒ ra_pargs nc tb tnp tY1 ∈ lrel $ >
  $ G ⇒ ra_pargs tY1 tr d tY2 ∈ lrel $ >
  $ G ⇒ tK ∊ trees ω $ >
  $ G ⇒ tX ∊ trees ω $ >
  $ G ⇒ tY2 ∊ trees ω $ >
  $ G ⇒ ra_indapp td tn tnp d tK ti ∈ lrel $ >
  $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , e ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tK w rk $ >
  $ G ⇒ dt u M ⟨ kc_app , scons tX (scons tY2 ∅) ⟩ w (scat q rm) = apn (fv cv Km) (scons (apn (CT) (scat fd pp)) (cres e (NI))) $;

--| The leaf of the walk over a minor's type (`mwalk_res`): `Π Ihs. X @ Y2` at the minor's
--| valuation `rm` is the space over the minor's paths at the constructor type's result `tK`
--| (one path of nothing: the paths are the hypotheses' valuations, which the context `tIhs`
--| has at it), with the motive at the result's indices and the constructor's value.
--| @freshen G x
--| @freshen G c
--| @freshen G a
--| @freshen G b
--| @freshen G i
--| @freshen G z
--| @freshen G y
theorem mw_leaf {x c a b i z y: set} (G: hyps) (M CT Km NI D K0 L N: class) (u w fd gd hd pp xs mk cv c0 rr rm rk nc d td ti tc tn tnp tk tkn tr ta tb tmi th tni tK tK2 tK3 tY tX tY1 tY2 tIhs tMin: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ gd ∊ fseq u $ >
  $ G ⇒ hd ∊ fseq {y | y = y} $ >
  $ G ⇒ pp ∊ fseq u $ >
  $ G ⇒ cdm pp = fv nvf tnp $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ mk ∊ fseq u $ >
  $ G ⇒ cdm mk = fv nvf tk $ >
  $ G ⇒ cv ∊ fseq u $ >
  $ G ⇒ cdm cv = fv nvf tn $ >
  $ G ⇒ c0 = scat mk cv $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ rm = scat fd (scat c0 (scat pp rr)) $ >
  $ G ⇒ rk = scat fd (scat pp xs) $ >
  $ G ⇒ nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ $ >
  $ G ⇒ nc ∊ trees ω $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u M nc w x = CT) $ >
  $ G ⇒ ∀ x (isset (apn (CT) x)) $ >
  $ G ⇒ Km ∈ ω $ >
  $ G ⇒ nadd (suc Km) (fv nvf ti) = fv nvf tn $ >
  $ G ⇒ ∀ c (ra_nidx td ti c ∈ lrel → fv nvf c = NI) $ >
  $ G ⇒ ra_add tk tn tkn ∈ lrel $ >
  $ G ⇒ ra_lift tkn d tK tK2 ∈ lrel $ >
  $ G ⇒ ra_lift tr ⟨ kc_nz , ∅ ⟩ tK2 tK3 ∈ lrel $ >
  $ G ⇒ ra_nidx td ti tni ∈ lrel $ >
  $ G ⇒ ra_rehead tY ⟨ kc_bvar , scons tmi ∅ ⟩ tni tK3 tX ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_bvar , scons th ∅ ⟩ tY tnp ∈ lrel $ >
  $ G ⇒ ra_add tr d ta ∈ lrel $ >
  $ G ⇒ ra_add ta tkn tb ∈ lrel $ >
  $ G ⇒ ra_add tmi ⟨ kc_s , scons ti ∅ ⟩ tb ∈ lrel $ >
  $ G ⇒ ra_pargs nc tb tnp tY1 ∈ lrel $ >
  $ G ⇒ ra_pargs tY1 tr d tY2 ∈ lrel $ >
  $ G ⇒ tK ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tMin ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_pis tIhs ⟨ kc_app , scons tX (scons tY2 ∅) ⟩ tMin ∈ lrel $ >
  $ G ⇒ ra_indapp td tn tnp d tK ti ∈ lrel $ >
  $ G ⇒ ra_clen tIhs tr ∈ lrel $ >
  $ G ⇒ ∀ a ∀ b ∀ c ∀ i (⟨ a , ⟨ b , ⟨ c , i ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tK w rk → tIhs ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (scat a rm)) tIhs w = ihv D K0 L (scat gd b) (scat hd c) N) $ >
  $ G ⇒ dt u M tMin w rm = fpi z (mqp (etel u (dnf u M) tK w rk) D K0 L gd hd N) (ap (mtb u (etel u (dnf u M) tK w rk) D K0 L gd hd N (fv cv Km) (CT) fd pp (NI)) z) ∧ ∀ a ∀ b ∀ c ∀ i (⟨ a , ⟨ b , ⟨ c , i ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tK w rk → ihv D K0 L (scat gd b) (scat hd c) N ⊆ fseq u) $;

--| The hypotheses' valuations at the paths of the rest after a non-recursive field `a`: those at
--| the node's paths, at the tables extended by `a` and the field's paths; the stage `Dn2`
--| (the next field) has the valuations of `Dn`.
--| @freshen G f
--| @freshen G g
--| @freshen G c
--| @freshen G o
--| @freshen G y
theorem hih_nr {f g c o y: set} (G: hyps) (M D K L Dn Dn2: class) (u w rm rk gd hd tA tB a tIhs: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ rm ∊ fseq u $ >
  $ G ⇒ rk ∊ fseq u $ >
  $ G ⇒ gd ∊ fseq u $ >
  $ G ⇒ hd ∊ fseq {y | y = y} $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ tB ∊ trees ω $ >
  $ G ⇒ a ∊ dt u M tA w rk $ >
  $ G ⇒ a ∊ u $ >
  $ G ⇒ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk → tIhs ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (scat f rm)) tIhs w = ihv D K L (scat gd g) (scat hd c) Dn) $ >
  $ G ⇒ ∀ g ∀ c (ihv D K L g c Dn2 = ihv D K L g c Dn) $ >
  $ G ⇒ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) → tIhs ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (scat f (scons a rm))) tIhs w = ihv D K L (scat (ssnoc gd a) g) (scat (ssnoc hd (etel u (dnf u M) tA w rk)) c) Dn2) $;

--| After a recursive field `a`, with the new hypothesis `tIH` in front of the context: the
--| valuations up to the next field, when `tIH`'s value over each valuation of the context is
--| the hypothesis's space.
--| @freshen G f
--| @freshen G g
--| @freshen G c
--| @freshen G o
--| @freshen G y
--| @freshen G q
--| @freshen G x
theorem hih_rc {f g c o y q x: set} (G: hyps) (M D K L Dn Dn2 J: class) (u w rm rk gd hd tA tB a tIhs tIH tr: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ rm ∊ fseq u $ >
  $ G ⇒ rk ∊ fseq u $ >
  $ G ⇒ gd ∊ fseq u $ >
  $ G ⇒ hd ∊ fseq {y | y = y} $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ tB ∊ trees ω $ >
  $ G ⇒ a ∊ dt u M tA w rk $ >
  $ G ⇒ a ∊ u $ >
  $ G ⇒ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons tA (scons tB ∅) ⟩ w rk → tIhs ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (scat f rm)) tIhs w = ihv D K L (scat gd g) (scat hd c) Dn) $ >
  $ G ⇒ ra_clen tIhs tr ∈ lrel $ >
  $ G ⇒ ∀ q ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) → ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx → q ∊ fseq u → cdm q = fv nvf tr → dt u M tIH w (scat q (scat f (scons a rm))) = ihsp L (scat (ssnoc gd a) g) (scat (ssnoc hd (etel u (dnf u M) tA w rk)) c) Dn J) $ >
  $ G ⇒ ∀ x (isset (ap L x)) $ >
  $ G ⇒ Dn ∈ ω $ >
  $ G ⇒ irf D K Dn J $ >
  $ G ⇒ Dn2 = suc Dn $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tB w (scons a rk) → ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ ∈ ofsort lsig lopen ks_ctx → esat u (dsh u M (scat f (scons a rm))) ⟨ kc_cons , scons tIH (scons tIhs ∅) ⟩ w = ihv D K L (scat (ssnoc gd a) g) (scat (ssnoc hd (etel u (dnf u M) tA w rk)) c) Dn2) $;

-- --------------------------------------------------------------------------
-- The minors (D6 for the recursor's type): the walk over a constructor's type
-- --------------------------------------------------------------------------

--| `add 0 a e`: `e` is `a` (as trees).
theorem add_zero_l (G: hyps) (a e: set): $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ a e ∈ lrel $ > $ G ⇒ e = a $;

--| `add (s d) a e` gives `add d (s a) e`.
theorem add_shift (G: hyps) (d a e: set): $ G ⇒ ra_add ⟨ kc_s , scons d ∅ ⟩ a e ∈ lrel $ > $ G ⇒ ra_add d ⟨ kc_s , scons a ∅ ⟩ e ∈ lrel $;

--| A `Π` is not an application of a type of the block (`indapp`).
theorem indapp_not_pi (G: hyps) (t1 t2 t3 t4 a b t6: set): $ G ⇒ ra_indapp t1 t2 t3 t4 ⟨ kc_pi , scons a (scons b ∅) ⟩ t6 ∈ lrel $ > $ G ⇒ ⊥ $;

--| A closed `Π`: its domain is closed, its body closed one binder deeper.
theorem closed_pi_inv (G: hyps) (tx ta tb: set): $ G ⇒ ra_closed tx ⟨ kc_pi , scons ta (scons tb ∅) ⟩ ∈ lrel $ > $ G ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed ⟨ kc_s , scons tx ∅ ⟩ tb ∈ lrel $;

--| The binders of a `Π`: one more than its body's.
--| @freshen G n
theorem npis_pi_inv {n: set} (G: hyps) (ta tb tq: set): $ G ⇒ ra_npis ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tq ∈ lrel $ > $ G ⇒ ∃ n (tq = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_npis tb n ∈ lrel) $;

--| A well-formed constructor type that is a `Π`: its body is one, a binder deeper.
--| @freshen G c
theorem cwf_pi_inv {c: set} (G: hyps) (J: class) (t1 t2 t3 t4 t5 t6 t7 ta tb: set): $ G ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 ⟨ kc_pi , scons ta (scons tb ∅) ⟩ ∈ lrel3 J $ > $ G ⇒ ∃ c (ra_cwf t1 t2 t3 t4 t5 c ⟨ kc_s , scons t7 ∅ ⟩ tb ∈ lrel3 J) $;

--| A well-formed constructor type with no binders is an application of its type.
theorem cwf_leaf (G: hyps) (J: class) (t1 t2 t3 t4 t5 t6 t7 t8 tq: set):
  $ G ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel3 J $ > $ G ⇒ ra_npis t8 tq ∈ lrel $ > $ G ⇒ fv nvf tq = ∅ $ > $ G ⇒ ra_indapp t1 t2 t3 t7 t8 t5 ∈ lrel $;

--| The walk over a minor's type (`mwalk`): the rest `tMin` of a minor's type, read off the rest `tK`
--| of the constructor's type after `d` fields, has at the minor's valuation `rm` (the fields
--| passed `fd` in front of the minors and motives `c0`, the parameters `pp` and the outer
--| valuation `rr`) the space over the minor's paths as its value: the paths of `tK` at
--| `rk` (the fields in front of the parameters and the types' values `xs`) behind inductive
--| hypotheses, valued in the motive at the result's indices and the constructor applied to all
--| the fields. `gd` and `hd` are the fields passed and the paths of their types, in order.
--| The hypotheses: the rest is closed at `d` past the parameters and types (`tx`), has `tq`
--| binders left, is well-formed (`cwf`), its binders are the later binders of the whole type
--| `tK0`, and the context `tIhs` of the hypotheses so far has their valuations at each path.
--| @freshen G z
--| @freshen G y
--| @freshen G f
--| @freshen G g
--| @freshen G c
--| @freshen G o
--| @freshen G x
theorem mwalk_sem {z y f g c o x: set} (G: hyps) (M CT Km NI J: class) (u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl: set) (tK d tr tIhs tMin fd gd hd rm rk tx tq tg: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ pp ∊ fseq u $ >
  $ G ⇒ cdm pp = fv nvf tnp $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ mk ∊ fseq u $ >
  $ G ⇒ cdm mk = fv nvf tk $ >
  $ G ⇒ cv ∊ fseq u $ >
  $ G ⇒ cdm cv = fv nvf tn $ >
  $ G ⇒ c0 = scat mk cv $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ $ >
  $ G ⇒ nc ∊ trees ω $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u M nc w x = CT) $ >
  $ G ⇒ ∀ x (isset (apn (CT) x)) $ >
  $ G ⇒ Km ∈ ω $ >
  $ G ⇒ nadd (suc Km) (fv nvf ti) = fv nvf tn $ >
  $ G ⇒ ∀ c (ra_nidx td ti c ∈ lrel → fv nvf c = NI) $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → fv nvf g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = fv xs f) $ >
  $ G ⇒ intys td = fv nvf tn $ >
  $ G ⇒ iprt td tp tt $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ∀ x (isset (ap (imrel td cv) x)) $ >
  $ G ⇒ ra_mwalk td tnp tn tk ti tc tnf d tr tIhs tK tMin ∈ lrel $ >
  $ G ⇒ tK ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tMin ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ d ∊ trees ω $ >
  $ G ⇒ ra_closed tx tK ∈ lrel $ >
  $ G ⇒ fv nvf tx = nadd (nadd (fv nvf d) (fv nvf tnp)) (fv nvf tn) $ >
  $ G ⇒ ra_npis tK tq ∈ lrel $ >
  $ G ⇒ nadd (fv nvf tq) (fv nvf d) = fv nvf tnf $ >
  $ G ⇒ ra_cwf td tn tnp tl ti tg d tK ∈ lrel3 J $ >
  $ G ⇒ ∀ f ∀ g ∀ c (ra_nth_pi tK f g ∈ lrel → ra_add d f c ∈ lrel → ra_nth_pi tK0 c g ∈ lrel) $ >
  $ G ⇒ ra_clen tIhs tr ∈ lrel $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ gd ∊ fseq u $ >
  $ G ⇒ cdm gd = fv nvf d $ >
  $ G ⇒ hd ∊ fseq {y | y = y} $ >
  $ G ⇒ cdm hd = fv nvf d $ >
  $ G ⇒ rm = scat fd (scat c0 (scat pp rr)) $ >
  $ G ⇒ rk = scat fd (scat pp xs) $ >
  $ G ⇒ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tK w rk → tIhs ∊ ofsort lsig lopen ks_ctx → esat u (dsh u M (scat f rm)) tIhs w = ihv td tK0 (imrel td cv) (scat gd g) (scat hd c) (fv nvf d)) $ >
  $ G ⇒ dt u M tMin w rm = fpi z (mqp (etel u (dnf u M) tK w rk) td tK0 (imrel td cv) gd hd (fv nvf tnf)) (ap (mtb u (etel u (dnf u M) tK w rk) td tK0 (imrel td cv) gd hd (fv nvf tnf) (fv cv Km) (CT) fd pp (NI)) z) ∧ ∀ f ∀ g ∀ c ∀ o (⟨ f , ⟨ g , ⟨ c , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tK w rk → ihv td tK0 (imrel td cv) (scat gd g) (scat hd c) (fv nvf tnf) ⊆ fseq u) $;

-- --------------------------------------------------------------------------
-- The minors (D6 for the recursor's type): a minor
-- --------------------------------------------------------------------------

--| A minor's type (`mwalk` from depth `0` over the constructor's type `tK0`) has the minor's space `imin` as its
--| value, at the valuation with the minors before it `mk` and the motives `cv` in front of the
--| parameters `pp`: for a hook whose value at the constructor's node is `ictor` and whose values
--| at the types' nodes are the entries of `xs`, the family's values. `Km` is the motive's
--| entry (`Km + 1 + i = n`); the constructor's type is closed past the parameters and types and
--| well-formed (`cwf`).
--| @freshen G f
--| @freshen G g
--| @freshen G x
theorem min_sem {f g x: set} (G: hyps) (M Km J V: class) (u w pp xs mk cv c0 rr nc td tp tt ti tc tn tm tnp tk tnf tK0 tl tF tC tMin tx tg: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ pp ∊ esat u (dnf u M) tp w $ >
  $ G ⇒ xs = ixs td w (ifam u (dnf u M) td w) $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ mk ∊ fseq u $ >
  $ G ⇒ cdm mk = fv nvf tk $ >
  $ G ⇒ cv ∊ imots u (dnf u M) td w pp V $ >
  $ G ⇒ c0 = scat mk cv $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ nc = ⟨ kc_ind_ctor , scons td (scons ti (scons tc ∅)) ⟩ $ >
  $ G ⇒ nc ∊ trees ω $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u M nc w x = (ictor u (dnf u M) td (fv nvf ti) (fv nvf tc) w)) $ >
  $ G ⇒ ∀ x (isset (apn ((ictor u (dnf u M) td (fv nvf ti) (fv nvf tc) w)) x)) $ >
  $ G ⇒ Km ∈ ω $ >
  $ G ⇒ nadd (suc Km) (fv nvf ti) = fv nvf tn $ >
  $ G ⇒ fv nvf ti ∈ fv nvf tn $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → fv nvf g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = fv xs f) $ >
  $ G ⇒ intys td = fv nvf tn $ >
  $ G ⇒ iprt td tp tt $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tC ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tC tc tK0 ∈ lrel $ >
  $ G ⇒ ra_npis tK0 tnf ∈ lrel $ >
  $ G ⇒ ra_mwalk td tnp tn tk ti tc tnf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ tK0 tMin ∈ lrel $ >
  $ G ⇒ tK0 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tMin ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_closed tx tK0 ∈ lrel $ >
  $ G ⇒ fv nvf tx = nadd (fv nvf tnp) (fv nvf tn) $ >
  $ G ⇒ ra_cwf td tn tnp tl ti tg ⟨ kc_nz , ∅ ⟩ tK0 ∈ lrel3 J $ >
  $ G ⇒ dt u M tMin w (scat c0 (scat pp rr)) = imin u (dnf u M) td (fv nvf ti) (fv nvf tc) w pp cv $;

-- --------------------------------------------------------------------------
-- The minors' telescope (D6 for the recursor's type)
-- --------------------------------------------------------------------------

--| The minors of the constructors `tC` of one type `ti` (`cminors`, from constructor `tc` on,
--| minor `tk` on): over the earlier minors `mk`, the motives `cv` and the parameters `pp`, the
--| valuations of their context `tM` are the sequences with the minor of constructor `c` in the
--| space of minor `k` (`N` is `tk` plus the number `tq` of constructors left). `tC` is the rest
--| of the type's constructors `tC0` (`add` gives each one's number), and constructor `c` has
--| minor `c + tk0`. The hypotheses on the hook and on each constructor are `min_sem`'s.
--| @freshen G l
--| @freshen G i
--| @freshen G v
--| @freshen G a
--| @freshen G o
--| @freshen G f
--| @freshen G g
--| @freshen G b
--| @freshen G e
theorem cminors_sem {l i v a o f g b e: set} (G: hyps) (M Km J V N: class) (u w pp xs cv rr td tp tt ti tn tm tnp tF tC0 tk0: set) (tC tk tc tM mk tq r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ pp ∊ esat u (dnf u M) tp w $ >
  $ G ⇒ xs = ixs td w (ifam u (dnf u M) td w) $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ cv ∊ imots u (dnf u M) td w pp V $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → fv nvf g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = fv xs f) $ >
  $ G ⇒ intys td = fv nvf tn $ >
  $ G ⇒ iprt td tp tt $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tC0 ∈ lrel $ >
  $ G ⇒ Km ∈ ω $ >
  $ G ⇒ nadd (suc Km) (fv nvf ti) = fv nvf tn $ >
  $ G ⇒ fv nvf ti ∈ fv nvf tn $ >
  $ G ⇒ ti ∊ trees ω $ >
  $ G ⇒ ∀ b ∀ f (b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons ti (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (fv nvf ti) (fv nvf b) w) $ >
  $ G ⇒ ∀ b ∀ e (ra_nth_ctor tC0 b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (fv nvf ti) (fv nvf b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ fv nvf a = nadd (fv nvf tnp) (fv nvf tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l ti o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) $ >
  $ G ⇒ ∀ b (b ∊ ofsort lsig lopen ks_nat → iminx td (fv nvf ti) (fv nvf b) (nadd (fv nvf b) (fv nvf tk0))) $ >
  $ G ⇒ ra_cminors td tnp tn tk ti tc tC tM ∈ lrel $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tc ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ fv nvf tk = nadd (fv nvf tc) (fv nvf tk0) $ >
  $ G ⇒ ∀ a ∀ e (ra_nth_ctor tC a e ∈ lrel → ∃ b (ra_add a tc b ∈ lrel ∧ ra_nth_ctor tC0 b e ∈ lrel)) $ >
  $ G ⇒ ra_clen_c tC tq ∈ lrel $ >
  $ G ⇒ nadd (fv nvf tk) (fv nvf tq) = N $ >
  $ G ⇒ mk ∊ fseq u $ >
  $ G ⇒ cdm mk = fv nvf tk $ >
  $ G ⇒ r = scat mk (scat cv (scat pp rr)) $ >
  $ G ⇒ esat u (dsh u M r) tM w = {l | l ∊ fseq u ∧ cdm l = fv nvf tq ∧ ∀ i (i ∊ N → fv nvf tk ⊆ i → vat (scat l mk) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $;

--| A sequence of length `a + b` is a sequence of length `a` in front of one of length `b`.
--| @freshen G q
--| @freshen G g
theorem fseq_split {q g: set} (G: hyps) (A: class) (s a b: set):
  $ G ⇒ s ∊ fseq A $ > $ G ⇒ a ∊ ω $ > $ G ⇒ b ∊ ω $ > $ G ⇒ cdm s = nadd a b $ >
  $ G ⇒ ∃ q ∃ g (q ∊ fseq A ∧ g ∊ fseq A ∧ cdm q = a ∧ cdm g = b ∧ s = scat q g) $;

--| The minors of the types `tT` (`minors`, from type `ti` on, minor `tk` on): over the earlier
--| minors `mk`, the motives `cv` and the parameters `pp`, the valuations of their context `tM`
--| are the sequences with each minor in its space (`N` is `tk` plus the number `tq` of
--| constructors left; `tj` types are left). `tT` is the rest of the block's types `tt`: `add`
--| gives each type's number, and a minor index in `tT` is one in `tt` with `ti` added to the
--| type and `tk` to the minor. The hypotheses on the hook, at every type and constructor, are
--| `min_sem`'s.
--| @freshen G l
--| @freshen G i
--| @freshen G v
--| @freshen G a
--| @freshen G o
--| @freshen G f
--| @freshen G g
--| @freshen G b
--| @freshen G e
theorem minors_sem {l i v a o f g b e: set} (G: hyps) (M J V N: class) (u w pp xs cv rr td tp tt tn tm tnp: set) (tT tk ti tM mk tj tq r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ pp ∊ esat u (dnf u M) tp w $ >
  $ G ⇒ xs = ixs td w (ifam u (dnf u M) td w) $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ cv ∊ imots u (dnf u M) td w pp V $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → fv nvf g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = fv xs f) $ >
  $ G ⇒ intys td = fv nvf tn $ >
  $ G ⇒ iprt td tp tt $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (fv nvf a) (fv nvf b) w) $ >
  $ G ⇒ ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (fv nvf i) (fv nvf b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ fv nvf a = nadd (fv nvf tnp) (fv nvf tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) $ >
  $ G ⇒ ra_minors td tnp tn tk ti tT tM ∈ lrel $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_ntys tT tj tq ∈ lrel $ >
  $ G ⇒ nadd (fv nvf ti) (fv nvf tj) = fv nvf tn $ >
  $ G ⇒ nadd (fv nvf tk) (fv nvf tq) = N $ >
  $ G ⇒ ∀ a ∀ f ∀ e (ra_nth_ty tT a f e ∈ lrel → ∃ b (ra_add a ti b ∈ lrel ∧ ra_nth_ty tt b f e ∈ lrel)) $ >
  $ G ⇒ ∀ a ∀ b ∀ e (b ∊ ofsort lsig lopen ks_nat → e ∊ ofsort lsig lopen ks_nat → ra_minor_idx tT a b e ∈ lrel → ∃ g ∃ o (ra_minor_idx tt g b o ∈ lrel ∧ fv nvf g = nadd (fv nvf a) (fv nvf ti) ∧ fv nvf o = nadd (fv nvf e) (fv nvf tk))) $ >
  $ G ⇒ mk ∊ fseq u $ >
  $ G ⇒ cdm mk = fv nvf tk $ >
  $ G ⇒ r = scat mk (scat cv (scat pp rr)) $ >
  $ G ⇒ esat u (dsh u M r) tM w = {l | l ∊ fseq u ∧ cdm l = fv nvf tq ∧ ∀ i (i ∊ N → fv nvf tk ⊆ i → vat (scat l mk) N i ∈ {v | ∃ a ∃ o (iminx td a o i ∧ v ∊ imin u (dnf u M) td a o w pp cv ∧ ihasc td a o)})} $;

-- --------------------------------------------------------------------------
-- The minors' telescope at the whole block (D6 for the recursor's type)
-- --------------------------------------------------------------------------

--| The minors' telescope of the whole block (`minors` from type `0` and minor `0`) over the
--| motives `cv` and the parameters `pp`: its valuations are `imins`, the sequences with a minor
--| in its space for every constructor. The hypotheses on the hook are `minors_sem`'s.
--| @freshen G l
--| @freshen G i
--| @freshen G v
--| @freshen G a
--| @freshen G o
--| @freshen G f
--| @freshen G g
--| @freshen G b
--| @freshen G e
theorem imins_sem {l i v a o f g b e: set} (G: hyps) (M J V: class) (u w pp xs cv rr td tb tp tt tn tm tnp tN r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ pp ∊ esat u (dnf u M) tp w $ >
  $ G ⇒ xs = ixs td w (ifam u (dnf u M) td w) $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ cv ∊ imots u (dnf u M) td w pp V $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ td ∊ trees ω $ >
  $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → fv nvf g = f → dt u M ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = fv xs f) $ >
  $ G ⇒ intys td = fv nvf tn $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u M ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u M) td (fv nvf a) (fv nvf b) w) $ >
  $ G ⇒ ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u M) td (fv nvf i) (fv nvf b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ fv nvf a = nadd (fv nvf tnp) (fv nvf tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ r = scat cv (scat pp rr) $ >
  $ G ⇒ esat u (dsh u M r) tN w = imins u (dnf u M) td w pp cv $;

--| The motives' telescope of the whole block (`motives` from type `0`) over the parameters `p`:
--| its valuations are `imots`, the sequences with a motive in its space for every type. The
--| hypotheses on the hook are `motives_sem`'s.
--| @freshen G a
--| @freshen G b
--| @freshen G x
--| @freshen G f
theorem imots_sem {a b x f: set} (G: hyps) (M: class) (u w td tnp tv tn p rr tt tm tM r: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ tv ∊ trees ω $ >
  $ G ⇒ ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → fv nvf a ∈ fv nvf tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u M b w x = ity u (dnf u M) td (fv nvf a) w) $ >
  $ G ⇒ ∀ a (a ∊ ofsort lsig lopen ks_nat → fv nvf a ∈ fv nvf tn → ity u (dnf u M) td (fv nvf a) w ∈ u) $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ∀ a ∀ f ∀ b (ra_nth_ty tt a f b ∈ lrel → ityf td (fv nvf a) f ∧ ra_closed tnp f ∈ lrel) $ >
  $ G ⇒ intys td = fv nvf tn $ >
  $ G ⇒ r = scat p rr $ >
  $ G ⇒ esat u (dsh u M r) tM w = imots u (dnf u M) td w p (lv tv w) $;

-- --------------------------------------------------------------------------
-- The recursor in its type (D6 and E5 for `rec_ty`)
-- --------------------------------------------------------------------------

--| The recursor's value in the value of its type: for a block with `iwf`, motives at the level of
--| `tv` and the type `tR` of `rec_ty` (`Π` over the parameters `tp`, the motives `tM`, the minors `tN`,
--| then the tail `tB` of type `ti`), `irc` is an element of `tR`'s value at every valuation `rr`.
--| The hook's values at the block's types and constructors are hypotheses (those of `imots_sem`
--| and `imins_sem`).
--| @freshen G a
--| @freshen G b
--| @freshen G x
--| @freshen G f
--| @freshen G g
--| @freshen G i
--| @freshen G v
--| @freshen G e
--| @freshen G l
--| @freshen G o
theorem rec_ty_sem {a b x f g i v e l o: set} (G: hyps) (H J Rc: class) (u w rr td tb tp tt tv ti tnp tn tm tmn tM tN tF tC tF2 tB tR1 tR2 tR xs tc tk tl: set):
  $ G ⇒ iwf u H J tc td w Rc $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_tys_closed tp tt ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tC ∈ lrel $ >
  $ G ⇒ ra_isort tF tk tl ∈ lrel $ >
  $ G ⇒ ra_elim_ok tc td tv ∈ lrel3 J $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ ra_add tm tn tmn ∈ lrel $ >
  $ G ⇒ ra_lift tmn ⟨ kc_nz , ∅ ⟩ tF tF2 ∈ lrel $ >
  $ G ⇒ ra_rtail td tnp tn tm ti ⟨ kc_nz , ∅ ⟩ tF2 tB ∈ lrel $ >
  $ G ⇒ ra_pis tN tB tR1 ∈ lrel $ >
  $ G ⇒ ra_pis tM tR1 tR2 ∈ lrel $ >
  $ G ⇒ ra_pis tp tR2 tR ∈ lrel $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ ∀ a ∀ b ∀ x (a ∊ ofsort lsig lopen ks_nat → fv nvf a ∈ fv nvf tn → b = ⟨ kc_ind_ty , scons td (scons a ∅) ⟩ → x ∊ fseq u → dt u (mcv H) b w x = ity u (dnf u (mcv H)) td (fv nvf a) w) $ >
  $ G ⇒ ∀ a (a ∊ ofsort lsig lopen ks_nat → fv nvf a ∈ fv nvf tn → ity u (dnf u (mcv H)) td (fv nvf a) w ∈ u) $ >
  $ G ⇒ ∀ a ∀ f ∀ b (ra_nth_ty tt a f b ∈ lrel → ityf td (fv nvf a) f ∧ ra_closed tnp f ∈ lrel) $ >
  $ G ⇒ xs = ixs td w (ifam u (dnf u (mcv H)) td w) $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ ∀ f ∀ g (f ∊ cdm xs → g ∊ trees ω → fv nvf g = f → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons g ∅) ⟩ w ∅ = fv xs f) $ >
  $ G ⇒ ∀ a ∀ b ∀ f (a ∊ trees ω → b ∊ trees ω → f ∊ fseq u → dt u (mcv H) ⟨ kc_ind_ctor , scons td (scons a (scons b ∅)) ⟩ w f = ictor u (dnf u (mcv H)) td (fv nvf a) (fv nvf b) w) $ >
  $ G ⇒ ∀ i ∀ g ∀ v ∀ b ∀ e (ra_nth_ty tt i g v ∈ lrel → ra_nth_ctor v b e ∈ lrel → e ∊ ofsort lsig lopen ks_expr ∧ ∀ f (isset (apn (ictor u (dnf u (mcv H)) td (fv nvf i) (fv nvf b) w) f)) ∧ ∃ a (ra_closed a e ∈ lrel ∧ fv nvf a = nadd (fv nvf tnp) (fv nvf tn)) ∧ ∃ l ∃ o (ra_cwf td tn tnp l i o ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J)) $ >
  $ G ⇒ irc u (dnf u (mcv H)) td (fv nvf ti) (lv tv w) w ∈ dt u (mcv H) tR w rr $;

-- --------------------------------------------------------------------------
-- The recursor's rule (E5): the hook's facts from `ind_wf`, then `ind_rec_ty`
-- --------------------------------------------------------------------------

--| The constructors of the `i`-th type of a well-formed list of types are well formed at the
--| index `i` itself (`tys_wf` counts in unary, as `nth_ty` does).
theorem tys_wf_nth_ctors (G: hyps) (J: class) (td tn tnp tl tc: set) (tt ti tf te: set):
  $ G ⇒ ra_tys_wf td tn tnp tl ⟨ kc_nz , ∅ ⟩ tc tt ∈ lrel3 J $ > $ G ⇒ ra_nth_ty tt ti tf te ∈ lrel $ >
  $ G ⇒ ra_ctors_wf td tn tnp tl ti tc te ∈ lrel3 J $;

--| A closed `Π P. F` has `F` closed at the numeral of `P`'s length (`lrel_pis_closed` gives a
--| numeral with that value).
theorem pis_closed_clen (G: hyps) (tp tf tr tq: set):
  $ G ⇒ ra_pis tp tf tr ∈ lrel $ > $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ tr ∈ lrel $ > $ G ⇒ ra_clen tp tq ∈ lrel $ >
  $ G ⇒ ra_closed tq tf ∈ lrel $;

--| The recursor's value is an element of the value of the type `rec_ty` builds, for a well-formed
--| block: `rec_ty_sem` with the hook's facts at the types and the constructors proved from `ind_wf`
--| (the types' values by `hty`, the constructors' by `hctor`; `tys_wf_nth_ctors` for each
--| constructor's `cwf`, `ictor_apn_fiber` and `nestfn_universe` for its value in the universe).
theorem rec_ty_wf (G: hyps) (H J: class) (u w r0 rr tg td tb tp tt tv ti tnp tn tm tmn tM tN tF tC tF2 tB tR1 tR2 tR: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tC ∈ lrel $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ ra_add tm tn tmn ∈ lrel $ >
  $ G ⇒ ra_lift tmn ⟨ kc_nz , ∅ ⟩ tF tF2 ∈ lrel $ >
  $ G ⇒ ra_rtail td tnp tn tm ti ⟨ kc_nz , ∅ ⟩ tF2 tB ∈ lrel $ >
  $ G ⇒ ra_pis tN tB tR1 ∈ lrel $ >
  $ G ⇒ ra_pis tM tR1 tR2 ∈ lrel $ >
  $ G ⇒ ra_pis tp tR2 tR ∈ lrel $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ irc u (dnf u (mcv H)) td (fv nvf ti) (lv tv w) w ∈ dt u (mcv H) tR w rr $;

--| The rule `ind_rec_ty` in the model, for a block without nested occurrences (`rst` is then the
--| identity): the recursor `ind_rec D i v` has the type `rec_ty` gives, under `ind_wf` and `elim_ok`.
theorem ind_rec_ty_wf (G: hyps) (H J: class) (u w r tg td tv ti tR: set):
  $ G ⇒ iwf u H J tg td w r $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ hrec ⊆ H $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_rec_ty td tv ti tR ∈ lrel $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ w r ∈ dt u (mcv H) tR w r $;

-- --------------------------------------------------------------------------
-- Iota (E6): the fold's computation rule
-- --------------------------------------------------------------------------

--| The fold's computation rule: at the tuple of a path of constructor `sc` of type
--| `sj` over the parameters `p`, the fold's value is the constructor's minor at the
--| fields and the inductive hypotheses `sh` taken from the fold itself.
theorem ifold_comp (G: hyps) (H J R: class) (u w p cv mv tc td tb tp tt tn tm te tv tk sj sc sk sh pf pg pt pa: set):
  $ G ⇒ iwf u H J tc td w R $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp te ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tc td tv ∈ lrel3 J $ >
  $ G ⇒ ictk td sj sc tk $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tk w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ ⟨ sj , ⟨ pa , scons sc pg ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w $ >
  $ G ⇒ sh ∊ ihv td tk (ifold u (dnf u (mcv H)) td w p mv) pg pt (cdm pf) $ >
  $ G ⇒ iminx td sj sc sk $ >
  $ G ⇒ apn (vat mv (inmin td) sk) (scat sh pf) ∈ u $ >
  $ G ⇒ fv (ifold u (dnf u (mcv H)) td w p mv) ⟨ sj , ⟨ pa , itup td sj sc pg w ⟩ ⟩ = apn (vat mv (inmin td) sk) (scat sh pf) $;

-- --------------------------------------------------------------------------
-- Iota (E6): instantiation at `Π` and application nodes
-- --------------------------------------------------------------------------

--| A closed application: both parts are closed.
theorem closed_app_inv (G: hyps) (tx ta tb: set): $ G ⇒ ra_closed tx ⟨ kc_app , scons ta (scons tb ∅) ⟩ ∈ lrel $ > $ G ⇒ ra_closed tx ta ∈ lrel ∧ ra_closed tx tb ∈ lrel $;

--| An instance of a `Π` is a `Π` of the parts' instances (the body's a binder deeper).
--| @freshen G x
--| @freshen G y
theorem inst_pi_inv {x y: set} (G: hyps) (tk ta tb tc t4: set): $ G ⇒ ra_inst tk ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tc t4 ∈ lrel $ > $ G ⇒ ∃ x ∃ y (t4 = ⟨ kc_pi , scons x (scons y ∅) ⟩ ∧ ra_inst tk ta tc x ∈ lrel ∧ ra_inst ⟨ kc_s , scons tk ∅ ⟩ tb tc y ∈ lrel) $;

--| An instance of an application is the application of the parts' instances.
--| @freshen G x
--| @freshen G y
theorem inst_app_inv {x y: set} (G: hyps) (tk ta tb tc t4: set): $ G ⇒ ra_inst tk ⟨ kc_app , scons ta (scons tb ∅) ⟩ tc t4 ∈ lrel $ > $ G ⇒ ∃ x ∃ y (t4 = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ ra_inst tk ta tc x ∈ lrel ∧ ra_inst tk tb tc y ∈ lrel) $;

--| `pinst` at a `Π`: a `Π` of the parts' instances along the same spine (the body's a binder deeper).
--| @freshen G x
--| @freshen G z
theorem pinst_pi_inv {x z: set} (G: hyps) (ti ts ta tb tr: set): $ G ⇒ ra_pinst ti ts ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tr ∈ lrel $ > $ G ⇒ ∃ x ∃ z (tr = ⟨ kc_pi , scons x (scons z ∅) ⟩ ∧ ra_pinst ti ts ta x ∈ lrel ∧ ra_pinst ⟨ kc_s , scons ti ∅ ⟩ ts tb z ∈ lrel) $;

--| `pinst` at an application: the application of the parts' instances along the same spine.
--| @freshen G x
--| @freshen G z
theorem pinst_app_inv {x z: set} (G: hyps) (ti ts ta tb tr: set): $ G ⇒ ra_pinst ti ts ⟨ kc_app , scons ta (scons tb ∅) ⟩ tr ∈ lrel $ > $ G ⇒ ∃ x ∃ z (tr = ⟨ kc_app , scons x (scons z ∅) ⟩ ∧ ra_pinst ti ts ta x ∈ lrel ∧ ra_pinst ti ts tb z ∈ lrel) $;

--| An application of expressions is an expression.
theorem ofsort_app_intro (G: hyps) (A B: class): $ G ⇒ A ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ B ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ ⟨ kc_app , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $;

--| `sty` at the head (not an application): no argument, the type unchanged.
theorem sty_head_inv (G: hyps) (J K S: class) (c tA tT: set): $ G ⇒ ra_sty c ⟨ K , S ⟩ tA ⟨ K , S ⟩ tT ∈ lrel3 J $ > $ G ⇒ isset K $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ tT = tA $;

--| `sty` at an application (the head not one): the function's type is a `Π`, the argument has its
--| domain, and the type is the body's instance.
--| @freshen G x
--| @freshen G y
theorem sty_app_inv {x y: set} (G: hyps) (J K S: class) (c tA te ta tT: set): $ G ⇒ ra_sty c ⟨ K , S ⟩ tA ⟨ kc_app , scons te (scons ta ∅) ⟩ tT ∈ lrel3 J $ > $ G ⇒ isset K $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ ∃ x ∃ y (ra_sty c ⟨ K , S ⟩ tA te ⟨ kc_pi , scons x (scons y ∅) ⟩ ∈ lrel3 J ∧ ra_deq c ta ta x ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ y ta tT ∈ lrel) $;

--| A context of length `0` is empty.
theorem clen_z_inv (G: hyps) (tq: set): $ G ⇒ ra_clen tq ⟨ kc_nz , ∅ ⟩ ∈ lrel $ > $ G ⇒ tq = ⟨ kc_nil , ∅ ⟩ $;

--| A context of length `s k`: an entry in front of one of length `k`.
--| @freshen G a
--| @freshen G p
theorem clen_s_inv {a p: set} (G: hyps) (tq tk: set): $ G ⇒ ra_clen tq ⟨ kc_s , scons tk ∅ ⟩ ∈ lrel $ > $ G ⇒ ∃ a ∃ p (tq = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ ra_clen p tk ∈ lrel) $;

--| `pis` over the empty context: the body.
theorem pis_nil_inv (G: hyps) (tb tt: set): $ G ⇒ ra_pis ⟨ kc_nil , ∅ ⟩ tb tt ∈ lrel $ > $ G ⇒ tt = tb $;

--| `pis` over `A :: P`: `pis` over `P` of the `Π` of `A` and the body.
theorem pis_cons_inv (G: hyps) (ta tp tb tt: set): $ G ⇒ ra_pis ⟨ kc_cons , scons ta (scons tp ∅) ⟩ tb tt ∈ lrel $ > $ G ⇒ ra_pis tp ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tt ∈ lrel $;

--| The arguments of an application of a spine: the argument's value in front of the spine's.
theorem sarg_app (G: hyps) (M K S: class) (u w r te ta tk: set): $ G ⇒ ra_spine ⟨ K , S ⟩ te tk ∈ lrel $ > $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ te ∊ trees ω $ > $ G ⇒ ta ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ sarg u (dnf u M) ⟨ kc_app , scons te (scons ta ∅) ⟩ w r = scons (dt u M ta w r) (sarg u (dnf u M) te w r) $;

--| The walk over `sty` (E6): for a head `⟨ K , S ⟩` (not an application or a `Π`) of type `tA`, binders
--| `tq` over `tp`, and a spine `tf` of as many arguments as `tq` has entries, typed by `sty` with
--| every atom of `J` true: the type left, `tt`, is the instance of `tp` along the spine re-headed
--| to a type of a block (`pinst`), and the spine's arguments at a valuation `r` of the context are
--| a valuation of `tq` over `r`.
--| @freshen G g
theorem sty_pinst {g: set} (G: hyps) (J M K S: class) (u w c r tA d0 i0: set) (tf tn tq tp tt: set):
  $ G ⇒ jval u M J $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ sat u M c w $ >
  $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ >
  $ G ⇒ ¬ K = kc_pi $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ isset K $ >
  $ G ⇒ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_sty c ⟨ K , S ⟩ tA tf tt ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ K , S ⟩ tf tn ∈ lrel $ >
  $ G ⇒ ra_pis tq tp tA ∈ lrel $ >
  $ G ⇒ ra_clen tq tn ∈ lrel $ >
  $ G ⇒ tf ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ∃ g (ra_rehead ⟨ K , S ⟩ ⟨ kc_ind_ty , scons d0 (scons i0 ∅) ⟩ tn tf g ∈ lrel ∧ g ∊ ofsort lsig lopen ks_expr ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ g tp tt ∈ lrel ∧ sarg u (dnf u M) g w r = sarg u (dnf u M) tf w r ∧ sarg u (dnf u M) tf w r ∈ esat u (dsh u M r) tq w) $;

--| An instance of a type of a block is that type.
theorem inst_ind_ty_inv (G: hyps) (tk ta tb tc t4: set): $ G ⇒ ra_inst tk ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ tc t4 ∈ lrel $ > $ G ⇒ t4 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $;

--| `pinst` at a type of a block: that type.
theorem pinst_ind_ty_inv (G: hyps) (ti ts ta tb tr: set): $ G ⇒ ra_pinst ti ts ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ tr ∈ lrel $ > $ G ⇒ tr = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $;

--| `pinst` at a type of the block applied to arguments (a spine `te`): a spine of as many arguments, and
--| its arguments at `q ++ s` are `te`'s at `q ++ a ++ s`, for `a` the arguments of `ts` at `s`.
theorem pinst_sarg (G: hyps) (M: class) (u w ti ts td tj q s: set) (te tr tn: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ ts ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ q ∊ fseq u $ >
  $ G ⇒ cdm q = fv nvf ti $ >
  $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ sarg u (dnf u M) ts w s ∈ fseq u $ >
  $ G ⇒ ra_pinst ti ts te tr ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ te tn ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ tr tn ∈ lrel ∧ sarg u (dnf u M) tr w (scat q s) = sarg u (dnf u M) te w (scat q (scat (sarg u (dnf u M) ts w s) s)) $;

--| `aeq` from a type of the block applied to arguments (a spine `te`), with every atom of `J` true:
--| the other side is a spine of as many arguments, with the same values at a valuation of the context.
theorem aeq_sarg (G: hyps) (J M: class) (u w c r td tj: set) (te tt tn: set):
  $ G ⇒ jval u M J $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ sat u M c w $ >
  $ G ⇒ ra_aeq c te tt ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ te tn ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ tt tn ∈ lrel ∧ sarg u (dnf u M) te w r = sarg u (dnf u M) tt w r $;

-- --------------------------------------------------------------------------
-- Iota (E6): the lengths of the recursor's telescopes
-- --------------------------------------------------------------------------

--| `add a b c` gives `add (s a) b (s c)`.
theorem add_suc_l (G: hyps) (ta tb tc: set): $ G ⇒ ra_add ta tb tc ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_s , scons ta ∅ ⟩ tb ⟨ kc_s , scons tc ∅ ⟩ ∈ lrel $;

--| `add` commutes, for a first summand that is a numeral (`add 0 a a`).
theorem add_comm (G: hyps) (ta tb tc: set): $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ ta ta ∈ lrel $ > $ G ⇒ ra_add ta tb tc ∈ lrel $ > $ G ⇒ ra_add tb ta tc ∈ lrel $;

--| A context's length is a numeral: `add 0 n n`.
theorem clen_num (G: hyps) (tq tn: set): $ G ⇒ ra_clen tq tn ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ tn tn ∈ lrel $;

--| One entry behind a context: one more.
theorem clen_capp1 (G: hyps) (tp ta tr tn: set): $ G ⇒ ra_capp tp ⟨ kc_cons , scons ta (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ tr ∈ lrel $ > $ G ⇒ ra_clen tp tn ∈ lrel $ > $ G ⇒ ra_clen tr ⟨ kc_s , scons tn ∅ ⟩ ∈ lrel $;

--| Contexts append (`capp P G R`, `P` in front), and the lengths add.
--| @freshen G r
--| @freshen G c
theorem capp_clen_ex {r c: set} (G: hyps) (tp tg ta tb: set): $ G ⇒ ra_clen tp ta ∈ lrel $ > $ G ⇒ ra_clen tg tb ∈ lrel $ > $ G ⇒ ∃ r ∃ c (ra_capp tp tg r ∈ lrel ∧ ra_clen r c ∈ lrel ∧ ra_add tb ta c ∈ lrel) $;

--| `pis` over an appended context: over the front part, then over the rest.
theorem pis_capp (G: hyps) (tp tg tr tb tm tt: set): $ G ⇒ ra_capp tp tg tr ∈ lrel $ > $ G ⇒ ra_pis tp tb tm ∈ lrel $ > $ G ⇒ ra_pis tg tm tt ∈ lrel $ > $ G ⇒ ra_pis tr tb tt ∈ lrel $;

--| The motives' telescope has one entry for each type.
theorem motives_clen (G: hyps) (t1 t2 t3 tj tT tq tn tm: set): $ G ⇒ ra_motives t1 t2 t3 tj tT tq ∈ lrel $ > $ G ⇒ ra_ntys tT tn tm ∈ lrel $ > $ G ⇒ ra_clen tq tn ∈ lrel $;

--| The minors of one type's constructors: one entry for each constructor.
theorem cminors_clen (G: hyps) (t1 t2 t3 t5 tk tc tC tq tn: set): $ G ⇒ ra_cminors t1 t2 t3 tk t5 tc tC tq ∈ lrel $ > $ G ⇒ ra_clen_c tC tn ∈ lrel $ > $ G ⇒ ra_clen tq tn ∈ lrel $;

--| The minors' telescope has one entry for each constructor of the block.
theorem minors_clen (G: hyps) (t1 t2 t3 tk ti tT tq tn tm: set): $ G ⇒ ra_minors t1 t2 t3 tk ti tT tq ∈ lrel $ > $ G ⇒ ra_ntys tT tn tm ∈ lrel $ > $ G ⇒ ra_clen tq tm ∈ lrel $;

--| A lifted type of binders over a sort is one, with as many binders.
theorem lift_isort (G: hyps) (tk td tF tG tn tl: set): $ G ⇒ ra_lift tk td tF tG ∈ lrel $ > $ G ⇒ ra_isort tF tn tl ∈ lrel $ > $ G ⇒ ra_isort tG tn tl ∈ lrel $;

--| The recursor's tail as a context: `rtail` over a type with `tn` binders over a sort gives `pis` of a
--| context of `tn` entries over a body that `rtail` gives at that sort and depth (`Π I. X2 @ #0`).
--| @freshen G x
--| @freshen G b
theorem rtail_pis {x b: set} (G: hyps) (t1 t2 t3 t4 t5 tF tB tn tl: set): $ G ⇒ ra_rtail t1 t2 t3 t4 t5 ⟨ kc_nz , ∅ ⟩ tF tB ∈ lrel $ > $ G ⇒ ra_isort tF tn tl ∈ lrel $ > $ G ⇒ ∃ x ∃ b (ra_pis x b tB ∈ lrel ∧ ra_clen x tn ∈ lrel ∧ ra_rtail t1 t2 t3 t4 t5 tn ⟨ kc_srt , scons tl ∅ ⟩ b ∈ lrel) $;

--| `pargs X d n e`: `e` is `X` applied to `n` arguments.
theorem pargs_spine (G: hyps) (tX td tn te: set): $ G ⇒ ra_pargs tX td tn te ∈ lrel $ > $ G ⇒ ra_spine tX te tn ∈ lrel $;

--| A spine over a spine is a spine over its head.
--| @freshen G c
theorem spine_trans {c: set} (G: hyps) (th tx ta te tb: set): $ G ⇒ ra_spine th tx ta ∈ lrel $ > $ G ⇒ ra_spine tx te tb ∈ lrel $ > $ G ⇒ ∃ c (ra_spine th te c ∈ lrel) $;

-- --------------------------------------------------------------------------
-- Iota (E6): `sinst` through a constructor's type
-- --------------------------------------------------------------------------

--| No numeral is below itself: `s a ≤ a` is not derivable.
theorem le_suc_self (G: hyps) (a: set): $ G ⇒ ra_le ⟨ kc_s , scons a ∅ ⟩ a ∈ lrel $ > $ G ⇒ ⊥ $;

--| A lifted type of a block is that type.
theorem lift_ind_ty_inv (G: hyps) (tk td ta tb t4: set): $ G ⇒ ra_lift tk td ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ t4 ∈ lrel $ > $ G ⇒ t4 = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $;

--| A closed variable is below the bound.
theorem closed_bvar_inv (G: hyps) (tx ti: set): $ G ⇒ ra_closed tx ⟨ kc_bvar , scons ti ∅ ⟩ ∈ lrel $ > $ G ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tx ∈ lrel $;

--| `sinst` at a `Π` (the types `j` to `n`, `add j d n`): a `Π` of the parts' `sinst`, the body's a binder deeper.
--| @freshen G x
--| @freshen G c
theorem sinst_pi_inv {x c: set} (G: hyps) (td tn tj tk ta tb tz tdd: set): $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk ⟨ kc_pi , scons ta (scons tb ∅) ⟩ tz ∈ lrel $ > $ G ⇒ ∃ x ∃ c (tz = ⟨ kc_pi , scons x (scons c ∅) ⟩ ∧ ra_sinst td tj tn tk ta x ∈ lrel ∧ ra_sinst td tj tn ⟨ kc_s , scons tk ∅ ⟩ tb c ∈ lrel) $;

--| `sinst` at an application: the application of the parts' `sinst`.
--| @freshen G x
--| @freshen G c
theorem sinst_app_inv {x c: set} (G: hyps) (td tn tj tk ta tb tz tdd: set): $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk ⟨ kc_app , scons ta (scons tb ∅) ⟩ tz ∈ lrel $ > $ G ⇒ ∃ x ∃ c (tz = ⟨ kc_app , scons x (scons c ∅) ⟩ ∧ ra_sinst td tj tn tk ta x ∈ lrel ∧ ra_sinst td tj tn tk tb c ∈ lrel) $;

--| `sinst` at a type of a block: that type.
theorem sinst_ind_ty_inv (G: hyps) (td tn ta tb tj tk tz tdd: set): $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ tz ∈ lrel $ > $ G ⇒ tz = ⟨ kc_ind_ty , scons ta (scons tb ∅) ⟩ $;

--| `sinst` (the types `j` to `n`) at the variable of type `i` (`#m`, `m = k + x`, `i = j + x`, `i < n`): `ind_ty D i`.
theorem sinst_bvar (G: hyps) (td tn ti tj tk tm tx tz tdd: set): $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk ⟨ kc_bvar , scons tm ∅ ⟩ tz ∈ lrel $ > $ G ⇒ ra_add tk tx tm ∈ lrel $ > $ G ⇒ ra_add tj tx ti ∈ lrel $ > $ G ⇒ ra_le ⟨ kc_s , scons ti ∅ ⟩ tn ∈ lrel $ > $ G ⇒ tz = ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ $;

--| `sinst` along a spine: a spine of as many arguments over the head's `sinst`.
--| @freshen G x
theorem sinst_spine {x: set} (G: hyps) (td tj tn tk th tdd te tm tz: set): $ G ⇒ ra_add tj tdd tn ∈ lrel $ > $ G ⇒ ra_spine th te tm ∈ lrel $ > $ G ⇒ ra_sinst td tj tn tk te tz ∈ lrel $ > $ G ⇒ ∃ x (ra_spine x tz tm ∈ lrel ∧ ra_sinst td tj tn tk th x ∈ lrel) $;

--| The second summand of `add` is a numeral.
theorem add_num_r (G: hyps) (ta tb tc: set): $ G ⇒ ra_add ta tb tc ∈ lrel $ > $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ tb tb ∈ lrel $;

--| A constructor's type `tK` with `tf` binders, well formed (`cwf` at depth `0`, `tz` the numeral `0`), after `sinst`
--| (`tZ`): `pis` of a context of `tf` entries over the `sinst` of its result `e`, an application of the type
--| (`indapp` at depth `tf`).
--| @freshen G x
--| @freshen G b
--| @freshen G e
--| @freshen G h
theorem ctor_pis {x b e h: set} (G: hyps) (J: class) (td tn tnp tl ti tc tK tf tZ tz: set):
  $ G ⇒ ra_add tz tn tn ∈ lrel $ >
  $ G ⇒ ra_add tz tnp tnp ∈ lrel $ >
  $ G ⇒ ra_npis tK tf ∈ lrel $ >
  $ G ⇒ ra_sinst td tz tn tnp tK tZ ∈ lrel $ >
  $ G ⇒ ra_cwf td tn tnp tl ti tc tz tK ∈ lrel3 J $ >
  $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ >
  $ G ⇒ ∃ x ∃ b ∃ e ∃ h (ra_pis x b tZ ∈ lrel ∧ ra_clen x tf ∈ lrel ∧ ra_sinst td tz tn h e b ∈ lrel ∧ ra_indapp td tn tnp tf e ti ∈ lrel ∧ ra_add tf tnp h ∈ lrel) $;

--| The `sinst` (at depth `th = tg + tnp`) of an application of type `ti` of the block (`indapp`) is a spine of `ind_ty D i`.
--| @freshen G m
theorem ctor_res {m: set} (G: hyps) (td tn tnp ti tg te th tb tz: set):
  $ G ⇒ ra_indapp td tn tnp tg te ti ∈ lrel $ >
  $ G ⇒ ra_add tg tnp th ∈ lrel $ >
  $ G ⇒ ra_sinst td tz tn th te tb ∈ lrel $ >
  $ G ⇒ ra_add tz tn tn ∈ lrel $ >
  $ G ⇒ tz = ⟨ kc_nz , ∅ ⟩ $ >
  $ G ⇒ ∃ m (ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tb m ∈ lrel) $;

-- --------------------------------------------------------------------------
-- Iota (E6): from valuations to paths; the typing along `sty`
-- --------------------------------------------------------------------------

--| From a valuation to a path (the converse of `lrel_pis_etel`): for `pis tq tb tt`, a valuation `p` of `tq` over `s`
--| and a path of the body at `p ++ s` with the fields `x` give a path of `tt` at `s` with the fields `x ++ p`
--| and the same arguments.
--| @freshen G h
--| @freshen G l
theorem pis_etel_intro {h l: set} (G: hyps) (M: class) (u w s tt a tq tb p x g1 t1: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ ra_pis tq tb tt ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dsh u M s) tq w $ >
  $ G ⇒ ⟨ x , ⟨ g1 , ⟨ t1 , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scat p s) $ >
  $ G ⇒ ∃ h ∃ l (⟨ scat x p , ⟨ h , ⟨ l , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tt w s) $;

--| The typing along `sty`: when the head's value is an element of its type's, and every atom of `J` is true, the
--| spine's value is an element of the value of the type left, at a valuation of the context.
theorem sty_ty_sem (G: hyps) (J M K S: class) (u w c r tA: set) (tf tT: set):
  $ G ⇒ jval u M J $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ sat u M c w $ >
  $ G ⇒ isset K $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ dt u M ⟨ K , S ⟩ w r ∈ dt u M tA w r $ >
  $ G ⇒ ra_sty c ⟨ K , S ⟩ tA tf tT ∈ lrel3 J $ >
  $ G ⇒ tf ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ dt u M tf w r ∈ dt u M tT w r $;

-- --------------------------------------------------------------------------
-- Iota (E6): the assembly
-- --------------------------------------------------------------------------

--| Two spines of a type of the block with the same arguments at `r` have the same value there.
theorem spine_val_eq (G: hyps) (M: class) (u w r td tj te tt tn tm: set): $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ te tn ∈ lrel $ > $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ tt tm ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ sarg u (dnf u M) te w r = sarg u (dnf u M) tt w r $ > $ G ⇒ dt u M te w r = dt u M tt w r $;

--| The typing half of the iota rule: the recursor's spine `te` typed by `sty` up to the major premise's binder `Π TY. C`,
--| the major premise `tm` typed by `sty` along its head's type with the type `T2` left, both spines of the block's
--| type with the same arguments at `r`: the application's value is an element of the value of `C`'s instance.
theorem iota_ty_sem (G: hyps) (J M K S K2 S2: class) (u w c r td tj tRT tCT te tm tTY tC tT2 tT tn tk: set):
  $ G ⇒ jval u M J $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ sat u M c w $ >
  $ G ⇒ isset K $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ dt u M ⟨ K , S ⟩ w r ∈ dt u M tRT w r $ >
  $ G ⇒ isset K2 $ >
  $ G ⇒ ¬ K2 = kc_app $ >
  $ G ⇒ dt u M ⟨ K2 , S2 ⟩ w r ∈ dt u M tCT w r $ >
  $ G ⇒ ra_sty c ⟨ K , S ⟩ tRT te ⟨ kc_pi , scons tTY (scons tC ∅) ⟩ ∈ lrel3 J $ >
  $ G ⇒ te ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_sty c ⟨ K2 , S2 ⟩ tCT tm tT2 ∈ lrel3 J $ >
  $ G ⇒ tm ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ tC tm tT ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ tT2 tn ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ tTY tk ∈ lrel $ >
  $ G ⇒ sarg u (dnf u M) tT2 w r = sarg u (dnf u M) tTY w r $ >
  $ G ⇒ dt u M ⟨ kc_app , scons te (scons tm ∅) ⟩ w r ∈ dt u M tT w r $;

--| `imots_sem` for a well-formed block: the hook's facts at the block's types from `ind_wf`.
theorem imots_wf (G: hyps) (H J: class) (u w r0 tg td tb tp tt tnp tv tn tm p rr tM r: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ r = scat p rr $ >
  $ G ⇒ esat u (dsh u (mcv H) r) tM w = imots u (dnf u (mcv H)) td w p (lv tv w) $;

--| `imins_sem` for a well-formed block: the hook's facts at the block's types and constructors from `ind_wf`
--| (as in `rec_ty_wf`).
theorem imins_wf (G: hyps) (H J V: class) (u w r0 tg td tb tp tt tnp tn tm pp cv rr tN r: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ pp ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w pp V $ >
  $ G ⇒ rr ∊ fseq u $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ r = scat cv (scat pp rr) $ >
  $ G ⇒ esat u (dsh u (mcv H) r) tN w = imins u (dnf u (mcv H)) td w pp cv $;

--| `add` is associative: `a + b = c`, `b + d = e` and `c + d = f` give `a + e = f`.
theorem add_assoc (G: hyps) (ta tb tc td te tf: set): $ G ⇒ ra_add ta tb tc ∈ lrel $ > $ G ⇒ ra_add tb td te ∈ lrel $ > $ G ⇒ ra_add tc td tf ∈ lrel $ > $ G ⇒ ra_add ta te tf ∈ lrel $;

--| The parts of the recursor's type, at the block's own data: the motives' and the minors' contexts and the
--| tail over the type's lifted type.
theorem rec_ty_at {c d f j q g e h i: set} (G: hyps) (td tv ti tR tb tp tt tnp tn tm: set):
  $ G ⇒ ra_rec_ty td tv ti tR ∈ lrel $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ∃ c ∃ d ∃ f ∃ j ∃ q ∃ g ∃ e ∃ h ∃ i (ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt c ∈ lrel ∧ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt d ∈ lrel ∧ ra_nth_ty tt ti f j ∈ lrel ∧ ra_add tm tn q ∈ lrel ∧ ra_lift q ⟨ kc_nz , ∅ ⟩ f g ∈ lrel ∧ ra_rtail td tnp tn tm ti ⟨ kc_nz , ∅ ⟩ g e ∈ lrel ∧ ra_pis d e h ∈ lrel ∧ ra_pis c h i ∈ lrel ∧ ra_pis tp i tR ∈ lrel) $;

--| The recursor's type as one context over the tail at the sort: the indices' context `x`, then the minors,
--| the motives and the parameters appended (`y`, `z`, `o`), the whole of the length `tk` the rule computes.
theorem rec_ctx {x y z o b c d l: set} (G: hyps) (td tv ti tR tb tp tt tnp tn tm tM tN tF tC tmn tF2 tB tR1 tR2 tni ta0 ta tk: set):
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tC ∈ lrel $ >
  $ G ⇒ ra_add tm tn tmn ∈ lrel $ >
  $ G ⇒ ra_lift tmn ⟨ kc_nz , ∅ ⟩ tF tF2 ∈ lrel $ >
  $ G ⇒ ra_rtail td tnp tn tm ti ⟨ kc_nz , ∅ ⟩ tF2 tB ∈ lrel $ >
  $ G ⇒ ra_pis tN tB tR1 ∈ lrel $ >
  $ G ⇒ ra_pis tM tR1 tR2 ∈ lrel $ >
  $ G ⇒ ra_pis tp tR2 tR ∈ lrel $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nidx td ti tni ∈ lrel $ >
  $ G ⇒ ra_add tnp tn ta0 ∈ lrel $ >
  $ G ⇒ ra_add ta0 tm ta ∈ lrel $ >
  $ G ⇒ ra_add ta tni tk ∈ lrel $ >
  $ G ⇒ ∃ x ∃ y ∃ z ∃ o ∃ b ∃ c ∃ d ∃ l (ra_clen x tni ∈ lrel ∧ ra_capp x tN y ∈ lrel ∧ ra_capp y tM z ∈ lrel ∧ ra_capp z tp o ∈ lrel ∧ ra_clen z d ∈ lrel ∧ ra_add tn c d ∈ lrel ∧ ra_add tm tni c ∈ lrel ∧ ra_clen o tk ∈ lrel ∧ ra_pis o b tR ∈ lrel ∧ ra_rtail td tnp tn tm ti tni ⟨ kc_srt , scons l ∅ ⟩ b ∈ lrel) $;

--| `rtail` at the sort: the tail is `Π I. X2 @ #0` with `I` the block's type at the parameters' and the
--| indices' windows.
theorem rtail_srt_inv {x y z q d c: set} (G: hyps) (td tnp tn tm ti tni tl tb: set):
  $ G ⇒ ra_rtail td tnp tn tm ti tni ⟨ kc_srt , scons tl ∅ ⟩ tb ∈ lrel $ >
  $ G ⇒ ∃ x ∃ y ∃ z ∃ q ∃ d ∃ c (tb = ⟨ kc_pi , scons x (scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add tm tn q ∈ lrel ∧ ra_add tni q d ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ d tnp y ∈ lrel ∧ ra_pargs y ⟨ kc_nz , ∅ ⟩ tni x ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ x c ∈ lrel) $;

--| The arguments of the block's type at the parameters' window (depth `tdm`) and the indices' window (depth `0`),
--| at a valuation `x` that starts with the indices `f` and has the parameters `p` after `q`: the indices, then the parameters.
theorem pargs_sarg (G: hyps) (M: class) (u w td ti tdm tnp tni tY tI f q p s y x: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tdm tnp tY ∈ lrel $ >
  $ G ⇒ ra_pargs tY ⟨ kc_nz , ∅ ⟩ tni tI ∈ lrel $ >
  $ G ⇒ f ∊ fseq u $ >
  $ G ⇒ q ∊ fseq u $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ s ∊ fseq u $ >
  $ G ⇒ y ∊ fseq u $ >
  $ G ⇒ x = scat f y $ >
  $ G ⇒ x = scat q (scat p s) $ >
  $ G ⇒ cdm f = fv nvf tni $ >
  $ G ⇒ cdm q = fv nvf tdm $ >
  $ G ⇒ cdm p = fv nvf tnp $ >
  $ G ⇒ sarg u (dnf u M) tI w x = scat f p $;

--| The recursor's side of the iota rule, the semantic part: the spine's arguments, a valuation of the recursor's
--| context (`tQ3`: the indices' context `tX` appended to the minors, the motives and the parameters), are the
--| indices `f`, the minors `m`, the motives `c` and the parameters `p`, each in its space; the major premise's
--| type `tTY`, the block's type at `tI`'s windows of these arguments, has the arguments `f ++ p`.
theorem iota_rec_sem {f m c p k: set} (G: hyps) (H J: class) (u w r r0 tg td tv ti te tTY tb tp tt tnp tn tm tM tN tF tC tX tQ1 tQ2 tQ3 tc1 tc2 tni tmn tdm tY tI tc: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_nth_ty tt ti tF tC ∈ lrel $ >
  $ G ⇒ ra_clen tX tni ∈ lrel $ >
  $ G ⇒ ra_capp tX tN tQ1 ∈ lrel $ >
  $ G ⇒ ra_capp tQ1 tM tQ2 ∈ lrel $ >
  $ G ⇒ ra_capp tQ2 tp tQ3 ∈ lrel $ >
  $ G ⇒ ra_clen tQ2 tc2 ∈ lrel $ >
  $ G ⇒ ra_add tn tc1 tc2 ∈ lrel $ >
  $ G ⇒ ra_add tm tni tc1 ∈ lrel $ >
  $ G ⇒ ra_add tm tn tmn ∈ lrel $ >
  $ G ⇒ ra_add tni tmn tdm ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tdm tnp tY ∈ lrel $ >
  $ G ⇒ ra_pargs tY ⟨ kc_nz , ∅ ⟩ tni tI ∈ lrel $ >
  $ G ⇒ sarg u (dnf u (mcv H)) te w r ∈ esat u (dsh u (mcv H) r) tQ3 w $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tTY w r = sarg u (dnf u (mcv H)) tI w (scat (sarg u (dnf u (mcv H)) te w r) r) $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tTY tc ∈ lrel $ >
  $ G ⇒ ∃ f ∃ m ∃ c ∃ p ∃ k (sarg u (dnf u (mcv H)) te w r = scat f (scat m (scat c p)) ∧ f ∊ fseq u ∧ cdm f = fv nvf tni ∧ p ∊ esat u (dnf u (mcv H)) tp w ∧ c ∊ imots u (dnf u (mcv H)) td w p (lv tv w) ∧ m ∊ imins u (dnf u (mcv H)) td w p c ∧ sarg u (dnf u (mcv H)) tTY w r = scat f p ∧ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tTY k ∈ lrel) $;

--| A type of a block is an expression.
theorem ofsort_ind_ty_intro (G: hyps) (A B: class): $ G ⇒ A ∈ ofsort lsig lopen ks_ind $ > $ G ⇒ B ∈ ofsort lsig lopen ks_nat $ > $ G ⇒ ⟨ kc_ind_ty , scons A (scons B ∅) ⟩ ∈ ofsort lsig lopen ks_expr $;

--| The recursor's side of the iota rule from the recursor's type as one context (`rec_ctx`): the walk over `sty`
--| (`sty_pinst`) makes the spine's arguments a valuation of the context and the type left the `pinst` of the tail,
--| whose domain is the block's type at windows of the arguments (`rtail_srt_inv`, `pinst_sarg`).
theorem iota_rec_walk {f m c p k: set} (G: hyps) (H J: class) (u w r r0 tg td tv ti te tTY tU tR tb tp tt tnp tn tm tM tN tF tC tX tQ1 tQ2 tQ3 tc1 tc2 tni tB tl tk: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ r ∊ sat u (mcv H) tg w $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_nth_ty tt ti tF tC ∈ lrel $ >
  $ G ⇒ ra_clen tX tni ∈ lrel $ >
  $ G ⇒ ra_capp tX tN tQ1 ∈ lrel $ >
  $ G ⇒ ra_capp tQ1 tM tQ2 ∈ lrel $ >
  $ G ⇒ ra_capp tQ2 tp tQ3 ∈ lrel $ >
  $ G ⇒ ra_clen tQ2 tc2 ∈ lrel $ >
  $ G ⇒ ra_add tn tc1 tc2 ∈ lrel $ >
  $ G ⇒ ra_add tm tni tc1 ∈ lrel $ >
  $ G ⇒ ra_clen tQ3 tk ∈ lrel $ >
  $ G ⇒ ra_pis tQ3 tB tR ∈ lrel $ >
  $ G ⇒ ra_rtail td tnp tn tm ti tni ⟨ kc_srt , scons tl ∅ ⟩ tB ∈ lrel $ >
  $ G ⇒ ra_sty tg ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR te ⟨ kc_pi , scons tTY (scons tU ∅) ⟩ ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ te tk ∈ lrel $ >
  $ G ⇒ te ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ ∃ f ∃ m ∃ c ∃ p ∃ k (sarg u (dnf u (mcv H)) te w r = scat f (scat m (scat c p)) ∧ f ∊ fseq u ∧ cdm f = fv nvf tni ∧ p ∊ esat u (dnf u (mcv H)) tp w ∧ c ∊ imots u (dnf u (mcv H)) td w p (lv tv w) ∧ m ∊ imins u (dnf u (mcv H)) td w p c ∧ sarg u (dnf u (mcv H)) tTY w r = scat f p ∧ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tTY k ∈ lrel) $;

--| The recursor's side of the iota rule: for a recursor's spine `te` of the rule's length `tk`, typed by `sty`
--| along the recursor's type with `Π TY. U` left, the arguments at `r` are the indices `f`, the minors `m`, the
--| motives `c` and the parameters `p`, each in its space, and `TY` is a spine of the block's type with the
--| arguments `f ++ p`.
theorem iota_rec_args {f m c p k: set} (G: hyps) (H J: class) (u w r r0 tg td tv ti te tTY tU tR tb tp tt tnp tn tm tni ta0 ta tk: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ r ∊ sat u (mcv H) tg w $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_rec_ty td tv ti tR ∈ lrel $ >
  $ G ⇒ ra_nidx td ti tni ∈ lrel $ >
  $ G ⇒ ra_add tnp tn ta0 ∈ lrel $ >
  $ G ⇒ ra_add ta0 tm ta ∈ lrel $ >
  $ G ⇒ ra_add ta tni tk ∈ lrel $ >
  $ G ⇒ ra_sty tg ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR te ⟨ kc_pi , scons tTY (scons tU ∅) ⟩ ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ te tk ∈ lrel $ >
  $ G ⇒ te ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ∃ f ∃ m ∃ c ∃ p ∃ k (sarg u (dnf u (mcv H)) te w r = scat f (scat m (scat c p)) ∧ f ∊ fseq u ∧ cdm f = fv nvf tni ∧ p ∊ esat u (dnf u (mcv H)) tp w ∧ c ∊ imots u (dnf u (mcv H)) td w p (lv tv w) ∧ m ∊ imins u (dnf u (mcv H)) td w p c ∧ sarg u (dnf u (mcv H)) tTY w r = scat f p ∧ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tTY k ∈ lrel) $;

-- --------------------------------------------------------------------------
-- Iota (E6): the constructor's side
-- --------------------------------------------------------------------------

--| The constructor's side of the iota rule, the semantic part: the arguments of the major premise `tmj`, a
--| valuation of the constructor's context (`tQ`: the fields' context `tX` appended to the parameters), are the
--| parameters `q` and a path `f` of the constructor's type `tK` at the parameters and the block's types, and the
--| type left, a spine of the block's type, has the path's arguments.
theorem iota_ctor_sem {f g t a q n: set} (G: hyps) (H J: class) (u w r r0 tg td ti tc tb tp tt tnp tn tm tF tE tK tK2 tX tB tQ tl tmj tT2 tnf: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK ∈ lrel $ >
  $ G ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tnp tK tK2 ∈ lrel $ >
  $ G ⇒ ra_pis tX tB tK2 ∈ lrel $ >
  $ G ⇒ ra_capp tX tp tQ ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tB tl ∈ lrel $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tmj w r ∈ esat u (dsh u (mcv H) r) tQ w $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tT2 w r = sarg u (dnf u (mcv H)) tB w (scat (sarg u (dnf u (mcv H)) tmj w r) r) $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tT2 tl ∈ lrel $ >
  $ G ⇒ ra_clen tX tnf ∈ lrel $ >
  $ G ⇒ ∃ f ∃ g ∃ t ∃ a ∃ q ∃ n (sarg u (dnf u (mcv H)) tmj w r = scat f q ∧ q ∊ esat u (dnf u (mcv H)) tp w ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK w (scat q (ixs td w (ifam u (dnf u (mcv H)) td w))) ∧ sarg u (dnf u (mcv H)) tT2 w r = a ∧ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tT2 n ∈ lrel ∧ cdm f = fv nvf tnf) $;

--| The constructor's side of the iota rule: for a spine `tmj` of the rule's length `tnq` with a head `⟨ K , S ⟩`,
--| typed by `sty` along the constructor's type (`Π P.` the `sinst` of `tK`) with `tT2` left: the arguments at `r`
--| are the parameters `q` and a path `f` of `tK` at the parameters and the block's types, and `tT2` is a spine of
--| the block's type with the path's arguments (`ctor_pis`, `ctor_res`, `sty_pinst`, `iota_ctor_sem`).
theorem iota_ctor_args {f g t a q n: set} (G: hyps) (H J K S: class) (u w r r0 tg td ti tc tb tp tt tnp tn tm tF tE tK tK2 tCT tnf tnq tmj tT2: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ r ∊ sat u (mcv H) tg w $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK ∈ lrel $ >
  $ G ⇒ ra_sinst td ⟨ kc_nz , ∅ ⟩ tn tnp tK tK2 ∈ lrel $ >
  $ G ⇒ ra_pis tp tK2 tCT ∈ lrel $ >
  $ G ⇒ ra_npis tK tnf ∈ lrel $ >
  $ G ⇒ ra_add tnp tnf tnq ∈ lrel $ >
  $ G ⇒ ra_add ⟨ kc_nz , ∅ ⟩ tn tn ∈ lrel $ >
  $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ >
  $ G ⇒ isset K $ >
  $ G ⇒ ¬ K = kc_pi $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ ra_sty tg ⟨ K , S ⟩ tCT tmj tT2 ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ K , S ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ti ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ ∃ f ∃ g ∃ t ∃ a ∃ q ∃ n (sarg u (dnf u (mcv H)) tmj w r = scat f q ∧ q ∊ esat u (dnf u (mcv H)) tp w ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK w (scat q (ixs td w (ifam u (dnf u (mcv H)) td w))) ∧ sarg u (dnf u (mcv H)) tT2 w r = a ∧ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tT2 n ∈ lrel ∧ cdm f = fv nvf tnf) $;

--| A constructor's value at the parameters and a path's fields is the constructor's point (`itup`: empty for a
--| proposition).
theorem ictor_apn_itup (G: hyps) (E D P T K J C Q: class) (u w f g t a: set):
  $ G ⇒ D ∈ trees ω $ >
  $ G ⇒ iprt D P T $ >
  $ G ⇒ Q ∈ esat u E P w $ >
  $ G ⇒ ictk D J C K $ >
  $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E K w (scat Q (ixs D w (ifam u E D w))) $ >
  $ G ⇒ apn (ictor u E D J C w) (scat f Q) = itup D J C g w $;

--| A minor's value at inductive hypotheses and fields is in the universe.
theorem ihv_val_u {b: set} (G: hyps) (D K L g t: class) (u mv sk pf sh: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ mv ∊ fseq u $ >
  $ G ⇒ sk ∈ inmin D $ >
  $ G ⇒ inmin D ∈ ω $ >
  $ G ⇒ isset t $ >
  $ G ⇒ ∀ b (isset (ap L b)) $ >
  $ G ⇒ pf ∊ fseq u $ >
  $ G ⇒ sh ∊ ihv D K L g t (cdm pf) $ >
  $ G ⇒ apn (vat mv (inmin D) sk) (scat sh pf) ∈ u $;

--| The value of the iota rule's left-hand side: the recursor's spine `te` with the arguments `sf` (indices), `mv`,
--| `cv`, `p`, applied to a constructor's spine `tmj` with the arguments `pf` (a path of the constructor's type
--| with the arguments `pa = sf ++ p`) and `p`: the minor `sk` at the inductive hypotheses `sh` and the fields
--| (`irc_apn`, `ifold_comp`).
theorem iota_lhs_val (G: hyps) (H J K S: class) (u w r r0 tg td tv ti tc tb tp tt tnp tn tm tF tE tK tni tl te tk tmj tnq sf mv cv p pf pg pt pa sh sk sj sc: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK ∈ lrel $ >
  $ G ⇒ ra_isort tF tni tl ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ te tk ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ K , S ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ >
  $ G ⇒ ¬ K = kc_pi $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ w r = irc u (dnf u (mcv H)) td (fv nvf ti) (lv tv w) w $ >
  $ G ⇒ dt u (mcv H) ⟨ K , S ⟩ w r = ictor u (dnf u (mcv H)) td (fv nvf ti) (fv nvf tc) w $ >
  $ G ⇒ te ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ sarg u (dnf u (mcv H)) te w r = scat sf (scat mv (scat cv p)) $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tmj w r = scat pf p $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ pa = scat sf p $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ cdm sf = fv nvf tni $ >
  $ G ⇒ sh ∊ ihv td tK (ifold u (dnf u (mcv H)) td w p mv) pg pt (cdm pf) $ >
  $ G ⇒ iminx td sj sc sk $ >
  $ G ⇒ sj = fv nvf ti $ >
  $ G ⇒ sc = fv nvf tc $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_app , scons te (scons tmj ∅) ⟩ w r = apn (vat mv (inmin td) sk) (scat sh pf) $;

-- --------------------------------------------------------------------------
-- Iota (E6): joining the two sides; the right-hand side
-- --------------------------------------------------------------------------

--| Joining the two sides of the iota rule: `aeq` of the two types makes the path's arguments the recursor's
--| indices followed by its parameters, and the path's arguments end in the constructor's parameters (`cwf_args`):
--| the two sides have the same parameters.
theorem iota_join (G: hyps) (H J: class) (u w r r0 tg td ti tc tb tp tt tnp tn tm tF tE tK tni tT2 tTY tl sf p q pf pg pt pa: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ r ∊ sat u (mcv H) tg w $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK ∈ lrel $ >
  $ G ⇒ ra_nidx td ti tni ∈ lrel $ >
  $ G ⇒ ra_aeq tg tT2 tTY ∈ lrel3 J $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons ti ∅) ⟩ tT2 tl ∈ lrel $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tTY w r = scat sf p $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ cdm sf = fv nvf tni $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ q ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK w (scat q (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tT2 w r = pa $ >
  $ G ⇒ q = p ∧ pa = scat sf p $;

--| The inductive hypotheses of a constructor's path exist under the fold (`ifold_ihv` at the fold itself, a
--| function by `ifold_fn` and `ifold_elim_ok`).
theorem ifold_ihv_ex {n: set} (G: hyps) (H J: class) (u w r0 tg td tb tp tt tnp tn tm tv tK p cv mv pf pg pt pa: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ tK ∊ trees ω $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ ∃ n (n ∊ ihv td tK (ifold u (dnf u (mcv H)) td w p mv) pg pt (cdm pf)) $;

-- --------------------------------------------------------------------------
-- Iota (E6): the inductive hypotheses' values
-- --------------------------------------------------------------------------

--| The parts of a well-sorted `λ` are well-sorted.
theorem ofsort_lam_kids (G: hyps) (ta tb: set):
  $ G ⇒ ⟨ kc_lam , scons ta (scons tb ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ta ∊ ofsort lsig lopen ks_expr ∧ tb ∊ ofsort lsig lopen ks_expr $;

--| The `λ` step of the walk over an inductive hypothesis's value: if the body `tm`'s value at `scons a r`, for
--| every `a` in `ta`'s value, has its elements over the paths of `tb` there and at each path the value the
--| relation `L` gives the point `⟨ J , ⟨ o , apn V (f ++ a :: e) ⟩ ⟩`, the same holds for `λ ta. tm` at `r` over
--| the paths of `Π ta. tb`, with the binders passed `e`.
theorem dlam_step {a b d z q y f g h o: set} (G: hyps) (M L J V: class) (u w r e ta tb tm tl tp: set):
  $ G ⇒ ta ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tb ∊ trees ω $ >
  $ G ⇒ tm ∊ trees ω $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ uadm u $ >
  $ G ⇒ e ∊ fseq u $ >
  $ G ⇒ ∀ a ∀ b ∀ d (a ∊ dt u M ta w r → b = scons a r → d = scons a e → ∀ z (z ∊ dt u M tm w b → ∃ q ∃ y (q ∊ tpth (etel u (dnf u M) tb w b) ∧ z = nest q y))) $ >
  $ G ⇒ ∀ a ∀ b ∀ d (a ∊ dt u M ta w r → b = scons a r → d = scons a e → ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w b → ⟨ ⟨ J , ⟨ o , apn V (scat f d) ⟩ ⟩ , apn (dt u M tm w b) f ⟩ ∈ L)) $ >
  $ G ⇒ tl = ⟨ kc_lam , scons ta (scons tm ∅) ⟩ $ >
  $ G ⇒ tp = ⟨ kc_pi , scons ta (scons tb ∅) ⟩ $ >
  $ G ⇒ (∀ z (z ∊ dt u M tl w r → ∃ q ∃ y (q ∊ tpth (etel u (dnf u M) tp w r) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tp w r → ⟨ ⟨ J , ⟨ o , apn V (scat f e) ⟩ ⟩ , apn (dt u M tl w r) f ⟩ ∈ L) $;

--| The value of `X @ U` at the leaf of a walk over a field's type (as `ihty_leaf_val`, for any new head `x0` of
--| the re-headed result): `x0`'s value at the indices, the first `tni` arguments of a path of the field's result
--| `tA`, and the field (the entry `tf`) applied to the binders passed.
theorem ihx_leaf_val (G: hyps) (M: class) (u w r td tj tf tni tnp ty tA tX tU tY n0 x0 x1 z0 a: set):
  $ G ⇒ uadm u $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ n0 = ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ $ >
  $ G ⇒ n0 ∊ trees ω $ >
  $ G ⇒ x1 = ⟨ kc_bvar , scons tf ∅ ⟩ $ >
  $ G ⇒ tf ∊ trees ω $ >
  $ G ⇒ fv nvf z0 = ∅ $ >
  $ G ⇒ ra_rehead tY x0 tni tA tX ∈ lrel $ >
  $ G ⇒ ra_spine n0 tY tnp ∈ lrel $ >
  $ G ⇒ ra_pargs x1 z0 ty tU ∈ lrel $ >
  $ G ⇒ tA ∊ trees ω $ >
  $ G ⇒ tX ∊ trees ω $ >
  $ G ⇒ tU ∊ trees ω $ >
  $ G ⇒ tY ∊ trees ω $ >
  $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tA w r $ >
  $ G ⇒ fv r (fv nvf tf) ∈ u $ >
  $ G ⇒ dt u M ⟨ kc_app , scons tX (scons tU ∅) ⟩ w r = apn (dt u M x0 w r) (scons (apn (fv r (fv nvf tf)) (swin r ∅ (fv nvf ty))) (cres a (fv nvf tni))) $;

--| The leaf of the walk over an inductive hypothesis's value (`ihval_app`): `X3 @ U` at `r`, the binders passed
--| `e` in front of `sx`, with the recursor's head valued `irc`, its windows the parameters `p` and the minors and
--| motives, and the field `V` at `tf`: the value has the one path of the field's result `tA`, and there it is the
--| fold's value at the point of the field applied to the binders, given that the fold has one value at that point.
theorem ihval_leaf {z q y f g h o c i v k: set} (G: hyps) (H J V: class) (u w r r0 tg td tb tp tt tnp tv tj tFj tCj tni tlj tA tk tY tX1 tX2 tX3 tU tIH ta tdb tmn tf ty e sq sx ss p cv mv: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_nth_ty tt tj tFj tCj ∈ lrel $ >
  $ G ⇒ ra_isort tFj tni tlj ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ tA tk ∈ lrel $ >
  $ G ⇒ ra_rehead tY tX2 tni tA tX3 ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , scons td (scons tj ∅) ⟩ tY tnp ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ tdb tnp tX1 ∈ lrel $ >
  $ G ⇒ ra_pargs tX1 ta tmn tX2 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_bvar , scons tf ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ty tU ∈ lrel $ >
  $ G ⇒ e ∊ fseq u $ >
  $ G ⇒ cdm e = fv nvf ty $ >
  $ G ⇒ sq ∊ fseq u $ >
  $ G ⇒ cdm sq = fv nvf ta $ >
  $ G ⇒ r = scat e sx $ >
  $ G ⇒ sx ∊ fseq u $ >
  $ G ⇒ r = scat sq (scat (scat mv cv) (scat p ss)) $ >
  $ G ⇒ ss ∊ fseq u $ >
  $ G ⇒ cdm (scat mv cv) = fv nvf tmn $ >
  $ G ⇒ nadd (cdm sq) (cdm (scat mv cv)) = fv nvf tdb $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w r = irc u (dnf u (mcv H)) td (fv nvf tj) (lv tv w) w $ >
  $ G ⇒ fv r (fv nvf tf) = V $ >
  $ G ⇒ V ∈ u $ >
  $ G ⇒ ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tA w r → k = scat f e → (∃ c ∃ i (⟨ fv nvf tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (fv nvf tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = fv nvf tni ∧ o = scat i p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ fv nvf tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) $ >
  $ G ⇒ tf ∊ trees ω $ >
  $ G ⇒ tIH = ⟨ kc_app , scons tX3 (scons tU ∅) ⟩ $ >
  $ G ⇒ (∀ z (z ∊ dt u (mcv H) tIH w r → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) tA w r) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tA w r → ⟨ ⟨ fv nvf tj , ⟨ o , apn V (scat f e) ⟩ ⟩ , apn (dt u (mcv H) tIH w r) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv) $;

--| The value of an inductive hypothesis (`ihval`, read off the field's type `tA` at depth `ty`) at a valuation
--| `e` of the binders passed in front of `sx` (the fields `fd`, the minors and motives, the parameters `p`):
--| its elements are over the paths of `tA` there, and at each path it is the fold's value at the point of the
--| field `V` applied to the path's fields and the binders, given the points' facts at every path (the fold has
--| one value there, the point is in the family at the type's indices followed by `p`).
theorem ihval_sem {z q y f g h o c i v k x: set} (G: hyps) (H J V: class) (u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv: set) (tA ty tIH e r: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_nth_ty tt tj tFj tCj ∈ lrel $ >
  $ G ⇒ ra_isort tFj tni tlj ∈ lrel $ >
  $ G ⇒ ra_nidx td tj tni ∈ lrel $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf tnf $ >
  $ G ⇒ ss ∊ fseq u $ >
  $ G ⇒ sx = scat fd (scat (scat mv cv) (scat p ss)) $ >
  $ G ⇒ cdm (scat mv cv) = nadd (fv nvf tm) (fv nvf tn) $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (fv nvf tj) (lv tv w) w) $ >
  $ G ⇒ fv sx (fv nvf tfld) = V $ >
  $ G ⇒ V ∈ u $ >
  $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld ty tj tA tIH ∈ lrel $ >
  $ G ⇒ tIH ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ e ∊ fseq u $ >
  $ G ⇒ cdm e = fv nvf ty $ >
  $ G ⇒ r = scat e sx $ >
  $ G ⇒ ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tA w r → k = scat f e → (∃ c ∃ i (⟨ fv nvf tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (fv nvf tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = fv nvf tni ∧ o = scat i p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ fv nvf tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) $ >
  $ G ⇒ (∀ z (z ∊ dt u (mcv H) tIH w r → ∃ q ∃ y (q ∊ tpth (etel u (dnf u (mcv H)) tA w r) ∧ z = nest q y))) ∧ ∀ f ∀ g ∀ h ∀ o (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tA w r → ⟨ ⟨ fv nvf tj , ⟨ o , apn V (scat f e) ⟩ ⟩ , apn (dt u (mcv H) tIH w r) f ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv) $;

-- --------------------------------------------------------------------------
-- Iota (E6): the inductive hypotheses' values in the fold's spaces
-- --------------------------------------------------------------------------

--| An inductive hypothesis's value (`ihval` at depth `0`) at the fields' valuation `sx` is an element of the
--| hypothesis's space under the fold, for tables `Gg`, `Tt` whose entries at `Dd` are the field `V` and the paths
--| of the field's type there, given the points' facts at every path.
theorem ihval_val {f g h o k c i v y x: set} (G: hyps) (H J V Gg Tt Dd: class) (u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld fd ss sx p cv mv tA tIH: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_nth_ty tt tj tFj tCj ∈ lrel $ >
  $ G ⇒ ra_isort tFj tni tlj ∈ lrel $ >
  $ G ⇒ ra_nidx td tj tni ∈ lrel $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf tnf $ >
  $ G ⇒ ss ∊ fseq u $ >
  $ G ⇒ sx = scat fd (scat (scat mv cv) (scat p ss)) $ >
  $ G ⇒ cdm (scat mv cv) = nadd (fv nvf tm) (fv nvf tn) $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (fv nvf tj) (lv tv w) w) $ >
  $ G ⇒ fv sx (fv nvf tfld) = V $ >
  $ G ⇒ V ∈ u $ >
  $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_nz , ∅ ⟩ tj tA tIH ∈ lrel $ >
  $ G ⇒ tIH ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tA w sx → k = f → (∃ c ∃ i (⟨ fv nvf tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn V k ∈ apn (ity u (dnf u (mcv H)) td (fv nvf tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = fv nvf tni ∧ o = scat i p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ fv nvf tj , ⟨ o , apn V k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) $ >
  $ G ⇒ fv Tt Dd = etel u (dnf u (mcv H)) tA w sx $ >
  $ G ⇒ fv Gg Dd = V $ >
  $ G ⇒ dt u (mcv H) tIH w sx ∈ ihsp (ifold u (dnf u (mcv H)) td w p mv) Gg Tt Dd (fv nvf tj) $;

-- --------------------------------------------------------------------------
-- Iota (E6): a recursive field's points; the hypothesis at a valuation of the walk
-- --------------------------------------------------------------------------

--| The points of a recursive field `th` (on type `tj`) of a constructor's path over the parameters `p`, at an
--| entry of the field's paths: the entry's arguments are the type's indices followed by `p`, the field's value
--| there is an element of the type at them, and the fold has exactly one value at its point (`ifold_rec_pt`,
--| `ifold_rec_val` with the fold a function by `ifold_fn` and `ifold_elim_ok`).
theorem rec_pt_facts {c i v y: set} (G: hyps) (H J: class) (u w r0 tg td tb tp tt tnp tn tm tv tK0 th ta tj tni p cv mv pf pg pt pa q1 q2 q3 q4: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_nth_pi tK0 th ta ∈ lrel $ >
  $ G ⇒ ra_recfield td tn tnp th ta tj ∈ lrel $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ ra_nidx td tj tni ∈ lrel $ >
  $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ fv pt (fv nvf th) $ >
  $ G ⇒ (∃ c ∃ i (⟨ fv nvf tj , ⟨ q4 , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn (fv pg (fv nvf th)) q1 ∈ apn (ity u (dnf u (mcv H)) td (fv nvf tj) w) q4 ∧ i ∊ fseq {y | y = y} ∧ cdm i = fv nvf tni ∧ q4 = scat i p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ fv nvf tj , ⟨ q4 , apn (fv pg (fv nvf th)) q1 ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v)) $;

--| The inductive hypothesis of a recursive field (`rwalk_pi_rec`: `ihval` at the field's type lifted over the later
--| fields) at the valuation with the later fields `sf` and the field `sa` in front of the walk's valuation `rm` at
--| the field: an element of the hypothesis's space under the fold, for the path's tables `pg`, `pt` whose entries
--| at the field are `sa` and the paths of the field's type `tA3` at `rm`, given the points' facts at those paths.
theorem ihval_at {f g h o k c i v y x: set} (G: hyps) (H J: class) (u w r0 tg td tb tp tt tnp tn tm tv tj tFj tCj tni tlj tnf tfld tsh d fd ss rm p cv mv sf sa pg pt tA3 tA4 tIH: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_nth_ty tt tj tFj tCj ∈ lrel $ >
  $ G ⇒ ra_isort tFj tni tlj ∈ lrel $ >
  $ G ⇒ ra_nidx td tj tni ∈ lrel $ >
  $ G ⇒ ∀ x (x ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons tj (scons tv ∅)) ⟩ w x = irc u (dnf u (mcv H)) td (fv nvf tj) (lv tv w) w) $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ nadd (suc (cdm sf)) (fv nvf d) = fv nvf tnf $ >
  $ G ⇒ sa ∊ u $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ ss ∊ fseq u $ >
  $ G ⇒ rm = scat fd (scat (scat mv cv) (scat p ss)) $ >
  $ G ⇒ cdm (scat mv cv) = nadd (fv nvf tm) (fv nvf tn) $ >
  $ G ⇒ ra_add tsh d tnf ∈ lrel $ >
  $ G ⇒ ra_add tfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tsh ∈ lrel $ >
  $ G ⇒ ra_lift tsh ⟨ kc_nz , ∅ ⟩ tA3 tA4 ∈ lrel $ >
  $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_nz , ∅ ⟩ tj tA4 tIH ∈ lrel $ >
  $ G ⇒ tIH ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ fv pt (fv nvf d) = etel u (dnf u (mcv H)) tA3 w rm $ >
  $ G ⇒ fv pg (fv nvf d) = sa $ >
  $ G ⇒ ∀ f ∀ g ∀ h ∀ o ∀ k (⟨ f , ⟨ g , ⟨ h , o ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tA3 w rm → k = f → (∃ c ∃ i (⟨ fv nvf tj , ⟨ o , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn (sa) k ∈ apn (ity u (dnf u (mcv H)) td (fv nvf tj) w) o ∧ i ∊ fseq {y | y = y} ∧ cdm i = fv nvf tni ∧ o = scat i p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ fv nvf tj , ⟨ o , apn (sa) k ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v))) $ >
  $ G ⇒ dt u (mcv H) tIH w (scat sf (scons sa rm)) ∈ ihsp (ifold u (dnf u (mcv H)) td w p mv) pg pt (fv nvf d) (fv nvf tj) $;

-- --------------------------------------------------------------------------
-- Iota (E6): the steps of the walk over the rule's right-hand side
-- --------------------------------------------------------------------------

--| The accumulator's invariant past a non-recursive field `sa`: the hypotheses' valuations up to the next field
--| are those up to this one.
theorem rw_inv_nr {z i: set} (G: hyps) (M D K0 L MV: class) (u w rm fd sf sa f b e dn dm pg pt tAcc: set):
  $ G ⇒ rm ∊ fseq u $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ sa ∊ u $ >
  $ G ⇒ f = ssnoc sf sa $ >
  $ G ⇒ b = scons sa rm $ >
  $ G ⇒ e = scons sa fd $ >
  $ G ⇒ dn ∊ ω $ >
  $ G ⇒ dm = suc dn $ >
  $ G ⇒ ¬ ∃ i (irf D K0 dn i) $ >
  $ G ⇒ ∀ z (z ∊ ihv D K0 L pg pt dn → dt u M tAcc w (scat f rm) = apn MV (scat z (scat f fd))) $ >
  $ G ⇒ ∀ z (z ∊ ihv D K0 L pg pt dm → dt u M tAcc w (scat sf b) = apn MV (scat z (scat sf e))) $;

--| The `λ` step of the walk over the rule's right-hand side: the value of `λ A3. V` at the fields `f = sf ++ [sa]`
--| is the body's, at the valuations extended by the field `sa`, at `sf`.
theorem rw_lam {z: set} (G: hyps) (M D K0 L MV N: class) (u w rm fd sf sa f b e pg pt tA3 tV tl: set):
  $ G ⇒ rm ∊ fseq u $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ sa ∊ u $ >
  $ G ⇒ f = ssnoc sf sa $ >
  $ G ⇒ b = scons sa rm $ >
  $ G ⇒ e = scons sa fd $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ sa ∊ dt u M tA3 w rm $ >
  $ G ⇒ tA3 ∊ trees ω $ >
  $ G ⇒ tV ∊ trees ω $ >
  $ G ⇒ tl = ⟨ kc_lam , scons tA3 (scons tV ∅) ⟩ $ >
  $ G ⇒ ∀ z (z ∊ ihv D K0 L pg pt N → apn (dt u M tV w b) sf = apn MV (scat z (scat sf e))) $ >
  $ G ⇒ ∀ z (z ∊ ihv D K0 L pg pt N → apn (dt u M tl w rm) f = apn MV (scat z (scat f fd))) $;

--| The accumulator's invariant past a recursive field `sa` on type `J`, for the accumulator applied to the field's
--| inductive hypothesis `tIH`: the hypotheses' valuations up to the next field are those up to this one with one
--| more hypothesis in front, the space has one element, and `tIH`'s value is in it.
theorem rw_inv_rec {z a h k: set} (G: hyps) (M D K0 L MV J: class) (u w rm fd sf sa f b e dn dm pg pt tAcc tIH tq: set):
  $ G ⇒ rm ∊ fseq u $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ sa ∊ u $ >
  $ G ⇒ f = ssnoc sf sa $ >
  $ G ⇒ b = scons sa rm $ >
  $ G ⇒ e = scons sa fd $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ dn ∊ ω $ >
  $ G ⇒ dm = suc dn $ >
  $ G ⇒ irf D K0 dn J $ >
  $ G ⇒ ∀ a (isset (ap L a)) $ >
  $ G ⇒ tAcc ∊ trees ω $ >
  $ G ⇒ tIH ∊ trees ω $ >
  $ G ⇒ tq = ⟨ kc_app , scons tAcc (scons tIH ∅) ⟩ $ >
  $ G ⇒ ∀ z (z ∊ ihv D K0 L pg pt dn → dt u M tAcc w (scat f rm) = apn MV (scat z (scat f fd))) $ >
  $ G ⇒ dt u M tIH w (scat sf b) ∈ ihsp L pg pt dn J $ >
  $ G ⇒ ∀ h ∀ k (h ∊ ihsp L pg pt dn J → k ∊ ihsp L pg pt dn J → h = k) $ >
  $ G ⇒ ∀ z (z ∊ ihv D K0 L pg pt dm → dt u M tq w (scat sf b) = apn MV (scat z (scat sf e))) $;

-- --------------------------------------------------------------------------
-- Iota (E6): the walk over the rule's right-hand side
-- --------------------------------------------------------------------------

--| A path of `Π ta. tb`, in full: its first field is an element of `ta`'s value and of the universe, the rest is
--| a path of `tb` past it, and the table starts with the paths of `ta` (`etel_pi_elim` and `etel_pi_tab` together).
theorem etel_pi_full {x f g t: set} (G: hyps) (M: class) (u w r ta tb q1 q2 q3 q4: set):
  $ G ⇒ ta ∊ trees ω $ >
  $ G ⇒ tb ∊ trees ω $ >
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) ⟨ kc_pi , scons ta (scons tb ∅) ⟩ w r $ >
  $ G ⇒ ∃ x ∃ f ∃ g ∃ t (x ∊ dt u M ta w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , q4 ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tb w (scons x r) ∧ q1 = ssnoc f x ∧ q2 = scons x g ∧ q3 = scons (etel u (dnf u M) ta w r) t) $;

--| The accumulator of a walk (`rwalk`) whose value is well-sorted is well-sorted (the value ends in it).
theorem rwalk_sort (G: hyps) (td tnp tn tm tv tnf d tAcc tK tVal: set):
  $ G ⇒ ra_rwalk td tnp tn tm tv tnf d tAcc tK tVal ∈ lrel $ >
  $ G ⇒ tVal ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tAcc ∊ ofsort lsig lopen ks_expr $;

--| `rec_pt_facts` with the field's value named: `sa` for the entry of the path's fields at the recursive field.
theorem rec_pt_at {c i v y: set} (G: hyps) (H J: class) (u w r0 tg td tb tp tt tnp tn tm tv tK0 th ta tj tni p cv mv pf pg pt pa q1 q2 q3 q4 sa: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_nth_pi tK0 th ta ∈ lrel $ >
  $ G ⇒ ra_recfield td tn tnp th ta tj ∈ lrel $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ ra_nidx td tj tni ∈ lrel $ >
  $ G ⇒ ⟨ q1 , ⟨ q2 , ⟨ q3 , q4 ⟩ ⟩ ⟩ ∈ fv pt (fv nvf th) $ >
  $ G ⇒ fv pg (fv nvf th) = sa $ >
  $ G ⇒ (∃ c ∃ i (⟨ fv nvf tj , ⟨ q4 , c ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ apn (sa) q1 ∈ apn (ity u (dnf u (mcv H)) td (fv nvf tj) w) q4 ∧ i ∊ fseq {y | y = y} ∧ cdm i = fv nvf tni ∧ q4 = scat i p)) ∧ ∃ v (v ∊ u ∧ ∀ y (⟨ ⟨ fv nvf tj , ⟨ q4 , apn (sa) q1 ⟩ ⟩ , y ⟩ ∈ ifold u (dnf u (mcv H)) td w p mv ↔ y = v)) $;

--| The space of a recursive field's inductive hypotheses under the fold has at most one element (`ifold_ihsp`
--| with the fold a function by `ifold_fn` and `ifold_elim_ok`).
theorem rw_uni {h k: set} (G: hyps) (H J SD SI: class) (u w r0 tg td tb tp tt tnp tn tm tv tK0 p cv mv pf pg pt pa: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ tK0 ∊ trees ω $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ irf td tK0 SD SI $ >
  $ G ⇒ SD ∈ ω $ >
  $ G ⇒ SI ∈ ω $ >
  $ G ⇒ ∀ h ∀ k (h ∊ ihsp (ifold u (dnf u (mcv H)) td w p mv) pg pt SD SI → k ∊ ihsp (ifold u (dnf u (mcv H)) td w p mv) pg pt SD SI → h = k) $;

--| The inductive hypothesis of a recursive field at the walk's valuation is an element of its space under the
--| fold (`ihval_at` with the points' facts by `rec_pt_at`), given the block's facts at every type: its
--| sort's arity (`nidx`) and the recursor's value.
theorem rw_rec_ih {j b e m q z: set} (G: hyps) (H J: class) (u w r0 tg td tb tp tt tnp tn tm tv tK0 tA tj tnf tfld tsh d fd ss rm p cv mv pf pg pt pa sf sa tA3 tA4 tIH: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ ∀ j (j ∊ trees ω → fv nvf j ∈ fv nvf tn → ∃ b ∃ e ∃ m ∃ q (ra_nth_ty tt j b e ∈ lrel ∧ ra_isort b m q ∈ lrel ∧ ra_nidx td j m ∈ lrel)) $ >
  $ G ⇒ ∀ j ∀ z (j ∊ trees ω → fv nvf j ∈ fv nvf tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (fv nvf j) (lv tv w) w) $ >
  $ G ⇒ ra_nth_pi tK0 d tA ∈ lrel $ >
  $ G ⇒ ra_recfield td tn tnp d tA tj ∈ lrel $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ nadd (suc (cdm sf)) (fv nvf d) = fv nvf tnf $ >
  $ G ⇒ sa ∊ u $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ ss ∊ fseq u $ >
  $ G ⇒ rm = scat fd (scat (scat mv cv) (scat p ss)) $ >
  $ G ⇒ cdm (scat mv cv) = nadd (fv nvf tm) (fv nvf tn) $ >
  $ G ⇒ ra_add tsh d tnf ∈ lrel $ >
  $ G ⇒ ra_add tfld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tsh ∈ lrel $ >
  $ G ⇒ ra_lift tsh ⟨ kc_nz , ∅ ⟩ tA3 tA4 ∈ lrel $ >
  $ G ⇒ ra_ihval td tnp tn tm tv tnf tfld ⟨ kc_nz , ∅ ⟩ tj tA4 tIH ∈ lrel $ >
  $ G ⇒ tIH ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ fv pt (fv nvf d) = etel u (dnf u (mcv H)) tA3 w rm $ >
  $ G ⇒ fv pg (fv nvf d) = sa $ >
  $ G ⇒ dt u (mcv H) tIH w (scat sf (scons sa rm)) ∈ ihsp (ifold u (dnf u (mcv H)) td w p mv) pg pt (fv nvf d) (fv nvf tj) $;

--| The walk over the rule's right-hand side (`rwalk`), relative to one path `⟨ pf , pg , pt , pa ⟩` of the
--| constructor's type `tK0` at the parameters `p`: for the rest `tK` of the type after `d` fields, with the fields
--| passed `fd`, their tables `gd` and `hd`, the rest `⟨ sf , sg , sc , pa ⟩` of the path (a path of `tK` at `rk`,
--| the fields in front of the parameters and the types' values `xs`) and the minor's valuation `rm` (the fields in
--| front of the minors and motives `c0`, the parameters and the outer valuation `ss`): if the accumulator `tAcc`
--| at the later fields in front of `rm` is `MV` at the inductive hypotheses so far, the fields and `fd`, then the
--| value `tVal` at `rm`, applied to the later fields, is `MV` at all the inductive hypotheses and the fields.
--| The hypotheses: the rest is closed at `d` past the parameters and types (`tx`), has `tq` binders left, its
--| binders are the later binders of `tK0`; the block's facts at every type (the sort's arity, the recursor's
--| value); the types' values `xs` are the block's types' at every index.
--| @freshen G z
--| @freshen G j
--| @freshen G b
--| @freshen G e
--| @freshen G m
--| @freshen G q
--| @freshen G y
theorem rwalk_sem {z j b e m q y: set} (G: hyps) (H J MV: class) (u w r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa ss c0 xs: set) (tK d tAcc tVal fd rm rk sf sg sc gd hd tx tq: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ tK0 ∊ trees ω $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ ∀ j (j ∊ trees ω → fv nvf j ∈ fv nvf tn → ∃ b ∃ e ∃ m ∃ q (ra_nth_ty tt j b e ∈ lrel ∧ ra_isort b m q ∈ lrel ∧ ra_nidx td j m ∈ lrel)) $ >
  $ G ⇒ ∀ j ∀ z (j ∊ trees ω → fv nvf j ∈ fv nvf tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (fv nvf j) (lv tv w) w) $ >
  $ G ⇒ ss ∊ fseq u $ >
  $ G ⇒ cdm (scat mv cv) = nadd (fv nvf tm) (fv nvf tn) $ >
  $ G ⇒ c0 = scat mv cv $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → fv nvf b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = fv xs j) $ >
  $ G ⇒ ra_rwalk td tnp tn tm tv tnf d tAcc tK tVal ∈ lrel $ >
  $ G ⇒ tVal ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ d ∊ trees ω $ >
  $ G ⇒ ra_closed tx tK ∈ lrel $ >
  $ G ⇒ fv nvf tx = nadd (nadd (fv nvf d) (fv nvf tnp)) (fv nvf tn) $ >
  $ G ⇒ ra_npis tK tq ∈ lrel $ >
  $ G ⇒ nadd (fv nvf tq) (fv nvf d) = fv nvf tnf $ >
  $ G ⇒ ∀ b ∀ e ∀ m (ra_nth_pi tK b e ∈ lrel → ra_add d b m ∈ lrel → ra_nth_pi tK0 m e ∈ lrel) $ >
  $ G ⇒ fd ∊ fseq u $ >
  $ G ⇒ cdm fd = fv nvf d $ >
  $ G ⇒ gd ∊ fseq u $ >
  $ G ⇒ cdm gd = fv nvf d $ >
  $ G ⇒ hd ∊ fseq {y | y = y} $ >
  $ G ⇒ cdm hd = fv nvf d $ >
  $ G ⇒ rm = scat fd (scat c0 (scat p ss)) $ >
  $ G ⇒ rk = scat fd (scat p xs) $ >
  $ G ⇒ ⟨ sf , ⟨ sg , ⟨ sc , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK w rk $ >
  $ G ⇒ pg = scat gd sg $ >
  $ G ⇒ pt = scat hd sc $ >
  $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (fv nvf d) → dt u (mcv H) tAcc w (scat sf rm) = apn MV (scat z (scat sf fd))) $ >
  $ G ⇒ ∀ z (z ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (fv nvf tnf) → apn (dt u (mcv H) tVal w rm) sf = apn MV (scat z (scat sf fd))) $;

-- --------------------------------------------------------------------------
-- Iota (E6): tools for the right-hand side's value
-- --------------------------------------------------------------------------

--| A spine over a head that is not an application passes through every head it is a spine over: if `te` is `th`
--| applied to arguments and also `tY` applied to arguments, then `tY` is `th` applied to arguments.
theorem spine_split {a b c: set} (G: hyps) (th tY te tn tk: set):
  $ G ⇒ ∀ a ∀ b (¬ th = ⟨ kc_app , scons a (scons b ∅) ⟩) $ >
  $ G ⇒ ra_spine th te tn ∈ lrel $ >
  $ G ⇒ ra_spine tY te tk ∈ lrel $ >
  $ G ⇒ ∃ c (ra_spine th tY c ∈ lrel) $;

--| The body of a well-sorted iterated `λ` (`lams`) is well-sorted.
theorem lams_sort (G: hyps) (tP tX tR: set):
  $ G ⇒ ra_lams tP tX tR ∈ lrel $ >
  $ G ⇒ tR ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tX ∊ ofsort lsig lopen ks_expr $;

--| Entry `j` from the end of a sequence of `N` entries (`vat`) is its entry `i`, for `suc j + i = N`.
theorem vat_fv (G: hyps) (S N j: class) (i: set):
  $ G ⇒ i ∊ ω $ >
  $ G ⇒ j ∈ ω $ >
  $ G ⇒ nadd (suc j) i = N $ >
  $ G ⇒ vat S N j = fv S i $;

--| The start of the walk over the rule's right-hand side: the accumulator `#mk` applied to the fields (`pargs`),
--| at the fields `pf` in front of a valuation that starts with the minors `mv`, is minor `sk` (counted from the
--| end, `mk + sk + 1 = nf + m`) applied to the fields.
theorem rw_start (G: hyps) (M D: class) (u w pf mv ry rm tnf tm ta tmk tk tAcc sk: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ pf ∊ fseq u $ >
  $ G ⇒ cdm pf = fv nvf tnf $ >
  $ G ⇒ mv ∊ fseq u $ >
  $ G ⇒ cdm mv = fv nvf tm $ >
  $ G ⇒ ry ∊ fseq u $ >
  $ G ⇒ rm = scat mv ry $ >
  $ G ⇒ ra_add tnf tm ta ∈ lrel $ >
  $ G ⇒ ra_add tmk ⟨ kc_s , scons tk ∅ ⟩ ta ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_bvar , scons tmk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tnf tAcc ∈ lrel $ >
  $ G ⇒ inmin D = fv nvf tm $ >
  $ G ⇒ sk = fv nvf tk $ >
  $ G ⇒ sk ∈ inmin D $ >
  $ G ⇒ tk ∊ trees ω $ >
  $ G ⇒ dt u M tAcc w (scat pf rm) = apn (vat mv (inmin D) sk) pf $;

-- --------------------------------------------------------------------------
-- Iota (E6): the right-hand side's value, down to the walk's
-- --------------------------------------------------------------------------

--| Concatenations with first parts of one length have the same parts (`scat_inj` without the second lengths).
theorem scat_inj_l (G: hyps) (A: class) (i s b t: set):
  $ G ⇒ i ∊ fseq A $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ b ∊ fseq A $ > $ G ⇒ t ∊ fseq A $ > $ G ⇒ cdm i = cdm s $ > $ G ⇒ scat i b = scat s t $ >
  $ G ⇒ i = s ∧ b = t $;

--| The arguments of a spine over a head with no arguments are a sequence (the premise of `spine_args` and
--| `rehead_args` at such a spine).
theorem spine_head_args {b y: set} (G: hyps) (M: class) (u w r n0 tY tc: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ etel u (dnf u M) n0 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ >
  $ G ⇒ ra_spine n0 tY tc ∈ lrel $ >
  $ G ⇒ tY ∊ trees ω $ >
  $ G ⇒ ∀ b (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , b ⟩ ⟩ ⟩ ∈ etel u (dnf u M) tY w r → b ∊ fseq {y | y = y}) $;

--| The second `rehead` of the iota rule's right-hand side: the major premise `tmj`, a spine over a head with
--| arguments `pf ++ p`, re-headed at its last `nf` arguments (`pf`) from `tY` to `tX`, is `tX`'s value applied
--| to `pf`.
theorem rhs_maj (G: hyps) (M K S: class) (u w r tY tX tnf tnq tmj trhs pf p: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ >
  $ G ⇒ ¬ K = kc_pi $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ isset K $ >
  $ G ⇒ ra_spine ⟨ K , S ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ ra_rehead tY tX tnf tmj trhs ∈ lrel $ >
  $ G ⇒ tmj ∊ trees ω $ >
  $ G ⇒ trhs ∊ trees ω $ >
  $ G ⇒ sarg u (dnf u M) tmj w r = scat pf p $ >
  $ G ⇒ pf ∊ fseq u $ >
  $ G ⇒ cdm pf = fv nvf tnf $ >
  $ G ⇒ p ∊ fseq u $ >
  $ G ⇒ dt u M trhs w r = apn (dt u M tX w r) pf $;

--| The first `rehead` of the iota rule's right-hand side: the recursor's spine `te3` (up to the indices, `te4 =
--| te3` applied to them, with arguments `sf ++ y0`) re-headed to the rule `tR` is `tR`'s value applied to `y0`.
theorem rhs_rec (G: hyps) (M: class) (u w r td ti tv tR ta te3 te4 tni trhs0 sf y0: set):
  $ G ⇒ w ∊ lvals $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ ∈ trees ω $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_spine te3 te4 tni ∈ lrel $ >
  $ G ⇒ te3 ∊ trees ω $ >
  $ G ⇒ te4 ∊ trees ω $ >
  $ G ⇒ trhs0 ∊ trees ω $ >
  $ G ⇒ sarg u (dnf u M) te4 w r = scat sf y0 $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ cdm sf = fv nvf tni $ >
  $ G ⇒ y0 ∊ fseq u $ >
  $ G ⇒ dt u M trhs0 w r = apn (dt u M tR w r) y0 $;

--| The rule's value `tR = λ P. λ M. λ N. tVal` (three `lams`) applied to the parameters, motives and minors is
--| the body's value at the valuation with them in front (`lrel_lams_sem`, `ilam_apn`, `dsh_da`, with the
--| telescopes' valuations by `imots_wf` and `imins_wf`).
theorem rhs_lams (G: hyps) (H J: class) (u w r r0 tg td tb tp tt tnp tn tm tv ti tF tE tM tN tR tR1 tR2 tVal p cv mv: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_tys_closed tp tt ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tp ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_lams tp tR2 tR ∈ lrel $ >
  $ G ⇒ ra_lams tM tR1 tR2 ∈ lrel $ >
  $ G ⇒ ra_lams tN tVal tR1 ∈ lrel $ >
  $ G ⇒ apn (dt u (mcv H) tR w r) (scat mv (scat cv p)) = dt u (mcv H) tVal w (scat mv (scat cv (scat p r))) $;

--| The walk over the rule's right-hand side from its start (`rwalk_sem` at depth `0`, `rw_start`): the value
--| `tVal` at the minors, motives and parameters in front of the valuation, applied to the fields `pf` of a path
--| of the constructor's type, is the constructor's minor `sk` at the inductive hypotheses `sh` and the fields.
theorem rw_top {z j b e m q: set} (G: hyps) (H J: class) (u w r r0 tg td tb tp tt tnp tn tm tv tnf tK0 p cv mv pf pg pt pa xs ta tmk tk tAcc tVal tx sh sk: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ ∀ j (j ∊ trees ω → fv nvf j ∈ fv nvf tn → ∃ b ∃ e ∃ m ∃ q (ra_nth_ty tt j b e ∈ lrel ∧ ra_isort b m q ∈ lrel ∧ ra_nidx td j m ∈ lrel)) $ >
  $ G ⇒ ∀ j ∀ z (j ∊ trees ω → fv nvf j ∈ fv nvf tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (fv nvf j) (lv tv w) w) $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ xs = (ixs td w (ifam u (dnf u (mcv H)) td w)) $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → fv nvf b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = fv xs j) $ >
  $ G ⇒ ra_npis tK0 tnf ∈ lrel $ >
  $ G ⇒ ra_add tnf tm ta ∈ lrel $ >
  $ G ⇒ ra_add tmk ⟨ kc_s , scons tk ∅ ⟩ ta ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_bvar , scons tmk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tnf tAcc ∈ lrel $ >
  $ G ⇒ ra_rwalk td tnp tn tm tv tnf ⟨ kc_nz , ∅ ⟩ tAcc tK0 tVal ∈ lrel $ >
  $ G ⇒ tVal ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_closed tx tK0 ∈ lrel $ >
  $ G ⇒ fv nvf tx = nadd (fv nvf tnp) (fv nvf tn) $ >
  $ G ⇒ cdm pf = fv nvf tnf $ >
  $ G ⇒ sh ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (cdm pf) $ >
  $ G ⇒ sk = fv nvf tk $ >
  $ G ⇒ sk ∈ inmin td $ >
  $ G ⇒ tk ∊ trees ω $ >
  $ G ⇒ apn (dt u (mcv H) tVal w (scat mv (scat cv (scat p r)))) pf = apn (vat mv (inmin td) sk) (scat sh pf) $;

-- --------------------------------------------------------------------------
-- Iota (E6): the right-hand side's value
-- --------------------------------------------------------------------------

--| The value of the iota rule's right-hand side `trhs` (the major premise `tmj` re-headed from `tY` to `trhs0`, the
--| recursor's spine `te3` re-headed to the rule `tR = λ P. λ M. λ N. tVal`): the constructor's minor `sk` at the
--| inductive hypotheses `sh` and the fields `pf`, the value of the left-hand side (`iota_lhs_val`). By `rhs_maj`,
--| `rhs_rec`, `rhs_lams` and `rw_top`.
theorem iota_rhs_val {j b e m q z: set} (G: hyps) (H J K S: class) (u w r r0 tg td tb tp tt tnp tn tm tv ti tF tE tM tN tR tR1 tR2 tVal p cv mv tY trhs0 tnf tnq tmj trhs pf ta te3 te4 tni sf tK0 pg pt pa xs tam tmk tk tAcc tx sh sk: set):
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ >
  $ G ⇒ ¬ K = kc_pi $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ isset K $ >
  $ G ⇒ ra_spine ⟨ K , S ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ ra_rehead tY trhs0 tnf tmj trhs ∈ lrel $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tmj w r = scat pf p $ >
  $ G ⇒ cdm pf = fv nvf tnf $ >
  $ G ⇒ ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ ∈ trees ω $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_spine te3 te4 tni ∈ lrel $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ cdm sf = fv nvf tni $ >
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_tys_closed tp tt ∈ lrel $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tp ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_lams tp tR2 tR ∈ lrel $ >
  $ G ⇒ ra_lams tM tR1 tR2 ∈ lrel $ >
  $ G ⇒ ra_lams tN tVal tR1 ∈ lrel $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ ∀ j (j ∊ trees ω → fv nvf j ∈ fv nvf tn → ∃ b ∃ e ∃ m ∃ q (ra_nth_ty tt j b e ∈ lrel ∧ ra_isort b m q ∈ lrel ∧ ra_nidx td j m ∈ lrel)) $ >
  $ G ⇒ ∀ j ∀ z (j ∊ trees ω → fv nvf j ∈ fv nvf tn → z ∊ fseq u → dt u (mcv H) ⟨ kc_ind_rec , scons td (scons j (scons tv ∅)) ⟩ w z = irc u (dnf u (mcv H)) td (fv nvf j) (lv tv w) w) $ >
  $ G ⇒ xs = (ixs td w (ifam u (dnf u (mcv H)) td w)) $ >
  $ G ⇒ xs ∊ fseq u $ >
  $ G ⇒ cdm xs = fv nvf tn $ >
  $ G ⇒ ∀ j ∀ b (j ∊ cdm xs → b ∊ trees ω → fv nvf b = j → dt u (mcv H) ⟨ kc_ind_ty , scons td (scons b ∅) ⟩ w ∅ = fv xs j) $ >
  $ G ⇒ ra_npis tK0 tnf ∈ lrel $ >
  $ G ⇒ ra_add tnf tm tam ∈ lrel $ >
  $ G ⇒ ra_add tmk ⟨ kc_s , scons tk ∅ ⟩ tam ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_bvar , scons tmk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tnf tAcc ∈ lrel $ >
  $ G ⇒ ra_rwalk td tnp tn tm tv tnf ⟨ kc_nz , ∅ ⟩ tAcc tK0 tVal ∈ lrel $ >
  $ G ⇒ tVal ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ra_closed tx tK0 ∈ lrel $ >
  $ G ⇒ fv nvf tx = nadd (fv nvf tnp) (fv nvf tn) $ >
  $ G ⇒ sh ∊ ihv td tK0 (ifold u (dnf u (mcv H)) td w p mv) pg pt (cdm pf) $ >
  $ G ⇒ sk = fv nvf tk $ >
  $ G ⇒ sk ∈ inmin td $ >
  $ G ⇒ tk ∊ trees ω $ >
  $ G ⇒ sarg u (dnf u (mcv H)) te4 w r = scat sf (scat mv (scat cv p)) $ >
  $ G ⇒ dt u (mcv H) trhs w r = apn (vat mv (inmin td) sk) (scat sh pf) $;

-- --------------------------------------------------------------------------
-- Iota (E6): the two sides have one value
-- --------------------------------------------------------------------------

--| The two sides of the iota rule have one value: the recursor applied to its arguments and the major premise
--| (`iota_lhs_val`) and the rule's right-hand side (`iota_rhs_val`), with the inductive hypotheses' valuation by
--| `ifold_ihv_ex`. The hypotheses are theirs.
theorem iota_vals_eq {j b e m q z: set} (G: hyps) (H J K S: class) (u w r r0 tg td tv ti tc tb tp tt tnp tn tm tF tE tK0 tni tl te4 tks tmj tnq sf mv cv p pf pg pt pa sk sj sc tM tN tR tR1 tR2 tVal tY trhs0 tnf trhs ta te3 xs tam tmk tk tAcc tx: set):
  $ G ⇒ iwf u H J tg td w r0 $ >
  $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ ra_ind_data td tb tp tt ∈ lrel $ >
  $ G ⇒ ra_clen tp tnp ∈ lrel $ >
  $ G ⇒ ra_ntys tt tn tm ∈ lrel $ >
  $ G ⇒ ra_elim_ok tg td tv ∈ lrel3 J $ >
  $ G ⇒ ra_nth_ty tt ti tF tE ∈ lrel $ >
  $ G ⇒ ra_nth_ctor tE tc tK0 ∈ lrel $ >
  $ G ⇒ ra_isort tF tni tl ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ te4 tks ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ K , S ⟩ tmj tnq ∈ lrel $ >
  $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ >
  $ G ⇒ ¬ K = kc_pi $ >
  $ G ⇒ ¬ K = kc_app $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ w r = irc u (dnf u (mcv H)) td (fv nvf ti) (lv tv w) w $ >
  $ G ⇒ dt u (mcv H) ⟨ K , S ⟩ w r = ictor u (dnf u (mcv H)) td (fv nvf ti) (fv nvf tc) w $ >
  $ G ⇒ te4 ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ tmj ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ sarg u (dnf u (mcv H)) te4 w r = scat sf (scat mv (scat cv p)) $ >
  $ G ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ >
  $ G ⇒ cv ∊ imots u (dnf u (mcv H)) td w p (lv tv w) $ >
  $ G ⇒ mv ∊ imins u (dnf u (mcv H)) td w p cv $ >
  $ G ⇒ sarg u (dnf u (mcv H)) tmj w r = scat pf p $ >
  $ G ⇒ ⟨ pf , ⟨ pg , ⟨ pt , pa ⟩ ⟩ ⟩ ∈ etel u (dnf u (mcv H)) tK0 w (scat p (ixs td w (ifam u (dnf u (mcv H)) td w))) $ >
  $ G ⇒ pa = scat sf p $ >
  $ G ⇒ sf ∊ fseq u $ >
  $ G ⇒ cdm sf = fv nvf tni $ >
  $ G ⇒ iminx td sj sc sk $ >
  $ G ⇒ sj = fv nvf ti $ >
  $ G ⇒ sc = fv nvf tc $ >
  $ G ⇒ isset K $ >
  $ G ⇒ ra_rehead tY trhs0 tnf tmj trhs ∈ lrel $ >
  $ G ⇒ cdm pf = fv nvf tnf $ >
  $ G ⇒ ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ ∈ trees ω $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_rec , scons td (scons ti (scons tv ∅)) ⟩ tR ta te3 trhs0 ∈ lrel $ >
  $ G ⇒ ra_spine te3 te4 tni ∈ lrel $ >
  $ G ⇒ hctor ⊆ H $ >
  $ G ⇒ ra_tys_closed tp tt ∈ lrel $ >
  $ G ⇒ ra_motives td tnp tv ⟨ kc_nz , ∅ ⟩ tt tM ∈ lrel $ >
  $ G ⇒ ra_minors td tnp tn ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ tt tN ∈ lrel $ >
  $ G ⇒ tp ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tM ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ tN ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ ra_lams tp tR2 tR ∈ lrel $ >
  $ G ⇒ ra_lams tM tR1 tR2 ∈ lrel $ >
  $ G ⇒ ra_lams tN tVal tR1 ∈ lrel $ >
  $ G ⇒ ∀ j (j ∊ trees ω → fv nvf j ∈ fv nvf tn → ∃ b ∃ e ∃ m ∃ q (ra_nth_ty tt j b e ∈ lrel ∧ ra_isort b m q ∈ lrel ∧ ra_nidx td j m ∈ lrel)) $ >
