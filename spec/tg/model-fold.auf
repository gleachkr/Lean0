l4: $ G , ⟨ fv nvf ti , ⟨ q4 , x ⟩ ⟩ ∈ zc ∧ apn (fv pg (fv nvf th)) q1 = {y | ¬ iprop td (fv nvf ti) w ∧ y ∊ x} ∧ ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e p ⇒ ∀ a ∀ x ∀ e ∀ m (⟨ fv nvf ti , ⟨ a , x ⟩ ⟩ ∈ zc → a = scat e p → ra_nidx td ti m ∈ lrel → e ∊ fseq {y | y = y} → cdm e = fv nvf m → ∃ v (v ∊ u ∧ ∀ o (⟨ ⟨ fv nvf ti , ⟨ a , {y | ¬ iprop td (fv nvf ti) w ∧ y ∊ x} ⟩ ⟩ , o ⟩ ∈ L ↔ o = v))) $ by all_elim [l3]
