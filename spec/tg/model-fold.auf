l57: $ G , l = ixs td w zc , r = scat p l , o ∊ fseq u ∧ fv t (fv nvf th) = etel u (dnf u (mcv H)) ta w o ∧ fv g (fv nvf th) ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf th) i) = fv r i) , v = fv g (fv nvf th) , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin o (fv nvf th) (fv nvf te)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf te) ⇒ i ∊ fv nvf te → fv o (nadd (fv nvf th) i) = fv r (nadd ∅ i) $ by imp_intro [l56]
l58: $ G , l = ixs td w zc , r = scat p l , o ∊ fseq u ∧ fv t (fv nvf th) = etel u (dnf u (mcv H)) ta w o ∧ fv g (fv nvf th) ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf th) i) = fv r i) , v = fv g (fv nvf th) , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin o (fv nvf th) (fv nvf te)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf te) ⇒ ∀ i (i ∊ fv nvf te → fv o (nadd (fv nvf th) i) = fv r (nadd ∅ i)) $ by all_intro [l57]
l59: $ G , l = ixs td w zc , r = scat p l , o ∊ fseq u ∧ fv t (fv nvf th) = etel u (dnf u (mcv H)) ta w o ∧ fv g (fv nvf th) ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf th) i) = fv r i) , v = fv g (fv nvf th) , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin o (fv nvf th) (fv nvf te)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf te) ⇒ swin o (fv nvf th) (fv nvf te) = swin r ∅ (fv nvf te) $ by swin_sh [l58]
l60: $ G , l = ixs td w zc , r = scat p l , o ∊ fseq u ∧ fv t (fv nvf th) = etel u (dnf u (mcv H)) ta w o ∧ fv g (fv nvf th) ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf th) i) = fv r i) , v = fv g (fv nvf th) , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin o (fv nvf th) (fv nvf te)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf te) ⇒ p ∊ esat u (dnf u (mcv H)) tp w $ by weaken [#5]
l61: $ G , l = ixs td w zc , r = scat p l , o ∊ fseq u ∧ fv t (fv nvf th) = etel u (dnf u (mcv H)) ta w o ∧ fv g (fv nvf th) ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf th) i) = fv r i) , v = fv g (fv nvf th) , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin o (fv nvf th) (fv nvf te)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf te) ⇒ esat u (dnf u (mcv H)) tp w ⊆ fseq u $ by esat_fseq
l62: $ G , l = ixs td w zc , r = scat p l , o ∊ fseq u ∧ fv t (fv nvf th) = etel u (dnf u (mcv H)) ta w o ∧ fv g (fv nvf th) ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf th) i) = fv r i) , v = fv g (fv nvf th) , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin o (fv nvf th) (fv nvf te)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf te) ⇒ p ∊ fseq u $ by subset_elim [l61, l60]
l63: $ G , l = ixs td w zc , r = scat p l , o ∊ fseq u ∧ fv t (fv nvf th) = etel u (dnf u (mcv H)) ta w o ∧ fv g (fv nvf th) ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf th) i) = fv r i) , v = fv g (fv nvf th) , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin o (fv nvf th) (fv nvf te)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf te) ⇒ ra_clen tp te ∈ lrel $ by weaken [#4]
l64: $ G , l = ixs td w zc , r = scat p l , o ∊ fseq u ∧ fv t (fv nvf th) = etel u (dnf u (mcv H)) ta w o ∧ fv g (fv nvf th) ∈ dt u (mcv H) ta w o ∧ ∀ i (i ∊ ω → fv o (nadd (fv nvf th) i) = fv r i) , v = fv g (fv nvf th) , ra_nidx td ti m ∈ lrel ∧ e ∊ fseq {y | y = y} ∧ cdm e = fv nvf m ∧ q4 = scat e (swin o (fv nvf th) (fv nvf te)) ∧ cdm q4 = nadd (fv nvf m) (fv nvf te) ⇒ tp ∊ trees ω $ by weaken [l6]
