def f1_np (.s .z: set): class = $ {s | ∀ z (¬ z = ∅ → ¬ nest s z = ∅)} $

lemma f1_np_all (G: hyps) (A: class): $ G ⇒ fseq A ⊆ f1_np $
----
p1: $ G , d = ∅ , ¬ z = ∅ ⇒ d = ∅ $ by ax
p2: $ G , d = ∅ , ¬ z = ∅ ⇒ isset z $ by isset_var
p2r: $ G , d = ∅ , ¬ z = ∅ ⇒ z = z $ by eq_refl
p3: $ … ⇒ nest ∅ z = z $ by nest_empty [p2]
p4: $ … ⇒ nest d z = z $ by eq_trans [nest_eq [p1, p2r], p3]
q1: $ G , d = ∅ , ¬ z = ∅ , nest d z = ∅ ⇒ nest d z = ∅ $ by ax
q2: $ G , d = ∅ , ¬ z = ∅ , nest d z = ∅ ⇒ nest d z = z $ by weaken [p4]
q4: $ G , d = ∅ , ¬ z = ∅ , nest d z = ∅ ⇒ ¬ z = ∅ $ by ax
q5: $ … ⇒ ⊥ $ by not_elim [q4, eq_trans [eq_sym [q2], q1]]
q6: $ G , d = ∅ , ¬ z = ∅ ⇒ ¬ nest d z = ∅ $ by not_intro [q5]
p6: $ G , d = ∅ ⇒ ¬ z = ∅ → ¬ nest d z = ∅ $ by imp_intro [q6]
p7: $ G , d = ∅ ⇒ ∀ z (¬ z = ∅ → ¬ nest d z = ∅) $ by all_intro [p6]
p8: $ G , d = ∅ ⇒ d ∊ f1_np $ by cab_intro [p7]
p9: $ G , d = ∅ ⇒ d = ∅ $ by ax
p10: $ … ⇒ ∅ ∈ f1_np $ by wcel_intro [p9, p8]
p0: $ G ⇒ isset ∅ $ by ax_empty
p11: $ G ⇒ ∅ ∈ f1_np $ by isset_elim [p0, p10]
s1: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ y ∊ f1_np $ by ax
s2: $ … ⇒ ∀ z (¬ z = ∅ → ¬ nest y z = ∅) $ by cab_elim [s1]
s3: $ … ⇒ ¬ w = ∅ → ¬ nest y w = ∅ $ by all_elim [s2]
s4a: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ , w = ∅ ⇒ w = ∅ $ by ax
s4b: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ , w = ∅ ⇒ w = ⟨ x , z ⟩ $ by ax
s4c: $ … ⇒ ⊥ $ by opair_ne_empty [eq_trans [eq_sym [s4b], s4a]]
s4: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ ¬ w = ∅ $ by not_intro [s4c]
s5: $ … ⇒ ¬ nest y w = ∅ $ by imp_elim [s3, s4]
s6a: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ y ∊ fseq A $ by ax
s6b: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ isset z $ by isset_var
s6: $ … ⇒ nest (scons x y) z = nest y ⟨ x , z ⟩ $ by nest_scons [s6a, s6b]
s7a: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ d = scons x y $ by ax
s7b: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ z = z $ by eq_refl
s7c: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ y = y $ by eq_refl
s7d: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ w = ⟨ x , z ⟩ $ by ax
s7: $ … ⇒ nest d z = nest y w $ by eq_trans [nest_eq [s7a, s7b], eq_trans [s6, nest_eq [s7c, eq_sym [s7d]]]]
s8a: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ , nest d z = ∅ ⇒ nest d z = ∅ $ by ax
s8b: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ , nest d z = ∅ ⇒ nest d z = nest y w $ by weaken [s7]
s8c: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ , nest d z = ∅ ⇒ ¬ nest y w = ∅ $ by weaken [s5]
s8d: $ … ⇒ ⊥ $ by not_elim [s8c, eq_trans [eq_sym [s8b], s8a]]
s8: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ , w = ⟨ x , z ⟩ ⇒ ¬ nest d z = ∅ $ by not_intro [s8d]
s9a: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ ⇒ isset ⟨ x , z ⟩ $ by opair_isset
s9: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y , ¬ z = ∅ ⇒ ¬ nest d z = ∅ $ by isset_elim [s9a, s8]
s10: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y ⇒ ¬ z = ∅ → ¬ nest d z = ∅ $ by imp_intro [s9]
s11: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y ⇒ ∀ z (¬ z = ∅ → ¬ nest d z = ∅) $ by all_intro [s10]
s12: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y ⇒ d ∊ f1_np $ by cab_intro [s11]
s13: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np , d = scons x y ⇒ d = scons x y $ by ax
s14: $ … ⇒ scons x y ∈ f1_np $ by wcel_intro [s13, s12]
s15a: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np ⇒ isset y $ by isset_var
s15b: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np ⇒ isset (scons x y) $ by scons_set [s15a]
s15: $ G , x ∊ A , y ∊ fseq A , y ∊ f1_np ⇒ scons x y ∈ f1_np $ by isset_elim [s15b, s14]
s16: $ G ⇒ x ∊ A → y ∊ fseq A → y ∊ f1_np → scons x y ∈ f1_np $ by imp_intro [imp_intro [imp_intro [s15]]]
s17: $ G ⇒ ∀ x ∀ y (x ∊ A → y ∊ fseq A → y ∊ f1_np → scons x y ∈ f1_np) $ by all_intro [all_intro [s16]]
fin: $ G ⇒ fseq A ⊆ f1_np $ by fseq_ind [p11, s17]

nest_nempty
-----------
l1: $ G ⇒ fseq A ⊆ f1_np $ by f1_np_all
l2: $ … ⇒ s ∊ f1_np $ by subset_elim [l1, #1]
l3: $ … ⇒ ∀ z (¬ z = ∅ → ¬ nest s z = ∅) $ by cab_elim [l2]
l3w: $ G , y = Y ⇒ ∀ z (¬ z = ∅ → ¬ nest s z = ∅) $ by weaken [l3]
l4: $ … ⇒ ¬ y = ∅ → ¬ nest s y = ∅ $ by all_elim [l3w]
l5: $ G , y = Y ⇒ y = Y $ by ax
l6: $ G , y = Y ⇒ ¬ Y = ∅ $ by weaken [#3]
l7a: $ G , y = Y , y = ∅ ⇒ y = ∅ $ by ax
l7b: $ G , y = Y , y = ∅ ⇒ y = Y $ by ax
l7c: $ G , y = Y , y = ∅ ⇒ ¬ Y = ∅ $ by weaken [#3]
l7d: $ … ⇒ ⊥ $ by not_elim [l7c, eq_trans [eq_sym [l7b], l7a]]
l9: $ G , y = Y ⇒ ¬ y = ∅ $ by not_intro [l7d]
l10: $ … ⇒ ¬ nest s y = ∅ $ by imp_elim [l4, l9]
m1: $ G , y = Y , nest s Y = ∅ ⇒ nest s Y = ∅ $ by ax
m2: $ G , y = Y , nest s Y = ∅ ⇒ y = Y $ by ax
m3: $ G , y = Y , nest s Y = ∅ ⇒ s = s $ by eq_refl
m4: $ G , y = Y , nest s Y = ∅ ⇒ ¬ nest s y = ∅ $ by weaken [l10]
m5: $ … ⇒ ⊥ $ by not_elim [m4, eq_trans [nest_eq [m3, m2], m1]]
m6: $ G , y = Y ⇒ ¬ nest s Y = ∅ $ by not_intro [m5]
fin: $ G ⇒ ¬ nest s Y = ∅ $ by isset_elim [#2, m6]

