l69: $ G ⇒ h = h2 $ by fpi_ext [l1, l2, l68]

lemma f4_val {y o: set} (G: hyps) (L F: class) (u: set): $ G ⇒ ∃ y (y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y)) $ > $ G ⇒ ∃ y (y ∊ u ∧ fv L F = y ∧ ⟨ F , y ⟩ ∈ L) $
----
l1: $ G , y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) ⇒ y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) $ by ax
l2: $ … ⇒ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) $ by and_elim_r [l1]
l3: $ G , y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) ⇒ isset y $ by isset_var
l4: $ … ⇒ fv L F = y $ by fv_iff [l2, l3]
l5: $ … ⇒ ⟨ F , y ⟩ ∈ L ↔ y = y $ by all_elim [l2]
l6: $ G , y ∊ u ∧ ∀ o (⟨ F , o ⟩ ∈ L ↔ o = y) ⇒ y = y $ by eq_refl
l7: $ … ⇒ ⟨ F , y ⟩ ∈ L $ by bi_elim_r [l5, l6]
l8: $ … ⇒ y ∊ u ∧ fv L F = y ∧ ⟨ F , y ⟩ ∈ L $ by and_intro [and_elim_l [l1], and_intro [l4, l7]]
l9: $ … ⇒ ∃ y (y ∊ u ∧ fv L F = y ∧ ⟨ F , y ⟩ ∈ L) $ by ex_intro [l8]
l10: $ G ⇒ ∃ y (y ∊ u ∧ fv L F = y ∧ ⟨ F , y ⟩ ∈ L) $ by ex_elim [#1, l9]

lemma f4_sp {q b c e y o h: set} (G: hyps) (E L g t d j A: class) (u w r n: set):
  $ G ⇒ universe u $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ fv t d = etel u E A w r $ >
  $ G ⇒ ∀ q ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → ∃ y (y ∊ u ∧ ∀ o (⟨ ⟨ j , ⟨ e , apn (fv g d) q ⟩ ⟩ , o ⟩ ∈ L ↔ o = y))) $ >
  $ G ⇒ ∀ q ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → cdm q = n) $ >
  $ G ⇒ ∃ h (h ∊ ihsp L g t d j) $
----
l1: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} ⇒ x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} $ by ax
l2: $ … ⇒ ∃ b ∃ c ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) $ by cab_elim [l1]
l3: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ⇒ ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d $ by ax
l4: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ⇒ fv t d = etel u E A w r $ by weaken [#3]
l5: $ … ⇒ ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ etel u E A w r $ by wcel_eq_r [l4, l3]
l6: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ⇒ A ∈ trees ω $ by weaken [#2]
l7: $ … ⇒ x ∊ fseq u $ by and_elim_l [etel_fseq [l6, l5]]
l8: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) ⇒ ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) $ by ax
l9: $ … ⇒ x ∊ fseq u $ by ex_elim [l8, l7]
l10: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ∃ c ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) ⇒ ∃ c ∃ e (⟨ x , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) $ by ax
l11: $ … ⇒ x ∊ fseq u $ by ex_elim [l10, l9]
l12: $ G , x ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} ⇒ x ∊ fseq u $ by ex_elim [l2, l11]
l13: $ G ⇒ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} ⊆ fseq u $ by subset_intro [l12]
l14: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} ⇒ q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} $ by ax
l15: $ … ⇒ ∃ b ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) $ by cab_elim [l14]
l16: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d $ by ax
l17: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d ⇒ ∀ q ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → cdm q = n) $ by weaken [#5]
l18: $ … ⇒ ∀ b ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → cdm q = n) $ by all_elim [l17]
l19: $ … ⇒ ∀ c ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → cdm q = n) $ by all_elim [l18]
l20: $ … ⇒ ∀ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → cdm q = n) $ by all_elim [l19]
l21: $ … ⇒ ⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d → cdm q = n $ by all_elim [l20]
l22: $ … ⇒ cdm q = n $ by imp_elim [l21, l16]
l23: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) ⇒ ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) $ by ax
l24: $ … ⇒ cdm q = n $ by ex_elim [l23, l22]
l25: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} , ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) ⇒ ∃ c ∃ e (⟨ q , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d) $ by ax
l26: $ … ⇒ cdm q = n $ by ex_elim [l25, l24]
l27: $ G , q ∊ {z | ∃ b ∃ c ∃ e (⟨ z , ⟨ b , ⟨ c , e ⟩ ⟩ ⟩ ∈ fv t d)} ⇒ cdm q = n $ by ex_elim [l15, l26]
