l32: $ G , ∃ f (iprt D a b ∧ fv nvf d = j ∧ fv nvf e = c ∧ fv nvf f = k ∧ ra_minor_idx b d e f ∈ lrel) ⇒ ∃ f (iprt D a b ∧ fv nvf d = j ∧ fv nvf e = c ∧ fv nvf f = k ∧ ra_minor_idx b d e f ∈ lrel) $ by ax
l33: $ … ⇒ k ∈ inmin D $ by ex_elim [l32, l31]
l34: $ G , ∃ e ∃ f (iprt D a b ∧ fv nvf d = j ∧ fv nvf e = c ∧ fv nvf f = k ∧ ra_minor_idx b d e f ∈ lrel) ⇒ ∃ e ∃ f (iprt D a b ∧ fv nvf d = j ∧ fv nvf e = c ∧ fv nvf f = k ∧ ra_minor_idx b d e f ∈ lrel) $ by ax
l35: $ … ⇒ k ∈ inmin D $ by ex_elim [l34, l33]
l36: $ G , ∃ d ∃ e ∃ f (iprt D a b ∧ fv nvf d = j ∧ fv nvf e = c ∧ fv nvf f = k ∧ ra_minor_idx b d e f ∈ lrel) ⇒ ∃ d ∃ e ∃ f (iprt D a b ∧ fv nvf d = j ∧ fv nvf e = c ∧ fv nvf f = k ∧ ra_minor_idx b d e f ∈ lrel) $ by ax
l37: $ … ⇒ k ∈ inmin D $ by ex_elim [l36, l35]
l38: $ G , ∃ b ∃ d ∃ e ∃ f (iprt D a b ∧ fv nvf d = j ∧ fv nvf e = c ∧ fv nvf f = k ∧ ra_minor_idx b d e f ∈ lrel) ⇒ ∃ b ∃ d ∃ e ∃ f (iprt D a b ∧ fv nvf d = j ∧ fv nvf e = c ∧ fv nvf f = k ∧ ra_minor_idx b d e f ∈ lrel) $ by ax
l39: $ … ⇒ k ∈ inmin D $ by ex_elim [l38, l37]
l40: $ G ⇒ k ∈ inmin D $ by ex_elim [l1, l39]

def f3_V (.x: set): class = $ {x | x = x} $

def f3_hq (D K L g t: class) (.n: set): class = $ {n | ihv D K L g t n ⊆ fseq f3_V} $

lemma f3_hq_all {a: set} (G: hyps) (D K L g t: class): $ G ⇒ isset t $ > $ G ⇒ ∀ a (isset (ap L a)) $ > $ G ⇒ ω ⊆ f3_hq D K L g t $
----
l1: $ G , x ∊ ihv D K L g t ∅ ⇒ ihv D K L g t ∅ = csn ∅ $ by ihv_zero
l2: $ G , x ∊ ihv D K L g t ∅ ⇒ x ∊ ihv D K L g t ∅ $ by ax
l3: $ … ⇒ x ∊ csn ∅ $ by welc_eq [l1, l2]
l4: $ … ⇒ x = ∅ $ by csn_elim [l3]
l5: $ G , x ∊ ihv D K L g t ∅ ⇒ ∅ ∈ fseq f3_V $ by fseq_empty
l6: $ … ⇒ x ∊ fseq f3_V $ by wcel_welc [wcel_eq_l [eq_sym [l4], l5]]
l7: $ G ⇒ ihv D K L g t ∅ ⊆ fseq f3_V $ by subset_intro [l6]
l8: $ G ⇒ isset ∅ $ by ax_empty
l9: $ G , n = ∅ ⇒ n = ∅ $ by ax
l10: $ G , n = ∅ ⇒ ihv D K L g t ∅ ⊆ fseq f3_V $ by weaken [l7]
l11: $ … ⇒ ihv D K L g t n ⊆ fseq f3_V $ by subset_eq_l [ihv_eq_arg [eq_sym [l9]], l10]
l12: $ G , n = ∅ ⇒ n ∊ f3_hq D K L g t $ by cab_intro [l11]
l13: $ … ⇒ ∅ ∈ f3_hq D K L g t $ by wcel_intro [l9, l12]
l14: $ G ⇒ ∅ ∈ f3_hq D K L g t $ by isset_elim [l8, l13]
l15: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t ⇒ x ∊ ω ∧ x ∊ f3_hq D K L g t $ by ax
l16: $ … ⇒ x ∊ ω $ by and_elim_l [l15]
l17: $ … ⇒ ihv D K L g t x ⊆ fseq f3_V $ by cab_elim [and_elim_r [l15]]
l18: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t ⇒ (∃ i (irf D K x i)) ∨ ¬ ∃ i (irf D K x i) $ by excluded_middle
l19: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , ¬ ∃ i (irf D K x i) ⇒ x ∊ ω $ by weaken [l16]
l20: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , ¬ ∃ i (irf D K x i) ⇒ ¬ ∃ i (irf D K x i) $ by ax
l21: $ … ⇒ ihv D K L g t (suc x) = ihv D K L g t x $ by ihv_suc_nr [l19, l20]
l22: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , ¬ ∃ i (irf D K x i) ⇒ ihv D K L g t x ⊆ fseq f3_V $ by weaken [l17]
l23: $ … ⇒ ihv D K L g t (suc x) ⊆ fseq f3_V $ by subset_eq_l [eq_sym [l21], l22]
l24: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i ⇒ isset t $ by weaken [#1]
l25: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i ⇒ ∀ a (isset (ap L a)) $ by weaken [#2]
l26: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i ⇒ x ∊ ω $ by weaken [l16]
l27: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i ⇒ irf D K x i $ by ax
l28: $ … ⇒ ihv D K L g t (suc x) = {y | ∃ h ∃ z (z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ y = scons h z)} $ by ihv_suc_rec [l24, l25, l26, l27]
l29: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i , b ∊ ihv D K L g t (suc x) ⇒ b ∊ ihv D K L g t (suc x) $ by ax
l30: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i , b ∊ ihv D K L g t (suc x) ⇒ ihv D K L g t (suc x) = {y | ∃ h ∃ z (z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ y = scons h z)} $ by weaken [l28]
l31: $ … ⇒ ∃ h ∃ z (z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ b = scons h z) $ by cab_elim [welc_eq [l30, l29]]
l32: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i , b ∊ ihv D K L g t (suc x) , z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ b = scons h z ⇒ z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ b = scons h z $ by ax
l33: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i , b ∊ ihv D K L g t (suc x) , z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ b = scons h z ⇒ ihv D K L g t x ⊆ fseq f3_V $ by weaken [l17]
l34: $ … ⇒ z ∊ fseq f3_V $ by subset_elim [l33, and_elim_l [l32]]
l35: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i , b ∊ ihv D K L g t (suc x) , z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ b = scons h z ⇒ h = h $ by eq_refl
l36: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i , b ∊ ihv D K L g t (suc x) , z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ b = scons h z ⇒ h ∊ {x | x = x} $ by cab_intro [l35]
l37: $ … ⇒ scons h z ∈ fseq f3_V $ by scons_fseq [l36, l34]
l38: $ … ⇒ b ∊ fseq f3_V $ by wcel_welc [wcel_eq_l [eq_sym [and_elim_r [and_elim_r [l32]]], l37]]
l39: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i , b ∊ ihv D K L g t (suc x) , ∃ z (z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ b = scons h z) ⇒ ∃ z (z ∊ ihv D K L g t x ∧ h ∊ ihsp L g t x i ∧ b = scons h z) $ by ax
l40: $ … ⇒ b ∊ fseq f3_V $ by ex_elim [l39, l38]
l41: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i , b ∊ ihv D K L g t (suc x) ⇒ b ∊ fseq f3_V $ by ex_elim [l31, l40]
l42: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , irf D K x i ⇒ ihv D K L g t (suc x) ⊆ fseq f3_V $ by subset_intro [l41]
l43: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , ∃ i (irf D K x i) ⇒ ∃ i (irf D K x i) $ by ax
l44: $ … ⇒ ihv D K L g t (suc x) ⊆ fseq f3_V $ by ex_elim [l43, l42]
l45: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t ⇒ ihv D K L g t (suc x) ⊆ fseq f3_V $ by or_elim [l18, l44, l23]
l46: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t ⇒ isset (suc x) $ by wcel_isset [omega_suc [l16]]
l47: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , n = suc x ⇒ n = suc x $ by ax
l48: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , n = suc x ⇒ ihv D K L g t (suc x) ⊆ fseq f3_V $ by weaken [l45]
l49: $ … ⇒ ihv D K L g t n ⊆ fseq f3_V $ by subset_eq_l [ihv_eq_arg [eq_sym [l47]], l48]
l50: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t , n = suc x ⇒ n ∊ f3_hq D K L g t $ by cab_intro [l49]
l51: $ … ⇒ suc x ∈ f3_hq D K L g t $ by wcel_intro [l47, l50]
l52: $ G , x ∊ ω ∧ x ∊ f3_hq D K L g t ⇒ suc x ∈ f3_hq D K L g t $ by isset_elim [l46, l51]
l53: $ G ⇒ x ∊ ω ∧ x ∊ f3_hq D K L g t → suc x ∈ f3_hq D K L g t $ by imp_intro [l52]
l54: $ G ⇒ ∀ x (x ∊ ω ∧ x ∊ f3_hq D K L g t → suc x ∈ f3_hq D K L g t) $ by all_intro [l53]
l55: $ G ⇒ ω ⊆ f3_hq D K L g t $ by omega_ind [l14, l54]

lemma f3_ihv_fseq {a: set} (G: hyps) (D K L g t N: class): $ G ⇒ isset t $ > $ G ⇒ ∀ a (isset (ap L a)) $ > $ G ⇒ N ∈ ω $ > $ G ⇒ ihv D K L g t N ⊆ fseq f3_V $
----
l1: $ … ⇒ ω ⊆ f3_hq D K L g t $ by f3_hq_all [#1, #2]
l2: $ G , n = N ⇒ n = N $ by ax
l3: $ G , n = N ⇒ N ∈ ω $ by weaken [#3]
l4: $ G , n = N ⇒ ω ⊆ f3_hq D K L g t $ by weaken [l1]
l5: $ … ⇒ n ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [l2], l3]]
l6: $ … ⇒ n ∊ f3_hq D K L g t $ by subset_elim [l4, l5]
l7: $ … ⇒ ihv D K L g t n ⊆ fseq f3_V $ by cab_elim [l6]
l8: $ … ⇒ ihv D K L g t N ⊆ fseq f3_V $ by subset_eq_l [ihv_eq_arg [l2], l7]
l9: $ G ⇒ isset N $ by wcel_isset [#3]
l10: $ G ⇒ ihv D K L g t N ⊆ fseq f3_V $ by isset_elim [l9, l8]

ictk_tree
---------
l1: $ G , iprt D p t ∧ fv nvf n = I ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ iprt D p t ∧ fv nvf n = I ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel $ by ax
l2: $ G , iprt D p t ∧ fv nvf n = I ∧ ra_nth_ty t n f e ∈ lrel ∧ fv nvf m = C ∧ ra_nth_ctor e m K ∈ lrel ⇒ kr_nth_ctor ∈ ω $ by kr_nth_ctor_omega
l3: $ … ⇒ e ∈ trees ω ∧ m ∈ trees ω ∧ K ∈ trees ω $ by lrel_args3_c [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l1]]]], wcel_isset [l2]]
l4: $ … ⇒ K ∈ trees ω $ by and_elim_r [and_elim_r [l3]]
l5: $ G ⇒ K ∈ trees ω $ by ictk_elim [#1, l4]

ifold_imrel
-----------
