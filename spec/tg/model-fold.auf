t18: $ … ⇒ ⊥ $ by not_elim [t12, t17]
u1: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n , m = fv cv k , z = ∅ , q ∊ imq u E D c w p ∧ z = nest q y , ityf D c o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o w p , x ∊ apn (ity u E D c w) (scat f p) , q = scons x f ⇒ ityf D c o $ by ax
u2: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n , m = fv cv k , z = ∅ , q ∊ imq u E D c w p ∧ z = nest q y , ityf D c o , ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E o w p , x ∊ apn (ity u E D c w) (scat f p) , q = scons x f ⇒ ⊥ $ by ityf_elim [u1, t18]
s0: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n , m = fv cv k , z = ∅ , q ∊ imq u E D c w p ∧ z = nest q y ⇒ q ∊ imq u E D c w p ∧ z = nest q y $ by ax
u3: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n , m = fv cv k , z = ∅ , q ∊ imq u E D c w p ∧ z = nest q y ⇒ ⊥ $ by imq_elim [and_elim_l [s0], u2]
v1: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n , m = fv cv k , z = ∅ , ∃ y (q ∊ imq u E D c w p ∧ z = nest q y) ⇒ ∃ y (q ∊ imq u E D c w p ∧ z = nest q y) $ by ax
v2: $ … ⇒ ⊥ $ by ex_elim [v1, u3]
v3: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n , m = fv cv k , z = ∅ ⇒ ⊥ $ by ex_elim [r7, v2]
w1: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n , m = fv cv k ⇒ isset ∅ $ by ax_empty
w2: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n , m = fv cv k ⇒ ⊥ $ by isset_elim [w1, v3]
w3: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n ⇒ isset (fv cv k) $ by wcel_isset [q10]
w4: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D , c ∊ ω ∧ nadd k (suc c) = n ⇒ ⊥ $ by isset_elim [w3, w2]
w5: $ G , k ∊ cdm cv , ∅ ∈ fv cv k , n = intys D ⇒ ⊥ $ by ex_elim [p7, w4]
w6: $ G , k ∊ cdm cv , ∅ ∈ fv cv k ⇒ intys D ∈ ω $ by intys_omega
w6b: $ G , k ∊ cdm cv , ∅ ∈ fv cv k ⇒ isset (intys D) $ by wcel_isset [w6]
w7: $ G , k ∊ cdm cv , ∅ ∈ fv cv k ⇒ ⊥ $ by isset_elim [w6b, w5]
w8: $ G , k ∊ cdm cv ⇒ ¬ ∅ ∈ fv cv k $ by not_intro [w7]
fin: $ G ⇒ ¬ ∅ ∈ fv cv k $ by or_elim [em, w8, n12]

imots_imrel_set
---------------
a2: $ G ⇒ isset cv $ by isset_var
a3: $ … ⇒ ¬ ∅ ∈ fv cv k $ by imots_pts [#1]
a4: $ … ⇒ ∀ k (¬ ∅ ∈ fv cv k) $ by all_intro [a3]
a5: $ … ⇒ ∀ e (isset (ap (imrel D cv) e)) $ by imrel_set [a2, a4]

lemma f2_zs (G: hyps) (A: class): $ G ⇒ A ∈ ω $ > $ G ⇒ ∅ ∈ suc A $
----
e: $ G , a = suc A ⇒ a = suc A $ by ax
w: $ G , a = suc A ⇒ A ∈ ω $ by weaken [#1]
s: $ … ⇒ suc A ∈ ω $ by omega_suc_c [w]
ao: $ … ⇒ a ∊ ω $ by wcel_welc [wcel_eq_l [eq_sym [e], s]]
or: $ … ⇒ ∅ ∈ a ∨ ∅ = a $ by omega_zero_le [ao]
c1: $ G , a = suc A , ∅ ∈ a ⇒ ∅ ∈ a $ by ax
c1e: $ G , a = suc A , ∅ ∈ a ⇒ a = suc A $ by ax
c1f: $ … ⇒ ∅ ∈ suc A $ by wcel_eq_r [c1e, c1]
c2: $ G , a = suc A , ∅ = a ⇒ ∅ = a $ by ax
c2e: $ G , a = suc A , ∅ = a ⇒ a = suc A $ by ax
c2b: $ … ⇒ ⊥ $ by suc_ne_empty [eq_sym [eq_trans [c2, c2e]]]
c2f: $ … ⇒ ∅ ∈ suc A $ by bot_elim [c2b]
f: $ G , a = suc A ⇒ ∅ ∈ suc A $ by or_elim [or, c1f, c2f]
is: $ G ⇒ isset (suc A) $ by wcel_isset [omega_suc_c [#1]]
l15: $ G ⇒ ∅ ∈ suc A $ by isset_elim [is, f]

lemma f2_clen {l: set} (G: hyps) (tz tn ta tb: set): $ G ⇒ ra_clen_c tz tn ∈ lrel $ > $ G ⇒ tz = ⟨ kc_ccons , scons ta (scons tb ∅) ⟩ $ > $ G ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c tb l ∈ lrel) $
----
l1: $ … ⇒ (tz = ⟨ kc_cnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 (tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) $ by lrel_clen_c_cases [#1]
l2: $ G , tz = ⟨ kc_cnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ⇒ tz = ⟨ kc_cnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ G , tz = ⟨ kc_cnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ⇒ tz = ⟨ kc_ccons , scons ta (scons tb ∅) ⟩ $ by weaken [#2]
l4: $ … ⇒ ⟨ kc_cnil , ∅ ⟩ = ⟨ kc_ccons , scons ta (scons tb ∅) ⟩ $ by eq_trans [eq_sym [and_elim_l [l2]], l3]
l5: $ G , tz = ⟨ kc_cnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cnil ∈ ω $ by kc_cnil_omega
l6: $ G , tz = ⟨ kc_cnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
l7: $ … ⇒ kc_cnil = kc_ccons $ by opair_inj_l_c [l4, wcel_isset [l5], wcel_isset [l6]]
l8: $ G , tz = ⟨ kc_cnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_cnil = kc_ccons $ by kc_cnil_ne_ccons
l9: $ … ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c tb l ∈ lrel) $ by bot_elim [not_elim [l8, l7]]
l10: $ G , tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel $ by ax
l11: $ G , tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ tz = ⟨ kc_ccons , scons ta (scons tb ∅) ⟩ $ by weaken [#2]
l12: $ … ⇒ ⟨ kc_ccons , scons ta (scons tb ∅) ⟩ = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by eq_trans [eq_sym [l11], and_elim_l [l10]]
l13: $ G , tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
l14: $ … ⇒ ta = x1 ∧ tb = x2 $ by node2_inj [wcel_isset [l13], l12]
l15: $ G , tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel ⇒ x3 = x3 $ by eq_refl
l16: $ … ⇒ ra_clen_c tb x3 ∈ lrel $ by wcel_eq_l [ra_clen_c_eq [eq_sym [and_elim_r [l14]], l15], and_elim_r [and_elim_r [l10]]]
l17: $ … ⇒ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c tb x3 ∈ lrel $ by and_intro [and_elim_l [and_elim_r [l10]], l16]
l18: $ … ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c tb l ∈ lrel) $ by ex_intro [l17]
l19: $ G , ∃ x3 (tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ x3 (tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) $ by ax
l20: $ … ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c tb l ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , ∃ x2 ∃ x3 (tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ x2 ∃ x3 (tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) $ by ax
l22: $ … ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c tb l ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , ∃ x1 ∃ x2 ∃ x3 (tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 (tz = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tn = ⟨ kc_s , scons x3 ∅ ⟩ ∧ ra_clen_c x2 x3 ∈ lrel) $ by ax
l24: $ … ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c tb l ∈ lrel) $ by ex_elim [l23, l22]
l25: $ … ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c tb l ∈ lrel) $ by or_elim [l1, l9, l24]

def f2_cq (K: class) (.y .c .n: set): class = $ {y | ∀ c ∀ n (ra_nth_ctor y c K ∈ lrel → ra_clen_c y n ∈ lrel → fv nvf c ∈ fv nvf n)} $

lemma f2_cq_e (G: hyps) (tk ty tc tn: set): $ G ⇒ ty ∊ f2_cq tk $ > $ G ⇒ ra_nth_ctor ty tc tk ∈ lrel $ > $ G ⇒ ra_clen_c ty tn ∈ lrel $ > $ G ⇒ fv nvf tc ∈ fv nvf tn $
----
l1: $ … ⇒ ∀ c ∀ n (ra_nth_ctor ty c tk ∈ lrel → ra_clen_c ty n ∈ lrel → fv nvf c ∈ fv nvf n) $ by cab_elim [#1]
l2: $ … ⇒ ∀ n (ra_nth_ctor ty tc tk ∈ lrel → ra_clen_c ty n ∈ lrel → fv nvf tc ∈ fv nvf n) $ by all_elim [l1]
l3: $ … ⇒ ra_nth_ctor ty tc tk ∈ lrel → ra_clen_c ty tn ∈ lrel → fv nvf tc ∈ fv nvf tn $ by all_elim [l2]
l4: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by imp_elim [imp_elim [l3, #2], #3]

lemma f2_cq_node (G: hyps) (tk ty tc tn k1 j1: set): $ G ⇒ crn j1 ⊆ f2_cq tk $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_nth_ctor ty tc tk ∈ lrel $ > $ G ⇒ ra_clen_c ty tn ∈ lrel $ > $ G ⇒ fv nvf tc ∈ fv nvf tn $
----
l1: $ … ⇒ ∃ x1 ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1) ∨ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by lrel_nth_ctor_cases [#3]
l2: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 ⇒ ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 $ by ax
l3: $ … ⇒ ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [l2]
l4: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 ⇒ ra_clen_c ty tn ∈ lrel $ by weaken [#4]
l5: $ … ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel) $ by f2_clen [l4, l3]
l6: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel $ by ax
l7: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ kr_clen_c ∈ ω $ by kr_clen_c_omega
l8: $ … ⇒ x2 ∊ trees ω ∧ l ∊ trees ω $ by lrel_args2 [and_elim_r [l6], wcel_isset [l7]]
l9: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ nvf = nvf $ by eq_refl
l10: $ … ⇒ fv nvf tn = fv nvf ⟨ kc_s , scons l ∅ ⟩ $ by fv_eq [l9, and_elim_l [l6]]
l11: $ … ⇒ fv nvf ⟨ kc_s , scons l ∅ ⟩ = suc (fv nvf l) $ by nvf_s [welc_wcel [and_elim_r [l8]]]
l12: $ … ⇒ fv nvf tn = suc (fv nvf l) $ by eq_trans [l10, l11]
l13: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ isset l $ by isset_var
l14: $ … ⇒ fv nvf l ∈ ω $ by nvf_omega [l13]
l15: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 $ by ax
l16: $ … ⇒ fv nvf tc = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [l9, and_elim_l [and_elim_r [l15]]]
l17: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l18: $ … ⇒ ∅ ∈ suc (fv nvf l) $ by f2_zs [l14]
l19: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by wcel_eq_l [eq_sym [eq_trans [l16, l17]], wcel_eq_r [eq_sym [l12], l18]]
l20: $ G , ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1 ⇒ fv nvf tc ∈ fv nvf tn $ by ex_elim [l5, l19]
l21: $ G , ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1) ⇒ ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1) $ by ax
l22: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by ex_elim [l21, l20]
l23: $ G , ∃ x1 ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1) ⇒ ∃ x1 ∃ x2 (ty = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_nz , ∅ ⟩ ∧ tk = x1) $ by ax
l24: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by ex_elim [l23, l22]
l25: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel $ by ax
l26: $ … ⇒ ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ $ by and_elim_l [l25]
l27: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ ra_clen_c ty tn ∈ lrel $ by weaken [#4]
l28: $ … ⇒ ∃ l (tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel) $ by f2_clen [l27, l26]
l29: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel $ by ax
l30: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ kr_clen_c ∈ ω $ by kr_clen_c_omega
l31: $ … ⇒ x2 ∊ trees ω ∧ l ∊ trees ω $ by lrel_args2 [and_elim_r [l29], wcel_isset [l30]]
l32: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ nvf = nvf $ by eq_refl
l33: $ … ⇒ fv nvf tn = fv nvf ⟨ kc_s , scons l ∅ ⟩ $ by fv_eq [l32, and_elim_l [l29]]
l34: $ … ⇒ fv nvf ⟨ kc_s , scons l ∅ ⟩ = suc (fv nvf l) $ by nvf_s [welc_wcel [and_elim_r [l31]]]
l35: $ … ⇒ fv nvf tn = suc (fv nvf l) $ by eq_trans [l33, l34]
l36: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ isset l $ by isset_var
l37: $ … ⇒ fv nvf l ∈ ω $ by nvf_omega [l36]
l38: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel $ by ax
l39: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ crn j1 ⊆ f2_cq tk $ by weaken [#1]
l40: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ ty = ⟨ k1 , j1 ⟩ $ by weaken [#2]
l41: $ … ⇒ ⟨ k1 , j1 ⟩ = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ $ by eq_trans [eq_sym [l40], and_elim_l [l38]]
l42: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ isset k1 $ by isset_var
l43: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ isset j1 $ by isset_var
l44: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ isset x2 $ by isset_var
l45: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ kc_ccons ∈ ω $ by kc_ccons_omega
l46: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ isset ∅ $ by ax_empty
l47: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ isset (scons x3 (scons x2 ∅)) $ by scons_set [scons_set [l46]]
l48: $ … ⇒ k1 = kc_ccons ∧ j1 = scons x3 (scons x2 ∅) $ by opair_inj_c [l41, l42, l43, wcel_isset [l45], l47]
l49: $ … ⇒ crn (scons x3 (scons x2 ∅)) ⊆ f2_cq tk $ by subset_eq_l [crn_eq [and_elim_r [l48]], l39]
l50: $ … ⇒ x2 ∈ f2_cq tk $ by crn_scons_head [l44, crn_scons_tail [l49]]
l51: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ x2 = x2 $ by eq_refl
l52: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ x4 = x4 $ by eq_refl
l53: $ … ⇒ ra_nth_ctor x2 x4 tk ∈ lrel $ by wcel_eq_l [ra_nth_ctor_eq [l51, l52, eq_sym [and_elim_l [and_elim_r [and_elim_r [l38]]]]], and_elim_r [and_elim_r [and_elim_r [l38]]]]
l54: $ … ⇒ fv nvf x4 ∈ fv nvf l $ by f2_cq_e [wcel_welc [l50], l53, and_elim_r [l29]]
l55: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel , tn = ⟨ kc_s , scons l ∅ ⟩ ∧ ra_clen_c x2 l ∈ lrel ⇒ kr_nth_ctor ∈ ω $ by kr_nth_ctor_omega
l56: $ … ⇒ x2 ∊ trees ω ∧ x4 ∊ trees ω ∧ x1 ∊ trees ω $ by lrel_args3 [and_elim_r [and_elim_r [and_elim_r [l38]]], wcel_isset [l55]]
l57: $ … ⇒ fv nvf tc = fv nvf ⟨ kc_s , scons x4 ∅ ⟩ $ by fv_eq [l32, and_elim_l [and_elim_r [l38]]]
l58: $ … ⇒ fv nvf ⟨ kc_s , scons x4 ∅ ⟩ = suc (fv nvf x4) $ by nvf_s [welc_wcel [and_elim_l [and_elim_r [l56]]]]
l59: $ … ⇒ suc (fv nvf x4) ∈ suc (fv nvf l) $ by omega_suc_mono_c [l37, l54]
l60: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by wcel_eq_l [eq_sym [eq_trans [l57, l58]], wcel_eq_r [eq_sym [l35], l59]]
l61: $ G , ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel ⇒ fv nvf tc ∈ fv nvf tn $ by ex_elim [l28, l60]
l62: $ G , ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l63: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by ex_elim [l62, l61]
l64: $ G , ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l65: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by ex_elim [l64, l63]
l66: $ G , ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l67: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by ex_elim [l66, l65]
l68: $ G , ∃ x1 ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) ⇒ ∃ x1 ∃ x3 ∃ x2 ∃ x4 (ty = ⟨ kc_ccons , scons x3 (scons x2 ∅) ⟩ ∧ tc = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tk = x1 ∧ ra_nth_ctor x2 x4 x1 ∈ lrel) $ by ax
l69: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by ex_elim [l68, l67]
l70: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by or_elim [l1, l24, l69]

lemma f2_cq_all (G: hyps) (tk: set): $ G ⇒ trees ω ⊆ f2_cq tk $
----
l1: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cq tk , y = ⟨ i , j ⟩ , ra_nth_ctor y c tk ∈ lrel , ra_clen_c y n ∈ lrel ⇒ crn j ⊆ f2_cq tk $ by ax
l2: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cq tk , y = ⟨ i , j ⟩ , ra_nth_ctor y c tk ∈ lrel , ra_clen_c y n ∈ lrel ⇒ y = ⟨ i , j ⟩ $ by ax
l3: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cq tk , y = ⟨ i , j ⟩ , ra_nth_ctor y c tk ∈ lrel , ra_clen_c y n ∈ lrel ⇒ ra_nth_ctor y c tk ∈ lrel $ by ax
l4: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cq tk , y = ⟨ i , j ⟩ , ra_nth_ctor y c tk ∈ lrel , ra_clen_c y n ∈ lrel ⇒ ra_clen_c y n ∈ lrel $ by ax
l5: $ … ⇒ fv nvf c ∈ fv nvf n $ by f2_cq_node [l1, l2, l3, l4]
l6: $ … ⇒ ra_nth_ctor y c tk ∈ lrel → ra_clen_c y n ∈ lrel → fv nvf c ∈ fv nvf n $ by imp_intro [imp_intro [l5]]
l7: $ … ⇒ ∀ c ∀ n (ra_nth_ctor y c tk ∈ lrel → ra_clen_c y n ∈ lrel → fv nvf c ∈ fv nvf n) $ by all_intro [all_intro [l6]]
l8: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cq tk , y = ⟨ i , j ⟩ ⇒ y ∊ f2_cq tk $ by cab_intro [l7]
l9: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cq tk , y = ⟨ i , j ⟩ ⇒ y = ⟨ i , j ⟩ $ by ax
l10: $ … ⇒ ⟨ i , j ⟩ ∈ f2_cq tk $ by wcel_intro [l9, l8]
l11: $ G , i ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ f2_cq tk ⇒ isset ⟨ i , j ⟩ $ by opair_isset
l12: $ … ⇒ ⟨ i , j ⟩ ∈ f2_cq tk $ by isset_elim [l11, l10]
l13: $ … ⇒ i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f2_cq tk → ⟨ i , j ⟩ ∈ f2_cq tk $ by imp_intro [imp_intro [imp_intro [l12]]]
l14: $ … ⇒ ∀ i ∀ j (i ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ f2_cq tk → ⟨ i , j ⟩ ∈ f2_cq tk) $ by all_intro [all_intro [l13]]
l15: $ G ⇒ isset ω $ by omega_set
l16: $ … ⇒ trees ω ⊆ f2_cq tk $ by trees_ind_c [l15, l14]

lemma f2_ctor_lt (G: hyps) (te tc tk tn: set): $ G ⇒ ra_nth_ctor te tc tk ∈ lrel $ > $ G ⇒ ra_clen_c te tn ∈ lrel $ > $ G ⇒ fv nvf tc ∈ fv nvf tn $
----
l1: $ G ⇒ trees ω ⊆ f2_cq tk $ by f2_cq_all
l2: $ G ⇒ kr_clen_c ∈ ω $ by kr_clen_c_omega
l3: $ … ⇒ te ∊ trees ω ∧ tn ∊ trees ω $ by lrel_args2 [#2, wcel_isset [l2]]
l4: $ … ⇒ te ∊ f2_cq tk $ by subset_elim [l1, and_elim_l [l3]]
l5: $ … ⇒ fv nvf tc ∈ fv nvf tn $ by f2_cq_e [l4, #1, #2]

lemma f2_ntys {o p q: set} (G: hyps) (tz tn tm ta te tb: set): $ G ⇒ ra_ntys tz tn tm ∈ lrel $ > $ G ⇒ tz = ⟨ kc_tcons , scons ta (scons te (scons tb ∅)) ⟩ $ > $ G ⇒ ∃ o ∃ p ∃ q (ra_ntys tb o p ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add p q tm ∈ lrel) $
----
l1: $ … ⇒ (tz = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) $ by lrel_ntys_cases [#1]
l2: $ G , tz = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ⇒ tz = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ G , tz = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ⇒ tz = ⟨ kc_tcons , scons ta (scons te (scons tb ∅)) ⟩ $ by weaken [#2]
l4: $ … ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tcons , scons ta (scons te (scons tb ∅)) ⟩ $ by eq_trans [eq_sym [and_elim_l [l2]], l3]
l5: $ G , tz = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
l6: $ G , tz = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
l7: $ … ⇒ kc_tnil = kc_tcons $ by opair_inj_l_c [l4, wcel_isset [l5], wcel_isset [l6]]
l8: $ G , tz = ⟨ kc_tnil , ∅ ⟩ ∧ tn = ⟨ kc_nz , ∅ ⟩ ∧ tm = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_tnil = kc_tcons $ by kc_tnil_ne_tcons
l9: $ … ⇒ ∃ o ∃ p ∃ q (ra_ntys tb o p ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by bot_elim [not_elim [l8, l7]]
l10: $ G , tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel ⇒ tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel $ by ax
l11: $ G , tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel ⇒ tz = ⟨ kc_tcons , scons ta (scons te (scons tb ∅)) ⟩ $ by weaken [#2]
l12: $ … ⇒ ⟨ kc_tcons , scons ta (scons te (scons tb ∅)) ⟩ = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ $ by eq_trans [eq_sym [l11], and_elim_l [l10]]
l13: $ G , tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
l14: $ … ⇒ ta = x1 ∧ te = x2 ∧ tb = x3 $ by node3_inj [wcel_isset [l13], l12]
l15: $ G , tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel ⇒ x4 = x4 $ by eq_refl
l16: $ G , tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel ⇒ x5 = x5 $ by eq_refl
l17: $ … ⇒ ra_ntys tb x4 x5 ∈ lrel $ by wcel_eq_l [ra_ntys_eq [eq_sym [and_elim_r [and_elim_r [l14]]], l15, l16], and_elim_l [and_elim_r [and_elim_r [and_elim_r [l10]]]]]
l18: $ G , tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel ⇒ x6 = x6 $ by eq_refl
l19: $ … ⇒ ra_clen_c te x6 ∈ lrel $ by wcel_eq_l [ra_clen_c_eq [eq_sym [and_elim_l [and_elim_r [l14]]], l18], and_elim_l [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l10]]]]]]
l20: $ … ⇒ ra_add x5 x6 tm ∈ lrel $ by wcel_eq_l [ra_add_eq [l16, l18, eq_sym [and_elim_l [and_elim_r [and_elim_r [l10]]]]], and_elim_r [and_elim_r [and_elim_r [and_elim_r [and_elim_r [l10]]]]]]
l21: $ … ⇒ ra_ntys tb x4 x5 ∈ lrel ∧ ra_clen_c te x6 ∈ lrel ∧ ra_add x5 x6 tm ∈ lrel $ by and_intro [l17, and_intro [l19, l20]]
l22: $ … ⇒ ∃ q (ra_ntys tb x4 x5 ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add x5 q tm ∈ lrel) $ by ex_intro [l21]
l23: $ … ⇒ ∃ p ∃ q (ra_ntys tb x4 p ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by ex_intro [l22]
l24: $ … ⇒ ∃ o ∃ p ∃ q (ra_ntys tb o p ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by ex_intro [l23]
l25: $ G , ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) ⇒ ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) $ by ax
l26: $ … ⇒ ∃ o ∃ p ∃ q (ra_ntys tb o p ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by ex_elim [l25, l24]
l27: $ G , ∃ x6 ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) ⇒ ∃ x6 ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) $ by ax
l28: $ … ⇒ ∃ o ∃ p ∃ q (ra_ntys tb o p ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by ex_elim [l27, l26]
l29: $ G , ∃ x5 ∃ x6 ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) ⇒ ∃ x5 ∃ x6 ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) $ by ax
l30: $ … ⇒ ∃ o ∃ p ∃ q (ra_ntys tb o p ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by ex_elim [l29, l28]
l31: $ G , ∃ x4 ∃ x5 ∃ x6 ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) ⇒ ∃ x4 ∃ x5 ∃ x6 ∃ x7 (tz = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ tn = ⟨ kc_s , scons x4 ∅ ⟩ ∧ tm = x7 ∧ ra_ntys x3 x4 x5 ∈ lrel ∧ ra_clen_c x2 x6 ∈ lrel ∧ ra_add x5 x6 x7 ∈ lrel) $ by ax
