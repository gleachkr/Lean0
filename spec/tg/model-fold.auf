l8: $ G , l = ixs td w zc , r = scat p l ⇒ r = scat p l $ by ax
l9: $ G , l = ixs td w zc , r = scat p l ⇒ p = p $ by eq_refl
l10: $ G , l = ixs td w zc , r = scat p l ⇒ r = scat p (ixs td w zc) $ by eq_trans [l8, scat_eq [l9, l7]]
l11: $ G , l = ixs td w zc , r = scat p l ⇒ scat p (ixs td w zc) ∈ fseq u $ by weaken [l3]
