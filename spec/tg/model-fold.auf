l1: $ G ⇒ ∃ x1 ∃ x2 ∃ b ∃ x3 ∃ x4 (fv nvf x1 = sj ∧ ra_nidx td x1 x2 ∈ lrel ∧ b ∊ fseq {y | y = y} ∧ cdm b = fv nvf x2 ∧ sa = scat b p ∧ ⟨ sj , ⟨ sa , scons x3 x4 ⟩ ⟩ ∈ ifam u (dnf u (mcv H)) td w ∧ sx = itup td sj x3 x4 w) $ by ifold_pt_shape [#1, #2, #4, #5, #8]
