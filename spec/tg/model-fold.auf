l39: $ … ⇒ ∃ o ∃ p ∃ q (ra_ntys tb o p ∈ lrel ∧ ra_clen_c te q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by or_elim [l1, l9, l38]

def f2_mq (F E C: class) (.y .i .j .k .n .m: set): class = $ {y | ∀ i ∀ j ∀ k ∀ n ∀ m (ra_nth_ty y i F E ∈ lrel → ra_minor_idx y j C k ∈ lrel → fv nvf i = fv nvf j → ra_ntys y n m ∈ lrel → fv nvf k ∈ fv nvf m)} $

lemma f2_mq_e (G: hyps) (tf te tc2 ty ti tj tk tn tm: set): $ G ⇒ ty ∊ f2_mq tf te tc2 $ > $ G ⇒ ra_nth_ty ty ti tf te ∈ lrel $ > $ G ⇒ ra_minor_idx ty tj tc2 tk ∈ lrel $ > $ G ⇒ fv nvf ti = fv nvf tj $ > $ G ⇒ ra_ntys ty tn tm ∈ lrel $ > $ G ⇒ fv nvf tk ∈ fv nvf tm $
----
l1: $ … ⇒ ∀ i ∀ j ∀ k ∀ n ∀ m (ra_nth_ty ty i tf te ∈ lrel → ra_minor_idx ty j tc2 k ∈ lrel → fv nvf i = fv nvf j → ra_ntys ty n m ∈ lrel → fv nvf k ∈ fv nvf m) $ by cab_elim [#1]
l2: $ … ⇒ ∀ j ∀ k ∀ n ∀ m (ra_nth_ty ty ti tf te ∈ lrel → ra_minor_idx ty j tc2 k ∈ lrel → fv nvf ti = fv nvf j → ra_ntys ty n m ∈ lrel → fv nvf k ∈ fv nvf m) $ by all_elim [l1]
l3: $ … ⇒ ∀ k ∀ n ∀ m (ra_nth_ty ty ti tf te ∈ lrel → ra_minor_idx ty tj tc2 k ∈ lrel → fv nvf ti = fv nvf tj → ra_ntys ty n m ∈ lrel → fv nvf k ∈ fv nvf m) $ by all_elim [l2]
l4: $ … ⇒ ∀ n ∀ m (ra_nth_ty ty ti tf te ∈ lrel → ra_minor_idx ty tj tc2 tk ∈ lrel → fv nvf ti = fv nvf tj → ra_ntys ty n m ∈ lrel → fv nvf tk ∈ fv nvf m) $ by all_elim [l3]
l5: $ … ⇒ ∀ m (ra_nth_ty ty ti tf te ∈ lrel → ra_minor_idx ty tj tc2 tk ∈ lrel → fv nvf ti = fv nvf tj → ra_ntys ty tn m ∈ lrel → fv nvf tk ∈ fv nvf m) $ by all_elim [l4]
l6: $ … ⇒ ra_nth_ty ty ti tf te ∈ lrel → ra_minor_idx ty tj tc2 tk ∈ lrel → fv nvf ti = fv nvf tj → ra_ntys ty tn tm ∈ lrel → fv nvf tk ∈ fv nvf tm $ by all_elim [l5]
l7: $ … ⇒ fv nvf tk ∈ fv nvf tm $ by imp_elim [imp_elim [imp_elim [imp_elim [l6, #2], #3], #4], #5]

lemma f2_mq_node (G: hyps) (tf te tc tc2 tK ty ti tj tk tn tm k1 j1: set): $ G ⇒ crn j1 ⊆ f2_mq tf te tc2 $ > $ G ⇒ ty = ⟨ k1 , j1 ⟩ $ > $ G ⇒ ra_nth_ty ty ti tf te ∈ lrel $ > $ G ⇒ ra_minor_idx ty tj tc2 tk ∈ lrel $ > $ G ⇒ fv nvf ti = fv nvf tj $ > $ G ⇒ ra_ntys ty tn tm ∈ lrel $ > $ G ⇒ ra_nth_ctor te tc tK ∈ lrel $ > $ G ⇒ fv nvf tc = fv nvf tc2 $ > $ G ⇒ fv nvf tk ∈ fv nvf tm $
----
l1: $ … ⇒ ∃ x1 ∃ x2 ∃ x3 (ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2) ∨ ∃ x1 ∃ x4 ∃ x2 ∃ x5 ∃ x3 ∃ x6 (ty = ⟨ kc_tcons , scons x4 (scons x5 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_s , scons x6 ∅ ⟩ ∧ tf = x1 ∧ te = x2 ∧ ra_nth_ty x3 x6 x1 x2 ∈ lrel) $ by lrel_nth_ty_cases [#3]
l2: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 ⇒ ra_minor_idx ty tj tc2 tk ∈ lrel $ by weaken [#4]
l3: $ … ⇒ ∃ a ∃ b ∃ c ∃ e (ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e) ∨ ∃ a ∃ b ∃ c ∃ d ∃ e ∃ f ∃ g ∃ h (ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_s , scons d ∅ ⟩ ∧ tc2 = e ∧ tk = h ∧ ra_clen_c b g ∈ lrel ∧ ra_minor_idx c d e f ∈ lrel ∧ ra_add g f h ∈ lrel) $ by lrel_minor_idx_cases [l2]
l4: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e ⇒ ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 $ by ax
l5: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e ⇒ ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e $ by ax
l6: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e ⇒ nvf = nvf $ by eq_refl
l7: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e ⇒ ra_ntys ty tn tm ∈ lrel $ by weaken [#6]
l8: $ … ⇒ ∃ o ∃ p ∃ q (ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by f2_ntys [l7, and_elim_l [l4]]
l9: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel $ by ax
l10: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 $ by ax
l11: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e $ by ax
l12: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ nvf = nvf $ by eq_refl
l13: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ q = q $ by eq_refl
l14: $ … ⇒ ra_clen_c te q ∈ lrel $ by wcel_eq_l [ra_clen_c_eq [eq_sym [and_elim_r [and_elim_r [and_elim_r [l10]]]], l13], and_elim_l [and_elim_r [l9]]]
l15: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ ra_nth_ctor te tc tK ∈ lrel $ by weaken [#7]
l16: $ … ⇒ fv nvf tc ∈ fv nvf q $ by f2_ctor_lt [l15, l14]
l17: $ … ⇒ fv nvf tm = nadd (fv nvf p) (fv nvf q) $ by lrel_add_sem [and_elim_r [and_elim_r [l9]]]
l18: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ isset p $ by isset_var
l19: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ isset q $ by isset_var
l20: $ … ⇒ fv nvf p ∈ ω $ by nvf_omega [l18]
l21: $ … ⇒ fv nvf q ∈ ω $ by nvf_omega [l19]
l22: $ … ⇒ fv nvf q ⊆ nadd (fv nvf q) (fv nvf p) $ by nadd_le_l_c [l21, l20]
l23: $ … ⇒ nadd (fv nvf q) (fv nvf p) = nadd (fv nvf p) (fv nvf q) $ by nadd_comm_c [l21, l20]
l24: $ … ⇒ fv nvf tc ∈ fv nvf tm $ by wcel_eq_r [eq_trans [l23, eq_sym [l17]], wcel_subset [l22, l16]]
l25: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel ⇒ fv nvf tc = fv nvf tc2 $ by weaken [#8]
l26: $ … ⇒ fv nvf tc2 = fv nvf tk $ by fv_eq [l12, eq_trans [and_elim_l [and_elim_r [and_elim_r [l11]]], eq_sym [and_elim_r [and_elim_r [and_elim_r [l11]]]]]]
l27: $ … ⇒ fv nvf tk ∈ fv nvf tm $ by wcel_eq_l [eq_trans [l25, l26], l24]
l28: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ∃ q (ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel) ⇒ ∃ q (ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by ax
l29: $ … ⇒ fv nvf tk ∈ fv nvf tm $ by ex_elim [l28, l27]
l30: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e , ∃ p ∃ q (ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel) ⇒ ∃ p ∃ q (ra_ntys x3 o p ∈ lrel ∧ ra_clen_c x2 q ∈ lrel ∧ ra_add p q tm ∈ lrel) $ by ax
l31: $ … ⇒ fv nvf tk ∈ fv nvf tm $ by ex_elim [l30, l29]
l32: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e ⇒ fv nvf tk ∈ fv nvf tm $ by ex_elim [l8, l31]
l33: $ G , ty = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ ti = ⟨ kc_nz , ∅ ⟩ ∧ tf = x1 ∧ te = x2 , ∃ e (ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e) ⇒ ∃ e (ty = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ ∧ tj = ⟨ kc_nz , ∅ ⟩ ∧ tc2 = e ∧ tk = e) $ by ax
