lemma m1_uni_universe_pos (G: hyps) (k z: set):
  $ G ⇒ k ∊ ω $ > $ G ⇒ z ∊ k $ > $ G ⇒ universe (fv uni k) $
----
l1: $ G ⇒ k = ∅ ∨ ∃ y (y ∊ ω ∧ k = suc y) $ by omega_cases [#1]
l2: $ G , k = ∅ ⇒ k = ∅ $ by ax
l3: $ G , k = ∅ ⇒ z ∊ k $ by weaken [#2]
l4: $ G , k = ∅ ⇒ z ∊ ∅ $ by welc_eq [l2, l3]
l5: $ G , k = ∅ ⇒ ⊥ $ by empty_elim [l4]
l6: $ G , k = ∅ ⇒ universe (fv uni k) $ by bot_elim [l5]
l7: $ G , y ∊ ω ∧ k = suc y ⇒ y ∊ ω ∧ k = suc y $ by ax
l8: $ G , y ∊ ω ∧ k = suc y ⇒ y ∊ ω $ by and_elim_l [l7]
l9: $ G , y ∊ ω ∧ k = suc y ⇒ k = suc y $ by and_elim_r [l7]
l10: $ G , y ∊ ω ∧ k = suc y ⇒ universe (fv uni (suc y)) $ by uni_universe [l8]
l11: $ G , y ∊ ω ∧ k = suc y ⇒ suc y = k $ by eq_sym [l9]
l12: $ G , y ∊ ω ∧ k = suc y ⇒ uni = uni $ by eq_refl
l13: $ G , y ∊ ω ∧ k = suc y ⇒ fv uni (suc y) = fv uni k $ by fv_eq [l12, l11]
l14: $ G , y ∊ ω ∧ k = suc y ⇒ universe (fv uni k) $ by universe_eq [l13, l10]
l15: $ G , ∃ y (y ∊ ω ∧ k = suc y) ⇒ ∃ y (y ∊ ω ∧ k = suc y) $ by ax
l16: $ G , ∃ y (y ∊ ω ∧ k = suc y) ⇒ universe (fv uni k) $ by ex_elim [l15, l14]
l17: $ G ⇒ universe (fv uni k) $ by or_elim [l1, l6, l16]

cpi_uni_imax
------------
l1: $ G ⇒ ∅ ∈ n ∨ ∅ = n $ by omega_zero_le [#2]
z1: $ G , ∅ = n ⇒ ∅ = n $ by ax
z2: $ G , ∅ = n ⇒ n = ∅ $ by eq_sym [z1]
z3: $ G , ∅ = n ⇒ uni = uni $ by eq_refl
z4: $ G , ∅ = n ⇒ fv uni n = fv uni ∅ $ by fv_eq [z3, z2]
z5: $ G , ∅ = n ⇒ fv uni ∅ = two $ by uni_zero
z6: $ G , ∅ = n ⇒ fv uni n = two $ by eq_trans [z4, z5]
z7: $ G , ∅ = n , x ∊ A ⇒ x ∊ A $ by ax
z8: $ G , ∅ = n , x ∊ A ⇒ ∀ x (x ∊ A → B ∈ fv uni n) $ by weaken [#4]
z9: $ G , ∅ = n , x ∊ A ⇒ x ∊ A → B ∈ fv uni n $ by all_elim [z8]
z10: $ G , ∅ = n , x ∊ A ⇒ B ∈ fv uni n $ by imp_elim [z9, z7]
z11: $ G , ∅ = n , x ∊ A ⇒ fv uni n = two $ by weaken [z6]
z12: $ G , ∅ = n , x ∊ A ⇒ B ∈ two $ by wcel_eq_r [z11, z10]
z13: $ G , ∅ = n ⇒ x ∊ A → B ∈ two $ by imp_intro [z12]
z14: $ G , ∅ = n ⇒ ∀ x (x ∊ A → B ∈ two) $ by all_intro [z13]
z15: $ G , ∅ = n ⇒ cpi x A B ∈ two $ by cpi_two [z14]
z16: $ G , ∅ = n ⇒ m = m $ by eq_refl
z17: $ G , ∅ = n ⇒ nimax m n = nimax m ∅ $ by nimax_eq [z16, z2]
z18: $ G , ∅ = n ⇒ nimax m ∅ = ∅ $ by nimax_zero
z19: $ G , ∅ = n ⇒ nimax m n = ∅ $ by eq_trans [z17, z18]
z20: $ G , ∅ = n ⇒ fv uni (nimax m n) = fv uni ∅ $ by fv_eq [z3, z19]
z21: $ G , ∅ = n ⇒ fv uni (nimax m n) = two $ by eq_trans [z20, z5]
z22: $ G , ∅ = n ⇒ two = fv uni (nimax m n) $ by eq_sym [z21]
z23: $ G , ∅ = n ⇒ cpi x A B ∈ fv uni (nimax m n) $ by wcel_eq_r [z22, z15]
p0: $ G ⇒ nmax m n ∈ ω $ by nmax_omega [#1, #2]
q1: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ k ∊ ω $ by ax
q2: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ z ∊ n $ by ax
q3: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ k = nmax m n $ by ax
q4: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ nmax m n = k $ by eq_sym [q3]
q5: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ n ⊆ nmax m n $ by nmax_le_r
q6: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ n ⊆ k $ by subset_eq_r [q4, q5]
q7: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ z ∊ k $ by subset_elim [q6, q2]
q8: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ universe (fv uni k) $ by m1_uni_universe_pos [q1, q7]
q9: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ m ⊆ nmax m n $ by nmax_le_l
q10: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ m ⊆ k $ by subset_eq_r [q4, q9]
q11: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ m ∊ ω $ by weaken [#1]
q12: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ n ∊ ω $ by weaken [#2]
q13: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ fv uni m ⊆ fv uni k $ by uni_mono_subset [q11, q1, q10]
q14: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ fv uni n ⊆ fv uni k $ by uni_mono_subset [q12, q1, q6]
q15: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ A ∈ fv uni m $ by weaken [#3]
q16: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ A ∈ fv uni k $ by wcel_subset [q13, q15]
q17: $ G , z ∊ n , k = nmax m n , k ∊ ω , x ∊ A ⇒ ∀ x (x ∊ A → B ∈ fv uni n) $ by weaken [#4]
q18: $ G , z ∊ n , k = nmax m n , k ∊ ω , x ∊ A ⇒ x ∊ A → B ∈ fv uni n $ by all_elim [q17]
q19: $ G , z ∊ n , k = nmax m n , k ∊ ω , x ∊ A ⇒ x ∊ A $ by ax
q20: $ G , z ∊ n , k = nmax m n , k ∊ ω , x ∊ A ⇒ B ∈ fv uni n $ by imp_elim [q18, q19]
q21: $ G , z ∊ n , k = nmax m n , k ∊ ω , x ∊ A ⇒ fv uni n ⊆ fv uni k $ by weaken [q14]
q22: $ G , z ∊ n , k = nmax m n , k ∊ ω , x ∊ A ⇒ B ∈ fv uni k $ by wcel_subset [q21, q20]
q23: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ x ∊ A → B ∈ fv uni k $ by imp_intro [q22]
q24: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ ∀ x (x ∊ A → B ∈ fv uni k) $ by all_intro [q23]
q25: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ cpi x A B ∈ fv uni k $ by universe_cpi [q8, q16, q24]
q26: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ nimax m n = nmax m n $ by nimax_pos [q2]
q27: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ nimax m n = k $ by eq_trans [q26, q4]
q28: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ k = nimax m n $ by eq_sym [q27]
q29: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ uni = uni $ by eq_refl
q30: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ fv uni k = fv uni (nimax m n) $ by fv_eq [q29, q28]
q31: $ G , z ∊ n , k = nmax m n , k ∊ ω ⇒ cpi x A B ∈ fv uni (nimax m n) $ by wcel_eq_r [q30, q25]
p1: $ G , z ∊ n ⇒ cpi x A B ∈ fv uni (nimax m n) $ by wcel_elim [p0, q31]
p2: $ G , z ∊ n , z = ∅ ⇒ cpi x A B ∈ fv uni (nimax m n) $ by weaken [p1]
p3: $ G , ∅ ∈ n ⇒ ∅ ∈ n $ by ax
p4: $ G , ∅ ∈ n ⇒ cpi x A B ∈ fv uni (nimax m n) $ by wcel_elim [p3, p2]
l2: $ G ⇒ cpi x A B ∈ fv uni (nimax m n) $ by or_elim [l1, p4, z23]

