l7: $ G ⇒ ¬ kc_app = kc_lam $ by kc_app_ne_lam
l8: $ G ⇒ ¬ kc_lam = kc_app $ by ne_sym [l7]
l9: $ G ⇒ ¬ K = kc_app $ by m4_ne_eq [#1, l8]
l11: $ G ⇒ ¬ kc_lam = kc_pi $ by kc_lam_ne_pi
l12: $ G ⇒ ¬ K = kc_pi $ by m4_ne_eq [#1, l11]
l14: $ G ⇒ ¬ kc_lam = kc_proj $ by kc_lam_ne_proj
l15: $ G ⇒ ¬ K = kc_proj $ by m4_ne_eq [#1, l14]
l16: $ G ⇒ kc_lam ∈ kc_cst $ by m4_lt_lam_cst
l17: $ G ⇒ ¬ kc_lam ∈ kexa $ by kexa_notin_lt [l16]
l18: $ G ⇒ ¬ K ∈ kexa $ by m4_nin_eq [#1, l17]
l19: $ G ⇒ kc_lam ∈ kstr $ by kstr_lam
l20: $ G ⇒ kc_lam = K $ by eq_sym [#1]
l21: $ G ⇒ K ∈ kstr $ by wcel_eq_l [l20, l19]
l22: $ G ⇒ ¬ ¬ K ∈ kstr $ by not_not_intro [l21]
l23: $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1)))) $ by m4_dnb_lam [l3, l6, l9, #1, l12, l15, l18, l22]

