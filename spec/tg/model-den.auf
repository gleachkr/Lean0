l33: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅)))))) ⇒ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l32]
l34: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅)))))) ⇒ z ∊ dnb u M K S V $ by cab_intro [l33]
l35: $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅)))))) $ by eq_intro [l24, l34]

lemma m4_dnb_atom {x0 x1: set} (G: hyps) (M K S V: class) (u: set): $ G ⇒ ¬ K = kc_bvar $ > $ G ⇒ ¬ K = kc_srt $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ ¬ K = kc_lam $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_proj $ > $ G ⇒ K ∈ kexa $ > $ G ⇒ ¬ ¬ K ∈ kstr $ > $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) $
----
l1: $ G , z ∊ dnb u M K S V ⇒ z ∊ dnb u M K S V $ by ax
l2: $ G , z ∊ dnb u M K S V ⇒ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by cab_elim [l1]
l3: $ G ⇒ ¬ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) $ by m4_nand [#1]
l4: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) $ by weaken [l3]
l5: $ G ⇒ ¬ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) $ by m4_nand [#2]
l6: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) $ by weaken [l5]
l7: $ G ⇒ ¬ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) $ by m4_nand [#3]
l8: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) $ by weaken [l7]
l9: $ G ⇒ ¬ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) $ by m4_nand [#4]
l10: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) $ by weaken [l9]
l11: $ G ⇒ ¬ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) $ by m4_nand [#5]
l12: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) $ by weaken [l11]
l13: $ G ⇒ ¬ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) $ by m4_nand [#6]
l14: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) $ by weaken [l13]
l15: $ G ⇒ ¬ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by m4_nand [#8]
l16: $ G , z ∊ dnb u M K S V ⇒ ¬ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by weaken [l15]
