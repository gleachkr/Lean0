t3: $ G , (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩)) ⇒ z ∊ clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r))) ∪ (clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅)))))) ∪ (clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w))) ∪ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩))))) $ by m3_case_and [t4]
t2: $ G , (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq u) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩)) ⇒ z ∊ clam w lvals (clam r (fseq u) (fv uni (lv (fv S ∅) w))) ∪ (clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r))) ∪ (clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅)))))) ∪ (clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w))) ∪ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩)))))) $ by m3_case_and [t3]
t1: $ G , (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq u) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq u) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩)) ⇒ z ∊ clam w lvals (clam r (fseq u) (fv r (fv nvf (fv S ∅)))) ∪ (clam w lvals (clam r (fseq u) (fv uni (lv (fv S ∅) w))) ∪ (clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r))) ∪ (clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅)))))) ∪ (clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w))) ∪ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩))))))) $ by m3_case_and [t2]
d1: $ G , z ∊ dnb u M K S v ⇒ z ∊ dnb u M K S v $ by ax
d2: $ G , z ∊ dnb u M K S v ⇒ (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq u) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq u) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩)) $ by cab_elim [d1]
d3: $ G , z ∊ dnb u M K S v ⇒ z ∊ clam w lvals (clam r (fseq u) (fv r (fv nvf (fv S ∅)))) ∪ (clam w lvals (clam r (fseq u) (fv uni (lv (fv S ∅) w))) ∪ (clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r))) ∪ (clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅)))))) ∪ (clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w))) ∪ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩))))))) $ by cut [d2, t1]
d4: $ G ⇒ dnb u M K S v ⊆ clam w lvals (clam r (fseq u) (fv r (fv nvf (fv S ∅)))) ∪ (clam w lvals (clam r (fseq u) (fv uni (lv (fv S ∅) w))) ∪ (clam w lvals (clam r (fseq u) (ap (da (fv v ∅) w r) (da (fv v (suc ∅)) w r))) ∪ (clam w lvals (clam r (fseq u) (clam x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (cpi x (da (fv v ∅) w r) (da (fv v (suc ∅)) w (scons x r)))) ∪ (clam w lvals (clam r (fseq u) (fv (da (fv v (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅)))))) ∪ (clam w lvals (clam r (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩) w))) ∪ sclip (fv M ⟨ u , ⟨ K , ⟨ S , v ⟩ ⟩ ⟩))))))) $ by subset_intro [d3]
d5: $ G ⇒ isset (dnb u M K S v) $ by subset_isset [u0, d4]

dnf_functional
--------------
l1: $ G ⇒ functional (cgr3 k j v (dnb u M k j v)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (trc ω (cgr3 k j v (dnb u M k j v))) $ by trc_functional_c [l2w, l1]

dnf_node
--------
l1: $ G ⇒ functional (cgr3 a b c (dnb u M a b c)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ fv (trc ω (cgr3 a b c (dnb u M a b c))) ⟨ k , s ⟩ = fv (cgr3 a b c (dnb u M a b c)) ⟨ k , ⟨ s , ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⟩ ⟩ $ by trc_node_c [l2w, l1, #1, #2]
l3w: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ functional (trc ω (cgr3 a b c (dnb u M a b c))) $ by trc_functional_c [l3w, l1]
l4: $ G ⇒ isset s $ by isset_var
l5: $ G ⇒ isset (ccom (trc ω (cgr3 a b c (dnb u M a b c))) s) $ by ccom_set [l3, l4]
h1: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ isset (dnb u M k s h) $ by dnb_set
h2: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ fv (cgr3 a b c (dnb u M a b c)) ⟨ k , ⟨ s , h ⟩ ⟩ = dnb u M k s h $ by fv_cgr3 (B := $ dnb u M a b c $) [h1]
h3: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s $ by ax
h4: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ ccom (trc ω (cgr3 a b c (dnb u M a b c))) s = h $ by eq_sym [h3]
h5: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ s = s $ by eq_refl
h6: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ ⟨ s , ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⟩ = ⟨ s , h ⟩ $ by opair_eq [h5, h4]
h7: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ k = k $ by eq_refl
h8: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ ⟨ k , ⟨ s , ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⟩ ⟩ = ⟨ k , ⟨ s , h ⟩ ⟩ $ by opair_eq [h7, h6]
h9: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ cgr3 a b c (dnb u M a b c) = cgr3 a b c (dnb u M a b c) $ by eq_refl
h10: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ fv (cgr3 a b c (dnb u M a b c)) ⟨ k , ⟨ s , ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⟩ ⟩ = fv (cgr3 a b c (dnb u M a b c)) ⟨ k , ⟨ s , h ⟩ ⟩ $ by fv_eq [h9, h8]
h0a: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ u = u $ by eq_refl
h0b: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ M = M $ by eq_refl
h11: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ dnb u M k s h = dnb u M k s (ccom (trc ω (cgr3 a b c (dnb u M a b c))) s) $ by dnb_eq [h0a, h0b, h7, h5, h3]
h12: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ fv (trc ω (cgr3 a b c (dnb u M a b c))) ⟨ k , s ⟩ = fv (cgr3 a b c (dnb u M a b c)) ⟨ k , ⟨ s , ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⟩ ⟩ $ by weaken [l2]
h13: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ fv (trc ω (cgr3 a b c (dnb u M a b c))) ⟨ k , s ⟩ = fv (cgr3 a b c (dnb u M a b c)) ⟨ k , ⟨ s , h ⟩ ⟩ $ by eq_trans [h12, h10]
h14: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ fv (trc ω (cgr3 a b c (dnb u M a b c))) ⟨ k , s ⟩ = dnb u M k s h $ by eq_trans [h13, h2]
h15: $ G , h = ccom (trc ω (cgr3 a b c (dnb u M a b c))) s ⇒ fv (trc ω (cgr3 a b c (dnb u M a b c))) ⟨ k , s ⟩ = dnb u M k s (ccom (trc ω (cgr3 a b c (dnb u M a b c))) s) $ by eq_trans [h14, h11]
h16: $ G ⇒ fv (trc ω (cgr3 a b c (dnb u M a b c))) ⟨ k , s ⟩ = dnb u M k s (ccom (trc ω (cgr3 a b c (dnb u M a b c))) s) $ by isset_elim [l5, h15]

dnf_cdm
-------
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G , o = ω ⇒ functional (cgr3 k h v (dnb u M k h v)) $ by cgr3_functional
l3: $ G , o = ω ⇒ cdm (trc o (cgr3 k h v (dnb u M k h v))) = trees o $ by trc_cdm [l2]
l4: $ G , o = ω ⇒ o = ω $ by ax
l5: $ G , o = ω ⇒ cgr3 k h v (dnb u M k h v) = cgr3 k h v (dnb u M k h v) $ by eq_refl
l6: $ G , o = ω ⇒ trc o (cgr3 k h v (dnb u M k h v)) = trc ω (cgr3 k h v (dnb u M k h v)) $ by trc_eq [l4, l5]
l7: $ G , o = ω ⇒ cdm (trc o (cgr3 k h v (dnb u M k h v))) = cdm (trc ω (cgr3 k h v (dnb u M k h v))) $ by cdm_eq [l6]
l8: $ G , o = ω ⇒ trees o = trees ω $ by trees_eq [l4]
l9: $ G , o = ω ⇒ cdm (trc ω (cgr3 k h v (dnb u M k h v))) = cdm (trc o (cgr3 k h v (dnb u M k h v))) $ by eq_sym [l7]
l10: $ G , o = ω ⇒ cdm (trc ω (cgr3 k h v (dnb u M k h v))) = trees o $ by eq_trans [l9, l3]
l11: $ G , o = ω ⇒ cdm (trc ω (cgr3 k h v (dnb u M k h v))) = trees ω $ by eq_trans [l10, l8]
l12: $ G ⇒ cdm (dnf u M) = trees ω $ by isset_elim [l1, l11]

dt_set
------
l1: $ G ⇒ functional (cgr3 a b c (dnb u M a b c)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (trc ω (cgr3 a b c (dnb u M a b c))) $ by trc_functional_c [l2w, l1]
l3w: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ rel (trc ω (cgr3 a b c (dnb u M a b c))) $ by trc_rel_c [l3w, l1]
l4: $ G ⇒ isset (fv (trc ω (cgr3 a b c (dnb u M a b c))) T) $ by m3_fv_rel [l2, l3]
l5: $ G ⇒ isset (da (fv (trc ω (cgr3 a b c (dnb u M a b c))) T) W R) $ by da_set [l4]

lemma m4_lt_bvar_cst (G: hyps): $ G ⇒ kc_bvar ∈ kc_cst $
----
l1: $ G ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l2: $ G ⇒ isset kc_bvar $ by wcel_isset [l1]
l3: $ G ⇒ kc_bvar ∈ kc_srt $ by suc_mem [l2]
l4: $ G ⇒ kc_bvar ∈ kc_app $ by suc_mem_r [l3]
l5: $ G ⇒ kc_bvar ∈ kc_lam $ by suc_mem_r [l4]
l6: $ G ⇒ kc_bvar ∈ kc_pi $ by suc_mem_r [l5]
l7: $ G ⇒ kc_bvar ∈ kc_cst $ by suc_mem_r [l6]

lemma m4_lt_srt_cst (G: hyps): $ G ⇒ kc_srt ∈ kc_cst $
----
l1: $ G ⇒ kc_srt ∈ ω $ by kc_srt_omega
l2: $ G ⇒ isset kc_srt $ by wcel_isset [l1]
l3: $ G ⇒ kc_srt ∈ kc_app $ by suc_mem [l2]
l4: $ G ⇒ kc_srt ∈ kc_lam $ by suc_mem_r [l3]
l5: $ G ⇒ kc_srt ∈ kc_pi $ by suc_mem_r [l4]
l6: $ G ⇒ kc_srt ∈ kc_cst $ by suc_mem_r [l5]

--| `dnb` at the label `kc_bvar`.
lemma m3_dnb_bvar (G: hyps) {w r: set} (U M K S V: class): $ G ⇒ K = kc_bvar $ > $ G ⇒ dnb U M K S V = clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) $
----
o1: $ G ⇒ ¬ kc_bvar = kc_srt $ by kc_bvar_ne_srt
o2: $ G ⇒ ¬ kc_bvar = kc_app $ by kc_bvar_ne_app
o3: $ G ⇒ ¬ kc_bvar = kc_lam $ by kc_bvar_ne_lam
o4: $ G ⇒ ¬ kc_bvar = kc_pi $ by kc_bvar_ne_pi
o5c: $ G ⇒ kc_bvar ∈ kc_cst $ by m4_lt_bvar_cst
o6: $ G ⇒ ¬ kc_bvar ∈ kexa $ by kexa_notin_lt [o5c]
o5: $ G ⇒ ¬ kc_bvar = kc_proj $ by kc_bvar_ne_proj
o7: $ G ⇒ kc_bvar ∈ kstr $ by kstr_bvar
x0a: $ G , (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅))))) ⇒ K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) $ by ax
