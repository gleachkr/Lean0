l25: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) $ by ax
l26: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ K ∈ kexa $ by weaken [#7]
l27: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) $ by and_intro [l26, l25]
l28: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_l [l27]
l29: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l28]
l30: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l29]
l31: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l30]
l32: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l31]
l33: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l32]
l34: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l33]
l35: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) ⇒ z ∊ dnb u M K S V $ by cab_intro [l34]
l36: $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) $ by eq_intro [l24, l35]

-- m4: the step at a structural label, the other cases excluded.

lemma m4_dnb_app_k {x0 x1: set} (G: hyps) (M K S V: class) (u: set): $ G ⇒ K = kc_app $ > $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) $
----
l1: $ G ⇒ ¬ kc_bvar = kc_app $ by kc_bvar_ne_app
l2: $ G ⇒ ¬ kc_app = kc_bvar $ by ne_sym [l1]
l3: $ G ⇒ ¬ K = kc_bvar $ by m4_ne_eq [#1, l2]
l4: $ G ⇒ ¬ kc_srt = kc_app $ by kc_srt_ne_app
l5: $ G ⇒ ¬ kc_app = kc_srt $ by ne_sym [l4]
l6: $ G ⇒ ¬ K = kc_srt $ by m4_ne_eq [#1, l5]
l8: $ G ⇒ ¬ kc_app = kc_lam $ by kc_app_ne_lam
l9: $ G ⇒ ¬ K = kc_lam $ by m4_ne_eq [#1, l8]
l11: $ G ⇒ ¬ kc_app = kc_pi $ by kc_app_ne_pi
l12: $ G ⇒ ¬ K = kc_pi $ by m4_ne_eq [#1, l11]
l14: $ G ⇒ ¬ kc_app = kc_proj $ by kc_app_ne_proj
l15: $ G ⇒ ¬ K = kc_proj $ by m4_ne_eq [#1, l14]
l16: $ G ⇒ kc_app ∈ kc_cst $ by m4_lt_app_cst
l17: $ G ⇒ ¬ kc_app ∈ kexa $ by kexa_notin_lt [l16]
l18: $ G ⇒ ¬ K ∈ kexa $ by m4_nin_eq [#1, l17]
l19: $ G ⇒ kc_app ∈ kstr $ by kstr_app
l20: $ G ⇒ kc_app = K $ by eq_sym [#1]
l21: $ G ⇒ K ∈ kstr $ by wcel_eq_l [l20, l19]
l22: $ G ⇒ ¬ ¬ K ∈ kstr $ by not_not_intro [l21]
l23: $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) $ by m4_dnb_app [l3, l6, #1, l9, l12, l15, l18, l22]

lemma m4_dnb_lam_k {x0 x1 x2: set} (G: hyps) (M K S V: class) (u: set): $ G ⇒ K = kc_lam $ > $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1)))) $
----
l1: $ G ⇒ ¬ kc_bvar = kc_lam $ by kc_bvar_ne_lam
l2: $ G ⇒ ¬ kc_lam = kc_bvar $ by ne_sym [l1]
l3: $ G ⇒ ¬ K = kc_bvar $ by m4_ne_eq [#1, l2]
