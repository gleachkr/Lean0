 B) (fv (da (fv K (suc (suc ∅))) w r) (suc (fv nvf (fv I (suc ∅))))))) ∨ ((F ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq B) (mclip B (ap (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩) w)))) ∨ (¬ F ∈ kstr ∧ z ∊ sclip (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩))))))))) $ by or_intro_r [h0d]
