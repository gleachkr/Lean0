o2: $ G ⇒ ¬ kc_srt = kc_app $ by kc_srt_ne_app
o3: $ G ⇒ ¬ kc_srt = kc_lam $ by kc_srt_ne_lam
o4: $ G ⇒ ¬ kc_srt = kc_pi $ by kc_srt_ne_pi
