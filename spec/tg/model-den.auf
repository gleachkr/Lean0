h1: $ G ⇒ ((E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)})) ↔ ((F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)})) $ by bi_intro [f11, g11]
h2: $ G ⇒ ∀ z (((E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)})) ↔ ((F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)}))) $ by all_intro [h1]
h3: $ G ⇒ {z | (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)})} = {z | (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)})} $ by cab_eq [h2]

stf_congr
---------
l1: $ cv k ≐ cv k $ by ceqt_refl
l2: $ cv j ≐ cv j $ by ceqt_refl
l3: $ cv v ≐ cv v $ by ceqt_refl
l4: $ stb A C k j v ≐ stb B D k j v $ by stb_congr [#1, #2, l1, l2, l3]
l5: $ cgr3 k j v (stb A C k j v) ≐ cgr3 k j v (stb B D k j v) $ by cgr3_congr [l4]
l6: $ ω ≐ ω $ by ceqt_refl
l7: $ trc ω (cgr3 k j v (stb A C k j v)) ≐ trc ω (cgr3 k j v (stb B D k j v)) $ by trc_congr [l6, l5]

sb_c_stf
--------
l1: $ (⟦ x / t ⟧ (trc ω (cgr3 k j v (stb A B k j v)))) ≐ trc ω (cgr3 k j v (stb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) k j v)) $ by ceqt_refl

sat_congr
---------
l1: $ stf A C ≐ stf B D $ by stf_congr [#1, #2]
l2: $ fv (stf A C) E ≐ fv (stf B D) F $ by fv_congr [l1, #3]
l3: $ ap (fv (stf A C) E) H ≐ ap (fv (stf B D) F) I $ by ap_congr [l2, #4]

sb_c_sat
--------
l1: $ (⟦ x / t ⟧ (ap (fv (stf A B) C) D)) ≐ ap (fv (stf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (⟦ x / t ⟧ C)) (⟦ x / t ⟧ D) $ by ceqt_refl

stb_set
-------
a1: $ G ⇒ isset lvals $ by lvals_set
a2: $ G , w ∊ lvals ⇒ isset ∅ $ by ax_empty
a3: $ G , w ∊ lvals ⇒ isset (csn ∅) $ by csn_set [a2]
a4: $ G ⇒ w ∊ lvals → isset (csn ∅) $ by imp_intro [a3]
a5: $ G ⇒ ∀ w (w ∊ lvals → isset (csn ∅)) $ by all_intro [a4]
a6: $ G ⇒ isset (clam w lvals (csn ∅)) $ by clam_set [a1, a5]
b1: $ G , w ∊ lvals , y ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)} ⇒ y ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)} $ by ax
b2: $ G , w ∊ lvals , y ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)} ⇒ y ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ y = scons x q) $ by cab_elim [b1]
b3: $ G , w ∊ lvals , y ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)} ⇒ y ∊ fseq u $ by and_elim_l [b2]
b4: $ G , w ∊ lvals ⇒ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)} ⊆ fseq u $ by subset_intro [b3]
b5: $ G , w ∊ lvals ⇒ isset u $ by isset_var
b6: $ G , w ∊ lvals ⇒ isset (fseq u) $ by fseq_set [b5]
b7: $ G , w ∊ lvals ⇒ isset {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)} $ by subset_isset [b6, b4]
b8: $ G ⇒ w ∊ lvals → isset {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)} $ by imp_intro [b7]
b9: $ G ⇒ ∀ w (w ∊ lvals → isset {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) $ by all_intro [b8]
b10: $ G ⇒ isset (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) $ by clam_set [a1, b9]
c1: $ G ⇒ isset ((clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)})) $ by cun_set [a6, b10]
d1: $ G , z ∊ stb u M K S v ⇒ z ∊ stb u M K S v $ by ax
d2: $ G , z ∊ stb u M K S v ⇒ (K = kc_nil ∧ z ∊ (clam w lvals (csn ∅))) ∨ (K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)})) $ by cab_elim [d1]
d3: $ G , z ∊ stb u M K S v , K = kc_nil ∧ z ∊ (clam w lvals (csn ∅)) ⇒ K = kc_nil ∧ z ∊ (clam w lvals (csn ∅)) $ by ax
d4: $ G , z ∊ stb u M K S v , K = kc_nil ∧ z ∊ (clam w lvals (csn ∅)) ⇒ z ∊ (clam w lvals (csn ∅)) $ by and_elim_r [d3]
d5: $ G , z ∊ stb u M K S v , K = kc_nil ∧ z ∊ (clam w lvals (csn ∅)) ⇒ z ∊ (clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) $ by cun_intro_l [d4]
d6: $ G , z ∊ stb u M K S v , K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) ⇒ K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) $ by ax
d7: $ G , z ∊ stb u M K S v , K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) ⇒ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) $ by and_elim_r [d6]
d8: $ G , z ∊ stb u M K S v , K = kc_cons ∧ z ∊ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) ⇒ z ∊ (clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) $ by cun_intro_r [d7]
d9: $ G , z ∊ stb u M K S v ⇒ z ∊ (clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) $ by or_elim [d2, d5, d8]
d10: $ G ⇒ stb u M K S v ⊆ (clam w lvals (csn ∅)) ∪ (clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv v (suc ∅)) w ∧ x ∊ dt u M (fv S ∅) w q ∧ r = scons x q)}) $ by subset_intro [d9]
d11: $ G ⇒ isset (stb u M K S v) $ by subset_isset [c1, d10]

stf_functional
--------------
l1: $ G ⇒ functional (cgr3 k j v (stb u M k j v)) $ by cgr3_functional
l2w: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ functional (trc ω (cgr3 k j v (stb u M k j v))) $ by trc_functional_c [l2w, l1]

stf_node
--------
n1: $ G ⇒ functional (cgr3 i j v (stb u M i j v)) $ by cgr3_functional
n2w: $ G ⇒ isset ω $ by omega_set
n2: $ G ⇒ fv (stf u M) ⟨ k , s ⟩ = fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , ccom (stf u M) s ⟩ ⟩ $ by trc_node_c [n2w, n1, #1, #2]
n3: $ G ⇒ functional (stf u M) $ by stf_functional
n4: $ G ⇒ isset s $ by isset_var
n5: $ G ⇒ isset (ccom (stf u M) s) $ by ccom_set [n3, n4]
n6: $ G , c = ccom (stf u M) s ⇒ isset (stb u M k s c) $ by stb_set
n7: $ G , c = ccom (stf u M) s ⇒ fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , c ⟩ ⟩ = stb u M k s c $ by fv_cgr3 (B := $ stb u M i j v $) [n6]
n8: $ G , c = ccom (stf u M) s ⇒ c = ccom (stf u M) s $ by ax
n9: $ G , c = ccom (stf u M) s ⇒ k = k $ by eq_refl
n10: $ G , c = ccom (stf u M) s ⇒ s = s $ by eq_refl
n11: $ G , c = ccom (stf u M) s ⇒ ⟨ s , c ⟩ = ⟨ s , ccom (stf u M) s ⟩ $ by opair_eq [n10, n8]
n12: $ G , c = ccom (stf u M) s ⇒ ⟨ k , ⟨ s , c ⟩ ⟩ = ⟨ k , ⟨ s , ccom (stf u M) s ⟩ ⟩ $ by opair_eq [n9, n11]
n13: $ G , c = ccom (stf u M) s ⇒ cgr3 i j v (stb u M i j v) = cgr3 i j v (stb u M i j v) $ by eq_refl
n14: $ G , c = ccom (stf u M) s ⇒ fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , c ⟩ ⟩ = fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , ccom (stf u M) s ⟩ ⟩ $ by fv_eq [n13, n12]
n15u: $ G , c = ccom (stf u M) s ⇒ u = u $ by eq_refl
n15m: $ G , c = ccom (stf u M) s ⇒ M = M $ by eq_refl
n15: $ G , c = ccom (stf u M) s ⇒ stb u M k s c = stb u M k s (ccom (stf u M) s) $ by stb_eq [n15u, n15m, n9, n10, n8]
n16: $ G , c = ccom (stf u M) s ⇒ fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , ccom (stf u M) s ⟩ ⟩ = fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , c ⟩ ⟩ $ by eq_sym [n14]
n17: $ G , c = ccom (stf u M) s ⇒ fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , ccom (stf u M) s ⟩ ⟩ = stb u M k s c $ by eq_trans [n16, n7]
n18: $ G , c = ccom (stf u M) s ⇒ fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , ccom (stf u M) s ⟩ ⟩ = stb u M k s (ccom (stf u M) s) $ by eq_trans [n17, n15]
n19: $ G , c = ccom (stf u M) s ⇒ fv (stf u M) ⟨ k , s ⟩ = fv (cgr3 i j v (stb u M i j v)) ⟨ k , ⟨ s , ccom (stf u M) s ⟩ ⟩ $ by weaken [n2]
n20: $ G , c = ccom (stf u M) s ⇒ fv (stf u M) ⟨ k , s ⟩ = stb u M k s (ccom (stf u M) s) $ by eq_trans [n19, n18]
n21: $ G ⇒ fv (stf u M) ⟨ k , s ⟩ = stb u M k s (ccom (stf u M) s) $ by isset_elim [n5, n20]

--| A pair in a relation has a set first component.
lemma m6_pair_rel_isset (G: hyps) (R A B: class): $ G ⇒ rel R $ > $ G ⇒ ⟨ A , B ⟩ ∈ R $ > $ G ⇒ isset A $
----
r1: $ G , c = ⟨ A , B ⟩ , c ∊ R ⇒ rel R $ by weaken [#1]
r2: $ G , c = ⟨ A , B ⟩ , c ∊ R ⇒ c ∊ R $ by ax
r3a: $ G , c = ⟨ A , B ⟩ , c ∊ R , c = ⟨ x , y ⟩ ⇒ c = ⟨ A , B ⟩ $ by ax
r3b: $ G , c = ⟨ A , B ⟩ , c ∊ R , c = ⟨ x , y ⟩ ⇒ ⟨ A , B ⟩ = c $ by eq_sym [r3a]
r3c: $ G , c = ⟨ A , B ⟩ , c ∊ R , c = ⟨ x , y ⟩ ⇒ c = ⟨ x , y ⟩ $ by ax
r3: $ G , c = ⟨ A , B ⟩ , c ∊ R , c = ⟨ x , y ⟩ ⇒ ⟨ A , B ⟩ = ⟨ x , y ⟩ $ by eq_trans [r3b, r3c]
r4: $ G , c = ⟨ A , B ⟩ , c ∊ R , c = ⟨ x , y ⟩ ⇒ isset A $ by opair_eq_isset [r3]
r5: $ G , c = ⟨ A , B ⟩ , c ∊ R ⇒ isset A $ by rel_elim [r1, r2, r4]
r6: $ G ⇒ isset A $ by wcel_elim [#2, r5]

--| The values of a satisfaction step are valuations.
lemma m6_stb_pair_fseq (G: hyps) (M K S V W: class) (u y: set): $ G ⇒ ⟨ W , y ⟩ ∈ stb u M K S V $ > $ G ⇒ y ∊ fseq u $
----
r1: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V ⇒ c ∊ stb u M K S V $ by ax
r2: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V ⇒ (K = kc_nil ∧ c ∊ (clam g lvals (csn ∅))) ∨ (K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)})) $ by cab_elim [r1]
r3: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) ⇒ K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) $ by ax
r4: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) ⇒ c ∊ (clam g lvals (csn ∅)) $ by and_elim_r [r3]
s1: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ c = ⟨ W , y ⟩ $ by ax
s2: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ c = ⟨ a , b ⟩ $ by ax
s3: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ ⟨ W , y ⟩ = c $ by eq_sym [s1]
s4: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ ⟨ W , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [s3, s2]
s5: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset W $ by opair_eq_isset [s4]
s6: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset y $ by isset_var
s7: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset a $ by isset_var
s8: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset b $ by isset_var
s9: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ W = a ∧ y = b $ by opair_inj_c [s4, s5, s6, s7, s8]
s10: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ y = b $ by and_elim_r [s9]
s11: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ b ∊ csn ∅ $ by ax
s12: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ b = ∅ $ by csn_elim [s11]
s13: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ y = ∅ $ by eq_trans [s10, s12]
s14: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ ∅ ∈ fseq u $ by fseq_empty
s15: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ ∅ = y $ by eq_sym [s13]
s16: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ y ∈ fseq u $ by wcel_eq_l [s15, s14]
s17: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ y ∊ fseq u $ by wcel_welc [s16]
s18: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) ⇒ y ∊ fseq u $ by clam_elim_mem [r4, s17]
t3: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)}) ⇒ K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)}) $ by ax
t4: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)}) ⇒ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)}) $ by and_elim_r [t3]
