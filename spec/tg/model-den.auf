a1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ uadm u $ by ax
a2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
a3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ sat u M (enc_ctx G) w $ by ax
s1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ sat u M (enc_ctx G) w ⊆ fseq u $ by sat_fseq
s2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ fseq u $ by subset_elim [s1, a3]
t1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_lvl lz ∈ trees ω $ by enc_lvl_trees
l1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ w r = fv uni (lv ⟨ kc_lz , ∅ ⟩ w) $ by dt_srt [t1, a2, s2]
l2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ lv ⟨ kc_lz , ∅ ⟩ w = ∅ $ by lv_lz
l3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ uni = uni $ by eq_refl
l4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ fv uni (lv ⟨ kc_lz , ∅ ⟩ w) = fv uni ∅ $ by fv_eq [l3, l2]
l5: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ fv uni ∅ = two $ by uni_zero
l6: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr (srt lz)) w r = fv uni ∅ $ by eq_trans [l1, l4]
l7: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr (srt lz)) w r = two $ by eq_trans [l6, l5]
l8: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr p) w r ∈ dt u M (enc_expr (srt lz)) w r $ by mdeq_mem [#1, a1, a2, a3]
l9: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr p) w r ∈ two $ by wcel_eq_r [l7, l8]
l10: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr h) w r ∈ dt u M (enc_expr p) w r $ by mdeq_mem [#2, a1, a2, a3]
l11: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr h2) w r ∈ dt u M (enc_expr p) w r $ by mdeq_mem [#3, a1, a2, a3]
l12: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr h) w r = dt u M (enc_expr h2) w r $ by two_irrel_c [l9, l10, l11]
l13: $ mdeq M G h h2 p $ by mdeq_i [l12, l10]

minh_ty
-------
a1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ uadm u $ by ax
a2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
a3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ sat u M (enc_ctx G) w $ by ax
l1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r $ by mdeq_mem [#1, a1, a2, a3]
l2: $ v = dt u M (enc_expr e) w r , v ∊ dt u M (enc_expr A) w r ⇒ v ∊ dt u M (enc_expr A) w r $ by ax
l3: $ v = dt u M (enc_expr e) w r , v ∊ dt u M (enc_expr A) w r ⇒ ∃ x (x ∊ dt u M (enc_expr A) w r) $ by ex_intro [l2]
l4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ ∃ x (x ∊ dt u M (enc_expr A) w r) $ by wcel_elim [l1, l3]
l5: $ minh M G A $ by minh_i [l4]
