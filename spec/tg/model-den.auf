l5: $ G ⇒ ¬ kc_pi = kc_srt $ by ne_sym [l4]
l6: $ G ⇒ ¬ K = kc_srt $ by m4_ne_eq [#1, l5]
l7: $ G ⇒ ¬ kc_app = kc_pi $ by kc_app_ne_pi
l8: $ G ⇒ ¬ kc_pi = kc_app $ by ne_sym [l7]
l9: $ G ⇒ ¬ K = kc_app $ by m4_ne_eq [#1, l8]
l10: $ G ⇒ ¬ kc_lam = kc_pi $ by kc_lam_ne_pi
l11: $ G ⇒ ¬ kc_pi = kc_lam $ by ne_sym [l10]
l12: $ G ⇒ ¬ K = kc_lam $ by m4_ne_eq [#1, l11]
l14: $ G ⇒ ¬ kc_pi = kc_proj $ by kc_pi_ne_proj
l15: $ G ⇒ ¬ K = kc_proj $ by m4_ne_eq [#1, l14]
l16: $ G ⇒ kc_pi ∈ kc_cst $ by m4_lt_pi_cst
l17: $ G ⇒ ¬ kc_pi ∈ kexa $ by kexa_notin_lt [l16]
l18: $ G ⇒ ¬ K ∈ kexa $ by m4_nin_eq [#1, l17]
l19: $ G ⇒ kc_pi ∈ kstr $ by kstr_pi
l20: $ G ⇒ kc_pi = K $ by eq_sym [#1]
l21: $ G ⇒ K ∈ kstr $ by wcel_eq_l [l20, l19]
l22: $ G ⇒ ¬ ¬ K ∈ kstr $ by not_not_intro [l21]
l23: $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1)))) $ by m4_dnb_pi [l3, l6, l9, l12, #1, l15, l18, l22]

lemma m4_dnb_proj_k {x0 x1: set} (G: hyps) (M K S V: class) (u: set): $ G ⇒ K = kc_proj $ > $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅)))))) $
----
l1: $ G ⇒ ¬ kc_bvar = kc_proj $ by kc_bvar_ne_proj
l2: $ G ⇒ ¬ kc_proj = kc_bvar $ by ne_sym [l1]
l3: $ G ⇒ ¬ K = kc_bvar $ by m4_ne_eq [#1, l2]
l4: $ G ⇒ ¬ kc_srt = kc_proj $ by kc_srt_ne_proj
l5: $ G ⇒ ¬ kc_proj = kc_srt $ by ne_sym [l4]
l6: $ G ⇒ ¬ K = kc_srt $ by m4_ne_eq [#1, l5]
l7: $ G ⇒ ¬ kc_app = kc_proj $ by kc_app_ne_proj
l8: $ G ⇒ ¬ kc_proj = kc_app $ by ne_sym [l7]
l9: $ G ⇒ ¬ K = kc_app $ by m4_ne_eq [#1, l8]
l10: $ G ⇒ ¬ kc_lam = kc_proj $ by kc_lam_ne_proj
l11: $ G ⇒ ¬ kc_proj = kc_lam $ by ne_sym [l10]
l12: $ G ⇒ ¬ K = kc_lam $ by m4_ne_eq [#1, l11]
l13: $ G ⇒ ¬ kc_pi = kc_proj $ by kc_pi_ne_proj
l14: $ G ⇒ ¬ kc_proj = kc_pi $ by ne_sym [l13]
l15: $ G ⇒ ¬ K = kc_pi $ by m4_ne_eq [#1, l14]
l16: $ G ⇒ ¬ kc_proj ∈ kexa $ by kexa_notin_proj
l17: $ G ⇒ ¬ K ∈ kexa $ by m4_nin_eq [#1, l16]
l18: $ G ⇒ kc_proj ∈ kstr $ by kstr_proj
l19: $ G ⇒ kc_proj = K $ by eq_sym [#1]
l20: $ G ⇒ K ∈ kstr $ by wcel_eq_l [l19, l18]
l21: $ G ⇒ ¬ ¬ K ∈ kstr $ by not_not_intro [l20]
l22: $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅)))))) $ by m4_dnb_proj [l3, l6, l9, l12, l15, #1, l17, l21]

lemma m4_dnb_atom_k {x0 x1: set} (G: hyps) (M K S V: class) (u: set): $ G ⇒ K ∈ kexa $ > $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) $
----
l1: $ G ⇒ kexa ⊆ kstr $ by kexa_kstr
l2: $ G ⇒ K ∈ kstr $ by wcel_subset [l1, #1]
l3: $ G ⇒ kc_bvar ∈ kc_cst $ by m4_lt_bvar_cst
l4: $ G ⇒ ¬ kc_bvar ∈ kexa $ by kexa_notin_lt [l3]
l5: $ G ⇒ ¬ K = kc_bvar $ by m4_ne_in [#1, l4]
l6: $ G ⇒ kc_srt ∈ kc_cst $ by m4_lt_srt_cst
l7: $ G ⇒ ¬ kc_srt ∈ kexa $ by kexa_notin_lt [l6]
l8: $ G ⇒ ¬ K = kc_srt $ by m4_ne_in [#1, l7]
l9: $ G ⇒ kc_app ∈ kc_cst $ by m4_lt_app_cst
l10: $ G ⇒ ¬ kc_app ∈ kexa $ by kexa_notin_lt [l9]
l11: $ G ⇒ ¬ K = kc_app $ by m4_ne_in [#1, l10]
l12: $ G ⇒ kc_lam ∈ kc_cst $ by m4_lt_lam_cst
l13: $ G ⇒ ¬ kc_lam ∈ kexa $ by kexa_notin_lt [l12]
l14: $ G ⇒ ¬ K = kc_lam $ by m4_ne_in [#1, l13]
l15: $ G ⇒ kc_pi ∈ kc_cst $ by m4_lt_pi_cst
l16: $ G ⇒ ¬ kc_pi ∈ kexa $ by kexa_notin_lt [l15]
l17: $ G ⇒ ¬ K = kc_pi $ by m4_ne_in [#1, l16]
l18: $ G ⇒ ¬ kc_proj ∈ kexa $ by kexa_notin_proj
l19: $ G ⇒ ¬ K = kc_proj $ by m4_ne_in [#1, l18]
l20: $ G ⇒ ¬ ¬ K ∈ kstr $ by not_not_intro [l2]
l21: $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0))) $ by m4_dnb_atom [l5, l8, l11, l14, l17, l19, #1, l20]

-- m4: sequence tools in class form.

def m4_V (.x: set): class = $ {x | x = x} $

lemma m4_inV (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ m4_V $
----
l1: $ G , z = A ⇒ z = z $ by eq_refl
l2: $ G ⇒ A ∈ m4_V $ by wcel_cab_intro (p := $ x = x $) [#1, l1]

--| The values of the children of a node with two.
lemma m4_cc2 (G: hyps) (F T T2: class):
  $ G ⇒ functional F $ > $ G ⇒ T ∈ cdm F $ > $ G ⇒ T2 ∈ cdm F $ >
  $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) ∅ = fv F T ∧ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv F T2 $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ ccom F (scons T2 ∅) = scons (fv F T2) (ccom F ∅) $ by ccom_scons_c [#1, #3, l1]
l3: $ G ⇒ ccom F ∅ = ∅ $ by ccom_empty
l4: $ G ⇒ fv F T2 = fv F T2 $ by eq_refl
l5: $ G ⇒ scons (fv F T2) (ccom F ∅) = scons (fv F T2) ∅ $ by scons_eq [l4, l3]
l6: $ G ⇒ ccom F (scons T2 ∅) = scons (fv F T2) ∅ $ by eq_trans [l2, l5]
l7: $ G ⇒ isset T2 $ by wcel_isset [#3]
l8: $ G ⇒ isset (fv F T2) $ by fv_set_c [#1, l7]
l9: $ G ⇒ fv F T2 ∈ m4_V $ by m4_inV [l8]
l10: $ G ⇒ ∅ ∈ fseq m4_V $ by fseq_empty
l11: $ G ⇒ scons (fv F T2) ∅ ∈ fseq m4_V $ by scons_fseq_c [l9, l10]
l12: $ G ⇒ isset (scons (fv F T2) ∅) $ by wcel_isset [l11]
l13: $ G ⇒ scons (fv F T2) ∅ = ccom F (scons T2 ∅) $ by eq_sym [l6]
l14: $ G ⇒ isset (ccom F (scons T2 ∅)) $ by isset_eq [l13, l12]
l15: $ G ⇒ T2 ∈ m4_V $ by m4_inV [l7]
l16: $ G ⇒ scons T2 ∅ ∈ fseq m4_V $ by scons_fseq_c [l15, l10]
l17: $ G ⇒ isset (scons T2 ∅) $ by wcel_isset [l16]
l18: $ G ⇒ ccom F (scons T (scons T2 ∅)) = scons (fv F T) (ccom F (scons T2 ∅)) $ by ccom_scons_c [#1, #2, l17]
l19: $ G ⇒ isset T $ by wcel_isset [#2]
l20: $ G ⇒ isset (fv F T) $ by fv_set_c [#1, l19]
l21: $ G ⇒ fv (scons (fv F T) (ccom F (scons T2 ∅))) ∅ = fv F T $ by scons_fv_zero_c [l20, l14]
l22: $ G ⇒ ∅ = ∅ $ by eq_refl
l23: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) ∅ = fv (scons (fv F T) (ccom F (scons T2 ∅))) ∅ $ by fv_eq [l18, l22]
l24: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) ∅ = fv F T $ by eq_trans [l23, l21]
l25: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l26: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv (scons (fv F T) (ccom F (scons T2 ∅))) (suc ∅) $ by fv_eq [l18, l25]
l27: $ G ⇒ fv (scons (fv F T) (ccom F (scons T2 ∅))) (suc ∅) = fv (ccom F (scons T2 ∅)) ∅ $ by scons_fv_suc_c [l20, l14, l1]
l28: $ G ⇒ fv (ccom F (scons T2 ∅)) ∅ = fv (scons (fv F T2) ∅) ∅ $ by fv_eq [l6, l22]
l29: $ G ⇒ fv (scons (fv F T2) ∅) ∅ = fv F T2 $ by scons_fv_zero_c [l8, l1]
l30: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv (ccom F (scons T2 ∅)) ∅ $ by eq_trans [l26, l27]
l31: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv (scons (fv F T2) ∅) ∅ $ by eq_trans [l30, l28]
l32: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv F T2 $ by eq_trans [l31, l29]
l33: $ G ⇒ fv (ccom F (scons T (scons T2 ∅))) ∅ = fv F T ∧ fv (ccom F (scons T (scons T2 ∅))) (suc ∅) = fv F T2 $ by and_intro [l24, l32]

--| The value of the third child of a node with three.
lemma m4_cc3 (G: hyps) (F T T2 T3: class):
  $ G ⇒ functional F $ > $ G ⇒ T ∈ cdm F $ > $ G ⇒ T2 ∈ cdm F $ > $ G ⇒ T3 ∈ cdm F $ >
  $ G ⇒ fv (ccom F (scons T (scons T2 (scons T3 ∅)))) (suc (suc ∅)) = fv F T3 $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ ccom F (scons T3 ∅) = scons (fv F T3) (ccom F ∅) $ by ccom_scons_c [#1, #4, l1]
l3: $ G ⇒ ccom F ∅ = ∅ $ by ccom_empty
l4: $ G ⇒ fv F T3 = fv F T3 $ by eq_refl
l5: $ G ⇒ scons (fv F T3) (ccom F ∅) = scons (fv F T3) ∅ $ by scons_eq [l4, l3]
l6: $ G ⇒ ccom F (scons T3 ∅) = scons (fv F T3) ∅ $ by eq_trans [l2, l5]
l7: $ G ⇒ isset T3 $ by wcel_isset [#4]
l8: $ G ⇒ isset (fv F T3) $ by fv_set_c [#1, l7]
l9: $ G ⇒ fv F T3 ∈ m4_V $ by m4_inV [l8]
l10: $ G ⇒ ∅ ∈ fseq m4_V $ by fseq_empty
l11: $ G ⇒ scons (fv F T3) ∅ ∈ fseq m4_V $ by scons_fseq_c [l9, l10]
l12: $ G ⇒ scons (fv F T3) ∅ = ccom F (scons T3 ∅) $ by eq_sym [l6]
l13: $ G ⇒ ccom F (scons T3 ∅) ∈ fseq m4_V $ by wcel_eq_l [l12, l11]
l14: $ G ⇒ isset (ccom F (scons T3 ∅)) $ by wcel_isset [l13]
l15: $ G ⇒ T3 ∈ m4_V $ by m4_inV [l7]
l16: $ G ⇒ scons T3 ∅ ∈ fseq m4_V $ by scons_fseq_c [l15, l10]
l17: $ G ⇒ isset (scons T3 ∅) $ by wcel_isset [l16]
l18: $ G ⇒ ccom F (scons T2 (scons T3 ∅)) = scons (fv F T2) (ccom F (scons T3 ∅)) $ by ccom_scons_c [#1, #3, l17]
l19: $ G ⇒ isset T2 $ by wcel_isset [#3]
l20: $ G ⇒ isset (fv F T2) $ by fv_set_c [#1, l19]
l21: $ G ⇒ fv F T2 ∈ m4_V $ by m4_inV [l20]
l22: $ G ⇒ scons (fv F T2) (ccom F (scons T3 ∅)) ∈ fseq m4_V $ by scons_fseq_c [l21, l13]
l23: $ G ⇒ scons (fv F T2) (ccom F (scons T3 ∅)) = ccom F (scons T2 (scons T3 ∅)) $ by eq_sym [l18]
l24: $ G ⇒ ccom F (scons T2 (scons T3 ∅)) ∈ fseq m4_V $ by wcel_eq_l [l23, l22]
l25: $ G ⇒ isset (ccom F (scons T2 (scons T3 ∅))) $ by wcel_isset [l24]
l26: $ G ⇒ T2 ∈ m4_V $ by m4_inV [l19]
l27: $ G ⇒ scons T2 (scons T3 ∅) ∈ fseq m4_V $ by scons_fseq_c [l26, l16]
l28: $ G ⇒ isset (scons T2 (scons T3 ∅)) $ by wcel_isset [l27]
l29: $ G ⇒ ccom F (scons T (scons T2 (scons T3 ∅))) = scons (fv F T) (ccom F (scons T2 (scons T3 ∅))) $ by ccom_scons_c [#1, #2, l28]
l30: $ G ⇒ isset T $ by wcel_isset [#2]
l31: $ G ⇒ isset (fv F T) $ by fv_set_c [#1, l30]
l32: $ G ⇒ isset (suc ∅) $ by suc_set [l1]
l33: $ G ⇒ suc (suc ∅) = suc (suc ∅) $ by eq_refl
l34: $ G ⇒ fv (ccom F (scons T (scons T2 (scons T3 ∅)))) (suc (suc ∅)) = fv (scons (fv F T) (ccom F (scons T2 (scons T3 ∅)))) (suc (suc ∅)) $ by fv_eq [l29, l33]
l35: $ G ⇒ fv (scons (fv F T) (ccom F (scons T2 (scons T3 ∅)))) (suc (suc ∅)) = fv (ccom F (scons T2 (scons T3 ∅))) (suc ∅) $ by scons_fv_suc_c [l31, l25, l32]
l36: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
l37: $ G ⇒ fv (ccom F (scons T2 (scons T3 ∅))) (suc ∅) = fv (scons (fv F T2) (ccom F (scons T3 ∅))) (suc ∅) $ by fv_eq [l18, l36]
l38: $ G ⇒ fv (scons (fv F T2) (ccom F (scons T3 ∅))) (suc ∅) = fv (ccom F (scons T3 ∅)) ∅ $ by scons_fv_suc_c [l20, l14, l1]
l39: $ G ⇒ ∅ = ∅ $ by eq_refl
l40: $ G ⇒ fv (ccom F (scons T3 ∅)) ∅ = fv (scons (fv F T3) ∅) ∅ $ by fv_eq [l6, l39]
l41: $ G ⇒ fv (scons (fv F T3) ∅) ∅ = fv F T3 $ by scons_fv_zero_c [l8, l1]
l42: $ G ⇒ fv (ccom F (scons T (scons T2 (scons T3 ∅)))) (suc (suc ∅)) = fv (ccom F (scons T2 (scons T3 ∅))) (suc ∅) $ by eq_trans [l34, l35]
l43: $ G ⇒ fv (ccom F (scons T (scons T2 (scons T3 ∅)))) (suc (suc ∅)) = fv (scons (fv F T2) (ccom F (scons T3 ∅))) (suc ∅) $ by eq_trans [l42, l37]
l44: $ G ⇒ fv (ccom F (scons T (scons T2 (scons T3 ∅)))) (suc (suc ∅)) = fv (ccom F (scons T3 ∅)) ∅ $ by eq_trans [l43, l38]
l45: $ G ⇒ fv (ccom F (scons T (scons T2 (scons T3 ∅)))) (suc (suc ∅)) = fv (scons (fv F T3) ∅) ∅ $ by eq_trans [l44, l40]
l46: $ G ⇒ fv (ccom F (scons T (scons T2 (scons T3 ∅)))) (suc (suc ∅)) = fv F T3 $ by eq_trans [l45, l41]

--| The second entry of a sequence of three.
lemma m4_s3_1 (G: hyps) (T T2 T3: class):
  $ G ⇒ isset T $ > $ G ⇒ isset T2 $ > $ G ⇒ isset T3 $ > $ G ⇒ fv (scons T (scons T2 (scons T3 ∅))) (suc ∅) = T2 $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ T3 ∈ m4_V $ by m4_inV [#3]
l3: $ G ⇒ ∅ ∈ fseq m4_V $ by fseq_empty
l4: $ G ⇒ scons T3 ∅ ∈ fseq m4_V $ by scons_fseq_c [l2, l3]
l5: $ G ⇒ T2 ∈ m4_V $ by m4_inV [#2]
l6: $ G ⇒ scons T2 (scons T3 ∅) ∈ fseq m4_V $ by scons_fseq_c [l5, l4]
l7: $ G ⇒ isset (scons T2 (scons T3 ∅)) $ by wcel_isset [l6]
l8: $ G ⇒ isset (scons T3 ∅) $ by wcel_isset [l4]
l9: $ G ⇒ fv (scons T (scons T2 (scons T3 ∅))) (suc ∅) = fv (scons T2 (scons T3 ∅)) ∅ $ by scons_fv_suc_c [#1, l7, l1]
l10: $ G ⇒ fv (scons T2 (scons T3 ∅)) ∅ = T2 $ by scons_fv_zero_c [#2, l8]
l11: $ G ⇒ fv (scons T (scons T2 (scons T3 ∅))) (suc ∅) = T2 $ by eq_trans [l9, l10]

dt_app
------
l1: $ G ⇒ kc_app ∈ ω $ by kc_app_omega
l2: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l3: $ G ⇒ scons T2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l2]
l4: $ G ⇒ scons T (scons T2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l3]
l5: $ G ⇒ functional (dnf u M) $ by dnf_functional
l6: $ G ⇒ cdm (dnf u M) = trees ω $ by dnf_cdm
l7: $ G ⇒ trees ω = cdm (dnf u M) $ by eq_sym [l6]
l8: $ G ⇒ T ∈ cdm (dnf u M) $ by wcel_eq_r [l7, #1]
l9: $ G ⇒ T2 ∈ cdm (dnf u M) $ by wcel_eq_r [l7, #2]
l10: $ G ⇒ fv (ccom (dnf u M) (scons T (scons T2 ∅))) ∅ = fv (dnf u M) T ∧ fv (ccom (dnf u M) (scons T (scons T2 ∅))) (suc ∅) = fv (dnf u M) T2 $ by m4_cc2 [l5, l8, l9]
l11: $ G ⇒ fv (ccom (dnf u M) (scons T (scons T2 ∅))) ∅ = fv (dnf u M) T $ by and_elim_l [l10]
l12: $ G ⇒ fv (ccom (dnf u M) (scons T (scons T2 ∅))) (suc ∅) = fv (dnf u M) T2 $ by and_elim_r [l10]
l13: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ k ∊ ω $ by ax
l14: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ h ∊ fseq (trees ω) $ by ax
l15: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ k , h ⟩ = dnb u M k h (ccom (dnf u M) h) $ by dnf_node [l13, l14]
l16: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ k = kc_app $ by ax
l17: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ dnb u M k h (ccom (dnf u M) h) = clam x0 lvals (clam x1 (fseq u) (ap (da (fv (ccom (dnf u M) h) ∅) x0 x1) (da (fv (ccom (dnf u M) h) (suc ∅)) x0 x1))) $ by m4_dnb_app_k [l16]
l18: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ k , h ⟩ = clam x0 lvals (clam x1 (fseq u) (ap (da (fv (ccom (dnf u M) h) ∅) x0 x1) (da (fv (ccom (dnf u M) h) (suc ∅)) x0 x1))) $ by eq_trans [l15, l17]
l19: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ w ∊ lvals $ by weaken [#3]
l20: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ r ∊ fseq u $ by weaken [#4]
l21: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ w = w $ by eq_refl
l22: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (fv (dnf u M) ⟨ k , h ⟩) w = ap (clam x0 lvals (clam x1 (fseq u) (ap (da (fv (ccom (dnf u M) h) ∅) x0 x1) (da (fv (ccom (dnf u M) h) (suc ∅)) x0 x1)))) w $ by ap_eq [l18, l21]
l23: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (clam x0 lvals (clam x1 (fseq u) (ap (da (fv (ccom (dnf u M) h) ∅) x0 x1) (da (fv (ccom (dnf u M) h) (suc ∅)) x0 x1)))) w = clam x1 (fseq u) (ap (da (fv (ccom (dnf u M) h) ∅) w x1) (da (fv (ccom (dnf u M) h) (suc ∅)) w x1)) $ by clam_ap [l19]
l24: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (fv (dnf u M) ⟨ k , h ⟩) w = clam x1 (fseq u) (ap (da (fv (ccom (dnf u M) h) ∅) w x1) (da (fv (ccom (dnf u M) h) (suc ∅)) w x1)) $ by eq_trans [l22, l23]
l25: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ r = r $ by eq_refl
l26: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (ap (fv (dnf u M) ⟨ k , h ⟩) w) r = ap (clam x1 (fseq u) (ap (da (fv (ccom (dnf u M) h) ∅) w x1) (da (fv (ccom (dnf u M) h) (suc ∅)) w x1))) r $ by ap_eq [l24, l25]
l27: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (clam x1 (fseq u) (ap (da (fv (ccom (dnf u M) h) ∅) w x1) (da (fv (ccom (dnf u M) h) (suc ∅)) w x1))) r = ap (da (fv (ccom (dnf u M) h) ∅) w r) (da (fv (ccom (dnf u M) h) (suc ∅)) w r) $ by clam_ap [l20]
l28: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (ap (fv (dnf u M) ⟨ k , h ⟩) w) r = ap (da (fv (ccom (dnf u M) h) ∅) w r) (da (fv (ccom (dnf u M) h) (suc ∅)) w r) $ by eq_trans [l26, l27]
l29: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ h = scons T (scons T2 ∅) $ by ax
l30: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ dnf u M = dnf u M $ by eq_refl
l31: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ccom (dnf u M) h = ccom (dnf u M) (scons T (scons T2 ∅)) $ by ccom_eq [l30, l29]
l32: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ∅ = ∅ $ by eq_refl
l33: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (ccom (dnf u M) h) ∅ = fv (ccom (dnf u M) (scons T (scons T2 ∅))) ∅ $ by fv_eq [l31, l32]
l34: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (ccom (dnf u M) (scons T (scons T2 ∅))) ∅ = fv (dnf u M) T $ by weaken [l11]
l35: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (ccom (dnf u M) h) ∅ = fv (dnf u M) T $ by eq_trans [l33, l34]
l36: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ suc ∅ = suc ∅ $ by eq_refl
l37: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (ccom (dnf u M) h) (suc ∅) = fv (ccom (dnf u M) (scons T (scons T2 ∅))) (suc ∅) $ by fv_eq [l31, l36]
l38: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (ccom (dnf u M) (scons T (scons T2 ∅))) (suc ∅) = fv (dnf u M) T2 $ by weaken [l12]
l39: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (ccom (dnf u M) h) (suc ∅) = fv (dnf u M) T2 $ by eq_trans [l37, l38]
l40: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (fv (ccom (dnf u M) h) ∅) w = ap (fv (dnf u M) T) w $ by ap_eq [l35, l21]
l41: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ da (fv (ccom (dnf u M) h) ∅) w r = dt u M T w r $ by ap_eq [l40, l25]
l42: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (fv (ccom (dnf u M) h) (suc ∅)) w = ap (fv (dnf u M) T2) w $ by ap_eq [l39, l21]
l43: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ da (fv (ccom (dnf u M) h) (suc ∅)) w r = dt u M T2 w r $ by ap_eq [l42, l25]
l44: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (da (fv (ccom (dnf u M) h) ∅) w r) (da (fv (ccom (dnf u M) h) (suc ∅)) w r) = ap (dt u M T w r) (dt u M T2 w r) $ by ap_eq [l41, l43]
l45: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (ap (fv (dnf u M) ⟨ k , h ⟩) w) r = ap (dt u M T w r) (dt u M T2 w r) $ by eq_trans [l28, l44]
l46: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ kc_app = k $ by eq_sym [l16]
l47: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ scons T (scons T2 ∅) = h $ by eq_sym [l29]
l48: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ⟨ kc_app , scons T (scons T2 ∅) ⟩ = ⟨ k , h ⟩ $ by opair_eq [l46, l47]
l49: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ kc_app , scons T (scons T2 ∅) ⟩ = fv (dnf u M) ⟨ k , h ⟩ $ by fv_eq [l30, l48]
l50: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (fv (dnf u M) ⟨ kc_app , scons T (scons T2 ∅) ⟩) w = ap (fv (dnf u M) ⟨ k , h ⟩) w $ by ap_eq [l49, l21]
l51: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ ap (ap (fv (dnf u M) ⟨ kc_app , scons T (scons T2 ∅) ⟩) w) r = ap (ap (fv (dnf u M) ⟨ k , h ⟩) w) r $ by ap_eq [l50, l25]
l52: $ G , k = kc_app , k ∊ ω , h = scons T (scons T2 ∅) , h ∊ fseq (trees ω) ⇒ dt u M ⟨ kc_app , scons T (scons T2 ∅) ⟩ w r = ap (dt u M T w r) (dt u M T2 w r) $ by eq_trans [l51, l45]
