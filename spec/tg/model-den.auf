g3: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M T w r = dt u M T W R $ by dt_eq [e5, e6, g1, e1, e3]
g4: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ x = x $ by eq_refl
g5: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ scons x r = scons x R $ by scons_eq [g4, e3]
g6: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M T2 w (scons x r) = dt u M T2 W (scons x R) $ by dt_eq [e5, e6, g2, e1, g5]
g7: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u , x ∊ dt u M T w r ⇒ dt u M T2 w (scons x r) = dt u M T2 W (scons x R) $ by weaken [g6]
g8: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ x ∊ dt u M T w r → dt u M T2 w (scons x r) = dt u M T2 W (scons x R) $ by imp_intro [g7]
g9: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ ∀ x (x ∊ dt u M T w r → dt u M T2 w (scons x r) = dt u M T2 W (scons x R)) $ by all_intro [g8]
q3: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ cpi x (dt u M T w r) (dt u M T2 w (scons x r)) = cpi x (dt u M T W R) (dt u M T2 W (scons x R)) $ by cpi_eq_pt [g3, g9]
q4: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ kc_pi , scons T (scons T2 ∅) ⟩ W R = cpi x (dt u M T W R) (dt u M T2 W (scons x R)) $ by eq_trans [q2, q3]
f1: $ G , w = W , w ∊ lvals ⇒ dt u M ⟨ kc_pi , scons T (scons T2 ∅) ⟩ W R = cpi x (dt u M T W R) (dt u M T2 W (scons x R)) $ by wcel_elim [#4, q4]
f2: $ G ⇒ dt u M ⟨ kc_pi , scons T (scons T2 ∅) ⟩ W R = cpi x (dt u M T W R) (dt u M T2 W (scons x R)) $ by wcel_elim [#3, f1]

dt_proj_c
---------
e1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ w = W $ by ax
e2: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ W = w $ by eq_sym [e1]
e3: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ r = R $ by ax
e4: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ R = r $ by eq_sym [e3]
e5: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ u = u $ by eq_refl
e6: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ M = M $ by eq_refl
e7: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ = ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ $ by eq_refl
h0: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ T ∈ trees ω $ by weaken [#1]
h1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ T2 ∈ trees ω $ by weaken [#2]
h2: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ T3 ∈ trees ω $ by weaken [#3]
hw: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ w ∊ lvals $ by ax
hr: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
s1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ w r = fv (dt u M T3 w r) (suc (fv nvf T2)) $ by dt_proj [h0, h1, h2, hw, hr]
q1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ W R = dt u M ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ w r $ by dt_eq [e5, e6, e7, e2, e4]
q2: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ W R = fv (dt u M T3 w r) (suc (fv nvf T2)) $ by eq_trans [q1, s1]
g1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ T3 = T3 $ by eq_refl
g2: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M T3 w r = dt u M T3 W R $ by dt_eq [e5, e6, g1, e1, e3]
g3: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ suc (fv nvf T2) = suc (fv nvf T2) $ by eq_refl
q3: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ fv (dt u M T3 w r) (suc (fv nvf T2)) = fv (dt u M T3 W R) (suc (fv nvf T2)) $ by fv_eq [g2, g3]
q4: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ W R = fv (dt u M T3 W R) (suc (fv nvf T2)) $ by eq_trans [q2, q3]
f1: $ G , w = W , w ∊ lvals ⇒ dt u M ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ W R = fv (dt u M T3 W R) (suc (fv nvf T2)) $ by wcel_elim [#5, q4]
f2: $ G ⇒ dt u M ⟨ kc_proj , scons T (scons T2 (scons T3 ∅)) ⟩ W R = fv (dt u M T3 W R) (suc (fv nvf T2)) $ by wcel_elim [#4, f1]

dt_atom_c
---------
e1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ w = W $ by ax
e2: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ W = w $ by eq_sym [e1]
e3: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ r = R $ by ax
e4: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ R = r $ by eq_sym [e3]
e5: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ u = u $ by eq_refl
e6: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ M = M $ by eq_refl
e7: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ ⟨ K , S ⟩ = ⟨ K , S ⟩ $ by eq_refl
h0: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ K ∈ kexa $ by weaken [#1]
h1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ S ∈ fseq (trees ω) $ by weaken [#2]
hw: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ w ∊ lvals $ by ax
hr: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
s1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ K , S ⟩ w r = mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) $ by dt_atom [h0, h1, hw, hr]
q1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ K , S ⟩ W R = dt u M ⟨ K , S ⟩ w r $ by dt_eq [e5, e6, e7, e2, e4]
q2: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ K , S ⟩ W R = mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) $ by eq_trans [q1, s1]
g1: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩ = fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩ $ by eq_refl
g2: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w = ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) W $ by ap_eq [g1, e1]
q3: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) = mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) W) $ by mclip_eq [e5, g2]
q4: $ G , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M ⟨ K , S ⟩ W R = mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) W) $ by eq_trans [q2, q3]
f1: $ G , w = W , w ∊ lvals ⇒ dt u M ⟨ K , S ⟩ W R = mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) W) $ by wcel_elim [#4, q4]
f2: $ G ⇒ dt u M ⟨ K , S ⟩ W R = mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) W) $ by wcel_elim [#3, f1]

lemma m5_s1 (G: hyps) (x: set):
  $ G ⇒ x ∈ trees ω $ > $ G ⇒ scons x ∅ ∈ fseq (trees ω) $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons x ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#1, l1]

lemma m5_s2 (G: hyps) (x y: set):
  $ G ⇒ x ∈ trees ω $ > $ G ⇒ y ∈ trees ω $ > $ G ⇒ scons x (scons y ∅) ∈ fseq (trees ω) $
----
l1: $ G ⇒ scons y ∅ ∈ fseq (trees ω) $ by m5_s1 [#2]
l2: $ G ⇒ scons x (scons y ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l1]

lemma m5_s3 (G: hyps) (x y c: set):
  $ G ⇒ x ∈ trees ω $ > $ G ⇒ y ∈ trees ω $ > $ G ⇒ c ∈ trees ω $ >
  $ G ⇒ scons x (scons y (scons c ∅)) ∈ fseq (trees ω) $
----
l1: $ G ⇒ scons y (scons c ∅) ∈ fseq (trees ω) $ by m5_s2 [#2, #3]
l2: $ G ⇒ scons x (scons y (scons c ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l1]

lemma m5_crn (G: hyps) (X K S: class) (z k s: set):
  $ G ⇒ crn s ⊆ X $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset S $ >
  $ G ⇒ crn S ⊆ X $
----
l1: $ G ⇒ ⟨ k , s ⟩ = z $ by eq_sym [#2]
l2: $ G ⇒ ⟨ k , s ⟩ = ⟨ K , S ⟩ $ by eq_trans [l1, #3]
l3: $ G ⇒ isset k $ by isset_var
l4: $ G ⇒ isset s $ by isset_var
l5: $ G ⇒ k = K ∧ s = S $ by opair_inj_c [l2, l3, l4, #4, #5]
l6: $ G ⇒ s = S $ by and_elim_r [l5]
l7: $ G ⇒ crn s = crn S $ by crn_eq [l6]
l8: $ G ⇒ crn S ⊆ X $ by subset_eq_l [l7, #1]

lemma m5_zin (G: hyps) (M T: class) (u z w r: set):
  $ G ⇒ z = T $ > $ G ⇒ dt u M T w r ∈ u $ > $ G ⇒ dt u M z w r ∈ u $
----
l1: $ G ⇒ u = u $ by eq_refl
l2: $ G ⇒ M = M $ by eq_refl
l3: $ G ⇒ w = w $ by eq_refl
l4: $ G ⇒ r = r $ by eq_refl
l5: $ G ⇒ dt u M z w r = dt u M T w r $ by dt_eq [l1, l2, #1, l3, l4]
l6: $ G ⇒ dt u M T w r = dt u M z w r $ by eq_sym [l5]
l7: $ G ⇒ dt u M z w r ∈ u $ by wcel_eq_l [l6, #2]

lemma m5_ih {a q: set} (G: hyps a q) (M: class) (u w x: set):
  $ G ⇒ x ∈ {a | a ∊ ofsort lsig lopen ks_expr → ∀ q (q ∊ fseq u → dt u M a w q ∈ u)} $ > $ G ⇒ x ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ∀ q (q ∊ fseq u → dt u M x w q ∈ u) $
----
l1: $ G ⇒ x ∊ {a | a ∊ ofsort lsig lopen ks_expr → ∀ q (q ∊ fseq u → dt u M a w q ∈ u)} $ by wcel_welc [#1]
l2: $ G ⇒ x ∊ ofsort lsig lopen ks_expr → ∀ q (q ∊ fseq u → dt u M x w q ∈ u) $ by cab_elim [l1]
l3: $ G ⇒ ∀ q (q ∊ fseq u → dt u M x w q ∈ u) $ by imp_elim [l2, #2]

lemma m5_ihc {q: set} (G: hyps q) (M R: class) (u w e: set):
  $ G ⇒ ∀ q (q ∊ fseq u → dt u M e w q ∈ u) $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ dt u M e w R ∈ u $
----
l1: $ G , v = R , v ∊ fseq u ⇒ ∀ q (q ∊ fseq u → dt u M e w q ∈ u) $ by weaken [#1]
l2: $ G , v = R , v ∊ fseq u ⇒ v ∊ fseq u → dt u M e w v ∈ u $ by all_elim [l1]
l3: $ G , v = R , v ∊ fseq u ⇒ v ∊ fseq u $ by ax
l4: $ G , v = R , v ∊ fseq u ⇒ dt u M e w v ∈ u $ by imp_elim [l2, l3]
l5: $ G , v = R , v ∊ fseq u ⇒ u = u $ by eq_refl
l6: $ G , v = R , v ∊ fseq u ⇒ M = M $ by eq_refl
l7: $ G , v = R , v ∊ fseq u ⇒ e = e $ by eq_refl
l8: $ G , v = R , v ∊ fseq u ⇒ w = w $ by eq_refl
l9: $ G , v = R , v ∊ fseq u ⇒ v = R $ by ax
l10: $ G , v = R , v ∊ fseq u ⇒ dt u M e w v = dt u M e w R $ by dt_eq [l5, l6, l7, l8, l9]
l11: $ G , v = R , v ∊ fseq u ⇒ dt u M e w R ∈ u $ by wcel_eq_l [l10, l4]
l12: $ G ⇒ dt u M e w R ∈ u $ by wcel_elim [#2, l11]

lemma m5_fvr (G: hyps) (I: class) (u r: set):
  $ G ⇒ uadm u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ isset I $ > $ G ⇒ fv r I ∈ u $
----
l1: $ G , i = I ⇒ i ∊ cdm r ∨ ¬ i ∊ cdm r $ by excluded_middle
l2: $ G , i = I , i ∊ cdm r ⇒ r ∊ fseq u $ by weaken [#2]
l3: $ G , i = I , i ∊ cdm r ⇒ i ∊ cdm r $ by ax
l4: $ G , i = I , i ∊ cdm r ⇒ fv r i ∈ u $ by fseq_fv [l2, l3]
l5: $ G , i = I , ¬ i ∊ cdm r , i ∊ cdm r ⇒ ¬ i ∊ cdm r $ by ax
l6: $ G , i = I , ¬ i ∊ cdm r , i ∊ cdm r ⇒ i ∊ cdm r $ by ax
l7: $ G , i = I , ¬ i ∊ cdm r , i ∊ cdm r ⇒ ⊥ $ by not_elim [l5, l6]
l8: $ G , i = I , ¬ i ∊ cdm r ⇒ i ∊ cdm r → ⊥ $ by imp_intro [l7]
l9: $ G , i = I , ¬ i ∊ cdm r ⇒ fv r i = ∅ $ by fv_empty [l8]
l10: $ G , i = I , ¬ i ∊ cdm r ⇒ uadm u $ by weaken [#1]
l11: $ G , i = I , ¬ i ∊ cdm r ⇒ ∅ ∈ u $ by uadm_empty [l10]
l12: $ G , i = I , ¬ i ∊ cdm r ⇒ ∅ = fv r i $ by eq_sym [l9]
l13: $ G , i = I , ¬ i ∊ cdm r ⇒ fv r i ∈ u $ by wcel_eq_l [l12, l11]
l14: $ G , i = I ⇒ fv r i ∈ u $ by or_elim [l1, l4, l13]
l15: $ G , i = I ⇒ r = r $ by eq_refl
l16: $ G , i = I ⇒ i = I $ by ax
l17: $ G , i = I ⇒ fv r i = fv r I $ by fv_eq [l15, l16]
l18: $ G , i = I ⇒ fv r I ∈ u $ by wcel_eq_l [l17, l14]
l19: $ G ⇒ fv r I ∈ u $ by isset_elim [#3, l18]

lemma m5_atom (G: hyps) (M K S: class) (u w r: set):
  $ G ⇒ uadm u $ > $ G ⇒ K ∈ kexa $ > $ G ⇒ S ∈ fseq (trees ω) $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ >
  $ G ⇒ dt u M ⟨ K , S ⟩ w r ∈ u $
----
l1: $ G ⇒ dt u M ⟨ K , S ⟩ w r = mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) $ by dt_atom [#2, #3, #4, #5]
l2: $ G ⇒ ∅ ∈ u $ by uadm_empty [#1]
l3: $ G ⇒ mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) ∈ u $ by mclip_u [l2]
l4: $ G ⇒ mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , ccom (dnf u M) S ⟩ ⟩ ⟩) w) = dt u M ⟨ K , S ⟩ w r $ by eq_sym [l1]
l5: $ G ⇒ dt u M ⟨ K , S ⟩ w r ∈ u $ by wcel_eq_l [l4, l3]

lemma m5_a1 (G: hyps) (M K K1: class) (u w r z d: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ K ∈ kexa $ >
  $ G ⇒ z = ⟨ K , scons d ∅ ⟩ ∧ d ∊ ofsort lsig lopen K1 $ > $ G ⇒ dt u M z w r ∈ u $
----
l1: $ G ⇒ z = ⟨ K , scons d ∅ ⟩ $ by and_elim_l [#5]
l2: $ G ⇒ d ∊ ofsort lsig lopen K1 $ by and_elim_r [#5]
l3: $ G ⇒ d ∈ trees ω $ by lsig_ofsort_trees [l2]
l4: $ G ⇒ scons d ∅ ∈ fseq (trees ω) $ by m5_s1 [l3]
l5: $ G ⇒ dt u M ⟨ K , scons d ∅ ⟩ w r ∈ u $ by m5_atom [#1, #4, l4, #2, #3]
l6: $ G ⇒ dt u M z w r ∈ u $ by m5_zin [l1, l5]

lemma m5_a2 (G: hyps) (M K K1 K2: class) (u w r z d e: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ K ∈ kexa $ >
  $ G ⇒ z = ⟨ K , scons d (scons e ∅) ⟩ ∧ d ∊ ofsort lsig lopen K1 ∧ e ∊ ofsort lsig lopen K2 $ > $ G ⇒ dt u M z w r ∈ u $
----
l1: $ G ⇒ z = ⟨ K , scons d (scons e ∅) ⟩ $ by and_elim_l [#5]
l2: $ G ⇒ d ∊ ofsort lsig lopen K1 ∧ e ∊ ofsort lsig lopen K2 $ by and_elim_r [#5]
l3: $ G ⇒ d ∊ ofsort lsig lopen K1 $ by and_elim_l [l2]
l4: $ G ⇒ e ∊ ofsort lsig lopen K2 $ by and_elim_r [l2]
l5: $ G ⇒ d ∈ trees ω $ by lsig_ofsort_trees [l3]
l6: $ G ⇒ e ∈ trees ω $ by lsig_ofsort_trees [l4]
l7: $ G ⇒ scons d (scons e ∅) ∈ fseq (trees ω) $ by m5_s2 [l5, l6]
l8: $ G ⇒ dt u M ⟨ K , scons d (scons e ∅) ⟩ w r ∈ u $ by m5_atom [#1, #4, l7, #2, #3]
l9: $ G ⇒ dt u M z w r ∈ u $ by m5_zin [l1, l8]

lemma m5_a3 (G: hyps) (M K K1 K2 K3: class) (u w r z d e f: set):
  $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ K ∈ kexa $ >
  $ G ⇒ z = ⟨ K , scons d (scons e (scons f ∅)) ⟩ ∧ d ∊ ofsort lsig lopen K1 ∧ e ∊ ofsort lsig lopen K2 ∧ f ∊ ofsort lsig lopen K3 $ > $ G ⇒ dt u M z w r ∈ u $
----
l1: $ G ⇒ z = ⟨ K , scons d (scons e (scons f ∅)) ⟩ $ by and_elim_l [#5]
l2: $ G ⇒ d ∊ ofsort lsig lopen K1 ∧ e ∊ ofsort lsig lopen K2 ∧ f ∊ ofsort lsig lopen K3 $ by and_elim_r [#5]
l3: $ G ⇒ d ∊ ofsort lsig lopen K1 $ by and_elim_l [l2]
l4: $ G ⇒ e ∊ ofsort lsig lopen K2 ∧ f ∊ ofsort lsig lopen K3 $ by and_elim_r [l2]
l5: $ G ⇒ e ∊ ofsort lsig lopen K2 $ by and_elim_l [l4]
l6: $ G ⇒ f ∊ ofsort lsig lopen K3 $ by and_elim_r [l4]
l7: $ G ⇒ d ∈ trees ω $ by lsig_ofsort_trees [l3]
l8: $ G ⇒ e ∈ trees ω $ by lsig_ofsort_trees [l5]
l9: $ G ⇒ f ∈ trees ω $ by lsig_ofsort_trees [l6]
l10: $ G ⇒ scons d (scons e (scons f ∅)) ∈ fseq (trees ω) $ by m5_s3 [l7, l8, l9]
l11: $ G ⇒ dt u M ⟨ K , scons d (scons e (scons f ∅)) ⟩ w r ∈ u $ by m5_atom [#1, #4, l10, #2, #3]
l12: $ G ⇒ dt u M z w r ∈ u $ by m5_zin [l1, l11]

