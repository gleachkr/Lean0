l1: $ (⟦ x / t ⟧ {z | ((C = kc_bvar) ∧ (z ∊ (clam w lvals (clam r (fseq A) (fv r (fv nvf (fv D ∅))))))) ∨ (((C = kc_srt) ∧ (z ∊ (clam w lvals (clam r (fseq A) (fv uni (lv (fv D ∅) w)))))) ∨ (((C = kc_app) ∧ (z ∊ (clam w lvals (clam r (fseq A) (ap (da (fv E ∅) w r) (da (fv E (suc ∅)) w r)))))) ∨ (((C = kc_lam) ∧ (z ∊ (clam w lvals (clam r (fseq A) (clam y (da (fv E ∅) w r) (da (fv E (suc ∅)) w (scons y r))))))) ∨ (((C = kc_pi) ∧ (z ∊ (clam w lvals (clam r (fseq A) (cpi y (da (fv E ∅) w r) (da (fv E (suc ∅)) w (scons y r))))))) ∨ (((C = kc_proj) ∧ (z ∊ (clam w lvals (clam r (fseq A) (fv (da (fv E (suc (suc ∅))) w r) (suc (fv nvf (fv D (suc ∅))))))))) ∨ (((C ∈ kexa) ∧ (z ∊ (clam w lvals (clam r (fseq A) (mclip A (ap (fv B ⟨ A , ⟨ C , ⟨ D , E ⟩ ⟩ ⟩) w)))))) ∨ ((¬ (C ∈ kstr)) ∧ (z ∊ (sclip (fv B ⟨ A , ⟨ C , ⟨ D , E ⟩ ⟩ ⟩))))))))))}) ≐ {z | (((⟦ x / t ⟧ C) = kc_bvar) ∧ (z ∊ (clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (fv r (fv nvf (fv (⟦ x / t ⟧ D) ∅))))))) ∨ ((((⟦ x / t ⟧ C) = kc_srt) ∧ (z ∊ (clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (fv uni (lv (fv (⟦ x / t ⟧ D) ∅) w)))))) ∨ ((((⟦ x / t ⟧ C) = kc_app) ∧ (z ∊ (clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (ap (da (fv (⟦ x / t ⟧ E) ∅) w r) (da (fv (⟦ x / t ⟧ E) (suc ∅)) w r)))))) ∨ ((((⟦ x / t ⟧ C) = kc_lam) ∧ (z ∊ (clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (clam y (da (fv (⟦ x / t ⟧ E) ∅) w r) (da (fv (⟦ x / t ⟧ E) (suc ∅)) w (scons y r))))))) ∨ ((((⟦ x / t ⟧ C) = kc_pi) ∧ (z ∊ (clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (cpi y (da (fv (⟦ x / t ⟧ E) ∅) w r) (da (fv (⟦ x / t ⟧ E) (suc ∅)) w (scons y r))))))) ∨ ((((⟦ x / t ⟧ C) = kc_proj) ∧ (z ∊ (clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (fv (da (fv (⟦ x / t ⟧ E) (suc (suc ∅))) w r) (suc (fv nvf (fv (⟦ x / t ⟧ D) (suc ∅))))))))) ∨ ((((⟦ x / t ⟧ C) ∈ kexa) ∧ (z ∊ (clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (mclip (⟦ x / t ⟧ A) (ap (fv (⟦ x / t ⟧ B) ⟨ (⟦ x / t ⟧ A) , ⟨ (⟦ x / t ⟧ C) , ⟨ (⟦ x / t ⟧ D) , (⟦ x / t ⟧ E) ⟩ ⟩ ⟩) w)))))) ∨ ((¬ ((⟦ x / t ⟧ C) ∈ kstr)) ∧ (z ∊ (sclip (fv (⟦ x / t ⟧ B) ⟨ (⟦ x / t ⟧ A) , ⟨ (⟦ x / t ⟧ C) , ⟨ (⟦ x / t ⟧ D) , (⟦ x / t ⟧ E) ⟩ ⟩ ⟩))))))))))} $ by ceqt_refl

lemma m2_cl_eq {w r: set} (G: hyps) (A B: class) (P Q: class w r):
  $ G ⇒ A = B $ > $ G ⇒ P = Q $ > $ G ⇒ clam w lvals (clam r (fseq A) P) = clam w lvals (clam r (fseq B) Q) $
----
l1: $ G ⇒ fseq A = fseq B $ by fseq_eq [#1]
l2: $ G ⇒ clam r (fseq A) P = clam r (fseq B) P $ by clam_eq_dom [l1]
l3: $ G , r ∊ fseq B ⇒ P = Q $ by weaken [#2]
l4: $ G ⇒ r ∊ fseq B → P = Q $ by imp_intro [l3]
l5: $ G ⇒ ∀ r (r ∊ fseq B → P = Q) $ by all_intro [l4]
l6: $ G ⇒ fseq B = fseq B $ by eq_refl
l7: $ G ⇒ clam r (fseq B) P = clam r (fseq B) Q $ by clam_eq_pt [l6, l5]
l8: $ G ⇒ clam r (fseq A) P = clam r (fseq B) Q $ by eq_trans [l2, l7]
l9: $ G , w ∊ lvals ⇒ clam r (fseq A) P = clam r (fseq B) Q $ by weaken [l8]
l10: $ G ⇒ w ∊ lvals → clam r (fseq A) P = clam r (fseq B) Q $ by imp_intro [l9]
l11: $ G ⇒ ∀ w (w ∊ lvals → clam r (fseq A) P = clam r (fseq B) Q) $ by all_intro [l10]
l12: $ G ⇒ lvals = lvals $ by eq_refl
l13: $ G ⇒ clam w lvals (clam r (fseq A) P) = clam w lvals (clam r (fseq B) Q) $ by clam_eq_pt [l12, l11]

--| The denotation's step is monotone in all five arguments under equalities.
lemma q0_dnb_sub (G: hyps) (A B C D E F H I J K: class):
  $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ E = F $ > $ G ⇒ H = I $ > $ G ⇒ J = K $ >
  $ G ⇒ dnb A C E H J ⊆ dnb B D F I K $
----
s0: $ G ⇒ ∅ = ∅ $ by eq_refl
s1: $ G ⇒ suc ∅ = suc ∅ $ by eq_refl
s2: $ G ⇒ suc (suc ∅) = suc (suc ∅) $ by eq_refl
fs0: $ G ⇒ fv H ∅ = fv I ∅ $ by fv_eq [#4, s0]
fs1: $ G ⇒ fv H (suc ∅) = fv I (suc ∅) $ by fv_eq [#4, s1]
fv0: $ G ⇒ fv J ∅ = fv K ∅ $ by fv_eq [#5, s0]
fv1: $ G ⇒ fv J (suc ∅) = fv K (suc ∅) $ by fv_eq [#5, s1]
fv2: $ G ⇒ fv J (suc (suc ∅)) = fv K (suc (suc ∅)) $ by fv_eq [#5, s2]
nv: $ G ⇒ nvf = nvf $ by eq_refl
rr: $ G ⇒ r = r $ by eq_refl
ww: $ G ⇒ w = w $ by eq_refl
un: $ G ⇒ uni = uni $ by eq_refl
e0a: $ G ⇒ fv nvf (fv H ∅) = fv nvf (fv I ∅) $ by fv_eq [nv, fs0]
e0: $ G ⇒ fv r (fv nvf (fv H ∅)) = fv r (fv nvf (fv I ∅)) $ by fv_eq [rr, e0a]
x0: $ G ⇒ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅)))) = clam w lvals (clam r (fseq B) (fv r (fv nvf (fv I ∅)))) $ by m2_cl_eq [#1, e0]
e1a: $ G ⇒ lv (fv H ∅) w = lv (fv I ∅) w $ by lv_eq [fs0, ww]
e1: $ G ⇒ fv uni (lv (fv H ∅) w) = fv uni (lv (fv I ∅) w) $ by fv_eq [un, e1a]
x1: $ G ⇒ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w))) = clam w lvals (clam r (fseq B) (fv uni (lv (fv I ∅) w))) $ by m2_cl_eq [#1, e1]
d0: $ G ⇒ da (fv J ∅) w r = da (fv K ∅) w r $ by da_eq [fv0, ww, rr]
d1: $ G ⇒ da (fv J (suc ∅)) w r = da (fv K (suc ∅)) w r $ by da_eq [fv1, ww, rr]
e2: $ G ⇒ ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r) = ap (da (fv K ∅) w r) (da (fv K (suc ∅)) w r) $ by ap_eq [d0, d1]
x2: $ G ⇒ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r))) = clam w lvals (clam r (fseq B) (ap (da (fv K ∅) w r) (da (fv K (suc ∅)) w r))) $ by m2_cl_eq [#1, e2]
sx: $ G ⇒ scons x r = scons x r $ by eq_refl
d1x: $ G ⇒ da (fv J (suc ∅)) w (scons x r) = da (fv K (suc ∅)) w (scons x r) $ by da_eq [fv1, ww, sx]
d1y: $ G , x ∊ da (fv J ∅) w r ⇒ da (fv J (suc ∅)) w (scons x r) = da (fv K (suc ∅)) w (scons x r) $ by weaken [d1x]
d1z: $ G ⇒ x ∊ da (fv J ∅) w r → da (fv J (suc ∅)) w (scons x r) = da (fv K (suc ∅)) w (scons x r) $ by imp_intro [d1y]
d1a: $ G ⇒ ∀ x (x ∊ da (fv J ∅) w r → da (fv J (suc ∅)) w (scons x r) = da (fv K (suc ∅)) w (scons x r)) $ by all_intro [d1z]
e3: $ G ⇒ clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r)) = clam x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r)) $ by clam_eq_pt [d0, d1a]
x3: $ G ⇒ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r)))) = clam w lvals (clam r (fseq B) (clam x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r)))) $ by m2_cl_eq [#1, e3]
e4: $ G ⇒ cpi x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r)) = cpi x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r)) $ by cpi_eq_pt [d0, d1a]
x4: $ G ⇒ clam w lvals (clam r (fseq A) (cpi x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r)))) = clam w lvals (clam r (fseq B) (cpi x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r)))) $ by m2_cl_eq [#1, e4]
e5a: $ G ⇒ fv nvf (fv H (suc ∅)) = fv nvf (fv I (suc ∅)) $ by fv_eq [nv, fs1]
e5b: $ G ⇒ suc (fv nvf (fv H (suc ∅))) = suc (fv nvf (fv I (suc ∅))) $ by suc_eq [e5a]
d2: $ G ⇒ da (fv J (suc (suc ∅))) w r = da (fv K (suc (suc ∅))) w r $ by da_eq [fv2, ww, rr]
e5: $ G ⇒ fv (da (fv J (suc (suc ∅))) w r) (suc (fv nvf (fv H (suc ∅)))) = fv (da (fv K (suc (suc ∅))) w r) (suc (fv nvf (fv I (suc ∅)))) $ by fv_eq [d2, e5b]
x5: $ G ⇒ clam w lvals (clam r (fseq A) (fv (da (fv J (suc (suc ∅))) w r) (suc (fv nvf (fv H (suc ∅)))))) = clam w lvals (clam r (fseq B) (fv (da (fv K (suc (suc ∅))) w r) (suc (fv nvf (fv I (suc ∅)))))) $ by m2_cl_eq [#1, e5]
t1: $ G ⇒ ⟨ H , J ⟩ = ⟨ I , K ⟩ $ by opair_eq [#4, #5]
t2: $ G ⇒ ⟨ E , ⟨ H , J ⟩ ⟩ = ⟨ F , ⟨ I , K ⟩ ⟩ $ by opair_eq [#3, t1]
t3: $ G ⇒ ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩ = ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩ $ by opair_eq [#1, t2]
t4: $ G ⇒ fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩ = fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩ $ by fv_eq [#2, t3]
t5: $ G ⇒ ap (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩) w = ap (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩) w $ by ap_eq [t4, ww]
t6: $ G ⇒ mclip A (ap (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩) w) = mclip B (ap (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩) w) $ by mclip_eq [#1, t5]
x6: $ G ⇒ clam w lvals (clam r (fseq A) (mclip A (ap (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩) w))) = clam w lvals (clam r (fseq B) (mclip B (ap (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩) w))) $ by m2_cl_eq [#1, t6]
x7: $ G ⇒ sclip (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩) = sclip (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩) $ by sclip_eq [t4]
kk: $ G ⇒ F = E $ by eq_sym [#3]
c0a: $ G , (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ⇒ (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) $ by ax
c0b: $ G , (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ⇒ E = kc_bvar $ by and_elim_l [c0a]
c0c: $ G , (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ⇒ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅)))) $ by and_elim_r [c0a]
c0d: $ G , (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ⇒ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅)))) = clam w lvals (clam r (fseq B) (fv r (fv nvf (fv I ∅)))) $ by weaken [x0]
c0e: $ G , (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ⇒ z ∊ clam w lvals (clam r (fseq B) (fv r (fv nvf (fv I ∅)))) $ by welc_eq [c0d, c0c]
c0f: $ G , (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ⇒ F = E $ by weaken [kk]
c0g: $ G , (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ⇒ F = kc_bvar $ by eq_trans [c0f, c0b]
c0: $ G , (E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ⇒ (F = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq B) (fv r (fv nvf (fv I ∅))))) $ by and_intro [c0g, c0e]
c1a: $ G , (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ⇒ (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) $ by ax
c1b: $ G , (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ⇒ E = kc_srt $ by and_elim_l [c1a]
c1c: $ G , (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ⇒ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w))) $ by and_elim_r [c1a]
c1d: $ G , (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ⇒ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w))) = clam w lvals (clam r (fseq B) (fv uni (lv (fv I ∅) w))) $ by weaken [x1]
c1e: $ G , (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ⇒ z ∊ clam w lvals (clam r (fseq B) (fv uni (lv (fv I ∅) w))) $ by welc_eq [c1d, c1c]
c1f: $ G , (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ⇒ F = E $ by weaken [kk]
c1g: $ G , (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ⇒ F = kc_srt $ by eq_trans [c1f, c1b]
c1: $ G , (E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ⇒ (F = kc_srt ∧ z ∊ clam w lvals (clam r (fseq B) (fv uni (lv (fv I ∅) w)))) $ by and_intro [c1g, c1e]
c2a: $ G , (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ⇒ (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) $ by ax
c2b: $ G , (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ⇒ E = kc_app $ by and_elim_l [c2a]
c2c: $ G , (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ⇒ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r))) $ by and_elim_r [c2a]
c2d: $ G , (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ⇒ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r))) = clam w lvals (clam r (fseq B) (ap (da (fv K ∅) w r) (da (fv K (suc ∅)) w r))) $ by weaken [x2]
c2e: $ G , (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ⇒ z ∊ clam w lvals (clam r (fseq B) (ap (da (fv K ∅) w r) (da (fv K (suc ∅)) w r))) $ by welc_eq [c2d, c2c]
c2f: $ G , (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ⇒ F = E $ by weaken [kk]
c2g: $ G , (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ⇒ F = kc_app $ by eq_trans [c2f, c2b]
c2: $ G , (E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ⇒ (F = kc_app ∧ z ∊ clam w lvals (clam r (fseq B) (ap (da (fv K ∅) w r) (da (fv K (suc ∅)) w r)))) $ by and_intro [c2g, c2e]
c3a: $ G , (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ⇒ (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) $ by ax
c3b: $ G , (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ⇒ E = kc_lam $ by and_elim_l [c3a]
c3c: $ G , (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ⇒ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r)))) $ by and_elim_r [c3a]
c3d: $ G , (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ⇒ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r)))) = clam w lvals (clam r (fseq B) (clam x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r)))) $ by weaken [x3]
c3e: $ G , (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ⇒ z ∊ clam w lvals (clam r (fseq B) (clam x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r)))) $ by welc_eq [c3d, c3c]
c3f: $ G , (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ⇒ F = E $ by weaken [kk]
c3g: $ G , (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ⇒ F = kc_lam $ by eq_trans [c3f, c3b]
c3: $ G , (E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ⇒ (F = kc_lam ∧ z ∊ clam w lvals (clam r (fseq B) (clam x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r))))) $ by and_intro [c3g, c3e]
