u13: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)}) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) a ∧ x ∊ dt u M (fv S ∅) a q ∧ r = scons x q)} ⇒ b ∊ fseq u $ by and_elim_l [u12]
u14: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)}) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) a ∧ x ∊ dt u M (fv S ∅) a q ∧ r = scons x q)} ⇒ b = y $ by eq_sym [u10]
u15: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)}) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) a ∧ x ∊ dt u M (fv S ∅) a q ∧ r = scons x q)} ⇒ y ∊ fseq u $ by welc_eq_set [u14, u13]
u16: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V , K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt u M (fv S ∅) g q ∧ r = scons x q)}) ⇒ y ∊ fseq u $ by clam_elim_mem [t4, u15]
v1: $ G , c = ⟨ W , y ⟩ , c ∊ stb u M K S V ⇒ y ∊ fseq u $ by or_elim [r2, s18, u16]
v2: $ G ⇒ y ∊ fseq u $ by wcel_elim [#1, v1]

sat_fseq
--------
a1: $ G , y ∊ sat u M T W ⇒ y ∊ sat u M T W $ by ax
a2: $ G , y ∊ sat u M T W ⇒ ⟨ W , y ⟩ ∈ fv (stf u M) T $ by ap_elim [a1]
a0: $ G ⇒ functional (cgr3 x1 x2 x3 (stb u M x1 x2 x3)) $ by cgr3_functional
a3w: $ G ⇒ isset ω $ by omega_set
a3: $ G ⇒ rel (stf u M) $ by trc_rel_c [a3w, a0]
a4w: $ G ⇒ isset ω $ by omega_set
a4: $ G ⇒ cdm (stf u M) = trees ω $ by trc_cdm_c [a4w, a0]
a6w: $ G ⇒ isset ω $ by omega_set
a6: $ G ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [a6w]
a5: $ G ⇒ trees ω = ω × fseq (trees ω) $ by eq_sym [a6]
b1: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z ⇒ z ∊ ap (stf u M) T $ by ax
b2: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z ⇒ ⟨ T , z ⟩ ∈ stf u M $ by ap_elim [b1]
b4: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z ⇒ rel (stf u M) $ by weaken [a3]
b5: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z ⇒ isset T $ by m6_pair_rel_isset [b4, b2]
c1: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ t = T $ by ax
c1a: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ T = t $ by eq_sym [c1]
c2: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ z = z $ by eq_refl
c3: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ ⟨ T , z ⟩ = ⟨ t , z ⟩ $ by opair_eq [c1a, c2]
c3a: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ ⟨ T , z ⟩ ∈ stf u M $ by weaken [b2]
c4: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ ⟨ t , z ⟩ ∈ stf u M $ by wcel_eq_l [c3, c3a]
c5: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ t ∊ cdm (stf u M) $ by cdm_intro [c4]
c6: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ cdm (stf u M) = trees ω $ by weaken [a4]
c7: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ t ∊ trees ω $ by welc_eq [c6, c5]
c8: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ trees ω = ω × fseq (trees ω) $ by weaken [a5]
c9: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ t ∊ ω × fseq (trees ω) $ by welc_eq [c8, c7]
d0a: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ k ∊ ω $ by ax
d0b: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ j ∊ fseq (trees ω) $ by ax
d1: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ fv (stf u M) ⟨ k , j ⟩ = stb u M k j (ccom (stf u M) j) $ by stf_node [d0a, d0b]
d2: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ functional (stf u M) $ by stf_functional
d3a: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ ⟨ t , z ⟩ ∈ stf u M $ by weaken [c4]
d3: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ fv (stf u M) t = z $ by fv_val [d2, d3a]
d4: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ stf u M = stf u M $ by eq_refl
d5: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ t = ⟨ k , j ⟩ $ by ax
d6: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ fv (stf u M) t = fv (stf u M) ⟨ k , j ⟩ $ by fv_eq [d4, d5]
d7: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ z = fv (stf u M) t $ by eq_sym [d3]
d8: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ z = fv (stf u M) ⟨ k , j ⟩ $ by eq_trans [d7, d6]
d9: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ z = stb u M k j (ccom (stf u M) j) $ by eq_trans [d8, d1]
d10: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ ⟨ W , y ⟩ ∈ z $ by ax
d11: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ ⟨ W , y ⟩ ∈ stb u M k j (ccom (stf u M) j) $ by wcel_eq_r [d9, d10]
d12: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ y ∊ fseq u $ by m6_stb_pair_fseq [d11]
e1: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z , t = T ⇒ y ∊ fseq u $ by cxp_elim [c9, d12]
e2: $ G , y ∊ sat u M T W , z ∊ ap (stf u M) T , ⟨ W , y ⟩ ∈ z ⇒ y ∊ fseq u $ by isset_elim [b5, e1]
