n9: $ G , a = kc_srt , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ a , b ⟩ = fv (dnf u M) ⟨ kc_srt , scons T ∅ ⟩ $ by fv_eq [n8, n7]
n10: $ G , a = kc_srt , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ kc_srt , scons T ∅ ⟩ = fv (dnf u M) ⟨ a , b ⟩ $ by eq_sym [n9]
n11: $ G , a = kc_srt , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ kc_srt , scons T ∅ ⟩ = dnb u M a b (ccom (dnf u M) b) $ by eq_trans [n10, n3]
n12: $ G , a = kc_srt , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ kc_srt , scons T ∅ ⟩ = clam i lvals (clam j (fseq u) (fv uni (lv (fv b ∅) i))) $ by eq_trans [n11, n5]
n13: $ G , a = kc_srt , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ w ∊ lvals $ by weaken [#2]
n14: $ G , a = kc_srt , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (clam i lvals (clam j (fseq u) (fv uni (lv (fv b ∅) i)))) w = clam j (fseq u) (fv uni (lv (fv b ∅) w)) $ by clam_ap [n13]
