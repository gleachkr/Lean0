--| A satisfaction step at `kc_nil`.
lemma m6_stb_nil_eq {g: set} (G: hyps) (U M K S V: class): $ G ⇒ K = kc_nil $ > $ G ⇒ stb U M K S V = clam g lvals (csn ∅) $
----
a1: $ G , z ∊ stb U M K S V ⇒ z ∊ stb U M K S V $ by ax
a2: $ G , z ∊ stb U M K S V ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) $ by cab_elim [a1]
a3: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) $ by ax
a4: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ z ∊ clam g lvals (csn ∅) $ by and_elim_r [a3]
a5: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) $ by ax
a6: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ K = kc_cons $ by and_elim_l [a5]
a7: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ K = kc_nil $ by weaken [#1]
a8: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ kc_nil = K $ by eq_sym [a7]
a9: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ kc_nil = kc_cons $ by eq_trans [a8, a6]
a9b: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
a10: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ ⊥ $ by not_elim [a9b, a9]
a11: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ z ∊ clam g lvals (csn ∅) $ by bot_elim [a10]
a12: $ G , z ∊ stb U M K S V ⇒ z ∊ clam g lvals (csn ∅) $ by or_elim [a2, a4, a11]
b1: $ G , z ∊ clam g lvals (csn ∅) ⇒ K = kc_nil $ by weaken [#1]
b2: $ G , z ∊ clam g lvals (csn ∅) ⇒ z ∊ clam g lvals (csn ∅) $ by ax
b3: $ G , z ∊ clam g lvals (csn ∅) ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) $ by and_intro [b1, b2]
b4: $ G , z ∊ clam g lvals (csn ∅) ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) $ by or_intro_l [b3]
b5: $ G , z ∊ clam g lvals (csn ∅) ⇒ z ∊ stb U M K S V $ by cab_intro [b4]
b6: $ G ⇒ stb U M K S V = clam g lvals (csn ∅) $ by eq_intro [a12, b5]

--| A satisfaction step at `kc_cons`.
lemma m6_stb_cons_eq {g r x q: set} (G: hyps) (U M K S V: class): $ G ⇒ K = kc_cons $ > $ G ⇒ stb U M K S V = clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} $
----
a1: $ G , z ∊ stb U M K S V ⇒ z ∊ stb U M K S V $ by ax
a2: $ G , z ∊ stb U M K S V ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) $ by cab_elim [a1]
a3: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) $ by ax
a4: $ G , z ∊ stb U M K S V , (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) ⇒ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} $ by and_elim_r [a3]
a5: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) $ by ax
a6: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ K = kc_nil $ by and_elim_l [a5]
a7: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ K = kc_cons $ by weaken [#1]
a8: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ kc_nil = K $ by eq_sym [a6]
a9: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ kc_nil = kc_cons $ by eq_trans [a8, a7]
a9b: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
a10: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ ⊥ $ by not_elim [a9b, a9]
a11: $ G , z ∊ stb U M K S V , (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ⇒ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} $ by bot_elim [a10]
a12: $ G , z ∊ stb U M K S V ⇒ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} $ by or_elim [a2, a11, a4]
b1: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} ⇒ K = kc_cons $ by weaken [#1]
b2: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} ⇒ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} $ by ax
b3: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} ⇒ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) $ by and_intro [b1, b2]
b4: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} ⇒ (K = kc_nil ∧ z ∊ clam g lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)}) $ by or_intro_r [b3]
b5: $ G , z ∊ clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} ⇒ z ∊ stb U M K S V $ by cab_intro [b4]
b6: $ G ⇒ stb U M K S V = clam g lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ dt U M (fv S ∅) g q ∧ r = scons x q)} $ by eq_intro [a12, b5]

sat_nil
-------
a1: $ G ⇒ kc_nil ∈ ω $ by kc_nil_omega
