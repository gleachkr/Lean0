n20: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ fv (ccom (stf u M) e) i = fv (stf u M) (fv e i) $ by fv_ccom [n1, n2, n11, n19]
n21a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ b = T2 $ by weaken [h18]
n21b: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ fv e i = T2 $ by eq_trans [n15c, n21a]
n21c: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ stf u M = stf u M $ by eq_refl
n21: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ fv (stf u M) (fv e i) = fv (stf u M) T2 $ by fv_eq [n21c, n21b]
n22a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ suc c = suc ∅ $ by suc_eq [n13b]
n22b: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ i = suc ∅ $ by eq_trans [n6, n22a]
n22: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ suc ∅ = i $ by eq_sym [n22b]
n23a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ccom (stf u M) e = ccom (stf u M) e $ by eq_refl
n23: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ fv (ccom (stf u M) e) (suc ∅) = fv (ccom (stf u M) e) i $ by fv_eq [n23a, n22]
n24a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ fv (ccom (stf u M) e) (suc ∅) = fv (stf u M) (fv e i) $ by eq_trans [n23, n20]
n24: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ fv (ccom (stf u M) e) (suc ∅) = fv (stf u M) T2 $ by eq_trans [n24a, n21]
n25a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ w = w $ by eq_refl
n25: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ap (fv (ccom (stf u M) e) (suc ∅)) w = ap (fv (stf u M) T2) w $ by ap_eq [n24, n25a]
p1u: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ u = u $ by eq_refl
p1m: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ M = M $ by eq_refl
p1: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv (ccom (stf u M) e) (suc ∅)) w ∧ x ∊ dt u M (fv e ∅) w q ∧ r = scons x q)} = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv (stf u M) T2) w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by q0_stq_eq [m5, n25, p1u, p1m]
p2a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ T2 = b $ by eq_sym [n21a]
p2b: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ∅ = c $ by eq_sym [n13b]
p2: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ scons T2 ∅ = scons b c $ by scons_eq [p2a, p2b]
p3a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ scons b c = d $ by weaken [j2]
p3: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ scons T2 ∅ = d $ by eq_trans [p2, p3a]
p4a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ T = a $ by eq_sym [m4]
p4: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ scons T (scons T2 ∅) = scons a d $ by scons_eq [p4a, p3]
p5: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ scons T (scons T2 ∅) = e $ by eq_trans [p4, k2]
p6a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ kc_cons = k $ by weaken [h11]
p6: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ⟨ kc_cons , scons T (scons T2 ∅) ⟩ = ⟨ k , e ⟩ $ by opair_eq [p6a, p5]
p7: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ fv (stf u M) ⟨ kc_cons , scons T (scons T2 ∅) ⟩ = fv (stf u M) ⟨ k , e ⟩ $ by fv_eq [n21c, p6]
p8: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ap (fv (stf u M) ⟨ kc_cons , scons T (scons T2 ∅) ⟩) w = ap (fv (stf u M) ⟨ k , e ⟩) w $ by ap_eq [p7, n25a]
p9: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ap (fv (stf u M) ⟨ k , e ⟩) w = ap (stb u M k e (ccom (stf u M) e)) w $ by ap_eq [k4, n25a]
p10: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ap (stb u M k e (ccom (stf u M) e)) w = ap (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv (ccom (stf u M) e) (suc ∅)) g ∧ x ∊ dt u M (fv e ∅) g q ∧ r = scons x q)}) w $ by ap_eq [k5, n25a]
p11: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ap (fv (stf u M) ⟨ kc_cons , scons T (scons T2 ∅) ⟩) w = ap (stb u M k e (ccom (stf u M) e)) w $ by eq_trans [p8, p9]
p12: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ap (fv (stf u M) ⟨ kc_cons , scons T (scons T2 ∅) ⟩) w = ap (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv (ccom (stf u M) e) (suc ∅)) g ∧ x ∊ dt u M (fv e ∅) g q ∧ r = scons x q)}) w $ by eq_trans [p11, p10]
p13: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ ap (fv (stf u M) ⟨ kc_cons , scons T (scons T2 ∅) ⟩) w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv (ccom (stf u M) e) (suc ∅)) w ∧ x ∊ dt u M (fv e ∅) w q ∧ r = scons x q)} $ by eq_trans [p12, k6]
p14: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c , e = scons a d ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by eq_trans [p13, p1]
q1: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c , i = suc c ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by isset_elim [l1, p14]
q2: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons , d = scons b c ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by isset_elim [j11, q1]
q3: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ , k = kc_cons ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by isset_elim [h8, q2]
q4a: $ G ⇒ kc_cons ∈ ω $ by kc_cons_omega
q4c: $ G ⇒ isset kc_cons $ by wcel_isset [q4a]
q4b: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ ⇒ isset kc_cons $ by weaken [q4c]
q4: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω , c = ∅ ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by isset_elim [q4b, q3]
q5a: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω ⇒ isset ∅ $ by ax_empty
q5: $ G , a = T , a ∊ trees ω , b = T2 , b ∊ trees ω ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by isset_elim [q5a, q4]
q6a: $ G , a = T , a ∊ trees ω ⇒ T2 ∈ trees ω $ by weaken [#2]
q6: $ G , a = T , a ∊ trees ω ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by wcel_elim [q6a, q5]
q7: $ G ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q)} $ by wcel_elim [#1, q6]

sat_cons_intro
--------------
h1: $ G ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {y | y ∊ fseq u ∧ ∃ a ∃ b (b ∊ sat u M T2 w ∧ a ∊ dt u M T w b ∧ y = scons a b)} $ by sat_cons [#1, #2, #3]
h2: $ G ⇒ sat u M T2 w ⊆ fseq u $ by sat_fseq
h3: $ G ⇒ q ∊ fseq u $ by subset_elim [h2, #4]
h4: $ G ⇒ scons x q ∈ fseq u $ by scons_fseq [#6, h3]
h5: $ G ⇒ isset (scons x q) $ by wcel_isset [h4]
i1: $ G , c = scons x q ⇒ c = scons x q $ by ax
i2: $ G , c = scons x q ⇒ scons x q = c $ by eq_sym [i1]
i3a: $ G , c = scons x q ⇒ scons x q ∈ fseq u $ by weaken [h4]
i3: $ G , c = scons x q ⇒ c ∈ fseq u $ by wcel_eq_l [i2, i3a]
i4: $ G , c = scons x q ⇒ c ∊ fseq u $ by wcel_welc [i3]
i5: $ G , c = scons x q ⇒ q ∊ sat u M T2 w $ by weaken [#4]
i6: $ G , c = scons x q ⇒ x ∊ dt u M T w q $ by weaken [#5]
i7a: $ G , c = scons x q ⇒ x ∊ dt u M T w q ∧ c = scons x q $ by and_intro [i6, i1]
i7: $ G , c = scons x q ⇒ q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ c = scons x q $ by and_intro [i5, i7a]
i8: $ G , c = scons x q ⇒ ∃ b (b ∊ sat u M T2 w ∧ x ∊ dt u M T w b ∧ c = scons x b) $ by ex_intro [i7]
i9: $ G , c = scons x q ⇒ ∃ a ∃ b (b ∊ sat u M T2 w ∧ a ∊ dt u M T w b ∧ c = scons a b) $ by ex_intro [i8]
i10: $ G , c = scons x q ⇒ c ∊ fseq u ∧ ∃ a ∃ b (b ∊ sat u M T2 w ∧ a ∊ dt u M T w b ∧ c = scons a b) $ by and_intro [i4, i9]
h6: $ G ⇒ scons x q ∈ {y | y ∊ fseq u ∧ ∃ a ∃ b (b ∊ sat u M T2 w ∧ a ∊ dt u M T w b ∧ y = scons a b)} $ by wcel_cab_intro (p := $ y ∊ fseq u ∧ ∃ a ∃ b (b ∊ sat u M T2 w ∧ a ∊ dt u M T w b ∧ y = scons a b) $) [h5, i10]
h7: $ G ⇒ {y | y ∊ fseq u ∧ ∃ a ∃ b (b ∊ sat u M T2 w ∧ a ∊ dt u M T w b ∧ y = scons a b)} = sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w $ by eq_sym [h1]
h8: $ G ⇒ scons x q ∈ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w $ by wcel_eq_r [h7, h6]

sat_cons_elim
-------------
h1: $ G ⇒ sat u M ⟨ kc_cons , scons T (scons T2 ∅) ⟩ w = {y | y ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ y = scons x q)} $ by sat_cons [#1, #2, #3]
h2: $ G ⇒ r ∊ {y | y ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ y = scons x q)} $ by welc_eq [h1, #4]
h3: $ G ⇒ r ∊ fseq u ∧ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q) $ by cab_elim [h2]
h4: $ G ⇒ ∃ x ∃ q (q ∊ sat u M T2 w ∧ x ∊ dt u M T w q ∧ r = scons x q) $ by and_elim_r [h3]

