sb_c_stb
--------
l1: $ (⟦ x / t ⟧ {z | (C = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (C = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ y ∃ q (q ∊ ap (fv E (suc ∅)) w ∧ y ∊ dt A B (fv D ∅) w q ∧ r = scons y q)})}) ≐ {z | ((⟦ x / t ⟧ C) = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ ((⟦ x / t ⟧ C) = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq (⟦ x / t ⟧ A) ∧ ∃ y ∃ q (q ∊ ap (fv (⟦ x / t ⟧ E) (suc ∅)) w ∧ y ∊ dt (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (fv (⟦ x / t ⟧ D) ∅) w q ∧ r = scons y q)})} $ by ceqt_refl

--| The existential of `stb`'s `kc_cons` case respects equality of its parts.
lemma q0_stq_ex {x q: set} (G: hyps) (U U2 M M2 A B D E: class) (w r: set):
  $ G ⇒ A = B $ > $ G ⇒ D = E $ > $ G ⇒ U = U2 $ > $ G ⇒ M = M2 $ >
  $ G ⇒ (∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $
----
p1: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q $ by ax
p2: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ q ∊ D $ by and_elim_l [p1]
p3: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ x ∊ dt U M A w q ∧ r = scons x q $ by and_elim_r [p1]
p3a: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ x ∊ dt U M A w q $ by and_elim_l [p3]
p3b: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ r = scons x q $ by and_elim_r [p3]
p4: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ D = E $ by weaken [#2]
p5: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ q ∊ E $ by welc_eq [p4, p2]
q1: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ A = B $ by weaken [#1]
q2: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ U = U2 $ by weaken [#3]
q3: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ M = M2 $ by weaken [#4]
q4: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ w = w $ by eq_refl
q5: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ q = q $ by eq_refl
q6: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ dt U M A w q = dt U2 M2 B w q $ by dt_eq [q2, q3, q1, q4, q5]
q7: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ x ∊ dt U2 M2 B w q $ by welc_eq [q6, p3a]
q8: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ x ∊ dt U2 M2 B w q ∧ r = scons x q $ by and_intro [q7, p3b]
p6: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q $ by and_intro [p5, q8]
p7: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by ex_intro [p6]
p8: $ G , q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by ex_intro [p7]
p9: $ G , ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) $ by ax
p10: $ G , ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by ex_elim [p9, p8]
p11a: $ G , ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) $ by ax
p11: $ G , ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by ex_elim [p11a, p10]
p12: $ G ⇒ (∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by imp_intro [p11]

--| The value set of `stb`'s `kc_cons` case respects equality of its parts.
lemma q0_stq_eq {r x q: set} (G: hyps) (U U2 M M2 A B D E: class) (w: set):
  $ G ⇒ A = B $ > $ G ⇒ D = E $ > $ G ⇒ U = U2 $ > $ G ⇒ M = M2 $ >
  $ G ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q)} = {r | r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q)} $
----
a1: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) $ by ax
a2: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ r ∊ fseq U $ by and_elim_l [a1]
a3: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) $ by and_elim_r [a1]
a4: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ U = U2 $ by weaken [#3]
a4b: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ r ∊ fseq U2 $ by welc_fseq_eq [a4, a2]
a5a: $ G ⇒ (∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by q0_stq_ex [#1, #2, #3, #4]
a5b: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ (∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by weaken [a5a]
a5: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by imp_elim [a5b, a3]
a6: $ G , r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) ⇒ r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by and_intro [a4b, a5]
b1: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) ⇒ r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by ax
b2: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) ⇒ r ∊ fseq U2 $ by and_elim_l [b1]
b3: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) $ by and_elim_r [b1]
b4a: $ G ⇒ B = A $ by eq_sym [#1]
b4b: $ G ⇒ E = D $ by eq_sym [#2]
b4c: $ G ⇒ U2 = U $ by eq_sym [#3]
b4d: $ G ⇒ M2 = M $ by eq_sym [#4]
b4e: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) ⇒ U2 = U $ by weaken [b4c]
b4f: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) ⇒ r ∊ fseq U $ by welc_fseq_eq [b4e, b2]
b5a: $ G ⇒ (∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) $ by q0_stq_ex [b4a, b4b, b4c, b4d]
b5b: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) ⇒ (∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) $ by weaken [b5a]
b5: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) $ by imp_elim [b5b, b3]
b6: $ G , r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q) ⇒ r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q) $ by and_intro [b4f, b5]
c1: $ G ⇒ (r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q)) ↔ (r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q)) $ by bi_intro [a6, b6]
c2: $ G ⇒ ∀ r ((r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q)) ↔ (r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q))) $ by all_intro [c1]
c3: $ G ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ D ∧ x ∊ dt U M A w q ∧ r = scons x q)} = {r | r ∊ fseq U2 ∧ ∃ x ∃ q (q ∊ E ∧ x ∊ dt U2 M2 B w q ∧ r = scons x q)} $ by cab_eq [c2]

stb_eq
------
e1: $ G , w ∊ lvals ⇒ J = K $ by weaken [#5]
e2: $ G , w ∊ lvals ⇒ suc ∅ = suc ∅ $ by eq_refl
e3: $ G , w ∊ lvals ⇒ fv J (suc ∅) = fv K (suc ∅) $ by fv_eq [e1, e2]
e4: $ G , w ∊ lvals ⇒ w = w $ by eq_refl
e5: $ G , w ∊ lvals ⇒ ap (fv J (suc ∅)) w = ap (fv K (suc ∅)) w $ by ap_eq [e3, e4]
e5a: $ G , w ∊ lvals ⇒ H = I $ by weaken [#4]
e5b: $ G , w ∊ lvals ⇒ ∅ = ∅ $ by eq_refl
e5c: $ G , w ∊ lvals ⇒ fv H ∅ = fv I ∅ $ by fv_eq [e5a, e5b]
e5d: $ G , w ∊ lvals ⇒ A = B $ by weaken [#1]
e5e: $ G , w ∊ lvals ⇒ C = D $ by weaken [#2]
e6: $ G , w ∊ lvals ⇒ {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)} = {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)} $ by q0_stq_eq [e5c, e5, e5d, e5e]
e7: $ G ⇒ w ∊ lvals → {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)} = {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)} $ by imp_intro [e6]
e8: $ G ⇒ ∀ w (w ∊ lvals → {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)} = {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)}) $ by all_intro [e7]
e9: $ G ⇒ lvals = lvals $ by eq_refl
e10: $ G ⇒ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)} $ by clam_eq_pt [e9, e8]
f1: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) $ by ax
f1a: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ E = kc_nil $ by and_elim_l [f1]
f1b: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ z ∊ clam w lvals (csn ∅) $ by and_elim_r [f1]
f1c: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ E = F $ by weaken [#3]
f1d: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ F = E $ by eq_sym [f1c]
f1e: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ F = kc_nil $ by eq_trans [f1d, f1a]
f1f: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) $ by and_intro [f1e, f1b]
f2: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ⇒ (F = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (F = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)}) $ by or_intro_l [f1f]
f3: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) ⇒ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) $ by ax
f4a: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) ⇒ E = kc_cons $ by and_elim_l [f3]
f4b: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) ⇒ E = F $ by weaken [#3]
f4c: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) ⇒ F = E $ by eq_sym [f4b]
f4: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) ⇒ F = kc_cons $ by eq_trans [f4c, f4a]
f5: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) ⇒ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)} $ by and_elim_r [f3]
f6: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) ⇒ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)} $ by weaken [e10]
f7: $ G , (E = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) , (E = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq A ∧ ∃ x ∃ q (q ∊ ap (fv J (suc ∅)) w ∧ x ∊ dt A C (fv H ∅) w q ∧ r = scons x q)}) ⇒ z ∊ clam w lvals {r | r ∊ fseq B ∧ ∃ x ∃ q (q ∊ ap (fv K (suc ∅)) w ∧ x ∊ dt B D (fv I ∅) w q ∧ r = scons x q)} $ by welc_eq [f6, f5]
