o6: $ G ⇒ ¬ kc_srt ∈ kexa $ by kexa_notin_lt [o5c]
o5: $ G ⇒ ¬ kc_srt = kc_proj $ by kc_srt_ne_proj
o7: $ G ⇒ kc_srt ∈ kstr $ by kstr_srt
