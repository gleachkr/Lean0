l1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r $ by and_intro [#1, #2]
l2: $ uadm u , w ∊ lvals ⇒ r ∊ sat u M (enc_ctx G) w → (dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r) $ by imp_intro [l1]
l3: $ uadm u , w ∊ lvals ⇒ ∀ r (r ∊ sat u M (enc_ctx G) w → (dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r)) $ by all_intro [l2]
l4: $ uadm u ⇒ w ∊ lvals → ∀ r (r ∊ sat u M (enc_ctx G) w → (dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r)) $ by imp_intro [l3]
l5: $ uadm u ⇒ ∀ w (w ∊ lvals → ∀ r (r ∊ sat u M (enc_ctx G) w → (dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r))) $ by all_intro [l4]
l6: $ _ ⇒ uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u M (enc_ctx G) w → (dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r))) $ by imp_intro [l5]
l7: $ _ ⇒ ∀ u (uadm u → ∀ w (w ∊ lvals → ∀ r (r ∊ sat u M (enc_ctx G) w → (dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r)))) $ by all_intro [l6]

