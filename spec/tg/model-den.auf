l8: $ G ⇒ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) ⊆ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) $ by cun_subset_r
l9: $ G ⇒ kc_lam ∈ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) $ by wcel_subset [l8, l7]
l10: $ G ⇒ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) ⊆ csn kc_bvar ∪ (csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))))) $ by cun_subset_r
l11: $ G ⇒ kc_lam ∈ kstr $ by wcel_subset [l10, l9]

kstr_pi
-------
l1: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
l2: $ G ⇒ isset kc_pi $ by wcel_isset [l1]
l3: $ G ⇒ kc_pi ∈ csn kc_pi $ by cpr_intro_l_c [l2]
l4: $ G ⇒ csn kc_pi ⊆ csn kc_pi ∪ (csn kc_proj ∪ kexa) $ by cun_subset_l
l5: $ G ⇒ kc_pi ∈ csn kc_pi ∪ (csn kc_proj ∪ kexa) $ by wcel_subset [l4, l3]
l6: $ G ⇒ csn kc_pi ∪ (csn kc_proj ∪ kexa) ⊆ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) $ by cun_subset_r
l7: $ G ⇒ kc_pi ∈ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) $ by wcel_subset [l6, l5]
l8: $ G ⇒ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) ⊆ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) $ by cun_subset_r
l9: $ G ⇒ kc_pi ∈ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) $ by wcel_subset [l8, l7]
l10: $ G ⇒ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) ⊆ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) $ by cun_subset_r
l11: $ G ⇒ kc_pi ∈ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) $ by wcel_subset [l10, l9]
l12: $ G ⇒ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) ⊆ csn kc_bvar ∪ (csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))))) $ by cun_subset_r
l13: $ G ⇒ kc_pi ∈ kstr $ by wcel_subset [l12, l11]

kstr_proj
---------
l1: $ G ⇒ kc_proj ∈ ω $ by kc_proj_omega
l2: $ G ⇒ isset kc_proj $ by wcel_isset [l1]
l3: $ G ⇒ kc_proj ∈ csn kc_proj $ by cpr_intro_l_c [l2]
l4: $ G ⇒ csn kc_proj ⊆ csn kc_proj ∪ kexa $ by cun_subset_l
l5: $ G ⇒ kc_proj ∈ csn kc_proj ∪ kexa $ by wcel_subset [l4, l3]
l6: $ G ⇒ csn kc_proj ∪ kexa ⊆ csn kc_pi ∪ (csn kc_proj ∪ kexa) $ by cun_subset_r
l7: $ G ⇒ kc_proj ∈ csn kc_pi ∪ (csn kc_proj ∪ kexa) $ by wcel_subset [l6, l5]
l8: $ G ⇒ csn kc_pi ∪ (csn kc_proj ∪ kexa) ⊆ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) $ by cun_subset_r
l9: $ G ⇒ kc_proj ∈ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) $ by wcel_subset [l8, l7]
l10: $ G ⇒ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) ⊆ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) $ by cun_subset_r
l11: $ G ⇒ kc_proj ∈ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) $ by wcel_subset [l10, l9]
l12: $ G ⇒ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) ⊆ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) $ by cun_subset_r
l13: $ G ⇒ kc_proj ∈ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) $ by wcel_subset [l12, l11]
l14: $ G ⇒ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) ⊆ csn kc_bvar ∪ (csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))))) $ by cun_subset_r
l15: $ G ⇒ kc_proj ∈ kstr $ by wcel_subset [l14, l13]

kexa_kstr
---------
l1: $ G ⇒ kexa ⊆ csn kc_proj ∪ kexa $ by cun_subset_r
l2: $ G ⇒ csn kc_proj ∪ kexa ⊆ csn kc_pi ∪ (csn kc_proj ∪ kexa) $ by cun_subset_r
l3: $ G ⇒ kexa ⊆ csn kc_pi ∪ (csn kc_proj ∪ kexa) $ by subset_trans [l1, l2]
l4: $ G ⇒ csn kc_pi ∪ (csn kc_proj ∪ kexa) ⊆ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) $ by cun_subset_r
l5: $ G ⇒ kexa ⊆ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) $ by subset_trans [l3, l4]
l6: $ G ⇒ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) ⊆ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) $ by cun_subset_r
l7: $ G ⇒ kexa ⊆ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) $ by subset_trans [l5, l6]
l8: $ G ⇒ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) ⊆ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) $ by cun_subset_r
l9: $ G ⇒ kexa ⊆ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) $ by subset_trans [l7, l8]
l10: $ G ⇒ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) ⊆ csn kc_bvar ∪ (csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))))) $ by cun_subset_r
l11: $ G ⇒ kexa ⊆ kstr $ by subset_trans [l9, l10]

-- m4: propositional tools for the case analysis of a step.

kstr_omega
----------
k1: $ G ⇒ kexa ⊆ ω $ by kexa_omega
m5: $ G ⇒ kc_proj ∈ ω $ by kc_proj_omega
s5: $ G ⇒ csn kc_proj ⊆ ω $ by csn_subset_c [m5]
u5: $ G ⇒ csn kc_proj ∪ kexa ⊆ ω $ by cun_least [s5, k1]
m4: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
s4: $ G ⇒ csn kc_pi ⊆ ω $ by csn_subset_c [m4]
u4: $ G ⇒ csn kc_pi ∪ (csn kc_proj ∪ kexa) ⊆ ω $ by cun_least [s4, u5]
m3: $ G ⇒ kc_lam ∈ ω $ by kc_lam_omega
s3: $ G ⇒ csn kc_lam ⊆ ω $ by csn_subset_c [m3]
u3: $ G ⇒ csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)) ⊆ ω $ by cun_least [s3, u4]
m2: $ G ⇒ kc_app ∈ ω $ by kc_app_omega
s2: $ G ⇒ csn kc_app ⊆ ω $ by csn_subset_c [m2]
u2: $ G ⇒ csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa))) ⊆ ω $ by cun_least [s2, u3]
m1: $ G ⇒ kc_srt ∈ ω $ by kc_srt_omega
s1: $ G ⇒ csn kc_srt ⊆ ω $ by csn_subset_c [m1]
u1: $ G ⇒ csn kc_srt ∪ (csn kc_app ∪ (csn kc_lam ∪ (csn kc_pi ∪ (csn kc_proj ∪ kexa)))) ⊆ ω $ by cun_least [s1, u2]
m0: $ G ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
s0: $ G ⇒ csn kc_bvar ⊆ ω $ by csn_subset_c [m0]
u0: $ G ⇒ kstr ⊆ ω $ by cun_least [s0, u1]

lemma m4_lt_ne (G: hyps) (A B: class): $ G ⇒ A ∈ B $ > $ G ⇒ ¬ A = B $
----
l1: $ G , A = B ⇒ A ∈ B $ by weaken [#1]
l2: $ G , A = B ⇒ A = B $ by ax
l3: $ G , A = B ⇒ ⊥ $ by mem_ne [l1, l2]
l4: $ G ⇒ ¬ A = B $ by not_intro [l3]

lemma m4_ncsn (G: hyps) (A L: class) (x: set): $ G ⇒ x = A $ > $ G ⇒ ¬ A = L $ > $ G ⇒ ¬ x ∊ csn L $
----
l1: $ G , x ∊ csn L ⇒ x ∊ csn L $ by ax
l2: $ G , x ∊ csn L ⇒ x = L $ by csn_elim [l1]
l3: $ G , x ∊ csn L ⇒ x = A $ by weaken [#1]
l4: $ G , x ∊ csn L ⇒ A = x $ by eq_sym [l3]
l5: $ G , x ∊ csn L ⇒ A = L $ by eq_trans [l4, l2]
l6: $ G , x ∊ csn L ⇒ ¬ A = L $ by weaken [#2]
l7: $ G , x ∊ csn L ⇒ ⊥ $ by not_elim [l6, l5]
l8: $ G ⇒ ¬ x ∊ csn L $ by not_intro [l7]

lemma m4_ncun (G: hyps) (A B: class) (x: set): $ G ⇒ ¬ x ∊ A $ > $ G ⇒ ¬ x ∊ B $ > $ G ⇒ ¬ x ∊ A ∪ B $
----
l1: $ G , x ∊ A ∪ B ⇒ x ∊ A ∪ B $ by ax
l2: $ G , x ∊ A ∪ B ⇒ x ∊ A ∨ x ∊ B $ by cun_elim [l1]
l3: $ G , x ∊ A ∪ B , x ∊ A ⇒ ¬ x ∊ A $ by weaken [#1]
l4: $ G , x ∊ A ∪ B , x ∊ A ⇒ x ∊ A $ by ax
l5: $ G , x ∊ A ∪ B , x ∊ A ⇒ ⊥ $ by not_elim [l3, l4]
l6: $ G , x ∊ A ∪ B , x ∊ B ⇒ ¬ x ∊ B $ by weaken [#2]
l7: $ G , x ∊ A ∪ B , x ∊ B ⇒ x ∊ B $ by ax
l8: $ G , x ∊ A ∪ B , x ∊ B ⇒ ⊥ $ by not_elim [l6, l7]
l9: $ G , x ∊ A ∪ B ⇒ ⊥ $ by or_elim [l2, l5, l8]
l10: $ G ⇒ ¬ x ∊ A ∪ B $ by not_intro [l9]

-- m4: a label is not one of kexa when it differs from each of its nine.

lemma m4_nkexa (G: hyps) (A: class): $ G ⇒ ¬ A = kc_cst $ > $ G ⇒ ¬ A = kc_lit $ > $ G ⇒ ¬ A = kc_ind_ty $ > $ G ⇒ ¬ A = kc_ind_ctor $ > $ G ⇒ ¬ A = kc_ind_rec $ > $ G ⇒ ¬ A = kc_quot $ > $ G ⇒ ¬ A = kc_quot_mk $ > $ G ⇒ ¬ A = kc_quot_lift $ > $ G ⇒ ¬ A = kc_quot_ind $ > $ G ⇒ ¬ A ∈ kexa $
----
l1: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_cst $ by weaken [#1]
l2: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_lit $ by weaken [#2]
l3: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_ind_ty $ by weaken [#3]
l4: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_ind_ctor $ by weaken [#4]
l5: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_ind_rec $ by weaken [#5]
l6: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_quot $ by weaken [#6]
l7: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_quot_mk $ by weaken [#7]
l8: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_quot_lift $ by weaken [#8]
l9: $ G , x = A , x ∊ kexa ⇒ ¬ A = kc_quot_ind $ by weaken [#9]
l10: $ G , x = A , x ∊ kexa ⇒ x = A $ by ax
l11: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_cst $ by m4_ncsn [l10, l1]
l12: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_lit $ by m4_ncsn [l10, l2]
l13: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_ind_ty $ by m4_ncsn [l10, l3]
l14: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_ind_ctor $ by m4_ncsn [l10, l4]
l15: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_ind_rec $ by m4_ncsn [l10, l5]
l16: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_quot $ by m4_ncsn [l10, l6]
l17: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_quot_mk $ by m4_ncsn [l10, l7]
l18: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_quot_lift $ by m4_ncsn [l10, l8]
l19: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_quot_ind $ by m4_ncsn [l10, l9]
l20: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_quot_lift ∪ csn kc_quot_ind $ by m4_ncun [l18, l19]
l21: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_quot_mk ∪ (csn kc_quot_lift ∪ csn kc_quot_ind) $ by m4_ncun [l17, l20]
l22: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_quot ∪ (csn kc_quot_mk ∪ (csn kc_quot_lift ∪ csn kc_quot_ind)) $ by m4_ncun [l16, l21]
l23: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_ind_rec ∪ (csn kc_quot ∪ (csn kc_quot_mk ∪ (csn kc_quot_lift ∪ csn kc_quot_ind))) $ by m4_ncun [l15, l22]
l24: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_ind_ctor ∪ (csn kc_ind_rec ∪ (csn kc_quot ∪ (csn kc_quot_mk ∪ (csn kc_quot_lift ∪ csn kc_quot_ind)))) $ by m4_ncun [l14, l23]
l25: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_ind_ty ∪ (csn kc_ind_ctor ∪ (csn kc_ind_rec ∪ (csn kc_quot ∪ (csn kc_quot_mk ∪ (csn kc_quot_lift ∪ csn kc_quot_ind))))) $ by m4_ncun [l13, l24]
l26: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ csn kc_lit ∪ (csn kc_ind_ty ∪ (csn kc_ind_ctor ∪ (csn kc_ind_rec ∪ (csn kc_quot ∪ (csn kc_quot_mk ∪ (csn kc_quot_lift ∪ csn kc_quot_ind)))))) $ by m4_ncun [l12, l25]
l27: $ G , x = A , x ∊ kexa ⇒ ¬ x ∊ kexa $ by m4_ncun [l11, l26]
l28: $ G , x = A , x ∊ kexa ⇒ x ∊ kexa $ by ax
l29: $ G , x = A , x ∊ kexa ⇒ ⊥ $ by not_elim [l27, l28]
l30: $ G , A ∈ kexa ⇒ A ∈ kexa $ by ax
l31: $ G , A ∈ kexa ⇒ ⊥ $ by wcel_elim [l30, l29]
l32: $ G ⇒ ¬ A ∈ kexa $ by not_intro [l31]

kexa_notin_lt
-------------
l1: $ G ⇒ A ∈ kc_nil $ by suc_mem_r [#1]
l2: $ G ⇒ A ∈ kc_cons $ by suc_mem_r [l1]
l3: $ G ⇒ A ∈ kc_b0 $ by suc_mem_r [l2]
l4: $ G ⇒ A ∈ kc_bd0 $ by suc_mem_r [l3]
l5: $ G ⇒ A ∈ kc_bd1 $ by suc_mem_r [l4]
l6: $ G ⇒ A ∈ kc_lit $ by suc_mem_r [l5]
l7: $ G ⇒ A ∈ kc_ind_mk $ by suc_mem_r [l6]
l8: $ G ⇒ A ∈ kc_tnil $ by suc_mem_r [l7]
l9: $ G ⇒ A ∈ kc_tcons $ by suc_mem_r [l8]
l10: $ G ⇒ A ∈ kc_cnil $ by suc_mem_r [l9]
l11: $ G ⇒ A ∈ kc_ccons $ by suc_mem_r [l10]
l12: $ G ⇒ A ∈ kc_ind_mkn $ by suc_mem_r [l11]
l13: $ G ⇒ A ∈ kc_ind_ty $ by suc_mem_r [l12]
l14: $ G ⇒ A ∈ kc_ind_ctor $ by suc_mem_r [l13]
l15: $ G ⇒ A ∈ kc_ind_rec $ by suc_mem_r [l14]
l16: $ G ⇒ A ∈ kc_proj $ by suc_mem_r [l15]
l17: $ G ⇒ A ∈ kc_nat_blk $ by suc_mem_r [l16]
l18: $ G ⇒ A ∈ kc_eq_blk $ by suc_mem_r [l17]
l19: $ G ⇒ A ∈ kc_quot $ by suc_mem_r [l18]
l20: $ G ⇒ A ∈ kc_quot_mk $ by suc_mem_r [l19]
l21: $ G ⇒ A ∈ kc_quot_lift $ by suc_mem_r [l20]
l22: $ G ⇒ A ∈ kc_quot_ind $ by suc_mem_r [l21]
l23: $ G ⇒ ¬ A = kc_cst $ by m4_lt_ne [#1]
l24: $ G ⇒ ¬ A = kc_lit $ by m4_lt_ne [l6]
l25: $ G ⇒ ¬ A = kc_ind_ty $ by m4_lt_ne [l13]
l26: $ G ⇒ ¬ A = kc_ind_ctor $ by m4_lt_ne [l14]
l27: $ G ⇒ ¬ A = kc_ind_rec $ by m4_lt_ne [l15]
l28: $ G ⇒ ¬ A = kc_quot $ by m4_lt_ne [l19]
l29: $ G ⇒ ¬ A = kc_quot_mk $ by m4_lt_ne [l20]
l30: $ G ⇒ ¬ A = kc_quot_lift $ by m4_lt_ne [l21]
l31: $ G ⇒ ¬ A = kc_quot_ind $ by m4_lt_ne [l22]
l32: $ G ⇒ ¬ A ∈ kexa $ by m4_nkexa [l23, l24, l25, l26, l27, l28, l29, l30, l31]

kexa_notin_proj
---------------
l1: $ G ⇒ ¬ kc_cst = kc_proj $ by kc_cst_ne_proj
l2: $ G ⇒ ¬ kc_proj = kc_cst $ by ne_sym [l1]
l3: $ G ⇒ ¬ kc_lit = kc_proj $ by kc_lit_ne_proj
l4: $ G ⇒ ¬ kc_proj = kc_lit $ by ne_sym [l3]
l5: $ G ⇒ ¬ kc_ind_ty = kc_proj $ by kc_ind_ty_ne_proj
l6: $ G ⇒ ¬ kc_proj = kc_ind_ty $ by ne_sym [l5]
l7: $ G ⇒ ¬ kc_ind_ctor = kc_proj $ by kc_ind_ctor_ne_proj
l8: $ G ⇒ ¬ kc_proj = kc_ind_ctor $ by ne_sym [l7]
l9: $ G ⇒ ¬ kc_ind_rec = kc_proj $ by kc_ind_rec_ne_proj
l10: $ G ⇒ ¬ kc_proj = kc_ind_rec $ by ne_sym [l9]
l12: $ G ⇒ ¬ kc_proj = kc_quot $ by kc_proj_ne_quot
l14: $ G ⇒ ¬ kc_proj = kc_quot_mk $ by kc_proj_ne_quot_mk
l16: $ G ⇒ ¬ kc_proj = kc_quot_lift $ by kc_proj_ne_quot_lift
l18: $ G ⇒ ¬ kc_proj = kc_quot_ind $ by kc_proj_ne_quot_ind
l19: $ G ⇒ ¬ kc_proj ∈ kexa $ by m4_nkexa [l2, l4, l6, l8, l10, l12, l14, l16, l18]

lemma m3_case_and (G: hyps) (p q: fml) (A B: class) (z: set): $ G , q ⇒ z ∊ B $ > $ G , (p ∧ z ∊ A) ∨ q ⇒ z ∊ A ∪ B $
----
l1: $ G , (p ∧ z ∊ A) ∨ q ⇒ (p ∧ z ∊ A) ∨ q $ by ax
l2: $ G , (p ∧ z ∊ A) ∨ q , p ∧ z ∊ A ⇒ p ∧ z ∊ A $ by ax
l3: $ G , (p ∧ z ∊ A) ∨ q , p ∧ z ∊ A ⇒ z ∊ A $ by and_elim_r [l2]
l4: $ G , (p ∧ z ∊ A) ∨ q , p ∧ z ∊ A ⇒ z ∊ A ∪ B $ by cun_intro_l [l3]
l5: $ G , (p ∧ z ∊ A) ∨ q , q ⇒ z ∊ B $ by weaken [#1]
l6: $ G , (p ∧ z ∊ A) ∨ q , q ⇒ z ∊ A ∪ B $ by cun_intro_r [l5]
l7: $ G , (p ∧ z ∊ A) ∨ q ⇒ z ∊ A ∪ B $ by or_elim [l1, l4, l6]

lemma m3_or_case (G: hyps) (p q c: fml): $ G , p ⇒ c $ > $ G , q ⇒ c $ > $ G , p ∨ q ⇒ c $
----
l1: $ G , p ∨ q ⇒ p ∨ q $ by ax
l2: $ G , p ∨ q , p ⇒ c $ by weaken [#1]
l3: $ G , p ∨ q , q ⇒ c $ by weaken [#2]
l4: $ G , p ∨ q ⇒ c $ by or_elim [l1, l2, l3]

--| The values of a functional relation at any class form a set.
lemma m3_ap_rel (G: hyps) (F A: class): $ G ⇒ functional F $ > $ G ⇒ rel F $ > $ G ⇒ isset (ap F A) $
----
l1: $ G ⇒ isset A ∨ ¬ isset A $ by excluded_middle
l2: $ G , isset A ⇒ isset A $ by ax
l3: $ G , isset A , x = A ⇒ functional F $ by weaken [#1]
l4: $ G , isset A , x = A ⇒ isset (ap F x) $ by ap_functional_set [l3]
l5: $ G , isset A , x = A ⇒ F = F $ by eq_refl
l6: $ G , isset A , x = A ⇒ x = A $ by ax
l7: $ G , isset A , x = A ⇒ ap F x = ap F A $ by ap_eq [l5, l6]
l8: $ G , isset A , x = A ⇒ isset (ap F A) $ by isset_eq [l7, l4]
l9: $ G , isset A ⇒ isset (ap F A) $ by isset_elim [l2, l8]
l10: $ G , ¬ isset A , y ∊ ap F A ⇒ y ∊ ap F A $ by ax
l11: $ G , ¬ isset A , y ∊ ap F A ⇒ ⟨ A , y ⟩ ∈ F $ by ap_elim [l10]
l12: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F ⇒ rel F $ by weaken [#2]
l13: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F ⇒ x ∊ F $ by ax
l14: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , x = ⟨ a , b ⟩ ⇒ x = ⟨ A , y ⟩ $ by ax
l15: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , x = ⟨ a , b ⟩ ⇒ ⟨ A , y ⟩ = x $ by eq_sym [l14]
l16: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , x = ⟨ a , b ⟩ ⇒ x = ⟨ a , b ⟩ $ by ax
l17: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , x = ⟨ a , b ⟩ ⇒ ⟨ A , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [l15, l16]
l18: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , x = ⟨ a , b ⟩ ⇒ isset A $ by opair_eq_isset [l17]
l19: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , x = ⟨ a , b ⟩ ⇒ ¬ isset A $ by ax
l20: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F , x = ⟨ a , b ⟩ ⇒ ⊥ $ by not_elim [l19, l18]
l21: $ G , ¬ isset A , y ∊ ap F A , x = ⟨ A , y ⟩ , x ∊ F ⇒ ⊥ $ by rel_elim [l12, l13, l20]
l22: $ G , ¬ isset A , y ∊ ap F A ⇒ ⊥ $ by wcel_elim [l11, l21]
l23: $ G , ¬ isset A , y ∊ ap F A ⇒ y ∊ ∅ $ by bot_elim [l22]
l24: $ G , ¬ isset A ⇒ ap F A ⊆ ∅ $ by subset_intro [l23]
l25: $ G , ¬ isset A ⇒ isset ∅ $ by ax_empty
l26: $ G , ¬ isset A ⇒ isset (ap F A) $ by subset_isset [l25, l24]
l27: $ G ⇒ isset (ap F A) $ by or_elim [l1, l9, l26]

lemma m3_fv_rel (G: hyps) (F A: class): $ G ⇒ functional F $ > $ G ⇒ rel F $ > $ G ⇒ isset (fv F A) $
----
l1: $ G ⇒ isset (ap F A) $ by m3_ap_rel [#1, #2]
l2: $ G ⇒ isset (fv F A) $ by cuni_set [l1]

lemma m3_mclip_set (G: hyps) (U A: class): $ G ⇒ isset U $ > $ G ⇒ isset (mclip U A) $
----
l1: $ G , y ∊ mclip U A ⇒ y ∊ mclip U A $ by ax
l2: $ G , y ∊ mclip U A ⇒ y ∊ A ∧ A ∈ U $ by cab_elim [l1]
l3: $ G , y ∊ mclip U A ⇒ y ∊ A $ by and_elim_l [l2]
l4: $ G , y ∊ mclip U A ⇒ A ∈ U $ by and_elim_r [l2]
l5: $ G , y ∊ mclip U A , c = A , c ∊ U ⇒ c = A $ by ax
l6: $ G , y ∊ mclip U A , c = A , c ∊ U ⇒ A = c $ by eq_sym [l5]
l7: $ G , y ∊ mclip U A , c = A , c ∊ U ⇒ y ∊ A $ by weaken [l3]
l8: $ G , y ∊ mclip U A , c = A , c ∊ U ⇒ y ∊ c $ by welc_eq [l6, l7]
l9: $ G , y ∊ mclip U A , c = A , c ∊ U ⇒ c ∊ U $ by ax
l10: $ G , y ∊ mclip U A , c = A , c ∊ U ⇒ y ∊ ⋃ U $ by cuni_intro [l8, l9]
l11: $ G , y ∊ mclip U A ⇒ y ∊ ⋃ U $ by wcel_elim [l4, l10]
l12: $ G ⇒ mclip U A ⊆ ⋃ U $ by subset_intro [l11]
l13: $ G ⇒ isset (⋃ U) $ by cuni_set [#1]
l14: $ G ⇒ isset (mclip U A) $ by subset_isset [l13, l12]

lemma m3_cc_set (G: hyps) {w r: set} (u: set) (X: class w r): $ G ⇒ isset X $ > $ G ⇒ isset (clam w lvals (clam r (fseq u) X)) $
----
l1: $ G , r ∊ fseq u ⇒ isset X $ by weaken [#1]
l2: $ G ⇒ r ∊ fseq u → isset X $ by imp_intro [l1]
l3: $ G ⇒ ∀ r (r ∊ fseq u → isset X) $ by all_intro [l2]
l4: $ G ⇒ isset u $ by isset_var
l5: $ G ⇒ isset (fseq u) $ by fseq_set [l4]
l6: $ G ⇒ isset (clam r (fseq u) X) $ by clam_set [l5, l3]
l7: $ G , w ∊ lvals ⇒ isset (clam r (fseq u) X) $ by weaken [l6]
l8: $ G ⇒ w ∊ lvals → isset (clam r (fseq u) X) $ by imp_intro [l7]
l9: $ G ⇒ ∀ w (w ∊ lvals → isset (clam r (fseq u) X)) $ by all_intro [l8]
l10: $ G ⇒ isset lvals $ by lvals_set
l11: $ G ⇒ isset (clam w lvals (clam r (fseq u) X)) $ by clam_set [l10, l9]

