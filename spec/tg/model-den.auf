q1: $ G , z ∊ dnb A C E H J ⇒ z ∊ dnb A C E H J $ by ax
q2: $ G , z ∊ dnb A C E H J ⇒ ((E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ∨ ((E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ∨ ((E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ∨ ((E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ∨ ((E = kc_pi ∧ z ∊ clam w lvals (clam r (fseq A) (cpi x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ∨ ((E = kc_proj ∧ z ∊ clam w lvals (clam r (fseq A) (fv (da (fv J (suc (suc ∅))) w r) (suc (fv nvf (fv H (suc ∅))))))) ∨ ((E ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq A) (mclip A (ap (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩) w)))) ∨ (¬ E ∈ kstr ∧ z ∊ sclip (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩))))))))) $ by cab_elim [q1]
q3: $ G , z ∊ dnb A C E H J , ((E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ∨ ((E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ∨ ((E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ∨ ((E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ∨ ((E = kc_pi ∧ z ∊ clam w lvals (clam r (fseq A) (cpi x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ∨ ((E = kc_proj ∧ z ∊ clam w lvals (clam r (fseq A) (fv (da (fv J (suc (suc ∅))) w r) (suc (fv nvf (fv H (suc ∅))))))) ∨ ((E ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq A) (mclip A (ap (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩) w)))) ∨ (¬ E ∈ kstr ∧ z ∊ sclip (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩))))))))) ⇒ ((F = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq B) (fv r (fv nvf (fv I ∅))))) ∨ ((F = kc_srt ∧ z ∊ clam w lvals (clam r (fseq B) (fv uni (lv (fv I ∅) w)))) ∨ ((F = kc_app ∧ z ∊ clam w lvals (clam r (fseq B) (ap (da (fv K ∅) w r) (da (fv K (suc ∅)) w r)))) ∨ ((F = kc_lam ∧ z ∊ clam w lvals (clam r (fseq B) (clam x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r))))) ∨ ((F = kc_pi ∧ z ∊ clam w lvals (clam r (fseq B) (cpi x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r))))) ∨ ((F = kc_proj ∧ z ∊ clam w lvals (clam r (fseq B) (fv (da (fv K (suc (suc ∅))) w r) (suc (fv nvf (fv I (suc ∅))))))) ∨ ((F ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq B) (mclip B (ap (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩) w)))) ∨ (¬ F ∈ kstr ∧ z ∊ sclip (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩))))))))) $ by weaken [h0]
q4: $ G , z ∊ dnb A C E H J ⇒ ((E = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq A) (fv r (fv nvf (fv H ∅))))) ∨ ((E = kc_srt ∧ z ∊ clam w lvals (clam r (fseq A) (fv uni (lv (fv H ∅) w)))) ∨ ((E = kc_app ∧ z ∊ clam w lvals (clam r (fseq A) (ap (da (fv J ∅) w r) (da (fv J (suc ∅)) w r)))) ∨ ((E = kc_lam ∧ z ∊ clam w lvals (clam r (fseq A) (clam x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ∨ ((E = kc_pi ∧ z ∊ clam w lvals (clam r (fseq A) (cpi x (da (fv J ∅) w r) (da (fv J (suc ∅)) w (scons x r))))) ∨ ((E = kc_proj ∧ z ∊ clam w lvals (clam r (fseq A) (fv (da (fv J (suc (suc ∅))) w r) (suc (fv nvf (fv H (suc ∅))))))) ∨ ((E ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq A) (mclip A (ap (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩) w)))) ∨ (¬ E ∈ kstr ∧ z ∊ sclip (fv C ⟨ A , ⟨ E , ⟨ H , J ⟩ ⟩ ⟩))))))))) → ((F = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq B) (fv r (fv nvf (fv I ∅))))) ∨ ((F = kc_srt ∧ z ∊ clam w lvals (clam r (fseq B) (fv uni (lv (fv I ∅) w)))) ∨ ((F = kc_app ∧ z ∊ clam w lvals (clam r (fseq B) (ap (da (fv K ∅) w r) (da (fv K (suc ∅)) w r)))) ∨ ((F = kc_lam ∧ z ∊ clam w lvals (clam r (fseq B) (clam x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r))))) ∨ ((F = kc_pi ∧ z ∊ clam w lvals (clam r (fseq B) (cpi x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r))))) ∨ ((F = kc_proj ∧ z ∊ clam w lvals (clam r (fseq B) (fv (da (fv K (suc (suc ∅))) w r) (suc (fv nvf (fv I (suc ∅))))))) ∨ ((F ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq B) (mclip B (ap (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩) w)))) ∨ (¬ F ∈ kstr ∧ z ∊ sclip (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩))))))))) $ by imp_intro [q3]
q5: $ G , z ∊ dnb A C E H J ⇒ ((F = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq B) (fv r (fv nvf (fv I ∅))))) ∨ ((F = kc_srt ∧ z ∊ clam w lvals (clam r (fseq B) (fv uni (lv (fv I ∅) w)))) ∨ ((F = kc_app ∧ z ∊ clam w lvals (clam r (fseq B) (ap (da (fv K ∅) w r) (da (fv K (suc ∅)) w r)))) ∨ ((F = kc_lam ∧ z ∊ clam w lvals (clam r (fseq B) (clam x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r))))) ∨ ((F = kc_pi ∧ z ∊ clam w lvals (clam r (fseq B) (cpi x (da (fv K ∅) w r) (da (fv K (suc ∅)) w (scons x r))))) ∨ ((F = kc_proj ∧ z ∊ clam w lvals (clam r (fseq B) (fv (da (fv K (suc (suc ∅))) w r) (suc (fv nvf (fv I (suc ∅))))))) ∨ ((F ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq B) (mclip B (ap (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩) w)))) ∨ (¬ F ∈ kstr ∧ z ∊ sclip (fv D ⟨ B , ⟨ F , ⟨ I , K ⟩ ⟩ ⟩))))))))) $ by imp_elim [q4, q2]
q6: $ G , z ∊ dnb A C E H J ⇒ z ∊ dnb B D F I K $ by cab_intro [q5]
q7: $ G ⇒ dnb A C E H J ⊆ dnb B D F I K $ by subset_intro [q6]

dnb_eq
------
l1: $ G ⇒ dnb A C E H J ⊆ dnb B D F I K $ by q0_dnb_sub [#1, #2, #3, #4, #5]
l2: $ G ⇒ B = A $ by eq_sym [#1]
l3: $ G ⇒ D = C $ by eq_sym [#2]
l4: $ G ⇒ F = E $ by eq_sym [#3]
l5: $ G ⇒ I = H $ by eq_sym [#4]
l6: $ G ⇒ K = J $ by eq_sym [#5]
l7: $ G ⇒ dnb B D F I K ⊆ dnb A C E H J $ by q0_dnb_sub [l2, l3, l4, l5, l6]
l8: $ G ⇒ dnb A C E H J = dnb B D F I K $ by subset_antisym [l1, l7]

lemma t0_or1 (G: hyps) (fp fq fr: fml): $ G , fq ⇒ fr $ > $ G , fp ∨ fq ⇒ fp ∨ fr $
----
l1: $ G , fp ∨ fq ⇒ fp ∨ fq $ by ax
l2: $ G , fp ∨ fq , fp ⇒ fp $ by ax
l3: $ G , fp ∨ fq , fp ⇒ fp ∨ fr $ by or_intro_l [l2]
l4: $ G , fp ∨ fq , fq ⇒ fr $ by weaken [#1]
l5: $ G , fp ∨ fq , fq ⇒ fp ∨ fr $ by or_intro_r [l4]
l6: $ G , fp ∨ fq ⇒ fp ∨ fr $ by or_elim [l1, l3, l5]

lemma t0_or6 (G: hyps) (fa fb fc fd fe ff fq fr: fml): $ G , fq ⇒ fr $ > $ G , fa ∨ fb ∨ fc ∨ fd ∨ fe ∨ ff ∨ fq ⇒ fa ∨ fb ∨ fc ∨ fd ∨ fe ∨ ff ∨ fr $
----
l1: $ G , ff ∨ fq ⇒ ff ∨ fr $ by t0_or1 [#1]
l2: $ G , fe ∨ ff ∨ fq ⇒ fe ∨ ff ∨ fr $ by t0_or1 [l1]
l3: $ G , fd ∨ fe ∨ ff ∨ fq ⇒ fd ∨ fe ∨ ff ∨ fr $ by t0_or1 [l2]
l4: $ G , fc ∨ fd ∨ fe ∨ ff ∨ fq ⇒ fc ∨ fd ∨ fe ∨ ff ∨ fr $ by t0_or1 [l3]
l5: $ G , fb ∨ fc ∨ fd ∨ fe ∨ ff ∨ fq ⇒ fb ∨ fc ∨ fd ∨ fe ∨ ff ∨ fr $ by t0_or1 [l4]
l6: $ G , fa ∨ fb ∨ fc ∨ fd ∨ fe ∨ ff ∨ fq ⇒ fa ∨ fb ∨ fc ∨ fd ∨ fe ∨ ff ∨ fr $ by t0_or1 [l5]

lemma t0_dnb_tail {w r: set} (G: hyps) (U K X Y: class) (z: set): $ G ⇒ X = Y $ > $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) ⇒ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap Y w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip Y) $
----
e0: $ G ⇒ w = w $ by eq_refl
e1: $ G ⇒ ap X w = ap Y w $ by ap_eq [#1, e0]
e1b: $ G ⇒ U = U $ by eq_refl
e2: $ G ⇒ mclip U (ap X w) = mclip U (ap Y w) $ by mclip_eq [e1b, e1]
e3: $ G , r ∊ fseq U ⇒ mclip U (ap X w) = mclip U (ap Y w) $ by weaken [e2]
e4: $ G ⇒ r ∊ fseq U → mclip U (ap X w) = mclip U (ap Y w) $ by imp_intro [e3]
e5: $ G ⇒ ∀ r (r ∊ fseq U → mclip U (ap X w) = mclip U (ap Y w)) $ by all_intro [e4]
e6: $ G ⇒ clam r (fseq U) (mclip U (ap X w)) = clam r (fseq U) (mclip U (ap Y w)) $ by clam_eq_body [e5]
e7: $ G , w ∊ lvals ⇒ clam r (fseq U) (mclip U (ap X w)) = clam r (fseq U) (mclip U (ap Y w)) $ by weaken [e6]
e8: $ G ⇒ w ∊ lvals → clam r (fseq U) (mclip U (ap X w)) = clam r (fseq U) (mclip U (ap Y w)) $ by imp_intro [e7]
e9: $ G ⇒ ∀ w (w ∊ lvals → clam r (fseq U) (mclip U (ap X w)) = clam r (fseq U) (mclip U (ap Y w))) $ by all_intro [e8]
e10: $ G ⇒ clam w lvals (clam r (fseq U) (mclip U (ap X w))) = clam w lvals (clam r (fseq U) (mclip U (ap Y w))) $ by clam_eq_body [e9]
e11: $ G ⇒ sclip X = sclip Y $ by sclip_eq [#1]
a1: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) ⇒ K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) $ by ax
a2: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) ⇒ K ∈ kexa $ by and_elim_l [a1]
a3: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) ⇒ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) $ by and_elim_r [a1]
a3b: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) ⇒ clam w lvals (clam r (fseq U) (mclip U (ap X w))) = clam w lvals (clam r (fseq U) (mclip U (ap Y w))) $ by weaken [e10]
a4: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) ⇒ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap Y w))) $ by welc_eq [a3b, a3]
a5: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) ⇒ K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap Y w))) $ by and_intro [a2, a4]
a6: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w))) ⇒ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap Y w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip Y) $ by or_intro_l [a5]
b1: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , ¬ K ∈ kstr ∧ z ∊ sclip X ⇒ ¬ K ∈ kstr ∧ z ∊ sclip X $ by ax
b2: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , ¬ K ∈ kstr ∧ z ∊ sclip X ⇒ ¬ K ∈ kstr $ by and_elim_l [b1]
b3: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , ¬ K ∈ kstr ∧ z ∊ sclip X ⇒ z ∊ sclip X $ by and_elim_r [b1]
b3b: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , ¬ K ∈ kstr ∧ z ∊ sclip X ⇒ sclip X = sclip Y $ by weaken [e11]
b4: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , ¬ K ∈ kstr ∧ z ∊ sclip X ⇒ z ∊ sclip Y $ by welc_eq [b3b, b3]
b5: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , ¬ K ∈ kstr ∧ z ∊ sclip X ⇒ ¬ K ∈ kstr ∧ z ∊ sclip Y $ by and_intro [b2, b4]
b6: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) , ¬ K ∈ kstr ∧ z ∊ sclip X ⇒ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap Y w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip Y) $ by or_intro_r [b5]
c0: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) ⇒ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) $ by ax
c1: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap X w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip X) ⇒ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap Y w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip Y) $ by or_elim [c0, a6, b6]

lemma t0_dnb_hook_sub (G: hyps) (U M N K S V: class): $ G ⇒ fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ $ > $ G ⇒ dnb U M K S V ⊆ dnb U N K S V $
----
q1: $ G , z ∊ dnb U M K S V ⇒ z ∊ {z | (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq U) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq U) (ap (da (fv V ∅) w r) (da (fv V (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq U) (clam x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq U) (cpi x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq U) (fv (da (fv V (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩))} $ by ax
q2: $ G , z ∊ dnb U M K S V ⇒ (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq U) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq U) (ap (da (fv V ∅) w r) (da (fv V (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq U) (clam x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq U) (cpi x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq U) (fv (da (fv V (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by cab_elim [q1]
q3: $ G , (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) ⇒ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by t0_dnb_tail [#1]
q4: $ G , (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq U) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq U) (ap (da (fv V ∅) w r) (da (fv V (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq U) (clam x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq U) (cpi x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq U) (fv (da (fv V (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) ⇒ (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq U) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq U) (ap (da (fv V ∅) w r) (da (fv V (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq U) (clam x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq U) (cpi x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq U) (fv (da (fv V (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by t0_or6 [q3]
q5: $ G , z ∊ dnb U M K S V ⇒ (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq U) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq U) (ap (da (fv V ∅) w r) (da (fv V (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq U) (clam x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq U) (cpi x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq U) (fv (da (fv V (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by cut [q2, q4]
q6: $ G , z ∊ dnb U M K S V ⇒ z ∊ {z | (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq U) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq U) (ap (da (fv V ∅) w r) (da (fv V (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq U) (clam x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq U) (cpi x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq U) (fv (da (fv V (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩))} $ by cab_intro [q5]
q7: $ G , z ∊ dnb U M K S V ⇒ z ∊ dnb U N K S V $ by weaken [q6]
q8: $ G ⇒ dnb U M K S V ⊆ dnb U N K S V $ by subset_intro [q7]

dnb_hook
--------
l1: $ G ⇒ dnb U M K S V ⊆ dnb U N K S V $ by t0_dnb_hook_sub [#1]
l2: $ G ⇒ fv N ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ = fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩ $ by eq_sym [#1]
l3: $ G ⇒ dnb U N K S V ⊆ dnb U M K S V $ by t0_dnb_hook_sub [l2]
l4: $ G ⇒ dnb U M K S V = dnb U N K S V $ by subset_antisym [l1, l3]

dnf_congr
---------
g1: $ ω ≐ ω $ by ceqt_refl
g2: $ i ≐ i $ by ceqt_refl
g3: $ j ≐ j $ by ceqt_refl
g4: $ k ≐ k $ by ceqt_refl
g5: $ (dnb A C i j k) ≐ (dnb B D i j k) $ by dnb_congr [#1, #2, g2, g3, g4]
g6: $ (cgr3 i j k (dnb A C i j k)) ≐ (cgr3 i j k (dnb B D i j k)) $ by cgr3_congr [g5]
g7: $ dnf A C ≐ dnf B D $ by trc_congr [g1, g6]

sb_c_dnf
--------
l1: $ (⟦ x / t ⟧ (trc ω (cgr3 i j k (dnb A B i j k)))) ≐ trc ω (cgr3 i j k (dnb (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) i j k)) $ by ceqt_refl

dt_congr
--------
g1: $ (dnf A C) ≐ (dnf B D) $ by dnf_congr [#1, #2]
g2: $ (fv (dnf A C) E) ≐ (fv (dnf B D) F) $ by fv_congr [g1, #3]
g3: $ dt A C E H J ≐ dt B D F I K $ by da_congr [g2, #4, #5]

dnf_eq
------
e1: $ G ⇒ i = i $ by eq_refl
e2: $ G ⇒ j = j $ by eq_refl
e3: $ G ⇒ k = k $ by eq_refl
l5: $ G ⇒ dnb A C i j k = dnb B D i j k $ by dnb_eq [#1, #2, e1, e2, e3]
l7: $ G ⇒ ∀ i (dnb A C i j k = dnb B D i j k) $ by all_intro [l5]
l8: $ G ⇒ ∀ j ∀ i (dnb A C i j k = dnb B D i j k) $ by all_intro [l7]
l9: $ G ⇒ ∀ k ∀ j ∀ i (dnb A C i j k = dnb B D i j k) $ by all_intro [l8]
n3: $ G ⇒ cgr3 i j k (dnb A C i j k) = cgr3 i j k (dnb B D i j k) $ by cgr3_eq [l9]
n4: $ G ⇒ ω = ω $ by eq_refl
n5: $ G ⇒ trc ω (cgr3 i j k (dnb A C i j k)) = trc ω (cgr3 i j k (dnb B D i j k)) $ by trc_eq [n4, n3]
n6: $ G ⇒ dnf A C = dnf B D $ by weaken [n5]

dt_eq
-----
l1: $ G ⇒ dnf A C = dnf B D $ by dnf_eq [#1, #2]
l2: $ G ⇒ fv (dnf A C) E = fv (dnf B D) F $ by fv_eq [l1, #3]
l3: $ G ⇒ ap (fv (dnf A C) E) H = ap (fv (dnf B D) F) I $ by ap_eq [l2, #4]
l4: $ G ⇒ ap (ap (fv (dnf A C) E) H) J = ap (ap (fv (dnf B D) F) I) K $ by ap_eq [l3, #5]
l5: $ G ⇒ dt A C E H J = dt B D F I K $ by weaken [l4]

sb_c_dt
-------
l1: $ (⟦ x / t ⟧ (da (fv (dnf A B) C) D E)) ≐ da (fv (dnf (⟦ x / t ⟧ A) (⟦ x / t ⟧ B)) (⟦ x / t ⟧ C)) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) $ by ceqt_refl

mclip_in
--------
l1: $ G , y ∊ mclip U A ⇒ y ∊ {y | y ∊ A ∧ A ∈ U} $ by ax
l2: $ G , y ∊ mclip U A ⇒ y ∊ A ∧ A ∈ U $ by cab_elim [l1]
l3: $ G , y ∊ mclip U A ⇒ y ∊ A $ by and_elim_l [l2]
l4: $ G , y ∊ A ⇒ y ∊ A $ by ax
l5: $ G , y ∊ A ⇒ A ∈ U $ by weaken [#1]
l6: $ G , y ∊ A ⇒ y ∊ A ∧ A ∈ U $ by and_intro [l4, l5]
l7: $ G , y ∊ A ⇒ y ∊ {y | y ∊ A ∧ A ∈ U} $ by cab_intro [l6]
l8: $ G , y ∊ A ⇒ y ∊ mclip U A $ by weaken [l7]
l9: $ G ⇒ mclip U A = A $ by eq_intro [l3, l8]

mclip_out
---------
l1: $ G , y ∊ mclip U A ⇒ y ∊ {y | y ∊ A ∧ A ∈ U} $ by ax
l2: $ G , y ∊ mclip U A ⇒ y ∊ A ∧ A ∈ U $ by cab_elim [l1]
l3: $ G , y ∊ mclip U A ⇒ A ∈ U $ by and_elim_r [l2]
l4: $ G , y ∊ mclip U A ⇒ ¬ A ∈ U $ by weaken [#1]
l5: $ G , y ∊ mclip U A ⇒ ⊥ $ by not_elim [l4, l3]
l6: $ G , y ∊ mclip U A ⇒ y ∊ ∅ $ by bot_elim [l5]
l7: $ G , y ∊ ∅ ⇒ y ∊ ∅ $ by ax
l8: $ G , y ∊ ∅ ⇒ ⊥ $ by empty_elim [l7]
l9: $ G , y ∊ ∅ ⇒ y ∊ mclip U A $ by bot_elim [l8]
l10: $ G ⇒ mclip U A = ∅ $ by eq_intro [l6, l9]

mclip_u
-------
l1: $ G ⇒ A ∈ U ∨ ¬ A ∈ U $ by excluded_middle
l2: $ G , A ∈ U ⇒ A ∈ U $ by ax
l3: $ G , A ∈ U ⇒ mclip U A = A $ by mclip_in [l2]
l4: $ G , A ∈ U ⇒ A = mclip U A $ by eq_sym [l3]
l5: $ G , A ∈ U ⇒ mclip U A ∈ U $ by wcel_eq_l [l4, l2]
l6: $ G , ¬ A ∈ U ⇒ ¬ A ∈ U $ by ax
l7: $ G , ¬ A ∈ U ⇒ mclip U A = ∅ $ by mclip_out [l6]
l8: $ G , ¬ A ∈ U ⇒ ∅ = mclip U A $ by eq_sym [l7]
l9: $ G , ¬ A ∈ U ⇒ ∅ ∈ U $ by weaken [#1]
l10: $ G , ¬ A ∈ U ⇒ mclip U A ∈ U $ by wcel_eq_l [l8, l9]
l11: $ G ⇒ mclip U A ∈ U $ by or_elim [l1, l5, l10]

sclip_in
--------
l1: $ G , y ∊ sclip A ⇒ y ∊ {y | y ∊ A ∧ isset A} $ by ax
l2: $ G , y ∊ sclip A ⇒ y ∊ A ∧ isset A $ by cab_elim [l1]
l3: $ G , y ∊ sclip A ⇒ y ∊ A $ by and_elim_l [l2]
l4: $ G , y ∊ A ⇒ y ∊ A $ by ax
l5: $ G , y ∊ A ⇒ isset A $ by weaken [#1]
l6: $ G , y ∊ A ⇒ y ∊ A ∧ isset A $ by and_intro [l4, l5]
l7: $ G , y ∊ A ⇒ y ∊ {y | y ∊ A ∧ isset A} $ by cab_intro [l6]
l8: $ G , y ∊ A ⇒ y ∊ sclip A $ by weaken [l7]
l9: $ G ⇒ sclip A = A $ by eq_intro [l3, l8]

sclip_out
---------
l1: $ G , y ∊ sclip A ⇒ y ∊ {y | y ∊ A ∧ isset A} $ by ax
l2: $ G , y ∊ sclip A ⇒ y ∊ A ∧ isset A $ by cab_elim [l1]
l3: $ G , y ∊ sclip A ⇒ isset A $ by and_elim_r [l2]
l4: $ G , y ∊ sclip A ⇒ ¬ isset A $ by weaken [#1]
l5: $ G , y ∊ sclip A ⇒ ⊥ $ by not_elim [l4, l3]
l6: $ G , y ∊ sclip A ⇒ y ∊ ∅ $ by bot_elim [l5]
l7: $ G , y ∊ ∅ ⇒ y ∊ ∅ $ by ax
l8: $ G , y ∊ ∅ ⇒ ⊥ $ by empty_elim [l7]
l9: $ G , y ∊ ∅ ⇒ y ∊ sclip A $ by bot_elim [l8]
l10: $ G ⇒ sclip A = ∅ $ by eq_intro [l6, l9]

sclip_set
---------
l1: $ G ⇒ isset A ∨ ¬ isset A $ by excluded_middle
l2: $ G , isset A ⇒ isset A $ by ax
l3: $ G , isset A ⇒ sclip A = A $ by sclip_in [l2]
l4: $ G , isset A ⇒ A = sclip A $ by eq_sym [l3]
l5: $ G , isset A ⇒ isset (sclip A) $ by isset_eq [l4, l2]
l6: $ G , ¬ isset A ⇒ ¬ isset A $ by ax
l7: $ G , ¬ isset A ⇒ sclip A = ∅ $ by sclip_out [l6]
l8: $ G , ¬ isset A ⇒ ∅ = sclip A $ by eq_sym [l7]
l9: $ G , ¬ isset A ⇒ isset ∅ $ by ax_empty
l10: $ G , ¬ isset A ⇒ isset (sclip A) $ by isset_eq [l8, l9]
l11: $ G ⇒ isset (sclip A) $ by or_elim [l1, l5, l10]

kexa_omega
----------
