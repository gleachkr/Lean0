mclip_congr
-----------
l0: $ seqt y y $ by seqt_refl
l1: $ (y ∊ C) ⟺ (y ∊ D) $ by welc_congr [l0, #2]
l2: $ (C ∈ A) ⟺ (D ∈ B) $ by wcel_congr [#2, #1]
l3: $ (y ∊ C ∧ C ∈ A) ⟺ (y ∊ D ∧ D ∈ B) $ by and_congr [l1, l2]
l4: $ mclip A C ≐ mclip B D $ by cab_congr [l3]

sb_c_mclip
----------
l1: $ (⟦ x / t ⟧ {y | y ∊ B ∧ B ∈ A}) ≐ {y | y ∊ (⟦ x / t ⟧ B) ∧ (⟦ x / t ⟧ B) ∈ (⟦ x / t ⟧ A)} $ by ceqt_refl

lemma m2_mclip_sub (G: hyps) (A B C D: class): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ mclip A C ⊆ mclip B D $
----
l1: $ G , y ∊ mclip A C ⇒ y ∊ {y | y ∊ C ∧ C ∈ A} $ by ax
l2: $ G , y ∊ mclip A C ⇒ y ∊ C ∧ C ∈ A $ by cab_elim [l1]
l3: $ G , y ∊ mclip A C ⇒ y ∊ C $ by and_elim_l [l2]
l4: $ G , y ∊ mclip A C ⇒ C ∈ A $ by and_elim_r [l2]
l5: $ G , y ∊ mclip A C ⇒ C = D $ by weaken [#2]
l6: $ G , y ∊ mclip A C ⇒ A = B $ by weaken [#1]
l7: $ G , y ∊ mclip A C ⇒ y ∊ D $ by welc_eq [l5, l3]
l8: $ G , y ∊ mclip A C ⇒ D ∈ A $ by wcel_eq_l [l5, l4]
l9: $ G , y ∊ mclip A C ⇒ D ∈ B $ by wcel_eq_r [l6, l8]
l10: $ G , y ∊ mclip A C ⇒ y ∊ D ∧ D ∈ B $ by and_intro [l7, l9]
l11: $ G , y ∊ mclip A C ⇒ y ∊ {y | y ∊ D ∧ D ∈ B} $ by cab_intro [l10]
l12: $ G , y ∊ mclip A C ⇒ y ∊ mclip B D $ by weaken [l11]
l13: $ G ⇒ mclip A C ⊆ mclip B D $ by subset_intro [l12]

mclip_eq
--------
l1: $ G ⇒ mclip A C ⊆ mclip B D $ by m2_mclip_sub [#1, #2]
l2: $ G ⇒ B = A $ by eq_sym [#1]
l3: $ G ⇒ D = C $ by eq_sym [#2]
l4: $ G ⇒ mclip B D ⊆ mclip A C $ by m2_mclip_sub [l2, l3]
l5: $ G ⇒ mclip A C = mclip B D $ by subset_antisym [l1, l4]

sclip_congr
-----------
l0: $ seqt y y $ by seqt_refl
l1: $ (y ∊ A) ⟺ (y ∊ B) $ by welc_congr [l0, #1]
l2: $ isset A ⟺ isset B $ by isset_congr [#1]
l3: $ (y ∊ A ∧ isset A) ⟺ (y ∊ B ∧ isset B) $ by and_congr [l1, l2]
l4: $ sclip A ≐ sclip B $ by cab_congr [l3]

sb_c_sclip
----------
l1: $ (⟦ x / t ⟧ {y | y ∊ A ∧ isset A}) ≐ {y | y ∊ (⟦ x / t ⟧ A) ∧ isset (⟦ x / t ⟧ A)} $ by ceqt_refl

lemma m2_sclip_sub (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ sclip A ⊆ sclip B $
----
l1: $ G , y ∊ sclip A ⇒ y ∊ {y | y ∊ A ∧ isset A} $ by ax
l2: $ G , y ∊ sclip A ⇒ y ∊ A ∧ isset A $ by cab_elim [l1]
l3: $ G , y ∊ sclip A ⇒ y ∊ A $ by and_elim_l [l2]
l4: $ G , y ∊ sclip A ⇒ isset A $ by and_elim_r [l2]
l5: $ G , y ∊ sclip A ⇒ A = B $ by weaken [#1]
l6: $ G , y ∊ sclip A ⇒ y ∊ B $ by welc_eq [l5, l3]
l7: $ G , y ∊ sclip A ⇒ isset B $ by isset_eq [l5, l4]
l8: $ G , y ∊ sclip A ⇒ y ∊ B ∧ isset B $ by and_intro [l6, l7]
l9: $ G , y ∊ sclip A ⇒ y ∊ {y | y ∊ B ∧ isset B} $ by cab_intro [l8]
l10: $ G , y ∊ sclip A ⇒ y ∊ sclip B $ by weaken [l9]
l11: $ G ⇒ sclip A ⊆ sclip B $ by subset_intro [l10]

sclip_eq
--------
l1: $ G ⇒ sclip A ⊆ sclip B $ by m2_sclip_sub [#1]
l2: $ G ⇒ B = A $ by eq_sym [#1]
l3: $ G ⇒ sclip B ⊆ sclip A $ by m2_sclip_sub [l2]
l4: $ G ⇒ sclip A = sclip B $ by subset_antisym [l1, l3]

