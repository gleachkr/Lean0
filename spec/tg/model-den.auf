n31: $ G , a = kc_srt , a ∊ ω ⇒ ap (ap (fv (dnf u M) ⟨ kc_srt , scons T ∅ ⟩) w) r = fv uni (lv T w) $ by wcel_elim [l2, n30]
n32: $ G ⇒ ap (ap (fv (dnf u M) ⟨ kc_srt , scons T ∅ ⟩) w) r = fv uni (lv T w) $ by wcel_elim [l1, n31]

lemma m4_ds_l (G: hyps) (p q: fml): $ G ⇒ ¬ p $ > $ G ⇒ p ∨ q $ > $ G ⇒ q $
----
l1: $ G , p ⇒ ¬ p $ by weaken [#1]
l2: $ G , p ⇒ p $ by ax
l3: $ G , p ⇒ ⊥ $ by not_elim [l1, l2]
l4: $ G , p ⇒ q $ by bot_elim [l3]
l5: $ G , q ⇒ q $ by ax
l6: $ G ⇒ q $ by or_elim [#2, l4, l5]

lemma m4_ds_r (G: hyps) (p q: fml): $ G ⇒ ¬ q $ > $ G ⇒ p ∨ q $ > $ G ⇒ p $
----
l1: $ G , q ⇒ ¬ q $ by weaken [#1]
l2: $ G , q ⇒ q $ by ax
l3: $ G , q ⇒ ⊥ $ by not_elim [l1, l2]
l4: $ G , q ⇒ p $ by bot_elim [l3]
l5: $ G , p ⇒ p $ by ax
l6: $ G ⇒ p $ by or_elim [#2, l5, l4]

lemma m4_nor (G: hyps) (p q: fml): $ G ⇒ ¬ p $ > $ G ⇒ ¬ q $ > $ G ⇒ ¬ (p ∨ q) $
----
l1: $ G , p ∨ q ⇒ p ∨ q $ by ax
l2: $ G , p ∨ q , p ⇒ ¬ p $ by weaken [#1]
l3: $ G , p ∨ q , p ⇒ p $ by ax
l4: $ G , p ∨ q , p ⇒ ⊥ $ by not_elim [l2, l3]
l5: $ G , p ∨ q , q ⇒ ¬ q $ by weaken [#2]
l6: $ G , p ∨ q , q ⇒ q $ by ax
l7: $ G , p ∨ q , q ⇒ ⊥ $ by not_elim [l5, l6]
l8: $ G , p ∨ q ⇒ ⊥ $ by or_elim [l1, l4, l7]
l9: $ G ⇒ ¬ (p ∨ q) $ by not_intro [l8]

lemma m4_nand (G: hyps) (p q: fml): $ G ⇒ ¬ p $ > $ G ⇒ ¬ (p ∧ q) $
----
l1: $ G , p ∧ q ⇒ p ∧ q $ by ax
l2: $ G , p ∧ q ⇒ p $ by and_elim_l [l1]
l3: $ G , p ∧ q ⇒ ¬ p $ by weaken [#1]
l4: $ G , p ∧ q ⇒ ⊥ $ by not_elim [l3, l2]
l5: $ G ⇒ ¬ (p ∧ q) $ by not_intro [l4]

lemma m4_ne_eq (G: hyps) (K A B: class): $ G ⇒ K = A $ > $ G ⇒ ¬ A = B $ > $ G ⇒ ¬ K = B $
----
l1: $ G , K = B ⇒ K = A $ by weaken [#1]
l2: $ G , K = B ⇒ A = K $ by eq_sym [l1]
l3: $ G , K = B ⇒ K = B $ by ax
l4: $ G , K = B ⇒ A = B $ by eq_trans [l2, l3]
l5: $ G , K = B ⇒ ¬ A = B $ by weaken [#2]
l6: $ G , K = B ⇒ ⊥ $ by not_elim [l5, l4]
l7: $ G ⇒ ¬ K = B $ by not_intro [l6]

lemma m4_nin_eq (G: hyps) (K A B: class): $ G ⇒ K = A $ > $ G ⇒ ¬ A ∈ B $ > $ G ⇒ ¬ K ∈ B $
----
l1: $ G , K ∈ B ⇒ K = A $ by weaken [#1]
l2: $ G , K ∈ B ⇒ K ∈ B $ by ax
l3: $ G , K ∈ B ⇒ A ∈ B $ by wcel_eq_l [l1, l2]
l4: $ G , K ∈ B ⇒ ¬ A ∈ B $ by weaken [#2]
l5: $ G , K ∈ B ⇒ ⊥ $ by not_elim [l4, l3]
l6: $ G ⇒ ¬ K ∈ B $ by not_intro [l5]

lemma m4_ne_in (G: hyps) (K L B: class): $ G ⇒ K ∈ B $ > $ G ⇒ ¬ L ∈ B $ > $ G ⇒ ¬ K = L $
----
l1: $ G , K = L ⇒ K = L $ by ax
l2: $ G , K = L ⇒ K ∈ B $ by weaken [#1]
l3: $ G , K = L ⇒ L ∈ B $ by wcel_eq_l [l1, l2]
l4: $ G , K = L ⇒ ¬ L ∈ B $ by weaken [#2]
l5: $ G , K = L ⇒ ⊥ $ by not_elim [l4, l3]
l6: $ G ⇒ ¬ K = L $ by not_intro [l5]

lemma m4_lt_app_cst (G: hyps): $ G ⇒ kc_app ∈ kc_cst $
----
l1: $ G ⇒ kc_app ∈ ω $ by kc_app_omega
l2: $ G ⇒ isset kc_app $ by wcel_isset [l1]
l3: $ G ⇒ kc_app ∈ kc_lam $ by suc_mem [l2]
l4: $ G ⇒ kc_app ∈ kc_pi $ by suc_mem_r [l3]
l5: $ G ⇒ kc_app ∈ kc_cst $ by suc_mem_r [l4]

lemma m4_lt_lam_cst (G: hyps): $ G ⇒ kc_lam ∈ kc_cst $
----
l1: $ G ⇒ kc_lam ∈ ω $ by kc_lam_omega
l2: $ G ⇒ isset kc_lam $ by wcel_isset [l1]
l3: $ G ⇒ kc_lam ∈ kc_pi $ by suc_mem [l2]
l4: $ G ⇒ kc_lam ∈ kc_cst $ by suc_mem_r [l3]

lemma m4_lt_pi_cst (G: hyps): $ G ⇒ kc_pi ∈ kc_cst $
----
l1: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
l2: $ G ⇒ isset kc_pi $ by wcel_isset [l1]
l3: $ G ⇒ kc_pi ∈ kc_cst $ by suc_mem [l2]

lemma m4_dnb_app {x0 x1: set} (G: hyps) (M K S V: class) (u: set): $ G ⇒ ¬ K = kc_bvar $ > $ G ⇒ ¬ K = kc_srt $ > $ G ⇒ K = kc_app $ > $ G ⇒ ¬ K = kc_lam $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_proj $ > $ G ⇒ ¬ K ∈ kexa $ > $ G ⇒ ¬ ¬ K ∈ kstr $ > $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) $
----
l1: $ G , z ∊ dnb u M K S V ⇒ z ∊ dnb u M K S V $ by ax
l2: $ G , z ∊ dnb u M K S V ⇒ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by cab_elim [l1]
l3: $ G ⇒ ¬ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) $ by m4_nand [#1]
l4: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) $ by weaken [l3]
l5: $ G ⇒ ¬ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) $ by m4_nand [#2]
l6: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) $ by weaken [l5]
l7: $ G ⇒ ¬ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) $ by m4_nand [#4]
l8: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) $ by weaken [l7]
l9: $ G ⇒ ¬ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) $ by m4_nand [#5]
l10: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) $ by weaken [l9]
l11: $ G ⇒ ¬ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) $ by m4_nand [#6]
l12: $ G , z ∊ dnb u M K S V ⇒ ¬ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) $ by weaken [l11]
l13: $ G ⇒ ¬ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) $ by m4_nand [#7]
l14: $ G , z ∊ dnb u M K S V ⇒ ¬ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) $ by weaken [l13]
l15: $ G ⇒ ¬ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by m4_nand [#8]
l16: $ G , z ∊ dnb u M K S V ⇒ ¬ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by weaken [l15]
l17: $ G , z ∊ dnb u M K S V ⇒ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by m4_ds_l [l4, l2]
l18: $ G , z ∊ dnb u M K S V ⇒ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by m4_ds_l [l6, l17]
l19: $ G , z ∊ dnb u M K S V ⇒ ¬ ((K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩))) $ by m4_nor [l14, l16]
l20: $ G , z ∊ dnb u M K S V ⇒ ¬ ((K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩))) $ by m4_nor [l12, l19]
l21: $ G , z ∊ dnb u M K S V ⇒ ¬ ((K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩))) $ by m4_nor [l10, l20]
l22: $ G , z ∊ dnb u M K S V ⇒ ¬ ((K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩))) $ by m4_nor [l8, l21]
l23: $ G , z ∊ dnb u M K S V ⇒ K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) $ by m4_ds_r [l22, l18]
l24: $ G , z ∊ dnb u M K S V ⇒ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) $ by and_elim_r [l23]
l25: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) ⇒ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) $ by ax
l26: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) ⇒ K = kc_app $ by weaken [#3]
l27: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) ⇒ K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) $ by and_intro [l26, l25]
l28: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) ⇒ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_l [l27]
l29: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) ⇒ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l28]
l30: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) ⇒ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_r [l29]
l31: $ G , z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) ⇒ z ∊ dnb u M K S V $ by cab_intro [l30]
l32: $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1))) $ by eq_intro [l24, l31]

lemma m4_dnb_lam {x0 x1 x2: set} (G: hyps) (M K S V: class) (u: set): $ G ⇒ ¬ K = kc_bvar $ > $ G ⇒ ¬ K = kc_srt $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ K = kc_lam $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_proj $ > $ G ⇒ ¬ K ∈ kexa $ > $ G ⇒ ¬ ¬ K ∈ kstr $ > $ G ⇒ dnb u M K S V = clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1)))) $
----
l1: $ G , z ∊ dnb u M K S V ⇒ z ∊ dnb u M K S V $ by ax
l2: $ G , z ∊ dnb u M K S V ⇒ (K = kc_bvar ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv x1 (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv uni (lv (fv S ∅) x0)))) ∨ (K = kc_app ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (ap (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 x1)))) ∨ (K = kc_lam ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (clam x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_pi ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (cpi x2 (da (fv V ∅) x0 x1) (da (fv V (suc ∅)) x0 (scons x2 x1))))) ∨ (K = kc_proj ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (fv (da (fv V (suc (suc ∅))) x0 x1) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam x0 lvals (clam x1 (fseq u) (mclip u (ap (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) x0)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ u , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by cab_elim [l1]
