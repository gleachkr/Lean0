l6: $ H ⇒ ∀ x2 (x2 ∊ sat u M (enc_ctx G) w → (dt u M (enc_expr e) w x2 = dt u M (enc_expr e2) w x2 ∧ dt u M (enc_expr e) w x2 ∈ dt u M (enc_expr A) w x2)) $ by imp_elim [l5, #3]
l7: $ H ⇒ r ∊ sat u M (enc_ctx G) w → (dt u M (enc_expr e) w r = dt u M (enc_expr e2) w r ∧ dt u M (enc_expr e) w r ∈ dt u M (enc_expr A) w r) $ by all_elim [l6]
