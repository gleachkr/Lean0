c12: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w , x ∊ dt x0 M (enc_expr A) w r ⇒ enc_ctx G ∈ trees ω $ by weaken [tG]
c13: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w , x ∊ dt x0 M (enc_expr A) w r ⇒ scons x r ∈ sat x0 M (enc_ctx (cons A G)) w $ by sat_cons_intro [c11, c12, c3, c4, c1, c10]
c14: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w , x ∊ dt x0 M (enc_expr A) w r ⇒ dt x0 M (enc_expr b) w (scons x r) = dt x0 M (enc_expr b2) w (scons x r) $ by mdeq_e_c [#2, c2, c3, c13]
c15: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ x ∊ dt x0 M (enc_expr A) w r → dt x0 M (enc_expr b) w (scons x r) = dt x0 M (enc_expr b2) w (scons x r) $ by imp_intro [c14]
c16: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ ∀ x (x ∊ dt x0 M (enc_expr A) w r → dt x0 M (enc_expr b) w (scons x r) = dt x0 M (enc_expr b2) w (scons x r)) $ by all_intro [c15]
c17: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ clam x (dt x0 M (enc_expr A) w r) (dt x0 M (enc_expr b) w (scons x r)) = clam x (dt x0 M (enc_expr A2) w r) (dt x0 M (enc_expr b2) w (scons x r)) $ by clam_eq_pt [e1, c16]
c18: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ clam x (dt x0 M (enc_expr A2) w r) (dt x0 M (enc_expr b2) w (scons x r)) = dt x0 M ⟨ kc_lam , scons (enc_expr A2) (scons (enc_expr b2) ∅) ⟩ w r $ by eq_sym [d2]
c19: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ clam x (dt x0 M (enc_expr A) w r) (dt x0 M (enc_expr b) w (scons x r)) = dt x0 M ⟨ kc_lam , scons (enc_expr A2) (scons (enc_expr b2) ∅) ⟩ w r $ by eq_trans [c17, c18]
c20: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ dt x0 M ⟨ kc_lam , scons (enc_expr A) (scons (enc_expr b) ∅) ⟩ w r = dt x0 M ⟨ kc_lam , scons (enc_expr A2) (scons (enc_expr b2) ∅) ⟩ w r $ by eq_trans [d1, c19]
m1: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w , x ∊ dt x0 M (enc_expr A) w r ⇒ dt x0 M (enc_expr b) w (scons x r) ∈ dt x0 M (enc_expr B) w (scons x r) $ by mdeq_mem_c [#2, c2, c3, c13]
m2: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ x ∊ dt x0 M (enc_expr A) w r → dt x0 M (enc_expr b) w (scons x r) ∈ dt x0 M (enc_expr B) w (scons x r) $ by imp_intro [m1]
m3: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ ∀ x (x ∊ dt x0 M (enc_expr A) w r → dt x0 M (enc_expr b) w (scons x r) ∈ dt x0 M (enc_expr B) w (scons x r)) $ by all_intro [m2]
m4: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ isset (dt x0 M ⟨ kc_lam , scons (enc_expr A) (scons (enc_expr b) ∅) ⟩ w r) $ by dt_set
m5: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ isset (clam x (dt x0 M (enc_expr A) w r) (dt x0 M (enc_expr b) w (scons x r))) $ by isset_eq [d1, m4]
m6: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ clam x (dt x0 M (enc_expr A) w r) (dt x0 M (enc_expr b) w (scons x r)) ∈ cpi x (dt x0 M (enc_expr A) w r) (dt x0 M (enc_expr B) w (scons x r)) $ by clam_cpi_intro [m5, m3]
m7: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ clam x (dt x0 M (enc_expr A) w r) (dt x0 M (enc_expr b) w (scons x r)) = dt x0 M ⟨ kc_lam , scons (enc_expr A) (scons (enc_expr b) ∅) ⟩ w r $ by eq_sym [d1]
m8: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ cpi x (dt x0 M (enc_expr A) w r) (dt x0 M (enc_expr B) w (scons x r)) = dt x0 M ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ w r $ by eq_sym [d3]
m9: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ dt x0 M ⟨ kc_lam , scons (enc_expr A) (scons (enc_expr b) ∅) ⟩ w r ∈ cpi x (dt x0 M (enc_expr A) w r) (dt x0 M (enc_expr B) w (scons x r)) $ by wcel_eq_l [m7, m6]
m10: $ uadm x0 , w ∊ lvals , r ∊ sat x0 M (enc_ctx G) w ⇒ dt x0 M ⟨ kc_lam , scons (enc_expr A) (scons (enc_expr b) ∅) ⟩ w r ∈ dt x0 M ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ w r $ by wcel_eq_r [m8, m9]
m11: $ mdeq M G (lam A b) (lam A2 b2) (pi A B) $ by mdeq_i [c20, m10]

lemma m7_dt_srt_c (H: hyps) (M T: class) (u w: set) (R: class):
  $ H ⇒ T ∈ trees ω $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ R ∈ fseq u $ >
  $ H ⇒ dt u M ⟨ kc_srt , scons T ∅ ⟩ w R = fv uni (lv T w) $
-------------------
l1: $ H , v = R , v ∊ fseq u ⇒ T ∈ trees ω $ by weaken [#1]
l2: $ H , v = R , v ∊ fseq u ⇒ w ∊ lvals $ by weaken [#2]
l3: $ H , v = R , v ∊ fseq u ⇒ v ∊ fseq u $ by ax
l4: $ H , v = R , v ∊ fseq u ⇒ dt u M ⟨ kc_srt , scons T ∅ ⟩ w v = fv uni (lv T w) $ by dt_srt [l1, l2, l3]
l5: $ H , v = R , v ∊ fseq u ⇒ v = R $ by ax
e1: $ H , v = R , v ∊ fseq u ⇒ u = u $ by eq_refl
e2: $ H , v = R , v ∊ fseq u ⇒ M = M $ by eq_refl
e3: $ H , v = R , v ∊ fseq u ⇒ w = w $ by eq_refl
e4: $ H , v = R , v ∊ fseq u ⇒ ⟨ kc_srt , scons T ∅ ⟩ = ⟨ kc_srt , scons T ∅ ⟩ $ by eq_refl
l6: $ H , v = R , v ∊ fseq u ⇒ dt u M ⟨ kc_srt , scons T ∅ ⟩ w v = dt u M ⟨ kc_srt , scons T ∅ ⟩ w R $ by dt_eq [e1, e2, e4, e3, l5]
l7: $ H , v = R , v ∊ fseq u ⇒ dt u M ⟨ kc_srt , scons T ∅ ⟩ w R = dt u M ⟨ kc_srt , scons T ∅ ⟩ w v $ by eq_sym [l6]
l8: $ H , v = R , v ∊ fseq u ⇒ dt u M ⟨ kc_srt , scons T ∅ ⟩ w R = fv uni (lv T w) $ by eq_trans [l7, l4]
l9: $ H ⇒ dt u M ⟨ kc_srt , scons T ∅ ⟩ w R = fv uni (lv T w) $ by wcel_elim [#3, l8]

