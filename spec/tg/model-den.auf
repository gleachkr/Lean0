-- Proofs for model-den.mm0.

uadm_congr
----------
l1: $ universe A ⟺ universe B $ by universe_congr [#1]
l2: $ (n ∊ ω) ⟺ (n ∊ ω) $ by iff_refl
l3: $ fv uni n ≐ fv uni n $ by ceqt_refl
l4: $ (fv uni n ∈ A) ⟺ (fv uni n ∈ B) $ by wcel_congr [l3, #1]
l5: $ (n ∊ ω → fv uni n ∈ A) ⟺ (n ∊ ω → fv uni n ∈ B) $ by im_congr [l2, l4]
l6: $ ∀ n (n ∊ ω → fv uni n ∈ A) ⟺ ∀ n (n ∊ ω → fv uni n ∈ B) $ by all_congr [l5]
l7: $ (universe A ∧ ∀ n (n ∊ ω → fv uni n ∈ A)) ⟺ (universe B ∧ ∀ n (n ∊ ω → fv uni n ∈ B)) $ by and_congr [l1, l6]

sb_f_uadm
---------
l1: $ [x/t] (universe A ∧ ∀ n (n ∊ ω → fv uni n ∈ A)) ⟺ (universe (⟦ x / t ⟧ A) ∧ ∀ n (n ∊ ω → fv uni n ∈ (⟦ x / t ⟧ A))) $ by iff_refl

uadm_intro
----------
l1: $ G ⇒ universe U ∧ ∀ n (n ∊ ω → fv uni n ∈ U) $ by and_intro [#1, #2]

uadm_universe
-------------
l1: $ G ⇒ universe U $ by and_elim_l [#1]

uadm_uni
--------
l2: $ G ⇒ ∀ m (m ∊ ω → fv uni m ∈ U) $ by and_elim_r [#1]
l3: $ G ⇒ n ∊ ω → fv uni n ∈ U $ by all_elim [l2]
l4: $ G ⇒ fv uni n ∈ U $ by imp_elim [l3, #2]

uadm_uni_c
----------
l1: $ G , y = A , y ∊ ω ⇒ uadm U $ by weaken [#1]
l2: $ G , y = A , y ∊ ω ⇒ y ∊ ω $ by ax
l3: $ G , y = A , y ∊ ω ⇒ fv uni y ∈ U $ by uadm_uni [l1, l2]
l4: $ G , y = A , y ∊ ω ⇒ y = A $ by ax
l5: $ G , y = A , y ∊ ω ⇒ uni = uni $ by eq_refl
l6: $ G , y = A , y ∊ ω ⇒ fv uni y = fv uni A $ by fv_eq [l5, l4]
l7: $ G , y = A , y ∊ ω ⇒ fv uni A ∈ U $ by wcel_eq_l [l6, l3]
l8: $ G ⇒ fv uni A ∈ U $ by wcel_elim [#2, l7]

uadm_omega
----------
l1: $ G ⇒ universe U $ by uadm_universe [#1]
l2: $ G ⇒ isset ∅ $ by ax_empty
l3: $ G , z = ∅ ⇒ z = ∅ $ by ax
l4: $ G , z = ∅ ⇒ ∅ = z $ by eq_sym [l3]
l5: $ G , z = ∅ ⇒ ∅ ∈ ω $ by omega_zero
l6: $ G , z = ∅ ⇒ z ∈ ω $ by wcel_eq_l [l4, l5]
l7: $ G , z = ∅ ⇒ z ∊ ω $ by wcel_welc [l6]
l8: $ G , z = ∅ ⇒ suc z ∈ ω $ by omega_suc [l7]
l9: $ G , z = ∅ ⇒ uadm U $ by weaken [#1]
l10: $ G , z = ∅ ⇒ fv uni (suc z) ∈ U $ by uadm_uni_c [l9, l8]
l11: $ G , z = ∅ ⇒ ω ∈ fv uni (suc z) $ by uni_omega [l7]
l12: $ G , z = ∅ ⇒ universe U $ by weaken [l1]
l13: $ G , z = ∅ ⇒ ω ∈ U $ by universe_elem_elem_c [l12, l10, l11]
l14: $ G ⇒ ω ∈ U $ by isset_elim [l2, l13]

uadm_empty
----------
l1: $ G ⇒ universe U $ by uadm_universe [#1]
l2: $ G ⇒ ω ∈ U $ by uadm_omega [#1]
l3: $ G ⇒ ∅ ⊆ ω $ by empty_subset
l4: $ G ⇒ ∅ ∈ U $ by universe_subset_c [l1, l2, l3]

uadm_eq
-------
l1: $ G ⇒ universe A $ by uadm_universe [#2]
l2: $ G ⇒ universe B $ by universe_eq [#1, l1]
l3: $ G , n ∊ ω ⇒ uadm A $ by weaken [#2]
l4: $ G , n ∊ ω ⇒ n ∊ ω $ by ax
