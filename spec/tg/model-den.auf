n17: $ G , a = kc_srt , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ r = r $ by eq_refl
n18: $ G , a = kc_srt , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (ap (fv (dnf u M) ⟨ kc_srt , scons T ∅ ⟩) w) r = ap (clam j (fseq u) (fv uni (lv (fv b ∅) w))) r $ by ap_eq [n16, n17]
