l11: $ G , a = A , a ∊ two , b = B , b ∊ a , c = C , c ∊ a ⇒ b = B $ by ax
l12: $ G , a = A , a ∊ two , b = B , b ∊ a , c = C , c ∊ a ⇒ c = C $ by ax
l13: $ G , a = A , a ∊ two , b = B , b ∊ a , c = C , c ∊ a ⇒ B = b $ by eq_sym [l11]
l14: $ G , a = A , a ∊ two , b = B , b ∊ a , c = C , c ∊ a ⇒ B = c $ by eq_trans [l13, l10]
l15: $ G , a = A , a ∊ two , b = B , b ∊ a , c = C , c ∊ a ⇒ B = C $ by eq_trans [l14, l12]
l16: $ G , a = A , a ∊ two , b = B , b ∊ a ⇒ B = C $ by wcel_elim [l6, l15]
l17: $ G , a = A , a ∊ two ⇒ B = C $ by wcel_elim [l5, l16]
l18: $ G ⇒ B = C $ by wcel_elim [#1, l17]

lemma m1_clam_sub {x u: set} (G: hyps x) (A: class) (B D: class x) (c: set):
  $ G , u ∊ A ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ > $ G ⇒ c ∊ clam x A B $ > $ G ⇒ c ∊ clam x A D $
----
l1: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by weaken [#1]
l2: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ B) $ by ax
l3: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ v ∊ (⟦ x / u ⟧ D) $ by welc_eq [l1, l2]
l4: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ u ∊ A $ by ax
l5: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ ⟨ u , v ⟩ ∈ clam x A D $ by clam_intro [l4, l3]
l6: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ c = ⟨ u , v ⟩ $ by ax
l7: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ ⟨ u , v ⟩ = c $ by eq_sym [l6]
l8: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ c ∈ clam x A D $ by wcel_eq_l [l7, l5]
l9: $ G , c = ⟨ u , v ⟩ , u ∊ A , v ∊ (⟦ x / u ⟧ B) ⇒ c ∊ clam x A D $ by wcel_welc [l8]
l10: $ G ⇒ c ∊ clam x A D $ by clam_elim_mem [#2, l9]

clam_eq_pt
----------
l1: $ G ⇒ u ∊ A → (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by all_elim [#2]
l2: $ G , u ∊ A ⇒ u ∊ A → (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by weaken [l1]
l3: $ G , u ∊ A ⇒ u ∊ A $ by ax
l4: $ G , u ∊ A ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by imp_elim [l2, l3]
l5: $ G , u ∊ A ⇒ (⟦ x / u ⟧ D) = (⟦ x / u ⟧ B) $ by eq_sym [l4]
l6: $ G , z ∊ clam x A B , u ∊ A ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by weaken [l4]
l7: $ G , z ∊ clam x A B ⇒ z ∊ clam x A B $ by ax
l8: $ G , z ∊ clam x A B ⇒ z ∊ clam x A D $ by m1_clam_sub [l6, l7]
l9: $ G , z ∊ clam x A D , u ∊ A ⇒ (⟦ x / u ⟧ D) = (⟦ x / u ⟧ B) $ by weaken [l5]
l10: $ G , z ∊ clam x A D ⇒ z ∊ clam x A D $ by ax
l11: $ G , z ∊ clam x A D ⇒ z ∊ clam x A B $ by m1_clam_sub [l9, l10]
l12: $ G ⇒ clam x A B = clam x A D $ by eq_intro [l8, l11]
l13: $ G ⇒ clam x A D = clam x C D $ by clam_eq_dom [#1]
l14: $ G ⇒ clam x A B = clam x C D $ by eq_trans [l12, l13]

lemma m1_cpi_sub {x u: set} (G: hyps x) (A C: class) (B D: class x) (f: set):
  $ G ⇒ A = C $ > $ G , u ∊ C ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ > $ G ⇒ f ∊ cpi x A B $ > $ G ⇒ f ∊ cpi x C D $
----
l1: $ G , u ∊ C ⇒ u ∊ C $ by ax
l2: $ G , u ∊ C ⇒ A = C $ by weaken [#1]
l3: $ G , u ∊ C ⇒ C = A $ by eq_sym [l2]
l4: $ G , u ∊ C ⇒ u ∊ A $ by welc_eq [l3, l1]
l5: $ G , u ∊ C ⇒ f ∊ cpi x A B $ by weaken [#3]
l6: $ G , u ∊ C ⇒ ap f u ∈ (⟦ x / u ⟧ B) $ by cpi_elim_ap [l5, l4]
l7: $ G , u ∊ C ⇒ ap f u ∈ (⟦ x / u ⟧ D) $ by wcel_eq_r [#2, l6]
l8: $ G ⇒ u ∊ C → ap f u ∈ (⟦ x / u ⟧ D) $ by imp_intro [l7]
l9: $ G ⇒ ∀ u (u ∊ C → ap f u ∈ (⟦ x / u ⟧ D)) $ by all_intro [l8]
l10: $ ∀ x (x ∊ C → ap f x ∈ D) ⟺ ∀ u (u ∊ C → ap f u ∈ (⟦ x / u ⟧ D)) $ by all_alpha
l11: $ G ⇒ ∀ x (x ∊ C → ap f x ∈ D) ↔ ∀ u (u ∊ C → ap f u ∈ (⟦ x / u ⟧ D)) $ by weaken [l10]
l12: $ G ⇒ ∀ x (x ∊ C → ap f x ∈ D) $ by bi_elim_r [l11, l9]
l13: $ G ⇒ f ⊆ clam x A (⋃ B) $ by cpi_elim_sub [#3]
l14: $ G , u ∊ C ⇒ ⋃ (⟦ x / u ⟧ B) = ⋃ (⟦ x / u ⟧ D) $ by cuni_eq [#2]
l15: $ G , c ∊ f , u ∊ A ⇒ u ∊ A $ by ax
l16: $ G , c ∊ f , u ∊ A ⇒ A = C $ by weaken [#1]
l17: $ G , c ∊ f , u ∊ A ⇒ u ∊ C $ by welc_eq [l16, l15]
l18: $ G , c ∊ f , u ∊ A , u ∊ C ⇒ ⋃ (⟦ x / u ⟧ B) = ⋃ (⟦ x / u ⟧ D) $ by weaken [l14]
l19: $ G , c ∊ f , u ∊ A ⇒ u ∊ C → ⋃ (⟦ x / u ⟧ B) = ⋃ (⟦ x / u ⟧ D) $ by imp_intro [l18]
l20: $ G , c ∊ f , u ∊ A ⇒ (⟦ x / u ⟧ (⋃ B)) = (⟦ x / u ⟧ (⋃ D)) $ by imp_elim [l19, l17]
l21: $ G , c ∊ f ⇒ f ⊆ clam x A (⋃ B) $ by weaken [l13]
l22: $ G , c ∊ f ⇒ c ∊ f $ by ax
l23: $ G , c ∊ f ⇒ c ∊ clam x A (⋃ B) $ by subset_elim [l21, l22]
l24: $ G , c ∊ f ⇒ c ∊ clam x A (⋃ D) $ by m1_clam_sub [l20, l23]
l25: $ G ⇒ f ⊆ clam x A (⋃ D) $ by subset_intro [l24]
l26: $ G ⇒ clam x A (⋃ D) = clam x C (⋃ D) $ by clam_eq_dom [#1]
l27: $ G ⇒ f ⊆ clam x C (⋃ D) $ by subset_eq_r [l26, l25]
l28: $ G ⇒ f ∊ cpi x C D $ by cpi_intro [l27, l12]

cpi_eq_pt
---------
l1: $ G ⇒ u ∊ A → (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by all_elim [#2]
l2: $ G , u ∊ A ⇒ u ∊ A → (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by weaken [l1]
l3: $ G , u ∊ A ⇒ u ∊ A $ by ax
l4: $ G , u ∊ A ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by imp_elim [l2, l3]
l5: $ G , u ∊ C ⇒ u ∊ C $ by ax
l6: $ G , u ∊ C ⇒ A = C $ by weaken [#1]
l7: $ G , u ∊ C ⇒ C = A $ by eq_sym [l6]
l8: $ G , u ∊ C ⇒ u ∊ A $ by welc_eq [l7, l5]
l9: $ G , u ∊ C , u ∊ A ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by weaken [l4]
l10: $ G , u ∊ C ⇒ u ∊ A → (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by imp_intro [l9]
l11: $ G , u ∊ C ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by imp_elim [l10, l8]
l12: $ G ⇒ C = A $ by eq_sym [#1]
l13: $ G , u ∊ A ⇒ (⟦ x / u ⟧ D) = (⟦ x / u ⟧ B) $ by eq_sym [l4]
l14: $ G , f ∊ cpi x A B , u ∊ C ⇒ (⟦ x / u ⟧ B) = (⟦ x / u ⟧ D) $ by weaken [l11]
l15: $ G , f ∊ cpi x A B ⇒ A = C $ by weaken [#1]
l16: $ G , f ∊ cpi x A B ⇒ f ∊ cpi x A B $ by ax
l17: $ G , f ∊ cpi x A B ⇒ f ∊ cpi x C D $ by m1_cpi_sub [l15, l14, l16]
l18: $ G , f ∊ cpi x C D , u ∊ A ⇒ (⟦ x / u ⟧ D) = (⟦ x / u ⟧ B) $ by weaken [l13]
l19: $ G , f ∊ cpi x C D ⇒ C = A $ by weaken [l12]
l20: $ G , f ∊ cpi x C D ⇒ f ∊ cpi x C D $ by ax
l21: $ G , f ∊ cpi x C D ⇒ f ∊ cpi x A B $ by m1_cpi_sub [l19, l18, l20]
l22: $ G ⇒ cpi x A B = cpi x C D $ by eq_intro [l17, l21]

