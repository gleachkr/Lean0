g1: $ G , z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) ⇒ K = kc_bvar $ by weaken [#1]
g2: $ G , z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) ⇒ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) $ by ax
g3: $ G , z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) ⇒ K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) $ by and_intro [g1, g2]
g4: $ G , z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) ⇒ (K = kc_bvar ∧ z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅))))) ∨ (K = kc_srt ∧ z ∊ clam w lvals (clam r (fseq U) (fv uni (lv (fv S ∅) w)))) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq U) (ap (da (fv V ∅) w r) (da (fv V (suc ∅)) w r)))) ∨ (K = kc_lam ∧ z ∊ clam w lvals (clam r (fseq U) (clam x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq U) (cpi x (da (fv V ∅) w r) (da (fv V (suc ∅)) w (scons x r))))) ∨ (K = kc_proj ∧ z ∊ clam w lvals (clam r (fseq U) (fv (da (fv V (suc (suc ∅))) w r) (suc (fv nvf (fv S (suc ∅))))))) ∨ (K ∈ kexa ∧ z ∊ clam w lvals (clam r (fseq U) (mclip U (ap (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩) w)))) ∨ (¬ K ∈ kstr ∧ z ∊ sclip (fv M ⟨ U , ⟨ K , ⟨ S , V ⟩ ⟩ ⟩)) $ by or_intro_l [g3]
g5: $ G , z ∊ clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) ⇒ z ∊ dnb U M K S V $ by cab_intro [g4]
g6: $ G ⇒ dnb U M K S V = clam w lvals (clam r (fseq U) (fv r (fv nvf (fv S ∅)))) $ by eq_intro [d3, g5]

dt_bvar
-------
l1: $ G ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
l2e: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons T ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2e]
n1: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ a ∊ ω $ by ax
n2: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ b ∊ fseq (trees ω) $ by ax
n3: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ a , b ⟩ = dnb u M a b (ccom (dnf u M) b) $ by dnf_node [n1, n2]
n4: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ a = kc_bvar $ by ax
n5: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ dnb u M a b (ccom (dnf u M) b) = clam i lvals (clam j (fseq u) (fv j (fv nvf (fv b ∅)))) $ by m3_dnb_bvar [n4]
n6: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ b = scons T ∅ $ by ax
n7: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ⟨ a , b ⟩ = ⟨ kc_bvar , scons T ∅ ⟩ $ by opair_eq [n4, n6]
n8: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ dnf u M = dnf u M $ by eq_refl
n9: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ a , b ⟩ = fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩ $ by fv_eq [n8, n7]
n10: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩ = fv (dnf u M) ⟨ a , b ⟩ $ by eq_sym [n9]
n11: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩ = dnb u M a b (ccom (dnf u M) b) $ by eq_trans [n10, n3]
n12: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩ = clam i lvals (clam j (fseq u) (fv j (fv nvf (fv b ∅)))) $ by eq_trans [n11, n5]
n13: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ w ∊ lvals $ by weaken [#2]
n14: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (clam i lvals (clam j (fseq u) (fv j (fv nvf (fv b ∅))))) w = clam j (fseq u) (fv j (fv nvf (fv b ∅))) $ by clam_ap [n13]
n15a: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ w = w $ by eq_refl
n15: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩) w = ap (clam i lvals (clam j (fseq u) (fv j (fv nvf (fv b ∅))))) w $ by ap_eq [n12, n15a]
n16: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩) w = clam j (fseq u) (fv j (fv nvf (fv b ∅))) $ by eq_trans [n15, n14]
n17: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ r = r $ by eq_refl
n18: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (ap (fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩) w) r = ap (clam j (fseq u) (fv j (fv nvf (fv b ∅)))) r $ by ap_eq [n16, n17]
n19: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ r ∊ fseq u $ by weaken [#3]
n20: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (clam j (fseq u) (fv j (fv nvf (fv b ∅)))) r = fv r (fv nvf (fv b ∅)) $ by clam_ap [n19]
n21: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (ap (fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩) w) r = fv r (fv nvf (fv b ∅)) $ by eq_trans [n18, n20]
n22a: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ∅ = ∅ $ by eq_refl
n22: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv b ∅ = fv (scons T ∅) ∅ $ by fv_eq [n6, n22a]
n23a: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ T ∈ trees ω $ by weaken [#1]
n23: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ isset T $ by wcel_isset [n23a]
n24e: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ isset ∅ $ by ax_empty
n24: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv (scons T ∅) ∅ = T $ by scons_fv_zero_c [n23, n24e]
n25: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv b ∅ = T $ by eq_trans [n22, n24]
n26: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ nvf = nvf $ by eq_refl
n27: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv nvf (fv b ∅) = fv nvf T $ by fv_eq [n26, n25]
n29: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ fv r (fv nvf (fv b ∅)) = fv r (fv nvf T) $ by fv_eq [n17, n27]
n30: $ G , a = kc_bvar , a ∊ ω , b = scons T ∅ , b ∊ fseq (trees ω) ⇒ ap (ap (fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩) w) r = fv r (fv nvf T) $ by eq_trans [n21, n29]
n31: $ G , a = kc_bvar , a ∊ ω ⇒ ap (ap (fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩) w) r = fv r (fv nvf T) $ by wcel_elim [l2, n30]
n32: $ G ⇒ ap (ap (fv (dnf u M) ⟨ kc_bvar , scons T ∅ ⟩) w) r = fv r (fv nvf T) $ by wcel_elim [l1, n31]

--| `dnb` at the label `kc_srt`.
lemma m3_dnb_srt (G: hyps) {w r: set} (U M K S V: class): $ G ⇒ K = kc_srt $ > $ G ⇒ dnb U M K S V = clam w lvals (clam r (fseq U) (fv uni (lv (fv S ∅) w))) $
----
