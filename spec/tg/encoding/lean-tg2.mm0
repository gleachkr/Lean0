--| @rewrite
theorem sb_c_ra_nst_group {x: set} (t: set x) (A1 A2 A3 A4 A5 A6 A7 A8 A9: class x): $ ([[ x / t ]] (ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9)) ≐ ra_nst_group ([[ x / t ]] A1) ([[ x / t ]] A2) ([[ x / t ]] A3) ([[ x / t ]] A4) ([[ x / t ]] A5) ([[ x / t ]] A6) ([[ x / t ]] A7) ([[ x / t ]] A8) ([[ x / t ]] A9) $;

-- --------------------------------------------------------------------------
-- The program
-- --------------------------------------------------------------------------

--| The ground instances of each clause axiom: ⟨ premises , conclusion ⟩, with
--| its side conditions.
def cl_ulevel_prop (.l .u .w: set): class =
  $ {w | ∃ l ∃ u (w = ⟨ ∅ , ra_ulevel l u ⟩ ∧ lveq l ⟨ kc_lz , ∅ ⟩)} $;
def cl_ulevel_le (.l .u .w: set): class =
  $ {w | ∃ l ∃ u (w = ⟨ ∅ , ra_ulevel l u ⟩ ∧ lveq ⟨ kc_lmax , l +: u +: ∅ ⟩ l)} $;
def cl_eeqv_refl (.e .w: set): class =
  $ {w | ∃ e (w = ⟨ ∅ , ra_eeqv e e ⟩)} $;
def cl_eeqv_bvar (.i .w: set): class =
  $ {w | ∃ i (w = ⟨ ∅ , ra_eeqv ⟨ kc_bvar , i +: ∅ ⟩ ⟨ kc_bvar , i +: ∅ ⟩ ⟩)} $;
def cl_eeqv_srt (.l .l2 .w: set): class =
  $ {w | ∃ l ∃ l2 (w = ⟨ ∅ , ra_eeqv ⟨ kc_srt , l +: ∅ ⟩ ⟨ kc_srt , l2 +: ∅ ⟩ ⟩ ∧ lveq l l2)} $;
def cl_eeqv_app (.f .a .f2 .a2 .w: set): class =
  $ {w | ∃ f ∃ a ∃ f2 ∃ a2 (w = ⟨ ra_eeqv f f2 +: ra_eeqv a a2 +: ∅ , ra_eeqv ⟨ kc_app , f +: a +: ∅ ⟩ ⟨ kc_app , f2 +: a2 +: ∅ ⟩ ⟩)} $;
def cl_eeqv_lam (.A .b .A2 .b2 .w: set): class =
  $ {w | ∃ A ∃ b ∃ A2 ∃ b2 (w = ⟨ ra_eeqv A A2 +: ra_eeqv b b2 +: ∅ , ra_eeqv ⟨ kc_lam , A +: b +: ∅ ⟩ ⟨ kc_lam , A2 +: b2 +: ∅ ⟩ ⟩)} $;
def cl_eeqv_pi (.A .b .A2 .b2 .w: set): class =
  $ {w | ∃ A ∃ b ∃ A2 ∃ b2 (w = ⟨ ra_eeqv A A2 +: ra_eeqv b b2 +: ∅ , ra_eeqv ⟨ kc_pi , A +: b +: ∅ ⟩ ⟨ kc_pi , A2 +: b2 +: ∅ ⟩ ⟩)} $;
def cl_eeqv_lit (.n .w: set): class =
  $ {w | ∃ n (w = ⟨ ∅ , ra_eeqv ⟨ kc_lit , n +: ∅ ⟩ ⟨ kc_lit , n +: ∅ ⟩ ⟩)} $;
def cl_eeqv_cst (.a .S .S2 .w: set): class =
  $ {w | ∃ a ∃ S ∃ S2 (w = ⟨ ra_lseqv S S2 +: ∅ , ra_eeqv ⟨ kc_cst , a +: S +: ∅ ⟩ ⟨ kc_cst , a +: S2 +: ∅ ⟩ ⟩)} $;
def cl_eeqv_ind_ty (.D .D2 .i .w: set): class =
  $ {w | ∃ D ∃ D2 ∃ i (w = ⟨ ra_ind_eqv D D2 +: ∅ , ra_eeqv ⟨ kc_ind_ty , D +: i +: ∅ ⟩ ⟨ kc_ind_ty , D2 +: i +: ∅ ⟩ ⟩)} $;
def cl_eeqv_ind_ctor (.D .D2 .i .c .w: set): class =
  $ {w | ∃ D ∃ D2 ∃ i ∃ c (w = ⟨ ra_ind_eqv D D2 +: ∅ , ra_eeqv ⟨ kc_ind_ctor , D +: i +: c +: ∅ ⟩ ⟨ kc_ind_ctor , D2 +: i +: c +: ∅ ⟩ ⟩)} $;
def cl_eeqv_ind_rec (.D .D2 .i .v .v2 .w: set): class =
  $ {w | ∃ D ∃ D2 ∃ i ∃ v ∃ v2 (w = ⟨ ra_ind_eqv D D2 +: ∅ , ra_eeqv ⟨ kc_ind_rec , D +: i +: v +: ∅ ⟩ ⟨ kc_ind_rec , D2 +: i +: v2 +: ∅ ⟩ ⟩ ∧ lveq v v2)} $;
def cl_eeqv_proj (.b .i .e .e2 .w: set): class =
  $ {w | ∃ b ∃ i ∃ e ∃ e2 (w = ⟨ ra_eeqv e e2 +: ∅ , ra_eeqv ⟨ kc_proj , b +: i +: e +: ∅ ⟩ ⟨ kc_proj , b +: i +: e2 +: ∅ ⟩ ⟩)} $;
def cl_ind_eqv_i (.D .D2 .b .P .P2 .N .N2 .T .T2 .w: set): class =
  $ {w | ∃ D ∃ D2 ∃ b ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (w = ⟨ ra_ceqv P P2 +: ra_teqv T T2 +: ra_ceqv N N2 +: ∅ , ra_ind_eqv D D2 ⟩ ∧ ra_ind_data D b P T ∈ lrel ∧ ra_ind_data D2 b P2 T2 ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel)} $;
def cl_ceqv_nil (.w: set): class =
  $ {w | (w = ⟨ ∅ , ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩)} $;
def cl_ceqv_cons (.A .A2 .G .G2 .w: set): class =
  $ {w | ∃ A ∃ A2 ∃ G ∃ G2 (w = ⟨ ra_eeqv A A2 +: ra_ceqv G G2 +: ∅ , ra_ceqv ⟨ kc_cons , A +: G +: ∅ ⟩ ⟨ kc_cons , A2 +: G2 +: ∅ ⟩ ⟩)} $;
def cl_teqv_nil (.w: set): class =
  $ {w | (w = ⟨ ∅ , ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ ⟩)} $;
def cl_teqv_cons (.F .F2 .C .C2 .T .T2 .w: set): class =
  $ {w | ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (w = ⟨ ra_eeqv F F2 +: ra_cseqv C C2 +: ra_teqv T T2 +: ∅ , ra_teqv ⟨ kc_tcons , F +: C +: T +: ∅ ⟩ ⟨ kc_tcons , F2 +: C2 +: T2 +: ∅ ⟩ ⟩)} $;
def cl_cseqv_nil (.w: set): class =
  $ {w | (w = ⟨ ∅ , ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩)} $;
def cl_cseqv_cons (.K .K2 .C .C2 .w: set): class =
  $ {w | ∃ K ∃ K2 ∃ C ∃ C2 (w = ⟨ ra_eeqv K K2 +: ra_cseqv C C2 +: ∅ , ra_cseqv ⟨ kc_ccons , K +: C +: ∅ ⟩ ⟨ kc_ccons , K2 +: C2 +: ∅ ⟩ ⟩)} $;
def cl_lseqv_nil (.w: set): class =
  $ {w | (w = ⟨ ∅ , ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ⟩)} $;
def cl_lseqv_cons (.l .l2 .S .S2 .w: set): class =
  $ {w | ∃ l ∃ l2 ∃ S ∃ S2 (w = ⟨ ra_lseqv S S2 +: ∅ , ra_lseqv ⟨ kc_lcons , l +: S +: ∅ ⟩ ⟨ kc_lcons , l2 +: S2 +: ∅ ⟩ ⟩ ∧ lveq l l2)} $;
def cl_nst_group_done (.G .D .I .X0 .j .ni .N .w: set): class =
  $ {w | ∃ G ∃ D ∃ I ∃ X0 ∃ j ∃ ni ∃ N (w = ⟨ ∅ , ra_nst_group G D I X0 j ni ni N N ⟩)} $;
def cl_nst_group_cons (.G .D .I .X0 .X .j .i .ni .npi .N .N2 .w: set): class =
  $ {w | ∃ G ∃ D ∃ I ∃ X0 ∃ X ∃ j ∃ i ∃ ni ∃ npi ∃ N ∃ N2 (w = ⟨ (ra_nst_group G D I X0 ⟨ kc_s , j +: ∅ ⟩ ⟨ kc_s , i +: ∅ ⟩ ni N N2) +: ∅ , ra_nst_group G D I X0 j i ni ⟨ kc_cons , X +: N +: ∅ ⟩ N2 ⟩ ∧ ra_le ⟨ kc_s , i +: ∅ ⟩ ni ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , I +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ X0 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , I +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_ind_ty , I +: i +: ∅ ⟩ npi X0 X ∈ lrel ∧ ra_aux_data D I X j i ∈ lrel)} $;

--| The clauses of each relation.
def pr_ulevel: class = $ cl_ulevel_prop ∪ cl_ulevel_le $;
def pr_eeqv: class = $ cl_eeqv_refl ∪ (cl_eeqv_bvar ∪ (cl_eeqv_srt ∪ (cl_eeqv_app ∪ (cl_eeqv_lam ∪ (cl_eeqv_pi ∪ (cl_eeqv_lit ∪ (cl_eeqv_cst ∪ (cl_eeqv_ind_ty ∪ (cl_eeqv_ind_ctor ∪ (cl_eeqv_ind_rec ∪ cl_eeqv_proj)))))))))) $;
def pr_ind_eqv: class = $ cl_ind_eqv_i $;
def pr_ceqv: class = $ cl_ceqv_nil ∪ cl_ceqv_cons $;
def pr_teqv: class = $ cl_teqv_nil ∪ cl_teqv_cons $;
def pr_cseqv: class = $ cl_cseqv_nil ∪ cl_cseqv_cons $;
def pr_lseqv: class = $ cl_lseqv_nil ∪ cl_lseqv_cons $;
def pr_nst_group: class = $ cl_nst_group_done ∪ cl_nst_group_cons $;

--| The program, at the atoms.
def lprog2: class =
  $ (((pr_ulevel ∪ pr_eeqv) ∪ (pr_ind_eqv ∪ pr_ceqv)) ∪ ((pr_teqv ∪ pr_cseqv) ∪ (pr_lseqv ∪ pr_nst_group))) ∩
    (fseq latoms × latoms) $;
--| The derivable atoms.
def lrel2: class = $ horn lprog2 $;

--| The relations: an atom is derivable.
def ulevel (a1: lvl) (a2: lvl): wff = $ _ ⇒ ra_ulevel (enc_lvl a1) (enc_lvl a2) ∈ lrel2 $;
def eeqv (a1: expr) (a2: expr): wff = $ _ ⇒ ra_eeqv (enc_expr a1) (enc_expr a2) ∈ lrel2 $;
def ind_eqv (a1: ind) (a2: ind): wff = $ _ ⇒ ra_ind_eqv (enc_ind a1) (enc_ind a2) ∈ lrel2 $;
def ceqv (a1: ctx) (a2: ctx): wff = $ _ ⇒ ra_ceqv (enc_ctx a1) (enc_ctx a2) ∈ lrel2 $;
def teqv (a1: tys) (a2: tys): wff = $ _ ⇒ ra_teqv (enc_tys a1) (enc_tys a2) ∈ lrel2 $;
def cseqv (a1: ctors) (a2: ctors): wff = $ _ ⇒ ra_cseqv (enc_ctors a1) (enc_ctors a2) ∈ lrel2 $;
def lseqv (a1: lvls) (a2: lvls): wff = $ _ ⇒ ra_lseqv (enc_lvls a1) (enc_lvls a2) ∈ lrel2 $;
def nst_group (a1: ctx) (a2: ind) (a3: ind) (a4: expr) (a5: nat) (a6: nat) (a7: nat) (a8: ctx) (a9: ctx): wff = $ _ ⇒ ra_nst_group (enc_ctx a1) (enc_ind a2) (enc_ind a3) (enc_expr a4) (enc_nat a5) (enc_nat a6) (enc_nat a7) (enc_ctx a8) (enc_ctx a9) ∈ lrel2 $;

theorem lprog2_hprog (G: hyps): $ G ⇒ hprog lprog2 latoms $;

--| The clause axioms at classes (`lrel2_A` for the clause axiom `A`): at any
--| trees `A1 .. An` for its variables, a clause's conclusion is derivable when
--| its premises are and its side conditions hold.
theorem lrel2_ulevel_prop (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ lveq A1 ⟨ kc_lz , ∅ ⟩ $ >
  $ G ⇒ ra_ulevel A1 A2 ∈ lrel2 $;
theorem lrel2_ulevel_le (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ lveq ⟨ kc_lmax , A1 +: A2 +: ∅ ⟩ A1 $ >
  $ G ⇒ ra_ulevel A1 A2 ∈ lrel2 $;
theorem lrel2_eeqv_refl (G: hyps) (A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A1 A1 ∈ lrel2 $;
theorem lrel2_eeqv_bvar (G: hyps) (A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ra_eeqv ⟨ kc_bvar , A1 +: ∅ ⟩ ⟨ kc_bvar , A1 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_srt (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ lveq A1 A2 $ >
  $ G ⇒ ra_eeqv ⟨ kc_srt , A1 +: ∅ ⟩ ⟨ kc_srt , A2 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_app (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A1 A3 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv A2 A4 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv ⟨ kc_app , A1 +: A2 +: ∅ ⟩ ⟨ kc_app , A3 +: A4 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_lam (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A1 A3 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv A2 A4 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv ⟨ kc_lam , A1 +: A2 +: ∅ ⟩ ⟨ kc_lam , A3 +: A4 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_pi (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A1 A3 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv A2 A4 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv ⟨ kc_pi , A1 +: A2 +: ∅ ⟩ ⟨ kc_pi , A3 +: A4 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_lit (G: hyps) (A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ra_eeqv ⟨ kc_lit , A1 +: ∅ ⟩ ⟨ kc_lit , A1 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_cst (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_lseqv A2 A3 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv ⟨ kc_cst , A1 +: A2 +: ∅ ⟩ ⟨ kc_cst , A1 +: A3 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_ind_ty (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_ind_eqv A1 A2 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv ⟨ kc_ind_ty , A1 +: A3 +: ∅ ⟩ ⟨ kc_ind_ty , A2 +: A3 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_ind_ctor (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_ind_eqv A1 A2 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv ⟨ kc_ind_ctor , A1 +: A3 +: A4 +: ∅ ⟩ ⟨ kc_ind_ctor , A2 +: A3 +: A4 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_ind_rec (G: hyps) (A1 A2 A3 A4 A5: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ ra_ind_eqv A1 A2 ∈ lrel2 $ >
  $ G ⇒ lveq A4 A5 $ >
  $ G ⇒ ra_eeqv ⟨ kc_ind_rec , A1 +: A3 +: A4 +: ∅ ⟩ ⟨ kc_ind_rec , A2 +: A3 +: A5 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_eeqv_proj (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A3 A4 ∈ lrel2 $ >
  $ G ⇒ ra_eeqv ⟨ kc_proj , A1 +: A2 +: A3 +: ∅ ⟩ ⟨ kc_proj , A1 +: A2 +: A4 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_ind_eqv_i (G: hyps) (A1 A2 A3 A4 A5 A6 A7 A8 A9: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ >
  $ G ⇒ ra_ceqv A4 A5 ∈ lrel2 $ >
  $ G ⇒ ra_teqv A8 A9 ∈ lrel2 $ >
  $ G ⇒ ra_ceqv A6 A7 ∈ lrel2 $ >
  $ G ⇒ ra_ind_data A1 A3 A4 A8 ∈ lrel $ >
  $ G ⇒ ra_ind_data A2 A3 A5 A9 ∈ lrel $ >
  $ G ⇒ ra_ind_nested A1 A6 ∈ lrel $ >
  $ G ⇒ ra_ind_nested A2 A7 ∈ lrel $ >
  $ G ⇒ ra_ind_eqv A1 A2 ∈ lrel2 $;
theorem lrel2_ceqv_nil (G: hyps):
  $ G ⇒ ra_ceqv ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ∈ lrel2 $;
theorem lrel2_ceqv_cons (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A1 A2 ∈ lrel2 $ >
  $ G ⇒ ra_ceqv A3 A4 ∈ lrel2 $ >
  $ G ⇒ ra_ceqv ⟨ kc_cons , A1 +: A3 +: ∅ ⟩ ⟨ kc_cons , A2 +: A4 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_teqv_nil (G: hyps):
  $ G ⇒ ra_teqv ⟨ kc_tnil , ∅ ⟩ ⟨ kc_tnil , ∅ ⟩ ∈ lrel2 $;
theorem lrel2_teqv_cons (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A1 A2 ∈ lrel2 $ >
  $ G ⇒ ra_cseqv A3 A4 ∈ lrel2 $ >
  $ G ⇒ ra_teqv A5 A6 ∈ lrel2 $ >
  $ G ⇒ ra_teqv ⟨ kc_tcons , A1 +: A3 +: A5 +: ∅ ⟩ ⟨ kc_tcons , A2 +: A4 +: A6 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_cseqv_nil (G: hyps):
  $ G ⇒ ra_cseqv ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ∈ lrel2 $;
theorem lrel2_cseqv_cons (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_eeqv A1 A2 ∈ lrel2 $ >
  $ G ⇒ ra_cseqv A3 A4 ∈ lrel2 $ >
  $ G ⇒ ra_cseqv ⟨ kc_ccons , A1 +: A3 +: ∅ ⟩ ⟨ kc_ccons , A2 +: A4 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_lseqv_nil (G: hyps):
  $ G ⇒ ra_lseqv ⟨ kc_lnil , ∅ ⟩ ⟨ kc_lnil , ∅ ⟩ ∈ lrel2 $;
theorem lrel2_lseqv_cons (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_lseqv A3 A4 ∈ lrel2 $ >
  $ G ⇒ lveq A1 A2 $ >
  $ G ⇒ ra_lseqv ⟨ kc_lcons , A1 +: A3 +: ∅ ⟩ ⟨ kc_lcons , A2 +: A4 +: ∅ ⟩ ∈ lrel2 $;
theorem lrel2_nst_group_done (G: hyps) (A1 A2 A3 A4 A5 A6 A7: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ >
  $ G ⇒ ra_nst_group A1 A2 A3 A4 A5 A6 A6 A7 A7 ∈ lrel2 $;
theorem lrel2_nst_group_cons (G: hyps) (A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ > $ G ⇒ A10 ∈ trees ω $ > $ G ⇒ A11 ∈ trees ω $ >
  $ G ⇒ ra_nst_group A1 A2 A3 A4 ⟨ kc_s , A6 +: ∅ ⟩ ⟨ kc_s , A7 +: ∅ ⟩ A8 A10 A11 ∈ lrel2 $ >
  $ G ⇒ ra_le ⟨ kc_s , A7 +: ∅ ⟩ A8 ∈ lrel $ >
  $ G ⇒ ra_spine ⟨ kc_ind_ty , A3 +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ A4 A9 ∈ lrel $ >
  $ G ⇒ ra_rehead ⟨ kc_ind_ty , A3 +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_ind_ty , A3 +: A7 +: ∅ ⟩ A9 A4 A5 ∈ lrel $ >
  $ G ⇒ ra_aux_data A2 A3 A5 A6 A7 ∈ lrel $ >
  $ G ⇒ ra_nst_group A1 A2 A3 A4 A6 A7 A8 ⟨ kc_cons , A5 +: A10 +: ∅ ⟩ A11 ∈ lrel2 $;

--| The clause axioms, as the spec states them.
theorem ulevel_prop (l u: lvl): $ l ≈ lz $ > $ ulevel l u $;
theorem ulevel_le (l u: lvl): $ l ⊔ u ≈ l $ > $ ulevel l u $;
theorem eeqv_refl (e: expr): $ eeqv e e $;
theorem eeqv_bvar (i: nat): $ eeqv #i #i $;
theorem eeqv_srt (l l2: lvl): $ l ≈ l2 $ > $ eeqv Sort l Sort l2 $;
theorem eeqv_app (f a f2 a2: expr): $ eeqv f f2 $ > $ eeqv a a2 $ > $ eeqv (f @ a) (f2 @ a2) $;
theorem eeqv_lam (A b A2 b2: expr): $ eeqv A A2 $ > $ eeqv b b2 $ > $ eeqv (λ A, b) (λ A2, b2) $;
theorem eeqv_pi (A b A2 b2: expr): $ eeqv A A2 $ > $ eeqv b b2 $ > $ eeqv (Π A, b) (Π A2, b2) $;
theorem eeqv_lit (n: bin): $ eeqv (lit n) (lit n) $;
theorem eeqv_cst (a: atom) (S S2: lvls): $ lseqv S S2 $ > $ eeqv (cst a S) (cst a S2) $;
theorem eeqv_ind_ty (D D2: ind) (i: nat): $ ind_eqv D D2 $ > $ eeqv (ind_ty D i) (ind_ty D2 i) $;
theorem eeqv_ind_ctor (D D2: ind) (i c: nat): $ ind_eqv D D2 $ > $ eeqv (ind_ctor D i c) (ind_ctor D2 i c) $;
theorem eeqv_ind_rec (D D2: ind) (i: nat) (v v2: lvl): $ ind_eqv D D2 $ > $ v ≈ v2 $ > $ eeqv (ind_rec D i v) (ind_rec D2 i v2) $;
theorem eeqv_proj (b: blk) (i: nat) (e e2: expr): $ eeqv e e2 $ > $ eeqv (proj b i e) (proj b i e2) $;
theorem ind_eqv_i (D D2: ind) (b: blk) (P P2 N N2: ctx) (T T2: tys): $ ind_data D b P T $ > $ ind_data D2 b P2 T2 $ > $ ceqv P P2 $ > $ teqv T T2 $ > $ ind_nested D N $ > $ ind_nested D2 N2 $ > $ ceqv N N2 $ > $ ind_eqv D D2 $;
theorem ceqv_nil: $ ceqv [] [] $;
theorem ceqv_cons (A A2: expr) (G G2: ctx): $ eeqv A A2 $ > $ ceqv G G2 $ > $ ceqv (G ▷ A) (G2 ▷ A2) $;
theorem teqv_nil: $ teqv tnil tnil $;
theorem teqv_cons (F F2: expr) (C C2: ctors) (T T2: tys): $ eeqv F F2 $ > $ cseqv C C2 $ > $ teqv T T2 $ > $ teqv (tcons F C T) (tcons F2 C2 T2) $;
theorem cseqv_nil: $ cseqv cnil cnil $;
theorem cseqv_cons (K K2: expr) (C C2: ctors): $ eeqv K K2 $ > $ cseqv C C2 $ > $ cseqv (ccons K C) (ccons K2 C2) $;
theorem lseqv_nil: $ lseqv lnil lnil $;
theorem lseqv_cons (l l2: lvl) (S S2: lvls): $ l ≈ l2 $ > $ lseqv S S2 $ > $ lseqv (lcons l S) (lcons l2 S2) $;
theorem nst_group_done (G: ctx) (D I: ind) (X0: expr) (j ni: nat) (N: ctx): $ nst_group G D I X0 j ni ni N N $;
theorem nst_group_cons (G: ctx) (D I: ind) (X0 X: expr) (j i ni npi: nat) (N N2: ctx): $ i < ni $ > $ spine (ind_ty I 0) X0 npi $ > $ rehead (ind_ty I 0) (ind_ty I i) npi X0 X $ > $ aux_data D I X j i $ > $ nst_group G D I X0 (s j) (s i) ni N N2 $ > $ nst_group G D I X0 j i ni (X :: N) N2 $;

--| The program's clauses that conclude an atom of a relation are that relation's.
theorem lprog2_ulevel_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_ulevel A1 A2 ⟩ ∈ lprog2 $ > $ G ⇒ ⟨ P , ra_ulevel A1 A2 ⟩ ∈ pr_ulevel $;
theorem lprog2_eeqv_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_eeqv A1 A2 ⟩ ∈ lprog2 $ > $ G ⇒ ⟨ P , ra_eeqv A1 A2 ⟩ ∈ pr_eeqv $;
theorem lprog2_ind_eqv_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_ind_eqv A1 A2 ⟩ ∈ lprog2 $ > $ G ⇒ ⟨ P , ra_ind_eqv A1 A2 ⟩ ∈ pr_ind_eqv $;
theorem lprog2_ceqv_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_ceqv A1 A2 ⟩ ∈ lprog2 $ > $ G ⇒ ⟨ P , ra_ceqv A1 A2 ⟩ ∈ pr_ceqv $;
theorem lprog2_teqv_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_teqv A1 A2 ⟩ ∈ lprog2 $ > $ G ⇒ ⟨ P , ra_teqv A1 A2 ⟩ ∈ pr_teqv $;
theorem lprog2_cseqv_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_cseqv A1 A2 ⟩ ∈ lprog2 $ > $ G ⇒ ⟨ P , ra_cseqv A1 A2 ⟩ ∈ pr_cseqv $;
theorem lprog2_lseqv_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_lseqv A1 A2 ⟩ ∈ lprog2 $ > $ G ⇒ ⟨ P , ra_lseqv A1 A2 ⟩ ∈ pr_lseqv $;
theorem lprog2_nst_group_pr (G: hyps) (P A1 A2 A3 A4 A5 A6 A7 A8 A9: class):
  $ G ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ lprog2 $ > $ G ⇒ ⟨ P , ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ⟩ ∈ pr_nst_group $;

--| Inversion: a derivable atom of a relation is the conclusion of one of its
--| clauses, at sets, with the clause's premises derivable and its side
--| conditions true (as in lean-tg.mm0).
theorem lrel2_ulevel_cases (G: hyps) {l_v u_v: set} (t1 t2: set):
  $ G ⇒ ra_ulevel t1 t2 ∈ lrel2 $ >
  $ G ⇒ ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq l_v ⟨ kc_lz , ∅ ⟩) ∨
      ∃ l_v ∃ u_v (t1 = l_v ∧ t2 = u_v ∧ lveq ⟨ kc_lmax , l_v +: u_v +: ∅ ⟩ l_v) $;
theorem lrel2_eeqv_cases (G: hyps) {e_v i_v l_v l2 f_v a_v f2 a2 A b_v A2 b2 n_v S S2 D D2 c_v v_v v2 e2: set} (t1 t2: set):
  $ G ⇒ ra_eeqv t1 t2 ∈ lrel2 $ >
  $ G ⇒ ∃ e_v (t1 = e_v ∧ t2 = e_v) ∨
      ∃ i_v (t1 = ⟨ kc_bvar , i_v +: ∅ ⟩ ∧ t2 = ⟨ kc_bvar , i_v +: ∅ ⟩) ∨
      ∃ l_v ∃ l2 (t1 = ⟨ kc_srt , l_v +: ∅ ⟩ ∧ t2 = ⟨ kc_srt , l2 +: ∅ ⟩ ∧ lveq l_v l2) ∨
      ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = ⟨ kc_app , f_v +: a_v +: ∅ ⟩ ∧ t2 = ⟨ kc_app , f2 +: a2 +: ∅ ⟩ ∧ ra_eeqv f_v f2 ∈ lrel2 ∧ ra_eeqv a_v a2 ∈ lrel2) ∨
      ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_lam , A +: b_v +: ∅ ⟩ ∧ t2 = ⟨ kc_lam , A2 +: b2 +: ∅ ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨
      ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = ⟨ kc_pi , A +: b_v +: ∅ ⟩ ∧ t2 = ⟨ kc_pi , A2 +: b2 +: ∅ ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_eeqv b_v b2 ∈ lrel2) ∨
      ∃ n_v (t1 = ⟨ kc_lit , n_v +: ∅ ⟩ ∧ t2 = ⟨ kc_lit , n_v +: ∅ ⟩) ∨
      ∃ a_v ∃ S ∃ S2 (t1 = ⟨ kc_cst , a_v +: S +: ∅ ⟩ ∧ t2 = ⟨ kc_cst , a_v +: S2 +: ∅ ⟩ ∧ ra_lseqv S S2 ∈ lrel2) ∨
      ∃ D ∃ D2 ∃ i_v (t1 = ⟨ kc_ind_ty , D +: i_v +: ∅ ⟩ ∧ t2 = ⟨ kc_ind_ty , D2 +: i_v +: ∅ ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨
      ∃ D ∃ D2 ∃ i_v ∃ c_v (t1 = ⟨ kc_ind_ctor , D +: i_v +: c_v +: ∅ ⟩ ∧ t2 = ⟨ kc_ind_ctor , D2 +: i_v +: c_v +: ∅ ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2) ∨
      ∃ D ∃ D2 ∃ i_v ∃ v_v ∃ v2 (t1 = ⟨ kc_ind_rec , D +: i_v +: v_v +: ∅ ⟩ ∧ t2 = ⟨ kc_ind_rec , D2 +: i_v +: v2 +: ∅ ⟩ ∧ ra_ind_eqv D D2 ∈ lrel2 ∧ lveq v_v v2) ∨
      ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = ⟨ kc_proj , b_v +: i_v +: e_v +: ∅ ⟩ ∧ t2 = ⟨ kc_proj , b_v +: i_v +: e2 +: ∅ ⟩ ∧ ra_eeqv e_v e2 ∈ lrel2) $;
theorem lrel2_ind_eqv_cases (G: hyps) {D D2 b_v P P2 N N2 T T2: set} (t1 t2: set):
  $ G ⇒ ra_ind_eqv t1 t2 ∈ lrel2 $ >
  $ G ⇒ ∃ D ∃ D2 ∃ b_v ∃ P ∃ P2 ∃ N ∃ N2 ∃ T ∃ T2 (t1 = D ∧ t2 = D2 ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_data D2 b_v P2 T2 ∈ lrel ∧ ra_ceqv P P2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2 ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_nested D2 N2 ∈ lrel ∧ ra_ceqv N N2 ∈ lrel2) $;
theorem lrel2_ceqv_cases (G: hyps) {A A2 G_v G2: set} (t1 t2: set):
  $ G ⇒ ra_ceqv t1 t2 ∈ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨
      ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , A +: G_v +: ∅ ⟩ ∧ t2 = ⟨ kc_cons , A2 +: G2 +: ∅ ⟩ ∧ ra_eeqv A A2 ∈ lrel2 ∧ ra_ceqv G_v G2 ∈ lrel2) $;
theorem lrel2_teqv_cases (G: hyps) {F F2 C C2 T T2: set} (t1 t2: set):
  $ G ⇒ ra_teqv t1 t2 ∈ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨
      ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ T2 (t1 = ⟨ kc_tcons , F +: C +: T +: ∅ ⟩ ∧ t2 = ⟨ kc_tcons , F2 +: C2 +: T2 +: ∅ ⟩ ∧ ra_eeqv F F2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2 ∧ ra_teqv T T2 ∈ lrel2) $;
theorem lrel2_cseqv_cases (G: hyps) {K K2 C C2: set} (t1 t2: set):
  $ G ⇒ ra_cseqv t1 t2 ∈ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_cnil , ∅ ⟩) ∨
      ∃ K ∃ K2 ∃ C ∃ C2 (t1 = ⟨ kc_ccons , K +: C +: ∅ ⟩ ∧ t2 = ⟨ kc_ccons , K2 +: C2 +: ∅ ⟩ ∧ ra_eeqv K K2 ∈ lrel2 ∧ ra_cseqv C C2 ∈ lrel2) $;
theorem lrel2_lseqv_cases (G: hyps) {l_v l2 S S2: set} (t1 t2: set):
  $ G ⇒ ra_lseqv t1 t2 ∈ lrel2 $ >
  $ G ⇒ (t1 = ⟨ kc_lnil , ∅ ⟩ ∧ t2 = ⟨ kc_lnil , ∅ ⟩) ∨
      ∃ l_v ∃ l2 ∃ S ∃ S2 (t1 = ⟨ kc_lcons , l_v +: S +: ∅ ⟩ ∧ t2 = ⟨ kc_lcons , l2 +: S2 +: ∅ ⟩ ∧ lveq l_v l2 ∧ ra_lseqv S S2 ∈ lrel2) $;
theorem lrel2_nst_group_cases (G: hyps) {G_v D I X0 j_v ni N X i_v npi N2: set} (t1 t2 t3 t4 t5 t6 t7 t8 t9: set):
  $ G ⇒ ra_nst_group t1 t2 t3 t4 t5 t6 t7 t8 t9 ∈ lrel2 $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ X0 ∃ j_v ∃ ni ∃ N (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = ni ∧ t7 = ni ∧ t8 = N ∧ t9 = N) ∨
      ∃ G_v ∃ D ∃ I ∃ X0 ∃ X ∃ j_v ∃ i_v ∃ ni ∃ npi ∃ N ∃ N2 (t1 = G_v ∧ t2 = D ∧ t3 = I ∧ t4 = X0 ∧ t5 = j_v ∧ t6 = i_v ∧ t7 = ni ∧ t8 = ⟨ kc_cons , X +: N +: ∅ ⟩ ∧ t9 = N2 ∧ ra_le ⟨ kc_s , i_v +: ∅ ⟩ ni ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , I +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ X0 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , I +: ⟨ kc_nz , ∅ ⟩ +: ∅ ⟩ ⟨ kc_ind_ty , I +: i_v +: ∅ ⟩ npi X0 X ∈ lrel ∧ ra_aux_data D I X j_v i_v ∈ lrel ∧ ra_nst_group G_v D I X0 ⟨ kc_s , j_v +: ∅ ⟩ ⟨ kc_s , i_v +: ∅ ⟩ ni N N2 ∈ lrel2) $;
