theorem ra_ind_eqv_eq (G: hyps) (A1 B1 A2 B2: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ ra_ind_eqv A1 A2 = ra_ind_eqv B1 B2 $;
--| @rewrite
theorem sb_c_ra_ind_eqv {x: set} (t: set x) (A1 A2: class x): $ ([[ x / t ]] (ra_ind_eqv A1 A2)) ≐ ra_ind_eqv ([[ x / t ]] A1) ([[ x / t ]] A2) $;
--| @congr
theorem ra_ceqv_congr (A1 B1 A2 B2: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ ra_ceqv A1 A2 ≐ ra_ceqv B1 B2 $;
theorem ra_ceqv_eq (G: hyps) (A1 B1 A2 B2: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ ra_ceqv A1 A2 = ra_ceqv B1 B2 $;
--| @rewrite
theorem sb_c_ra_ceqv {x: set} (t: set x) (A1 A2: class x): $ ([[ x / t ]] (ra_ceqv A1 A2)) ≐ ra_ceqv ([[ x / t ]] A1) ([[ x / t ]] A2) $;
--| @congr
theorem ra_teqv_congr (A1 B1 A2 B2: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ ra_teqv A1 A2 ≐ ra_teqv B1 B2 $;
theorem ra_teqv_eq (G: hyps) (A1 B1 A2 B2: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ ra_teqv A1 A2 = ra_teqv B1 B2 $;
--| @rewrite
theorem sb_c_ra_teqv {x: set} (t: set x) (A1 A2: class x): $ ([[ x / t ]] (ra_teqv A1 A2)) ≐ ra_teqv ([[ x / t ]] A1) ([[ x / t ]] A2) $;
