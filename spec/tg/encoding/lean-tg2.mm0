theorem ra_ulevel_eq (G: hyps) (A1 B1 A2 B2: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ ra_ulevel A1 A2 = ra_ulevel B1 B2 $;
--| @rewrite
theorem sb_c_ra_ulevel {x: set} (t: set x) (A1 A2: class x): $ ([[ x / t ]] (ra_ulevel A1 A2)) ≐ ra_ulevel ([[ x / t ]] A1) ([[ x / t ]] A2) $;
--| @congr
theorem ra_eeqv_congr (A1 B1 A2 B2: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ ra_eeqv A1 A2 ≐ ra_eeqv B1 B2 $;
theorem ra_eeqv_eq (G: hyps) (A1 B1 A2 B2: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ ra_eeqv A1 A2 = ra_eeqv B1 B2 $;
--| @rewrite
theorem sb_c_ra_eeqv {x: set} (t: set x) (A1 A2: class x): $ ([[ x / t ]] (ra_eeqv A1 A2)) ≐ ra_eeqv ([[ x / t ]] A1) ([[ x / t ]] A2) $;
