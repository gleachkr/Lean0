-- lean-tg2.mm0: the relations of Part II of spec/lean.mm0 over level
-- equivalence, encoded in the TG library (the second stratum).
-- GENERATED by scripts/tg-lean.py from spec/lean.mm0; do not edit.
--
-- The relations of Part II whose clauses need only Part I's relations and
-- level equivalence (`eeqv` and its kind, `ulevel`, `nst_group`) are one
-- program of Horn clauses over Part I's least model, as in lean-tg.mm0: a
-- clause's premises are its atoms of this stratum, and its other premises are
-- side conditions of the clause's ground instances (an atom of Part I is
-- derivable, in `lrel`; two level trees are equivalent, `lveq`). Each
-- relation is a `def`, and each clause axiom of the spec is a theorem, with
-- the spec's statement; then the exclusion lemmas `lprog2_R_pr` and inversion
-- `lrel2_R_cases`. No axioms.
-- Imports model-levels.mm0 (`lveq`); proofs in lean-tg2.auf.

import "../model/model-levels.mm0";

-- --------------------------------------------------------------------------
-- Labels and atoms
-- --------------------------------------------------------------------------

def kr_ulevel: class = $ suc kr_eta_eq $;
def kr_eeqv: class = $ suc kr_ulevel $;
def kr_ind_eqv: class = $ suc kr_eeqv $;
def kr_ceqv: class = $ suc kr_ind_eqv $;
def kr_teqv: class = $ suc kr_ceqv $;
def kr_cseqv: class = $ suc kr_teqv $;
def kr_lseqv: class = $ suc kr_cseqv $;
def kr_nst_group: class = $ suc kr_lseqv $;

--| The atoms: a label and the trees of the arguments.
def ra_ulevel (a1 a2: class): class = $ ⟨ kr_ulevel , a1 +: a2 +: ∅ ⟩ $;
def ra_eeqv (a1 a2: class): class = $ ⟨ kr_eeqv , a1 +: a2 +: ∅ ⟩ $;
def ra_ind_eqv (a1 a2: class): class = $ ⟨ kr_ind_eqv , a1 +: a2 +: ∅ ⟩ $;
def ra_ceqv (a1 a2: class): class = $ ⟨ kr_ceqv , a1 +: a2 +: ∅ ⟩ $;
def ra_teqv (a1 a2: class): class = $ ⟨ kr_teqv , a1 +: a2 +: ∅ ⟩ $;
def ra_cseqv (a1 a2: class): class = $ ⟨ kr_cseqv , a1 +: a2 +: ∅ ⟩ $;
def ra_lseqv (a1 a2: class): class = $ ⟨ kr_lseqv , a1 +: a2 +: ∅ ⟩ $;
def ra_nst_group (a1 a2 a3 a4 a5 a6 a7 a8 a9: class): class = $ ⟨ kr_nst_group , a1 +: a2 +: a3 +: a4 +: a5 +: a6 +: a7 +: a8 +: a9 +: ∅ ⟩ $;

--| Every label is a natural number.
theorem kr_ulevel_omega (G: hyps): $ G ⇒ kr_ulevel ∈ ω $;
theorem kr_eeqv_omega (G: hyps): $ G ⇒ kr_eeqv ∈ ω $;
theorem kr_ind_eqv_omega (G: hyps): $ G ⇒ kr_ind_eqv ∈ ω $;
theorem kr_ceqv_omega (G: hyps): $ G ⇒ kr_ceqv ∈ ω $;
theorem kr_teqv_omega (G: hyps): $ G ⇒ kr_teqv ∈ ω $;
theorem kr_cseqv_omega (G: hyps): $ G ⇒ kr_cseqv ∈ ω $;
theorem kr_lseqv_omega (G: hyps): $ G ⇒ kr_lseqv ∈ ω $;
theorem kr_nst_group_omega (G: hyps): $ G ⇒ kr_nst_group ∈ ω $;

