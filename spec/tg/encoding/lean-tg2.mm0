theorem ra_cseqv_congr (A1 B1 A2 B2: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ ra_cseqv A1 A2 ≐ ra_cseqv B1 B2 $;
theorem ra_cseqv_eq (G: hyps) (A1 B1 A2 B2: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ ra_cseqv A1 A2 = ra_cseqv B1 B2 $;
--| @rewrite
theorem sb_c_ra_cseqv {x: set} (t: set x) (A1 A2: class x): $ ([[ x / t ]] (ra_cseqv A1 A2)) ≐ ra_cseqv ([[ x / t ]] A1) ([[ x / t ]] A2) $;
--| @congr
theorem ra_lseqv_congr (A1 B1 A2 B2: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ ra_lseqv A1 A2 ≐ ra_lseqv B1 B2 $;
theorem ra_lseqv_eq (G: hyps) (A1 B1 A2 B2: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ ra_lseqv A1 A2 = ra_lseqv B1 B2 $;
--| @rewrite
theorem sb_c_ra_lseqv {x: set} (t: set x) (A1 A2: class x): $ ([[ x / t ]] (ra_lseqv A1 A2)) ≐ ra_lseqv ([[ x / t ]] A1) ([[ x / t ]] A2) $;
--| @congr
theorem ra_nst_group_congr (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6 A7 B7 A8 B8 A9 B9: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ > $ A6 ≐ B6 $ > $ A7 ≐ B7 $ > $ A8 ≐ B8 $ > $ A9 ≐ B9 $ > $ ra_nst_group A1 A2 A3 A4 A5 A6 A7 A8 A9 ≐ ra_nst_group B1 B2 B3 B4 B5 B6 B7 B8 B9 $;
