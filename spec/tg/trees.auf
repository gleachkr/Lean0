-- Proofs for trees.mm0.

--| Three substitutions, reversed.
lemma t1_sb3_rev {k s v: set} (a b c: set) (B: class k s v):
  $ (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) ≐ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $
----
r1: $ (⟦ s / b ⟧ (⟦ k / a ⟧ B)) ≐ (⟦ k / a ⟧ (⟦ s / b ⟧ B)) $ by sb_c_swap
r2: $ seqt c c $ by seqt_refl
r3: $ (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) ≐ (⟦ v / c ⟧ (⟦ k / a ⟧ (⟦ s / b ⟧ B))) $ by sb_c_congr [r2, r1]
r4: $ (⟦ v / c ⟧ (⟦ k / a ⟧ (⟦ s / b ⟧ B))) ≐ (⟦ k / a ⟧ (⟦ v / c ⟧ (⟦ s / b ⟧ B))) $ by sb_c_swap
r5: $ (⟦ v / c ⟧ (⟦ s / b ⟧ B)) ≐ (⟦ s / b ⟧ (⟦ v / c ⟧ B)) $ by sb_c_swap
r6: $ seqt a a $ by seqt_refl
r7: $ (⟦ k / a ⟧ (⟦ v / c ⟧ (⟦ s / b ⟧ B))) ≐ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by sb_c_congr [r6, r5]
r8: $ (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) ≐ (⟦ k / a ⟧ (⟦ v / c ⟧ (⟦ s / b ⟧ B))) $ by ceqt_trans [r3, r4]
r9: $ (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) ≐ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by ceqt_trans [r8, r7]

--| Moving three substitutions along equalities of set variables.
lemma t1_sb3_eq {k s v: set} (G: hyps k s v) (B: class k s v) (a b c i j u: set):
  $ G ⇒ a = i $ > $ G ⇒ b = j $ > $ G ⇒ c = u $ >
  $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $
----
p1: $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ k / i ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by sb_c_eq [#1]
p2: $ (⟦ k / i ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) ≐ (⟦ s / b ⟧ (⟦ k / i ⟧ (⟦ v / c ⟧ B))) $ by sb_c_swap
p3: $ G ⇒ (⟦ k / i ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ s / b ⟧ (⟦ k / i ⟧ (⟦ v / c ⟧ B))) $ by weaken [p2]
p4: $ G ⇒ (⟦ s / b ⟧ (⟦ k / i ⟧ (⟦ v / c ⟧ B))) = (⟦ s / j ⟧ (⟦ k / i ⟧ (⟦ v / c ⟧ B))) $ by sb_c_eq [#2]
p5: $ (⟦ s / j ⟧ (⟦ k / i ⟧ (⟦ v / c ⟧ B))) ≐ (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / c ⟧ B))) $ by sb_c_swap
p6: $ G ⇒ (⟦ s / j ⟧ (⟦ k / i ⟧ (⟦ v / c ⟧ B))) = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / c ⟧ B))) $ by weaken [p5]
p7: $ (⟦ s / j ⟧ (⟦ v / c ⟧ B)) ≐ (⟦ v / c ⟧ (⟦ s / j ⟧ B)) $ by sb_c_swap
p8: $ seqt i i $ by seqt_refl
p9: $ (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / c ⟧ B))) ≐ (⟦ k / i ⟧ (⟦ v / c ⟧ (⟦ s / j ⟧ B))) $ by sb_c_congr [p8, p7]
p10: $ (⟦ k / i ⟧ (⟦ v / c ⟧ (⟦ s / j ⟧ B))) ≐ (⟦ v / c ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) $ by sb_c_swap
q1: $ (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / c ⟧ B))) ≐ (⟦ v / c ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) $ by ceqt_trans [p9, p10]
q2: $ G ⇒ (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / c ⟧ B))) = (⟦ v / c ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) $ by weaken [q1]
p11: $ G ⇒ (⟦ v / c ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) = (⟦ v / u ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) $ by sb_c_eq [#3]
p12: $ (⟦ v / u ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) ≐ (⟦ k / i ⟧ (⟦ v / u ⟧ (⟦ s / j ⟧ B))) $ by sb_c_swap
p13: $ (⟦ v / u ⟧ (⟦ s / j ⟧ B)) ≐ (⟦ s / j ⟧ (⟦ v / u ⟧ B)) $ by sb_c_swap
p14: $ (⟦ k / i ⟧ (⟦ v / u ⟧ (⟦ s / j ⟧ B))) ≐ (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by sb_c_congr [p8, p13]
q3: $ (⟦ v / u ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) ≐ (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by ceqt_trans [p12, p14]
q4: $ G ⇒ (⟦ v / u ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by weaken [q3]
t1: $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ s / b ⟧ (⟦ k / i ⟧ (⟦ v / c ⟧ B))) $ by eq_trans [p1, p3]
t2: $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ s / j ⟧ (⟦ k / i ⟧ (⟦ v / c ⟧ B))) $ by eq_trans [t1, p4]
t3: $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / c ⟧ B))) $ by eq_trans [t2, p6]
t4: $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ v / c ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) $ by eq_trans [t3, q2]
t5: $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ v / u ⟧ (⟦ k / i ⟧ (⟦ s / j ⟧ B))) $ by eq_trans [t4, p11]
t6: $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by eq_trans [t5, q4]

--| Introduction for `cgr3`.
cgr3_intro
----------
i1: $ (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) ≐ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by t1_sb3_rev
i2: $ G ⇒ (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by weaken [i1]
i3: $ G ⇒ (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) = (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) $ by eq_sym [i2]
i4: $ G ⇒ f = (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) $ by eq_trans [#1, i3]
i5: $ G ⇒ isset a $ by isset_var
i6: $ G ⇒ isset b $ by isset_var
i7: $ G ⇒ isset c $ by isset_var
i8: $ G ⇒ isset f $ by isset_var
i9: $ G ⇒ isset ⟨ b , c ⟩ $ by opair_set [i6, i7]
i10: $ G ⇒ isset ⟨ a , ⟨ b , c ⟩ ⟩ $ by opair_set [i5, i9]
i11: $ G ⇒ isset ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ $ by opair_set [i10, i8]
j1: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ $ by ax
j2: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ f = (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) $ by weaken [i4]
j3: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ∧ f = (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) $ by and_intro [j1, j2]
j4: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ ∃ y (z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , y ⟩ ∧ y = (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B)))) $ by ex_intro (x := $ y $, t := $ f $, p := $ z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , y ⟩ ∧ y = (⟦ v / c ⟧ (⟦ s / b ⟧ (⟦ k / a ⟧ B))) $) [j3]
j5: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ ∃ v ∃ y (z = ⟨ ⟨ a , ⟨ b , v ⟩ ⟩ , y ⟩ ∧ y = (⟦ s / b ⟧ (⟦ k / a ⟧ B))) $ by ex_intro (x := $ v $, t := $ c $, p := $ ∃ y (z = ⟨ ⟨ a , ⟨ b , v ⟩ ⟩ , y ⟩ ∧ y = (⟦ s / b ⟧ (⟦ k / a ⟧ B))) $) [j4]
j6: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ ∃ s ∃ v ∃ y (z = ⟨ ⟨ a , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = (⟦ k / a ⟧ B)) $ by ex_intro (x := $ s $, t := $ b $, p := $ ∃ v ∃ y (z = ⟨ ⟨ a , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = (⟦ k / a ⟧ B)) $) [j5]
j7: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ ∃ k ∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B) $ by ex_intro (x := $ k $, t := $ a $, p := $ ∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B) $) [j6]
j8: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ z ∊ {w | ∃ k ∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)} $ by cab_intro (x := $ w $, t := $ z $, p := $ ∃ k ∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B) $) [j7]
j9: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ⇒ ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ∈ cgr3 k s v B $ by wcel_intro [j1, j8]
j10: $ G ⇒ ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ ∈ cgr3 k s v B $ by isset_elim [i11, j9]

--| Elimination for `cgr3`, with the components named in the statement's order.
cgr3_elim_mem
-------------
m1: $ G ⇒ ∃ k ∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B) $ by cab_elim (x := $ w $, t := $ z $, p := $ ∃ k ∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B) $) [#1]
a1: $ (∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ ∃ g (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , g ⟩ ∧ g = B) $ by ex_alpha
a2: $ (∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ ∃ v ∃ g (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , g ⟩ ∧ g = B) $ by ex_congr [a1]
a3: $ (∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ ∃ s ∃ v ∃ g (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , g ⟩ ∧ g = B) $ by ex_congr [a2]
a4: $ (∃ k ∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ ∃ k ∃ s ∃ v ∃ g (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , g ⟩ ∧ g = B) $ by ex_congr [a3]
b1: $ (∃ v ∃ g (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , g ⟩ ∧ g = B)) ⟺ ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ s , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ v / u ⟧ B)) $ by ex_alpha
b2: $ (∃ s ∃ v ∃ g (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , g ⟩ ∧ g = B)) ⟺ ∃ s ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ s , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ v / u ⟧ B)) $ by ex_congr [b1]
b3: $ (∃ k ∃ s ∃ v ∃ g (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , g ⟩ ∧ g = B)) ⟺ ∃ k ∃ s ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ s , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ v / u ⟧ B)) $ by ex_congr [b2]
c1: $ (∃ s ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ s , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ v / u ⟧ B))) ⟺ ∃ j ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by ex_alpha
c2: $ (∃ k ∃ s ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ s , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ v / u ⟧ B))) ⟺ ∃ k ∃ j ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by ex_congr [c1]
d1: $ (∃ k ∃ j ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) ⟺ ∃ i ∃ j ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) $ by ex_alpha
e1: $ (∃ k ∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ ∃ k ∃ s ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ s , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ v / u ⟧ B)) $ by iff_trans [a4, b3]
e2: $ (∃ k ∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ ∃ k ∃ j ∃ u ∃ g (z = ⟨ ⟨ k , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by iff_trans [e1, c2]
e3: $ (∃ k ∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ ∃ i ∃ j ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) $ by iff_trans [e2, d1]
e4: $ G ⇒ (∃ k ∃ s ∃ v ∃ y (z = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ↔ ∃ i ∃ j ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) $ by weaken [e3]
f0: $ G ⇒ ∃ i ∃ j ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) $ by bi_elim_l [e4, m1]
h1: $ H , z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) ⇒ z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by ax
h2: $ H , z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) ⇒ z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ $ by and_elim_l [h1]
h3: $ H , z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) ⇒ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) $ by and_elim_r [h1]
h4: $ H , z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) , g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) ⇒ p $ by cut [h2, #2]
h5: $ H , z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) ⇒ p $ by cut [h3, h4]
h6: $ H , ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) ⇒ ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) $ by ax
h7: $ H , ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) ⇒ p $ by ex_elim [h6, h5]
h8: $ H , ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) ⇒ ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) $ by ax
h9: $ H , ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) ⇒ p $ by ex_elim [h8, h7]
h10: $ H , ∃ j ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) ⇒ ∃ j ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) $ by ax
h11: $ H , ∃ j ∃ u ∃ g (z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ ∧ g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B)))) ⇒ p $ by ex_elim [h10, h9]
h12: $ G , H ⇒ p $ by ex_elim [f0, h11]

--| Elimination for a pair whose argument is a triple.
cgr3_elim
---------
k1: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ , z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ , g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) ⇒ z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ $ by ax
k2: $ G , z = ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , f ⟩ , z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ , g = (⟦ k / i ⟧ (⟦ s / j ⟧ (⟦ v / u ⟧ B))) ⇒ z = ⟨ ⟨ i , ⟨ j , u ⟩ ⟩ , g ⟩ $ by ax
