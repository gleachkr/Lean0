--| The abstraction of membership in a class is included in it.
lemma t1_cab_welc_subset {y: set} (G: hyps y) (P: class): $ G ⇒ {y | y ∊ P} ⊆ P $
----
l1: $ G , c ∊ {y | y ∊ P} ⇒ c ∊ {y | y ∊ P} $ by ax
l2: $ G , c ∊ {y | y ∊ P} ⇒ c ∊ P $ by cab_elim (x := $ y $, t := $ c $, p := $ y ∊ P $) [l1]
l3: $ G ⇒ {y | y ∊ P} ⊆ P $ by subset_intro [l2]

