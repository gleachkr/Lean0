l17: $ (z = ⟨ ⟨ k , j ⟩ , fv C ⟨ k , ⟨ j , ccom E j ⟩ ⟩ ⟩ ∧ k ∊ A ∧ j ∊ fseq (cdm E)) ⟺ (z = ⟨ ⟨ k , j ⟩ , fv D ⟨ k , ⟨ j , ccom F j ⟩ ⟩ ⟩ ∧ k ∊ B ∧ j ∊ fseq (cdm F)) $ by and_congr [l9, l16]
l18: $ (∃ j (z = ⟨ ⟨ k , j ⟩ , fv C ⟨ k , ⟨ j , ccom E j ⟩ ⟩ ⟩ ∧ k ∊ A ∧ j ∊ fseq (cdm E))) ⟺ (∃ j (z = ⟨ ⟨ k , j ⟩ , fv D ⟨ k , ⟨ j , ccom F j ⟩ ⟩ ⟩ ∧ k ∊ B ∧ j ∊ fseq (cdm F))) $ by ex_congr [l17]
l19: $ (∃ k ∃ j (z = ⟨ ⟨ k , j ⟩ , fv C ⟨ k , ⟨ j , ccom E j ⟩ ⟩ ⟩ ∧ k ∊ A ∧ j ∊ fseq (cdm E))) ⟺ (∃ k ∃ j (z = ⟨ ⟨ k , j ⟩ , fv D ⟨ k , ⟨ j , ccom F j ⟩ ⟩ ⟩ ∧ k ∊ B ∧ j ∊ fseq (cdm F))) $ by ex_congr [l18]
l20: $ {z | ∃ k ∃ j (z = ⟨ ⟨ k , j ⟩ , fv C ⟨ k , ⟨ j , ccom E j ⟩ ⟩ ⟩ ∧ k ∊ A ∧ j ∊ fseq (cdm E))} ≐ {z | ∃ k ∃ j (z = ⟨ ⟨ k , j ⟩ , fv D ⟨ k , ⟨ j , ccom F j ⟩ ⟩ ⟩ ∧ k ∊ B ∧ j ∊ fseq (cdm F))} $ by cab_congr [l19]

