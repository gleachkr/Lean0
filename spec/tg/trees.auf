u9: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ fv (trc l F) ⟨ k , s ⟩ = fv F ⟨ k , ⟨ s , ccom (trc l F) s ⟩ ⟩ $ by trc_node [u8, u4, u5]
u10: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ functional h $ by weaken [#2]
u11: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ functional (trc l F) $ by trc_functional [u8]
u12: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ crn s ⊆ trees l $ by fseq_crn [u5]
u13: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ cdm h = trees l $ by weaken [#4]
u14: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ trees l = cdm h $ by eq_sym [u13]
u15: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ crn s ⊆ cdm h $ by subset_eq_r [u14, u12]
u16: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ cdm (trc l F) = trees l $ by trc_cdm [u8]
u17: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ trees l = cdm (trc l F) $ by eq_sym [u16]
u18: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} ⇒ crn s ⊆ cdm (trc l F) $ by subset_eq_r [u17, u12]
u19: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} , y ∊ crn s ⇒ crn s ⊆ {z | fv h z = fv (trc l F) z} $ by ax
u20: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} , y ∊ crn s ⇒ y ∊ crn s $ by ax
u21: $ G , k ∊ l , s ∊ fseq (trees l) , crn s ⊆ {z | fv h z = fv (trc l F) z} , y ∊ crn s ⇒ y ∊ {z | fv h z = fv (trc l F) z} $ by subset_elim [u19, u20]
