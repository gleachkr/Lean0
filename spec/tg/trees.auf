l1: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by ax
l2: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , y ⟩ ∈ cgr3 k s v B $ by cgr3_intro [l1]
l3: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ w = ⟨ a , ⟨ b , c ⟩ ⟩ $ by ax
l4: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ ⟨ a , ⟨ b , c ⟩ ⟩ = w $ by eq_sym [l3]
l5: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ y = y $ by eq_refl
l6: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ ⟨ ⟨ a , ⟨ b , c ⟩ ⟩ , y ⟩ = ⟨ w , y ⟩ $ by opair_eq [l4, l5]
l7: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ ⟨ w , y ⟩ ∈ cgr3 k s v B $ by wcel_eq_l [l6, l2]
l8: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ functional (cgr3 k s v B) $ by cgr3_functional
l9: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ fv (cgr3 k s v B) w = y $ by fv_val [l8, l7]
l10: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ cgr3 k s v B = cgr3 k s v B $ by eq_refl
l11: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ fv (cgr3 k s v B) ⟨ a , ⟨ b , c ⟩ ⟩ = fv (cgr3 k s v B) w $ by fv_eq [l10, l4]
l12: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ fv (cgr3 k s v B) ⟨ a , ⟨ b , c ⟩ ⟩ = y $ by eq_trans [l11, l9]
l13: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) , w = ⟨ a , ⟨ b , c ⟩ ⟩ ⇒ fv (cgr3 k s v B) ⟨ a , ⟨ b , c ⟩ ⟩ = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by eq_trans [l12, l1]
m1: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) ⇒ isset a $ by isset_var
m2: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) ⇒ isset b $ by isset_var
m3: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) ⇒ isset c $ by isset_var
m4: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) ⇒ isset ⟨ b , c ⟩ $ by opair_set [m2, m3]
m5: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) ⇒ isset ⟨ a , ⟨ b , c ⟩ ⟩ $ by opair_set [m1, m4]
m6: $ G , y = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) ⇒ fv (cgr3 k s v B) ⟨ a , ⟨ b , c ⟩ ⟩ = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by isset_elim [m5, l13]
m7: $ G ⇒ fv (cgr3 k s v B) ⟨ a , ⟨ b , c ⟩ ⟩ = (⟦ k / a ⟧ (⟦ s / b ⟧ (⟦ v / c ⟧ B))) $ by isset_elim [#1, m6]

cgr3_congr
----------
l0: $ y ≐ y $ by ceqt_refl
l1: $ (y = B) ⟺ (y = D) $ by ceq_congr [l0, #1]
l2: $ (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩) ⟺ (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩) $ by iff_refl
l3: $ (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B) ⟺ (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = D) $ by and_congr [l2, l1]
l4: $ (∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ (∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = D)) $ by ex_congr [l3]
l5: $ (∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ (∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = D)) $ by ex_congr [l4]
l6: $ (∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ (∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = D)) $ by ex_congr [l5]
l7: $ (∃ k ∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)) ⟺ (∃ k ∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = D)) $ by ex_congr [l6]
l8: $ {w | ∃ k ∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = B)} ≐ {w | ∃ k ∃ s ∃ v ∃ y (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , y ⟩ ∧ y = D)} $ by cab_congr [l7]

sb_c_cgr3
---------
l1: $ (⟦ y / t ⟧ {w | ∃ k ∃ s ∃ v ∃ x (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , x ⟩ ∧ x = B)}) ≐ {w | ∃ k ∃ s ∃ v ∃ x (w = ⟨ ⟨ k , ⟨ s , v ⟩ ⟩ , x ⟩ ∧ x = (⟦ y / t ⟧ B))} $ by ceqt_refl

trees_congr
-----------
l1: $ fseq x ≐ fseq x $ by ceqt_refl
l2: $ (A × fseq x) ≐ (B × fseq x) $ by cxp_congr [#1, l1]
l3: $ lfp x (A × fseq x) ≐ lfp x (B × fseq x) $ by lfp_congr [l2]

--| The operator of `trees` at equal label classes, elementwise.
lemma t1_cap_cxp_sub {x: set} (G: hyps) (A B C: class) (y: set):
  $ G ⇒ A = B $ > $ G , y ∊ cap x (A × fseq x) C ⇒ y ∊ cap x (B × fseq x) C $
----
c1: $ G , y ∊ cap x (A × fseq x) C ⇒ y ∊ cap x (A × fseq x) C $ by ax
c2: $ G , y ∊ cap x (A × fseq x) C ⇒ isset C $ by cap_elim_isset [c1]
c3: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ u = C $ by ax
c4: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ cap x (A × fseq x) C = A × fseq u $ by cap_eq [c3]
c5: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ y ∊ cap x (A × fseq x) C $ by ax
c6: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ y ∊ A × fseq u $ by welc_eq [c4, c5]
c7: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ A = B $ by weaken [#1]
c8: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ fseq u = fseq u $ by eq_refl
c9: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ A × fseq u = B × fseq u $ by cxp_eq [c7, c8]
c10: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ y ∊ B × fseq u $ by welc_eq [c9, c6]
c11: $ G , y ∊ cap x (A × fseq x) C , u = C ⇒ y ∊ cap x (B × fseq x) C $ by cap_intro (x := $ x $, B := $ B × fseq x $, C := $ C $, a := $ u $, b := $ y $) [c3, c10]
c12: $ G , y ∊ cap x (A × fseq x) C ⇒ y ∊ cap x (B × fseq x) C $ by isset_elim [c2, c11]

lemma t1_cap_cxp_eq {x: set} (G: hyps) (A B C: class):
  $ G ⇒ A = B $ > $ G ⇒ cap x (A × fseq x) C = cap x (B × fseq x) C $
----
d1: $ G , y ∊ cap x (A × fseq x) C ⇒ y ∊ cap x (B × fseq x) C $ by t1_cap_cxp_sub [#1]
d2: $ G ⇒ B = A $ by eq_sym [#1]
d3: $ G , y ∊ cap x (B × fseq x) C ⇒ y ∊ cap x (A × fseq x) C $ by t1_cap_cxp_sub [d2]
d4: $ G ⇒ cap x (A × fseq x) C = cap x (B × fseq x) C $ by eq_intro [d1, d3]

--| `trees` at equal label classes, elementwise.
lemma t1_trees_sub (G: hyps) (A B: class) (y: set):
  $ G ⇒ A = B $ > $ G , y ∊ trees A ⇒ y ∊ trees B $
----
s1: $ G ⇒ cap x (A × fseq x) (⋃ (crn g)) = cap x (B × fseq x) (⋃ (crn g)) $ by t1_cap_cxp_eq [#1]
s2: $ G ⇒ ∀ g (cap x (A × fseq x) (⋃ (crn g)) = cap x (B × fseq x) (⋃ (crn g))) $ by all_intro [s1]
s3: $ G ⇒ cgr g (cap x (A × fseq x) (⋃ (crn g))) = cgr g (cap x (B × fseq x) (⋃ (crn g))) $ by cgr_eq [s2]
s6: $ G ⇒ trec (cgr g (cap x (A × fseq x) (⋃ (crn g)))) = trec (cgr g (cap x (B × fseq x) (⋃ (crn g)))) $ by trec_eq_cong [s3]
t1: $ G , y ∊ lfp x (A × fseq x) ⇒ y ∊ lfp x (A × fseq x) $ by ax
t2: $ G , y ∊ lfp x (A × fseq x) ⇒ ∃ a (ord a ∧ y ∊ fv (stg x (A × fseq x)) a) $ by lfp_elim [t1]
t3: $ G , ord a ∧ y ∊ fv (stg x (A × fseq x)) a ⇒ ord a ∧ y ∊ fv (stg x (A × fseq x)) a $ by ax
t4: $ G , ord a ∧ y ∊ fv (stg x (A × fseq x)) a ⇒ ord a $ by and_elim_l [t3]
t5: $ G , ord a ∧ y ∊ fv (stg x (A × fseq x)) a ⇒ y ∊ fv (stg x (A × fseq x)) a $ by and_elim_r [t3]
t6: $ G , ord a ∧ y ∊ fv (stg x (A × fseq x)) a ⇒ stg x (A × fseq x) = stg x (B × fseq x) $ by weaken [s6]
t7: $ G , ord a ∧ y ∊ fv (stg x (A × fseq x)) a ⇒ a = a $ by eq_refl
t8: $ G , ord a ∧ y ∊ fv (stg x (A × fseq x)) a ⇒ fv (stg x (A × fseq x)) a = fv (stg x (B × fseq x)) a $ by fv_eq [t6, t7]
t9: $ G , ord a ∧ y ∊ fv (stg x (A × fseq x)) a ⇒ y ∊ fv (stg x (B × fseq x)) a $ by welc_eq [t8, t5]
t10: $ G , ord a ∧ y ∊ fv (stg x (A × fseq x)) a ⇒ y ∊ lfp x (B × fseq x) $ by lfp_intro [t4, t9]
t11: $ G , y ∊ lfp x (A × fseq x) ⇒ y ∊ lfp x (B × fseq x) $ by ex_elim [t2, t10]

trees_eq
--------
l1: $ G , y ∊ trees A ⇒ y ∊ trees B $ by t1_trees_sub [#1]
l2: $ G ⇒ B = A $ by eq_sym [#1]
l3: $ G , y ∊ trees B ⇒ y ∊ trees A $ by t1_trees_sub [l2]
l4: $ G ⇒ trees A = trees B $ by eq_intro [l1, l3]

sb_c_trees
----------
l1: $ (⟦ x / t ⟧ (lfp y (A × fseq y))) ≐ lfp y ((⟦ x / t ⟧ A) × fseq y) $ by ceqt_refl

trees_op_mono
-------------
l1: $ G , u ⊆ v ⇒ u ⊆ v $ by ax
l2: $ G , u ⊆ v ⇒ fseq u ⊆ fseq v $ by fseq_mono [l1]
l3: $ G , u ⊆ v ⇒ l ⊆ l $ by subset_refl
l4: $ G , u ⊆ v ⇒ l × fseq u ⊆ l × fseq v $ by cxp_mono [l3, l2]
l5: $ G ⇒ mono x (l × fseq x) $ by mono_intro (x := $ x $, u := $ u $, v := $ v $, B := $ l × fseq x $) [l4]

trees_op_setop
--------------
l1: $ _ ⇒ isset l $ by isset_var
l2: $ _ ⇒ isset x $ by isset_var
l3: $ _ ⇒ isset (fseq x) $ by fseq_set [l2]
l4: $ _ ⇒ isset (l × fseq x) $ by cxp_set [l1, l3]
l5: $ _ ⇒ setop x (l × fseq x) $ by setop_intro (x := $ x $, B := $ l × fseq x $) [l4]
l6: $ G ⇒ setop x (l × fseq x) $ by weaken [l5]

trees_op_cont
-------------
k1: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ j ∊ fseq u $ by ax
k2: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ functional j $ by fseq_functional [k1]
k3: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ rel j $ by fseq_rel [k1]
k4: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ cdm j ∈ ω $ by fseq_len [k1]
k5: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ crn j ⊆ u $ by fseq_crn [k1]
k6: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = cdm j , w ∊ ω ⇒ w ∊ ω $ by ax
k7: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = cdm j , w ∊ ω ⇒ w ⊆ ω $ by omega_elem_subset [k6]
k8: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = cdm j , w ∊ ω ⇒ w = cdm j $ by ax
k9: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = cdm j , w ∊ ω ⇒ cdm j ⊆ ω $ by subset_eq_l [k8, k7]
k10: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ cdm j ⊆ ω $ by wcel_elim [k4, k9]
k11: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ isset j $ by isset_var
k12: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ isset (crn j) $ by crn_set [k11]
k13: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ w = crn j $ by ax
k14: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ crn j = w $ by eq_sym [k13]
k15: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ crn j ⊆ w $ by eq_subset [k14]
k16: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ functional j $ by weaken [k2]
k17: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ rel j $ by weaken [k3]
k18: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ cdm j ∈ ω $ by weaken [k4]
k19: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ j ∊ fseq w $ by fseq_of_fn [k16, k17, k18, k15]
k20: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ z = ⟨ i , j ⟩ $ by ax
k21: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ i ∊ l $ by ax
k22: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ z ∊ l × fseq w $ by cxp_intro_eq [k20, k21, k19]
k23: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u , w = crn j ⇒ z ∊ cap x (l × fseq x) (crn j) $ by cap_intro (x := $ x $, B := $ l × fseq x $, C := $ crn j $, a := $ w $, b := $ z $) [k13, k22]
k24: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ z ∊ cap x (l × fseq x) (crn j) $ by isset_elim [k12, k23]
k25: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ crn j ⊆ u ∧ z ∊ cap x (l × fseq x) (crn j) $ by and_intro [k5, k24]
k26: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ cdm j ⊆ ω ∧ crn j ⊆ u ∧ z ∊ cap x (l × fseq x) (crn j) $ by and_intro [k10, k25]
k27: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ functional j ∧ cdm j ⊆ ω ∧ crn j ⊆ u ∧ z ∊ cap x (l × fseq x) (crn j) $ by and_intro [k2, k26]
k28: $ G , z = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq u ⇒ ∃ f (functional f ∧ cdm f ⊆ ω ∧ crn f ⊆ u ∧ z ∊ cap x (l × fseq x) (crn f)) $ by ex_intro (x := $ f $, t := $ j $, p := $ functional f ∧ cdm f ⊆ ω ∧ crn f ⊆ u ∧ z ∊ cap x (l × fseq x) (crn f) $) [k27]
l1: $ G , z ∊ l × fseq u ⇒ z ∊ l × fseq u $ by ax
l2: $ G , z ∊ l × fseq u ⇒ ∃ f (functional f ∧ cdm f ⊆ ω ∧ crn f ⊆ u ∧ z ∊ cap x (l × fseq x) (crn f)) $ by cxp_elim [l1, k28]
l3: $ G ⇒ cont x (l × fseq x) ω $ by cont_intro (x := $ x $, u := $ u $, z := $ z $, f := $ f $, B := $ l × fseq x $, A := $ ω $) [l2]

trees_fix
---------
f1: $ G , w = ω ⇒ mono x (l × fseq x) $ by trees_op_mono
f2: $ G , w = ω ⇒ setop x (l × fseq x) $ by trees_op_setop
f3: $ G , w = ω ⇒ cont x (l × fseq x) ω $ by trees_op_cont
f4: $ G ⇒ isset ω $ by omega_set
f5: $ G , w = ω ⇒ w = ω $ by ax
f6: $ G , w = ω ⇒ ω = w $ by eq_sym [f5]
f7: $ G , w = ω ⇒ ω ⊆ w $ by eq_subset [f6]
f8: $ G , w = ω ⇒ cont x (l × fseq x) w $ by cont_mono_index [f3, f7]
f9: $ G , w = ω ⇒ cap x (l × fseq x) (trees l) = trees l $ by lfp_cont_fix [f1, f2, f8]
f10: $ G , w = ω ⇒ isset (trees l) $ by lfp_cont_set [f1, f2, f8]
g1: $ G , w = ω , a = trees l ⇒ a = trees l $ by ax
g2: $ G , w = ω , a = trees l ⇒ cap x (l × fseq x) (trees l) = l × fseq a $ by cap_eq [g1]
g3: $ G , w = ω , a = trees l ⇒ l × fseq a = cap x (l × fseq x) (trees l) $ by eq_sym [g2]
g4: $ G , w = ω , a = trees l ⇒ cap x (l × fseq x) (trees l) = trees l $ by weaken [f9]
g5: $ G , w = ω , a = trees l ⇒ l × fseq a = trees l $ by eq_trans [g3, g4]
g6: $ G , w = ω , a = trees l ⇒ trees l = a $ by eq_sym [g1]
g7: $ G , w = ω , a = trees l ⇒ fseq (trees l) = fseq a $ by fseq_eq [g6]
g8: $ G , w = ω , a = trees l ⇒ l = l $ by eq_refl
g9: $ G , w = ω , a = trees l ⇒ l × fseq (trees l) = l × fseq a $ by cxp_eq [g8, g7]
g10: $ G , w = ω , a = trees l ⇒ l × fseq (trees l) = trees l $ by eq_trans [g9, g5]
g11: $ G , w = ω ⇒ l × fseq (trees l) = trees l $ by isset_elim [f10, g10]
g12: $ G ⇒ l × fseq (trees l) = trees l $ by isset_elim [f4, g11]

trees_intro
-----------
l1: $ G ⇒ ⟨ k , s ⟩ ∈ l × fseq (trees l) $ by cxp_intro [#1, #2]
l2: $ G ⇒ l × fseq (trees l) = trees l $ by trees_fix
l3: $ G ⇒ ⟨ k , s ⟩ ∈ trees l $ by wcel_eq_r [l2, l1]

trees_elim
----------
l1: $ G ⇒ l × fseq (trees l) = trees l $ by trees_fix
l2: $ G ⇒ trees l = l × fseq (trees l) $ by eq_sym [l1]
l3: $ G ⇒ t ∊ l × fseq (trees l) $ by welc_eq [l2, #1]
k1: $ G , t = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq (trees l) ⇒ t = ⟨ i , j ⟩ $ by ax
k2: $ G , t = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq (trees l) ⇒ i ∊ l $ by ax
k3: $ G , t = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq (trees l) ⇒ j ∊ fseq (trees l) $ by ax
k4: $ G , t = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq (trees l) ⇒ j ∊ fseq (trees l) ∧ t = ⟨ i , j ⟩ $ by and_intro [k3, k1]
k5: $ G , t = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq (trees l) ⇒ i ∊ l ∧ j ∊ fseq (trees l) ∧ t = ⟨ i , j ⟩ $ by and_intro [k2, k4]
k6: $ G , t = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq (trees l) ⇒ ∃ s (i ∊ l ∧ s ∊ fseq (trees l) ∧ t = ⟨ i , s ⟩) $ by ex_intro (x := $ s $, t := $ j $, p := $ i ∊ l ∧ s ∊ fseq (trees l) ∧ t = ⟨ i , s ⟩ $) [k5]
k7: $ G , t = ⟨ i , j ⟩ , i ∊ l , j ∊ fseq (trees l) ⇒ ∃ k ∃ s (k ∊ l ∧ s ∊ fseq (trees l) ∧ t = ⟨ k , s ⟩) $ by ex_intro (x := $ k $, t := $ i $, p := $ ∃ s (k ∊ l ∧ s ∊ fseq (trees l) ∧ t = ⟨ k , s ⟩) $) [k6]
l4: $ G ⇒ ∃ k ∃ s (k ∊ l ∧ s ∊ fseq (trees l) ∧ t = ⟨ k , s ⟩) $ by cxp_elim [l3, k7]

