sb_c_lprog3
-----------
l1: $ (⟦ x / t ⟧ ((((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J)))))) ∩ ((fseq latoms) × latoms))) ≐ (((((pr_sty (⟦ x / t ⟧ J)) ∪ ((pr_cwf (⟦ x / t ⟧ J)) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf (⟦ x / t ⟧ J))) ∪ ((pr_tys_ty (⟦ x / t ⟧ J)) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir (⟦ x / t ⟧ J))) ∪ (pr_elim_ok ∪ (pr_fprops (⟦ x / t ⟧ J)))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs (⟦ x / t ⟧ J)) ∪ (pr_pred_eqs (⟦ x / t ⟧ J)))) ∪ (((pr_sub_eqs (⟦ x / t ⟧ J)) ∪ (pr_mul_eqs (⟦ x / t ⟧ J))) ∪ ((pr_pow_eqs (⟦ x / t ⟧ J)) ∪ (pr_beq_eqs (⟦ x / t ⟧ J))))) ∪ ((((pr_ble_eqs (⟦ x / t ⟧ J)) ∪ (pr_shl_eqs (⟦ x / t ⟧ J))) ∪ ((pr_shr_eqs (⟦ x / t ⟧ J)) ∪ (pr_divmod_eqs (⟦ x / t ⟧ J)))) ∪ (((pr_gcd_eqs (⟦ x / t ⟧ J)) ∪ (pr_land_eqs (⟦ x / t ⟧ J))) ∪ ((pr_lor_eqs (⟦ x / t ⟧ J)) ∪ (pr_xor_eqs (⟦ x / t ⟧ J))))))) ∩ ((fseq latoms) × latoms) $ by ceqt_refl

lrel3_congr
-----------
l1: $ horn (lprog3 J) ≐ horn (lprog3 J2) $ by horn_congr [lprog3_congr [#1]]

sb_c_lrel3
----------
l1: $ (⟦ x / t ⟧ (horn (lprog3 J))) ≐ horn (lprog3 (⟦ x / t ⟧ J)) $ by ceqt_refl

lemma a1_bi_refl (G: hyps) (p: fml): $ G ⇒ p ↔ p $
----
l1: $ G , p ⇒ p $ by ax
l2: $ G ⇒ p ↔ p $ by bi_intro [l1, l1]

lemma a1_and_bi (G: hyps) (p q r s: fml): $ G ⇒ p ↔ q $ > $ G ⇒ r ↔ s $ > $ G ⇒ (p ∧ r) ↔ (q ∧ s) $
----
l1: $ G , p ∧ r ⇒ p ∧ r $ by ax
l2: $ G , p ∧ r ⇒ p $ by and_elim_l [l1]
l3: $ G , p ∧ r ⇒ r $ by and_elim_r [l1]
l4: $ G , p ∧ r ⇒ p ↔ q $ by weaken [#1]
l5: $ G , p ∧ r ⇒ r ↔ s $ by weaken [#2]
l6: $ G , p ∧ r ⇒ q $ by bi_elim_l [l4, l2]
l7: $ G , p ∧ r ⇒ s $ by bi_elim_l [l5, l3]
l8: $ G , p ∧ r ⇒ q ∧ s $ by and_intro [l6, l7]
l9: $ G , q ∧ s ⇒ q ∧ s $ by ax
l10: $ G , q ∧ s ⇒ q $ by and_elim_l [l9]
l11: $ G , q ∧ s ⇒ s $ by and_elim_r [l9]
l12: $ G , q ∧ s ⇒ p ↔ q $ by weaken [#1]
l13: $ G , q ∧ s ⇒ r ↔ s $ by weaken [#2]
l14: $ G , q ∧ s ⇒ p $ by bi_elim_r [l12, l10]
l15: $ G , q ∧ s ⇒ r $ by bi_elim_r [l13, l11]
l16: $ G , q ∧ s ⇒ p ∧ r $ by and_intro [l14, l15]
l17: $ G ⇒ (p ∧ r) ↔ (q ∧ s) $ by bi_intro [l8, l16]

lemma a1_ex_bi {x: set} (G: hyps) (p q: fml x): $ G ⇒ ∀ x (p ↔ q) $ > $ G ⇒ (∃ x p) ↔ (∃ x q) $
----
l1: $ G , ∃ x p ⇒ ∃ x p $ by ax
l2: $ ∃ x p ⟺ ∃ z [x/z] p $ by ex_alpha
l3: $ G , ∃ x p ⇒ ∃ x p ↔ ∃ z [x/z] p $ by weaken [l2]
l4: $ G , ∃ x p ⇒ ∃ z [x/z] p $ by bi_elim_l [l3, l1]
l5: $ G ⇒ [x/z] p ↔ [x/z] q $ by all_elim [#1]
l6: $ G , [x/z] p ⇒ [x/z] p ↔ [x/z] q $ by weaken [l5]
l7: $ G , [x/z] p ⇒ [x/z] p $ by ax
l8: $ G , [x/z] p ⇒ [x/z] q $ by bi_elim_l [l6, l7]
l9: $ G , [x/z] p ⇒ ∃ x q $ by ex_intro [l8]
l10: $ G , ∃ x p ⇒ ∃ x q $ by ex_elim [l4, l9]
l11: $ G , ∃ x q ⇒ ∃ x q $ by ax
l12: $ ∃ x q ⟺ ∃ z [x/z] q $ by ex_alpha
l13: $ G , ∃ x q ⇒ ∃ x q ↔ ∃ z [x/z] q $ by weaken [l12]
l14: $ G , ∃ x q ⇒ ∃ z [x/z] q $ by bi_elim_l [l13, l11]
l15: $ G , [x/z] q ⇒ [x/z] p ↔ [x/z] q $ by weaken [l5]
l16: $ G , [x/z] q ⇒ [x/z] q $ by ax
l17: $ G , [x/z] q ⇒ [x/z] p $ by bi_elim_r [l15, l16]
l18: $ G , [x/z] q ⇒ ∃ x p $ by ex_intro [l17]
l19: $ G , ∃ x q ⇒ ∃ x p $ by ex_elim [l14, l18]
l20: $ G ⇒ (∃ x p) ↔ (∃ x q) $ by bi_intro [l10, l19]

lemma a1_wcel_bi (G: hyps) (A B C: class): $ G ⇒ A = B $ > $ G ⇒ (C ∈ A) ↔ (C ∈ B) $
----
l1: $ G , C ∈ A ⇒ C ∈ A $ by ax
l2: $ G , C ∈ A ⇒ A = B $ by weaken [#1]
l3: $ G , C ∈ A ⇒ C ∈ B $ by wcel_eq_r [l2, l1]
l4: $ G , C ∈ B ⇒ C ∈ B $ by ax
l5: $ G ⇒ B = A $ by eq_sym [#1]
l6: $ G , C ∈ B ⇒ B = A $ by weaken [l5]
l7: $ G , C ∈ B ⇒ C ∈ A $ by wcel_eq_r [l6, l4]
l8: $ G ⇒ (C ∈ A) ↔ (C ∈ B) $ by bi_intro [l3, l7]

