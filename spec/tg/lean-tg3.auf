tys_ty_cons_j
-------------
l1: $ _ ⇒ enc_ctx Ctx ∈ trees ω $ by enc_ctx_trees
l2: $ _ ⇒ enc_expr F ∈ trees ω $ by enc_expr_trees
l3: $ _ ⇒ enc_ctors C ∈ trees ω $ by enc_ctors_trees
l4: $ _ ⇒ enc_tys T ∈ trees ω $ by enc_tys_trees
l5: $ _ ⇒ enc_lvl u ∈ trees ω $ by enc_lvl_trees
l6: $ _ ⇒ enc_tys (tcons F C T) = ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ $ by eq_refl
l7: $ _ ⇒ enc_tys (tcons F C T) ∈ trees ω $ by enc_tys_trees
l8: $ _ ⇒ ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ ∈ trees ω $ by wcel_eq_l [l6, l7]
l9: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l10: $ _ ⇒ enc_expr F = enc_expr F $ by eq_refl
l11: $ _ ⇒ enc_expr (srt u) = ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ $ by eq_refl
l12: $ _ ⇒ ra_deq (enc_ctx Ctx) (enc_expr F) (enc_expr F) (enc_expr (srt u)) = ra_deq (enc_ctx Ctx) (enc_expr F) (enc_expr F) ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ $ by ra_deq_eq [l9, l10, l10, l11]
l13: $ _ ⇒ ra_deq (enc_ctx Ctx) (enc_expr F) (enc_expr F) ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ ∈ J $ by wcel_eq_l [l12, #1]
l14: $ _ ⇒ ra_tys_ty (enc_ctx Ctx) ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ ∈ lrel3 J $ by j1_c_tys_ty_cons [l1, l2, l3, l4, l5, l8, #2, l13]
l15: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l16: $ _ ⇒ ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ = enc_tys (tcons F C T) $ by eq_refl
l17: $ _ ⇒ ra_tys_ty (enc_ctx Ctx) ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ = ra_tys_ty (enc_ctx Ctx) (enc_tys (tcons F C T)) $ by ra_tys_ty_eq [l15, l16]
l18: $ tys_ty_j J Ctx (tcons F C T) $ by wcel_eq_l [l17, l14]

lemma j1_pr_tys_ok (G: hyps) (J X: class): $ G ⇒ X ∈ pr_tys_ok $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ pr_tys_ok ∪ pr_ind_wf $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf)) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ ((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J))))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j1_in_l [l4]

lemma j1_ra_tys_ok (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_tys_ok A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_tys_ok ∈ ω $ by kr_tys_ok_omega
l5: $ G ⇒ ra_tys_ok A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lemma j1_c_tys_ok_i (G: hyps) (J A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_ctx_wf A1 A5 ∈ lrel3 J $ >
  $ G ⇒ ra_tys_ty A2 A6 ∈ lrel3 J $ >
  $ G ⇒ ra_ind_data A3 A4 A5 A6 ∈ lrel $ >
  $ G ⇒ ra_capp A5 A1 A2 ∈ lrel $ >
  $ G ⇒ ra_tys_ok A1 A3 ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ v = A4 $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ w = A5 $ by ax
l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ a = A6 $ by ax
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ ra_ind_data A3 A4 A5 A6 ∈ lrel $ by weaken [#9]
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ ra_ind_data u v w a = ra_ind_data A3 A4 A5 A6 $ by ra_ind_data_eq [l3, l4, l5, l6]
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ ra_ind_data A3 A4 A5 A6 = ra_ind_data u v w a $ by eq_sym [l8]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ ra_ind_data u v w a ∈ lrel $ by wcel_eq_l [l9, l7]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ ra_capp A5 A1 A2 ∈ lrel $ by weaken [#10]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ ra_capp w y z = ra_capp A5 A1 A2 $ by ra_capp_eq [l5, l1, l2]
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ ra_capp A5 A1 A2 = ra_capp w y z $ by eq_sym [l12]
