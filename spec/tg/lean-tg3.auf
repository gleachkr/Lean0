lemma j1_pr_shr_eqs (G: hyps) (J X: class): $ G ⇒ X ∈ pr_shr_eqs J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_shr_eqs J) ∪ (pr_divmod_eqs J) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J)) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))) $ by j1_in_l [l2]
l4: $ G ⇒ X ∈ ((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J)))) $ by j1_in_r [l3]
l5: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_r [l4]

lemma j1_ra_shr_eqs (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_shr_eqs A1 A2 A3 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A3 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#3, l1]
l3: $ G ⇒ scons A2 (scons A3 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l2]
l4: $ G ⇒ scons A1 (scons A2 (scons A3 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l3]
l5: $ G ⇒ kr_shr_eqs ∈ ω $ by kr_shr_eqs_omega
l6: $ G ⇒ ra_shr_eqs A1 A2 A3 ∈ latoms $ by cxp_intro_c [l5, l4]

lrel3_shr_eqs_i
---------------
l1: $ G , y = A1 , z = A2 , u = A3 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A2 ∈ lrel $ by weaken [#4]
l5: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l6: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ z = ra_closed ⟨ kc_nz , ∅ ⟩ A2 $ by ra_closed_eq [l5, l2]
l7: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A2 = ra_closed ⟨ kc_nz , ∅ ⟩ z $ by eq_sym [l6]
l8: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel $ by wcel_eq_l [l7, l4]
l9: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A3 ∈ lrel $ by weaken [#5]
l10: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ u = ra_closed ⟨ kc_nz , ∅ ⟩ A3 $ by ra_closed_eq [l5, l3]
l11: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A3 = ra_closed ⟨ kc_nz , ∅ ⟩ u $ by eq_sym [l10]
