l88: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_xor_eqs J $ by bot_elim [l87]
l89: $ G ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_xor_eqs J $ by or_elim [l76, l88, l77]

-- Conjunctions and nested existentials, in one step.

--| A conjunction of 3 formulas.
lemma j2_and2 (G: hyps) (p1 p2 q: fml):
  $ G ⇒ p1 $ > $ G ⇒ p2 $ > $ G ⇒ q $ >
  $ G ⇒ p1 ∧ p2 ∧ q $
----
l1: $ G ⇒ p2 ∧ q $ by and_intro [#2, #3]
l2: $ G ⇒ p1 ∧ p2 ∧ q $ by and_intro [#1, l1]

--| A conjunction of 4 formulas.
lemma j2_and3 (G: hyps) (p1 p2 p3 q: fml):
