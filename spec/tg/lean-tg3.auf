sty_app_j
---------
l1: $ _ ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
l2: $ _ ⇒ enc_expr h ∈ trees ω $ by enc_expr_trees
l3: $ _ ⇒ enc_expr A ∈ trees ω $ by enc_expr_trees
l4: $ _ ⇒ enc_expr f ∈ trees ω $ by enc_expr_trees
l5: $ _ ⇒ enc_expr a ∈ trees ω $ by enc_expr_trees
l6: $ _ ⇒ enc_expr B ∈ trees ω $ by enc_expr_trees
l7: $ _ ⇒ enc_expr C ∈ trees ω $ by enc_expr_trees
l8: $ _ ⇒ enc_expr C2 ∈ trees ω $ by enc_expr_trees
l9: $ _ ⇒ enc_expr (app f a) = ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ $ by eq_refl
l10: $ _ ⇒ enc_expr (app f a) ∈ trees ω $ by enc_expr_trees
l11: $ _ ⇒ ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ ∈ trees ω $ by wcel_eq_l [l9, l10]
l12: $ _ ⇒ enc_ctx G = enc_ctx G $ by eq_refl
l13: $ _ ⇒ enc_expr h = enc_expr h $ by eq_refl
l14: $ _ ⇒ enc_expr A = enc_expr A $ by eq_refl
l15: $ _ ⇒ enc_expr f = enc_expr f $ by eq_refl
l16: $ _ ⇒ enc_expr (pi B C) = ⟨ kc_pi , scons (enc_expr B) (scons (enc_expr C) ∅) ⟩ $ by eq_refl
l17: $ _ ⇒ ra_sty (enc_ctx G) (enc_expr h) (enc_expr A) (enc_expr f) (enc_expr (pi B C)) = ra_sty (enc_ctx G) (enc_expr h) (enc_expr A) (enc_expr f) ⟨ kc_pi , scons (enc_expr B) (scons (enc_expr C) ∅) ⟩ $ by ra_sty_eq [l12, l13, l14, l15, l16]
l18: $ _ ⇒ ra_sty (enc_ctx G) (enc_expr h) (enc_expr A) (enc_expr f) ⟨ kc_pi , scons (enc_expr B) (scons (enc_expr C) ∅) ⟩ ∈ lrel3 J $ by wcel_eq_l [l17, #1]
l19: $ _ ⇒ enc_nat nz = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l20: $ _ ⇒ enc_expr C = enc_expr C $ by eq_refl
l21: $ _ ⇒ enc_expr a = enc_expr a $ by eq_refl
l22: $ _ ⇒ enc_expr C2 = enc_expr C2 $ by eq_refl
l23: $ _ ⇒ ra_inst (enc_nat nz) (enc_expr C) (enc_expr a) (enc_expr C2) = ra_inst ⟨ kc_nz , ∅ ⟩ (enc_expr C) (enc_expr a) (enc_expr C2) $ by ra_inst_eq [l19, l20, l21, l22]
l24: $ _ ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ (enc_expr C) (enc_expr a) (enc_expr C2) ∈ lrel $ by wcel_eq_l [l23, #3]
l25: $ _ ⇒ ra_sty (enc_ctx G) (enc_expr h) (enc_expr A) ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ (enc_expr C2) ∈ lrel3 J $ by j1_c_sty_app [l1, l2, l3, l4, l5, l6, l7, l8, l11, l18, #2, l24]
l26: $ _ ⇒ enc_ctx G = enc_ctx G $ by eq_refl
l27: $ _ ⇒ enc_expr h = enc_expr h $ by eq_refl
l28: $ _ ⇒ enc_expr A = enc_expr A $ by eq_refl
l29: $ _ ⇒ ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ = enc_expr (app f a) $ by eq_refl
l30: $ _ ⇒ enc_expr C2 = enc_expr C2 $ by eq_refl
l31: $ _ ⇒ ra_sty (enc_ctx G) (enc_expr h) (enc_expr A) ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ (enc_expr C2) = ra_sty (enc_ctx G) (enc_expr h) (enc_expr A) (enc_expr (app f a)) (enc_expr C2) $ by ra_sty_eq [l26, l27, l28, l29, l30]
l32: $ sty_j J G h A (app f a) C2 $ by wcel_eq_l [l31, l25]

lemma j1_pr_cwf (G: hyps) (J X: class): $ G ⇒ X ∈ pr_cwf J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_sty J) ∪ (pr_cwf J) $ by j1_in_r [#1]
l2: $ G ⇒ X ∈ ((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ (((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf)) $ by j1_in_l [l2]
l4: $ G ⇒ X ∈ ((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J))))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j1_in_l [l4]

lemma j1_ra_cwf (G: hyps) (A1 A2 A3 A4 A5 A6 A7 A8: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ > $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A8 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#8, l1]
l3: $ G ⇒ scons A7 (scons A8 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#7, l2]
l4: $ G ⇒ scons A6 (scons A7 (scons A8 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#6, l3]
l5: $ G ⇒ scons A5 (scons A6 (scons A7 (scons A8 ∅))) ∈ fseq (trees ω) $ by scons_fseq_c [#5, l4]
l6: $ G ⇒ scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅)))) ∈ fseq (trees ω) $ by scons_fseq_c [#4, l5]
l7: $ G ⇒ scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅))))) ∈ fseq (trees ω) $ by scons_fseq_c [#3, l6]
l8: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅)))))) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l7]
l9: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅))))))) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l8]
l10: $ G ⇒ kr_cwf ∈ ω $ by kr_cwf_omega
l11: $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ∈ latoms $ by cxp_intro_c [l10, l9]

lemma j1_c_cwf_pi (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ A7 ∈ trees ω $ >
  $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ >
  $ G ⇒ A10 ∈ trees ω $ >
  $ G ⇒ A11 ∈ trees ω $ >
  $ G ⇒ A12 ∈ trees ω $ >
  $ G ⇒ ⟨ kc_pi , scons A9 (scons A10 ∅) ⟩ ∈ trees ω $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 ⟨ kc_cons , scons A11 (scons A6 ∅) ⟩ ⟨ kc_s , scons A7 ∅ ⟩ A10 ∈ lrel3 J $ >
  $ G ⇒ ra_add A7 A3 A8 ∈ lrel $ >
  $ G ⇒ ra_sinst A1 ⟨ kc_nz , ∅ ⟩ A2 A8 A9 A11 ∈ lrel $ >
  $ G ⇒ ra_deq A6 A11 A11 ⟨ kc_srt , scons A12 ∅ ⟩ ∈ J $ >
  $ G ⇒ ra_ulevel A4 A12 ∈ lrel2 $ >
  $ G ⇒ ra_ipos A1 A2 A3 A7 A9 ∈ lrel $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 ⟨ kc_pi , scons A9 (scons A10 ∅) ⟩ ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 , i = A11 , j = A12 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 , i = A11 , j = A12 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 , i = A11 , j = A12 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 , i = A11 , j = A12 ⇒ v = A4 $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 , i = A11 , j = A12 ⇒ w = A5 $ by ax
l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 , i = A11 , j = A12 ⇒ a = A6 $ by ax
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 , i = A11 , j = A12 ⇒ b = A7 $ by ax
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 , i = A11 , j = A12 ⇒ c = A8 $ by ax
