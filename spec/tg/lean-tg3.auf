l3: $ _ ⇒ enc_ctx Ctx ∈ trees ω $ by enc_ctx_trees
l4: $ _ ⇒ enc_nat d ∈ trees ω $ by enc_nat_trees
l5: $ _ ⇒ enc_nat k ∈ trees ω $ by enc_nat_trees
l6: $ _ ⇒ enc_expr A ∈ trees ω $ by enc_expr_trees
l7: $ _ ⇒ enc_expr A2 ∈ trees ω $ by enc_expr_trees
l8: $ _ ⇒ enc_expr B ∈ trees ω $ by enc_expr_trees
l9: $ _ ⇒ enc_expr (pi A B) = ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ $ by eq_refl
l10: $ _ ⇒ enc_expr (pi A B) ∈ trees ω $ by enc_expr_trees
l11: $ _ ⇒ ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ ∈ trees ω $ by wcel_eq_l [l9, l10]
l12: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
l13: $ _ ⇒ enc_nat np = enc_nat np $ by eq_refl
l14: $ _ ⇒ enc_ctx (cons A2 Ctx) = ⟨ kc_cons , scons (enc_expr A2) (scons (enc_ctx Ctx) ∅) ⟩ $ by eq_refl
l15: $ _ ⇒ enc_nat (s d) = ⟨ kc_s , scons (enc_nat d) ∅ ⟩ $ by eq_refl
l16: $ _ ⇒ enc_expr B = enc_expr B $ by eq_refl
l17: $ _ ⇒ ra_fir (enc_ind D) (enc_nat np) (enc_ctx (cons A2 Ctx)) (enc_nat (s d)) (enc_expr B) = ra_fir (enc_ind D) (enc_nat np) ⟨ kc_cons , scons (enc_expr A2) (scons (enc_ctx Ctx) ∅) ⟩ ⟨ kc_s , scons (enc_nat d) ∅ ⟩ (enc_expr B) $ by ra_fir_eq [l12, l13, l14, l15, l16]
l18: $ _ ⇒ ra_fir (enc_ind D) (enc_nat np) ⟨ kc_cons , scons (enc_expr A2) (scons (enc_ctx Ctx) ∅) ⟩ ⟨ kc_s , scons (enc_nat d) ∅ ⟩ (enc_expr B) ∈ lrel3 J $ by wcel_eq_l [l17, #4]
l19: $ _ ⇒ enc_nat nz = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l20: $ _ ⇒ ra_leaf_has (enc_nat nz) (enc_expr B) = ra_leaf_has ⟨ kc_nz , ∅ ⟩ (enc_expr B) $ by ra_leaf_has_eq [l19, l16]
l21: $ _ ⇒ ra_leaf_has ⟨ kc_nz , ∅ ⟩ (enc_expr B) ∈ lrel $ by wcel_eq_l [l20, #1]
l22: $ _ ⇒ enc_nat n1 = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ by eq_refl
l23: $ _ ⇒ enc_nat k = enc_nat k $ by eq_refl
l24: $ _ ⇒ enc_expr A = enc_expr A $ by eq_refl
l25: $ _ ⇒ enc_expr A2 = enc_expr A2 $ by eq_refl
l26: $ _ ⇒ ra_sinst (enc_ind D) (enc_nat nz) (enc_nat n1) (enc_nat k) (enc_expr A) (enc_expr A2) = ra_sinst (enc_ind D) ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (enc_nat k) (enc_expr A) (enc_expr A2) $ by ra_sinst_eq [l12, l19, l22, l23, l24, l25]
l27: $ _ ⇒ ra_sinst (enc_ind D) ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ (enc_nat k) (enc_expr A) (enc_expr A2) ∈ lrel $ by wcel_eq_l [l26, #3]
l28: $ _ ⇒ ra_fir (enc_ind D) (enc_nat np) (enc_ctx Ctx) (enc_nat d) ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ ∈ lrel3 J $ by j1_c_fir_arg [l1, l2, l3, l4, l5, l6, l7, l8, l11, l18, l21, #2, l27]
l29: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
l30: $ _ ⇒ enc_nat np = enc_nat np $ by eq_refl
l31: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l32: $ _ ⇒ enc_nat d = enc_nat d $ by eq_refl
l33: $ _ ⇒ ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ = enc_expr (pi A B) $ by eq_refl
l34: $ _ ⇒ ra_fir (enc_ind D) (enc_nat np) (enc_ctx Ctx) (enc_nat d) ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ = ra_fir (enc_ind D) (enc_nat np) (enc_ctx Ctx) (enc_nat d) (enc_expr (pi A B)) $ by ra_fir_eq [l29, l30, l31, l32, l33]
l35: $ fir_j J D np Ctx d (pi A B) $ by wcel_eq_l [l34, l28]

--| @rewrite
--| The encoding of the definition `Prop`, for the normalizer (which keeps it folded).
lemma j1_enc_Prop: $ enc_expr Prop ≐ ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ $
----
l1: $ enc_expr Prop ≐ ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ $ by enc_srt

lemma j1_c_fir_prop (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ A7 ∈ trees ω $ >
  $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ∈ trees ω $ >
  $ G ⇒ ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8 ∈ lrel3 J $ >
  $ G ⇒ ra_add A4 A2 A5 ∈ lrel $ >
  $ G ⇒ ra_sinst A1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ A5 A6 A7 ∈ lrel $ >
  $ G ⇒ ra_deq A3 A7 A7 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ >
  $ G ⇒ ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ u = A3 $ by ax
