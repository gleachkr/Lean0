l60: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l61: $ G ⇒ ra_pred_eqs A1 A2 ∈ latoms $ by j1_ra_pred_eqs [#1, #2]
l62: $ G ⇒ ra_pred_eqs A1 A2 ∈ lrel3 J $ by j1_horn [l58, l59, l61, l60]

lemma j1_pr_sub_eqs (G: hyps) (J X: class): $ G ⇒ X ∈ pr_sub_eqs J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_sub_eqs J) ∪ (pr_mul_eqs J) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ (pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J))) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ ((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J)))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_r [l4]

lemma j1_ra_sub_eqs (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_sub_eqs A1 A2 A3 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A3 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#3, l1]
l3: $ G ⇒ scons A2 (scons A3 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l2]
l4: $ G ⇒ scons A1 (scons A2 (scons A3 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l3]
l5: $ G ⇒ kr_sub_eqs ∈ ω $ by kr_sub_eqs_omega
l6: $ G ⇒ ra_sub_eqs A1 A2 A3 ∈ latoms $ by cxp_intro_c [l5, l4]

lrel3_sub_eqs_i
---------------
l1: $ G , y = A1 , z = A2 , u = A3 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 ⇒ u = A3 $ by ax
