l9: $ cwf_j J D n np l i Ctx d K $ by j1_c_cwf_res [l1, l2, l3, l4, l5, l6, l7, l8, #1]

lemma j1_pr_ctors_wf (G: hyps) (J X: class): $ G ⇒ X ∈ pr_ctors_wf $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ pr_ctors_wf ∪ pr_tys_wf $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf) $ by j1_in_r [l1]
