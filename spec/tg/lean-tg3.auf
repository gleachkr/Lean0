l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l25]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 ∅)))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_pow_eqs = kr_pow_eqs ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V3 (scons V4 ∅))) $ by opair_inj_c [l12, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V3 (scons V4 ∅))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V3 (scons V4 ∅)) $ by j2_scons_inj [l35, l24, l16, l23, l28]
