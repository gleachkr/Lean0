l7: $ _ ⇒ enc_expr K ∈ trees ω $ by enc_expr_trees
l8: $ _ ⇒ enc_nat np ∈ trees ω $ by enc_nat_trees
l9: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
l10: $ _ ⇒ enc_nat np = enc_nat np $ by eq_refl
l11: $ _ ⇒ enc_ctx G2 = enc_ctx G2 $ by eq_refl
l12: $ _ ⇒ enc_nat nz = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l13: $ _ ⇒ enc_expr K = enc_expr K $ by eq_refl
l14: $ _ ⇒ ra_fir (enc_ind D) (enc_nat np) (enc_ctx G2) (enc_nat nz) (enc_expr K) = ra_fir (enc_ind D) (enc_nat np) (enc_ctx G2) ⟨ kc_nz , ∅ ⟩ (enc_expr K) $ by ra_fir_eq [l9, l10, l11, l12, l13]
l15: $ _ ⇒ ra_fir (enc_ind D) (enc_nat np) (enc_ctx G2) ⟨ kc_nz , ∅ ⟩ (enc_expr K) ∈ lrel3 J $ by wcel_eq_l [l14, #4]
l16: $ _ ⇒ enc_blk b = enc_blk b $ by eq_refl
l17: $ _ ⇒ enc_ctx P = enc_ctx P $ by eq_refl
l18: $ _ ⇒ enc_tys (tcons F (ccons K cnil) tnil) = ⟨ kc_tcons , scons (enc_expr F) (scons ⟨ kc_ccons , scons (enc_expr K) (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ by eq_refl
l19: $ _ ⇒ ra_ind_data (enc_ind D) (enc_blk b) (enc_ctx P) (enc_tys (tcons F (ccons K cnil) tnil)) = ra_ind_data (enc_ind D) (enc_blk b) (enc_ctx P) ⟨ kc_tcons , scons (enc_expr F) (scons ⟨ kc_ccons , scons (enc_expr K) (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ $ by ra_ind_data_eq [l9, l16, l17, l18]
l20: $ _ ⇒ ra_ind_data (enc_ind D) (enc_blk b) (enc_ctx P) ⟨ kc_tcons , scons (enc_expr F) (scons ⟨ kc_ccons , scons (enc_expr K) (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by wcel_eq_l [l19, #1]
