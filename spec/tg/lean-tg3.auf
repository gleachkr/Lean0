l58: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_exi15 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, b9 := $ V9 $, b10 := $ V10 $, b11 := $ V11 $, b12 := $ V12 $, b13 := $ V13 $, b14 := $ V14 $, b15 := $ V15 $, p := $ t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J $) [l57]

lemma j2_d_ind_wf_i (G: hyps) (J: class) {G_v G2 D b_v P N T np n_v m_v k_v n0 l_v F C: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_wf t1 t2 ⟩ ∈ cl_ind_wf_i $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x ∊ cl_ind_wf_i ⇒ x ∊ cl_ind_wf_i $ by ax
l2: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x ∊ cl_ind_wf_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e (x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ x = ⟨ pp , ra_ind_wf t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_e_ind_wf_i [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x ∊ cl_ind_wf_i ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_ex15 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_ind_wf (G: hyps) (J: class) {G_v G2 D b_v P N T np n_v m_v k_v n0 l_v F C: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_wf t1 t2 ⟩ ∈ pr_ind_wf $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $
----
l1: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_d_ind_wf_i [#1, #2]

lrel3_ind_wf_cases
------------------
l1: $ G ⇒ isset (ra_ind_wf t1 t2) $ by opair_isset
l2: $ G , c = ra_ind_wf t1 t2 ⇒ c = ra_ind_wf t1 t2 $ by ax
l3: $ G , c = ra_ind_wf t1 t2 ⇒ ra_ind_wf t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_ind_wf t1 t2 ⇒ ra_ind_wf t1 t2 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_ind_wf t1 t2 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_ind_wf t1 t2 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_ind_wf t1 t2 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_ind_wf t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_ind_wf t1 t2 $ by ax
l14: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_ind_wf t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ind_wf t1 t2 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ind_wf t1 t2 ⟩ ∈ pr_ind_wf $ by lprog3_ind_wf_pr [l15]
l17: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_o_ind_wf [l16, l11]
l18: $ G , c = ra_ind_wf t1 t2 ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_nst_ok_nil (G: hyps) (J: class) {G_v D j_v: set} (pp t1 t2 t3 t4 x V1 V2 V3: set):
  $ G ⇒ x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_nst_ok t1 t2 t3 t4) $ by opair_isset
l7: $ G ⇒ isset (ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_nst_ok t1 t2 t3 t4 = ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [l2, l5, l6, l4, l7]
