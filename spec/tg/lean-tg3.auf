l55: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons V8 ∅))))) $ by j2_scons_inj [l54, l34, l19, l33, l43]
l56: $ G ⇒ t2 = V2 $ by and_elim_l [l55]
l57: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons V8 ∅))))) $ by and_elim_r [l55]
l58: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))) = scons V4 (scons V5 (scons V6 (scons V7 (scons V8 ∅)))) $ by j2_scons_inj [l57, l32, l18, l31, l42]
l59: $ G ⇒ t3 = V3 $ by and_elim_l [l58]
l60: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))) = scons V4 (scons V5 (scons V6 (scons V7 (scons V8 ∅)))) $ by and_elim_r [l58]
l61: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 (scons t8 ∅))) = scons V5 (scons V6 (scons V7 (scons V8 ∅))) $ by j2_scons_inj [l60, l30, l17, l29, l41]
l62: $ G ⇒ t4 = V4 $ by and_elim_l [l61]
l63: $ G ⇒ scons t5 (scons t6 (scons t7 (scons t8 ∅))) = scons V5 (scons V6 (scons V7 (scons V8 ∅))) $ by and_elim_r [l61]
l64: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 (scons t8 ∅)) = scons V6 (scons V7 (scons V8 ∅)) $ by j2_scons_inj [l63, l28, l16, l27, l40]
l65: $ G ⇒ t5 = V5 $ by and_elim_l [l64]
l66: $ G ⇒ scons t6 (scons t7 (scons t8 ∅)) = scons V6 (scons V7 (scons V8 ∅)) $ by and_elim_r [l64]
l67: $ G ⇒ t6 = V6 ∧ scons t7 (scons t8 ∅) = scons V7 (scons V8 ∅) $ by j2_scons_inj [l66, l26, l15, l25, l39]
l68: $ G ⇒ t6 = V6 $ by and_elim_l [l67]
l69: $ G ⇒ scons t7 (scons t8 ∅) = scons V7 (scons V8 ∅) $ by and_elim_r [l67]
l70: $ G ⇒ t7 = V7 ∧ scons t8 ∅ = scons V8 ∅ $ by j2_scons_inj [l69, l24, l14, l23, l38]
l71: $ G ⇒ t7 = V7 $ by and_elim_l [l70]
l72: $ G ⇒ scons t8 ∅ = scons V8 ∅ $ by and_elim_r [l70]
l73: $ G ⇒ t8 = V8 ∧ ∅ = ∅ $ by j2_scons_inj [l72, l22, l13, l21, l21]
l74: $ G ⇒ t8 = V8 $ by and_elim_l [l73]
l75: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = V7 ∧ t8 = V8 ∧ ra_indapp V1 V2 V3 V7 V8 V5 ∈ lrel $ by j2_and8 [l53, l56, l59, l62, l65, l68, l71, l74, l2]
l76: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by j2_exi8 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, p := $ t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel $) [l75]

lemma j2_d_cwf_res (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v K: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_res ⇒ x ∊ cl_cwf_res $ by ax
l2: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_res ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel ⇒ x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel ⇒ x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by j2_e_cwf_res [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_res ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by wcel_elim [#1, l7]

lemma j2_o_cwf (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v A B A2 u_v K: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ pr_cwf J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res $ by ax
l2: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by j2_d_cwf_res [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res → ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) $ by ax
l6: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∨ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J $ by ax
l8: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l9: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_d_cwf_pi [l7, l8]
l10: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res $ by ax
l12: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res → ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J ∪ (cl_cwf_res) → ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by imp_elim [l16, #1]

lrel3_cwf_cases
---------------
l1: $ G ⇒ isset (ra_cwf t1 t2 t3 t4 t5 t6 t7 t8) $ by opair_isset
l2: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 $ by ax
l3: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 = c $ by eq_sym [l2]
l4: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 $ by ax
l14: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ pr_cwf J $ by lprog3_cwf_pr [l15]
l17: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by j2_o_cwf [l16, l11]
l18: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $ by isset_elim [l1, l18]

lemma j2_e_ctors_wf_nil (G: hyps) (J: class) {D n_v np l_v i_v Ctx: set} (pp t1 t2 t3 t4 t5 t6 t7 x V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ ∅ , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟩ = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_ctors_wf t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l7: $ G ⇒ isset (ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 = ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 = ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ $ by and_elim_r [l8]
l11: $ G ⇒ isset ⟨ kc_cnil , ∅ ⟩ $ by opair_isset
l12: $ G ⇒ isset V6 $ by isset_var
l13: $ G ⇒ isset V5 $ by isset_var
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ isset V3 $ by isset_var
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ isset V1 $ by isset_var
l18: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l19: $ G ⇒ isset t7 $ by isset_var
l20: $ G ⇒ scons t7 ∅ ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t6 $ by isset_var
l22: $ G ⇒ scons t6 (scons t7 ∅) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ isset t5 $ by isset_var
l24: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) ∈ fseq j2_vv $ by j2_fs [l23, l22]
l25: $ G ⇒ isset t4 $ by isset_var
l26: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) ∈ fseq j2_vv $ by j2_fs [l25, l24]
l27: $ G ⇒ isset t3 $ by isset_var
l28: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) ∈ fseq j2_vv $ by j2_fs [l27, l26]
l29: $ G ⇒ isset t2 $ by isset_var
l30: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) ∈ fseq j2_vv $ by j2_fs [l29, l28]
l31: $ G ⇒ isset t1 $ by isset_var
l32: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq j2_vv $ by j2_fs [l31, l30]
l33: $ G ⇒ scons ⟨ kc_cnil , ∅ ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l11, l18]
l34: $ G ⇒ scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l12, l33]
l35: $ G ⇒ scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l13, l34]
l36: $ G ⇒ scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l14, l35]
l37: $ G ⇒ scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l15, l36]
l38: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))))) ∈ fseq j2_vv $ by j2_fs [l16, l37]
l39: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))))) ∈ fseq j2_vv $ by j2_fs [l17, l38]
l40: $ G ⇒ kr_ctors_wf ∈ ω $ by kr_ctors_wf_omega
l41: $ G ⇒ isset kr_ctors_wf $ by wcel_isset [l40]
l42: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l32]
l43: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))))))) $ by wcel_isset [l39]
l44: $ G ⇒ kr_ctors_wf = kr_ctors_wf ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))))) $ by opair_inj_c [l10, l41, l42, l41, l43]
l45: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))))) $ by and_elim_r [l44]
l46: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))))) $ by j2_scons_inj [l45, l31, l17, l30, l38]
l47: $ G ⇒ t1 = V1 $ by and_elim_l [l46]
l48: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))))) $ by and_elim_r [l46]
l49: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))) $ by j2_scons_inj [l48, l29, l16, l28, l37]
l50: $ G ⇒ t2 = V2 $ by and_elim_l [l49]
l51: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))) $ by and_elim_r [l49]
l52: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))) $ by j2_scons_inj [l51, l27, l15, l26, l36]
l53: $ G ⇒ t3 = V3 $ by and_elim_l [l52]
l54: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))) $ by and_elim_r [l52]
l55: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)) $ by j2_scons_inj [l54, l25, l14, l24, l35]
l56: $ G ⇒ t4 = V4 $ by and_elim_l [l55]
l57: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)) $ by and_elim_r [l55]
l58: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅) $ by j2_scons_inj [l57, l23, l13, l22, l34]
l59: $ G ⇒ t5 = V5 $ by and_elim_l [l58]
l60: $ G ⇒ scons t6 (scons t7 ∅) = scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅) $ by and_elim_r [l58]
l61: $ G ⇒ t6 = V6 ∧ scons t7 ∅ = scons ⟨ kc_cnil , ∅ ⟩ ∅ $ by j2_scons_inj [l60, l21, l12, l20, l33]
l62: $ G ⇒ t6 = V6 $ by and_elim_l [l61]
l63: $ G ⇒ scons t7 ∅ = scons ⟨ kc_cnil , ∅ ⟩ ∅ $ by and_elim_r [l61]
l64: $ G ⇒ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l63, l19, l11, l18, l18]
l65: $ G ⇒ t7 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l64]
l66: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = ⟨ kc_cnil , ∅ ⟩ $ by j2_and6 [l47, l50, l53, l56, l59, l62, l65]
l67: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $ by j2_exi6 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, p := $ t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩ $) [l66]

lemma j2_d_ctors_wf_nil (G: hyps) (J: class) {D n_v np l_v i_v Ctx: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_nil ⇒ x ∊ cl_ctors_wf_nil $ by ax
l2: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $ by j2_e_ctors_wf_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_nil ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $ by j2_ex6 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma j2_e_ctors_wf_cons (G: hyps) (J: class) {D n_v np l_v i_v Ctx K C: set} (pp t1 t2 t3 t4 t5 t6 t7 x V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $
----
l1: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ⟩ $ by eq_trans [l1, #2]
