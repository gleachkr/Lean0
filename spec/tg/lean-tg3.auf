l5: $ G , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ kr_ctx_wf ∈ ω $ by kr_ctx_wf_omega
l6: $ G , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ x ∊ j2_lab kr_ctx_wf (suc kr_ctx_wf) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_ctx_wf_cons J ⇒ x ∊ j2_lab kr_ctx_wf (suc kr_ctx_wf) $ by j2_ex5 [l2, l6]
l8: $ G ⇒ cl_ctx_wf_cons J ⊆ j2_lab kr_ctx_wf (suc kr_ctx_wf) $ by subset_intro [l7]

