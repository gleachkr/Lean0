lemma j2_d_tys_wf_nil (G: hyps) (J: class) {D n_v np l_v i_v Ctx: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_tys_wf_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_tys_wf_nil ⇒ x ∊ cl_tys_wf_nil $ by ax
l2: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_tys_wf_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $ by j2_e_tys_wf_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_tys_wf_nil ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $ by j2_ex6 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $ by wcel_elim [#1, l7]

