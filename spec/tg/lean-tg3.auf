l46: $ cwf_j J D n np l i Ctx d (pi A B) $ by wcel_eq_l [l45, l36]

lemma j1_c_cwf_res (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ A7 ∈ trees ω $ >
  $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ ra_indapp A1 A2 A3 A7 A8 A5 ∈ lrel $ >
  $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ v = A4 $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ w = A5 $ by ax
l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ a = A6 $ by ax
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ b = A7 $ by ax
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ c = A8 $ by ax
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_indapp A1 A2 A3 A7 A8 A5 ∈ lrel $ by weaken [#9]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_indapp y z u b c w = ra_indapp A1 A2 A3 A7 A8 A5 $ by ra_indapp_eq [l1, l2, l3, l7, l8, l5]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_indapp A1 A2 A3 A7 A8 A5 = ra_indapp y z u b c w $ by eq_sym [l10]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_indapp y z u b c w ∈ lrel $ by wcel_eq_l [l11, l9]
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ $ by ax
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ra_indapp y z u b c w ∈ lrel $ by weaken [l12]
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel $ by and_intro [l13, l14]
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by ex_intro [l15]
l17: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by ex_intro [l16]
l18: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ∃ a ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by ex_intro [l17]
l19: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by ex_intro [l18]
l20: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by ex_intro [l19]
l21: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by ex_intro [l20]
l22: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by ex_intro [l21]
l23: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by ex_intro [l22]
l24: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ x ∊ cl_cwf_res $ by cab_intro [l23]
l25: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ⇒ ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∈ cl_cwf_res $ by wcel_intro [l13, l24]
l26: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ isset ⟨ ∅ , ra_cwf y z u v w a b c ⟩ $ by opair_isset
l27: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∈ cl_cwf_res $ by isset_elim [l26, l25]
l28: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ∅ = ∅ $ by eq_refl
l29: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_cwf y z u v w a b c = ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 $ by ra_cwf_eq [l1, l2, l3, l4, l5, l6, l7, l8]
l30: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ⟨ ∅ , ra_cwf y z u v w a b c ⟩ = ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ $ by opair_eq [l28, l29]
l31: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by wcel_eq_l [l30, l27]
l32: $ G ⇒ isset A8 $ by wcel_isset [#8]
l33: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by isset_elim [l32, l31]
l34: $ G ⇒ isset A7 $ by wcel_isset [#7]
l35: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by isset_elim [l34, l33]
l36: $ G ⇒ isset A6 $ by wcel_isset [#6]
l37: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by isset_elim [l36, l35]
l38: $ G ⇒ isset A5 $ by wcel_isset [#5]
l39: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by isset_elim [l38, l37]
l40: $ G ⇒ isset A4 $ by wcel_isset [#4]
l41: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by isset_elim [l40, l39]
l42: $ G ⇒ isset A3 $ by wcel_isset [#3]
l43: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by isset_elim [l42, l41]
l44: $ G ⇒ isset A2 $ by wcel_isset [#2]
l45: $ G , y = A1 ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by isset_elim [l44, l43]
l46: $ G ⇒ isset A1 $ by wcel_isset [#1]
l47: $ G ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ cl_cwf_res $ by isset_elim [l46, l45]
l48: $ G ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ (cl_cwf_pi J) ∪ cl_cwf_res $ by j1_in_r [l47]
l49: $ G ⇒ ⟨ ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ⟩ ∈ j1_top J $ by j1_pr_cwf [l48]
l50: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l51: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l52: $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ∈ latoms $ by j1_ra_cwf [#1, #2, #3, #4, #5, #6, #7, #8]
l53: $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 A8 ∈ lrel3 J $ by j1_horn [l49, l50, l52, l51]

