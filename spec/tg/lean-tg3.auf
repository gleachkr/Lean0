lemma j1_pr_nateq_dec (G: hyps) (J X: class): $ G ⇒ X ∈ pr_nateq_dec J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_natle_dec J) ∪ (pr_nateq_dec J) $ by j1_in_r [#1]
l2: $ G ⇒ X ∈ ((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J)) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ (((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))) $ by j1_in_l [l2]
