l6: $ G , c = ra_tys_ok t1 t2 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_tys_ok t1 t2 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_tys_ok t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_tys_ok t1 t2 $ by ax
l14: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_tys_ok t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_tys_ok t1 t2 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_tys_ok t1 t2 ⟩ ∈ pr_tys_ok $ by lprog3_tys_ok_pr [l15]
l17: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by j2_o_tys_ok [l16, l11]
l18: $ G , c = ra_tys_ok t1 t2 ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_ind_wf_i (G: hyps) (J: class) {G_v G2 D b_v P N T np n_v m_v k_v n0 l_v F C: set} (pp t1 t2 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15: set):
  $ G ⇒ x = ⟨ pp , ra_ind_wf t1 t2 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) , ra_ind_wf V1 V3 ⟩ ∧ ra_ind_data V3 V4 V5 V7 ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_ntys V7 V9 V10 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel ∧ ra_isort V14 V11 V13 ∈ lrel ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) , ra_ind_wf V1 V3 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V3 V4 V5 V7 ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_ntys V7 V9 V10 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel ∧ ra_isort V14 V11 V13 ∈ lrel ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_ind_wf t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_ind_wf t1 t2 ⟩ = ⟨ scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) , ra_ind_wf V1 V3 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) , ra_ind_wf V1 V3 ⟩ = ⟨ pp , ra_ind_wf t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅))) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_ind_wf t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_ind_wf V1 V3) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) ∧ ra_ind_wf t1 t2 = ra_ind_wf V1 V3 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) $ by and_elim_l [l10]
l12: $ G ⇒ ra_ind_wf t1 t2 = ra_ind_wf V1 V3 $ by and_elim_r [l10]
l13: $ G ⇒ isset V3 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons V3 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons V3 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_ind_wf ∈ ω $ by kr_ind_wf_omega
l23: $ G ⇒ isset kr_ind_wf $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons V3 ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_ind_wf = kr_ind_wf ∧ scons t1 (scons t2 ∅) = scons V1 (scons V3 ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V3 ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V3 ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons V3 ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V3 ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = V3 $ by and_elim_l [l31]
l33: $ G ⇒ crn pp = crn (scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅))) $ by crn_eq [l11]
l34: $ G ⇒ crn (scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅))) ⊆ lrel3 J $ by subset_eq_l [l33, #3]
l35: $ G ⇒ isset (ra_tys_ok V1 V3) $ by opair_isset
l36: $ G ⇒ ra_tys_ok V1 V3 ∈ lrel3 J $ by crn_scons_head [l35, l34]
l37: $ G ⇒ crn (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) ⊆ lrel3 J $ by crn_scons_tail [l34]
l38: $ G ⇒ isset (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) $ by opair_isset
l39: $ G ⇒ ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7 ∈ lrel3 J $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_nst_ok V1 V3 V12 V6) ∅) ⊆ lrel3 J $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_nst_ok V1 V3 V12 V6) $ by opair_isset
l42: $ G ⇒ ra_nst_ok V1 V3 V12 V6 ∈ lrel3 J $ by crn_scons_head [l41, l40]
l43: $ G ⇒ ra_ind_data V3 V4 V5 V7 ∈ lrel $ by and_elim_l [l2]
l44: $ G ⇒ ra_clen V5 V8 ∈ lrel ∧ ra_ntys V7 V9 V10 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel ∧ ra_isort V14 V11 V13 ∈ lrel ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ by and_elim_r [l2]
l45: $ G ⇒ ra_clen V5 V8 ∈ lrel $ by and_elim_l [l44]
l46: $ G ⇒ ra_ntys V7 V9 V10 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel ∧ ra_isort V14 V11 V13 ∈ lrel ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ by and_elim_r [l44]
l47: $ G ⇒ ra_ntys V7 V9 V10 ∈ lrel $ by and_elim_l [l46]
l48: $ G ⇒ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel ∧ ra_isort V14 V11 V13 ∈ lrel ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ by and_elim_r [l46]
l49: $ G ⇒ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_l [l48]
l50: $ G ⇒ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel ∧ ra_isort V14 V11 V13 ∈ lrel ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ by and_elim_r [l48]
l51: $ G ⇒ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel $ by and_elim_l [l50]
l52: $ G ⇒ ra_isort V14 V11 V13 ∈ lrel ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ by and_elim_r [l50]
l53: $ G ⇒ ra_isort V14 V11 V13 ∈ lrel $ by and_elim_l [l52]
l54: $ G ⇒ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ by and_elim_r [l52]
l55: $ G ⇒ ra_ind_nested V3 V6 ∈ lrel $ by and_elim_l [l54]
l56: $ G ⇒ ra_ndecl V6 V9 V12 ∈ lrel $ by and_elim_r [l54]
l57: $ G ⇒ t1 = V1 ∧ t2 = V3 ∧ ra_tys_ok V1 V3 ∈ lrel3 J ∧ ra_ind_data V3 V4 V5 V7 ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_ntys V7 V9 V10 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel ∧ ra_isort V14 V11 V13 ∈ lrel ∧ ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7 ∈ lrel3 J ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel ∧ ra_nst_ok V1 V3 V12 V6 ∈ lrel3 J $ by j2_and12 [l29, l32, l36, l43, l45, l47, l49, l51, l53, l39, l55, l56, l42]
l58: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_exi15 [l57]

lemma j2_d_ind_wf_i (G: hyps) (J: class) {G_v G2 D b_v P N T np n_v m_v k_v n0 l_v F C: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_wf t1 t2 ⟩ ∈ cl_ind_wf_i $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x ∊ cl_ind_wf_i ⇒ x ∊ cl_ind_wf_i $ by ax
l2: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x ∊ cl_ind_wf_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e (x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ x = ⟨ pp , ra_ind_wf t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_e_ind_wf_i [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_ind_wf t1 t2 ⟩ , x ∊ cl_ind_wf_i ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_ex15 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_ind_wf (G: hyps) (J: class) {G_v G2 D b_v P N T np n_v m_v k_v n0 l_v F C: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_wf t1 t2 ⟩ ∈ pr_ind_wf $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $
----
l1: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_d_ind_wf_i [#1, #2]

lrel3_ind_wf_cases
------------------
l1: $ G ⇒ isset (ra_ind_wf t1 t2) $ by opair_isset
l2: $ G , c = ra_ind_wf t1 t2 ⇒ c = ra_ind_wf t1 t2 $ by ax
l3: $ G , c = ra_ind_wf t1 t2 ⇒ ra_ind_wf t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_ind_wf t1 t2 ⇒ ra_ind_wf t1 t2 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_ind_wf t1 t2 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_ind_wf t1 t2 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_ind_wf t1 t2 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_ind_wf t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_ind_wf t1 t2 $ by ax
l14: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_ind_wf t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ind_wf t1 t2 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ind_wf t1 t2 ⟩ ∈ pr_ind_wf $ by lprog3_ind_wf_pr [l15]
l17: $ G , c = ra_ind_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by j2_o_ind_wf [l16, l11]
l18: $ G , c = ra_ind_wf t1 t2 ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_nst_ok_nil (G: hyps) (J: class) {G_v D j_v: set} (pp t1 t2 t3 t4 x V1 V2 V3: set):
  $ G ⇒ x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_nst_ok t1 t2 t3 t4) $ by opair_isset
l7: $ G ⇒ isset (ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_nst_ok t1 t2 t3 t4 = ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_nst_ok t1 t2 t3 t4 = ra_nst_ok V1 V2 V3 ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l8]
l11: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l12: $ G ⇒ isset V3 $ by isset_var
l13: $ G ⇒ isset V2 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t4 $ by isset_var
l17: $ G ⇒ scons t4 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t3 $ by isset_var
l19: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ isset t2 $ by isset_var
l21: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq j2_vv $ by j2_fs [l20, l19]
l22: $ G ⇒ isset t1 $ by isset_var
l23: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq j2_vv $ by j2_fs [l22, l21]
l24: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l11, l15]
l25: $ G ⇒ scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l12, l24]
l26: $ G ⇒ scons V2 (scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l13, l25]
l27: $ G ⇒ scons V1 (scons V2 (scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l14, l26]
l28: $ G ⇒ kr_nst_ok ∈ ω $ by kr_nst_ok_omega
l29: $ G ⇒ isset kr_nst_ok $ by wcel_isset [l28]
l30: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l23]
l31: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅)))) $ by wcel_isset [l27]
l32: $ G ⇒ kr_nst_ok = kr_nst_ok ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by opair_inj_c [l10, l29, l30, l29, l31]
l33: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by and_elim_r [l32]
l34: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by j2_scons_inj [l33, l22, l14, l21, l26]
l35: $ G ⇒ t1 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by and_elim_r [l34]
l37: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by j2_scons_inj [l36, l20, l13, l19, l25]
l38: $ G ⇒ t2 = V2 $ by and_elim_l [l37]
l39: $ G ⇒ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by and_elim_r [l37]
l40: $ G ⇒ t3 = V3 ∧ scons t4 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by j2_scons_inj [l39, l18, l12, l17, l24]
l41: $ G ⇒ t3 = V3 $ by and_elim_l [l40]
l42: $ G ⇒ scons t4 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by and_elim_r [l40]
l43: $ G ⇒ t4 = ⟨ kc_nil , ∅ ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l42, l16, l11, l15, l15]
l44: $ G ⇒ t4 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l43]
l45: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = ⟨ kc_nil , ∅ ⟩ $ by j2_and3 [l35, l38, l41, l44]
l46: $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by j2_exi3 [l45]

lemma j2_d_nst_ok_nil (G: hyps) (J: class) {G_v D j_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_nil ⇒ x ∊ cl_nst_ok_nil $ by ax
l2: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_nil ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by j2_e_nst_ok_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_nil ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by j2_ex3 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma j2_e_nst_ok_cons (G: hyps) (J: class) {G_v D I j_v j2 npi ni mi ni0 X N2 N3 NI: set} (pp t1 t2 t3 t4 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13: set):
  $ G ⇒ x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅)) , ra_nst_ok V1 V2 V4 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons V3 (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ V10 V6 ∈ lrel ∧ ra_ind_arity V3 V6 V7 V8 ∈ lrel ∧ ra_ind_nested V3 V13 ∈ lrel ∧ ra_ndecl V13 V7 V9 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V9 ∈ lrel ∧ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ni0 ∈ lrel ∧ ra_nst_ty G_v D I X ∈ lrel3 J ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅)) , ra_nst_ok V1 V2 V4 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_spine ⟨ kc_ind_ty , scons V3 (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ V10 V6 ∈ lrel ∧ ra_ind_arity V3 V6 V7 V8 ∈ lrel ∧ ra_ind_nested V3 V13 ∈ lrel ∧ ra_ndecl V13 V7 V9 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V9 ∈ lrel ∧ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅)) , ra_nst_ok V1 V2 V4 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅)) , ra_nst_ok V1 V2 V4 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ⟩ = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅))) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_nst_ok t1 t2 t3 t4) $ by opair_isset
l9: $ G ⇒ isset (ra_nst_ok V1 V2 V4 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅)) ∧ ra_nst_ok t1 t2 t3 t4 = ra_nst_ok V1 V2 V4 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅)) $ by and_elim_l [l10]
l12: $ G ⇒ ra_nst_ok t1 t2 t3 t4 = ra_nst_ok V1 V2 V4 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ $ by and_elim_r [l10]
l13: $ G ⇒ isset ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ $ by opair_isset
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ isset V2 $ by isset_var
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l18: $ G ⇒ isset t4 $ by isset_var
l19: $ G ⇒ scons t4 ∅ ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ isset t3 $ by isset_var
l21: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq j2_vv $ by j2_fs [l20, l19]
l22: $ G ⇒ isset t2 $ by isset_var
l23: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq j2_vv $ by j2_fs [l22, l21]
l24: $ G ⇒ isset t1 $ by isset_var
l25: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq j2_vv $ by j2_fs [l24, l23]
l26: $ G ⇒ scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l13, l17]
l27: $ G ⇒ scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l14, l26]
l28: $ G ⇒ scons V2 (scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l27]
l29: $ G ⇒ scons V1 (scons V2 (scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l28]
l30: $ G ⇒ kr_nst_ok ∈ ω $ by kr_nst_ok_omega
l31: $ G ⇒ isset kr_nst_ok $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l25]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅)))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_nst_ok = kr_nst_ok ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅))) $ by opair_inj_c [l12, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅)) $ by j2_scons_inj [l35, l24, l16, l23, l28]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅)) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅) $ by j2_scons_inj [l38, l22, l15, l21, l27]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅ $ by j2_scons_inj [l41, l20, l14, l19, l26]
l43: $ G ⇒ t3 = V4 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 ∅ = scons ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∅ $ by and_elim_r [l42]
l45: $ G ⇒ t4 = ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l44, l18, l13, l17, l17]
l46: $ G ⇒ t4 = ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ $ by and_elim_l [l45]
l47: $ G ⇒ crn pp = crn (scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅))) $ by crn_eq [l11]
l48: $ G ⇒ crn (scons (ra_ind_wf V1 V3) (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅))) ⊆ lrel3 J $ by subset_eq_l [l47, #3]
l49: $ G ⇒ isset (ra_ind_wf V1 V3) $ by opair_isset
l50: $ G ⇒ ra_ind_wf V1 V3 ∈ lrel3 J $ by crn_scons_head [l49, l48]
l51: $ G ⇒ crn (scons (ra_nst_ty V1 V2 V3 V10) (scons (ra_nst_ok V1 V2 V5 V12) ∅)) ⊆ lrel3 J $ by crn_scons_tail [l48]
l52: $ G ⇒ isset (ra_nst_ty V1 V2 V3 V10) $ by opair_isset
l53: $ G ⇒ ra_nst_ty V1 V2 V3 V10 ∈ lrel3 J $ by crn_scons_head [l52, l51]
l54: $ G ⇒ crn (scons (ra_nst_ok V1 V2 V5 V12) ∅) ⊆ lrel3 J $ by crn_scons_tail [l51]
l55: $ G ⇒ isset (ra_nst_ok V1 V2 V5 V12) $ by opair_isset
l56: $ G ⇒ ra_nst_ok V1 V2 V5 V12 ∈ lrel3 J $ by crn_scons_head [l55, l54]
l57: $ G ⇒ ra_spine ⟨ kc_ind_ty , scons V3 (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ V10 V6 ∈ lrel $ by and_elim_l [l2]
l58: $ G ⇒ ra_ind_arity V3 V6 V7 V8 ∈ lrel ∧ ra_ind_nested V3 V13 ∈ lrel ∧ ra_ndecl V13 V7 V9 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V9 ∈ lrel ∧ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel $ by and_elim_r [l2]
l59: $ G ⇒ ra_ind_arity V3 V6 V7 V8 ∈ lrel $ by and_elim_l [l58]
l60: $ G ⇒ ra_ind_nested V3 V13 ∈ lrel ∧ ra_ndecl V13 V7 V9 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V9 ∈ lrel ∧ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel $ by and_elim_r [l58]
l61: $ G ⇒ ra_ind_nested V3 V13 ∈ lrel $ by and_elim_l [l60]
l62: $ G ⇒ ra_ndecl V13 V7 V9 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V9 ∈ lrel ∧ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel $ by and_elim_r [l60]
l63: $ G ⇒ ra_ndecl V13 V7 V9 ∈ lrel $ by and_elim_l [l62]
l64: $ G ⇒ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V9 ∈ lrel ∧ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel $ by and_elim_r [l62]
l65: $ G ⇒ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V9 ∈ lrel $ by and_elim_l [l64]
l66: $ G ⇒ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel $ by and_elim_r [l64]
l67: $ G ⇒ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 $ by and_elim_l [l66]
l68: $ G ⇒ ra_add V4 V9 V5 ∈ lrel $ by and_elim_r [l66]
l69: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V4 ∧ t4 = ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons V3 (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ V10 V6 ∈ lrel ∧ ra_ind_wf V1 V3 ∈ lrel3 J ∧ ra_ind_arity V3 V6 V7 V8 ∈ lrel ∧ ra_ind_nested V3 V13 ∈ lrel ∧ ra_ndecl V13 V7 V9 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V9 ∈ lrel ∧ ra_nst_ty V1 V2 V3 V10 ∈ lrel3 J ∧ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel ∧ ra_nst_ok V1 V2 V5 V12 ∈ lrel3 J $ by j2_and13 [l37, l40, l43, l46, l57, l50, l59, l61, l63, l65, l53, l67, l68, l56]
l70: $ G ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ni0 ∈ lrel ∧ ra_nst_ty G_v D I X ∈ lrel3 J ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by j2_exi13 [l69]

lemma j2_d_nst_ok_cons (G: hyps) (J: class) {G_v D I j_v j2 npi ni mi ni0 X N2 N3 NI: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ni0 ∈ lrel ∧ ra_nst_ty G_v D I X ∈ lrel3 J ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_cons ⇒ x ∊ cl_nst_ok_cons $ by ax
l2: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ty y z u g) (scons (ra_nst_ok y z w j) ∅)) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ty y z u g) (scons (ra_nst_ok y z w j) ∅)) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ty y z u g) (scons (ra_nst_ok y z w j) ∅)) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ty y z u g) (scons (ra_nst_ok y z w j) ∅)) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_le ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel $ by ax
