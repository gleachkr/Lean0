l8: $ G ⇒ ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b7 $, p := $ ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l7]
l9: $ G ⇒ ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b6 $, p := $ ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l8]
l10: $ G ⇒ ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b5 $, p := $ ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l9]
l11: $ G ⇒ ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b4 $, p := $ ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a3/b3] [a2/b2] [a1/b1] p $) [l10]
l12: $ G ⇒ ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a2/b2] [a1/b1] p $ by ex_intro (t := $ b3 $, p := $ ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a2/b2] [a1/b1] p $) [l11]
l13: $ G ⇒ ∃ a2 ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a1/b1] p $ by ex_intro (t := $ b2 $, p := $ ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 [a1/b1] p $) [l12]
l14: $ G ⇒ ∃ a1 ∃ a2 ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 p $ by ex_intro (t := $ b1 $, p := $ ∃ a2 ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 p $) [l13]

--| Introduction of 15 nested existentials.
lemma j2_exi15 {a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15: set} (G: hyps) (b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15: set) (p: fml a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15):
  $ G ⇒ [a15/b15] [a14/b14] [a13/b13] [a12/b12] [a11/b11] [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ > $ G ⇒ ∃ a1 ∃ a2 ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 p $
----
l1: $ G ⇒ ∃ a15 [a14/b14] [a13/b13] [a12/b12] [a11/b11] [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro [#1]
l2: $ G ⇒ ∃ a14 ∃ a15 [a13/b13] [a12/b12] [a11/b11] [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b14 $, p := $ ∃ a15 [a13/b13] [a12/b12] [a11/b11] [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l1]
l3: $ G ⇒ ∃ a13 ∃ a14 ∃ a15 [a12/b12] [a11/b11] [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b13 $, p := $ ∃ a14 ∃ a15 [a12/b12] [a11/b11] [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l2]
l4: $ G ⇒ ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a11/b11] [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b12 $, p := $ ∃ a13 ∃ a14 ∃ a15 [a11/b11] [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l3]
l5: $ G ⇒ ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b11 $, p := $ ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a10/b10] [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l4]
l6: $ G ⇒ ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b10 $, p := $ ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a9/b9] [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l5]
l7: $ G ⇒ ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b9 $, p := $ ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a8/b8] [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l6]
l8: $ G ⇒ ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b8 $, p := $ ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a7/b7] [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l7]
l9: $ G ⇒ ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b7 $, p := $ ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a6/b6] [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l8]
l10: $ G ⇒ ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b6 $, p := $ ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a5/b5] [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l9]
l11: $ G ⇒ ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b5 $, p := $ ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a4/b4] [a3/b3] [a2/b2] [a1/b1] p $) [l10]
l12: $ G ⇒ ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a3/b3] [a2/b2] [a1/b1] p $ by ex_intro (t := $ b4 $, p := $ ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a3/b3] [a2/b2] [a1/b1] p $) [l11]
l13: $ G ⇒ ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a2/b2] [a1/b1] p $ by ex_intro (t := $ b3 $, p := $ ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a2/b2] [a1/b1] p $) [l12]
l14: $ G ⇒ ∃ a2 ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a1/b1] p $ by ex_intro (t := $ b2 $, p := $ ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 [a1/b1] p $) [l13]
l15: $ G ⇒ ∃ a1 ∃ a2 ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 p $ by ex_intro (t := $ b1 $, p := $ ∃ a2 ∃ a3 ∃ a4 ∃ a5 ∃ a6 ∃ a7 ∃ a8 ∃ a9 ∃ a10 ∃ a11 ∃ a12 ∃ a13 ∃ a14 ∃ a15 p $) [l14]

-- Lemmas of j2: equations of argument lists.

--| The class of all sets: argument lists are sequences over it.
def j2_vv (.x: set): class = $ {x | x = x} $

lemma j2_vv_in (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ j2_vv $
----
l1: $ G , x = A ⇒ x = x $ by eq_refl
l2: $ G , x = A ⇒ x ∊ j2_vv $ by cab_intro [l1]
l3: $ G , x = A ⇒ x = A $ by ax
l4: $ G , x = A ⇒ A ∈ j2_vv $ by wcel_intro [l3, l2]
l5: $ G ⇒ A ∈ j2_vv $ by isset_elim [#1, l4]

lemma j2_fs (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ S ∈ fseq j2_vv $ > $ G ⇒ scons A S ∈ fseq j2_vv $
----
l1: $ G ⇒ A ∈ j2_vv $ by j2_vv_in [#1]
l2: $ G ⇒ scons A S ∈ fseq j2_vv $ by scons_fseq_c [l1, #2]

--| Class form of `scons_inj`, for sequences.
lemma j2_scons_inj (G: hyps) (A B S T: class):
  $ G ⇒ scons A S = scons B T $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ >
  $ G ⇒ S ∈ fseq j2_vv $ > $ G ⇒ T ∈ fseq j2_vv $ > $ G ⇒ A = B ∧ S = T $
----
l1: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ c ∊ fseq j2_vv $ by ax
l2: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ d ∊ fseq j2_vv $ by ax
l3: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ rel c $ by fseq_rel [l1]
l4: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ rel d $ by fseq_rel [l2]
l5: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ a = A $ by ax
l6: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ b = B $ by ax
l7: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ c = S $ by ax
l8: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ d = T $ by ax
l9: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ scons a c = scons A S $ by scons_eq [l5, l7]
l10: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ scons b d = scons B T $ by scons_eq [l6, l8]
l11: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ scons A S = scons B T $ by weaken [#1]
l12: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ scons a c = scons B T $ by eq_trans [l9, l11]
l13: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ scons B T = scons b d $ by eq_sym [l10]
l14: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ scons a c = scons b d $ by eq_trans [l12, l13]
l15: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ a = b ∧ c = d $ by scons_inj [l3, l4, l14]
l16: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ a = b $ by and_elim_l [l15]
l17: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ c = d $ by and_elim_r [l15]
l18: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ A = a $ by eq_sym [l5]
l19: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ A = b $ by eq_trans [l18, l16]
l20: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ A = B $ by eq_trans [l19, l6]
l21: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ S = c $ by eq_sym [l7]
l22: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ S = d $ by eq_trans [l21, l17]
l23: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ S = T $ by eq_trans [l22, l8]
l24: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv , d = T , d ∊ fseq j2_vv ⇒ A = B ∧ S = T $ by and_intro [l20, l23]
l25: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv ⇒ T ∈ fseq j2_vv $ by weaken [#5]
l26: $ G , a = A , b = B , c = S , c ∊ fseq j2_vv ⇒ A = B ∧ S = T $ by wcel_elim [l25, l24]
l27: $ G , a = A , b = B ⇒ S ∈ fseq j2_vv $ by weaken [#4]
l28: $ G , a = A , b = B ⇒ A = B ∧ S = T $ by wcel_elim [l27, l26]
l29: $ G , a = A ⇒ isset B $ by weaken [#3]
l30: $ G , a = A ⇒ A = B ∧ S = T $ by isset_elim [l29, l28]
l31: $ G ⇒ A = B ∧ S = T $ by isset_elim [#2, l30]

-- Substitution through the atoms and `lveq` (for the normalizer).

--| @rewrite
lemma j2_sb_sty {x: set} (t: set x) (A1 A2 A3 A4 A5: class x):
  $ (⟦ x / t ⟧ (ra_sty A1 A2 A3 A4 A5)) ≐ ra_sty (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_sty , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) ⟩) ≐ ⟨ kr_sty , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) ∅)))) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_deq {x: set} (t: set x) (A1 A2 A3 A4: class x):
  $ (⟦ x / t ⟧ (ra_deq A1 A2 A3 A4)) ≐ ra_deq (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_deq , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩) ≐ ⟨ kr_deq , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) ∅))) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_inst {x: set} (t: set x) (A1 A2 A3 A4: class x):
  $ (⟦ x / t ⟧ (ra_inst A1 A2 A3 A4)) ≐ ra_inst (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_inst , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩) ≐ ⟨ kr_inst , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) ∅))) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_cwf {x: set} (t: set x) (A1 A2 A3 A4 A5 A6 A7 A8: class x):
  $ (⟦ x / t ⟧ (ra_cwf A1 A2 A3 A4 A5 A6 A7 A8)) ≐ ra_cwf (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) (⟦ x / t ⟧ A6) (⟦ x / t ⟧ A7) (⟦ x / t ⟧ A8) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_cwf , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅))))))) ⟩) ≐ ⟨ kr_cwf , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) (scons (⟦ x / t ⟧ A6) (scons (⟦ x / t ⟧ A7) (scons (⟦ x / t ⟧ A8) ∅))))))) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_add {x: set} (t: set x) (A1 A2 A3: class x):
