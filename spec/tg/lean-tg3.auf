l8: $ G , c = ra_sty t1 t2 t3 t4 t5 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_sty t1 t2 t3 t4 t5 $ by ax
l14: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_sty t1 t2 t3 t4 t5 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ pr_sty J $ by lprog3_sty_pr [l15]
l17: $ G , c = ra_sty t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by j2_o_sty [l16, l11]
l18: $ G , c = ra_sty t1 t2 t3 t4 t5 ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by isset_elim [l1, l18]

lemma j2_e_cwf_pi (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v A B A2 u_v: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12: set):
  $ G ⇒ x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ⟩ ∧ ra_add V7 V3 V8 ∈ lrel ∧ ra_closed V8 V9 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V8 V9 V11 ∈ lrel ∧ ra_deq V6 V11 V11 ⟨ kc_srt , scons V12 ∅ ⟩ ∈ J ∧ ra_ulevel V4 V12 ∈ lrel2 $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_add V7 V3 V8 ∈ lrel ∧ ra_closed V8 V9 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V8 V9 V11 ∈ lrel ∧ ra_deq V6 V11 V11 ⟨ kc_srt , scons V12 ∅ ⟩ ∈ J ∧ ra_ulevel V4 V12 ∈ lrel2 $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ⟩ = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_cwf t1 t2 t3 t4 t5 t6 t7 t8) $ by opair_isset
l9: $ G ⇒ isset (ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ ∧ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 = ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 = ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ $ by and_elim_r [l10]
