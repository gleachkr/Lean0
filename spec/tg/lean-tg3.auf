l5: $ G ⇒ ⟨ scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) , ra_ind_wf V1 V3 ⟩ = ⟨ pp , ra_ind_wf t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅))) $ by j2_opair_set_l [l5]
