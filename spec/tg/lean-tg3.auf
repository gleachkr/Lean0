l29: $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by imp_elim [l28, #1]

lrel3_fir_cases
---------------
l1: $ G ⇒ isset (ra_fir t1 t2 t3 t4 t5) $ by opair_isset
l2: $ G , c = ra_fir t1 t2 t3 t4 t5 ⇒ c = ra_fir t1 t2 t3 t4 t5 $ by ax
l3: $ G , c = ra_fir t1 t2 t3 t4 t5 ⇒ ra_fir t1 t2 t3 t4 t5 = c $ by eq_sym [l2]
l4: $ G , c = ra_fir t1 t2 t3 t4 t5 ⇒ ra_fir t1 t2 t3 t4 t5 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_fir t1 t2 t3 t4 t5 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_fir t1 t2 t3 t4 t5 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_fir t1 t2 t3 t4 t5 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_fir t1 t2 t3 t4 t5 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_fir t1 t2 t3 t4 t5 $ by ax
l14: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_fir t1 t2 t3 t4 t5 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ pr_fir J $ by lprog3_fir_pr [l15]
l17: $ G , c = ra_fir t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_o_fir [l16, l11]
l18: $ G , c = ra_fir t1 t2 t3 t4 t5 ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_elim_prop (G: hyps) (J: class) {G_v D v_v: set} (pp t1 t2 t3 x V1 V2 V3: set):
  $ G ⇒ x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_elim_ok V1 V2 V3 ⟩ ∧ lveq V3 ⟨ kc_lz , ∅ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) $
----
l1: $ G ⇒ x = ⟨ ∅ , ra_elim_ok V1 V2 V3 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ lveq V3 ⟨ kc_lz , ∅ ⟩ $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ = ⟨ ∅ , ra_elim_ok V1 V2 V3 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ ∅ , ra_elim_ok V1 V2 V3 ⟩ = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_elim_ok t1 t2 t3) $ by opair_isset
l9: $ G ⇒ isset (ra_elim_ok V1 V2 V3) $ by opair_isset
l10: $ G ⇒ pp = ∅ ∧ ra_elim_ok t1 t2 t3 = ra_elim_ok V1 V2 V3 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_elim_ok t1 t2 t3 = ra_elim_ok V1 V2 V3 $ by and_elim_r [l10]
l13: $ G ⇒ isset V3 $ by isset_var
l14: $ G ⇒ isset V2 $ by isset_var
l15: $ G ⇒ isset V1 $ by isset_var
l16: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l17: $ G ⇒ isset t3 $ by isset_var
l18: $ G ⇒ scons t3 ∅ ∈ fseq j2_vv $ by j2_fs [l17, l16]
l19: $ G ⇒ isset t2 $ by isset_var
l20: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t1 $ by isset_var
l22: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ scons V3 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l16]
l24: $ G ⇒ scons V2 (scons V3 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l23]
l25: $ G ⇒ scons V1 (scons V2 (scons V3 ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l24]
l26: $ G ⇒ kr_elim_ok ∈ ω $ by kr_elim_ok_omega
l27: $ G ⇒ isset kr_elim_ok $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l22]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons V3 ∅))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_elim_ok = kr_elim_ok ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by opair_inj_c [l12, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by j2_scons_inj [l31, l21, l15, l20, l24]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 ∅ = scons V3 ∅ $ by j2_scons_inj [l34, l19, l14, l18, l23]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 ∅ = scons V3 ∅ $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V3 ∧ ∅ = ∅ $ by j2_scons_inj [l37, l17, l13, l16, l16]
l39: $ G ⇒ t3 = V3 $ by and_elim_l [l38]
l40: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ lveq V3 ⟨ kc_lz , ∅ ⟩ $ by j2_and3 [l33, l36, l39, l2]
l41: $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) $ by j2_exi3 [l40]

lemma j2_d_elim_prop (G: hyps) (J: class) {G_v D v_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x ∊ cl_elim_prop ⇒ x ∊ cl_elim_prop $ by ax
l2: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x ∊ cl_elim_prop ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) $ by j2_e_elim_prop [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x ∊ cl_elim_prop ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) $ by j2_ex3 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma j2_e_elim_large (G: hyps) (J: class) {G_v D v_v: set} (pp t1 t2 t3 x V1 V2 V3: set):
  $ G ⇒ x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_large V1 V2) ∅ , ra_elim_ok V1 V2 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $
----
l1: $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ = ⟨ scons (ra_large V1 V2) ∅ , ra_elim_ok V1 V2 V3 ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ scons (ra_large V1 V2) ∅ , ra_elim_ok V1 V2 V3 ⟩ = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (scons (ra_large V1 V2) ∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_elim_ok t1 t2 t3) $ by opair_isset
l7: $ G ⇒ isset (ra_elim_ok V1 V2 V3) $ by opair_isset
l8: $ G ⇒ pp = scons (ra_large V1 V2) ∅ ∧ ra_elim_ok t1 t2 t3 = ra_elim_ok V1 V2 V3 $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = scons (ra_large V1 V2) ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_elim_ok t1 t2 t3 = ra_elim_ok V1 V2 V3 $ by and_elim_r [l8]
l11: $ G ⇒ isset V3 $ by isset_var
l12: $ G ⇒ isset V2 $ by isset_var
l13: $ G ⇒ isset V1 $ by isset_var
l14: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l15: $ G ⇒ isset t3 $ by isset_var
l16: $ G ⇒ scons t3 ∅ ∈ fseq j2_vv $ by j2_fs [l15, l14]
l17: $ G ⇒ isset t2 $ by isset_var
l18: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq j2_vv $ by j2_fs [l17, l16]
l19: $ G ⇒ isset t1 $ by isset_var
l20: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ scons V3 ∅ ∈ fseq j2_vv $ by j2_fs [l11, l14]
l22: $ G ⇒ scons V2 (scons V3 ∅) ∈ fseq j2_vv $ by j2_fs [l12, l21]
l23: $ G ⇒ scons V1 (scons V2 (scons V3 ∅)) ∈ fseq j2_vv $ by j2_fs [l13, l22]
l24: $ G ⇒ kr_elim_ok ∈ ω $ by kr_elim_ok_omega
l25: $ G ⇒ isset kr_elim_ok $ by wcel_isset [l24]
l26: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l20]
l27: $ G ⇒ isset (scons V1 (scons V2 (scons V3 ∅))) $ by wcel_isset [l23]
l28: $ G ⇒ kr_elim_ok = kr_elim_ok ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by opair_inj_c [l10, l25, l26, l25, l27]
l29: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by and_elim_r [l28]
l30: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by j2_scons_inj [l29, l19, l13, l18, l22]
l31: $ G ⇒ t1 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by and_elim_r [l30]
l33: $ G ⇒ t2 = V2 ∧ scons t3 ∅ = scons V3 ∅ $ by j2_scons_inj [l32, l17, l12, l16, l21]
l34: $ G ⇒ t2 = V2 $ by and_elim_l [l33]
l35: $ G ⇒ scons t3 ∅ = scons V3 ∅ $ by and_elim_r [l33]
l36: $ G ⇒ t3 = V3 ∧ ∅ = ∅ $ by j2_scons_inj [l35, l15, l11, l14, l14]
l37: $ G ⇒ t3 = V3 $ by and_elim_l [l36]
l38: $ G ⇒ crn pp = crn (scons (ra_large V1 V2) ∅) $ by crn_eq [l9]
l39: $ G ⇒ crn (scons (ra_large V1 V2) ∅) ⊆ lrel3 J $ by subset_eq_l [l38, #3]
l40: $ G ⇒ isset (ra_large V1 V2) $ by opair_isset
l41: $ G ⇒ ra_large V1 V2 ∈ lrel3 J $ by crn_scons_head [l40, l39]
l42: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ ra_large V1 V2 ∈ lrel3 J $ by j2_and3 [l31, l34, l37, l41]
l43: $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by j2_exi3 [l42]

lemma j2_d_elim_large (G: hyps) (J: class) {G_v D v_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x ∊ cl_elim_large ⇒ x ∊ cl_elim_large $ by ax
l2: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x ∊ cl_elim_large ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by j2_e_elim_large [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ , x ∊ cl_elim_large ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by j2_ex3 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_elim_ok (G: hyps) (J: class) {G_v D v_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ pr_elim_ok $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large $ by ax
l2: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by j2_d_elim_large [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large → ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) $ by ax
l6: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∨ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop $ by ax
l8: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l9: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) $ by j2_d_elim_prop [l7, l8]
l10: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large $ by ax
l12: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large → ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_large ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_elim_ok t1 t2 t3 ⟩ ∈ cl_elim_prop ∪ (cl_elim_large) → ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by imp_intro [l15]
l17: $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by imp_elim [l16, #1]

lrel3_elim_ok_cases
-------------------
l1: $ G ⇒ isset (ra_elim_ok t1 t2 t3) $ by opair_isset
l2: $ G , c = ra_elim_ok t1 t2 t3 ⇒ c = ra_elim_ok t1 t2 t3 $ by ax
l3: $ G , c = ra_elim_ok t1 t2 t3 ⇒ ra_elim_ok t1 t2 t3 = c $ by eq_sym [l2]
l4: $ G , c = ra_elim_ok t1 t2 t3 ⇒ ra_elim_ok t1 t2 t3 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_elim_ok t1 t2 t3 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_elim_ok t1 t2 t3 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_elim_ok t1 t2 t3 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_elim_ok t1 t2 t3 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_elim_ok t1 t2 t3 $ by ax
l14: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_elim_ok t1 t2 t3 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_elim_ok t1 t2 t3 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_elim_ok t1 t2 t3 ⟩ ∈ pr_elim_ok $ by lprog3_elim_ok_pr [l15]
l17: $ G , c = ra_elim_ok t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by j2_o_elim_ok [l16, l11]
l18: $ G , c = ra_elim_ok t1 t2 t3 ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ lveq v_v ⟨ kc_lz , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ v_v (t1 = G_v ∧ t2 = D ∧ t3 = v_v ∧ ra_large G_v D ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_fprops_z (G: hyps) (J: class) {D n_v np Ctx d_v K: set} (pp t1 t2 t3 t4 t5 t6 t7 x V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_fprops V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V6 ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) $
----
l1: $ G ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ ∅ , ra_fprops V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V6 ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_fprops V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V6 ⟩ = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_fprops t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l7: $ G ⇒ isset (ra_fprops V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V6) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_fprops t1 t2 t3 t4 t5 t6 t7 = ra_fprops V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V6 $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_fprops t1 t2 t3 t4 t5 t6 t7 = ra_fprops V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V6 $ by and_elim_r [l8]
l11: $ G ⇒ isset V6 $ by isset_var
l12: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l13: $ G ⇒ isset V5 $ by isset_var
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ isset V3 $ by isset_var
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ isset V1 $ by isset_var
l18: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l19: $ G ⇒ isset t7 $ by isset_var
l20: $ G ⇒ scons t7 ∅ ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t6 $ by isset_var
l22: $ G ⇒ scons t6 (scons t7 ∅) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ isset t5 $ by isset_var
l24: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) ∈ fseq j2_vv $ by j2_fs [l23, l22]
l25: $ G ⇒ isset t4 $ by isset_var
l26: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) ∈ fseq j2_vv $ by j2_fs [l25, l24]
l27: $ G ⇒ isset t3 $ by isset_var
l28: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) ∈ fseq j2_vv $ by j2_fs [l27, l26]
l29: $ G ⇒ isset t2 $ by isset_var
l30: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) ∈ fseq j2_vv $ by j2_fs [l29, l28]
l31: $ G ⇒ isset t1 $ by isset_var
l32: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq j2_vv $ by j2_fs [l31, l30]
l33: $ G ⇒ scons V6 ∅ ∈ fseq j2_vv $ by j2_fs [l11, l18]
l34: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅) ∈ fseq j2_vv $ by j2_fs [l12, l33]
l35: $ G ⇒ scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)) ∈ fseq j2_vv $ by j2_fs [l13, l34]
l36: $ G ⇒ scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅))) ∈ fseq j2_vv $ by j2_fs [l14, l35]
l37: $ G ⇒ scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)))) ∈ fseq j2_vv $ by j2_fs [l15, l36]
l38: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅))))) ∈ fseq j2_vv $ by j2_fs [l16, l37]
l39: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)))))) ∈ fseq j2_vv $ by j2_fs [l17, l38]
l40: $ G ⇒ kr_fprops ∈ ω $ by kr_fprops_omega
l41: $ G ⇒ isset kr_fprops $ by wcel_isset [l40]
l42: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l32]
l43: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅))))))) $ by wcel_isset [l39]
l44: $ G ⇒ kr_fprops = kr_fprops ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)))))) $ by opair_inj_c [l10, l41, l42, l41, l43]
l45: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)))))) $ by and_elim_r [l44]
l46: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅))))) $ by j2_scons_inj [l45, l31, l17, l30, l38]
l47: $ G ⇒ t1 = V1 $ by and_elim_l [l46]
l48: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅))))) $ by and_elim_r [l46]
l49: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)))) $ by j2_scons_inj [l48, l29, l16, l28, l37]
l50: $ G ⇒ t2 = V2 $ by and_elim_l [l49]
l51: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)))) $ by and_elim_r [l49]
l52: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅))) $ by j2_scons_inj [l51, l27, l15, l26, l36]
l53: $ G ⇒ t3 = V3 $ by and_elim_l [l52]
l54: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅))) $ by and_elim_r [l52]
l55: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)) $ by j2_scons_inj [l54, l25, l14, l24, l35]
l56: $ G ⇒ t4 = V4 $ by and_elim_l [l55]
l57: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅)) $ by and_elim_r [l55]
l58: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅) $ by j2_scons_inj [l57, l23, l13, l22, l34]
l59: $ G ⇒ t5 = V5 $ by and_elim_l [l58]
l60: $ G ⇒ scons t6 (scons t7 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V6 ∅) $ by and_elim_r [l58]
l61: $ G ⇒ t6 = ⟨ kc_nz , ∅ ⟩ ∧ scons t7 ∅ = scons V6 ∅ $ by j2_scons_inj [l60, l21, l12, l20, l33]
l62: $ G ⇒ t6 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l61]
l63: $ G ⇒ scons t7 ∅ = scons V6 ∅ $ by and_elim_r [l61]
l64: $ G ⇒ t7 = V6 ∧ ∅ = ∅ $ by j2_scons_inj [l63, l19, l11, l18, l18]
l65: $ G ⇒ t7 = V6 $ by and_elim_l [l64]
l66: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = V6 $ by j2_and6 [l47, l50, l53, l56, l59, l62, l65]
l67: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) $ by j2_exi6 [l66]

lemma j2_d_fprops_z (G: hyps) (J: class) {D n_v np Ctx d_v K: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_z $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) $
----
l1: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_fprops_z ⇒ x ∊ cl_fprops_z $ by ax
l2: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_fprops_z ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ ⇒ x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ ⇒ x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) $ by j2_e_fprops_z [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_fprops_z ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) $ by j2_ex6 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) $ by wcel_elim [#1, l7]

lemma j2_e_fprops_s (G: hyps) (J: class) {D n_v np Ctx d_v cnt k_v A A2 B: set} (pp t1 t2 t3 t4 t5 t6 t7 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10: set):
  $ G ⇒ x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅ , ra_fprops V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ⟩ ∧ ra_add V5 V3 V7 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V7 V8 V9 ∈ lrel ∧ ra_deq V4 V9 V9 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅ , ra_fprops V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_add V5 V3 V7 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V7 V8 V9 ∈ lrel ∧ ra_deq V4 V9 V9 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅ , ra_fprops V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅ , ra_fprops V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ⟩ = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_fprops t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l9: $ G ⇒ isset (ra_fprops V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅ ∧ ra_fprops t1 t2 t3 t4 t5 t6 t7 = ra_fprops V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_fprops t1 t2 t3 t4 t5 t6 t7 = ra_fprops V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ $ by and_elim_r [l10]
