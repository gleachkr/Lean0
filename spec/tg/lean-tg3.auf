l88: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_exi12 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, b9 := $ V9 $, b10 := $ V10 $, b11 := $ V11 $, b12 := $ V12 $, p := $ t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J $) [l87]

lemma j2_d_cwf_pi (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v A B A2 u_v: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi J ⇒ x ∊ cl_cwf_pi J $ by ax
l2: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j (x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ⇒ x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_e_cwf_pi [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_ex12 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_e_cwf_res (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v K: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 x V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 V8 ⟩ ∧ ra_indapp V1 V2 V3 V7 V8 V5 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel) $
