l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V5 ∅)) $ by j2_scons_inj [l42, l25, l16, l24, l31]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V5 ∅)) $ by and_elim_r [l43]
