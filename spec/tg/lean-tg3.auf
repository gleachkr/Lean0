l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ scons w ∅ = scons A5 ∅ $ by scons_eq [l5, l12]
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ kc_srt , scons w ∅ ⟩ = ⟨ kc_srt , scons A5 ∅ ⟩ $ by opair_eq [l11, l13]
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ = ra_deq A3 A4 A4 ⟨ kc_srt , scons A5 ∅ ⟩ $ by ra_deq_eq [l3, l4, l4, l14]
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_deq A3 A4 A4 ⟨ kc_srt , scons A5 ∅ ⟩ = ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ $ by eq_sym [l15]
l17: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by wcel_eq_l [l16, l10]
l18: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ $ by ax
l19: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by weaken [l17]
l20: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ra_capp z y u ∈ lrel $ by weaken [l9]
l21: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by and_intro [l20, l19]
l22: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by and_intro [l18, l21]
l23: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l22]
l24: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l23]
l25: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l24]
l26: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l25]
l27: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l26]
l28: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ x ∊ cl_ctx_wf_cons J $ by cab_intro [l27]
l29: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by wcel_intro [l18, l28]
l30: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ isset ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ $ by opair_isset
l31: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l30, l29]
l32: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_ctx_wf y z = ra_ctx_wf A1 A2 $ by ra_ctx_wf_eq [l1, l2]
l33: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ scons (ra_ctx_wf y z) ∅ = scons (ra_ctx_wf A1 A2) ∅ $ by scons_eq [l32, l12]
l34: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ kc_cons = kc_cons $ by eq_refl
l35: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ scons z ∅ = scons A2 ∅ $ by scons_eq [l2, l12]
l36: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ scons v (scons z ∅) = scons A4 (scons A2 ∅) $ by scons_eq [l4, l35]
l37: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ kc_cons , scons v (scons z ∅) ⟩ = ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ $ by opair_eq [l34, l36]
l38: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ = ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ $ by ra_ctx_wf_eq [l1, l37]
l39: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ = ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ $ by opair_eq [l33, l38]
l40: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by wcel_eq_l [l39, l31]
l41: $ G ⇒ isset A5 $ by wcel_isset [#5]
l42: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l41, l40]
l43: $ G ⇒ isset A4 $ by wcel_isset [#4]
l44: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l43, l42]
l45: $ G ⇒ isset A3 $ by wcel_isset [#3]
l46: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l45, l44]
l47: $ G ⇒ isset A2 $ by wcel_isset [#2]
l48: $ G , y = A1 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l47, l46]
l49: $ G ⇒ isset A1 $ by wcel_isset [#1]
l50: $ G ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l49, l48]
l51: $ G ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) $ by j1_in_r [l50]
l52: $ G ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ j1_top J $ by j1_pr_ctx_wf [l51]
l53: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l54: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l55: $ G ⇒ (ra_ctx_wf A1 A2) ∈ latoms $ by j1_lrel3_lat [#6]
l56: $ G ⇒ scons (ra_ctx_wf A1 A2) ∅ ∈ fseq latoms $ by scons_fseq_c [l55, l53]
l57: $ G ⇒ crn (scons (ra_ctx_wf A1 A2) ∅) ⊆ lrel3 J $ by crn_scons_sub [#6, l54]
l58: $ G ⇒ isset ω $ by omega_set
l59: $ G ⇒ kc_cons ∈ ω $ by kc_cons_omega
l60: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l61: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l60]
l62: $ G ⇒ scons A4 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#4, l61]
l63: $ G ⇒ ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ∈ trees ω $ by trees_intro_c [l58, l59, l62]
l64: $ G ⇒ ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ∈ latoms $ by j1_ra_ctx_wf [#1, l63]
l65: $ G ⇒ ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ∈ lrel3 J $ by j1_horn [l52, l56, l64, l57]

lemma j1_pr_tys_ty (G: hyps) (J X: class): $ G ⇒ X ∈ pr_tys_ty J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_tys_ty J) ∪ pr_tys_ok $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ (pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ ((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok)) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ (((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J)))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_l [l4]

lemma j1_ra_tys_ty (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_tys_ty A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_tys_ty ∈ ω $ by kr_tys_ty_omega
l5: $ G ⇒ ra_tys_ty A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lrel3_tys_ty_nil
----------------
l1: $ G , y = A1 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ $ by ax
l3: $ G , y = A1 , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ∃ y (x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩) $ by ex_intro [l2]
l4: $ G , y = A1 , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x ∊ cl_tys_ty_nil $ by cab_intro [l3]
l5: $ G , y = A1 , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil $ by wcel_intro [l2, l4]
l6: $ G , y = A1 ⇒ isset ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ $ by opair_isset
l7: $ G , y = A1 ⇒ ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil $ by isset_elim [l6, l5]
l8: $ G , y = A1 ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , y = A1 ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tnil , ∅ ⟩ $ by eq_refl
l10: $ G , y = A1 ⇒ ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ = ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ $ by ra_tys_ty_eq [l1, l9]
l11: $ G , y = A1 ⇒ ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ = ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ $ by opair_eq [l8, l10]
l12: $ G , y = A1 ⇒ ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil $ by wcel_eq_l [l11, l7]
l13: $ G ⇒ isset A1 $ by wcel_isset [#1]
l14: $ G ⇒ ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil $ by isset_elim [l13, l12]
l15: $ G ⇒ ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) $ by j1_in_l [l14]
l16: $ G ⇒ ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ j1_top J $ by j1_pr_tys_ty [l15]
l17: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l18: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
l21: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l22: $ G ⇒ ⟨ kc_tnil , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l19, l20, l21]
l23: $ G ⇒ ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ∈ latoms $ by j1_ra_tys_ty [#1, l22]
l24: $ G ⇒ ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ∈ lrel3 J $ by j1_horn [l16, l17, l23, l18]

lrel3_tys_ty_cons
-----------------
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ v = A4 $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ w = A5 $ by ax
l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ a = A6 $ by ax
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ b = A7 $ by ax
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_isort A2 A7 A6 ∈ lrel $ by weaken [#9]
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_isort z b a = ra_isort A2 A7 A6 $ by ra_isort_eq [l2, l7, l6]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_isort A2 A7 A6 = ra_isort z b a $ by eq_sym [l9]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_isort z b a ∈ lrel $ by wcel_eq_l [l10, l8]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_deq A1 A2 A2 ⟨ kc_srt , scons A5 ∅ ⟩ ∈ J $ by weaken [#10]
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ kc_srt = kc_srt $ by eq_refl
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ∅ = ∅ $ by eq_refl
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ scons w ∅ = scons A5 ∅ $ by scons_eq [l5, l14]
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ⟨ kc_srt , scons w ∅ ⟩ = ⟨ kc_srt , scons A5 ∅ ⟩ $ by opair_eq [l13, l15]
