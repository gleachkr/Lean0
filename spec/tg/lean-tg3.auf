l4: $ G ⇒ kr_sty ⊆ kr_mul_eqs $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_sty ⊆ kr_bitop_eqs $ by subset_trans [l4, l3]

-- Each clause is in its relation's label range, hence so is each relation.

lemma j2_k_sty_nil (G: hyps): $ G ⇒ cl_sty_nil ⊆ j2_lab kr_sty (suc kr_sty) $
----
l1: $ G , x ∊ cl_sty_nil ⇒ x ∊ cl_sty_nil $ by ax
l2: $ G , x ∊ cl_sty_nil ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_sty y z u z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ x = ⟨ ∅ , ra_sty y z u z u ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ kr_sty ∈ ω $ by kr_sty_omega
l5: $ G , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ x ∊ j2_lab kr_sty (suc kr_sty) $ by j2_lab_self [l3, l4]
l6: $ G , x ∊ cl_sty_nil ⇒ x ∊ j2_lab kr_sty (suc kr_sty) $ by j2_ex3 [l2, l5]
l7: $ G ⇒ cl_sty_nil ⊆ j2_lab kr_sty (suc kr_sty) $ by subset_intro [l6]

lemma j2_k_sty_app (G: hyps) (J: class): $ G ⇒ cl_sty_app J ⊆ j2_lab kr_sty (suc kr_sty) $
----
l1: $ G , x ∊ cl_sty_app J ⇒ x ∊ cl_sty_app J $ by ax
l2: $ G , x ∊ cl_sty_app J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ kr_sty ∈ ω $ by kr_sty_omega
l6: $ G , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ x ∊ j2_lab kr_sty (suc kr_sty) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_sty_app J ⇒ x ∊ j2_lab kr_sty (suc kr_sty) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ cl_sty_app J ⊆ j2_lab kr_sty (suc kr_sty) $ by subset_intro [l7]

lemma j2_p_sty (G: hyps) (J: class): $ G ⇒ pr_sty J ⊆ j2_lab kr_sty (suc kr_sty) $
----
l1: $ G ⇒ cl_sty_app J ⊆ j2_lab kr_sty (suc kr_sty) $ by j2_k_sty_app
l2: $ G ⇒ cl_sty_nil ⊆ j2_lab kr_sty (suc kr_sty) $ by j2_k_sty_nil
l3: $ G ⇒ pr_sty J ⊆ j2_lab kr_sty (suc kr_sty) $ by cun_least [l2, l1]

lemma j2_k_cwf_pi (G: hyps) (J: class): $ G ⇒ cl_cwf_pi J ⊆ j2_lab kr_cwf (suc kr_cwf) $
----
l1: $ G , x ∊ cl_cwf_pi J ⇒ x ∊ cl_cwf_pi J $ by ax
l2: $ G , x ∊ cl_cwf_pi J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j (x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ⇒ kr_cwf ∈ ω $ by kr_cwf_omega
l6: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ⇒ x ∊ j2_lab kr_cwf (suc kr_cwf) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_cwf_pi J ⇒ x ∊ j2_lab kr_cwf (suc kr_cwf) $ by j2_ex12 [l2, l6]
l8: $ G ⇒ cl_cwf_pi J ⊆ j2_lab kr_cwf (suc kr_cwf) $ by subset_intro [l7]

lemma j2_k_cwf_res (G: hyps): $ G ⇒ cl_cwf_res ⊆ j2_lab kr_cwf (suc kr_cwf) $
----
l1: $ G , x ∊ cl_cwf_res ⇒ x ∊ cl_cwf_res $ by ax
l2: $ G , x ∊ cl_cwf_res ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel ⇒ x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel $ by ax
l4: $ G , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel ⇒ x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel ⇒ kr_cwf ∈ ω $ by kr_cwf_omega
l6: $ G , x = ⟨ ∅ , ra_cwf y z u v w a b c ⟩ ∧ ra_indapp y z u b c w ∈ lrel ⇒ x ∊ j2_lab kr_cwf (suc kr_cwf) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_cwf_res ⇒ x ∊ j2_lab kr_cwf (suc kr_cwf) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ cl_cwf_res ⊆ j2_lab kr_cwf (suc kr_cwf) $ by subset_intro [l7]

lemma j2_p_cwf (G: hyps) (J: class): $ G ⇒ pr_cwf J ⊆ j2_lab kr_cwf (suc kr_cwf) $
----
l1: $ G ⇒ cl_cwf_res ⊆ j2_lab kr_cwf (suc kr_cwf) $ by j2_k_cwf_res
l2: $ G ⇒ cl_cwf_pi J ⊆ j2_lab kr_cwf (suc kr_cwf) $ by j2_k_cwf_pi
l3: $ G ⇒ pr_cwf J ⊆ j2_lab kr_cwf (suc kr_cwf) $ by cun_least [l2, l1]

lemma j2_k_ctors_wf_nil (G: hyps): $ G ⇒ cl_ctors_wf_nil ⊆ j2_lab kr_ctors_wf (suc kr_ctors_wf) $
----
l1: $ G , x ∊ cl_ctors_wf_nil ⇒ x ∊ cl_ctors_wf_nil $ by ax
l2: $ G , x ∊ cl_ctors_wf_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ kr_ctors_wf ∈ ω $ by kr_ctors_wf_omega
l5: $ G , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x ∊ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by j2_lab_self [l3, l4]
l6: $ G , x ∊ cl_ctors_wf_nil ⇒ x ∊ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by j2_ex6 [l2, l5]
l7: $ G ⇒ cl_ctors_wf_nil ⊆ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by subset_intro [l6]

lemma j2_k_ctors_wf_cons (G: hyps): $ G ⇒ cl_ctors_wf_cons ⊆ j2_lab kr_ctors_wf (suc kr_ctors_wf) $
----
l1: $ G , x ∊ cl_ctors_wf_cons ⇒ x ∊ cl_ctors_wf_cons $ by ax
l2: $ G , x ∊ cl_ctors_wf_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ⇒ kr_ctors_wf ∈ ω $ by kr_ctors_wf_omega
l5: $ G , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ⇒ x ∊ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by j2_lab_self [l3, l4]
l6: $ G , x ∊ cl_ctors_wf_cons ⇒ x ∊ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by j2_ex8 [l2, l5]
l7: $ G ⇒ cl_ctors_wf_cons ⊆ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by subset_intro [l6]

lemma j2_p_ctors_wf (G: hyps): $ G ⇒ pr_ctors_wf ⊆ j2_lab kr_ctors_wf (suc kr_ctors_wf) $
----
l1: $ G ⇒ cl_ctors_wf_cons ⊆ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by j2_k_ctors_wf_cons
l2: $ G ⇒ cl_ctors_wf_nil ⊆ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by j2_k_ctors_wf_nil
l3: $ G ⇒ pr_ctors_wf ⊆ j2_lab kr_ctors_wf (suc kr_ctors_wf) $ by cun_least [l2, l1]

lemma j2_k_tys_wf_nil (G: hyps): $ G ⇒ cl_tys_wf_nil ⊆ j2_lab kr_tys_wf (suc kr_tys_wf) $
----
l1: $ G , x ∊ cl_tys_wf_nil ⇒ x ∊ cl_tys_wf_nil $ by ax
l2: $ G , x ∊ cl_tys_wf_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ kr_tys_wf ∈ ω $ by kr_tys_wf_omega
