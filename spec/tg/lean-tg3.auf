l134: $ G ⇒ ra_land_eqs A1 A2 A3 A4 A5 A6 ∈ lrel3 J $ by j1_horn [l127, l131, l133, l132]

lemma j1_pr_lor_eqs (G: hyps) (J X: class): $ G ⇒ X ∈ pr_lor_eqs J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_lor_eqs J) ∪ (pr_xor_eqs J) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J)) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ ((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J)))) $ by j1_in_r [l3]
l5: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_r [l4]

lemma j1_ra_lor_eqs (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ > $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_lor_eqs A1 A2 A3 A4 A5 A6 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A6 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#6, l1]
l3: $ G ⇒ scons A5 (scons A6 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#5, l2]
l4: $ G ⇒ scons A4 (scons A5 (scons A6 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#4, l3]
l5: $ G ⇒ scons A3 (scons A4 (scons A5 (scons A6 ∅))) ∈ fseq (trees ω) $ by scons_fseq_c [#3, l4]
l6: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 (scons A6 ∅)))) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l5]
l7: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 ∅))))) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l6]
l8: $ G ⇒ kr_lor_eqs ∈ ω $ by kr_lor_eqs_omega
l9: $ G ⇒ ra_lor_eqs A1 A2 A3 A4 A5 A6 ∈ latoms $ by cxp_intro_c [l8, l7]

