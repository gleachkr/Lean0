l44: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_pred_eqs y z ⟩ ⇒ x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J ∧ ra_deq y ⟨ kc_app , scons z (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ ⟨ kc_app , scons z (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J $ by and_intro [l36, l43]
l45: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_pred_eqs y z ⟩ ⇒ ∃ z (x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J ∧ ra_deq y ⟨ kc_app , scons z (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ ⟨ kc_app , scons z (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J) $ by ex_intro [l44]
l46: $ G , y = A1 , z = A2 , x = ⟨ ∅ , ra_pred_eqs y z ⟩ ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J ∧ ra_deq y ⟨ kc_app , scons z (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ ⟨ kc_app , scons z (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J) $ by ex_intro [l45]
