l11: $ G ⇒ pp = scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) $ by and_elim_l [l10]
