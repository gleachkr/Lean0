lemma j2_d_shl_eqs_i (G: hyps) (J: class) {G_v f_v fm fa: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_shl_eqs t1 t2 t3 t4 ⟩ ∈ cl_shl_eqs_i J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
