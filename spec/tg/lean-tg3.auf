lemma j2_k_tys_wf_cons (G: hyps): $ G ⇒ cl_tys_wf_cons ⊆ j2_lab kr_tys_wf (suc kr_tys_wf) $
----
l1: $ G , x ∊ cl_tys_wf_cons ⇒ x ∊ cl_tys_wf_cons $ by ax
l2: $ G , x ∊ cl_tys_wf_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_ctors_wf y z u v a c g) (scons (ra_tys_wf y z u v ⟨ kc_s , scons a ∅ ⟩ c i) ∅) , ra_tys_wf y z u v a c ⟨ kc_tcons , scons f (scons g (scons i ∅)) ⟩ ⟩ ∧ ra_isort f b w ∈ lrel ∧ lveq w v) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ctors_wf y z u v a c g) (scons (ra_tys_wf y z u v ⟨ kc_s , scons a ∅ ⟩ c i) ∅) , ra_tys_wf y z u v a c ⟨ kc_tcons , scons f (scons g (scons i ∅)) ⟩ ⟩ ∧ ra_isort f b w ∈ lrel ∧ lveq w v ⇒ x = ⟨ scons (ra_ctors_wf y z u v a c g) (scons (ra_tys_wf y z u v ⟨ kc_s , scons a ∅ ⟩ c i) ∅) , ra_tys_wf y z u v a c ⟨ kc_tcons , scons f (scons g (scons i ∅)) ⟩ ⟩ ∧ ra_isort f b w ∈ lrel ∧ lveq w v $ by ax
l4: $ G , x = ⟨ scons (ra_ctors_wf y z u v a c g) (scons (ra_tys_wf y z u v ⟨ kc_s , scons a ∅ ⟩ c i) ∅) , ra_tys_wf y z u v a c ⟨ kc_tcons , scons f (scons g (scons i ∅)) ⟩ ⟩ ∧ ra_isort f b w ∈ lrel ∧ lveq w v ⇒ x = ⟨ scons (ra_ctors_wf y z u v a c g) (scons (ra_tys_wf y z u v ⟨ kc_s , scons a ∅ ⟩ c i) ∅) , ra_tys_wf y z u v a c ⟨ kc_tcons , scons f (scons g (scons i ∅)) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_ctors_wf y z u v a c g) (scons (ra_tys_wf y z u v ⟨ kc_s , scons a ∅ ⟩ c i) ∅) , ra_tys_wf y z u v a c ⟨ kc_tcons , scons f (scons g (scons i ∅)) ⟩ ⟩ ∧ ra_isort f b w ∈ lrel ∧ lveq w v ⇒ kr_tys_wf ∈ ω $ by kr_tys_wf_omega
l6: $ G , x = ⟨ scons (ra_ctors_wf y z u v a c g) (scons (ra_tys_wf y z u v ⟨ kc_s , scons a ∅ ⟩ c i) ∅) , ra_tys_wf y z u v a c ⟨ kc_tcons , scons f (scons g (scons i ∅)) ⟩ ⟩ ∧ ra_isort f b w ∈ lrel ∧ lveq w v ⇒ x ∊ j2_lab kr_tys_wf (suc kr_tys_wf) $ by j2_lab_self [l4, l5]
