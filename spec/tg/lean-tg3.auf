lemma j2_d_beq_eqs_i (G: hyps) (J: class) {G_v f_v B t_v u_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_beq_eqs t1 t2 t3 t4 t5 ⟩ ∈ cl_beq_eqs_i J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ B ∃ t_v ∃ u_v (t1 = G_v ∧ t2 = f_v ∧ t3 = B ∧ t4 = t_v ∧ t5 = u_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ t_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ u_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons B ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq G_v ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons tr_nat_zero ∅) ⟩ (scons tr_nat_zero ∅) ⟩ t_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons tr_nat_zero ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c0 ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ B ∈ J) $
