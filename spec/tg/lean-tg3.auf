--| An equation moved along an equality of its right side.
lemma j3_eqimp (G: hyps) (X Y Z: class): $ G ⇒ Y = Z $ > $ G ⇒ X = Y → X = Z $
----
l1: $ G , X = Y ⇒ X = Y $ by ax
l2: $ G , X = Y ⇒ Y = Z $ by weaken [#1]
l3: $ G , X = Y ⇒ X = Z $ by eq_trans [l1, l2]
l4: $ G ⇒ X = Y → X = Z $ by imp_intro [l3]

--| A membership of an atom moved along equalities of its arguments.
lemma j3_wimp_closed (G: hyps) (C X1 X2 Y1 Y2: class):
  $ G ⇒ X1 = Y1 $ > $ G ⇒ X2 = Y2 $ >
  $ G ⇒ ra_closed X1 X2 ∈ C → ra_closed Y1 Y2 ∈ C $
----
l1: $ G ⇒ ra_closed X1 X2 = ra_closed Y1 Y2 $ by ra_closed_eq [#1, #2]
l2: $ G , ra_closed X1 X2 ∈ C ⇒ ra_closed X1 X2 ∈ C $ by ax
l3: $ G , ra_closed X1 X2 ∈ C ⇒ ra_closed X1 X2 = ra_closed Y1 Y2 $ by weaken [l1]
l4: $ G , ra_closed X1 X2 ∈ C ⇒ ra_closed Y1 Y2 ∈ C $ by wcel_eq_l [l3, l2]
l5: $ G ⇒ ra_closed X1 X2 ∈ C → ra_closed Y1 Y2 ∈ C $ by imp_intro [l4]

--| A membership of an atom moved along equalities of its arguments.
lemma j3_wimp_deq (G: hyps) (C X1 X2 X3 X4 Y1 Y2 Y3 Y4: class):
  $ G ⇒ X1 = Y1 $ > $ G ⇒ X2 = Y2 $ > $ G ⇒ X3 = Y3 $ > $ G ⇒ X4 = Y4 $ >
  $ G ⇒ ra_deq X1 X2 X3 X4 ∈ C → ra_deq Y1 Y2 Y3 Y4 ∈ C $
----
l1: $ G ⇒ ra_deq X1 X2 X3 X4 = ra_deq Y1 Y2 Y3 Y4 $ by ra_deq_eq [#1, #2, #3, #4]
l2: $ G , ra_deq X1 X2 X3 X4 ∈ C ⇒ ra_deq X1 X2 X3 X4 ∈ C $ by ax
l3: $ G , ra_deq X1 X2 X3 X4 ∈ C ⇒ ra_deq X1 X2 X3 X4 = ra_deq Y1 Y2 Y3 Y4 $ by weaken [l1]
l4: $ G , ra_deq X1 X2 X3 X4 ∈ C ⇒ ra_deq Y1 Y2 Y3 Y4 ∈ C $ by wcel_eq_l [l3, l2]
l5: $ G ⇒ ra_deq X1 X2 X3 X4 ∈ C → ra_deq Y1 Y2 Y3 Y4 ∈ C $ by imp_intro [l4]

--| Congruence of a labelled node with 2 children.
lemma j3_node_2 (G: hyps) (K X1 X2 Y1 Y2: class):
  $ G ⇒ X1 = Y1 $ > $ G ⇒ X2 = Y2 $ >
  $ G ⇒ ⟨ K , scons X1 (scons X2 ∅) ⟩ = ⟨ K , scons Y1 (scons Y2 ∅) ⟩ $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons X2 ∅ = scons Y2 ∅ $ by scons_eq [#2, l1]
l3: $ G ⇒ scons X1 (scons X2 ∅) = scons Y1 (scons Y2 ∅) $ by scons_eq [#1, l2]
l4: $ G ⇒ K = K $ by eq_refl
l5: $ G ⇒ ⟨ K , scons X1 (scons X2 ∅) ⟩ = ⟨ K , scons Y1 (scons Y2 ∅) ⟩ $ by opair_eq [l4, l3]

