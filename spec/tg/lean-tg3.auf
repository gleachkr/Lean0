l84: $ G ⇒ crn (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅) ⊆ lrel3 J $ by crn_scons_sub [#14, l81]
l85: $ G ⇒ (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) ∈ latoms $ by j1_lrel3_lat [#13]
l86: $ G ⇒ scons (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅) ∈ fseq latoms $ by scons_fseq_c [l85, l83]
l87: $ G ⇒ crn (scons (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅)) ⊆ lrel3 J $ by crn_scons_sub [#13, l84]
l88: $ G ⇒ ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ∈ latoms $ by j1_ra_tys_wf [#1, #2, #3, #4, #6, #8, #12]
l89: $ G ⇒ ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ∈ lrel3 J $ by j1_horn [l79, l86, l88, l87]

tys_wf_cons_j
-------------
l1: $ _ ⇒ enc_ind D ∈ trees ω $ by enc_ind_trees
l2: $ _ ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l3: $ _ ⇒ enc_nat np ∈ trees ω $ by enc_nat_trees
l4: $ _ ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l5: $ _ ⇒ enc_lvl l2 ∈ trees ω $ by enc_lvl_trees
l6: $ _ ⇒ enc_nat i ∈ trees ω $ by enc_nat_trees
l7: $ _ ⇒ enc_nat k ∈ trees ω $ by enc_nat_trees
l8: $ _ ⇒ enc_ctx Ctx ∈ trees ω $ by enc_ctx_trees
l9: $ _ ⇒ enc_expr F ∈ trees ω $ by enc_expr_trees
l10: $ _ ⇒ enc_ctors C ∈ trees ω $ by enc_ctors_trees
l11: $ _ ⇒ enc_tys T ∈ trees ω $ by enc_tys_trees
l12: $ _ ⇒ enc_tys (tcons F C T) = ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ $ by eq_refl
l13: $ _ ⇒ enc_tys (tcons F C T) ∈ trees ω $ by enc_tys_trees
l14: $ _ ⇒ ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ ∈ trees ω $ by wcel_eq_l [l12, l13]
l15: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
l16: $ _ ⇒ enc_nat n = enc_nat n $ by eq_refl
l17: $ _ ⇒ enc_nat np = enc_nat np $ by eq_refl
l18: $ _ ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l19: $ _ ⇒ enc_nat (s i) = ⟨ kc_s , scons (enc_nat i) ∅ ⟩ $ by eq_refl
l20: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l21: $ _ ⇒ enc_tys T = enc_tys T $ by eq_refl
l22: $ _ ⇒ ra_tys_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat (s i)) (enc_ctx Ctx) (enc_tys T) = ra_tys_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) ⟨ kc_s , scons (enc_nat i) ∅ ⟩ (enc_ctx Ctx) (enc_tys T) $ by ra_tys_wf_eq [l15, l16, l17, l18, l19, l20, l21]
l23: $ _ ⇒ ra_tys_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) ⟨ kc_s , scons (enc_nat i) ∅ ⟩ (enc_ctx Ctx) (enc_tys T) ∈ lrel3 J $ by wcel_eq_l [l22, #4]
l24: $ _ ⇒ lveq (enc_lvl l2) (enc_lvl l) $ by leqv_lveq [#2]
l25: $ _ ⇒ ra_tys_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ ∈ lrel3 J $ by j1_c_tys_wf_cons [l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l14, #3, l23, #1, l24]
l26: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
l27: $ _ ⇒ enc_nat n = enc_nat n $ by eq_refl
l28: $ _ ⇒ enc_nat np = enc_nat np $ by eq_refl
l29: $ _ ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l30: $ _ ⇒ enc_nat i = enc_nat i $ by eq_refl
l31: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l32: $ _ ⇒ ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ = enc_tys (tcons F C T) $ by eq_refl
l33: $ _ ⇒ ra_tys_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) ⟨ kc_tcons , scons (enc_expr F) (scons (enc_ctors C) (scons (enc_tys T) ∅)) ⟩ = ra_tys_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) (enc_tys (tcons F C T)) $ by ra_tys_wf_eq [l26, l27, l28, l29, l30, l31, l32]
l34: $ tys_wf_j J D n np l i Ctx (tcons F C T) $ by wcel_eq_l [l33, l25]

lemma j1_pr_ctx_wf (G: hyps) (J X: class): $ G ⇒ X ∈ pr_ctx_wf J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_ctx_wf J) ∪ (pr_tys_ty J) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ (((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf)) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ ((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J))))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j1_in_l [l4]

lemma j1_ra_ctx_wf (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_ctx_wf A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_ctx_wf ∈ ω $ by kr_ctx_wf_omega
l5: $ G ⇒ ra_ctx_wf A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lemma j1_c_ctx_wf_nil (G: hyps) (J A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ⟨ kc_nil , ∅ ⟩ ∈ trees ω $ >
  $ G ⇒ ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ∈ lrel3 J $
----
l1: $ G , y = A1 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l3: $ G , y = A1 , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ y (x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩) $ by ex_intro [l2]
l4: $ G , y = A1 , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ cl_ctx_wf_nil $ by cab_intro [l3]
l5: $ G , y = A1 , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil $ by wcel_intro [l2, l4]
l6: $ G , y = A1 ⇒ isset ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ $ by opair_isset
l7: $ G , y = A1 ⇒ ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil $ by isset_elim [l6, l5]
l8: $ G , y = A1 ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , y = A1 ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_nil , ∅ ⟩ $ by eq_refl
l10: $ G , y = A1 ⇒ ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ = ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ $ by ra_ctx_wf_eq [l1, l9]
l11: $ G , y = A1 ⇒ ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ $ by opair_eq [l8, l10]
l12: $ G , y = A1 ⇒ ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil $ by wcel_eq_l [l11, l7]
l13: $ G ⇒ isset A1 $ by wcel_isset [#1]
l14: $ G ⇒ ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil $ by isset_elim [l13, l12]
l15: $ G ⇒ ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) $ by j1_in_l [l14]
l16: $ G ⇒ ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ j1_top J $ by j1_pr_ctx_wf [l15]
l17: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l18: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l19: $ G ⇒ ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ∈ latoms $ by j1_ra_ctx_wf [#1, #2]
l20: $ G ⇒ ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ∈ lrel3 J $ by j1_horn [l16, l17, l19, l18]

ctx_wf_nil_j
------------
l1: $ _ ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
l2: $ _ ⇒ enc_ctx nil = ⟨ kc_nil , ∅ ⟩ $ by eq_refl
l3: $ _ ⇒ enc_ctx nil ∈ trees ω $ by enc_ctx_trees
l4: $ _ ⇒ ⟨ kc_nil , ∅ ⟩ ∈ trees ω $ by wcel_eq_l [l2, l3]
l5: $ _ ⇒ ra_ctx_wf (enc_ctx G) ⟨ kc_nil , ∅ ⟩ ∈ lrel3 J $ by j1_c_ctx_wf_nil [l1, l4]
l6: $ _ ⇒ enc_ctx G = enc_ctx G $ by eq_refl
l7: $ _ ⇒ ⟨ kc_nil , ∅ ⟩ = enc_ctx nil $ by eq_refl
l8: $ _ ⇒ ra_ctx_wf (enc_ctx G) ⟨ kc_nil , ∅ ⟩ = ra_ctx_wf (enc_ctx G) (enc_ctx nil) $ by ra_ctx_wf_eq [l6, l7]
l9: $ ctx_wf_j J G nil $ by wcel_eq_l [l8, l5]

lemma j1_c_ctx_wf_cons (G: hyps) (J A1 A2 A3 A4 A5: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ∈ trees ω $ >
  $ G ⇒ ra_ctx_wf A1 A2 ∈ lrel3 J $ >
  $ G ⇒ ra_capp A2 A1 A3 ∈ lrel $ >
  $ G ⇒ ra_deq A3 A4 A4 ⟨ kc_srt , scons A5 ∅ ⟩ ∈ J $ >
  $ G ⇒ ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ v = A4 $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ w = A5 $ by ax
l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_capp A2 A1 A3 ∈ lrel $ by weaken [#8]
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_capp z y u = ra_capp A2 A1 A3 $ by ra_capp_eq [l2, l1, l3]
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_capp A2 A1 A3 = ra_capp z y u $ by eq_sym [l7]
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_capp z y u ∈ lrel $ by wcel_eq_l [l8, l6]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_deq A3 A4 A4 ⟨ kc_srt , scons A5 ∅ ⟩ ∈ J $ by weaken [#9]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ kc_srt = kc_srt $ by eq_refl
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ∅ = ∅ $ by eq_refl
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ scons w ∅ = scons A5 ∅ $ by scons_eq [l5, l12]
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ kc_srt , scons w ∅ ⟩ = ⟨ kc_srt , scons A5 ∅ ⟩ $ by opair_eq [l11, l13]
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ = ra_deq A3 A4 A4 ⟨ kc_srt , scons A5 ∅ ⟩ $ by ra_deq_eq [l3, l4, l4, l14]
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_deq A3 A4 A4 ⟨ kc_srt , scons A5 ∅ ⟩ = ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ $ by eq_sym [l15]
l17: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by wcel_eq_l [l16, l10]
l18: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ $ by ax
l19: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by weaken [l17]
l20: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ra_capp z y u ∈ lrel $ by weaken [l9]
l21: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by and_intro [l20, l19]
l22: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by and_intro [l18, l21]
l23: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l22]
l24: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l23]
l25: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l24]
l26: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l25]
l27: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by ex_intro [l26]
l28: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ x ∊ cl_ctx_wf_cons J $ by cab_intro [l27]
l29: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ⇒ ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by wcel_intro [l18, l28]
l30: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ isset ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ $ by opair_isset
l31: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l30, l29]
l32: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_ctx_wf y z = ra_ctx_wf A1 A2 $ by ra_ctx_wf_eq [l1, l2]
l33: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ scons (ra_ctx_wf y z) ∅ = scons (ra_ctx_wf A1 A2) ∅ $ by scons_eq [l32, l12]
l34: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ kc_cons = kc_cons $ by eq_refl
l35: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ scons z ∅ = scons A2 ∅ $ by scons_eq [l2, l12]
l36: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ scons v (scons z ∅) = scons A4 (scons A2 ∅) $ by scons_eq [l4, l35]
l37: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ kc_cons , scons v (scons z ∅) ⟩ = ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ $ by opair_eq [l34, l36]
l38: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ = ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ $ by ra_ctx_wf_eq [l1, l37]
l39: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ = ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ $ by opair_eq [l33, l38]
l40: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by wcel_eq_l [l39, l31]
l41: $ G ⇒ isset A5 $ by wcel_isset [#5]
l42: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l41, l40]
l43: $ G ⇒ isset A4 $ by wcel_isset [#4]
l44: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l43, l42]
l45: $ G ⇒ isset A3 $ by wcel_isset [#3]
l46: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l45, l44]
l47: $ G ⇒ isset A2 $ by wcel_isset [#2]
l48: $ G , y = A1 ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l47, l46]
l49: $ G ⇒ isset A1 $ by wcel_isset [#1]
l50: $ G ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_cons J $ by isset_elim [l49, l48]
l51: $ G ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) $ by j1_in_r [l50]
l52: $ G ⇒ ⟨ scons (ra_ctx_wf A1 A2) ∅ , ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ⟩ ∈ j1_top J $ by j1_pr_ctx_wf [l51]
l53: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l54: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l55: $ G ⇒ (ra_ctx_wf A1 A2) ∈ latoms $ by j1_lrel3_lat [#7]
l56: $ G ⇒ scons (ra_ctx_wf A1 A2) ∅ ∈ fseq latoms $ by scons_fseq_c [l55, l53]
l57: $ G ⇒ crn (scons (ra_ctx_wf A1 A2) ∅) ⊆ lrel3 J $ by crn_scons_sub [#7, l54]
l58: $ G ⇒ ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ∈ latoms $ by j1_ra_ctx_wf [#1, #6]
l59: $ G ⇒ ra_ctx_wf A1 ⟨ kc_cons , scons A4 (scons A2 ∅) ⟩ ∈ lrel3 J $ by j1_horn [l52, l56, l58, l57]

ctx_wf_cons_j
-------------
l1: $ _ ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
l2: $ _ ⇒ enc_ctx P ∈ trees ω $ by enc_ctx_trees
l3: $ _ ⇒ enc_ctx G2 ∈ trees ω $ by enc_ctx_trees
l4: $ _ ⇒ enc_expr A ∈ trees ω $ by enc_expr_trees
l5: $ _ ⇒ enc_lvl u ∈ trees ω $ by enc_lvl_trees
l6: $ _ ⇒ enc_ctx (cons A P) = ⟨ kc_cons , scons (enc_expr A) (scons (enc_ctx P) ∅) ⟩ $ by eq_refl
l7: $ _ ⇒ enc_ctx (cons A P) ∈ trees ω $ by enc_ctx_trees
l8: $ _ ⇒ ⟨ kc_cons , scons (enc_expr A) (scons (enc_ctx P) ∅) ⟩ ∈ trees ω $ by wcel_eq_l [l6, l7]
l9: $ _ ⇒ enc_ctx G2 = enc_ctx G2 $ by eq_refl
l10: $ _ ⇒ enc_expr A = enc_expr A $ by eq_refl
l11: $ _ ⇒ enc_expr (srt u) = ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ $ by eq_refl
l12: $ _ ⇒ ra_deq (enc_ctx G2) (enc_expr A) (enc_expr A) (enc_expr (srt u)) = ra_deq (enc_ctx G2) (enc_expr A) (enc_expr A) ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ $ by ra_deq_eq [l9, l10, l10, l11]
l13: $ _ ⇒ ra_deq (enc_ctx G2) (enc_expr A) (enc_expr A) ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ ∈ J $ by wcel_eq_l [l12, #3]
l14: $ _ ⇒ ra_ctx_wf (enc_ctx G) ⟨ kc_cons , scons (enc_expr A) (scons (enc_ctx P) ∅) ⟩ ∈ lrel3 J $ by j1_c_ctx_wf_cons [l1, l2, l3, l4, l5, l8, #1, #2, l13]
l15: $ _ ⇒ enc_ctx G = enc_ctx G $ by eq_refl
l16: $ _ ⇒ ⟨ kc_cons , scons (enc_expr A) (scons (enc_ctx P) ∅) ⟩ = enc_ctx (cons A P) $ by eq_refl
l17: $ _ ⇒ ra_ctx_wf (enc_ctx G) ⟨ kc_cons , scons (enc_expr A) (scons (enc_ctx P) ∅) ⟩ = ra_ctx_wf (enc_ctx G) (enc_ctx (cons A P)) $ by ra_ctx_wf_eq [l15, l16]
l18: $ ctx_wf_j J G (cons A P) $ by wcel_eq_l [l17, l14]

lemma j1_pr_tys_ty (G: hyps) (J X: class): $ G ⇒ X ∈ pr_tys_ty J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_ctx_wf J) ∪ (pr_tys_ty J) $ by j1_in_r [#1]
l2: $ G ⇒ X ∈ ((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ (((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf)) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ ((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J))))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j1_in_l [l4]

lemma j1_ra_tys_ty (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_tys_ty A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_tys_ty ∈ ω $ by kr_tys_ty_omega
l5: $ G ⇒ ra_tys_ty A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lemma j1_c_tys_ty_nil (G: hyps) (J A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ⟨ kc_tnil , ∅ ⟩ ∈ trees ω $ >
  $ G ⇒ ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ∈ lrel3 J $
----
l1: $ G , y = A1 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ $ by ax
l3: $ G , y = A1 , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ∃ y (x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩) $ by ex_intro [l2]
l4: $ G , y = A1 , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x ∊ cl_tys_ty_nil $ by cab_intro [l3]
l5: $ G , y = A1 , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil $ by wcel_intro [l2, l4]
l6: $ G , y = A1 ⇒ isset ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ $ by opair_isset
l7: $ G , y = A1 ⇒ ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil $ by isset_elim [l6, l5]
l8: $ G , y = A1 ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , y = A1 ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tnil , ∅ ⟩ $ by eq_refl
l10: $ G , y = A1 ⇒ ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ = ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ $ by ra_tys_ty_eq [l1, l9]
l11: $ G , y = A1 ⇒ ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ = ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ $ by opair_eq [l8, l10]
l12: $ G , y = A1 ⇒ ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil $ by wcel_eq_l [l11, l7]
l13: $ G ⇒ isset A1 $ by wcel_isset [#1]
l14: $ G ⇒ ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil $ by isset_elim [l13, l12]
l15: $ G ⇒ ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) $ by j1_in_l [l14]
l16: $ G ⇒ ⟨ ∅ , ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ⟩ ∈ j1_top J $ by j1_pr_tys_ty [l15]
l17: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l18: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l19: $ G ⇒ ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ∈ latoms $ by j1_ra_tys_ty [#1, #2]
l20: $ G ⇒ ra_tys_ty A1 ⟨ kc_tnil , ∅ ⟩ ∈ lrel3 J $ by j1_horn [l16, l17, l19, l18]

tys_ty_nil_j
------------
l1: $ _ ⇒ enc_ctx Ctx ∈ trees ω $ by enc_ctx_trees
l2: $ _ ⇒ enc_tys tnil = ⟨ kc_tnil , ∅ ⟩ $ by eq_refl
l3: $ _ ⇒ enc_tys tnil ∈ trees ω $ by enc_tys_trees
l4: $ _ ⇒ ⟨ kc_tnil , ∅ ⟩ ∈ trees ω $ by wcel_eq_l [l2, l3]
l5: $ _ ⇒ ra_tys_ty (enc_ctx Ctx) ⟨ kc_tnil , ∅ ⟩ ∈ lrel3 J $ by j1_c_tys_ty_nil [l1, l4]
l6: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l7: $ _ ⇒ ⟨ kc_tnil , ∅ ⟩ = enc_tys tnil $ by eq_refl
l8: $ _ ⇒ ra_tys_ty (enc_ctx Ctx) ⟨ kc_tnil , ∅ ⟩ = ra_tys_ty (enc_ctx Ctx) (enc_tys tnil) $ by ra_tys_ty_eq [l6, l7]
l9: $ tys_ty_j J Ctx tnil $ by wcel_eq_l [l8, l5]

lemma j1_c_tys_ty_cons (G: hyps) (J A1 A2 A3 A4 A5: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ ⟨ kc_tcons , scons A2 (scons A3 (scons A4 ∅)) ⟩ ∈ trees ω $ >
  $ G ⇒ ra_tys_ty A1 A4 ∈ lrel3 J $ >
  $ G ⇒ ra_deq A1 A2 A2 ⟨ kc_srt , scons A5 ∅ ⟩ ∈ J $ >
  $ G ⇒ ra_tys_ty A1 ⟨ kc_tcons , scons A2 (scons A3 (scons A4 ∅)) ⟩ ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ z = A2 $ by ax
