l62: $ G ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ∨ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u27 J $ by j2_wcel_cun_elim [l61]
l63: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u27 J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u27 J $ by ax
l64: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J $ by ax
l65: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ j2_u26 J ⊆ j2_lab kr_gcd_eqs (suc kr_land_eqs) $ by j2_s26
l66: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_lab kr_gcd_eqs (suc kr_land_eqs) $ by wcel_subset [l65, l64]
l67: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ lprog3 J $ by weaken [#1]
l68: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ isset kr_xor_eqs $ by weaken [l4]
l69: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ kr_xor_eqs ∈ suc kr_land_eqs ∧ kr_gcd_eqs ⊆ kr_xor_eqs $ by j2_lprog_lab [l67, l68, l66]
l70: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ kr_xor_eqs ∈ kr_lor_eqs $ by and_elim_l [l69]
l71: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ kr_lor_eqs ⊆ kr_xor_eqs $ by weaken [l7]
l72: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ kr_xor_eqs ∈ kr_xor_eqs $ by wcel_subset [l71, l70]
l73: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ ⊥ $ by notin_self_c [l72]
l74: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u26 J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u27 J $ by bot_elim [l73]
l75: $ G ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_u27 J $ by or_elim [l62, l74, l63]
l76: $ G ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ∨ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_xor_eqs J $ by j2_wcel_cun_elim [l75]
l77: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_xor_eqs J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_xor_eqs J $ by ax
l78: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J $ by ax
l79: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ pr_lor_eqs J ⊆ j2_lab kr_lor_eqs (suc kr_lor_eqs) $ by j2_p_lor_eqs
l80: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ j2_lab kr_lor_eqs (suc kr_lor_eqs) $ by wcel_subset [l79, l78]
l81: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ lprog3 J $ by weaken [#1]
l82: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ isset kr_xor_eqs $ by weaken [l4]
l83: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ kr_xor_eqs ∈ suc kr_lor_eqs ∧ kr_lor_eqs ⊆ kr_xor_eqs $ by j2_lprog_lab [l81, l82, l80]
l84: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ kr_xor_eqs ∈ kr_xor_eqs $ by and_elim_l [l83]
l85: $ G , ⟨ P , ra_xor_eqs A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_lor_eqs J ⇒ kr_xor_eqs ⊆ kr_xor_eqs $ by weaken [l5]
