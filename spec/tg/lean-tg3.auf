l20: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ = ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ $ by eq_refl
l21: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ = ra_deq A3 A7 A7 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ $ by ra_deq_eq [l3, l7, l7, l20]
l22: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_deq A3 A7 A7 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ = ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ $ by eq_sym [l21]
l23: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by wcel_eq_l [l22, l19]
