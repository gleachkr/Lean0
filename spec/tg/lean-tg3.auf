l1: $ G ⇒ ∃ G_v ∃ f_v ∃ B ∃ t_v ∃ u_v (t1 = G_v ∧ t2 = f_v ∧ t3 = B ∧ t4 = t_v ∧ t5 = u_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ t_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ u_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons B ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq G_v ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ j2_c2 ⟩ t_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ j2_c3 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c3 ⟩ j2_c2 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ B ∈ J) $ by j2_d_beq_eqs_i [#1, #2]

