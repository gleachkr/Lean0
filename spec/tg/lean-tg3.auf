l49: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅)))))))) $ by wcel_isset [l45]
l50: $ G ⇒ kr_cwf = kr_cwf ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅))))))) $ by opair_inj_c [l12, l47, l48, l47, l49]
l51: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅))))))) $ by and_elim_r [l50]
l52: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅)))))) $ by j2_scons_inj [l51, l36, l20, l35, l44]
