lemma j1_pr_pow_eqs (G: hyps) (J X: class): $ G ⇒ X ∈ pr_pow_eqs J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_pow_eqs J) ∪ (pr_beq_eqs J) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J))) $ by j1_in_r [l2]
