l5: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ w = A5 $ by ax
l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ a = A6 $ by ax
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ b = A7 $ by ax
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ c = A8 $ by ax
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ f = A9 $ by ax
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ g = A10 $ by ax
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ ra_ind_data A2 A3 A4 A5 ∈ lrel $ by weaken [#11]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ ra_ind_data z u v w = ra_ind_data A2 A3 A4 A5 $ by ra_ind_data_eq [l2, l3, l4, l5]
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ ra_ind_data A2 A3 A4 A5 = ra_ind_data z u v w $ by eq_sym [l12]
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ ra_ind_data z u v w ∈ lrel $ by wcel_eq_l [l13, l11]
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ ra_nth_ty A5 A6 A8 A9 ∈ lrel $ by weaken [#12]
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ ra_nth_ty w a c f = ra_nth_ty A5 A6 A8 A9 $ by ra_nth_ty_eq [l5, l6, l8, l9]
l17: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ ra_nth_ty A5 A6 A8 A9 = ra_nth_ty w a c f $ by eq_sym [l16]
l18: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 , g = A10 ⇒ ra_nth_ty w a c f ∈ lrel $ by wcel_eq_l [l17, l15]
