lemma j2_d_sty_app (G: hyps) (J: class) {G_v h_v A f_v a_v B C C2: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x ∊ cl_sty_app J ⇒ x ∊ cl_sty_app J $ by ax
l2: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x ∊ cl_sty_app J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by j2_e_sty_app [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x ∊ cl_sty_app J ⇒ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by wcel_elim [#1, l7]

lemma j2_o_sty (G: hyps) (J: class) {G_v h_v A f_v a_v B C C2: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ pr_sty J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J $ by ax
l2: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J ⇒ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by j2_d_sty_app [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J → ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) $ by ax
l6: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∨ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil $ by ax
l8: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l9: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) $ by j2_d_sty_nil [l7, l8]
l10: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J $ by ax
l12: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J → ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J ⇒ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_app J ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) → ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) ∨ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $ by imp_elim [l16, #1]

