l1: $ G ⇒ ∃ G_v ∃ f_v ∃ p_v (t1 = G_v ∧ t2 = f_v ∧ t3 = p_v ∧ ra_pred_eqs G_v p_v ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons p_v (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ j2_c1 ∈ J) $ by j2_d_sub_eqs_i [#1, #2]

