lemma j2_o_gcd_eqs (G: hyps) (J: class) {G_v f_v fd fm fmul fadd h1 h2: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_gcd_eqs t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_gcd_eqs J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
