l2: $ G ⇒ ∃ a2 ∃ a3 [a1/b1] p $ by ex_intro (t := $ b2 $, p := $ ∃ a3 [a1/b1] p $) [l1]
l3: $ G ⇒ ∃ a1 ∃ a2 ∃ a3 p $ by ex_intro (t := $ b1 $, p := $ ∃ a2 ∃ a3 p $) [l2]

