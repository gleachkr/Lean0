l1: $ G ⇒ isset (ra_sty t1 t2 t3 t4 t5) $ by opair_isset
l2: $ G , c = ra_sty t1 t2 t3 t4 t5 ⇒ c = ra_sty t1 t2 t3 t4 t5 $ by ax
l3: $ G , c = ra_sty t1 t2 t3 t4 t5 ⇒ ra_sty t1 t2 t3 t4 t5 = c $ by eq_sym [l2]
l4: $ G , c = ra_sty t1 t2 t3 t4 t5 ⇒ ra_sty t1 t2 t3 t4 t5 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_sty t1 t2 t3 t4 t5 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_sty t1 t2 t3 t4 t5 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
