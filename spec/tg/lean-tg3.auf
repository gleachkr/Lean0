l38: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V3 (scons V4 ∅)) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons V3 (scons V4 ∅) $ by j2_scons_inj [l38, l22, l15, l21, l27]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 ∅) = scons V3 (scons V4 ∅) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V3 ∧ scons t4 ∅ = scons V4 ∅ $ by j2_scons_inj [l41, l20, l14, l19, l26]
l43: $ G ⇒ t3 = V3 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 ∅ = scons V4 ∅ $ by and_elim_r [l42]
