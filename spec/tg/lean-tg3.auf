l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons V2 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_large ∈ ω $ by kr_large_omega
l23: $ G ⇒ isset kr_large $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons V2 ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_large = kr_large ∧ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V2 ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V2 V3 V4 ⟨ kc_tcons , scons V5 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by j2_and2 [l29, l32, l2]
l34: $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by j2_exi5 [l33]

lemma j2_d_large_empty (G: hyps) (J: class) {G_v D b_v P F: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ ∈ cl_large_empty $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_empty ⇒ x ∊ cl_large_empty $ by ax
l2: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_empty ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ x = ⟨ pp , ra_large t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by j2_e_large_empty [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_empty ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by j2_ex5 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by wcel_elim [#1, l7]

lemma j2_e_large_single (G: hyps) (J: class) {G_v G2 D b_v P F K np: set} (pp t1 t2 x V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ x = ⟨ pp , ra_large t1 t2 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ , ra_large V1 V3 ⟩ ∧ ra_ind_data V3 V4 V5 ⟨ kc_tcons , scons V6 (scons ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ F ∃ K ∃ np (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ , ra_large V1 V3 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V3 V4 V5 ⟨ kc_tcons , scons V6 (scons ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ = ⟨ scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ , ra_large V1 V3 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ , ra_large V1 V3 ⟩ = ⟨ pp , ra_large t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_large t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_large V1 V3) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ ∧ ra_large t1 t2 = ra_large V1 V3 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_large t1 t2 = ra_large V1 V3 $ by and_elim_r [l10]
l13: $ G ⇒ isset V3 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons V3 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons V3 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_large ∈ ω $ by kr_large_omega
l23: $ G ⇒ isset kr_large $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons V3 ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_large = kr_large ∧ scons t1 (scons t2 ∅) = scons V1 (scons V3 ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V3 ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V3 ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons V3 ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V3 ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = V3 $ by and_elim_l [l31]
l33: $ G ⇒ crn pp = crn (scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅) $ by crn_eq [l11]
l34: $ G ⇒ crn (scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅) ⊆ lrel3 J $ by subset_eq_l [l33, #3]
l35: $ G ⇒ isset (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) $ by opair_isset
l36: $ G ⇒ ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7 ∈ lrel3 J $ by crn_scons_head [l35, l34]
l37: $ G ⇒ ra_ind_data V3 V4 V5 ⟨ kc_tcons , scons V6 (scons ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by and_elim_l [l2]
l38: $ G ⇒ ra_clen V5 V8 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [l2]
l39: $ G ⇒ ra_clen V5 V8 ∈ lrel $ by and_elim_l [l38]
l40: $ G ⇒ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [l38]
