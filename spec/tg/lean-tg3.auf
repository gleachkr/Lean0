lemma j1_pr_bool_dec (G: hyps) (J X: class): $ G ⇒ X ∈ pr_bool_dec J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_bool_dec J) ∪ (pr_div_eqs J) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J)) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))) $ by j1_in_l [l2]
l4: $ G ⇒ X ∈ ((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J))))) $ by j1_in_r [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j1_in_r [l4]

lemma j1_ra_bool_dec (G: hyps) (A1 A2 A3 A4 A5 A6 A7 A8 A9: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ > $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ > $ G ⇒ A9 ∈ trees ω $ >
  $ G ⇒ ra_bool_dec A1 A2 A3 A4 A5 A6 A7 A8 A9 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A9 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#9, l1]
l3: $ G ⇒ scons A8 (scons A9 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#8, l2]
l4: $ G ⇒ scons A7 (scons A8 (scons A9 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#7, l3]
l5: $ G ⇒ scons A6 (scons A7 (scons A8 (scons A9 ∅))) ∈ fseq (trees ω) $ by scons_fseq_c [#6, l4]
l6: $ G ⇒ scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))) ∈ fseq (trees ω) $ by scons_fseq_c [#5, l5]
l7: $ G ⇒ scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅))))) ∈ fseq (trees ω) $ by scons_fseq_c [#4, l6]
l8: $ G ⇒ scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))) ∈ fseq (trees ω) $ by scons_fseq_c [#3, l7]
l9: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅))))))) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l8]
l10: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 ∅)))))))) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l9]
l11: $ G ⇒ kr_bool_dec ∈ ω $ by kr_bool_dec_omega
l12: $ G ⇒ ra_bool_dec A1 A2 A3 A4 A5 A6 A7 A8 A9 ∈ latoms $ by cxp_intro_c [l11, l10]

