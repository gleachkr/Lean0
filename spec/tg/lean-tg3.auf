 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons ite (scons ⟨ kc_app , scons bp (scons u_v ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons bd (scons u_v ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J) $ by j2_d_bool_dec_i [#1, #2]

lrel3_bool_dec_cases
--------------------
l1: $ G ⇒ isset (ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9) $ by opair_isset
l2: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 ⇒ c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 $ by ax
l3: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 ⇒ ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 = c $ by eq_sym [l2]
l4: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 ⇒ ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_bool_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
