lemma j3_cl_bitwise_eqs_i {x: set} (G: hyps x) (J X: class):
  $ G ⇒ X ∈ gi_bitwise_eqs_i J (fv x ix0) (fv x ix1) (fv x ix2) (fv x ix3) (fv x ix4) (fv x ix5) (fv x ix6) (fv x ix7) (fv x ix8) (fv x ix9) (fv x ix10) (fv x ix11) (fv x ix12) (fv x ix13) (fv x ix14) (fv x ix15) (fv x ix16) (fv x ix17) (fv x ix18) (fv x ix19) (fv x ix20) (fv x ix21) (fv x ix22) (fv x ix23) (fv x ix24) (fv x ix25) (fv x ix26) (fv x ix27) (fv x ix28) (fv x ix29) (fv x ix30) (fv x ix31) (fv x ix32) (fv x ix33) (fv x ix34) (fv x ix35) (fv x ix36) (fv x ix37) (fv x ix38) (fv x ix39) (fv x ix40) (fv x ix41) (fv x ix42) (fv x ix43) (fv x ix44) $ >
  $ G ⇒ X ∈ cl_bitwise_eqs_i J $
----
l1: $ G ⇒ isset X $ by wcel_isset [#1]
l2: $ G , y = X ⇒ y = X $ by ax
l3: $ G , y = X ⇒ X = y $ by eq_sym [l2]
l4: $ G , y = X ⇒ X ∈ gi_bitwise_eqs_i J (fv x ix0) (fv x ix1) (fv x ix2) (fv x ix3) (fv x ix4) (fv x ix5) (fv x ix6) (fv x ix7) (fv x ix8) (fv x ix9) (fv x ix10) (fv x ix11) (fv x ix12) (fv x ix13) (fv x ix14) (fv x ix15) (fv x ix16) (fv x ix17) (fv x ix18) (fv x ix19) (fv x ix20) (fv x ix21) (fv x ix22) (fv x ix23) (fv x ix24) (fv x ix25) (fv x ix26) (fv x ix27) (fv x ix28) (fv x ix29) (fv x ix30) (fv x ix31) (fv x ix32) (fv x ix33) (fv x ix34) (fv x ix35) (fv x ix36) (fv x ix37) (fv x ix38) (fv x ix39) (fv x ix40) (fv x ix41) (fv x ix42) (fv x ix43) (fv x ix44) $ by weaken [#1]
l5: $ G , y = X ⇒ y ∈ gi_bitwise_eqs_i J (fv x ix0) (fv x ix1) (fv x ix2) (fv x ix3) (fv x ix4) (fv x ix5) (fv x ix6) (fv x ix7) (fv x ix8) (fv x ix9) (fv x ix10) (fv x ix11) (fv x ix12) (fv x ix13) (fv x ix14) (fv x ix15) (fv x ix16) (fv x ix17) (fv x ix18) (fv x ix19) (fv x ix20) (fv x ix21) (fv x ix22) (fv x ix23) (fv x ix24) (fv x ix25) (fv x ix26) (fv x ix27) (fv x ix28) (fv x ix29) (fv x ix30) (fv x ix31) (fv x ix32) (fv x ix33) (fv x ix34) (fv x ix35) (fv x ix36) (fv x ix37) (fv x ix38) (fv x ix39) (fv x ix40) (fv x ix41) (fv x ix42) (fv x ix43) (fv x ix44) $ by wcel_eq_l [l3, l4]
l6: $ G , y = X ⇒ ∃ x (y ∈ gi_bitwise_eqs_i J (fv x ix0) (fv x ix1) (fv x ix2) (fv x ix3) (fv x ix4) (fv x ix5) (fv x ix6) (fv x ix7) (fv x ix8) (fv x ix9) (fv x ix10) (fv x ix11) (fv x ix12) (fv x ix13) (fv x ix14) (fv x ix15) (fv x ix16) (fv x ix17) (fv x ix18) (fv x ix19) (fv x ix20) (fv x ix21) (fv x ix22) (fv x ix23) (fv x ix24) (fv x ix25) (fv x ix26) (fv x ix27) (fv x ix28) (fv x ix29) (fv x ix30) (fv x ix31) (fv x ix32) (fv x ix33) (fv x ix34) (fv x ix35) (fv x ix36) (fv x ix37) (fv x ix38) (fv x ix39) (fv x ix40) (fv x ix41) (fv x ix42) (fv x ix43) (fv x ix44)) $ by ex_intro [l5]
l7: $ G , y = X ⇒ y ∊ cl_bitwise_eqs_i J $ by cab_intro [l6]
l8: $ G , y = X ⇒ X ∈ cl_bitwise_eqs_i J $ by wcel_intro [l2, l7]
l9: $ G ⇒ X ∈ cl_bitwise_eqs_i J $ by isset_elim [l1, l8]

lemma j3_pr_bitwise_eqs (G: hyps) (J X: class): $ G ⇒ X ∈ pr_bitwise_eqs J $ > $ G ⇒ X ∈ j3_top J $
----
l1: $ G ⇒ X ∈ (pr_bitwise_eqs J) ∪ (pr_bitop_eqs J) $ by j3_in_l [#1]
l2: $ G ⇒ X ∈ (pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)) $ by j3_in_r [l1]
l3: $ G ⇒ X ∈ ((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J))) $ by j3_in_r [l2]
l4: $ G ⇒ X ∈ (((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))) $ by j3_in_r [l3]
l5: $ G ⇒ X ∈ ((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J))))) $ by j3_in_r [l4]
l6: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j3_in_r [l5]

