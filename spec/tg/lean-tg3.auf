l88: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_exi12 [l87]

lemma j2_d_cwf_pi (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v A B A2 u_v: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi J ⇒ x ∊ cl_cwf_pi J $ by ax
l2: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j (x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ⇒ x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 $ by ax
l5: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_e_cwf_pi [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_ex12 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_e_cwf_pi_rec (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v A B A2 B2 u_v: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13: set):
  $ G ⇒ x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ⟩ ∧ ra_add V7 V3 V8 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V8 V9 V11 ∈ lrel ∧ ra_deq V6 V11 V11 ⟨ kc_srt , scons V13 ∅ ⟩ ∈ J ∧ ra_ulevel V4 V13 ∈ lrel2 ∧ ra_ipos V1 V2 V3 V7 V9 ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ V10 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ V12 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V12 V10 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_add V7 V3 V8 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V8 V9 V11 ∈ lrel ∧ ra_deq V6 V11 V11 ⟨ kc_srt , scons V13 ∅ ⟩ ∈ J ∧ ra_ulevel V4 V13 ∈ lrel2 ∧ ra_ipos V1 V2 V3 V7 V9 ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ V10 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ V12 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V12 V10 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ⟩ = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_cwf V1 V2 V3 V4 V5 ⟨ kc_cons , scons V11 (scons V6 ∅) ⟩ ⟨ kc_s , scons V7 ∅ ⟩ V10) ∅) $ by j2_opair_set_l [l5]
