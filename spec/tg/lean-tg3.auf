l8: $ _ ⇒ enc_expr (pi nat_ty nat_ty) = ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ $ by eq_refl
l9: $ _ ⇒ ra_deq (enc_ctx G) (enc_expr p) (enc_expr p) (enc_expr (pi nat_ty nat_ty)) = ra_deq (enc_ctx G) (enc_expr p) (enc_expr p) ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ $ by ra_deq_eq [l7, l4, l4, l8]
l10: $ _ ⇒ ra_deq (enc_ctx G) (enc_expr p) (enc_expr p) ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J $ by wcel_eq_l [l9, #2]
l11: $ _ ⇒ enc_expr (app p nat_zero) = ⟨ kc_app , scons (enc_expr p) (scons tr_nat_zero ∅) ⟩ $ by eq_refl
