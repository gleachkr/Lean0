  $ G ⇒ ∃ G_v ∃ B ∃ t_v ∃ u_v ∃ Not ∃ Dec ∃ dite ∃ T ∃ R ∃ ofT ∃ ofF ∃ eqN ∃ deqN ∃ beq ∃ pq (t1 = G_v ∧ t2 = B ∧ t3 = t_v ∧ t4 = u_v ∧ t5 = Not ∧ t6 = Dec ∧ t7 = dite ∧ t8 = T ∧ t9 = R ∧ t10 = ofT ∧ t11 = ofF ∧ t12 = eqN ∧ t13 = deqN ∧ t14 = beq ∧ t15 = pq ∧ ra_dec_eqs G_v B t_v u_v Not Dec dite T R ofT ofF ∈ lrel3 J ∧ ra_beq_eqs G_v beq B t_v u_v ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ eqN ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ deqN ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ pq ∈ lrel ∧ ra_deq G_v eqN eqN j2_c12 ∈ J ∧ ra_deq G_v pq pq ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_app , scons ⟨ kc_app , scons T (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons beq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons deqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons R (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons beq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons pq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons Dec (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∈ J) $
----
l1: $ G ⇒ ∃ G_v ∃ B ∃ t_v ∃ u_v ∃ Not ∃ Dec ∃ dite ∃ T ∃ R ∃ ofT ∃ ofF ∃ eqN ∃ deqN ∃ beq ∃ pq (t1 = G_v ∧ t2 = B ∧ t3 = t_v ∧ t4 = u_v ∧ t5 = Not ∧ t6 = Dec ∧ t7 = dite ∧ t8 = T ∧ t9 = R ∧ t10 = ofT ∧ t11 = ofF ∧ t12 = eqN ∧ t13 = deqN ∧ t14 = beq ∧ t15 = pq ∧ ra_dec_eqs G_v B t_v u_v Not Dec dite T R ofT ofF ∈ lrel3 J ∧ ra_beq_eqs G_v beq B t_v u_v ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ eqN ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ deqN ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ pq ∈ lrel ∧ ra_deq G_v eqN eqN j2_c12 ∈ J ∧ ra_deq G_v pq pq ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_app , scons ⟨ kc_app , scons T (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons beq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons deqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons R (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons beq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons pq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons Dec (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∈ J) $ by j2_d_nateq_dec_i [#1, #2]

lrel3_nateq_dec_cases
---------------------
l1: $ G ⇒ isset (ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15) $ by opair_isset
l2: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⇒ c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 $ by ax
l3: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⇒ ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 = c $ by eq_sym [l2]
l4: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⇒ ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 $ by ax
l14: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 ⟩ ∈ pr_nateq_dec J $ by lprog3_nateq_dec_pr [l15]
l17: $ G , c = ra_nateq_dec t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ B ∃ t_v ∃ u_v ∃ Not ∃ Dec ∃ dite ∃ T ∃ R ∃ ofT ∃ ofF ∃ eqN ∃ deqN ∃ beq ∃ pq (t1 = G_v ∧ t2 = B ∧ t3 = t_v ∧ t4 = u_v ∧ t5 = Not ∧ t6 = Dec ∧ t7 = dite ∧ t8 = T ∧ t9 = R ∧ t10 = ofT ∧ t11 = ofF ∧ t12 = eqN ∧ t13 = deqN ∧ t14 = beq ∧ t15 = pq ∧ ra_dec_eqs G_v B t_v u_v Not Dec dite T R ofT ofF ∈ lrel3 J ∧ ra_beq_eqs G_v beq B t_v u_v ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ eqN ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ deqN ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ pq ∈ lrel ∧ ra_deq G_v eqN eqN j2_c12 ∈ J ∧ ra_deq G_v pq pq ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_app , scons ⟨ kc_app , scons T (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons beq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons deqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_app , scons R (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons beq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons pq (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons Dec (scons ⟨ kc_app , scons ⟨ kc_app , scons eqN (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∈ J) $ by j2_o_nateq_dec [l16, l11]
