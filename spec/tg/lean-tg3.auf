lemma j2_e_tys_ok_i (G: hyps) (J: class) {G_v G2 D b_v P T: set} (pp t1 t2 x V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ x = ⟨ pp , ra_tys_ok t1 t2 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅) , ra_tys_ok V1 V3 ⟩ ∧ ra_ind_data V3 V4 V5 V6 ∈ lrel ∧ ra_tys_closed V5 V6 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅) , ra_tys_ok V1 V3 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V3 V4 V5 V6 ∈ lrel ∧ ra_tys_closed V5 V6 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_tys_ok t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_tys_ok t1 t2 ⟩ = ⟨ scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅) , ra_tys_ok V1 V3 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅) , ra_tys_ok V1 V3 ⟩ = ⟨ pp , ra_tys_ok t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅)) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_tys_ok t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_tys_ok V1 V3) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅) ∧ ra_tys_ok t1 t2 = ra_tys_ok V1 V3 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅) $ by and_elim_l [l10]
l12: $ G ⇒ ra_tys_ok t1 t2 = ra_tys_ok V1 V3 $ by and_elim_r [l10]
l13: $ G ⇒ isset V3 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons V3 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons V3 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
