l11: $ G , c = ra_sub_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_sub_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_sub_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_sub_eqs t1 t2 t3 $ by ax
l14: $ G , c = ra_sub_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_sub_eqs t1 t2 t3 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_sub_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_sub_eqs t1 t2 t3 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_sub_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_sub_eqs t1 t2 t3 ⟩ ∈ pr_sub_eqs J $ by lprog3_sub_eqs_pr [l15]
