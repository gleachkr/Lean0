--| @rewrite
--| The encoding of the definition `n2`, for the normalizer (which keeps it folded).
lemma j1_enc_n2: $ enc_nat n2 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ $
----
l1: $ enc_nat n2 ≐ ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ $ by enc_s

--| @rewrite
