lemma j2_d_ctors_wf_cons (G: hyps) (J: class) {D n_v np l_v i_v Ctx K C: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_cons $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_cons ⇒ x ∊ cl_ctors_wf_cons $ by ax
l2: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by j2_e_ctors_wf_cons [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_cons ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_ctors_wf (G: hyps) (J: class) {D n_v np l_v i_v Ctx K C: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ pr_ctors_wf $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_cons ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_cons $ by ax
l2: $ G , ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_cons ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_cons ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by j2_d_ctors_wf_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_cons → ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by imp_intro [l3]
