lemma j2_e_shr_eqs_i (G: hyps) (J: class) {G_v f_v fd: set} (pp t1 t2 t3 x V1 V2 V3: set):
  $ G ⇒ x = ⟨ pp , ra_shr_eqs t1 t2 t3 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_shr_eqs V1 V2 V3 ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V3 (scons ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ fd (t1 = G_v ∧ t2 = f_v ∧ t3 = fd ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ fd ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $
----
l1: $ G ⇒ x = ⟨ ∅ , ra_shr_eqs V1 V2 V3 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V3 (scons ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_shr_eqs t1 t2 t3 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_shr_eqs t1 t2 t3 ⟩ = ⟨ ∅ , ra_shr_eqs V1 V2 V3 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ ∅ , ra_shr_eqs V1 V2 V3 ⟩ = ⟨ pp , ra_shr_eqs t1 t2 t3 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_shr_eqs t1 t2 t3) $ by opair_isset
l9: $ G ⇒ isset (ra_shr_eqs V1 V2 V3) $ by opair_isset
l10: $ G ⇒ pp = ∅ ∧ ra_shr_eqs t1 t2 t3 = ra_shr_eqs V1 V2 V3 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_shr_eqs t1 t2 t3 = ra_shr_eqs V1 V2 V3 $ by and_elim_r [l10]
l13: $ G ⇒ isset V3 $ by isset_var
l14: $ G ⇒ isset V2 $ by isset_var
l15: $ G ⇒ isset V1 $ by isset_var
l16: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l17: $ G ⇒ isset t3 $ by isset_var
l18: $ G ⇒ scons t3 ∅ ∈ fseq j2_vv $ by j2_fs [l17, l16]
l19: $ G ⇒ isset t2 $ by isset_var
l20: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t1 $ by isset_var
l22: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ scons V3 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l16]
l24: $ G ⇒ scons V2 (scons V3 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l23]
l25: $ G ⇒ scons V1 (scons V2 (scons V3 ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l24]
l26: $ G ⇒ kr_shr_eqs ∈ ω $ by kr_shr_eqs_omega
l27: $ G ⇒ isset kr_shr_eqs $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l22]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons V3 ∅))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_shr_eqs = kr_shr_eqs ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by opair_inj_c [l12, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by j2_scons_inj [l31, l21, l15, l20, l24]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 ∅ = scons V3 ∅ $ by j2_scons_inj [l34, l19, l14, l18, l23]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 ∅ = scons V3 ∅ $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V3 ∧ ∅ = ∅ $ by j2_scons_inj [l37, l17, l13, l16, l16]
l39: $ G ⇒ t3 = V3 $ by and_elim_l [l38]
l40: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V3 (scons ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J $ by j2_and3 [l33, l36, l39, l2]
l41: $ G ⇒ ∃ G_v ∃ f_v ∃ fd (t1 = G_v ∧ t2 = f_v ∧ t3 = fd ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ fd ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $ by j2_exi3 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, p := $ t1 = G_v ∧ t2 = f_v ∧ t3 = fd ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ fd ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J $) [l40]

lemma j2_d_shr_eqs_i (G: hyps) (J: class) {G_v f_v fd: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_shr_eqs t1 t2 t3 ⟩ ∈ cl_shr_eqs_i J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ fd (t1 = G_v ∧ t2 = f_v ∧ t3 = fd ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ fd ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $
----
l1: $ G , x = ⟨ pp , ra_shr_eqs t1 t2 t3 ⟩ , x ∊ cl_shr_eqs_i J ⇒ x ∊ cl_shr_eqs_i J $ by ax
