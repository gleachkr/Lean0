l2: $ G ⇒ kr_add_eqs ⊆ kr_pred_eqs $ by suc_subset
l3: $ G ⇒ kr_pred_eqs ⊆ kr_sub_eqs $ by j2_f16
l4: $ G ⇒ kr_add_eqs ⊆ kr_sub_eqs $ by subset_trans [l2, l3]

lemma j2_f13 (G: hyps): $ G ⇒ kr_fprops ⊆ kr_sub_eqs $
----
l1: $ G ⇒ kr_fprops ⊆ kr_proj_ok $ by j2_f14
l2: $ G ⇒ kr_proj_ok ⊆ kr_add_eqs $ by suc_subset
l3: $ G ⇒ kr_add_eqs ⊆ kr_sub_eqs $ by j2_f15
l4: $ G ⇒ kr_fprops ⊆ kr_add_eqs $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_fprops ⊆ kr_sub_eqs $ by subset_trans [l4, l3]

lemma j2_f9 (G: hyps): $ G ⇒ kr_nst_ok ⊆ kr_sub_eqs $
----
