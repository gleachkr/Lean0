l11: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_add_eqs t1 t2 $ by ax
l14: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_add_eqs t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_add_eqs t1 t2 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_add_eqs t1 t2 ⟩ ∈ pr_add_eqs J $ by lprog3_add_eqs_pr [l15]
l17: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ f_v (t1 = G_v ∧ t2 = f_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons j2_c4 (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ j2_c1 ∈ J) $ by j2_o_add_eqs [l16, l11]
l18: $ G , c = ra_add_eqs t1 t2 ⇒ ∃ G_v ∃ f_v (t1 = G_v ∧ t2 = f_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons j2_c4 (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ j2_c1 ∈ J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ f_v (t1 = G_v ∧ t2 = f_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons j2_c4 (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ j2_c1 ∈ J) $ by isset_elim [l1, l18]

lemma j2_e_pred_eqs_i (G: hyps) (J: class) {G_v p_v: set} (pp t1 t2 x V1 V2: set):
  $ G ⇒ x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_pred_eqs V1 V2 ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c5 ∈ J ∧ ra_deq V1 ⟨ kc_app , scons V2 j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons V2 j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ p_v (t1 = G_v ∧ t2 = p_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ p_v ∈ lrel ∧ ra_deq G_v p_v p_v j2_c5 ∈ J ∧ ra_deq G_v ⟨ kc_app , scons p_v j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons p_v j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J) $
----
l1: $ G ⇒ x = ⟨ ∅ , ra_pred_eqs V1 V2 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c5 ∈ J ∧ ra_deq V1 ⟨ kc_app , scons V2 j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons V2 j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_pred_eqs t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_pred_eqs t1 t2 ⟩ = ⟨ ∅ , ra_pred_eqs V1 V2 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ ∅ , ra_pred_eqs V1 V2 ⟩ = ⟨ pp , ra_pred_eqs t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_pred_eqs t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_pred_eqs V1 V2) $ by opair_isset
l10: $ G ⇒ pp = ∅ ∧ ra_pred_eqs t1 t2 = ra_pred_eqs V1 V2 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_pred_eqs t1 t2 = ra_pred_eqs V1 V2 $ by and_elim_r [l10]
l13: $ G ⇒ isset V2 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons V2 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_pred_eqs ∈ ω $ by kr_pred_eqs_omega
l23: $ G ⇒ isset kr_pred_eqs $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons V2 ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_pred_eqs = kr_pred_eqs ∧ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V2 ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c5 ∈ J ∧ ra_deq V1 ⟨ kc_app , scons V2 j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons V2 j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J $ by j2_and2 [l29, l32, l2]
l34: $ G ⇒ ∃ G_v ∃ p_v (t1 = G_v ∧ t2 = p_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ p_v ∈ lrel ∧ ra_deq G_v p_v p_v j2_c5 ∈ J ∧ ra_deq G_v ⟨ kc_app , scons p_v j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons p_v j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J) $ by j2_exi2 (b1 := $ V1 $, b2 := $ V2 $, p := $ t1 = G_v ∧ t2 = p_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ p_v ∈ lrel ∧ ra_deq G_v p_v p_v j2_c5 ∈ J ∧ ra_deq G_v ⟨ kc_app , scons p_v j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons p_v j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J $) [l33]

lemma j2_d_pred_eqs_i (G: hyps) (J: class) {G_v p_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_pred_eqs t1 t2 ⟩ ∈ cl_pred_eqs_i J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ p_v (t1 = G_v ∧ t2 = p_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ p_v ∈ lrel ∧ ra_deq G_v p_v p_v j2_c5 ∈ J ∧ ra_deq G_v ⟨ kc_app , scons p_v j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons p_v j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J) $
----
l1: $ G , x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ , x ∊ cl_pred_eqs_i J ⇒ x ∊ cl_pred_eqs_i J $ by ax
l2: $ G , x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ , x ∊ cl_pred_eqs_i J ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z j2_c5 ∈ J ∧ ra_deq y ⟨ kc_app , scons z j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons y ∅) ⟩ ⟨ kc_app , scons z j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ , x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z j2_c5 ∈ J ∧ ra_deq y ⟨ kc_app , scons z j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons y ∅) ⟩ ⟨ kc_app , scons z j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ⇒ x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ , x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z j2_c5 ∈ J ∧ ra_deq y ⟨ kc_app , scons z j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons y ∅) ⟩ ⟨ kc_app , scons z j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ⇒ x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z j2_c5 ∈ J ∧ ra_deq y ⟨ kc_app , scons z j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons y ∅) ⟩ ⟨ kc_app , scons z j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J $ by ax
l5: $ G , x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ , x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z j2_c5 ∈ J ∧ ra_deq y ⟨ kc_app , scons z j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons y ∅) ⟩ ⟨ kc_app , scons z j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ , x = ⟨ ∅ , ra_pred_eqs y z ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z j2_c5 ∈ J ∧ ra_deq y ⟨ kc_app , scons z j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons y ∅) ⟩ ⟨ kc_app , scons z j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ⇒ ∃ G_v ∃ p_v (t1 = G_v ∧ t2 = p_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ p_v ∈ lrel ∧ ra_deq G_v p_v p_v j2_c5 ∈ J ∧ ra_deq G_v ⟨ kc_app , scons p_v j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons p_v j2_c3 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J) $ by j2_e_pred_eqs_i [l3, l4, l5]
