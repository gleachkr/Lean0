l1: $ G ⇒ x = ⟨ scons (ra_add_eqs V1 V3) ∅ , ra_mul_eqs V1 V2 V3 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ j2_c6 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V3 (scons ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J $ by and_elim_r [#2]
