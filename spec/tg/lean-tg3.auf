lrel3_cwf_cases
---------------
l1: $ G ⇒ isset (ra_cwf t1 t2 t3 t4 t5 t6 t7 t8) $ by opair_isset
l2: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 $ by ax
l3: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 = c $ by eq_sym [l2]
l4: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 $ by ax
l14: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ pr_cwf J $ by lprog3_cwf_pr [l15]
l17: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $ by j2_o_cwf [l16, l11]
l18: $ G , c = ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_ctors_wf_nil (G: hyps) (J: class) {D n_v np l_v i_v Ctx: set} (pp t1 t2 t3 t4 t5 t6 t7 x V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ ∅ , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟩ = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_ctors_wf t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l7: $ G ⇒ isset (ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 = ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 = ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ $ by and_elim_r [l8]
l11: $ G ⇒ isset ⟨ kc_cnil , ∅ ⟩ $ by opair_isset
l12: $ G ⇒ isset V6 $ by isset_var
l13: $ G ⇒ isset V5 $ by isset_var
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ isset V3 $ by isset_var
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ isset V1 $ by isset_var
l18: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l19: $ G ⇒ isset t7 $ by isset_var
l20: $ G ⇒ scons t7 ∅ ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t6 $ by isset_var
l22: $ G ⇒ scons t6 (scons t7 ∅) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ isset t5 $ by isset_var
l24: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) ∈ fseq j2_vv $ by j2_fs [l23, l22]
l25: $ G ⇒ isset t4 $ by isset_var
l26: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) ∈ fseq j2_vv $ by j2_fs [l25, l24]
l27: $ G ⇒ isset t3 $ by isset_var
l28: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) ∈ fseq j2_vv $ by j2_fs [l27, l26]
l29: $ G ⇒ isset t2 $ by isset_var
l30: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) ∈ fseq j2_vv $ by j2_fs [l29, l28]
l31: $ G ⇒ isset t1 $ by isset_var
l32: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq j2_vv $ by j2_fs [l31, l30]
l33: $ G ⇒ scons ⟨ kc_cnil , ∅ ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l11, l18]
l34: $ G ⇒ scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l12, l33]
l35: $ G ⇒ scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l13, l34]
l36: $ G ⇒ scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l14, l35]
l37: $ G ⇒ scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l15, l36]
l38: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))))) ∈ fseq j2_vv $ by j2_fs [l16, l37]
l39: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))))) ∈ fseq j2_vv $ by j2_fs [l17, l38]
l40: $ G ⇒ kr_ctors_wf ∈ ω $ by kr_ctors_wf_omega
l41: $ G ⇒ isset kr_ctors_wf $ by wcel_isset [l40]
l42: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l32]
l43: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))))))) $ by wcel_isset [l39]
l44: $ G ⇒ kr_ctors_wf = kr_ctors_wf ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))))) $ by opair_inj_c [l10, l41, l42, l41, l43]
l45: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))))) $ by and_elim_r [l44]
l46: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))))) $ by j2_scons_inj [l45, l31, l17, l30, l38]
l47: $ G ⇒ t1 = V1 $ by and_elim_l [l46]
l48: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))))) $ by and_elim_r [l46]
l49: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))) $ by j2_scons_inj [l48, l29, l16, l28, l37]
l50: $ G ⇒ t2 = V2 $ by and_elim_l [l49]
l51: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)))) $ by and_elim_r [l49]
l52: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))) $ by j2_scons_inj [l51, l27, l15, l26, l36]
l53: $ G ⇒ t3 = V3 $ by and_elim_l [l52]
l54: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅))) $ by and_elim_r [l52]
l55: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)) $ by j2_scons_inj [l54, l25, l14, l24, l35]
l56: $ G ⇒ t4 = V4 $ by and_elim_l [l55]
l57: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅)) $ by and_elim_r [l55]
l58: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅) $ by j2_scons_inj [l57, l23, l13, l22, l34]
l59: $ G ⇒ t5 = V5 $ by and_elim_l [l58]
l60: $ G ⇒ scons t6 (scons t7 ∅) = scons V6 (scons ⟨ kc_cnil , ∅ ⟩ ∅) $ by and_elim_r [l58]
l61: $ G ⇒ t6 = V6 ∧ scons t7 ∅ = scons ⟨ kc_cnil , ∅ ⟩ ∅ $ by j2_scons_inj [l60, l21, l12, l20, l33]
l62: $ G ⇒ t6 = V6 $ by and_elim_l [l61]
l63: $ G ⇒ scons t7 ∅ = scons ⟨ kc_cnil , ∅ ⟩ ∅ $ by and_elim_r [l61]
l64: $ G ⇒ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l63, l19, l11, l18, l18]
l65: $ G ⇒ t7 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l64]
l66: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = ⟨ kc_cnil , ∅ ⟩ $ by j2_and6 [l47, l50, l53, l56, l59, l62, l65]
l67: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $ by j2_exi6 [l66]

lemma j2_d_ctors_wf_nil (G: hyps) (J: class) {D n_v np l_v i_v Ctx: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_nil ⇒ x ∊ cl_ctors_wf_nil $ by ax
l2: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_ctors_wf y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $ by j2_e_ctors_wf_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_nil ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $ by j2_ex6 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma j2_e_ctors_wf_cons (G: hyps) (J: class) {D n_v np l_v i_v Ctx K C b_v P T R: set} (pp t1 t2 t3 t4 t5 t6 t7 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12: set):
  $ G ⇒ x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ⟩ ∧ ra_ind_data V1 V9 V10 V11 ∈ lrel ∧ ra_pis V10 V7 V12 ∈ lrel ∧ ra_closed V2 V12 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C ∃ b_v ∃ P ∃ T ∃ R (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n_v R ∈ lrel ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V1 V9 V10 V11 ∈ lrel ∧ ra_pis V10 V7 V12 ∈ lrel ∧ ra_closed V2 V12 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) , ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ⟩ = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅)) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_ctors_wf t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l9: $ G ⇒ isset (ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) ∧ ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 = ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) $ by and_elim_l [l10]
l12: $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 = ra_ctors_wf V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ $ by and_elim_r [l10]
l13: $ G ⇒ isset ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ $ by opair_isset
l14: $ G ⇒ isset V6 $ by isset_var
l15: $ G ⇒ isset V5 $ by isset_var
l16: $ G ⇒ isset V4 $ by isset_var
l17: $ G ⇒ isset V3 $ by isset_var
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ isset V1 $ by isset_var
l20: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l21: $ G ⇒ isset t7 $ by isset_var
l22: $ G ⇒ scons t7 ∅ ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ isset t6 $ by isset_var
l24: $ G ⇒ scons t6 (scons t7 ∅) ∈ fseq j2_vv $ by j2_fs [l23, l22]
l25: $ G ⇒ isset t5 $ by isset_var
l26: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) ∈ fseq j2_vv $ by j2_fs [l25, l24]
l27: $ G ⇒ isset t4 $ by isset_var
l28: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) ∈ fseq j2_vv $ by j2_fs [l27, l26]
l29: $ G ⇒ isset t3 $ by isset_var
l30: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) ∈ fseq j2_vv $ by j2_fs [l29, l28]
l31: $ G ⇒ isset t2 $ by isset_var
l32: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) ∈ fseq j2_vv $ by j2_fs [l31, l30]
l33: $ G ⇒ isset t1 $ by isset_var
l34: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq j2_vv $ by j2_fs [l33, l32]
l35: $ G ⇒ scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l13, l20]
l36: $ G ⇒ scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l14, l35]
l37: $ G ⇒ scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l36]
l38: $ G ⇒ scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l37]
l39: $ G ⇒ scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l17, l38]
l40: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅))))) ∈ fseq j2_vv $ by j2_fs [l18, l39]
l41: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)))))) ∈ fseq j2_vv $ by j2_fs [l19, l40]
l42: $ G ⇒ kr_ctors_wf ∈ ω $ by kr_ctors_wf_omega
l43: $ G ⇒ isset kr_ctors_wf $ by wcel_isset [l42]
l44: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l34]
l45: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅))))))) $ by wcel_isset [l41]
l46: $ G ⇒ kr_ctors_wf = kr_ctors_wf ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)))))) $ by opair_inj_c [l12, l43, l44, l43, l45]
l47: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)))))) $ by and_elim_r [l46]
l48: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅))))) $ by j2_scons_inj [l47, l33, l19, l32, l40]
l49: $ G ⇒ t1 = V1 $ by and_elim_l [l48]
l50: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅))))) $ by and_elim_r [l48]
l51: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)))) $ by j2_scons_inj [l50, l31, l18, l30, l39]
l52: $ G ⇒ t2 = V2 $ by and_elim_l [l51]
l53: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)))) $ by and_elim_r [l51]
l54: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅))) $ by j2_scons_inj [l53, l29, l17, l28, l38]
l55: $ G ⇒ t3 = V3 $ by and_elim_l [l54]
l56: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅))) $ by and_elim_r [l54]
l57: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)) $ by j2_scons_inj [l56, l27, l16, l26, l37]
l58: $ G ⇒ t4 = V4 $ by and_elim_l [l57]
l59: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅)) $ by and_elim_r [l57]
l60: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅) $ by j2_scons_inj [l59, l25, l15, l24, l36]
l61: $ G ⇒ t5 = V5 $ by and_elim_l [l60]
l62: $ G ⇒ scons t6 (scons t7 ∅) = scons V6 (scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅) $ by and_elim_r [l60]
l63: $ G ⇒ t6 = V6 ∧ scons t7 ∅ = scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅ $ by j2_scons_inj [l62, l23, l14, l22, l35]
l64: $ G ⇒ t6 = V6 $ by and_elim_l [l63]
l65: $ G ⇒ scons t7 ∅ = scons ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∅ $ by and_elim_r [l63]
l66: $ G ⇒ t7 = ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l65, l21, l13, l20, l20]
l67: $ G ⇒ t7 = ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ $ by and_elim_l [l66]
l68: $ G ⇒ crn pp = crn (scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅)) $ by crn_eq [l11]
l69: $ G ⇒ crn (scons (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅)) ⊆ lrel3 J $ by subset_eq_l [l68, #3]
l70: $ G ⇒ isset (ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7) $ by opair_isset
l71: $ G ⇒ ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7 ∈ lrel3 J $ by crn_scons_head [l70, l69]
l72: $ G ⇒ crn (scons (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) ∅) ⊆ lrel3 J $ by crn_scons_tail [l69]
l73: $ G ⇒ isset (ra_ctors_wf V1 V2 V3 V4 V5 V6 V8) $ by opair_isset
l74: $ G ⇒ ra_ctors_wf V1 V2 V3 V4 V5 V6 V8 ∈ lrel3 J $ by crn_scons_head [l73, l72]
l75: $ G ⇒ ra_ind_data V1 V9 V10 V11 ∈ lrel $ by and_elim_l [l2]
l76: $ G ⇒ ra_pis V10 V7 V12 ∈ lrel ∧ ra_closed V2 V12 ∈ lrel $ by and_elim_r [l2]
l77: $ G ⇒ ra_pis V10 V7 V12 ∈ lrel $ by and_elim_l [l76]
l78: $ G ⇒ ra_closed V2 V12 ∈ lrel $ by and_elim_r [l76]
l79: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = ⟨ kc_ccons , scons V7 (scons V8 ∅) ⟩ ∧ ra_ind_data V1 V9 V10 V11 ∈ lrel ∧ ra_pis V10 V7 V12 ∈ lrel ∧ ra_closed V2 V12 ∈ lrel ∧ ra_cwf V1 V2 V3 V4 V5 V6 ⟨ kc_nz , ∅ ⟩ V7 ∈ lrel3 J ∧ ra_ctors_wf V1 V2 V3 V4 V5 V6 V8 ∈ lrel3 J $ by j2_and11 [l49, l52, l55, l58, l61, l64, l67, l75, l77, l78, l71, l74]
l80: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C ∃ b_v ∃ P ∃ T ∃ R (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n_v R ∈ lrel ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by j2_exi12 [l79]

lemma j2_d_ctors_wf_cons (G: hyps) (J: class) {D n_v np l_v i_v Ctx K C b_v P T R: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_ctors_wf_cons $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C ∃ b_v ∃ P ∃ T ∃ R (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n_v R ∈ lrel ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_cons ⇒ x ∊ cl_ctors_wf_cons $ by ax
l2: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_ctors_wf_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j (x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ∧ ra_ind_data y f g i ∈ lrel ∧ ra_pis g b j ∈ lrel ∧ ra_closed z j ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ∧ ra_ind_data y f g i ∈ lrel ∧ ra_pis g b j ∈ lrel ∧ ra_closed z j ∈ lrel ⇒ x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ∧ ra_ind_data y f g i ∈ lrel ∧ ra_pis g b j ∈ lrel ∧ ra_closed z j ∈ lrel ⇒ x = ⟨ scons (ra_cwf y z u v w a ⟨ kc_nz , ∅ ⟩ b) (scons (ra_ctors_wf y z u v w a c) ∅) , ra_ctors_wf y z u v w a ⟨ kc_ccons , scons b (scons c ∅) ⟩ ⟩ ∧ ra_ind_data y f g i ∈ lrel ∧ ra_pis g b j ∈ lrel ∧ ra_closed z j ∈ lrel $ by ax
