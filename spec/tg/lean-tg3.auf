l41: $ G ⇒ ra_tys_closed V5 V6 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [l2]
l42: $ G ⇒ ra_tys_closed V5 V6 ∈ lrel $ by and_elim_l [l41]
l43: $ G ⇒ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [l41]
l44: $ G ⇒ t1 = V1 ∧ t2 = V3 ∧ ra_ind_data V3 V4 V5 V6 ∈ lrel ∧ ra_tys_closed V5 V6 ∈ lrel ∧ ra_ctx_wf V1 V5 ∈ lrel3 J ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_tys_ty V2 V6 ∈ lrel3 J $ by j2_and6 [l29, l32, l40, l42, l36, l43, l39]
l45: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by j2_exi6 [l44]

lemma j2_d_tys_ok_i (G: hyps) (J: class) {G_v G2 D b_v P T: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_ok t1 t2 ⟩ ∈ cl_tys_ok_i $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x ∊ cl_tys_ok_i ⇒ x ∊ cl_tys_ok_i $ by ax
l2: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x ∊ cl_tys_ok_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_tys_closed w a ∈ lrel ∧ ra_capp w y z ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_tys_closed w a ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x = ⟨ pp , ra_tys_ok t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_tys_closed w a ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_tys_closed w a ∈ lrel ∧ ra_capp w y z ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_tys_closed w a ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_tys_closed w a ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by j2_e_tys_ok_i [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x ∊ cl_tys_ok_i ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by j2_ex6 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_tys_ok (G: hyps) (J: class) {G_v G2 D b_v P T: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_ok t1 t2 ⟩ ∈ pr_tys_ok $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_tys_closed P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $
