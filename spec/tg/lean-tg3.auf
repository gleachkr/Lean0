l43: $ G ⇒ kr_gcd_eqs ∈ ω $ by kr_gcd_eqs_omega
l44: $ G ⇒ ra_gcd_eqs A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15 A16 A17 A18 A19 A20 A21 A22 A23 A24 A25 A26 A27 A28 A29 A30 A31 A32 A33 A34 A35 A36 A37 A38 A39 A40 A41 ∈ latoms $ by cxp_intro_c [l43, l42]

--| A clause of the union whose premises are derivable.
lemma j3_horn (G: hyps) (J P C: class):
  $ G ⇒ ⟨ P , C ⟩ ∈ j3_top J $ > $ G ⇒ P ∈ fseq latoms $ > $ G ⇒ C ∈ latoms $ >
  $ G ⇒ crn P ⊆ lrel3 J $ > $ G ⇒ C ∈ lrel3 J $
----
l1: $ G ⇒ ⟨ P , C ⟩ ∈ fseq latoms × latoms $ by cxp_intro_c [#2, #3]
l2: $ G ⇒ ⟨ P , C ⟩ ∈ lprog3 J $ by wcel_cin [#1, l1]
l3: $ G ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l4: $ G ⇒ isset P $ by wcel_isset [#2]
l5: $ G ⇒ isset C $ by wcel_isset [#3]
l6: $ G ⇒ C ∈ lrel3 J $ by horn_intro_c [l3, l2, l4, l5, #4]

--| A derivable atom of the stratum is an atom.
lemma j3_lrel3_lat (G: hyps) (J X: class): $ G ⇒ X ∈ lrel3 J $ > $ G ⇒ X ∈ latoms $
----
l1: $ G ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l2: $ G ⇒ horn (lprog3 J) ⊆ latoms $ by horn_sub [l1]
l3: $ G ⇒ X ∈ latoms $ by wcel_subset [l2, #1]

--| A value of a sequence read through a name of it.
lemma j3_fvx (G H: hyps) (F S I A: class): $ G ⇒ F = S $ > $ H ⇒ fv S I = A $ > $ G , H ⇒ A = fv F I $
----
l1: $ G , H ⇒ F = S $ by weaken [#1]
l2: $ G , H ⇒ fv S I = A $ by weaken [#2]
l3: $ G , H ⇒ I = I $ by eq_refl
l4: $ G , H ⇒ fv F I = fv S I $ by fv_eq [l1, l3]
l5: $ G , H ⇒ fv F I = A $ by eq_trans [l4, l2]
l6: $ G , H ⇒ A = fv F I $ by eq_sym [l5]

lemma j3_fv_0 (G: hyps) (A1 R: class):
  $ G ⇒ isset A1 $ >
  $ G ⇒ isset R $ >
  $ G ⇒ fv (scons A1 R) ix0 = A1 $
----
l1: $ G ⇒ fv (scons A1 R) ix0 = A1 $ by scons_fv_zero_c [#1, #2]

lemma j3_ix_0 (G: hyps): $ G ⇒ isset ix0 $
----
l1: $ G ⇒ isset ix0 $ by ax_empty

lemma j3_ss_1 (G: hyps) (A1 R: class): $ G ⇒ isset R $ > $ G ⇒ isset (scons A1 R) $
----
l1: $ G ⇒ isset (scons A1 R) $ by scons_set [#1]

lemma j3_fv_1 (G: hyps) (A1 A2 R: class):
  $ G ⇒ isset A1 $ >
  $ G ⇒ isset A2 $ >
  $ G ⇒ isset R $ >
  $ G ⇒ fv (scons A1 (scons A2 R)) ix1 = A2 $
----
l1: $ G ⇒ isset (scons A2 R) $ by j3_ss_1 [#3]
l2: $ G ⇒ fv (scons A2 R) ix0 = A2 $ by j3_fv_0 [#2, #3]
l3: $ G ⇒ isset ix0 $ by j3_ix_0
l4: $ G ⇒ fv (scons A1 (scons A2 R)) (suc ix0) = fv (scons A2 R) ix0 $ by scons_fv_suc_c [#1, l1, l3]
l5: $ G ⇒ fv (scons A1 (scons A2 R)) ix1 = A2 $ by eq_trans [l4, l2]

lemma j3_ix_1 (G: hyps): $ G ⇒ isset ix1 $
----
l1: $ G ⇒ isset ix0 $ by j3_ix_0
l2: $ G ⇒ isset ix1 $ by suc_set [l1]

lemma j3_ss_2 (G: hyps) (A1 A2 R: class): $ G ⇒ isset R $ > $ G ⇒ isset (scons A1 (scons A2 R)) $
----
l1: $ G ⇒ isset (scons A2 R) $ by j3_ss_1 [#1]
l2: $ G ⇒ isset (scons A1 (scons A2 R)) $ by scons_set [l1]

lemma j3_fv_2 (G: hyps) (A1 A2 A3 R: class):
  $ G ⇒ isset A1 $ >
  $ G ⇒ isset A2 $ >
  $ G ⇒ isset A3 $ >
  $ G ⇒ isset R $ >
  $ G ⇒ fv (scons A1 (scons A2 (scons A3 R))) ix2 = A3 $
----
l1: $ G ⇒ isset (scons A2 (scons A3 R)) $ by j3_ss_2 [#4]
l2: $ G ⇒ fv (scons A2 (scons A3 R)) ix1 = A3 $ by j3_fv_1 [#2, #3, #4]
l3: $ G ⇒ isset ix1 $ by j3_ix_1
l4: $ G ⇒ fv (scons A1 (scons A2 (scons A3 R))) (suc ix1) = fv (scons A2 (scons A3 R)) ix1 $ by scons_fv_suc_c [#1, l1, l3]
l5: $ G ⇒ fv (scons A1 (scons A2 (scons A3 R))) ix2 = A3 $ by eq_trans [l4, l2]

lemma j3_ix_2 (G: hyps): $ G ⇒ isset ix2 $
----
l1: $ G ⇒ isset ix1 $ by j3_ix_1
l2: $ G ⇒ isset ix2 $ by suc_set [l1]

lemma j3_ss_3 (G: hyps) (A1 A2 A3 R: class): $ G ⇒ isset R $ > $ G ⇒ isset (scons A1 (scons A2 (scons A3 R))) $
----
l1: $ G ⇒ isset (scons A2 (scons A3 R)) $ by j3_ss_2 [#1]
l2: $ G ⇒ isset (scons A1 (scons A2 (scons A3 R))) $ by scons_set [l1]

lemma j3_fv_3 (G: hyps) (A1 A2 A3 A4 R: class):
  $ G ⇒ isset A1 $ >
  $ G ⇒ isset A2 $ >
  $ G ⇒ isset A3 $ >
  $ G ⇒ isset A4 $ >
  $ G ⇒ isset R $ >
  $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 R)))) ix3 = A4 $
----
l1: $ G ⇒ isset (scons A2 (scons A3 (scons A4 R))) $ by j3_ss_3 [#5]
l2: $ G ⇒ fv (scons A2 (scons A3 (scons A4 R))) ix2 = A4 $ by j3_fv_2 [#2, #3, #4, #5]
l3: $ G ⇒ isset ix2 $ by j3_ix_2
l4: $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 R)))) (suc ix2) = fv (scons A2 (scons A3 (scons A4 R))) ix2 $ by scons_fv_suc_c [#1, l1, l3]
l5: $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 R)))) ix3 = A4 $ by eq_trans [l4, l2]

lemma j3_ix_3 (G: hyps): $ G ⇒ isset ix3 $
----
l1: $ G ⇒ isset ix2 $ by j3_ix_2
l2: $ G ⇒ isset ix3 $ by suc_set [l1]

lemma j3_ss_4 (G: hyps) (A1 A2 A3 A4 R: class): $ G ⇒ isset R $ > $ G ⇒ isset (scons A1 (scons A2 (scons A3 (scons A4 R)))) $
----
l1: $ G ⇒ isset (scons A2 (scons A3 (scons A4 R))) $ by j3_ss_3 [#1]
l2: $ G ⇒ isset (scons A1 (scons A2 (scons A3 (scons A4 R)))) $ by scons_set [l1]

lemma j3_fv_4 (G: hyps) (A1 A2 A3 A4 A5 R: class):
  $ G ⇒ isset A1 $ >
  $ G ⇒ isset A2 $ >
  $ G ⇒ isset A3 $ >
  $ G ⇒ isset A4 $ >
  $ G ⇒ isset A5 $ >
  $ G ⇒ isset R $ >
  $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 R))))) ix4 = A5 $
----
l1: $ G ⇒ isset (scons A2 (scons A3 (scons A4 (scons A5 R)))) $ by j3_ss_4 [#6]
l2: $ G ⇒ fv (scons A2 (scons A3 (scons A4 (scons A5 R)))) ix3 = A5 $ by j3_fv_3 [#2, #3, #4, #5, #6]
l3: $ G ⇒ isset ix3 $ by j3_ix_3
l4: $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 R))))) (suc ix3) = fv (scons A2 (scons A3 (scons A4 (scons A5 R)))) ix3 $ by scons_fv_suc_c [#1, l1, l3]
l5: $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 R))))) ix4 = A5 $ by eq_trans [l4, l2]

lemma j3_ix_4 (G: hyps): $ G ⇒ isset ix4 $
----
l1: $ G ⇒ isset ix3 $ by j3_ix_3
l2: $ G ⇒ isset ix4 $ by suc_set [l1]

lemma j3_ss_5 (G: hyps) (A1 A2 A3 A4 A5 R: class): $ G ⇒ isset R $ > $ G ⇒ isset (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 R))))) $
----
l1: $ G ⇒ isset (scons A2 (scons A3 (scons A4 (scons A5 R)))) $ by j3_ss_4 [#1]
l2: $ G ⇒ isset (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 R))))) $ by scons_set [l1]

lemma j3_fv_5 (G: hyps) (A1 A2 A3 A4 A5 A6 R: class):
  $ G ⇒ isset A1 $ >
  $ G ⇒ isset A2 $ >
  $ G ⇒ isset A3 $ >
  $ G ⇒ isset A4 $ >
  $ G ⇒ isset A5 $ >
  $ G ⇒ isset A6 $ >
  $ G ⇒ isset R $ >
  $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 R)))))) ix5 = A6 $
----
l1: $ G ⇒ isset (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 R))))) $ by j3_ss_5 [#7]
l2: $ G ⇒ fv (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 R))))) ix4 = A6 $ by j3_fv_4 [#2, #3, #4, #5, #6, #7]
l3: $ G ⇒ isset ix4 $ by j3_ix_4
l4: $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 R)))))) (suc ix4) = fv (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 R))))) ix4 $ by scons_fv_suc_c [#1, l1, l3]
l5: $ G ⇒ fv (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 R)))))) ix5 = A6 $ by eq_trans [l4, l2]

lemma j3_ix_5 (G: hyps): $ G ⇒ isset ix5 $
----
