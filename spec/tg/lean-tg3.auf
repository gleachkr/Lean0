l14: $ _ ⇒ enc_expr (pi A B) ∈ trees ω $ by enc_expr_trees
l15: $ _ ⇒ ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ ∈ trees ω $ by wcel_eq_l [l13, l14]
l16: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
l17: $ _ ⇒ enc_nat n = enc_nat n $ by eq_refl
l18: $ _ ⇒ enc_nat np = enc_nat np $ by eq_refl
l19: $ _ ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l20: $ _ ⇒ enc_nat i = enc_nat i $ by eq_refl
l21: $ _ ⇒ enc_ctx (cons A2 Ctx) = ⟨ kc_cons , scons (enc_expr A2) (scons (enc_ctx Ctx) ∅) ⟩ $ by eq_refl
l22: $ _ ⇒ enc_nat (s d) = ⟨ kc_s , scons (enc_nat d) ∅ ⟩ $ by eq_refl
l23: $ _ ⇒ enc_expr B = enc_expr B $ by eq_refl
l24: $ _ ⇒ ra_cwf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx (cons A2 Ctx)) (enc_nat (s d)) (enc_expr B) = ra_cwf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) ⟨ kc_cons , scons (enc_expr A2) (scons (enc_ctx Ctx) ∅) ⟩ ⟨ kc_s , scons (enc_nat d) ∅ ⟩ (enc_expr B) $ by ra_cwf_eq [l16, l17, l18, l19, l20, l21, l22, l23]
l25: $ _ ⇒ ra_cwf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) ⟨ kc_cons , scons (enc_expr A2) (scons (enc_ctx Ctx) ∅) ⟩ ⟨ kc_s , scons (enc_nat d) ∅ ⟩ (enc_expr B) ∈ lrel3 J $ by wcel_eq_l [l24, #6]
l26: $ _ ⇒ enc_nat nz = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l27: $ _ ⇒ enc_nat k = enc_nat k $ by eq_refl
l28: $ _ ⇒ enc_expr A = enc_expr A $ by eq_refl
l29: $ _ ⇒ enc_expr A2 = enc_expr A2 $ by eq_refl
l30: $ _ ⇒ ra_sinst (enc_ind D) (enc_nat nz) (enc_nat n) (enc_nat k) (enc_expr A) (enc_expr A2) = ra_sinst (enc_ind D) ⟨ kc_nz , ∅ ⟩ (enc_nat n) (enc_nat k) (enc_expr A) (enc_expr A2) $ by ra_sinst_eq [l16, l26, l17, l27, l28, l29]
l31: $ _ ⇒ ra_sinst (enc_ind D) ⟨ kc_nz , ∅ ⟩ (enc_nat n) (enc_nat k) (enc_expr A) (enc_expr A2) ∈ lrel $ by wcel_eq_l [l30, #2]
l32: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l33: $ _ ⇒ enc_expr (srt u) = ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ $ by eq_refl
l34: $ _ ⇒ ra_deq (enc_ctx Ctx) (enc_expr A2) (enc_expr A2) (enc_expr (srt u)) = ra_deq (enc_ctx Ctx) (enc_expr A2) (enc_expr A2) ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ $ by ra_deq_eq [l32, l29, l29, l33]
l35: $ _ ⇒ ra_deq (enc_ctx Ctx) (enc_expr A2) (enc_expr A2) ⟨ kc_srt , scons (enc_lvl u) ∅ ⟩ ∈ J $ by wcel_eq_l [l34, #3]
l36: $ _ ⇒ ra_cwf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) (enc_nat d) ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ ∈ lrel3 J $ by j1_c_cwf_pi [l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l15, l25, #1, l31, l35, #4, #5]
l37: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
