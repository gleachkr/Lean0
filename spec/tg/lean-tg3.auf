l11: $ G ⇒ pp = ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_large t1 t2 = ra_large V1 V2 $ by and_elim_r [l10]
l13: $ G ⇒ isset V2 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
