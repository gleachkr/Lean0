l13: $ G , ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_z ∪ (cl_fprops_s J) , ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_s J ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_z ∪ (cl_fprops_s J) , ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_s J ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) ∨ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_z ∪ (cl_fprops_s J) ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) ∨ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_z ∪ (cl_fprops_s J) → ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) ∨ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) ∨ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by imp_elim [l16, #1]

lrel3_fprops_cases
------------------
l1: $ G ⇒ isset (ra_fprops t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l2: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 ⇒ c = ra_fprops t1 t2 t3 t4 t5 t6 t7 $ by ax
l3: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 ⇒ ra_fprops t1 t2 t3 t4 t5 t6 t7 = c $ by eq_sym [l2]
l4: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 ⇒ ra_fprops t1 t2 t3 t4 t5 t6 t7 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_fprops t1 t2 t3 t4 t5 t6 t7 $ by ax
l14: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ pr_fprops J $ by lprog3_fprops_pr [l15]
l17: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) ∨ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by j2_o_fprops [l16, l11]
l18: $ G , c = ra_fprops t1 t2 t3 t4 t5 t6 t7 ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) ∨ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) ∨ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_proj_ok_sort (G: hyps) (J: class) {G_v D b_v P T j_v i_v F C l_v: set} (pp t1 t2 t3 t4 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10: set):
  $ G ⇒ x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_proj_ok V1 V2 V6 V7 ⟩ ∧ ra_ind_data V2 V3 V4 V5 ∈ lrel ∧ ra_nth_ty V5 V6 V8 V9 ∈ lrel ∧ ra_isort V8 ⟨ kc_nz , ∅ ⟩ V10 ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons V10 ∅) ⟩ V10 $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ F ∃ C ∃ l_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $
----
l1: $ G ⇒ x = ⟨ ∅ , ra_proj_ok V1 V2 V6 V7 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V2 V3 V4 V5 ∈ lrel ∧ ra_nth_ty V5 V6 V8 V9 ∈ lrel ∧ ra_isort V8 ⟨ kc_nz , ∅ ⟩ V10 ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons V10 ∅) ⟩ V10 $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_proj_ok V1 V2 V6 V7 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ ∅ , ra_proj_ok V1 V2 V6 V7 ⟩ = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_proj_ok t1 t2 t3 t4) $ by opair_isset
l9: $ G ⇒ isset (ra_proj_ok V1 V2 V6 V7) $ by opair_isset
l10: $ G ⇒ pp = ∅ ∧ ra_proj_ok t1 t2 t3 t4 = ra_proj_ok V1 V2 V6 V7 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_proj_ok t1 t2 t3 t4 = ra_proj_ok V1 V2 V6 V7 $ by and_elim_r [l10]
l13: $ G ⇒ isset V7 $ by isset_var
l14: $ G ⇒ isset V6 $ by isset_var
l15: $ G ⇒ isset V2 $ by isset_var
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l18: $ G ⇒ isset t4 $ by isset_var
l19: $ G ⇒ scons t4 ∅ ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ isset t3 $ by isset_var
l21: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq j2_vv $ by j2_fs [l20, l19]
l22: $ G ⇒ isset t2 $ by isset_var
l23: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq j2_vv $ by j2_fs [l22, l21]
l24: $ G ⇒ isset t1 $ by isset_var
l25: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq j2_vv $ by j2_fs [l24, l23]
l26: $ G ⇒ scons V7 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l17]
l27: $ G ⇒ scons V6 (scons V7 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l26]
l28: $ G ⇒ scons V2 (scons V6 (scons V7 ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l27]
l29: $ G ⇒ scons V1 (scons V2 (scons V6 (scons V7 ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l28]
l30: $ G ⇒ kr_proj_ok ∈ ω $ by kr_proj_ok_omega
l31: $ G ⇒ isset kr_proj_ok $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l25]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V6 (scons V7 ∅)))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_proj_ok = kr_proj_ok ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V6 (scons V7 ∅))) $ by opair_inj_c [l12, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V6 (scons V7 ∅))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V6 (scons V7 ∅)) $ by j2_scons_inj [l35, l24, l16, l23, l28]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V6 (scons V7 ∅)) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons V6 (scons V7 ∅) $ by j2_scons_inj [l38, l22, l15, l21, l27]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 ∅) = scons V6 (scons V7 ∅) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V6 ∧ scons t4 ∅ = scons V7 ∅ $ by j2_scons_inj [l41, l20, l14, l19, l26]
l43: $ G ⇒ t3 = V6 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 ∅ = scons V7 ∅ $ by and_elim_r [l42]
l45: $ G ⇒ t4 = V7 ∧ ∅ = ∅ $ by j2_scons_inj [l44, l18, l13, l17, l17]
l46: $ G ⇒ t4 = V7 $ by and_elim_l [l45]
l47: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V2 V3 V4 V5 ∈ lrel ∧ ra_nth_ty V5 V6 V8 V9 ∈ lrel ∧ ra_isort V8 ⟨ kc_nz , ∅ ⟩ V10 ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons V10 ∅) ⟩ V10 $ by j2_and4 [l37, l40, l43, l46, l2]
l48: $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ F ∃ C ∃ l_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $ by j2_exi10 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, b9 := $ V9 $, b10 := $ V10 $, p := $ t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v $) [l47]

lemma j2_d_proj_ok_sort (G: hyps) (J: class) {G_v D b_v P T j_v i_v F C l_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ F ∃ C ∃ l_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $
----
l1: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x ∊ cl_proj_ok_sort ⇒ x ∊ cl_proj_ok_sort $ by ax
l2: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x ∊ cl_proj_ok_sort ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g ⇒ x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g ⇒ x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g $ by ax
l5: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ F ∃ C ∃ l_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $ by j2_e_proj_ok_sort [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x ∊ cl_proj_ok_sort ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ F ∃ C ∃ l_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $ by j2_ex10 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ F ∃ C ∃ l_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $ by wcel_elim [#1, l7]

lemma j2_e_proj_ok_prop (G: hyps) (J: class) {G_v G2 D b_v P T j_v i_v np n_v m_v F K C: set} (pp t1 t2 t3 t4 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14: set):
  $ G ⇒ x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_fprops V3 V10 V9 V2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons V8 ∅ ⟩ V13) ∅ , ra_proj_ok V1 V3 V7 V8 ⟩ ∧ ra_ind_data V3 V4 V5 V6 ∈ lrel ∧ ra_clen V5 V9 ∈ lrel ∧ ra_ntys V6 V10 V11 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V6 V7 V12 V14 ∈ lrel ∧ ra_nth_ctor V14 ⟨ kc_nz , ∅ ⟩ V13 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ C (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_fprops D n_v np G2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ K ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_fprops V3 V10 V9 V2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons V8 ∅ ⟩ V13) ∅ , ra_proj_ok V1 V3 V7 V8 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V3 V4 V5 V6 ∈ lrel ∧ ra_clen V5 V9 ∈ lrel ∧ ra_ntys V6 V10 V11 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V6 V7 V12 V14 ∈ lrel ∧ ra_nth_ctor V14 ⟨ kc_nz , ∅ ⟩ V13 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ = ⟨ scons (ra_fprops V3 V10 V9 V2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons V8 ∅ ⟩ V13) ∅ , ra_proj_ok V1 V3 V7 V8 ⟩ $ by eq_trans [l3, l1]
