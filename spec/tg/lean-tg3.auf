lemma j2_d_tys_ok_i (G: hyps) (J: class) {G_v G2 D b_v P T: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_ok t1 t2 ⟩ ∈ cl_tys_ok_i $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x ∊ cl_tys_ok_i ⇒ x ∊ cl_tys_ok_i $ by ax
l2: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x ∊ cl_tys_ok_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_capp w y z ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x = ⟨ pp , ra_tys_ok t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_capp w y z ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y w) (scons (ra_tys_ty z a) ∅) , ra_tys_ok y u ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by j2_e_tys_ok_i [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_tys_ok t1 t2 ⟩ , x ∊ cl_tys_ok_i ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by j2_ex6 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_tys_ok (G: hyps) (J: class) {G_v G2 D b_v P T: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_ok t1 t2 ⟩ ∈ pr_tys_ok $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $
----
l1: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by j2_d_tys_ok_i [#1, #2]

