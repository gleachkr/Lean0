l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ z = ra_closed ⟨ kc_nz , ∅ ⟩ A2 $ by ra_closed_eq [l9, l2]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A2 = ra_closed ⟨ kc_nz , ∅ ⟩ z $ by eq_sym [l10]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel $ by wcel_eq_l [l11, l8]
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 ⇒ ra_deq A1 A2 A2 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J $ by weaken [#10]
