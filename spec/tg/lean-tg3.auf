l2: $ G ⇒ kr_elim_ok ⊆ kr_fprops $ by suc_subset
l3: $ G ⇒ kr_fprops ⊆ kr_sub_eqs $ by j2_f13
l4: $ G ⇒ kr_nst_ok ⊆ kr_fprops $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_nst_ok ⊆ kr_sub_eqs $ by subset_trans [l4, l3]

