ctors_wf_cons_j
---------------
l1: $ _ ⇒ enc_ind D ∈ trees ω $ by enc_ind_trees
l2: $ _ ⇒ enc_nat n ∈ trees ω $ by enc_nat_trees
l3: $ _ ⇒ enc_nat np ∈ trees ω $ by enc_nat_trees
l4: $ _ ⇒ enc_lvl l ∈ trees ω $ by enc_lvl_trees
l5: $ _ ⇒ enc_nat i ∈ trees ω $ by enc_nat_trees
l6: $ _ ⇒ enc_ctx Ctx ∈ trees ω $ by enc_ctx_trees
l7: $ _ ⇒ enc_expr K ∈ trees ω $ by enc_expr_trees
l8: $ _ ⇒ enc_ctors C ∈ trees ω $ by enc_ctors_trees
l9: $ _ ⇒ enc_ctors (ccons K C) = ⟨ kc_ccons , scons (enc_expr K) (scons (enc_ctors C) ∅) ⟩ $ by eq_refl
l10: $ _ ⇒ enc_ctors (ccons K C) ∈ trees ω $ by enc_ctors_trees
l11: $ _ ⇒ ⟨ kc_ccons , scons (enc_expr K) (scons (enc_ctors C) ∅) ⟩ ∈ trees ω $ by wcel_eq_l [l9, l10]
l12: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
l13: $ _ ⇒ enc_nat n = enc_nat n $ by eq_refl
l14: $ _ ⇒ enc_nat np = enc_nat np $ by eq_refl
l15: $ _ ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l16: $ _ ⇒ enc_nat i = enc_nat i $ by eq_refl
l17: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l18: $ _ ⇒ enc_nat nz = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l19: $ _ ⇒ enc_expr K = enc_expr K $ by eq_refl
l20: $ _ ⇒ ra_cwf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) (enc_nat nz) (enc_expr K) = ra_cwf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) ⟨ kc_nz , ∅ ⟩ (enc_expr K) $ by ra_cwf_eq [l12, l13, l14, l15, l16, l17, l18, l19]
l21: $ _ ⇒ ra_cwf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) ⟨ kc_nz , ∅ ⟩ (enc_expr K) ∈ lrel3 J $ by wcel_eq_l [l20, #1]
l22: $ _ ⇒ ra_ctors_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) ⟨ kc_ccons , scons (enc_expr K) (scons (enc_ctors C) ∅) ⟩ ∈ lrel3 J $ by j1_c_ctors_wf_cons [l1, l2, l3, l4, l5, l6, l7, l8, l11, l21, #2]
l23: $ _ ⇒ enc_ind D = enc_ind D $ by eq_refl
l24: $ _ ⇒ enc_nat n = enc_nat n $ by eq_refl
l25: $ _ ⇒ enc_nat np = enc_nat np $ by eq_refl
l26: $ _ ⇒ enc_lvl l = enc_lvl l $ by eq_refl
l27: $ _ ⇒ enc_nat i = enc_nat i $ by eq_refl
l28: $ _ ⇒ enc_ctx Ctx = enc_ctx Ctx $ by eq_refl
l29: $ _ ⇒ ⟨ kc_ccons , scons (enc_expr K) (scons (enc_ctors C) ∅) ⟩ = enc_ctors (ccons K C) $ by eq_refl
l30: $ _ ⇒ ra_ctors_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) ⟨ kc_ccons , scons (enc_expr K) (scons (enc_ctors C) ∅) ⟩ = ra_ctors_wf (enc_ind D) (enc_nat n) (enc_nat np) (enc_lvl l) (enc_nat i) (enc_ctx Ctx) (enc_ctors (ccons K C)) $ by ra_ctors_wf_eq [l23, l24, l25, l26, l27, l28, l29]
l31: $ ctors_wf_j J D n np l i Ctx (ccons K C) $ by wcel_eq_l [l30, l22]

lemma j1_pr_tys_wf (G: hyps) (J X: class): $ G ⇒ X ∈ pr_tys_wf $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ pr_ctors_wf ∪ pr_tys_wf $ by j1_in_r [#1]
l2: $ G ⇒ X ∈ ((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf)) $ by j1_in_l [l2]
l4: $ G ⇒ X ∈ ((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J))))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j1_in_l [l4]

lemma j1_ra_tys_wf (G: hyps) (A1 A2 A3 A4 A5 A6 A7: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ > $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ >
  $ G ⇒ ra_tys_wf A1 A2 A3 A4 A5 A6 A7 ∈ latoms $
