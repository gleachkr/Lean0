l5: $ G ⇒ ⟨ ∅ , ra_pred_eqs V1 V2 ⟩ = ⟨ pp , ra_pred_eqs t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_pred_eqs t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_pred_eqs V1 V2) $ by opair_isset
