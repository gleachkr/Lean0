lemma j2_o_add_eqs (G: hyps) (J: class) {G_v f_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_add_eqs t1 t2 ⟩ ∈ pr_add_eqs J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v (t1 = G_v ∧ t2 = f_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $
----
l1: $ G ⇒ ∃ G_v ∃ f_v (t1 = G_v ∧ t2 = f_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $ by j2_d_add_eqs_i [#1, #2]

lrel3_add_eqs_cases
-------------------
l1: $ G ⇒ isset (ra_add_eqs t1 t2) $ by opair_isset
l2: $ G , c = ra_add_eqs t1 t2 ⇒ c = ra_add_eqs t1 t2 $ by ax
l3: $ G , c = ra_add_eqs t1 t2 ⇒ ra_add_eqs t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_add_eqs t1 t2 ⇒ ra_add_eqs t1 t2 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_add_eqs t1 t2 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_add_eqs t1 t2 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_add_eqs t1 t2 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_add_eqs t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_add_eqs t1 t2 $ by ax
l14: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_add_eqs t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_add_eqs t1 t2 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_add_eqs t1 t2 ⟩ ∈ pr_add_eqs J $ by lprog3_add_eqs_pr [l15]
l17: $ G , c = ra_add_eqs t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ f_v (t1 = G_v ∧ t2 = f_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $ by j2_o_add_eqs [l16, l11]
l18: $ G , c = ra_add_eqs t1 t2 ⇒ ∃ G_v ∃ f_v (t1 = G_v ∧ t2 = f_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ f_v (t1 = G_v ∧ t2 = f_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $ by isset_elim [l1, l18]

lemma j2_e_pred_eqs_i (G: hyps) (J: class) {G_v p_v: set} (pp t1 t2 x V1 V2: set):
  $ G ⇒ x = ⟨ pp , ra_pred_eqs t1 t2 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_pred_eqs V1 V2 ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J ∧ ra_deq V1 ⟨ kc_app , scons V2 (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons V1 ∅) ⟩ ⟨ kc_app , scons V2 (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ p_v (t1 = G_v ∧ t2 = p_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ p_v ∈ lrel ∧ ra_deq G_v p_v p_v ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J ∧ ra_deq G_v ⟨ kc_app , scons p_v (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons p_v (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J) $
----
l1: $ G ⇒ x = ⟨ ∅ , ra_pred_eqs V1 V2 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J ∧ ra_deq V1 ⟨ kc_app , scons V2 (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons V1 ∅) ⟩ ⟨ kc_app , scons V2 (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_pred_eqs t1 t2 ⟩ = x $ by eq_sym [#1]
