l1: $ G ⇒ ∃ G_v ∃ fd ∃ fm ∃ fmul ∃ fadd ∃ h1 ∃ h2 ∃ h3 (t1 = G_v ∧ t2 = fd ∧ t3 = fm ∧ t4 = fmul ∧ t5 = fadd ∧ ra_mul_eqs G_v fmul fadd ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ fd ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ fm ∈ lrel ∧ ra_deq G_v fd fd ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq G_v fm fm ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq G_v h1 h1 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_app , scons ⟨ kc_app , scons j2_c1 (scons ⟨ kc_app , scons ⟨ kc_app , scons fadd (scons ⟨ kc_app , scons ⟨ kc_app , scons fmul (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq G_v h2 h2 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons j2_c2 (scons ⟨ kc_app , scons ⟨ kc_app , scons ⟨ kc_ind_ty , scons tr_le_D (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq G_v h3 h3 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_app , scons ⟨ kc_app , scons j2_c1 (scons ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∈ J) $ by j2_d_divmod_eqs_i [#1, #2]

lrel3_divmod_eqs_cases
----------------------
l1: $ G ⇒ isset (ra_divmod_eqs t1 t2 t3 t4 t5) $ by opair_isset
l2: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 ⇒ c = ra_divmod_eqs t1 t2 t3 t4 t5 $ by ax
l3: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 ⇒ ra_divmod_eqs t1 t2 t3 t4 t5 = c $ by eq_sym [l2]
l4: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 ⇒ ra_divmod_eqs t1 t2 t3 t4 t5 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_divmod_eqs t1 t2 t3 t4 t5 $ by ax
l14: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_divmod_eqs t1 t2 t3 t4 t5 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_divmod_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_divmod_eqs t1 t2 t3 t4 t5 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
