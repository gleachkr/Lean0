lemma j2_f0 (G: hyps): $ G ⇒ kr_sty ⊆ kr_bitop_eqs $
----
l1: $ G ⇒ kr_sty ⊆ kr_sub_eqs $ by j2_f1
l2: $ G ⇒ kr_sub_eqs ⊆ kr_mul_eqs $ by suc_subset
