l16: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 (scons A12 (scons A13 (scons A14 (scons A15 ∅)))))))))))))) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l15]
