-- The union of `lprog3 J` as a tree of defs (the root `j2_u0 J` is that union).

def j2_u4 (J: class): class = $ pr_sty J ∪ (pr_cwf J) $

def j2_u5: class = $ pr_ctors_wf ∪ (pr_tys_wf) $

def j2_u3 (J: class): class = $ j2_u4 J ∪ (j2_u5) $

def j2_u7 (J: class): class = $ pr_ctx_wf J ∪ (pr_tys_ty J) $

def j2_u8: class = $ pr_tys_ok ∪ (pr_ind_wf) $

def j2_u6 (J: class): class = $ j2_u7 J ∪ (j2_u8) $

def j2_u2 (J: class): class = $ j2_u3 J ∪ (j2_u6 J) $

def j2_u11: class = $ pr_nst_ok ∪ (pr_large) $

def j2_u12 (J: class): class = $ pr_fir J ∪ (pr_elim_ok) $

def j2_u10 (J: class): class = $ j2_u11 ∪ (j2_u12 J) $

def j2_u14 (J: class): class = $ pr_fprops J ∪ (pr_proj_ok) $

def j2_u16 (J: class): class = $ pr_pred_eqs J ∪ (pr_sub_eqs J) $

def j2_u15 (J: class): class = $ pr_add_eqs J ∪ (j2_u16 J) $

def j2_u13 (J: class): class = $ j2_u14 J ∪ (j2_u15 J) $

def j2_u9 (J: class): class = $ j2_u10 J ∪ (j2_u13 J) $

def j2_u1 (J: class): class = $ j2_u2 J ∪ (j2_u9 J) $

def j2_u20 (J: class): class = $ pr_mul_eqs J ∪ (pr_pow_eqs J) $

def j2_u21 (J: class): class = $ pr_beq_eqs J ∪ (pr_ble_eqs J) $

def j2_u19 (J: class): class = $ j2_u20 J ∪ (j2_u21 J) $

def j2_u23 (J: class): class = $ pr_shl_eqs J ∪ (pr_shr_eqs J) $

def j2_u24 (J: class): class = $ pr_dec_eqs J ∪ (pr_ite_eqs J) $

def j2_u22 (J: class): class = $ j2_u23 J ∪ (j2_u24 J) $

def j2_u18 (J: class): class = $ j2_u19 J ∪ (j2_u22 J) $

def j2_u27 (J: class): class = $ pr_natle_dec J ∪ (pr_nateq_dec J) $

def j2_u28 (J: class): class = $ pr_bool_dec J ∪ (pr_div_eqs J) $

def j2_u26 (J: class): class = $ j2_u27 J ∪ (j2_u28 J) $

def j2_u30 (J: class): class = $ pr_mod_eqs J ∪ (pr_fix_eqs J) $

def j2_u32 (J: class): class = $ pr_bitwise_eqs J ∪ (pr_bitop_eqs J) $

def j2_u31 (J: class): class = $ pr_gcd_eqs J ∪ (j2_u32 J) $

def j2_u29 (J: class): class = $ j2_u30 J ∪ (j2_u31 J) $

def j2_u25 (J: class): class = $ j2_u26 J ∪ (j2_u29 J) $

def j2_u17 (J: class): class = $ j2_u18 J ∪ (j2_u25 J) $

def j2_u0 (J: class): class = $ j2_u1 J ∪ (j2_u17 J) $

-- The label ranges of the subtrees: from the first to the last relation.

lemma j2_f4 (G: hyps): $ G ⇒ kr_sty ⊆ kr_cwf $
----
l1: $ G ⇒ kr_sty ⊆ kr_sty $ by subset_refl
l2: $ G ⇒ kr_sty ⊆ kr_cwf $ by suc_subset
l3: $ G ⇒ kr_cwf ⊆ kr_cwf $ by subset_refl
l4: $ G ⇒ kr_sty ⊆ kr_cwf $ by subset_trans [l2, l3]

lemma j2_f5 (G: hyps): $ G ⇒ kr_ctors_wf ⊆ kr_tys_wf $
----
l1: $ G ⇒ kr_ctors_wf ⊆ kr_ctors_wf $ by subset_refl
l2: $ G ⇒ kr_ctors_wf ⊆ kr_tys_wf $ by suc_subset
l3: $ G ⇒ kr_tys_wf ⊆ kr_tys_wf $ by subset_refl
l4: $ G ⇒ kr_ctors_wf ⊆ kr_tys_wf $ by subset_trans [l2, l3]

lemma j2_f3 (G: hyps): $ G ⇒ kr_sty ⊆ kr_tys_wf $
----
l1: $ G ⇒ kr_sty ⊆ kr_cwf $ by j2_f4
l2: $ G ⇒ kr_cwf ⊆ kr_ctors_wf $ by suc_subset
l3: $ G ⇒ kr_ctors_wf ⊆ kr_tys_wf $ by j2_f5
l4: $ G ⇒ kr_sty ⊆ kr_ctors_wf $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_sty ⊆ kr_tys_wf $ by subset_trans [l4, l3]

lemma j2_f7 (G: hyps): $ G ⇒ kr_ctx_wf ⊆ kr_tys_ty $
----
l1: $ G ⇒ kr_ctx_wf ⊆ kr_ctx_wf $ by subset_refl
l2: $ G ⇒ kr_ctx_wf ⊆ kr_tys_ty $ by suc_subset
l3: $ G ⇒ kr_tys_ty ⊆ kr_tys_ty $ by subset_refl
l4: $ G ⇒ kr_ctx_wf ⊆ kr_tys_ty $ by subset_trans [l2, l3]

lemma j2_f8 (G: hyps): $ G ⇒ kr_tys_ok ⊆ kr_ind_wf $
----
l1: $ G ⇒ kr_tys_ok ⊆ kr_tys_ok $ by subset_refl
l2: $ G ⇒ kr_tys_ok ⊆ kr_ind_wf $ by suc_subset
l3: $ G ⇒ kr_ind_wf ⊆ kr_ind_wf $ by subset_refl
l4: $ G ⇒ kr_tys_ok ⊆ kr_ind_wf $ by subset_trans [l2, l3]

lemma j2_f6 (G: hyps): $ G ⇒ kr_ctx_wf ⊆ kr_ind_wf $
----
l1: $ G ⇒ kr_ctx_wf ⊆ kr_tys_ty $ by j2_f7
l2: $ G ⇒ kr_tys_ty ⊆ kr_tys_ok $ by suc_subset
l3: $ G ⇒ kr_tys_ok ⊆ kr_ind_wf $ by j2_f8
l4: $ G ⇒ kr_ctx_wf ⊆ kr_tys_ok $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_ctx_wf ⊆ kr_ind_wf $ by subset_trans [l4, l3]

lemma j2_f2 (G: hyps): $ G ⇒ kr_sty ⊆ kr_ind_wf $
----
l1: $ G ⇒ kr_sty ⊆ kr_tys_wf $ by j2_f3
l2: $ G ⇒ kr_tys_wf ⊆ kr_ctx_wf $ by suc_subset
l3: $ G ⇒ kr_ctx_wf ⊆ kr_ind_wf $ by j2_f6
l4: $ G ⇒ kr_sty ⊆ kr_ctx_wf $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_sty ⊆ kr_ind_wf $ by subset_trans [l4, l3]

lemma j2_f11 (G: hyps): $ G ⇒ kr_nst_ok ⊆ kr_large $
----
l1: $ G ⇒ kr_nst_ok ⊆ kr_nst_ok $ by subset_refl
l2: $ G ⇒ kr_nst_ok ⊆ kr_large $ by suc_subset
l3: $ G ⇒ kr_large ⊆ kr_large $ by subset_refl
l4: $ G ⇒ kr_nst_ok ⊆ kr_large $ by subset_trans [l2, l3]

lemma j2_f12 (G: hyps): $ G ⇒ kr_fir ⊆ kr_elim_ok $
----
l1: $ G ⇒ kr_fir ⊆ kr_fir $ by subset_refl
l2: $ G ⇒ kr_fir ⊆ kr_elim_ok $ by suc_subset
l3: $ G ⇒ kr_elim_ok ⊆ kr_elim_ok $ by subset_refl
l4: $ G ⇒ kr_fir ⊆ kr_elim_ok $ by subset_trans [l2, l3]

lemma j2_f10 (G: hyps): $ G ⇒ kr_nst_ok ⊆ kr_elim_ok $
----
l1: $ G ⇒ kr_nst_ok ⊆ kr_large $ by j2_f11
l2: $ G ⇒ kr_large ⊆ kr_fir $ by suc_subset
l3: $ G ⇒ kr_fir ⊆ kr_elim_ok $ by j2_f12
l4: $ G ⇒ kr_nst_ok ⊆ kr_fir $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_nst_ok ⊆ kr_elim_ok $ by subset_trans [l4, l3]

lemma j2_f14 (G: hyps): $ G ⇒ kr_fprops ⊆ kr_proj_ok $
----
l1: $ G ⇒ kr_fprops ⊆ kr_fprops $ by subset_refl
l2: $ G ⇒ kr_fprops ⊆ kr_proj_ok $ by suc_subset
l3: $ G ⇒ kr_proj_ok ⊆ kr_proj_ok $ by subset_refl
l4: $ G ⇒ kr_fprops ⊆ kr_proj_ok $ by subset_trans [l2, l3]

lemma j2_f16 (G: hyps): $ G ⇒ kr_pred_eqs ⊆ kr_sub_eqs $
----
l1: $ G ⇒ kr_pred_eqs ⊆ kr_pred_eqs $ by subset_refl
l2: $ G ⇒ kr_pred_eqs ⊆ kr_sub_eqs $ by suc_subset
l3: $ G ⇒ kr_sub_eqs ⊆ kr_sub_eqs $ by subset_refl
l4: $ G ⇒ kr_pred_eqs ⊆ kr_sub_eqs $ by subset_trans [l2, l3]

lemma j2_f15 (G: hyps): $ G ⇒ kr_add_eqs ⊆ kr_sub_eqs $
----
