l5: $ G ⇒ ⟨ scons (ra_add_eqs V1 V3) ∅ , ra_mul_eqs V1 V2 V3 ⟩ = ⟨ pp , ra_mul_eqs t1 t2 t3 ⟩ $ by eq_sym [l4]
