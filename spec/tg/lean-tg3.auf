l5: $ G , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ j2_lab kr_nst_ok (suc kr_nst_ok) $ by j2_lab_self [l3, l4]
l6: $ G , x ∊ cl_nst_ok_nil ⇒ x ∊ j2_lab kr_nst_ok (suc kr_nst_ok) $ by j2_ex3 [l2, l5]
l7: $ G ⇒ cl_nst_ok_nil ⊆ j2_lab kr_nst_ok (suc kr_nst_ok) $ by subset_intro [l6]

lemma j2_k_nst_ok_cons (G: hyps): $ G ⇒ cl_nst_ok_cons ⊆ j2_lab kr_nst_ok (suc kr_nst_ok) $
----
l1: $ G , x ∊ cl_nst_ok_cons ⇒ x ∊ cl_nst_ok_cons $ by ax
l2: $ G , x ∊ cl_nst_ok_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ kr_nst_ok ∈ ω $ by kr_nst_ok_omega
l6: $ G , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ x ∊ j2_lab kr_nst_ok (suc kr_nst_ok) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_nst_ok_cons ⇒ x ∊ j2_lab kr_nst_ok (suc kr_nst_ok) $ by j2_ex13 [l2, l6]
l8: $ G ⇒ cl_nst_ok_cons ⊆ j2_lab kr_nst_ok (suc kr_nst_ok) $ by subset_intro [l7]

lemma j2_p_nst_ok (G: hyps): $ G ⇒ pr_nst_ok ⊆ j2_lab kr_nst_ok (suc kr_nst_ok) $
----
l1: $ G ⇒ cl_nst_ok_cons ⊆ j2_lab kr_nst_ok (suc kr_nst_ok) $ by j2_k_nst_ok_cons
l2: $ G ⇒ cl_nst_ok_nil ⊆ j2_lab kr_nst_ok (suc kr_nst_ok) $ by j2_k_nst_ok_nil
l3: $ G ⇒ pr_nst_ok ⊆ j2_lab kr_nst_ok (suc kr_nst_ok) $ by cun_least [l2, l1]

lemma j2_k_large_nz (G: hyps): $ G ⇒ cl_large_nz ⊆ j2_lab kr_large (suc kr_large) $
----
l1: $ G , x ∊ cl_large_nz ⇒ x ∊ cl_large_nz $ by ax
l2: $ G , x ∊ cl_large_nz ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f ⇒ x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f $ by ax
l4: $ G , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f ⇒ x = ⟨ ∅ , ra_large y z ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f ⇒ kr_large ∈ ω $ by kr_large_omega
l6: $ G , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f ⇒ x ∊ j2_lab kr_large (suc kr_large) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_large_nz ⇒ x ∊ j2_lab kr_large (suc kr_large) $ by j2_ex9 [l2, l6]
l8: $ G ⇒ cl_large_nz ⊆ j2_lab kr_large (suc kr_large) $ by subset_intro [l7]

lemma j2_k_large_empty (G: hyps): $ G ⇒ cl_large_empty ⊆ j2_lab kr_large (suc kr_large) $
----
l1: $ G , x ∊ cl_large_empty ⇒ x ∊ cl_large_empty $ by ax
l2: $ G , x ∊ cl_large_empty ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by ax
l4: $ G , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ x = ⟨ ∅ , ra_large y z ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ kr_large ∈ ω $ by kr_large_omega
l6: $ G , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ x ∊ j2_lab kr_large (suc kr_large) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_large_empty ⇒ x ∊ j2_lab kr_large (suc kr_large) $ by j2_ex5 [l2, l6]
l8: $ G ⇒ cl_large_empty ⊆ j2_lab kr_large (suc kr_large) $ by subset_intro [l7]

lemma j2_k_large_single (G: hyps): $ G ⇒ cl_large_single ⊆ j2_lab kr_large (suc kr_large) $
----
l1: $ G , x ∊ cl_large_single ⇒ x ∊ cl_large_single $ by ax
l2: $ G , x ∊ cl_large_single ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ kr_large ∈ ω $ by kr_large_omega
l6: $ G , x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x ∊ j2_lab kr_large (suc kr_large) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_large_single ⇒ x ∊ j2_lab kr_large (suc kr_large) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ cl_large_single ⊆ j2_lab kr_large (suc kr_large) $ by subset_intro [l7]

lemma j2_p_large (G: hyps): $ G ⇒ pr_large ⊆ j2_lab kr_large (suc kr_large) $
----
l1: $ G ⇒ cl_large_single ⊆ j2_lab kr_large (suc kr_large) $ by j2_k_large_single
l2: $ G ⇒ cl_large_empty ⊆ j2_lab kr_large (suc kr_large) $ by j2_k_large_empty
l3: $ G ⇒ cl_large_empty ∪ (cl_large_single) ⊆ j2_lab kr_large (suc kr_large) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_large_nz ⊆ j2_lab kr_large (suc kr_large) $ by j2_k_large_nz
l5: $ G ⇒ pr_large ⊆ j2_lab kr_large (suc kr_large) $ by cun_least [l4, l3]

lemma j2_k_fir_res (G: hyps): $ G ⇒ cl_fir_res ⊆ j2_lab kr_fir (suc kr_fir) $
----
l1: $ G , x ∊ cl_fir_res ⇒ x ∊ cl_fir_res $ by ax
l2: $ G , x ∊ cl_fir_res ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by ax
l4: $ G , x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ x = ⟨ ∅ , ra_fir y z u v w ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ kr_fir ∈ ω $ by kr_fir_omega
l6: $ G , x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ x ∊ j2_lab kr_fir (suc kr_fir) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_fir_res ⇒ x ∊ j2_lab kr_fir (suc kr_fir) $ by j2_ex5 [l2, l6]
l8: $ G ⇒ cl_fir_res ⊆ j2_lab kr_fir (suc kr_fir) $ by subset_intro [l7]

lemma j2_k_fir_arg (G: hyps): $ G ⇒ cl_fir_arg ⊆ j2_lab kr_fir (suc kr_fir) $
----
l1: $ G , x ∊ cl_fir_arg ⇒ x ∊ cl_fir_arg $ by ax
l2: $ G , x ∊ cl_fir_arg ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ⇒ x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ⇒ x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ⇒ kr_fir ∈ ω $ by kr_fir_omega
l6: $ G , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ⇒ x ∊ j2_lab kr_fir (suc kr_fir) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_fir_arg ⇒ x ∊ j2_lab kr_fir (suc kr_fir) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ cl_fir_arg ⊆ j2_lab kr_fir (suc kr_fir) $ by subset_intro [l7]

lemma j2_k_fir_prop (G: hyps) (J: class): $ G ⇒ cl_fir_prop J ⊆ j2_lab kr_fir (suc kr_fir) $
----
l1: $ G , x ∊ cl_fir_prop J ⇒ x ∊ cl_fir_prop J $ by ax
l2: $ G , x ∊ cl_fir_prop J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by ax
l4: $ G , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ kr_fir ∈ ω $ by kr_fir_omega
l6: $ G , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x ∊ j2_lab kr_fir (suc kr_fir) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_fir_prop J ⇒ x ∊ j2_lab kr_fir (suc kr_fir) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ cl_fir_prop J ⊆ j2_lab kr_fir (suc kr_fir) $ by subset_intro [l7]

lemma j2_p_fir (G: hyps) (J: class): $ G ⇒ pr_fir J ⊆ j2_lab kr_fir (suc kr_fir) $
----
l1: $ G ⇒ cl_fir_prop J ⊆ j2_lab kr_fir (suc kr_fir) $ by j2_k_fir_prop
l2: $ G ⇒ cl_fir_arg ⊆ j2_lab kr_fir (suc kr_fir) $ by j2_k_fir_arg
l3: $ G ⇒ cl_fir_arg ∪ (cl_fir_prop J) ⊆ j2_lab kr_fir (suc kr_fir) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_fir_res ⊆ j2_lab kr_fir (suc kr_fir) $ by j2_k_fir_res
l5: $ G ⇒ pr_fir J ⊆ j2_lab kr_fir (suc kr_fir) $ by cun_least [l4, l3]

lemma j2_k_elim_prop (G: hyps): $ G ⇒ cl_elim_prop ⊆ j2_lab kr_elim_ok (suc kr_elim_ok) $
----
l1: $ G , x ∊ cl_elim_prop ⇒ x ∊ cl_elim_prop $ by ax
l2: $ G , x ∊ cl_elim_prop ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ ⇒ x = ⟨ ∅ , ra_elim_ok y z u ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ ⇒ kr_elim_ok ∈ ω $ by kr_elim_ok_omega
l6: $ G , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ ⇒ x ∊ j2_lab kr_elim_ok (suc kr_elim_ok) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_elim_prop ⇒ x ∊ j2_lab kr_elim_ok (suc kr_elim_ok) $ by j2_ex3 [l2, l6]
l8: $ G ⇒ cl_elim_prop ⊆ j2_lab kr_elim_ok (suc kr_elim_ok) $ by subset_intro [l7]

lemma j2_k_elim_large (G: hyps): $ G ⇒ cl_elim_large ⊆ j2_lab kr_elim_ok (suc kr_elim_ok) $
----
l1: $ G , x ∊ cl_elim_large ⇒ x ∊ cl_elim_large $ by ax
l2: $ G , x ∊ cl_elim_large ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ kr_elim_ok ∈ ω $ by kr_elim_ok_omega
l5: $ G , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ x ∊ j2_lab kr_elim_ok (suc kr_elim_ok) $ by j2_lab_self [l3, l4]
l6: $ G , x ∊ cl_elim_large ⇒ x ∊ j2_lab kr_elim_ok (suc kr_elim_ok) $ by j2_ex3 [l2, l5]
l7: $ G ⇒ cl_elim_large ⊆ j2_lab kr_elim_ok (suc kr_elim_ok) $ by subset_intro [l6]

lemma j2_p_elim_ok (G: hyps): $ G ⇒ pr_elim_ok ⊆ j2_lab kr_elim_ok (suc kr_elim_ok) $
----
l1: $ G ⇒ cl_elim_large ⊆ j2_lab kr_elim_ok (suc kr_elim_ok) $ by j2_k_elim_large
l2: $ G ⇒ cl_elim_prop ⊆ j2_lab kr_elim_ok (suc kr_elim_ok) $ by j2_k_elim_prop
l3: $ G ⇒ pr_elim_ok ⊆ j2_lab kr_elim_ok (suc kr_elim_ok) $ by cun_least [l2, l1]

lemma j2_k_fprops_z (G: hyps): $ G ⇒ cl_fprops_z ⊆ j2_lab kr_fprops (suc kr_fprops) $
----
l1: $ G , x ∊ cl_fprops_z ⇒ x ∊ cl_fprops_z $ by ax
l2: $ G , x ∊ cl_fprops_z ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ ⇒ x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ ⇒ kr_fprops ∈ ω $ by kr_fprops_omega
l5: $ G , x = ⟨ ∅ , ra_fprops y z u v w ⟨ kc_nz , ∅ ⟩ a ⟩ ⇒ x ∊ j2_lab kr_fprops (suc kr_fprops) $ by j2_lab_self [l3, l4]
l6: $ G , x ∊ cl_fprops_z ⇒ x ∊ j2_lab kr_fprops (suc kr_fprops) $ by j2_ex6 [l2, l5]
l7: $ G ⇒ cl_fprops_z ⊆ j2_lab kr_fprops (suc kr_fprops) $ by subset_intro [l6]

lemma j2_k_fprops_s (G: hyps) (J: class): $ G ⇒ cl_fprops_s J ⊆ j2_lab kr_fprops (suc kr_fprops) $
----
l1: $ G , x ∊ cl_fprops_s J ⇒ x ∊ cl_fprops_s J $ by ax
l2: $ G , x ∊ cl_fprops_s J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by ax
l4: $ G , x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ kr_fprops ∈ ω $ by kr_fprops_omega
l6: $ G , x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x ∊ j2_lab kr_fprops (suc kr_fprops) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_fprops_s J ⇒ x ∊ j2_lab kr_fprops (suc kr_fprops) $ by j2_ex10 [l2, l6]
l8: $ G ⇒ cl_fprops_s J ⊆ j2_lab kr_fprops (suc kr_fprops) $ by subset_intro [l7]

lemma j2_p_fprops (G: hyps) (J: class): $ G ⇒ pr_fprops J ⊆ j2_lab kr_fprops (suc kr_fprops) $
----
l1: $ G ⇒ cl_fprops_s J ⊆ j2_lab kr_fprops (suc kr_fprops) $ by j2_k_fprops_s
l2: $ G ⇒ cl_fprops_z ⊆ j2_lab kr_fprops (suc kr_fprops) $ by j2_k_fprops_z
l3: $ G ⇒ pr_fprops J ⊆ j2_lab kr_fprops (suc kr_fprops) $ by cun_least [l2, l1]

lemma j2_k_proj_ok_sort (G: hyps): $ G ⇒ cl_proj_ok_sort ⊆ j2_lab kr_proj_ok (suc kr_proj_ok) $
----
l1: $ G , x ∊ cl_proj_ok_sort ⇒ x ∊ cl_proj_ok_sort $ by ax
l2: $ G , x ∊ cl_proj_ok_sort ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g ⇒ x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g $ by ax
l4: $ G , x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g ⇒ x = ⟨ ∅ , ra_proj_ok y z a b ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g ⇒ kr_proj_ok ∈ ω $ by kr_proj_ok_omega
l6: $ G , x = ⟨ ∅ , ra_proj_ok y z a b ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w a c f ∈ lrel ∧ ra_isort c ⟨ kc_nz , ∅ ⟩ g ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons g ∅) ⟩ g ⇒ x ∊ j2_lab kr_proj_ok (suc kr_proj_ok) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_proj_ok_sort ⇒ x ∊ j2_lab kr_proj_ok (suc kr_proj_ok) $ by j2_ex10 [l2, l6]
l8: $ G ⇒ cl_proj_ok_sort ⊆ j2_lab kr_proj_ok (suc kr_proj_ok) $ by subset_intro [l7]

lemma j2_k_proj_ok_prop (G: hyps): $ G ⇒ cl_proj_ok_prop ⊆ j2_lab kr_proj_ok (suc kr_proj_ok) $
----
l1: $ G , x ∊ cl_proj_ok_prop ⇒ x ∊ cl_proj_ok_prop $ by ax
l2: $ G , x ∊ cl_proj_ok_prop ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ kr_proj_ok ∈ ω $ by kr_proj_ok_omega
l6: $ G , x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ x ∊ j2_lab kr_proj_ok (suc kr_proj_ok) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_proj_ok_prop ⇒ x ∊ j2_lab kr_proj_ok (suc kr_proj_ok) $ by j2_ex14 [l2, l6]
l8: $ G ⇒ cl_proj_ok_prop ⊆ j2_lab kr_proj_ok (suc kr_proj_ok) $ by subset_intro [l7]

lemma j2_p_proj_ok (G: hyps): $ G ⇒ pr_proj_ok ⊆ j2_lab kr_proj_ok (suc kr_proj_ok) $
----
l1: $ G ⇒ cl_proj_ok_prop ⊆ j2_lab kr_proj_ok (suc kr_proj_ok) $ by j2_k_proj_ok_prop
l2: $ G ⇒ cl_proj_ok_sort ⊆ j2_lab kr_proj_ok (suc kr_proj_ok) $ by j2_k_proj_ok_sort
