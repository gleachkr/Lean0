l15: $ G , c = ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ pr_ctors_wf $ by lprog3_ctors_wf_pr [l15]
l17: $ G , c = ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C ∃ b_v ∃ P ∃ T ∃ R (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n_v R ∈ lrel ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by j2_o_ctors_wf [l16, l11]
l18: $ G , c = ra_ctors_wf t1 t2 t3 t4 t5 t6 t7 ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C ∃ b_v ∃ P ∃ T ∃ R (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n_v R ∈ lrel ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ K ∃ C ∃ b_v ∃ P ∃ T ∃ R (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_pis P K R ∈ lrel ∧ ra_closed n_v R ∈ lrel ∧ ra_cwf D n_v np l_v i_v Ctx ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_tys_wf_nil (G: hyps) (J: class) {D n_v np l_v i_v Ctx: set} (pp t1 t2 t3 t4 t5 t6 t7 x V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_tys_wf V1 V2 V3 V4 V5 V6 ⟨ kc_tnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ ∅ , ra_tys_wf V1 V2 V3 V4 V5 V6 ⟨ kc_tnil , ∅ ⟩ ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_tys_wf V1 V2 V3 V4 V5 V6 ⟨ kc_tnil , ∅ ⟩ ⟩ = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_tys_wf t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l7: $ G ⇒ isset (ra_tys_wf V1 V2 V3 V4 V5 V6 ⟨ kc_tnil , ∅ ⟩) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_tys_wf t1 t2 t3 t4 t5 t6 t7 = ra_tys_wf V1 V2 V3 V4 V5 V6 ⟨ kc_tnil , ∅ ⟩ $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_tys_wf t1 t2 t3 t4 t5 t6 t7 = ra_tys_wf V1 V2 V3 V4 V5 V6 ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [l8]
l11: $ G ⇒ isset ⟨ kc_tnil , ∅ ⟩ $ by opair_isset
l12: $ G ⇒ isset V6 $ by isset_var
l13: $ G ⇒ isset V5 $ by isset_var
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ isset V3 $ by isset_var
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ isset V1 $ by isset_var
l18: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l19: $ G ⇒ isset t7 $ by isset_var
l20: $ G ⇒ scons t7 ∅ ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t6 $ by isset_var
l22: $ G ⇒ scons t6 (scons t7 ∅) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ isset t5 $ by isset_var
l24: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) ∈ fseq j2_vv $ by j2_fs [l23, l22]
l25: $ G ⇒ isset t4 $ by isset_var
l26: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) ∈ fseq j2_vv $ by j2_fs [l25, l24]
l27: $ G ⇒ isset t3 $ by isset_var
l28: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) ∈ fseq j2_vv $ by j2_fs [l27, l26]
l29: $ G ⇒ isset t2 $ by isset_var
l30: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) ∈ fseq j2_vv $ by j2_fs [l29, l28]
l31: $ G ⇒ isset t1 $ by isset_var
l32: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq j2_vv $ by j2_fs [l31, l30]
l33: $ G ⇒ scons ⟨ kc_tnil , ∅ ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l11, l18]
l34: $ G ⇒ scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l12, l33]
l35: $ G ⇒ scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l13, l34]
l36: $ G ⇒ scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l14, l35]
l37: $ G ⇒ scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l15, l36]
l38: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅))))) ∈ fseq j2_vv $ by j2_fs [l16, l37]
l39: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)))))) ∈ fseq j2_vv $ by j2_fs [l17, l38]
l40: $ G ⇒ kr_tys_wf ∈ ω $ by kr_tys_wf_omega
l41: $ G ⇒ isset kr_tys_wf $ by wcel_isset [l40]
l42: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l32]
l43: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅))))))) $ by wcel_isset [l39]
l44: $ G ⇒ kr_tys_wf = kr_tys_wf ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)))))) $ by opair_inj_c [l10, l41, l42, l41, l43]
l45: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)))))) $ by and_elim_r [l44]
l46: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅))))) $ by j2_scons_inj [l45, l31, l17, l30, l38]
l47: $ G ⇒ t1 = V1 $ by and_elim_l [l46]
l48: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅))))) $ by and_elim_r [l46]
l49: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)))) $ by j2_scons_inj [l48, l29, l16, l28, l37]
l50: $ G ⇒ t2 = V2 $ by and_elim_l [l49]
l51: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)))) $ by and_elim_r [l49]
l52: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅))) $ by j2_scons_inj [l51, l27, l15, l26, l36]
l53: $ G ⇒ t3 = V3 $ by and_elim_l [l52]
l54: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅))) $ by and_elim_r [l52]
l55: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)) $ by j2_scons_inj [l54, l25, l14, l24, l35]
l56: $ G ⇒ t4 = V4 $ by and_elim_l [l55]
l57: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅)) $ by and_elim_r [l55]
l58: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅) $ by j2_scons_inj [l57, l23, l13, l22, l34]
l59: $ G ⇒ t5 = V5 $ by and_elim_l [l58]
l60: $ G ⇒ scons t6 (scons t7 ∅) = scons V6 (scons ⟨ kc_tnil , ∅ ⟩ ∅) $ by and_elim_r [l58]
l61: $ G ⇒ t6 = V6 ∧ scons t7 ∅ = scons ⟨ kc_tnil , ∅ ⟩ ∅ $ by j2_scons_inj [l60, l21, l12, l20, l33]
l62: $ G ⇒ t6 = V6 $ by and_elim_l [l61]
l63: $ G ⇒ scons t7 ∅ = scons ⟨ kc_tnil , ∅ ⟩ ∅ $ by and_elim_r [l61]
l64: $ G ⇒ t7 = ⟨ kc_tnil , ∅ ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l63, l19, l11, l18, l18]
l65: $ G ⇒ t7 = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l64]
l66: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V6 ∧ t7 = ⟨ kc_tnil , ∅ ⟩ $ by j2_and6 [l47, l50, l53, l56, l59, l62, l65]
l67: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $ by j2_exi6 [l66]

lemma j2_d_tys_wf_nil (G: hyps) (J: class) {D n_v np l_v i_v Ctx: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_tys_wf_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_tys_wf_nil ⇒ x ∊ cl_tys_wf_nil $ by ax
l2: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_tys_wf_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_tys_wf y z u v w a ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $ by j2_e_tys_wf_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_tys_wf_nil ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $ by j2_ex6 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma j2_e_tys_wf_cons (G: hyps) (J: class) {D n_v np l_v l2 i_v k_v Ctx F C T: set} (pp t1 t2 t3 t4 t5 t6 t7 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11: set):
  $ G ⇒ x = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_ctors_wf V1 V2 V3 V4 V6 V8 V10) (scons (ra_tys_wf V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ V8 V11) ∅) , ra_tys_wf V1 V2 V3 V4 V6 V8 ⟨ kc_tcons , scons V9 (scons V10 (scons V11 ∅)) ⟩ ⟩ ∧ ra_isort V9 V7 V5 ∈ lrel ∧ lveq V5 V4 $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ l2 ∃ i_v ∃ k_v ∃ Ctx ∃ F ∃ C ∃ T (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_isort F k_v l2 ∈ lrel ∧ lveq l2 l_v ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J ∧ ra_tys_wf D n_v np l_v ⟨ kc_s , scons i_v ∅ ⟩ Ctx T ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_ctors_wf V1 V2 V3 V4 V6 V8 V10) (scons (ra_tys_wf V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ V8 V11) ∅) , ra_tys_wf V1 V2 V3 V4 V6 V8 ⟨ kc_tcons , scons V9 (scons V10 (scons V11 ∅)) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_isort V9 V7 V5 ∈ lrel ∧ lveq V5 V4 $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_ctors_wf V1 V2 V3 V4 V6 V8 V10) (scons (ra_tys_wf V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ V8 V11) ∅) , ra_tys_wf V1 V2 V3 V4 V6 V8 ⟨ kc_tcons , scons V9 (scons V10 (scons V11 ∅)) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_ctors_wf V1 V2 V3 V4 V6 V8 V10) (scons (ra_tys_wf V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ V8 V11) ∅) , ra_tys_wf V1 V2 V3 V4 V6 V8 ⟨ kc_tcons , scons V9 (scons V10 (scons V11 ∅)) ⟩ ⟩ = ⟨ pp , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_ctors_wf V1 V2 V3 V4 V6 V8 V10) (scons (ra_tys_wf V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ V8 V11) ∅)) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_tys_wf t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l9: $ G ⇒ isset (ra_tys_wf V1 V2 V3 V4 V6 V8 ⟨ kc_tcons , scons V9 (scons V10 (scons V11 ∅)) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_ctors_wf V1 V2 V3 V4 V6 V8 V10) (scons (ra_tys_wf V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ V8 V11) ∅) ∧ ra_tys_wf t1 t2 t3 t4 t5 t6 t7 = ra_tys_wf V1 V2 V3 V4 V6 V8 ⟨ kc_tcons , scons V9 (scons V10 (scons V11 ∅)) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_ctors_wf V1 V2 V3 V4 V6 V8 V10) (scons (ra_tys_wf V1 V2 V3 V4 ⟨ kc_s , scons V6 ∅ ⟩ V8 V11) ∅) $ by and_elim_l [l10]
l12: $ G ⇒ ra_tys_wf t1 t2 t3 t4 t5 t6 t7 = ra_tys_wf V1 V2 V3 V4 V6 V8 ⟨ kc_tcons , scons V9 (scons V10 (scons V11 ∅)) ⟩ $ by and_elim_r [l10]
l13: $ G ⇒ isset ⟨ kc_tcons , scons V9 (scons V10 (scons V11 ∅)) ⟩ $ by opair_isset
l14: $ G ⇒ isset V8 $ by isset_var
l15: $ G ⇒ isset V6 $ by isset_var
l16: $ G ⇒ isset V4 $ by isset_var
l17: $ G ⇒ isset V3 $ by isset_var
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ isset V1 $ by isset_var
