l4: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_sty a ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ l g m) ∅ , ra_cwf y z u v w a b f ⟩ ∧ ra_indapp y z u b f w ∈ lrel ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f g ∈ lrel ∧ ra_ind_data y i j k ∈ lrel ∧ ra_nth_ty k w d e ∈ lrel ∧ ra_pis j d h ∈ lrel ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ h l ∈ lrel ⇒ x = ⟨ scons (ra_sty a ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ l g m) ∅ , ra_cwf y z u v w a b f ⟩ ∧ ra_indapp y z u b f w ∈ lrel ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f g ∈ lrel ∧ ra_ind_data y i j k ∈ lrel ∧ ra_nth_ty k w d e ∈ lrel ∧ ra_pis j d h ∈ lrel ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ h l ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_sty a ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ l g m) ∅ , ra_cwf y z u v w a b f ⟩ ∧ ra_indapp y z u b f w ∈ lrel ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f g ∈ lrel ∧ ra_ind_data y i j k ∈ lrel ∧ ra_nth_ty k w d e ∈ lrel ∧ ra_pis j d h ∈ lrel ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ h l ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_sty a ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ l g m) ∅ , ra_cwf y z u v w a b f ⟩ ∧ ra_indapp y z u b f w ∈ lrel ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f g ∈ lrel ∧ ra_ind_data y i j k ∈ lrel ∧ ra_nth_ty k w d e ∈ lrel ∧ ra_pis j d h ∈ lrel ∧ ra_lift c ⟨ kc_nz , ∅ ⟩ h l ∈ lrel ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $ by j2_e_cwf_res [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_res ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $ by j2_ex18 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_cwf (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v A B A2 u_v B2 K K2 b_v P T F C R R2 S: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ pr_cwf J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res $ by ax
l2: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $ by j2_d_cwf_res [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res → ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi_rec J ∪ (cl_cwf_res) ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi_rec J ∪ (cl_cwf_res) $ by ax
l6: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi_rec J ∪ (cl_cwf_res) ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi_rec J ∨ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_res $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi_rec J ∪ (cl_cwf_res) , ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi_rec J ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi_rec J $ by ax
