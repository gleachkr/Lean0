lemma j2_o_shr_eqs (G: hyps) (J: class) {G_v f_v fd: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_shr_eqs t1 t2 t3 ⟩ ∈ pr_shr_eqs J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ fd (t1 = G_v ∧ t2 = f_v ∧ t3 = fd ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ fd ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $
----
l1: $ G ⇒ ∃ G_v ∃ f_v ∃ fd (t1 = G_v ∧ t2 = f_v ∧ t3 = fd ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ fd ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $ by j2_d_shr_eqs_i [#1, #2]

lrel3_shr_eqs_cases
-------------------
l1: $ G ⇒ isset (ra_shr_eqs t1 t2 t3) $ by opair_isset
l2: $ G , c = ra_shr_eqs t1 t2 t3 ⇒ c = ra_shr_eqs t1 t2 t3 $ by ax
l3: $ G , c = ra_shr_eqs t1 t2 t3 ⇒ ra_shr_eqs t1 t2 t3 = c $ by eq_sym [l2]
l4: $ G , c = ra_shr_eqs t1 t2 t3 ⇒ ra_shr_eqs t1 t2 t3 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_shr_eqs t1 t2 t3 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_shr_eqs t1 t2 t3 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_shr_eqs t1 t2 t3 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_shr_eqs t1 t2 t3 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_shr_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_shr_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_shr_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_shr_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_shr_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_shr_eqs t1 t2 t3 $ by ax
l14: $ G , c = ra_shr_eqs t1 t2 t3 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_shr_eqs t1 t2 t3 ⟩ $ by opair_eq [l12, l13]
