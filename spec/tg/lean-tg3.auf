l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ a = A6 $ by ax
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ b = A7 $ by ax
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ c = A8 $ by ax
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_add A4 A2 A5 ∈ lrel $ by weaken [#11]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_add v z w = ra_add A4 A2 A5 $ by ra_add_eq [l4, l2, l5]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_add A4 A2 A5 = ra_add v z w $ by eq_sym [l10]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_add v z w ∈ lrel $ by wcel_eq_l [l11, l9]
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_sinst A1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ A5 A6 A7 ∈ lrel $ by weaken [#12]
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ = ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ by eq_refl
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b = ra_sinst A1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ A5 A6 A7 $ by ra_sinst_eq [l1, l14, l15, l5, l6, l7]
l17: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_sinst A1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ A5 A6 A7 = ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b $ by eq_sym [l16]
