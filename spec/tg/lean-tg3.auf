l105: $ G ⇒ ⟨ scons (ra_cwf A1 A2 A3 A4 A5 ⟨ kc_cons , scons A11 (scons A6 ∅) ⟩ ⟨ kc_s , scons A7 ∅ ⟩ A10) ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 ⟨ kc_pi , scons A9 (scons A10 ∅) ⟩ ⟩ ∈ (cl_cwf_pi J) ∪ cl_cwf_res $ by j1_in_l [l104]
l106: $ G ⇒ ⟨ scons (ra_cwf A1 A2 A3 A4 A5 ⟨ kc_cons , scons A11 (scons A6 ∅) ⟩ ⟨ kc_s , scons A7 ∅ ⟩ A10) ∅ , ra_cwf A1 A2 A3 A4 A5 A6 A7 ⟨ kc_pi , scons A9 (scons A10 ∅) ⟩ ⟩ ∈ j1_top J $ by j1_pr_cwf [l105]
l107: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l108: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l109: $ G ⇒ (ra_cwf A1 A2 A3 A4 A5 ⟨ kc_cons , scons A11 (scons A6 ∅) ⟩ ⟨ kc_s , scons A7 ∅ ⟩ A10) ∈ latoms $ by j1_lrel3_lat [#14]
l110: $ G ⇒ scons (ra_cwf A1 A2 A3 A4 A5 ⟨ kc_cons , scons A11 (scons A6 ∅) ⟩ ⟨ kc_s , scons A7 ∅ ⟩ A10) ∅ ∈ fseq latoms $ by scons_fseq_c [l109, l107]
l111: $ G ⇒ crn (scons (ra_cwf A1 A2 A3 A4 A5 ⟨ kc_cons , scons A11 (scons A6 ∅) ⟩ ⟨ kc_s , scons A7 ∅ ⟩ A10) ∅) ⊆ lrel3 J $ by crn_scons_sub [#14, l108]
l112: $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 ⟨ kc_pi , scons A9 (scons A10 ∅) ⟩ ∈ latoms $ by j1_ra_cwf [#1, #2, #3, #4, #5, #6, #7, #13]
l113: $ G ⇒ ra_cwf A1 A2 A3 A4 A5 A6 A7 ⟨ kc_pi , scons A9 (scons A10 ∅) ⟩ ∈ lrel3 J $ by j1_horn [l106, l110, l112, l111]

cwf_pi_j
--------
l1: $ _ ⇒ enc_ind D ∈ trees ω $ by enc_ind_trees
