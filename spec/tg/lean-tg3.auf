l76: $ G ⇒ ra_add_eqs A1 A2 ∈ lrel3 J $ by j1_horn [l72, l73, l75, l74]

lemma j1_pr_pred_eqs (G: hyps) (J X: class): $ G ⇒ X ∈ pr_pred_eqs J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_add_eqs J) ∪ (pr_pred_eqs J) $ by j1_in_r [#1]
l2: $ G ⇒ X ∈ pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J)) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J))) $ by j1_in_l [l2]
l4: $ G ⇒ X ∈ ((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J)))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_r [l4]

lemma j1_ra_pred_eqs (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_pred_eqs A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_pred_eqs ∈ ω $ by kr_pred_eqs_omega
l5: $ G ⇒ ra_pred_eqs A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lrel3_pred_eqs_i
----------------
l1: $ G , y = A1 , z = A2 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A2 ∈ lrel $ by weaken [#3]
l4: $ G , y = A1 , z = A2 ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l5: $ G , y = A1 , z = A2 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ z = ra_closed ⟨ kc_nz , ∅ ⟩ A2 $ by ra_closed_eq [l4, l2]
l6: $ G , y = A1 , z = A2 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A2 = ra_closed ⟨ kc_nz , ∅ ⟩ z $ by eq_sym [l5]
l7: $ G , y = A1 , z = A2 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel $ by wcel_eq_l [l6, l3]
l8: $ G , y = A1 , z = A2 ⇒ ra_deq A1 A2 A2 ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J $ by weaken [#4]
l9: $ G , y = A1 , z = A2 ⇒ ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ = ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ $ by eq_refl
l10: $ G , y = A1 , z = A2 ⇒ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ = ra_deq A1 A2 A2 ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ $ by ra_deq_eq [l1, l2, l2, l9]
l11: $ G , y = A1 , z = A2 ⇒ ra_deq A1 A2 A2 ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ = ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ $ by eq_sym [l10]
l12: $ G , y = A1 , z = A2 ⇒ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∈ J $ by wcel_eq_l [l11, l8]
l13: $ G , y = A1 , z = A2 ⇒ ra_deq A1 ⟨ kc_app , scons A2 (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J $ by weaken [#5]
l14: $ G , y = A1 , z = A2 ⇒ kc_app = kc_app $ by eq_refl
l15: $ G , y = A1 , z = A2 ⇒ scons tr_nat_zero ∅ = scons tr_nat_zero ∅ $ by eq_refl
l16: $ G , y = A1 , z = A2 ⇒ scons z (scons tr_nat_zero ∅) = scons A2 (scons tr_nat_zero ∅) $ by scons_eq [l2, l15]
l17: $ G , y = A1 , z = A2 ⇒ ⟨ kc_app , scons z (scons tr_nat_zero ∅) ⟩ = ⟨ kc_app , scons A2 (scons tr_nat_zero ∅) ⟩ $ by opair_eq [l14, l16]
l18: $ G , y = A1 , z = A2 ⇒ tr_nat_zero = tr_nat_zero $ by eq_refl
l19: $ G , y = A1 , z = A2 ⇒ tr_nat_ty = tr_nat_ty $ by eq_refl
l20: $ G , y = A1 , z = A2 ⇒ ra_deq y ⟨ kc_app , scons z (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty = ra_deq A1 ⟨ kc_app , scons A2 (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty $ by ra_deq_eq [l1, l17, l18, l19]
l21: $ G , y = A1 , z = A2 ⇒ ra_deq A1 ⟨ kc_app , scons A2 (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty = ra_deq y ⟨ kc_app , scons z (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty $ by eq_sym [l20]
l22: $ G , y = A1 , z = A2 ⇒ ra_deq y ⟨ kc_app , scons z (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J $ by wcel_eq_l [l21, l13]
l23: $ G , y = A1 , z = A2 ⇒ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons A1 ∅) ⟩ ⟨ kc_app , scons A2 (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J $ by weaken [#6]
l24: $ G , y = A1 , z = A2 ⇒ kc_cons = kc_cons $ by eq_refl
l25: $ G , y = A1 , z = A2 ⇒ ∅ = ∅ $ by eq_refl
l26: $ G , y = A1 , z = A2 ⇒ scons y ∅ = scons A1 ∅ $ by scons_eq [l1, l25]
l27: $ G , y = A1 , z = A2 ⇒ scons tr_nat_ty (scons y ∅) = scons tr_nat_ty (scons A1 ∅) $ by scons_eq [l19, l26]
l28: $ G , y = A1 , z = A2 ⇒ ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ = ⟨ kc_cons , scons tr_nat_ty (scons A1 ∅) ⟩ $ by opair_eq [l24, l27]
l29: $ G , y = A1 , z = A2 ⇒ scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅ = scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅ $ by eq_refl
l30: $ G , y = A1 , z = A2 ⇒ scons z (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) = scons A2 (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) $ by scons_eq [l2, l29]
l31: $ G , y = A1 , z = A2 ⇒ ⟨ kc_app , scons z (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ = ⟨ kc_app , scons A2 (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ $ by opair_eq [l14, l30]
l32: $ G , y = A1 , z = A2 ⇒ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ = ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ by eq_refl
