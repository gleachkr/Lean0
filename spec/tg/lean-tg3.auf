lemma j2_d_proj_ok_prop (G: hyps) (J: class) {G_v G2 D b_v P T j_v i_v np n_v m_v F K C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_prop $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ C (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_fprops D n_v np G2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ K ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x ∊ cl_proj_ok_prop ⇒ x ∊ cl_proj_ok_prop $ by ax
l2: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x ∊ cl_proj_ok_prop ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_fprops u g f z ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons c ∅ ⟩ k) ∅ , ra_proj_ok y u b c ⟩ ∧ ra_ind_data u v w a ∈ lrel ∧ ra_clen w f ∈ lrel ∧ ra_ntys a g i ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty a b j d ∈ lrel ∧ ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ k ∈ lrel ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ C (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_fprops D n_v np G2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ K ∈ lrel3 J) $ by j2_e_proj_ok_prop [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ , x ∊ cl_proj_ok_prop ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ C (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_fprops D n_v np G2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ K ∈ lrel3 J) $ by j2_ex14 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ C (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_fprops D n_v np G2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ K ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_proj_ok (G: hyps) (J: class) {G_v D b_v P T j_v i_v F C l_v G2 np n_v m_v K: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ pr_proj_ok $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ F ∃ C ∃ l_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) ∨ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ C (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_fprops D n_v np G2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ K ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_prop ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_prop $ by ax
l2: $ G , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_prop ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_prop ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ C (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_fprops D n_v np G2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ K ∈ lrel3 J) $ by j2_d_proj_ok_prop [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_prop → ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ C (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_fprops D n_v np G2 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons i_v ∅ ⟩ K ∈ lrel3 J) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort ∪ (cl_proj_ok_prop) ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort ∪ (cl_proj_ok_prop) $ by ax
l6: $ G , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort ∪ (cl_proj_ok_prop) ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort ∨ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_prop $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort ∪ (cl_proj_ok_prop) , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort ⇒ ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort $ by ax
l8: $ G , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort ∪ (cl_proj_ok_prop) , ⟨ pp , ra_proj_ok t1 t2 t3 t4 ⟩ ∈ cl_proj_ok_sort ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
