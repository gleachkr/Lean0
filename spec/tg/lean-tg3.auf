l1: $ (⟦ x / t ⟧ ⟨ kr_mul_eqs , scons A1 (scons A2 (scons A3 ∅)) ⟩) ≐ ⟨ kr_mul_eqs , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) ∅)) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_dec_eqs {x: set} (t: set x) (A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11: class x):
  $ (⟦ x / t ⟧ (ra_dec_eqs A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11)) ≐ ra_dec_eqs (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) (⟦ x / t ⟧ A6) (⟦ x / t ⟧ A7) (⟦ x / t ⟧ A8) (⟦ x / t ⟧ A9) (⟦ x / t ⟧ A10) (⟦ x / t ⟧ A11) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_dec_eqs , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 ∅)))))))))) ⟩) ≐ ⟨ kr_dec_eqs , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) (scons (⟦ x / t ⟧ A6) (scons (⟦ x / t ⟧ A7) (scons (⟦ x / t ⟧ A8) (scons (⟦ x / t ⟧ A9) (scons (⟦ x / t ⟧ A10) (scons (⟦ x / t ⟧ A11) ∅)))))))))) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_ble_eqs {x: set} (t: set x) (A1 A2 A3 A4 A5: class x):
  $ (⟦ x / t ⟧ (ra_ble_eqs A1 A2 A3 A4 A5)) ≐ ra_ble_eqs (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_ble_eqs , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) ⟩) ≐ ⟨ kr_ble_eqs , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) ∅)))) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_beq_eqs {x: set} (t: set x) (A1 A2 A3 A4 A5: class x):
  $ (⟦ x / t ⟧ (ra_beq_eqs A1 A2 A3 A4 A5)) ≐ ra_beq_eqs (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_beq_eqs , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) ⟩) ≐ ⟨ kr_beq_eqs , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) ∅)))) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_natle_dec {x: set} (t: set x) (A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15: class x):
  $ (⟦ x / t ⟧ (ra_natle_dec A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15)) ≐ ra_natle_dec (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) (⟦ x / t ⟧ A6) (⟦ x / t ⟧ A7) (⟦ x / t ⟧ A8) (⟦ x / t ⟧ A9) (⟦ x / t ⟧ A10) (⟦ x / t ⟧ A11) (⟦ x / t ⟧ A12) (⟦ x / t ⟧ A13) (⟦ x / t ⟧ A14) (⟦ x / t ⟧ A15) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_natle_dec , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 (scons A12 (scons A13 (scons A14 (scons A15 ∅)))))))))))))) ⟩) ≐ ⟨ kr_natle_dec , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) (scons (⟦ x / t ⟧ A6) (scons (⟦ x / t ⟧ A7) (scons (⟦ x / t ⟧ A8) (scons (⟦ x / t ⟧ A9) (scons (⟦ x / t ⟧ A10) (scons (⟦ x / t ⟧ A11) (scons (⟦ x / t ⟧ A12) (scons (⟦ x / t ⟧ A13) (scons (⟦ x / t ⟧ A14) (scons (⟦ x / t ⟧ A15) ∅)))))))))))))) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_sub_eqs {x: set} (t: set x) (A1 A2 A3: class x):
  $ (⟦ x / t ⟧ (ra_sub_eqs A1 A2 A3)) ≐ ra_sub_eqs (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_sub_eqs , scons A1 (scons A2 (scons A3 ∅)) ⟩) ≐ ⟨ kr_sub_eqs , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) ∅)) ⟩ $ by ceqt_refl

--| @rewrite
lemma j2_sb_ite_eqs {x: set} (t: set x) (A1 A2 A3 A4 A5 A6 A7: class x):
  $ (⟦ x / t ⟧ (ra_ite_eqs A1 A2 A3 A4 A5 A6 A7)) ≐ ra_ite_eqs (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) (⟦ x / t ⟧ A6) (⟦ x / t ⟧ A7) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_ite_eqs , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 ∅)))))) ⟩) ≐ ⟨ kr_ite_eqs , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) (scons (⟦ x / t ⟧ A6) (scons (⟦ x / t ⟧ A7) ∅)))))) ⟩ $ by ceqt_refl

--| @congr
lemma j2_cg_lveq (A C B D: class): $ A ≐ C $ > $ B ≐ D $ > $ lveq A B ⟺ lveq C D $
----
l1: $ (y ∊ lvals) ⟺ (y ∊ lvals) $ by iff_refl
l2: $ y ≐ y $ by ceqt_refl
l3: $ lv A y ≐ lv C y $ by lv_congr [#1, l2]
l4: $ lv B y ≐ lv D y $ by lv_congr [#2, l2]
l5: $ (lv A y = lv B y) ⟺ (lv C y = lv D y) $ by ceq_congr [l3, l4]
l6: $ (y ∊ lvals → lv A y = lv B y) ⟺ (y ∊ lvals → lv C y = lv D y) $ by im_congr [l1, l5]
l7: $ ∀ y (y ∊ lvals → lv A y = lv B y) ⟺ ∀ y (y ∊ lvals → lv C y = lv D y) $ by all_congr [l6]

--| @rewrite
lemma j2_sb_lveq {x: set} (t: set x) (A B: class x):
  $ [x/t] (lveq A B) ⟺ lveq (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) $
----
l1: $ [x/t] (∀ y (y ∊ lvals → lv A y = lv B y)) ⟺ ∀ y (y ∊ lvals → lv (⟦ x / t ⟧ A) y = lv (⟦ x / t ⟧ B) y) $ by iff_refl

lemma j2_e_sty_nil (G: hyps) (J: class) {G_v h_v A: set} (pp t1 t2 t3 t4 t5 x V1 V2 V3: set):
  $ G ⇒ x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_sty V1 V2 V3 V2 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) $
----
l1: $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_sty V1 V2 V3 V2 V3 ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_sty V1 V2 V3 V2 V3 ⟩ = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_sty t1 t2 t3 t4 t5) $ by opair_isset
l7: $ G ⇒ isset (ra_sty V1 V2 V3 V2 V3) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_sty t1 t2 t3 t4 t5 = ra_sty V1 V2 V3 V2 V3 $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_sty t1 t2 t3 t4 t5 = ra_sty V1 V2 V3 V2 V3 $ by and_elim_r [l8]
l11: $ G ⇒ isset V3 $ by isset_var
l12: $ G ⇒ isset V2 $ by isset_var
l13: $ G ⇒ isset V1 $ by isset_var
l14: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l15: $ G ⇒ isset t5 $ by isset_var
l16: $ G ⇒ scons t5 ∅ ∈ fseq j2_vv $ by j2_fs [l15, l14]
l17: $ G ⇒ isset t4 $ by isset_var
l18: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq j2_vv $ by j2_fs [l17, l16]
l19: $ G ⇒ isset t3 $ by isset_var
l20: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t2 $ by isset_var
l22: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ isset t1 $ by isset_var
l24: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq j2_vv $ by j2_fs [l23, l22]
l25: $ G ⇒ scons V3 ∅ ∈ fseq j2_vv $ by j2_fs [l11, l14]
l26: $ G ⇒ scons V2 (scons V3 ∅) ∈ fseq j2_vv $ by j2_fs [l12, l25]
l27: $ G ⇒ scons V3 (scons V2 (scons V3 ∅)) ∈ fseq j2_vv $ by j2_fs [l11, l26]
l28: $ G ⇒ scons V2 (scons V3 (scons V2 (scons V3 ∅))) ∈ fseq j2_vv $ by j2_fs [l12, l27]
l29: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V2 (scons V3 ∅)))) ∈ fseq j2_vv $ by j2_fs [l13, l28]
l30: $ G ⇒ kr_sty ∈ ω $ by kr_sty_omega
l31: $ G ⇒ isset kr_sty $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l24]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V2 (scons V3 ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_sty = kr_sty ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V2 (scons V3 ∅)))) $ by opair_inj_c [l10, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V2 (scons V3 ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V2 (scons V3 ∅))) $ by j2_scons_inj [l35, l23, l13, l22, l28]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V2 (scons V3 ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V2 (scons V3 ∅)) $ by j2_scons_inj [l38, l21, l12, l20, l27]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V2 (scons V3 ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons V2 (scons V3 ∅) $ by j2_scons_inj [l41, l19, l11, l18, l26]
l43: $ G ⇒ t3 = V3 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons V2 (scons V3 ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = V2 ∧ scons t5 ∅ = scons V3 ∅ $ by j2_scons_inj [l44, l17, l12, l16, l25]
l46: $ G ⇒ t4 = V2 $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons V3 ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = V3 ∧ ∅ = ∅ $ by j2_scons_inj [l47, l15, l11, l14, l14]
l49: $ G ⇒ t5 = V3 $ by and_elim_l [l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V2 ∧ t5 = V3 $ by j2_and4 [l37, l40, l43, l46, l49]
l51: $ G ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) $ by j2_exi3 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, p := $ t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A $) [l50]

lemma j2_d_sty_nil (G: hyps) (J: class) {G_v h_v A: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ ∈ cl_sty_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) $
----
l1: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x ∊ cl_sty_nil ⇒ x ∊ cl_sty_nil $ by ax
l2: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x ∊ cl_sty_nil ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_sty y z u z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ x = ⟨ ∅ , ra_sty y z u z u ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) $ by j2_e_sty_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ , x ∊ cl_sty_nil ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) $ by j2_ex3 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ h_v ∃ A (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = h_v ∧ t5 = A) $ by wcel_elim [#1, l7]

lemma j2_e_sty_app (G: hyps) (J: class) {G_v h_v A f_v a_v B C C2: set} (pp t1 t2 t3 t4 t5 x V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ x = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_sty V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩) ∅ , ra_sty V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ V8 ⟩ ∧ ra_deq V1 V5 V5 V6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ V7 V5 V8 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ h_v ∃ A ∃ f_v ∃ a_v ∃ B ∃ C ∃ C2 (t1 = G_v ∧ t2 = h_v ∧ t3 = A ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = C2 ∧ ra_sty G_v h_v A f_v ⟨ kc_pi , scons B (scons C ∅) ⟩ ∈ lrel3 J ∧ ra_deq G_v a_v a_v B ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ C a_v C2 ∈ lrel) $
----
l1: $ G ⇒ x = ⟨ scons (ra_sty V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩) ∅ , ra_sty V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ V8 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_deq V1 V5 V5 V6 ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ V7 V5 V8 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_sty V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩) ∅ , ra_sty V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ V8 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_sty V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩) ∅ , ra_sty V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ V8 ⟩ = ⟨ pp , ra_sty t1 t2 t3 t4 t5 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_sty V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_sty t1 t2 t3 t4 t5) $ by opair_isset
l9: $ G ⇒ isset (ra_sty V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ V8) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_sty V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩) ∅ ∧ ra_sty t1 t2 t3 t4 t5 = ra_sty V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ V8 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_sty V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_sty t1 t2 t3 t4 t5 = ra_sty V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ V8 $ by and_elim_r [l10]
l13: $ G ⇒ isset V8 $ by isset_var
l14: $ G ⇒ isset ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ isset V3 $ by isset_var
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ isset V1 $ by isset_var
l18: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l19: $ G ⇒ isset t5 $ by isset_var
l20: $ G ⇒ scons t5 ∅ ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t4 $ by isset_var
l22: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq j2_vv $ by j2_fs [l21, l20]
