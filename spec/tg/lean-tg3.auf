lemma j2_o_pow_eqs (G: hyps) (J: class) {G_v f_v fm fa: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_pow_eqs t1 t2 t3 t4 ⟩ ∈ pr_pow_eqs J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ fm ∃ fa (t1 = G_v ∧ t2 = f_v ∧ t3 = fm ∧ t4 = fa ∧ ra_mul_eqs G_v fm fa ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ j2_c7 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $
----
l1: $ G ⇒ ∃ G_v ∃ f_v ∃ fm ∃ fa (t1 = G_v ∧ t2 = f_v ∧ t3 = fm ∧ t4 = fa ∧ ra_mul_eqs G_v fm fa ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ j2_c7 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $ by j2_d_pow_eqs_i [#1, #2]

lrel3_pow_eqs_cases
-------------------
l1: $ G ⇒ isset (ra_pow_eqs t1 t2 t3 t4) $ by opair_isset
l2: $ G , c = ra_pow_eqs t1 t2 t3 t4 ⇒ c = ra_pow_eqs t1 t2 t3 t4 $ by ax
l3: $ G , c = ra_pow_eqs t1 t2 t3 t4 ⇒ ra_pow_eqs t1 t2 t3 t4 = c $ by eq_sym [l2]
l4: $ G , c = ra_pow_eqs t1 t2 t3 t4 ⇒ ra_pow_eqs t1 t2 t3 t4 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_pow_eqs t1 t2 t3 t4 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_pow_eqs t1 t2 t3 t4 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_pow_eqs t1 t2 t3 t4 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_pow_eqs t1 t2 t3 t4 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_pow_eqs t1 t2 t3 t4 $ by ax
l14: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_pow_eqs t1 t2 t3 t4 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_pow_eqs t1 t2 t3 t4 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_pow_eqs t1 t2 t3 t4 ⟩ ∈ pr_pow_eqs J $ by lprog3_pow_eqs_pr [l15]
l17: $ G , c = ra_pow_eqs t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ f_v ∃ fm ∃ fa (t1 = G_v ∧ t2 = f_v ∧ t3 = fm ∧ t4 = fa ∧ ra_mul_eqs G_v fm fa ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ j2_c7 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $ by j2_o_pow_eqs [l16, l11]
l18: $ G , c = ra_pow_eqs t1 t2 t3 t4 ⇒ ∃ G_v ∃ f_v ∃ fm ∃ fa (t1 = G_v ∧ t2 = f_v ∧ t3 = fm ∧ t4 = fa ∧ ra_mul_eqs G_v fm fa ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ j2_c7 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ f_v ∃ fm ∃ fa (t1 = G_v ∧ t2 = f_v ∧ t3 = fm ∧ t4 = fa ∧ ra_mul_eqs G_v fm fa ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ j2_c7 j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $ by isset_elim [l1, l18]

lemma j2_e_beq_eqs_i (G: hyps) (J: class) {G_v f_v B t_v u_v: set} (pp t1 t2 t3 t4 t5 x V1 V2 V3 V4 V5: set):
  $ G ⇒ x = ⟨ pp , ra_beq_eqs t1 t2 t3 t4 t5 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_beq_eqs V1 V2 V3 V4 V5 ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V4 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V5 ∈ lrel ∧ ra_deq V1 V2 V2 ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons V3 ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq V1 ⟨ kc_app , scons ⟨ kc_app , scons V2 j2_c2 ⟩ j2_c2 ⟩ V4 V3 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 j2_c2 ⟩ j2_c3 ⟩ V5 V3 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 j2_c3 ⟩ j2_c2 ⟩ V5 V3 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ V3 ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ B ∃ t_v ∃ u_v (t1 = G_v ∧ t2 = f_v ∧ t3 = B ∧ t4 = t_v ∧ t5 = u_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ t_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ u_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons B ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq G_v ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ j2_c2 ⟩ t_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ j2_c3 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c3 ⟩ j2_c2 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ B ∈ J) $
----
l1: $ G ⇒ x = ⟨ ∅ , ra_beq_eqs V1 V2 V3 V4 V5 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V4 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V5 ∈ lrel ∧ ra_deq V1 V2 V2 ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons V3 ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq V1 ⟨ kc_app , scons ⟨ kc_app , scons V2 j2_c2 ⟩ j2_c2 ⟩ V4 V3 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 j2_c2 ⟩ j2_c3 ⟩ V5 V3 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 j2_c3 ⟩ j2_c2 ⟩ V5 V3 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ V3 ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_beq_eqs t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_beq_eqs t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_beq_eqs V1 V2 V3 V4 V5 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ ∅ , ra_beq_eqs V1 V2 V3 V4 V5 ⟩ = ⟨ pp , ra_beq_eqs t1 t2 t3 t4 t5 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_beq_eqs t1 t2 t3 t4 t5) $ by opair_isset
l9: $ G ⇒ isset (ra_beq_eqs V1 V2 V3 V4 V5) $ by opair_isset
l10: $ G ⇒ pp = ∅ ∧ ra_beq_eqs t1 t2 t3 t4 t5 = ra_beq_eqs V1 V2 V3 V4 V5 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_beq_eqs t1 t2 t3 t4 t5 = ra_beq_eqs V1 V2 V3 V4 V5 $ by and_elim_r [l10]
l13: $ G ⇒ isset V5 $ by isset_var
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ isset V3 $ by isset_var
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ isset V1 $ by isset_var
l18: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l19: $ G ⇒ isset t5 $ by isset_var
