l44: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ ra_pred_eqs V1 V3 ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons V3 (scons ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J $ by j2_and4 [l33, l36, l39, l43, l2]
l45: $ G ⇒ ∃ G_v ∃ f_v ∃ p_v (t1 = G_v ∧ t2 = f_v ∧ t3 = p_v ∧ ra_pred_eqs G_v p_v ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons p_v (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $ by j2_exi3 [l44]

lemma j2_d_sub_eqs_i (G: hyps) (J: class) {G_v f_v p_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_sub_eqs t1 t2 t3 ⟩ ∈ cl_sub_eqs_i J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ p_v (t1 = G_v ∧ t2 = f_v ∧ t3 = p_v ∧ ra_pred_eqs G_v p_v ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons p_v (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $
----
l1: $ G , x = ⟨ pp , ra_sub_eqs t1 t2 t3 ⟩ , x ∊ cl_sub_eqs_i J ⇒ x ∊ cl_sub_eqs_i J $ by ax
l2: $ G , x = ⟨ pp , ra_sub_eqs t1 t2 t3 ⟩ , x ∊ cl_sub_eqs_i J ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_pred_eqs y u) ∅ , ra_sub_eqs y z u ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons u (scons ⟨ kc_app , scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_sub_eqs t1 t2 t3 ⟩ , x = ⟨ scons (ra_pred_eqs y u) ∅ , ra_sub_eqs y z u ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel ∧ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons u (scons ⟨ kc_app , scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J ⇒ x = ⟨ pp , ra_sub_eqs t1 t2 t3 ⟩ $ by ax
