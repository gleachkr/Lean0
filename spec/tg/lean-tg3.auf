l40: $ G ⇒ scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l39]
l41: $ G ⇒ scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l40]
l42: $ G ⇒ scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l17, l41]
