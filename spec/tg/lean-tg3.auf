--| The atoms are a set.
lemma j1_latoms_set (G: hyps): $ G ⇒ isset latoms $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset (trees ω) $ by trees_set_c [l1]
l3: $ G ⇒ isset (fseq (trees ω)) $ by fseq_set [l2]
l4: $ G ⇒ isset latoms $ by cxp_set [l1, l3]

lprog3_hprog
------------
l1: $ G ⇒ isset latoms $ by j1_latoms_set
l2: $ G ⇒ hprog (lprog3 J) latoms $ by hprog_cin [l1]

lemma j1_in_l (G: hyps) (X A B: class): $ G ⇒ X ∈ A $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ A ⊆ A ∪ B $ by cun_subset_l
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

--| The union of the program's clauses, before the restriction to atoms.
def j1_top (J: class): class = $ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $

lemma j1_pr_sty (G: hyps) (J X: class): $ G ⇒ X ∈ pr_sty J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_sty J) ∪ (pr_cwf J) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ (((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf)) $ by j1_in_l [l2]
l4: $ G ⇒ X ∈ ((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J))))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j1_in_l [l4]

lemma j1_ra_sty (G: hyps) (A1 A2 A3 A4 A5: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ > $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ ra_sty A1 A2 A3 A4 A5 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A5 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#5, l1]
l3: $ G ⇒ scons A4 (scons A5 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#4, l2]
l4: $ G ⇒ scons A3 (scons A4 (scons A5 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#3, l3]
l5: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 ∅))) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l4]
l6: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l5]
l7: $ G ⇒ kr_sty ∈ ω $ by kr_sty_omega
l8: $ G ⇒ ra_sty A1 A2 A3 A4 A5 ∈ latoms $ by cxp_intro_c [l7, l6]

--| A clause of the union whose premises are derivable.
lemma j1_horn (G: hyps) (J P C: class):
  $ G ⇒ ⟨ P , C ⟩ ∈ j1_top J $ > $ G ⇒ P ∈ fseq latoms $ > $ G ⇒ C ∈ latoms $ >
  $ G ⇒ crn P ⊆ lrel3 J $ > $ G ⇒ C ∈ lrel3 J $
----
l1: $ G ⇒ ⟨ P , C ⟩ ∈ fseq latoms × latoms $ by cxp_intro_c [#2, #3]
l2: $ G ⇒ ⟨ P , C ⟩ ∈ lprog3 J $ by wcel_cin [#1, l1]
l3: $ G ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l4: $ G ⇒ isset P $ by wcel_isset [#2]
l5: $ G ⇒ isset C $ by wcel_isset [#3]
l6: $ G ⇒ C ∈ lrel3 J $ by horn_intro_c [l3, l2, l4, l5, #4]

lemma j1_c_sty_nil (G: hyps) (J A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_sty A1 A2 A3 A2 A3 ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ x = ⟨ ∅ , ra_sty y z u z u ⟩ $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ ∃ u (x = ⟨ ∅ , ra_sty y z u z u ⟩) $ by ex_intro [l4]
l6: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_sty y z u z u ⟩) $ by ex_intro [l5]
l7: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_sty y z u z u ⟩) $ by ex_intro [l6]
l8: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ x ∊ cl_sty_nil $ by cab_intro [l7]
l9: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ ⟨ ∅ , ra_sty y z u z u ⟩ ∈ cl_sty_nil $ by wcel_intro [l4, l8]
l10: $ G , y = A1 , z = A2 , u = A3 ⇒ isset ⟨ ∅ , ra_sty y z u z u ⟩ $ by opair_isset
l11: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_sty y z u z u ⟩ ∈ cl_sty_nil $ by isset_elim [l10, l9]
l12: $ G , y = A1 , z = A2 , u = A3 ⇒ ∅ = ∅ $ by eq_refl
l13: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_sty y z u z u = ra_sty A1 A2 A3 A2 A3 $ by ra_sty_eq [l1, l2, l3, l2, l3]
l14: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_sty y z u z u ⟩ = ⟨ ∅ , ra_sty A1 A2 A3 A2 A3 ⟩ $ by opair_eq [l12, l13]
l15: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_sty A1 A2 A3 A2 A3 ⟩ ∈ cl_sty_nil $ by wcel_eq_l [l14, l11]
l16: $ G ⇒ isset A3 $ by wcel_isset [#3]
l17: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_sty A1 A2 A3 A2 A3 ⟩ ∈ cl_sty_nil $ by isset_elim [l16, l15]
l18: $ G ⇒ isset A2 $ by wcel_isset [#2]
l19: $ G , y = A1 ⇒ ⟨ ∅ , ra_sty A1 A2 A3 A2 A3 ⟩ ∈ cl_sty_nil $ by isset_elim [l18, l17]
l20: $ G ⇒ isset A1 $ by wcel_isset [#1]
l21: $ G ⇒ ⟨ ∅ , ra_sty A1 A2 A3 A2 A3 ⟩ ∈ cl_sty_nil $ by isset_elim [l20, l19]
l22: $ G ⇒ ⟨ ∅ , ra_sty A1 A2 A3 A2 A3 ⟩ ∈ cl_sty_nil ∪ (cl_sty_app J) $ by j1_in_l [l21]
l23: $ G ⇒ ⟨ ∅ , ra_sty A1 A2 A3 A2 A3 ⟩ ∈ j1_top J $ by j1_pr_sty [l22]
l24: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l25: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l26: $ G ⇒ ra_sty A1 A2 A3 A2 A3 ∈ latoms $ by j1_ra_sty [#1, #2, #3, #2, #3]
l27: $ G ⇒ ra_sty A1 A2 A3 A2 A3 ∈ lrel3 J $ by j1_horn [l23, l24, l26, l25]

sty_nil_j
---------
l1: $ _ ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
l2: $ _ ⇒ enc_expr h ∈ trees ω $ by enc_expr_trees
l3: $ _ ⇒ enc_expr A ∈ trees ω $ by enc_expr_trees
l4: $ sty_j J G h A h A $ by j1_c_sty_nil [l1, l2, l3]

lemma j1_in_r (G: hyps) (X A B: class): $ G ⇒ X ∈ B $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ B ⊆ A ∪ B $ by cun_subset_r
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

--| A derivable atom of the stratum is an atom.
lemma j1_lrel3_lat (G: hyps) (J X: class): $ G ⇒ X ∈ lrel3 J $ > $ G ⇒ X ∈ latoms $
----
l1: $ G ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l2: $ G ⇒ horn (lprog3 J) ⊆ latoms $ by horn_sub [l1]
l3: $ G ⇒ X ∈ latoms $ by wcel_subset [l2, #1]

lemma j1_c_sty_app (G: hyps) (J A1 A2 A3 A4 A5 A6 A7 A8: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ A7 ∈ trees ω $ >
  $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ ⟨ kc_app , scons A4 (scons A5 ∅) ⟩ ∈ trees ω $ >
  $ G ⇒ ra_sty A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A7 ∅) ⟩ ∈ lrel3 J $ >
  $ G ⇒ ra_deq A1 A5 A5 A6 ∈ J $ >
  $ G ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ A7 A5 A8 ∈ lrel $ >
  $ G ⇒ ra_sty A1 A2 A3 ⟨ kc_app , scons A4 (scons A5 ∅) ⟩ A8 ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ v = A4 $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ w = A5 $ by ax
l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ a = A6 $ by ax
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ b = A7 $ by ax
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ c = A8 $ by ax
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_deq A1 A5 A5 A6 ∈ J $ by weaken [#11]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_deq y w w a = ra_deq A1 A5 A5 A6 $ by ra_deq_eq [l1, l5, l5, l6]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_deq A1 A5 A5 A6 = ra_deq y w w a $ by eq_sym [l10]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_deq y w w a ∈ J $ by wcel_eq_l [l11, l9]
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ A7 A5 A8 ∈ lrel $ by weaken [#12]
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ b w c = ra_inst ⟨ kc_nz , ∅ ⟩ A7 A5 A8 $ by ra_inst_eq [l14, l7, l5, l8]
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ A7 A5 A8 = ra_inst ⟨ kc_nz , ∅ ⟩ b w c $ by eq_sym [l15]
l17: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel $ by wcel_eq_l [l16, l13]
l18: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ $ by ax
l19: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel $ by weaken [l17]
l20: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ra_deq y w w a ∈ J $ by weaken [l12]
l21: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel $ by and_intro [l20, l19]
l22: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel $ by and_intro [l18, l21]
l23: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by ex_intro [l22]
l24: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by ex_intro [l23]
l25: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by ex_intro [l24]
l26: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by ex_intro [l25]
l27: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by ex_intro [l26]
l28: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by ex_intro [l27]
l29: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by ex_intro [l28]
l30: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by ex_intro [l29]
l31: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ x ∊ cl_sty_app J $ by cab_intro [l30]
l32: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ⇒ ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∈ cl_sty_app J $ by wcel_intro [l18, l31]
l33: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 ⇒ isset ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ $ by opair_isset
