l23: $ G ⇒ isset kr_tys_ok $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons V3 ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_tys_ok = kr_tys_ok ∧ scons t1 (scons t2 ∅) = scons V1 (scons V3 ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V3 ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V3 ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons V3 ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V3 ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = V3 $ by and_elim_l [l31]
l33: $ G ⇒ crn pp = crn (scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅)) $ by crn_eq [l11]
l34: $ G ⇒ crn (scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅)) ⊆ lrel3 J $ by subset_eq_l [l33, #3]
l35: $ G ⇒ isset (ra_ctx_wf V1 V5) $ by opair_isset
l36: $ G ⇒ ra_ctx_wf V1 V5 ∈ lrel3 J $ by crn_scons_head [l35, l34]
l37: $ G ⇒ crn (scons (ra_tys_ty V2 V6) ∅) ⊆ lrel3 J $ by crn_scons_tail [l34]
