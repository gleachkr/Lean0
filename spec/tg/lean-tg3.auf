lemma j2_d_beq_eqs_i (G: hyps) (J: class) {G_v f_v B t_v u_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_beq_eqs t1 t2 t3 t4 t5 ⟩ ∈ cl_beq_eqs_i J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
