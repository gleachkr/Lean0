--| Introduction of 2 nested existentials.
lemma j2_exi2 {a1 a2: set} (G: hyps) (b1 b2: set) (p: fml a1 a2):
  $ G ⇒ [a2/b2] [a1/b1] p $ > $ G ⇒ ∃ a1 ∃ a2 p $
----
l1: $ G ⇒ ∃ a2 [a1/b1] p $ by ex_intro [#1]
l2: $ G ⇒ ∃ a1 ∃ a2 p $ by ex_intro [l1]

--| Introduction of 3 nested existentials.
