lemma j1_pr_ind_wf (G: hyps) (J X: class): $ G ⇒ X ∈ pr_ind_wf $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ (pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ (((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J)))) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_l [l3]

lemma j1_ra_ind_wf (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_ind_wf A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_ind_wf ∈ ω $ by kr_ind_wf_omega
l5: $ G ⇒ ra_ind_wf A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

