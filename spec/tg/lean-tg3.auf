l21: $ _ ⇒ enc_expr K = enc_expr K $ by eq_refl
l22: $ _ ⇒ ra_fprops (enc_ind D) (enc_nat n) (enc_nat np) (enc_ctx G2) (enc_nat nz) (enc_nat (s i)) (enc_expr K) = ra_fprops (enc_ind D) (enc_nat n) (enc_nat np) (enc_ctx G2) ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons (enc_nat i) ∅ ⟩ (enc_expr K) $ by ra_fprops_eq [l15, l16, l17, l18, l19, l20, l21]
