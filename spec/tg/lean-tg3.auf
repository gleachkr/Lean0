--| @rewrite
--| The encoding of `nat_ty`, for the normalizer (which keeps it folded).
lemma j3_enc_nat_ty: $ enc_expr nat_ty ≐ ⟨ kc_ind_ty , scons (enc_ind nat_D) (scons (enc_nat nz) ∅) ⟩ $
----
l1: $ enc_expr nat_ty ≐ ⟨ kc_ind_ty , scons (enc_ind nat_D) (scons (enc_nat nz) ∅) ⟩ $ by enc_ind_ty

--| @rewrite
--| The encoding of `nat_D`, for the normalizer (which keeps it folded).
lemma j3_enc_nat_D: $ enc_ind nat_D ≐ ⟨ kc_ind_mk , scons (enc_blk nat_blk) (scons (enc_ctx nil) (scons (enc_tys (tcons (srt (ls lz)) (ccons (bvar nz) (ccons (pi (bvar nz) (bvar (s nz))) cnil)) tnil)) ∅)) ⟩ $
----
l1: $ enc_ind nat_D ≐ ⟨ kc_ind_mk , scons (enc_blk nat_blk) (scons (enc_ctx nil) (scons (enc_tys (tcons (srt (ls lz)) (ccons (bvar nz) (ccons (pi (bvar nz) (bvar (s nz))) cnil)) tnil)) ∅)) ⟩ $ by enc_ind_mk

--| @rewrite
--| The encoding of `fix_fty`, for the normalizer (which keeps it folded).
lemma j3_enc_fix_fty (al motive hm ltN: expr): $ enc_expr (fix_fty al motive hm ltN) ≐ ⟨ kc_pi , scons (enc_expr al) (scons (enc_expr (pi (pi al (pi (app (app ltN (app hm (bvar nz))) (app hm (bvar n1))) (app motive (bvar n1)))) (app motive (bvar n1)))) ∅) ⟩ $
----
l1: $ enc_expr (fix_fty al motive hm ltN) ≐ ⟨ kc_pi , scons (enc_expr al) (scons (enc_expr (pi (pi al (pi (app (app ltN (app hm (bvar nz))) (app hm (bvar n1))) (app motive (bvar n1)))) (app motive (bvar n1)))) ∅) ⟩ $ by enc_pi

