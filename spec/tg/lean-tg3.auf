lemma j2_o_ble_eqs (G: hyps) (J: class) {G_v f_v B t_v u_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_ble_eqs t1 t2 t3 t4 t5 ⟩ ∈ pr_ble_eqs J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ B ∃ t_v ∃ u_v (t1 = G_v ∧ t2 = f_v ∧ t3 = B ∧ t4 = t_v ∧ t5 = u_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ t_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ u_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons B ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ t_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c3 ⟩ j2_c2 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ B ∈ J) $
----
l1: $ G ⇒ ∃ G_v ∃ f_v ∃ B ∃ t_v ∃ u_v (t1 = G_v ∧ t2 = f_v ∧ t3 = B ∧ t4 = t_v ∧ t5 = u_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ t_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ u_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons B ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ t_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c3 ⟩ j2_c2 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ B ∈ J) $ by j2_d_ble_eqs_i [#1, #2]

lrel3_ble_eqs_cases
-------------------
l1: $ G ⇒ isset (ra_ble_eqs t1 t2 t3 t4 t5) $ by opair_isset
l2: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 ⇒ c = ra_ble_eqs t1 t2 t3 t4 t5 $ by ax
l3: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 ⇒ ra_ble_eqs t1 t2 t3 t4 t5 = c $ by eq_sym [l2]
l4: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 ⇒ ra_ble_eqs t1 t2 t3 t4 t5 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_ble_eqs t1 t2 t3 t4 t5 $ by ax
l14: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_ble_eqs t1 t2 t3 t4 t5 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ble_eqs t1 t2 t3 t4 t5 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ble_eqs t1 t2 t3 t4 t5 ⟩ ∈ pr_ble_eqs J $ by lprog3_ble_eqs_pr [l15]
l17: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ f_v ∃ B ∃ t_v ∃ u_v (t1 = G_v ∧ t2 = f_v ∧ t3 = B ∧ t4 = t_v ∧ t5 = u_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ t_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ u_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons B ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ t_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c3 ⟩ j2_c2 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ B ∈ J) $ by j2_o_ble_eqs [l16, l11]
l18: $ G , c = ra_ble_eqs t1 t2 t3 t4 t5 ⇒ ∃ G_v ∃ f_v ∃ B ∃ t_v ∃ u_v (t1 = G_v ∧ t2 = f_v ∧ t3 = B ∧ t4 = t_v ∧ t5 = u_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ t_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ u_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons B ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ t_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c3 ⟩ j2_c2 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ B ∈ J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ f_v ∃ B ∃ t_v ∃ u_v (t1 = G_v ∧ t2 = f_v ∧ t3 = B ∧ t4 = t_v ∧ t5 = u_v ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ t_v ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ u_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons j2_c1 (scons ⟨ kc_pi , scons j2_c1 (scons B ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c2 ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ t_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c3 ⟩ j2_c2 ⟩ u_v B ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v j2_c8 ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ B ∈ J) $ by isset_elim [l1, l18]

lemma j2_e_shl_eqs_i (G: hyps) (J: class) {G_v f_v fm fa: set} (pp t1 t2 t3 t4 x V1 V2 V3 V4: set):
  $ G ⇒ x = ⟨ pp , ra_shl_eqs t1 t2 t3 t4 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_mul_eqs V1 V3 V4) ∅ , ra_shl_eqs V1 V2 V3 V4 ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_app , scons ⟨ kc_app , scons V3 (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ fm ∃ fa (t1 = G_v ∧ t2 = f_v ∧ t3 = fm ∧ t4 = fa ∧ ra_mul_eqs G_v fm fa ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_mul_eqs V1 V3 V4) ∅ , ra_shl_eqs V1 V2 V3 V4 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 j2_c0 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c2 ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ j2_c1 ∈ J ∧ ra_deq ⟨ kc_cons , scons j2_c1 (scons ⟨ kc_cons , scons j2_c1 (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c3 ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_app , scons ⟨ kc_app , scons V3 (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ j2_c1 ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_shl_eqs t1 t2 t3 t4 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_shl_eqs t1 t2 t3 t4 ⟩ = ⟨ scons (ra_mul_eqs V1 V3 V4) ∅ , ra_shl_eqs V1 V2 V3 V4 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_mul_eqs V1 V3 V4) ∅ , ra_shl_eqs V1 V2 V3 V4 ⟩ = ⟨ pp , ra_shl_eqs t1 t2 t3 t4 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_mul_eqs V1 V3 V4) ∅) $ by j2_opair_set_l [l5]
