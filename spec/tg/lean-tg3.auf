l27: $ G ⇒ isset t4 $ by isset_var
l28: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) ∈ fseq j2_vv $ by j2_fs [l27, l26]
l29: $ G ⇒ isset t3 $ by isset_var
l30: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) ∈ fseq j2_vv $ by j2_fs [l29, l28]
l31: $ G ⇒ isset t2 $ by isset_var
l32: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) ∈ fseq j2_vv $ by j2_fs [l31, l30]
l33: $ G ⇒ isset t1 $ by isset_var
l34: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq j2_vv $ by j2_fs [l33, l32]
l35: $ G ⇒ scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l13, l20]
l36: $ G ⇒ scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l14, l35]
l37: $ G ⇒ scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l36]
l38: $ G ⇒ scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l37]
l39: $ G ⇒ scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l17, l38]
l40: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))))) ∈ fseq j2_vv $ by j2_fs [l18, l39]
l41: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)))))) ∈ fseq j2_vv $ by j2_fs [l19, l40]
l42: $ G ⇒ kr_fprops ∈ ω $ by kr_fprops_omega
l43: $ G ⇒ isset kr_fprops $ by wcel_isset [l42]
l44: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l34]
l45: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))))))) $ by wcel_isset [l41]
l46: $ G ⇒ kr_fprops = kr_fprops ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)))))) $ by opair_inj_c [l12, l43, l44, l43, l45]
l47: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)))))) $ by and_elim_r [l46]
l48: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))))) $ by j2_scons_inj [l47, l33, l19, l32, l40]
l49: $ G ⇒ t1 = V1 $ by and_elim_l [l48]
l50: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))))) $ by and_elim_r [l48]
l51: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)))) $ by j2_scons_inj [l50, l31, l18, l30, l39]
l52: $ G ⇒ t2 = V2 $ by and_elim_l [l51]
l53: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)))) $ by and_elim_r [l51]
l54: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))) $ by j2_scons_inj [l53, l29, l17, l28, l38]
l55: $ G ⇒ t3 = V3 $ by and_elim_l [l54]
l56: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))) $ by and_elim_r [l54]
l57: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)) $ by j2_scons_inj [l56, l27, l16, l26, l37]
l58: $ G ⇒ t4 = V4 $ by and_elim_l [l57]
l59: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)) $ by and_elim_r [l57]
l60: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅) $ by j2_scons_inj [l59, l25, l15, l24, l36]
l61: $ G ⇒ t5 = V5 $ by and_elim_l [l60]
l62: $ G ⇒ scons t6 (scons t7 ∅) = scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅) $ by and_elim_r [l60]
l63: $ G ⇒ t6 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ scons t7 ∅ = scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅ $ by j2_scons_inj [l62, l23, l14, l22, l35]
l64: $ G ⇒ t6 = ⟨ kc_s , scons V6 ∅ ⟩ $ by and_elim_l [l63]
l65: $ G ⇒ scons t7 ∅ = scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅ $ by and_elim_r [l63]
l66: $ G ⇒ t7 = ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l65, l21, l13, l20, l20]
l67: $ G ⇒ t7 = ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ $ by and_elim_l [l66]
l68: $ G ⇒ crn pp = crn (scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅) $ by crn_eq [l11]
l69: $ G ⇒ crn (scons (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) ∅) ⊆ lrel3 J $ by subset_eq_l [l68, #3]
l70: $ G ⇒ isset (ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10) $ by opair_isset
l71: $ G ⇒ ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10 ∈ lrel3 J $ by crn_scons_head [l70, l69]
l72: $ G ⇒ ra_add V5 V3 V7 ∈ lrel $ by and_elim_l [l2]
l73: $ G ⇒ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V7 V8 V9 ∈ lrel ∧ ra_deq V4 V9 V9 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by and_elim_r [l2]
l74: $ G ⇒ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V7 V8 V9 ∈ lrel $ by and_elim_l [l73]
l75: $ G ⇒ ra_deq V4 V9 V9 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by and_elim_r [l73]
l76: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∧ ra_add V5 V3 V7 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V7 V8 V9 ∈ lrel ∧ ra_deq V4 V9 V9 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops V1 V2 V3 ⟨ kc_cons , scons V9 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V6 V10 ∈ lrel3 J $ by j2_and10 [l49, l52, l55, l58, l61, l64, l67, l72, l74, l75, l71]
l77: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by j2_exi10 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, b9 := $ V9 $, b10 := $ V10 $, p := $ t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J $) [l76]

lemma j2_d_fprops_s (G: hyps) (J: class) {D n_v np Ctx d_v cnt k_v A A2 B: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_s J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_fprops_s J ⇒ x ∊ cl_fprops_s J $ by ax
l2: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_fprops_s J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by ax
l5: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_fprops y z u ⟨ kc_cons , scons f (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ a g) ∅ , ra_fprops y z u v w ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ∧ ra_add w u b ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z b c f ∈ lrel ∧ ra_deq v f f ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by j2_e_fprops_s [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_fprops_s J ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by j2_ex10 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_fprops (G: hyps) (J: class) {D n_v np Ctx d_v K cnt k_v A A2 B: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ pr_fprops J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_nz , ∅ ⟩ ∧ t7 = K) ∨ ∃ D ∃ n_v ∃ np ∃ Ctx ∃ d_v ∃ cnt ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = Ctx ∧ t5 = d_v ∧ t6 = ⟨ kc_s , scons cnt ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fprops D n_v np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ cnt B ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_s J ⇒ ⟨ pp , ra_fprops t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_fprops_s J $ by ax
