l6: $ G , x = ⟨ scons (ra_tys_ok y u) (scons (ra_tys_wf u f c k ⟨ kc_nz , ∅ ⟩ z b) (scons (ra_nst_ok y u j a) ∅)) , ra_ind_wf y u ⟩ ∧ ra_ind_data u v w b ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_ntys b f g ∈ lrel ∧ ra_capp w y z ∈ lrel ∧ ra_nth_ty b ⟨ kc_nz , ∅ ⟩ d e ∈ lrel ∧ ra_isort d i k ∈ lrel ∧ ra_ind_nested u a ∈ lrel ∧ ra_ndecl a f j ∈ lrel ⇒ x ∊ j2_lab kr_ind_wf (suc kr_ind_wf) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_ind_wf_i ⇒ x ∊ j2_lab kr_ind_wf (suc kr_ind_wf) $ by j2_ex15 [l2, l6]
