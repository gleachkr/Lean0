lemma j2_d_nst_ok_nil (G: hyps) (J: class) {G_v D j_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_nil ⇒ x ∊ cl_nst_ok_nil $ by ax
l2: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_nil ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by j2_e_nst_ok_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_nil ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by j2_ex3 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma j2_e_nst_ok_cons (G: hyps) (J: class) {G_v D I j_v j2 npi ni mi ni0 X N2 N3 NI: set} (pp t1 t2 t3 t4 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13: set):
  $ G ⇒ x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_ind_wf V1 V3) (scons (ra_nst_ok V1 V2 V5 V12) ∅) , ra_nst_ok V1 V2 V4 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons V3 (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ V10 V6 ∈ lrel ∧ ra_ind_arity V3 V6 V7 V8 ∈ lrel ∧ ra_ind_nested V3 V13 ∈ lrel ∧ ra_ndecl V13 V7 V9 ∈ lrel ∧ ra_nst_group V1 V2 V3 V10 V4 ⟨ kc_nz , ∅ ⟩ V9 ⟨ kc_cons , scons V10 (scons V11 ∅) ⟩ V12 ∈ lrel2 ∧ ra_add V4 V9 V5 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $
----
