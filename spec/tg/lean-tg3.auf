lemma j1_c_large_empty (G: hyps) (J A1 A2 A3 A4 A5: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
