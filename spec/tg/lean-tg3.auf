lemma j1_pr_shl_eqs (G: hyps) (J X: class): $ G ⇒ X ∈ pr_shl_eqs J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ (pr_ble_eqs J) ∪ (pr_shl_eqs J) $ by j1_in_r [#1]
l2: $ G ⇒ X ∈ ((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J)) $ by j1_in_l [l1]
