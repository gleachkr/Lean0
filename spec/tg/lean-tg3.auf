l34: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq j2_vv $ by j2_fs [l33, l32]
l35: $ G ⇒ scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l13, l20]
l36: $ G ⇒ scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l14, l35]
l37: $ G ⇒ scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l36]
l38: $ G ⇒ scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l37]
l39: $ G ⇒ scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l17, l38]
l40: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅))))) ∈ fseq j2_vv $ by j2_fs [l18, l39]
l41: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)))))) ∈ fseq j2_vv $ by j2_fs [l19, l40]
