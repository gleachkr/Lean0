--| Moving level equivalence along equalities of its arguments.
lemma j1_lveq_eq (G: hyps) (A B C D: class):
  $ G ⇒ A = C $ > $ G ⇒ B = D $ > $ G ⇒ lveq A B $ > $ G ⇒ lveq C D $
----
l1: $ G ⇒ x ∊ lvals → lv A x = lv B x $ by all_elim [#3]
l2: $ G , x ∊ lvals ⇒ x ∊ lvals → lv A x = lv B x $ by weaken [l1]
l3: $ G , x ∊ lvals ⇒ x ∊ lvals $ by ax
l4: $ G , x ∊ lvals ⇒ lv A x = lv B x $ by imp_elim [l2, l3]
l5: $ G , x ∊ lvals ⇒ A = C $ by weaken [#1]
l6: $ G , x ∊ lvals ⇒ B = D $ by weaken [#2]
l7: $ G , x ∊ lvals ⇒ x = x $ by eq_refl
l8: $ G , x ∊ lvals ⇒ lv A x = lv C x $ by lv_eq [l5, l7]
l9: $ G , x ∊ lvals ⇒ lv B x = lv D x $ by lv_eq [l6, l7]
l10: $ G , x ∊ lvals ⇒ lv C x = lv A x $ by eq_sym [l8]
l11: $ G , x ∊ lvals ⇒ lv C x = lv B x $ by eq_trans [l10, l4]
l12: $ G , x ∊ lvals ⇒ lv C x = lv D x $ by eq_trans [l11, l9]
l13: $ G ⇒ x ∊ lvals → lv C x = lv D x $ by imp_intro [l12]
l14: $ G ⇒ lveq C D $ by all_intro [l13]

