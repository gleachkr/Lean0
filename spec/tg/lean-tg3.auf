lemma j3_wmv_closed (G: hyps) (C X1 X2 Y1 Y2: class):
  $ G ⇒ ra_closed X1 X2 ∈ C $ > $ G ⇒ X1 = Y1 $ > $ G ⇒ X2 = Y2 $ >
  $ G ⇒ ra_closed Y1 Y2 ∈ C $
----
l1: $ G ⇒ ra_closed X1 X2 ∈ C → ra_closed Y1 Y2 ∈ C $ by j3_wimp_closed [#2, #3]
l2: $ G ⇒ ra_closed Y1 Y2 ∈ C $ by imp_elim [l1, #1]

lemma j3_wmv_deq (G: hyps) (C X1 X2 X3 X4 Y1 Y2 Y3 Y4: class):
  $ G ⇒ ra_deq X1 X2 X3 X4 ∈ C $ > $ G ⇒ X1 = Y1 $ > $ G ⇒ X2 = Y2 $ > $ G ⇒ X3 = Y3 $ > $ G ⇒ X4 = Y4 $ >
  $ G ⇒ ra_deq Y1 Y2 Y3 Y4 ∈ C $
----
l1: $ G ⇒ ra_deq X1 X2 X3 X4 ∈ C → ra_deq Y1 Y2 Y3 Y4 ∈ C $ by j3_wimp_deq [#2, #3, #4, #5]
l2: $ G ⇒ ra_deq Y1 Y2 Y3 Y4 ∈ C $ by imp_elim [l1, #1]

