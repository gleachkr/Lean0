l37: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 ∅))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_beq_eqs = kr_beq_eqs ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 ∅)))) $ by opair_inj_c [l12, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 ∅)))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons V5 ∅))) $ by j2_scons_inj [l39, l27, l17, l26, l32]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons V5 ∅))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V5 ∅)) $ by j2_scons_inj [l42, l25, l16, l24, l31]
