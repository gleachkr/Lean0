l92: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_exi13 [l91]

lemma j2_d_cwf_pi_rec (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v A B A2 B2 u_v: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cwf_pi_rec J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi_rec J ⇒ x ∊ cl_cwf_pi_rec J $ by ax
l2: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi_rec J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel ⇒ x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_e_cwf_pi_rec [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cwf_pi_rec J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_ex13 [l2, l6]
l8: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ B ∃ A2 ∃ B2 ∃ u_v (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_ulevel l_v u_v ∈ lrel2 ∧ ra_ipos D n_v np d_v A ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ B ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ B2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B2 B ∈ lrel ∧ ra_cwf D n_v np l_v i_v ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_e_cwf_res (G: hyps) (J: class) {D n_v np l_v i_v Ctx d_v k_v K K2 b_v P T F C R R2 S: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18: set):
  $ G ⇒ x = ⟨ pp , ra_cwf t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_sty V6 ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ V17 V10 V18) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 V9 ⟩ ∧ ra_indapp V1 V2 V3 V7 V9 V5 ∈ lrel ∧ ra_add V7 V3 V8 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V2 V8 V9 V10 ∈ lrel ∧ ra_ind_data V1 V11 V12 V13 ∈ lrel ∧ ra_nth_ty V13 V5 V14 V15 ∈ lrel ∧ ra_pis V12 V14 V16 ∈ lrel ∧ ra_lift V8 ⟨ kc_nz , ∅ ⟩ V16 V17 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx ∃ d_v ∃ k_v ∃ K ∃ K2 ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ R ∃ R2 ∃ S (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = d_v ∧ t8 = K ∧ ra_indapp D n_v np d_v K i_v ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v k_v K K2 ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_pis P F R ∈ lrel ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ R R2 ∈ lrel ∧ ra_sty Ctx ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ R2 K2 S ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_sty V6 ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ V17 V10 V18) ∅ , ra_cwf V1 V2 V3 V4 V5 V6 V7 V9 ⟩ $ by and_elim_l [#2]
