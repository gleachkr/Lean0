lemma j1_pr_nst_ok (G: hyps) (J X: class): $ G ⇒ X ∈ pr_nst_ok $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ pr_nst_ok ∪ pr_large $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ (pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ ((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))) $ by j1_in_l [l2]
l4: $ G ⇒ X ∈ ((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J))))) $ by j1_in_r [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j1_in_l [l4]

lemma j1_ra_nst_ok (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_nst_ok A1 A2 A3 A4 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A4 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#4, l1]
l3: $ G ⇒ scons A3 (scons A4 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#3, l2]
l4: $ G ⇒ scons A2 (scons A3 (scons A4 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l3]
l5: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 ∅))) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l4]
l6: $ G ⇒ kr_nst_ok ∈ ω $ by kr_nst_ok_omega
l7: $ G ⇒ ra_nst_ok A1 A2 A3 A4 ∈ latoms $ by cxp_intro_c [l6, l5]

lemma j1_c_nst_ok_nil (G: hyps) (J A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ⟨ kc_nil , ∅ ⟩ ∈ trees ω $ >
  $ G ⇒ ra_nst_ok A1 A2 A3 ⟨ kc_nil , ∅ ⟩ ∈ lrel3 J $
----
l1: $ G , y = A1 , z = A2 , u = A3 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ u (x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩) $ by ex_intro [l4]
l6: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩) $ by ex_intro [l5]
l7: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩) $ by ex_intro [l6]
l8: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ cl_nst_ok_nil $ by cab_intro [l7]
l9: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_nst_ok_nil $ by wcel_intro [l4, l8]
l10: $ G , y = A1 , z = A2 , u = A3 ⇒ isset ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ $ by opair_isset
l11: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_nst_ok_nil $ by isset_elim [l10, l9]
l12: $ G , y = A1 , z = A2 , u = A3 ⇒ ∅ = ∅ $ by eq_refl
l13: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_nil , ∅ ⟩ $ by eq_refl
l14: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ = ra_nst_ok A1 A2 A3 ⟨ kc_nil , ∅ ⟩ $ by ra_nst_ok_eq [l1, l2, l3, l13]
l15: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_nst_ok y z u ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ ∅ , ra_nst_ok A1 A2 A3 ⟨ kc_nil , ∅ ⟩ ⟩ $ by opair_eq [l12, l14]
l16: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_nst_ok A1 A2 A3 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_nst_ok_nil $ by wcel_eq_l [l15, l11]
l17: $ G ⇒ isset A3 $ by wcel_isset [#3]
l18: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_nst_ok A1 A2 A3 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_nst_ok_nil $ by isset_elim [l17, l16]
l19: $ G ⇒ isset A2 $ by wcel_isset [#2]
l20: $ G , y = A1 ⇒ ⟨ ∅ , ra_nst_ok A1 A2 A3 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_nst_ok_nil $ by isset_elim [l19, l18]
