add_eqs_i_j
-----------
l1: $ _ ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
l2: $ _ ⇒ enc_expr f ∈ trees ω $ by enc_expr_trees
l3: $ _ ⇒ enc_nat nz = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l4: $ _ ⇒ enc_expr f = enc_expr f $ by eq_refl
l5: $ _ ⇒ ra_closed (enc_nat nz) (enc_expr f) = ra_closed ⟨ kc_nz , ∅ ⟩ (enc_expr f) $ by ra_closed_eq [l3, l4]
l6: $ _ ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ (enc_expr f) ∈ lrel $ by wcel_eq_l [l5, #1]
l7: $ _ ⇒ enc_ctx G = enc_ctx G $ by eq_refl
l8: $ _ ⇒ enc_expr (pi nat_ty (pi nat_ty nat_ty)) = ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ $ by eq_refl
l9: $ _ ⇒ ra_deq (enc_ctx G) (enc_expr f) (enc_expr f) (enc_expr (pi nat_ty (pi nat_ty nat_ty))) = ra_deq (enc_ctx G) (enc_expr f) (enc_expr f) ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ $ by ra_deq_eq [l7, l4, l4, l8]
l10: $ _ ⇒ ra_deq (enc_ctx G) (enc_expr f) (enc_expr f) ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J $ by wcel_eq_l [l9, #2]
l11: $ _ ⇒ enc_ctx (cons nat_ty G) = ⟨ kc_cons , scons tr_nat_ty (scons (enc_ctx G) ∅) ⟩ $ by eq_refl
l12: $ _ ⇒ enc_expr (app (app f (bvar nz)) nat_zero) = ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ $ by eq_refl
l13: $ _ ⇒ enc_expr (bvar nz) = ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ by eq_refl
l14: $ _ ⇒ enc_expr nat_ty = tr_nat_ty $ by eq_refl
l15: $ _ ⇒ ra_deq (enc_ctx (cons nat_ty G)) (enc_expr (app (app f (bvar nz)) nat_zero)) (enc_expr (bvar nz)) (enc_expr nat_ty) = ra_deq ⟨ kc_cons , scons tr_nat_ty (scons (enc_ctx G) ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty $ by ra_deq_eq [l11, l12, l13, l14]
l16: $ _ ⇒ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons (enc_ctx G) ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J $ by wcel_eq_l [l15, #3]
l17: $ _ ⇒ enc_ctx (cons nat_ty (cons nat_ty G)) = ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons (enc_ctx G) ∅) ⟩ ∅) ⟩ $ by eq_refl
l18: $ _ ⇒ enc_expr (app (app f (bvar n1)) (app nat_succ (bvar nz))) = ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ $ by eq_refl
l19: $ _ ⇒ enc_expr (app nat_succ (app (app f (bvar n1)) (bvar nz))) = ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ $ by eq_refl
l20: $ _ ⇒ ra_deq (enc_ctx (cons nat_ty (cons nat_ty G))) (enc_expr (app (app f (bvar n1)) (app nat_succ (bvar nz)))) (enc_expr (app nat_succ (app (app f (bvar n1)) (bvar nz)))) (enc_expr nat_ty) = ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons (enc_ctx G) ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty $ by ra_deq_eq [l17, l18, l19, l14]
l21: $ _ ⇒ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons (enc_ctx G) ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_app , scons ⟨ kc_app , scons (enc_expr f) (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J $ by wcel_eq_l [l20, #4]
l22: $ add_eqs_j J G f $ by lrel3_add_eqs_i [l1, l2, l6, l10, l16, l21]

