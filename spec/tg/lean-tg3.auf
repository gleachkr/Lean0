--| A conjunction of 13 formulas from its conjuncts, the first in another context.
lemma j3_andIw_13 (G H: hyps) (p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13: fml):
  $ H ⇒ p1 $ > $ G ⇒ p2 $ > $ G ⇒ p3 $ > $ G ⇒ p4 $ > $ G ⇒ p5 $ > $ G ⇒ p6 $ > $ G ⇒ p7 $ > $ G ⇒ p8 $ > $ G ⇒ p9 $ > $ G ⇒ p10 $ > $ G ⇒ p11 $ > $ G ⇒ p12 $ > $ G ⇒ p13 $ >
  $ G , H ⇒ p1 ∧ p2 ∧ p3 ∧ p4 ∧ p5 ∧ p6 ∧ p7 ∧ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $
----
l1: $ G , H ⇒ p1 $ by weaken [#1]
l2: $ G , H ⇒ p2 $ by weaken [#2]
l3: $ G , H ⇒ p3 $ by weaken [#3]
l4: $ G , H ⇒ p4 $ by weaken [#4]
l5: $ G , H ⇒ p5 $ by weaken [#5]
l6: $ G , H ⇒ p6 $ by weaken [#6]
l7: $ G , H ⇒ p7 $ by weaken [#7]
l8: $ G , H ⇒ p8 $ by weaken [#8]
l9: $ G , H ⇒ p9 $ by weaken [#9]
l10: $ G , H ⇒ p10 $ by weaken [#10]
l11: $ G , H ⇒ p11 $ by weaken [#11]
l12: $ G , H ⇒ p12 $ by weaken [#12]
l13: $ G , H ⇒ p13 $ by weaken [#13]
l14: $ G , H ⇒ p12 ∧ p13 $ by and_intro [l12, l13]
l15: $ G , H ⇒ p11 ∧ p12 ∧ p13 $ by and_intro [l11, l14]
l16: $ G , H ⇒ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l10, l15]
l17: $ G , H ⇒ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l9, l16]
l18: $ G , H ⇒ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l8, l17]
l19: $ G , H ⇒ p7 ∧ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l7, l18]
l20: $ G , H ⇒ p6 ∧ p7 ∧ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l6, l19]
l21: $ G , H ⇒ p5 ∧ p6 ∧ p7 ∧ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l5, l20]
l22: $ G , H ⇒ p4 ∧ p5 ∧ p6 ∧ p7 ∧ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l4, l21]
l23: $ G , H ⇒ p3 ∧ p4 ∧ p5 ∧ p6 ∧ p7 ∧ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l3, l22]
l24: $ G , H ⇒ p2 ∧ p3 ∧ p4 ∧ p5 ∧ p6 ∧ p7 ∧ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l2, l23]
l25: $ G , H ⇒ p1 ∧ p2 ∧ p3 ∧ p4 ∧ p5 ∧ p6 ∧ p7 ∧ p8 ∧ p9 ∧ p10 ∧ p11 ∧ p12 ∧ p13 $ by and_intro [l1, l24]

--| An instance at the values of a set `x` is in the clause.
lemma j3_cl_gcd_eqs_i {x: set} (G: hyps x) (J X: class):
  $ G ⇒ X ∈ gi_gcd_eqs_i J (fv x ix0) (fv x ix1) (fv x ix2) (fv x ix3) (fv x ix4) (fv x ix5) (fv x ix6) (fv x ix7) (fv x ix8) (fv x ix9) (fv x ix10) (fv x ix11) (fv x ix12) (fv x ix13) (fv x ix14) (fv x ix15) (fv x ix16) (fv x ix17) (fv x ix18) (fv x ix19) (fv x ix20) (fv x ix21) (fv x ix22) (fv x ix23) (fv x ix24) (fv x ix25) (fv x ix26) (fv x ix27) (fv x ix28) (fv x ix29) (fv x ix30) (fv x ix31) (fv x ix32) (fv x ix33) (fv x ix34) (fv x ix35) (fv x ix36) (fv x ix37) (fv x ix38) (fv x ix39) (fv x ix40) $ >
  $ G ⇒ X ∈ cl_gcd_eqs_i J $
----
l1: $ G ⇒ isset X $ by wcel_isset [#1]
l2: $ G , y = X ⇒ y = X $ by ax
l3: $ G , y = X ⇒ X = y $ by eq_sym [l2]
l4: $ G , y = X ⇒ X ∈ gi_gcd_eqs_i J (fv x ix0) (fv x ix1) (fv x ix2) (fv x ix3) (fv x ix4) (fv x ix5) (fv x ix6) (fv x ix7) (fv x ix8) (fv x ix9) (fv x ix10) (fv x ix11) (fv x ix12) (fv x ix13) (fv x ix14) (fv x ix15) (fv x ix16) (fv x ix17) (fv x ix18) (fv x ix19) (fv x ix20) (fv x ix21) (fv x ix22) (fv x ix23) (fv x ix24) (fv x ix25) (fv x ix26) (fv x ix27) (fv x ix28) (fv x ix29) (fv x ix30) (fv x ix31) (fv x ix32) (fv x ix33) (fv x ix34) (fv x ix35) (fv x ix36) (fv x ix37) (fv x ix38) (fv x ix39) (fv x ix40) $ by weaken [#1]
l5: $ G , y = X ⇒ y ∈ gi_gcd_eqs_i J (fv x ix0) (fv x ix1) (fv x ix2) (fv x ix3) (fv x ix4) (fv x ix5) (fv x ix6) (fv x ix7) (fv x ix8) (fv x ix9) (fv x ix10) (fv x ix11) (fv x ix12) (fv x ix13) (fv x ix14) (fv x ix15) (fv x ix16) (fv x ix17) (fv x ix18) (fv x ix19) (fv x ix20) (fv x ix21) (fv x ix22) (fv x ix23) (fv x ix24) (fv x ix25) (fv x ix26) (fv x ix27) (fv x ix28) (fv x ix29) (fv x ix30) (fv x ix31) (fv x ix32) (fv x ix33) (fv x ix34) (fv x ix35) (fv x ix36) (fv x ix37) (fv x ix38) (fv x ix39) (fv x ix40) $ by wcel_eq_l [l3, l4]
l6: $ G , y = X ⇒ ∃ x (y ∈ gi_gcd_eqs_i J (fv x ix0) (fv x ix1) (fv x ix2) (fv x ix3) (fv x ix4) (fv x ix5) (fv x ix6) (fv x ix7) (fv x ix8) (fv x ix9) (fv x ix10) (fv x ix11) (fv x ix12) (fv x ix13) (fv x ix14) (fv x ix15) (fv x ix16) (fv x ix17) (fv x ix18) (fv x ix19) (fv x ix20) (fv x ix21) (fv x ix22) (fv x ix23) (fv x ix24) (fv x ix25) (fv x ix26) (fv x ix27) (fv x ix28) (fv x ix29) (fv x ix30) (fv x ix31) (fv x ix32) (fv x ix33) (fv x ix34) (fv x ix35) (fv x ix36) (fv x ix37) (fv x ix38) (fv x ix39) (fv x ix40)) $ by ex_intro [l5]
l7: $ G , y = X ⇒ y ∊ cl_gcd_eqs_i J $ by cab_intro [l6]
l8: $ G , y = X ⇒ X ∈ cl_gcd_eqs_i J $ by wcel_intro [l2, l7]
l9: $ G ⇒ X ∈ cl_gcd_eqs_i J $ by isset_elim [l1, l8]

lemma j3_in_l (G: hyps) (X A B: class): $ G ⇒ X ∈ A $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ A ⊆ A ∪ B $ by cun_subset_l
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

lemma j3_in_r (G: hyps) (X A B: class): $ G ⇒ X ∈ B $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ B ⊆ A ∪ B $ by cun_subset_r
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

--| The union of the program's clauses, before the restriction to atoms.
def j3_top (J: class): class = $ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $

lemma j3_pr_gcd_eqs (G: hyps) (J X: class): $ G ⇒ X ∈ pr_gcd_eqs J $ > $ G ⇒ X ∈ j3_top J $
----
l1: $ G ⇒ X ∈ (pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)) $ by j3_in_l [#1]
l2: $ G ⇒ X ∈ ((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J))) $ by j3_in_r [l1]
l3: $ G ⇒ X ∈ (((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))) $ by j3_in_r [l2]
l4: $ G ⇒ X ∈ ((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J))))) $ by j3_in_r [l3]
l5: $ G ⇒ X ∈ (((((pr_sty J) ∪ (pr_cwf J)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((pr_ctx_wf J) ∪ (pr_tys_ty J)) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((pr_fir J) ∪ pr_elim_ok)) ∪ (((pr_fprops J) ∪ pr_proj_ok) ∪ ((pr_add_eqs J) ∪ ((pr_pred_eqs J) ∪ (pr_sub_eqs J)))))) ∪ (((((pr_mul_eqs J) ∪ (pr_pow_eqs J)) ∪ ((pr_beq_eqs J) ∪ (pr_ble_eqs J))) ∪ (((pr_shl_eqs J) ∪ (pr_shr_eqs J)) ∪ ((pr_dec_eqs J) ∪ (pr_ite_eqs J)))) ∪ ((((pr_natle_dec J) ∪ (pr_nateq_dec J)) ∪ ((pr_bool_dec J) ∪ (pr_div_eqs J))) ∪ (((pr_mod_eqs J) ∪ (pr_fix_eqs J)) ∪ ((pr_gcd_eqs J) ∪ ((pr_bitwise_eqs J) ∪ (pr_bitop_eqs J)))))) $ by j3_in_r [l4]

