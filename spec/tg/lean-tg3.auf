lemma j2_o_pred_eqs (G: hyps) (J: class) {G_v p_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_pred_eqs t1 t2 ⟩ ∈ pr_pred_eqs J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
