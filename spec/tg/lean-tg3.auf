l54: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅)))))) $ by and_elim_r [l52]
l55: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅))))) $ by j2_scons_inj [l54, l34, l19, l33, l43]
l56: $ G ⇒ t2 = V2 $ by and_elim_l [l55]
l57: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅))))) $ by and_elim_r [l55]
l58: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))) = scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅)))) $ by j2_scons_inj [l57, l32, l18, l31, l42]
