l11: $ G ⇒ pp = scons (ra_mul_eqs V1 V3 V4) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_shl_eqs t1 t2 t3 t4 = ra_shl_eqs V1 V2 V3 V4 $ by and_elim_r [l10]
