l7: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A2 = ra_closed ⟨ kc_nz , ∅ ⟩ z $ by eq_sym [l6]
l8: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ z ∈ lrel $ by wcel_eq_l [l7, l4]
l9: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_deq A1 A2 A2 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J $ by weaken [#6]
l10: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ = ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ $ by eq_refl
l11: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ = ra_deq A1 A2 A2 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ $ by ra_deq_eq [l1, l2, l2, l10]
l12: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_deq A1 A2 A2 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ = ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ $ by eq_sym [l11]
l13: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_deq y z z ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J $ by wcel_eq_l [l12, l9]
l14: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons A1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons A2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J $ by weaken [#7]
l15: $ G , y = A1 , z = A2 , u = A3 ⇒ kc_cons = kc_cons $ by eq_refl
l16: $ G , y = A1 , z = A2 , u = A3 ⇒ tr_nat_ty = tr_nat_ty $ by eq_refl
l17: $ G , y = A1 , z = A2 , u = A3 ⇒ ∅ = ∅ $ by eq_refl
l18: $ G , y = A1 , z = A2 , u = A3 ⇒ scons y ∅ = scons A1 ∅ $ by scons_eq [l1, l17]
l19: $ G , y = A1 , z = A2 , u = A3 ⇒ scons tr_nat_ty (scons y ∅) = scons tr_nat_ty (scons A1 ∅) $ by scons_eq [l16, l18]
l20: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ kc_cons , scons tr_nat_ty (scons y ∅) ⟩ = ⟨ kc_cons , scons tr_nat_ty (scons A1 ∅) ⟩ $ by opair_eq [l15, l19]
l21: $ G , y = A1 , z = A2 , u = A3 ⇒ kc_app = kc_app $ by eq_refl
l22: $ G , y = A1 , z = A2 , u = A3 ⇒ scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ = scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ $ by eq_refl
l23: $ G , y = A1 , z = A2 , u = A3 ⇒ scons z (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) = scons A2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) $ by scons_eq [l2, l22]
l24: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ = ⟨ kc_app , scons A2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ $ by opair_eq [l21, l23]
l25: $ G , y = A1 , z = A2 , u = A3 ⇒ scons tr_nat_zero ∅ = scons tr_nat_zero ∅ $ by eq_refl
l26: $ G , y = A1 , z = A2 , u = A3 ⇒ scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) = scons ⟨ kc_app , scons A2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) $ by scons_eq [l24, l25]
l27: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ kc_app , scons ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ = ⟨ kc_app , scons ⟨ kc_app , scons A2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ $ by opair_eq [l21, l26]
