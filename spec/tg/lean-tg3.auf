l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 ⇒ f = A9 $ by ax
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 ⇒ ra_ind_data A2 A3 A4 A5 ∈ lrel $ by weaken [#10]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 ⇒ ra_ind_data z u v w = ra_ind_data A2 A3 A4 A5 $ by ra_ind_data_eq [l2, l3, l4, l5]
l12: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 ⇒ ra_ind_data A2 A3 A4 A5 = ra_ind_data z u v w $ by eq_sym [l11]
l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 , a = A6 , b = A7 , c = A8 , f = A9 ⇒ ra_ind_data z u v w ∈ lrel $ by wcel_eq_l [l12, l10]
