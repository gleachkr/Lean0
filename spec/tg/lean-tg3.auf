l29: $ _ ⇒ ra_deq (enc_ctx Ctx) (enc_expr A2) (enc_expr A2) ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by wcel_eq_l [l28, #3]
l30: $ _ ⇒ ra_fprops (enc_ind D) (enc_nat n) (enc_nat np) (enc_ctx Ctx) (enc_nat d) ⟨ kc_s , scons (enc_nat cnt) ∅ ⟩ ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ ∈ lrel3 J $ by lrel3_fprops_s [l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l19, #1, l25, l29]
