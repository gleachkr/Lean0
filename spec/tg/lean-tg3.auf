lemma j1_pr_ctx_wf (G: hyps) (J X: class): $ G ⇒ X ∈ pr_ctx_wf J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ pr_tys_wf ∪ (pr_ctx_wf J) $ by j1_in_r [#1]
l2: $ G ⇒ X ∈ (pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok) $ by j1_in_l [l1]
l3: $ G ⇒ X ∈ ((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok)) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ (((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J)))) $ by j1_in_l [l3]
l5: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_l [l4]

lemma j1_ra_ctx_wf (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_ctx_wf A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_ctx_wf ∈ ω $ by kr_ctx_wf_omega
l5: $ G ⇒ ra_ctx_wf A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

lrel3_ctx_wf_nil
----------------
l1: $ G , y = A1 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l3: $ G , y = A1 , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ y (x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩) $ by ex_intro [l2]
l4: $ G , y = A1 , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ cl_ctx_wf_nil $ by cab_intro [l3]
l5: $ G , y = A1 , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil $ by wcel_intro [l2, l4]
l6: $ G , y = A1 ⇒ isset ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ $ by opair_isset
l7: $ G , y = A1 ⇒ ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil $ by isset_elim [l6, l5]
l8: $ G , y = A1 ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , y = A1 ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_nil , ∅ ⟩ $ by eq_refl
l10: $ G , y = A1 ⇒ ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ = ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ $ by ra_ctx_wf_eq [l1, l9]
l11: $ G , y = A1 ⇒ ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ $ by opair_eq [l8, l10]
l12: $ G , y = A1 ⇒ ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil $ by wcel_eq_l [l11, l7]
l13: $ G ⇒ isset A1 $ by wcel_isset [#1]
l14: $ G ⇒ ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil $ by isset_elim [l13, l12]
l15: $ G ⇒ ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) $ by j1_in_l [l14]
l16: $ G ⇒ ⟨ ∅ , ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ⟩ ∈ j1_top J $ by j1_pr_ctx_wf [l15]
l17: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l18: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l19: $ G ⇒ isset ω $ by omega_set
l20: $ G ⇒ kc_nil ∈ ω $ by kc_nil_omega
l21: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l22: $ G ⇒ ⟨ kc_nil , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l19, l20, l21]
l23: $ G ⇒ ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ∈ latoms $ by j1_ra_ctx_wf [#1, l22]
l24: $ G ⇒ ra_ctx_wf A1 ⟨ kc_nil , ∅ ⟩ ∈ lrel3 J $ by j1_horn [l16, l17, l23, l18]

lrel3_ctx_wf_cons
-----------------
l1: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ v = A4 $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ w = A5 $ by ax
l6: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_capp A2 A1 A3 ∈ lrel $ by weaken [#7]
l7: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_capp z y u = ra_capp A2 A1 A3 $ by ra_capp_eq [l2, l1, l3]
l8: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_capp A2 A1 A3 = ra_capp z y u $ by eq_sym [l7]
l9: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_capp z y u ∈ lrel $ by wcel_eq_l [l8, l6]
l10: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_deq A3 A4 A4 ⟨ kc_srt , scons A5 ∅ ⟩ ∈ J $ by weaken [#8]
l11: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ kc_srt = kc_srt $ by eq_refl
