l70: $ G ⇒ isset A4 $ by wcel_isset [#4]
l71: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅) , ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ⟩ ∈ cl_tys_wf_cons $ by isset_elim [l70, l69]
l72: $ G ⇒ isset A3 $ by wcel_isset [#3]
l73: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅) , ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ⟩ ∈ cl_tys_wf_cons $ by isset_elim [l72, l71]
l74: $ G ⇒ isset A2 $ by wcel_isset [#2]
l75: $ G , y = A1 ⇒ ⟨ scons (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅) , ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ⟩ ∈ cl_tys_wf_cons $ by isset_elim [l74, l73]
l76: $ G ⇒ isset A1 $ by wcel_isset [#1]
l77: $ G ⇒ ⟨ scons (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅) , ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ⟩ ∈ cl_tys_wf_cons $ by isset_elim [l76, l75]
l78: $ G ⇒ ⟨ scons (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅) , ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ⟩ ∈ cl_tys_wf_nil ∪ cl_tys_wf_cons $ by j1_in_r [l77]
l79: $ G ⇒ ⟨ scons (ra_ctors_wf A1 A2 A3 A4 A6 A8 A10) (scons (ra_tys_wf A1 A2 A3 A4 ⟨ kc_s , scons A6 ∅ ⟩ A8 A11) ∅) , ra_tys_wf A1 A2 A3 A4 A6 A8 ⟨ kc_tcons , scons A9 (scons A10 (scons A11 ∅)) ⟩ ⟩ ∈ j1_top J $ by j1_pr_tys_wf [l78]
