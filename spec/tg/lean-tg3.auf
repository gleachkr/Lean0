l30: $ G ⇒ scons V4 (scons V5 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l29]
l31: $ G ⇒ scons V3 (scons V4 (scons V5 ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l30]
l32: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l31]
l33: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 ∅)))) ∈ fseq j2_vv $ by j2_fs [l17, l32]
