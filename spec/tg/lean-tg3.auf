-- The union of `lprog3 J` as a tree of defs (the root `j2_u0 J` is that union).

def j2_u4 (J: class): class = $ pr_cwf J ∪ (pr_ctors_wf) $

def j2_u3 (J: class): class = $ pr_sty J ∪ (j2_u4 J) $

def j2_u6 (J: class): class = $ pr_tys_wf ∪ (pr_ctx_wf J) $

def j2_u7 (J: class): class = $ pr_tys_ty J ∪ (pr_tys_ok) $

def j2_u5 (J: class): class = $ j2_u6 J ∪ (j2_u7 J) $

def j2_u2 (J: class): class = $ j2_u3 J ∪ (j2_u5 J) $

def j2_u10: class = $ pr_nst_ok ∪ (pr_nst_ty) $

def j2_u9: class = $ pr_ind_wf ∪ (j2_u10) $

def j2_u12 (J: class): class = $ pr_large ∪ (pr_fir J) $

def j2_u13 (J: class): class = $ pr_elim_ok ∪ (pr_fprops J) $

def j2_u11 (J: class): class = $ j2_u12 J ∪ (j2_u13 J) $

def j2_u8 (J: class): class = $ j2_u9 ∪ (j2_u11 J) $

def j2_u1 (J: class): class = $ j2_u2 J ∪ (j2_u8 J) $

def j2_u17 (J: class): class = $ pr_add_eqs J ∪ (pr_pred_eqs J) $

def j2_u16 (J: class): class = $ pr_proj_ok ∪ (j2_u17 J) $

def j2_u19 (J: class): class = $ pr_sub_eqs J ∪ (pr_mul_eqs J) $

def j2_u20 (J: class): class = $ pr_pow_eqs J ∪ (pr_beq_eqs J) $

def j2_u18 (J: class): class = $ j2_u19 J ∪ (j2_u20 J) $

def j2_u15 (J: class): class = $ j2_u16 J ∪ (j2_u18 J) $

def j2_u23 (J: class): class = $ pr_ble_eqs J ∪ (pr_shl_eqs J) $

def j2_u24 (J: class): class = $ pr_shr_eqs J ∪ (pr_divmod_eqs J) $

def j2_u22 (J: class): class = $ j2_u23 J ∪ (j2_u24 J) $

def j2_u26 (J: class): class = $ pr_gcd_eqs J ∪ (pr_land_eqs J) $

def j2_u27 (J: class): class = $ pr_lor_eqs J ∪ (pr_xor_eqs J) $

def j2_u25 (J: class): class = $ j2_u26 J ∪ (j2_u27 J) $

def j2_u21 (J: class): class = $ j2_u22 J ∪ (j2_u25 J) $

def j2_u14 (J: class): class = $ j2_u15 J ∪ (j2_u21 J) $

def j2_u0 (J: class): class = $ j2_u1 J ∪ (j2_u14 J) $

-- The label ranges of the subtrees: from the first to the last relation.

lemma j2_f4 (G: hyps): $ G ⇒ kr_cwf ⊆ kr_ctors_wf $
----
l1: $ G ⇒ kr_cwf ⊆ kr_cwf $ by subset_refl
l2: $ G ⇒ kr_cwf ⊆ kr_ctors_wf $ by suc_subset
l3: $ G ⇒ kr_ctors_wf ⊆ kr_ctors_wf $ by subset_refl
l4: $ G ⇒ kr_cwf ⊆ kr_ctors_wf $ by subset_trans [l2, l3]

lemma j2_f3 (G: hyps): $ G ⇒ kr_sty ⊆ kr_ctors_wf $
----
l1: $ G ⇒ kr_sty ⊆ kr_sty $ by subset_refl
l2: $ G ⇒ kr_sty ⊆ kr_cwf $ by suc_subset
l3: $ G ⇒ kr_cwf ⊆ kr_ctors_wf $ by j2_f4
l4: $ G ⇒ kr_sty ⊆ kr_ctors_wf $ by subset_trans [l2, l3]

lemma j2_f6 (G: hyps): $ G ⇒ kr_tys_wf ⊆ kr_ctx_wf $
----
l1: $ G ⇒ kr_tys_wf ⊆ kr_tys_wf $ by subset_refl
l2: $ G ⇒ kr_tys_wf ⊆ kr_ctx_wf $ by suc_subset
l3: $ G ⇒ kr_ctx_wf ⊆ kr_ctx_wf $ by subset_refl
l4: $ G ⇒ kr_tys_wf ⊆ kr_ctx_wf $ by subset_trans [l2, l3]

lemma j2_f7 (G: hyps): $ G ⇒ kr_tys_ty ⊆ kr_tys_ok $
----
l1: $ G ⇒ kr_tys_ty ⊆ kr_tys_ty $ by subset_refl
l2: $ G ⇒ kr_tys_ty ⊆ kr_tys_ok $ by suc_subset
l3: $ G ⇒ kr_tys_ok ⊆ kr_tys_ok $ by subset_refl
l4: $ G ⇒ kr_tys_ty ⊆ kr_tys_ok $ by subset_trans [l2, l3]

lemma j2_f5 (G: hyps): $ G ⇒ kr_tys_wf ⊆ kr_tys_ok $
----
l1: $ G ⇒ kr_tys_wf ⊆ kr_ctx_wf $ by j2_f6
l2: $ G ⇒ kr_ctx_wf ⊆ kr_tys_ty $ by suc_subset
l3: $ G ⇒ kr_tys_ty ⊆ kr_tys_ok $ by j2_f7
l4: $ G ⇒ kr_tys_wf ⊆ kr_tys_ty $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_tys_wf ⊆ kr_tys_ok $ by subset_trans [l4, l3]

lemma j2_f2 (G: hyps): $ G ⇒ kr_sty ⊆ kr_tys_ok $
----
l1: $ G ⇒ kr_sty ⊆ kr_ctors_wf $ by j2_f3
l2: $ G ⇒ kr_ctors_wf ⊆ kr_tys_wf $ by suc_subset
l3: $ G ⇒ kr_tys_wf ⊆ kr_tys_ok $ by j2_f5
l4: $ G ⇒ kr_sty ⊆ kr_tys_wf $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_sty ⊆ kr_tys_ok $ by subset_trans [l4, l3]

lemma j2_f10 (G: hyps): $ G ⇒ kr_nst_ok ⊆ kr_nst_ty $
----
l1: $ G ⇒ kr_nst_ok ⊆ kr_nst_ok $ by subset_refl
l2: $ G ⇒ kr_nst_ok ⊆ kr_nst_ty $ by suc_subset
l3: $ G ⇒ kr_nst_ty ⊆ kr_nst_ty $ by subset_refl
l4: $ G ⇒ kr_nst_ok ⊆ kr_nst_ty $ by subset_trans [l2, l3]

lemma j2_f9 (G: hyps): $ G ⇒ kr_ind_wf ⊆ kr_nst_ty $
----
l1: $ G ⇒ kr_ind_wf ⊆ kr_ind_wf $ by subset_refl
l2: $ G ⇒ kr_ind_wf ⊆ kr_nst_ok $ by suc_subset
l3: $ G ⇒ kr_nst_ok ⊆ kr_nst_ty $ by j2_f10
l4: $ G ⇒ kr_ind_wf ⊆ kr_nst_ty $ by subset_trans [l2, l3]

lemma j2_f12 (G: hyps): $ G ⇒ kr_large ⊆ kr_fir $
----
l1: $ G ⇒ kr_large ⊆ kr_large $ by subset_refl
l2: $ G ⇒ kr_large ⊆ kr_fir $ by suc_subset
l3: $ G ⇒ kr_fir ⊆ kr_fir $ by subset_refl
l4: $ G ⇒ kr_large ⊆ kr_fir $ by subset_trans [l2, l3]

lemma j2_f13 (G: hyps): $ G ⇒ kr_elim_ok ⊆ kr_fprops $
----
l1: $ G ⇒ kr_elim_ok ⊆ kr_elim_ok $ by subset_refl
l2: $ G ⇒ kr_elim_ok ⊆ kr_fprops $ by suc_subset
l3: $ G ⇒ kr_fprops ⊆ kr_fprops $ by subset_refl
l4: $ G ⇒ kr_elim_ok ⊆ kr_fprops $ by subset_trans [l2, l3]

lemma j2_f11 (G: hyps): $ G ⇒ kr_large ⊆ kr_fprops $
----
l1: $ G ⇒ kr_large ⊆ kr_fir $ by j2_f12
l2: $ G ⇒ kr_fir ⊆ kr_elim_ok $ by suc_subset
l3: $ G ⇒ kr_elim_ok ⊆ kr_fprops $ by j2_f13
l4: $ G ⇒ kr_large ⊆ kr_elim_ok $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_large ⊆ kr_fprops $ by subset_trans [l4, l3]

lemma j2_f8 (G: hyps): $ G ⇒ kr_ind_wf ⊆ kr_fprops $
----
l1: $ G ⇒ kr_ind_wf ⊆ kr_nst_ty $ by j2_f9
l2: $ G ⇒ kr_nst_ty ⊆ kr_large $ by suc_subset
l3: $ G ⇒ kr_large ⊆ kr_fprops $ by j2_f11
l4: $ G ⇒ kr_ind_wf ⊆ kr_large $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_ind_wf ⊆ kr_fprops $ by subset_trans [l4, l3]

lemma j2_f1 (G: hyps): $ G ⇒ kr_sty ⊆ kr_fprops $
----
l1: $ G ⇒ kr_sty ⊆ kr_tys_ok $ by j2_f2
l2: $ G ⇒ kr_tys_ok ⊆ kr_ind_wf $ by suc_subset
l3: $ G ⇒ kr_ind_wf ⊆ kr_fprops $ by j2_f8
l4: $ G ⇒ kr_sty ⊆ kr_ind_wf $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_sty ⊆ kr_fprops $ by subset_trans [l4, l3]

lemma j2_f17 (G: hyps): $ G ⇒ kr_add_eqs ⊆ kr_pred_eqs $
----
l1: $ G ⇒ kr_add_eqs ⊆ kr_add_eqs $ by subset_refl
l2: $ G ⇒ kr_add_eqs ⊆ kr_pred_eqs $ by suc_subset
l3: $ G ⇒ kr_pred_eqs ⊆ kr_pred_eqs $ by subset_refl
l4: $ G ⇒ kr_add_eqs ⊆ kr_pred_eqs $ by subset_trans [l2, l3]

lemma j2_f16 (G: hyps): $ G ⇒ kr_proj_ok ⊆ kr_pred_eqs $
----
l1: $ G ⇒ kr_proj_ok ⊆ kr_proj_ok $ by subset_refl
l2: $ G ⇒ kr_proj_ok ⊆ kr_add_eqs $ by suc_subset
l3: $ G ⇒ kr_add_eqs ⊆ kr_pred_eqs $ by j2_f17
l4: $ G ⇒ kr_proj_ok ⊆ kr_pred_eqs $ by subset_trans [l2, l3]

lemma j2_f19 (G: hyps): $ G ⇒ kr_sub_eqs ⊆ kr_mul_eqs $
----
l1: $ G ⇒ kr_sub_eqs ⊆ kr_sub_eqs $ by subset_refl
