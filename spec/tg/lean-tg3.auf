l65: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ cl_fir_prop J $ by isset_elim [l64, l63]
l66: $ G ⇒ isset A5 $ by wcel_isset [#5]
l67: $ G , y = A1 , z = A2 , u = A3 , v = A4 ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ cl_fir_prop J $ by isset_elim [l66, l65]
l68: $ G ⇒ isset A4 $ by wcel_isset [#4]
l69: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ cl_fir_prop J $ by isset_elim [l68, l67]
l70: $ G ⇒ isset A3 $ by wcel_isset [#3]
l71: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ cl_fir_prop J $ by isset_elim [l70, l69]
l72: $ G ⇒ isset A2 $ by wcel_isset [#2]
l73: $ G , y = A1 ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ cl_fir_prop J $ by isset_elim [l72, l71]
l74: $ G ⇒ isset A1 $ by wcel_isset [#1]
l75: $ G ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ cl_fir_prop J $ by isset_elim [l74, l73]
l76: $ G ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) $ by j1_in_r [l75]
l77: $ G ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J)) $ by j1_in_r [l76]
l78: $ G ⇒ ⟨ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ , ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ⟩ ∈ j1_top J $ by j1_pr_fir [l77]
l79: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l80: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l81: $ G ⇒ (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∈ latoms $ by j1_lrel3_lat [#9]
l82: $ G ⇒ scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅ ∈ fseq latoms $ by scons_fseq_c [l81, l79]
l83: $ G ⇒ crn (scons (ra_fir A1 A2 ⟨ kc_cons , scons A7 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A8) ∅) ⊆ lrel3 J $ by crn_scons_sub [#9, l80]
l84: $ G ⇒ isset ω $ by omega_set
l85: $ G ⇒ kc_pi ∈ ω $ by kc_pi_omega
l86: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l87: $ G ⇒ scons A8 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#8, l86]
l88: $ G ⇒ scons A6 (scons A8 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#6, l87]
l89: $ G ⇒ ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ∈ trees ω $ by trees_intro_c [l84, l85, l88]
l90: $ G ⇒ ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ∈ latoms $ by j1_ra_fir [#1, #2, #3, #4, l89]
l91: $ G ⇒ ra_fir A1 A2 A3 A4 ⟨ kc_pi , scons A6 (scons A8 ∅) ⟩ ∈ lrel3 J $ by j1_horn [l78, l82, l90, l83]

lemma j1_pr_elim_ok (G: hyps) (J X: class): $ G ⇒ X ∈ pr_elim_ok $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ pr_elim_ok ∪ (pr_fprops J) $ by j1_in_l [#1]
l2: $ G ⇒ X ∈ (pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J)) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ (((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J)))) $ by j1_in_r [l3]
l5: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_l [l4]

lemma j1_ra_elim_ok (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_elim_ok A1 A2 A3 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A3 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#3, l1]
l3: $ G ⇒ scons A2 (scons A3 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#2, l2]
l4: $ G ⇒ scons A1 (scons A2 (scons A3 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#1, l3]
l5: $ G ⇒ kr_elim_ok ∈ ω $ by kr_elim_ok_omega
l6: $ G ⇒ ra_elim_ok A1 A2 A3 ∈ latoms $ by cxp_intro_c [l5, l4]

lrel3_elim_prop
---------------
l1: $ G , y = A1 , z = A2 , u = A3 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 ⇒ lveq A3 ⟨ kc_lz , ∅ ⟩ $ by weaken [#4]
l5: $ G , y = A1 , z = A2 , u = A3 ⇒ A3 = u $ by eq_sym [l3]
l6: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ kc_lz , ∅ ⟩ = ⟨ kc_lz , ∅ ⟩ $ by eq_refl
l7: $ G , y = A1 , z = A2 , u = A3 ⇒ lveq u ⟨ kc_lz , ∅ ⟩ $ by lveq_eq [l5, l6, l4]
l8: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ⇒ x = ⟨ ∅ , ra_elim_ok y z u ⟩ $ by ax
l9: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ⇒ lveq u ⟨ kc_lz , ∅ ⟩ $ by weaken [l7]
l10: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ⇒ x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩ $ by and_intro [l8, l9]
l11: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ⇒ ∃ u (x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l10]
l12: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l11]
l13: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_elim_ok y z u ⟩ ∧ lveq u ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l12]
l14: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ⇒ x ∊ cl_elim_prop $ by cab_intro [l13]
l15: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ ∅ , ra_elim_ok y z u ⟩ ⇒ ⟨ ∅ , ra_elim_ok y z u ⟩ ∈ cl_elim_prop $ by wcel_intro [l8, l14]
l16: $ G , y = A1 , z = A2 , u = A3 ⇒ isset ⟨ ∅ , ra_elim_ok y z u ⟩ $ by opair_isset
l17: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_elim_ok y z u ⟩ ∈ cl_elim_prop $ by isset_elim [l16, l15]
l18: $ G , y = A1 , z = A2 , u = A3 ⇒ ∅ = ∅ $ by eq_refl
l19: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_elim_ok y z u = ra_elim_ok A1 A2 A3 $ by ra_elim_ok_eq [l1, l2, l3]
l20: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_elim_ok y z u ⟩ = ⟨ ∅ , ra_elim_ok A1 A2 A3 ⟩ $ by opair_eq [l18, l19]
l21: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_prop $ by wcel_eq_l [l20, l17]
l22: $ G ⇒ isset A3 $ by wcel_isset [#3]
l23: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_prop $ by isset_elim [l22, l21]
l24: $ G ⇒ isset A2 $ by wcel_isset [#2]
l25: $ G , y = A1 ⇒ ⟨ ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_prop $ by isset_elim [l24, l23]
l26: $ G ⇒ isset A1 $ by wcel_isset [#1]
l27: $ G ⇒ ⟨ ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_prop $ by isset_elim [l26, l25]
l28: $ G ⇒ ⟨ ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_prop ∪ cl_elim_large $ by j1_in_l [l27]
l29: $ G ⇒ ⟨ ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ j1_top J $ by j1_pr_elim_ok [l28]
l30: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l31: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l32: $ G ⇒ ra_elim_ok A1 A2 A3 ∈ latoms $ by j1_ra_elim_ok [#1, #2, #3]
l33: $ G ⇒ ra_elim_ok A1 A2 A3 ∈ lrel3 J $ by j1_horn [l29, l30, l32, l31]

lrel3_elim_large
----------------
l1: $ G , y = A1 , z = A2 , u = A3 ⇒ y = A1 $ by ax
l2: $ G , y = A1 , z = A2 , u = A3 ⇒ z = A2 $ by ax
l3: $ G , y = A1 , z = A2 , u = A3 ⇒ u = A3 $ by ax
l4: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ $ by ax
l5: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ ∃ u (x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩) $ by ex_intro [l4]
l6: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ ∃ z ∃ u (x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩) $ by ex_intro [l5]
l7: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩) $ by ex_intro [l6]
l8: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ x ∊ cl_elim_large $ by cab_intro [l7]
l9: $ G , y = A1 , z = A2 , u = A3 , x = ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ⇒ ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ∈ cl_elim_large $ by wcel_intro [l4, l8]
l10: $ G , y = A1 , z = A2 , u = A3 ⇒ isset ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ $ by opair_isset
l11: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ ∈ cl_elim_large $ by isset_elim [l10, l9]
l12: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_large y z = ra_large A1 A2 $ by ra_large_eq [l1, l2]
l13: $ G , y = A1 , z = A2 , u = A3 ⇒ ∅ = ∅ $ by eq_refl
l14: $ G , y = A1 , z = A2 , u = A3 ⇒ scons (ra_large y z) ∅ = scons (ra_large A1 A2) ∅ $ by scons_eq [l12, l13]
l15: $ G , y = A1 , z = A2 , u = A3 ⇒ ra_elim_ok y z u = ra_elim_ok A1 A2 A3 $ by ra_elim_ok_eq [l1, l2, l3]
l16: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_large y z) ∅ , ra_elim_ok y z u ⟩ = ⟨ scons (ra_large A1 A2) ∅ , ra_elim_ok A1 A2 A3 ⟩ $ by opair_eq [l14, l15]
l17: $ G , y = A1 , z = A2 , u = A3 ⇒ ⟨ scons (ra_large A1 A2) ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_large $ by wcel_eq_l [l16, l11]
l18: $ G ⇒ isset A3 $ by wcel_isset [#3]
l19: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_large A1 A2) ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_large $ by isset_elim [l18, l17]
l20: $ G ⇒ isset A2 $ by wcel_isset [#2]
l21: $ G , y = A1 ⇒ ⟨ scons (ra_large A1 A2) ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_large $ by isset_elim [l20, l19]
l22: $ G ⇒ isset A1 $ by wcel_isset [#1]
l23: $ G ⇒ ⟨ scons (ra_large A1 A2) ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_large $ by isset_elim [l22, l21]
l24: $ G ⇒ ⟨ scons (ra_large A1 A2) ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ cl_elim_prop ∪ cl_elim_large $ by j1_in_r [l23]
l25: $ G ⇒ ⟨ scons (ra_large A1 A2) ∅ , ra_elim_ok A1 A2 A3 ⟩ ∈ j1_top J $ by j1_pr_elim_ok [l24]
l26: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l27: $ G ⇒ crn ∅ ⊆ lrel3 J $ by crn_empty_sub
l28: $ G ⇒ (ra_large A1 A2) ∈ latoms $ by j1_lrel3_lat [#4]
l29: $ G ⇒ scons (ra_large A1 A2) ∅ ∈ fseq latoms $ by scons_fseq_c [l28, l26]
l30: $ G ⇒ crn (scons (ra_large A1 A2) ∅) ⊆ lrel3 J $ by crn_scons_sub [#4, l27]
l31: $ G ⇒ ra_elim_ok A1 A2 A3 ∈ latoms $ by j1_ra_elim_ok [#1, #2, #3]
l32: $ G ⇒ ra_elim_ok A1 A2 A3 ∈ lrel3 J $ by j1_horn [l25, l29, l31, l30]

lemma j1_pr_fprops (G: hyps) (J X: class): $ G ⇒ X ∈ pr_fprops J $ > $ G ⇒ X ∈ j1_top J $
----
l1: $ G ⇒ X ∈ pr_elim_ok ∪ (pr_fprops J) $ by j1_in_r [#1]
l2: $ G ⇒ X ∈ (pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J)) $ by j1_in_r [l1]
l3: $ G ⇒ X ∈ (pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))) $ by j1_in_r [l2]
l4: $ G ⇒ X ∈ (((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J)))) $ by j1_in_r [l3]
l5: $ G ⇒ X ∈ ((((pr_sty J) ∪ ((pr_cwf J) ∪ pr_ctors_wf)) ∪ ((pr_tys_wf ∪ (pr_ctx_wf J)) ∪ ((pr_tys_ty J) ∪ pr_tys_ok))) ∪ ((pr_ind_wf ∪ (pr_nst_ok ∪ pr_nst_ty)) ∪ ((pr_large ∪ (pr_fir J)) ∪ (pr_elim_ok ∪ (pr_fprops J))))) ∪ (((pr_proj_ok ∪ ((pr_add_eqs J) ∪ (pr_pred_eqs J))) ∪ (((pr_sub_eqs J) ∪ (pr_mul_eqs J)) ∪ ((pr_pow_eqs J) ∪ (pr_beq_eqs J)))) ∪ ((((pr_ble_eqs J) ∪ (pr_shl_eqs J)) ∪ ((pr_shr_eqs J) ∪ (pr_divmod_eqs J))) ∪ (((pr_gcd_eqs J) ∪ (pr_land_eqs J)) ∪ ((pr_lor_eqs J) ∪ (pr_xor_eqs J))))) $ by j1_in_l [l4]

lemma j1_ra_fprops (G: hyps) (A1 A2 A3 A4 A5 A6 A7: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ > $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ >
  $ G ⇒ ra_fprops A1 A2 A3 A4 A5 A6 A7 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A7 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [#7, l1]
l3: $ G ⇒ scons A6 (scons A7 ∅) ∈ fseq (trees ω) $ by scons_fseq_c [#6, l2]
l4: $ G ⇒ scons A5 (scons A6 (scons A7 ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [#5, l3]
