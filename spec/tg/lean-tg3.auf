l19: $ G ⇒ ∃ G_v ∃ f_v ∃ p_v (t1 = G_v ∧ t2 = f_v ∧ t3 = p_v ∧ ra_pred_eqs G_v p_v ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons p_v (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ tr_nat_ty ∈ J) $ by isset_elim [l1, l18]

lemma j2_e_mul_eqs_i (G: hyps) (J: class) {G_v f_v fa: set} (pp t1 t2 t3 x V1 V2 V3: set):
  $ G ⇒ x = ⟨ pp , ra_mul_eqs t1 t2 t3 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_add_eqs V1 V3) ∅ , ra_mul_eqs V1 V2 V3 ⟩ ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V2 ∈ lrel ∧ ra_deq V1 V2 V2 ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons V1 ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons V1 ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons V3 (scons ⟨ kc_app , scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ tr_nat_ty ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ f_v ∃ fa (t1 = G_v ∧ t2 = f_v ∧ t3 = fa ∧ ra_add_eqs G_v fa ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons tr_nat_zero ∅) ⟩ tr_nat_zero tr_nat_ty ∈ J ∧ ra_deq ⟨ kc_cons , scons tr_nat_ty (scons ⟨ kc_cons , scons tr_nat_ty (scons G_v ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_app , scons tr_nat_succ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟨ kc_app , scons ⟨ kc_app , scons fa (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ tr_nat_ty ∈ J) $
