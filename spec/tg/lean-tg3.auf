l8: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 $ by ax
l14: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ pr_tys_wf $ by lprog3_tys_wf_pr [l15]
l17: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ l2 ∃ i_v ∃ k_v ∃ Ctx ∃ F ∃ C ∃ T (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_isort F k_v l2 ∈ lrel ∧ lveq l2 l_v ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J ∧ ra_tys_wf D n_v np l_v ⟨ kc_s , scons i_v ∅ ⟩ Ctx T ∈ lrel3 J) $ by j2_o_tys_wf [l16, l11]
l18: $ G , c = ra_tys_wf t1 t2 t3 t4 t5 t6 t7 ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ l2 ∃ i_v ∃ k_v ∃ Ctx ∃ F ∃ C ∃ T (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_isort F k_v l2 ∈ lrel ∧ lveq l2 l_v ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J ∧ ra_tys_wf D n_v np l_v ⟨ kc_s , scons i_v ∅ ⟩ Ctx T ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ l_v ∃ i_v ∃ Ctx (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ D ∃ n_v ∃ np ∃ l_v ∃ l2 ∃ i_v ∃ k_v ∃ Ctx ∃ F ∃ C ∃ T (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = l_v ∧ t5 = i_v ∧ t6 = Ctx ∧ t7 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_isort F k_v l2 ∈ lrel ∧ lveq l2 l_v ∧ ra_ctors_wf D n_v np l_v i_v Ctx C ∈ lrel3 J ∧ ra_tys_wf D n_v np l_v ⟨ kc_s , scons i_v ∅ ⟩ Ctx T ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_ctx_wf_nil (G: hyps) (J: class) {G_v: set} (pp t1 t2 x V1: set):
  $ G ⇒ x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_ctx_wf V1 ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ = ⟨ ∅ , ra_ctx_wf V1 ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_ctx_wf V1 ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_ctx_wf t1 t2 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_ctx_wf t1 t2) $ by opair_isset
l7: $ G ⇒ isset (ra_ctx_wf V1 ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_ctx_wf t1 t2 = ra_ctx_wf V1 ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_ctx_wf t1 t2 = ra_ctx_wf V1 ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l8]
l11: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l12: $ G ⇒ isset V1 $ by isset_var
l13: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l11, l13]
l19: $ G ⇒ scons V1 (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l12, l18]
l20: $ G ⇒ kr_ctx_wf ∈ ω $ by kr_ctx_wf_omega
l21: $ G ⇒ isset kr_ctx_wf $ by wcel_isset [l20]
l22: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l17]
l23: $ G ⇒ isset (scons V1 (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by wcel_isset [l19]
l24: $ G ⇒ kr_ctx_wf = kr_ctx_wf ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by opair_inj_c [l10, l21, l22, l21, l23]
l25: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by and_elim_r [l24]
l26: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by j2_scons_inj [l25, l16, l12, l15, l18]
l27: $ G ⇒ t1 = V1 $ by and_elim_l [l26]
l28: $ G ⇒ scons t2 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by and_elim_r [l26]
l29: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l28, l14, l11, l13, l13]
l30: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l29]
l31: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l27, l30]
l32: $ G ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l31]

lemma j2_d_ctx_wf_nil (G: hyps) (J: class) {G_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x ∊ cl_ctx_wf_nil ⇒ x ∊ cl_ctx_wf_nil $ by ax
l2: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x ∊ cl_ctx_wf_nil ⇒ ∃ y (x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x = ⟨ ∅ , ra_ctx_wf y ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by j2_e_ctx_wf_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x ∊ cl_ctx_wf_nil ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l2, l6]
l8: $ G ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma j2_e_ctx_wf_cons (G: hyps) (J: class) {G_v P G2 A u_v: set} (pp t1 t2 x V1 V2 V3 V4 V5: set):
  $ G ⇒ x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_ctx_wf V1 V2) ∅ , ra_ctx_wf V1 ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ⟩ ∧ ra_capp V2 V1 V3 ∈ lrel ∧ ra_deq V3 V4 V4 ⟨ kc_srt , scons V5 ∅ ⟩ ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_ctx_wf V1 V2) ∅ , ra_ctx_wf V1 ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_capp V2 V1 V3 ∈ lrel ∧ ra_deq V3 V4 V4 ⟨ kc_srt , scons V5 ∅ ⟩ ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ = ⟨ scons (ra_ctx_wf V1 V2) ∅ , ra_ctx_wf V1 ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_ctx_wf V1 V2) ∅ , ra_ctx_wf V1 ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ⟩ = ⟨ pp , ra_ctx_wf t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_ctx_wf V1 V2) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_ctx_wf t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_ctx_wf V1 ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_ctx_wf V1 V2) ∅ ∧ ra_ctx_wf t1 t2 = ra_ctx_wf V1 ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_ctx_wf V1 V2) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_ctx_wf t1 t2 = ra_ctx_wf V1 ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ $ by and_elim_r [l10]
l13: $ G ⇒ isset ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ $ by opair_isset
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_ctx_wf ∈ ω $ by kr_ctx_wf_omega
l23: $ G ⇒ isset kr_ctx_wf $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_ctx_wf = kr_ctx_wf ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ crn pp = crn (scons (ra_ctx_wf V1 V2) ∅) $ by crn_eq [l11]
l34: $ G ⇒ crn (scons (ra_ctx_wf V1 V2) ∅) ⊆ lrel3 J $ by subset_eq_l [l33, #3]
l35: $ G ⇒ isset (ra_ctx_wf V1 V2) $ by opair_isset
l36: $ G ⇒ ra_ctx_wf V1 V2 ∈ lrel3 J $ by crn_scons_head [l35, l34]
l37: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_cons , scons V4 (scons V2 ∅) ⟩ ∧ ra_ctx_wf V1 V2 ∈ lrel3 J ∧ ra_capp V2 V1 V3 ∈ lrel ∧ ra_deq V3 V4 V4 ⟨ kc_srt , scons V5 ∅ ⟩ ∈ J $ by j2_and3 [l29, l32, l36, l2]
l38: $ G ⇒ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by j2_exi5 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, p := $ t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J $) [l37]

lemma j2_d_ctx_wf_cons (G: hyps) (J: class) {G_v P G2 A u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $
----
l1: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x ∊ cl_ctx_wf_cons J ⇒ x ∊ cl_ctx_wf_cons J $ by ax
l2: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x ∊ cl_ctx_wf_cons J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by ax
l5: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x = ⟨ scons (ra_ctx_wf y z) ∅ , ra_ctx_wf y ⟨ kc_cons , scons v (scons z ∅) ⟩ ⟩ ∧ ra_capp z y u ∈ lrel ∧ ra_deq u v v ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by j2_e_ctx_wf_cons [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_ctx_wf t1 t2 ⟩ , x ∊ cl_ctx_wf_cons J ⇒ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by j2_ex5 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by wcel_elim [#1, l7]

lemma j2_o_ctx_wf (G: hyps) (J: class) {G_v P G2 A u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ pr_ctx_wf J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $
----
l1: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J $ by ax
l2: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J ⇒ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by j2_d_ctx_wf_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J → ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) $ by ax
l6: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∨ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil $ by ax
l8: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l9: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by j2_d_ctx_wf_nil [l7, l8]
l10: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J $ by ax
l12: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J → ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J ⇒ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_cons J ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ctx_wf t1 t2 ⟩ ∈ cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J) → ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by imp_intro [l15]
l17: $ G ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by imp_elim [l16, #1]

lrel3_ctx_wf_cases
------------------
l1: $ G ⇒ isset (ra_ctx_wf t1 t2) $ by opair_isset
l2: $ G , c = ra_ctx_wf t1 t2 ⇒ c = ra_ctx_wf t1 t2 $ by ax
l3: $ G , c = ra_ctx_wf t1 t2 ⇒ ra_ctx_wf t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_ctx_wf t1 t2 ⇒ ra_ctx_wf t1 t2 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_ctx_wf t1 t2 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_ctx_wf t1 t2 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_ctx_wf t1 t2 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_ctx_wf t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_ctx_wf t1 t2 $ by ax
l14: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_ctx_wf t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ctx_wf t1 t2 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_ctx_wf t1 t2 ⟩ ∈ pr_ctx_wf J $ by lprog3_ctx_wf_pr [l15]
l17: $ G , c = ra_ctx_wf t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by j2_o_ctx_wf [l16, l11]
l18: $ G , c = ra_ctx_wf t1 t2 ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v (t1 = G_v ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ P ∃ G2 ∃ A ∃ u_v (t1 = G_v ∧ t2 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_deq G2 A A ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J) $ by isset_elim [l1, l18]

lemma j2_e_tys_ty_nil (G: hyps) (J: class) {Ctx: set} (pp t1 t2 x V1: set):
  $ G ⇒ x = ⟨ pp , ra_tys_ty t1 t2 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_tys_ty V1 ⟨ kc_tnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ = x $ by eq_sym [#1]
l2: $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ = ⟨ ∅ , ra_tys_ty V1 ⟨ kc_tnil , ∅ ⟩ ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ ⟨ ∅ , ra_tys_ty V1 ⟨ kc_tnil , ∅ ⟩ ⟩ = ⟨ pp , ra_tys_ty t1 t2 ⟩ $ by eq_sym [l2]
l4: $ G ⇒ isset (∅) $ by j2_opair_set_l [l3]
l5: $ G ⇒ isset pp $ by isset_var
l6: $ G ⇒ isset (ra_tys_ty t1 t2) $ by opair_isset
l7: $ G ⇒ isset (ra_tys_ty V1 ⟨ kc_tnil , ∅ ⟩) $ by opair_isset
l8: $ G ⇒ pp = ∅ ∧ ra_tys_ty t1 t2 = ra_tys_ty V1 ⟨ kc_tnil , ∅ ⟩ $ by opair_inj_c [l2, l5, l6, l4, l7]
l9: $ G ⇒ pp = ∅ $ by and_elim_l [l8]
l10: $ G ⇒ ra_tys_ty t1 t2 = ra_tys_ty V1 ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [l8]
l11: $ G ⇒ isset ⟨ kc_tnil , ∅ ⟩ $ by opair_isset
l12: $ G ⇒ isset V1 $ by isset_var
l13: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ scons ⟨ kc_tnil , ∅ ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l11, l13]
l19: $ G ⇒ scons V1 (scons ⟨ kc_tnil , ∅ ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l12, l18]
l20: $ G ⇒ kr_tys_ty ∈ ω $ by kr_tys_ty_omega
l21: $ G ⇒ isset kr_tys_ty $ by wcel_isset [l20]
l22: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l17]
l23: $ G ⇒ isset (scons V1 (scons ⟨ kc_tnil , ∅ ⟩ ∅)) $ by wcel_isset [l19]
l24: $ G ⇒ kr_tys_ty = kr_tys_ty ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_tnil , ∅ ⟩ ∅) $ by opair_inj_c [l10, l21, l22, l21, l23]
l25: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_tnil , ∅ ⟩ ∅) $ by and_elim_r [l24]
l26: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_tnil , ∅ ⟩ ∅ $ by j2_scons_inj [l25, l16, l12, l15, l18]
l27: $ G ⇒ t1 = V1 $ by and_elim_l [l26]
l28: $ G ⇒ scons t2 ∅ = scons ⟨ kc_tnil , ∅ ⟩ ∅ $ by and_elim_r [l26]
l29: $ G ⇒ t2 = ⟨ kc_tnil , ∅ ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l28, l14, l11, l13, l13]
l30: $ G ⇒ t2 = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l29]
l31: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_tnil , ∅ ⟩ $ by and_intro [l27, l30]
l32: $ G ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by ex_intro [l31]

lemma j2_d_tys_ty_nil (G: hyps) (J: class) {Ctx: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x ∊ cl_tys_ty_nil ⇒ x ∊ cl_tys_ty_nil $ by ax
l2: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x ∊ cl_tys_ty_nil ⇒ ∃ y (x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_tys_ty t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ $ by ax
l5: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_ty y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by j2_e_tys_ty_nil [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x ∊ cl_tys_ty_nil ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by ex_elim [l2, l6]
l8: $ G ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma j2_e_tys_ty_cons (G: hyps) (J: class) {Ctx F C T u_v: set} (pp t1 t2 x V1 V2 V3 V4 V5: set):
  $ G ⇒ x = ⟨ pp , ra_tys_ty t1 t2 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_tys_ty V1 V4) ∅ , ra_tys_ty V1 ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ ∧ ra_deq V1 V2 V2 ⟨ kc_srt , scons V5 ∅ ⟩ ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_tys_ty V1 V4) ∅ , ra_tys_ty V1 ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_deq V1 V2 V2 ⟨ kc_srt , scons V5 ∅ ⟩ ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ = ⟨ scons (ra_tys_ty V1 V4) ∅ , ra_tys_ty V1 ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_tys_ty V1 V4) ∅ , ra_tys_ty V1 ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ = ⟨ pp , ra_tys_ty t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_tys_ty V1 V4) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_tys_ty t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_tys_ty V1 ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_tys_ty V1 V4) ∅ ∧ ra_tys_ty t1 t2 = ra_tys_ty V1 ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_tys_ty V1 V4) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_tys_ty t1 t2 = ra_tys_ty V1 ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_r [l10]
l13: $ G ⇒ isset ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_tys_ty ∈ ω $ by kr_tys_ty_omega
l23: $ G ⇒ isset kr_tys_ty $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_tys_ty = kr_tys_ty ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ crn pp = crn (scons (ra_tys_ty V1 V4) ∅) $ by crn_eq [l11]
l34: $ G ⇒ crn (scons (ra_tys_ty V1 V4) ∅) ⊆ lrel3 J $ by subset_eq_l [l33, #3]
l35: $ G ⇒ isset (ra_tys_ty V1 V4) $ by opair_isset
l36: $ G ⇒ ra_tys_ty V1 V4 ∈ lrel3 J $ by crn_scons_head [l35, l34]
l37: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_tcons , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_deq V1 V2 V2 ⟨ kc_srt , scons V5 ∅ ⟩ ∈ J ∧ ra_tys_ty V1 V4 ∈ lrel3 J $ by j2_and3 [l29, l32, l2, l36]
l38: $ G ⇒ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by j2_exi5 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, p := $ t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J $) [l37]

lemma j2_d_tys_ty_cons (G: hyps) (J: class) {Ctx F C T u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x ∊ cl_tys_ty_cons J ⇒ x ∊ cl_tys_ty_cons J $ by ax
l2: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x ∊ cl_tys_ty_cons J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_tys_ty y v) ∅ , ra_tys_ty y ⟨ kc_tcons , scons z (scons u (scons v ∅)) ⟩ ⟩ ∧ ra_deq y z z ⟨ kc_srt , scons w ∅ ⟩ ∈ J) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x = ⟨ scons (ra_tys_ty y v) ∅ , ra_tys_ty y ⟨ kc_tcons , scons z (scons u (scons v ∅)) ⟩ ⟩ ∧ ra_deq y z z ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ x = ⟨ pp , ra_tys_ty t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x = ⟨ scons (ra_tys_ty y v) ∅ , ra_tys_ty y ⟨ kc_tcons , scons z (scons u (scons v ∅)) ⟩ ⟩ ∧ ra_deq y z z ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ x = ⟨ scons (ra_tys_ty y v) ∅ , ra_tys_ty y ⟨ kc_tcons , scons z (scons u (scons v ∅)) ⟩ ⟩ ∧ ra_deq y z z ⟨ kc_srt , scons w ∅ ⟩ ∈ J $ by ax
l5: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x = ⟨ scons (ra_tys_ty y v) ∅ , ra_tys_ty y ⟨ kc_tcons , scons z (scons u (scons v ∅)) ⟩ ⟩ ∧ ra_deq y z z ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x = ⟨ scons (ra_tys_ty y v) ∅ , ra_tys_ty y ⟨ kc_tcons , scons z (scons u (scons v ∅)) ⟩ ⟩ ∧ ra_deq y z z ⟨ kc_srt , scons w ∅ ⟩ ∈ J ⇒ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by j2_e_tys_ty_cons [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_tys_ty t1 t2 ⟩ , x ∊ cl_tys_ty_cons J ⇒ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by j2_ex5 [l2, l6]
l8: $ G ⇒ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_tys_ty (G: hyps) (J: class) {Ctx F C T u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ pr_tys_ty J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J $ by ax
l2: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J ⇒ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by j2_d_tys_ty_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J → ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) $ by ax
l6: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∨ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil $ by ax
l8: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l9: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by j2_d_tys_ty_nil [l7, l8]
l10: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J $ by ax
l12: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J → ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J ⇒ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_cons J ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_tys_ty t1 t2 ⟩ ∈ cl_tys_ty_nil ∪ (cl_tys_ty_cons J) → ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by imp_intro [l15]
l17: $ G ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by imp_elim [l16, #1]

lrel3_tys_ty_cases
------------------
l1: $ G ⇒ isset (ra_tys_ty t1 t2) $ by opair_isset
l2: $ G , c = ra_tys_ty t1 t2 ⇒ c = ra_tys_ty t1 t2 $ by ax
l3: $ G , c = ra_tys_ty t1 t2 ⇒ ra_tys_ty t1 t2 = c $ by eq_sym [l2]
l4: $ G , c = ra_tys_ty t1 t2 ⇒ ra_tys_ty t1 t2 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_tys_ty t1 t2 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_tys_ty t1 t2 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_tys_ty t1 t2 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_tys_ty t1 t2 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_tys_ty t1 t2 $ by ax
l14: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_tys_ty t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_tys_ty t1 t2 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_tys_ty t1 t2 ⟩ ∈ pr_tys_ty J $ by lprog3_tys_ty_pr [l15]
l17: $ G , c = ra_tys_ty t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by j2_o_tys_ty [l16, l11]
l18: $ G , c = ra_tys_ty t1 t2 ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ Ctx (t1 = Ctx ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ Ctx ∃ F ∃ C ∃ T ∃ u_v (t1 = Ctx ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_deq Ctx F F ⟨ kc_srt , scons u_v ∅ ⟩ ∈ J ∧ ra_tys_ty Ctx T ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_tys_ok_i (G: hyps) (J: class) {G_v G2 D b_v P T: set} (pp t1 t2 x V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ x = ⟨ pp , ra_tys_ok t1 t2 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅) , ra_tys_ok V1 V3 ⟩ ∧ ra_ind_data V3 V4 V5 V6 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_ctx_wf V1 V5) (scons (ra_tys_ty V2 V6) ∅) , ra_tys_ok V1 V3 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V3 V4 V5 V6 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_tys_ok t1 t2 ⟩ = x $ by eq_sym [#1]
