-- Each clause is in its relation's label range, hence so is each relation.

lemma j2_k_sty_nil (G: hyps): $ G ⇒ cl_sty_nil ⊆ j2_lab kr_sty (suc kr_sty) $
----
l1: $ G , x ∊ cl_sty_nil ⇒ x ∊ cl_sty_nil $ by ax
l2: $ G , x ∊ cl_sty_nil ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_sty y z u z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ x = ⟨ ∅ , ra_sty y z u z u ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ kr_sty ∈ ω $ by kr_sty_omega
l5: $ G , x = ⟨ ∅ , ra_sty y z u z u ⟩ ⇒ x ∊ j2_lab kr_sty (suc kr_sty) $ by j2_lab_self [l3, l4]
l6: $ G , x ∊ cl_sty_nil ⇒ x ∊ j2_lab kr_sty (suc kr_sty) $ by j2_ex3 [l2, l5]
l7: $ G ⇒ cl_sty_nil ⊆ j2_lab kr_sty (suc kr_sty) $ by subset_intro [l6]

lemma j2_k_sty_app (G: hyps) (J: class): $ G ⇒ cl_sty_app J ⊆ j2_lab kr_sty (suc kr_sty) $
----
l1: $ G , x ∊ cl_sty_app J ⇒ x ∊ cl_sty_app J $ by ax
l2: $ G , x ∊ cl_sty_app J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ kr_sty ∈ ω $ by kr_sty_omega
l6: $ G , x = ⟨ scons (ra_sty y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩) ∅ , ra_sty y z u ⟨ kc_app , scons v (scons w ∅) ⟩ c ⟩ ∧ ra_deq y w w a ∈ J ∧ ra_inst ⟨ kc_nz , ∅ ⟩ b w c ∈ lrel ⇒ x ∊ j2_lab kr_sty (suc kr_sty) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_sty_app J ⇒ x ∊ j2_lab kr_sty (suc kr_sty) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ cl_sty_app J ⊆ j2_lab kr_sty (suc kr_sty) $ by subset_intro [l7]

lemma j2_p_sty (G: hyps) (J: class): $ G ⇒ pr_sty J ⊆ j2_lab kr_sty (suc kr_sty) $
----
l1: $ G ⇒ cl_sty_app J ⊆ j2_lab kr_sty (suc kr_sty) $ by j2_k_sty_app
l2: $ G ⇒ cl_sty_nil ⊆ j2_lab kr_sty (suc kr_sty) $ by j2_k_sty_nil
l3: $ G ⇒ pr_sty J ⊆ j2_lab kr_sty (suc kr_sty) $ by cun_least [l2, l1]

lemma j2_k_cwf_pi (G: hyps) (J: class): $ G ⇒ cl_cwf_pi J ⊆ j2_lab kr_cwf (suc kr_cwf) $
----
l1: $ G , x ∊ cl_cwf_pi J ⇒ x ∊ cl_cwf_pi J $ by ax
l2: $ G , x ∊ cl_cwf_pi J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j (x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 $ by ax
l4: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ⇒ kr_cwf ∈ ω $ by kr_cwf_omega
l6: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_closed c f ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons j ∅ ⟩ ∈ J ∧ ra_ulevel v j ∈ lrel2 ⇒ x ∊ j2_lab kr_cwf (suc kr_cwf) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_cwf_pi J ⇒ x ∊ j2_lab kr_cwf (suc kr_cwf) $ by j2_ex12 [l2, l6]
l8: $ G ⇒ cl_cwf_pi J ⊆ j2_lab kr_cwf (suc kr_cwf) $ by subset_intro [l7]

lemma j2_k_cwf_pi_rec (G: hyps) (J: class): $ G ⇒ cl_cwf_pi_rec J ⊆ j2_lab kr_cwf (suc kr_cwf) $
----
l1: $ G , x ∊ cl_cwf_pi_rec J ⇒ x ∊ cl_cwf_pi_rec J $ by ax
l2: $ G , x ∊ cl_cwf_pi_rec J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel $ by ax
l4: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel ⇒ x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ $ by and_elim_l [l3]
l5: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel ⇒ kr_cwf ∈ ω $ by kr_cwf_omega
l6: $ G , x = ⟨ scons (ra_cwf y z u v w ⟨ kc_cons , scons i (scons a ∅) ⟩ ⟨ kc_s , scons b ∅ ⟩ g) ∅ , ra_cwf y z u v w a b ⟨ kc_pi , scons f (scons g ∅) ⟩ ⟩ ∧ ra_add b u c ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ z c f i ∈ lrel ∧ ra_deq a i i ⟨ kc_srt , scons k ∅ ⟩ ∈ J ∧ ra_ulevel v k ∈ lrel2 ∧ ra_ipos y z u b f ∈ lrel ∧ ra_inst ⟨ kc_nz , ∅ ⟩ g ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ j ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ j g ∈ lrel ⇒ x ∊ j2_lab kr_cwf (suc kr_cwf) $ by j2_lab_self [l4, l5]
l7: $ G , x ∊ cl_cwf_pi_rec J ⇒ x ∊ j2_lab kr_cwf (suc kr_cwf) $ by j2_ex13 [l2, l6]
