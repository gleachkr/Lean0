l65: $ G ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by j2_exi13 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, b9 := $ V9 $, b10 := $ V10 $, b11 := $ V11 $, b12 := $ V12 $, b13 := $ V13 $, p := $ t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J $) [l64]

lemma j2_d_nst_ok_cons (G: hyps) (J: class) {G_v D I j_v j2 npi ni mi ni0 X N2 N3 NI: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_cons ⇒ x ∊ cl_nst_ok_cons $ by ax
l2: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_wf y u) (scons (ra_nst_ok y z w j) ∅) , ra_nst_ok y z v ⟨ kc_cons , scons g (scons i ∅) ⟩ ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons u (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ g a ∈ lrel ∧ ra_ind_arity u a b c ∈ lrel ∧ ra_ind_nested u k ∈ lrel ∧ ra_ndecl k b f ∈ lrel ∧ ra_nst_group y z u g v ⟨ kc_nz , ∅ ⟩ f ⟨ kc_cons , scons g (scons i ∅) ⟩ j ∈ lrel2 ∧ ra_add v f w ∈ lrel ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by j2_e_nst_ok_cons [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ , x ∊ cl_nst_ok_cons ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by j2_ex13 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_nst_ok (G: hyps) (J: class) {G_v D j_v I j2 npi ni mi ni0 X N2 N3 NI: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ pr_nst_ok $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons $ by ax
l2: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by j2_d_nst_ok_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons → ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) $ by ax
l6: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∨ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil $ by ax
l8: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l9: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by j2_d_nst_ok_nil [l7, l8]
l10: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons $ by ax
l12: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons → ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons ⇒ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_cons ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ cl_nst_ok_nil ∪ (cl_nst_ok_cons) → ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by imp_intro [l15]
l17: $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by imp_elim [l16, #1]

lrel3_nst_ok_cases
------------------
l1: $ G ⇒ isset (ra_nst_ok t1 t2 t3 t4) $ by opair_isset
l2: $ G , c = ra_nst_ok t1 t2 t3 t4 ⇒ c = ra_nst_ok t1 t2 t3 t4 $ by ax
l3: $ G , c = ra_nst_ok t1 t2 t3 t4 ⇒ ra_nst_ok t1 t2 t3 t4 = c $ by eq_sym [l2]
l4: $ G , c = ra_nst_ok t1 t2 t3 t4 ⇒ ra_nst_ok t1 t2 t3 t4 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_nst_ok t1 t2 t3 t4 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_nst_ok t1 t2 t3 t4 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_nst_ok t1 t2 t3 t4 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_nst_ok t1 t2 t3 t4 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_nst_ok t1 t2 t3 t4 $ by ax
l14: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_nst_ok t1 t2 t3 t4 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_nst_ok t1 t2 t3 t4 ⟩ ∈ pr_nst_ok $ by lprog3_nst_ok_pr [l15]
l17: $ G , c = ra_nst_ok t1 t2 t3 t4 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by j2_o_nst_ok [l16, l11]
l18: $ G , c = ra_nst_ok t1 t2 t3 t4 ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ D ∃ j_v (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ G_v ∃ D ∃ I ∃ j_v ∃ j2 ∃ npi ∃ ni ∃ mi ∃ ni0 ∃ X ∃ N2 ∃ N3 ∃ NI (t1 = G_v ∧ t2 = D ∧ t3 = j_v ∧ t4 = ⟨ kc_cons , scons X (scons N2 ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons I (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ X npi ∈ lrel ∧ ra_ind_wf G_v I ∈ lrel3 J ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_ndecl NI ni ni0 ∈ lrel ∧ ra_nst_group G_v D I X j_v ⟨ kc_nz , ∅ ⟩ ni0 ⟨ kc_cons , scons X (scons N2 ∅) ⟩ N3 ∈ lrel2 ∧ ra_add j_v ni0 j2 ∈ lrel ∧ ra_nst_ok G_v D j2 N3 ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_large_nz (G: hyps) (J: class) {G_v D b_v P T F C k_v l_v: set} (pp t1 t2 x V1 V2 V3 V4 V5 V6 V7 V8 V9: set):
  $ G ⇒ x = ⟨ pp , ra_large t1 t2 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_large V1 V2 ⟩ ∧ ra_ind_data V2 V3 V4 V5 ∈ lrel ∧ ra_nth_ty V5 ⟨ kc_nz , ∅ ⟩ V6 V7 ∈ lrel ∧ ra_isort V6 V8 V9 ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons V9 ∅) ⟩ V9 $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ k_v ∃ l_v (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $
----
l1: $ G ⇒ x = ⟨ ∅ , ra_large V1 V2 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V2 V3 V4 V5 ∈ lrel ∧ ra_nth_ty V5 ⟨ kc_nz , ∅ ⟩ V6 V7 ∈ lrel ∧ ra_isort V6 V8 V9 ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons V9 ∅) ⟩ V9 $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ = ⟨ ∅ , ra_large V1 V2 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ ∅ , ra_large V1 V2 ⟩ = ⟨ pp , ra_large t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_large t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_large V1 V2) $ by opair_isset
l10: $ G ⇒ pp = ∅ ∧ ra_large t1 t2 = ra_large V1 V2 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_large t1 t2 = ra_large V1 V2 $ by and_elim_r [l10]
l13: $ G ⇒ isset V2 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons V2 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_large ∈ ω $ by kr_large_omega
l23: $ G ⇒ isset kr_large $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons V2 ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_large = kr_large ∧ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V2 ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V2 V3 V4 V5 ∈ lrel ∧ ra_nth_ty V5 ⟨ kc_nz , ∅ ⟩ V6 V7 ∈ lrel ∧ ra_isort V6 V8 V9 ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons V9 ∅) ⟩ V9 $ by j2_and2 [l29, l32, l2]
l34: $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ k_v ∃ l_v (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $ by j2_exi9 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, b9 := $ V9 $, p := $ t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v $) [l33]

lemma j2_d_large_nz (G: hyps) (J: class) {G_v D b_v P T F C k_v l_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ ∈ cl_large_nz $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ k_v ∃ l_v (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $
----
l1: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_nz ⇒ x ∊ cl_large_nz $ by ax
l2: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_nz ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f ⇒ x = ⟨ pp , ra_large t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f ⇒ x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f $ by ax
l5: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v w ∈ lrel ∧ ra_nth_ty w ⟨ kc_nz , ∅ ⟩ a b ∈ lrel ∧ ra_isort a c f ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons f ∅) ⟩ f ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ k_v ∃ l_v (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $ by j2_e_large_nz [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_nz ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ k_v ∃ l_v (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $ by j2_ex9 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ k_v ∃ l_v (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) $ by wcel_elim [#1, l7]

lemma j2_e_large_empty (G: hyps) (J: class) {G_v D b_v P F: set} (pp t1 t2 x V1 V2 V3 V4 V5: set):
  $ G ⇒ x = ⟨ pp , ra_large t1 t2 ⟩ $ > $ G ⇒ x = ⟨ ∅ , ra_large V1 V2 ⟩ ∧ ra_ind_data V2 V3 V4 ⟨ kc_tcons , scons V5 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $
----
l1: $ G ⇒ x = ⟨ ∅ , ra_large V1 V2 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V2 V3 V4 ⟨ kc_tcons , scons V5 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ = ⟨ ∅ , ra_large V1 V2 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ ∅ , ra_large V1 V2 ⟩ = ⟨ pp , ra_large t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_large t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_large V1 V2) $ by opair_isset
l10: $ G ⇒ pp = ∅ ∧ ra_large t1 t2 = ra_large V1 V2 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_large t1 t2 = ra_large V1 V2 $ by and_elim_r [l10]
l13: $ G ⇒ isset V2 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons V2 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_large ∈ ω $ by kr_large_omega
l23: $ G ⇒ isset kr_large $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons V2 ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_large = kr_large ∧ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V2 ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ ra_ind_data V2 V3 V4 ⟨ kc_tcons , scons V5 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by j2_and2 [l29, l32, l2]
l34: $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by j2_exi5 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, p := $ t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $) [l33]

lemma j2_d_large_empty (G: hyps) (J: class) {G_v D b_v P F: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ ∈ cl_large_empty $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_empty ⇒ x ∊ cl_large_empty $ by ax
l2: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_empty ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ x = ⟨ pp , ra_large t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ ∅ , ra_large y z ⟩ ∧ ra_ind_data z u v ⟨ kc_tcons , scons w (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by j2_e_large_empty [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_empty ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by j2_ex5 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) $ by wcel_elim [#1, l7]

lemma j2_e_large_single (G: hyps) (J: class) {G_v G2 D b_v P F K np: set} (pp t1 t2 x V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ x = ⟨ pp , ra_large t1 t2 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ , ra_large V1 V3 ⟩ ∧ ra_ind_data V3 V4 V5 ⟨ kc_tcons , scons V6 (scons ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ F ∃ K ∃ np (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ , ra_large V1 V3 ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_ind_data V3 V4 V5 ⟨ kc_tcons , scons V6 (scons ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ = ⟨ scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ , ra_large V1 V3 ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ , ra_large V1 V3 ⟩ = ⟨ pp , ra_large t1 t2 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_large t1 t2) $ by opair_isset
l9: $ G ⇒ isset (ra_large V1 V3) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ ∧ ra_large t1 t2 = ra_large V1 V3 $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_large t1 t2 = ra_large V1 V3 $ by and_elim_r [l10]
l13: $ G ⇒ isset V3 $ by isset_var
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 ∅ ∈ fseq j2_vv $ by j2_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq j2_vv $ by j2_fs [l18, l17]
l20: $ G ⇒ scons V3 ∅ ∈ fseq j2_vv $ by j2_fs [l13, l15]
l21: $ G ⇒ scons V1 (scons V3 ∅) ∈ fseq j2_vv $ by j2_fs [l14, l20]
l22: $ G ⇒ kr_large ∈ ω $ by kr_large_omega
l23: $ G ⇒ isset kr_large $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l19]
l25: $ G ⇒ isset (scons V1 (scons V3 ∅)) $ by wcel_isset [l21]
l26: $ G ⇒ kr_large = kr_large ∧ scons t1 (scons t2 ∅) = scons V1 (scons V3 ∅) $ by opair_inj_c [l12, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V3 ∅) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V3 ∅ $ by j2_scons_inj [l27, l18, l14, l17, l20]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 ∅ = scons V3 ∅ $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V3 ∧ ∅ = ∅ $ by j2_scons_inj [l30, l16, l13, l15, l15]
l32: $ G ⇒ t2 = V3 $ by and_elim_l [l31]
l33: $ G ⇒ crn pp = crn (scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅) $ by crn_eq [l11]
l34: $ G ⇒ crn (scons (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) ∅) ⊆ lrel3 J $ by subset_eq_l [l33, #3]
l35: $ G ⇒ isset (ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7) $ by opair_isset
l36: $ G ⇒ ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7 ∈ lrel3 J $ by crn_scons_head [l35, l34]
l37: $ G ⇒ ra_ind_data V3 V4 V5 ⟨ kc_tcons , scons V6 (scons ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel $ by and_elim_l [l2]
l38: $ G ⇒ ra_clen V5 V8 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [l2]
l39: $ G ⇒ ra_clen V5 V8 ∈ lrel $ by and_elim_l [l38]
l40: $ G ⇒ ra_capp V5 V1 V2 ∈ lrel $ by and_elim_r [l38]
l41: $ G ⇒ t1 = V1 ∧ t2 = V3 ∧ ra_ind_data V3 V4 V5 ⟨ kc_tcons , scons V6 (scons ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_fir V3 V8 V2 ⟨ kc_nz , ∅ ⟩ V7 ∈ lrel3 J $ by j2_and5 [l29, l32, l37, l39, l40, l36]
l42: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ F ∃ K ∃ np (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J) $ by j2_exi8 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, p := $ t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J $) [l41]

lemma j2_d_large_single (G: hyps) (J: class) {G_v G2 D b_v P F K np: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ ∈ cl_large_single $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ F ∃ K ∃ np (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_single ⇒ x ∊ cl_large_single $ by ax
l2: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_single ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x = ⟨ pp , ra_large t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x = ⟨ scons (ra_fir u c z ⟨ kc_nz , ∅ ⟩ b) ∅ , ra_large y u ⟩ ∧ ra_ind_data u v w ⟨ kc_tcons , scons a (scons ⟨ kc_ccons , scons b (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen w c ∈ lrel ∧ ra_capp w y z ∈ lrel ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ F ∃ K ∃ np (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J) $ by j2_e_large_single [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_large t1 t2 ⟩ , x ∊ cl_large_single ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ F ∃ K ∃ np (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ F ∃ K ∃ np (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_large (G: hyps) (J: class) {G_v D b_v P T F C k_v l_v G2 K np: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_large t1 t2 ⟩ ∈ pr_large $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ D ∃ b_v ∃ P ∃ T ∃ F ∃ C ∃ k_v ∃ l_v (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ lveq ⟨ kc_lmax , scons ⟨ kc_ls , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ (scons l_v ∅) ⟩ l_v) ∨ ∃ G_v ∃ D ∃ b_v ∃ P ∃ F (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel) ∨ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ F ∃ K ∃ np (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P ⟨ kc_tcons , scons F (scons ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ (scons ⟨ kc_tnil , ∅ ⟩ ∅)) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_fir D np G2 ⟨ kc_nz , ∅ ⟩ K ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_large t1 t2 ⟩ ∈ cl_large_single ⇒ ⟨ pp , ra_large t1 t2 ⟩ ∈ cl_large_single $ by ax
l2: $ G , ⟨ pp , ra_large t1 t2 ⟩ ∈ cl_large_single ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
