l11: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_tys_ok t1 t2 $ by ax
l14: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_tys_ok t1 t2 ⟩ $ by opair_eq [l12, l13]
l15: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_tys_ok t1 t2 ⟩ ∈ lprog3 J $ by wcel_eq_l [l14, l10]
l16: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , ra_tys_ok t1 t2 ⟩ ∈ pr_tys_ok $ by lprog3_tys_ok_pr [l15]
l17: $ G , c = ra_tys_ok t1 t2 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by j2_o_tys_ok [l16, l11]
l18: $ G , c = ra_tys_ok t1 t2 ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by ex_elim [l8, l17]
l19: $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ T (t1 = G_v ∧ t2 = D ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ctx_wf G_v P ∈ lrel3 J ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_tys_ty G2 T ∈ lrel3 J) $ by isset_elim [l1, l18]

lemma j2_e_ind_wf_i (G: hyps) (J: class) {G_v G2 D b_v P N T np n_v m_v k_v n0 l_v F C: set} (pp t1 t2 x V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15: set):
  $ G ⇒ x = ⟨ pp , ra_ind_wf t1 t2 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) , ra_ind_wf V1 V3 ⟩ ∧ ra_ind_data V3 V4 V5 V7 ∈ lrel ∧ ra_clen V5 V8 ∈ lrel ∧ ra_ntys V7 V9 V10 ∈ lrel ∧ ra_capp V5 V1 V2 ∈ lrel ∧ ra_nth_ty V7 ⟨ kc_nz , ∅ ⟩ V14 V15 ∈ lrel ∧ ra_isort V14 V11 V13 ∈ lrel ∧ ra_ind_nested V3 V6 ∈ lrel ∧ ra_ndecl V6 V9 V12 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ G_v ∃ G2 ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ n0 ∃ l_v ∃ F ∃ C (t1 = G_v ∧ t2 = D ∧ ra_tys_ok G_v D ∈ lrel3 J ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_capp P G_v G2 ∈ lrel ∧ ra_nth_ty T ⟨ kc_nz , ∅ ⟩ F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel ∧ ra_tys_wf D n_v np l_v ⟨ kc_nz , ∅ ⟩ G2 T ∈ lrel3 J ∧ ra_ind_nested D N ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_ok G_v D n0 N ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_tys_ok V1 V3) (scons (ra_tys_wf V3 V9 V8 V13 ⟨ kc_nz , ∅ ⟩ V2 V7) (scons (ra_nst_ok V1 V3 V12 V6) ∅)) , ra_ind_wf V1 V3 ⟩ $ by and_elim_l [#2]
