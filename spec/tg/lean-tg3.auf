l53: $ G ⇒ t5 = V5 $ by and_elim_l [l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ ra_indapp V1 ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V2 V4 V5 ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by j2_and5 [l41, l44, l47, l50, l53, l2]
l55: $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by j2_exi5 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, p := $ t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel $) [l54]

lemma j2_d_fir_res (G: hyps) (J: class) {D np Ctx d_v K: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_res $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_res ⇒ x ∊ cl_fir_res $ by ax
l2: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_res ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_fir y z u v w ⟩ ∧ ra_indapp y ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ z v w ⟨ kc_nz , ∅ ⟩ ∈ lrel ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by j2_e_fir_res [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_res ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by j2_ex5 [l2, l6]
l8: $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by wcel_elim [#1, l7]

lemma j2_e_fir_arg (G: hyps) (J: class) {D np Ctx d_v k_v A A2 B: set} (pp t1 t2 t3 t4 t5 x V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ , ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel ∧ ra_add V4 V2 V5 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ , ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_leaf_has ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel ∧ ra_add V4 V2 V5 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ , ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ , ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_fir t1 t2 t3 t4 t5) $ by opair_isset
l9: $ G ⇒ isset (ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ ∧ ra_fir t1 t2 t3 t4 t5 = ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_fir t1 t2 t3 t4 t5 = ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by and_elim_r [l10]
l13: $ G ⇒ isset ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by opair_isset
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ isset V3 $ by isset_var
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ isset V1 $ by isset_var
l18: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l19: $ G ⇒ isset t5 $ by isset_var
l20: $ G ⇒ scons t5 ∅ ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t4 $ by isset_var
l22: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ isset t3 $ by isset_var
l24: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq j2_vv $ by j2_fs [l23, l22]
l25: $ G ⇒ isset t2 $ by isset_var
l26: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq j2_vv $ by j2_fs [l25, l24]
l27: $ G ⇒ isset t1 $ by isset_var
l28: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq j2_vv $ by j2_fs [l27, l26]
l29: $ G ⇒ scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l13, l18]
l30: $ G ⇒ scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l14, l29]
l31: $ G ⇒ scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l30]
l32: $ G ⇒ scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l31]
l33: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l17, l32]
l34: $ G ⇒ kr_fir ∈ ω $ by kr_fir_omega
l35: $ G ⇒ isset kr_fir $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l28]
l37: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_fir = kr_fir ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) $ by opair_inj_c [l12, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) $ by j2_scons_inj [l39, l27, l17, l26, l32]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)) $ by j2_scons_inj [l42, l25, l16, l24, l31]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅) $ by j2_scons_inj [l45, l23, l15, l22, l30]
l47: $ G ⇒ t3 = V3 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 ∅) = scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V4 ∧ scons t5 ∅ = scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅ $ by j2_scons_inj [l48, l21, l14, l20, l29]
l50: $ G ⇒ t4 = V4 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 ∅ = scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅ $ by and_elim_r [l49]
l52: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l51, l19, l13, l18, l18]
l53: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by and_elim_l [l52]
l54: $ G ⇒ crn pp = crn (scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅) $ by crn_eq [l11]
l55: $ G ⇒ crn (scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅) ⊆ lrel3 J $ by subset_eq_l [l54, #3]
l56: $ G ⇒ isset (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) $ by opair_isset
l57: $ G ⇒ ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8 ∈ lrel3 J $ by crn_scons_head [l56, l55]
l58: $ G ⇒ ra_leaf_has ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_elim_l [l2]
l59: $ G ⇒ ra_add V4 V2 V5 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel $ by and_elim_r [l2]
l60: $ G ⇒ ra_add V4 V2 V5 ∈ lrel $ by and_elim_l [l59]
l61: $ G ⇒ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel $ by and_elim_r [l59]
l62: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel ∧ ra_add V4 V2 V5 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel ∧ ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8 ∈ lrel3 J $ by j2_and8 [l41, l44, l47, l50, l53, l58, l60, l61, l57]
l63: $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_exi8 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, p := $ t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J $) [l62]

lemma j2_d_fir_arg (G: hyps) (J: class) {D np Ctx d_v k_v A A2 B: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_arg ⇒ x ∊ cl_fir_arg $ by ax
l2: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_arg ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ⇒ x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ⇒ x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel $ by ax
l5: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ c ∈ lrel ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_e_fir_arg [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_arg ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_e_fir_prop (G: hyps) (J: class) {D np Ctx d_v k_v A A2 B: set} (pp t1 t2 t3 t4 t5 x V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ $ > $ G ⇒ x = ⟨ scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ , ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ ∧ ra_add V4 V2 V5 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel ∧ ra_deq V3 V7 V7 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G ⇒ x = ⟨ scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ , ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ $ by and_elim_l [#2]
l2: $ G ⇒ ra_add V4 V2 V5 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel ∧ ra_deq V3 V7 V7 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by and_elim_r [#2]
l3: $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [#1]
l4: $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ , ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ $ by eq_trans [l3, l1]
l5: $ G ⇒ ⟨ scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ , ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ $ by eq_sym [l4]
l6: $ G ⇒ isset (scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅) $ by j2_opair_set_l [l5]
l7: $ G ⇒ isset pp $ by isset_var
l8: $ G ⇒ isset (ra_fir t1 t2 t3 t4 t5) $ by opair_isset
l9: $ G ⇒ isset (ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩) $ by opair_isset
l10: $ G ⇒ pp = scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ ∧ ra_fir t1 t2 t3 t4 t5 = ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by opair_inj_c [l4, l7, l8, l6, l9]
l11: $ G ⇒ pp = scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅ $ by and_elim_l [l10]
l12: $ G ⇒ ra_fir t1 t2 t3 t4 t5 = ra_fir V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by and_elim_r [l10]
l13: $ G ⇒ isset ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by opair_isset
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ isset V3 $ by isset_var
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ isset V1 $ by isset_var
l18: $ G ⇒ ∅ ∈ fseq j2_vv $ by fseq_empty
l19: $ G ⇒ isset t5 $ by isset_var
l20: $ G ⇒ scons t5 ∅ ∈ fseq j2_vv $ by j2_fs [l19, l18]
l21: $ G ⇒ isset t4 $ by isset_var
l22: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq j2_vv $ by j2_fs [l21, l20]
l23: $ G ⇒ isset t3 $ by isset_var
l24: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq j2_vv $ by j2_fs [l23, l22]
l25: $ G ⇒ isset t2 $ by isset_var
l26: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq j2_vv $ by j2_fs [l25, l24]
l27: $ G ⇒ isset t1 $ by isset_var
l28: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq j2_vv $ by j2_fs [l27, l26]
l29: $ G ⇒ scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅ ∈ fseq j2_vv $ by j2_fs [l13, l18]
l30: $ G ⇒ scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅) ∈ fseq j2_vv $ by j2_fs [l14, l29]
l31: $ G ⇒ scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)) ∈ fseq j2_vv $ by j2_fs [l15, l30]
l32: $ G ⇒ scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) ∈ fseq j2_vv $ by j2_fs [l16, l31]
l33: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) ∈ fseq j2_vv $ by j2_fs [l17, l32]
l34: $ G ⇒ kr_fir ∈ ω $ by kr_fir_omega
l35: $ G ⇒ isset kr_fir $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l28]
l37: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_fir = kr_fir ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) $ by opair_inj_c [l12, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) $ by j2_scons_inj [l39, l27, l17, l26, l32]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)) $ by j2_scons_inj [l42, l25, l16, l24, l31]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅) $ by j2_scons_inj [l45, l23, l15, l22, l30]
l47: $ G ⇒ t3 = V3 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 ∅) = scons V4 (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V4 ∧ scons t5 ∅ = scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅ $ by j2_scons_inj [l48, l21, l14, l20, l29]
l50: $ G ⇒ t4 = V4 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 ∅ = scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅ $ by and_elim_r [l49]
l52: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∧ ∅ = ∅ $ by j2_scons_inj [l51, l19, l13, l18, l18]
l53: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by and_elim_l [l52]
l54: $ G ⇒ crn pp = crn (scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅) $ by crn_eq [l11]
l55: $ G ⇒ crn (scons (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) ∅) ⊆ lrel3 J $ by subset_eq_l [l54, #3]
l56: $ G ⇒ isset (ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8) $ by opair_isset
l57: $ G ⇒ ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8 ∈ lrel3 J $ by crn_scons_head [l56, l55]
l58: $ G ⇒ ra_add V4 V2 V5 ∈ lrel $ by and_elim_l [l2]
l59: $ G ⇒ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel ∧ ra_deq V3 V7 V7 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by and_elim_r [l2]
l60: $ G ⇒ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel $ by and_elim_l [l59]
l61: $ G ⇒ ra_deq V3 V7 V7 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by and_elim_r [l59]
l62: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∧ ra_add V4 V2 V5 ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V5 V6 V7 ∈ lrel ∧ ra_deq V3 V7 V7 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir V1 V2 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V8 ∈ lrel3 J $ by j2_and8 [l41, l44, l47, l50, l53, l58, l60, l61, l57]
l63: $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_exi8 (b1 := $ V1 $, b2 := $ V2 $, b3 := $ V3 $, b4 := $ V4 $, b5 := $ V5 $, b6 := $ V6 $, b7 := $ V7 $, b8 := $ V8 $, p := $ t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J $) [l62]

lemma j2_d_fir_prop (G: hyps) (J: class) {D np Ctx d_v k_v A A2 B: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_prop J ⇒ x ∊ cl_fir_prop J $ by ax
l2: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_prop J ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J $ by ax
l5: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l6: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_fir y z ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ c) ∅ , ra_fir y z u v ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ∧ ra_add v z w ∈ lrel ∧ ra_sinst y ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ w a b ∈ lrel ∧ ra_deq u b b ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_e_fir_prop [l3, l4, l5]
l7: $ G , x = ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ , x ∊ cl_fir_prop J ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_ex8 [l2, l6]
l8: $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by wcel_elim [#1, l7]

lemma j2_o_fir (G: hyps) (J: class) {D np Ctx d_v K k_v A A2 B: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ pr_fir J $ > $ G ⇒ crn pp ⊆ lrel3 J $ >
  $ G ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ K (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = K ∧ ra_indapp D ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ np d_v K ⟨ kc_nz , ∅ ⟩ ∈ lrel) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $
----
l1: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J $ by ax
l2: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l3: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_d_fir_prop [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J → ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) $ by ax
l6: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∨ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J $ by j2_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg $ by ax
l8: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ⇒ crn pp ⊆ lrel3 J $ by weaken [#2]
l9: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by j2_d_fir_arg [l7, l8]
l10: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J $ by ax
l12: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J → ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_prop J ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) ⇒ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) → ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_nz , ∅ ⟩ B ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) ∨ ∃ D ∃ np ∃ Ctx ∃ d_v ∃ k_v ∃ A ∃ A2 ∃ B (t1 = D ∧ t2 = np ∧ t3 = Ctx ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ k_v A A2 ∈ lrel ∧ ra_deq Ctx A2 A2 ⟨ kc_srt , scons ⟨ kc_lz , ∅ ⟩ ∅ ⟩ ∈ J ∧ ra_fir D np ⟨ kc_cons , scons A2 (scons Ctx ∅) ⟩ ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel3 J) $ by imp_intro [l15]
l17: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J)) ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J)) $ by ax
l18: $ G , ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J)) ⇒ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_res ∨ ⟨ pp , ra_fir t1 t2 t3 t4 t5 ⟩ ∈ cl_fir_arg ∪ (cl_fir_prop J) $ by j2_wcel_cun_elim [l17]
