ra_deq_congr
------------
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A4 ∅ ≐ scons B4 ∅ $ by scons_congr [#4, l1]
l3: $ scons A3 (scons A4 ∅) ≐ scons B3 (scons B4 ∅) $ by scons_congr [#3, l2]
l4: $ scons A2 (scons A3 (scons A4 ∅)) ≐ scons B2 (scons B3 (scons B4 ∅)) $ by scons_congr [#2, l3]
l5: $ scons A1 (scons A2 (scons A3 (scons A4 ∅))) ≐ scons B1 (scons B2 (scons B3 (scons B4 ∅))) $ by scons_congr [#1, l4]
l6: $ kr_deq ≐ kr_deq $ by ceqt_refl
l7: $ ⟨ kr_deq , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩ ≐ ⟨ kr_deq , scons B1 (scons B2 (scons B3 (scons B4 ∅))) ⟩ $ by opair_congr [l6, l5]

ra_deq_eq
---------
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A4 ∅ = scons B4 ∅ $ by scons_eq [#4, l1]
l3: $ G ⇒ scons A3 (scons A4 ∅) = scons B3 (scons B4 ∅) $ by scons_eq [#3, l2]
l4: $ G ⇒ scons A2 (scons A3 (scons A4 ∅)) = scons B2 (scons B3 (scons B4 ∅)) $ by scons_eq [#2, l3]
l5: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 ∅))) = scons B1 (scons B2 (scons B3 (scons B4 ∅))) $ by scons_eq [#1, l4]
l6: $ G ⇒ kr_deq = kr_deq $ by eq_refl
l7: $ G ⇒ ⟨ kr_deq , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩ = ⟨ kr_deq , scons B1 (scons B2 (scons B3 (scons B4 ∅))) ⟩ $ by opair_eq [l6, l5]

sb_c_ra_deq
-----------
l1: $ (⟦ x / t ⟧ ⟨ kr_deq , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩) ≐ ⟨ kr_deq , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) ∅))) ⟩ $ by ceqt_refl

