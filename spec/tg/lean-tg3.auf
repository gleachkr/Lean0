l13: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A3 = ra_closed ⟨ kc_nz , ∅ ⟩ u $ by eq_sym [l12]
l14: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ u ∈ lrel $ by wcel_eq_l [l13, l11]
l15: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A4 ∈ lrel $ by weaken [#8]
l16: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ v = ra_closed ⟨ kc_nz , ∅ ⟩ A4 $ by ra_closed_eq [l7, l4]
l17: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A4 = ra_closed ⟨ kc_nz , ∅ ⟩ v $ by eq_sym [l16]
l18: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ v ∈ lrel $ by wcel_eq_l [l17, l15]
l19: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A5 ∈ lrel $ by weaken [#9]
l20: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ w = ra_closed ⟨ kc_nz , ∅ ⟩ A5 $ by ra_closed_eq [l7, l5]
l21: $ G , y = A1 , z = A2 , u = A3 , v = A4 , w = A5 ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ A5 = ra_closed ⟨ kc_nz , ∅ ⟩ w $ by eq_sym [l20]
