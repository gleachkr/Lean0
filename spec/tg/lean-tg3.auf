l44: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons V7 (scons ⟨ kc_pi , scons V9 (scons V10 ∅) ⟩ ∅)))))) ∈ fseq j2_vv $ by j2_fs [l19, l43]
