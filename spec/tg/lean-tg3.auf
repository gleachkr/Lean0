lemma j3_enc_n1: $ enc_nat n1 ≐ ⟨ kc_s , scons (enc_nat nz) ∅ ⟩ $
----
l1: $ enc_nat n1 ≐ ⟨ kc_s , scons (enc_nat nz) ∅ ⟩ $ by enc_s

