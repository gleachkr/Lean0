l1: $ G ⇒ ∃ G_v ∃ f_v ∃ fd ∃ fm ∃ fmul ∃ fadd ∃ h_v (t1 = G_v ∧ t2 = f_v ∧ t3 = fd ∧ t4 = fm ∧ t5 = fmul ∧ t6 = fadd ∧ ra_divmod_eqs G_v fd fm fmul fadd ∈ lrel3 J ∧ ra_closed ⟨ kc_nz , ∅ ⟩ f_v ∈ lrel ∧ ra_deq G_v f_v f_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons tr_nat_ty ∅) ⟩ ∅) ⟩ ∈ J ∧ ra_deq G_v h_v h_v ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_pi , scons tr_nat_ty (scons ⟨ kc_app , scons ⟨ kc_app , scons j2_c1 (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons fadd (scons ⟨ kc_app , scons ⟨ kc_app , scons fadd (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons f_v (scons ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons fd (scons ⟨ kc_app , scons ⟨ kc_app , scons fadd (scons ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_bvar , scons ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_app , scons ⟨ kc_app , scons fm (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ (scons ⟨ kc_lit , scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∅) ⟩ ∈ J) $ by j2_d_land_eqs_i [#1, #2]

lrel3_land_eqs_cases
--------------------
l1: $ G ⇒ isset (ra_land_eqs t1 t2 t3 t4 t5 t6) $ by opair_isset
l2: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 ⇒ c = ra_land_eqs t1 t2 t3 t4 t5 t6 $ by ax
l3: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 ⇒ ra_land_eqs t1 t2 t3 t4 t5 t6 = c $ by eq_sym [l2]
l4: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 ⇒ ra_land_eqs t1 t2 t3 t4 t5 t6 ∈ lrel3 J $ by weaken [#1]
l5: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 ⇒ c ∈ lrel3 J $ by wcel_eq_l [l3, l4]
l6: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 ⇒ c ∊ lrel3 J $ by wcel_welc [l5]
l7: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 ⇒ hprog (lprog3 J) latoms $ by lprog3_hprog
l8: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 ⇒ ∃ p (⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J) $ by horn_elim [l7, l6]
l9: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J $ by ax
l10: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ ∈ lprog3 J $ by and_elim_l [l9]
l11: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ crn p ⊆ lrel3 J $ by and_elim_r [l9]
l12: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ p = p $ by eq_refl
l13: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ c = ra_land_eqs t1 t2 t3 t4 t5 t6 $ by ax
l14: $ G , c = ra_land_eqs t1 t2 t3 t4 t5 t6 , ⟨ p , c ⟩ ∈ lprog3 J ∧ crn p ⊆ lrel3 J ⇒ ⟨ p , c ⟩ = ⟨ p , ra_land_eqs t1 t2 t3 t4 t5 t6 ⟩ $ by opair_eq [l12, l13]
