-- Invariance of the literals' values (D4): a `lit` node is `eeqv` only to itself
-- --------------------------------------------------------------------------

--| `minv_intro`'s step at the nodes `lit`, for every hook: the node is `eeqv` to itself only.
theorem mcv_inv_node_lit (G: hyps) (M: class) (u w d z y t: set):
  $ G ⇒ z = ⟨ kc_lit , y ⟩ $ > $ G ⇒ ra_eeqv z t ∈ lrel2 $ >
  $ G ⇒ dt u M z w d = dt u M t w d $;



