-- --------------------------------------------------------------------------
-- The bitwise relations on binary numerals: zeros, and the digits of an instance
-- --------------------------------------------------------------------------

--| `band` at a zero: the result is zero (by induction on the first tree and inversion).
theorem lrel_band_zero (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_band t1 t2 t3 ∈ lrel $ > $ G ⇒ (fv nvf t1 = ∅ → fv nvf t3 = ∅) ∧ (fv nvf t2 = ∅ → fv nvf t3 = ∅) $;

--| An instance of `band` has a zero argument, or it is a smaller instance with a digit on each argument (by inversion).
--| @freshen G x
--| @freshen G y
--| @freshen G z
theorem lrel_band_digits {x y z: set} (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_band t1 t2 t3 ∈ lrel $ >
  $ G ⇒ fv nvf t1 = ∅ ∨ fv nvf t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_band x y z ∈ lrel ∧ ((fv nvf t1 = ndbl (fv nvf x) ∧ fv nvf t2 = ndbl (fv nvf y) ∧ fv nvf t3 = ndbl (fv nvf z)) ∨ (fv nvf t1 = ndbl (fv nvf x) ∧ fv nvf t2 = suc (ndbl (fv nvf y)) ∧ fv nvf t3 = ndbl (fv nvf z)) ∨ (fv nvf t1 = suc (ndbl (fv nvf x)) ∧ fv nvf t2 = ndbl (fv nvf y) ∧ fv nvf t3 = ndbl (fv nvf z)) ∨ (fv nvf t1 = suc (ndbl (fv nvf x)) ∧ fv nvf t2 = suc (ndbl (fv nvf y)) ∧ fv nvf t3 = suc (ndbl (fv nvf z))))) $;

--| `bor` at a zero: the result is the other argument (by induction on the first tree and inversion).
theorem lrel_bor_zero (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bor t1 t2 t3 ∈ lrel $ > $ G ⇒ (fv nvf t1 = ∅ → fv nvf t3 = fv nvf t2) ∧ (fv nvf t2 = ∅ → fv nvf t3 = fv nvf t1) $;

--| An instance of `bor` has a zero argument, or it is a smaller instance with a digit on each argument (by inversion).
--| @freshen G x
--| @freshen G y
--| @freshen G z
theorem lrel_bor_digits {x y z: set} (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bor t1 t2 t3 ∈ lrel $ >
  $ G ⇒ fv nvf t1 = ∅ ∨ fv nvf t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bor x y z ∈ lrel ∧ ((fv nvf t1 = ndbl (fv nvf x) ∧ fv nvf t2 = ndbl (fv nvf y) ∧ fv nvf t3 = ndbl (fv nvf z)) ∨ (fv nvf t1 = ndbl (fv nvf x) ∧ fv nvf t2 = suc (ndbl (fv nvf y)) ∧ fv nvf t3 = suc (ndbl (fv nvf z))) ∨ (fv nvf t1 = suc (ndbl (fv nvf x)) ∧ fv nvf t2 = ndbl (fv nvf y) ∧ fv nvf t3 = suc (ndbl (fv nvf z))) ∨ (fv nvf t1 = suc (ndbl (fv nvf x)) ∧ fv nvf t2 = suc (ndbl (fv nvf y)) ∧ fv nvf t3 = suc (ndbl (fv nvf z))))) $;

--| `bxor` at a zero: the result is the other argument (by induction on the first tree and inversion).
theorem lrel_bxor_zero (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bxor t1 t2 t3 ∈ lrel $ > $ G ⇒ (fv nvf t1 = ∅ → fv nvf t3 = fv nvf t2) ∧ (fv nvf t2 = ∅ → fv nvf t3 = fv nvf t1) $;

--| An instance of `bxor` has a zero argument, or it is a smaller instance with a digit on each argument (by inversion).
--| @freshen G x
--| @freshen G y
--| @freshen G z
theorem lrel_bxor_digits {x y z: set} (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bxor t1 t2 t3 ∈ lrel $ >
  $ G ⇒ fv nvf t1 = ∅ ∨ fv nvf t2 = ∅ ∨ ∃ x ∃ y ∃ z (ra_bxor x y z ∈ lrel ∧ ((fv nvf t1 = ndbl (fv nvf x) ∧ fv nvf t2 = ndbl (fv nvf y) ∧ fv nvf t3 = ndbl (fv nvf z)) ∨ (fv nvf t1 = ndbl (fv nvf x) ∧ fv nvf t2 = suc (ndbl (fv nvf y)) ∧ fv nvf t3 = suc (ndbl (fv nvf z))) ∨ (fv nvf t1 = suc (ndbl (fv nvf x)) ∧ fv nvf t2 = ndbl (fv nvf y) ∧ fv nvf t3 = suc (ndbl (fv nvf z))) ∨ (fv nvf t1 = suc (ndbl (fv nvf x)) ∧ fv nvf t2 = suc (ndbl (fv nvf y)) ∧ fv nvf t3 = ndbl (fv nvf z)))) $;





--| The rule `nat_land_lit` in the model.
theorem mland_lit (H: class) (G: ctx) (B vt vf Not Dec dite T R ofT ofF leN dleN ble pf sub fp fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf: expr) (ba bb bc: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ bitop_eqs_j (jmod (mcv H)) G B vt vf Not Dec dite T R ofT ofF leN dleN ble pf sub fp fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf vt vf vf vf $ > $ band ba bb bc $ >
  $ mdeq (mcv H) G (app (app f (lit ba)) (lit bb)) (lit bc) nat_ty $;

