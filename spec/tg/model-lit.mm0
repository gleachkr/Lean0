-- model-lit.mm0: the literals (layer G of the reduction, audit §11): the value of
-- `lit b` as a part of the hook, and the literal rules in the model. Imports
-- model-quot.mm0; proofs in model-lit.auf.

import "model-quot.mm0";



-- --------------------------------------------------------------------------
-- Literals (layer G): the hook's part and the rules `lit_zero`, `lit_succ`
-- --------------------------------------------------------------------------
-- The value of `lit b` is the numeral of `Nat`'s family for the number of `b`
-- (`nvf` reads binary numerals too): `fv nnf (fv nvf b)`.

--| At `lit b`: the numeral of `b`'s number.
def hlit (.u .l .e .z .w: set): class =
  $ {z | ∃ u ∃ l ∃ e (z = ⟨ ⟨ u , ⟨ kc_lit , ⟨ scons l ∅ , e ⟩ ⟩ ⟩ , clam w lvals (sclip (fv nnf (fv nvf l))) ⟩)} $;

--| The denotation of `lit b`, for a hook `mcv H` with `H` extending `hlit`, in an admissible universe: the numeral of
--| `b`'s number.
theorem dt_lit (G: hyps) (H B W R: class) (u: set):
  $ G ⇒ hlit ⊆ H $ > $ G ⇒ functional H $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq u $ > $ G ⇒ uadm u $ >
  $ G ⇒ dt u (mcv H) ⟨ kc_lit , scons B ∅ ⟩ W R = fv nnf (fv nvf B) $;

--| The rule `lit_zero` in the model, for a hook with the inductive types' and the literals' parts.
theorem mlit_zero (H: class) (G: ctx): $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ mdeq (mcv H) G (lit b0) (ind_ctor nat_D nz nz) (ind_ty nat_D nz) $;


-- --------------------------------------------------------------------------
-- The successor of binary numerals; the rule `lit_succ`
-- --------------------------------------------------------------------------

--| The semantics of `bsucc`, by induction on the tree and inversion.
theorem lrel_bsucc_sem (G: hyps) (t1 t2: set):
  $ G ⇒ ra_bsucc t1 t2 ∈ lrel $ > $ G ⇒ fv nvf t2 = suc (fv nvf t1) $;

--| `bsucc a b`: the number of `b` is the successor of `a`'s.
theorem bsucc_sem (G: hyps) (a b: bin): $ bsucc a b $ > $ G ⇒ fv nvf (enc_bin b) = suc (fv nvf (enc_bin a)) $;

--| The rule `lit_succ` in the model.
theorem mlit_succ (H: class) (G: ctx) (a b: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ bsucc a b $ > $ mdeq (mcv H) G (lit b) (app (ind_ctor nat_D nz n1) (lit a)) (ind_ty nat_D nz) $;


-- --------------------------------------------------------------------------
-- The arithmetic of binary numerals in the model
-- --------------------------------------------------------------------------

--| The semantics of `bdbl`, by inversion.
theorem lrel_bdbl_sem (G: hyps) (t1 t2: set):
  $ G ⇒ ra_bdbl t1 t2 ∈ lrel $ > $ G ⇒ fv nvf t2 = ndbl (fv nvf t1) $;

--| `bdbl a b`: the number of `b` is twice `a`'s.
theorem bdbl_sem (G: hyps) (a b: bin): $ bdbl a b $ > $ G ⇒ fv nvf (enc_bin b) = ndbl (fv nvf (enc_bin a)) $;

--| The semantics of `badd`, by induction on the first tree and inversion.
theorem lrel_badd_sem (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_badd t1 t2 t3 ∈ lrel $ > $ G ⇒ fv nvf t3 = nadd (fv nvf t1) (fv nvf t2) $;

--| `badd a b c`: the number of `c` is the sum of `a`'s and `b`'s.
theorem badd_sem (G: hyps) (a b c: bin): $ badd a b c $ > $ G ⇒ fv nvf (enc_bin c) = nadd (fv nvf (enc_bin a)) (fv nvf (enc_bin b)) $;

--| The semantics of `baddc` (addition with a carry), by induction on the first tree and inversion.
theorem lrel_baddc_sem (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_baddc t1 t2 t3 ∈ lrel $ > $ G ⇒ fv nvf t3 = suc (nadd (fv nvf t1) (fv nvf t2)) $;

--| `baddc a b c`: the number of `c` is the sum of `a`'s and `b`'s, plus one.
theorem baddc_sem (G: hyps) (a b c: bin): $ baddc a b c $ > $ G ⇒ fv nvf (enc_bin c) = suc (nadd (fv nvf (enc_bin a)) (fv nvf (enc_bin b))) $;



--| The semantics of `bmul`, by induction on the second tree and inversion.
theorem lrel_bmul_sem (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bmul t1 t2 t3 ∈ lrel $ > $ G ⇒ fv nvf t3 = nmul (fv nvf t1) (fv nvf t2) $;

--| `bmul a b c`: the number of `c` is the product of `a`'s and `b`'s.
theorem bmul_sem (G: hyps) (a b c: bin): $ bmul a b c $ > $ G ⇒ fv nvf (enc_bin c) = nmul (fv nvf (enc_bin a)) (fv nvf (enc_bin b)) $;

--| The semantics of `bpow`, by induction on the second tree and inversion.
theorem lrel_bpow_sem (G: hyps) (t1 t2 t3: set):
  $ G ⇒ ra_bpow t1 t2 t3 ∈ lrel $ > $ G ⇒ fv nvf t3 = npow (fv nvf t1) (fv nvf t2) $;

--| `bpow a b c`: the number of `c` is `a`'s to the power of `b`'s.
theorem bpow_sem (G: hyps) (a b c: bin): $ bpow a b c $ > $ G ⇒ fv nvf (enc_bin c) = npow (fv nvf (enc_bin a)) (fv nvf (enc_bin b)) $;


-- --------------------------------------------------------------------------
-- The literal rules
-- --------------------------------------------------------------------------

--| An atom of `jmod` is a judgment of the model (the converse of `jmod_i`).
theorem jmod_e (M: class) (G: ctx) (e e2 A: expr): $ deq_j (jmod M) G e e2 A $ > $ mdeq M G e e2 A $;


--| The premises of the relations that state Lean's defining equations, back from the relations (their clauses
--| inverted): `X_eqs_pk` is premise `k` of the clause `X_eqs_i`.

theorem add_eqs_p1 (J: class) (G: ctx) (f: expr): $ add_eqs_j J G f $ > $ closed nz f $;

theorem add_eqs_p2 (J: class) (G: ctx) (f: expr): $ add_eqs_j J G f $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

theorem add_eqs_p3 (J: class) (G: ctx) (f: expr): $ add_eqs_j J G f $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $;

theorem add_eqs_p4 (J: class) (G: ctx) (f: expr): $ add_eqs_j J G f $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app nat_succ (app (app f (bvar n1)) (bvar nz))) nat_ty $;

theorem pred_eqs_p1 (J: class) (G: ctx) (p: expr): $ pred_eqs_j J G p $ > $ closed nz p $;

theorem pred_eqs_p2 (J: class) (G: ctx) (p: expr): $ pred_eqs_j J G p $ > $ ty_j J G p (pi nat_ty nat_ty) $;

theorem pred_eqs_p3 (J: class) (G: ctx) (p: expr): $ pred_eqs_j J G p $ > $ deq_j J G (app p nat_zero) nat_zero nat_ty $;

theorem pred_eqs_p4 (J: class) (G: ctx) (p: expr): $ pred_eqs_j J G p $ > $ deq_j J (cons nat_ty G) (app p (app nat_succ (bvar nz))) (bvar nz) nat_ty $;

theorem sub_eqs_p1 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ pred_eqs_j J G p $;

theorem sub_eqs_p2 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ closed nz f $;

theorem sub_eqs_p3 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

theorem sub_eqs_p4 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $;

theorem sub_eqs_p5 (J: class) (G: ctx) (f p: expr): $ sub_eqs_j J G f p $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app p (app (app f (bvar n1)) (bvar nz))) nat_ty $;

theorem mul_eqs_p1 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ add_eqs_j J G fa $;

theorem mul_eqs_p2 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ closed nz f $;

theorem mul_eqs_p3 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

theorem mul_eqs_p4 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) nat_zero nat_ty $;

theorem mul_eqs_p5 (J: class) (G: ctx) (f fa: expr): $ mul_eqs_j J G f fa $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fa (app (app f (bvar n1)) (bvar nz))) (bvar n1)) nat_ty $;

theorem pow_eqs_p1 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ mul_eqs_j J G fm fa $;

theorem pow_eqs_p2 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ closed nz f $;

theorem pow_eqs_p3 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

theorem pow_eqs_p4 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (app nat_succ nat_zero) nat_ty $;

theorem pow_eqs_p5 (J: class) (G: ctx) (f fm fa: expr): $ pow_eqs_j J G f fm fa $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fm (app (app f (bvar n1)) (bvar nz))) (bvar n1)) nat_ty $;

theorem beq_eqs_p1 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ closed nz f $;

theorem beq_eqs_p2 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ closed nz B $;

theorem beq_eqs_p3 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ closed nz t $;

theorem beq_eqs_p4 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ closed nz u $;

theorem beq_eqs_p5 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ ty_j J G f (pi nat_ty (pi nat_ty B)) $;

theorem beq_eqs_p6 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ deq_j J G (app (app f nat_zero) nat_zero) t B $;

theorem beq_eqs_p7 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty G) (app (app f nat_zero) (app nat_succ (bvar nz))) u B $;

theorem beq_eqs_p8 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty G) (app (app f (app nat_succ (bvar nz))) nat_zero) u B $;

theorem beq_eqs_p9 (J: class) (G: ctx) (f B t u: expr): $ beq_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (app nat_succ (bvar n1))) (app nat_succ (bvar nz))) (app (app f (bvar n1)) (bvar nz)) B $;

theorem ble_eqs_p1 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ closed nz f $;

theorem ble_eqs_p2 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ closed nz B $;

theorem ble_eqs_p3 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ closed nz t $;

theorem ble_eqs_p4 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ closed nz u $;

theorem ble_eqs_p5 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ ty_j J G f (pi nat_ty (pi nat_ty B)) $;

theorem ble_eqs_p6 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty G) (app (app f nat_zero) (bvar nz)) t B $;

theorem ble_eqs_p7 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty G) (app (app f (app nat_succ (bvar nz))) nat_zero) u B $;

theorem ble_eqs_p8 (J: class) (G: ctx) (f B t u: expr): $ ble_eqs_j J G f B t u $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (app nat_succ (bvar n1))) (app nat_succ (bvar nz))) (app (app f (bvar n1)) (bvar nz)) B $;

theorem shl_eqs_p1 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ mul_eqs_j J G fm fa $;

theorem shl_eqs_p2 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ closed nz f $;

theorem shl_eqs_p3 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

theorem shl_eqs_p4 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $;

theorem shl_eqs_p5 (J: class) (G: ctx) (f fm fa: expr): $ shl_eqs_j J G f fm fa $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app f (app (app fm (lit (bd0 (bd1 b0)))) (bvar n1))) (bvar nz)) nat_ty $;

theorem shr_eqs_p1 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ closed nz f $;

theorem shr_eqs_p2 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ closed nz fd $;

theorem shr_eqs_p3 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ ty_j J G f (pi nat_ty (pi nat_ty nat_ty)) $;

theorem shr_eqs_p4 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ deq_j J (cons nat_ty G) (app (app f (bvar nz)) nat_zero) (bvar nz) nat_ty $;

theorem shr_eqs_p5 (J: class) (G: ctx) (f fd: expr): $ shr_eqs_j J G f fd $ > $ deq_j J (cons nat_ty (cons nat_ty G)) (app (app f (bvar n1)) (app nat_succ (bvar nz))) (app (app fd (app (app f (bvar n1)) (bvar nz))) (lit (bd0 (bd1 b0)))) nat_ty $;






--| The rule `nat_add_lit` in the model: a function with `Nat.add`'s defining equations adds literals.
theorem madd_lit (H: class) (G: ctx) (f: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ add_eqs_j (jmod (mcv H)) G f $ > $ badd a b c $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

--| The rule `nat_mul_lit` in the model.
theorem mmul_lit (H: class) (G: ctx) (f fa: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ mul_eqs_j (jmod (mcv H)) G f fa $ > $ bmul a b c $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

--| The rule `nat_pow_lit` in the model.
theorem mpow_lit (H: class) (G: ctx) (f fm fa: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ pow_eqs_j (jmod (mcv H)) G f fm fa $ > $ bpow a b c $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;



--| The rule `nat_sub_lit` in the model.
theorem msub_lit (H: class) (G: ctx) (f fp: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ sub_eqs_j (jmod (mcv H)) G f fp $ > $ badd c b a $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;

--| The rule `nat_sub_lit0` in the model.
theorem msub_lit0 (H: class) (G: ctx) (f fp: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ sub_eqs_j (jmod (mcv H)) G f fp $ > $ badd a c b $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit b0) nat_ty $;



--| The rule `nat_shr_lit_z` in the model.
theorem mshr_lit_z (H: class) (G: ctx) (f fd: expr) (a: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ shr_eqs_j (jmod (mcv H)) G f fd $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b0)) (lit a) nat_ty $;

--| The rule `nat_shr_lit_s` in the model.
theorem mshr_lit_s (H: class) (G: ctx) (f fd: expr) (a b b2 c c2: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ shr_eqs_j (jmod (mcv H)) G f fd $ > $ bsucc b b2 $ > $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $ > $ mdeq (mcv H) G (app (app fd (lit c)) (lit (bd0 (bd1 b0)))) (lit c2) nat_ty $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b2)) (lit c2) nat_ty $;



--| The rule `nat_shl_lit` in the model.
theorem mshl_lit (H: class) (G: ctx) (f fm fa: expr) (a b pwr c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ shl_eqs_j (jmod (mcv H)) G f fm fa $ > $ bpow (bd0 (bd1 b0)) b pwr $ > $ bmul a pwr c $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (lit c) nat_ty $;



--| The rule `nat_beq_lit` in the model.
theorem mbeq_lit (H: class) (G: ctx) (f B vt vf: expr) (a: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ beq_eqs_j (jmod (mcv H)) G f B vt vf $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit a)) (vt) (B) $;

--| The rule `nat_beq_lit_lt` in the model.
theorem mbeq_lit_lt (H: class) (G: ctx) (f B vt vf: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ beq_eqs_j (jmod (mcv H)) G f B vt vf $ > $ baddc a c b $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (vf) (B) $;

--| The rule `nat_beq_lit_gt` in the model.
theorem mbeq_lit_gt (H: class) (G: ctx) (f B vt vf: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ beq_eqs_j (jmod (mcv H)) G f B vt vf $ > $ baddc b c a $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (vf) (B) $;

--| The rule `nat_ble_lit` in the model.
theorem mble_lit (H: class) (G: ctx) (f B vt vf: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ ble_eqs_j (jmod (mcv H)) G f B vt vf $ > $ badd a c b $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (vt) (B) $;

--| The rule `nat_ble_lit_gt` in the model.
theorem mble_lit_gt (H: class) (G: ctx) (f B vt vf: expr) (a b c: bin):
  $ _ ⇒ hind H $ > $ _ ⇒ hlit ⊆ H $ > $ ble_eqs_j (jmod (mcv H)) G f B vt vf $ > $ baddc b c a $ >
  $ mdeq (mcv H) G (app (app f (lit a)) (lit b)) (vf) (B) $;



theorem dec_eqs_p1 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF: expr): $ dec_eqs_j J G B t u Not Dec dite T R ofT ofF $ > $ closed nz B $;

theorem dec_eqs_p2 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF: expr): $ dec_eqs_j J G B t u Not Dec dite T R ofT ofF $ > $ closed nz t $;

theorem dec_eqs_p3 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF: expr): $ dec_eqs_j J G B t u Not Dec dite T R ofT ofF $ > $ closed nz u $;

theorem dec_eqs_p4 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF: expr): $ dec_eqs_j J G B t u Not Dec dite T R ofT ofF $ > $ closed nz Not $;

theorem dec_eqs_p5 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF: expr): $ dec_eqs_j J G B t u Not Dec dite T R ofT ofF $ > $ closed nz Dec $;

theorem dec_eqs_p6 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF: expr): $ dec_eqs_j J G B t u Not Dec dite T R ofT ofF $ > $ closed nz dite $;

theorem dec_eqs_p7 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF: expr): $ dec_eqs_j J G B t u Not Dec dite T R ofT ofF $ > $ closed nz T $;

theorem dec_eqs_p8 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF: expr): $ dec_eqs_j J G B t u Not Dec dite T R ofT ofF $ > $ closed nz R $;

