theorem bitwise_eqs_p20 (J: class) (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec: expr): $ bitwise_eqs_j J G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec $ > $ deq_j J (cons (pi al (pi (app (app ltN (app hm (bvar nz))) (app hm (app (app pack (bvar n2)) (bvar n1)))) (app motive (bvar n1)))) (cons nat_ty (cons nat_ty (cons (pi B (pi B B)) G)))) (app (app (app Fb (bvar n3)) (app (app pack (bvar n2)) (bvar n1))) (bvar nz)) (app (app (app (app dite (app (app eqN (bvar n2)) lit0)) (app (app deqN (bvar n2)) lit0)) (lam (app (app eqN (bvar n2)) lit0) (app (app (app (app dite (app bp (app (app (bvar n4) u) t))) (app bd (app (app (bvar n4) u) t))) (lam (app bp (app (app (bvar n4) u) t)) (bvar n3))) (lam (app Not (app bp (app (app (bvar n4) u) t))) lit0)))) (lam (app Not (app (app eqN (bvar n2)) lit0)) (app (app (app (app dite (app (app eqN (bvar n2)) lit0)) (app (app deqN (bvar n2)) lit0)) (lam (app (app eqN (bvar n2)) lit0) (app (app (app (app dite (app bp (app (app (bvar n5) t) u))) (app bd (app (app (bvar n5) t) u))) (lam (app bp (app (app (bvar n5) t) u)) (bvar n5))) (lam (app Not (app bp (app (app (bvar n5) t) u))) lit0)))) (lam (app Not (app (app eqN (bvar n2)) lit0)) (app (app (app (app dite (app bp (app (app (bvar n5) (app (app dec (app (app eqN (app (app fm (bvar n4)) lit2)) lit1)) (app (app deqN (app (app fm (bvar n4)) lit2)) lit1))) (app (app dec (app (app eqN (app (app fm (bvar n3)) lit2)) lit1)) (app (app deqN (app (app fm (bvar n3)) lit2)) lit1))))) (app bd (app (app (bvar n5) (app (app dec (app (app eqN (app (app fm (bvar n4)) lit2)) lit1)) (app (app deqN (app (app fm (bvar n4)) lit2)) lit1))) (app (app dec (app (app eqN (app (app fm (bvar n3)) lit2)) lit1)) (app (app deqN (app (app fm (bvar n3)) lit2)) lit1))))) (lam (app bp (app (app (bvar n5) (app (app dec (app (app eqN (app (app fm (bvar n4)) lit2)) lit1)) (app (app deqN (app (app fm (bvar n4)) lit2)) lit1))) (app (app dec (app (app eqN (app (app fm (bvar n3)) lit2)) lit1)) (app (app deqN (app (app fm (bvar n3)) lit2)) lit1)))) (app (app fa (app (app fa (app (app (bvar n3) (app (app pack (app (app fd (bvar n5)) lit2)) (app (app fd (bvar n4)) lit2))) (app (app (app pfB (bvar n5)) (bvar n4)) (bvar n2)))) (app (app (bvar n3) (app (app pack (app (app fd (bvar n5)) lit2)) (app (app fd (bvar n4)) lit2))) (app (app (app pfB (bvar n5)) (bvar n4)) (bvar n2))))) lit1))) (lam (app Not (app bp (app (app (bvar n5) (app (app dec (app (app eqN (app (app fm (bvar n4)) lit2)) lit1)) (app (app deqN (app (app fm (bvar n4)) lit2)) lit1))) (app (app dec (app (app eqN (app (app fm (bvar n3)) lit2)) lit1)) (app (app deqN (app (app fm (bvar n3)) lit2)) lit1))))) (app (app fa (app (app (bvar n3) (app (app pack (app (app fd (bvar n5)) lit2)) (app (app fd (bvar n4)) lit2))) (app (app (app pfB (bvar n5)) (bvar n4)) (bvar n2)))) (app (app (bvar n3) (app (app pack (app (app fd (bvar n5)) lit2)) (app (app fd (bvar n4)) lit2))) (app (app (app pfB (bvar n5)) (bvar n4)) (bvar n2)))))))))) (app motive (app (app pack (bvar n2)) (bvar n1))) $;

