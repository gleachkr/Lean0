----
l1: $ G ⇒ ⟨ ∅ , ra_bdbl ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ = ⟨ pp , ra_bdbl t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bdbl t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_bdbl ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_bdbl t1 t2 = ra_bdbl ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bdbl t1 t2 = ra_bdbl ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l14, l15]
l17: $ G ⇒ kr_bdbl ∈ ω $ by x1_kr_bdbl
l18: $ G ⇒ isset kr_bdbl $ by wcel_isset [l17]
l19: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l20: $ G ⇒ isset (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅)) $ by wcel_isset [l16]
l21: $ G ⇒ kr_bdbl = kr_bdbl ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅) $ by opair_inj_c [l8, l18, l19, l18, l20]
l22: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅) $ by and_elim_r [l21]
l23: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_b0 , ∅ ⟩ ∅ $ by y1_scons_inj [l22, l12, l14, l11, l15]
l24: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l23]
l25: $ G ⇒ scons t2 ∅ = scons ⟨ kc_b0 , ∅ ⟩ ∅ $ by and_elim_r [l23]
l26: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l25, l10, l14, l9, l9]
l27: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l26]
l28: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_intro [l24, l27]

lemma y1_d_bdbl_0 (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_0 ⇒ x ∊ cl_bdbl_0 $ by ax
l2: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_0 ⇒ (x = ⟨ ∅ , ra_bdbl ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_0 ⇒ x = ⟨ pp , ra_bdbl t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_0 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_0 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ = ⟨ ∅ , ra_bdbl ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_0 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_0 ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) $ by y1_e_bdbl_0 [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) $ by wcel_elim [#1, l7]

