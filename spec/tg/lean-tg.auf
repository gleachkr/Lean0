l8: $ kr_proj_eq ≐ kr_proj_eq $ by ceqt_refl
l9: $ ra_proj_eq A1 A2 A3 A4 A5 A6 ≐ ra_proj_eq B1 B2 B3 B4 B5 B6 $ by opair_congr [l8, l7]

--| @rewrite
lemma y1_sb_proj_eq {x: set} (t: set x) (A1 A2 A3 A4 A5 A6: class x):
  $ (⟦ x / t ⟧ (ra_proj_eq A1 A2 A3 A4 A5 A6)) ≐ ra_proj_eq (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) (⟦ x / t ⟧ A6) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_proj_eq , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 ∅))))) ⟩) ≐ ⟨ kr_proj_eq , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) (scons (⟦ x / t ⟧ A6) ∅))))) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_eta_eq (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ A5 ≐ B5 $ >
  $ ra_eta_eq A1 A2 A3 A4 A5 ≐ ra_eta_eq B1 B2 B3 B4 B5 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A5 ∅ ≐ scons B5 ∅ $ by scons_congr [#5, l1]
l3: $ scons A4 (scons A5 ∅) ≐ scons B4 (scons B5 ∅) $ by scons_congr [#4, l2]
l4: $ scons A3 (scons A4 (scons A5 ∅)) ≐ scons B3 (scons B4 (scons B5 ∅)) $ by scons_congr [#3, l3]
l5: $ scons A2 (scons A3 (scons A4 (scons A5 ∅))) ≐ scons B2 (scons B3 (scons B4 (scons B5 ∅))) $ by scons_congr [#2, l4]
l6: $ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) ≐ scons B1 (scons B2 (scons B3 (scons B4 (scons B5 ∅)))) $ by scons_congr [#1, l5]
l7: $ kr_eta_eq ≐ kr_eta_eq $ by ceqt_refl
l8: $ ra_eta_eq A1 A2 A3 A4 A5 ≐ ra_eta_eq B1 B2 B3 B4 B5 $ by opair_congr [l7, l6]

--| @rewrite
lemma y1_sb_eta_eq {x: set} (t: set x) (A1 A2 A3 A4 A5: class x):
  $ (⟦ x / t ⟧ (ra_eta_eq A1 A2 A3 A4 A5)) ≐ ra_eta_eq (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) (⟦ x / t ⟧ A5) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_eta_eq , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) ⟩) ≐ ⟨ kr_eta_eq , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) (scons (⟦ x / t ⟧ A5) ∅)))) ⟩ $ by ceqt_refl

