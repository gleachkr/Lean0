lemma y1_k_indapp_i (G: hyps): $ G ⇒ cl_indapp_i ⊆ y1_lab kr_indapp (suc kr_indapp) $
----
l1: $ G , x ∊ cl_indapp_i ⇒ x ∊ cl_indapp_i $ by ax
l2: $ G , x ∊ cl_indapp_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_spine ⟨ kc_bvar , scons b ∅ ⟩ i f) (scons (ra_add v u a) (scons (ra_add a w b) (scons (ra_le ⟨ kc_s , scons w ∅ ⟩ z) (scons (ra_pargs ⟨ kc_bvar , scons b ∅ ⟩ v u g) (scons (ra_nidx y w c) (scons (ra_iargs a c g i) ∅)))))) , ra_indapp y z u v i w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_spine ⟨ kc_bvar , scons b ∅ ⟩ i f) (scons (ra_add v u a) (scons (ra_add a w b) (scons (ra_le ⟨ kc_s , scons w ∅ ⟩ z) (scons (ra_pargs ⟨ kc_bvar , scons b ∅ ⟩ v u g) (scons (ra_nidx y w c) (scons (ra_iargs a c g i) ∅)))))) , ra_indapp y z u v i w ⟩ ⇒ x = ⟨ scons (ra_spine ⟨ kc_bvar , scons b ∅ ⟩ i f) (scons (ra_add v u a) (scons (ra_add a w b) (scons (ra_le ⟨ kc_s , scons w ∅ ⟩ z) (scons (ra_pargs ⟨ kc_bvar , scons b ∅ ⟩ v u g) (scons (ra_nidx y w c) (scons (ra_iargs a c g i) ∅)))))) , ra_indapp y z u v i w ⟩ $ by ax
