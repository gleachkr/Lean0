l32: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_z , w = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ F C ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = F ∧ q4 = C $ by and_intro [l27, l31]
l33: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_z , w = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ F C ⟩ ⇒ q1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = F ∧ q4 = C $ by and_intro [l25, l32]
l34: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_z , w = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ F C ⟩ ⇒ ∀ F ∀ C ∀ T (q1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = F ∧ q4 = C → ph) $ by weaken [#3]
l35: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_z , w = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ F C ⟩ ⇒ ∀ C ∀ T (q1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = F ∧ q4 = C → ph) $ by all_elim [l34]
l36: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_z , w = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ F C ⟩ ⇒ ∀ T (q1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = F ∧ q4 = C → ph) $ by all_elim [l35]
