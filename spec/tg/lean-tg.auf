lemma y2_spine2_e2 {x y: set} (GG: hyps x y) (q1 q2 q3 w1 w3 u_h u_e u_a u_k v_h v_e v_a v_k: set):
  $ GG ⇒ q1 = u_h $ > $ GG ⇒ q2 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ $ > $ GG ⇒ q3 = ⟨ kc_s , scons u_k ∅ ⟩ $ > $ GG ⇒ ra_spine u_h u_e u_k ∈ lrel $ > $ GG ⇒ ra_spine u_h u_e u_k ∈ y2_P_spine2 lrel $ > $ GG ⇒ w1 = v_h $ > $ GG ⇒ q2 = ⟨ kc_app , scons v_e (scons v_a ∅) ⟩ $ > $ GG ⇒ w3 = ⟨ kc_s , scons v_k ∅ ⟩ $ > $ GG ⇒ ra_spine v_h v_e v_k ∈ lrel $ > $ GG ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ q1 = w1 ∧ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ = q2 $ by eq_sym [#2]
