lemma y2_nidx_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_nidx lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_nidx lrel → c ∊ y2_P_nidx lrel) $ by y2_nidx_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_nidx lrel $ by horn_ind [l1, l2]

lrel_nidx_det
-------------
l1: $ G ⇒ horn lprog ⊆ y2_P_nidx lrel $ by y2_nidx_in
