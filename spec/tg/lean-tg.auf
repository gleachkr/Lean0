l38: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ ra_capp d a e ∈ lrel $ by and_elim_r [l36]
l39: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q3 = w3 $ by y2_capp_e2 [l25, l27, l29, l31, l32, l33, l35, l37, l38]
l40: $ GG , ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by ax
l41: $ GG , ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l40, l39]
l42: $ GG , ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by ax
l43: $ GG , ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l42, l41]
l44: $ GG , ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by ax
l45: $ GG , ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l44, l43]
l46: $ GG , ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by ax
l47: $ GG , ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l46, l45]
l48: $ GG ⇒ q3 = w3 $ by or_elim [l1, l22, l47]

lemma y2_capp_d2 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_capp q1 q2 q3 ⟩ ∈ cl_capp_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_capp lrel $ > $ GG ⇒ ra_capp q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel $ by ax
l2: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel ⇒ ra_capp q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel ⇒ q3 = w3 $ by y2_capp_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel → q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ ∀ b ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel → q3 = w3) $ by all_intro [l6]
l8: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = d ∧ q3 = ⟨ kc_cons , scons a (scons e ∅) ⟩ ∧ ra_capp b d e ∈ lrel ∧ ra_capp b d e ∈ y2_P_capp lrel → q3 = w3) $ by all_intro [l7]
l9: $ GG ⇒ q3 = w3 $ by y2_capp_i2 [#1, #2, l8]

lemma y2_capp_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_capp lrel → c ∊ y2_P_capp lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ c = ra_capp x1 x2 x3 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_capp x1 x2 x3 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ pr_capp $ by lprog_capp_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_capp lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ ra_capp x1 x2 x6 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel , ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_nil ⇒ ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_nil $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel , ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_nil ⇒ crn o ⊆ horn lprog ∩ y2_P_capp lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel , ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_nil ⇒ ra_capp x1 x2 x6 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel , ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_nil ⇒ x3 = x6 $ by y2_capp_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel , ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_cons ⇒ ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_cons $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel , ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_cons ⇒ crn o ⊆ horn lprog ∩ y2_P_capp lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel , ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_cons ⇒ ra_capp x1 x2 x6 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel , ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_cons ⇒ x3 = x6 $ by y2_capp_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_cons → x3 = x6 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_capp x1 x2 x3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons → x3 = x6 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 , ra_capp x1 x2 x6 ∈ lrel ⇒ x3 = x6 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 ⇒ ra_capp x1 x2 x6 ∈ lrel → x3 = x6 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel , c = ra_capp x1 x2 x3 ⇒ ∀ x6 (⟨ kr_capp , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel ⇒ c = ⟨ kr_capp , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by imp_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel ⇒ ∀ x3 (c = ⟨ kr_capp , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_capp , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_capp , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_capp lrel ⇒ c ∊ y2_P_capp lrel $ by cab_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_capp lrel → c ∊ y2_P_capp lrel $ by imp_intro [l26]
l28: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_capp lrel → c ∊ y2_P_capp lrel $ by imp_intro [l27]
l29: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_capp lrel → c ∊ y2_P_capp lrel) $ by all_intro [l28]
l30: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_capp lrel → c ∊ y2_P_capp lrel) $ by all_intro [l29]

lemma y2_capp_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_capp lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_capp lrel → c ∊ y2_P_capp lrel) $ by y2_capp_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_capp lrel $ by horn_ind [l1, l2]

lrel_capp_det
-------------
l1: $ G ⇒ horn lprog ⊆ y2_P_capp lrel $ by y2_capp_in
l2: $ G ⇒ ra_capp t1 t2 u3 ∈ y2_P_capp lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u3 = v3 $ by y2_capp_ih [l2, #2]

--| The atoms of `npis` whose variants in `L` with the same inputs have the same outputs.
def y2_P_npis (L: class) (.c .x1 .x2 .x6: set): class = $ {c | ∀ x1 ∀ x2 (c = ⟨ kr_npis , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_npis , scons x1 (scons x6 ∅) ⟩ ∈ L → x2 = x6))} $

lemma y2_npis_ih (GG: hyps) (q1 q2 w2: set):
  $ GG ⇒ ra_npis q1 q2 ∈ y2_P_npis lrel $ > $ GG ⇒ ra_npis q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ c ∊ y2_P_npis lrel $ by ax
l2: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ ∀ x1 ∀ x2 (c = ⟨ kr_npis , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_npis , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ ∀ x2 (c = ⟨ kr_npis , scons q1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_npis , scons q1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ c = ⟨ kr_npis , scons q1 (scons q2 ∅) ⟩ → ∀ x6 (⟨ kr_npis , scons q1 (scons x6 ∅) ⟩ ∈ lrel → q2 = x6) $ by all_elim [l3]
l5: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ c = ra_npis q1 q2 $ by ax
l6: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ ∀ x6 (⟨ kr_npis , scons q1 (scons x6 ∅) ⟩ ∈ lrel → q2 = x6) $ by imp_elim [l4, l5]
l7: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ ra_npis q1 w2 ∈ lrel → q2 = w2 $ by all_elim [l6]
l8: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ ra_npis q1 w2 ∈ lrel $ by weaken [#2]
l9: $ GG , c = ra_npis q1 q2 , c ∊ y2_P_npis lrel ⇒ q2 = w2 $ by imp_elim [l7, l8]
l10: $ GG ⇒ q2 = w2 $ by wcel_elim [#1, l9]

lemma y2_npis_ihc (GG: hyps) (Q1 Q2 W2: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset W2 $ > $ GG ⇒ ra_npis Q1 Q2 ∈ y2_P_npis lrel $ > $ GG ⇒ ra_npis Q1 W2 ∈ lrel $ > $ GG ⇒ Q2 = W2 $
----
l1: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ d = W2 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q1 = a $ by eq_sym [l1]
l5: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = b $ by eq_sym [l2]
l6: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ W2 = d $ by eq_sym [l3]
l7: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ∅ = ∅ $ by eq_refl
l8: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ scons Q2 ∅ = scons b ∅ $ by scons_eq [l5, l7]
l9: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ scons Q1 (scons Q2 ∅) = scons a (scons b ∅) $ by scons_eq [l4, l8]
l10: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ kr_npis = kr_npis $ by eq_refl
l11: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_npis Q1 Q2 = ra_npis a b $ by opair_eq [l10, l9]
l12: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_npis Q1 Q2 ∈ y2_P_npis lrel $ by weaken [#4]
l13: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_npis a b ∈ y2_P_npis lrel $ by wcel_eq_l [l11, l12]
l14: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_npis Q1 W2 ∈ lrel $ by weaken [#5]
l15: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_npis a d ∈ lrel $ by x1_eq_npis [l14, l4, l6]
l16: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ b = d $ by y2_npis_ih [l13, l15]
l17: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = d $ by eq_trans [l5, l16]
l18: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = W2 $ by eq_trans [l17, l3]
l19: $ GG , a = Q1 , b = Q2 ⇒ Q2 = W2 $ by isset_elim [#3, l18]
l20: $ GG , a = Q1 ⇒ Q2 = W2 $ by isset_elim [#2, l19]
l21: $ GG ⇒ Q2 = W2 $ by isset_elim [#1, l20]

lemma y2_npis_i1 (GG: hyps) {i: set} (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_npis q1 q2 ⟩ ∈ cl_npis_bvar $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ > $ GG ⇒ ∀ i (q1 = ⟨ kc_bvar , scons i ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar ⇒ w ∊ cl_npis_bvar $ by ax
l2: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar ⇒ ∃ i (w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_npis q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_npis q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_npis q1 q2 ⟩ = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_npis q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ ∧ ra_npis q1 q2 = ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ kr_npis , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_npis , scons ⟨ kc_bvar , scons i ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_npis ∈ ω $ by x1_kr_npis
l15: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset kr_npis $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_bvar , scons i ∅ ⟩ $ by opair_isset
l19: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l20: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_bvar , scons i ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by y2_nd2 [l13, l15, l16, l17, l18, l19]
l21: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_bvar , scons i ∅ ⟩ $ by and_elim_l [l20]
l22: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l20]
l23: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_bvar , scons i ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l21, l22]
l24: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∀ i (q1 = ⟨ kc_bvar , scons i ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph) $ by weaken [#3]
l25: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_bvar , scons i ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph $ by all_elim [l24]
l26: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar , w = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons i ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ph $ by imp_elim [l25, l23]
l27: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_bvar ⇒ ph $ by ex_elim [l2, l26]
l28: $ GG ⇒ ph $ by wcel_elim [#1, l27]

lemma y2_npis_e1 (GG: hyps) (q1 q2 w2 u_i v_i: set):
  $ GG ⇒ q1 = ⟨ kc_bvar , scons u_i ∅ ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q1 = ⟨ kc_bvar , scons v_i ∅ ⟩ $ > $ GG ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_bvar , scons u_i ∅ ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_bvar , scons u_i ∅ ⟩ = ⟨ kc_bvar , scons v_i ∅ ⟩ $ by eq_trans [l1, #3]
l3: $ GG ⇒ kc_bvar ∈ ω $ by v1_kc_bvar
l4: $ GG ⇒ isset kc_bvar $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_i $ by isset_var
l6: $ GG ⇒ isset v_i $ by isset_var
l7: $ GG ⇒ u_i = v_i $ by y2_nd1 [l2, l4, l5, l6]
l8: $ GG ⇒ ∅ = ∅ $ by eq_refl
l9: $ GG ⇒ kc_nz = kc_nz $ by eq_refl
l10: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by opair_eq [l9, l8]
l11: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = w2 $ by eq_sym [#4]
l12: $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [#2, l10]
l13: $ GG ⇒ q2 = w2 $ by eq_trans [l12, l11]

lemma y2_npis_c1 (GG: hyps) (q1 q2 w2 u_i: set):
  $ GG ⇒ q1 = ⟨ kc_bvar , scons u_i ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ ra_npis q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
