lemma y1_p_closed (G: hyps): $ G ⇒ pr_closed ⊆ y1_lab kr_closed (suc kr_closed) $
----
l1: $ G ⇒ cl_closed_quot_ind ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_quot_ind
l2: $ G ⇒ cl_closed_quot_lift ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_quot_lift
l3: $ G ⇒ cl_closed_quot_lift ∪ cl_closed_quot_ind ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_closed_quot_mk ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_quot_mk
l5: $ G ⇒ cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind) ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l4, l3]
l6: $ G ⇒ cl_closed_quot ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_quot
l7: $ G ⇒ cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind)) ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l6, l5]
l8: $ G ⇒ cl_closed_proj ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_proj
l9: $ G ⇒ cl_closed_proj ∪ (cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind))) ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l8, l7]
l10: $ G ⇒ cl_closed_ind_rec ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_ind_rec
l11: $ G ⇒ cl_closed_ind_rec ∪ (cl_closed_proj ∪ (cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind)))) ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l10, l9]
l12: $ G ⇒ cl_closed_ind_ctor ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_ind_ctor
l13: $ G ⇒ cl_closed_ind_ctor ∪ (cl_closed_ind_rec ∪ (cl_closed_proj ∪ (cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind))))) ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l12, l11]
l14: $ G ⇒ cl_closed_ind_ty ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_ind_ty
l15: $ G ⇒ cl_closed_ind_ty ∪ (cl_closed_ind_ctor ∪ (cl_closed_ind_rec ∪ (cl_closed_proj ∪ (cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind)))))) ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l14, l13]
l16: $ G ⇒ cl_closed_lit ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_lit
l17: $ G ⇒ cl_closed_lit ∪ (cl_closed_ind_ty ∪ (cl_closed_ind_ctor ∪ (cl_closed_ind_rec ∪ (cl_closed_proj ∪ (cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind))))))) ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l16, l15]
l18: $ G ⇒ cl_closed_cst ⊆ y1_lab kr_closed (suc kr_closed) $ by y1_k_closed_cst
