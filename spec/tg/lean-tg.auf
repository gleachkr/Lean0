l29: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 (scons t10 (scons t11 ∅))))))))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
