lemma y1_o_inst (G: hyps) {k_v i_v a_v a2 l_v f_v x_v f2 x2_v A b_v A2 b2 j_v e_v e2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ ∈ pr_inst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ i_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨ ∃ k_v ∃ a_v ∃ a2 (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons k_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a2 ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ a_v a2 ∈ lrel) ∨ ∃ k_v ∃ i_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons ⟨ kc_s , scons i_v ∅ ⟩ ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel) ∨ ∃ k_v ∃ l_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨ ∃ k_v ∃ f_v ∃ x_v ∃ a_v ∃ f2 ∃ x2_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons x_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_app , scons f2 (scons x2_v ∅) ⟩ ∧ ra_inst k_v f_v a_v f2 ∈ lrel ∧ ra_inst k_v x_v a_v x2_v ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) ∨ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ ∈ cl_inst_proj ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ ∈ cl_inst_proj $ by ax
