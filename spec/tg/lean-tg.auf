l8: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = ⟨ kc_cons , scons u_A (scons u_G2 ∅) ⟩ $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ ra_capp u_P u_G u_G2 ∈ lrel ∧ ra_capp u_P u_G u_G2 ∈ y2_P_capp lrel $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ ra_capp u_P u_G u_G2 ∈ lrel $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ ra_capp u_P u_G u_G2 ∈ y2_P_capp lrel $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l2]
l13: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = a ∧ w3 = a $ by and_elim_r [l2]
l14: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = a $ by and_elim_l [l13]
l15: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ w3 = a $ by and_elim_r [l13]
l16: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ kc_nil ∈ kc_cons $ by y2_lt_nil_cons
l17: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ kc_cons ∈ ω $ by v1_kc_cons
l18: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ isset kc_cons $ by wcel_isset [l17]
l19: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ ⊥ $ by y2_ne [l12, l4, l16, l18]
l20: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = w3 $ by bot_elim [l19]
l21: $ GG , ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ⇒ ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) $ by ax
l22: $ GG , ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l21, l20]
