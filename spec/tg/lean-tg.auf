lemma y1_o_nfields (G: hyps) {D b_v P T i_v c_v nf F K C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ ∈ pr_nfields $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ c_v ∃ nf ∃ F ∃ K ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = nf ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ c_v ∃ nf ∃ F ∃ K ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = nf ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel) $ by y1_d_nfields_i [#1, #2]

lemma y1_e_ndecl_nil (G: hyps) {n_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ V1 V1 ⟩ = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ndecl t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_ndecl ⟨ kc_nil , ∅ ⟩ V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_ndecl t1 t2 t3 = ra_ndecl ⟨ kc_nil , ∅ ⟩ V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ndecl t1 t2 t3 = ra_ndecl ⟨ kc_nil , ∅ ⟩ V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_ndecl ∈ ω $ by x1_kr_ndecl
l22: $ G ⇒ isset kr_ndecl $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_ndecl = kr_ndecl ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) $ by ex_intro [l36]

lemma y1_d_ndecl_nil (G: hyps) {n_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) $
----
l1: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x ∊ cl_ndecl_nil ⇒ x ∊ cl_ndecl_nil $ by ax
l2: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x ∊ cl_ndecl_nil ⇒ ∃ y (x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) $ by y1_e_ndecl_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x ∊ cl_ndecl_nil ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) $ by wcel_elim [#1, l9]

lemma y1_e_ndecl_cons (G: hyps) {X N n_v n0: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ = ⟨ scons (ra_ndecl V2 V3 V4) ∅ , ra_ndecl ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ndecl V2 V3 V4) ∅ , ra_ndecl ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4 ⟩ = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ndecl V2 V3 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ndecl t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_ndecl ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ndecl V2 V3 V4) ∅ ∧ ra_ndecl t1 t2 t3 = ra_ndecl ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ndecl V2 V3 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ndecl t1 t2 t3 = ra_ndecl ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V4 $ by isset_var
l17: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_ndecl ∈ ω $ by x1_kr_ndecl
l23: $ G ⇒ isset kr_ndecl $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_ndecl = kr_ndecl ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ scons t3 ∅ = scons V4 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V4 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V4 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_ndecl V2 V3 V4) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_ndecl V2 V3 V4) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_ndecl V2 V3 V4) $ by opair_isset
l39: $ G ⇒ ra_ndecl V2 V3 V4 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V4 ∧ ra_ndecl V2 V3 V4 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ t3 = V4 ∧ ra_ndecl V2 V3 V4 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ t3 = V4 ∧ ra_ndecl V2 V3 V4 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ n0 (t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl V2 V3 n0 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl V2 n_v n0 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons V1 (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by ex_intro [l45]

lemma y1_d_ndecl_cons (G: hyps) {X N n_v n0: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x ∊ cl_ndecl_cons ⇒ x ∊ cl_ndecl_cons $ by ax
l2: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x ∊ cl_ndecl_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by y1_e_ndecl_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ndecl t1 t2 t3 ⟩ , x ∊ cl_ndecl_cons ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_ndecl (G: hyps) {n_v X N n0: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ pr_ndecl $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) ∨ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons $ by ax
l2: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by y1_d_ndecl_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons → ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons $ by ax
l6: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∨ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil $ by ax
l8: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) $ by y1_d_ndecl_nil [l7, l8]
l10: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) ∨ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons $ by ax
l12: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons → ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons ⇒ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_cons ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) ∨ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) ∨ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ndecl t1 t2 t3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons → ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) ∨ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ n_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = n_v ∧ t3 = n_v) ∨ ∃ X ∃ N ∃ n_v ∃ n0 (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = n0 ∧ ra_ndecl N n_v n0 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_aux_of_i (G: hyps) {D N j_v np n_v m_v n0 k_v X: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7 V8 V9: set):
  $ G ⇒ ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅))) , ra_aux_of V1 V2 V3 V9 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅))) , ra_aux_of V1 V2 V3 V9 ⟩ = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅)))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_aux_of t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_aux_of V1 V2 V3 V9) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅))) ∧ ra_aux_of t1 t2 t3 t4 = ra_aux_of V1 V2 V3 V9 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_aux_of t1 t2 t3 t4 = ra_aux_of V1 V2 V3 V9 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V9 $ by isset_var
l19: $ G ⇒ scons V9 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V3 $ by isset_var
l21: $ G ⇒ scons V3 (scons V9 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons V3 (scons V9 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V9 ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_aux_of ∈ ω $ by x1_kr_aux_of
l27: $ G ⇒ isset kr_aux_of $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V9 ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_aux_of = kr_aux_of ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V3 (scons V9 ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V3 (scons V9 ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V3 (scons V9 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V3 (scons V9 ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons V3 (scons V9 ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V3 (scons V9 ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V3 ∧ scons t4 ∅ = scons V9 ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V3 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons V9 ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = V9 ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = V9 $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅)))) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅)))) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_ind_arity V1 V4 V5 V6) $ by opair_isset
l46: $ G ⇒ ra_ind_arity V1 V4 V5 V6 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_ndecl V2 V5 V7) (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅))) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_ndecl V2 V5 V7) $ by opair_isset
l49: $ G ⇒ ra_ndecl V2 V5 V7 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ crn (scons (ra_add V7 V8 V3) (scons (ra_cnth V2 V8 V9) ∅)) ⊆ lrel $ by crn_scons_tail [l47]
l51: $ G ⇒ isset (ra_add V7 V8 V3) $ by opair_isset
l52: $ G ⇒ ra_add V7 V8 V3 ∈ lrel $ by crn_scons_head [l51, l50]
l53: $ G ⇒ crn (scons (ra_cnth V2 V8 V9) ∅) ⊆ lrel $ by crn_scons_tail [l50]
l54: $ G ⇒ isset (ra_cnth V2 V8 V9) $ by opair_isset
l55: $ G ⇒ ra_cnth V2 V8 V9 ∈ lrel $ by crn_scons_head [l54, l53]
l56: $ G ⇒ ra_add V7 V8 V3 ∈ lrel ∧ ra_cnth V2 V8 V9 ∈ lrel $ by and_intro [l52, l55]
l57: $ G ⇒ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_add V7 V8 V3 ∈ lrel ∧ ra_cnth V2 V8 V9 ∈ lrel $ by and_intro [l49, l56]
l58: $ G ⇒ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_add V7 V8 V3 ∈ lrel ∧ ra_cnth V2 V8 V9 ∈ lrel $ by and_intro [l46, l57]
l59: $ G ⇒ t4 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_add V7 V8 V3 ∈ lrel ∧ ra_cnth V2 V8 V9 ∈ lrel $ by and_intro [l42, l58]
l60: $ G ⇒ t3 = V3 ∧ t4 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_add V7 V8 V3 ∈ lrel ∧ ra_cnth V2 V8 V9 ∈ lrel $ by and_intro [l39, l59]
l61: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_add V7 V8 V3 ∈ lrel ∧ ra_cnth V2 V8 V9 ∈ lrel $ by and_intro [l36, l60]
l62: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_add V7 V8 V3 ∈ lrel ∧ ra_cnth V2 V8 V9 ∈ lrel $ by and_intro [l33, l61]
l63: $ G ⇒ ∃ X (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = X ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_add V7 V8 V3 ∈ lrel ∧ ra_cnth V2 V8 X ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ k_v ∃ X (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = X ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_add V7 k_v V3 ∈ lrel ∧ ra_cnth V2 k_v X ∈ lrel) $ by ex_intro [l63]
l65: $ G ⇒ ∃ n0 ∃ k_v ∃ X (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = X ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 n0 ∈ lrel ∧ ra_add n0 k_v V3 ∈ lrel ∧ ra_cnth V2 k_v X ∈ lrel) $ by ex_intro [l64]
l66: $ G ⇒ ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = X ∧ ra_ind_arity V1 V4 V5 m_v ∈ lrel ∧ ra_ndecl V2 V5 n0 ∈ lrel ∧ ra_add n0 k_v V3 ∈ lrel ∧ ra_cnth V2 k_v X ∈ lrel) $ by ex_intro [l65]
l67: $ G ⇒ ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = X ∧ ra_ind_arity V1 V4 n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_add n0 k_v V3 ∈ lrel ∧ ra_cnth V2 k_v X ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = X ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_add n0 k_v V3 ∈ lrel ∧ ra_cnth V2 k_v X ∈ lrel) $ by ex_intro [l67]
l69: $ G ⇒ ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = V1 ∧ t2 = V2 ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth V2 k_v X ∈ lrel) $ by ex_intro [l68]
l70: $ G ⇒ ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = V1 ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_intro [l69]
l71: $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_intro [l70]

lemma y1_d_aux_of_i (G: hyps) {D N j_v np n_v m_v n0 k_v X: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ ∈ cl_aux_of_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x ∊ cl_aux_of_i ⇒ x ∊ cl_aux_of_i $ by ax
l2: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x ∊ cl_aux_of_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by y1_e_aux_of_i [l6, l7]
