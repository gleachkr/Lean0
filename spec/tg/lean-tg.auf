l22: $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_e_afree_ind_ctor (G: hyps) {D N j_v c_v np n_v m_v n0: set} (pp t1 V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅))) , ra_afree ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅))) , ra_afree ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅)))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅))) ∧ ra_afree t1 = ra_afree ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ crn pp = crn (scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅)))) $ by crn_eq [l7]
l23: $ G ⇒ crn (scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅)))) ⊆ lrel $ by subset_eq_l [l22, #2]
l24: $ G ⇒ isset (ra_ind_nested V1 V2) $ by opair_isset
l25: $ G ⇒ ra_ind_nested V1 V2 ∈ lrel $ by crn_scons_head [l24, l23]
l26: $ G ⇒ crn (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅))) ⊆ lrel $ by crn_scons_tail [l23]
l27: $ G ⇒ isset (ra_ind_arity V1 V5 V6 V7) $ by opair_isset
l28: $ G ⇒ ra_ind_arity V1 V5 V6 V7 ∈ lrel $ by crn_scons_head [l27, l26]
l29: $ G ⇒ crn (scons (ra_ndecl V2 V6 V8) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅)) ⊆ lrel $ by crn_scons_tail [l26]
l30: $ G ⇒ isset (ra_ndecl V2 V6 V8) $ by opair_isset
l31: $ G ⇒ ra_ndecl V2 V6 V8 ∈ lrel $ by crn_scons_head [l30, l29]
l32: $ G ⇒ crn (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) ∅) ⊆ lrel $ by crn_scons_tail [l29]
l33: $ G ⇒ isset (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8) $ by opair_isset
l34: $ G ⇒ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8 ∈ lrel $ by crn_scons_head [l33, l32]
l35: $ G ⇒ ra_ndecl V2 V6 V8 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8 ∈ lrel $ by and_intro [l31, l34]
l36: $ G ⇒ ra_ind_arity V1 V5 V6 V7 ∈ lrel ∧ ra_ndecl V2 V6 V8 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8 ∈ lrel $ by and_intro [l28, l35]
l37: $ G ⇒ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V5 V6 V7 ∈ lrel ∧ ra_ndecl V2 V6 V8 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8 ∈ lrel $ by and_intro [l25, l36]
l38: $ G ⇒ t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V5 V6 V7 ∈ lrel ∧ ra_ndecl V2 V6 V8 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V8 ∈ lrel $ by and_intro [l21, l37]
l39: $ G ⇒ ∃ n0 (t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V5 V6 V7 ∈ lrel ∧ ra_ndecl V2 V6 n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l38]
l40: $ G ⇒ ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V5 V6 m_v ∈ lrel ∧ ra_ndecl V2 V6 n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l39]
l41: $ G ⇒ ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V5 n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l40]
l42: $ G ⇒ ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l41]
l43: $ G ⇒ ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons V1 (scons V3 (scons c_v ∅)) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ j_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons V1 (scons j_v (scons c_v ∅)) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ N ∃ j_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons V1 (scons j_v (scons c_v ∅)) ⟩ ∧ ra_ind_nested V1 N ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ D ∃ N ∃ j_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l45]

lemma y1_d_afree_ind_ctor (G: hyps) {D N j_v c_v np n_v m_v n0: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_ind_ctor $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_ind_ctor ⇒ x ∊ cl_afree_ind_ctor $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_ind_ctor ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
