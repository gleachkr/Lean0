lemma y1_d_bxor_10 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ ∈ cl_bxor_10 $ > $ G ⇒ crn pp ⊆ lrel $ >
