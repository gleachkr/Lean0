l47: $ G , x = ⟨ pp , ra_proj_eq t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_proj_eq_i ⇒ ∃ D ∃ b_v ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $ by ex_elim [l2, l46]
l48: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $ by wcel_elim [#1, l47]

lemma y1_o_proj_eq (G: hyps) {D b_v P X Dl T j_v i_v np n_v m_v nf k_v F K K2 res c1 maj C: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_proj_eq t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_proj_eq $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $ by y1_d_proj_eq_i [#1, #2]

lemma y1_e_eta_eq_i (G: hyps) {D b_v P T j_v np nf S0 S Y M: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11: set):
  $ G ⇒ ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V6) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V6 V8) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V9) (scons (ra_rehead ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ V6 V9 V10) (scons (ra_nfields V1 V5 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V7 V10 V11) ∅)))))) , ra_eta_eq V1 V5 ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ V11 V9 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ nf ∃ S0 ∃ S ∃ Y ∃ M (t1 = D ∧ t2 = j_v ∧ t3 = ⟨ kc_cons , scons S0 (scons P ∅) ⟩ ∧ t4 = M ∧ t5 = S ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ⟨ kc_nz , ∅ ⟩ np S0 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ S0 S ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ np S Y ∈ lrel ∧ ra_nfields D j_v ⟨ kc_nz , ∅ ⟩ nf ∈ lrel ∧ ra_projs b_v ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ nf Y M ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V6) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V6 V8) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V9) (scons (ra_rehead ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ V6 V9 V10) (scons (ra_nfields V1 V5 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V7 V10 V11) ∅)))))) , ra_eta_eq V1 V5 ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ V11 V9 ⟩ = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V6) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V6 V8) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V9) (scons (ra_rehead ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ V6 V9 V10) (scons (ra_nfields V1 V5 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V7 V10 V11) ∅))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eta_eq t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_eta_eq V1 V5 ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ V11 V9) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V6) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V6 V8) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V9) (scons (ra_rehead ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ V6 V9 V10) (scons (ra_nfields V1 V5 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V7 V10 V11) ∅)))))) ∧ ra_eta_eq t1 t2 t3 t4 t5 = ra_eta_eq V1 V5 ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ V11 V9 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V6) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V6 V8) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V9) (scons (ra_rehead ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ V6 V9 V10) (scons (ra_nfields V1 V5 ⟨ kc_nz , ∅ ⟩ V7) (scons (ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V7 V10 V11) ∅)))))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_eta_eq t1 t2 t3 t4 t5 = ra_eta_eq V1 V5 ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ V11 V9 $ by and_elim_r [l6]
