l28: $ G ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ ∈ cl_mwalk_pi_nr ∪ (cl_mwalk_pi_rec ∪ cl_mwalk_res) → ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ Ihs ∃ A ∃ A3 ∃ B ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A A3 ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ r_v Ihs B Min ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ j_v ∃ a_v ∃ sh ∃ fld ∃ mo ∃ Ihs ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A2 A3 ∈ lrel ∧ ra_add r_v nf a_v ∈ lrel ∧ ra_add sh d_v a_v ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_add a_v k_v mo ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihty D np n_v mo fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_s , scons r_v ∅ ⟩ ⟨ kc_cons , scons IH (scons Ihs ∅) ⟩ B Min ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ h0 ∃ h1 ∃ h_v ∃ ni ∃ mi ∃ a_v ∃ b_v ∃ Ihs ∃ K ∃ K2 ∃ K3 ∃ Y ∃ X ∃ Y1 ∃ Y2 ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = d_v ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = K ∧ t12 = Min ∧ ra_add d_v np dp ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_add dp i_v h0 ∈ lrel ∧ ra_add h0 kn h1 ∈ lrel ∧ ra_add h1 r_v h_v ∈ lrel ∧ ra_lift kn d_v K K2 ∈ lrel ∧ ra_lift r_v ⟨ kc_nz , ∅ ⟩ K2 K3 ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mi ∅ ⟩ ni K3 X ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons h_v ∅ ⟩ Y np ∈ lrel ∧ ra_add r_v d_v a_v ∈ lrel ∧ ra_add a_v kn b_v ∈ lrel ∧ ra_add mi ⟨ kc_s , scons i_v ∅ ⟩ b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ b_v np Y1 ∈ lrel ∧ ra_pargs Y1 r_v d_v Y2 ∈ lrel ∧ ra_pis Ihs ⟨ kc_app , scons X (scons Y2 ∅) ⟩ Min ∈ lrel) $ by imp_intro [l27]
l29: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ Ihs ∃ A ∃ A3 ∃ B ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A A3 ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ r_v Ihs B Min ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ j_v ∃ a_v ∃ sh ∃ fld ∃ mo ∃ Ihs ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A2 A3 ∈ lrel ∧ ra_add r_v nf a_v ∈ lrel ∧ ra_add sh d_v a_v ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_add a_v k_v mo ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihty D np n_v mo fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_s , scons r_v ∅ ⟩ ⟨ kc_cons , scons IH (scons Ihs ∅) ⟩ B Min ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ h0 ∃ h1 ∃ h_v ∃ ni ∃ mi ∃ a_v ∃ b_v ∃ Ihs ∃ K ∃ K2 ∃ K3 ∃ Y ∃ X ∃ Y1 ∃ Y2 ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = d_v ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = K ∧ t12 = Min ∧ ra_add d_v np dp ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_add dp i_v h0 ∈ lrel ∧ ra_add h0 kn h1 ∈ lrel ∧ ra_add h1 r_v h_v ∈ lrel ∧ ra_lift kn d_v K K2 ∈ lrel ∧ ra_lift r_v ⟨ kc_nz , ∅ ⟩ K2 K3 ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mi ∅ ⟩ ni K3 X ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons h_v ∅ ⟩ Y np ∈ lrel ∧ ra_add r_v d_v a_v ∈ lrel ∧ ra_add a_v kn b_v ∈ lrel ∧ ra_add mi ⟨ kc_s , scons i_v ∅ ⟩ b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ b_v np Y1 ∈ lrel ∧ ra_pargs Y1 r_v d_v Y2 ∈ lrel ∧ ra_pis Ihs ⟨ kc_app , scons X (scons Y2 ∅) ⟩ Min ∈ lrel) $ by imp_elim [l28, #1]

lemma y1_e_cminors_nil (G: hyps) {D np n_v k_v i_v c_v: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ ∅ , ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cminors t1 t2 t3 t4 t5 t6 t7 t8) $ by opair_isset
l5: $ G ⇒ isset (ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 = ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 = ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t8 $ by isset_var
l11: $ G ⇒ scons t8 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t7 $ by isset_var
l13: $ G ⇒ scons t7 (scons t8 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t6 $ by isset_var
l15: $ G ⇒ scons t6 (scons t7 (scons t8 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t5 $ by isset_var
l17: $ G ⇒ scons t5 (scons t6 (scons t7 (scons t8 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t4 $ by isset_var
l19: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t3 $ by isset_var
l21: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset t2 $ by isset_var
l23: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset t1 $ by isset_var
l25: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l27: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l26, l9]
l28: $ G ⇒ isset ⟨ kc_cnil , ∅ ⟩ $ by opair_isset
l29: $ G ⇒ scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V6 $ by isset_var
l31: $ G ⇒ scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V5 $ by isset_var
l33: $ G ⇒ scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ isset V4 $ by isset_var
l35: $ G ⇒ scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l34, l33]
l36: $ G ⇒ isset V3 $ by isset_var
l37: $ G ⇒ scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) ∈ fseq y1_vv $ by y1_fs [l36, l35]
l38: $ G ⇒ isset V2 $ by isset_var
l39: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))))) ∈ fseq y1_vv $ by y1_fs [l38, l37]
l40: $ G ⇒ isset V1 $ by isset_var
l41: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))))) ∈ fseq y1_vv $ by y1_fs [l40, l39]
l42: $ G ⇒ kr_cminors ∈ ω $ by x1_kr_cminors
l43: $ G ⇒ isset kr_cminors $ by wcel_isset [l42]
l44: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))))) $ by wcel_isset [l25]
l45: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))))))) $ by wcel_isset [l41]
l46: $ G ⇒ kr_cminors = kr_cminors ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))))) $ by opair_inj_c [l8, l43, l44, l43, l45]
l47: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))))) $ by and_elim_r [l46]
l48: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))))) $ by y1_scons_inj [l47, l24, l40, l23, l39]
l49: $ G ⇒ t1 = V1 $ by and_elim_l [l48]
l50: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))))) $ by and_elim_r [l48]
l51: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) $ by y1_scons_inj [l50, l22, l38, l21, l37]
l52: $ G ⇒ t2 = V2 $ by and_elim_l [l51]
l53: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) $ by and_elim_r [l51]
l54: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) $ by y1_scons_inj [l53, l20, l36, l19, l35]
l55: $ G ⇒ t3 = V3 $ by and_elim_l [l54]
l56: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))) = scons V4 (scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) $ by and_elim_r [l54]
l57: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 (scons t8 ∅))) = scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by y1_scons_inj [l56, l18, l34, l17, l33]
l58: $ G ⇒ t4 = V4 $ by and_elim_l [l57]
l59: $ G ⇒ scons t5 (scons t6 (scons t7 (scons t8 ∅))) = scons V5 (scons V6 (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by and_elim_r [l57]
