lemma y1_k_rst_ctor (G: hyps): $ G ⇒ cl_rst_ctor ⊆ y1_lab kr_rst (suc kr_rst) $
----
l1: $ G , x ∊ cl_rst_ctor ⇒ x ∊ cl_rst_ctor $ by ax
l2: $ G , x ∊ cl_rst_ctor ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ kr_rst ∈ ω $ by x1_kr_rst
l5: $ G , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) ⇒ ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) $ by ax
l7: $ G , ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l6, l5]
l8: $ G , ∃ m ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) ⇒ ∃ m ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) $ by ax
