l1: $ G ⇒ cl_mwalk_res ⊆ y1_lab kr_mwalk (suc kr_mwalk) $ by y1_k_mwalk_res
l2: $ G ⇒ cl_mwalk_pi_rec ⊆ y1_lab kr_mwalk (suc kr_mwalk) $ by y1_k_mwalk_pi_rec
l3: $ G ⇒ cl_mwalk_pi_rec ∪ cl_mwalk_res ⊆ y1_lab kr_mwalk (suc kr_mwalk) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_mwalk_pi_nr ⊆ y1_lab kr_mwalk (suc kr_mwalk) $ by y1_k_mwalk_pi_nr
l5: $ G ⇒ pr_mwalk ⊆ y1_lab kr_mwalk (suc kr_mwalk) $ by cun_least [l4, l3]

lemma y1_k_cminors_nil (G: hyps): $ G ⇒ cl_cminors_nil ⊆ y1_lab kr_cminors (suc kr_cminors) $
----
l1: $ G , x ∊ cl_cminors_nil ⇒ x ∊ cl_cminors_nil $ by ax
l2: $ G , x ∊ cl_cminors_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ kr_cminors ∈ ω $ by x1_kr_cminors
l5: $ G , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_cminors (suc kr_cminors) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_cminors (suc kr_cminors) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_cminors (suc kr_cminors) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_cminors (suc kr_cminors) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_cminors (suc kr_cminors) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_cminors (suc kr_cminors) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_cminors_nil ⇒ x ∊ y1_lab kr_cminors (suc kr_cminors) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_cminors_nil ⊆ y1_lab kr_cminors (suc kr_cminors) $ by subset_intro [l16]

