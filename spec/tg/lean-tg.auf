l20: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) $ by ax
l22: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) $ by ax
l24: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by ex_elim [l23, l22]
l25: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_hit ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by ex_elim [l2, l24]
l26: $ G ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by wcel_elim [#1, l25]

lemma y1_e_spz_app (G: hyps) {D N d_v f_v a_v f2 a2: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 V3 V5 V7) ∅) , ra_spz V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 V3 V5 V7) ∅) , ra_spz V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ⟩ = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 V3 V5 V7) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_spz t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_spz V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟨ kc_app , scons V6 (scons V7 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 V3 V5 V7) ∅) ∧ ra_spz t1 t2 t3 t4 t5 = ra_spz V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 V3 V5 V7) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_spz t1 t2 t3 t4 t5 = ra_spz V1 V2 V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V3 $ by isset_var
l25: $ G ⇒ scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V2 $ by isset_var
l27: $ G ⇒ scons V2 (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V1 $ by isset_var
l29: $ G ⇒ scons V1 (scons V2 (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ kr_spz ∈ ω $ by x1_kr_spz
l31: $ G ⇒ isset kr_spz $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_spz = kr_spz ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
l43: $ G ⇒ t3 = V3 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ scons t5 ∅ = scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅ $ by y1_scons_inj [l44, l12, l22, l11, l21]
l46: $ G ⇒ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l47, l10, l20, l9, l9]
l49: $ G ⇒ t5 = ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ $ by and_elim_l [l48]
l50: $ G ⇒ crn pp = crn (scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 V3 V5 V7) ∅)) $ by crn_eq [l7]
l51: $ G ⇒ crn (scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 V3 V5 V7) ∅)) ⊆ lrel $ by subset_eq_l [l50, #2]
l52: $ G ⇒ isset (ra_spz V1 V2 V3 V4 V6) $ by opair_isset
l53: $ G ⇒ ra_spz V1 V2 V3 V4 V6 ∈ lrel $ by crn_scons_head [l52, l51]
l54: $ G ⇒ crn (scons (ra_spz V1 V2 V3 V5 V7) ∅) ⊆ lrel $ by crn_scons_tail [l51]
l55: $ G ⇒ isset (ra_spz V1 V2 V3 V5 V7) $ by opair_isset
l56: $ G ⇒ ra_spz V1 V2 V3 V5 V7 ∈ lrel $ by crn_scons_head [l55, l54]
l57: $ G ⇒ ra_spz V1 V2 V3 V4 V6 ∈ lrel ∧ ra_spz V1 V2 V3 V5 V7 ∈ lrel $ by and_intro [l53, l56]
l58: $ G ⇒ t5 = ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∧ ra_spz V1 V2 V3 V4 V6 ∈ lrel ∧ ra_spz V1 V2 V3 V5 V7 ∈ lrel $ by and_intro [l49, l57]
l59: $ G ⇒ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∧ ra_spz V1 V2 V3 V4 V6 ∈ lrel ∧ ra_spz V1 V2 V3 V5 V7 ∈ lrel $ by and_intro [l46, l58]
l60: $ G ⇒ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∧ ra_spz V1 V2 V3 V4 V6 ∈ lrel ∧ ra_spz V1 V2 V3 V5 V7 ∈ lrel $ by and_intro [l43, l59]
l61: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∧ ra_spz V1 V2 V3 V4 V6 ∈ lrel ∧ ra_spz V1 V2 V3 V5 V7 ∈ lrel $ by and_intro [l40, l60]
l62: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V6 (scons V7 ∅) ⟩ ∧ ra_spz V1 V2 V3 V4 V6 ∈ lrel ∧ ra_spz V1 V2 V3 V5 V7 ∈ lrel $ by and_intro [l37, l61]
l63: $ G ⇒ ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V6 (scons a2 ∅) ⟩ ∧ ra_spz V1 V2 V3 V4 V6 ∈ lrel ∧ ra_spz V1 V2 V3 V5 a2 ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz V1 V2 V3 V4 f2 ∈ lrel ∧ ra_spz V1 V2 V3 V5 a2 ∈ lrel) $ by ex_intro [l63]
l65: $ G ⇒ ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz V1 V2 V3 V4 f2 ∈ lrel ∧ ra_spz V1 V2 V3 a_v a2 ∈ lrel) $ by ex_intro [l64]
l66: $ G ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz V1 V2 V3 f_v f2 ∈ lrel ∧ ra_spz V1 V2 V3 a_v a2 ∈ lrel) $ by ex_intro [l65]
l67: $ G ⇒ ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz V1 V2 d_v f_v f2 ∈ lrel ∧ ra_spz V1 V2 d_v a_v a2 ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz V1 N d_v f_v f2 ∈ lrel ∧ ra_spz V1 N d_v a_v a2 ∈ lrel) $ by ex_intro [l67]
l69: $ G ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by ex_intro [l68]

lemma y1_d_spz_app (G: hyps) {D N d_v f_v a_v f2 a2: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_app ⇒ x ∊ cl_spz_app $ by ax
l2: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩ ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by y1_e_spz_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u v a) (scons (ra_spz y z u w b) ∅) , ra_spz y z u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟨ kc_app , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_app ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_e_spz_lam (G: hyps) {D N d_v A b_v A2 b2: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 ⟨ kc_s , scons V3 ∅ ⟩ V5 V7) ∅) , ra_spz V1 V2 V3 ⟨ kc_lam , scons V4 (scons V5 ∅) ⟩ ⟨ kc_lam , scons V6 (scons V7 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 ⟨ kc_s , scons V3 ∅ ⟩ V5 V7) ∅) , ra_spz V1 V2 V3 ⟨ kc_lam , scons V4 (scons V5 ∅) ⟩ ⟨ kc_lam , scons V6 (scons V7 ∅) ⟩ ⟩ = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 ⟨ kc_s , scons V3 ∅ ⟩ V5 V7) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_spz t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_spz V1 V2 V3 ⟨ kc_lam , scons V4 (scons V5 ∅) ⟩ ⟨ kc_lam , scons V6 (scons V7 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 ⟨ kc_s , scons V3 ∅ ⟩ V5 V7) ∅) ∧ ra_spz t1 t2 t3 t4 t5 = ra_spz V1 V2 V3 ⟨ kc_lam , scons V4 (scons V5 ∅) ⟩ ⟨ kc_lam , scons V6 (scons V7 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_spz V1 V2 V3 V4 V6) (scons (ra_spz V1 V2 ⟨ kc_s , scons V3 ∅ ⟩ V5 V7) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_spz t1 t2 t3 t4 t5 = ra_spz V1 V2 V3 ⟨ kc_lam , scons V4 (scons V5 ∅) ⟩ ⟨ kc_lam , scons V6 (scons V7 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
