l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_lsubst_gt ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_lsubst_gt ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by subset_intro [l10]

lemma y1_p_lsubst (G: hyps): $ G ⇒ pr_lsubst ⊆ y1_lab kr_lsubst (suc kr_lsubst) $
----
l1: $ G ⇒ cl_lsubst_gt ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_k_lsubst_gt
l2: $ G ⇒ cl_lsubst_lt ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_k_lsubst_lt
l3: $ G ⇒ cl_lsubst_lt ∪ cl_lsubst_gt ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_lsubst_eq ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_k_lsubst_eq
l5: $ G ⇒ cl_lsubst_eq ∪ (cl_lsubst_lt ∪ cl_lsubst_gt) ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by cun_least [l4, l3]
l6: $ G ⇒ cl_lsubst_imax ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_k_lsubst_imax
l7: $ G ⇒ cl_lsubst_imax ∪ (cl_lsubst_eq ∪ (cl_lsubst_lt ∪ cl_lsubst_gt)) ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by cun_least [l6, l5]
l8: $ G ⇒ cl_lsubst_max ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_k_lsubst_max
l9: $ G ⇒ cl_lsubst_max ∪ (cl_lsubst_imax ∪ (cl_lsubst_eq ∪ (cl_lsubst_lt ∪ cl_lsubst_gt))) ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by cun_least [l8, l7]
l10: $ G ⇒ cl_lsubst_s ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_k_lsubst_s
l11: $ G ⇒ cl_lsubst_s ∪ (cl_lsubst_max ∪ (cl_lsubst_imax ∪ (cl_lsubst_eq ∪ (cl_lsubst_lt ∪ cl_lsubst_gt)))) ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by cun_least [l10, l9]
l12: $ G ⇒ cl_lsubst_z ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_k_lsubst_z
l13: $ G ⇒ pr_lsubst ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by cun_least [l12, l11]

lemma y1_k_closed_bvar (G: hyps): $ G ⇒ cl_closed_bvar ⊆ y1_lab kr_closed (suc kr_closed) $
----
l1: $ G , x ∊ cl_closed_bvar ⇒ x ∊ cl_closed_bvar $ by ax
l2: $ G , x ∊ cl_closed_bvar ⇒ ∃ y ∃ z (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ kr_closed ∈ ω $ by x1_kr_closed
l5: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_closed_bvar ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_closed_bvar ⊆ y1_lab kr_closed (suc kr_closed) $ by subset_intro [l8]

