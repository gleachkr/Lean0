l88: $ G ⇒ ∃ np ∃ nf ∃ S0 ∃ S ∃ Y ∃ M (t1 = V1 ∧ t2 = V5 ∧ t3 = ⟨ kc_cons , scons S0 (scons V3 ∅) ⟩ ∧ t4 = M ∧ t5 = S ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ np S0 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ S0 S ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons V5 (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ np S Y ∈ lrel ∧ ra_nfields V1 V5 ⟨ kc_nz , ∅ ⟩ nf ∈ lrel ∧ ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ nf Y M ∈ lrel) $ by ex_intro [l87]
l89: $ G ⇒ ∃ j_v ∃ np ∃ nf ∃ S0 ∃ S ∃ Y ∃ M (t1 = V1 ∧ t2 = j_v ∧ t3 = ⟨ kc_cons , scons S0 (scons V3 ∅) ⟩ ∧ t4 = M ∧ t5 = S ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ⟨ kc_nz , ∅ ⟩ np S0 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ S0 S ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ np S Y ∈ lrel ∧ ra_nfields V1 j_v ⟨ kc_nz , ∅ ⟩ nf ∈ lrel ∧ ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ nf Y M ∈ lrel) $ by ex_intro [l88]
l90: $ G ⇒ ∃ T ∃ j_v ∃ np ∃ nf ∃ S0 ∃ S ∃ Y ∃ M (t1 = V1 ∧ t2 = j_v ∧ t3 = ⟨ kc_cons , scons S0 (scons V3 ∅) ⟩ ∧ t4 = M ∧ t5 = S ∧ ra_ind_data V1 V2 V3 T ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ⟨ kc_nz , ∅ ⟩ np S0 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ S0 S ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ np S Y ∈ lrel ∧ ra_nfields V1 j_v ⟨ kc_nz , ∅ ⟩ nf ∈ lrel ∧ ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ nf Y M ∈ lrel) $ by ex_intro [l89]
l91: $ G ⇒ ∃ P ∃ T ∃ j_v ∃ np ∃ nf ∃ S0 ∃ S ∃ Y ∃ M (t1 = V1 ∧ t2 = j_v ∧ t3 = ⟨ kc_cons , scons S0 (scons P ∅) ⟩ ∧ t4 = M ∧ t5 = S ∧ ra_ind_data V1 V2 P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ⟨ kc_nz , ∅ ⟩ np S0 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ S0 S ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ np S Y ∈ lrel ∧ ra_nfields V1 j_v ⟨ kc_nz , ∅ ⟩ nf ∈ lrel ∧ ra_projs V2 ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ nf Y M ∈ lrel) $ by ex_intro [l90]
l92: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ nf ∃ S0 ∃ S ∃ Y ∃ M (t1 = V1 ∧ t2 = j_v ∧ t3 = ⟨ kc_cons , scons S0 (scons P ∅) ⟩ ∧ t4 = M ∧ t5 = S ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ⟨ kc_nz , ∅ ⟩ np S0 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ S0 S ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ⟨ kc_ind_ctor , scons V1 (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ np S Y ∈ lrel ∧ ra_nfields V1 j_v ⟨ kc_nz , ∅ ⟩ nf ∈ lrel ∧ ra_projs b_v ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ nf Y M ∈ lrel) $ by ex_intro [l91]
l93: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ nf ∃ S0 ∃ S ∃ Y ∃ M (t1 = D ∧ t2 = j_v ∧ t3 = ⟨ kc_cons , scons S0 (scons P ∅) ⟩ ∧ t4 = M ∧ t5 = S ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ⟨ kc_nz , ∅ ⟩ np S0 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ S0 S ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ np S Y ∈ lrel ∧ ra_nfields D j_v ⟨ kc_nz , ∅ ⟩ nf ∈ lrel ∧ ra_projs b_v ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ nf Y M ∈ lrel) $ by ex_intro [l92]

lemma y1_d_eta_eq_i (G: hyps) {D b_v P T j_v np nf S0 S Y M: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ ∈ cl_eta_eq_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ nf ∃ S0 ∃ S ∃ Y ∃ M (t1 = D ∧ t2 = j_v ∧ t3 = ⟨ kc_cons , scons S0 (scons P ∅) ⟩ ∧ t4 = M ∧ t5 = S ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ⟨ kc_nz , ∅ ⟩ np S0 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ S0 S ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ np S Y ∈ lrel ∧ ra_nfields D j_v ⟨ kc_nz , ∅ ⟩ nf ∈ lrel ∧ ra_projs b_v ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ nf Y M ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ , x ∊ cl_eta_eq_i ⇒ x ∊ cl_eta_eq_i $ by ax
l2: $ G , x = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ , x ∊ cl_eta_eq_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u a) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_nz , ∅ ⟩ a c) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c f) (scons (ra_rehead ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_ind_ctor , scons y (scons w (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ a f g) (scons (ra_nfields y w ⟨ kc_nz , ∅ ⟩ b) (scons (ra_projs z ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ b g i) ∅)))))) , ra_eta_eq y w ⟨ kc_cons , scons c (scons u ∅) ⟩ i f ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u a) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_nz , ∅ ⟩ a c) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c f) (scons (ra_rehead ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_ind_ctor , scons y (scons w (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ a f g) (scons (ra_nfields y w ⟨ kc_nz , ∅ ⟩ b) (scons (ra_projs z ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ b g i) ∅)))))) , ra_eta_eq y w ⟨ kc_cons , scons c (scons u ∅) ⟩ i f ⟩ ⇒ x = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u a) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_nz , ∅ ⟩ a c) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c f) (scons (ra_rehead ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_ind_ctor , scons y (scons w (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ a f g) (scons (ra_nfields y w ⟨ kc_nz , ∅ ⟩ b) (scons (ra_projs z ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ b g i) ∅)))))) , ra_eta_eq y w ⟨ kc_cons , scons c (scons u ∅) ⟩ i f ⟩ ⇒ ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u a) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_nz , ∅ ⟩ a c) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c f) (scons (ra_rehead ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_ind_ctor , scons y (scons w (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ a f g) (scons (ra_nfields y w ⟨ kc_nz , ∅ ⟩ b) (scons (ra_projs z ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ b g i) ∅)))))) , ra_eta_eq y w ⟨ kc_cons , scons c (scons u ∅) ⟩ i f ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u a) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_nz , ∅ ⟩ a c) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c f) (scons (ra_rehead ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_ind_ctor , scons y (scons w (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ a f g) (scons (ra_nfields y w ⟨ kc_nz , ∅ ⟩ b) (scons (ra_projs z ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ b g i) ∅)))))) , ra_eta_eq y w ⟨ kc_cons , scons c (scons u ∅) ⟩ i f ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u a) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_nz , ∅ ⟩ a c) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c f) (scons (ra_rehead ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_ind_ctor , scons y (scons w (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ a f g) (scons (ra_nfields y w ⟨ kc_nz , ∅ ⟩ b) (scons (ra_projs z ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ b g i) ∅)))))) , ra_eta_eq y w ⟨ kc_cons , scons c (scons u ∅) ⟩ i f ⟩ ⇒ ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u a) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_nz , ∅ ⟩ a c) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c f) (scons (ra_rehead ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_ind_ctor , scons y (scons w (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ a f g) (scons (ra_nfields y w ⟨ kc_nz , ∅ ⟩ b) (scons (ra_projs z ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ b g i) ∅)))))) , ra_eta_eq y w ⟨ kc_cons , scons c (scons u ∅) ⟩ i f ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eta_eq t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u a) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_nz , ∅ ⟩ a c) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c f) (scons (ra_rehead ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ ⟨ kc_ind_ctor , scons y (scons w (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ a f g) (scons (ra_nfields y w ⟨ kc_nz , ∅ ⟩ b) (scons (ra_projs z ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ b g i) ∅)))))) , ra_eta_eq y w ⟨ kc_cons , scons c (scons u ∅) ⟩ i f ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
