-- The case analyses walk the table entry by entry: an entry of another sort
-- is excluded by the distinctness of the sort labels, an entry of the sort
-- gives its disjunct.

--| Class form of `cun_elim`.
lemma v1_wcel_cun_elim (G: hyps) (P A B: class): $ G ⇒ P ∈ A ∪ B $ > $ G ⇒ P ∈ A ∨ P ∈ B $
----
l1: $ G , z = P , z ∊ A ∪ B ⇒ z ∊ A ∪ B $ by ax
l2: $ G , z = P , z ∊ A ∪ B ⇒ z ∊ A ∨ z ∊ B $ by cun_elim [l1]
l3: $ G , z = P , z ∊ A ∪ B , z ∊ A ⇒ z = P $ by ax
l4: $ G , z = P , z ∊ A ∪ B , z ∊ A ⇒ z ∊ A $ by ax
l5: $ G , z = P , z ∊ A ∪ B , z ∊ A ⇒ P ∈ A $ by wcel_intro [l3, l4]
l6: $ G , z = P , z ∊ A ∪ B , z ∊ A ⇒ P ∈ A ∨ P ∈ B $ by or_intro_l [l5]
l7: $ G , z = P , z ∊ A ∪ B , z ∊ B ⇒ z = P $ by ax
l8: $ G , z = P , z ∊ A ∪ B , z ∊ B ⇒ z ∊ B $ by ax
l9: $ G , z = P , z ∊ A ∪ B , z ∊ B ⇒ P ∈ B $ by wcel_intro [l7, l8]
l10: $ G , z = P , z ∊ A ∪ B , z ∊ B ⇒ P ∈ A ∨ P ∈ B $ by or_intro_r [l9]
l11: $ G , z = P , z ∊ A ∪ B ⇒ P ∈ A ∨ P ∈ B $ by or_elim [l2, l6, l10]
l12: $ G ⇒ P ∈ A ∨ P ∈ B $ by wcel_elim [#1, l11]

--| Case analysis on membership in a union.
lemma v1_cun_imp (G: hyps) (P A B: class) (p: fml):
  $ G , P ∈ A ⇒ p $ > $ G ⇒ P ∈ B → p $ > $ G ⇒ P ∈ A ∪ B → p $
----
l1: $ G , P ∈ A ∪ B ⇒ P ∈ A ∪ B $ by ax
l2: $ G , P ∈ A ∪ B ⇒ P ∈ A ∨ P ∈ B $ by v1_wcel_cun_elim [l1]
l3: $ G , P ∈ A ∪ B , P ∈ A ⇒ p $ by weaken [#1]
l4: $ G , P ∈ A ∪ B , P ∈ B ⇒ P ∈ B $ by ax
l5: $ G , P ∈ A ∪ B , P ∈ B ⇒ P ∈ B → p $ by weaken [#2]
l6: $ G , P ∈ A ∪ B , P ∈ B ⇒ p $ by imp_elim [l5, l4]
l7: $ G , P ∈ A ∪ B ⇒ p $ by or_elim [l2, l3, l6]
l8: $ G ⇒ P ∈ A ∪ B → p $ by imp_intro [l7]

--| The components of a table entry.
lemma v1_ent (G: hyps) (C K A: class) (c k a: set):
  $ G ⇒ isset C $ > $ G ⇒ isset K $ > $ G ⇒ isset A $ >
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ C , ⟨ K , A ⟩ ⟩ $ > $ G ⇒ c = C ∧ k = K ∧ a = A $
----
l1: $ G , z = ⟨ c , ⟨ k , a ⟩ ⟩ , z ∊ csn ⟨ C , ⟨ K , A ⟩ ⟩ ⇒ z ∊ csn ⟨ C , ⟨ K , A ⟩ ⟩ $ by ax
l2: $ G , z = ⟨ c , ⟨ k , a ⟩ ⟩ , z ∊ csn ⟨ C , ⟨ K , A ⟩ ⟩ ⇒ z = ⟨ C , ⟨ K , A ⟩ ⟩ $ by csn_elim [l1]
l3: $ G , z = ⟨ c , ⟨ k , a ⟩ ⟩ , z ∊ csn ⟨ C , ⟨ K , A ⟩ ⟩ ⇒ z = ⟨ c , ⟨ k , a ⟩ ⟩ $ by ax
l4: $ G , z = ⟨ c , ⟨ k , a ⟩ ⟩ , z ∊ csn ⟨ C , ⟨ K , A ⟩ ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ = z $ by eq_sym [l3]
l5: $ G , z = ⟨ c , ⟨ k , a ⟩ ⟩ , z ∊ csn ⟨ C , ⟨ K , A ⟩ ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ = ⟨ C , ⟨ K , A ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ = ⟨ C , ⟨ K , A ⟩ ⟩ $ by wcel_elim [#4, l5]
l7: $ G ⇒ isset c $ by isset_var
l8: $ G ⇒ isset ⟨ k , a ⟩ $ by opair_isset
l9: $ G ⇒ isset ⟨ K , A ⟩ $ by opair_isset
l10: $ G ⇒ c = C ∧ ⟨ k , a ⟩ = ⟨ K , A ⟩ $ by opair_inj_c [l6, l7, l8, #1, l9]
l11: $ G ⇒ c = C $ by and_elim_l [l10]
l12: $ G ⇒ ⟨ k , a ⟩ = ⟨ K , A ⟩ $ by and_elim_r [l10]
l13: $ G ⇒ isset k $ by isset_var
l14: $ G ⇒ isset a $ by isset_var
l15: $ G ⇒ k = K ∧ a = A $ by opair_inj_c [l12, l13, l14, #2, #3]
l16: $ G ⇒ c = C ∧ k = K ∧ a = A $ by and_intro [l11, l15]

--| Distinct labels: a smaller one is an element of a larger one.
lemma v1_ne_lt (G: hyps) (k: set) (A B: class):
  $ G ⇒ k = A $ > $ G ⇒ A ∈ B $ > $ G ⇒ k = B → ⊥ $
----
l1: $ G , k = B ⇒ k = B $ by ax
l2: $ G , k = B ⇒ k = A $ by weaken [#1]
l3: $ G , k = B ⇒ A = k $ by eq_sym [l2]
l4: $ G , k = B ⇒ A = B $ by eq_trans [l3, l1]
l5: $ G , k = B ⇒ A ∈ B $ by weaken [#2]
l6: $ G , k = B ⇒ B = A $ by eq_sym [l4]
l7: $ G , k = B ⇒ A ∈ A $ by wcel_eq_r [l6, l5]
l8: $ G , k = B ⇒ ⊥ $ by notin_self_c [l7]
l9: $ G ⇒ k = B → ⊥ $ by imp_intro [l8]

lemma v1_ne_gt (G: hyps) (k: set) (A B: class):
  $ G ⇒ k = A $ > $ G ⇒ B ∈ A $ > $ G ⇒ k = B → ⊥ $
----
l1: $ G , k = B ⇒ k = B $ by ax
l2: $ G , k = B ⇒ k = A $ by weaken [#1]
l3: $ G , k = B ⇒ A = k $ by eq_sym [l2]
l4: $ G , k = B ⇒ A = B $ by eq_trans [l3, l1]
l5: $ G , k = B ⇒ B ∈ A $ by weaken [#2]
l6: $ G , k = B ⇒ B ∈ B $ by wcel_eq_r [l4, l5]
l7: $ G , k = B ⇒ ⊥ $ by notin_self_c [l6]
l8: $ G ⇒ k = B → ⊥ $ by imp_intro [l7]

--| A sort other than the open ones has no leaves.
lemma v1_lopen_no (G: hyps) (k: set) (p: fml):
  $ G ⇒ k = ks_blk → ⊥ $ > $ G ⇒ k = ks_atom → ⊥ $ > $ G ⇒ k ∊ lopen $ > $ G ⇒ p $
----
l1: $ G ⇒ k = ks_blk ∨ k = ks_atom $ by cpr_elim [#3]
l2: $ G , k = ks_blk ⇒ k = ks_blk $ by ax
l3: $ G , k = ks_blk ⇒ k = ks_blk → ⊥ $ by weaken [#1]
l4: $ G , k = ks_blk ⇒ ⊥ $ by imp_elim [l3, l2]
l5: $ G , k = ks_atom ⇒ k = ks_atom $ by ax
l6: $ G , k = ks_atom ⇒ k = ks_atom → ⊥ $ by weaken [#2]
l7: $ G , k = ks_atom ⇒ ⊥ $ by imp_elim [l6, l5]
l8: $ G ⇒ ⊥ $ by or_elim [l1, l4, l7]
l9: $ G ⇒ p $ by bot_elim [l8]

lemma v1_imp_or_l (G: hyps) (p q r: fml): $ G ⇒ (p ∨ q) → r $ > $ G ⇒ p → r $
----
l1: $ G , p ⇒ p $ by ax
l2: $ G , p ⇒ p ∨ q $ by or_intro_l [l1]
l3: $ G , p ⇒ (p ∨ q) → r $ by weaken [#1]
l4: $ G , p ⇒ r $ by imp_elim [l3, l2]
l5: $ G ⇒ p → r $ by imp_intro [l4]

lemma v1_imp_or_r (G: hyps) (p q r: fml): $ G ⇒ (p ∨ q) → r $ > $ G ⇒ q → r $
----
l1: $ G , q ⇒ q $ by ax
l2: $ G , q ⇒ p ∨ q $ by or_intro_r [l1]
l3: $ G , q ⇒ (p ∨ q) → r $ by weaken [#1]
l4: $ G , q ⇒ r $ by imp_elim [l3, l2]
l5: $ G ⇒ q → r $ by imp_intro [l4]

--| A node of a known constructor: its children have the sorts of the entry (`szip_argsN`).
lemma v1_build0 (G: hyps) (C: class) (c a b t: set):
  $ G ⇒ b ∊ fseq (trees ω) $ > $ G ⇒ cdm b = cdm a $ >
  $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G , c = C ∧ a = ∅ ⇒ (t = ⟨ C , ∅ ⟩) $
----
l1: $ G , c = C ∧ a = ∅ ⇒ c = C ∧ a = ∅ $ by ax
l2: $ G , c = C ∧ a = ∅ ⇒ c = C $ by and_elim_l [l1]
l3: $ G , c = C ∧ a = ∅ ⇒ a = ∅ $ by and_elim_r [l1]
l4: $ G , c = C ∧ a = ∅ ⇒ cdm b = cdm a $ by weaken [#2]
l5: $ G , c = C ∧ a = ∅ ⇒ cdm a = cdm ∅ $ by cdm_eq [l3]
l6: $ G , c = C ∧ a = ∅ ⇒ cdm b = cdm ∅ $ by eq_trans [l4, l5]
l7: $ G , c = C ∧ a = ∅ ⇒ b ∊ fseq (trees ω) $ by weaken [#1]
l8: $ G , c = C ∧ a = ∅ ⇒ t = ⟨ c , b ⟩ $ by weaken [#3]
l9: $ G , c = C ∧ a = ∅ ⇒ b = ∅ $ by szip_args0 [l7, l6]
l10: $ G , c = C ∧ a = ∅ ⇒ ⟨ c , b ⟩ = ⟨ C , ∅ ⟩ $ by opair_eq [l2, l9]
l11: $ G , c = C ∧ a = ∅ ⇒ t = ⟨ C , ∅ ⟩ $ by eq_trans [l8, l10]

lemma v1_build1 (G: hyps) {x: set} (C K1: class) (c a b t: set):
  $ G ⇒ isset K1 $ > $ G ⇒ b ∊ fseq (trees ω) $ > $ G ⇒ cdm b = cdm a $ >
  $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G , c = C ∧ a = scons K1 ∅ ⇒ ∃ x (t = ⟨ C , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen K1) $
----
l1: $ G , c = C ∧ a = scons K1 ∅ ⇒ c = C ∧ a = scons K1 ∅ $ by ax
l2: $ G , c = C ∧ a = scons K1 ∅ ⇒ c = C $ by and_elim_l [l1]
l3: $ G , c = C ∧ a = scons K1 ∅ ⇒ a = scons K1 ∅ $ by and_elim_r [l1]
l4: $ G , c = C ∧ a = scons K1 ∅ ⇒ cdm b = cdm a $ by weaken [#3]
l5: $ G , c = C ∧ a = scons K1 ∅ ⇒ cdm a = cdm (scons K1 ∅) $ by cdm_eq [l3]
l6: $ G , c = C ∧ a = scons K1 ∅ ⇒ cdm b = cdm (scons K1 ∅) $ by eq_trans [l4, l5]
l7: $ G , c = C ∧ a = scons K1 ∅ ⇒ b ∊ fseq (trees ω) $ by weaken [#2]
l8: $ G , c = C ∧ a = scons K1 ∅ ⇒ t = ⟨ c , b ⟩ $ by weaken [#5]
l9: $ G , c = C ∧ a = scons K1 ∅ ⇒ b = b $ by eq_refl
l10: $ G , c = C ∧ a = scons K1 ∅ ⇒ szip a b = szip (scons K1 ∅) b $ by szip_eq [l3, l9]
l11: $ G , c = C ∧ a = scons K1 ∅ ⇒ szip a b ⊆ sorted lsig lopen $ by weaken [#4]
l12: $ G , c = C ∧ a = scons K1 ∅ ⇒ szip (scons K1 ∅) b ⊆ sorted lsig lopen $ by subset_eq_l [l10, l11]
l13: $ G , c = C ∧ a = scons K1 ∅ ⇒ isset K1 $ by weaken [#1]
l14: $ G , c = C ∧ a = scons K1 ∅ ⇒ ∃ f (b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen) $ by szip_args1 [l13, l7, l6, l12]
l15: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen $ by ax
l16: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ b = scons f ∅ $ by and_elim_l [l15]
l17: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ ⟨ K1 , f ⟩ ∈ sorted lsig lopen $ by and_elim_r [l15]
l18: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ f ∊ ofsort lsig lopen K1 $ by ofsort_intro [l17]
l19: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ c = C $ by weaken [l2]
l20: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ ⟨ c , b ⟩ = ⟨ C , scons f ∅ ⟩ $ by opair_eq [l19, l16]
l21: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ t = ⟨ c , b ⟩ $ by weaken [l8]
l22: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ t = ⟨ C , scons f ∅ ⟩ $ by eq_trans [l21, l20]
l23: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ t = ⟨ C , scons f ∅ ⟩ ∧ f ∊ ofsort lsig lopen K1 $ by and_intro [l22, l18]
l24: $ G , c = C ∧ a = scons K1 ∅ , b = scons f ∅ ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ⇒ ∃ x (t = ⟨ C , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen K1) $ by ex_intro [l23]
l25: $ G , c = C ∧ a = scons K1 ∅ ⇒ ∃ x (t = ⟨ C , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen K1) $ by ex_elim [l14, l24]

lemma v1_build2 (G: hyps) {x y: set} (C K1 K2: class) (c a b t: set):
  $ G ⇒ isset K1 $ > $ G ⇒ isset K2 $ > $ G ⇒ b ∊ fseq (trees ω) $ > $ G ⇒ cdm b = cdm a $ >
  $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ ∃ x ∃ y (t = ⟨ C , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen K1 ∧ y ∊ ofsort lsig lopen K2) $
----
l1: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ c = C ∧ a = scons K1 (scons K2 ∅) $ by ax
l2: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ c = C $ by and_elim_l [l1]
l3: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ a = scons K1 (scons K2 ∅) $ by and_elim_r [l1]
l4: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ cdm b = cdm a $ by weaken [#4]
l5: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ cdm a = cdm (scons K1 (scons K2 ∅)) $ by cdm_eq [l3]
l6: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ cdm b = cdm (scons K1 (scons K2 ∅)) $ by eq_trans [l4, l5]
l7: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ b ∊ fseq (trees ω) $ by weaken [#3]
l8: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ t = ⟨ c , b ⟩ $ by weaken [#6]
l9: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ b = b $ by eq_refl
l10: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ szip a b = szip (scons K1 (scons K2 ∅)) b $ by szip_eq [l3, l9]
l11: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ szip a b ⊆ sorted lsig lopen $ by weaken [#5]
l12: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ szip (scons K1 (scons K2 ∅)) b ⊆ sorted lsig lopen $ by subset_eq_l [l10, l11]
l13: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ isset K1 $ by weaken [#1]
l14: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ isset K2 $ by weaken [#2]
l15: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ ∃ f ∃ g (b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen) $ by szip_args2 [l13, l14, l7, l6, l12]
l16: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen $ by ax
l17: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ b = scons f (scons g ∅) $ by and_elim_l [l16]
l18: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen $ by and_elim_r [l16]
l19: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ ⟨ K1 , f ⟩ ∈ sorted lsig lopen $ by and_elim_l [l18]
l20: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ ⟨ K2 , g ⟩ ∈ sorted lsig lopen $ by and_elim_r [l18]
l21: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ f ∊ ofsort lsig lopen K1 $ by ofsort_intro [l19]
l22: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ g ∊ ofsort lsig lopen K2 $ by ofsort_intro [l20]
l23: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ c = C $ by weaken [l2]
l24: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ ⟨ c , b ⟩ = ⟨ C , scons f (scons g ∅) ⟩ $ by opair_eq [l23, l17]
l25: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ t = ⟨ c , b ⟩ $ by weaken [l8]
l26: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ t = ⟨ C , scons f (scons g ∅) ⟩ $ by eq_trans [l25, l24]
l27: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ f ∊ ofsort lsig lopen K1 ∧ g ∊ ofsort lsig lopen K2 $ by and_intro [l21, l22]
l28: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ t = ⟨ C , scons f (scons g ∅) ⟩ ∧ f ∊ ofsort lsig lopen K1 ∧ g ∊ ofsort lsig lopen K2 $ by and_intro [l26, l27]
l29: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ ∃ y (t = ⟨ C , scons f (scons y ∅) ⟩ ∧ f ∊ ofsort lsig lopen K1 ∧ y ∊ ofsort lsig lopen K2) $ by ex_intro [l28]
l30: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ⇒ ∃ x ∃ y (t = ⟨ C , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen K1 ∧ y ∊ ofsort lsig lopen K2) $ by ex_intro [l29]
l31: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , ∃ g (b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen) ⇒ ∃ g (b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen) $ by ax
l32: $ G , c = C ∧ a = scons K1 (scons K2 ∅) , ∃ g (b = scons f (scons g ∅) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen) ⇒ ∃ x ∃ y (t = ⟨ C , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen K1 ∧ y ∊ ofsort lsig lopen K2) $ by ex_elim [l31, l30]
l33: $ G , c = C ∧ a = scons K1 (scons K2 ∅) ⇒ ∃ x ∃ y (t = ⟨ C , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen K1 ∧ y ∊ ofsort lsig lopen K2) $ by ex_elim [l15, l32]

lemma v1_build3 (G: hyps) {x y u: set} (C K1 K2 K3: class) (c a b t: set):
  $ G ⇒ isset K1 $ > $ G ⇒ isset K2 $ > $ G ⇒ isset K3 $ > $ G ⇒ b ∊ fseq (trees ω) $ > $ G ⇒ cdm b = cdm a $ >
  $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 ∅)) ⇒ ∃ x ∃ y ∃ u (t = ⟨ C , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen K1 ∧ y ∊ ofsort lsig lopen K2 ∧ u ∊ ofsort lsig lopen K3) $
----
l1: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 ∅)) ⇒ c = C ∧ a = scons K1 (scons K2 (scons K3 ∅)) $ by ax
l2: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 ∅)) ⇒ c = C $ by and_elim_l [l1]
l3: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 ∅)) ⇒ a = scons K1 (scons K2 (scons K3 ∅)) $ by and_elim_r [l1]
l4: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 ∅)) ⇒ cdm b = cdm a $ by weaken [#5]
l5: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 ∅)) ⇒ cdm a = cdm (scons K1 (scons K2 (scons K3 ∅))) $ by cdm_eq [l3]
