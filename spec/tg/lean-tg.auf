l13: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ∪ cl_lift_proj , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_proj ⇒ ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ∪ cl_lift_proj , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_proj ⇒ ∃ n_v ∃ j_v ∃ k_v ∃ e_v (t1 = n_v ∧ t2 = k_v ∧ t3 = e_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ∪ cl_lift_proj ⇒ ∃ n_v ∃ j_v ∃ k_v ∃ e_v (t1 = n_v ∧ t2 = k_v ∧ t3 = e_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ∪ cl_lift_proj → ∃ n_v ∃ j_v ∃ k_v ∃ e_v (t1 = n_v ∧ t2 = k_v ∧ t3 = e_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $ by imp_intro [l15]
l17: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj) ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj) $ by ax
l18: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj) ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ∨ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ (cl_lift_closed ∪ cl_lift_proj) $ by v1_wcel_cun_elim [l17]
l19: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj) , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi $ by ax
l20: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj) , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l21: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj) , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ⇒ ∃ n_v ∃ k_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_lift n_v k_v A A2 ∈ lrel ∧ ra_lift n_v ⟨ kc_s , scons k_v ∅ ⟩ b_v b2 ∈ lrel) $ by y1_d_lift_pi [l19, l20]
l22: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj) , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_pi ⇒ ∃ n_v ∃ k_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_lift n_v k_v A A2 ∈ lrel ∧ ra_lift n_v ⟨ kc_s , scons k_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ n_v ∃ j_v ∃ k_v ∃ e_v (t1 = n_v ∧ t2 = k_v ∧ t3 = e_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $ by or_intro_l [l21]
