lemma y2_ind_data_e2 (GG: hyps) (q1 q2 q3 q4 w2 w3 w4 u_b u_P u_T u_N v_b v_P v_T v_N: set):
  $ GG ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ $ > $ GG ⇒ q2 = u_b $ > $ GG ⇒ q3 = u_P $ > $ GG ⇒ q4 = u_T $ > $ GG ⇒ q1 = ⟨ kc_ind_mkn , scons v_b (scons v_P (scons v_T (scons v_N ∅))) ⟩ $ > $ GG ⇒ w2 = v_b $ > $ GG ⇒ w3 = v_P $ > $ GG ⇒ w4 = v_T $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ = ⟨ kc_ind_mkn , scons v_b (scons v_P (scons v_T (scons v_N ∅))) ⟩ $ by eq_trans [l1, #5]
l3: $ GG ⇒ kc_ind_mkn ∈ ω $ by v1_kc_ind_mkn
l4: $ GG ⇒ isset kc_ind_mkn $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_b $ by isset_var
l6: $ GG ⇒ isset u_P $ by isset_var
l7: $ GG ⇒ isset u_T $ by isset_var
l8: $ GG ⇒ isset u_N $ by isset_var
l9: $ GG ⇒ isset v_b $ by isset_var
l10: $ GG ⇒ isset v_P $ by isset_var
l11: $ GG ⇒ isset v_T $ by isset_var
l12: $ GG ⇒ isset v_N $ by isset_var
l13: $ GG ⇒ u_b = v_b ∧ u_P = v_P ∧ u_T = v_T ∧ u_N = v_N $ by y2_nd4 [l2, l4, l5, l6, l7, l8, l9, l10, l11, l12]
l14: $ GG ⇒ u_b = v_b $ by and_elim_l [l13]
l15: $ GG ⇒ u_P = v_P ∧ u_T = v_T ∧ u_N = v_N $ by and_elim_r [l13]
l16: $ GG ⇒ u_P = v_P $ by and_elim_l [l15]
l17: $ GG ⇒ u_T = v_T ∧ u_N = v_N $ by and_elim_r [l15]
l18: $ GG ⇒ u_T = v_T $ by and_elim_l [l17]
l19: $ GG ⇒ u_N = v_N $ by and_elim_r [l17]
l20: $ GG ⇒ v_b = w2 $ by eq_sym [#6]
l21: $ GG ⇒ q2 = v_b $ by eq_trans [#2, l14]
l22: $ GG ⇒ q2 = w2 $ by eq_trans [l21, l20]
l23: $ GG ⇒ v_P = w3 $ by eq_sym [#7]
l24: $ GG ⇒ q3 = v_P $ by eq_trans [#3, l16]
l25: $ GG ⇒ q3 = w3 $ by eq_trans [l24, l23]
l26: $ GG ⇒ v_T = w4 $ by eq_sym [#8]
l27: $ GG ⇒ q4 = v_T $ by eq_trans [#4, l18]
l28: $ GG ⇒ q4 = w4 $ by eq_trans [l27, l26]
l29: $ GG ⇒ q3 = w3 ∧ q4 = w4 $ by and_intro [l25, l28]
l30: $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by and_intro [l22, l29]

lemma y2_ind_data_c2 (GG: hyps) (q1 q2 q3 q4 w2 w3 w4 u_b u_P u_T u_N: set):
  $ GG ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ ∧ q2 = u_b ∧ q3 = u_P ∧ q4 = u_T $ > $ GG ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ∨ ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by lrel_ind_data_cases [#2]
l2: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d $ by ax
l3: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ ∧ q2 = u_b ∧ q3 = u_P ∧ q4 = u_T $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q2 = u_b ∧ q3 = u_P ∧ q4 = u_T $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q2 = u_b $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q3 = u_P ∧ q4 = u_T $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q3 = u_P $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q4 = u_T $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ $ by and_elim_l [l2]
l11: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w2 = a ∧ w3 = b ∧ w4 = d $ by and_elim_r [l2]
l12: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w2 = a $ by and_elim_l [l11]
l13: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w3 = b ∧ w4 = d $ by and_elim_r [l11]
l14: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w3 = b $ by and_elim_l [l13]
l15: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w4 = d $ by and_elim_r [l13]
l16: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ kc_ind_mk ∈ kc_ind_mkn $ by y2_lt_ind_mk_ind_mkn
l17: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ kc_ind_mkn ∈ ω $ by v1_kc_ind_mkn
l18: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ isset kc_ind_mkn $ by wcel_isset [l17]
l19: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ ⊥ $ by y2_ne [l10, l4, l16, l18]
l20: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by bot_elim [l19]
l21: $ GG , ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
l22: $ GG , ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l21, l20]
l23: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
l24: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l23, l22]
l25: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
l26: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l25, l24]
l27: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d $ by ax
l28: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ ∧ q2 = u_b ∧ q3 = u_P ∧ q4 = u_T $ by weaken [#1]
l29: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ $ by and_elim_l [l28]
l30: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q2 = u_b ∧ q3 = u_P ∧ q4 = u_T $ by and_elim_r [l28]
l31: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q2 = u_b $ by and_elim_l [l30]
l32: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q3 = u_P ∧ q4 = u_T $ by and_elim_r [l30]
l33: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q3 = u_P $ by and_elim_l [l32]
l34: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q4 = u_T $ by and_elim_r [l32]
l35: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ $ by and_elim_l [l27]
l36: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w2 = a ∧ w3 = b ∧ w4 = d $ by and_elim_r [l27]
l37: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w2 = a $ by and_elim_l [l36]
l38: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w3 = b ∧ w4 = d $ by and_elim_r [l36]
l39: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w3 = b $ by and_elim_l [l38]
l40: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w4 = d $ by and_elim_r [l38]
l41: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by y2_ind_data_e2 [l29, l31, l33, l34, l35, l37, l39, l40]
