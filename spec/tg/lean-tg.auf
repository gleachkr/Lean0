lemma y2_nth_ctor_e2 (GG: hyps) (q1 q2 q3 w3 u_K u_K2 u_C u_c v_K v_K2 v_C v_c: set):
  $ GG ⇒ q1 = ⟨ kc_ccons , scons u_K2 (scons u_C ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_c ∅ ⟩ $ > $ GG ⇒ q3 = u_K $ > $ GG ⇒ ra_nth_ctor u_C u_c u_K ∈ lrel $ > $ GG ⇒ ra_nth_ctor u_C u_c u_K ∈ y2_P_nth_ctor lrel $ > $ GG ⇒ q1 = ⟨ kc_ccons , scons v_K2 (scons v_C ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons v_c ∅ ⟩ $ > $ GG ⇒ w3 = v_K $ > $ GG ⇒ ra_nth_ctor v_C v_c v_K ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_ccons , scons u_K2 (scons u_C ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_ccons , scons u_K2 (scons u_C ∅) ⟩ = ⟨ kc_ccons , scons v_K2 (scons v_C ∅) ⟩ $ by eq_trans [l1, #6]
l3: $ GG ⇒ kc_ccons ∈ ω $ by v1_kc_ccons
l4: $ GG ⇒ isset kc_ccons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_K2 $ by isset_var
l6: $ GG ⇒ isset u_C $ by isset_var
l7: $ GG ⇒ isset v_K2 $ by isset_var
l8: $ GG ⇒ isset v_C $ by isset_var
l9: $ GG ⇒ u_K2 = v_K2 ∧ u_C = v_C $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_K2 = v_K2 $ by and_elim_l [l9]
l11: $ GG ⇒ u_C = v_C $ by and_elim_r [l9]
l12: $ GG ⇒ ⟨ kc_s , scons u_c ∅ ⟩ = q2 $ by eq_sym [#2]
l13: $ GG ⇒ ⟨ kc_s , scons u_c ∅ ⟩ = ⟨ kc_s , scons v_c ∅ ⟩ $ by eq_trans [l12, #7]
l14: $ GG ⇒ kc_s ∈ ω $ by v1_kc_s
l15: $ GG ⇒ isset kc_s $ by wcel_isset [l14]
l16: $ GG ⇒ isset u_c $ by isset_var
l17: $ GG ⇒ isset v_c $ by isset_var
l18: $ GG ⇒ u_c = v_c $ by y2_nd1 [l13, l15, l16, l17]
l19: $ GG ⇒ v_C = u_C $ by eq_sym [l11]
l20: $ GG ⇒ v_c = u_c $ by eq_sym [l18]
l21: $ GG ⇒ v_K = v_K $ by eq_refl
l22: $ GG ⇒ ra_nth_ctor u_C u_c v_K ∈ lrel $ by x1_eq_nth_ctor [#9, l19, l20, l21]
l23: $ GG ⇒ isset u_C $ by isset_var
l24: $ GG ⇒ isset u_c $ by isset_var
l25: $ GG ⇒ isset u_K $ by isset_var
l26: $ GG ⇒ isset v_K $ by isset_var
l27: $ GG ⇒ u_K = v_K $ by y2_nth_ctor_ihc [l23, l24, l25, l26, #5, l22]
l28: $ GG ⇒ v_K = w3 $ by eq_sym [#8]
