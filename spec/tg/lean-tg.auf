l33: $ G ⇒ kr_projs = kr_projs ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V3 (scons V3 ∅)))) $ by opair_inj_c [l8, l30, l31, l30, l32]
l34: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V3 (scons V3 ∅)))) $ by and_elim_r [l33]
l35: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V3 (scons V3 ∅))) $ by y1_scons_inj [l34, l18, l27, l17, l26]
