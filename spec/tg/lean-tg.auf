l8: $ G , ∃ h ∃ l (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons b ∅) ⟩ l f) (scons (ra_nidx y b c) (scons (ra_add z c f) (scons (ra_rehead d ⟨ kc_bvar , scons j ∅ ⟩ c l e) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons b ∅) ⟩ d z) (scons (ra_add a v g) (scons (ra_add g u i) (scons (ra_add j ⟨ kc_s , scons b ∅ ⟩ i) (scons (ra_add a w k) (scons (ra_pargs ⟨ kc_bvar , scons k ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a h) ∅))))))))) , ra_ihty y z u v w a b l ⟨ kc_app , scons e (scons h ∅) ⟩ ⟩) ⇒ ∃ h ∃ l (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons b ∅) ⟩ l f) (scons (ra_nidx y b c) (scons (ra_add z c f) (scons (ra_rehead d ⟨ kc_bvar , scons j ∅ ⟩ c l e) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons b ∅) ⟩ d z) (scons (ra_add a v g) (scons (ra_add g u i) (scons (ra_add j ⟨ kc_s , scons b ∅ ⟩ i) (scons (ra_add a w k) (scons (ra_pargs ⟨ kc_bvar , scons k ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a h) ∅))))))))) , ra_ihty y z u v w a b l ⟨ kc_app , scons e (scons h ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ h ∃ l (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons b ∅) ⟩ l f) (scons (ra_nidx y b c) (scons (ra_add z c f) (scons (ra_rehead d ⟨ kc_bvar , scons j ∅ ⟩ c l e) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons b ∅) ⟩ d z) (scons (ra_add a v g) (scons (ra_add g u i) (scons (ra_add j ⟨ kc_s , scons b ∅ ⟩ i) (scons (ra_add a w k) (scons (ra_pargs ⟨ kc_bvar , scons k ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a h) ∅))))))))) , ra_ihty y z u v w a b l ⟨ kc_app , scons e (scons h ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_ihty (suc kr_ihty) $ by ex_elim [l8, l7]
