l57: $ G ⇒ crn pp = crn (scons (ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5) ∅) $ by crn_eq [l7]
l58: $ G ⇒ crn (scons (ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5) ∅) ⊆ lrel $ by subset_eq_l [l57, #2]
l59: $ G ⇒ isset (ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5) $ by opair_isset
