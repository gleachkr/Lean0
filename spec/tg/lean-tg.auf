----
l1: $ G , x ∊ cl_lift_proj ⇒ x ∊ cl_lift_proj $ by ax
l2: $ G , x ∊ cl_lift_proj ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ kr_lift ∈ ω $ by x1_kr_lift
