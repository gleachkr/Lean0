l30: $ G ⇒ kr_inst = kr_inst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V4 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_inst V1 V2 V4 V5) $ by opair_isset
l46: $ G ⇒ ra_inst V1 V2 V4 V5 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) $ by opair_isset
l49: $ G ⇒ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = V4 ∧ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_lam , scons V5 (scons b2 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 b2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst V1 V2 V4 A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 b2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ a_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst V1 V2 a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 a_v b2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lam , scons V2 (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst V1 V2 a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst V1 A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_inst_lam (G: hyps) {k_v A b_v a_v A2 b2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ ∈ cl_inst_lam $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_lam ⇒ x ∊ cl_inst_lam $ by ax
l2: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_lam ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by y1_e_inst_lam [l6, l7]
l9: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_lam , scons z (scons u ∅) ⟩ v ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_lam ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_inst_pi (G: hyps) {k_v A b_v a_v A2 b2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅) , ra_inst V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅) , ra_inst V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_inst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_inst V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅) ∧ ra_inst t1 t2 t3 t4 = ra_inst V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_inst t1 t2 t3 t4 = ra_inst V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V4 $ by isset_var
l21: $ G ⇒ scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_inst ∈ ω $ by x1_kr_inst
l27: $ G ⇒ isset kr_inst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_inst = kr_inst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V4 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_inst V1 V2 V4 V5) (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_inst V1 V2 V4 V5) $ by opair_isset
l46: $ G ⇒ ra_inst V1 V2 V4 V5 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6) $ by opair_isset
l49: $ G ⇒ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = V4 ∧ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_pi , scons V5 (scons b2 ∅) ⟩ ∧ ra_inst V1 V2 V4 V5 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 b2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst V1 V2 V4 A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 V4 b2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ a_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst V1 V2 a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ V3 a_v b2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst V1 V2 a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst V1 A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons V1 ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_inst_pi (G: hyps) {k_v A b_v a_v A2 b2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ ∈ cl_inst_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_pi ⇒ x ∊ cl_inst_pi $ by ax
l2: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by y1_e_inst_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y z v w) (scons (ra_inst ⟨ kc_s , scons y ∅ ⟩ u v a) ∅) , ra_inst y ⟨ kc_pi , scons z (scons u ∅) ⟩ v ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_pi ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_inst_closed (G: hyps) {j_v k_v e_v a_v: set} (pp t1 t2 t3 t4 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_closed V1 V3) (scons (ra_le V1 V2) ∅) , ra_inst V2 V3 V4 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_closed V1 V3) (scons (ra_le V1 V2) ∅) , ra_inst V2 V3 V4 V3 ⟩ = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_closed V1 V3) (scons (ra_le V1 V2) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_inst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_inst V2 V3 V4 V3) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_closed V1 V3) (scons (ra_le V1 V2) ∅) ∧ ra_inst t1 t2 t3 t4 = ra_inst V2 V3 V4 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_closed V1 V3) (scons (ra_le V1 V2) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_inst t1 t2 t3 t4 = ra_inst V2 V3 V4 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V3 $ by isset_var
l19: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V4 $ by isset_var
l21: $ G ⇒ scons V4 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ scons V3 (scons V4 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l18, l21]
l23: $ G ⇒ isset V2 $ by isset_var
l24: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V3 ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_inst ∈ ω $ by x1_kr_inst
l26: $ G ⇒ isset kr_inst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V2 (scons V3 (scons V4 (scons V3 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_inst = kr_inst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V2 (scons V3 (scons V4 (scons V3 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V2 (scons V3 (scons V4 (scons V3 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V2 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V3 (scons V4 (scons V3 ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V3 (scons V4 (scons V3 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = V3 ∧ scons t3 (scons t4 ∅) = scons V4 (scons V3 ∅) $ by y1_scons_inj [l33, l14, l18, l13, l21]
l35: $ G ⇒ t2 = V3 $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons V3 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons V3 ∅ $ by y1_scons_inj [l36, l12, l20, l11, l19]
l38: $ G ⇒ t3 = V4 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V3 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V3 $ by and_elim_l [l40]
l42: $ G ⇒ crn pp = crn (scons (ra_closed V1 V3) (scons (ra_le V1 V2) ∅)) $ by crn_eq [l7]
l43: $ G ⇒ crn (scons (ra_closed V1 V3) (scons (ra_le V1 V2) ∅)) ⊆ lrel $ by subset_eq_l [l42, #2]
l44: $ G ⇒ isset (ra_closed V1 V3) $ by opair_isset
l45: $ G ⇒ ra_closed V1 V3 ∈ lrel $ by crn_scons_head [l44, l43]
l46: $ G ⇒ crn (scons (ra_le V1 V2) ∅) ⊆ lrel $ by crn_scons_tail [l43]
l47: $ G ⇒ isset (ra_le V1 V2) $ by opair_isset
l48: $ G ⇒ ra_le V1 V2 ∈ lrel $ by crn_scons_head [l47, l46]
l49: $ G ⇒ ra_closed V1 V3 ∈ lrel ∧ ra_le V1 V2 ∈ lrel $ by and_intro [l45, l48]
l50: $ G ⇒ t4 = V3 ∧ ra_closed V1 V3 ∈ lrel ∧ ra_le V1 V2 ∈ lrel $ by and_intro [l41, l49]
l51: $ G ⇒ t3 = V4 ∧ t4 = V3 ∧ ra_closed V1 V3 ∈ lrel ∧ ra_le V1 V2 ∈ lrel $ by and_intro [l38, l50]
l52: $ G ⇒ t2 = V3 ∧ t3 = V4 ∧ t4 = V3 ∧ ra_closed V1 V3 ∈ lrel ∧ ra_le V1 V2 ∈ lrel $ by and_intro [l35, l51]
l53: $ G ⇒ t1 = V2 ∧ t2 = V3 ∧ t3 = V4 ∧ t4 = V3 ∧ ra_closed V1 V3 ∈ lrel ∧ ra_le V1 V2 ∈ lrel $ by and_intro [l32, l52]
l54: $ G ⇒ ∃ a_v (t1 = V2 ∧ t2 = V3 ∧ t3 = a_v ∧ t4 = V3 ∧ ra_closed V1 V3 ∈ lrel ∧ ra_le V1 V2 ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ e_v ∃ a_v (t1 = V2 ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed V1 e_v ∈ lrel ∧ ra_le V1 V2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed V1 e_v ∈ lrel ∧ ra_le V1 k_v ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $ by ex_intro [l56]

lemma y1_d_inst_closed (G: hyps) {j_v k_v e_v a_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ ∈ cl_inst_closed $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_closed ⇒ x ∊ cl_inst_closed $ by ax
l2: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_closed ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $ by y1_e_inst_closed [l6, l7]
l9: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_closed ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_e_inst_proj (G: hyps) {k_v b_v i_v e_v a_v e2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_inst V1 V4 V5 V6) ∅ , ra_inst V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_inst V1 V4 V5 V6) ∅ , ra_inst V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ⟩ = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_inst V1 V4 V5 V6) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_inst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_inst V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_inst V1 V4 V5 V6) ∅ ∧ ra_inst t1 t2 t3 t4 = ra_inst V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_inst V1 V4 V5 V6) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_inst t1 t2 t3 t4 = ra_inst V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V5 $ by isset_var
l21: $ G ⇒ scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_inst ∈ ω $ by x1_kr_inst
l27: $ G ⇒ isset kr_inst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_inst = kr_inst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ scons t3 (scons t4 ∅) = scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V5 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V5 ∧ scons t4 ∅ = scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V5 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_inst V1 V4 V5 V6) ∅) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_inst V1 V4 V5 V6) ∅) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_inst V1 V4 V5 V6) $ by opair_isset
l46: $ G ⇒ ra_inst V1 V4 V5 V6 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∧ ra_inst V1 V4 V5 V6 ∈ lrel $ by and_intro [l42, l46]
l48: $ G ⇒ t3 = V5 ∧ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∧ ra_inst V1 V4 V5 V6 ∈ lrel $ by and_intro [l39, l47]
l49: $ G ⇒ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ t3 = V5 ∧ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∧ ra_inst V1 V4 V5 V6 ∈ lrel $ by and_intro [l36, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ t3 = V5 ∧ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons V6 ∅)) ⟩ ∧ ra_inst V1 V4 V5 V6 ∈ lrel $ by and_intro [l33, l49]
l51: $ G ⇒ ∃ e2 (t1 = V1 ∧ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ t3 = V5 ∧ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons e2 ∅)) ⟩ ∧ ra_inst V1 V4 V5 e2 ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ a_v ∃ e2 (t1 = V1 ∧ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons e2 ∅)) ⟩ ∧ ra_inst V1 V4 a_v e2 ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ e_v ∃ a_v ∃ e2 (t1 = V1 ∧ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons V2 (scons V3 (scons e2 ∅)) ⟩ ∧ ra_inst V1 e_v a_v e2 ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = V1 ∧ t2 = ⟨ kc_proj , scons V2 (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons V2 (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst V1 e_v a_v e2 ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = V1 ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst V1 e_v a_v e2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $ by ex_intro [l55]

lemma y1_d_inst_proj (G: hyps) {k_v b_v i_v e_v a_v e2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ ∈ cl_inst_proj $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_proj ⇒ x ∊ cl_inst_proj $ by ax
l2: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x ∊ cl_inst_proj ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $ by y1_e_inst_proj [l6, l7]
l9: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_inst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $ by ex_elim [l13, l12]
