l16: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
l17: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by ex_elim [l16, l15]
l18: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
l19: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by ex_elim [l18, l17]
l20: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
l21: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by ex_elim [l20, l19]
l22: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
l23: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by ex_elim [l22, l21]
