l14: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt → ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_rec_ty_i (G: hyps) {D b_v P T v_v i_v np n_v m_v mn M N F F2 B R1 R2 R C: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19: set):
  $ G ⇒ ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V7) (scons (ra_ntys V4 V8 V9) (scons (ra_motives V1 V7 V5 ⟨ kc_nz , ∅ ⟩ V4 V11) (scons (ra_minors V1 V7 V8 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V12) (scons (ra_nth_ty V4 V6 V13 V19) (scons (ra_add V9 V8 V10) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V13 V14) (scons (ra_rtail V1 V7 V8 V9 V6 ⟨ kc_nz , ∅ ⟩ V14 V15) (scons (ra_pis V12 V15 V16) (scons (ra_pis V11 V16 V17) (scons (ra_pis V3 V17 V18) ∅))))))))))) , ra_rec_ty V1 V5 V6 V18 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail D np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V7) (scons (ra_ntys V4 V8 V9) (scons (ra_motives V1 V7 V5 ⟨ kc_nz , ∅ ⟩ V4 V11) (scons (ra_minors V1 V7 V8 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V12) (scons (ra_nth_ty V4 V6 V13 V19) (scons (ra_add V9 V8 V10) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V13 V14) (scons (ra_rtail V1 V7 V8 V9 V6 ⟨ kc_nz , ∅ ⟩ V14 V15) (scons (ra_pis V12 V15 V16) (scons (ra_pis V11 V16 V17) (scons (ra_pis V3 V17 V18) ∅))))))))))) , ra_rec_ty V1 V5 V6 V18 ⟩ = ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V7) (scons (ra_ntys V4 V8 V9) (scons (ra_motives V1 V7 V5 ⟨ kc_nz , ∅ ⟩ V4 V11) (scons (ra_minors V1 V7 V8 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V12) (scons (ra_nth_ty V4 V6 V13 V19) (scons (ra_add V9 V8 V10) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V13 V14) (scons (ra_rtail V1 V7 V8 V9 V6 ⟨ kc_nz , ∅ ⟩ V14 V15) (scons (ra_pis V12 V15 V16) (scons (ra_pis V11 V16 V17) (scons (ra_pis V3 V17 V18) ∅)))))))))))) $ by y1_opair_set_l [l1]
