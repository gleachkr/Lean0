  $ G ⇒ ra_iota_eq A1 A2 A3 A4 A5 A6 A7 A8 ∈ lrel $ > $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ > $ G ⇒ A5 = B5 $ > $ G ⇒ A6 = B6 $ > $ G ⇒ A7 = B7 $ > $ G ⇒ A8 = B8 $ >
  $ G ⇒ ra_iota_eq B1 B2 B3 B4 B5 B6 B7 B8 ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A8 ∅ = scons B8 ∅ $ by scons_eq [#9, l1]
l3: $ G ⇒ scons A7 (scons A8 ∅) = scons B7 (scons B8 ∅) $ by scons_eq [#8, l2]
l4: $ G ⇒ scons A6 (scons A7 (scons A8 ∅)) = scons B6 (scons B7 (scons B8 ∅)) $ by scons_eq [#7, l3]
l5: $ G ⇒ scons A5 (scons A6 (scons A7 (scons A8 ∅))) = scons B5 (scons B6 (scons B7 (scons B8 ∅))) $ by scons_eq [#6, l4]
l6: $ G ⇒ scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅)))) = scons B4 (scons B5 (scons B6 (scons B7 (scons B8 ∅)))) $ by scons_eq [#5, l5]
l7: $ G ⇒ scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅))))) = scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 ∅))))) $ by scons_eq [#4, l6]
l8: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅)))))) = scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 ∅)))))) $ by scons_eq [#3, l7]
l9: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 ∅))))))) = scons B1 (scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 ∅))))))) $ by scons_eq [#2, l8]
l10: $ G ⇒ kr_iota_eq = kr_iota_eq $ by eq_refl
l11: $ G ⇒ ra_iota_eq A1 A2 A3 A4 A5 A6 A7 A8 = ra_iota_eq B1 B2 B3 B4 B5 B6 B7 B8 $ by opair_eq [l10, l9]
l12: $ G ⇒ ra_iota_eq B1 B2 B3 B4 B5 B6 B7 B8 ∈ lrel $ by wcel_eq_l [l11, #1]

lemma x1_eq_proj_eq (G: hyps) (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5 A6 B6: class):
  $ G ⇒ ra_proj_eq A1 A2 A3 A4 A5 A6 ∈ lrel $ > $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ > $ G ⇒ A5 = B5 $ > $ G ⇒ A6 = B6 $ >
  $ G ⇒ ra_proj_eq B1 B2 B3 B4 B5 B6 ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A6 ∅ = scons B6 ∅ $ by scons_eq [#7, l1]
l3: $ G ⇒ scons A5 (scons A6 ∅) = scons B5 (scons B6 ∅) $ by scons_eq [#6, l2]
l4: $ G ⇒ scons A4 (scons A5 (scons A6 ∅)) = scons B4 (scons B5 (scons B6 ∅)) $ by scons_eq [#5, l3]
l5: $ G ⇒ scons A3 (scons A4 (scons A5 (scons A6 ∅))) = scons B3 (scons B4 (scons B5 (scons B6 ∅))) $ by scons_eq [#4, l4]
l6: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 (scons A6 ∅)))) = scons B2 (scons B3 (scons B4 (scons B5 (scons B6 ∅)))) $ by scons_eq [#3, l5]
l7: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 ∅))))) = scons B1 (scons B2 (scons B3 (scons B4 (scons B5 (scons B6 ∅))))) $ by scons_eq [#2, l6]
l8: $ G ⇒ kr_proj_eq = kr_proj_eq $ by eq_refl
l9: $ G ⇒ ra_proj_eq A1 A2 A3 A4 A5 A6 = ra_proj_eq B1 B2 B3 B4 B5 B6 $ by opair_eq [l8, l7]
l10: $ G ⇒ ra_proj_eq B1 B2 B3 B4 B5 B6 ∈ lrel $ by wcel_eq_l [l9, #1]

lemma x1_eq_eta_eq (G: hyps) (A1 B1 A2 B2 A3 B3 A4 B4 A5 B5: class):
  $ G ⇒ ra_eta_eq A1 A2 A3 A4 A5 ∈ lrel $ > $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ > $ G ⇒ A5 = B5 $ >
  $ G ⇒ ra_eta_eq B1 B2 B3 B4 B5 ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A5 ∅ = scons B5 ∅ $ by scons_eq [#6, l1]
l3: $ G ⇒ scons A4 (scons A5 ∅) = scons B4 (scons B5 ∅) $ by scons_eq [#5, l2]
l4: $ G ⇒ scons A3 (scons A4 (scons A5 ∅)) = scons B3 (scons B4 (scons B5 ∅)) $ by scons_eq [#4, l3]
l5: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 ∅))) = scons B2 (scons B3 (scons B4 (scons B5 ∅))) $ by scons_eq [#3, l4]
l6: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) = scons B1 (scons B2 (scons B3 (scons B4 (scons B5 ∅)))) $ by scons_eq [#2, l5]
l7: $ G ⇒ kr_eta_eq = kr_eta_eq $ by eq_refl
l8: $ G ⇒ ra_eta_eq A1 A2 A3 A4 A5 = ra_eta_eq B1 B2 B3 B4 B5 $ by opair_eq [l7, l6]
l9: $ G ⇒ ra_eta_eq B1 B2 B3 B4 B5 ∈ lrel $ by wcel_eq_l [l8, #1]

lemma x1_lrel_lat (G: hyps) (X: class): $ G ⇒ X ∈ lrel $ > $ G ⇒ X ∈ latoms $
----
l1: $ G ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ G ⇒ horn lprog ⊆ latoms $ by horn_sub [l1]
l3: $ G ⇒ X ∈ latoms $ by wcel_subset [l2, #1]

lemma x1_in_l (G: hyps) (X A B: class): $ G ⇒ X ∈ A $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ A ⊆ A ∪ B $ by cun_subset_l
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

lemma x1_in_r (G: hyps) (X A B: class): $ G ⇒ X ∈ B $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ B ⊆ A ∪ B $ by cun_subset_r
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

def x1_top: class = $ (((((pr_le ∪ pr_add) ∪ (pr_lnth ∪ (pr_linst ∪ pr_lsubst))) ∪ ((pr_closed ∪ pr_lift) ∪ (pr_inst ∪ (pr_lookup ∪ pr_cinst)))) ∪ (((pr_cext ∪ pr_clen) ∪ (pr_cnth ∪ (pr_capp ∪ pr_bsucc))) ∪ ((pr_bdbl ∪ (pr_badd ∪ pr_baddc)) ∪ (pr_bmul ∪ (pr_bpow ∪ pr_band))))) ∪ ((((pr_bor ∪ pr_bxor) ∪ (pr_ind_data ∪ (pr_ind_nested ∪ pr_nth_ty))) ∪ ((pr_nth_ctor ∪ pr_clen_c) ∪ (pr_ntys ∪ (pr_minor_idx ∪ pr_npis)))) ∪ (((pr_nth_pi ∪ pr_isort) ∪ (pr_ind_arity ∪ (pr_nidx ∪ pr_nfields))) ∪ ((pr_ndecl ∪ (pr_aux_of ∪ pr_pis)) ∪ (pr_lams ∪ (pr_tys_closed ∪ pr_pargs)))))) ∪ (((((pr_spine ∪ pr_rehead) ∪ (pr_has_arg ∪ (pr_leaf_has ∪ pr_pinst))) ∪ ((pr_sinst ∪ pr_iargs) ∪ (pr_indapp ∪ (pr_ipos ∪ pr_recfield)))) ∪ (((pr_rst ∪ pr_nst_hit) ∪ (pr_spz ∪ (pr_afree ∪ pr_spz_ctors))) ∪ ((pr_aux_data ∪ (pr_mty ∪ pr_motives)) ∪ (pr_ihty ∪ (pr_mwalk ∪ pr_cminors))))) ∪ ((((pr_minors ∪ pr_rtail) ∪ (pr_rec_ty ∪ (pr_ctor_ty ∪ pr_ihval))) ∪ ((pr_rwalk ∪ pr_rec_rhs) ∪ (pr_struct_like ∪ (pr_field_ty ∪ pr_qinst)))) ∪ (((pr_nonrec ∪ pr_eta_ok) ∪ (pr_projs ∪ (pr_clift ∪ pr_psplit))) ∪ ((pr_iota_tel ∪ (pr_iota_lhs ∪ pr_crst)) ∪ (pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq)))))) $

--| A clause of the union whose premises are derivable.
lemma x1_horn (G: hyps) (P C: class):
  $ G ⇒ ⟨ P , C ⟩ ∈ x1_top $ > $ G ⇒ P ∈ fseq latoms $ > $ G ⇒ C ∈ latoms $ >
  $ G ⇒ crn P ⊆ lrel $ > $ G ⇒ C ∈ lrel $
----
l1: $ G ⇒ ⟨ P , C ⟩ ∈ fseq latoms × latoms $ by cxp_intro_c [#2, #3]
l2: $ G ⇒ ⟨ P , C ⟩ ∈ lprog $ by wcel_cin [#1, l1]
l3: $ G ⇒ hprog lprog latoms $ by lprog_hprog
l4: $ G ⇒ isset P $ by wcel_isset [#2]
l5: $ G ⇒ isset C $ by wcel_isset [#3]
l6: $ G ⇒ C ∈ lrel $ by horn_intro_c [l3, l2, l4, l5, #4]

lemma x1_pr_le (G: hyps) (X: class): $ G ⇒ X ∈ pr_le $ > $ G ⇒ X ∈ x1_top $
----
l1: $ G ⇒ X ∈ pr_le ∪ pr_add $ by x1_in_l [#1]
l2: $ G ⇒ X ∈ (pr_le ∪ pr_add) ∪ (pr_lnth ∪ (pr_linst ∪ pr_lsubst)) $ by x1_in_l [l1]
l3: $ G ⇒ X ∈ ((pr_le ∪ pr_add) ∪ (pr_lnth ∪ (pr_linst ∪ pr_lsubst))) ∪ ((pr_closed ∪ pr_lift) ∪ (pr_inst ∪ (pr_lookup ∪ pr_cinst))) $ by x1_in_l [l2]
l4: $ G ⇒ X ∈ (((pr_le ∪ pr_add) ∪ (pr_lnth ∪ (pr_linst ∪ pr_lsubst))) ∪ ((pr_closed ∪ pr_lift) ∪ (pr_inst ∪ (pr_lookup ∪ pr_cinst)))) ∪ (((pr_cext ∪ pr_clen) ∪ (pr_cnth ∪ (pr_capp ∪ pr_bsucc))) ∪ ((pr_bdbl ∪ (pr_badd ∪ pr_baddc)) ∪ (pr_bmul ∪ (pr_bpow ∪ pr_band)))) $ by x1_in_l [l3]
l5: $ G ⇒ X ∈ ((((pr_le ∪ pr_add) ∪ (pr_lnth ∪ (pr_linst ∪ pr_lsubst))) ∪ ((pr_closed ∪ pr_lift) ∪ (pr_inst ∪ (pr_lookup ∪ pr_cinst)))) ∪ (((pr_cext ∪ pr_clen) ∪ (pr_cnth ∪ (pr_capp ∪ pr_bsucc))) ∪ ((pr_bdbl ∪ (pr_badd ∪ pr_baddc)) ∪ (pr_bmul ∪ (pr_bpow ∪ pr_band))))) ∪ ((((pr_bor ∪ pr_bxor) ∪ (pr_ind_data ∪ (pr_ind_nested ∪ pr_nth_ty))) ∪ ((pr_nth_ctor ∪ pr_clen_c) ∪ (pr_ntys ∪ (pr_minor_idx ∪ pr_npis)))) ∪ (((pr_nth_pi ∪ pr_isort) ∪ (pr_ind_arity ∪ (pr_nidx ∪ pr_nfields))) ∪ ((pr_ndecl ∪ (pr_aux_of ∪ pr_pis)) ∪ (pr_lams ∪ (pr_tys_closed ∪ pr_pargs))))) $ by x1_in_l [l4]
l6: $ G ⇒ X ∈ (((((pr_le ∪ pr_add) ∪ (pr_lnth ∪ (pr_linst ∪ pr_lsubst))) ∪ ((pr_closed ∪ pr_lift) ∪ (pr_inst ∪ (pr_lookup ∪ pr_cinst)))) ∪ (((pr_cext ∪ pr_clen) ∪ (pr_cnth ∪ (pr_capp ∪ pr_bsucc))) ∪ ((pr_bdbl ∪ (pr_badd ∪ pr_baddc)) ∪ (pr_bmul ∪ (pr_bpow ∪ pr_band))))) ∪ ((((pr_bor ∪ pr_bxor) ∪ (pr_ind_data ∪ (pr_ind_nested ∪ pr_nth_ty))) ∪ ((pr_nth_ctor ∪ pr_clen_c) ∪ (pr_ntys ∪ (pr_minor_idx ∪ pr_npis)))) ∪ (((pr_nth_pi ∪ pr_isort) ∪ (pr_ind_arity ∪ (pr_nidx ∪ pr_nfields))) ∪ ((pr_ndecl ∪ (pr_aux_of ∪ pr_pis)) ∪ (pr_lams ∪ (pr_tys_closed ∪ pr_pargs)))))) ∪ (((((pr_spine ∪ pr_rehead) ∪ (pr_has_arg ∪ (pr_leaf_has ∪ pr_pinst))) ∪ ((pr_sinst ∪ pr_iargs) ∪ (pr_indapp ∪ (pr_ipos ∪ pr_recfield)))) ∪ (((pr_rst ∪ pr_nst_hit) ∪ (pr_spz ∪ (pr_afree ∪ pr_spz_ctors))) ∪ ((pr_aux_data ∪ (pr_mty ∪ pr_motives)) ∪ (pr_ihty ∪ (pr_mwalk ∪ pr_cminors))))) ∪ ((((pr_minors ∪ pr_rtail) ∪ (pr_rec_ty ∪ (pr_ctor_ty ∪ pr_ihval))) ∪ ((pr_rwalk ∪ pr_rec_rhs) ∪ (pr_struct_like ∪ (pr_field_ty ∪ pr_qinst)))) ∪ (((pr_nonrec ∪ pr_eta_ok) ∪ (pr_projs ∪ (pr_clift ∪ pr_psplit))) ∪ ((pr_iota_tel ∪ (pr_iota_lhs ∪ pr_crst)) ∪ (pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq)))))) $ by x1_in_l [l5]

lemma x1_pr_add (G: hyps) (X: class): $ G ⇒ X ∈ pr_add $ > $ G ⇒ X ∈ x1_top $
----
l1: $ G ⇒ X ∈ pr_le ∪ pr_add $ by x1_in_r [#1]
