l32: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by and_elim_r [l30]
l33: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ $ by and_elim_l [l23]
l34: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel $ by and_elim_r [l23]
l35: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ w2 = ⟨ kc_s , scons e ∅ ⟩ $ by and_elim_l [l34]
l36: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ w3 = a ∧ ra_isort d e a ∈ lrel $ by and_elim_r [l34]
l37: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ w3 = a $ by and_elim_l [l36]
l38: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ ra_isort d e a ∈ lrel $ by and_elim_r [l36]
l39: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ q2 = w2 ∧ q3 = w3 $ by y2_isort_e2 [l25, l27, l29, l31, l32, l33, l35, l37, l38]
