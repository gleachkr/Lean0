l7: $ G ⇒ pp = scons (ra_add V8 V2 V10) (scons (ra_recfield V1 V3 V2 V8 V18 V12) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V3 V10 V18 V19) (scons (ra_add V4 V3 V11) (scons (ra_lift V11 V8 V19 V20) (scons (ra_add V9 V7 V13) (scons (ra_add V14 V8 V13) (scons (ra_add V15 ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V14) (scons (ra_add V13 V4 V16) (scons (ra_lift V14 ⟨ kc_nz , ∅ ⟩ V20 V21) (scons (ra_ihty V1 V2 V3 V16 V15 ⟨ kc_nz , ∅ ⟩ V12 V21 V23) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ ⟨ kc_s , scons V9 ∅ ⟩ ⟨ kc_cons , scons V23 (scons V17 ∅) ⟩ V22 V24) ∅))))))))))) $ by and_elim_l [l6]
