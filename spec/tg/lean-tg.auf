l32: $ G ⇒ t1 = ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
