lemma y1_p_ihty (G: hyps): $ G ⇒ pr_ihty ⊆ y1_lab kr_ihty (suc kr_ihty) $
----
l1: $ G ⇒ cl_ihty_app ⊆ y1_lab kr_ihty (suc kr_ihty) $ by y1_k_ihty_app
l2: $ G ⇒ cl_ihty_pi ⊆ y1_lab kr_ihty (suc kr_ihty) $ by y1_k_ihty_pi
l3: $ G ⇒ pr_ihty ⊆ y1_lab kr_ihty (suc kr_ihty) $ by cun_least [l2, l1]

lemma y1_k_mwalk_pi_nr (G: hyps): $ G ⇒ cl_mwalk_pi_nr ⊆ y1_lab kr_mwalk (suc kr_mwalk) $
----
l1: $ G , x ∊ cl_mwalk_pi_nr ⇒ x ∊ cl_mwalk_pi_nr $ by ax
l2: $ G , x ∊ cl_mwalk_pi_nr ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h (x = ⟨ scons (ra_add c z g) (scons (ra_closed g k) (scons (ra_add v u i) (scons (ra_lift i c k d) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ f j e h) ∅)))) , ra_mwalk y z u v w a b c f j ⟨ kc_pi , scons k (scons e ∅) ⟩ ⟨ kc_pi , scons d (scons h ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_add c z g) (scons (ra_closed g k) (scons (ra_add v u i) (scons (ra_lift i c k d) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ f j e h) ∅)))) , ra_mwalk y z u v w a b c f j ⟨ kc_pi , scons k (scons e ∅) ⟩ ⟨ kc_pi , scons d (scons h ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add c z g) (scons (ra_closed g k) (scons (ra_add v u i) (scons (ra_lift i c k d) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ f j e h) ∅)))) , ra_mwalk y z u v w a b c f j ⟨ kc_pi , scons k (scons e ∅) ⟩ ⟨ kc_pi , scons d (scons h ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_add c z g) (scons (ra_closed g k) (scons (ra_add v u i) (scons (ra_lift i c k d) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ f j e h) ∅)))) , ra_mwalk y z u v w a b c f j ⟨ kc_pi , scons k (scons e ∅) ⟩ ⟨ kc_pi , scons d (scons h ∅) ⟩ ⟩ ⇒ kr_mwalk ∈ ω $ by x1_kr_mwalk
l5: $ G , x = ⟨ scons (ra_add c z g) (scons (ra_closed g k) (scons (ra_add v u i) (scons (ra_lift i c k d) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ f j e h) ∅)))) , ra_mwalk y z u v w a b c f j ⟨ kc_pi , scons k (scons e ∅) ⟩ ⟨ kc_pi , scons d (scons h ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_mwalk (suc kr_mwalk) $ by y1_lab_self [l3, l4]
