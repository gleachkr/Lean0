lemma y1_d_band_10 (G: hyps) {a_v b_v c_v d_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ ∈ cl_band_10 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $
