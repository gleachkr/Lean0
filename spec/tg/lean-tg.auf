l126: $ G ⇒ ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = V1 ∧ t2 = V2 ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v V2 dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk V1 V2 n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) $ by ex_intro [l125]
l127: $ G ⇒ ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk V1 np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) $ by ex_intro [l126]
l128: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) $ by ex_intro [l127]

lemma y1_d_rwalk_pi_nr (G: hyps) {D np n_v m_v v_v nf d_v dp mn Acc A A3 B Val: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10: set):
  $ G ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_nr $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x ∊ cl_rwalk_pi_nr ⇒ x ∊ cl_rwalk_pi_nr $ by ax
l2: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x ∊ cl_rwalk_pi_nr ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_add b z c) (scons (ra_closed c i) (scons (ra_add v u f) (scons (ra_lift f b i j) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ g k d) ∅)))) , ra_rwalk y z u v w a b g ⟨ kc_pi , scons i (scons k ∅) ⟩ ⟨ kc_lam , scons j (scons d ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_closed c i) (scons (ra_add v u f) (scons (ra_lift f b i j) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ g k d) ∅)))) , ra_rwalk y z u v w a b g ⟨ kc_pi , scons i (scons k ∅) ⟩ ⟨ kc_lam , scons j (scons d ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_closed c i) (scons (ra_add v u f) (scons (ra_lift f b i j) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ g k d) ∅)))) , ra_rwalk y z u v w a b g ⟨ kc_pi , scons i (scons k ∅) ⟩ ⟨ kc_lam , scons j (scons d ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_closed c i) (scons (ra_add v u f) (scons (ra_lift f b i j) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ g k d) ∅)))) , ra_rwalk y z u v w a b g ⟨ kc_pi , scons i (scons k ∅) ⟩ ⟨ kc_lam , scons j (scons d ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add b z c) (scons (ra_closed c i) (scons (ra_add v u f) (scons (ra_lift f b i j) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ g k d) ∅)))) , ra_rwalk y z u v w a b g ⟨ kc_pi , scons i (scons k ∅) ⟩ ⟨ kc_lam , scons j (scons d ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_closed c i) (scons (ra_add v u f) (scons (ra_lift f b i j) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ g k d) ∅)))) , ra_rwalk y z u v w a b g ⟨ kc_pi , scons i (scons k ∅) ⟩ ⟨ kc_lam , scons j (scons d ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ = ⟨ scons (ra_add b z c) (scons (ra_closed c i) (scons (ra_add v u f) (scons (ra_lift f b i j) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ g k d) ∅)))) , ra_rwalk y z u v w a b g ⟨ kc_pi , scons i (scons k ∅) ⟩ ⟨ kc_lam , scons j (scons d ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_closed c i) (scons (ra_add v u f) (scons (ra_lift f b i j) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ g k d) ∅)))) , ra_rwalk y z u v w a b g ⟨ kc_pi , scons i (scons k ∅) ⟩ ⟨ kc_lam , scons j (scons d ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
