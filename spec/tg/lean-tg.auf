l4: $ GG , c = ra_rehead q1 q2 q3 q4 q5 , c ∊ y2_P_rehead lrel ⇒ ∀ x3 ∀ x4 ∀ x5 (c = ⟨ kr_rehead , scons q1 (scons q2 (scons x3 (scons x4 (scons x5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons q2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → q1 = x6 ∧ x5 = x7)) $ by all_elim [l3]
