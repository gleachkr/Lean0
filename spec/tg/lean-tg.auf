lemma y2_nidx_e1 (GG: hyps) (q1 q2 q3 w3 u_D u_b u_P u_T u_i u_k u_F u_C u_l v_D v_b v_P v_T v_i v_k v_F v_C v_l: set):
  $ GG ⇒ q1 = u_D $ > $ GG ⇒ q2 = u_i $ > $ GG ⇒ q3 = u_k $ > $ GG ⇒ ra_ind_data u_D u_b u_P u_T ∈ lrel $ > $ GG ⇒ ra_nth_ty u_T u_i u_F u_C ∈ lrel $ > $ GG ⇒ ra_isort u_F u_k u_l ∈ lrel $ > $ GG ⇒ q1 = v_D $ > $ GG ⇒ q2 = v_i $ > $ GG ⇒ w3 = v_k $ > $ GG ⇒ ra_ind_data v_D v_b v_P v_T ∈ lrel $ > $ GG ⇒ ra_nth_ty v_T v_i v_F v_C ∈ lrel $ > $ GG ⇒ ra_isort v_F v_k v_l ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ u_D = q1 $ by eq_sym [#1]
l2: $ GG ⇒ u_D = v_D $ by eq_trans [l1, #7]
l3: $ GG ⇒ u_i = q2 $ by eq_sym [#2]
l4: $ GG ⇒ u_i = v_i $ by eq_trans [l3, #8]
l5: $ GG ⇒ v_D = u_D $ by eq_sym [l2]
l6: $ GG ⇒ v_b = v_b $ by eq_refl
l7: $ GG ⇒ v_P = v_P $ by eq_refl
l8: $ GG ⇒ v_T = v_T $ by eq_refl
l9: $ GG ⇒ ra_ind_data u_D v_b v_P v_T ∈ lrel $ by x1_eq_ind_data [#10, l5, l6, l7, l8]
l10: $ GG ⇒ u_b = v_b ∧ u_P = v_P ∧ u_T = v_T $ by lrel_ind_data_det [#4, l9]
l11: $ GG ⇒ u_b = v_b $ by and_elim_l [l10]
l12: $ GG ⇒ u_P = v_P ∧ u_T = v_T $ by and_elim_r [l10]
l13: $ GG ⇒ u_P = v_P $ by and_elim_l [l12]
l14: $ GG ⇒ u_T = v_T $ by and_elim_r [l12]
l15: $ GG ⇒ v_T = u_T $ by eq_sym [l14]
l16: $ GG ⇒ v_i = u_i $ by eq_sym [l4]
l17: $ GG ⇒ v_F = v_F $ by eq_refl
l18: $ GG ⇒ v_C = v_C $ by eq_refl
l19: $ GG ⇒ ra_nth_ty u_T u_i v_F v_C ∈ lrel $ by x1_eq_nth_ty [#11, l15, l16, l17, l18]
l20: $ GG ⇒ u_F = v_F ∧ u_C = v_C $ by lrel_nth_ty_det [#5, l19]
l21: $ GG ⇒ u_F = v_F $ by and_elim_l [l20]
l22: $ GG ⇒ u_C = v_C $ by and_elim_r [l20]
l23: $ GG ⇒ v_F = u_F $ by eq_sym [l21]
l24: $ GG ⇒ v_k = v_k $ by eq_refl
l25: $ GG ⇒ v_l = v_l $ by eq_refl
l26: $ GG ⇒ ra_isort u_F v_k v_l ∈ lrel $ by x1_eq_isort [#12, l23, l24, l25]
l27: $ GG ⇒ u_k = v_k ∧ u_l = v_l $ by lrel_isort_det [#6, l26]
l28: $ GG ⇒ u_k = v_k $ by and_elim_l [l27]
l29: $ GG ⇒ u_l = v_l $ by and_elim_r [l27]
l30: $ GG ⇒ v_k = w3 $ by eq_sym [#9]
l31: $ GG ⇒ q3 = v_k $ by eq_trans [#3, l28]
l32: $ GG ⇒ q3 = w3 $ by eq_trans [l31, l30]

lemma y2_nidx_c1 (GG: hyps) (q1 q2 q3 w3 u_D u_b u_P u_T u_i u_k u_F u_C u_l: set):
  $ GG ⇒ q1 = u_D ∧ q2 = u_i ∧ q3 = u_k ∧ ra_ind_data u_D u_b u_P u_T ∈ lrel ∧ ra_nth_ty u_T u_i u_F u_C ∈ lrel ∧ ra_isort u_F u_k u_l ∈ lrel $ > $ GG ⇒ ra_nidx q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ∃ a ∃ b ∃ d ∃ e ∃ f ∃ g ∃ h ∃ i ∃ j (q1 = a ∧ q2 = f ∧ w3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel) $ by lrel_nidx_cases [#2]
