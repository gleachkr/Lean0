l62: $ G ⇒ t7 = ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l61, l10, l24, l9, l9]
