l6: $ G ⇒ pp = scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V21 V11) (scons (ra_nidx V1 V9 V10) (scons (ra_add V2 V10 V11) (scons (ra_rehead V16 V18 V10 V21 V19) (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V16 V2) (scons (ra_add V8 V6 V12) (scons (ra_add V4 V3 V13) (scons (ra_add V12 V13 V14) (scons (ra_pargs ⟨ kc_ind_rec , scons V1 (scons V9 (scons V5 ∅)) ⟩ V14 V2 V17) (scons (ra_pargs V17 V12 V13 V18) (scons (ra_add V8 V7 V15) (scons (ra_pargs ⟨ kc_bvar , scons V15 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V20) ∅))))))))))) ∧ ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 = ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 V21 ⟨ kc_app , scons V19 (scons V20 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V21 V11) (scons (ra_nidx V1 V9 V10) (scons (ra_add V2 V10 V11) (scons (ra_rehead V16 V18 V10 V21 V19) (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V16 V2) (scons (ra_add V8 V6 V12) (scons (ra_add V4 V3 V13) (scons (ra_add V12 V13 V14) (scons (ra_pargs ⟨ kc_ind_rec , scons V1 (scons V9 (scons V5 ∅)) ⟩ V14 V2 V17) (scons (ra_pargs V17 V12 V13 V18) (scons (ra_add V8 V7 V15) (scons (ra_pargs ⟨ kc_bvar , scons V15 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V20) ∅))))))))))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 = ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 V21 ⟨ kc_app , scons V19 (scons V20 ∅) ⟩ $ by and_elim_r [l6]
