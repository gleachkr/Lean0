l14: $ G ⇒ k = ks_bin → ⊥ $ by v1_ne_gt [#2, l13]
l15: $ G ⇒ ks_blk ∈ ks_ctors $ by v1_lt_blk_ctors
l16: $ G ⇒ k = ks_blk → ⊥ $ by v1_ne_gt [#2, l15]
l17: $ G ⇒ ks_ind ∈ ks_ctors $ by v1_lt_ind_ctors
l18: $ G ⇒ k = ks_ind → ⊥ $ by v1_ne_gt [#2, l17]
l19: $ G ⇒ ks_tys ∈ ks_ctors $ by v1_lt_tys_ctors
l20: $ G ⇒ k = ks_tys → ⊥ $ by v1_ne_gt [#2, l19]
l21: $ G ⇒ ks_expr ∈ ω $ by v1_ks_expr
l22: $ G ⇒ isset ks_expr $ by wcel_isset [l21]
l23: $ G ⇒ ks_ctors ∈ ω $ by v1_ks_ctors
l24: $ G ⇒ isset ks_ctors $ by wcel_isset [l23]
l25: $ G , (t = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ x ∃ y (t = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors) ⇒ (t = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ x ∃ y (t = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors) $ by ax
l26: $ G ⇒ ((t = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ x ∃ y (t = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors)) → v1_d_ctors x y t $ by imp_intro [l25]
l27: $ G ⇒ (t = ⟨ kc_cnil , ∅ ⟩) → v1_d_ctors x y t $ by v1_imp_or_l [l26]
l28: $ G ⇒ (∃ x ∃ y (t = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors)) → v1_d_ctors x y t $ by v1_imp_or_r [l26]
l29: $ G , c = kc_cnil ∧ a = ∅ ⇒ (t = ⟨ kc_cnil , ∅ ⟩) $ by v1_build0 [#3, #4, #6]
l30: $ G , c = kc_cnil ∧ a = ∅ ⇒ (t = ⟨ kc_cnil , ∅ ⟩) → v1_d_ctors x y t $ by weaken [l27]
l31: $ G , c = kc_cnil ∧ a = ∅ ⇒ v1_d_ctors x y t $ by imp_elim [l30, l29]
l32: $ G , c = kc_ccons ∧ a = scons ks_expr (scons ks_ctors ∅) ⇒ ∃ x ∃ y (t = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors) $ by v1_build2 [l22, l24, #3, #4, #5, #6]
l33: $ G , c = kc_ccons ∧ a = scons ks_expr (scons ks_ctors ∅) ⇒ (∃ x ∃ y (t = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors)) → v1_d_ctors x y t $ by weaken [l28]
l34: $ G , c = kc_ccons ∧ a = scons ks_expr (scons ks_ctors ∅) ⇒ v1_d_ctors x y t $ by imp_elim [l33, l32]
