lemma y2_isort_e2 (GG: hyps) (q1 q2 q3 w2 w3 u_A u_B u_k u_l v_A v_B v_k v_l: set):
  $ GG ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_k ∅ ⟩ $ > $ GG ⇒ q3 = u_l $ > $ GG ⇒ ra_isort u_B u_k u_l ∈ lrel $ > $ GG ⇒ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ > $ GG ⇒ q1 = ⟨ kc_pi , scons v_A (scons v_B ∅) ⟩ $ > $ GG ⇒ w2 = ⟨ kc_s , scons v_k ∅ ⟩ $ > $ GG ⇒ w3 = v_l $ > $ GG ⇒ ra_isort v_B v_k v_l ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ = ⟨ kc_pi , scons v_A (scons v_B ∅) ⟩ $ by eq_trans [l1, #6]
l3: $ GG ⇒ kc_pi ∈ ω $ by v1_kc_pi
l4: $ GG ⇒ isset kc_pi $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_A $ by isset_var
l6: $ GG ⇒ isset u_B $ by isset_var
l7: $ GG ⇒ isset v_A $ by isset_var
l8: $ GG ⇒ isset v_B $ by isset_var
l9: $ GG ⇒ u_A = v_A ∧ u_B = v_B $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_A = v_A $ by and_elim_l [l9]
l11: $ GG ⇒ u_B = v_B $ by and_elim_r [l9]
l12: $ GG ⇒ v_B = u_B $ by eq_sym [l11]
l13: $ GG ⇒ v_k = v_k $ by eq_refl
l14: $ GG ⇒ v_l = v_l $ by eq_refl
l15: $ GG ⇒ ra_isort u_B v_k v_l ∈ lrel $ by x1_eq_isort [#9, l12, l13, l14]
l16: $ GG ⇒ isset u_B $ by isset_var
l17: $ GG ⇒ isset u_k $ by isset_var
l18: $ GG ⇒ isset u_l $ by isset_var
l19: $ GG ⇒ isset v_k $ by isset_var
l20: $ GG ⇒ isset v_l $ by isset_var
l21: $ GG ⇒ u_k = v_k ∧ u_l = v_l $ by y2_isort_ihc [l16, l17, l18, l19, l20, #5, l15]
l22: $ GG ⇒ u_k = v_k $ by and_elim_l [l21]
l23: $ GG ⇒ u_l = v_l $ by and_elim_r [l21]
l24: $ GG ⇒ ∅ = ∅ $ by eq_refl
l25: $ GG ⇒ scons u_k ∅ = scons v_k ∅ $ by scons_eq [l22, l24]
l26: $ GG ⇒ kc_s = kc_s $ by eq_refl
l27: $ GG ⇒ ⟨ kc_s , scons u_k ∅ ⟩ = ⟨ kc_s , scons v_k ∅ ⟩ $ by opair_eq [l26, l25]
l28: $ GG ⇒ ⟨ kc_s , scons v_k ∅ ⟩ = w2 $ by eq_sym [#7]
l29: $ GG ⇒ q2 = ⟨ kc_s , scons v_k ∅ ⟩ $ by eq_trans [#2, l27]
l30: $ GG ⇒ q2 = w2 $ by eq_trans [l29, l28]
l31: $ GG ⇒ v_l = w3 $ by eq_sym [#8]
l32: $ GG ⇒ q3 = v_l $ by eq_trans [#3, l23]
l33: $ GG ⇒ q3 = w3 $ by eq_trans [l32, l31]
l34: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by and_intro [l30, l33]

lemma y2_isort_c2 (GG: hyps) (q1 q2 q3 w2 w3 u_A u_B u_k u_l: set):
  $ GG ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q3 = u_l ∧ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ > $ GG ⇒ ra_isort q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG ⇒ ∃ a (q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ∨ ∃ b ∃ d ∃ e ∃ a (q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel) $ by lrel_isort_cases [#2]
l2: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by ax
l3: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q3 = u_l ∧ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q3 = u_l ∧ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_s , scons u_k ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = u_l ∧ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = u_l $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_isort u_B u_k u_l ∈ lrel $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_srt , scons a ∅ ⟩ $ by and_elim_l [l2]
l13: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by and_elim_r [l2]
l14: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l13]
