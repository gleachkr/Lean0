lemma y1_d_rtail_pi (G: hyps) {D np n_v m_v i_v d_v A B B2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_rtail_pi ⇒ x ∊ cl_rtail_pi $ by ax
l2: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_rtail_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
