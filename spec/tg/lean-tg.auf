l33: $ G , k = ks_blk , k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) ⇒ (t = ⟨ kc_iff_blk , ∅ ⟩) ∨ (t = ⟨ kc_nonempty_blk , ∅ ⟩) ∨ (t = ⟨ kc_le_blk , ∅ ⟩) ∨ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $ by or_intro_r [l32]
l34: $ G , k = ks_blk , k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) ⇒ (t = ⟨ kc_eq_blk , ∅ ⟩) ∨ (t = ⟨ kc_iff_blk , ∅ ⟩) ∨ (t = ⟨ kc_nonempty_blk , ∅ ⟩) ∨ (t = ⟨ kc_le_blk , ∅ ⟩) ∨ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $ by or_intro_r [l33]
l35: $ G , k = ks_blk , k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) ⇒ v1_d_blk n t $ by or_intro_r [l34]
l36: $ G , k = ks_blk ⇒ v1_d_blk n t $ by or_elim [l11, l28, l35]
l37: $ G ⇒ (t = ⟨ kc_nat_blk , ∅ ⟩) ∨ (t = ⟨ kc_eq_blk , ∅ ⟩) ∨ (t = ⟨ kc_iff_blk , ∅ ⟩) ∨ (t = ⟨ kc_nonempty_blk , ∅ ⟩) ∨ (t = ⟨ kc_le_blk , ∅ ⟩) ∨ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $ by isset_elim [l3, l36]

--| The cases of sort `ind`.
def v1_d_ind {u v x y: set} (t: set): fml = $ ∃ x ∃ y ∃ u (t = ⟨ kc_ind_mk , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys) ∨ ∃ x ∃ y ∃ u ∃ v (t = ⟨ kc_ind_mkn , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys ∧ v ∊ ofsort lsig lopen ks_ctx) $

lemma v1_node_ind (G: hyps) {u v x y: set} (c k a b t: set):
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ > $ G ⇒ k = ks_ind $ > $ G ⇒ b ∊ fseq (trees ω) $ >
  $ G ⇒ cdm b = cdm a $ > $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G ⇒ v1_d_ind u v x y t $
----
l1: $ G ⇒ ks_nat ∈ ks_ind $ by v1_lt_nat_ind
l2: $ G ⇒ k = ks_nat → ⊥ $ by v1_ne_gt [#2, l1]
l3: $ G ⇒ ks_lvl ∈ ks_ind $ by v1_lt_lvl_ind
l4: $ G ⇒ k = ks_lvl → ⊥ $ by v1_ne_gt [#2, l3]
l5: $ G ⇒ ks_lvls ∈ ks_ind $ by v1_lt_lvls_ind
l6: $ G ⇒ k = ks_lvls → ⊥ $ by v1_ne_gt [#2, l5]
l7: $ G ⇒ ks_expr ∈ ks_ind $ by v1_lt_expr_ind
l8: $ G ⇒ k = ks_expr → ⊥ $ by v1_ne_gt [#2, l7]
l9: $ G ⇒ ks_atom ∈ ks_ind $ by v1_lt_atom_ind
l10: $ G ⇒ k = ks_atom → ⊥ $ by v1_ne_gt [#2, l9]
l11: $ G ⇒ ks_ctx ∈ ks_ind $ by v1_lt_ctx_ind
l12: $ G ⇒ k = ks_ctx → ⊥ $ by v1_ne_gt [#2, l11]
l13: $ G ⇒ ks_bin ∈ ks_ind $ by v1_lt_bin_ind
l14: $ G ⇒ k = ks_bin → ⊥ $ by v1_ne_gt [#2, l13]
l15: $ G ⇒ ks_blk ∈ ks_ind $ by v1_lt_blk_ind
l16: $ G ⇒ k = ks_blk → ⊥ $ by v1_ne_gt [#2, l15]
l17: $ G ⇒ ks_ind ∈ ks_tys $ by v1_lt_ind_tys
l18: $ G ⇒ k = ks_tys → ⊥ $ by v1_ne_lt [#2, l17]
l19: $ G ⇒ ks_ind ∈ ks_ctors $ by v1_lt_ind_ctors
l20: $ G ⇒ k = ks_ctors → ⊥ $ by v1_ne_lt [#2, l19]
l21: $ G ⇒ ks_blk ∈ ω $ by v1_ks_blk
l22: $ G ⇒ isset ks_blk $ by wcel_isset [l21]
l23: $ G ⇒ ks_ctx ∈ ω $ by v1_ks_ctx
l24: $ G ⇒ isset ks_ctx $ by wcel_isset [l23]
l25: $ G ⇒ ks_tys ∈ ω $ by v1_ks_tys
l26: $ G ⇒ isset ks_tys $ by wcel_isset [l25]
l27: $ G , ∃ x ∃ y ∃ u (t = ⟨ kc_ind_mk , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys) ∨ ∃ x ∃ y ∃ u ∃ v (t = ⟨ kc_ind_mkn , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys ∧ v ∊ ofsort lsig lopen ks_ctx) ⇒ ∃ x ∃ y ∃ u (t = ⟨ kc_ind_mk , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys) ∨ ∃ x ∃ y ∃ u ∃ v (t = ⟨ kc_ind_mkn , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys ∧ v ∊ ofsort lsig lopen ks_ctx) $ by ax
l28: $ G ⇒ (∃ x ∃ y ∃ u (t = ⟨ kc_ind_mk , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys) ∨ ∃ x ∃ y ∃ u ∃ v (t = ⟨ kc_ind_mkn , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys ∧ v ∊ ofsort lsig lopen ks_ctx)) → v1_d_ind u v x y t $ by imp_intro [l27]
l29: $ G ⇒ (∃ x ∃ y ∃ u (t = ⟨ kc_ind_mk , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys)) → v1_d_ind u v x y t $ by v1_imp_or_l [l28]
l30: $ G ⇒ (∃ x ∃ y ∃ u ∃ v (t = ⟨ kc_ind_mkn , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys ∧ v ∊ ofsort lsig lopen ks_ctx)) → v1_d_ind u v x y t $ by v1_imp_or_r [l28]
l31: $ G , c = kc_ind_mk ∧ a = scons ks_blk (scons ks_ctx (scons ks_tys ∅)) ⇒ ∃ x ∃ y ∃ u (t = ⟨ kc_ind_mk , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys) $ by v1_build3 [l22, l24, l26, #3, #4, #5, #6]
l32: $ G , c = kc_ind_mk ∧ a = scons ks_blk (scons ks_ctx (scons ks_tys ∅)) ⇒ (∃ x ∃ y ∃ u (t = ⟨ kc_ind_mk , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys)) → v1_d_ind u v x y t $ by weaken [l29]
l33: $ G , c = kc_ind_mk ∧ a = scons ks_blk (scons ks_ctx (scons ks_tys ∅)) ⇒ v1_d_ind u v x y t $ by imp_elim [l32, l31]
l34: $ G , c = kc_ind_mkn ∧ a = scons ks_blk (scons ks_ctx (scons ks_tys (scons ks_ctx ∅))) ⇒ ∃ x ∃ y ∃ u ∃ v (t = ⟨ kc_ind_mkn , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys ∧ v ∊ ofsort lsig lopen ks_ctx) $ by v1_build4 [l22, l24, l26, l24, #3, #4, #5, #6]
l35: $ G , c = kc_ind_mkn ∧ a = scons ks_blk (scons ks_ctx (scons ks_tys (scons ks_ctx ∅))) ⇒ (∃ x ∃ y ∃ u ∃ v (t = ⟨ kc_ind_mkn , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys ∧ v ∊ ofsort lsig lopen ks_ctx)) → v1_d_ind u v x y t $ by weaken [l30]
l36: $ G , c = kc_ind_mkn ∧ a = scons ks_blk (scons ks_ctx (scons ks_tys (scons ks_ctx ∅))) ⇒ v1_d_ind u v x y t $ by imp_elim [l35, l34]
l37: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_le_blk → v1_d_ind u v x y t $ by v1_skip_le_blk [l16]
l38: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_choice_atom → v1_d_ind u v x y t $ by v1_skip_choice_atom [l10, l37]
l39: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_nonempty_blk → v1_d_ind u v x y t $ by v1_skip_nonempty_blk [l16, l38]
l40: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_quot_sound_atom → v1_d_ind u v x y t $ by v1_skip_quot_sound_atom [l10, l39]
l41: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_propext_atom → v1_d_ind u v x y t $ by v1_skip_propext_atom [l10, l40]
l42: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_iff_blk → v1_d_ind u v x y t $ by v1_skip_iff_blk [l16, l41]
l43: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_quot_ind → v1_d_ind u v x y t $ by v1_skip_quot_ind [l8, l42]
l44: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_quot_lift → v1_d_ind u v x y t $ by v1_skip_quot_lift [l8, l43]
l45: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_quot_mk → v1_d_ind u v x y t $ by v1_skip_quot_mk [l8, l44]
