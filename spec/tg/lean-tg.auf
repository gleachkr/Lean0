l22: $ G , ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩) ⇒ ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩) $ by ax
l23: $ G , ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l22, l21]
