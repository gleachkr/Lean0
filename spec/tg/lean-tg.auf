lemma y1_e_band_0l (G: hyps) {b_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ V1 ⟨ kc_b0 , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ V1 ⟨ kc_b0 , ∅ ⟩ ⟩ = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_band t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_band ⟨ kc_b0 , ∅ ⟩ V1 ⟨ kc_b0 , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_band t1 t2 t3 = ra_band ⟨ kc_b0 , ∅ ⟩ V1 ⟨ kc_b0 , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_band t1 t2 t3 = ra_band ⟨ kc_b0 , ∅ ⟩ V1 ⟨ kc_b0 , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V1 $ by isset_var
l19: $ G ⇒ scons V1 (scons ⟨ kc_b0 , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l16, l19]
l21: $ G ⇒ kr_band ∈ ω $ by x1_kr_band
l22: $ G ⇒ isset kr_band $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_band = kr_band ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ ∅) $ by y1_scons_inj [l26, l14, l16, l13, l19]
l28: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons ⟨ kc_b0 , ∅ ⟩ ∅ $ by y1_scons_inj [l29, l12, l18, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons ⟨ kc_b0 , ∅ ⟩ ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = ⟨ kc_b0 , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = ⟨ kc_b0 , ∅ ⟩ $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = V1 ∧ t3 = ⟨ kc_b0 , ∅ ⟩ $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by ex_intro [l36]

lemma y1_d_band_0l (G: hyps) {b_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ ∈ cl_band_0l $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_0l ⇒ x ∊ cl_band_0l $ by ax
l2: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_0l ⇒ ∃ y (x = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band ⟨ kc_b0 , ∅ ⟩ y ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by y1_e_band_0l [l6, l7]
l9: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_0l ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_band_0r (G: hyps) {a_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ ∅ , ra_band V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_band V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_band t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_band V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_band t1 t2 t3 = ra_band V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_band t1 t2 t3 = ra_band V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset V1 $ by isset_var
l20: $ G ⇒ scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_band ∈ ω $ by x1_kr_band
l22: $ G ⇒ isset kr_band $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_band = kr_band ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_b0 , ∅ ⟩ ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_b0 , ∅ ⟩ ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons ⟨ kc_b0 , ∅ ⟩ ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = ⟨ kc_b0 , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l33]
l35: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩ $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩ $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by ex_intro [l36]

lemma y1_d_band_0r (G: hyps) {a_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ ∈ cl_band_0r $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_0r ⇒ x ∊ cl_band_0r $ by ax
l2: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_0r ⇒ ∃ y (x = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_band y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by y1_e_band_0r [l6, l7]
l9: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_0r ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_band_00 (G: hyps) {a_v b_v c_v d_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) , ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) , ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 ⟩ = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_band t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) ∧ ra_band t1 t2 t3 = ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_band t1 t2 t3 = ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V4 $ by isset_var
l17: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_band ∈ ω $ by x1_kr_band
l23: $ G ⇒ isset kr_band $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_band = kr_band ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons V4 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V4 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V4 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_band V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_band V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_bdbl V3 V4) ∅) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_bdbl V3 V4) $ by opair_isset
l42: $ G ⇒ ra_bdbl V3 V4 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l39, l42]
l44: $ G ⇒ t3 = V4 ∧ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l35, l43]
l45: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = V4 ∧ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l32, l44]
l46: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = V4 ∧ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l29, l45]
l47: $ G ⇒ ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = d_v ∧ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 d_v ∈ lrel) $ by ex_intro [l46]
l48: $ G ⇒ ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = d_v ∧ ra_band V1 V2 c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l47]
l49: $ G ⇒ ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band V1 b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l48]
l50: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l49]

lemma y1_d_band_00 (G: hyps) {a_v b_v c_v d_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ ∈ cl_band_00 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_00 ⇒ x ∊ cl_band_00 $ by ax
l2: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_00 ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ x = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by y1_e_band_00 [l6, l7]
l9: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_00 ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_e_band_01 (G: hyps) {a_v b_v c_v d_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) , ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) , ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ V4 ⟩ = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_band t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ V4) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) ∧ ra_band t1 t2 t3 = ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_band t1 t2 t3 = ra_band ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V4 $ by isset_var
l17: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_bd1 , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_band ∈ ω $ by x1_kr_band
l23: $ G ⇒ isset kr_band $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V4 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_band = kr_band ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V4 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V4 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V4 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V4 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons V4 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V4 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V4 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_band V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_band V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_bdbl V3 V4) ∅) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_bdbl V3 V4) $ by opair_isset
l42: $ G ⇒ ra_bdbl V3 V4 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l39, l42]
l44: $ G ⇒ t3 = V4 ∧ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l35, l43]
l45: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = V4 ∧ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l32, l44]
l46: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = V4 ∧ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l29, l45]
l47: $ G ⇒ ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = d_v ∧ ra_band V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 d_v ∈ lrel) $ by ex_intro [l46]
l48: $ G ⇒ ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = d_v ∧ ra_band V1 V2 c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l47]
l49: $ G ⇒ ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band V1 b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l48]
l50: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l49]

lemma y1_d_band_01 (G: hyps) {a_v b_v c_v d_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ ∈ cl_band_01 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_01 ⇒ x ∊ cl_band_01 $ by ax
l2: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_01 ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩ ⇒ x = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩ ⇒ x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩ ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by y1_e_band_01 [l6, l7]
l9: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) ⇒ ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_band y z u) (scons (ra_bdbl u v) ∅) , ra_band ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_band t1 t2 t3 ⟩ , x ∊ cl_band_01 ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_e_band_10 (G: hyps) {a_v b_v c_v d_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_band t1 t2 t3 ⟩ = ⟨ scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) , ra_band ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) , ra_band ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 ⟩ = ⟨ pp , ra_band t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_band V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) $ by y1_opair_set_l [l1]
