lemma y1_d_bor_01 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_01 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $
