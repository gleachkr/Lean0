l9: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ∪ cl_lift_proj , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ⇒ ∃ n_v ∃ j_v ∃ k_v ∃ e_v (t1 = n_v ∧ t2 = k_v ∧ t3 = e_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) $ by y1_d_lift_closed [l7, l8]
l10: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ∪ cl_lift_proj , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ⇒ ∃ n_v ∃ j_v ∃ k_v ∃ e_v (t1 = n_v ∧ t2 = k_v ∧ t3 = e_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_closed ∪ cl_lift_proj , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_proj ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_proj $ by ax
