l44: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) ⇒ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $ by ex_elim [l43, l42]
l45: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_ctor ⇒ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $ by ex_elim [l2, l44]
l46: $ G ⇒ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $ by wcel_elim [#1, l45]

lemma y1_e_rst_app (G: hyps) {D N f_v a_v f2 a2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) , ra_rst V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) , ra_rst V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_rst V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) ∧ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_rst ∈ ω $ by x1_kr_rst
l27: $ G ⇒ isset kr_rst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_rst = kr_rst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ scons t4 ∅ = scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_rst V1 V2 V3 V5) $ by opair_isset
l46: $ G ⇒ ra_rst V1 V2 V3 V5 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_rst V1 V2 V4 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_rst V1 V2 V4 V6) $ by opair_isset
l49: $ G ⇒ ra_rst V1 V2 V4 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons V5 (scons a2 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 a2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst V1 V2 V3 f2 ∈ lrel ∧ ra_rst V1 V2 V4 a2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst V1 V2 V3 f2 ∈ lrel ∧ ra_rst V1 V2 a_v a2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst V1 V2 f_v f2 ∈ lrel ∧ ra_rst V1 V2 a_v a2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst V1 N f_v f2 ∈ lrel ∧ ra_rst V1 N a_v a2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_rst_app (G: hyps) {D N f_v a_v f2 a2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_app ⇒ x ∊ cl_rst_app $ by ax
l2: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by y1_e_rst_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_app ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_rst_lam (G: hyps) {D N A b_v A2 b2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) , ra_rst V1 V2 ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) , ra_rst V1 V2 ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_rst V1 V2 ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) ∧ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_rst ∈ ω $ by x1_kr_rst
l27: $ G ⇒ isset kr_rst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_rst = kr_rst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ scons t4 ∅ = scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_rst V1 V2 V3 V5) $ by opair_isset
l46: $ G ⇒ ra_rst V1 V2 V3 V5 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_rst V1 V2 V4 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_rst V1 V2 V4 V6) $ by opair_isset
l49: $ G ⇒ ra_rst V1 V2 V4 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ b2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons V5 (scons b2 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 b2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst V1 V2 V3 A2 ∈ lrel ∧ ra_rst V1 V2 V4 b2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ b_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_lam , scons V3 (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst V1 V2 V3 A2 ∈ lrel ∧ ra_rst V1 V2 b_v b2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst V1 V2 A A2 ∈ lrel ∧ ra_rst V1 V2 b_v b2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst V1 N A A2 ∈ lrel ∧ ra_rst V1 N b_v b2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_rst_lam (G: hyps) {D N A b_v A2 b2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_lam $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_lam ⇒ x ∊ cl_rst_lam $ by ax
l2: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_lam ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩ ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by y1_e_rst_lam [l6, l7]
l9: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_lam , scons u (scons v ∅) ⟩ ⟨ kc_lam , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_lam ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_rst_pi (G: hyps) {D N A b_v A2 b2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) , ra_rst V1 V2 ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) , ra_rst V1 V2 ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_rst V1 V2 ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_rst V1 V2 V3 V5) (scons (ra_rst V1 V2 V4 V6) ∅) ∧ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
