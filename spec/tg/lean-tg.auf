l8: $ GG ⇒ ∀ d ∀ e ∀ f ∀ g (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_s , scons g ∅ ⟩ ∧ q4 = ⟨ kc_app , scons d (scons f ∅) ⟩ ∧ q5 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ ra_rehead a b g d e ∈ lrel ∧ ra_rehead a b g d e ∈ y2_P_rehead lrel → q1 = w1 ∧ q5 = w5) $ by all_intro [l7]
l9: $ GG ⇒ ∀ b ∀ d ∀ e ∀ f ∀ g (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_s , scons g ∅ ⟩ ∧ q4 = ⟨ kc_app , scons d (scons f ∅) ⟩ ∧ q5 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ ra_rehead a b g d e ∈ lrel ∧ ra_rehead a b g d e ∈ y2_P_rehead lrel → q1 = w1 ∧ q5 = w5) $ by all_intro [l8]
l10: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e ∀ f ∀ g (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_s , scons g ∅ ⟩ ∧ q4 = ⟨ kc_app , scons d (scons f ∅) ⟩ ∧ q5 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ ra_rehead a b g d e ∈ lrel ∧ ra_rehead a b g d e ∈ y2_P_rehead lrel → q1 = w1 ∧ q5 = w5) $ by all_intro [l9]
l11: $ GG ⇒ q1 = w1 ∧ q5 = w5 $ by y2_rehead_i2 [#1, #2, l10]

lemma y2_rehead_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_rehead lrel → c ∊ y2_P_rehead lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ c = ra_rehead x1 x2 x3 x4 x5 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ pr_rehead $ by lprog_rehead_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_rehead lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ ra_rehead x6 x2 x3 x4 x7 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel , ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_z ⇒ ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_z $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel , ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_z ⇒ crn o ⊆ horn lprog ∩ y2_P_rehead lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel , ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_z ⇒ ra_rehead x6 x2 x3 x4 x7 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel , ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_z ⇒ x1 = x6 ∧ x5 = x7 $ by y2_rehead_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel , ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_s ⇒ ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_s $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel , ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_s ⇒ crn o ⊆ horn lprog ∩ y2_P_rehead lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel , ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_s ⇒ ra_rehead x6 x2 x3 x4 x7 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel , ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_s ⇒ x1 = x6 ∧ x5 = x7 $ by y2_rehead_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_s → x1 = x6 ∧ x5 = x7 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ ⟨ o , ra_rehead x1 x2 x3 x4 x5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s → x1 = x6 ∧ x5 = x7 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 , ra_rehead x6 x2 x3 x4 x7 ∈ lrel ⇒ x1 = x6 ∧ x5 = x7 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 ⇒ ra_rehead x6 x2 x3 x4 x7 ∈ lrel → x1 = x6 ∧ x5 = x7 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 ⇒ ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → x1 = x6 ∧ x5 = x7) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel , c = ra_rehead x1 x2 x3 x4 x5 ⇒ ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → x1 = x6 ∧ x5 = x7) $ by all_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel ⇒ c = ⟨ kr_rehead , scons x1 (scons x2 (scons x3 (scons x4 (scons x5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → x1 = x6 ∧ x5 = x7) $ by imp_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel ⇒ ∀ x5 (c = ⟨ kr_rehead , scons x1 (scons x2 (scons x3 (scons x4 (scons x5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → x1 = x6 ∧ x5 = x7)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel ⇒ ∀ x4 ∀ x5 (c = ⟨ kr_rehead , scons x1 (scons x2 (scons x3 (scons x4 (scons x5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → x1 = x6 ∧ x5 = x7)) $ by all_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel ⇒ ∀ x3 ∀ x4 ∀ x5 (c = ⟨ kr_rehead , scons x1 (scons x2 (scons x3 (scons x4 (scons x5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → x1 = x6 ∧ x5 = x7)) $ by all_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel ⇒ ∀ x2 ∀ x3 ∀ x4 ∀ x5 (c = ⟨ kr_rehead , scons x1 (scons x2 (scons x3 (scons x4 (scons x5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → x1 = x6 ∧ x5 = x7)) $ by all_intro [l26]
l28: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 (c = ⟨ kr_rehead , scons x1 (scons x2 (scons x3 (scons x4 (scons x5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ lrel → x1 = x6 ∧ x5 = x7)) $ by all_intro [l27]
l29: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_rehead lrel ⇒ c ∊ y2_P_rehead lrel $ by cab_intro [l28]
l30: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_rehead lrel → c ∊ y2_P_rehead lrel $ by imp_intro [l29]
l31: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_rehead lrel → c ∊ y2_P_rehead lrel $ by imp_intro [l30]
l32: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_rehead lrel → c ∊ y2_P_rehead lrel) $ by all_intro [l31]
l33: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_rehead lrel → c ∊ y2_P_rehead lrel) $ by all_intro [l32]

lemma y2_rehead_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_rehead lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_rehead lrel → c ∊ y2_P_rehead lrel) $ by y2_rehead_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_rehead lrel $ by horn_ind [l1, l2]

lrel_rehead_det
---------------
l1: $ G ⇒ horn lprog ⊆ y2_P_rehead lrel $ by y2_rehead_in
l2: $ G ⇒ ra_rehead u1 t2 t3 t4 u5 ∈ y2_P_rehead lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u1 = v1 ∧ u5 = v5 $ by y2_rehead_ih [l2, #2]

--| The atoms of `spine` whose variants in `L` with the same inputs have the same outputs.
def y2_P_spine (L: class) (.c .x1 .x2 .x3 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_spine , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons x2 (scons x3 ∅)) ⟩ ∈ L → x1 = x6))} $

lemma y2_spine_ih (GG: hyps) (q1 q2 q3 w1: set):
  $ GG ⇒ ra_spine q1 q2 q3 ∈ y2_P_spine lrel $ > $ GG ⇒ ra_spine w1 q2 q3 ∈ lrel $ > $ GG ⇒ q1 = w1 $
----
l1: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ c ∊ y2_P_spine lrel $ by ax
l2: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_spine , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons x2 (scons x3 ∅)) ⟩ ∈ lrel → x1 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_spine , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons x2 (scons x3 ∅)) ⟩ ∈ lrel → q1 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ ∀ x3 (c = ⟨ kr_spine , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons q2 (scons x3 ∅)) ⟩ ∈ lrel → q1 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ c = ⟨ kr_spine , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons q2 (scons q3 ∅)) ⟩ ∈ lrel → q1 = x6) $ by all_elim [l4]
l6: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ c = ra_spine q1 q2 q3 $ by ax
l7: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ ∀ x6 (⟨ kr_spine , scons x6 (scons q2 (scons q3 ∅)) ⟩ ∈ lrel → q1 = x6) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ ra_spine w1 q2 q3 ∈ lrel → q1 = w1 $ by all_elim [l7]
l9: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ ra_spine w1 q2 q3 ∈ lrel $ by weaken [#2]
l10: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine lrel ⇒ q1 = w1 $ by imp_elim [l8, l9]
l11: $ GG ⇒ q1 = w1 $ by wcel_elim [#1, l10]

lemma y2_spine_ihc (GG: hyps) (Q1 Q2 Q3 W1: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset W1 $ > $ GG ⇒ ra_spine Q1 Q2 Q3 ∈ y2_P_spine lrel $ > $ GG ⇒ ra_spine W1 Q2 Q3 ∈ lrel $ > $ GG ⇒ Q1 = W1 $
----
l1: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ d = Q3 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ e = W1 $ by ax
l5: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ Q1 = a $ by eq_sym [l1]
l6: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ Q2 = b $ by eq_sym [l2]
l7: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ Q3 = d $ by eq_sym [l3]
l8: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ W1 = e $ by eq_sym [l4]
l9: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ ∅ = ∅ $ by eq_refl
l10: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ scons Q3 ∅ = scons d ∅ $ by scons_eq [l7, l9]
l11: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ scons Q2 (scons Q3 ∅) = scons b (scons d ∅) $ by scons_eq [l6, l10]
l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ scons Q1 (scons Q2 (scons Q3 ∅)) = scons a (scons b (scons d ∅)) $ by scons_eq [l5, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ kr_spine = kr_spine $ by eq_refl
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ ra_spine Q1 Q2 Q3 = ra_spine a b d $ by opair_eq [l13, l12]
l15: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ ra_spine Q1 Q2 Q3 ∈ y2_P_spine lrel $ by weaken [#5]
l16: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ ra_spine a b d ∈ y2_P_spine lrel $ by wcel_eq_l [l14, l15]
l17: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ ra_spine W1 Q2 Q3 ∈ lrel $ by weaken [#6]
l18: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ ra_spine e b d ∈ lrel $ by x1_eq_spine [l17, l8, l6, l7]
l19: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ a = e $ by y2_spine_ih [l16, l18]
l20: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ Q1 = e $ by eq_trans [l5, l19]
l21: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W1 ⇒ Q1 = W1 $ by eq_trans [l20, l4]
l22: $ GG , a = Q1 , b = Q2 , d = Q3 ⇒ Q1 = W1 $ by isset_elim [#4, l21]
l23: $ GG , a = Q1 , b = Q2 ⇒ Q1 = W1 $ by isset_elim [#3, l22]
l24: $ GG , a = Q1 ⇒ Q1 = W1 $ by isset_elim [#2, l23]
l25: $ GG ⇒ Q1 = W1 $ by isset_elim [#1, l24]

lemma y2_spine_i1 (GG: hyps) {h: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ ∈ cl_spine_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_spine lrel $ > $ GG ⇒ ∀ h (q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z ⇒ w ∊ cl_spine_z $ by ax
l2: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z ⇒ ∃ h (w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_spine q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_spine q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_spine h h ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ ∧ ra_spine q1 q2 q3 = ra_spine h h ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ kr_spine , scons q1 (scons q2 (scons q3 ∅)) ⟩ = ⟨ kr_spine , scons h (scons h (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_spine ∈ ω $ by x1_kr_spine
l15: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset kr_spine $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q3 $ by isset_var
l19: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset h $ by isset_var
l20: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset h $ by isset_var
l21: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l22: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by y2_nd3 [l13, l15, l16, l17, l18, l19, l20, l21]
l23: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = h $ by and_elim_l [l22]
l24: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l22]
l25: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = h $ by and_elim_l [l24]
l26: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l24]
l27: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l25, l26]
l28: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l23, l27]
l29: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∀ h (q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ → ph) $ by weaken [#3]
l30: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ → ph $ by all_elim [l29]
l31: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ph $ by imp_elim [l30, l28]
l32: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z ⇒ ph $ by ex_elim [l2, l31]
l33: $ GG ⇒ ph $ by wcel_elim [#1, l32]

lemma y2_spine_e1 (GG: hyps) (q1 q2 q3 w1 u_h v_h: set):
  $ GG ⇒ q1 = u_h $ > $ GG ⇒ q2 = u_h $ > $ GG ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ w1 = v_h $ > $ GG ⇒ q2 = v_h $ > $ GG ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q1 = w1 $
----
l1: $ GG ⇒ u_h = q2 $ by eq_sym [#2]
l2: $ GG ⇒ u_h = v_h $ by eq_trans [l1, #5]
l3: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = q3 $ by eq_sym [#3]
l4: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [l3, #6]
l5: $ GG ⇒ v_h = w1 $ by eq_sym [#4]
l6: $ GG ⇒ q1 = v_h $ by eq_trans [#1, l2]
l7: $ GG ⇒ q1 = w1 $ by eq_trans [l6, l5]

lemma y2_spine_c1 (GG: hyps) (q1 q2 q3 w1 u_h: set):
  $ GG ⇒ q1 = u_h ∧ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ ra_spine w1 q2 q3 ∈ lrel $ > $ GG ⇒ q1 = w1 $
----
l1: $ GG ⇒ ∃ a (w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by lrel_spine_cases [#2]
l2: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = u_h ∧ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l4: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = u_h $ by and_elim_l [l3]
l5: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l3]
l6: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = u_h $ by and_elim_l [l5]
l7: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l5]
l8: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ w1 = a $ by and_elim_l [l2]
l9: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l10: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = a $ by and_elim_l [l9]
l11: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l9]
l12: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = w1 $ by y2_spine_e1 [l4, l6, l7, l8, l10, l11]
l13: $ GG , ∃ a (w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ a (w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩) $ by ax
l14: $ GG , ∃ a (w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩) ⇒ q1 = w1 $ by ex_elim [l13, l12]
l15: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel $ by ax
l16: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = u_h ∧ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l17: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = u_h $ by and_elim_l [l16]
l18: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l16]
l19: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q2 = u_h $ by and_elim_l [l18]
l20: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l18]
l21: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ w1 = a $ by and_elim_l [l15]
l22: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel $ by and_elim_r [l15]
l23: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ $ by and_elim_l [l22]
l24: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel $ by and_elim_r [l22]
l25: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q3 = ⟨ kc_s , scons e ∅ ⟩ $ by and_elim_l [l24]
l26: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ ra_spine a b e ∈ lrel $ by and_elim_r [l24]
l27: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ kc_nz ∈ kc_s $ by y2_lt_nz_s
l28: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ kc_s ∈ ω $ by v1_kc_s
l29: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ isset kc_s $ by wcel_isset [l28]
l30: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ ⊥ $ by y2_ne [l20, l25, l27, l29]
l31: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = w1 $ by bot_elim [l30]
l32: $ GG , ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by ax
l33: $ GG , ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ q1 = w1 $ by ex_elim [l32, l31]
l34: $ GG , ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by ax
l35: $ GG , ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ q1 = w1 $ by ex_elim [l34, l33]
l36: $ GG , ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by ax
l37: $ GG , ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ q1 = w1 $ by ex_elim [l36, l35]
l38: $ GG , ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by ax
l39: $ GG , ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ q1 = w1 $ by ex_elim [l38, l37]
l40: $ GG ⇒ q1 = w1 $ by or_elim [l1, l14, l39]

lemma y2_spine_d1 (GG: hyps) (o q1 q2 q3 w1: set):
  $ GG ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ ∈ cl_spine_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_spine lrel $ > $ GG ⇒ ra_spine w1 q2 q3 ∈ lrel $ > $ GG ⇒ q1 = w1 $
----
l1: $ GG , q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ GG , q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_spine w1 q2 q3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = w1 $ by y2_spine_c1 [l1, l2]
l4: $ GG ⇒ q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ → q1 = w1 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ a (q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ → q1 = w1) $ by all_intro [l4]
l6: $ GG ⇒ q1 = w1 $ by y2_spine_i1 [#1, #2, l5]

lemma y2_spine_i2 (GG: hyps) {h e a k: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ ∈ cl_spine_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_spine lrel $ > $ GG ⇒ ∀ h ∀ e ∀ a ∀ k (q1 = h ∧ q2 = ⟨ kc_app , scons e (scons a ∅) ⟩ ∧ q3 = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine h e k ∈ lrel ∧ ra_spine h e k ∈ y2_P_spine lrel → ph) $ > $ GG ⇒ ph $
----
