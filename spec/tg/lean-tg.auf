l32: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w2 = a ∧ w3 = b ∧ w4 = d $ by and_elim_r [l23]
l33: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w2 = a $ by and_elim_l [l32]
l34: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w3 = b ∧ w4 = d $ by and_elim_r [l32]
