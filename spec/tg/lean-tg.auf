lemma y1_d_mwalk_res (G: hyps) {D np n_v k_v i_v c_v d_v r_v dp kn h0 h1 h_v ni mi a_v b_v Ihs K K2 K3 Y X Y1 Y2 Min: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12: set):
  $ G ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ ∈ cl_mwalk_res $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ h0 ∃ h1 ∃ h_v ∃ ni ∃ mi ∃ a_v ∃ b_v ∃ Ihs ∃ K ∃ K2 ∃ K3 ∃ Y ∃ X ∃ Y1 ∃ Y2 ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = d_v ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = K ∧ t12 = Min ∧ ra_add d_v np dp ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_add dp i_v h0 ∈ lrel ∧ ra_add h0 kn h1 ∈ lrel ∧ ra_add h1 r_v h_v ∈ lrel ∧ ra_lift kn d_v K K2 ∈ lrel ∧ ra_lift r_v ⟨ kc_nz , ∅ ⟩ K2 K3 ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mi ∅ ⟩ ni K3 X ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons h_v ∅ ⟩ Y np ∈ lrel ∧ ra_add r_v d_v a_v ∈ lrel ∧ ra_add a_v kn b_v ∈ lrel ∧ ra_add mi ⟨ kc_s , scons i_v ∅ ⟩ b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ b_v np Y1 ∈ lrel ∧ ra_pargs Y1 r_v d_v Y2 ∈ lrel ∧ ra_pis Ihs ⟨ kc_app , scons X (scons Y2 ∅) ⟩ Min ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x ∊ cl_mwalk_res ⇒ x ∊ cl_mwalk_res $ by ax
l2: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x ∊ cl_mwalk_res ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p ∃ q ∃ r ∃ t ∃ x0 ∃ x1 (x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩ ⇒ x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩ ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩ ⇒ x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩ ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩ ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ h0 ∃ h1 ∃ h_v ∃ ni ∃ mi ∃ a_v ∃ b_v ∃ Ihs ∃ K ∃ K2 ∃ K3 ∃ Y ∃ X ∃ Y1 ∃ Y2 ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = d_v ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = K ∧ t12 = Min ∧ ra_add d_v np dp ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_add dp i_v h0 ∈ lrel ∧ ra_add h0 kn h1 ∈ lrel ∧ ra_add h1 r_v h_v ∈ lrel ∧ ra_lift kn d_v K K2 ∈ lrel ∧ ra_lift r_v ⟨ kc_nz , ∅ ⟩ K2 K3 ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mi ∅ ⟩ ni K3 X ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons h_v ∅ ⟩ Y np ∈ lrel ∧ ra_add r_v d_v a_v ∈ lrel ∧ ra_add a_v kn b_v ∈ lrel ∧ ra_add mi ⟨ kc_s , scons i_v ∅ ⟩ b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ b_v np Y1 ∈ lrel ∧ ra_pargs Y1 r_v d_v Y2 ∈ lrel ∧ ra_pis Ihs ⟨ kc_app , scons X (scons Y2 ∅) ⟩ Min ∈ lrel) $ by y1_e_mwalk_res [l6, l7]
l9: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , ∃ x1 (x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩) ⇒ ∃ x1 (x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩) $ by ax
