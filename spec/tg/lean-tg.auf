l43: $ GG , ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l42, l41]
l44: $ GG , ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
l45: $ GG , ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l44, l43]
l46: $ GG , ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
l47: $ GG , ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l46, l45]
l48: $ GG , ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
l49: $ GG , ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l48, l47]
l50: $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by or_elim [l1, l26, l49]

lemma y2_ind_data_d2 (GG: hyps) (o q1 q2 q3 q4 w2 w3 w4: set):
  $ GG ⇒ ⟨ o , ra_ind_data q1 q2 q3 q4 ⟩ ∈ cl_ind_data_n $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_data lrel $ > $ GG ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d $ by ax
l2: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by y2_ind_data_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l4]
l6: $ GG ⇒ ∀ d ∀ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l5]
l7: $ GG ⇒ ∀ b ∀ d ∀ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l6]
l8: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l7]
l9: $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by y2_ind_data_i2 [#1, #2, l8]

lemma y2_ind_data_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ind_data lrel → c ∊ y2_P_ind_data lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ c = ra_ind_data x1 x2 x3 x4 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ pr_ind_data $ by lprog_ind_data_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_data lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ ra_ind_data x1 x6 x7 x8 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel , ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_i ⇒ ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_i $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel , ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_i ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_data lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel , ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_i ⇒ ra_ind_data x1 x6 x7 x8 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel , ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_i ⇒ x2 = x6 ∧ x3 = x7 ∧ x4 = x8 $ by y2_ind_data_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel , ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_n ⇒ ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_n $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel , ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_n ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_data lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel , ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_n ⇒ ra_ind_data x1 x6 x7 x8 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel , ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_n ⇒ x2 = x6 ∧ x3 = x7 ∧ x4 = x8 $ by y2_ind_data_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_n → x2 = x6 ∧ x3 = x7 ∧ x4 = x8 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , ra_ind_data x1 x2 x3 x4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n → x2 = x6 ∧ x3 = x7 ∧ x4 = x8 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 , ra_ind_data x1 x6 x7 x8 ∈ lrel ⇒ x2 = x6 ∧ x3 = x7 ∧ x4 = x8 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 ⇒ ra_ind_data x1 x6 x7 x8 ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 ⇒ ∀ x8 (⟨ kr_ind_data , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_data lrel , c = ra_ind_data x1 x2 x3 x4 ⇒ ∀ x7 ∀ x8 (⟨ kr_ind_data , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8) $ by all_intro [l21]
