lemma y1_sb_eta_ok {x: set} (t: set x) (A1 A2: class x):
  $ (⟦ x / t ⟧ (ra_eta_ok A1 A2)) ≐ ra_eta_ok (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_eta_ok , scons A1 (scons A2 ∅) ⟩) ≐ ⟨ kr_eta_ok , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) ∅) ⟩ $ by ceqt_refl

