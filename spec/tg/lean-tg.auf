l51: $ G ⇒ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons V5 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ b2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons V5 (scons b2 ∅) ⟩ ∧ ra_rst V1 V2 V3 V5 ∈ lrel ∧ ra_rst V1 V2 V4 b2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst V1 V2 V3 A2 ∈ lrel ∧ ra_rst V1 V2 V4 b2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ b_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons V3 (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst V1 V2 V3 A2 ∈ lrel ∧ ra_rst V1 V2 b_v b2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst V1 V2 A A2 ∈ lrel ∧ ra_rst V1 V2 b_v b2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = V1 ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst V1 N A A2 ∈ lrel ∧ ra_rst V1 N b_v b2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_rst_pi (G: hyps) {D N A b_v A2 b2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_pi ⇒ x ∊ cl_rst_pi $ by ax
l2: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩ ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by y1_e_rst_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u w) (scons (ra_rst y z v a) ∅) , ra_rst y z ⟨ kc_pi , scons u (scons v ∅) ⟩ ⟨ kc_pi , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_pi ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_rst_proj (G: hyps) {D N b_v i_v e_v e2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst V1 V2 V5 V6) ∅ , ra_rst V1 V2 ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_rst V1 V2 V5 V6) ∅ , ra_rst V1 V2 ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ⟩ = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_rst V1 V2 V5 V6) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_rst V1 V2 ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_rst V1 V2 V5 V6) ∅ ∧ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_rst V1 V2 V5 V6) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_rst ∈ ω $ by x1_kr_rst
l27: $ G ⇒ isset kr_rst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_rst = kr_rst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ∧ scons t4 ∅ = scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_rst V1 V2 V5 V6) ∅) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_rst V1 V2 V5 V6) ∅) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_rst V1 V2 V5 V6) $ by opair_isset
l46: $ G ⇒ ra_rst V1 V2 V5 V6 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ t4 = ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∧ ra_rst V1 V2 V5 V6 ∈ lrel $ by and_intro [l42, l46]
l48: $ G ⇒ t3 = ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∧ ra_rst V1 V2 V5 V6 ∈ lrel $ by and_intro [l39, l47]
l49: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∧ ra_rst V1 V2 V5 V6 ∈ lrel $ by and_intro [l36, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons V3 (scons V4 (scons V6 ∅)) ⟩ ∧ ra_rst V1 V2 V5 V6 ∈ lrel $ by and_intro [l33, l49]
l51: $ G ⇒ ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_proj , scons V3 (scons V4 (scons V5 ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons V3 (scons V4 (scons e2 ∅)) ⟩ ∧ ra_rst V1 V2 V5 e2 ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_proj , scons V3 (scons V4 (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons V3 (scons V4 (scons e2 ∅)) ⟩ ∧ ra_rst V1 V2 e_v e2 ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ i_v ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_proj , scons V3 (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons V3 (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst V1 V2 e_v e2 ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst V1 V2 e_v e2 ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst V1 N e_v e2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by ex_intro [l55]

lemma y1_d_rst_proj (G: hyps) {D N b_v i_v e_v e2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_proj ⇒ x ∊ cl_rst_proj $ by ax
l2: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_proj ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by y1_e_rst_proj [l6, l7]
l9: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_proj ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_rst_refl (G: hyps) {D N e_v: set} (pp t1 t2 t3 t4 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_rst V1 V2 V3 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_rst V1 V2 V3 V3 ⟩ = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_rst V1 V2 V3 V3) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 V3 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 V3 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V3 $ by isset_var
l19: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons V3 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset V2 $ by isset_var
l22: $ G ⇒ scons V2 (scons V3 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V3 ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_rst ∈ ω $ by x1_kr_rst
l26: $ G ⇒ isset kr_rst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V3 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_rst = kr_rst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V3 (scons V3 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V3 (scons V3 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V3 (scons V3 ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V3 (scons V3 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons V3 (scons V3 ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V3 (scons V3 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V3 ∧ scons t4 ∅ = scons V3 ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = V3 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V3 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V3 $ by and_elim_l [l40]
l42: $ G ⇒ t3 = V3 ∧ t4 = V3 $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V3 $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V3 $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ e_v (t1 = V1 ∧ t2 = V2 ∧ t3 = e_v ∧ t4 = e_v) $ by ex_intro [l44]
l46: $ G ⇒ ∃ N ∃ e_v (t1 = V1 ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by ex_intro [l45]
l47: $ G ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by ex_intro [l46]

lemma y1_d_rst_refl (G: hyps) {D N e_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $
----
l1: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_refl ⇒ x ∊ cl_rst_refl $ by ax
l2: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_refl ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ x = ⟨ ∅ , ra_rst y z u u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_rst y z u u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by y1_e_rst_refl [l6, l7]
l9: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_refl ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by wcel_elim [#1, l13]

lemma y1_o_rst (G: hyps) {D e_v N j_v np n_v m_v na k_v S X X1 X2 e2 I c_v i_v npi Y f_v a_v f2 a2 A b_v A2 b2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ pr_rst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) ∨ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_rehead S X2 k_v e_v e2 ∈ lrel) ∨ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) ∨ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $
----
l1: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl $ by ax
l2: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by y1_d_rst_refl [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl → ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl $ by ax
l6: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∨ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj $ by ax
l8: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) $ by y1_d_rst_proj [l7, l8]
l10: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ⇒ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl $ by ax
l12: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl → ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_proj ∪ cl_rst_refl , ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_refl ⇒ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by imp_elim [l12, l11]
