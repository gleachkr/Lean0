l3: $ G , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ kr_isort ∈ ω $ by x1_kr_isort
l5: $ G , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ x ∊ y1_lab kr_isort (suc kr_isort) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ x ∊ y1_lab kr_isort (suc kr_isort) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ x ∊ y1_lab kr_isort (suc kr_isort) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ x ∊ y1_lab kr_isort (suc kr_isort) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_isort_pi ⇒ x ∊ y1_lab kr_isort (suc kr_isort) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_isort_pi ⊆ y1_lab kr_isort (suc kr_isort) $ by subset_intro [l12]

lemma y1_p_isort (G: hyps): $ G ⇒ pr_isort ⊆ y1_lab kr_isort (suc kr_isort) $
----
l1: $ G ⇒ cl_isort_pi ⊆ y1_lab kr_isort (suc kr_isort) $ by y1_k_isort_pi
