l9: $ G , ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rtail (suc kr_rtail) $ by ex_elim [l8, l7]
l10: $ G , ∃ i ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) ⇒ ∃ i ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ i ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rtail (suc kr_rtail) $ by ex_elim [l10, l9]
