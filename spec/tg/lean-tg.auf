l11: $ G ⇒ isset (scons B1 (scons B2 (scons B3 (scons B4 ∅)))) $ by y2_fs_set [l9]
l12: $ G ⇒ K = K ∧ scons A1 (scons A2 (scons A3 (scons A4 ∅))) = scons B1 (scons B2 (scons B3 (scons B4 ∅))) $ by opair_inj_c [#1, #2, l10, #2, l11]
l13: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 ∅))) = scons B1 (scons B2 (scons B3 (scons B4 ∅))) $ by and_elim_r [l12]
l14: $ G ⇒ A1 = B1 ∧ scons A2 (scons A3 (scons A4 ∅)) = scons B2 (scons B3 (scons B4 ∅)) $ by y2_sc_inj [#3, #7, l6, l7, l13]
l15: $ G ⇒ A1 = B1 $ by and_elim_l [l14]
l16: $ G ⇒ scons A2 (scons A3 (scons A4 ∅)) = scons B2 (scons B3 (scons B4 ∅)) $ by and_elim_r [l14]
l17: $ G ⇒ A2 = B2 ∧ scons A3 (scons A4 ∅) = scons B3 (scons B4 ∅) $ by y2_sc_inj [#4, #8, l4, l5, l16]
l18: $ G ⇒ A2 = B2 $ by and_elim_l [l17]
l19: $ G ⇒ scons A3 (scons A4 ∅) = scons B3 (scons B4 ∅) $ by and_elim_r [l17]
l20: $ G ⇒ A3 = B3 ∧ scons A4 ∅ = scons B4 ∅ $ by y2_sc_inj [#5, #9, l2, l3, l19]
l21: $ G ⇒ A3 = B3 $ by and_elim_l [l20]
l22: $ G ⇒ scons A4 ∅ = scons B4 ∅ $ by and_elim_r [l20]
l23: $ G ⇒ A4 = B4 ∧ ∅ = ∅ $ by y2_sc_inj [#6, #10, l1, l1, l22]
l24: $ G ⇒ A4 = B4 $ by and_elim_l [l23]
l25: $ G ⇒ A3 = B3 ∧ A4 = B4 $ by and_intro [l21, l24]
l26: $ G ⇒ A2 = B2 ∧ A3 = B3 ∧ A4 = B4 $ by and_intro [l18, l25]
l27: $ G ⇒ A1 = B1 ∧ A2 = B2 ∧ A3 = B3 ∧ A4 = B4 $ by and_intro [l15, l26]

--| Injectivity of a node (or an atom) with 5 children.
lemma y2_nd5 (G: hyps) (K A1 A2 A3 A4 A5 B1 B2 B3 B4 B5: class):
  $ G ⇒ ⟨ K , scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) ⟩ = ⟨ K , scons B1 (scons B2 (scons B3 (scons B4 (scons B5 ∅)))) ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset A1 $ > $ G ⇒ isset A2 $ > $ G ⇒ isset A3 $ > $ G ⇒ isset A4 $ > $ G ⇒ isset A5 $ > $ G ⇒ isset B1 $ > $ G ⇒ isset B2 $ > $ G ⇒ isset B3 $ > $ G ⇒ isset B4 $ > $ G ⇒ isset B5 $ > $ G ⇒ A1 = B1 ∧ A2 = B2 ∧ A3 = B3 ∧ A4 = B4 ∧ A5 = B5 $
