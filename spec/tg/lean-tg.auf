lemma y1_k_rst_proj (G: hyps): $ G ⇒ cl_rst_proj ⊆ y1_lab kr_rst (suc kr_rst) $
----
l1: $ G , x ∊ cl_rst_proj ⇒ x ∊ cl_rst_proj $ by ax
l2: $ G , x ∊ cl_rst_proj ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ kr_rst ∈ ω $ by x1_kr_rst
l5: $ G , x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩ ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z w a) ∅ , ra_rst y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l14, l13]
