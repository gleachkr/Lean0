l13: $ G , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_nil ∪ cl_minors_cons , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_cons ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_nil ∪ cl_minors_cons , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_cons ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_nil ∪ cl_minors_cons ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_nil ∪ cl_minors_cons → ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_rtail_pi (G: hyps) {D np n_v m_v i_v d_v A B B2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 V1 V2 V3 V4 V5 V6 V7 V8 V9: set):
  $ G ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_rtail V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ V8 V9) ∅ , ra_rtail V1 V2 V3 V4 V5 V6 ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_rtail V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ V8 V9) ∅ , ra_rtail V1 V2 V3 V4 V5 V6 ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ⟩ = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_rtail V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ V8 V9) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
