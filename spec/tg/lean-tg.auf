l5: $ G , x = ⟨ scons (ra_spine ⟨ kc_bvar , scons b ∅ ⟩ i f) (scons (ra_add v u a) (scons (ra_add a w b) (scons (ra_le ⟨ kc_s , scons w ∅ ⟩ z) (scons (ra_pargs ⟨ kc_bvar , scons b ∅ ⟩ v u g) (scons (ra_nidx y w c) (scons (ra_iargs a c g i) ∅)))))) , ra_indapp y z u v i w ⟩ ⇒ x ∊ y1_lab kr_indapp (suc kr_indapp) $ by y1_lab_self [l3, l4]
