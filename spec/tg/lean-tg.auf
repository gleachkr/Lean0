lemma y1_f73 (G: hyps): $ G ⇒ kr_nonrec ⊆ kr_eta_eq $
----
l1: $ G ⇒ kr_nonrec ⊆ kr_psplit $ by y1_f74
l2: $ G ⇒ kr_psplit ⊆ kr_iota_tel $ by suc_subset
l3: $ G ⇒ kr_iota_tel ⊆ kr_eta_eq $ by y1_f78
l4: $ G ⇒ kr_nonrec ⊆ kr_iota_tel $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_nonrec ⊆ kr_eta_eq $ by subset_trans [l4, l3]

lemma y1_f63 (G: hyps): $ G ⇒ kr_minors ⊆ kr_eta_eq $
----
l1: $ G ⇒ kr_minors ⊆ kr_qinst $ by y1_f64
l2: $ G ⇒ kr_qinst ⊆ kr_nonrec $ by suc_subset
l3: $ G ⇒ kr_nonrec ⊆ kr_eta_eq $ by y1_f73
l4: $ G ⇒ kr_minors ⊆ kr_nonrec $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_minors ⊆ kr_eta_eq $ by subset_trans [l4, l3]

lemma y1_f42 (G: hyps): $ G ⇒ kr_spine ⊆ kr_eta_eq $
----
l1: $ G ⇒ kr_spine ⊆ kr_cminors $ by y1_f43
l2: $ G ⇒ kr_cminors ⊆ kr_minors $ by suc_subset
l3: $ G ⇒ kr_minors ⊆ kr_eta_eq $ by y1_f63
l4: $ G ⇒ kr_spine ⊆ kr_minors $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_spine ⊆ kr_eta_eq $ by subset_trans [l4, l3]

lemma y1_f0 (G: hyps): $ G ⇒ kr_le ⊆ kr_eta_eq $
----
l1: $ G ⇒ kr_le ⊆ kr_pargs $ by y1_f1
l2: $ G ⇒ kr_pargs ⊆ kr_spine $ by suc_subset
l3: $ G ⇒ kr_spine ⊆ kr_eta_eq $ by y1_f42
l4: $ G ⇒ kr_le ⊆ kr_spine $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_le ⊆ kr_eta_eq $ by subset_trans [l4, l3]

-- Each clause is in its relation's label range, hence so is each relation.

lemma y1_k_le_z (G: hyps): $ G ⇒ cl_le_z ⊆ y1_lab kr_le (suc kr_le) $
----
l1: $ G , x ∊ cl_le_z ⇒ x ∊ cl_le_z $ by ax
l2: $ G , x ∊ cl_le_z ⇒ ∃ y (x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ kr_le ∈ ω $ by x1_kr_le
l5: $ G , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x ∊ y1_lab kr_le (suc kr_le) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_le_z ⇒ x ∊ y1_lab kr_le (suc kr_le) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_le_z ⊆ y1_lab kr_le (suc kr_le) $ by subset_intro [l6]

lemma y1_k_le_s (G: hyps): $ G ⇒ cl_le_s ⊆ y1_lab kr_le (suc kr_le) $
----
l1: $ G , x ∊ cl_le_s ⇒ x ∊ cl_le_s $ by ax
l2: $ G , x ∊ cl_le_s ⇒ ∃ y ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ kr_le ∈ ω $ by x1_kr_le
l5: $ G , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_le (suc kr_le) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_le (suc kr_le) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_le_s ⇒ x ∊ y1_lab kr_le (suc kr_le) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_le_s ⊆ y1_lab kr_le (suc kr_le) $ by subset_intro [l8]

lemma y1_p_le (G: hyps): $ G ⇒ pr_le ⊆ y1_lab kr_le (suc kr_le) $
----
l1: $ G ⇒ cl_le_s ⊆ y1_lab kr_le (suc kr_le) $ by y1_k_le_s
l2: $ G ⇒ cl_le_z ⊆ y1_lab kr_le (suc kr_le) $ by y1_k_le_z
l3: $ G ⇒ pr_le ⊆ y1_lab kr_le (suc kr_le) $ by cun_least [l2, l1]

lemma y1_k_add_z (G: hyps): $ G ⇒ cl_add_z ⊆ y1_lab kr_add (suc kr_add) $
----
l1: $ G , x ∊ cl_add_z ⇒ x ∊ cl_add_z $ by ax
l2: $ G , x ∊ cl_add_z ⇒ ∃ y (x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ kr_add ∈ ω $ by x1_kr_add
l5: $ G , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x ∊ y1_lab kr_add (suc kr_add) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_add_z ⇒ x ∊ y1_lab kr_add (suc kr_add) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_add_z ⊆ y1_lab kr_add (suc kr_add) $ by subset_intro [l6]

lemma y1_k_add_s (G: hyps): $ G ⇒ cl_add_s ⊆ y1_lab kr_add (suc kr_add) $
----
l1: $ G , x ∊ cl_add_s ⇒ x ∊ cl_add_s $ by ax
l2: $ G , x ∊ cl_add_s ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ kr_add ∈ ω $ by x1_kr_add
l5: $ G , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_add (suc kr_add) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_add (suc kr_add) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_add (suc kr_add) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_add_s ⇒ x ∊ y1_lab kr_add (suc kr_add) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_add_s ⊆ y1_lab kr_add (suc kr_add) $ by subset_intro [l10]

lemma y1_p_add (G: hyps): $ G ⇒ pr_add ⊆ y1_lab kr_add (suc kr_add) $
----
l1: $ G ⇒ cl_add_s ⊆ y1_lab kr_add (suc kr_add) $ by y1_k_add_s
l2: $ G ⇒ cl_add_z ⊆ y1_lab kr_add (suc kr_add) $ by y1_k_add_z
l3: $ G ⇒ pr_add ⊆ y1_lab kr_add (suc kr_add) $ by cun_least [l2, l1]

lemma y1_k_lnth_z (G: hyps): $ G ⇒ cl_lnth_z ⊆ y1_lab kr_lnth (suc kr_lnth) $
----
l1: $ G , x ∊ cl_lnth_z ⇒ x ∊ cl_lnth_z $ by ax
l2: $ G , x ∊ cl_lnth_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ kr_lnth ∈ ω $ by x1_kr_lnth
l5: $ G , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x ∊ y1_lab kr_lnth (suc kr_lnth) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ x ∊ y1_lab kr_lnth (suc kr_lnth) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_lnth_z ⇒ x ∊ y1_lab kr_lnth (suc kr_lnth) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_lnth_z ⊆ y1_lab kr_lnth (suc kr_lnth) $ by subset_intro [l8]

lemma y1_k_lnth_s (G: hyps): $ G ⇒ cl_lnth_s ⊆ y1_lab kr_lnth (suc kr_lnth) $
----
l1: $ G , x ∊ cl_lnth_s ⇒ x ∊ cl_lnth_s $ by ax
l2: $ G , x ∊ cl_lnth_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ kr_lnth ∈ ω $ by x1_kr_lnth
l5: $ G , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ x ∊ y1_lab kr_lnth (suc kr_lnth) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ x ∊ y1_lab kr_lnth (suc kr_lnth) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ x ∊ y1_lab kr_lnth (suc kr_lnth) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ x ∊ y1_lab kr_lnth (suc kr_lnth) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_lnth_s ⇒ x ∊ y1_lab kr_lnth (suc kr_lnth) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_lnth_s ⊆ y1_lab kr_lnth (suc kr_lnth) $ by subset_intro [l12]

lemma y1_p_lnth (G: hyps): $ G ⇒ pr_lnth ⊆ y1_lab kr_lnth (suc kr_lnth) $
----
l1: $ G ⇒ cl_lnth_s ⊆ y1_lab kr_lnth (suc kr_lnth) $ by y1_k_lnth_s
l2: $ G ⇒ cl_lnth_z ⊆ y1_lab kr_lnth (suc kr_lnth) $ by y1_k_lnth_z
l3: $ G ⇒ pr_lnth ⊆ y1_lab kr_lnth (suc kr_lnth) $ by cun_least [l2, l1]

lemma y1_k_linst_z (G: hyps): $ G ⇒ cl_linst_z ⊆ y1_lab kr_linst (suc kr_linst) $
----
l1: $ G , x ∊ cl_linst_z ⇒ x ∊ cl_linst_z $ by ax
l2: $ G , x ∊ cl_linst_z ⇒ ∃ y (x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ kr_linst ∈ ω $ by x1_kr_linst
l5: $ G , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_linst_z ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_linst_z ⊆ y1_lab kr_linst (suc kr_linst) $ by subset_intro [l6]

lemma y1_k_linst_s (G: hyps): $ G ⇒ cl_linst_s ⊆ y1_lab kr_linst (suc kr_linst) $
----
l1: $ G , x ∊ cl_linst_s ⇒ x ∊ cl_linst_s $ by ax
l2: $ G , x ∊ cl_linst_s ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ kr_linst ∈ ω $ by x1_kr_linst
l5: $ G , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_linst_s ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_linst_s ⊆ y1_lab kr_linst (suc kr_linst) $ by subset_intro [l10]

lemma y1_k_linst_max (G: hyps): $ G ⇒ cl_linst_max ⊆ y1_lab kr_linst (suc kr_linst) $
----
l1: $ G , x ∊ cl_linst_max ⇒ x ∊ cl_linst_max $ by ax
l2: $ G , x ∊ cl_linst_max ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ kr_linst ∈ ω $ by x1_kr_linst
l5: $ G , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l6, l5]
l8: $ G , ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l8, l7]
l10: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l10, l9]
l12: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l12, l11]
l14: $ G , x ∊ cl_linst_max ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l2, l13]
l15: $ G ⇒ cl_linst_max ⊆ y1_lab kr_linst (suc kr_linst) $ by subset_intro [l14]

lemma y1_k_linst_imax (G: hyps): $ G ⇒ cl_linst_imax ⊆ y1_lab kr_linst (suc kr_linst) $
----
l1: $ G , x ∊ cl_linst_imax ⇒ x ∊ cl_linst_imax $ by ax
l2: $ G , x ∊ cl_linst_imax ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ kr_linst ∈ ω $ by x1_kr_linst
l5: $ G , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l6, l5]
l8: $ G , ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l8, l7]
l10: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l10, l9]
l12: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l12, l11]
l14: $ G , x ∊ cl_linst_imax ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l2, l13]
l15: $ G ⇒ cl_linst_imax ⊆ y1_lab kr_linst (suc kr_linst) $ by subset_intro [l14]

lemma y1_k_linst_param (G: hyps): $ G ⇒ cl_linst_param ⊆ y1_lab kr_linst (suc kr_linst) $
----
l1: $ G , x ∊ cl_linst_param ⇒ x ∊ cl_linst_param $ by ax
l2: $ G , x ∊ cl_linst_param ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ kr_linst ∈ ω $ by x1_kr_linst
l5: $ G , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) ⇒ ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_linst_param ⇒ x ∊ y1_lab kr_linst (suc kr_linst) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_linst_param ⊆ y1_lab kr_linst (suc kr_linst) $ by subset_intro [l10]

lemma y1_p_linst (G: hyps): $ G ⇒ pr_linst ⊆ y1_lab kr_linst (suc kr_linst) $
----
l1: $ G ⇒ cl_linst_param ⊆ y1_lab kr_linst (suc kr_linst) $ by y1_k_linst_param
l2: $ G ⇒ cl_linst_imax ⊆ y1_lab kr_linst (suc kr_linst) $ by y1_k_linst_imax
l3: $ G ⇒ cl_linst_imax ∪ cl_linst_param ⊆ y1_lab kr_linst (suc kr_linst) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_linst_max ⊆ y1_lab kr_linst (suc kr_linst) $ by y1_k_linst_max
l5: $ G ⇒ cl_linst_max ∪ (cl_linst_imax ∪ cl_linst_param) ⊆ y1_lab kr_linst (suc kr_linst) $ by cun_least [l4, l3]
l6: $ G ⇒ cl_linst_s ⊆ y1_lab kr_linst (suc kr_linst) $ by y1_k_linst_s
l7: $ G ⇒ cl_linst_s ∪ (cl_linst_max ∪ (cl_linst_imax ∪ cl_linst_param)) ⊆ y1_lab kr_linst (suc kr_linst) $ by cun_least [l6, l5]
l8: $ G ⇒ cl_linst_z ⊆ y1_lab kr_linst (suc kr_linst) $ by y1_k_linst_z
l9: $ G ⇒ pr_linst ⊆ y1_lab kr_linst (suc kr_linst) $ by cun_least [l8, l7]

lemma y1_k_lsubst_z (G: hyps): $ G ⇒ cl_lsubst_z ⊆ y1_lab kr_lsubst (suc kr_lsubst) $
----
l1: $ G , x ∊ cl_lsubst_z ⇒ x ∊ cl_lsubst_z $ by ax
l2: $ G , x ∊ cl_lsubst_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l5: $ G , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_lsubst_z ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_lsubst_z ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by subset_intro [l8]

lemma y1_k_lsubst_s (G: hyps): $ G ⇒ cl_lsubst_s ⊆ y1_lab kr_lsubst (suc kr_lsubst) $
----
l1: $ G , x ∊ cl_lsubst_s ⇒ x ∊ cl_lsubst_s $ by ax
l2: $ G , x ∊ cl_lsubst_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l5: $ G , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_lsubst_s ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_lsubst_s ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by subset_intro [l12]

lemma y1_k_lsubst_max (G: hyps): $ G ⇒ cl_lsubst_max ⊆ y1_lab kr_lsubst (suc kr_lsubst) $
----
l1: $ G , x ∊ cl_lsubst_max ⇒ x ∊ cl_lsubst_max $ by ax
l2: $ G , x ∊ cl_lsubst_max ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
