l37: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V3 (scons V3 ∅))) $ by and_elim_r [l35]
l38: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V3 (scons V3 ∅)) $ by y1_scons_inj [l37, l16, l25, l15, l24]
l39: $ G ⇒ t2 = V2 $ by and_elim_l [l38]
l40: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V3 (scons V3 ∅)) $ by and_elim_r [l38]
l41: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ scons t4 (scons t5 ∅) = scons V3 (scons V3 ∅) $ by y1_scons_inj [l40, l14, l23, l13, l22]
l42: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ scons t4 (scons t5 ∅) = scons V3 (scons V3 ∅) $ by and_elim_r [l41]
