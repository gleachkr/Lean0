l6: $ G ⇒ pp = scons (ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5) ∅ ∧ ra_recfield t1 t2 t3 t4 t5 t6 = ra_recfield V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_recfield t1 t2 t3 t4 t5 t6 = ra_recfield V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
