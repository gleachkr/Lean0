l36: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w4 = d $ by and_elim_r [l34]
l37: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ kc_ind_mk ∈ kc_ind_mkn $ by y2_lt_ind_mk_ind_mkn
l38: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ kc_ind_mkn ∈ ω $ by v1_kc_ind_mkn
