lemma y2_ndecl_d2 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_ndecl q1 q2 q3 ⟩ ∈ cl_ndecl_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel $ > $ GG ⇒ ra_ndecl q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel $ by ax
l2: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel ⇒ ra_ndecl q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel ⇒ q3 = w3 $ by y2_ndecl_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel → q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ ∀ b ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel → q3 = w3) $ by all_intro [l6]
l8: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_ndecl b d e ∈ lrel ∧ ra_ndecl b d e ∈ y2_P_ndecl lrel → q3 = w3) $ by all_intro [l7]
l9: $ GG ⇒ q3 = w3 $ by y2_ndecl_i2 [#1, #2, l8]

lemma y2_ndecl_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ndecl lrel → c ∊ y2_P_ndecl lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ c = ra_ndecl x1 x2 x3 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_ndecl x1 x2 x3 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ pr_ndecl $ by lprog_ndecl_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ ra_ndecl x1 x2 x6 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel , ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_nil ⇒ ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_nil $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel , ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_nil ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel , ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_nil ⇒ ra_ndecl x1 x2 x6 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel , ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_nil ⇒ x3 = x6 $ by y2_ndecl_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel , ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_cons ⇒ ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_cons $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel , ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_cons ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel , ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_cons ⇒ ra_ndecl x1 x2 x6 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel , ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_cons ⇒ x3 = x6 $ by y2_ndecl_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_cons → x3 = x6 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_ndecl x1 x2 x3 ⟩ ∈ cl_ndecl_nil ∪ cl_ndecl_cons → x3 = x6 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 , ra_ndecl x1 x2 x6 ∈ lrel ⇒ x3 = x6 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 ⇒ ra_ndecl x1 x2 x6 ∈ lrel → x3 = x6 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel , c = ra_ndecl x1 x2 x3 ⇒ ∀ x6 (⟨ kr_ndecl , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel ⇒ c = ⟨ kr_ndecl , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by imp_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel ⇒ ∀ x3 (c = ⟨ kr_ndecl , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_ndecl , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_ndecl , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ndecl lrel ⇒ c ∊ y2_P_ndecl lrel $ by cab_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel → c ∊ y2_P_ndecl lrel $ by imp_intro [l26]
l28: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ndecl lrel → c ∊ y2_P_ndecl lrel $ by imp_intro [l27]
l29: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ndecl lrel → c ∊ y2_P_ndecl lrel) $ by all_intro [l28]
l30: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ndecl lrel → c ∊ y2_P_ndecl lrel) $ by all_intro [l29]

lemma y2_ndecl_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_ndecl lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ndecl lrel → c ∊ y2_P_ndecl lrel) $ by y2_ndecl_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_ndecl lrel $ by horn_ind [l1, l2]

lrel_ndecl_det
--------------
l1: $ G ⇒ horn lprog ⊆ y2_P_ndecl lrel $ by y2_ndecl_in
l2: $ G ⇒ ra_ndecl t1 t2 u3 ∈ y2_P_ndecl lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u3 = v3 $ by y2_ndecl_ih [l2, #2]

--| The atoms of `nth_ty` whose variants in `L` with the same inputs have the same outputs.
def y2_P_nth_ty (L: class) (.c .x1 .x2 .x3 .x4 .x6 .x7: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_nth_ty , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_nth_ty , scons x1 (scons x2 (scons x6 (scons x7 ∅))) ⟩ ∈ L → x3 = x6 ∧ x4 = x7))} $

lemma y2_nth_ty_ih (GG: hyps) (q1 q2 q3 q4 w3 w4: set):
  $ GG ⇒ ra_nth_ty q1 q2 q3 q4 ∈ y2_P_nth_ty lrel $ > $ GG ⇒ ra_nth_ty q1 q2 w3 w4 ∈ lrel $ > $ GG ⇒ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG , c = ra_nth_ty q1 q2 q3 q4 , c ∊ y2_P_nth_ty lrel ⇒ c ∊ y2_P_nth_ty lrel $ by ax
l2: $ GG , c = ra_nth_ty q1 q2 q3 q4 , c ∊ y2_P_nth_ty lrel ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_nth_ty , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_nth_ty , scons x1 (scons x2 (scons x6 (scons x7 ∅))) ⟩ ∈ lrel → x3 = x6 ∧ x4 = x7)) $ by cab_elim [l1]
l3: $ GG , c = ra_nth_ty q1 q2 q3 q4 , c ∊ y2_P_nth_ty lrel ⇒ ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_nth_ty , scons q1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_nth_ty , scons q1 (scons x2 (scons x6 (scons x7 ∅))) ⟩ ∈ lrel → x3 = x6 ∧ x4 = x7)) $ by all_elim [l2]
