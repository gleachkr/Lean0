l7: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z , w = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z , w = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A ⟩ ⇒ isset (ra_cnth q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z , w = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z , w = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A ⟩ ⇒ isset (ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z , w = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A ⟩ ⇒ o = ∅ ∧ ra_cnth q1 q2 q3 = ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z , w = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
