l18: $ G , x ∊ cl_spz_lam ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l2, l17]
l19: $ G ⇒ cl_spz_lam ⊆ y1_lab kr_spz (suc kr_spz) $ by subset_intro [l18]

