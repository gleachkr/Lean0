l43: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩) $ by ax
l44: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩) ⇒ ∃ D ∃ I ∃ b_v ∃ bi_v ∃ P ∃ Pi ∃ N ∃ T ∃ Ti ∃ j_v ∃ i_v ∃ npi ∃ ni ∃ mi ∃ X ∃ F ∃ Fi ∃ C ∃ Ci (t1 = D ∧ t2 = I ∧ t3 = X ∧ t4 = j_v ∧ t5 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ty Ti i_v Fi Ci ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X Fi F ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_spz_ctors D N I X ni npi Ci C ∈ lrel) $ by ex_elim [l43, l42]
l45: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , x ∊ cl_aux_data_i ⇒ ∃ D ∃ I ∃ b_v ∃ bi_v ∃ P ∃ Pi ∃ N ∃ T ∃ Ti ∃ j_v ∃ i_v ∃ npi ∃ ni ∃ mi ∃ X ∃ F ∃ Fi ∃ C ∃ Ci (t1 = D ∧ t2 = I ∧ t3 = X ∧ t4 = j_v ∧ t5 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ty Ti i_v Fi Ci ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X Fi F ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_spz_ctors D N I X ni npi Ci C ∈ lrel) $ by ex_elim [l2, l44]
l46: $ G ⇒ ∃ D ∃ I ∃ b_v ∃ bi_v ∃ P ∃ Pi ∃ N ∃ T ∃ Ti ∃ j_v ∃ i_v ∃ npi ∃ ni ∃ mi ∃ X ∃ F ∃ Fi ∃ C ∃ Ci (t1 = D ∧ t2 = I ∧ t3 = X ∧ t4 = j_v ∧ t5 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ty Ti i_v Fi Ci ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X Fi F ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_spz_ctors D N I X ni npi Ci C ∈ lrel) $ by wcel_elim [#1, l45]

lemma y1_o_aux_data (G: hyps) {D I b_v bi_v P Pi N T Ti j_v i_v npi ni mi X F Fi C Ci: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ ∈ pr_aux_data $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ I ∃ b_v ∃ bi_v ∃ P ∃ Pi ∃ N ∃ T ∃ Ti ∃ j_v ∃ i_v ∃ npi ∃ ni ∃ mi ∃ X ∃ F ∃ Fi ∃ C ∃ Ci (t1 = D ∧ t2 = I ∧ t3 = X ∧ t4 = j_v ∧ t5 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ty Ti i_v Fi Ci ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X Fi F ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_spz_ctors D N I X ni npi Ci C ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ I ∃ b_v ∃ bi_v ∃ P ∃ Pi ∃ N ∃ T ∃ Ti ∃ j_v ∃ i_v ∃ npi ∃ ni ∃ mi ∃ X ∃ F ∃ Fi ∃ C ∃ Ci (t1 = D ∧ t2 = I ∧ t3 = X ∧ t4 = j_v ∧ t5 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ty Ti i_v Fi Ci ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X Fi F ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_spz_ctors D N I X ni npi Ci C ∈ lrel) $ by y1_d_aux_data_i [#1, #2]

lemma y1_e_mty_pi (G: hyps) {D np j_v d_v v_v A B M: set} (pp t1 t2 t3 t4 t5 t6 t7 V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8) ∅ , ra_mty V1 V2 V3 V4 V5 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8) ∅ , ra_mty V1 V2 V3 V4 V5 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ⟩ = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_mty t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l5: $ G ⇒ isset (ra_mty V1 V2 V3 V4 V5 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8) ∅ ∧ ra_mty t1 t2 t3 t4 t5 t6 t7 = ra_mty V1 V2 V3 V4 V5 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_mty t1 t2 t3 t4 t5 t6 t7 = ra_mty V1 V2 V3 V4 V5 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t7 $ by isset_var
