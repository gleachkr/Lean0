l40: $ G , x = ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons b ∅) ⟩ l f) (scons (ra_nidx y b c) (scons (ra_add z c f) (scons (ra_rehead d ⟨ kc_bvar , scons j ∅ ⟩ c l e) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons b ∅) ⟩ d z) (scons (ra_add a v g) (scons (ra_add g u i) (scons (ra_add j ⟨ kc_s , scons b ∅ ⟩ i) (scons (ra_add a w k) (scons (ra_pargs ⟨ kc_bvar , scons k ∅ ⟩ ⟨ kc_nz , ∅ ⟩ a h) ∅))))))))) , ra_ihty y z u v w a b l ⟨ kc_app , scons e (scons h ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by ex_elim [l39, l38]
l41: $ G , x = ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ , x ∊ cl_ihty_app ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by ex_elim [l2, l40]
l42: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by wcel_elim [#1, l41]

lemma y1_o_ihty (G: hyps) {D np n_v mo fld y_v j_v A B IH ni k_v a_v b_v mj f_v Y X U: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9: set):
  $ G ⇒ ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ pr_ihty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t9 = ⟨ kc_pi , scons A (scons IH ∅) ⟩ ∧ ra_ihty D np n_v mo fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ cl_ihty_app ⇒ ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ cl_ihty_app $ by ax
l2: $ G , ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ cl_ihty_app ⇒ crn pp ⊆ lrel $ by weaken [#2]
