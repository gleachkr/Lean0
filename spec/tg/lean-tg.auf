lemma y2_nidx_d1 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_nidx q1 q2 q3 ⟩ ∈ cl_nidx_i $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_nidx lrel $ > $ GG ⇒ ra_nidx q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel ⇒ q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel $ by ax
l2: $ GG , q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel ⇒ ra_nidx q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel ⇒ q3 = w3 $ by y2_nidx_c1 [l1, l2]
l4: $ GG ⇒ q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ i ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ ∀ h ∀ i ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l6]
l8: $ GG ⇒ ∀ g ∀ h ∀ i ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l7]
l9: $ GG ⇒ ∀ f ∀ g ∀ h ∀ i ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l8]
l10: $ GG ⇒ ∀ e ∀ f ∀ g ∀ h ∀ i ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l9]
l11: $ GG ⇒ ∀ d ∀ e ∀ f ∀ g ∀ h ∀ i ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l10]
l12: $ GG ⇒ ∀ b ∀ d ∀ e ∀ f ∀ g ∀ h ∀ i ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l11]
l13: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e ∀ f ∀ g ∀ h ∀ i ∀ j (q1 = a ∧ q2 = f ∧ q3 = g ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f h i ∈ lrel ∧ ra_isort h g j ∈ lrel → q3 = w3) $ by all_intro [l12]
l14: $ GG ⇒ q3 = w3 $ by y2_nidx_i1 [#1, #2, l13]

lemma y2_nidx_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_nidx lrel → c ∊ y2_P_nidx lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ c = ra_nidx x1 x2 x3 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_nidx x1 x2 x3 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_nidx x1 x2 x3 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_nidx x1 x2 x3 ⟩ ∈ pr_nidx $ by lprog_nidx_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_nidx lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ ra_nidx x1 x2 x6 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_nidx x1 x2 x3 ⟩ ∈ cl_nidx_i $ by lprog_nidx_pr [l5]
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 , ra_nidx x1 x2 x6 ∈ lrel ⇒ x3 = x6 $ by y2_nidx_d1 [l9, l7, l8]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 ⇒ ra_nidx x1 x2 x6 ∈ lrel → x3 = x6 $ by imp_intro [l10]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel , c = ra_nidx x1 x2 x3 ⇒ ∀ x6 (⟨ kr_nidx , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by all_intro [l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_nidx lrel ⇒ c = ⟨ kr_nidx , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nidx , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by imp_intro [l12]
