lemma y2_ind_data_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_ind_data lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ind_data lrel → c ∊ y2_P_ind_data lrel) $ by y2_ind_data_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_ind_data lrel $ by horn_ind [l1, l2]

lrel_ind_data_det
-----------------
l1: $ G ⇒ horn lprog ⊆ y2_P_ind_data lrel $ by y2_ind_data_in
l2: $ G ⇒ ra_ind_data t1 u2 u3 u4 ∈ y2_P_ind_data lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u2 = v2 ∧ u3 = v3 ∧ u4 = v4 $ by y2_ind_data_ih [l2, #2]

--| The atoms of `ind_nested` whose variants in `L` with the same inputs have the same outputs.
def y2_P_ind_nested (L: class) (.c .x1 .x2 .x6: set): class = $ {c | ∀ x1 ∀ x2 (c = ⟨ kr_ind_nested , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_ind_nested , scons x1 (scons x6 ∅) ⟩ ∈ L → x2 = x6))} $

lemma y2_ind_nested_ih (GG: hyps) (q1 q2 w2: set):
  $ GG ⇒ ra_ind_nested q1 q2 ∈ y2_P_ind_nested lrel $ > $ GG ⇒ ra_ind_nested q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ c ∊ y2_P_ind_nested lrel $ by ax
l2: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ ∀ x1 ∀ x2 (c = ⟨ kr_ind_nested , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_ind_nested , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ ∀ x2 (c = ⟨ kr_ind_nested , scons q1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_ind_nested , scons q1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ c = ⟨ kr_ind_nested , scons q1 (scons q2 ∅) ⟩ → ∀ x6 (⟨ kr_ind_nested , scons q1 (scons x6 ∅) ⟩ ∈ lrel → q2 = x6) $ by all_elim [l3]
l5: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ c = ra_ind_nested q1 q2 $ by ax
l6: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ ∀ x6 (⟨ kr_ind_nested , scons q1 (scons x6 ∅) ⟩ ∈ lrel → q2 = x6) $ by imp_elim [l4, l5]
l7: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ ra_ind_nested q1 w2 ∈ lrel → q2 = w2 $ by all_elim [l6]
l8: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ ra_ind_nested q1 w2 ∈ lrel $ by weaken [#2]
l9: $ GG , c = ra_ind_nested q1 q2 , c ∊ y2_P_ind_nested lrel ⇒ q2 = w2 $ by imp_elim [l7, l8]
l10: $ GG ⇒ q2 = w2 $ by wcel_elim [#1, l9]

lemma y2_ind_nested_ihc (GG: hyps) (Q1 Q2 W2: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset W2 $ > $ GG ⇒ ra_ind_nested Q1 Q2 ∈ y2_P_ind_nested lrel $ > $ GG ⇒ ra_ind_nested Q1 W2 ∈ lrel $ > $ GG ⇒ Q2 = W2 $
----
l1: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ d = W2 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q1 = a $ by eq_sym [l1]
l5: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = b $ by eq_sym [l2]
l6: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ W2 = d $ by eq_sym [l3]
l7: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ∅ = ∅ $ by eq_refl
l8: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ scons Q2 ∅ = scons b ∅ $ by scons_eq [l5, l7]
l9: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ scons Q1 (scons Q2 ∅) = scons a (scons b ∅) $ by scons_eq [l4, l8]
l10: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ kr_ind_nested = kr_ind_nested $ by eq_refl
l11: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_ind_nested Q1 Q2 = ra_ind_nested a b $ by opair_eq [l10, l9]
l12: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_ind_nested Q1 Q2 ∈ y2_P_ind_nested lrel $ by weaken [#4]
l13: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_ind_nested a b ∈ y2_P_ind_nested lrel $ by wcel_eq_l [l11, l12]
l14: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_ind_nested Q1 W2 ∈ lrel $ by weaken [#5]
l15: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_ind_nested a d ∈ lrel $ by x1_eq_ind_nested [l14, l4, l6]
l16: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ b = d $ by y2_ind_nested_ih [l13, l15]
l17: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = d $ by eq_trans [l5, l16]
l18: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = W2 $ by eq_trans [l17, l3]
l19: $ GG , a = Q1 , b = Q2 ⇒ Q2 = W2 $ by isset_elim [#3, l18]
l20: $ GG , a = Q1 ⇒ Q2 = W2 $ by isset_elim [#2, l19]
l21: $ GG ⇒ Q2 = W2 $ by isset_elim [#1, l20]

lemma y2_ind_nested_i1 (GG: hyps) {b P T: set} (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_ind_nested q1 q2 ⟩ ∈ cl_ind_nested_mk $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_nested lrel $ > $ GG ⇒ ∀ b ∀ P ∀ T (q1 = ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk ⇒ w ∊ cl_ind_nested_mk $ by ax
l2: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk ⇒ ∃ b ∃ P ∃ T (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_ind_nested q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_ind_nested q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_ind_nested q1 q2 ⟩ = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ isset (ra_ind_nested q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ isset (ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ o = ∅ ∧ ra_ind_nested q1 q2 = ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ kr_ind_nested , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_ind_nested , scons ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ kr_ind_nested ∈ ω $ by x1_kr_ind_nested
l15: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ isset kr_ind_nested $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ $ by opair_isset
