l33: $ G ⇒ isset (scons V1 (scons V5 (scons ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ (scons V11 (scons V9 ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_eta_eq = kr_eta_eq ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V5 (scons ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ (scons V11 (scons V9 ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V5 (scons ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ (scons V11 (scons V9 ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V5 (scons ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ (scons V11 (scons V9 ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V5 (scons ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ (scons V11 (scons V9 ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V5 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ (scons V11 (scons V9 ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = V5 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ (scons V11 (scons V9 ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = ⟨ kc_cons , scons V8 (scons V3 ∅) ⟩ ∧ scons t4 (scons t5 ∅) = scons V11 (scons V9 ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
