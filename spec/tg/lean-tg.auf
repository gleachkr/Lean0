l4: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons u_i ∅ ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons a ∅ ⟩ $ by and_elim_l [l2]
l7: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l8: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by y2_npis_e1 [l4, l5, l6, l7]
l9: $ GG , ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l10: $ GG , ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l9, l8]
l11: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l12: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons u_i ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l13: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons u_i ∅ ⟩ $ by and_elim_l [l12]
