l6: $ G ⇒ pp = scons (ra_add V4 V3 V5) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 V8) (scons (ra_pargs V8 ⟨ kc_nz , ∅ ⟩ V4 V9) ∅)) ∧ ra_mty t1 t2 t3 t4 t5 t6 t7 = ra_mty V1 V2 V3 V4 V6 ⟨ kc_srt , scons V7 ∅ ⟩ ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_add V4 V3 V5) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 V8) (scons (ra_pargs V8 ⟨ kc_nz , ∅ ⟩ V4 V9) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_mty t1 t2 t3 t4 t5 t6 t7 = ra_mty V1 V2 V3 V4 V6 ⟨ kc_srt , scons V7 ∅ ⟩ ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ $ by and_elim_r [l6]
