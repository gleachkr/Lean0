lemma y1_p_afree (G: hyps): $ G ⇒ pr_afree ⊆ y1_lab kr_afree (suc kr_afree) $
----
l1: $ G ⇒ cl_afree_quot_ind ⊆ y1_lab kr_afree (suc kr_afree) $ by y1_k_afree_quot_ind
l2: $ G ⇒ cl_afree_quot_lift ⊆ y1_lab kr_afree (suc kr_afree) $ by y1_k_afree_quot_lift
l3: $ G ⇒ cl_afree_quot_lift ∪ cl_afree_quot_ind ⊆ y1_lab kr_afree (suc kr_afree) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_afree_quot_mk ⊆ y1_lab kr_afree (suc kr_afree) $ by y1_k_afree_quot_mk
l5: $ G ⇒ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) ⊆ y1_lab kr_afree (suc kr_afree) $ by cun_least [l4, l3]
l6: $ G ⇒ cl_afree_quot ⊆ y1_lab kr_afree (suc kr_afree) $ by y1_k_afree_quot
