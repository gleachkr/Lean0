l65: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $ by imp_elim [l64, #1]

lemma y1_e_baddc_0l (G: hyps) {b_v c_v: set} (pp t1 t2 t3 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ = ⟨ scons (ra_bsucc V1 V2) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ V1 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = c_v ∧ ra_bsucc b_v c_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bsucc V1 V2) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ V1 V2 ⟩ = ⟨ pp , ra_baddc t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_bsucc V1 V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_baddc t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_baddc ⟨ kc_b0 , ∅ ⟩ V1 V2) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_bsucc V1 V2) ∅ ∧ ra_baddc t1 t2 t3 = ra_baddc ⟨ kc_b0 , ∅ ⟩ V1 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_bsucc V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_baddc t1 t2 t3 = ra_baddc ⟨ kc_b0 , ∅ ⟩ V1 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V1 $ by isset_var
l19: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_baddc ∈ ω $ by x1_kr_baddc
l23: $ G ⇒ isset kr_baddc $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V2 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_baddc = kr_baddc ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V2 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V2 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V2 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V2 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V2 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_bsucc V1 V2) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_bsucc V1 V2) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_bsucc V1 V2) $ by opair_isset
l39: $ G ⇒ ra_bsucc V1 V2 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V2 ∧ ra_bsucc V1 V2 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = V1 ∧ t3 = V2 ∧ ra_bsucc V1 V2 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V2 ∧ ra_bsucc V1 V2 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = V1 ∧ t3 = c_v ∧ ra_bsucc V1 c_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = c_v ∧ ra_bsucc b_v c_v ∈ lrel) $ by ex_intro [l43]

lemma y1_d_baddc_0l (G: hyps) {b_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ ∈ cl_baddc_0l $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = c_v ∧ ra_bsucc b_v c_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x ∊ cl_baddc_0l ⇒ x ∊ cl_baddc_0l $ by ax
l2: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x ∊ cl_baddc_0l ⇒ ∃ y ∃ z (x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩ ⇒ x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩ ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩ ⇒ x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩ ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩ ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = c_v ∧ ra_bsucc b_v c_v ∈ lrel) $ by y1_e_baddc_0l [l6, l7]
l9: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , ∃ z (x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩) ⇒ ∃ z (x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , ∃ z (x = ⟨ scons (ra_bsucc y z) ∅ , ra_baddc ⟨ kc_b0 , ∅ ⟩ y z ⟩) ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = c_v ∧ ra_bsucc b_v c_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x ∊ cl_baddc_0l ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = c_v ∧ ra_bsucc b_v c_v ∈ lrel) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = c_v ∧ ra_bsucc b_v c_v ∈ lrel) $ by wcel_elim [#1, l11]

lemma y1_e_baddc_0r (G: hyps) {a_v c_v: set} (pp t1 t2 t3 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ = ⟨ scons (ra_bsucc V1 V2) ∅ , ra_baddc V1 ⟨ kc_b0 , ∅ ⟩ V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ c_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = c_v ∧ ra_bsucc a_v c_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bsucc V1 V2) ∅ , ra_baddc V1 ⟨ kc_b0 , ∅ ⟩ V2 ⟩ = ⟨ pp , ra_baddc t1 t2 t3 ⟩ $ by eq_sym [#1]
