l31: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) $ by ax
l32: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by ex_elim [l31, l30]
l33: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_rtail_srt ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by ex_elim [l2, l32]
l34: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by wcel_elim [#1, l33]

lemma y1_o_rtail (G: hyps) {D np n_v m_v i_v d_v A B B2 mn dmn mi l_v X I X2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ pr_rtail $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt $ by ax
l2: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by y1_d_rtail_srt [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt → ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt $ by ax
l6: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∨ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi $ by ax
l8: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) $ by y1_d_rtail_pi [l7, l8]
l10: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt $ by ax
l12: $ G , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_pi ∪ cl_rtail_srt , ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt → ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by weaken [l4]
