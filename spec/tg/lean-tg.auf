lemma y1_d_mty_pi (G: hyps) {D np j_v d_v v_v A B M: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_mty_pi ⇒ x ∊ cl_mty_pi $ by ax
l2: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_mty_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ $ by ax
