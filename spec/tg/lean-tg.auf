lemma y1_o_badd (G: hyps) {b_v a_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ ∈ pr_badd $ > $ G ⇒ crn pp ⊆ lrel $ >
