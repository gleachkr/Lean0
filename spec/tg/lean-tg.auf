lemma y1_k_nfields_i (G: hyps): $ G ⇒ cl_nfields_i ⊆ y1_lab kr_nfields (suc kr_nfields) $
----
l1: $ G , x ∊ cl_nfields_i ⇒ x ∊ cl_nfields_i $ by ax
l2: $ G , x ∊ cl_nfields_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ kr_nfields ∈ ω $ by x1_kr_nfields
l5: $ G , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
l7: $ G , ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by ex_elim [l6, l5]
l8: $ G , ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
l9: $ G , ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by ex_elim [l8, l7]
l10: $ G , ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
l11: $ G , ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by ex_elim [l10, l9]
l12: $ G , ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
l13: $ G , ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ x ∊ y1_lab kr_nfields (suc kr_nfields) $ by ex_elim [l12, l11]
l14: $ G , ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) ⇒ ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by ax
