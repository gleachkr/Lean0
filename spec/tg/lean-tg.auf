lemma y1_k_nonrec_pi (G: hyps): $ G ⇒ cl_nonrec_pi ⊆ y1_lab kr_nonrec (suc kr_nonrec) $
----
l1: $ G , x ∊ cl_nonrec_pi ⇒ x ∊ cl_nonrec_pi $ by ax
l2: $ G , x ∊ cl_nonrec_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ kr_nonrec ∈ ω $ by x1_kr_nonrec
l5: $ G , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by ex_elim [l6, l5]
l8: $ G , ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by ex_elim [l8, l7]
l10: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by ex_elim [l10, l9]
l12: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by ex_elim [l12, l11]
l14: $ G , x ∊ cl_nonrec_pi ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by ex_elim [l2, l13]
l15: $ G ⇒ cl_nonrec_pi ⊆ y1_lab kr_nonrec (suc kr_nonrec) $ by subset_intro [l14]

lemma y1_k_nonrec_res (G: hyps): $ G ⇒ cl_nonrec_res ⊆ y1_lab kr_nonrec (suc kr_nonrec) $
----
l1: $ G , x ∊ cl_nonrec_res ⇒ x ∊ cl_nonrec_res $ by ax
l2: $ G , x ∊ cl_nonrec_res ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ kr_nonrec ∈ ω $ by x1_kr_nonrec
l5: $ G , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) ⇒ ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_nonrec_res ⇒ x ∊ y1_lab kr_nonrec (suc kr_nonrec) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_nonrec_res ⊆ y1_lab kr_nonrec (suc kr_nonrec) $ by subset_intro [l10]

lemma y1_p_nonrec (G: hyps): $ G ⇒ pr_nonrec ⊆ y1_lab kr_nonrec (suc kr_nonrec) $
----
l1: $ G ⇒ cl_nonrec_res ⊆ y1_lab kr_nonrec (suc kr_nonrec) $ by y1_k_nonrec_res
l2: $ G ⇒ cl_nonrec_pi ⊆ y1_lab kr_nonrec (suc kr_nonrec) $ by y1_k_nonrec_pi
l3: $ G ⇒ pr_nonrec ⊆ y1_lab kr_nonrec (suc kr_nonrec) $ by cun_least [l2, l1]

lemma y1_k_eta_ok_i (G: hyps): $ G ⇒ cl_eta_ok_i ⊆ y1_lab kr_eta_ok (suc kr_eta_ok) $
----
l1: $ G , x ∊ cl_eta_ok_i ⇒ x ∊ cl_eta_ok_i $ by ax
l2: $ G , x ∊ cl_eta_ok_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ kr_eta_ok ∈ ω $ by x1_kr_eta_ok
l5: $ G , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ x ∊ y1_lab kr_eta_ok (suc kr_eta_ok) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
