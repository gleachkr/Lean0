l11: $ G , y = A1 , z = A2 ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_nil , ∅ ⟩ $ by eq_refl
l12: $ G , y = A1 , z = A2 ⇒ scons z ∅ = scons A2 ∅ $ by scons_eq [l9, l10]
