l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l16, l19]
l21: $ G ⇒ kr_bor ∈ ω $ by x1_kr_bor
l22: $ G ⇒ isset kr_bor $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_bor = kr_bor ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l26, l14, l16, l13, l19]
l28: $ G ⇒ t1 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l18, l11, l17]
l31: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by ex_intro [l36]

lemma y1_d_bor_0r (G: hyps) {a_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_0r $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $
----
l1: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_0r ⇒ x ∊ cl_bor_0r $ by ax
l2: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_0r ⇒ ∃ y (x = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_bor t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by y1_e_bor_0r [l6, l7]
l9: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_0r ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by wcel_elim [#1, l9]

lemma y1_e_bor_00 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = ⟨ scons (ra_bor V1 V2 V3) ∅ , ra_bor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bor V1 V2 V3) ∅ , ra_bor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_bor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_bor V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_bor V1 V2 V3) ∅ ∧ ra_bor t1 t2 t3 = ra_bor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_bor V1 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bor t1 t2 t3 = ra_bor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩ $ by and_elim_r [l6]
