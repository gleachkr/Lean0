lemma y2_spine_d2 (GG: hyps) (o q1 q2 q3 w1: set):
  $ GG ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ ∈ cl_spine_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_spine lrel $ > $ GG ⇒ ra_spine w1 q2 q3 ∈ lrel $ > $ GG ⇒ q1 = w1 $
----
l1: $ GG , q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel ⇒ q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel $ by ax
l2: $ GG , q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel ⇒ ra_spine w1 q2 q3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel ⇒ q1 = w1 $ by y2_spine_c2 [l1, l2]
l4: $ GG ⇒ q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel → q1 = w1 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ e (q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel → q1 = w1) $ by all_intro [l4]
l6: $ GG ⇒ ∀ d ∀ e (q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel → q1 = w1) $ by all_intro [l5]
l7: $ GG ⇒ ∀ b ∀ d ∀ e (q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel → q1 = w1) $ by all_intro [l6]
l8: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e (q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine lrel → q1 = w1) $ by all_intro [l7]
l9: $ GG ⇒ q1 = w1 $ by y2_spine_i2 [#1, #2, l8]

lemma y2_spine_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_spine lrel → c ∊ y2_P_spine lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ c = ra_spine x1 x2 x3 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_spine x1 x2 x3 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ pr_spine $ by lprog_spine_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_spine lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ ra_spine x6 x2 x3 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel , ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_z ⇒ ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_z $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel , ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_z ⇒ crn o ⊆ horn lprog ∩ y2_P_spine lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel , ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_z ⇒ ra_spine x6 x2 x3 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel , ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_z ⇒ x1 = x6 $ by y2_spine_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel , ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_s ⇒ ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_s $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel , ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_s ⇒ crn o ⊆ horn lprog ∩ y2_P_spine lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel , ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_s ⇒ ra_spine x6 x2 x3 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel , ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_s ⇒ x1 = x6 $ by y2_spine_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_s → x1 = x6 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ ⟨ o , ra_spine x1 x2 x3 ⟩ ∈ cl_spine_z ∪ cl_spine_s → x1 = x6 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 , ra_spine x6 x2 x3 ∈ lrel ⇒ x1 = x6 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 ⇒ ra_spine x6 x2 x3 ∈ lrel → x1 = x6 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel , c = ra_spine x1 x2 x3 ⇒ ∀ x6 (⟨ kr_spine , scons x6 (scons x2 (scons x3 ∅)) ⟩ ∈ lrel → x1 = x6) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel ⇒ c = ⟨ kr_spine , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons x2 (scons x3 ∅)) ⟩ ∈ lrel → x1 = x6) $ by imp_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel ⇒ ∀ x3 (c = ⟨ kr_spine , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons x2 (scons x3 ∅)) ⟩ ∈ lrel → x1 = x6)) $ by all_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_spine , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons x2 (scons x3 ∅)) ⟩ ∈ lrel → x1 = x6)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_spine , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_spine , scons x6 (scons x2 (scons x3 ∅)) ⟩ ∈ lrel → x1 = x6)) $ by all_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_spine lrel ⇒ c ∊ y2_P_spine lrel $ by cab_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_spine lrel → c ∊ y2_P_spine lrel $ by imp_intro [l26]
l28: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_spine lrel → c ∊ y2_P_spine lrel $ by imp_intro [l27]
l29: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_spine lrel → c ∊ y2_P_spine lrel) $ by all_intro [l28]
l30: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_spine lrel → c ∊ y2_P_spine lrel) $ by all_intro [l29]

lemma y2_spine_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_spine lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_spine lrel → c ∊ y2_P_spine lrel) $ by y2_spine_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_spine lrel $ by horn_ind [l1, l2]

lrel_spine_det
--------------
l1: $ G ⇒ horn lprog ⊆ y2_P_spine lrel $ by y2_spine_in
l2: $ G ⇒ ra_spine u1 t2 t3 ∈ y2_P_spine lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u1 = v1 $ by y2_spine_ih [l2, #2]

--| The atoms of `spine` whose variants in `L` with the same inputs have the same outputs.
def y2_P_spine2 (L: class) (.c .x1 .x2 .x3 .x6 .x7 .x .y: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_spine , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ¬ ∃ x ∃ y (x1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → ∀ x6 ∀ x7 (⟨ kr_spine , scons x6 (scons x2 (scons x7 ∅)) ⟩ ∈ L → ¬ ∃ x ∃ y (x6 = ⟨ kc_app , scons x (scons y ∅) ⟩) → x1 = x6 ∧ x3 = x7))} $

lemma y2_spine2_ih {x y: set} (GG: hyps x y) (q1 q2 q3 w1 w3: set):
  $ GG ⇒ ra_spine q1 q2 q3 ∈ y2_P_spine2 lrel $ > $ GG ⇒ ra_spine w1 q2 w3 ∈ lrel $ > $ GG ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ q1 = w1 ∧ q3 = w3 $
----
l1: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ c ∊ y2_P_spine2 lrel $ by ax
l2: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_spine , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ¬ ∃ x ∃ y (x1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → ∀ x6 ∀ x7 (⟨ kr_spine , scons x6 (scons x2 (scons x7 ∅)) ⟩ ∈ lrel → ¬ ∃ x ∃ y (x6 = ⟨ kc_app , scons x (scons y ∅) ⟩) → x1 = x6 ∧ x3 = x7)) $ by cab_elim [l1]
l3: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_spine , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → ∀ x6 ∀ x7 (⟨ kr_spine , scons x6 (scons x2 (scons x7 ∅)) ⟩ ∈ lrel → ¬ ∃ x ∃ y (x6 = ⟨ kc_app , scons x (scons y ∅) ⟩) → q1 = x6 ∧ x3 = x7)) $ by all_elim [l2]
l4: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ∀ x3 (c = ⟨ kr_spine , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → ∀ x6 ∀ x7 (⟨ kr_spine , scons x6 (scons q2 (scons x7 ∅)) ⟩ ∈ lrel → ¬ ∃ x ∃ y (x6 = ⟨ kc_app , scons x (scons y ∅) ⟩) → q1 = x6 ∧ x3 = x7)) $ by all_elim [l3]
l5: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ c = ⟨ kr_spine , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → ∀ x6 ∀ x7 (⟨ kr_spine , scons x6 (scons q2 (scons x7 ∅)) ⟩ ∈ lrel → ¬ ∃ x ∃ y (x6 = ⟨ kc_app , scons x (scons y ∅) ⟩) → q1 = x6 ∧ q3 = x7) $ by all_elim [l4]
l6: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ c = ra_spine q1 q2 q3 $ by ax
l7: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → ∀ x6 ∀ x7 (⟨ kr_spine , scons x6 (scons q2 (scons x7 ∅)) ⟩ ∈ lrel → ¬ ∃ x ∃ y (x6 = ⟨ kc_app , scons x (scons y ∅) ⟩) → q1 = x6 ∧ q3 = x7) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#3]
l9: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ∀ x6 ∀ x7 (⟨ kr_spine , scons x6 (scons q2 (scons x7 ∅)) ⟩ ∈ lrel → ¬ ∃ x ∃ y (x6 = ⟨ kc_app , scons x (scons y ∅) ⟩) → q1 = x6 ∧ q3 = x7) $ by imp_elim [l7, l8]
l10: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ∀ x7 (⟨ kr_spine , scons w1 (scons q2 (scons x7 ∅)) ⟩ ∈ lrel → ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → q1 = w1 ∧ q3 = x7) $ by all_elim [l9]
l11: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ra_spine w1 q2 w3 ∈ lrel → ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → q1 = w1 ∧ q3 = w3 $ by all_elim [l10]
l12: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ra_spine w1 q2 w3 ∈ lrel $ by weaken [#2]
l13: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) → q1 = w1 ∧ q3 = w3 $ by imp_elim [l11, l12]
l14: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#4]
l15: $ GG , c = ra_spine q1 q2 q3 , c ∊ y2_P_spine2 lrel ⇒ q1 = w1 ∧ q3 = w3 $ by imp_elim [l13, l14]
l16: $ GG ⇒ q1 = w1 ∧ q3 = w3 $ by wcel_elim [#1, l15]

lemma y2_spine2_i1 (GG: hyps) {h: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ ∈ cl_spine_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_spine2 lrel $ > $ GG ⇒ ∀ h (q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z ⇒ w ∊ cl_spine_z $ by ax
l2: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z ⇒ ∃ h (w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_spine q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_spine q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_spine h h ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ ∧ ra_spine q1 q2 q3 = ra_spine h h ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ kr_spine , scons q1 (scons q2 (scons q3 ∅)) ⟩ = ⟨ kr_spine , scons h (scons h (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_spine ∈ ω $ by x1_kr_spine
l15: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset kr_spine $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q3 $ by isset_var
l19: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset h $ by isset_var
l20: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset h $ by isset_var
l21: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l22: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by y2_nd3 [l13, l15, l16, l17, l18, l19, l20, l21]
l23: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = h $ by and_elim_l [l22]
l24: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l22]
l25: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = h $ by and_elim_l [l24]
l26: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l24]
l27: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l25, l26]
l28: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l23, l27]
l29: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∀ h (q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ → ph) $ by weaken [#3]
l30: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = h ∧ q2 = h ∧ q3 = ⟨ kc_nz , ∅ ⟩ → ph $ by all_elim [l29]
l31: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z , w = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ph $ by imp_elim [l30, l28]
l32: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_z ⇒ ph $ by ex_elim [l2, l31]
l33: $ GG ⇒ ph $ by wcel_elim [#1, l32]

lemma y2_spine2_e1 {x y: set} (GG: hyps x y) (q1 q2 q3 w1 w3 u_h v_h: set):
  $ GG ⇒ q1 = u_h $ > $ GG ⇒ q2 = u_h $ > $ GG ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ w1 = v_h $ > $ GG ⇒ q2 = v_h $ > $ GG ⇒ w3 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ q1 = w1 ∧ q3 = w3 $
----
l1: $ GG ⇒ u_h = q2 $ by eq_sym [#2]
l2: $ GG ⇒ u_h = v_h $ by eq_trans [l1, #5]
l3: $ GG ⇒ v_h = w1 $ by eq_sym [#4]
l4: $ GG ⇒ q1 = v_h $ by eq_trans [#1, l2]
l5: $ GG ⇒ q1 = w1 $ by eq_trans [l4, l3]
l6: $ GG ⇒ ∅ = ∅ $ by eq_refl
l7: $ GG ⇒ kc_nz = kc_nz $ by eq_refl
l8: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by opair_eq [l7, l6]
l9: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = w3 $ by eq_sym [#6]
l10: $ GG ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [#3, l8]
l11: $ GG ⇒ q3 = w3 $ by eq_trans [l10, l9]
l12: $ GG ⇒ q1 = w1 ∧ q3 = w3 $ by and_intro [l5, l11]

lemma y2_spine2_c1 {x y: set} (GG: hyps x y) (q1 q2 q3 w1 w3 u_h: set):
  $ GG ⇒ q1 = u_h ∧ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ ra_spine w1 q2 w3 ∈ lrel $ > $ GG ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ q1 = w1 ∧ q3 = w3 $
----
l1: $ GG ⇒ ∃ a (w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by lrel_spine_cases [#2]
l2: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = u_h ∧ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l4: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = u_h $ by and_elim_l [l3]
l5: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l3]
l6: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = u_h $ by and_elim_l [l5]
l7: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l5]
l8: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ w1 = a $ by and_elim_l [l2]
l9: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l10: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = a $ by and_elim_l [l9]
l11: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ w3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l9]
l12: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#3]
l13: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#4]
l14: $ GG , w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = w1 ∧ q3 = w3 $ by y2_spine2_e1 [l4, l6, l7, l8, l10, l11, l12, l13]
l15: $ GG , ∃ a (w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ a (w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩) $ by ax
l16: $ GG , ∃ a (w1 = a ∧ q2 = a ∧ w3 = ⟨ kc_nz , ∅ ⟩) ⇒ q1 = w1 ∧ q3 = w3 $ by ex_elim [l15, l14]
l17: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel $ by ax
l18: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = u_h ∧ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l19: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = u_h $ by and_elim_l [l18]
l20: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q2 = u_h ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l18]
l21: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q2 = u_h $ by and_elim_l [l20]
l22: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l20]
l23: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ w1 = a $ by and_elim_l [l17]
l24: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel $ by and_elim_r [l17]
l25: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ $ by and_elim_l [l24]
l26: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel $ by and_elim_r [l24]
l27: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ w3 = ⟨ kc_s , scons e ∅ ⟩ $ by and_elim_l [l26]
l28: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ ra_spine a b e ∈ lrel $ by and_elim_r [l26]
l29: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#3]
l30: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#4]
l31: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ u_h = q2 $ by eq_sym [l21]
l32: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = q2 $ by eq_trans [l19, l31]
l33: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ $ by eq_trans [l32, l25]
l34: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ ∃ y (q1 = ⟨ kc_app , scons b (scons y ∅) ⟩) $ by ex_intro [l33]
l35: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by ex_intro [l34]
l36: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ ⊥ $ by not_elim [l29, l35]
l37: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = w1 ∧ q3 = w3 $ by bot_elim [l36]
l38: $ GG , w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ⇒ q1 = w1 ∧ q3 = w3 $ by bot_elim [l36]
l39: $ GG , ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by ax
l40: $ GG , ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ q1 = w1 ∧ q3 = w3 $ by ex_elim [l39, l38]
l41: $ GG , ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by ax
l42: $ GG , ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ q1 = w1 ∧ q3 = w3 $ by ex_elim [l41, l40]
l43: $ GG , ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by ax
l44: $ GG , ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ q1 = w1 ∧ q3 = w3 $ by ex_elim [l43, l42]
l45: $ GG , ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by ax
l46: $ GG , ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) ⇒ q1 = w1 ∧ q3 = w3 $ by ex_elim [l45, l44]
l47: $ GG ⇒ q1 = w1 ∧ q3 = w3 $ by or_elim [l1, l16, l46]

lemma y2_spine2_d1 {x y: set} (GG: hyps x y) (o q1 q2 q3 w1 w3: set):
  $ GG ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ ∈ cl_spine_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_spine2 lrel $ > $ GG ⇒ ra_spine w1 q2 w3 ∈ lrel $ > $ GG ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ q1 = w1 ∧ q3 = w3 $
----
l1: $ GG , q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ GG , q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_spine w1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#4]
l4: $ GG , q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#5]
l5: $ GG , q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = w1 ∧ q3 = w3 $ by y2_spine2_c1 [l1, l2, l3, l4]
l6: $ GG ⇒ q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ → q1 = w1 ∧ q3 = w3 $ by imp_intro [l5]
l7: $ GG ⇒ ∀ a (q1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ → q1 = w1 ∧ q3 = w3) $ by all_intro [l6]
l8: $ GG ⇒ q1 = w1 ∧ q3 = w3 $ by y2_spine2_i1 [#1, #2, l7]

lemma y2_spine2_i2 (GG: hyps) {h e a k: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ ∈ cl_spine_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_spine2 lrel $ > $ GG ⇒ ∀ h ∀ e ∀ a ∀ k (q1 = h ∧ q2 = ⟨ kc_app , scons e (scons a ∅) ⟩ ∧ q3 = ⟨ kc_s , scons k ∅ ⟩ ∧ ra_spine h e k ∈ lrel ∧ ra_spine h e k ∈ y2_P_spine2 lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_s ⇒ w ∊ cl_spine_s $ by ax
l2: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_s ⇒ ∃ h ∃ e ∃ a ∃ k (w = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_s , w = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_spine q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_spine q1 q2 q3 ⟩ , w ∊ cl_spine_s , w = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ w = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ $ by ax
