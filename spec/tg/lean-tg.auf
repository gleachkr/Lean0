lemma y2_ntys_e2 (GG: hyps) (q1 q2 q3 w2 w3 u_F u_C u_T u_n u_m u_c u_m2 v_F v_C v_T v_n v_m v_c v_m2: set):
  $ GG ⇒ q1 = ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ > $ GG ⇒ q3 = u_m2 $ > $ GG ⇒ ra_ntys u_T u_n u_m ∈ lrel $ > $ GG ⇒ ra_ntys u_T u_n u_m ∈ y2_P_ntys lrel $ > $ GG ⇒ ra_clen_c u_C u_c ∈ lrel $ > $ GG ⇒ ra_add u_m u_c u_m2 ∈ lrel $ > $ GG ⇒ q1 = ⟨ kc_tcons , scons v_F (scons v_C (scons v_T ∅)) ⟩ $ > $ GG ⇒ w2 = ⟨ kc_s , scons v_n ∅ ⟩ $ > $ GG ⇒ w3 = v_m2 $ > $ GG ⇒ ra_ntys v_T v_n v_m ∈ lrel $ > $ GG ⇒ ra_clen_c v_C v_c ∈ lrel $ > $ GG ⇒ ra_add v_m v_c v_m2 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ = ⟨ kc_tcons , scons v_F (scons v_C (scons v_T ∅)) ⟩ $ by eq_trans [l1, #8]
l3: $ GG ⇒ kc_tcons ∈ ω $ by v1_kc_tcons
l4: $ GG ⇒ isset kc_tcons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_F $ by isset_var
l6: $ GG ⇒ isset u_C $ by isset_var
l7: $ GG ⇒ isset u_T $ by isset_var
l8: $ GG ⇒ isset v_F $ by isset_var
l9: $ GG ⇒ isset v_C $ by isset_var
l10: $ GG ⇒ isset v_T $ by isset_var
l11: $ GG ⇒ u_F = v_F ∧ u_C = v_C ∧ u_T = v_T $ by y2_nd3 [l2, l4, l5, l6, l7, l8, l9, l10]
l12: $ GG ⇒ u_F = v_F $ by and_elim_l [l11]
l13: $ GG ⇒ u_C = v_C ∧ u_T = v_T $ by and_elim_r [l11]
l14: $ GG ⇒ u_C = v_C $ by and_elim_l [l13]
l15: $ GG ⇒ u_T = v_T $ by and_elim_r [l13]
l16: $ GG ⇒ v_T = u_T $ by eq_sym [l15]
l17: $ GG ⇒ v_n = v_n $ by eq_refl
l18: $ GG ⇒ v_m = v_m $ by eq_refl
l19: $ GG ⇒ ra_ntys u_T v_n v_m ∈ lrel $ by x1_eq_ntys [#11, l16, l17, l18]
l20: $ GG ⇒ isset u_T $ by isset_var
l21: $ GG ⇒ isset u_n $ by isset_var
l22: $ GG ⇒ isset u_m $ by isset_var
l23: $ GG ⇒ isset v_n $ by isset_var
l24: $ GG ⇒ isset v_m $ by isset_var
l25: $ GG ⇒ u_n = v_n ∧ u_m = v_m $ by y2_ntys_ihc [l20, l21, l22, l23, l24, #5, l19]
l26: $ GG ⇒ u_n = v_n $ by and_elim_l [l25]
l27: $ GG ⇒ u_m = v_m $ by and_elim_r [l25]
l28: $ GG ⇒ v_C = u_C $ by eq_sym [l14]
l29: $ GG ⇒ v_c = v_c $ by eq_refl
l30: $ GG ⇒ ra_clen_c u_C v_c ∈ lrel $ by x1_eq_clen_c [#12, l28, l29]
l31: $ GG ⇒ u_c = v_c $ by lrel_clen_c_det [#6, l30]
l32: $ GG ⇒ v_m = u_m $ by eq_sym [l27]
l33: $ GG ⇒ v_c = u_c $ by eq_sym [l31]
l34: $ GG ⇒ v_m2 = v_m2 $ by eq_refl
l35: $ GG ⇒ ra_add u_m u_c v_m2 ∈ lrel $ by x1_eq_add [#13, l32, l33, l34]
l36: $ GG ⇒ u_m2 = v_m2 $ by lrel_add_det [#7, l35]
l37: $ GG ⇒ ∅ = ∅ $ by eq_refl
l38: $ GG ⇒ scons u_n ∅ = scons v_n ∅ $ by scons_eq [l26, l37]
l39: $ GG ⇒ kc_s = kc_s $ by eq_refl
l40: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = ⟨ kc_s , scons v_n ∅ ⟩ $ by opair_eq [l39, l38]
l41: $ GG ⇒ ⟨ kc_s , scons v_n ∅ ⟩ = w2 $ by eq_sym [#9]
l42: $ GG ⇒ q2 = ⟨ kc_s , scons v_n ∅ ⟩ $ by eq_trans [#2, l40]
l43: $ GG ⇒ q2 = w2 $ by eq_trans [l42, l41]
l44: $ GG ⇒ v_m2 = w3 $ by eq_sym [#10]
l45: $ GG ⇒ q3 = v_m2 $ by eq_trans [#3, l36]
l46: $ GG ⇒ q3 = w3 $ by eq_trans [l45, l44]
l47: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by and_intro [l43, l46]

lemma y2_ntys_c2 (GG: hyps) (q1 q2 q3 w2 w3 u_F u_C u_T u_n u_m u_c u_m2: set):
  $ GG ⇒ q1 = ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_m2 ∧ ra_ntys u_T u_n u_m ∈ lrel ∧ ra_ntys u_T u_n u_m ∈ y2_P_ntys lrel ∧ ra_clen_c u_C u_c ∈ lrel ∧ ra_add u_m u_c u_m2 ∈ lrel $ > $ GG ⇒ ra_ntys q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG ⇒ (q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ b ∃ d ∃ e ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) $ by lrel_ntys_cases [#2]
l2: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_m2 ∧ ra_ntys u_T u_n u_m ∈ lrel ∧ ra_ntys u_T u_n u_m ∈ y2_P_ntys lrel ∧ ra_clen_c u_C u_c ∈ lrel ∧ ra_add u_m u_c u_m2 ∈ lrel $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_m2 ∧ ra_ntys u_T u_n u_m ∈ lrel ∧ ra_ntys u_T u_n u_m ∈ y2_P_ntys lrel ∧ ra_clen_c u_C u_c ∈ lrel ∧ ra_add u_m u_c u_m2 ∈ lrel $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q3 = u_m2 ∧ ra_ntys u_T u_n u_m ∈ lrel ∧ ra_ntys u_T u_n u_m ∈ y2_P_ntys lrel ∧ ra_clen_c u_C u_c ∈ lrel ∧ ra_add u_m u_c u_m2 ∈ lrel $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ q3 = u_m2 $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ntys u_T u_n u_m ∈ lrel ∧ ra_ntys u_T u_n u_m ∈ y2_P_ntys lrel ∧ ra_clen_c u_C u_c ∈ lrel ∧ ra_add u_m u_c u_m2 ∈ lrel $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ntys u_T u_n u_m ∈ lrel $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ntys u_T u_n u_m ∈ y2_P_ntys lrel ∧ ra_clen_c u_C u_c ∈ lrel ∧ ra_add u_m u_c u_m2 ∈ lrel $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ntys u_T u_n u_m ∈ y2_P_ntys lrel $ by and_elim_l [l11]
l13: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen_c u_C u_c ∈ lrel ∧ ra_add u_m u_c u_m2 ∈ lrel $ by and_elim_r [l11]
l14: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen_c u_C u_c ∈ lrel $ by and_elim_l [l13]
l15: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_add u_m u_c u_m2 ∈ lrel $ by and_elim_r [l13]
