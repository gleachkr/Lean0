l26: $ G ⇒ kr_baddc = kr_baddc ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
