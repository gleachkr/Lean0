l6: $ G , ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_iargs (suc kr_iargs) $ by ex_elim [l6, l5]
l8: $ G , ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_iargs (suc kr_iargs) $ by ex_elim [l8, l7]
l10: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_iargs (suc kr_iargs) $ by ex_elim [l10, l9]
l12: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
