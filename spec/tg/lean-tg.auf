l60: $ G ⇒ ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = ⟨ kc_proj , scons V4 (scons V5 (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons V4 (scons V5 (scons e2 ∅)) ⟩ ∧ ra_spz V1 V2 V3 e_v e2 ∈ lrel) $ by ex_intro [l59]
