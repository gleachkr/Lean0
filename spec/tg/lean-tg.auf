lemma y1_e_bmul_0 (G: hyps) {a_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ = ⟨ ∅ , ra_bmul V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_bmul V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ = ⟨ pp , ra_bmul t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bmul t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bmul V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_bmul t1 t2 t3 = ra_bmul V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
