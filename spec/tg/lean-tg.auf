lemma y1_k_rtail_srt (G: hyps): $ G ⇒ cl_rtail_srt ⊆ y1_lab kr_rtail (suc kr_rtail) $
----
l1: $ G , x ∊ cl_rtail_srt ⇒ x ∊ cl_rtail_srt $ by ax
l2: $ G , x ∊ cl_rtail_srt ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ ⇒ kr_rtail ∈ ω $ by x1_kr_rtail
l5: $ G , x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_rtail (suc kr_rtail) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) ⇒ ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) $ by ax
