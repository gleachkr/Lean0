l5: $ G ⇒ isset (ra_afree ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ ∃ v_v (t1 = ⟨ kc_quot_lift , scons V1 (scons v_v ∅) ⟩) $ by ex_intro [l21]
l23: $ G ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by ex_intro [l22]

lemma y1_d_afree_quot_lift (G: hyps) {u_v v_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot_lift ⇒ x ∊ cl_afree_quot_lift $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot_lift ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩ ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by y1_e_afree_quot_lift [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot_lift ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_afree_quot_ind (G: hyps) {u_v: set} (pp t1 V1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_quot_ind , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_quot_ind , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_quot_ind , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_quot_ind , scons V1 ∅ ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_quot_ind , scons V1 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_quot_ind , scons V1 ∅ ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_quot_ind , scons V1 ∅ ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_quot_ind , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_quot_ind , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_quot_ind , scons V1 ∅ ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by ex_intro [l21]

lemma y1_d_afree_quot_ind (G: hyps) {u_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot_ind ⇒ x ∊ cl_afree_quot_ind $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot_ind ⇒ ∃ y (x = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot_ind , scons y ∅ ⟩ ⟩ ⇒ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by y1_e_afree_quot_ind [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot_ind ⇒ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_o_afree (G: hyps) {i_v l_v f_v a_v A b_v S n_v D N j_v np m_v n0 c_v v_v e_v u_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ pr_afree $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩) ∨ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) ∨ ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) ∨ ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) ∨ ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) ∨ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) ∨ ∃ D ∃ N ∃ j_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) ∨ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) ∨ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) ∨ ∃ u_v (t1 = ⟨ kc_quot , scons u_v ∅ ⟩) ∨ ∃ u_v (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) ∨ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $
----
l1: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind $ by ax
l2: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind ⇒ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by y1_d_afree_quot_ind [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind → ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind $ by ax
l6: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∨ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift $ by ax
l8: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by y1_d_afree_quot_lift [l7, l8]
l10: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind $ by ax
l12: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind → ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind ⇒ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_ind ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind ⇒ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind → ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by imp_intro [l15]
l17: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) $ by ax
l18: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∨ ⟨ pp , ra_afree t1 ⟩ ∈ (cl_afree_quot_lift ∪ cl_afree_quot_ind) $ by v1_wcel_cun_elim [l17]
l19: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk $ by ax
l20: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ⇒ crn pp ⊆ lrel $ by weaken [#2]
l21: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ⇒ ∃ u_v (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $ by y1_d_afree_quot_mk [l19, l20]
l22: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ⇒ ∃ u_v (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) ∨ ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by or_intro_l [l21]
l23: $ G , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind) , ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot_lift ∪ cl_afree_quot_ind $ by ax
