l38: $ G ⇒ kr_recfield = kr_recfield ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = V3 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 ∅) = scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
l50: $ G ⇒ t4 = V4 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 (scons t6 ∅) = scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅) $ by and_elim_r [l49]
l52: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ scons t6 ∅ = scons V5 ∅ $ by y1_scons_inj [l51, l12, l24, l11, l23]
l53: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ $ by and_elim_l [l52]
l54: $ G ⇒ scons t6 ∅ = scons V5 ∅ $ by and_elim_r [l52]
l55: $ G ⇒ t6 = V5 ∧ ∅ = ∅ $ by y1_scons_inj [l54, l10, l22, l9, l9]
