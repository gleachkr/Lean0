l9: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ b = b $ by eq_refl
l10: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ szip a b = szip (scons K1 (scons K2 (scons K3 (scons K4 ∅)))) b $ by szip_eq [l3, l9]
l11: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ szip a b ⊆ sorted lsig lopen $ by weaken [#7]
l12: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ szip (scons K1 (scons K2 (scons K3 (scons K4 ∅)))) b ⊆ sorted lsig lopen $ by subset_eq_l [l10, l11]
l13: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ isset K1 $ by weaken [#1]
l14: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ isset K2 $ by weaken [#2]
l15: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ isset K3 $ by weaken [#3]
