l7: $ G ⇒ scons B3 (scons B4 (scons B5 ∅)) ∈ fseq y2_V $ by y2_fs [#10, l5]
l8: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 ∅))) ∈ fseq y2_V $ by y2_fs [#4, l6]
l9: $ G ⇒ scons B2 (scons B3 (scons B4 (scons B5 ∅))) ∈ fseq y2_V $ by y2_fs [#9, l7]
l10: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) ∈ fseq y2_V $ by y2_fs [#3, l8]
l11: $ G ⇒ scons B1 (scons B2 (scons B3 (scons B4 (scons B5 ∅)))) ∈ fseq y2_V $ by y2_fs [#8, l9]
l12: $ G ⇒ isset (scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅))))) $ by y2_fs_set [l10]
l13: $ G ⇒ isset (scons B1 (scons B2 (scons B3 (scons B4 (scons B5 ∅))))) $ by y2_fs_set [l11]
l14: $ G ⇒ K = K ∧ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) = scons B1 (scons B2 (scons B3 (scons B4 (scons B5 ∅)))) $ by opair_inj_c [#1, #2, l12, #2, l13]
l15: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 ∅)))) = scons B1 (scons B2 (scons B3 (scons B4 (scons B5 ∅)))) $ by and_elim_r [l14]
l16: $ G ⇒ A1 = B1 ∧ scons A2 (scons A3 (scons A4 (scons A5 ∅))) = scons B2 (scons B3 (scons B4 (scons B5 ∅))) $ by y2_sc_inj [#3, #8, l8, l9, l15]
l17: $ G ⇒ A1 = B1 $ by and_elim_l [l16]
l18: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 ∅))) = scons B2 (scons B3 (scons B4 (scons B5 ∅))) $ by and_elim_r [l16]
l19: $ G ⇒ A2 = B2 ∧ scons A3 (scons A4 (scons A5 ∅)) = scons B3 (scons B4 (scons B5 ∅)) $ by y2_sc_inj [#4, #9, l6, l7, l18]
l20: $ G ⇒ A2 = B2 $ by and_elim_l [l19]
l21: $ G ⇒ scons A3 (scons A4 (scons A5 ∅)) = scons B3 (scons B4 (scons B5 ∅)) $ by and_elim_r [l19]
l22: $ G ⇒ A3 = B3 ∧ scons A4 (scons A5 ∅) = scons B4 (scons B5 ∅) $ by y2_sc_inj [#5, #10, l4, l5, l21]
l23: $ G ⇒ A3 = B3 $ by and_elim_l [l22]
l24: $ G ⇒ scons A4 (scons A5 ∅) = scons B4 (scons B5 ∅) $ by and_elim_r [l22]
l25: $ G ⇒ A4 = B4 ∧ scons A5 ∅ = scons B5 ∅ $ by y2_sc_inj [#6, #11, l2, l3, l24]
l26: $ G ⇒ A4 = B4 $ by and_elim_l [l25]
l27: $ G ⇒ scons A5 ∅ = scons B5 ∅ $ by and_elim_r [l25]
l28: $ G ⇒ A5 = B5 ∧ ∅ = ∅ $ by y2_sc_inj [#7, #12, l1, l1, l27]
l29: $ G ⇒ A5 = B5 $ by and_elim_l [l28]
l30: $ G ⇒ A4 = B4 ∧ A5 = B5 $ by and_intro [l26, l29]
l31: $ G ⇒ A3 = B3 ∧ A4 = B4 ∧ A5 = B5 $ by and_intro [l23, l30]
l32: $ G ⇒ A2 = B2 ∧ A3 = B3 ∧ A4 = B4 ∧ A5 = B5 $ by and_intro [l20, l31]
l33: $ G ⇒ A1 = B1 ∧ A2 = B2 ∧ A3 = B3 ∧ A4 = B4 ∧ A5 = B5 $ by and_intro [l17, l32]

