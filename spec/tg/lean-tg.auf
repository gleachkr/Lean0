lemma y1_e_bpow_d1 (G: hyps) {a_v b_v c_v d_v e_v: set} (pp t1 t2 t3 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_bpow t1 t2 t3 ⟩ = ⟨ scons (ra_bpow V1 V2 V3) (scons (ra_bmul V3 V3 V4) (scons (ra_bmul V4 V1 V5) ∅)) , ra_bpow V1 ⟨ kc_bd1 , scons V2 ∅ ⟩ V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bpow a_v b_v c_v ∈ lrel ∧ ra_bmul c_v c_v d_v ∈ lrel ∧ ra_bmul d_v a_v e_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bpow V1 V2 V3) (scons (ra_bmul V3 V3 V4) (scons (ra_bmul V4 V1 V5) ∅)) , ra_bpow V1 ⟨ kc_bd1 , scons V2 ∅ ⟩ V5 ⟩ = ⟨ pp , ra_bpow t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_bpow V1 V2 V3) (scons (ra_bmul V3 V3 V4) (scons (ra_bmul V4 V1 V5) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bpow t1 t2 t3) $ by opair_isset
