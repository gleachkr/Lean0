lemma y1_k_tys_closed_nil (G: hyps): $ G ⇒ cl_tys_closed_nil ⊆ y1_lab kr_tys_closed (suc kr_tys_closed) $
----
l1: $ G , x ∊ cl_tys_closed_nil ⇒ x ∊ cl_tys_closed_nil $ by ax
l2: $ G , x ∊ cl_tys_closed_nil ⇒ ∃ y (x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ kr_tys_closed ∈ ω $ by x1_kr_tys_closed
l5: $ G , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_tys_closed (suc kr_tys_closed) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_tys_closed_nil ⇒ x ∊ y1_lab kr_tys_closed (suc kr_tys_closed) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_tys_closed_nil ⊆ y1_lab kr_tys_closed (suc kr_tys_closed) $ by subset_intro [l6]

lemma y1_k_tys_closed_cons (G: hyps): $ G ⇒ cl_tys_closed_cons ⊆ y1_lab kr_tys_closed (suc kr_tys_closed) $
----
l1: $ G , x ∊ cl_tys_closed_cons ⇒ x ∊ cl_tys_closed_cons $ by ax
l2: $ G , x ∊ cl_tys_closed_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ kr_tys_closed ∈ ω $ by x1_kr_tys_closed
l5: $ G , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ x ∊ y1_lab kr_tys_closed (suc kr_tys_closed) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by ax
l7: $ G , ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_tys_closed (suc kr_tys_closed) $ by ex_elim [l6, l5]
l8: $ G , ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by ax
l9: $ G , ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_tys_closed (suc kr_tys_closed) $ by ex_elim [l8, l7]
l10: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by ax
l11: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_tys_closed (suc kr_tys_closed) $ by ex_elim [l10, l9]
l12: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by ax
l13: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_tys_closed (suc kr_tys_closed) $ by ex_elim [l12, l11]
l14: $ G , x ∊ cl_tys_closed_cons ⇒ x ∊ y1_lab kr_tys_closed (suc kr_tys_closed) $ by ex_elim [l2, l13]
l15: $ G ⇒ cl_tys_closed_cons ⊆ y1_lab kr_tys_closed (suc kr_tys_closed) $ by subset_intro [l14]

lemma y1_p_tys_closed (G: hyps): $ G ⇒ pr_tys_closed ⊆ y1_lab kr_tys_closed (suc kr_tys_closed) $
----
