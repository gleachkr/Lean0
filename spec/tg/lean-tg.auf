-- Each subtree is in its label range.

lemma y1_s5 (G: hyps): $ G ⇒ y1_u5 ⊆ y1_lab kr_le (suc kr_add) $
----
l1: $ G ⇒ pr_le ⊆ y1_lab kr_le (suc kr_le) $ by y1_p_le
