l13: $ G ⇒ cl_lift_bvar_ge ∪ (cl_lift_srt ∪ (cl_lift_app ∪ (cl_lift_lam ∪ (cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj))))) ⊆ y1_lab kr_lift (suc kr_lift) $ by cun_least [l12, l11]
