l18: $ G ⇒ k = ks_tys → ⊥ $ by v1_ne_lt [#2, l17]
l19: $ G ⇒ ks_expr ∈ ks_ctors $ by v1_lt_expr_ctors
l20: $ G ⇒ k = ks_ctors → ⊥ $ by v1_ne_lt [#2, l19]
l21: $ G ⇒ ks_nat ∈ ω $ by v1_ks_nat
l22: $ G ⇒ isset ks_nat $ by wcel_isset [l21]
l23: $ G ⇒ ks_lvl ∈ ω $ by v1_ks_lvl
l24: $ G ⇒ isset ks_lvl $ by wcel_isset [l23]
l25: $ G ⇒ ks_expr ∈ ω $ by v1_ks_expr
l26: $ G ⇒ isset ks_expr $ by wcel_isset [l25]
l27: $ G ⇒ ks_atom ∈ ω $ by v1_ks_atom
l28: $ G ⇒ isset ks_atom $ by wcel_isset [l27]
l29: $ G ⇒ ks_lvls ∈ ω $ by v1_ks_lvls
l30: $ G ⇒ isset ks_lvls $ by wcel_isset [l29]
l31: $ G ⇒ ks_bin ∈ ω $ by v1_ks_bin
l32: $ G ⇒ isset ks_bin $ by wcel_isset [l31]
l33: $ G ⇒ ks_ind ∈ ω $ by v1_ks_ind
l34: $ G ⇒ isset ks_ind $ by wcel_isset [l33]
l35: $ G ⇒ ks_blk ∈ ω $ by v1_ks_blk
l36: $ G ⇒ isset ks_blk $ by wcel_isset [l35]
