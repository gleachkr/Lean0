l12: $ G ⇒ isset ⟨ kc_quot_mk , scons V1 ∅ ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_quot_mk , scons V1 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
