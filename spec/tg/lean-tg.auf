l25: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ $ by and_elim_l [l24]
