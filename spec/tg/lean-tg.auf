-- Lemmas of y2 (the range lrel_add_det .. lrel_spine_det2): determinacy, generated by a script (y2-gen.py) from lean-tg.mm0.

--| A class containing every set.
def y2_V (.x: set): class = $ {x | x = x} $

lemma y2_inV (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ y2_V $
----
l1: $ G , z = A ⇒ z = z $ by eq_refl
l2: $ G ⇒ A ∈ y2_V $ by wcel_cab_intro [#1, l1]

lemma y2_fs0 (G: hyps): $ G ⇒ ∅ ∈ fseq y2_V $
----
l1: $ G ⇒ ∅ ∈ fseq y2_V $ by fseq_empty

lemma y2_fs (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ S ∈ fseq y2_V $ > $ G ⇒ scons A S ∈ fseq y2_V $
----
l1: $ G ⇒ A ∈ y2_V $ by y2_inV [#1]
l2: $ G ⇒ scons A S ∈ fseq y2_V $ by v1_scons_fseq_c [l1, #2]

lemma y2_fs_set (G: hyps) (S: class): $ G ⇒ S ∈ fseq y2_V $ > $ G ⇒ isset S $
----
l1: $ G ⇒ isset S $ by wcel_isset [#1]

--| Not an application, transported along an equality.
lemma y2_na_eq {x y: set} (GG: hyps x y) (a b: set):
  $ GG ⇒ a = b $ > $ GG ⇒ ¬ ∃ x ∃ y (a = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ ¬ ∃ x ∃ y (b = ⟨ kc_app , scons x (scons y ∅) ⟩) $
----
l1: $ GG ⇒ ¬ ∃ x ∃ y (b = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by eq_subst [#1, #2]

--| Class form of `scons_inj`, for sequences of sets.
lemma y2_sc_inj (G: hyps) (A B S T: class):
  $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ S ∈ fseq y2_V $ > $ G ⇒ T ∈ fseq y2_V $ > $ G ⇒ scons A S = scons B T $ > $ G ⇒ A = B ∧ S = T $
----
l1: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ u ∊ fseq y2_V $ by ax
l2: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ rel u $ by fseq_rel [l1]
l3: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ v ∊ fseq y2_V $ by ax
l4: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ rel v $ by fseq_rel [l3]
l5: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ a = A $ by ax
l6: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ u = S $ by ax
l7: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ scons a u = scons A S $ by scons_eq [l5, l6]
l8: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ b = B $ by ax
l9: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ v = T $ by ax
l10: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ scons b v = scons B T $ by scons_eq [l8, l9]
l11: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ scons B T = scons b v $ by eq_sym [l10]
l12: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ scons A S = scons B T $ by weaken [#5]
l13: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ scons a u = scons B T $ by eq_trans [l7, l12]
l14: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ scons a u = scons b v $ by eq_trans [l13, l11]
l15: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ a = b ∧ u = v $ by scons_inj [l2, l4, l14]
l16: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ a = b $ by and_elim_l [l15]
l17: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ u = v $ by and_elim_r [l15]
l18: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ A = a $ by eq_sym [l5]
l19: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ A = b $ by eq_trans [l18, l16]
l20: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ A = B $ by eq_trans [l19, l8]
l21: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ S = u $ by eq_sym [l6]
l22: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ S = v $ by eq_trans [l21, l17]
l23: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ S = T $ by eq_trans [l22, l9]
l24: $ G , a = A , b = B , u = S , u ∊ fseq y2_V , v = T , v ∊ fseq y2_V ⇒ A = B ∧ S = T $ by and_intro [l20, l23]
l25: $ G , a = A , b = B , u = S , u ∊ fseq y2_V ⇒ A = B ∧ S = T $ by wcel_elim [#4, l24]
l26: $ G , a = A , b = B ⇒ A = B ∧ S = T $ by wcel_elim [#3, l25]
l27: $ G , a = A ⇒ A = B ∧ S = T $ by isset_elim [#2, l26]
l28: $ G ⇒ A = B ∧ S = T $ by isset_elim [#1, l27]

--| Equal pairs have equal first components (the second need not be sets).
lemma y2_op_fst (G: hyps) (A B C D: class):
  $ G ⇒ isset A $ > $ G ⇒ isset C $ > $ G ⇒ ⟨ A , B ⟩ = ⟨ C , D ⟩ $ > $ G ⇒ A = C $
----
l1: $ G ⇒ isset (csn A) $ by csn_set [#1]
l2: $ G ⇒ csn A ∈ cpr (csn A) (cpr A B) $ by cpr_intro_l_c [l1]
l3: $ G ⇒ csn A ∈ cpr (csn C) (cpr C D) $ by wcel_eq_r [#3, l2]
l4: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) ⇒ z ∊ cpr (csn C) (cpr C D) $ by ax
l5: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) ⇒ z = csn C ∨ z = cpr C D $ by cpr_elim [l4]
l6: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = csn C ⇒ z = csn A $ by ax
l7: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = csn C ⇒ z = csn C $ by ax
l8: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = csn C ⇒ csn A = z $ by eq_sym [l6]
l9: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = csn C ⇒ csn A = csn C $ by eq_trans [l8, l7]
l10: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = csn C ⇒ isset A $ by weaken [#1]
l11: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = csn C ⇒ A = C $ by csn_inj_c [l10, l9]
l12: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D ⇒ isset C $ by weaken [#2]
l13: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D ⇒ C ∈ cpr C D $ by cpr_intro_l_c [l12]
l14: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D ⇒ z = cpr C D $ by ax
l15: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D ⇒ cpr C D = z $ by eq_sym [l14]
l16: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D ⇒ C ∈ z $ by wcel_eq_r [l15, l13]
l17: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D ⇒ z = csn A $ by ax
l18: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D ⇒ C ∈ csn A $ by wcel_eq_r [l17, l16]
l19: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D , y = C , y ∊ csn A ⇒ y ∊ csn A $ by ax
l20: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D , y = C , y ∊ csn A ⇒ y = A $ by csn_elim [l19]
l21: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D , y = C , y ∊ csn A ⇒ y = C $ by ax
l22: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D , y = C , y ∊ csn A ⇒ C = y $ by eq_sym [l21]
l23: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D , y = C , y ∊ csn A ⇒ C = A $ by eq_trans [l22, l20]
l24: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D , y = C , y ∊ csn A ⇒ A = C $ by eq_sym [l23]
l25: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) , z = cpr C D ⇒ A = C $ by wcel_elim [l18, l24]
l26: $ G , z = csn A , z ∊ cpr (csn C) (cpr C D) ⇒ A = C $ by or_elim [l5, l11, l25]
l27: $ G ⇒ A = C $ by wcel_elim [l3, l26]

--| Nodes with distinct labels (one an element of the other) differ.
lemma y2_ne (G: hyps) (a: set) (K1 K2 L1 L2: class):
  $ G ⇒ a = ⟨ K1 , L1 ⟩ $ > $ G ⇒ a = ⟨ K2 , L2 ⟩ $ > $ G ⇒ K1 ∈ K2 $ > $ G ⇒ isset K2 $ > $ G ⇒ ⊥ $
----
l1: $ G ⇒ ⟨ K1 , L1 ⟩ = a $ by eq_sym [#1]
l2: $ G ⇒ ⟨ K1 , L1 ⟩ = ⟨ K2 , L2 ⟩ $ by eq_trans [l1, #2]
l3: $ G ⇒ isset K1 $ by wcel_isset [#3]
l4: $ G ⇒ K1 = K2 $ by y2_op_fst [l3, #4, l2]
l5: $ G ⇒ K2 ∈ K2 $ by wcel_eq_l [l4, #3]
l6: $ G ⇒ ⊥ $ by notin_self_c [l5]

--| Injectivity of a node (or an atom) with 1 children.
lemma y2_nd1 (G: hyps) (K A1 B1: class):
  $ G ⇒ ⟨ K , scons A1 ∅ ⟩ = ⟨ K , scons B1 ∅ ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset A1 $ > $ G ⇒ isset B1 $ > $ G ⇒ A1 = B1 $
----
l1: $ G ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l2: $ G ⇒ scons A1 ∅ ∈ fseq y2_V $ by y2_fs [#3, l1]
l3: $ G ⇒ scons B1 ∅ ∈ fseq y2_V $ by y2_fs [#4, l1]
l4: $ G ⇒ isset (scons A1 ∅) $ by y2_fs_set [l2]
l5: $ G ⇒ isset (scons B1 ∅) $ by y2_fs_set [l3]
l6: $ G ⇒ K = K ∧ scons A1 ∅ = scons B1 ∅ $ by opair_inj_c [#1, #2, l4, #2, l5]
l7: $ G ⇒ scons A1 ∅ = scons B1 ∅ $ by and_elim_r [l6]
l8: $ G ⇒ A1 = B1 ∧ ∅ = ∅ $ by y2_sc_inj [#3, #4, l1, l1, l7]
l9: $ G ⇒ A1 = B1 $ by and_elim_l [l8]

--| Injectivity of a node (or an atom) with 2 children.
lemma y2_nd2 (G: hyps) (K A1 A2 B1 B2: class):
  $ G ⇒ ⟨ K , scons A1 (scons A2 ∅) ⟩ = ⟨ K , scons B1 (scons B2 ∅) ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset A1 $ > $ G ⇒ isset A2 $ > $ G ⇒ isset B1 $ > $ G ⇒ isset B2 $ > $ G ⇒ A1 = B1 ∧ A2 = B2 $
----
l1: $ G ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l2: $ G ⇒ scons A2 ∅ ∈ fseq y2_V $ by y2_fs [#4, l1]
l3: $ G ⇒ scons B2 ∅ ∈ fseq y2_V $ by y2_fs [#6, l1]
l4: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq y2_V $ by y2_fs [#3, l2]
l5: $ G ⇒ scons B1 (scons B2 ∅) ∈ fseq y2_V $ by y2_fs [#5, l3]
l6: $ G ⇒ isset (scons A1 (scons A2 ∅)) $ by y2_fs_set [l4]
l7: $ G ⇒ isset (scons B1 (scons B2 ∅)) $ by y2_fs_set [l5]
l8: $ G ⇒ K = K ∧ scons A1 (scons A2 ∅) = scons B1 (scons B2 ∅) $ by opair_inj_c [#1, #2, l6, #2, l7]
l9: $ G ⇒ scons A1 (scons A2 ∅) = scons B1 (scons B2 ∅) $ by and_elim_r [l8]
l10: $ G ⇒ A1 = B1 ∧ scons A2 ∅ = scons B2 ∅ $ by y2_sc_inj [#3, #5, l2, l3, l9]
l11: $ G ⇒ A1 = B1 $ by and_elim_l [l10]
l12: $ G ⇒ scons A2 ∅ = scons B2 ∅ $ by and_elim_r [l10]
l13: $ G ⇒ A2 = B2 ∧ ∅ = ∅ $ by y2_sc_inj [#4, #6, l1, l1, l12]
l14: $ G ⇒ A2 = B2 $ by and_elim_l [l13]
l15: $ G ⇒ A1 = B1 ∧ A2 = B2 $ by and_intro [l11, l14]

--| Injectivity of a node (or an atom) with 3 children.
lemma y2_nd3 (G: hyps) (K A1 A2 A3 B1 B2 B3: class):
  $ G ⇒ ⟨ K , scons A1 (scons A2 (scons A3 ∅)) ⟩ = ⟨ K , scons B1 (scons B2 (scons B3 ∅)) ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset A1 $ > $ G ⇒ isset A2 $ > $ G ⇒ isset A3 $ > $ G ⇒ isset B1 $ > $ G ⇒ isset B2 $ > $ G ⇒ isset B3 $ > $ G ⇒ A1 = B1 ∧ A2 = B2 ∧ A3 = B3 $
----
l1: $ G ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l2: $ G ⇒ scons A3 ∅ ∈ fseq y2_V $ by y2_fs [#5, l1]
l3: $ G ⇒ scons B3 ∅ ∈ fseq y2_V $ by y2_fs [#8, l1]
l4: $ G ⇒ scons A2 (scons A3 ∅) ∈ fseq y2_V $ by y2_fs [#4, l2]
l5: $ G ⇒ scons B2 (scons B3 ∅) ∈ fseq y2_V $ by y2_fs [#7, l3]
l6: $ G ⇒ scons A1 (scons A2 (scons A3 ∅)) ∈ fseq y2_V $ by y2_fs [#3, l4]
l7: $ G ⇒ scons B1 (scons B2 (scons B3 ∅)) ∈ fseq y2_V $ by y2_fs [#6, l5]
l8: $ G ⇒ isset (scons A1 (scons A2 (scons A3 ∅))) $ by y2_fs_set [l6]
l9: $ G ⇒ isset (scons B1 (scons B2 (scons B3 ∅))) $ by y2_fs_set [l7]
l10: $ G ⇒ K = K ∧ scons A1 (scons A2 (scons A3 ∅)) = scons B1 (scons B2 (scons B3 ∅)) $ by opair_inj_c [#1, #2, l8, #2, l9]
l11: $ G ⇒ scons A1 (scons A2 (scons A3 ∅)) = scons B1 (scons B2 (scons B3 ∅)) $ by and_elim_r [l10]
l12: $ G ⇒ A1 = B1 ∧ scons A2 (scons A3 ∅) = scons B2 (scons B3 ∅) $ by y2_sc_inj [#3, #6, l4, l5, l11]
l13: $ G ⇒ A1 = B1 $ by and_elim_l [l12]
l14: $ G ⇒ scons A2 (scons A3 ∅) = scons B2 (scons B3 ∅) $ by and_elim_r [l12]
l15: $ G ⇒ A2 = B2 ∧ scons A3 ∅ = scons B3 ∅ $ by y2_sc_inj [#4, #7, l2, l3, l14]
l16: $ G ⇒ A2 = B2 $ by and_elim_l [l15]
l17: $ G ⇒ scons A3 ∅ = scons B3 ∅ $ by and_elim_r [l15]
l18: $ G ⇒ A3 = B3 ∧ ∅ = ∅ $ by y2_sc_inj [#5, #8, l1, l1, l17]
l19: $ G ⇒ A3 = B3 $ by and_elim_l [l18]
l20: $ G ⇒ A2 = B2 ∧ A3 = B3 $ by and_intro [l16, l19]
l21: $ G ⇒ A1 = B1 ∧ A2 = B2 ∧ A3 = B3 $ by and_intro [l13, l20]

--| Injectivity of a node (or an atom) with 4 children.
lemma y2_nd4 (G: hyps) (K A1 A2 A3 A4 B1 B2 B3 B4: class):
  $ G ⇒ ⟨ K , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩ = ⟨ K , scons B1 (scons B2 (scons B3 (scons B4 ∅))) ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset A1 $ > $ G ⇒ isset A2 $ > $ G ⇒ isset A3 $ > $ G ⇒ isset A4 $ > $ G ⇒ isset B1 $ > $ G ⇒ isset B2 $ > $ G ⇒ isset B3 $ > $ G ⇒ isset B4 $ > $ G ⇒ A1 = B1 ∧ A2 = B2 ∧ A3 = B3 ∧ A4 = B4 $
----
