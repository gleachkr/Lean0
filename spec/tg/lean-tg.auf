l63: $ G ⇒ t7 = ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ $ by and_elim_l [l62]
l64: $ G ⇒ crn pp = crn (scons (ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8) ∅) $ by crn_eq [l7]
l65: $ G ⇒ crn (scons (ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8) ∅) ⊆ lrel $ by subset_eq_l [l64, #2]
l66: $ G ⇒ isset (ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8) $ by opair_isset
l67: $ G ⇒ ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8 ∈ lrel $ by crn_scons_head [l66, l65]
l68: $ G ⇒ t7 = ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∧ ra_mty V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 V7 V8 ∈ lrel $ by and_intro [l63, l67]
