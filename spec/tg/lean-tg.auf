l28: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
