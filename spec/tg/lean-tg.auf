l4: $ G , x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ kr_lift ∈ ω $ by x1_kr_lift
l5: $ G , x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
