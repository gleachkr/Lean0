lemma y1_p_minors (G: hyps): $ G ⇒ pr_minors ⊆ y1_lab kr_minors (suc kr_minors) $
----
l1: $ G ⇒ cl_minors_cons ⊆ y1_lab kr_minors (suc kr_minors) $ by y1_k_minors_cons
l2: $ G ⇒ cl_minors_nil ⊆ y1_lab kr_minors (suc kr_minors) $ by y1_k_minors_nil
l3: $ G ⇒ pr_minors ⊆ y1_lab kr_minors (suc kr_minors) $ by cun_least [l2, l1]

lemma y1_k_rtail_pi (G: hyps): $ G ⇒ cl_rtail_pi ⊆ y1_lab kr_rtail (suc kr_rtail) $
----
l1: $ G , x ∊ cl_rtail_pi ⇒ x ∊ cl_rtail_pi $ by ax
l2: $ G , x ∊ cl_rtail_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ ⇒ kr_rtail ∈ ω $ by x1_kr_rtail
l5: $ G , x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_rtail (suc kr_rtail) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rtail (suc kr_rtail) $ by ex_elim [l6, l5]
l8: $ G , ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rtail (suc kr_rtail) $ by ex_elim [l8, l7]
l10: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rtail (suc kr_rtail) $ by ex_elim [l10, l9]
l12: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) $ by ax
