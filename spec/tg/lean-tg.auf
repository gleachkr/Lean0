l6: $ G ⇒ pp = scons (ra_bsucc V1 V2) ∅ ∧ ra_baddc t1 t2 t3 = ra_baddc V1 ⟨ kc_b0 , ∅ ⟩ V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_bsucc V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_baddc t1 t2 t3 = ra_baddc V1 ⟨ kc_b0 , ∅ ⟩ V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
