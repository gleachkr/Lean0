l10: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l22: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l24: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l23, l22]
l25: $ G , x = ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ , x ∊ cl_aux_of_i ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by ex_elim [l2, l24]
l26: $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by wcel_elim [#1, l25]

lemma y1_o_aux_of (G: hyps) {D N j_v np n_v m_v n0 k_v X: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_aux_of t1 t2 t3 t4 ⟩ ∈ pr_aux_of $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ k_v ∃ X (t1 = D ∧ t2 = N ∧ t3 = j_v ∧ t4 = X ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_add n0 k_v j_v ∈ lrel ∧ ra_cnth N k_v X ∈ lrel) $ by y1_d_aux_of_i [#1, #2]

lemma y1_e_pis_nil (G: hyps) {b_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ V1 V1 ⟩ = ⟨ pp , ra_pis t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_pis t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_pis ⟨ kc_nil , ∅ ⟩ V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_pis t1 t2 t3 = ra_pis ⟨ kc_nil , ∅ ⟩ V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_pis t1 t2 t3 = ra_pis ⟨ kc_nil , ∅ ⟩ V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_pis ∈ ω $ by x1_kr_pis
l22: $ G ⇒ isset kr_pis $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_pis = kr_pis ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_intro [l36]

lemma y1_d_pis_nil (G: hyps) {b_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x ∊ cl_pis_nil ⇒ x ∊ cl_pis_nil $ by ax
l2: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x ∊ cl_pis_nil ⇒ ∃ y (x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ pp , ra_pis t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by y1_e_pis_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x ∊ cl_pis_nil ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by wcel_elim [#1, l9]

lemma y1_e_pis_cons (G: hyps) {A b_v T P: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ = ⟨ scons (ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3) ∅ , ra_pis ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3) ∅ , ra_pis ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3 ⟩ = ⟨ pp , ra_pis t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_pis t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_pis ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3) ∅ ∧ ra_pis t1 t2 t3 = ra_pis ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_pis t1 t2 t3 = ra_pis ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V3 $ by isset_var
l17: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V2 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_pis ∈ ω $ by x1_kr_pis
l23: $ G ⇒ isset kr_pis $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V2 (scons V3 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_pis = kr_pis ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V2 (scons V3 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V2 (scons V3 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ scons t3 ∅ = scons V3 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V3 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V3 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3) $ by opair_isset
l39: $ G ⇒ ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V3 ∧ ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ t2 = V2 ∧ t3 = V3 ∧ ra_pis V4 ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ P (t1 = ⟨ kc_cons , scons V1 (scons P ∅) ⟩ ∧ t2 = V2 ∧ t3 = V3 ∧ ra_pis P ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ T ∃ P (t1 = ⟨ kc_cons , scons V1 (scons P ∅) ⟩ ∧ t2 = V2 ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ T ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons V1 (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons V1 (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_intro [l45]

lemma y1_d_pis_cons (G: hyps) {A b_v T P: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x ∊ cl_pis_cons ⇒ x ∊ cl_pis_cons $ by ax
l2: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x ∊ cl_pis_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ x = ⟨ pp , ra_pis t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by y1_e_pis_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_pis t1 t2 t3 ⟩ , x ∊ cl_pis_cons ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_pis (G: hyps) {b_v A T P: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ pr_pis $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons $ by ax
l2: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by y1_d_pis_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons → ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons $ by ax
l6: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∨ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil $ by ax
l8: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by y1_d_pis_nil [l7, l8]
l10: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons $ by ax
l12: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons → ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_cons ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_pis t1 t2 t3 ⟩ ∈ cl_pis_nil ∪ cl_pis_cons → ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_pis P ⟨ kc_pi , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_lams_nil (G: hyps) {b_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ V1 V1 ⟩ = ⟨ pp , ra_lams t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lams t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_lams ⟨ kc_nil , ∅ ⟩ V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_lams t1 t2 t3 = ra_lams ⟨ kc_nil , ∅ ⟩ V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lams t1 t2 t3 = ra_lams ⟨ kc_nil , ∅ ⟩ V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_lams ∈ ω $ by x1_kr_lams
l22: $ G ⇒ isset kr_lams $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_lams = kr_lams ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_intro [l36]

lemma y1_d_lams_nil (G: hyps) {b_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x ∊ cl_lams_nil ⇒ x ∊ cl_lams_nil $ by ax
l2: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x ∊ cl_lams_nil ⇒ ∃ y (x = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ pp , ra_lams t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lams ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by y1_e_lams_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x ∊ cl_lams_nil ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by wcel_elim [#1, l9]

lemma y1_e_lams_cons (G: hyps) {A b_v T P: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ = ⟨ scons (ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3) ∅ , ra_lams ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3) ∅ , ra_lams ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3 ⟩ = ⟨ pp , ra_lams t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lams t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_lams ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3) ∅ ∧ ra_lams t1 t2 t3 = ra_lams ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lams t1 t2 t3 = ra_lams ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V2 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V3 $ by isset_var
l17: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V2 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_lams ∈ ω $ by x1_kr_lams
l23: $ G ⇒ isset kr_lams $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V2 (scons V3 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_lams = kr_lams ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V2 (scons V3 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V2 (scons V3 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ scons t3 ∅ = scons V3 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V3 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V3 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3) $ by opair_isset
l39: $ G ⇒ ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V3 ∧ ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ t2 = V2 ∧ t3 = V3 ∧ ra_lams V4 ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ P (t1 = ⟨ kc_cons , scons V1 (scons P ∅) ⟩ ∧ t2 = V2 ∧ t3 = V3 ∧ ra_lams P ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ V3 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ T ∃ P (t1 = ⟨ kc_cons , scons V1 (scons P ∅) ⟩ ∧ t2 = V2 ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ T ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons V1 (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons V1 (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_intro [l45]

lemma y1_d_lams_cons (G: hyps) {A b_v T P: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x ∊ cl_lams_cons ⇒ x ∊ cl_lams_cons $ by ax
l2: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x ∊ cl_lams_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ x = ⟨ pp , ra_lams t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by y1_e_lams_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lams v ⟨ kc_lam , scons y (scons z ∅) ⟩ u) ∅ , ra_lams ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lams t1 t2 t3 ⟩ , x ∊ cl_lams_cons ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_lams (G: hyps) {b_v A T P: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ pr_lams $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons $ by ax
l2: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by y1_d_lams_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons → ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons $ by ax
l6: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∨ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil $ by ax
l8: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by y1_d_lams_nil [l7, l8]
l10: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons $ by ax
l12: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons → ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons ⇒ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_cons ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_lams t1 t2 t3 ⟩ ∈ cl_lams_nil ∪ cl_lams_cons → ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ b_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ A ∃ b_v ∃ T ∃ P (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = b_v ∧ t3 = T ∧ ra_lams P ⟨ kc_lam , scons A (scons b_v ∅) ⟩ T ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_tys_closed_nil (G: hyps) {P: set} (pp t1 t2 V1: set):
  $ G ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ = ⟨ ∅ , ra_tys_closed V1 ⟨ kc_tnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_tys_closed V1 ⟨ kc_tnil , ∅ ⟩ ⟩ = ⟨ pp , ra_tys_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_tys_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_tys_closed V1 ⟨ kc_tnil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_tys_closed t1 t2 = ra_tys_closed V1 ⟨ kc_tnil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_tys_closed t1 t2 = ra_tys_closed V1 ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_tnil , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_tnil , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_tnil , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_tys_closed ∈ ω $ by x1_kr_tys_closed
l19: $ G ⇒ isset kr_tys_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_tnil , ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_tys_closed = kr_tys_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_tnil , ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_tnil , ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_tnil , ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_tnil , ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_tnil , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_tnil , ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by ex_intro [l29]

lemma y1_d_tys_closed_nil (G: hyps) {P: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x ∊ cl_tys_closed_nil ⇒ x ∊ cl_tys_closed_nil $ by ax
l2: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x ∊ cl_tys_closed_nil ⇒ ∃ y (x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_tys_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_tys_closed y ⟨ kc_tnil , ∅ ⟩ ⟩ ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by y1_e_tys_closed_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x ∊ cl_tys_closed_nil ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_tys_closed_cons (G: hyps) {P F R C T: set} (pp t1 t2 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ = ⟨ scons (ra_pis V1 V2 V3) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ V3) (scons (ra_tys_closed V1 V5) ∅)) , ra_tys_closed V1 ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_pis V1 V2 V3) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ V3) (scons (ra_tys_closed V1 V5) ∅)) , ra_tys_closed V1 ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ⟩ = ⟨ pp , ra_tys_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_pis V1 V2 V3) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ V3) (scons (ra_tys_closed V1 V5) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_tys_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_tys_closed V1 ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_pis V1 V2 V3) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ V3) (scons (ra_tys_closed V1 V5) ∅)) ∧ ra_tys_closed t1 t2 = ra_tys_closed V1 ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_pis V1 V2 V3) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ V3) (scons (ra_tys_closed V1 V5) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_tys_closed t1 t2 = ra_tys_closed V1 ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_tys_closed ∈ ω $ by x1_kr_tys_closed
l19: $ G ⇒ isset kr_tys_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_tys_closed = kr_tys_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_pis V1 V2 V3) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ V3) (scons (ra_tys_closed V1 V5) ∅))) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_pis V1 V2 V3) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ V3) (scons (ra_tys_closed V1 V5) ∅))) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_pis V1 V2 V3) $ by opair_isset
l32: $ G ⇒ ra_pis V1 V2 V3 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_closed ⟨ kc_nz , ∅ ⟩ V3) (scons (ra_tys_closed V1 V5) ∅)) ⊆ lrel $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_closed ⟨ kc_nz , ∅ ⟩ V3) $ by opair_isset
l35: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel $ by crn_scons_head [l34, l33]
l36: $ G ⇒ crn (scons (ra_tys_closed V1 V5) ∅) ⊆ lrel $ by crn_scons_tail [l33]
l37: $ G ⇒ isset (ra_tys_closed V1 V5) $ by opair_isset
l38: $ G ⇒ ra_tys_closed V1 V5 ∈ lrel $ by crn_scons_head [l37, l36]
l39: $ G ⇒ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_tys_closed V1 V5 ∈ lrel $ by and_intro [l35, l38]
l40: $ G ⇒ ra_pis V1 V2 V3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_tys_closed V1 V5 ∈ lrel $ by and_intro [l32, l39]
l41: $ G ⇒ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∧ ra_pis V1 V2 V3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_tys_closed V1 V5 ∈ lrel $ by and_intro [l28, l40]
l42: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∧ ra_pis V1 V2 V3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_tys_closed V1 V5 ∈ lrel $ by and_intro [l25, l41]
l43: $ G ⇒ ∃ T (t1 = V1 ∧ t2 = ⟨ kc_tcons , scons V2 (scons V4 (scons T ∅)) ⟩ ∧ ra_pis V1 V2 V3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_tys_closed V1 T ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ C ∃ T (t1 = V1 ∧ t2 = ⟨ kc_tcons , scons V2 (scons C (scons T ∅)) ⟩ ∧ ra_pis V1 V2 V3 ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ V3 ∈ lrel ∧ ra_tys_closed V1 T ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ R ∃ C ∃ T (t1 = V1 ∧ t2 = ⟨ kc_tcons , scons V2 (scons C (scons T ∅)) ⟩ ∧ ra_pis V1 V2 R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed V1 T ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ F ∃ R ∃ C ∃ T (t1 = V1 ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis V1 F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed V1 T ∈ lrel) $ by ex_intro [l45]
l47: $ G ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by ex_intro [l46]

lemma y1_d_tys_closed_cons (G: hyps) {P F R C T: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x ∊ cl_tys_closed_cons ⇒ x ∊ cl_tys_closed_cons $ by ax
l2: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x ∊ cl_tys_closed_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_tys_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩ ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by y1_e_tys_closed_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_pis y z u) (scons (ra_closed ⟨ kc_nz , ∅ ⟩ u) (scons (ra_tys_closed y w) ∅)) , ra_tys_closed y ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟩) ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_tys_closed t1 t2 ⟩ , x ∊ cl_tys_closed_cons ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by wcel_elim [#1, l17]

lemma y1_o_tys_closed (G: hyps) {P F R C T: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ pr_tys_closed $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons $ by ax
l2: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by y1_d_tys_closed_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons → ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons $ by ax
l6: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∨ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil $ by ax
l8: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) $ by y1_d_tys_closed_nil [l7, l8]
l10: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons $ by ax
l12: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons → ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons ⇒ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_cons ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_tys_closed t1 t2 ⟩ ∈ cl_tys_closed_nil ∪ cl_tys_closed_cons → ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ P (t1 = P ∧ t2 = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ P ∃ F ∃ R ∃ C ∃ T (t1 = P ∧ t2 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ ra_pis P F R ∈ lrel ∧ ra_closed ⟨ kc_nz , ∅ ⟩ R ∈ lrel ∧ ra_tys_closed P T ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_pargs_z (G: hyps) {X d_v: set} (pp t1 t2 t3 t4 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_pargs V1 V2 ⟨ kc_nz , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) $
----
l1: $ G ⇒ ⟨ ∅ , ra_pargs V1 V2 ⟨ kc_nz , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_pargs t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_pargs V1 V2 ⟨ kc_nz , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_pargs t1 t2 t3 t4 = ra_pargs V1 V2 ⟨ kc_nz , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_pargs t1 t2 t3 t4 = ra_pargs V1 V2 ⟨ kc_nz , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V1 $ by isset_var
l19: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) ∈ fseq y1_vv $ by y1_fs [l18, l23]
l25: $ G ⇒ kr_pargs ∈ ω $ by x1_kr_pargs
l26: $ G ⇒ isset kr_pargs $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_pargs = kr_pargs ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by y1_scons_inj [l30, l16, l18, l15, l23]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l33, l14, l22, l13, l21]
l35: $ G ⇒ t2 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ scons t4 ∅ = scons V1 ∅ $ by y1_scons_inj [l36, l12, l20, l11, l19]
l38: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V1 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V1 $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V1 $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V1 $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ d_v (t1 = V1 ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V1) $ by ex_intro [l44]
l46: $ G ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) $ by ex_intro [l45]

lemma y1_d_pargs_z (G: hyps) {X d_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) $
----
l1: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x ∊ cl_pargs_z ⇒ x ∊ cl_pargs_z $ by ax
l2: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x ∊ cl_pargs_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) $ by y1_e_pargs_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x ∊ cl_pargs_z ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) $ by wcel_elim [#1, l11]

lemma y1_e_pargs_s (G: hyps) {X e_v d_v n_v: set} (pp t1 t2 t3 t4 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ = ⟨ scons (ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2) ∅ , ra_pargs V1 V3 ⟨ kc_s , scons V4 ∅ ⟩ ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2) ∅ , ra_pargs V1 V3 ⟨ kc_s , scons V4 ∅ ⟩ ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ⟩ = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_pargs t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_pargs V1 V3 ⟨ kc_s , scons V4 ∅ ⟩ ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2) ∅ ∧ ra_pargs t1 t2 t3 t4 = ra_pargs V1 V3 ⟨ kc_s , scons V4 ∅ ⟩ ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_pargs t1 t2 t3 t4 = ra_pargs V1 V3 ⟨ kc_s , scons V4 ∅ ⟩ ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V3 $ by isset_var
l23: $ G ⇒ scons V3 (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V3 (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_pargs ∈ ω $ by x1_kr_pargs
l27: $ G ⇒ isset kr_pargs $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V3 (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_pargs = kr_pargs ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V3 (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V3 (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V3 (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V3 (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V3 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V3 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ scons t4 ∅ = scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2) ∅) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2) ∅) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2) $ by opair_isset
l46: $ G ⇒ ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ t4 = ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∧ ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2 ∈ lrel $ by and_intro [l42, l46]
l48: $ G ⇒ t3 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∧ ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2 ∈ lrel $ by and_intro [l39, l47]
l49: $ G ⇒ t2 = V3 ∧ t3 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∧ ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2 ∈ lrel $ by and_intro [l36, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = V3 ∧ t3 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∧ ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ V4 V2 ∈ lrel $ by and_intro [l33, l49]
l51: $ G ⇒ ∃ n_v (t1 = V1 ∧ t2 = V3 ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ⟩ ∧ ra_pargs V1 ⟨ kc_s , scons V3 ∅ ⟩ n_v V2 ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ d_v ∃ n_v (t1 = V1 ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V2 (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs V1 ⟨ kc_s , scons d_v ∅ ⟩ n_v V2 ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ e_v ∃ d_v ∃ n_v (t1 = V1 ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs V1 ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by ex_intro [l53]

lemma y1_d_pargs_s (G: hyps) {X e_v d_v n_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x ∊ cl_pargs_s ⇒ x ∊ cl_pargs_s $ by ax
l2: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x ∊ cl_pargs_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by y1_e_pargs_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ , x ∊ cl_pargs_s ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_pargs (G: hyps) {X d_v e_v n_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ pr_pargs $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) ∨ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s $ by ax
l2: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by y1_d_pargs_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s → ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s $ by ax
l6: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∨ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z $ by ax
l8: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) $ by y1_d_pargs_z [l7, l8]
l10: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) ∨ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s $ by ax
l12: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s → ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s ⇒ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_s ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) ∨ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) ∨ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_pargs t1 t2 t3 t4 ⟩ ∈ cl_pargs_z ∪ cl_pargs_s → ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) ∨ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ X ∃ d_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = X) ∨ ∃ X ∃ e_v ∃ d_v ∃ n_v (t1 = X ∧ t2 = d_v ∧ t3 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons ⟨ kc_bvar , scons d_v ∅ ⟩ ∅) ⟩ ∧ ra_pargs X ⟨ kc_s , scons d_v ∅ ⟩ n_v e_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_spine_z (G: hyps) {h_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ = ⟨ ∅ , ra_spine V1 V1 ⟨ kc_nz , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_spine V1 V1 ⟨ kc_nz , ∅ ⟩ ⟩ = ⟨ pp , ra_spine t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_spine t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_spine V1 V1 ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_spine t1 t2 t3 = ra_spine V1 V1 ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_spine t1 t2 t3 = ra_spine V1 V1 ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V1 $ by isset_var
l19: $ G ⇒ scons V1 (scons ⟨ kc_nz , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ scons V1 (scons V1 (scons ⟨ kc_nz , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ kr_spine ∈ ω $ by x1_kr_spine
l22: $ G ⇒ isset kr_spine $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons V1 (scons V1 (scons ⟨ kc_nz , ∅ ⟩ ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_spine = kr_spine ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V1 (scons ⟨ kc_nz , ∅ ⟩ ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V1 (scons ⟨ kc_nz , ∅ ⟩ ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons V1 (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by y1_scons_inj [l26, l14, l18, l13, l19]
l28: $ G ⇒ t1 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by y1_scons_inj [l29, l12, l18, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = V1 ∧ t2 = V1 ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by ex_intro [l36]

lemma y1_d_spine_z (G: hyps) {h_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x ∊ cl_spine_z ⇒ x ∊ cl_spine_z $ by ax
l2: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x ∊ cl_spine_z ⇒ ∃ y (x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_spine t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by y1_e_spine_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x ∊ cl_spine_z ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_spine_s (G: hyps) {h_v e_v a_v k_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ = ⟨ scons (ra_spine V1 V2 V4) ∅ , ra_spine V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_spine V1 V2 V4) ∅ , ra_spine V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ ⟩ = ⟨ pp , ra_spine t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_spine V1 V2 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_spine t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_spine V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_spine V1 V2 V4) ∅ ∧ ra_spine t1 t2 t3 = ra_spine V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_spine V1 V2 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_spine t1 t2 t3 = ra_spine V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_s , scons V4 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_spine ∈ ω $ by x1_kr_spine
l23: $ G ⇒ isset kr_spine $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_spine = kr_spine ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 ∅ = scons ⟨ kc_s , scons V4 ∅ ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_s , scons V4 ∅ ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_spine V1 V2 V4) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_spine V1 V2 V4) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_spine V1 V2 V4) $ by opair_isset
l39: $ G ⇒ ra_spine V1 V2 V4 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ ra_spine V1 V2 V4 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ ra_spine V1 V2 V4 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ ra_spine V1 V2 V4 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ k_v (t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine V1 V2 k_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ a_v ∃ k_v (t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine V1 V2 k_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ e_v ∃ a_v ∃ k_v (t1 = V1 ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine V1 e_v k_v ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by ex_intro [l45]

lemma y1_d_spine_s (G: hyps) {h_v e_v a_v k_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x ∊ cl_spine_s ⇒ x ∊ cl_spine_s $ by ax
l2: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x ∊ cl_spine_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_spine t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by y1_e_spine_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_spine t1 t2 t3 ⟩ , x ∊ cl_spine_s ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_spine (G: hyps) {h_v e_v a_v k_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ pr_spine $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s $ by ax
l2: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by y1_d_spine_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s → ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s $ by ax
l6: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∨ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z $ by ax
l8: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by y1_d_spine_z [l7, l8]
l10: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s $ by ax
l12: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s → ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s ⇒ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_s ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_spine t1 t2 t3 ⟩ ∈ cl_spine_z ∪ cl_spine_s → ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ h_v (t1 = h_v ∧ t2 = h_v ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ h_v ∃ e_v ∃ a_v ∃ k_v (t1 = h_v ∧ t2 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ ra_spine h_v e_v k_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_rehead_z (G: hyps) {Y X: set} (pp t1 t2 t3 t4 t5 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_rehead V1 V2 ⟨ kc_nz , ∅ ⟩ V1 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) $
----
l1: $ G ⇒ ⟨ ∅ , ra_rehead V1 V2 ⟨ kc_nz , ∅ ⟩ V1 V2 ⟩ = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rehead t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_rehead V1 V2 ⟨ kc_nz , ∅ ⟩ V1 V2) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_rehead t1 t2 t3 t4 t5 = ra_rehead V1 V2 ⟨ kc_nz , ∅ ⟩ V1 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_rehead t1 t2 t3 t4 t5 = ra_rehead V1 V2 ⟨ kc_nz , ∅ ⟩ V1 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V2 $ by isset_var
l21: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset V1 $ by isset_var
l23: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅))) ∈ fseq y1_vv $ by y1_fs [l20, l25]
l27: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)))) ∈ fseq y1_vv $ by y1_fs [l22, l26]
l28: $ G ⇒ kr_rehead ∈ ω $ by x1_kr_rehead
l29: $ G ⇒ isset kr_rehead $ by wcel_isset [l28]
l30: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l31: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅))))) $ by wcel_isset [l27]
l32: $ G ⇒ kr_rehead = kr_rehead ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)))) $ by opair_inj_c [l8, l29, l30, l29, l31]
l33: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)))) $ by and_elim_r [l32]
l34: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅))) $ by y1_scons_inj [l33, l18, l22, l17, l26]
l35: $ G ⇒ t1 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅))) $ by and_elim_r [l34]
l37: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)) $ by y1_scons_inj [l36, l16, l20, l15, l25]
l38: $ G ⇒ t2 = V2 $ by and_elim_l [l37]
l39: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)) $ by and_elim_r [l37]
l40: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ scons t4 (scons t5 ∅) = scons V1 (scons V2 ∅) $ by y1_scons_inj [l39, l14, l24, l13, l23]
l41: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ scons t4 (scons t5 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l40]
l43: $ G ⇒ t4 = V1 ∧ scons t5 ∅ = scons V2 ∅ $ by y1_scons_inj [l42, l12, l22, l11, l21]
l44: $ G ⇒ t4 = V1 $ by and_elim_l [l43]
l45: $ G ⇒ scons t5 ∅ = scons V2 ∅ $ by and_elim_r [l43]
l46: $ G ⇒ t5 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l45, l10, l20, l9, l9]
l47: $ G ⇒ t5 = V2 $ by and_elim_l [l46]
l48: $ G ⇒ t4 = V1 ∧ t5 = V2 $ by and_intro [l44, l47]
l49: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V1 ∧ t5 = V2 $ by and_intro [l41, l48]
l50: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V1 ∧ t5 = V2 $ by and_intro [l38, l49]
l51: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V1 ∧ t5 = V2 $ by and_intro [l35, l50]
l52: $ G ⇒ ∃ X (t1 = V1 ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V1 ∧ t5 = X) $ by ex_intro [l51]
l53: $ G ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) $ by ex_intro [l52]

lemma y1_d_rehead_z (G: hyps) {Y X: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) $
----
l1: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x ∊ cl_rehead_z ⇒ x ∊ cl_rehead_z $ by ax
l2: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x ∊ cl_rehead_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) $ by y1_e_rehead_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ z (x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ z (x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩) ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x ∊ cl_rehead_z ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) $ by wcel_elim [#1, l11]

lemma y1_e_rehead_s (G: hyps) {Y X e_v e2 a_v k_v: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_rehead V1 V2 V6 V3 V4) ∅ , ra_rehead V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_rehead V1 V2 V6 V3 V4) ∅ , ra_rehead V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟩ = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_rehead V1 V2 V6 V3 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rehead t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_rehead V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ⟨ kc_app , scons V4 (scons V5 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_rehead V1 V2 V6 V3 V4) ∅ ∧ ra_rehead t1 t2 t3 t4 t5 = ra_rehead V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_rehead V1 V2 V6 V3 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_rehead t1 t2 t3 t4 t5 = ra_rehead V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset ⟨ kc_s , scons V6 ∅ ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V2 $ by isset_var
l27: $ G ⇒ scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V1 $ by isset_var
l29: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ kr_rehead ∈ ω $ by x1_kr_rehead
l31: $ G ⇒ isset kr_rehead $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_rehead = kr_rehead ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_s , scons V6 ∅ ⟩ (scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ scons t4 (scons t5 ∅) = scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
l43: $ G ⇒ t3 = ⟨ kc_s , scons V6 ∅ ⟩ $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ∧ scons t5 ∅ = scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅ $ by y1_scons_inj [l44, l12, l22, l11, l21]
l46: $ G ⇒ t4 = ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l47, l10, l20, l9, l9]
l49: $ G ⇒ t5 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by and_elim_l [l48]
l50: $ G ⇒ crn pp = crn (scons (ra_rehead V1 V2 V6 V3 V4) ∅) $ by crn_eq [l7]
l51: $ G ⇒ crn (scons (ra_rehead V1 V2 V6 V3 V4) ∅) ⊆ lrel $ by subset_eq_l [l50, #2]
l52: $ G ⇒ isset (ra_rehead V1 V2 V6 V3 V4) $ by opair_isset
l53: $ G ⇒ ra_rehead V1 V2 V6 V3 V4 ∈ lrel $ by crn_scons_head [l52, l51]
l54: $ G ⇒ t5 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_rehead V1 V2 V6 V3 V4 ∈ lrel $ by and_intro [l49, l53]
l55: $ G ⇒ t4 = ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_rehead V1 V2 V6 V3 V4 ∈ lrel $ by and_intro [l46, l54]
l56: $ G ⇒ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_rehead V1 V2 V6 V3 V4 ∈ lrel $ by and_intro [l43, l55]
l57: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_rehead V1 V2 V6 V3 V4 ∈ lrel $ by and_intro [l40, l56]
l58: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_rehead V1 V2 V6 V3 V4 ∈ lrel $ by and_intro [l37, l57]
l59: $ G ⇒ ∃ k_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V3 (scons V5 ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_rehead V1 V2 k_v V3 V4 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ a_v ∃ k_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V3 (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons V4 (scons a_v ∅) ⟩ ∧ ra_rehead V1 V2 k_v V3 V4 ∈ lrel) $ by ex_intro [l59]
l61: $ G ⇒ ∃ e2 ∃ a_v ∃ k_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons V3 (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead V1 V2 k_v V3 e2 ∈ lrel) $ by ex_intro [l60]
l62: $ G ⇒ ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead V1 V2 k_v e_v e2 ∈ lrel) $ by ex_intro [l61]
l63: $ G ⇒ ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = V1 ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead V1 X k_v e_v e2 ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by ex_intro [l63]

lemma y1_d_rehead_s (G: hyps) {Y X e_v e2 a_v k_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x ∊ cl_rehead_s ⇒ x ∊ cl_rehead_s $ by ax
l2: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x ∊ cl_rehead_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by y1_e_rehead_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ , x ∊ cl_rehead_s ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_o_rehead (G: hyps) {Y X e_v e2 a_v k_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ pr_rehead $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) ∨ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s $ by ax
l2: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by y1_d_rehead_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s → ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s $ by ax
l6: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∨ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z $ by ax
l8: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) $ by y1_d_rehead_z [l7, l8]
l10: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) ∨ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s $ by ax
l12: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s → ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s ⇒ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_s ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) ∨ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) ∨ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_rehead t1 t2 t3 t4 t5 ⟩ ∈ cl_rehead_z ∪ cl_rehead_s → ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) ∨ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ Y ∃ X (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = X) ∨ ∃ Y ∃ X ∃ e_v ∃ e2 ∃ a_v ∃ k_v (t1 = Y ∧ t2 = X ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons e2 (scons a_v ∅) ⟩ ∧ ra_rehead Y X k_v e_v e2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_has_arg_z (G: hyps) {e_v a_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_has_arg ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ V2 ⟩ = ⟨ pp , ra_has_arg t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_has_arg t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_has_arg ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ V2) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_has_arg t1 t2 = ra_has_arg ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_has_arg t1 t2 = ra_has_arg ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset V2 $ by isset_var
l15: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_has_arg ∈ ω $ by x1_kr_has_arg
l19: $ G ⇒ isset kr_has_arg $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons V2 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_has_arg = kr_has_arg ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons V2 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons V2 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons V2 ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V2 $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ t2 = V2 $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ a_v (t1 = ⟨ kc_app , scons V1 (scons a_v ∅) ⟩ ∧ t2 = a_v) $ by ex_intro [l29]
l31: $ G ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) $ by ex_intro [l30]

lemma y1_d_has_arg_z (G: hyps) {e_v a_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) $
----
l1: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x ∊ cl_has_arg_z ⇒ x ∊ cl_has_arg_z $ by ax
l2: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x ∊ cl_has_arg_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ x = ⟨ pp , ra_has_arg t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) $ by y1_e_has_arg_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩) ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x ∊ cl_has_arg_z ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) $ by wcel_elim [#1, l11]

lemma y1_e_has_arg_s (G: hyps) {e_v a_v b_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ = ⟨ scons (ra_has_arg V1 V2) ∅ , ra_has_arg ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_has_arg V1 V2) ∅ , ra_has_arg ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ V2 ⟩ = ⟨ pp , ra_has_arg t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_has_arg V1 V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_has_arg t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_has_arg ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ V2) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_has_arg V1 V2) ∅ ∧ ra_has_arg t1 t2 = ra_has_arg ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_has_arg V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_has_arg t1 t2 = ra_has_arg ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset V2 $ by isset_var
l15: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_has_arg ∈ ω $ by x1_kr_has_arg
l19: $ G ⇒ isset kr_has_arg $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ (scons V2 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_has_arg = kr_has_arg ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ (scons V2 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ (scons V2 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ ∧ scons t2 ∅ = scons V2 ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V2 $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_has_arg V1 V2) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_has_arg V1 V2) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_has_arg V1 V2) $ by opair_isset
l32: $ G ⇒ ra_has_arg V1 V2 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = V2 ∧ ra_has_arg V1 V2 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V3 ∅) ⟩ ∧ t2 = V2 ∧ ra_has_arg V1 V2 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ b_v (t1 = ⟨ kc_app , scons V1 (scons b_v ∅) ⟩ ∧ t2 = V2 ∧ ra_has_arg V1 V2 ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons V1 (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg V1 a_v ∈ lrel) $ by ex_intro [l35]
l37: $ G ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by ex_intro [l36]

lemma y1_d_has_arg_s (G: hyps) {e_v a_v b_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x ∊ cl_has_arg_s ⇒ x ∊ cl_has_arg_s $ by ax
l2: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x ∊ cl_has_arg_s ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ x = ⟨ pp , ra_has_arg t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by y1_e_has_arg_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) ⇒ ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_has_arg t1 t2 ⟩ , x ∊ cl_has_arg_s ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_has_arg (G: hyps) {e_v a_v b_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ pr_has_arg $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) ∨ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s $ by ax
l2: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by y1_d_has_arg_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s → ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s $ by ax
l6: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∨ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z $ by ax
l8: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) $ by y1_d_has_arg_z [l7, l8]
l10: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) ∨ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s $ by ax
l12: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s → ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s ⇒ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_s ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) ∨ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) ∨ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_has_arg t1 t2 ⟩ ∈ cl_has_arg_z ∪ cl_has_arg_s → ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) ∨ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ e_v ∃ a_v (t1 = ⟨ kc_app , scons e_v (scons a_v ∅) ⟩ ∧ t2 = a_v) ∨ ∃ e_v ∃ a_v ∃ b_v (t1 = ⟨ kc_app , scons e_v (scons b_v ∅) ⟩ ∧ t2 = a_v ∧ ra_has_arg e_v a_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_leaf_has_pi (G: hyps) {j_v A B: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ = ⟨ scons (ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅ , ra_leaf_has V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅ , ra_leaf_has V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_leaf_has t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_leaf_has t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_leaf_has V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅ ∧ ra_leaf_has t1 t2 = ra_leaf_has V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_leaf_has t1 t2 = ra_leaf_has V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_leaf_has ∈ ω $ by x1_kr_leaf_has
l19: $ G ⇒ isset kr_leaf_has $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_leaf_has = kr_leaf_has ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3) $ by opair_isset
l32: $ G ⇒ ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ B (t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ B ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ A ∃ B (t1 = V1 ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons V1 ∅ ⟩ B ∈ lrel) $ by ex_intro [l35]
l37: $ G ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $ by ex_intro [l36]

lemma y1_d_leaf_has_pi (G: hyps) {j_v A B: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x ∊ cl_leaf_has_pi ⇒ x ∊ cl_leaf_has_pi $ by ax
l2: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x ∊ cl_leaf_has_pi ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_leaf_has t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $ by y1_e_leaf_has_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x ∊ cl_leaf_has_pi ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_leaf_has_app (G: hyps) {j_v e_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ = ⟨ scons (ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩) ∅ , ra_leaf_has V1 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩) ∅ , ra_leaf_has V1 V2 ⟩ = ⟨ pp , ra_leaf_has t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_leaf_has t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_leaf_has V1 V2) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩) ∅ ∧ ra_leaf_has t1 t2 = ra_leaf_has V1 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_leaf_has t1 t2 = ra_leaf_has V1 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset V2 $ by isset_var
l15: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_leaf_has ∈ ω $ by x1_kr_leaf_has
l19: $ G ⇒ isset kr_leaf_has $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons V2 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_leaf_has = kr_leaf_has ∧ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V2 ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V2 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V2 $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩) $ by opair_isset
l32: $ G ⇒ ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩ ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = V2 ∧ ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩ ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ ra_has_arg V2 ⟨ kc_bvar , scons V1 ∅ ⟩ ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ e_v (t1 = V1 ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons V1 ∅ ⟩ ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by ex_intro [l35]

lemma y1_d_leaf_has_app (G: hyps) {j_v e_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x ∊ cl_leaf_has_app ⇒ x ∊ cl_leaf_has_app $ by ax
l2: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x ∊ cl_leaf_has_app ⇒ ∃ y ∃ z (x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ x = ⟨ pp , ra_leaf_has t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by y1_e_leaf_has_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , ∃ z (x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩) ⇒ ∃ z (x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , ∃ z (x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩) ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_leaf_has t1 t2 ⟩ , x ∊ cl_leaf_has_app ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by wcel_elim [#1, l11]

lemma y1_o_leaf_has (G: hyps) {j_v A B e_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ pr_leaf_has $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) ∨ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app $ by ax
l2: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by y1_d_leaf_has_app [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app → ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app $ by ax
l6: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∨ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi $ by ax
l8: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) $ by y1_d_leaf_has_pi [l7, l8]
l10: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) ∨ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app $ by ax
l12: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app → ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app ⇒ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_app ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) ∨ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) ∨ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_leaf_has t1 t2 ⟩ ∈ cl_leaf_has_pi ∪ cl_leaf_has_app → ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) ∨ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ j_v ∃ A ∃ B (t1 = j_v ∧ t2 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_leaf_has ⟨ kc_s , scons j_v ∅ ⟩ B ∈ lrel) ∨ ∃ j_v ∃ e_v (t1 = j_v ∧ t2 = e_v ∧ ra_has_arg e_v ⟨ kc_bvar , scons j_v ∅ ⟩ ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_pinst_head (G: hyps) {i_v D j_v A: set} (pp t1 t2 t3 t4 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_pinst V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ V4 V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $
----
l1: $ G ⇒ ⟨ ∅ , ra_pinst V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ V4 V4 ⟩ = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_pinst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_pinst V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ V4 V4) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_pinst t1 t2 t3 t4 = ra_pinst V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ V4 V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_pinst t1 t2 t3 t4 = ra_pinst V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ V4 V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V4 $ by isset_var
l19: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons V4 (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l22: $ G ⇒ scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V4 ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_pinst ∈ ω $ by x1_kr_pinst
l26: $ G ⇒ isset kr_pinst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V4 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_pinst = kr_pinst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V4 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V4 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V4 ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V4 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 (scons t4 ∅) = scons V4 (scons V4 ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons V4 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons V4 ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = V4 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V4 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V4 $ by and_elim_l [l40]
l42: $ G ⇒ t3 = V4 ∧ t4 = V4 $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = V4 $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = V4 $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ A (t1 = V1 ∧ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l44]
l46: $ G ⇒ ∃ j_v ∃ A (t1 = V1 ∧ t2 = ⟨ kc_ind_ty , scons V2 (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l45]
l47: $ G ⇒ ∃ D ∃ j_v ∃ A (t1 = V1 ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l46]
l48: $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l47]

lemma y1_d_pinst_head (G: hyps) {i_v D j_v A: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ ∈ cl_pinst_head $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $
----
l1: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x ∊ cl_pinst_head ⇒ x ∊ cl_pinst_head $ by ax
l2: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x ∊ cl_pinst_head ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by y1_e_pinst_head [l6, l7]
l9: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x ∊ cl_pinst_head ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) $ by wcel_elim [#1, l15]

lemma y1_e_pinst_head_c (G: hyps) {i_v D j_v c_v A: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_pinst V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $
----
l1: $ G ⇒ ⟨ ∅ , ra_pinst V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 V5 ⟩ = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_pinst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_pinst V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 V5) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_pinst t1 t2 t3 t4 = ra_pinst V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_pinst t1 t2 t3 t4 = ra_pinst V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ V5 V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V5 $ by isset_var
l19: $ G ⇒ scons V5 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons V5 (scons V5 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l22: $ G ⇒ scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons V5 ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons V5 ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_pinst ∈ ω $ by x1_kr_pinst
l26: $ G ⇒ isset kr_pinst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons V5 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_pinst = kr_pinst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons V5 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons V5 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons V5 ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ (scons V5 (scons V5 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ scons t3 (scons t4 ∅) = scons V5 (scons V5 ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V5 (scons V5 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V5 ∧ scons t4 ∅ = scons V5 ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = V5 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V5 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V5 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V5 $ by and_elim_l [l40]
l42: $ G ⇒ t3 = V5 ∧ t4 = V5 $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ t3 = V5 ∧ t4 = V5 $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ t3 = V5 ∧ t4 = V5 $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ A (t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l44]
l46: $ G ⇒ ∃ c_v ∃ A (t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l45]
l47: $ G ⇒ ∃ j_v ∃ c_v ∃ A (t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l46]
l48: $ G ⇒ ∃ D ∃ j_v ∃ c_v ∃ A (t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l47]
l49: $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_intro [l48]

lemma y1_d_pinst_head_c (G: hyps) {i_v D j_v c_v A: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ ∈ cl_pinst_head_c $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $
----
l1: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x ∊ cl_pinst_head_c ⇒ x ∊ cl_pinst_head_c $ by ax
l2: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x ∊ cl_pinst_head_c ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by y1_e_pinst_head_c [l6, l7]
l9: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x ∊ cl_pinst_head_c ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) $ by wcel_elim [#1, l17]

lemma y1_e_pinst_app (G: hyps) {i_v S a_v A A1 R: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5) (scons (ra_inst V1 V5 V3 V6) ∅) , ra_pinst V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ V4 V6 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ S ∃ a_v ∃ A ∃ A1 ∃ R (t1 = i_v ∧ t2 = ⟨ kc_app , scons S (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons i_v ∅ ⟩ S A A1 ∈ lrel ∧ ra_inst i_v A1 a_v R ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5) (scons (ra_inst V1 V5 V3 V6) ∅) , ra_pinst V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ V4 V6 ⟩ = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5) (scons (ra_inst V1 V5 V3 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_pinst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_pinst V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ V4 V6) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5) (scons (ra_inst V1 V5 V3 V6) ∅) ∧ ra_pinst t1 t2 t3 t4 = ra_pinst V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ V4 V6 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5) (scons (ra_inst V1 V5 V3 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_pinst t1 t2 t3 t4 = ra_pinst V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ V4 V6 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V6 $ by isset_var
l19: $ G ⇒ scons V6 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V4 $ by isset_var
l21: $ G ⇒ scons V4 (scons V6 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V6 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V6 ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_pinst ∈ ω $ by x1_kr_pinst
l27: $ G ⇒ isset kr_pinst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V6 ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_pinst = kr_pinst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V6 ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V6 ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V6 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons V6 ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 (scons t4 ∅) = scons V4 (scons V6 ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons V6 ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons V6 ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V4 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons V6 ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = V6 ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = V6 $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5) (scons (ra_inst V1 V5 V3 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5) (scons (ra_inst V1 V5 V3 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5) $ by opair_isset
l46: $ G ⇒ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_inst V1 V5 V3 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_inst V1 V5 V3 V6) $ by opair_isset
l49: $ G ⇒ ra_inst V1 V5 V3 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5 ∈ lrel ∧ ra_inst V1 V5 V3 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = V6 ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5 ∈ lrel ∧ ra_inst V1 V5 V3 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = V4 ∧ t4 = V6 ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5 ∈ lrel ∧ ra_inst V1 V5 V3 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = V6 ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5 ∈ lrel ∧ ra_inst V1 V5 V3 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = V6 ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5 ∈ lrel ∧ ra_inst V1 V5 V3 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ R (t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 V5 ∈ lrel ∧ ra_inst V1 V5 V3 R ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ A1 ∃ R (t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V4 A1 ∈ lrel ∧ ra_inst V1 A1 V3 R ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ A ∃ A1 ∃ R (t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 A A1 ∈ lrel ∧ ra_inst V1 A1 V3 R ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ a_v ∃ A ∃ A1 ∃ R (t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ V2 A A1 ∈ lrel ∧ ra_inst V1 A1 a_v R ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ S ∃ a_v ∃ A ∃ A1 ∃ R (t1 = V1 ∧ t2 = ⟨ kc_app , scons S (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons V1 ∅ ⟩ S A A1 ∈ lrel ∧ ra_inst V1 A1 a_v R ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ i_v ∃ S ∃ a_v ∃ A ∃ A1 ∃ R (t1 = i_v ∧ t2 = ⟨ kc_app , scons S (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons i_v ∅ ⟩ S A A1 ∈ lrel ∧ ra_inst i_v A1 a_v R ∈ lrel) $ by ex_intro [l59]

lemma y1_d_pinst_app (G: hyps) {i_v S a_v A A1 R: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ ∈ cl_pinst_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ S ∃ a_v ∃ A ∃ A1 ∃ R (t1 = i_v ∧ t2 = ⟨ kc_app , scons S (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons i_v ∅ ⟩ S A A1 ∈ lrel ∧ ra_inst i_v A1 a_v R ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x ∊ cl_pinst_app ⇒ x ∊ cl_pinst_app $ by ax
l2: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x ∊ cl_pinst_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ ∃ i_v ∃ S ∃ a_v ∃ A ∃ A1 ∃ R (t1 = i_v ∧ t2 = ⟨ kc_app , scons S (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons i_v ∅ ⟩ S A A1 ∈ lrel ∧ ra_inst i_v A1 a_v R ∈ lrel) $ by y1_e_pinst_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ ∃ i_v ∃ S ∃ a_v ∃ A ∃ A1 ∃ R (t1 = i_v ∧ t2 = ⟨ kc_app , scons S (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons i_v ∅ ⟩ S A A1 ∈ lrel ∧ ra_inst i_v A1 a_v R ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by ax
