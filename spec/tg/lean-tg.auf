l106: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l105]

lemma y1_d_cminors_cons (G: hyps) {D np n_v k_v i_v c_v nf K Min C M1 M: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cminors_cons ⇒ x ∊ cl_cminors_cons $ by ax
l2: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cminors_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j (x = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩ ⇒ x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩ ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩ ⇒ x = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩ ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_npis c b) (scons (ra_mwalk y z u v w a b ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ c f) (scons (ra_cminors y z u ⟨ kc_s , scons v ∅ ⟩ w ⟨ kc_s , scons a ∅ ⟩ g i) (scons (ra_capp i ⟨ kc_cons , scons f (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ j) ∅))) , ra_cminors y z u v w a ⟨ kc_ccons , scons c (scons g ∅) ⟩ j ⟩ ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by y1_e_cminors_cons [l6, l7]
