lemma y2_nth_ctor_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_nth_ctor lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_nth_ctor lrel → c ∊ y2_P_nth_ctor lrel) $ by y2_nth_ctor_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_nth_ctor lrel $ by horn_ind [l1, l2]

lrel_nth_ctor_det
-----------------
l1: $ G ⇒ horn lprog ⊆ y2_P_nth_ctor lrel $ by y2_nth_ctor_in
l2: $ G ⇒ ra_nth_ctor t1 t2 u3 ∈ y2_P_nth_ctor lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u3 = v3 $ by y2_nth_ctor_ih [l2, #2]

--| The atoms of `ntys` whose variants in `L` with the same inputs have the same outputs.
def y2_P_ntys (L: class) (.c .x1 .x2 .x3 .x6 .x7: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_ntys , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ L → x2 = x6 ∧ x3 = x7))} $

lemma y2_ntys_ih (GG: hyps) (q1 q2 q3 w2 w3: set):
  $ GG ⇒ ra_ntys q1 q2 q3 ∈ y2_P_ntys lrel $ > $ GG ⇒ ra_ntys q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ c ∊ y2_P_ntys lrel $ by ax
l2: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_ntys , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by cab_elim [l1]
l3: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_ntys , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons q1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by all_elim [l2]
l4: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ ∀ x3 (c = ⟨ kr_ntys , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons q1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → q2 = x6 ∧ x3 = x7)) $ by all_elim [l3]
l5: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ c = ⟨ kr_ntys , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons q1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → q2 = x6 ∧ q3 = x7) $ by all_elim [l4]
l6: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ c = ra_ntys q1 q2 q3 $ by ax
l7: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ ∀ x6 ∀ x7 (⟨ kr_ntys , scons q1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → q2 = x6 ∧ q3 = x7) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ ∀ x7 (⟨ kr_ntys , scons q1 (scons w2 (scons x7 ∅)) ⟩ ∈ lrel → q2 = w2 ∧ q3 = x7) $ by all_elim [l7]
l9: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ ra_ntys q1 w2 w3 ∈ lrel → q2 = w2 ∧ q3 = w3 $ by all_elim [l8]
l10: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ ra_ntys q1 w2 w3 ∈ lrel $ by weaken [#2]
l11: $ GG , c = ra_ntys q1 q2 q3 , c ∊ y2_P_ntys lrel ⇒ q2 = w2 ∧ q3 = w3 $ by imp_elim [l9, l10]
l12: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by wcel_elim [#1, l11]

lemma y2_ntys_ihc (GG: hyps) (Q1 Q2 Q3 W2 W3: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset W2 $ > $ GG ⇒ isset W3 $ > $ GG ⇒ ra_ntys Q1 Q2 Q3 ∈ y2_P_ntys lrel $ > $ GG ⇒ ra_ntys Q1 W2 W3 ∈ lrel $ > $ GG ⇒ Q2 = W2 ∧ Q3 = W3 $
