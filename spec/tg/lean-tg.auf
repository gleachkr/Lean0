l10: $ G , x = ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ y z u ⟩) ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ y z u ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ y z u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ y z u ⟩) ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ y z u ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ y z u ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ y z u ⟩) ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ , x ∊ cl_ind_data_n ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by wcel_elim [#1, l15]

lemma y1_o_ind_data (G: hyps) {b_v P T N: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ pr_ind_data $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $
----
l1: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n $ by ax
l2: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by y1_d_ind_data_n [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n → ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n $ by ax
l6: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∨ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i $ by ax
l8: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by y1_d_ind_data_i [l7, l8]
l10: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n $ by ax
l12: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n → ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_n ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i ∪ cl_ind_data_n → ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by imp_intro [l15]
l17: $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by imp_elim [l16, #1]

lemma y1_e_ind_nested_mk (G: hyps) {b_v P T: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_ind_nested t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ind_nested t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_ind_nested ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_ind_nested t1 t2 = ra_ind_nested ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ind_nested t1 t2 = ra_ind_nested ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_ind_nested ∈ ω $ by x1_kr_ind_nested
l19: $ G ⇒ isset kr_ind_nested $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_ind_nested = kr_ind_nested ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ T (t1 = ⟨ kc_ind_mk , scons V1 (scons V2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons V1 (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l30]
l32: $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l31]

lemma y1_d_ind_nested_mk (G: hyps) {b_v P T: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x ∊ cl_ind_nested_mk ⇒ x ∊ cl_ind_nested_mk $ by ax
l2: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x ∊ cl_ind_nested_mk ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_ind_nested t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by y1_e_ind_nested_mk [l6, l7]
l9: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ u (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ u (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x ∊ cl_ind_nested_mk ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l13]

lemma y1_e_ind_nested_mkn (G: hyps) {b_v P T N: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $
----
l1: $ G ⇒ ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ V4 ⟩ = ⟨ pp , ra_ind_nested t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ind_nested t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_ind_nested ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ V4) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_ind_nested t1 t2 = ra_ind_nested ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ind_nested t1 t2 = ra_ind_nested ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset V4 $ by isset_var
l15: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_ind_nested ∈ ω $ by x1_kr_ind_nested
l19: $ G ⇒ isset kr_ind_nested $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ (scons V4 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_ind_nested = kr_ind_nested ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ (scons V4 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ (scons V4 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ ∧ scons t2 ∅ = scons V4 ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V4 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V4 $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ ∧ t2 = V4 $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ N (t1 = ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons N ∅))) ⟩ ∧ t2 = N) $ by ex_intro [l29]
l31: $ G ⇒ ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons V1 (scons V2 (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by ex_intro [l30]
l32: $ G ⇒ ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons V1 (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by ex_intro [l31]
l33: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by ex_intro [l32]

lemma y1_d_ind_nested_mkn (G: hyps) {b_v P T N: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $
----
l1: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x ∊ cl_ind_nested_mkn ⇒ x ∊ cl_ind_nested_mkn $ by ax
l2: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x ∊ cl_ind_nested_mkn ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩ ⇒ x = ⟨ pp , ra_ind_nested t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩ ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩ ⇒ x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩ ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩ ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by y1_e_ind_nested_mkn [l6, l7]
l9: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons y (scons z (scons u (scons v ∅))) ⟩ v ⟩) ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ind_nested t1 t2 ⟩ , x ∊ cl_ind_nested_mkn ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by wcel_elim [#1, l15]

lemma y1_o_ind_nested (G: hyps) {b_v P T N: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ pr_ind_nested $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $
----
l1: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn $ by ax
l2: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by y1_d_ind_nested_mkn [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn → ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn $ by ax
l6: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∨ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk $ by ax
l8: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) $ by y1_d_ind_nested_mk [l7, l8]
l10: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn $ by ax
l12: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn → ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mkn ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ind_nested t1 t2 ⟩ ∈ cl_ind_nested_mk ∪ cl_ind_nested_mkn → ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by imp_intro [l15]
l17: $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = N) $ by imp_elim [l16, #1]

lemma y1_e_nth_ty_z (G: hyps) {F C T: set} (pp t1 t2 t3 t4 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $
----
l1: $ G ⇒ ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 ⟩ = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nth_ty t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_nth_ty ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_nth_ty t1 t2 t3 t4 = ra_nth_ty ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nth_ty t1 t2 t3 t4 = ra_nth_ty ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_nth_ty ∈ ω $ by x1_kr_nth_ty
l27: $ G ⇒ isset kr_nth_ty $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_nth_ty = kr_nth_ty ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V1 (scons V2 ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V1 (scons V2 ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V1 ∧ scons t4 ∅ = scons V2 ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V1 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons V2 ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = V2 $ by and_elim_l [l41]
l43: $ G ⇒ t3 = V1 ∧ t4 = V2 $ by and_intro [l39, l42]
l44: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 ∧ t4 = V2 $ by and_intro [l36, l43]
l45: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 ∧ t4 = V2 $ by and_intro [l33, l44]
l46: $ G ⇒ ∃ T (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 ∧ t4 = V2) $ by ex_intro [l45]
l47: $ G ⇒ ∃ C ∃ T (t1 = ⟨ kc_tcons , scons V1 (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 ∧ t4 = C) $ by ex_intro [l46]
l48: $ G ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $ by ex_intro [l47]

lemma y1_d_nth_ty_z (G: hyps) {F C T: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $
----
l1: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x ∊ cl_nth_ty_z ⇒ x ∊ cl_nth_ty_z $ by ax
l2: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x ∊ cl_nth_ty_z ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $ by y1_e_nth_ty_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩) ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_nth_ty ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ y z ⟩) ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x ∊ cl_nth_ty_z ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $ by wcel_elim [#1, l13]

lemma y1_e_nth_ty_s (G: hyps) {F F2 C C2 T i_v: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ = ⟨ scons (ra_nth_ty V5 V6 V1 V3) ∅ , ra_nth_ty ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_s , scons V6 ∅ ⟩ V1 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_nth_ty V5 V6 V1 V3) ∅ , ra_nth_ty ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_s , scons V6 ∅ ⟩ V1 V3 ⟩ = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_nth_ty V5 V6 V1 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nth_ty t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_nth_ty ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_s , scons V6 ∅ ⟩ V1 V3) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_nth_ty V5 V6 V1 V3) ∅ ∧ ra_nth_ty t1 t2 t3 t4 = ra_nth_ty ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_s , scons V6 ∅ ⟩ V1 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_nth_ty V5 V6 V1 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nth_ty t1 t2 t3 t4 = ra_nth_ty ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ⟨ kc_s , scons V6 ∅ ⟩ V1 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V3 $ by isset_var
l19: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_s , scons V6 ∅ ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V1 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V1 (scons V3 ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_nth_ty ∈ ω $ by x1_kr_nth_ty
l27: $ G ⇒ isset kr_nth_ty $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V1 (scons V3 ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_nth_ty = kr_nth_ty ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V1 (scons V3 ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V1 (scons V3 ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V1 (scons V3 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V1 (scons V3 ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V1 (scons V3 ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_s , scons V6 ∅ ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V1 (scons V3 ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V1 ∧ scons t4 ∅ = scons V3 ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V1 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons V3 ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = V3 $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_nth_ty V5 V6 V1 V3) ∅) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_nth_ty V5 V6 V1 V3) ∅) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_nth_ty V5 V6 V1 V3) $ by opair_isset
l46: $ G ⇒ ra_nth_ty V5 V6 V1 V3 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ t4 = V3 ∧ ra_nth_ty V5 V6 V1 V3 ∈ lrel $ by and_intro [l42, l46]
l48: $ G ⇒ t3 = V1 ∧ t4 = V3 ∧ ra_nth_ty V5 V6 V1 V3 ∈ lrel $ by and_intro [l39, l47]
l49: $ G ⇒ t2 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t3 = V1 ∧ t4 = V3 ∧ ra_nth_ty V5 V6 V1 V3 ∈ lrel $ by and_intro [l36, l48]
l50: $ G ⇒ t1 = ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t3 = V1 ∧ t4 = V3 ∧ ra_nth_ty V5 V6 V1 V3 ∈ lrel $ by and_intro [l33, l49]
l51: $ G ⇒ ∃ i_v (t1 = ⟨ kc_tcons , scons V2 (scons V4 (scons V5 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = V1 ∧ t4 = V3 ∧ ra_nth_ty V5 i_v V1 V3 ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons V2 (scons V4 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = V1 ∧ t4 = V3 ∧ ra_nth_ty T i_v V1 V3 ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons V2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = V1 ∧ t4 = V3 ∧ ra_nth_ty T i_v V1 V3 ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons V2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = V1 ∧ t4 = C ∧ ra_nth_ty T i_v V1 C ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = V1 ∧ t4 = C ∧ ra_nth_ty T i_v V1 C ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by ex_intro [l55]

lemma y1_d_nth_ty_s (G: hyps) {F F2 C C2 T i_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x ∊ cl_nth_ty_s ⇒ x ∊ cl_nth_ty_s $ by ax
l2: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x ∊ cl_nth_ty_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩ ⇒ x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩ ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩ ⇒ x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩ ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩ ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by y1_e_nth_ty_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_nth_ty w a y u) ∅ , ra_nth_ty ⟨ kc_tcons , scons z (scons v (scons w ∅)) ⟩ ⟨ kc_s , scons a ∅ ⟩ y u ⟩) ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ , x ∊ cl_nth_ty_s ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_o_nth_ty (G: hyps) {F C T F2 C2 i_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ pr_nth_ty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s $ by ax
l2: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by y1_d_nth_ty_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s → ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s $ by ax
l6: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∨ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z $ by ax
l8: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) $ by y1_d_nth_ty_z [l7, l8]
l10: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s $ by ax
l12: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s → ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_s ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_nth_ty t1 t2 t3 t4 ⟩ ∈ cl_nth_ty_z ∪ cl_nth_ty_s → ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ F ∃ C ∃ T (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = F ∧ t4 = C) ∨ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i_v (t1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = F ∧ t4 = C ∧ ra_nth_ty T i_v F C ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_nth_ctor_z (G: hyps) {K C: set} (pp t1 t2 t3 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) $
----
l1: $ G ⇒ ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nth_ctor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_nth_ctor ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_nth_ctor t1 t2 t3 = ra_nth_ctor ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nth_ctor t1 t2 t3 = ra_nth_ctor ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_nth_ctor ∈ ω $ by x1_kr_nth_ctor
l23: $ G ⇒ isset kr_nth_ctor $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_nth_ctor = kr_nth_ctor ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l32, l35]
l37: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l29, l36]
l38: $ G ⇒ ∃ C (t1 = ⟨ kc_ccons , scons V1 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1) $ by ex_intro [l37]
l39: $ G ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) $ by ex_intro [l38]

lemma y1_d_nth_ctor_z (G: hyps) {K C: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) $
----
l1: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x ∊ cl_nth_ctor_z ⇒ x ∊ cl_nth_ctor_z $ by ax
l2: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x ∊ cl_nth_ctor_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) $ by y1_e_nth_ctor_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , ∃ z (x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , ∃ z (x = ⟨ ∅ , ra_nth_ctor ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x ∊ cl_nth_ctor_z ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) $ by wcel_elim [#1, l11]

lemma y1_e_nth_ctor_s (G: hyps) {K K2 C c_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ = ⟨ scons (ra_nth_ctor V3 V4 V1) ∅ , ra_nth_ctor ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_nth_ctor V3 V4 V1) ∅ , ra_nth_ctor ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1 ⟩ = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_nth_ctor V3 V4 V1) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nth_ctor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_nth_ctor ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_nth_ctor V3 V4 V1) ∅ ∧ ra_nth_ctor t1 t2 t3 = ra_nth_ctor ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_nth_ctor V3 V4 V1) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nth_ctor t1 t2 t3 = ra_nth_ctor ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_nth_ctor ∈ ω $ by x1_kr_nth_ctor
l23: $ G ⇒ isset kr_nth_ctor $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_nth_ctor = kr_nth_ctor ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_nth_ctor V3 V4 V1) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_nth_ctor V3 V4 V1) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_nth_ctor V3 V4 V1) $ by opair_isset
l39: $ G ⇒ ra_nth_ctor V3 V4 V1 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V1 ∧ ra_nth_ctor V3 V4 V1 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_ctor V3 V4 V1 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_ctor V3 V4 V1 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ c_v (t1 = ⟨ kc_ccons , scons V2 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_ctor V3 c_v V1 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons V2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_ctor C c_v V1 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_ctor C c_v V1 ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by ex_intro [l45]

lemma y1_d_nth_ctor_s (G: hyps) {K K2 C c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x ∊ cl_nth_ctor_s ⇒ x ∊ cl_nth_ctor_s $ by ax
l2: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x ∊ cl_nth_ctor_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by y1_e_nth_ctor_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_ctor u v y) ∅ , ra_nth_ctor ⟨ kc_ccons , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ , x ∊ cl_nth_ctor_s ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_nth_ctor (G: hyps) {K C K2 c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ pr_nth_ctor $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) ∨ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s $ by ax
l2: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by y1_d_nth_ctor_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s → ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s $ by ax
l6: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∨ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z $ by ax
l8: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) $ by y1_d_nth_ctor_z [l7, l8]
l10: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) ∨ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s $ by ax
l12: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s → ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s ⇒ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_s ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) ∨ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) ∨ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_nth_ctor t1 t2 t3 ⟩ ∈ cl_nth_ctor_z ∪ cl_nth_ctor_s → ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) ∨ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ K ∃ C (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = K) ∨ ∃ K ∃ K2 ∃ C ∃ c_v (t1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons c_v ∅ ⟩ ∧ t3 = K ∧ ra_nth_ctor C c_v K ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_clen_c_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ = ⟨ pp , ra_clen_c t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_clen_c t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_clen_c t1 t2 = ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_clen_c t1 t2 = ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_cnil , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_clen_c ∈ ω $ by x1_kr_clen_c
l19: $ G ⇒ isset kr_clen_c $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_clen_c = kr_clen_c ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l25, l28]

lemma y1_d_clen_c_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_nil ⇒ x ∊ cl_clen_c_nil $ by ax
l2: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_nil ⇒ (x = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_nil ⇒ x = ⟨ pp , ra_clen_c t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_nil ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_nil ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_nil ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by y1_e_clen_c_nil [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma y1_e_clen_c_cons (G: hyps) {K C n_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ = ⟨ scons (ra_clen_c V2 V3) ∅ , ra_clen_c ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_clen_c V2 V3) ∅ , ra_clen_c ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_clen_c t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_clen_c V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_clen_c t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_clen_c ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_clen_c V2 V3) ∅ ∧ ra_clen_c t1 t2 = ra_clen_c ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_clen_c V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_clen_c t1 t2 = ra_clen_c ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_clen_c ∈ ω $ by x1_kr_clen_c
l19: $ G ⇒ isset kr_clen_c $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_clen_c = kr_clen_c ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_clen_c V2 V3) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_clen_c V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_clen_c V2 V3) $ by opair_isset
l32: $ G ⇒ ra_clen_c V2 V3 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_clen_c V2 V3 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_clen_c V2 V3 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ n_v (t1 = ⟨ kc_ccons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c V2 n_v ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons V1 (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by ex_intro [l35]
l37: $ G ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by ex_intro [l36]

lemma y1_d_clen_c_cons (G: hyps) {K C n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_cons ⇒ x ∊ cl_clen_c_cons $ by ax
l2: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_cons ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_clen_c t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by y1_e_clen_c_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_clen_c z u) ∅ , ra_clen_c ⟨ kc_ccons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_clen_c t1 t2 ⟩ , x ∊ cl_clen_c_cons ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_clen_c (G: hyps) {K C n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ pr_clen_c $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons $ by ax
l2: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by y1_d_clen_c_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons → ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons $ by ax
l6: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∨ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil $ by ax
l8: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by y1_d_clen_c_nil [l7, l8]
l10: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons $ by ax
l12: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons → ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons ⇒ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_cons ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_clen_c t1 t2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons → (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ (t1 = ⟨ kc_cnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ K ∃ C ∃ n_v (t1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen_c C n_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_ntys_nil (G: hyps) (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ = ⟨ pp , ra_ntys t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ntys t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_ntys t1 t2 t3 = ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ntys t1 t2 t3 = ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_tnil , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_ntys ∈ ω $ by x1_kr_ntys
l22: $ G ⇒ isset kr_ntys $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_ntys = kr_ntys ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l33]
l35: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l28, l35]

lemma y1_d_ntys_nil (G: hyps) (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_nil ⇒ x ∊ cl_ntys_nil $ by ax
l2: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_nil ⇒ (x = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_nil ⇒ x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_nil ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_nil ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_nil ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by y1_e_ntys_nil [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma y1_e_ntys_cons (G: hyps) {F C T n_v m_v c_v m2: set} (pp t1 t2 t3 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ = ⟨ scons (ra_ntys V3 V4 V5) (scons (ra_clen_c V2 V6) (scons (ra_add V5 V6 V7) ∅)) , ra_ntys ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V7 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ntys V3 V4 V5) (scons (ra_clen_c V2 V6) (scons (ra_add V5 V6 V7) ∅)) , ra_ntys ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V7 ⟩ = ⟨ pp , ra_ntys t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ntys V3 V4 V5) (scons (ra_clen_c V2 V6) (scons (ra_add V5 V6 V7) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ntys t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_ntys ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V7) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ntys V3 V4 V5) (scons (ra_clen_c V2 V6) (scons (ra_add V5 V6 V7) ∅)) ∧ ra_ntys t1 t2 t3 = ra_ntys ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V7 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ntys V3 V4 V5) (scons (ra_clen_c V2 V6) (scons (ra_add V5 V6 V7) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_ntys t1 t2 t3 = ra_ntys ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V7 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
