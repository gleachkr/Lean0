lemma y1_e_lsubst_z (G: hyps) {n_v a_v: set} (pp t1 t2 t3 t4 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_lsubst V1 ⟨ kc_lz , ∅ ⟩ V2 ⟨ kc_lz , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_lsubst V1 ⟨ kc_lz , ∅ ⟩ V2 ⟨ kc_lz , ∅ ⟩ ⟩ = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lsubst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lsubst V1 ⟨ kc_lz , ∅ ⟩ V2 ⟨ kc_lz , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lz , ∅ ⟩ V2 ⟨ kc_lz , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lz , ∅ ⟩ V2 ⟨ kc_lz , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_lz , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_lz , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V2 $ by isset_var
l21: $ G ⇒ scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ scons ⟨ kc_lz , ∅ ⟩ (scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l18, l21]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons ⟨ kc_lz , ∅ ⟩ (scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l26: $ G ⇒ isset kr_lsubst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons ⟨ kc_lz , ∅ ⟩ (scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_lsubst = kr_lsubst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lz , ∅ ⟩ (scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lz , ∅ ⟩ (scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lz , ∅ ⟩ (scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lz , ∅ ⟩ (scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_lz , ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅) $ by y1_scons_inj [l33, l14, l18, l13, l21]
l35: $ G ⇒ t2 = ⟨ kc_lz , ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V2 (scons ⟨ kc_lz , ∅ ⟩ ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V2 ∧ scons t4 ∅ = scons ⟨ kc_lz , ∅ ⟩ ∅ $ by y1_scons_inj [l36, l12, l20, l11, l19]
l38: $ G ⇒ t3 = V2 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons ⟨ kc_lz , ∅ ⟩ ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = ⟨ kc_lz , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = ⟨ kc_lz , ∅ ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ t3 = V2 ∧ t4 = ⟨ kc_lz , ∅ ⟩ $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = V2 ∧ t4 = ⟨ kc_lz , ∅ ⟩ $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = V2 ∧ t4 = ⟨ kc_lz , ∅ ⟩ $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l44]
l46: $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l45]

lemma y1_d_lsubst_z (G: hyps) {n_v a_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_z ⇒ x ∊ cl_lsubst_z $ by ax
l2: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) $ by y1_e_lsubst_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lz , ∅ ⟩ z ⟨ kc_lz , ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_z ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_lsubst_s (G: hyps) {n_v b_v a_v b2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lsubst V1 V2 V3 V4) ∅ , ra_lsubst V1 ⟨ kc_ls , scons V2 ∅ ⟩ V3 ⟨ kc_ls , scons V4 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lsubst V1 V2 V3 V4) ∅ , ra_lsubst V1 ⟨ kc_ls , scons V2 ∅ ⟩ V3 ⟨ kc_ls , scons V4 ∅ ⟩ ⟩ = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lsubst V1 V2 V3 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lsubst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lsubst V1 ⟨ kc_ls , scons V2 ∅ ⟩ V3 ⟨ kc_ls , scons V4 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lsubst V1 V2 V3 V4) ∅ ∧ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_ls , scons V2 ∅ ⟩ V3 ⟨ kc_ls , scons V4 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lsubst V1 V2 V3 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_ls , scons V2 ∅ ⟩ V3 ⟨ kc_ls , scons V4 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_ls , scons V4 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V3 $ by isset_var
l21: $ G ⇒ scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_ls , scons V2 ∅ ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l27: $ G ⇒ isset kr_lsubst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_lsubst = kr_lsubst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V3 ∧ scons t4 ∅ = scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V3 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_ls , scons V4 ∅ ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_ls , scons V4 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_ls , scons V4 ∅ ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_lsubst V1 V2 V3 V4) ∅) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_lsubst V1 V2 V3 V4) ∅) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_lsubst V1 V2 V3 V4) $ by opair_isset
l46: $ G ⇒ ra_lsubst V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ t4 = ⟨ kc_ls , scons V4 ∅ ⟩ ∧ ra_lsubst V1 V2 V3 V4 ∈ lrel $ by and_intro [l42, l46]
l48: $ G ⇒ t3 = V3 ∧ t4 = ⟨ kc_ls , scons V4 ∅ ⟩ ∧ ra_lsubst V1 V2 V3 V4 ∈ lrel $ by and_intro [l39, l47]
l49: $ G ⇒ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_ls , scons V4 ∅ ⟩ ∧ ra_lsubst V1 V2 V3 V4 ∈ lrel $ by and_intro [l36, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_ls , scons V4 ∅ ⟩ ∧ ra_lsubst V1 V2 V3 V4 ∈ lrel $ by and_intro [l33, l49]
l51: $ G ⇒ ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst V1 V2 V3 b2 ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ a_v ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst V1 V2 a_v b2 ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ b_v ∃ a_v ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst V1 b_v a_v b2 ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $ by ex_intro [l53]

lemma y1_d_lsubst_s (G: hyps) {n_v b_v a_v b2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_s ⇒ x ∊ cl_lsubst_s $ by ax
l2: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩ ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $ by y1_e_lsubst_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lsubst y z u v) ∅ , ra_lsubst y ⟨ kc_ls , scons z ∅ ⟩ u ⟨ kc_ls , scons v ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_s ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_e_lsubst_max (G: hyps) {n_v b_v c_v a_v b2 c2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅) , ra_lsubst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅) , ra_lsubst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lsubst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lsubst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅) ∧ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V4 $ by isset_var
l21: $ G ⇒ scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l27: $ G ⇒ isset kr_lsubst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_lsubst = kr_lsubst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V4 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_lsubst V1 V2 V4 V5) $ by opair_isset
l46: $ G ⇒ ra_lsubst V1 V2 V4 V5 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_lsubst V1 V3 V4 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_lsubst V1 V3 V4 V6) $ by opair_isset
l49: $ G ⇒ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = V4 ∧ t4 = ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_lmax , scons V5 (scons V6 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_lmax , scons V5 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 c2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ b2 ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 b2 ∈ lrel ∧ ra_lsubst V1 V3 V4 c2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ a_v ∃ b2 ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 V2 a_v b2 ∈ lrel ∧ ra_lsubst V1 V3 a_v c2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 V2 a_v b2 ∈ lrel ∧ ra_lsubst V1 c_v a_v c2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 b_v a_v b2 ∈ lrel ∧ ra_lsubst V1 c_v a_v c2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_lsubst_max (G: hyps) {n_v b_v c_v a_v b2 c2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_max $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_max ⇒ x ∊ cl_lsubst_max $ by ax
l2: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_max ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩ ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by y1_e_lsubst_max [l6, l7]
l9: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ v ⟨ kc_lmax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_max ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_lsubst_imax (G: hyps) {n_v b_v c_v a_v b2 c2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅) , ra_lsubst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅) , ra_lsubst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lsubst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lsubst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅) ∧ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ V4 ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V4 $ by isset_var
l21: $ G ⇒ scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l27: $ G ⇒ isset kr_lsubst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_lsubst = kr_lsubst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V4 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_lsubst V1 V2 V4 V5) (scons (ra_lsubst V1 V3 V4 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_lsubst V1 V2 V4 V5) $ by opair_isset
l46: $ G ⇒ ra_lsubst V1 V2 V4 V5 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_lsubst V1 V3 V4 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_lsubst V1 V3 V4 V6) $ by opair_isset
l49: $ G ⇒ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = V4 ∧ t4 = ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_limax , scons V5 (scons V6 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_limax , scons V5 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 V5 ∈ lrel ∧ ra_lsubst V1 V3 V4 c2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ b2 ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V4 ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 V2 V4 b2 ∈ lrel ∧ ra_lsubst V1 V3 V4 c2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ a_v ∃ b2 ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 V2 a_v b2 ∈ lrel ∧ ra_lsubst V1 V3 a_v c2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 V2 a_v b2 ∈ lrel ∧ ra_lsubst V1 c_v a_v c2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst V1 b_v a_v b2 ∈ lrel ∧ ra_lsubst V1 c_v a_v c2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_lsubst_imax (G: hyps) {n_v b_v c_v a_v b2 c2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_imax $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_imax ⇒ x ∊ cl_lsubst_imax $ by ax
l2: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_imax ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩ ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by y1_e_lsubst_imax [l6, l7]
l9: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lsubst y z v w) (scons (ra_lsubst y u v a) ∅) , ra_lsubst y ⟨ kc_limax , scons z (scons u ∅) ⟩ v ⟨ kc_limax , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_imax ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_lsubst_eq (G: hyps) {n_v a_v: set} (pp t1 t2 t3 t4 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_lsubst V1 ⟨ kc_lparam , scons V1 ∅ ⟩ V2 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_lsubst V1 ⟨ kc_lparam , scons V1 ∅ ⟩ V2 V2 ⟩ = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lsubst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lsubst V1 ⟨ kc_lparam , scons V1 ∅ ⟩ V2 V2) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lparam , scons V1 ∅ ⟩ V2 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lparam , scons V1 ∅ ⟩ V2 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons V2 (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset ⟨ kc_lparam , scons V1 ∅ ⟩ $ by opair_isset
l22: $ G ⇒ scons ⟨ kc_lparam , scons V1 ∅ ⟩ (scons V2 (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons ⟨ kc_lparam , scons V1 ∅ ⟩ (scons V2 (scons V2 ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l26: $ G ⇒ isset kr_lsubst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons ⟨ kc_lparam , scons V1 ∅ ⟩ (scons V2 (scons V2 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_lsubst = kr_lsubst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lparam , scons V1 ∅ ⟩ (scons V2 (scons V2 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lparam , scons V1 ∅ ⟩ (scons V2 (scons V2 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lparam , scons V1 ∅ ⟩ (scons V2 (scons V2 ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lparam , scons V1 ∅ ⟩ (scons V2 (scons V2 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_lparam , scons V1 ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V2 (scons V2 ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = ⟨ kc_lparam , scons V1 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V2 (scons V2 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V2 ∧ scons t4 ∅ = scons V2 ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = V2 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V2 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V2 $ by and_elim_l [l40]
l42: $ G ⇒ t3 = V2 ∧ t4 = V2 $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = ⟨ kc_lparam , scons V1 ∅ ⟩ ∧ t3 = V2 ∧ t4 = V2 $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lparam , scons V1 ∅ ⟩ ∧ t3 = V2 ∧ t4 = V2 $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_lparam , scons V1 ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) $ by ex_intro [l44]
l46: $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) $ by ex_intro [l45]

lemma y1_d_lsubst_eq (G: hyps) {n_v a_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_eq $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) $
----
l1: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_eq ⇒ x ∊ cl_lsubst_eq $ by ax
l2: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_eq ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) $ by y1_e_lsubst_eq [l6, l7]
l9: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩) ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_eq ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) $ by wcel_elim [#1, l11]

lemma y1_e_lsubst_lt (G: hyps) {n_v m_v a_v: set} (pp t1 t2 t3 t4 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1) ∅ , ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1) ∅ , ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lsubst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1) ∅ ∧ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_lparam , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V3 $ by isset_var
l21: $ G ⇒ scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l18, l21]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l26: $ G ⇒ isset kr_lsubst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_lsubst = kr_lsubst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅) $ by y1_scons_inj [l33, l14, l18, l13, l21]
l35: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V3 ∧ scons t4 ∅ = scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅ $ by y1_scons_inj [l36, l12, l20, l11, l19]
l38: $ G ⇒ t3 = V3 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ crn pp = crn (scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1) ∅) $ by crn_eq [l7]
l43: $ G ⇒ crn (scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1) ∅) ⊆ lrel $ by subset_eq_l [l42, #2]
l44: $ G ⇒ isset (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1) $ by opair_isset
l45: $ G ⇒ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1 ∈ lrel $ by crn_scons_head [l44, l43]
l46: $ G ⇒ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1 ∈ lrel $ by and_intro [l41, l45]
l47: $ G ⇒ t3 = V3 ∧ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1 ∈ lrel $ by and_intro [l38, l46]
l48: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1 ∈ lrel $ by and_intro [l35, l47]
l49: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1 ∈ lrel $ by and_intro [l32, l48]
l50: $ G ⇒ ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V1 ∈ lrel) $ by ex_intro [l49]
l51: $ G ⇒ ∃ m_v ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ V1 ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $ by ex_intro [l51]

lemma y1_d_lsubst_lt (G: hyps) {n_v m_v a_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_lt ⇒ x ∊ cl_lsubst_lt $ by ax
l2: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_lt ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $ by y1_e_lsubst_lt [l6, l7]
l9: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_lt ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_lsubst_gt (G: hyps) {n_v m_v a_v: set} (pp t1 t2 t3 t4 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅ , ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅ , ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lsubst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅ ∧ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lsubst t1 t2 t3 t4 = ra_lsubst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟨ kc_lparam , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
