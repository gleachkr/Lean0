l29: $ GG ⇒ u_K = v_K $ by lrel_nth_ctor_det [#7, l28]
l30: $ GG ⇒ v_K = u_K $ by eq_sym [l29]
l31: $ GG ⇒ v_nf = v_nf $ by eq_refl
l32: $ GG ⇒ ra_npis u_K v_nf ∈ lrel $ by x1_eq_npis [#16, l30, l31]
l33: $ GG ⇒ u_nf = v_nf $ by lrel_npis_det [#8, l32]
l34: $ GG ⇒ v_nf = w4 $ by eq_sym [#12]
l35: $ GG ⇒ q4 = v_nf $ by eq_trans [#4, l33]
l36: $ GG ⇒ q4 = w4 $ by eq_trans [l35, l34]

lemma y2_nfields_c1 (GG: hyps) (q1 q2 q3 q4 w4 u_D u_b u_P u_T u_i u_c u_nf u_F u_K u_C: set):
  $ GG ⇒ q1 = u_D ∧ q2 = u_i ∧ q3 = u_c ∧ q4 = u_nf ∧ ra_ind_data u_D u_b u_P u_T ∈ lrel ∧ ra_nth_ty u_T u_i u_F u_C ∈ lrel ∧ ra_nth_ctor u_C u_c u_K ∈ lrel ∧ ra_npis u_K u_nf ∈ lrel $ > $ GG ⇒ ra_nfields q1 q2 q3 w4 ∈ lrel $ > $ GG ⇒ q4 = w4 $
----
l1: $ GG ⇒ ∃ a ∃ b ∃ d ∃ e ∃ f ∃ g ∃ h ∃ i ∃ j ∃ k (q1 = a ∧ q2 = f ∧ q3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f i k ∈ lrel ∧ ra_nth_ctor k g j ∈ lrel ∧ ra_npis j h ∈ lrel) $ by lrel_nfields_cases [#2]
l2: $ GG , q1 = a ∧ q2 = f ∧ q3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f i k ∈ lrel ∧ ra_nth_ctor k g j ∈ lrel ∧ ra_npis j h ∈ lrel ⇒ q1 = a ∧ q2 = f ∧ q3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_nth_ty e f i k ∈ lrel ∧ ra_nth_ctor k g j ∈ lrel ∧ ra_npis j h ∈ lrel $ by ax
