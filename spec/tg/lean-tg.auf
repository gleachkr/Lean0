lemma y1_d_bmul_0 (G: hyps) {a_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ ∈ cl_bmul_0 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x ∊ cl_bmul_0 ⇒ x ∊ cl_bmul_0 $ by ax
l2: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x ∊ cl_bmul_0 ⇒ ∃ y (x = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bmul y ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by y1_e_bmul_0 [l6, l7]
l9: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x ∊ cl_bmul_0 ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) $ by wcel_elim [#1, l9]

