l88: $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_nil ∪ (cl_rst_ty ∪ (cl_rst_ctor ∪ (cl_rst_app ∪ (cl_rst_lam ∪ (cl_rst_pi ∪ (cl_rst_proj ∪ cl_rst_refl)))))) → ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) ∨ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_rehead S X2 k_v e_v e2 ∈ lrel) ∨ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) ∨ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by imp_intro [l87]
l89: $ G ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) ∨ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_rehead S X2 k_v e_v e2 ∈ lrel) ∨ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) ∨ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by imp_elim [l88, #1]

lemma y1_e_nst_hit_z (G: hyps) {X S Y e_v e2 N I i_v j_v d_v np na npi r_v a_v t_v: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16: set):
  $ G ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V1 V13) (scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V4 V12) (scons (ra_add V13 V14 V12) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V1 V2) (scons (ra_spine V2 V4 V14) (scons (ra_add V11 V9 V15) (scons (ra_add V10 V15 V16) (scons (ra_pargs ⟨ kc_bvar , scons V16 ∅ ⟩ V10 V11 V3) (scons (ra_rehead V2 V3 V14 V4 V5) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ V9 V10 V11 V4 V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V1 V13) (scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V4 V12) (scons (ra_add V13 V14 V12) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V1 V2) (scons (ra_spine V2 V4 V14) (scons (ra_add V11 V9 V15) (scons (ra_add V10 V15 V16) (scons (ra_pargs ⟨ kc_bvar , scons V16 ∅ ⟩ V10 V11 V3) (scons (ra_rehead V2 V3 V14 V4 V5) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ V9 V10 V11 V4 V5 ⟩ = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V1 V13) (scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V4 V12) (scons (ra_add V13 V14 V12) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V1 V2) (scons (ra_spine V2 V4 V14) (scons (ra_add V11 V9 V15) (scons (ra_add V10 V15 V16) (scons (ra_pargs ⟨ kc_bvar , scons V16 ∅ ⟩ V10 V11 V3) (scons (ra_rehead V2 V3 V14 V4 V5) ∅))))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nst_hit t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_nst_hit ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ V9 V10 V11 V4 V5) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V1 V13) (scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V4 V12) (scons (ra_add V13 V14 V12) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V1 V2) (scons (ra_spine V2 V4 V14) (scons (ra_add V11 V9 V15) (scons (ra_add V10 V15 V16) (scons (ra_pargs ⟨ kc_bvar , scons V16 ∅ ⟩ V10 V11 V3) (scons (ra_rehead V2 V3 V14 V4 V5) ∅)))))))) ∧ ra_nst_hit t1 t2 t3 t4 t5 t6 = ra_nst_hit ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ V9 V10 V11 V4 V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V1 V13) (scons (ra_spine ⟨ kc_ind_ty , scons V7 (scons V8 ∅) ⟩ V4 V12) (scons (ra_add V13 V14 V12) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V1 V2) (scons (ra_spine V2 V4 V14) (scons (ra_add V11 V9 V15) (scons (ra_add V10 V15 V16) (scons (ra_pargs ⟨ kc_bvar , scons V16 ∅ ⟩ V10 V11 V3) (scons (ra_rehead V2 V3 V14 V4 V5) ∅)))))))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_nst_hit t1 t2 t3 t4 t5 t6 = ra_nst_hit ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ V9 V10 V11 V4 V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
