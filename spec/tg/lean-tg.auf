lemma y2_ind_arity_d1 (GG: hyps) (o q1 q2 q3 q4 w2 w3 w4: set):
  $ GG ⇒ ⟨ o , ra_ind_arity q1 q2 q3 q4 ⟩ ∈ cl_ind_arity_i $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel $ > $ GG ⇒ ra_ind_arity q1 w2 w3 w4 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG , q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel ⇒ q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel $ by ax
l2: $ GG , q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel ⇒ ra_ind_arity q1 w2 w3 w4 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by y2_ind_arity_c1 [l1, l2]
l4: $ GG ⇒ q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ h (q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l4]
l6: $ GG ⇒ ∀ g ∀ h (q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l5]
l7: $ GG ⇒ ∀ f ∀ g ∀ h (q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l6]
l8: $ GG ⇒ ∀ e ∀ f ∀ g ∀ h (q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l7]
l9: $ GG ⇒ ∀ d ∀ e ∀ f ∀ g ∀ h (q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l8]
l10: $ GG ⇒ ∀ b ∀ d ∀ e ∀ f ∀ g ∀ h (q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l9]
l11: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e ∀ f ∀ g ∀ h (q1 = a ∧ q2 = f ∧ q3 = g ∧ q4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l10]
l12: $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by y2_ind_arity_i1 [#1, #2, l11]

lemma y2_ind_arity_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel → c ∊ y2_P_ind_arity lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ c = ra_ind_arity x1 x2 x3 x4 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_ind_arity x1 x2 x3 x4 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , ra_ind_arity x1 x2 x3 x4 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , ra_ind_arity x1 x2 x3 x4 ⟩ ∈ pr_ind_arity $ by lprog_ind_arity_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ ra_ind_arity x1 x6 x7 x8 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ ⟨ o , ra_ind_arity x1 x2 x3 x4 ⟩ ∈ cl_ind_arity_i $ by lprog_ind_arity_pr [l5]
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 , ra_ind_arity x1 x6 x7 x8 ∈ lrel ⇒ x2 = x6 ∧ x3 = x7 ∧ x4 = x8 $ by y2_ind_arity_d1 [l9, l7, l8]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 ⇒ ra_ind_arity x1 x6 x7 x8 ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8 $ by imp_intro [l10]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 ⇒ ∀ x8 (⟨ kr_ind_arity , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8) $ by all_intro [l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 ⇒ ∀ x7 ∀ x8 (⟨ kr_ind_arity , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8) $ by all_intro [l12]
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel , c = ra_ind_arity x1 x2 x3 x4 ⇒ ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_arity , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8) $ by all_intro [l13]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel ⇒ c = ⟨ kr_ind_arity , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_arity , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8) $ by imp_intro [l14]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel ⇒ ∀ x4 (c = ⟨ kr_ind_arity , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_arity , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)) $ by all_intro [l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel ⇒ ∀ x3 ∀ x4 (c = ⟨ kr_ind_arity , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_arity , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)) $ by all_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel ⇒ ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_ind_arity , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_arity , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)) $ by all_intro [l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_ind_arity , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_arity , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)) $ by all_intro [l18]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel ⇒ c ∊ y2_P_ind_arity lrel $ by cab_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel → c ∊ y2_P_ind_arity lrel $ by imp_intro [l20]
l22: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel → c ∊ y2_P_ind_arity lrel $ by imp_intro [l21]
l23: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel → c ∊ y2_P_ind_arity lrel) $ by all_intro [l22]
l24: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel → c ∊ y2_P_ind_arity lrel) $ by all_intro [l23]

lemma y2_ind_arity_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_ind_arity lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ind_arity lrel → c ∊ y2_P_ind_arity lrel) $ by y2_ind_arity_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_ind_arity lrel $ by horn_ind [l1, l2]

lrel_ind_arity_det
------------------
l1: $ G ⇒ horn lprog ⊆ y2_P_ind_arity lrel $ by y2_ind_arity_in
l2: $ G ⇒ ra_ind_arity t1 u2 u3 u4 ∈ y2_P_ind_arity lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u2 = v2 ∧ u3 = v3 ∧ u4 = v4 $ by y2_ind_arity_ih [l2, #2]

--| The atoms of `nidx` whose variants in `L` with the same inputs have the same outputs.
def y2_P_nidx (L: class) (.c .x1 .x2 .x3 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_nidx , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nidx , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ L → x3 = x6))} $

lemma y2_nidx_ih (GG: hyps) (q1 q2 q3 w3: set):
  $ GG ⇒ ra_nidx q1 q2 q3 ∈ y2_P_nidx lrel $ > $ GG ⇒ ra_nidx q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ c ∊ y2_P_nidx lrel $ by ax
l2: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_nidx , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nidx , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_nidx , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nidx , scons q1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ ∀ x3 (c = ⟨ kr_nidx , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nidx , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ c = ⟨ kr_nidx , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 (⟨ kr_nidx , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by all_elim [l4]
l6: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ c = ra_nidx q1 q2 q3 $ by ax
l7: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ ∀ x6 (⟨ kr_nidx , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ ra_nidx q1 q2 w3 ∈ lrel → q3 = w3 $ by all_elim [l7]
l9: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ ra_nidx q1 q2 w3 ∈ lrel $ by weaken [#2]
l10: $ GG , c = ra_nidx q1 q2 q3 , c ∊ y2_P_nidx lrel ⇒ q3 = w3 $ by imp_elim [l8, l9]
l11: $ GG ⇒ q3 = w3 $ by wcel_elim [#1, l10]

lemma y2_nidx_ihc (GG: hyps) (Q1 Q2 Q3 W3: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset W3 $ > $ GG ⇒ ra_nidx Q1 Q2 Q3 ∈ y2_P_nidx lrel $ > $ GG ⇒ ra_nidx Q1 Q2 W3 ∈ lrel $ > $ GG ⇒ Q3 = W3 $
