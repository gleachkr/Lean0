lemma y1_k_inst_closed (G: hyps): $ G ⇒ cl_inst_closed ⊆ y1_lab kr_inst (suc kr_inst) $
----
l1: $ G , x ∊ cl_inst_closed ⇒ x ∊ cl_inst_closed $ by ax
l2: $ G , x ∊ cl_inst_closed ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ kr_inst ∈ ω $ by x1_kr_inst
l5: $ G , x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩ ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y u) (scons (ra_le y z) ∅) , ra_inst z u v u ⟩) ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_inst_closed ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_inst_closed ⊆ y1_lab kr_inst (suc kr_inst) $ by subset_intro [l12]

