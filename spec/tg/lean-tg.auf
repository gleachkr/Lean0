l25: $ G ⇒ ks_tys ∈ ω $ by v1_ks_tys
l26: $ G ⇒ isset ks_tys $ by wcel_isset [l25]
l27: $ G , (t = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x ∃ y ∃ u (t = ⟨ kc_tcons , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors ∧ u ∊ ofsort lsig lopen ks_tys) ⇒ (t = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x ∃ y ∃ u (t = ⟨ kc_tcons , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors ∧ u ∊ ofsort lsig lopen ks_tys) $ by ax
l28: $ G ⇒ ((t = ⟨ kc_tnil , ∅ ⟩) ∨ ∃ x ∃ y ∃ u (t = ⟨ kc_tcons , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors ∧ u ∊ ofsort lsig lopen ks_tys)) → v1_d_tys u x y t $ by imp_intro [l27]
l29: $ G ⇒ (t = ⟨ kc_tnil , ∅ ⟩) → v1_d_tys u x y t $ by v1_imp_or_l [l28]
l30: $ G ⇒ (∃ x ∃ y ∃ u (t = ⟨ kc_tcons , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors ∧ u ∊ ofsort lsig lopen ks_tys)) → v1_d_tys u x y t $ by v1_imp_or_r [l28]
