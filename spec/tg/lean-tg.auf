l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q1 (scons Q2 (scons Q3 ∅)) = scons a (scons b (scons d ∅)) $ by scons_eq [l5, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ kr_nidx = kr_nidx $ by eq_refl
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_nidx Q1 Q2 Q3 = ra_nidx a b d $ by opair_eq [l13, l12]
