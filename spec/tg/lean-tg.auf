l8: $ G , ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l9: $ G , ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ x ∊ y1_lab kr_eta_ok (suc kr_eta_ok) $ by ex_elim [l8, l7]
l10: $ G , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l11: $ G , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ x ∊ y1_lab kr_eta_ok (suc kr_eta_ok) $ by ex_elim [l10, l9]
l12: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l13: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ x ∊ y1_lab kr_eta_ok (suc kr_eta_ok) $ by ex_elim [l12, l11]
l14: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l15: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ x ∊ y1_lab kr_eta_ok (suc kr_eta_ok) $ by ex_elim [l14, l13]
l16: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l17: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ x ∊ y1_lab kr_eta_ok (suc kr_eta_ok) $ by ex_elim [l16, l15]
l18: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l19: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ x ∊ y1_lab kr_eta_ok (suc kr_eta_ok) $ by ex_elim [l18, l17]
