lemma y1_o_minors (G: hyps) {D np n_v k_v i_v nc k2 F C T M1 M2 M: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ pr_minors $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_cons ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_cons $ by ax
l2: $ G , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_cons ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by y1_d_minors_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_cons → ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_nil ∪ cl_minors_cons ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_nil ∪ cl_minors_cons $ by ax
