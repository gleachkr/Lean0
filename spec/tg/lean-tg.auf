l171: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ mn ∃ b_v ∃ f_v ∃ Y ∃ X1 ∃ X2 ∃ X3 ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = A ∧ t11 = ⟨ kc_app , scons X3 (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y X2 ni A X3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v nf a_v ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add a_v mn b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons j_v (scons v_v ∅)) ⟩ b_v np X1 ∈ lrel ∧ ra_pargs X1 a_v mn X2 ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by ex_intro [l170]

lemma y1_d_ihval_app (G: hyps) {D np n_v m_v v_v nf fld y_v j_v ni k_v a_v mn b_v f_v Y X1 X2 X3 U A: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set):
  $ G ⇒ ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ ∈ cl_ihval_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ mn ∃ b_v ∃ f_v ∃ Y ∃ X1 ∃ X2 ∃ X3 ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = A ∧ t11 = ⟨ kc_app , scons X3 (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y X2 ni A X3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v nf a_v ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add a_v mn b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons j_v (scons v_v ∅)) ⟩ b_v np X1 ∈ lrel ∧ ra_pargs X1 a_v mn X2 ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x ∊ cl_ihval_app ⇒ x ∊ cl_ihval_app $ by ax
l2: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x ∊ cl_ihval_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ mn ∃ b_v ∃ f_v ∃ Y ∃ X1 ∃ X2 ∃ X3 ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = A ∧ t11 = ⟨ kc_app , scons X3 (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y X2 ni A X3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v nf a_v ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add a_v mn b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons j_v (scons v_v ∅)) ⟩ b_v np X1 ∈ lrel ∧ ra_pargs X1 a_v mn X2 ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by y1_e_ihval_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , ∃ p (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩) ⇒ ∃ p (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩) $ by ax
