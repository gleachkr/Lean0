lemma y1_p_eta_ok (G: hyps): $ G ⇒ pr_eta_ok ⊆ y1_lab kr_eta_ok (suc kr_eta_ok) $
----
l1: $ G ⇒ pr_eta_ok ⊆ y1_lab kr_eta_ok (suc kr_eta_ok) $ by y1_k_eta_ok_i

lemma y1_k_projs_z (G: hyps): $ G ⇒ cl_projs_z ⊆ y1_lab kr_projs (suc kr_projs) $
----
l1: $ G , x ∊ cl_projs_z ⇒ x ∊ cl_projs_z $ by ax
l2: $ G , x ∊ cl_projs_z ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ kr_projs ∈ ω $ by x1_kr_projs
l5: $ G , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_projs_z ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_projs_z ⊆ y1_lab kr_projs (suc kr_projs) $ by subset_intro [l10]

lemma y1_k_projs_s (G: hyps): $ G ⇒ cl_projs_s ⊆ y1_lab kr_projs (suc kr_projs) $
----
l1: $ G , x ∊ cl_projs_s ⇒ x ∊ cl_projs_s $ by ax
l2: $ G , x ∊ cl_projs_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ kr_projs ∈ ω $ by x1_kr_projs
l5: $ G , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by ex_elim [l6, l5]
l8: $ G , ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by ex_elim [l8, l7]
l10: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by ex_elim [l10, l9]
l12: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by ex_elim [l12, l11]
l14: $ G , x ∊ cl_projs_s ⇒ x ∊ y1_lab kr_projs (suc kr_projs) $ by ex_elim [l2, l13]
l15: $ G ⇒ cl_projs_s ⊆ y1_lab kr_projs (suc kr_projs) $ by subset_intro [l14]

lemma y1_p_projs (G: hyps): $ G ⇒ pr_projs ⊆ y1_lab kr_projs (suc kr_projs) $
----
l1: $ G ⇒ cl_projs_s ⊆ y1_lab kr_projs (suc kr_projs) $ by y1_k_projs_s
l2: $ G ⇒ cl_projs_z ⊆ y1_lab kr_projs (suc kr_projs) $ by y1_k_projs_z
l3: $ G ⇒ pr_projs ⊆ y1_lab kr_projs (suc kr_projs) $ by cun_least [l2, l1]

lemma y1_k_clift_nil (G: hyps): $ G ⇒ cl_clift_nil ⊆ y1_lab kr_clift (suc kr_clift) $
----
l1: $ G , x ∊ cl_clift_nil ⇒ x ∊ cl_clift_nil $ by ax
l2: $ G , x ∊ cl_clift_nil ⇒ ∃ y (x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ kr_clift ∈ ω $ by x1_kr_clift
l5: $ G , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_clift_nil ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_clift_nil ⊆ y1_lab kr_clift (suc kr_clift) $ by subset_intro [l6]

lemma y1_k_clift_cons (G: hyps): $ G ⇒ cl_clift_cons ⊆ y1_lab kr_clift (suc kr_clift) $
----
l1: $ G , x ∊ cl_clift_cons ⇒ x ∊ cl_clift_cons $ by ax
l2: $ G , x ∊ cl_clift_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ kr_clift ∈ ω $ by x1_kr_clift
l5: $ G , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_clift_cons ⇒ x ∊ y1_lab kr_clift (suc kr_clift) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_clift_cons ⊆ y1_lab kr_clift (suc kr_clift) $ by subset_intro [l16]

lemma y1_p_clift (G: hyps): $ G ⇒ pr_clift ⊆ y1_lab kr_clift (suc kr_clift) $
----
l1: $ G ⇒ cl_clift_cons ⊆ y1_lab kr_clift (suc kr_clift) $ by y1_k_clift_cons
l2: $ G ⇒ cl_clift_nil ⊆ y1_lab kr_clift (suc kr_clift) $ by y1_k_clift_nil
l3: $ G ⇒ pr_clift ⊆ y1_lab kr_clift (suc kr_clift) $ by cun_least [l2, l1]

lemma y1_k_psplit_z (G: hyps): $ G ⇒ cl_psplit_z ⊆ y1_lab kr_psplit (suc kr_psplit) $
----
l1: $ G , x ∊ cl_psplit_z ⇒ x ∊ cl_psplit_z $ by ax
l2: $ G , x ∊ cl_psplit_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ kr_psplit ∈ ω $ by x1_kr_psplit
l5: $ G , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩) ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_psplit_z ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_psplit_z ⊆ y1_lab kr_psplit (suc kr_psplit) $ by subset_intro [l8]

lemma y1_k_psplit_s (G: hyps): $ G ⇒ cl_psplit_s ⊆ y1_lab kr_psplit (suc kr_psplit) $
----
l1: $ G , x ∊ cl_psplit_s ⇒ x ∊ cl_psplit_s $ by ax
l2: $ G , x ∊ cl_psplit_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ kr_psplit ∈ ω $ by x1_kr_psplit
l5: $ G , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_psplit_s ⇒ x ∊ y1_lab kr_psplit (suc kr_psplit) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_psplit_s ⊆ y1_lab kr_psplit (suc kr_psplit) $ by subset_intro [l16]

lemma y1_p_psplit (G: hyps): $ G ⇒ pr_psplit ⊆ y1_lab kr_psplit (suc kr_psplit) $
----
l1: $ G ⇒ cl_psplit_s ⊆ y1_lab kr_psplit (suc kr_psplit) $ by y1_k_psplit_s
l2: $ G ⇒ cl_psplit_z ⊆ y1_lab kr_psplit (suc kr_psplit) $ by y1_k_psplit_z
l3: $ G ⇒ pr_psplit ⊆ y1_lab kr_psplit (suc kr_psplit) $ by cun_least [l2, l1]

lemma y1_k_iota_tel_i (G: hyps): $ G ⇒ cl_iota_tel_i ⊆ y1_lab kr_iota_tel (suc kr_iota_tel) $
----
l1: $ G , x ∊ cl_iota_tel_i ⇒ x ∊ cl_iota_tel_i $ by ax
l2: $ G , x ∊ cl_iota_tel_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p ∃ q ∃ r ∃ t (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u c) (scons (ra_ntys v f g) (scons (ra_motives y c w ⟨ kc_nz , ∅ ⟩ v k) (scons (ra_minors y c f ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v d) (scons (ra_nth_ty v a o t) (scons (ra_nth_ctor t b p) (scons (ra_npis p j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c p q) (scons (ra_psplit j q ⟨ kc_nil , ∅ ⟩ e r) (scons (ra_add g f i) (scons (ra_clift i e h) (scons (ra_capp k u l) (scons (ra_capp d l m) (scons (ra_capp h m n) ∅)))))))))))))) , ra_iota_tel y w a b e r j n ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u c) (scons (ra_ntys v f g) (scons (ra_motives y c w ⟨ kc_nz , ∅ ⟩ v k) (scons (ra_minors y c f ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v d) (scons (ra_nth_ty v a o t) (scons (ra_nth_ctor t b p) (scons (ra_npis p j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c p q) (scons (ra_psplit j q ⟨ kc_nil , ∅ ⟩ e r) (scons (ra_add g f i) (scons (ra_clift i e h) (scons (ra_capp k u l) (scons (ra_capp d l m) (scons (ra_capp h m n) ∅)))))))))))))) , ra_iota_tel y w a b e r j n ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u c) (scons (ra_ntys v f g) (scons (ra_motives y c w ⟨ kc_nz , ∅ ⟩ v k) (scons (ra_minors y c f ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v d) (scons (ra_nth_ty v a o t) (scons (ra_nth_ctor t b p) (scons (ra_npis p j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c p q) (scons (ra_psplit j q ⟨ kc_nil , ∅ ⟩ e r) (scons (ra_add g f i) (scons (ra_clift i e h) (scons (ra_capp k u l) (scons (ra_capp d l m) (scons (ra_capp h m n) ∅)))))))))))))) , ra_iota_tel y w a b e r j n ⟩ $ by ax
