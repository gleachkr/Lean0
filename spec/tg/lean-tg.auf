l5: $ G , x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_closed_app ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_closed_app ⊆ y1_lab kr_closed (suc kr_closed) $ by subset_intro [l10]

