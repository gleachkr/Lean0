l14: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_badd_01 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = ⟨ scons (ra_badd V1 V2 V3) ∅ , ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_badd V1 V2 V3) ∅ , ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_badd t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_badd V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_badd t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_badd V1 V2 V3) ∅ ∧ ra_badd t1 t2 t3 = ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_badd V1 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_badd t1 t2 t3 = ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_bd1 , scons V3 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_bd1 , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_badd ∈ ω $ by x1_kr_badd
l23: $ G ⇒ isset kr_badd $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_badd = kr_badd ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_badd V1 V2 V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_badd V1 V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_badd V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_badd V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ra_badd V1 V2 V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ra_badd V1 V2 V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ra_badd V1 V2 V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ c_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd V1 V2 c_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd V1 b_v c_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $ by ex_intro [l44]

lemma y1_d_badd_01 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ ∈ cl_badd_01 $ > $ G ⇒ crn pp ⊆ lrel $ >
