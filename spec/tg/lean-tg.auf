l46: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_nat_blk → v1_d_ctors x y t $ by v1_skip_nat_blk [l16, l45]
l47: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_proj → v1_d_ctors x y t $ by v1_skip_proj [l8, l46]
l48: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_rec → v1_d_ctors x y t $ by v1_skip_ind_rec [l8, l47]
l49: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_ctor → v1_d_ctors x y t $ by v1_skip_ind_ctor [l8, l48]
l50: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_ty → v1_d_ctors x y t $ by v1_skip_ind_ty [l8, l49]
l51: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_mkn → v1_d_ctors x y t $ by v1_skip_ind_mkn [l18, l50]
l52: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ccons → v1_d_ctors x y t $ by v1_take_ccons [l34, l51]
l53: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_cnil → v1_d_ctors x y t $ by v1_take_cnil [l31, l52]
l54: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_tcons → v1_d_ctors x y t $ by v1_skip_tcons [l20, l53]
l55: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_tnil → v1_d_ctors x y t $ by v1_skip_tnil [l20, l54]
