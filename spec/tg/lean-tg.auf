l43: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V6 (scons ⟨ kc_srt , scons V7 ∅ ⟩ (scons ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∅)))))) $ by and_elim_r [l42]
l44: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V6 (scons ⟨ kc_srt , scons V7 ∅ ⟩ (scons ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∅))))) $ by y1_scons_inj [l43, l22, l36, l21, l35]
