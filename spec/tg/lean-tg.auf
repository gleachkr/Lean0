l13: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ isset K $ by weaken [#2]
l14: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ K = k $ by y1_key [l10, l13]
l15: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ k = K $ by eq_sym [l14]
l16: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ k ∊ H $ by and_elim_l [l12]
l17: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ k ∈ H $ by welc_wcel [l16]
l18: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ K ∈ H $ by wcel_eq_l [l15, l17]
l19: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ L ⊆ k $ by and_elim_r [l12]
l20: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ L ⊆ K $ by subset_eq_r [l15, l19]
l21: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms , y = ⟨ k , u ⟩ , k ∊ ω , u ∊ fseq (trees ω) ⇒ K ∈ H ∧ L ⊆ K $ by and_intro [l18, l20]
l22: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms ⇒ y ∊ latoms $ by ax
l23: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms , z = ⟨ x , y ⟩ , x ∊ fseq latoms , y ∊ latoms ⇒ K ∈ H ∧ L ⊆ K $ by cxp_elim [l22, l21]
l24: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms ⇒ z ∊ fseq latoms × latoms $ by ax
l25: $ G , z = ⟨ P , ⟨ K , S ⟩ ⟩ , z ∊ fseq latoms × latoms ⇒ K ∈ H ∧ L ⊆ K $ by cxp_elim [l24, l23]
l26: $ G ⇒ K ∈ H ∧ L ⊆ K $ by wcel_elim [l2, l25]

--| The class of all sets: argument lists are sequences over it.
def y1_vv (.x: set): class = $ {x | x = x} $

lemma y1_vv_in (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ y1_vv $
----
l1: $ G , x = A ⇒ x = x $ by eq_refl
l2: $ G , x = A ⇒ x ∊ y1_vv $ by cab_intro [l1]
l3: $ G , x = A ⇒ x = A $ by ax
l4: $ G , x = A ⇒ A ∈ y1_vv $ by wcel_intro [l3, l2]
l5: $ G ⇒ A ∈ y1_vv $ by isset_elim [#1, l4]

lemma y1_fs (G: hyps) (A S: class): $ G ⇒ isset A $ > $ G ⇒ S ∈ fseq y1_vv $ > $ G ⇒ scons A S ∈ fseq y1_vv $
----
l1: $ G ⇒ A ∈ y1_vv $ by y1_vv_in [#1]
l2: $ G ⇒ scons A S ∈ fseq y1_vv $ by v1_scons_fseq_c [l1, #2]

--| Class form of `scons_inj`, for sequences.
lemma y1_scons_inj (G: hyps) (A B S T: class):
  $ G ⇒ scons A S = scons B T $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ >
  $ G ⇒ S ∈ fseq y1_vv $ > $ G ⇒ T ∈ fseq y1_vv $ > $ G ⇒ A = B ∧ S = T $
----
l1: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ c ∊ fseq y1_vv $ by ax
l2: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ d ∊ fseq y1_vv $ by ax
l3: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ rel c $ by fseq_rel [l1]
l4: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ rel d $ by fseq_rel [l2]
l5: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ a = A $ by ax
l6: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ b = B $ by ax
l7: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ c = S $ by ax
l8: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ d = T $ by ax
l9: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ scons a c = scons A S $ by scons_eq [l5, l7]
l10: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ scons b d = scons B T $ by scons_eq [l6, l8]
l11: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ scons A S = scons B T $ by weaken [#1]
l12: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ scons a c = scons B T $ by eq_trans [l9, l11]
l13: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ scons B T = scons b d $ by eq_sym [l10]
l14: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ scons a c = scons b d $ by eq_trans [l12, l13]
l15: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ a = b ∧ c = d $ by scons_inj [l3, l4, l14]
l16: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ a = b $ by and_elim_l [l15]
l17: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ c = d $ by and_elim_r [l15]
l18: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ A = a $ by eq_sym [l5]
l19: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ A = b $ by eq_trans [l18, l16]
l20: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ A = B $ by eq_trans [l19, l6]
l21: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ S = c $ by eq_sym [l7]
l22: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ S = d $ by eq_trans [l21, l17]
l23: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ S = T $ by eq_trans [l22, l8]
l24: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv , d = T , d ∊ fseq y1_vv ⇒ A = B ∧ S = T $ by and_intro [l20, l23]
l25: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv ⇒ T ∈ fseq y1_vv $ by weaken [#5]
l26: $ G , a = A , b = B , c = S , c ∊ fseq y1_vv ⇒ A = B ∧ S = T $ by wcel_elim [l25, l24]
l27: $ G , a = A , b = B ⇒ S ∈ fseq y1_vv $ by weaken [#4]
l28: $ G , a = A , b = B ⇒ A = B ∧ S = T $ by wcel_elim [l27, l26]
l29: $ G , a = A ⇒ isset B $ by weaken [#3]
l30: $ G , a = A ⇒ A = B ∧ S = T $ by isset_elim [l29, l28]
l31: $ G ⇒ A = B ∧ S = T $ by isset_elim [#2, l30]

-- The atoms of each relation: congruence and substitution (for the normalizer).

--| @congr
lemma y1_cg_le (A1 B1 A2 B2: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ >
  $ ra_le A1 A2 ≐ ra_le B1 B2 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A2 ∅ ≐ scons B2 ∅ $ by scons_congr [#2, l1]
l3: $ scons A1 (scons A2 ∅) ≐ scons B1 (scons B2 ∅) $ by scons_congr [#1, l2]
l4: $ kr_le ≐ kr_le $ by ceqt_refl
l5: $ ra_le A1 A2 ≐ ra_le B1 B2 $ by opair_congr [l4, l3]

--| @rewrite
lemma y1_sb_le {x: set} (t: set x) (A1 A2: class x):
  $ (⟦ x / t ⟧ (ra_le A1 A2)) ≐ ra_le (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_le , scons A1 (scons A2 ∅) ⟩) ≐ ⟨ kr_le , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) ∅) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_add (A1 B1 A2 B2 A3 B3: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ >
  $ ra_add A1 A2 A3 ≐ ra_add B1 B2 B3 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A3 ∅ ≐ scons B3 ∅ $ by scons_congr [#3, l1]
l3: $ scons A2 (scons A3 ∅) ≐ scons B2 (scons B3 ∅) $ by scons_congr [#2, l2]
l4: $ scons A1 (scons A2 (scons A3 ∅)) ≐ scons B1 (scons B2 (scons B3 ∅)) $ by scons_congr [#1, l3]
l5: $ kr_add ≐ kr_add $ by ceqt_refl
l6: $ ra_add A1 A2 A3 ≐ ra_add B1 B2 B3 $ by opair_congr [l5, l4]

--| @rewrite
lemma y1_sb_add {x: set} (t: set x) (A1 A2 A3: class x):
  $ (⟦ x / t ⟧ (ra_add A1 A2 A3)) ≐ ra_add (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_add , scons A1 (scons A2 (scons A3 ∅)) ⟩) ≐ ⟨ kr_add , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) ∅)) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_lnth (A1 B1 A2 B2 A3 B3: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ >
  $ ra_lnth A1 A2 A3 ≐ ra_lnth B1 B2 B3 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A3 ∅ ≐ scons B3 ∅ $ by scons_congr [#3, l1]
l3: $ scons A2 (scons A3 ∅) ≐ scons B2 (scons B3 ∅) $ by scons_congr [#2, l2]
l4: $ scons A1 (scons A2 (scons A3 ∅)) ≐ scons B1 (scons B2 (scons B3 ∅)) $ by scons_congr [#1, l3]
l5: $ kr_lnth ≐ kr_lnth $ by ceqt_refl
l6: $ ra_lnth A1 A2 A3 ≐ ra_lnth B1 B2 B3 $ by opair_congr [l5, l4]

--| @rewrite
lemma y1_sb_lnth {x: set} (t: set x) (A1 A2 A3: class x):
  $ (⟦ x / t ⟧ (ra_lnth A1 A2 A3)) ≐ ra_lnth (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_lnth , scons A1 (scons A2 (scons A3 ∅)) ⟩) ≐ ⟨ kr_lnth , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) ∅)) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_linst (A1 B1 A2 B2 A3 B3: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ >
  $ ra_linst A1 A2 A3 ≐ ra_linst B1 B2 B3 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A3 ∅ ≐ scons B3 ∅ $ by scons_congr [#3, l1]
l3: $ scons A2 (scons A3 ∅) ≐ scons B2 (scons B3 ∅) $ by scons_congr [#2, l2]
l4: $ scons A1 (scons A2 (scons A3 ∅)) ≐ scons B1 (scons B2 (scons B3 ∅)) $ by scons_congr [#1, l3]
l5: $ kr_linst ≐ kr_linst $ by ceqt_refl
l6: $ ra_linst A1 A2 A3 ≐ ra_linst B1 B2 B3 $ by opair_congr [l5, l4]

--| @rewrite
lemma y1_sb_linst {x: set} (t: set x) (A1 A2 A3: class x):
  $ (⟦ x / t ⟧ (ra_linst A1 A2 A3)) ≐ ra_linst (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_linst , scons A1 (scons A2 (scons A3 ∅)) ⟩) ≐ ⟨ kr_linst , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) ∅)) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_lsubst (A1 B1 A2 B2 A3 B3 A4 B4: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ >
  $ ra_lsubst A1 A2 A3 A4 ≐ ra_lsubst B1 B2 B3 B4 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A4 ∅ ≐ scons B4 ∅ $ by scons_congr [#4, l1]
l3: $ scons A3 (scons A4 ∅) ≐ scons B3 (scons B4 ∅) $ by scons_congr [#3, l2]
l4: $ scons A2 (scons A3 (scons A4 ∅)) ≐ scons B2 (scons B3 (scons B4 ∅)) $ by scons_congr [#2, l3]
l5: $ scons A1 (scons A2 (scons A3 (scons A4 ∅))) ≐ scons B1 (scons B2 (scons B3 (scons B4 ∅))) $ by scons_congr [#1, l4]
l6: $ kr_lsubst ≐ kr_lsubst $ by ceqt_refl
l7: $ ra_lsubst A1 A2 A3 A4 ≐ ra_lsubst B1 B2 B3 B4 $ by opair_congr [l6, l5]

--| @rewrite
lemma y1_sb_lsubst {x: set} (t: set x) (A1 A2 A3 A4: class x):
  $ (⟦ x / t ⟧ (ra_lsubst A1 A2 A3 A4)) ≐ ra_lsubst (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_lsubst , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩) ≐ ⟨ kr_lsubst , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) ∅))) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_closed (A1 B1 A2 B2: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ >
  $ ra_closed A1 A2 ≐ ra_closed B1 B2 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A2 ∅ ≐ scons B2 ∅ $ by scons_congr [#2, l1]
l3: $ scons A1 (scons A2 ∅) ≐ scons B1 (scons B2 ∅) $ by scons_congr [#1, l2]
l4: $ kr_closed ≐ kr_closed $ by ceqt_refl
l5: $ ra_closed A1 A2 ≐ ra_closed B1 B2 $ by opair_congr [l4, l3]

--| @rewrite
lemma y1_sb_closed {x: set} (t: set x) (A1 A2: class x):
  $ (⟦ x / t ⟧ (ra_closed A1 A2)) ≐ ra_closed (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_closed , scons A1 (scons A2 ∅) ⟩) ≐ ⟨ kr_closed , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) ∅) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_lift (A1 B1 A2 B2 A3 B3 A4 B4: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ >
  $ ra_lift A1 A2 A3 A4 ≐ ra_lift B1 B2 B3 B4 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A4 ∅ ≐ scons B4 ∅ $ by scons_congr [#4, l1]
l3: $ scons A3 (scons A4 ∅) ≐ scons B3 (scons B4 ∅) $ by scons_congr [#3, l2]
l4: $ scons A2 (scons A3 (scons A4 ∅)) ≐ scons B2 (scons B3 (scons B4 ∅)) $ by scons_congr [#2, l3]
l5: $ scons A1 (scons A2 (scons A3 (scons A4 ∅))) ≐ scons B1 (scons B2 (scons B3 (scons B4 ∅))) $ by scons_congr [#1, l4]
l6: $ kr_lift ≐ kr_lift $ by ceqt_refl
l7: $ ra_lift A1 A2 A3 A4 ≐ ra_lift B1 B2 B3 B4 $ by opair_congr [l6, l5]

--| @rewrite
lemma y1_sb_lift {x: set} (t: set x) (A1 A2 A3 A4: class x):
  $ (⟦ x / t ⟧ (ra_lift A1 A2 A3 A4)) ≐ ra_lift (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_lift , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩) ≐ ⟨ kr_lift , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) ∅))) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_inst (A1 B1 A2 B2 A3 B3 A4 B4: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ >
  $ ra_inst A1 A2 A3 A4 ≐ ra_inst B1 B2 B3 B4 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A4 ∅ ≐ scons B4 ∅ $ by scons_congr [#4, l1]
l3: $ scons A3 (scons A4 ∅) ≐ scons B3 (scons B4 ∅) $ by scons_congr [#3, l2]
l4: $ scons A2 (scons A3 (scons A4 ∅)) ≐ scons B2 (scons B3 (scons B4 ∅)) $ by scons_congr [#2, l3]
l5: $ scons A1 (scons A2 (scons A3 (scons A4 ∅))) ≐ scons B1 (scons B2 (scons B3 (scons B4 ∅))) $ by scons_congr [#1, l4]
l6: $ kr_inst ≐ kr_inst $ by ceqt_refl
l7: $ ra_inst A1 A2 A3 A4 ≐ ra_inst B1 B2 B3 B4 $ by opair_congr [l6, l5]

--| @rewrite
lemma y1_sb_inst {x: set} (t: set x) (A1 A2 A3 A4: class x):
  $ (⟦ x / t ⟧ (ra_inst A1 A2 A3 A4)) ≐ ra_inst (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) (⟦ x / t ⟧ A4) $
----
l1: $ (⟦ x / t ⟧ ⟨ kr_inst , scons A1 (scons A2 (scons A3 (scons A4 ∅))) ⟩) ≐ ⟨ kr_inst , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) (scons (⟦ x / t ⟧ A3) (scons (⟦ x / t ⟧ A4) ∅))) ⟩ $ by ceqt_refl

--| @congr
lemma y1_cg_lookup (A1 B1 A2 B2 A3 B3: class):
  $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ >
  $ ra_lookup A1 A2 A3 ≐ ra_lookup B1 B2 B3 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
