lemma y2_nth_ty_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_nth_ty lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_nth_ty lrel → c ∊ y2_P_nth_ty lrel) $ by y2_nth_ty_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_nth_ty lrel $ by horn_ind [l1, l2]

lrel_nth_ty_det
---------------
l1: $ G ⇒ horn lprog ⊆ y2_P_nth_ty lrel $ by y2_nth_ty_in
l2: $ G ⇒ ra_nth_ty t1 t2 u3 u4 ∈ y2_P_nth_ty lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u3 = v3 ∧ u4 = v4 $ by y2_nth_ty_ih [l2, #2]

--| The atoms of `nth_ctor` whose variants in `L` with the same inputs have the same outputs.
def y2_P_nth_ctor (L: class) (.c .x1 .x2 .x3 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_nth_ctor , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nth_ctor , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ L → x3 = x6))} $

lemma y2_nth_ctor_ih (GG: hyps) (q1 q2 q3 w3: set):
  $ GG ⇒ ra_nth_ctor q1 q2 q3 ∈ y2_P_nth_ctor lrel $ > $ GG ⇒ ra_nth_ctor q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ c ∊ y2_P_nth_ctor lrel $ by ax
l2: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_nth_ctor , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nth_ctor , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_nth_ctor , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nth_ctor , scons q1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ ∀ x3 (c = ⟨ kr_nth_ctor , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_nth_ctor , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ c = ⟨ kr_nth_ctor , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 (⟨ kr_nth_ctor , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by all_elim [l4]
l6: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ c = ra_nth_ctor q1 q2 q3 $ by ax
l7: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ ∀ x6 (⟨ kr_nth_ctor , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ ra_nth_ctor q1 q2 w3 ∈ lrel → q3 = w3 $ by all_elim [l7]
l9: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ ra_nth_ctor q1 q2 w3 ∈ lrel $ by weaken [#2]
l10: $ GG , c = ra_nth_ctor q1 q2 q3 , c ∊ y2_P_nth_ctor lrel ⇒ q3 = w3 $ by imp_elim [l8, l9]
l11: $ GG ⇒ q3 = w3 $ by wcel_elim [#1, l10]

lemma y2_nth_ctor_ihc (GG: hyps) (Q1 Q2 Q3 W3: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset W3 $ > $ GG ⇒ ra_nth_ctor Q1 Q2 Q3 ∈ y2_P_nth_ctor lrel $ > $ GG ⇒ ra_nth_ctor Q1 Q2 W3 ∈ lrel $ > $ GG ⇒ Q3 = W3 $
----
l1: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ d = Q3 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ e = W3 $ by ax
l5: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q1 = a $ by eq_sym [l1]
l6: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q2 = b $ by eq_sym [l2]
l7: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = d $ by eq_sym [l3]
l8: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ W3 = e $ by eq_sym [l4]
l9: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ∅ = ∅ $ by eq_refl
l10: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q3 ∅ = scons d ∅ $ by scons_eq [l7, l9]
l11: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q2 (scons Q3 ∅) = scons b (scons d ∅) $ by scons_eq [l6, l10]
l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q1 (scons Q2 (scons Q3 ∅)) = scons a (scons b (scons d ∅)) $ by scons_eq [l5, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ kr_nth_ctor = kr_nth_ctor $ by eq_refl
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_nth_ctor Q1 Q2 Q3 = ra_nth_ctor a b d $ by opair_eq [l13, l12]
l15: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_nth_ctor Q1 Q2 Q3 ∈ y2_P_nth_ctor lrel $ by weaken [#5]
l16: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_nth_ctor a b d ∈ y2_P_nth_ctor lrel $ by wcel_eq_l [l14, l15]
l17: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_nth_ctor Q1 Q2 W3 ∈ lrel $ by weaken [#6]
l18: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_nth_ctor a b e ∈ lrel $ by x1_eq_nth_ctor [l17, l5, l6, l8]
l19: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ d = e $ by y2_nth_ctor_ih [l16, l18]
l20: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = e $ by eq_trans [l7, l19]
l21: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = W3 $ by eq_trans [l20, l4]
l22: $ GG , a = Q1 , b = Q2 , d = Q3 ⇒ Q3 = W3 $ by isset_elim [#4, l21]
l23: $ GG , a = Q1 , b = Q2 ⇒ Q3 = W3 $ by isset_elim [#3, l22]
l24: $ GG , a = Q1 ⇒ Q3 = W3 $ by isset_elim [#2, l23]
l25: $ GG ⇒ Q3 = W3 $ by isset_elim [#1, l24]

