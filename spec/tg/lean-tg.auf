ofsort_ctors_cases
------------------
l1: $ G ⇒ ⟨ ks_ctors , t ⟩ ∈ sorted lsig lopen $ by ofsort_elim [#1]
l2: $ G ⇒ ks_ctors ∈ ω $ by v1_ks_ctors
l3: $ G ⇒ isset ks_ctors $ by wcel_isset [l2]
l4: $ G , k = ks_ctors ⇒ k = ks_ctors $ by ax
l5: $ G , k = ks_ctors ⇒ ks_ctors = k $ by eq_sym [l4]
l6: $ G , k = ks_ctors ⇒ t = t $ by eq_refl
l7: $ G , k = ks_ctors ⇒ ⟨ ks_ctors , t ⟩ = ⟨ k , t ⟩ $ by opair_eq [l5, l6]
l8: $ G , k = ks_ctors ⇒ ⟨ ks_ctors , t ⟩ ∈ sorted lsig lopen $ by weaken [l1]
l9: $ G , k = ks_ctors ⇒ ⟨ k , t ⟩ ∈ sorted lsig lopen $ by wcel_eq_l [l7, l8]
l10: $ G , k = ks_ctors ⇒ sig lsig lopen $ by lsig_sig
l11: $ G , k = ks_ctors ⇒ (∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩)) ∨ (k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩)) $ by sorted_elim [l10, l9]
l12: $ G , k = ks_ctors , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by ax
l13: $ G , k = ks_ctors , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ by and_elim_l [l12]
