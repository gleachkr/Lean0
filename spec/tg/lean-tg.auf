lemma y1_d_ind_data_i (G: hyps) {b_v P T: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ ∈ cl_ind_data_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $
----
