l14: $ G ⇒ isset t7 $ by isset_var
l15: $ G ⇒ scons t7 (scons t8 (scons t9 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t6 $ by isset_var
l17: $ G ⇒ scons t6 (scons t7 (scons t8 (scons t9 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t5 $ by isset_var
l19: $ G ⇒ scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t4 $ by isset_var
l21: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset t3 $ by isset_var
l23: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset t2 $ by isset_var
l25: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅))))))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset t1 $ by isset_var
l27: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 ∅)))))))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ $ by opair_isset
l29: $ G ⇒ scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l28, l9]
l30: $ G ⇒ isset ⟨ kc_pi , scons V8 (scons V9 ∅) ⟩ $ by opair_isset
l31: $ G ⇒ scons ⟨ kc_pi , scons V8 (scons V9 ∅) ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V7 $ by isset_var
l33: $ G ⇒ scons V7 (scons ⟨ kc_pi , scons V8 (scons V9 ∅) ⟩ (scons ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ isset V6 $ by isset_var
