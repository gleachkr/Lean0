l6: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q2 = u_b $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q3 = u_P ∧ q4 = u_T $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q3 = u_P $ by and_elim_l [l7]
