lemma y1_p_nfields (G: hyps): $ G ⇒ pr_nfields ⊆ y1_lab kr_nfields (suc kr_nfields) $
----
l1: $ G ⇒ pr_nfields ⊆ y1_lab kr_nfields (suc kr_nfields) $ by y1_k_nfields_i

lemma y1_k_ndecl_nil (G: hyps): $ G ⇒ cl_ndecl_nil ⊆ y1_lab kr_ndecl (suc kr_ndecl) $
----
l1: $ G , x ∊ cl_ndecl_nil ⇒ x ∊ cl_ndecl_nil $ by ax
l2: $ G , x ∊ cl_ndecl_nil ⇒ ∃ y (x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ kr_ndecl ∈ ω $ by x1_kr_ndecl
l5: $ G , x = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x ∊ y1_lab kr_ndecl (suc kr_ndecl) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_ndecl_nil ⇒ x ∊ y1_lab kr_ndecl (suc kr_ndecl) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_ndecl_nil ⊆ y1_lab kr_ndecl (suc kr_ndecl) $ by subset_intro [l6]

lemma y1_k_ndecl_cons (G: hyps): $ G ⇒ cl_ndecl_cons ⊆ y1_lab kr_ndecl (suc kr_ndecl) $
----
l1: $ G , x ∊ cl_ndecl_cons ⇒ x ∊ cl_ndecl_cons $ by ax
l2: $ G , x ∊ cl_ndecl_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ kr_ndecl ∈ ω $ by x1_kr_ndecl
l5: $ G , x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ x ∊ y1_lab kr_ndecl (suc kr_ndecl) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ x ∊ y1_lab kr_ndecl (suc kr_ndecl) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ x ∊ y1_lab kr_ndecl (suc kr_ndecl) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_ndecl z u v) ∅ , ra_ndecl ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ x ∊ y1_lab kr_ndecl (suc kr_ndecl) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_ndecl_cons ⇒ x ∊ y1_lab kr_ndecl (suc kr_ndecl) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_ndecl_cons ⊆ y1_lab kr_ndecl (suc kr_ndecl) $ by subset_intro [l12]

lemma y1_p_ndecl (G: hyps): $ G ⇒ pr_ndecl ⊆ y1_lab kr_ndecl (suc kr_ndecl) $
----
l1: $ G ⇒ cl_ndecl_cons ⊆ y1_lab kr_ndecl (suc kr_ndecl) $ by y1_k_ndecl_cons
l2: $ G ⇒ cl_ndecl_nil ⊆ y1_lab kr_ndecl (suc kr_ndecl) $ by y1_k_ndecl_nil
l3: $ G ⇒ pr_ndecl ⊆ y1_lab kr_ndecl (suc kr_ndecl) $ by cun_least [l2, l1]

lemma y1_k_aux_of_i (G: hyps): $ G ⇒ cl_aux_of_i ⊆ y1_lab kr_aux_of (suc kr_aux_of) $
----
l1: $ G , x ∊ cl_aux_of_i ⇒ x ∊ cl_aux_of_i $ by ax
l2: $ G , x ∊ cl_aux_of_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ kr_aux_of ∈ ω $ by x1_kr_aux_of
l5: $ G , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩ ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l7: $ G , ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by ex_elim [l6, l5]
l8: $ G , ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l9: $ G , ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by ex_elim [l8, l7]
l10: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l11: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by ex_elim [l10, l9]
l12: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l13: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by ex_elim [l12, l11]
l14: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l15: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by ex_elim [l14, l13]
l16: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l17: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by ex_elim [l16, l15]
l18: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l19: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by ex_elim [l18, l17]
l20: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) $ by ax
l21: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_add b c u) (scons (ra_cnth z c f) ∅))) , ra_aux_of y z u f ⟩) ⇒ x ∊ y1_lab kr_aux_of (suc kr_aux_of) $ by ex_elim [l20, l19]
