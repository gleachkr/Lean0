l64: $ G ⇒ t6 = V6 $ by and_elim_l [l63]
l65: $ G ⇒ scons t7 (scons t8 ∅) = scons ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ (scons ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ∅) $ by and_elim_r [l63]
l66: $ G ⇒ t7 = ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ ∧ scons t8 ∅ = scons ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ∅ $ by y1_scons_inj [l65, l12, l28, l11, l27]
l67: $ G ⇒ t7 = ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ $ by and_elim_l [l66]
