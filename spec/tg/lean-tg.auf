l64: $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_refl ∪ (cl_spz_hit ∪ (cl_spz_app ∪ (cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj)))) → ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) ∨ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by imp_intro [l63]
l65: $ G ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) ∨ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by imp_elim [l64, #1]

lemma y1_e_afree_bvar (G: hyps) {i_v: set} (pp t1 V1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_afree ⟨ kc_bvar , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_bvar , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_bvar , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_bvar , scons V1 ∅ ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩) $ by ex_intro [l21]

lemma y1_d_afree_bvar (G: hyps) {i_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_bvar $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_bvar ⇒ x ∊ cl_afree_bvar $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_bvar ⇒ ∃ y (x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩) $ by y1_e_afree_bvar [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_bvar ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_afree_srt (G: hyps) {l_v: set} (pp t1 V1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_srt , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_afree ⟨ kc_srt , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_srt , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_srt , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_srt , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_srt , scons V1 ∅ ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_srt , scons V1 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_srt , scons V1 ∅ ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_srt , scons V1 ∅ ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_srt , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_srt , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_srt , scons V1 ∅ ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_intro [l21]

lemma y1_d_afree_srt (G: hyps) {l_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_srt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_srt ⇒ x ∊ cl_afree_srt $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_srt ⇒ ∃ y (x = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_srt , scons y ∅ ⟩ ⟩ ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by y1_e_afree_srt [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_srt ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_afree_app (G: hyps) {f_v a_v: set} (pp t1 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_afree V1) (scons (ra_afree V2) ∅) , ra_afree ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_afree V1) (scons (ra_afree V2) ∅) , ra_afree ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_afree V1) (scons (ra_afree V2) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_app , scons V1 (scons V2 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_afree V1) (scons (ra_afree V2) ∅) ∧ ra_afree t1 = ra_afree ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_afree V1) (scons (ra_afree V2) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ crn pp = crn (scons (ra_afree V1) (scons (ra_afree V2) ∅)) $ by crn_eq [l7]
l23: $ G ⇒ crn (scons (ra_afree V1) (scons (ra_afree V2) ∅)) ⊆ lrel $ by subset_eq_l [l22, #2]
l24: $ G ⇒ isset (ra_afree V1) $ by opair_isset
l25: $ G ⇒ ra_afree V1 ∈ lrel $ by crn_scons_head [l24, l23]
l26: $ G ⇒ crn (scons (ra_afree V2) ∅) ⊆ lrel $ by crn_scons_tail [l23]
l27: $ G ⇒ isset (ra_afree V2) $ by opair_isset
l28: $ G ⇒ ra_afree V2 ∈ lrel $ by crn_scons_head [l27, l26]
l29: $ G ⇒ ra_afree V1 ∈ lrel ∧ ra_afree V2 ∈ lrel $ by and_intro [l25, l28]
l30: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ ra_afree V1 ∈ lrel ∧ ra_afree V2 ∈ lrel $ by and_intro [l21, l29]
l31: $ G ⇒ ∃ a_v (t1 = ⟨ kc_app , scons V1 (scons a_v ∅) ⟩ ∧ ra_afree V1 ∈ lrel ∧ ra_afree a_v ∈ lrel) $ by ex_intro [l30]
l32: $ G ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) $ by ex_intro [l31]

lemma y1_d_afree_app (G: hyps) {f_v a_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_app ⇒ x ∊ cl_afree_app $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_app ⇒ ∃ y ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩ ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) $ by y1_e_afree_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_app , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_app ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) $ by wcel_elim [#1, l11]

lemma y1_e_afree_lam (G: hyps) {A b_v: set} (pp t1 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_afree V1) (scons (ra_afree V2) ∅) , ra_afree ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_afree V1) (scons (ra_afree V2) ∅) , ra_afree ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_afree V1) (scons (ra_afree V2) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_afree V1) (scons (ra_afree V2) ∅) ∧ ra_afree t1 = ra_afree ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_afree V1) (scons (ra_afree V2) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ crn pp = crn (scons (ra_afree V1) (scons (ra_afree V2) ∅)) $ by crn_eq [l7]
l23: $ G ⇒ crn (scons (ra_afree V1) (scons (ra_afree V2) ∅)) ⊆ lrel $ by subset_eq_l [l22, #2]
l24: $ G ⇒ isset (ra_afree V1) $ by opair_isset
l25: $ G ⇒ ra_afree V1 ∈ lrel $ by crn_scons_head [l24, l23]
l26: $ G ⇒ crn (scons (ra_afree V2) ∅) ⊆ lrel $ by crn_scons_tail [l23]
l27: $ G ⇒ isset (ra_afree V2) $ by opair_isset
l28: $ G ⇒ ra_afree V2 ∈ lrel $ by crn_scons_head [l27, l26]
l29: $ G ⇒ ra_afree V1 ∈ lrel ∧ ra_afree V2 ∈ lrel $ by and_intro [l25, l28]
l30: $ G ⇒ t1 = ⟨ kc_lam , scons V1 (scons V2 ∅) ⟩ ∧ ra_afree V1 ∈ lrel ∧ ra_afree V2 ∈ lrel $ by and_intro [l21, l29]
l31: $ G ⇒ ∃ b_v (t1 = ⟨ kc_lam , scons V1 (scons b_v ∅) ⟩ ∧ ra_afree V1 ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by ex_intro [l30]
l32: $ G ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by ex_intro [l31]

lemma y1_d_afree_lam (G: hyps) {A b_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_lam $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_lam ⇒ x ∊ cl_afree_lam $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_lam ⇒ ∃ y ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩ ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by y1_e_afree_lam [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_lam , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_lam ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by wcel_elim [#1, l11]

lemma y1_e_afree_pi (G: hyps) {A b_v: set} (pp t1 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_afree V1) (scons (ra_afree V2) ∅) , ra_afree ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_afree V1) (scons (ra_afree V2) ∅) , ra_afree ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_afree V1) (scons (ra_afree V2) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_afree V1) (scons (ra_afree V2) ∅) ∧ ra_afree t1 = ra_afree ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_afree V1) (scons (ra_afree V2) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ crn pp = crn (scons (ra_afree V1) (scons (ra_afree V2) ∅)) $ by crn_eq [l7]
l23: $ G ⇒ crn (scons (ra_afree V1) (scons (ra_afree V2) ∅)) ⊆ lrel $ by subset_eq_l [l22, #2]
l24: $ G ⇒ isset (ra_afree V1) $ by opair_isset
l25: $ G ⇒ ra_afree V1 ∈ lrel $ by crn_scons_head [l24, l23]
l26: $ G ⇒ crn (scons (ra_afree V2) ∅) ⊆ lrel $ by crn_scons_tail [l23]
l27: $ G ⇒ isset (ra_afree V2) $ by opair_isset
l28: $ G ⇒ ra_afree V2 ∈ lrel $ by crn_scons_head [l27, l26]
l29: $ G ⇒ ra_afree V1 ∈ lrel ∧ ra_afree V2 ∈ lrel $ by and_intro [l25, l28]
l30: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ ra_afree V1 ∈ lrel ∧ ra_afree V2 ∈ lrel $ by and_intro [l21, l29]
l31: $ G ⇒ ∃ b_v (t1 = ⟨ kc_pi , scons V1 (scons b_v ∅) ⟩ ∧ ra_afree V1 ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by ex_intro [l30]
l32: $ G ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by ex_intro [l31]

lemma y1_d_afree_pi (G: hyps) {A b_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_pi ⇒ x ∊ cl_afree_pi $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_pi ⇒ ∃ y ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩ ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by y1_e_afree_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ scons (ra_afree y) (scons (ra_afree z) ∅) , ra_afree ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_pi ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) $ by wcel_elim [#1, l11]

lemma y1_e_afree_cst (G: hyps) {a_v S: set} (pp t1 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_afree ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_cst , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ ∃ S (t1 = ⟨ kc_cst , scons V1 (scons S ∅) ⟩) $ by ex_intro [l21]
l23: $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by ex_intro [l22]

lemma y1_d_afree_cst (G: hyps) {a_v S: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_cst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_cst ⇒ x ∊ cl_afree_cst $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_cst ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩ ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by y1_e_afree_cst [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z (x = ⟨ ∅ , ra_afree ⟨ kc_cst , scons y (scons z ∅) ⟩ ⟩) ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_cst ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_afree_lit (G: hyps) {n_v: set} (pp t1 V1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_lit , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_afree ⟨ kc_lit , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_lit , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_lit , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_lit , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_lit , scons V1 ∅ ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_lit , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_lit , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_lit , scons V1 ∅ ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by ex_intro [l21]

lemma y1_d_afree_lit (G: hyps) {n_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_lit $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_lit ⇒ x ∊ cl_afree_lit $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_lit ⇒ ∃ y (x = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_lit , scons y ∅ ⟩ ⟩ ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by y1_e_afree_lit [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_lit ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_afree_ind_ty (G: hyps) {D N j_v np n_v m_v n0: set} (pp t1 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅))) , ra_afree ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅))) , ra_afree ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅)))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅))) ∧ ra_afree t1 = ra_afree ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ crn pp = crn (scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅)))) $ by crn_eq [l7]
l23: $ G ⇒ crn (scons (ra_ind_nested V1 V2) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅)))) ⊆ lrel $ by subset_eq_l [l22, #2]
l24: $ G ⇒ isset (ra_ind_nested V1 V2) $ by opair_isset
l25: $ G ⇒ ra_ind_nested V1 V2 ∈ lrel $ by crn_scons_head [l24, l23]
l26: $ G ⇒ crn (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅))) ⊆ lrel $ by crn_scons_tail [l23]
l27: $ G ⇒ isset (ra_ind_arity V1 V4 V5 V6) $ by opair_isset
l28: $ G ⇒ ra_ind_arity V1 V4 V5 V6 ∈ lrel $ by crn_scons_head [l27, l26]
l29: $ G ⇒ crn (scons (ra_ndecl V2 V5 V7) (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅)) ⊆ lrel $ by crn_scons_tail [l26]
l30: $ G ⇒ isset (ra_ndecl V2 V5 V7) $ by opair_isset
l31: $ G ⇒ ra_ndecl V2 V5 V7 ∈ lrel $ by crn_scons_head [l30, l29]
l32: $ G ⇒ crn (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) ∅) ⊆ lrel $ by crn_scons_tail [l29]
l33: $ G ⇒ isset (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7) $ by opair_isset
l34: $ G ⇒ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7 ∈ lrel $ by crn_scons_head [l33, l32]
l35: $ G ⇒ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7 ∈ lrel $ by and_intro [l31, l34]
l36: $ G ⇒ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7 ∈ lrel $ by and_intro [l28, l35]
l37: $ G ⇒ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7 ∈ lrel $ by and_intro [l25, l36]
l38: $ G ⇒ t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V7 ∈ lrel $ by and_intro [l21, l37]
l39: $ G ⇒ ∃ n0 (t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l38]
l40: $ G ⇒ ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V4 V5 m_v ∈ lrel ∧ ra_ndecl V2 V5 n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l39]
l41: $ G ⇒ ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 V4 n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l40]
l42: $ G ⇒ ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l41]
l43: $ G ⇒ ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ∧ ra_ind_nested V1 V2 ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ ∧ ra_ind_nested V1 N ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_intro [l44]

lemma y1_d_afree_ind_ty (G: hyps) {D N j_v np n_v m_v n0: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_ind_ty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_ind_ty ⇒ x ∊ cl_afree_ind_ty $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_ind_ty ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩ ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by y1_e_afree_ind_ty [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ b) ∅))) , ra_afree ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_elim [l19, l18]
