l40: $ G ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) $ by wcel_elim [#1, l39]

lemma y1_e_nst_hit_s (G: hyps) {X e_v e2 N j_v d_v np: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3) ∅ , ra_nst_hit ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V5 V6 V7 V2 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3) ∅ , ra_nst_hit ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V5 V6 V7 V2 V3 ⟩ = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nst_hit t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_nst_hit ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V5 V6 V7 V2 V3) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3) ∅ ∧ ra_nst_hit t1 t2 t3 t4 t5 t6 = ra_nst_hit ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V5 V6 V7 V2 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nst_hit t1 t2 t3 t4 t5 t6 = ra_nst_hit ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ V5 V6 V7 V2 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V3 $ by isset_var
l23: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ isset V2 $ by isset_var
l25: $ G ⇒ scons V2 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V7 $ by isset_var
l27: $ G ⇒ scons V7 (scons V2 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V6 $ by isset_var
l29: $ G ⇒ scons V6 (scons V7 (scons V2 (scons V3 ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V5 $ by isset_var
l31: $ G ⇒ scons V5 (scons V6 (scons V7 (scons V2 (scons V3 ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by opair_isset
l33: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V5 (scons V6 (scons V7 (scons V2 (scons V3 ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_nst_hit ∈ ω $ by x1_kr_nst_hit
l35: $ G ⇒ isset kr_nst_hit $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l37: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V5 (scons V6 (scons V7 (scons V2 (scons V3 ∅)))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_nst_hit = kr_nst_hit ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V5 (scons V6 (scons V7 (scons V2 (scons V3 ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons V5 (scons V6 (scons V7 (scons V2 (scons V3 ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V5 (scons V6 (scons V7 (scons V2 (scons V3 ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V5 (scons V6 (scons V7 (scons V2 (scons V3 ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V5 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V6 (scons V7 (scons V2 (scons V3 ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V5 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V6 (scons V7 (scons V2 (scons V3 ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V6 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V7 (scons V2 (scons V3 ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = V6 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V7 (scons V2 (scons V3 ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V7 ∧ scons t5 (scons t6 ∅) = scons V2 (scons V3 ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
l50: $ G ⇒ t4 = V7 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 (scons t6 ∅) = scons V2 (scons V3 ∅) $ by and_elim_r [l49]
l52: $ G ⇒ t5 = V2 ∧ scons t6 ∅ = scons V3 ∅ $ by y1_scons_inj [l51, l12, l24, l11, l23]
l53: $ G ⇒ t5 = V2 $ by and_elim_l [l52]
l54: $ G ⇒ scons t6 ∅ = scons V3 ∅ $ by and_elim_r [l52]
l55: $ G ⇒ t6 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l54, l10, l22, l9, l9]
l56: $ G ⇒ t6 = V3 $ by and_elim_l [l55]
l57: $ G ⇒ crn pp = crn (scons (ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3) ∅) $ by crn_eq [l7]
l58: $ G ⇒ crn (scons (ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l57, #2]
l59: $ G ⇒ isset (ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3) $ by opair_isset
l60: $ G ⇒ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3 ∈ lrel $ by crn_scons_head [l59, l58]
l61: $ G ⇒ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3 ∈ lrel $ by and_intro [l56, l60]
l62: $ G ⇒ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3 ∈ lrel $ by and_intro [l53, l61]
l63: $ G ⇒ t4 = V7 ∧ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3 ∈ lrel $ by and_intro [l50, l62]
l64: $ G ⇒ t3 = V6 ∧ t4 = V7 ∧ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3 ∈ lrel $ by and_intro [l47, l63]
l65: $ G ⇒ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3 ∈ lrel $ by and_intro [l44, l64]
l66: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 V7 V2 V3 ∈ lrel $ by and_intro [l41, l65]
l67: $ G ⇒ ∃ np (t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = np ∧ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ V6 np V2 V3 ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ t2 = V5 ∧ t3 = d_v ∧ t4 = np ∧ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons V5 ∅ ⟩ d_v np V2 V3 ∈ lrel) $ by ex_intro [l67]
l69: $ G ⇒ ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit V4 ⟨ kc_s , scons j_v ∅ ⟩ d_v np V2 V3 ∈ lrel) $ by ex_intro [l68]
l70: $ G ⇒ ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons V1 (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = V2 ∧ t6 = V3 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np V2 V3 ∈ lrel) $ by ex_intro [l69]
l71: $ G ⇒ ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons V1 (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = V2 ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np V2 e2 ∈ lrel) $ by ex_intro [l70]
l72: $ G ⇒ ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons V1 (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_intro [l71]
l73: $ G ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_intro [l72]

lemma y1_d_nst_hit_s (G: hyps) {X e_v e2 N j_v d_v np: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_nst_hit_s ⇒ x ∊ cl_nst_hit_s $ by ax
l2: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_nst_hit_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩ ⇒ x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩ ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩ ⇒ x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩ ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩ ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by y1_e_nst_hit_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_nst_hit v ⟨ kc_s , scons w ∅ ⟩ a b z u) ∅ , ra_nst_hit ⟨ kc_cons , scons y (scons v ∅) ⟩ w a b z u ⟩) ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_nst_hit_s ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_o_nst_hit (G: hyps) {X S Y e_v e2 N I i_v j_v d_v np na npi r_v a_v t_v: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_nst_hit $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) ∨ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s $ by ax
l2: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by y1_d_nst_hit_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s → ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s $ by ax
l6: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∨ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z $ by ax
l8: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) $ by y1_d_nst_hit_z [l7, l8]
l10: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) ∨ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s $ by ax
l12: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s → ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s ⇒ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_s ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) ∨ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) ∨ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z ∪ cl_nst_hit_s → ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) ∨ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) ∨ ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_spz_refl (G: hyps) {D N d_v e_v: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_spz V1 V2 V3 V4 V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_spz V1 V2 V3 V4 V4 ⟩ = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_spz t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_spz V1 V2 V3 V4 V4) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_spz t1 t2 t3 t4 t5 = ra_spz V1 V2 V3 V4 V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_spz t1 t2 t3 t4 t5 = ra_spz V1 V2 V3 V4 V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V4 $ by isset_var
l21: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ scons V4 (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l21]
l23: $ G ⇒ isset V3 $ by isset_var
l24: $ G ⇒ scons V3 (scons V4 (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ isset V2 $ by isset_var
l26: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V4 ∅))) ∈ fseq y1_vv $ by y1_fs [l25, l24]
l27: $ G ⇒ isset V1 $ by isset_var
l28: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V4 ∅)))) ∈ fseq y1_vv $ by y1_fs [l27, l26]
l29: $ G ⇒ kr_spz ∈ ω $ by x1_kr_spz
l30: $ G ⇒ isset kr_spz $ by wcel_isset [l29]
l31: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l32: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V4 ∅))))) $ by wcel_isset [l28]
l33: $ G ⇒ kr_spz = kr_spz ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V4 ∅)))) $ by opair_inj_c [l8, l30, l31, l30, l32]
l34: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V4 ∅)))) $ by and_elim_r [l33]
l35: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons V4 ∅))) $ by y1_scons_inj [l34, l18, l27, l17, l26]
l36: $ G ⇒ t1 = V1 $ by and_elim_l [l35]
l37: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons V4 ∅))) $ by and_elim_r [l35]
l38: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V4 ∅)) $ by y1_scons_inj [l37, l16, l25, l15, l24]
l39: $ G ⇒ t2 = V2 $ by and_elim_l [l38]
l40: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V4 ∅)) $ by and_elim_r [l38]
l41: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons V4 (scons V4 ∅) $ by y1_scons_inj [l40, l14, l23, l13, l22]
l42: $ G ⇒ t3 = V3 $ by and_elim_l [l41]
l43: $ G ⇒ scons t4 (scons t5 ∅) = scons V4 (scons V4 ∅) $ by and_elim_r [l41]
l44: $ G ⇒ t4 = V4 ∧ scons t5 ∅ = scons V4 ∅ $ by y1_scons_inj [l43, l12, l20, l11, l21]
l45: $ G ⇒ t4 = V4 $ by and_elim_l [l44]
l46: $ G ⇒ scons t5 ∅ = scons V4 ∅ $ by and_elim_r [l44]
l47: $ G ⇒ t5 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l46, l10, l20, l9, l9]
l48: $ G ⇒ t5 = V4 $ by and_elim_l [l47]
l49: $ G ⇒ t4 = V4 ∧ t5 = V4 $ by and_intro [l45, l48]
l50: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = V4 $ by and_intro [l42, l49]
l51: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V4 $ by and_intro [l39, l50]
l52: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V4 $ by and_intro [l36, l51]
l53: $ G ⇒ ∃ e_v (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = e_v ∧ t5 = e_v) $ by ex_intro [l52]
l54: $ G ⇒ ∃ d_v ∃ e_v (t1 = V1 ∧ t2 = V2 ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by ex_intro [l53]
l55: $ G ⇒ ∃ N ∃ d_v ∃ e_v (t1 = V1 ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by ex_intro [l54]
l56: $ G ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by ex_intro [l55]

lemma y1_d_spz_refl (G: hyps) {D N d_v e_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_refl $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $
----
l1: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_refl ⇒ x ∊ cl_spz_refl $ by ax
l2: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_refl ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ x = ⟨ ∅ , ra_spz y z u v v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_spz y z u v v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by y1_e_spz_refl [l6, l7]
l9: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_refl ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) $ by wcel_elim [#1, l15]

lemma y1_e_spz_hit (G: hyps) {D N d_v np n_v m_v n0 e_v e2: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6 V7 V8 V9: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅)) , ra_spz V1 V2 V3 V8 V9 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅)) , ra_spz V1 V2 V3 V8 V9 ⟩ = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_spz t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_spz V1 V2 V3 V8 V9) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅)) ∧ ra_spz t1 t2 t3 t4 t5 = ra_spz V1 V2 V3 V8 V9 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_spz t1 t2 t3 t4 t5 = ra_spz V1 V2 V3 V8 V9 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V9 $ by isset_var
l21: $ G ⇒ scons V9 ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset V8 $ by isset_var
l23: $ G ⇒ scons V8 (scons V9 ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V3 $ by isset_var
l25: $ G ⇒ scons V3 (scons V8 (scons V9 ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V2 $ by isset_var
l27: $ G ⇒ scons V2 (scons V3 (scons V8 (scons V9 ∅))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V1 $ by isset_var
l29: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V8 (scons V9 ∅)))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ kr_spz ∈ ω $ by x1_kr_spz
l31: $ G ⇒ isset kr_spz $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V8 (scons V9 ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_spz = kr_spz ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V8 (scons V9 ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V8 (scons V9 ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V8 (scons V9 ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V8 (scons V9 ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V8 (scons V9 ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V8 (scons V9 ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons V8 (scons V9 ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
l43: $ G ⇒ t3 = V3 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons V8 (scons V9 ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = V8 ∧ scons t5 ∅ = scons V9 ∅ $ by y1_scons_inj [l44, l12, l22, l11, l21]
l46: $ G ⇒ t4 = V8 $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons V9 ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = V9 ∧ ∅ = ∅ $ by y1_scons_inj [l47, l10, l20, l9, l9]
l49: $ G ⇒ t5 = V9 $ by and_elim_l [l48]
l50: $ G ⇒ crn pp = crn (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅))) $ by crn_eq [l7]
l51: $ G ⇒ crn (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_ndecl V2 V5 V7) (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅))) ⊆ lrel $ by subset_eq_l [l50, #2]
l52: $ G ⇒ isset (ra_ind_arity V1 V4 V5 V6) $ by opair_isset
l53: $ G ⇒ ra_ind_arity V1 V4 V5 V6 ∈ lrel $ by crn_scons_head [l52, l51]
l54: $ G ⇒ crn (scons (ra_ndecl V2 V5 V7) (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅)) ⊆ lrel $ by crn_scons_tail [l51]
l55: $ G ⇒ isset (ra_ndecl V2 V5 V7) $ by opair_isset
l56: $ G ⇒ ra_ndecl V2 V5 V7 ∈ lrel $ by crn_scons_head [l55, l54]
l57: $ G ⇒ crn (scons (ra_nst_hit V2 V7 V3 V4 V8 V9) ∅) ⊆ lrel $ by crn_scons_tail [l54]
l58: $ G ⇒ isset (ra_nst_hit V2 V7 V3 V4 V8 V9) $ by opair_isset
l59: $ G ⇒ ra_nst_hit V2 V7 V3 V4 V8 V9 ∈ lrel $ by crn_scons_head [l58, l57]
l60: $ G ⇒ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 V8 V9 ∈ lrel $ by and_intro [l56, l59]
l61: $ G ⇒ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 V8 V9 ∈ lrel $ by and_intro [l53, l60]
l62: $ G ⇒ t5 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 V8 V9 ∈ lrel $ by and_intro [l49, l61]
l63: $ G ⇒ t4 = V8 ∧ t5 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 V8 V9 ∈ lrel $ by and_intro [l46, l62]
l64: $ G ⇒ t3 = V3 ∧ t4 = V8 ∧ t5 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 V8 V9 ∈ lrel $ by and_intro [l43, l63]
l65: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V8 ∧ t5 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 V8 V9 ∈ lrel $ by and_intro [l40, l64]
l66: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V8 ∧ t5 = V9 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 V8 V9 ∈ lrel $ by and_intro [l37, l65]
l67: $ G ⇒ ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V8 ∧ t5 = e2 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 V8 e2 ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 V7 ∈ lrel ∧ ra_nst_hit V2 V7 V3 V4 e_v e2 ∈ lrel) $ by ex_intro [l67]
l69: $ G ⇒ ∃ n0 ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity V1 V4 V5 V6 ∈ lrel ∧ ra_ndecl V2 V5 n0 ∈ lrel ∧ ra_nst_hit V2 n0 V3 V4 e_v e2 ∈ lrel) $ by ex_intro [l68]
l70: $ G ⇒ ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity V1 V4 V5 m_v ∈ lrel ∧ ra_ndecl V2 V5 n0 ∈ lrel ∧ ra_nst_hit V2 n0 V3 V4 e_v e2 ∈ lrel) $ by ex_intro [l69]
l71: $ G ⇒ ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity V1 V4 n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_nst_hit V2 n0 V3 V4 e_v e2 ∈ lrel) $ by ex_intro [l70]
l72: $ G ⇒ ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_nst_hit V2 n0 V3 np e_v e2 ∈ lrel) $ by ex_intro [l71]
l73: $ G ⇒ ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl V2 n_v n0 ∈ lrel ∧ ra_nst_hit V2 n0 d_v np e_v e2 ∈ lrel) $ by ex_intro [l72]
l74: $ G ⇒ ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = V1 ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by ex_intro [l73]
l75: $ G ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by ex_intro [l74]

lemma y1_d_spz_hit (G: hyps) {D N d_v np n_v m_v n0 e_v e2: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_hit $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_hit ⇒ x ∊ cl_spz_hit $ by ax
l2: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_hit ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩ ⇒ x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩ ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩ ⇒ x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩ ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩ ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by y1_e_spz_hit [l6, l7]
l9: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) ⇒ ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ f (x = ⟨ scons (ra_ind_arity y v w a) (scons (ra_ndecl z w b) (scons (ra_nst_hit z b u v c f) ∅)) , ra_spz y z u c f ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) $ by ex_elim [l9, l8]
