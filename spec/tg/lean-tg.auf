--| A clause of the relation labelled `K` is in its label range.
lemma y1_lab_self (G: hyps) (A K S: class) (x: set):
  $ G ⇒ x = ⟨ A , ⟨ K , S ⟩ ⟩ $ > $ G ⇒ K ∈ ω $ > $ G ⇒ x ∊ y1_lab K (suc K) $
----
l1: $ G ⇒ isset K $ by wcel_isset [#2]
l2: $ G ⇒ K ∈ suc K $ by v1_in_suc [l1]
l3: $ G ⇒ K ⊆ K $ by subset_refl
l4: $ G ⇒ x ∊ y1_lab K (suc K) $ by y1_lab_intro [#1, l1, l2, l3]

--| The label of an element of the program, from a label range.
lemma y1_lprog_lab (G: hyps) (P K S L H: class):
  $ G ⇒ ⟨ P , ⟨ K , S ⟩ ⟩ ∈ lprog $ > $ G ⇒ isset K $ > $ G ⇒ ⟨ P , ⟨ K , S ⟩ ⟩ ∈ y1_lab L H $ >
  $ G ⇒ K ∈ H ∧ L ⊆ K $
