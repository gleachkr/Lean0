l13: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cminors_nil ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l19]

lemma y1_e_cminors_cons (G: hyps) {D np n_v k_v i_v c_v nf K Min C M1 M: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12: set):
  $ G ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_npis V8 V7) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ V8 V9) (scons (ra_cminors V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 ⟨ kc_s , scons V6 ∅ ⟩ V10 V11) (scons (ra_capp V11 ⟨ kc_cons , scons V9 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V12) ∅))) , ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V8 (scons V10 ∅) ⟩ V12 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_npis V8 V7) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ V8 V9) (scons (ra_cminors V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 ⟨ kc_s , scons V6 ∅ ⟩ V10 V11) (scons (ra_capp V11 ⟨ kc_cons , scons V9 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V12) ∅))) , ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V8 (scons V10 ∅) ⟩ V12 ⟩ = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_npis V8 V7) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ V8 V9) (scons (ra_cminors V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 ⟨ kc_s , scons V6 ∅ ⟩ V10 V11) (scons (ra_capp V11 ⟨ kc_cons , scons V9 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V12) ∅)))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cminors t1 t2 t3 t4 t5 t6 t7 t8) $ by opair_isset
l5: $ G ⇒ isset (ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V8 (scons V10 ∅) ⟩ V12) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_npis V8 V7) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ V8 V9) (scons (ra_cminors V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 ⟨ kc_s , scons V6 ∅ ⟩ V10 V11) (scons (ra_capp V11 ⟨ kc_cons , scons V9 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V12) ∅))) ∧ ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 = ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V8 (scons V10 ∅) ⟩ V12 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_npis V8 V7) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ V8 V9) (scons (ra_cminors V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V5 ⟨ kc_s , scons V6 ∅ ⟩ V10 V11) (scons (ra_capp V11 ⟨ kc_cons , scons V9 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V12) ∅))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 = ra_cminors V1 V2 V3 V4 V5 V6 ⟨ kc_ccons , scons V8 (scons V10 ∅) ⟩ V12 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t8 $ by isset_var
l11: $ G ⇒ scons t8 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t7 $ by isset_var
l13: $ G ⇒ scons t7 (scons t8 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t6 $ by isset_var
l15: $ G ⇒ scons t6 (scons t7 (scons t8 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t5 $ by isset_var
l17: $ G ⇒ scons t5 (scons t6 (scons t7 (scons t8 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t4 $ by isset_var
l19: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t3 $ by isset_var
l21: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset t2 $ by isset_var
