l6: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q2 = u_d $ by and_elim_l [l5]
l7: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = u_X $ by and_elim_r [l5]
l8: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l7]
l9: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q4 = u_X $ by and_elim_r [l7]
l10: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q1 = a $ by and_elim_l [l2]
l11: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a $ by and_elim_r [l2]
l12: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q2 = b $ by and_elim_l [l11]
l13: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a $ by and_elim_r [l11]
l14: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l13]
l15: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ w4 = a $ by and_elim_r [l13]
l16: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a ⇒ q4 = w4 $ by y2_pargs_e1 [l4, l6, l8, l9, l10, l12, l14, l15]
l17: $ GG , ∃ b (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a) ⇒ ∃ b (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a) $ by ax
l18: $ GG , ∃ b (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a) ⇒ q4 = w4 $ by ex_elim [l17, l16]
l19: $ GG , ∃ a ∃ b (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a) ⇒ ∃ a ∃ b (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a) $ by ax
l20: $ GG , ∃ a ∃ b (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ w4 = a) ⇒ q4 = w4 $ by ex_elim [l19, l18]
