l62: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ t6 = V5 ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5 ∈ lrel $ by and_intro [l53, l61]
l63: $ G ⇒ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ t6 = V5 ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5 ∈ lrel $ by and_intro [l50, l62]
l64: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ t6 = V5 ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5 ∈ lrel $ by and_intro [l47, l63]
l65: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ t6 = V5 ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5 ∈ lrel $ by and_intro [l44, l64]
l66: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ t6 = V5 ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5 ∈ lrel $ by and_intro [l41, l65]
l67: $ G ⇒ ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons B ∅) ⟩ ∧ t6 = V5 ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ B V5 ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = V5 ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ B V5 ∈ lrel) $ by ex_intro [l67]
l69: $ G ⇒ ∃ j_v ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ B j_v ∈ lrel) $ by ex_intro [l68]
l70: $ G ⇒ ∃ d_v ∃ j_v ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield V1 V2 V3 ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_intro [l69]
l71: $ G ⇒ ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield V1 V2 np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_intro [l70]
l72: $ G ⇒ ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = V1 ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield V1 n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_intro [l71]
l73: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_intro [l72]

lemma y1_d_recfield_pi (G: hyps) {D n_v np d_v j_v A B: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_recfield_pi ⇒ x ∊ cl_recfield_pi $ by ax
l2: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_recfield_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by y1_e_recfield_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_recfield_pi ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_e_recfield_app (G: hyps) {D n_v np d_v j_v A: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅ , ra_recfield V1 V2 V3 V4 V6 V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅ , ra_recfield V1 V2 V3 V4 V6 V5 ⟩ = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_recfield t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_recfield V1 V2 V3 V4 V6 V5) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅ ∧ ra_recfield t1 t2 t3 t4 t5 t6 = ra_recfield V1 V2 V3 V4 V6 V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_recfield t1 t2 t3 t4 t5 t6 = ra_recfield V1 V2 V3 V4 V6 V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V5 $ by isset_var
l23: $ G ⇒ scons V5 ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ isset V6 $ by isset_var
l25: $ G ⇒ scons V6 (scons V5 ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V4 $ by isset_var
l27: $ G ⇒ scons V4 (scons V6 (scons V5 ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V3 $ by isset_var
l29: $ G ⇒ scons V3 (scons V4 (scons V6 (scons V5 ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V2 $ by isset_var
l31: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V6 (scons V5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V1 $ by isset_var
l33: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V6 (scons V5 ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_recfield ∈ ω $ by x1_kr_recfield
l35: $ G ⇒ isset kr_recfield $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l37: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V6 (scons V5 ∅)))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_recfield = kr_recfield ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V6 (scons V5 ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V6 (scons V5 ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V3 (scons V4 (scons V6 (scons V5 ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V3 (scons V4 (scons V6 (scons V5 ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V3 (scons V4 (scons V6 (scons V5 ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V3 (scons V4 (scons V6 (scons V5 ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V4 (scons V6 (scons V5 ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = V3 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V4 (scons V6 (scons V5 ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 ∅) = scons V6 (scons V5 ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
l50: $ G ⇒ t4 = V4 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 (scons t6 ∅) = scons V6 (scons V5 ∅) $ by and_elim_r [l49]
l52: $ G ⇒ t5 = V6 ∧ scons t6 ∅ = scons V5 ∅ $ by y1_scons_inj [l51, l12, l24, l11, l23]
l53: $ G ⇒ t5 = V6 $ by and_elim_l [l52]
l54: $ G ⇒ scons t6 ∅ = scons V5 ∅ $ by and_elim_r [l52]
l55: $ G ⇒ t6 = V5 ∧ ∅ = ∅ $ by y1_scons_inj [l54, l10, l22, l9, l9]
l56: $ G ⇒ t6 = V5 $ by and_elim_l [l55]
l57: $ G ⇒ crn pp = crn (scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅) $ by crn_eq [l7]
l58: $ G ⇒ crn (scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅) ⊆ lrel $ by subset_eq_l [l57, #2]
l59: $ G ⇒ isset (ra_indapp V1 V2 V3 V4 V6 V5) $ by opair_isset
l60: $ G ⇒ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by crn_scons_head [l59, l58]
l61: $ G ⇒ t6 = V5 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l56, l60]
l62: $ G ⇒ t5 = V6 ∧ t6 = V5 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l53, l61]
l63: $ G ⇒ t4 = V4 ∧ t5 = V6 ∧ t6 = V5 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l50, l62]
l64: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ t6 = V5 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l47, l63]
l65: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ t6 = V5 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l44, l64]
l66: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ t6 = V5 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l41, l65]
l67: $ G ⇒ ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = A ∧ t6 = V5 ∧ ra_indapp V1 V2 V3 V4 A V5 ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ j_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp V1 V2 V3 V4 A j_v ∈ lrel) $ by ex_intro [l67]
l69: $ G ⇒ ∃ d_v ∃ j_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp V1 V2 V3 d_v A j_v ∈ lrel) $ by ex_intro [l68]
l70: $ G ⇒ ∃ np ∃ d_v ∃ j_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp V1 V2 np d_v A j_v ∈ lrel) $ by ex_intro [l69]
l71: $ G ⇒ ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = V1 ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp V1 n_v np d_v A j_v ∈ lrel) $ by ex_intro [l70]
l72: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_intro [l71]

lemma y1_d_recfield_app (G: hyps) {D n_v np d_v j_v A: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_recfield_app ⇒ x ∊ cl_recfield_app $ by ax
l2: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_recfield_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by y1_e_recfield_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_recfield_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_o_recfield (G: hyps) {D n_v np d_v j_v A B: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_recfield $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app $ by ax
l2: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by y1_d_recfield_app [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app → ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app $ by ax
l6: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∨ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi $ by ax
l8: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $ by y1_d_recfield_pi [l7, l8]
l10: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app $ by ax
l12: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app → ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_recfield_pi ∪ cl_recfield_app → ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_rst_nil (G: hyps) {D e_v: set} (pp t1 t2 t3 t4 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_rst V1 ⟨ kc_nil , ∅ ⟩ V2 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_rst V1 ⟨ kc_nil , ∅ ⟩ V2 V2 ⟩ = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_rst V1 ⟨ kc_nil , ∅ ⟩ V2 V2) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_rst t1 t2 t3 t4 = ra_rst V1 ⟨ kc_nil , ∅ ⟩ V2 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_rst t1 t2 t3 t4 = ra_rst V1 ⟨ kc_nil , ∅ ⟩ V2 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons V2 (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l22: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons V2 (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons ⟨ kc_nil , ∅ ⟩ (scons V2 (scons V2 ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_rst ∈ ω $ by x1_kr_rst
l26: $ G ⇒ isset kr_rst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons ⟨ kc_nil , ∅ ⟩ (scons V2 (scons V2 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_rst = kr_rst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_nil , ∅ ⟩ (scons V2 (scons V2 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_nil , ∅ ⟩ (scons V2 (scons V2 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V2 (scons V2 ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V2 (scons V2 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V2 (scons V2 ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V2 (scons V2 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V2 ∧ scons t4 ∅ = scons V2 ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = V2 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V2 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V2 $ by and_elim_l [l40]
l42: $ G ⇒ t3 = V2 ∧ t4 = V2 $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = V2 ∧ t4 = V2 $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = V2 ∧ t4 = V2 $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ e_v (t1 = V1 ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) $ by ex_intro [l44]
l46: $ G ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) $ by ex_intro [l45]

lemma y1_d_rst_nil (G: hyps) {D e_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) $
----
l1: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_nil ⇒ x ∊ cl_rst_nil $ by ax
l2: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_nil ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) $ by y1_e_rst_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩) ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_nil ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) $ by wcel_elim [#1, l11]

lemma y1_e_rst_ty (G: hyps) {D N j_v np n_v m_v na k_v e_v S X X1 X2 e2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7) (scons (ra_aux_of V1 V2 V3 V11) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅))))))) , ra_rst V1 V2 V9 V14 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_rehead S X2 k_v e_v e2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7) (scons (ra_aux_of V1 V2 V3 V11) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅))))))) , ra_rst V1 V2 V9 V14 ⟩ = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7) (scons (ra_aux_of V1 V2 V3 V11) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅)))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_rst V1 V2 V9 V14) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7) (scons (ra_aux_of V1 V2 V3 V11) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅))))))) ∧ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 V9 V14 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7) (scons (ra_aux_of V1 V2 V3 V11) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅))))))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_rst t1 t2 t3 t4 = ra_rst V1 V2 V9 V14 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V14 $ by isset_var
l19: $ G ⇒ scons V14 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V9 $ by isset_var
l21: $ G ⇒ scons V9 (scons V14 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons V9 (scons V14 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V2 (scons V9 (scons V14 ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_rst ∈ ω $ by x1_kr_rst
l27: $ G ⇒ isset kr_rst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons V9 (scons V14 ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_rst = kr_rst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V9 (scons V14 ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons V9 (scons V14 ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V9 (scons V14 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons V9 (scons V14 ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons V9 (scons V14 ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V9 (scons V14 ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V9 ∧ scons t4 ∅ = scons V14 ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V9 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons V14 ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = V14 ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = V14 $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7) (scons (ra_aux_of V1 V2 V3 V11) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅)))))))) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7) (scons (ra_aux_of V1 V2 V3 V11) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅)))))))) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7) $ by opair_isset
l46: $ G ⇒ ra_spine ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V9 V7 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_aux_of V1 V2 V3 V11) (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅))))))) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_aux_of V1 V2 V3 V11) $ by opair_isset
l49: $ G ⇒ ra_aux_of V1 V2 V3 V11 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ crn (scons (ra_ind_arity V1 V4 V5 V6) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅)))))) ⊆ lrel $ by crn_scons_tail [l47]
l51: $ G ⇒ isset (ra_ind_arity V1 V4 V5 V6) $ by opair_isset
l52: $ G ⇒ ra_ind_arity V1 V4 V5 V6 ∈ lrel $ by crn_scons_head [l51, l50]
l53: $ G ⇒ crn (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅))))) ⊆ lrel $ by crn_scons_tail [l50]
l54: $ G ⇒ isset (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12) $ by opair_isset
l55: $ G ⇒ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V5 V4 V11 V12 ∈ lrel $ by crn_scons_head [l54, l53]
l56: $ G ⇒ crn (scons (ra_add V4 V8 V7) (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅)))) ⊆ lrel $ by crn_scons_tail [l53]
l57: $ G ⇒ isset (ra_add V4 V8 V7) $ by opair_isset
