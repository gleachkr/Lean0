lemma y2_nth_ctor_e1 (GG: hyps) (q1 q2 q3 w3 u_K u_C v_K v_C: set):
  $ GG ⇒ q1 = ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q3 = u_K $ > $ GG ⇒ q1 = ⟨ kc_ccons , scons v_K (scons v_C ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ w3 = v_K $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ = ⟨ kc_ccons , scons v_K (scons v_C ∅) ⟩ $ by eq_trans [l1, #4]
l3: $ GG ⇒ kc_ccons ∈ ω $ by v1_kc_ccons
l4: $ GG ⇒ isset kc_ccons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_K $ by isset_var
l6: $ GG ⇒ isset u_C $ by isset_var
l7: $ GG ⇒ isset v_K $ by isset_var
l8: $ GG ⇒ isset v_C $ by isset_var
l9: $ GG ⇒ u_K = v_K ∧ u_C = v_C $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_K = v_K $ by and_elim_l [l9]
l11: $ GG ⇒ u_C = v_C $ by and_elim_r [l9]
l12: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = q2 $ by eq_sym [#2]
l13: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [l12, #5]
l14: $ GG ⇒ v_K = w3 $ by eq_sym [#6]
l15: $ GG ⇒ q3 = v_K $ by eq_trans [#3, l10]
