lemma y1_p_ihval (G: hyps): $ G ⇒ pr_ihval ⊆ y1_lab kr_ihval (suc kr_ihval) $
----
l1: $ G ⇒ cl_ihval_app ⊆ y1_lab kr_ihval (suc kr_ihval) $ by y1_k_ihval_app
l2: $ G ⇒ cl_ihval_lam ⊆ y1_lab kr_ihval (suc kr_ihval) $ by y1_k_ihval_lam
l3: $ G ⇒ pr_ihval ⊆ y1_lab kr_ihval (suc kr_ihval) $ by cun_least [l2, l1]

