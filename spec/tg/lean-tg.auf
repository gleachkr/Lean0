l65: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_band a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_band a_v b_v c_v ∈ lrel) $ by imp_elim [l64, #1]

lemma y1_e_bor_0l (G: hyps) {b_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ V1 V1 ⟩ = ⟨ pp , ra_bor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bor ⟨ kc_b0 , ∅ ⟩ V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_bor t1 t2 t3 = ra_bor ⟨ kc_b0 , ∅ ⟩ V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bor t1 t2 t3 = ra_bor ⟨ kc_b0 , ∅ ⟩ V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_bor ∈ ω $ by x1_kr_bor
l22: $ G ⇒ isset kr_bor $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_bor = kr_bor ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_intro [l36]

lemma y1_d_bor_0l (G: hyps) {b_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_0l $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_0l ⇒ x ∊ cl_bor_0l $ by ax
l2: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_0l ⇒ ∃ y (x = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ x = ⟨ pp , ra_bor t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by y1_e_bor_0l [l6, l7]
l9: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_0l ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by wcel_elim [#1, l9]

