l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ scons Q3 ∅ = scons d ∅ $ by scons_eq [l8, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ scons Q2 (scons Q3 ∅) = scons b (scons d ∅) $ by scons_eq [l7, l12]
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ scons Q1 (scons Q2 (scons Q3 ∅)) = scons a (scons b (scons d ∅)) $ by scons_eq [l6, l13]
l15: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ kr_ntys = kr_ntys $ by eq_refl
l16: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_ntys Q1 Q2 Q3 = ra_ntys a b d $ by opair_eq [l15, l14]
l17: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_ntys Q1 Q2 Q3 ∈ y2_P_ntys lrel $ by weaken [#6]
l18: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_ntys a b d ∈ y2_P_ntys lrel $ by wcel_eq_l [l16, l17]
l19: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_ntys Q1 W2 W3 ∈ lrel $ by weaken [#7]
l20: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_ntys a e f ∈ lrel $ by x1_eq_ntys [l19, l6, l9, l10]
l21: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ b = e ∧ d = f $ by y2_ntys_ih [l18, l20]
