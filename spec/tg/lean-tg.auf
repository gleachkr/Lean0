l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_ctor ⇒ x ∊ cl_closed_ind_ctor $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_ctor ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by cab_elim [l1]
