l7: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V7) (scons (ra_ntys V4 V8 V9) (scons (ra_motives V1 V7 V5 ⟨ kc_nz , ∅ ⟩ V4 V11) (scons (ra_minors V1 V7 V8 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V12) (scons (ra_nth_ty V4 V6 V13 V19) (scons (ra_add V9 V8 V10) (scons (ra_lift V10 ⟨ kc_nz , ∅ ⟩ V13 V14) (scons (ra_rtail V1 V7 V8 V9 V6 ⟨ kc_nz , ∅ ⟩ V14 V15) (scons (ra_pis V12 V15 V16) (scons (ra_pis V11 V16 V17) (scons (ra_pis V3 V17 V18) ∅))))))))))) $ by and_elim_l [l6]
