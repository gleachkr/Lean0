l22: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) $ by ax
l24: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_rtail y z u v w ⟨ kc_s , scons a ∅ ⟩ c f) ∅ , ra_rtail y z u v w a ⟨ kc_pi , scons b (scons c ∅) ⟩ ⟨ kc_pi , scons b (scons f ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) $ by ex_elim [l23, l22]
l25: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_rtail_pi ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) $ by ex_elim [l2, l24]
l26: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ A ∃ B ∃ B2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t8 = ⟨ kc_pi , scons A (scons B2 ∅) ⟩ ∧ ra_rtail D np n_v m_v i_v ⟨ kc_s , scons d_v ∅ ⟩ B B2 ∈ lrel) $ by wcel_elim [#1, l25]

lemma y1_e_rtail_srt (G: hyps) {D np n_v m_v i_v d_v mn dmn mi l_v X I X2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13: set):
  $ G ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_add V4 V3 V7) (scons (ra_add V6 V7 V8) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ V8 V2 V11) (scons (ra_pargs V11 ⟨ kc_nz , ∅ ⟩ V6 V12) (scons (ra_add V9 V5 V8) (scons (ra_pargs ⟨ kc_bvar , scons V9 ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V6 V13) ∅))))) , ra_rtail V1 V2 V3 V4 V5 V6 ⟨ kc_srt , scons V10 ∅ ⟩ ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V4 V3 V7) (scons (ra_add V6 V7 V8) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ V8 V2 V11) (scons (ra_pargs V11 ⟨ kc_nz , ∅ ⟩ V6 V12) (scons (ra_add V9 V5 V8) (scons (ra_pargs ⟨ kc_bvar , scons V9 ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V6 V13) ∅))))) , ra_rtail V1 V2 V3 V4 V5 V6 ⟨ kc_srt , scons V10 ∅ ⟩ ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_add V4 V3 V7) (scons (ra_add V6 V7 V8) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ V8 V2 V11) (scons (ra_pargs V11 ⟨ kc_nz , ∅ ⟩ V6 V12) (scons (ra_add V9 V5 V8) (scons (ra_pargs ⟨ kc_bvar , scons V9 ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V6 V13) ∅)))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rtail t1 t2 t3 t4 t5 t6 t7 t8) $ by opair_isset
l5: $ G ⇒ isset (ra_rtail V1 V2 V3 V4 V5 V6 ⟨ kc_srt , scons V10 ∅ ⟩ ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_add V4 V3 V7) (scons (ra_add V6 V7 V8) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ V8 V2 V11) (scons (ra_pargs V11 ⟨ kc_nz , ∅ ⟩ V6 V12) (scons (ra_add V9 V5 V8) (scons (ra_pargs ⟨ kc_bvar , scons V9 ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V6 V13) ∅))))) ∧ ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 = ra_rtail V1 V2 V3 V4 V5 V6 ⟨ kc_srt , scons V10 ∅ ⟩ ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_add V4 V3 V7) (scons (ra_add V6 V7 V8) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V5 ∅) ⟩ V8 V2 V11) (scons (ra_pargs V11 ⟨ kc_nz , ∅ ⟩ V6 V12) (scons (ra_add V9 V5 V8) (scons (ra_pargs ⟨ kc_bvar , scons V9 ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V6 V13) ∅))))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 = ra_rtail V1 V2 V3 V4 V5 V6 ⟨ kc_srt , scons V10 ∅ ⟩ ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ $ by and_elim_r [l6]
