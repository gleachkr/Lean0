l6: $ G ⇒ suc kr_le ⊆ suc kr_add $ by subset_trans [l4, l5]
l7: $ G ⇒ y1_lab kr_le (suc kr_le) ⊆ y1_lab kr_le (suc kr_add) $ by y1_lab_mono [l3, l6]
l8: $ G ⇒ pr_le ⊆ y1_lab kr_le (suc kr_add) $ by subset_trans [l1, l7]
l9: $ G ⇒ kr_le ⊆ kr_add $ by suc_subset
l10: $ G ⇒ suc kr_add ⊆ suc kr_add $ by subset_refl
l11: $ G ⇒ y1_lab kr_add (suc kr_add) ⊆ y1_lab kr_le (suc kr_add) $ by y1_lab_mono [l9, l10]
l12: $ G ⇒ pr_add ⊆ y1_lab kr_le (suc kr_add) $ by subset_trans [l2, l11]
l13: $ G ⇒ y1_u5 ⊆ y1_lab kr_le (suc kr_add) $ by cun_least [l8, l12]

