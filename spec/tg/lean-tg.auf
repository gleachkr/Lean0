l57: $ G ⇒ crn pp = crn (scons (ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6) (scons (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅)))) $ by crn_eq [l7]
l58: $ G ⇒ crn (scons (ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6) (scons (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅)))) ⊆ lrel $ by subset_eq_l [l57, #2]
l59: $ G ⇒ isset (ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6) $ by opair_isset
l60: $ G ⇒ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel $ by crn_scons_head [l59, l58]
l61: $ G ⇒ crn (scons (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅))) ⊆ lrel $ by crn_scons_tail [l58]
l62: $ G ⇒ isset (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) $ by opair_isset
l63: $ G ⇒ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel $ by crn_scons_head [l62, l61]
l64: $ G ⇒ crn (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅)) ⊆ lrel $ by crn_scons_tail [l61]
l65: $ G ⇒ isset (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) $ by opair_isset
l66: $ G ⇒ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel $ by crn_scons_head [l65, l64]
l67: $ G ⇒ crn (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅) ⊆ lrel $ by crn_scons_tail [l64]
l68: $ G ⇒ isset (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) $ by opair_isset
l69: $ G ⇒ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by crn_scons_head [l68, l67]
l70: $ G ⇒ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l66, l69]
l71: $ G ⇒ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l63, l70]
l72: $ G ⇒ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l60, l71]
l73: $ G ⇒ t6 = V11 ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l56, l72]
l74: $ G ⇒ t5 = ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ ∧ t6 = V11 ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l53, l73]
l75: $ G ⇒ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ ∧ t6 = V11 ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l50, l74]
l76: $ G ⇒ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ ∧ t6 = V11 ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l47, l75]
l77: $ G ⇒ t2 = V2 ∧ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ ∧ t6 = V11 ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l44, l76]
l78: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ ∧ t6 = V11 ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10 ∈ lrel ∧ ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11 ∈ lrel $ by and_intro [l41, l77]
