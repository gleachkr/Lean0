lemma y1_e_ihval_app (G: hyps) {D np n_v m_v v_v nf fld y_v j_v ni k_v a_v mn b_v f_v Y X1 X2 X3 U A: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19 V20 V21: set):
  $ G ⇒ ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V21 V11) (scons (ra_nidx V1 V9 V10) (scons (ra_add V2 V10 V11) (scons (ra_rehead V16 V18 V10 V21 V19) (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V16 V2) (scons (ra_add V8 V6 V12) (scons (ra_add V4 V3 V13) (scons (ra_add V12 V13 V14) (scons (ra_pargs ⟨ kc_ind_rec , scons V1 (scons V9 (scons V5 ∅)) ⟩ V14 V2 V17) (scons (ra_pargs V17 V12 V13 V18) (scons (ra_add V8 V7 V15) (scons (ra_pargs ⟨ kc_bvar , scons V15 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V20) ∅))))))))))) , ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 V21 ⟨ kc_app , scons V19 (scons V20 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ mn ∃ b_v ∃ f_v ∃ Y ∃ X1 ∃ X2 ∃ X3 ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = A ∧ t11 = ⟨ kc_app , scons X3 (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y X2 ni A X3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v nf a_v ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add a_v mn b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons j_v (scons v_v ∅)) ⟩ b_v np X1 ∈ lrel ∧ ra_pargs X1 a_v mn X2 ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V21 V11) (scons (ra_nidx V1 V9 V10) (scons (ra_add V2 V10 V11) (scons (ra_rehead V16 V18 V10 V21 V19) (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V16 V2) (scons (ra_add V8 V6 V12) (scons (ra_add V4 V3 V13) (scons (ra_add V12 V13 V14) (scons (ra_pargs ⟨ kc_ind_rec , scons V1 (scons V9 (scons V5 ∅)) ⟩ V14 V2 V17) (scons (ra_pargs V17 V12 V13 V18) (scons (ra_add V8 V7 V15) (scons (ra_pargs ⟨ kc_bvar , scons V15 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V20) ∅))))))))))) , ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 V21 ⟨ kc_app , scons V19 (scons V20 ∅) ⟩ ⟩ = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V21 V11) (scons (ra_nidx V1 V9 V10) (scons (ra_add V2 V10 V11) (scons (ra_rehead V16 V18 V10 V21 V19) (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V9 ∅) ⟩ V16 V2) (scons (ra_add V8 V6 V12) (scons (ra_add V4 V3 V13) (scons (ra_add V12 V13 V14) (scons (ra_pargs ⟨ kc_ind_rec , scons V1 (scons V9 (scons V5 ∅)) ⟩ V14 V2 V17) (scons (ra_pargs V17 V12 V13 V18) (scons (ra_add V8 V7 V15) (scons (ra_pargs ⟨ kc_bvar , scons V15 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V8 V20) ∅)))))))))))) $ by y1_opair_set_l [l1]
