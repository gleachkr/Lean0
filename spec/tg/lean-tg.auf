l5: $ G , x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_closed_proj ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_closed_proj ⊆ y1_lab kr_closed (suc kr_closed) $ by subset_intro [l12]

