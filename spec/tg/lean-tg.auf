lemma y1_p_iota_eq (G: hyps): $ G ⇒ pr_iota_eq ⊆ y1_lab kr_iota_eq (suc kr_iota_eq) $
----
l1: $ G ⇒ pr_iota_eq ⊆ y1_lab kr_iota_eq (suc kr_iota_eq) $ by y1_k_iota_eq_i

lemma y1_k_proj_eq_i (G: hyps): $ G ⇒ cl_proj_eq_i ⊆ y1_lab kr_proj_eq (suc kr_proj_eq) $
----
l1: $ G , x ∊ cl_proj_eq_i ⇒ x ∊ cl_proj_eq_i $ by ax
l2: $ G , x ∊ cl_proj_eq_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o (x = ⟨ scons (ra_ind_data y z u a) (scons (ra_clen u f) (scons (ra_ntys a g i) (scons (ra_nth_ty a b d o) (scons (ra_nth_ctor o ⟨ kc_nz , ∅ ⟩ e) (scons (ra_npis e j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ g f e h) (scons (ra_psplit j h ⟨ kc_nil , ∅ ⟩ v l) (scons (ra_capp v u w) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons b (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ j f m) (scons (ra_pargs m ⟨ kc_nz , ∅ ⟩ j n) (scons (ra_add k ⟨ kc_s , scons c ∅ ⟩ j) ∅))))))))))) , ra_proj_eq y b c w ⟨ kc_proj , scons z (scons c (scons n ∅)) ⟩ k ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ind_data y z u a) (scons (ra_clen u f) (scons (ra_ntys a g i) (scons (ra_nth_ty a b d o) (scons (ra_nth_ctor o ⟨ kc_nz , ∅ ⟩ e) (scons (ra_npis e j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ g f e h) (scons (ra_psplit j h ⟨ kc_nil , ∅ ⟩ v l) (scons (ra_capp v u w) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons b (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ j f m) (scons (ra_pargs m ⟨ kc_nz , ∅ ⟩ j n) (scons (ra_add k ⟨ kc_s , scons c ∅ ⟩ j) ∅))))))))))) , ra_proj_eq y b c w ⟨ kc_proj , scons z (scons c (scons n ∅)) ⟩ k ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u a) (scons (ra_clen u f) (scons (ra_ntys a g i) (scons (ra_nth_ty a b d o) (scons (ra_nth_ctor o ⟨ kc_nz , ∅ ⟩ e) (scons (ra_npis e j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ g f e h) (scons (ra_psplit j h ⟨ kc_nil , ∅ ⟩ v l) (scons (ra_capp v u w) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons b (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ j f m) (scons (ra_pargs m ⟨ kc_nz , ∅ ⟩ j n) (scons (ra_add k ⟨ kc_s , scons c ∅ ⟩ j) ∅))))))))))) , ra_proj_eq y b c w ⟨ kc_proj , scons z (scons c (scons n ∅)) ⟩ k ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_ind_data y z u a) (scons (ra_clen u f) (scons (ra_ntys a g i) (scons (ra_nth_ty a b d o) (scons (ra_nth_ctor o ⟨ kc_nz , ∅ ⟩ e) (scons (ra_npis e j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ g f e h) (scons (ra_psplit j h ⟨ kc_nil , ∅ ⟩ v l) (scons (ra_capp v u w) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons b (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ j f m) (scons (ra_pargs m ⟨ kc_nz , ∅ ⟩ j n) (scons (ra_add k ⟨ kc_s , scons c ∅ ⟩ j) ∅))))))))))) , ra_proj_eq y b c w ⟨ kc_proj , scons z (scons c (scons n ∅)) ⟩ k ⟩ ⇒ kr_proj_eq ∈ ω $ by x1_kr_proj_eq
