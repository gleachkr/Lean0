l24: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q3 = u_l ∧ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by weaken [#1]
l25: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ $ by and_elim_l [l24]
l26: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q3 = u_l ∧ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by and_elim_r [l24]
l27: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_k ∅ ⟩ $ by and_elim_l [l26]
l28: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ q3 = u_l ∧ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by and_elim_r [l26]
l29: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ q3 = u_l $ by and_elim_l [l28]
l30: $ GG , q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel ⇒ ra_isort u_B u_k u_l ∈ lrel ∧ ra_isort u_B u_k u_l ∈ y2_P_isort lrel $ by and_elim_r [l28]
