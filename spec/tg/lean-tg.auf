l17: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ ∃ f ∃ g ∃ i ∃ j (b = scons f (scons g (scons i (scons j ∅))) ∧ ⟨ K1 , f ⟩ ∈ sorted lsig lopen ∧ ⟨ K2 , g ⟩ ∈ sorted lsig lopen ∧ ⟨ K3 , i ⟩ ∈ sorted lsig lopen ∧ ⟨ K4 , j ⟩ ∈ sorted lsig lopen) $ by szip_args4 [l13, l14, l15, l16, l7, l6, l12]
