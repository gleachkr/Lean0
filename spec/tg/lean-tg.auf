l82: $ G ⇒ ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l81]
