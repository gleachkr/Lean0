l3: $ G ⇒ cl_rwalk_pi_rec ∪ cl_rwalk_res ⊆ y1_lab kr_rwalk (suc kr_rwalk) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_rwalk_pi_nr ⊆ y1_lab kr_rwalk (suc kr_rwalk) $ by y1_k_rwalk_pi_nr
l5: $ G ⇒ pr_rwalk ⊆ y1_lab kr_rwalk (suc kr_rwalk) $ by cun_least [l4, l3]

