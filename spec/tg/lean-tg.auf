lemma y1_e_spz_ctors_nil (G: hyps) {D N I X ni npi: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ ∅ , ra_spz_ctors V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ I ∃ X ∃ ni ∃ npi (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_cnil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_spz_ctors V1 V2 V3 V4 V5 V6 ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ = ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [#1]
