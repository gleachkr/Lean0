--| The atoms of `add` whose variants in `L` with the same inputs have the same outputs.
def y2_P_add (L: class) (.c .x1 .x2 .x3 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_add , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ L → x3 = x6))} $

lemma y2_add_ih (GG: hyps) (q1 q2 q3 w3: set):
  $ GG ⇒ ra_add q1 q2 q3 ∈ y2_P_add lrel $ > $ GG ⇒ ra_add q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ c ∊ y2_P_add lrel $ by ax
l2: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_add , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_add , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons q1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ ∀ x3 (c = ⟨ kr_add , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ c = ⟨ kr_add , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by all_elim [l4]
l6: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ c = ra_add q1 q2 q3 $ by ax
l7: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ ∀ x6 (⟨ kr_add , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ ra_add q1 q2 w3 ∈ lrel → q3 = w3 $ by all_elim [l7]
l9: $ GG , c = ra_add q1 q2 q3 , c ∊ y2_P_add lrel ⇒ ra_add q1 q2 w3 ∈ lrel $ by weaken [#2]
