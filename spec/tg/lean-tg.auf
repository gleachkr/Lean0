lemma v1_build4 (G: hyps) {x y u v: set} (C K1 K2 K3 K4: class) (c a b t: set):
  $ G ⇒ isset K1 $ > $ G ⇒ isset K2 $ > $ G ⇒ isset K3 $ > $ G ⇒ isset K4 $ > $ G ⇒ b ∊ fseq (trees ω) $ > $ G ⇒ cdm b = cdm a $ >
  $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ ∃ x ∃ y ∃ u ∃ v (t = ⟨ C , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen K1 ∧ y ∊ ofsort lsig lopen K2 ∧ u ∊ ofsort lsig lopen K3 ∧ v ∊ ofsort lsig lopen K4) $
----
l1: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) $ by ax
l2: $ G , c = C ∧ a = scons K1 (scons K2 (scons K3 (scons K4 ∅))) ⇒ c = C $ by and_elim_l [l1]
