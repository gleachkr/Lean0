l4: $ G , x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ ⇒ kr_inst ∈ ω $ by x1_kr_inst
l5: $ G , x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩ ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by y1_lab_self [l3, l4]
