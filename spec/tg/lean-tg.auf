l33: $ G ⇒ scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
