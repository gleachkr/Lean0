lemma y2_nfields_i1 (GG: hyps) {D b P T i c nf F K C: set} (o q1 q2 q3 q4: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_nfields q1 q2 q3 q4 ⟩ ∈ cl_nfields_i $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_nfields lrel $ > $ GG ⇒ ∀ D ∀ b ∀ P ∀ T ∀ i ∀ c ∀ nf ∀ F ∀ K ∀ C (q1 = D ∧ q2 = i ∧ q3 = c ∧ q4 = nf ∧ ra_ind_data D b P T ∈ lrel ∧ ra_nth_ty T i F C ∈ lrel ∧ ra_nth_ctor C c K ∈ lrel ∧ ra_npis K nf ∈ lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_nfields q1 q2 q3 q4 ⟩ , w ∊ cl_nfields_i ⇒ w ∊ cl_nfields_i $ by ax
l2: $ GG , w = ⟨ o , ra_nfields q1 q2 q3 q4 ⟩ , w ∊ cl_nfields_i ⇒ ∃ D ∃ b ∃ P ∃ T ∃ i ∃ c ∃ nf ∃ F ∃ K ∃ C (w = ⟨ scons (ra_ind_data D b P T) (scons (ra_nth_ty T i F C) (scons (ra_nth_ctor C c K) (scons (ra_npis K nf) ∅))) , ra_nfields D i c nf ⟩) $ by cab_elim [l1]
