lemma y1_d_rst_ty (G: hyps) {D N j_v np n_v m_v na k_v e_v S X X1 X2 e2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_ty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_rehead S X2 k_v e_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_ty ⇒ x ∊ cl_rst_ty $ by ax
l2: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_ty ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩ ⇒ x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩ ⇒ x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ f b) (scons (ra_aux_of y z u i) (scons (ra_ind_arity y v w a) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ w v i j) (scons (ra_add v c b) (scons (ra_spine g f c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ g j k) (scons (ra_rehead g k c f d) ∅))))))) , ra_rst y z f d ⟩ $ by eq_trans [l4, l5]
