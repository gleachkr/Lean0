l62: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_0l ∪ (cl_bor_0r ∪ (cl_bor_00 ∪ (cl_bor_01 ∪ (cl_bor_10 ∪ cl_bor_11)))) , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_0r ∪ (cl_bor_00 ∪ (cl_bor_01 ∪ (cl_bor_10 ∪ cl_bor_11))) ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by or_intro_r [l61]
l63: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_0l ∪ (cl_bor_0r ∪ (cl_bor_00 ∪ (cl_bor_01 ∪ (cl_bor_10 ∪ cl_bor_11)))) ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by or_elim [l54, l58, l62]
l64: $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_0l ∪ (cl_bor_0r ∪ (cl_bor_00 ∪ (cl_bor_01 ∪ (cl_bor_10 ∪ cl_bor_11)))) → ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by imp_intro [l63]
l65: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by imp_elim [l64, #1]

lemma y1_e_bxor_0l (G: hyps) {b_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ V1 V1 ⟩ = ⟨ pp , ra_bxor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bxor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bxor ⟨ kc_b0 , ∅ ⟩ V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_bxor t1 t2 t3 = ra_bxor ⟨ kc_b0 , ∅ ⟩ V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bxor t1 t2 t3 = ra_bxor ⟨ kc_b0 , ∅ ⟩ V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_bxor ∈ ω $ by x1_kr_bxor
l22: $ G ⇒ isset kr_bxor $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_bxor = kr_bxor ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_intro [l36]

lemma y1_d_bxor_0l (G: hyps) {b_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ ∈ cl_bxor_0l $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x ∊ cl_bxor_0l ⇒ x ∊ cl_bxor_0l $ by ax
l2: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x ∊ cl_bxor_0l ⇒ ∃ y (x = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by y1_e_bxor_0l [l6, l7]
l9: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x ∊ cl_bxor_0l ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by wcel_elim [#1, l9]

lemma y1_e_bxor_0r (G: hyps) {a_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = ⟨ ∅ , ra_bxor V1 ⟨ kc_b0 , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_bxor V1 ⟨ kc_b0 , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_bxor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bxor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bxor V1 ⟨ kc_b0 , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_bxor t1 t2 t3 = ra_bxor V1 ⟨ kc_b0 , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bxor t1 t2 t3 = ra_bxor V1 ⟨ kc_b0 , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l16, l19]
l21: $ G ⇒ kr_bxor ∈ ω $ by x1_kr_bxor
l22: $ G ⇒ isset kr_bxor $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_bxor = kr_bxor ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l26, l14, l16, l13, l19]
l28: $ G ⇒ t1 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l18, l11, l17]
l31: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by ex_intro [l36]

lemma y1_d_bxor_0r (G: hyps) {a_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ ∈ cl_bxor_0r $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $
----
l1: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x ∊ cl_bxor_0r ⇒ x ∊ cl_bxor_0r $ by ax
l2: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x ∊ cl_bxor_0r ⇒ ∃ y (x = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_bxor y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by y1_e_bxor_0r [l6, l7]
l9: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x ∊ cl_bxor_0r ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by wcel_elim [#1, l9]

lemma y1_e_bxor_00 (G: hyps) {a_v b_v c_v d_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = ⟨ scons (ra_bxor V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) , ra_bxor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bxor V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) , ra_bxor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 ⟩ = ⟨ pp , ra_bxor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_bxor V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bxor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bxor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_bxor V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) ∧ ra_bxor t1 t2 t3 = ra_bxor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_bxor V1 V2 V3) (scons (ra_bdbl V3 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_bxor t1 t2 t3 = ra_bxor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V4 $ by isset_var
l17: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_bxor ∈ ω $ by x1_kr_bxor
l23: $ G ⇒ isset kr_bxor $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_bxor = kr_bxor ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons V4 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons V4 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V4 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V4 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_bxor V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_bxor V1 V2 V3) (scons (ra_bdbl V3 V4) ∅)) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_bxor V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_bxor V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_bdbl V3 V4) ∅) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_bdbl V3 V4) $ by opair_isset
l42: $ G ⇒ ra_bdbl V3 V4 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ ra_bxor V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l39, l42]
l44: $ G ⇒ t3 = V4 ∧ ra_bxor V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l35, l43]
l45: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = V4 ∧ ra_bxor V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l32, l44]
l46: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = V4 ∧ ra_bxor V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel $ by and_intro [l29, l45]
l47: $ G ⇒ ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 d_v ∈ lrel) $ by ex_intro [l46]
l48: $ G ⇒ ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor V1 V2 c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l47]
l49: $ G ⇒ ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor V1 b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l48]
l50: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_intro [l49]

