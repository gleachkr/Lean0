l39: $ GG , ∃ b ∃ d ∃ e ∃ a (q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel) ⇒ q2 = w2 ∧ q3 = w3 $ by ex_elim [l38, l37]
l40: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by or_elim [l1, l14, l39]

lemma y2_isort_d1 (GG: hyps) (o q1 q2 q3 w2 w3: set):
  $ GG ⇒ ⟨ o , ra_isort q1 q2 q3 ⟩ ∈ cl_isort_srt $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_isort lrel $ > $ GG ⇒ ra_isort q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a $ by ax
l2: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ ra_isort q1 w2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ q2 = w2 ∧ q3 = w3 $ by y2_isort_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a → q2 = w2 ∧ q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ a (q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a → q2 = w2 ∧ q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by y2_isort_i1 [#1, #2, l5]

lemma y2_isort_i2 (GG: hyps) {A B k l: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_isort q1 q2 q3 ⟩ ∈ cl_isort_pi $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_isort lrel $ > $ GG ⇒ ∀ A ∀ B ∀ k ∀ l (q1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons k ∅ ⟩ ∧ q3 = l ∧ ra_isort B k l ∈ lrel ∧ ra_isort B k l ∈ y2_P_isort lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi ⇒ w ∊ cl_isort_pi $ by ax
l2: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi ⇒ ∃ A ∃ B ∃ k ∃ l (w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ w = ⟨ o , ra_isort q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ ⟨ o , ra_isort q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ ⟨ o , ra_isort q1 q2 q3 ⟩ = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset (ra_isort q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset (ra_isort B k l) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ scons (ra_isort B k l) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset (scons (ra_isort B k l) ∅) $ by y2_fs_set [l11]
l13: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset (ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l) $ by opair_isset
l14: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ o = scons (ra_isort B k l) ∅ ∧ ra_isort q1 q2 q3 = ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l $ by opair_inj_c [l6, l7, l8, l12, l13]
l15: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ o = scons (ra_isort B k l) ∅ $ by and_elim_l [l14]
l16: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ ⟨ kr_isort , scons q1 (scons q2 (scons q3 ∅)) ⟩ = ⟨ kr_isort , scons ⟨ kc_pi , scons A (scons B ∅) ⟩ (scons ⟨ kc_s , scons k ∅ ⟩ (scons l ∅)) ⟩ $ by and_elim_r [l14]
l17: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ kr_isort ∈ ω $ by x1_kr_isort
l18: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset kr_isort $ by wcel_isset [l17]
l19: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset q1 $ by isset_var
l20: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset q2 $ by isset_var
l21: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset q3 $ by isset_var
l22: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset ⟨ kc_pi , scons A (scons B ∅) ⟩ $ by opair_isset
l23: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset ⟨ kc_s , scons k ∅ ⟩ $ by opair_isset
l24: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_pi , w = ⟨ scons (ra_isort B k l) ∅ , ra_isort ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ l ⟩ ⇒ isset l $ by isset_var
