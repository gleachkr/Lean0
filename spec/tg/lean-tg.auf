l27: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = l $ by and_intro [l25, l26]
l28: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ q1 = ⟨ kc_srt , scons l ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = l $ by and_intro [l23, l27]
l29: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ ∀ l (q1 = ⟨ kc_srt , scons l ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = l → ph) $ by weaken [#3]
l30: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ q1 = ⟨ kc_srt , scons l ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = l → ph $ by all_elim [l29]
l31: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ ph $ by imp_elim [l30, l28]
l32: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt ⇒ ph $ by ex_elim [l2, l31]
l33: $ GG ⇒ ph $ by wcel_elim [#1, l32]

lemma y2_isort_e1 (GG: hyps) (q1 q2 q3 w2 w3 u_l v_l: set):
  $ GG ⇒ q1 = ⟨ kc_srt , scons u_l ∅ ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q3 = u_l $ > $ GG ⇒ q1 = ⟨ kc_srt , scons v_l ∅ ⟩ $ > $ GG ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ w3 = v_l $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_srt , scons u_l ∅ ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_srt , scons u_l ∅ ⟩ = ⟨ kc_srt , scons v_l ∅ ⟩ $ by eq_trans [l1, #4]
l3: $ GG ⇒ kc_srt ∈ ω $ by v1_kc_srt
l4: $ GG ⇒ isset kc_srt $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_l $ by isset_var
l6: $ GG ⇒ isset v_l $ by isset_var
l7: $ GG ⇒ u_l = v_l $ by y2_nd1 [l2, l4, l5, l6]
l8: $ GG ⇒ ∅ = ∅ $ by eq_refl
l9: $ GG ⇒ kc_nz = kc_nz $ by eq_refl
l10: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by opair_eq [l9, l8]
l11: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = w2 $ by eq_sym [#5]
l12: $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [#2, l10]
l13: $ GG ⇒ q2 = w2 $ by eq_trans [l12, l11]
l14: $ GG ⇒ v_l = w3 $ by eq_sym [#6]
l15: $ GG ⇒ q3 = v_l $ by eq_trans [#3, l7]
l16: $ GG ⇒ q3 = w3 $ by eq_trans [l15, l14]
l17: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by and_intro [l13, l16]

lemma y2_isort_c1 (GG: hyps) (q1 q2 q3 w2 w3 u_l: set):
  $ GG ⇒ q1 = ⟨ kc_srt , scons u_l ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_l $ > $ GG ⇒ ra_isort q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG ⇒ ∃ a (q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ∨ ∃ b ∃ d ∃ e ∃ a (q1 = ⟨ kc_pi , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = a ∧ ra_isort d e a ∈ lrel) $ by lrel_isort_cases [#2]
l2: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by ax
l3: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_srt , scons u_l ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_l $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_srt , scons u_l ∅ ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_l $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = u_l $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_srt , scons a ∅ ⟩ $ by and_elim_l [l2]
l9: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by and_elim_r [l2]
l10: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ w3 = a $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = w2 ∧ q3 = w3 $ by y2_isort_e1 [l4, l6, l7, l8, l10, l11]
l13: $ GG , ∃ a (q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ ∃ a (q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) $ by ax
l14: $ GG , ∃ a (q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ q2 = w2 ∧ q3 = w3 $ by ex_elim [l13, l12]
