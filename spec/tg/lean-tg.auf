l4: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l5: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ y) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_lsubst_lt ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_lsubst_lt ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by subset_intro [l10]

