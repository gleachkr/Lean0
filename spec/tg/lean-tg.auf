l4: $ GG , q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel ⇒ q1 = u_D $ by and_elim_l [l3]
l5: $ GG , q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel ⇒ q2 = u_np ∧ q3 = u_n ∧ q4 = u_m ∧ ra_ind_data u_D u_b u_P u_T ∈ lrel ∧ ra_clen u_P u_np ∈ lrel ∧ ra_ntys u_T u_n u_m ∈ lrel $ by and_elim_r [l3]
