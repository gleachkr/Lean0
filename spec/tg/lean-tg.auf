lemma y2_rehead_e1 (GG: hyps) (q1 q2 q3 q4 q5 w1 w5 u_Y u_X v_Y v_X: set):
  $ GG ⇒ q1 = u_Y $ > $ GG ⇒ q2 = u_X $ > $ GG ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q4 = u_Y $ > $ GG ⇒ q5 = u_X $ > $ GG ⇒ w1 = v_Y $ > $ GG ⇒ q2 = v_X $ > $ GG ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q4 = v_Y $ > $ GG ⇒ w5 = v_X $ > $ GG ⇒ q1 = w1 ∧ q5 = w5 $
----
l1: $ GG ⇒ u_X = q2 $ by eq_sym [#2]
l2: $ GG ⇒ u_X = v_X $ by eq_trans [l1, #7]
l3: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = q3 $ by eq_sym [#3]
l4: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [l3, #8]
l5: $ GG ⇒ u_Y = q4 $ by eq_sym [#4]
l6: $ GG ⇒ u_Y = v_Y $ by eq_trans [l5, #9]
l7: $ GG ⇒ v_Y = w1 $ by eq_sym [#6]
l8: $ GG ⇒ q1 = v_Y $ by eq_trans [#1, l6]
l9: $ GG ⇒ q1 = w1 $ by eq_trans [l8, l7]
l10: $ GG ⇒ v_X = w5 $ by eq_sym [#10]
l11: $ GG ⇒ q5 = v_X $ by eq_trans [#5, l2]
l12: $ GG ⇒ q5 = w5 $ by eq_trans [l11, l10]
l13: $ GG ⇒ q1 = w1 ∧ q5 = w5 $ by and_intro [l9, l12]

lemma y2_rehead_c1 (GG: hyps) (q1 q2 q3 q4 q5 w1 w5 u_Y u_X: set):
  $ GG ⇒ q1 = u_Y ∧ q2 = u_X ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = u_Y ∧ q5 = u_X $ > $ GG ⇒ ra_rehead w1 q2 q3 q4 w5 ∈ lrel $ > $ GG ⇒ q1 = w1 ∧ q5 = w5 $
----
l1: $ GG ⇒ ∃ a ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ∨ ∃ a ∃ b ∃ d ∃ e ∃ f ∃ g (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_s , scons g ∅ ⟩ ∧ q4 = ⟨ kc_app , scons d (scons f ∅) ⟩ ∧ w5 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ ra_rehead a b g d e ∈ lrel) $ by lrel_rehead_cases [#2]
l2: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b $ by ax
l3: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q1 = u_Y ∧ q2 = u_X ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = u_Y ∧ q5 = u_X $ by weaken [#1]
l4: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q1 = u_Y $ by and_elim_l [l3]
l5: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q2 = u_X ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = u_Y ∧ q5 = u_X $ by and_elim_r [l3]
l6: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q2 = u_X $ by and_elim_l [l5]
l7: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = u_Y ∧ q5 = u_X $ by and_elim_r [l5]
l8: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l7]
l9: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q4 = u_Y ∧ q5 = u_X $ by and_elim_r [l7]
l10: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q4 = u_Y $ by and_elim_l [l9]
l11: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q5 = u_X $ by and_elim_r [l9]
l12: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ w1 = a $ by and_elim_l [l2]
l13: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b $ by and_elim_r [l2]
l14: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q2 = b $ by and_elim_l [l13]
l15: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b $ by and_elim_r [l13]
l16: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l15]
l17: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q4 = a ∧ w5 = b $ by and_elim_r [l15]
l18: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q4 = a $ by and_elim_l [l17]
l19: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ w5 = b $ by and_elim_r [l17]
l20: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q1 = w1 ∧ q5 = w5 $ by y2_rehead_e1 [l4, l6, l8, l10, l11, l12, l14, l16, l18, l19]
l21: $ GG , ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ⇒ ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) $ by ax
l22: $ GG , ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ⇒ q1 = w1 ∧ q5 = w5 $ by ex_elim [l21, l20]
l23: $ GG , ∃ a ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ⇒ ∃ a ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) $ by ax
l24: $ GG , ∃ a ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ⇒ q1 = w1 ∧ q5 = w5 $ by ex_elim [l23, l22]
