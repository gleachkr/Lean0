l76: $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_z ∪ (cl_lsubst_s ∪ (cl_lsubst_max ∪ (cl_lsubst_imax ∪ (cl_lsubst_eq ∪ (cl_lsubst_lt ∪ cl_lsubst_gt))))) → ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) ∨ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) ∨ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) ∨ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) ∨ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) ∨ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) ∨ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by imp_intro [l75]
l77: $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) ∨ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) ∨ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) ∨ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) ∨ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) ∨ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) ∨ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by imp_elim [l76, #1]

lemma y1_e_closed_bvar (G: hyps) {i_v k_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅ , ra_closed V2 ⟨ kc_bvar , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅ , ra_closed V2 ⟨ kc_bvar , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V2 ⟨ kc_bvar , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅ ∧ ra_closed t1 t2 = ra_closed V2 ⟨ kc_bvar , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V2 ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_bvar , scons V1 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ scons V2 (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V2 (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V2 (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V2 (scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V2 ∧ scons t2 ∅ = scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V2 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_bvar , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2) $ by opair_isset
l32: $ G ⇒ ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = V2 ∧ t2 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ k_v ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by ex_intro [l35]

lemma y1_d_closed_bvar (G: hyps) {i_v k_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_bvar $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_bvar ⇒ x ∊ cl_closed_bvar $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_bvar ⇒ ∃ y ∃ z (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩ ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by y1_e_closed_bvar [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_closed z ⟨ kc_bvar , scons y ∅ ⟩ ⟩) ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_bvar ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by wcel_elim [#1, l11]

lemma y1_e_closed_srt (G: hyps) {k_v l_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_srt , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_srt , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_srt , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_srt , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_srt , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_srt , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_srt , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_srt , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_srt , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_srt , scons V2 ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ l_v (t1 = V1 ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_intro [l30]

lemma y1_d_closed_srt (G: hyps) {k_v l_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_srt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_srt ⇒ x ∊ cl_closed_srt $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_srt ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩ ⇒ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by y1_e_closed_srt [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_srt , scons z ∅ ⟩ ⟩) ⇒ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_srt ⇒ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_closed_app (G: hyps) {k_v f_v a_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_closed V1 V2) (scons (ra_closed V1 V3) ∅) , ra_closed V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_closed V1 V2) (scons (ra_closed V1 V3) ∅) , ra_closed V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_closed V1 V2) (scons (ra_closed V1 V3) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_closed V1 V2) (scons (ra_closed V1 V3) ∅) ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_closed V1 V2) (scons (ra_closed V1 V3) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_closed V1 V2) (scons (ra_closed V1 V3) ∅)) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_closed V1 V2) (scons (ra_closed V1 V3) ∅)) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_closed V1 V2) $ by opair_isset
l32: $ G ⇒ ra_closed V1 V2 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_closed V1 V3) ∅) ⊆ lrel $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_closed V1 V3) $ by opair_isset
l35: $ G ⇒ ra_closed V1 V3 ∈ lrel $ by crn_scons_head [l34, l33]
l36: $ G ⇒ ra_closed V1 V2 ∈ lrel ∧ ra_closed V1 V3 ∈ lrel $ by and_intro [l32, l35]
l37: $ G ⇒ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed V1 V3 ∈ lrel $ by and_intro [l28, l36]
l38: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons V3 ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed V1 V3 ∈ lrel $ by and_intro [l25, l37]
l39: $ G ⇒ ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_app , scons V2 (scons a_v ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed V1 a_v ∈ lrel) $ by ex_intro [l38]
l40: $ G ⇒ ∃ f_v ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed V1 f_v ∈ lrel ∧ ra_closed V1 a_v ∈ lrel) $ by ex_intro [l39]
l41: $ G ⇒ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by ex_intro [l40]

lemma y1_d_closed_app (G: hyps) {k_v f_v a_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_app ⇒ x ∊ cl_closed_app $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_app ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by y1_e_closed_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed y u) ∅) , ra_closed y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_app ⇒ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_closed_lam (G: hyps) {k_v A b_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) , ra_closed V1 ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) , ra_closed V1 ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅)) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅)) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_closed V1 V2) $ by opair_isset
l32: $ G ⇒ ra_closed V1 V2 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) ⊆ lrel $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) $ by opair_isset
l35: $ G ⇒ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by crn_scons_head [l34, l33]
l36: $ G ⇒ ra_closed V1 V2 ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by and_intro [l32, l35]
l37: $ G ⇒ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by and_intro [l28, l36]
l38: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lam , scons V2 (scons V3 ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by and_intro [l25, l37]
l39: $ G ⇒ ∃ b_v (t1 = V1 ∧ t2 = ⟨ kc_lam , scons V2 (scons b_v ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ b_v ∈ lrel) $ by ex_intro [l38]
l40: $ G ⇒ ∃ A ∃ b_v (t1 = V1 ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed V1 A ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ b_v ∈ lrel) $ by ex_intro [l39]
l41: $ G ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by ex_intro [l40]

lemma y1_d_closed_lam (G: hyps) {k_v A b_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_lam $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_lam ⇒ x ∊ cl_closed_lam $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_lam ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by y1_e_closed_lam [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_lam , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_lam ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_closed_pi (G: hyps) {k_v A b_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) , ra_closed V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) , ra_closed V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅)) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_closed V1 V2) (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅)) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_closed V1 V2) $ by opair_isset
l32: $ G ⇒ ra_closed V1 V2 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) ∅) ⊆ lrel $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3) $ by opair_isset
l35: $ G ⇒ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by crn_scons_head [l34, l33]
l36: $ G ⇒ ra_closed V1 V2 ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by and_intro [l32, l35]
l37: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by and_intro [l28, l36]
l38: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ V3 ∈ lrel $ by and_intro [l25, l37]
l39: $ G ⇒ ∃ b_v (t1 = V1 ∧ t2 = ⟨ kc_pi , scons V2 (scons b_v ∅) ⟩ ∧ ra_closed V1 V2 ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ b_v ∈ lrel) $ by ex_intro [l38]
l40: $ G ⇒ ∃ A ∃ b_v (t1 = V1 ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed V1 A ∈ lrel ∧ ra_closed ⟨ kc_s , scons V1 ∅ ⟩ b_v ∈ lrel) $ by ex_intro [l39]
l41: $ G ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by ex_intro [l40]

lemma y1_d_closed_pi (G: hyps) {k_v A b_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_pi ⇒ x ∊ cl_closed_pi $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_pi ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by y1_e_closed_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_closed y z) (scons (ra_closed ⟨ kc_s , scons y ∅ ⟩ u) ∅) , ra_closed y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_pi ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_closed_cst (G: hyps) {k_v a_v S: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_cst , scons V2 (scons V3 ∅) ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ S (t1 = V1 ∧ t2 = ⟨ kc_cst , scons V2 (scons S ∅) ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ a_v ∃ S (t1 = V1 ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by ex_intro [l30]
l32: $ G ⇒ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by ex_intro [l31]

lemma y1_d_closed_cst (G: hyps) {k_v a_v S: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_cst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_cst ⇒ x ∊ cl_closed_cst $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_cst ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by y1_e_closed_cst [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_cst , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_cst ⇒ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) $ by wcel_elim [#1, l13]

lemma y1_e_closed_lit (G: hyps) {k_v n_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_lit , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_lit , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_lit , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_lit , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_lit , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_lit , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_lit , scons V2 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_lit , scons V2 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_lit , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_lit , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_lit , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_lit , scons V2 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_lit , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_lit , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_lit , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lit , scons V2 ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ n_v (t1 = V1 ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by ex_intro [l30]

lemma y1_d_closed_lit (G: hyps) {k_v n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_lit $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_lit ⇒ x ∊ cl_closed_lit $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_lit ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩ ⇒ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by y1_e_closed_lit [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_lit , scons z ∅ ⟩ ⟩) ⇒ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_lit ⇒ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_closed_ind_ty (G: hyps) {k_v D i_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_ind_ty , scons V2 (scons V3 ∅) ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ i_v (t1 = V1 ∧ t2 = ⟨ kc_ind_ty , scons V2 (scons i_v ∅) ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ D ∃ i_v (t1 = V1 ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $ by ex_intro [l30]
l32: $ G ⇒ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $ by ex_intro [l31]

lemma y1_d_closed_ind_ty (G: hyps) {k_v D i_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_ind_ty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_ty ⇒ x ∊ cl_closed_ind_ty $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_ty ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $ by y1_e_closed_ind_ty [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_ty ⇒ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) $ by wcel_elim [#1, l13]

lemma y1_e_closed_ind_ctor (G: hyps) {k_v D i_v c_v: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ c_v (t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons V3 (scons c_v ∅)) ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ i_v ∃ c_v (t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons V2 (scons i_v (scons c_v ∅)) ⟩) $ by ex_intro [l30]
l32: $ G ⇒ ∃ D ∃ i_v ∃ c_v (t1 = V1 ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $ by ex_intro [l31]
l33: $ G ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $ by ex_intro [l32]

lemma y1_d_closed_ind_ctor (G: hyps) {k_v D i_v c_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_ind_ctor $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $
