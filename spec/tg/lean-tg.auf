lemma y1_e_bpow_0 (G: hyps) {a_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_bpow t1 t2 t3 ⟩ = ⟨ ∅ , ra_bpow V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_bpow V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⟩ = ⟨ pp , ra_bpow t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bpow t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bpow V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_bpow t1 t2 t3 = ra_bpow V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bpow t1 t2 t3 = ra_bpow V1 ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_bpow ∈ ω $ by x1_kr_bpow
l23: $ G ⇒ isset kr_bpow $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_bpow = kr_bpow ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by and_intro [l32, l35]
