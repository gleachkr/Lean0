lemma y1_d_spz_ctors_cons (G: hyps) {D I N NI X K K1 K2 K3 K4 ni npi C C2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_spz_ctors_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ I ∃ N ∃ NI ∃ X ∃ K ∃ K1 ∃ K2 ∃ K3 ∃ K4 ∃ ni ∃ npi ∃ C ∃ C2 (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = ⟨ kc_ccons , scons K4 (scons C2 ∅) ⟩ ∧ ra_sinst I ⟨ kc_nz , ∅ ⟩ ni npi K K1 ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_rst I NI K1 K2 ∈ lrel ∧ ra_afree K2 ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X K2 K3 ∈ lrel ∧ ra_spz D N ⟨ kc_nz , ∅ ⟩ K3 K4 ∈ lrel ∧ ra_spz_ctors D N I X ni npi C C2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_spz_ctors_cons ⇒ x ∊ cl_spz_ctors_cons $ by ax
l2: $ G , x = ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_spz_ctors_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_sinst z ⟨ kc_nz , ∅ ⟩ i j a b) (scons (ra_ind_nested z v) (scons (ra_rst z v b c) (scons (ra_afree c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ w c f) (scons (ra_spz y u ⟨ kc_nz , ∅ ⟩ f g) (scons (ra_spz_ctors y u z w i j k d) ∅)))))) , ra_spz_ctors y u z w i j ⟨ kc_ccons , scons a (scons k ∅) ⟩ ⟨ kc_ccons , scons g (scons d ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_sinst z ⟨ kc_nz , ∅ ⟩ i j a b) (scons (ra_ind_nested z v) (scons (ra_rst z v b c) (scons (ra_afree c) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ w c f) (scons (ra_spz y u ⟨ kc_nz , ∅ ⟩ f g) (scons (ra_spz_ctors y u z w i j k d) ∅)))))) , ra_spz_ctors y u z w i j ⟨ kc_ccons , scons a (scons k ∅) ⟩ ⟨ kc_ccons , scons g (scons d ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
