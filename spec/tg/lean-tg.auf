lemma y1_k_afree_ind_rec (G: hyps): $ G ⇒ cl_afree_ind_rec ⊆ y1_lab kr_afree (suc kr_afree) $
----
l1: $ G , x ∊ cl_afree_ind_rec ⇒ x ∊ cl_afree_ind_rec $ by ax
l2: $ G , x ∊ cl_afree_ind_rec ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ kr_afree ∈ ω $ by x1_kr_afree
l5: $ G , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ x ∊ y1_lab kr_afree (suc kr_afree) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_afree (suc kr_afree) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_afree (suc kr_afree) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_afree_ind_rec ⇒ x ∊ y1_lab kr_afree (suc kr_afree) $ by ex_elim [l2, l9]
