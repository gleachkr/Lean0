l51: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ (scons ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ∅))))) $ by y1_scons_inj [l50, l22, l38, l21, l37]
l52: $ G ⇒ t2 = V2 $ by and_elim_l [l51]
l53: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ (scons ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ∅))))) $ by and_elim_r [l51]
