lemma y2_nth_ctor_d1 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ ∈ cl_nth_ctor_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_nth_ctor lrel $ > $ GG ⇒ ra_nth_ctor q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a $ by ax
l2: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ ra_nth_ctor q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ q3 = w3 $ by y2_nth_ctor_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ b (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ a ∀ b (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a → q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ q3 = w3 $ by y2_nth_ctor_i1 [#1, #2, l6]

lemma y2_nth_ctor_i2 (GG: hyps) {K K2 C c: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ ∈ cl_nth_ctor_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_nth_ctor lrel $ > $ GG ⇒ ∀ K ∀ K2 ∀ C ∀ c (q1 = ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ∧ q2 = ⟨ kc_s , scons c ∅ ⟩ ∧ q3 = K ∧ ra_nth_ctor C c K ∈ lrel ∧ ra_nth_ctor C c K ∈ y2_P_nth_ctor lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s ⇒ w ∊ cl_nth_ctor_s $ by ax
l2: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s ⇒ ∃ K ∃ K2 ∃ C ∃ c (w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ isset (ra_nth_ctor q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ isset (ra_nth_ctor C c K) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ scons (ra_nth_ctor C c K) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ isset (scons (ra_nth_ctor C c K) ∅) $ by y2_fs_set [l11]
l13: $ GG , w = ⟨ o , ra_nth_ctor q1 q2 q3 ⟩ , w ∊ cl_nth_ctor_s , w = ⟨ scons (ra_nth_ctor C c K) ∅ , ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K ⟩ ⇒ isset (ra_nth_ctor ⟨ kc_ccons , scons K2 (scons C ∅) ⟩ ⟨ kc_s , scons c ∅ ⟩ K) $ by opair_isset
