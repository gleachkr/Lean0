lemma y1_k_pargs_z (G: hyps): $ G ⇒ cl_pargs_z ⊆ y1_lab kr_pargs (suc kr_pargs) $
----
l1: $ G , x ∊ cl_pargs_z ⇒ x ∊ cl_pargs_z $ by ax
l2: $ G , x ∊ cl_pargs_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ kr_pargs ∈ ω $ by x1_kr_pargs
l5: $ G , x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x ∊ y1_lab kr_pargs (suc kr_pargs) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_pargs y z ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ x ∊ y1_lab kr_pargs (suc kr_pargs) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_pargs_z ⇒ x ∊ y1_lab kr_pargs (suc kr_pargs) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_pargs_z ⊆ y1_lab kr_pargs (suc kr_pargs) $ by subset_intro [l8]

lemma y1_k_pargs_s (G: hyps): $ G ⇒ cl_pargs_s ⊆ y1_lab kr_pargs (suc kr_pargs) $
----
l1: $ G , x ∊ cl_pargs_s ⇒ x ∊ cl_pargs_s $ by ax
l2: $ G , x ∊ cl_pargs_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ kr_pargs ∈ ω $ by x1_kr_pargs
l5: $ G , x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_pargs (suc kr_pargs) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_pargs (suc kr_pargs) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_pargs (suc kr_pargs) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pargs y ⟨ kc_s , scons u ∅ ⟩ v z) ∅ , ra_pargs y u ⟨ kc_s , scons v ∅ ⟩ ⟨ kc_app , scons z (scons ⟨ kc_bvar , scons u ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_pargs (suc kr_pargs) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_pargs_s ⇒ x ∊ y1_lab kr_pargs (suc kr_pargs) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_pargs_s ⊆ y1_lab kr_pargs (suc kr_pargs) $ by subset_intro [l12]

lemma y1_p_pargs (G: hyps): $ G ⇒ pr_pargs ⊆ y1_lab kr_pargs (suc kr_pargs) $
----
l1: $ G ⇒ cl_pargs_s ⊆ y1_lab kr_pargs (suc kr_pargs) $ by y1_k_pargs_s
l2: $ G ⇒ cl_pargs_z ⊆ y1_lab kr_pargs (suc kr_pargs) $ by y1_k_pargs_z
l3: $ G ⇒ pr_pargs ⊆ y1_lab kr_pargs (suc kr_pargs) $ by cun_least [l2, l1]

lemma y1_k_spine_z (G: hyps): $ G ⇒ cl_spine_z ⊆ y1_lab kr_spine (suc kr_spine) $
----
l1: $ G , x ∊ cl_spine_z ⇒ x ∊ cl_spine_z $ by ax
l2: $ G , x ∊ cl_spine_z ⇒ ∃ y (x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_spine ∈ ω $ by x1_kr_spine
l5: $ G , x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_spine (suc kr_spine) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_spine_z ⇒ x ∊ y1_lab kr_spine (suc kr_spine) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_spine_z ⊆ y1_lab kr_spine (suc kr_spine) $ by subset_intro [l6]

lemma y1_k_spine_s (G: hyps): $ G ⇒ cl_spine_s ⊆ y1_lab kr_spine (suc kr_spine) $
----
l1: $ G , x ∊ cl_spine_s ⇒ x ∊ cl_spine_s $ by ax
l2: $ G , x ∊ cl_spine_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ kr_spine ∈ ω $ by x1_kr_spine
l5: $ G , x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_spine (suc kr_spine) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_spine (suc kr_spine) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_spine (suc kr_spine) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_spine y z v) ∅ , ra_spine y ⟨ kc_app , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_spine (suc kr_spine) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_spine_s ⇒ x ∊ y1_lab kr_spine (suc kr_spine) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_spine_s ⊆ y1_lab kr_spine (suc kr_spine) $ by subset_intro [l12]

lemma y1_p_spine (G: hyps): $ G ⇒ pr_spine ⊆ y1_lab kr_spine (suc kr_spine) $
----
l1: $ G ⇒ cl_spine_s ⊆ y1_lab kr_spine (suc kr_spine) $ by y1_k_spine_s
l2: $ G ⇒ cl_spine_z ⊆ y1_lab kr_spine (suc kr_spine) $ by y1_k_spine_z
l3: $ G ⇒ pr_spine ⊆ y1_lab kr_spine (suc kr_spine) $ by cun_least [l2, l1]

lemma y1_k_rehead_z (G: hyps): $ G ⇒ cl_rehead_z ⊆ y1_lab kr_rehead (suc kr_rehead) $
----
l1: $ G , x ∊ cl_rehead_z ⇒ x ∊ cl_rehead_z $ by ax
l2: $ G , x ∊ cl_rehead_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ kr_rehead ∈ ω $ by x1_kr_rehead
l5: $ G , x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩ ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_rehead y z ⟨ kc_nz , ∅ ⟩ y z ⟩) ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_rehead_z ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_rehead_z ⊆ y1_lab kr_rehead (suc kr_rehead) $ by subset_intro [l8]

lemma y1_k_rehead_s (G: hyps): $ G ⇒ cl_rehead_s ⊆ y1_lab kr_rehead (suc kr_rehead) $
----
l1: $ G , x ∊ cl_rehead_s ⇒ x ∊ cl_rehead_s $ by ax
l2: $ G , x ∊ cl_rehead_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ kr_rehead ∈ ω $ by x1_kr_rehead
l5: $ G , x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rehead y z a u v) ∅ , ra_rehead y z ⟨ kc_s , scons a ∅ ⟩ ⟨ kc_app , scons u (scons w ∅) ⟩ ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_rehead_s ⇒ x ∊ y1_lab kr_rehead (suc kr_rehead) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_rehead_s ⊆ y1_lab kr_rehead (suc kr_rehead) $ by subset_intro [l16]

lemma y1_p_rehead (G: hyps): $ G ⇒ pr_rehead ⊆ y1_lab kr_rehead (suc kr_rehead) $
----
l1: $ G ⇒ cl_rehead_s ⊆ y1_lab kr_rehead (suc kr_rehead) $ by y1_k_rehead_s
l2: $ G ⇒ cl_rehead_z ⊆ y1_lab kr_rehead (suc kr_rehead) $ by y1_k_rehead_z
l3: $ G ⇒ pr_rehead ⊆ y1_lab kr_rehead (suc kr_rehead) $ by cun_least [l2, l1]

lemma y1_k_has_arg_z (G: hyps): $ G ⇒ cl_has_arg_z ⊆ y1_lab kr_has_arg (suc kr_has_arg) $
----
l1: $ G , x ∊ cl_has_arg_z ⇒ x ∊ cl_has_arg_z $ by ax
l2: $ G , x ∊ cl_has_arg_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ kr_has_arg ∈ ω $ by x1_kr_has_arg
l5: $ G , x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩ ⇒ x ∊ y1_lab kr_has_arg (suc kr_has_arg) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_has_arg ⟨ kc_app , scons y (scons z ∅) ⟩ z ⟩) ⇒ x ∊ y1_lab kr_has_arg (suc kr_has_arg) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_has_arg_z ⇒ x ∊ y1_lab kr_has_arg (suc kr_has_arg) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_has_arg_z ⊆ y1_lab kr_has_arg (suc kr_has_arg) $ by subset_intro [l8]

lemma y1_k_has_arg_s (G: hyps): $ G ⇒ cl_has_arg_s ⊆ y1_lab kr_has_arg (suc kr_has_arg) $
----
l1: $ G , x ∊ cl_has_arg_s ⇒ x ∊ cl_has_arg_s $ by ax
l2: $ G , x ∊ cl_has_arg_s ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ kr_has_arg ∈ ω $ by x1_kr_has_arg
l5: $ G , x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩ ⇒ x ∊ y1_lab kr_has_arg (suc kr_has_arg) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) ⇒ ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) ⇒ x ∊ y1_lab kr_has_arg (suc kr_has_arg) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_has_arg y z) ∅ , ra_has_arg ⟨ kc_app , scons y (scons u ∅) ⟩ z ⟩) ⇒ x ∊ y1_lab kr_has_arg (suc kr_has_arg) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_has_arg_s ⇒ x ∊ y1_lab kr_has_arg (suc kr_has_arg) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_has_arg_s ⊆ y1_lab kr_has_arg (suc kr_has_arg) $ by subset_intro [l10]

lemma y1_p_has_arg (G: hyps): $ G ⇒ pr_has_arg ⊆ y1_lab kr_has_arg (suc kr_has_arg) $
----
l1: $ G ⇒ cl_has_arg_s ⊆ y1_lab kr_has_arg (suc kr_has_arg) $ by y1_k_has_arg_s
l2: $ G ⇒ cl_has_arg_z ⊆ y1_lab kr_has_arg (suc kr_has_arg) $ by y1_k_has_arg_z
l3: $ G ⇒ pr_has_arg ⊆ y1_lab kr_has_arg (suc kr_has_arg) $ by cun_least [l2, l1]

lemma y1_k_leaf_has_pi (G: hyps): $ G ⇒ cl_leaf_has_pi ⊆ y1_lab kr_leaf_has (suc kr_leaf_has) $
----
l1: $ G , x ∊ cl_leaf_has_pi ⇒ x ∊ cl_leaf_has_pi $ by ax
l2: $ G , x ∊ cl_leaf_has_pi ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ kr_leaf_has ∈ ω $ by x1_kr_leaf_has
l5: $ G , x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_leaf_has (suc kr_leaf_has) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_leaf_has (suc kr_leaf_has) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_leaf_has ⟨ kc_s , scons y ∅ ⟩ u) ∅ , ra_leaf_has y ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_leaf_has (suc kr_leaf_has) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_leaf_has_pi ⇒ x ∊ y1_lab kr_leaf_has (suc kr_leaf_has) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_leaf_has_pi ⊆ y1_lab kr_leaf_has (suc kr_leaf_has) $ by subset_intro [l10]

lemma y1_k_leaf_has_app (G: hyps): $ G ⇒ cl_leaf_has_app ⊆ y1_lab kr_leaf_has (suc kr_leaf_has) $
----
l1: $ G , x ∊ cl_leaf_has_app ⇒ x ∊ cl_leaf_has_app $ by ax
l2: $ G , x ∊ cl_leaf_has_app ⇒ ∃ y ∃ z (x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ kr_leaf_has ∈ ω $ by x1_kr_leaf_has
l5: $ G , x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩ ⇒ x ∊ y1_lab kr_leaf_has (suc kr_leaf_has) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩) ⇒ ∃ z (x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ scons (ra_has_arg z ⟨ kc_bvar , scons y ∅ ⟩) ∅ , ra_leaf_has y z ⟩) ⇒ x ∊ y1_lab kr_leaf_has (suc kr_leaf_has) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_leaf_has_app ⇒ x ∊ y1_lab kr_leaf_has (suc kr_leaf_has) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_leaf_has_app ⊆ y1_lab kr_leaf_has (suc kr_leaf_has) $ by subset_intro [l8]

lemma y1_p_leaf_has (G: hyps): $ G ⇒ pr_leaf_has ⊆ y1_lab kr_leaf_has (suc kr_leaf_has) $
----
l1: $ G ⇒ cl_leaf_has_app ⊆ y1_lab kr_leaf_has (suc kr_leaf_has) $ by y1_k_leaf_has_app
l2: $ G ⇒ cl_leaf_has_pi ⊆ y1_lab kr_leaf_has (suc kr_leaf_has) $ by y1_k_leaf_has_pi
l3: $ G ⇒ pr_leaf_has ⊆ y1_lab kr_leaf_has (suc kr_leaf_has) $ by cun_least [l2, l1]

lemma y1_k_pinst_head (G: hyps): $ G ⇒ cl_pinst_head ⊆ y1_lab kr_pinst (suc kr_pinst) $
----
l1: $ G , x ∊ cl_pinst_head ⇒ x ∊ cl_pinst_head $ by ax
l2: $ G , x ∊ cl_pinst_head ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ kr_pinst ∈ ω $ by x1_kr_pinst
l5: $ G , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩ ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ v v ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_pinst_head ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_pinst_head ⊆ y1_lab kr_pinst (suc kr_pinst) $ by subset_intro [l12]

lemma y1_k_pinst_head_c (G: hyps): $ G ⇒ cl_pinst_head_c ⊆ y1_lab kr_pinst (suc kr_pinst) $
----
l1: $ G , x ∊ cl_pinst_head_c ⇒ x ∊ cl_pinst_head_c $ by ax
l2: $ G , x ∊ cl_pinst_head_c ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ kr_pinst ∈ ω $ by x1_kr_pinst
l5: $ G , x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩ ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by ax
l7: $ G , ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l6, l5]
l8: $ G , ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by ax
l9: $ G , ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l8, l7]
l10: $ G , ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by ax
l11: $ G , ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l10, l9]
l12: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) $ by ax
l13: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_pinst y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ w w ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l12, l11]
l14: $ G , x ∊ cl_pinst_head_c ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l2, l13]
l15: $ G ⇒ cl_pinst_head_c ⊆ y1_lab kr_pinst (suc kr_pinst) $ by subset_intro [l14]

lemma y1_k_pinst_app (G: hyps): $ G ⇒ cl_pinst_app ⊆ y1_lab kr_pinst (suc kr_pinst) $
----
l1: $ G , x ∊ cl_pinst_app ⇒ x ∊ cl_pinst_app $ by ax
l2: $ G , x ∊ cl_pinst_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ kr_pinst ∈ ω $ by x1_kr_pinst
l5: $ G , x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩ ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_pinst ⟨ kc_s , scons y ∅ ⟩ z v w) (scons (ra_inst y w u a) ∅) , ra_pinst y ⟨ kc_app , scons z (scons u ∅) ⟩ v a ⟩) ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_pinst_app ⇒ x ∊ y1_lab kr_pinst (suc kr_pinst) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_pinst_app ⊆ y1_lab kr_pinst (suc kr_pinst) $ by subset_intro [l16]

lemma y1_p_pinst (G: hyps): $ G ⇒ pr_pinst ⊆ y1_lab kr_pinst (suc kr_pinst) $
----
