l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_lift_bvar_ge ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_lift_bvar_ge ⊆ y1_lab kr_lift (suc kr_lift) $ by subset_intro [l12]

