lemma y2_cnth_e2 (GG: hyps) (q1 q2 q3 w3 u_A u_B u_G u_n v_A v_B v_G v_n: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ > $ GG ⇒ q3 = u_B $ > $ GG ⇒ ra_cnth u_G u_n u_B ∈ lrel $ > $ GG ⇒ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ > $ GG ⇒ q1 = ⟨ kc_cons , scons v_A (scons v_G ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons v_n ∅ ⟩ $ > $ GG ⇒ w3 = v_B $ > $ GG ⇒ ra_cnth v_G v_n v_B ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ = ⟨ kc_cons , scons v_A (scons v_G ∅) ⟩ $ by eq_trans [l1, #6]
l3: $ GG ⇒ kc_cons ∈ ω $ by v1_kc_cons
l4: $ GG ⇒ isset kc_cons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_A $ by isset_var
l6: $ GG ⇒ isset u_G $ by isset_var
l7: $ GG ⇒ isset v_A $ by isset_var
l8: $ GG ⇒ isset v_G $ by isset_var
l9: $ GG ⇒ u_A = v_A ∧ u_G = v_G $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_A = v_A $ by and_elim_l [l9]
l11: $ GG ⇒ u_G = v_G $ by and_elim_r [l9]
l12: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = q2 $ by eq_sym [#2]
l13: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = ⟨ kc_s , scons v_n ∅ ⟩ $ by eq_trans [l12, #7]
l14: $ GG ⇒ kc_s ∈ ω $ by v1_kc_s
l15: $ GG ⇒ isset kc_s $ by wcel_isset [l14]
l16: $ GG ⇒ isset u_n $ by isset_var
l17: $ GG ⇒ isset v_n $ by isset_var
l18: $ GG ⇒ u_n = v_n $ by y2_nd1 [l13, l15, l16, l17]
l19: $ GG ⇒ v_G = u_G $ by eq_sym [l11]
l20: $ GG ⇒ v_n = u_n $ by eq_sym [l18]
l21: $ GG ⇒ v_B = v_B $ by eq_refl
l22: $ GG ⇒ ra_cnth u_G u_n v_B ∈ lrel $ by x1_eq_cnth [#9, l19, l20, l21]
l23: $ GG ⇒ isset u_G $ by isset_var
l24: $ GG ⇒ isset u_n $ by isset_var
l25: $ GG ⇒ isset u_B $ by isset_var
l26: $ GG ⇒ isset v_B $ by isset_var
l27: $ GG ⇒ u_B = v_B $ by y2_cnth_ihc [l23, l24, l25, l26, #5, l22]
l28: $ GG ⇒ v_B = w3 $ by eq_sym [#8]
l29: $ GG ⇒ q3 = v_B $ by eq_trans [#3, l27]
l30: $ GG ⇒ q3 = w3 $ by eq_trans [l29, l28]

lemma y2_cnth_c2 (GG: hyps) (q1 q2 q3 w3 u_A u_B u_G u_n: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_B ∧ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ > $ GG ⇒ ra_cnth q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ∃ a ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ∨ ∃ a ∃ d ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) $ by lrel_cnth_cases [#2]
l2: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by ax
l3: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_B ∧ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_B ∧ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = u_B ∧ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = u_B $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_cnth u_G u_n u_B ∈ lrel $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ $ by and_elim_l [l2]
l13: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by and_elim_r [l2]
l14: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l13]
l15: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ w3 = a $ by and_elim_r [l13]
l16: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ kc_nz ∈ kc_s $ by y2_lt_nz_s
l17: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ kc_s ∈ ω $ by v1_kc_s
l18: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ isset kc_s $ by wcel_isset [l17]
l19: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ⊥ $ by y2_ne [l14, l6, l16, l18]
l20: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = w3 $ by bot_elim [l19]
l21: $ GG , ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) $ by ax
l22: $ GG , ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l21, l20]
l23: $ GG , ∃ a ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ ∃ a ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) $ by ax
l24: $ GG , ∃ a ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l23, l22]
l25: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel $ by ax
l26: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_B ∧ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by weaken [#1]
l27: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ by and_elim_l [l26]
l28: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_B ∧ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by and_elim_r [l26]
l29: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l28]
l30: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q3 = u_B ∧ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by and_elim_r [l28]
l31: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q3 = u_B $ by and_elim_l [l30]
l32: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ ra_cnth u_G u_n u_B ∈ lrel ∧ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by and_elim_r [l30]
l33: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ ra_cnth u_G u_n u_B ∈ lrel $ by and_elim_l [l32]
l34: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ ra_cnth u_G u_n u_B ∈ y2_P_cnth lrel $ by and_elim_r [l32]
l35: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ $ by and_elim_l [l25]
l36: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel $ by and_elim_r [l25]
l37: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q2 = ⟨ kc_s , scons e ∅ ⟩ $ by and_elim_l [l36]
l38: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ w3 = d ∧ ra_cnth b e d ∈ lrel $ by and_elim_r [l36]
l39: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ w3 = d $ by and_elim_l [l38]
l40: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ ra_cnth b e d ∈ lrel $ by and_elim_r [l38]
l41: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q3 = w3 $ by y2_cnth_e2 [l27, l29, l31, l33, l34, l35, l37, l39, l40]
l42: $ GG , ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) ⇒ ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) $ by ax
l43: $ GG , ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l42, l41]
l44: $ GG , ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) ⇒ ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) $ by ax
l45: $ GG , ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l44, l43]
l46: $ GG , ∃ d ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) ⇒ ∃ d ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) $ by ax
l47: $ GG , ∃ d ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l46, l45]
l48: $ GG , ∃ a ∃ d ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) ⇒ ∃ a ∃ d ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) $ by ax
l49: $ GG , ∃ a ∃ d ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l48, l47]
l50: $ GG ⇒ q3 = w3 $ by or_elim [l1, l24, l49]

lemma y2_cnth_d2 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_cnth q1 q2 q3 ⟩ ∈ cl_cnth_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_cnth lrel $ > $ GG ⇒ ra_cnth q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel ⇒ q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel $ by ax
l2: $ GG , q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel ⇒ ra_cnth q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel ⇒ q3 = w3 $ by y2_cnth_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ e (q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel → q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ ∀ b ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel → q3 = w3) $ by all_intro [l6]
l8: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e (q1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = b ∧ ra_cnth d e b ∈ lrel ∧ ra_cnth d e b ∈ y2_P_cnth lrel → q3 = w3) $ by all_intro [l7]
l9: $ GG ⇒ q3 = w3 $ by y2_cnth_i2 [#1, #2, l8]

lemma y2_cnth_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_cnth lrel → c ∊ y2_P_cnth lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ c = ra_cnth x1 x2 x3 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_cnth x1 x2 x3 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ pr_cnth $ by lprog_cnth_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_cnth lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ ra_cnth x1 x2 x6 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel , ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_z ⇒ ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_z $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel , ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_z ⇒ crn o ⊆ horn lprog ∩ y2_P_cnth lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel , ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_z ⇒ ra_cnth x1 x2 x6 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel , ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_z ⇒ x3 = x6 $ by y2_cnth_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel , ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_s ⇒ ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_s $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel , ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_s ⇒ crn o ⊆ horn lprog ∩ y2_P_cnth lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel , ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_s ⇒ ra_cnth x1 x2 x6 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel , ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_s ⇒ x3 = x6 $ by y2_cnth_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_s → x3 = x6 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_cnth x1 x2 x3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s → x3 = x6 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 , ra_cnth x1 x2 x6 ∈ lrel ⇒ x3 = x6 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 ⇒ ra_cnth x1 x2 x6 ∈ lrel → x3 = x6 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel , c = ra_cnth x1 x2 x3 ⇒ ∀ x6 (⟨ kr_cnth , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel ⇒ c = ⟨ kr_cnth , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by imp_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel ⇒ ∀ x3 (c = ⟨ kr_cnth , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_cnth , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_cnth , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_cnth lrel ⇒ c ∊ y2_P_cnth lrel $ by cab_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_cnth lrel → c ∊ y2_P_cnth lrel $ by imp_intro [l26]
l28: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_cnth lrel → c ∊ y2_P_cnth lrel $ by imp_intro [l27]
l29: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_cnth lrel → c ∊ y2_P_cnth lrel) $ by all_intro [l28]
l30: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_cnth lrel → c ∊ y2_P_cnth lrel) $ by all_intro [l29]

lemma y2_cnth_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_cnth lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_cnth lrel → c ∊ y2_P_cnth lrel) $ by y2_cnth_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_cnth lrel $ by horn_ind [l1, l2]

lrel_cnth_det
-------------
l1: $ G ⇒ horn lprog ⊆ y2_P_cnth lrel $ by y2_cnth_in
l2: $ G ⇒ ra_cnth t1 t2 u3 ∈ y2_P_cnth lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u3 = v3 $ by y2_cnth_ih [l2, #2]

--| The atoms of `capp` whose variants in `L` with the same inputs have the same outputs.
def y2_P_capp (L: class) (.c .x1 .x2 .x3 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_capp , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ L → x3 = x6))} $

lemma y2_capp_ih (GG: hyps) (q1 q2 q3 w3: set):
  $ GG ⇒ ra_capp q1 q2 q3 ∈ y2_P_capp lrel $ > $ GG ⇒ ra_capp q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ c ∊ y2_P_capp lrel $ by ax
l2: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_capp , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_capp , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons q1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ ∀ x3 (c = ⟨ kr_capp , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ c = ⟨ kr_capp , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 (⟨ kr_capp , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by all_elim [l4]
l6: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ c = ra_capp q1 q2 q3 $ by ax
l7: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ ∀ x6 (⟨ kr_capp , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ ra_capp q1 q2 w3 ∈ lrel → q3 = w3 $ by all_elim [l7]
l9: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ ra_capp q1 q2 w3 ∈ lrel $ by weaken [#2]
l10: $ GG , c = ra_capp q1 q2 q3 , c ∊ y2_P_capp lrel ⇒ q3 = w3 $ by imp_elim [l8, l9]
l11: $ GG ⇒ q3 = w3 $ by wcel_elim [#1, l10]

lemma y2_capp_ihc (GG: hyps) (Q1 Q2 Q3 W3: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset W3 $ > $ GG ⇒ ra_capp Q1 Q2 Q3 ∈ y2_P_capp lrel $ > $ GG ⇒ ra_capp Q1 Q2 W3 ∈ lrel $ > $ GG ⇒ Q3 = W3 $
----
l1: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ d = Q3 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ e = W3 $ by ax
l5: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q1 = a $ by eq_sym [l1]
l6: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q2 = b $ by eq_sym [l2]
l7: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = d $ by eq_sym [l3]
l8: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ W3 = e $ by eq_sym [l4]
l9: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ∅ = ∅ $ by eq_refl
l10: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q3 ∅ = scons d ∅ $ by scons_eq [l7, l9]
l11: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q2 (scons Q3 ∅) = scons b (scons d ∅) $ by scons_eq [l6, l10]
l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q1 (scons Q2 (scons Q3 ∅)) = scons a (scons b (scons d ∅)) $ by scons_eq [l5, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ kr_capp = kr_capp $ by eq_refl
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_capp Q1 Q2 Q3 = ra_capp a b d $ by opair_eq [l13, l12]
l15: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_capp Q1 Q2 Q3 ∈ y2_P_capp lrel $ by weaken [#5]
l16: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_capp a b d ∈ y2_P_capp lrel $ by wcel_eq_l [l14, l15]
l17: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_capp Q1 Q2 W3 ∈ lrel $ by weaken [#6]
l18: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_capp a b e ∈ lrel $ by x1_eq_capp [l17, l5, l6, l8]
l19: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ d = e $ by y2_capp_ih [l16, l18]
l20: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = e $ by eq_trans [l7, l19]
l21: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = W3 $ by eq_trans [l20, l4]
l22: $ GG , a = Q1 , b = Q2 , d = Q3 ⇒ Q3 = W3 $ by isset_elim [#4, l21]
l23: $ GG , a = Q1 , b = Q2 ⇒ Q3 = W3 $ by isset_elim [#3, l22]
l24: $ GG , a = Q1 ⇒ Q3 = W3 $ by isset_elim [#2, l23]
l25: $ GG ⇒ Q3 = W3 $ by isset_elim [#1, l24]

lemma y2_capp_i1 (GG: hyps) {G: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_capp q1 q2 q3 ⟩ ∈ cl_capp_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_capp lrel $ > $ GG ⇒ ∀ G (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = G ∧ q3 = G → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil ⇒ w ∊ cl_capp_nil $ by ax
l2: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil ⇒ ∃ G (w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ w = ⟨ o , ra_capp q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ ⟨ o , ra_capp q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ ⟨ o , ra_capp q1 q2 q3 ⟩ = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset (ra_capp q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset (ra_capp ⟨ kc_nil , ∅ ⟩ G G) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ o = ∅ ∧ ra_capp q1 q2 q3 = ra_capp ⟨ kc_nil , ∅ ⟩ G G $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ ⟨ kr_capp , scons q1 (scons q2 (scons q3 ∅)) ⟩ = ⟨ kr_capp , scons ⟨ kc_nil , ∅ ⟩ (scons G (scons G ∅)) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ kr_capp ∈ ω $ by x1_kr_capp
l15: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset kr_capp $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset q3 $ by isset_var
l19: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l20: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset G $ by isset_var
l21: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ isset G $ by isset_var
l22: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = G ∧ q3 = G $ by y2_nd3 [l13, l15, l16, l17, l18, l19, l20, l21]
l23: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l22]
l24: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ q2 = G ∧ q3 = G $ by and_elim_r [l22]
l25: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ q2 = G $ by and_elim_l [l24]
l26: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ q3 = G $ by and_elim_r [l24]
l27: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ q2 = G ∧ q3 = G $ by and_intro [l25, l26]
l28: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = G ∧ q3 = G $ by and_intro [l23, l27]
l29: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ ∀ G (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = G ∧ q3 = G → ph) $ by weaken [#3]
l30: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = G ∧ q3 = G → ph $ by all_elim [l29]
l31: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil , w = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ G G ⟩ ⇒ ph $ by imp_elim [l30, l28]
l32: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_nil ⇒ ph $ by ex_elim [l2, l31]
l33: $ GG ⇒ ph $ by wcel_elim [#1, l32]

lemma y2_capp_e1 (GG: hyps) (q1 q2 q3 w3 u_G v_G: set):
  $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ q2 = u_G $ > $ GG ⇒ q3 = u_G $ > $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ q2 = v_G $ > $ GG ⇒ w3 = v_G $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_nil , ∅ ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_nil , ∅ ⟩ $ by eq_trans [l1, #4]
l3: $ GG ⇒ u_G = q2 $ by eq_sym [#2]
l4: $ GG ⇒ u_G = v_G $ by eq_trans [l3, #5]
l5: $ GG ⇒ v_G = w3 $ by eq_sym [#6]
l6: $ GG ⇒ q3 = v_G $ by eq_trans [#3, l4]
l7: $ GG ⇒ q3 = w3 $ by eq_trans [l6, l5]

lemma y2_capp_c1 (GG: hyps) (q1 q2 q3 w3 u_G: set):
  $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = u_G ∧ q3 = u_G $ > $ GG ⇒ ra_capp q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ∨ ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by lrel_capp_cases [#2]
l2: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a $ by ax
l3: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = u_G ∧ q3 = u_G $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = u_G ∧ q3 = u_G $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = u_G $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = u_G $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l2]
l9: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = a ∧ w3 = a $ by and_elim_r [l2]
l10: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = a $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ w3 = a $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = w3 $ by y2_capp_e1 [l4, l6, l7, l8, l10, l11]
l13: $ GG , ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ⇒ ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) $ by ax
l14: $ GG , ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l13, l12]
l15: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel $ by ax
l16: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = u_G ∧ q3 = u_G $ by weaken [#1]
l17: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l16]
l18: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q2 = u_G ∧ q3 = u_G $ by and_elim_r [l16]
l19: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q2 = u_G $ by and_elim_l [l18]
l20: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q3 = u_G $ by and_elim_r [l18]
l21: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ $ by and_elim_l [l15]
l22: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel $ by and_elim_r [l15]
l23: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q2 = a $ by and_elim_l [l22]
l24: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel $ by and_elim_r [l22]
l25: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ $ by and_elim_l [l24]
l26: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ ra_capp d a e ∈ lrel $ by and_elim_r [l24]
l27: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ kc_nil ∈ kc_cons $ by y2_lt_nil_cons
l28: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ kc_cons ∈ ω $ by v1_kc_cons
l29: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ isset kc_cons $ by wcel_isset [l28]
l30: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ ⊥ $ by y2_ne [l17, l21, l27, l29]
l31: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel ⇒ q3 = w3 $ by bot_elim [l30]
l32: $ GG , ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by ax
l33: $ GG , ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l32, l31]
l34: $ GG , ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by ax
l35: $ GG , ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l34, l33]
l36: $ GG , ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by ax
l37: $ GG , ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l36, l35]
l38: $ GG , ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) $ by ax
l39: $ GG , ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = a ∧ w3 = ⟨ kc_cons , scons b (scons e ∅) ⟩ ∧ ra_capp d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l38, l37]
l40: $ GG ⇒ q3 = w3 $ by or_elim [l1, l14, l39]

lemma y2_capp_d1 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_capp q1 q2 q3 ⟩ ∈ cl_capp_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_capp lrel $ > $ GG ⇒ ra_capp q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a $ by ax
l2: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a ⇒ ra_capp q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a ⇒ q3 = w3 $ by y2_capp_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ q3 = w3 $ by y2_capp_i1 [#1, #2, l5]

lemma y2_capp_i2 (GG: hyps) {A P G G2: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_capp q1 q2 q3 ⟩ ∈ cl_capp_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_capp lrel $ > $ GG ⇒ ∀ A ∀ P ∀ G ∀ G2 (q1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ q2 = G ∧ q3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G G2 ∈ lrel ∧ ra_capp P G G2 ∈ y2_P_capp lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_cons ⇒ w ∊ cl_capp_cons $ by ax
l2: $ GG , w = ⟨ o , ra_capp q1 q2 q3 ⟩ , w ∊ cl_capp_cons ⇒ ∃ A ∃ P ∃ G ∃ G2 (w = ⟨ scons (ra_capp P G G2) ∅ , ra_capp ⟨ kc_cons , scons A (scons P ∅) ⟩ G ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ⟩) $ by cab_elim [l1]
