lemma y2_nth_ty_e1 (GG: hyps) (q1 q2 q3 q4 w3 w4 u_F u_C u_T v_F v_C v_T: set):
  $ GG ⇒ q1 = ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q3 = u_F $ > $ GG ⇒ q4 = u_C $ > $ GG ⇒ q1 = ⟨ kc_tcons , scons v_F (scons v_C (scons v_T ∅)) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ w3 = v_F $ > $ GG ⇒ w4 = v_C $ > $ GG ⇒ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ = ⟨ kc_tcons , scons v_F (scons v_C (scons v_T ∅)) ⟩ $ by eq_trans [l1, #5]
l3: $ GG ⇒ kc_tcons ∈ ω $ by v1_kc_tcons
l4: $ GG ⇒ isset kc_tcons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_F $ by isset_var
l6: $ GG ⇒ isset u_C $ by isset_var
l7: $ GG ⇒ isset u_T $ by isset_var
l8: $ GG ⇒ isset v_F $ by isset_var
l9: $ GG ⇒ isset v_C $ by isset_var
l10: $ GG ⇒ isset v_T $ by isset_var
l11: $ GG ⇒ u_F = v_F ∧ u_C = v_C ∧ u_T = v_T $ by y2_nd3 [l2, l4, l5, l6, l7, l8, l9, l10]
l12: $ GG ⇒ u_F = v_F $ by and_elim_l [l11]
l13: $ GG ⇒ u_C = v_C ∧ u_T = v_T $ by and_elim_r [l11]
l14: $ GG ⇒ u_C = v_C $ by and_elim_l [l13]
l15: $ GG ⇒ u_T = v_T $ by and_elim_r [l13]
l16: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = q2 $ by eq_sym [#2]
l17: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [l16, #6]
l18: $ GG ⇒ v_F = w3 $ by eq_sym [#7]
l19: $ GG ⇒ q3 = v_F $ by eq_trans [#3, l12]
l20: $ GG ⇒ q3 = w3 $ by eq_trans [l19, l18]
l21: $ GG ⇒ v_C = w4 $ by eq_sym [#8]
l22: $ GG ⇒ q4 = v_C $ by eq_trans [#4, l14]
l23: $ GG ⇒ q4 = w4 $ by eq_trans [l22, l21]
l24: $ GG ⇒ q3 = w3 ∧ q4 = w4 $ by and_intro [l20, l23]

lemma y2_nth_ty_c1 (GG: hyps) (q1 q2 q3 q4 w3 w4 u_F u_C u_T: set):
  $ GG ⇒ q1 = ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_F ∧ q4 = u_C $ > $ GG ⇒ ra_nth_ty q1 q2 w3 w4 ∈ lrel $ > $ GG ⇒ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) ∨ ∃ a ∃ e ∃ b ∃ f ∃ d ∃ g (q1 = ⟨ kc_tcons , scons e (scons f (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons g ∅ ⟩ ∧ w3 = a ∧ w4 = b ∧ ra_nth_ty d g a b ∈ lrel) $ by lrel_nth_ty_cases [#2]
l2: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b $ by ax
l3: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q1 = ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_F ∧ q4 = u_C $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q1 = ⟨ kc_tcons , scons u_F (scons u_C (scons u_T ∅)) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_F ∧ q4 = u_C $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q3 = u_F ∧ q4 = u_C $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q3 = u_F $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q4 = u_C $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ $ by and_elim_l [l2]
l11: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b $ by and_elim_r [l2]
l12: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l11]
l13: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ w3 = a ∧ w4 = b $ by and_elim_r [l11]
l14: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ w3 = a $ by and_elim_l [l13]
l15: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ w4 = b $ by and_elim_r [l13]
l16: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q3 = w3 ∧ q4 = w4 $ by y2_nth_ty_e1 [l4, l6, l8, l9, l10, l12, l14, l15]
l17: $ GG , ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) ⇒ ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) $ by ax
l18: $ GG , ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) ⇒ q3 = w3 ∧ q4 = w4 $ by ex_elim [l17, l16]
l19: $ GG , ∃ b ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) ⇒ ∃ b ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) $ by ax
