l103: $ G ⇒ ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = V1 ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons V1 (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of V1 N j_v X ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons V2 (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons V2 (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons V2 (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $ by ex_intro [l102]
l104: $ G ⇒ ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = V1 ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons V1 (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of V1 N j_v X ∈ lrel ∧ ra_ind_arity V1 np n_v m_v ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $ by ex_intro [l103]
l105: $ G ⇒ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $ by ex_intro [l104]

lemma y1_d_rst_ctor (G: hyps) {D I N j_v c_v i_v np n_v m_v na k_v npi e_v S X X1 X2 Y e2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ ∈ cl_rst_ctor $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_ctor ⇒ x ∊ cl_rst_ctor $ by ax
l2: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x ∊ cl_rst_ctor ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩ ⇒ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $ by y1_e_rst_ctor [l6, l7]
l9: $ G , x = ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ , ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) ⇒ ∃ n (x = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons y (scons v (scons w ∅)) ⟩ k g) (scons (ra_aux_of y u v e) (scons (ra_ind_arity y b c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b e h) (scons (ra_add b i g) (scons (ra_spine d k i) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ d h l) (scons (ra_spine ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ l j) (scons (ra_rehead ⟨ kc_ind_ty , scons z (scons a ∅) ⟩ ⟨ kc_ind_ctor , scons z (scons a (scons w ∅)) ⟩ j l m) (scons (ra_rehead d m i k n) ∅))))))))) , ra_rst y u k n ⟩) $ by ax
