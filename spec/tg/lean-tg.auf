lemma y1_k_lift_closed (G: hyps): $ G ⇒ cl_lift_closed ⊆ y1_lab kr_lift (suc kr_lift) $
----
l1: $ G , x ∊ cl_lift_closed ⇒ x ∊ cl_lift_closed $ by ax
l2: $ G , x ∊ cl_lift_closed ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩ ⇒ x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩ ⇒ kr_lift ∈ ω $ by x1_kr_lift
l5: $ G , x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩ ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) ⇒ ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed z v) (scons (ra_le z u) ∅) , ra_lift y u v v ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_lift_closed ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_lift_closed ⊆ y1_lab kr_lift (suc kr_lift) $ by subset_intro [l12]

