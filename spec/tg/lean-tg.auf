l17: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_elim [l19, l18]
