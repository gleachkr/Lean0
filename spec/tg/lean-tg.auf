l6: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V8) (scons (ra_ntys V4 V9 V10) (scons (ra_motives V1 V8 V5 ⟨ kc_nz , ∅ ⟩ V4 V15) (scons (ra_minors V1 V8 V9 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V16) (scons (ra_nth_ty V4 V6 V17 V24) (scons (ra_nth_ctor V24 V7 V18) (scons (ra_minor_idx V4 V6 V7 V11) (scons (ra_npis V18 V12) (scons (ra_add V12 V10 V13) (scons (ra_add V14 ⟨ kc_s , scons V11 ∅ ⟩ V13) (scons (ra_pargs ⟨ kc_bvar , scons V14 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V12 V19) (scons (ra_rwalk V1 V8 V9 V10 V5 V12 ⟨ kc_nz , ∅ ⟩ V19 V18 V20) (scons (ra_lams V16 V20 V21) (scons (ra_lams V15 V21 V22) (scons (ra_lams V3 V22 V23) ∅))))))))))))))) ∧ ra_rec_rhs t1 t2 t3 t4 t5 = ra_rec_rhs V1 V5 V6 V7 V23 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V8) (scons (ra_ntys V4 V9 V10) (scons (ra_motives V1 V8 V5 ⟨ kc_nz , ∅ ⟩ V4 V15) (scons (ra_minors V1 V8 V9 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V16) (scons (ra_nth_ty V4 V6 V17 V24) (scons (ra_nth_ctor V24 V7 V18) (scons (ra_minor_idx V4 V6 V7 V11) (scons (ra_npis V18 V12) (scons (ra_add V12 V10 V13) (scons (ra_add V14 ⟨ kc_s , scons V11 ∅ ⟩ V13) (scons (ra_pargs ⟨ kc_bvar , scons V14 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V12 V19) (scons (ra_rwalk V1 V8 V9 V10 V5 V12 ⟨ kc_nz , ∅ ⟩ V19 V18 V20) (scons (ra_lams V16 V20 V21) (scons (ra_lams V15 V21 V22) (scons (ra_lams V3 V22 V23) ∅))))))))))))))) $ by and_elim_l [l6]
