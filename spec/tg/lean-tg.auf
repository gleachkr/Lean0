l12: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l22: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x ∊ cl_rwalk_res ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l2, l22]
l24: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by wcel_elim [#1, l23]

lemma y1_o_rwalk (G: hyps) {D np n_v m_v v_v nf d_v dp mn Acc A A3 B Val j_v sh fld A2 A4 IH K: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10: set):
  $ G ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ pr_rwalk $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res $ by ax
l2: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by y1_d_rwalk_res [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res → ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res $ by ax
l6: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∨ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec $ by ax
l8: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) $ by y1_d_rwalk_pi_rec [l7, l8]
l10: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res $ by ax
l12: $ G , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec ∪ cl_rwalk_res , ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_res → ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by weaken [l4]
