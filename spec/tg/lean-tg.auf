l12: $ G ⇒ isset t6 $ by isset_var
l13: $ G ⇒ scons t6 (scons t7 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t5 $ by isset_var
l15: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t4 $ by isset_var
l17: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t3 $ by isset_var
l19: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t2 $ by isset_var
l21: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset t1 $ by isset_var
l23: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l24, l9]
l26: $ G ⇒ isset ⟨ kc_tnil , ∅ ⟩ $ by opair_isset
l27: $ G ⇒ scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V5 $ by isset_var
l29: $ G ⇒ scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V4 $ by isset_var
l31: $ G ⇒ scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V3 $ by isset_var
l33: $ G ⇒ scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ isset V2 $ by isset_var
l35: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) ∈ fseq y1_vv $ by y1_fs [l34, l33]
l36: $ G ⇒ isset V1 $ by isset_var
l37: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))))) ∈ fseq y1_vv $ by y1_fs [l36, l35]
l38: $ G ⇒ kr_minors ∈ ω $ by x1_kr_minors
l39: $ G ⇒ isset kr_minors $ by wcel_isset [l38]
l40: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l23]
l41: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))))) $ by wcel_isset [l37]
l42: $ G ⇒ kr_minors = kr_minors ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))))) $ by opair_inj_c [l8, l39, l40, l39, l41]
l43: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))))) $ by and_elim_r [l42]
l44: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) $ by y1_scons_inj [l43, l22, l36, l21, l35]
l45: $ G ⇒ t1 = V1 $ by and_elim_l [l44]
l46: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) $ by and_elim_r [l44]
l47: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) $ by y1_scons_inj [l46, l20, l34, l19, l33]
l48: $ G ⇒ t2 = V2 $ by and_elim_l [l47]
l49: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) $ by and_elim_r [l47]
l50: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by y1_scons_inj [l49, l18, l32, l17, l31]
l51: $ G ⇒ t3 = V3 $ by and_elim_l [l50]
l52: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by and_elim_r [l50]
l53: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by y1_scons_inj [l52, l16, l30, l15, l29]
l54: $ G ⇒ t4 = V4 $ by and_elim_l [l53]
l55: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by and_elim_r [l53]
l56: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by y1_scons_inj [l55, l14, l28, l13, l27]
l57: $ G ⇒ t5 = V5 $ by and_elim_l [l56]
l58: $ G ⇒ scons t6 (scons t7 ∅) = scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by and_elim_r [l56]
l59: $ G ⇒ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ scons t7 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by y1_scons_inj [l58, l12, l26, l11, l25]
l60: $ G ⇒ t6 = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l59]
l61: $ G ⇒ scons t7 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by and_elim_r [l59]
l62: $ G ⇒ t7 = ⟨ kc_nil , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l61, l10, l24, l9, l9]
l63: $ G ⇒ t7 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l62]
l64: $ G ⇒ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l60, l63]
l65: $ G ⇒ t5 = V5 ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l57, l64]
l66: $ G ⇒ t4 = V4 ∧ t5 = V5 ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l54, l65]
l67: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l51, l66]
l68: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l48, l67]
l69: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l45, l68]
l70: $ G ⇒ ∃ i_v (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l69]
l71: $ G ⇒ ∃ k_v ∃ i_v (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l70]
l72: $ G ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = V1 ∧ t2 = V2 ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l71]
l73: $ G ⇒ ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l72]
l74: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l73]

lemma y1_d_minors_nil (G: hyps) {D np n_v k_v i_v: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_minors_nil ⇒ x ∊ cl_minors_nil $ by ax
l2: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_minors_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by y1_e_minors_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_minors_nil ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l17]

lemma y1_e_minors_cons (G: hyps) {D np n_v k_v i_v nc k2 F C T M1 M2 M: set} (pp t1 t2 t3 t4 t5 t6 t7 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13: set):
  $ G ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_cminors V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V9 V11) (scons (ra_clen_c V9 V6) (scons (ra_add V4 V6 V7) (scons (ra_minors V1 V2 V3 V7 ⟨ kc_s , scons V5 ∅ ⟩ V10 V12) (scons (ra_capp V12 V11 V13) ∅)))) , ra_minors V1 V2 V3 V4 V5 ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ V13 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_cminors V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V9 V11) (scons (ra_clen_c V9 V6) (scons (ra_add V4 V6 V7) (scons (ra_minors V1 V2 V3 V7 ⟨ kc_s , scons V5 ∅ ⟩ V10 V12) (scons (ra_capp V12 V11 V13) ∅)))) , ra_minors V1 V2 V3 V4 V5 ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ V13 ⟩ = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_cminors V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V9 V11) (scons (ra_clen_c V9 V6) (scons (ra_add V4 V6 V7) (scons (ra_minors V1 V2 V3 V7 ⟨ kc_s , scons V5 ∅ ⟩ V10 V12) (scons (ra_capp V12 V11 V13) ∅))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_minors t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l5: $ G ⇒ isset (ra_minors V1 V2 V3 V4 V5 ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ V13) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_cminors V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V9 V11) (scons (ra_clen_c V9 V6) (scons (ra_add V4 V6 V7) (scons (ra_minors V1 V2 V3 V7 ⟨ kc_s , scons V5 ∅ ⟩ V10 V12) (scons (ra_capp V12 V11 V13) ∅)))) ∧ ra_minors t1 t2 t3 t4 t5 t6 t7 = ra_minors V1 V2 V3 V4 V5 ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ V13 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_cminors V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V9 V11) (scons (ra_clen_c V9 V6) (scons (ra_add V4 V6 V7) (scons (ra_minors V1 V2 V3 V7 ⟨ kc_s , scons V5 ∅ ⟩ V10 V12) (scons (ra_capp V12 V11 V13) ∅)))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_minors t1 t2 t3 t4 t5 t6 t7 = ra_minors V1 V2 V3 V4 V5 ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ V13 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t7 $ by isset_var
l11: $ G ⇒ scons t7 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t6 $ by isset_var
l13: $ G ⇒ scons t6 (scons t7 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t5 $ by isset_var
l15: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t4 $ by isset_var
l17: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t3 $ by isset_var
l19: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t2 $ by isset_var
l21: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset t1 $ by isset_var
l23: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V13 $ by isset_var
l25: $ G ⇒ scons V13 ∅ ∈ fseq y1_vv $ by y1_fs [l24, l9]
l26: $ G ⇒ isset ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ $ by opair_isset
l27: $ G ⇒ scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V5 $ by isset_var
l29: $ G ⇒ scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V4 $ by isset_var
l31: $ G ⇒ scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V3 $ by isset_var
l33: $ G ⇒ scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ isset V2 $ by isset_var
l35: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅))))) ∈ fseq y1_vv $ by y1_fs [l34, l33]
l36: $ G ⇒ isset V1 $ by isset_var
l37: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)))))) ∈ fseq y1_vv $ by y1_fs [l36, l35]
l38: $ G ⇒ kr_minors ∈ ω $ by x1_kr_minors
l39: $ G ⇒ isset kr_minors $ by wcel_isset [l38]
l40: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l23]
l41: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅))))))) $ by wcel_isset [l37]
l42: $ G ⇒ kr_minors = kr_minors ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)))))) $ by opair_inj_c [l8, l39, l40, l39, l41]
l43: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)))))) $ by and_elim_r [l42]
l44: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅))))) $ by y1_scons_inj [l43, l22, l36, l21, l35]
l45: $ G ⇒ t1 = V1 $ by and_elim_l [l44]
l46: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅))))) $ by and_elim_r [l44]
l47: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)))) $ by y1_scons_inj [l46, l20, l34, l19, l33]
l48: $ G ⇒ t2 = V2 $ by and_elim_l [l47]
l49: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)))) $ by and_elim_r [l47]
l50: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅))) $ by y1_scons_inj [l49, l18, l32, l17, l31]
l51: $ G ⇒ t3 = V3 $ by and_elim_l [l50]
l52: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅))) $ by and_elim_r [l50]
l53: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)) $ by y1_scons_inj [l52, l16, l30, l15, l29]
l54: $ G ⇒ t4 = V4 $ by and_elim_l [l53]
l55: $ G ⇒ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅)) $ by and_elim_r [l53]
l56: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅) $ by y1_scons_inj [l55, l14, l28, l13, l27]
l57: $ G ⇒ t5 = V5 $ by and_elim_l [l56]
l58: $ G ⇒ scons t6 (scons t7 ∅) = scons ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ (scons V13 ∅) $ by and_elim_r [l56]
l59: $ G ⇒ t6 = ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ ∧ scons t7 ∅ = scons V13 ∅ $ by y1_scons_inj [l58, l12, l26, l11, l25]
l60: $ G ⇒ t6 = ⟨ kc_tcons , scons V8 (scons V9 (scons V10 ∅)) ⟩ $ by and_elim_l [l59]
l61: $ G ⇒ scons t7 ∅ = scons V13 ∅ $ by and_elim_r [l59]
l62: $ G ⇒ t7 = V13 ∧ ∅ = ∅ $ by y1_scons_inj [l61, l10, l24, l9, l9]
l63: $ G ⇒ t7 = V13 $ by and_elim_l [l62]
l64: $ G ⇒ crn pp = crn (scons (ra_cminors V1 V2 V3 V4 V5 ⟨ kc_nz , ∅ ⟩ V9 V11) (scons (ra_clen_c V9 V6) (scons (ra_add V4 V6 V7) (scons (ra_minors V1 V2 V3 V7 ⟨ kc_s , scons V5 ∅ ⟩ V10 V12) (scons (ra_capp V12 V11 V13) ∅))))) $ by crn_eq [l7]
