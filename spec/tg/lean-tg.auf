l180: $ G ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ j_v ∃ a_v ∃ sh ∃ fld ∃ mo ∃ Ihs ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Min (t1 = V1 ∧ t2 = V2 ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v V2 dp ∈ lrel ∧ ra_recfield V1 n_v V2 d_v A j_v ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A2 A3 ∈ lrel ∧ ra_add r_v nf a_v ∈ lrel ∧ ra_add sh d_v a_v ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_add a_v k_v mo ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihty V1 V2 n_v mo fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_mwalk V1 V2 n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_s , scons r_v ∅ ⟩ ⟨ kc_cons , scons IH (scons Ihs ∅) ⟩ B Min ∈ lrel) $ by ex_intro [l179]
l181: $ G ⇒ ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ j_v ∃ a_v ∃ sh ∃ fld ∃ mo ∃ Ihs ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Min (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield V1 n_v np d_v A j_v ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A2 A3 ∈ lrel ∧ ra_add r_v nf a_v ∈ lrel ∧ ra_add sh d_v a_v ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_add a_v k_v mo ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihty V1 np n_v mo fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_mwalk V1 np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_s , scons r_v ∅ ⟩ ⟨ kc_cons , scons IH (scons Ihs ∅) ⟩ B Min ∈ lrel) $ by ex_intro [l180]
l182: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ j_v ∃ a_v ∃ sh ∃ fld ∃ mo ∃ Ihs ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A2 A3 ∈ lrel ∧ ra_add r_v nf a_v ∈ lrel ∧ ra_add sh d_v a_v ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_add a_v k_v mo ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihty D np n_v mo fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_s , scons r_v ∅ ⟩ ⟨ kc_cons , scons IH (scons Ihs ∅) ⟩ B Min ∈ lrel) $ by ex_intro [l181]

lemma y1_d_mwalk_pi_rec (G: hyps) {D np n_v k_v i_v c_v nf d_v r_v dp kn j_v a_v sh fld mo Ihs A A2 A3 A4 B IH Min: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12: set):
  $ G ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ ∈ cl_mwalk_pi_rec $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ j_v ∃ a_v ∃ sh ∃ fld ∃ mo ∃ Ihs ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A2 A3 ∈ lrel ∧ ra_add r_v nf a_v ∈ lrel ∧ ra_add sh d_v a_v ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_add a_v k_v mo ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihty D np n_v mo fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_s , scons r_v ∅ ⟩ ⟨ kc_cons , scons IH (scons Ihs ∅) ⟩ B Min ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x ∊ cl_mwalk_pi_rec ⇒ x ∊ cl_mwalk_pi_rec $ by ax
l2: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x ∊ cl_mwalk_pi_rec ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p ∃ q ∃ r ∃ t (x = ⟨ scons (ra_add c z g) (scons (ra_recfield y u z c m j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u g m n) (scons (ra_add v u i) (scons (ra_lift i c n o) (scons (ra_add f b k) (scons (ra_add d c k) (scons (ra_add e ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d) (scons (ra_add k v h) (scons (ra_lift d ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_ihty y z u h e ⟨ kc_nz , ∅ ⟩ j p r) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_s , scons f ∅ ⟩ ⟨ kc_cons , scons r (scons l ∅) ⟩ q t) ∅))))))))))) , ra_mwalk y z u v w a b c f l ⟨ kc_pi , scons m (scons q ∅) ⟩ ⟨ kc_pi , scons o (scons t ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add c z g) (scons (ra_recfield y u z c m j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u g m n) (scons (ra_add v u i) (scons (ra_lift i c n o) (scons (ra_add f b k) (scons (ra_add d c k) (scons (ra_add e ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d) (scons (ra_add k v h) (scons (ra_lift d ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_ihty y z u h e ⟨ kc_nz , ∅ ⟩ j p r) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_s , scons f ∅ ⟩ ⟨ kc_cons , scons r (scons l ∅) ⟩ q t) ∅))))))))))) , ra_mwalk y z u v w a b c f l ⟨ kc_pi , scons m (scons q ∅) ⟩ ⟨ kc_pi , scons o (scons t ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add c z g) (scons (ra_recfield y u z c m j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u g m n) (scons (ra_add v u i) (scons (ra_lift i c n o) (scons (ra_add f b k) (scons (ra_add d c k) (scons (ra_add e ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d) (scons (ra_add k v h) (scons (ra_lift d ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_ihty y z u h e ⟨ kc_nz , ∅ ⟩ j p r) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_s , scons f ∅ ⟩ ⟨ kc_cons , scons r (scons l ∅) ⟩ q t) ∅))))))))))) , ra_mwalk y z u v w a b c f l ⟨ kc_pi , scons m (scons q ∅) ⟩ ⟨ kc_pi , scons o (scons t ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add c z g) (scons (ra_recfield y u z c m j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u g m n) (scons (ra_add v u i) (scons (ra_lift i c n o) (scons (ra_add f b k) (scons (ra_add d c k) (scons (ra_add e ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d) (scons (ra_add k v h) (scons (ra_lift d ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_ihty y z u h e ⟨ kc_nz , ∅ ⟩ j p r) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_s , scons f ∅ ⟩ ⟨ kc_cons , scons r (scons l ∅) ⟩ q t) ∅))))))))))) , ra_mwalk y z u v w a b c f l ⟨ kc_pi , scons m (scons q ∅) ⟩ ⟨ kc_pi , scons o (scons t ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add c z g) (scons (ra_recfield y u z c m j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u g m n) (scons (ra_add v u i) (scons (ra_lift i c n o) (scons (ra_add f b k) (scons (ra_add d c k) (scons (ra_add e ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d) (scons (ra_add k v h) (scons (ra_lift d ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_ihty y z u h e ⟨ kc_nz , ∅ ⟩ j p r) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_s , scons f ∅ ⟩ ⟨ kc_cons , scons r (scons l ∅) ⟩ q t) ∅))))))))))) , ra_mwalk y z u v w a b c f l ⟨ kc_pi , scons m (scons q ∅) ⟩ ⟨ kc_pi , scons o (scons t ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add c z g) (scons (ra_recfield y u z c m j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u g m n) (scons (ra_add v u i) (scons (ra_lift i c n o) (scons (ra_add f b k) (scons (ra_add d c k) (scons (ra_add e ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d) (scons (ra_add k v h) (scons (ra_lift d ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_ihty y z u h e ⟨ kc_nz , ∅ ⟩ j p r) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_s , scons f ∅ ⟩ ⟨ kc_cons , scons r (scons l ∅) ⟩ q t) ∅))))))))))) , ra_mwalk y z u v w a b c f l ⟨ kc_pi , scons m (scons q ∅) ⟩ ⟨ kc_pi , scons o (scons t ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ = ⟨ scons (ra_add c z g) (scons (ra_recfield y u z c m j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u g m n) (scons (ra_add v u i) (scons (ra_lift i c n o) (scons (ra_add f b k) (scons (ra_add d c k) (scons (ra_add e ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d) (scons (ra_add k v h) (scons (ra_lift d ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_ihty y z u h e ⟨ kc_nz , ∅ ⟩ j p r) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_s , scons f ∅ ⟩ ⟨ kc_cons , scons r (scons l ∅) ⟩ q t) ∅))))))))))) , ra_mwalk y z u v w a b c f l ⟨ kc_pi , scons m (scons q ∅) ⟩ ⟨ kc_pi , scons o (scons t ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ , x = ⟨ scons (ra_add c z g) (scons (ra_recfield y u z c m j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u g m n) (scons (ra_add v u i) (scons (ra_lift i c n o) (scons (ra_add f b k) (scons (ra_add d c k) (scons (ra_add e ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d) (scons (ra_add k v h) (scons (ra_lift d ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_ihty y z u h e ⟨ kc_nz , ∅ ⟩ j p r) (scons (ra_mwalk y z u v w a b ⟨ kc_s , scons c ∅ ⟩ ⟨ kc_s , scons f ∅ ⟩ ⟨ kc_cons , scons r (scons l ∅) ⟩ q t) ∅))))))))))) , ra_mwalk y z u v w a b c f l ⟨ kc_pi , scons m (scons q ∅) ⟩ ⟨ kc_pi , scons o (scons t ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
