l43: $ GG , w = ⟨ o , ra_ind_data q1 q2 q3 q4 ⟩ , w ∊ cl_ind_data_i ⇒ ph $ by ex_elim [l2, l42]
l44: $ GG ⇒ ph $ by wcel_elim [#1, l43]

lemma y2_ind_data_e1 (GG: hyps) (q1 q2 q3 q4 w2 w3 w4 u_b u_P u_T v_b v_P v_T: set):
  $ GG ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ $ > $ GG ⇒ q2 = u_b $ > $ GG ⇒ q3 = u_P $ > $ GG ⇒ q4 = u_T $ > $ GG ⇒ q1 = ⟨ kc_ind_mk , scons v_b (scons v_P (scons v_T ∅)) ⟩ $ > $ GG ⇒ w2 = v_b $ > $ GG ⇒ w3 = v_P $ > $ GG ⇒ w4 = v_T $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ = ⟨ kc_ind_mk , scons v_b (scons v_P (scons v_T ∅)) ⟩ $ by eq_trans [l1, #5]
l3: $ GG ⇒ kc_ind_mk ∈ ω $ by v1_kc_ind_mk
l4: $ GG ⇒ isset kc_ind_mk $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_b $ by isset_var
l6: $ GG ⇒ isset u_P $ by isset_var
l7: $ GG ⇒ isset u_T $ by isset_var
l8: $ GG ⇒ isset v_b $ by isset_var
l9: $ GG ⇒ isset v_P $ by isset_var
l10: $ GG ⇒ isset v_T $ by isset_var
l11: $ GG ⇒ u_b = v_b ∧ u_P = v_P ∧ u_T = v_T $ by y2_nd3 [l2, l4, l5, l6, l7, l8, l9, l10]
l12: $ GG ⇒ u_b = v_b $ by and_elim_l [l11]
l13: $ GG ⇒ u_P = v_P ∧ u_T = v_T $ by and_elim_r [l11]
l14: $ GG ⇒ u_P = v_P $ by and_elim_l [l13]
l15: $ GG ⇒ u_T = v_T $ by and_elim_r [l13]
l16: $ GG ⇒ v_b = w2 $ by eq_sym [#6]
l17: $ GG ⇒ q2 = v_b $ by eq_trans [#2, l12]
l18: $ GG ⇒ q2 = w2 $ by eq_trans [l17, l16]
l19: $ GG ⇒ v_P = w3 $ by eq_sym [#7]
l20: $ GG ⇒ q3 = v_P $ by eq_trans [#3, l14]
l21: $ GG ⇒ q3 = w3 $ by eq_trans [l20, l19]
l22: $ GG ⇒ v_T = w4 $ by eq_sym [#8]
l23: $ GG ⇒ q4 = v_T $ by eq_trans [#4, l15]
l24: $ GG ⇒ q4 = w4 $ by eq_trans [l23, l22]
l25: $ GG ⇒ q3 = w3 ∧ q4 = w4 $ by and_intro [l21, l24]
l26: $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by and_intro [l18, l25]

lemma y2_ind_data_c1 (GG: hyps) (q1 q2 q3 q4 w2 w3 w4 u_b u_P u_T: set):
  $ GG ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ ∧ q2 = u_b ∧ q3 = u_P ∧ q4 = u_T $ > $ GG ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ∨ ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by lrel_ind_data_cases [#2]
