l43: $ GG , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l44: $ GG , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l43, l42]
l45: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l46: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by weaken [l25]
l47: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by weaken [l44]
l48: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by or_elim [l45, l46, l47]
l49: $ GG ⇒ q2 = w2 $ by or_elim [l1, l10, l48]

lemma y2_npis_d1 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_npis q1 q2 ⟩ ∈ cl_npis_bvar $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ > $ GG ⇒ ra_npis q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by y2_npis_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → q2 = w2) $ by all_intro [l4]
l6: $ GG ⇒ q2 = w2 $ by y2_npis_i1 [#1, #2, l5]

lemma y2_npis_i2 (GG: hyps) {f a: set} (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_npis q1 q2 ⟩ ∈ cl_npis_app $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ > $ GG ⇒ ∀ f ∀ a (q1 = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app ⇒ w ∊ cl_npis_app $ by ax
l2: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app ⇒ ∃ f ∃ a (w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_npis q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_npis q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_npis q1 q2 ⟩ = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_npis q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ ∧ ra_npis q1 q2 = ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ kr_npis , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_npis , scons ⟨ kc_app , scons f (scons a ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_npis ∈ ω $ by x1_kr_npis
l15: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset kr_npis $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_app , scons f (scons a ∅) ⟩ $ by opair_isset
l19: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l20: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by y2_nd2 [l13, l15, l16, l17, l18, l19]
l21: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_app , scons f (scons a ∅) ⟩ $ by and_elim_l [l20]
l22: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l20]
l23: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l21, l22]
l24: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∀ f ∀ a (q1 = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph) $ by weaken [#3]
l25: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∀ a (q1 = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph) $ by all_elim [l24]
l26: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph $ by all_elim [l25]
l27: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ph $ by imp_elim [l26, l23]
l28: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , ∃ a (w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) ⇒ ∃ a (w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by ax
l29: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app , ∃ a (w = ⟨ ∅ , ra_npis ⟨ kc_app , scons f (scons a ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) ⇒ ph $ by ex_elim [l28, l27]
l30: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_app ⇒ ph $ by ex_elim [l2, l29]
l31: $ GG ⇒ ph $ by wcel_elim [#1, l30]

lemma y2_npis_e2 (GG: hyps) (q1 q2 w2 u_f u_a v_f v_a: set):
  $ GG ⇒ q1 = ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q1 = ⟨ kc_app , scons v_f (scons v_a ∅) ⟩ $ > $ GG ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ = ⟨ kc_app , scons v_f (scons v_a ∅) ⟩ $ by eq_trans [l1, #3]
l3: $ GG ⇒ kc_app ∈ ω $ by v1_kc_app
l4: $ GG ⇒ isset kc_app $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_f $ by isset_var
l6: $ GG ⇒ isset u_a $ by isset_var
l7: $ GG ⇒ isset v_f $ by isset_var
l8: $ GG ⇒ isset v_a $ by isset_var
l9: $ GG ⇒ u_f = v_f ∧ u_a = v_a $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_f = v_f $ by and_elim_l [l9]
l11: $ GG ⇒ u_a = v_a $ by and_elim_r [l9]
l12: $ GG ⇒ ∅ = ∅ $ by eq_refl
l13: $ GG ⇒ kc_nz = kc_nz $ by eq_refl
l14: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by opair_eq [l13, l12]
l15: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = w2 $ by eq_sym [#4]
l16: $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [#2, l14]
l17: $ GG ⇒ q2 = w2 $ by eq_trans [l16, l15]

lemma y2_npis_c2 (GG: hyps) (q1 q2 w2 u_f u_a: set):
  $ GG ⇒ q1 = ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ ra_npis q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by lrel_npis_cases [#2]
l2: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons a ∅ ⟩ $ by and_elim_l [l2]
l7: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l8: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_bvar ∈ kc_app $ by y2_lt_bvar_app
l9: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_app ∈ ω $ by v1_kc_app
l10: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_app $ by wcel_isset [l9]
l11: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⊥ $ by y2_ne [l6, l4, l8, l10]
l12: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by bot_elim [l11]
l13: $ GG , ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l14: $ GG , ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l13, l12]
l15: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l16: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l17: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ $ by and_elim_l [l16]
l18: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l16]
l19: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ $ by and_elim_l [l15]
l20: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l15]
l21: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by y2_npis_e2 [l17, l18, l19, l20]
l22: $ GG , ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l23: $ GG , ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l22, l21]
l24: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l25: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l24, l23]
l26: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel $ by ax
l27: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q1 = ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l28: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q1 = ⟨ kc_app , scons u_f (scons u_a ∅) ⟩ $ by and_elim_l [l27]
l29: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l27]
l30: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ $ by and_elim_l [l26]
l31: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel $ by and_elim_r [l26]
l32: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ w2 = ⟨ kc_s , scons g ∅ ⟩ $ by and_elim_l [l31]
l33: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ ra_npis f g ∈ lrel $ by and_elim_r [l31]
l34: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ kc_app ∈ kc_pi $ by y2_lt_app_pi
l35: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ kc_pi ∈ ω $ by v1_kc_pi
l36: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ isset kc_pi $ by wcel_isset [l35]
l37: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ ⊥ $ by y2_ne [l28, l30, l34, l36]
l38: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q2 = w2 $ by bot_elim [l37]
l39: $ GG , ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l40: $ GG , ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l39, l38]
l41: $ GG , ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l42: $ GG , ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l41, l40]
l43: $ GG , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l44: $ GG , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l43, l42]
l45: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l46: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by weaken [l25]
l47: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by weaken [l44]
l48: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by or_elim [l45, l46, l47]
l49: $ GG ⇒ q2 = w2 $ by or_elim [l1, l14, l48]

lemma y2_npis_d2 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_npis q1 q2 ⟩ ∈ cl_npis_app $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ > $ GG ⇒ ra_npis q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ GG , q1 = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by y2_npis_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ b (q1 = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → q2 = w2) $ by all_intro [l4]
l6: $ GG ⇒ ∀ a ∀ b (q1 = ⟨ kc_app , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → q2 = w2) $ by all_intro [l5]
l7: $ GG ⇒ q2 = w2 $ by y2_npis_i2 [#1, #2, l6]

lemma y2_npis_i3 (GG: hyps) {A B n: set} (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_npis q1 q2 ⟩ ∈ cl_npis_pi $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ > $ GG ⇒ ∀ A ∀ B ∀ n (q1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_npis B n ∈ lrel ∧ ra_npis B n ∈ y2_P_npis lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi ⇒ w ∊ cl_npis_pi $ by ax
l2: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi ⇒ ∃ A ∃ B ∃ n (w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_npis q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ o , ra_npis q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ o , ra_npis q1 q2 ⟩ = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_npis q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_npis B n) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ scons (ra_npis B n) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (scons (ra_npis B n) ∅) $ by y2_fs_set [l11]
l13: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩) $ by opair_isset
l14: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ o = scons (ra_npis B n) ∅ ∧ ra_npis q1 q2 = ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l12, l13]
l15: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ o = scons (ra_npis B n) ∅ $ by and_elim_l [l14]
l16: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ kr_npis , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_npis , scons ⟨ kc_pi , scons A (scons B ∅) ⟩ (scons ⟨ kc_s , scons n ∅ ⟩ ∅) ⟩ $ by and_elim_r [l14]
l17: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ kr_npis ∈ ω $ by x1_kr_npis
l18: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset kr_npis $ by wcel_isset [l17]
l19: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l20: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l21: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset ⟨ kc_pi , scons A (scons B ∅) ⟩ $ by opair_isset
l22: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset ⟨ kc_s , scons n ∅ ⟩ $ by opair_isset
l23: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ $ by y2_nd2 [l16, l18, l19, l20, l21, l22]
l24: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ $ by and_elim_l [l23]
l25: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q2 = ⟨ kc_s , scons n ∅ ⟩ $ by and_elim_r [l23]
l26: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ by weaken [#2]
l27: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ crn o = crn (scons (ra_npis B n) ∅) $ by crn_eq [l15]
l28: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ crn (scons (ra_npis B n) ∅) ⊆ horn lprog ∩ y2_P_npis lrel $ by subset_eq_l [l27, l26]
l29: $ GG , w = ⟨ o , ra_npis q1 q2 ⟩ , w ∊ cl_npis_pi , w = ⟨ scons (ra_npis B n) ∅ , ra_npis ⟨ kc_pi , scons A (scons B ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ horn lprog ∩ y2_P_npis lrel ⊆ horn lprog $ by cin_subset_l
