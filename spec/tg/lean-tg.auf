l25: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ $ by opair_isset
l27: $ G ⇒ scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l26, l9]
