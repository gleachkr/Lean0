lemma y1_k_pis_nil (G: hyps): $ G ⇒ cl_pis_nil ⊆ y1_lab kr_pis (suc kr_pis) $
----
l1: $ G , x ∊ cl_pis_nil ⇒ x ∊ cl_pis_nil $ by ax
l2: $ G , x ∊ cl_pis_nil ⇒ ∃ y (x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ kr_pis ∈ ω $ by x1_kr_pis
l5: $ G , x = ⟨ ∅ , ra_pis ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x ∊ y1_lab kr_pis (suc kr_pis) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_pis_nil ⇒ x ∊ y1_lab kr_pis (suc kr_pis) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_pis_nil ⊆ y1_lab kr_pis (suc kr_pis) $ by subset_intro [l6]

lemma y1_k_pis_cons (G: hyps): $ G ⇒ cl_pis_cons ⊆ y1_lab kr_pis (suc kr_pis) $
----
l1: $ G , x ∊ cl_pis_cons ⇒ x ∊ cl_pis_cons $ by ax
l2: $ G , x ∊ cl_pis_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ kr_pis ∈ ω $ by x1_kr_pis
l5: $ G , x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩ ⇒ x ∊ y1_lab kr_pis (suc kr_pis) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ x ∊ y1_lab kr_pis (suc kr_pis) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ x ∊ y1_lab kr_pis (suc kr_pis) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_pis v ⟨ kc_pi , scons y (scons z ∅) ⟩ u) ∅ , ra_pis ⟨ kc_cons , scons y (scons v ∅) ⟩ z u ⟩) ⇒ x ∊ y1_lab kr_pis (suc kr_pis) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_pis_cons ⇒ x ∊ y1_lab kr_pis (suc kr_pis) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_pis_cons ⊆ y1_lab kr_pis (suc kr_pis) $ by subset_intro [l12]

lemma y1_p_pis (G: hyps): $ G ⇒ pr_pis ⊆ y1_lab kr_pis (suc kr_pis) $
----
l1: $ G ⇒ cl_pis_cons ⊆ y1_lab kr_pis (suc kr_pis) $ by y1_k_pis_cons
