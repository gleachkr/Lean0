l37: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_nonempty_blk → v1_d_ctors x y t $ by v1_skip_nonempty_blk [l16, l36]
l38: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_quot_sound_atom → v1_d_ctors x y t $ by v1_skip_quot_sound_atom [l10, l37]
l39: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_propext_atom → v1_d_ctors x y t $ by v1_skip_propext_atom [l10, l38]
l40: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_iff_blk → v1_d_ctors x y t $ by v1_skip_iff_blk [l16, l39]
