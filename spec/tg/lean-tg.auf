l25: $ GG , ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) ⇒ ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) $ by ax
l26: $ GG , ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) ⇒ q3 = w3 ∧ q4 = w4 $ by ex_elim [l25, l24]
l27: $ GG , ∃ b ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) ⇒ ∃ b ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) $ by ax
