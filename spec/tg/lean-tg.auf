lemma y2_clen_c_e2 (GG: hyps) (q1 q2 w2 u_K u_C u_n v_K v_C v_n: set):
  $ GG ⇒ q1 = ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ > $ GG ⇒ ra_clen_c u_C u_n ∈ lrel $ > $ GG ⇒ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ > $ GG ⇒ q1 = ⟨ kc_ccons , scons v_K (scons v_C ∅) ⟩ $ > $ GG ⇒ w2 = ⟨ kc_s , scons v_n ∅ ⟩ $ > $ GG ⇒ ra_clen_c v_C v_n ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ = ⟨ kc_ccons , scons v_K (scons v_C ∅) ⟩ $ by eq_trans [l1, #5]
l3: $ GG ⇒ kc_ccons ∈ ω $ by v1_kc_ccons
l4: $ GG ⇒ isset kc_ccons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_K $ by isset_var
l6: $ GG ⇒ isset u_C $ by isset_var
l7: $ GG ⇒ isset v_K $ by isset_var
l8: $ GG ⇒ isset v_C $ by isset_var
l9: $ GG ⇒ u_K = v_K ∧ u_C = v_C $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_K = v_K $ by and_elim_l [l9]
l11: $ GG ⇒ u_C = v_C $ by and_elim_r [l9]
l12: $ GG ⇒ v_C = u_C $ by eq_sym [l11]
l13: $ GG ⇒ v_n = v_n $ by eq_refl
l14: $ GG ⇒ ra_clen_c u_C v_n ∈ lrel $ by x1_eq_clen_c [#7, l12, l13]
l15: $ GG ⇒ isset u_C $ by isset_var
l16: $ GG ⇒ isset u_n $ by isset_var
l17: $ GG ⇒ isset v_n $ by isset_var
l18: $ GG ⇒ u_n = v_n $ by y2_clen_c_ihc [l15, l16, l17, #4, l14]
l19: $ GG ⇒ ∅ = ∅ $ by eq_refl
l20: $ GG ⇒ scons u_n ∅ = scons v_n ∅ $ by scons_eq [l18, l19]
l21: $ GG ⇒ kc_s = kc_s $ by eq_refl
l22: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = ⟨ kc_s , scons v_n ∅ ⟩ $ by opair_eq [l21, l20]
l23: $ GG ⇒ ⟨ kc_s , scons v_n ∅ ⟩ = w2 $ by eq_sym [#6]
l24: $ GG ⇒ q2 = ⟨ kc_s , scons v_n ∅ ⟩ $ by eq_trans [#2, l22]
l25: $ GG ⇒ q2 = w2 $ by eq_trans [l24, l23]

lemma y2_clen_c_c2 (GG: hyps) (q1 q2 w2 u_K u_C u_n: set):
  $ GG ⇒ q1 = ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen_c u_C u_n ∈ lrel ∧ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ > $ GG ⇒ ra_clen_c q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ (q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) $ by lrel_clen_c_cases [#2]
l2: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen_c u_C u_n ∈ lrel ∧ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen_c u_C u_n ∈ lrel ∧ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen_c u_C u_n ∈ lrel ∧ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen_c u_C u_n ∈ lrel $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l2]
l11: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l12: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cnil ∈ kc_ccons $ by y2_lt_cnil_ccons
l13: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_ccons ∈ ω $ by v1_kc_ccons
l14: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_ccons $ by wcel_isset [l13]
l15: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⊥ $ by y2_ne [l10, l4, l12, l14]
l16: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by bot_elim [l15]
l17: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel $ by ax
l18: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q1 = ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen_c u_C u_n ∈ lrel ∧ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ by weaken [#1]
l19: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q1 = ⟨ kc_ccons , scons u_K (scons u_C ∅) ⟩ $ by and_elim_l [l18]
l20: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen_c u_C u_n ∈ lrel ∧ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ by and_elim_r [l18]
l21: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l20]
l22: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ ra_clen_c u_C u_n ∈ lrel ∧ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ by and_elim_r [l20]
l23: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ ra_clen_c u_C u_n ∈ lrel $ by and_elim_l [l22]
l24: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ ra_clen_c u_C u_n ∈ y2_P_clen_c lrel $ by and_elim_r [l22]
l25: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ $ by and_elim_l [l17]
l26: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel $ by and_elim_r [l17]
l27: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ w2 = ⟨ kc_s , scons d ∅ ⟩ $ by and_elim_l [l26]
l28: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ ra_clen_c b d ∈ lrel $ by and_elim_r [l26]
l29: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q2 = w2 $ by y2_clen_c_e2 [l19, l21, l23, l24, l25, l27, l28]
l30: $ GG , ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) $ by ax
l31: $ GG , ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l30, l29]
l32: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) $ by ax
l33: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l32, l31]
l34: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) $ by ax
l35: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l34, l33]
l36: $ GG ⇒ q2 = w2 $ by or_elim [l1, l16, l35]

lemma y2_clen_c_d2 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_clen_c q1 q2 ⟩ ∈ cl_clen_c_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel $ > $ GG ⇒ ra_clen_c q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ∧ ra_clen_c b d ∈ y2_P_clen_c lrel ⇒ q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ∧ ra_clen_c b d ∈ y2_P_clen_c lrel $ by ax
l2: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ∧ ra_clen_c b d ∈ y2_P_clen_c lrel ⇒ ra_clen_c q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ∧ ra_clen_c b d ∈ y2_P_clen_c lrel ⇒ q2 = w2 $ by y2_clen_c_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ∧ ra_clen_c b d ∈ y2_P_clen_c lrel → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ∧ ra_clen_c b d ∈ y2_P_clen_c lrel → q2 = w2) $ by all_intro [l4]
l6: $ GG ⇒ ∀ b ∀ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ∧ ra_clen_c b d ∈ y2_P_clen_c lrel → q2 = w2) $ by all_intro [l5]
l7: $ GG ⇒ ∀ a ∀ b ∀ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ∧ ra_clen_c b d ∈ y2_P_clen_c lrel → q2 = w2) $ by all_intro [l6]
l8: $ GG ⇒ q2 = w2 $ by y2_clen_c_i2 [#1, #2, l7]

lemma y2_clen_c_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen_c lrel → c ∊ y2_P_clen_c lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ c = ra_clen_c x1 x2 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_clen_c x1 x2 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ ⟨ o , ra_clen_c x1 x2 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ ⟨ o , ra_clen_c x1 x2 ⟩ ∈ pr_clen_c $ by lprog_clen_c_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ ra_clen_c x1 x6 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel , ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_nil ⇒ ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_nil $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel , ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_nil ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel , ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_nil ⇒ ra_clen_c x1 x6 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel , ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_nil ⇒ x2 = x6 $ by y2_clen_c_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel , ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_cons ⇒ ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_cons $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel , ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_cons ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel , ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_cons ⇒ ra_clen_c x1 x6 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel , ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_cons ⇒ x2 = x6 $ by y2_clen_c_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_cons → x2 = x6 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ ⟨ o , ra_clen_c x1 x2 ⟩ ∈ cl_clen_c_nil ∪ cl_clen_c_cons → x2 = x6 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 , ra_clen_c x1 x6 ∈ lrel ⇒ x2 = x6 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 ⇒ ra_clen_c x1 x6 ∈ lrel → x2 = x6 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel , c = ra_clen_c x1 x2 ⇒ ∀ x6 (⟨ kr_clen_c , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel ⇒ c = ⟨ kr_clen_c , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen_c , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6) $ by imp_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel ⇒ ∀ x2 (c = ⟨ kr_clen_c , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen_c , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel ⇒ ∀ x1 ∀ x2 (c = ⟨ kr_clen_c , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen_c , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen_c lrel ⇒ c ∊ y2_P_clen_c lrel $ by cab_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel → c ∊ y2_P_clen_c lrel $ by imp_intro [l25]
l27: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen_c lrel → c ∊ y2_P_clen_c lrel $ by imp_intro [l26]
l28: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen_c lrel → c ∊ y2_P_clen_c lrel) $ by all_intro [l27]
l29: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen_c lrel → c ∊ y2_P_clen_c lrel) $ by all_intro [l28]

lemma y2_clen_c_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_clen_c lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen_c lrel → c ∊ y2_P_clen_c lrel) $ by y2_clen_c_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_clen_c lrel $ by horn_ind [l1, l2]

lrel_clen_c_det
---------------
l1: $ G ⇒ horn lprog ⊆ y2_P_clen_c lrel $ by y2_clen_c_in
l2: $ G ⇒ ra_clen_c t1 u2 ∈ y2_P_clen_c lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u2 = v2 $ by y2_clen_c_ih [l2, #2]

--| The atoms of `cnth` whose variants in `L` with the same inputs have the same outputs.
def y2_P_cnth (L: class) (.c .x1 .x2 .x3 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_cnth , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ L → x3 = x6))} $

lemma y2_cnth_ih (GG: hyps) (q1 q2 q3 w3: set):
  $ GG ⇒ ra_cnth q1 q2 q3 ∈ y2_P_cnth lrel $ > $ GG ⇒ ra_cnth q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ c ∊ y2_P_cnth lrel $ by ax
l2: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_cnth , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_cnth , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons q1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ ∀ x3 (c = ⟨ kr_cnth , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ c = ⟨ kr_cnth , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 (⟨ kr_cnth , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by all_elim [l4]
l6: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ c = ra_cnth q1 q2 q3 $ by ax
l7: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ ∀ x6 (⟨ kr_cnth , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ ra_cnth q1 q2 w3 ∈ lrel → q3 = w3 $ by all_elim [l7]
l9: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ ra_cnth q1 q2 w3 ∈ lrel $ by weaken [#2]
l10: $ GG , c = ra_cnth q1 q2 q3 , c ∊ y2_P_cnth lrel ⇒ q3 = w3 $ by imp_elim [l8, l9]
l11: $ GG ⇒ q3 = w3 $ by wcel_elim [#1, l10]

lemma y2_cnth_ihc (GG: hyps) (Q1 Q2 Q3 W3: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset W3 $ > $ GG ⇒ ra_cnth Q1 Q2 Q3 ∈ y2_P_cnth lrel $ > $ GG ⇒ ra_cnth Q1 Q2 W3 ∈ lrel $ > $ GG ⇒ Q3 = W3 $
----
l1: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ d = Q3 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ e = W3 $ by ax
l5: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q1 = a $ by eq_sym [l1]
l6: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q2 = b $ by eq_sym [l2]
l7: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = d $ by eq_sym [l3]
l8: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ W3 = e $ by eq_sym [l4]
l9: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ∅ = ∅ $ by eq_refl
l10: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q3 ∅ = scons d ∅ $ by scons_eq [l7, l9]
l11: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q2 (scons Q3 ∅) = scons b (scons d ∅) $ by scons_eq [l6, l10]
l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q1 (scons Q2 (scons Q3 ∅)) = scons a (scons b (scons d ∅)) $ by scons_eq [l5, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ kr_cnth = kr_cnth $ by eq_refl
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_cnth Q1 Q2 Q3 = ra_cnth a b d $ by opair_eq [l13, l12]
l15: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_cnth Q1 Q2 Q3 ∈ y2_P_cnth lrel $ by weaken [#5]
l16: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_cnth a b d ∈ y2_P_cnth lrel $ by wcel_eq_l [l14, l15]
l17: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_cnth Q1 Q2 W3 ∈ lrel $ by weaken [#6]
l18: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_cnth a b e ∈ lrel $ by x1_eq_cnth [l17, l5, l6, l8]
l19: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ d = e $ by y2_cnth_ih [l16, l18]
l20: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = e $ by eq_trans [l7, l19]
l21: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = W3 $ by eq_trans [l20, l4]
l22: $ GG , a = Q1 , b = Q2 , d = Q3 ⇒ Q3 = W3 $ by isset_elim [#4, l21]
l23: $ GG , a = Q1 , b = Q2 ⇒ Q3 = W3 $ by isset_elim [#3, l22]
l24: $ GG , a = Q1 ⇒ Q3 = W3 $ by isset_elim [#2, l23]
l25: $ GG ⇒ Q3 = W3 $ by isset_elim [#1, l24]

lemma y2_cnth_i1 (GG: hyps) {A G: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_cnth q1 q2 q3 ⟩ ∈ cl_cnth_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_cnth lrel $ > $ GG ⇒ ∀ A ∀ G (q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = A → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z ⇒ w ∊ cl_cnth_z $ by ax
l2: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z ⇒ ∃ A ∃ G (w = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A ⟩) $ by cab_elim [l1]
