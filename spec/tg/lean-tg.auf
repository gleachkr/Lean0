l7: $ G , ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_inst_proj ⇒ x ∊ y1_lab kr_inst (suc kr_inst) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_inst_proj ⊆ y1_lab kr_inst (suc kr_inst) $ by subset_intro [l16]

lemma y1_p_inst (G: hyps): $ G ⇒ pr_inst ⊆ y1_lab kr_inst (suc kr_inst) $
----
l1: $ G ⇒ cl_inst_proj ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_proj
l2: $ G ⇒ cl_inst_closed ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_closed
l3: $ G ⇒ cl_inst_closed ∪ cl_inst_proj ⊆ y1_lab kr_inst (suc kr_inst) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_inst_pi ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_pi
l5: $ G ⇒ cl_inst_pi ∪ (cl_inst_closed ∪ cl_inst_proj) ⊆ y1_lab kr_inst (suc kr_inst) $ by cun_least [l4, l3]
l6: $ G ⇒ cl_inst_lam ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_lam
l7: $ G ⇒ cl_inst_lam ∪ (cl_inst_pi ∪ (cl_inst_closed ∪ cl_inst_proj)) ⊆ y1_lab kr_inst (suc kr_inst) $ by cun_least [l6, l5]
l8: $ G ⇒ cl_inst_app ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_app
l9: $ G ⇒ cl_inst_app ∪ (cl_inst_lam ∪ (cl_inst_pi ∪ (cl_inst_closed ∪ cl_inst_proj))) ⊆ y1_lab kr_inst (suc kr_inst) $ by cun_least [l8, l7]
l10: $ G ⇒ cl_inst_srt ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_srt
l11: $ G ⇒ cl_inst_srt ∪ (cl_inst_app ∪ (cl_inst_lam ∪ (cl_inst_pi ∪ (cl_inst_closed ∪ cl_inst_proj)))) ⊆ y1_lab kr_inst (suc kr_inst) $ by cun_least [l10, l9]
l12: $ G ⇒ cl_inst_bvar_gt ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_bvar_gt
l13: $ G ⇒ cl_inst_bvar_gt ∪ (cl_inst_srt ∪ (cl_inst_app ∪ (cl_inst_lam ∪ (cl_inst_pi ∪ (cl_inst_closed ∪ cl_inst_proj))))) ⊆ y1_lab kr_inst (suc kr_inst) $ by cun_least [l12, l11]
l14: $ G ⇒ cl_inst_bvar_eq ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_bvar_eq
l15: $ G ⇒ cl_inst_bvar_eq ∪ (cl_inst_bvar_gt ∪ (cl_inst_srt ∪ (cl_inst_app ∪ (cl_inst_lam ∪ (cl_inst_pi ∪ (cl_inst_closed ∪ cl_inst_proj)))))) ⊆ y1_lab kr_inst (suc kr_inst) $ by cun_least [l14, l13]
l16: $ G ⇒ cl_inst_bvar_lt ⊆ y1_lab kr_inst (suc kr_inst) $ by y1_k_inst_bvar_lt
l17: $ G ⇒ pr_inst ⊆ y1_lab kr_inst (suc kr_inst) $ by cun_least [l16, l15]

lemma y1_k_lookup_z (G: hyps): $ G ⇒ cl_lookup_z ⊆ y1_lab kr_lookup (suc kr_lookup) $
----
l1: $ G , x ∊ cl_lookup_z ⇒ x ∊ cl_lookup_z $ by ax
l2: $ G , x ∊ cl_lookup_z ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ kr_lookup ∈ ω $ by x1_kr_lookup
l5: $ G , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) ⇒ ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_lookup_z ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_lookup_z ⊆ y1_lab kr_lookup (suc kr_lookup) $ by subset_intro [l10]

lemma y1_k_lookup_s (G: hyps): $ G ⇒ cl_lookup_s ⊆ y1_lab kr_lookup (suc kr_lookup) $
----
l1: $ G , x ∊ cl_lookup_s ⇒ x ∊ cl_lookup_s $ by ax
l2: $ G , x ∊ cl_lookup_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ kr_lookup ∈ ω $ by x1_kr_lookup
l5: $ G , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by ax
l7: $ G , ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by ex_elim [l6, l5]
l8: $ G , ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by ax
l9: $ G , ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by ex_elim [l8, l7]
l10: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by ax
l11: $ G , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by ex_elim [l10, l9]
l12: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by ax
l13: $ G , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by ex_elim [l12, l11]
l14: $ G , x ∊ cl_lookup_s ⇒ x ∊ y1_lab kr_lookup (suc kr_lookup) $ by ex_elim [l2, l13]
l15: $ G ⇒ cl_lookup_s ⊆ y1_lab kr_lookup (suc kr_lookup) $ by subset_intro [l14]

lemma y1_p_lookup (G: hyps): $ G ⇒ pr_lookup ⊆ y1_lab kr_lookup (suc kr_lookup) $
----
l1: $ G ⇒ cl_lookup_s ⊆ y1_lab kr_lookup (suc kr_lookup) $ by y1_k_lookup_s
l2: $ G ⇒ cl_lookup_z ⊆ y1_lab kr_lookup (suc kr_lookup) $ by y1_k_lookup_z
l3: $ G ⇒ pr_lookup ⊆ y1_lab kr_lookup (suc kr_lookup) $ by cun_least [l2, l1]

lemma y1_k_cinst_z (G: hyps): $ G ⇒ cl_cinst_z ⊆ y1_lab kr_cinst (suc kr_cinst) $
----
l1: $ G , x ∊ cl_cinst_z ⇒ x ∊ cl_cinst_z $ by ax
l2: $ G , x ∊ cl_cinst_z ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ kr_cinst ∈ ω $ by x1_kr_cinst
l5: $ G , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_cinst_z ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_cinst_z ⊆ y1_lab kr_cinst (suc kr_cinst) $ by subset_intro [l10]

lemma y1_k_cinst_s (G: hyps): $ G ⇒ cl_cinst_s ⊆ y1_lab kr_cinst (suc kr_cinst) $
----
l1: $ G , x ∊ cl_cinst_s ⇒ x ∊ cl_cinst_s $ by ax
l2: $ G , x ∊ cl_cinst_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ kr_cinst ∈ ω $ by x1_kr_cinst
l5: $ G , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l6, l5]
l8: $ G , ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l8, l7]
l10: $ G , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l10, l9]
l12: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l12, l11]
l14: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l15: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l14, l13]
l16: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l17: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l16, l15]
l18: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l19: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l18, l17]
l20: $ G , x ∊ cl_cinst_s ⇒ x ∊ y1_lab kr_cinst (suc kr_cinst) $ by ex_elim [l2, l19]
l21: $ G ⇒ cl_cinst_s ⊆ y1_lab kr_cinst (suc kr_cinst) $ by subset_intro [l20]

lemma y1_p_cinst (G: hyps): $ G ⇒ pr_cinst ⊆ y1_lab kr_cinst (suc kr_cinst) $
----
l1: $ G ⇒ cl_cinst_s ⊆ y1_lab kr_cinst (suc kr_cinst) $ by y1_k_cinst_s
l2: $ G ⇒ cl_cinst_z ⊆ y1_lab kr_cinst (suc kr_cinst) $ by y1_k_cinst_z
l3: $ G ⇒ pr_cinst ⊆ y1_lab kr_cinst (suc kr_cinst) $ by cun_least [l2, l1]

lemma y1_k_cext_z (G: hyps): $ G ⇒ cl_cext_z ⊆ y1_lab kr_cext (suc kr_cext) $
----
l1: $ G , x ∊ cl_cext_z ⇒ x ∊ cl_cext_z $ by ax
l2: $ G , x ∊ cl_cext_z ⇒ ∃ y (x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ kr_cext ∈ ω $ by x1_kr_cext
l5: $ G , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ x ∊ y1_lab kr_cext (suc kr_cext) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_cext_z ⇒ x ∊ y1_lab kr_cext (suc kr_cext) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_cext_z ⊆ y1_lab kr_cext (suc kr_cext) $ by subset_intro [l6]

lemma y1_k_cext_s (G: hyps): $ G ⇒ cl_cext_s ⊆ y1_lab kr_cext (suc kr_cext) $
----
l1: $ G , x ∊ cl_cext_s ⇒ x ∊ cl_cext_s $ by ax
l2: $ G , x ∊ cl_cext_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ kr_cext ∈ ω $ by x1_kr_cext
l5: $ G , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_cext (suc kr_cext) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cext (suc kr_cext) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cext (suc kr_cext) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_cext (suc kr_cext) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_cext_s ⇒ x ∊ y1_lab kr_cext (suc kr_cext) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_cext_s ⊆ y1_lab kr_cext (suc kr_cext) $ by subset_intro [l12]

lemma y1_p_cext (G: hyps): $ G ⇒ pr_cext ⊆ y1_lab kr_cext (suc kr_cext) $
----
l1: $ G ⇒ cl_cext_s ⊆ y1_lab kr_cext (suc kr_cext) $ by y1_k_cext_s
l2: $ G ⇒ cl_cext_z ⊆ y1_lab kr_cext (suc kr_cext) $ by y1_k_cext_z
l3: $ G ⇒ pr_cext ⊆ y1_lab kr_cext (suc kr_cext) $ by cun_least [l2, l1]

lemma y1_k_clen_nil (G: hyps): $ G ⇒ cl_clen_nil ⊆ y1_lab kr_clen (suc kr_clen) $
----
l1: $ G , x ∊ cl_clen_nil ⇒ x ∊ cl_clen_nil $ by ax
l2: $ G , x ∊ cl_clen_nil ⇒ (x = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x ∊ cl_clen_nil ⇒ kr_clen ∈ ω $ by x1_kr_clen
l4: $ G , x ∊ cl_clen_nil ⇒ x ∊ y1_lab kr_clen (suc kr_clen) $ by y1_lab_self [l2, l3]
l5: $ G ⇒ cl_clen_nil ⊆ y1_lab kr_clen (suc kr_clen) $ by subset_intro [l4]

lemma y1_k_clen_cons (G: hyps): $ G ⇒ cl_clen_cons ⊆ y1_lab kr_clen (suc kr_clen) $
----
l1: $ G , x ∊ cl_clen_cons ⇒ x ∊ cl_clen_cons $ by ax
l2: $ G , x ∊ cl_clen_cons ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ kr_clen ∈ ω $ by x1_kr_clen
l5: $ G , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_clen (suc kr_clen) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_clen (suc kr_clen) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_clen (suc kr_clen) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_clen_cons ⇒ x ∊ y1_lab kr_clen (suc kr_clen) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_clen_cons ⊆ y1_lab kr_clen (suc kr_clen) $ by subset_intro [l10]

lemma y1_p_clen (G: hyps): $ G ⇒ pr_clen ⊆ y1_lab kr_clen (suc kr_clen) $
----
l1: $ G ⇒ cl_clen_cons ⊆ y1_lab kr_clen (suc kr_clen) $ by y1_k_clen_cons
l2: $ G ⇒ cl_clen_nil ⊆ y1_lab kr_clen (suc kr_clen) $ by y1_k_clen_nil
l3: $ G ⇒ pr_clen ⊆ y1_lab kr_clen (suc kr_clen) $ by cun_least [l2, l1]

lemma y1_k_cnth_z (G: hyps): $ G ⇒ cl_cnth_z ⊆ y1_lab kr_cnth (suc kr_cnth) $
----
l1: $ G , x ∊ cl_cnth_z ⇒ x ∊ cl_cnth_z $ by ax
l2: $ G , x ∊ cl_cnth_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ kr_cnth ∈ ω $ by x1_kr_cnth
l5: $ G , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x ∊ y1_lab kr_cnth (suc kr_cnth) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ x ∊ y1_lab kr_cnth (suc kr_cnth) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_cnth_z ⇒ x ∊ y1_lab kr_cnth (suc kr_cnth) $ by ex_elim [l2, l7]
