lemma y1_o_cminors (G: hyps) {D np n_v k_v i_v c_v nf K Min C M1 M: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ pr_cminors $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons $ by ax
l2: $ G , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by y1_d_cminors_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons → ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil ∪ cl_cminors_cons ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil ∪ cl_cminors_cons $ by ax
l6: $ G , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil ∪ cl_cminors_cons ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil ∨ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons $ by v1_wcel_cun_elim [l5]
