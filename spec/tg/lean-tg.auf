lemma y1_d_aux_data_i (G: hyps) {D I b_v bi_v P Pi N T Ti j_v i_v npi ni mi X F Fi C Ci: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ ∈ cl_aux_data_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ I ∃ b_v ∃ bi_v ∃ P ∃ Pi ∃ N ∃ T ∃ Ti ∃ j_v ∃ i_v ∃ npi ∃ ni ∃ mi ∃ X ∃ F ∃ Fi ∃ C ∃ Ci (t1 = D ∧ t2 = I ∧ t3 = X ∧ t4 = j_v ∧ t5 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ty Ti i_v Fi Ci ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X Fi F ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_spz_ctors D N I X ni npi Ci C ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , x ∊ cl_aux_data_i ⇒ x ∊ cl_aux_data_i $ by ax
l2: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , x ∊ cl_aux_data_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩ ⇒ x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩ ⇒ ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩ ⇒ x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩ ⇒ ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_ind_data y u w c) (scons (ra_ind_nested y b) (scons (ra_ind_data z v a f) (scons (ra_nth_ty c g h m) (scons (ra_nth_ty f i l n) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ e l h) (scons (ra_ind_arity z j k d) (scons (ra_spz_ctors y b z e k j n m) ∅))))))) , ra_aux_data y z e g i ⟩ $ by eq_trans [l4, l5]
