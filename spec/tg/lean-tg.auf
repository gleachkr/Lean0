l111: $ G ⇒ ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add V4 V3 mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons i_v ∅) ⟩ dmn V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by ex_intro [l110]
l112: $ G ⇒ ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v V3 mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons i_v ∅) ⟩ dmn V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by ex_intro [l111]
l113: $ G ⇒ ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = V1 ∧ t2 = V2 ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons i_v ∅) ⟩ dmn V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by ex_intro [l112]
l114: $ G ⇒ ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by ex_intro [l113]
l115: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $ by ex_intro [l114]

lemma y1_d_rtail_srt (G: hyps) {D np n_v m_v i_v d_v mn dmn mi l_v X I X2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_rtail_srt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ i_v ∃ d_v ∃ mn ∃ dmn ∃ mi ∃ l_v ∃ X ∃ I ∃ X2 (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = i_v ∧ t6 = d_v ∧ t7 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t8 = ⟨ kc_pi , scons I (scons ⟨ kc_app , scons X2 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add d_v mn dmn ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ dmn np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel ∧ ra_add mi i_v dmn ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mi ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ d_v X2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_rtail_srt ⇒ x ∊ cl_rtail_srt $ by ax
l2: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_rtail_srt ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rtail t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_add v u b) (scons (ra_add a b c) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons w ∅) ⟩ c z i) (scons (ra_pargs i ⟨ kc_nz , ∅ ⟩ a j) (scons (ra_add f w c) (scons (ra_pargs ⟨ kc_bvar , scons f ∅ ⟩ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ a k) ∅))))) , ra_rtail y z u v w a ⟨ kc_srt , scons g ∅ ⟩ ⟨ kc_pi , scons j (scons ⟨ kc_app , scons k (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
