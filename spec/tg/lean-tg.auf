lemma y1_e_spz_ctors_cons (G: hyps) {D I N NI X K K1 K2 K3 K4 ni npi C C2: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14: set):
  $ G ⇒ ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_sinst V2 ⟨ kc_nz , ∅ ⟩ V11 V12 V6 V7) (scons (ra_ind_nested V2 V4) (scons (ra_rst V2 V4 V7 V8) (scons (ra_afree V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V5 V8 V9) (scons (ra_spz V1 V3 ⟨ kc_nz , ∅ ⟩ V9 V10) (scons (ra_spz_ctors V1 V3 V2 V5 V11 V12 V13 V14) ∅)))))) , ra_spz_ctors V1 V3 V2 V5 V11 V12 ⟨ kc_ccons , scons V6 (scons V13 ∅) ⟩ ⟨ kc_ccons , scons V10 (scons V14 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ I ∃ N ∃ NI ∃ X ∃ K ∃ K1 ∃ K2 ∃ K3 ∃ K4 ∃ ni ∃ npi ∃ C ∃ C2 (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = ⟨ kc_ccons , scons K4 (scons C2 ∅) ⟩ ∧ ra_sinst I ⟨ kc_nz , ∅ ⟩ ni npi K K1 ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_rst I NI K1 K2 ∈ lrel ∧ ra_afree K2 ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X K2 K3 ∈ lrel ∧ ra_spz D N ⟨ kc_nz , ∅ ⟩ K3 K4 ∈ lrel ∧ ra_spz_ctors D N I X ni npi C C2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_sinst V2 ⟨ kc_nz , ∅ ⟩ V11 V12 V6 V7) (scons (ra_ind_nested V2 V4) (scons (ra_rst V2 V4 V7 V8) (scons (ra_afree V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V5 V8 V9) (scons (ra_spz V1 V3 ⟨ kc_nz , ∅ ⟩ V9 V10) (scons (ra_spz_ctors V1 V3 V2 V5 V11 V12 V13 V14) ∅)))))) , ra_spz_ctors V1 V3 V2 V5 V11 V12 ⟨ kc_ccons , scons V6 (scons V13 ∅) ⟩ ⟨ kc_ccons , scons V10 (scons V14 ∅) ⟩ ⟩ = ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_sinst V2 ⟨ kc_nz , ∅ ⟩ V11 V12 V6 V7) (scons (ra_ind_nested V2 V4) (scons (ra_rst V2 V4 V7 V8) (scons (ra_afree V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V5 V8 V9) (scons (ra_spz V1 V3 ⟨ kc_nz , ∅ ⟩ V9 V10) (scons (ra_spz_ctors V1 V3 V2 V5 V11 V12 V13 V14) ∅))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
