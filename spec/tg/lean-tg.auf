lemma y1_p_rwalk (G: hyps): $ G ⇒ pr_rwalk ⊆ y1_lab kr_rwalk (suc kr_rwalk) $
----
l1: $ G ⇒ cl_rwalk_res ⊆ y1_lab kr_rwalk (suc kr_rwalk) $ by y1_k_rwalk_res
