lemma y1_p_nst_hit (G: hyps): $ G ⇒ pr_nst_hit ⊆ y1_lab kr_nst_hit (suc kr_nst_hit) $
----
l1: $ G ⇒ cl_nst_hit_s ⊆ y1_lab kr_nst_hit (suc kr_nst_hit) $ by y1_k_nst_hit_s
l2: $ G ⇒ cl_nst_hit_z ⊆ y1_lab kr_nst_hit (suc kr_nst_hit) $ by y1_k_nst_hit_z
l3: $ G ⇒ pr_nst_hit ⊆ y1_lab kr_nst_hit (suc kr_nst_hit) $ by cun_least [l2, l1]

lemma y1_k_spz_refl (G: hyps): $ G ⇒ cl_spz_refl ⊆ y1_lab kr_spz (suc kr_spz) $
----
l1: $ G , x ∊ cl_spz_refl ⇒ x ∊ cl_spz_refl $ by ax
l2: $ G , x ∊ cl_spz_refl ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ x = ⟨ ∅ , ra_spz y z u v v ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ kr_spz ∈ ω $ by x1_kr_spz
l5: $ G , x = ⟨ ∅ , ra_spz y z u v v ⟩ ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_spz y z u v v ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_spz_refl ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_spz_refl ⊆ y1_lab kr_spz (suc kr_spz) $ by subset_intro [l12]

lemma y1_k_spz_hit (G: hyps): $ G ⇒ cl_spz_hit ⊆ y1_lab kr_spz (suc kr_spz) $
----
l1: $ G , x ∊ cl_spz_hit ⇒ x ∊ cl_spz_hit $ by ax
