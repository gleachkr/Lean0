-- Proofs for lean-tg.mm0.

-- Lemmas of v1 (the range lsig_sig .. ofsort_ctors_cases). The proofs of the
-- range are uniform over the 37 constructors and 11 sorts of the signature;
-- they were generated by a script from the signature and then compiled.

--| Class form of `scons_fseq`.
lemma v1_scons_fseq_c (G: hyps) (A B C: class):
  $ G ⇒ B ∈ A $ > $ G ⇒ C ∈ fseq A $ > $ G ⇒ scons B C ∈ fseq A $
----
l1: $ G , x = B , x ∊ A , y = C , y ∊ fseq A ⇒ x ∊ A $ by ax
l2: $ G , x = B , x ∊ A , y = C , y ∊ fseq A ⇒ y ∊ fseq A $ by ax
l3: $ G , x = B , x ∊ A , y = C , y ∊ fseq A ⇒ scons x y ∈ fseq A $ by scons_fseq [l1, l2]
l4: $ G , x = B , x ∊ A , y = C , y ∊ fseq A ⇒ x = B $ by ax
l5: $ G , x = B , x ∊ A , y = C , y ∊ fseq A ⇒ y = C $ by ax
l6: $ G , x = B , x ∊ A , y = C , y ∊ fseq A ⇒ scons x y = scons B C $ by scons_eq [l4, l5]
l7: $ G , x = B , x ∊ A , y = C , y ∊ fseq A ⇒ scons B C ∈ fseq A $ by wcel_eq_l [l6, l3]
l8: $ G , x = B , x ∊ A ⇒ scons B C ∈ fseq A $ by wcel_elim [#2, l7]
l9: $ G ⇒ scons B C ∈ fseq A $ by wcel_elim [#1, l8]

--| Class form of `cpr_subset`.
lemma v1_cpr_subset_c (G: hyps) (A B X: class):
  $ G ⇒ A ∈ X $ > $ G ⇒ B ∈ X $ > $ G ⇒ cpr A B ⊆ X $
----
l1: $ G , z ∊ cpr A B ⇒ z ∊ cpr A B $ by ax
l2: $ G , z ∊ cpr A B ⇒ z = A ∨ z = B $ by cpr_elim [l1]
l3: $ G , z ∊ cpr A B , z = A ⇒ z = A $ by ax
l4: $ G , z ∊ cpr A B , z = A ⇒ A ∈ X $ by weaken [#1]
l5: $ G , z ∊ cpr A B , z = A ⇒ A = z $ by eq_sym [l3]
l6: $ G , z ∊ cpr A B , z = A ⇒ z ∈ X $ by wcel_eq_l [l5, l4]
l7: $ G , z ∊ cpr A B , z = A ⇒ z ∊ X $ by wcel_welc [l6]
l8: $ G , z ∊ cpr A B , z = B ⇒ z = B $ by ax
l9: $ G , z ∊ cpr A B , z = B ⇒ B ∈ X $ by weaken [#2]
l10: $ G , z ∊ cpr A B , z = B ⇒ B = z $ by eq_sym [l8]
l11: $ G , z ∊ cpr A B , z = B ⇒ z ∈ X $ by wcel_eq_l [l10, l9]
l12: $ G , z ∊ cpr A B , z = B ⇒ z ∊ X $ by wcel_welc [l11]
l13: $ G , z ∊ cpr A B ⇒ z ∊ X $ by or_elim [l2, l7, l12]
l14: $ G ⇒ cpr A B ⊆ X $ by subset_intro [l13]

--| Class form of `suc_self`.
lemma v1_in_suc (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ suc A $
----
l1: $ G , x = A ⇒ x = A $ by ax
l2: $ G , x = A ⇒ x ∊ suc A $ by suc_intro_r [l1]
l3: $ G , x = A ⇒ A ∈ suc A $ by wcel_intro [l1, l2]
l4: $ G ⇒ A ∈ suc A $ by isset_elim [#1, l3]

lemma v1_in_suc_r (G: hyps) (A B: class): $ G ⇒ A ∈ B $ > $ G ⇒ A ∈ suc B $
----
l1: $ G ⇒ B ⊆ suc B $ by suc_subset
l2: $ G ⇒ A ∈ suc B $ by wcel_subset [l1, #1]

