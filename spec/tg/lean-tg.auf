l3: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bxor a_v b_v c_v ∈ lrel) $ by y1_e_bxor_10 [l6, l7]
l9: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bxor a_v b_v c_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_bxor y z u) ∅ , ra_bxor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bxor a_v b_v c_v ∈ lrel) $ by ex_elim [l11, l10]
