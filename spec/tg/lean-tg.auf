lemma y1_p_rtail (G: hyps): $ G ⇒ pr_rtail ⊆ y1_lab kr_rtail (suc kr_rtail) $
----
l1: $ G ⇒ cl_rtail_srt ⊆ y1_lab kr_rtail (suc kr_rtail) $ by y1_k_rtail_srt
l2: $ G ⇒ cl_rtail_pi ⊆ y1_lab kr_rtail (suc kr_rtail) $ by y1_k_rtail_pi
l3: $ G ⇒ pr_rtail ⊆ y1_lab kr_rtail (suc kr_rtail) $ by cun_least [l2, l1]

lemma y1_k_rec_ty_i (G: hyps): $ G ⇒ cl_rec_ty_i ⊆ y1_lab kr_rec_ty (suc kr_rec_ty) $
----
l1: $ G , x ∊ cl_rec_ty_i ⇒ x ∊ cl_rec_ty_i $ by ax
l2: $ G , x ∊ cl_rec_ty_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_motives y b w ⟨ kc_nz , ∅ ⟩ v i) (scons (ra_minors y b c ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v j) (scons (ra_nth_ty v a k n) (scons (ra_add f c g) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ k d) (scons (ra_rtail y b c f a ⟨ kc_nz , ∅ ⟩ d e) (scons (ra_pis j e h) (scons (ra_pis i h l) (scons (ra_pis u l m) ∅))))))))))) , ra_rec_ty y w a m ⟩) $ by cab_elim [l1]
