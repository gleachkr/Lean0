l4: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩ ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by y1_e_bxor_00 [l6, l7]
l9: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_bxor y z u) (scons (ra_bdbl u v) ∅) , ra_bxor ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_bxor t1 t2 t3 ⟩ , x ∊ cl_bxor_00 ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bxor a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_e_bxor_01 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_bxor t1 t2 t3 ⟩ = ⟨ scons (ra_bxor V1 V2 V3) ∅ , ra_bxor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bxor a_v b_v c_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bxor V1 V2 V3) ∅ , ra_bxor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_bxor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_bxor V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bxor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bxor ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩) $ by opair_isset
