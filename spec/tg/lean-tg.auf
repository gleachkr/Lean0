l7: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_s , w = ⟨ scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ , ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_s , w = ⟨ scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ , ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ⟩ ⇒ isset (ra_pargs q1 q2 q3 q4) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_s , w = ⟨ scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ , ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
