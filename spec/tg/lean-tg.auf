l13: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) ∅) , ra_bmul y ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) ∅) , ra_bmul y ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) ∅) , ra_bmul y ⟨ kc_bd0 , scons z ∅ ⟩ v ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = a_v ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x ∊ cl_bmul_d0 ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = a_v ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = a_v ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_e_bmul_d1 (G: hyps) {a_v b_v c_v d_v e_v: set} (pp t1 t2 t3 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ = ⟨ scons (ra_bmul V1 V2 V3) (scons (ra_bdbl V3 V4) (scons (ra_badd V4 V1 V5) ∅)) , ra_bmul V1 ⟨ kc_bd1 , scons V2 ∅ ⟩ V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bmul V1 V2 V3) (scons (ra_bdbl V3 V4) (scons (ra_badd V4 V1 V5) ∅)) , ra_bmul V1 ⟨ kc_bd1 , scons V2 ∅ ⟩ V5 ⟩ = ⟨ pp , ra_bmul t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_bmul V1 V2 V3) (scons (ra_bdbl V3 V4) (scons (ra_badd V4 V1 V5) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bmul t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bmul V1 ⟨ kc_bd1 , scons V2 ∅ ⟩ V5) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_bmul V1 V2 V3) (scons (ra_bdbl V3 V4) (scons (ra_badd V4 V1 V5) ∅)) ∧ ra_bmul t1 t2 t3 = ra_bmul V1 ⟨ kc_bd1 , scons V2 ∅ ⟩ V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_bmul V1 V2 V3) (scons (ra_bdbl V3 V4) (scons (ra_badd V4 V1 V5) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_bmul t1 t2 t3 = ra_bmul V1 ⟨ kc_bd1 , scons V2 ∅ ⟩ V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V5 $ by isset_var
l17: $ G ⇒ scons V5 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_bd1 , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V5 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V5 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_bmul ∈ ω $ by x1_kr_bmul
l23: $ G ⇒ isset kr_bmul $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V5 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_bmul = kr_bmul ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V5 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V5 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V5 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons V5 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons V5 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V5 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V5 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V5 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_bmul V1 V2 V3) (scons (ra_bdbl V3 V4) (scons (ra_badd V4 V1 V5) ∅))) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_bmul V1 V2 V3) (scons (ra_bdbl V3 V4) (scons (ra_badd V4 V1 V5) ∅))) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_bmul V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_bmul V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_bdbl V3 V4) (scons (ra_badd V4 V1 V5) ∅)) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_bdbl V3 V4) $ by opair_isset
l42: $ G ⇒ ra_bdbl V3 V4 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ crn (scons (ra_badd V4 V1 V5) ∅) ⊆ lrel $ by crn_scons_tail [l40]
l44: $ G ⇒ isset (ra_badd V4 V1 V5) $ by opair_isset
l45: $ G ⇒ ra_badd V4 V1 V5 ∈ lrel $ by crn_scons_head [l44, l43]
l46: $ G ⇒ ra_bdbl V3 V4 ∈ lrel ∧ ra_badd V4 V1 V5 ∈ lrel $ by and_intro [l42, l45]
l47: $ G ⇒ ra_bmul V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel ∧ ra_badd V4 V1 V5 ∈ lrel $ by and_intro [l39, l46]
l48: $ G ⇒ t3 = V5 ∧ ra_bmul V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel ∧ ra_badd V4 V1 V5 ∈ lrel $ by and_intro [l35, l47]
l49: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = V5 ∧ ra_bmul V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel ∧ ra_badd V4 V1 V5 ∈ lrel $ by and_intro [l32, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = V5 ∧ ra_bmul V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel ∧ ra_badd V4 V1 V5 ∈ lrel $ by and_intro [l29, l49]
l51: $ G ⇒ ∃ e_v (t1 = V1 ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 V4 ∈ lrel ∧ ra_badd V4 V1 e_v ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ d_v ∃ e_v (t1 = V1 ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul V1 V2 V3 ∈ lrel ∧ ra_bdbl V3 d_v ∈ lrel ∧ ra_badd d_v V1 e_v ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ c_v ∃ d_v ∃ e_v (t1 = V1 ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul V1 V2 c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v V1 e_v ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = V1 ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul V1 b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v V1 e_v ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $ by ex_intro [l54]

lemma y1_d_bmul_d1 (G: hyps) {a_v b_v c_v d_v e_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ ∈ cl_bmul_d1 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x ∊ cl_bmul_d1 ⇒ x ∊ cl_bmul_d1 $ by ax
l2: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x ∊ cl_bmul_d1 ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩ ⇒ x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩ ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩ ⇒ x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩ ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩ ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $ by y1_e_bmul_d1 [l6, l7]
l9: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) ⇒ ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_bmul y z u) (scons (ra_bdbl u v) (scons (ra_badd v y w) ∅)) , ra_bmul y ⟨ kc_bd1 , scons z ∅ ⟩ w ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_bmul t1 t2 t3 ⟩ , x ∊ cl_bmul_d1 ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $ by wcel_elim [#1, l17]

lemma y1_o_bmul (G: hyps) {a_v b_v c_v d_v e_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ ∈ pr_bmul $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = a_v ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_bmul t1 t2 t3 ⟩ ∈ cl_bmul_d1 ⇒ ⟨ pp , ra_bmul t1 t2 t3 ⟩ ∈ cl_bmul_d1 $ by ax
