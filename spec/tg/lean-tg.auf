l1: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil ⇒ w ∊ cl_ntys_nil $ by ax
l2: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil ⇒ w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil , w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_ntys q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil , w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil , w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_ntys q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil , w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_ntys q1 q2 q3 ⟩ = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil , w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil , w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_ntys q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil , w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_nil , w = ⟨ ∅ , ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_ntys ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
