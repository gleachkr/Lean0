l46: $ G ⇒ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2 ∈ lrel $ by and_intro [l41, l45]
l47: $ G ⇒ t3 = V3 ∧ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2 ∈ lrel $ by and_intro [l38, l46]
l48: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2 ∈ lrel $ by and_intro [l35, l47]
l49: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2 ∈ lrel $ by and_intro [l32, l48]
l50: $ G ⇒ ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ V2 ∈ lrel) $ by ex_intro [l49]
l51: $ G ⇒ ∃ m_v ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V1 ∅ ⟩ m_v ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by ex_intro [l51]

lemma y1_d_lsubst_gt (G: hyps) {n_v m_v a_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_gt ⇒ x ∊ cl_lsubst_gt $ by ax
l2: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_gt ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩ ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by y1_e_lsubst_gt [l6, l7]
l9: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons y ∅ ⟩ z) ∅ , ra_lsubst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟨ kc_lparam , scons z ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ , x ∊ cl_lsubst_gt ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_lsubst (G: hyps) {n_v a_v b_v b2 c_v c2 m_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ pr_lsubst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) ∨ ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) ∨ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) ∨ ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) ∨ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) ∨ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) ∨ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt $ by ax
l2: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by y1_d_lsubst_gt [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt → ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∪ cl_lsubst_gt ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∪ cl_lsubst_gt $ by ax
l6: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∪ cl_lsubst_gt ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∨ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∪ cl_lsubst_gt , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt $ by ax
l8: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∪ cl_lsubst_gt , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∪ cl_lsubst_gt , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) $ by y1_d_lsubst_lt [l7, l8]
l10: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∪ cl_lsubst_gt , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ⇒ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) ∨ ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_lt ∪ cl_lsubst_gt , ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt ⇒ ⟨ pp , ra_lsubst t1 t2 t3 t4 ⟩ ∈ cl_lsubst_gt $ by ax
