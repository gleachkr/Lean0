l40: $ G ⇒ crn (scons (ra_clen_c V2 V6) (scons (ra_add V5 V6 V7) ∅)) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_clen_c V2 V6) $ by opair_isset
