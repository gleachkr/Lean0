lemma y2_npis_e3 (GG: hyps) (q1 q2 w2 u_A u_B u_n v_A v_B v_n: set):
  $ GG ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ > $ GG ⇒ ra_npis u_B u_n ∈ lrel $ > $ GG ⇒ ra_npis u_B u_n ∈ y2_P_npis lrel $ > $ GG ⇒ q1 = ⟨ kc_pi , scons v_A (scons v_B ∅) ⟩ $ > $ GG ⇒ w2 = ⟨ kc_s , scons v_n ∅ ⟩ $ > $ GG ⇒ ra_npis v_B v_n ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ = ⟨ kc_pi , scons v_A (scons v_B ∅) ⟩ $ by eq_trans [l1, #5]
l3: $ GG ⇒ kc_pi ∈ ω $ by v1_kc_pi
l4: $ GG ⇒ isset kc_pi $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_A $ by isset_var
l6: $ GG ⇒ isset u_B $ by isset_var
l7: $ GG ⇒ isset v_A $ by isset_var
l8: $ GG ⇒ isset v_B $ by isset_var
l9: $ GG ⇒ u_A = v_A ∧ u_B = v_B $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_A = v_A $ by and_elim_l [l9]
l11: $ GG ⇒ u_B = v_B $ by and_elim_r [l9]
l12: $ GG ⇒ v_B = u_B $ by eq_sym [l11]
l13: $ GG ⇒ v_n = v_n $ by eq_refl
l14: $ GG ⇒ ra_npis u_B v_n ∈ lrel $ by x1_eq_npis [#7, l12, l13]
l15: $ GG ⇒ isset u_B $ by isset_var
l16: $ GG ⇒ isset u_n $ by isset_var
l17: $ GG ⇒ isset v_n $ by isset_var
l18: $ GG ⇒ u_n = v_n $ by y2_npis_ihc [l15, l16, l17, #4, l14]
l19: $ GG ⇒ ∅ = ∅ $ by eq_refl
l20: $ GG ⇒ scons u_n ∅ = scons v_n ∅ $ by scons_eq [l18, l19]
l21: $ GG ⇒ kc_s = kc_s $ by eq_refl
l22: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = ⟨ kc_s , scons v_n ∅ ⟩ $ by opair_eq [l21, l20]
l23: $ GG ⇒ ⟨ kc_s , scons v_n ∅ ⟩ = w2 $ by eq_sym [#6]
l24: $ GG ⇒ q2 = ⟨ kc_s , scons v_n ∅ ⟩ $ by eq_trans [#2, l22]
l25: $ GG ⇒ q2 = w2 $ by eq_trans [l24, l23]

lemma y2_npis_c3 (GG: hyps) (q1 q2 w2 u_A u_B u_n: set):
  $ GG ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ > $ GG ⇒ ra_npis q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by lrel_npis_cases [#2]
l2: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis u_B u_n ∈ lrel $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_bvar , scons a ∅ ⟩ $ by and_elim_l [l2]
l11: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l12: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_bvar ∈ kc_pi $ by y2_lt_bvar_pi
l13: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_pi ∈ ω $ by v1_kc_pi
l14: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_pi $ by wcel_isset [l13]
l15: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⊥ $ by y2_ne [l10, l4, l12, l14]
l16: $ GG , q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by bot_elim [l15]
l17: $ GG , ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l18: $ GG , ∃ a (q1 = ⟨ kc_bvar , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l17, l16]
l19: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l20: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by weaken [#1]
l21: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ $ by and_elim_l [l20]
l22: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l20]
l23: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l22]
l24: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l22]
l25: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis u_B u_n ∈ lrel $ by and_elim_l [l24]
l26: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l24]
l27: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ $ by and_elim_l [l19]
l28: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l19]
l29: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_app ∈ kc_pi $ by y2_lt_app_pi
l30: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_pi ∈ ω $ by v1_kc_pi
l31: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_pi $ by wcel_isset [l30]
l32: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⊥ $ by y2_ne [l27, l21, l29, l31]
l33: $ GG , q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by bot_elim [l32]
l34: $ GG , ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l35: $ GG , ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l34, l33]
l36: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) $ by ax
l37: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l36, l35]
l38: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel $ by ax
l39: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by weaken [#1]
l40: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q1 = ⟨ kc_pi , scons u_A (scons u_B ∅) ⟩ $ by and_elim_l [l39]
l41: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l39]
l42: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l41]
l43: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ ra_npis u_B u_n ∈ lrel ∧ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l41]
l44: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ ra_npis u_B u_n ∈ lrel $ by and_elim_l [l43]
l45: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ ra_npis u_B u_n ∈ y2_P_npis lrel $ by and_elim_r [l43]
l46: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ $ by and_elim_l [l38]
l47: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel $ by and_elim_r [l38]
l48: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ w2 = ⟨ kc_s , scons g ∅ ⟩ $ by and_elim_l [l47]
l49: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ ra_npis f g ∈ lrel $ by and_elim_r [l47]
l50: $ GG , q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel ⇒ q2 = w2 $ by y2_npis_e3 [l40, l42, l44, l45, l46, l48, l49]
l51: $ GG , ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l52: $ GG , ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l51, l50]
l53: $ GG , ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l54: $ GG , ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l53, l52]
l55: $ GG , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l56: $ GG , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l55, l54]
l57: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) $ by ax
l58: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ⇒ q2 = w2 $ by weaken [l37]
l59: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) , ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by weaken [l56]
l60: $ GG , ∃ b ∃ d (q1 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ e ∃ f ∃ g (q1 = ⟨ kc_pi , scons e (scons f ∅) ⟩ ∧ w2 = ⟨ kc_s , scons g ∅ ⟩ ∧ ra_npis f g ∈ lrel) ⇒ q2 = w2 $ by or_elim [l57, l58, l59]
l61: $ GG ⇒ q2 = w2 $ by or_elim [l1, l18, l60]

lemma y2_npis_d3 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_npis q1 q2 ⟩ ∈ cl_npis_pi $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ > $ GG ⇒ ra_npis q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis b d ∈ lrel ∧ ra_npis b d ∈ y2_P_npis lrel ⇒ q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis b d ∈ lrel ∧ ra_npis b d ∈ y2_P_npis lrel $ by ax
l2: $ GG , q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis b d ∈ lrel ∧ ra_npis b d ∈ y2_P_npis lrel ⇒ ra_npis q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis b d ∈ lrel ∧ ra_npis b d ∈ y2_P_npis lrel ⇒ q2 = w2 $ by y2_npis_c3 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis b d ∈ lrel ∧ ra_npis b d ∈ y2_P_npis lrel → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ d (q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis b d ∈ lrel ∧ ra_npis b d ∈ y2_P_npis lrel → q2 = w2) $ by all_intro [l4]
l6: $ GG ⇒ ∀ b ∀ d (q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis b d ∈ lrel ∧ ra_npis b d ∈ y2_P_npis lrel → q2 = w2) $ by all_intro [l5]
l7: $ GG ⇒ ∀ a ∀ b ∀ d (q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_npis b d ∈ lrel ∧ ra_npis b d ∈ y2_P_npis lrel → q2 = w2) $ by all_intro [l6]
l8: $ GG ⇒ q2 = w2 $ by y2_npis_i3 [#1, #2, l7]

lemma y2_npis_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_npis lrel → c ∊ y2_P_npis lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ c = ra_npis x1 x2 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_npis x1 x2 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ ⟨ o , ra_npis x1 x2 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ ⟨ o , ra_npis x1 x2 ⟩ ∈ pr_npis $ by lprog_npis_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ ra_npis x1 x6 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_bvar ⇒ ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_bvar $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_bvar ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_bvar ⇒ ra_npis x1 x6 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_bvar ⇒ x2 = x6 $ by y2_npis_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_app ⇒ ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_app $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_app ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_app ⇒ ra_npis x1 x6 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_app ⇒ x2 = x6 $ by y2_npis_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_pi ⇒ ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_pi $ by ax
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_pi ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel $ by weaken [l7]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_pi ⇒ ra_npis x1 x6 ∈ lrel $ by weaken [l8]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel , ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_pi ⇒ x2 = x6 $ by y2_npis_d3 [l17, l18, l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_pi → x2 = x6 $ by imp_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi → x2 = x6 $ by v1_cun_imp [l16, l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ ⟨ o , ra_npis x1 x2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) → x2 = x6 $ by v1_cun_imp [l12, l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 , ra_npis x1 x6 ∈ lrel ⇒ x2 = x6 $ by imp_elim [l23, l6]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 ⇒ ra_npis x1 x6 ∈ lrel → x2 = x6 $ by imp_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel , c = ra_npis x1 x2 ⇒ ∀ x6 (⟨ kr_npis , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6) $ by all_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel ⇒ c = ⟨ kr_npis , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_npis , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6) $ by imp_intro [l26]
l28: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel ⇒ ∀ x2 (c = ⟨ kr_npis , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_npis , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_intro [l27]
l29: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel ⇒ ∀ x1 ∀ x2 (c = ⟨ kr_npis , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_npis , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_intro [l28]
l30: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_npis lrel ⇒ c ∊ y2_P_npis lrel $ by cab_intro [l29]
l31: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_npis lrel → c ∊ y2_P_npis lrel $ by imp_intro [l30]
l32: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_npis lrel → c ∊ y2_P_npis lrel $ by imp_intro [l31]
l33: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_npis lrel → c ∊ y2_P_npis lrel) $ by all_intro [l32]
l34: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_npis lrel → c ∊ y2_P_npis lrel) $ by all_intro [l33]

lemma y2_npis_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_npis lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_npis lrel → c ∊ y2_P_npis lrel) $ by y2_npis_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_npis lrel $ by horn_ind [l1, l2]

lrel_npis_det
-------------
l1: $ G ⇒ horn lprog ⊆ y2_P_npis lrel $ by y2_npis_in
l2: $ G ⇒ ra_npis t1 u2 ∈ y2_P_npis lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u2 = v2 $ by y2_npis_ih [l2, #2]

--| The atoms of `isort` whose variants in `L` with the same inputs have the same outputs.
def y2_P_isort (L: class) (.c .x1 .x2 .x3 .x6 .x7: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_isort , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ L → x2 = x6 ∧ x3 = x7))} $

lemma y2_isort_ih (GG: hyps) (q1 q2 q3 w2 w3: set):
  $ GG ⇒ ra_isort q1 q2 q3 ∈ y2_P_isort lrel $ > $ GG ⇒ ra_isort q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ c ∊ y2_P_isort lrel $ by ax
l2: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_isort , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by cab_elim [l1]
l3: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_isort , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons q1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by all_elim [l2]
l4: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ ∀ x3 (c = ⟨ kr_isort , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons q1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → q2 = x6 ∧ x3 = x7)) $ by all_elim [l3]
l5: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ c = ⟨ kr_isort , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons q1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → q2 = x6 ∧ q3 = x7) $ by all_elim [l4]
l6: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ c = ra_isort q1 q2 q3 $ by ax
l7: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ ∀ x6 ∀ x7 (⟨ kr_isort , scons q1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → q2 = x6 ∧ q3 = x7) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ ∀ x7 (⟨ kr_isort , scons q1 (scons w2 (scons x7 ∅)) ⟩ ∈ lrel → q2 = w2 ∧ q3 = x7) $ by all_elim [l7]
l9: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ ra_isort q1 w2 w3 ∈ lrel → q2 = w2 ∧ q3 = w3 $ by all_elim [l8]
l10: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ ra_isort q1 w2 w3 ∈ lrel $ by weaken [#2]
l11: $ GG , c = ra_isort q1 q2 q3 , c ∊ y2_P_isort lrel ⇒ q2 = w2 ∧ q3 = w3 $ by imp_elim [l9, l10]
l12: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by wcel_elim [#1, l11]

lemma y2_isort_ihc (GG: hyps) (Q1 Q2 Q3 W2 W3: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset W2 $ > $ GG ⇒ isset W3 $ > $ GG ⇒ ra_isort Q1 Q2 Q3 ∈ y2_P_isort lrel $ > $ GG ⇒ ra_isort Q1 W2 W3 ∈ lrel $ > $ GG ⇒ Q2 = W2 ∧ Q3 = W3 $
----
l1: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ d = Q3 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ e = W2 $ by ax
l5: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ f = W3 $ by ax
l6: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ Q1 = a $ by eq_sym [l1]
l7: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ Q2 = b $ by eq_sym [l2]
l8: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ Q3 = d $ by eq_sym [l3]
l9: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ W2 = e $ by eq_sym [l4]
l10: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ W3 = f $ by eq_sym [l5]
l11: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ∅ = ∅ $ by eq_refl
l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ scons Q3 ∅ = scons d ∅ $ by scons_eq [l8, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ scons Q2 (scons Q3 ∅) = scons b (scons d ∅) $ by scons_eq [l7, l12]
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ scons Q1 (scons Q2 (scons Q3 ∅)) = scons a (scons b (scons d ∅)) $ by scons_eq [l6, l13]
l15: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ kr_isort = kr_isort $ by eq_refl
l16: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_isort Q1 Q2 Q3 = ra_isort a b d $ by opair_eq [l15, l14]
l17: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_isort Q1 Q2 Q3 ∈ y2_P_isort lrel $ by weaken [#6]
l18: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_isort a b d ∈ y2_P_isort lrel $ by wcel_eq_l [l16, l17]
l19: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_isort Q1 W2 W3 ∈ lrel $ by weaken [#7]
l20: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ ra_isort a e f ∈ lrel $ by x1_eq_isort [l19, l6, l9, l10]
l21: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ b = e ∧ d = f $ by y2_isort_ih [l18, l20]
l22: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ b = e $ by and_elim_l [l21]
l23: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ d = f $ by and_elim_r [l21]
l24: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ Q2 = e $ by eq_trans [l7, l22]
l25: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ Q2 = W2 $ by eq_trans [l24, l4]
l26: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ Q3 = f $ by eq_trans [l8, l23]
l27: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ Q3 = W3 $ by eq_trans [l26, l5]
l28: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 , f = W3 ⇒ Q2 = W2 ∧ Q3 = W3 $ by and_intro [l25, l27]
l29: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W2 ⇒ Q2 = W2 ∧ Q3 = W3 $ by isset_elim [#5, l28]
l30: $ GG , a = Q1 , b = Q2 , d = Q3 ⇒ Q2 = W2 ∧ Q3 = W3 $ by isset_elim [#4, l29]
l31: $ GG , a = Q1 , b = Q2 ⇒ Q2 = W2 ∧ Q3 = W3 $ by isset_elim [#3, l30]
l32: $ GG , a = Q1 ⇒ Q2 = W2 ∧ Q3 = W3 $ by isset_elim [#2, l31]
l33: $ GG ⇒ Q2 = W2 ∧ Q3 = W3 $ by isset_elim [#1, l32]

lemma y2_isort_i1 (GG: hyps) {l: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_isort q1 q2 q3 ⟩ ∈ cl_isort_srt $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_isort lrel $ > $ GG ⇒ ∀ l (q1 = ⟨ kc_srt , scons l ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = l → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt ⇒ w ∊ cl_isort_srt $ by ax
l2: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt ⇒ ∃ l (w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ w = ⟨ o , ra_isort q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ ⟨ o , ra_isort q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ ⟨ o , ra_isort q1 q2 q3 ⟩ = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset (ra_isort q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset (ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ o = ∅ ∧ ra_isort q1 q2 q3 = ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ ⟨ kr_isort , scons q1 (scons q2 (scons q3 ∅)) ⟩ = ⟨ kr_isort , scons ⟨ kc_srt , scons l ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons l ∅)) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ kr_isort ∈ ω $ by x1_kr_isort
l15: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset kr_isort $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset q3 $ by isset_var
l19: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset ⟨ kc_srt , scons l ∅ ⟩ $ by opair_isset
l20: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l21: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ isset l $ by isset_var
l22: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ q1 = ⟨ kc_srt , scons l ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = l $ by y2_nd3 [l13, l15, l16, l17, l18, l19, l20, l21]
l23: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ q1 = ⟨ kc_srt , scons l ∅ ⟩ $ by and_elim_l [l22]
l24: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = l $ by and_elim_r [l22]
l25: $ GG , w = ⟨ o , ra_isort q1 q2 q3 ⟩ , w ∊ cl_isort_srt , w = ⟨ ∅ , ra_isort ⟨ kc_srt , scons l ∅ ⟩ ⟨ kc_nz , ∅ ⟩ l ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l24]
