l34: $ G , c = kc_tcons ∧ a = scons ks_expr (scons ks_ctors (scons ks_tys ∅)) ⇒ ∃ x ∃ y ∃ u (t = ⟨ kc_tcons , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors ∧ u ∊ ofsort lsig lopen ks_tys) $ by v1_build3 [l22, l24, l26, #3, #4, #5, #6]
l35: $ G , c = kc_tcons ∧ a = scons ks_expr (scons ks_ctors (scons ks_tys ∅)) ⇒ (∃ x ∃ y ∃ u (t = ⟨ kc_tcons , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors ∧ u ∊ ofsort lsig lopen ks_tys)) → v1_d_tys u x y t $ by weaken [l30]
l36: $ G , c = kc_tcons ∧ a = scons ks_expr (scons ks_ctors (scons ks_tys ∅)) ⇒ v1_d_tys u x y t $ by imp_elim [l35, l34]
