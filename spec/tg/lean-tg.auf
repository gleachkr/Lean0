lemma y1_k_rwalk_pi_rec (G: hyps): $ G ⇒ cl_rwalk_pi_rec ⊆ y1_lab kr_rwalk (suc kr_rwalk) $
----
l1: $ G , x ∊ cl_rwalk_pi_rec ⇒ x ∊ cl_rwalk_pi_rec $ by ax
l2: $ G , x ∊ cl_rwalk_pi_rec ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o (x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ ⇒ kr_rwalk ∈ ω $ by x1_kr_rwalk
