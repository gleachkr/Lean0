lemma y1_k_mty_pi (G: hyps): $ G ⇒ cl_mty_pi ⊆ y1_lab kr_mty (suc kr_mty) $
----
l1: $ G , x ∊ cl_mty_pi ⇒ x ∊ cl_mty_pi $ by ax
l2: $ G , x ∊ cl_mty_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ⇒ kr_mty ∈ ω $ by x1_kr_mty
l5: $ G , x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l6, l5]
l8: $ G , ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l8, l7]
l10: $ G , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l10, l9]
l12: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l12, l11]
l14: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by ax
l15: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l14, l13]
l16: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by ax
l17: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l16, l15]
l18: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) $ by ax
l19: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l18, l17]
l20: $ G , x ∊ cl_mty_pi ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l2, l19]
l21: $ G ⇒ cl_mty_pi ⊆ y1_lab kr_mty (suc kr_mty) $ by subset_intro [l20]

lemma y1_k_mty_srt (G: hyps): $ G ⇒ cl_mty_srt ⊆ y1_lab kr_mty (suc kr_mty) $
----
l1: $ G , x ∊ cl_mty_srt ⇒ x ∊ cl_mty_srt $ by ax
l2: $ G , x ∊ cl_mty_srt ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ kr_mty ∈ ω $ by x1_kr_mty
l5: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l6, l5]
l8: $ G , ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l8, l7]
l10: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l10, l9]
l12: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l12, l11]
l14: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l15: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l14, l13]
l16: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l17: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l16, l15]
l18: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l19: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l18, l17]
l20: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l21: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l20, l19]
l22: $ G , x ∊ cl_mty_srt ⇒ x ∊ y1_lab kr_mty (suc kr_mty) $ by ex_elim [l2, l21]
l23: $ G ⇒ cl_mty_srt ⊆ y1_lab kr_mty (suc kr_mty) $ by subset_intro [l22]

lemma y1_p_mty (G: hyps): $ G ⇒ pr_mty ⊆ y1_lab kr_mty (suc kr_mty) $
----
l1: $ G ⇒ cl_mty_srt ⊆ y1_lab kr_mty (suc kr_mty) $ by y1_k_mty_srt
l2: $ G ⇒ cl_mty_pi ⊆ y1_lab kr_mty (suc kr_mty) $ by y1_k_mty_pi
l3: $ G ⇒ pr_mty ⊆ y1_lab kr_mty (suc kr_mty) $ by cun_least [l2, l1]

lemma y1_k_motives_nil (G: hyps): $ G ⇒ cl_motives_nil ⊆ y1_lab kr_motives (suc kr_motives) $
----
l1: $ G , x ∊ cl_motives_nil ⇒ x ∊ cl_motives_nil $ by ax
l2: $ G , x ∊ cl_motives_nil ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ kr_motives ∈ ω $ by x1_kr_motives
l5: $ G , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_motives (suc kr_motives) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_motives (suc kr_motives) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_motives (suc kr_motives) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_motives (suc kr_motives) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_motives_nil ⇒ x ∊ y1_lab kr_motives (suc kr_motives) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_motives_nil ⊆ y1_lab kr_motives (suc kr_motives) $ by subset_intro [l12]

lemma y1_k_motives_cons (G: hyps): $ G ⇒ cl_motives_cons ⊆ y1_lab kr_motives (suc kr_motives) $
----
l1: $ G , x ∊ cl_motives_cons ⇒ x ∊ cl_motives_cons $ by ax
l2: $ G , x ∊ cl_motives_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ kr_motives ∈ ω $ by x1_kr_motives
l5: $ G , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ x ∊ y1_lab kr_motives (suc kr_motives) $ by y1_lab_self [l3, l4]
