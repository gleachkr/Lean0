l39: $ GG , ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l38, l37]
l40: $ GG ⇒ q3 = w3 $ by or_elim [l1, l14, l39]

lemma y2_ndecl_d1 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_ndecl q1 q2 q3 ⟩ ∈ cl_ndecl_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel $ > $ GG ⇒ ra_ndecl q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a $ by ax
l2: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a ⇒ ra_ndecl q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a ⇒ q3 = w3 $ by y2_ndecl_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ q3 = a → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ q3 = w3 $ by y2_ndecl_i1 [#1, #2, l5]

lemma y2_ndecl_i2 (GG: hyps) {X N n n0: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_ndecl q1 q2 q3 ⟩ ∈ cl_ndecl_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel $ > $ GG ⇒ ∀ X ∀ N ∀ n ∀ n0 (q1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ q3 = n0 ∧ ra_ndecl N n n0 ∈ lrel ∧ ra_ndecl N n n0 ∈ y2_P_ndecl lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons ⇒ w ∊ cl_ndecl_cons $ by ax
l2: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons ⇒ ∃ X ∃ N ∃ n ∃ n0 (w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ ⟨ o , ra_ndecl q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ ⟨ o , ra_ndecl q1 q2 q3 ⟩ = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset (ra_ndecl q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset (ra_ndecl N n n0) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ scons (ra_ndecl N n n0) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset (scons (ra_ndecl N n n0) ∅) $ by y2_fs_set [l11]
l13: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset (ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0) $ by opair_isset
l14: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ o = scons (ra_ndecl N n n0) ∅ ∧ ra_ndecl q1 q2 q3 = ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 $ by opair_inj_c [l6, l7, l8, l12, l13]
l15: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ o = scons (ra_ndecl N n n0) ∅ $ by and_elim_l [l14]
l16: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ ⟨ kr_ndecl , scons q1 (scons q2 (scons q3 ∅)) ⟩ = ⟨ kr_ndecl , scons ⟨ kc_cons , scons X (scons N ∅) ⟩ (scons ⟨ kc_s , scons n ∅ ⟩ (scons n0 ∅)) ⟩ $ by and_elim_r [l14]
l17: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ kr_ndecl ∈ ω $ by x1_kr_ndecl
l18: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset kr_ndecl $ by wcel_isset [l17]
l19: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset q1 $ by isset_var
l20: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset q2 $ by isset_var
l21: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset q3 $ by isset_var
l22: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset ⟨ kc_cons , scons X (scons N ∅) ⟩ $ by opair_isset
l23: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset ⟨ kc_s , scons n ∅ ⟩ $ by opair_isset
l24: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ isset n0 $ by isset_var
l25: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ q1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ q3 = n0 $ by y2_nd3 [l16, l18, l19, l20, l21, l22, l23, l24]
l26: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ q1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ $ by and_elim_l [l25]
l27: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ q3 = n0 $ by and_elim_r [l25]
l28: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ q2 = ⟨ kc_s , scons n ∅ ⟩ $ by and_elim_l [l27]
l29: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ q3 = n0 $ by and_elim_r [l27]
l30: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_cons , w = ⟨ scons (ra_ndecl N n n0) ∅ , ra_ndecl ⟨ kc_cons , scons X (scons N ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ n0 ⟩ ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel $ by weaken [#2]
