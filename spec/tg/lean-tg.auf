l59: $ G ⇒ t6 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ scons t7 ∅ = scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅ $ by y1_scons_inj [l58, l12, l26, l11, l25]
l60: $ G ⇒ t6 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ $ by and_elim_l [l59]
