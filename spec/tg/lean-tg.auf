lemma y1_d_cminors_nil (G: hyps) {D np n_v k_v i_v c_v: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cminors_nil ⇒ x ∊ cl_cminors_nil $ by ax
l2: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_cminors_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by y1_e_cminors_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ ∅ , ra_cminors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
