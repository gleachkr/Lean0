l110: $ G ⇒ ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons V1 (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = V4 ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ V1 npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ V4 na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ V1 V2 ∈ lrel ∧ ra_spine V2 V4 r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np V3 ∈ lrel ∧ ra_rehead V2 V3 r_v V4 e2 ∈ lrel) $ by ex_intro [l109]
l111: $ G ⇒ ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons V1 (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ V1 npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ V1 V2 ∈ lrel ∧ ra_spine V2 e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np V3 ∈ lrel ∧ ra_rehead V2 V3 r_v e_v e2 ∈ lrel) $ by ex_intro [l110]
l112: $ G ⇒ ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons V1 (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ V1 npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ V1 V2 ∈ lrel ∧ ra_spine V2 e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead V2 Y r_v e_v e2 ∈ lrel) $ by ex_intro [l111]
l113: $ G ⇒ ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons V1 (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ V1 npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ V1 S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) $ by ex_intro [l112]
l114: $ G ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) $ by ex_intro [l113]

lemma y1_d_nst_hit_z (G: hyps) {X S Y e_v e2 N I i_v j_v d_v np na npi r_v a_v t_v: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_nst_hit_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_nst_hit_z ⇒ x ∊ cl_nst_hit_z $ by ax
l2: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_nst_hit_z ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nst_hit t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) $ by y1_e_nst_hit_z [l6, l7]
