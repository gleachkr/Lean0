lemma y1_o_field_ty (G: hyps) {D b_v P T j_v i_v np n_v m_v F K K2 A C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ ∈ pr_field_ty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ A ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = A ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_nth_pi K2 i_v A ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ A ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = A ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_nth_pi K2 i_v A ∈ lrel) $ by y1_d_field_ty_i [#1, #2]

lemma y1_e_qinst_z (G: hyps) {b_v e_v A j_v: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ ∅ , ra_qinst V1 V2 ⟨ kc_nz , ∅ ⟩ V4 V3 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $
----
l1: $ G ⇒ ⟨ ∅ , ra_qinst V1 V2 ⟨ kc_nz , ∅ ⟩ V4 V3 V3 ⟩ = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_qinst t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_qinst V1 V2 ⟨ kc_nz , ∅ ⟩ V4 V3 V3) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_qinst t1 t2 t3 t4 t5 t6 = ra_qinst V1 V2 ⟨ kc_nz , ∅ ⟩ V4 V3 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_qinst t1 t2 t3 t4 t5 t6 = ra_qinst V1 V2 ⟨ kc_nz , ∅ ⟩ V4 V3 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V3 $ by isset_var
l23: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ scons V3 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l22, l23]
l25: $ G ⇒ isset V4 $ by isset_var
l26: $ G ⇒ scons V4 (scons V3 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l25, l24]
l27: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l28: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅))) ∈ fseq y1_vv $ by y1_fs [l27, l26]
l29: $ G ⇒ isset V2 $ by isset_var
l30: $ G ⇒ scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅)))) ∈ fseq y1_vv $ by y1_fs [l29, l28]
l31: $ G ⇒ isset V1 $ by isset_var
l32: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅))))) ∈ fseq y1_vv $ by y1_fs [l31, l30]
l33: $ G ⇒ kr_qinst ∈ ω $ by x1_kr_qinst
l34: $ G ⇒ isset kr_qinst $ by wcel_isset [l33]
l35: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l36: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅)))))) $ by wcel_isset [l32]
l37: $ G ⇒ kr_qinst = kr_qinst ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅))))) $ by opair_inj_c [l8, l34, l35, l34, l36]
l38: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅))))) $ by and_elim_r [l37]
l39: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅)))) $ by y1_scons_inj [l38, l20, l31, l19, l30]
l40: $ G ⇒ t1 = V1 $ by and_elim_l [l39]
l41: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅)))) $ by and_elim_r [l39]
l42: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅))) $ by y1_scons_inj [l41, l18, l29, l17, l28]
l43: $ G ⇒ t2 = V2 $ by and_elim_l [l42]
l44: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V3 (scons V3 ∅))) $ by and_elim_r [l42]
l45: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V4 (scons V3 (scons V3 ∅)) $ by y1_scons_inj [l44, l16, l27, l15, l26]
l46: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l45]
l47: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V4 (scons V3 (scons V3 ∅)) $ by and_elim_r [l45]
l48: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 ∅) = scons V3 (scons V3 ∅) $ by y1_scons_inj [l47, l14, l25, l13, l24]
l49: $ G ⇒ t4 = V4 $ by and_elim_l [l48]
l50: $ G ⇒ scons t5 (scons t6 ∅) = scons V3 (scons V3 ∅) $ by and_elim_r [l48]
l51: $ G ⇒ t5 = V3 ∧ scons t6 ∅ = scons V3 ∅ $ by y1_scons_inj [l50, l12, l22, l11, l23]
l52: $ G ⇒ t5 = V3 $ by and_elim_l [l51]
l53: $ G ⇒ scons t6 ∅ = scons V3 ∅ $ by and_elim_r [l51]
l54: $ G ⇒ t6 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l53, l10, l22, l9, l9]
l55: $ G ⇒ t6 = V3 $ by and_elim_l [l54]
l56: $ G ⇒ t5 = V3 ∧ t6 = V3 $ by and_intro [l52, l55]
l57: $ G ⇒ t4 = V4 ∧ t5 = V3 ∧ t6 = V3 $ by and_intro [l49, l56]
l58: $ G ⇒ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V4 ∧ t5 = V3 ∧ t6 = V3 $ by and_intro [l46, l57]
l59: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V4 ∧ t5 = V3 ∧ t6 = V3 $ by and_intro [l43, l58]
l60: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V4 ∧ t5 = V3 ∧ t6 = V3 $ by and_intro [l40, l59]
l61: $ G ⇒ ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = V3 ∧ t6 = V3) $ by ex_intro [l60]
l62: $ G ⇒ ∃ A ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by ex_intro [l61]
l63: $ G ⇒ ∃ e_v ∃ A ∃ j_v (t1 = V1 ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by ex_intro [l62]
l64: $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by ex_intro [l63]

lemma y1_d_qinst_z (G: hyps) {b_v e_v A j_v: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $
----
l1: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_qinst_z ⇒ x ∊ cl_qinst_z $ by ax
l2: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_qinst_z ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by y1_e_qinst_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_qinst_z ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by wcel_elim [#1, l15]

lemma y1_e_qinst_s (G: hyps) {b_v e_v A A1 R k_v j_v: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4) (scons (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) ∅) , ra_qinst V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ V7 V3 V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4) (scons (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) ∅) , ra_qinst V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ V7 V3 V5 ⟩ = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4) (scons (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_qinst t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_qinst V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ V7 V3 V5) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4) (scons (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) ∅) ∧ ra_qinst t1 t2 t3 t4 t5 t6 = ra_qinst V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ V7 V3 V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4) (scons (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_qinst t1 t2 t3 t4 t5 t6 = ra_qinst V1 V2 ⟨ kc_s , scons V6 ∅ ⟩ V7 V3 V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V5 $ by isset_var
l23: $ G ⇒ scons V5 ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ isset V3 $ by isset_var
l25: $ G ⇒ scons V3 (scons V5 ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V7 $ by isset_var
l27: $ G ⇒ scons V7 (scons V3 (scons V5 ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset ⟨ kc_s , scons V6 ∅ ⟩ $ by opair_isset
l29: $ G ⇒ scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V2 $ by isset_var
l31: $ G ⇒ scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V1 $ by isset_var
l33: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_qinst ∈ ω $ by x1_kr_qinst
l35: $ G ⇒ isset kr_qinst $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l37: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅)))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_qinst = kr_qinst ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons ⟨ kc_s , scons V6 ∅ ⟩ (scons V7 (scons V3 (scons V5 ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V7 (scons V3 (scons V5 ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = ⟨ kc_s , scons V6 ∅ ⟩ $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V7 (scons V3 (scons V5 ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V7 ∧ scons t5 (scons t6 ∅) = scons V3 (scons V5 ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
l50: $ G ⇒ t4 = V7 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 (scons t6 ∅) = scons V3 (scons V5 ∅) $ by and_elim_r [l49]
l52: $ G ⇒ t5 = V3 ∧ scons t6 ∅ = scons V5 ∅ $ by y1_scons_inj [l51, l12, l24, l11, l23]
l53: $ G ⇒ t5 = V3 $ by and_elim_l [l52]
l54: $ G ⇒ scons t6 ∅ = scons V5 ∅ $ by and_elim_r [l52]
l55: $ G ⇒ t6 = V5 ∧ ∅ = ∅ $ by y1_scons_inj [l54, l10, l22, l9, l9]
l56: $ G ⇒ t6 = V5 $ by and_elim_l [l55]
l57: $ G ⇒ crn pp = crn (scons (ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4) (scons (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) ∅)) $ by crn_eq [l7]
l58: $ G ⇒ crn (scons (ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4) (scons (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) ∅)) ⊆ lrel $ by subset_eq_l [l57, #2]
l59: $ G ⇒ isset (ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4) $ by opair_isset
l60: $ G ⇒ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4 ∈ lrel $ by crn_scons_head [l59, l58]
l61: $ G ⇒ crn (scons (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) ∅) ⊆ lrel $ by crn_scons_tail [l58]
l62: $ G ⇒ isset (ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5) $ by opair_isset
l63: $ G ⇒ ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5 ∈ lrel $ by crn_scons_head [l62, l61]
l64: $ G ⇒ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5 ∈ lrel $ by and_intro [l60, l63]
l65: $ G ⇒ t6 = V5 ∧ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5 ∈ lrel $ by and_intro [l56, l64]
l66: $ G ⇒ t5 = V3 ∧ t6 = V5 ∧ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5 ∈ lrel $ by and_intro [l53, l65]
l67: $ G ⇒ t4 = V7 ∧ t5 = V3 ∧ t6 = V5 ∧ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5 ∈ lrel $ by and_intro [l50, l66]
l68: $ G ⇒ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t4 = V7 ∧ t5 = V3 ∧ t6 = V5 ∧ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5 ∈ lrel $ by and_intro [l47, l67]
l69: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t4 = V7 ∧ t5 = V3 ∧ t6 = V5 ∧ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5 ∈ lrel $ by and_intro [l44, l68]
l70: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t4 = V7 ∧ t5 = V3 ∧ t6 = V5 ∧ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons V7 (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 V6 ⟨ kc_s , scons V7 ∅ ⟩ V4 V5 ∈ lrel $ by and_intro [l41, l69]
l71: $ G ⇒ ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons V6 ∅ ⟩ ∧ t4 = j_v ∧ t5 = V3 ∧ t6 = V5 ∧ ra_inst V6 V3 ⟨ kc_proj , scons V1 (scons j_v (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 V6 ⟨ kc_s , scons j_v ∅ ⟩ V4 V5 ∈ lrel) $ by ex_intro [l70]
l72: $ G ⇒ ∃ k_v ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = V3 ∧ t6 = V5 ∧ ra_inst k_v V3 ⟨ kc_proj , scons V1 (scons j_v (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 k_v ⟨ kc_s , scons j_v ∅ ⟩ V4 V5 ∈ lrel) $ by ex_intro [l71]
l73: $ G ⇒ ∃ R ∃ k_v ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = V3 ∧ t6 = R ∧ ra_inst k_v V3 ⟨ kc_proj , scons V1 (scons j_v (scons V2 ∅)) ⟩ V4 ∈ lrel ∧ ra_qinst V1 V2 k_v ⟨ kc_s , scons j_v ∅ ⟩ V4 R ∈ lrel) $ by ex_intro [l72]
l74: $ G ⇒ ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = V3 ∧ t6 = R ∧ ra_inst k_v V3 ⟨ kc_proj , scons V1 (scons j_v (scons V2 ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst V1 V2 k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by ex_intro [l73]
l75: $ G ⇒ ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons V1 (scons j_v (scons V2 ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst V1 V2 k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by ex_intro [l74]
l76: $ G ⇒ ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = V1 ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons V1 (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst V1 e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by ex_intro [l75]
l77: $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by ex_intro [l76]

lemma y1_d_qinst_s (G: hyps) {b_v e_v A A1 R k_v j_v: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_qinst_s ⇒ x ∊ cl_qinst_s $ by ax
l2: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_qinst_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by y1_e_qinst_s [l6, l7]
