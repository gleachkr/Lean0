lemma y1_e_mwalk_pi_rec (G: hyps) {D np n_v k_v i_v c_v nf d_v r_v dp kn j_v a_v sh fld mo Ihs A A2 A3 A4 B IH Min: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19 V20 V21 V22 V23 V24: set):
  $ G ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ = ⟨ scons (ra_add V8 V2 V10) (scons (ra_recfield V1 V3 V2 V8 V18 V12) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V3 V10 V18 V19) (scons (ra_add V4 V3 V11) (scons (ra_lift V11 V8 V19 V20) (scons (ra_add V9 V7 V13) (scons (ra_add V14 V8 V13) (scons (ra_add V15 ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V14) (scons (ra_add V13 V4 V16) (scons (ra_lift V14 ⟨ kc_nz , ∅ ⟩ V20 V21) (scons (ra_ihty V1 V2 V3 V16 V15 ⟨ kc_nz , ∅ ⟩ V12 V21 V23) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ ⟨ kc_s , scons V9 ∅ ⟩ ⟨ kc_cons , scons V23 (scons V17 ∅) ⟩ V22 V24) ∅))))))))))) , ra_mwalk V1 V2 V3 V4 V5 V6 V7 V8 V9 V17 ⟨ kc_pi , scons V18 (scons V22 ∅) ⟩ ⟨ kc_pi , scons V20 (scons V24 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ j_v ∃ a_v ∃ sh ∃ fld ∃ mo ∃ Ihs ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A2 A3 ∈ lrel ∧ ra_add r_v nf a_v ∈ lrel ∧ ra_add sh d_v a_v ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_add a_v k_v mo ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihty D np n_v mo fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_s , scons r_v ∅ ⟩ ⟨ kc_cons , scons IH (scons Ihs ∅) ⟩ B Min ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V8 V2 V10) (scons (ra_recfield V1 V3 V2 V8 V18 V12) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V3 V10 V18 V19) (scons (ra_add V4 V3 V11) (scons (ra_lift V11 V8 V19 V20) (scons (ra_add V9 V7 V13) (scons (ra_add V14 V8 V13) (scons (ra_add V15 ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V14) (scons (ra_add V13 V4 V16) (scons (ra_lift V14 ⟨ kc_nz , ∅ ⟩ V20 V21) (scons (ra_ihty V1 V2 V3 V16 V15 ⟨ kc_nz , ∅ ⟩ V12 V21 V23) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ ⟨ kc_s , scons V9 ∅ ⟩ ⟨ kc_cons , scons V23 (scons V17 ∅) ⟩ V22 V24) ∅))))))))))) , ra_mwalk V1 V2 V3 V4 V5 V6 V7 V8 V9 V17 ⟨ kc_pi , scons V18 (scons V22 ∅) ⟩ ⟨ kc_pi , scons V20 (scons V24 ∅) ⟩ ⟩ = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ $ by eq_sym [#1]
