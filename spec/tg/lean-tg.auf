l102: $ G ⇒ ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors V1 np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors V1 np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by ex_intro [l101]
l103: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $ by ex_intro [l102]

lemma y1_d_minors_cons (G: hyps) {D np n_v k_v i_v nc k2 F C T M1 M2 M: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_minors_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ nc ∃ k2 ∃ F ∃ C ∃ T ∃ M1 ∃ M2 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t7 = M ∧ ra_cminors D np n_v k_v i_v ⟨ kc_nz , ∅ ⟩ C M1 ∈ lrel ∧ ra_clen_c C nc ∈ lrel ∧ ra_add k_v nc k2 ∈ lrel ∧ ra_minors D np n_v k2 ⟨ kc_s , scons i_v ∅ ⟩ T M2 ∈ lrel ∧ ra_capp M2 M1 M ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_minors_cons ⇒ x ∊ cl_minors_cons $ by ax
l2: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_minors_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k (x = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩ ⇒ x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩ ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩ ⇒ x = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩ ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩ $ by eq_trans [l4, l5]
