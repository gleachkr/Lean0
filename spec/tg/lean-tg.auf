l25: $ GG , q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel ⇒ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel $ by and_elim_r [l23]
l26: $ GG , q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel ⇒ ra_clen d f ∈ lrel $ by and_elim_l [l25]
