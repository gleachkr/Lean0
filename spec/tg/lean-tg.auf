l13: $ G , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil ∪ cl_cminors_cons , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil ∪ cl_cminors_cons , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_cons ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil ∪ cl_cminors_cons ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_cminors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_cminors_nil ∪ cl_cminors_cons → ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ K ∃ Min ∃ C ∃ M1 ∃ M (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = M ∧ ra_npis K nf ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ K Min ∈ lrel ∧ ra_cminors D np n_v ⟨ kc_s , scons k_v ∅ ⟩ i_v ⟨ kc_s , scons c_v ∅ ⟩ C M1 ∈ lrel ∧ ra_capp M1 ⟨ kc_cons , scons Min (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_minors_nil (G: hyps) {D np n_v k_v i_v: set} (pp t1 t2 t3 t4 t5 t6 t7 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ ∅ , ra_minors V1 V2 V3 V4 V5 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = ⟨ kc_tnil , ∅ ⟩ ∧ t7 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_minors V1 V2 V3 V4 V5 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_minors t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_minors t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
l5: $ G ⇒ isset (ra_minors V1 V2 V3 V4 V5 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_minors t1 t2 t3 t4 t5 t6 t7 = ra_minors V1 V2 V3 V4 V5 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_minors t1 t2 t3 t4 t5 t6 t7 = ra_minors V1 V2 V3 V4 V5 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t7 $ by isset_var
