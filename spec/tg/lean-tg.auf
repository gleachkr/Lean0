l128: $ G ⇒ ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = V1 ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons V2 (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data V1 V2 P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons V1 (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $ by ex_intro [l127]
l129: $ G ⇒ ∃ b_v ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = V1 ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons V1 (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $ by ex_intro [l128]
l130: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $ by ex_intro [l129]

lemma y1_d_proj_eq_i (G: hyps) {D b_v P X Dl T j_v i_v np n_v m_v nf k_v F K K2 res c1 maj C: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_proj_eq t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_proj_eq_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_proj_eq t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_proj_eq_i ⇒ x ∊ cl_proj_eq_i $ by ax
l2: $ G , x = ⟨ pp , ra_proj_eq t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_proj_eq_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o (x = ⟨ scons (ra_ind_data y z u a) (scons (ra_clen u f) (scons (ra_ntys a g i) (scons (ra_nth_ty a b d o) (scons (ra_nth_ctor o ⟨ kc_nz , ∅ ⟩ e) (scons (ra_npis e j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ g f e h) (scons (ra_psplit j h ⟨ kc_nil , ∅ ⟩ v l) (scons (ra_capp v u w) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons b (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ j f m) (scons (ra_pargs m ⟨ kc_nz , ∅ ⟩ j n) (scons (ra_add k ⟨ kc_s , scons c ∅ ⟩ j) ∅))))))))))) , ra_proj_eq y b c w ⟨ kc_proj , scons z (scons c (scons n ∅)) ⟩ k ⟩) $ by cab_elim [l1]
