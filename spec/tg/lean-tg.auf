l43: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o (x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_rwalk (suc kr_rwalk) $ by ex_elim [l42, l41]
l44: $ G , x ∊ cl_rwalk_pi_rec ⇒ x ∊ y1_lab kr_rwalk (suc kr_rwalk) $ by ex_elim [l2, l43]
l45: $ G ⇒ cl_rwalk_pi_rec ⊆ y1_lab kr_rwalk (suc kr_rwalk) $ by subset_intro [l44]

lemma y1_k_rwalk_res (G: hyps): $ G ⇒ cl_rwalk_res ⊆ y1_lab kr_rwalk (suc kr_rwalk) $
----
l1: $ G , x ∊ cl_rwalk_res ⇒ x ∊ cl_rwalk_res $ by ax
l2: $ G , x ∊ cl_rwalk_res ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩ ⇒ x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩ ⇒ kr_rwalk ∈ ω $ by x1_kr_rwalk
l5: $ G , x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩ ⇒ x ∊ y1_lab kr_rwalk (suc kr_rwalk) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l7: $ G , ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ x ∊ y1_lab kr_rwalk (suc kr_rwalk) $ by ex_elim [l6, l5]
l8: $ G , ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l9: $ G , ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ x ∊ y1_lab kr_rwalk (suc kr_rwalk) $ by ex_elim [l8, l7]
l10: $ G , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l11: $ G , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ x ∊ y1_lab kr_rwalk (suc kr_rwalk) $ by ex_elim [l10, l9]
l12: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) $ by ax
l13: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_npis c ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk y z u v w a a b c b ⟩) ⇒ x ∊ y1_lab kr_rwalk (suc kr_rwalk) $ by ex_elim [l12, l11]
