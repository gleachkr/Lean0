ofsort_ctx_cases
----------------
l1: $ G ⇒ ⟨ ks_ctx , t ⟩ ∈ sorted lsig lopen $ by ofsort_elim [#1]
l2: $ G ⇒ ks_ctx ∈ ω $ by v1_ks_ctx
l3: $ G ⇒ isset ks_ctx $ by wcel_isset [l2]
l4: $ G , k = ks_ctx ⇒ k = ks_ctx $ by ax
l5: $ G , k = ks_ctx ⇒ ks_ctx = k $ by eq_sym [l4]
l6: $ G , k = ks_ctx ⇒ t = t $ by eq_refl
l7: $ G , k = ks_ctx ⇒ ⟨ ks_ctx , t ⟩ = ⟨ k , t ⟩ $ by opair_eq [l5, l6]
l8: $ G , k = ks_ctx ⇒ ⟨ ks_ctx , t ⟩ ∈ sorted lsig lopen $ by weaken [l1]
l9: $ G , k = ks_ctx ⇒ ⟨ k , t ⟩ ∈ sorted lsig lopen $ by wcel_eq_l [l7, l8]
l10: $ G , k = ks_ctx ⇒ sig lsig lopen $ by lsig_sig
l11: $ G , k = ks_ctx ⇒ (∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩)) ∨ (k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩)) $ by sorted_elim [l10, l9]
l12: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by ax
l13: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ by and_elim_l [l12]
l14: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l12]
l15: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ b ∊ fseq (trees ω) $ by and_elim_l [l14]
l16: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l14]
l17: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ cdm b = cdm a $ by and_elim_l [l16]
l18: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l16]
l19: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ szip a b ⊆ sorted lsig lopen $ by and_elim_l [l18]
l20: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ t = ⟨ c , b ⟩ $ by and_elim_r [l18]
l21: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ k = ks_ctx $ by ax
l22: $ G , k = ks_ctx , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ v1_d_ctx x y t $ by v1_node_ctx [l13, l21, l15, l17, l19, l20]
l23: $ G , k = ks_ctx , ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l24: $ G , k = ks_ctx , ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_ctx x y t $ by ex_elim [l23, l22]
l25: $ G , k = ks_ctx , ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l26: $ G , k = ks_ctx , ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_ctx x y t $ by ex_elim [l25, l24]
l27: $ G , k = ks_ctx , ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l28: $ G , k = ks_ctx , ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_ctx x y t $ by ex_elim [l27, l26]
l29: $ G , k = ks_ctx , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) $ by ax
l30: $ G , k = ks_ctx , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k ∊ lopen $ by and_elim_l [l29]
l31: $ G , k = ks_ctx , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_ctx $ by ax
l32: $ G , k = ks_ctx , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ ks_ctx ∈ ks_blk $ by v1_lt_ctx_blk
l33: $ G , k = ks_ctx , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_blk → ⊥ $ by v1_ne_lt [l31, l32]
l34: $ G , k = ks_ctx , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ ks_atom ∈ ks_ctx $ by v1_lt_atom_ctx
l35: $ G , k = ks_ctx , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_atom → ⊥ $ by v1_ne_gt [l31, l34]
l36: $ G , k = ks_ctx , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ v1_d_ctx x y t $ by v1_lopen_no [l33, l35, l30]
l37: $ G , k = ks_ctx ⇒ v1_d_ctx x y t $ by or_elim [l11, l28, l36]
l38: $ G ⇒ (t = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x ∃ y (t = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $ by isset_elim [l3, l37]

--| The cases of sort `bin`.
def v1_d_bin {x: set} (t: set): fml = $ (t = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_bd0 , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) ∨ ∃ x (t = ⟨ kc_bd1 , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) $

lemma v1_node_bin (G: hyps) {x: set} (c k a b t: set):
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ > $ G ⇒ k = ks_bin $ > $ G ⇒ b ∊ fseq (trees ω) $ >
  $ G ⇒ cdm b = cdm a $ > $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G ⇒ v1_d_bin x t $
----
l1: $ G ⇒ ks_nat ∈ ks_bin $ by v1_lt_nat_bin
l2: $ G ⇒ k = ks_nat → ⊥ $ by v1_ne_gt [#2, l1]
l3: $ G ⇒ ks_lvl ∈ ks_bin $ by v1_lt_lvl_bin
l4: $ G ⇒ k = ks_lvl → ⊥ $ by v1_ne_gt [#2, l3]
l5: $ G ⇒ ks_lvls ∈ ks_bin $ by v1_lt_lvls_bin
l6: $ G ⇒ k = ks_lvls → ⊥ $ by v1_ne_gt [#2, l5]
l7: $ G ⇒ ks_expr ∈ ks_bin $ by v1_lt_expr_bin
l8: $ G ⇒ k = ks_expr → ⊥ $ by v1_ne_gt [#2, l7]
l9: $ G ⇒ ks_atom ∈ ks_bin $ by v1_lt_atom_bin
l10: $ G ⇒ k = ks_atom → ⊥ $ by v1_ne_gt [#2, l9]
l11: $ G ⇒ ks_ctx ∈ ks_bin $ by v1_lt_ctx_bin
l12: $ G ⇒ k = ks_ctx → ⊥ $ by v1_ne_gt [#2, l11]
l13: $ G ⇒ ks_bin ∈ ks_blk $ by v1_lt_bin_blk
l14: $ G ⇒ k = ks_blk → ⊥ $ by v1_ne_lt [#2, l13]
l15: $ G ⇒ ks_bin ∈ ks_ind $ by v1_lt_bin_ind
l16: $ G ⇒ k = ks_ind → ⊥ $ by v1_ne_lt [#2, l15]
l17: $ G ⇒ ks_bin ∈ ks_tys $ by v1_lt_bin_tys
l18: $ G ⇒ k = ks_tys → ⊥ $ by v1_ne_lt [#2, l17]
l19: $ G ⇒ ks_bin ∈ ks_ctors $ by v1_lt_bin_ctors
l20: $ G ⇒ k = ks_ctors → ⊥ $ by v1_ne_lt [#2, l19]
l21: $ G ⇒ ks_bin ∈ ω $ by v1_ks_bin
