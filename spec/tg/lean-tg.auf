lemma y1_f8 (G: hyps): $ G ⇒ kr_closed ⊆ kr_cinst $
----
l1: $ G ⇒ kr_closed ⊆ kr_lift $ by y1_f9
l2: $ G ⇒ kr_lift ⊆ kr_inst $ by suc_subset
l3: $ G ⇒ kr_inst ⊆ kr_cinst $ by y1_f10
l4: $ G ⇒ kr_closed ⊆ kr_inst $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_closed ⊆ kr_cinst $ by subset_trans [l4, l3]

