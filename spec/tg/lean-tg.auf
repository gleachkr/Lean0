l8: $ G , ∃ j ∃ k (x = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩) ⇒ ∃ j ∃ k (x = ⟨ scons (ra_cminors y z u v w ⟨ kc_nz , ∅ ⟩ f i) (scons (ra_clen_c f a) (scons (ra_add v a b) (scons (ra_minors y z u b ⟨ kc_s , scons w ∅ ⟩ g j) (scons (ra_capp j i k) ∅)))) , ra_minors y z u v w ⟨ kc_tcons , scons c (scons f (scons g ∅)) ⟩ k ⟩) $ by ax
