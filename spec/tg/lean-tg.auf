lemma y1_o_iota_eq (G: hyps) {D i_v c_v v_v np n_v m_v a0 ar nf X Dl res e3 e4 c1 maj Rh rhs0 rhs T: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ pr_iota_eq $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ i_v ∃ c_v ∃ v_v ∃ np ∃ n_v ∃ m_v ∃ a0 ∃ ar ∃ nf ∃ X ∃ Dl ∃ res ∃ e3 ∃ e4 ∃ c1 ∃ maj ∃ Rh ∃ rhs0 ∃ rhs ∃ T (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = v_v ∧ t5 = Dl ∧ t6 = ⟨ kc_app , scons e4 (scons maj ∅) ⟩ ∧ t7 = rhs ∧ t8 = T ∧ ra_iota_tel D v_v i_v c_v X res nf Dl ∈ lrel ∧ ra_iota_lhs D v_v i_v c_v nf res e3 c1 maj e4 T ∈ lrel ∧ ra_rec_rhs D v_v i_v c_v Rh ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_add np n_v a0 ∈ lrel ∧ ra_add a0 m_v ar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ Rh ar e3 rhs0 ∈ lrel ∧ ra_rehead c1 rhs0 nf maj rhs ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ i_v ∃ c_v ∃ v_v ∃ np ∃ n_v ∃ m_v ∃ a0 ∃ ar ∃ nf ∃ X ∃ Dl ∃ res ∃ e3 ∃ e4 ∃ c1 ∃ maj ∃ Rh ∃ rhs0 ∃ rhs ∃ T (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = v_v ∧ t5 = Dl ∧ t6 = ⟨ kc_app , scons e4 (scons maj ∅) ⟩ ∧ t7 = rhs ∧ t8 = T ∧ ra_iota_tel D v_v i_v c_v X res nf Dl ∈ lrel ∧ ra_iota_lhs D v_v i_v c_v nf res e3 c1 maj e4 T ∈ lrel ∧ ra_rec_rhs D v_v i_v c_v Rh ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_add np n_v a0 ∈ lrel ∧ ra_add a0 m_v ar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ Rh ar e3 rhs0 ∈ lrel ∧ ra_rehead c1 rhs0 nf maj rhs ∈ lrel) $ by y1_d_iota_eq_i [#1, #2]

lemma y1_e_proj_eq_i (G: hyps) {D b_v P X Dl T j_v i_v np n_v m_v nf k_v F K K2 res c1 maj C: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19 V20: set):
  $ G ⇒ ⟨ pp , ra_proj_eq t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V6) (scons (ra_clen V3 V9) (scons (ra_ntys V6 V10 V11) (scons (ra_nth_ty V6 V7 V14 V20) (scons (ra_nth_ctor V20 ⟨ kc_nz , ∅ ⟩ V15) (scons (ra_npis V15 V12) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V10 V9 V15 V16) (scons (ra_psplit V12 V16 ⟨ kc_nil , ∅ ⟩ V4 V17) (scons (ra_capp V4 V3 V5) (scons (ra_pargs ⟨ kc_ind_ctor , scons V1 (scons V7 (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ V12 V9 V18) (scons (ra_pargs V18 ⟨ kc_nz , ∅ ⟩ V12 V19) (scons (ra_add V13 ⟨ kc_s , scons V8 ∅ ⟩ V12) ∅))))))))))) , ra_proj_eq V1 V7 V8 V5 ⟨ kc_proj , scons V2 (scons V8 (scons V19 ∅)) ⟩ V13 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ X ∃ Dl ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ nf ∃ k_v ∃ F ∃ K ∃ K2 ∃ res ∃ c1 ∃ maj ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = Dl ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons maj ∅)) ⟩ ∧ t6 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_capp X P Dl ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons j_v (scons ⟨ kc_nz , ∅ ⟩ ∅)) ⟩ nf np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add k_v ⟨ kc_s , scons i_v ∅ ⟩ nf ∈ lrel) $
