l24: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app → ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by weaken [l16]
l25: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_elim [l24, l23]
l26: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by or_intro_r [l25]
l27: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by or_elim [l18, l22, l26]
l28: $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) → ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_intro [l27]
l29: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_elim [l28, #1]

lemma y1_e_recfield_pi (G: hyps) {D n_v np d_v j_v A B: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5) ∅ , ra_recfield V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5) ∅ , ra_recfield V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ V5 ⟩ = ⟨ pp , ra_recfield t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_recfield V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 V5) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
