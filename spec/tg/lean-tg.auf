l6: $ G , ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z w a) ∅ , ra_lift y z ⟨ kc_proj , scons u (scons v (scons w ∅)) ⟩ ⟨ kc_proj , scons u (scons v (scons a ∅)) ⟩ ⟩) $ by ax
