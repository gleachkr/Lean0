l10: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by ex_elim [l9, l8]
