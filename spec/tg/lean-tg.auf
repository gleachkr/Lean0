lemma y1_p_indapp (G: hyps): $ G ⇒ pr_indapp ⊆ y1_lab kr_indapp (suc kr_indapp) $
----
l1: $ G ⇒ pr_indapp ⊆ y1_lab kr_indapp (suc kr_indapp) $ by y1_k_indapp_i

lemma y1_k_ipos_closed (G: hyps): $ G ⇒ cl_ipos_closed ⊆ y1_lab kr_ipos (suc kr_ipos) $
----
l1: $ G , x ∊ cl_ipos_closed ⇒ x ∊ cl_ipos_closed $ by ax
l2: $ G , x ∊ cl_ipos_closed ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ kr_ipos ∈ ω $ by x1_kr_ipos
l5: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_ipos_closed ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_ipos_closed ⊆ y1_lab kr_ipos (suc kr_ipos) $ by subset_intro [l16]

lemma y1_k_ipos_pi (G: hyps): $ G ⇒ cl_ipos_pi ⊆ y1_lab kr_ipos (suc kr_ipos) $
----
l1: $ G , x ∊ cl_ipos_pi ⇒ x ∊ cl_ipos_pi $ by ax
l2: $ G , x ∊ cl_ipos_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ kr_ipos ∈ ω $ by x1_kr_ipos
l5: $ G , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l6, l5]
l8: $ G , ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l9: $ G , ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l8, l7]
l10: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l10, l9]
l12: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l12, l11]
l14: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l15: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l14, l13]
l16: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l17: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l16, l15]
l18: $ G , x ∊ cl_ipos_pi ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l2, l17]
l19: $ G ⇒ cl_ipos_pi ⊆ y1_lab kr_ipos (suc kr_ipos) $ by subset_intro [l18]

lemma y1_k_ipos_app (G: hyps): $ G ⇒ cl_ipos_app ⊆ y1_lab kr_ipos (suc kr_ipos) $
----
l1: $ G , x ∊ cl_ipos_app ⇒ x ∊ cl_ipos_app $ by ax
l2: $ G , x ∊ cl_ipos_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ kr_ipos ∈ ω $ by x1_kr_ipos
l5: $ G , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_ipos_app ⇒ x ∊ y1_lab kr_ipos (suc kr_ipos) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_ipos_app ⊆ y1_lab kr_ipos (suc kr_ipos) $ by subset_intro [l16]

lemma y1_p_ipos (G: hyps): $ G ⇒ pr_ipos ⊆ y1_lab kr_ipos (suc kr_ipos) $
----
l1: $ G ⇒ cl_ipos_app ⊆ y1_lab kr_ipos (suc kr_ipos) $ by y1_k_ipos_app
l2: $ G ⇒ cl_ipos_pi ⊆ y1_lab kr_ipos (suc kr_ipos) $ by y1_k_ipos_pi
l3: $ G ⇒ cl_ipos_pi ∪ cl_ipos_app ⊆ y1_lab kr_ipos (suc kr_ipos) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_ipos_closed ⊆ y1_lab kr_ipos (suc kr_ipos) $ by y1_k_ipos_closed
l5: $ G ⇒ pr_ipos ⊆ y1_lab kr_ipos (suc kr_ipos) $ by cun_least [l4, l3]

lemma y1_k_recfield_pi (G: hyps): $ G ⇒ cl_recfield_pi ⊆ y1_lab kr_recfield (suc kr_recfield) $
----
l1: $ G , x ∊ cl_recfield_pi ⇒ x ∊ cl_recfield_pi $ by ax
l2: $ G , x ∊ cl_recfield_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ kr_recfield ∈ ω $ by x1_kr_recfield
l5: $ G , x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩ ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l7: $ G , ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by ex_elim [l6, l5]
l8: $ G , ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l9: $ G , ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by ex_elim [l8, l7]
l10: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l11: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by ex_elim [l10, l9]
l12: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l13: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by ex_elim [l12, l11]
l14: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l15: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by ex_elim [l14, l13]
l16: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) $ by ax
l17: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_recfield y z u ⟨ kc_s , scons v ∅ ⟩ b w) ∅ , ra_recfield y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ w ⟩) ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by ex_elim [l16, l15]
l18: $ G , x ∊ cl_recfield_pi ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by ex_elim [l2, l17]
l19: $ G ⇒ cl_recfield_pi ⊆ y1_lab kr_recfield (suc kr_recfield) $ by subset_intro [l18]

lemma y1_k_recfield_app (G: hyps): $ G ⇒ cl_recfield_app ⊆ y1_lab kr_recfield (suc kr_recfield) $
----
l1: $ G , x ∊ cl_recfield_app ⇒ x ∊ cl_recfield_app $ by ax
l2: $ G , x ∊ cl_recfield_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ kr_recfield ∈ ω $ by x1_kr_recfield
l5: $ G , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩ ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by ax
l7: $ G , ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ x ∊ y1_lab kr_recfield (suc kr_recfield) $ by ex_elim [l6, l5]
l8: $ G , ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_recfield y z u v a w ⟩) $ by ax
