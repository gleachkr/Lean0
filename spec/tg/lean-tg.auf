lemma y1_d_ihval_lam (G: hyps) {D np n_v m_v v_v nf fld y_v j_v A B IH: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set):
  $ G ⇒ ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ ∈ cl_ihval_lam $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons A (scons IH ∅) ⟩ ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x ∊ cl_ihval_lam ⇒ x ∊ cl_ihval_lam $ by ax
l2: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x ∊ cl_ihval_lam ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j (x = ⟨ scons (ra_ihval y z u v w a b ⟨ kc_s , scons c ∅ ⟩ f i j) ∅ , ra_ihval y z u v w a b c f ⟨ kc_pi , scons g (scons i ∅) ⟩ ⟨ kc_lam , scons g (scons j ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_ihval y z u v w a b ⟨ kc_s , scons c ∅ ⟩ f i j) ∅ , ra_ihval y z u v w a b c f ⟨ kc_pi , scons g (scons i ∅) ⟩ ⟨ kc_lam , scons g (scons j ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ $ by ax
