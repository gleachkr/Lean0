l12: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w2 = a $ by and_elim_l [l11]
l13: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w3 = b ∧ w4 = d $ by and_elim_r [l11]
l14: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w3 = b $ by and_elim_l [l13]
l15: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ w4 = d $ by and_elim_r [l13]
l16: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by y2_ind_data_e1 [l4, l6, l8, l9, l10, l12, l14, l15]
l17: $ GG , ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
l18: $ GG , ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l17, l16]
l19: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
l20: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l19, l18]
l21: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d) $ by ax
