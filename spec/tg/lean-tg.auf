lemma y2_ndecl_e2 (GG: hyps) (q1 q2 q3 w3 u_X u_N u_n u_n0 v_X v_N v_n v_n0: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_X (scons u_N ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ > $ GG ⇒ q3 = u_n0 $ > $ GG ⇒ ra_ndecl u_N u_n u_n0 ∈ lrel $ > $ GG ⇒ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ > $ GG ⇒ q1 = ⟨ kc_cons , scons v_X (scons v_N ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons v_n ∅ ⟩ $ > $ GG ⇒ w3 = v_n0 $ > $ GG ⇒ ra_ndecl v_N v_n v_n0 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_cons , scons u_X (scons u_N ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_cons , scons u_X (scons u_N ∅) ⟩ = ⟨ kc_cons , scons v_X (scons v_N ∅) ⟩ $ by eq_trans [l1, #6]
l3: $ GG ⇒ kc_cons ∈ ω $ by v1_kc_cons
l4: $ GG ⇒ isset kc_cons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_X $ by isset_var
l6: $ GG ⇒ isset u_N $ by isset_var
l7: $ GG ⇒ isset v_X $ by isset_var
l8: $ GG ⇒ isset v_N $ by isset_var
l9: $ GG ⇒ u_X = v_X ∧ u_N = v_N $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_X = v_X $ by and_elim_l [l9]
l11: $ GG ⇒ u_N = v_N $ by and_elim_r [l9]
l12: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = q2 $ by eq_sym [#2]
l13: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = ⟨ kc_s , scons v_n ∅ ⟩ $ by eq_trans [l12, #7]
l14: $ GG ⇒ kc_s ∈ ω $ by v1_kc_s
l15: $ GG ⇒ isset kc_s $ by wcel_isset [l14]
l16: $ GG ⇒ isset u_n $ by isset_var
l17: $ GG ⇒ isset v_n $ by isset_var
l18: $ GG ⇒ u_n = v_n $ by y2_nd1 [l13, l15, l16, l17]
l19: $ GG ⇒ v_N = u_N $ by eq_sym [l11]
l20: $ GG ⇒ v_n = u_n $ by eq_sym [l18]
l21: $ GG ⇒ v_n0 = v_n0 $ by eq_refl
l22: $ GG ⇒ ra_ndecl u_N u_n v_n0 ∈ lrel $ by x1_eq_ndecl [#9, l19, l20, l21]
l23: $ GG ⇒ isset u_N $ by isset_var
l24: $ GG ⇒ isset u_n $ by isset_var
l25: $ GG ⇒ isset u_n0 $ by isset_var
l26: $ GG ⇒ isset v_n0 $ by isset_var
l27: $ GG ⇒ u_n0 = v_n0 $ by y2_ndecl_ihc [l23, l24, l25, l26, #5, l22]
l28: $ GG ⇒ v_n0 = w3 $ by eq_sym [#8]
l29: $ GG ⇒ q3 = v_n0 $ by eq_trans [#3, l27]
l30: $ GG ⇒ q3 = w3 $ by eq_trans [l29, l28]

lemma y2_ndecl_c2 (GG: hyps) (q1 q2 q3 w3 u_X u_N u_n u_n0: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_X (scons u_N ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_n0 ∧ ra_ndecl u_N u_n u_n0 ∈ lrel ∧ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ > $ GG ⇒ ra_ndecl q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ∨ ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel) $ by lrel_ndecl_cases [#2]
l2: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a $ by ax
l3: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons u_X (scons u_N ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_n0 ∧ ra_ndecl u_N u_n u_n0 ∈ lrel ∧ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons u_X (scons u_N ∅) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_n0 ∧ ra_ndecl u_N u_n u_n0 ∈ lrel ∧ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = u_n0 ∧ ra_ndecl u_N u_n u_n0 ∈ lrel ∧ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = u_n0 $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ ra_ndecl u_N u_n u_n0 ∈ lrel ∧ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ ra_ndecl u_N u_n u_n0 ∈ lrel $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l2]
l13: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = a ∧ w3 = a $ by and_elim_r [l2]
l14: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = a $ by and_elim_l [l13]
l15: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ w3 = a $ by and_elim_r [l13]
l16: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ kc_nil ∈ kc_cons $ by y2_lt_nil_cons
l17: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ kc_cons ∈ ω $ by v1_kc_cons
l18: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ isset kc_cons $ by wcel_isset [l17]
l19: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ ⊥ $ by y2_ne [l12, l4, l16, l18]
l20: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = w3 $ by bot_elim [l19]
l21: $ GG , ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ⇒ ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) $ by ax
l22: $ GG , ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l21, l20]
l23: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel $ by ax
l24: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q1 = ⟨ kc_cons , scons u_X (scons u_N ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_n0 ∧ ra_ndecl u_N u_n u_n0 ∈ lrel ∧ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ by weaken [#1]
l25: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q1 = ⟨ kc_cons , scons u_X (scons u_N ∅) ⟩ $ by and_elim_l [l24]
l26: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = u_n0 ∧ ra_ndecl u_N u_n u_n0 ∈ lrel ∧ ra_ndecl u_N u_n u_n0 ∈ y2_P_ndecl lrel $ by and_elim_r [l24]
l27: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l26]
