l56: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by wcel_elim [#1, l55]

lemma y1_o_iota_tel (G: hyps) {D b_v P T v_v i_v c_v np n_v m_v mn nf M N X Xl Q1 Q2 Dl F K K2 res C: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ pr_iota_tel $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by y1_d_iota_tel_i [#1, #2]

lemma y1_e_iota_lhs_i (G: hyps) {D v_v i_v c_v np n_v m_v mn nf ni a_v d1 io mo res e1 e2 e3 e4 Y T2 T0 c1 maj: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19 V20 V21 V22 V23 V24: set):
  $ G ⇒ ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ = ⟨ scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_nidx V1 V3 V10) (scons (ra_add V7 V6 V8) (scons (ra_add V9 V7 V11) (scons (ra_add V11 V6 V12) (scons (ra_pargs ⟨ kc_ind_rec , scons V1 (scons V3 (scons V2 ∅)) ⟩ V12 V5 V16) (scons (ra_pargs V16 V11 V6 V17) (scons (ra_pargs V17 V9 V7 V18) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V12 V5 V20) (scons (ra_lift V8 V9 V15 V21) (scons (ra_rehead V20 V18 V10 V21 V19) (scons (ra_pargs ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ V12 V5 V23) (scons (ra_pargs V23 ⟨ kc_nz , ∅ ⟩ V9 V24) (scons (ra_add V13 ⟨ kc_s , scons V3 ∅ ⟩ V6) (scons (ra_add V11 V13 V14) (scons (ra_rehead V20 ⟨ kc_bvar , scons V14 ∅ ⟩ V10 V21 V22) ∅))))))))))))))) , ra_iota_lhs V1 V2 V3 V4 V9 V15 V18 V23 V24 V19 ⟨ kc_app , scons V22 (scons V24 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ ni ∃ a_v ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = nf ∧ t6 = res ∧ t7 = e3 ∧ t8 = c1 ∧ t9 = maj ∧ t10 = e4 ∧ t11 = ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add a_v n_v d1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ d1 np e1 ∈ lrel ∧ ra_pargs e1 a_v n_v e2 ∈ lrel ∧ ra_pargs e2 nf m_v e3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ d1 np Y ∈ lrel ∧ ra_lift mn nf res T2 ∈ lrel ∧ ra_rehead Y e3 ni T2 e4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ d1 np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add io ⟨ kc_s , scons i_v ∅ ⟩ n_v ∈ lrel ∧ ra_add a_v io mo ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_nidx V1 V3 V10) (scons (ra_add V7 V6 V8) (scons (ra_add V9 V7 V11) (scons (ra_add V11 V6 V12) (scons (ra_pargs ⟨ kc_ind_rec , scons V1 (scons V3 (scons V2 ∅)) ⟩ V12 V5 V16) (scons (ra_pargs V16 V11 V6 V17) (scons (ra_pargs V17 V9 V7 V18) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V12 V5 V20) (scons (ra_lift V8 V9 V15 V21) (scons (ra_rehead V20 V18 V10 V21 V19) (scons (ra_pargs ⟨ kc_ind_ctor , scons V1 (scons V3 (scons V4 ∅)) ⟩ V12 V5 V23) (scons (ra_pargs V23 ⟨ kc_nz , ∅ ⟩ V9 V24) (scons (ra_add V13 ⟨ kc_s , scons V3 ∅ ⟩ V6) (scons (ra_add V11 V13 V14) (scons (ra_rehead V20 ⟨ kc_bvar , scons V14 ∅ ⟩ V10 V21 V22) ∅))))))))))))))) , ra_iota_lhs V1 V2 V3 V4 V9 V15 V18 V23 V24 V19 ⟨ kc_app , scons V22 (scons V24 ∅) ⟩ ⟩ = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ $ by eq_sym [#1]
