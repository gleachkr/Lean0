lemma y2_spine2_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_spine2 lrel → c ∊ y2_P_spine2 lrel) $
