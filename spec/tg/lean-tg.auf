lemma y2_spine2_d2 {x y: set} (GG: hyps x y) (o q1 q2 q3 w1 w3: set):
  $ GG ⇒ ⟨ o , ra_spine q1 q2 q3 ⟩ ∈ cl_spine_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_spine2 lrel $ > $ GG ⇒ ra_spine w1 q2 w3 ∈ lrel $ > $ GG ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ GG ⇒ q1 = w1 ∧ q3 = w3 $
----
l1: $ GG , q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine2 lrel ⇒ q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine2 lrel $ by ax
l2: $ GG , q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine2 lrel ⇒ ra_spine w1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine2 lrel ⇒ ¬ ∃ x ∃ y (q1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#4]
l4: $ GG , q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine2 lrel ⇒ ¬ ∃ x ∃ y (w1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ by weaken [#5]
l5: $ GG , q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine2 lrel ⇒ q1 = w1 ∧ q3 = w3 $ by y2_spine2_c2 [l1, l2, l3, l4]
l6: $ GG ⇒ q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine2 lrel → q1 = w1 ∧ q3 = w3 $ by imp_intro [l5]
l7: $ GG ⇒ ∀ e (q1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel ∧ ra_spine a b e ∈ y2_P_spine2 lrel → q1 = w1 ∧ q3 = w3) $ by all_intro [l6]
