l48: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ (scons ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ∅)))))) $ by y1_scons_inj [l47, l24, l40, l23, l39]
