l5: $ G , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ ⇒ x ∊ y1_lab kr_nidx (suc kr_nidx) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l7: $ G , ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ x ∊ y1_lab kr_nidx (suc kr_nidx) $ by ex_elim [l6, l5]
l8: $ G , ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l9: $ G , ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ x ∊ y1_lab kr_nidx (suc kr_nidx) $ by ex_elim [l8, l7]
l10: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l11: $ G , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ x ∊ y1_lab kr_nidx (suc kr_nidx) $ by ex_elim [l10, l9]
l12: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l13: $ G , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ x ∊ y1_lab kr_nidx (suc kr_nidx) $ by ex_elim [l12, l11]
l14: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l15: $ G , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ x ∊ y1_lab kr_nidx (suc kr_nidx) $ by ex_elim [l14, l13]
l16: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l17: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ x ∊ y1_lab kr_nidx (suc kr_nidx) $ by ex_elim [l16, l15]
l18: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l19: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ x ∊ y1_lab kr_nidx (suc kr_nidx) $ by ex_elim [l18, l17]
