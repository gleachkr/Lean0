lemma y1_e_iota_tel_i (G: hyps) {D b_v P T v_v i_v c_v np n_v m_v mn nf M N X Xl Q1 Q2 Dl F K K2 res C: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19 V20 V21 V22 V23 V24: set):
  $ G ⇒ ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V8) (scons (ra_ntys V4 V9 V10) (scons (ra_motives V1 V8 V5 ⟨ kc_nz , ∅ ⟩ V4 V13) (scons (ra_minors V1 V8 V9 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V14) (scons (ra_nth_ty V4 V6 V20 V24) (scons (ra_nth_ctor V24 V7 V21) (scons (ra_npis V21 V12) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V9 V8 V21 V22) (scons (ra_psplit V12 V22 ⟨ kc_nil , ∅ ⟩ V15 V23) (scons (ra_add V10 V9 V11) (scons (ra_clift V11 V15 V16) (scons (ra_capp V13 V3 V17) (scons (ra_capp V14 V17 V18) (scons (ra_capp V16 V18 V19) ∅)))))))))))))) , ra_iota_tel V1 V5 V6 V7 V15 V23 V12 V19 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V8) (scons (ra_ntys V4 V9 V10) (scons (ra_motives V1 V8 V5 ⟨ kc_nz , ∅ ⟩ V4 V13) (scons (ra_minors V1 V8 V9 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V14) (scons (ra_nth_ty V4 V6 V20 V24) (scons (ra_nth_ctor V24 V7 V21) (scons (ra_npis V21 V12) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V9 V8 V21 V22) (scons (ra_psplit V12 V22 ⟨ kc_nil , ∅ ⟩ V15 V23) (scons (ra_add V10 V9 V11) (scons (ra_clift V11 V15 V16) (scons (ra_capp V13 V3 V17) (scons (ra_capp V14 V17 V18) (scons (ra_capp V16 V18 V19) ∅)))))))))))))) , ra_iota_tel V1 V5 V6 V7 V15 V23 V12 V19 ⟩ = ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [#1]
