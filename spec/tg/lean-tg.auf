l34: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel $ by and_elim_r [l23]
l35: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q2 = ⟨ kc_s , scons a ∅ ⟩ $ by and_elim_l [l34]
l36: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ w3 = e ∧ ra_ndecl d a e ∈ lrel $ by and_elim_r [l34]
l37: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ w3 = e $ by and_elim_l [l36]
l38: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ ra_ndecl d a e ∈ lrel $ by and_elim_r [l36]
l39: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q3 = w3 $ by y2_ndecl_e2 [l25, l27, l29, l31, l32, l33, l35, l37, l38]
