l58: $ G ⇒ t4 = V4 $ by and_elim_l [l57]
l59: $ G ⇒ scons t5 (scons t6 (scons t7 (scons t8 ∅))) = scons V5 (scons V6 (scons ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ (scons ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ∅))) $ by and_elim_r [l57]
