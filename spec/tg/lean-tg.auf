lemma y2_pargs_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_pargs lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_pargs lrel → c ∊ y2_P_pargs lrel) $ by y2_pargs_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_pargs lrel $ by horn_ind [l1, l2]

lrel_pargs_det
--------------
l1: $ G ⇒ horn lprog ⊆ y2_P_pargs lrel $ by y2_pargs_in
l2: $ G ⇒ ra_pargs t1 t2 t3 u4 ∈ y2_P_pargs lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u4 = v4 $ by y2_pargs_ih [l2, #2]

--| The atoms of `rehead` whose variants in `L` with the same inputs have the same outputs.
def y2_P_rehead (L: class) (.c .x1 .x2 .x3 .x4 .x5 .x6 .x7: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 ∀ x4 ∀ x5 (c = ⟨ kr_rehead , scons x1 (scons x2 (scons x3 (scons x4 (scons x5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons x2 (scons x3 (scons x4 (scons x7 ∅)))) ⟩ ∈ L → x1 = x6 ∧ x5 = x7))} $

lemma y2_rehead_ih (GG: hyps) (q1 q2 q3 q4 q5 w1 w5: set):
  $ GG ⇒ ra_rehead q1 q2 q3 q4 q5 ∈ y2_P_rehead lrel $ > $ GG ⇒ ra_rehead w1 q2 q3 q4 w5 ∈ lrel $ > $ GG ⇒ q1 = w1 ∧ q5 = w5 $
----
l1: $ GG , c = ra_rehead q1 q2 q3 q4 q5 , c ∊ y2_P_rehead lrel ⇒ c ∊ y2_P_rehead lrel $ by ax
