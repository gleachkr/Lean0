l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by ex_intro [l29]

lemma y1_d_bdbl_d1 (G: hyps) {a_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_d1 ⇒ x ∊ cl_bdbl_d1 $ by ax
l2: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_d1 ⇒ ∃ y (x = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_bdbl t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x = ⟨ ∅ , ra_bdbl ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons y ∅ ⟩ ∅ ⟩ ⟩ ⇒ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by y1_e_bdbl_d1 [l6, l7]
l9: $ G , x = ⟨ pp , ra_bdbl t1 t2 ⟩ , x ∊ cl_bdbl_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_o_bdbl (G: hyps) {a_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ pr_bdbl $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $
----
l1: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 $ by ax
l2: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by y1_d_bdbl_d1 [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 → ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 $ by ax
l6: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∨ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 $ by ax
l8: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) $ by y1_d_bdbl_d0 [l7, l8]
l10: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 $ by ax
l12: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 → ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 → ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by imp_intro [l15]
l17: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) $ by ax
l18: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∨ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ (cl_bdbl_d0 ∪ cl_bdbl_d1) $ by v1_wcel_cun_elim [l17]
l19: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 $ by ax
l20: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l21: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) $ by y1_d_bdbl_0 [l19, l20]
l22: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by or_intro_l [l21]
l23: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 $ by ax
l24: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 → ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by weaken [l16]
l25: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by imp_elim [l24, l23]
l26: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_d0 ∪ cl_bdbl_d1 ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by or_intro_r [l25]
l27: $ G , ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by or_elim [l18, l22, l26]
l28: $ G ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ ∈ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) → (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by imp_intro [l27]
l29: $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $ by imp_elim [l28, #1]

lemma y1_e_badd_0l (G: hyps) {b_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ V1 V1 ⟩ = ⟨ pp , ra_badd t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_badd t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_badd ⟨ kc_b0 , ∅ ⟩ V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_badd t1 t2 t3 = ra_badd ⟨ kc_b0 , ∅ ⟩ V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_badd t1 t2 t3 = ra_badd ⟨ kc_b0 , ∅ ⟩ V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_badd ∈ ω $ by x1_kr_badd
l22: $ G ⇒ isset kr_badd $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_badd = kr_badd ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_intro [l36]

lemma y1_d_badd_0l (G: hyps) {b_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ ∈ cl_badd_0l $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $
----
l1: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x ∊ cl_badd_0l ⇒ x ∊ cl_badd_0l $ by ax
l2: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x ∊ cl_badd_0l ⇒ ∃ y (x = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ x = ⟨ pp , ra_badd t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd ⟨ kc_b0 , ∅ ⟩ y y ⟩ ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by y1_e_badd_0l [l6, l7]
l9: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x ∊ cl_badd_0l ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) $ by wcel_elim [#1, l9]

lemma y1_e_badd_0r (G: hyps) {a_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = ⟨ ∅ , ra_badd V1 ⟨ kc_b0 , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_badd V1 ⟨ kc_b0 , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_badd t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_badd t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_badd V1 ⟨ kc_b0 , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_badd t1 t2 t3 = ra_badd V1 ⟨ kc_b0 , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_badd t1 t2 t3 = ra_badd V1 ⟨ kc_b0 , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l16, l19]
l21: $ G ⇒ kr_badd ∈ ω $ by x1_kr_badd
l22: $ G ⇒ isset kr_badd $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_badd = kr_badd ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l26, l14, l16, l13, l19]
l28: $ G ⇒ t1 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l18, l11, l17]
l31: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by ex_intro [l36]

lemma y1_d_badd_0r (G: hyps) {a_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ ∈ cl_badd_0r $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $
----
l1: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x ∊ cl_badd_0r ⇒ x ∊ cl_badd_0r $ by ax
l2: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x ∊ cl_badd_0r ⇒ ∃ y (x = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_badd t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_badd y ⟨ kc_b0 , ∅ ⟩ y ⟩ ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by y1_e_badd_0r [l6, l7]
l9: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x ∊ cl_badd_0r ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) $ by wcel_elim [#1, l9]

lemma y1_e_badd_00 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = ⟨ scons (ra_badd V1 V2 V3) ∅ , ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_badd V1 V2 V3) ∅ , ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_badd t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_badd V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_badd t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_badd V1 V2 V3) ∅ ∧ ra_badd t1 t2 t3 = ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_badd V1 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_badd t1 t2 t3 = ra_badd ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟨ kc_bd0 , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_bd0 , scons V3 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_badd ∈ ω $ by x1_kr_badd
l23: $ G ⇒ isset kr_badd $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_badd = kr_badd ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_bd0 , scons V2 ∅ ⟩ (scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_bd0 , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_bd0 , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_bd0 , scons V3 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_badd V1 V2 V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_badd V1 V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_badd V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_badd V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = ⟨ kc_bd0 , scons V3 ∅ ⟩ ∧ ra_badd V1 V2 V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons V3 ∅ ⟩ ∧ ra_badd V1 V2 V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons V3 ∅ ⟩ ∧ ra_badd V1 V2 V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ c_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd V1 V2 c_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd V1 b_v c_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $ by ex_intro [l44]

lemma y1_d_badd_00 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ ∈ cl_badd_00 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x ∊ cl_badd_00 ⇒ x ∊ cl_badd_00 $ by ax
l2: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x ∊ cl_badd_00 ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_badd t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_badd t1 t2 t3 ⟩ = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $ by y1_e_badd_00 [l6, l7]
