l1: $ G ⇒ ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
