l26: $ G , x = ⟨ pp , ra_indapp t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_spine ⟨ kc_bvar , scons b ∅ ⟩ i f) (scons (ra_add v u a) (scons (ra_add a w b) (scons (ra_le ⟨ kc_s , scons w ∅ ⟩ z) (scons (ra_pargs ⟨ kc_bvar , scons b ∅ ⟩ v u g) (scons (ra_nidx y w c) (scons (ra_iargs a c g i) ∅)))))) , ra_indapp y z u v i w ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ k_v ∃ t_v ∃ m_v ∃ na ∃ X ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_spine ⟨ kc_bvar , scons t_v ∅ ⟩ A na ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_add k_v j_v t_v ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np X ∈ lrel ∧ ra_nidx D j_v m_v ∈ lrel ∧ ra_iargs k_v m_v X A ∈ lrel) $ by ex_elim [l25, l24]
l27: $ G , x = ⟨ pp , ra_indapp t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_spine ⟨ kc_bvar , scons b ∅ ⟩ i f) (scons (ra_add v u a) (scons (ra_add a w b) (scons (ra_le ⟨ kc_s , scons w ∅ ⟩ z) (scons (ra_pargs ⟨ kc_bvar , scons b ∅ ⟩ v u g) (scons (ra_nidx y w c) (scons (ra_iargs a c g i) ∅)))))) , ra_indapp y z u v i w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_spine ⟨ kc_bvar , scons b ∅ ⟩ i f) (scons (ra_add v u a) (scons (ra_add a w b) (scons (ra_le ⟨ kc_s , scons w ∅ ⟩ z) (scons (ra_pargs ⟨ kc_bvar , scons b ∅ ⟩ v u g) (scons (ra_nidx y w c) (scons (ra_iargs a c g i) ∅)))))) , ra_indapp y z u v i w ⟩) $ by ax
