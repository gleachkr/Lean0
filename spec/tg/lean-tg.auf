----
l1: $ G , x ∊ cl_inst_proj ⇒ x ∊ cl_inst_proj $ by ax
l2: $ G , x ∊ cl_inst_proj ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_inst y v w a) ∅ , ra_inst y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ w ⟨ kc_proj , scons z (scons u (scons a ∅)) ⟩ ⟩) $ by cab_elim [l1]
