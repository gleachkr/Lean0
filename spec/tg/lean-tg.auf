l37: $ GG , ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) ⇒ q2 = w2 ∧ q3 = w3 $ by ex_elim [l36, l35]
l38: $ GG , ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) ⇒ ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) $ by ax
l39: $ GG , ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) ⇒ q2 = w2 ∧ q3 = w3 $ by ex_elim [l38, l37]
l40: $ GG , ∃ e ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) ⇒ ∃ e ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) $ by ax
l41: $ GG , ∃ e ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) ⇒ q2 = w2 ∧ q3 = w3 $ by ex_elim [l40, l39]
l42: $ GG , ∃ d ∃ e ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) ⇒ ∃ d ∃ e ∃ f ∃ g ∃ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel) $ by ax
