lemma y1_o_minor_idx (G: hyps) {F C T c_v i_v k_v nc k2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ pr_minor_idx $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) ∨ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s $ by ax
l2: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s ⇒ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by y1_d_minor_idx_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s → ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s $ by ax
l6: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∨ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z $ by ax
l8: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by y1_d_minor_idx_z [l7, l8]
l10: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) ∨ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s $ by ax
l12: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s → ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s ⇒ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) ∨ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) ∨ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z ∪ cl_minor_idx_s → ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) ∨ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) ∨ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_npis_bvar (G: hyps) {i_v: set} (pp t1 t2 V1: set):
  $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_npis ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ = ⟨ pp , ra_npis t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_npis t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_npis ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_npis t1 t2 = ra_npis ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_npis t1 t2 = ra_npis ⟨ kc_bvar , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_bvar , scons V1 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_bvar , scons V1 ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_npis ∈ ω $ by x1_kr_npis
l19: $ G ⇒ isset kr_npis $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_bvar , scons V1 ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_npis = kr_npis ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_bvar , scons V1 ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_bvar , scons V1 ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_bvar , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_bvar , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ex_intro [l29]

lemma y1_d_npis_bvar (G: hyps) {i_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_bvar ⇒ x ∊ cl_npis_bvar $ by ax
l2: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_bvar ⇒ ∃ y (x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_npis t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by y1_e_npis_bvar [l6, l7]
l9: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_bvar ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_npis_app (G: hyps) {f_v a_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = ⟨ ∅ , ra_npis ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_npis ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ = ⟨ pp , ra_npis t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_npis t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_npis ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_npis t1 t2 = ra_npis ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_npis t1 t2 = ra_npis ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_npis ∈ ω $ by x1_kr_npis
l19: $ G ⇒ isset kr_npis $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_npis = kr_npis ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_app , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ a_v (t1 = ⟨ kc_app , scons V1 (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ex_intro [l30]

lemma y1_d_npis_app (G: hyps) {f_v a_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_app ⇒ x ∊ cl_npis_app $ by ax
l2: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_app ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_npis t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by y1_e_npis_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_app ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_npis_pi (G: hyps) {A B n_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = ⟨ scons (ra_npis V2 V3) ∅ , ra_npis ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_npis V2 V3) ∅ , ra_npis ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_npis t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_npis V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_npis t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_npis ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_npis V2 V3) ∅ ∧ ra_npis t1 t2 = ra_npis ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_npis V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_npis t1 t2 = ra_npis ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_npis ∈ ω $ by x1_kr_npis
l19: $ G ⇒ isset kr_npis $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_npis = kr_npis ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_npis V2 V3) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_npis V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_npis V2 V3) $ by opair_isset
l32: $ G ⇒ ra_npis V2 V3 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_npis V2 V3 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_npis V2 V3 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ n_v (t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis V2 n_v ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons V1 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by ex_intro [l35]
l37: $ G ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by ex_intro [l36]

lemma y1_d_npis_pi (G: hyps) {A B n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_pi ⇒ x ∊ cl_npis_pi $ by ax
l2: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_pi ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_npis t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_npis t1 t2 ⟩ = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by y1_e_npis_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_npis t1 t2 ⟩ , x ∊ cl_npis_pi ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_npis (G: hyps) {i_v f_v a_v A B n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ pr_npis $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi $ by ax
l2: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by y1_d_npis_pi [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi → ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi $ by ax
l6: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∨ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app $ by ax
l8: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by y1_d_npis_app [l7, l8]
l10: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi $ by ax
l12: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi → ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi ⇒ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_pi ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi → ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by imp_intro [l15]
l17: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) $ by ax
l18: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∨ ⟨ pp , ra_npis t1 t2 ⟩ ∈ (cl_npis_app ∪ cl_npis_pi) $ by v1_wcel_cun_elim [l17]
l19: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar $ by ax
l20: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ⇒ crn pp ⊆ lrel $ by weaken [#2]
l21: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by y1_d_npis_bvar [l19, l20]
l22: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by or_intro_l [l21]
l23: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi $ by ax
l24: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi → ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by weaken [l16]
l25: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi ⇒ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by imp_elim [l24, l23]
l26: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_app ∪ cl_npis_pi ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by or_intro_r [l25]
l27: $ G , ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by or_elim [l18, l22, l26]
l28: $ G ⇒ ⟨ pp , ra_npis t1 t2 ⟩ ∈ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) → ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by imp_intro [l27]
l29: $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ B ∃ n_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_npis B n_v ∈ lrel) $ by imp_elim [l28, #1]

lemma y1_e_nth_pi_z (G: hyps) {A B: set} (pp t1 t2 t3 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $
----
l1: $ G ⇒ ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nth_pi t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_nth_pi ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_nth_pi t1 t2 t3 = ra_nth_pi ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nth_pi t1 t2 t3 = ra_nth_pi ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_nth_pi ∈ ω $ by x1_kr_nth_pi
l23: $ G ⇒ isset kr_nth_pi $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_nth_pi = kr_nth_pi ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l32, l35]
l37: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l29, l36]
l38: $ G ⇒ ∃ B (t1 = ⟨ kc_pi , scons V1 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1) $ by ex_intro [l37]
l39: $ G ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by ex_intro [l38]

lemma y1_d_nth_pi_z (G: hyps) {A B: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $
----
l1: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x ∊ cl_nth_pi_z ⇒ x ∊ cl_nth_pi_z $ by ax
l2: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x ∊ cl_nth_pi_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by y1_e_nth_pi_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , ∃ z (x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , ∃ z (x = ⟨ ∅ , ra_nth_pi ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x ∊ cl_nth_pi_z ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by wcel_elim [#1, l11]

lemma y1_e_nth_pi_s (G: hyps) {A A2 B i_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ = ⟨ scons (ra_nth_pi V3 V4 V1) ∅ , ra_nth_pi ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_nth_pi V3 V4 V1) ∅ , ra_nth_pi ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1 ⟩ = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_nth_pi V3 V4 V1) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nth_pi t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_nth_pi ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_nth_pi V3 V4 V1) ∅ ∧ ra_nth_pi t1 t2 t3 = ra_nth_pi ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_nth_pi V3 V4 V1) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nth_pi t1 t2 t3 = ra_nth_pi ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_nth_pi ∈ ω $ by x1_kr_nth_pi
l23: $ G ⇒ isset kr_nth_pi $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_nth_pi = kr_nth_pi ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_nth_pi V3 V4 V1) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_nth_pi V3 V4 V1) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_nth_pi V3 V4 V1) $ by opair_isset
l39: $ G ⇒ ra_nth_pi V3 V4 V1 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V1 ∧ ra_nth_pi V3 V4 V1 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_pi V3 V4 V1 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_pi V3 V4 V1 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ i_v (t1 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_pi V3 i_v V1 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons V2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_pi B i_v V1 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = V1 ∧ ra_nth_pi B i_v V1 ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by ex_intro [l45]

lemma y1_d_nth_pi_s (G: hyps) {A A2 B i_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x ∊ cl_nth_pi_s ⇒ x ∊ cl_nth_pi_s $ by ax
l2: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x ∊ cl_nth_pi_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by y1_e_nth_pi_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ , x ∊ cl_nth_pi_s ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_nth_pi (G: hyps) {A B A2 i_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ pr_nth_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s $ by ax
l2: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by y1_d_nth_pi_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s → ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s $ by ax
l6: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∨ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z $ by ax
l8: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by y1_d_nth_pi_z [l7, l8]
l10: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s $ by ax
l12: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s → ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s ⇒ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_s ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_nth_pi t1 t2 t3 ⟩ ∈ cl_nth_pi_z ∪ cl_nth_pi_s → ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ A ∃ B (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ A2 ∃ B ∃ i_v (t1 = ⟨ kc_pi , scons A2 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = A ∧ ra_nth_pi B i_v A ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_isort_srt (G: hyps) {l_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ = ⟨ ∅ , ra_isort ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_isort ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_isort t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_isort t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_isort ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_isort t1 t2 t3 = ra_isort ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_isort t1 t2 t3 = ra_isort ⟨ kc_srt , scons V1 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_srt , scons V1 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_srt , scons V1 ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_isort ∈ ω $ by x1_kr_isort
l23: $ G ⇒ isset kr_isort $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_srt , scons V1 ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_isort = kr_isort ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_srt , scons V1 ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_srt , scons V1 ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_srt , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_srt , scons V1 ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l32, l35]
l37: $ G ⇒ t1 = ⟨ kc_srt , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l29, l36]
l38: $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) $ by ex_intro [l37]

lemma y1_d_isort_srt (G: hyps) {l_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) $
----
l1: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x ∊ cl_isort_srt ⇒ x ∊ cl_isort_srt $ by ax
l2: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x ∊ cl_isort_srt ⇒ ∃ y (x = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_isort t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_isort ⟨ kc_srt , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) $ by y1_e_isort_srt [l6, l7]
l9: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x ∊ cl_isort_srt ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) $ by wcel_elim [#1, l9]

lemma y1_e_isort_pi (G: hyps) {A B k_v l_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ = ⟨ scons (ra_isort V2 V3 V4) ∅ , ra_isort ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_isort V2 V3 V4) ∅ , ra_isort ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4 ⟩ = ⟨ pp , ra_isort t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_isort V2 V3 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_isort t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_isort ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_isort V2 V3 V4) ∅ ∧ ra_isort t1 t2 t3 = ra_isort ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_isort V2 V3 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_isort t1 t2 t3 = ra_isort ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V4 $ by isset_var
l17: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_isort ∈ ω $ by x1_kr_isort
l23: $ G ⇒ isset kr_isort $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_isort = kr_isort ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V3 ∅ ⟩ (scons V4 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ scons t3 ∅ = scons V4 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V4 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V4 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_isort V2 V3 V4) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_isort V2 V3 V4) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_isort V2 V3 V4) $ by opair_isset
l39: $ G ⇒ ra_isort V2 V3 V4 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V4 ∧ ra_isort V2 V3 V4 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ t3 = V4 ∧ ra_isort V2 V3 V4 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ t3 = V4 ∧ ra_isort V2 V3 V4 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ l_v (t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ t3 = l_v ∧ ra_isort V2 V3 l_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort V2 k_v l_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons V1 (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by ex_intro [l45]

lemma y1_d_isort_pi (G: hyps) {A B k_v l_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x ∊ cl_isort_pi ⇒ x ∊ cl_isort_pi $ by ax
l2: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x ∊ cl_isort_pi ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ x = ⟨ pp , ra_isort t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩ ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by y1_e_isort_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_isort z u v) ∅ , ra_isort ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ v ⟩) ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_isort t1 t2 t3 ⟩ , x ∊ cl_isort_pi ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_isort (G: hyps) {l_v A B k_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ pr_isort $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) ∨ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi $ by ax
l2: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by y1_d_isort_pi [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi → ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi $ by ax
l6: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∨ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt $ by ax
l8: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) $ by y1_d_isort_srt [l7, l8]
l10: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) ∨ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi $ by ax
l12: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi → ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi ⇒ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_pi ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) ∨ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) ∨ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_isort t1 t2 t3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi → ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) ∨ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = l_v) ∨ ∃ A ∃ B ∃ k_v ∃ l_v (t1 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t2 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t3 = l_v ∧ ra_isort B k_v l_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_ind_arity_i (G: hyps) {D b_v P T np n_v m_v: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V5) (scons (ra_ntys V4 V6 V7) ∅)) , ra_ind_arity V1 V5 V6 V7 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V5) (scons (ra_ntys V4 V6 V7) ∅)) , ra_ind_arity V1 V5 V6 V7 ⟩ = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V5) (scons (ra_ntys V4 V6 V7) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ind_arity t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_ind_arity V1 V5 V6 V7) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V5) (scons (ra_ntys V4 V6 V7) ∅)) ∧ ra_ind_arity t1 t2 t3 t4 = ra_ind_arity V1 V5 V6 V7 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V5) (scons (ra_ntys V4 V6 V7) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_ind_arity t1 t2 t3 t4 = ra_ind_arity V1 V5 V6 V7 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V7 $ by isset_var
l19: $ G ⇒ scons V7 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V6 $ by isset_var
l21: $ G ⇒ scons V6 (scons V7 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V5 $ by isset_var
l23: $ G ⇒ scons V5 (scons V6 (scons V7 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V5 (scons V6 (scons V7 ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_ind_arity ∈ ω $ by x1_kr_ind_arity
l27: $ G ⇒ isset kr_ind_arity $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V5 (scons V6 (scons V7 ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_ind_arity = kr_ind_arity ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V5 (scons V6 (scons V7 ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V5 (scons V6 (scons V7 ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V5 (scons V6 (scons V7 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V5 (scons V6 (scons V7 ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V5 ∧ scons t3 (scons t4 ∅) = scons V6 (scons V7 ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V5 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V6 (scons V7 ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V6 ∧ scons t4 ∅ = scons V7 ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V6 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons V7 ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = V7 ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = V7 $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V5) (scons (ra_ntys V4 V6 V7) ∅))) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V5) (scons (ra_ntys V4 V6 V7) ∅))) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_ind_data V1 V2 V3 V4) $ by opair_isset
l46: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_clen V3 V5) (scons (ra_ntys V4 V6 V7) ∅)) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_clen V3 V5) $ by opair_isset
l49: $ G ⇒ ra_clen V3 V5 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ crn (scons (ra_ntys V4 V6 V7) ∅) ⊆ lrel $ by crn_scons_tail [l47]
l51: $ G ⇒ isset (ra_ntys V4 V6 V7) $ by opair_isset
l52: $ G ⇒ ra_ntys V4 V6 V7 ∈ lrel $ by crn_scons_head [l51, l50]
l53: $ G ⇒ ra_clen V3 V5 ∈ lrel ∧ ra_ntys V4 V6 V7 ∈ lrel $ by and_intro [l49, l52]
l54: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 V5 ∈ lrel ∧ ra_ntys V4 V6 V7 ∈ lrel $ by and_intro [l46, l53]
l55: $ G ⇒ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 V5 ∈ lrel ∧ ra_ntys V4 V6 V7 ∈ lrel $ by and_intro [l42, l54]
l56: $ G ⇒ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 V5 ∈ lrel ∧ ra_ntys V4 V6 V7 ∈ lrel $ by and_intro [l39, l55]
l57: $ G ⇒ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 V5 ∈ lrel ∧ ra_ntys V4 V6 V7 ∈ lrel $ by and_intro [l36, l56]
l58: $ G ⇒ t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 V5 ∈ lrel ∧ ra_ntys V4 V6 V7 ∈ lrel $ by and_intro [l33, l57]
l59: $ G ⇒ ∃ m_v (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = m_v ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 V5 ∈ lrel ∧ ra_ntys V4 V6 m_v ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ n_v ∃ m_v (t1 = V1 ∧ t2 = V5 ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 V5 ∈ lrel ∧ ra_ntys V4 n_v m_v ∈ lrel) $ by ex_intro [l59]
l61: $ G ⇒ ∃ np ∃ n_v ∃ m_v (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys V4 n_v m_v ∈ lrel) $ by ex_intro [l60]
l62: $ G ⇒ ∃ T ∃ np ∃ n_v ∃ m_v (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data V1 V2 V3 T ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_intro [l61]
l63: $ G ⇒ ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data V1 V2 P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_intro [l63]
l65: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_intro [l64]

lemma y1_d_ind_arity_i (G: hyps) {D b_v P T np n_v m_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ ∈ cl_ind_arity_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x ∊ cl_ind_arity_i ⇒ x ∊ cl_ind_arity_i $ by ax
l2: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x ∊ cl_ind_arity_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by y1_e_ind_arity_i [l6, l7]
l9: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ , x ∊ cl_ind_arity_i ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_o_ind_arity (G: hyps) {D b_v P T np n_v m_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_ind_arity t1 t2 t3 t4 ⟩ ∈ pr_ind_arity $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ np ∃ n_v ∃ m_v (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel) $ by y1_d_ind_arity_i [#1, #2]

lemma y1_e_nidx_i (G: hyps) {D b_v P T i_v k_v F C l_v: set} (pp t1 t2 t3 V1 V2 V3 V4 V5 V6 V7 V8 V9: set):
  $ G ⇒ ⟨ pp , ra_nidx t1 t2 t3 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 V8) (scons (ra_isort V7 V6 V9) ∅)) , ra_nidx V1 V5 V6 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 V8) (scons (ra_isort V7 V6 V9) ∅)) , ra_nidx V1 V5 V6 ⟩ = ⟨ pp , ra_nidx t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 V8) (scons (ra_isort V7 V6 V9) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nidx t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_nidx V1 V5 V6) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 V8) (scons (ra_isort V7 V6 V9) ∅)) ∧ ra_nidx t1 t2 t3 = ra_nidx V1 V5 V6 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 V8) (scons (ra_isort V7 V6 V9) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_nidx t1 t2 t3 = ra_nidx V1 V5 V6 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V6 $ by isset_var
l17: $ G ⇒ scons V6 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V5 $ by isset_var
l19: $ G ⇒ scons V5 (scons V6 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons V5 (scons V6 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_nidx ∈ ω $ by x1_kr_nidx
l23: $ G ⇒ isset kr_nidx $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons V5 (scons V6 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_nidx = kr_nidx ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V5 (scons V6 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V5 (scons V6 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons V5 (scons V6 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons V5 (scons V6 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V5 ∧ scons t3 ∅ = scons V6 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = V5 $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V6 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V6 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V6 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 V8) (scons (ra_isort V7 V6 V9) ∅))) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 V8) (scons (ra_isort V7 V6 V9) ∅))) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_ind_data V1 V2 V3 V4) $ by opair_isset
l39: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_nth_ty V4 V5 V7 V8) (scons (ra_isort V7 V6 V9) ∅)) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_nth_ty V4 V5 V7 V8) $ by opair_isset
l42: $ G ⇒ ra_nth_ty V4 V5 V7 V8 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ crn (scons (ra_isort V7 V6 V9) ∅) ⊆ lrel $ by crn_scons_tail [l40]
l44: $ G ⇒ isset (ra_isort V7 V6 V9) $ by opair_isset
l45: $ G ⇒ ra_isort V7 V6 V9 ∈ lrel $ by crn_scons_head [l44, l43]
l46: $ G ⇒ ra_nth_ty V4 V5 V7 V8 ∈ lrel ∧ ra_isort V7 V6 V9 ∈ lrel $ by and_intro [l42, l45]
l47: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 V8 ∈ lrel ∧ ra_isort V7 V6 V9 ∈ lrel $ by and_intro [l39, l46]
l48: $ G ⇒ t3 = V6 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 V8 ∈ lrel ∧ ra_isort V7 V6 V9 ∈ lrel $ by and_intro [l35, l47]
l49: $ G ⇒ t2 = V5 ∧ t3 = V6 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 V8 ∈ lrel ∧ ra_isort V7 V6 V9 ∈ lrel $ by and_intro [l32, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 V8 ∈ lrel ∧ ra_isort V7 V6 V9 ∈ lrel $ by and_intro [l29, l49]
l51: $ G ⇒ ∃ l_v (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 V8 ∈ lrel ∧ ra_isort V7 V6 l_v ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ C ∃ l_v (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 C ∈ lrel ∧ ra_isort V7 V6 l_v ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ F ∃ C ∃ l_v (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 F C ∈ lrel ∧ ra_isort F V6 l_v ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ k_v ∃ F ∃ C ∃ l_v (t1 = V1 ∧ t2 = V5 ∧ t3 = k_v ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = V1 ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = V1 ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data V1 V2 V3 T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = V1 ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data V1 V2 P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = V1 ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_intro [l58]

lemma y1_d_nidx_i (G: hyps) {D b_v P T i_v k_v F C l_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nidx t1 t2 t3 ⟩ ∈ cl_nidx_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , x ∊ cl_nidx_i ⇒ x ∊ cl_nidx_i $ by ax
l2: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , x ∊ cl_nidx_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ ⇒ x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ ⇒ ⟨ pp , ra_nidx t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ ⇒ ⟨ pp , ra_nidx t1 t2 t3 ⟩ = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩ ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by y1_e_nidx_i [l6, l7]
l9: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nidx t1 t2 t3 ⟩ , ∃ c ∃ f (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b c) (scons (ra_isort b a f) ∅)) , ra_nidx y w a ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by ex_elim [l11, l10]
