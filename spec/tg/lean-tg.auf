l82: $ G ⇒ ∃ C ∃ T ∃ Mr ∃ M (t1 = V1 ∧ t2 = V2 ∧ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons V5 (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7 ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l81]
l83: $ G ⇒ ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = V1 ∧ t2 = V2 ∧ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons V5 (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 Mj ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l82]
l84: $ G ⇒ ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = V1 ∧ t2 = V2 ∧ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons V5 (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 F2 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 F2 Mj ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l83]
l85: $ G ⇒ ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = V1 ∧ t2 = V2 ∧ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 F2 Mj ∈ lrel ∧ ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l84]
l86: $ G ⇒ ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = V1 ∧ t2 = V2 ∧ t3 = v_v ∧ t4 = V3 ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift V3 ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives V1 V2 v_v ⟨ kc_s , scons V3 ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l85]
l87: $ G ⇒ ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = V1 ∧ t2 = V2 ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty V1 V2 j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives V1 V2 v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l86]
l88: $ G ⇒ ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = V1 ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty V1 np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l87]
l89: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_intro [l88]

lemma y1_d_motives_cons (G: hyps) {D np j_v v_v F F2 Mj C T Mr M: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_motives_cons ⇒ x ∊ cl_motives_cons $ by ax
l2: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_motives_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i (x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩ ⇒ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by y1_e_motives_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ i (x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩) ⇒ ∃ i (x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ i (x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ g ∃ i (x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩) ⇒ ∃ g ∃ i (x = ⟨ scons (ra_lift u ⟨ kc_nz , ∅ ⟩ w a) (scons (ra_mty y z u ⟨ kc_nz , ∅ ⟩ v a b) (scons (ra_motives y z v ⟨ kc_s , scons u ∅ ⟩ f g) (scons (ra_capp g ⟨ kc_cons , scons b (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ i) ∅))) , ra_motives y z v u ⟨ kc_tcons , scons w (scons c (scons f ∅)) ⟩ i ⟩) $ by ax
