lemma y1_p_recfield (G: hyps): $ G ⇒ pr_recfield ⊆ y1_lab kr_recfield (suc kr_recfield) $
----
l1: $ G ⇒ cl_recfield_app ⊆ y1_lab kr_recfield (suc kr_recfield) $ by y1_k_recfield_app
l2: $ G ⇒ cl_recfield_pi ⊆ y1_lab kr_recfield (suc kr_recfield) $ by y1_k_recfield_pi
l3: $ G ⇒ pr_recfield ⊆ y1_lab kr_recfield (suc kr_recfield) $ by cun_least [l2, l1]

lemma y1_k_rst_nil (G: hyps): $ G ⇒ cl_rst_nil ⊆ y1_lab kr_rst (suc kr_rst) $
----
l1: $ G , x ∊ cl_rst_nil ⇒ x ∊ cl_rst_nil $ by ax
l2: $ G , x ∊ cl_rst_nil ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ kr_rst ∈ ω $ by x1_kr_rst
l5: $ G , x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_rst_nil ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_rst_nil ⊆ y1_lab kr_rst (suc kr_rst) $ by subset_intro [l8]

