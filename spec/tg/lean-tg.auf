lemma y1_o_nidx (G: hyps) {D b_v P T i_v k_v F C l_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nidx t1 t2 t3 ⟩ ∈ pr_nidx $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ k_v ∃ F ∃ C ∃ l_v (t1 = D ∧ t2 = i_v ∧ t3 = k_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_isort F k_v l_v ∈ lrel) $ by y1_d_nidx_i [#1, #2]

lemma y1_e_nfields_i (G: hyps) {D b_v P T i_v c_v nf F K C: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10: set):
  $ G ⇒ ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V8 V10) (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅))) , ra_nfields V1 V5 V6 V7 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ c_v ∃ nf ∃ F ∃ K ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = nf ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V8 V10) (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅))) , ra_nfields V1 V5 V6 V7 ⟩ = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V8 V10) (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅)))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nfields t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_nfields V1 V5 V6 V7) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V8 V10) (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅))) ∧ ra_nfields t1 t2 t3 t4 = ra_nfields V1 V5 V6 V7 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V8 V10) (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_nfields t1 t2 t3 t4 = ra_nfields V1 V5 V6 V7 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V7 $ by isset_var
l19: $ G ⇒ scons V7 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V6 $ by isset_var
l21: $ G ⇒ scons V6 (scons V7 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V5 $ by isset_var
l23: $ G ⇒ scons V5 (scons V6 (scons V7 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V5 (scons V6 (scons V7 ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_nfields ∈ ω $ by x1_kr_nfields
l27: $ G ⇒ isset kr_nfields $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V5 (scons V6 (scons V7 ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_nfields = kr_nfields ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V5 (scons V6 (scons V7 ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V5 (scons V6 (scons V7 ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V5 (scons V6 (scons V7 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V5 (scons V6 (scons V7 ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V5 ∧ scons t3 (scons t4 ∅) = scons V6 (scons V7 ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V5 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V6 (scons V7 ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V6 ∧ scons t4 ∅ = scons V7 ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V6 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons V7 ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = V7 ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = V7 $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V8 V10) (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅)))) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V8 V10) (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅)))) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_ind_data V1 V2 V3 V4) $ by opair_isset
l46: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_nth_ty V4 V5 V8 V10) (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅))) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_nth_ty V4 V5 V8 V10) $ by opair_isset
l49: $ G ⇒ ra_nth_ty V4 V5 V8 V10 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ crn (scons (ra_nth_ctor V10 V6 V9) (scons (ra_npis V9 V7) ∅)) ⊆ lrel $ by crn_scons_tail [l47]
l51: $ G ⇒ isset (ra_nth_ctor V10 V6 V9) $ by opair_isset
l52: $ G ⇒ ra_nth_ctor V10 V6 V9 ∈ lrel $ by crn_scons_head [l51, l50]
l53: $ G ⇒ crn (scons (ra_npis V9 V7) ∅) ⊆ lrel $ by crn_scons_tail [l50]
l54: $ G ⇒ isset (ra_npis V9 V7) $ by opair_isset
l55: $ G ⇒ ra_npis V9 V7 ∈ lrel $ by crn_scons_head [l54, l53]
l56: $ G ⇒ ra_nth_ctor V10 V6 V9 ∈ lrel ∧ ra_npis V9 V7 ∈ lrel $ by and_intro [l52, l55]
l57: $ G ⇒ ra_nth_ty V4 V5 V8 V10 ∈ lrel ∧ ra_nth_ctor V10 V6 V9 ∈ lrel ∧ ra_npis V9 V7 ∈ lrel $ by and_intro [l49, l56]
l58: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V8 V10 ∈ lrel ∧ ra_nth_ctor V10 V6 V9 ∈ lrel ∧ ra_npis V9 V7 ∈ lrel $ by and_intro [l46, l57]
l59: $ G ⇒ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V8 V10 ∈ lrel ∧ ra_nth_ctor V10 V6 V9 ∈ lrel ∧ ra_npis V9 V7 ∈ lrel $ by and_intro [l42, l58]
l60: $ G ⇒ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V8 V10 ∈ lrel ∧ ra_nth_ctor V10 V6 V9 ∈ lrel ∧ ra_npis V9 V7 ∈ lrel $ by and_intro [l39, l59]
l61: $ G ⇒ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V8 V10 ∈ lrel ∧ ra_nth_ctor V10 V6 V9 ∈ lrel ∧ ra_npis V9 V7 ∈ lrel $ by and_intro [l36, l60]
l62: $ G ⇒ t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V8 V10 ∈ lrel ∧ ra_nth_ctor V10 V6 V9 ∈ lrel ∧ ra_npis V9 V7 ∈ lrel $ by and_intro [l33, l61]
l63: $ G ⇒ ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V8 C ∈ lrel ∧ ra_nth_ctor C V6 V9 ∈ lrel ∧ ra_npis V9 V7 ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ K ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V8 C ∈ lrel ∧ ra_nth_ctor C V6 K ∈ lrel ∧ ra_npis K V7 ∈ lrel) $ by ex_intro [l63]
l65: $ G ⇒ ∃ F ∃ K ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 F C ∈ lrel ∧ ra_nth_ctor C V6 K ∈ lrel ∧ ra_npis K V7 ∈ lrel) $ by ex_intro [l64]
l66: $ G ⇒ ∃ nf ∃ F ∃ K ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = nf ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 F C ∈ lrel ∧ ra_nth_ctor C V6 K ∈ lrel ∧ ra_npis K nf ∈ lrel) $ by ex_intro [l65]
l67: $ G ⇒ ∃ c_v ∃ nf ∃ F ∃ K ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = c_v ∧ t4 = nf ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ i_v ∃ c_v ∃ nf ∃ F ∃ K ∃ C (t1 = V1 ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = nf ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel) $ by ex_intro [l67]
l69: $ G ⇒ ∃ T ∃ i_v ∃ c_v ∃ nf ∃ F ∃ K ∃ C (t1 = V1 ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = nf ∧ ra_ind_data V1 V2 V3 T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel) $ by ex_intro [l68]
