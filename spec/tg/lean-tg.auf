l4: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = a ∧ w3 = b ∧ w4 = d ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ $ by and_elim_l [l3]
