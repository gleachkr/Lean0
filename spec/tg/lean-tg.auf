l9: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ty , scons z (scons u ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_closed_ind_ty ⇒ x ∊ y1_lab kr_closed (suc kr_closed) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_closed_ind_ty ⊆ y1_lab kr_closed (suc kr_closed) $ by subset_intro [l10]

