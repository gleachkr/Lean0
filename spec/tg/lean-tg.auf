l25: $ G ⇒ cl_closed_app ∪ (cl_closed_lam ∪ (cl_closed_pi ∪ (cl_closed_cst ∪ (cl_closed_lit ∪ (cl_closed_ind_ty ∪ (cl_closed_ind_ctor ∪ (cl_closed_ind_rec ∪ (cl_closed_proj ∪ (cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind))))))))))) ⊆ y1_lab kr_closed (suc kr_closed) $ by cun_least [l24, l23]
