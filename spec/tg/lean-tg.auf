l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $ by y1_e_closed_ind_ctor [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_ctor , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_ctor ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) $ by wcel_elim [#1, l15]

lemma y1_e_closed_ind_rec (G: hyps) {k_v D i_v v_v: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ v_v (t1 = V1 ∧ t2 = ⟨ kc_ind_rec , scons V2 (scons V3 (scons v_v ∅)) ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ i_v ∃ v_v (t1 = V1 ∧ t2 = ⟨ kc_ind_rec , scons V2 (scons i_v (scons v_v ∅)) ⟩) $ by ex_intro [l30]
l32: $ G ⇒ ∃ D ∃ i_v ∃ v_v (t1 = V1 ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_intro [l31]
l33: $ G ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_intro [l32]

lemma y1_d_closed_ind_rec (G: hyps) {k_v D i_v v_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_ind_rec $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_rec ⇒ x ∊ cl_closed_ind_rec $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_rec ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by y1_e_closed_ind_rec [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_closed y ⟨ kc_ind_rec , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_ind_rec ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by wcel_elim [#1, l15]

lemma y1_e_closed_proj (G: hyps) {k_v b_v i_v e_v: set} (pp t1 t2 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_closed V1 V4) ∅ , ra_closed V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_closed V1 V4) ∅ , ra_closed V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_closed V1 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_closed V1 V4) ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_closed V1 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_closed V1 V4) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_closed V1 V4) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_closed V1 V4) $ by opair_isset
l32: $ G ⇒ ra_closed V1 V4 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_closed V1 V4 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons V4 ∅)) ⟩ ∧ ra_closed V1 V4 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ e_v (t1 = V1 ∧ t2 = ⟨ kc_proj , scons V2 (scons V3 (scons e_v ∅)) ⟩ ∧ ra_closed V1 e_v ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ i_v ∃ e_v (t1 = V1 ∧ t2 = ⟨ kc_proj , scons V2 (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed V1 e_v ∈ lrel) $ by ex_intro [l35]
l37: $ G ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = V1 ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed V1 e_v ∈ lrel) $ by ex_intro [l36]
l38: $ G ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $ by ex_intro [l37]

lemma y1_d_closed_proj (G: hyps) {k_v b_v i_v e_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_proj $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_proj ⇒ x ∊ cl_closed_proj $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_proj ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩ ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $ by y1_e_closed_proj [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_closed y v) ∅ , ra_closed y ⟨ kc_proj , scons z (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_proj ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_e_closed_quot (G: hyps) {k_v u_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_quot , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_quot , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_quot , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_quot , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_quot , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_quot , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_quot , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_quot , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_quot , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_quot , scons V2 ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ u_v (t1 = V1 ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by ex_intro [l30]

lemma y1_d_closed_quot (G: hyps) {k_v u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot ⇒ x ∊ cl_closed_quot $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩ ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by y1_e_closed_quot [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot , scons z ∅ ⟩ ⟩) ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_closed_quot_mk (G: hyps) {k_v u_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_quot_mk , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $
