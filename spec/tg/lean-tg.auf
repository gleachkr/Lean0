l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_quot_mk , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_quot_mk , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_quot_mk , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_quot_mk , scons V2 ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ u_v (t1 = V1 ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $ by ex_intro [l30]

lemma y1_d_closed_quot_mk (G: hyps) {k_v u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_mk $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_mk ⇒ x ∊ cl_closed_quot_mk $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_mk ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩ ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $ by y1_e_closed_quot_mk [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_mk , scons z ∅ ⟩ ⟩) ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_mk ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_closed_quot_lift (G: hyps) {k_v u_v v_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_quot_lift , scons V2 (scons V3 ∅) ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ v_v (t1 = V1 ∧ t2 = ⟨ kc_quot_lift , scons V2 (scons v_v ∅) ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ u_v ∃ v_v (t1 = V1 ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by ex_intro [l30]
l32: $ G ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by ex_intro [l31]

lemma y1_d_closed_quot_lift (G: hyps) {k_v u_v v_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_lift ⇒ x ∊ cl_closed_quot_lift $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_lift ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by y1_e_closed_quot_lift [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_lift , scons z (scons u ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_lift ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by wcel_elim [#1, l13]

lemma y1_e_closed_quot_ind (G: hyps) {k_v u_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed V1 ⟨ kc_quot_ind , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_closed V1 ⟨ kc_quot_ind , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_closed t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_closed t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_closed V1 ⟨ kc_quot_ind , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_closed t1 t2 = ra_closed V1 ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_closed t1 t2 = ra_closed V1 ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_closed ∈ ω $ by x1_kr_closed
l19: $ G ⇒ isset kr_closed $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_closed = kr_closed ∧ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_quot_ind , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_quot_ind , scons V2 ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ u_v (t1 = V1 ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by ex_intro [l29]
l31: $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by ex_intro [l30]

lemma y1_d_closed_quot_ind (G: hyps) {k_v u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_ind ⇒ x ∊ cl_closed_quot_ind $ by ax
l2: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_ind ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_closed t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_closed t1 t2 ⟩ = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩ ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by y1_e_closed_quot_ind [l6, l7]
l9: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , ∃ z (x = ⟨ ∅ , ra_closed y ⟨ kc_quot_ind , scons z ∅ ⟩ ⟩) ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_closed t1 t2 ⟩ , x ∊ cl_closed_quot_ind ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by wcel_elim [#1, l11]

lemma y1_o_closed (G: hyps) {i_v k_v l_v f_v a_v A b_v S n_v D c_v v_v e_v u_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ pr_closed $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) ∨ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) ∨ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) ∨ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) ∨ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) ∨ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) ∨ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $
----
l1: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind $ by ax
l2: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by y1_d_closed_quot_ind [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind → ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind $ by ax
l6: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∨ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift $ by ax
l8: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) $ by y1_d_closed_quot_lift [l7, l8]
l10: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind $ by ax
l12: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind → ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind ⇒ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_ind ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_quot_lift ∪ cl_closed_quot_ind ⇒ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by or_elim [l6, l10, l14]
