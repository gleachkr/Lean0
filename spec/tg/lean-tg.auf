l154: $ G ⇒ ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 V8 ∈ lrel ∧ ra_ntys V4 n_v m_v ∈ lrel ∧ ra_motives V1 V8 V5 ⟨ kc_nz , ∅ ⟩ V4 M ∈ lrel ∧ ra_minors V1 V8 n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 N ∈ lrel ∧ ra_nth_ty V4 V6 F C ∈ lrel ∧ ra_nth_ctor C V7 K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v V8 K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M V3 Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l153]
l155: $ G ⇒ ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = V7 ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys V4 n_v m_v ∈ lrel ∧ ra_motives V1 np V5 ⟨ kc_nz , ∅ ⟩ V4 M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 N ∈ lrel ∧ ra_nth_ty V4 V6 F C ∈ lrel ∧ ra_nth_ctor C V7 K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M V3 Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l154]
l156: $ G ⇒ ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = V6 ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys V4 n_v m_v ∈ lrel ∧ ra_motives V1 np V5 ⟨ kc_nz , ∅ ⟩ V4 M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 N ∈ lrel ∧ ra_nth_ty V4 V6 F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M V3 Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l155]
l157: $ G ⇒ ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = V1 ∧ t2 = V5 ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys V4 n_v m_v ∈ lrel ∧ ra_motives V1 np V5 ⟨ kc_nz , ∅ ⟩ V4 M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 N ∈ lrel ∧ ra_nth_ty V4 i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M V3 Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l156]
l158: $ G ⇒ ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = V1 ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys V4 n_v m_v ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_nz , ∅ ⟩ V4 M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 N ∈ lrel ∧ ra_nth_ty V4 i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M V3 Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l157]
l159: $ G ⇒ ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = V1 ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data V1 V2 V3 T ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M V3 Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l158]
l160: $ G ⇒ ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = V1 ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data V1 V2 P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l159]
l161: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = V1 ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l160]
l162: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $ by ex_intro [l161]

lemma y1_d_iota_tel_i (G: hyps) {D b_v P T v_v i_v c_v np n_v m_v mn nf M N X Xl Q1 Q2 Dl F K K2 res C: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_iota_tel_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_psplit nf K2 ⟨ kc_nil , ∅ ⟩ X res ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_iota_tel_i ⇒ x ∊ cl_iota_tel_i $ by ax
l2: $ G , x = ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_iota_tel_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p ∃ q ∃ r ∃ t (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u c) (scons (ra_ntys v f g) (scons (ra_motives y c w ⟨ kc_nz , ∅ ⟩ v k) (scons (ra_minors y c f ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v d) (scons (ra_nth_ty v a o t) (scons (ra_nth_ctor t b p) (scons (ra_npis p j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c p q) (scons (ra_psplit j q ⟨ kc_nil , ∅ ⟩ e r) (scons (ra_add g f i) (scons (ra_clift i e h) (scons (ra_capp k u l) (scons (ra_capp d l m) (scons (ra_capp h m n) ∅)))))))))))))) , ra_iota_tel y w a b e r j n ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u c) (scons (ra_ntys v f g) (scons (ra_motives y c w ⟨ kc_nz , ∅ ⟩ v k) (scons (ra_minors y c f ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v d) (scons (ra_nth_ty v a o t) (scons (ra_nth_ctor t b p) (scons (ra_npis p j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c p q) (scons (ra_psplit j q ⟨ kc_nil , ∅ ⟩ e r) (scons (ra_add g f i) (scons (ra_clift i e h) (scons (ra_capp k u l) (scons (ra_capp d l m) (scons (ra_capp h m n) ∅)))))))))))))) , ra_iota_tel y w a b e r j n ⟩ ⇒ x = ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u c) (scons (ra_ntys v f g) (scons (ra_motives y c w ⟨ kc_nz , ∅ ⟩ v k) (scons (ra_minors y c f ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v d) (scons (ra_nth_ty v a o t) (scons (ra_nth_ctor t b p) (scons (ra_npis p j) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c p q) (scons (ra_psplit j q ⟨ kc_nil , ∅ ⟩ e r) (scons (ra_add g f i) (scons (ra_clift i e h) (scons (ra_capp k u l) (scons (ra_capp d l m) (scons (ra_capp h m n) ∅)))))))))))))) , ra_iota_tel y w a b e r j n ⟩ ⇒ ⟨ pp , ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = x $ by eq_sym [l3]
