lemma y1_e_ihty_app (G: hyps) {D np n_v mo fld y_v j_v ni k_v a_v b_v mj f_v Y X U A: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17: set):
  $ G ⇒ ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V7 ∅) ⟩ V17 V9) (scons (ra_nidx V1 V7 V8) (scons (ra_add V2 V8 V9) (scons (ra_rehead V14 ⟨ kc_bvar , scons V12 ∅ ⟩ V8 V17 V15) (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V7 ∅) ⟩ V14 V2) (scons (ra_add V6 V4 V10) (scons (ra_add V10 V3 V11) (scons (ra_add V12 ⟨ kc_s , scons V7 ∅ ⟩ V11) (scons (ra_add V6 V5 V13) (scons (ra_pargs ⟨ kc_bvar , scons V13 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V6 V16) ∅))))))))) , ra_ihty V1 V2 V3 V4 V5 V6 V7 V17 ⟨ kc_app , scons V15 (scons V16 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V7 ∅) ⟩ V17 V9) (scons (ra_nidx V1 V7 V8) (scons (ra_add V2 V8 V9) (scons (ra_rehead V14 ⟨ kc_bvar , scons V12 ∅ ⟩ V8 V17 V15) (scons (ra_spine ⟨ kc_ind_ty , scons V1 (scons V7 ∅) ⟩ V14 V2) (scons (ra_add V6 V4 V10) (scons (ra_add V10 V3 V11) (scons (ra_add V12 ⟨ kc_s , scons V7 ∅ ⟩ V11) (scons (ra_add V6 V5 V13) (scons (ra_pargs ⟨ kc_bvar , scons V13 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V6 V16) ∅))))))))) , ra_ihty V1 V2 V3 V4 V5 V6 V7 V17 ⟨ kc_app , scons V15 (scons V16 ∅) ⟩ ⟩ = ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ $ by eq_sym [#1]
