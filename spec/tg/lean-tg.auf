l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V3 $ by isset_var
l21: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ scons V3 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l21]
l23: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l24: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V3 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ isset V2 $ by isset_var
l26: $ G ⇒ scons V2 (scons ⟨ kc_nz , ∅ ⟩ (scons V3 (scons V3 ∅))) ∈ fseq y1_vv $ by y1_fs [l25, l24]
