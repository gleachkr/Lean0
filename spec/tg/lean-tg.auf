l53: $ G ⇒ cl_iota_lhs_i ⊆ y1_lab kr_iota_lhs (suc kr_iota_lhs) $ by subset_intro [l52]

lemma y1_p_iota_lhs (G: hyps): $ G ⇒ pr_iota_lhs ⊆ y1_lab kr_iota_lhs (suc kr_iota_lhs) $
----
l1: $ G ⇒ pr_iota_lhs ⊆ y1_lab kr_iota_lhs (suc kr_iota_lhs) $ by y1_k_iota_lhs_i

lemma y1_k_crst_nil (G: hyps): $ G ⇒ cl_crst_nil ⊆ y1_lab kr_crst (suc kr_crst) $
----
l1: $ G , x ∊ cl_crst_nil ⇒ x ∊ cl_crst_nil $ by ax
l2: $ G , x ∊ cl_crst_nil ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ kr_crst ∈ ω $ by x1_kr_crst
l5: $ G , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_crst (suc kr_crst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_crst (suc kr_crst) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_crst_nil ⇒ x ∊ y1_lab kr_crst (suc kr_crst) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_crst_nil ⊆ y1_lab kr_crst (suc kr_crst) $ by subset_intro [l8]

lemma y1_k_crst_cons (G: hyps): $ G ⇒ cl_crst_cons ⊆ y1_lab kr_crst (suc kr_crst) $
----
l1: $ G , x ∊ cl_crst_cons ⇒ x ∊ cl_crst_cons $ by ax
l2: $ G , x ∊ cl_crst_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
