l28: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ph $ by imp_elim [l27, l23]
l29: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , ∃ T (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ T (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l30: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , ∃ T (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ph $ by ex_elim [l29, l28]
l31: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , ∃ P ∃ T (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ P ∃ T (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l32: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk , ∃ P ∃ T (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mk , scons b (scons P (scons T ∅)) ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ph $ by ex_elim [l31, l30]
l33: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mk ⇒ ph $ by ex_elim [l2, l32]
l34: $ GG ⇒ ph $ by wcel_elim [#1, l33]

lemma y2_ind_nested_e1 (GG: hyps) (q1 q2 w2 u_b u_P u_T v_b v_P v_T: set):
  $ GG ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ q1 = ⟨ kc_ind_mk , scons v_b (scons v_P (scons v_T ∅)) ⟩ $ > $ GG ⇒ w2 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ = ⟨ kc_ind_mk , scons v_b (scons v_P (scons v_T ∅)) ⟩ $ by eq_trans [l1, #3]
l3: $ GG ⇒ kc_ind_mk ∈ ω $ by v1_kc_ind_mk
l4: $ GG ⇒ isset kc_ind_mk $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_b $ by isset_var
l6: $ GG ⇒ isset u_P $ by isset_var
l7: $ GG ⇒ isset u_T $ by isset_var
l8: $ GG ⇒ isset v_b $ by isset_var
l9: $ GG ⇒ isset v_P $ by isset_var
l10: $ GG ⇒ isset v_T $ by isset_var
l11: $ GG ⇒ u_b = v_b ∧ u_P = v_P ∧ u_T = v_T $ by y2_nd3 [l2, l4, l5, l6, l7, l8, l9, l10]
l12: $ GG ⇒ u_b = v_b $ by and_elim_l [l11]
l13: $ GG ⇒ u_P = v_P ∧ u_T = v_T $ by and_elim_r [l11]
l14: $ GG ⇒ u_P = v_P $ by and_elim_l [l13]
l15: $ GG ⇒ u_T = v_T $ by and_elim_r [l13]
l16: $ GG ⇒ ∅ = ∅ $ by eq_refl
l17: $ GG ⇒ kc_nil = kc_nil $ by eq_refl
l18: $ GG ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_nil , ∅ ⟩ $ by opair_eq [l17, l16]
l19: $ GG ⇒ ⟨ kc_nil , ∅ ⟩ = w2 $ by eq_sym [#4]
l20: $ GG ⇒ q2 = ⟨ kc_nil , ∅ ⟩ $ by eq_trans [#2, l18]
l21: $ GG ⇒ q2 = w2 $ by eq_trans [l20, l19]

lemma y2_ind_nested_c1 (GG: hyps) (q1 q2 w2 u_b u_P u_T: set):
  $ GG ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ ra_ind_nested q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by lrel_ind_nested_cases [#2]
l2: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ $ by and_elim_l [l2]
l7: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ w2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l2]
l8: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q2 = w2 $ by y2_ind_nested_e1 [l4, l5, l6, l7]
l9: $ GG , ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) $ by ax
l10: $ GG , ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l9, l8]
l11: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) $ by ax
l12: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l11, l10]
l13: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) $ by ax
l14: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l13, l12]
l15: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e $ by ax
l16: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ $ by weaken [#1]
l17: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q1 = ⟨ kc_ind_mk , scons u_b (scons u_P (scons u_T ∅)) ⟩ $ by and_elim_l [l16]
l18: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l16]
l19: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ $ by and_elim_l [l15]
l20: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ w2 = e $ by and_elim_r [l15]
l21: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ kc_ind_mk ∈ kc_ind_mkn $ by y2_lt_ind_mk_ind_mkn
l22: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ kc_ind_mkn ∈ ω $ by v1_kc_ind_mkn
l23: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ isset kc_ind_mkn $ by wcel_isset [l22]
l24: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ ⊥ $ by y2_ne [l17, l19, l21, l23]
l25: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q2 = w2 $ by bot_elim [l24]
l26: $ GG , ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by ax
l27: $ GG , ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ q2 = w2 $ by ex_elim [l26, l25]
l28: $ GG , ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by ax
l29: $ GG , ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ q2 = w2 $ by ex_elim [l28, l27]
l30: $ GG , ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by ax
l31: $ GG , ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ q2 = w2 $ by ex_elim [l30, l29]
l32: $ GG , ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by ax
l33: $ GG , ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ q2 = w2 $ by ex_elim [l32, l31]
l34: $ GG ⇒ q2 = w2 $ by or_elim [l1, l14, l33]

lemma y2_ind_nested_d1 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_ind_nested q1 q2 ⟩ ∈ cl_ind_nested_mk $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_nested lrel $ > $ GG ⇒ ra_ind_nested q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ $ by ax
l2: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ ⇒ ra_ind_nested q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ ⇒ q2 = w2 $ by y2_ind_nested_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ → q2 = w2) $ by all_intro [l4]
l6: $ GG ⇒ ∀ b ∀ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ → q2 = w2) $ by all_intro [l5]
l7: $ GG ⇒ ∀ a ∀ b ∀ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nil , ∅ ⟩ → q2 = w2) $ by all_intro [l6]
l8: $ GG ⇒ q2 = w2 $ by y2_ind_nested_i1 [#1, #2, l7]

lemma y2_ind_nested_i2 (GG: hyps) {b P T N: set} (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_ind_nested q1 q2 ⟩ ∈ cl_ind_nested_mkn $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_nested lrel $ > $ GG ⇒ ∀ b ∀ P ∀ T ∀ N (q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = N → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn ⇒ w ∊ cl_ind_nested_mkn $ by ax
l2: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn ⇒ ∃ b ∃ P ∃ T ∃ N (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ w = ⟨ o , ra_ind_nested q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ ⟨ o , ra_ind_nested q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ ⟨ o , ra_ind_nested q1 q2 ⟩ = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset (ra_ind_nested q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset (ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ o = ∅ ∧ ra_ind_nested q1 q2 = ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ ⟨ kr_ind_nested , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_ind_nested , scons ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ (scons N ∅) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ kr_ind_nested ∈ ω $ by x1_kr_ind_nested
l15: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset kr_ind_nested $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ $ by opair_isset
l19: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ isset N $ by isset_var
l20: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = N $ by y2_nd2 [l13, l15, l16, l17, l18, l19]
l21: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ $ by and_elim_l [l20]
l22: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ q2 = N $ by and_elim_r [l20]
l23: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = N $ by and_intro [l21, l22]
l24: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ ∀ b ∀ P ∀ T ∀ N (q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = N → ph) $ by weaken [#3]
l25: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ ∀ P ∀ T ∀ N (q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = N → ph) $ by all_elim [l24]
l26: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ ∀ T ∀ N (q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = N → ph) $ by all_elim [l25]
l27: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ ∀ N (q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = N → ph) $ by all_elim [l26]
l28: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = N → ph $ by all_elim [l27]
l29: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩ ⇒ ph $ by imp_elim [l28, l23]
l30: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , ∃ N (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩) ⇒ ∃ N (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩) $ by ax
l31: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , ∃ N (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩) ⇒ ph $ by ex_elim [l30, l29]
l32: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn , ∃ T ∃ N (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩) ⇒ ∃ T ∃ N (w = ⟨ ∅ , ra_ind_nested ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ N ⟩) $ by ax
