l172: $ G ⇒ ⟨ pp , ra_closed t1 t2 ⟩ ∈ cl_closed_bvar ∪ (cl_closed_srt ∪ (cl_closed_app ∪ (cl_closed_lam ∪ (cl_closed_pi ∪ (cl_closed_cst ∪ (cl_closed_lit ∪ (cl_closed_ind_ty ∪ (cl_closed_ind_ctor ∪ (cl_closed_ind_rec ∪ (cl_closed_proj ∪ (cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind))))))))))))) → ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) ∨ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) ∨ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) ∨ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) ∨ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) ∨ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) ∨ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by imp_intro [l171]
l173: $ G ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨ ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨ ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) ∨ ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) ∨ ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨ ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) ∨ ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) ∨ ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) ∨ ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) ∨ ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨ ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $ by imp_elim [l172, #1]

lemma y1_e_lift_bvar_lt (G: hyps) {n_v k_v i_v: set} (pp t1 t2 t3 t4 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2) ∅ , ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2) ∅ , ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lift t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2) ∅ ∧ ra_lift t1 t2 t3 t4 = ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lift t1 t2 t3 t4 = ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_bvar , scons V3 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset V2 $ by isset_var
l22: $ G ⇒ scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_lift ∈ ω $ by x1_kr_lift
l26: $ G ⇒ isset kr_lift $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_lift = kr_lift ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ scons t4 ∅ = scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons ⟨ kc_bvar , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = ⟨ kc_bvar , scons V3 ∅ ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ crn pp = crn (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2) ∅) $ by crn_eq [l7]
l43: $ G ⇒ crn (scons (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2) ∅) ⊆ lrel $ by subset_eq_l [l42, #2]
l44: $ G ⇒ isset (ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2) $ by opair_isset
l45: $ G ⇒ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2 ∈ lrel $ by crn_scons_head [l44, l43]
l46: $ G ⇒ t4 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2 ∈ lrel $ by and_intro [l41, l45]
l47: $ G ⇒ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2 ∈ lrel $ by and_intro [l38, l46]
l48: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2 ∈ lrel $ by and_intro [l35, l47]
l49: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ ra_le ⟨ kc_s , scons V3 ∅ ⟩ V2 ∈ lrel $ by and_intro [l32, l48]
l50: $ G ⇒ ∃ i_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ V2 ∈ lrel) $ by ex_intro [l49]
l51: $ G ⇒ ∃ k_v ∃ i_v (t1 = V1 ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by ex_intro [l51]

lemma y1_d_lift_bvar_lt (G: hyps) {n_v k_v i_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_bvar_lt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_bvar_lt ⇒ x ∊ cl_lift_bvar_lt $ by ax
l2: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_bvar_lt ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by y1_e_lift_bvar_lt [l6, l7]
l9: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_bvar_lt ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_lift_bvar_ge (G: hyps) {n_v k_v i_v j_v: set} (pp t1 t2 t3 t4 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ scons (ra_le V2 V3) (scons (ra_add V3 V1 V4) ∅) , ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V4 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_le V2 V3) (scons (ra_add V3 V1 V4) ∅) , ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V4 ∅ ⟩ ⟩ = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_le V2 V3) (scons (ra_add V3 V1 V4) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lift t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V4 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_le V2 V3) (scons (ra_add V3 V1 V4) ∅) ∧ ra_lift t1 t2 t3 t4 = ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V4 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_le V2 V3) (scons (ra_add V3 V1 V4) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_lift t1 t2 t3 t4 = ra_lift V1 V2 ⟨ kc_bvar , scons V3 ∅ ⟩ ⟨ kc_bvar , scons V4 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_bvar , scons V4 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset ⟨ kc_bvar , scons V3 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_lift ∈ ω $ by x1_kr_lift
l27: $ G ⇒ isset kr_lift $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_lift = kr_lift ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_bvar , scons V3 ∅ ⟩ (scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ scons t4 ∅ = scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_bvar , scons V4 ∅ ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_bvar , scons V4 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_bvar , scons V4 ∅ ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_le V2 V3) (scons (ra_add V3 V1 V4) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_le V2 V3) (scons (ra_add V3 V1 V4) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_le V2 V3) $ by opair_isset
l46: $ G ⇒ ra_le V2 V3 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_add V3 V1 V4) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_add V3 V1 V4) $ by opair_isset
l49: $ G ⇒ ra_add V3 V1 V4 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_le V2 V3 ∈ lrel ∧ ra_add V3 V1 V4 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_bvar , scons V4 ∅ ⟩ ∧ ra_le V2 V3 ∈ lrel ∧ ra_add V3 V1 V4 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons V4 ∅ ⟩ ∧ ra_le V2 V3 ∈ lrel ∧ ra_add V3 V1 V4 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons V4 ∅ ⟩ ∧ ra_le V2 V3 ∈ lrel ∧ ra_add V3 V1 V4 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons V4 ∅ ⟩ ∧ ra_le V2 V3 ∈ lrel ∧ ra_add V3 V1 V4 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_bvar , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le V2 V3 ∈ lrel ∧ ra_add V3 V1 j_v ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ i_v ∃ j_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le V2 i_v ∈ lrel ∧ ra_add i_v V1 j_v ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ k_v ∃ i_v ∃ j_v (t1 = V1 ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v V1 j_v ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_intro [l57]

lemma y1_d_lift_bvar_ge (G: hyps) {n_v k_v i_v j_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_bvar_ge $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_bvar_ge ⇒ x ∊ cl_lift_bvar_ge $ by ax
l2: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_bvar_ge ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩ ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $ by y1_e_lift_bvar_ge [l6, l7]
l9: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_le z u) (scons (ra_add u y v) ∅) , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons v ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_bvar_ge ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_e_lift_srt (G: hyps) {n_v k_v l_v: set} (pp t1 t2 t3 t4 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_lift V1 V2 ⟨ kc_srt , scons V3 ∅ ⟩ ⟨ kc_srt , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_lift V1 V2 ⟨ kc_srt , scons V3 ∅ ⟩ ⟨ kc_srt , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lift t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lift V1 V2 ⟨ kc_srt , scons V3 ∅ ⟩ ⟨ kc_srt , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_lift t1 t2 t3 t4 = ra_lift V1 V2 ⟨ kc_srt , scons V3 ∅ ⟩ ⟨ kc_srt , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lift t1 t2 t3 t4 = ra_lift V1 V2 ⟨ kc_srt , scons V3 ∅ ⟩ ⟨ kc_srt , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_srt , scons V3 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset V2 $ by isset_var
l22: $ G ⇒ scons V2 (scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_lift ∈ ω $ by x1_kr_lift
l26: $ G ⇒ isset kr_lift $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_lift = kr_lift ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_srt , scons V3 ∅ ⟩ (scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = ⟨ kc_srt , scons V3 ∅ ⟩ ∧ scons t4 ∅ = scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = ⟨ kc_srt , scons V3 ∅ ⟩ $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons ⟨ kc_srt , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = ⟨ kc_srt , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = ⟨ kc_srt , scons V3 ∅ ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ t3 = ⟨ kc_srt , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons V3 ∅ ⟩ $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_srt , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons V3 ∅ ⟩ $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_srt , scons V3 ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons V3 ∅ ⟩ $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ l_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_intro [l44]
l46: $ G ⇒ ∃ k_v ∃ l_v (t1 = V1 ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_intro [l45]
l47: $ G ⇒ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_intro [l46]

lemma y1_d_lift_srt (G: hyps) {n_v k_v l_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_srt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_srt ⇒ x ∊ cl_lift_srt $ by ax
l2: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_srt ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩ ⇒ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by y1_e_lift_srt [l6, l7]
l9: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ u (x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_lift y z ⟨ kc_srt , scons u ∅ ⟩ ⟨ kc_srt , scons u ∅ ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_srt ⇒ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) $ by wcel_elim [#1, l13]

lemma y1_e_lift_app (G: hyps) {n_v k_v f_v a_v f2 a2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 V2 V4 V6) ∅) , ra_lift V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 V2 V4 V6) ∅) , ra_lift V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 V2 V4 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lift t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_lift V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 V2 V4 V6) ∅) ∧ ra_lift t1 t2 t3 t4 = ra_lift V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 V2 V4 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_lift t1 t2 t3 t4 = ra_lift V1 V2 ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_lift ∈ ω $ by x1_kr_lift
l27: $ G ⇒ isset kr_lift $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_lift = kr_lift ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ (scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ scons t4 ∅ = scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 V2 V4 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 V2 V4 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_lift V1 V2 V3 V5) $ by opair_isset
l46: $ G ⇒ ra_lift V1 V2 V3 V5 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_lift V1 V2 V4 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_lift V1 V2 V4 V6) $ by opair_isset
l49: $ G ⇒ ra_lift V1 V2 V4 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_lift V1 V2 V3 V5 ∈ lrel ∧ ra_lift V1 V2 V4 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ra_lift V1 V2 V3 V5 ∈ lrel ∧ ra_lift V1 V2 V4 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ra_lift V1 V2 V3 V5 ∈ lrel ∧ ra_lift V1 V2 V4 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ra_lift V1 V2 V3 V5 ∈ lrel ∧ ra_lift V1 V2 V4 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons V5 (scons V6 ∅) ⟩ ∧ ra_lift V1 V2 V3 V5 ∈ lrel ∧ ra_lift V1 V2 V4 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons V5 (scons a2 ∅) ⟩ ∧ ra_lift V1 V2 V3 V5 ∈ lrel ∧ ra_lift V1 V2 V4 a2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons V4 ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift V1 V2 V3 f2 ∈ lrel ∧ ra_lift V1 V2 V4 a2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons V3 (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift V1 V2 V3 f2 ∈ lrel ∧ ra_lift V1 V2 a_v a2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift V1 V2 f_v f2 ∈ lrel ∧ ra_lift V1 V2 a_v a2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = V1 ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift V1 k_v f_v f2 ∈ lrel ∧ ra_lift V1 k_v a_v a2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_lift_app (G: hyps) {n_v k_v f_v a_v f2 a2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_app ⇒ x ∊ cl_lift_app $ by ax
l2: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩ ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by y1_e_lift_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_lift y z u w) (scons (ra_lift y z v a) ∅) , ra_lift y z ⟨ kc_app , scons u (scons v ∅) ⟩ ⟨ kc_app , scons w (scons a ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ , x ∊ cl_lift_app ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_lift_lam (G: hyps) {n_v k_v A b_v A2 b2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ = ⟨ scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 ⟨ kc_s , scons V2 ∅ ⟩ V4 V6) ∅) , ra_lift V1 V2 ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_lift n_v k_v A A2 ∈ lrel ∧ ra_lift n_v ⟨ kc_s , scons k_v ∅ ⟩ b_v b2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 ⟨ kc_s , scons V2 ∅ ⟩ V4 V6) ∅) , ra_lift V1 V2 ⟨ kc_lam , scons V3 (scons V4 ∅) ⟩ ⟨ kc_lam , scons V5 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lift V1 V2 V3 V5) (scons (ra_lift V1 ⟨ kc_s , scons V2 ∅ ⟩ V4 V6) ∅)) $ by y1_opair_set_l [l1]
