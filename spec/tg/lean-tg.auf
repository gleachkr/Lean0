l81: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ t6 = ⟨ kc_srt , scons V7 ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 V8 ∈ lrel ∧ ra_pargs V8 ⟨ kc_nz , ∅ ⟩ V4 V9 ∈ lrel $ by and_intro [l48, l80]
l82: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ t6 = ⟨ kc_srt , scons V7 ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 V8 ∈ lrel ∧ ra_pargs V8 ⟨ kc_nz , ∅ ⟩ V4 V9 ∈ lrel $ by and_intro [l45, l81]
l83: $ G ⇒ ∃ I (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ t6 = ⟨ kc_srt , scons V7 ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 V8 ∈ lrel ∧ ra_pargs V8 ⟨ kc_nz , ∅ ⟩ V4 I ∈ lrel) $ by ex_intro [l82]
l84: $ G ⇒ ∃ X ∃ I (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ t6 = ⟨ kc_srt , scons V7 ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ V4 I ∈ lrel) $ by ex_intro [l83]
l85: $ G ⇒ ∃ l_v ∃ X ∃ I (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ V4 I ∈ lrel) $ by ex_intro [l84]
l86: $ G ⇒ ∃ v_v ∃ l_v ∃ X ∃ I (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ V4 I ∈ lrel) $ by ex_intro [l85]
l87: $ G ⇒ ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add V4 V3 k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ k_v V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ V4 I ∈ lrel) $ by ex_intro [l86]
l88: $ G ⇒ ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v V3 k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ k_v V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_intro [l87]
l89: $ G ⇒ ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = V1 ∧ t2 = V2 ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ k_v V2 X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_intro [l88]
l90: $ G ⇒ ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = V1 ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_intro [l89]
l91: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_intro [l90]

lemma y1_d_mty_srt (G: hyps) {D np j_v d_v k_v v_v l_v X I: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_mty_srt ⇒ x ∊ cl_mty_srt $ by ax
l2: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_mty_srt ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩ ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by y1_e_mty_srt [l6, l7]
l9: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
