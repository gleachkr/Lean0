l19: $ G ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) ∨ ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_rehead S X2 k_v e_v e2 ∈ lrel) ∨ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) ∨ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $ by isset_elim [l1, l18]

