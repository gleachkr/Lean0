l29: $ GG , ∃ h (q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel) ⇒ ∃ h (q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel) $ by ax
l30: $ GG , ∃ h (q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel) ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by ex_elim [l29, l28]
l31: $ GG , ∃ g ∃ h (q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel) ⇒ ∃ g ∃ h (q1 = a ∧ w2 = f ∧ w3 = g ∧ w4 = h ∧ ra_ind_data a b d e ∈ lrel ∧ ra_clen d f ∈ lrel ∧ ra_ntys e g h ∈ lrel) $ by ax
