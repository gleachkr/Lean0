lemma y2_nth_ty_c2 (GG: hyps) (q1 q2 q3 q4 w3 w4 u_F u_F2 u_C u_C2 u_T u_i: set):
  $ GG ⇒ q1 = ⟨ kc_tcons , scons u_F2 (scons u_C2 (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons u_i ∅ ⟩ ∧ q3 = u_F ∧ q4 = u_C ∧ ra_nth_ty u_T u_i u_F u_C ∈ lrel ∧ ra_nth_ty u_T u_i u_F u_C ∈ y2_P_nth_ty lrel $ > $ GG ⇒ ra_nth_ty q1 q2 w3 w4 ∈ lrel $ > $ GG ⇒ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b) ∨ ∃ a ∃ e ∃ b ∃ f ∃ d ∃ g (q1 = ⟨ kc_tcons , scons e (scons f (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons g ∅ ⟩ ∧ w3 = a ∧ w4 = b ∧ ra_nth_ty d g a b ∈ lrel) $ by lrel_nth_ty_cases [#2]
l2: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b $ by ax
l3: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q1 = ⟨ kc_tcons , scons u_F2 (scons u_C2 (scons u_T ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons u_i ∅ ⟩ ∧ q3 = u_F ∧ q4 = u_C ∧ ra_nth_ty u_T u_i u_F u_C ∈ lrel ∧ ra_nth_ty u_T u_i u_F u_C ∈ y2_P_nth_ty lrel $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q1 = ⟨ kc_tcons , scons u_F2 (scons u_C2 (scons u_T ∅)) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ∧ w4 = b ⇒ q2 = ⟨ kc_s , scons u_i ∅ ⟩ ∧ q3 = u_F ∧ q4 = u_C ∧ ra_nth_ty u_T u_i u_F u_C ∈ lrel ∧ ra_nth_ty u_T u_i u_F u_C ∈ y2_P_nth_ty lrel $ by and_elim_r [l3]
