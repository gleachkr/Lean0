lemma y1_e_baddc_11 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ = ⟨ scons (ra_baddc V1 V2 V3) ∅ , ra_baddc ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $
----
